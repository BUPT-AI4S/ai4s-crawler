@article{SCHAR2026118550,
title = {mNARX+: A surrogate model for complex dynamical systems using manifold-NARX and automatic feature selection},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118550},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118550},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525008229},
author = {Styfen Schär and Stefano Marelli and Bruno Sudret},
keywords = {Dynamical systems, Surrogate modeling, Autoregressive modeling, Manifold-NARX, Functional-NARX},
abstract = {We propose an automatic approach for manifold nonlinear autoregressive with exogenous inputs (mNARX) modeling that leverages the feature-based structure of functional-NARX (F-NARX) modeling. This novel approach, termed mNARX+, preserves the key strength of the mNARX framework, which is its expressivity allowing it to model complex dynamical systems, while simultaneously addressing a key limitation: the heavy reliance on domain expertise to identify relevant auxiliary quantities and their causal ordering. Our method employs a data-driven, recursive algorithm that automates the construction of the mNARX model sequence. It operates by sequentially selecting temporal features based on their correlation with the model prediction residuals, thereby automatically identifying the most critical auxiliary quantities and the order in which they should be modeled. This procedure significantly reduces the need for prior system knowledge. We demonstrate the effectiveness of the mNARX+ algorithm on two case studies: a Bouc-Wen oscillator with strong hysteresis and a complex aero-servo-elastic wind turbine simulator. The results show that the algorithm provides a systematic, data-driven method for creating accurate and stable surrogate models for complex dynamical systems.}
}
@article{GRECO2026118513,
title = {Fourth-order isogeometric phase-field modeling of dynamic brittle fracture: Numerical study and comparison with second-order models},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118513},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118513},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007856},
author = {L. Greco and J. Kiendl and M. Negri and A. Patton and A. Reali},
keywords = {Dynamic brittle fracture, Isogeometric analysis, Phase-field modeling, High-order models},
abstract = {We provide a thorough numerical investigation on phase-field simulations for dynamic brittle fracture; our analysis focuses on numerical performance, in terms of computational time and accuracy, measured by quantitative physical properties: energy conservation, crack speed, and critical stress. Simulations are performed by means of a semi-implicit staggered scheme, combining a Newmark method with the Projected Successive Over-Relaxation algorithm. This coupling ensures both an accurate solution of the elasto-dynamic equation and an effective solution of the linear complementarity problem, arising in the evolution of the phase-field parameter. In particular, with the Newmark method numerical dissipation is almost negligible; as a result, energy is conserved and simulations feature a remarkable representation of P and S waves, which irradiate from the boundary condition and from the tip, reflect on the boundary and interact with each other. While accuracy requires both small time increments and small mesh sizes, which easily lead to unaffordable computational time, we employ a fourth order AT1 functional that allows (as a rule of thumb) to halve the mesh size, and then halve the time increment. This multiplicative effect produces a remarkable saving of computational time (up to the order of 90%) without compromising the quality of the results. Moreover, AT1 functionals, compared with AT2, feature a sharp value of the critical stress and sharper damage profiles and showcase in all results a gain in accuracy. We employ an isogeometric framework that yields a straightforward discretization of the higher-order operators. First, we provide a calibration of the weight in front of the higher-order term, balancing the trade-off between accuracy and computational cost. Then, we compare the results obtained with second- and fourth-order AT1 and AT2 energies, using a few benchmark setups designed to focus the analysis on specific computational and physical aspects.}
}
@article{DEMONT2026118519,
title = {On the consistency of dynamic wetting boundary conditions for the Navier–Stokes–Cahn–Hilliard equations},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118519},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118519},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007911},
author = {T.H.B. Demont and S.K.F. Stoter and C. Diddens and E.H. van Brummelen},
keywords = {Diffuse-interface models, Navier–Stokes–Cahn–Hilliard equations, Dynamic wetting, Generalized Navier boundary condition, Sharp-interface limit},
abstract = {We investigate the limiting behavior of the Navier–Stokes–Cahn–Hilliard model for binary-fluid flows as the diffuse-interface thickness passes to zero, in the presence of fluid–fluid–solid contact lines. Allowing for motion of such contact lines relative to the solid substrate is required to adequately model multi-phase and multi-species fluid transport past and through solid media. Even though diffuse-interface models provide an inherent slip mechanism through the mobility-induced diffusion, this slip vanishes as the interface thickness and mobility parameter tend to zero in the so-called sharp-interface limit. The objective of this work is to present and analyze dynamic wetting and generalized Navier boundary conditions for diffuse-interface models that are consistent in the sharp-interface limit. We concentrate our analysis on the prototypical binary-fluid Couette-flow problems. To verify the consistency of the diffuse-interface model in the limit of vanishing interface thickness, we provide reference limit solutions of a corresponding sharp-interface model. For parameter values both at and away from the critical viscosity ratio, we present and compare the results of both the diffuse- and sharp-interface models. As a corollary of the close agreement between the diffuse-interface and sharp-interface results, the presented results can serve as a benchmark for future investigations.}
}
@article{DENG2026118572,
title = {Multi-material discrete variable topology optimization by order-independent random discrete steepest descent algorithm considering poor or conflicting material selections},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118572},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118572},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525008448},
author = {Zeyu Deng and Gengdong Cheng and Yuan Liang},
keywords = {Topology optimization, Multi-material, Categorical variable, Sequential approximate integer programming (SAIP), Combinatorial programming, Random discrete steepest descent (RDSD) algorithm},
abstract = {Multi-material structural topology optimization is a combinatorial programming problem involving discrete, nominal categorical variables selected from candidate materials. According to combinatorial theory, the optimal solution should be order independent of these categorical variables. Most existing multi-material topology optimization methods are strongly influenced by the predefined material order. Though a few studies have achieved order independence under prescribed volume fraction constraints for each candidate material, they only optimize material layout rather than automatically selecting materials and optimizing their respective quantities. Achieving order independence under the total structural material mass constraint is more challenging because it requires the algorithm to automatically discard poor materials that degrade structural performance and determine the optimal respective quantities and distribution of conflicting materials. To address these challenges, this paper proposes an order-independent Random Discrete Steepest Descent (RDSD) algorithm within the Sequential Approximate Integer Programming (SAIP) framework. The algorithm models the multi-material structural topology optimization as a multi-valued integer combinatorial programming problem and avoids interpolation schemes, which can alleviate the order dependent issue. A Russian Roulette strategy, serving as a global search mechanism that allows equal-probability movement in any direction rather than relying on manually restricted search directions, is incorporated as random perturbations within the deterministic SAIP framework. This neatly achieves order independence, escapes local optima within a single run, and ensures convergence in probability to the global optimum through multiple runs from the same initial design. Numerical examples demonstrate that the proposed algorithm achieves order-independence and effectively addresses poor or conflicting material selection under total mass and cost constraints.}
}
@article{NIEHUSER2026118525,
title = {Efficient augmented Lagrangian algorithms for rate-independent crystal plasticity models},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118525},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118525},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007972},
author = {Alexander Niehüser and Jörn Mosler},
keywords = {Crystal plasticity, Polycrystal, Augmented Lagrangian, NCP, Rate-independent, Finite deformation},
abstract = {Crystal plasticity theory offers a powerful framework for analyzing plasticity at different scales while incorporating crystallographic information into the constitutive model. However, classic rate-independent models face persistent challenges regarding the identification of active slip systems and the computation of plastic slips that are not necessarily unique due to the underlying set of equations. One well-established approach for solving such problems is the augmented Lagrangian formulation – known from constrained optimization. It will be shown that the fixed-point update employed in most augmented Lagrangian algorithms leads to a regular Jacobian despite the underlying ill-posed crystal plasticity model. Although, this results in a numerically very robust algorithm, it may not be as efficient as other algorithms proposed in literature. Therefore, the aim of this paper is to propose two improved augmented Lagrangian algorithms with increased efficiency. The first of those focuses on elaborated choices of initial penalty parameters, corresponding update strategies as well as adaptive tolerances for a Newton scheme. While these enhancements indeed improve the efficiency of the algorithm, their benefits are limited as large initial penalty values may lead to convergence problems similar to those encountered in the classic augmented Lagrangian algorithm. Therefore, a novel augmented Lagrangian algorithm based on a regularized Fischer-Burmeister NCP function is proposed. In this context, the initial penalty parameter may be selected significantly larger. Thus, the efficiency may be further increased, while still maintaining the regularizing effect of the first-order fixed-point update. A second-order update for the Lagrange multipliers is also discussed. Several numerical examples highlight the capabilities and limitations of the proposed algorithms. Representative volume simulations of a polycrystal show that especially the novel Fischer-Burmeister based algorithm is very robust and significantly faster than the classic augmented Lagrangian algorithm.}
}
@article{BHATKEELANJESRINIVAS2026118517,
title = {Rapid Offline Training for Deep Material Networks via a displacement-based laminate formulation and a novel sampling technique for a compliance-based fatigue model},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118517},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118517},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007893},
author = {Pavan {Bhat Keelanje Srinivas} and Matthias Kabel and Matti Schneider},
keywords = {Micromechanics, Deep Material Networks, Laminate formulations, Milton’s equation, Compliance-based fatigue},
abstract = {Deep Material Networks DMNs are based on hierarchical laminates and serve as surrogate models for the microstructure in multiscale computations. They involve a two-step process: In the initial training phase, the parameters of the laminates are identified via supervised learning on precomputed elastic data with varying stiffness tensors associated to the phases. In the second phase, the laminate parameters are fixed, and the DMN may be used for inelastic predictions, giving rise to the sought surrogate model. Once identified, DMNs lead to a tremendous speed-up compared to full-field simulations and turn out to be rather robust w.r.t. changes of the constitutive behavior of the individual phases comprising the microstructure. The work at hand offers two novelties: For a start, we take a look at the initial training phase which represents the bottleneck when using DMNs for industrial-scale problems. For laminate-based DMNs, we study three different ways to obtain the effective elastic properties of laminates. Although the different formulations lead to identical results in exact arithmetic, their numerical performance differs when used in the DMN training process. We find that the displacement-based laminate formulation leads to a speed-up factor of roughly seven compared to the two-phase Milton formulation. The second contribution concerns an innovative sampling strategy for the stiffness tensors to be used in the offline training for a compliance-based fatigue-damage model. The proposed strategy leads to robust training and accurate online predictions. We demonstrate the utility of our findings via dedicated computational experiments for industrial-scale glass-fiber reinforced composites.}
}
@article{FERRI2026118495,
title = {Explicit high-order time and space accurate isogeometric collocation method for the dynamics of geometrically exact beams},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118495},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118495},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007674},
author = {Giulio Ferri and Enzo Marino},
keywords = {Isogeometric analysis, Isogeometric collocation, Explicit dynamics, Geometrically exact beams, Runge-Kutta-Munthe-Kaas},
abstract = {The efficient simulation of highly deformable mechanical systems under fast and complex dynamic loads necessitates the advancement of explicit computational methods. Traditional explicit schemes, which leverage diagonal mass matrices and mass-scaling techniques, have improved efficiency. However, for problems evolving on nonlinear manifolds, such as IR3×SO(3), their accuracy remains limited to second-order in time. This limitation becomes even more critical when combined with high-order spatial techniques, such as Isogeometric Collocation (IGA-C), since it prevents the full exploitation of the spatial discretization potentialities. To address this gap, we propose a novel, fully explicit, high-order method for the dynamics of geometrically exact beams. The approach extends the Runge-Kutta-Munthe-Kaas (RKMK) scheme, originally developed for rigid body systems, to nonlinear partial differential equations governing deformable structures. The strong form of the problem is efficiently discretized in space using IGA-C, eliminating the need for element integration. Through various numerical tests, we demonstrate the ability of the proposed formulation to achieve high-order accuracy in time and space. Although the paper is focused on geometrically exact beams, the method is general and lays the ground for a promising extension to geometrically exact shells.}
}
@article{LIU2026118530,
title = {A unified and high-efficiency approach to accurately simulating strength degradation and fatigue failure of metals and geomaterials with splines-renormalizing technique},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118530},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118530},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525008023},
author = {Quanpu Liu and Siyu Wang and Lin Zhan and Haonan He and Otto Bruhns and Heng Xiao},
keywords = {Metal, Geomaterial, Elastoplastic, Strength degradation, Fatigue, Tension-compression asymmetry, Splines-renormalizing technique, High-efficiency algorithm},
abstract = {Usually, not only both modeling and numerical complexities need to be treated in simulating strength degradation and fatigue failure effects of metals and geomaterials but also the scope of applicability would be limited. Now, such complex effects may be accurately simulated with a new and high-efficiency approach. To achieve this objective, new elastoplastic equations of Prandtl-Reuss type are established by incorporating these effects as inherent response features and, meanwhile, non-symmetric tensile and compressive behaviors are decoupled by means of a stress mode invariant. Moreover, a new numerical technique of smoothly renormalizing piecewise spline functions is introduced to resolve the central yet tough issue of obtaining accurate expressions for the tensile and compressive strength functions from hardening to softening. In conjunction with this technique, new numerical schemes are designed in a unified sense of simulating various complex effects. In particular, new explicit direct algorithms are obtained for directly assessing fatigue failure, thus bypassing usual time-consuming integration calculations that need to be iteratively performed for each loading cycle. Since usual complexities involving numerous parameters and multiple criteria are rendered irrelevant, the new approach with these schemes is not only of wide applicability for both metals and geomaterials but of high computational efficiency with fewer than three and even no adjustable parameters. Toward validating the efficacy of the new approach, numerical examples with comparison to multiple data sets are provided for simulating hardening to softening behaviors of metal and concrete and rocks in tension and compression, tensile and compressive stiffness degradation effects of concrete and rocks during unloading, low and high cycle uniaxial fatigue failure of metal and concrete, flexural failure of metal beam and reinforced concrete beam, multi-axial fatigue failure of metal tube under cyclic combined loading as well as all-through ratcheting responses of concrete and metal samples with failure effects.}
}
@article{WU2026118554,
title = {Convolutional neural network-based mapping of material micro-structures to deep material networks for non-linear mechanical response prediction},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118554},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118554},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525008266},
author = {Ling Wu and Ludovic Noels},
keywords = {Deep-Material network, Convolutional neural network, Data-driven, Stochastic multi-Scale, Composites},
abstract = {Data-driven approaches make the development of surrogates of complex heterogeneous material responses possible. After being trained using a previously generated data-set during an offline stage, the surrogates can be used as a material law to conduct structural simulations during the online stage. Nevertheless, in view of accounting for the uncertainty and variability of the heterogeneous materials, the surrogates should be able to account for the micro-structure variability, which remains a challenge. Among the possible surrogate candidates, (Interaction-Based-)Deep-Material Networks ((IB-)DMN) offer the advantage that they can extrapolate the response for new material model parameters of the heterogeneous material phases and for arbitrary loading histories outside of their training range. This advantage results from their thermodynamics consistency and from the fact that the IB-DMN learnable parameters represent solely the micro-structure organization and not the phases material response. However, a trained IB-DMN remains an image of a given micro-structure spatial organization realization in terms of clustering etc. A new micro-structure realization thus requires a new training process, limiting the interest of the IB-DMN for stochastic multi-scale analyses. In order to address this limitation, we define the learnable or topological parameters of the IB-DMN from a combination of convolution encoder and neural network, with the micro-structure image serving as input data. After training a CNN encoder-decoder, the encoder part allows extracting the feature vectors of the heterogeneous material directly from micro-structure images. These feature vectors then serve as input of a trained feed-forward neural network (FNN) that predicts the topological parameters of the IB-DMN, yielding a “Image to IB-DMN” framework. The methodology is first illustrated in the context of Unidirectional (UD) composites, for which Stochastic Volumes Elements (SVEs) serve as images of the micro-structure realizations. In a second step we show that the machine learning tools can be trained by considering simultaneously composite families of different inclusion shapes such as circular, elliptical and squared. Despite training considering only elastic data, the predictions for a complex pressure-sensitive elasto-plastic model remain accurate. These results demonstrate the complementary roles of the two networks: the CNN encoder–decoder efficiently extracts reduced feature vectors from micro-structure images with diverse inclusion geometries, and the FNN accurately maps these features to the topological parameters of the IB-DMN, establishing a robust, end-to-end image-to-model framework capable of generalizing across different micro-structural configurations.}
}
@article{RINDERER2026118507,
title = {Topology optimization of 3D finite deformation frictional mortar contact problems using adjoint sensitivities},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118507},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118507},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007790},
author = {L. Rinderer and A. Popp and M.W. Gee},
keywords = {Finite deformations, Mortar methods, Frictional contact mechanics, Sensitivity analysis, Adjoint method, Topology optimization},
abstract = {Gradient-based optimization strategies, such as topology optimization, rely on sensitivity information to iteratively update design parameters and optimize a performance measure. Advanced sensitivity analysis techniques, such as the adjoint method, leverage detailed knowledge of the system’s governing equations. In the context of finite deformation contact mechanics, as considered here, both geometric nonlinearity and nonlinearity arising from the contact itself must be taken into account. When frictional sliding is present, the governing equations become path-dependent. In this contribution, we derive the sensitivity analysis within an adjoint framework, including consistent analytical linearization, for three of the most common contact constraint enforcement methods: the Lagrange multiplier method, the penalty method, and the augmented Lagrangian method. A state-of-the-art mortar finite element approach is used for the spatial discretization of contact and frictional sliding terms. Finally, we present numerical examples that demonstrate the capabilities of the newly developed sensitivity analysis strategies.}
}
@article{SHI2026118546,
title = {A 3D multi-resolution SPH-FEM coupling model with boundary penetration prevention technique for violent fluid-structure interactions},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118546},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118546},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525008187},
author = {Wen-Kui Shi and Cheng Chen and Yu-Xiang Peng and Yan-Ming Shen and Jian-Qiang Chen and Mou-Bin Liu},
keywords = {3D SPH-FEM Coupling, Single-layer boundary condition, Penalty displacement technology, Multi-resolution, Shell elements},
abstract = {Fluid-structure interaction (FSI) problems with free surfaces are important both in natural phenomena and industrial applications. However, due to the complexity of violently changing free surfaces, large structural deformation, and dynamic fluid-structure interaction phenomena, it is usually difficult to accurately model FSI problems. The Smoothed Particle Hydrodynamics (SPH) method is a meshless method which has special advantages in dealing with free surface flows due to its inherent Lagrangian nature. The Finite Element Method (FEM) is renowned for its capabilities in structural analysis with high accuracy and efficiency. In this paper, we present a 3D SPH-FEM coupling model for modeling FSI problems with violently changing free surfaces. In the model, particle shifting technology is integrated into the δ-SPH to enhance fluid simulation, while Mindlin-Reissner shell elements are employed in FEM for structural modeling to reduce geometric complexity and improve computational efficiency. The FSI coupling is implemented through a normal-flux single-layer boundary condition at the fluid-solid interface. Furthermore, a novel penalty displacement technology (PDT) is proposed to prevent particle penetration, which commonly occurs in 3D shell elements during FSI simulations. Additionally, a 3D spatial multi-resolution technique is developed to enhance the robustness and computational efficiency of FSI simulations. The developed 3D SPH-FEM model is validated through several benchmark FSI problems, and the results show good agreement with reference solutions. The results demonstrate the accuracy and efficiency of the presented SPH-FEM model for FSI problems with violently changing free surfaces.}
}
@article{JIA2026118445,
title = {Multimaterial topology optimization for finite strain elastoplasticity: Theory, methods, and applications},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118445},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118445},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007170},
author = {Yingqi Jia and Xiaojia Shelly Zhang},
keywords = {Plasticity, Finite strain, Isochoric plastic flow, Topology optimization, Multimaterial, Energy dissipation},
abstract = {Plasticity is inherent to many engineering materials such as metals. While it can degrade the load-carrying capacity of structures via material yielding, it can also protect structures through plastic energy dissipation. To fully harness plasticity, here we present the theory, methods, and applications of a topology optimization framework that simultaneously optimizes structural geometries and material phases to customize the stiffness, strength, and structural toughness of designs experiencing finite strain elastoplasticity. The optimization formulation includes various objective functions and functional constraints. The framework accurately predicts structural responses by employing a rigorous, mechanics-based elastoplasticity theory that ensures isochoric plastic flow. It also effectively identifies optimal material distributions using a gradient-based optimizer, where gradient information is obtained via a reversed adjoint method to address history dependence, along with automatic differentiation to compute the complex partial derivatives. We demonstrate the framework’s capabilities by optimizing a range of 2D and 3D multimaterial elastoplastic structures under large deformations with diverse real-world applications, including energy-dissipating dampers, load-carrying beams, impact-resisting bumpers, and cold working profiled sheets. These optimized multimaterial structures reveal important mechanisms for improving design performance under large deformations, such as the transition from kinematic to isotropic hardening with increasing displacement amplitudes and the formation of twisted regions that concentrate stress, enhancing plastic energy dissipation. Through the superior performance of these optimized designs, we demonstrate the framework’s effectiveness in tailoring elastoplastic responses across various material types, hardening behaviors, and numbers of candidate materials as well as handling various design objectives and constraints. This work offers a systematic approach for optimizing next-generation multimaterial structures with elastoplastic behaviors under large deformations.}
}
@article{LUO2026118508,
title = {Enhancing DSMC simulations of rarefied gas mixtures using a fast-converging and asymptotic-preserving scheme},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118508},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118508},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007807},
author = {Liyan Luo and Jianan Zeng and Yanbing Zhang and Wei Li and Qi Li and Lei Wu},
keywords = {Rarefied gas dynamics, Gas mixtures, Direct simulation Monte Carlo, Fast convergence, Asymptotic preserving,},
abstract = {The numerical simulation of rarefied gas mixture dynamics with disparate masses using the direct simulation Monte Carlo (DSMC) method is slow, primarily because the time step is constrained by that of the lighter species, necessitating an enormous number of evolution steps to reach a steady state. Here, we address this issue by developing a general synthetic iterative scheme, in which the traditional DSMC simulation is intermittently enhanced using a macroscopic synthetic equation. Specifically, after running the DSMC for a certain number of time steps, the high-order constitutive relations for stress and heat flux, as well as the momentum and energy exchange terms from inter-species collisions, are extracted from the DSMC and incorporated into the macroscopic synthetic equations. These equations are solved to obtain the steady state, and the solution is then used to update the particle distribution in DSMC, thereby skipping unnecessary intermediate evolutions. This two-way coupling not only accelerates convergence to the steady state but also asymptotically preserves the Navier-Stokes limit in the continuum flow regime, allowing the spatial cell size to be much larger than the molecular mean free path. The accuracy of our method is validated for one-dimensional force-driven Poiseuille flow and two-dimensional hypersonic flow past cylinders, considering Maxwell and hard-sphere gases with mass ratios of 10 and 100. Moreover, the one-dimensional shock wave structure and thermal driven low-speed flow have been investigated using a more realistic intermolecular potential. Although our in-house DSMC method is approximately an order of magnitude slower than the open-source DSMC code SPARTA, intermittently augmenting it with the synthetic equation makes it roughly 30 times faster at a Knudsen number of 0.01, with even greater computational gains anticipated at smaller Knudsen numbers. This work represents a critical step toward developing fast-converging and asymptotic-preserving schemes for hypersonic chemical reactions.}
}
@article{ZHENG2026118468,
title = {Multiphysics uncertainty decoupling methods for stochastic poroelastic analysis},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118468},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118468},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007406},
author = {Zhibao Zheng and David Néron and Udo Nackenhorst},
keywords = {Stochastic poroelasticity, Stochastic multiphysics problems, Multiphysics uncertainty decoupling, Stochastic model order reduction},
abstract = {This article presents an efficient multiphysics framework for linear and nonlinear stochastic poroelastic analysis. Specifically, an uncertainty decoupling method is developed to decouple the overall multiphysics stochastic solution into stochastic solutions of each physical field. Stochastic solutions of each physical field are approximated by a unified representation and expressed as the summation of a series of products of triplets of spatial functions, temporal functions and random variables. Each triplet is then solved in a greedy way using a dedicated iteration, which transforms the original stochastic problems into deterministic problems and very low-dimensional stochastic problems that can be solved almost independently of stochastic dimensions. Compared with existing coupled stochastic solution approximations, the proposed uncertainty decoupling method has better convergence without loss of accuracy, thus saving computational efforts. Numerical examples of linear and nonlinear stochastic poroelasticity with high-dimensional random inputs demonstrate the promising performance of the proposed framework.}
}
@article{WANG2026118514,
title = {Dynamic space-time adaptive volume-of-fluid method for compressible two-phase flows},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118514},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118514},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007868},
author = {Yijun Wang and Jonas Luther and David Jenny and Patrick Jenny},
keywords = {Compressible two-phase flows, Volume-of-fluid, Adaptive solver, Interface compression},
abstract = {An adaptive volume-of-fluid (VOF) framework, specifically developed for efficient and accurate solutions of multi-scale compressible two-phase flow problems, is devised. The method extends a recently developed space-time adaptive framework for compressible single phase flows, characterized by its combination of a tree-based grid refinement and a local time integration scheme for compressible two-phase flows. Emphasis is put on devising accurate and robust numerical schemes based on dynamically evolving asynchronous grid cells that arises from the space-time adaptivity. These asynchronous schemes also offer solutions to critical challenges in two-phase flows such as dealing with the non-conservative terms, large density ratios and surface tension forces. Moreover, in order to counteract numerical diffusion, an improved interface compression scheme is devised, which demonstrates the capability of preserving the sharpness of fluid interfaces at reduced computational cost. Collectively, these schemes establish a comprehensive novel approach for simulating complex two-phase flows. The efficacy of the solver is substantiated through a series of challenging 1D, 2D and 3D test cases, including capillary oscillation and shock bubble/droplet interactions.}
}
@article{HOEKSTRA2026118506,
title = {Reduced subgrid scale terms in three-dimensional turbulence},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118506},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118506},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007789},
author = {Rik Hoekstra and Wouter Edeling},
keywords = {Reduced subgrid scale modelling, Large eddy simulation, Turbulence, Stochastic},
abstract = {Large eddy simulation (LES) has become a central technique for simulating turbulent flows in engineering and applied sciences, offering a compromise between accuracy and computational cost by resolving large-scale motions and modeling the effects of smaller, unresolved scales through a subgrid scale (SGS) model. The fidelity and robustness of LES depends critically on the SGS model, particularly in coarse simulations where much of the turbulence spectrum remains unresolved. In this work, we extend the tau-orthogonal (TO) method, a data-driven SGS modeling framework, to three-dimensional turbulent flows. The method reformulates the high-dimensional SGS closure problem as a low-dimensional prediction task focused on spatially-integrated, scale-aware quantities of interest (QoIs). We extend the model to incorporate QoI-state dependence and temporal correlations by combining regularized least-squares regression with a multivariate Gaussian residual model. This yields a simple yet effective stochastic time-series prediction model, with orders-of-magnitude fewer parameters than typical deep learning approaches which try to directly learn the high-dimensional SGS closure. We demonstrate the effectiveness of the new TO model in three-dimensional forced isotropic turbulence, turbulent channel flow and on a Taylor-Green vortex. The model achieves accurate long-term QoI distributions, robust performance across hyperparameter settings, and good reproduction of key flow features such as kinetic energy spectra and coherent structures, despite being trained solely on QoI trajectories. Comparisons against classical SGS models, including Smagorinsky and WALE formulations, highlight the new model’s balance of accuracy and computational efficiency.}
}
@article{JIANG2026118490,
title = {Efficient Bayesian inversion of hydraulic parameters for unsaturated soil slopes using a fine-tuned deep operator network},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118490},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118490},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007625},
author = {Shui-Hua Jiang and Hong-Hu Jie and Peng Lan and Jinsong Huang},
keywords = {Unsaturated soil slope, Rainfall infiltration, Deep operator network, Bayesian inversion, Surrogate model},
abstract = {Accurately quantifying the spatial variability of hydraulic parameters is crucial for slope stability analysis. Although Bayesian inversion with monitoring data can provide estimates of hydraulic parameters, it entails computationally intensive and time-consuming numerical simulations. Surrogate models are commonly employed to enhance computational efficiency. However, traditional surrogate models struggle to accurately capture the high-dimensional mapping between the random field of hydraulic parameters and the spatiotemporal responses of soil slopes. Moreover, they are typically trained on fixed statistical distribution, limiting the generalization capability. To overcome these challenges, this study proposes a novel surrogate model for Bayesian inversion that integrates Bayesian Updating with Subset simulation (BUS) and a fine-tuned (FT) deep operator network (DeepONet). Specifically, the DeepONet model is designed to learn the high-dimensional operator relationship between the random field of hydraulic parameters and the spatiotemporal responses of soil slopes, improving computational efficiency. Subsequently, a fine-tuning strategy, leveraging intermediate subset samples of BUS, is employed to iteratively refine the DeepONet model's predictive accuracy during Bayesian inversion, enhancing its generalization capability. The performance of the proposed method is validated using field-measured pore water pressure data from a real slope in Hong Kong, China. Results show the proposed method effectively resolves challenges in high-dimensional operator mapping, and limitations of generalization capability. Moreover, the proposed method can achieve statistically equivalent accuracy to conventional Bayesian inversion approaches for posterior estimation, while simultaneously delivering a 92 % reduction in computational time.}
}
@article{HONORIO2026118515,
title = {A machine learning-based stabilized finite element formulation for the mean stress computation in linear elasticity and coupled poroelasticity},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118515},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118515},
url = {https://www.sciencedirect.com/science/article/pii/S004578252500787X},
author = {Hermínio T. Honório and Andrea Franceschini and Massimiliano Ferronato and Hadi Hajibeygi},
keywords = {Poroelasticity, Finite elements, Stabilization, Physical influence scheme, Machine learning},
abstract = {This work addresses numerical instabilities that can appear when computing the mean stress in linear elasticity and coupled poroelasticity problems discretized with low-order finite elements. The linear elasticity and coupled poroelasticity models are solved using both primal and mixed finite element formulations. Stabilization is obtained by enriching the finite element approximation with an approximation of the Laplacian of displacements. This Laplacian is then evaluated with the Physical Influence Scheme (PIS) by leveraging the underlying governing equation. A key step in the proposed stabilization is the calculation of a parameter h, often computed in the literature as a characteristic length of the element. In this work, we calculate h by solving an optimization problem at the element level. To avoid the high computational cost associated with this procedure, a machine learning model is proposed to predict the optimal h. The benefit of combining PIS with an appropriate computation of h is that the resulting stabilization scheme does not rely on any type of heuristic or user-specified tuning parameter, as often required in other stabilization methods. The results show that the proposed stabilization strategy can effectively remove both saddle-point and Gibbs mean stress oscillations in linear elasticity. We also report, for the first time, that mean stress oscillations can also appear when solving coupled poroelasticity problems, and, differently from pore pressure oscillations (which naturally vanish with time), mean stress instabilities are persistent throughout the whole simulation time, unless deliberately removed. The proposed stabilized mixed formulation is able to remove both pore pressure and mean stress oscillations in coupled poroelasticity problems. Finally, the calculation of h is shown to be critical for the quality of the stabilization, with the machine learning-based approach providing the best compromise between numerical diffusion and accuracy.}
}
@article{ZHOU2026118510,
title = {A mixed smoothed finite element limit analysis framework: integrating non-conforming mesh and cohesive-frictional contact},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118510},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118510},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007820},
author = {Xi-Wen Zhou and Yin-Fu Jin and Jie Yang and Zhen-Yu Yin and Feng-Tao Liu and Xiangsheng Chen},
keywords = {Smoothed Finite Element Limit Analysis, Non-conforming mesh, Surface-to-Surface, Mortar method, Volumetric locking},
abstract = {Non-conforming meshes give modern finite-element method (FEM) great geometric flexibility, yet their application to finite-element limit analysis (FELA) remains limited. This study develops a novel mixed smoothed finite-element limit-analysis (S-FELA) framework that embeds cohesive–frictional contacts in non-conforming meshes. The conventional velocity–stress mixed variational principle is extended to address the challenges associated with connecting non-conforming meshes and handling cohesive–frictional contact. The classical mortar Surface-to-Surface contact discretization scheme is employed to guarantee solution continuity even in the presence of mesh gaps or overlaps, and a fixed-point iteration equipped with Anderson acceleration is designed to consider the non-associated friction contact. Through a primal-dual transformation the mixed formulation is ultimately cast in a stress-based dual formation, obviating the explicit derivation of plastic dissipation functions. When the yield criterion is representable as a convex cone, the stress-based dual formulation is equivalent to the classical velocity-based primal formulation. Additionally, to prevent volumetric locking and improve the performance of low-order triangular elements, the smoothed finite-element method (S-FEM) is adopted for spatial discretization. A mixed constant-stress smoothed-strain interpolation scheme is developed permitting the direct application of S-FEM within the FELA setting. A comparative investigation of several S-FEM variants indicates that, although the node-based S-FEM (NS-FEM) occasionally attains high accuracy, its intrinsic numerical instability can lead to underestimated limit loads and checkerboard stress patterns. This framework advances the theoretical foundation of FELA and offers a practical solution for engineering applications requiring the flexibility of non-conforming meshes.}
}
@article{WU2026118528,
title = {Residual correction for POD-Galerkin reduced order models via conditional VAEs: Application to the bias-aware solution of forward and inverse problems},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118528},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118528},
url = {https://www.sciencedirect.com/science/article/pii/S004578252500800X},
author = {Dawen Wu and Ludovic Chamoin},
keywords = {Reduced order models, Proper orthogonal decomposition, Conditional variational autoencoder, Residual correction, Parameterized PDEs},
abstract = {POD-Galerkin reduced order models (PGROMs) significantly accelerate the solution of parameterized partial differential equations (PDEs) but can suffer from accuracy limitations across the parameter space. We propose a hybrid framework that augments a PGROM with a data-driven residual corrector based on a conditional variational autoencoder (cVAE). In the offline stage, we (i) construct a standard PGROM from high-fidelity snapshots and (ii) train a cVAE on PGROM residuals defined as the differences between PGROM approximations and the corresponding high-fidelity solutions. The cVAE learns a mapping from time-parameter pairs to residual fields. In the online stage, for a new parameter instance, the PGROM provides a baseline approximation while the cVAE decoder predicts the residual; adding the two yields a corrected, high-accuracy solution. The effectiveness of the proposed hybrid approach is demonstrated on three parameterized PDE problems: a heat dissipation problem with varying thermal conductivity, a pollutant transport problem with varying convection velocity, and a plane-strain elastodynamics problem with a circular inclusion whose stiffness and density are parameterized.}
}
@article{HAMDI2026118526,
title = {Towards robust surrogate models: Benchmarking machine learning approaches to expediting phase field simulations of brittle fracture},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118526},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118526},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525007984},
author = {Erfan Hamdi and Emma Lejeune},
keywords = {Open science, Benchmark dataset, Phase field fracture, PINN, FNO, UNet},
abstract = {Data-driven approaches have the potential to make modeling complex, nonlinear physical phenomena significantly more computationally tractable. For example, computational modeling of fracture is a core challenge where machine learning techniques have the potential to provide a much needed speedup that would enable progress in areas such as multi-scale modeling and uncertainty quantification. Currently, phase field modeling (PFM) of fracture is one such approach that offers a convenient variational formulation to model crack nucleation, branching and propagation. To date, machine learning techniques have shown promise in approximating PFM simulations. While standard fracture benchmarks represent realistic scenarios frequently observed in practice, they typically do not provide sufficiently challenging tests for data-driven methods. To address this gap, we introduce a challenging dataset based on PFM simulations designed to benchmark and advance ML methods for fracture modeling. This dataset includes three energy decomposition methods, two boundary conditions, and 1000 random initial crack configurations for a total of 6000 simulations. Each sample contains 100 time steps capturing the temporal evolution of the crack field. Alongside this dataset, we also implement and evaluate Physics Informed Neural Networks (PINN), Fourier Neural Operators (FNO), and UNet models as baselines, and explore the impact of ensembling strategies on prediction accuracy. With this combination of our dataset and baseline models drawn from the literature we aim to provide a standardized and challenging benchmark for evaluating machine learning approaches to solid mechanics. Our results highlight both the promise and limitations of popular current models, and demonstrate the utility of this dataset as a testbed for advancing machine learning in fracture mechanics research.}
}
@article{XIE2026118555,
title = {Higher order shear deformable geometrically exact shells based on a new kinematic assumption},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {449},
pages = {118555},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2025.118555},
url = {https://www.sciencedirect.com/science/article/pii/S0045782525008278},
author = {Ke Xie and Bo Liu and Chaoyi Peng and Yingying Lan and Yufeng Xing},
keywords = {Geometrically exact shell, Higher order shear deformation theory, Basic kinematic assumption, Large rotations, Shell finite elements},
abstract = {In this paper, we propose a new geometrically exact shell model integrating higher order shear deformation theory (HSDT). Departing from the classical geometrically exact shell model, the proposed shell model fundamentally reconstructs the basic kinematic assumption through synergistic use of the unit normal vector field and director field, enabling higher order deformation pattern of transverse fibers. This reconstruction naturally leads to newly defined generalized strain components and a novel constitutive relation. Compared to the five-DOF classical geometrically exact shell model, seven DOFs are allocated to each node at the element level due to employing the unit normal vector field in constructing kinematic relations. The additional DOFs are eliminated in the global equations by enforcing the constraint conditions for the unit normal vector field according to kinematic relations. Since the unit normal vector is employed as an intermediate quantity in this model, distinct from the updates of director field, a specialized update procedure is developed to maintain orthonormality of the unit normal vector field during large rotations. The MITC scheme is borrowed in this model to address membrane and shear locking phenomena. A comprehensive set of numerical examples is presented to illustrate the effectiveness of the present formulation in predicting static behaviors of shells undergoing large deformations and rotations.}
}
