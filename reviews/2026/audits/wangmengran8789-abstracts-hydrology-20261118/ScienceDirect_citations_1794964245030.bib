@article{LI2026136007,
title = {Reconstruction and evolution analysis of long-term terrestrial water storage anomalies in Xinjiang based on time series decomposition and multi-model coupling},
journal = {Journal of Hydrology},
volume = {677},
pages = {136007},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136007},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011042},
author = {Zilong Li and Zhenxia Mu and Jing Liu and Xiaoyan Qiu},
keywords = {GRACE/GRACE-FO, Terrestrial water storage anomalies, Component decomposition and reconstruction, VIC Model, Xinjiang},
abstract = {The Gravity Recovery and Climate Experiment (GRACE) and its successor GRACE Follow-On (GRACE-FO) provide a new observational method for monitoring large-scale Terrestrial Water Storage Anomalies (TWSA). However, existing TWSA records cover only the period since 2002 and exhibit mission discontinuities, which limits their applicability in studies of long-term hydrological changes. Therefore, this study proposes a TWSA component reconstruction framework coupled with time-series decomposition, the VIC hydrological model and machine learning to reconstruct a monthly-scale TWSA dataset at a resolution of 0.25°×0.25° from 1961 to 2022 in Xinjiang, and to verify its reliability using JPL and CSR Mascon products and multi-source observation data. The main findings of this study include: (1) During the GRACE observation period, the reconstructed TWSA exhibits high consistency with CSR-Mascon and JPL-Mascon in spatiotemporal distributions: approximately 70% of grids have CC > 0.6, over 60% have NSE > 0.6, and more than 80% of grid cells have RMSE < 15 cm and DISO < 6. (2) Independent validation based on groundwater-level observations showed that the standardized reconstructed groundwater storage anomalies derived from reconstructed TWSA were positively correlated with standardized groundwater-level anomalies in all groundwater-validation grids (CC = 0.23–0.81), indicating that the reconstructed results can generally characterize the temporal consistency of groundwater variations. Meanwhile, the reconstructed TWSA shows strong correlations (CC > 0.60) with CNRD v1.0 and TerraClimate runoff depth in 57% and 85% of the areas, respectively, with local CCs exceeding 0.85, indicating that the reconstructed TWSA can reasonably reflect the hydrological response characteristics of runoff variations. (3) Reconstruction results show that the TWSA in Xinjiang exhibited a predominantly downward trend from 1961 to 2022, with 60.8% of the study area showing a downward trend. The intra-annual variation shows a surplus in winter and deficits in spring and summer, and the seasonal amplitude and long-term trend exhibit significant spatial heterogeneity. The reconstructed long-term TWSA dataset provides a data foundation for diagnosing water storage evolution, monitoring hydrological droughts, and assessing water resources in Xinjiang.}
}
@article{ZAINAB2026135962,
title = {Microplastics in karst groundwater: a review of current findings and methodological biases},
journal = {Journal of Hydrology},
volume = {677},
pages = {135962},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135962},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010590},
author = {Syeda Maria Zainab and Dan Lapworth and Richard Cross and Katherine Pond and Monica Felipe-Sotelo and Louise Maurice},
keywords = {Karst aquifers, Microplastics, Groundwater contamination, Quality assurance/quality control},
abstract = {Karst aquifers are globally important yet highly vulnerable water resources. Their rapid recharge, limited natural filtration, and conduit-dominated flow make them susceptible to contamination, including by emerging pollutants such as microplastics (MPs). While MPs are well documented in marine, freshwater, and terrestrial systems, their occurrence and behaviour in karst groundwater remain poorly understood. This review synthesises 22 published studies on MPs in karst caves, springs, wells, and boreholes, assessing comparability using a widely applied quality assessment framework and a critical evaluation of methodological influences on reported MP concentrations and characteristics. Reported concentrations vary by several orders of magnitude (0.001–911 particles/L), which is likely to reflect both karst environmental variability and methodological differences in sampling design, detection limits, contamination control, and analytical specificity. Temporal datasets remain limited, but existing studies suggest high-flow events substantially increase MP loads. No single analytical technique is quantitative across the full diversity of MPs, each being inherently selective toward sizes, shapes, or polymers. Notably, stereomicroscopy appears to overrepresent fibres, while low-density separation, such as sodium chloride solutions, miss higher-density plastics. These findings highlight the need for clear reporting of the operational definition of MPs in each study to improve cross-study comparability. We propose a harmonised sampling and analytical workflow to support future karst MP research, alongside the continued need for robust quality assurance/quality control practices, broader geographic coverage, and higher temporal resolution sampling. More work beyond simple concentration reporting is needed to investigate mechanistic processes driving MP transport and fate.}
}
@article{LIN2026136015,
title = {Non-contact discharge estimation using physics-informed neural networks and CNN-enhanced image velocimetry},
journal = {Journal of Hydrology},
volume = {677},
pages = {136015},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136015},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011121},
author = {Yen-Cheng Lin and Cheng-Wei Wu and Hao-Che Ho},
keywords = {Large-scale particle image velocimetry, Physics-informed neural networks, Convolutional neural networks, Non-contact discharge estimation, Water depth inversion},
abstract = {Accurate river discharge estimation using non-contact techniques remains a fundamental challenge in hydrology, particularly under complex field conditions. This study proposes a physics-informed framework for non-contact river discharge estimation by integrating CNN-enhanced Large-Scale Particle Image Velocimetry (CNN-LSPIV) with physics-informed neural networks (PINNs). The shallow water continuity equation is incorporated into the loss function to enforce mass conservation during velocity refinement and water depth inversion. Two inversion strategies are developed: a velocity-refinement mode (PINN-VR), which refines CNN-LSPIV velocity fields prior to leapfrog-based depth integration, and a direct depth inversion mode (PINN-DDI), which simultaneously reconstructs velocity and depth fields through global physics-constrained optimization. The framework is validated using laboratory flume experiments under three bed configurations (smooth, lateral composite, and longitudinal composite beds) and further evaluated through unmanned aerial vehicle (UAV)-based field observations with acoustic Doppler current profiler (ADCP) validation. CNN-LSPIV substantially improves surface velocity measurement relative to conventional LSPIV. PINN-VR shows superior depth reconstruction under lateral bed configurations, whereas PINN-DDI performs best under longitudinal bed variations because its globally optimized formulation reduces sensitivity to directional error accumulation. Under composite bed conditions, both PINN-based strategies improve discharge estimation relative to CNN-LSPIV, with PINN-DDI yielding the lowest discharge errors. These results demonstrate that embedding physical constraints into image-based flow reconstruction improves the physical consistency and relative accuracy of non-contact discharge estimation, highlighting its potential for more reliable field-scale applications in complex natural river environments.}
}
@article{BASHEER2026135918,
title = {Design of stream gauge network using fuzzy entropy approach considering impact of climate change},
journal = {Journal of Hydrology},
volume = {677},
pages = {135918},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135918},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010152},
author = {Lisha Basheer},
keywords = {Fuzzy entropy, Stream gauge network, Climate models, Downscaling, Artificial Neural Network},
abstract = {Stream gauge stations are important for measuring the discharge of streams and understanding flow. Designing stream gauge networks under climate change scenarios could provide valuable insights for hydrological monitoring and water resource management. This paper presents a fuzzy entropy-based methodology for the design of stream gauge network considering impact of climate change. Study area comprising of three river basins in Kerala (Periyar, Chalakkudi and Bharathappuzha) has seven stream gauge stations maintained by Central Water Commission (CWC). For incorporating impact of climate change, the input variables (rainfall, temperature and wind speed) for predicting future runoff are downscaled from Regional Climate Model (RCM). Analysis of existing stream gauge network is done considering observed and predicted flow values. Fuzzy Mutual Information Index (FMII) value is computed for each station and stream gauge deficit zones are identified. As per minimum density requirements of WMO (2008), required number of stations are calculated as ten which is more than the existing number of stations. For the design of new stream gauge network, possible locations of additional stations are chosen from outlet points obtained by delineating study area which yielded twelve stations. Flows at the possible locations of new stations together with the flows at the existing stations are used to compute entropy measures to determine the optimal locations of stations required for the new stream gauge network. For determining optimal station locations, one objective is to minimize fuzzy mutual information and the other is to maximize fuzzy joint entropy. The design stream gauge network thus obtained consists of ten stations in which five stations are existing stations and five stations are new locations. The design network can be regarded as best network in economical point of view and in satisfying minimum density requirements of WMO.}
}
@article{WANG2026135966,
title = {Experimental study on pore–permeability evolution during mineral dissolution with dynamic variations in specific surface area and tortuosity},
journal = {Journal of Hydrology},
volume = {677},
pages = {135966},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135966},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010632},
author = {Yaohui Wang and Hui Cheng and Shilin Zhang and Donghui Wang and Qingcheng He and Fugang Wang},
keywords = {Reactive transport, Mineral dissolution, Porosity–permeability relationship, Hydrodynamic regime, Kozeny–Carman model},
abstract = {In the evolution of groundwater systems, pore structure evolution induced by water–rock reactions significantly influences the flow properties of porous media. However, existing porosity–permeability relationship models often neglect the dynamic variations in pore-structure parameters, such as the specific surface area (SSA) and tortuosity, when describing mineral dissolution-dominated reactive transport processes. Moreover, the regulatory role of hydrodynamic conditions on the rate of pore-structure evolution lacks systematic experimental constraints. In this study, sandstone dissolution by a carbonic acid solution was investigated experimentally. The dynamic variations in SSA and tortuosity during dissolution and their effects on permeability were quantitatively characterized. The results show that increases in porosity during mineral dissolution are accompanied by significant decreases in SSA and tortuosity, and that both parameters exhibit stable, approximately linear negative correlations with porosity. As hydrodynamic conditions shift from diffusion- to advection-dominated regimes, the decreasing rates of SSA and tortuosity increase markedly, indicating that hydrodynamic conditions exert significant control on the rate of pore-structure evolution. Linear empirical relationships among SSA, tortuosity, and porosity were established and incorporated into a normalized Kozeny–Carman model to evaluate the effect of dynamic pore-structure evolution on relative permeability. Compared with a porosity-only K–C-type model, this experimentally constrained formulation better captures the observed permeability enhancement during mineral dissolution. This study provides experimental support for the representation of porosity–permeability relationships in reactive transport modeling and offers important references for groundwater flow prediction and solute transport characterization.}
}
@article{DOU2026135930,
title = {A neighborhood change detection method for soil moisture retrieval using single-temporal Sentinel-1 data over vegetated fields},
journal = {Journal of Hydrology},
volume = {677},
pages = {135930},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135930},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010279},
author = {Qi Dou and Jie Yang and Weidong Sun and Lingli Zhao and Lei Shi and Hongtao Shi and Chuang Liu and Jiaxin Qian and Qinghua Xie},
keywords = {Soil moisture, Change detection, Neighborhood information, Synthetic aperture radar (SAR), Sentinel-1},
abstract = {The short-term change detection (STCD) method obviates the need for complex modeling of surface and vegetation scattering processes, providing a simple and efficient means for large-scale soil moisture estimation from synthetic aperture radar (SAR) data. However, due to the reliance on prior assumptions and densely observed time-series data, the STCD method is susceptible to temporal variations in surface roughness and vegetation, and may introduce delays in generating stable retrieval results through a temporal sliding window. This study proposes a neighborhood change detection (NCD) method that incorporates spatial information into the retrieval framework. Instead of assuming parameter invariance over time, the NCD method transfers this assumption to the spatial domain. By constructing a system of equations based on observations from a target pixel and its neighboring pixels, the method enables soil moisture retrieval using a single-temporal SAR image. To mitigate the effects of spatial heterogeneity in vegetation, homogeneous pixels are selected based on the similarity of target scattering characteristics. A weighting strategy is then applied to the constructed linear system to enhance retrieval stability. Considering the uncertainty inherent in the underdetermined parameter estimation process, physical bounds derived from passive microwave soil moisture products are used to constrain and optimize the solution. The validation results based on C-band Sentinel-1 data and in situ measurements demonstrate that the proposed NCD method achieves retrieval performance comparable to the traditional STCD approach, despite the limited information provided by a single-temporal acquisition. The retrieval results yield root mean square errors of 0.068 m3/m3 and 0.072 m3/m3 for the two soil moisture monitoring networks, with correlation coefficients of 0.74 and 0.58, respectively. Moreover, the NCD method exhibits particularly strong robustness under conditions of relatively low soil moisture and limited variability in its temporal dynamics. The proposed NCD algorithm further reduces the complexity of data acquisition and processing, offering a complementary alternative for near real-time soil moisture mapping in support of emergency applications.}
}
@article{ZHANG2026135982,
title = {Spatiotemporal hydrological connectivity on karst hillslopes: Insights from high-frequency moisture monitoring},
journal = {Journal of Hydrology},
volume = {677},
pages = {135982},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135982},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010796},
author = {Yutong Zhang and Jun Zhang and Fa Wang and Jinjiao Lian and Zhiyong Fu and Hongsong Chen},
keywords = {Hydrological connectivity, Soil thickness, Threshold effect, Preferential flow, Karst hillslope},
abstract = {Hydrological connectivity (HC) crucially controls runoff generation and biogeochemical transport in terrestrial ecosystems. However, how subsurface structural heterogeneity regulates HC in complex karst environments remains poorly understood. The modulating role of soil thickness on HC dynamics was investigated using high-frequency (5-min) soil moisture monitoring across two karst hillslopes with contrasting mean soil depth (35 cm vs. 66 cm). HC was identified by soil saturation conditions, while its spatiotemporal characteristics were quantified using metrics including connectivity strength (CS), response timing (Ts), and peak lag time (Tp). Results showed that both hillslopes followed a downslope-to-upslope expansion sequence consistent with the “fill-and-spill” mechanism, but their tempo differed fundamentally. The shallow-soil hillslope (SSP) exhibited higher CS (mean 0.39 vs. 0.35) and faster connectivity initiation (6.30 h) than the deep-soil hillslope (DSP, 7.45 h). Analysis of vertical lag times revealed a more pronounced expression of rapid-recharge preferential flow (negative lags) within the SSP, whereas the DSP maintained stronger matrix resistance and buffering capacity. Distinct, soil-thickness-dependent nonlinear rainfall thresholds for HC activation were identified (46.4 mm for SSP vs. 53.0 mm for DSP). Beyond these thresholds, CS on the DSP followed a predictable, rainfall-controlled linear trajectory; in contrast, the SSP exhibited heightened sensitivity to antecedent soil moisture, driven by the complex coupling between bedrock micro-topography and soil thickness variations. These findings suggest that hydrological models in karst regions should incorporate the high spatial variability of soil thickness, rather than relying on average values, to better predict hillslope-scale runoff generation.}
}
@article{HUANG2026135974,
title = {Incorporating variable source areas into rainfall-runoff pollutant export modeling for rural residential catchment},
journal = {Journal of Hydrology},
volume = {677},
pages = {135974},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135974},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010711},
author = {Xuan Huang and Xu Yang and Yuhang Zhang and Man Lang and Ping Li and Kebing Chen and Dongli She and Yongqiu Xia},
keywords = {Variable source area, Rural residential catchment, Pollutant export modeling, Dissolved nitrogen, Dissolved phosphorus, Hydrological connectivity},
abstract = {Rural non-point source pollution is primarily driven by rainfall runoff. The heterogeneous landscape of rural catchments, along with variable contributing source areas, result in complex pollutant export processes during rainfall events. Consequently, making accurate simulation of pollutant export during rainfall is both essential and challenging for effective water quality management. Existing Rainfall Runoff Model (RRM) assumes uniform contributing areas with exponential pollutant wash-off during rainfall, ignoring rural landscape complexity and dynamic expansion of contributing areas, leading to systematic errors during initial and peak rainfall periods. In this study, we propose a Modified Exponential Model (MEM) that integrates Variable Source Area (VSA) theory, using two parameters, α and β, which represent the maximum extent of VSA-contributing areas and their dynamic activation rates, respectively. The model was validated and applied to dissolved nitrogen (DN) and dissolved phosphorus (DP) modelling in rural residential catchments in the Yangtze River basin. We show that the MEM significantly outperformed RRM, particularly during medium and long-duration rainfall events (Regimes II and III), with Nash-Sutcliffe efficiency (NSE) coefficients increasing by 0.15–0.24 for DN and 0.31–0.42 for DP. We also observed distinct parameter characteristics between pollutants: DN exhibited higher contributing area values (α: 0.076–0.924) than DP (α: 0.022–0.299). SHAP analysis demonstrated that runoff characteristics primarily modulate DN transport, while precipitation features more strongly influence DP dynamics. These findings not only deepen our understanding of rural pollutant export processes but also deliver a practical, interpretable modeling framework for water quality management in rural areas.}
}
@article{ZHU2026135938,
title = {MvReNowcast: Disentangling radar product features for improved nowcasting of raincloud evolution},
journal = {Journal of Hydrology},
volume = {677},
pages = {135938},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135938},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010358},
author = {Hongxu Zhu and Ji Chen and Xunlai Chen and Waikin Wong and Chao Tan and Hongyi Yao and Xianqi Jiang},
keywords = {Nowcasting, Physics-informed learning, Advection–residual separation, Interpretability},
abstract = {Accurate radar echo extrapolation is fundamental for real-time monitoring and nowcasting severe rainfall events. However, most existing deep learning approaches tend to formulate this task in a simple manner, overlooking the physical mechanisms that govern radar echo evolution. This limitation restricts model interpretability and degrades nowcast reliability under dynamically evolving weather conditions. To this end, this study proposes a physics-informed deep learning framework that explicitly integrates prior hydrometeorological information into the radar echo extrapolation process. The evolution of radar reflectivity is decomposed into two distinct yet complementary components: advection and residual intensity evolution. By coupling both components within a unified neural architecture, the framework captures both large-scale displacement and small-scale intensity evolution of radar echoes. Numerical experiments conducted on multi-temporal radar datasets demonstrate that the proposed method outperforms the conventional data-driven benchmark model in both nowcasting accuracy and spatial consistency. The decomposition method not only reduces prediction errors but also enhances the physical interpretability of deep learning model outputs, allowing a more transparent attribution of echo evolution to dominant hydrometeorological processes. Quantitative verification confirms the MvReNowcast model’s systematic superiority over the Baseline. The performance gap widens significantly with time, reaching relative improvements exceeding 120.8 % on CSI30 and 52.9 % on CSI40 at the 120-minute forecast horizon. This study highlights the potential of physics-informed separation strategies in bridging the gap between data-driven and process-based modeling for rainfall nowcasting. The proposed approach provides a physically consistent and computationally efficient framework that can be extended to other hydrometeorological prediction tasks.}
}
@article{REN2026135990,
title = {Future climate and land-use change reshape watershed best management practices portfolio for nutrient control},
journal = {Journal of Hydrology},
volume = {677},
pages = {135990},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135990},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010875},
author = {Yuanxin Ren and Hangzhen Zhang and Shuo Cheng and Bingqian Liu and Lin Ji and Jun Xia and Dandong Cheng},
keywords = {Watershed scale, Hydrological-biogeochemical coupling, Nitrogen and phosphorus cycling, Climate and land-use change, Best management practices, SWAT},
abstract = {Understanding how hydrological and biogeochemical processes jointly regulate nutrient cycling in Earth’s Critical Zone is essential for adaptive watershed management under climate and land-use change. Here, Coupled Model Intercomparison Project Phase 6 Shared Socioeconomic Pathways (CMIP6-SSPs) climate and land-use scenarios were coupled with the Soil and Water Assessment Tool (SWAT) to quantify future nitrogen (N) and phosphorus (P) losses in the Jialing River Basin, a major tributary of the upper Yangtze River. A fixing-changing scenario framework was used to separate the effects of climate change, land-use/land-cover change (LUCC) and their interaction, while an entropy-weighted assessment screened fertilizer reduction, no tillage, vegetative filter strips, grassed waterways and reforestation under nutrient-reduction, cost and yield-loss constraints. By 2055, all SSPs projected warmer and wetter conditions and a shift toward higher forest cover. These coupled changes produced divergent nutrient responses: N losses decreased by 1.90–3.50 × 106 kg yr−1, whereas P losses increased by 2.00–2.77 × 105 kg yr−1. LUCC dominated N-loss reduction under SSP3-7.0 and SSP5-8.5, contributing 60.28% and 58.48%, respectively, whereas climate change dominated P-loss increase across SSPs, contributing 44.21–69.15%. These results indicate that forest expansion enhanced N retention but did not fully offset runoff- and erosion-driven P mobilization. Historically, the preferred best management practice (BMP) portfolio required 80% fertilizer reduction and wider vegetative filter strips. Under future SSPs, however, all scenarios favored a less intensive 70% fertilizer-reduction portfolio with narrower filter strips, reducing TN by 67.211–71.356% and TP by 53.796–61.376% while lowering yield and cost pressure. Overall, BMP portfolios selected under historical conditions may become over-intensive or poorly targeted under future climate-LUCC settings. Adaptive nutrient management should therefore evaluate nutrient-specific drivers, implementation costs and yield-loss constraints simultaneously.}
}
@article{SHI2026135950,
title = {A review of machine learning applications in inland and nearshore water color remote sensing: from preprocessing to object detection and parameter estimation},
journal = {Journal of Hydrology},
volume = {677},
pages = {135950},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135950},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010474},
author = {Jiarui Shi and Zuchuan Li and Ge Liu and Chong Fang and Zhidan Wen and Yingxin Shang and Hui Tao and Sijia Li and Qiang Wang and Zijin Wang and Kaishan Song},
keywords = {Machine learning, Satellite remote sensing, Inland water, Nearshore water, Object detection, Water quality},
abstract = {A combination of Machine Learning (ML) techniques with satellite remote sensing has brought target objects and water-quality research into a new era. These emerging techniques and unprecedented opportunities have improved the accuracy of satellite data products, facilitated knowledge discovery, expanded the spatial domain of target objects and water-quality research to the globe, and extended the social, economic, and scientific impacts of water-quality research. This review provides the first systematic integration of machine learning (ML) across the full-chain workflow for inland and nearshore watercolor remote sensing, we examine recent progress in the application of ML across the full remote sensing workflow for inland and nearshore water color studies—from image preprocessing (including atmospheric correction, water body extraction, spectral simulation, spatiotemporal fusion and water extent extraction) to object detection and water quality parameter estimation. We also present a curated selection of valuable open-source resources and highlight key challenges—including data scarcity and label bias, limited model interpretability, insufficient uncertainty quantification, and the difficulties of multimodal data integration, long-term, large-scale, and multi-scale analysis, as well as the need for effective spatial relationship modeling—and discuss emerging trends such as multi-temporal data integration, and the incorporation of physical constraints. By providing a comprehensive overview of ML applications in this field, this review serves as a valuable reference for researchers and practitioners seeking to enhance water quality monitoring and assessment. The insights presented here are expected to foster the development of more accurate, scalable, and interpretable ML models, ultimately contributing to improved environmental management and decision-making.}
}
@article{YU2026136002,
title = {Effect of soil hysteresis on liquid-vapor-air flow in seasonally frozen soils},
journal = {Journal of Hydrology},
volume = {677},
pages = {136002},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136002},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010991},
author = {Lianyu Yu and Huanjie Cai and Delan Zhu and Fubin Sun and Xiangxiang Ji and La Zhuo},
keywords = {Soil hysteresis, Liquid–vapor-air flow, Evaporation, Hydrothermal regimes, Seasonally frozen ground},
abstract = {Mass transfer in seasonally frozen ground is crucial for the frozen soil hydrology and ecohydrology processes and adaptive management. The increasingly frequent soil hysteresis phenomenon (SHP) makes it more complex. However, the influencing mechanism of soil hysteresis on the coupled liquid–vapor-air flow in the seasonally frozen soils is not yet fully understood. In this study, the STEMMUS-FT model (Simultaneous Transfer of Energy, Mass and Momentum in Unsaturated Soil with Freeze and Thaw) with the hysteresis effect was developed and verified against the field measurements of soil water content and temperature in a typical dry plateau. The dynamics of soil hydrothermal regimes were well simulated, with the values of RMSE lower than 0.95 °C and 0.02 m3 m−3 for the soil temperature and moisture simulations, respectively. Constrained by the prescribed boundary conditions, the hysteresis effect on the simulated temperature is negligible. There is a depth-dependent effect on the soil water content. Soil evaporation was overestimated during the unfrozen period when neglecting the hysteresis effect. The isothermal liquid flux, driven by the soil matric potential gradient, is the main reason for such overestimation. During the freezing period, soil ice was advanced with a higher value by considering the hysteresis effect. The effect of blocking and cryosuction on the mass transfer due to the presence of soil ice appeared to be enhanced. For the advective fluxes, the magnitude was dampened by the hysteresis except after precipitation during the freezing period. This study clarifies the influencing mechanisms of hysteresis on the liquid–vapor-air flow in the seasonally frozen soils and provides more insights for better portraying the frozen soil hydrological processes.}
}
@article{DISTEFANO2026136023,
title = {Establishing the payment for the ecosystem service of soil erosion control},
journal = {Journal of Hydrology},
volume = {677},
pages = {136023},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136023},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011200},
author = {Costanza {Di Stefano} and Alessio Nicosia and Vincenzo Palmeri and Vincenzo Pampalone and Maria Angela Serio and Vito Ferro},
keywords = {Soil erosion, Rainfall erosivity factor, USLE, Best management practices, Ecosystem services},
abstract = {Soil conservation strategies based on the mean annual value of the rainfall erosivity factor could not guarantee appropriate erosion control for intense rainfall events. In this paper, a new method to define soil loss tolerance at a regional scale, using the crop and management factor of the USLE, C, was applied for estimating the payment for ecosystem service (PES) of soil erosion control. PES is characterized by a target value PEStg corresponding to a post-intervention condition in which soil loss is equal to the tolerance value. The PES was estimated by three different scenarios: (1) only reducing the current C factor, or combining its reduction with that of the (2) support practice factor P or (3) slope length factor L. For Scenario 1, the analysis demonstrated that a drastic reduction of the C factor determines PES/PEStg ≥1 regardless of the investigated climatic conditions. For Scenario 2, when C and P factors are equally weighted, the payment is higher than the target value for slope-steepness ≤15%. Scenario 2 always yields a higher payment compared to Scenario 1. For Scenario 3, the reduction of the topographic factor can lead the PES over the target value. Although PES is generally considered effective for environmental policy, it should be allocated by targeting erosion-prone areas, where soil conservation is a primary objective. These areas experience soil loss greater than tolerable value, which usually lacks a solid scientific basis. By contrast, the proposed method, developed for the Sicilian region, is grounded in a scientific framework and is useful to support policymakers and public authorities in the informed design of economic incentives for farmers who convert their activities in order to preserve soil resources.}
}
@article{MIN2026135958,
title = {Tailoring soil moisture data to diverse accuracy needs: a multi-objective optimization and point-surface fusion framework},
journal = {Journal of Hydrology},
volume = {677},
pages = {135958},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135958},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010553},
author = {Xiaoxiao Min and Si-Bo Duan and Songchao Chen and Yulin Shangguan and Zhou Shi},
keywords = {Soil moisture, microwave remote sensing, Land surface model, point-surface data fusion, Multi-objective optimization, Bayesian model averaging},
abstract = {Soil moisture (SM) data from various microwave remote sensing satellites and land surface models exhibit distinct accuracy characteristics across diverse landscapes and climates. Data fusion based on Linear Weighted Averaging (LWA) offers opportunities to achieve globally improved SM estimates. Different practical applications require specific accuracy metrics to define SM measurement requirements, and no single metric can encompass all attributes of SM. However, currently popular fusion techniques under LWA scheme, such as Triple Collocation Analysis (TCA) and Three-Cornered Hat (TCH), typically focus on enhancing only a single accuracy objective (e.g., maximizing temporal correlation or minimizing random errors) and impose strict requirements on the error covariances and the number of input datasets. Point-surface (P-S) fusion has gained increasing attention for its potential to overcome the inherent limitations of satellite retrievals or model simulations. This study proposes a novel Multi-objective (MO) P-S fusion framework that leverages Bayesian Model Averaging (BMA) to relax these stringent constraints while simultaneously incorporating ground measurements to calibrate coarse-scale SM estimates. Crucially, it considers multiple different but complementary accuracy metrics as optimization objectives, enabling application-oriented customization of SM products. Specifically, we combined four satellite products from the Soil Moisture Active Passive (SMAP), the Soil Moisture Ocean Salinity (SMOS), the Advanced Microwave Scanning Radiometer 2 (AMSR2), and the Advanced Scatterometer (ASCAT) sensors/missions, and three model products from the Global Land Data Assimilation System (GLDAS) Noah model, the Modern-Era Retrospective Analysis for Research and Applications Land version 2 reanalysis (MERRA2), and the European Centre for Medium-Range Weather Forecasts Reanalysis 5 (ERA5)-Land, calibrated using in-situ observations from the International Soil Moisture Network. Compared to traditional single-objective maximum likelihood (ML) estimator, this work concurrently optimized four objectives widely relevant to practical applications: unbiased Root Mean Squared Error (ubRMSE), Pearson correlation (R), Negative Log-Likelihood (NLL), and Continuous Ranked Probability Score (CRPS), through the Multi-ALgorithm Genetically Adaptive Multi-objective (AGLGAM) algorithm. In-situ validations demonstrated that the fusion products generated by MO optimization achieved statistically significant improvements in both deterministic and probabilistic accuracy, providing optimal SM information both overall and across distinct land covers and climates. Compared with the best-performing parent product, the fusion product achieved maximum overall improvements of 0.035 in R, 0.0046 cm3/cm3 in ubRMSE, 0.187 in NLL, and 0.004 cm3/cm3 in CRPS. Furthermore, they significantly outperformed the ML-optimized fusion product, as well as those based on other model averaging techniques (Bates–Granger Averaging (BGA) and Granger Ramanathan Averaging (GRA)) and collocation-based fusion techniques (TCA and TCH). This study is the first to introduce an application-oriented SM fusion framework. By generating Pareto-optimal weight solutions spanning the entire trade-off surface among diverse accuracy metrics, this framework produces high-quality SM fusion products optimized for specific metrics as well as those balanced across multiple metrics, fully addressing the diverse accuracy requirements of various practical applications.}
}
@article{CAI2026136019,
title = {Delayed and asymmetric groundwater responses to meteorological forcing across Germany revealed by lagged mutual information},
journal = {Journal of Hydrology},
volume = {677},
pages = {136019},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136019},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011169},
author = {Fangfei Cai and Funing Ma and Zhenxue Dai and Junjun Chen},
keywords = {Mutual information, Groundwater response lag, State asymmetry, Effective recharge proxy threshold, Hydrogeological heterogeneity},
abstract = {Delayed groundwater responses to meteorological forcing complicate drought recovery assessment, seasonal forecasting, and groundwater-resource management. Yet controls on recharge-groundwater response lags and their dependence on wet versus dry antecedent states remain poorly resolved at national scales. Using 32 years of weekly records from 3207 monitoring wells across Germany, we apply a model-free information-theoretic framework to quantify seasonal lagged dependence between an effective recharge proxy and groundwater levels. We compute maximum mutual information, optimal recharge-groundwater lags, optimal effective recharge proxy thresholds, and the dry versus wet antecedent-state asymmetry ratio. Statistically significant lagged dependence was detected in 12,812 season-well combinations under surrogate testing. Median lags ranged from 6 weeks in spring to 11 weeks in autumn and winter. Optimal recharge-groundwater lags were strongly associated with vertical stratification and aquifer architecture, increasing from 7 weeks in shallow systems (<15 m) to 24 weeks in deep aquifers (>100 m), and from 5 weeks in karstic and fractured systems to 13 weeks in porous-and-fractured aquifers. Median state-dependent asymmetry did not differ significantly among aquifer media, while extreme dry-state dominance was spatially concentrated in fractured and karstic systems. Wet-state information dominated nationally with a median ratio of 0.565, whereas dry-state dominance became prominent in winter with a median ratio of 1.015. About 4% of records in summer and autumn were driven exclusively by drought precursors. These results identify hydrogeological controls on delayed groundwater responses and aquifer architectures vulnerable to moisture deficits, supporting seasonal forecasting and adaptive groundwater management.}
}
@article{HAN2026135985,
title = {Causal structure and threshold characteristics of vapor pressure deficit regulation across different climate zones in China},
journal = {Journal of Hydrology},
volume = {677},
pages = {135985},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135985},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010826},
author = {Yang Han and Zhi-Gang Yan and Peng Zhou and Jia-Hui Qin and Chuan-Ye Hu and Yun-Cheng Jiang and Qing-Zhou Lv},
keywords = {Vapor pressure deficit, China, Climate zones, Causal identification, Information decomposition, Threshold response},
abstract = {Vapor Pressure Deficit (VPD) is a key indicator of atmospheric aridity and land–atmosphere interaction risk, yet its dominant processes, information structure, and threshold responses across China’s climate zones remain poorly understood. Using VPD and related meteorological and hydrological variables during 1980–2022, this study grouped the drivers into Circulation Background (CB), Non-local Moisture Transport (NMT), and Local Response and Feedback (LRF), and integrated directional causality detection, information decomposition, and threshold analysis to reveal the dominant mechanisms and nonlinear responses of VPD in China. Mean VPD was 0.54 kPa, with high values in the northwestern inland and low values over the Qinghai–Tibet Plateau and the northeastern semi-humid region. VPD was highest in Mt-A (0.98 kPa) and lowest in Pt-Sa (0.25 kPa). The dominant controls showed clear zonal differentiation, with humid and semi-humid regions mainly controlled by CB, Mg-H by NMT, and arid and plateau regions by LRF; precipitation exerted the strongest causal effect in both Mt-A and Pt-Sa, with peak ρ values of 0.918 and 0.695. Information decomposition showed that CB and NMT were dominated by synergistic information (88.52% and 79.27% of pixels, respectively), whereas LRF showed a lower proportion of synergistic dominance (64.25%) but higher unique and redundant contributions (0.236 and 0.148). A total of 21 robust threshold relationships were identified, with more consistent response directions for local hydrological factors and stronger regional divergence for CB- and NMT-related variables. Overall, VPD in China is regulated by climate-zone-dependent control pathways rather than a single uniform mechanism, and the identified causal pathways and threshold responses provide a process-based basis for assessing regional atmospheric drying risk, diagnosing water-limitation transitions, and developing climate-zone-specific adaptation strategies.}
}
@article{ZHU2026135993,
title = {Toward understanding tidal flat regime shifts: Contrasting hydro-sediment dynamics revealed by paired observations of two tidal flats},
journal = {Journal of Hydrology},
volume = {677},
pages = {135993},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135993},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010905},
author = {Shibing Zhu and Ya Ping Wang and Yuan Li and Qingguang Zhu and Fei Xing and Mingliang Li and Chao Gao and Shucun Sun},
keywords = {Tidal flats, Regime shifts, Hydro-sediment dynamics, Jiangsu coast, Wave-current interactions, Coastal reclamation},
abstract = {Global muddy tidal flats are increasingly at risk of shifting from accretion-dominated to erosion-dominated states under the combined pressures of climate change and intensified human activities. Understanding the process basis of tidal flat regime shifts hinges on clarifying the fundamental differences in coupled hydrodynamics, sediment transport, and morphological processes that sustain erosional versus accretional states and their diagnostic implications. However, process-based studies that directly compare these contrasting states through paired observations within the same tidal flat system remain limited. Here, we conducted coordinated, high-frequency measurements of hydro-sediment processes at two morphologically contrasting sites—one eroding and one accreting—within the Jiangsu coast, China, which is experiencing a system-wide regime shift and exhibits strong spatial heterogeneity, with coexisting erosional and accretional sectors. Results show that the eroding flat experiences stronger wave forcing and higher bed shear stresses, which drive persistent seaward sediment export and ongoing bed erosion. In contrast, the wide and gently sloping morphology of the accreting flat enhances wave energy dissipation, promotes tidal current development, and generates early-flood velocity pulses that trigger SSC surges, creating critical sedimentation windows that sustain long-term accretion. Notably, SSC was higher at the eroding tidal flat than at the accreting site, underscoring that tidal flat regime shifts are not governed by sediment availability alone but rather emerge from complex interactions among morphology, hydrodynamics, and sediment transport processes. These findings advance process-based understanding of tidal flat evolution and provide mechanistic insights to support the management of coastal erosion risks under multiple stressors.}
}
@article{JI2026135953,
title = {Focused recharge in engineered landscapes: Contrasting pore and fissure groundwater responses to check dams on the Loess Plateau},
journal = {Journal of Hydrology},
volume = {677},
pages = {135953},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135953},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010504},
author = {Zhenxia Ji and Alan D. Ziegler and Li Wang},
keywords = {Stable isotopes, Groundwater recharge, Hydrological pathway reconstruction, Hilly-gully region},
abstract = {Check dams are widely used across the Loess Plateau to control erosion and retain water, yet their effects on groundwater recharge remain poorly quantified. Using stable isotopes, residence-time analysis, and mixing models, we investigated groundwater recharge pathways in a check-dam catchment. Check-dam construction created two new recharge reservoirs—pond water and perched groundwater. These engineered water bodies became dominant recharge intermediaries for both pore and fissure groundwater. Together, they contributed approximately 81% of pore-groundwater recharge and about 50% of fissure-groundwater recharge. Mean residence times increased from pore groundwater (307 days) to fissure groundwater (591 days), indicating slower renewal and greater hydrological buffering in the fractured system. Seasonal isotope analyses further showed that pore groundwater receives substantial dry-season recharge, consistent with delayed infiltration from stored water behind check dams. Fissure groundwater is recharged primarily during the rainy season. These results demonstrate that check dams establish a dominant focused recharge pathway mediated by engineered surface-water storage. Meanwhile, diffuse precipitation recharge remains an important wetting component of the groundwater recharge system. The findings highlight an important but often overlooked role of check dams in groundwater regulation and hydrological-cycle modification in semi-arid landscapes.}
}
@article{ZHAO2026135969,
title = {Dynamic changes of vegetation in China under the stress of compound droughts},
journal = {Journal of Hydrology},
volume = {677},
pages = {135969},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135969},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010668},
author = {Anzhou Zhao and Wei Zhang and Xianfeng Liu and Lidong Zou and Shuaiqin Chen},
keywords = {Compound droughts, NDVI, SCDI, Vegetation dynamics, Multi-scenario},
abstract = {Compound droughts characterized by the concurrent high vapor pressure deficit (VPD) and low soil moisture (SM) can intensify plant water stress and threaten ecosystem stability. However, their influence on vegetation has not been systematically quantified due to the absence of a unified metric. In this study, we developed a novel Standardized Compound Drought Index (SCDI) by integrating VPD and SM to capture the spatiotemporal evolution of compound droughts. We then investigated the dynamics of vegetation and its response to these compound droughts. The main findings are as follows: (1) From 1982 to 2020, the Normalized Difference Vegetation Index (NDVI) in China showed a significant upward trend (9.10 × 10−4 yr−1, p < 0.01), with the most pronounced increase observed in the Yellow River Basin (2.19 × 10−3 yr−1, p < 0.01). During the same period, the SCDI also exhibited a significant increasing trend (7.73 × 10−3 yr−1, p < 0.01), with the strongest increase found in the Continental River Basin (CRB) (2.77 × 10−2 yr−1, p < 0.01). Spatially, both NDVI and SCDI exhibited significant decreasing trends (p < 0.05) in northeastern and southwestern China; (2) Random forest modeling revealed that atmospheric CO2 concentration and the SCDI contributed 31.02% and 30.30% to the variability in vegetation dynamics, respectively. Although the CO2 fertilization effect partially mitigated the adverse impacts of compound droughts on vegetation growth. It was insufficient to fully offset the vegetation losses caused by these droughts in certain regions. Central and southwestern China demonstrated higher sensitivity to compound droughts, while southeastern China appeared more resilient. The SCDI thresholds corresponding to NDVI values below the 40th, 30th, 20th, and 10th percentiles were −1.30, −1.80, −2.11, and −2.30, respectively; (3) Under future climate scenarios (SSP1-2.6 to SSP5-8.5), the continued rise in atmospheric CO2 concentrations is expected to counterbalance the potential NDVI decline caused by compound droughts, maintaining an overall upward trend in vegetation greenness. This trend is expected to be more pronounced in inland western and northern China. Despite the anticipated intensification of soil-atmosphere compound droughts, the growing CO2 fertilization effect may play an increasingly important role in sustaining vegetation growth. Overall, this study advances the understanding of vegetation responses to compound droughts and provides a scientific basis for ecological restoration and regional climate adaptation strategies.}
}
@article{BAKAR2026135956,
title = {Deep learning approaches for streamflow flash drought prediction across the contiguous United States},
journal = {Journal of Hydrology},
volume = {677},
pages = {135956},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135956},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601053X},
author = {Sophia Bakar and Hoang Hai Nguyen and Hyunglok Kim and Venkataraman Laskhmi},
keywords = {Streamflow flash drought, Deep learning, Long short-term memory, Temporal fusion transformer, Hydrologic extremes},
abstract = {Reliable drought prediction is crucial for early warning and decision-making regarding drought-related disasters. Flash droughts, characterized by their rapid onset and severe impacts, are challenging to predict and present critical challenges to water resource management. Specifically, streamflow flash droughts (SFDs) are significant as they directly influence water supply for irrigation, industry, and domestic use. Traditional hydrologic models and drought early warning systems are primarily designed to capture slowly evolving drought conditions and often fail to represent rapid transitions in streamflow that characterize the onset of SFDs. Despite increasing attention to the identification and characterization of SFDs, their prediction remains unexplored. This study evaluates the ability of different deep learning architectures, especially the Temporal Fusion Transformer (TFT), in comparison to the widespread baseline Long Short-Term Memory (LSTM) model and a two-source LSTM incorporating static catchment attributes, to predict SFDs based on streamflow percentiles. The model training and performance evaluation were conducted using hydroclimatic datasets from 671 Catchment Attributes and Meteorology for Large-sample Studies (CAMELS) catchments in the contiguous United States. Performance was evaluated using standard accuracy and event detection metrics. Results show that the TFT achieved the highest overall performance, with a median KGE of 0.87, RMSE of 0.13, MAE of 0.10, and a correlation coefficient of 0.91, outperforming the LSTM with static features (median KGE = 0.81) and the baseline LSTM (KGE = 0.78). In terms of detecting SFDs, the TFT showed the highest median detection rate and lowest miss rate across all models. These improvements were consistent across most catchments and hydroclimatic regions, indicating robust performance gains relative to LSTM-based approaches, although some regions with complex hydrologic behavior remained challenging for all models. While model performance varied across hydroclimatic regions, particularly in data-sparse or hydrologically complex areas, the integration of static attributes and attention-based mechanisms consistently improved predictive skill. These findings demonstrate that Transformer-based models can improve prediction of rapid streamflow changes associated with the onset of SFDs; however, the results are based on deterministic predictions and do not explicitly quantify predictive uncertainty. These findings contribute new insights into the spatial patterns and physical drivers of model performance under non-stationary climate conditions.}
}
@article{BAGARELLO2026135977,
title = {Determining and predicting single-storm erosion index in Sicily},
journal = {Journal of Hydrology},
volume = {677},
pages = {135977},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135977},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010747},
author = {V. Bagarello and V. Ferro and F. Gakunde and V. Pampalone},
keywords = {Climatic change, Envelope curves, Rainfall depth, Rainfall erosivity, Rainfall measurement interval},
abstract = {The single-storm erosion index, Re, expressing the rainfall erosive power, can be either calculated or estimated and it can be used for a variety of analyses, including the probabilistic assessment of soil water erosion phenomena. Calculation of Re according to the original procedure requires rainfall depth, he, and intensity data at short time intervals but their temporal resolution can change with the considered recording rain-gauge station. Estimating Re is sometimes necessary since rainfall intensity data could be unavailable in certain circumstances. An appropriate probability distribution law of the annual maximum values of Re has to be chosen for predicting single-storm erosivity values with a given return period. With reference to 8464 erosive rainfall events collected at 26 Sicilian stations in the 2002–2024 years, this investigation showed that: i) Re calculated by rainfall data measured at Δt = 30 min time intervals constituted the 88% of the corresponding calculations obtained by rainfall data collected at Δt = 10 min and time effects were particularly appreciable for relatively small rainfall depths (he ≤ 40 mm); ii) the power law relationship between Re and he parameterized by minimizing the sum of the squared residuals between the actual and the estimated Re values (optimization approach, OPT) yielded less biased Re predictions than the relationship parameterized by a linear regression analysis of the natural logarithm (ln-) transformed data; iii) power law relationships obtained in two different historical periods (1951–1970 and 2002–2024) yielded different Re predictions, likely as a consequence of climate change; iv) an envelope line of the Re vs. he data was usable to simply distinguish, for a given rainfall depth, expected from unexpected, Re values; and v) the annual maximum values of Re were distributed according to the Extreme Value Type-1 (EV1) distribution. In conclusion, rainfall temporal resolution effects on Re calculation can be expected to decrease as he increases. The OPT approach should be applied for parameterizing the Re predicting relationship. Using Re vs. he relationships developed in the past for estimating current erosivity is not recommended. The highest expected Re value for a given rainfall depth and the quantile, ReT, corresponding to a given return period, T, can easily be estimated and they should be taken into account for planning appropriate soil conservation measures given that total soil erosion in a long period is mostly due to a few particularly high erosive events.}
}
@article{YU2026136030,
title = {A coupled moisture-solute-heat transfer model for saline frozen soil considering non-equilibrium phase change kinetics},
journal = {Journal of Hydrology},
volume = {677},
pages = {136030},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136030},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011273},
author = {Ceting Yu and Hui Cheng and Shilin Zhang and Zhaohui Peng and Longxuan Li and Fugang Wang},
keywords = {Saline frozen soil, Non-equilibrium phase change kinetics, Coupled moisture-solute-heat transfer, Unfrozen water content, Freezing hysteresis, Cold-region engineering},
abstract = {Saline frozen soils are extensively encountered in cold-region engineering and Artificial Ground Freezing (AGF) applications, posing substantial challenges to the stability and safety of geotechnical infrastructure. Under the influence of rapid cooling and environmental fluctuations, the ice-water phase change in saline soils often remains in a state of dynamic non-equilibrium. However, existing coupled moisture-solute-heat transfer models for saline frozen soils predominantly rely on the local thermodynamic equilibrium assumption, which posits that unfrozen water content is an instantaneous function of temperature and salinity. This assumption neglects the kinetic resistance during the phase transition, rendering the models incapable of describing the hysteresis characteristics of unfrozen water under sharp temperature gradients, which subsequently leads to biased predictions of freezing curtain development in engineering designs. To address this limitation, this study develops a transfer model for saline frozen soil that incorporates non-equilibrium phase change kinetics. By introducing a phase-change relaxation time function to characterize the delayed kinetic response and employing an iterative algorithm to couple the feedback of solute concentration on the freezing point, the model represents the relaxation controlled non-equilibrium phase change process and the feedback of solute enrichment on freezing point depression. The model was evaluated using analytical solutions, equilibrium saline soil tests, and non-equilibrium kinetic benchmark data. Findings indicate that initial salinity significantly inhibits kinetic hysteresis, with a “buffering effect” reducing deviations by 44%-60%, while the uniformity of soil pore size distribution determines the intensity of kinetic surges. Under cyclic fluctuations, the model captures the kinetic hysteresis loop of unfrozen water content caused by finite phase change relaxation. Finally, numerical simulations of single-pipe freezing reveal that traditional equilibrium models overestimate the effective ice wall thickness by approximately 10%. This research elucidates the phase-change mechanisms under the coupled effects of rapid cooling and high salinity, providing a more conservative theoretical basis for freezing projects in saline formations.}
}
@article{DONG2026136006,
title = {A revisit of slug injection in a finite-domain porous media: theory, experimental validation, and multi-parameter estimation},
journal = {Journal of Hydrology},
volume = {677},
pages = {136006},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136006},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011030},
author = {Xiaosong Dong and Yanrong Zhao and Yong Huang and Jinguo Wang and Haonan Wang and Kehan Miao and Jie Zhang and Yuxing Zhang},
keywords = {Finite domain, Advection-dispersion equation, Semi-analytical solution, Numerical solution, Multi-parameter estimation},
abstract = {Accurate prediction of solute transport in porous media is essential for groundwater remediation, and reliable parameter estimation is fundamental to tracer test interpretation. Classical infinite-domain advection–dispersion models are analytically convenient, but their idealized boundary conditions may be inadequate for finite domains. This study reformulates slug injection as a finite-reservoir boundary process rather than an idealized point source, linking inlet solute depletion, outlet constraint, and multi-parameter estimation within a finite-domain framework. This formulation avoids the near-source singularity inherent in the Dirac delta representation used in classical solutions. A Laplace-domain semi-analytical solution is derived and verified against numerical solution and the Sauty (1980) solution. Parametric analysis shows that the Péclet number governs advection–dispersion dominance, while the structural coefficient modulates peak concentrations. Sand-column experiments confirm that the finite-domain solution reproduces measured breakthrough curves more consistently than the Sauty solution. The framework enables simultaneous estimation of six parameters: hydraulic conductivity K, porosity n, pore velocity u, longitudinal dispersion coefficient DL, molecular diffusion coefficient Dm, and longitudinal dispersivity αL. Estimated K and n are 1.67×10-3 m/s and 0.412, matching independent measurements; αL=2.25×10-3 m and Dm=4.65×10-8 m2/s, with the DL–u regression yielding R2=0.989. These results demonstrate that explicitly accounting for finite-domain boundaries improves slug-injection interpretation and supports physically consistent multi-parameter identification.}
}
@article{QIAN2026135941,
title = {Separating typhoon and non-typhoon rainfall reveals structural hydrological regime shifts in coastal-to-inland basins},
journal = {Journal of Hydrology},
volume = {677},
pages = {135941},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135941},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010383},
author = {Xiaojuan Qian and Sangyoung Son},
keywords = {Long-term trend, Hydrological change, Budyko framework, Typhoon rainfall, Regime shift detection, Coastal-to-inland hydrology},
abstract = {Long-term hydrological change in typhoon-prone coastal-to-inland river basins presents growing challenges for flood risk assessment under a changing climate. Here, we develop a generalizable basin-scale diagnostic framework that separates typhoon and non-typhoon rainfall, embeds them in a Budyko-based runoff analysis, and quantifies spatially heterogeneous hydrological sensitivities applicable to coastal-to-inland systems worldwide. As a proof-of-concept demonstration, we apply this framework to the Qiantang River Basin (QRB), eastern China, a representative typhoon-prone coastal-to-inland basin influenced by the East Asian summer monsoon and Western North Pacific tropical cyclones. Using data from 11 stations during 1980–2020, the framework detects a precipitation-regime shift around 2009, after which annual rainfall increased by roughly 13–15% across subbasins and Budyko-estimated runoff potential also increased. The disproportionate runoff-potential increase in the coastal-adjacent Fuchun subbasin suggests possible amplification by land-surface modification and urbanization. Typhoon‑related precipitation, though only about 6% of annual totals, increased by nearly 50% after 2009 and showed a disproportionate contribution to extreme rainfall, reaching 28% of extreme volumes in the coastal‑adjacent subbasin, while inland extremes remained dominated by non‑typhoon processes. These results demonstrate that long-term hydrological changes in typhoon-prone coastal-to-inland basins can manifest as structural regime shifts in both precipitation composition and runoff generation. More broadly, the explicit separation of typhoon and non-typhoon rainfall within a Budyko framework provides a physically grounded and transferable diagnostic tool readily applicable to other typhoon-prone basins globally, supporting flood-risk and water-resources management under ongoing climate change.}
}
@article{GEORGAKAKOS2026135965,
title = {Assessing streamflow depletion from agricultural groundwater use in headwater catchments using storage-discharge functions},
journal = {Journal of Hydrology},
volume = {677},
pages = {135965},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135965},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010620},
author = {Philip Georgakakos and David Dralle and Chris Dillis and Jesse Hahm and Dana Lapides and Theodore Grantham},
keywords = {Subsurface, Cannabis, Streamflow depletion, Groundwater pumping},
abstract = {Groundwater extraction can deplete streamflow in headwater catchments, but the complexity of subsurface hydrological processes make impacts difficult to detect. Using hydrograph-inferred hillslope groundwater storage and streamflow relationships, we propose a novel approach to estimate streamflow depletion from groundwater pumping that is well-suited to areas with limited groundwater monitoring infrastructure. We apply this method in two well-studied watersheds in California’s North Coast to quantify potential hydrologic impacts of cannabis agriculture, which is concentrated in the region and has been identified as a potential threat to salmon-bearing streams. We use a scenario-based approach to explore the relative effects of cannabis cultivation area, irrigation water source (groundwater pumping vs. surface diversion), irrigation efficiency, stream discharge at the onset of the growing season, and lithology on streamflow depletion risk. Our models show that Elder Creek, a perennial stream, could be de-watered by the late dry season with high levels (1% land cover) of cannabis irrigation from groundwater when dry season discharge is low at the start of the season (1 mm/day). In Dry Creek, a non-perennial stream, dry season flow cessation could be advanced by five weeks from similar levels of cannabis water demands. Streamflow impacts are more pronounced in drier years, and the impacts from well-water extraction exhibit a muted effect relative to surface water diversion of the same volume. Storage-discharge functions like those in our case study can estimate how groundwater extraction affects headwater streams wherever streamflow data exist.}
}
@article{HE2026136026,
title = {Evolution and mechanisms of tidal duration asymmetry in the Xijiang River Channel of the Pearl River Estuary},
journal = {Journal of Hydrology},
volume = {677},
pages = {136026},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136026},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011236},
author = {Xianzhao He and Shuai Hu and Xiangyuan Li and Haichen Liu and Min Gao and Jianliang Lin and Xiaohe Zhang and Lixia Niu and Qingshu Yang},
keywords = {Tidal asymmetry, NS_TIDE, Tidal skewness, Delft3D-FM},
abstract = {Tidal Duration Asymmetry (TDA), defined as the inequality between flood- and ebb-tide durations, affects water resource security and material transport. This study investigates the evolution and underlying mechanisms of TDA in the Xijiang River Channel of the Pearl River Estuary using observed water levels (1966–2016) and Delft3D-FM hydrodynamic modeling. TDA shows spring-neap variations, seasonal fluctuations, and stepwise alterations. For the spring-neap variations, an increase in tidal range shifts downstream TDA toward ebb dominance (shorter ebb duration), while the effect upstream is minor. Seasonal variations in TDA are closely linked to river discharge and exhibit clear threshold behavior. When discharge remains below a critical range (1.1 × 104 –1.6 × 104 m3/s), increasing discharge enhances flood dominance (shorter flood duration), whereas discharge exceeding this range promotes ebb dominance. Stepwise alterations in TDA toward ebb dominance have occurred in the Xijiang River Channel, which are associated with increases in M2 amplitudes induced by extensive shoreline reclamation. These results highlight the vital role of river-tide interaction and topographic changes in reshaping estuarine tidal asymmetry, providing theoretical insights for adaptive water resource management and estuarine engineering, particularly for saltwater intrusion control and sediment management.}
}
@article{ABBASIZADEH2026135945,
title = {How does temperature causally influence short-term streamflow response? Evidence from 1604 catchments across the UK, Central Europe, and Australia},
journal = {Journal of Hydrology},
volume = {677},
pages = {135945},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135945},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010425},
author = {Hossein Abbasizadeh and Petr Maca and Urmi Ninad and Martin Hanel},
keywords = {Streamflow-temperature interaction, Runoff response, Causal discovery, PCMCIplus, Causal effect estimation, Optimal adjustment method},
abstract = {Temperature is a key climatic driver of streamflow through its interactions with precipitation and hydrological processes. While its influence on streamflow has mainly been studied in terms of long-term mean changes, effects on precipitation, or extreme events, its short-term causal effects across long historical records remain poorly understood. Here, we investigate the immediate (within a few days) causal effect of temperature on streamflow across 1604 catchments spanning diverse hydroclimatic regions. We analyze 30 years (1985–2015) of daily temperature, precipitation, and streamflow data using the PCMCIplus causal discovery algorithm, applied to large catchment samples from Central Europe, the United Kingdom, and Australia. To quantify the nonlinear causal effect of temperature on streamflow, we use the optimal adjustment set method. This approach identifies 25 types of streamflow responses to temperature (Q∼T), which are grouped into 8 main categories. Results show similar Q∼T response patterns can occur across different Köppen–Geiger climate regions, even when driven by different processes. Also, substantial spatial heterogeneity is observed within individual climate regions, highlighting the complex causal interactions among temperature, precipitation, and streamflow at the catchment scale. Soil conductivity, snow fraction, and topographic characteristics are dominant controls on Q∼T variability. Catchments with high elevations and large snow fractions, primarily in Central Europe, frequently exhibit positive streamflow responses to warming, reflecting strong controls from snowmelt and storage. The influence of temperature on streamflow also varies across short timescales. Streamflow reductions associated with higher temperatures (Tmax−) become more pronounced above freezing at lag 0, suggesting stronger controls from evapotranspiration and atmospheric water demand, whereas at longer lags freezing-related processes dominate. In contrast, positive streamflow responses to warming (Tmax+) tend to occur at longer lags, potentially reflecting delayed snowmelt and catchment storage release processes. However, these lag-dependent behaviors vary substantially across hydroclimatic regions and catchment conditions. Tropical catchments show the most stable effective temperatures across lags, while arid, cold, and temperate catchments exhibit greater variability.}
}
@article{SADATNOORI2026135997,
title = {The global groundwater research knowledge divide},
journal = {Journal of Hydrology},
volume = {677},
pages = {135997},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135997},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010942},
author = {Mahmood Sadat-Noori and Danial Khojasteh and Milad Haghani and Abbas Shamsipour and Martin S. Andersen},
keywords = {Sustainable development goals, International collaboration, Climate change, Hydrogeology, Groundwater governance, Water security},
abstract = {Groundwater underpins global water security, supporting nearly half of irrigation and domestic water use. Yet the scientific knowledge base informing its management is unevenly generated and disseminated. Here, we use large-scale bibliometric analysis of 53,163 groundwater-related scholarly publications produced over the last ∼50 years, combining keyword co-occurrence mapping, document co-citation analysis, and collaboration network analysis to examine the evolution of research themes, geographic contributions, and international collaboration networks. We show that groundwater science has expanded exponentially, shifting from predominantly local hydrogeological characterisation toward sustainability, water quality, and climate-resilience research. However, this growth is highly concentrated, as a small group of high-income countries accounts for 62% of publications and 68% of citations, while many groundwater-dependent regions remain marginal in both knowledge production and collaborative networks. These structural imbalances constrain the transfer of scientific insights to regions facing the greatest groundwater stress, risking maladaptive management and undermining progress towards Sustainable Development Goal 6, one of the 17 Sustainable Development Goals adopted by the United Nations. This study provides one of the most comprehensive global bibliometric assessments of groundwater research, quantifying thematic evolution, geographic inequities, and collaboration structures across the field. Our findings provide a quantitative foundation for rethinking how groundwater knowledge is generated and shared, highlighting the need for targeted capacity building, open data infrastructures, and more inclusive international research partnerships to support evidence-based groundwater management and accelerate progress toward SDG 6. Overall, the results highlight the urgency of prioritising equitable groundwater research investments to close the global groundwater knowledge divide.}
}
@article{MENG2026135961,
title = {Dielectric properties of saline soils during freezing and a water–salinity inversion model for sandy soil},
journal = {Journal of Hydrology},
volume = {677},
pages = {135961},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135961},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010589},
author = {Qiang Meng and Junfeng Chen and Lihong Cui and Jing Xue and Qi Du and Xiaojun Yang},
keywords = {Freezing, Dielectric properties, Salt types, Water–salinity inversion model},
abstract = {Monitoring soil water and salt content in seasonally frozen regions using Frequency Domain Reflectometry (FDR) sensors is essential but remains challenging due to low temperatures and complex salinity effects. In this study, variations in the real (ε′) and imaginary (ε″) components of the FDR-derived apparent dielectric constant during freezing were monitored using Hydra Probe II sensors across 45 distinct treatments (two salt types: NaCl and Na2SO4; five soil water contents: 0.07–0.36 cm3/cm3; and five salt contents: 0–0.3 g/100 g). Under unfrozen conditions, both ε′ and ε″ generally increased with water and salt contents, although the response of ε′ to salt content weakened under high water content conditions. Meanwhile ε″ was weakly sensitive to water content in low-salinity soils but increased markedly and nonlinearly with water content in high-salinity soils. As soil pore water froze rapidly, both ε′ and ε″ decreased sharply, the decline in ε′ was greater at higher initial water content, while higher salt content maintained higher ε′ and delayed the sharp decline in ε″. In addition, ε′ and ε″ showed stronger temperature sensitivity in Na2SO4 and NaCl soils, respectively. After most pore water had frozen, salt type had little effect on the soil dielectric constant. A water–salinity inversion model for sandy soil was established by modifying the Topp equation with ε″ and temperature for soil water content inversion, and by improving the Hilhorst-based framework with water content and temperature correction factors for soil salt content inversion. The model demonstrated satisfactory performance under near-freezing conditions and could relatively accurately calculate soil water content and salt content according to ε′ and ε″ near 0 °C, it was achieved higher accuracy for soil water content estimation in Na2SO4 soils and soil salt content estimation in NaCl soils. These results provided a theoretical basis for estimating soil water and salt contents in frozen soils using a low-frequency FDR sensor.}
}
@article{SOEDARSO2026136010,
title = {Coupling ORCHESTRA with HYDRUS to simulate multicomponent reactive transport in variably saturated porous media},
journal = {Journal of Hydrology},
volume = {677},
pages = {136010},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136010},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011078},
author = {J.A.R. Soedarso and D.W.S. Tang and G. Sigmund and N.B. Sutton and H.H.M. Rijnaarts and J.C.L. Meeussen},
keywords = {Unsaturated zone contaminant hydrology, Plant soil water interactions, Numerical modelling, Agricultural soil and groundwater pollution, Emerging contaminants, Multicomponent biogeochemical reactions},
abstract = {We develop and demonstrate the coupling of the variably saturated flow and transport model HYDRUS-1D, with the geochemical reaction model ORCHESTRA, for simulating multicomponent reactive transport in soils and other porous media. We implement a loose coupling of HYDRUS and ORCHESTRA that feeds flow information simulated by HYDRUS into ORCHESTRA, where arbitrary multicomponent reactions, transformations, and kinetics can be implemented. The HYDRUS-ORCHESTRA coupled model is evaluated with four test cases of increasing complexity in a 100-cell, 1-meter deep unsaturated zone, including transient flow conditions and active internal sinks (root water and solute uptake). The aim was to examine the accuracy of the coupled model against HYDRUS, which can simulate simple reactive transport scenarios. The coupled model is accurate, with <0.65% deviation in outflow breakthrough times, and ∼1% deviation in terminal solute mass balances compared to HYDRUS. The coupled model’s agreement with HYDRUS increases with transport distance and grid refinement, because the deviations stem from numerical dispersion. This novel methodology makes it possible to simulate the fate of arbitrary reactive substances, nutrients, energy, and isotopes under transient, variably saturated conditions including plant-soil–water interactions. Such flexibility is particularly crucial for emerging contaminants, which can exhibit diverse novel and complex reactive behaviours.}
}
@article{NGUYEN2026135929,
title = {Multi-station rainfall–runoff–operation model for assessing flood characteristics in a cascading dam system under the impacts of climate change and sediment dynamics},
journal = {Journal of Hydrology},
volume = {677},
pages = {135929},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135929},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010267},
author = {Phuoc Sinh Nguyen and Sameh Ahmed Kantoush and Sohei Kobayashi and Seyed Amirreza {Tabataba Vakili} and Vahid Nourani},
keywords = {Rainfall–runoff–operation, Cascading dams, d4PDF, Sedimentation, Multi-station deep learning, Chikugo River Basin},
abstract = {This study aimed at (i) developing a multi-station deep learning rainfall–runoff–operation (DL-RRO) model for cascading dam systems and (ii) applying the model through the large ensemble dataset for Policy Decision-Making for Future Climate Change (d4PDF) to assess flood characteristic changes. The DL-RRO model was developed using a Long Short-Term Memory network that coupled rainfall–runoff processes and mimicked existing dam operation rules by learning operational logic from observed data. Dynamic water level–storage curves were generated to account for time-varying increases in sediment storage. The proposed method was applied to the upper Chikugo River Basin (CRB), where the Shimouke and Matsubara Dams play a critical role in flood control in Kyushu, Japan. The model showed high performance when trained, validated, and tested with 40 years (1986–2025) of hourly hydrological observations (NSE = 0.89, RMSE = 18.90 m3/s). Subsequently, d4PDF rainfall data for the future scenarios (2031–2090 and 2051–2110; 1,440 ensemble-year) were imposed to the DL-RRO model. Analysis of 8,725 simulated flood events revealed increased flood frequency and notable changes in hydrograph characteristics. Projected 100-year return flood may increase by +53 % at Shimouke and +165 % at Matsubara under future scenarios, exceeding existing spillway design capacities. Under the synergistic impacts of climate change and sediment dynamics, amplified flood characteristics may intensify flood-driven sediment deposition, leading to further reductions in flood control capacity of up to +2.9 % at the Shimouke and +4.1 % at the Matsubara. These findings highlight the urgent need to upgrade dams, revise operations and sedimentation management strategies in the upper CRB.}
}
@article{OHARA2026135981,
title = {Possibility of SWE estimation from snow cover extent using the dynamic non-Gaussian snow depletion curve},
journal = {Journal of Hydrology},
volume = {677},
pages = {135981},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135981},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010784},
author = {Noriaki Ohara and Rui A.P. Perdigão},
keywords = {Snow water equivalent, Snow cover fraction, Information metric, non-Gaussian correlation, Edgeworth expansion},
abstract = {Seasonal snow cover in mountainous regions has been regularly monitored by ground-based snow surveys and remote sensing techniques to serve as a predictor of water availability during the upcoming spring season in downstream regions. The objective of this study is to estimate the snow water equivalent (SWE) from the observable snow cover fraction (SCF) using the Pires & Perdigão (2007) non-Gaussian multivariate information-theoretic metric. This metric articulates higher-order cross-cumulants and Hermite polynomials into Edgeworth expansions to yield an analytical approximation of the conditional expectation (snow depletion curve, SDC) as well as the joint probability density functions (PDFs). The predictability of SWE from SCF was diagnosed by mutual information (MI) using 110 high-resolution snow distribution data from the NASA Airborne Snow Observatory (ASO). The results suggest that the non-Gaussian component can improve the estimation of SWE in addition to the regular Gaussian correlation method, while the MI generally decreases as the SCF approaches 1 (complete snow cover). Additionally, based on the distributed snow model, the possibility of higher-order statistical cumulant estimation was examined in the Upper Tuolumne River watershed. This analysis demonstrated that the non-Gaussian (non-linear) information metric can potentially provide the basin total SWE using estimated cross-cumulants from the marginal PDF of the remotely observed SCF.}
}
@article{CHRYSANTHOPOULOS2026135957,
title = {Spatiotemporal dynamics of capillary rise in shallow groundwater table areas revealed by spatial TDR},
journal = {Journal of Hydrology},
volume = {677},
pages = {135957},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135957},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010541},
author = {Efthymios Chrysanthopoulos and Martha Perdikaki and Epameinondas {Nondas Floros} and Andreas Kallioras},
keywords = {Signal processing, spatial TDR, Inverse modeling, Capillary rise, Shallow groundwater},
abstract = {Accurate quantification of soil water content (θ, cm3 cm–3) dynamics and capillary rise in shallow groundwater table areas remains a major challenge due to the limitations of conventional discrete point-scale measurements of θ. This study presents an integrated monitoring sensor system based on spatial time domain reflectometry (TDR) for retrieving high-resolution θ profiles along transmission lines. The approach combines inverse modeling of TDR waveforms using a fast–iterative physics–based transmission line model with Python-based code for automated signal processing, dynamic calibration against co-installed low-cost θ sensors and uncertainty propagation. Calibration is further constrained using soil hydraulic properties of undisturbed soil samples, enabling physically consistent scaling of θ values to soil porosity, while detailed analysis of each uncertainty source quantifies 90% confidence intervals in both θ profiles and threshold–based detection of the saturated portion of capillary fringe. Field application in a clay-rich experimental site revealed pronounced small-scale heterogeneity in groundwater table fluctuations and capillary rise dynamics. Spatial TDR measurements captured the upward–downward movement of the saturated portion of capillary fringe in response to diurnal groundwater fluctuations, providing direct observations of transient θ redistribution across the unsaturated zone. The results demonstrate that spatial TDR significantly improves the characterization of θ profile fluctuations compared to discrete measurements, resolving processes that are typically unobservable with conventional techniques. The proposed sensor system offers a robust methodology for linking groundwater dynamics with θ variability, providing a basis for precision in agricultural management, evapotranspiration estimation, and groundwater abstraction strategies. The integration of spatial monitoring with automated data processing provides a scalable pathway toward continuous, profile-scale observation of coupled surface–subsurface hydrological processes.}
}
@article{HUANG2026135898,
title = {Seasonal controls, recharge thresholds, and hydrological memory in karst groundwater dynamics revealed by interpretable deep learning},
journal = {Journal of Hydrology},
volume = {677},
pages = {135898},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135898},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009959},
author = {Linxian Huang and Henghua Zhu and Qichen Hao and Yong Xiao and Hao Liang and Zhenghe Xu and Chuanshun Zhi and Xiaonong Hu},
keywords = {Karst groundwater dynamics, Hydroclimatic controls, Recharge thresholds, Memory effects, Interpretable deep learning},
abstract = {Quantifying groundwater responses to climate forcing in karst systems remains difficult because recharge is nonlinear, threshold-dependent, and modulated by antecedent storage. We developed an interpretable deep learning framework to diagnose seasonal controls, threshold-like recharge behavior, and hydrological memory in the Baotu Spring karst watershed of northern China. A 66-year groundwater-level (GWL) record was segmented to isolate the period primarily controlled by meteorological forcing. Daily precipitation (P) and temperature (T) data from 2012 to 2024 were then used to train a long short-term memory model, and Expected Gradients together with Additive Decomposition quantified driver contributions and temporal memory. The model accurately reproduced groundwater dynamics in independent testing (Nash-Sutcliffe efficiency (NSE) = 0.93, coefficient of determination (R2) = 0.95, and root mean square error (RMSE) = 0.155 m). Attribution analysis revealed a clear seasonal hierarchy: summer exerted the strongest model-attributed control on groundwater variability, whereas autumn contributed secondarily through delayed recharge transmission. At the annual scale, P attributions became more positive when annual P exceeded 620 mm and GWLs were above 28.5 m, suggesting a threshold-like shift toward stronger positive model-attributed GWL sensitivity. At the event scale, the strongest positive P-related attribution occurred for daily P of 11.4–41.3 mm; smaller events were consistent with vadose-zone replenishment, whereas larger events suggested reduced marginal recharge efficiency due to greater runoff partitioning. High-GWL events were dominated by rainfall forcing, with short memory in summer, whereas winter rainfall memory extended to approximately five months; low-GWL events were linked to persistent P deficits, elevated T, and unfavorable rainfall-intensity distributions. These model-derived indicators support recharge assessment and groundwater-drought early warning in heterogeneous karst systems.}
}
@article{XU2026135987,
title = {Mechanism-guided dynamic machine learning overcomes environmental non-stationarity in algal bloom prediction},
journal = {Journal of Hydrology},
volume = {677},
pages = {135987},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135987},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601084X},
author = {Shujie Xu and Wenyu Zhang and Yong Tian and Shu-Chien Hsu and Chunmiao Zheng},
keywords = {Algal bloom, Machine learning, Structural equation modeling, Multiple regression trees, Adaptive management},
abstract = {Algal bloom prediction under environmental non-stationarity remains challenging, as historical regulatory thresholds frequently fail due to ecological concept drift. This study developed an integrated framework for Hong Kong rivers utilizing Structural Equation Modeling (SEM) and Multiple Regression Trees (MRT) to extract complex structural associations and historical tipping points. However, rigorous generalization testing revealed threshold deactivation. Static MRT-guided discretization models collapsed (recall score = 0.32, ROC_AUC = 0.50) because long-term pollution baseline reductions drove phytoplankton adaptation. Permutation feature importance confirmed a mechanistic paradigm shift, transitioning from historical phosphorus constraints to complex nitrogenous limitations. To overcome this drift, we propose a novel dual-stage decision-support framework. While MRT is retained to establish interpretable, long-term policy baselines, continuous-variable Machine Learning is deployed to process the full environmental context, achieving highly adaptive, dynamic operational forecasting (recall score = 0.68, ROC_AUC = 0.89). Ultimately, this framework mitigates high-dimensional blind spots, providing a resilient blueprint for proactive watershed management under shifting ecological realities.}
}
@article{TANG2026135964,
title = {Urbanization is associated with changes in the sensitivity of water quality to drought},
journal = {Journal of Hydrology},
volume = {677},
pages = {135964},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135964},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010619},
author = {Dongxin Tang and Pengcheng Sun and Shengzhi Huang and Xiaoting Wei and Yifei Li and Hao Cui and Dong Liu and Fuqiang Wang and Jingqing Gao},
keywords = {Urbanization, Relative discharge ratio, Specific conductance, Water temperature, Sensitivity},
abstract = {Rapid global urbanization has made water-quality degradation a core issue in assessing river health and aquatic ecosystem conditions. However, under a warming climate, the coupled relationships among urbanization, drought, and water quality remain unclear. In this study, we used regression analysis together with multiple statistical approaches to evaluate the sensitivity of two key water-quality indicators, specific conductance (SC) and water temperature (WT), to the relative discharge ratio (Q/MQ), which was used as a drought-related low-flow indicator. We also systematically analyzed how SC and WT varied with Q/MQ under different levels of urbanization. The results showed that SC followed a power-law response to Q/MQ and was significantly negatively correlated with the relative discharge ratio. WT showed clear seasonal contrasts in its response to Q/MQ: in the warm season, higher Q/MQ corresponded to lower WT, whereas in the cold season, higher Q/MQ corresponded to higher WT. We distinguished urbanization-related baseline shifts in water quality from drought-related low-flow sensitivity, defined as the response magnitude of SC or WT to changes in Q/MQ. The sensitivity of SC to relative discharge changes tended to be weaker at higher IMP levels. Based on the excess SC response, defined as P0.5 − 1, the SC response in low-urbanization basins was 23.48% and 129.03% higher than that in moderately and highly urbanized basins, respectively. In contrast, the response magnitude of WT to Q/MQ tended to be stronger at higher IMP levels. The WT response magnitude in highly urbanized basins was 47.89% and 70.34% higher than that in moderately and low-urbanization basins, respectively. Overall, urbanization was associated with changes in the sensitivity of water quality to relative discharge changes under drought-related low-flow conditions. This work characterized the response relationships between Q/MQ and SC and WT and documented how their sensitivities varied across urbanization levels. It provides scientific evidence to support watershed water-quality and river-health management for cities with different degrees of urban development.}
}
@article{NEWELL2026135976,
title = {Diverging seasonal trends in soil moisture in Northern Europe},
journal = {Journal of Hydrology},
volume = {677},
pages = {135976},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135976},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010735},
author = {Matthew L. Newell and Martin Drews and Morten Andreas Dahl Larsen and Mark R. Payne},
keywords = {Soil moisture, Hydrological hazards, Trend analysis, Northern Europe, Climate change, Natural variability},
abstract = {The observed trends in wetness across Europe bear a clear imprint of climate change: for more than six decades, Northern Europe has become significantly wetter, while Southern and parts of Central Europe face growing aridity due to changes in annual precipitation patterns. These changing hydrological conditions have resulted in varying hydrological risks across different regions. While many studies have focused on drought in southern Europe, changes in seasonal and sub-seasonal soil moisture conditions in the north have received considerably less attention. In this paper, we examine seasonal and sub-seasonal patterns in average and extreme soil moisture conditions across Northern Europe, shedding light on emerging trends and changing hydrological conditions with the potential for high impacts regionally. The study analyzes soil moisture in Northern Europe using ERA5-Land data from 1961 to 2020. We apply the modified Mann-Kendall test to assess trends and compare two climatological periods (1961–1990 and 1991–2020). Our findings show an increase in the number of soil moisture surplus days (SMSD) by 9.9 days and consecutive soil moisture surplus days (CSMSD) by 5.3 days in southern Norway and central Sweden. In spring, the number of soil moisture deficit days (SMDD) increased by 6.3 days and consecutive soil moisture deficit days (CSMDD) by 6.1 days in southern areas of Northern Europe. Without interventions, rapid winter-spring seasonal transitions in soil moisture, particularly in southern Sweden and the Baltic region, could increasingly challenge land use and water management both in the present and future.}
}
@article{CHEN2026135992,
title = {Wave damping ability of restored mangrove wetlands during typhoons: A case study from Hailing Island, China},
journal = {Journal of Hydrology},
volume = {677},
pages = {135992},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135992},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010899},
author = {Zongyao Chen and Wen Wei and Yulu Yang and Xiufang Qiu and Zihao Deng and Peng He},
keywords = {Wave attenuation, Restored mangrove, Typhoon, , Optimal restoration width, Pearl Delta},
abstract = {As climate change intensifies coastal flooding, nature-based coastal defense is garnering global concern. Though mangrove restoration is being widely implemented, the protective capacity of restored mangroves against storm waves remains poorly quantified. In this study, a 13-day field observation of wave evolution and vegetation properties was conducted across a restored Kandelia obovata wetland on Hailing Island, China, during Typhoon Maliksi (2024), to investigate the storm wave damping performance of restored mangrove wetlands and their functionality as nature-based coastal defense. The results demonstrate an enhancement in wave height reduction by the restored mangrove wetland from normal to typhoon conditions, with a larger increase in bare flat (from 15% to 26%) than the mangrove zone (from 14% to 22%). Despite its small structural dimensions, the restored mangrove exhibited storm wave height reduction (39% across 100 m) comparable to that of Sonneratia sp. and Sonneratia apetala under similar wave conditions, and larger than that of Aegiceras corniculatum despite higher incident waves, as reported in previous studies. Furthermore, an idealized one-dimensional wave propagation model, incorporating vegetation drag and bed friction effects, was developed to explore the role of mangrove width in wave attenuation by the coupled bare flat-restored mangrove system. The model indicates that while wave attenuation increases with mangrove width, the marginal gain per-unit-width added diminishes as mangrove width increases. An optimal restoration width of 16% (of the total width) was then identified to balance protective effect and cost‑effectiveness, which is suitable for both normal and storm conditions but is largely site‑specific (depending on tidal regimes, geomorphic conditions, and vegetation properties). These findings underscore the critical role of restored mangrove wetlands in mitigating typhoon impacts and provide practical insights for designing effective nature-based coastal defenses.}
}
@article{WEI2026135984,
title = {Quantifying potential ground-ice meltwater release and seasonal active-layer water-storage change using decade-long InSAR-derived ground deformation in the Qilian Mountains},
journal = {Journal of Hydrology},
volume = {677},
pages = {135984},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135984},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010814},
author = {Guanjun Wei and Hongyu Zhou and Guangrong Li and Hongwen Mu and Zhigang Du and Yu Li},
keywords = {Qilian Mountains, Permafrost degradation, Ground-ice meltwater release, Active-layer seasonal exchangeable water storage, Runoff response, InSAR time series},
abstract = {Regional observation-based constraints on permafrost-degradation-driven hydrologic responses remain limited in the Qilian Mountains, especially for ground-ice meltwater release and active-layer seasonal water-storage change. Here we use decade-long Sentinel-1 InSAR time-series products (2014–2025) from the COMET-LiCSAR system to retrieve regional ground deformation and quantify two related hydrologic signals: (i) potential ground-ice meltwater release and (ii) active-layer seasonal exchangeable water-storage change. We combine multi-frame mosaicking, ascending/descending MSBAS decomposition, and time-series modeling to estimate long-term vertical deformation rates and time-varying seasonal deformation amplitudes within the mapped permafrost domain. The results indicate that long-term vertical deformation in the Qilian Mountains is dominated by weak background signals, although localized subsidence reaches approximately 30–40 mm/yr. The subsidence-based potential meltwater release is estimated as 7.94 × 107 m3/yr, equivalent to 0.42 mm/yr in runoff depth. After accounting for uplift, the conservative net volumetric change decreases to 3.22 × 10⁶ m3/yr, or 0.02 mm/yr. This small net signal is below the product-level uncertainty scale and should be interpreted as a near-zero deformation-derived constraint rather than a resolved runoff increase. Seasonal deformation amplitudes are mostly < 10 mm, and their interannual trends show spatially heterogeneous increases and decreases. These results indicate non-uniform changes in active-layer seasonal exchangeable water storage. Overall, the InSAR-constrained signals suggest that permafrost degradation in the Qilian Mountains is expressed more strongly as heterogeneous storage redistribution and seasonal regulation than as a coherent regional increase in net meltwater contribution to runoff.}
}
@article{LI2026136000,
title = {Flood depth mapping with SWOT-derived training data: evaluating the potential of open-source datasets},
journal = {Journal of Hydrology},
volume = {677},
pages = {136000},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136000},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010978},
author = {Zixi Li and Jiayin Xiao and Fuqiang Tian and Fuxin Chai},
keywords = {Flood depth mapping, SWOT, Open-source DEM, Deep learning and machine learning},
abstract = {Flood depth is a critical parameter for disaster relief and damage assessment, yet pixel-level ground-truth data remain scarce. Traditional approaches, including digital elevation model (DEM) based methods and hydrodynamic simulations, are constrained by data accuracy, cost, and limited generalization. This study proposes machine learning (ML) and deep learning (DL) frameworks for flood depth estimation using only open-source datasets. Surface Water and Ocean Topography (SWOT) satellite observations were used to construct a pixel-level flood depth reference dataset for model training. Multi-channel inputs include DEM, slope, aspect, SAR/optical-derived flood extent, and AlphaEarth data, with channel- and self- attention mechanisms enhancing feature representation. Results from two test datasets show that both ML and DL outperform the baselines. Ablation experiments further confirm the value of attention mechanisms and Squeeze-and-Excitation (SE) in handling high-dimensional features. Validation with in situ measurements from the Haihe River Basin indicates that different flood extent extraction methods affect results, though differences are not statistically significant. The DL framework further demonstrates improved robustness to DEM uncertainties, reducing RMSE by 10–50 % across three test datasets. Overall, the results highlight the potential of combining SWOT with open-source data for flood depth mapping, while noting limitations related to SWOT event availability and DEM accuracy.}
}
@article{ZHOU2026135854,
title = {Progressive scale convolutional network for spatio-temporal downscaling of soil moisture: A case study over the Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {677},
pages = {135854},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135854},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009510},
author = {Ziyu Zhou and Keyan Hu and Ling Zhang and Zhaohui Xue and Yutian Fang and Yusha Zheng},
keywords = {Soil moisture, Downscaling, Deep learning, Tibetan Plateau, Multisource data},
abstract = {Soil moisture (SM) plays a critical role in hydrological and meteorological processes. High-resolution SM can be obtained by combining coarse passive microwave data with fine-scale auxiliary variables. However, the inversion of SM at the temporal scale is hindered by the incompleteness of surface auxiliary factors. To address this issue, first, we introduce validated high temporal resolution ERA5-Land variables into the downscaling process of the low-resolution SMAP SM product. Subsequently, we design a progressive scale convolutional network (PSCNet), at the core of which are two innovative components: a multi-frequency temporal fusion module (MFTF) for capturing temporal dynamics, and a bespoke squeeze-and-excitation (SE) block designed to preserve fine-grained spatial details. Using this approach, we obtained seamless SM products for the Tibetan Plateau (TP) from 2016 to 2018 at 10-km spatial and 3-hour temporal resolution. The experimental results on the TP demonstrated the following: 1) In the satellite product validation, the PSCNet exhibited comparable accuracy and lower error, with a mean R of 0.881, outperforming other methods. 2) In the in-situ site validation, PSCNet consistently ranked among the top three models in terms of the R metric across all sites, while also showing superior performance in overall error reduction. 3) In the temporal generalization validation, the feasibility of using high-temporal resolution ERA5-Land variables for downscaling was confirmed, as all methods maintained an average relative error within 6% and 2% in terms of R and ubRMSE, respectively. 4) In the temporal dynamics and visualization validation, PSCNet effectively captured temporal sensitivity and fine-grained spatial heterogeneity. Overall, PSCNet provides a promising solution for spatio-temporal downscaling by effectively modeling the intricate spatio-temporal relationships in SM data.}
}
@article{LIAO2026136029,
title = {On the storm direction and peak floods in the continental United States, 1950–2024},
journal = {Journal of Hydrology},
volume = {677},
pages = {136029},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136029},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011261},
author = {Mochi Liao},
keywords = {Storm direction, Potential peak precipitation, Floods},
abstract = {Storm direction has significant impacts on land surfaces, such as flood responses and soil erosion. With projected increases (e.g., frequency and magnitude) in extreme precipitation events across many regions of the world, it is worthwhile to explore possible changes in storm characteristics, especially as more data have become available during the satellite era over the past three decades. In this study, we focus on understanding and characterizing storm directions over the continental United States (CONUS). Specifically, a new storm direction model is developed and applied to model-based reanalysis (ERA5L, 9 km resolution) and surface measurement-based reanalysis (AORC, 4 km resolution). This study shows strong variability in storm directions over the Great Plains and spatial patterns of storm preferential direction (based on frequency) related to topography and climate regimes across CONUS. This study also reveals differences in storm travel distance and storm duration at event scales, conditional on whether the storm comes from a preferential or non-preferential direction. For example, the median storm travel distance is increased by 35 km when storms come from the preferential direction. Flood peaks are higher by a median of 50–100% when stream directions align with storm directions for mid-sized basins (1500 km2 to 2500 km2). Furthermore, the spacetime trajectory of maximum precipitation rate (referred to as Potential Peak Precipitation or PPP) derived from the new storm direction approach provides an integrated picture of storm dynamics, and AORC-based PPP is shown to be on the equivalent magnitude of observed maximum precipitation at event scales, particularly along the southern and southeastern coasts.}
}
@article{LIU2026135948,
title = {Tracking long-term dynamics of soil salinization using a model combining convolutional neural network and Transformer},
journal = {Journal of Hydrology},
volume = {677},
pages = {135948},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135948},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010450},
author = {Haohao Liu and Bin Guo and Xingchao Yang and Yilong Liu and Yujie Huo and Yuehua Zhong and Jianlin Wang},
keywords = {Soil salinity, Deep learning, Remote sensing, Spatiotemporal prediction, Yellow River Delta},
abstract = {Accurately tracking long-term soil salinization dynamics remains challenging, particularly in highly heterogeneous regions. Here, we propose a novel approach based on the Convolutional Neural Network (CNN)-Transformer model for the spatiotemporal prediction of soil salinization using multi-source remote sensing data. The model adopts a cascaded structure that integrates the capabilities of CNN and Transformer to extract spatial contextual information and capture global spatiotemporal dependencies, enabling robust modeling of salinization dynamics. We compared the CNN-Transformer model with common machine learning and deep learning models in terms of soil salt content (SSC) prediction performance. To enhance model interpretability, we used SHapley Additive exPlanations (SHAP) to quantify the contributions of salinization-related features to SSC prediction. Using the proposed method, we achieved dynamic monitoring of soil salinization in the Yellow River Delta (YRD). The results indicate the following: (1) The CNN-Transformer model achieved the highest prediction accuracy (R2 = 0.71, RMSE = 3.36 g kg−1, RPIQ = 2.24) and demonstrated good spatial generalization under spatially independent validation, with spatial prediction results exhibiting fine-grained local details and accurately capturing the complex spatial distribution of soil salinity. (2) Vegetation type factors (VTFs) and the topographic factor contributed most to SSC prediction, followed by salinity indices, vegetation indices, and soil moisture-related indices. (3) Overall, from 2002 to 2022, soil salinization in the YRD was alleviated. Salinization intensity was markedly lower after autumn harvest than after spring plowing, primarily due to seasonal climatic-hydrological variations and the leaching effects of summer precipitation and irrigation. This study provides a paradigm combining deep learning with multi-source remote sensing data for the dynamic monitoring of soil salinization.}
}
@article{YANG2026135932,
title = {Multi-resolution downscaling of inundation extents using deep learning},
journal = {Journal of Hydrology},
volume = {677},
pages = {135932},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135932},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010292},
author = {Chanyu Yang and Fiachra O’Loughlin},
keywords = {Flood inundation modelling, Deep learning, Downscaling},
abstract = {The application of deep learning models for downscaling flood inundation extents has been brought into focus in recent years. Considered as an alternative to physics-based models, deep learning models have the advantage of faster computational efficiency with acceptable accuracy. However, recent approaches in downscaling flood inundation extents have either: (1) taken a considerable amount of computational effort for model training; (2) focused on large flood events or large flood extents; or (3) only considered downscaling using a small number of scenarios and often only one. Inspired by the hybrid modelling approach, this study uses a hydrodynamic model to generate a time-series of low-resolution flood inundation extents and depths. This series is then downscaled into high-resolution flood inundation extents using a generative deep learning model. The proposed method is applied to an urbanised area in Dublin, Ireland, which covers 16.3km2. Ten combinations of low- and high-resolution flood maps are used to evaluate the models’ performance. The results show that: (1) there is no obvious relationship between model performance and the magnitude of downscaling; (2) a deeper model architecture can provide better predictions and is more robust in classifying deeper flood depths without increasing prediction computational cost; (3) 18 times downscaling (90 m to 5 m) was found to be the most efficient and accurate model tested. The proposed deep learning model offers potential for real-time flood inundation forecasting, where coarser, faster inundation models can be downscaled to useful inundation maps without a significant loss in accuracy and without real-time computational overhead.}
}
@article{LEE2026136021,
title = {Decoupled storm-phase source dynamics of dissolved and particulate organic matter in an agricultural watershed},
journal = {Journal of Hydrology},
volume = {677},
pages = {136021},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136021},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011182},
author = {Yun Kyung Lee and Ho-Yeon Park and Haeseong Oh and Seung-Hee Kim and Kyung-Hoon Shin and Jae-In Kim and Byung Joon Lee and Jin Hur},
keywords = {Particulate and dissolved organicmatter, Source tracking, End-member mixing analysis, Non-point source, Agricultural watershed},
abstract = {Storm events strongly regulate organic matter (OM) mobilization in agricultural watersheds, yet potential differences in the source evolution of dissolved and particulate OM (DOM and POM) across storm phases remain poorly constrained. Here, we conducted hydrograph phase-resolved storm sampling during two rainfall events and applied end-member mixing analysis (EMMA) to quantify phase-specific OM source dynamics. Source contributions were traced using δ13C–δ15N for POM and fluorescence indices for DOM. Bulk water-quality parameters and POM concentrations increased with discharge during the monitored events, closely tracking suspended solids and particulate nutrients, suggesting cumulative mobilization under event-specific hydrological conditions rather than a clear first-flush-like decline. EMMA results indicated highly dynamic POM source evolution, with leaf litter/riparian vegetation initially contributing 60–67% of POM during the early stage but declining to ∼29% near peak flow as soil-derived POM increased sharply to ∼51%, consistent with discharge-associated particulate mobilization and progressive source-area activation during storm progression. In contrast, DOM showed comparatively buffered dynamics and a strong manure/compost-like signature within the FI–BIX-based EMMA framework, contributing ∼37–58% across storm phases, suggesting persistent leaching and flushing from manure-amended areas once source areas became connected to active flow paths. Source-specific OC fluxes were concentrated in short high-flow windows, with sharp POC pulses near peak discharge and more persistent DOC export into recession. These findings indicate decoupled POM and DOM transport during the monitored storms and highlight the value of phase-resolved, OM-specific source apportionment for interpreting storm-driven carbon export and informing targeted watershed management.}
}
@article{ZHAO2026135960,
title = {Tide-induced groundwater table fluctuations in a coastal unconfined aquifer with the seaward boundary featuring a slope break},
journal = {Journal of Hydrology},
volume = {677},
pages = {135960},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135960},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010577},
author = {Huawen Zhao and Ye Ma and Xuan Wu and Xiaogang Chen and Ling Li},
keywords = {Submarine groundwater discharge, Groundwater level fluctuation, Reclaimed coastline, Coastal levee, Truncated tidal response, Subharmonic generation},
abstract = {Analyzing tidal water table fluctuations can provide insights into the connectivity between coastal aquifers and the ocean. This study examined tidal propagation in an aquifer with a seaward boundary that has a slope break caused by a coastal levee. Such boundary conditions are common along reclaimed or protected shorelines but have been poorly studied. Field observations revealed a discontinuous and truncated groundwater response to tidal forcing, varying with the tidal range over the spring-neap cycle. Strong second harmonic tidal signals were also observed. We developed an analytical solution, based on a Fourier series approximation of the slope-break boundary condition, to examine the mechanism of the observed tidal groundwater dynamics, validated by numerical simulations. The results showed that the slope break truncates tidal forcing during ebb, due to the formation of an extensive seepage face. This truncation generated second harmonics, which propagated into the aquifer. The study presents an analytical method for dealing with complex tidal forcing associated with slope-break coastal morphology. The findings advance understanding of coastal groundwater table fluctuations in response to oceanic tides.}
}
@article{MOTAMEDI2026135936,
title = {Electrical conductivity and groundwater elevation as parameters for continuous infiltration and inflow detection in wastewater networks},
journal = {Journal of Hydrology},
volume = {677},
pages = {135936},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135936},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010334},
author = {Behnam Motamedi and Elisangela Heiderscheidt and Axumawit Tesfamariam and Pekka M. Rossi},
keywords = {Inflow–infiltration (I/I), Groundwater infiltration, Electrical conductivity (EC), Endmember mixing analysis, Stormwater inflow, Sewer networks},
abstract = {Extraneous groundwater infiltration and rainfall-derived inflow (I/I) undermine hydraulic capacity, raise energy costs, and dilute treatment performance in separate sewer networks. We evaluated electrical conductivity (EC) as a low-cost, conservative tracer for routine I/I diagnosis using yearlong monitoring with continuous EC sensors and groundwater elevation loggers in two Finnish catchments, a northern snow-dominated and a southern rainfall-dominated regime. Our analyses compared (I) commonly used hydrograph separation, (II) binary EC mixing (wastewater + groundwater), and (III) ternary EC–GW–SW mixing (wastewater +stormwater + groundwater). Relative to a volume-only split, incorporating EC increased the inferred infiltration share by up to ∼30 percentage points, while inflow remained secondary. Seasonal patterns aligned with meteorology; snowmelt dominated extraneous water in the north, whereas summer rainfall prevailed in the south. The binary EC-GW approach closely matched the ternary results but required no stormwater-EC sampling, favoring operational uptake. All diagnoses were cross-checked against precipitation, temperature, and snow-depth records to verify the link between weather and I/I dynamics. Pairing off-the-shelf EC and groundwater elevation sensors with simple mass-balance tools yielded accurate, season-resolved I/I budgets, targeting high-I/I zones, prioritizing rehabilitation, and building resilience under increasing freeze–thaw and rainfall variability.}
}
@article{HU2026135988,
title = {Divergent 3D dynamics of subsurface lateral preferential flow network in broadleaf versus coniferous hillslopes: insights from time-lapse GPR},
journal = {Journal of Hydrology},
volume = {677},
pages = {135988},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135988},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010851},
author = {Yun Hu and Hang Xu and Li Guo and Yi Jian and Jing Li and Feifei Hou and Xiaole Han and Jiancong Zhang and Genxu Wang},
keywords = {Land cover, Subsurface runoff, Geophysics survey, Lateral preferential flow, Hillslope hydrology, Hydropedology},
abstract = {The mechanisms by which forest type modulates subsurface hydrologic connectivity and runoff generation remain poorly constrained, largely due to the difficulty of observing lateral preferential flow (LPF) dynamics in situ. This study integrated time-lapse ground-penetrating radar (GPR) with controlled infiltration experiments to quantitatively compare three-dimensional (3D) activation and evolution of subsurface LPF on adjacent broadleaf (BF) and coniferous (CF) forest hillslopes. Structural similarity (SSIM) index analysis was applied to GPR images collected across five parallel 1.5 m transects spaced at 0.3 m intervals, enabling mapping of spatiotemporal development of 3D LPF networks. Geophysical observations were independently supported by concurrent measurements of rainfall, soil moisture, and subsurface runoff in adjacent hillslopes. Our results reveal distinct, forest type-dependent LPF regimes: (1) On the BF hillslope, LPF activated rapidly and in a spatially connected manner, mainly at 0.6–1.0 m depth, likely along root channels and the soil-saprock interface. The volume of soil conducting LPF surged from 28.7% to 58.1% after the first infiltration pulse, then receded to 52.8% following the second. (2) In contrast, on the CF hillslope, activation was delayed and shallower, occurring mainly at depths of 0.2–0.4 m. Here, the activated soil volume for LPF increased incrementally from 14.1% to 32.4% after the first pulse and to 46.3% after the second. (3) Hydrometric measurements mirrored these geophysically derived 3D LPF patterns. BF showed higher soil-moisture response frequencies to rainfall input (0.776 vs 0.704) and larger amplitudes, consistent with more rapid and extensive LPF activation, together with sustained deeper subsurface runoff peaking at 4.18 mm at 0.6 m depth. In contrast, CF runoff was mainly shallow and attenuated, peaking at 3.56 mm at a depth of 0.1 m. Our findings demonstrate that, in addition to aboveground rainfall partitioning (effective water input), forest type regulates rainfall-runoff regimes by controlling subsurface Critical Zone connectivity. By quantifying these structure-process interactions, this study provides a transferable hydrogeophysical framework for advancing hillslope hydrological monitoring and offers new insights into vegetation’s regulation of subsurface runoff generation.}
}
@article{ZHANG2026135968,
title = {Short-term changes in slope vegetation patch patterns and their regulation on sediment connectivity in an arid area},
journal = {Journal of Hydrology},
volume = {677},
pages = {135968},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135968},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010656},
author = {Shangxuan Zhang and Long Li and Hairu Li and Linfu Liu and Yanan Ren and Yu Zhang},
keywords = {Vegetation patch patterns, Arid and semi-arid areas, Soil erosion, Index of sediment connectivity (IC)},
abstract = {Vegetation patch patterns play a critical role in regulating surface hydrological processes in arid ecosystems. However, the short-term changes in these patterns and their coupling mechanisms with slope sediment connectivity (IC) remain poorly understood. In this study, we combined three years of in situ observations with Unmanned Aerial Vehicle (UAV) and Terrestrial Laser Scanning (TLS) technologies to investigate the short-term dynamics of three vegetation patterns (random, uniform, and aggregated) and their impacts on soil erosion. The results showed that vegetation patch patterns exhibited signs of short-term degradation under erosive disturbance, characterized by increasingly complex patch boundaries, heightened fragmentation, and reduced functional connectivity. Specifically, the random pattern exhibited the most severe fragmentation, with the Landscape Shape Index (LSI) increasing by 27.76%. In terms of erosion regulation, the uniform pattern demonstrated the strongest runoff and sediment interception capacity, reducing runoff and sediment yield by 40.46% and 53.48%, respectively, compared with bare slopes. Furthermore, landscape metric analysis indicated that both LSI and COHESION were generally negatively associated with sediment connectivity (IC). The pattern-based prediction equations further showed that IC promoted runoff and sediment export, whereas CONNECT reduced erosion by interrupting continuous transport pathways. Collectively, our findings suggest that future ecological restoration management in arid regions should move beyond increasing vegetation coverage alone and optimize vegetation spatial configuration according to site water availability, vegetation stability, and the distribution of IC hotspots. Where site conditions permit, relatively uniform vegetation patterns may be considered to enhance runoff interception and sediment retention. Targeted interventions in high-IC areas may further help disrupt sediment connectivity, reduce runoff-driven sediment transport, and mitigate erosion risk.}
}
@article{SHARMA2026135944,
title = {A unified framework for groundwater level imputation and forecasting in data-limited catchments},
journal = {Journal of Hydrology},
volume = {677},
pages = {135944},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135944},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010413},
author = {Yaggesh Kumar Sharma and Seokhyeon Kim and Ashish Sharma and Okke Batelaan},
keywords = {Neural architecture search, Groundwater level forecasting, Missing data imputation, Multiple Imputation by Chained Equations (MICE), Deep learning, Data-scarce groundwater systems},
abstract = {Accurate groundwater-level forecasting is essential for sustainable water management, yet remains challenging in data-scarce regions where monitoring records are incomplete and discontinuous. This study examines whether reliable forecasts can be achieved when training data are substantially reconstructed rather than fully observed. To address this problem, we developed a Groundwater Level–Imputation–Forecasting (GWL-IMFO) framework that combines Multiple Imputation by Chained Equations (MICE) with Neural Architecture Search (NAS). MICE was used to reconstruct missing monthly groundwater-level records, while NAS selected suitable ANN, LSTM, or GRU-based forecasting architectures under imputation-affected data conditions. The framework was evaluated across 1,493 monitoring wells in six basins representing diverse aquifer types, land-use/land-cover classes, and Köppen climate zones. Controlled missing-data scenarios of 20%, 30%, and 40% were generated only within the 2005–2023 training period, while 2024 observations were kept independent for out-of-sample forecasting evaluation. The 40% missing-data scenario was used as a stress-test condition to assess robustness under severe monitoring-data degradation. Even under this condition, GWL-IMFO maintained useful short- to mid-term forecasting skill, achieving median correlation values above 0.60 and RMSE below 1 m for forecasts up to 12 months, and outperforming conventional LSTM, GRU, and ANN models in most cases. These results indicate that model architectures trained on reconstructed groundwater records should not be assumed fixed a priori, but may need to adapt to imputation-affected data characteristics. The proposed framework provides a reproducible and scalable benchmark for groundwater forecasting in heterogeneous, data-limited environments, while also highlighting the need to consider data completeness, missing-data severity, hydrogeological setting, and forecast horizon when applying the model operationally.}
}
@article{NIE2026135996,
title = {Three Gorges Reservoir operations regulate nitrogen transport and transformation via hydrology-sediment-carbon interactions},
journal = {Journal of Hydrology},
volume = {677},
pages = {135996},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135996},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010930},
author = {Bei Nie and Yu Bai and Wei Zha and Shan Zhang and Miaomiao Chen},
keywords = {Three Gorges Reservoir, Nitrogen cycling, Drying-rewetting process, Suspended sediment, Carbon input},
abstract = {The global proliferation of reservoir construction has fundamentally altered nitrogen cycling across spatiotemporal scales. However, uncertainties persist regarding natural and anthropogenic regulation impacts on nitrogen transport-transformation processes in the reservoir, limiting the knowledge of accurately predicting different nitrogen components. Incorporating characteristics of sediment-mediated and drying-wetting process in the Three Gorges Reservoir (TGR), this study developed a novel Hydro-Sediment-Biogeochemical Model (HSBM) to systematically evaluate synergistic effects of reservoir operational schemes, sediment fluxes, and carbon inputs on nitrogen transport and transformation. The HSBM revealed that nitrogen dynamics in the TGR were engineered by three key drivers: reservoir operation, sediment load, and carbon input. Specifically, reservoir operation drove decreases in NH4+-N and NO3−-N concentrations that were inversely correlated with water level and impoundment duration, while nitrogen emissions scaled linearly with the drying-rewetting coefficient Kz, showing the strongest regulation during frequent fluctuating periods. Increased sediment loads suppressed nitrogen concentrations in water column while exponentially enhancing nitrogen emissions, with peak corresponding to low-water-level season. Similar to sediment load, regulation of carbon input on nitrogen transformation was stronger, especially with a linear growth relationship between the carbon augmentation coefficient (Kax) and nitrogen emissions (2–18% increase per Kax unit). Mechanistically, these dynamics are collectively regulated by reservoir-mediated nitrogen cycling, specifically via expansion of drying-rewetting zones, sediment-associated adsorption and nitrification–denitrification coupling, and carbon-stimulated denitrification. These findings provide a process-based framework to support adaptive nitrogen management strategies in reservoir systems.}
}
@article{ZHAO2026136005,
title = {Geometric controls on heterogeneous recession and vulnerability of glaciers in the Mount Everest region, central Himalaya},
journal = {Journal of Hydrology},
volume = {677},
pages = {136005},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136005},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011029},
author = {Yanlong Zhao and Tanguang Gao and Wanqin Guo and Jiansheng Feng and Shuochen Qin and Shichang Kang},
keywords = {Glacier heterogeneity, Geometric controls, Glacier recession, Vulnerability assessment, High-resolution remote sensing, Central Himalaya},
abstract = {The physical mechanisms governing the heterogeneous recession of central Himalayan glaciers remain debated, particularly regarding the competing roles of geometric versus surface controls. While traditional coarse-resolution studies often emphasize the regulating effects of debris and lakes, their dominance at the regional scale has not been rigorously quantified, creating uncertainty in catchment-scale runoff projections. Here, we conducted a comprehensive assessment of glacier change and vulnerability based on high-resolution ZY-3 imagery from 2012 to 2021. We established a high-precision glacier inventory and developed a multi-dimensional vulnerability index through a hybrid AHP-Random Forest approach. We find that the spatial heterogeneity is overwhelmingly determined by geometric controls. Topographic and morphological factors collectively account for 98.03% (95% CI: 96.31%–99.16%) of the total relative contribution, whereas surface-condition variables contribute only 1.97% (95% CI: 0.84%–3.69%), with altitude, slope, length-to-width ratio, and glacier area jointly contributing over 60% of the total. Governed by these geometric constraints, 32.6% of the region’s glaciers have suffered a complete loss of accumulation area, transitioning into a state of progressive decay independent of short-term climate variability, signaling a weakening of the drought-buffering capacity in headwater catchments. Furthermore, the vulnerability assessment highlights a profound structural imbalance between total area and glacier count. While the few large glaciers dominating the total area are moderately vulnerable, 81.5% of individual glaciers are systematically classified as having High to Very High vulnerability due to unfavorable geometric configurations. This study demonstrates that glacier geometry, rather than surface conditions, is the principal driver of heterogeneous responses and future risk, offering critical insights for glacier and hydrological modeling and water resource management.}
}
@article{GU2026135904,
title = {An efficient solver for the Richards equation for variably saturated flows in porous media},
journal = {Journal of Hydrology},
volume = {677},
pages = {135904},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135904},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010012},
author = {Xuelong Gu and Qi Wang},
keywords = {Richards equation, Nonlinear Gauss-Seidel, Nonlinear multigrid, Iterative solvers, Porous media},
abstract = {We present a nonlinear multigrid solver for the Richards equation in variably saturated porous media with strongly nonlinear and spatially heterogeneous hydraulic conductivity and water-retention relationships. In the solver, the governing equation is discretized using a second-order conservative finite-difference scheme in space and an implicit backward difference formula in time. The central innovation of the solver is a Nonlinear Gauss–Seidel (NGS) smoother that combines a triangular splitting of the diffusion operator with diagonal stabilization. This splitting yields an update scheme that consists of a sequence of locally decoupled scalar nonlinear problems, each of which can be solved efficiently and robustly with a few Newton iterations. Under monotonicity assumptions, we establish L∞-convergence of the NGS iteration and derive explicit conditions for the stabilization parameters. Numerical results for benchmark infiltration, drainage, and root-uptake problems demonstrate that the NGS-based multigrid framework is both computationally efficient and robust.}
}
@article{SHI2026135920,
title = {On nonlinear thermal dispersion and interfacial heat exchange in the filled fracture-matrix systems near the wellbore},
journal = {Journal of Hydrology},
volume = {677},
pages = {135920},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135920},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010176},
author = {Wenguang Shi and Quanrong Wang and Aohan Jin and Chong Ma and Fan Hu and Yanxin Wang},
keywords = {Nonlinearthermal dispersion, Heat transfer coefficient, Geothermal exploration, Thermal mixing effect, Analytical model},
abstract = {Numerous models have been developed to investigate heat transfer behaviors in the fracture-matrix systems. However, the thermal dispersion is either neglected or treated as linear, Fourier’s law is preferred for determining the heat exchange flux at the fracture-matrix interface, and the thermal mixing effect within the wellbore is generally ignored. We herein derive two analytical models of heat transport in filled fracture-matrix systems near the wellbore to improve existing models, in which the interfacial heat exchange flux between fracture and matrix is described by the Newton’s law of cooling and Fourier’s law, respectively. A power-exponential function is employed to describe nonlinear thermal dispersion. A time-dependent model is employed to characterize the thermal mixing effect. A comparison of the two proposed models shows nearly same temperature distributions along the fracture, whereas significant temperature differences occur in the matrix for low heat transfer coefficient (h) values. As h increases, the heat exchange flux between the fracture and the matrix increases, and the difference between the newly developed model based on Newton’s law of cooling and Fourier’s decreases, eventually yielding the same results. Since the thermal mixing effect model has not yet been validated with field data, it is tested in this study. Meanwhile, a simplified model is proposed to quickly evaluate whether thermal mixing effect should be considered. Compared to previous models, we find that neglecting the thermal mixing effect significantly overestimates the temperature distribution in the fracture. An increased exponent in nonlinear thermal dispersion model results in a reduction of fracture temperature. A larger thermal dispersivity decreases temperature near the injection well and increases it farther from the well. The models proposed in this study could also be applied to porous aquifer-aquitard systems. This work provides new insights for choosing models based on interfacial heat exchange processes in fracture-matrix systems.}
}
@article{JIANG2026135972,
title = {Modeling nutrient-driven water quality changes in Miyun Reservoir: An improved SWAT–Delft3D approach},
journal = {Journal of Hydrology},
volume = {677},
pages = {135972},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135972},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010693},
author = {Yan Jiang and Yiping Chen and Lijing Pang and Zhengfang Huang and Hongtao Zhao and Xuefeng Wu},
keywords = {Watershed–reservoir interactions, SWAT–Delft3D coupling, Nutrient transport, Pollution control measures, Hydrological variability, Water quality management},
abstract = {Excessive nutrient input severely degrades reservoir water quality, yet reservoir responses to terrestrial pollution sources remain poorly quantified. This study developed an integrated watershed–reservoir simulation framework by coupling the SWAT model with the Delft3D model, where the Delft3D river module replaced SWAT’s channel routing module to better represent hydrological connectivity and nutrient transport across the overland–river–reservoir continuum. Following calibration and validation, the integrated model was applied to quantitatively evaluate the response of reservoir water quality under different hydrological year types (wet/normal/dry) to multi-source pollution control measures. The results revealed clear variations in the total nitrogen (TN) reduction efficacy of different pollution control measures. Among these, livestock manure recycling (utilization rate ≥ 90%) was the most effective, followed by township sewage treatment. In contrast, fertilizer reduction yielded limited benefits (TN reduction < 1%), while wastewater treatment upgrading had no significant effect under the tested scenarios. Hydrological conditions also influenced the effectiveness of these measures, with TN reductions of 2–6% in normal years but less than 1% in dry years. Spatially, inflow responses exhibited pronounced heterogeneity among tributaries. Analyses of tracer-based transport and mean residence time indicated that reservoir-scale buffering and transport delays constrain the rapid transmission of upstream load reductions to downstream outflows. These findings indicate that reservoir water-quality responses to watershed pollution-control measures are jointly influenced by pollution-source type, hydrological conditions, and variability among inflowing tributaries, highlighting the need to prioritize management strategies in drinking-water reservoir systems.}
}
@article{MENG2026135980,
title = {Characterization of groundwater recharge in complex aquifer: an improved nonlinear Transfer Function-Noise model integrating groundwater reservoir mechanics},
journal = {Journal of Hydrology},
volume = {677},
pages = {135980},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135980},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010772},
author = {Xiangbo Meng and Xi Chen and Man Gao and Guangxuan Li and Yongda Liu},
keywords = {Groundwater level, Groundwater recharge, Deep groundwater depth, Transfer Function-Noise(TFN) model},
abstract = {Accurate assessment of groundwater recharge is critical for sustainable water resource management. However, simulating recharge processes remains challenging in regions with deep groundwater depth, owing to the interplay among vadose zone heterogeneity, nonlinear recharge thresholds and switching behaviors, and delayed aquifer response. Conventional Transfer Function-Noise (TFN) models link stresses to groundwater fluctuations for recharge estimation, but their implicit curve fitting constrains physical interpretability in complex hydrogeological settings. To address these limitations, this study extends the TFN framework into the TFN-Tank formulation by coupling a root-zone-based nonlinear recharge model with a mechanistic groundwater reservoir module. Validated against six distinct dynamic patterns in the Daqing River Basin of North China Plain, the improved framework achieved high-fidelity groundwater simulations (NSE > 0.75) and consistently outperformed traditional TFN models (NSE gains of 0.014–0.089). Uncertainty analysis confirms that the improved model reduces simulation uncertainty and corrects lag-time overestimation in traditional TFN models. Applied to 186 monitoring wells in the Daqing River Basin, the improved model reveals that the infiltration recharge coefficient decreases spatially from 0.47 in piedmont areas to below 0.1 in the coastal plains. Notably, the infiltration recharge coefficient exhibits a non-monotonic pattern, first increasing and then decreasing with groundwater depth, while the lag time increases monotonically. As a physically informed, data-driven framework, TFN-Tank delineates the complete temporal evolution of recharge processes, thereby facilitating integration with regional groundwater models and sustainable groundwater resources management.}
}
@article{ZHOU2026135963,
title = {Sources and transport of potassium in a typical carbonate-type lake (Bangor Co) on the Qinghai-Tibet Plateau: Constraints from potassium isotopes},
journal = {Journal of Hydrology},
volume = {677},
pages = {135963},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135963},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010607},
author = {Jiangdi Zhou and Binkai Li and Jiangang Jiao and Maoyong He and Zhongli Tang and Yuanyuan Cheng and Zhengyan Li and Jiaxin Luo and Huihui Rao and Jing Wen and Li Deng and Zhikang Liu},
keywords = {Carbonate-type salt lake, δK-δLi-δB, Source-transport-sink},
abstract = {With the development of measurement techniques, K isotope composition (δ41K) has become a sensitive tracer of surface processes. The evolution of K-Li-B in salt lakes remains insufficiently constrained and a single isotope system cannot resolve the behavior of multiple elements. Bangor Co is a typical carbonate-type salt lake on the Qinghai-Tibet Plateau with relatively simple recharge condition and the absence of extensive K-salt mineral precipitation, making it an ideal site to study early-stage salt lake evolution. This study focuses on K isotope compositions in river (−0.12‰), cold springs (−0.72‰ to 0.02‰), and brines (−0.76‰ to − 0.36‰), together with hydrochemistry, Li and B isotopes. These data indicate that K in Bangor Co is mainly sourced from silicate weathering, geothermal inputs, and the redissolution of lacustrine sediments. The δ41K fractionation observed in the brines may reflect the important influence of clay mineral adsorption, with inferred K removal fractions of 0.29–0.55. Comparison of K, Li and B isotopes reveals decoupled geochemical behavior among elements and establishes a conceptual model for carbonate-type salt lakes. This study demonstrates that δ41K is an effective tracer in carbonate-type salt lake catchments. A multi-isotope approach provides a useful framework for understanding solute evolution in carbonate-type salt lakes and similar evaporitic systems.}
}
@article{QIU2026135947,
title = {Deep learning-enhanced sequential updating of hydraulic parameters and state variables in groundwater models},
journal = {Journal of Hydrology},
volume = {677},
pages = {135947},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135947},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010449},
author = {Huiyang Qiu and Zejun Wang and Wanzhou Wang and Qi Li and Yuanzheng Zhang and Jiangjiang Zhang},
keywords = {Groundwater modeling, Parameter estimation, State prediction, Deep learning, Data assimilation},
abstract = {As a fundamental component of the hydrological cycle, groundwater systems play a critical role in sustaining ecosystems, securing water resources, and supporting socio-economic development. However, substantial uncertainties remain in both parameter estimation and state prediction, limiting the reliability of groundwater models. Improving predictive accuracy therefore requires the sequential, real-time updating of model states and parameters using newly acquired observations. Although the ensemble Kalman filter (EnKF) has been widely applied for this purpose, its performance can degrade in non-Gaussian and strongly nonlinear systems, for which approaches based on transformations or multiple-point geostatistics have been proposed as effective remedies. In this study, we present an alternative strategy by introducing a deep learning (DL)-based update strategy into the EnKF framework, resulting in a hybrid ensemble filtering approach that integrates DL-based nonlinear updates with Kalman-type linear updates, termed EF(DL-K). The proposed method is designed to more effectively fuse information from numerical models and observations in complex groundwater systems. Compared with the conventional EnKF and a purely DL-based ensemble filter [EF(DL)], EF(DL-K) exhibits enhanced flexibility and robustness in the sequential updating of both hydraulic parameters and state variables in subsurface aquifer systems. The impact of the placement of the DL step within the EF(DL-K) framework is systematically investigated. The results show that EF(DL-K) yields assimilation performance comparable to that of the EnKF under Gaussian conditions, while achieving substantially improved joint state-parameter estimation under non-Gaussian conditions. Overall, EF(DL-K) provides a promising filtering-based data assimilation framework for real-time model-data integration and the dynamic updating of both parameters and state variables in groundwater systems.}
}
@article{ZHANG2026135955,
title = {Three-dimensional reservoir characterization from hard and soft data based on latent diffusion model},
journal = {Journal of Hydrology},
volume = {677},
pages = {135955},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135955},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010528},
author = {Ce Zhang and Gang Liu and Qiyu Chen and Zhesi Cui and Hongfeng Fang and Dajie Chen and Junping Xiong and Kaikai Zhang},
keywords = {Three-dimensional reservoir characterization, Uncertainty, Soft and hard data constraints, Latent diffusion model, Conditional fusion strategy},
abstract = {The reliability of three-dimensional (3D) reservoir modeling directly influences the accuracy of subsurface resource evaluation and development decisions. Traditional modeling methods primarily rely on sparse borehole data. Consequently, they struggle to fully integrate multi-source information, such as seismic interpretations. This leads to significant uncertainty in the modeling results. To address this issue, this study proposes a Soft-Hard Constrained Latent Diffusion Model (SH-LDM). This method integrates the hard data from boreholes and soft data from seismic interpretations to provide global structural information. It effectively constrains the modeling process, thereby enhancing model reliability. The SH-LDM first maps high-dimensional geological models into a low-dimensional latent space for learning and generation. This significantly reduces the complexity of model training and inference. Building on this, a conditional fusion strategy with multi-level feature embeddings is constructed. It simultaneously introduces the exact matching constraints of hard data and the trend guidance of soft data within the latent space. This achieves both strict control over hard data points and a coherent representation of the overall structural morphology. This study validates the effectiveness of the SH-LDM on non-stationary 2D and 3D reservoir datasets. The consistency of the generated model with training images in both local and global features is evaluated using the minimum acceptance criterion. Quantitative and qualitative comparisons with various benchmark models demonstrate the superior performance of the SH-LDM in terms of modeling accuracy and statistical consistency. Ablation studies and sensitivity analyses demonstrate that incorporating soft data significantly enhances the reliability of modeling results. Furthermore, the SH-LDM exhibits a certain degree of robustness to noise present in the soft data.}
}
@article{YANG2026135983,
title = {Trace element sources, migration and health risks associated with river-groundwater interaction: Insights from isotopes, fluorescence spectroscopy and Monte Carlo simulation},
journal = {Journal of Hydrology},
volume = {677},
pages = {135983},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135983},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010802},
author = {Xu Yang and Muhan Li and Yiying Miao and Fuyang Huang and Zeyuan Liu and Hongli Ma and Ping Miao and Jigang Shi and Zengbao Zhang and Shen Qu and Ruihong Yu},
keywords = {Sr/Sr, Rn mass balance model, Dissolved organic matter, Health risk assessment, Yellow River Basin},
abstract = {The sources, migration pathways, and associated risks of trace elements (TEs) linked to river–groundwater interactions remain inadequately understood. This study integrated a Bayesian isotope mixing model (MixSIAR), a 222Rn mass balance model (RMBM), and Monte Carlo simulation (MCS) to elucidate TE dynamics in the Hangjin Section of the Yellow River, China. Groundwater exhibited markedly higher TE concentrations than surface water, accompanied by higher values of the entropy-weighted water quality index (EWQI) and heavy metal pollution index (HPI). The MixSIAR results indicated that dissolved Sr compositions were jointly controlled by natural and anthropogenic hydrogeochemical processes, including evaporite dissolution (15.53%), silicate weathering (14.10%), carbonate weathering (11.70%), irrigation water (15.98%), sewage (15.43%), municipal water (15.52%), and fertilizers (11.74%), thereby influencing TE occurrence and enrichment in the study area. Fluorescence indices indicated that dissolved organic matter, primarily derived from terrestrial and microbial sources, significantly influenced TE behavior through complexation and adsorption processes, particularly in groundwater. Groundwater discharge-mediated fluxes, particularly Li (0.0595–0.3114 × 10‒4 g/(s∙m)), Mn (0.0508–0.5994 × 10‒4 g/(s∙m)), and Sr (3.5427–12.4769 × 10‒4 g/(s∙m)), substantially affected water quality of the Yellow River. Health risk assessments indicated considerable hazards associated with TE-contaminated groundwater, with children being more vulnerable than adults. Spatially, TE enrichment and health risks were generally greater in the upper reaches than in the middle and lower reaches, while TE migration exhibited element-specific spatial variability. This integrated approach improves our understanding of TE cycling mechanisms mediated by river–groundwater interactions and provides scientific guidance for water resource protection and public health.}
}
@article{RABIEI2026135901,
title = {Deep learning-based downscaling of SMAP data for surface and root-zone soil moisture mapping},
journal = {Journal of Hydrology},
volume = {677},
pages = {135901},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135901},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009984},
author = {Saman Rabiei and Ebrahim Babaeian and Sabine Grunwald},
keywords = {Soil moisture, Deep learning, Downscaling, SMAP, SOLUS100},
abstract = {Accurate soil moisture (SM) information at sub-kilometer resolution is essential for hydrologic modeling, weather forecasting, precision irrigation, and drought monitoring. Satellite missions such as Soil Moisture Active Passive (SMAP) have transformed global SM monitoring, but their coarse resolution, shallow sensing depth, and multi-day revisit cycle limit local-scale applications. Retrieval accuracy further declines over dense vegetation and complex terrain. This study presents a deep learning downscaling framework that integrates convolutional neural networks and long short-term memory networks (CNN-LSTM) to produce daily SM maps at 100 m resolution for surface (5 cm) and root-zone (20 cm) depths. The model was trained with seven years of SM data from ∼ 650 stations across the U.S., using dynamic predictors from SMAP and MODIS (i.e., brightness temperature, roughness coefficient, surface reflectance in red, near-infrared, and shortwave infrared) and static features predictors from elevation, land cover, and Soil Landscapes of the U.S. (SOLUS100) databases. Compared to SMAP level-3 SM, the CNN-LSTM improved surface SM accuracy, with median correlation coefficient (R) increasing from 0.61 to 0.82, unbiased root mean square error (ubRMSE) decreasing from 0.06 to 0.05 cm3 cm−3, and Kling–Gupta Efficiency (KGE) increasing from 0.30 to 0.61. Root-zone SM achieved R ∼ 0.72, ubRMSE ∼ 0.05 cm3 cm−3 and KGE ∼ 0.53. The model also outperformed SMAP in forested and mountainous areas, capturing SMAP sub-pixel SM variability across the three well-instrumented watersheds and Florida. In Florida, where no training data was used, performance decreased but was still better than SMAP. These findings indicate that the CNN-LSTM framework bridges the spatial resolution gap in SM products and support small scale agricultural and hydrological applications.}
}
@article{TU2026135995,
title = {Global cropland expansion amplifies the risk of compound dry and hot events under climate change},
journal = {Journal of Hydrology},
volume = {677},
pages = {135995},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135995},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010929},
author = {Haiyang Tu and Guoyong Leng and Linfei Yu and Lei Yao and Jiali Qiu and Lubin Han},
keywords = {Compound dry and hot events, Cropland exposure, CMIP6, Severity levels, Food security},
abstract = {Compound Dry and Hot Events (CDHEs) pose significant threats to global food security, with their frequency and severity projected to escalate under future climate change. However, the combined impacts of climate change and cropland expansion on CDHEs exposure across varying severity levels remain underexplored globally. Using climate model projections from CMIP6 and dynamic cropland maps under four Shared Socio-economic Pathways (SSPs), we assess global cropland exposure to CDHEs, categorized into mild, moderate, severe, extreme, and exceptional severities, and identify key drivers. Our findings reveal a consistent increase in global cropland exposure to CDHEs under all future warming scenarios, with exceptional CDHEs contributing the most significant rise (50.86% increase by 2070–2099), followed by moderate (15.23%), severe (14.43%), extreme (13.79%), and mild (5.69%) events. Northern South America, Sub-Saharan Africa, and parts of Asia face the largest exposure increases, exacerbating vulnerabilities due to limited adaptation capacity. Attribution analysis indicates that climate change drives exposure increases under SSP1-2.6, SSP3-7.0, and SSP5-8.5, while cropland expansion is the primary driver under SSP2-4.5 (contributing 42.24% by 2070–2099). Crucially, the interaction term becomes increasingly important, contributing 15–25% by 2070–2099 and rising with CDHEs severity, as new cropland is expanding into areas where CDHEs are intensifying rapidly. These findings highlight the urgent need for targeted climate mitigation and adaptive land-use policies to reduce CDHEs risks, particularly in vulnerable regions, to safeguard global food production.}
}
@article{HAN2026135919,
title = {A critical evaluation of water balance in the Yellow River Source Region},
journal = {Journal of Hydrology},
volume = {677},
pages = {135919},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135919},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010164},
author = {Boya Han and Yuefei Huang and Shuo Zhang},
keywords = {The Yellow River Source Region, Multi-source data integration, Water-balance closure, Inter-basin groundwater flow},
abstract = {Most hydrological models assume that water is balanced within topographic basin boundaries, but this basin-closure assumption is rarely critically evaluated, especially in the Yellow River Source Region (YRSR). Here we evaluate water-balance closure for the YRSR upstream of Tangnaihai by combining two complementary lines of evidence: a multi-source water-balance diagnosis based on independent products of precipitation, evapotranspiration, observed runoff, and terrestrial water storage for 1984–2020, and a process-based modified abcd (Mabcd) simulation that explicitly represents groundwater storage and intercatchment exchange. Because uncertainties in precipitation, evapotranspiration, and storage change remain substantial, the exact annual imbalance cannot be robustly determined for individual years from the water-balance residual alone. We therefore focus on residual features that are consistent across product combinations, and with simulation results using the Mabcd model which independently reproduces the same seasonal structure and long-term tendency, and yields an interbasin groundwater-flow estimate of the same order of magnitude as the ensemble residual. Taken together, the diagnostic water-balance evidence and the process-based Mabcd results suggest that groundwater exchange is a plausible, but highly uncertain, explanation for the observed residual structure. These results therefore motivate explicit testing of groundwater exchange in YRSR water-resource models.}
}
@article{ZHANG2026136011,
title = {Pre-monsoon flow-path switching regulates downstream dissolved organic carbon dynamics in a high-alpine river on the Qinghai–Tibet Plateau},
journal = {Journal of Hydrology},
volume = {677},
pages = {136011},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136011},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601108X},
author = {Dong Zhang and Yindong Tong and Xiaodong Li and Yanli Sun and Jiajun Han},
keywords = {Hydrological connectivity, Flow-path switching, Stable isotopes, Pre-monsoon transition, Qinghai-Tibet Plateau},
abstract = {High-altitude semi-arid rivers undergo rapid hydrological reorganization during the pre-monsoon season, yet the respective roles of antecedent warming, initial thaw, and changes in hydrological connectivity in regulating the downstream export of dissolved organic carbon remain poorly understood. To clarify these controls, we conducted high-frequency monitoring at 3-day intervals in the Lhasa River Basin on the Qinghai-Tibet Plateau from March to early July 2024. Dissolved organic carbon (DOC), dissolved inorganic carbon (DIC), major ions, and stable isotopes (δ13C-DOC, δ13C-DIC, δD, and δ18O) were measured to trace water sources and carbon dynamics. Our results reveal a pronounced pre-monsoon hydrochemical turning point, driven primarily by seasonal flow-path switching rather than by direct glacier meltwater inputs. During the early pre-monsoon period (March–mid-May), river discharge was dominated by groundwater, and DIC and major ions increased gradually while DOC remained relatively low. Distinct hydrochemical and isotopic shifts occurred around mid-May, coinciding more closely with sharp increases in air temperature. After mid-May, the river transitioned to a more mixed hydrological regime, as indicated by marked shifts in water isotopes (δ18O: −17.0‰ to −14.5‰; d-excess: 9.3‰ to 13.5‰), declining DIC and major ion concentrations, increasing DOC concentrations (0.7–2.0 mg C·L−1), and progressively more depleted δ13C-DOC (−25.8‰ to −28.5‰) and δ13C-DIC values (−4.5‰ to −6.9‰). These coupled patterns suggest that antecedent warming and initial thaw preconditioned near-surface hydrological connectivity and reorganized flow paths, thereby increasing the DOC mobilization from shallow organic-rich source areas while diluting groundwater-derived DIC and major ions with low-solute near-surface waters, including thaw and snowmelt contributions. Comparisons with glacier-fed streams further indicate that glacier meltwater contributes only marginally to downstream DOC in the Lhasa River. Overall, our findings show that pre-monsoon carbon dynamics in this high-alpine river are controlled primarily by thermally driven hydrological switching superimposed on early-season thaw, highlighting the sensitivity of alpine carbon export to short-lived connectivity pulses on the Qinghai-Tibet Plateau.}
}
@article{HUANG2026136008,
title = {Decoding flood hazard responses to reticular river network changes using interpretable machine learning},
journal = {Journal of Hydrology},
volume = {677},
pages = {136008},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136008},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011054},
author = {Shanheng Huang and Peng Wang and Zulin Hua and Yueyang Dong and Rongxu Chen and Yawei Hu and Shimin Tian},
keywords = {Flood hazards, River network structure, Machine learning, Complex network},
abstract = {The structure of river networks critically governs flood propagation and hazard distribution, especially in reticular networks of low-lying delta plains where natural and engineered channels interweave. This study examines how structural changes in the Lixia River network—comprising both natural rivers and artificial canals—have influenced spatiotemporal flood hazard patterns from the 1960s to 2016. We developed a multi-index evaluation system based on complex network theory, representing river confluences and sources as nodes and channel segments as weighted edges characterized by length, width, and connectivity metrics. Hydrological-hydrodynamic modeling was employed to simulate water level dynamics under 100-year return period rainfall scenarios. Flood hazards were quantified using the Reliability-Resilience-Vulnerability framework, specifically measuring water level exceedance above warning thresholds. Interpretable machine learning methods were applied to identify key drivers of flood hazard distribution and their nonlinear relationships with network structure. Results demonstrate that river network restructuring significantly altered flood hazard patterns: hazards increased by 2.17%–5.01% from the 1960s to the 1980s, then declined but remained above 1960s baseline levels by 2016. Spatially, hazards concentrated in north-central regions with poor hydraulic connectivity, with centroids shifting westward by approximately 9.2 km. Network structural indices eccentricity and closeness centrality emerged as critical drivers comparable in importance to land use factors. Among topology‑based rehabilitation strategies, targeted dredging (capacity expansion) reduced flood hazards most effectively (mean improvement 7.95%), outperforming new channel construction (4.37%) and sluice‑gate optimization (1.74%). These findings provide quantitative guidance for structural rehabilitation in reticular river networks of low-lying plain regions.}
}
@article{REMMERS2026135931,
title = {Setting the standard? Comparison of the implementation of decision-support modeling standards in Australia and the Netherlands},
journal = {Journal of Hydrology},
volume = {677},
pages = {135931},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135931},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010280},
author = {J.O.E. Remmers and J.H.A. Guillaume and L.A. Melsen},
keywords = {Standardisation, Interviews, Modeling practice, The Netherlands, Australia},
abstract = {Choices during model development can substantially affect its outcomes, raising concerns about accountability when these outcomes inform decision-making. One way to address accountability is through modeling standards. Yet, standards may seem at odds with expert judgment and the specificity of modeling question, raising questions about who initiates the standards, and how they are established and enforced in practice. We examine the initiation, development and establishment of hydrological modeling standards in two contrasting cases: the development of standard software for the Murray-Darling Basin in Australia, and the formulation of modeling guidelines in the Netherlands. In both cases, standards were introduced with the aim to address elements of accountability. We found that consensus played a central role, which required flexibility in the standardization, diluting its effect. Moreover, standards tend to prioritize certain ways of working, risking that certain methods lose value without any apparent reason. Like models themselves, standardization is not neutral, demanding careful development, application, evolution, maintenance and reflection.}
}
@article{HUANG2026135943,
title = {A mechanistic water erosion–carbon model integrating the soil aggregate fractal dimension},
journal = {Journal of Hydrology},
volume = {677},
pages = {135943},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135943},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010401},
author = {Jinquan Huang and Yingtao Wu and Yi Zhu and Li Li and Wenjun Yang and Jigen Liu and Xiaolan Liu and Lu Zhang and Jiayu Liu and Jiapei Tian},
keywords = {Water erosion, Soil organic carbon, Aggregate fractal dimension, Carbon source–sink effect, Water erosion–carbon mechanistic model},
abstract = {Water erosion can serve as both a carbon source and a carbon sink in the global carbon cycle, but models often neglect soil structural dynamics, leading to biased soil organic carbon (SOC) transport predictions. We integrate soil aggregate fractal dimension (D) into water erosion–carbon model, combining controlled flume experiments with mechanistic simulations. The framework unifies aggregate protection, selective transport, threshold fragmentation, and dissolved organic carbon loss, with D as the key structural determinant of SOC dynamics. Under low-intensity erosion (0.16 m/s), runoff causes the selective removal of carbon-poor particles, resulting in a ∼ 9% enrichment in surface SOC concentration (g kg–1) (r = –0.86). However, mass balance consistency analysis reveals that this apparent increase is a concentration effect due to soil mass loss rather than a net carbon stock gain. In contrast, medium- to high-intensity erosion (≥ 0.24 m/s) causes aggregates breakdown and 25–30% SOC loss (r > 0.89). Our model delivers high prediction accuracy (R2 > 0.90), and sensitivity analysis confirms that D is the dominant parameter (S1 = 0.51; St = 0.83). Compared with empirical and process-based models, this approach greatly improves SOC prediction under dynamic erosion by explicitly distinguishes concentration effects from stock changes, providing a more credible interpretation of the system as a carbon source. We reveal that low-intensity erosion induces a transient enrichment of SOC concentration rather than a net carbon sink, whereas high-intensity erosion generates substantial carbon sources. Employing fractal dimension as a core predictor, our mechanistic model improves carbon cycle assessments and supports soil conservation and climate strategies.}
}
@article{LI2026136004,
title = {Exogenous dust-induced snow albedo reduction and radiative forcing over the Third Pole},
journal = {Journal of Hydrology},
volume = {677},
pages = {136004},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136004},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011017},
author = {Liang Li and Keqin Duan and Ting Yang and Yuhan Qi and Rong Chen and Peihong Shi},
keywords = {Snow albedo reduction, Radiative forcing, Third Pole, Dust},
abstract = {The evolution of snow over the Third Pole (TP) plays a critical role in amplifying changes in the Asian water tower. However, the quantitative contributions of exogenous dust to snow albedo reduction and radiative forcing over the TP remain largely unknown. Here, based on multi-source observations and numerical simulations of snow-darkening dynamic processes, this study systematically reveals the pronounced synchronicity and inverse coupling characteristics between dust and albedo changes over the TP, and quantifies the contributions of different exogenous dust to TP snow albedo reduction and radiative forcing. The results showed that exogenous dust-induced snow albedo reduction exhibited significant spatial heterogeneity, with core reduction regions concentrated in the northeastern TP and the southwestern slopes, where the regional mean albedo decrease exceeded 0.03 and locally surpassed 0.10. The dominant roles of different dust sources in snow darkening displayed significant spatiotemporal variability: dust from East Asia mainly affected regions below 3 km elevation of the north TP; dust from southwestern Asia and North Africa contributed 68.9% ± 22.2% and 20.9% ± 20.4%, respectively, to snow darkening in the central-western Himalayas, jointly dominating the snow darkening process in this region; whereas snow albedo reduction in the Pamir region was primarily influenced by dust from southwestern Asia and Central Asia, with Central Asian dust slightly prevailing during July–August. Exogenous dust deposition significantly enhanced the absorption of solar radiation by snow, generating total snow radiative forcing that generally exceeded 10 W m⁻2 in the major ice-snow covered regions. Among these effects, exogenous dust regulated the snow surface renewal process by altering snowfall frequency and snowfall amount, and the radiative forcing corresponding to this indirect regulatory pathway ranged from −7.6 to −1.3 W m⁻2. Meanwhile, exogenous dust also affected surface downward radiative fluxes by altering cloud-phase distribution, producing cloud-phase-related radiative forcing of approximately 0.3–0.69 W m⁻2. This study provides new quantitative perspectives and references for understanding the impacts of exogenous dust on the snow energy balance and hydrological processes over the TP.}
}
@article{RAJWAKULIGIEWICZ2026135959,
title = {Hydrological drivers of silicate weathering in snow-dominated alpine headwater catchments with variable forest cover (Tatra Mountains, Western Carpathians)},
journal = {Journal of Hydrology},
volume = {677},
pages = {135959},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135959},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010565},
author = {Agnieszka Rajwa-Kuligiewicz and Artur Kuligiewicz and Marek Duliński and Kazimierz Różański},
keywords = {Silicate weathering, Transient timemodeling, Chemical denudation, Isotopes, Mountains},
abstract = {This study quantifies silicate weathering rates (SWR) and carbon dioxide capture rates (CCR) in mid-latitude mountains with seasonal snow cover, with particular focus on snowmelt-driven weathering and vegetation effects. The study was conducted in headwater catchments within the crystalline core of the Tatra Mountains (Carpathians), which share similar lithology but differ in forest cover and disturbance history. The study combined geochemical modeling with isotope-based analyses, including mean transit time (MTT) estimation using stable water isotopes and tritium, together with mixing–splitting analysis. The tritium-derived MTT was ∼3.7 years, reflecting dominant winter baseflow conditions, whereas MTT estimated from the sine-wave method yielded much shorter times (0.4–2.4 years), likely due to stronger relative contribution of shorter flow paths. Mean SWR ranged from 5.19 ± 0.14 t/km2/yr to 7.60 ± 0.29 t/km2/yr, while CCR ranged from 2.58 ± 0.23 × 104 to 3.76 ± 0.33 × 104 mol/km2/yr. The results indicate a kinetically limited weathering regime in which reaction kinetics and MTT exert stronger controls on weathering fluxes than discharge or catchment area. SWR and dissolution rates varied among catchments, with the forested catchment exhibiting higher weathering rates, longer MTT, lower young water fractions, and greater contribution of winter precipitation to summer discharge. Mean annual evapotranspiration (ET) ranged from ∼42% in the mature forest to ∼60% in the regenerating stand. Because summer precipitation with a relatively high 18O/16O ratio was preferentially lost to ET, the isotopic composition of water contributing to weathering was biased towards winter precipitation with a relatively low 18O/16O ratio.}
}
@article{MOHAMED2026135970,
title = {Catchment controls on nutrients at coastal outlets: a national typology for England and Wales},
journal = {Journal of Hydrology},
volume = {677},
pages = {135970},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135970},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601067X},
author = {Hassan Mohamed and Naomi Greenwood and Richard J. Cooper and Carolyn Graves and Yi He},
keywords = {Catchment typology, Nutrients, Hydrogeology, Land use, Nutrient transport pathways, OSPAR},
abstract = {Riverine nutrient concentrations at coastal outlets reflect upstream catchment controls and underpin nutrient flux estimates. Existing catchment classifications are not tailored to this scale, limiting their application for interpreting land-to-sea patterns and informing management of marine pressures. This study develops a data-driven typology for 178 coast-draining catchments across England and Wales, grouping them into eight types through geospatial characterisation and clustering. Nutrient concentrations (2000–2024) were retrieved from water quality archives at 271 near-tidal sites. The resulting typology is structured along a topographic gradient, further differentiated by dominant bedrock permeability. A two-way analysis of variance (ANOVA) confirmed significant differences between types for NH4+, NO3− and PO43− (p < 0.001), with a significant seasonal effect for NO3− and PO43− only. NO3− exhibited strong seasonality in arable lowland low- and high-permeability catchments where winter medians (8.8 and 8.4 mg N/L) exceeded summer values (5.1 and 6.4 mg N/L), reflecting enhanced leaching. NH4+ showed limited seasonality, with variability governed by point-source inputs. PO43− displayed an inverse seasonal pattern, with higher summer concentrations from reduced dilution of point-source inputs. Despite representing only 1% of the total catchment area, the urban type dominated NH4+ and PO43− concentrations, peaking in winter for NH4+ (0.176 mg N/L) and summer for PO43− (0.51 mg P/L), while NO3− was controlled by arable types, with increasing urban influence in recent years. These results provide a framework for targeting nutrient management to the dominant controls of each type, supporting more effective nutrient reduction measures under the UK Marine Strategy and OSPAR commitments.}
}
@article{HU2026135991,
title = {Characterizing spatiotemporal drought dynamics in the Yangtze River Basin: from event lifecycle to shifting climate drivers},
journal = {Journal of Hydrology},
volume = {677},
pages = {135991},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135991},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010887},
author = {Ruiyang Hu and Ziyan Shi and Shanshui Yuan},
keywords = {Meteorological drought, Standardized Precipitation Evapotranspiration Index, Spatiotemporal variation, Climate factors, Yangtze River Basin},
abstract = {The Yangtze River Basin is a critical agricultural and economic zone in China, where drought significantly impacts socioeconomic development. With the intensification of global warming, droughts in the Yangtze River Basin are expected to become more severe and frequent. However, the spatiotemporal dynamics of these droughts and the relative impacts of changing water supply (precipitation) and demand (evapotranspiration) remain poorly quantified. This study analyzes the spatiotemporal characteristics of meteorological drought events in the Yangtze River Basin using a three-dimensional clustering algorithm and examines the influence of climatic factors on the occurrence and development of droughts. Our results show a clear trend since the 21st century towards longer duration, larger area, and higher severity droughts, which are increasingly concentrated in the central basin. While PRE trends still dominate drought changes in 56% of the YRB under the PET formulation adopted, rising evaporative demand has increasingly influenced over the remaining 44%, indicating a shift in regional hydroclimate drivers.}
}
@article{KAUNDAL2026135967,
title = {Sequential estimation of aquifer parameters using water table elevations},
journal = {Journal of Hydrology},
volume = {677},
pages = {135967},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135967},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010644},
author = {Ankush Kaundal and Sekhar Muddu},
keywords = {Groundwater, Aquifer parameters, Water table fluctuation method, GLUE, Specific yield, Groundwater recharge},
abstract = {Groundwater level time series contain valuable information about aquifer storage properties and the external source–sink terms to which aquifer systems are subjected. However, estimating these source–sink terms from water table fluctuations remains challenging due to the difficulty of quantifying specific yield at the field scale and uncertainty associated with it. Strong correlations among recharge, pumping, and specific yield further complicate inference; without explicit uncertainty quantification, water table fluctuation-based models are prone to parameter non-uniqueness and substantial uncertainty propagation. Moreover, such models are commonly calibrated by estimating all parameters simultaneously, and the relative performance of simultaneous versus sequential parameter estimation for reliable parameter recovery has not been systematically investigated in such models. In this study, we develop an inverse modelling framework to quantify parameter uncertainty and correlation in water table fluctuation-based groundwater models and to assess whether sequential, iterative parameter estimation yields more reliable recovery of aquifer parameters than conventional simultaneous estimation. The methodology is first tested using synthetic water table fluctuations generated with known model parameters, enabling direct comparison between simultaneous and sequential estimation strategies. Simultaneous estimation exhibits strong equifinality and large errors, particularly in recharge and inferred pumping (up to 110%), whereas the sequential approach markedly improves parameter identifiability and recovers recharge, pumping, and specific yield with mean errors below 13%. The framework is subsequently applied to groundwater-level time series from 73 field borewells, demonstrating its ability to recover physically plausible aquifer parameters and groundwater forcings. The results further show that the framework can diagnose model structural errors, particularly those arising from neglecting groundwater abstraction when it is present. Leveraging millions of simulations executed using parallel processing, the approach efficiently addresses key uncertainties in water table fluctuation–based models and provides a practical means of inferring aquifer parameters and forcings directly from groundwater observations.}
}
@article{SEIFI2026135927,
title = {Reducing undercatch in the Geonor snow gauge using CFD-based shield design modification},
journal = {Journal of Hydrology},
volume = {677},
pages = {135927},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135927},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010243},
author = {Sadra Seifi and Jeffery Hoover and Pierre E. Sullivan},
keywords = {Precipitation gauge, Snow measurement, Wind-induced undercatch, Wind updraft, CFD–DPM, Shield design},
abstract = {Wind-induced undercatch remains a major source of bias in snowfall measurements for catchment gauges used in solid precipitation. Most previous studies address this bias using empirical post-measurement corrections, whereas fewer attempts have been made to reduce the underlying aerodynamic causes through shield design. This study examines whether modest modifications to the slat-edge geometry of the single-Alter shield used with a Geonor T200B gauge can improve snowfall collection under windy conditions. A validated three-dimensional steady RANS–Lagrangian particle-tracking model is used to simulate snow particles with diameters of 0.25–5.0 mm under ambient horizontal wind speeds of 1–7 m/s. The unshielded gauge is included as a reference baseline for interpreting the aerodynamic effect of shielding. The results show that near-orifice updrafts and energetic vortical structures are the main flow features responsible for particle deflection. Among the tested geometries, the configuration with a slat-edge angle of β=15∘ most effectively reduces the updraft while avoiding excessive local turbulence, increasing the overall collection efficiency averaged over the simulated wind-speed range by 11.9% relative to the standard single-Alter shield, with gains of up to 27.0% at the highest ambient wind speeds considered. Particle-deposition patterns also shift from the windward to the leeward slat surfaces; this matters because it may reduce leading-edge icing and help preserve aerodynamic performance during operation.}
}
@article{CAO2026135979,
title = {Biocrust functions in mitigating soil water and wind erosion after freezing-thawing},
journal = {Journal of Hydrology},
volume = {677},
pages = {135979},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135979},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010760},
author = {Yousong Cao and Yunxia Shen and Joshua Heitman and Bo Xiao},
keywords = {Biological soil crust, Aggregate stability, Splash erosion, Runoff scouring, Loess Plateau, Global warming},
abstract = {Freezing-thawing regulates soil structural stability in cold winters, and further governs soil responses to water and wind erosion during subsequent warm seasons. As multifunctional communities widespread in cold-winter drylands, biocrusts have been found to influence soil erosion. However, the specific mechanisms remain unclear. Particularly, previous studies have largely overlooked freezing-thawing, which is a critical prerequisite for water and wind erosion over the annual cycle. Here, we subjected biocrust and bare soil samples to 10–30 freezing-thawing cycles at varying antecedent moisture (0.15–0.35 cm3 cm−3), and then assessed their resistance to single raindrop splash, rainfall splash, runoff scouring, and wind erosion. After freezing-thawing, biocrusts exhibited 19.4%–61.9% higher raindrop penetration kinetic energy than bare soil, accompanied by a 16.2%–87.5% reduction in splash erosion amounts from both single raindrop and rainfall tests. Biocrusts also diminished the splash distance of soil particles by 5.4%–13.9%. Furthermore, after freezing-thawing, biocrusts increased the anti-scour coefficient of surface soil by 342%–1329% and decreased its detachment capacity by 77.0%–93.0%, thereby ultimately reducing the sediment yield. Moreover, after freezing-thawing, the wind erosion amount of biocrusts was much lower (3.14–12.58 g m−2) than that of bare soil (187–6144 g m−2). In essence, the erosion resistance of biocrusts after freezing-thawing mainly originated from their high structural stability, particularly higher macroaggregate content. Our study highlights the importance of biocrusts in soil protection after freezing-thawing, which could have broader potential implications for erosion-driven greenhouse gas emissions and ecosystem productivity in cold-winter drylands.}
}
@article{CIMORELLI2026135922,
title = {A general two-dimensional analytical solution for solute transport in anisotropic porous media with time-varying velocity field, different contaminant sources, and initial contamination},
journal = {Journal of Hydrology},
volume = {677},
pages = {135922},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135922},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601019X},
author = {Luigi Cimorelli and Andrea D’Aniello},
keywords = {Solute transport, Anisotropy, Off-diagonal dispersion, Green’s function, Analytical model},
abstract = {This study presents a novel two-dimensional analytical solution for solute transport in homogeneous porous media accounting for the effects of anisotropy in presence of adsorption and decay. The solution is derived using Green’s function for an infinite domain and extends existing analytical formulations by relaxing several simplifying assumptions commonly adopted in literature. In particular, the proposed analytical solution accounts for the effects of mechanical dispersion along the non-principal direction of groundwater flow as well as for the dependency of the dispersion tensor on the actual groundwater velocity field, without simplifications or convenient orientations of the model domain. The solution is also general as allows to account for: i) bi-directional groundwater velocity field and its variation over time; ii) source terms of different geometries (e.g., point, line, and surface sources) and temporal variability; iii) general initial concentration distributions of the contaminant concentration. The proposed analytical solution is also tested over benchmark problems conceived with a well-known numerical model for flow and transport in porous media (COMSOL Multiphysics®), and the agreement between the two is excellent.}
}
@article{MORETFERNANDEZ2026135951,
title = {Spatial and temporal indicators of soil hydrodynamic response: the capillarity-gravity length and gravimetric time},
journal = {Journal of Hydrology},
volume = {677},
pages = {135951},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135951},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010486},
author = {D. Moret-Fernández and J. Tormo and J.J. Jiménez and B. Latorre},
keywords = {Saturated hydraulic conductivity, Tension disc infiltrometer, Gravity-dominated flow, Land use impact, Infiltration dynamics, Aridity gradients, Soil compaction},
abstract = {Understanding the dynamics of soil water movement is fundamental for hydrological research. This work uses two complementary indicators based on different relationships between the sorptivity, S(θi, θs), and the saturated hydraulic conductivity (Ks) to predict the hydrodynamic response of porous media. These indices are the gravimetric time (tgrav) and the index defined as capillarity-gravity length, λθi,θs=Sθi,θs2Ks. The parameter λθi,θs, which is theoretically derived from the soil water retention curve, acts as a characteristic length that quantifies the equivalent water depth absorbed via capillarity during the infiltration process before the flow rate converges toward a constant, gravity-driven steady state. By evaluating the balance between capillary and gravity flows, both tgrav and λθi,θs provides an assessment of the dominant hydrodynamic behavior of a porous medium based on simple tension disc infiltrometer measurements. Specifically, when gravity-driven flow dominates (low Sθi,θs2 and high Ks), λθi,θs and tgrav tends below 1 cm and 250 s, respectively, whereas capillary-dominant flow (high Sθi,θs2 and low Ks) is reflected by λθi,θs and tgrav values exceeding 3 cm and 2500 s, respectively. Both parameters were evaluated across a diverse range of porous media and subsequently contrasted with their corresponding cumulative infiltration curves. Then both indices were assessment through two field experiments. The first experiment compared λθi,θs and tgrav measured at the soil surface across two regions with different aridity gradients. The second experiment assessed the soil matrix hydrodynamics across different soil managements. Analytical derivations showed that λθi,θs defines the y-intercept of the long-term 1D infiltration function and both λθi,θs and tgrav are sensitive to detect hydrodynamic differences between porous media, soil types, and management practices.}
}
@article{LUO2026135986,
title = {A novel high-resolution downscaling method for daily extreme precipitation using Sentinel-5P cloud parameters},
journal = {Journal of Hydrology},
volume = {677},
pages = {135986},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135986},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010838},
author = {Yuting Luo and Hongwei Zeng and Junbin Li and Yang Chen and Jiangyuan Zeng and Miao Zhang and Hantian Wu and Lu Sun and Bingfang Wu},
keywords = {CHM_PRE V2, Daily extreme precipitation, Statistical downscaling, DGD, Sentinel-5P, Cloud physical parameters},
abstract = {Statistical downscaling of daily extreme precipitation remains challenging due to the limited availability of optical observations during rainfall events, delayed vegetation responses to precipitation, and the coarse resolution of soil moisture and reanalysis-based predictors. To address these limitations, this study proposed a cloud variable based DeepGeo Downscaler (DGD) framework for daily extreme precipitation downscaling. The DGD used daily cloud physical parameters derived from Sentinel-5P as physically meaningful and near real time predictors and employed a hybrid of convolutional neural network (CNN) and geographically weighted regression (GWR) to explore the complex nonlinear relationship between environmental variables and extreme precipitation. The DGD framework was applied to downscale the CHM_PRE V2 daily precipitation product from 0.1° to 0.01° for an extreme rainfall event from August 2 to 6, 2023 in the black soil region of Northeast China and an unprecedented extreme precipitation event in Zhengzhou from July 17 to 22, 2021. Compared with random forest (RF), extreme gradient boosting (XGB), artificial neural network (ANN), GWR, CNN, and hybrid models including GWR-RF (GWRF) and GWR-XGB (GXGB), DGD achieved the best overall performance. DGD reduced the overestimation of light precipitation and underestimation of heavy precipitation while substantially suppressing the “boxy” artifacts commonly observed in RF, XGB, GWRF, and GXGB based results. Compared with the original CHM_PRE V2 product, the final downscaled results from DGD substantially enhanced the spatial detail of the original CHM_PRE V2 product while maintaining similar accuracy against rain gauge daily precipitation observations. Overall, the results indicate that the DGD framework driven by Sentinel-5P cloud physical parameters provides an effective approach for daily extreme precipitation downscaling, with potential applications in flood forecasting, hydrological modeling, and agricultural risk assessment.}
}
@article{FORD2026135973,
title = {Time-series decomposition and stream metabolism reveal benthic control on particulate organic carbon transport from mixed-use Appalachian watersheds},
journal = {Journal of Hydrology},
volume = {677},
pages = {135973},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135973},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601070X},
author = {William I. Ford and James Fox and Mindy Armstead and Andrea Erhardt},
keywords = {Particulate organic carbon, Mixed-use watersheds, Sediment transport, Time-series analysis, Regulated river},
abstract = {Algal carbon can be a significant energy source in stream ecosystems; however, knowledge is lacking regarding algal contributions to particulate organic carbon (POC) fluxes from mixed-use stream ecosystems and their potential implications for downstream waterways. We report a new four-year transported carbon elemental and isotopic dataset from a predominantly forested stream ecosystem in northwestern West Virginia, USA, carry out time series decomposition of the data, and compare our results to algae monitoring and ecosystem modelling to better understand the influence of algal carbon on these systems. Results show that variational mode decomposition (VMD) was more effective than empirical mode decomposition (EMD) for detecting in-stream process impacts on POC transport in the forested stream. Results from ecosystem modelling and significant modes from VMD point to benthic algal growth followed by heterotrophic stabilization resulting in residual algal C transport from the watershed during storm events as POC. The importance of the time lag and then carbon flux introduced by the algal stabilization process extends this paradigm to be inclusive of both open-canopied systems studied previously and predominantly closed-canopy systems, such as the one studied here. Contrary to results from open-canopy systems, the mixed-use Appalachian stream shows dual-peaks of algal carbon conveyance, starting in late winter-spring and again in late-summer to mid fall. Results provide evidence that mixed-use watersheds in Appalachia provide periodic contributions of labile POC enriched in algal C to the Ohio River, USA and thus merit further study regarding potential impacts on eutrophication and harmful algal blooms in the regulated rivers.}
}
@article{MOORE2026135994,
title = {Tracing hydrogeological sources of spring discharges to peat-forming bofedales in the Peruvian Andes},
journal = {Journal of Hydrology},
volume = {677},
pages = {135994},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135994},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010917},
author = {Henry E. Moore and Alexander Avelar and Joaquin Cambeiro and Kristina Keating and Margaret Lang and Jasper Oshun},
abstract = {Peat-forming bofedales are unique environments found at high altitudes across the Peruvian Andes that provide critical ecosystem services such as sustaining streamflow to downslope communities. As limited studies have attempted to address seasonally dynamic groundwater flow from springs, we conducted a hydrogeophysical investigation to characterize and quantify specific discharges from springs over two weeks following the ‘wet-up’ period of two hydrogeologically distinct bofedales in the Upper Ramuschaka Watershed (Cusco, Perú). Handheld thermal infrared imagery and specific conductivity measurements were used to locate springs across the bofedales. Specific groundwater discharge rates were quantified with vertical temperature profilers installed in the springs. Ground-penetrating radar transects supported by coring revealed localized patterns in bedrock structure controlling peat thickness. Imaginary conductivity (σ"), and electrolytic conductivity (σel), derived from time domain induced polarization, showed heterogenous deep bedrock structures around the springs and estimated the distribution of ionic fluid in the subsurface sourcing the springs. Hydrogeophysical results indicate three distinct spring types, which inform a conceptual model connecting the spring hydrology to underlying hydrogeological structure. This study examines the importance of bofedal springs in maintaining peat resources essential for the water resiliency of downstream communities.}
}
@article{SHEN2026136001,
title = {A four-decade satellite record of coupled lake area and water quality responses to climate changes and human activities in Northwest China},
journal = {Journal of Hydrology},
volume = {677},
pages = {136001},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136001},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601098X},
author = {Ming Shen and Yuan Liu and Tianci Qi and Changjiang Liu and Zhigang Cao and Zhenyu Tan and Juhua Luo and Hongtao Duan},
keywords = {Remote sensing, Arid area, Xinjiang lakes, Water quantity and quality, Climate warming},
abstract = {Understanding the coupled dynamics of lake (including natural lakes and reservoirs) water quantity and quality remains scarce, both regionally and globally. This study establishes a novel remote sensing–based framework to assess coupled lake quantity–quality dynamics, represented by lake area and Secchi disk depth (SDD), and to classify lakes into four ecological–hydrological trajectories (Types I–IV). Applying this framework to Landsat imagery (1986–2023) across 729 lakes (>1 km2) in Xinjiang, China. We found that lakes generally experienced area expansion and improved clarity (Sen’s slope > 0, p < 0.05). Type I (+SDD, +Area) was the dominant trajectory, accounting for 54.87% of the lakes, followed by Type III (−SDD, +Area, 21.95%) and Type II (+SDD, −Area, 15.36%), while Type IV (−SDD, −Area, 7.82%) was the least common. Regionally, significant increases in both metrics occurred in northern and southern Xinjiang (Sen’s slope > 0, p < 0.05), whereas trends in eastern Xinjiang were non-significant (p > 0.1). Partial least squares regression (PLSR) revealed that temperature and cropland area were the primary drivers in northern and southern Xinjiang, reflecting the joint impacts of climate change and human water use and management. Conversely, precipitation and the Palmer Drought Severity Index (PDSI) dominated in eastern Xinjiang, suggesting local hydroclimatic variability may offset the benefits of warming-induced glacier/snowmelt. This conceptual framework successfully links lake water quantity and quality, providing a scalable baseline for comprehensive lake assessments and sustainable water-resource management under climate change.}
}
@article{SOLGI2026135946,
title = {Climate change and irrigation water demand: a review of modelling approaches and biophysical considerations},
journal = {Journal of Hydrology},
volume = {677},
pages = {135946},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135946},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010437},
author = {Shahin Solgi and Paul R. Petrie and Matthew J. Knowling and Ana Horta and Andrew Hall},
keywords = {Irrigation water demand, Climate change, Projection, CO, Phenology},
abstract = {Rising temperatures, shifting precipitation patterns, and elevated atmospheric CO2 concentrations are expected to influence future irrigation water demand (IWD) through complex interactions with crop growth and evapotranspiration processes. These biophysical dynamics are required for generating reliable seasonal and long-term projections under climate change. This systematic literature review analysed 80 peer-reviewed studies published between 2017 and 2024 to evaluate the methods used for projecting IWD under future climate scenarios. Due to differences in study design, model assumptions, and reporting formats, formal statistical comparison was not feasible. Instead, this review used evidence mapping to summarise the distribution and characteristics of the selected studies. Trends were identified for methodology, crop focus, and regional variation. maize, wheat, and rice dominated the research, collectively representing 70% of the studied crops. Although 40% of studies employed process-based simulation (PS) approaches, potential evapotranspiration (ET-P) methods were the most widely applied, used for 52% of the crops examined. Approximately 53% of studies projected an increase in IWD, 13% a decrease, and 28% reported mixed trends, depending on crop type, region, and scenario. Despite the relevance of CO2 fertilisation and climate-induced phenological changes, only 14% of studies accounted for both, with most incorporating either one or neither. The findings indicate that, despite the increasing complexity of PS models, simpler approaches such as ET-P and irrigation scheduling (Sch) continue to be widely used due to their lower data and resource demands. These methods potentially overlook crucial climate-sensitive processes, which may introduce bias into IWD projections. This review highlights how methodological choices can influence long-term projections of climate change impacts. The recommended research roadmap in this review would guide future studies to compare different IWD projection methodologies under identical climate, crop, soil, and crop/irrigation management conditions to achieve more robust and reliable projections and decision-making tools.}
}
@article{CHEN2026135978,
title = {Hydroclimatic variability challenges apparent decadal improvements in riverine water quality across coastal watersheds},
journal = {Journal of Hydrology},
volume = {677},
pages = {135978},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135978},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010759},
author = {Shengyue Chen and Jinliang Huang and Ruping Zheng and Shijie Jiang},
keywords = {Coastal riverine environment, Water quality improvement, Potential drivers, Watershed management, Deep learning},
abstract = {Coastal riverine environments face escalating degradation under dual climatic and anthropogenic pressures, yet high-resolution, systematic assessments remain constrained by spatiotemporally fragmented observations. Here we present a coupled deep-learning framework to robustly reconstruct daily runoff alongside multi-species pollutant concentrations and fluxes during 2010–2024 across 132 riverine sites in a representative coastal province of China. The reconstructed high-fidelity datasets reveal acute vulnerability in coastal regions and headwater systems, where intense anthropogenic stressors coincide with restricted dilution capacities. Over the past 15 years, riverine concentrations of total phosphorus, ammonia nitrogen, and permanganate index generally declined, whereas total nitrogen exhibited an upward trajectory; runoff reductions, concurrently, moderated downstream pollutant exports. Interpretable machine learning identifies urbanization, agriculture, runoff, and temperature as primary impacting factors of spatial variability in water quality baselines and trends. Critically, hydroclimatic shifts exert a stronger signature on long-term pollutant trends than human interventions alone, implying that the efficacy of current management interventions is likely overestimated due to natural climate variability over-amplification. This hydroclimatic non-stationarity is further manifested across interannual and event scales, where storm-induced pollutant pulses temporarily reverse decadal restoration gains. Our findings highlight the necessity of integrating hydroclimatic non-stationarity into watershed management, advocating for dynamic, targeted interventions in pollution hotspots and during high-flow periods to guarantee sustainable water security.}
}
@article{MELES2026135954,
title = {HYDRO-XM: a computationally efficient, externally coupled, and flexible watershed model},
journal = {Journal of Hydrology},
volume = {677},
pages = {135954},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135954},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010516},
author = {Menberu B. Meles and A.T.M. {Sakiur Rahman} and Jiří Šimůnek and Hoori Ajami and Carl L. Unkrich and Juan S. Acero Triana and Jason Goulding and Scott A. Bradford},
keywords = {Coupled model, HYDRUS, MODFLOW, KINEROS, HYDRO-XM, Computational efficiency, ParFlow},
abstract = {Numerical simulation of watershed processes requires capturing the spatial and temporal dynamics of water movement, storage, and redistribution across surface and subsurface domains. We present HYDRO-XM, a computationally efficient, modular framework that couples three open-source models: KINEROS2 (K2) for overland and channel flow, HYDRUS-1D (H1D) for variably saturated flow in the unsaturated zone, and MODFLOW-5 (MF5) for saturated groundwater flow. The framework represents a watershed as a network of interconnected planar surface elements, channels, and storage units. Each surface element links to an H1D soil profile, which evaluates whether excess rainfall leads to runoff, receives information on ponded water available for infiltration from K2, and returns time-varying recharge fluxes to MF5. K2 solves the one-dimensional kinematic wave equation for surface and channel flow at event scale; H1D solves the Richards equation for vertical unsaturated flow; and MF5 computes three-dimensional saturated groundwater flow. HYDRO-XM replaces K2′s native Smith-Parlange infiltration scheme with Richards equation–based solutions from H1D, passing bottom-boundary fluxes to MF5 as distributed source/sink terms, allowing a continuous representation of water fluxes across the vadose zone–groundwater continuum within a fully coupled modeling framework. Key innovations include dynamic boundary-condition switching, which allows surface soil-column boundaries to transition automatically between flux-controlled and head-controlled states as saturation changes, adaptive time-stepping, dimensionality reduction, and parallelization that increases computational speed while preserving process fidelity. These features enable stable, continuous simulation of overland flow, channel flow, infiltration, soil moisture redistribution, and groundwater dynamics across full watershed domains. Benchmark cases using both idealized hypothetical domains and observed data from the Walnut Gulch Experimental Watershed show strong agreement with ParFlow, an integrated hydrologic model, outputs and field observations. Performance metrics ranged from NSE = 0.62–0.98, KGE = 0.24–0.93, and R2 = 0.85–0.99 compared to observed streamflow, with water-balance errors below 3.4%. HYDRO-XM ran up to 28.4 times faster than a comparable ParFlow configuration. This framework provides a tractable tool for evaluating managed aquifer recharge, predicting hydrologic responses, and quantifying watershed-scale impacts of land-use change and climate variability.}
}
@article{PLUTOVA2026136012,
title = {The impact of seasonal hydroclimatic variability and vegetation dynamics on long-term nutrient trends − Evidence from an agriculture-dominated watershed draining to the Baltic Sea},
journal = {Journal of Hydrology},
volume = {677},
pages = {136012},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136012},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011091},
author = {Beata Plutova and Carlos Gonzales-Inca and Elham {Kakaei Lafdani} and Iiro Seppä and Elina Kasvi and Maria Kämäri and Petteri Alho and Ville Kankare},
keywords = {Nitrogen, Phosphorous, Hydroclimatic variability, Vegetation dynamics, Seasonal patterns},
abstract = {Excess nutrient loads, particularly nitrogen (N) and phosphorus (P), play a significant role in the degradation of global water quality and aquatic ecosystems. The amount of these nutrients in rivers is significantly affected by the increasing hydroclimatic variability, coupled with changes in land use intensity. This study assessed trends over 30 years in total nitrogen (TN) and total phosphorus (TP) in the Aurajoki catchment, Southwest Finland, and evaluated how land use intensity and seasonal hydroclimatic variability influence nutrient dynamics. The utilized data consisted of long-term monitoring records of nutrient concentrations, discharge, temperature, precipitation, and the Landsat imagery series. Prior to the analyses, the Standardized Precipitation Index (SPI), Accumulated Winter Season Severity Index (AWSSI), and Normalized Difference Vegetation Index (NDVI) were used to characterize hydroclimatic variability and land use intensity. Data were analyzed using Mann-Kendall statistics to assess trends and generalized additive mixed models (GAMMs) to evaluate the impact of land use intensity and hydroclimatic variability. Results showed a decrease in annual TN concentrations and TN loads, while TP trends remained stable. The seasonal trend test revealed significant TN and TP increases in fall and decreases in spring. The modelling results revealed that NDVI had a significant impact only on nutrient concentrations, whereas the effects of hydroclimatic class were limited to nutrient loads and varied according to different combinations of season and NDVI. These findings highlight the relevance of seasonal hydroclimatic variability and land use intensity when assessing nutrient dynamics, particularly in the context of climate change and water protection strategies.}
}
@article{PULKAPETZOLT2026135888,
title = {Assessment of Sentinel-1 C-band SAR snow depth assimilation in operational hydrological modeling of high-alpine catchments},
journal = {Journal of Hydrology},
volume = {677},
pages = {135888},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135888},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009856},
author = {T. Pulka-Petzolt and C. Ehrendorfer and H. Lievens and F. Koch and K. Schulz and H. Formayer and F. Avanzi and M. Girotto and M. Herrnegger},
keywords = {Data assimilation, Sentinel-1 snow depth retrievals, Operational hydrological modeling, Precipitation correction, Mountain hydrology},
abstract = {Monitoring and forecasting mountainous runoff is essential, as snowmelt provides vital freshwater resources while also posing flood and drought risks to downstream regions. However, spatiotemporal modeling of the high-alpine snowpack remains challenging, due to shortcomings in its process-based descriptions and substantial deficits in input data of operational hydrological models. To address this issue, we evaluate the potential of assimilating 500 m resolution Sentinel-1 C-band Synthetic Aperture Radar (SAR) snow depth retrievals in operational hydrological modeling of several high-alpine catchments in Austria. We first evaluated the Sentinel-1 snow depth product with ground-based measurements from 27 AWS (automatic weather stations) in Austria (r = 0.88, MAE = 22.3 cm) and annual photogrammetric snow depth surveys in the Dischma catchment in Switzerland (r = 0.72, MAE = 69 cm). We then forced the conceptual semi-distributed hydrological model COSERO with the 1 km2 gridded meteorological INCA product, which are both operationally used for hydropower and flood forecasting, and modeled thirteen high-alpine catchments in Austria between 2016 and 2024 at 500 m spatial and hourly temporal resolution. The assimilation of Sentinel-1 snow depths substantially improved overall model performance relative to modeling with uncorrected INCA data. For the entire 2016–2024 modeling period, this improvement is indicated by a median increase in NSE by 9.9% (0.75 to 0.82) and KGE by 34.1% (0.62 to 0.83), and a reduction in the median runoff deficit from −23.1% to −3.9%. The data assimilation in the operational modeling setup proved more effective during snow-poor years, a finding that may become more relevant under an increasingly warming climate in the European Alps. The Sentinel-1 snow depth product showed good agreement with ground measurements and snow cover maps (MODIS). Its assimilation remedied the winter precipitation deficit in INCA, while improving spatiotemporal snowpack simulation and enhancing snowmelt runoff prediction. This more realistic representation of the mountainous snowpack may benefit simulation of other hydrological variables including evapotranspiration, soil moisture, and groundwater recharge. The approach also shows promise for modeling remote, ungauged basins globally. These results demonstrate the value of integrating satellite-derived snow information for operational alpine hydrological modeling and water resource assessment.}
}