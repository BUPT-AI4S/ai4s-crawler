@article{HUANG2026136608,
title = {Machine learning-enhanced joint inversion of GNSS, InSAR, and GRACE for terrestrial water storage reconstruction in the Three Gorges reservoir region},
journal = {Journal of Hydrology},
volume = {681},
pages = {136608},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136608},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017051},
author = {Liangke Huang and Tianci Feng and Tengxu Zhang and Lin He and Lilong Liu and Yu Xia and Wenhao Wu and Peng Yuan and Peijie Zhu and Xiaohan Guo},
keywords = {Terrestrial water storage, Joint inversion, Spatial downscaling, Machine learning, Three Gorges Region},
abstract = {Accurately quantifying terrestrial water storage (TWS) dynamics is essential for understanding regional hydrological processes, especially in areas with complex topography and intense human interventions. However, monitoring TWS at sub-basin scales remains challenging due to the coarse resolution of satellite gravimetry (GRACE/GFO) and the spatial sparsity or baseline absence of ground/radar geodetic measurements. To overcome this, we propose a physics-constrained and data-driven joint inversion framework to reconstruct TWS at 0.5° resolution in the Three Gorges Region (TGR). An Extreme Gradient Boosting (XGBML) model, driven by hydrometeorological variables, is employed to downscale discrete GNSS and InSAR deformations into a spatially continuous displacement field. These spatially enhanced constraints are subsequently fused with GRACE data via Green’s function theory and ABIC-based adaptive weighting. A closed-loop simulation demonstrates that this three-source inversion significantly outperforms single-source estimates, reducing the average Root Mean Square Error (RMSE) to 26.92mm. Monte Carlo analysis further reveals a 45.6% reduction in spatial uncertainty. Independent external assessment using ERA5-Land indicates consistent temporal water storage variations (r = 0.723, p < 0.001), while comparison with GLDAS yields a spatial correlation coefficient of 0.757. Importantly, after removing seasonal cycles and correcting for autocorrelation, a significant positive correlation with precipitation is identified at a one-month lag (r = 0.532, p_corr < 0.001), and the framework successfully captures the transient mass surge triggered by the 2020 summer extreme flood. Furthermore, reservoir-scale spatial masking quantitatively verifies the “anti-seasonal” mass transfer driven by the Three Gorges Dam regulation, revealing a negative correlation (r = −0.503) between mainstream Equivalent Water Height (EWH) and dam water levels. These findings demonstrate that the proposed framework can reliably resolve both natural and anthropogenic water storage signals at regional scales.}
}
@article{LUZY2026136632,
title = {Complex behavior of an urban green infrastructure imaged using time-lapse electrical resistivity tomography and time-series clustering},
journal = {Journal of Hydrology},
volume = {681},
pages = {136632},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136632},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017294},
author = {Alexis Luzy and Adrien Dimech and François Duhaime and Janie Masse-Dufresne and Jean-Sébastien Dubé and Rose-Anne Farley and Rémi Clément and Maxime Paradis},
keywords = {Hydrogeophysics, TL-ERT, Cross-borehole ERT, Green infrastructure, Road de-icing salt},
abstract = {Urban green infrastructure (GI) is increasingly being implemented to manage stormwater, promote infiltration, and limit loads on drainage networks. However, their design still relies largely on large-scale hydrological performance, with limited attention to site-specific hydrogeological processes. Key mechanisms governing infiltration, solute transport, and seasonal dynamics remain poorly understood, especially in cold-climate cities using de-icing salts, which may threaten buried infrastructure, contribute to groundwater salinization, and degrade receiving ecosystems. Field observations are needed to improve understanding of these processes. This study presents one year of monitoring of water and chloride dynamics around an instrumented GI using high-resolution cross-borehole time-lapse electrical resistivity tomography (TL-ERT) at a roadside site in Laval, Quebec, Canada. Automated geoelectrical monitoring was conducted between October 2024 and November 2025 with four surveys per day, using commercial and open-source hardware. The geophysical approach was complemented by hydrogeological monitoring (water levels and sensors). A time-series clustering method was applied to the inverted dataset to identify distinct temporal behaviors of subsurface units. Results indicate infiltration linked to winter rainfall and spring snowmelt. Seasonal conductivity variations in winter and spring are interpreted as being largely influenced by pore-water conductivity associated with de-icing salt mobilization, while late summer and autumn changes are more consistent with VWC-driven responses. Overall, combining cross-borehole TL-ERT, time-series clustering, and hydrogeological instrumentation provides detailed insight into seasonal water and solute movement in small-scale, heterogeneous urban environments, where point monitoring is often limited. This approach is well suited for studying urban GI, while remaining dependent on auxiliary measurements for process attribution.}
}
@article{ANJANEYULU2026136643,
title = {Synergy of policymaking and water storage variations in global transboundary basins},
journal = {Journal of Hydrology},
volume = {681},
pages = {136643},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136643},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017403},
author = {Roniki Anjaneyulu and  Abhishek},
keywords = {Transboundary basins, Terrestrial water storage, Policymaking, Climate, Groundwater storage, GRACE, Water disputes},
abstract = {Water and war are increasingly interconnected issues. Transboundary river basins, which cover nearly half of Earth’s land surface and account for about 60% of global river discharge, play a critical role in global ecological, economic, and social systems. However, there is a lack of comprehensive analysis of terrestrial water storage (TWS) change and how individual countries influence changes in these basins, particularly in the context of climate change and anthropogenic activities. Understanding the movement of basin water is also important for equitable resource distribution among nations. This study examines 22 years of TWS anomalies (TWSA) dynamics, analyzing country-wise contributions to TWSA trends and the impacts of climate change and human activities. We also employ a spatially weighted centroid approach to track the mass movement of water storage and discuss the implications of relevant policies and laws on transboundary water resources. Results show groundwater storage (GWS) constitutes > 50% of the TWSA in 27 basins. Notably, 17 basins exhibit significant decreasing TWSA trends. The movement of TWSA and precipitation centroids is concordant in 9 basins, discordant in 21, with 15 basins experiencing lower water contestations and another 15 facing potential transboundary water contestations. Overall, in 18 basins, anthropogenic factors account for a larger share than climate change in the observed TWSA. The findings provide crucial insights for researchers, stakeholders, and policymakers by highlighting key laws, organizations, agreements, and policies related to water allocations, data sharing, strategic plans for sustainable groundwater recharge, and fostering discussions on dispute resolution.}
}
@article{WEI2026136602,
title = {A constrained deep learning framework for spatiotemporal downscaling of GRACE-derived terrestrial water storage anomalies over China},
journal = {Journal of Hydrology},
volume = {681},
pages = {136602},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136602},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016999},
author = {Min Wei and Hao Zhou and Yifeng Chen and Wenjing Ma and Siyou Xu and Zhicai Luo},
keywords = {GRACE/GRACE follow-on, Spatiotemporal downscaling, Terrestrial water storage anomalies, GLDAS, Deep learning neural network},
abstract = {Terrestrial water storage anomalies (TWSA) play an important role in characterizing hydrological variability, particularly under changing climate conditions. Representing TWSA at finer spatiotemporal scales is essential for characterizing water-storage variations across spatial and temporal scales. Although the Gravity Recovery and Climate Experiment (GRACE) and GRACE Follow-On (GFO) missions provide valuable TWSA observations, their inherent spatiotemporal resolution limits the representation of short-term variability and localized spatial features. While hydrological simulations such as GLDAS provide fine-scale spatial and temporal hydrological variability, their simulated signal magnitude and long-term trends may differ from GRACE/GFO observations. To address these limitations, this study proposed a multi-scale constrained deep learning model with a spatiotemporally constrained loss function to produce a daily TWSA reconstruction over China on a 0.25° grid. This proposed spatiotemporal downscaling (STDS) framework integrates the large-scale gravimetric constraints from GRACE/GFO with the fine-scale spatiotemporal variability represented by GLDAS. Experimental results show that, compared with GLDAS, STDS reduces the RMSE relative to GRACE/GFO observations by 62.07%, while maintaining a high temporal correlation (0.91) and spatial structural consistency (0.96) with GLDAS, indicating that the fine-scale spatiotemporal variability informed by GLDAS is largely preserved under the GRACE/GFO constraints. During Typhoon Doksuri and the Zhengzhou flash flood events, the STDS further exhibited localized TWSA variations that evolved consistently with the precipitation fields. These results demonstrate that the proposed framework provides a GRACE/GFO-constrained representation of TWSA while preserving the fine-scale spatiotemporal variability informed by GLDAS. The resulting product has potential applications in hydrological studies, including the analysis of short-term extreme events.}
}
@article{HU2026136675,
title = {Wildfire disturbance during extreme drought reshapes groundwater dissolved inorganic carbon export pattern in a subtropical karst trough valley},
journal = {Journal of Hydrology},
volume = {681},
pages = {136675},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136675},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017725},
author = {Chenpeng Hu and Sibo Zeng and Yan Yang and Lidan Lei and Lei Liu and Xuyang Liu and Mingyang Li and Xinhe Huang and Yonghao Tang},
keywords = {Wildfire-drought impact, Karst groundwater, Carbon export, Hydrological extremes, Karst system},
abstract = {Hydrochemical processes in karst system are highly sensitive to climate extremes because of rapid surface–subsurface connectivity. However, the effects of extreme drought and drought-associated wildfire on carbon cycling in these systems remain poorly understood. Here, we use nine-year records (2017–2025) of groundwater hydrochemistry, δ13C of dissolved inorganic carbon (DIC), discharge-based DIC fluxes, and remote-sensing vegetation indices from the Longtan karst trough valley, Southwest China, to evaluate the impacts of hydroclimatic variability, vegetation dynamics, extreme drought, and wildfire on groundwater DIC pattern. We found the increasing precipitation and vegetation recovery promoted carbonate dissolution during the relatively humid period (2017–2021), resulting in higher DIC concentrations and more negative δ13CDIC values. DIC and δ13CDIC exhibited clear seasonal patterns associated with vegetation dynamics. In 2022, however, an extreme drought compounded by wildfire abruptly disrupted these trends, which revealed by a random forest model and a comparision framework of LSTM-RF predictions. Fire-induced vegetation loss, together with drought-related declines in soil moisture and groundwater recharge, weakened carbonate weathering and reduced DIC and Ca2+ concentrations. After the wildfire, DIC fluxes decreased by 90.88 %, respectively, mainly because of sharply reduced groundwater discharge. These findings show that extreme events can strongly disrupt DIC export from karst systems and should be explicitly incorporated into future karst system carbon cycling models.}
}
@article{CHEN2026136558,
title = {Seasonal shift from phosphorus retention to remobilization along an aquaculture pond–sediment–groundwater pathway in a monsoon-influenced shallow lake margin},
journal = {Journal of Hydrology},
volume = {681},
pages = {136558},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136558},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016550},
author = {Saier Chen and Teng Ma and Zhijia Zeng and Ting Jiang and Liuzhu Chen},
keywords = {Aquaculture-derived phosphorus, Pond-water leakage, Hydrological connectivity, Sediment Fe/P transformations, Phosphorus retention and remobilization, Aquaculture pond–sediment–groundwater pathway},
abstract = {Pond-based aquaculture is an important source of phosphorus (P) to adjacent shallow lakes, and previous studies have mainly examined P dynamics at the pond sediment–water interface or along surface-water pathways. In monsoon-influenced lake margins, pond-water leakage may carry aquaculture-derived P through underlying sediments into shallow groundwater, yet how seasonal hydrological connectivity and sediment Fe/P reactions regulate P retention, remobilization, and potential lakeward transfer remains poorly understood. We combined wet- and dry-season field surveys in an aquaculture-affected margin of Honghu Lake, China, with a sequential wet-to-dry column experiment to examine how the balance between P retention and export changes along this pathway as boundary conditions shift from pond-water leakage to groundwater throughflow. Field observations showed an apparent inconsistency between groundwater redox indicators and soluble reactive phosphorus (SRP) concentrations: SRP was lower in the relatively reducing wet season but higher in the relatively oxidizing dry season. In the column experiment, the sediment strongly attenuated SRP from simulated P-rich pond water (0.86–0.99 mg·L−1), with cumulative net SRP retention reaching 93.35 mg·m−2 and Fe-bound P (Fe–P) enrichment. After switching to simulated low-P, more mineralized groundwater influent (0.27 mg·L−1 SRP), the wet-stage-conditioned sediment shifted to net SRP export, and the cumulative net SRP balance declined by 85.34 mg·m−2 from the wet-stage endpoint, accompanied by Fe–P depletion and an increased Fe(II)/Fe(III) ratio, consistent with selective remobilization of previously retained sediment P. Together, the column responses and the more favorable dry-season groundwater–lake hydraulic conditions suggest a seasonal reorganization of functional connectivity within the aquaculture pond–sediment–groundwater–lake continuum: wet-season pond-water leakage favored temporary retention of incoming P within the pond–sediment segment, whereas dry-season remobilization coincided with greater potential for lakeward P export. Management should therefore consider aquaculture-derived P inputs, seasonal hydrological connectivity, and the stability of retained sediment P.}
}
@article{HUANG2026136594,
title = {An adaptive Picard-SBFEM-level set formulation for three-dimensional saturated-unsaturated seepage flow analysis and free-surface tracking},
journal = {Journal of Hydrology},
volume = {681},
pages = {136594},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136594},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016914},
author = {Chuhao Huang and Jun Liu and Fuming Wang and Chengchao Guo and Lei Gan and Wenbin Ye and Binghan Xue and Gao Lin},
keywords = {Saturated-unsaturated seepage, Scaled Boundary Finite Element Method (SBFEM), Picard iteration, Level-set method},
abstract = {This study presents a semi-analytical numerical framework for three-dimensional steady saturated–unsaturated seepage analysis with free-surface tracking. The proposed method integrates the scaled boundary finite element method, an adaptive linearized Picard iteration scheme, and a level-set method into a unified formulation. The nonlinear Richards equation with pressure-head-dependent hydraulic conductivity is solved using a coefficient-frozen Picard strategy, while the unknown free surface is implicitly represented by a level-set function and corrected until both the hydraulic and kinematic conditions are satisfied. Five three-dimensional examples comprising 16 cases are investigated, covering spatially varying permeability, zoned heterogeneous media, non-uniform boundary conditions, complex geometries, confined seepage fields, and internal defects. The computed phreatic surfaces, total head distributions, pressure head distributions, and local seepage patterns agree well with the corresponding reference solutions, thereby validating the accuracy and reliability of the proposed method. Computational efficiency is further assessed using the global degrees of freedom (DOFs), matrix-assembly time, nonlinear-iteration time, peak memory usage, and total wall-clock time rather than the element count alone. For five representative cases, the proposed method reduces the global DOFs by 52.8%∼87.1%, the total matrix-assembly time by 15.5%∼32.4%, the average nonlinear-iteration time by 12.0%∼27.6%, and the peak memory usage by 31.7%∼44.3%. The corresponding total computational time is reduced by 28.0%∼58.3% relative to the reference models. These results demonstrate that the proposed method can accurately and efficiently solve complex three-dimensional saturated–unsaturated seepage problems while maintaining stable convergence and reliable free-surface tracking.}
}
@article{CARDENASCARO2026136597,
title = {Assessing multi-flood hazard zones for stormwater infrastructure in highly urbanized coastal cities},
journal = {Journal of Hydrology},
volume = {681},
pages = {136597},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136597},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601694X},
author = {L.T. Cardenas-Caro and F.L. Santiago-Collazo and O.M. Viloria-Marimón and J.B. Robider and E.R. Gavin and L.T. Bayer and M.V. Bilskie},
keywords = {Compound flooding, Stormwater modeling, Flood hazard zones, Transition flood zone, Sea level rise, Coastal hydrology, Urban drainage},
abstract = {Coastal cities are increasingly exposed to compound flooding driven by interactions between coastal water levels and inland hydrologic processes. While previous studies have focused primarily on overland flooding, compound flood hazard zones (FHZs) within stormwater drainage systems remain poorly understood. This study investigates subsurface compound FHZs using the Storm Water Management Model (SWMM) for two urban watersheds in Savannah, Georgia. Simulations combined two rainfall events (10% and 4% annual exceedance probabilities), astronomical tides, and an intermediate 2050 sea-level-rise (SLR) scenario. Compound FHZs were delineated using conduit-depth-relative transition-zone thresholds (0.5%, 2%, and 5%) and analysed to evaluate water-level profiles, spatiotemporal FHZ behavior, and drainage-network response. Results show that subsurface transition FHZs develop within confined stormwater systems and are highly sensitive to threshold selection, network configuration, and downstream tidal forcing. Under the 0.5% threshold, the coastal FHZ in the Fells Street watershed shortened by approximately 80% under SLR relative to the 10% no-SLR scenario, accompanied by expansion of the transition FHZ and up to an 8% increase in transition-zone water depths. The results further demonstrate that simple linear superposition of isolated rainfall and tidal responses may produce physically unrealistic water levels in confined drainage systems, highlighting the need for dynamically coupled compound-flood simulations. Tidal influence was also observed farther upstream than implied by existing overland FHZ definitions. These findings extend the FHZ framework to subsurface stormwater systems and improve understanding of how tidal backwater, sea-level rise, and drainage-network characteristics influence compound flooding in coastal urban environments.}
}
@article{CHEN2026136611,
title = {A novel analytical method for transient advection–dispersion–reaction equations with arbitrary source term in layered media},
journal = {Journal of Hydrology},
volume = {681},
pages = {136611},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136611},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017087},
author = {Zhang-Long Chen and Tian-Chyi Jim Yeh and Bo Guo and Chen-Xu Liu and Hongwei Fang},
keywords = {Contaminant transport, Advection–dispersion–reaction equation, Naturally occurring contaminant, Arbitrary source term, Layered media, Analytical solution},
abstract = {The transport and accumulation of naturally occurring contaminants (NOCs) in soils may deteriorate groundwater and soil environmental quality and pose potential risks to ecosystems. To date, no analytical solution is available for modeling transient NOC transport with zero-order generation in layered porous media. We present a novel analytical method for solving layered advection–dispersion–reaction–source equations (ADRSEs) and apply it to model NOC transient transport in layered porous media. Our exact analytical solution can accommodate an arbitrary number of layers, an arbitrary spatiotemporally dependent source term, and arbitrary initial and boundary conditions. An analytical solution, two semi-analytical solutions, and a numerical solution are used to verify the new analytical solution. Taking radon exhalation from a radon cover layer system as an example, we illustrate the effects of spatiotemporally dependent source terms, cover layer thickness, and advection on radon transport. The results indicate that neglecting the spatiotemporal variability of source terms can lead to inaccurate predictions of radon exhalation flux. Furthermore, with decreasing permeability of the cover layer, both the fluctuation amplitude and the peak value of radon exhalation flux decrease significantly. The solution is then applied to the radon deficit technique to provide a theoretical basis for quantifying residual non-aqueous phase liquid (NAPL) in the aquifer. Comparisons with laboratory and field experimental results demonstrate the potential of the analytical solution for practical applications. More broadly, the solution provides a unified analytical framework for advection–diffusion problems involving source terms and can serve as a benchmark for related numerical models.}
}
@article{ZHAO2026136647,
title = {Relating precipitation extremes to streamflow peaks using percentile-based correspondence and interpretable machine learning},
journal = {Journal of Hydrology},
volume = {681},
pages = {136647},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136647},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017440},
author = {Tongtiegang Zhao and Xiaodong Li},
keywords = {Precipitation extreme, Streamflow peak, Catchment attribute, Random forest, Interaction effect, Snow fraction},
abstract = {The extent to which precipitation extremes translate into streamflow peaks is a critical part of the rainfall-runoff relationship. This paper focuses on the extent to which the upper 90th percentile precipitation extremes correspond to streamflow peaks above different percentiles. Specifically, precipitation extremes are paired with streamflow peaks by searching for event-specific discharge maxima and estimating empirical percentiles; the percentile-based correspondence is calculated as the hit rate to quantify the proportion of paired streamflow peaks above different percentile levels; furthermore, random forest models coupled with analyses based on SHapley Additive exPlanations are used to diagnose the effects of catchment attributes on the correspondence by accounting for feature importance and interaction effects. A case study is devised for the dataset of Catchment Attributes and Meteorology for Large-sample Studies across the continental United States. The results show that the median proportions of paired streamflow peaks exceeding the 80th, 90th and 95th percentiles are about 70%, 57% and 45%, respectively. For the upper 90th percentile streamflow peaks, the random forest model identifies the snow fraction as the dominant attribute, with its negative impacts shaped by its interaction with mean elevation. Among catchments with the highest 20% of snow fraction, the median hit rates remain 0.53 below 500 m and 0.57 between 500 and 1000 m, but drop to 0.14 above 1000 m. After constraining the snow fraction-elevation interactions, the five leading catchment attributes shift to mean high-flow duration, longitude, mean precipitation, streamflow elasticity and silt fraction. Overall, the results inform the interpretation of catchment-specific precipitation extremes for streamflow forecasting and flood warning.}
}
@article{PTAK2026136603,
title = {A novel approach for forecasting lake heatwaves using MSAPE-ML: A deep learning framework with WRF-derived physical features coupled with the air2water model},
journal = {Journal of Hydrology},
volume = {681},
pages = {136603},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136603},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017002},
author = {Mariusz Ptak and Teerachai Amnuaylojaroen},
keywords = {WRF-derived features, Deep learning, Lake heatwaves, Air2water model, Hybrid modeling, CMIP6 scenarios, Temperate lakes, Sustainable water management},
abstract = {Lake heatwaves threaten freshwater ecosystems, yet projections for individual lakes remain scarce. We introduce MSAPE-ML, an LSTM-Attention model whose input features encode analytical relationships derived from the RRTMG, MYNN2, and Noah-MP parameterisations for climate downscaling. Coupled with the air2water ODE lake model and driven by Bayesian model averaging of CMIP6 ensembles, the framework projects heatwave characteristics for 37 Polish lakes under three SSPs, achieving water temperature RMSE of 1.89 ± 0.15 °C (R2 = 0.94). Mean annual heatwave days increase from 23 historically to 84 (SSP1-2.6), 191 (SSP2-4.5), and 334 (SSP5-8.5) by end-of-century. Under SSP5-8.5, discrete events coalesce until 97% of lakes exceed 350 days yr⁻1 above the fixed 1985–2014 90th-percentile envelope by 2100 — a quasi-permanent departure from the historical thermal regime, though fixed ecological thresholds are crossed far less often (17–45 days yr⁻1 above 28 °C by end-of-century). Severity shifts from predominantly Moderate (87%) to Strong-or-above (80%), and occurrence expands into all seasons. Shallow lakes exhibit more intense but shorter heatwaves, while deep lakes experience prolonged events. These projections establish MSAPE-ML as a transferable framework for lake heatwave assessment based on physics-derived features. This regime departure erodes the cool-season recovery windows on which cold-water species depend, while the accelerating exceedance of absolute thresholds (25–28 °C) increasingly favours harmful algal proliferation and eutrophication across Polish lake ecosystems. These projections provide an evidence base for freshwater-specific climate adaptation, including revised thermal discharge regulations and prioritised monitoring of shallow lakes most vulnerable to regime shifts.}
}
@article{DIXIT2026136627,
title = {Occurrence-rate nonstationarity alters design rainfall return levels: A decomposed Poisson-GPD analysis across contrasting hydroclimatic regimes},
journal = {Journal of Hydrology},
volume = {681},
pages = {136627},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136627},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017245},
author = {Shubham Dixit and Kamlesh K. Pandey},
keywords = {Nonstationary rainfall frequency analysis, Peaks-over-threshold modeling, Occurrence–severity decomposition, Poisson–GPD framework, Extreme rainfall, Design rainfall estimation},
abstract = {Climate-informed rainfall frequency analysis increasingly informs design rainfall estimation. Atmospheric processes favoring extreme rainfall occurrence may differ from those amplifying event magnitude, yet peaks-over-threshold (POT) models often treat occurrence as stationary while modeling nonstationary (NS) severity. Because POT return levels (RL) depend jointly on occurrence and excess magnitude, this choice can alter design estimates. We evaluated whether separating occurrence and severity changes return levels using daily rainfall at 15 climatically contrasting Indian locations. Occurrence and severity covariates were screened separately and used in Poisson occurrence and GPD severity models to compare stationary, NS-occurrence-only, NS-severity-only, and full NS-occurrence-severity formulations. Models allowing occurrence to vary received more support than stationary and severity-only formulations and reduced unexplained variability in exceedance counts. Nonstationary return levels were defined using fitted monthly occurrence and severity conditions over the evaluation period. Over 2001–2022, adding occurrence nonstationarity to the severity-only model lowered RL at 8 stations and raised it at 7. At Indore and Panaji, full occurrence-severity formulation also avoided implausibly large severity-only return levels, showing that occurrence modeling can affect magnitude and plausibility. Because nonstationary return levels depend on climatic conditions, sensitivity to alternative evaluation periods was examined. Occurrence covariates remained informative beyond seasonality, particularly for moisture transport, whereas severity covariates showed varied associations with thermodynamic, dynamic, and teleconnection-related variables. Overall, separating occurrence and severity showed that changes in exceedance frequency can materially influence design return levels and improve process interpretation of nonstationary rainfall-frequency estimates. Sensitivity checks consistently supported occurrence nonstationarity, although return-level effects were sometimes specification-dependent.}
}
@article{JIA2026136651,
title = {Spatial heterogeneity and attribution analysis of urban flood risk throughout the full lifecycle: insights from a safety-economy-environment framework and an interpretable MCDM-XGBoost-GWRF model},
journal = {Journal of Hydrology},
volume = {681},
pages = {136651},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136651},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017488},
author = {Hao Jia and Danyang Di and Zhuo Chen and Zhaoyang Zhang and Meiqin Qi and Jie Li},
keywords = {Urban flooding, Flood risk assessment, Hydrodynamic process, Interpretable XGBoost-SHAP machine learning, Spatial heterogeneity},
abstract = {Driven by climate change and rapid urbanization, urban flood risks exhibit significant multidimensionality, non-linearity, and spatial heterogeneity. To address these complexities, this study uses Jiaozuo, a mid-sized inland city located in a plain–mountain transition zone, as a case study and constructs an integrated risk assessment system incorporating the safety-economy-environment framework. A flood risk index is established using a multi-criteria decision-making (MCDM) model that combines the Monte Carlo-based entropy weight method (MCEWM) with the VlseKriterijumska Optimizacija I Kompromisno Resenje (VIKOR) method. Furthermore, extreme gradient boosting (XGBoost) with Shapley additive explanations (SHAP) and geographically weighted random forest (GWRF) are adopted to parse global driving mechanisms and local spatial heterogeneity. The results indicate that: (1) Flood risk exhibits a “high center, low periphery” mono-centric decay pattern. (2) Socio-economic exposure and drainage capacity are primary global drivers, with drainage capacity, population density, and impervious surface ratio making the highest contributions. (3) Driving mechanisms are distinct across risk levels: high-risk areas are dominated by the coupling of hazard intensity and population exposure; medium-risk areas are governed by topography; and low-risk areas rely on ecological regulation. (4) GWRF revealed pronounced spatial heterogeneity in adaptive capacity and surface-environment effects and provided a more refined representation of localized flood-risk patterns than MCDM and XGBoost. Local high-risk areas were primarily associated with low-lying terrain, constrained drainage conditions, and concentrated socio-economic activities. The proposed synergistic framework systematically constructs a complete causal analysis, providing a scientific basis for optimizing urban flood control strategies.}
}
@article{POYKKO2026136554,
title = {Changes in the annual cycle of shallow subarctic groundwater regimes over 50 years},
journal = {Journal of Hydrology},
volume = {681},
pages = {136554},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136554},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016513},
author = {Pietari Pöykkö and Mira Tammelin and Anna-Kaisa Ronkanen and Lauri Ahopelto and Pekka M. Rossi},
keywords = {Boreal hydrology, Climate impact, Groundwater dynamics, Long-term monitoring, Time series clustering},
abstract = {Seasonal groundwater level regimes are exposed to climate change, with implications for drought and flood risks, water supply, agriculture, and ecosystems. Changes in the intra-annual groundwater fluctuations are accentuated in quickly responding shallow aquifers found worldwide, but particularly in subarctic regions, where the cold winter season attenuates infiltration and evaporation. To identify the types of subarctic groundwater regimes and their responses to the changing climate, 50-year groundwater level data from 52 monitoring stations throughout Finland were analyzed. This was done by partitioning around medians (PAM) clustering of Pearson correlations and a principal component analysis (PCA) of normalized monthly values. Four distinct regimes were identified, mostly following the southwest–northeast temperature and snow condition gradients. The migration of regimes towards the colder northeastern regions could be seen between the clustering periods of 1975–1999 and 2000–2024. This migration manifested as rising winter levels and lowering summer levels, in addition to changing seasonality timing, such as the spring recharge peak advancing by an average of half a month and by up to two months. Furthermore, seasonal groundwater level responses were seen to depend on the projected surface area of the aquifer, as comparatively larger aquifers among the studied 0.1– 41 km2 scale showed a lagged regime. The results suggest that the selected approach effectively captures the spatially evolving conditions. They also highlight the importance of long-term monitoring for effective decision-making and preparedness for shortages in water availability in the changing climate.}
}
@article{YU2026136598,
title = {Small floods, not large ones, drive oxygen decline in a subtropical estuary via hydro-biogeochemical coupling},
journal = {Journal of Hydrology},
volume = {681},
pages = {136598},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136598},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016951},
author = {Dan Yu and Minxiang Zhu and Qihui Zheng and Peng Cheng and Yik-Lam Poon and Yiqi Yu and Xiyu Zhang and Shaobin Li and Nengwang Chen},
keywords = {Dissolved organic carbon, Small floods, Algal blooms, Dissolved oxygen, River-estuary continuum},
abstract = {River floods mobilize large amounts of dissolved organic carbon (DOC) to estuaries, but how flood magnitude modulates the subsequent estuarine oxygen response remains unresolved. Here we show that small floods (310 m3/s ≤ peak flow < 1030 m3/s), not large ones (≥1030 m3/s), drive dissolved oxygen (DO) decline in a dam-regulated subtropical estuary. By integrating high-frequency monitoring, biodegradation incubations, and hydrodynamic modeling in the Jiulong river-estuary continuum during 2023, we identified two contrasting flood-induced oxygen response pathways. The small floods mobilize phytoplankton-derived DOC from upstream reservoirs, which was highly biodegradable (bioavailable fraction up to 39%, with low SUVA254). Concurrently, these events triggered estuarine algal blooms (Chl-a increased 2.3- to 10.8-fold) due to modest nutrient pulses, improved light availability, and extended water residence time. The senescent bloom provided additional labile carbon. The combination of riverine and autochthonous labile carbon fueled microbial respiration, resulting in a net DO decline of 3%∼17% across the five small-flood events in 2023. In contrast, four large floods deliver predominantly terrestrial and refractory DOC. These large floods induced high turbidity that suppressed algal blooms (no Chl-a peaks), limiting the supply of labile autochthonous carbon. The enhanced vertical mixing promoted re-aeration, while shortened water residence time minimized microbial oxygen consumption. Consequently, oxygen depletion was prevented and yielded a net DO increase of 1%∼8%. This study suggests that river flood magnitude modulates the balance between physical and biological controls on carbon‑oxygen dynamics in the river‑estuary continuum, providing a predictive framework for water quality responses to hydrological extremes in dam-regulated systems.}
}
@article{ZHANG2026136638,
title = {Deciphering leakage in cut-off walls-aquifer dual domain system using tracer breakthrough analysis},
journal = {Journal of Hydrology},
volume = {681},
pages = {136638},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136638},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601735X},
author = {Yunzhao Zhang and Huaxiang Yan and Hamid Rajabi and Samad Sabbaghi and Hongqiang Dou and Qiao Wang},
keywords = {Cut-off wall, Fractures, Leakage, Tracers, Analytical solution},
abstract = {Cut-off walls are commonly used as engineering barriers to prevent contaminant transport by reducing groundwater seepage. However, the development of fractures and cracks in the cut-off wall under wet-dry cycles and chemical erosion can create preferential flow paths, significantly compromise the effectiveness of the cut-off walls. A cut-off wall aquifer dual domain analytical model is consequently developed to investigate the potential leakage of the barrier system by interpreting the breakthrough curve (BTC) of tracers. A conservative tracer experiment in the sandbox validates the proposed solution. The effects of cut-off wall thickness (B), hydraulic head (hw), and fracture aperture (bf) on BTC characteristics were systematically analyzed. The leakage of cut-off wall due to the development of fractures and cracks alters the BTC of tracer, advancing the transit time (ta) and peak arrival time (tp) by 98.3% and 98.6%, respectively. Under non-leakage conditions, increasing the cut-off wall thickness delays tracer transport, whereas under leakage conditions, preferential flow through fractures diminishes the influence of wall thickness on leakage resistance. By integrating the peak breakthrough concentration (Cp), flow velocity (vc), the Péclet number (Pe)-dimensionless time (Tv) relationship, and the Tv-bf relationship, a multi-stage leakage identification framework was proposed. The framework enables leakage detection, barrier-integrity assessment, and quantitative characterization of preferential flow pathways using tracer-monitoring data, providing a theoretical basis for long-term performance evaluation of cut-off walls.}
}
@article{GUO2026136631,
title = {A knowledge-guided machine learning framework for reconstructing climate-driven subsurface water dynamics from time-lapse electrical resistivity tomography},
journal = {Journal of Hydrology},
volume = {681},
pages = {136631},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136631},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017282},
author = {Weiyu Guo and Hang Chen},
keywords = {Subsurface water dynamics, Time-lapse electrical resistivity tomography, Knowledge-guided machine learning, Climate forcing, Hillslope hydrology},
abstract = {Understanding and anticipating climate-driven subsurface water dynamics is essential for assessing water availability and ecosystem function, yet it remains challenging in heterogeneous mountain environments. Time-lapse electrical resistivity tomography (TL-ERT) provides spatially distributed observations of subsurface change but has been used mainly to monitor subsurface change rather than to model its evolution. Here, we develop a knowledge-guided machine learning framework to reconstruct the spatiotemporal evolution of subsurface resistivity from daily meteorological forcing and continuous TL-ERT observations on a monitored hillslope. Before training, the TL-ERT data were corrected to a common reference temperature to remove the direct temperature dependence of resistivity, allowing temporal resistivity changes to be interpreted as a proxy for subsurface water-content change. Three neural architectures were evaluated within a shared recursive framework using structured loss terms that preserve reconstruction accuracy, local spatial structure, and coherent temporal variation. All models reproduced the dominant seasonal patterns, and the PredRNN-based architecture performed best, with an RMSE of 9.5 Ω·m over held-out test windows. Under rolling recursive reconstruction without subsequent ground-truth resistivity observations, the framework maintained seasonally coherent trajectories within the observed record. Under a + 4 °C warming scenario, the simulated temperature-corrected resistivity showed earlier shallow spring decreases about 12% and slight shallow summer increases, with weaker responses at depth. Through a water-content conversion, these changes are consistent with earlier spring wetting and shallow summer drying. These results provide a site-specific proof of concept that continuous TL-ERT observations combined with knowledge-guided machine learning can reconstruct the seasonal evolution of subsurface resistivity within the observed record and support scenario-based hydrologic interpretation.}
}
@article{LI2026136639,
title = {Analytic outlet-state identification in a pathway-age neural transport operator enables cross-domain streamflow forecasting in human-affected basins},
journal = {Journal of Hydrology},
volume = {681},
pages = {136639},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136639},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017361},
author = {Xue Li and Li Wang and Jian Sha},
keywords = {Streamflow forecasting, Hydrological state identification, Pathway-age transport, Mass conservation, Cross-domain transfer, Human-affected basins},
abstract = {Neural streamflow forecasts often leave initial water storage unconstrained. We introduce outlet-gauged pathway-age transport (OGPAT), the first neural hydrological operator in which contemporaneous outlet discharge analytically identifies the extensive coordinate of a learned mass-bearing catchment state. Learned normalized pathway-age composition wi and release functional hi define mi=Qtwi/∑jhjwj, the unique state on the ray of w satisfying ∑ihimi=Qt. This parameter-free map guarantees exact issue-time flux consistency, finite nonnegative storage, and a zero state at zero flow. The state and forecast rainfall enter one nonnegative causal ledger whose outlet marginal gives the complete 1–18 h forecast. Inputs comprise current discharge, 27 basin attributes, and 24-h antecedent and 18-h issued weather from 2025. OGPAT was fitted once on 578,390 issues from 224 minimally disturbed United States basins and tested without target-basin fitting on 1,355,521 issues from 173 human-affected non-reference basins in nine ecoregions. Against same-input Transformer and long short-term memory (LSTM), pooled overall root mean squared error (RMSE), high-flow RMSE and peak-magnitude mean absolute error (MAE) fell by 4.03–7.02%, 3.51–5.44% and 29.01–38.13%, respectively; peak timing improved by 1.34–1.96 h. Basin 35th-percentile skills remained positive; station-block 95% intervals for overall RMSE skill excluded zero against both controls. Against the original capacity-matched non-gauged transport parent, overall/high-flow RMSE and peak-MAE fell by 7.96%/6.94%/35.77%. Against the paired free-radial parent with matched active parameters and training, RMSE and peak-MAE reductions remained 7.33–9.08% and 30.86–33.94%. OGPAT establishes analytic outlet-state identification as a transferable operator principle for short-range forecasting under human-impact domain shift.}
}
@article{AKINSOJI2026136614,
title = {Bivariate regional frequency analysis of extreme rainfall depth and intensity: comparing annual maxima and r-Largest approaches with simulated annealing regionalization across South Korea},
journal = {Journal of Hydrology},
volume = {681},
pages = {136614},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136614},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017117},
author = {Adisa Hammed Akinsoji and Qudus Adeyi and Rahmon Abiodun Salau and Deepak Chaulagain and Kyung Sook Choi},
keywords = {Bivariate regional frequency analysis, Simulated Annealing, L-comoments, Annual maxima, r-Largest, Extreme rainfall, South Korea},
abstract = {Extreme rainfall in South Korea has intensified under recent climate variability, yet national infrastructure design standards still rely on univariate analyses of pre-2000 data that treat rainfall depth and intensity as independent, understating joint flood risk. This study addresses that gap with a bivariate regional frequency analysis (BRFA) of multi-duration extreme rainfall, jointly modeling event depth and mean intensity across accumulation durations of 6, 12, 24, and 48 h using 41 years of hourly records from 61 KMA ASOS stations. Two sampling approaches are compared: annual maxima (AMx) with residual-based decorrelation, and r-Largest, retaining the five largest IETD-separated monsoon events per year without decorrelation. Simulated Annealing optimization of the bivariate L-comoments H1 statistic delineated six homogeneous regions (H1 = 0.105–0.916, all satisfying H1 < 1.0) pooling 2,501 station-years. GUM dominated AMx marginal selection at 6–12 h and PE3 at 24–48 h; PE3 and Exponential dominated r-Largest. The Gaussian copula prevailed under AMx (54.2%); Frank (41.7%), and GUM (25.0%) prevailed under r-Largest. Critically, exponential back-transformation in the AMx decorrelation procedure amplifies intensity estimation errors (per-site NSE = −97.5), while r-Largest yields physically realistic intensity estimates (RMSE 2–16 mm h−1). Regional 100-year depth quantiles of 160–233 mm at 6 h and 271–372 mm at 24 h exceed the current Korean national standards by 15–25%, warranting revisions to design standards for agricultural drainage and hydraulic infrastructure.}
}
@article{UCHOA2026136666,
title = {An integrated assessment of groundwater controls on streamflow and ecosystem functioning in the Guarani aquifer outcrop zone},
journal = {Journal of Hydrology},
volume = {681},
pages = {136666},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136666},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017634},
author = {José Gescilam S.M. Uchôa and José A.C. Ayllon and Daniel P. Abrahão and Luis E. Bertotto and Alan Reis and Davi Gasparini F. Cunha and Juliano J. Corbi and Jamil A.A. Anache and Edson C. Wendland},
keywords = {Surface water–groundwater interactions, Hyporheic exchange processes, Ecohydrological perspective, Tropical zone, Catchment hydrology},
abstract = {Groundwater–surface water interactions sustain river ecosystems and regulate biogeochemical processes. However, despite growing interest in hyporheic zone functioning, interdisciplinary assessments remain scarce in tropical regions. Here, we present a scalable interdisciplinary framework to evaluate groundwater influences on streamflow and ecosystem functioning at the reach scale in the Guarani Aquifer System (GAS) outcrop area, São Paulo, Brazil. The approach combines (i) temperature as a natural tracer of groundwater discharge, (ii) physicochemical and nutrient analyses, (iii) macroinvertebrates as bioindicators, and (iv) cotton-strip assays to estimate organic matter decomposition. Two years of quarterly monitoring were conducted across three creek reaches (S1, S2, and S3) with contrasting degrees of groundwater connectivity. The reach with stronger groundwater influence (S2) exhibited significantly lower thermal variability than the upstream (S1) and downstream (S3) reaches, whereas no significant differences in phase lag were detected. Nutrient concentrations showed contrasting longitudinal patterns between S1–S2 and S2–S3, particularly for NH4+-N. Furthermore, S2 had the highest macroinvertebrate diversity, and the highest organic-matter decomposition rates, with a significant difference between S2 and S1, whereas biofilm respiration was higher in S3. The overall consistency among indicators suggests that river-aquifer interactions not only sustain streamflow but also regulate relevant biological communities, ecosystem functions and biogeochemical processes. Although spatially limited relative to the overall extent of the GAS, its outcrop areas are critical recharge zones and particularly susceptible to anthropogenic contamination. The proposed approach may be adapted to other local creeks in GAS outcrop area, or tropical regions with similar climate and hydrological conditions.}
}
@article{LIU2026136669,
title = {Representing canopy interception in a distributed snow model to improve snow accumulation and melt timing},
journal = {Journal of Hydrology},
volume = {681},
pages = {136669},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136669},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601766X},
author = {Yijing Liu and J. {Michelle Hu} and Alvaro Robledano and S. {McKenzie Skiles}},
keywords = {iSnobal, Forest canopy, Snow interception, Snow loss in the canopy, Snow melting},
abstract = {Seasonal snowmelt is a vital water resource for downstream populations and supports ecological processes in the mountainous Western United States. In subalpine forests, snow interception by tree canopies strongly influences snow accumulation, snow duration, and runoff timing. However, canopy interception has not been incorporated into the widely used, process-based distributed snow energy balance model, iSnobal. To address this gap, we integrated multiple forest canopy snow processes into iSnobal. To assess the version of iSnobal with canopy processes, it was run over five water years in the East River Watershed, a mountainous, partially forested basin in the Upper Colorado River Basin. Across model runs, 50–150 mm of snowfall, equivalent to 10% − 30% of cumulative snowfall, was intercepted annually. Within the canopy, melt dominated snow loss, while wind-driven unloading was limited and elevation-dependent. Relative to baseline runs, snow depths were decreased (mean 0.09–0.11 m) and snow cover duration was shortened (7–16 days) due to delayed snow onset and faster snow depletion. The model was assessed against lidar-mapped snow depth, which showed that accounting for interception improved model performance, with 39.4% to 57.3% of pixels exhibiting better agreement and reduced errors, especially during late melt (May and June). Random forest analysis identified intercepted snowfall, snow onset date, leaf area index, cumulative snowfall, and aspect as primary controls on snow depth differences between default iSnobal and its canopy-enabled version. This study emphasizes the importance of accounting for forest canopy processes in snow models and provides a basis for more reliable snowmelt inputs to water supply forecasting in snow-dominated forested regions.}
}
@article{CIRIELLO2026136674,
title = {Short-term forecasting from GRACE data via dynamic mode decomposition with sequential update},
journal = {Journal of Hydrology},
volume = {681},
pages = {136674},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136674},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017713},
author = {V. Ciriello and G. Libero and D.M. Tartakovsky},
keywords = {GRACE data, Dynamic mode decomposition, xDMD, Short-term forecasting, Dynamic process, Time series},
abstract = {Dynamical systems theory is often used for short-term forecasting of hydrologic processes, because it preserves physical interpretability while remaining computationally efficient. One of its tools, dynamic mode decomposition (DMD), provides a modal representation of high-dimensional systems capable of capturing dominant spatiotemporal dynamics in observed data. We investigate the ability of xDMD, a DMD variant that allows for inhomogeneous dynamics, to predict short-term anomalies in basin-averaged total water storage across 15 major river basins worldwide. We compare global and basin-scale training strategies and evaluate the impact of sequential retraining frequency. Our results demonstrate that globally trained models with sequential updating on average outperform basin-scale approaches, indicating that spatial coherence provides a more stable and representative modal basis for temporal extrapolation. Periodic retraining is essential to accommodate gradual evolution of the temporal coefficients and to maintain the robust forecast capacity for update intervals of up to six months. Extension of the retraining interval to annual updates degrades the performance, suggesting the emergence of non-autonomous behavior in some systems and linking the prediction horizon of the xDMD-based forecast to the drift time scale of the temporal coefficients of each basin. A benchmark against recurrent LSTM-GRU networks confirms markedly smaller systematic biases at a fraction of the computational cost. A sliding-window spectral diagnostic confirms that the non-autonomous behavior is almost entirely confined to the temporal coefficients of a nearly time-invariant spatial basis, and provides a transferable, a-priori criterion for selecting the model-updating strategy for generic spatiotemporal signals.}
}
@article{LIU2026136585,
title = {Scenario-adaptive scheduling of cascade hydro-wind-solar-pumped storage systems driven by hydrological variability},
journal = {Journal of Hydrology},
volume = {681},
pages = {136585},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136585},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016823},
author = {Lu Liu and Chao Ma and Muhan Li and Zexing Deng},
keywords = {Runoff-dominated resource scenarios, Cascade hydropower, Pumped storage, Bundled power delivery, Optimal operation},
abstract = {Hydrological variability changes both water availability and reservoir regulation margins, but its implications for scheduling-window selection under uniform bundled power delivery remain insufficiently understood. This study develops a scenario-adaptive scheduling framework for a cascade hydro-wind-solar-pumped storage complementary system (CHWSPCS). A coordinated operation model combines long-term reservoir boundaries, shared-reservoir pumped storage, transmission limits, and a daily delivery profile repeated over multi-day windows. Monthly cumulative-runoff quantiles distinguish high-runoff (alpha), normal, and low-runoff (beta) scenarios while retaining concurrent wind and photovoltaic inputs. Recommended windows are extracted from optimization results using a tolerance-based hierarchical rule that prioritizes delivered energy, followed by loss of load probability (LOLP) and curtailment rate (CR). The framework is verified using a CHWSPCS in the middle reaches of the Yalong River, China. The results indicate that: (1) The proposed strategy effectively coordinates hydropower, wind, photovoltaic and pumped storage units, significantly improving the reliability of bundled power delivery under diverse scenarios; (2) Abundant inflow supports greater delivery but can increase hydropower curtailment and planned-delivery shortfalls under constrained release and transmission conditions. Limited inflow increases the importance of inter-day water allocation and coordination with variable renewable generation. (3) With a 1.0% delivered-energy tolerance, alpha flood-season recommendations are 3–5 days, whereas beta non-flood recommendations vary from 3 to 15 days across months. (4) Under repeated 7-day delivery, reducing pumped-storage capacity from 1200 to 600 MW increases median LOLP by 1.323–2.053 percentage points. The framework links scheduling-window selection to hydrological conditions and reservoir flexibility, while numerical recommendations require recalibration for other systems.}
}
@article{WANG2026136646,
title = {Decomposition, quantification and reduction of hydrological modelling uncertainty across multiple climate zones},
journal = {Journal of Hydrology},
volume = {681},
pages = {136646},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136646},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017439},
author = {Yuhao Wang and Zhanling Li and Yingtao Ye and Xiaoyan Zhai and Zhanjie Li},
keywords = {Hydrological modelling, Uncertainty contribution, Variance decomposition, WASMOD-E, Uncertainty reduction},
abstract = {Hydrological simulations are subject to substantial uncertainties arising from factors such as meteorological forcing, model structure, and parameter selection. Yet the uncertainty contributions from the factors and targeted uncertainty reduction strategies especially across different climate zones remain insufficiently understood. To address this limitation, we investigated 12 watersheds across three major climate zones in China using the lumped conceptual hydrological model WASMOD-E. A new framework was developed to evaluate model applicability, quantify simulation uncertainty, decompose the uncertainty contributions of meteorological products, model structures, and model parameters using MANOVA, and further propose targeted uncertainty reduction strategies. The results showed that: (1) the WASMOD-E model exhibited good applicability across the study areas, with better simulation performance in the northwestern arid zone (NAZ) and the Tibetan Plateau zone (TPZ); However, the NAZ has the largest simulation uncertainty according to the evaluation indicators, and the TPZ has the smallest uncertainty. (2) meteorological products were the primary uncertainty contributor in the NAZ and TPZ, model structures contributed most in the the Eastern Monsoon Zone (EMZ), and model parameters contributed marginally in all study areas; (3) the proposed dynamic quantile weighting and adaptive Bayesian model averaging strategies were proved to be effective in enhancing simulation accuracy and reducing the uncertainties arising from meteorological products and model structural variations, providing a flexible and practical solution for uncertainty reduction under changing hydrometeorological and model structural conditions. By clarifying the patterns governing the hydrological uncertainties across the climate zones, this study provides new insights for improving hydrological models and enhancing hydrological simulation forecasting capabilities.}
}
@article{TEHSEEN2026136593,
title = {Climate-driven future changes in Arctic river discharges using hydrological modelling and CMIP6 projections},
journal = {Journal of Hydrology},
volume = {681},
pages = {136593},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136593},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016902},
author = {Asfand Tehseen and Joy Bhattacharjee and Aino Saarinen and Elina Kasvi and Ville Kankare and Petteri Alho},
keywords = {Arctic, Climate change, Regime shift, Hydrological intensification, Trends},
abstract = {Arctic amplification is intensifying the hydrological cycle of high-latitude river systems, yet quantitative projections of future discharge remain scarce for many Arctic catchments. This study quantifies the impacts of climate change on the discharge regime of the Tana River, a pristine transboundary Arctic catchment in northern Fennoscandia, using the SWAT+ hydrological model driven by five CMIP6 GCMs and an ensemble under four SSP scenarios. The model was calibrated and validated against observed daily discharge at three gauging stations. The findings demonstrate that the Tana River’s discharge regime is already on a trajectory of significant change. The future simulations reveal systematic, SSP-dependent changes in the monthly discharge distribution, seasonal flow patterns, and annual projections through 2100. The timing of peak flow is projected to shift from June to May across most of the GCMs and scenarios, reflecting earlier snowmelt driven by rising temperatures. Seasonal analysis indicates increased flows in winter, spring, and autumn, and decreased flows in summer. By the end of the 21st century, annual discharge, precipitation and mean temperature are projected to increase, while the snow fraction is projected to decline. Under different SSPs, discharge exhibits statistically significant increasing trends, with Pettitt tests identifying change points around mid-century. These predicted changes may have significant implications for the ecosystem, flood risk, and water resource management in the Arctic region.}
}
@article{DANYANG2026136654,
title = {Responses of heavy metal concentrations and partitioning to water-source-associated suspended sediment gradients in a Tibetan Plateau river},
journal = {Journal of Hydrology},
volume = {681},
pages = {136654},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136654},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017518},
author = {Wang Danyang and Tang Xianqiang and Liu Han and Li Rui},
keywords = {Duoma River, Heavy metal, Hydrochemistry, Suspended sediment, Tibetan Plateau},
abstract = {Heavy metals threaten fragile high-altitude river ecosystems, yet how variations in the water sources feeding river and associated suspended sediment influence riverine metal concentrations and dissolved-particulate partitioning remains poorly understood. To address this, we conducted in situ sampling in Duoma River on the Tibetan Plateau during the flood and pre-flood seasons. Across both seasons, Concentrations of Cu, As, Pb, and Zn were 6.0-11.8, 2.4-4.8, 2.7-2.8, and 25.9-289.9 μg/L, respectively. Suspended sediment concentrations followed a consistent gradient among water-source types (spring-fed < wetland-fed < mixed-source < glacier/snowmelt-fed), spanning 6.7-14,907 mg/L, whereas Fe/Mn oxide contents in suspended sediment showed the opposite gradient. These contrasts in sediment concentration and composition were associated with marked differences in metal concentrations and partitioning among water source types. Dissolved metal concentrations, metal concentrations per unit mass, and particle-water distribution coefficients were generally higher in spring- and wetland-fed waters, while glacier/snowmelt-fed and mixed-source waters had higher particulate metal concentrations per unit volume of water and generally higher particulate fractions. Differences among metals in their affinity for particles further shaped how these sediment contrasts were expressed in metal occurrence. Pb had the highest particulate fraction and distribution coefficient and As the lowest.}
}
@article{NIGRO2026136565,
title = {The importance of measurement uncertainties in the regression of hydrogen and oxygen isotope values},
journal = {Journal of Hydrology},
volume = {681},
pages = {136565},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136565},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016628},
author = {Matteo Nigro and Michele Barsanti and Stefano Natali and Marco Luppichini and Polona Vreča and Daniele Penna},
keywords = {Isotope hydrology, Water stable isotopes, Meteoric water lines, Regression, Uncertainties, York regression},
abstract = {The isotopic composition of hydrogen (2H) and oxygen (18O) in water is an established and powerful tool in hydrological sensu lato investigations. Since Craig (1961) first documented the δ2H-δ18O linear relationship in meteoric water across the globe, the Global Meteoric Water Line (GMWL − δ2H = 8 ∗ δ18O + 10), researchers have explored the variability in meteoric water lines both globally and locally. The isotopic composition of precipitation reflects fractionation processes during evaporation, condensation, and moisture transport, which are conditioned by the temperature, humidity, and morphological location of each site. Local Meteoric Water Lines (LMWLs) represent the relationship of δ2H-δ18O at one specific site or area and are used for numerous hydrological, hydrogeological, and ecohydrological applications. A correct computation of LMWLs is, therefore, crucial. Several statistical regression methods have been employed to compute LMWLs: the Ordinary Least Squares regression (OLS), the Reduced Major Axis regression (RMA); the Major Axis regression (MA, also known as orthogonal regression), and the Error-In-Variables regression (Argiriou and Lykoudis, 2006 and Boschetti et al., 2019) which considers measurement uncertainties in δ2H and δ18O. Some landmark papers in isotopes hydrology correctly argued that measurement uncertainties in δ2H and δ18O should be included in the regression methods, and consequently suggested the use of RMA and MA regression as the most suited for computing LMWLs. RMA and MA thus became the most common regression approaches. However, in those works, variables’ uncertainties are not inserted in RMA and MA equations; consequently, uncertainties are not used in the following works. A complete description of the implementation of δ2H and δ18O measurement uncertainties in the computation of MWL regression is absent in the isotope hydrology literature. In this work, we illustrate how to correctly account for measurement uncertainties on both hydrogen and oxygen when performing their linear regression with the long established least-squares estimation (LSE). We discuss the assumptions to carry out the regression, the statistical methodology, and the evaluation of the goodness of fit. When computing the slope and intercept fit parameters the LSE regression is the least biased compared with OLS, RMA, and MA regressions. Four simulations are presented along to better illustrate the method application and evaluation of goodness of the fit statistic. Software tools, in R and Python, for computing the regression of water isotopes data (indeed any data) with uncertainties in both variables are provided. The use of the proposed method provides a better computation of MWLs (and of linear regressions of isotopic data in general) and the possibility of effectively evaluating the goodness of the computed linear fits. This method is not specific and thus applicable to any case in which the X and Y variables are characterised by measurement uncertainties.}
}
@article{YANG2026136581,
title = {Lithium isotopes as a proxy for hydrological-climate variation in the modern catchments and geological archives of salt lakes, Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {681},
pages = {136581},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136581},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016781},
author = {Jilei Yang and Fei Zhang and Qingkuan Li and Tianyuan Chen and Qishun Fan},
keywords = {δLi, δO, Paleohydrology, New proxy, Lake evolution},
abstract = {Reconstructing the paleohydrology of Tibetan Plateau (TP) saline lakes is essential for assessing current hydrological expansion and predicting future changes. However, conventional proxies like δ18Ocarbonate are often confounded by temperature or precipitation effects. This study proposes lithium isotopes (δ7Lidissolved) from river-lake systems and lacustrine sediments as a novel hydrological-climate proxy. We compiled published δ7Li-δ18O data from TP waters (hot springs, rivers, saline lakes) and analyzed two sediment δ7Li sequences from Bangor Co (southern TP) and Qarhan Salt Lake (northern TP). Results show that δ7Lidissolved is more sensitive to hydrological change than δ18O and progressively increases along the source-transport-sink continuum. Riverine δ7Li correlates positively with high discharge in geothermal recharge catchments but negatively in silicate weathering catchments. Sediment Li isotopes record distinct hydrological responses during the evolution from mega lakes to saline lakes since the last interglacial. In Bangor Co, δ7Liwater-soluble decreases due to geothermal input, with limited δ7Licarbonate data supporting this pattern, whereas in Qarhan, δ7Li in both phases increases under silicate weathering. These sediment patterns match modern catchment-specific δ7Liriverine behavior, reflecting divergent mechanisms: mixing of low-δ7Li geothermal water with high-δ7Li meteoric water in geothermal catchments, versus water–rock interaction time regulated by discharge in weathering-dominated catchments. We conclude that δ7Liwater-soluble in sediments is a sensitive hydrological proxy with weaker temperature dependence than δ18O, in combination with consistent hydrological-climate variation patterns across terrestrial archives over multiple temporal scales. These comparisons offer a significant advantage over δ18Ocarbonate for reconstructing lake paleohydrological-climate and serve as a compelling alternative proxy.}
}
@article{HEMINGWAY2026136621,
title = {Accounting for the unaccounted: a new framework for incorporating farm social diversity in micro-regional water budgets},
journal = {Journal of Hydrology},
volume = {681},
pages = {136621},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136621},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601718X},
author = {C. Hemingway and C. Aubron and R. Chitra-Tarak and M. Vigne and G. Boulet and M. Sekhar and L. Ruiz},
keywords = {Agrarian systems, Comparative agriculture, Groundwater irrigation, Water accounting, Social diversity, India},
abstract = {Aquifer overexploitation in irrigated regions calls for better water-flow quantification, yet existing methods are data-intensive and often overlook farmers’ social diversity. We propose a framework representing water flows in small regions while accounting for farm social diversity, distinguishing groundwater users and non-users. We introduce the Blue Water Potential (BWP) indicator, using a simplified soil water balance at plot and farm levels and a mixed-methods archetype village approach to aggregate water flows. We applied this framework to a semi-arid region of southern India, examining how BWP differs across farm typologies and between the 1950s and 2022, and how contributions of these farm types combine to determine village BWP in each period. Results show that, at the plot scale, BWP varies widely depending on land use. At the farm level, all production systems had positive BWP in the 1950s; in 2022, irrigating farmers show largely negative BWP, while those growing mainly rainfed crops and pastoralists maintain positive BWP. At the village level, negative BWP of a minority of wealthy irrigators is balanced by positive BWP of poorer rainfed farmers and pastoralists. By accounting for farmers’ social diversity, our framework reveals contrasting roles in groundwater dynamics and introduces the concepts of ‘blue water consumers’—groundwater-dependent farmers—and ‘blue water producers’—rainfed and pastoral farmers whose land uses contribute to groundwater recharge—highlighting how the former rely on the hydrological contributions of the latter. This approach represents groundwater-related interdependencies between social groups, supporting equitable groundwater governance, scenario planning, and management.}
}
@article{YUAN2026136678,
title = {High-frequency monitoring and reconstruction of lake water temperature with meteorological observations},
journal = {Journal of Hydrology},
volume = {681},
pages = {136678},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136678},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017750},
author = {Hanxiao Yuan and Songtao Ai and Changhong Hu and Runchuan Ouyang and Shoukat Ali Shah and Xinde Chu and Qiuhua Tang and Wolfgang Rack and Christo Pimpirev},
keywords = {Water temperature, Wavelet analysis, Deep learning, Reconstruction, Sustainability},
abstract = {Lakes, as vital components of land water systems, play crucial roles in local climate regulation and ecological functions. Water temperature is a key indicator of lake thermal dynamics and climate sensitivity, while its high-frequency variations and coupling mechanisms with meteorological drivers remain insufficiently understood, especially under extreme weather conditions. To bridge this gap, we conducted a detailed investigation of Qinghai Lake using high-resolution (1 h interval) observations of water temperature and meteorological variables from October 2023 to October 2024. We developed a comprehensive analytical framework incorporating statistical analysis, wavelet time–frequency decomposition, anomaly detection, and deep learning-based reconstruction. The results reveal a strong nonlinear relationship between water and air temperature, as demonstrated by RAPS trend analysis and S-curve regression (R2 = 0.82). Wavelet coherence analysis indicates robust coupling at diurnal and synoptic timescales, with a distinct temporal lag in the lake’s thermal response to atmospheric forcing. Anomaly detection further highlights the critical role of strong wind and precipitation in driving abrupt water temperature shifts. To improve reconstruction performance, we propose a novel PCA-GRU-MA model, which integrates Principal Component Analysis (PCA), Gated Recurrent Units (GRU), and Multi-Head Attention mechanisms (MA). Model validation demonstrates superior accuracy compared to seven benchmark models (RMSE = 1.55 °C, MAE = 1.15 °C, NSE = 0.94), underscoring its capacity to capture thermal anomalies and effectiveness in reconstructing hourly water temperature. This study advances the understanding of high-resolution lake thermal dynamics and offers a methodological foundation for lake ecosystem management, climate change adaptation, and early-warning systems.}
}
@article{ZHANG2026136650,
title = {A public-data-driven framework for urban flood modelling and credibility assessment under detailed-data scarcity},
journal = {Journal of Hydrology},
volume = {681},
pages = {136650},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136650},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017476},
author = {Yubin Zhang and Xiaojuan Zhao and Tianyu Feng and Yixuan Zhang and Pingping Luo},
keywords = {Urban flood modelling, Detailed-data scarcity, Public-data-driven modelling, Synthetic drainage network, Data-driven spatial credibility},
abstract = {Urban flood modelling in data-scarce cities is limited by the absence of high-resolution hydraulic terrain, drainage-network maps, inlet records, calibrated parameters, and systematic flood observations. This study proposes a public-data-driven framework for planning-level flood-prone pattern diagnosis under detailed-data scarcity. The framework combines Urban Hydraulic Surface Model (UHSM) reconstruction, road-based generalized drainage-network inference, storage-conserving 1D-2D surface-drainage coupling, capacity-matched equivalent drainage comparison, sensitivity analysis, and Data-Driven Spatial Credibility (DDSC) assessment using screened public evidence. In Xiaozhai, Xi’an, the comparison included a static terrain proxy and four dynamic configurations representing raw public terrain, UHSM reconstruction, equivalent drainage, and explicit 1D-2D drainage coupling. A second case in Zhengzhou was used to examine whether the same workflow could be reproduced in another city. Results show that UHSM reconstruction reduced scattered shallow ponding produced by the raw public DEM and generated more hydraulically interpretable flood-prone patterns. Equivalent drainage mainly acted as a local surface-water removal term, whereas explicit drainage coupling partitioned captured water into surcharge return flow, outfall export, and temporary pipe storage under closed water balance. Public-evidence assessment showed that high evidence hit rates alone are insufficient because sparse and road-biased evidence may also be matched by overly broad model support. Combining evidence agreement, evidence-to-model distance, model-support extent, and sensitivity diagnostics provided a more cautious credibility assessment. The Zhengzhou case demonstrated methodological portability, but not predictive validation of the synthetic drainage network. The proposed framework provides a reproducible approach for preliminary urban flood screening and model-structure diagnosis where detailed drainage and validation data are unavailable.}
}
@article{ZHU2026136634,
title = {Hydrodynamic regulation of microbial coupling between nitrate reduction and carbon fixation in a karst conduit–fissure aquifer},
journal = {Journal of Hydrology},
volume = {681},
pages = {136634},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136634},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017312},
author = {Danni Zhu and Haiping Lu and Yi Li and Lihua Niu and Changsong Zhou and Shengzhang Zou},
keywords = {Conduit flow, Fissure flow, NO reduction, C fixation, Microbial mechanism},
abstract = {Hydrodynamic contrasts between conduit and fissure domains may regulate nitrate (NO3−) attenuation and carbon (C) transformation in karst aquifers, but the microbial mechanisms linking these processes remain poorly understood. Herein, the coupled C and nitrogen (N) cycling were investigated using stable isotope analysis, 15N-tracer incubations, and metagenomic sequencing in a typical karst conduit–fissure system. In conduit water (CW) with high flow velocity (mean: 665 m d−1), TN, NO3−, and DIC decreased significantly, whereas DOC, δ15N–NO3−, and δ13CDIC increased synchronously. Such coordinated changes were not observed in fissure water (FW) with low flow velocity (mean: 205 m d−1). 15N-tracer incubations showed that dissimilatory nitrate reduction (denitrification and DNRA) rates were higher in CW and positively correlated with δ13CDIC and DOC. These observations collectively indicated stronger coupling between NO3− reduction and microbial C transformation in CW. Metagenomic co-occurrence networks further revealed pathway-specific associations between NO3− reduction and microbial C fixation in CW, with dissimilatory nitrate reduction linked to the rTCA cycle and assimilatory nitrate reduction associated with the CBB cycle. Genome-scale metabolic modeling suggested that NO3− reduction in CW was mainly associated with heterotrophic nitrate-reducing taxa, such as Tabrizicola and Sediminibacterium, and was potentially supported by metabolite cross-feeding from autotrophic carbon-fixing taxa, including Limnohabitans and Prosthecobacter. In contrast, NO3− reduction in FW appeared to be driven predominantly by autotrophic nitrate-reducing bacteria with significantly lower metabolic connectivity. Groundwater flow velocity indirectly regulated the coupled NO3− reduction and C fixation by enhancing microbial network connectivity and metabolic cooperation among functional guilds. These findings advance our understanding of NO3− pollution mitigation and subsurface C fixation in karst aquifers.}
}
@article{QU2026136658,
title = {New insight into the biogeochemical fingerprint of nitrate: linking chemical weathering and carbon cycling to groundwater discharge},
journal = {Journal of Hydrology},
volume = {681},
pages = {136658},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136658},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017555},
author = {Shen Qu and Zhongli Wang and Le Qiao and Wei Bao and Lijuan Hu and Wengeng Cao and Limin Duan and Xiaomin Liu and Ruihong Yu},
keywords = {Nitrate, Carbon cycle, Biogeochemical process, Multi-isotopic models, Groundwater discharge},
abstract = {Anthropogenic nitrate enrichment reshapes biogeochemical cycling, yet its role in linking chemical weathering and carbon cycling during groundwater discharge across lake and river basins remains poorly understood. Here, multi–isotopic tracers (δ15N, δ18Onitrate, 222Rn), 16S rRNA data, and a corrected forward model are integrated to quantify nitrate sources, groundwater discharge processes, and weathering-related CO2 consumption, and to explore microbial associations with nitrogen and carbon cycling. Results show nitrate primarily originates from sewage/manure (45.8%–57.4%), soil nitrogen (17.4%–30.7%) and fertilizer (18.4%–19.2%). Groundwater discharge rates range from (3.4 ± 3.3) × 104 m3/d to (1.2 ± 1.8) × 105 m3/d, transporting 106–107 g/d nitrate to surface water. Nitrification dominates nitrogen transformations, releasing H⁺ that accelerates carbonate and silicate weathering, with average CO2 consumption rates of 0.1 × 105 mol/km2/yr and 0.6 × 105 mol/km2/yr, respectively. Elevated nitrate was associated with reduced net CO2 consumption and a potential theoretical shift from a CO2 sink toward a CO2 source. Microbial community composition was associated with nitrogen and inorganic carbon variables, while PICRUSt2 predictions suggested potential links between nitrification-related functions and autotrophic carbon fixation. This study highlights nitrate as a potentially important biogeochemical linkage agent linking nitrogen cycling, chemical weathering, and carbon dynamics, providing insights for water quality protection and carbon sink assessment in groundwater-dependent ecosystems.}
}
@article{MOREL2026136428,
title = {Drone–based camera discharge derived from the entropy–based probability concept and image velocimetry algorithms},
journal = {Journal of Hydrology},
volume = {681},
pages = {136428},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136428},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015258},
author = {Duncan B. Morel and Christopher A. Kirk and John W. Fulton and Frank L. Engel and Carl J. Legleiter and Brandon T. Forbes and Noah Eno and Matthew J. Nicotra and Matthew C. Gyves and Robert R. Lotspeich and Heather R. Best},
abstract = {In June and August 2023, the U.S. Geological Survey (USGS) conducted small Uncrewed Aircraft System (sUAS or drone) flights at five streamgages in the Upper Colorado River Basin, Colorado, USA. The objectives of this research were (1) compare maximum surface velocities and discharges derived from Space-time Image Velocimetry (STIV) and Particle Image Velocimetry (PIV) and (2) evaluate drone-based camera algorithms that rely on the entropy-based probability concept and mid-section method relative to standard discharge measurements. To evaluate the scalability and transferability of the methods, river reaches were selected with varying top widths, depths, and discharges and colocated with existing USGS streamgages. Percent errors between drone-based camera algorithms and hydroacoustic measurements were substantially smaller for large rivers such as the Colorado River, Colorado when compared to small rivers such as the Blue River, Colorado. A Wilcoxon signed-rank test suggests there was no difference between the discharges generated by STIV and PIV algorithms and hydroacoustic measurements. This implies that, if the appropriate algorithms are properly parameterized, drone-based camera discharges are consistent with standard discharge measurements when siting is conducted appropriately.}
}
@article{HAN2026136630,
title = {Seasonal reorganization of vertical partitioning in microbial carbon fixation in a high-altitude saline lake},
journal = {Journal of Hydrology},
volume = {681},
pages = {136630},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136630},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017270},
author = {Yixuan Han and Xiaoyan Li and Fangzhong Shi and Guangrong Hu and Xin Liu and Zhigang Wang and Rui Wang and Jingjing Wu and Wenhao Zhang and Yishu Meng},
keywords = {Microbial carbon fixation, Dark carbon fixation, Light dependent carbon fixation, Seasonal dynamics, C-N-S coupling, Qinghai Lake},
abstract = {Microbial carbon fixation links dissolved inorganic carbon assimilation with carbon cycling in aquatic ecosystems, yet how seasonal environmental gradients reorganize carbon fixation through the water column remains poorly understood in high-altitude saline lakes. Here, we quantified seasonal and vertical variations in light-dependent carbon fixation (LCF) and dark carbon fixation (DCF) by integrating carbon fixation rates with physicochemical variables, microbial community composition, and C-, N-, and S-cycling functional potentials throughout an annual cycle in Qinghai Lake (QHL). Microbial carbon fixation exhibited four distinct seasonal vertical configurations, with LCF dominating during summer stratification and DCF contributing proportionally more under winter ice cover. The transition depth between LCF and DCF shoaled progressively from approximately 16.7 m in summer to 10.2 m in autumn and 5.4 m in winter before disappearing during spring mixing, demonstrating seasonal reorganization of the vertical partitioning of microbial carbon fixation. These seasonal patterns were explained more consistently by microbial functional potential than by taxonomic composition, with Calvin-Benson-Bassham (CBB) cycle genes prevailing under favorable light conditions and alternative carbon assimilation together with coupled nitrogen and sulfur metabolism becoming more important under low-light conditions. Together, these findings show that seasonal environmental gradients reorganize the vertical partitioning of microbial carbon fixation primarily through shifts in microbial metabolic potential, providing a process-based understanding of microbial carbon assimilation in high-altitude saline lakes.}
}
@article{LIANG2026136610,
title = {Agricultural land-use change rivals climate variability in driving blue water consumption in arid Xinjiang: a factorial counterfactual attribution},
journal = {Journal of Hydrology},
volume = {681},
pages = {136610},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136610},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017075},
author = {Qixiang Liang and Yanfeng Di and Xingming Hao and Mengtao Ci and Fan Sun and Jingjing Zhang and Zulipiya Kulaixi and Chuan Wang and Xue Fan and Xinran Guo},
keywords = {Agricultural land use conversion, Blue water crisis, Remote sensing, Counterfactual scenarios, Xinjiang},
abstract = {Agricultural expansion and crop structure adjustments in arid regions have profoundly reshaped regional water consumption patterns. Yet, a quantitative understanding of the independent and combined impacts of agricultural land-use (ALU) conversion and climate change on water resources remains limited. In this study, we developed a 30-meter resolution crop type dataset for Xinjiang spanning 2013–2024, derived from multi-source remote sensing imagery and field sampling data. By integrating evapotranspiration (ET) products with counterfactual simulations, we quantitatively disentangled the causal effects of ALU conversion and climate change on blue water consumption. Results show that relative to the 2013–2015 baseline, Xinjiang’s total agricultural water use increased by 35.45 × 108 m3 during 2016–2024, with climate change contributing 22.50 × 108 m3 and ALU conversion contributing 12.95 × 108 m3. For irrigation (blue) water, the total increase was 32.87 × 108 m3, to which ALU conversion contributed 16.67 × 108 m3 and climate change 16.20 × 108 m3—almost equal magnitudes. The expansion of cotton and reclamation of non-agricultural land (Non-ALU) substantially intensified irrigation demand, whereas conversion to orchards and other economic crops effectively reduced blue water consumption. These results show that climate change dominates the increase in total agricultural water use, whereas ALU adjustment exerts a comparable influence on blue water consumption. Accordingly, water-resource planning should constrain further regional cotton expansion and non-agricultural reclamation in water-stressed areas, dynamically adjust irrigation quotas in response to climate-driven evapotranspiration demand, and protect part of the resulting water savings for environmental flows and wetland maintenance. These measures can help reconcile agricultural production with ecological water requirements under continued climate change.}
}
@article{LE2026136662,
title = {From static susceptibility mapping to rainfall-driven spatiotemporal urban flood prediction: a joint susceptibility–depth learning framework},
journal = {Journal of Hydrology},
volume = {681},
pages = {136662},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136662},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017592},
author = {Thuan Thanh Le and Tuong Quang Vo and Jongho Kim},
keywords = {Urban flood prediction, Rainfall-driven spatiotemporal modeling, Temporal rainfall forcing, Flood susceptibility, Bivariate multitask learning, TCN-Transformer},
abstract = {Urban flood prediction has traditionally relied on static susceptibility mapping or single-output inundation estimation, limiting its ability to represent rainfall-driven flood evolution under varying spatial conditions. This study proposes HydroX-Risk, a hybrid rainfall-driven spatiotemporal deep learning framework for the joint prediction of urban flood susceptibility and inundation depth. The proposed architecture integrates a CBAM-enhanced convolutional spatial encoder with a hybrid TCN-Transformer rainfall module within a unified multitask learning framework. Using an event-based dataset for Seoul from 2010 to 2024, HydroX-Risk achieved strong predictive performance, with an accuracy of 0.89, an AUC of 0.95, and an F1-score of 0.88 for flood susceptibility classification, together with an MAE of 0.08 m and an RMSE of 0.15 m for inundation depth estimation. Comparative experiments demonstrated improved performance relative to both the spatial-only baseline (HydroX-Risk-S) and the univariate framework (HydroX-Risk-U), highlighting the added value of rainfall-driven temporal modeling and bivariate multitask learning. The framework advances urban flood prediction from static susceptibility mapping toward rainfall-driven spatiotemporal modeling by jointly modeling temporal rainfall forcing and spatial flood susceptibility to learn rainfall-conditioned flood responses. Bayesian optimization and SHAP analyses further enhanced model robustness and interpretability. SHAP analyses revealed heterogeneous contributions of rainfall and spatial predictors to the predicted flood responses and showed that identical rainfall forcing can be associated with substantially different predictions depending on local spatial conditions. Dominant local predictors, including DTRiver, DTDrainage, DTRoad, and Aspect, highlighted the importance of local river proximity, drainage configuration, road proximity, and terrain orientation in the model predictions. Overall, HydroX-Risk advances urban flood prediction toward interpretable rainfall-driven spatiotemporal flood modeling under evolving storm conditions.}
}
@article{SHEN2026136596,
title = {Predicting drought dynamics and high-standard farmland suitability in Shanxi Province using a GAT-based multi-model framework},
journal = {Journal of Hydrology},
volume = {681},
pages = {136596},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136596},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016938},
author = {Yongheng Shen and Azhar Ali Laghari and Qingxia Guo and Junzhe Zhang and Yalin Wang and Yanli Shen and Zhenghao Liu and Da Fang and Bheel Chander Kumar},
keywords = {Drought prediction, Graph Attention Network (GAT), High-standard farmland (HSF), Machine learning, Climate change, Agricultural resilience},
abstract = {Climate-induced drought evolution substantially impacts cropland patterns, but conventional downscaling and simulation methods limit prediction accuracy. Taking the semi-arid Shanxi Province in Northern China as the study area, this research proposes a hybrid Delta-MLs downscaling method and introduces Graph Attention Networks (GAT) to predict two directionally consistent drought indices, the Standardized Precipitation Evapotranspiration Index (SPEI-D) and the Temperature Vegetation Dryness Index (TVDI-D). The Meteorological Drought and Surface Response-Cropland Resilience (MDSR-CR) framework is then applied to assess municipal-level high-standard farmland (HSF) suitability. Results show that: (1) hybrid models (Delta-KNN and Delta-XGBoost) outperform single methods in correcting meteorological and hydrological variables, with KNN appearing to better preserve spatial patterns than XGBoost; (2) SPEI-D drought will intensify across all scenarios, especially under SSP585, with changes mainly related to topography and vegetation, while TVDI-D drought shows the greatest variability under SSP370 and the least under SSP245, primarily associated with the combined effects of natural and anthropogenic factors; (3) a structural mismatch exists between HSF-suitable areas and the distribution of cultivated land resources across cities, highlighting the need for differentiated construction strategies. This study demonstrates that integrating remote sensing and intelligent modeling offers a promising framework for drought assessment and agricultural suitability, providing insights for climate-resilient farmland planning.}
}