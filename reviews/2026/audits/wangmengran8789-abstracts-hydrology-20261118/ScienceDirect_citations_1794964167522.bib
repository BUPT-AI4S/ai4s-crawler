@article{LI2026136637,
title = {Effects of water depth and exit width on bottleneck evacuation dynamics under flood conditions},
journal = {Journal of Hydrology},
volume = {681},
pages = {136637},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136637},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017348},
author = {Xintong Li and Chenglin Guo and Jun Zhang and Weiguo Song},
keywords = {Pedestrian dynamics, Flooding evacuation, Bottleneck flow, Water depth},
abstract = {Floods pose a growing threat to urban safety, particularly in buildings and underground infrastructures where evacuation often depends on pedestrian movement through bottleneck exits. Although previous studies have shown that floodwater reduces pedestrian mobility, its effects on bottleneck capacity, flow organization, and congestion dynamics remain insufficiently understood. This study presents the first systematic investigation of pedestrian evacuation through bottlenecks across four water-depth conditions (0, 0.35, 0.60, and 0.90 m) and exit widths ranging from 0.5 to 1.9 m. Increasing exit width improves evacuation efficiency under all conditions, whereas the average specific flow under flooded conditions is approximately 36% lower than that under no-water conditions. In contrast, differences in specific flow among the three flooded conditions are relatively small. Flooded conditions increase time headway and delay the transition from intermittent to continuous flow. Using an average burst size of 〈s〉⩾2 pedestrians as the criterion, the critical exit width for the onset of continuous flow increases from 0.9 m under no-water conditions to 1.3 m under flooded conditions. By comparison, distance headway is less sensitive to water depth, indicating that pedestrians primarily adapt to water resistance by reducing speed rather than compressing interpersonal spacing. Greater water depth enlarges the upstream high-density region and intensifies congestion. Stopping time decreases with increasing exit width and approaches zero at the critical width associated with the onset of continuous flow. These findings provide empirical evidence for incorporating flood-induced mobility constraints into pedestrian evacuation models and improving flood-risk assessment and evacuation planning in buildings and underground infrastructures.}
}
@article{ZHANG2026136600,
title = {Interval-based multi-objective optimization for multireservoir operation under uncertain inflows},
journal = {Journal of Hydrology},
volume = {681},
pages = {136600},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136600},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016975},
author = {Li Zhang and Wen-jing Niu and Zhong-kai Feng and Hong-wu Tang and Yang Xiao and Tie-sheng Guan and Tao Yang},
keywords = {Interval-Multiobjective optimization, Decision support, Inflow uncertainty, Multireservoir operation},
abstract = {Climate change and evolving water-use patterns have increased the uncertainty involved in cascade reservoir operation. Existing deterministic approaches based on point inflow estimates, as well as scenario-based approaches relying on prescribed probability distributions, may be inadequate for explicitly representing uncertainty propagation across cascade reservoirs and for evaluating the feasibility and risk of joint operation schemes when probabilistic information is limited. This study proposes an interval-based multi-objective operation method for cascade multireservoir systems under uncertain inflows. The proposed method defines inflow uncertainty through prescribed interval bounds and evaluates its operational effects using representative inflow realizations. Sample-based constraint-feasibility assessment and quantitative constraint-violation measures are incorporated to identify feasible operation schemes and characterize their associated operational risks. An interval dominance-based ranking method is further introduced to compare non-dominated schemes with respect to flood control, power generation, and risk characteristics, thereby supporting preference-aware selection among alternative operation strategies. A two-population dynamic cooperation (TPDC) algorithm is employed as the solution engine to efficiently search the constrained interval decision space. A real-world cascade reservoir case study shows that the proposed method can generate well-distributed feasible interval non-dominated solutions, explicitly reveal the uncertainty-related trade-offs between flood-control safety and power-generation benefits, and delineate feasible decision domains under different inflow uncertainty levels. The results further show that objective intervals gradually contract as inflow uncertainty decreases and progressively approach deterministic operation results. The proposed method provides a practical basis for risk-aware and adaptive cascade reservoir operation under uncertain inflow conditions.}
}
@article{MAGAIN2026136419,
title = {An automated adaptative framework for weather data interpolation},
journal = {Journal of Hydrology},
volume = {681},
pages = {136419},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136419},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015167},
author = {Cédric Magain and Guillaume Renard and Philippe Orban and Aurore Degré and Jeroen Meersmans and Caroline De Clerck and Serge Brouyère and Joost Wellens},
keywords = {Spatial interpolation, Automatic selection, Combined error metric, Water balance, Evapotranspiration, Rainfall, Optimum station network, Cross-location validation},
abstract = {Spatially continuous estimates of reference evapotranspiration and rainfall are crucial for environmental management applications. However, their estimation often relies on weather station measurements characterized by incomplete temporal records. Spatial interpolation methods (SIMs) address this issue but are variable and data-specific, making their selection challenging due to dynamic, unharmonized networks and missing data. Advances in computing capabilities enable automation of selection routines, allowing development of automatic SIMs selection process. Several authors proposed employing combined metrics to optimize model selection. Accordingly, this paper developed a new composite metric (CM), based on random and systematic error, integrated into an automated process, called JWgrid (Judicious Widget for Geospatial Robust Interpolation Design or JW), to identify optimal interpolation methods across various contexts. Using Leave-One-Out Cross-Validation (LOOCV), the SIM with the lowest CM value is selected from popular interpolation techniques. The methodology was assessed on weather station networks in Luxembourg, evaluating rainfall and reference evapotranspiration related variables. Results showed low error values with SIM selection frequencies being variable dependent. The methodology’s robustness was assessed by (1) reducing data to 25, 50, and 75% of the original network size, (2) using synthetic datasets with varying data variability, network configurations, and presence or absence of an external drift and (3) applying to a mountainous study area. Network density minimally affected overall accuracy, though SIM selection frequencies varied with no universally preferable method. In synthetic tests and the mountainous area, the JW methodology performed at least equally to the best single method by selecting the most appropriate method at every timestep. Those results highlight the proposed methodology’s advantages, producing reliable gridded datasets across diverse climatic conditions. The approach enables users with limited SIMs experience to easily generate gridded data, providing an effective solution for spatial interpolation challenges in environmental applications.}
}
@article{ZAMBRANO2026136584,
title = {Agricultural land-use composition modulates hydroclimatic coupling of cropland water use efficiency under prolonged aridification: sub-watershed evidence from Chile’s megadrought},
journal = {Journal of Hydrology},
volume = {681},
pages = {136584},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136584},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016811},
author = {Francisco Zambrano and Francisco Fernández and María Molinos-Senante},
keywords = {Water use efficiency, Megadrought, Aridification, SPEI, Chile, NPP/ET, Crop composition},
abstract = {Cropland water-use efficiency (WUE; net primary productivity divided by actual evapotranspiration) is widely expected to improve under technological intensification, yet its response to prolonged aridification at regional scales is poorly understood. We analyzed spatiotemporal patterns of WUE across 127 Chilean agricultural sub-watersheds from 2001 to 2020, a period spanning an unprecedented megadrought. WUE responses were spatially heterogeneous: arid and semi-arid sub-watersheds showed predominantly negative ΔWUE, while irrigated Mediterranean sub-watersheds showed positive ΔWUE; negative long-term trends and structural breaks were concentrated in the 30–35 ∘S band. Precipitation deficit indices dominated cross-sectional WUE sensitivity; at the 36-month accumulation scale, SPEI (Standardized Precipitation-Evapotranspiration Index) and SPI (Standardized Precipitation Index) showed practically equivalent explanatory power (two one-sided tests p < 0.001, 90% CI [−0.004, +0.003]). Crop system composition is associated with WUE drought sensitivity through two contrasting patterns, each constrained by a different form of confounding. Annual-crop prevalence is robustly and negatively associated with drought sensitivity across all latitude-control specifications (spatial error model [SEM] β range: −0.341 to −0.591, p < 0.01); whether this reflects structural buffering or drought-driven reduction of annual cultivation cannot be established from the observational data alone. Irrigation infrastructure prevalence shows a positive association with WUE-drought coupling that is not distinguishable from the latitudinal aridity gradient: it is significant in the full sample (SEM β = +0.438, p < 0.001) but attenuates to non-significance when latitude is explicitly controlled (β = +0.117, p = 0.309; ΔAIC = 19.8). Geographic cross-validation confirms that the quantitative crop-composition model does not transfer across latitude bands within Chile (per-block out-of-sample R2 range: −1.25 to −0.29), with every held-out block being predicted worse than its own mean, indicating that the coefficients capture a spatially contingent configuration rather than generalizable structural parameters. Both crop-composition associations are correlational; causal inference is precluded by the observational design and spatial confounding. These findings are consistent with crop-portfolio flexibility reducing structural drought exposure under prolonged aridification, and with WUE-based efficiency metrics being insufficient indicators of agricultural resilience where irrigation supply is hydrologically coupled to the same signals that suppress crop productivity. These results carry implications for water governance and agricultural planning in snowmelt-dependent dryland regions globally.}
}
@article{FILIPIAK2026136645,
title = {A 5-year assessment of radar quantitative precipitation estimates during the cool season over the Midwest and Eastern United States},
journal = {Journal of Hydrology},
volume = {681},
pages = {136645},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136645},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017427},
author = {Brian C. Filipiak and Brendan Raykoff and Matthew Sinchi and Diego Cerrai and Marina Astitha},
abstract = {Wintertime precipitation measurements present challenges as changes in precipitation phase and sub-freezing temperatures can impact the quality of observations from different types of precipitation gauges. Weather radars have a different set of challenges from gauges that include beam blockage, changes in scanning volume size, and application of the most appropriate radar reflectivity to rain rate relationship. Gridded quantitative precipitation estimates (QPEs) from weather radars are commonly used to assess numerical weather model precipitation forecasts or initiate hydrologic modeling, but during the wintertime, concerns over the quality of the QPEs raise questions of when they can be used. Here, two gridded radar-derived, gauge-corrected QPE products, Stage IV and MRMS, were compared to 85 ASOS stations with weighing precipitation gauges, the standard gauge for measuring winter precipitation, across the Great Lakes, Mid-Atlantic, and Northeast United States during five cool seasons. The products were compared over 1-, 6-, and 24-hour QPE accumulations, divided spatially by NWS River Forecast Center, and by observed precipitation phase. The results from this work indicated that Stage IV was statistically closer to in-situ observations compared to MRMS over all accumulation periods. However, the efficacy of the products varied spatially with Stage IV having pronounced regional differences due to its processing procedure. While assessing the impact of precipitation phase, MRMS performed better for liquid precipitation, whereas Stage IV was better for mixed or frozen precipitation. End users can use these results to select the most appropriate QPE radar product depending on the applications related to cool season precipitation.}
}
@article{LUAN2026136653,
title = {Runoff fingerprinting reveals transitions in urban underpass flooding from local surface-runoff convergence to sewer-network feedbacks},
journal = {Journal of Hydrology},
volume = {681},
pages = {136653},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136653},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017506},
author = {Guangxue Luan and Fuqiang Wang and Jingming Hou and Honglin Xiao and Chen Yang and Qingqing Qi and Songlin Yang and Guanghui Wu},
keywords = {Urban underpass flooding, Surface–sewer coupling, Runoff source tracking, Flooding mechanism, Source–pathway–response},
abstract = {Urban underpasses are recurrent hotspots of pluvial flooding, yet the changing roles of local surface–runoff convergence and sewer-network feedbacks in shaping ponding remain poorly understood. This study developed a conservative rainfall–runoff fingerprinting module and embedded it in an existing high-resolution hydrodynamic model that dynamically and bidirectionally couples two-dimensional surface flow with one-dimensional sewer hydraulics, establishing a source-pathway-response diagnostic framework. The framework was applied to four flood-prone underpasses (P1–P4) in Changzhi, China, under seven 2-h design storms with return periods of 1–100 years. The simulations revealed nonlinear and site-specific changes in ponding dynamics. As rainfall intensity increased, ponding changed from a short-lived, first-peak-dominated response to a delayed, second-peak-dominated process; the second ponding peak first exceeded the first in the tested 5-, 2-, 100-, and 5-year scenarios at P1–P4, respectively. The maximum lag relative to the rainfall peak reached 155 min, and the maximum inter-site differences in peak timing reached 140 min. Runoff fingerprinting revealed that early ponding primarily resulted from near-source surface runoff exceeding inlet-capture capacity. Delayed accumulation flooding was triggered when sewer surcharge and node overflow converted the drainage network from a conveyance pathway into an additional water source. Downstream backwater further amplified the second peak and delayed recession. These processes produced three flooding patterns in the simulated cases: surface-runoff-driven local ponding, node-overflow-driven compound flooding, and downstream-backwater-modulated flooding. The findings demonstrate that similar ponding responses can arise from different combinations of runoff supply and drainage constraints. By linking time-varying source contributions to transport pathways and hydraulic controls, the framework provides a basis for interpreting underpass flooding mechanisms and identifying site-specific forecasting and mitigation priorities.}
}
@article{TIBANGAYUKA2026136641,
title = {Climate change restructures extreme-event memory and hydroclimatic regime persistence across Africa},
journal = {Journal of Hydrology},
volume = {681},
pages = {136641},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136641},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017385},
author = {Nickson Tibangayuka and Wenxi Liao and Deogratias M.M. Mulungu},
keywords = {Climate change, Extreme-event memory, Hydroclimatic regime, Drought persistence},
abstract = {Climate extremes are intensifying globally, yet their most consequential impacts emerge from temporal clustering and regime persistence rather than isolated events. Here, we demonstrate that climate change systematically restructures extreme-event memory (i.e., the time-dependent influence of past extremes on future hydroclimatic states) across Africa. We develop an event-conditioned probabilities framework and apply it to observations (1985–2024) and climate model projections (2041–2080). We reveal that the dominant 6-month memory timescale strengthens in semi-arid regions but weakens in humid tropics, creating opposing regional responses in hydroclimatic predictability. We found that climate change induces asymmetric regime shifts, making dry states more persistent while wet states more transient. These shifts bias the hydroclimatic regime toward more prolonged droughts. The projected hydroclimatic changes remain robust across emission scenarios, indicating restructuring that is independent of mitigation ambitions. Our findings show that climate change not only makes extreme events more intense but also fundamentally alters how climate systems retain memory of past events. These results have important implications for planning and forecasting in an increasingly uncertain climate.}
}
@article{HAN2026136649,
title = {Mechanistic shifts in seasonal precipitation isotope variability across China’s monsoon–westerlies transition zone},
journal = {Journal of Hydrology},
volume = {681},
pages = {136649},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136649},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017464},
author = {Wenqing Han and Zhaowei Jing and Xiaoyi Shi and Feng Jiang and Tao Pu and Yanlong Kong and Shaoyong Wang and Shijin Wang and Shengjie Wang},
keywords = {Monsoon activities, Moisture source, Precipitation stable isotope, Monsoon-westerlies transition zone, China},
abstract = {Understanding the drivers of precipitation δ18O (δ18Op) across China remains a long-standing challenge because of complex interactions between the monsoon systems and the westerlies. Using a seasonal decomposition approach, our results indicate a sandwich-like spatial configuration of the dominant controls on seasonal δ18Op variability. The monsoon-dominated southeastern region and the westerly-dominated northwestern region are governed mainly by seasonal shifts in remote oceanic moisture sources. In contrast, the monsoon-westerlies transition zone is controlled primarily by moisture transport processes. Furthermore, the transport-dominated belt shifts seasonally with the monsoon. This migration shows that the spatial influence of moisture transport on δ18Op is not fixed. This migration pattern suggests a potential mechanism by which spatially distributed paleoclimate isotope records may reflect past changes in the spatial extent of monsoon influence, providing a new perspective for investigating East Asian paleoclimate archives.}
}
@article{ZHU2026136495,
title = {Physical and numerical modeling of a novel unsaturated multilayered cover system for mining closure},
journal = {Journal of Hydrology},
volume = {681},
pages = {136495},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136495},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015921},
author = {Yunlong Zhu and Udesh Wijepala and Soumya Roy and Sanandam Bordoloi},
keywords = {Tailings closure, Multilayered cover systems, Physical modeling, Numerical modeling, Percolation, Biochar},
abstract = {Hydraulic cover systems used in tailings storage facilities (TSFs) in cold region mines commonly depend on thick compacted layers or geosynthetic liners, both of which tend to lose functionality when subjected to prolonged snowmelt or extreme precipitation. This work introduces an alternative cover concept: a lightweight, fully unsaturated multilayered cover system (MLCS) composed predominantly of locally available tailings and waste rock. In this approach, tailings are engineered either through clay–biochar amendment or by inducing surface hydrophobicity, enabling them to function as key components of a capillary-controlled barrier. The MLCS incorporates a capillary break, and a hydrophobic interface specifically designed to trigger water entry pressure (WEP) dependent resistance during severe ponding events. Comprehensive laboratory tests including soil–water retention characteristics, hydraulic conductivity functions demonstrated that modified tailings mixtures exhibit enhanced capacity to delay wetting. The hydrophobic layer, characterized by a WEP of approximately 4.71 kPa, permitted the construction of an exceptionally thin 0.5-m cover while still providing breakthrough resistance. Performance was evaluated using a fully instrumented one-dimensional physical model subjected to a constant ponding head of 115 mm maintained for 61 days. No percolation was detected beneath the MLCS for 61 days, and the hydrophobic interface remained unsaturated even as the overlying layers approached saturation. Coupled finite-element simulations employing WEP-based hydraulic switching reproduced the temporal evolution of suction, moisture distribution, and percolation observed in the physical experiment. Overall, the study shows that the MLCS can function as a robust, climate-tolerant hydraulic barrier and offers a cost-effective closure solution that minimizes reliance on imported geomaterials.}
}
@article{QIAO2026136633,
title = {Sensitivity of mountain riverine air–water CO2 exchange estimates to elevation decompression and localized atmospheric CO2 variability},
journal = {Journal of Hydrology},
volume = {681},
pages = {136633},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136633},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017300},
author = {Xue Qiao and Hui Liu and Weiyang Xiao and Wenbin Hu and Hailiang Song and Yue Ding and Zhongjun Xu and Jie Du and Ya Tang},
keywords = {Air-water CO exchange, Mountain rivers, Atmospheric pressure, Localized CO pooling, Karst waters, Riverine carbon budget},
abstract = {Mountain rivers act as critical CO2 outgassing hotspots in the global carbon cycle. However, conventional air–water CO2 exchange estimates often rely on static atmospheric CO2 boundary conditions, which introduces potential uncertainties in topographically complex regions. Integrating multi-site spatial surveys across an 1,100 m elevation gradient and a one-year high-frequency in-situ monitoring campaign at a site in the subalpine Jiuzhaigou karst catchment, we decouple the independent effects of physical topography and micro-meteorology on riverine CO2 evasion. First, altitude-driven barometric decompression steepens the air–water CO2 partial pressure gradient. While atmospheric CO2 calculations do not universally assume standard sea-level pressure, failing to apply site-specific local barometric corrections can alter each site’s mean riverine CO2 exchange rate by up to 23.2 mmol m−2 h−1, with the absolute magnitudes dependent on local turbulence. Independently, localized atmospheric CO2 pooling dynamically shifts the instantaneous air–water gradient. This pooling occurs not only at night but also during the daytime, driven by local microclimate, biological processes, and human activities. Second, despite substantial daytime photosynthetic CO2 drawdowns, the karst waters maintain continuous year-round outgassing. This persistent supersaturation is predominantly sustained by massive, continuous external groundwater and soil dissolved inorganic carbon inputs that consistently exceed evasion and assimilation rates. Ultimately, while boundary simplifications do not significantly impact annual cumulative CO2 emissions (0.02%−11% deviation), integrating dynamic barometric corrections and localized atmospheric CO2 monitoring is essential for accurately resolving high-frequency instantaneous outgassing kinetics in complex terrains.}
}
@article{ZHANG2026136652,
title = {Comprehensive risk assessment of snowmelt-runoff and storm-runoff flood disasters in the China-Pakistan Economic Corridor},
journal = {Journal of Hydrology},
volume = {681},
pages = {136652},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136652},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601749X},
author = {Haiting Zhang and Min Xu and Shichang Kang and Xingdong Li},
keywords = {Flood risk assessment, Snowmelt runoff flood, Storm runoff flood, Influence factor analysis, CPEC},
abstract = {Global warming and the increasing frequency of extreme weather events have led to an increase in flood incidents. Assessing flood risk is of great significance for disaster prevention and reduction. This study aims to propose a novel framework for flood disaster risk assessment in the China-Pakistan Economic Corridor (CPEC). Firstly, considering the flood risk indicators of snowmelt runoff and storm runoff related to geographical environment, climatic conditions, and social development, a comprehensive assessment indicator system was developed. Secondly, flood risk was evaluated by combining Analytical Network Process (ANP) with an and the objective weighting framework based on Genetic Algorithm (GA). Finally, the relationships between different risk indicators and flood risk were analyzed using the explainable machine learning model (XGBoost-SHAP). The results indicated that the spatial distribution of flood disaster risks in the CPEC presented an obvious distribution pattern along river networks, mainly distributed in N.W.F.P., Islamabad, Punjab, and Sindh. Approximately 21.05% of the area experienced a dual high risk of snowmelt-runoff and storm-runoff floods. High- and very high-risk areas of snowmelt runoff flood and storm runoff flood accounted for 21.60% and 20.27% of the total area, respectively. In most areas of the CPEC, landuse/cover, rivernetworkdensity, elevation, and slope were the main positive contribution indicators of snowmelt-runoff and storm-runoff floods. Multi-year average maximum 3-day cumulative snowmelt runoff mainly affected snowmelt runoff flood in mountainous areas, while that for storm runoff and multi-year average temperature dominated the storm runoff flood in northern Pakistan. This study explores the distribution of flood risk and disaster-influencing factors, which is crucial for the CPEC to develop relevant and effective risk mitigation policies.}
}
@article{ZHANG2026136657,
title = {Coupling effects of vegetation and crack on soil climate resilience: insights from electrical conductivity monitoring},
journal = {Journal of Hydrology},
volume = {681},
pages = {136657},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136657},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017543},
author = {Jun-Zheng Zhang and Chao-Sheng Tang and André Revil and Dong-Wei Wang and Yu Zhang and Chang Sun and Jin-Jian Xu},
keywords = {Soil water content, Climate resilience, Vegetation, Desiccation cracks, Electrical resistivity tomography (ERT)},
abstract = {Clayey soils are widespread on Earth’s surface and exhibit variable mechanical and hydraulic properties that are sensitive to climate conditions. Although vegetation covers can protect clayey soils from climate change, drought-induced desiccation cracks in clayey soils are inevitable, significantly altering their hydraulic behavior. Characterizing the coupling effects of vegetation covers and desiccation cracks on the climate resilience of clayey soil is therefore an important topic. This study develops a framework using electrical conductivity for investigating the dynamics of soil moisture content in shallow clayey soils during the yearly cycle. Five electrical profiles were set on the slope surface with and without vegetation covers, including a refined profile on cracked soils for conductivity tomography. The soil temperature modeling and petrophysical relationship between electrical conductivity and volumetric water content help to reconstruct the moisture dynamics in shallow layers. Results indicated that vegetation covers can improve soil climate resilience by reducing soil temperature fluctuations in spring, maintaining the soil moisture in summer, and inhibiting soil freezing in winter. Under the coupling effects of cracks and vegetation, infiltration and evaporation in shallow soils vary with weather conditions. This study emphasizes the significance of non-invasive and distributed monitoring of clayey soils on the Earth’s surface, offering an innovative framework for evaluating the climate resilience of these soils under climate change.}
}
@article{WANG2026136629,
title = {Spatiotemporal evolution and drivers of compound dry-hot and wet-hot events in a changing climate},
journal = {Journal of Hydrology},
volume = {681},
pages = {136629},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136629},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017269},
author = {Chao Wang and Fanli Sun and Shuzhe Huang and Wei Wang},
keywords = {Compound dry-hot events, Compound wet-hot events, CMIP6, Copula decomposition, Land-atmosphere interaction},
abstract = {Compound dry-hot events (CDHEs) and compound wet-hot events (CWHEs) are two contrasting types of compound heat extremes with different impacts. However, their global evolution and changes under climate change, as well as their attribution to thermal and precipitation factors, remain insufficiently compared within a consistent framework. This study assesses CDHEs and CWHEs from 1961 to 2100 using multi-model CMIP6 simulations under the historical period and four SSP scenarios. We analyze changes in several indicators and use a copula-based return-period decomposition to separate the effects of hot conditions, precipitation anomalies, and their dependence structure. Diagnostic land-atmosphere analyses using vapor pressure deficit, relative humidity, and soil moisture are conducted to explore associated physical pathways. Results show that both CDHEs and CWHEs have intensified since the 1990s, but with distinct spatial patterns. CDHEs increase more strongly in arid and semi-arid regions, whereas CWHEs intensify more rapidly in humid climatic zones and high-latitude regions. Future projections indicate continued increases in compound heat risks under all SSPs, especially under high-emission scenarios. By the late 21st century, CWHEs are projected to become increasingly dominant, with faster increases in severity and duration than CDHEs. The decomposition analysis shows that hot conditions are the dominant driver, and the diagnostic analysis further identifies vapor pressure deficit as the most consistent predictor associated with both event types. These findings highlight the growing importance of wet-heat hazards and provide a basis for differentiated adaptation strategies under continued warming.}
}
@article{CHANG2026136592,
title = {Analytical stochastic framework for coupled heat and moisture transfer in permafrost active layers with hydraulic parameter and thermal conductivity heterogeneity during seasonal thawing},
journal = {Journal of Hydrology},
volume = {681},
pages = {136592},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136592},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016896},
author = {Ching-Min Chang and Chuen-Fa Ni and Chi-Ping Lin and I-Hsien Lee and Wei-Cheng Lo},
keywords = {Permafrost active layers, Coupled heat and moisture transfer, Spatial variability quantification, Fourier-Stieltjes spectral representation, Nonstationary random fields},
abstract = {As climate change accelerates Arctic and alpine warming, accurately simulating coupled heat and moisture transfer during seasonal thawing is essential for predicting permafrost degradation and its hydrological impacts. However, deterministic models generally neglect the effects of natural spatial variability in soil hydraulic and thermal properties on thermo-hydrological responses. This study therefore develops a stochastic framework for coupled heat and moisture transfer in heterogeneous permafrost active layers during seasonal thawing. The formulation explicitly incorporates the spatial variability of saturated hydraulic conductivity and thermal conductivity and derives analytical expressions in the Fourier spectral domain for the temperature semivariogram, heat-flux semivariogram, and variance of capillary pressure head. Closed-form solutions are obtained for the case in which the random fields of the natural logarithms of saturated hydraulic conductivity and thermal conductivity are characterized by hole-type exponential covariance functions. The analytical solutions show that the perturbation fields for temperature, heat flux, and capillary pressure exhibit nonstationary spatial variability, despite the assumption of second-order stationarity in log-hydraulic and −thermal property perturbation fields. The results are also used to analyze the influence of key parameters in coupled stochastic heat and moisture transfer models on the spatial variability of coupled thermo-hydrological responses. The proposed framework provides a physically based means of quantifying uncertainty propagation from heterogeneous soil properties to coupled heat and moisture transfer, thereby improving the understanding of active-layer dynamics and providing a theoretical basis for uncertainty analysis and stochastic parameterization in permafrost hydrological models.}
}
@article{LI2026136613,
title = {Soil temperature governs deep soil water infiltration in alpine meadows on the Qinghai-Tibet Plateau},
journal = {Journal of Hydrology},
volume = {681},
pages = {136613},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136613},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017105},
author = {Jie Li and Qiaoyan Chen and Junna Feng and Bo Fan and Yangong Du and Licong Dai and Ruiyu Fu and Xiaowei Guo},
keywords = {Qinghai-Tibet Plateau, Deep soil water infiltration, Soil temperature, Aboveground biomass, Alpine meadow},
abstract = {Deep soil water infiltration is a critical process linking surface water inputs with deeper soil water storage and potential groundwater recharge, yet its seasonal dynamics and controls remain poorly understood in alpine meadows of the Qinghai–Tibet Plateau. Based on growing-season (May–September) observations from 2017 to 2023, this study quantified seasonal variations in deep soil water infiltration and identified controlling factors using an XGBoost machine-learning model combined with SHAP (Shapley additive explanations). We found deep infiltration showed pronounced seasonal variability and was not directly synchronized with precipitation patterns. During the growing season, cumulative evapotranspiration (361.7 mm) slightly exceeded cumulative precipitation (344.7 mm), suggesting that all rainfall was consumed by evapotranspiration rather than contributing directly to deep recharge. Among the examined variables, soil temperature (ST) was identified as the most important predictor of deep infiltration, accounting for 33.3% of the total SHAP-based importance, followed by air temperature (T; 29.5%) and volumetric soil moisture (VSM; 15.3%), which accounted for nearly 80% of the total SHAP-based importance, whereas precipitation and evapotranspiration display relatively limited contributions. Notably, ST exhibited a distinct nonlinear threshold effect, i.e. lower soil temperatures enhanced deep infiltration, but substantially reduced when ST exceeded approximately 9.2 ∼ 9.6 °C. Besides, deep infiltration was also significantly negatively correlated with aboveground biomass (P < 0.01), suggesting that enhanced plant water use during the peak growing season may restrict downward water movement. Meanwhile, plant water-use analysis showed that dominant alpine meadow species mainly relied on 0–40 cm soil water, with limited use of deeper soil water, which further explain the enhanced root-zone water consumption and reduces deep recharge during growing season. These findings suggested that soil thermal conditions and vegetation jointly regulate deep infiltration by altering soil water availability, and vertical water transfer. Our study provided new insight for improving process-based hydrological models and assessing the vulnerability of alpine meadow water cycling under future warming scenarios.}
}
@article{LU2026136665,
title = {Stage-dependent responses of shallow groundwater salinization under multiple coupled drivers: multi-period hydrochemical evidence and mechanistic insights from a coastal gold mining area},
journal = {Journal of Hydrology},
volume = {681},
pages = {136665},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136665},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017622},
author = {Chang Lu and Bo Zhang and Fangying Dong and Xiang Jiang and Zhenzhou Sun and Rongxin Zhao and Huiyong Yin and Tianyuan Zheng},
keywords = {Groundwater salinization, Stage dependent response mode, Multi source process identification, Coastal gold mining area, Climatic wet dry variability, Multi factor coupled driving},
abstract = {Coastal shallow groundwater is a key medium for maintaining ecological security and supporting the sustainable use of water resources in coastal regions. However, it is prone to salinization and water quality deterioration under the combined effects of climate change and human activities, while its stage-dependent responses under different background conditions remain insufficiently understood. This study investigated a typical coastal gold mining area in the Jiaodong Peninsula using multi-period regional hydrochemical data, source apportionment, and major-ion relationships to identify the dominant salinization processes and their stage-dependent responses. Groundwater solutes were jointly controlled by five key end members: coastal saline input, evaporative salinization, mining disturbance related water–rock interactions, agricultural and domestic inputs, and natural carbonate weathering. The study period was divided into three stages with distinct hydrochemical responses. Climate change regulated recharge intensity and hydrological conditions, thereby controlling the expression of coastal saline sources and anthropogenic disturbances. Enhanced recharge during wet conditions promoted dilution, leaching, and solute redistribution, whereas relatively dry conditions intensified evaporative concentration, coastal saline influence, and the hydrochemical expression of mining and agricultural inputs. Based on multiple lines of evidence, three stage-dependent salinization response modes were identified: a natural background-controlled mode, a climate-buffered mode, and a multi-factor coupled driving-dominated mode. These modes reveal the stage dependent transition of the system from buffered regulation to enhanced multi source driving. The proposed framework provides new systematic insights for stage-specific salinization risk identification and groundwater monitoring and management in coastal mining areas.}
}
@article{LI2026136609,
title = {Canal-mediated water redistribution and ecohydrological responses in an arid inland oasis: Evidence from stable isotopes and remote sensing},
journal = {Journal of Hydrology},
volume = {681},
pages = {136609},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136609},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017063},
author = {Rui Li and Zhijie Zheng and Guofeng Zhu and Xinyue Wang and Jiangwei Yang and Yuxin Miao and Yani Gun},
keywords = {Canal, Stable isotopes, Water cycle, Evaporative losses, Ecohydrological effects, Oasis},
abstract = {Irrigation canals are a defining feature of managed water systems in arid oasis regions, yet their effects on hydrological and ecological processes remain poorly constrained. Here, we combine multi-year stable hydrogen and oxygen isotope observations with isotope-based evaporation modeling, Bayesian plant water-source analysis and satellite remote sensing to examine canal-mediated water redistribution in the Minqin Oasis, Northwest China. Canal-water δ18O and δ2H became progressively enriched among five fixed sampling sites located 5–100 km downstream of the reservoir outlet, while d-excess generally decreased, providing consistent evidence of evaporative modification during conveyance. Isotope-based mass-balance calculations for April–October 2019–2022 indicated that monthly cumulative evaporation losses ranged from 1.14% to 14.54%, with a mean of 5.11 ± 3.66%. Mean loss increased to 8.20% during June–August. Comparative isotope analyses revealed partial overlap among canal water, groundwater and soil water, indicating local hydrological connectivity between surface and subsurface water stores, although the direction and magnitude of water exchange could not be quantified. Soil-water and xylem-water isotopes, together with MixSIAR estimates, showed that poplars in artificial canal-side shelterbelts used more shallow and intermediate soil water during the middle growing season and relied more strongly on deep soil water and groundwater during the early and late growing season. At the downstream Qingtu Lake terminal region, satellite observations showed pronounced lake re-expansion following the initiation of ecological water conveyance (EWC) in 2010. After adjustment for precipitation, temperature and potential evapotranspiration, the regional mean annual maximum NDVI trend accelerated significantly after 2011. Associations between lake area and NDVI were concentrated within the lake boundary and the adjacent 0–5 km zone, indicating that vegetation responses were spatially localized around the replenished terminal lake. These findings show that canal systems influence arid-oasis water cycling through seasonal evaporation and local interactions among surface water, soil water, groundwater and vegetation, while terminal-region ecological changes are closely linked to managed water delivery. This underscores the need to account for conveyance losses and local water redistribution in ecological water planning and dryland irrigation management under increasing aridity.}
}
@article{ZHANG2026136661,
title = {Global spatiotemporal dynamics and population exposure of extreme precipitation intensity-frequency combination types (1961–2020)},
journal = {Journal of Hydrology},
volume = {681},
pages = {136661},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136661},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017580},
author = {Zilong Zhang and Zhaosheng Wang and Jiang Zhang and Cuijuan Liao and Jiameng Chen and Min Chen and Yuanyuan Huang},
keywords = {Extreme precipitation, Spatiotemporal dynamics, Population exposure, Extreme precipitation type},
abstract = {Extreme precipitation (EP) under global warming poses growing risks, yet intensity and frequency of EP are often analyzed separately, limiting the understanding of their co-evolution. Using ERA5-Land daily precipitation data for 1961–2020, this study proposes a K-means clustering framework that jointly classifies EP into nine intensity–frequency combination types and analyzes the transition patterns of EP across two climatological periods, 1961–1990 and 1991–2020. The results reveal a predominant shift toward higher EP frequency globally, with the coverage of the low-intensity and low-frequency (LL) type decreasing markedly while the low-intensity and middle-frequency (LM) and low-intensity and high-frequency (LH) types expanding across the two periods. Around 56% of the land area experienced a change in the dominant EP intensity–frequency combination type, exhibiting an asymmetry in the evolution of intensity and frequency. Specifically, 76.11% and 11.86% of these transitions were driven primarily by single changes in frequency and intensity, respectively, whereas only 7.30% involved same-direction changes in both frequency and intensity. Overlaying the EP classification with GHS-POP population data for 1991–2020 shows that medium- and high-density population regions are more exposed to the LM type and have a lower share of the less hazardous LL type. Regions where elevated EP hazard potential coincides with higher population exposure, particularly South Asia and Southeast Asia, have been identified as critical EP hotspots. These findings highlight the necessity of integrating intensity and frequency dimensions into EP characterization and hazard assessment, providing a basis for region-specific climate adaptation and disaster-risk mitigation planning.}
}
@article{ABESHU2026136520,
title = {Coupling water balance and vegetation carbon dynamics in a parsimonious global hydrologic model},
journal = {Journal of Hydrology},
volume = {681},
pages = {136520},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136520},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016173},
author = {Guta Wakbulcho Abeshu and Hong-Yi Li and L. Ruby Leung},
keywords = {Gross primary productivity, Evapotranspiration, Hydrologic modeling, Global scale, Water-carbon coupling},
abstract = {Understanding ecohydrological responses to environmental change requires parsimonious models that can represent interactions between water balance and vegetation carbon uptake. Simple conceptual hydrologic models efficiently simulate runoff and evapotranspiration, but they usually lack dynamic vegetation representation. We extend the abcd monthly water-balance model to simulate coupled water-carbon dynamics by integrating the Horton Index framework with a two-parameter Gross Primary Productivity-Evapotranspiration (GPP-ET) functional relationship. The resulting eight-parameter framework is calibrated using observation-constrained runoff and GPP, while ET is withheld from the calibration objective and evaluated independently. Using GSWP3-W5E5 forcing, FLUXCOM-X BASE GPP and ET, and GRUN-ensemble runoff over 235 global basins, we calibrate the model for 2001-2014 and evaluate it independently for 2015-2019. During validation, the model reproduces GPP robustly, with a median Kling-Gupta Efficiency (KGE) of 0.746 and positive KGE in 94.9% of basins. ET performance is also broadly positive despite not being directly calibrated, with a median validation KGE of 0.675 and positive KGE in 86.8% of basins. Runoff skill is moderate and more heterogeneous, with a median validation KGE of 0.593 and positive KGE in 89.8% of basins. Seasonal-cycle and anomaly analyses show that the model strongly captures the climatological timing of GPP and ET while retaining meaningful anomaly skill after removing the mean annual cycle. The calibrated coupling parameters λ, β, and α exhibit geographically organized patterns consistent with their physically interpretable roles in evaporative partitioning and water-carbon coupling, while β and α remain effective model-scale rather than intrinsic physiological coefficients. These results show that a parsimonious monthly hydrologic model can be extended to diagnose first-order coupled water-carbon dynamics while retaining interpretable structure and computational efficiency.}
}
@article{SERAFEIM2026136512,
title = {Comparative analysis of rainfall erosivity estimation approaches and temporal resolution effects: A critical review supported by an observational case study},
journal = {Journal of Hydrology},
volume = {681},
pages = {136512},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136512},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016094},
author = {Athanasios V. Serafeim and Andreas Langousis and Paolo Nasta and Dario Pumo and Nunzio Romano and Roberto Deidda},
keywords = {Soil erosion, Rainfall Erosivity, -factor,  index, RUSLE, Epistemic uncertainty, Temporal resolution effects},
abstract = {Accurate estimation of the rainfall erosivity factor (R-factor) is fundamental for soil erosion prediction and informed land conservation. This study provides a comprehensive review of the historical evolution and current status of R-factor estimation, ranging from simplified empirical equations to complex process-based models. Special emphasis is placed on data requirements, model assumptions, and method transferability. We introduce an alternative process-based algorithmic procedure (AAP) for identifying erosive events that strictly aligns with the original Renard et al. (1997) criteria, effectively mitigating the overestimation of wet spell durations common in traditional approaches. Using a high-resolution (1-min) rainfall dataset from 134 stations in Sardinia, Italy, we evaluate the performance of USLE, RUSLE, and RUSLE2 under various event identification procedures and temporal resolutions (1 to 1440 min). Furthermore, we compare these process-based results against 51 widely used simplified empirical models from global literature. Our analysis reveals a significant dependence of erosivity estimates on temporal resolution; coarser data systematically smooth intensity peaks, leading to substantial R-factor underestimation. Additionally, simplified empirical models exhibit high epistemic uncertainty, with estimates often deviating by over 100% from process-based benchmarks due to local calibration constraints. The study concludes with recommendations regarding possible future research directions, based on important gaps identified in the existing literature.}
}
@article{JIANG2026136644,
title = {Bidirectional concentration–discharge analysis reveals source–sink shifts and contrasting nutrient transport processes in regulated plain-river networks},
journal = {Journal of Hydrology},
volume = {681},
pages = {136644},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136644},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017415},
author = {Xiaoyu Jiang and Xuan Huang and Dongli She and Yongqiu Xia},
keywords = {Bidirectional c-Q relationships, Flow reversal, Nutrient transport dynamics, Internal phosphorus release, Regulated plain-river networks},
abstract = {Concentration–discharge (c-Q) relationships are fundamental for understanding watershed nutrient transport, yet traditional unidirectional frameworks fail in regulated plain-river networks with frequent flow reversals. To address this issue, a bidirectional c-Q hysteresis framework that references concentration responses against “discharge valleys” during backflow was developed to decouple nutrient dynamics under complex hydrodynamic conditions. We applied this framework to the Caoqiao River, a major tributary of Lake Taihu, using three-year high-frequency monitoring data of ammonia nitrogen and total phosphorus (May 2022 to April 2025, 4-hour intervals) from three sites along the river–lake gradient. The findings revealed that backflow exerted a limited influence on reverse nutrient loads, accounting for only 0.71–3.81% of the net loads, as well as on long-term c-Q relationships, with consistent trends observed during both lakeward-flow and backflow periods. However, although annual loads remained low during backflow periods and long-term relationships were consistent across both periods, differences were evident at the event scale in this study. At the event scale, backflow triggered pronounced source–sink shifts, producing transport mechanisms contrasting with those observed during lakeward-flow events. Ammonia nitrogen (NH3-N) and total nitrogen (TN) predominantly exhibited clockwise hysteresis (up to 33.3% and 29.0% of events, respectively), as dilution by cleaner lake water delayed the arrival of external nutrient inputs. Total phosphorus (TP) frequently showed counterclockwise hysteresis (up to 31.3% of events), with backflow-induced disturbance promoting the early release of particulate phosphorus from sediments.}
}
@article{MAXWELL2026136567,
title = {Land surface model snow formulation sensitivity and a solar-zenith-angle snow covered area scheme evaluated across the western United States},
journal = {Journal of Hydrology},
volume = {681},
pages = {136567},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136567},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016641},
author = {Reed M. Maxwell},
keywords = {Snow water equivalent, Fractional snow cover, Land surface model, ParFlow-CLM, Solar zenith angle, SNOTEL},
abstract = {Accurate representation of snow water equivalent (SWE) remains a central challenge for land surface and integrated hydrologic models. This work expands the ParFlow-CLM snow model with several new parameterizations, including a formulation that modulates fractional snow covered area (fSCA) by solar zenith angle. I evaluate these parameterizations across 220 site-years from the SNOTEL observation network, spanning three experiments and 58 configurations that represent the major snow parameterization choices in the literature, including three albedo schemes, five rain-snow partitioning methods, and band-separated snow aging formulations. A systematic sensitivity analysis shows that fSCA is the dominant control on SWE prediction accuracy among the tested parameterizations, with fSCA changes producing larger improvements than any tested change to albedo scheme, rain-snow partitioning, or snow aging. Static fSCA corrections improve peak SWE but introduce a trade-off with melt timing. The new solar-zenith-angle-modulated fSCA scheme resolves this trade-off by using seasonal solar geometry to transition between snow-preserving accumulation and snow-exposing ablation conditions. Across all configurations, the SZA-fSCA scheme achieves the best balance of peak accuracy and melt timing (NSE of 0.79, melt bias of −1 day), surpassing reanalysis products and default process-model benchmarks and approaching LSTM performance (NSE of 0.82 versus 0.86) when combined with forcing bias correction. These advancements provide physics-based snow options for ParFlow-CLM comparable to those in other widely used land surface and snow models. Improved representation of snow water equivalent supports more accurate integrated continental hydrologic simulation over the United States.}
}
@article{CHEN2026136668,
title = {Improving actual evapotranspiration change attribution in Yellow River Basin water conservation area using an observation-constrained two-step framework},
journal = {Journal of Hydrology},
volume = {681},
pages = {136668},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136668},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017658},
author = {Shaohui Chen},
keywords = {Actual evapotranspiration change attribution, Bayesian model fusion, Remote sensing-model-observation fusion, Machine learning, Yellow River Basin water conservation area},
abstract = {Attributing actual evapotranspiration (ET) changes (ETCs) in complex basins remains challenging due to correlated drivers and heterogeneous responses. This study develops a dynamic observation-constrained two-step framework to quantify the contributions of 13 drivers to ETCs in the Yellow River Basin water conservation area (YRB WCA) during 2000–2019. First, Bayesian model fusion integrates five ET products under in situ observation constraints, with spatially and temporally varying weights predicted by random forest using satellite-derived surface conditions. Second, eigen-transformation constructs an orthogonal regression basis from standardized predictors, reducing redundancy among retained components. Across five sites, leave-one-year-out cross-validation yields a pooled root mean square error (RMSE) of 17.13 mm·month−1 and a pooled coefficient of determination (R2) of 0.7216, which is comparable to the best-performing individual products. By dynamically integrating the complementary performance strengths of multiple ET products, the framework reduces reliance on any single product, thereby providing spatially complete ET estimates for regional ETC attribution. Attribution results show that soil moisture, fractional vegetation cover, albedo, and precipitation are dominant factors, with regional mean absolute contributions (RMCs) of 11–14.8%, followed by leaf area index, wind speed, Lwnet and Swnet as moderate regulators, with RMCs of 6.7–9.6%, whereas temperature variables, specific humidity, and pressure act as secondary influencers, with RMCs < 6%. Driver contributions exhibit pronounced spatial heterogeneity and bidirectionality across YRB WCA, reflecting the combined effects of estimated sensitivities and driver trends.}
}
@article{LEE2026136655,
title = {Integrating deep learning into distributed hydrological modeling with physical constraints: unified streamflow prediction and reanalysis-supervised soil moisture representation over South Korea},
journal = {Journal of Hydrology},
volume = {681},
pages = {136655},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136655},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601752X},
author = {Dong-Gi Lee and Gyu-Ho Noh and Kuk-Hyun Ahn},
keywords = {Streamflow prediction, Soil moisture prediction, Physical constraints, Distributed hydrological modeling, Long short-term memory},
abstract = {Deep learning models have improved hydrological prediction, but their application to distributed modeling remains limited by weak physical consistency and the frequent separation of runoff generation from river routing. Here, we develop a physically constrained distributed Long Short-Term Memory (LSTM) framework that jointly simulates reanalysis-supervised grid-scale soil moisture, runoff generation, and downstream streamflow through an end-to-end D8-based routing scheme. The framework incorporates soft constraints representing water balance, precipitation-based water availability, potential evapotranspiration limits, and soil moisture bounds. We evaluated the framework across South Korea using daily meteorological forcing, streamflow observations from 21 gauging stations, and a reanalysis-based soil moisture for 964 grid cells during 2005–2024. Temporal, spatial, and spatiotemporal validation experiments were conducted to assess predictive performance and transferability. The physically constrained model retained comparable performance at temporally held-out observations while providing its clearest benefits in ungauged basins. It achieved the highest median streamflow Nash–Sutcliffe efficiency (NSE) and Kling–Gupta efficiency (KGE) under both the spatial validation (0.690 and 0.721) and spatiotemporal validation (0.688 and 0.640). These values exceeded those of the corresponding unconstrained distributed model by 0.049–0.080 for NSE and 0.089–0.162 for KGE. The learned internal responses satisfied the imposed bounds and exhibited hydrologically coherent changes in timing, persistence, and sensitivity to antecedent wetness, although they should not be interpreted as independently validated physical fluxes. The results indicate that soft hydrological constraints can improve streamflow transferability across ungauged basins, even when they do not uniformly improve all prediction targets or evaluation settings.}
}
@article{CREACO2026136551,
title = {Integrating rainfall event and antecedent depths into a single probabilistic framework for deriving event depth-duration-antecedent depth-frequency curves},
journal = {Journal of Hydrology},
volume = {681},
pages = {136551},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136551},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016483},
author = {Enrico Creaco},
keywords = {Design rainfall, Intensity-duration-frequency (IDF), Depth-duration-frequency (DDF), Initial soil conditions, Antecedent depth},
abstract = {This paper aims to show how rainfall event depth and antecedent depth can be integrated into the same framework for deriving depth-duration-antecedent depth frequency (DDAF) curves, which map a mathematical relationship between event depth, duration and antecedent depth for a given return period. These curves are obtained by means of a multi-step analysis of annual extrema in the trade-off between event depth and antecedent depth, which are dealt with by means of copula-based bivariate distributions for various durations. Unlike conventional depth-duration-frequency (DDF) curves, DDAF curves enable generating various combinations of event and antecedent depths, the return period staying the same. These equiprobable combinations can be input to event-based hydrologic modelling, to enable identification of the most critical one for the preset return period in the design phase. In the testing/verification phase, the new methodology allows estimating the return period to a new event occurring with specific values of duration, depth and antecedent depth. The applications of the paper are performed on a long horizon dataset of rainfall measurements with fine temporal resolution in three case studies (Erice and Pavia in Italy, Helsinborg in Sweden), proving the benefits of the novel methodology.}
}
@article{FREM2026136595,
title = {Building a data-driven conceptual model of the hydrological functioning of the Taita Hills tropical water tower system in Kenya},
journal = {Journal of Hydrology},
volume = {681},
pages = {136595},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136595},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016926},
author = {Michel R. Frem and Tibor Y. Stigter and Boris M. {van Breukelen} and Gretchen M. Gettel and Graham P.W. Jewitt and Benson Mwakachola},
keywords = {Water towers, Hard-rock aquifers, Tropical mountain hydrology, Chloride mass balance, Tritium, Baseflow},
abstract = {Tropical natural water towers regulate downstream freshwater resources, yet their hydro(geo)logical functioning remains poorly understood. This study integrates multi-year (2022-2025), multi-season hydroclimatic and tracer observations to build a data-driven conceptual model of a tropical metamorphic water tower at Taita Hills in Kenya. The collected dataset enabled rainfall partitioning, baseflow separation, multiple-method recharge estimations, hydrochemical and tritium analyses, and various spatial and multivariable analyses. Results show that the highland subcatchments, representing 43% of the catchment area, account for 87% of total discharge. Actual recharge is approximately twice as high in the highlands as in lower subcatchments. At the subcatchment scale, recharge ratios in more forested and elevated subcatchments (25% of rainfall) are about 1.5 times higher than in thicket-dominated subcatchments. The perennial behavior of most springs and streams, and the high baseflow contribution, indicate an important groundwater-buffering capacity. Evidence suggests that structural geology influences subsurface flow between subcatchments and baseflow in the streams. Spatial variations in lateral subsurface flow, higher specific discharge, and higher spring density in the south point towards cross-subcatchment transfers facilitated by lineaments. Hydrochemical and isotope analyses indicate increasing mineralization and (yearly to decadal) residence times from highlands to lowlands. These results indicate highland-lowland connectivity and show that the Taita Hills function as a groundwater-dominated water tower, where highlands are the main precipitation input zones, storage capacity is large, and preferential flow pathways sustain downstream and dry-season flows. More broadly, these findings reinforce the need to account for subsurface processes when assessing the hydrology of water towers.}
}
@article{YAN2026136640,
title = {Runoff regime-aware mixture of experts (RR-MoE) for interpretable and robust streamflow prediction},
journal = {Journal of Hydrology},
volume = {681},
pages = {136640},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136640},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017373},
author = {Lin Yan and Junran Yang and Junming Shao and Xiufeng Wu and Jiangyu Dai and Guoqing Wang and Peilu Tang and Qinli Yang},
keywords = {Streamflow prediction, Mixture of Experts (MoE), Deep learning, Interpretability},
abstract = {Accurate streamflow prediction is challenged by the heterogeneity of hydrological processes across different flow regimes. Most deep learning–based models rely on globally shared parameters and optimize overall prediction errors, implicitly assuming homogeneous runoff generation behavior. This often leads to parameter interference between low-flow and high-flow conditions, reduced sensitivity to extreme events, and limited interpretability. To address this issue, this study proposes a Runoff Regime-Aware Mixture of Experts framework (RR-MoE), which enables implicit, data-driven identification of hydrological regimes and decoupled parameterization across regimes. The framework integrates convolutional feature extraction and sequence modeling with a sparse top-k gating mechanism, which dynamically partitions basin states and routes hydro-meteorological inputs to specialized expert subnetworks. This divide-and-conquer architecture effectively mitigates cross-regime competition and improves the representation of both low-flow and high-flow dynamics. The framework is evaluated in the upper reaches of Tiaoxi River basin. Results demonstrate that RR-MoE consistently outperforms benchmark models (CNN-LSTM, CNN-GRU, EA-LSTM, and RR-MoE (GRU)), achieving a Nash–Sutcliffe Efficiency (NSE) of up to 0.919 and improving extreme-flow prediction. Furthermore, the learned expert specialization aligns with physically meaningful runoff regimes, indicating that the model captures regime-dependent hydrological behaviors and enhances structural interpretability. This study offers a promising direction for improving predictive performance and interpretability under non-stationary hydrological conditions.}
}
@article{CHEN2026136612,
title = {Hydraulic sorting and retention of microplastics in a cascade reservoir system, Southwest China},
journal = {Journal of Hydrology},
volume = {681},
pages = {136612},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136612},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017099},
author = {Yu Chen and Yuchuan Meng and Guodong Liu and Yichen Liu and Xiaohua Huang and Tishan Peng and Yingqian Hou},
keywords = {Microplastic occurrence, Cascade reservoir, Hydraulic sorting, Dam interception, Hydrodynamic conditions},
abstract = {Freshwater reservoirs are considered important microplastic (MP) accumulation hotspots due to altered hydrodynamic conditions. However, research on MP occurrence in cascade reservoirs, particularly regarding their influence on MP transport and distribution, remains relatively limited. This study investigated MP pollution in a typical cascade reservoir system along the mainstream of the Dadu River in Southwest China, with a focus on the effect of hydrodynamic heterogeneity on longitudinal MP profiles. A retention index (RI) was defined as the relative change in MP abundance between the upstream near-dam area (UDA) and downstream near-dam area (DDA) of a dam, which served as an indicator for comparing MP retention potential among reservoirs. Results showed that MP abundance ranged from 1.16 to 6.01 items/L, with a mean of 3.29 items/L. PE (31.9%), PET (31.1%), and PP (15.5%) were the predominant polymer types, while fragments (52.9%) and fibers (41.2%) were the dominant shapes. From upstream to downstream, MP abundance and diversity exhibited a significant increasing trend, and MP abundance was positively correlated with population (p < 0.05). Density-based sorting was identified as the dominant hydraulic sorting pattern across the cascade reservoir system, whereas the size-based sorting signal was weaker and statistically conditional. At the regional scale, the UDAs of the reservoirs were the MP accumulation hotspots in the cascade system due to the retention effect of dams, with several reservoirs exhibiting a longitudinal enrichment pattern from the reservoir tail to the dam. Finally, reservoir characteristics were found to relate to the retention indicator: reservoirs with larger storage capacity (and statistically equivalently, longer hydraulic retention time) showed higher RIs in the cascade reservoir system. These findings advance our understanding of MP transport and retention in cascade reservoir systems at the basin scale.}
}
@article{LIU2026136648,
title = {Global patterns of reservoir normal water storage capacities estimated by statistical and machine learning models},
journal = {Journal of Hydrology},
volume = {681},
pages = {136648},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136648},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017452},
author = {Ping Liu and Li Tang and XiaoHui Sun},
keywords = {Normalwater storage, Machine learning, Global reservoir dataset, Hydrological modelling, Ensemble approaches, Reservoir operation},
abstract = {Reservoir water storages are increasingly recognized as important tools for adapting to water-related hazards under climate change, particularly through their normal water storage (NWS). However, a critical data gap on regarding global reservoir NWS hinders our understanding of their spatial patterns and impacts on water management. This study aims to bridge this data gap by estimating the NWS for 7250 global reservoirs using an ensemble approach that includes linear regression, machine learning, and satellite-based methods. We train and evaluate these models based on a representative sample of 801 reservoirs with reported NWS data and multiple static attributes. Among the evaluated methods, the Gradient Boosted Decision Trees model utilizing various reservoir features performed best (achieving a coefficient of determination of 0.95 and a mean absolute percentage error of 12%), and was subsequently selected to estimate the NWS for unrecorded reservoirs. Our analysis of the global reservoir NWS ratio (NWSR) at individual, basin, and national scales reveals significant spatial variations, with a global mean NWSR of 72%. The distribution of NWSRs varies considerably across different reservoir groups categorized by physical size, primary purpose, and climatic region. At the national and basin scales, the USA, Canada, China, Russia, and Brazil, along with the Yenisey, Nile, Mississippi, Parana, and Yangtze basins, account for substantial portions of the global NWS capacity. The developed dataset and the analyzed spatial patterns provide vital empirical inputs for water resource management, large-scale hydrological modeling, and climate change adaptation, ultimately supporting effective planning for sustainable freshwater supplies.}
}
@article{ARABZADEH2026136672,
title = {Simultaneous Bayesian quantification and decomposition of structural, parameter, and forcing uncertainty in hydrologic models: A blended model approach},
journal = {Journal of Hydrology},
volume = {681},
pages = {136672},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136672},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017695},
author = {Rezgar Arabzadeh and James Craig and Bryan Tolson and Jonathan Romero-Cuellar and Robert Chlumsky},
keywords = {Uncertainty decomposition, Blended model, Bayesian inference, MANOVA},
abstract = {Disentangling the contributions of structural, parametric, and forcing uncertainty to hydrological model predictions remains a long-standing challenge. This study proposes a unified Bayesian framework that jointly quantifies and temporally decomposes these three uncertainty sources in streamflow prediction. The blended model structure of Mai et al. (2020) reformulates structural uncertainty as an equivalent parameter uncertainty through continuously weighted process algorithms, enabling simultaneous Bayesian inference over all three sources using the No-U-Turn Sampler (NUTS). A multivariate analysis of variance (MANOVA) then partitions total predictive variance for each Julian calendar day, yielding a time-varying uncertainty budget across the hydrological year. Applied to 12 MOPEX catchments (1948–2004), the framework achieves CRPS skill scores (relative to a climatological benchmark) of 0.84–0.92, Kling–Gupta Efficiency (KGE) values of approximately 0.63–0.85, and 95% prediction interval coverage of 0.84–0.96. Parameter uncertainty is the largest source at 11 of the 12 catchments (median ∼55%), followed by forcing (∼25%) and structural (∼20%) contributions. Forcing uncertainty peaks during winter–spring high-flow periods and is positively correlated with forest cover fraction (r = 0.50) and elevation, while structural uncertainty is amplified during summer–fall low-flow recession when competing baseflow algorithms diverge most strongly. These results reveal that parameter uncertainty dominates at nearly every site, implying that additional streamflow observations yield greater uncertainty reduction than equivalent investment in improved forcing data or model structural refinement. The temporally resolved uncertainty decomposition further demonstrates that uncertainty envelopes in real-time streamflow forecasting should be time-varying rather than static: structural uncertainty triples during low-flow seasons while forcing uncertainty shifts markedly between summer convective and winter frontal regimes, each requiring different mitigation strategies.}
}
@article{GOHOUEDE2026136604,
title = {A dimensionally consistent reformulation of the HyMoLAP rainfall–runoff model: interpretability and robustness across CAMELS datasets},
journal = {Journal of Hydrology},
volume = {681},
pages = {136604},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136604},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017014},
author = {Lionel Cédric Gohouede and Sianou Ezéckiel Houénafa and Eliézer Iboukoun Biao and Olatunji Johnson and Cenk Sezen},
keywords = {Rainfall–runoff modelling, Dimensional consistency, d-HyMoLAP, CAMELS, Interpretability},
abstract = {Rainfall–runoff modelling is a central tool for understanding and managing water resources. The Hydrological Model based on the Least Action Principle (HyMoLAP) is a parsimonious model that represents the rainfall–runoff transformation as an ordinary differential equation (ODE) at the catchment scale. This study revisits the HyMoLAP framework by reformulating it through the introduction of scaling parameters to ensure dimensional consistency, leading to d-HyMoLAP. The model is evaluated on 549 CAMELS-FR and 623 CAMELS-GB catchments. Model performance is investigated using Random Forest and XGBoost with SHAP analysis, while parameter sensitivity and predictive uncertainty are assessed using Morris sensitivity analysis and GLUE, respectively. Compared with the original HyMoLAP, d-HyMoLAP substantially improves performance, increasing the mean validation NSE from 0.165 to 0.649 on CAMELS-FR and from −2.570 to 0.650 on CAMELS-GB. Although HBV shows stronger performance across most catchments, d-HyMoLAP substantially reduces catastrophic failures relative to the original HyMoLAP and can match or exceed HBV in a subset of catchments under specific hydroclimatic conditions. In the CAMELS-FR comparative classification analysis, d-HyMoLAP is more likely to match or exceed HBV in catchments characterized by low runoff ratio, low high-flow frequency, and a gentle flow-duration-curve slope. Its highest performance is associated with humid catchments exhibiting stable hydroclimatic conditions and limited hydrological extremes. Analysis of calibration period length indicates that stable predictive performance can be achieved using relatively short calibration records. Parameter sensitivity analysis identifies the introduced scaling parameters as the dominant controls on model performance. GLUE analysis for four selected representative catchments provides evidence consistent with practical equifinality and relatively constrained prediction intervals, although coverage remains below the nominal 90% level and these findings should not be generalized to the full large-sample datasets. Overall, the results support the potential of d-HyMoLAP for large-sample rainfall–runoff modelling and enhanced water resource management.}
}
@article{ZHANG2026136656,
title = {Advancing satellite remote sensing from open water mapping to water type classification and hydrographic characterization: Application to the endorheic Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {681},
pages = {136656},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136656},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017531},
author = {Yiyang Zhang and Kang Yang and Xiaodong Yi and Xiaoyu Guo and Yuxin Zhu and Yuhan Wang},
keywords = {Water type, River network, River width, Terminal lake, Endorheic Tibetan Plateau},
abstract = {While satellite-derived waterbody products can map global open water extent and dynamics with good accuracy, integrating water type classification with continuous river networks remains a challenge. Here, we introduce a Topology-aware Water Type Classification (TaWTC) method for classifying the 30 m resolution Global Surface Water (GSW) mask in the endorheic Tibetan Plateau (TP), a representative study area with diverse water types, namely river networks, isolated lakes, pathway lakes, and terminal lakes. This method delineates continuous river networks and isolated lakes by incorporating the water-landscape interaction knowledge, identifies pathway and terminal lakes using two auxiliary datasets, and applies filtering thresholds to ensure product quality. We generate an annual 30 m water type product for 2014–2021, and characterize river network hydrography in detail: (1) the water area in the endorheic TP ranges from 32,268.5 to 35,722.4 km2 during the mean annual river discharge period from 2014 to 2021, comprising 757–935 lakes (>1 km2) and 160–180 river networks; (2) terminal lakes consistently expand, whereas other water types fluctuate annually; (3) low-order (1–3, ∼150 m wide) rivers comprise 67 ± 3% of the network’s length, whereas high-order (4–5, ∼300 m wide) rivers comprise 64 ± 4% of the river area; (4) compared with two existing datasets, our product captures approximately 1.6 times more river length and 1.7 times greater river area, offering improved river width estimates (RMSE: 34.7 m vs. 58.2–89.7 m); (5) our continuous river networks enable hydraulic geometry analysis along longitudinal profiles and evaluation of slope and drainage area impacts on river width. Taken together, our method advances current 30 m open water mapping by providing a more complete, accurate, and continuous water type product, and thereby supports enhanced hydrographic understanding of rivers and lakes.}
}
@article{WAN2026136607,
title = {Uncertainty in streamflow simulation performance arising from precipitation inputs and hydrological models under different flow regimes and catchment conditions},
journal = {Journal of Hydrology},
volume = {681},
pages = {136607},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136607},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601704X},
author = {Yongjing Wan and Jie Chen and Daiyuan Li and Jingjing Sun and Yuanlin Qiu and Mingming Wang and Shihua Zhang},
keywords = {Hydrological uncertainty, Uncertainty contributions, Flow regime dependence, Catchment characteristics},
abstract = {Hydrological simulations are inherently affected by uncertainties arising from precipitation inputs and hydrological models. The relative importance of those uncertainty sources across different flow regimes and catchment conditions remains poorly understood. This study used six gridded daily precipitation datasets to force five widely applied conceptual hydrological models over 379 catchments in China. Nine performance metrics were used to represent different flow regimes, and a two-way analysis of variance method (ANOVA) was applied to quantify the relative contributions of those uncertainty sources to streamflow simulation performances. Results show substantial discrepancies in precipitation magnitude among those datasets, while model calibrations partially compensate for these biases. Attributions of hydrological simulation uncertainties exhibit flow-regime dependence. For metrics represented to high-flow performances, the contribution associated with hydrological model choice is dominant, which accounts for approximately 40–80% of total uncertainty. In contrast, the primary contribution shifts to precipitation input for metrics of low flow performances, explaining 40–70% of the total uncertainty. For metrics of the mid-flow performances, precipitation inputs, hydrological models, and their interaction contribute comparably to total uncertainty. Moreover, uncertainty in hydrological simulation performance is significantly related to catchment characteristics with larger uncertainty in smaller and more arid catchments. In terms of relative contribution, the contribution associated with precipitation forcing choice increases with mean slope and runoff coefficient but decreases with catchment area and aridity index, whereas the contribution associated with hydrological model choice decreases with mean slope and elevation. The contribution associated with the interaction increases with mean elevation, catchment area, and elongation ratio, but decreases with runoff coefficient. This study provides new insights into the flow-regime dependence and catchment-related variability of uncertainty in hydrological simulation performance and offers guidance for selecting modeling strategies.}
}
@article{LING2026136628,
title = {Process-based modeling of managed aquifer recharge in a hillslope-valley system under two contrasting climatic regimes},
journal = {Journal of Hydrology},
volume = {681},
pages = {136628},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136628},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017257},
author = {Xinying Ling and Menberu B. Meles and Scott A. Bradford and Hoori Ajami},
keywords = {Spin-up time, Injection well, Managed aquifer recharge, Hillslope, Water balance, Dynamic equilibrium},
abstract = {Managed aquifer recharge (MAR) is increasingly used to enhance groundwater storage, yet its effectiveness has mainly been studied in flat agricultural and flood-plain areas, not hillslope regions. In this study, we investigated groundwater dynamics in response to pumping and MAR in an idealized hillslope-valley system under two contrasting climatic regimes based on Modesto (244 mm yr⁻1) and Camino (941 mm yr⁻1), California. A physically-based, fully coupled MIKE SHE model was developed to simulate coupled overland flow, unsaturated-zone, and groundwater flow. Long-term simulations were conducted to establish dynamic equilibrium under natural (undeveloped) conditions, followed by pumping and MAR scenarios (injection wells, surface MAR-release, and surface MAR-hold) to evaluate groundwater responses to different management strategies. The subsurface storage reached dynamic equilibrium within 180 years (dry climate) and 140 years (wet climate) under natural climate forcing conditions. Human-impacted scenarios required additional time for subsurface storage adjustment (90–130 years under dry conditions and 30–70 years under wet conditions). Pumping near the river had a negligible influence on groundwater levels but reduced streamflow, whereas pumping in the valley and especially the hillslope led to extensive cones of depression due to differences in aquifer response time and groundwater storage, respectively. Under the simulated conditions, hillslope MAR produced a faster groundwater response due to larger hydraulic gradients and increased lateral flow, while MAR in valley and floodplain regions was limited by groundwater travel times and surface water interactions, respectively. The short-term groundwater responses varied systematically among MAR approaches. Injection wells produced rapid, localized groundwater mounding; surface MAR application with runoff release caused small mounding due to runoff losses; and surface MAR with ponding generated higher groundwater mounding due to prolonged ponding. Hillslope MAR further enhanced recoverable storage in the valley. This is particularly important in overexploited valley aquifers. MAR effectiveness should be assessed over decadal to centennial timescales, as short-term assessments can substantially overestimate sustainable groundwater recovery. These findings provide a process-based framework for evaluating long-term MAR performance and designing sustainable groundwater extraction and recharge strategies.}
}
@article{ZHU2026136664,
title = {Reconciling flood control and hydropower objectives through optimized spatially-explicit capacity equivalency of cascade reservoirs},
journal = {Journal of Hydrology},
volume = {681},
pages = {136664},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136664},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017610},
author = {Di Zhu and Shuo Ouyang and Wei Guo and Yanlai Zhou and Kanglin Lin and Sheng Sheng and Hua Chen and Chong-Yu Xu and Fi-John Chang},
keywords = {Equivalent coefficient, Hydropower production, Compensation flood control operation, Cascade reservoirs, Yalong River},
abstract = {Flood control capacity (FCC) is generally reserved for flood safety during high flow seasons. Such operational priority often constrains reservoir performance by reducing hydropower generation and increasing water spillage. However, the rapid expansion of cascade reservoir systems has revealed complementary characteristics in FCC. This complementarity allows for its strategic reallocation among reservoirs to enhance overall system efficiency. This study proposes a novel joint hydropower operation framework based on the concept of equivalent FCC. The framework integrates three synergistic modules including an equivalent coefficient module, a hydropower optimization operation module, and a multicriteria evaluation module. In an application to seven cascade reservoirs in China’s Yalong River Basin, the framework established a key finding: the equivalent coefficient between the Lianghekou (LHK) reservoir and its downstream reservoirs influenced by the FCC replacement and safety flow thresholds at downstream flood control points, varies with flood regional composition and design flood magnitude. The minimum FCC equivalent coefficient is 0.67, which is adopted as a conservative basis for FCC reallocation. Reallocating FCC toward the head reservoir increases cascade hydropower generation by up to 5.8 billion kWh. This increase represents a 5.6% improvement over the conventional operation scheme. This study provides a transferable framework for improving hydropower efficiency, flood prevention, and sustainable water–energy management under diverse hydrological regimes.}
}
@article{OZA2026136636,
title = {Precipitation isotope baseline for India: regional patterns, process controls, and applications},
journal = {Journal of Hydrology},
volume = {681},
pages = {136636},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136636},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017336},
author = {Harsh Oza and Virendra Padhya and Akash Ganguly and Amit Pandey and Swagatika Chakra and R.D. Deshpande},
keywords = {Precipitation isotopes, Indian meteoric water line, d-excess, Monsoon moisture transport, Sub-cloud evaporation, Linear mixed-effects models},
abstract = {Precipitation isotopes (δ18O, δ2H, and d-excess) record moisture transport, rainout, recycling, source-region effects, and sub-cloud evaporation, but India lacks a unified isotope framework across its major hydroclimatic regimes. We present the most comprehensive precipitation-isotope baseline for India to date, using 1,485 monthly amount-weighted records from 61 stations across nine Köppen-Geiger climate classes. The Indian Meteoric Water Line is δ2H = (7.52 ± 0.04) δ18O + (7.20 ± 0.22), with R2 = 0.968, and falls below the Global Meteoric Water Line, indicating widespread secondary evaporative modification of rainfall. Seasonal analyses show that isotope controls shift through the annual cycle. Pre-monsoon rainfall shows the strongest sub-cloud evaporation signal, with the lowest seasonal meteoric-water-line slope, highest dew-point depression, enriched δ18O, and reduced d-excess. During the southwest monsoon, δ18O becomes spatially organized by moisture transport, rainout, and orography, including a significant west-east peninsular depletion gradient from the Arabian Sea margin across the Deccan interior toward the Bay of Bengal coast. Post-monsoon rainfall remains widely depleted but shows variable d-excess, indicating mixed influence from residual monsoon moisture, recycling, altered moisture sources, and local evaporation. Linear mixed-effects models reveal strong tracer asymmetry. Fixed effects, including season and monthly meteorological anomalies, explain 31.9% of δ18O variance but only 10.4% of d-excess variance. Thus, δ18O primarily tracks large-scale monsoon moisture transport, whereas d-excess retains stronger source, recycling, sub-cloud, and event-scale information. This baseline supports recharge assessment, paleoclimate interpretation, and isotope-enabled model evaluation across India.}
}
