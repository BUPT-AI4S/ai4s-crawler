@article{LYU2026135322,
title = {Influence of vegetation change on drip water dynamics and geochemical proxies in a shallow karst cave system},
journal = {Journal of Hydrology},
volume = {672},
pages = {135322},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135322},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004191},
author = {Yina Lyu and Weijun Luo and Reni Ustiatik and Guangjie Luo and Alena Gessert and Guangneng Zeng and Yanwei Wang and Jia Chen and Anyun Cheng and Shijie Wang},
keywords = {Vegetation recovery, Rainfall, Drip water, Drip rate, Oxygen isotope},
abstract = {Cave drip water is a fundamental carrier of climatic and environmental information, and its geochemical signatures are widely employed in speleothem-based paleoclimate reconstructions. While are well established, the role of rainfall intensity and vegetation-driven infiltration dynamics in shaping these signals remains insufficiently constrained. To address this, we carried out seven years of monitoring in Shawan Cave, a shallow karst cave system in Southwest China, integrating rainfall observations, continuous drip rate measurements at 30-minute resolution, and stable isotopes and elements/Ca data from drip water. Our results showed that drip water was present in both the dry and wet seasons from 2017 to 2019, whereas it was intermittently interrupted from 2020 to 2023 drip water, with more observed during the wet season and less during the dry season. This may be attributed to the deeper root systems of vegetation, which alter soil moisture and the amount of rainfall required to penetrate the soil and generate infiltration into the karst cave system, thereby changing the water reservoirs feed drip water over time. We propose that vegetation recovery, by influencing evaporation, can modulate drip water flow paths and thereby drive the enrichment of drip water δ18O. Intriguingly, although drip water δ18O during 2017–2018 did not fully reflect changes in rainfall δ18O, during 2022–2023 it appeared to inherit the δ18O signal of heavy rainfall. This indicates that drip water δ18O has gradually evolved from reflecting annual or multi-year rainfall amounts to primarily recording the heavy rainfall of the summer monsoon. These observations demonstrate that drip water signals are not simply a direct record of rainfall but are mediated by subsurface hydrological processes. We propose that the combined effects of reservoir-feeding drip water and flow path change over time are critical in governing the transmission of rainfall signals into cave environments. Recognizing the influence of vegetation change and reservoir evolution refines the interpretation of speleothem proxies, enabling more reliable reconstructions of monsoon variability at sub-annual to interannual timescales.}
}
@article{SHEN2026135330,
title = {An attention-based super-resolution model for high-accuracy urban pluvial flood forecasting in coastal megacities},
journal = {Journal of Hydrology},
volume = {672},
pages = {135330},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135330},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004270},
author = {Huanhuan Shen and Hengzhi Hu and Chen Xin and Yulu Yang and Yanjuan Wu and Zhuoran Liang and Jiahong Wen},
keywords = {Urban pluvial flooding simulation, Deep learning, Super-resolution, Attention mechanism, Shanghai},
abstract = {Sudden urban pluvial flooding from short-duration heavy rainfall creates an urgent need for rapid forecasting at high spatiotemporal resolution. This study proposes a data-driven super-resolution framework integrating coarse-grid hydrodynamic simulation with attention-enhanced deep learning. The framework requires no high-resolution DEM or land-use inputs during inference, significantly enhancing transferability across resource-constrained regions. Shanghai’s low-lying urban core served as the testbed, representing critical challenges of coastal megacities. We first conducted multi-resolution sensitivity analysis (100–300 m) and identified the optimal coarse resolution (100 m), balancing computational efficiency (< 45 s) with the highest correlation to fine-grid benchmarks (r ≈ 0.296, ρ ≈ 0.340, τ ≈ 0.248). A Convolutional Block Attention Module-enhanced Generative Adversarial Network (CBAM-GAN) was developed to super-resolve coarse inputs to 10 m resolution. Ablation experiments demonstrated that while adversarial training improves texture recovery, attention mechanisms provide decisive advantages for physical consistency. Under extreme rainfall (> 1000-year return period, beyond training distribution), CBAM-GAN achieved superior generalization (pre-drainage: PSNR ≈ 30.44 dB, SSIM ≈ 0.97; post-drainage: F1 ≈ 0.92, CSI ≈ 0.85), constraining volumetric errors within ±11% and reducing false positive areas by 2.35 km2 compared to baseline U-Net-GAN (pre-drainage: PSNR ≈ 21.90 dB, SSIM ≈ 0.91; post-drainage: F1 ≈ 0.88, CSI ≈ 0.78). Quantitative attribution analysis confirmed attention modules autonomously internalized gravity-driven confluence (r ≈ 0.65, p < 0.05; Cohen’s d > 1.2) and runoff generation patterns (Cramér’s V ≈ 0.34). The complete workflow finished within 1 min, demonstrating strong potential for operational flood early warning in coastal megacities.}
}
@article{HU2026135385,
title = {Multiscale investigation of marine sediment permeability in shallow gas-bearing zone of East China Sea},
journal = {Journal of Hydrology},
volume = {672},
pages = {135385},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135385},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004828},
author = {Cong Hu and Aimin Ji and Yonggang Jia},
keywords = {Permeability, Fluid migration, Gas-bearing sediments, Marine shallow gas},
abstract = {This study investigates sediment permeability and its control on shallow gas migration in the Zhoushan sea area through multiscale laboratory experiments and pore pressure analysis. Permeability values measured by constant rate of strain consolidation (CRS) tests ranged from 1.26 × 10-1⁶ to 1.34 × 10-15 m2, while nuclear magnetic resonance (NMR)-derived values ranged from 2.48 × 10-1⁶ to 6.47 × 10-15 m2, with discrepancies potentially linked to 6 % magnetic material (Fe2O3) in the samples. Pore size distributions were predominantly bimodal (0.09–0.3 μm), and an anomalous positive correlation between clay content and permeability was observed. This is attributed to a pore structure that maintains larger effective porosity despite higher clay fractions. Pore pressure profiles deviate from hydrostatic equilibrium, revealing distinct vertical fluid migration patterns-with dominant upward flow in the 1–3 mbsf interval, downward flow in the 3–5 mbsf zone, and bidirectional migration elsewhere-coupled with a maximum seepage velocity of 8.09 × 10⁻⁶ m/s in the 3–5 mbsf interval. These findings elucidate the complex permeability dynamics governing fluid migration in gas-bearing sediments.}
}
@article{JIANG2026135358,
title = {Analytical study for transient water seepage in the multi-layered unsaturated soil under rainfall/evaporation scenarios},
journal = {Journal of Hydrology},
volume = {672},
pages = {135358},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135358},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004555},
author = {Wenhao Jiang and Chuan Tian and Hao Wang and Linfeng Cao},
keywords = {Analytical solution, Multi-layered unsaturated soil, Transient water seepage, Rainfall/evaporation scenarios, Three-layered soil cover},
abstract = {Water seepage in multi-layered unsaturated soils under rainfall/evaporation scenarios is a common natural phenomenon and involves numerous geotechnical engineering issues. To accurately and reasonably characterize this physical behavior, this study presents the novel analytical solution for transient water seepage in multi-layered unsaturated soils under rainfall/evaporation scenarios. This solution, which comprehensively considers multiple factors, including the time-varying rainfall feature, the alternation of rainfall and evaporation, and two typical bottom boundaries, is derived by adopting several mathematical approaches (e.g., two times of variable substitution). Subsequently, its reasonableness is effectively verified via three comparative investigations, including the comparison with the measured results. On this basis, taking a three-layered soil cover (TSC) of landfill as an example, the effects of key factors on the transient water seepage behaviors are studied. It finds that the time-varying rainfall pattern with the same total rainfall significantly affects the bottom leakage rate Qb and volumetric water content change, but has only a modest effect on the accumulated leakage AQb. An increase in the evaporation rate reduces the volumetric water content, Qb and AQb, and this effect gradually becomes more remarkable over time. For a TSC composed of different soils, if the saturated hydraulic conductivity of soil gradually increases from the bottom to top positions, the AQb in this soil positional sequence will be least. Overall, the analytical solution proposed in this study can be both used as a practical computational tool for studying the transient seepage laws of water and as a benchmark solution for validating associated numerical models.}
}
@article{NGUYEN2026135366,
title = {Tracking rainfall contribution in a conceptual runoff model},
journal = {Journal of Hydrology},
volume = {672},
pages = {135366},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135366},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004634},
author = {Thien Nguyen and Bree Bennett and Michael Leonard},
keywords = {Conceptual rainfall-runoff model, Catchment memory, Rainfall-runoff response, GR4J},
abstract = {This paper presents a novel method to analyse how conceptual rainfall-runoff models represent the relationship between rainfall and streamflow. Although the effectiveness of conceptual rainfall-runoff models can be limited by their inherently simplistic representation of catchment characteristics, they remain instrumental in surface water management for their ease of use and fast computation capabilities. The method introduced in this study tracks rainfall contributions through the conceptual model to determine their proportional contribution to generated streamflow outputs. By tagging input rainfall volumes, this technique effectively identifies the conceptual-modelled response of the catchment, offering insight into the temporal distribution of runoff sources. For example, the method provides a useful diagnostic for evaluating model response to rainfall inputs, identifying differences in the partitioning of rainfall contributions across timescales that may not be apparent from traditional performance metrics. The method is applied to the GR4J hydrological model, for 227 catchments with streamflow records ranging from 33 to 70 years. Case studies are used to illustrate how contributions from different rainfall scales vary across flow regimes and climatic conditions. Notably, during a prolonged drought period, the modelled streamflow increasingly reflected contributions from rainfall that occurred more than a year prior, and this longer-memory behaviour persisted even after drought conditions eased.}
}
@article{SHAH2026135390,
title = {RainMerge: a two-stage framework for gauge-independent merging of multiple rainfall products},
journal = {Journal of Hydrology},
volume = {672},
pages = {135390},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135390},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004877},
author = {Suraj Shah and Yi Liu and Seokhyeon Kim and Ashish Sharma},
keywords = {Precipitation estimation, Multi-source merging, Rain/no-rain classification, Categorical triple collocation merging (CTC-M), Signal-to-noise ratio optimisation (SNR-opt)},
abstract = {Gauge-independent, multi-source precipitation data merging is a well-established approach for improving precipitation estimation across regions and scales. However, existing merging techniques often assume precipitation follows a unique, state-independent statistical distribution, overlooking the inherently mixed nature of rain and no-rain occurrence states. This assumption leads to two major limitations: (i) uncertainty in rain/no-rain classification and (ii) biased merging weights, resulting in suboptimal precipitation magnitude estimates. Here we introduce RainMerge, a novel two-stage merging framework designed to address these limitations. In Stage 1 (Binary Merging), we employ the Categorical Triple Collocation Merging (CTC-M) to enhance rain/no-rain detection by optimally combining three input datasets. In Stage 2 (Conditional Merging), we use the binary-merged product to conditionally group samples in time, and merge rain-flagged groups with at least two positive detections using Signal-to-Noise Ratio Optimisation (SNR-opt) to refine precipitation magnitudes. Using gauge observations from diverse hydroclimatic settings, we show that RainMerge improves daily rain/no-rain classification by 25–60 % in False Alarm Ratio (FAR) and Heidke Skill Score (HSS) relative to the parent products (ERA5, SM2RAIN, and IMERG-final). In terms of overall magnitude error (RMSE), RainMerge reduces the parent‐product RMSE by 2–6  mm/day and outperforms the state independent (termed One-stage) framework, by 1.5–2.5  mm/day. Additionally, RainMerge reduces underestimation bias by 2–8  mm/day for extreme precipitation events (75th–99th percentiles) compared to One-stage, demonstrating its superior performance in capturing heavy events. These results highlight the potential of RainMerge for hydrological and climate applications, offering a globally applicable approach to improve detection and magnitude accuracy in multi-source precipitation products.}
}
@article{LI2026135277,
title = {Assessing the global performance of a parsimonious soil temperature model for frozen ground prediction},
journal = {Journal of Hydrology},
volume = {672},
pages = {135277},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135277},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003744},
author = {Donghui Li and Alexander Michalek and Gabriele Villarini},
keywords = {Frozen soil prediction, Land surface processes, Model validation, Global assessment},
abstract = {Seasonal soil freezing and thawing processes significantly influence runoff generation dynamics during cold periods, affecting various hydrological and agricultural systems, including flood generation, soil erosion, and plant health. Representing frozen soil conditions in land surface or hydrological models is therefore crucial. While fully distributed models implement the process by solving energy-mass balance equations to obtain soil temperature profiles, parsimonious models using “snow tanks” or frozen ground states can provide suitable modeling solutions with reduced computational demands. However, even these parsimonious approaches to representing frozen ground typically require some additional complexity through additional inputs or surface energy balance calculations. This study evaluates the applicability of a simplified soil temperature prediction model that determines frozen/unfrozen ground states using only air temperature and snow cover data, reducing model complexity. We first validate the model performance using AmeriFlux network in-situ measurements across the United States and Canada. Furthermore, we provide a comprehensive assessment at the global scale with ERA5-LAND reanalysis data (1980–2020). The model demonstrates robust performance globally, achieving an average true frozen rate of 0.90 and false frozen rate of 0.06. We also investigate the model performance by month, and, while monthly analyses show drops in model performance for certain months, these lower scores are primarily due to the limited number of freeze–thaw events during these periods, which makes the model appear less accurate than it actually is. In terms of spatial performance, the model shows reduced accuracy in mountainous regions, including the Tibetan Plateau, Rocky Mountains, and Andes, suggesting the need for region-specific parameter calibration in orographic settings. Nevertheless, this parsimonious soil temperature model demonstrates significant potential as a computationally efficient solution for incorporating frozen ground effects in distributed hydrological models with simple conceptual runoff generation schemes; the implications of this work are toward improved flood prediction in cold regions, such as the Yukon-Kuskokwim Delta region during its record 2025 flooding, where the hydrologic response is largely controlled by frozen soil.}
}
@article{JIANG2026135369,
title = {A hierarchical machine learning framework for reconstructing freezing-period pan evaporation across various climate zones of China},
journal = {Journal of Hydrology},
volume = {672},
pages = {135369},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135369},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600466X},
author = {Wenhui Jiang and Bingxue Dong and Qingqing Sui and Zhenlin Lai and Lei Wen and Zhentao Bai and Zhijun Li and Junliang Fan},
keywords = {Pan evaporation reconstruction, Freezing-period conversion coefficient, Multivariate adaptive regression splines, Extreme gradient boosting, Cold region hydrology},
abstract = {Accurate estimation of pan evaporation (Epan) during the freezing period is critical for hydrological modeling and water resources management, particularly in cold regions, yet it remains a significant challenge due to operational difficulties, high labor costs, and cumulative observation errors, leading to widespread data gaps. To address this issue, this study proposed a novel hierarchical interpolation strategy that physically bridged the evaporation processes between non-freezing and freezing periods. The framework was structured in three steps: (1) interpolation of non-freezing period Epan using meteorological drivers, (2) introduction and estimation of a freezing-period conversion coefficient (Tf) to quantify the suppression effect of freezing conditions, and (3) reconstruction of freezing-period Epan by integrating the outputs of the first two steps. Four models—multivariate polynomial regression, multivariate adaptive regression splines (MARS), support vector regression (SVR), and extreme gradient boosting (XGBoost)—were evaluated at 705 stations across five climate zones of China. Results demonstrated that XGBoost and SVR performed best for non-freezing period Epan interpolation (mean R2 = 0.90, RMSE = 0.99 mm d−1) and the final freezing-period Epan reconstruction (mean R2 = 0.84, RMSE = 0.40 mm d−1). MARS excelled in Tf estimation (mean R2 = 0.72, RMSE = 0.12 mm d−1), capturing complex freezing mechanisms. For applications, XGBoost is recommended for its accuracy and efficiency, while MARS offers advantages in ungauged areas through explicit equations. This work provides a robust, physics-based framework for generating continuous freezing-period Epan data, supporting improved hydrological modeling and climate adaptation in cold regions.}
}
@article{JIANG2026135374,
title = {Deep-learning full-waveform inversion of snowpack GPR: joint permittivity–resistivity imaging for snow–soil hydrological mapping},
journal = {Journal of Hydrology},
volume = {672},
pages = {135374},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135374},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004713},
author = {Yuanjun Jiang and Zohaib Akbar and Ryan Webb and Zhao Binbin and Aftab Anwar and M.M Rehman and M.Z. Mirza},
keywords = {Full-waveform inversion, Ground penetrating radar, Deep learning, Electrical properties, Snow liquid water content},
abstract = {Precise characterization of snowpacks is vital for cryosphere monitoring, avalanche forecasting, and hydrological modeling. Ground-penetrating radar (GPR) offers high-resolution, non-invasive imaging of subsurface electrical properties. Among the inversion techniques used with GPR, full-waveform inversion (FWI) provides detailed modeling but is computationally expensive and highly sensitive to initial conditions, limiting its practical use in real-time snow studies. Recent advances in deep learning offer data-driven alternatives; however, standard regression-based algorithms, including convolutional and other purely feedforward models, often struggle to generalize in laterally heterogeneous snowpacks. The objective of the study is to introduce a hybrid deep learning framework that combines vision transformers (ViT) with bidirectional long short-term memory (BiLSTM) networks for dual-parameter inversion of permittivity and log-resistivity from GPR data. The ViT module captures global full waveforms dependencies, while BiLSTM ensures temporal continuity between traces, preserving both vertical and lateral subsurface structure. Synthetic datasets were generated using gprMax through finite-difference time-domain (FDTD) simulations, including dry, moist, and wet snowpack conditions with underlying soil layers, for model training and evaluation. The proposed model achieved robust performance metrics on synthetic 2D datasets, with R2 = 0.984, SSIM = 0.97, and RMSE = 0.066 for permittivity, and R2 = 0.966, SSIM = 0.94, and RMSE = 0.086 for log-resistivity. Further model is applied to real-world field GPR data, which produced spatially coherent snow and soil moisture maps, yielding snow liquid water content of 2%–4% and soil moisture estimates of 15%–26%, in strong agreement with in situ snowpit observations. These findings demonstrate that the ViT–BiLSTM framework enables fast, physically consistent dual-parameter inversion, offering a scalable solution for operational snow hydrology, meltwater prediction, and cryospheric monitoring.}
}
@article{CUI2026135398,
title = {Effects of check dam construction on runoff–sediment processes and sediment deposition patterns in small watersheds under continuous rainfall conditions},
journal = {Journal of Hydrology},
volume = {672},
pages = {135398},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135398},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004956},
author = {Zhiwei Cui and Peng Li and Tian Wang and Chenyang Li and Songsong Ling and Jingjing Pan and Shengde Yu and Chaoya Zhang and Jianchun Han and Shu Yu},
keywords = {Soil erosion, Check dam, Simulated rainfall, 3D laser scanner},
abstract = {To quantitatively assess how check dam construction alters runoff–sediment processes and erosion–deposition patterns in small watersheds, we established a physical watershed model and subjected it to controlled indoor rainfall simulations. Four consecutive rainfall events with intensities of 60, 90, 120, and 150 mm/h were applied, and surface topography before and after each event was captured using high-resolution three-dimensional laser scanning. The experiments aimed to elucidate the hydrological and geomorphological responses of the watershed. Runoff and sediment yield increased progressively with rainfall duration and then approached quasi-steady values with only minor fluctuations. Relative to the no-dam scenario, runoff in the dammed watershed decreased by 1.8–12.3%, while sediment yield was reduced by 22.72–42.44%. Under varying rainfall intensities, the no-dam scenario model was dominated by severe erosion, exhibiting a soil loss volume of 0.0059 m3/m2and limited deposition 0.02 m3. In contrast, the presence of a check dam substantially mitigated main-channel incision and effectively constrained gully and bank erosion within the dam-controlled area, reducing soil loss to 0.0039 m3/m2and increasing total sediment deposition to 0.19 m3. The check dam elevated the local erosion base level, weakened flow energy, and promoted sediment retention upstream. Together, these results demonstrate that check dam construction markedly modifies the hydrological and geomorphic evolution of small watersheds under continuous rainfall, and they provide a process-based basis for optimizing dam design and sediment-management strategies on the Loess Plateau and in other erosion-prone regions.}
}
@article{BARBACEBALLOS2026135346,
title = {Unsupervised machine learning applied to Sentinel-2 time series for monitoring coastal lagoon water quality},
journal = {Journal of Hydrology},
volume = {672},
pages = {135346},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135346},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004439},
author = {Paola Barba-Ceballos and Sergio Heredia and Gabriel Navarro and Belén Rosado and Mar Roca-Mora and Isabel Caballero},
keywords = {K-means, STL decomposition, Copernicusprogramme, Zoning, Eutrophication, MarMenor},
abstract = {Artificial intelligence (AI) is transforming environmental monitoring by enabling automated, data-driven analysis of complex, high-dimensional datasets. In this study, we introduce an AI-based framework to identify the areas most affected by ecological degradation and to analyze their spatio-temporal dynamics using multispectral satellite imagery. The time series of Sentinel-2 , spanning from July 2015 to June 2024, was processed using ACOLITE atmospheric correction. Unsupervised machine learning techniques (k-means clustering) combined with Seasonal, Trend decomposition using Loess (STL) were applied to characterize water quality patterns and temporal dynamics. The framework was developed in the Mar Menor coastal lagoon (SE Spain), where STL decomposition enabled the separation of long-term trend, seasonal variability, and residual anomalies in chlorophyll-a and turbidity, linking extreme events occurring in the lagoon with significant anomalies observed in the historical remote sensing data. This hybrid approach allowed us to differentiate regions with similar optical and ecological behavior into four well-defined zones at 10 m spatial resolution. The integration of unsupervised AI-based clustering and statistical time-series decomposition offers a powerful, scalable, and transferable methodology for automated lagoon monitoring. These results provide useful information for designing and implementing conservation and management strategies, and offer a robust analytical basis for future prevention and restoration strategies.}
}
@article{KHORAMI2026135354,
title = {Estimation of root zone water storage capacity (Sr) in natural ecosystems subject to high interannual climate variability},
journal = {Journal of Hydrology},
volume = {672},
pages = {135354},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135354},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004518},
author = {Maryam Khorami and Gary J. Sheridan and Keirnan Fowler and Patrick N.J. Lane},
keywords = {Root zone water storage capacity, Interannual climate variability, Cumulative water deficit},
abstract = {The water storage capacity (Sr)—the maximum water available to plants in the root zone—plays a crucial role in land–atmosphere interactions, evapotranspiration, and resistance to drought. However, common cumulative water deficit (CWD) procedures for estimating Sr typically reset the deficit to zero annually, capturing seasonal rather than long-term cumulative effects. This may not be optimal in regions with high interannual climate variability, where water deficits can carry over from year to year. Two CWD approaches were evaluated across 105 forested catchments in Australia using daily precipitation, actual evapotranspiration, and streamflow data from 2000 to 2022. The first resets the cumulative water deficit at the start of each hydrological year, consistent with previous studies, whereas the second allows deficits to accumulate over multi-year periods. Sr ranged from 113 to 664 mm for the single-year method and from 113 to 1023 mm for the multi-year method. In catchments with high interannual climate variability, the median Sr was 25% higher under the multi-year approach, with the greatest divergence in southeastern Australia where actual evapotranspiration exceeded precipitation for multiple consecutive years. The divergence increased with aridity and decreased with mean annual precipitation, while the two methods converged in humid catchments where inter-annual carryover was negligible. These findings suggest that, under the CWD-based definition of Sr adopted here, the multi-year formulation provides a more complete estimate of plant-accessible storage in regions with high interannual climate variability.}
}
@article{YANG2026135310,
title = {Fusing dynamic physical constraints with PINN-xLSTM to enhance accuracy and physical consistency in runoff prediction under extreme hydrological events},
journal = {Journal of Hydrology},
volume = {672},
pages = {135310},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135310},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004075},
author = {Yafeng Yang and Wenbao Zhang and Fawen Li and Hongrui Wang and Haoran Zhang},
keywords = {Runoff forecasting, Extreme hydrological phenomena, Physical consistency, Interpretability, PINN-xLSTM},
abstract = {Given the frequency of extreme hydrological events, runoff prediction remains a substantial issue due to the pronounced nonlinearity, nonstationarity, and abrupt shifts inherent in basin hydrological processes. Traditional hydrological models are not adaptable to extreme scenarios, but data-driven deep learning models, despite their excellent forecast accuracy, frequently lack physical interpretability and may violate fundamental hydrological principles. To address these difficulties, this research provides a runoff forecast method that combines time series modeling and adaptive physical limitations. The key innovation is the creation of a dynamic physical constraint weighting mechanism that adjusts the importance of various physical constraints in response to defined hydrological scenarios (normal, flood, and drought periods). Unlike static physical restrictions, this method amplifies runoff generation limits during floods while emphasizing groundwater attenuation mechanisms during droughts, better representing the abruptness and persistence of runoff during extreme occurrences. This mechanism is included in a hybrid model that combines a Physical Information Neural Network (PINN) and an extended Long Short-Term Memory (xLSTM) network, resulting in synergistic time-dependent modeling and physical consistency. The model was evaluated at the Tangnaihai hydrological station in the Yellow River’s headwaters, then validated across regions at the Toudaoguai and Luokou stations. The model outperforms comparison models in prediction accuracy, flood peak characterization, and physical consistency (R2 = 0.985, RMSE = 53.18, physical constraint violation rate of 0.008). This provides a reliable and interpretable approach for runoff prediction under extreme hydrological conditions.}
}
@article{CHEN2026135362,
title = {An integrated framework for mapping agricultural water impoundments using Sentinel −2 and GEE in Northwest China},
journal = {Journal of Hydrology},
volume = {672},
pages = {135362},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135362},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004592},
author = {Haochong Chen and Yuxiang Zhang and Haichao Yu and Sien Li},
keywords = {Agricultural water impoundments, Satellite-2, GEE, Reservoir},
abstract = {Agricultural water impoundments are crucial for agricultural production in arid regions, but their small size has hindered large-scale monitoring with traditional remote sensing techniques. This study presents a tailored mapping framework for annual monitoring of agricultural water impoundments (AWIs) in arid regions, where conventional methods fail due to their field-scale size. By introducing a novel mapping framework that couples inter-annual water persistence analysis with vector-derived morphometric features within an ensemble learning architecture, our approach overcomes the limitations of conventional remote sensing methods and accurately distinguishes AWIs from natural water bodies (overall accuracy = 0.89)—enabling the first high-resolution (10 m), multi-year inventory (2018–2023) across the Hexi Corridor. In 2023, we identified 2,037 impoundments, with their areas ranging from 1000 to 10000 m2. In addition, 26.5% of them were constructed in 2022, when large-scale AWIs became construction priority, accounting for 63.5% of the newly-built AWIs that year. Furthermore, for the first time, three distinct types of river-reservoir-AWI distribution patterns in Hexi Corridor have been identified through an upstream–downstream analysis. AWIs, closer to rivers than wells, serve as immediate irrigation distribution points for riverine water sources. Our study provides a new perspective for monitoring agricultural water infrastructure in arid regions, offering critical insights into sustainable water resource management.}
}
@article{WANG2026135318,
title = {Mapping glacial lakes with glacial-lake compact efficient neural network (GCE-Net): perspectives on balancing model size and performance},
journal = {Journal of Hydrology},
volume = {672},
pages = {135318},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135318},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004154},
author = {Qing Wang and Zhi-Dong Yao and Xu-Feng Yan},
keywords = {Glacial lake mapping, Lightweight neural network, Remote sensing image segmentation, Geographic adaptability, Deep learning},
abstract = {Rapid glacier retreat in the Himalayas is accelerating glacial lake formation and expansion, increasing potential GLOF risk. Frequent, large-area mapping is needed to track rapidly changing lakes, but the computational cost of deep learning models limits high-frequency updates in resource-constrained mountain regions. To address this limitation, we propose GCE-Net (Glacial-lake Compact Efficient Neural Network), a compact segmentation framework designed to improve efficiency while maintaining accuracy (F1 score = 94.43%). GCE-Net uses a ResNet-34 encoder and a UNet++ decoder improved with Ghost modules and Efficient Channel Attention (ECA). After training, we apply a depth-guided structured pruning strategy to the full architecture without additional fine-tuning. Results show that the pruning level L3 sub-network (L3) provides a favorable balance between accuracy and efficiency, reducing parameters by 62.7% and computation by 30.6%, while incurring only a minor change in accuracy (F1 decrease < 0.3%). The trained GCE-Net was applied to the Southeastern Tibetan Plateau (SETP) to generate a 2023 glacial lake inventory, including 6,455 lakes with a total area of 400.18 km2. Comparison with published 1990 and 2018 inventories indicates faster lake growth after 2018, with recent increases dominated by small-to-medium lakes. For lakes that persisted from 1990 to 2023, net area change was positive within 0–2 km of glaciers but negative beyond 2 km, and the average per-lake change generally weakened with distance.}
}
@article{YU2026135321,
title = {Accumulated ecohydrological impacts and ecological risk of mega-cascade reservoir operations},
journal = {Journal of Hydrology},
volume = {672},
pages = {135321},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135321},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600418X},
author = {Meixiu Yu and Hanlin Song and Jianyun Zhang and Junliang Jin and Qingshe Meng and Juan Chen and Jiayi He and Xiaolong Liu and Yufeng Ren and Zixuan Xu and Zhixiang Min},
keywords = {Largest river regulation, Hydrological regime shift, Complex cumulative impact, Ecological stress and risk},
abstract = {Mega-cascade hydropower systems are pivotal to global water–energy security but profoundly reshape riverine ecosystems through complex cumulative impacts, which remain challenging to quantify comprehensively, particularly at large basin scales. The Yangtze River hosts the world’s largest clean-energy corridor—a six-dam cascade comprising four mega-reservoirs on the lower Jinsha River together with the Three Gorges–Gezhouba system—providing a unique natural laboratory. This study systematically examines the evolution, accumulation, and ecological implications of downstream hydrological changes across successive operational phases of cascade development. Results show that: (1) Cascade expansion markedly intensifies hydrological alterations and enhances multi-scale flow complexity, expressed as greater irregularity and reduced predictability; (2) The proposed Cumulative Eco-hydrological Effect Index effectively captures the non-linear propagation of cascade impacts, demonstrating that the transition from the Xiangjiaba–Xiluodu configuration to the four-reservoir joint operation amplified the cumulative regulation effects by 2.3-fold; (3) The ecological risk classification framework developed enables dynamic assessment of risk levels along reservoir-affected river reaches, revealing pronounced spatial and temporal accumulation of ecological risk. Moderate-risk conditions were most frequent during the Xiangjiaba–Xiluodu phase (7 times in average), whereas extreme-high-risk conditions were primarily concentrated during the four-reservoir stage of the lower Jinsha River (3.5 times in average).}
}
@article{FU2026135342,
title = {A multi-interface dissolved oxygen model development for the rivers controlled by gates in the coastal plain river network: An empirical analysis in Jinhuigang River, Shanghai},
journal = {Journal of Hydrology},
volume = {672},
pages = {135342},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135342},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004397},
author = {Xiaoli Fu and Shilong Fu and Ying Liu and Bingjiang Dong},
keywords = {Dissolved oxygen, Multi-interface model, Sediment oxygen demand (SOD), Water–sediment interface, Sediment resuspension, Gate-controlled rivers},
abstract = {In gate-controlled rivers of coastal plain networks, routine gate operations can induce sediment resuspension and alter atmospheric reaeration, leading to transient hypoxia in specific reaches. At the sediment–water interface, previous studies mainly focused on sediment oxygen demand (SOD) under low flow or even still conditions. To date, a robust predictive tool has remained lacking for the gate-controlled plain rivers, which are characterized by strong turbulence, high sediment resuspension, and complex tributary inflows. Using the Jinhuigang River in Shanghai as a case study, this study predicted transient SOD under various turbulent conditions and explicitly incorporated atmospheric reaeration processes and hydrodynamic effects of tributary inflows on main channel. A multi-interface DO model across the water–sediment (WSI) and water–air (WAI) interfaces was developed to quantify DO transient concentrations in the overlying water and site-specific SOD under various gate operation scenarios. Model prediction and field validation indicated that: (i) the proposed model accurately captured transient variations of DO concentration at three monitoring sites, with an average relative error of 4.02%; (ii) DO concentrations and SOD during gate operations exhibited a characteristic three-phase pattern (including, initial, regulation, and equilibrium), and this pattern was closely related to hydrodynamic processes; (iii) the SOD displayed significant spatial heterogeneity; in particular, the areas with intense hydrodynamic fluctuations and high potential for oxygen-consumption substances to be released from the sediment were likely to become the hypoxia hotspots; and (iv) the equivalent bulk thickness of resuspended sediment (hs) was closely correlated, serving as an effective parameter for quantifying resuspension intensity. This study advances the understanding of SOD contribution to DO temporal variation under complex hydraulic conditions, providing a novel predictive tool and theoretical framework for hypoxia management in gate-controlled coastal plain rivers.}
}
@article{SHEN2026135326,
title = {Hydrochemical model of a fault-controlled playa (Jiahu) in the piedmont of Altun Mountain, Qaidam Basin, China: Insights from Sr, B, H, O isotopes, and chemical compositions},
journal = {Journal of Hydrology},
volume = {672},
pages = {135326},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135326},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004233},
author = {Lijian Shen and Yanjun Zhao and Wei Li and Bing Pan},
keywords = {The Qaidam Basin, Fault-controlled playa, Chemical compositions, Multiple isotopes, Deep-seated Ca-rich brine, Hydrochemical model},
abstract = {The salt lakes in the Qaidam Basin are commonly recharged by Ca-rich karst spring waters that have risen to the surface along fault zones in addition to river waters. Those Ca-rich spring waters are chemically similar to the Tertiary oilfield waters within the basin and can shift the hydrochemical type of salt lake brines from SO4-rich type (with equivalents of SO4 + 1/2HCO3 > Ca) to Ca-rich type (with equivalents of Ca > SO4 + 1/2HCO3) if supplied in sufficient volume. The Jiahu Playa, located in the piedmont of the Altun Mountain, contains both SO4-rich and Ca-rich brines as well. The chemical compositions, Sr, B, H, and O isotopic compositions of water bodies with varying levels of salinity from the Jiahu Playa suggest that the playa is being recharged by river waters, oilfield waters from the Tertiary Lenghu anticline, and probably deep-seated basalt-aquifer formation waters. Although the oilfield waters and deep-seated basalt-aquifer formation waters were both Ca-rich, the latter (basalt-aquifer waters) is the dominant influence on the formation of Ca-rich surface brines in the Jiahu Playa. To the north of the playa, the surface brines are characterized by Ca-rich and relatively low 87Sr/86Sr ratios (the lowest values reported in the basin). To the south of the playa, the input of oilfield water caused the elevation of δ11B values and the surface brine remained SO4-rich. The H and O isotopic compositions of water bodies collected from different parts of the playa align with a local evaporation line, which intersects with the local meteoric line. This indicates that, in terms of water molecules, the volumetric contribution of Ca-rich brines (both oilfield waters and basalt-aquifer waters) is very small in quantity compared to river waters. The evolution of δ18O and δD values was mainly controlled by strong evaporation of river waters. This study demonstrates that the fault-related Ca-rich waters in the Qaidam Basin have different origins in light of the characteristic of the fault.}
}
@article{YIN2026135350,
title = {Exploring a process-aware spatiotemporal graph-based surrogate for integrated urban drainage simulation},
journal = {Journal of Hydrology},
volume = {672},
pages = {135350},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135350},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004476},
author = {Boyan Yin and Ruidong Li and Baoxiang Pan and Guangheng Ni},
keywords = {Urban drainage system, Graph neural network, Long short-term memory, Surrogate model, Explainable artificial intelligence},
abstract = {In recent decades, intensifying extreme rainfall and flood disasters underscore the importance of intelligent flood risk mitigation informed by urban drainage models (UDMs). However, high computational costs of UDMs limit their applicability to implement advanced stormwater management strategies, leading to growing interests in building efficient surrogates for existing UDMs. However, existing approaches face several key limitations including incomplete representation of rainfall–runoff-routing processes, insufficient encoding of drainage network regulation, and a lack of physical explainability. To address these gaps, this study proposes a Process-Aware Spatio-Temporal graph-neural-networks-based surrogate model, PAST, holistically simulating hydrological and hydrodynamic processes while incorporating regulation effects. PAST leverages Long Short-Term Memory (LSTM) networks for rainfall–runoff simulation and integrates Graph Attention Networks with LSTM (GAT-LSTM) for hydrodynamic routing, further introducing the adaptive connectivity layer for plausible embedding of element-level control rules. Applied to a residential area with moderate imperviousness, PAST achieves high performance with Nash-Sutcliffe Efficiency (NSE) values of 0.96 for water depth and 0.88 for total inflow simulations, substantially outperforming baseline models—particularly under regulated conditions and during extreme rainfall events. Additionally, attention-based explainability analysis reveals that PAST learns physically plausible dynamics by allocating more attention weights to nodes contributing higher inflows, thereby enhancing the transparency and diagnosability of the developed surrogate model. Compared to prior research, this work advances integrated, interpretable and efficient surrogate modeling for urban drainage systems with reliable physical mechanisms, offering a robust foundation for intelligent stormwater management.}
}
@article{WANG2026135334,
title = {A multi-source comprehensive risk quantification method for cascade reservoirs based on Monte Carlo simulation, HEC-RAS and Bayesian networks: Development and application in the Dadu river Basin},
journal = {Journal of Hydrology},
volume = {672},
pages = {135334},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135334},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004312},
author = {Ting Wang and Haopeng Yuan and Yanlong Li and Tianle Zhang and Ye Zhang and Junrui Chai and Yunhe Liu},
keywords = {Cascade reservoirs, Multi-source comprehensive risks, HEC-RAS, Monte Carlo simulation, Machine learning, Bayesian networks},
abstract = {The failure of cascade dams is prone to triggering the superposition, transmission, and amplification of risks in the reservoir group of a river basin. Accurate assessment of the comprehensive risks of cascade reservoirs is of decisive significance for the safe operation of water conservancy systems and the protection of people’s lives and property. At present, the traditional comprehensive risk analysis methods based on flood disaster risk transmission have obvious limitations. They only focus on single risk factors like flooding, and the flood routing analysis mostly adopts empirical formulas, resulting in insufficient assessment accuracy. To address this issue, we propose a novel multi-source comprehensive risk quantification method for cascade dams integrating Monte Carlo simulation, the hydrodynamic model and Bayesian networks. Firstly, Monte Carlo simulations are applied to the hydrodynamic model simulated in HEC-RAS by combining with self-developed programs using Visual Basic for Applications. This application enables automated analysis of actual river flood routing, considering random flood frequencies and random initial reservoir water levels. Meanwhile, machine learning algorithms including N-M, Adam, and DE are employed to conduct inverse analysis of river roughness, which is determined as 0.0833. Then, based on the analysis of overtopping damage from flood evolution after dam failures in cascade reservoirs, we quantitatively analyze the inter-dam transmission risks by applying the theory of comprehensive influence coefficients. Further, we combine the risk analysis results of floods, earthquakes and landslides for each dam in the system, and use Bayesian networks to assess the failure risk of each individual dam. Finally, by integrating the transmission risk analysis, we develop a multi-source comprehensive risk analysis method for cascade reservoir systems.This method is applied to four cascade dams in the Dadu River Basin of Sichuan Province, China. The results show that the main cause of the single dam failure is the rare high-energy floods, and earthquakes have a significant impact on dam losses. The Changheba Dam has the highest reliability and can block risks, while the Huangjinping Dam and the Luding Dam require focused attention due to their relatively high comprehensive risks. We recommend prioritizing enhanced monitoring and structural reinforcement for the critical dams including Huangjinping and Luding. This method is expected to accurately quantify the risk transmission between dams in cascade reservoir groups under multi-disaster scenarios, thereby contributing to risk management and plan formulation for the water conservancy system.}
}
@article{KUBOTA2026135402,
title = {A soil–plant–atmosphere continuum model reflecting the responses of plant hydraulic resistance to waterlogging},
journal = {Journal of Hydrology},
volume = {672},
pages = {135402},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135402},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004993},
author = {Shigehiro Kubota and Kazuhiro Nishida and Shuichiro Yoshida},
keywords = {Root water uptake, Stomatal conductance, Reoxygenation, Rotational paddy field, Soybean},
abstract = {In humid regions, intensive and intermittent precipitation has increased due to climate change, resulting in frequent waterlogging. Although waterlogging severely impedes the root hydraulic functions of a broad range of plant species, only a few studies have attempted mechanistic representation of plant responses to waterlogging. We hypothesized that incorporating plant hydraulic response to waterlogging into root water uptake model improves the estimation accuracy of water dynamics in humid regions. To test this hypothesis, we constructed two models: reference soil–plant–atmosphere continuum model, in which plant hydraulic resistance is constant, and a modified model (MM), in which plant hydraulic resistance increases with waterlogging. The performance of the models was tested using observed data of the soybean canopy cultivated in paddy field under humid climate. The MM accurately reproduced the increase in plant hydraulic resistance during the cultivation period. Modifying the model improved the estimation accuracy of the evapotranspiration rate and leaf water potential, especially on clear days after prolonged waterlogging. This performance improvement of MM was observed when evaporative demands exceeded 0.4 mm h−1 and was not dependent on soil water availability. An increase in plant hydraulic resistance due to soil waterlogging caused an imbalance between the atmospheric evaporative demand and the water uptake capacity of the roots, resulting in a midday depression in the evapotranspiration rate. These findings highlight that a process-based model incorporating the response of plant hydraulic resistance to waterlogging is useful for improving the understanding of water dynamics and leaf gas exchange in humid climates.}
}
@article{GEBRU2026135384,
title = {Impacts of climate and land use/land cover change on groundwater recharge in Giba Basin, Northern Ethiopia},
journal = {Journal of Hydrology},
volume = {672},
pages = {135384},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135384},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004816},
author = {Atsbha Brhane Gebru and Tesfamichael Gebreyohannes and Gebrerufael Hailu Kahsay and Gebremedhin Berhane and Miruts Hagos and Abdelwassie Hussien},
keywords = {Climate change, LULC, WetSpass-M model, Groundwater recharge, Giba basin},
abstract = {Groundwater is a principal source for meeting irrigation and domestic needs in the semi-arid region of the Giba basin, northern Ethiopia. This study evaluates the historical and future impacts of land use/land cover (LULC) and climate change on groundwater recharge dynamics of the Giba basin using the physically distributed WetSpass-M model. The model was calibrated monthly by comparing simulated results with field-measured surface runoff and base flow. The analysis period includes historical (1984–2024) and future projection (2024–2044) under two Representative Concentration Pathways (RCPs4.5 and 8.5). The results show a decline of barren land from 19% in 1984 to 3.6% in 2024 and an increase of rainfall by + 188 mm in the same period. Consequently, these changes have resulted for an increase of annual recharge from 28.4 mm/yr (5.4% of rainfall) to 71.8 mm/yr (10.7% of rainfall), respectively. Similarly, mean annual recharge is projected to increase by + 12 mm/yr and + 6.7 mm/yr in the 2040 s compared to the 2020 s under the RCP8.5 and RCP4.5 scenarios, respectively. However, a slight decline of projected rainfall and recharge during the dry season under the two scenarios can intensify the existing soil moisture-deficit problems during the irrigation periods. Moreover, reduction of recharge due to urbanization and deforestation (in some locations) is witnessed in the study area from 1984 through 2044 under both RCP8.5 and 4.5 scenarios. Therefore, site-specific aquifer recharging mechanisms, rather than imposing the traditional ‘one-size-fits-all’ approach that does not consider spatiotemporal heterogeneity of catchment characteristics at a local level, are required to enhance groundwater sustainability so as mitigate climate change impacts. In this regard, implementation of managed aquifer recharge in selected areas can significantly improve groundwater availability.}
}
@article{QIAO2026135329,
title = {A novel method for improving bathymetry-based estimation of lake water storage on the Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {672},
pages = {135329},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135329},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004269},
author = {Baojin Qiao and Zhongxuan Wang and Jianting Ju and Liping Zhu},
keywords = {Lake, Bathymetric data, Spatial interpolation, Water depth inversion, Water storage},
abstract = {Estimating lake water storage on the Tibetan Plateau (TP) is an important part of lake research and is usually based on surrounding topography or bathymetric data. To reduce measurement costs, the zigzag line method is usually employed in TP lakes rather than the grid point method. However, this method maybe introduce large errors into the estimation of lake water storage and its change due to sparse bathymetric data in areas near the lake shore, which mainly result from the limited measurement density of the zigzag survey lines. This study aimed to determine the most effective method for addressing these gaps. Six lakes that had undergone bathymetric surveys using the zigzag line method were selected. Four methods of establishing the underwater topography were compared in six lakes: bathymetric data interpolation; bathymetric data combined with SRTM DEM interpolation; bathymetric data combined with multi-period lake boundary interpolation; and water depth inversion with random forest. The results found that the water depth inversion with random forest method showed high precision, and the mean absolute error ranged from 0.18 to 1.68 m within 30 m water depth, except for Aqikekule Lake. We estimated the water storage change using ICESat/ICESat-2 and Landsat image as “true value”, and assessed the accuracy of underwater topography from four methods, found that the accuracy of the bathymetric data combined with multi-period lake boundary interpolation was the highest with average error of 2.05%, which represented an average improvement of 11.98% across the six lakes relative to bathymetric data interpolation, followed by water depth inversion with 3.93%, and the method of bathymetric data interpolation was poorest with 10.14%. The accurate estimation of lake water storage on the TP is helpful to understand the total water storage of “Water Tower of Asia” and water resources management.}
}
@article{ZHANG2026135365,
title = {Multi-source isotopic tracing reveals meltwater runoff processes and environmental responses in the Yarlung Tsangpo River Basin},
journal = {Journal of Hydrology},
volume = {672},
pages = {135365},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135365},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004622},
author = {Zijun Zhang and Xuegao Chen and Hui Lin and Tongqing Shen and Qin Ju and Shiqin Xu and Ningpeng Dong and Peng Yi and Peng Chen and Naifeng Zhang and Yong Huang and Jinguo Wang and Zhongbo Yu},
keywords = {Meltwater runoff generation, Seasonal freeze–thaw processes, Stable isotopes, Yarlung Tsangpo River, Environmental responses},
abstract = {The Yarlung Tsangpo River (YTR), a major plateau river on the southern Tibetan Plateau (TP), exhibits complex hydrological processes under ongoing climate change. Although freeze–thaw are recognized as critical factors influencing plateau river runoff, the underlying generation mechanisms and the quantitative contributions of various water sources remain insufficiently understood. By integrating high-frequency monitoring and isotopic tracing (2020–2023) with End-Member Mixing Analysis, this study quantified the spatial and seasonal contributions of glacial meltwater, snow meltwater, precipitation and groundwater to streamflow, in the middle YTR across four freeze–thaw stages from April to July. An “Inverse Elevation Effect” on δ18O was observed along the Yarla Shampo Glacier hillslope, arising from strong transverse vapor mixing during atmospheric moisture transport. Glacial meltwater dominated streamflow, especially in the upper watershed during the initial melting stage (67.2%), but contributions shifted seasonally: groundwater and snow meltwater increased substantially during accelerated and rapid melting stages, while precipitation became dominant (36.6–37.5%) in the final melting stage at July, indicating a major seasonal transition in hydrological drivers. Notably, whereas surface water sources fluctuated widely, groundwater maintained a remarkably consistent seasonal flux, emphasizing its role as a fundamental hydrological buffer that supports basin-wide water resilience through the freeze–thaw cycle. Spatially, contributions from groundwater and snow meltwater were consistently higher in downstream regions than upstream, reflecting the cumulative input from tributaries and subsurface flow along the watershed. Integrating these processes, this study proposed a novel conceptual model of freeze–thaw-driven runoff generation that incorporated topography and vegetation interactions to elucidate spatiotemporal patterns in streamflow composition. This study provides quantitative insights for refining runoff generation models and predicting hydrological responses of high-altitude cold regions to climate warming, offering guidance for groundwater management and climate adaptation strategies.}
}
@article{REDAELLI2026135337,
title = {Changes in irrigation practices may deplete aquifers faster and more severely than meteorological droughts: A numerical modeling approach},
journal = {Journal of Hydrology},
volume = {672},
pages = {135337},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135337},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004348},
author = {Agnese Redaelli and Tullia Bonomi and Davide Sartirana and Gianfranco Sinatra and Daniel T. Feinstein and Randall J. Hunt and Marco Rotiroti and Chiara Zanotti},
keywords = {Groundwater recharge, Climate change, Water management, Po plain},
abstract = {Groundwater availability worldwide is threatened by a changing climate. Aquifers in intensively irrigated systems may present peculiar vulnerability to climate change related to changes in irrigation practices triggered by potential surface water scarcity. This work aims to provide a quantitative assessment of the major drivers of aquifer depletion in agricultural areas: hydrological droughts and changes to more efficient irrigation practices as a response to reduced surface availability. Based on a site-specific conceptual model, a three-dimensional combined steady-state and transient numerical groundwater flow model was developed and calibrated using groundwater level and groundwater-river exchange flow data to reconstruct the 2015–2017 dynamics of an intensively irrigated hydrogeological system, where irrigation return flow dominates the recharge mechanism. Two hypothetical scenarios were simulated: (1) a two-year meteorological drought and (2) a change in irrigation practices from surface irrigation method to the more efficient drip irrigation technique, while maintaining all other conditions the same as in the baseline simulation. The drought scenario leads to a significant reduction of the recharge processes, resulting in a total groundwater storage loss of 2.34 × 105 m3/d over the two simulated years. However, the relative dynamics and seasonal patterns of groundwater storage, groundwater heads, lowland springs discharge, and surface water-groundwater interactions observed in the baseline simulation are preserved. In contrast, the scenario representing the reduction in irrigation return flow determines a disruption in the seasonal pattern over the two simulated years, leading to a loss in groundwater storage up to 2.77 × 105 m3/d and critical impacts on lowland springs and connected surface water bodies. The comparison of baseline conditions and the two scenarios demonstrates that surface-water irrigation return flow is critical to sustaining groundwater balance and the ecological functioning of groundwater-dependent systems in intensively cultivated areas. Therefore, the results indicate that potential policymakers’ adaptation measures to address surface water scarcity induced by climate change may have a more significant impact on groundwater resources than the direct effects of climate change itself, highlighting the crucial role of scientific evidence in informing and guiding policymakers.}
}
@article{ROBB2026135373,
title = {From rock to radon: determining secular equilibrium concentrations},
journal = {Journal of Hydrology},
volume = {672},
pages = {135373},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135373},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004701},
author = {Linda Robb and Leanne K. Morgan and Eddie W Banks and Scott Wilson},
keywords = {Diffusion experiments, Surface water-groundwater interaction, Braided rivers, Environmental tracers, Groundwater velocities},
abstract = {Radon (Rn-222) is widely used as a tracer for identifying surface water-ground water interactions. To use Rn-222 as a tracer, the Rn-222 secular equilibrium concentration in groundwater is required. This is achieved by taking multiple field samples at distances from the river, which is not always achievable in practice. This study compares four commonly used laboratory techniques (diffusion experiments) for determining Rn-222 secular equilibrium to assess whether they yield consistent results. Laboratory-derived equilibrium values were compared with measured groundwater Rn-222 concentrations. The influence of sediment characteristics, including grain size, sorting, silt and clay content, and porosity on radon emanation rates was further examined. Sediment samples were collected from eight drillholes to depths of up to 30 m within a braidplain aquifer in Aotearoa New Zealand, along with groundwater samples from 24 monitoring wells completed in the same system. In total, 240 diffusion experiments and 24 groundwater samples were analysed. Results show that the four laboratory methods produced different equilibrium values, with median estimates ranging from 2.7 to 47.5 Bq/L. Method 2 (500 mL shaken samples) showed agreement with measured groundwater concentrations. However, groundwater concentrations were less than laboratory estimates of equilibrium values especially at shallow depth. Due to high groundwater velocities in braided river environments, Rn-222 in groundwater is unlikely to reach equilibrium nearby to the river and therefore diffusion experiments provide a complementary Rn-222 equilibrium estimate. Finer-grained sediments with higher silt and clay content (<63 µm) released greater amounts of Rn-222, highlighting the importance of collecting representative sediment samples.}
}
@article{FRONZI2026135324,
title = {Toward quantitative DNA tracer tests: development and validation of a novel capture device for groundwater flow characterization in karst and carbonate aquifers},
journal = {Journal of Hydrology},
volume = {672},
pages = {135324},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135324},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600421X},
author = {Davide Fronzi and Vesna Milanović and Stefano Palpacelli and Alberto Tazioli and Lucia Aquilanti},
keywords = {DNA tracers, Groundwater, Hydrogeology, Passive sampling, qPCR quantification, Streptavidin-biotin interaction, Hydrological tracers},
abstract = {Synthetic DNA tracers represent an innovative solution to overcome the limitations of conventional hydrological tracers, particularly in complex and large-scale hydrogeological systems. However, prolonged tracer tests still rely on manual sampling, which often provides sparse temporal coverage, increasing the risk of missing concentration peaks and biasing breakthrough curve (BTC) interpretation. In addition, repeated site visits entail significant logistical effort and cost. To address these constraints, this study presents the development and validation of a novel passive device that selectively captures biotinylated synthetic DNA tracers, enabling time-integrated, semi-quantitative assessment of groundwater flow and pollutant migration. The device integrates streptavidin-functionalized superparamagnetic beads (1.0 µm; binding capacity ∼ 500 pmol/mg) encapsulated in 0.6% (w/v) agarose hydrogel pearls and housed in a sealed hybridization chamber. Laboratory column tests (1.65 × 10–4 L/ s; hydraulic gradient 1.4%) and a field-scale experiment in a natural stream (∼6 L/s; 200 m reach), used as an analog for fracture flow or conduit flow in karst systems, benchmarked DNA behavior against conventional tracers (KCl, NaCl, fluorescein). Quantification by qPCR showed 100.2% efficiency and R2 = 0.997, with sensitivity < 10 DNA molecules per reaction. BTCs from manual sampling and the passive device closely matched conservative tracer responses. The passive device produced slightly broader BTCs, consistent with time-integrated capture and detection of delayed or retained fractions. This approach provides a reproducible method for tracing hydrological pathways in karst and carbonate aquifers, thereby facilitating broader application of DNA tracers in groundwater studies.}
}
@article{RAMANATHAN2026135345,
title = {Full historic record true colour changes in Greater Sydney drinking water supply systems in Australia},
journal = {Journal of Hydrology},
volume = {672},
pages = {135345},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135345},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004427},
author = {Thusyanthini Ramanathan and Quinn Ollivier and Lisa Hamilton},
keywords = {Apparent colour, Bayesian model, Full historic record trend, Raw water quality, True colour},
abstract = {True colour in drinking water poses no direct health risk; however, visibly coloured water (>15 TCU) often leads to consumer complaints. Long-term analyses of colour trends in drinking water reservoirs are limited by historical industry-wide shift from apparent to true colour monitoring techniques. This study established a conversion equation to estimate true colour (400 nm), from apparent colour, iron and turbidity, and applied this to data from 1931 to 1990 across eight reservoirs in New South Wales, Australia. A Bayesian hierarchical generalised linear model was then used to analyse full historic record trends (∼80 years) and compare the findings to constrained historic record trends derived only from direct sampled true colour values only. While observed true colour constrained historic record trends showed substantial increases across seven of eight reservoirs, incorporating full historic record converted true colour data resulted in either decreases or no change in four major reservoirs that collectively supply ∼ 90% of the region’s total drinking water volume. Notably, full historic record trends substantially reduced the rate of change compared to constrained historic record trends. These contrasting results highlight the opportunity of applying methods to make use of the full historic record for trend analysis. Qualitatively, we found that reservoirs showing decreasing colour trends were the largest in both surface area and storage volume, providing evidence that morphometry can be a driver of colour, through processes such as photooxidation, settling and mixing. Future research should prioritise understanding catchment condition change analysis, as well as long-term rainfall cycles and their relationship with reservoir colour, and integrating lake-specific biogeochemical processes to better explain in-lake true colour dynamics.}
}
@article{KANG2026135400,
title = {Reservoir operations for drought mitigation with dynamic hedging policy activated by drought limited water level and hedging coefficient intervals},
journal = {Journal of Hydrology},
volume = {672},
pages = {135400},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135400},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600497X},
author = {Yan Kang and Haoyue Zhang and Ying Gao and Xinyu Zhao and Songbai Song and Lingjie Li},
keywords = {Drought mitigation, VMD-GBDT prediction model, Dynamic hedging policy, Multi-objective reservoir operation, DLWL and HC intervals},
abstract = {Frequent severe droughts have significantly unfavorable effects on agriculture and socio-economic development. It is crucial to derive the relationship between droughts and irrigation water demand and to explore effective reservoir operation strategies for mitigating drought impacts. In this paper, a novel integrated modeling framework was proposed to mitigate drought effects by coupling a Variational Mode Decomposition and Gradient Boosting Decision Tree (VMD-GBDT) prediction model for irrigation water demand forecasting, a multi-objective reservoir optimal operation model, and a dynamic hedging theory. The VMD-GBDT model was developed to simulate the irrigation water demand interval in response to various drought impacts. The drought limited water level (DLWL) intervals and hedging coefficient (HC) were simultaneously identified by incorporating a hedging policy into the multi-objective reservoir optimal operation model based on long-term historical hydrological information and irrigation water demand intervals. The DLWL is divided into multiple substages by the Fisher method. Then, the dynamic hedging policy of reservoir operation is activated by the staged DLWL and HC intervals when various droughts occur. The proposed framework was implemented to assess the performance of drought mitigation in the Baojixia Irrigation Area (BIA) of Northwest China. The results demonstrated a significant interrelation between irrigation water demand and meteorological, hydrological, and agricultural droughts. The dynamic hedging policy of reservoir operation activated by 3-stage DLWL and HC intervals was positive in mitigating the impacts of drought. In consecutive typical drought years, the maximum water shortage rate (WSR) declined 34.9%, the Linjiacun reservoir drought periods were shortened by 13.9%, and 91.7% of the standardized storage anomaly (SSA) was stable or elevated in the virtual aggregated reservoir. In a severe drought year, the mean WSR decreased by 4.00%, the standard deviation of WSR dropped by 7.70%, the SSA of Linjiacun reservoir increased by 50%, and the minimal SSA of the virtual aggregated reservoir increased by 73.3%. The results indicated that the proposed systematic modeling framework, “prediction of irrigation water– identification of DLWL and HC intervals– reservoir operation with dynamic hedging policy”, is more effective at mitigating drought than the standard operating policy (SOP) and static hedging policy, providing a robust adaptive regulation approach during droughts.}
}
@article{XUE2026135353,
title = {Geostationary satellite observations reveal diurnal dynamics of particulate organic carbon in optically complex lakes},
journal = {Journal of Hydrology},
volume = {672},
pages = {135353},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135353},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004506},
author = {Kun Xue and Ronghua Ma and Minqi Hu and Menghua Wang and Yang Cheng and Lide Jiang and Zehui Huang},
keywords = {Particulate organic carbon, GOCI, Diurnal variation, Optically complex waters, Driving mechanisms},
abstract = {Diurnal dynamics of particulate organic carbon (POC) play a critical role in lake carbon cycling but remain poorly quantified at regional scales. Using hourly observations from the Geostationary Ocean Color Imager (GOCI) (08:16–15:16, UTC+8; 500 m spatial resolution), we examined POC variability across 52 lakes in the middle and lower reaches of the Yangtze and Huai River (MLYHR) basin in China (2011–2021). Four diurnal POC metrics, including the daily mean values of POC (POCmean), the coefficient of variation of POC (POCcv), relative difference between afternoon and morning POC (dPOC), and centroid of hourly POC (cPOC), showed substantial spatial and temporal variability. Both POCmean and POCcv peaked in summer and autumn, with maximum values in September (5.60 mg/L), and declined during winter and spring. Negative dPOC values (–6.48±15.39%) were found in 73.96% of pixels, indicating afternoon-dominated POC conditions, and cPOC was tightly clustered at 11.49±0.17 h (UTC+8). The Fuzzy C-Means clustering method identified three distinct diurnal POC patterns: Type 1 (decreasing), Type 2 (increasing), and Type 3 (midday peak). Interannual analyses suggested post-2014 trend shifts in diurnal POC metrics, with metric-dependent uncertainty. Driver analysis revealed that temperature and solar radiation primarily control diurnal POC dynamics, while wind influences POCcv by modulating the vertical movement and mixing of POC. Structural equation modeling highlighted distinct mechanisms underlying each diurnal pattern, particularly for dPOC and cPOC. These findings can provide a basis for optimizing lake carbon flux models by incorporating daytime diurnal POC dynamics, and highlight the necessity of incorporating diurnal-scale processes into environmental monitoring and policy frameworks.}
}
@article{BAIONI2026135264,
title = {A regionally based method to identify lithology-specific hydraulic conductivity distributions in shallow aquifers using catchment-scale effective values},
journal = {Journal of Hydrology},
volume = {672},
pages = {135264},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135264},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003616},
author = {Elisa Baioni and Hélène Hivert and Jean Marçais and Nicolas Cornette and Ronan Abhervé and Enzo Maugan and Clément Roques and Alexandre Boisson and Jean-Raynald {de Dreuzy}},
keywords = {Hydraulic conductivity, Statistical modeling, Parameter estimation, Crystalline rocks},
abstract = {We present a novel method for estimating lithology-specific hydraulic conductivities from catchment-scale effective values, each interpreted as a linear combination of the conductivities of the underlying lithologies. The method particularly applies to discharge-derived estimates of effective conductivity, where river networks integrate the influence of predominantly shallow groundwater flows from adjacent hillslopes. Lithological area fractions are used as weights to formulate an overdetermined linear system, which is solved using a modified method of moments under the assumption of lognormally distributed conductivities to account for spatial variability. The method was validated on synthetic cases and applied to 113 catchments in the Armorican Massif (France). It shows good convergence properties and achieves high predictive accuracy: in 85% of cases, the modeled conductivities fall within a 90% confidence interval of the observed values. Convergence analysis indicates that using five catchments per lithology is sufficient to reach 75% predictive success, with mean and standard deviation parameters estimated within 6% and 30%, respectively. With 80 catchments, prediction accuracy increases to 80%, and parameter estimation errors are reduced to 3% and 15%. The method is computationally efficient and generalizable, offering a powerful tool to explore lithology-specific conductivity datasets at regional scales. It may also be adapted to other variables, such as porosity, where linear averaging applies, enabling broader applications in hydrogeological modeling.}
}
@article{NAKAJIMA2026135361,
title = {Refining isotopic estimates of the evaporation-to-inflow ratio: The role of lake-atmosphere interactions},
journal = {Journal of Hydrology},
volume = {672},
pages = {135361},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135361},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004580},
author = {Keito Nakajima and Ikuya Adachi and Tsutomu Yamanaka},
keywords = {Lake, Hydrogen and oxygen stable isotopes, Evaporation, Water balance, Energy Balance},
abstract = {The evaporation-to-inflow (E/I) ratio is an important index characterizing lake water balance and is often estimated using isotopic methods. However, the sources of uncertainty in such estimates remain poorly quantified. Here, we present results from four years of isotopic monitoring of Lake Kussharo, northern Japan, along with spatial observations of adjacent rivers at 37 sites. We compared isotopic estimates of annual and 4-yr mean E/I ratios with those from energy-balance-based numerical models of lake evaporation and catchment evapotranspiration. The 4-yr mean values from the isotopic approach (14.4 ± 0.1%) and the modeling approach (14.1 ± 1.2%) closely matched. Although inter-annual variations of the ratio were not negligible, they were smaller in the isotopic estimates, reflecting longer-term average conditions mediated by catchment storage. Sensitivity analyses revealed that the most critical factor for accurate estimation is the partial isotopic adjustment between lake evaporation and atmospheric water vapor. Using daily isotope data from a dynamic isoscape model further reduces errors in E/I ratio estimates. Finally, applying the isotopic approach with a sampling strategy optimized for the study lake allows E/I ratios to be estimated with errors of less than a few percentage points, providing insights into the spatial and temporal variability of lake water balance.}
}
@article{PENG2026135317,
title = {Vegetation restoration enhances baseflow stability during hydrological droughts on the Loess Plateau, China},
journal = {Journal of Hydrology},
volume = {672},
pages = {135317},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135317},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004142},
author = {Ya Peng and Jiefeng Wu and Huaxia Yao and Yuliang Zhou and Jieru Yan and Guoqing Wang and Xuemei Li},
keywords = {Baseflow, Hydrological drought, Elasticity coefficient, Vegetation restoration, Loess Plateau},
abstract = {Baseflow is the main contributor to river discharge during droughts and is essential for maintaining watershed water security. The Loess Plateau (LP), located in northern China, is an ecologically fragile region that has undergone large-scale land surface changes since the implementation of the “Grain for Green” Program (GGP) in 1999. The effects of vegetation restoration under the program on baseflow stability, especially under hydrological drought or low-flow conditions, are still insufficiently understood. In this study, six representative catchments on the LP, including the Kuye, Qiushui, Dali, Xinshui, Yan, and Malian Rivers, were selected for analysis. Daily streamflow records (1950 s-2021) and annual land use data (1990–2022) were analyzed. Eight baseflow separation methods were evaluated and compared. Trend analysis, elasticity coefficient estimation and coefficient of variation were used to assess the stability of hydrological variables: to examine how land use changes influence baseflow stability during hydrological droughts and to quantify the regulating role of vegetation restoration. The main findings were as follows: (1) The PART separation method performed best in the study region, with both NSE and KGE values exceeding 0.90. (2) During the study period, streamflow in the typical catchments showed a significant downward trend (p < 0.05), while the baseflow index (BFI) increased significantly (p < 0.05), whereas baseflow showed no significant trend in most catchments. (3) Compared with non-drought periods, the mean streamflow and baseflow during drought periods decreased by 36.85%-92.21% and 17.44%-88.94%, respectively, while the mean BFI increased by 4.97%-90.58%. (4) Since 2000, the interannual variability of streamflow, baseflow, and BFI has decreased, indicating greater hydrological stability. Forests and grasslands exerted stronger regulation on baseflow stability than other land use types, particularly during hydrological droughts. These findings provide a scientific basis for optimizing water resource management and evaluating the ecological benefits of vegetation restoration on the LP, providing methodological insights for ecohydrological studies in semi-arid regions influenced by land surface changes.}
}
@article{LI2026135341,
title = {Functional differentiation of DOM is coupled with nitrogen cycling in large reservoirs along an altitudinal gradient: Antagonism between condensed aromatics and carbohydrates is associated with retention and removal},
journal = {Journal of Hydrology},
volume = {672},
pages = {135341},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135341},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004385},
author = {Chen Li and Wei Wu and Hang Chen and Lei Ren and Sheng Xu and Zeyu Xiao and Na Zhang and Yuxuan Shi},
keywords = {Elevation gradient, Reservoir biogeochemistry, DOM-mediated nitrogen cycling, Isotope tracing, FT-ICR MS},
abstract = {Understanding how the chemodiversity of dissolved organic matter (DOM) regulates nitrogen biogeochemical cycling in plateau reservoirs is critical for developing adaptive nitrogen management strategies under dual natural and anthropogenic stresses. This study investigates the potential DOM molecular mechanisms mediating nitrogen cycling across large reservoirs situated at high-(2400–2800 m), mid-(2000–2400 m), and low-elevation (1600–2000 m) zones in the upper Yellow River, northeastern Tibetan Plateau. By integrating spectroscopy, FT-ICR MS, and dual-isotope tracing, we observed a sharp elevational shift in nitrogen sources, transitioning from soil-dominated inputs (45.4%) at high elevations to manure and sewage dominance (44.4%) at low elevations. While nitrification remained the primary turnover pathway, its controlling factors shifted from evaporation-driven natural processes at high elevations to agricultural and anthropogenic inputs at lower altitudes. Specifically, we demonstrate that the antagonistic interplay between condensed aromatics and carbohydrates potentially influences the balance between nitrogen retention and removal. As DOM composition shifts from allochthonous/recalcitrant to autochthonous/labile with decreasing altitude, three distinct functional regimes emerge: (1) a high-elevation “Nitrogen Locking Effect,” where soil-derived condensed aromatics inhibit denitrification, causing nitrate accumulation; (2) a mid-elevation zone maintaining a “Dynamic Balance” between nitrogen accumulation and loss; and (3) a low-elevation “Nitrogen Pumping Effect,” where sewage-derived carbohydrates fuel assimilation and denitrification to drive rapid nitrogen depletion. These findings highlight the role of DOM molecular components in regulating nitrogen cycles and provide a mechanistic framework for deciphering nitrogen fate in fragile plateau ecosystems.}
}
@article{HE2026135430,
title = {Explaining urban flood susceptibility under rainfall uncertainty through probabilistic modeling and interpretable machine learning},
journal = {Journal of Hydrology},
volume = {672},
pages = {135430},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135430},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005275},
author = {Sijing He and Jeffrey Neal and Chengguang Lai and Zhaoli Wang},
keywords = {Flood susceptibility, Urban form, Stochastic rainfall, XGBoost, SHAP},
abstract = {Understanding the drivers of urban flood susceptibility is critical for enhancing flood resilience under future climate uncertainty. This study proposes a comprehensive framework integrating probabilistic hydrodynamic simulations with interpretable machine learning to systematically analyze urban and environmental factors influencing flood susceptibility at the grid scale. Results reveal clear depth- and scale-dependent patterns: average conditional inundation probability decreases at higher water depth thresholds, while the spatial pattern of high-risk areas remains consistent across different thresholds. Seventeen predictors of urban flood susceptibility were identified, with terrain features such as elevation minimum (REmin) and digital elevation model height (DEM), demonstrating the strongest predictive contributions, alongside notable contributions from drainage capacity and urban form factors. The influence of urban form was found to be nonlinear and threshold-dependent, where higher openness was associated with lower predicted probabilities, although this association varied across different spatial locations. These findings highlight the necessity of multi-scale, probabilistic, and interpretable approaches for effective urban flood susceptibility assessment and mitigation planning.}
}
@article{JIANG2026135252,
title = {Comprehensive Assessment of Adaptive Water Resources Management in the North China Plain: Integrating Socio-Hydrological Models with Climate and Policy Scenarios},
journal = {Journal of Hydrology},
volume = {672},
pages = {135252},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135252},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003495},
author = {Tao Jiang and Mehriban Karimzada and Mengru Chen},
keywords = {Socio-hydrological modeling, Groundwater management, Climate adaptation, Behavioral decision model, Irrigation efficiency, Sustainable agriculture},
abstract = {Adaptive water management in China’s North China Plain is hamstrung by chronic groundwater overdraft and increasingly volatile monsoon rainfall. Most assessments, however, still treat farmer behavior and hydrologic dynamics in isolation. This study develops a new socio-hydrological framework that couples a variable-infiltration capacity model with MODFLOW-NWT (VIC–MODFLOW) and a micro-founded discrete-choice behavioral module. The behavioral component is calibrated on a 1,204-household survey across 36 irrigation districts using random-utility estimation and prospect-theory loss aversion parameters. Reservoirs are co-optimized with a multi-objective rule curve that balances supply reliability and ecological flows. Downscaled CMIP6 projections (SSP2–4.5 and SSP5–8.5, 2025–2045) drive the coupled system to evaluate irrigation, crop choice, and pumping responses under water-pricing, efficiency, and quota policies. The integrated model reproduces observed dynamics credibly: monthly streamflow NSE = 0.72, groundwater head RMSE = 1.31 m, and out-of-sample hit rate for irrigation decisions = 78%. Five headline findings emerge. First, absent new policy, mean annual groundwater storage declines by 10.6 ± 2.4 km3 by the 2040 s, with dry-year losses concentrated in Hebei piedmont cones. Second, warmer summers (+0.9 to +1.6 °C) increase crop evapotranspiration by 3–6%, raising peak-season pumping by 11% despite a − 3% change in mean precipitation. Third, a 20% on-farm efficiency upgrade combined with tiered volumetric pricing reduces agricultural withdrawals by 17% (95% CI: 13–21%) while maintaining net farm income through input savings. Fourth, endogenous crop switching shifts 12% of wheat area toward maize and peanuts, cutting blue-water demand by 8% and stabilizing yields in heat-stress years. Fifth, adaptive reservoir rules recover 0.7 km3 yr⁻1 of environmental flows to downstream rivers without compromising municipal reliability. These results demonstrate that pairing targeted efficiency incentives with progressive volumetric pricing and adaptive reservoir operation can curb groundwater depletion while safeguarding farmer livelihoods and ecological flows.}
}
@article{JIN2026135325,
title = {Spatiotemporal evolution and hyetograph changes of global extreme precipitation},
journal = {Journal of Hydrology},
volume = {672},
pages = {135325},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135325},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004221},
author = {Haoyu Jin and Ke Zhang and Moyang Liu and Xuan Yu and Xu Yang and Lijun Chao and Pengfei Zhang and Guoyan Liu},
keywords = {Extreme precipitation, Precipitation hyetograph, Spatiotemporal evolution, Globe},
abstract = {Under the influence of climate change and human activities, extreme precipitation has not only exhibited significant changes in frequency and intensity, but also in its hyetograph characteristics. However, studies focusing on the evolution of extreme precipitation hyetograph remain limited. In this study, we systematically analyze the global spatiotemporal evolution of annual maximum 3-hour precipitation events using the high-resolution MSWEP (Multi-Source Weighted-Ensemble Precipitation) precipitation dataset, with a particular emphasis on changes in precipitation hyetograph. We find that while the intensity of annual maximum 3-hour precipitation is declining in most regions globally (57.81%, with 14.76% being significant), precipitation occurring within a 9-hour window before and after these peak events is increasing across much of the globe (56.15% and 56.60%, with 6.18% and 5.50% being significant, respectively). This results in an overall increase in total precipitation per event (52.23%, with 6.68% being significant). Concurrently, precipitation concentration is decreasing in many regions, indicating a more evenly distributed precipitation process over time. The average similarity index for precipitation type classification exceeds 0.9, demonstrating a high level of similarity in our hyetograph classification. Precipitation Types 3 and 5 are the most frequently observed hyetographs globally. In recent years, the proportion of Type 3 events, characterized by more intense and temporally concentrated, has declined, while the occurrence of Types 4 and 5, which are more approximately uniform precipitation distribution, has increased. Despite the decline in Type 3 events, the increase in Types 4 and 5, in conjunction with rising total event precipitation (63.22% and 71.75%, with 6.28% and 8.65% being significant, respectively), is likely to exacerbate the risk of severe flooding. This study enhances our understanding of changing extreme precipitation hyetographs and provides valuable insights for improving flood risk management and disaster preparedness under different precipitation regimes.}
}
@article{HATVANI2026135401,
title = {Online screening tool for precipitation stable isotopes records: hybrid distance / density based outlier filtering approach via interactive web application},
journal = {Journal of Hydrology},
volume = {672},
pages = {135401},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135401},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004981},
author = {István Gábor Hatvani and Dániel Erdélyi and Polona Vreča and Sonja Lojen and Klara Žagar and Jan Gačnik and Zoltán Kern},
keywords = {Precipitation stable isotopes, H, O, d-excess, Outlier detection, Slovenia},
abstract = {The ratio between the heavy and light stable isotopes in precipitation is an effective tool for addressing questions in e.g., hydrology, climatology, biogeochemistry etc., but only if spatiotemporally sufficient data is available from precipitation monitoring networks. However, when data from multiple sources are gathered into large databases these can contain errors severely impacting research outcomes. The most common practices for stable isotopic database filtering apply static thresholds, not accounting for the spatially dynamically changing nature of the variable. We propose a distance-based outlier detection approach in the form of an online tool. The IsoQC App is developed to identify likely-outliers or inconsistent data points by deriving adjustable elevation-corrected average isotope values for nearby stations within an adjustable search radius (0 < R ≤ 500 km). The IsoQC is showcased on the records of the precipitation stable isotope network of Slovenia and its vicinity. It enables an objective and reproducible analysis of spatial and temporal patterns of nearby precipitation stable isotopic records by employing thresholds for dissimilarity between regional averages and individual station records in a dynamic graphical user interface. The interactive nature of the application allows users to explore spatial and temporal variations in precipitation isotope compositions, identify anomalous data points, and empirically assess regional isotope patterns in real time. The developed IsoQC tool is freely available at https://sapps.geochem.hu/isoqc/}
}
@article{DAI2026135349,
title = {Long-term evolution of earthquake-triggered cascading landslides: insights from 15 years after the 2008 Wenchuan earthquake},
journal = {Journal of Hydrology},
volume = {672},
pages = {135349},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135349},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004464},
author = {Cong Dai and Shuai Zhang and Limin Zhang and Jiale Song and Weilong Ren},
keywords = {Mass movement, Landslide, Debris flow, Riverbed elevation, Wenchuan earthquake},
abstract = {Strong earthquakes in mountainous regions can trigger widespread landslides, leading to cascading hazards during rainstorms. Failure to anticipate their long-term impact can result in unexpected losses. Previous studies mainly focused on single events and paid limited attention to the system-scale long-term evolution of mass movements, including hillslope deposits, channel deposits, runout materials of debris flows, and associated riverbed-elevation changes. The 2008 Wenchuan earthquake offered a chance to analysis the complex life cycle of cascading landslides. Our 15-year comprehensive field investigations and remote-sensing analyses revealed a rapid decay in landslide activities and dynamic response in riverbed elevation, with incision beginning approximately six years after the earthquake. We observed an equilibrium within the catchments, with mass movement rates decreasing from 24.5% in 2010 to 4.7% in 2021. Approximately 82% of erodible materials remain in the hillslope and channels. Compared with other well-studied major earthquakes worldwide, the long-term impact of the Wenchuan earthquake is expected to persist, influenced by site-specific geological conditions. Studying long-term mass movement improves understanding of hazard prediction and mitigation to minimize the associated risks.}
}
@article{ZHANG2026135333,
title = {Dynamic conversion coefficients improve alpine lake daily evaporation estimation based on multi-evaporator observations},
journal = {Journal of Hydrology},
volume = {672},
pages = {135333},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135333},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004300},
author = {Fang Zhang and Xiang Li and Xueqin Zhang and Du Zheng},
keywords = {Evaporation conversion coefficient, Lake-air temperature difference, Multiple evaporators, Lake surface evaporation, Random forest regression model, Yamzhog Yumco},
abstract = {Estimating lake surface evaporation (LSE), a major component of lake water and energy balances, is essential for science-informed water resources management of alpine lakes on the Tibetan Plateau with global warming. However, sparse hydrometeorological observations and uncertainties in local model parameterization hinder reliable LSE estimation, particularly during ice-covered periods. Based on multiple-evaporator observations (i.e., 20 cm pan evaporation: E-20cm; E601 pan evaporation: E-E601; and 20 m2 tank evaporation: E-20m2, regarding actual LSE), we estimate daily LSE using a refined pan conversion method with dynamic conversion coefficients from 2009 to 2023 in Yamzhog Yumco, South Tibet. Meteorological controls on daily LSE variability are further quantified using a random forest regression model. Results show that LSE can be well estimated by multiplying daily E-E601 (E-20cm) with dynamic E-20m2/E-E601 (E-20m2/E-20cm) ratios during ice-free (ice-covered) periods. Daily LSE changes are primarily sensitive to thermal conditions (represented by ΔT), atmospheric evaporative demand (VPD), and radiative forcings (mainly Rn and srad). Decreases in radiative forcings (Rn and srad) mainly dominate the decline in LSE at the interannual scale. In contrast, at the seasonal scale, seasonal variability in LSE is governed by distinct physical regimes, transitioning from thermal limitation in winter to atmospheric-evaporative-demand control in spring, moisture-turbulence regulation in summer, and radiative decay in autumn. Overall, this study establishes a dynamic conversion-coefficient framework for estimating evaporation from alpine lakes, including ice-covered periods, and demonstrates the dominant roles of thermal conditions, atmospheric evaporative demand, and radiative forcings in regulating lake surface evaporation, thereby informing lake evaporation model parameterization and deepening understandings of lake-air interactions in alpine regions.}
}
@article{WANG2026135418,
title = {A critical review on internal phosphorus loading influx of lakes: Quantitative methods and research prospects},
journal = {Journal of Hydrology},
volume = {672},
pages = {135418},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135418},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005159},
author = {Jingfu Wang and Yuting Zhang and Mengdie Li and Quan Chen and Yiming Ma and Jingan Chen},
keywords = {Internal phosphorus loading influx, Sediment-water interface, Phosphate oxygen isotope, Gross and net fluxes, Spatial and temporal scales},
abstract = {Internal phosphorus (P) loading significantly affects the primary productivity and trophic status of lakes. The release of P from sediments is a complex physical, chemical, and biological process in lakes, making it difficult to quantify the internal P influx. In this study, six quantitative methods were reviewed to calculate internal P loading in lakes. The principles, operational procedures, advantages, disadvantages, and applicability of these six methods were systematically analyzed. This study addressed three key points for understanding the ecological effects of the internal P loading in lakes, including the differences between the gross flux and net flux, the importance of temporal and spatial scales, and the differences between areas in shallow lakes and deep stratified lakes. Furthermore, the global datasets showed that the internal P influx in lakes is significantly higher in summer than in winter. For a specific lake, different estimation methods can cause remarkable differences in the estimation of internal P influx. Finally, we proposed the following prospects, including: (1) correct evaluation of the contributions of internal P loading in lakes (gross flux rather than net flux should be emphasized); (2) consideration of the temporal and spatial scales according to the research objectives; and (3) accurate assessment of the impact of internal P loading on algal blooms over short-term scales (e.g., daily variations).}
}
@article{MA2026135305,
title = {A dual-channel and multi-scale temporal fusion model based on variational mode decomposition for dissolved oxygen prediction},
journal = {Journal of Hydrology},
volume = {672},
pages = {135305},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135305},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004026},
author = {Rong Ma and Yulong Bai and Xiaoxin Yue and Xianbao Tan and Wenjie Bao and Xufeng Wang},
keywords = {Dissolved oxygen prediction, Variational mode decomposition, Temporal convolutional network, Squeeze-and-excitation channel attention},
abstract = {Dissolved oxygen (DO) is a critical indicator of aquatic ecosystem health, yet accurate forecasting remains challenging in estuarine and lacustrine environments due to strong nonstationarity, high noise, multi-scale dynamics, and site-dependent drivers. To address these challenges, this study proposes a dissolved oxygen prediction framework that integrates variational mode decomposition, dual-channel temporal modeling, and multi-scale temporal feature fusion, called VGT-MSN. The framework first applies variational mode decomposition (VMD) to construct a dual-channel representation capturing low-frequency trends and high-frequency fluctuations, and employs a GRU–TCN gated coupling mechanism to perform differentiated temporal modeling and feature fusion. Subsequently, a Temporal-Scale multi-scale coupler, composed of multi-dilation temporal convolutions and squeeze-and-excitation attention, is applied to aggregate temporal dependencies across different time scales and recalibrate feature representations, producing the final dissolved oxygen prediction. Experiments were conducted using high-frequency DO monitoring records from four stations within the National Estuarine Research Reserve System (NERRS) of the United States, where historical observations were used to predict future DO concentrations. Results show that the proposed model consistently outperforms representative baseline models across all datasets, with MAE reductions of approximately 43% and 39% at the Railroad and Otter Point Creek sites, respectively, both located in Chesapeake Bay, USA. These findings demonstrate that VGT-MSN provides accurate and robust DO forecasting across heterogeneous sites and driving conditions, supporting high-frequency water-quality monitoring and early-warning applications.}
}
@article{HAN2026135357,
title = {Physics-informed deep learning for hillslope subsurface flow prediction: integrating soil moisture deficit constraints},
journal = {Journal of Hydrology},
volume = {672},
pages = {135357},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135357},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004543},
author = {Xiaole Han and Man Gao and Jintao Liu and Hai Yang and Haoming Lin and Xuhui Shen},
keywords = {Physics-Informed Deep Learning (PIDL), Subsurface flow, Antecedent soil moisture, Headwater hillslopes},
abstract = {Accurate simulation of hillslope subsurface stormflow (SSF) is critical for understanding runoff generation in headwater catchments, regulating flood responses, and constraining biogeochemical fluxes. However, SSF dynamics are inherently intermittent and strongly threshold-controlled, emerging only when antecedent soil moisture and rainfall jointly exceed critical storage conditions. While deep learning can handle these complex processes, purely data-driven models often lack physical consistency, resulting in inaccurate predictions, especially in data-scarce or changing environments. In this study, we develop a physics-informed deep learning framework to better represent moisture-controlled activation processes in hillslope rainfall–runoff dynamics. Using a unique, high-frequency decadal dataset (2015–2025) from the Hemuqiao hydrological experimental station, we systematically evaluate multiple deep learning architectures and identify the Long Short-Term Memory (LSTM) network as the most reliable backbone for representing intermittent SSF, outperforming both Transformer-based and convolutional models. We also found that the antecedent soil moisture index (ASI) is the key variable controlling flow initiation. We therefore embed ASI-based physical constraints through two complementary strategies: a hard constraint, implemented as a mechanistic input transformation that gates rainfall based on soil moisture deficits, and a soft constraint, introduced through physics-informed loss regularization. The results reveal a pronounced state dependence in their effectiveness. Hard constraints are particularly beneficial under dry conditions, where strict deficit thresholds suppress false-positive flow predictions; whereas soft constraints perform better in wet states by preserving the model’s flexibility to capture nonlinear high-flow responses. Event-based analyses further demonstrate that compared to large rainfall events, the minor rainfall events play a foundational role in PIDL modeling due to their importance in identifying the threshold of subsurface stormflow generation. Together, these findings highlight that embedding physical constraints into deep learning models substantially improves both predictive skill and hydrological consistency.}
}
@article{CHOUDHARY2026135363,
title = {Associated influence of moisture sources and catchment drivers on the flood mechanism of a tropical basin},
journal = {Journal of Hydrology},
volume = {672},
pages = {135363},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135363},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004609},
author = {Rajat Choudhary and C.T. Dhanya},
keywords = {Moisture transport, Soil moisture, Flood dynamics, Indian summer monsoon, Trajectories, HYSPLIT model},
abstract = {Moisture transport is a critical component of the hydrological cycle, influencing source-sink relationships and enables understanding the dynamics of transport mechanisms over time. Despite extensive research on moisture budgets, there remains a notable gap regarding the effects of atmospheric transport mechanisms and their interactions with basin hydrology, particularly during heavy precipitation extremes. This study addresses this gap by analyzing the moisture transport dynamics associated with 35 flood events in a tropical basin during the Indian summer monsoon months. Our findings reveal the shifting of oceanic and continental moisture sources throughout the monsoon season. Notably, oceanic sources like the Indian Ocean and Arabian Sea, as well as continental sources (major river basins), dominate during the June-August (JJA) period. However, during the late monsoon months, contributions from the Bay of Bengal, Bangladesh, and Southeast Asia begin to increase, illustrating an interplay between oceanic and continental sources dictated by atmospheric conditions. Continental moisture sources emerge as particularly influential during the final months of the monsoon, with contributions nearing 45%. Thus, it is possible that any substantial anthropogenic alterations may disrupt the activities of moisture sources and sinks, leading to potential changes in moisture transport, particularly in the later months. Additionally, we explored the changing moisture pathways and their varying contributions by examining low-pressure systems connected with flood occurrences, as well as the dynamics of potential vorticity modification during cross-equatorial flow during these flood events. Overall, this study emphasizes the influence of moisture dynamics in determining the spatial and temporal distribution of rainfall events across a catchment, which in turn further decides the flood event mechanism in the basin.}
}
@article{WANG2026135364,
title = {Deep learning for decoding climate–urbanization synergies: flood susceptibility forecasting under SSP-RCP scenarios in Beijing, China},
journal = {Journal of Hydrology},
volume = {672},
pages = {135364},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135364},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004610},
author = {Tianlian Wang and Zhiyuan Fu and Manya Luo},
keywords = {Urban pluvial flooding, Flood susceptibility, Hybrid deep learning, Climate change, Urbanization, Explainable artificial intelligence},
abstract = {Climate change and urbanization amplify urban pluvial flooding susceptibility, threatening sustainable development. Traditional methods for assessing flood susceptibility, such as numerical simulations and single machine learning models, exhibit limitations when confronted with spatial heterogeneity, dynamic environmental factors, and high-dimensional data. These constraints hinder the advancement of flood prediction accuracy. We propose an interpretable hybrid deep learning framework to map and project urban flood susceptibility under climate-urbanization synergies, using megacity Beijing as a testbed. Spatial heterogeneity is addressed through Optimal Parameter Geodetector and Boruta algorithms to identify key drivers. Our Hybrid SNN-KAN-Attention model integrates: (1) an Spiking Neural Networks (SNN)-based spike encoder to enhance the nonlinear representation of static conditioning factors, (2) Knowledge Adaptive Networks (KAN) to decode nonlinear driver relationships, and (3) Attention mechanisms capturing spatial heterogeneity. The SHAP interpretation model, alongside Partial Dependence Plots (PDP), is integrated to examine the nonlinear driving mechanisms of the key factors and simulate the spatial and temporal evolution of flood susceptibility for the period 2020–2100 based on the coupled SSP-RCP scenarios. Results demonstrate the hybrid model’s superiority over traditional methods, achieving 0.88 accuracy (10%–20% improvement), 0.93 AUC, with ablation studies confirming the criticality of attention and KAN modules. The primary drivers of flood susceptibility identified include distance to roads, soil type, and road network density. Projections reveal Beijing’s flood susceptibility will intensify with climate-urbanization synergies, exhibiting 23%–41% high- susceptibility area expansion by 2100, particularly under SSP5-8.5. Overall, the proposed framework improves susceptibility prediction accuracy and interpretability, providing practical evidence to support climate-adaptive urban planning and, when combined with exposure/vulnerability information, subsequent flood risk management.}
}
@article{LI2026135388,
title = {Improving latent heat flux prediction via enhanced cross-variable interaction and temporal dependence learning},
journal = {Journal of Hydrology},
volume = {672},
pages = {135388},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135388},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004853},
author = {Qingliang Li and Qiyun Xiao and Qiyu Li and Zhongwang Wei and Yongjiu Dai},
keywords = {Latent heat flux},
abstract = {Land surface latent heat flux (LE) is a key component of the global water cycle and the surface energy balance. Predicting LE is difficult because it depends on complex, time-varying coupling between land surface states and meteorological drivers. Although deep learning has shown strong performance, many models treat these drivers as separate input channels and rely on implicit feature mixing, which can weaken their ability to represent dynamic cross-variable interactions and physically meaningful feedback. To address this limitation, we propose a variable-centric graph framework that treats land surface and meteorological factors as graph nodes and learns their interactions directly at the variable level. The framework combines an adaptive graph convolutional network with recurrent networks to capture both cross-variable interactions and temporal dependence. Across 146 FLUXNET sites, the proposed models outperformed the baselines, increasing R2 by 3.11% to 7.33% and KGE by 5.44% to 9.15%. The strongest gains appeared in the open shrubland IGBP class, where R2 rose from 0.382 with the baseline to 0.613 with the GCN based model, and KGE improved by as much as 13.09%. Interpretability results suggest that the model learns physically meaningful behavior, including soil moisture controls and energy feedback. It also generalizes better across ecosystems than purely temporal baselines, indicating that learning variable level interaction structure improves extrapolation to unseen vegetation types and strengthens LE prediction under diverse land surface conditions. Overall, the results indicate that learning cross variable interactions offers a practical route to more physics informed, data driven flux estimation.}
}
@article{YOUSEFI2026135247,
title = {Evaluation of adaptation to water scarcity in Farmers’ communities using a co-evolutionary network of agents},
journal = {Journal of Hydrology},
volume = {672},
pages = {135247},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135247},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003446},
author = {Hamoon Yousefi and Azadeh Ahmadi},
keywords = {Detecting Communities, Environmental Behavior, Social Network Analysis, Agent-Based Model, Groundwater Management},
abstract = {In this study, a novel socio-hydrology framework is developed to evaluate local communities’ adaptability to water scarcity. The framework proposes an approach to systematically conceptualize farmers’ decisions on cultivation patterns by identifying their dynamic elements through human–human, human-community, and human-water interactions. This framework utilizes the coupling of an agent-based model (ABM) to simulate the individual behavior of stakeholders, social network analysis (SAN) to detect the structure of the communities, and MODFLOW to simulate groundwater conditions. Previous socio-hydrology studies often overlooked the simultaneous dynamics of collective behavior of stakeholders and individual decision-making in response to hydrological variation. The novel aspect of the proposed approach in this study is the establishment of a two-way bridge between micro-level stakeholder decision-making and macro-level water resources management. This enables the simultaneous analysis of dynamics at both levels and their mutual temporal and structural feedback. The proposed methodology is applied to the case study in Isfahan-Borkhar, central Iran. The results indicate that the economic profit of stakeholders decreased by 82%, while groundwater levels declined by 0.7 m per year between 2010 and 2019. Therefore, the adaptation to water scarcity needs to be enhanced. Five scenarios are developed to investigate the possible solutions. Increasing awareness among stakeholders, increasing the price of low-water-consuming crops, and enhancing productivity can all lead to greater adaptability. However, harnessing the potential of communities alongside other approaches yields the highest adaptability to water scarcity, resulting in an average aquifer restoration of 1.8 m and a 30% increase in economic growth. Furthermore, given the flexibility of the proposed framework, the analysis of the co-evolutionary network of agents can be utilized to enhance the adaptability of operational policies in other aquifers facing water scarcity challenges.}
}
@article{HE2026135396,
title = {Enhancing runoff simulation in data-scarce mountainous regions: a coupled SWAT and transferable transformer approach},
journal = {Journal of Hydrology},
volume = {672},
pages = {135396},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135396},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004932},
author = {Yi He and Rui Yan and Yanhong Tang and Jinyu Zhang and Hui Qian and Dejing Chen and Lei Zhu and Xin Cao},
keywords = {Runoff prediction, SWAT, Transfer learning, Trend-seasonal decomposition, Mountainous basin},
abstract = {ABSTRACT
Runoff prediction in mountainous watersheds remains challenging due to complex nonlinear hydro-meteorological interactions, strong spatial heterogeneity, and limited long-term observations. Physically based models such as SWAT provide valuable process representations but are often affected by parameter uncertainty, whereas conventional deep learning models struggle to concurrently capture fast storm responses and slow hydrological dynamics. To overcome these limitations, this study develops the SWAT-HydroTransformer, a physics–data hybrid framework that integrates SWAT-simulated hydrological processes as physical constraints into a multi-scale Transformer architecture. The model incorporates a trend–seasonal decomposition mechanism and the enhanced AutoCorrelation attention module to explicitly separate low-frequency catchment storage signals from high-frequency meteorological fluctuations. The framework was applied to the Shiquan River Basin, China. Compared with standalone SWAT, Long Short Term Memory (LSTM), Random Forest (RF), Extreme Gradient Boosting (XGBoost), and the basic Transformer, the HydroTransformer achieved substantially higher predictive skill, yielding Nash–Sutcliffe Efficiency (NSE) values of 0.843 under baseline conditions and 0.786 under non-stationary climatic conditions. Model interpretability analyses using SHapley Additive exPlanations (SHAP) and spectral decomposition further demonstrated strong physical consistency: seasonal components corresponded to precipitation-driven variability, while trend components captured baseflow and storage dynamics. To evaluate regional transferability, a fine-tuning strategy was implemented across three data-limited basins. After transfer learning, NSE values improved to 0.729, 0.826, and 0.634, compared with the corresponding results obtained from direct cross-basin transfer, indicating robust cross-basin adaptability. Overall, the SWAT-HydroTransformer provides an efficient, interpretable, and transferable solution for runoff forecasting in complex mountainous environments.}
}
@article{MASTELLA2026135344,
title = {Towards the use of acoustic monitoring in karst networks to infer hydrological dynamics during flood events},
journal = {Journal of Hydrology},
volume = {672},
pages = {135344},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135344},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004415},
author = {Alessandro Mastella and Francesco Sauro and Michel André and Mike {van der Schaar} and Maria Filippini and Guido Rossi and Guido Gonzato and Ennio Nicolini and Jo De Waele},
keywords = {Acoustic monitoring, Hydrogeology, Carbonate aquifer, Flood events, Cave air},
abstract = {Monitoring flood events in caves is a significant challenge due to the high energy and destructive nature of floods, which pose risks to submerged sensors and data transmission systems. This has resulted in a scarcity of studies focusing on flood propagation and its effects on air–water interactions. Notably, previous research has largely overlooked the integration of acoustic monitoring with traditional hydrological parameters. This study addresses this knowledge gap by testing a multiparametric hydrological and acoustical monitoring within Spurga delle Cadene (Lessini Mountains of Verona, Italy). This cave acts as temporary overflow karst spring with high water discharge during flood events. Infra-to-audible sound acoustic alongside water level and air pressure monitoring was employed to investigate the hydraulic functioning of the cave-spring system. Integrating these different methodologies revealed that the compression, isolation, and subsequent release of trapped air volumes in various cave compartments fundamentally influence water-level rise, pressure evolution, and flood propagation, through a newly identified process called the “Plunger Chamber Effect”. Additionally, a detailed analysis of low frequencies (<50 Hz) revealed specific repetitive acoustic patterns that consistently preceded the flood rise and accompanied its recession. These sounds are related to the release of air pockets associated with conduit morphologies and water levels. Identifying these repetitive sound patterns paves the way for the deployment of cave-specific early warning flood alert systems. This case study not only underscores the importance of integrating acoustic monitoring with classical hydrological methods providing a more comprehensive understanding of flood mechanisms in subterranean environments.}
}
@article{LIU2026135368,
title = {Enhancing precipitation merging accuracy in China with machine learning and rain-snow classification},
journal = {Journal of Hydrology},
volume = {672},
pages = {135368},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135368},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004658},
author = {Qi Liu and Yun Wang and Yue Xu and Lingling Wang and Guoqiang Tang and Meihong Ma},
keywords = {Precipitation, Snowfall, Machine learning, Multi-source merging, Influencing factors},
abstract = {Rising global temperatures have increased the complexity of precipitation patterns and phase transitions, posing significant challenges for accurate satellite precipitation estimation. Although machine learning has demonstrated strong capability in modeling complex precipitation processes, the influence of precipitation phase has been largely overlooked in precipitation merging studies. This study explicitly integrates precipitation phase information into satellite precipitation merging over China using Random Forest (RF) and Artificial Neural Networks (ANN), with Geographically Weighted Regression (GWR) serving as a benchmark. Three training strategies are evaluated, including phase independent training, phase aware combined training, and phase specific independent training, to evaluate the effectiveness of phase informed machine learning. The results indicate that: (1) machine learning markedly improves the accuracy of snowfall data merging, with RF consistently outperforming ANN, whereas ANN exhibits a systematic tendency to overestimate precipitation across all phases. (2) Both Merge_p1 and Merge_p2 further enhance merging performance, with Merge_p2 being particularly effective in alleviating ANN-related overestimation, reducing the snowfall RMSE from 2.30 to 1.93 mm day–1. (3) Precipitation merging accuracy declines as station density decreases, with model sensitivity following the order ANN > GWR > RF, with higher sensitivity observed for rainfall than snowfall. These findings contribute to improving precipitation estimation by incorporating phase differentiation and provide a robust methodological foundation for identifying extreme climate events.}
}
@article{MARTINI2026135355,
title = {From near surface to root zone soil water losses: a new model validated with field TDR and remotely sensed data},
journal = {Journal of Hydrology},
volume = {672},
pages = {135355},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135355},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600452X},
author = {Tommaso Martini and Aurora Olivero and Alessio Gentile and Davide Gisolo and Stefano Ferraris},
keywords = {Soil moisture drydowns, Root zone moisture, Remote sensing, Multilayer soil model, muSEC, Surface evaporative capacitor, Ecohydrological applications},
abstract = {Understanding soil moisture drydowns, especially within the root zone, is critical for predicting water availability and crop stress. Remote sensing provides continuous observations of surface soil moisture, but its practical value for agricultural applications depends on linking surface dynamics to root zone layers. With this aim, we developed the muSEC model, based on the recently proposed surface evaporative capacitor (SEC). We compared it with three models of increasing complexity: the Laio bucket scheme, a desorptivity-based model, and a Richards solver. The analysis combined multiyear in-situ TDR measurements (depth-averaged soil moisture at 0–15, 0–30, and 0–60 cm) from a sandy grassland with NASA SMAP retrievals from a loamy maize field, thus covering both accurate local root zone monitoring and satellite-scale surface observations, while testing the models across two contrasting soils. Across both sites, all models reproduced drydowns with good accuracy, with a root mean square error consistently lower than a benchmark of 0.06 m3m−3. Performance systematically improved with depth compared to the surface, in line with expectations for tilled agricultural soils. Calibration on 0–15 cm and validation on 0–60 cm with the in-situ data showed that, under the relatively homogeneous soil conditions considered here, parameters calibrated on surface layers can predict root zone dynamics, an important result for agricultural applications. While model complexity did not automatically translate into superior performance at a single depth, the proposed muSEC showed the best depth transferability among the simplified models, combining structural flexibility with a substantially lighter numerical framework than fully physically based approaches. These results support its potential use for integrating satellite surface soil moisture into agricultural water management, while highlighting the need for further assessment in more heterogeneous soil profiles.}
}
@article{TURKELTAUB2026135376,
title = {Rapid groundwater warming in an eastern mediterranean coastal aquifer linked to urbanization},
journal = {Journal of Hydrology},
volume = {672},
pages = {135376},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135376},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004737},
author = {T. Turkeltaub and M. Fire and A. Bernstein},
keywords = {Ground water temperature, Climate change, Urbanization impacts, Coastal aquifer, Semi-arid regions, Subsurface warming},
abstract = {The rise in groundwater temperature is a growing concern, primarily driven by urbanization and increasing global temperatures. While long-term trends of groundwater warming have been documented in temperate regions, these trends are rarely studied in semi-arid areas. This study aims to quantify three decades of groundwater temperature changes in an Eastern Mediterranean Coastal Aquifer, a critical freshwater resource affected by hydroclimatic variations and rapid urban expansion. Utilizing temperature records from over 1,000 wells and satellite-derived land surface temperatures (LST), the study reconstructs the spatial and temporal patterns of groundwater warming in both urban and rural areas. The results indicate notable changes in both absolute temperatures and spatial structure. In urban areas of the central part of the coastal aquifer, groundwater temperatures have increased significantly by 0.13 °C per year, which is much higher than regional air temperature trends and global groundwater warming rates. In contrast, the rural northern and southern regions exhibit groundwater warming rates similar to those of LST trends, ranging from approximately 0.02 to 0.07 °C per year. Correlation analyses reveal a shift from natural factors, such as vadose-zone thickness, latitude, and proximity to the sea, to human-induced factors, including declining rural land cover and changes in soil properties associated with urban development. These findings highlight that subsurface warming in semi-arid coastal aquifers is greatly intensified by urbanization, which may have significant implications for groundwater quality.}
}
@article{QIN2026135332,
title = {Damming effects on bankfull channel geometry in the Lower Yellow River: adjustment patterns and a physics-informed machine learning framework},
journal = {Journal of Hydrology},
volume = {672},
pages = {135332},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135332},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004294},
author = {Mengchun Qin and Junzheng Liu and Haijue Xu and Jinliang Zhang and Yang Bai and Yuchuan Bai and Jia Wang},
keywords = {Damming effects, Bankfull channel geometry, Adjustment patterns, Channel patterns, Physics-informed PSO-SVR model, Lower Yellow River},
abstract = {Damming typically alters natural flow-sediment dynamics, triggering significant changes in riverbed morphology. Understanding and predicting these morphological responses is critical for sustainable river management. Vertical incision over large longitudinal extents caused by dams has received widespread attention, but the role of lateral width in bed morphology adjustment in unstable dammed channel systems (e.g., braided and transitional rivers) has received comparatively less attention. Theoretically, bankfull channel geometry adjustments can be classified into eight distinct patterns based on variations in width and bed elevation. Using 22 years of bathymetric data (2000–2021) collected since the full operation of the Xiaolangdi Dam commenced, this study investigates these adjustment patterns at multiscale in the braided and transitional reaches of the Lower Yellow River. We identify key controlling factors, including flow-sediment regimes, antecedent cross-sectional geometry, bed grain size, and channel slope. A hybrid physics-informed machine learning model combining Particle Swarm Optimization (PSO) and Support Vector Regression (SVR) was proposed to predict these adjustment patterns. At the cross-sectional scale, six dominant adjustment patterns emerged: (Ⅰ) aggrading with widening, (II) aggrading with narrowing, (III) degrading with narrowing, (Ⅳ) degrading with widening, (Ⅵ) exclusive aggrading, and (VIII) exclusive degrading. At the reach scale, only three patterns were observed: I, III, and IV. Pattern IV (degrading with widening) was the most prevalent at both scales. Morphological adjustments through degrading with widening collectively increased bankfull area. In the braided reach, lateral widening contributed more than vertical degradation to bankfull area expansion in 27% of cross-sections, compared to 16% in the transitional reach. The reach-scale analysis reveals that in the braided reach, widening and incision accounted for 40% and 60% of the bankfull area increase, respectively, whereas in the transitional reach, the proportions were 22% and 78%. Channel widening induced by damming plays a non-negligible role in shaping channel morphology, particularly in braided reach. The braided reach experiences more severe lateral erosion due to its stronger stream power, weaker bank resistance, and lower river engineering confinement. The proposed PSO-SVR model demonstrated strong predictive performance, achieving approximately 80% accuracy at the cross-sectional scale and approximately 90% at the reach scale. This study offers a representative case of large alluvial river responses to dam-induced perturbations across varying channel patterns and provides a predictive framework for managing regulated fluvial systems.}
}
@article{PANAGIOTOU2026135316,
title = {Integration of clustering and principal component analyses in MCDA to identify feasible regions for managed aquifer recharge},
journal = {Journal of Hydrology},
volume = {672},
pages = {135316},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135316},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004130},
author = {Constantinos F. Panagiotou and Tiago Martins and Catalin Stefan},
keywords = {Hierarchical clustering algorithm, Uncertainty analysis, Decision-making process, MAR feasibility mapping},
abstract = {Managed aquifer recharge (MAR) provides a nature-based solution to water scarcity issues, contributing to the design of effective water management policies. The novelty of this study lies in the integration of multivariate statistical methods within the framework of multicriteria decision analysis to provide nonsubjective, semi-automatic estimations of MAR feasibility based on three thematic layers, particularly intrinsic (hydrogeological, topographical, meteorological) features, water availability and demand for MAR. The concept of MAR typology is used to define the MAR problem and select a set of criteria for each thematic layer that are relevant for the Sado River Basin (southern Portugal). The hierarchical clustering algorithm (HCA) is used to partition the study area into distinct subregions based on selected criteria. For each subregion and thematic layer, a set of weight coefficients for the criteria is generated via products of the cumulative variance of the principal scores with the corresponding eigenvector matrix, which are then used to generate multiple realizations of the thematic maps. The results reveal that the majority of the study area (60%) has mean feasibility scores less than 0.54, whereas the remaining 40% (highest values) vary within a smaller interval (0.54–0.67). The present results are consistent with the previous study, with both identifying the same high-suitability regions. Additionally, it allows exploration of the variability in criteria weights across multiple realizations, providing a preliminary indication of how this variability can influence the results. This approach can easily be implemented in software and ultimately automated, supporting the unsupervised streamlining of the decision-making process.}
}
@article{CHEN2026135340,
title = {Evaluating the influence of climate inputs on WEPP predictions for a forest road in the Florida Panhandle, USA},
journal = {Journal of Hydrology},
volume = {672},
pages = {135340},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135340},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004373},
author = {Jingqiu Chen and Shuyuan Wang and William J. Elliot and Bernard A. Engel and Feng Pan and Yaoze Liu and Johnny M. Grace},
keywords = {Forest road, WEPP, Climate input formats, Machine learning, Mediation analysis},
abstract = {Rainfall temporal resolution and climate input formats can influence runoff and soil erosion predictions on forest roads. This study evaluated their effects using the Water Erosion Prediction Project (WEPP) simulations for a forest road in Florida’s Chipola Experimental Forest. High-resolution NOAA-ASOS precipitation data (2000–2024) were used to generate breakpoint, fixed-interval (5–60 min), and time to peak/peak intensity (TPIP) climate inputs. WEPP predictions were generally stable across input types, with modest differences in average annual runoff and soil loss. Finer temporal resolutions (5–10 min) for breakpoint inputs produced slightly smaller deviations, while TPIP showed greater sensitivity to storm irregularity, particularly for high-intensity, highly peaked, or long-duration events. Machine learning analysis identified total precipitation and average intensity as the main drivers of daily runoff differences, with ratio of peak intensity to average intensity (ip), ratio of duration where peak intensity occurs to total storm duration (tp), and duration having minor influence. Across soil erodibility conditions, average treatment effects (ATEs) were near zero for small storms and increased moderately for larger events, especially under higher infiltration capacities. TPIP inputs exhibited greater variability, suggesting potential need for runoff adjustments. Mediation analysis indicated that natural indirect effects (NIEs) could be reduced by improving runoff predictions, whereas direct effects (NDEs) were mainly influenced by critical shear stress (τc). These results highlight the importance of rainfall temporal structure and climate input selection in hydrologic and erosion modeling, providing guidance for improving model predictions and informing future applications.}
}
@article{ZHANG2026135348,
title = {Quantifying impacts of lakes on baseflow dynamics in headwaters of the Yellow River, Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {672},
pages = {135348},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135348},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004452},
author = {Jiao Zhang and Runze Guo and Guotao Zhang and Ziying Zhu and Yuhua Tan and Guoqing Wang and Shixuan Lyu and Yongqiang Zhang and Yun Chen and Yi Hou and Jia Liu and Junlong Zhang},
keywords = {Lake-induced baseflow dynamics, Quasi-paired catchment, Headwater catchment, Tibetan Plateau},
abstract = {The alteration of lakes modifies the catchment landscapes, and thus the associated hydrological processes (e.g., baseflow). However, the role of lakes in the baseflow dynamics of the Tibetan Plateau is unclear under the effects of climate change. Here, the revised baseflow separation is considered for a quasi-paired catchment. A no-lake scenario is then constructed using machine learning (ML) to quantify the influence of lakes on baseflow signatures. Our results indicate that: (i) The winter baseflow duration curve is in good agreement with the summer baseflow duration curve (R2 = 0.982, %BiasV = 15.38%) within the lake catchment; (ii) Lakes show bidirectional (positive and negative) contributions to the baseflow index, and exhibit a strong reduction effect on the frequency of high baseflow days (−46.82%); (iii) Lakes amplify the influence of temperature on the frequency of both high baseflow days and low baseflow days, while attenuating the impact of soil moisture on rising limb density. These results reveal that lakes act as fundamental modulators, altering how physiographic and climatic variabilities propagate into baseflow behavior in headwater systems. This study enhances our understanding of how lakes regulate catchment baseflow dynamics, supporting the design of water management strategies under future changing conditions.}
}
@article{ZWARTENDIJK2026135259,
title = {Simulation of the effects of land cover, soil degradation, and rainfall on runoff from a small tropical catchment using a minimally calibrated distributed model},
journal = {Journal of Hydrology},
volume = {672},
pages = {135259},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135259},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003562},
author = {B.W. Zwartendijk and H. Leistert and L.A. Bruijnzeel and A.J. Teuling and M. Weiler and H.J. {van Meerveld}},
keywords = {Deep percolation, Deforestation, Physically based model, Shifting agriculture, Soil degradation, Stormflow, Madagascar},
abstract = {Catchments undergoing shifting agriculture typically have a mosaic of land covers, with active agricultural fields, fallows in different stages of regrowth, remnant forest, and degraded grasslands. Although the rainfall-runoff responses differ for each of these land covers, there is little quantitative information on how this affects the catchment-scale runoff response. The Marolaona catchment (31.7 ha) in eastern Madagascar has been subject to shifting cultivation for at least 70 years. We used the spatially-distributed physically-based RoGeR_Dyn-model to investigate the sensitivity of catchment-scale runoff to land degradation and annual rainfall for this catchment. Only the parameter related to the permeability of the subsoil was optimized within the range of measured values; all other soil parameters were based on field measurements or set to default values. The minimally calibrated model reproduced the observed hydrological responses and was used to compare the simulated water budgets and runoff responses for different land covers, namely the mixed land cover in 2015/16, a complete tree fallow cover without soil degradation (1960s baseline), and a hypothetical case with tree fallows and degraded soils. The simulated stormflow is 20–30% higher and deep percolation is ∼22% less for the current land cover than for the scenario with a uniform fallow cover without soil degradation (1960s baseline). The high water use of eucalypts dominated evapotranspiration and masked the effects of soil degradation on stormflow. Furthermore, the effects of land cover and soil degradation on stormflow and deep percolation are highly dependent on, and smaller than, the effects of the interannual variation in rainfall, making it difficult to detect these effects from streamflow data alone.}
}
@article{WANG2026135320,
title = {Interpretable hierarchical Bayesian modeling of monthly streamflow for heterogeneous basins: A comparative study of two basins},
journal = {Journal of Hydrology},
volume = {672},
pages = {135320},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135320},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004178},
author = {Hui Wang and Manoj Shrestha and Tirusew Asefa and Dingbao Wang},
keywords = {Bayesian hierarchical models, Basin storage, Streamflow forecasting, PSIS-LOO cross validation},
abstract = {Bayesian hierarchical models (BHMs) provide a structured approach to jointly simulate multiple basins with striking differences in hydrologic storage while leveraging shared information in short records. This study investigates two interpretable BHMs for simulating monthly streamflow in the Tampa Bay region in the State of Florida, USA. The first model, M0, is a multibasin baseline without explicit seasonality; the alternative model M1 augments M0 with seasonal intercept adjustments by dividing the months into summer and non-summer months. The hierarchy captures cross basin commonalities yet faithfully represents storage contrasts; M1 further reduces conditional bias in seasonal regimes with minimal loss of parsimony. Crucially, the parameters have direct hydrologic interpretations rather than constituting a black-box. The persistence coefficients, i.e., parameters associated with lagged streamflow, reflect basin retention; the parameters associated with lagged rainfall quantify delayed runoff contributions; seasonal intercepts represent seasonal level shifts. Partial pooling across the Alafia River (ALA) and the Hillsborough River at Morris Bridge (MBR) stabilizes inference while preserving distinct lag weights that reveal contrasting storage behavior. The model was fitted and evaluated using data from 1981 to 2018, via posterior predictive checks, including mean square error, correlation between observation and simulated values, and Pareto-Smoothed Importance Sampling Leave-One-Out (PSISLOO). The skill of two models is also compared for the validation period 2019–2024. The primary contribution of this study is an interpretable simulation framework that explains differences in storage driven responses across nearby basins. The approach is general and reproducible, offering a robust pathway to derive operational streamflow forecasts especially for multi-basin settings where shared climate forcing interacts with basin-specific storage and routing characteristics.}
}
@article{QIAO2026135304,
title = {The potential sources of sulfate and its effect on carbonates weathering in karst spring area, North China},
journal = {Journal of Hydrology},
volume = {672},
pages = {135304},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135304},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004014},
author = {Xiaojuan Qiao and Xinyu Chai and Yu Cheng and Dawei Wang and Wenjin Yu and Chunlei Tang},
keywords = {Sources ofsulfate, Carbonates rocks weathering, Sulfurisotope, COemissionand absorption, Karst groundwater in North China},
abstract = {The weathering mechanism of carbonates and its relationship with the regional carbon cycle can be affected by the involvement of sulfuric acid. Special geological conditions, being coal above and karst water below in North China, create multiple and potentially uncertain sources of sulfuric acid. Also, the high content of alkaline ions (Ca) in the atmosphere neutralizes the acid ions, forming an atypical acid rain area where the contribution of acid ions brought in by atmospheric precipitation into the groundwater is ignored. To analyze the effect of sulfuric acid on the carbon cycle, this paper assesses the potential sources and contribution of the end members by sulfur isotopes. The results show that the average contribution of gypsum dissolution, sulfide oxidation in coal measure strata, atmospheric precipitation, and agricultural fertilizer pollution to SO42- in karst groundwater reached 54.50%, 29.37%, 7.75%, and 8.38%, respectively. The sulfuric acid involved in carbonates solution mainly originated from sulfide oxidation in coal measure strata. Based on the spring flux, according to hydrochemical-runoff method, the net carbon sink in summer (June-July) and winter (November-December) is estimated at 0.88 t and 0.79 t, with potential carbon sources of 0.5 t and 0.69 t, respectively. Considering the submersible discharge flow, the net carbon sink can reach to 1.20 t in summer and 1.07 t in winter and sulfuric acid weathering of carbonates amounts to 0.68 t and 0.94 t. In general, sulfuric acid weathering accounted for approximately 36.23% and 46.6% of the total carbon dioxide absorption, indicating that sulfuric acid contributes significantly to carbonates rocks weathering, and weakens the karst carbon sink effect. Therefore, anthropogenic processes such as mining activities can accelerate carbonates weathering and influence the carbon cycle greatly.}
}
@article{AKBARY2026135356,
title = {Projected changes in sub-daily extreme precipitation: comparing temperature-scaling approaches and convection-permitting models across an Alpine gradient},
journal = {Journal of Hydrology},
volume = {672},
pages = {135356},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135356},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004531},
author = {Rashid Akbary and Eleonora Dallan and Marco Marani and Francesco Marra and Marco Borga},
abstract = {Quantifying future changes in sub-daily extreme precipitation in mountainous basins is essential for adapting to increasingly intense flash floods and debris flows. Often, extreme precipitation-temperature scaling rates are used to anticipate future extremes. In this study, we evaluate the reliability of temperature-scaling approaches by comparing their projections of extreme precipitation to outputs from convection-permitting models (CPMs) across a complex mountainous region in northeastern Italy. We use hourly data from an ensemble of five CPMs at a 3 km resolution, comparing historical (1996–2005) and future (2090–2099, RCP8.5) periods and using average temperatures in the 24 h prior to the precipitation event to compute the scaling rates. Our analysis employs a robust methodological framework to identify optimal scaling factors that replicate the extreme precipitation estimates produced by CPM simulations. We find that the optimal scaling rates vary with duration and return period. For moderate extremes (2- and 5-year return period), the optimal scaling rates are typically between 5.5 and 6% K−1, while more severe events scale with higher rates, up to 8.4% K−1 for 3‐hour, 100‐year events. Future shift in precipitation seasonality also plays a role. In high‐elevation areas, where extremes are prevalent in the summer in both present and future conditions, estimates based on temperature-scaling rates align closely with CPM outputs. Conversely, poorer performances are found in areas where large shifts in the seasonality of extremes are expected. Overall, careful consideration of local variability, seasonality, duration, and return period is necessary to avoid potential inaccuracies when deriving projections from temperature-scaling relationships.}
}
@article{ZHU2026135328,
title = {Dynamic scheduling of cascaded reservoirs: A full-cycle framework for integrating the economic–social–ecological nexus for sustainable management},
journal = {Journal of Hydrology},
volume = {672},
pages = {135328},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135328},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004257},
author = {Zhaoyang Zhu and Zhaocai Wang and Haotian Wu and Chenye Liu and Zuowen Tan and Tianyu Ren and Qikai Liu},
keywords = {Cascade reservoir operation, Dynamic economic–social–ecological nexus, Sustainable water management, Multi-objective optimization, Evolutionary optimization},
abstract = {The coordinated operation of cascade reservoir systems plays a crucial role in balancing energy production, water supply, and ecological protection. However, conventional scheduling methods often rely on static temporal rules and fail to account for the evolving hydrological conditions and spatial interdependencies among reservoirs, limiting their ability to meet complex economic-socio-ecological (ESE) demands. To address this challenge, we propose a full-cycle dynamic scheduling framework—Economic–Socio–Ecological Dynamic Scheduling for Full Cycle (ESEDS-FC)—which integrates hydrological seasonality with multi-objective trade-offs and considers the dynamic coupling of the ESE nexus under the boundary conditions of cascade reservoirs throughout the scheduling process. The annual scheduling cycle is divided into three periods: (1) in dry seasons, the framework prioritizes power generation, domestic water use, and ecological base flows; (2) in pre- and post-flood seasons, it balances energy efficiency, flood risk control, and carbon mitigation; and (3) during the main flood season, it emphasizes flood regulation while maintaining sediment transport and hydropower output. To capture spatiotemporal feedback within the reservoir system, this study proposes a hybrid optimization framework that integrates a Graph Convolutional Network (GCN) with a Multi-Objective Evolutionary Algorithm (MOEA), enhancing the modeling ability of the ESE nexus and improving optimization efficiency. The method has been applied to six major cascade reservoirs in the upper and middle Yangtze River Basin under multiple hydrological scenarios, demonstrating stronger adaptability and performance. Compared to traditional static strategies, the proposed approach increases annual hydropower generation by 13.60%, social benefit indicators by 8.66%, and ecological indicators by 6.87%. Furthermore, the results reveal dynamic synergies between economic and ecological objectives under varying flow conditions and provide three adaptive scheduling decision-making schemes based on the distribution of the Pareto solution set. These findings suggest that reservoir scheduling can serve as a key mechanism for identifying and regulating cross-sectoral linkages, supporting scalable strategies for integrated basin governance under long-term climatic and hydrological variability.}
}
@article{WANG2026135335,
title = {A novel adaptive soil moisture retrieval method via stacked ensemble learning and a local Bayesian dynamic algorithm},
journal = {Journal of Hydrology},
volume = {672},
pages = {135335},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135335},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004324},
author = {Fuqiang Wang and Ruiping Li and Sinan Wang and Xiaoming Ma and Jinming Yang and Jialu Dai and Xiaohui Lian and Jianwei Zhao and Liying Zhou and Yanxin Wang},
keywords = {Soil moisture, Spatial‒temporal fusion, Multilevel feature screening, Stacked ensemble learning improvement, Bayesian dynamic weighting},
abstract = {Knowledge of global water management requires the precise acquisition of soil moisture statistics at various levels. However, existing soil moisture forecasting approaches still face difficulties, and the inversion methodology must be enhanced immediately because of gravity device resolution limits and the complexity of different soil types, environments, and topographies. A local Bayesian dynamically weighted stacking ensemble learning-based soil moisture inversion model (Stacking-BO) and a high-resolution spatiotemporal multilayer soil moisture simulation framework are suggested to address this challenge. Considering the error term (i.e., the root mean square error (RMSE)), complexity and stability of the model, three stacking model-based predictive value weight-related objective functions are constructed, and the Bayesian algorithm is used to optimize the weight combination of the objective functions to obtain the optimal weight for each sample. The results show that (1) the maximum reflectance R2 of the fusion band of the OL-ESTARFM model is 0.962, and the R2 of the LST is 0.95. (2) Albedo (r1 = −0.61), ET (r2 = 0.65; r3 = 0.63), LAI (r1 = r2 = 0.48), and DEM (r3 = −0.44) were the major drivers of distinct soil thicknesses as of July 2023 and 2024 (0–10, 10–20 and 20–30 cm, respectively). (3) In July 2023, compared with the Stacking1 model, the Stacking-BO model had a 0.04 greater R2 and a 1.14% lower RMSE in July 2023, with the greatest increase achieved on the validation set being 0.07, and a 0.48% lower RMSE in July 2024. Although it is the least stable, Stacking1 contributes extensively to the surface moisture forecasting process of the Stacking-BO model. (4) The degrees of aridity in the research region decrease in the following order: D (2023-N: 5.37%) > S > T > M (2023-S: 22.59%). The fraction of soil with a moisture content less than 15% is 85%. The Stacking-BO model shows great potential for use in remote sensing soil moisture inversion.}
}
@article{PRAYAG2026135338,
title = {Assessing infiltration dynamics using integrated hydrogeophysical monitoring in a managed aquifer recharge pond},
journal = {Journal of Hydrology},
volume = {672},
pages = {135338},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135338},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600435X},
author = {Ankita Prayag and Torleif Dahlin and Kristofer Hägg and Matteo Rossi and Arnaud Watlet and Jan-Erik Rosberg and Tina Martin},
keywords = {Managed Aquifer Recharge (MAR), DCIP, GPR, Hydrogeophysics, Infiltration monitoring, Inversion, Groundwater},
abstract = {Managed Aquifer Recharge (MAR) ponds are widely used to enhance groundwater, but efficiency is limited by uncertain infiltration pathways, heterogeneous sediments, and surface clogging. Understanding infiltration responses to variable inflow and evolving subsurface conditions is essential for optimizing pond performance. This study applied an automated multielectrode Direct Current Resistivity and Induced Polarisation (DCIP) system, complemented by Ground Penetrating Radar (GPR) and hydrological monitoring, to investigate infiltration dynamics over eight months. DCIP results captured resistivity reductions from dry conditions (>2000 Ωm) to saturated zones (70–250 Ωm), coinciding with groundwater-level rises of up to 1.6 m near the eastern inlet and 1.0 m at the distal end during peak inflow (58 l s−1). GPR revealed the lower limit of the artificial filter layer at ∼1 m depth and deeper reflections corresponding to the transition from vadose to saturated zones, matching groundwater levels in nearby wells. Both methods identified a westward-dipping layer along the pond (surface to ∼2–3 m depth; 100–50 m along the profile), interpreted as a high-permeability layer guiding lateral infiltration. Decreasing GPR reflection amplitudes over time indicate increasing water content in the unsaturated zone, consistent with DCIP observations. DCIP inversions captured immediate subsurface responses to inflow, including localized groundwater mounding, progressive saturation, and drying during interruptions. Groundwater levels rose fastest at the inlet, more slowly at mid-distance, and minimally at the far end, reflecting inflow proximity and lateral hydraulic connectivity. Saturation estimations derived using Archie’s law corroborate these observations, showing moderate-to-high wetting zones, while later stages indicate signs of clogging and biofilm development. The integrated DCIP–GPR–hydrological approach effectively delineates subsurface structure heterogeneity and time-dependent infiltration, supporting adaptive inflow management under variable hydrological conditions.}
}
@article{WU2026135359,
title = {Effect of water salinity on the soil freezing-thawing characteristic curve of sandy soils},
journal = {Journal of Hydrology},
volume = {672},
pages = {135359},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135359},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004567},
author = {Yandi Wu and Anh Minh Tang and Jean-Michel Pereira and Rahima Sidi-Boulenouar and Christelle Tabbiche and Liming Hu},
keywords = {Unfrozen water content, Salt, Soil matrix, Hysteresis, Adsorption},
abstract = {Understanding the change pattern of unfrozen water content in frozen soils is essential for predicting hydro-mechanical processes in cold regions. In this study, changes in unfrozen water content during freezing and thawing were measured to investigate the roles of soil matrix and salinity and to characterize freeze-thaw hysteresis. Experiments were conducted on three types of sandy soils with different fines contents and mineral compositions (100% sand, 80% sand + 20% silt, 80% sand + 20% clay), each amended with four NaCl concentrations (0%, 1%, 3%, 5%). A calibration method for quantifying unfrozen water content in saline soils based on dielectric constant measurements was proposed. The results show that supercooling is the primary cause of hysteresis under saline conditions. The magnitude of hysteresis, quantified as the difference between critical supercooling temperature and equilibrium freezing temperature, decreases with increasing salt concentration. Ice formation in macropores following the supercooling stage concentrates salts in micropores, thereby making salinity the dominant factor inhibiting pore water freezing. Moreover, the difference between the equilibrium freezing temperatures of soil and the freezing point of solution increases with salinity, indicating that there may be a coupled inhibitory effect of matric potential and osmotic potential on pore water freezing. Combined analysis with experimental data reported in the literature shows that, as the salt concentration increases, different types of soil, including sand, silt, and clay, exhibit similar changes in unfrozen water saturation, demonstrating that the controlling mechanism of pore water freezing shifts from soil matrix dominance to salinity dominance.}
}
@article{EEKHOUT2026135387,
title = {Vegetation greening and reservoir construction as drivers of century-long discharge trends in the Mediterranean Basin},
journal = {Journal of Hydrology},
volume = {672},
pages = {135387},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135387},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004841},
author = {Joris P.C. Eekhout and Hamouda Boutaghane and Hamouda Dakhlaoui and El Mahdi {El Khalki} and Gökçen Uysal and Sergio M. {Vicente Serrano} and Yves Tramblay and Joris {de Vente}},
keywords = {Mediterranean basin, Long-term discharge, Runoff drivers, Reservoir construction, Hydrological regime, Vegetation greening},
abstract = {The Mediterranean Basin is typically classified as a region with decreasing streamflow trends since the 1960s, despite high variability in precipitation. Here we evaluated over a century of discharge trends (1914–2022) using data obtained from 654 discharge stations across the Mediterranean Basin from national and continental discharge databases. We assessed several drivers of discharge trends, including climate change, vegetation greening and reservoir construction. Trends in mean discharge align mostly with precipitation trends, showing distinct periods of statistically significant increasing (1941–1971) and decreasing discharge (1961–2000). Yet, mean discharge has been remarkably stable between 1981 and 2020, diverging from the significantly increasing precipitation trends during this period. Multiple linear regression confirmed that recent precipitation and vegetation greenness trends have an equally strong but counteracting effect on runoff trends. Reservoir construction caused a further consistent decrease in mean and maximum discharge, and weakened the natural discharge regime. Our study concludes that over the last century, discharge trends in the Mediterranean Basin can only partly be explained by precipitation variability. Reservoir construction and recent vegetation greening are identified as additional strong drivers of discharge trends.}
}
@article{YANG2026135343,
title = {Runoff pathway redistribution determined by rainfall and shallow karst fissures drives dissolved carbon allocation in abandoned karst farmland},
journal = {Journal of Hydrology},
volume = {672},
pages = {135343},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135343},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004403},
author = {Xue Yang and Youjin Yan and Quanhou Dai and Xiaojin Xu and Xinyin Zhang and Yingchong Yang and Lina Mei and Liangjie Wang and Fengling Gan and Pengfei Wu},
keywords = {Dissolved carbon, Carbon migration, Rainfall pattern, Shallow karst fissure, Karst},
abstract = {Understanding a critical process that influences the terrestrial carbon sinks is important, particularly in complex karst regions, which cover approximately 15% of the global land area. Characterized by widespread shallow karst fissures (SKFs), karst landscapes facilitate unique dual carbon transport pathways. This study investigates rainfall-induced shifts in dissolved carbon (DC) allocation within abandoned karst farmland, focusing on how shallow karst fissure porosity (SKF-P) gradients mediate these processes. Through controlled plot-scale experiments under natural rainfall conditions, we simulated abandoned farmland with SKF-P gradients of 0% (control, CK), 4% (KF4), 9% (KF9), and 16% (KF16). Our results indicate that SKFs significantly enhance DC mobilization and export, shifting the dominant loss pathways from the surface to the soil matrix interface. Higher SKF-P generally increased DC concentrations, particularly dissolved inorganic carbon (DIC). However, rainfall patterns critically modulated these effects and the relative contributions of dissolved organic carbon (DOC) and DIC. Notably, frequent light rainfall events amplified DOC export through the shallow karst fissure pathway. In smaller porosity treatments (KF4 and KF9), the proportion of DOC loss was comparable to that of DIC (DOC: 52.69% and 51.54%, respectively), indicating a shift in carbon redistribution pathways under these conditions. These findings underscore the critical interplay among the profile morphology of SKFs, rainfall dynamics, and altered soil conditions in abandoned ecosystems. SKFs-mediated carbon export represents a significant yet frequently underestimated component of the karst carbon budget, offering insights into the carbon response mechanisms of these landscapes to hydrological events. This study provides a vital process-based framework for more accurately quantifying the karst carbon budget, which uncovers a key process mechanism that may influence karst carbon sink assessment.}
}
@article{NOORI2026135315,
title = {Pre-storm hydrology buffers saltwater intrusion in coastal forests},
journal = {Journal of Hydrology},
volume = {672},
pages = {135315},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135315},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004129},
author = {Amirhossein Noori and Sergio Fagherazzi},
keywords = {Groundwater salinization, Storm surge, Ghost forests, Salt marshes, Soil salinization},
abstract = {Storm surge events are increasingly recognized as acute drivers of coastal soil and groundwater salinization, yet their short-term hydrologic impacts remain poorly quantified, particularly across ecotonal gradients. Here, we investigate groundwater and soil salinity responses to storm surges in a forest–marsh transition zone on the Eastern Shore of Virginia, USA, using a four-year, high-frequency observational dataset. Our results show that the increase in groundwater salinity during storm surges is negatively correlated with antecedent groundwater salinity (R2 = 0.59, p < 0.005), soil moisture (R2 = 0.58, p < 0.005), soil conductivity (R2 = 0.58, p < 0.005), and a novel salinity storage index, defined as the product of pre-surge groundwater conductivity and groundwater level to represent subsurface salt mass storage (R2 = 0.64, p < 0.005). Sites with dry soils and low pre-surge salinity experienced significantly larger jumps in groundwater conductivity, while soil-saturated sites exhibited buffered responses. The buffering effect is strongest farther from the marsh, where high soil moisture and groundwater levels reduce storm-driven salinization. These findings underscore the important role of antecedent hydrological conditions and terrestrial groundwater in modulating the impact of storm surges. In particular, sites with high soil moisture and groundwater levels can effectively limit salinization during surge events.}
}
@article{LI2026135395,
title = {Pedestrian dynamics in flooding disasters: an experimental study of unidirectional pedestrian flow under multiple water depths},
journal = {Journal of Hydrology},
volume = {672},
pages = {135395},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135395},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004920},
author = {Xintong Li and Chenglin Guo and Jie Chen and Yufei Qin and Jun Zhang and Nikolai W.F. Bode and Weiguo Song},
keywords = {Pedestrian dynamics, Evacuation, Flooding evacuation, Water depth, Unidirectional flow},
abstract = {Floods are among the most destructive natural disasters, yet understanding of pedestrian movement during floods remains limited. This study presents the first experimental investigation of unidirectional pedestrian flow under no-water and three water depth conditions, revealing how water depth influences movement dynamics. Findings indicate that the impact of water depth on pedestrian speed and density is density-dependent. At low densities, water resistance limits pedestrian movement speed, whereas at high densities, pedestrian interactions become the primary constraint. Flow capacity decreases progressively with increasing water depth, by 9.3%, 14.6%, and 26.8%, respectively. The nearest neighbor space is jointly influenced by both density and water depth. Increasing density compresses longitudinal spacing more than lateral spacing, while water condition further reduces forward personal space. This spatial transition is associated with gait adaptation: when step length exceeds shoulder width, the nearest neighbors concentrate on both sides of the movement axis. The pedestrian speed–headway relationship exhibits a consistent two-regime pattern—constrained and free—across all water depths. However, the step frequency–headway relationship shows two regimes only when water depth is below the knee (<0.60 m). Below knee level, pedestrian speed regulation involves coordinated adjustments of both step length and frequency. Above knee level, speed changes are primarily achieved through step length adjustments. Free step length decreases abruptly under water conditions (∼37.7%), while free step frequency declines monotonically with water depth (1.03–0.84 Hz). These results provide essential empirical data for flood evacuation modeling and support the development of effective flood risk mitigation strategies.}
}
@article{LECHNER2026135302,
title = {Hydrological drivers of surface runoff during high intensity rainfall experiments in Alpine ski regions},
journal = {Journal of Hydrology},
volume = {672},
pages = {135302},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135302},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003999},
author = {Veronika Lechner and Christian Scheidl and Matthias Schlögl and Andreas Huber and Elena Baldauf and Bernhard Kohl and Klaus Klebinder and Gertraud Meißl and Gerhard Markart},
keywords = {Surface runoff, Overland flow, Ski runs, Rainfall simulation experiments, Water yield, Random forest, Sustainable soil management},
abstract = {This study investigates the surface runoff behaviour in 12 ski regions in the Eastern Alps based on data from 74 rainfall simulation experiments. The dataset includes information on hydrological responses, water storage, and infiltration. By applying a random forest regression model, surface runoff coefficients were linked to site-specific hydrological variables, providing insights into drivers of surface runoff. Results indicate higher surface runoff coefficients on ski slopes (0.57) compared to reference areas (0.07) within ski resorts that were not modified for skiing activities. Moreover, our findings suggest that geological variables are the strongest predictors of surface runoff on ski slopes. On ski slopes the surface runoff response is also influenced by a combination of hydrological variables, including mechanical disturbances from slope preparation and land use practices. For the reference areas, soil and land use variables play a more pronounced role. These findings underscore the importance of sustainable soil management and restoration strategies to mitigate the impacts of ski slope construction on runoff regimes and to maintain hydrological stability in Alpine regions.}
}
@article{CHEN2026135323,
title = {Mega-hyporheic zones: interfacial porewater exchange through tidal compound megadunes},
journal = {Journal of Hydrology},
volume = {672},
pages = {135323},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135323},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004208},
author = {Xiaobing Chen and Jie Yin and M. Bayani Cardenas},
keywords = {Interfacial exchange, Tidal current, Flooding, Megadunes},
abstract = {Megadunes are common in large rivers, estuaries, and the continental shelf. They can be hundreds of meters long and several meters tall. Such bedform structures have been proven to play a crucial role in nutrient cycling and the maintenance of aquatic ecosystems. While porewater or hyporheic exchange has been extensively studied in smaller bedforms, these processes have yet to be studied in megadunes. We investigated megadune hyporheic exchange through modeling of surface water and groundwater flows over and through megadunes in a tidal inlet channel. The model was first validated against measured surface flow velocities during both flooding and ebb tides. Then we conducted paired simulations with and without higher-frequency topographic variations to isolate the contribution of smaller dunes. Also, water age was calculated to quantify how these compound dunes affect the pore water travel times. Results showed that the model could effectively capture the flow field over the megadune. The modeled pressure distribution along the sediment surface was dominated by the megadune; however, the superposed smaller dunes caused intense pressure fluctuations. The superimposed small dunes significantly intensify interfacial water flux across the sediment–water interface, with flux magnitudes reaching nearly two times that over smoothed bedforms and strongly influenced by flow direction and bedform asymmetry. Furthermore, water age modeling results showed that compound megadunes generate complex multiscale interfacial exchange zones with residence times spanning minutes to decades. Thus, these megadunes likely host unique ecological and biogeochemical processes that have gone unrecognized.}
}
@article{ZHU2026135375,
title = {Research on the mechanism of channel meandering based on the principle of minimum entropy production—A case study of the Yulong Kashi River in Xinjiang},
journal = {Journal of Hydrology},
volume = {672},
pages = {135375},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135375},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004725},
author = {Jianghang Zhu and Renyi Wang and Jiangtao Li and Jian Yan and Zhilong Chen},
keywords = {The principle of minimum entropy generation, River bend, Yulong Kashi River, Entropy generation rate, Satellite imagery},
abstract = {The mechanism underlying river meandering remains a challenging problem in river dynamics and geomorphology. Many scholars have put forward many theories and hypotheses of river bending mechanism, but in general, there is still a lack of a universal theoretical method that can uniformly explain the river bending mechanism. Based on the principle of minimum entropy generation, a universal principle method is proposed to explain the bending phenomenon of river channel by combining river hydrodynamics with non-equilibrium thermodynamics. The river system is regarded as an open thermodynamic system. Given the amount of incoming water and sediment, the total drop of the river and the initial river boundary as the external constraints of the system, the river system will spontaneously evolve into a stable state with the total entropy generation rate of the system tending to the minimum value, that is, the non-equilibrium stable state with the weakest strength of the irreversible river dynamics process. Correspondingly, macroscopically, it is reflected in the stable state that the overall river volume of the river system tends to be maximized by adjusting its own geometric shape of the rivers in different bend sections of the river system, that is, the stable geometric shape that the bending degree of the river system tends to be maximized as a whole. Based on the average Reynolds NS equation, the analytical expression of the rate of fluid entropy generation (Pl) in the river bend (l) is derived, and the quantitative relationship between it and the geometric parameters (Vl,θl) of the river bend is established. At low river dip angle, the term sinθl3/2 operates near the“sensitivepoint” exhibiting“high gain”, meaning that small changes in channel slope can lead to significant responses in the volume (Vl) and shape (sinuosity) of the river fluid, and the influence of low sediment content fine particles on it can be ignored.. Taking Xinjiang Yulong Kashi River as an empirical case, the 175.4 km river course is divided into 124 river bend sections by using satellite remote sensing data for verification and analysis. The results show that although the local entropy generation rate of each river section is different, the river resistance factor (Rl) formed by it is approximately constant (Rl≈54.29) along the river, which is highly consistent with the theoretical prediction results. It is confirmed that different river bend sections of the whole river system are adjusted to a stable state with the minimum total entropy generation rate through self-organization and coordination, and the applicability of the minimum entropy generation principle in the river system is verified. The theoretical method provides a new theoretical basis for the prediction and classification of river spatial geometry, and reveals that the essence behind the river bend phenomenon is the principle of minimum entropy generation of river system or the principle of maximum volume of river system.}
}
@article{GUO2026135399,
title = {Distinct molecular dynamics of dissolved organic matter along two alpine rivers driven by climate and microbes},
journal = {Journal of Hydrology},
volume = {672},
pages = {135399},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135399},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004968},
author = {Bixi Guo and Yongqin Liu and Xuliang Zhuang and Xuefeng Zhang and Pengfei Liu and Jianjun Wang and Quan Shi and Chen He and Nianzhi Jiao},
keywords = {Dissolved organic matter, Glacier-fed rivers, Molecular transformation, Riverine carbon cycling, Community assembly},
abstract = {Dissolved organic matter (DOM) plays a central role in freshwater carbon cycling, yet its molecular turnover across glacier-influenced alpine river networks remains rarely characterized. Here, we examined molecular-level DOM dynamics along two rivers with contrasting climates on the Tibetan Plateau, the Nujiang River (NJ) and the Yarlung Tsangpo River (YJ). Both rivers showed increasing proportions of refractory DOM along the flow path, but the underlying mechanisms differed. In NJ, DOM exhibited substantial molecular change rates ranging from 23.5% to 175.9%, with higher molecular diversity, aromaticity, oxidation state, and accumulation of lignin-like compounds. Variable precipitation influenced DOM through combined ecological and hydrological effects, where rainfall enhanced vegetation and microbial richness, increased inputs of lignin-like compounds, and strengthened downstream transport and mixing. These processes enhanced stochastic assembly and promoted the rapid accumulation and change rate of refractory DOM. In contrast, the change rates of DOM in YJ were relatively lower (24.0%–71.6%), and retained more protein- and amino sugar-like compounds. Stable hydrological, environmental conditions and consistent microbial processing gradually reduced DOM lability, leading to stronger deterministic control, limited variation in DOM inputs and the accumulation of relatively more refractory fractions. These contrasting patterns indicate that similar downstream trends in DOM composition can arise from very different ecological mechanisms. There results highlight how riverine DOM responds to varying environmental conditions and improve our understanding of DOM dynamics in alpine rivers.}
}
@article{LV2026135339,
title = {An adaptive decomposition-denoising and temporal context fusion framework for multi-station water-level forecasting},
journal = {Journal of Hydrology},
volume = {672},
pages = {135339},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135339},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004361},
author = {Haifeng Lv and Chaoyu Shi and Xiaoyu Ji and Shan Shi and Yong Ding},
keywords = {Water-level forecasting, CEEMDAN, Wavelet denoising, TCF-LSTM, Hydrological time series},
abstract = {Accurate water level forecasting is essential for flood control, navigation safety, and hydropower regulation; however, it remains challenging due to the strong nonlinearity, non-stationarity, and noise inherent in hydrological time series. To address these challenges, this study constructs a high-resolution hydrological dataset for the Mengjiang River Basin and proposes a hybrid deep learning framework, CEEMDANVF-WD-TCF-LSTM, which integrates an improved Complete Ensemble Empirical Mode Decomposition with Adaptive Noise and Variance Filtering (CEEMDANVF), targeted wavelet denoising, and a Temporal Context Fusion Long Short-Term Memory network. For simplicity, this framework is referred to as CE-WD-TCF-LSTM. The proposed model is designed to enhance both short-term (3-hour) and medium-term (6-hour) water level forecasting across multiple hydrological stations. Experimental results demonstrate that the proposed method consistently outperforms baseline models, including CNN and LSTM, as well as other hybrid variants. Specifically, the model achieves coefficients of determination (R2) values ranging from 0.87 to 0.96 for 3-hour forecasts and from 0.81 to 0.94 for 6-hour forecasts across all stations, while the Kling–Gupta Efficiency values remain above 0.86. Notably, the improvement is more significant in 6-hour forecasting, indicating that the proposed framework effectively mitigates multi-step error accumulation through decomposition–denoising and multi-scale temporal feature fusion. This study provides an effective and generalizable solution for multi-station hydrological forecasting and offers practical value for water resource management and flood risk mitigation.}
}
@article{WANG2026135311,
title = {A DeepONet surrogate for accelerating distributed hydrological model simulations},
journal = {Journal of Hydrology},
volume = {672},
pages = {135311},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135311},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004087},
author = {Tao Wang and Jiaxin Shi and Zhongjing Wang and Jingjing Duan and Zuowen Tan and Yongnan Zhu and Jiaqi Zhai},
keywords = {Deep neural operator (DeepONet), Parameter calibration, WACM, Surrogate model},
abstract = {Distributed hydrological models are the mainstream paradigm for watershed hydrological simulation, integrating heterogeneous factors through spatial discretization and demonstrating significant advantages in revealing the spatial differentiation patterns of hydrological processes. However, the high-dimensional parameter space leads to high computational costs and low robustness in parameter calibration in traditional distributed hydrological models. Taking Weihe River Basin and Water Allocation and Cycle Model (WACM), a traditional distributed hydrological model, as the study area and base model, this study proposed a surrogate Deep Neural Operator (DeepONet) model to enhance the calibration efficiency. The surrogate DeepONet uses a branch network to project the high-dimensional model parameters into a compact latent space and a trunk network to encode the spatiotemporal coordinates of runoff outputs, jointly learning a nonlinear mapping from parameters to runoff that replaces direct calibration in the original parameter space and thus greatly reduces both the effective parameter dimensionality and the computational cost of calibration. The results show that the median Kling–Gupta Efficiency (KGE) coefficient across all gauging stations exceeds 0.85, whereas the parameter calibration time is reduced to less than 10% of that required by traditional genetic algorithms. In addition, the surrogate model achieved high accuracy in runoff prediction, with KGE values above 0.80 at these ungauged stations. This study demonstrates that the deep integration of physical mechanisms and data-driven approaches can effectively enhance the trade-off in the efficiency-accuracy dilemma in hydrological simulations and presents a sound solution for high-dimensional parameter calibration in distributed hydrological models.}
}
@article{ZHANG2026135408,
title = {Land subsidence in urban lake-infilled areas detected by Radarsat-2 InSAR time-series: The case of Shahu and Nanhu Lake in Wuhan, China},
journal = {Journal of Hydrology},
volume = {672},
pages = {135408},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135408},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005056},
author = {Yang Zhang and Siyu Liu and Kai Lan and Linhong Wu and Yakun Han and Ying Liu and BoXiang Yu},
keywords = {Landsubsidence, Land development, LakeInfilled areas, Small baseline subset interferometric synthetic aperture radar, Radarsat-2},
abstract = {Over the past decades of rapid urbanisation in China, some cities have reclaimed land by infilling lakes to meet growing land demand, which has caused environmental problems such as land subsidence. However, the causal link between lake infilling–related land development and subsidence remains underexplored. Using the infilled areas of Shahu Lake and Nanhu Lake in Wuhan as case studies, this study delineated infilling extents for three stages (T1: 1987–1995; T2: 1995–2005; T3: 2005–2015) from multi-temporal Landsat imagery with an improved modified normalised difference water index (MNDWI). Subsidence during 2015–2019 was quantified using Radarsat-2 data and the small baseline subset InSAR (SBAS-InSAR) method. We then examined how the hydrogeological context, infilling period, land-use type, and engineering activities affect subsidence in the reclaimed areas. Between 1987 and 2015, lake-infilled areas expanded by 7.3269 km2 in Shahu and 10.5795 km2 in Nanhu, accounting for 69.61% and 41.93% of their 1987 water surfaces. Stage-wise infilling was 1.3742/5.0409/0.9117 km2 in Shahu and 1.3464/8.4654/0.7677 km2 in Nanhu (T1–T3). Annual rates ranged from −8.45 to 1.51 mm/yr in Shahu and from −7.59 to 3.34 mm/yr in Nanhu. Cumulative subsidence reached 31.05 mm in Shahu and 21.27 mm in Nanhu. Soft soils provide favourable conditions for subsidence, while the consolidation rate of fill material increased and then decreased, producing stage-dependent subsidence differences. Cultivated land showed larger cumulative subsidence fluctuations than ecological and construction land, likely due to irrigation and other human activities. Engineering works (e.g., buildings, roads, and metro lines) further intensified subsidence by disturbing effective-stress equilibrium. These findings clarify subsidence mechanisms in lake-reclaimed urban areas and provide actionable guidance for urban planning, including risk-informed zoning, targeted ground improvement on soft-soil or recently filled land, and routine InSAR-based monitoring to support sustainable development.}
}
@article{WANG2026135347,
title = {Seasonal variation patterns and drivers of baseflow recession dynamics across Australia},
journal = {Journal of Hydrology},
volume = {672},
pages = {135347},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135347},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004440},
author = {Tianmei Wang and Lei Cheng and Xuxin Lei and Yunfan Zhang and Shujie Cheng and Chenhao Fu and Yao Lai and Lu Zhang},
keywords = {Baseflow recession dynamics, Seasonal variation, Event-scale, Machine learning, Australia catchments},
abstract = {Understanding temporal variations in baseflow recession parameter a, a measure of the recession rate, is key to sustaining aquatic ecosystems and water supplies during droughts. However, the governing drivers remain poorly quantified, hindering the development of reliable hydrological predictions and climate-resilient water management strategies. This study quantifies event-scale temporal variation in the parameter a using periodic and seasonal analysis of recession events from 596 Australian catchments (stratified into temperate, grassland and tropical hydro-climatic regions). The primary influencing factors on the temporal variation of parameter a are further investigated using the Boosted Regression Trees (BRT) machine learning method and a post-hoc interpretation technique. Results show that the temporal variation of parameter a is dominated by seasonal (contributing over 50%) than by trend and residual components, and this seasonal variation exhibits a marked and consistent cosine-like pattern in all regions. Vegetation, temperature, and evaporative demand factors are identified as key influences on recession parameter a using machine learning, accounting for over 90% of three regions. The recession parameter a at event scale is interactively modulated by meteorological factors and vegetation dynamics, with a universal negative correlation with vegetation cover across all regions, and a positive relationship with temperature in temperate and grassland regions. This study reveals the seasonal pattern of the event-scale recession parameter a being influenced by meteorological and vegetation factors, thereby advancing the mechanistic understanding of baseflow dynamics and offering critical insights for water resource management under climate change.}
}
@article{YANG2026135319,
title = {A hybrid method coupling physical process-driven model with generative deep learning for probabilistic flood forecasting},
journal = {Journal of Hydrology},
volume = {672},
pages = {135319},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135319},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004166},
author = {Xuesong Yang and Bin Xu and Jingwen Liu and Junliang Jin and Ran Mo and Xinrong Wang and Zichen Ren and Yao Liu and Yuchen Shi and Qisheng Zhou and Ping-an Zhong},
keywords = {Probabilistic flood forecasting, Generative deep learning, Diffusion model, Xin’anjiang model, Vine copula method},
abstract = {Accurate and reliable flood forecasting is crucial for basin flood warning and water resources management. However, singular models often face challenges to maintain high capability in physical interpretability, forecast accuracy, and uncertainty quantification. This study proposed a hybrid model that couples a process-driven model with generative deep learning method. First, a probabilistic forecasting framework that couples the process-driven model with a data-driven model was developed. The forecast error series was obtained via rolling forecasts based on XAJ model. Subsequently, a Conditional Diffusion Model (CDM) was developed to learn the stochastic characteristics and temporal dependencies of multiple variables implicitly and then generate high-quality ensembles of forecast errors. Finally, the probabilistic forecast results were obtained by combining deterministic forecast results with generated error ensembles. The effectiveness of the proposed method was evaluated using historical flood events in the Longhekou Reservoir of the Chaohu Lake Basin, China. Compared with the benchmark XAJ-VC, the average NSE of XAJ-CDM was above 0.9, and the average RMSE and MAE decreased by 16.05%-72.48% within the 1–7 h lead time. Meanwhile, the average CR has increased by 19.45%, while the average RB and CRPS decreased by 54.88% and 63.98% respectively. In the vast majority of flood events, XAJ-CDM has better accuracy and reliability compared to the benchmark model. This study provides a feasible framework for coupling generative deep learning method with process-driven models. The findings highlight the potential of novel data-driven models and hybrid modeling methods in enhancing the accuracy and reliability of flood forecasts.}
}
@article{ZHAO2026135371,
title = {Climate change, dams, and irrigation expansion reshape water–energy trade-offs in the Lancang–Mekong River Basin},
journal = {Journal of Hydrology},
volume = {672},
pages = {135371},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135371},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004683},
author = {Hongling Zhao and Khosro Morovati and Fuqiang Tian and Hui Lu and Keer Zhang},
keywords = {Climate change, Irrigation expansion, Hydropower dams, Water–energy trade-offs, Lancang–Mekong River Basin},
abstract = {Rapid hydropower expansion and irrigation growth heighten water competition, further intensified by climate variability in transboundary basins. Existing models overlook spatial heterogeneity in irrigation demand, limiting their ability to capture water reallocations across systems. Here, we develop a hydrological modeling framework that integrates reservoir operations, irrigation withdrawals, and future climate projections to quantify Water–Energy trade-offs. A key innovation is the inclusion of a hydraulic infrastructure topology module that uses intelligent remote sensing canal detection technique to detect irrigation canals and establish river–reservoir–field connectivity. Historical simulations reveal that prioritizing hydropower generation can reduce downstream irrigation water availability by up to 14%, with dry-season impacts up to five times greater than those in the wet season. Under future scenarios (2021–2040), irrigation demand is projected to increase by 63–68%, largely driven by the expansion of irrigated areas. However, projected increases in dry-season precipitation under future climate change could mitigate these trade-offs, reducing average irrigation shortfalls to 7%. Our findings highlight how interdependencies between irrigation water and hydropower are reshaped by climate and infrastructure development, offering a new framework for evaluating adaptive resource management in transboundary river systems.}
}
@article{ZHONG2026135416,
title = {Coupled interfacial and thermal effects on water imbibition in soil nanopores: A revised Lucas-Washburn framework based on molecular dynamics study},
journal = {Journal of Hydrology},
volume = {672},
pages = {135416},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135416},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005135},
author = {Yu Zhong and Annan Zhou and Jiapei Du and Ali Zaoui},
keywords = {Lucas-Washburn equation, Nanoconfined imbibition, Soil-water interface, Temperature effect, Molecular dynamics},
abstract = {The classical Lucas-Washburn (LW) equation fails to accurately describe capillary imbibition phenomena in soil nanopores, where nanoconfinement, temperature, and surface charge substantially alter interfacial water behavior. A generalized form of the LW equation is proposed, which integrates nanoscale effects through a physics-informed scaling factor f. This new formulation explicitly incorporates interfacial and thermal influences that are previously treated in isolation and whose coupled effects are neglected, significantly extending the applicability of the LW model to nanoconfined soil media. Using molecular dynamics (MD) simulations across 45 representative montmorillonite slit-pore systems (2–10 nm wide, 0–104.91 cmol·kg−1 CEC, and 300–360 K), the water interfacial structure is identified via a density-based clustering algorithm (DBSCAN) and extracted imbibition slopes are used to calibrate the model through systematic analysis of the interfacial and thermal effects on capillary transport. The generalizability of the revised framework is further demonstrated through 18 additional simulations for different soil mineral systems, including kaolinite and quartz. The novel LW equation significantly enhances predictive performance, increasing the coefficient of determination from 0.19 to 0.92. Cross-mineral comparisons demonstrate its broad applicability, with R2 = 0.95 for kaolinite and 0.92 for quartz. Experimental validation using red-layer mudstone data confirms the accuracy of the proposed model, reducing RMSE from 71.63 mm to 5.54 mm. This work bridges interfacial molecular-level insights and practical continuum-scale predictions, offering a robust tool for assessing capillary-driven water transport in mineral-rich environments.}
}
@article{THANH2026135303,
title = {Streaming potential coupling coefficient in dual-porosity media with fracture networks and porous matrix},
journal = {Journal of Hydrology},
volume = {672},
pages = {135303},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135303},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004002},
author = {Luong Duy Thanh and Luis Guarracino and Nguyen {Manh Hung} and Damien Jougnot},
keywords = {Streaming potential, Zeta potential, Fractal, Dual-porosity media},
abstract = {Streaming potential is a non-invasive hydrogeophysical technique for monitoring water movement in porous and fractured media. Quantitative application of this method-such as for estimating hydraulic properties or characterizing subsurface flow-requires a clear understanding of the mechanisms governing streaming potential generation. Dual-porosity systems, typically composed of a porous matrix and a connected fracture network, introduce additional complexity in modeling electrokinetic phenomena. In this study, we conceptualize a dual-porosity medium as a combination of tortuous capillaries representing the porous matrix and tortuous fractures representing the fractured domain. Based on this geometrical framework, we develop a physically based model for the streaming potential coupling coefficient under saturated conditions. The model explicitly incorporates pore-water properties, solid–fluid interfacial characteristics, and microstructural descriptors of both media. We derive closed-form analytical expressions for the characteristic length scales of the porous matrix, fractured domain, and dual-porosity system, which play a central role in controlling electrokinetic responses. The influence of individual parameters on the streaming potential coupling coefficient is systematically examined, and the model is validated against published experimental data for both porous and fractured systems. The results demonstrate that the proposed model accurately reproduces observed trends and provides a robust framework for interpreting self-potential signals in dual-porosity media. This approach offers promising applications in hydrogeophysics, subsurface hydrology, and potentially in monitoring hydraulic fracturing processes.}
}
@article{TIAN2026135327,
title = {Drought rather than nitrogen addition drives the coordination of hydraulic conductivity and photosynthesis in three coniferous tree species},
journal = {Journal of Hydrology},
volume = {672},
pages = {135327},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135327},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004245},
author = {Jinyuan Tian and Haoyu Diao and J. Aaron Hogan and Anzhi Wang and Jiabing Wu and Guanhua Dai and Rongrong Cai and Fenghui Yuan},
keywords = {Water use efficiency, Hydraulic conductance, Leaf water potential, Wood anatomy, Conifers},
abstract = {Drought and nitrogen (N) deposition are two major global change factors that influence plant hydraulic function and photosynthesis, yet their interactive effects on conifer species remain poorly understood. In a factorial drought and N addition experiment simulating atmospheric N deposition scenarios, we investigated the responses of leaf gas exchange and tree hydraulic traits in three common Northeast Asia conifer species: Pinus sylvestris var. mongolica, Picea koraiensis (evergreen conifers), and Larix olgensis (deciduous conifer). Severe drought significantly reduced hydraulic conductivity and photosynthesis, primarily through decreases in tracheid diameter and increases in dry wood density, while N addition had no significant impact on these traits. Decreased hydraulic conductivity was accompanied by stomatal closure, resulting in reduced photosynthesis, demonstrating the tight coordination between water transport and carbon assimilation. Notably, L. olgensis exhibited distinct drought responses compared to evergreen conifers, indicating greater drought sensitivity, higher hydraulic efficiency, and narrower hydraulic safety margins. This study suggests that, under natural conditions, the effects of N deposition on these conifers are minimal relative to drought stress, indicating that afforestation efforts using these species in Northeast Asia are likely more constrained by water availability than by soil N levels.}
}
@article{WANG2026135424,
title = {Unraveling uncertainty in compound flood modeling: sensitivity of simulations to forcings and model parameters},
journal = {Journal of Hydrology},
volume = {672},
pages = {135424},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135424},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005214},
author = {Chen Wang and Francisco J. Gomez and Mohammad Mosavat and Soheil Radfar and Hamed Moftakhari and Hamid Moradkhani},
keywords = {Forcing sensitivity analysis, Parameter sensitivity analysis, SFINCS model, Explainable Machine Learning, Hurricane Beryl},
abstract = {Compound flooding, driven by the combined effects of rainfall, river discharge, storm surge, and wind, poses an increasing challenge for flood risk management in coastal regions. Accurate simulation of such events depends on hydrodynamic models, whose reliability is strongly affected by uncertainties in external forcings and internal parameters. Addressing this issue is particularly important for reduced-physics models such as SFINCS, which are increasingly applied to large-scale and time-critical flood forecasting. This study evaluates the sensitivity of SFINCS during the Beryl compound flood event (July 2024, Houston) through a dual-level analysis of forcing and parameter uncertainties. Forcings were perturbed within physically realistic ranges to represent measurement and reanalysis errors, while nine model parameters were systematically varied following the official documentation and preliminary tests. Results reveal strong spatial variability in forcing sensitivity: discharge dominated upstream stations, whereas boundary water surface elevation controlled downstream levels, with wind and pressure exerting negligible influence under the hydro-geomorphic conditions of this event. Parameter sensitivity was consistent across stations and methods, with water-level accuracy primarily governed by the numerical stability parameters theta and alpha and by Manning’s roughness N. After fixing theta at its recommended value (1.0) rendered alpha insensitive, confirming that its apparent effect was numerical and coupled with theta. After constraining these numerical parameters, N emerged as the main physical control on WSE accuracy, while GridSize governed runtime with alpha exerting a minor secondary influence. Parameter-induced uncertainty remained greater than forcing-induced uncertainty at most stations, though localized forcing biases occasionally modulated the total response. By jointly quantifying forcing and parameter uncertainties and focusing on measurement uncertainty within high-quality datasets, this study provides a practical framework for improving compound flood prediction and risk management.}
}
@article{XING2026135351,
title = {Large lake buffers regional extreme heat and surface energy under the 2022 record-breaking heatwave in China},
journal = {Journal of Hydrology},
volume = {672},
pages = {135351},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135351},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004488},
author = {Zikang Xing and Yunliang Li and Yufeng Dai and Jianhui Wei and Miaomiao Ma and Xuejun Zhang and Hui Gao},
keywords = {Extreme heat, Numerical modeling, Temperature regulation, Energy budget, Poyang Lake},
abstract = {Lakes are experiencing increasingly severe extreme heat, triggering negative consequences including lake heatwaves and ecological degradation. However, the feedback regulation of lakes to extreme heat and its underlying physical mechanisms remains inadequately understood. Accordingly, this study investigates the thermal regulation of Poyang Lake during the unprecedented 2022 extreme heat event, employing high-resolution Weather Research and Forecasting (WRF) modeling with a lake-removal numerical experiment. The results reveal that Poyang Lake acts as a phase-selective thermal buffer, exhibiting asymmetric impacts on extreme heat: daytime maximum air temperature is reduced by −1.30°C, while nighttime minimum increases by +1.47°C, yielding a net warming of +0.17°C and a significant 2.77°C contraction of diurnal temperature range. The multiple-year simulation (2010–2022) reveals that the magnitude of the lake’s thermal regulation scales significantly with heatwave intensity, culminating in the strongest temperature buffering observed during the record-breaking 2022 event. Phase-dependent analysis shows lake-induced cooling dominates initial/peak phases (−0.13°C to −0.07°C), transitioning to warming during the decline phase (+0.92°C), highlighting the lake’s role in smoothing extreme heat. The underlying mechanisms are driven by latent heat flux (LHF) and heat storage dynamics. LHF accounts for 89% of cooling effects peaking at −6.67°C. Heat storage change (HSC) mediates temporal modulation, with positive HSC (+21.82 W m−2) absorbing radiative energy during the peak phase, followed by heat release (−11.75 W m−2). Sensible heat flux (SHF) reduction (+1.85°C) and albedo-driven shortwave radiation increases (+0.85°C) partially offset LHF cooling. These findings advance understanding of large lakes as nature-based solutions for heatwave mitigation and underscore the need for dynamic lake-atmosphere coupling in regional climate models to improve extreme climate projections.}
}