@article{PANG2026135910,
title = {Enhanced identification of watershed hydrological extremes using an improved drought index incorporating hydrological non-stationarity},
journal = {Journal of Hydrology},
volume = {677},
pages = {135910},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135910},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010073},
author = {Xiaoteng Pang and Jianwei Liu and Qin Zhang and Haihua Jing and Xinghan Xu and Longhai Shen and Jianxu Han},
keywords = {Non-stationary, GAMLSS, Hydrologicalextremes, Standardized runoff index, China},
abstract = {Hydrological time series increasingly exhibit non-stationary behavior under environmental change, challenging traditional assessments of hydrological regimes that rely on stationarity assumptions. This study develops a GAMLSS–NSRI framework that explicitly incorporates temporal, seasonal, and meteorological drivers to characterize watershed conditions of runoff abundance and deficiency. Nearly 300 model configurations, involving different distribution functions, response-variable transformations, and covariate structures, were systematically evaluated to identify an optimal generalized additive model for location, scale, and shape (GAMLSS), which was then used to construct a non-stationary standardized runoff index (NSRI). The framework was applied to the Taoer River Basin (TRB) for validation. Results indicate that (1) response-variable transformation plays a dominant role in improving model performance; (2) the resulting NSRI shows overall verification performance than standardized runoff index (SRI), with higher probability of detection (POD), Heidke skill score (HSS), and AUC under both full-sample and leave-one-out evaluations, while its advantage remains evident when false-alarm diagnostics are considered; and (3) following the runoff regime shift, hydrological controls transition from mean-dominated to variability-dominated processes, increasing the likelihood of abrupt floods and droughts. Overall, the proposed GAMLSS–NSRI framework effectively captures both the risk and driving mechanisms of hydrological extremes, offering a robust basis for flood and drought risk management under non-stationary conditions.}
}
@article{ZHAN2026135942,
title = {Vegetation-hydrology interactions modulate porewater salinity dynamics in coastal salt marshes},
journal = {Journal of Hydrology},
volume = {677},
pages = {135942},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135942},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010395},
author = {Lucheng Zhan and Qi Xu and Jiaying Liang and Xiaodong He and Jiaheng Yan},
keywords = {Salt marsh, Soil bulk electrical conductivity, Salinity dynamics, Rainfall infiltration, Evaporation, Vegetation-hydrology interactions},
abstract = {Coastal salt marshes are vital ecosystems vulnerable to salinity conditions affected by complex intertidal hydrology. Although water-salt dynamics under tidal and climatic variations are well studied, the dynamic role of marsh vegetation in regulating porewater salinity remains insufficiently understood. This study integrates field monitoring of soil bulk electrical conductivity (EC) with controlled experiments to assess how upper intertidal vegetation influences bulk-EC-inferred porewater salinity dynamics, using Spartina alterniflora as a representative marsh species. At the field site, vegetated soils exhibited consistently more variable and lower bulk EC, with the mean EC at 1.0 m depth ∼20% lower than in adjacent bare flats. Controlled tank experiments further showed that rainwater infiltration reduced porewater salinity by up to 80.7% in vegetated plots, compared with 70.1% in bare soils within 37 days. The ∼10% difference in salinity change ratio (SCR) persisted for more than two months during subsequent dry conditions dominated by evaporation. These results suggest that marsh vegetation enhances the utilization of episodic rainwater inputs and promotes vertical salt leaching, while also moderating evaporation-driven salinization during dry periods. Overall, the findings indicate that marsh vegetation can modulate porewater salinity dynamics and help maintain suitable root-zone conditions during the growing season. These vegetation-mediated effects may contribute to the stability of coastal wetlands, although their persistence across seasons and longer timescales requires further investigation.}
}
@article{LAI2026135891,
title = {Transformation dynamics and controlling factors of dissolved organic matter along a groundwater–river–reservoir continuum in a subtropical karst region},
journal = {Journal of Hydrology},
volume = {677},
pages = {135891},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135891},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009881},
author = {Wen Lai and Xinlu Su and Jia Qin and Peng Chen and Jing Xiao and Qiaoqiao Huan and Tao Zhang and Jianhong Li and Hui Yang and Junbing Pu},
keywords = {Groundwater–river–reservoir continuum, Dissolved organic matter, EEMs-PARAFAC, Flowing-type water area, Impounding-type water area, Hydrological retention effect},
abstract = {Dissolved organic matter (DOM) represents the dominant pool of organic carbon in aquatic systems and undergoes microbial degradation and photodegradation—processes that govern its fate through CO2 evasion to the atmosphere, long-term sequestration via sedimentary burial, or reconfiguration into distinct DOM molecular fractions. The dynamics of DOM exert a critical influence the carbon balance and water environment of natural aquatic systems. In groundwater–fed rivers, reservoir construction alters natural hydrological regimes, establishing a groundwater–river–reservoir continuum that profoundly modulates DOM transport and transformation. Despite its ecological and biogeochemical significance, current knowledge regarding DOM sources and transformation pathways within such coupled systems remains incomplete. This study focuses on a groundwater–river–reservoir continuum in a subtropical karst area of southern China. By integrating excitation-emission matrix fluorescence spectroscopy (EEMs), PARAFAC modeling and End-member mixing model (EMMA), this study characterized spatiotemporal variations in DOM source and transformation processes across contrasting hydrological and seasonal conditions. Results indicate that allochthonous inputs generally dominated DOM contributions during April (spring), accounting for approximately 50%–60% in flowing-type waters (FTW) area and up to ∼80% in impounding-type waters (ITW) area. In July (summer and rainy season), enhanced biological activity increased the relative importance of autochthonous production, particularly in the FTW area, where its contribution rose to about 40%–50%, while the ITW area remained largely allochthonous-dominated (∼65%–80%). In December (dry season), reduced microbial activity and selective preservation promoted the accumulation of more refractory, humic-rich DOM, with autochthonous contributions becoming more pronounced in the FTW area (∼70%–80%) but remaining comparatively low in the ITW area (∼15%–40%). Reservoir-induced flow attenuation prolonged DOM residence time, while thermal stratification controlled vertical distribution. Collectively, these findings highlight a spatially differentiated yet seasonally coordinated regulation of DOM sources along the continuum. Overall, this study enhances understanding of DOM transformation along the hydrological continuum and provides new insights into the key mechanisms regulating carbon biogeochemical cycling in karst watersheds.}
}
@article{HU2026135914,
title = {Inter-reservoir benefit compensation for water-sediment regulation in the Yellow River Basin: From status quo to multi-functional synergy},
journal = {Journal of Hydrology},
volume = {677},
pages = {135914},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135914},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010115},
author = {Hao Hu and Guiliang Tian and Jan Franklin Adamowski and Mohammad Reza Alizadeh and Xiaodong Yan and Qingqing Ban},
keywords = {Yellow River Basin, Water-sediment regulation, Benefit compensation, Joint reservoir operation, Multi-functional synergy},
abstract = {To promote multi-objective synergy of water‑sediment regulation in the Yellow River Basin (YRB), this study develops an “optimization‑guided, compensation‑driven” regulation framework. A multi-objective collaborative model adaptable to various hydrological scenarios is established as the core analytical foundation. On this basis, a dual-track benefit compensation mechanism is formulated as the implementation driver, comprising horizontal impact-feedback compensation and vertical gap-filling compensation. Applied across three hydrological years (2018: wet year with high sediment load; 2013: normal year with medium sediment load; 2017: dry year with low sediment load), the model was tested on the Sanmenxia-Xiaolangdi reservoir system and the downstream channel as a case study. Results indicate that the majority of Pareto-optimal solutions fell within the range of primary to good coupling coordination, validating the model’s effectiveness. Analysis of inter-objective relationships reveals a complex trade-off structure: sediment discharge and reduction benefits compete strongly with hydropower generation benefits and weakly with ecological water deficit losses, whereas hydropower generation benefits and ecological water deficit losses exhibit significant synergy. Compared to actual operations, the synergistic approach increased total system benefits by 0.365 × 109 CNY (2018), 0.200 × 109 CNY (2013), and 0.131 × 109 CNY (2017), respectively. Following the implementation of a compensation mechanism, all stakeholders retained benefits equal to or greater than their actual levels, ensuring the scheme’s acceptability. The model provides a quantifiable approach to addressing interest imbalance and theoretical support for transitioning towards multi-functional synergy in YRB’s WSR.}
}
@article{NITSCHKE2026135926,
title = {Particle and carbon export from a restored goldmine in an Amazonian catchment: hydro-sedimentary source tracing},
journal = {Journal of Hydrology},
volume = {677},
pages = {135926},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135926},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010231},
author = {Naomi Nitschke and Stéphane Guédron and Cedric Legout and Antonio Martinez-Cortizas and Stanislav Jelavic and Jennifer Harris and Emmanuel Tessier and Sylvain Campillo and Stéphane Taravella and David Amouroux},
keywords = {Gold mine restoration, Sediment, Hydrology, Carbon, Suspended particulate matter},
abstract = {Artisanal and small-scale gold mining (ASGM) is prevalent in South America and the Amazon. It involves soil reworking, leading to an increase in downstream river turbidity and ecosystem degradation. In French Guiana, restoration, including landscaping and tree-replanting, is mandatory for legal gold mines, but the fate of post-exploitation sites is poorly characterised. To investigate the extent of particle export originating from a restored gold-mining site, high frequency suspended solid concentrations (SSC) and discharge measurements were performed upstream and downstream of a site in French Guiana. Two flood events were followed with geochemical tracers involving multielemental concentrations and Fourier-transformed infrared spectroscopy (FTIR) data in the particulate and filtered fractions, to unravel the origin of water (overland flow and groundwater), and particles (forest topsoil, mine topsoil, or riverbed sediments) within the watershed. Results show that within the year following restoration, the mining site remains a significant source of particles and carbon to the river, with an excess 100–300 kg km−2 (1.5–2.4 times increase) of particles exported due to the mining site, and specific carbon exports amounting to 9.8 ± 0.6 tCyr−1 km−2, comparable to exports observed in larger watersheds in the Amazon region. Hydrogeochemical and mineralogical data in the particulate fraction hint towards riverbank erosion and riverbed sediment remobilisation as an important source of suspended particles rather than mining site surface erosion. This underlines the importance of restoring and stabilising the riverbed in the goldmine rehabilitation process.}
}
@article{YANG2026135906,
title = {Precipitation changes dominate the reduced interannual variability of runoff across the Yarlung Tsangpo River Basin},
journal = {Journal of Hydrology},
volume = {677},
pages = {135906},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135906},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010036},
author = {Zelong Yang and Xiaomang Liu and Kaiwen Wang and Changming Liu},
keywords = {Cryosphere hydrology, Runoff components, Interannual runoff variability, Decomposition framework, Yarlung Tsangpo River Basin},
abstract = {River runoff from high-mountain basins underpins downstream water resources and hydropower generation, yet it is highly sensitive to climate warming. While the impacts of warming on long-term runoff magnitude are well documented, the evolution of interannual runoff variability—a critical indicator of water supply stability—and causal physical processes remain poorly understood. Bridging this knowledge gap is particularly urgent in the Yarlung Tsangpo River Basin, a typical cryosphere-influenced basin undergoing rapid climate change. Here, we examined annual runoff variations in the Yarlung Tsangpo River and its three tributaries (the Lhasa, Nyang, and Nianchu rivers) from 1982 to 2020. A novel decomposition framework was developed and integrated with a conceptual hydrological model to quantitatively attribute runoff dynamics to individual components: rainfall runoff (Qrain), snowmelt runoff (Qsnow), and glacier runoff (Qglacier). Our results demonstrate that annual runoff magnitude has increased across all four rivers, primarily driven by increasing Qrain. The absolute increases are 5.25 km3 (Yarlung Tsangpo River), 0.32 km3 (Lhasa River), 0.97 km3 (Nyang River), and 0.01 km3 (Nianchu River), respectively. Conversely, interannual runoff variability generally decreases, as the reduced interannual variability of Qrain and Qglacier counteracts the enhanced interannual variability of Qsnow. An exception is observed in the Lhasa River, where interannual runoff variability increases due to strengthened synchronization between Qrain and Qsnow. The relative changes in the coefficient of variation (CV) of runoff are −11.5%, +9.9%, −13.5%, and −4.8% for the four rivers. Process-based analyses reveal that shifts in the interannual variability of Qrain and Qsnow mirror the declining interannual rainfall variability and rising interannual snowfall variability, respectively. Meanwhile, the reduced interannual variability of Qglacier is linked to weakened temperature fluctuations and continued glacier shrinkage. These findings advance the understanding of hydrological dynamics in glacier- and snowmelt-influenced basins.}
}
@article{MENA2026135934,
title = {A deep learning-based probabilistic framework for streamflow prediction and water quality assessment},
journal = {Journal of Hydrology},
volume = {677},
pages = {135934},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135934},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010310},
author = {Alberto Mena and Rafael J. Bergillos and Javier Paredes-Arquiola and Gerald Corzo and Abel Solera and Joaquín Andreu},
keywords = {Streamflow prediction, Deep learning, Uncertainty propagation, Spatial disaggregation, Water quality modelling, Risk assessment},
abstract = {This study presents an integrated modelling framework designed to support water quality assessment and regulatory compliance analysis in river basins. The proposed approach combines deep learning-based streamflow prediction, stochastic uncertainty propagation, hydrological spatial disaggregation, and process-based water quality modelling at the basin scale. The framework is applied to the Júcar River Basin (eastern Spain), a highly regulated Mediterranean system characterized by strong hydrological variability and significant water quality pressures. Streamflow is predicted using a Long Short-Term Memory (LSTM) network, and uncertainty is propagated through Monte Carlo simulations to generate ensemble inflow predictions. These inflows are spatially disaggregated using variation factors derived from an HBV hydrological model, providing distributed inputs to a water quality model that simulates concentrations of biochemical oxygen demand (BOD), phosphorus, and ammonium. The framework successfully reproduces the main spatial and temporal patterns of pollutant concentrations while explicitly quantifying the uncertainty associated with hydrological predictions. Water chemical status classifications show high agreements with observations, achieving accuracies of 90% for BOD, 84.4% for phosphorus, and 85.3% for ammonium. By providing probabilistic estimates of pollutant concentrations, the framework also enables identification of periods with elevated risk of regulatory threshold exceedance. Overall, the proposed approach offers a robust and transferable methodology for integrating probabilistic hydrological forecasting with water quality assessment, supporting risk-informed river basin management under uncertainty.}
}
@article{FAKIR2026135875,
title = {A self-reinforcing feedback loop exacerbates groundwater depletion in semiarid aquifers},
journal = {Journal of Hydrology},
volume = {677},
pages = {135875},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135875},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009728},
author = {Younes Fakir and Hamza Sahraoui and Marc Leblanc and Michel Le Page and Sarah Tweed and Hamza Ouatiki and Houssne Bouimouass and Kaoutar Oukaddour and Mohammed Qachar and Abdelghani Chehbouni},
keywords = {Irrigation, Water table decline, Unsaturated zone, Isotopes, Groundwater recharge, Renewability},
abstract = {Groundwater depletion is a growing concern in semiarid regions, where aquifer sustainability is increasingly threatened by intensive irrigation. This study investigates the hydrological impacts of depletion on groundwater recharge processes. A multi-faceted approach combining long-term groundwater level analysis, remote sensing-based irrigation water requirements, drought indices, and isotopes (δ18O, 3H) was applied to an alluvial aquifer in central Morocco. Results show a marked acceleration of groundwater depletion post-2000, with decline rates reaching up to 5.8 m/yr in certain sectors, amid expanding irrigation water requirements and droughts. Tritium data reveal a significant reduction in modern recharge in depleted areas where groundwater depths have declined below 50 m, suggesting reduced aquifer renewal. Concurrently, the δ18O values show a transition in the recharge origin from low-altitude local precipitation to high-altitude mountain-derived sources in more depleted zones. A three-component isotopic mixing model confirms that depletion leads to vertical stratification in renewal times and recharge sources, with deeper groundwater that is extensively exploited for irrigation exhibiting older, higher-altitude signatures. The findings indicate that the large thickening of the unsaturated zone, driven by depletion-induced groundwater decline, leads to diminished recharge, creating a reinforcing feedback loop that exacerbates groundwater depletion and complicates aquifer recovery. The results presented here affirm that continued groundwater over-abstraction not only diminishes aquifer storage but also undermines aquifer renewability. Mitigating this unsustainable cycle necessitates immediate interventions to reduce groundwater withdrawals and enhance recharge. Groundwater should be managed as a strategic resource for both human and environmental needs, against climate change impacts, and as a legacy to future generations.}
}
@article{HAMIDI2026135933,
title = {Integrating multi-source remote sensing and numerical simulation approaches for enhanced flood hazard assessment},
journal = {Journal of Hydrology},
volume = {677},
pages = {135933},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135933},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010309},
author = {Ebrahim Hamidi and Brad G. Peter and Behzad Nazari and Hamed Moftakhari and Katherine Anarde and Hamid Moradkhani},
keywords = {Satellite-numerical data integration, Multi-source remote sensing, Hydrodynamic modeling, Flood monitoring, Data-scarce basins},
abstract = {Extreme flooding is expected to intensify under a warming climate, which emphasizes the need for rapid and accurate flood mapping to support effective risk assessment. Remote sensing (RS) and numerical simulations (NS) are widely used for flood monitoring, yet both have limitations that introduce uncertainty. NS rely on gauge observations for calibration, reducing accuracy in poorly gauged areas. RS offers spatially continuous coverage, especially in unmonitored regions, but is often hindered by cloud cover, vegetation, and low temporal resolution, frequently missing peak flood events and reducing mapping precision. In this study, we integrate multi-source RS data, including optical and synthetic aperture radar (SAR) imagery, with NS to improve the characterization of extreme floods. RS data provide high-resolution flood extent maps that support verification and calibration of NS models. In turn, NS offers process-based, high-temporal-resolution flood maps and flood dynamics information (e.g., flood depths), which are critical for emergency response. We assess this integrated approach through two case studies: the 2019 flood in Coffeyville, Kansas, and the 2017 Hurricane Harvey flood on the Texas coast. In Coffeyville, a model calibrated using gauge data was validated with RS flood maps. In the data-scarce Texas case, model calibration was based on satellite-derived flood extents. Results show up to 98% agreement between simulated and RS-based maps, though either singular method may occasionally yield unreliable outputs. This integrated approach leverages the complementary strengths of the two approaches to provide decision-makers with more reliable and higher resolution flood data for effective response to the expected extreme events.}
}
@article{ZHOU2026135867,
title = {Identification of extreme socioeconomic droughts considering heavy tailed distribution},
journal = {Journal of Hydrology},
volume = {677},
pages = {135867},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135867},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009649},
author = {Zonglin Zhou and Xinjun Tu and Yan Wang and Vijay P. Singh and Qingzhi Wen and Xiaohong Chen and Kairong Lin and Zhiyong Liu and Meixian Liu},
keywords = {Socioeconomic drought (SD), Multivariate extreme value theory (MEVT), Measure of asymptotic dependence (MAD), Pruned exact linear time (PELT), Piecing-together distribution, Uncertainty},
abstract = {Extreme droughts occur rarely or with low probability but they have caused significant damage to the ecosystem and human society. In this study, a framework, which incorporated the identification of socioeconomic drought, application of the multivariate extreme value theory (MEVT), analysis of extreme drought quantiles, simulation of a piecing-together method, and evaluation of future extreme droughts, was developed for evaluating extreme socioeconomic droughts. Results demonstrated that the useful of this framework and the MEVT. Both the Xinanjiang hydrological model and system dynamics method performed well in the Dongjiang River Basin, South China. By coupling a measure of asymptotic dependence and a pruned exact linear time method for decreasing the impact of uncertainty originated from sample size, the cumulative distribution frequency of the extreme drought threshold was estimated as 0.95. The extreme drought threshold had a duration of 6.8 months and a severity of 2.6 billion m3. The piecing-together method captured the upper tail of drought properties with high reliability. The MM model reduced the upper tail RMSE (UT-R) by 69.7%-87.1% for both drought properties relative to the WBL and GEV models. In contrast to the single Gumbel copula, the GPD-Copula model yielded a 2.35% lower AIC alongside comparable UT-R. The frequency of extreme socioeconomic droughts had increased by 75.4% since the reform and opening-up period. Total water demand followed an inverted U-shaped trajectory across all future scenarios, with the average annual total demand increasing by 1.2%-43.6% relative to the 2023 baseline of 5.7 billion m3. Within the same projection period, the frequency of extreme droughts increased compared to the historical baseline. The hydrological model was the major uncertainty factor in the evaluation of future extreme drought.}
}
@article{ALMEIDA2026135895,
title = {Enhancing water management in data-scarce watersheds using satellite and reanalysis precipitation: a combined SWAT+ and SMOGN machine learning approach},
journal = {Journal of Hydrology},
volume = {677},
pages = {135895},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135895},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009923},
author = {Manuel Almeida and Narciso Ambrósio and Senlin Zhu and Pedro Coelho},
keywords = {Precipitation datasets, SWAT+, Machine learning, SMOGN, Bayesian optimization},
abstract = {This study addresses a key gap in hydrological modelling: the lack of a robust and integrated methodological framework for reliable streamflow simulation in data-scarce regions. This gap is addressed through the joint evaluation of a physically based model (Soil and Water Assessment Tool Plus, SWAT+) and multiple machine learning models under multiple precipitation datasets and resampling strategies implemented using SMOGN, as well as complementary evaluation frameworks. The approach integrates satellite and reanalysis precipitation products (Multi-Source Weighted-Ensemble Precipitation, MSWEP; Integrated Multi-satellitE Retrievals for Global Precipitation Measurement, IMERG; and ERA5-Land), and a dual evaluation framework using conventional performance metrics and Flow Duration Curve indicators, enabling a comprehensive assessment of hydrological behaviour across flow regimes. The analysis was conducted in two contrasting Angolan watersheds (2716–94,976 km2) representing temperate and tropical savanna climates. Results show that model performance rankings are sensitive to the choice of evaluation metric, with notable discrepancies between conventional metrics and Flow Duration Curve-based indicators, which better capture hydrological extremes. Across models and watersheds, MSWEP emerges as the most robust precipitation dataset, while ERA5-Land performance is more watershed-dependent and influenced by calibration effects. Importantly, higher agreement with observed rainfall does not necessarily translate into superior hydrological model performance. Overall, both SWAT+ and machine learning models provide reliable streamflow predictions for water management applications. Random Forest and Artificial Neural Network models with no or moderate resampling, together with SWAT+, are recommended for operational use, highlighting the importance of multi-metric evaluation and context-specific modelling strategies.}
}
@article{SHEN2026135883,
title = {Hydrological forcing drives polymer-specific segregation and microplastic risk hotspots in a large floodplain lake},
journal = {Journal of Hydrology},
volume = {677},
pages = {135883},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135883},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009807},
author = {Zheyu Shen and Zhonghua Zhao and Enlou Zhang},
keywords = {Microplastics, Floodplain lakes, Hydrological seasonality, Polymer segregation, Risk assessment},
abstract = {Seasonal hydrological forcing can regulate microplastic (MP) transport, retention, and sediment storage in floodplain lakes, yet paired water–sediment evidence remains limited. We conducted paired seasonal sampling of surface water and surface sediment from 36 sampling lakes or lake sectors of Poyang Lake during flood and dry seasons. Seasonal energy fluctuation was quantified using FEI = Q2/WL and F = |ln(FEI_dry/FEI_flood)|, where Q is discharge and WL is water level. From flood to dry season, mean water-column MP abundance increased numerically from 65.6 to 79.4 items/L, but this change was not significant across paired stations (p = 0.080). Sediment abundance remained similar (6.22 vs 5.94 items/g; p = 0.847). Over the same transition, the water-column size distribution shifted significantly toward 20–50 μm items within the 20–500 μm analytical window, with the < 50 μm fraction rising from 69.2 % to 83.0 % (p < 0.001). This pattern, together with contrasting responses in water size distribution and sediment polymer composition, indicates seasonal water–sediment decoupling, defined here as different seasonal responses between the rapidly changing water-column MP pool and the more slowly adjusting sediment MP pool. Polymer composition differed between media: sediments showed significant dry-season polyvinyl chloride (PVC) enrichment (p < 0.001), with PVC accounting for 41.31 % of identified sediment MPs. This enrichment strengthened the count-based polymer-hazard signal in sediments, especially in higher-fluctuation zones. Our findings show that hydrological forcing can drive polymer-specific MP segregation in large floodplain lakes. Monitoring should combine abundance, size structure, polymer composition, and hydrological setting across seasons.}
}
@article{YANG2026135855,
title = {Interconnected groundwater–surface water interactions and carbon transport across a subarctic river valley},
journal = {Journal of Hydrology},
volume = {677},
pages = {135855},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135855},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009522},
author = {Yanni Yang and Jarkko Okkonen and Kirsti Korkka-Niemi and Annika Åberg and Arto Hyvönen and Hannu Marttila},
keywords = {Hydrology, Hydrogeochemistry, Boreal aquifer, Carbon, GW-SW interactions},
abstract = {Groundwater–surface water (GW-SW) interactions play an important role in subsurface carbon transport and transformation but remain understudied. This study investigates the aquifer-river system of the Oulankajoki River Valley in northeastern Finland to evaluate how hydrostratigraphy and recharge pathways regulate groundwater hydrogeochemistry and carbon transformation during 2022–2025, using a combination of a 3D geological model, multivariate analyses (PCA, HCA), and stable isotope analysis. Results reveal three major findings. First, carbon dynamics within the aquifer are primarily governed by hydrostratigraphy, recharge connectivity, and groundwater residence time, while redox evolution regulates transformations between organic and inorganic carbon species. Second, groundwater is DOC-poor (1.2 ± 0.6 mg L−1) and DIC-rich (20.3 ± 6.7 mg L−1) relative to surface water (DOC = 8.3 ± 1.9 mg L−1; DIC = 4.5 ± 0.2 mg L−1), indicating efficient organic carbon processing and carbonate buffering. Third, multivariate analyses identify a clear hydrogeochemical separation between shallow, recharge-dominated groundwater characterized by transient DOC transport and deeper, carbonate-buffered groundwater associated with progressive DIC accumulation under longer residence times. The conceptual model developed in this study integrates recharge pathways, carbonate weathering, redox evolution, and DOC-DIC transformation within a unified framework. These findings underscore the importance of hydrogeological heterogeneity and groundwater evolution in regulating carbon coupling within boreal aquifer systems.}
}
@article{PIADEH2026135819,
title = {AI-assisted framework using physically informed rainfall–drainage features for real-time urban flood risk forecasting},
journal = {Journal of Hydrology},
volume = {677},
pages = {135819},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135819},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009169},
author = {Farzad Piadeh and Vahid Bakhtiari and Kourosh Behzadian and Farshad Piadeh},
keywords = {Drainage systems, Dynamic mixture of expert, Ensemble modelling, Multi-class prediction, Real-time modelling, Urban flood forecasting},
abstract = {Urban flash flooding is becoming more severe as urban population density increases, and severe and frequent floods occur. As a result, early warning systems are required that translate raw sensor data into clear and actionable hazard situations, rather than simply providing ongoing forecasts. For this purpose, this study develops a hydrological- and hydraulics-informed framework for real-time multi-class AI-based flood warning across evaporation (low risk), drained (medium risk), and flooding (high risk) states. The methodology firstly derives physically guided rainfall features using a rule-based back-propagation neural network to estimate return-period signals alongside seasonality and antecedent-rainfall cues, while hydraulics-informed “water-level memory” (current class and class duration) captures system dynamics. These inputs feed seven weak-learner families whose outputs are fused by a time-series mixture-of-experts. The model performance is evaluated for lead times of up to 5 h using both multi-step metrics and event-based analyses. The framework is applied to the Ruislip urban drainage system, UK, using long-term IoT rainfall and water-level records (2011–2024). The results show discrimination improved compared with voting and averaging ensembles. It also increases hit rates for flood and non-flood decisions at 1–3 h. At 4–5 h, it reduces false alarms and late detections. Event-based results show more on-time hits and shorter timing lags. Feature analysis shows that rainfall intensity and duration are the main drivers. Seasonal effects and antecedent occurrence also provide added value. Residual errors concentrate at longer horizons e.g. 5 h later where transitions between adjacent states are intrinsically difficult.}
}
@article{ALI2026135871,
title = {Hydraulic reconstruction and geomorphological impacts of surge-induced GLOFs in the Upper Indus Basin},
journal = {Journal of Hydrology},
volume = {677},
pages = {135871},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135871},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009686},
author = {Saima Ali and Sajid Ali and Lei Wang and Sidra Batool and Xiuping Li and Jharana Nepal},
keywords = {Glacier surges, Glacial Lake Outburst Floods, Hydraulic modelling, Indus Basin},
abstract = {Glacial Lake Outburst Floods (GLOFs) triggered by glacier surges pose significant hazards to downstream communities in the Upper Indus Basin (UIB), yet their hydraulic characteristics of flood wave propagation and associated geomorphological impacts of these events are poorly quantified. Here, by integrating multi-source remote sensing, two-dimensional (2D) hydraulic modeling (HEC-RAS), and field-based geomorphological assessment, this study reconstructs surge-induced GLOF events from five major surge-type glaciers (Khurdopin, Shishper, Chillingi, Central Rimo, and Chatteboi) in the UIB. Surge dynamics analysis using ITS_LIVE velocity data, terminus advancement and surge history data revealed distinct acceleration patterns with peak surface velocities exceeding 3 km/yr during active phases with Khurdopin recording four distinct GLOF events across separate surge phases between 1989 and 2022. HEC-RAS 2D simulations of validated GLOF events at Shishper (2019) and Khurdopin (2018) demonstrated strong agreement with observed discharge (R = 0.84–0.87, NSE = 0.90–0.93) and moderate-to-high accuracy in reproducing flood discharges and inundation extent (R = 0.69–0.75, NSE = 0.66–0.73). Peak simulated discharges under the high-breach scenario reached 2500 m3/s at Shishper and 2000 m3/s at Khurdopin, with flood waves propagating downstream within 5–6 h.Geomorphological assessment through field surveys and satellite image analysis documented extensive downstream impacts along the Shishper ravine and Shimshal River corridor, including pronounced channel widening, bed scouring, bank erosion, and destruction of critical infrastructure. These findings underscore the urgent need for continuous monitoring of surge-type glaciers and physically-based modeling frameworks to support hazard assessment and early warning system development in glacier-fed mountain basins under a warming climate.}
}
@article{YANG2026135899,
title = {Determining an optimal sample size range for UAV-assisted satellite soil moisture content retrieval using a farthest point sampling method},
journal = {Journal of Hydrology},
volume = {677},
pages = {135899},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135899},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009960},
author = {Furong Yang and Ning Geng and Yifei Yao and Rong Liu and Zugui Huang and Shikun Sun and Yadan Du},
keywords = {Soil moisture content, Farthest point sampling, Data fusion, Sampling optimization, Linear spectral reconstruction, Remote sensing},
abstract = {Accurate field-scale mapping of Surface Soil Moisture Content (SMC) is essential for precision agriculture and water resources management. While the reliable retrieval of SMC from optical satellite data remains challenging in mixed pixels containing both soil and vegetation, leveraging Unmanned Aerial Vehicles (UAV) has demonstrated significant potential for enhancing satellite-based SMC estimation. Specifically, the integration of UAV multispectral data into the Linear Spectral Reconstruction (LSR) method has enabled large-scale and high-accuracy SMC monitoring. However, achieving high SMC retrieval accuracy using the LSR-like UAV-based satellite enhancement method is constrained by sampling cost. In particular, the lack of an optimized sampling strategy has become one of the most critical limitations for satellite-based SMC retrieval. To address this issue, this study focuses on determining an appropriate sample size range required to ensure stable and accurate SMC retrieval, and proposes a Farthest Point Sampling (FPS) strategy that accounts for spatial representativeness in sampling design. Taking the Baojixia-Jiaokou irrigation district in Shaanxi Province, China, as the study area, the FPS method was compared with conditioned Latin Hypercube Sampling (cLHS), the Random Combination Method (RCM) and Spatially Balanced Sampling (SBS) under different sample sizes within an LSR-enhanced SMC retrieval framework. The results demonstrate that FPS generally provided more stable retrieval performance within a limited sample size range. Specifically, 50–90 samples were recommended as an appropriate sample size range, within which retrieval accuracy remained relatively stable, whereas further increasing the sample size produced only limited marginal improvements or even reduced retrieval stability. These findings systematically reveal the coupled effects of sample size and spatial sampling design on SMC retrieval performance and provide practical, cost-effective guidance for field sampling, thereby facilitating the operational application of UAV-assisted satellite enhancement methods such as LSR in regional SMC monitoring.}
}
@article{MANDAVYA2026135823,
title = {Modeling the impact of nature-based solutions on dry season water availability: exploration of spatio-temporal configurations},
journal = {Journal of Hydrology},
volume = {677},
pages = {135823},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135823},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009200},
author = {Garima Mandavya and Sadie McEvoy and Tolulope Odunola and Umit Taner and Xi Chen and Drew McAvoy and Koen Verbist and Patrick Ray},
abstract = {Nature-based Solutions (NbS) and other small-scale, decentralized infrastructure elements are increasingly recognized for their potential to reduce flood and drought impacts. Systematic evaluation approaches are now needed to identify effective spatial configurations and temporal staging for the implementation of NbS. This study develops and applies a hydrologic modeling framework to evaluate five NbS pathways combining alien invasive vegetation removal and replacement by indigenous grasslands or forest, and targeted soil conductivity modification to enhance infiltration. Pathways were assessed using multi-criteria metrics including hydrologic performance, feasibility, cost, and co-benefits for enhancing dry season flows. The five adaptation pathways were developed as representative combinations of short-, mid-, and long-term NbS interventions selected based on modeled hydrologic performance, feasibility, and stakeholder-identified implementation priorities and constraints. Pathway 1 and Pathway 2 emphasize the alien invasive vegetation removal and replacement with indigenous grasslands in different spatial sequences; Pathway 3 combines the alien invasive vegetation replacement with grasslands and soil modification; Pathway 4 combines the alien invasive vegetation replacement with grasslands and indigenous forest in different locations; and Pathway 5 combines the alien invasive vegetation replacement with indigenous grasslands and forest with soil modification at high-performing locations. Results show that each of the five adaptation pathways improves water availability relative to the baseline, with variations in their performance, feasibility, cost, and co-benefits. Across pathways, modeled average daily flow at the outlet increased from 6.0 m3/s (baseline) to 6.8–7.4 m3/s (+0.8–1.4 m3/s; ∼13–23%) under full-year conditions. Improvements were more pronounced during water-stressed periods: dry-season flow increased from 3.2 m3/s to 3.8–4.0 m3/s (∼19–25%), and flow in the driest year increased from 0.6 m3/s to 1.0–2.9. Pathway 5 enhanced the dry season flows the most while mitigating peak flows and providing ecosystem benefits. This research advances the integration of hydrologic modeling of decentralized land use changes and water system infrastructure elements with stakeholder-driven decision-making, thereby contributing to the adaptation planning and Adaptative Pathways Planning literature.}
}
@article{LIU2026135890,
title = {A flow matching-based deep generative framework for end-to-end hydrogeological parameter inversion in subsurface multiphase flow},
journal = {Journal of Hydrology},
volume = {677},
pages = {135890},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135890},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600987X},
author = {Piyang Liu and Jie Wang and Kai Zhang and Liming Zhang and Jinding Zhang and Zhi Tao and Jun Yao and Wei Zhang},
keywords = {Hydrogeological inverse modeling, Flow matching, Deep generative models, Multiphase flow, Aquifer characterization},
abstract = {Hydrogeological parameter inversion is a key component in constructing reliable groundwater-flow and multiphase-flow models, which are essential for geo-environmental applications such as groundwater resource management, subsurface contaminant remediation, and geological CO2 sequestration in deep saline aquifers. Traditional inversion methods usually require numerous forward simulations for iterative parameter updating or calibration, which can lead to a substantial computational burden. This study proposes an end-to-end generative inversion framework based on conditional flow matching, termed the Flow Matching Inversion Methodology (FMIM). Using a rectified-flow linear probability path, FMIM learns a continuous-time mapping from transient dynamic observations to data-conditioned hydrogeological parameter-field realizations. To reduce spatial redundancy in high-dimensional parameter fields, principal component analysis is introduced for parameter compression. An enhanced U-Net architecture with time and observation-condition embedding modules is then used to predict the conditional vector field that guides the ordinary differential equation generation process. The proposed framework is evaluated using four cases: a two-dimensional heterogeneous multiphase displacement aquifer model, the three-dimensional Brugge benchmark, a deep saline aquifer CO2 sequestration model, and a field-scale subsurface fluid extraction case. The results show that FMIM achieves lower parameter-field root mean square error than the tested deep generative baselines and data-matching performance close to that of ESMDA. After offline training, FMIM can efficiently generate multiple observation-conditioned plausible parameter-field realizations with improved data-space agreement after forward simulation. Overall, this study demonstrates that conditional flow matching provides a feasible generative modeling strategy for hydrogeological parameter inversion.}
}
@article{HU2026135887,
title = {Shifting flood regimes in Arctic basins under climate change},
journal = {Journal of Hydrology},
volume = {677},
pages = {135887},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135887},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009844},
author = {Shanshan Hu and Zhiying Wang and Tingting Wang and Yifei Hua and Wenbin Liu},
keywords = {Arctic river basins, CemaNeige-GR4J model, Flood dynamics, Dominant factors, All-subsets regression},
abstract = {Global warming intensifies the hydrological cycle, increasing the frequency and magnitude of floods worldwide, a trend particularly pronounced in the Arctic, where enhanced flooding exacerbates erosion and impacts ecosystems. However, the key drivers of Arctic flood variability remain unclear. To address this, we integrated hydrological and statistical modelling to quantify the contributions of hydrological factors to flood changes across 13 major Arctic rivers. We first reconstructed daily discharge using the CemaNeige-GR4J model, which, through multi-objective calibration targeting both runoff and snow processes, performed robustly (total Kling–Gupta Efficiency > 0.7 in most basins) and significantly improved the simulation of snow dynamics. Our analysis reveals spatially heterogeneous trends: flood magnitudes (maximum daily discharge) increased significantly on annual and seasonal scales in most basins (0.33–1567.17 m3·s−1·yr−1), while flood timing (date of maximum discharge) shifted earlier in spring/summer and later in autumn. Critically, all-subsets regression attribution shows that for ∼70% of the basins, interannual flood variations are predominantly driven by antecedent moisture conditions—specifically, soil moisture and snow water equivalent—rather than by precipitation or snowmelt events. This finding underscores the dominant role of accumulated basin storage over short-term meteorological extremes in shaping Arctic flood regimes.}
}
@article{JIA2026135714,
title = {Seepage and stability of earth embankments under termite activity: role of passageway configuration uncertainty},
journal = {Journal of Hydrology},
volume = {677},
pages = {135714},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135714},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008115},
author = {Weilong Jia and Yajun Li and Jun Yan and Donghui Li and Zhongzhi Fu},
keywords = {Seepage uncertainty, Preferential flow, Termite activity, Temporal stability, Graph theory},
abstract = {Seepage is a critical threat to the safety of earth embankments, and termite activity can intensify seepage hazards by creating high-permeability nests and passageways that act as preferential flow conduits. While surface indicators such as mud sheetings may reveal potential external hydraulic connections, the internal orientation and connectivity of passageways within the embankment remain largely concealed, motivating a probabilistic characterization of seepage and stability responses. This study develops a two-dimensional modeling framework that links spatial variability in hydraulic properties to uncertainty in preferential seepage path geometry and propagates this uncertainty through coupled seepage–stability analyses. Using the proposed two-dimensional framework, results from independent realizations under transient impoundment conditions show that passageway configuration uncertainty significantly influences the organization of local hydraulic gradients, the timing and extent of saturation, and the resulting time-dependent stability response. Approximately 70% of realizations reach saturation at a critical section no later than predicted by a single deterministic seepage path representation. Moreover, stage-based exceedance analysis indicates a systematic lag in deterministic predictions, with about 30–40% of realizations already exhibiting equal or greater stability degradation when the corresponding deterministic thresholds are reached. These findings suggest that, within the adopted two-dimensional framework, simplifying concealed internal passageways as a single deterministic seepage path may delay the identification of unfavorable seepage and stability conditions. Explicit consideration of internal passageway configuration uncertainty is therefore important for improving mechanism-oriented seepage–stability assessment of earth embankments affected by termite activity.}
}
@article{DIVYA2026135766,
title = {Vegetation-induced modifications of turbulence and energy budgets around spur dikes in compound channels},
journal = {Journal of Hydrology},
volume = {677},
pages = {135766},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135766},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008632},
author = {Thokala Divya and Adrian Wing-Keung Law and Tzyy Haur Chong and Soumendra Nath Kuiry},
keywords = {Submerged spur dikes, Vegetation, Compound channels, Numerical modeling, Mixing layer},
abstract = {River flow dynamics govern sediment and contaminant transport, flood propagation, and exchange processes between the main channel and floodplain. Flow obstacles such as spur dikes alter these dynamics by modifying local hydraulics and turbulence structure. This study investigates turbulent flow around a submerged spur-dike field in a laboratory-scale compound channel using large-eddy simulations. Simulations are performed with and without floodplain vegetation represented by rigid cylinders. The results show that spur dikes generate distinct coherent structures, shear-layers, and elevated turbulence levels in their vicinity. Submergence of spurs induces vertical separation above the dike crest, which interacts with horizontal separation to form wake vortices. Turbulence intensities, Reynolds stresses, and turbulent kinetic energy are weak near the bed, increase in outer layers, and diminish under submerged conditions due to modified shear-layer. Energy-budget analysis shows that horseshoe vortices and shear-layers dominate turbulence production. Near-wall production is balanced by dissipation, while advection and diffusion dominate energy transport farther from the boundary. Floodplain vegetation introduces flow resistance, causing lateral deflection and enhanced momentum exchange. Lateral momentum increases by approximately 23% at the main channel interface and vertical momentum by 45% at bank-full level, along with a twofold increase in peak turbulent kinetic energy. These findings highlight the potential of integrating spur dikes with riparian vegetation for enhanced mixing, improved bank protection, and reduced contaminant retention. The results also emphasize the need for optimized spur dike-vegetation configurations and localized scour protection to ensure safe and effective design.}
}
@article{LI2026135863,
title = {Pore evolution and infiltration mechanisms under freezing saline water irrigation: Cross-scale evidence from X-ray CT and stable isotopes},
journal = {Journal of Hydrology},
volume = {677},
pages = {135863},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135863},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009601},
author = {Junjie Li and Zhongyi Qu and Liping Wang and Gerile Hasi and Ruxin Zhang and Dongliang Zhang},
keywords = {Freeze-thaw cycle, XGBoost, SHAP, Percolation simulation},
abstract = {Freezing saline water irrigation (FSWI) is a promising strategy for utilizing unconventional water resources in cold and arid regions. However, the evolution of soil micropores under freeze–thaw conditions and their influence on water infiltration remain poorly understood, limiting precise application. To address this, we established a cross-scale framework integrating microstructural characterization, macro-scale water tracing, and pore-scale physical simulation. A field experiment with irrigation gradients of 0–270 mm was conducted, and X-ray CT, stable isotopes, and interpretable machine learning (XGBoost–SHAP) were applied to link soil structure, water redistribution, and flow function. The results revealed a nonlinear, irrigation-dependent response of pore structure: the 180 mm FSWI treatment produced the most favorable pore network during the thawing period, with higher connectivity and lower flow-path complexity. Isotope data confirmed efficient displacement of deep soil water under this treatment. Attribution analysis indicated that pore-topology quality, rather than pore quantity alone, largely governed CT-based simulated permeability. These findings provide a mechanistic basis for regulating water infiltration through FSWI and offer guidance for efficient and safe use of unconventional water resources in cold, arid agricultural systems.}
}
@article{YANG2026135879,
title = {Coupling spatial heterogeneity and temporal dynamics in graph neural networks for accurate forecasting of water quality},
journal = {Journal of Hydrology},
volume = {677},
pages = {135879},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135879},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009765},
author = {Bin Yang and Ruihao Zhou and Junjiang Zhou and Hui Li and Shenglian Luo},
keywords = {Water quality, Deep learning, Graph convolution network, Attention mechanism, Shifted window, Spatiotemporal feature},
abstract = {Accurate forecasting of water quality is important for environmental management and government decision-making. Despite that deep learning-based methods have attracted extensive attention in this field, their performance and generalization ability remain challenging due to the inherent spatial heterogeneity and temporal dynamics involved in multi-station and multi-step forecasting. To address this challenge, we proposed a novel deep learning-based model, termed Shifted Spatiotemporal Window Attention-based Graph Neural Network (SGNN), which explicitly couples spatial heterogeneity and temporal dynamics for multi-station and multi-step water quality forecasting. SGNN introduces an adaptive graph constructor to generate an adaptive graph, and a shifted window block which integrates shifted window-attention and shifted window-adaptive graph convolutional network to account for spatial heterogeneity and temporal dynamics. Its performance was evaluated on a real-world dataset collected in the Dongting Lake basin. Experiment results indicate that SGNN outperforms existing models in both multi-station and multi-step forecasting for a wide range of water quality indicators. Take the electrical conductivity for example, SGNN achieves R2 values of 0.9654, 0.9581, 0.9505 and 0.9338 respectively for 4, 12, 24 and 48 h forecasting. Additionally, generalization experiment indicates that SGNN maintained high accuracy for a different time period. These findings indicate SGNN is effective for multi-station and multi-step water quality forecasting, which is useful for environmental management.}
}
@article{MAJHI2026135917,
title = {Do CMIP6 models reduce the uncertainty in sub-daily extreme precipitation projections?},
journal = {Journal of Hydrology},
volume = {677},
pages = {135917},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135917},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010140},
author = {Archana Majhi and Sonali Pattanayak and C.T. Dhanya and Sumedha Chakma},
keywords = {Climate change, CMIP5, CMIP6, Sub-daily extreme precipitation, Uncertainty},
abstract = {The significant advancement in climate modeling has encouraged the scientific community to use updated projections such as CMIP6 with the expectations of better reliability as compared to its predecessor, CMIP5. The question, however, is whether these improvements have reduced the uncertainty in the projected sub-daily extreme precipitation at global scales, and if yes, how much. This question is addressed through the quantification of uncertainty using a mutual information-based weighted variance method and the comparative analysis of uncertainty in their probability distributions across quartiles, latitudinal profiles, and uncertainty risk maps derived from CMIP5 and CMIP6 GCMs. Comparing their quartile ranges showed that CMIP6 ensemble has lower uncertainty than CMIP5. The CMIP6 uncertainty risk map demonstrated a substantial increase in low uncertainty areas and a decline in hotspot areas for the Simple Hourly-Precipitation Intensity Index, Wet Spell Length, and Annual Total Precipitation indices, but there was a marked increase in hotspot regions for Monthly MAXimum 3Hourly-precipitation (MAX3H). The MAX3H have increased uncertainty particularly in West and East Africa, Southeast Asia, Amazon, and Northern Australian regions contributing 16 – 22% of global land regions. Nevertheless, it exhibited a seasonal average reduction in uncertainty of 25 to 35%, whilst the other indices demonstrated a reduction of 35 to 50% over the global land regions. However, this study confirms that the CMIP6 models have successfully added further credibility to their future sub-daily precipitation projections. Additionally, the study suggests careful model evaluation against extreme precipitation especially for tropics and improvement in the representation of vegetation and associated biogeochemical processes with deeper understanding of biases affecting land atmosphere coupling especially at dense vegetative areas.}
}
@article{ZHAO2026135810,
title = {Floods and public perceptions of climate change},
journal = {Journal of Hydrology},
volume = {677},
pages = {135810},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135810},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009078},
author = {Ye Zhao and Zhanwei Liu and Alan D. Ziegler and Meir Alkon and Kangjuan Lv and Xiaogang He},
keywords = {Flood;Public Risk Perception, Climate Change Concern, Multilevel Regression with Poststratification},
abstract = {The increase in recent floods caused by extreme rainfall events amid global temperature rise underscores the need to understand how these hazards shape public perceptions of climate change, and consequently, design effective communication strategies that promote adaptation and mitigation efforts. By analyzing climate risk perceptions across various demographics and regions worldwide, we find a strong link between personal flood experiences and climate change concern: the percentage of individuals concerned about climate change is 17.4 percentage points higher among those who have experienced floods in the past five years than among those who have not. Concerns are particularly pronounced in flood-prone areas, high-income countries, and regions with greater proportions of women, older people, and those with higher education and income. These findings suggest that recent flood experiences are linked to heightened climate change concern, particularly in affluent nations. Understanding these dynamics is essential for crafting targeted communication strategies and developing proactive policies that address the growing intersection of a warming climate and increasing flood hazards.}
}
@article{YANG2026135862,
title = {Seasonal hydrochemical variations of a regulated river in the North China Plain: mechanisms and implications for chemical weathering},
journal = {Journal of Hydrology},
volume = {677},
pages = {135862},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135862},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009595},
author = {Xi Yang and Tao-Tao Ji and Zhi-Yuan Zhang and Rong-Tao Ma and Xiao-Wei Jiang},
keywords = {Chemical weathering, Seasonal variations, Cation exchange, Carbonate precipitation, Baiyangdian Lake},
abstract = {Riverine chemical weathering constitutes a primary global carbon sink, yet its seasonal dynamics and controlling mechanisms remain poorly understood. Here, we investigate a river draining into the Baiyangdian Lake in north China by conducting a weekly sampling campaign over a hydrological year. During the low-flow period (March-August), we find the observed low Ca/Na ratios are driven by secondary geochemical processes like cation exchange and carbonate precipitation, not by enhanced silicate weathering. During the high-flow period (August-October), carbonate-derived ions are less sensitive to discharge rate than silicate-derived ions, indicating that elevated discharge promotes carbonate weathering to a greater extent. Moreover, we find carbonate weathering follows a transport-limited regime throughout the high-flow period and causes the flux to amplify linearly with increasing discharge, whereas silicate weathering follows a transport-limited regime during most of the high-flow period but shifts to a kinetic-limited regime during the flood pulse triggered by reservoir regulation. Due to flood-induced physical erosion and the exposure of fresh mineral surfaces, the descending phase of the flood pulse has a much larger slope of silicate weathering rate versus discharge than the rising phase, showing an event-scale hysteresis-like response between silicate weathering rate and discharge. Despite accounting for only 2% of the hydrological year in duration, the flood pulse contributes approximately 7.9% of the annual CO2 consumption budget. These findings highlight that failing to account for secondary geochemical processes during the low-flow period would overestimate silicate weathering, while omitting fleeting flood pulses would substantially underestimate the carbon sink capacity of the watershed.}
}
@article{YANG2026135909,
title = {Quantifying evaporative water loss in semi-arid urban lakes based on daily isotope measurements},
journal = {Journal of Hydrology},
volume = {677},
pages = {135909},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135909},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010061},
author = {Yinmei Yang and Shengjie Wang and Yudong Shi and Hongyang Li and Shijun Lei and Yujiao Zhang and Jianwen Zhao and Xiaofan Zhu and Mingjun Zhang},
keywords = {Stable water isotopes, Lake evaporation, Urban lake, Semi-arid region},
abstract = {The urban artificial lakes play an important role in regional water balance and resource management in urban ecosystems, and the evaporative water loss of these urban lakes is sensitively responsive to environmental change. Stable hydrogen and oxygen isotopes are natural tracers of the water cycle, enabling the quantification of the lake water budget. Here, we collected 625 lake water samples from three urban artificial lakes in a semi-arid city on the western Chinese Loess Plateau and estimated the evaporative water loss based on daily measurements of stable water isotopes. Results indicate that the slopes of the local lake evaporation lines for three urban lakes ranged between 4 and 6, reflecting an arid climate background. The urban lakes show spatial incoherence in the evaporation to inflow ratio (E/I), with the annual averages ranging from 20.3% to 40.5% among the three lakes. Deuterium excess (d-excess) showed a significant inverse relationship with E/I, confirming a decrease in deuterium excess during evaporation. Sensitivity analysis indicates that lake water isotope measurements play a critical role in lake evaporation models, with relative humidity exerting a significant influence. Furthermore, utilizing measured atmospheric water vapor isotope data can improve the accuracy of E/I estimates, whereas simplified methods based on isotopic equilibrium fractionation assumptions still exhibit bias. The emerging artificial urban lakes in past decades may enhance moisture recycling in an arid setting. This study elucidates the influencing factors of evaporation fractionation in urban lakes in a semi-arid climate, which is useful for understanding spatial incoherence in urban lake evaporation and enhancing urban hydrological modeling and water resource management.}
}
@article{ZHAO2026135882,
title = {Satellite water quality monitoring of China’s coastal inland waters based on Google Earth Engine},
journal = {Journal of Hydrology},
volume = {677},
pages = {135882},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135882},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009790},
author = {Yaqi Zhao and Yujia Yan and Xianqiang He and Zhiyan Chen and Teng Li and Xuchen Jin and Liu Zhao and Fang Gong and Fajun Jiang and Yan Bai},
keywords = {Water quality, Inland waters, Coastal waters, Google Earth Engine, Sentinel-2, Satellite remote sensing},
abstract = {Monitoring water quality parameters (WQPs) in coastal inland waters remains challenging because pronounced spatiotemporal variability and complex pollutant sources limit the robustness of conventional retrieval methods. High-resolution Earth-observation satellites improve spatial detail for fine-scale monitoring, but their application over large-area is constrained by substantial computational demands. Moreover, in optically complex waters, spectral information alone is often insufficient, highlighting the need to incorporate geographic and environmental predictors into WQP retrieval models. In this study, we developed a Google Earth Engine (GEE)-based workflow to retrieve four management-relevant WQPs across China’s coastal inland waters: permanganate index (CODMn), total nitrogen (TN), total phosphorus (TP), and turbidity (TUB). A large matched dataset was constructed by linking Sentinel-2 remote sensing reflectance (Rrs) with observations from automatic monitoring-stations, as well as geographic and environmental covariates. Based on this dataset, lightweight multimodal machine-learning models were developed to integrate optical, spatial, and environmental predictors within a computationally efficient, scalable framework. The models showed good predictive performance, with validation R2 values of 0.759–0.827 and independent test R2 values of 0.664–0.734, indicating satisfactory accuracy and transferability. Application to 2024 imagery in China’s coastal inland waters revealed clear spatial gradients, with CODMn, TN, and TP generally higher in northern regions, particularly in estuarine and nearshore waters. Seasonal patterns showed summer–autumn maxima for CODMn, TP, and TUB, whereas TN peaked in winter–spring. The proposed GEE-based framework provides a practical and transferable approach for WQP monitoring and water-environment assessment.}
}
@article{LE2026135937,
title = {Probabilistic prediction of maximum scour depth downstream of sluices and culverts using a tabular foundation model},
journal = {Journal of Hydrology},
volume = {677},
pages = {135937},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135937},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010346},
author = {Duc-Hau Le},
keywords = {Scour depth, Tabular foundation model, Model interpretability, Probabilistic machine learning, Uncertainty quantification, Culverts and sluice gates},
abstract = {Accurate prediction of maximum scour depth downstream of hydraulic structures is essential for safe design and risk-informed assessment. Traditional empirical and machine-learning approaches typically provide deterministic predictions and often require extensive task-specific tuning, limiting their robustness under data-scarce conditions. This study investigates the application of TabPFN (Tabular Prior-Data Fitted Network), a pre-trained foundation model for tabular data, for probabilistic prediction of scour depth downstream of culverts and sluice gates. Experimental datasets compiled from multiple laboratory studies are analyzed using a 4-fold cross-validation framework, and TabPFN is benchmarked against Random Forest, XGBoost, and CatBoost models under an out-of-the-box setting. Results show that TabPFN achieves competitive or superior predictive performance with improved stability across folds. Beyond point predictions, the model provides full predictive distributions, enabling uncertainty quantification through prediction interval metrics, including Prediction Interval Coverage Probability (PICP) and Mean Prediction Interval Width (MPIW). The results indicate well-calibrated and informative uncertainty estimates. Furthermore, the probabilistic outputs allow estimation of exceedance probabilities, supporting risk-informed and reliability-based design. SHapley Additive exPlanations (SHAP) confirm that the model captures physically meaningful relationships, with the densimetric Froude number (Fd) identified as the dominant controlling factor. The findings demonstrate the potential of foundation models to deliver accurate, interpretable, and uncertainty-aware predictions for hydraulic engineering applications.}
}
@article{YUAN2026135913,
title = {An improved fresh snow density parameterization scheme for snow depth simulation over the Qinghai–Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {677},
pages = {135913},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135913},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010103},
author = {Yecheng Yuan and Baolin Li and Rulin Xiao and Xizhang Gao and Wei Liu},
keywords = {Fresh snow density, Snow depth estimate, Snow model, Qinghai–Tibetan Plateau, Parameterization scheme},
abstract = {Existing fresh snow density parameterization schemes underestimate fresh snow density and overestimate snow depth (SD) on the Qinghai–Tibetan Plateau (QTP). This study proposed an improved fresh snow density parameterization scheme that considers ground surface temperature for model time steps (STFSDM), optimized by minimizing simulated SD bias by incorporating a terrestrial snow modeling system. A case study was conducted using data from 33 observation stations on the QTP during September 1, 2001–July 31, 2005. Compared to existing parameterization schemes, STFSDM increased the simulated average fresh snow density by 43.72–102.77 kg/m3 and decreased the root mean square error of simulated SD by 15.82–174.58%, and achieved the highest simulated SD accuracy over all seasons and in most climatic zones. STFSDM also decreased the root mean square error of simulated SD by 2.82% and 15.82%, compared to two local parameter optimization experiments that only utilized air temperature or ground surface temperature. These results showed that STFSDM increased estimated fresh snow density and thus reduced SD overestimation by considering ground surface temperature, and achieved more accurate SD simulationbecause it incorporated two distinct temperature-driven effects on fresh snow density: (1) the influence of air temperature on ice crystal formation as ice crystals fall, and (2) the impact of surface temperature on snow compaction upon landing. Thus, STFSDM reduces simulated SD overestimation under the observational conditions of QTP meteorological stations. This scheme is most applicable to SD simulations in areas similar to the QTP with short-duration seasonal snow cover.}
}
@article{LI2026135921,
title = {Microfracture network connectivity controls oil–water imbibition in 3D matrix-microfracture systems: a pore-scale investigation with percolation theory},
journal = {Journal of Hydrology},
volume = {677},
pages = {135921},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135921},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010188},
author = {Peiyu Li and Zhaojie Song and Yilei Song and Xiukun Wang and Japan Trivedi and Jiaqi Wang and Zhe Li},
keywords = {Fractured porous media, Oil-water imbibition, Microfracture network connectivity, Lattice Boltzmann method, Pore-scale simulation},
abstract = {Oil-water imbibition in matrix-microfracture systems is a key mechanism governing fluid transport in subsurface multiphase flow. Although recent studies have highlighted the critical role of fracture connectivity in imbibition, most of them treat microfracture connectivity in a qualitative manner and do not establish a quantitative criterion—when microfracture network becomes connected and how the imbibition mechanism transitions after connectivity is achieved. To address this problem, we built an integrated pore-scale framework that couples percolation theory with pore-scale imbibition simulations. Three-dimensional multiscale models spanning a wide range of fracture densities are constructed, and oil-water imbibition is simulated using a multi-relaxation-time lattice Boltzmann method (MRT-LBM). A Monte Carlo analysis is then performed to determine the critical percolation threshold, which occurs at a dimensionless fracture density of 4.5. In non-percolating matrix-microfracture networks, isolated microfractures act as local dead ends, and matrix-dominated imbibition leaves residual oil near fracture tips and in poorly accessible matrix regions. In percolating networks (the dimensionless fracture density from 4.3 to 6.0), connected microfractures provide fast pathways for wetting phase invasion and oil drainage; the increased geometric complexity and network connectivity intensify counter-current matrix-microfracture imbibition and reduced absolute residual oil saturation by 12.25%. However, the oil saturation response to microfracture density is non-monotonic: excessively high microfracture densities promote water channeling, hinder matrix-microfracture fluid exchange, and ultimately reduce recovery. By identifying microfracture network connectivity as the critical control on imbibition regime transitions, this work provides new fluid dynamics insight into matrix-microfracture fluid exchange and multiphase flow behavior in fractured porous media.}
}
@article{TRAMBLAY2026135949,
title = {Regional process-based analysis of trends in flood peaks and volumes using hourly data},
journal = {Journal of Hydrology},
volume = {677},
pages = {135949},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135949},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010462},
author = {Yves Tramblay and Patrick Arnaud and Pierre Javelle},
keywords = {Flood, Trends, Flash floods, Regionalization, Quantile regression},
abstract = {Most studies on flood trends rely on daily discharge data at the station scale, limiting their ability to disentangle contrasting trends in different flood-generation mechanisms. This is particularly true for capturing short-duration processes such as flash floods. Here, we propose a process-based regional framework to investigate trends across different flood types using hourly data. We analyze 829 small to medium-sized catchments (<500 km2) across France using hourly discharge, radar rainfall, and reanalysis-based soil moisture data. Flood events are extracted using a peaks-over-threshold approach and classified into four categories based on response time (flash vs. slow) and antecedent soil moisture conditions (saturated vs. non-saturated). Catchments are grouped into four homogeneous hydro-climatic regions, and a spatio-temporal declustering procedure is applied to account for spatial and temporal dependence between concurrent events. Trends in flood peaks and direct runoff volumes are then assessed using regional quantile regression. Results reveal strong contrasts between regions and flood types. Only a few trends were detected for flood peaks, whereas flood volumes exhibit more frequent significant increasing trends. The strongest increases are found for flash flood volumes in mountainous and Mediterranean regions. For slow-onset floods, significant positive volume trends are observed in basins located in temperate regions, in line with increases in both rainfall totals and duration. Overall, flood volumes show a systematically higher sensitivity to change than peak flows. These findings demonstrate that flood trend detection critically depends on temporal resolution, flood type, and regional context, and that volume-based metrics provide complementary and often stronger signals than peak-based indicators for assessing evolving flood hazards.}
}
@article{WANG2026135908,
title = {How uncertain are multi-source precipitation products in characterizing extreme precipitation?},
journal = {Journal of Hydrology},
volume = {677},
pages = {135908},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135908},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601005X},
author = {Yixuan Wang and Aizhong Ye and Lingyun Wu},
keywords = {Extreme precipitation, Precipitation product evaluation, Spatiotemporal displacement errors, China climatic regions},
abstract = {Given the increasing risks of extreme precipitation and the growing number of available precipitation products, it is necessary to comprehensively quantify uncertainties in how these products characterize extreme precipitation. This study uses 24 precipitation products across six categories over seven climatic zones in China to quantify uncertainty in the characterization of extreme precipitation and to identify consistent patterns in daily variability, annual trends, total amounts, event detection, and spatiotemporal displacement errors. The results show that: (1) Products show regional dependence across most evaluation dimensions, with larger discrepancies over the Tibetan Plateau and arid regions and higher consistency in humid regions, except for spatial displacement errors. (2) Detection errors are mainly from minor spatiotemporal misalignment rather than complete misses. Within acceptable spatiotemporal tolerance windows, for hit events with non-zero displacement, the non-zero typical mean absolute time offset across products ranges from about 1.1 to 1.3 days, and the non-zero typical mean spatial displacement is about 14.6 to 16.4 km. The systematic bias in extreme precipitation amounts for hit events is not pronounced. (3) Most products show broadly consistent relative error characteristics across regions: products with larger median spatial displacement and wider spread in one region often show similar patterns elsewhere. Temporal offsets show similar but weaker consistency, especially over the Tibetan Plateau and arid Northwest China. (4) The relative uncertainty characteristics of individual products within the 24-product ensemble differ across evaluation dimensions. These findings can support the assessment and interpretation of extreme precipitation, but their applicability is constrained by the selected reference dataset, daily 0.1° evaluation scale, and the many-to-one event-matching framework, which is designed to assess neighborhood detectability rather than strict event identity.}
}
@article{FU2026135905,
title = {ZY1-02D satellite spectral inversion of organic matter in highland mountainous red soils based on electric eel optimisation feature extraction and hybrid liquid neural network fusion},
journal = {Journal of Hydrology},
volume = {677},
pages = {135905},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135905},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010024},
author = {Chengbiao Fu and Zexin Zhang and Anhong Tian},
keywords = {Soil Organic Matter (SOM), ZY1-02D hyperspectral satellite image, Spectral correction, Liquid Neural Network (LNN), Characteristic band selection},
abstract = {Soil serves as the pivotal hub of terrestrial carbon cycling, and the full realisation of its carbon sequestration potential can contribute to mitigating global climate change. Variations in soil organic matter influence the global carbon cycle, with its quantity and quality directly determining soil productivity and sustainable utilisation levels. This study investigates the highland red soils of Dongchuan District, Kunming City, Yunnan Province, China. Utilising ground-based ASD hyperspectral and ZY1-02D satellite hyperspectral imagery as data sources, a multi-branch deep prediction model (M-LNN) incorporating liquid neural networks is proposed for quantitative inversion of red soil organic matter content. This model effectively extracts local spectral features, continuous dynamic characteristics, and long-term dependency information from hyperspectral data, thereby enhancing the prediction accuracy of organic matter. It incorporates multiple network architectures, employing parallel fusion of CNN, LNN, LSTM, and GRU networks to address limitations of LNN in hyperspectral inversion. Attention mechanisms are incorporated into each branch to refine the M-LNN, while multiple strategies enhance the traditional IEEFO algorithm to identify organic matter-sensitive spectral bands. The model demonstrated robust performance on ASD data with R2 = 0.8175, RMSE = 8.4713, RPD = 2.3410, and RPIQ = 2.4731. On ZY1-02D data, it achieved R2 = 0.5708, RMSE = 12.7520, RPD = 1.5264, and RPIQ = 2.5212, due to limitations in satellite spectral resolution, atmospheric interference, and surface heterogeneity, this level of accuracy is considered moderate, and the model’s ability to generalize to satellite data still needs to be further improved. Concurrently, SHAP analysis confirms the interpretability of the proposed IEEFO algorithm for screening organic matter-sensitive bands, and maps the spatial distribution of organic matter in red soils. This study provides a novel framework for predicting organic matter content in Yunnan Plateau red soils, offering scientific data references for regional soil fertility assessment and precision agricultural decision-making.}
}
@article{WU2026135874,
title = {Impact of sand mining on groundwater-surface water interactions in the Vietnamese Mekong Delta},
journal = {Journal of Hydrology},
volume = {677},
pages = {135874},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135874},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009716},
author = {Chengcheng Wu and Edward Park and Dung Duc Tran and Jingyu Wang and Nguyen {Le Duy} and Grigorios Vasilopoulos and Chengpeng Lu},
keywords = {Sand extraction, Groundwater depletion, Surface water-groundwater interaction, GRACE, Mekong Delta},
abstract = {Sand mining is a pressing socio-environmental concern in the Vietnamese Mekong Delta (VMD), profoundly reshaping river morphology, sediment transport, and hydrological processes. Although previous research has identified the adverse effects of sand extraction on surface water and channel morphology, its impact on groundwater has never been examined. This study addresses this unexplored relationship by providing the first investigation of how sand mining influences groundwater storage and surface water–groundwater (SW–GW) interactions, using an integrated approach of long-term field observations, remote sensing data, and hydrological records. Spatiotemporal analyses reveal a declining trend in groundwater storage anomalies (GWSA) and groundwater levels (GWLs), particularly in areas of intense mining activity. GWL decline rates in the unconfined aquifers within 1995–2017 vary spatially with a mean decline of 0.03 m/year. The maximum rate of GWL decline is 0.09 m/year and observed at the northeast and the minimum rate is 0.01 m/year and observed at coastal delta. GWSA has declined over 20 years in three phases: a sharp decrease (2002–2006, 3.2 × 107 m3/year), partial recovery (2006–2015, 8 × 106 m3/year), and a slower decline (since 2015, 4 × 106 m3/year). The findings indicate that extensive riverbed incision caused by sand mining deepens channels, disrupts sediment redistribution, and accelerates groundwater depletion while reducing aquifer recharge. As a result, riverbed hydraulic connectivity is weakened, leading to a diminished SW-GW exchange. A conceptual model is proposed to illustrate the mechanisms driving these changes. These insights suggest that regulating sand extraction intensity, monitoring incision hotspots, and integrating sediment management with groundwater governance may help mitigate long-term hydrological degradation in the VMD and similar large deltas.}
}
@article{KOHFAHL2026135845,
title = {Seasonal and interannual dynamics of non-rainfall water inputs in a coastal mediterranean dune ecosystem},
journal = {Journal of Hydrology},
volume = {677},
pages = {135845},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135845},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600942X},
author = {Claus KohfahL and Fernando Ruiz Bermudo},
abstract = {Non-rainfall water inputs (NRWI)—including dew, fog deposition, frost, and water-vapour adsorption (WVA)—can provide ecologically relevant moisture in water-limited environments, yet their long-term magnitude and partitioning remain poorly constrained. We present a three-year (2021–2024) assessment of NRWI in a Mediterranean coastal dune ecosystem in Doñana National Park (SW Spain), based on two large, high-precision weighing lysimeters under bare-soil and shrub-covered conditions. Hourly lysimeter mass changes during rain-free periods were combined with meteorological data to identify and classify NRWI components. Water-vapour adsorption dominated NRWI across all seasons and years, accounting for most events and cumulative inputs, while dew produced larger per-event gains but occurred less frequently. Fog deposition was negligible under conservative detection criteria. During the summer months, bare soil consistently accumulated more NRWI than shrub-covered surfaces, reflecting stronger nocturnal cooling and greater coupling to near-surface humidity. Dew showed pronounced interannual variability and was strongly reduced during the anomalously warm and dry hydrological year 2022, whereas WVA proved comparatively climate-resilient.}
}
@article{MCGAULEY2026135866,
title = {Mapping the past: identifying analog precipitation years with reference rainfall metrics},
journal = {Journal of Hydrology},
volume = {677},
pages = {135866},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135866},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009637},
author = {M.W. McGauley and R.D. Myers and B.M. Wadzuk},
keywords = {Climate change adaptation, Climate change analog, Precipitation, Reference year, Stormwater management, Temperature anomaly},
abstract = {Stormwater control measures (SCMs) are important for urban climate adaptation and mitigation strategies. Current design approaches use historical rainfall estimates to determine the design case; however these historical rainfall records do not adequately capture the observed nonstationarity resulting from climate change. While there are climate change projections, these have not easily or consistently been brought into practice. There is an opportunity to simulate climate change impacts analytically through analogous observations of other climate regions or past observations, as well as provide a method to express hydrologic observations and model predictions. This study aims to identify past years of rainfall in Philadelphia, Pennsylvania, USA that are analogous to projected precipitation under various climate change scenarios (three socioeconomic pathways projecting three future 25-year periods). Analogous rainfall years were identified using a novel metric that has previously been used to identify reference years of rainfall The analogous years and future projections both indicate the same precipitation risks in the form of larger, extreme events (approximately 10 mm of additional rainfall for the region’s 2-year, 24-hour event on average and preferential selection of the wettest years on record with climate change intensification). However, future temperature projections remain unprecedented in comparison to observations from the analogous precipitation years, where climate change projections consistently indicate a + 2–6 °C anomaly in monthly maximum air temperature from the baseline of 1950–2000 but the analogous years show little to no difference. In all, this work provides the two-fold outcome of a practical means for communicating the risks of climate change with recallable observations, and the potential to indicate observations that could be used in hydrological simulations to model the risks of climate change to water resources systems.}
}
@article{KIM2026135893,
title = {Assessment and attribution of predictive hydrologic uncertainty in operational short-to-medium range ensemble streamflow forecasting},
journal = {Journal of Hydrology},
volume = {677},
pages = {135893},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135893},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600990X},
author = {Sunghee Kim and Dong-Jun Seo},
keywords = {Ensemble streamflow forecasting, Short-to-medium range, Hydrologic uncertainty, Predictive skill, Assessment, Attribution},
abstract = {We assess the predictive hydrologic uncertainty in short-to-medium range (<Day 14) ensemble streamflow forecasting via 20-yr hindcast experiments for 398 headwater locations in the service areas of the 13 River Forecast Centers in the US. The assessment is based on the continuous ranked probability skill score (CRPSS) of ensemble streamflow prediction under clairvoyant future input forcings in reference to climatological ensemble streamflow forecast. The magnitude of hydrologic uncertainty is assessed in the CRPSS space relative to the total uncertainty represented by climatological ensemble streamflow forecast. Hydrologic uncertainty is attributed to selected uncertainty sources by isolating the lead time-dependent initial condition (IC) uncertainty via state updating. The limits of predictive skill under the current state of operational hydrologic modeling are assessed via the CRPSS of perfectly reliable ensemble streamflow predictions with and without state updating. The results show that there is large room for improvement in forecast skill from reducing hydrologic uncertainty. Significant unresolved hydrologic uncertainty exists for almost all locations for prediction of high flows. For prediction of all ranges of flow, unresolved hydrologic uncertainty is larger in the CRPSS space than the uncertainty resolved by hydrologic modeling and clairvoyant future forcings for most locations. The IC uncertainty at saturation is very significant and accounts for almost half of the unresolved hydrologic uncertainty on average. Isolation of the IC uncertainty indicates that many locations will likely benefit significantly from additional calibration of hydrologic models and fully utilizing the hydrologic memory via high-frequency state updating.}
}
@article{XIE2026135924,
title = {Redox front delineation framework from self-potential data for characterizing groundwater contaminant plumes},
journal = {Journal of Hydrology},
volume = {677},
pages = {135924},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135924},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010218},
author = {Jing Xie and Qinghua Huang and Yi-an Cui and Pu Wang and Lijuan Zhang and Hang Chen},
keywords = {Self-potential, Contaminant plume, Redox front, Inversion},
abstract = {Groundwater contamination from landfill leachate and hydrocarbon spills poses significant risks to water resources and public health. Conventional borehole-based monitoring methods provide accurate concentration data but are limited by sparse spatial coverage and an invasive nature. In contrast, self-potential (SP) surveys, as a non-invasive geophysical alternative, are particularly effective in detecting contaminant plumes through natural electric field variations. However, interpreting SP signals remains challenging due to overlapping electricity generation mechanisms in complex subsurface environments. This study develops an integrated redox front delineation framework combining advanced signal processing and imaging techniques to improve contaminant plume delineation. The framework consists of principal component analysis for source signal estimation, non-negative matrix factorization for target signal extraction, simulated annealing for SP amplitude and polarity recovery, and gradient-based inversion for SP source reconstruction. Laboratory experiments were conducted to validate the framework using two common SP signals in contaminated sites: microbial-mediated redox potential and fluid-related streaming potential. Results showed the framework significantly improved target signal extraction, with correlation coefficients increasing from 0.58 (microbial-related SP vs. mixed SP) to 0.85 (microbial-related SP vs. separated redox-type SP). The framework was then applied to field data from a municipal landfill, where the separated redox-related SP signals enabled more precise identification of contaminant plume boundaries compared to unprocessed data. This study provides a practical tool for the non-invasive characterization of contaminant plumes and the optimization of remediation strategies, advancing the deep cross-disciplinary application of geophysics, hydrogeophysics, and groundwater hydrology.}
}
@article{JAHANSHAHI2026135878,
title = {A multi-catchment evaluation of hydrological model transferability and ensemble averaging under contrasting hydroclimatic conditions in Iran},
journal = {Journal of Hydrology},
volume = {677},
pages = {135878},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135878},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009753},
author = {Afshin Jahanshahi and Martijn J. Booij},
keywords = {Differential split-sample testing, Climate non-stationary, Contrasting climatic conditions, Ensemble averaging, Hydrological transferability},
abstract = {Robust hydrological projections under climate change depend on model performance under conditions outside those used for calibration. This study presents a large-sample evaluation across 37 Iranian catchments to evaluate the transferability of six hydrological models using Differential Split-Sample Testing (DSST). Four ensemble-averaging approaches were also evaluated to determine whether under contrasting hydroclimatic conditions. DSST experiments were based on non-sequential 2–3-year periods selected according to (i) annual wettest and driest years and (ii) contrasting seasonal precipitation regimes. Model transferability varied substantially with the transfer setting, catchment attributes, and performance criterion. Ensemble averaging generally outperformed most individual models, although performance depended on the averaging method. Bayesian Model Averaging (BMA) and Granger-Ramanathan Averaging (GRA) consistently outperformed the Simple Arithmetic Mean (SAM) and Akaike Information Criterion Averaging (AICA). Based on the Nah-Sutcliffe Efficiency (NSE) metric, GRA exceeded the performance of the best individual model in 50–87% of transfer cases. This study provides a coordinated DSST-based evaluation of conceptual rainfall-runoff models and ensemble-averaging approaches across a large set of Iranian catchments. The results demonstrate how these established methods can be combined into a practical framework for climate-impact assessment in semi-arid, strongly seasonal regions. Based on this large-sample Iranian case study, we recommend DSST-based evaluation using climatically relevant analogues, multiple performance metrics, and advanced ensemble-averaging methods. Among the evaluated approaches, GRA emerged as the most practical compromise between predictive performance and computational efficiency. However, the relative ranking of models and averaging methods may differ under other climatic, hydrological, or data conditions.}
}
@article{PLACZKOWSKA2026135870,
title = {Positive matrix factorization for runoff component separation: a paired catchment application},
journal = {Journal of Hydrology},
volume = {677},
pages = {135870},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135870},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009674},
author = {Eliza Płaczkowska and Alexandra Weber and Larissa Böhrkircher and Niels Döscher and Gunnar Ketzler and Heye R. Bogena and Michael Leuchner},
keywords = {Positive Matrix Factorization (PMF), Hydrograph separation, Baseflow, Nitrate dynamics, Paired catchment approach, Eifel},
abstract = {Total streamflow is composed of two main components: direct runoff and baseflow, which represent different hydrological responses within a catchment. Traditional hydrograph separation methods based only on discharge data usually distinguish between these two end-members. However, both components can include waters with different residence times, flow paths, and geochemical histories, indicating that streamflow may consist of several hydrologically and chemically distinct sources. Chemical-based separation methods allow a more detailed identification of streamflow components, particularly in small headwater catchments where hillslope-stream connectivity increases hydrological complexity. In this study, we applied the Positive Matrix Factorization (PMF) model to water quality data from the experimental Wüstebach catchment in Germany. The model was tested in two neighbouring catchments with similar environmental conditions but different slope water movement patterns. The objective was to identify natural streamflow components and assess whether PMF can resolve multiple end-members beyond the traditional runoff-baseflow framework. PMF identified four end-members in the Wüstebach catchment and five in its tributary, revealing a more complex streamflow structure than commonly assumed. These components showed distinct temporal dynamics, indicating varying dominance under different hydrological conditions and suggesting different flow pathways and storage mechanisms. Overall, the results show that both direct runoff and baseflow consist of several hydrochemically distinct sub-components. The study highlights the sensitivity of PMF to subtle geochemical differences and its potential to improve understanding of streamflow sources and hydrological processes in headwater catchments.}
}
@article{KIM2026135797,
title = {Uncertainty estimation and error correction for multi-gauge water resource models},
journal = {Journal of Hydrology},
volume = {677},
pages = {135797},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135797},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008942},
author = {Shaun S.H. Kim and Justin D. Hughes and Julien Lerat and Dom Regan-Beasley},
keywords = {Water resource modelling, Uncertainty estimation, Ensemble generation, Error propagation, Streamflow perturbation, Streamflow correction, Non-parametric approaches},
abstract = {Accurate quantification of uncertainty in water resource models is essential for reliable basin-scale water management. This study presents a simple yet robust framework for estimating predictive uncertainty through stochastic error simulation and ensemble generation. The framework was designed to be practical for operational applications while remaining conceptually sound and computationally efficient. The framework represents streamflow predictive uncertainty through error models developed at gauged locations within the river network, using base river model simulations and observed streamflow. This approach enables simultaneous correction of streamflow predictions and quantification of associated uncertainty. Three error models were evaluated using Conditional Discrete and Non-Parametric (CDNP) methods: k-means clustering (KM), k-nearest neighbour (KNN), and kernel density estimation (KDE). The framework was applied to a water resource model for the Border Rivers and Gwydir catchments in Australia. The KM approach achieved superior fit and reliability metrics compared to KNN and KDE, while KNN performed comparably well under low flow conditions. The framework generally provided reliable predictive distributions, although uncertainty tended to be underestimated at low flows. This underestimation is thought to arise from non-stationarity, unaccounted spatial correlation of errors, and the assumption of error-free observed data. Future developments should focus on addressing these issues and some proposed approaches are given. Overall, the framework offers a practical and transparent approach for uncertainty estimation in water resource models, providing a foundation for more informed water management decisions.}
}
@article{WU2026135894,
title = {Physical-guided hybrid modelling framework for hydropower forecasting in non-stationary cascade reservoir systems},
journal = {Journal of Hydrology},
volume = {677},
pages = {135894},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135894},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009911},
author = {Nan Wu and Liangang Chen and Zhongrui Ning and Yong Shi and Jerker Jarsjö and Ke Zhang},
keywords = {Hydropower forecasting, Cascade reservoirs, Physical-guided deep learning, Reservoir regulation},
abstract = {In cascade reservoir systems, generation discharge is jointly influenced by hydroclimatic conditions and operating strategies. Accurate forecasting is therefore essential for safe operation and improved production benefits. We developed a physical-informed hybrid generation discharge forecasting framework, LSTM-PHY. It applies BFAST to decompose the hydropower generation (power) series into trend, seasonal, and residual components. Each component is modeled separately and then converted to generation discharge using the hydropower conversion equation. We evaluated LSTM-PHY at two major reservoirs in the Yalong River cascade system: Ertan and Jinping-I. The results show that: (1) BFAST produced physically consistent components: the trend captures the long-term evolution of regulation strategies, the seasonal term reflects monsoon-driven inflow patterns and within-year cycles, and the residual represents high-frequency variability induced by short-term scheduling decisions; the detected breakpoints are physically interpretable. (2) LSTM modeled the residual series well, achieving coefficient of determination R2 = 0.87 for Ertan in both the Calibration and Validation periods. For Jinping-I reached 0.82 in Calibration but decreased to 0.75 in Validation, indicating that training length affects generalization. (3) For generation discharge, LSTM-PHY achieved NSE = 0.90 in Calibration, outperforming LSTM-only (0.74) and BFAST-only (0.68). At the monthly scale, it maintained stable high performance in both flood and non-flood seasons, showing that physical-informed deep learning can capture seasonal discharge dynamics. Overall, LSTM-PHY improves predictive skill while providing a physically meaningful multi-scale view of cascade regulation, supporting hydropower forecasting and adaptive management under climate change.}
}
@article{SHI2026135886,
title = {Interlayer solution fissure flows as important and stable recharge sources for epikarst springs: evidence from isotopic measurements and in situ observations},
journal = {Journal of Hydrology},
volume = {677},
pages = {135886},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135886},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009832},
author = {Chunmao Shi and Qiuwen Zhou and Yuan Li and Hang Yang and Ze Yuan and Jian Qiu and Zhanghong Li and Dequan Zhou and Shengtian Yang},
keywords = {Interlayer solution fissure, Karst, Epikarst spring, Water source, Isotopes},
abstract = {The epikarst is the central hydrological unit of the karst critical zone, playing a crucial role in water storage and transfer. Interlayer solution fissures form a large independent storage zone within the epikarst. Previous research has typically classified interlayer solution fissure flow as a component of conduit and fracture flow, neglecting the regulatory and storage roles of its component in sustaining epikarst springs. Based on in situ observations and isotopic tracers, this study clarifies the contribution of interlayer solution fissure flow to epikarst spring discharge. Results indicate that during the wet season, interlayer solution fissure flow exhibits pronounced vertical differentiation in hydrologic behavior. Shallow horizons exhibit a larger response amplitude to rainfall than deep horizons, yet their water content is markedly lower. Throughout the wet season, interlayer solution fissure flow is characterized by a more enriched δ2H signature (−44.60‰) than vertical conduit flow (−65.80‰) and fracture flow (−63.43‰). Moreover, the hydrologic and isotopic responses of this flow to rainfall are weakened and delayed. Regarding recharge contribution, interlayer solution fissure flow accounts for an average of 27.07% of the total spring discharge, a proportion comparable to that of conduit flow (26.88%) and fracture flow (27.59%). Notably, the contribution of interlayer solution fissures to spring runoff exhibits the widest variability (10.40%–53.30%), indicating that interlayer solution fissure flow is a major source of recharge for epikarst springs. Given its critical role in maintaining the stability of spring discharge, a subhorizontal, slow-flowing interlayer dissolution fissure component for water storage and conveyance should be incorporated into conceptual models of karst aquifers. The findings reported here improve our understanding of the water storage and regulation mechanisms in karst aquifers.}
}
@article{GUO2026135850,
title = {Offshore wind farms' impact on phytoplankton carbon and water quality: A multimethod analysis},
journal = {Journal of Hydrology},
volume = {677},
pages = {135850},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135850},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009479},
author = {Xinglong Guo and Guoqing Li and Hongyuan Shi and Lingrui Guo and Jing Yu},
keywords = {Hydrodynamics, Eutrophication, Phytoplankton carbon concentration, Remote sensing},
abstract = {Offshore wind farms can affect marine ecosystems by altering phytoplankton carbon concentration and water quality. However, most existing studies rely on single observation methods, limiting a comprehensive understanding of these impacts. In this study, field measurements, remote sensing, and numerical simulations were integrated to assess the effects of offshore wind farms on surrounding phytoplankton carbon and water quality, and to explore their relationships. The results showed that (1) the integrated approach effectively captured both large-scale patterns and local dynamic changes in phytoplankton carbon concentration and water quality; (2) offshore wind farms increased phytoplankton carbon and chlorophyll-a concentrations. In summer, the phytoplankton carbon and chlorophyll-a concentrations inside the wind farm were more than twice those outside the wind farm; in winter, the phytoplankton carbon and chlorophyll-a concentrations inside the wind farm were approximately 1.5 and 1.1 times those outside, respectively; (3) dissolved oxygen, inorganic nitrogen, and inorganic phosphorus also increased inside the wind farm. Compared with those outside the wind farm, their increases were 2.93%, 45.72%, and 41.0% in summer, and 1.12%, 39.04%, and 49.59% in winter, respectively. (4) changes in phytoplankton carbon and chlorophyll-a were mainly driven by wind-farm-induced disturbances to the local flow field, rather than by nutrient limitation.}
}
@article{WANG2026135902,
title = {Environmental modulation of storm–flood response scale in a semi-arid urbanizing basin: a stability-validated power-law modelling},
journal = {Journal of Hydrology},
volume = {677},
pages = {135902},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135902},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009996},
author = {Yixuan Wang and Tingxi Liu and Ruizhong Gao and Xiaomin Liu and Limin Duan and Ping Miao and Hongli Ma and Shiming Bai},
keywords = {Storm-flood relationship, Power-law model, Urbanization, Vegetation restoration, Climate change},
abstract = {Environmental change can alter storm-flood response, but whether it modifies the baseline response magnitude or rainfall-response elasticity remains unclear in semi-arid urbanizing basins. This study developed a stability-validated power-law modelling framework to examine event-scale flood peaks in the Ulan Moron River Basin, northern China. Candidate influencing variables were screened using calibration-set tests, validation consistency, and bootstrap stability, and alternative model structures were compared by allowing environmental covariates to affect the scaling parameter (α), the rainfall-response exponents (β and γ), or both. Results showed that maximum 1-h rainfall intensity and total rainfall amount were the dominant storm controls, while environmental effects were more consistently represented through α than through β and γ. The dynamic scaling parameter αt decreased significantly over the study period, indicating a downward shift in baseline storm-flood response magnitude. From the early to late period, combined environmental change was associated with an approximately 69.8% reduction in α, mainly linked to integrated urban hydrological development, with additional contributions from temperature, surface energy partitioning, and vegetation regulation. Fixed-storm scenarios showed that environmental modulation produced the same relative effect across storm magnitudes but larger absolute flood-peak changes under larger storms. These findings suggest that environmental change primarily shifted the flood-response scale rather than producing robust storm-type-dependent changes in rainfall-response elasticity. The inferred effects should be interpreted as conditional, basin-specific associations rather than definitive causal estimates.}
}
@article{DENG2026135940,
title = {Soil carbon and nitrogen dynamics during the thermokarst lake succession under climate change on the Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {677},
pages = {135940},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135940},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010371},
author = {Yuanhong Deng and Xiaoyan Li and Zhigang Wang and Shaojie Zhao and Fangzhong Shi},
keywords = {Thermokarst lakes, Soil water, Permafrost thaw, Tibetan Plateau, Climate change, SOC},
abstract = {Thermokarst lakes (TLs) induced by permafrost thaw can disturb soil carbon and nitrogen cycling, creating positive feedbacks to climate warming. However, active-layer soil organic carbon (SOC) and total nitrogen (TN) dynamics across TL succession stages, as well as relative contributions of factors across spatial scales, remain unknown on the Tibetan Plateau (TP). For the first time, we investigated the expanding, stable, drying, and drained TLs on the TP, each with distinct microfeatures. We found that these TLs predominantly caused SOC and TN losses, peaking at the drying and drained stages; this divergence from the carbon accumulation in the Arctic is possibly due to the TP’s warm-dry climate. At the landscape scale, microfeatures, sand, soil water (SW), pH, and aboveground biomass explained over 50% of the variance in SOC, TN, and C:N at most sites, among which the local SW effect shifted from positive at water-limited sites (likely via mitigating water stress) to negative at water-sufficient sites (likely by exacerbating erosion). Regionally, background factors (climate, grazing, soil, and vegetation properties) explained over twice the variance in carbon and nitrogen metrics compared to within-landscape factors, with the background SW exhibiting the strongest effect. Projections incorporating climate-driven cascading effects through SW and pH showed that while future trajectories varied by TL stage, historical TL-induced C and N losses were likely irreversible under SSP climate scenarios. Our study demonstrates the need to incorporate fine-scale thermokarst processes (i.e., microfeatures and key hydroclimatic drivers) into Earth System Models to constrain uncertainty in projecting permafrost carbon-climate feedbacks.}
}
@article{KHAN2026135912,
title = {Evaluation of groundwater vulnerability in an alluvial aquifer using FEM-based VES modelling and hydrochemical analysis: a case study from Kasur, Pakistan},
journal = {Journal of Hydrology},
volume = {677},
pages = {135912},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135912},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010097},
author = {Idrees Khan and Yi-an Cui and Hao Li and Umair Khan and  Inayath-Ur-Rahman and Warda Yousaf},
keywords = {Vertical electrical soundings, Finite element modelling, Adaptive mesh, Resistivity inversion, Aquifer hydraulic parameters, Aquifer vulnerability index, Groundwater quality index},
abstract = {Groundwater degradation in industrial alluvial basins requires integrated assessment. Rapid industrialization and intensive agriculture have degraded groundwater quality, threatening drinking water and public health, especially in semi-arid regions where surface water is limited. In such settings, groundwater degradation has become a recurrent challenge, progressively compromising water potability, yet integrated frameworks for its systematic assessment remain limited. This study integrates geophysical and hydrochemical methods to evaluate aquifer conditions and vulnerability in Kasur, Pakistan. A total of 52 Vertical Electrical Sounding (VES) stations characterized subsurface variability. Finite Element Method (FEM) forward modelling and regularized Levenberg–Marquardt inversion resolved four- and five-layer models with aquifer thicknesses exceeding 210 m. Derived aquifer parameters showed spatial variability, including longitudinal conductance (2.6–14 Ω−1), transverse resistance (728.0–9350 Ω·m2), and hydraulic conductivity (31–69 m/day). The Aquifer Vulnerability Index (AVI) indicates high to extremely high vulnerability. The Groundwater Quality Index (GWQI) ranged from 39.1 to 158.4, revealing a transition from good to unsuitable water quality. High GWQI zones corresponded to elevated EC, TDS, Cl−, and SO42− concentrations. These zones spatially coincide with low-resistivity anomalies identified by FEM modelling, with EC (r = 0.980), TDS (r = 0.976), and chloride (r = 0.964) showing the strongest correlations with GWQI. The strong spatial coherence among resistivity distributions, aquifer parameters, AVI classes, and GWQI patterns confirms that industrial effluent infiltration controls groundwater deterioration. This integrated framework provides a robust approach for aquifer vulnerability assessment and supports targeted monitoring and improved effluent management in the Kasur industrial corridor.}
}
@article{NIE2026135861,
title = {Intercomparison of gridded hydroclimate reconstruction datasets in Asia and evaluation of regional hydroclimate changes},
journal = {Journal of Hydrology},
volume = {677},
pages = {135861},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135861},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009583},
author = {Wenzheng Nie and Dunxian She and Jun Xia and Guizeng Qi},
keywords = {Asia, Gridded reconstruction, Hydroclimate, Droughts, Pluvials},
abstract = {Gridded hydroclimate reconstructions spanning past centuries are essential for understanding long-term spatiotemporal hydroclimate variability. However, discrepancies among existing datasets—arising from differences in proxy types and reconstruction methods—introduce substantial uncertainty in regional assessments. In this study, we compiled and comprehensively evaluated eight major gridded hydroclimate reconstructions for Asia using instrumental and newly developed proxy data. The intercomparison reveals distinct regional differences in reconstruction skill, reflecting variations in proxy coverage and methodology. Notably, both drought‐ and pluvial‐affected areas have markedly expanded since the 1950 s, marking the onset of intensified hydroclimatic variability across Asia. Further analysis identifies five significant regional hotspots—two drought‐prone and three pluvial‐prone—where the frequency of extreme events has notably increased compared with earlier centuries, indicating a shift toward more variable hydroclimatic conditions in recent decades. These findings highlight strong spatial contrasts in hydroclimate change, providing an essential reference for paleohydroclimate research and the refinement of future gridded reconstructions in Asia.}
}
@article{BAMAL2026135916,
title = {Impact of floods on surface water quality: a systematic review and comprehensive assessment},
journal = {Journal of Hydrology},
volume = {677},
pages = {135916},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135916},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010139},
author = {Apoorva Bamal and Md Galal Uddin and Reza Ahmadian and Marcelo Gomes Miguez and Agnieszka I. Olbert},
keywords = {Floods, Criteria assessment, Water pollution, Water quality, Water quality parameters, Extreme flow},
abstract = {Floods, as extreme flow events, are among the costliest and devastating natural hazards. Among the various domains impacted by flooding, environmental degradation, particularly the deterioration of water quality (WQ), is one of the most impacted yet often overlooked. Therefore, it is essential to understand the nature and source of water pollution associated with flooding. This study aims to evaluate and assess multiple studies conducted globally to determine the impact of floods on WQ. A literature review and assessment of 66 studies published between 2007 and 2026 was conducted using the total comprehensiveness score (TCS). To support the scoring process, studies that scored more than 70% of the maximum achievable TCS (15.4) are considered the most detailed and comprehensive in addressing the objectives of this review. 16 studies achieved a TCS above 15.4, indicating that a limited number of studies incorporate a broader set of factors in this domain. A higher number of studies were conducted post the year 2021, highlighting both scientific progress and a growing focus on WQ impacts from disasters such as floods, beyond the traditionally emphasized socio-economic loss. Among the shortlisted studies, fluvial floods are the most frequently examined, followed by pluvial floods and coastal floods. During fluvial floods, turbidity increased by up to two orders of magnitude, while nutrient concentrations (TN, TP) typically rose by ∼ 10–30%. In contrast, pluvial floods were characterised by dilution-driven decreases in EC and TDS, with DOX, BOD and COD showing variable responses across flood types. This review evaluates flood impacts on WQ, catchment characteristics, and sources of WQ modification. The findings of the research reveal that not all WQ parameters are responsible for WQ degradation during every flood event. Rather, it is a combination of certain parameters that leads to deteriorated WQ. WQ degradation depends on interacting factors such as flood duration, extent, depth, and flow dynamics. In overall, this study provides an overview of the multiple cascading impacts of floods on WQ, along with a detailed perspective on the set of criteria that should be considered in future research.}
}
@article{SUN2026135952,
title = {Monitoring monthly water storage variation of the Three Gorges Reservoir using SWOT observations},
journal = {Journal of Hydrology},
volume = {677},
pages = {135952},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135952},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010498},
author = {Qiye Sun and Hui Li and Yonggui Wang},
keywords = {SWOT mission, Water storage variation, Riverine reservoir, Three Gorges Reservoir},
abstract = {Reservoir storage dynamics are essential for water resources management but remain difficult to quantify in elongated riverine reservoirs where longitudinal water surface gradients violate the horizontal-surface assumption commonly adopted in conventional estimation methods. This study presents a novel Water Volume plus Compensation Volume (WV + CV) framework that explicitly accounts for non-uniform water surface morphology in elongated riverine reservoirs. Leveraging wide-swath observations from the Surface Water and Ocean Topography (SWOT) mission, we reconstructed spatially continuous longitudinal water surface profiles for the Three Gorges Reservoir (August 2023-August 2025) and, for the first time, integrated two-dimensional water surface structure into reservoir storage estimation. Unlike conventional approaches that rely on the horizontal-surface assumption, the proposed WV + CV method decomposes storage change into water volume and compensation volume terms, thereby reducing systematic volumetric biases caused by pronounced longitudinal water level gradients. The method was evaluated against conventional trapezoidal and area--elevation--volume approaches. Results show that the reservoir experiences pronounced seasonal transitions between quasi-horizontal and strongly sloped water surface configurations, particularly during flood-season regulation. Under intensified longitudinal gradients, conventional methods systematically underestimate storage variations, whereas the WV + CV approach demonstrates strong agreement with reference estimates (R2 = 0.970; RMSE = 0.929 km3). These findings highlight the importance of resolving two-dimensional water surface structure for reliable storage estimation in elongated reservoirs and demonstrate the capability of SWOT observations to capture reservoir-scale water surface morphology, providing a scalable framework for monitoring storage dynamics in similar riverine reservoirs.}
}
@article{FU2026135928,
title = {Assessments of eight ET products based on long-term multi-source water balance elements in 133 catchments across China},
journal = {Journal of Hydrology},
volume = {677},
pages = {135928},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135928},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010255},
author = {Xiangyong Fu and Changming Li and Hanbo Yang},
keywords = {Evapotranspiration, Water balance, Multi-scale, Long-termevaluation},
abstract = {Accurate quantification of evapotranspiration (ET) is crucial for understanding hydrological processes in a changing environment. However, existing global ET products exhibit notable inconsistencies in regional ET representation and its trends, particularly in China. Previous studies, constrained by limited long-term runoff data, have not comprehensively assessed the performance of ET products in long-term trend representation. In addition, previous water balance-based assessments, which rely on single input data, generally have relatively large uncertainty. Therefore, we evaluated eight ET products, namely Collocation-Analyzed Multi-source Ensembled Land Evapotranspiration (CAMELE-0.25° and CAMELE-0.1°), ECMWF Reanalysis v5-Land (ERA5L), Global Land Data Assimilation System (GLDAS), Global Land Evaporation Amsterdam Model (GLEAM), MODIS Global Evapotranspiration Product (MOD16), FLUXCOM, and Penman-Monteith-Leuning Evapotranspiration Version 2 (PMLV2), in 133 catchments across China during1980-2016 using a multi-source input water balance method. To corroborate these findings, an independent evaluation was also conducted using observations from 32 flux stations in China. The results indicated that both assessment methods yielded consistent conclusions, i.e., all products overestimating monthly and annual ET. Among these, GLEAM and PMLV2 generally exhibited better performance. Their performance varied regionally, with higher accuracy in northern China and larger uncertainties in southern China. Additionally, the products showed significant differences in capturing long-term ET trends, particularly in spatial distribution of the trends. Among them, GLEAM demonstrated the highest accuracy in trend estimation. This study advances the understanding of land surface ET datasets and provides guidance for selecting regionally appropriate ET products across China, thereby supporting informed hydrological studies and decision-making application.}
}
@article{DU2026135876,
title = {External terrestrial moisture supplies still dominate the variations in precipitation over the greening Loess Plateau},
journal = {Journal of Hydrology},
volume = {677},
pages = {135876},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135876},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600973X},
author = {Jiahui Du and Ting Hua and Yuanzhu Zhang and Jiajie Xu},
keywords = {Precipitation, Moisture source, Interannual variability, Loess Plateau},
abstract = {Extensive greening in the Loess Plateau (LP) may have substantially altered the atmospheric water cycle. However, in this area characterized by limited precipitation with high interannual variability, it remains unclear on the role of local evapotranspiration and external terrestrial moisture supplies on the changes in precipitation, which hinders our understanding of local water security and future sustainable development. Therefore, using data from the Water Accounting Model-2layers moisture tracking model, this study analyzed the moisture sources of precipitation and their roles in the interannual variability of precipitation over the LP during 2001–2018. Our results show that precipitation in the LP predominately (69.32%) originates from external terrestrial moisture supplies, and the moisture contribution from the westerlies-dominated regions and Asian summer monsoon regions tend to peak during cold and warm seasons, respectively. Although climatologically the southeastern China (SE China, 18.94%), the Tibetan Plateau (TP, 14.12%), and the LP (9.51%) are major water source regions for precipitation over the LP, their relative roles in regulating the interannual variability are not ranked accordingly: in summer and autumn when most rainfall occurs, the relative contribution of SE China is positively correlated with precipitation variations (r = 0.25 and 0.13, respectively), whereas that of TP has significantly negative correlations (r = -0.57 and −0.46, respectively, both p < 0.1), suggesting that when precipitation increases, its moisture supplies come mainly from the south direction. Moreover, the local recycling ratio is negatively correlated with precipitation, further supporting that changes in precipitation are dominated by external terrestrial moisture supplies and not by changes in local evaporation. Our study offers a mechanism analysis on the atmospheric cycle of Loess Plateau under the implementation of massive ecological restoration projects, which still highlights the importance of large-scale atmospheric circulation for changes in water resources.}
}
@article{LIU2026135897,
title = {A spatial recursion framework for nonstationary flood frequency analysis considering river network dependence and reservoir routing},
journal = {Journal of Hydrology},
volume = {677},
pages = {135897},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135897},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009947},
author = {Chengkai Liu and Lihua Xiong and Yanlai Zhou and Jie Chen and Rongrong Li and Hua Chen},
keywords = {Nonstationary flood frequency analysis, Spatial recursion framework, River network dependence, Reservoir routing, Design flood estimate, Hanjiang River Basin},
abstract = {Flood frequency analysis (FFA) is critical for hydraulic design and flood risk management, yet the traditional stationarity assumption is increasingly challenged by climate change and intensive human activities. In large regulated basins, upstream reservoir operations substantially reshape downstream flood regimes. The controlled discharges propagate along the river network and interact with tributary inflows, thereby heightening the complexity of flood dynamics in downstream reaches. Most existing nonstationary flood frequency analysis (NFFA) methods are limited to single-site modeling and rarely provide a unified framework that simultaneously accounts for river network dependence and reservoir flood routing processes. To address this gap, this study proposes a spatial recursive framework for NFFA (SRF-NFFA) that explicitly incorporates river network dependence and reservoir flood routing within a probabilistic structure. The framework integrates GAMLSS-based marginal and conditional models, copula-based dependence structures, and physically based reservoir routing functions, recursively deriving nonstationary flood peak distributions from upstream source nodes to downstream recursive nodes. Nonstationary design floods are further estimated using the equivalent reliability method based on bias-corrected CMIP6 multi-model ensemble precipitation projections. The framework is applied to seven nodes in the Hanjiang River Basin (1964–2020), including three mega reservoirs and four gauging stations. Annual precipitation is introduced as a climatic covariate to characterize the impacts of climate change on flood peaks. Results show that, except for two upstream stations, flood peaks at all other regulated nodes exhibit significant nonstationary behavior. The application of SRF-NFFA in the Hanjiang River Basin confirms its effectiveness in flood frequency estimation across all nodes. In addition, nonstationary design floods are substantially reduced relative to stationary estimates, especially in downstream reaches. Compared with single-site covariate-based NFFA (SS-C-NFFA), although SS-C-NFFA achieves slightly lower fitting errors in conventional goodness-of-fit metrics, SRF-NFFA provides a more physically consistent representation of spatial flood dependence and reduces uncertainty in flood quantile estimates by leveraging reservoir routing processes and river network dependence for regional information sharing. Overall, SRF‑NFFA provides a reliable analytical tool for basin‑scale flood risk management in regulated river systems.}
}
@article{LEI2026135873,
title = {Assessing the impact of process simulation order in hydrological modeling},
journal = {Journal of Hydrology},
volume = {677},
pages = {135873},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135873},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009704},
author = {Xuxin Lei and Lei Cheng and Lu Zhang and Pan Liu},
keywords = {Hydrological modeling, Simulation order of sub-processes, Runoff-first scheme, Evaporation-first scheme},
abstract = {Catchments are highly dynamic and continuous geosystems, where runoff (Q) and evaporation (E) occur simultaneously. However, in most hydrological models, they are simulated sequentially. Given the empirical nature and uncertainties associated with these processes, the impacts of simulation order on modeling fidelity and accuracy may vary across catchments and models; this remains to be elucidated. This study investigated the effect of simulation order on hydrological modeling by setting runoff-first (RF) and evaporation-first (EF) schemes, applying the widely used GR4J and SIMHYD models. All models and schemes were tested in 2112 catchments worldwide with a wide range of climate and vegetation conditions. Results show that the mean global performance of hydrological modeling using RF and EF schemes are comparable, with ΔKGE of 0.01. But regional or catchment performance differences are clear and vary depending on the catchment attributes, with smaller differences observed in humid catchments (aridity index AI < 1) and larger differences observed in arid catchments (AI ≥ 1). Greater systematic differences of two schemes are observed in runoff dynamics, evaporation and runoff components, model parameters, and water storage changes. This study highlights that, the common sequential procedure of hydrological model is reliable for global runoff modeling, but maybe universally applicable to for specific catchments, especially arid ones. These findings are valuable in advancing our systematic understanding of natural hydrological processes and structural uncertainties inherent in models, refining regularization representations, and improving modeling accuracy.}
}
@article{ZHANG2026135889,
title = {Seasonal prior-guided temporal hypergraph network with predictive fidelity loss for soil moisture prediction},
journal = {Journal of Hydrology},
volume = {677},
pages = {135889},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135889},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009868},
author = {Chengyang Zhang and Ye Ding and Cankun Zhong},
keywords = {Soil moisture prediction, Hypergraph learning, Seasonal prior knowledge, Predictive fidelity loss},
abstract = {Accurate soil moisture prediction plays a critical role in precision agriculture, drought early warning, and sustainable water resource management; yet, it remains highly challenging due to strong nonlinearity, complex multi-scale temporal variations, and seasonally dependent driving mechanisms of soil moisture dynamics. Most existing data-driven deep learning models lack effective integration of hydrological domain priors, struggle to characterize multi-scale temporal dynamics, and rely exclusively on conventional point-wise loss functions. Such limitations frequently lead to inadequate capture of the authentic dynamic trends of soil moisture and physically inconsistent predictions. To address these challenges, we propose a novel framework for soil moisture prediction, which consists of a seasonal prior-guided temporal hypergraph network (SPTHN) and a dedicated predictive fidelity loss (PFL) for model training. Specifically, the SPTHN integrates two core components: a seasonal prior-based variable weighting module that dynamically adjusts the importance of meteorological inputs under seasonal constraints, where a seasonal constraint loss is adopted to ensure physically meaningful weight learning; and a temporal hierarchical hypergraph module to capture complex temporal patterns across different temporal granularities. To enable accurate prediction of both numerical values and dynamic morphological shapes of soil moisture sequences, the multi-objective PFL is proposed to guide the representation learning of the SPTHN. Extensive experiments on 10 FLUXNET sites demonstrate that our method significantly outperforms state-of-the-art baselines, achieving superior performance on both numerical accuracy metrics (MSE, RMSE, MAE) and shape-consistency metrics (DTW, TDI). These results confirm the effectiveness of the proposed method for reliable and physically consistent soil moisture forecasting.}
}
@article{YANG2026135923,
title = {Coupled nernst–planck–poisson modeling of early-stage near-field intrusion of highly concentrated landfill leachate},
journal = {Journal of Hydrology},
volume = {677},
pages = {135923},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135923},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010206},
author = {Ping Yang and Guofang Pan and Heng Dai and Jing Yang and Jianbiao Teng and Di Xia and Hong Fang and Wencheng Wu and Yaoming Su},
keywords = {Landfill leachate, Variable-density flow, Nernst–Planck–Poisson, Self-induced electric field, Water ion product},
abstract = {Municipal solid waste (MSW) landfills remain persistent sources of groundwater contamination. Predicting early-stage leachate intrusion is challenging because leachate behaves as a high-ionic-strength, variable-density electrolyte, for which conventional advection–dispersion models may overlook density-driven flow redistribution, electrochemical feedbacks, and pH-controlled charge carriers. Here we develop a one-dimensional near-field model that couples variable-density saturated flow with multicomponent ionic transport and a self-induced electric field based on the Nernst–Planck–Poisson Equation (NPPE), while enforcing the ion product of water to keep H+/OH− availability pH-consistent. Two leakage settings are considered, i.e., the free infiltration (FIS) and the hydraulically promoted infiltration (HPS), using a ten-case stepwise design that isolates the marginal effects of density coupling, electrochemical coupling, and prescribed-pH boundary variants. Model reliability is supported by layered numerical-consistency, conservation, and robustness diagnostics, with component-level benchmark support and supplementary numerical checks. Results show that variable-density coupling robustly amplifies intrusion intensity across species, whereas electrochemical coupling mainly redistributes species responses: dominant ions migrate more slowly, while low-abundance counterions advance more rapidly. Diffusion remains the principal flux component, with a smaller yet systematic field-driven contribution. Hydraulic promotion increases advective contributions and intensifies intrusion without changing coupling-specific ordering, and pH variations provide secondary modulation. The distinction between intensity amplification and species-selective reorganization provides a mechanistic basis for indicator selection in near-field monitoring and early warning of landfill leakage.}
}
@article{YANG2026135853,
title = {Reducing dependence on GRACE mascon datasets: bayesian‑TCH fusion for robust groundwater storage anomaly diagnoses in the U‑shaped meander region of the Yellow River basin},
journal = {Journal of Hydrology},
volume = {677},
pages = {135853},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135853},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009509},
author = {Zhirui Yang and Guohe Huang and Yongping Li and Ya Zhou and Feng Wang and Xiong Zhou and Yiting Wei and Xinyue Ren},
keywords = {Bayesian three‑cornered hat (Bayesian‑TCH), Groundwater storage anomalies (GWSA), U‑shaped meander region, Yellow river basin, GRACE mascon solutions, Climate variability},
abstract = {Groundwater storage changes in regions with scarce observations are increasingly being inferred from satellite gravimetry, but different institutional datasets can lead to inconsistent conclusions. Focusing on the U-shaped Meander Region of the Yellow River Basin, we examine the dependence of groundwater storage trends on the choice of satellite gravimetry datasets and implement a Bayesian three-cornered hat fusion strategy to obtain more robust groundwater storage anomaly (GWSA) estimates. This fusion strategy estimates institution-specific noise levels relative to a potential truth and uses them for Bayesian weighted fusion of the three GRACE-derived TWSA products. The results show that the five GWSA datasets give different conclusions about groundwater changes when trends are segmented around 2007. The GWSA dataset estimated using the Bayesian-TCH framework reduces regional mean uncertainty by about 50–80 % and raises the signal-to-noise ratio above 20 dB. The Bayesian-TCH time series shows a near steady declining trend before 2007 and, afterward, weakened seasonal coherence and a stronger role of human activities. This pattern is more consistent with independent understanding that the region is shifting from mainly climate driven variability to increasing impacts of sustained groundwater pumping and coal mining dewatering, whereas some GWSA datasets show stable recovery before the breakpoint and others still display climate dominated variability after the breakpoint.}
}
@article{ZHANG2026135849,
title = {Simulation of pollutant transport and identification of longitudinal dispersion coefficient in vegetated channels based on a vegetation-constrained physics-informed neural network},
journal = {Journal of Hydrology},
volume = {677},
pages = {135849},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135849},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009467},
author = {Jiao Zhang and Suyuan Zhong and Wen Wang and Zhanbin Li and Peng Li and Jieyu Liu and Mengjing Guo and Lu Jia and Mingjiang Deng},
abstract = {The longitudinal dispersion coefficient Dx is a key parameter in the advection–dispersion equation and directly influences the accuracy of pollutant-transport simulations in rivers. Empirical formulas currently used to predict Dx often yield widely varying results and lack general applicability, particularly under complex hydraulic conditions. In vegetated channels, aquatic vegetation produces pronounced lateral shear and heterogeneous velocity fields, which makes the prediction of Dx a challenging task. A vegetation-constrained physics-informed neural network (V-PINN) is developed to predict Dx by embedding a zonal vegetation model into the physical constraints of the learning process. Training on datasets covering multiple vegetation types and flow regimes enables V-PINN to capture vegetation-induced mixing processes and to predict Dx with Relative Error (RE) below 0.233 under sparse or missing data. The proposed V-PINN exhibits superior performance over both the traditional N-zone formula and the standard PINN in estimating Dx. The standard PINN achieves reliable prediction of Dx and prediction of pollutant transport in natural rivers. The predicted Dx is integrated into a two-dimensional PINN in natural rivers to simulate pollutant transport, with RE below 0.064, demonstrating improved alignment with measured data and enhanced applicability in real rivers. The standard PINN also achieves reliable prediction of Dx and pollutant transport in natural rivers. The proposed V-PINN framework provides physically consistent predictions across diverse vegetation conditions and demonstrates the potential of physics-informed deep learning as an accurate and interpretable extension of classical hydraulic theory for modeling vegetation–flow interactions.}
}
@article{LERAT2026135877,
title = {Flood frequency analysis combining observed streamflows with simulations from a continental hydrological model},
journal = {Journal of Hydrology},
volume = {677},
pages = {135877},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135877},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009741},
author = {Julien Lerat and Jai Vaze and Quan J. Wang},
keywords = {Flood frequency analysis, Copula, GEV, Australia, Continental landscape model, AWRA-L},
abstract = {Despite considerable effort to improve Flood Frequency Analysis (FFA) models, FFA remains a highly uncertain endeavour for sites with limited streamflow records. This paper introduces the Covariate-Based Flood Frequency Inference (CoFFI), in which a censored bivariate flood probability distribution is jointly fitted to two annual maxima series: one from a short available observation record and the other from a long simulation generated by a continental hydrological model. CoFFI combines two General Extreme Value (GEV) marginals and a Gumbel-Hougaard copula, with parameters estimated within a Bayesian inference scheme. In terms of predictive uncertainty, CoFFI applied to short record lengths between 10 and 25 years yields predictions as narrow as those of a standard univariate FFA model fitted to twice as many data points. Furthermore, CoFFI yields predictions with smaller discrepancies from long-term FFA curves than a univariate model, with the CoFFI discrepancy equivalent to that of a univariate model using 5 to 10 more years of data. These performance gains decrease for data records longer than 25 years and become negligible at 50 years. Finally, a simple criterion is proposed to anticipate CoFFI performance: the method is considered likely to outperform benchmark models when the Kendall-τ coefficient between observed and simulated annual maxima exceeds 0.4.}
}
@article{WANG2026135841,
title = {Spatial-heterogeneity-aware deep learning for water quality prediction: a case study in Hong Kong},
journal = {Journal of Hydrology},
volume = {677},
pages = {135841},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135841},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009388},
author = {Qiaoli Wang and Min Deng and Bingbing Zhao and Jiannan Cai},
keywords = {Water quality prediction, Spatial heterogeneity, Spatially adaptive regionalization, Deep learning, Explainable artificial intelligence},
abstract = {River water quality prediction aims to forecast future water quality conditions. However, most approaches construct prediction models across entire study areas, limiting the ability to reveal regional evolutionary trends. To address this issue, this study proposes a spatial-heterogeneity-aware prediction framework that can capture regional variations and key drivers of water quality. The method first identifies relatively homogeneous subregions using spatially adaptive regionalization and extracts subregion-specific key water quality parameters. Global and regional prediction models are then developed with four deep learning algorithms (long short-term memory (LSTM), temporal convolutional network (TCN), LSTM-TCN and transformer-based encoder-decoder). The optimal prediction model is identified by systematically evaluating performance with different sliding window lengths. SHapley Additive exPlanations (SHAP) analysis is used to interpret the contributions of input features to water quality predictions. A case study in Hong Kong demonstrates that regional models constructed in the identified four subregions (S1, S2, S3, and S4) consistently outperform the global models across all sliding windows. The optimal model is identified as a combination of four 6-month-window regional models: LSTM for S1, TCN for S2, LSTM for S3, and LSTM for S4. This combination achieves a 13.73% improvement in R2 and reductions of 31.19%, 33.98%, and 32.34% in RMSE, MAE, and MAPE compared with the global baseline. Moreover, the contributions of input features to prediction performance vary across subregions, highlighting spatially heterogeneous drivers of water quality. By incorporating spatial heterogeneity into water quality prediction, the proposed framework can provide valuable guidance for regional water quality management and early-warning systems.}
}
@article{XU2026135869,
title = {Transition pathways of compound heatwave-pluvial extremes in the Pearl River Basin},
journal = {Journal of Hydrology},
volume = {677},
pages = {135869},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135869},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009662},
author = {Yingying Xu and Zhiyong Liu and Yifan Huang and Chengshuai Liu and Caihong Hu},
keywords = {Compound heatwave-pluvial extremes, Dynamic thresholds, Multilayer Markov networks, Event transitions, Risk structure evolution, Pearl River Basin},
abstract = {As global warming intensifies, compound heatwave-pluvial extremes (CHPEs), defined by the concurrent or temporally connected occurrence of extreme heat and heavy precipitation, pose growing risks to regional hydrological systems. This study investigates CHPEs in the Pearl River Basin, a monsoon dominated region with complex hydroclimatic conditions. An integrated framework is developed that combines grid-based dynamic thresholds, hydroclimatic typology, and multilayer Markov networks to characterize the spatiotemporal evolution and transition dynamics of CHPEs. Results show that extreme temperature and precipitation thresholds exhibit strong spatial heterogeneity and seasonal variability across the basin, reflecting the nonlinear organization of coupled energy-moisture processes. From 1940 to 2024, basin-wide CHPE occurrences display substantial interannual variability but no persistent long-term trend. In contrast, their spatial distribution shows a clear pattern of coastal intensification and inland attenuation, suggesting differentiated regional responses linked to urban heat-island amplification and evolving monsoon moisture transport. Network-based transition analysis further reveals a shift in the structural configuration of CHPE risks, with diffusive precipitation regimes increasingly transitioning toward aggregation-intensification and explosive convective modes. Although transition probabilities vary with spatial scale, the dominant pathways remain robust across scales. These findings improve understanding of CHPE dynamics and support adaptive risk management in complex hydroclimatic regions.}
}
@article{SEIFI2026135865,
title = {Wavelet-Kalman-LSTM fusion: enhancing meteorological drought prediction with robust feature selection and uncertainty quantification},
journal = {Journal of Hydrology},
volume = {677},
pages = {135865},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135865},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009625},
author = {Akram Seifi and Mumtaz Ali and Hossien Riahi Madvar and Anwar Ali and Mohsin Khan},
keywords = {Droughts, Feature selection, Monte Carlo uncertainty analysis, SPI, Wavelet decomposition},
abstract = {Accurate drought forecasting is essential for minimizing socio-economic and environmental impacts but remains challenging due to climatic variability and complexity of droughts. This study presents the Wavelet-Kalman-LSTM (WKLSTM), a new hybrid deep learning framework that combines wavelet decomposition, Kalman filtering, and Long Short-Term Memory (LSTM), improving multi-timescale drought predictions (SPI3, SPI6, SPI9, SPI12) across various regions of Australia. The WKLSTM addresses non-stationarity by decomposing signals into hierarchical subseries using discrete wavelet transforms, denoising coefficients with Kalman filtering, and utilizing LSTM’s temporal modeling. Advanced feature selection techniques such as Boruta, SHAP (SHapley Additive exPlanations), and LASSO (Least Absolute Shrinkage and Selection Operator) are integrated with eXtreme Gradient Boosting (XGBoost) to identify critical lagged predictors. The WKLSTM model is assessed against both standalone and hybrid benchmark models, including LSTM, Feedforward Neural Networks (FNN), attention-based LSTM (attLSTM), Convolutional Neural Network combined with Bidirectional Gated Recurrent Unit (CNN-BiGRU), and WLSTM. The results show that the WKLSTM outperforms by achieving R2 values from 0.51 to 0.99 and lowered RMSE by 7% to 33% compared to benchmark models. Monte Carlo simulations quantify uncertainty with 95PPU bounds covering 50–81% of observations, indicating that although WKLSTM performs well across various regions and timescales, high predictive uncertainty persists due to the nonlinear and stochastic nature of droughts. The framework integrates noise reduction, dynamic feature selection, and probabilistic forecasting, enhancing drought prediction, aiding water resource management and climate resilience strategies. This study highlights the effectiveness of WKLSTM in addressing climatic non-linearity and offers practical insights into drought mitigation.}
}
@article{WU2026135857,
title = {Efficacy of evapotranspiration products on improving streamflow prediction in ungauged catchments under various hydrological models and climates},
journal = {Journal of Hydrology},
volume = {677},
pages = {135857},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135857},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009546},
author = {Shuyue Wu and Min Yan and Jianshi Zhao},
keywords = {Evapotranspiration integration, Streamflow prediction in ungauged catchments, Regionalisation, Model structure, Model calibration, Climatic controls},
abstract = {Evapotranspiration (ET) data have been increasingly utilized to enhance streamflow (Q) prediction accuracy in ungauged catchments, usually by integrating ET into model calibration and transferring parameters through regionalization. However, whether and how the effectiveness of ET integration for Q prediction in ungauged catchments depends on model structure and climatic conditions remains unclear. We evaluated two joint Q–ET calibration-regionalization schemes: (1) joint calibration using Q and the temporal dynamics of ET over the entire period, and (2) joint calibration using Q and the temporal dynamics of ET during rainless periods, combined with 10 conceptual hydrological models across 467 CAMELS catchments. Performances were compared with a Q-only benchmark, with parameter uncertainty quantified using the DREAMzs algorithm. Results indicated that models capable of reproducing ET temporal dynamics, typically those adopting linear or nonlinear ET–soil-moisture equations, were generally more likely to maintained Q performance after ET integration, with 67–85% of catchments showing no significant change or significant improvement. In contrast, models with inadequate ET representations experienced deterioration in approximately half of the catchments under full-period ET integration, whereas other structural components (e.g., snow and runoff representations) showed limited influence on the effectiveness of ET integration. The advantages of ET integration are concentrated in specific hydroclimatic regimes, particularly arid catchments with mild in-phase rainfall seasonality, where 50–80% of catchments exhibit significant Q performance improvement across various models. In these catchments, ET integration corrected the overestimation of ET and relative soil moisture storage state during winter to spring under Q-only calibration, improving runoff simulation. In other regions, the effects of ET integration are mixed, with improvements and degradations in Q performance occurring in comparable proportions. Overall, joint Q–ET calibration and regionalization for Q prediction in ungauged basins are climate- and structure-dependent rather than universally beneficial.}
}
@article{GUO2026135885,
title = {Genetic programming for modeling water-energy-environment coupled systems: taking the upper Yangtze River basin as an example},
journal = {Journal of Hydrology},
volume = {677},
pages = {135885},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135885},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009820},
author = {Jun Guo and Taixin Zhang and Chao Wang and Zhongzheng He and Yongqiang Wang and Jiahao Lu and Hui Qin},
keywords = {Water resource coupling system, System dynamics, Genetic programming, Data driven, Upper Yangtze River Basin, Influencing factors},
abstract = {Accurate modelling of complex water supply-power generation-environment (WPE) coupled systems remains a critical challenge in hydrological research, with existing methods facing trade-offs between accuracy, interpretability, and operability. This study proposes a genetic programming (GP)-based modelling approach for WPE-coupled systems, taking the Upper Yangtze River Basin as the study area and using 23 years (1998–2020) of hydrological and socio-economic data. For the first time, we systematically compared the performances of GP, system dynamics (SD), and 10 mainstream data-driven methods under identical small-sample conditions and conducted an ablation analysis to quantify the contributions of periodic and trend operators to the GP model performance. The results show that (1) The SD model exhibits excellent dynamic simulation capabilities (test RMSE = 17.87 for total basin water use, MAPE = 1.07%–19.03%) but requires extensive mechanistic expertise; (2) the proposed GP model achieves comparable accuracy to SD (test RMSE = 6.67–604.38, MAPE = 0.18%–11.09%) while avoiding complex mathematical derivations; (3) deep learning models suffer from severe overfitting under small-sample conditions (LSTM test RMSE up to 15750.97); and (4) the contributions of periodic and trend operators show significant variable specificity with no universal pattern. The GP method balances modelling accuracy and operability, providing a practical alternative for WPE system modelling in data-scarce regions and offering scientific guidance for method selection in watershed management applications.}
}
@article{SU2026135911,
title = {Hydrological controls on antibiotics and mixture risks in upland and lowland rivers: a dual-tracer study combining antibiotics and DOM optical properties},
journal = {Journal of Hydrology},
volume = {677},
pages = {135911},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135911},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010085},
author = {Zhaoxin Su and Shuangbing Huang and Fengchun Yang and Jiayi Li and Zhijie Wang and Junwei Zhao},
keywords = {Antibiotics, DOM, Dual-tracer framework, Hydrology, Land use, Mixture risk},
abstract = {Understanding how antibiotics behave in upland and lowland rivers draining mixed urban-agricultural catchments is essential for hydrology-driven water quality management. We investigated 48 antibiotics and Dissolved Organic Matter (DOM) optical properties at 49 sites along 12 rivers spanning upland headwaters influenced by urban land use and lowland reaches draining predominantly agricultural plains during dry (low-flow) and wet (high-flow) seasons. By combining antibiotic profiles with DOM fluorescence and absorbance indices, including PARAFAC components, we applied a dual-tracer framework that uses antibiotics together with DOM optical properties to interpret spatial and seasonal patterns under contrasting hydrological and land-use settings. Upland rivers subject to urban point sources showed pronounced dry-season antibiotic concentration peaks, consistent with wastewater-dominated inputs under limited dilution. In contrast, lowland rivers draining intensively cultivated areas exhibited the highest cumulative mixture‑level ecological risks, driven by cocktails of antibiotics transported from both urban and agricultural sources. Protein‑like DOM signals were associated with human-use antibiotics in urban‑influenced upland reaches, whereas humic-like components aligned with veterinary antibiotic dominance in agricultural lowlands, indicating stronger runoff contributions during wet conditions. Overall, our results show that flow regime and land use jointly control the redistribution of antibiotic concentrations and mixture risks across multiple rivers, and demonstrate the value of a dual-tracer approach that combines antibiotics with DOM optical properties to diagnose point- and diffuse-source contributions in mixed-use river catchments.}
}
@article{GUAN2026135868,
title = {Unraveling the rainfall-waterlogging propagation lag in urban systems: mechanisms, response patterns, and source tracking evidence},
journal = {Journal of Hydrology},
volume = {677},
pages = {135868},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135868},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009650},
author = {Baojun Guan and Jingming Hou and Donglai Li and Yanhong Wang and Xinxin Pan and Jiahao Lv and Chenchen Fan and Guangzhao Chen and Liping Ma and Tian Wang},
keywords = {Urban waterlogging, Rainfall-waterlogging propagation lag, Rainfall time-source tracking, Dynamic hydrological connectivity, Flood forecasting},
abstract = {Real-time forecasting of urban waterlogging is frequently hindered by the complex spatiotemporal mismatch between rainfall inputs and hydrological response, defined here as the Rainfall-Waterlogging Propagation Lag (RWPL). Although hydrodynamic modeling is widely employed, the physical mechanisms underlying the spatiotemporal heterogeneity of RWPL remain poorly understood, largely because conventional models lack the capability to track runoff sources and pathways. To bridge this gap, this study investigates the non-linear dynamics of RWPL using a high-performance coupled model (GAST-SWMM) integrated with a fully 1D-2D coupled Rainfall Time-Source Tracking (TST) module. Combining theoretical benchmarks established via idealized models with a case study of the Xi’an Moat Basin, we identified three distinct physical response patterns of urban waterlogging: (1) Topography-dominated pattern: characterized by a monotonic decrease in RWPL with increasing rainfall intensity, driven by the rapid concentration of overland flow waves. (2) Dynamic connectivity pattern: exhibiting a non-monotonic trend where RWPL initially increases then decreases with rainfall intensity. This reveals a fill-and-spill mechanism governed by explicit quantitative thresholds, where catchment expansion elongates flow paths and causes significant delays. (3) Pipe-buffering pattern: controlled by hydraulic blockage. The transition from free surface flow to pressurized pipe flow creates a buffering effect, decoupling surface inundation from rainfall peaks. Crucially, the coupled TST fingerprints provide robust quantitative evidence validating these mechanisms. These findings challenge the static catchment assumptions in traditional forecasting and provide a theoretical basis for a dynamic offline-online predictive framework, advancing the transition from rainfall monitoring to precise impact forecasting.}
}
@article{PATHAK2026135860,
title = {Effects of the spatial distribution of internal water storage on soil–plant hydraulic function},
journal = {Journal of Hydrology},
volume = {677},
pages = {135860},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135860},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009571},
author = {Vinod Shankar Pathak and Venkatraman Srinivasan},
keywords = {Plant internal water storage, Soil-plant-atmosphere continuum (SPAC), Root uptake, Drought resistance, Root and shoot storage, Hydraulic failure risk},
abstract = {Plant internal water storage buffers hydraulic disequilibrium between soil water supply and atmospheric demand, yet its contribution remains poorly quantified, especially in roots. Soil-plant-atmosphere continuum (SPAC) models commonly equate root uptake with basal sap flux, neglecting root storage and potentially biasing predictions of diurnal water fluxes and hydraulic stress. Here, we developed a coupled SPAC model that explicitly resolves water storage in root and shoot compartments. The model was evaluated under field atmospheric and soil moisture conditions to quantify the individual and combined roles of root and shoot storage in plant hydraulic function. Our results show that internal storage supplied 51% of early-day transpiration (35.5% shoot, 15.5% root), and removing either compartment reduced transpiration despite compensatory increases in the remaining storage use and root uptake. However, eliminating root and shoot storage individually increased cumulative hydraulic stress by up to 129% and 176%, respectively, relative to the full-storage baseline under critical water potential thresholds. A dry-down analysis showed that reliance on storage use increased by 37% under soil moisture limitation. These results suggest that internal storage is a key regulator of plant hydraulic function and drought stress mitigation. Models that neglect storage in roots or shoot underestimate drought resistance and overpredict hydraulic failure risk, limiting their ability to scale plant hydraulics to ecosystem processes.}
}
@article{ZHANG2026135907,
title = {137Cs and 210Pbex dating to assess sedimentation rates in terraced valley floor fields},
journal = {Journal of Hydrology},
volume = {677},
pages = {135907},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135907},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010048},
author = {Yunqi Zhang and Shucui Liu and Dan Li and Wei Li and Qingfang Tan and Yi Long and Guirong Hou and Ziteng Luo and Haiyan Yi and Yong Wang and Bo Tan},
keywords = {Terraced fields, Valley floor, Cs and Pb, Sedimentation rate},
abstract = {It is challenging to date sedimentation in a terraced field because of tillage disturbance, and previous studies have not investigated the sedimentation in terraced valley floor fields. Using 15 cores recovered from 5 representative terraced paddy fields in a typical valley floor in southwest China, we determined the sedimentation chronology using 137Cs and 210Pbex, calculated the sedimentation rate (SR), and assessed the spatiotemporal pattern of the SRs across the valley floor. The SRs range between 0.18 and 1.28 g cm−2 yr−1, with a mean of 0.65 g cm−2 yr−1. From a spatial perspective, the SRs are approximately constant from the upper to lower stream sections across the valley floor, due to field management and sediment interception in the different levels of terraced fields. Temporally, the SRs have generally increased over the past 100+ years, despite a subtle decreasing trend since the end of the 20th century, which reflect changes in human activity. The terraced valley floor impedes sediment loss while reducing sedimentation, indicating a contribution to soil conservation. We modeled reliable sedimentation chronologies for the terraced fields over the past 100+ years using an innovative approach, providing new insights into the spatiotemporal pattern of sedimentation in terraced fields across the valley floor. These findings enhance our understanding of the effect of terraced fields on hydrological process, which is critical for soil and water conservation, and sustainable agriculture.}
}
@article{LI2026135915,
title = {A prompt-conditioned multimodal framework for streamflow prediction with lightweight task adaptation},
journal = {Journal of Hydrology},
volume = {677},
pages = {135915},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135915},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010127},
author = {Xudong Li and Senchang Hu and Wenyi Zhang and Wuyou Xiao and Wenzhuo Shi and Jiaqi Ruan and Zhao Xu and Hao Wang},
keywords = {Streamflow prediction, Prompt conditioning, Multimodal fusion, Task adaptation, Large language model},
abstract = {Accurate streamflow prediction is pivotal for water resource management and disaster prevention. However, achieving high-accuracy streamflow prediction remains challenging due to the strong nonlinearity, non-stationarity, and multi-factor coupling of hydrological processes. This study proposes a prompt-conditioned multimodal framework for streamflow prediction with lightweight task adaptation of a frozen pre-trained Transformer backbone, providing a feasible framework for multimodal streamflow prediction. The proposed framework uses Generative Pre-trained Transformer 2 (GPT-2) as a frozen pre-trained backbone. Through trainable multimodal embedding layers and a prediction decoder, historical streamflow, meteorological forcing, statistical and static watershed attributes are mapped into a unified embedding space. Meanwhile, structured textual prompts are used to encode task instructions and static watershed descriptors as contextual conditioning information. Experiments in two sub-basins of the Yangtze River Basin show that the proposed model achieves better overall performance than the evaluated data-driven baselines, including CNN, LSTM, Transformer, and PatchTST, in multi-step forecasting tasks from 1 to 7 days ahead. Zero-shot within-region cross-basin validation between the two sub-basins suggests that the proposed framework can retain reasonable predictive skill without target-basin retraining, achieving an average NSE of 0.69 after updating the target-basin descriptors in the prompt. Ablation experiments suggest that prompt-carried basin/task contextual information and statistical features provide complementary conditioning and scale-related information for the normalized numerical embeddings. Overall, the proposed method provides a feasible prompt-conditioned multimodal framework for streamflow prediction and offers new insights into the development of hydrological models.}
}
@article{GHANAEI2026135903,
title = {A decentralized multi-agent framework for adaptive water allocation in river-reservoir systems},
journal = {Journal of Hydrology},
volume = {677},
pages = {135903},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135903},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010000},
author = {Hossein Ghanaei and Mahta Nazari and Amirreza Tadayon and Reza Kerachian},
keywords = {Adaptive Water Resources Management, Multi-agent Water Allocation, Decentralized Management, Distributed Constraint Optimization Problems (DCOP), Karkheh River Basin},
abstract = {Efficient surface water allocation in large river basins remains a significant challenge due to the presence of multiple stakeholders with conflicting objectives and limited coordination. Traditional centralized optimization approaches often fail to adequately represent stakeholder autonomy and are difficult to implement in practice. To address these limitations, this study proposes a decentralized, adaptive multi-agent water allocation model for river–reservoir systems, in which water users are explicitly represented as autonomous decision-making agents. The model introduces an adaptive and decentralized allocation framework that explicitly links long-term hydrological forecasting with constraint-based optimization and medium-term (one-year, monthly time-step) operating rules, thereby enabling dynamic water allocation under physical, operational, and environmental constraints. The allocation problem is formulated as a Distributed Constraint Optimization Problem (DCOP), allowing coordination without centralized control. Four DCOP algorithms—Maximum Gain Messaging (MGM), MGM2, Distributed Stochastic Algorithm (DSA), and Distributed Pseudo-tree Optimization Procedure (DPOP)—are evaluated based on allocation efficiency, cost deviation, and computational performance. An application to the Karkheh River Basin in Iran demonstrates that DPOP and DSA achieve allocation costs within 17.6% and 21.2% of the centralized benchmark, respectively, while simultaneously maintaining downstream water supply reliability, hydropower production targets, and environmental flow requirements. These results quantitatively confirm the model’s capability to balance efficiency, equity, and computational scalability, underscoring its suitability for real-world, decentralized water resources management.}
}
@article{PENG2026135935,
title = {Co-metabolic-like effects induced by eutrophication-intensified cyanobacterial blooms enhanced sediment carbon emissions in shallow lakes},
journal = {Journal of Hydrology},
volume = {677},
pages = {135935},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135935},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010322},
author = {Yu Peng and Weizheng Xie and Yaoqing Peng and Chuanqiao Zhou and Huazu Liu and Qiu Jin and Yiwen Zhou and Tsuyoshi Kinouchi and Hideyuki Doi and Xiaoguang Xu},
keywords = {Eutrophication, Floating algal index, Cyanobacterial-derived organic carbon, Co-metabolic-like effect, Greenhouse gas},
abstract = {Eutrophication‐intensified cyanobacterial blooms are increasingly recognized as significant contributors to carbon emissions from shallow lakes, yet the underlying mechanisms remain poorly understood. Here, we combined basin-scale field surveys, satellite-derived floating algae index (FAI), and microcosm incubations to evaluate the effects of cyanobacterial blooms on carbon emissions and sediment carbon loss in seven shallow lakes of the middle and lower Yangtze River Basin. FAI-based analyses showed severe and spatially extensive cyanobacterial blooms, with maximum bloom coverage reaching approximately 68.8% of the lake area in Taihu and nearly complete coverage in Dianshan, while bloom intensity correlated positively with trophic level. Field observations revealed that hypereutrophic lakes with higher total nitrogen (TN), total phosphorus (TP), and organic carbon (OC) concentrations in the overlying water and sediments exhibited strongly elevated CH4 and CO2 fluxes; specifically, CH4 emissions in Taihu (248.6 μg·m−2·min−1) exceeded those in the mesotrophic Lake Caizi (7.1 μg·m−2·min−1) by over an order of magnitude. Furthermore, microcosm experiments demonstrated that cyanobacterial-derived labile carbon enhances the decomposition of macrophyte detritus via co-metabolic-like effect interactions: mixed cyanobacteria–plant treatments resulted in up to approximately 100% and 125% increases in CH4 and CO2 production, respectively, while sediment TOC loss exceeded theoretical expectations. These findings highlight that bloom-driven co-metabolic-like effect is a critical mechanism for amplifying carbon emissions and destabilizing sediment carbon pools in eutrophic lakes, highlighting the necessity of incorporating bloom dynamics and multi-source carbon interactions into regional and global lake carbon budgets.}
}
@article{FENG2026135896,
title = {Intelligent mining of generation operation rules for cascade hydropower reservoirs driven by large language models and knowledge graphs},
journal = {Journal of Hydrology},
volume = {677},
pages = {135896},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135896},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009935},
author = {Zhong-kai Feng and Teng Lin and Wen-jing Niu and Yang Xiao and Tao Yang and Hongwu Tang},
keywords = {Knowledge graph, Large language model, Operation rules, Cascade hydropower reservoirs, Cooperation search algorithm},
abstract = {The rapid expansion of cascade hydropower reservoirs in China has introduced significant operational challenges, including high-dimensional parameter coordination, complex constraint coupling, and limited interpretability of traditional operation rules. To address these issues, this study proposes an intelligent framework for mining power generation operation rules by integrating a Large Language Model (LLM) and a Knowledge Graph (KG). The methodology involves three key steps: (1) Leveraging the LLM’s natural language processing capabilities to extract unstructured textual knowledge from reservoir operation literature, which is then structured and stored in a domain-specific KG; (2) Designing a KG-based model incorporating reservoir entities, temporal attributes, operational conditions, and decision actions to enable standardized and computable representation of rules; (3) Formulating an optimization model aimed at maximizing power generation while adhering to flood control and ecological constraints, solved using an enhanced Cooperation Search Algorithm (CSA). A case study of four reservoirs in the lower Jinsha River (Wudongde, Baihetan, Xiluodu, and Xiangjiaba) demonstrates that the proposed CSA outperforms classical algorithms in convergence and optimization efficiency under complex scenarios. The derived rules exhibit high applicability, practicality, and interpretability, supported by the extensible KG-driven knowledge base.}
}
@article{LIN2026135884,
title = {Tracing water use sources in rubber monoculture and rubber-Alpinia oxyphylla agroforestry systems using hydrogen and oxygen isotopes},
journal = {Journal of Hydrology},
volume = {677},
pages = {135884},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135884},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009819},
author = {Weiqing Lin and Bingsun Wu and Jingjing Wang and Yongyi Liang and Zixuan Wang and Zixun Chen and Xiaoyan Lin and Guitong Li and Huichun Ye and Ying Zhang and Jinlong Zhu},
keywords = {δD and δO, Rubber- agroforestry system, IsoSource model, MixSIAR model, Bayesian mixing model, Seasonal water uptake},
abstract = {Global climate change has exacerbated the imbalance between water supply and demand worldwide. Large-scale monoculture rubber (Hevea brasiliensis) plantations in tropical regions have profoundly affected regional hydrological processes and soil moisture dynamics. Rubber-Alpinia oxyphylla intercropping systems, have great potential in alleviating these negative effects, however, their water utilization strategies remain poorly understood. In this study, stable isotope compositions (δD and δ18O) of precipitation, soil water, and plant water were monitored in rubber monoculture (RM) and rubber–Alpinia oxyphylla agroforestry (RA) systems from 2021 to 2023. Water sources were first inferred using a direct inference approach, and IsoSource and MixSIAR models were applied to quantify seasonal water uptake patterns. Results showed that precipitation δD and δ18O values (−20.32 ± 18.13‰; −4.05 ± 2.35‰, n = 24) were relatively enriched during the dry season, whereas they were more depleted during the rainy season (−57.68 ± 24.24‰; −7.60 ± 3.18‰, n = 66). δD and δ18O values of atmospheric precipitation exhibited a clear linear relationship (δD = 8.01 δ18O + 5.54, R2 = 0.92). Soil water content (SWC) differed significantly among months, cropping systems, and soil depths (P < 0.001). Qualitative and quantitative analyses indicate that rubber trees primarily absorb shallow soil water during the rainy season, shifting to deeper soil layers in the dry season. In model comparisons, the IsoSource model provides higher accuracy in quantifying plant water sources than the MixSIAR model. Overall, the results provide insights into plant water-use strategies in rubber-based agroforestry systems and may contribute to the optimization of sustainable plantation management in tropical regions.}
}
@article{WANG2026135925,
title = {Moisture transport patterns over the Northeastern Tibetan Plateau revealed by tree-ring δ18O records},
journal = {Journal of Hydrology},
volume = {677},
pages = {135925},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135925},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601022X},
author = {Kai Wang and Xiaohua Gou and Takeshi Nakatsuka and Yiran Zhang and Jiangzhou Feng and Linlin Gao and Tao Wang and Yang Deng and Zhen Li and Kaixuan Yang and Xuan Li and Chongshan Wang and Zibo Wang and Dingcai Yin},
keywords = {Tree-ring, Stable oxygen isotope, The Qinghai Spruce, The northeastern margin of the Tibetan Plateau},
abstract = {Understanding moisture transport in monsoon–westerly transition zones is critical for interpreting hydroclimatic change in arid and semi-arid regions. The northeastern Tibetan Plateau lies at the boundary between monsoon- and westerly-dominated systems, yet the relative roles of different moisture sources remain debated. Here, we developed six tree-ring cellulose oxygen isotope (δ18Otree) chronologies spanning ∼100 years from Qinghai spruce along an east–west transect and analyzed their climatic signals using multivariate statistics and reanalysis data. The records show strong spatial structure and cluster into eastern, central, and western groups with distinct controls. Eastern, central, and western sites exhibit distinct δ18Otree patterns that are most consistent with differing hydroclimatic influences: southeastern monsoon-related moisture at the eastern sites, easterly transport associated with the Mongolian anticyclone at the central sites, and a stronger westerly influence with additional anticyclonic modulation at the western sites. Results suggest an eastward shift in the effective expression of monsoon influence and a westward expansion of easterly moisture transport over the past century, consistent with regional warming–wetting since the 1980 s. The multi-site δ18Otree network provides new proxy-based evidence for moisture-source dynamics in this transition zone.}
}
@article{LI2026135872,
title = {Hydrologically guided transfer learning for ungauged basin prediction: similarity-based adaptation and interpretation of runoff generation mechanisms},
journal = {Journal of Hydrology},
volume = {677},
pages = {135872},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135872},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009698},
author = {Jiyu Li and Qihua Ran and Sheng Ye},
keywords = {Predictions in ungauged basins, Transfer learning, Runoff prediction, Model interpretability},
abstract = {Runoff prediction in ungauged basins is still a fundamental challenge in hydrology. Transfer learning offers a promising framework to learn patterns from data-rich catchments to ungauged ones. However, its application is constrained by data distribution shift among catchments and limited interpretability due to the black-box nature. Here we propose a hydrologically guided transfer learning framework to improve both model performance and interpretability. A dual-stream deep learning model is pre-trained in 52 mountainous catchments in the Yangtze River Basin (YRB), and then transferred to eight target catchments in Zhejiang province. Hydrological guidance is implemented through feature-based alignment, critical layer identification and data-based fine-tuning to optimize model transfer. Our results show that Wasserstein distance provides an effective criterion to select feature transformations before model training, reducing computational cost. The hydrological similarity guided fine-tuning improves model performance and reduces data requirement. Furthermore, the derived feature importance metrics can be used as diagnostic signatures of runoff generation mechanisms. Saturation excess runoff can be characterized by sequential peaks in soil moisture and precipitation importance, while an early peak in precipitation importance indicates infiltration excess runoff. These findings demonstrate that incorporating hydrological understanding can guide transfer learning, improve model performance and enhance its physical plausibility, bridging the gap between data driven modeling and process based hydrological theories.}
}
@article{CHU2026135900,
title = {A novel framework for Identifying and predicting stratified land deformation: a case study of the Beijing Plain},
journal = {Journal of Hydrology},
volume = {677},
pages = {135900},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135900},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009972},
author = {Xiaoyu Chu and Beibei Chen and Ziyao Ma and Huili Gong and Chaofan Zhou and Xincheng Wang and Kunchao Lei and Haigang Wang},
keywords = {Land subsidence, Stratified deformation, InSAR, Clustering, Spike-Transformer model},
abstract = {Regional land subsidence research has advanced rapidly in recent decades, and integrating InSAR with machine learning has become an important research direction. However, InSAR-derived surface deformation reflects only total deformation and cannot resolve deformation within soil layers at different depths. To address this limitation, we propose a framework that integrates SAR data, stratified deformation ratios from extensometers, and hydrogeological information. By combining Persistent Scatterer Interferometric Synthetic Aperture Radar (PS-InSAR), K-Means clustering, and a Spike-Transformer model, the framework identifies characteristic subsidence zones, estimates stratified deformation, and predicts stratified deformation with high accuracy. Taking the Beijing Plain as a case study, land subsidence is mainly controlled by the second (25.8%) and third (69.79%) compressible layer groups, with maximum subsidence rates of 61 and 83 mm/yr, respectively. Vertically, owing to the spatial heterogeneity of factors such as groundwater-level changes and the lithologic composition of the compressible strata, the dominant subsidence layer varies across the plain: the third compressible layer group dominates in the northeastern plain (Zone 1) and southeastern plain (Zones 4–5), whereas the second compressible layer group dominates in the northwestern plain (Zone 2) and central plain (Zone 3). In addition, the zonal and stratified predictions of the Spike-Transformer model capture variations in deformation rates across different compressible layer groups, with a maximum RMSE of 3.12 mm and MAE of 2.47 mm. This framework provides a transferable approach for zone-specific and stratified management of land subsidence, with important implications for refined subsidence prevention and control.}
}
@article{CAMPOS2026135779,
title = {A remote sensing-based approach to suspended sediment estimation in rivers with scarce in situ data},
journal = {Journal of Hydrology},
volume = {677},
pages = {135779},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135779},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008760},
author = {Juliana Andrade Campos and Cintia Bertacchi Uvo and Thais Fujita and Luz Adriana Cuartas and Paulo Rógenes {Monteiro Pontes}},
keywords = {Sediment transport, Data scarcity, Artificial neural networks, Landsat, Sentinel-2},
abstract = {Monitoring suspended sediment concentration (SSC) is essential for water-quality management and for anticipating sediment-related impacts. Yet sparse in situ measurements limit tracking SSC at high temporal and spatial resolution. We address this gap with a scalable approach that couples multispectral imagery (Landsat-8/9, Sentinel-2), remote sensing precipitation product (CHIRPS), and soil properties product (SoilGrids) within artificial neural networks (ANNs) to estimate SSC in the Doce and Upper São Francisco River basins, Brazil. Data acquisition and preprocessing were performed in Google Earth Engine, and ANNs were trained in MATLAB and ported to GEE for pixel-wise mapping. We compiled 978 SSC observations from 41 gauging stations (rivers >30 m wide) to train and validate three model families: reflectance-only, precipitation/soil-only, and an integrated model. Reflectance-based ANNs best captured peaks and event-driven anomalies, including non-rainfall disturbances, while the precipitation/soil model produced stable daily estimates during cloudy periods, reproducing seasonal cycles. The integrated model reconciled both controls and achieved the best overall skill (R2 up to 0.84; MAE ≈ 18.7 mg L−1). The results show that precipitation, soil properties, and reflectance are complementary predictors that can be combined to deliver continuous, spatially explicit SSC information in data-scarce basins. The workflow is cost-effective, reproducible, and readily deployable for routine monitoring, post-event assessment, and planning of erosion control and reservoir siltation management.}
}
@article{KHODAEI2026135892,
title = {Assessing reservoir water quality using UAV-based multispectral and thermal imagery integrated with machine and deep learning approaches},
journal = {Journal of Hydrology},
volume = {677},
pages = {135892},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135892},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009893},
author = {Mohammad Sadegh Khodaei and Mohammad Reza Nikoo and Siamak Boudaghpour and Malik Al-Wardy},
keywords = {Unmanned aerial vehicle (UAV), Multispectral imagery, Thermal infrared imagery, Machine learning, Deep learning, Water quality},
abstract = {Monitoring water quality in reservoirs is critical for municipal water security and agricultural viability. UAV imagery has been widely applied to monitor the spatiotemporal variation of water quality parameters (WQPs) in many inland waters. However, its application over large, featureless aquatic environments has been constrained due to the inherent limitations of conventional photogrammetry in georeferencing imagery. Furthermore, although numerous studies have leveraged multispectral UAV imagery for WQP estimation, the potential of integrating UAV-acquired thermal infrared data to enhance predictive performance remains largely underexplored. In this regard, we adapted a framework for preprocessing and direct georeferencing of UAV imagery over the Wadi Dayqah reservoir, Oman’s largest dam. Six WQPs, namely chlorophyll-a (Chl-a), dissolved oxygen (DO), temperature, electrical conductivity (EC), turbidity, and oxidation–reduction potential (ORP), were estimated using four machine learning models (LR, SVR, RF, XGBoost) and three tabular deep learning algorithms (TabPFN, TabNet, FT-Transformer). Two scenarios were used to estimate WQPs. In the first, multispectral imagery was used, whereas in the second, multispectral data was combined with thermal infrared data. Results showed that TabPFN and TabNet outperformed machine learning algorithms. Additionally, incorporating thermal imagery enhanced the accuracy of WQP estimation, with the best improvements observed for temperature (TabPFN, from R2 = 0.93 to 0.99), DO (TabNet, from R2 = 0.71 to 0.79), and turbidity (TabPFN, from R2 = 0.83 to 0.90), whereas Chl-a estimation showed minor improvements.}
}
@article{CHEN2026135775,
title = {Evaluating the performance and biases of terrestrial evapotranspiration and its partitioning over China in CMIP6 models},
journal = {Journal of Hydrology},
volume = {677},
pages = {135775},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135775},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008723},
author = {Huiling Chen and Yongtai Zhu and Gaofeng Zhu and Kun Zhang and Shasha Shang and Jia Jia and Yang Zhang and Cong Xu and Shangtao Wang},
keywords = {ET partitioning, T/ET sensitivity to LAI, Vegetation dynamics, CMIP6 model biases, China},
abstract = {Terrestrial evapotranspiration (ET) and its components (Transpiration, T; Soil evaporation, Es; Canopy interception, Ec) play a crucial role in the land-climate interaction and climate system. There have been multiple state-of-the-art climate models that were included in Phase 6 of the Coupled Model Inter-comparison Project (CMIP6), but the performance in estimating the ET and its components of the models is still unclear, particularly in China. Here, we evaluate the performance of ET and how the partitioning of ET into three components; and investigate the impacts of vegetation dynamics and its sensitivity on ET partitioning. Our results show that spatial patterns of ET in most CMIP6 models are basically consistent with that in the mainstream ET products, but most CMIP6 models clearly overestimate ET compared with national-scale estimates and site-observations. Overall, the EC-Earth3-AerChem, KACE-1-0-G, and FIO-ESM-2-0 models perform well in simulating total ET, and the CMIP6 models ensemble mean showed generally better agreement. Moreover, a large discrepancy exists in the historical ET partitioning across CMIP6 models; even transpiration and soil evaporation account for 18 – 66% and 25 – 68% of national-mean ET across models, respectively. CMIP6 models underestimate the T/ET compared to the mainstream ET products (63.0 ± 6.1%) and site observations. Vegetation (that is leaf area index, LAI) plays a critical role in ET partitioning, and has strong correlations with all ET components in models. However, the mean annual LAI simulated by the CMIP6 model (1.79 ± 0.69 m2/m2) is about twice that observed by satellite (0.98 ± 0.06 m2/m2), revealing a significant overestimation and indicating that models fail to capture how strongly T/ET responds to changes in LAI (i.e., ∂(T/ET)/∂LAI). The ∂(T/ET)/∂LAI from CMIP6 models ranged from 0.01 – 0.18 per m2/m2, while the result calculated by the satellite observations was 0.19 ± 0.04 per m2/m2. The bias of ∂(T/ET)/∂LAI in models rises in tandem with the increase in LAI bias. To better represent the coupling between vegetation dynamics and the hydrological cycle, we suggest that the modeling community should promptly correct these biases, especially the LAI.}
}
@article{ELBAIDA2026135864,
title = {Calibrated uncertainty for continental design flood estimation using conformal probabilistic machine learning},
journal = {Journal of Hydrology},
volume = {677},
pages = {135864},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135864},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009613},
author = {Maelaynayn {El baida} and Mimoun Chourak and Farid Boushaba},
keywords = {Floods, Ungauged catchments, Regionalization, 100-year flood, Machine learning},
abstract = {Accurate 100-year design flood discharge (Q100) estimates are vital in engineering design of project components. Traditional flood regionalization methods offer limited accuracy at continental scales, while deterministic machine learning (ML) models lack properly calibrated uncertainty, which hinders their operational use for risk-informed design. This study evaluates four uncertainty-aware ML models, i.e., Natural Gradient Boosting (NGBoost), NGBoost with conformal calibration, Quantile Regression extreme gradient boosting (QR XGBoost), and Conformalized Quantile Regression Extreme Gradient Boosting (CQR XGBoost) to predict Q100 from available basin characteristics in ungauged African watersheds. Model training and evaluation included data from 821 gauged African stations. The results show that the ML models (R2 > 0.8) significantly outperform the traditional empirical power-law fit (R2 = 0.62). The CQR XGBoost model emerged as the optimal predictor, combining accuracy (R2 = 0.885) with robust uncertainty quantification (85.7% coverage). This work provides an uncertainty-aware calibrated ML framework for continental design flood prediction, and delivers practitioners a promising predictive framework and region-specific insights for infrastructure planning and engineering implementation for African unregulated or lightly regulated watersheds.}
}
@article{SZELES2026135859,
title = {Variability of discharge response from tile drains in a small agricultural catchment},
journal = {Journal of Hydrology},
volume = {677},
pages = {135859},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135859},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600956X},
author = {Borbala Szeles and Ladislav Holko and Juraj Parajka and Christine Stumpp and Michael Stockinger and Peter Strauss and Carmen Krammer and Thomas Weninger and Elmar Schmaltz and Matthias Konzett and Reinhard Hollerer and Patrick Hogan and Stefan Wyhlidal and Katharina Schott and Christin Müller and Kay Knöller and Günter Blöschl},
keywords = {Tile drains, Stable isotopes, Isotopic hydrograph separation, Experimental catchment, Agricultural catchment},
abstract = {Understanding the discharge response of tile drains is essential to better manage water resources in agricultural areas. The aim of this study was to compare two tile-drainage systems in an agricultural catchment, the Hydrological Open Air Laboratory in Austria in May-October, using six years of high-frequency hydrometric and isotopic observations, to determine whether new or old water contributes more to their discharge and whether new-water contributions correlate with hydrograph flashiness or time to peak flow. The results showed clear differences between the discharge responses and new water fractions of the two tile drainage systems. Sys4 inlet represented a perennial system with larger drainage area, larger pipes and simpler topology, that responded rapidly to even small amounts of rainfall. The response was mainly independent from the soil moisture state and the groundwater level. The second drainage system, Frau2 was an ephemeral system with smaller drainage area, smaller pipes and complex topology that exhibited the flashiest behavior. Larger discharge peaks at Frau2 occurred above a certain soil moisture (0.35 m3/m3) and groundwater level threshold (0.3 m below ground surface). Sys4 had the largest average peak flow new water fractions (0.54 with δ18O), higher than Frau2 (0.47) and the catchment outlet (0.41). The differences in the hydrometric and isotopic characteristics of the drains could be explained by differences in their construction properties. Discharge from the drainage system draining larger area and with simpler topology and pipes with larger diameter had faster response to rainfall and larger new water fractions.}
}
@article{CHENG2026135880,
title = {A stepwise precision improvement framework for urban lake hydrodynamic-water quality numerical models},
journal = {Journal of Hydrology},
volume = {677},
pages = {135880},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135880},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009777},
author = {Yue Cheng and Yiping Li and Haibin Yan and Yuxuan Zhou and Hongzhe Pan and Yu Cheng and Yang Hu and Chaomin Yang and Heyun Xin and Carlo Gualtieri},
keywords = {Urban lakes, Stepwise accuracy improvement, Model optimization framework, Data assimilation, Parameter uncertainty analysis},
abstract = {Accurate numerical simulation of hydrodynamics and water quality in urban lakes is fundamental for pollution control, ecological restoration, and evidence-based water management. However, achieving high simulation accuracy remains challenging due to strong anthropogenic regulation, complex boundary conditions, and unstable water quality responses. Based on an input-process-state layered optimization logic, this study proposes a diagnostic-informed and decision-oriented framework for urban lake hydrodynamic-water quality numerical modelling. Oriented by simulation error sources, the framework integrates six core optimization components- topographic data refinement, grid resolution optimization, boundary input optimization, initial condition configuration, parameter uncertainty analysis, and state-variable data assimilation. Unlike conventional calibration-oriented workflows, each component is first used to diagnose whether its associate uncertainty source significantly constrains model performance. The resulting diagnostic information is then translated into targeted modelling decisions and optimization actions. The proposed framework is applied to two typologically distinct urban lakes in the Yangtze River Basin, with contrasting hydrological regulation and pollution characteristics. Quantitative results demonstrated that the marginal effects of each component differ substantially. State-variable data assimilation provided the largest overall improvement, followed by parameter uncertainty analysis and boundary input optimization. Bathymetry refinement and grid optimization mainly improved physical consistency but contributed relatively limited gains to overall predictive accuracy. The effectiveness of data assimilation was strongly dependent on baseline model performance, with larger benefits observed for models exhibiting greater initial errors. By explicitly linking uncertainty diagnosis, modelling decisions, and optimization actions, the proposed framework provided a reproducible and decision-oriented paradigm for urban lake hydrodynamic-water quality modelling.}
}
@article{LI2026135856,
title = {Reconciling model simulated and GRACE observed groundwater storage changes in Africa through coordinated forward modelling},
journal = {Journal of Hydrology},
volume = {677},
pages = {135856},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135856},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009534},
author = {Huixiang Li and Zhiyong Huang and Qingquan Zhang and Chong Zhang and Yalin Ma and Jiawen Yang and Fanus Fourie and Yun Pan},
keywords = {GRACE, Land surface model, Groundwater storage change, Coordinated forward modelling, Africa},
abstract = {Large-scale groundwater storage (GWS) changes are commonly inferred from either global hydrological/land surface models or Gravity Recovery and Climate Experiment (GRACE) observations, but systematic discrepancies between these approaches remain a major source of uncertainty, particularly in data-scarce regions where ground-truth is not available. Here, we apply a coordinated forward modelling (CoFM) framework to reconcile GWS changes from GRACE observations and global model simulations, to provide observation-constrained and robust estimates in Africa. The Catchment Land Surface Model (CLSM)-GRACE reconciled GWS changes show consistent agreement with groundwater level records from 1,898 monitoring wells, with a regional mean correlation coefficient of 0.72 and positive correlations for 95% of the wells at grid scale, revealing an increasing trend of 1.47 ± 0.25 mm/yr over Africa during 2003–2020. The reconciling significantly improves GRACE’s ability in capturing GWS changes at finer scales, while reduces discrepancies among different model simulations. For example, despite of notable differences in simulated GWS trends of Congo basin from CLSM (−6.21 mm/yr) and WaterGAP Global Hydrological Model (0.21 mm/yr), the CoFM estimates (0.7 mm/yr and 2.7 mm/yr, respectively) remain comparable to Mascon solution (2.4 mm/yr). Thus, given the inherent limitations in GRACE resolution and model uncertainty, this study provides a new observation-constrained framework for robust GWS estimates at fine scales.}
}