@article{DUSEK2026136269,
title = {Effect tracking and flux tracking to quantify preferential flow responses at the hillslope scale},
journal = {Journal of Hydrology},
volume = {679},
pages = {136269},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136269},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013661},
author = {Jaromir Dusek and Tomas Vogel},
keywords = {Soil water flow, Virtual tracer, Stormflow, Dual-permeability model, Hydrograph separation, Event water contribution, Runoff response, Transit time distribution, Headwater catchment, Double paradox},
abstract = {Understanding runoff generation and water dynamics in hillslopes exhibiting preferential flow effects remains a persistent challenge in hydrology. In this study, we combined effect and flux tracking with a two-dimensional dual-continuum model to investigate hillslope runoff generation and water age composition in runoff components (stormflow and deep percolation), root water uptake, and hillslope soil water storage. The model, previously validated against observed discharge and isotope data, was used to simulate water flow and virtual tracer transport during a sequence of five rainfall–runoff events. Effect tracking showed that stormflow responded rapidly during large rainfall events through activation of preferential flow paths, whereas smaller events produced weaker and delayed responses. Hillslope storage exhibited pronounced soil moisture memory, with earlier events conditioning subsequent flow responses. Flux tracking indicated that stormflow was largely composed of pre-event water, with event water contributing both during the event itself and through remobilization in subsequent storms. Root water uptake accounted for a substantial fraction of event water loss, with sustained contributions over multiple events, whereas deep percolation showed the longest delays. Ensemble analysis indicated that approximately 60% of the cumulative stormflow response occurred within five days, whereas only about 40% of the event water recovered in stormflow was exported during the same period. This finding demonstrates a clear decoupling between rapid hydrological responses and much slower event water turnover, reflecting substantial subsurface storage and mixing. By combining effect and flux tracking at the hillslope scale, this study quantified process-specific hydrological memory and the remobilization of event water in stormflow, deep percolation, root water uptake, and soil water storage.}
}
@article{GAO2026136128,
title = {Analysis of cross-sectional solute concentration profiles from pulsed point sources in 3D steady flow},
journal = {Journal of Hydrology},
volume = {679},
pages = {136128},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136128},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012254},
author = {Ran Gao and Min Pang and Juncai Gao},
keywords = {3D steady aquatic environmental flow, Pulse point-source release model, Concentration moment analysis, Cross-sectional concentration distribution},
abstract = {Analytical characterization of cross-sectional solute concentration distributions remains limited for key theoretical models involving pulse point-source releases in three-dimensional aquatic environmental flow systems. This gap hinders the understanding of fundamental transport mechanisms by obscuring distributional divergences between source release scenarios, particularly the essential differences between pulse point- and area-sources. Addressing this, we develop an analytical framework for spatial solute distributions under steady 3D pulse point-source releases. Combining dispersion-diffusion theory with solutions of concentration moment equations, we derive a first-order approximate solution for cross-sectional concentration. This framework enables comparison of concentration distributions between pulse point source (high initial inhomogeneity) and pulse area-source (initial uniformity) releases at varied streamwise positions, quantified by a dimensionless discrepancy index r. The results demonstrate both the strong initial spatial non-uniformity of the solute and its release location significantly affect the resulting cross-sectional concentration distribution. Theoretically, directly applying classical area- source models to point-source pollution induces significant prediction errors in cross-sectional concentrations. Using a real pollution case study, we further examine parametric dependencies of concentration distributions and environmental risk mechanisms under point-source releases, highlighting the critical importance of water quality monitoring and emergency planning. This work establishes a theoretical foundation for analyzing pulse solute transport in complex 3D flows, advancing methodologies for pollution forecasting and wetland conservation.}
}
@article{SUGAHARA2026136241,
title = {Slope-weighted cost distance for modeling flood dynamics: a physics-informed random forest approach},
journal = {Journal of Hydrology},
volume = {679},
pages = {136241},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136241},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013387},
author = {Takumi Sugahara and Tatsuro Sato and Yasuhiro Mitani},
keywords = {Flood inundation forecasting, Real-time early warning, Slope-weighted cost distance, Physics-informed machine learning, Hydrograph feature-space sampling, SHapley Additive exPlanations},
abstract = {Rapid flood inundation forecasting is a crucial tool for disaster mitigation; however, physically-based models are computationally intensive, and conventional data-driven models often exhibit poor generalizability and limited interpretability. To address these deficiencies, we propose a novel physics-informed random forest framework that incorporates a slope-weighted cost-distance feature to represent spatiotemporal flood dynamics and validate the framework using data from the Kinugawa River Basin, Japan. By weighting the distance with the terrain gradient, this feature approximates gravity-driven flow paths, enabling the model to significantly outperform the static baselines (F1-score improvement from 0.507 to 0.893). To improve performance for hydrographs withheld from training but drawn from the predefined 31-scenario set, we introduced a hydrograph feature-space sampling strategy. The strategy selects representative training cases by clustering peak discharge and total volume; using only four training cases, it achieved an F1-score of 0.904 for the withheld scenarios. Furthermore, a SHAP (SHapley Additive exPlanations) analysis provided quantitative evidence that the model learned statistical relationships consistent with flow-path selection and volume-related flood expansion. The proposed framework offers a transparent and computationally efficient alternative to black-box deep learning models for real-time forecasting, while its reliability for hydrographs beyond the sampled discharge-volume and waveform range remains untested.}
}
@article{CAO2026136261,
title = {Hydraulic connectivity regulates the evaporation paradox and salinization in a semi-arid lake–groundwater system},
journal = {Journal of Hydrology},
volume = {679},
pages = {136261},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136261},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013582},
author = {Xu Cao and Jin Hur and Xiangzhen Kong and Xiao Zhang and Chen Du and Bin Xue and Bing Yi and Yutao Guo and Xian-ge Wang and Wei He},
keywords = {Hydraulic connectivity, Evaporation, Lake–groundwater system, Hydrochemical evolution, Lacustrine groundwater discharge},
abstract = {Hydraulic connectivity dynamically regulates water and solute exchange in lake–groundwater systems, but its role in shaping hydrochemical evolution under strong evaporative forcing remains poorly constrained. Here, we integrate hydrochemical analysis and dynamic isotope mass-balance modeling to quantify wet-season lake–groundwater interactions and clarify their hydrochemical consequences in a semi-arid tectonic lake. Lake water preferentially recharges aquifers with high hydraulic connectivity (HHC: 21.65% ± 10.15%) over low connectivity aquifers (LHC: 9.47% ± 4.06%, p < 0.01). In contrast, groundwater contributions from HHC back to the lake (16.09% ± 0.03%) are significantly lower than those from LHC (21.29% ± 0.04%, p < 0.01). At the whole-lake scale, the dominant interaction pattern is lacustrine groundwater discharge, as indicated by a positive flux of 7.22 × 106 m3 d−1. Notably, although water stable isotopes indicate stronger evaporative enrichment in HHC groundwater, HHC groundwater exhibits significantly higher dissolved oxygen and lower mineralization than LHC (p < 0.01), indicating limited solute accumulation. This connectivity-regulated evaporation paradox suggests that frequent hydrological cycling under high hydraulic connectivity can limit salinization despite strong evaporative forcing. More importantly, lake–groundwater interactions influence hydrochemical evolution indirectly by regulating hydrochemical conditions, which subsequently constrain major ion accumulation. These findings demonstrate that hydraulic connectivity can decouple evaporative enrichment from salinization and strongly regulate divergent hydrochemical evolution pathways in lake–groundwater systems.}
}
@article{ZHANG2026136229,
title = {Flood-generating mechanism attribution across U.S. catchments: the role of soil-layer depth and framework sensitivity},
journal = {Journal of Hydrology},
volume = {679},
pages = {136229},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136229},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013260},
author = {Bin Zhang and Nergui Nanding and Huan Wu and Zhijun Huang and Yan Yan and Weitian Chen},
keywords = {Flood‑generating mechanisms, Soil-moisture excess, Soil-layer depth, Attribution frameworks, Hydrometeorological drivers},
abstract = {Floods arise from diverse hydroclimatic drivers, yet flood-mechanism attribution often relies on a single diagnostic framework and simplified representations of catchment storage, leaving cross-framework consistency and the role of antecedent-storage representation poorly understood. Here, we compare three diagnostically distinct attribution frameworks, including circular statistics, rule-based classification, and interpretable machine learning, across 542 minimally regulated catchments in the conterminous United States using a consistent flood-event sampling strategy, hydrometeorological datasets, and a common set of mechanism categories. We further evaluate how soil-layer depth representation influences attribution of Soil-moisture Excess (SE) floods. Across all three frameworks, SE emerges as the dominant flood-generating mechanism, contributing 33–35% of total mechanism importance, and prevailing across much of the southeastern United States. Long-rainfall (LR) also contributes substantially, whereas Snowmelt (SM) and Rain-on-snow (RS) remain concentrated primarily in mountainous and high-latitude regions. Despite this broad consistency, substantial cross-framework divergence exists in inferred magnitudes of mechanism importance. Circular statistics produces highly concentrated “all-or-nothing” attributions, rule-based classification assigns comparatively stronger RS contributions, and machine learning identifies consistently larger Short-rainfall (SR) contributions through conditional predictive relationships. Attribution results also show strong sensitivity to soil-layer representation. Deepening the soil column reduces SE importance in rule-based process classification and machine learning frameworks, whereas circular statistics shows a non-monotonic response associated with seasonal timing alignment and attribution-solver sensitivity. These findings demonstrate that flood-mechanism attribution is inherently framework dependent and sensitive to antecedent-storage representation, with important implications for flood-frequency analysis, flood-risk assessment, and climate-change attribution of flood events.}
}
@article{HAN2026136268,
title = {Interaction between dispersive soil and liquid water: From temperature-ponding driven water-salt dynamics to water content-mediated microstructural evolution},
journal = {Journal of Hydrology},
volume = {679},
pages = {136268},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136268},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601365X},
author = {Yan Han and Zhixi Jin and Zhaoyang Han and Qing Wang and Jiaqi Wang},
keywords = {Dispersive soil, Water-salt transport, Evaporation, Surface ponding, Microstructure},
abstract = {Dispersive soils in saline-alkali regions exhibit low permeability but high slaking potential, threatening infrastructure via water-induced erosion. Coupled water-salt transport under climatic forcing and linked microstructural evolution remain unclear, hindered by missing targeted evaluation tools and weak macro–micro linkages. Here, soil column seepage tests were conducted under two typical rainy-season temperatures and four ponding levels simulating graded rainfall, paired with multiscale microstructural characterization across a wide initial volumetric water content (VWC) range. A customized four-aspect quantitative evaluation framework was established for dispersive soil water-salt dynamics, tracking infiltration rate dynamics, quantifying water-salt trend alignment, characterizing salinity stepwise variation, and resolving solute diffusion lag. The method overcomes the inherent limitation of classical transport paradigms in capturing staged, asynchronous migration unique to dispersive soils. Results show temperature and ponding jointly induce three macroscopic regimes, namely dynamic equilibrium, surface sealing, and cracking, all governed by VWC spatiotemporal distribution. Analyses using the framework reveal pronounced water-salt asynchrony mechanistically linked to VWC-mediated pore water phase transition and salt dissolution-precipitation. Higher temperatures accelerate overall water-salt transport but intensify their decoupling. Larger ponding boosts initial infiltration yet promotes progressive pore clogging, with such effects attenuating significantly at greater depths. Microscopically, increasing VWC drives a linear transition from an open honeycomb to a flocculated fabric, with decreasing porosity and increasing fractal dimension. Critically, low initial VWC triggers rapid aggregate slaking and ultrafine clay dispersion, whose pore-clogging effect directly explains the infiltration suppression and salinity stagnation revealed by the quantitative tool. This work establishes VWC as the pivotal state variable bridging external thermal–hydraulic conditions to internal microstructural evolution. The integrated methodology provides a feasible perspective for dispersive soil hazard prediction and prevention via initial VWC design.}
}
@article{ZHAO2026136289,
title = {Synergy between lacustrine groundwater discharge and dissolved organic matter in regulating seasonal CH4 and CO2 emissions in an ice–covered lake–groundwater system},
journal = {Journal of Hydrology},
volume = {679},
pages = {136289},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136289},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013867},
author = {Yuanzhen Zhao and Lijuan Hu and Shen Qu and Heyang Sun and Chengcheng Xia and Chao Gu and Xu Yang and Zhongli Wang and Limin Duan and Xiaomin Liu and Ruihong Yu},
keywords = {Lacustrine groundwater discharge, CH and CO emissions, Dissolved organic matter, Ice-free and ice-covered periods, Ice-covered lake-groundwater system},
abstract = {Lakes in cold regions that experience seasonal ice cover are potential hotspots of greenhouse gas (GHG) emissions. However, the synergistic roles of groundwater, as a concealed external source, and dissolved organic matter (DOM) in regulating CH4 and CO2 dynamics and emissions remain poorly understood. Based on year–round observations at Ulansuhai Lake, this study revealed seasonal differences in the regulatory effects of lacustrine groundwater discharge (LGD) and microbially derived DOM. During the ice–free period, the LGD rate was low (5.53 mm/d). CO2 dynamics were primarily controlled by microbial decomposition of DOM, whereas CH4 dynamics were mainly influenced by direct LGD input and were positively correlated with DOM aromaticity and humification. During the ice–covered period, the LGD rate increased markedly, reaching a maximum of 18.09 mm/d, and became the sole external source of CO2. In contrast, CH4 was predominantly regulated by DOM, driven positively by humic component C2 and the humification index (HIX), a process facilitated by anaerobic microbial fermentation. Flux calculations indicated that, during the ice–free period, water–air emissions of both gases exceeded the corresponding LGD–derived inputs. However, when considering only the LGD pathway, its regulatory effect was stronger for CH4 than for CO2. During ice cover, water–air gas exchange ceased, while LGD–derived CO2 inputs (0.049–1.720 mmol/m2/d), together with CH4 produced via DOM–driven anaerobic fermentation, sustained greenhouse gas accumulation beneath the ice. These findings identify LGD as a concealed driver of CH4 and CO2 emissions with seasonal shifting roles and highlight its importance in carbon budget assessments of seasonally ice–covered lakes in cold regions. This study advances understanding of groundwater–derived carbon inputs in lake carbon cycling and provides both hydrological and biogeochemical insights for compiling greenhouse gas emission inventories from seasonally ice–covered lakes.}
}
@article{ZHANG2026136273,
title = {Integrating scale-matched spatial scales into water scarcity risk screening in China},
journal = {Journal of Hydrology},
volume = {679},
pages = {136273},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136273},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013703},
author = {Jiayu Zhang and Dedi Liu and Jiabo Yin and Feng Yue and Jiaoyang Wang and Zhenyu Mu and Hanxu Liang and Zhilin Niu and Zhengbo Peng},
keywords = {Scale matching, Water scarcity risk screening, Multi-scale modeling},
abstract = {Effective water scarcity assessment is frequently challenged by spatial mismatches between fine-resolution hydrologic water supply and administratively aggregated water-use statistics, which can obscure spatial heterogeneity and reduce the interpretability of results for planning. To address this spatial mismatch, a scale-matched framework is proposed for water scarcity risk screening by coupling multi-scale water demand simulation with runoff-derived renewable potential supply. Water demand is simulated by spatially explicit variables via a cellular automata (CA) model to produce gridded water demand at three scales: 1 km × 1 km scale, the appropriate spatial scale, and prefecture scale. Runoff-derived renewable potential supply is derived as runoff depth multiplied by a regionally specified water resources exploitation ratio, and this potential is also expressed as gridded fields at the three scales. Water scarcity risk screening indicators are then computed on these scale-matched grids and subsequently aggregated into basin and administrative units. The resulting scale-matched water scarcity risk signals are quantified by three complementary indicators—deficit ratio, temporal reliability, and non-deficit fraction, which characterize the mismatch magnitude, the long-horizon stability, and the spatial prevalence of non-water scarcity conditions, respectively. Results indicate that screening signals are systematically altered across the three different scales: the 1 km × 1 km scale reveals fragmented high-pressure clusters, the appropriate spatial scale retains coherent regional patterns while preserving meaningful sub-unit contrasts, and prefecture-scale aggregation yields smoother signals but can mask localized risk pockets. Persistently screened hotspots are concentrated in demand-intensive corridors such as the North China Plain and in arid inland systems in the Northwest, with strengthened screening signals toward end-century conditions in parts of the Northwest and the Southwest. Overall, a reproducible, scale-consistent screening tool designed to support spatial prioritization, basin–administrative coordination, and targeted planning diagnostics.}
}
@article{ZHANG2026136281,
title = {Reshaping of the active layer by retrogressive thaw slump in permafrost regions: coupled soil structural, hydrological, and thermal responses based on high-resolution in situ observations},
journal = {Journal of Hydrology},
volume = {679},
pages = {136281},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136281},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013788},
author = {Zhongyang Zhang and Yibo Wang and Yingpu Liu and Yiran Tang and Hu Tao and Xinyu Chang and Zhanchao Hai and Zeyong Gao},
keywords = {Retrogressive thaw slump, Permafrost degradation, Active layer, Tibetan Plateau, Micro-mechanism},
abstract = {Retrogressive thaw slumps (RTS) are typical thermokarst landforms in permafrost regions. Their development substantially reshapes the structure and functions of the active layer, thereby influencing the stability of the underlying permafrost. By integrating in situ monitoring of a representative RTS on the Qinghai-Tibet Plateau with computed tomography (CT) scanning and hydrothermal observations, this study investigates the mechanisms through which RTS modulate soil structure, hydraulic properties, and thermal processes within the active layer. The results indicated that RTS development was associated with an overall decline in soil structural quality (36.8%), soil water storage capacity (11.5%), and soil thermal stability (19.3%). These changes were more pronounced in deep soil layers compared to shallow horizons. Furthermore, the reshaping of the active layer by RTS followed a progressive sequence: initial thermal enhancements triggered structural responses, which were subsequently amplified by hydrological feedbacks. During the active stage (headwall), heat exchange between the active layer and the external environment intensified substantially. This was accompanied by significant increases in soil thermal conductivity and thermal diffusivity, whereas volumetric heat capacity decreased markedly (P < 0.05). These thermo-physical alterations intensified freeze–thaw cycling and concurrently reduced soil shear strength. A distinct shift in mechanisms emerged during the stable stage (the collapse area). Macroporosity and the number of isolated pores increased sharply in the deep soil, while both water storage capacity and saturated water content decreased significantly (P < 0.05). Moreover, the thermal properties of the deep soil in the collapse area were significantly enhanced (P < 0.05). This condition accelerated downward heat transfer to the permafrost and contributed to sustained thermal disturbance. Ultimately, this study elucidates the micro-structural mechanisms underlying active layer reshaping by thaw slumps and offers new insights into the evolution of thermokarst landscapes.}
}
@article{HUAN2026136265,
title = {Beyond proportional training set selection in data-driven models: A novel two side distributional decomposition method for urban flood prediction},
journal = {Journal of Hydrology},
volume = {679},
pages = {136265},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136265},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013624},
author = {Songhua Huan},
keywords = {Data-driven model, Urban flood prediction, Urban drainage water level, Decomposition method, Cyber-physical-artificial intelligence (CPS-AI)},
abstract = {Data-driven models have emerged as promising solutions for urban flood prevention. However, the training set selection adopted in most model designs primarily relies on fixed proportion, bringing additional uncertainty for accuracy. In this study, a Two Side Distributional Decomposition (TSDD) is proposed for non-proportional training set selection in urban flood prediction. Experimental results based on urban drainage water level data show that: (1) TSDD achieves better performance across four models including tree-based (RF), recurrent-based (LSTM), convolution-based (CNN), and attention-based (Transformer) data-driven models when integrated with six decomposition methods (EMD, SEMD, VMD, SVMD, STL, SSTL) under diverse experimental settings. The average R2 across all urban drainage stations reaches 0.928. Specifically, the average R2 for lower, middle, and upper reaches are 0.969, 0.859, and 0.956, respectively. (2) TSDD exhibits good abilities in processing high-frequency flood data. Flood data sampled at 2-minutes frequency yields better accuracy in most stations with an average R2 of 0.933, compared to an average R2 of 0.929 for 10-minutes frequency. (3) TSDD enables higher accuracy with fewer data resources. It may deliver good performance using a smaller number of labeled training samples instead of traditional proportional selection like 80%. This study may enhance a multi-rules training set selection in urban flood data-driven model development, and provide a novel training sample screening approach to achieve high-accuracy prediction under small-sample data conditions.}
}
@article{ADYASARI2026136233,
title = {Rapid hydrologic flushing and biogeochemical recovery after Hurricane Helene in a heterogeneous coastal karst system},
journal = {Journal of Hydrology},
volume = {679},
pages = {136233},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136233},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013302},
author = {Dini Adyasari and Xiaolang Zhang and Adelide Rianda and Karl Kaiser and Bohyun Yeo},
keywords = {Coastal groundwater, Spring, River, Hurricane, Nutrients, Major ions, Karst, Gulf coast},
abstract = {Extreme storms can substantially alter hydrologic and biogeochemical processes in coastal systems, yet the coupled responses of surface water and groundwater, particularly within karst terrains, remain poorly understood. This study integrated continuous United States Geological Survey (USGS) monitoring with multi-compartment water sampling conducted between October 2024 and May 2025 to evaluate coastal system responses to Hurricane Helene, which made landfall along Florida’s Big Bend coast in September 2024. The regional karstic Upper Floridan Aquifer (UFA), together with the connected Wakulla Spring–Wakulla River system, responded rapidly to the hurricane, with river, spring, and groundwater stages increasing to approximately 3, 1.5, and 1.1 times their respective baseflow levels within hours of landfall. USGS monitoring records indicate that the Wakulla River, Wakulla Spring, and regional UFA system returned to near-baseflow conditions within approximately 14 days, 23 days, and 3 months after landfall, respectively. These recovery trends were further supported by stable water isotope signatures and nutrient dynamics. River and spring conductivity time series and major ion patterns suggest minimal storm-surge-driven salinization throughout the study area. In contrast, shallow porous groundwater responses varied among hydrogeologic compartments. Sites located closest to the river exhibited recovery trajectories similar to those of surface waters, likely reflecting stronger hydrologic connectivity. More isolated shallow groundwater systems showed slower and more variable biogeochemical recovery, with ammonia and phosphate concentrations continuing to increase more than eight months after the hurricane, indicating prolonged biogeochemical processing within coastal sediments. Overall, the regional karstic system recovered more rapidly than many previously reported storm-affected coastal systems, likely due to the high transmissivity of the karst conduit network and the rapid inland progression of Hurricane Helene. The contrasting responses among hydrologic compartments demonstrate that conduit-dominated aquifers can rapidly flush storm-derived waters while still sustaining localized and persistent biogeochemical disturbances within shallow coastal sediments. These findings further suggest that future hydrologic and reactive transport models should incorporate multiple groundwater endmembers and vertical aquifer heterogeneity to better predict water quality responses to increasingly frequent extreme events.}
}
@article{AFZAL2026136205,
title = {Projected depletion of high mountain Asia glaciers by 2100: linking mass loss to asynchronous peak runoff},
journal = {Journal of Hydrology},
volume = {679},
pages = {136205},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136205},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013028},
author = {Muhammad Mannan Afzal and Fuming Xie and Yu Zhu and Adeel Ahmad Nadeem and Fazli Hameed and Yi Luo and Tandong Yao and Fubao Sun and Xin Wang and Qiao Liu and Jyoti Karki and Jun Zhou and Shiyin Liu},
keywords = {High Mountain Asia (HMA), Glacier runoff, Peak water, Glacier mass balance, Glacier classification, Cryosphere-hydrology interactions},
abstract = {Glacierized-catchment runoff (GR) across High Mountain Asia (HMA) is approaching peak water, but the timing is not uniform. Glacier size, elevation, and regional climate push that threshold to different points in time, with direct implications for downstream water security. We used OGGM v1.6.1, forced by bias-corrected GSWP3-W5E5 historical data and an ensemble of 13 CMIP6 GCMs under 4 SSP scenarios, to simulate glacier mass balance, dynamics, and glacierized-catchment runoff across 17 major HMA basins from 1940 to 2100. By 2100, HMA-wide glacier mass declines by 70.7 ± 9.6%, relative to 2000 levels, and total GR falls by 10 ± 6.5% between the early (2001–2020) and late (2081–2100) century periods. Small, low-elevation glaciers have already passed peak runoff in many basins, some before 2020, and are losing volume rapidly. Large, high-elevation glaciers continue buffering downstream flows well into the late 21st century, with basin-wide peaks as late as 2058 in Tarim and 2064 in the Amu Darya, and individual large high-elevation glacier classes peaking as late as 2083 in Tarim under high-emission scenarios. We identify three distinct peak-GR regimes: early, transitional, and delayed, driven by the size and elevation composition of glacier classes within each basin, rather than average glacier behavior. Basin-averaged projections may obscure important class-specific runoff transitions, underscoring the need for class-resolved, basin-specific water resource planning across HMA.}
}
@article{NIKTA2026136257,
title = {Lagged global relationships between teleconnection indices and hydrological drought: a continental-scale analysis using ERA5-Land runoff data},
journal = {Journal of Hydrology},
volume = {679},
pages = {136257},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136257},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013545},
author = {Mohammad Mahdi Nikta and Ahmad Sharafati and Alireza Hadian and Siyamak Doroudi and Reza Farzad and Yusef Kheyruri and Zaher Mundher Yaseen},
keywords = {Hydrological drought, Teleconnection indices, Standardized runoff index, Lagged response, Global scale},
abstract = {Climate change and rising global temperature have made investigating drought and its characteristics more important than ever. This study investigates the relationships between hydrological drought and teleconnection indices by comparing the Pearson correlation coefficient between the Standardized Runoff Index (SRI) and five teleconnection indices at lags of 0 to 12 months globally, using runoff data from 1980 to 2024. This data was obtained from the ERA5-Land dataset with a spatial resolution of 9 km. In order to find the best lag for each teleconnection index, average correlation for each index was calculated both globally and for each continent. Additionally, the leading teleconnection index for each region was calculated by identifying the optimal lag for each index on each continent and using it to determine the index with the strongest correlation with SRI for each region. Furthermore, regions on the map where each teleconnection index at its best lag in each continent had meaningful correlations with SRI were identified. Moreover, probability densities of the correlations at the overall best lag for all teleconnection indices in each continent were investigated. Subsequently, the behavior of each pair of teleconnection indices compared to each other at a 1-month lag was analyzed. Results indicated that optimal lags at the continental scale are generally shorter than those at the global scale, and strong correlations between teleconnection indices and SRI are observed in many regions at these lags. Therefore, selecting the appropriate teleconnection index with its optimal lag can help identify early signs of hydrological drought and support proactive water resource management.}
}
@article{WANG2026136225,
title = {A synergetic framework for land-atmosphere coupling-based remote sensing inversion of evapotranspiration, surface resistance, and aerodynamic resistance},
journal = {Journal of Hydrology},
volume = {679},
pages = {136225},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136225},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013223},
author = {Xiaowei Wang and Yazhen Jiang and Huanyu Zhang and Yitao Li and Menglin Si and Yunsheng Lou and Zhao-Liang Li},
keywords = {Evapotranspiration, Aerodynamic resistance, Surface resistance, Coupling factor, Land-atmosphere interaction},
abstract = {Evapotranspiration (ET) is a key link in land–atmosphere interactions, governing the coupled exchange of water and energy. However, conventional remote sensing-based ET estimation methods generally parameterize aerodynamic resistance (rae) and surface resistance (rs) independently, which may limit the representation of their interplay and overlook the scale mismatch between them. To address this limitation, we propose a remote sensing-based ET coupling estimation framework (hereafter referred to as the ETC framework). Grounded in the intrinsic physics of surface energy balance, the ETC framework enables the simultaneous estimation of global ET, rae, and rs, with the land–atmosphere coupling coefficient (Ω) clarifying their coupling relationships. The reliability of the inverted resistance parameters was evaluated at 195 globally distributed flux sites. The inverted rs agrees well with PM-derived values, with an R2 of 0.56 and an RMSE of 73.86 s/m. Sensible heat flux estimated based on the inverted rae shows strong agreement with observations, with an R2 of 0.84 and an RMSE of 42.57 W/m2. The proposed ETC framework also demonstrates high accuracy in ET estimation: (1) at the half-hour scale, the mean absolute error (MAE), root mean square error (RMSE), and R2 for ET estimates are 26.52 W/m2, 42.86 W/m2, and 0.88, respectively. The ETC framework also consistently outperforms the conventional PM baseline in reproducing measured ET; (2) at the monthly scale, ETC achieves higher accuracy than ERA5-Land, GLEAM, and TerraClimate products; (3) at the spatial scale, the global ET estimates show strong consistency with the three ET products. Consequently, by overcoming the critical limitations associated with independently parameterized resistances and neglected scale mismatches in conventional ET retrieval, the ETC framework enables the first synergetic, accurate estimation of ET, rae, and rs under physically constrained conditions across site-to-global scales. This achievement is expected to significantly advance the quantification of ET and the resistances.}
}
@article{PRAKASH2026136277,
title = {Locally relevant streamflow reanalysis using ensemble data assimilation and a gauge-based adaptive localization scheme},
journal = {Journal of Hydrology},
volume = {679},
pages = {136277},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136277},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013740},
author = {Ved Prakash and Manabendra Saharia},
keywords = {Hydrologic extreme, Localization, LEnKF, Data assimilation, ILDAS},
abstract = {Accurate, high-resolution streamflow estimates are crucial for effective water management, flood risk assessment, and mitigation planning. However, predicting streamflow using integrated hydrologic-hydrodynamic models remains challenging due to model errors and uncertainties in initial conditions. This study presents a novel streamflow Data Assimilation (DA) framework that combines Ensemble Kalman Filter (EnKF) with two key innovations: a gauge-based covariance localization derived from historical tuning aligned with a dense river network and targeted covariance inflation at gauge stations. The DA framework is implemented within a modeling chain comprising the Noah-MP land surface model and a vector-based streamflow routing model, MizuRoute, covering 553,312 river reaches across the Indian subcontinent. Results show that the assimilation framework significantly improves streamflow simulations, increasing the median Kling-Gupta Efficiency (KGE) by 0.22 and the median KGE skill score by 0.15 across both gauged and ungauged stations at the daily scale. The DA also enhances key hydrological signatures and exhibits strong performance during peak flow conditions. Notably, during peak flow events, the median probability of detection (POD) increases from 0.22 to 0.39 at gauged and from 0.16 to 0.29 at ungauged stations. The model demonstrates greater improvement in smaller catchments, which are more susceptible to flash floods. Furthermore, the mean peak flow and timing error for correctly predicted (“hit”) events are reduced by over 9% and over 1.5 days, respectively. This first-of-its-kind study in the Indian subcontinent on streamflow DA using a large-scale hydrologic-hydrodynamic model at a daily time scale offers a robust foundation for enhancing flood forecasting systems and informing sustainable water resource management under changing climate scenarios.}
}
@article{WANG2026136249,
title = {Spatio-Temporal Evolution Analysis of Flood-Chain Disasters for Water Diversion Project Safety},
journal = {Journal of Hydrology},
volume = {679},
pages = {136249},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136249},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013466},
author = {Lihu Wang and Xuemei Liu and Hairui Li and Xiaonan Chen and Libo Yang},
keywords = {Flood-chain disasters, Cognitive intelligence, Representation-enhanced large models, Knowledge graphs, Water diversion project safety},
abstract = {Water diversion projects are highly coupled complex systems, and under the combined influence of extreme rainfall and complex operating conditions, flood disasters exhibit pronounced chain propagation effects, posing significant challenges to disaster prevention and control. This study integrates large models with knowledge graphs to analyze the spatio-temporal evolution patterns of flood-chain disasters. Based on multiscale decomposition and reconstruction, a representation-enhanced large model is developed to enhance the capability to analyze non-stationary data, enabling trend prediction and anomaly detection for rainfall and runoff. The coupling characteristics of different disaster events are quantified to construct a disaster knowledge graph that characterizes the chain propagation of extreme rainfall, abnormal runoff, and engineering accidents. Multi-chain coupled disaster reasoning techniques are studied to integrate features from different disaster chains, revealing the impact of flood-chain disasters on engineering safety during their spatio-temporal evolution. The proposed method was validated using 4,814,708 rainfall and runoff observations and 6853 inspection records. The results show that the proposed method outperforms in trend prediction and accident recognition, with mean MAE and F1 scores of 174.5 and 0.751, respectively. Flood disaster chains exhibit superimposition, diffusion, and asymmetry, with abnormal station levels and engineering accident levels showing temporal correlations and spatial clustering characteristics. This study accomplished the spatio-temporal analysis of flood-chain disasters, expanding the technical framework for disaster research in water diversion projects and providing support for safety early warning.}
}
@article{WU2026136284,
title = {Reactive transport processes in unsaturated porous media: inclusion of capillary geochemistry},
journal = {Journal of Hydrology},
volume = {679},
pages = {136284},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136284},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013818},
author = {Shao-Jie Wu and Andrey P. Jivkov and Majid Sedighi},
keywords = {Thermodynamic modelling, Multiphase flow, Mineral reactions, Stretched porewater, CO sequestration},
abstract = {Reactive transport in unsaturated porous media is governed by coupled hydro-geochemical processes, where capillary water exists under negative pressure. Conventional reactive transport models assume that geochemical reactions in such systems behave identically to those in bulk water, i.e., they neglect the thermodynamic effects of capillary conditions. Porewater in unsaturated media, however, is often in a stretched state, which alters its thermodynamic properties and influences the mineral-water-gas interactions. Developed in this work is a hydro-geochemical reactive transport model that explicitly incorporates capillary geochemistry by extending the thermodynamic description of water, aqueous species, gases, and minerals into the negative pressure domain. The formulation is based on classical thermodynamics and implemented in OpenFOAM within a coupled multiphase flow and transport framework. The model is verified against thermodynamic databases and validated using laboratory-scale experiments and is further applied to field-scale CO2 injection. The results show that capillary influences geochemical behaviour primarily through pressure-dependent changes in molar volumes, which modify reaction Gibbs free energy and shift equilibrium constants. In contrast, the impact on activity coefficients is comparatively minor. Simulations demonstrate that stretched porewater enhances CO2 dissolution, promotes mineral reactions, and alters the evolution of porosity and permeability in unsaturated regions. At the field scale, these effects lead to enhanced near-well mineral precipitation, with implications for injectivity. Neglecting capillary geochemistry can therefore result in systematic errors in predicting reactive transport processes in geological CO2 storage systems. The work provides a physically consistent framework for linking capillary-dependent geochemistry with continuum theory in unsaturated porous media and highlights the importance of accounting for capillary geochemistry in geoenvironmental applications.}
}
@article{FANG2026136276,
title = {Photovoltaic panel arrays reshape soil erosion patterns and hydrodynamic processes on hillslopes},
journal = {Journal of Hydrology},
volume = {679},
pages = {136276},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136276},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013739},
author = {Nufang Fang and Rui Fan and Yue Du and Yi Zeng},
keywords = {Photovoltaic panel, Soil erosion, Hydrodynamic characteristics, Rainfall simulation},
abstract = {Solar photovoltaic (PV) installations on hillslopes alter rainfall redistribution and create spatially heterogeneous erosion patterns, yet the underlying hydraulic mechanisms remain poorly quantified. Using simulated rainfall experiments, this study evaluated the effects of PV panel installation height (0.4, 0.6, 0.8 m), tilt angle (30°, 35°, 40°), and arrangement type (linear, block) on runoff, sediment yield, hydraulic parameters, and rill morphology across 18 configurations. PV coverage reduced cumulative sediment yield by up to 56.6%, yet spatially disaggregated measurements revealed localized erosion intensification beneath panel drip lines. Transverse rills perpendicular to the slope formed exclusively beneath drip lines in all configurations, with spacing largely controlled by panel geometry rather than by hydraulic self-organization. Installation height was the dominant variable, as lower heights (0.4 m) maximized slope-scale sediment reduction (46.3%) through rainfall interception, whereas higher heights (0.8 m) intensified drip-line erosion through greater impact energy. Flow velocity, Reynolds number, shear stress, and stream power all amplified stepwise across successive covered zones, confirming a progressive downslope intensification of erosive force. Targeted drip-line mitigation with turf mats and gravel strips reduced localized sediment yield by 74% and 32% relative to untreated PV slopes. This study identifies a geometrically forced erosion regime beneath PV arrays and provides a hydrodynamic basis for erosion-resilient siting and design of hillslope solar installations.}
}
@article{ZHAO2026136299,
title = {Generating a consistent long-term L-band soil moisture record through Bayesian merging of SMOS and SMAP data},
journal = {Journal of Hydrology},
volume = {679},
pages = {136299},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136299},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601396X},
author = {Aoxing Zhao and Zushuai Wei and Linjie Guan and Beibei Yang and Jianxin Zhang and Bingsong Zhang and Tianjie Zhao and Lingkui Meng},
keywords = {Soil moisture, Bayesian merging, Long term, SMAP, SMOS},
abstract = {L-band passive microwave remote sensing provides an indispensable tool for large-scale, long-term soil moisture monitoring. However, systematic biases arising from divergent sensor configurations, observational strategies, and retrieval algorithms across satellite missions—notably SMOS and SMAP—constrain the synergistic use of these vital datasets. Furthermore, the limited spatiotemporal sampling of any single satellite impedes applications requiring dense observational coverage. To address these challenges, this study establishes the SMAP soil moisture product as a reference dataset and develops a Bayesian framework to harmonize the SMOS record. Our methodology integrates SMOS L-band brightness temperature with MERRA-2 soil temperature data to generate a SMAP-consistent, long-term soil moisture dataset (SMOS_Reg) spanning 2010–2024. Validation analyses reveal good agreement between the corrected SMOS_Reg product and the SMAP reference at a global scale (2015–2022), with an ubRMSE of 0.033 m3/m3, a CC of 0.769, and a Bias of −0.002 m3/m3. Independent validation against ISMN ground measurements further confirms that SMOS_Reg achieves an accuracy (ubRMSE = 0.053 m3/m3, CC = 0.662) on par with the SMAP product (ubRMSE = 0.055 m3/m3, CC = 0.695), notably with a lower bias (0.013 m3/m3 vs. 0.028 m3/m3). Leveraging the orbital synergies between SMOS and SMAP, we developed a merged SMAP-SMOS_Reg product that significantly improves observational frequency, increasing the mean annual number of effective observation days by 61. This dataset may provide valuable support for future long-term applications in climate research, hydrological modeling, and drought assessment.}
}
@article{QU2026136221,
title = {Isotope-informed assessment of groundwater nitrate attenuation and N2O-related risk in contrasting river-network lowlands},
journal = {Journal of Hydrology},
volume = {679},
pages = {136221},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136221},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013181},
author = {Shenhao Qu and Dongli She and Weilian Chen and Junhan Zhao and Li Zhang and Peng Chen and Yongchun Pan and Yongqiu Xia},
keywords = {River-network lowlands, Drainage connectivity, Groundwater denitrification, Stable water isotopes, Nitrate removal efficiency, EF5g},
abstract = {Shallow aquifers in agricultural river-network lowlands receive sustained diffuse nitrate inputs. Drainage connectivity and hydraulic regulation continually reorganize groundwater recharge, mixing, and redox conditions. Consequently, nitrate attenuation and associated nitrous oxide (N2O) risk vary markedly across space and time, yet their coupled patterns remain poorly constrained. We integrated stable water isotopes (δ2H–H2O, δ18O–H2O), line-conditioned excess (lc-excess), excess N2 (eN2), dissolved N2O (dN2O), nitrate removal efficiency (RE), and an EF5g-based groundwater N2O risk indicator (EF5g). We compared the engineered, pump-regulated Changshu polder with the naturally connected Haining ditch-corridor system. Their nearly non-overlapping monitoring periods covered broadly comparable seasonal hydro-meteorological gradients and were treated as a type-based comparison. Groundwater in both systems largely retained meteoric recharge signatures. Changshu showed stronger month-to-month shifts and greater among-well dispersion in lc-excess, whereas Haining remained comparatively stable after early fluctuations. eN2 varied relatively smoothly, with a pronounced summer minimum in Changshu and broader increases during late summer–autumn in Haining. In contrast, dN2O showed sharper fluctuations and stronger upper-tail behavior, particularly in Haining. Lower RE and elevated EF5g partially overlapped during the warm season in Changshu, while Haining exhibited greater among-well heterogeneity and more persistent high-end EF5g observations. Central EF5g values in both systems remained below the Intergovernmental Panel on Climate Change 2006 default of 0.0025, but maxima reached 0.0037 in Changshu and 0.0039 in Haining. Partial least squares regression explained substantial RE variability (Qcum2 = 0.685 and 0.543, respectively) and identified NO3–-N, dissolved oxygen, and electrical conductivity as the leading predictors in both systems. The greater contribution of lc-excess in the engineered Changshu polder highlighted the value of isotope-recorded recharge, exchange, and mixing histories under frequently reorganized hydrological states. EF5g was poorly predicted by the same monthly variables, indicating greater sensitivity to fine-scale redox heterogeneity and transient N2O production–reduction imbalances. This integrated framework supports process-based assessment of groundwater nitrate attenuation and N2O risk in river-network lowlands.}
}
@article{FAROOQ2026136240,
title = {Spatiotemporal variation and occurrence of microplastics in two interconnected lakes of Himalayan region polluted by landfill leachate and laundries},
journal = {Journal of Hydrology},
volume = {679},
pages = {136240},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136240},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013375},
author = {Asif Farooq and Manzoor Ahamad Ahanger and Khalid Muzamil Gani},
keywords = {Himalayan lakes, MSW landfill leachate, Spatiotemporal variations, Microplastics, Multimeric risk assessment, Laundry wastewater},
abstract = {This study investigates the occurrence, spatiotemporal variation and ecological risks of microplastic contamination in the interconnected Himalayan freshwater lakes over a period of two years (2023–2024). These lakes were directly polluted by understudied point sources such as untreated municipal solid waste (MSW) landfill leachate and wastewater discharges from commercial and traditional laundries. Microscopy, FT-IR spectroscopy and SEM/EDS were used to determine microplastic abundance, size distribution, polymer composition and surface morphology. The results showed spatiotemporal variations with upstream sites decreasing from 82,222 ± 28,958 MPs/m3 in summer 2023 to 63,444 ± 19,777 MPs/m3 in winter 2024, while as downstream sites increased from 21000 ± 11737 MPs/m3 in winter 2023 to 44,333 ± 10,456 MPs/m3 in summer 2024. Fibers were the most dominant morphology (94.93 %), with size distribution mainly in the range of (<75 µm–4 µm) at 36 %. Estimated daily releases of microplastics from untreated MSW landfill leachate was recorded with 2.24×106MPsday-1 (MPD) in 2023 and 6.30×106 MPsday-1 (MPD) in 2024. Uncommon polymers such as PTFE and CR were detected in downstream region, confirming landfill origin contamination. Risk assessment indicated an overall Pollution Load Index (PLI) of 3.2 (hazard category I, low risk), Polymer Hazard Index (PHI) of 21.34 (hazard category II, medium risk) and Potential Ecological Risk Index (PERI) values between 4185 ± 6724 and 8796 ± 13,952 (extreme danger risk category). Chronic Daily Intake (CDI) and Incremental Lifetime Cancer Risk (ILCR) exposure assessments show higher exposure and cancer risk for children than adults. Our study provides evidence that untreated landfill leachate and laundry effluents intensify microplastic pollution and ecological risks in the interconnected freshwater systems.}
}
@article{RONG2026136292,
title = {TS-PINN: a dual-branch physics-informed neural network based on two-source theory for evapotranspiration estimation},
journal = {Journal of Hydrology},
volume = {679},
pages = {136292},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136292},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013892},
author = {Xing Rong and Chunlin Huang and Feinan Xu and Jinliang Hou and Peng Dou and Ying Zhang and Qiang Bie and Tianwen Feng and Zhihua Zhang},
keywords = {Evapotranspiration, Surface energy fluxes, Two-source energy balance, Physics-informed neural network, Flux partitioning},
abstract = {Accurate estimation of surface energy fluxes and evapotranspiration (ET) is essential for understanding land–atmosphere interactions. While data-driven methods efficiently fit observations, their “black-box” nature makes it challenging to guarantee physical interpretability and reliable extrapolation from instantaneous to daily ET. To address these limitations, we propose the Two-Source Physics-Informed Neural Network (TS-PINN), driven by both physical structure and physical constraints. The model constructs a vegetation–soil dual-branch architecture structurally aligned with the Two-Source Energy Balance (TSEB) theory, embedding partitioning mechanisms as structural inductive biases. For optimization, we design a multi-constraint physical loss that integrates instantaneous energy balance, component energy balance, the Priestley–Taylor (P–T) upper bound, and daily-scale consistency. We also adopt an adaptive weighting strategy to balance data fitting and physical consistency. Validation against eddy covariance (EC) data in the Heihe River Basin (HRB) (2015–2021 growing seasons) shows that TS-PINN significantly outperforms Random Forest (RF) and Deep Neural Network (DNN) baselines. Its root mean square error (RMSE) values are 31.22 W/m2 for sensible heat flux (H) and 44.03 W/m2 for latent heat flux (LE), with corresponding coefficients of determination (R2) of 0.79 and 0.85, respectively. Ablation experiments reveal that the structural inductive bias enhances component-level representation, while the physical loss terms effectively constrain prediction boundaries. Specifically, the instantaneous energy balance constraint dominates H prediction accuracy, and the P–T constraint guides LE estimation. Daily ET converted from LE also presents good consistency with observations, with a Kling-Gupta Efficiency (KGE) of 0.88 and an R2 of 0.81. Overall, TS-PINN offers a novel, accurate, and physically interpretable approach for simulating surface energy fluxes and ET.}
}
@article{MCJANNET2026136151,
title = {Modelling a decade of daily open water evaporation for existing and planned water storages: A spatially explicit analysis for the Pilbara region of north-western Australia},
journal = {Journal of Hydrology},
volume = {679},
pages = {136151},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136151},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012485},
author = {David L. McJannet and Stephen B. Stewart and Dejun Cai and Thomas G. {Van Niel} and Tim R. McVicar and Steven D. Boxall},
keywords = {Open water evaporation, Interpolation, Modelling, Meteorological data, Pilbara},
abstract = {We present a method that integrates physically based evaporation modelling approaches with high-resolution meteorological data interpolated from land-based observations to estimate daily open water evaporation at local and regional scales across the data-sparse Pilbara region of north-western Australia. The evaporation modelling approach considers water body heat storage and enables water bodies of different sizes, depth and salinity to be modelled. Daily meteorological data were interpolated at 0.01° resolution for the 440,000 km2 Pilbara region based on the best performing model from up to 14 thin plate spline models per meteorological variable, which used varying combinations of latitude and longitude, elevation and a coastal distance index as spatial predictors. Using the interpolated meteorological data, the evaporation model was run across the study region (at a daily time step with 0.01° spatial resolution) for all combinations of water body size and salinity. Comparison of model results with measurements for three different sized water bodies yielded R2 > 0.64 and an RMSE of < 1.6 mm d−1 giving confidence in results. Reference water body evaporation was high across the focus area and ranged between 2272 and 2965 mm y−1. We showed that the spatio-temporal open water evaporation model can be used to estimate evaporation for both existing and proposed water bodies. To simplify model application to different waterbody characteristics we developed an evaporation scaling factor which was used to scale model results from a reference water body (surface area of 1 km2, salinity of 10 mS cm−1 and depth of 10 m) to any water body with surface area between 0.01 and 5 km2 and salinity between 0 and 300 mS cm−1. The method developed provides the first daily-scale open water evaporation estimates across the Pilbara region and can be applied to other locations where open water evaporation estimates are required for water resource management by using spatially interpolated meteorological grids and/or reanalysis products.}
}
@article{WEN2026136224,
title = {Ecological water replenishment improves water quality and environmental capacity in a tributary of the Yellow River: insights from MIKE 21 coupled modeling},
journal = {Journal of Hydrology},
volume = {679},
pages = {136224},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136224},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013211},
author = {Yihao Wen and Junzheng Liu and Haijue Xu and Jinliang Zhang and Yuchuan Bai and Yao Wang},
keywords = {Ecological water replenishment, Yellow River Basin, Hydrodynamic-water quality modeling, Water environmental capacity, Pollutant dynamics},
abstract = {Water quality deterioration in seasonally water-scarce rivers poses a persistent challenge to water-quality and water-resource management. Ecological water replenishment (EWR) is increasingly used as a hydrological regulation measure, but quantitative evidence remains limited regarding how alternative EWR scenarios affect modeled water quality and water environmental capacity. This study developed a coupled hydrodynamic–water quality model based on MIKE 21 for the Yi River — a key tributary of the Yellow River Basin — to quantify the simulated spatiotemporal responses of six water quality parameters and reach-scale water environmental capacity to prescribed EWR scenarios. Six scenarios were simulated, comprising three non-replenishment scenarios (wet, normal, and dry hydrological years) and three replenishment strategies (varying discharge intensity and duration) applied under the critical dry-year hydrodynamic condition with a prescribed Class IV in-channel baseline and Class II replenishment inflow. The model demonstrated acceptable performance across six water quality parameters (DO, BOD5, CODMn, COD, NH3-N, and TP), with Nash–Sutcliffe efficiency coefficients ≥ 0.777 and maximum MAPE of 13.76%. Non-replenishment simulations revealed that pollutant concentrations were consistently highest in the upstream reach and most severe during the dry year, when upstream COD and NH3-N were classified as Class IV in some months. Under this setting, high-discharge, short-duration replenishment (2Q, T/2) produced the greatest modeled water-quality improvement among the tested equal-volume constant-discharge scenarios, reducing the comprehensive pollution index from 0.726 to 0.360 and achieving a 227.33% increase in downstream DO (from 3.0 mg/L, Class IV, to 9.82 mg/L, Class II) and a 91.17% reduction in BOD5 (from 6.0 mg/L, Class IV, to 0.53 mg/L, Class II). Under the adopted Class III target and reach-scale capacity formulation, the modeled total water environmental capacity after EWR was 33.6% higher than that before EWR, with the largest absolute increase estimated for CODMn. These findings provide a quantitative framework for comparing water-quality-oriented EWR scenarios and identifying pollution-control priorities during low-flow periods.}
}
@article{LIU2026136232,
title = {Modeling of hydrological performance degradation in permeable pavement systems induced by their spatiotemporal clogging evolution},
journal = {Journal of Hydrology},
volume = {679},
pages = {136232},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136232},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013296},
author = {Zihao Liu and Qiongfang Li and Yiqun Sun and Zhengmo Zhou and Yao Du and Shuhong Xu and Xingye Han and Xing Huang and Junliang Jin},
keywords = {Permeable pavement systems, Surface runoff mitigation, Clogging, Spatiotemporal variation},
abstract = {Permeable pavement systems (PPS), as a key Low Impact Development measure, are increasingly deployed to address the urban waterlogging problems in the context of rapid urbanization and global climate change. However, little research has been conducted on how the spatiotemporal variation of clogging affects the runoff mitigation performance of PPS. This study addresses this gap through a novel hydrological model integrating spatiotemporal clogging effects, calibrated and validated with data from five PPS units at the Zhenjiang experimental base. The model evaluated the surface runoff reduction performance varying rainstorm intensity, initial moisture content conditions, and operating time. Results indicated that: (1) the total surface runoff volume reduction rate (VR) and the surface peak flow reduction rate (QR) of PPS exhibited a non-linear decline over the operating time, characterized by an initial rapid decrease, followed by a slower decline, and then another phase of rapid deterioration, (2) lower initial moisture content and reduced rainfall intensity were associated with a slower rate of decline in VR and QR over the operating time; furthermore, different pavement types displayed varying rates of performance degradation, (3) taking a VR threshold of 55% as the performance limit, the service life estimates under natural clogging reach 27 years for permeable bricks, 20 years for pervious concrete, and 14 years for permeable interlocking pavers, highlighting superior sustainability of permeable bricks. These results underscore the critical role of spatiotemporal clogging patterns in PPS service life prediction. The discoveries provide a decision-making tool for optimizing the design and maintenance schedules in sponge cities.}
}
@article{BAI2026136305,
title = {Connectivity and function determine whether ponds act as sources or sinks of nonpoint-source phosphorus},
journal = {Journal of Hydrology},
volume = {679},
pages = {136305},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136305},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014022},
author = {Xiaofen Bai and Chen Lin and Ke Song and Wenlan Feng and Junfeng Xiong and Siyu Ge and Wanqian Yu and Jianchun Chen and Yijun Tong},
keywords = {Pond functional type, Hydrological connectivity, Phosphorus source andsink, Non-point source pollution, Watershed management},
abstract = {Ponds can act as either sources or sinks for phosphorus (P) export within a watershed. However, most existing studies treat ponds as homogeneous units, lacking a quantitative framework to identify these opposing functions. To address this, we develop a source–sink diagnostic framework that couples index of connectivity (IC) for the pond–river network with P export simulated by an optimized SWAT+ model to identify P-source and sink ponds. Using the Taihu Lake Basin as a representative eutrophic watershed, the results indicate that: (1) Ponds play a small but critical role in P export. Although ponds account for only 0.78% of the watershed area, they contribute 22.76% of P export. (2) Correlations between IC and P export differ markedly across pond functional types. IC positively correlates with P export from aquaculture ponds (r = 0.74, p < 0.05) but negatively with landscape ponds (r = -0.75, p < 0.05); (3) An operational connectivity boundary at IC = − 2 helped distinguish source and sink zones: above this threshold, ponds predominantly act as P sources, dominated by strongly connected aquaculture ponds and moderately connected natural ponds. Below it, ponds shift to P sinks, mainly weakly connected natural and landscape ponds. This new framework provides the first quantitative basis for differentiated pond management, prioritizing source control in strongly connected aquaculture ponds while conserving sink functions in weakly connected natural and landscape ponds.}
}
@article{ZHANG2026136208,
title = {A new breakthrough pressure model for coal considering effective stress and water saturation},
journal = {Journal of Hydrology},
volume = {679},
pages = {136208},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136208},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013053},
author = {Tiancheng Zhang and Jimmy Xuekai Li and Luwei Ding and Dan Kuznetsov and Victor Rudolph and Zhongwei Chen},
keywords = {Breakthrough pressure, Effective stress, CO geo-sequestration, Coal, Water saturation},
abstract = {Gas breakthrough pressure is a key parameter governing gas migration in reservoirs and plays a critical role in assessing the safety of geological storage of gases such as CO2 and H2. However, existing breakthrough pressure prediction methods largely rely on empirical correlations fitted to experimental data, which lack a solid physical basis and are unable to simultaneously account for the coupled effects of water saturation and effective stress. In this study, a series of gas breakthrough pressure experiments were conducted on coal samples from Bowen Basin under varying effective stress and water saturation conditions. The experimental results demonstrate that cleat networks, effective stress, and water saturation jointly control breakthrough behavior in coal reservoirs. Based on these observations, a new physics–informed gas breakthrough pressure model for coal was developed by incorporating effective stress, water saturation, cleat compressibility, porosity, and initial permeability within a unified theoretical framework. The proposed model enables direct prediction of breakthrough pressure curves using sample-specific physical parameters and improves prediction accuracy compared with existing models, particularly for low-permeability samples. Compared with the J-function and the exponential model, it reduces the overall mean absolute error across the five samples from 36.8 kPa and 18.7 kPa to 12.1 kPa, corresponding to reductions of 67.1% and 35.3%, respectively. This study provides a robust approach for predicting gas breakthrough pressure in coal reservoirs and offers insights into underground gas storage assessment.}
}
@article{HU2026136260,
title = {Reshaped hydrologic controls on groundwater chemistry in coal‑mining critical zones: a transition from mining dominance to agricultural nutrient inputs},
journal = {Journal of Hydrology},
volume = {679},
pages = {136260},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136260},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013570},
author = {Wenxu Hu and Yong Xiao and Yuqing Zhang and Qiulan Zhang and Jiahua Wei and Qichen Hao and Yanlong Li and Junting Liu and Jie Wang and Liwei Wang and Zikun Ma},
keywords = {Groundwater hydrochemistry, Coal mining, Water quality deterioration, Agricultural contamination, Machine learning},
abstract = {Coal extraction is widely recognized as the predominant anthropogenic modulator of groundwater hydrochemistry in intensely exploited coalfields. However, the mechanisms by which fully mechanized longwall mining reshapes groundwater hydrochemical evolution remain inadequately understood. This research takes a representative coalfield of the Ordos Basin in China as a case to explore the hydrochemical features and dominant control mechanisms of groundwater in coal‑mining critical zones, via the integration of cluster analysis, quantitative source apportionment, and explainable artificial intelligence techniques. Results reveal pronounced hydrochemical heterogeneity within phreatic aquifers. Groundwater is classified into six distinct groups, with hydrochemical facies evolving from HCO3-Ca type to saline types enriched in NO3–, Cl-, and SO42-. Groundwater chemistry is primarily controlled by natural water–rock interactions, with secondary anthropogenic alterations. Quantitative source apportionment reveals that agricultural activities constitute the largest anthropogenic input (20.4%), slightly exceeding the contributions from coal mine drainage mixing (18.3%). The XGBoost model achieves reliable prediction performance for groundwater quality suitability (R2 = 0.80), and SHAP analysis identifies NO3–, Fe, SO42-, and TDS as key indicators governing water quality variations. Agricultural activities substantially affect groundwater quality by driving nitrate accumulation and salt migration via irrigation return flow and nutrient leaching. Under current mechanized longwall mining and mine-water management schemes, mining-induced hydrogeological disturbances are effectively limited. In contrast, near-surface agricultural nutrient inputs have emerged as the dominant anthropogenic control on phreatic groundwater quality. These findings highlight a shift in hydrologic controls across coal-mining critical zones under modern mining practices and provide scientific support for adaptive groundwater management.}
}
@article{WANG2026136252,
title = {Determining the trends and drivers of extreme flow in permafrost rivers},
journal = {Journal of Hydrology},
volume = {679},
pages = {136252},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136252},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013491},
author = {Zhiwei Wang and Genxu Wang and Huaiyong Shao and Chunlin Song and Shan Lin and Gang Liu and Zheng Jin and Chen Yu},
keywords = {Qinghai-Tibet Plateau, Permafrost, Extreme flow, Climate change, Contribution},
abstract = {Climate warming on the Qinghai-Tibet Plateau has altered hydrological processes in permafrost regions, but the contributions of different factors to extreme flows remain unclear, especially at the seasonal scale. Using 50-year daily streamflow data from the Yangtze River source region (YARSR) and the Yellow River source region (YERSR), combined with flow duration curves, statistical correlation analysis, and double mass curves, we quantified the responses of extreme high flow (Q5) and extreme low flow (Q95) to precipitation, temperature, NDVI, and evapotranspiration (ET). The results show that spring Q5 is more sensitive to temperature, NDVI, and ET, while annual, summer, and autumn Q5 are more sensitive to precipitation. Annual Q95 is more sensitive to temperature, and autumn Q95 is more sensitive to precipitation. Temperature exerts a bidirectional influence on extreme flows: it contributes positively to annual Q95 (86.2% in the YARSR) and negatively to spring Q5 (–92.4% in the YARSR, –93.3% in the YERSR). The contribution of precipitation to warm-season extreme floods exceeds 100%, indicating that unquantified negative feedbacks (e.g., ET) partially offset the positive effect of precipitation. NDVI and ET have stronger impacts on spring Q5 than on other extreme flows. The multi-method approach adopted in this study provides a reliable identification of dominant factors for extreme flow changes in alpine permafrost regions, which is of great significance for fully understanding the response mechanisms of extreme flows to climate change and for water resource management in alpine permafrost basins.}
}
@article{MINDRINOS2026136199,
title = {Estimating drain spacing in non-steady state drainage with constant recharge},
journal = {Journal of Hydrology},
volume = {679},
pages = {136199},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136199},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012965},
author = {Leonidas Mindrinos and George Kargas},
keywords = {Non-steady state drainage, Boussinesq equation, Drain spacing formula, Numerical solution},
abstract = {The paper presents a numerical solution for determining the spacing of subsurface drainage systems under unsteady drainage conditions, when a constant recharge rate (R) is incorporated into the linearized Boussinesq equation under specified boundary and initial conditions. To date, the exponential-series solution of the Boussinesq equation has been used to compute the water table elevation at the midpoint (m) between parallel drains, as well as the discharge per unit area into the drains (q), but not for determining the drain spacing (L), since L appears both algebraically and within the exponential term. To address this issue, only the first term of the exponential series was used. The results indicate that the proposed numerical solution, together with necessary conditions guaranteeing solvability and convergence, provides reliable estimates of L over a wide range of hydraulic and design parameters. The largest errors are obtained when the hydraulic conductivity (K) and drainable porosity (S) are varied, with RMSE values of 0.33 m and 0.36 m, respectively, followed by variations in the observation time (t) (RMSE = 0.20 m). In contrast, variations in R and drain depth (D) result in considerably smaller errors, with RMSE values of 0.06 m and 0.09 m, respectively. Overall, the proposed scheme provides reliable and stable (with respect to measurement noise) estimates of drain spacing and can be effectively applied to the design of subsurface drainage systems.}
}
@article{CAI2026136223,
title = {Phenology and snow penman evapotranspiration model: development, validation, and products},
journal = {Journal of Hydrology},
volume = {679},
pages = {136223},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136223},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601320X},
author = {Hongze Cai and Kaicun Wang},
keywords = {Evapotranspiration, Phenology, Snow cover, Meteorological inputs, Vegetation change, CO-induced stomatal inhibition},
abstract = {Terrestrial evapotranspiration (ET) regulates land–atmosphere water and energy exchanges, but its estimation remains uncertain. Remote-sensing ET models use satellite-derived land-surface information efficiently, yet many products simplify phenology and snow processes and rely on meteorological inputs that may contain inhomogeneities. Here, we developed a Phenology and Snow Penman (PSP) model to estimate ET and its components by explicitly representing vegetation phenology, snow cover and CO2-induced stomatal inhibition. The model was evaluated using eddy-covariance flux observations from 267 global sites and water-balance ET estimates from 58 basins, and showed comparable performance to widely used ET products. We then drove PSP with the Homogenized Gridded Climate Dataset for China (HCD01) to calculate ET. Including phenology and snow processes improved site-level ET simulation accuracy, while neglecting these processes substantially altered ET magnitude, trends and component partitioning across China. Inhomogeneous meteorological inputs also strongly affected ET estimates, with precipitation and radiation contributing most to these differences. During 2000–2020, vegetation change was the dominant driver of the increasing ET trend over China, whereas CO2-induced stomatal inhibition exerted a small but significant offsetting effect by suppressing transpiration. Driven by homogenized meteorological inputs, PSP estimated a mean annual ET of 434 mm yr−1 over China, with a weak upward trend of 1.45 mm yr−1 dec−1 during 1961–2024. Daily 0.1° ET and component datasets for China are publicly available at https://doi.org/10.11888/Terre.tpdc.303108, including HCD01-driven estimates for 1961–2024 and corresponding estimates with CO2-induced stomatal inhibition for 2000–2020 (Cai and Wang, 2026).}
}
@article{LIU2026136244,
title = {An integrated framework for characterizing spatiotemporal dynamics of water footprints, water scarcities, water quantity–quality interdependences and coupled risks in a semiarid river basin},
journal = {Journal of Hydrology},
volume = {679},
pages = {136244},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136244},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013417},
author = {Shuai Liu and Zhiwei Yue and Wei Wang and Xiangkun Zhao and Zhibin Li and La Zhuo},
keywords = {Water quantity, Water quality, Water scarcity, Interdependence, Jing River Basin},
abstract = {Reliable assessment of basin-scale water scarcity and its associated risks is critical for ecosystem protection and sustainable development, especially in ecologically fragile semi-arid basins. Nevertheless, the interactions between quantity and quality-induced water scarcities in time and space remain poorly understood, and systematic evaluations of their co-occurrence are still lacking. An integrated framework based on the Soil and Water Assessment Tool (SWAT), water footprint theory, and Copula functions was developed to characterize and quantify water footprints, water scarcities, water quantity–quality interdependences and coupled risks in the Jing River Basin during 2016–2022. A triple-variable calibration strategy incorporating evapotranspiration, runoff, and water quality was employed to improve the robustness of hydrological and environmental simulations. Results showed clear spatiotemporal differences among water scarcity types. Green water scarcity (GWS) mainly occurred during the crop growing season (May–October), whereas blue water scarcity (BWS) was concentrated in the dry season (November–April). In contrast, quality-induced water scarcity (QWS) showed weak seasonality and stronger control by local conditions. Severe water scarcity (BWS–GWS–QWS) was rare but clustered in localized hotspots, persisting for 5–6 months annually. Joint distribution analysis showed that the interdependence between water quantity and quality was dominated by Gumbel and Clayton Copulas in 75% of sub-basins, indicating potential asymmetric dependence patterns under the available 7-year monthly record. Meanwhile, low-flow conditions were more often associated with elevated QWS, and higher joint risk probabilities were observed in some agriculturally dominated sub-basins. This integrated approach helps constrain SWAT-based simulations and characterizes the non-linear dependence between water quantity and quality across varying hydrological scenarios. Ultimately, this study supports a transition toward coupled quantity-quality management, providing actionable intelligence for spatially targeted agricultural interventions, such as non-point source pollution control, and crop structure adjustments, to enhance resilience against multiple water scarcities in semi-arid river basins.}
}
@article{BREDA2026136296,
title = {Climate change projections of probable maximum precipitation over large areas through depth-area-duration analysis: A case study in Brazil},
journal = {Journal of Hydrology},
volume = {679},
pages = {136296},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136296},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013934},
author = {João Paulo Lyra Fialho Brêda and Walter Collischonn and Pedro Torres Miranda and Rodrigo Cauduro Dias de Paiva},
keywords = {Global climate models, Extreme rainfall, Large basins, South America},
abstract = {Extreme rainfall events can be catastrophic if not anticipated. Global warming is expected to intensify such events, thus any kind of human settlement must be planned and adapted to the emerging climate conditions. In this study, we investigated projections of rare extreme rainfall in large areas (>50,000 km2), consistent with the horizontal resolution of global climate models (GCMs). This spatial scale is particularly suitable for assessing extreme flood hazards in large river basins, providing insights into the evolving risks due to global warming. The analysis was conducted by comparing the envelopes of Depth-Area-Duration curves between the historical and future periods of 23 GCMs, considering the SSP2-4.5 and SSP5-8.5 scenarios, across four extensive and relatively homogeneous regions in South America. Regional aggregation allowed the detection of statistically significant signals for rare extreme rainfall. Through a spatiotemporal assessment, we conclude that: (i) stronger temperature increases lead to greater intensification of extreme rainfall; (ii) there are no significant differences in the magnitude of intensification among the four regions; (iii) rainfall events of different area size exhibit similar degrees of intensification; and (iv) shorter events present greater intensification. In particular, the 1-day extreme rainfall exhibit an increase consistent with the Clausius–Clapeyron relation. These results are in line with literature and provide a clear and robust summary of what to expect for rare rainfall events in large basins.}
}
@article{XU2026136264,
title = {A Bellman equation-based unified framework for evaluating and optimizing reservoir hedging rules: Incorporating inflow temporal dependence and non-stationary environments},
journal = {Journal of Hydrology},
volume = {679},
pages = {136264},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136264},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013612},
author = {Ximeng Xu and Chao Ma and Haixing Gou},
keywords = {Reservoir operation, Hedging rule, Value function, Bellman equation, Time-varying policy},
abstract = {Hedging rules (HRs) are widely used in reservoir operation due to their simplicity and strong theoretical basis. However, their practical application is constrained by restrictive assumptions, such as predetermined differentiable utility functions, temporally independent inflows, and stationary environments. This study addresses these limitations by formulating reservoir operation as a Markov decision process and developing a unified hedging framework based on the Bellman equation. First, the Bellman expectation equation is utilized to calculate value functions for given HRs, establishing a quantitative criterion for rule comparison. Second, the Bellman optimality equation is utilized to derive the optimal value functions and corresponding optimal HRs. Third, comprehensive theoretical analysis and numerical experiments are carried out for optimal value functions and optimal HRs. Both Markovian inflow cases and non-stationary environments are studied, yielding two-dimensional HRs and time-varying HRs, respectively. Key properties such as monotonicity, concavity, and convergence of the optimal value function are derived. A detailed parameter sensitivity analysis examines how optimal HRs respond to variations in reservoir storage capacity, discount factor, discharge utility function, inflow distribution characteristics, and temporal dependence. This unified framework supports both the evaluation and optimization of HRs, strengthening the theory of reservoir hedging.}
}
@article{ZHOU2026136256,
title = {Evaluating the effectiveness of GSMaP precipitation product in capturing precipitation events},
journal = {Journal of Hydrology},
volume = {679},
pages = {136256},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136256},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013533},
author = {Chun Zhou and Li Zhou and Ting Chen and Juan Du and Jiajia Yue and Keying Liu and Tianqi Ao},
keywords = {Precipitation events, Satellite precipitation product, GSMaP, Near-real-time precipitation},
abstract = {Accurate precipitation monitoring is essential for water resource management and hazard forecasting, yet gauge networks remain sparse and uneven in complex terrain. Using hourly gauge observations from 2004 to 2020, we evaluated the event-scale performance of the Gauge-calibrated Near-Realtime Rainfall Product (GNRT; 0.1°, 1 h) within the Global Satellite Mapping of Precipitation (GSMaP) across Sichuan Province, China. Our findings reveal the following: (1) precipitation-event characteristics exhibit a pronounced east–west gradient, and GNRT–Gauge biases show clear terrain-related contrasts, with positive depth biases more frequent in the southern dry-hot valley and negative biases in parts of the northeastern humid and western high-elevation regions; (2) GNRT biases vary with event intensity, with light-to-moderate events generally showing shorter durations and spatially heterogeneous depth and mean-rate differences, while heavy and violent events exhibit stronger regional contrasts in duration and peak position; (3) pooled event classifications are dominated by isolated misses and false alarms across all intensity levels. Although station-level event probability of detection is generally higher for heavy and violent events, the event false-alarm ratio remains high and the event critical success index improves only modestly, especially in western mountainous areas; and (4) for matched events, GNRT generally identifies event onset, peak, and cessation earlier than gauges, with the largest negative offsets occurring at event termination. Negative timing offsets are widespread, but their spatial hotspots vary with intensity. These results highlight the need to account for terrain- and intensity-dependent detection and timing errors when using GNRT for precipitation-event monitoring in complex terrain.}
}
@article{HU2026136228,
title = {Mechanisms of vegetation effects on hydrological processes in subgrade slopes: novel models for SWRC and moisture dynamics response analysis},
journal = {Journal of Hydrology},
volume = {679},
pages = {136228},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136228},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013259},
author = {Huiren Hu and Sisi Chen and Junhui Zhang and Xufu Wang and Feng Li and Junhui Peng},
keywords = {Subgrade slope, Water retention characteristics, Hydrological process, Compaction degree, Vegetation root, Predictive model},
abstract = {Extreme climate events are increasingly triggering highway subgrade slope failures, in which hydrological processes play a central role. This investigation aims to elucidate the coupled influence mechanisms of vegetation root systems and spatial variations in compaction degree on soil water retention characteristics, with a focus on hydrological implications for slope stability. A modified pressure plate apparatus with an improved water–air exchange structure was developed and used to determine the soil water retention characteristics of subgrade soils under controlled variations in compaction degree and root volume ratio (RVR). A soil water retention curve (SWRC) model incorporating the coupled effects of compaction degree and RVR was developed and applied to simulate hydrological processes in a vegetated subgrade slope. The results show that: (1) The modified pressure plate apparatus increases the testing range by 54%, enabling rapid testing over a wider range while maintaining comparable efficiency and accuracy. (2) Both the presence of roots and higher compaction degree reduce saturated moisture content but significantly enhance the soil water retention capacity, demonstrated by a substantial increase in the air-entry value and a decrease in specific water capacity. In particular, the effect of roots on the air-entry value is more pronounced than that on saturated moisture content. (3) The developed SWRC model establishes a continuous closed-form relationship among compaction degree, RVR, matric suction, and moisture content, and shows excellent performance in predicting SWRC under different compaction degrees and RVRs, R2 = 0.98. The proposed model can support moisture migration analysis in vegetated subgrade slopes, thereby improving the understanding of the associated hydrological processes.}
}
@article{HAN2026136280,
title = {How do branches modulate litter hydrology? Disentangling their effects on water retention and temperature-sensitive evaporation},
journal = {Journal of Hydrology},
volume = {679},
pages = {136280},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136280},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013776},
author = {Zhen Han and Jiangwen Li and Yaying Feng and Minzhe Liu and Nufang Fang},
keywords = {Forest litter, Water conservation, Water retention capacity, Evaporation process, Temperature response, Hydrological function, Karst region},
abstract = {The forest litter layer is a key hydrological interface that regulates water retention, infiltration, and evaporation, yet the role of branches, an often‑overlooked component, in modulating these processes remains poorly understood. This study investigated the water retention dynamics and temperature-dependent evaporation of litter from three typical vegetation types (Pinus massoniana, Magnolia grandiflora, and Osmanthus fragrans) in the karst regions of southwestern China. A fully controlled experiment was conducted using five leaf-branch mixing ratios (0%, 15%, 30%, 45%, and 100% branch mass proportion). The results showed that water-holding capacity increased logarithmically with immersion time (R2 > 0.84), with M. grandiflora exhibiting the highest maximum capacity (2.08 kg·m−2), followed by O. fragrans (1.54 kg·m−2) and P. massoniana (1.16 kg·m−2). Increasing branch proportion significantly reduced water retention in broadleaved species but had no significant effect on P. massoniana. Water absorption rate followed a power-law decay function (R2 > 0.79), with initial absorption rates ranging from 0.79 to 19.92 g·g−1·h−1; leaves generally showed higher rates than branches. Evaporation was strongly temperature-driven, with rates at 30°C significantly higher than those at 0°C, and followed a power-law relationship with time (R2 > 0.95). A significant negative correlation emerged between water‑holding capacity and evaporative water loss (p < 0.01), a relationship that intensified at higher temperatures. Collectively, these findings quantitatively demonstrate how litter composition and temperature jointly regulate hydrological functions, providing critical parameters for improving forest hydrological models and guiding function-based ecological restoration in fragile karst ecosystems.}
}
@article{BUDAMALA2026136248,
title = {Hierarchical prediction of streamflow and organic carbon at event scale using a physics-guided AI hybrid framework},
journal = {Journal of Hydrology},
volume = {679},
pages = {136248},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136248},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013454},
author = {Venkatesh Budamala and Euiyoung Choi and Minchang Kim and Sangchul Lee and Hyunglok Kim},
keywords = {Streamflow prediction, Organic carbon export, Water quality modeling, Graph neural networks, Watershed modeling, Agricultural watersheds},
abstract = {Agricultural watersheds are major contributors to storm-driven export of streamflow (Q) and organic carbon, including particulate organic carbon (POC) and dissolved organic carbon (DOC), which strongly influence downstream water quality and aquatic biogeochemical processes. However, accurate prediction of event-scale hydro–carbon dynamics remains challenging because process-based models require extensive calibration, whereas purely data-driven models often lack physical consistency. This study presents a physics-guided spatial–temporal hybrid framework (PhyST-HC) that integrates uncalibrated Soil and Water Assessment Tool–Carbon (SWAT-C) simulations with Graph Neural Networks (GNNs) and Transformer-based attention mechanisms for hierarchical prediction of Q, POC, and DOC. Distributed SWAT-C-derived hydrological and carbon-state variables serve as physics-guided watershed descriptors, while GNNs capture upstream–downstream connectivity and the Transformer learns temporal watershed memory. The framework was evaluated in the agriculturally dominated Tuckahoe Creek Watershed (TCW), USA. Results showed that PhyST-HC achieved Q performance comparable to a SUFI-2-calibrated SWAT-C model (KGE = 0.82) without watershed-specific calibration, while substantially outperforming both SUFI-2 and SWAT-LSTM for organic carbon prediction (POC: KGE = 0.68 vs. 0.04 and 0.34; DOC: KGE = 0.74 vs. 0.43 and -0.05, respectively). Ablation analysis confirmed the importance of physics-guided SWAT-derived watershed-state variables beyond standalone GNN and Transformer models. The framework also improved representation of event-scale POC flushing, delayed DOC transport, and watershed connectivity under contrasting storm conditions. These findings demonstrate the potential of physics-guided hybrid learning for accurate and transferable event-scale hydro–carbon prediction in agricultural watersheds.}
}
@article{LYE2026136251,
title = {Simulation of rainfall-runoff flow using three-dimensional smoothed particle hydrodynamics},
journal = {Journal of Hydrology},
volume = {679},
pages = {136251},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136251},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601348X},
author = {Xin Yan Lye and Akihiko Nakayama},
keywords = {Rainfall-runoff process, Overland flow, Smoothed particle hydrodynamics, Free surface flow, Infiltration, SCS curve number},
abstract = {The three-dimensional (3-D) Weakly Compressible Smoothed Particle Hydrodynamics (WCSPH) has been reformulated to simulate overland flow on real terrains due to rainfalls. The rainfall is lumped into discrete particles falling over the terrain and the overland flow is simulated as three-dimensional free surface flows over topography following the WCSPH framework. The terrain and objects on it such as buildings and other structures are represented by boundary particles that are distributed over the combined surfaces having normal directions and roughness height used for setting dynamic boundary conditions, and the actual and potential moisture contents used to set infiltration conditions. The basic method is verified with experimental results of rainfall runoff from laboratory model plots and compared with existing runoff models. Then it is applied to a simulation of rainfall runoff over real terrains in Malaysia. It is found that the simulation by the present method gives details of overland flows that would not been obtained by the existing two-dimensional methods.}
}
@article{LIU2026136272,
title = {A river-augmented highly parameterized linear inverse method for enhanced water table estimation across China},
journal = {Journal of Hydrology},
volume = {679},
pages = {136272},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136272},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013697},
author = {Ailin Liu and Jianying Jiao},
keywords = {Inverse method, River stage observations, Hydraulic conductivity, Uncertainty analysis},
abstract = {Large-scale groundwater assessment in China is fundamentally constrained by the scarcity of in situ well observations, leading to prohibitive uncertainties in water table mapping. To overcome this limitation, we use river-stage information as additional hydraulic-head constraints along river corridors, based on the hydraulic connection between rivers and shallow aquifers. Here, we present a river-augmented highly parameterized linear inverse method (HPLIMRG) that extends a groundwater-only formulation (HPLIMG) by incorporating river-stage observations, together with well measurements, as additional hydraulic-head constraints. The efficacy of this approach is demonstrated across scales. In synthetic experiments, HPLIMRG reduces root mean square error (RMSE) from 0.68 m to 0.55 m compared to HPLIMG, without compromising uncertainty quantification. In the High Plains Aquifer, RMSE drops from 0.79 m to 0.35 m, while the median standard deviation of the water table decreases from 0.37 to 0.097 m. Critically, in a data-sparse, continental-scale application to map water table depth across China for December 2024 and March 2025, HPLIMRG yields a similar accuracy gain (RMSE from 5.04 m to 4.22 m) and a dramatic reduction in uncertainty (from 1.29 m to 0.06 m). Collectively, these results demonstrate that incorporating river-stage observations into the HPLIM framework improves water table estimation accuracy and reduces uncertainty, with the largest gains in sparsely monitored regions, as shown across China. By converting rivers into a dense, physically constrained observational network, this framework, applied here at 1 km resolution for large domains, offers a robust and scalable pathway for water table mapping where well observations are scarce.}
}
@article{FENG2026136186,
title = {SURGIN: SURrogate-guided Generative INversion for subsurface multiphase flow with quantified uncertainty},
journal = {Journal of Hydrology},
volume = {679},
pages = {136186},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136186},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012837},
author = {Zhao Feng and Bicheng Yan and Luanxiao Zhao and Xianda Shen and Renyu Zhao and Wenhao Wang and Fengshou Zhang},
keywords = {Inverse modeling, Score-based generative learning, Bayesian inference, Neural operator, Subsurface multiphase flow},
abstract = {We present a direct inverse modeling method named SURGIN, a SURrogate-guided Generative INversion framework tailored for subsurface multiphase flow data assimilation. Unlike existing inversion methods that require adaptation for each new observational configuration, SURGIN features a zero-shot conditional generation capability, enabling real-time assimilation of unseen monitoring data without task-specific retraining. Specifically, SURGIN synergistically integrates a U-Net enhanced Fourier Neural Operator (U-FNO) surrogate with a score-based generative model (SGM), framing the conditional generation as a surrogate prediction-guidance process in a Bayesian perspective. Instead of directly learning the conditional generation of geological parameters, an unconditional SGM is first pretrained in a self-supervised manner to capture the geological prior, after which posterior sampling is performed by leveraging a differentiable U-FNO surrogate to enable efficient forward evaluations conditioned on unseen observations. Extensive numerical experiments demonstrate SURGIN’s capability to effectively infer heterogeneous geological fields and predict spatiotemporal flow dynamics with quantified uncertainty across diverse measurement settings. Benchmark comparisons with classic Bayesian inversion baselines further demonstrate improved posterior reconstruction and uncertainty characterization. By unifying generative learning with surrogate-guided Bayesian inference, SURGIN establishes a new paradigm for inverse modeling and uncertainty quantification in parametric function spaces.}
}
@article{SONG2026136283,
title = {New insights into lacustrine groundwater discharge within the groundwater-wetland-lake system in arid regions},
journal = {Journal of Hydrology},
volume = {679},
pages = {136283},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136283},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013806},
author = {Xinming Song and Fu Liao and Guangcai Wang and Xiaodong Li and Nuan Yang and Liang Guo and Luoyao Xiong and Chenyu Wang and Hanxiao Wang},
keywords = {Wetland-lake groundwater discharge, Isotopes, Evaporation line slopes, Hydrochemical evolution},
abstract = {Wetland-groundwater-lake interactions play a critical role in regulating water availability, hydrochemical evolution, and ecosystem services in arid regions. Wetlands commonly develop along lakes shorelines in arid regions, yet their regulatory role in lacustrine groundwater discharge (LGD) has received little attention. Here, LGD passes through wetlands and then entering the lake is defined as wetland-lake groundwater discharge (WLGD). We developed a novel method based on evaporation line (EL) slope variations, integrating with stable isotopes (δ18O and δ2H), 222Rn, and hydrochemical data, to identify WLGD in Hurleg Lake, Qaidam Basin. The observed lake water EL slope (4.89) is significantly lower than the value theoretically derived from river and precipitation inputs alone (5.18), indicating additional inflows characterized by strong evaporative signatures. Unlike direct LGD, WLGD is characterized by elevated TDS, enriched δ18O, and reduced 222Rn activity in lake water. Along the eastern shoreline, the progressive increase in TDS and δ18O enrichment, accompanied by decreasing 222Rn activities, further indicated the influence of wetland-derived groundwater inputs. These observations also validate the evaporation line slope as an effective tracer for identifying lake recharge sources. Furthermore, WLGD also substantially alters lake hydrochemistry by increasing pH, HCO3–, NO3–, and SO42- concentrations while decreasing ORP and water temperature. The findings provide new insights into the mechanisms and ecological significance of lacustrine groundwater discharge within integrated groundwater-wetland-lake systems.}
}
@article{CHEN2026136254,
title = {Economic impacts of saltwater intrusion on the Guangdong-Hong Kong-Macao Greater Bay Area under climate change scenarios},
journal = {Journal of Hydrology},
volume = {679},
pages = {136254},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136254},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601351X},
author = {Yilin Chen and Zhihao Xu and Qian Dong and Zhifeng Yang},
keywords = {The Greater Bay Area, Saltwater intrusion, Economic impact, Water supply, Supply-chain effects},
abstract = {Saltwater intrusion is a global issue that impedes the development of coastal regions and poses risks to water supplies, particularly in areas such as the Guangdong-Hong Kong-Macao Greater Bay Area (GBA). While its drivers are well studied, the long-term economic effects under climate change scenarios, particularly indirect economic losses incurred by supply-chain effects, remain insufficiently explored. This study combines XGBoost and a Multi-Regional Input and Output (MRIO) model to assess the direct and indirect economic impacts of saltwater intrusion in the GBA. Salinity near eight river outlets was projected from 2025 to 2100 under SSP126, SSP370 and SSP585 scenarios. Direct economic losses were estimated based on salinity exceedance days and water supply dependence, while indirect economic losses transmitted through supply chains were quantified using the MRIO model. The results revealed that total direct economic losses ranged from 64.40 to 138.68 billion USD across SSP scenarios, while total indirect economic losses propagated through supply chains ranged from 47.44 to 101.52 billion USD. Jiangmen and Guangzhou emerged as the major source cities of indirect economic losses owing to their strong dependence on estuarine water supplies and extensive economic linkages. In cities such as Foshan, indirect losses exceeded direct losses by 78.42%–201.01%, highlighting the importance of supply-chain effects. Moreover, economic losses were not directly proportional to the severity of saltwater intrusion, indicating that the impacts were jointly influenced by salinity exceedance, water-supply dependency, and supply chains. These findings highlight the importance of integrating water resource management and economic resilience planning to mitigate the long-term impacts of saltwater intrusion under climate change.}
}
@article{ZHANG2026136275,
title = {Coupling reservoir supply potential with load allocation: A framework to enhance water supply security in multi-reservoir systems},
journal = {Journal of Hydrology},
volume = {679},
pages = {136275},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136275},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013727},
author = {Shuncai Zhang and Minglei Ren and Wei Xu and Te Zhang and Lanlan Zhao and Xiaoqin Hu and Zaichao Xie and Mi Zhou},
keywords = {Regional water-supply systems, Load allocation optimization, Supply-demand imbalance, Reservoir operation, Water security},
abstract = {Increasing water demand is intensifying spatial mismatches between reservoir capacity and supply obligations in regional water-supply systems. Existing studies mainly optimize reservoir operation under fixed supply loads, whereas the distribution of those loads among heterogeneous reservoirs is less often treated as a decision variable. This study presents an integrated regional decision-support framework that links reservoir water-supply potential (RWSP) with reservoir water-supply load allocation (RWSLA) in multi-reservoir systems, providing a pre-operational load-configuration complement to conventional operation simulation. Reservoir-specific ecological water demand is reserved as a non-adjustable priority requirement before socioeconomic load redistribution. RWSP defines feasible allocation ranges for the residual urban and agricultural demands, and candidate schemes are generated by truncated normal sampling within those bounds. Long-term joint operation simulations and multi-criteria evaluation are then used to assess reliability, resilience, vulnerability, water stress, and allocation equity. The framework is applied to five medium and small reservoirs in northeastern Chongqing, China. Results show that RWSP exhibits a clear hierarchy shaped by active storage capacity, mean annual runoff, total available water volume, and dry-period runoff reliability. System performance improves when loads are aligned with reservoir potential: overloading low-potential reservoirs increases vulnerability, whereas assigning higher loads to high-potential reservoirs improves reliability but may reduce equity. Threshold-like responses are observed within the tested load-allocation ranges, and partial-correlation and sensitivity analyses indicate weak competition-complementarity among reservoirs. The framework supports regional screening of spatial load configurations as a pre-operational complement to temporal reservoir-operation rules, while the derived allocation ranges and thresholds remain case-specific.}
}
