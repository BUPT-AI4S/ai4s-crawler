@article{SHIRAFKAN2026136247,
title = {Improving water pixel detection in SWOT Pixel Cloud (PIXC) data over small reservoirs using machine learning methods},
journal = {Journal of Hydrology},
volume = {679},
pages = {136247},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136247},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013442},
author = {Shayan Shirafkan and Mohammad Ali Sharifi and Mohammad J. Tourian},
keywords = {SWOT PIXC, Water pixel detection, Machine learning, Reservoir monitoring, XGBoost},
abstract = {This study presents a machine learning-based framework to improve water pixel detection in SWOT Pixel Cloud (PIXC) data for reservoir monitoring applications. Unlike general land-cover classification, the primary objective is to reduce false positive and false negative water detections in PIXC products, thereby improving the accuracy of derived reservoir surface area and volume estimates. The proposed framework integrates PIXC-derived features with an external long-term water occurrence prior (based on Landsat 5–8 observations) to refine pixel-level water detection. Three supervised learning algorithms, namely K-Nearest Neighbors (KNN), Random Forest (RF), and Extreme Gradient Boosting (XGBoost), are used not only as predictive models but also as diagnostic tools to investigate the behavior of PIXC-derived inputs within the feature space. These inputs include radar backscatter observables, interferometric coherence, detection quality indicators, and geometry-dependent parameters. The models are trained and evaluated across three reservoirs in Iran (Dez, Shahid Rajaei, and Agh Chay), selected to represent distinct hydro-climatic and geomorphological conditions, and are subsequently applied to eight reservoirs to assess their spatial transferability. Performance is quantified using pixel-level Intersection-over-Union (IoU), together with hydrological consistency metrics including correlation coefficient, Normalized Root Mean Square Error (NRMSE), and Kling–Gupta Efficiency (KGE) against in-situ observations. Beyond predictive performance, the results provide interpretability insights into PIXC input features. In particular, features related to detection uncertainty, interferometric coherence, and imaging geometry consistently show strong influence on water detection performance, suggesting that these components of the PIXC processing chain play a critical role in misclassification patterns. This finding highlights potential directions for improving uncertainty representation and quality control within future SWOT PIXC products. Results indicate that all machine learning models improve agreement with both SWOT PIXC and LakeSP products in terms of water detection performance and consistency with in-situ-derived reservoir area estimates. Overall, the findings suggest that incorporating physically meaningful PIXC features together with external hydrological priors can significantly enhance water pixel detection reliability. This approach provides practical guidance for improving downstream SWOT-derived reservoir products and offers insights that may support future refinements of the PIXC processing chain without requiring modifications to the original satellite data stream.}
}
@article{CHOU2026136291,
title = {Constrained stochastic data sampling for deep learning–based time-lapse hydraulic tomography under reactive-induced permeability evolution},
journal = {Journal of Hydrology},
volume = {679},
pages = {136291},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136291},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013880},
author = {Zi-Yan Chou and Jui-Pin Tsai and Bo-Tsen Wang and Chia-Hao Chang and Ying-Fan Lin and Tian-Chyi Jim Yeh},
keywords = {Hydraulic tomography, Deep learning, Nonstationary hydraulic conductivity, Pore clogging, Time-lapse inversion},
abstract = {Most neural-network-based inversion methods are trained under specific statistical conditions, and their performance often deteriorates when the statistical properties of the target parameter fields deviate from those represented in the training dataset. This issue is particularly critical when employing neural-network-based inversion in remediation sites, where reagent injection may induce nonstationary permeability evolution through pore clogging and precipitation. To address this challenge, this study proposes a constrained stochastic data sampling strategy (SDSS) integrated with a three-dimensional Hydraulic Tomography Neural Network (HT-NN) for post-injection hydraulic conductivity (K) estimation. By using prior structural information from the pre-injection field and systematically resampling conditioning locations and conductivity values within physically constrained bounds, SDSS generates nonstationary training realizations that span a broad range of plausible post-injection K-field configurations. This strategy enables the generated training ensemble to span diverse statistical properties rather than being restricted to fixed statistical conditions, thereby reducing the mismatch between the training and target domains. The proposed framework was evaluated using field-informed semi-synthetic realizations and a field case study. The field-informed semi-synthetic validation results show that the SDSS–HT-NN framework can capture nonstationary K-field patterns. The field results indicate that, compared with the Successive Linear Estimator (SLE), HT-NN reproduces a more continuous band-like low-K structure near the injection region, shows a stronger near-field permeability decrease, and yields more accurate predictions of an independent hydraulic head dataset. These results demonstrate that the proposed SDSS–HT-NN framework provides an efficient approach for time-lapse K-field estimation under nonstationary reactive perturbations.}
}
@article{GALDYN2026136231,
title = {Performance analysis of the OS LISFLOOD hydrological model using nearly three decades of satellite laser ranging data},
journal = {Journal of Hydrology},
volume = {679},
pages = {136231},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136231},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013284},
author = {Filip Gałdyn and Laura Jensen and Radosław Zajdel and Krzysztof Sośnica and Henryk Dobslaw},
keywords = {LISFLOOD, SLR, GRACE, Satellitegravimetry, TWS},
abstract = {We evaluate the performance of the OS LISFLOOD hydrological model by comparing its terrestrial water storage (TWS) estimates with long-term geodetic benchmark products derived from Satellite Laser Ranging (SLR), GRACE, and DORIS, over the period 1995–2022. Our analysis focuses on the 100 largest river basins, assessing the model’s ability to capture both seasonal and interannual variability. We find that OS LISFLOOD outperforms a model widely applied in geodetic studies, the Land Surface Discharge Model (LSDM) in representing large-scale TWS variations, particularly in tropical and subtropical basins and in seasonal and low-frequency dynamics of TWS. Comparisons with SLR-based gravity field models extend the evaluation into the pre-GRACE era (1995–2004), highlighting OS LISFLOOD’s robustness in depicting long-term hydrological changes. We also find that combined SLR+GRACE and SLR+DORIS datasets provide useful long-term geodetic benchmarks for assessing hydrological model consistency, particularly in large tropical basins. This work contributes to advancing long-term reconstructions of the global water cycle and supports geodetic applications, including environmental loading corrections and studies of Earth rotation. The results emphasize the importance of high-resolution hydrological models in improving the accuracy of TWS simulations and their application to geophysical research.}
}
@article{YIN2026136243,
title = {Large-scale circulation anomalies at drought occurrence over northern China during El Niño developing stage},
journal = {Journal of Hydrology},
volume = {679},
pages = {136243},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136243},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013405},
author = {Hao Yin and Zhenchen Liu and Zhiyong Wu and Hai He},
keywords = {Drought occurrence, Large-scale circulation anomalies, Northern China, ENSO},
abstract = {El Niño-induced droughts over northern China have been extensively studied regarding their interannual variability. However, the spatial heterogeneity of their occurrence regions (e.g., the upper-middle Yellow River Basin, North China, or Northeast China) and their specific large-scale circulation anomalies remain unknown. In this study, we identify El Niño-induced northern China droughts with diverse spatial distributions, investigating their drought-inducing circulation patterns and associated phase transitions. The key findings are as follows. Despite diversity in El Niño developing stages and associated spatially heterogeneous drought locations, these summer-autumn droughts consistently exhibit a local dynamic structure resembling the first baroclinic mode, characterized by upper-tropospheric convergence and enhanced mid-low-level northerly anomalies. Three principal large-scale circulation pathways are delineated: the Eurasian Mid-Latitude Pathway featuring Rossby wave trains propagating from North Atlantic, the Pacific-East Asian Pathway through large-scale upper-tropospheric convergence over tropical regions and associated meridional circulation, and the North Pacific Pathway where a negative North Pacific Oscillation (NPO) prior to El Niño establishment fosters mid-latitude anticyclonic anomaly pattern and northerly flow over northern China. Meanwhile, rapid phase transitions of typical mid-latitude teleconnection indices at the drought occurrences are defined and investigated. Positive-to-negative phase transitions of the North Atlantic Oscillation (NAO) and NPO can potentially trigger drought occurrence over northern China. A persistent negative NAO, often coupled with specific North Atlantic sea surface temperature patterns (e.g., a negative North Atlantic Tripole), promotes the propagation of mid-high-latitude wave trains, ultimately enhancing drought-inducing circulation anomalies over northern China. These achievements contribute to improving seasonal drought prediction skills.}
}
@article{MENDEZBARROSO2026136295,
title = {Constraining the maximum entropy production approach with sun-induced chlorophyll fluorescence to estimate evapotranspiration in a seasonally dry deciduous forest},
journal = {Journal of Hydrology},
volume = {679},
pages = {136295},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136295},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013922},
author = {L.A. Méndez-Barroso and H.A. Gutiérrez-Jurado and G. Juárez-Cansdales and E.A. Yépez},
keywords = {Hydrological modeling, North American monsoon, Transpiration, Evaporation},
abstract = {Estimating evapotranspiration (ET) in arid and semi-arid ecosystems is crucial for understanding vegetation strategies to optimally use water storage in the vadose zone at different phenological stages. Currently, there are a limited number of ET techniques applicable to these ecosystems, especially to those found in remote and isolated areas, and able to partition and estimate soil evaporation (E) and plant transpiration (T). However, the development of simple thermodynamic models has allowed the estimation of energy balance components in both the soil and vegetation canopy, resulting in a better understanding of the seasonal variability of evapotranspiration. In this study, the maximum entropy production (MEP) approach was implemented and its performance evaluated in a semi-arid ecosystem (dry deciduous forest) to estimate the seasonal evolution of total evapotranspiration and canopy transpiration fluxes. In order to improve transpiration fluxes during the growing season, the MEP model was constrained with vegetation phenology at the site using remote sensing estimates of sun-induced chlorophyll fluorescence (SIF). Daily ET computed with the MEP approach performed very well (R = 0.96 and MAE = 0.32 mmd−1) in comparison with in-situ ET observations using the eddy covariance technique. Furthermore, MEP model showed an excellent robustness in transpiration estimates in comparison with independent state of the art-global transpiration assessments such as GLEAM (R = 0.84 and MAE = 0.87 mmd−1) and PML (R = 0.94 and MAE = 0.74 mmd−1). The thermal properties-based MEP approach is a reliable alternative for estimating evapotranspiration at long-term semiarid and remote monitoring sites because it uses simple meteorological observations as model input, unlike other approaches such as eddy covariance technique which implies costly equipment and significant investment of human and financial resources.}
}
@article{PELEG2026136267,
title = {Spatial and temporal dynamics of E. coli in streamwater, sediments and rock biofilm},
journal = {Journal of Hydrology},
volume = {679},
pages = {136267},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136267},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013648},
author = {Eshel Peleg and Shai Arnon and Edo Bar-Zeev and Shereen Assaly and Ludmila Groisman and Shaked Stein and Shira Ninio and Yaron Be’eri-Shlevin and Emily Lena Tran},
keywords = {Fecal coliforms, Sediment size fractions, Nutrient dynamics, Baseflow, Microbial water quality},
abstract = {Most studies have addressed the dynamics of Escherichia coli (E. coli) in streamwater during storms, while baseflow conditions in streambed environments have received less attention. Specifically, few have explored how E. coli is distributed across biofilms and sediment size fractions. Thus, the objective of this study was to quantify the distribution of E. coli in streamwater, biofilm, and sediment fractions, and to determine how these niches influence spatiotemporal variations in E. coli concentration in a highland Mediterranean stream. E. coli dynamics across streamwater, rock biofilms, and size-fractionated sediments (<75, 75–300, and 300–2000 μm) were measured over 12 months across five sites along the Meshushim Stream, Israel. E. coli concentrations in streamwater ranged between 1 and 1.4 × 104 MPN 100 ml−1. E. coli concentration increased significantly during the warm season (May-September) and was significantly correlated with temperature and, to a lesser extent, with total suspended solids. While streamwater E. coli concentrations fluctuated seasonally, the concentrations of E. coli associated with biofilms (250–1.4 × 105 MPN m−2) and sediment (40–5.4 × 103 MPN g−1 SDW) reservoirs did not have a temporal trend. E. coli was found attached to the finest sediment fractions, yielding concentrations that are 50 times higher than those in the coarsest material. These findings suggest that fine sediments serve as an important habitat for E. coli under both high-flow and baseflow conditions. During high flows, E. coli is often transported bound to particles that resuspend in the water, whereas during baseflow, fine-sediment reservoirs may influence streamwater dynamics even without substantial resuspension.}
}
@article{WANG2026136235,
title = {Anomalously depleted δ2H signatures of tropical cyclone precipitation recorded in tree-ring lignin methoxy groups},
journal = {Journal of Hydrology},
volume = {679},
pages = {136235},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136235},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013326},
author = {Yabo Wang and Wenxin Li and Xiaohong Liu and Guobao Xu and Huhu Kang and Bingming Chen and Xianhui Tang and Jianjun Qu and Chong Jiang and Xin Song},
keywords = {Tropical cyclones, Tree-ring δH, Precipitation, Stable hydrogen isotopes},
abstract = {Tropical cyclones (TCs) are among the most destructive weather systems in the Earth system, yet their long-term variability remains poorly constrained because instrumental observations and historical archives span only the recent decades. Terrestrial proxies capable of preserving cyclone-related hydroclimatic signals could therefore provide valuable insights into past TC activity. However, whether and how TC signals are quantitatively preserved in tree-ring hydrogen isotopes remains largely unresolved. Here we investigate the isotopic imprint of TCs in both precipitation and tree rings in the Hong Kong SAR, China. By compiling TC events since 1980 and comparing the hydrogen isotopic composition of precipitation (δ2Hppt) during TC-affected and TC-free months, we show that TC precipitation (TCP) consistently exhibits anomalously depleted isotopic signatures even after accounting for rainfall amount and seasonal effects. Because precipitation isotopes provide the primary hydrogen source incorporated into plant water pools and subsequently into lignin methoxy groups during wood formation, these isotopic anomalies are expected to propagate into tree-ring hydrogen isotopes. Consistent with this mechanism, robust regression analyses indicate that TCP isotopic variability explains approximately 30% of the variance in latewood lignin methoxy hydrogen isotopes (δ2HLM) of Pinus elliottii Engelm. in Hong Kong. We further find that TCP exerts the dominant influence on δ2HLM variability, with additional contributions from storm intensity and seasonal timing, whereas storm duration and cyclone–site distance show limited independent effects. These results indicate that TC signals preserved in latewood δ2HLM reflect the integrated hydroclimatic influence of cyclone systems rather than any single storm metric. Together, our findings demonstrate that TC-driven hydro-isotopic anomalies can be transmitted from precipitation to tree-ring latewood δ2HLM and preserved within terrestrial archives. These results highlight the potential of tree-ring δ2HLM as a complementary archive for investigating past TC-related hydroclimatic variability and provide a basis for extending records of TC activity beyond the instrumental period.}
}
@article{LI2026136287,
title = {Tidal groundwater flow drives dissolved nitrogen cycling: linking internal transformation to interfacial flux},
journal = {Journal of Hydrology},
volume = {679},
pages = {136287},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136287},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013843},
author = {Ao Li and Yan Zhang and Zhenyang Li and Man Zhao and Jingjing Lyu and Lingwei Xu and Zhenyan Wang and Hailong Li and Guangxuan Han and Kai Xiao},
keywords = {Tidal groundwater flow, Groundwater simulation, Nitrogen cycle, Sandy tidal flat, Denitrification},
abstract = {Tidally driven groundwater flow creates dynamic redox gradients in coastal sandy aquifers, yet how these hydrodynamic conditions regulate nitrogen transformation and subsequent interfacial export remains poorly quantified. In this study, we investigated how tidally forced groundwater flow influences dissolved inorganic nitrogen (DIN) cycling and interfacial nitrogen export in a sandy tidal flat by combining field monitoring, laboratory nitrogen incubation experiments, and groundwater numerical modeling. A two-dimensional SUTRA model calibrated with observed hydraulic heads was used to resolve groundwater-surface water interactions, including groundwater flow paths, velocity fields and exchange fluxes. The results showed that tidal groundwater flow generated distinct hydrodynamic zones differing in water exchange intensity, oxygen renewal, and residence time. Over a spring-neap tidal cycle, the modeled total submarine groundwater discharge flux (SGD) reached 102.6 m3 m−1, with fresh groundwater discharge contributing 27.2%. The potential nitrogen transformation rates and pathways were strongly zone-dependent: nitrification dominated in the intermediate low-velocity circulation zone, attaining rates of 9.9 × 10-7 to 4.2 × 10-6 mmol L−1 s−1. In contrast, DNRA occurred only locally and at much lower rates (2.5 × 10-9 mmol L−1 s−1)， with a localized hotspot in the high-velocity seaward discharge zone rather than in the low-velocity circulation zones. Bayesian relative-importance analysis further resolved how these zone-specific transformations governed interfacial nitrogen export: the high-velocity discharge zone served as a NO3– source to coastal waters via submarine groundwater discharge (SGD), while the low-velocity circulation zone sequestered nitrogen as NH4+. These results demonstrate that tidal groundwater flow dynamically links internal nitrogen transformation to interfacial nitrogen export through selective pathway activation.}
}
@article{ZHENG2026136259,
title = {Rainfall frequency analysis and its uncertainty analysis in Taihu Basin: Bayesian inference of four-parameter Kappa distribution based on specially-formulated pivotal quantities},
journal = {Journal of Hydrology},
volume = {679},
pages = {136259},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136259},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013569},
author = {Weiqiang Zheng and Shuguang Liu and Zhengzheng Zhou},
keywords = {Pivotal quantity, Four-parameter Kappa distribution, Bayesian inference, Rainfall frequency analysis, Taihu Basin},
abstract = {Four-parameter Kappa (FPK) distribution is widely recommended in rainfall frequency analysis, whose complex distribution function makes reliable parameter point estimation and confidence interval construction very challenging. In the current study, we establish a novel Bayesian framework to estimate the parameters and return levels of the FPK distribution and to perform uncertainty analysis. By introducing three specially formulated pivotal quantities, the proposed framework avoids the need to explicitly specify parametric prior distributions for all parameters. Instead, only the prior of one parameter (h) is required, while the joint distribution of the remaining parameters is induced through the pivotal transformation. On this basis, statistical inference for the four parameters and return levels is conducted using the maximal data information prior. The proposed framework is applied to annual maximum daily rainfall series from 36 rain gauges in the Taihu Basin. For reference, results obtained using conventional bootstrap methods are also presented. Interval estimates of both the parameter and design rainfall depth are obtained for all gauges. The results show that the spatial distributions of uncertainty levels for parameter and design rainfall depth are complex. In the middle and northwest of Taihu Basin, the design rainfall depth is relatively large and the associated uncertainty level is high, which requires additional attention in practical applications. Compared with the conventional Bootstrap methods, the parameter realizations generated by the proposed pivotal quantity method tend to retain relatively high likelihood values, leading to more reasonable point estimates and confidence interval estimates. The proposed framework is flexible and substantially simplifies prior specification for the FPK distribution, since only the prior distribution of h needs to be explicitly specified, while the distributions of the remaining parameters are determined through the pivotal quantities.}
}
@article{CHAI2026136227,
title = {Analyzing the resilience and development trajectories of water resource systems in transboundary river basins: Lessons from the Mekong},
journal = {Journal of Hydrology},
volume = {679},
pages = {136227},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136227},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013247},
author = {Lin Chai and Liang Yuan and Weijun He and Dagmawi Mulugeta Degefu and Xia Wu and Yang Kong and Thomas Stephen Ramsey},
keywords = {Water Resource System Resilience, Set pair analysis, Five-element connection number, Subtraction set pair potential model, Obstacle degree analysis, Mekong River Basin},
abstract = {Assessing the resilience of water resource systems is fundamental to sustainable risk management in transboundary river basins. With the increasing frequency of extreme weather events and rising water demand, risks in transboundary river basins have become more pronounced. This study examines the dynamics of Water Resources System Resilience (WRSR) in the Mekong River Basin (MRB) and identifies key obstacles affecting its enhancement. A resilience framework comprising perception, resistance, recovery, and adaptive abilities was used to construct the WRSR evaluation index. Indicator weights were determined using the entropy method, and system resilience was evaluated through the five–element connection model. The subtraction set pair potential model and Mann-Kendall trend analysis were applied to assess temporal evolution, while the obstacle degree model was used to diagnose major barriers to sustainable water governance. Results indicate that from 1995 to 2020, WRSR in the MRB remained predominantly at a low level. Among the riparian states, China consistently maintained high resilience; Cambodia experienced steady improvement; and Laos and Thailand remained at a moderate level. In contrast, Myanmar and Vietnam showed persistently low resilience. The priority areas for resilience enhancement vary across countries: Cambodia, Laos, and Myanmar need to strengthen their resistance capacity; China and Thailand should further develop both perception and resistance capacities; whereas Vietnam requires simultaneous improvements in perception, disaster resistance, and adaptive capacities. Fertilizer use per unit area, industrial water use efficiency, total internal renewable water resources per capita, GDP per capita, and dam capacity per capita constitute the principal obstacles to WRSR, with resistance capacity emerging as a dominant critical limiting factor.}
}
@article{PARK2026136279,
title = {A copula-based stochastic simulation method for the penman wind function (PWF) in in-stream evaporation},
journal = {Journal of Hydrology},
volume = {679},
pages = {136279},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136279},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013764},
author = {Minwoo Park and Ghani Rahman and Joo-Heon Lee and Hyun-Han Kwon},
keywords = {In-stream evaporation, Penman wind function (PWF), Empirical prior, Kernel density estimation, Copula functions, Uncertainty quantification},
abstract = {Accurately estimating in-stream evaporation is crucial for understanding surface water losses, but it remains challenging due to the sparse availability of flux data and the complex dynamics of flowing systems. This study introduces a modeling framework that combines the Penman Wind Function (PWF) with empirical-prior-based stochastic simulation to quantify uncertainty in in-stream evaporation estimates under data-limited conditions. Rather than demonstrating universal transferability of PWF coefficients, this study focuses on identifying how coefficient uncertainty and cross-site transfer bias emerge when reservoir-, stream-, and literature-derived parameters are applied across hydrologically distinct environments. Direct calibration of PWF coefficients using high-resolution flux data from the Andong Stream Experiment Center produced the most reliable estimates (r=0.862,CoE=0.731,RMSE=1.500mm/day), confirming that site-specific calibration remains the preferred option when local observations are available. To support applications where such observations are unavailable, we constructed a literature-derived empirical prior parameter library of PWF coefficients and used log-space Kernel Density Estimation (KDE) with copula-based Monte Carlo sampling to propagate parameter uncertainty. The literature-derived coefficient pairs were treated as a heterogeneous empirical prior library rather than as homogeneous i.i.d. samples. Copula sensitivity analysis showed that coefficient dependence was weak and model-selection uncertainty was substantial; therefore, the Gaussian copula was used only as a parsimonious working copula and was evaluated against the independence copula. Cross-site application showed that reservoir-derived and ensemble-based coefficients retained part of the temporal co-variation driven by meteorological forcing, but they also produced non-negligible magnitude errors and systematic bias under stream conditions. At Andong, the Yongdam-derived coefficients and copula ensemble showed relatively high correlations but substantially degraded bias and RMSE compared with site-specific calibration, indicating limited coefficient transferability and reservoir-stream aerodynamic regime mismatch. Overall, the proposed framework is best interpreted as an uncertainty-aware baseline estimation approach for data-limited environments, while direct calibration remains the benchmark for reliable in-stream evaporation estimation.}
}
@article{XIA2026136117,
title = {Geostatistics-informed latent diffusion for conditional hydrogeological facies simulation under sparse hard-data constraints},
journal = {Journal of Hydrology},
volume = {679},
pages = {136117},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136117},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601214X},
author = {Tianqi Xia and Genshen Chen and Huiyun Mao and Yiping Tian and Zhiting Zhang},
keywords = {Latent diffusion models, Conditional facies simulation, Deep generative models, Multiple-point geostatistics, Uncertainty quantification, Hydrogeological modeling},
abstract = {Reconstructing subsurface facies architecture from sparse hard data remains a central challenge in hydrogeological modeling. Although adversarial generative networks have been adopted for conditional facies simulation, they often suffer from mode collapse and local structural discontinuities under stringent hard-data constraints. To address these limitations, we propose a Geostatistics-Informed Latent Diffusion Model (GiLDM) for conditional facies simulation under sparse hard-data constraints. The framework incorporates differentiable geostatistical regularizers into the latent denoising objective, thereby embedding explicit spatial priors throughout the generative process. We further adopt tri-modal training strategy with a stochastic conditioning dropout to reduce deterministic shortcut mappings and improve diversity under strict hard-data conditioning. Evaluation across stationary meandering channels, non-stationary prograding deltas, and multi-facies systems shows that GiLDM maintains high hard-data fidelity, with hard-data hit rates exceeding 99.9% in the meandering-channel and prograding-delta cases. Compared with DS, cGAN, and CMS-SinGAN, GiLDM yields more coherent facies structures and better preserves long-range continuity under sparse hard-data constraints. It also retains same-condition ensemble diversity, with pairwise L1 distances ranging from 0.0606 to 0.109 in both binary cases. Overall, GiLDM generates facies realizations with improved geostatistical consistency and posterior variability, and can serve as a structural prior for subsequent groundwater-flow and contaminant-transport analysis.}
}
@article{MARTINLLANES2026136263,
title = {A hybrid decision-support framework for managing salt intrusion via controlled freshwater pulses in regulated estuaries},
journal = {Journal of Hydrology},
volume = {679},
pages = {136263},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136263},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013600},
author = {Guillermo Martín-Llanes and Erwan Garel and Alejandro López-Ruiz},
keywords = {Decision-support system, Water resource management, Salt intrusion, Estuaries},
abstract = {Managing salt intrusion in estuaries is critical given increasing freshwater scarcity and human-induced salinization. This study presents a transferable hybrid framework to support salt intrusion management in regulated estuaries, combining a three-dimensional Delft3D-Flow model with parameterized analytical equations for predicting salt intrusion under varying discharge. Model implementation is based on estuarine domains with idealized geometries, reducing human-resource demands while enhancing accessibility and reproducibility. The steady intrusion equation follows Hansen and Rattray (1966), whereas the unsteady intrusion equation follows Monismith (2017). The framework is demonstrated in the Guadiana Estuary and applied to: (1) identify the key variables controlling the salinity response to short-duration freshwater pulses, and (2) optimize freshwater-release strategies based on limited freshwater volumes. Results highlight the critical role of background flow over pulse configuration (i.e., peak discharge and duration) when pulse volume is constant: the period during which salt intrusion remains below x  = 47 km varies from 29 to 55 days as background flow increases from 6 to 8 m3 s−1, while increasing peak discharge from 300 to 1800 m3 s−1 extends that period by one day. For a fixed freshwater volume of 45 hm3 and a background flow of 4 m3 s−1, optimized release strategies yield maximum control durations of 15–125 days for intrusion threshold values between 30 and 50 km, respectively. Overall, the framework offers a practical decision-support tool that enhances stakeholder engagement in water resource and salt intrusion management, particularly by enabling rapid optimization of freshwater-release strategies under limited freshwater availability and user-defined salinity thresholds.}
}
@article{LI2026136282,
title = {Attribution of the 2021 record-breaking compound drought-heatwave extreme in Central Asia to anthropogenic warming, atmospheric circulation, and NAO},
journal = {Journal of Hydrology},
volume = {679},
pages = {136282},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136282},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601379X},
author = {Liangwei Li and Yaqi Yang and Xiang Zhang and Sijia Luo and Yansong Guan and Xihui Gu and Lunche Wang},
keywords = {Compound drought-heatwave extreme, Central Asia, Anticyclonic circulation anomaly, Anthropogenic warming},
abstract = {During the spring (April–June) of 2021, Central Asia experienced its most severe compound drought‑heatwave extreme (CDHE) in nearly 60 years, causing severe impacts on the regional environment, economy, and society. Anticyclonic circulation anomalies, anthropogenic warming, and the negative phase of the North Atlantic Oscillation (NAO) have been recognized as potential triggers of this CDHE, yet the quantitative contributions of each factor to its intensity and occurrence probability remain poorly understood. By introducing a storyline‑probability‑based attribution framework and leveraging reanalysis data and model simulations, this study finds that the CDHE intensity was jointly dominated by the anticyclonic circulation anomaly (contributing 44.08%) and anthropogenic warming (contributing 36.06%), while the NAO negative phase played a substantial modulating role. These factors increased the probability of CDHE by approximately 6.75, 32.30, and 3.44 times, respectively. Future projections indicate that the probability of a 2021-like CDHE depends strongly on the emission pathway and evaluation baseline. Under a moving baseline, the warming–wetting trend may attenuate drought intensity as defined by precipitation deficit, thereby reducing the probability of a 2021-like CDHE relative to the contemporaneous climate background. However, under a fixed historical baseline, the dominant role of heatwaves is accentuated, and the cumulative effect of anthropogenic warming yields a consistent upward trend in the probability of a 2021-like CDHE across all emission pathways. Our findings underscore that climate adaptation planning in Central Asia must account for the nonlinear and divergent responses of drought and heatwaves within the future context of regional warming-wetting trends.}
}
@article{ZHENG2026136271,
title = {Legacy effects amplify baseflow nitrogen export: Watershed-scale evidence from the largest lake-inflowing river on the Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {679},
pages = {136271},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136271},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013685},
author = {Yuanhao Zheng and Chenyue Niu and Lei Chen and Yan Chen and Qiang Wang and Guangying Li and Chenxi Wu and Zhenyao Shen},
keywords = {Nitrogen budget, Baseflow, Legacy-induced lagged effects, Plateau watersheds},
abstract = {Legacy nitrogen (N) release is threatening water security globally, yet its hydrological pathways in climate-sensitive regions remain poorly quantified, where refined analyses are essential for preventing water quality degradation. In this study, we integrated gridded N budgeting with hydrological modeling to analyze N dynamics (2010 ∼ 2023) in the Buha River Basin (BRB), the Tibetan Plateau’s largest lake-inflowing system. We then analyzed the spatiotemporal patterns and drivers of N surplus, and assessed their lagged effects through hydrological pathways. Results showed that the average N surplus increased by 0.04 kg N ha−1 yr−1 and 16.67% of subbasins reached significant levels (P < 0.05). Atmospheric deposition (59.51%) dominated N inputs, whereas leaching (40.99%) dominated N outputs in the BRB. The N surplus exhibited spatial heterogeneity with downstream hotspots resulting from the superposition of extensive atmospheric deposition and high-load livestock manure inputs. Baseflow has become increasingly dominant over direct runoff in driving riverine N (increasing from 59.59% to 65.05%), with its effects amplified by a four-year lagged legacy N. These findings highlight, from a baseflow perspective, the need for preventive N management in plateau watersheds beyond conventional agricultural controls.}
}
@article{LAMA2026136182,
title = {Influence of emergent and submerged plants on local hydrodynamics and turbulence anisotropy in vegetated rivers},
journal = {Journal of Hydrology},
volume = {679},
pages = {136182},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136182},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012795},
author = {Giuseppe Francesco Cesare Lama and Andrea Del Gaudio and Jyotirmoy Barman and Anurag Handique and Francesco {De Paola} and Giovanni Battista Chirico and Donatella Termini},
keywords = {, Ecohydraulics, Field measurements, Spectral analysis, Turbulence, Vegetated rivers},
abstract = {This study investigates the influence of three plants configurations – Full emergent Vegetation (FV), Central Cut (CC), and Extensive Cut (EC) – on the hydrodynamics and turbulence anisotropy within a reclamation channel colonized by rigid Phragmites australis plants. Turbulence anisotropy is quantified via both turbulence intensities and anisotropy invariant map (AIM) derived from the Reynolds stress deviatoric tensor. Results demonstrate that FV setup induces the highest anisotropy, characterized by a quasi-two-component (disk-like) turbulence regime due to enhanced horizontal fluctuations. Conversely, EC and CC configurations promote vertical fluctuations and near-bed oblate (disk-like, from three- to two-component) turbulence with transition to prolate (rod-like, from three- to one-component) anisotropy tendencies near the free surface. In the CC configuration, the side emergent uncut plants stands foster lateral velocity gradients and transverse momentum exchange. These results demonstrate how plants spatial distribution and submergence modulate local turbulence anisotropy and hydrodynamics governing vegetated watercourses.}
}
@article{ZHANG2026136203,
title = {A study on sediment forecasting using machine learning with structure-aware mechanisms},
journal = {Journal of Hydrology},
volume = {679},
pages = {136203},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136203},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013004},
author = {Yanmeng Zhang and Shengqi Jian and Faxian Liang and Huiliang Wang and Shentang Dou and Xin Yu},
keywords = {Sediment forecasting, Machine learning, Structural awareness mechanisms, Middle Yellow River},
abstract = {In recent years, machine learning has been widely applied in sediment forecasting; however, existing research has largely focused on the model algorithms themselves, with insufficient integration of the mechanistic characteristics of sediment transport processes (such as the response mechanism of sediment peaks and time-lag effects). This has resulted in limited forecasting capabilities for sudden sediment peaks in complex river basins. To address the challenge of highly abrupt and spatio-temporally variable sediment transport processes in the typical high-sediment- concentration basin of the middle Yellow River, this study proposes a machine learning model for sediment forecasting (ML-P-EF) incorporating a structural enhancement mechanism. Building upon LSTM (Long Short-Term Memory), ANN (Artificial Neural Network) and Transformer models, systematically incorporates Sediment Process Vectorization (SPV), Dynamic Lag Encoding (DLE) and Event-Driven Features (EDF) to enhance the model’s ability to perceive and simulate sediment physical processes. Through validation in typical catchment areas of the Jing River and Beiluo River in the middle reaches of the Yellow River, taking Hongde Station as an example, for a 1-hour forecast horizon, the ANN-P-EF model achieved a Nash efficiency coefficient (NSE) of 0.97 and a Root Mean Square Error (RMSE) of 52.31 kg∙m⁻3, and the peak sediment error was –3.81 %. Under a 6-hour forecast horizon, the NSE of the LSTM-P-EF model improved by more than 40 % compared to the LSTM-P and LSTM models, the RMSE decreased by over 50 %, and the peak error was reduced by 6 %–12 %. This study innovatively integrates the mechanisms of sediment transport processes with deep learning models, enhancing the model’s ability to capture the non-linear response of sediment peaks. It provides a new technical approach to accurate sediment forecasting in high-sediment river basins, with significant implications for regional water and sediment management as well as disaster prevention and mitigation.}
}
@article{FABIAN2026136255,
title = {Climate-informed streamflow forecasting based on a Bayesian autoregressive exogenous stochastic volatility model and its use for hydrological drought forecasting},
journal = {Journal of Hydrology},
volume = {679},
pages = {136255},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136255},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013521},
author = {Pamela Sofia Fabian and Hemie Cho and Yoo-Geun Ham and Hyun-Han Kwon},
keywords = {Bayesian autoregressive model, Climate state variable, Climate teleconnection, Drought index, Streamflow forecasting},
abstract = {In the context of South Korea’s recurring drought challenges, this study explores season-ahead predictability of hydrological drought, focusing on Bayesian autoregressive modeling incorporating stochastic volatility. To better understand uncertainty, our approach integrates Bayesian inference and stochastic volatility, with comparisons of conventional autoregressive (AR), autoregressive with exogenous variables (ARX), and autoregressive exogenous with stochastic volatility (ARXSV) models. Our study explores the integration of climate-based information with statistical modeling, presenting a comprehensive framework for water resource management. We aim to predict June–July–August (JJA) streamflow and to assess the influence of large-scale climate predictors, such as the sea surface temperature and sea level pressure associated with the North Atlantic Oscillation. The methodology encompasses exploratory data analyses, the use of hydrological drought indices, and considerations related to dam operation. The research provides tailored season-ahead streamflow forecasts specifically for the critical monsoon season JJA, where hydrometeorological variability is paramount. By incorporating climate information within a Bayesian inference framework and stochastic volatility, we show that the proposed approach outperforms conventional autoregressive models, providing decision-makers with an efficient tool to address climate risk and support dam operation planning, ultimately contributing to improved water-resources management.}
}
@article{JIAO2026136285,
title = {Seasonal regulation of dissolved organic and inorganic carbon in shallow groundwater of arid inland river basins: roles of recharge, evaporation, and hydrological processes},
journal = {Journal of Hydrology},
volume = {679},
pages = {136285},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136285},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601382X},
author = {Ayong Jiao and Jia Xu and Dongsheng Zhai and Bin Gao and Mingjiang Deng and Hongbo Ling},
keywords = {Arid inland river basin, Dissolved inorganic carbon, Dissolved organic carbon, Groundwater-table position, Hydrological processes},
abstract = {Groundwater systems play a critical role in the global carbon cycle. In arid inland river basins, the absence of hydrological pathways connecting to the ocean promotes the accumulation and storage of dissolved carbon (DC) within groundwater. However, the spatial distribution patterns and underlying controls of groundwater DC remain insufficiently understood. In this study, the Tarim River Basin was selected as a representative arid inland basin. Based on data from 72 monitoring wells, together with hydrological, hydrochemical, climatic, and remote sensing datasets, the spatial variations of dissolved organic carbon (DOC) and dissolved inorganic carbon (DIC) were examined across wet and dry hydrological periods. Results showed that DOC concentrations in the lower reach increased with distance from the river during the dry period, whereas this spatial gradient weakened during the wet period due to recharge-related dilution. DIC showed relatively weaker spatial variation but clear hydrological-period differences, with lower concentrations during the wet period. DOC and DIC were positively correlated across river reaches and hydrological periods, suggesting coupled variation under changing hydrological and hydrochemical conditions. Redundancy analysis indicated that DOC was primarily associated with groundwater-table position and evapotranspiration, whereas DIC was closely related to total dissolved solids, Ca2⁺, and carbonate-related hydrochemical conditions. Ecological water conveyance affected recharge processes and the river–groundwater connectivity, thereby influencing groundwater carbon storage and transport in the lower reach. Overall, groundwater DC dynamics in the Tarim River Basin were jointly shaped by hydrological connectivity, evapotranspiration, evaporative enrichment, and hydrochemical evolution.}
}
@article{ZHAO2026136274,
title = {Ecohydrological thresholds of alpine meadow slopes: Quantifying resilience limits under a warming-wetting climate},
journal = {Journal of Hydrology},
volume = {679},
pages = {136274},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136274},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013715},
author = {Haitao Zhao and Zhihong Zhang and Yanchen Guo and Fuchu Dai},
keywords = {Hydro-thermal coupling, Freeze–thaw landslide, Warm and humid climate, Slope stability, Alpine meadow vegetation},
abstract = {Alpine meadow vegetation (AMV) acts as a critical ecohydrological buffer in the cryosphere, playing a pivotal role in modulating active layer dynamics and mitigating shallow slope instability. However, the accelerating warming and wetting trend on the Qinghai-Tibet Plateau (QTP) is profoundly altering this hydro-thermal regime, yet the quantitative limits of such ecohydrological regulation remain unclear. This study investigates the complex feedback within the “climate-vegetation-soil” system by developing a process-based hydro-thermal coupled model that explicitly integrates root water uptake (RWU) and heat absorption functions. Unlike traditional approaches that simplify vegetation as mechanical reinforcement, our framework utilizes root biomass to characterize the vertical decay of root distribution, enabling precise simulation of soil moisture redistribution and phase change dynamics in frozen ground. Results demonstrate that alpine meadows exert a significant hydro-thermal buffering effect, reducing shallow soil temperatures by 0.13°C-0.42°C and peak volumetric water content (VWC) by 1.0%-2.6% through transpiration and shading. While this regulation enhances slope stability (safety factor increases by 3%-10%), we identified a critical hydrological tipping point. Under a coupled warming (+0.33°C) scenario, the critical rainfall intensity threshold for stability contracts from 5 mm/h to approximately 4 mm/h. Beyond this limit, excessive infiltration overwhelms the canopy’s bio-drainage capacity, rendering slope failure inevitable. These findings quantify the physical tipping points of ecohydrological regulation in the cryosphere, offering a critical scientific benchmark for optimizing Nature-based Solutions (NbS) against the non-linear risks of a warming-wetting climate.}
}
@article{PEEPLES2026136246,
title = {A hybrid machine learning and physics-based approach to model high-resolution inundation},
journal = {Journal of Hydrology},
volume = {679},
pages = {136246},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136246},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013430},
author = {Amelia Peeples and Elena Leonarduzzi and Laura E. Condon and Reed M. Maxwell},
keywords = {Random forest, Machine learning, ParFlow-CLM, Hydrologic model, Downscaling, Surface water},
abstract = {Large-scale high-resolution hydrologic modeling is necessary to understand future water availability and flood risk. This study uses a combined physics-based and machine learning modeling approach to produce accurate high-resolution inundation maps at a much lower computational cost than high-resolution physics-based modeling. The test domain is an 1800 km2 watershed in Colorado during the 2019 water year which is modeled in the integrated surface-subsurface model ParFlow-CLM at a 1 km resolution and then downscaled to a 100 m resolution binary inundation product using a random forest model. In addition to the 1 km resolution modeled inundation depth, other relevant parameters such as topographic slope, upstream area, and Manning’s roughness are inputs for the machine learning model. The random forest model was trained on a synthetic ground truth modeled by a 100 m resolution ParFlow-CLM model. The hybrid physics-based and machine learning approach is 97.6% accurate (F1 score of 0.96) in predicting high-resolution inundation status when compared to the 100 m resolution ParFlow-CLM model at 1/500th of the computational cost. This is more accurate than the 1 km model on its own, which is 67.4% accurate at a 100 m resolution. Even when only considering locations with temporally-variable inundation, the hybrid model is 93.6% accurate (F1 score of 0.91). The performance of the hybrid methodology given incomplete spatial or temporal training data was also tested and it was found that the model is 96.2% accurate in unseen timesteps and 86.4% accurate in unseen locations (F1 scores of 0.94 and 0.75 respectively). This study demonstrates the applicability of a hybrid physics-based and machine learning approach to produce accurate high-resolution surface inundation maps at a dramatically lower computational cost than high-resolution hydrologic modeling.}
}
@article{WANG2026136307,
title = {Groundwater-mediated divergence in forest soil CO2 emissions under extreme rainfall: hydrological and microbial perspectives at watershed scale},
journal = {Journal of Hydrology},
volume = {679},
pages = {136307},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136307},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014046},
author = {Pengtao Wang and Bairui He and Huihui Han and Jun Zhang and Fei Yu and Xin Wang and Yidi Wang and Shaoqing Liu},
keywords = {Forest soil CO emission, Groundwater flow, Dissolved organic carbon, Microbial community, Watershed hydrology},
abstract = {Increasingly frequent extreme rainfall events are altering carbon availability for forest soil microbes, introducing substantial uncertainty in soil CO2 emissions. This study investigated the dynamics and underlying mechanisms of forest soil CO2 emissions in the Qi River Basin (QRB), a temperate forest watershed frequently affected by extreme rainfall. Using a combination of hydrological modeling, simulated rainfall experiments, and field investigations, we found that groundwater flow is the dominant control on both autotrophic and heterotrophic respiration rates, explaining 46.6% of their variability. From 2001 to 2020, total forest soil CO2 emissions − derived from soil microbial respiration rates (Rmicrobe) and root respiration rates (Rroot) – showed distinct two-stage interannual variations, with an annual mean of 285.0–305.0 g C m−2 yr−1. Laboratory and field experiments indicated that extreme rainfall suppressed Rmicrobe primarily through the loss of dissolved organic carbon (DOC) via surface runoff, which depleted bioavailable carbon for soil microbes. In contrast, Rroot increased as reduced groundwater flow might indirectly influence root exudation. We observed significant differences (P < 0.05) in both DOC concentration and composition in surface runoff between upland forests and the downstream river; Microbial abundances also differed significantly (P < 0.05) between these sites. Groundwater flow, rather than surface runoff, was identified as the primary driver of spatial variability in both DOC and microbial abundance. Though annual forest soil CO2 emissions have stabilized recently, a projected decline in groundwater flow is expected to stimulate soil CO2 emissions. Targeted watershed management strategies focusing on maintaining groundwater recharge may be effective in enhancing temperate forest carbon sequestration and further confirmation is needed. These findings also highlight the role of subsurface hydrology in shaping forest carbon dynamics under changing rainfall regimes, with broader implications for improving the hydrological-carbon coupling in current Earth System models.}
}
@article{PARRA2026136157,
title = {Validation of GRACE, ERA5-Land and MODIS remote sensing products for groundwater monitoring in semiarid regions: A multi-basin study in Chile’s Coquimbo region},
journal = {Journal of Hydrology},
volume = {679},
pages = {136157},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136157},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012540},
author = {Francisco Parra and Juan Fernando Rubilar},
keywords = {Groundwater monitoring, Google Earth Engine, GRACE, Remote sensing validation, Semiarid hydrology, Chile, Multi-basin analysis},
abstract = {Groundwater monitoring in semiarid regions faces significant challenges due to sparse and expensive in-situ networks. We evaluate GRACE/GRACE-FO terrestrial water storage, ERA5-Land precipitation, and MODIS vegetation indices against 56 years (1970-2025) of depth-to-water-table measurements from 121 wells in Chile’s semiarid Coquimbo Region, spanning nine basins of which eight contain monitoring wells. Because depth to water is measured positive downward, wetter conditions correspond to negative correlations with storage products. Annual aggregation strengthens correlations relative to monthly analysis (GRACE: r=−0.17 to r=−0.56), but effective-sample-size corrections and first-difference analysis show that these correlations reflect a shared decadal drying trajectory rather than interannual coupling: year-to-year changes in depth to water are uncorrelated with GRACE. Formal trend analysis (Mann-Kendall with autocorrelation correction) establishes the trajectory-level agreement: before the 2010–2021 megadrought, depth to water (+0.34 m/yr) and JPL TWS (−0.96 cm/yr) show significant parallel trends. During the megadrought they decouple completely: depth to water deepens at + 0.50 m/yr (p = 0.0005) while none of three mascon solutions (JPL, CSR, GSFC) detects a storage trend. Multi-solution comparison further shows that the local GRACE signal is solution-dependent at this scale (inter-solution r = 0.36-0.54), with JPL redistributing an Andean-centered signal over the coastal basins. Error propagation shows the GLDAS-based groundwater separation is uncertainty-dominated (sigma of the same order as the signal). ERA5-Land precipitation shows no zero-lag association with depth to water, but a robust 1-year-lagged response (r=−0.38, p = 0.004, n = 55) that survives all statistical corrections — the only interannual coupling detected. Satellite gravimetry can corroborate regional decadal drying trajectories where dense well networks exist, but cannot substitute in-situ monitoring at the basin scale: it misses interannual variability and, critically, extraction-driven depletion. All scripts are available via GitHub.}
}
@article{FRESNE2026136270,
title = {Optimising river sampling and load calculation methods for total phosphorus: influence of catchment size and population},
journal = {Journal of Hydrology},
volume = {679},
pages = {136270},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136270},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013673},
author = {Maëlle Fresne and Phil Jordan and Raymond Wilson and Rachel Cassidy},
keywords = {Sampling frequency, Averaging method, Flow-weighting method, Bias, Precision, Lake},
abstract = {Reliable estimates of river nutrient load are critical benchmarks for catchment and receiving waterbody management. Low-frequency monitoring is known to underestimate phosphorus (P) loads in small catchments, yet performance in large catchments, sometimes including large urban areas, remains poorly evaluated. This study used synchronous sub-daily river discharge and concentration datasets from three catchments of contrasting size and population to evaluate how these characteristics influence the performance of sampling and load calculation methods for total P load estimation. Wilcoxon rank-sum tests were used to assess the impact of catchment size and population on load estimate accuracy, with bias and precision derived from accuracy distributions. Sampling method performance was strongly dependent on catchment size and, less consistently, population. The smaller, flashier, and lower-population catchments required higher-frequency sampling to better capture short-duration runoff events and temporally variable diffuse inputs, which likely contributed to a greater proportion of total loads. The larger, higher-population catchment produced better load estimates under lower-frequency sampling, likely due to steadier point source contributions. While load calculation method performance varied with catchment population, flow-weighting was the most robust approach. However, even when combined with this approach, low-frequency sampling in the large catchments resulted in biased or imprecise load estimates: for example, a standard weekly sampling produced minimal bias (-7.0%–+2.1%) but poor precision (20.3%–72.8%). The findings reveal the need to adapt monitoring protocols to catchment characteristics and to increase monitoring frequency in large rivers to at least daily (ideally 7-hourly) to better support effective catchment and waterbody management.}
}
@article{CHENG2026136238,
title = {Molecular-level source contribution of dissolved organic matter in a typical plateau lake using end-member mixing analysis based on spectroscopic, stable isotope and molecular fingerprint},
journal = {Journal of Hydrology},
volume = {679},
pages = {136238},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136238},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013351},
author = {Yunxuan Cheng and Shasha Liu and Rui Fu and Yi Ren and Yuxuan Zhang and Ziwen Yin and Fengchang Wu},
keywords = {Dissolved organic matter (DOM), Plateau Lake, Fourier transform ion cyclotron resonance mass spectrometry (FT-ICR MS), Quantification of source contributions, End-member mixing analysis (EMMA)},
abstract = {Lakes receive and actively process dissolved organic matter (DOM) from diverse sources, thereby influencing water quality and the global carbon cycle. Accurately identifying DOM sources and apportioning their relative contributions are critical for effective lake management and understanding carbon cycling in lacustrine ecosystems. However, precise source attribution remains challenging because DOM originates from heterogeneous sources and undergoes continuous biogeochemical transformations. Here, we quantified DOM source contributions in Erhai Lake, a typical plateau lake, using end-member mixing analysis based on stable isotope, spectroscopic, and molecular fingerprint data. The results indicated that wet season DOM exhibited stronger optical signatures of humification and aromaticity, greater molecular unsaturation, a higher oxidation state, and enrichment in nitrogen- and sulfur-containing formulas, whereas dry season DOM was more reduced and enriched in CHO formulas. Analysis of the potential DOM end-members showed that anthropogenic inputs, including manure and wastewater treatment plant effluent, were less humified and less unsaturated than natural watershed sources such as forest soil and riverine inputs, but more oxygenated than most internal lake sources, such as algae and bottom sediments. Comparison of lake and end-member DOM identified common relatively recalcitrant formulas, from which retained molecular markers were selected according to source specificity. Random forest analysis was then used to select indicative parameters of these markers for incorporation into the end-member mixing models. Based on convergence diagnostics and posterior credible intervals, the model incorporating stable isotope, optical, and molecular data was identified as optimal and was subsequently used to quantify DOM sources in Erhai Lake. The model results showed that anthropogenic inputs made the largest contribution in both seasons, accounting for 44.61% in the dry season and 42.63% in the wet season. Natural watershed sources contributed 29.24% and 26.54% of the DOM pool during the dry and wet seasons, respectively, whereas internal lake sources accounted for 26.15% and 30.83%, respectively. Manure was the largest individual source in the dry season (34.03%), whereas agricultural runoff was the largest individual source in the wet season (15.93%). This framework provides a molecularly constrained approach for DOM source apportionment and highlights hydrological control over seasonal source structure in Erhai Lake.}
}
@article{WU2026136262,
title = {Assessment of long-term nitrate storage and transport in an agricultural basin},
journal = {Journal of Hydrology},
volume = {679},
pages = {136262},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136262},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013594},
author = {Rixin Wu and Yang Zhan and Kewei Chen and Michele Lancia and Xiaolin Zhu and Yushan Wang and Zhenzhong Zeng and Huizhong Shen and Jianhuai Ye and Aminjon Gulakhmadov and Kholzoda Bakhtiyor Kishvar and Zhilin Guo},
keywords = {Nitrate contamination, Groundwater quality, Groundwater level recovery, Thick vadose zone},
abstract = {Surface nitrogen loading can accumulate in the vadose zone, posing a critical long-term threat to groundwater quality. In the Daqinghe (DQH) Basin, decades of intensive groundwater extraction have deepened the water table and substantially increased vadose-zone thickness. This study employs SWAT and MODFLOW6 models, incorporating the Unsaturated Zone Transport (UZT) package, to simulate nitrate transport processes across the root zone–vadose zone–aquifer continuum and quantify basin-scale groundwater nitrate contamination. Model evaluation showed moderate agreement with observations, with R2 values of 0.581 for annual streamflow, 0.663 for groundwater depth, and 0.671 for groundwater nitrate concentrations. By explicitly representing nitrate storage and delayed transport within a dynamically changing thick vadose zone, the framework links long-term groundwater-level change to nitrate delivery to the aquifer. From 1996 to 2016, progressive water-table decline increased simulated vadose-zone nitrate storage by 331%, confirming its role as both a temporary buffer and a legacy contaminant reservoir. Under the managed-recovery scenario, the proportion of the plain area exceeding the groundwater nitrate standard is projected to increase from 28.14% in 2020 to 72.3% in 2035. Comparisons among future pumping scenarios indicate that this deterioration is driven largely by the delayed arrival of legacy nitrate, while groundwater recovery may further alter its transfer to the aquifer. Groundwater-level restoration may therefore precede water-quality improvement by decades. Sustainable management should integrate groundwater recovery, nitrate monitoring, and agricultural nitrogen control rather than treating water quantity and quality separately.}
}
@article{WANG2026136222,
title = {Enhanced simulations of overland-gully-sewer flow interactions in coupled three-layer dual drainage modeling},
journal = {Journal of Hydrology},
volume = {679},
pages = {136222},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136222},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013193},
author = {Chia-Ho Wang and Hsiang-Lin Yu and Tsang-Jung Chang and Albert S. Chen},
keywords = {Integrated urban inundation modeling, Cellular automata, Dynamic flow interaction, 2D overland flow, 1D virtual gully flow, 1D sewer flow},
abstract = {This study presents an enhanced approach for efficient and accurate simulations of overland-gully-sewer (2D-1D-1D) urban inundation modeling for highly urbanized areas with gully networks. The current 2D-1D-1D urban inundation modeling is a three-layer dual drainage model that comprises a 2D overland flow model (2D-OFM), a 1D gully flow model (1D-GFM), a 1D sewer flow model (1D-SFM), and dynamic interactions among them. Despite its favorable performance, its applicability remains limited as its 1D-GFM requires substantial detailed local drainage (gully) data to build and maintain. Also, 1D-GFM simulates gully flows by an iterative process such that the overall efficiency is constrained when heavy computational demands are introduced by excessive gullies and gully inlets. In view of this, a novel 1D virtual gully flow model (1D-VGFM) is proposed to replace 1D-GFM. It requires less detailed drainage data to build and can simulate gully flows using simple algebraic equations. Based on results from three historical flood events, the present approach maintains accuracy comparable to that of the selected conventional approach, while significantly reducing the data complexity for gully system representation from 11 to 3 and achieving a satisfactory acceleration of up to 42.5%. As a result, it is proven to be a useful alternative for urban inundation modeling.}
}
@article{ZHANG2026136266,
title = {Regional atmospheric pattern shifts associated with weather whiplash events in the upper Yangtze River Basin},
journal = {Journal of Hydrology},
volume = {679},
pages = {136266},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136266},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013636},
author = {Erya Zhang and Wenhui Li and Shu Chen and Wenquan Gu and Xiaoyan Zhai and Xuezhi Tan},
keywords = {Self-organizing map, Weather whiplash events, Upper Yangtze River Basin, Synoptic atmospheric circulations},
abstract = {Global warming and intensified water cycles have led to an increase in weather whiplash events (WWEs), threatening ecosystems and human societies. However, the connection between WWEs and atmospheric circulation dynamics remains poorly understood, particularly through the lens of spatial clustering. This study applies the self-organizing map algorithm to cluster 500 hPa geopotential height (1979–2022) in the upper Yangtze River Basin (UYRB) and identify WWEs based on atmospheric circulation pattern shifts. We evaluate long-term trends in representative atmospheric patterns, extreme events, and WWEs, while exploring their linkages to large-scale circulation backgrounds. Results indicate a significant increase in the frequency of dry-warm patterns and a corresponding decrease in wet-cold patterns, confirming a warming and drying trend in the UYRB. Extreme warm events have risen across all seasons, with increased precipitation volatility in dry-warm patterns. The persistence of dry-warm patterns has also increased, along with a growing number of WWEs originating from dry-warm patterns. These changes are closely linked to dynamic changes in synoptic circulation patterns and moisture transport anomalies.}
}
@article{HATLEY2026136177,
title = {Reservoir releases and land cover interact to drive event-scale nitrate export in a large agricultural basin},
journal = {Journal of Hydrology},
volume = {679},
pages = {136177},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136177},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012746},
author = {Camden Hatley and Erin C. Seybold and Sam Zipper and Amy J. Burgin and Dustin W. Kincaid and Li Li and Julia N. Perdrial and Donna M. Rizzo and Kristen L. Underwood},
abstract = {Understanding the drivers of nitrate export in rivers is critical for developing effective nutrient management strategies. However, few studies have explored event-scale drivers of export in large river basins with human modifications like reservoirs. Here, we analyzed nitrate concentration-discharge (C-Q) relationships from 215 events at the outlet of the Kansas River Basin, USA (155,690 km2) from 2014 to 2022 to (1) characterize event-scale nitrate export behaviors in a large agricultural basin, and (2) determine how different event characteristics are linked to these behaviors. We found that C-Q behaviors varied greatly, with 60% of events producing nitrate enrichment (n = 130) and 40% of events producing nitrate dilution (n = 85). These behaviors were correlated with complex spatial interlinkages between climate and land cover: across most of the basin, nitrate enrichment was correlated with drier antecedent conditions, but in wetter areas with higher proportions of urban and forested land cover, enrichment was more strongly correlated with precipitation magnitude/intensity. This difference in hydroclimatic controls on nitrate export might be related to differential distributions of nitrate sources within these land covers. Upstream of major reservoirs, however, neither variable was strongly correlated with C-Q behavior, suggesting that nitrate attenuation within reservoirs decouples event-scale concentration signals in upstream waters from those downstream. Reservoir outflows had variable impacts on C-Q behavior, reflecting reservoir-specific variations in nitrate attenuation efficiency. Together, these results identify specific complex interactions between hydroclimate, land cover, reservoir positioning, and individual reservoir properties that control event-scale nitrate export from large basins.}
}
@article{YUAN2026136290,
title = {A national-scale comparison of carbon dioxide emissions from lakes and reservoirs in China},
journal = {Journal of Hydrology},
volume = {679},
pages = {136290},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136290},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013879},
author = {Danni Yuan and Zifan Wang and Y.Jun Xu and Ping Jiang and Siyue Li},
keywords = {COemissions, CO, Inland waters, Interannual variability},
abstract = {Lakes and reservoirs are the two dominant lentic ecosystems worldwide, yet their respective contributions to large-scale CO2 emissions remain poorly constrained. Here, CO2 evasion from 165 inland water bodies across five limnological regions of China, including the Northeast Plain and Mountain Lake (NPML), Eastern Plain Lake (EPL), Inner Mongolia–Xinjiang Lake (IMXL), Yunnan–Guizhou Plateau Lake (YGPL), and Tibetan Plateau Lake (TPL) regions, was quantified during 2021–2023 using a random forest model to predict water alkalinity for subsequent CO2 calculations. Total annual emissions were estimated at 7.41 ± 1.04 Tg C, with lakes contributing the majority (7.02 ± 1.09 Tg C yr−1) and reservoirs accounting for a much smaller fraction (0.39 ± 0.01 Tg C yr−1). Lake emissions displayed a non-monotonic inter-annual pattern, declining from 2021 to 2022 before increasing in 2023, whereas reservoir emissions showed limited interannual variation. Strong spatiotemporal contrasts further distinguished the two systems, with lake emissions peaking in summer–autumn in the NPML and EPL regions, and reservoir emissions maximized in winter in the YGPL and NPML regions. These findings reveal fundamentally different spatiotemporal emission regimes between lakes and reservoirs, indicating that aggregating the two systems can mask key variability in inland-water carbon fluxes.}
}
@article{LI2026136258,
title = {Multi-objective storage optimization for the cascade sluice group canal system based on hydraulic response relationships and feasible search space},
journal = {Journal of Hydrology},
volume = {679},
pages = {136258},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136258},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013557},
author = {Quan Li and Xiaohui Lei and Chao Wang and Pengyu Jin and Zhao Zhang and Xiaonan Chen and Zhongzheng He},
keywords = {Cascade sluice group canal system, Operation optimization, Hydraulic response relationship, Feasible search space},
abstract = {The operation optimization of a Cascade Sluice Group Canal System faces two core challenges. The conventional volume compensation model fails to incorporate hydraulic response characteristics, leading to a lack of effective water-level constraints and a fitness function of high-dimensional optimization problems that makes convergence difficult. We propose FSS-MOSOM, a multi-objective storage optimization model (MOSOM) that incorporates hydraulic response relationships to ensure compliance with water-level constraints. The model introduces a feasible search space (FSS) to reduce the search space before optimization, thereby alleviating the computational burden and improving computational efficiency. FSS-MOSOM is implemented on the final 13 canal pools of the South-to-North Water Diversion Middle Route Project. Compared with volume compensation scheduling, the proposed FSS-MOSOM scheduling reduces the maximum water-level deviation from −0.15 to −0.04 m at the end of the prediction period and the maximum average absolute deviation from 0.12 to 0.05 m. FSS-MOSOM exhibits superior optimization performance compared to MOSOM without search space reduction. This includes improved stability of the optimization results, accelerated convergence speed, and the ability to find quasi-optimal solutions. The proposed model substantially narrows the search space and enhances water-level regulation, providing a method for scheduling decisions for water transfer projects.}
}
@article{BIRYLO2026136294,
title = {Regime shifts in European basins detected from the water budget and the Combined Climatological Deviation Index},
journal = {Journal of Hydrology},
volume = {679},
pages = {136294},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136294},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013910},
author = {Monika Birylo},
keywords = {Water budget, CCDI, Pettitt test, Bai-Perron test, Moving average, European basins},
abstract = {Climate regime shifts in Europe are abrupt and statistically robust, whereas hydrological regime shifts are smoother, delayed, and basin-dependent. However, these changes require continuous monitoring to enable a quick response to emerging disturbances. The study aims to assess the water regime and changes in the ten major basins in Europe, using water budget series, the Combined Climatologic Deviation analysed with the Pettitt and Bai-Perron tests. Based on the research, basins exhibit evidence of hydroclimatic reorganisation after approximately 2015, although the timing and magnitude vary substantially between regions. The proposed framework investigates whether independently derived climatic forcing and total water storage observations reveal coherent hydroclimatic regime shifts at the basin scale. This approach provides new insight into the timing, persistence and physical interpretation of hydroclimatic transitions across major European basins.}
}
@article{XU2026136303,
title = {A network-based framework for deciphering extreme precipitation propagation across China},
journal = {Journal of Hydrology},
volume = {679},
pages = {136303},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136303},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014009},
author = {Yingying Xu and Zhiyong Liu and Yifan Huang and Yuhao Liu and Caihong Hu},
keywords = {Extreme precipitation, Propagation networks, Spatially constrained community detection, Spatiotemporal dynamics, Hydroclimatic connectivity},
abstract = {The increasing frequency and intensity of extreme precipitation under climate change pose growing challenges for disaster management and water governance. A network-based framework is developed that integrates spatial pattern analysis, propagation networks, community structures, and temporal evolution to characterize extreme precipitation propagation across China. Extreme precipitation events are robustly identified using a dual-threshold approach that accounts for regional characteristics and seasonal anomalies. A spatially constrained community detection method, combining the Louvain algorithm with K-means correction, is employed to delineate extreme precipitation propagation communities across eleven consecutive 5-year windows. Results reveal a pronounced southeast-northwest precipitation gradient, with coastal monsoon regions and the middle-lower Yangtze Basin acting as core propagation hubs, while arid inland and high-altitude regions remain weakly connected. Geomorphological features, including river valleys and mountain passes, serve as key relay corridors, facilitating long-distance signal propagation. Approximately 68% of propagation events occur within communities, with boundaries aligned to terrain and river basins while exhibiting clear nonstationary evolution over time. By capturing cross-basin propagation and trends of intensified propagation with shorter time lags, the analysis reveals how localized extremes are dynamically linked to system-scale cascading processes. The framework further provides a quantitative basis for diagnosing regional hydroclimatic connectivity, enhancing early-warning capabilities, and supporting coordinated cross-basin flood risk management in complex monsoon-influenced regions.}
}
@article{YANG2026136250,
title = {Spatial attribution analysis of river water quality by integrating remote sensing inversion and multi-source land cover data: An interpretable topological residual Knowledge-Driven Graph Attention Network (ITRK-GAT)},
journal = {Journal of Hydrology},
volume = {679},
pages = {136250},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136250},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013478},
author = {Xiaonan Yang and Peixiong He and Yang Zhang and Yong Bao and Hongyan Zhang and Jiansheng Wang and Li Sun and Songjia Zhang and Yong Liu and Qingli Li},
keywords = {Multispectral, Water quality, Terrestrial driving mechanisms, Graph attention network, Integrated gradients},
abstract = {Accelerating urbanization places urban river networks under intense, spatially heterogeneous human pressure; yet conventional remote-sensing inversion, though effective for large-scale monitoring, reveals little about pollution sources, transport pathways, or their terrestrial mechanisms. To help bridge this “inversion-over-attribution” gap, this study proposes an interpretable Topological Residual Knowledge-Driven Graph Attention Network (ITRK-GAT), for the Lianqi River, Shanghai. The framework couples multi-source terrestrial features—land use, discharge outfalls, and pollution-related enterprises—with river-network topology through an undirected graph over river grid units, in which topological relationships and along-stream distance priors act as structural constraints for physically consistent propagation. Chemical oxygen demand (COD) is predicted with accuracy outperforming standard graph and tabular baselines, and ablation confirms the contribution of each module. Integrated Gradients attribution and attention mapping jointly indicate that residential and industrial land use, together with discharge outfalls, are most strongly associated with elevated COD, with high-attribution regions co-located with tributary confluences and discharge-dense corridors. Controlled perturbation further shows that these associations propagate along network connectivity and attenuate with topological distance, while the attribution ranking stays stable under inversion-induced label noise. Together, these analyses establish a robust, physically coherent attribution framework offering an interpretable and transferable basis for pollution-source tracing and spatially differentiated management of urban rivers.}
}
@article{LI2026136242,
title = {Domain-knowledge-guided deep learning for probabilistic precipitation downscaling over southeastern Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {679},
pages = {136242},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136242},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013399},
author = {Dayang Li and Baoxiang Pan and Yuan Liu and Ashish Sharma and Yan Zhou and Yi Yao and Jun Yin and Long Yang},
keywords = {Probabilistic precipitation downscaling, Deep learning, WRF, Heteroscedasticity, Spatiotemporal dependencies, Tibetan Plateau},
abstract = {Precipitation downscaling, particularly at convection-permitting scales, is highly uncertain. This is especially pronounced in mountainous regions, such as the Tibetan Plateau (TP), due to the complex topography and atmospheric dynamics, hindering reliable estimation of variability and risk in extreme localized rainstorms. Deep learning-based downscaling methods have gained increasing attention but have primarily focused on deterministic results, which fail to capture uncertainty. Here we proposed a Probabilistic High-resolution Precipitation Downscaling Network (P-HPDNet) by incorporating domain knowledge of key precipitation characteristics to guide its loss function and model architecture. The negative log-likelihood loss function was derived to address zero-inflation, high skewness, and heteroscedasticity in the precipitation distribution. The model architecture incorporates convolutional layers, long short-term memory network layers, and spatial attention mechanisms to capture spatial and temporal precipitation dependencies. P-HPDNet was tested over southeastern TP, a mountainous region lacking high-resolution precipitation data. A ten-year dataset of daily precipitation data at 9-km and 1-km resolutions was derived from Weather Research and Forecasting model simulations to train P-HPDNet. Compared with a baseline model that lacks domain knowledge guidance, P-HPDNet reduces the continuous ranked probability score by 28% for all precipitation values, with an even larger reduction of 55% for extreme precipitation. Furthermore, P-HPDNet was applied to downscale a satellite-based precipitation product without retraining, demonstrating significant improvements in capturing both temporal and spatial dependencies of precipitation. Our study highlights the importance of incorporating domain knowledge of precipitation characteristics into deep learning models, offering an efficient downscaling approach for regions with complex terrains.}
}
@article{TAU2026136226,
title = {Evaporation, energy balance, and paleohydrology of the lakes along the Dead Sea rift},
journal = {Journal of Hydrology},
volume = {679},
pages = {136226},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136226},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013235},
author = {G. Tau and Y. Enzel and I. Sirota and N.G. Lensky},
keywords = {Lake evaporation, Paleoclimate reconstructions, Eddy covariance, Lake energy balance, Thermal equilibrium, Latent heat, Dead Sea, Lake Lisan, Lake Kinneret, Hula Lake},
abstract = {Lake evaporation is a dominant yet poorly constrained component of water and energy budgets. This uncertainty critically undermines necessary paleoclimate reconstructions, particularly for terminal lakes, whose levels are considered the best direct indicators of the precise balance between catchment precipitation and evaporative losses. We address this by applying a physically grounded framework for lake evaporation based on a hybrid approach of direct measurements and theoretical analysis of lake energy-balance and its thermal-equilibrium solution, combined with calibrated bulk formulae. High-resolution data from long-term eddy-covariance measurements at three adjacent Dead Sea Rift lakes—spanning wide gradients in salinity (freshwater to hypersaline), climate (Mediterranean to hyper-arid), and thermal structure—were used to calibrate bulk formulae relating environmental forcing to heat fluxes. We show that the thermal equilibrium approach depends on the lake’s thermal response time; shallow lakes reach equilibrium at intra-annual timescales, whereas deeper stratified lakes require annual forcing. These observations, combined with accurate bulk formulae that relates to the environmental conditions, provides tools for modeling global lake evaporation using only standard environmental data and for reconstructing paleo-evaporation. Applying this framework to the Last Glacial Maximum (LGM) highstand of Lake Lisan (the Levant), we bound evaporation rates and determine that a minimum annual water inflow approximately four times greater than modern levels was required to stabilize the lake. These results indicate significantly higher precipitation in the Dead Sea watershed during the LGM.}
}
@article{GAO2026136278,
title = {Physical continuous-simulation SWAT + framework to develop flow duration curves within the contiguous United States},
journal = {Journal of Hydrology},
volume = {679},
pages = {136278},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136278},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013752},
author = {Jungang Gao and Natalja Čerkasova and Michael J. White and Peter Allen and Jeffrey G. Arnold and Katrin Bieger and Mazdak Arabi and Ryan Bailey},
keywords = {Flow duration curve, SWAT+, National agroecosystem model, Streamflow quantiles, Calibration},
abstract = {The flow duration curve (FDC) is a fundamental tool in hydrology representing the cumulative distribution function of streamflow with time. As such, it is a valuable indicator of watershed performance, being controlled by rainfall, runoff, and storage. The shape of the FDC represents the complex interactions of climate, geology, topography, vegetation and human activities. This study is a novel effort to predict the FDC using a continuous simulation daily time step model calibrated to mean annual flow for CONUS (Contiguous United States of America). Model performance was evaluated using long-term USGS streamflow records from relatively undisturbed gages, while sites substantially affected by major reservoirs and water diversions were excluded. Model outputs are compared regionally to modeled FDCs and gage data. Output is compiled by NHDPlus reach for CONUS. Evaluations based on representative FDC quantiles demonstrate the model’s ability to simulate high, medium, and low flows with average Nash-Sutcliffe Efficiency (NSE) values of 0.69, 0.84, and 0.56, respectively. The significant advantage of employing a continuous simulation model lies in its ability to simulate diverse climate and land use scenarios, offering valuable insights beyond historical data limitations.}
}
@article{DUAN2026136293,
title = {Spatiotemporal variation of extreme precipitation and its terrain modulation in the Hengduan Mountains: machine learning and interpretable analysis},
journal = {Journal of Hydrology},
volume = {679},
pages = {136293},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136293},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013909},
author = {Qiyan Duan and Guokun Chen and Xingwu Duan and Qingke Wen and Haijuan Zhao and Fengyuya Jing and Zhiyuan Chen},
keywords = {Extreme precipitation, Event synchronization, Spatial homogeneity, XGBoost regression, Hengduan Mountains, Machine learning interpretability},
abstract = {Extreme precipitation events have a significant impact on hydrological processes and disaster risks, especially in mountainous areas with complex topography, where precipitation patterns exert stronger exacerbating effects. However, existing studies mostly focus on statistical trends, and the understanding of the spatial organization, propagation characteristics, and topographic control mechanisms of extreme precipitation is still limited. This study uses high-resolution daily precipitation data from 2005 to 2024, along with ten ETCCDI indices, to systematically examine the spatiotemporal evolution of extreme precipitation in the Hengduan Mountains. Through event synchronicity and lag analysis, the regional variations and propagation paths of extreme precipitation events are characterized. Additionally, a spatial homogeneity index is introduced to quantify the spatial organization of the extreme precipitation field. Furthermore, this research applies the XGBoost regression framework, complemented by SHAP, CP-PD, and permutation feature importance (PFI) analysis, to investigate the nonlinear influence of topographic factors on different types of extreme precipitation. The results indicate that extreme precipitation in the Hengduan Mountains primarily exhibits a gradual evolution rather than abrupt changes, with a significant increase in intensity during the rainy season. Specifically, intensity-related indices such as PRCPTOT, Rx5day, and R95p show consistent positive trends, with slopes ranging from 0.35 to 1.71 in most regions, indicating stronger and more frequent precipitation events. Spatially, extreme precipitation demonstrates a clear southeast-northwest contrast, with higher intensity observed in low latitudes and orographically uplifted areas. Event synchronicity analysis reveals significant regional variability during the monsoon season, while lag and spatial evenness analyses identify a stable south-to-north propagation pattern, showing a south-to-north statistical sequence that is seasonally consistent with the background monsoon circulation and regional topographic organization. Machine learning results show that elevation provides the largest predictive contribution within the XGBoost models the spatial distribution of extreme precipitation, with elevation scores (SHAP analysis) reaching up to 0.70 for extreme indices such as R99p, while slope, curvature, and elevation play significant roles in modulating moderate-intensity extreme events. In contrast, the model attribution becomes increasingly concentrated on elevation for the most extreme events like R99p.}
}
@article{WAN2026136253,
title = {Elevation-dependent hydrological vulnerability of lakes and reservoirs to evaporation loss in the Yarlung Zangbo River Basin, Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {679},
pages = {136253},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136253},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013508},
author = {Chengwei Wan and Chenghao Chen and Grzegorz Skrzypek and John J. Gibson and Xuegao Chen and Xiang Xu and Peng Yi and Kei Yoshimura and Hayoung Bong and Xicai Pan},
keywords = {Asian water tower, The Yarlung Zangbo River Basin, Alpine lakes and reservoirs, Evaporative water loss, Isotope mass balance (IMB), Isotopic altitude effect},
abstract = {The Tibetan Plateau’s Yarlung Zangbo River Basin is undergoing rapid hydroclimatic transitions compounded by extensive reservoir development. Accurately quantifying evaporative water losses and water balance and interpreting their associated isotopic signatures is critical for improving hydrological models and regional water security assessment. In this study, we tested the application of an isotope-based Bayesian framework for quantifying evaporation and water balance dynamics. Utilizing steady-state models for the long-term water balance of natural lakes and transient models for the short-term water balance of artificial reservoirs, this framework calculated a unified mass-balance metric, the evaporative loss index (E/(E+Q)), where E represents evaporative water loss and Q denotes water outflow. Results reveal that despite operating on different temporal scales, the inflow-dependent evaporative loss indices exhibit diametrically opposed altitudinal dependencies between lakes and reservoirs, which can substantially mask the natural riverine δ18O altitude effect. Natural lakes, for which evaporative loss index is functionally equivalent to the evaporation-to-inflow ratio under steady-state conditions, are found to have average values of 0.27 ± 0.19 and show a strong positive correlation with elevation. In high-altitude basins (> 4500 m a.s.l.), limited natural inflows cause substantial proportional evaporative losses relative to the water balance (mean E/(E+Q) = 0.51), highlighting severe hydrological vulnerability to evaporative loss despite low absolute evaporation rates. This intense fractionation can substantially modify the pristine cryospheric baseflow, acting as a contributing mechanism to the reversal of the steep negative gradient in localized surface waters.. Conversely, artifically-constructed reservoirs exhibit a negative altitudinal evaporative gradient, with evaporation accounting for 0.47 ± 0.16 of total water losses in low-elevation shallow basins during the dry season. Rapid downstream transport of water from high-altitude reservoirs disrupts and homogenizes natural isotopic gradients in rivers. This systematic disruption of natural isotopic baselines by both climate-driven evaporation and human water retention explicitly warns against utilizing uncorrected surface water isotopes for hydrological tracing or paleoaltimetry reconstructions. These findings highlight extreme vulnerabilities in regional water security, demanding altitude-specific management adaptations.}
}
@article{LUO2026136297,
title = {Hydraulic tomography for characterizing subsurface heterogeneity in fractured rocks: implications for in-situ recovery mining},
journal = {Journal of Hydrology},
volume = {679},
pages = {136297},
year = {2026},
