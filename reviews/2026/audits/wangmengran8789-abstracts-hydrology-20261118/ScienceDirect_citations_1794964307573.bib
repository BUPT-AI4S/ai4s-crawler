@article{LIM2026135522,
title = {Palaeochannels as hidden pathways of water flow in agricultural alluvial landscapes: A review of concepts and suggested future directions for modelling},
journal = {Journal of Hydrology},
volume = {674},
pages = {135522},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135522},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006190},
author = {Han She Lim and Alexander W. Cheesman and Paul N. Nelson and Rohan Eccles and Felix Egger and Marcus Bulstrode and Tony Weber},
keywords = {Palaeochannels, Preferential flow, Hydrologic connectivity, Subsurface drainage, Water quality, Agriculture, Coupled modelling (HYDRUS-MODFLOW, SWAT-MODFLOW, MIKE-SHE, HydroGeoSphere)},
abstract = {Sustaining agricultural productivity while reducing off-site impacts on water quality requires a detailed understanding of water and nutrient movement through alluvial landscapes. Within these settings, palaeochannels − old river courses infilled with coarse sediments − represent major but poorly quantified subsurface flow pathways. Their influence on water and solute transport is rarely incorporated into hydrological assessments or models, despite their widespread occurrence and hydraulic connectivity with surface drains, aquifers and streams. This paper reviews current knowledge of palaeochannel structure, distribution and hydrologic function within agricultural alluvial systems, and evaluates approaches for their identification, characterisation and representation in hydrologic models. We examine the suitability of existing coupled modelling frameworks − such as HYDRUS-MODFLOW, SWAT-MODFLOW, MIKE-SHE and HydroGeoSphere − for simulating palaeochannel-mediated flow and material transport. Conceptual similarities between palaeochannels and engineered tile-drain networks are used to illustrate how established drainage formulations can inform future model development. We highlight virtual experimentation, combining numerical simulation with targeted field monitoring, as a practical means of exploring how palaeochannel geometry, depth and connectivity influence water and nutrient fluxes at field to catchment scales. Integration of direct and remote sensing with coupled hydrological models will enhance the capacity to parameterise and validate palaeochannel networks. Collectively, these advances provide a pathway towards more realistic representations of subsurface flow heterogeneity, improving predictions of water and solute movement and informing management strategies in intensively farmed alluvial landscapes.}
}
@article{XU2026135510,
title = {Rock outcrops and bedrock morphology impact on runoff and erosion processes in karst slopes},
journal = {Journal of Hydrology},
volume = {674},
pages = {135510},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135510},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006074},
author = {Haodong Xu and Chunhui Wei and Fengjiao Pan and Haoyang Xin and Zhenwei Li and Liangxia Duan},
keywords = {Soil erosion, Rock coverage, Bedrock morphology, Rock and soil interface, Karst ecosystems, Subsurface},
abstract = {In karst regions, surface rock coverage and underlying undulating bedrock (UB) can profoundly influence soil erosion. However, the effect of surface rock coverage and UB on multi-layered hydrological and sediment transport processes (surface, rock and soil interface, and subsurface) is still not clear. To address this issue, this study aimed to investigate the effects of rock coverage and bedrock morphologies on runoff generation and sediment yield in karst slopes. Experimental slopes with flat bedrock (FB) and UB were constructed, each designed with seven levels of surface rock coverage ranging from 0 % to 60 %. Runoff and sediment data were collected from surface, rock and soil interface and subsurface layers under a 30 min simulated rainfall with an intensity of 120 mm · h⁻1. Results showed that, on UB slopes, surface runoff (SR) was significantly positively correlated with rock coverage (P < 0.01), while subsurface runoff (SBR) exhibited a significant negative correlation (P < 0.05). On FB slopes, SR was also extremely positively correlated with rock coverage (P < 0.01), whereas rock and soil interface runoff (RSR) showed a significant negative correlation (P < 0.05). UB can significantly alter runoff partitioning. In UB slopes, SBR was significantly negatively correlated with rock coverage (P < 0.05), decreasing from 77.8 % at 0 % coverage to 21.8 % at 60 % coverage. Across all rock coverage levels, UB slopes exhibited higher proportions of SR but lower proportions of RSR compared with FB slopes. In FB slopes, RSR was also significantly negatively correlated with rock coverage (P < 0.05), declining from 39.6 % to 18.7 % as coverage increased from 0 % to 60 %. These findings indicate that both surface rock coverage and bedrock morphology exert substantial effects on soil erosion processes in karst regions. The results provide valuable insights for future experimental simulations and practical soil and water conservation strategies in rocky desertification areas.}
}
@article{CHEN2026135501,
title = {DMCG: Diffusion-based multi-category generation network for characterizing heterogeneous hydrogeological structures},
journal = {Journal of Hydrology},
volume = {674},
pages = {135501},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135501},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005986},
author = {Dajie Chen and Qiyu Chen and Hongfeng Fang and Xiaogang Ma and Gang Liu},
keywords = {Aquifer characterization, Heterogeneous pattern learning, Diffusion model, Deep learning},
abstract = {Hydrogeological structures often contain heterogeneous patterns (i.e., multiple-type facies and aquifers), making the characterization of multiple type structures a challenging task in geological modeling. The existing deep learning-based methods are insufficient to learn multiple-pattern features within a single training process, which affects the accuracy and efficiency of aquifer structure characterization. In this work, a Diffusion-based Multi-Category Generation (DMCG) network is proposed to unify the learning of multiple patterns contained in different types of aquifer structures. This method integrates geological observations (e.g., drilling and cross-section) and category labels and uses U-Net to establish the relationship between input data and spatial features. The embedding of category labels is the key factor for DMCG to learn different type aquifers. Moreover, a vector quantized variational autoencoder is employed to implement a latent diffusion model, which can reduce the memory requirement for training and improve characterization efficiency. Two datasets containing various patterns of aquifer structures are used to validate the performance of DMCG. Variograms, multiple dimensional scaling maps, cumulative proportional distribution function, and other metrics are used to visualize the differences between realizations and references in terms of spatial heterogeneity and attribute proportion. Experimental results demonstrate that DMCG can characterize multiple-type aquifer structures under the constraints of both conditioning data and category labels. The comparative test illustrates that DMCG achieves better performance to a multiple-point geostatistical algorithm (Quick Sampling, QS) and recent diffusion-based method in reproducing multiple-type hydrogeological structures.}
}
@article{LI2026135465,
title = {Intensification of extreme climatic events in Central Asia’s arid regions amid climate change},
journal = {Journal of Hydrology},
volume = {674},
pages = {135465},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135465},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005627},
author = {Dinghao Li and Yun Li and Yipeng Jing and Hao Guo and Yulong Liu and Yanbo Wan and Qingdong Shi},
keywords = {Oasis ecosystem, Flash drought, Groundwater, Extreme climatic event, Ecological response},
abstract = {Oasis systems in Xinjiang face severe stress from extreme weather, water scarcity, and ecological decline, with water shortages driving ecological changes; however, the coupled hydro-climatic and anthropogenic drivers of this problem remain poorly quantified at fine spatial scales. Here, we develop an integrated framework combining a 1‑km flash-drought detection workflow, a deep‑learning groundwater inversion model, structural equation modeling (SEM), and a lag analysis to characterize flash drought dynamics, subsurface water stress, and ecosystem responses across Xinjiang. The findings show a decline in annual mean precipitation (−0.90 mm yr−1) and groundwater levels (the water table deepened by +0.044 m yr−1) within the study region, indicating worsening water availability. There has also been a steady increase in flash drought events and escalating water stress. Overall ecological quality has marginally improved, but this trend varies: non-farmland zones are deteriorating, whereas irrigated farmland areas are benefiting from improved irrigation security. SEM indicates that extreme temperatures and precipitation patterns indirectly impact the ecological quality by intensifying water stress. Additionally, the ecological quality responds to high temperatures with a noticeable delay and is particularly sensitive to changes in moisture levels. In oasis regions, sustained growth in agricultural water demand exacerbates the ecosystem’s vulnerability to extreme climatic events. Our findings provide actionable targets for water management and oasis ecosystem resilience under ongoing warming and increasing extreme climate risk.}
}
@article{LING2026135493,
title = {A PINN-based hybrid model with APIDr for interpretable and cross-scenario landslide displacement prediction},
journal = {Journal of Hydrology},
volume = {674},
pages = {135493},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135493},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005901},
author = {Qing Ling and Weidong Chen and Qin Zhang and Li Wang and Wei Qu and Bao Shu and Junguang Ren and Qi Guo and Jiebo Qu and Weizhi Li and Chenjian Yang and Yiming Chen and Jiayi Sha},
keywords = {Landslide displacement prediction, Feature optimization, PINN, Reservoir bank landslide, Loess landslide},
abstract = {Landslides, especially bank and loess types, endanger lives and property, making accurate displacement prediction essential for disaster mitigation. However, current models often face limitations due to inadequate physical constraints, suboptimal feature selection, and limited generalization across landslide types. This study proposes a new methodology that integrates antecedent precipitation-driven hydraulic diffusion index (APIDr) with a hybrid convolutional neural network-relevance vector machine-physics-informed neural network (CNN-RVM-PINN) model. First, the APIDr feature factor is developed, integrating the antecedent precipitation index (API), hydraulic diffusion coefficient, and infiltration ratio. A multi-dimensional feature optimization strategy is then applied, employing maximal information coefficient (MIC), recursive feature elimination with cross-validation-extreme gradient boosting (REFCV-XGBoost), convergent cross mapping (CCM), and Dempster–Shafer (D–S) evidence theory. Displacement is decomposed into trend and periodic components via crested porcupine optimization-multivariate variational mode decomposition (CPO-MVMD). Trend displacement is forecasted using quadratic exponential smoothing, while periodic components are processed by CNN, refined by RVM, and embedded with physical priors in the PINN module. Empirical validation on reservoir and loess landslides shows that the proposed model achieves R2 above 0.99 and RMSE below 2.10 mm across all monitoring points. Ablation experiments indicate that incorporating the PINN module reduces RMSE by 50.86% on average, and including APIDr yields a 53.29% reduction. Comparative assessment with seven mainstream models further highlights its advantages in feature construction, physical integration, and cross-type generalization.}
}
@article{SANG2026135533,
title = {Linking DOM fluorescence characteristics to antibiotic ecological risks in inland rivers: A meta-analysis and multispectral techniques},
journal = {Journal of Hydrology},
volume = {674},
pages = {135533},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135533},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600630X},
author = {Dongling Sang and Xin Yao and Jiazheng Zhang and Min Zong and Chen Zhang and Weiwei Lü and Yuxuan Ma and Yunli Wu},
keywords = {Tetracycline, Dissolved organic matter (DOM), Degradation, 2D-COS},
abstract = {Dissolved organic matter (DOM) significantly influences the environmental behavior and ecological risk of antibiotics in river ecosystems. However, how its dynamic variations influence the DOM-antibiotic binding behavior and thereby affect the ecological risk of antibiotics remains unclear. This study employed meta-analysis, integrated risk quotient (RQsum), multi-spectroscopic techniques, parallel factor analysis (PARAFAC), and two-dimensional correlation spectroscopy (2D-COS and MW2D-COS) to investigate the relationship between DOM fluorescence characteristics and tetracycline (TC), and the impact of dynamic changes in DOM on their binding under seasonal hydrological conditions. Meta-analysis showed that the total RQsum of antibiotics in rivers was 0.35 ± 0.83, indicating a moderate risk level, and that rivers with a higher protein-like content had a higher ecological risk of antibiotics. Fluorescence titration experiments of DOM with TC demonstrated that the protein-like components (C4) exhibited a stronger binding capacity for TC than the humic-like components (C3). Furthermore, the actual binding threshold of DOM with TC was higher in the Si River (with higher protein-like content) than in the Dongyu River (with lower protein-like content). Further studies showed that hydrological processes indirectly influenced the binding capacity of DOM with TC by regulating its composition. Changes in the DOM along the river flow direction affect its binding capacity with TC. The L-biodegradation weakened the binding capacity of DOM for TC. The results emphasized that protein-like substances are strongly correlated with antibiotic risk. This provides a theoretical basis for using DOM fluorescence characteristics to assess the antibiotic ecological risk in inland rivers.}
}
@article{WU2026135481,
title = {Hydrological controls on spatiotemporal variations and fluxes of dissolved black carbon in the Changjiang River Estuary, China},
journal = {Journal of Hydrology},
volume = {674},
pages = {135481},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135481},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005780},
author = {Mengmeng Wu and Guopei Huang and Yin Fang and Keqing Ni and Shenyan Zhang and Shouye Yang and Yingjun Chen and Dongyan Liu},
keywords = {Carbon cycling, Fluxes, Dissolved black carbon, Hydrology, Changjiang River Estuary},
abstract = {Dissolved black carbon (DBC) is recognized as the most abundant molecularly identified refractory dissolved organic carbon pool in the ocean. However, its dynamics within major river-estuary systems remain poorly constrained, hindering a more robust assessment of negative carbon cycle-climate feedback. Through multi-season sampling in the Changjiang River Estuary (CRE), we elucidated the spatiotemporal patterns and drivers of DBC and estimated its annual export under contrasting hydrological regimes. We found that, across all sampling seasons and layers, water mixing was strongly associated with the spatiotemporal variations of DBC, as indicated by the significant positive correlations between DBC concentrations and salinity. Annual DBC export from Changjiang showed an approximately twofold variation, ranging from 28.02 ± 3.62 Gg-C in a dry year (2023) to 65.51 ± 12.94 Gg-C in a wet year (2020). Summer with abundant freshwater discharges consistently contributed the largest share (>43%) despite considerable interannual variability. These findings highlighted hydrological controls upon DBC dynamics in major river-estuary systems. Nevertheless, large uncertainties persist, calling for higher resolution sampling and molecular characterization of multiple DBC pools in land-ocean interfaces under a changing climate.}
}
@article{LI2026135518,
title = {Quantifying the dampening effect of soil moisture on drought propagation in northern ecosystems},
journal = {Journal of Hydrology},
volume = {674},
pages = {135518},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135518},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006153},
author = {Yifei Li and Shengzhi Huang and Deliang Chen and Jianfeng Li and Guoyong Leng and Qiang Huang and Zhixia Wang and Jian Peng},
keywords = {Antecedent soil moisture, Dampening effect, Drought propagation, Meteorological drought, Northern ecosystems, Climate change},
abstract = {The dampening effect of antecedent soil moisture is crucial for terrestrial ecosystems to withstand the impacts of meteorological drought. However, the capacity of soil moisture to mitigate the propagation of meteorological drought to ecosystems has not been quantified at large scales. In this study, we focused on Northern Hemisphere ecosystems during the peak summer growing season. Using soil moisture and remote sensing data (1982–2022), we quantified the Dampening Rate (DR) of soil moisture on drought based on the proposed Drought Propagation Index (DPI). Our results reveal that antecedent soil moisture exerts significant dampening effects on drought propagation, with an average DR of 54.4% across all drought severity levels. Spatially, the dampening capacity of soil moisture was substantially stronger in Humid and sub-Humid regions than in Arid and semi-Arid areas. Vertically, middle and surface soil layers showed the most pronounced buffering against extreme drought, particularly in Humid zones, where surface and middle-layers maintained average DR values of 59.2% and 61.4% respectively. Over the past four decades, the dampening capacity remained generally stable across most of the study region. However, significant declines in DR (p < 0.05) were detected in several critical areas including the Midwestern US, southwestern Europe, southwestern Russia, and the Mongolian Plateau, where rising temperatures combined with decreasing soil moisture have substantially weakened this buffering capacity. Our findings underscore the critical role of antecedent soil moisture in mitigating meteorological droughts, and quantification method of the dampening provide valuable insights for ecological drought monitoring and prediction under climate change.}
}
@article{ZHENG2026135570,
title = {Rock fissure water dominates the water utilization strategies of woody plants in karst epikarst},
journal = {Journal of Hydrology},
volume = {674},
pages = {135570},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135570},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006670},
author = {Xukun Zheng and Yuan Li and Qiuwen Zhou and Yuluan Zhao and Lulu Cai and Chunmao Shi and Yi Chen},
keywords = {Karst, Epikarst, Water utilization strategy, Rock fissure, Seasonal variation},
abstract = {The shallow structure of the karst critical zone is dominated by the epikarst, which consists of a network of dissolved pores and fissures, with rock fissures serving as important storage spaces for water in this region. However, how the availability of water in rock fissures within the epikarst affects the water-use strategies of trees with different rooting depths remains poorly understood. To address this, deep-rooted trees (Ailanthus altissima, Juglans regia) and shallow-rooted trees (Zanthoxylum bungeanum, Eriobotrya japonica) were selected as study species in a typical subtropical karst rocky habitat for one year of field monitoring. We collected plant xylem water, topsoil water, fissure-filled soil water, rock water, and epikarst spring water, and combined stable isotope tracing (δ2H, δ18O), the MixSIAR model, and root observations. The results showed that rock fissure water (including fissure-filled soil water and rock water) was the main water source for both plant types, with a total contribution ranging from 64.6% to 71.4%. Deep-rooted plants relied more on fissure-filled soil water during the rainy season (32.2–47.7%) and shifted to rock water in the dry season (40.4–48.9%). In contrast, shallow-rooted plants used both topsoil water (26.5–36.4%) and fissure-filled soil water (37.3–42.8%) during the rainy season, but still depended primarily on fissure-filled soil water in the dry season (38.3–45.3%). The study revealed that the rock fissure system not only functions in water storage but also provides living space for plant roots. This research clarifies the divergence in plant water-use strategies in karst habitats and provides a theoretical basis for understanding plant and water interactions and ecological restoration in karst regions.}
}
@article{ZHANG2026135550,
title = {Oscillation-induced synchronization hubs in global hydrological extremes},
journal = {Journal of Hydrology},
volume = {674},
pages = {135550},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135550},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006475},
author = {Jianxin Zhang and Kai Liu and Yunhui Sui and Kaiwen Li and Lianjie Qin and Junfei Liu and Ming Wang and Norbert Marwan},
keywords = {Hydrological extreme events, Event synchronization, Climate network, Synchronization hubs, Recurrence quantification analysis, Climate indices},
abstract = {Hydrological extremes—including pluvials and droughts—pose significant threats to water resources, ecosystems, and societal resilience, underscoring the importance of understanding their global-scale dynamics and drivers. However, the teleconnection patterns between large-scale climate indices (CIs) and hydrological extremes remain insufficiently understood. In this study, we construct an event synchronization climate network using GRACE-derived terrestrial water storage anomalies from August 2002 to December 2023 to identify global synchronization patterns of hydrological extreme events. We then identify synchronization hubs (SHs) where hydrological extremes tend to co-occur across distant locations and investigate the underlying climatic drivers using a recurrence-based synchronization index based on recurrence quantification analysis. Our results show that four dominant CIs influence the hydrological extremes: Niño3.4, North Oscillation Index (NOI), Tropical North Atlantic (TNA), and Arctic Oscillation (AO). Among these, NOI shows the broadest influence, affecting 99.61% of SHs regions associated with wet extremes and 97.99% with dry extremes. Furthermore, the phase-dependent response displays asymmetry: both dry and wet events are primarily linked to the negative phase of Niño3.4, while the positive phase of NOI exerts the strongest overall influence. Wet extremes are similarly impacted by both positive and negative phases of TNA, while dry extremes exhibit a stronger response to the negative phase. These results highlight the value of phase-resolved climate–extreme linkages in advancing our understanding and prediction of global hydrological extremes.}
}
@article{QIAN2026135506,
title = {Characterization and prediction of non-darcy flow in rough fractures: effects of average aperture and heterogeneity},
journal = {Journal of Hydrology},
volume = {674},
pages = {135506},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135506},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006037},
author = {Jiazhong Qian and Shang Yuan and Yong Liu and Yunhai Fang and Lei Ma and Haichun Ma and Haoming Zhang},
keywords = {Rough fractures, Non-Darcy flow, Nonlinear flow, Geometric parameters, Nonlinear coefficient},
abstract = {Non-Darcy flow in rough fractures is strongly influenced by average aperture and heterogeneity, yet its quantitative characterization and prediction remain insufficiently understood. This study employs the Navier–Stokes equations to simulate flow in 30 fractures parameterized by average aperture (b) and aperture standard deviation (σ, representing the degree of heterogeneity). A systematic investigation was conducted on the identification of streamline transitions and the characterization of the non-Darcy coefficient (β) within rough fractures. Results reveal that flow behavior is non-monotonically controlled by b and σ: smaller σ produces a more uniform aperture field, concentrating flow into a limited number of high-velocity preferential pathways and thereby amplifying inertial effects and nonlinear behavior, while larger σ disrupts small-channel connectivity and redistributes flow across low-velocity zones, reducing β. The transition from linear to nonlinear flow is jointly governed by b and σ, with larger apertures exhibiting lower critical Reynolds numbers for the onset of nonlinearity. A semi-empirical model was developed to predict β based on b and σ, capturing both the initial increase at low σ and subsequent decline at high σ. Model validation demonstrates its effectiveness in quantifying the coupled influence of aperture size and heterogeneity on nonlinear flow in rough fractures. Furthermore, comparative analysis reveals that hydraulic parameters are significantly dependent on the observation scale. Parameters including K, p, c, and r exhibit quantitative drift when comparing the 40 mm scale in this study with a 20 mm scale dataset. This study contributes to more accurate predictions of hydraulic properties in fractured rock masses.}
}
@article{YANG2026135558,
title = {An innovative urban drainage network pipe diameter optimization method based on an enhanced genetic algorithm and multi-stage disaster mitigation model},
journal = {Journal of Hydrology},
volume = {674},
pages = {135558},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135558},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006554},
author = {Weichao Yang and Maomao Li and Lingling Bin and Xuelian Jiang and Hao Wang and Meifang Ren and Haoyang Liang and Xiangdong Liu and Lin Yan},
keywords = {Urban flooding, Drainage network pipe diameter optimization, Enhanced genetic algorithm, Multi-stage disaster mitigation model},
abstract = {As urbanization accelerates and extreme precipitation becomes more frequent and intense, urban pluvial flooding has emerged as a critical global issue, exacerbated by the limited capacity of many existing drainage networks. This study proposes an innovative pipe-diameter rehabilitation strategy for urban drainage systems based on an enhanced bi-objective genetic algorithm coupled with a multi-stage disaster-mitigation decision framework. The algorithm incorporates a topology-aware encoding that embeds hydraulic connectivity and diameter-ordering constraints directly into the chromosome representation, enabling direct manipulation of feasible pipe-diameter configurations. A simple rank-based dynamic parameter adjustment scheme is further employed to improve convergence stability and maintain population diversity in the cost–overflow objective space. A bi-objective optimization model is formulated for a fixed network layout to minimize total construction cost and total overflow volume under practical budget constraints. The resulting Pareto-optimal pipe-diameter combinations are subsequently grouped into three investment stages corresponding to low, medium, and high construction costs using K-means clustering in the normalized cost–overflow space. Within each stage, a transparent cost–benefit weighting procedure is then used to identify representative rehabilitation schemes that balance economic input and flood-mitigation effectiveness. The framework is applied to the drainage system of a university campus in Tianjin, China, where the enhanced algorithm produces 121 Pareto-optimal solutions spanning a wide range of cost and mitigation outcomes. The results demonstrate that the proposed approach offers a flexible, resource-sensitive tool for exploring staged drainage rehabilitation options and supporting investment decisions under budget constraints.}
}
@article{LIGHTFOOT2026135372,
title = {Degassing, dating and deeper insights into the groundwater dynamics of an arsenic contaminated aquifer in Vietnam},
journal = {Journal of Hydrology},
volume = {674},
pages = {135372},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135372},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004695},
author = {Alexandra K. Lightfoot and Matthias S. Brennwald and Rolf Kipfer},
keywords = {Gas production, Degassing, Groundwater dating, – dating, Arsenic contamination, Methane},
abstract = {Arsenic affected alluvial aquifers in South and Southeast Asia commonly exhibit strongly reducing, methane-rich conditions, where in-situ gas production can induce substantial degassing of groundwater. Such conditions complicate groundwater dating calculations using the tritium–helium-3 ( 3H− 3He) ingrowth method, which is widely applied to infer groundwater flow velocities and contaminant transport timescales. This study evaluates groundwater from a methane-rich aquifer in Van Phuc, Vietnam, with the aim of applying the  3H− 3He method to date groundwater. Dissolved noble gas concentrations were analysed to account for degassing and excess air components required for effective isolation of the tritiogenic  3He fraction. Groundwater from 24 of the 28 sampled wells shows clear evidence of degassing, with up to 98% depletion of dissolved gases relative to expected atmospheric equilibrium concentrations. After correcting for degassing,  3H− 3He residence times range from 35 to 65 years and are highly sensitive to both the magnitude and timing of degassing. In addition, a comparison between He, Ar, and Kr concentrations measured on-site using membrane-inlet mass spectrometry (GE–MIMS) and those obtained from conventional copper tube samples revealed substantial discrepancies in He concentrations—of up to 7×10−8 cmSTP3 g−1—whereas comparable differences for Ar and Kr were considerably smaller. Discrepancies were observed in wells with elevated methane concentrations and total dissolved gas pressures exceeding 1 bar. These differences are interpreted as resulting from sampling-induced degassing during copper tube groundwater collection, superimposed on in-situ subsurface degassing, further complicating groundwater age determination. Finally, degassing is shown to be more widespread than originally assumed, contrary to previous assumptions, necessitating revision of earlier groundwater age estimates. The revised understanding of degassing processes and groundwater age distributions is applicable to similar aquifers where in-situ gas production may influence contaminant transport.}
}
@article{WU2026135534,
title = {Seasonal precipitation-flow-DOC cascade: Long-term monitoring insights},
journal = {Journal of Hydrology},
volume = {674},
pages = {135534},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135534},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006311},
author = {Jiefeng Wu and Huaxia Yao and Yuliang Zhou and Ting Zhou and Weijie Zhang},
keywords = {Seasonal patterns, precipitation-flow-DOC, Cascading effects, Environment management},
abstract = {Dissolved organic carbon (DOC) is a critical link between the terrestrial carbon cycle and aquatic ecosystems, whose watershed export is tightly regulated by hydrological processes. As the core driving factor of flow, precipitation not only determines the total DOC export but also affects its temporal dynamics. However, the seasonal patterns of precipitation-flow-DOC cascading effects (referring to the chain reaction where precipitation drives runoff changes, which in turn regulate DOC export processes) over long-term sequences remain unclear. This study focused on the Harp Lake, a cold-region watershed in south-central Ontario, Canada. Based on weekly high-frequency monitoring data from 1978 to 2019, correlation analysis, partial cross-wavelet analysis and multiple regression models were used to explore the seasonal characteristics of the precipitation-flow-DOC cascading effect. The results showed that: (1) The cascading effect exhibited significant seasonal differences. In spring, precipitation, flow, and DOC showed a negative relationship due to the dilution of snowmelt runoff; while positive relationships were observed in summer, autumn, and winter, with more significant correlations in summer and autumn. The response rate of flow to precipitation was higher in spring and autumn than in summer and winter. (2) The transfer characteristics of precipitation, flow, and DOC across different precipitation levels change with seasons. Additionally, these three variables share two common low-frequency resonance periods (3 ∼ 8 months and 64 ∼ 128 months), but their patterns of resonance differ from each other. (3) The contributions of precipitation and flow to DOC showed seasonal reversal: the flow contribution in spring (79.71%) was much higher than that of precipitation (11.43%); while precipitation contributed more in summer, autumn, and winter, with the precipitation contribution reaching 83.27% in autumn. By clarifying the seasonal dynamic patterns of the precipitation-flow-DOC cascading effect, this study deepens the understanding of the responses of hydrology-carbon coupling processes to seasonal climate fluctuations and provides reliable scientific support for water resources and environmental management practices.}
}
@article{XU2026135514,
title = {A newly merging approach of multiple precipitation products by combining time-varying quadruple collocation and random forest spatial interpolation},
journal = {Journal of Hydrology},
volume = {674},
pages = {135514},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135514},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006116},
author = {Shuhong Xu and Qiongfang Li and Yiqun Sun and Zhengmo Zhou and Chuanhao Wu and Xiaoqiang Yang and Xingye Han and Xing Huang and Junliang Jin},
abstract = {The quality of daily precipitation data is vital for hydrological modelling and water resources assessment. However, data from gauge-based observations and satellite-based precipitation products (SPPs) often fail to satisfy accuracy requirements due to the limited rain-gauge stations and the uncertainties of precipitation products. To acquire high-quality daily precipitation estimates, this study proposed a novel merging framework, named TV-QC-RFSI, which combines time-varying quadruple collocation (TV-QC) for multi-source fusion and random forest spatial interpolation (RFSI) for bias correction. The TV-QC-RFSI was applied in the Ili river basin (IRB), China, to estimate the daily precipitation. The effectiveness of TV-QC-RFSI was evaluated by comparing with original SPPs and standalone collocation-based approach. Besides, TV-QC-RF, a simpler framework that merges TV-QC-fused precipitation with gauge observations via traditional random forest (RF), was used as a benchmark for comparison. Results reveal that TV-QC can effectively rank SPPs by accuracy as in-situ estimates do. The preliminary fused precipitation generated by TV-QC outperforms all parent SPPs. Further integration of the preliminary fused precipitation with gauge observations through RFSI achieved a significant improvement in precipitation accuracy (e.g., R increasing from 0.56 ± 0.10 to 0.72 ± 0.10). Additionally, TV-QC-RFSI outperformed TV-QC-RF, with an increase in R from 0.60 ± 0.09 to 0.72 ± 0.10. The results also indicate that adjacent observations play more critical roles than input precipitation and environmental explanatory variables. These findings suggest that the proposed framework offers great advantages in precipitation estimation, particularly in data-scarce regions.}
}
@article{YIN2026135566,
title = {Climate change-driven runoff variations in alpine catchments: Quantitative attribution using three innovative methods coupled with cryospheric processes},
journal = {Journal of Hydrology},
volume = {674},
pages = {135566},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135566},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006633},
author = {Zhenliang Yin and Chunshuang Fang and Jianan Shan and Zexia Chen and Rui Zhu and Qi Feng},
keywords = {Runoff variations, Climate change, Double mass curve, Budyko framework, VIC model, Qilian mountains},
abstract = {With ongoing climate warming, runoff in alpine catchments of Qilian Mountains (QLM) has exhibited significant variability over recent decades. Therefore, understanding runoff variations and the underlying driving mechanisms in QLM is helpful for regional water resources planning and management. In this study, three innovative attribution methods incorporating glacier meltwater were employed to quantitatively analyze the impacts of climate change, glacier meltwater and land surface change on runoff variations in three representative basins of the QLM. To improve the reliability of runoff attribution analysis, this study first adopted a coupled VIC–OGGM modeling framework to simulate glacier meltwater and evapotranspiration, which are difficult to directly observe at the basin scale, thus avoiding uncertainties introduced by inconsistent input data sources. The coupled model exhibited high robustness and simulation accuracy in reproducing hydrological processes, with NSE > 0.80 for streamflow and NSE > 0.78 for evapotranspiration. The integrated results from three methods indicated that climate change is the dominant driver of runoff variations in the XYRB and HRB, accounting for 46.6–60.1% and 60.3–68.1% of the increased runoff, respectively. In contrast, glacier meltwater plays the dominant role in the SLRB, contributing 39.0–45.2% of the increased runoff. Among the three attribution methods, the hydrological model is the most robust and reliable choice for runoff attribution studies. The modified double mass curve method and Budyko-based methods can serve as efficient and practical alternatives when detailed hydrological modeling is not feasible. This study incorporated the influence of glacier meltwater into the attribution analysis of runoff variations, providing important and valuable insights for the ecologically sustainable development of water resources in Hexi Inland River Basin.}
}
@article{WANG2026135469,
title = {Seasonal water level fluctuations regulate the distribution and risk of antibiotic resistance genes in the sediments of the largest floodplain-lake in China},
journal = {Journal of Hydrology},
volume = {674},
pages = {135469},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135469},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005664},
author = {Cong Wang and Junjie Hu and Xiaolong Huang and Zhi Wang and Shaoyong Lu},
keywords = {Antibiotic resistance gene, Water level fluctuations, Diffusion risk, Floodplain-lake},
abstract = {Antibiotic resistance remains an escalating threat to global environment and human health. Seasonal water level fluctuations are intrinsic property to floodplain-lakes worldwide, yet their regulatory role on antibiotic resistance genes (ARGs) remains largely overlooked. We presented the first integrative insight of seasonal water level fluctuations, along with land use, physicochemical parameters, and biological factors, in regulating ARGs in the sediments of the largest floodplain-lake in China. Significant spatial variation in ARG profiles emerged only during the dry season (R2 = 0.258, p < 0.001) between fluctuating water levels zone (FWLZ) and high-water levels zone (HWLZ), with the significantly higher abundance and number of ARGs in FWLZ than of HWLZ (p < 0.05). The water level fluctuation conditions determined the drivers of ARGs: water level was only surpassed by mobile genetic elements (MGEs) in FWLZ by land use, sediment properties, and bacterial communities, but was negligible in HWLZ. Interestingly, our proposed ARG-MGE-antibiotic resistance bacteria (ARB) co-occurrence chains revealed that HWLZ contributed 91.8% of chain numbers, with greater contributions in the wet season (63.9%) compared to the dry season (27.9%). Overall, this study emphasizes divergent responses of ARG profiles and their diffusion risks to seasonal water level fluctuations, which strengthen broadly adoptable approaches for alleviating antibiotic resistance from floodplain-lake.}
}
@article{ZHANG2026135509,
title = {Identification of regional groundwater flow systems in geologically complex coalfields using hydrochemical process analysis},
journal = {Journal of Hydrology},
volume = {674},
pages = {135509},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135509},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006062},
author = {Miao Zhang and Luwang Chen and Xiaowei Hou and Yongsheng Hu and Baoxin Zhao and Tianwa Gao and Xianjie Fu and Ke Li and Guoqing Dai},
keywords = {Groundwater flow system divide, Self-organizing map, Radiocarbon dating (4C), Hydrochemical process, Bedrock aquifer},
abstract = {Groundwater flow systems in coalfield aquifers are difficult to identify because diverse stratigraphic assemblages, complex geologic formations, and multilayered aquifers blur the boundaries and connectivity of groundwater flow systems. To address this challenge, this study developed an integrated methodology combining self-organizing map (SOM) hydrochemical classification, radiocarbon (14C) dating, stratigraphic–lithological analysis, and pumping test data to characterize groundwater flow systems in a structurally complex coalfield aquifer system. SOM clustering effectively identified hydrochemical characteristics and spatial heterogeneity in the bedrock aquifers, providing a systematic framework to distinguish between regional and local flow systems. Meanwhile, aquifer-specific corrections of 14C ages allowed for a more reliable determination of groundwater residence times, thereby elucidating recharge and discharge processes across different aquifers. Results indicate that water–rock interactions primarily govern the hydrochemical process, while hydrodynamic conditions control recharge pathways and flow patterns, indirectly shaping groundwater chemistry. Spatial patterns in hydrochemistry correspond to lithological assemblages, highlighting the influence of stratigraphic combinations on groundwater chemistry. SOM analysis further revealed that some Permian coal-bearing aquifer samples group with underlying aquifer samples, indicating hydrochemical convergence caused by mining-enhanced hydraulic connectivity and interlayer groundwater exchange. Pumping test analyses confirmed that major faults act as hydraulic boundaries regulating local groundwater flow systems. This study provides a robust tool for deciphering groundwater circulation in geologically complex coalfields and is broadly applicable worldwide. The findings offer valuable implications for sustainable groundwater management, mine water control, and the protection of groundwater resources in structurally disturbed environments.}
}
@article{MOHASSEB2026135483,
title = {Hybrid approach for estimating snow water equivalent in Siberian basins using GRACE and climate data},
journal = {Journal of Hydrology},
volume = {674},
pages = {135483},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135483},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005809},
author = {Hussein A. Mohasseb and Shuang Yi},
keywords = {GRACE, Snow, Hydrology, Climate change, Hydrological models, In-situ},
abstract = {Snow Water Equivalent (SWE) is a key component of the global water and energy cycles, especially in high-latitude regions. In Siberia, major river basins such as the Yenisei, Ob, Lena, Amur, and Kolyma play a crucial role in regulating freshwater discharge to the Arctic Ocean, impacting regional hydrology and broader climate systems. However, estimating SWE in these regions is complicated by sparse ground observations, limitations in hydrological models, and uncertainties in remote sensing data. This study introduces a novel hybrid modeling framework—the Hybrid Gravity-Precipitation SWE Model (HGPSM)—to estimate absolute SWE using GRACE satellite gravimetry and meteorological inputs. The model is developed through a five-step process: (1) isolating SWE signals from GRACE total water storage data; (2) accounting for seasonally variable GRACE measurement noise; (3) modeling snowmelt using a temperature-driven process; (4) quantifying process uncertainty; and (5) applying a Kalman filter to optimally merge model and observational data. Validation against 382 in-situ stations shows that HGPSM outperforms traditional hydrological models, yielding higher Nash–Sutcliffe Efficiency scores (up to 0.82 for Lena) and strong correlation coefficients (>0.75) across all basins. Root Mean Square Error values are significantly lower, ranging from 9.3 mm (Amur) to 31.9 mm (Ob). Unlike models such as VIC, which tend to overestimate SWE, HGPSM maintains median errors within ± 10 mm. Time series from 2003 to 2019 reveal the model’s superior ability to track seasonal SWE dynamics, particularly during spring melt. These results highlight HGPSM’s potential for accurate, large-scale SWE monitoring in data-sparse cold regions.}
}
@article{LU2026135394,
title = {Carbon and water use efficiency of vegetation ecosystems in the Taihang Mountains has declined sharply over 2002–2022},
journal = {Journal of Hydrology},
volume = {674},
pages = {135394},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135394},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004919},
author = {Fucheng Lü and Liqin Han and Xunhua Zheng and Xiaohong Chen and Siyan Dong},
keywords = {Carbon use efficiency, Water use efficiency, XGBoost-SHAP, Taihang Mountains, VPD},
abstract = {The Taihang Mountains, an important ecological security barrier in northern China with a fragile ecology, face dual pressures from environmental changes and rapid urbanization.However, the changes in vegetation Carbon Use Efficiency (CUE) and Water Use Efficiency (WUE) in this region and their driving factors remain unclear. This study employed trend analysis, multiple regression residual analysis, and the XGBoost-SHAP method to examine the spatiotemporal variations in CUE and WUE, as well as their responses to environmental changes and human activities. The key findings are as follows:(1) During the observation period (2002–2022), the Taihang Mountains region showed significant increasing trends in Gross Primary Productivity (GPP), Net Primary Productivity (NPP), and Evapotranspiration (ET), with respective rates of 10.98 g C m−2 yr−1, 4.84 g C m−2 yr−1, and 7.24 mm yr−1. In contrast, both CUE and WUE displayed significant decreasing trends, with decadal reduction rates of 0.09 decade−1 and 0.09 g C m−2 mm−1 decade−1, respectively. Spatially, pixel-based trend analysis revealed that the proportions of significant decline for CUE and WUE were 27.53% and 43.73%, respectively. (2) Significant differences in CUE and WUE were identified among land-use types. Forests had the lowest values (CUE: 0.51; WUE: 1.06 g C m−2 mm−1), significantly lower than those of grasslands (CUE: 0.56; WUE: 1.16 g C m−2 mm−1) and croplands (CUE: 0.57; WUE: 1.20 g C m−2 mm−1).(3) This study revealed that the drivers of CUE and WUE exhibited significant nonlinear relationships and threshold effects. Temperature, DEM, and Vapor Pressure Deficit (VPD) were key controls on CUE, while precipitation and temperature dominantly regulated WUE across ecosystems. (4) Environmental factors predominantly exerted negative influences on CUE (71.46%) and positive contributions to WUE (81.21%), whereas anthropogenic activities presented limited positive impacts on CUE (31.64%) and predominantly adverse effects on WUE (86.79%), with distinct spatial patterns in their contributions.}
}
@article{ZHANG2026135484,
title = {Controls of streambed sediment heterogeneity and dynamic microbial biomass growth on nitrous oxide dynamics in hyporheic zones},
journal = {Journal of Hydrology},
volume = {674},
pages = {135484},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135484},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005810},
author = {Zhixin Zhang and Yang Xian and Xue Ping and Renjie Zhou and Huirong Guo and Peipei Xue},
keywords = {Nitrous oxide (NO), Hyporheic zones (HZs), Streambed heterogeneity, Numerical model, Biogeochemical cycling},
abstract = {Nitrous oxide (N2O) is a potent greenhouse gas, and the hyporheic zone (HZ) is increasingly recognized as a major hotspot for riverine N2O production. However, how interacting physical, chemical, and microbial heterogeneities regulate N2O dynamics in riverbed sediments remains poorly understood. In this study, we develop a two-dimensional heterogeneous HZ model that explicitly couples porous flow, reactive transport, electron competition, microbial growth, and bioclogging, allowing hydraulic and biogeochemical processes to coevolve. Model results show that increasing fine-grained fraction alters residence time, organic carbon (OC) availability, and electron competition, producing a nonlinear response of both net N2O production and N2O yield (the proportion of denitrified NO3− as N2O), with maxima at intermediate fine-grained contents. When heterogeneities interact dynamically, N2O hotspots are not restricted to fine-grained, OM-rich, low-permeability sediments that have traditionally been emphasized in hyporheic N2O frameworks. Instead, OC-stimulated microbial growth and bioclogging in coarse-grained, high-permeability structures create secondary redox zones, enabling these facies to contribute up to 30–40% of total N2O production under conditions of maximum N2O generation. Sediment configuration further shapes N2O dynamics, i.e., shorter fine-grained lenses increase anoxic microzones and coarse–fine interfaces, enhancing interfacial exchange and shifting N2O production and yield maxima toward lower fine-grained fractions. Upward groundwater discharge suppresses net production but increases N2O yield by strengthening electron competition, while dissolved oxygen in groundwater has minimal influence. Finally, we show that the classical Damköhler number fails to predict N2O fluxes when microbial biomass evolves dynamically in space and time. By incorporating microbial biomass dynamics, we propose an innovative microbially informed Damköhler number that substantially improves predictive capability. These results highlight the critical role of sediment heterogeneity and dynamic microbial–hydrologic feedbacks in regulating hyporheic N2O production.}
}
@article{QIN2026135553,
title = {Utilization of traffic images for accurate and realtime flood depth measurement in complex urban environments},
journal = {Journal of Hydrology},
volume = {674},
pages = {135553},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135553},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006505},
author = {Jintao Qin and Jian He and Limin Zhang and Ping Shen},
keywords = {Flood depth measurement, Flood risk, Traffic image, Computer vision, Road marking, Complex urban environments},
abstract = {Urban flooding has become increasingly frequent due to rapid urbanization and extreme weather events, underscoring the need for accurate, robust, and cost-effective flood realtime monitoring. Traditional water-level sensors are limited by spatial coverage, while the prevalent image-based flood monitoring methods suffer from limited availability and poor applicability of measurement references in complex urban environments. Accordingly, this study proposes a method consisting of camera calibration with accessible references and flood region identification, enabling flexible reference selection and accurate quantitative monitoring of flood depth using readily available information only. Specifically, in each scene, only a single dimension from one reference object (such as standard road markings) is required during camera calibration, yet multiple vertical planes can be calibrated, enabling the use of various references with unknown dimensions for generalizable flood depth measurement without on-site measurements or calibrations. The flexibility and robustness of the method are validated by the fact that the R2 values remain above 0.866 across over 300 measurements under different light conditions, even when the reference is changed during floods to adapt to environmental changes. Moreover, the results exhibit strong consistency with traditional water-level sensor records, with 98% of absolute errors below 0.1 m and an average error of 0.024 m, underscoring its high accuracy. These results demonstrate that this method, benefiting from its flexibility, robustness, and accuracy, shows promise as a complementary solution for constructing fine-grained quantitative flood monitoring networks in complex and dynamic changing urban environments.}
}
@article{HUANG2026135475,
title = {Probabilistic multi-step forecasting of estuarine salinity intrusion for ecohydrological risk assessment},
journal = {Journal of Hydrology},
volume = {674},
pages = {135475},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135475},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600572X},
author = {Yali Huang and Hua Chen and Amir Mosavi and Yang Liu and Zhaoyang Hu and Chong-Yu Xu},
keywords = {Salinity prediction, Deep learning, Probabilistic forecasting, Temporal convolutional network, Attention mechanism, Gaussian process, Data science, Artificial intelligence, Big data},
abstract = {Saltwater intrusion in estuarine systems is intensifying due to climate change and human disturbances, which poses increasing risks to water security and ecological stability. Reliable salinity prediction is therefore essential for adaptively to manage saltwater intrusion and ecological protection. However, conventional approaches often suffer from limited predictive accuracy, short forecast horizons, and a lack of uncertainty assessment. Consequently, in this study, a hybrid deep learning is developed to improve multi-step salinity prediction. The Temporal Convolutional Networks (TCN) and Multi-Head Self-Attention (MHSA) methods are coupled within a Deep Autoregressive Recurrent (DeepAR) probabilistic. This integration strengthens temporal feature extraction and dependency identification across multiple time scales, while an embedded Gaussian Process (GP) module quantifies predictive uncertainty. The results show that the proposed hybrid model outperforms the baseline models in the test period, with improvements of up to 42.9% in R2 and 43.7% in Nash–Sutcliffe efficiency (NSE), and reductions of up to 27.6% in root mean square error (RMSE) and 28.4% in mean absolute error (MAE). The long-term predictions are more stable and effectively capture key salinity dynamics, including peak magnitudes and phase shifts. Furthermore, the proposed model achieves the best Mean Interval Score (MIS) across all forecast durations at the three prediction horizons. It also yields more uniformly distributed residuals, which suggests improved reliability and generalization. Thus, this study introduces an innovative methodology that supports high-resolution, reliable forecasting for estuarine ecosystem management and protection.}
}
@article{LI2026135564,
title = {Coupled effects of matrix-conduit structure on the karst water storage variation estimation accuracy},
journal = {Journal of Hydrology},
volume = {674},
pages = {135564},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135564},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600661X},
author = {Yuxi Li and Longcang Shu and Xiaonong Hu and Linxian Huang and Chuanshun Zhi and Chunhui Zhang},
keywords = {Karst aquifer, Conduit structure, Matrix parameters, Karst water storage variation, Numerical simulation},
abstract = {Karst aquifer systems comprise both a karst matrix and conduit networks, which exhibit markedly different water storage capacities and discharge efficiencies. Building upon a previously developed coupled discrete–continuum groundwater flow numerical model, this study constructs a series of representative scenarios in which karst matrix parameters and conduit structure characteristics vary simultaneously. Spring flow recession processes are systematically simulated to investigate the influence patterns and controlling mechanisms of coupled matrix–conduit structures on karst water storage variation (KWSV) estimation accuracy, and to quantitatively assess the relative contributions of matrix and conduit structures to estimation error formation at different recession stages. The results indicate that covariation of karst matrix and conduit structures significantly amplifies KWSV estimation errors, producing a much stronger effect than that observed under single-parameter variation scenarios. During the early stage of spring flow recession, conduit structures dominate the magnitude of the recession coefficient by controlling rapid groundwater flow and discharge processes, thereby acting as the primary factor governing the formation and amplification of KWSV estimation errors. In contrast, karst matrix parameters mainly regulate tail behavior during the late recession stage by controlling the volume of remaining drainable water storage, but their contribution to estimation errors derived from early-stage exponential fitting remains relatively limited. These findings deepen the understanding of coupled matrix–conduit hydrodynamic processes in karst aquifer systems and provide a theoretical basis for improving the reliability of KWSV estimation and supporting refined karst groundwater resource management.}
}
