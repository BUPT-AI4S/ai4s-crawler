@article{SONG2026135541,
title = {Hydrobiogeochemical impacts of water sealing on acid mine drainage in karst regions},
journal = {Journal of Hydrology},
volume = {674},
pages = {135541},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135541},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006384},
author = {Lei Song and Peng Liu and Chao Li and Haili Zhang and Jie Yan and Yuhui Liu and Zengping Ning and Yizhang Liu and Jing Sun and Hefa Cheng and Chengshuai Liu},
keywords = {Acid mine drainage, Karst aquifer system, Water sealing, Hydrobiogeochemical responses, Pollution control},
abstract = {Water sealing can effectively reduce acid mine drainage (AMD) generation and migration within porous media. Yet its applicability in karst regions, characterized by strong surface–subsurface connectivity and spatiotemporal heterogeneity, remains unsettled. This study assessed the hydrobiogeochemical responses of AMD to water sealing in a typical karst system by conducting a pairwise multi-proxy comparison between a sealed and an unsealed site in the Yudong River basin in Southwest China. Grouting sealing has been implemented here to mitigate AMD pollution from historical coal mining. Following sealing, the discharge rate at groundwater outfalls to the river decreased substantially, leading to >95% reductions in sulfate and total iron (Fe) outfluxes at the sealed site. Nevertheless, δ18O–H2O and δD–H2O isotopes and tracer test revealed short groundwater residence times and rapid hydraulic connections with surface water even after sealing. Moreover, pyrite oxidation was not significantly attenuated following water sealing, but instead shifted from O2- and Fe3+-co-mediated to predominantly Fe3+-mediated pathway, based on δ18O–SO42− versus δ18O–H2O relationships. Consequently, discharges at the sealed site exhibited comparable acidity, Fe, and SO42− concentrations to those at the unsealed site, continuing impairing river water quality and potentially diminishing the carbonate system’s carbon-sink capacity. Additionally, water sealing reduced microbial richness in the discharges and created a subsurface environment conducive to microbially mediated sulfur cycling. These findings demonstrate the efficacy of grouting sealing on hydrological interception and AMD mitigation, while also underscoring that further AMD control in karst regions requires a hydrogeological–biogeochemical coordinated approach to better inhibit pyrite oxidation.}
}
@article{DONG2026135521,
title = {Precise determination of hydraulic conductivity and specific storage using multi-depth spatiotemporal data from hydraulic impulse tests},
journal = {Journal of Hydrology},
volume = {674},
pages = {135521},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135521},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006189},
author = {Xiaosong Dong and Yanrong Zhao and Yong Huang and Haonan Wang and Shilong Mao and Yuxing Zhang and Fuxin Xing},
keywords = {Hydraulic impulse test, Parameter inversion, Spatiotemporal sensitivity analysis, Specific storage, Hydraulic conductivity, Background flow field},
abstract = {Accurate determination of hydraulic conductivity K and specific storage μs is essential for groundwater assessment. Conventional unsteady flow test methods, however, often disregard natural background flow fields and rely on single-point boundary data, resulting in significant non-uniqueness in parameter estimation, particularly for μs. This study proposes a one-dimensional Hydraulic Impulse Test model that couples a steady background flow with an instantaneous hydraulic perturbation and derives its analytical solution. Parameter sensitivity analysis reveals distinct spatiotemporal controls where K primarily governs the response timescale, while μs dominates the hydraulic head rise phase response morphology. Crucially, we find that boundary water-level decay is inherently insensitive to μs, whereas hydraulic head rise phase responses at internal monitoring points contain rich information about elastic storage. Based on this, a high-precision joint inversion method is developed by utilizing spatiotemporal data from multiple depths. This approach effectively breaks parameter correlation, enabling the simultaneous and accurate decoupling of K and μs. The proposed methodology thus provides a robust framework for the simultaneous, high-precision determination of K and μs under complex hydrodynamic conditions.}
}
@article{XIA2026135529,
title = {Effect of bedrock outcrops and underground fissures on soil loss, flow hydraulics and hydrological connectivity characteristics of karst slopes in alpine canyon area},
journal = {Journal of Hydrology},
volume = {674},
pages = {135529},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135529},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006268},
author = {Rui Xia and Xianlin Zhang and Yiwei Liu and Tianyang Li and Jiayi Zhang and Canjie Wang and Binghui He},
keywords = {Soil erosion, Karst desertification, Underground leakage loss, Rock outcrops, Hydrological connectivity},
abstract = {Understanding the coupled influence and mechanisms of bedrock outcrops and underground fissures on soil erosion processes is crucial for managing karst desertification slopes. However, quantifying how runoff and soil loss respond to varying bedrock and fissure configurations has been challenging due to the intricate surface–subsurface hydrological interactions inherent to karst landscapes. To address their effects, we conducted controlled rainfall simulation experiments enabling precise manipulation of bedrock outcrop ratios (Rbo) and underground fissure rates (Ruf), and analyzed runoff, soil loss, hydraulic parameters, and hydrological connectivity characteristics across different combinations of Rbo and Ruf. Partial least squares path model (PLS-PM) elucidated the complex correlations among these variables and revealed the mechanisms by which Rbo and Ruf influence soil loss. Results revealed that soil loss increased linearly from 0.73 to 1.54 g m⁻2 s⁻1 with increasing Rbo at 3% Ruf, but exhibited fluctuating patterns at 5% Ruf, with the highest value (0.5 g m⁻2 s⁻1) occurring at 40% Rbo, indicating nonlinear bedrock-fissure interactions. Notably, no measurable sediment was detected in underground fissure runoff samples (detection limit: 0.01 g), highlighting the dominance of surface erosion pathways under high-intensity, short-duration events. Rbo induced critical hydrological shifts, including a 78−84% reduction in flow resistance, a transition from laminar to transitional flow regimes, and a 9−16% enhancement in hydrological activity, while collectively promoting rill clustering and localized scouring. PLS-PM identified hydrodynamic forces as the primary erosion driver (path coefficient = 1.03), with bedrock and fissures exerting strong indirect controls. These findings pinpoint 20−30% Rbo zones as critical erosion hotspots where synergistic hydrodynamic and connectivity effects peak, offering crucial guidance for targeted restoration strategies in karst hillslopes. This study provides a basis for improving karst erosion models (i.e., RUSLE, WEPP) and optimization of soil and water conservation strategies in fragile karst landscapes.}
}
@article{WANG2026135505,
title = {Spatiotemporal dynamics of blue-green water resources in the Min-Tuo River Basin: A coupled SWAT-FLUS-CMIP6 modeling approach},
journal = {Journal of Hydrology},
volume = {674},
pages = {135505},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135505},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006025},
author = {Yuxuan Wang and Fuquan Ni and Yu Deng and Mengyu Zhu and Wei Wen and Mingyan Wu and Huazhun Ren},
keywords = {Hydrological processes, Climate change impacts, Hydrologic modeling, Blue-green water, Land use, Min-Tuo River Basin},
abstract = {Water security in ecologically fragile basins is increasingly threatened by the compound effects of climate change and rapid urbanization. As a vital water source for the Chengdu-Chongqing Economic Circle, the Min-Tuo River Basin faces significant challenges in balancing blue and green water resources. This study analyzes spatiotemporal blue-green water (BW/GW) dynamics in the basin (1981–2021) and projects trends (2015–2100) under changing climate and land use scenarios, utilizing a coupled SWAT-FLUS-CMIP6 framework. Results reveal spatially differentiated driving factors: upstream areas are climate-dominated, whereas downstream regions are increasingly sensitive to land use changes. Between 1981 and 2021, BW exhibited a fluctuating downward trend, contrasting with simultaneous increases in GW, temperature, and precipitation. By 2100 under SSP5-8.5, BW is projected to decline by 4.4% despite a 6.5% precipitation increase, driven by a 6.7 ℃ temperature rise and 13.0% GW growth. Conversely, SSP1-2.6 offers greater hydrological resilience, minimizing BW decline and maintaining a balanced blue-green water partition. Historical land use analysis (1990–2020) reveals a 165% urban expansion, coinciding with losses in cultivated land (4.0%) and forest (2.1%). By 2040, urban land in the central and eastern plains is projected to expand by 135%, further exacerbating blue-green water imbalances. Spatially, the Dadu River Basin faces precipitation-induced mudslide risks, and the Qingyi River Basin is prone to flooding. Meanwhile, the Minjiang and Tuojiang Basins face concurrent drought-flood risks driven by BW shortages and GW increases. Proposed mitigation strategies include inter-basin water transfers and sponge city construction to address compound crises arising from climate-urbanization interactions. This study provides a scientific basis for differentiated blue-green water resource management in ecologically fragile basins of the upper Yangtze River.}
}
@article{YANG2026135516,
title = {Negative Indian Ocean Dipole amplifies the altitude gradient of precipitation stable isotopes in the southeastern Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {674},
pages = {135516},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135516},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600613X},
author = {Jiaxin Yang and  Deji and Tandong Yao and Sunil Acharya and Zhongwang Wei and Lunzhu Danzeng and Dongmei Qu and Tajie Suolang and Chuduo Nima},
keywords = {Precipitation, Stable isotopes, Altitude gradient, Southeastern Tibetan Plateau, Oceanic mode},
abstract = {Stable isotopes in precipitation (δ2Hp and δ18Op) are linked to the Indian Ocean Dipole (IOD) and El Niño-Southern Oscillation (ENSO), yet how these modes influence the altitude gradient of δ18Op remains unclear. Here, we analyzed δ18Op data from six sampling sites in Motuo, a moisture passage in the southeastern Tibetan Plateau (SETP), between August 2016 to July 2024 to investigate the spatiotemporal variations of δ18Op, the altitude gradient of δ18Op, and the influences of oceanic modes. Results show a seasonal sine-like distribution of δ18Op, a local meteoric water line (LMWL) expressed as δ2Hp = 8.45 δ18Op + 14.92, and a mean altitude gradient of −0.14‰/100 m. These findings reflect the regional characteristics of the monsoon domain of Tibetan Plateau (TP) and strong moisture recycling intensity in Motuo. Although altitude remained the dominant control on δ18Op, producing a clear altitude gradient, significant interannual differences occurred in δ18Op, the altitude gradient, and the LMWL. We attributed these variations to regional and moisture conditions regulated primarily by the IOD. During the negative IOD phases, the intensification of Walker circulation enhanced moisture uplift and precipitation over Motuo, which in turn lowered δ18Op and amplified altitude gradient. Our findings reveal that oceanic mode exerts a stronger impact on δ18Op at higher elevations, consequently amplifying its altitude gradient. This critical relationship implies that δ18O records from TP ice cores hold significant potential for reconstructing past oceanic proxies-related interannual variations.}
}
@article{LIU2026135537,
title = {Improving latent heat flux estimation under high evaporative demand in arid and semi-arid regions by restoring nonlinear Clausius-Clapeyron relationship: a case study at the Heihe River basin},
journal = {Journal of Hydrology},
volume = {674},
pages = {135537},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135537},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006347},
author = {Suyi Liu and Xin Pan and Zi Yang and Xu Ding and Jinlong Shi and Yuanbo Liu and Yingbao Yang},
keywords = {Evapotranspiration, Clausius-Clapeyron relationship, Nonparametric method, Sensitivity analysis},
abstract = {Nonparametric (NP) approaches estimate evapotranspiration (ET)based on the surface energy balance and conventional equilibrium evaporation, eliminating the need for empirical parameterization of aerodynamic or surface resistances. However, conventional NP methods often systematically underestimate latent heat flux (LE) under high evaporative demand, particularly in arid and semi-arid areas. This bias arises because conventional approaches implicitly rely on a linearized Clausius-Clapeyron relationship to represent atmospheric moisture conditions. In this study, we developed a modified nonparametric (MNP) method by restoring the nonlinear Clausius-Clapeyron relationship. The performance of the MNP method was evaluated using ground observations at three flux sites in the Heihe River Basin. The results show that the MNP method improves daily LE estimation compared to the original NP method, reducing the Root Mean Square Error (RMSE) by 19.33% (from 32.87 W·m−2 to 26.53 W·m−2) and improving the consistency of LE estimation across different sites. Under high evaporative demand conditions, where discrepancies between theoretical and actual vapour pressure deficit are large, the RMSE was reduced by 24.84%, 26.64%, and 41.58% across the Daman, Arou, and Yakou sites. Sensitivity analysis shows that the LE estimates from the MNP method are most sensitive to net radiation and temperature inputs. Overall, restoring the nonlinear Clausius-Clapeyron relationship enables a more realistic representation of atmospheric moisture constraints and significantly enhances the robustness of nonparametric LE estimation.}
}
@article{AMORIMBRANDAO2026135492,
title = {Explaining spatial variation and catchment characteristics thresholds in streamflow response},
journal = {Journal of Hydrology},
volume = {674},
pages = {135492},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135492},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005895},
author = {Abderraman R. {Amorim Brandão} and Admin Husic and André Almagro and Dimaghi Schwamback and Paulo Tarso S. Oliveira},
abstract = {Understanding hydrological processes, considering the interactions among system state, structure, and climate, and the thresholds that regulate catchment behavior, remains a challenge, mainly across scales where multiple processes interact. Here, we move beyond average feature rankings to identify where and when 16 climate and catchment characteristics change their effect on streamflow across 735 Brazilian catchments. Using random forest models together with global and local feature attribution methods, we identify nonlinear thresholds behavior across the flow-duration cure. Model performance supported diagnostic interpretation, with the main streamflow signatures (Q5, Qmean, and Q95) showing R2 and NSE values of 0.63–0.81 and KGE values of 0.70–0.85, while the rarest conditions showed lower but still informative skill. Although these relationships are not causal, provide valuable insights into hydrologic functioning based on the attribute–streamflow relationships identified within the model. Modeled relations indicate that climate exerts the strongest large-scale control: an aridity threshold near 1.23–1.37 marks where drying begins to reduce streamflows, though this effect varies regionally; aridity can enhance streamflow in parts of the Amazon and southern Brazil. Low streamflows were particularly sensitive to precipitation seasonality (SI), which showed a coherent threshold near SI = 0.40, as well as to subsurface porosity, slope, elevation, and vegetation cover. Forest cover showed limited relevance for higher streamflows, but low streamflows decline when forest cover exceeds 25%, and a weaker 32–40% threshold appears for Qmean and higher streamflows. Sand content shows a dual behavior with > 56% boosts low streamflows, whereas values above 45% attenuated high streamflows. Regionally, for the rarest high-streamflow (Q99), soil properties can override climate; under shallow bedrock they become the dominant amplifiers. Overall, at large scales, Brazilian streamflow regimes seem organized by a set of physically interpretable thresholds that distinguish climate-dominated regimes from those governed by catchment state and structure, with variation across space and the flow-duration curve.}
}
@article{SONG2026135513,
title = {Global soil moisture dynamics under future scenarios: evaluation-constrained multi-model ensemble and climatic attribution analysis},
journal = {Journal of Hydrology},
volume = {674},
pages = {135513},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135513},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006104},
author = {Qian Song and Yangxiaoyue Liu and Jie Xu},
keywords = {Soil moisture, CMIP6, SSP scenarios, Patterns, Attributions},
abstract = {Soil moisture (SM) is crucial for Earth’s energy and water cycles, affecting hydrological processes and climate feedback. However, owing to the diversity of Earth system models, the patterns of SM projections under climate change remain unclear in the Coupled Model Intercomparison Project Phase 6 (CMIP6). An integrated evaluation-constraint-attribution framework was applied to enhance the reliability of SM projections. Eighteen CMIP6 models were evaluated against 821 in-situ observations (2000–2024), leading to the identification of two representative Shared Socioeconomic Pathways (SSP 2–4.5 and SSP 3–7.0) and four high-performing models (CAMS-CSM1-0, CNRM-ESM2-1, MIROC6, and TaiESM1). Weighted ensemble products were subsequently constructed to analyze global SM trends and their climatic drivers. The results revealed a pronounced global drying trend, with approximately 66% of land areas exhibiting a decline in SM, particularly in the mid- and low-latitude regions of the Western Hemisphere. Meanwhile, increases in SM were observed in high-latitude and high-elevation regions, as well as in low-latitude regions of the Eastern Hemisphere. Compared with SSP 2–4.5, SSP 3–7.0 intensifies both the drying and wetting trends. SM trends vary across land-use types and climate zones, with shrublands and polar regions projected to experience the steepest decline. Precipitation is proved to be a dominant positive driver of SM, whereas near-surface air temperature exerts widespread negative effects on SM. Evapotranspiration exhibits strong coupling in low-latitude monsoon regions, and near-surface wind acts as a supplementary but spatially constrained factor. This study contributes to an objective understanding of future SM dynamics and offers reasonable guidance for climate-resilient water resource planning.}
}
@article{ZHANG2026135565,
title = {Dissolved oxygen dynamics in shallow lakes under climate change: Synergistic modulation by nutrient loading},
journal = {Journal of Hydrology},
volume = {674},
pages = {135565},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135565},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006621},
author = {Fan Zhang and Xiaohong Shi and Shengnan Zhao and Ruonan Hao and Shihuan Wang and Ruli Kang and Lauri Arvola},
keywords = {Dissolved oxygen, Climate change, Nutrient loading, Ecosystem resilience, Oxygen production, Respiration metabolism},
abstract = {Under the dual stressors of global warming and eutrophication, the depletion of dissolved oxygen in lakes has become increasingly severe. However, the critical mechanism by which the effects of climate change on dissolved oxygen dynamics depend on lake trophic status remains inadequately understood. Based on long-term monitoring data from Lake Ulansuhai, this study employed piecewise structural equation modeling to elucidate the cascading effects of climatic factors and eutrophication on dissolved oxygen dynamics. The results reveal that dissolved oxygen dynamics are primarily governed by physical processes, with wind speed serving as the dominant positive driver by enhancing surface reaeration. The effect of air temperature exhibits a pronounced trophic-state dependence: under low-nutrient conditions, warming directly increases dissolved oxygen by enhancing physical and metabolic rates. As nutrient levels increase and substrate limitation is alleviated, warming suppresses the gains from photosynthetic oxygen production by enhancing biological metabolic oxygen, driving a reversal in the temperature- dissolved oxygen relationship from positive synergy to negative antagonism. Meanwhile, hydrological changes showed no significant effects on either dissolved oxygen or nutrient loads, indicating negligible roles of dilution or external inputs under the lake’s substantial environmental capacity and long hydraulic retention time. These findings underscore that nutrient load reduction is a key management strategy for enhancing lake climate resilience.}
}