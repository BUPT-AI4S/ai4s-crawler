@article{XU2026135532,
title = {A calculation of two-phase equilibrium method with lower computational overhead: constrained fixed point evolution algorithm},
journal = {Journal of Hydrology},
volume = {674},
pages = {135532},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135532},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006293},
author = {Liping Xu and Xinyun Ni and Hongbing Liu and Qinghua Su},
keywords = {Fixed point evolution algorithm, Helmholtz free energy, Heuristic optimization algorithms, NVT-flash, Phase equilibrium calculation},
abstract = {Numerous existing methods, including traditional ones (i.e., Newton’s method-based direct methods and thermodynamic principle-based indirect methods) and emerging approaches based on heuristic optimization algorithms, are capable of yielding reliable results for two-phase equilibrium computation problems under given mole, volume, and temperature conditions (NVT-flash). In contrast to traditional approaches, the heuristic optimization-based methods avoid sensitivity to initial values and are free from reliance on derivative gradient information. Nevertheless, these new methods suffer from substantial computational cost limitations. To tackle this issue, this paper presents a Constrained Fixed Point Evolution Algorithm (CFPEA) for solving NVT-flash calculation problems. The total Helmholtz free energy of the problem is taken as the objective function of this optimization process. The molar vector and the volume for a given phase serve as the optimization variables, and a feasibility resampling method is utilized to manage multiple inequality constraints. The Fixed Point Evolution Algorithm (FPEA) serves as the base method for step-by-step optimization. Numerical experiments are conducted on four NVT-flash cases commonly adopted by heuristic optimization algorithms, as well as two additional cases. Comparative analysis shows that across the four test cases, CFPEA achieves runtime reductions of 51.19%, 29.39%, 36.62%, and 68.08% relative to the fastest competing algorithm identified in each respective case, resulting in an average runtime reduction of 46.32%.}
}
@article{CEN2026135508,
title = {Bridging training–projection gaps in purely data-driven deep learning for runoff under climate change},
journal = {Journal of Hydrology},
volume = {674},
pages = {135508},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135508},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006050},
author = {Yiting Cen and Bin Yu and Rui Xiong and Mengqian Lu and Yong Tian and Feng Han and Peng Xu and Yi Zheng},
keywords = {Deep learning, Machine learning, physics-encoded LSTM, Pearl River Basin, Runoff projection, Climate change},
abstract = {Purely data-driven deep learning (DL) models show superior performance in runoff simulation but suffer from a critical training–projection gap, producing physically implausible results under significantly altered climate conditions. This study develops a physics informed Long Short-Term Memory (LSTM) framework that structurally embeds dynamic water balance and evapotranspiration modules to enforce physical consistency. Using the Pearl River Basin (PRB)—China’s second largest by discharge—and three additional subtropical basins as testbeds, we systematically assess the prevalence of this gap and demonstrate the framework’s ability to overcome it. Results show that standard LSTM models, which are purely data-driven, yield anomaly ratios of 61–100% under warming scenarios, often misinterpreting temperature rise as a runoff-generating signal. In contrast, the hybrid framework eliminates anomalous projections while maintaining or improving accuracy relative to process-based and purely data-driven models. The hybrid framework also corrects systematic biases in the PRB under CMIP6 scenarios: standard LSTMs erroneously amplify flood risks (overestimating up to 78 events per decade) and suppress drought signals (underestimating up to 9 events per decade) relative to the physically consistent benchmark provided by the hybrid DL. The model further highlights wet-season intensification in the PRB, with up to 30% increases in annual runoff but sharper seasonal contrasts. These basin- and sub-basin-level insights provide a more reliable scientific basis for climate adaptation strategies. Overall, the proposed framework offers a flexible, physics-encoded architecture that bridges the training–projection gap and advances DL toward more trustworthy hydrological projections under climate change.}
}
@article{QI2026135540,
title = {Incorporating the impacts of dynamic ponding storages of depressional wetlands in watershed-scale hydrologic modeling},
journal = {Journal of Hydrology},
volume = {674},
pages = {135540},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135540},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006372},
author = {Tiansong Qi and Xuefeng Chu},
keywords = {Surface depressions, Watershed hydrologic modeling, Contributing areas, Overland flow},
abstract = {Depressional wetlands play a significant role in watershed hydrologic processes. It is a challenge to directly incorporate the impacts of individual depressional wetlands in watershed-scale hydrologic modeling based on subbasin-scale wetland concepts. The objective of this study is to improve hydrologic modeling by taking into account real wetland features during the model conceptualization and simulation. To achieve this objective, a new dynamic ponding storage (DPS) modeling approach is proposed. In the DPS modeling, depressional areas are reformulated as a collection of integrated hydrologic units that explicitly represent the spatial heterogeneity and dynamic hydrologic functions of individual depressional wetlands. A storage-dependent routing scheme is proposed to incorporate the effects of dynamic ponding storage on overland flow routing in depressional areas. The DPS modeling approach is then coupled with the Soil and Water Assessment Tool (SWAT) and a DPS-SWAT model is developed. In the DPS-SWAT model, the spatiotemporal dynamics of ponded water in individual depressional wetlands and the resulting evolution of partial contributing areas are precisely simulated. The DPS-SWAT model was applied to a depression-dominated watershed located in the Prairie Pothole Region (PPR) of North America. The results highlighted the importance of incorporating a varying routing time for depressional areas associated with dynamic variations in ponding storages in overland flow routing. The DPS-SWAT modeling approach provides a novel and process-based modeling framework for evaluating and elucidating the influences of depressional wetlands on watershed hydrologic processes.}
}
@article{MORADI2026135474,
title = {Climate change impacts on water quality in a groundwater flow-through lake: a hybrid approach combining turbulence modeling and deep learning},
journal = {Journal of Hydrology},
volume = {674},
pages = {135474},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135474},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005718},
author = {Alireza Moradi and Ammar Safaie and Elena Litchman and Mantha S. Phanikumar},
keywords = {Water quality, Deep learning, GOTM, Thermal structure, Lake stratification, Climate change},
abstract = {This study examines the effects of climate change on water quality in Gull Lake, a deep inland lake in the Laurentian Great Lakes basin, using an integrated framework that combines the one-dimensional process-based General Ocean Turbulence Model (GOTM) with a Multilayer Perceptron (MLP) model. GOTM effectively simulates the lake’s thermal structure, achieving an RMSE of 1.00 °C over the period 2008–2018 by incorporating time-dependent light attenuation coefficients and groundwater interactions. The MLP model predicts key water quality variables, including temperature, dissolved oxygen (DO), and chlorophyll-a (Chl-a), with high accuracy (RMSE: 0.94 °C, 1.47 mg/L, and 0.57 µg/L, respectively) by leveraging thermal structure indicators such as thermocline depth and thickness derived from GOTM. The integrated framework effectively reproduces hypoxic and anoxic conditions, including the number of low-oxygen days. Projected climate forcing under the SSP5–8.5 scenario leads to higher air and lake temperatures, particularly in winter and spring, intensifying thermal stratification and weakening vertical mixing. These changes lead to increased Chl-a concentrations and DO levels, as well as persistent risks of eutrophication, hypoxia, and anoxia. By combining process-based and data-driven approaches, the research demonstrates how climate change, thermal stratification, and water quality dynamics interact in a deep, stratified lake. The findings highlight the importance of accounting for vertical thermal structure when predicting ecological responses to climate change, and provide insights into seasonal patterns and long-term trends in lake water quality dynamics under extreme climate forcing.}
}
@article{DING2026135568,
title = {Assessment of soil moisture trend coherence among major global soil moisture products},
journal = {Journal of Hydrology},
volume = {674},
pages = {135568},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135568},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006657},
author = {Tao Ding and Yanqing Yang and Wei Zhao and Jiujiang Wu and Xinyao Xie and Gaofei Yin and Jaime Gaona and Luca Brocca},
keywords = {GlobalSoil moisture product, Trend analysis, Coherence assessment, Inter-comparison, Mann-Kendall test},
abstract = {Soil moisture (SM) is a critical variable for global ecosystems, playing a key role in water cycles, climate regulation and agricultural productivity. While numerous remote sensing and reanalysis products provide global SM, their representation of long-term trends often exhibits significant discrepancies, creating uncertainty for climate studies and applications. To better evaluate the trend performance of these products, this study analyzes the temporal trends (2000–2023) of four seamless global SM products (ERA5-Land, ESA CCI, GLDAS, and GLEAM) and validates them against an amount of ground station data. Furthermore, a controlled gap-simulation experiment incorporating discontinuous sensor-based products (SMAP, SMOS, AMSR2 and NNsm) into a dual-baseline framework is conducted to disentangle the statistical artifacts caused by data gaps from the broader context of trend uncertainty. The results show a dominant global drying trend, though substantial discrepancies in trend magnitude and direction persist among products. Among the evaluated datasets, GLEAM demonstrates outstanding performance, achieving the highest agreement with in-situ observations in both trend magnitude (R = 0.57) and directional consistency (66.0%). Further analysis reveals that on a continuous reference time series, data missingness primarily leads to the missed detection of trend signals rather than causing actual trend reversals, which are mainly attributed to sensor physics and algorithmic limitations. In addition, the long-term trends of ESA CCI are heavily influenced by its scaling data (GLDAS), which may limit the product’s trend independence and requires further investigation. This study provides new methodological perspectives for the attribution of SM trend discrepancies, offering valuable guidance for user selection by recommending the prioritization of physically robust datasets (e.g., GLEAM) and the use of multi-product ensembles to mitigate specific biases.}
}
@article{ZHANG2026135471,
title = {Divergent anthropogenic and hydrological drivers regulate the spatiotemporal coupling of sedimentary DOM and heavy metals},
journal = {Journal of Hydrology},
volume = {674},
pages = {135471},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135471},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005688},
author = {Hangzhen Zhang and JinXi Song and Dandong Cheng},
keywords = {Sedimentary dissolved organic matter, Heavy metals, Spatiotemporal heterogeneity, Depth gradient, Natural and anthropogenic factors},
abstract = {Dissolved organic matter (DOM) in river sediments crucially influences the speciation and ecological risk assessment of heavy metals (HMs), while HM migration modulates DOM heterogeneity, thereby impacting aquatic carbon cycling. This study investigates the interactions between DOM and HMs (vanadium (V), chromium (Cr), arsenic (As), manganese (Mn), zinc (Zn)) in riparian sediments, examining their spatiotemporal distribution, source characteristics, and coupling mechanisms across seasonal and sediment depth gradients (0 cm, 0–15 cm, 15–30 cm). Fluorescence spectroscopy identified two major DOM components: humus-like (C1) and protein-like (C2 + C3) fractions. Dissolved Organic Carbon (DOC) concentrations increased with depth (6.33 ± 3.57 mg/L, 8.58 ± 2.82 mg/L, 8.78 ± 3.32 mg/L for surface, subsurface, deep layers respectively). HM vertical distribution exhibited clear differentiation: Zn concentrations decreased with depth, while Mn, Cr, V, and As accumulated in deeper layers. Pollution Load Index (PLI) analysis revealed significant contamination by As and Mn in the dry season, and by V, Zn, As, and Mn in the wet season, with PLI values exceeding 1 at most sampling sites. During the dry season, both humus-like and protein-like DOM components were regulated by Mn, Cr, V, and As; in contrast, wet-season protein-like DOM was primarily influenced by V, As, and Mn. Geographical and socioeconomic factors significantly impacted HM accumulation in sediments during the dry season, indirectly modifying DOM composition and properties. These findings underscore the complex dual controls of natural processes and human activities on DOM and HM biogeochemical cycling in aquatic sediments across depth gradients, providing targeted insights for river basin pollution management.}
}
@article{LIANG2026135463,
title = {Multi-water source mixing controls transformation of dissolved organic matter in a coastal intertidal zone},
journal = {Journal of Hydrology},
volume = {674},
pages = {135463},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135463},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005603},
author = {Ying Liang and Xulong Gong and Rui Ma and Qinglong Fu and Xue Jiang and Kaige Ma and Yuan Liu and Ziyong Sun},
keywords = {Intertidal zone, Dissolved organic matter, Groundwater-surface waterinteraction, DOM source tracing},
abstract = {The shallow intertidal zone experiences intense mixing of river water, seawater, and inland groundwater, regulating carbon storage and export. Understanding the key processes controlling the enrichment of dissolved organic matter (DOM) in intertidal porewater under such multi-source water mixing is essential for elucidating coastal carbon sequestration processes. This study integrated hydrochemical analyses, DOM characterization and end-member mixing models to quantify temporal and spatial heterogeneity of water mixing and DOM source-sink processes in the intertidal porewater within a coastal area of Jiangsu, China. Our results indicate that shallow intertidal porewater is primarily recharged by seawater (contributing 56.9 ± 13.2% in the wet season and ≥ 91.9% in the dry season) and river water (34.3 ± 11.1% in the wet season, declining to 2.7 ± 2.0% in the dry season), with minor contributions from regional groundwater (1.0–5.8% annually). DOM is mainly derived from marine sources (23.9–76.5%), while riverine and sediment contributes 13.3–33.7% and 9.1–60.9%, respectively. Seasonal shifts in water sources reshape DOM composition at different depths through direct inputs and by modulating in situ processes via changes in vertical salinity and redox conditions. Riverine and sediment-derived DOM inputs introduce terrestrial DOM dominated by lignin-like compounds, whose removal and accumulation are primarily controlled by adsorption/desorption and microbial processes. This study underscores that sediment-derived DOM represents a major and variable source to intertidal porewater, and that DOM characteristics are governed by hydrogeochemical conditions regulated by different water circulation depths.}
}
@article{YAN2026135524,
title = {AI-driven monitoring strategy optimization for nutrient-polluted groundwater in a desert site in Northwest China},
journal = {Journal of Hydrology},
volume = {674},
pages = {135524},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135524},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006219},
author = {Yuting Yan and Yu Liu and Baocai Tong and Jinsheng Wang and Rui Zuo and Yuyu Wan and Yuanzheng Zhai and Xu Han},
keywords = {Artificial intelligence, Natural attenuation, Nutrient pollution, Redox dynamics, Optimized monitoring},
abstract = {The hydrological cycle drives material transport and energy exchange within Earth’s critical zone while serving as a key conduit for aquifer pollution. Natural attenuation is a cost-effective remediation strategy, yet its implementation is hindered by redundant monitoring indicators and excessive sampling frequency. Current optimization efforts rely on “black models” that lack biogeochemical interpretability and fail to adapt to dynamic attenuation phases. To address these gaps, this study used interpretable Artificial Intelligence (AI) to reveal multi-stage attenuation patterns and the hydrochemical mechanisms controlling pollution at a desert site in Northwest China, enabling mechanism-informed monitoring optimization. Using high-frequency monitoring data, the eXtreme Gradient Boosting (XGBoost) with SHapley Additive exPlanations (SHAP) identified NH4+, Mn, dissolved oxygen (DO), and permanganate index (CODMn) as key determinants of water quality variations. Temporal analysis revealed a novel two-stage natural attenuation mechanism driven by redox heterogeneity. During early rapid attenuation, organic matter (OM) depletion shifted the aquifer to oxidizing conditions, coupling NH4+ nitrification with Mn precipitation. Notably, during the tailing stage, OM released from the vadose zone created localized reducing microenvironments within the broadly oxidizing system, triggering the coupling of Mn oxides dissolution and aerobic denitrification of NO3−, ultimately restoring groundwater quality to background levels. Based on these mechanistic insights, this study proposed a mechanism-driven, endpoint-oriented dynamic monitoring strategy: semimonthly during the rapid stage and quarterly during the tailing stage. These findings offer a perspective on balancing the monitoring costs with regulatory effectiveness in groundwater management.}
}
@article{GUL2026135479,
title = {HydroGRAF: Hybrid discharge reconstruction and basin-aware streamflow forecasting in the Himalayas},
journal = {Journal of Hydrology},
volume = {674},
pages = {135479},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135479},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005767},
author = {Aqib Gul and F.A. Shaheen and Masroor Majid},
keywords = {Spatio-temporal streamflow forecasting, Hybrid data reconstruction, Extreme value analysis, Graph attention networks, Uncertainty quantification, Jhelum River Basin, Himalayan hydrology},
abstract = {The study investigates hydrological variability, extreme flooding, and short-term probabilistic forecasting in the snow-monsoon Jhelum River Basin for the period (1975 to 2024), where discharge records exhibit 40% missing data. Weekly discharge data from 15 stations were analysed using non-parametric tests and extreme value models (GEV, GPD, Log-Pearson III). To address data scarcity, a new hybrid reconstruction approach was developed, combining lag predictors, autocorrelation, seasonal Fourier series, and ensemble machine learning techniques to preserve seasonality and extremes. For forecasting, a hydrologically informed graph attention network (HydroGRAF), was proposed, based on upstream–downstream connectivity, hydrological memory, and hydro-climatic drivers such as precipitation, temperature, snowmelt, ENSO, NAO, DMI, etc. HydroGRAF was benchmarked against LSTM, Temporal Fusion Transformer, graph neural networks, and persistence approaches, employing both deterministic (RMSE, NSE) and probabilistic (CRPS, coverage, reliability) metrics. Results show that HydroGRAF achieves NSE > 0.70 across stations, with substantial bias reduction (∼1–3 m3 s−1) compared to graph-based models (∼30–31 m3 s−1), and consistent improvements over persistence in univariate settings with CRPS reductions and near-nominal (≈0.94–0.96) coverage at most stations. In comparison to the existing techniques, the suggested framework can enhance the predictive skill by incorporating hydrological connectivity and data reconstruction in a single modelling framework. It is effective in data-scarce and non-stationary river systems.}
}
@article{YU2026135435,
title = {Coupled Bayesian inversion of time-lapse dispersive ground penetrating radar data to estimate soil hydraulic parameters},
journal = {Journal of Hydrology},
volume = {674},
pages = {135435},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135435},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005329},
author = {Yi Yu and Johan Alexander Huisman and Anja Klotzsche and Xiao Tao and Kun Zhang},
keywords = {Ground penetrating radar, Soil Hydraulic parameters, Dispersion analysis, Coupled inversion, Bayesian inversion},
abstract = {Dispersive ground penetrating radar (GPR) measurements are frequently obtained during infiltration events, as the increase in the permittivity of the upper soil layer induced by water infiltration leads to the formation of a near-surface low-velocity waveguide. These guided waves carry valuable information about the vertical distribution and temporal evolution of soil water content, which can be extracted through dispersion analysis and subsequently utilized for the parameterization of soil hydrological models. In this study, a Bayesian inversion framework coupling HYDRUS-1D with geophysical modeling was developed, in which the modified Differential Evolution Adaptive Metropolis (DREAM(zs)) algorithm was employed to infer the posterior distributions of two-layer soil profile parameters, including soil hydraulic properties and layer thickness, providing robust quantitative estimates along with rigorous metrics of uncertainty. Results from synthetic modeling experiments demonstrated that the proposed coupled Bayesian inversion approach can robustly recover soil hydraulic parameters and layer thickness while simultaneously quantifying their posterior uncertainty. Application of the method to experimental guided wave data yielded plausible parameter estimates that were consistent with those reported in previous studies at the same test site. Overall, these results demonstrate that the proposed coupled Bayesian inversion framework enables the simultaneous estimation of soil hydraulic parameters, layer thickness, and their full posterior uncertainties directly from time-lapse dispersive GPR data, providing an integrated hydrological-geophysical and uncertainty-aware approach for parameterizing soil hydrological models.}
}
@article{GUO2026135443,
title = {A unified fractional-order model for soil infiltration},
journal = {Journal of Hydrology},
volume = {674},
pages = {135443},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135443},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005408},
author = {Xinyi Guo and Xiaojun Guo and Yong Li and Siling Zhang and Jianyi Cheng},
keywords = {Soil infiltration, Fractional-order derivative, SWIG database, Unified function, Empirical relationship},
abstract = {Infiltration is typically described using exponential or power-law function, but it is challenging to determine which is preferable in practice. This study proposes a unified fractional-order model to integrate both the functions using fractional calculus based on the Mittag-Leffler function, which represents the transitional behavior between the two functions. We validated the model against the SWIG infiltration database across various soil types. Among the nine soil texture classes, 84.46% of cases achieved an NSE greater than 0.95, and 80.8% of fitted data points exhibited relative errors below 20%. Compared with existing models (Horton, Modified Kostiakov, Philip, and Tempered stable density), the proposed model achieves the best fitting performance and the lowest error metrics. This unified representation reduces sensitivity in model selection and supports practical applications.}
}
@article{MAHMOOD2026135495,
title = {Modeling groundwater dynamics in a low-lying sedimentary island driven by recharge variability, climate change, and water demand},
journal = {Journal of Hydrology},
volume = {674},
pages = {135495},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135495},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005925},
author = {Muhammad Qasim Mahmood and Xiuquan Wang and Farhan Aziz and Qing Li and Nadeem Tariq},
keywords = {Groundwater modeling, Stress-testing, Droughts, Recharge, Groundwater-surface water},
abstract = {Climate warming is reshaping seasonal recharge variability with growing implications for groundwater-dependent regions. Although seasonal recharge variability is increasingly recognized as a key control on groundwater dynamics, uncertainties remain regarding how hydraulic head and baseflow respond to these seasonal shifts, particularly across aquifers with varying hydrogeologic properties. We developed and calibrated a high-resolution transient groundwater flow model using MODFLOW 6 for Prince Edward Island (PEI), the only Canadian province almost entirely reliant on groundwater. We performed a series of model simulations to quantify the sensitivity of hydraulic heads and baseflow across the island under varying seasonal recharge, future climate change, and increasing water demand. The results indicate that spring recharge governs the magnitude of summer baseflow across PEI. Seasonal recharge stress tests indicate that spring and summer recharge deficits decrease groundwater and baseflow anomalies. Combined spring–summer deficits produce more than a two-fold increase in summer baseflow reductions compared with single-season deficits. Spring surpluses with summer deficits provide limited buffering. Under the high-emission climate projection scenario for far-century, hydraulic head anomalies increase across all seasons (+3% to + 19%), while baseflow anomalies increase in winter (+66% to + 113%) and fall (+20% to + 38%), but decline in spring (−26% to − 35%). Under the projected pumping scenario, seasonal anomalies increase moderately, while the seasonal pattern remains consistent. Regional anomaly differences demonstrate that drought sensitivity is controlled by hydrogeologic properties, with high (low) transmissivity aquifers responding rapidly (slowly) to seasonal recharge variations. These insights provide policy implications for strengthening drought resilience and managing groundwater sustainably.}
}
@article{ZHENG2026135512,
title = {Impact of dams on the water cycle in inland river basins of arid regions: based on runoff and isotope data},
journal = {Journal of Hydrology},
volume = {674},
pages = {135512},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135512},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006098},
author = {Zhijie Zheng and Guofeng Zhu and Rui Li and Yingying Jiao and Xiaoyu Qi and Jiangwei Yang and Wenmin Li and Yani Gun and Yuxin Miao and Qingyang Wang and Ziwen Liu},
keywords = {Human activities, Stable isotopes, Dams, Mean residence time},
abstract = {Identifying how human activities affect the water cycle is essential for improving water resource management. This study analyzes the differences in water Mean Residence Time (MRT) across different reservoir types in the Shiyang River Basin (SRB) using precipitation, surface water, and groundwater isotopes, aiming to identify the influence of specific human factors on water resource allocation. The study concluded: (1) The barrier effect of the dams led to a significant isotopic enrichment in the basin reservoirs, while the hydrological connection between reservoir water and groundwater was strengthened in the reservoir distribution area. (2) The MRT for reservoir water is generally longer than those for other surface water, with surface water having MRT in that order: Hydroelectric Reservoirs > Irrigation Reservoirs > Urban Landscape Dams > River Water (Runoff); (3) The Young Water Fraction (Fyw) is negatively correlated with MRT, exhibiting a sharp decline from natural headwaters to the reservoir systems, with the lowest recorded contribution ratio of 11.2% in The Xiying Reservoir region. Our research demonstrates that water infrastructure, particularly large-scale hydroelectric and irrigation reservoirs, fundamentally determines the storage and transport of water in arid inland basins and exerts a significant influence on hydrological patterns.}
}
@article{GUILLOTLEGOFF2026135504,
title = {Predicting microbiological contamination in urban rivers: an event-based indicator approach applied to the Seine river during the 2024 Paris olympic and paralympic games},
journal = {Journal of Hydrology},
volume = {674},
pages = {135504},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135504},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006013},
author = {Arthur {Guillot - Le Goff} and Yoann Cartier and Brigitte Vinçon-Leite and Sébastien Boyaval and Rémi Carmigniani},
keywords = {Microbiological water quality, Early warning system, Dimensionality reduction, Bathing waters, Urban rivers},
abstract = {Urban rivers are subject to microbiological contamination following the discharge of wastewater after heavy rains. These peaks of faecal contamination lead to health risks, particularly in urban bathing areas. To prevent these risks, European legislation requires early warning systems to be operated. This study proposes a new methodology for implementing an early warning system based on high-frequency measurements of bacteriological contamination proxies and hydro-meteorological data. By analysing these high-frequency data collected over three summer seasons (2021-2023) in the Seine River, Paris, France, the proposed framework defines rainfall events and their impact on microbial water quality. Dimensionality reduction techniques, including Principal Component Analysis (PCA) and Manifold ISOMAP, are applied and compared to identify key explanatory characteristics and build a predictive model. A global rain parameter (GRP) is derived, which effectively classifies rainfall events based on their potential impact on water quality. The method was successfully tested during the 2024 Paris Olympic and Paralympic Games, demonstrating its potential for real-time water quality management.}
}
@article{TRAN2026135520,
title = {Designing an inundation monitoring and real-time urban flood forecasting system: a synthetic study},
journal = {Journal of Hydrology},
volume = {674},
pages = {135520},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135520},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006177},
author = {Vinh Ngoc Tran and G.Aaron Alexander and Xun Huan and Chen Cheng and Francina Dominguez and Brian Jewett and Kevin Gray and Jongho Kim and Daniel B. Wright and Valeriy Y. Ivanov},
keywords = {Urban flood, Monitoring network, Vision transformer, Principal Component Analysis, Karhunen-Loève Expansion},
abstract = {Urban flooding due to extreme precipitation poses an increasing threat to cities, necessitating accurate, timely inundation predictions. This study presents a novel machine learning-based framework for urban inundation forecasting, addressing the challenges in computational efficiency and predictive accuracy. The approach integrates an ensemble of space–time varying rainfall scenarios, a high-fidelity flood model, and a machine learning surrogate model. Stochastically generated synthetic rainfall scenarios include extreme precipitation with various return periods. They are inputs to an urban flood model tRIBS-Urban that produces an ensemble of synthetic inundation fields that are synthetic “observations”. We combine Principal Component Analysis and Karhunen-Loève Expansion to optimize flood sensor placement and accurately reconstruct inundation maps from “observations” at a few locations. Application of a spatio-temporal vision transformer (ViT) as a surrogate model for tRIBS-Urban demonstrates excellent performance in capturing spatiotemporal patterns of inundation depth, with real-time forecasts produced in a few seconds for 1–12 h lead times, showing high accuracy (with Root Mean Square Error approximately 0.15 m and Kling-Gupta Efficiency greater than 0.75) and minimal cumulative error. By incorporating both rainfall and inundation observations, the inundation forecasts improved by 20–50% compared to those generated by the model without considering inundation data. This framework therefore shows significant potential to enhance flood prediction capabilities, offering a promising solution for improving urban flood resilience. Key points:●A novel machine learning framework integrates flood physical modeling and sparse sensor data for forecasting urban flood inundation.●A stochastic rainfall model offers diverse spatiotemporal precipitation scenarios, addressing limitations in infrastructure design standards.●A novel method optimizes flood sensor placement to accurately reconstruct inundation maps from (synthetic) sparse observations.●A machine learning model combines rainfall and observations to ensure high accuracy in flood prediction, outperforming traditional models by 20–50%.}
}
@article{YANG2026135572,
title = {Integrating machine learning with a novel karst hydrological model to enhance extreme streamflow simulation in karst regions},
journal = {Journal of Hydrology},
volume = {674},
pages = {135572},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135572},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006694},
author = {Qiyong Yang and Xungui Li and Jian Sun and Xu Dong and Mengru Wei},
keywords = {Streamflow simulation, Dry-wet event response, LSTM, WDE-KSWAT, Coupled model, Karst watershed},
abstract = {To improve streamflow simulation accuracy, particularly for extreme flood events in karst regions, this study addresses two key technical challenges: the limited ability of process-based models (PBMs) to represent the complex and highly heterogeneous hydrological processes controlling flood generation in karst systems, and the weak generalization capability of machine learning (ML) models under data-scarce conditions. By incorporating karst medium characteristics and an event-based dry-wet feedback mechanism, we coupled the wet-dry-event Karst SWAT (WDE-KSWAT) model with a Long Short-Term Memory (LSTM) network to develop a hybrid framework that integrates physical-process representation and data-driven learning, referred to as the LSTM-WDE-KSWAT model. Using the original SWAT and XGBoost models as benchmarks, we conducted comprehensive evaluations across three representative karst basins (seven hydrological stations) in southwestern China. WDE-KSWAT achieved good performance in all three basins, with mean R2, NSE, and KGE values of 0.76, 0.75, and 0.78 during calibration and 0.73, 0.73, and 0.80 during validation, representing absolute improvements of 0.13–0.20 over the original SWAT model. Overall, the LSTM model outperformed the process-based models and XGBoost, with mean R2, NSE, and KGE values exceeding 0.80 throughout the simulation period. Moreover, the coupled LSTM-WDE-KSWAT model further improved these metrics and demonstrated strong robustness during 28 extreme flood events, with mean values exceeding 0.85, significantly outperforming WDE-KSWAT, LSTM, and XGBoost. SHAP analysis suggests that WDE-KSWAT provides hydrological process variables with clear physical meaning, which contribute more to model predictions than conventional meteorological inputs. These findings highlight the importance of structural enhancements in process-based models and suggest that future hydrological modeling in karst regions can benefit from both advances in data-mining techniques and continued innovation in physical-process representation.}
}
@article{LIU2026135491,
title = {Accuracy assessment of microwave-based surface soil moisture products with multi-methods in the Yellow River Basin, China},
journal = {Journal of Hydrology},
volume = {674},
pages = {135491},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135491},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005883},
author = {Jingjing Liu and Qian Wang and Donghui Su and Yue Jia and Liuyang Li and Tiantian Shao and Wangxu Qian},
keywords = {Surface soil moisture, Yellow River Basin, Multiple validation, Triple Collocation, Microwave remote sensing},
abstract = {As the Yellow River Basin (YRB) faces pressing demands for sustainable agriculture and water resource management, accurate surface soil moisture (SSM) data have become a crucial limitation, making the evaluation of microwave-based SSM products an urgent priority. This study systematically evaluated performances of widely used SSM products in the YRB from 2015 to 2020, including the European Space Agency Climate Change Initiative active (CCI-A) and passive products (CCI-P), and the ascending and descending products from the Soil Moisture Active Passive (SMAP), the Soil Moisture and Ocean Salinity (SMOS), Chinese FengYun-3C (FY3C), and the Advanced Microwave Scanning Radiometer 2 (AMSR2). Multiple validation methods were employed, encompassing traditional direct validation against in-situ measurements and model-based reanalysis dataset, as well as using the Triple Collocation (TC) approach. Results showed that SMAP and CCI products performed well, with correlation coefficient/TC correlation coefficient (R/RTC) > 0.616 and unbiased Root Mean Square Error/TC Standard Deviation (ubRMSE/SDTC) < 0.050 m3·m−3, followed by SMOS and FY3C. The AMSR2 performed poorly (ubRMSE/SDTC > 0.082 m3·m−3) and exhibited a wet bias (> 0 m3·m−3), while all other products displayed dry biases (< 0 m3·m−3). The AMSR2 overestimation was related to the overestimation of soil temperature and Vegetation Optical Depth (VOD), while the SMAP and SMOS underestimation was driven by the underestimation of VOD. In terms of environmental factors, influence from Digital Elevation Model (DEM) was significant at the 3rd elevation grade and weaker at other grades, the impacts of Land Surface Temperature (LST) and precipitation increased as their values rose, and grassland exerted slightly smaller impacts on SSM accuracy compared to other land covers. This was the first comprehensive evaluation of widely used SSM products in the YRB using multiple validation methods, with results further promote the improvement of microwave-based SSM products.}
}
@article{LIU2026135552,
title = {Global patterns, drivers and temperature sensitivity of methane and carbon dioxide emissions from lakes},
journal = {Journal of Hydrology},
volume = {674},
pages = {135552},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135552},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006499},
author = {Shuang Liu and Feng Zhao and Yu Xue and Panpan Cui and Yindong Tong},
keywords = {Global lakes, Methane, Carbon dioxide, Temperature sensitivity, Human activities, Machine learning},
abstract = {Lakes are crucial carbon reservoirs in the Earth’s carbon cycle, influencing greenhouse gas (GHG) emissions. However, systematic quantification of methane (CH4) and carbon dioxide (CO2) emissions across lakes has been limited. This study integrates GHG data from 1,562 lakes with machine learning models to assess spatiotemporal patterns and drivers of CH4 and CO2 emissions globally. Results showed that global lakes emitted 167.09 Tg·CH4·yr−1 and 0.66 Pg·C·yr−1, with ebullition accounting for ∼ 70% of total CH4 emissions. Lake emissions displayed a strong latitudinal pattern, with mid- to high-latitude lakes in the Northern Hemisphere contributing the most. Based on the Random Forest modeling and Partial Least Squares Path Modeling, climatic and human activities were identified as the dominant drivers. The Boltzmann-Arrhenius equation and linear mixed-effects model revealed a strong temperature dependence of CH4 emissions (ETM = 0.76 eV), with the apparent activation energy of ebullitive fluxes (EEM = 0.92 eV) notably higher than that of diffusive fluxes (EDM = 0.66 eV), while CO2 exhibited a much weaker thermal response (ECO2 = 0.18 eV). Under the SSP585 (temperature-only scenario experiment), CH4 emissions can increase by as much as 19%. This study provides the global-scale quantification of the temperature dependence and multifactorial drivers of lake GHG emissions, highlighting the potential role of lake systems as “climate accelerators” under ongoing climate warming and intensified human activities. These results provide essential data constraints and methodological frameworks for enhancing global carbon budget assessments and GHG prediction models.}
}
@article{GIERSZEWSKI2026135528,
title = {Hydrological and hydrochemical response to climate signals in high-retention river–lake catchment},
journal = {Journal of Hydrology},
volume = {674},
pages = {135528},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135528},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006256},
author = {Piotr Jacek Gierszewski and Michał Fojutowski and Arkadiusz Bartczak and Dariusz Brykała and Sylvia Pinkerneil and Birgit Schröder},
keywords = {Climate change, River–lake systems, Baseflow, Catchment resilience, Stable isotopes, Hydrochemistry},
abstract = {Small headwater catchments with high retention capacity are important indicators of hydrological responses to climate change. This study evaluates the hydrological and hydrochemical response of a high-retention river–lake catchment (Ruda catchment, central Poland) to changing climatic conditions. Long-term meteorological and hydrological data (1952–2019), combined with recent hydrochemical and stable isotope monitoring (2017–19), were analyzed to assess the system’s sensitivity to climate signals. The results indicate a significant increase in air temperature (+0.19 °C per decade), rising evapotranspiration, and a progressively negative climatic water balance over the past two decades. Despite these changes, the Ruda system demonstrates high hydrological resilience, with stable, groundwater-fed baseflow (Base Flow Index: 89–99%) and only minor seasonal fluctuations in lake and groundwater levels. However, upper subcatchments exhibited reduced flow and greater seasonal variability. Multivariate analyses revealed spatial hydrochemical heterogeneity, especially in nitrate and sulfate concentrations. Stable isotope data (δ2H, δ18O) confirmed spatially variable recharge patterns and source water contributions across the catchment. Comparisons against the 1990–94 reference period show that, despite increased temperature and water deficits in 2017–19, key flow and chemical characteristics have remained largely stable. The study highlights the role of catchment retention capacity and subsurface connectivity in buffering climatic extremes and maintaining ecological stability. These findings support the interpretation that young-glacial river–lake catchments with strong groundwater connectivity may show substantial resilience to recent climate warming. They also indicate that the Ruda catchment can serve as a useful reference example for assessing hydrological change in comparable systems of the Central European lowlands.}
}
@article{YU2026135499,
title = {Q-CLASS: an observation-based reconstruction dataset for streamflow at China’s large dam sites},
journal = {Journal of Hydrology},
volume = {674},
pages = {135499},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135499},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005962},
author = {Jiamiao Yu and Kaiwen Wang and Yuqi Li and Xinyu Li and Haining Jiang and Qiuyu Luo and Changming Liu and Xiaomang Liu},
keywords = {Streamflow at the dam sites, Observation-based streamflow reconstructions, Bias correction, Ten-fold cross-validation},
abstract = {Streamflow dynamics at a dam site (Q) are fundamental for determining dam dimensions, reservoir storage capacity, and water supply reliability. However, the absence of Q data at a large number of dam sites limits existing research on Q variations to a small number of well-known dams, leaving most dams underexplored. Here, we bridge this gap by integrating streamflow observations across China with multi-source streamflow simulations. By overlaying 323 hydrological stations onto the digital river network, we derive observation-based streamflow at 326 large dam sites and use these data to evaluate 53 simulations from Earth System Models, Land Surface Models, Global Hydrological Models, and Machine Learning Algorithms. The evaluation results show that most simulations demonstrate acceptable performance in reproducing annual mean streamflow, but perform poorly in capturing interannual variations. To enable the use of these variation-biased simulations for reconstructing spatiotemporally continuous streamflow at all large dam sites in China, we further evaluate five broadly used bias-correction methods. Among them, the random forest model outperforms the others, with corrections converging most closely toward the observation-based values in Taylor diagrams. After validating model robustness through the ten-fold cross-validation and selecting the best-performing streamflow simulations, we reconstruct spatiotemporally continuous streamflow at 907 large dam sites across China from 1961 to 2014. Compared with raw simulations, the reconstructed dataset reveals pronounced changes in the spatial patterns and frequency distributions of long-term streamflow variations, including a shift in the drying-to-wetting ratio of natural streamflow from 1:1 to 2:1. Our dataset is publicly available at https://doi.org/10.6084/m9.figshare.30145870.}
}
@article{CHEN2026135536,
title = {Resilience assessment of an integrated green-grey-blue-control system for urban flood risk mitigation under changing climate and urbanization},
journal = {Journal of Hydrology},
volume = {674},
pages = {135536},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135536},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006335},
author = {Xiaolan Chen and Jun Liu and Haijun Yu and Yikai Chai},
keywords = {Urban flood risk, Green-grey-blue-control measures, Multi-objective optimization, Urbanization, Extreme rainfall, Economic loss},
abstract = {Rapid urbanization and climate change are increasingly exacerbating urban flood risks, posing significant challenges to the effectiveness of conventional green, grey, and blue infrastructure. This study proposes an Integrated Green-Grey-Blue-Control (IGGBC) system that incorporates non-structural control measures as a water level-based regulation strategy to enhance urban flood resilience. Furthermore, a multi-objective optimization of the IGGBC’s optimal layout was conducted, aiming to minimize cost and land occupation while maximizing flood mitigation performance. The results indicate that the IGGBC approach achieves synergistic improvements over conventional single-type measures, increasing the flood inundation reduction rate by 35.3% to 48.1%. Furthermore, it enhances drainage capacity from below a 5-year to a 50-year return period standard. Remarkably, even under a 100-year extreme event, the system also demonstrates considerable effectiveness in mitigating urban flooding, achieving an 88.7% reduction in economic losses. The multi-layered synergies of the IGGBC system prove effective in mitigating the compounded risks of extreme rainfall and urbanization, enhancing overall urban hydrological resilience. This work provides a scientific foundation for designing adaptive, multi-layered flood mitigation strategies under the backdrop of accelerating urbanization and climate variability.}
}
@article{LEE2026135531,
title = {Assessing urban flood susceptibility in Seoul, South Korea using machine learning models: effects of urban infrastructure and sampling variability},
journal = {Journal of Hydrology},
volume = {674},
pages = {135531},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135531},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006281},
author = {Yoonnoh Lee and Hyemin Jeong and Younghun Lee and Byeongwon Lee and Sangchul Lee},
keywords = {Urban flood, Urbaninfrastructure, Flood susceptibility mapping, TabPFN},
abstract = {Urban flooding causes severe damage in densely populated cities. Machine learning (ML) models have recently been adopted to assess urban flood susceptibility. Previous studies have rarely considered changes in ML model performance according to variable composition and repeated sampling. This study evaluated ML model performance for urban flood susceptibility in Seoul, South Korea under different input-data configurations (repeated sampling, and urban infrastructure variables [road, sewer system, and urban detention water system densities]). Two datasets were prepared with and without urban infrastructure using the same topographic and pedological variables. Flood inventory data (2010–2024) were used to define flooded and non-flooded areas, and five repeated samples were generated without replacement. Along with random forest (RF), extreme gradient boost (XGB), multilayer perceptron (MLP), and long short-term memory (LSTM), a transformer-based model, tabular prior-data fitted network (TabPFN), was applied. The major contributing variables were investigated using Shapley additive explanation (SHAP) analysis. The results showed that ML models incorporating urban infrastructure achieved approximately 0.03 higher accuracy and ROC–AUC than those without urban infrastructure. Among ML models, TabPFN showed the highest performance with an average accuracy of 0.81 and ROC–AUC of 0.90. Road density was the most influential variable, followed by elevation. For TabPFN, urban infrastructure inclusion increased the very high and low susceptibility classes by 2.7% and 17.0%, respectively, thereby enhancing spatial agreement with the historical flood data. These findings highlight the importance of urban infrastructure and the value of transformer-based models for urban flood susceptibility assessment.}
}
@article{VLCEK2026135511,
title = {Tracing water sources in a mountain catchment using stable isotopes: insights from peat and mineral soils},
journal = {Journal of Hydrology},
volume = {674},
pages = {135511},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135511},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006086},
author = {Lukáš Vlček and Jiří Kocum and Kristýna Falatková and Ondřej Ledvinka and Ye Su and Martin Pivokonský and Václav Šípek},
abstract = {This study uses stable water isotopes to investigate the hydrological role of mountain peat bogs and adjacent mineral soils in runoff formation. The study area, a small montane catchment (0.65 km2), consists of two adjacent hillslopes: a peat bog (Histosol) and a mineral soil (Podzol) hillslope, located in the Bohemian Forest, Czech Republic. This unique arrangement of hydrological units, sharing only the catchment outlet, provided an opportunity to investigate both units separately in terms of dominant water sources, flow paths, and residence times, and to assess their influence on catchment runoff formation. Water samples, including precipitation, groundwater, springs, and streamflow, were collected over seven hydrological years (2014–2020) and analyzed to determine the stable isotope composition (δ2H, δ18O) for subsequent isotope-based mixing model applications. The two hillslopes exhibited contrasting hydrological regimes. Peat bog groundwater showed substantial seasonal isotopic variability, enrichment during summer, and a clear evaporation pattern, with mean residence times shorter than one year, indicating rapid near-surface flow and limited storage capacity. In contrast, the mineral soil spring displayed a stable isotopic composition dominated by cold season (November–April) precipitation and snowmelt, with an estimated mean residence time of ∼3.6 years, reflecting deep percolation into weathered bedrock and long-term storage. Streamflow isotopic composition shifted towards peat-derived water during rainfall events, whereas baseflow was sustained primarily by mineral soil hillslope groundwater. These results demonstrate that peat bogs control short-term runoff dynamics. In contrast, mineral soils govern baseflow, highlighting the need to explicitly represent soil-specific flow paths and residence times in headwater hydrological assessments under changing climate conditions.}
}
@article{JIA2026135497,
title = {A new Lagrangian Adaptive Multi-Layer Snow (LAMS) scheme for modelling snowpack evolution},
journal = {Journal of Hydrology},
volume = {674},
pages = {135497},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135497},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005949},
author = {Yinghui Jia and Yuefei Huang and Shuo Zhang},
abstract = {Snow cover dynamics exert strong controls on the global climate system, hydrological cycle, and freshwater availability. Traditional snow schemes embedded in land surface models often rely on fixed-layer or Eulerian scheme formulations, which can suffer from numerical diffusion and imprecise interface tracking during snow layer evolution, phase change, and mass transport. Here we present a Lagrangian, layer-tracking snow model—LAMS (Lagrangian Adaptive Multi-Layer Snow model)—that explicitly follows the physical evolution of each snow layer through compaction, freeze–thaw cycles, and rainfall/snowfall events. An adaptive layer management algorithm creates new layers during snowfall and removes layers that have completely melted, thereby preserving the dynamic stratified structure of the snowpack. Each layer evolves in thickness, density, liquid water content, and ice content under coupled mass and energy balance equations. Because LAMS is not constrained by a fixed number of layers, it naturally handles snowfall-driven accretion and melt-driven ablation without remeshing artifacts, thereby reducing numerical diffusion and improving interface fidelity. Across multiple SnowMIP sites, LAMS reproduce both snow depth and snow water equivalent (SWE) with robust skill, with average Kling-Gupta Efficiency (KGE) and Nash-Sutcliffe Efficiency (NSE) values exceeding 0.80. The normalized root mean square error (NRMSE) ranges from 0.23 to 0.61 for snow depth and from 0.28 to 0.63 for SWE. Simulated internal temperature profiles are also consistent with established empirical patterns and previous studies of snowpack thermodynamics. Although several snowpack-specialized models, such as SNOWPACK and CROCUS also use Lagrangian concepts, LAMS adopt a distinct framework based on coupled governing equations and an explicit numerical method. This approach is more readily integrated into land surface models while maintaining robust performance across diverse snowpack regimes. Compared with the two-layer snow module in VIC (Variable Infiltration Capacity) model, LAMS yields a more physically consistent representation of snowpack evolution, improving SWE NSE by 12–37% and reducing NRMSE by 23–40%. Coupling LAMS with land-surface or hydrological models will enable more reliable assessments of snow dynamics and water-resource impacts under climate change.}
}
@article{DI2026135478,
title = {Generalization of an innovative flood risk assessment model integrating hydraulic instability of pedestrians and vehicles with siltation in urban drainage pipelines},
journal = {Journal of Hydrology},
volume = {674},
pages = {135478},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135478},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005755},
author = {Danyang Di and Hao Hu and Zhaoyang Zhang and Hao Jia and Mengyu Li and Jingbo Xu},
keywords = {Urban flooding, Flood risk assessment, Hydraulic parameter calibration, Instability of pedestrians and vehicles, Physics-informed neural network},
abstract = {Existing flood risk assessment models ignore the impact of pipeline siltation on the accuracy of flood simulation and do not take into account the risk of hydraulic instability for pedestrians and vehicles. Against this backdrop, a flood risk assessment model considering hydraulic instability of pedestrians and vehicles was proposed. Firstly, drawing upon previous research, the critical flow velocity control equations for hydraulic instability of pedestrians and vehicles in floods were formulated by adopting Newtonian mechanics analysis and physical constraints of probability density functions. Then, instability curves were corrected by adopting safety margin coefficient and adaptive penalty method. On this basis, a physical information-guided intelligent prediction model for pipeline siltation was constructed by analyzing the hydraulic response characteristics of silted pipes and manholes, and an improved flood simulation model incorporating the effects of pipeline siltation was established. Finally, by conducting a case study on a specific district in Kaifeng City, China, we evaluated the accuracy of the improved flood model and the spatial distribution characteristics of urban flood risks. The results show that the flood model considering pipe siltation can increase the NSE of manhole water depth and pipe flow by [0.262, 0.339] and [0.311, 0.362] respectively, and reduce the ER of surface water depth by [4.2%, 25%]. Compared with the scenario without considering pipe siltation, the maximum increase rates of NSE for manhole water depth and pipe flow are 57.6% and 63.3%, respectively, and the maximum reduction in ER for surface water depth is 25%. The proposed method can better facilitate the government in decision-making for flood risk mitigation.}
}
@article{FANG2026135515,
title = {A dynamic pseudo-label driven dual-branch transformer framework for multi-scenario lake water body mapping},
journal = {Journal of Hydrology},
volume = {674},
pages = {135515},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135515},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006128},
author = {Kedi Fang and Bo Wang and Si Chen and Huaqi Gu and Rui Xia and Hai Liu},
keywords = {Dynamic pseudo-label updating, Lake water body mapping, Self-supervised deep learning, Transformer},
abstract = {Accurate identification and vectorized mapping of lake water bodies are of great significance for the fine-grained management of basin water resources. However, traditional index threshold methods lack generalization capability under complex surface backgrounds, while high-precision deep learning models heavily rely on massive and expensive manual annotations. Although unsupervised learning driven by pseudo-labels has become an important research trend in this field, existing methods generally ignore the uncertainty of mixed pixels at the land–water boundary, which easily introduces structural noise into the network. Furthermore, single pixel-level segmentation struggles to directly output regular, closed vector geometries. To address these challenges, this study proposes a lake water body mapping framework with dynamic pseudo-label updating (DPLM). First, by introducing edge response constraints into the joint feature space of multi-dimensional water indices, high-confidence pseudo-hard labels and pseudo-soft labels expressing uncertainty are automatically constructed. Second, a dual-branch gated Transformer network is designed, where the quality branch dynamically suppresses noise and drives the continuous updating of pseudo-labels during self-training. Finally, by integrating Simple Linear Iterative Clustering (SLIC), Dense Conditional Random Fields (DenseCRF), and marker-controlled watershed algorithms, the stabilized probability maps are converted into closed and connected lake water body polygons. Comprehensive evaluations based on a multi-scenario lake dataset constructed in the Yangtze River Basin of China (YRB-Lakes) and the public CNES ALCD dataset show that DPLM achieves optimal F1 scores of 97.34% and 92.94%, and Intersection over Union (IoU) of 94.83% and 86.91% on the two datasets, respectively. Across 10 independent validation regions, the model’s highest Precision reaches 97.80%, with an overall boundary completeness and correctness of 84.60% and 85.40%, respectively. Ablation experiments confirm that the multi-index pseudo-label generation and dynamic updating mechanisms effectively eliminate the accumulation of initial threshold noise. In extreme scenarios involving alpine snow/ice and complex vegetation shadows, DPLM exhibits optimal robustness compared to other state-of-the-art (SOTA) water body extraction models. Moreover, compared to existing mainstream global water mapping products, DPLM demonstrates significant advantages in suppressing complex background interference and extracting fine water bodies. It also possesses excellent cross-sensor transferability, providing a reliable solution for the long-term, high-precision automated monitoring of large-scale lakes and reservoirs.}
}
@article{ZENG2026135567,
title = {Characterization of uncertainty in ground-based validation of soil moisture products: A case study of QLB-NET in the Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {674},
pages = {135567},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135567},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006645},
author = {Qicheng Zeng and Xiaodan Wu and Jianguang Wen and Gaofei Yin and Xingwen Lin and Yukun Li and Dongqin You and Qing Xiao},
keywords = {Soil moisture, Uncertainty, Pixel-scale reference “truth”, Representativeness errors, Geolocation mismatches errors},
abstract = {Direct validation through in-situ measurements is a primary approach for assessing the accuracy of soil moisture (SM) products. However, validation results carry significant uncertainties due to errors inherent in ground measurements, representativeness errors, and geolocation mismatches between in-situ sites and product pixels. The mechanisms through which these factors contribute to the overall uncertainty of pixel-scale reference “truth” remain unclear, complicating uncertainty control. This study is the first to investigate the uncertainty of validation results obtained from in-situ measurements. It reveals the magnitude and influencing factors of representativeness errors, proposes a method for identifying pixel geolocation shifts in sub-pixel-scale satellite SM products, and quantifies the resulting errors. The results indicate that representativeness errors are significantly larger than errors caused by geolocation mismatches, dominating the overall uncertainty of pixel-scale reference “truth”. Representativeness errors result in an underestimation of SM product consistency and an overestimation of uncertainty. More than half of the sites exhibit representativeness errors exceeding 40%, with a maximum reaching 154%. Representativeness errors are primarily determined by spatial heterogeneity within the validation pixel and the number and spatial location of in-situ sites. The impact of spatial heterogeneity can be mitigated by optimizing site locations, and increasing the number of sites to 3 can reduce representativeness errors to below 5%. Errors due to geolocation mismatches are related to the degree of pixel shift and the spatial heterogeneity of the surrounding area. This type of error exceeds 15% approximately half of the time, with a maximum reaching 51.8%.}
}
@article{YAN2026135578,
title = {Transformer-enhanced extraction of operating rules for multi-objective reservoir groups: a min river basin case study},
journal = {Journal of Hydrology},
volume = {674},
pages = {135578},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135578},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600675X},
author = {Mengting Yan and Shaowen Yi and Weibin Huang and Guanghua Qin and Yanmei Zhu and Guangwen Ma},
keywords = {Reservoir operating rules, Deep learning, Feature screening, Physical constraints, Multiobjective optimization},
abstract = {Effective basin-scale water resources management faces increasing complexity due to the high-dimensional, nonlinear, and strongly coupled nature of multi-reservoir systems. Existing methods for extracting reservoir operation rules often struggle to accurately capture these intricate response relationships. To address this challenge, this study introduces a triple-enhanced Transformer model that integrates “feature screening-constraint incorporation-parameter optimization” to achieve high precision and efficiency in rule extraction. The model utilizes the solution sets derived from a multi-objective optimization model as input samples. It first evaluates the importance of the features and screens them based on a ReliefF-mRMR hybrid framework. Secondly, the multi-head attention mechanism of the Transformer model is utilized to capture complex inter-reservoir feedback dynamics. Operational water level constraints are incorporated into the model within a constraint-aware loss function to ensure the feasibility of the outputs, and genetic algorithms (GA) are employed for hyperparameter optimization. The proposed model is then tested against scheduling rule extraction models that utilize temporal convolutional networks (TCNs), long short-term memory (LSTM), and benchmark Transformers. The results reveal that: (1) under the same set of screened input variables and identical constraint handling, the proposed model achieves an average simulation accuracy improvement of at least 4.1% compared to alternative methods, while demonstrating greater prediction stability; (2) the constraint-aware loss function effectively reduces the likelihood of generating infeasible solutions, improving the qualification rate by 12.5%; and (3) the feature-screened model can decrease computation time by 12.3% compared to those using the full feature set, while maintaining basic accuracy consistency.}
}
@article{LI2026135523,
title = {Near-real-time SAR flood detection using feature fusion and region-adaptive deep learning method},
journal = {Journal of Hydrology},
volume = {674},
pages = {135523},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135523},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006207},
author = {Song Li and Kai Liu and Qiao Wang},
keywords = {Near-real-time flood detection, SAR, Deep learning, Feature combination, Urban floods},
abstract = {Flood mapping is critical for emergency response, and Synthetic Aperture Radar (SAR) enables weather-independent, near-real-time observations. However, accurate SAR-based flood mapping in urban areas remains challenging. Existing methods lack explicit inundation-type distinctions and confuse the complex SAR signals associated with different regional flooding. Deep learning (DL) models on newly constructed global flood datasets remain insufficient to address these issues. To fill this gap, we proposed RAFNet, a region-adaptive feature-combination network for three-class (non-flood, open-area flood and urban flood) Sentinel-1 flood mapping using the UrbanSARFloods dataset. We first constructed region-specific SAR feature subsets tailored to urban and open areas to better capture distinctive flood responses. A dual-branch expert architecture with a differentiable routing head then dynamically assigned each pixel to either branch, reducing signal confusion and better representing regional heterogeneity. Each branch integrated region-prior feature subsets with shared features to improve classification accuracy. Experiments on the 2021 Henan flood event showed that RAFNet achieves high accuracy (OA = 0.978, Kappa = 0.870), with substantial urban improvements over baselines while maintaining open-area performance. Additional tests on independent events confirmed good generalization. This work provides a reliable and efficient solution for large-scale, region-aware flood monitoring.}
}
@article{DU2026135494,
title = {Impact of isolated mountains on groundwater hydrochemical evolution: insight from isotopic and geochemical analysis},
journal = {Journal of Hydrology},
volume = {674},
pages = {135494},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135494},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005913},
author = {Aoao Du and Fu Liao and Yourang Zan and Ziwen Zhang and Bingchao Yang and Xiangzhi You and Qingming Zeng and Guangcai Wang},
keywords = {Hydrogeochemical evolution, Mountain effects, Basin, Multi-isotopes analysis},
abstract = {From the mountain front to the distal plain in many basins, isolated mountains are common geomorphic features; however, their role in controlling basin-scale groundwater evolution has received limited attention. In this study, multiple isotopes (O, H, and C) combined with hydrochemical indicators are employed to investigate how an isolated mountain influences groundwater evolution in the Xiao Qaidam Basin, Northwest China. Results indicate that the presence of the isolated mountain situated within the plain may exert a significant influence on the evolutionary pathways of phreatic groundwater. Along the flow direction from the recharge area toward the distal basin, groundwater evolves from Cl⋅HCO3-Ca⋅Na and Cl⋅SO4⋅HCO3-Na⋅Ca types into Cl-Na. The total dissolved solids (TDS) initially decrease and then increase, while groundwater ages (14C) first decline and then rise. Similarly, δ2H and δ18O values show a pattern of initial depletion followed by enrichment. These observations suggest that the presence of the isolated mountain prolongs groundwater residence time, leading to relatively enriched δ2H and δ18O signatures, and the formation of high TDS and Cl⋅SO4-Na⋅Ca type water. In contrast, the hydrogeochemical evolution of confined groundwater is governed by distinct hydrogeological processes. Confined groundwater is characterized by depleted stable isotopes (δ2H and δ18O), saturation indices (SI) substantially lower than those of phreatic water, hydrochemical facies dominated by bicarbonate, lower TDS, and considerably older groundwater ages. These features suggest that confined groundwater is controlled by deeper circulation pathways and unaffected by the isolated mountain. These findings provide new insight into groundwater evolution in alluvial-proluvial basin systems.}
}
@article{WANG2026135563,
title = {Mixing and transformation processes of water sources in the lower Yarlung Tsangpo River: Insights from δ18O, Δ17O, 222Rn, and hydrochemistry},
journal = {Journal of Hydrology},
volume = {674},
pages = {135563},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135563},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006608},
author = {Zejun Wang and Zhi Dou and Jinguo Wang and Xuegao Chen and Chaoqi Wang and Zhifang Zhou},
keywords = {Yarlung Tsangpo River, Multi water mixing, Stable isotopes, Radon‑222, Hydrochemistry, Self‑organizing map},
abstract = {The complex hydrology of the lower Yarlung Tsangpo River, shaped by extreme topography, complex meteorology, heterogeneous geology, and multi-source recharge, poses a significant challenge for quantifying water source dynamics. Here, we employ an integrated framework combining hydrochemistry, stable isotopes (δ2H, δ18O, δ17O, d-excess, Δ17O), radiogenic 222Rn, and self-organizing map (SOM) clustering to delineate water mixing and transformation pathways. Our findings reveal a fundamental seasonal shift from precipitation and surface-runoff dominance in summer to groundwater and cold-region meltwater dominance in winter, resulting in the elevated solute concentrations, higher 222Rn activities, and more depleted δ2H, δ18O, and δ17O during the cold season. The hydrological reorganization is expressed through distinct pathways: efficient alpine meltwater delivery and direct low-altitude inputs during the rainy season preserve signatures of minimal evaporation (d-excess > 13‰, low 222Rn, variable δ18O), whereas delayed recharge through surface and subsurface flow during the dry season imprints evidence of evaporation and water–rock interaction (d-excess < 13‰, Δ17O above theoretical value, variable 222Rn). Groundwater emerges as a critical multiple contributor, comprising both a shallow endmember elevating river ion concentration and a deep-circulating component marked by intense sulfuric acid weathering, high SO42− and 222Rn activities, and shifted δ18O signatures. The resultant hydrochemistry, shaped by coupled silicate and carbonate weathering, exhibits strong spatial heterogeneity controlled by geologic zonation, highlighting the subsurface’s control on riverine composition. This work establishes a process-based framework for deconvolving water sources and transformation processes in high-relief, heterogeneous river systems, providing critical insights for sustainable water resource management.}
}
@article{QIU2026135466,
title = {Impact of argillaceous sediment consolidation on groundwater quality evolution: new insights from numerical simulations of porewater and solute release},
journal = {Journal of Hydrology},
volume = {674},
pages = {135466},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135466},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005639},
author = {Wenkai Qiu and Yao Du and Teng Ma and Wenhui Liu and Yetong Liu and Xiaochuang Bu and Bolin Zheng and Ziqi Peng and Cong Xiao and Qiwei Huang},
keywords = {Solute release, Argillaceous sediments, Groundwater quality deterioration, Large strain consolidation model, Porewater, Clay},
abstract = {The consolidation of argillaceous sediments and the accompanying release of porewater and solutes during groundwater abstraction are key drivers of groundwater-quality deterioration in water-stressed regions, yet the governing physical mechanisms are often overlooked. In this study, observations and simulations revealed that solute release during clay compaction is not simply proportional to the solute concentration and porewater volume. Using a custom-built oedometer, we continuously recorded the moisture content, pore stress, and permeability, and found a ∼ 100-fold drop in the permeability once the moisture content reached the liquid limit (∼0.55). This sharp decline amplified the excess pore stress and promoted mixing between free and bound porewater when pore stress exceeded ∼ 0.25 MPa. Numerical simulations that coupled time-dependent physical properties with large-strain consolidation theory reproduced the observed moisture and pore-stress profiles. When porewater geochemical inhomogeneity and mixing effects—quantified in our previous work—were included, the model captured most of the evolution of Sr, HCO3–, dissolved organic carbon, NH4+, and arsenic. These results demonstrate that time-variable physico-chemical properties, especially permeability and geochemical inhomogeneity, govern the partitioning of free versus bound water and the associated solute release. Neglecting these processes overestimates solute release from free porewater and underestimates that from bound porewater, with biases of up to 70% when the initial moisture content approaches the liquid limit and the loading rate is high. By embedding these factors in clay-consolidation modelling, our framework improves predictions of porewater and solute release under varying abstraction scenarios and informs the design of more sustainable groundwater abstraction strategies.}
}
@article{CHEN2026135519,
title = {Integrating GNSS and GRACE/GRACE-FO with GCV joint inversion for improved terrestrial water storage estimation in California},
journal = {Journal of Hydrology},
volume = {674},
pages = {135519},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135519},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006165},
author = {Peinan Chen and Wei Qu and Xingyou Tang and Jiuyuan Li and Haopeng Zhang},
keywords = {California, Generalized cross-validation (GCV), GNSS, GRACE/GRACE-FO virtual stations, Joint inversion, Terrestrial water storage (TWS) changes},
abstract = {The integration of Global Navigation Satellite System (GNSS) and Gravity Recovery and Climate Experiment (GRACE)/ GRACE Follow-on (GFO) data for studying terrestrial water storage (TWS) variations helps overcome the limitations of each dataset in hydrological signal extraction, thereby providing a robust foundation for sustainable water management, extreme hydrological event warning, and climate change adaptation. In this study, a joint inversion model based on Akaike’s Bayesian Information Criterion (ABIC) and Generalized Cross-Validation (GCV) was applied to estimate TWS changes in California using integrated GNSS and GRACE/GFO data. We systematically compared the spatiotemporal characteristics of results from different joint inversion strategies, validated their performance through closed-loop simulation experiments and multi-source hydro-meteorological data, and quantitatively evaluated the combined effects of precipitation, evapotranspiration, and runoff on TWS changes. The results showed that the joint inversion approach significantly outperformed independent inversion methods. The GCV-based joint inversion model achieved better performance than the ABIC-based approach, as it assigned a higher relative weight to the more accurate GNSS data in California. Additional experiments conducted in Iowa further confirmed the superiority of the GCV model, demonstrating its ability to prioritize data sources with smaller errors during weight allocation. Moreover, the joint inversion results were more consistent with Precipitation–Evapotranspiration–Runoff estimates than the independent inversion results, reducing the root mean square error by 7.7%–17.9%. The comprehensive impact analysis indicated that runoff is the most direct indicator of TWS changes in California, and precipitation remains the dominant contributing factor.}
}
@article{LIU2026135527,
title = {Hydrodynamic reconstruction regulates carbon emissions in water diversion rivers},
journal = {Journal of Hydrology},
volume = {674},
pages = {135527},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135527},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006244},
author = {Shiqi Liu and Zhenhua Yan and Yufang Chen and Xi Chen and Tian Ouyang and Saiyu Yuan and Guanghua Lu},
keywords = {Hydrodynamic reconstruction, Carbon cycling, Microbial carbon use efficiency, Greenhouse gas emissions, Hydrologic controls},
abstract = {Hydrodynamic reconstruction driven by China’s national water network has been widely implemented to balance water resources and improve water quality, but it also poses emerging challenges to the stability of carbon cycling at aquatic critical zone interfaces in water diversion rivers. However, the related regulatory pathways in riverine carbon biogeochemistry remain poorly understood. Here, we used controlled mesocosms manipulating both water depth and flow velocity to reveal how hydrologic controls imposed by hydrodynamic reconstruction regulate carbon transformations and emissions. Results showed that depth primarily governed ionic strength, whereas flow velocity modulated oxygen dynamics, together shaping the microenvironmental conditions that regulate carbon substrate partitioning. Deeper water with slow flow created reducing environments that enhanced microbial biomass carbon, increased carbon use efficiency (CUE), stimulated methanogenesis, and lowered the net warming potential. In contrast, higher flow velocity strengthened oxygen delivery, stimulated aerobic respiration and carbon mineralization, leading to CO2-dominated emissions, rapid depletion of labile carbon, and an intensified warming potential. CUE emerged as a central mediator linking hydrologic conditions to divergent CO2 and CH4 emission pathways, revealing a hydrologic-biogeochemical mechanism underlying carbon cycling in water diversion rivers. The increased water depth enhanced microbial carbon retention and reduced CO2 flux by 25.65%, while shifting CH4 from a net sink to a net source. In contrast, the increased flow velocity accelerated labile carbon loss, increased CO2 flux by 89.04%, and reduced CH4 fluxes by 65.06%. These findings provide a new ecological perspective for evaluating the environmental benefits of national water network construction and offer scientific guidance for optimizing hydrodynamic management to support China’s carbon peaking and carbon neutrality goals.}
}
@article{SAISUSWARA2026135482,
title = {Decoding parameter sensitivities across scales: a Wavelet–Sobol framework for hydrological modelling},
journal = {Journal of Hydrology},
volume = {674},
pages = {135482},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135482},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005792},
author = {Vaddadi {Sai Suswara} and Velpuri Manikanta and Maheswaran Rathinasamy},
keywords = {Wavelet–Sobol sensitivity analysis, Multi-scale hydrological modelling, HBV model, Time–frequency decomposition, Parameter identifiability, Global sensitivity analysis},
abstract = {Hydrological models are essential for understanding the dynamics of hydrological processes, which vary across different time scales from seconds to millennia. However, accurate model calibration remains a significant challenge due to scale mismatches between hydrological processes and their conceptual representation within the model, parameter equifinality, and the high dimensionality of complex structures. Sensitivity analysis plays a crucial role in addressing these challenges by identifying parameters that most strongly influence model outputs, thereby guiding efficient calibration, reducing uncertainty, and improving process understanding. Traditional calibration and sensitivity analyses typically evaluate model performance in the aggregate time domain, assuming parameter influence is uniform across scales. This assumption oversimplifies system dynamics, as parameters governing event-scale variability may differ from those controlling long-term hydrological trends. To overcome this, we propose a novel framework for time–frequency-scale dependent sensitivity analysis by integrating wavelet decomposition with Sobol’s global sensitivity analysis. This approach enables the identification of influential parameters at specific time scales, thereby improving process identifiability and allowing for more targeted calibration. We evaluate the proposed framework using HBV hydrological model across six catchments of varying hydroclimatic and physiographic characteristics, comparing results from both traditional and wavelet-based sensitivity rankings. Results reveal distinct scale-dependent parameter sensitivities, with short-term dynamics controlled by different parameters than those influencing long-term behaviour. The wavelet-based framework also identified influential parameters overlooked by traditional methods and improved model performance, with calibration gains ranging from 3.3% to 17.9% with all improvements being statistically significant (p < 0.05). This framework unites multi-scale hydrological behaviour with traditional sensitivity methods, improving model reliability.}
}
@article{LIU2026135503,
title = {Harnessing structured deep clustering and information entropy for spatially balanced optimal deployment of water quality sensors in water distribution systems},
journal = {Journal of Hydrology},
volume = {674},
pages = {135503},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135503},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006001},
author = {Mengyuan Liu and Hanmeng Bu and Jiaying Wang and Hexiang Yan and Kunlun Xin and Tao Tao},
keywords = {Water quality sensor deployment, SDCN, Water quality zoning, Multi-indicator optimization},
abstract = {To enhance the effectiveness and spatial rationality of routine water quality monitoring in water distribution networks (WDNs), this study proposes a multi-point optimization method that integrates information theory, multi-indicator collaboration, and structured deep clustering. The framework jointly considers two key water quality indicators, water age and residual chlorine. It further employs a Structured Deep Clustering Network (SDCN) to achieve high-consistency zoning. Candidate monitoring points are assessed by their multi-indicator information-entropy gain and their contribution to spatial coverage. A greedy algorithm is then used to construct an optimized sensor layout under spatial constraints. The method is applied to both the benchmark BWSN 1 network and a real-world water distribution system in MD Town, Jiangsu Province. Results show that the proposed approach outperforms existing layouts in terms of information acquisition, redundancy control, and spatial balance. It also demonstrates strong adaptability across monitoring scenarios and practical engineering feasibility. In particular, refined quality zoning and marginal-utility analysis lead to a deployment strategy that achieves an effective trade-off between monitoring cost and information representation. This provides a practical pathway for intelligent sensor deployment in complex WDNs.}
}
@article{EVANGELISTI2026135490,
title = {Out of bounds: the use of model ensembles to explore model structural uncertainty under extreme events},
journal = {Journal of Hydrology},
volume = {674},
pages = {135490},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135490},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005871},
author = {Margherita Evangelisti and Vincent Pons and Spyros Pritsis and Vittorio Di Federico and Franz Tscheikner-Gratl and Marco Maglionico},
keywords = {Structural uncertainty, Boundary condition, Model diagnosis, Urban drainage modelling},
abstract = {The response of an urban drainage model to extreme events cannot be investigated independently from the abstraction process adopted in model development. The work explores structural model uncertainty, and particularly the impact of boundary conditions, using an Italian catchment that has been the subject of several modelling studies over the years. While previous research has focused on parameter optimization, limited attention has been devoted to model structure and boundary conditions. However, during extreme events, not only model parameters but also boundary conditions significantly influence system behavior. Model structural uncertainty is investigated through the development of four model configurations organized into two model structure classes: the first class reflects the original system structure, while the second incorporates downstream boundary condition based on a re-analysis of the system. Within each class, two models were developed and calibrated by including or excluding extreme events. Each configuration is represented by an ensemble of models, which were then subjected to synthetic extreme storms. Disagreement among their responses is used to diagnose structural uncertainty. Moreover, the study analyzed the risks associated with using a model calibrated on extreme events without properly accounting for system structure, underlining the potential consequences of such an approach. Given the expected increase in frequency and intensity of extreme events under future climate conditions, the work emphasizes the central importance of contextual knowledge and boundary conditions in model development. A thorough understanding of system structure and context is a necessary prerequisite for effective calibration of model parameters. Parameter calibration cannot be separated from knowledge of model structure: rather than being a purely automatic process, it must be guided by the modeler’s conscious choices.}
}
@article{LIANG2026135530,
title = {Disentangling climate-driven and vegetation-mediated impacts on water resources in the upper Yellow River Basin},
journal = {Journal of Hydrology},
volume = {674},
pages = {135530},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135530},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600627X},
author = {Zhi Liang and Ruochen Sun and Qingyun Duan and Da Xu},
keywords = {Climate change, Leaf area index, Variable infiltration capacity model, Direct and indirect effects, Yellow River Basin, Attribution analysis},
abstract = {Climate change fundamentally reshapes regional hydrology, with profound implications for water security and ecosystem sustainability. While the direct impacts of altered meteorological conditions on water resources are well-established, the indirect effects caused by climate-driven vegetation dynamics remain poorly understood and inadequately quantified. Focusing on the upper Yellow River Basin of China, this study performed scenario experiments using the Variable Infiltration Capacity (VIC) distributed hydrological model to investigate the effects of climate-induced changes in leaf area index (LAI) on the regional water resources during 1985–2018. Our results demonstrate that direct climate effects are dominant, with direct contributions exceeding 80% for all hydrological variables. Specifically, for regional water availability (precipitation minus evapotranspiration), the direct impact accounts for 93.3%, while the vegetation-mediated indirect effect contributes −6.7%. This reduction occurs as vegetation growth enhances evapotranspiration and partially counteracts climate-driven water increases. Moreover, these effects manifest with significant divergence across different hydrological components. Increased LAI strongly enhances canopy interception (+11.1%) but has a negligible indirect impact on vegetation transpiration, indicating that transpiration changes are primarily controlled by direct climate effects. Concurrently, climate-induced vegetation growth exerts negative contributions to water yield components, reducing surface runoff and baseflow by −2.7% and −9.4%, respectively. Spatially, these effects are most pronounced in the densely vegetated southeastern area of the basin. Our findings reveal a fundamental trade-off in semi-arid ecosystems where ecological greening, despite its environmental benefits, may compromise water resource availability under changing climate conditions.}
}
@article{WANG2026135551,
title = {From direct climatic forcing to permafrost-related restructuring: four decades of thermokarst lake dynamics in the northeastern Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {674},
pages = {135551},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135551},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006487},
author = {Bo Wang and Xiongdong Zhou and Zhiwei Li and Yao Yue and Shimin Tian},
keywords = {Thermokarst lake, Hydrological connectivity, Integral index of connectivity, Probability of connectivity, Climate warming},
abstract = {Thermokarst lakes are the most visible geomorphic manifestations of permafrost degradation and play a pivotal role in regulating hydrological processes on the Tibetan Plateau. Yet, their spatiotemporal evolution and the interplay between climatic forcing and permafrost-related processes remain poorly understood. Using multi-decadal Landsat imagery (1986–2022), this study quantified long-term variations in thermokarst lake area and hydrological connectivity—represented by the Integral Index of Connectivity (IIC), Probability of Connectivity (PC), and their importance metrics (dIIC and dPC)—across the source region of Yellow River. From 1986 to 2022, the thermokarst lake area fluctuated but increased overall, ranging from 230.71 km2 (1990) to a peak of 702.07 km2 (2012). Bayesian change-point analysis identified 1999, 2007, and 2014 as critical transition years, partitioning the trajectory into four phases: weak contraction (1986–1999), expansion (1999–2007), accelerated expansion (2007–2014), and fluctuation (2014–2022). Both IIC and PC rose and then declined, highlighting a nonlinear response to external forcing. Attribution analysis showed that direct climatic forcing served as the principal positive driver during 1986–2014 (> 83.7%), although the mechanisms differed between phases: early expansion was driven mainly by warming, whereas later expansion reflected synergistic climatic forcing of temperature, precipitation, and evaporation. After 2014, however, all three direct climatic factors exerted negative effects (–12.0% to –84.3%), while other drivers—particularly permafrost-related processes (> 151.7%)—dominated the shrinkage. These findings delineate a three-stage evolutionary framework: (i) warming-induced expansion, (ii) synergistic climatic reinforcement, and (iii) permafrost-related restructuring toward system re-balancing. This phase transition from direct climatic forcing to lagged ground-thermal feedback dominance provides new insights into threshold behavior and wetland resilience in permafrost-affected regions of the Tibetan Plateau.}
}
@article{EATESAM2026135260,
title = {Quantifying the attribution of ecohydrological degradation: a comparative deep learning approach in a changing environment},
journal = {Journal of Hydrology},
volume = {674},
pages = {135260},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135260},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003574},
author = {Ali Akbar Eatesam and Khosrow Hoseini and Hojat Karami},
keywords = {Hydrological attribution, Deep learning model, Anthropogenic interference, Shifting baseline syndrome, Ecohydrological health, Non-stationarity},
abstract = {Quantifying the attribution of ecohydrological degradation in intensively managed basins is a critical challenge for sustainable water management. This study disentangles the impacts of anthropogenic pressures versus climatic variability on the Haraz River basin, Iran, a system undergoing profound and rapid change. By employing a Gated Recurrent Unit (GRU) deep learning framework to reconstruct the pristine, pre-impact hydrological regime, we generated a robust counterfactual scenario for a 48-year period (1976-2024), enabling a dynamic, multi-decadal attribution analysis. The results revealed a distinct two-phase evolution of human impact. The initial phase (c. 1996–2016) was dominated by geomorphic disruption from mining activities, leading to a significant human-induced amplification of flood peaks. This was followed by a fundamental regime shift post-2016, characterized by anthropogenic flood suppression and severe baseflow depletion, a clear signature of dam regulation and large-scale water abstraction. Attribution analysis confirmed that these anthropogenic drivers were responsible for the majority of the alteration in key health metrics, including an 11% reduction in total water yield in the final decade. A Hurst exponent approaching 0.98 statistically validated the system’s transition from a natural stochastic state to a predictable, human-governed regime. These findings caution against the Shifting Baseline Syndrome (SBS), where flow regulation could be misinterpreted as system recovery. We conclude that data-driven counterfactual modeling is indispensable for establishing scientifically defensible restoration targets in non-stationary, human-dominated environments.}
}
@article{REN2026135470,
title = {Hydrochemical and isotopic tracers reveal mining-induced changes in river water quality and carbon flux in the karst catchment of Daiyang river},
journal = {Journal of Hydrology},
volume = {674},
pages = {135470},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135470},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005676},
author = {Yeye Ren and Xingxing Cao and Pan Wu and Quanzhou Gao and Changmei Yao and Guangxi Long and Weihua Tang and Deshuai Zhang and Haicheng Zhang},
keywords = {Karst river, Coal mining, Carbonate weathering, Stable isotope, Hydrochemistry, Dissolved inorganic carbon},
abstract = {Karst regions are critical to global carbon sequestration and freshwater supply. Although their carbon cycle and water resources have been extensively studied, the effects of anthropogenic disturbances, particularly coal mining, on river hydrochemistry and carbon fluxes remain poorly constrained. Here we investigate coal mining effects on hydrochemistry and dissolved inorganic carbon (DIC) fluxes of a typical karst river through integrated analysis of riverine hydrochemical and stable isotope (δ2H, δ18O and δ13CDIC) data. We hypothesize that mining activities can significantly affect river water quality and carbon flux by altering local chemical weathering in karst basins, and its effects exhibit distinct spatial and seasonal variability. Results demonstrate that groundwater constitutes the predominant source of river recharge during both low- (78.1 ± 31.1 %) and high-flow (54.6 ± 43.2 %) seasons. Mine water accounts for only 17.8 ± 30.7 % of total recharge in the low-flow season but surges to 39.7 ± 41.9 % in the high-flow season. As mine water is rich in SO42- and H+, it accelerates carbonate weathering and shifts river hydrochemistry from Ca2+–HCO3- to SO42- dominance. Carbonate weathering enhanced by mining-derived acids (H2SO4/HNO3) contributes 47.5 ± 18.4 % (low-flow) and 39.4 ± 20 % (high-flow) of riverine DIC fluxes, surpassing natural H2CO3-driven weathering. Compared with previous studies, this work advances the understanding of mining-induced disturbances on karst river hydrochemistry and carbon cycling across hydrological seasons. These findings provide new insights for the assessment and management of water and carbon resources in mining-impacted karst regions worldwide.}
}
@article{XIE2026135498,
title = {A Bayesian segmentation method for reservoir spread area extraction using synthetic aperture radar and water occurrence},
journal = {Journal of Hydrology},
volume = {674},
pages = {135498},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135498},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005950},
author = {Lei Xie and Wenbin Xu and Kun Jiang and Lei Zhao and Eslam Ali},
keywords = {Reservoir water spread, Bayesian segmentation, SAR, Water occurrence, Sentinel-1, Himalayan foothills},
abstract = {Accurate mapping of reservoir spread areas is essential for watershed management and sustainability. Synthetic Aperture Radar (SAR) provides cloud-penetrating capability, and enabling a better and more stable temporal resolution than optical systems. Nevertheless, existing SAR-based water extraction algorithms face critical limitations from time-varying backscatter modulations, e.g., wind, vegetation, soil moisture, topography. Here, we propose a new Bayesian segmentation method combining SAR and water occurrence data to explore reservoir dynamics under different weather conditions. Several false alarm cases, such as mountain shadows, breezes, moist soil, vegetation were corrected using probabilistic integration of complementary SAR and water occurrence. The proposed method was applied and validated at four large reservoirs in Lesser Himalayan foothills using more than 1000 acquisitions of Sentinel-1 data, optical imagery, in situ measurements, and comparisons of existing methods. The results showed a 3–10% improvement in segmentation accuracy and a 6–18% increased temporal density and uniform snapshots of inundation changes. We suggest that this weekly mapping of reservoir dynamics is complementary to in situ gauges for multiple applications, especially in areas with persistent clouds, such as the Amazon and Southeast Asia.}
}
@article{XUE2026135507,
title = {Effect of subsurface barrier on hydrological and stratigraphic alterations during engineering groundwater control},
journal = {Journal of Hydrology},
volume = {674},
pages = {135507},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135507},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006049},
author = {Xiu-Li Xue and Hao-Ying Lin and Chao-Feng Zeng and Gang Zheng and Zu-Hao Zhang and Lei Han and You-Wu Zhao},
keywords = {Dewatering, Barrier effect, Underground structure, Ground settlement, Drawdown},
abstract = {Dewatering in deep subsurface excavation induces substantial disturbances to the surrounding hydrogeological environment. In fact, as a barrier medium, underground structures in aquifers have a strong effect on groundwater and soil behavior (i.e., barrier effect), which would make the dewatering-induced responses of groundwater and soil completely different from that without adjacent subsurface barrier. However, this effect has not been sufficiently studied and its influence mechanism needs to be further investigated. A series of physical modeling experiments were conducted to quantitatively analyze the effect of subsurface barrier on hydrological and stratigraphic alterations during dewatering. On this basis, the mechanical mechanism underlying the barrier effect was further explained. Experimental results reveal that the presence of adjacent underground barrier would aggravate the dewatering-induced groundwater drawdown, while simultaneously reducing the flow rate inside the foundation pit. As the embedment depth of underground barrier increases, the drawdown would be amplified by 1.1∼1.52 times; the ground settlement would be limited by 0.35∼0.47 times. Based on this, evaluation equations for water level drawdown, water head drawdown, and ground settlement were proposed, which could provide reference for the optimization design of foundation pit under barrier effect.}
}
