@article{HAN2026135629,
title = {Interactive effects of vegetation and water regimes on evaporative fraction from two coastal wetland ecosystems},
journal = {Journal of Hydrology},
volume = {675},
pages = {135629},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135629},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007262},
author = {Qiong Han and Tiejun Wang and Qinling Bai and Cong-Qiang Liu},
keywords = {Evaporative fraction, Groundwater, Inundation, , , Coastal wetland},
abstract = {Understanding land surface energy partitioning is critical to predict water and energy processes; however, its regulation mechanism remains unclear in coastal wetlands with complex landscapes and alternating hydrological regimes. Here, daily evaporative fraction (EF) was contrasted for Phragmites australis and Suaeda salsa in a brackish coastal wetland from northern China with a focus on the roles of groundwater and standing water. Daily EF was observed to range from 0.008 to 0.93 (averaged at 0.23) and 0.009 to 0.58 (0.14) at the Phragmites australis and Suaeda salsa sites, respectively. Net radiation and air temperature were primarily correlated with EF at both sites, while the influences of other variables (e.g., depth to groundwater table-DTGT and canopy conductance) varied with growing stages and water regimes. Differences in the EF controlling factors between the sites were consistent with their contrasting rooting depths and soil moisture. In early growing seasons with drought, EF showed a negative relationship with DTGT below critical DTGT thresholds (∼0.95 m for Phragmites australis and ∼ 0.73 m for Suaeda salsa). The larger threshold for Phragmites australis was associated with its deeper root system and drier soils. In the mid-growing season with inundation, standing water depth positively influenced EF while EF became less responsive to DTGT after the inundation with reduced vegetation activities. Our study suggests interactive effects of vegetation and water regime on EF dynamics within this coastal wetland ecosystem, which may have important implications in the context of future climate change with more frequent extreme weather events.}
}
@article{CHEN2026135613,
title = {Threshold responses of diatom community to hydrological changes in an alpine peatland based on long-term (2014–2020) monitoring data},
journal = {Journal of Hydrology},
volume = {675},
pages = {135613},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135613},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007109},
author = {Xu Chen and Junlu Li and Jia Peng and Shuangyu Xu and Jun He and Shumin Qiao and Linghan Zeng and Xianyu Huang},
keywords = {Diatoms, Water table, Ecological guilds, Community thresholds, Dajiuhu Peatland},
abstract = {There is an increasing need to detect ecological thresholds for the establishment of numerical environmental criteria for ecosystem restoration. Peatlands have important implications for global carbon cycling and biodiversity conservation, while information on threshold responses of biotic communities to ecohydrological changes in peatlands is limited. Based on long-term (2014–2020) monitoring data, this study explored how diatom species and functional traits (i.e., life forms, cell sizes and ecological guilds) responded to ecohydrological changes in Dajiuhu Peatland, a Ramsar site in central China. Ordination analyses revealed that diatom species composition was significantly related to depth to the water table (DWT) and pH, while functional trait composition was significantly associated with DWT and electrical conductivity. Taxa indicator threshold analyses (TITAN) indicated that diatom species community changed substantially at DWT greater than 12 cm or at pH greater than 4.58, while functional trait community changed substantially at DWT greater than 12.5 cm or at conductivity greater than 17.80 μS cm−1. The ecological thresholds detected by diatom species and functional traits can serve as numerical environmental criteria for the restoration of this Ramsar site, as well as similar subtropical peatlands. The results highlight the benefit of using both diatom species and functional traits to improve our understanding of underlying ecological processes in peatland ecosystems.}
}
@article{YANG2026135596,
title = {Insights into hydrological compound dry-hot features using GNSS/GRACE-derived terrestrial water storage and land surface temperature},
journal = {Journal of Hydrology},
volume = {675},
pages = {135596},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135596},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006931},
author = {Xinghai Yang and Linguo Yuan and Miao Tang and Zhongshan Jiang},
keywords = {GNSS, GRACE, Hydrological drought, Heat events, Hydrological compound dry-hot events},
abstract = {Compound dry-hot events pose significantly greater threats to water security, ecological stability, and human society than individual extremes. Previous studies have primarily assessed such events by combining temperature with other meteorological variables, but these approaches fail to fully account for the compound effects of heat events and hydrological droughts induced by terrestrial water storage (TWS) deficits. Here, we define hydrological compound dry-hot events (HCDHEs) as concurrent hydrological droughts and heat extremes, and develop a novel framework for their assessment using Global Navigation Satellite System (GNSS) and Gravity Recovery and Climate Experiment (GRACE) observations and surface temperature. First, a joint inversion model of GNSS 3D deformation and GRACE observations (G3G-JI) is proposed to estimate TWS variations in the Amazon basin. Subsequently, the standardized temperature index (STI) and TWS-based drought severity index (DSI) are integrated to construct a standardized hydrological compound index (SHCI) to quantify the severity of HCDHEs. The results demonstrate that G3G-JI outperforms GNSS-only inversion and conventional 1D GNSS-GRACE joint inversion models, more accurately restoring the local TWS signals along the Amazon River. Comparisons of various indices show that SHCI effectively captures heat and hydrological drought characteristics, with correlation coefficients of 0.8 for both STI and DSI. Analyses of the Amazon sub-basins show that 7–15 HCDHEs occur during 2008–2022, with maximum durations of 16–30 months. Additionally, SHCI successfully captures the spatial evolution characteristics of HCDHEs and exhibits strong consistency with the meteorological standardized compound event index (SCEI). Our study introduces a geodesy-based novel framework to assess the compound characteristics of heat and hydrological droughts, expanding the application of GRACE and GNSS in assessing global and regional compound extreme events.}
}
@article{YIN2026135576,
title = {G2Lcast: A global-to-local adversarial network for high-fidelity precipitation nowcasting},
journal = {Journal of Hydrology},
volume = {675},
pages = {135576},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135576},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006736},
author = {Chuanhao Yin and Huawang Qin and Xiangming Zheng},
keywords = {Short-term precipitation forecasting, Generative adversarial networks, Hybrid neural architectures, Frequency-domain decoupled modeling},
abstract = {Nowcasting of precipitation is pivotal for socioeconomic activities and public safety; yet, achieving high-fidelity forecasts remains fundamentally challenged by the multi-scale spatiotemporal complexity of rainstorms. Existing deep-learning models struggle to reconcile local detail preservation with global dependency modeling and are plagued by a systematic blurry prediction bias: they consistently underestimate the intensity of convective extremes and yield overly smoothed fields. To address these deficiencies, we introduce G2Lcast, a non-autoregressive generative adversarial framework founded on a global-to-local hierarchical evolution principle. Specifically, we devise a wavelet-based information-preserving codec coupled with an energy bypass that injects low-frequency energy components directly into the latent temporal evolution, guaranteeing structural fidelity at every forecast step. The core G2Lmixer module disentangles global filters in the frequency domain, independently modulates amplitude and phase spectra, and synergizes with multi-scale spatial convolutions to approximate spatiotemporal dependencies in linear complexity. The entire predictor is trained adversarially: a discriminator enforces the generator to synthesize precipitation fields that are statistically and visually indistinguishable from observations, thereby mitigating the inherent blurriness. Extensive evaluations on two public benchmarks demonstrate G2Lcast’s superiority. On KNMI, it raises the mean CSI by 6.17% over the best prior art; on SEVIR, its skill in predicting extreme convection (CSI-219) surges by 35.88%. These results establish a new state-of-the-art for precipitation nowcasting and underscore G2Lcast’s broad potential for complex spatiotemporal forecasting tasks.}
}
@article{SEO2026135584,
title = {Role of river network information in streamflow prediction using graph wavenet and entity-aware long short-term memory models},
journal = {Journal of Hydrology},
volume = {675},
pages = {135584},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135584},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006815},
author = {Hocheol Seo and JongHyeok Lee and Suyeon Choi and Jaehee Kim and Yeonjoo Kim},
keywords = {Graph WaveNet, EA-LSTM, Streamflow prediction, River network},
abstract = {Floods in river basins can develop rapidly, causing significant damage and leaving little time for an effective response. Accurate short-lead-time streamflow forecasting is thus critical for mitigating the impact of floods, particularly in densely populated or flood-prone regions. This study aimed to understand the role of river network information in predicting the streamflow using Graph WaveNet (GWNET) and entity-aware long short-term memory (EA-LSTM) models, with spatial dependencies represented by four adjacency matrices based on Euclidean or hydrological distance with or without downstream directionality. One-hour-ahead streamflow predictions were conducted based on hourly precipitation, streamflow, and water level data from 20 stations in the Yeongsangang River and Seomjingang River basins, South Korea, from 2016 to 2023. While EA-LSTM had a higher accuracy for the upstream stations, GWNET was more effective for downstream predictions, with the average Nash–Sutcliffe efficiency increasing from 0.82 for EA-LSTM to 0.89 for GWNET and the average mean absolute error decreasing from 80.35 m3/s for EA-LSTM to 59.63 m3/s for GWNET. This enhanced accuracy was attributed to the ability of GWNET to capture the physical accumulation and propagation of upstream flows through its directional graph architecture. Incorporating downstream directionality improved the performance of GWNET further, suggesting that directional connectivity plays an important role in streamflow predictions. In areas where the hydrological-to-Euclidean distance ratio exceeded 1.3, the inclusion of hydrological distance in the adjacency matrix tended to produce more accurate predictions, likely because it offered a better representation of the actual river pathways. This study demonstrated the importance of incorporating the river network structure into data-driven models and provided insights into how the spatial configuration and directional connectivity influence streamflow forecasting, which can contribute to the development of more effective early-warning systems.}
}
@article{BAI2026135600,
title = {Impact of fractal dimensions of rainfall time series on mountain flood forecasting},
journal = {Journal of Hydrology},
volume = {675},
pages = {135600},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135600},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006979},
author = {Zhixu Bai and Fangqing Jiang and Ruonan Hao and Yue-Ping Xu and Jiayi Fang},
keywords = {Fractal dimension, Rainfall, Water level, Time series, Artificial neural networks (ANN)},
abstract = {Rainfall in mountainous watersheds is characterized by strong spatial and temporal heterogeneity, which poses a great challenge to flood forecasting. Time series of rainfall and water level, as reflections of natural processes, follow fractal theory with self-similarity in their fluctuations and variations. However, the impact of fractal properties in rainfall time series on minute-scale flood forecasting has been overlooked. In this study, the rainfall series from 17 rainfall gauges and one water level station within a 339-km2 watershed were used to reveal the fractal dimensions (D) of rainfall and water level series and the impact on flood forecasting. The results show that a fractal relationship existed between rainfall and water level across time scales, with 5.33 h as the division point between short-term and medium-term time scales. Within this scale, the model showed excellent forecasting performance. The fractal dimension of rainfall time series was significantly correlated with model forecasting accuracy, for both water level and peak time. When the spatial uniformity of rainfall gauges exceeded a threshold, further improving uniformity could not enhance the fractal dimension of the rainfall time series. This study confirmed that combining rainfall fractal dimension with rainfall gauge evaluation indicators could support mountainous rainfall gauge network planning and flood prediction.}
}
@article{LUO2026135645,
title = {The processes and impacts of drought-induced extreme glacier mass loss on the south‐central Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {675},
pages = {135645},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135645},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007420},
author = {Derui Luo and Daijiao Lin and Yichan Xu and Meilin Zhu and Fei Zhu and Huabiao Zhao and Yang Xiang},
keywords = {Tibetan plateau, Extreme glacier mass loss, Energy and mass balance, Atmospheric circulation, Sea surface temperature},
abstract = {The growing threat of reduced glacier mass to social needs and ecosystem stability is widely recognized. Extreme climate events, such as droughts or exceptionally high air temperatures, would substantially intensify glacier mass loss rate on the Tibetan Plateau (TP). However, the relationship between drought and extreme glacier mass loss on the TP, along with their impacts on lake water budgets, remains poorly understood. In this study, we analyzed the reconstructed mass balances for 853 glaciers from 1960 to 2019 in the western Nyainqentanglha Mountains on the south-central TP using glacio-meteorological observations and energy-mass balance model and found that the ablation season (June–September) drought was accompanied by extremely low precipitation and cloud cover, exceptionally high incoming shortwave radiation and relatively high air temperature, which led to extreme mass loss through decreasing albedo and snowfall, and increasing melting. Drought in the ablation season on the south-central TP may be linked to the anomalous anticyclonic circulation on the south TP and anomalous northerly flows from the south TP to the northeastern Indian subcontinent, which reduced the advection of water vapor flowing into the south-central TP from the Indian Ocean, and increased the descending motions and insolation on the south-central TP. Furthermore, the above regional atmospheric circulation anomalies were driven by a strong positive Indian Ocean dipole, a strong El Niño, a weak Indian summer monsoon, and low sea surface temperatures in the northeastern Atlantic Ocean. Moreover, in extreme mass loss years, glacier mass loss contributions to Nam Co’s summer volume increase were 1.6–4.6 times greater than in normal years. This work elucidates the physical processes underlying drought­induced extreme glacier mass loss and quantifies its critical role in driving lake level variations on the TP.}
}
@article{FITZGERALD2026135617,
title = {An L-moments-based hypothesis test to identify homogeneous storm transposition regions},
journal = {Journal of Hydrology},
volume = {675},
pages = {135617},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135617},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007146},
author = {Benjamin FitzGerald and Daniel Wright and Lei Yan and Alyssa Hendricks Dietrich and Antonia Sebastian},
keywords = {Stochastic storm transposition, Precipitation, Extreme storms, Probable maximum precipitation, Homogeneity},
abstract = {Deterministic storm transposition has been a longstanding component of probable maximum precipitation estimation, while stochastic storm transposition (SST) is gaining interest as a probabilistic flood hazard methodology. One example is within the Federal Emergency Management Agency’s (FEMA) National Flood Insurance Program (NFIP) to modernize methodologies for estimating flood hazard and risk throughout the United States using SST. A key challenge in the widespread and systematic application of SST is objectively delineating transposition domains, geographic regions over which rainfall is roughly homogeneous and can be transposed to accurately represent a watershed’s extreme precipitation frequency and intensity characteristics. This study introduces the spatial L-moments of annual maxima (SLAM) procedure, a novel hypothesis testing approach for defining transposition domains. SLAM assesses the similarity of L-moment statistics (L-mean, L-Coefficient of variation, L-skewness, and L-kurtosis) between a watershed’s mean annual rainfall maxima and those at transposition locations within a proposed domain. SLAM generates statistically backed homogeneous domains around each of the pilot watersheds. We found that SST-based rainfall frequency estimates using these “SLAM domains” align closely with empirical precipitation return periods for three of the four pilot watersheds, and that the domains are large enough to support the estimation of long return period rainfall. The sole exception is an NFIP pilot watershed that exhibits substantial precipitation variability due to orography. In that case, SLAM results can be interpreted as evidence that SST procedures must be adapted to be used effectively there. These results highlight the potential of SLAM to improve SST-based extreme rainfall and flood hazard assessment and to support FEMA.}
}
@article{RAN2026135609,
title = {Improving extreme runoff simulation with spatially optimized Fengyun satellite precipitation},
journal = {Journal of Hydrology},
volume = {675},
pages = {135609},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135609},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007067},
author = {Yuehua Ran and Kunlong He and Xiaohong Chen and Haojie Li},
keywords = {Extreme Runoff, Satellite Precipitation, Sub-basin precipitation extraction, XGBoost, Extreme runoff driver},
abstract = {To tackle the challenge of extreme runoff simulation in data-limited hydrological regions, this study introduces a novel approach to enhance runoff simulation accuracy in the typical humid basin in China by integrating the Soil and Water Assessment Tool (SWAT) sub-basin delineation into the XGBoost model. We optimized sub-basin precipitation extraction and basin-scale aggregation methods to improve accuracy of extreme runoff simulation. The Fengyun Quantitative Precipitation Estimation (FY QPE) was validated for its potential in hydrological modeling, and SHAP analysis was employed to quantify the contributions of driving factors, revealing the underlying mechanisms of hydrological elements. Representative precipitation sequences were extracted using mean values (FYm) and hybrid maximum-mean strategies (FYmm70, FYmm75, FYmm80, FYmm85, FYmm90, FYmm95) tailored to extreme runoff thresholds. Five aggregation methods—Mean, Area-weighted (A), Distance-to-Center (D2C), Distance-to-Outlet (D2O), and Cluster—were explored to derive basin-scale precipitation inputs, bridging distributed and lumped modeling for enhanced stability and interpretability. Results show FY QPE correlates highly with in-situ data (CC > 0.87, NSE > 0.74), despite underestimating extremes. XGBoost outperforms SWAT with an 10% NSE improvement and reduced PBIAS. FYmm80 and FYmm85 excel in extreme high runoff simulation (PBIAS improvement >20%), while D2C and D2O aggregation methods yield the best overall performance (NSE 0.80–0.82, KGE 0.81–0.86). Cumulative precipitation (7-day and 15-day) as the dominant driver, with seasonal variations influenced by humidity and sunshine duration. This framework advances satellite-driven hydrological modeling by improving precipitation spatial representativeness, reducing biases in extremes, and enhancing model explainability.}
}
@article{HUANG2026135649,
title = {Machine learning Identifies the impacts of the Eastern route of the South-to-North water diversion Project on the transformation of dissolved organic matter},
journal = {Journal of Hydrology},
volume = {675},
pages = {135649},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135649},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007468},
author = {Na Huang and Penghui Li and Yilan Jiang and Lin Chen and Dawei Wang},
keywords = {Eastern route ofthesouth-to-north water diversion project, Dissolved organic matter, Spatial response, Machine learning, Potential driving factors},
abstract = {The spatial heterogeneity of dissolved organic matter (DOM) is synergistically modulated by hydrodynamic and aquatic chemical factors. Although several studies have suggested the DOM transformation in the influence of water diversion projects (WDPs), their real connections remain unclear. In this work, we studied the relationship between DOM transformations in recipient lakes and WDPs for the Eastern Route of the South-to-North Water Diversion Projects (ER-SNWDPs) by integrating spectral techniques, global spatial autocorrelation analysis, and machine learning analysis. The results demonstrated that DOM characteristics in recipient lakes showed spatial heterogeneity during the non-water diversion period (NWDP), whereas WDPs transformed the characteristics of DOM into a homogeneous state. A linear fitting analysis revealed that during the water diversion period (WDP), only total fluorescence intensity was dependent on water conveyance distance, while aromaticity Index, fluorescence index, and humification index, which were originally dependent on geographic characteristics, turned to be independent because of WDPs. The 3-layer Deep Neural Network model coupled with Shapley Additive Explanations analysis identified WDPs operations, conveyance distance, and nitrogen concentration as the primary drivers of DOM homogenization. Hierarchical partitioning revealed that total nitrogen replaced geographical factors as the primary contributor (15.5%) for DOM transformation during the WDP, confirming that the nitrogen variability induced by WDPs was the key factor reducing DOM spatial heterogeneity. Our study revealed the impacts of WDPs on the spatial heterogeneity of DOM in recipient lakes, providing valuable insights for the ecological risk assessment and water quality management of ER-SNWDPs.}
}
@article{YANG2026135580,
title = {Irrigation enhanced nitrification and hydrological partitioning drive groundwater nitrate accumulation in an agricultural irrigation district},
journal = {Journal of Hydrology},
volume = {675},
pages = {135580},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135580},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006773},
author = {Xu Yang and Ruihong Yu and Guanglei Yu and Yansong Bai and Shen Qu and Dong Qian and Muhan Li and Zeyuan Liu and Ping Miao and Hongli Ma},
keywords = {Hydrological partitioning, Irrigation agriculture, Nitrate contamination, Nitrification},
abstract = {Nitrate (NO3−) contamination in irrigation dominated agricultural regions poses a persistent threat to groundwater quality, yet the distribution patterns and underlying mechanisms of NO3− among hydrologically connected water bodies in irrigation districts remain poorly understood. Here, we investigated a large Yellow River irrigation district using multi-season field sampling combined with nitrate dual isotopes (δ15N–NO3−, δ18O–NO3−), water stable isotopes (δ2H–δ18O), 222Rn tracers, dissolved organic matter fluorescence, Bayesian isotope mixing models, and soil microbial functional gene analyses. Across all seasons, NO3− was the dominant inorganic nitrogen species, with shallow groundwater exhibiting persistent enrichment, which were 3.1–4.8 times higher than those in canals, drainage and Yellow River water. Isotopic evidence and source apportionment revealed manure and sewage as the dominant anthropogenic nitrogen sources, while δ18O–NO3− signatures and increased (AOA + AOB)/(nirS + nirK) ratios demonstrated that irrigation significantly enhanced soil nitrification. Concurrent enrichment of groundwater δ2H–δ18O and elevated 222Rn activities indicated intensified shallow recharge during irrigation, promoting downward NO3− transfer into the aquifer. In contrast, drainage exhibited low NO3− concentrations (1.74 ± 0.90 mg L−1) due to strong dilution and short residence times, despite receiving substantial anthropogenic nitrogen inputs (manure and sewage contributed 65.7%). These results demonstrate that irrigation enhanced nitrification and hydrological partitioning jointly control NO3− fate. Our findings identify shallow aquifers as long term NO3− reservoirs in irrigation system and underscore the need to incorporate groundwater retention processes into NO3− risk assessment and management.}
}
@article{BOENINGULMAN2026135633,
title = {Observation of urban karst flows inform planning, design and construction of green stormwater infrastructure},
journal = {Journal of Hydrology},
volume = {675},
pages = {135633},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135633},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007304},
author = {Kathryn M. Boening-Ulman and R. Andrew Tirpak and Jay F. Martin and Alessandra S. Braswell and William F. Hunt and Ryan J. Winston},
keywords = {Stormwater control measures, Subsurface flow, Utilities, Groundwater, Urban planning, Infiltration},
abstract = {Rapid increases in population worldwide have led to an expansion of areas characterized by highly connected impervious surfaces. Located beneath these surfaces are intertwined layers of infrastructure, such as pipes, gravel-filled trenches, and wires, transporting utilities and water. Engineers have increasingly adopted infiltrating stormwater control measures (SCMs) to more closely mimic pre-development hydrology and mitigate the detrimental effects of impervious cover on receiving waters. When constructing SCMs, there is the potential for stormwater to unintentionally discharge via alternate pathways along subsurface infrastructure, particularly when retrofitting into existing urban developments which requires disturbing the subgrade and potentially relocating utilities. Interactions between infiltrated stormwater and this complex system of subsurface infrastructure, or the ‘urban karst’ phenomena, are an anthropogenic corollary to the natural tunnels and underground channels that can be found in geologies with highly soluble rock such as limestone. Relatively few studies have explored the impacts of urban karst pathways on the performance of infiltrating SCMs. This study explored three SCMs with known urban karst interactions in Ohio and North Carolina (USA) to better understand the potential impacts of urban karst SCMs. Alternate drainage pathways were confirmed using methods such as long-term monitoring, sewer inspection cameras, and dye tracer studies. Recommendations for design techniques, such as impenetrable liners in SCM installations, that could be implemented to minimize the urban karst effect are also explored. Given potential unintended consequences of urban karst and the prevalence of underground infrastructure worldwide, engineers are encouraged to consider these techniques in all SCM designs.}
}
@article{JEELANI2026135447,
title = {Nutrient cycling, biogeochemical pathways and eutrophication status of an urban Himalayan lake system},
journal = {Journal of Hydrology},
volume = {675},
pages = {135447},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135447},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005445},
author = {Gh Jeelani and Suhail A. Lone and M. {Saleem Dar} and Javid A. Ganai and Niharika Sharma and Sanjeev Kumar},
keywords = {Dal lake, Eutrophication, Himalaya, Isotope, Nutrient, Sewage},
abstract = {Urban freshwater lakes in high-altitude Himalaya are increasingly threatened by eutrophication due to accelerated nutrient loading from anthropogenic and climatic pressures. This study presents an integrated assessment of nutrient sources, transformation pathways, and eutrophication processes in Dal Lake, Western Himalaya, using a novel combination of seasonal profiling of nutrients (NO3–, NH4+, TP, TN, POM), stable isotope biogeochemistry (δ13C and δ15N), Self-Organizing Maps (SOM), hydrodynamic-nutrient transport modeling, and Bayesian source apportionment (MixSIAR). Seasonal monitoring of NO3–, NH4+, TN, TP and POM revealed significant spatio-temporal heterogeneity, with elevated nutrient concentration during winter and spring associated with reduced biological uptake and intensified internal loading. δ15N and δ13C values provided diagnostic signatures of nutrient processing, showing higher δ15N in summer-autumn due to microbial nitrification–denitrification and lower δ13C values during peak algal productivity. SOM clustering revealed distinct nutrient regimes shaped by external inputs (e.g., sewage, agricultural runoff) and internal biogeochemical processes (e.g., remineralization, microbial transformation). The MixSIAR model identified sewage (41.2%) and algal biomass (33.4%) as dominant contributors to POM in summer, with seasonal transition to agricultural and terrestrial sources. Hydrodynamic nutrient simulations indicated rapid NH4+ depletion, delayed NO3– accumulation, and persistent TP concentration, emphasizing redox-sensitive nitrogen removal and sediment-driven phosphorus retention. Trophic state classification using Carlson’s Trophic State Index (TSI) placed most lake segments within eutrophic to hypereutrophic categories, corroborated by low Secchi disk depths and high TP levels, particularly near inflow and floating gardens. The results underscore a complex interplay of external nutrient inputs, internal biogeochemical cycling, and lake hydrodynamics in driving eutrophication. These insights provide a system-level understanding of nutrient fate in urban Himalayan lakes and support the development of targeted, climate-resilient restoration strategies.}
}
@article{SUN2026135560,
title = {Characterizing the distribution and flow dynamics of shallow karst fissure-type groundwater in urban environments using multi-geophysical time-lapse monitoring combined with saline tracer tests},
journal = {Journal of Hydrology},
volume = {675},
pages = {135560},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135560},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006578},
author = {Hao Sun and Tao Hu and Fangyuan Dai and Jingxin Wu and Xiujun Guo and Shixin Yan and Xiao Shi and Tianyuan Zheng},
keywords = {Shallow karst groundwater, Epikarst, Time-lapse geophysics, Hydraulic connectivity, Preferential flow, Fissured karst},
abstract = {Approximately 1.18 billion people inhabit karst regions globally. Rapid urbanization exacerbates the mutual feedback and conflicts between underground infrastructure and shallow karst groundwater. Characterizing its distribution and flow dynamics is a prerequisite for understanding these interactions and implementing effective hazard mitigation. However, delineating the hydrodynamics of shallow fissure-type karst systems typical of northern China is highly challenging due to the absence of large connected conduits, complex infillings, profound heterogeneity, and restricted urban exploration space. To address this, we propose an integrated methodology combining saline-enhanced time-lapse Borehole-Surface Electrical Resistivity Tomography (BSERT), Self-Potential (SP), the Mise-à-la-Masse (MALM) method, geological drilling, and tracer tests, validated in Jinan, China. At the local scale, this method effectively characterizes the spatial distribution and hydraulic connectivity of shallow karst aquifers, capturing the non-linear opening and closing dynamics of karst channels driven by local hydraulic pressure. At the regional scale, it qualitatively identifies the preferential flow directions of the shallow runoff zone. Based on these findings, we established a classification system of eight typical occurrence patterns, clarifying the spatiotemporal allocation mechanisms of Recharge-Storage-Flow (R-S-F). This work provides a theoretical reference for conceptualizing and numerically modeling complex karst systems, offering crucial technical support for formulating differentiated strategies for engineering hazard prevention and groundwater protection in restricted urban environments.}
}
@article{WANG2026135641,
title = {From sources to risks: A multi-method approach to groundwater hydrogeochemical evolution in the Hotan Oasis of arid inland river basin, Northwest China},
journal = {Journal of Hydrology},
volume = {675},
pages = {135641},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135641},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007389},
author = {Yuehui Wang and Ziyue Yin and Xiaomin Sun and Erkang Zheng and Jieyu Pan and Jianfeng Wu and Jichun Wu},
keywords = {Source–process–risk framework, Multi-method combination, Hydrogeochemical process, Seasonal dynamics, Fluoride and nitrate risk},
abstract = {Pronounced hydrological seasonality and highly dynamic groundwater systems create complex and spatially heterogeneous hydrogeochemical conditions in arid inland river basins. This complexity hampers reliable source–process identification and complicates effective groundwater management. To address these challenges, an integrated multi-method approach was applied, combining self-organizing map (SOM), positive matrix factorization (PMF), hydrochemical diagrams, isotope tracing, and health risk assessment. In the Hotan Oasis, this approach systematically characterized groundwater hydrochemistry and quantified its controlling mechanisms. Groundwater samples were classified into three clusters (C1, C2, C3), representing different hydrochemical patterns. PMF identified six driving factors (F1–F6) with contributions of 46.90%, 20.79%, 9.10%, 8.86%, 7.36%, and 6.99%, indicating that the groundwater composition was jointly controlled by natural hydrogeochemical processes and anthropogenic inputs. Seasonal differences were pronounced: wet-season recharge enhanced dilution and mineral leaching, whereas dry-season conditions intensified evaporation-driven solute enrichment. Agricultural pollution persisted as a background anthropogenic signal. Health risk assessment indicated fluoride (F−) as the primary non-carcinogenic hazard, especially for infants and children, while localized nitrate enrichment also required attention. This study establishes an integrated source–process–risk framework for groundwater evolution in data-limited, process-complex arid inland river basins. The findings provide mechanistic insights and support adaptive water management in fragile oases and other groundwater-dependent dryland environments.}
}
@article{WANG2026135588,
title = {Quantitative attribution of seasonal runoff variations in the Yellow River Basin under unsteady conditions using a modified Budyko framework},
journal = {Journal of Hydrology},
volume = {675},
pages = {135588},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135588},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006852},
author = {Junjie Wang and Yuning Chi and Shaoxiong Zhang and Bing Shi and Liting Zhang and Chenjun Du and Xin Li and Baoqi Li and Liqin Yang and Lei Huang and Dian Yuan and Kaiyang Qiu and Panxing He},
keywords = {Runoff, Attribution analysis, Budyko framework, CNN-LSTM-Attention, Yellow River Basin},
abstract = {The changes in climate and watershed properties are reshaping hydrological processes worldwide at multiple scales, leading to a transition from steady to non-stationary states. The traditional Budyko framework commonly relies on a steady-state assumption and neglects terrestrial water storage changes, thereby exhibiting notable limitations at finer temporal scales. Hence, a novel runoff elasticity attribution model was developed by integrating a modified Budyko framework (incorporating parameter λ for watershed properties and y0 for the net effect of terrestrial water storage dynamics), Random Forest, and a CNN-LSTM-Attention neural network. Then, the spatial differences in seasonal runoff variations were revealed by the proposed runoff elasticity attribution model in the Yellow River Basin during 1960–2020. The results show that the CNN-LSTM-Attention model can effectively interpret the parameters λ and y0, with determination coefficients (R2) exceeding 0.9 between simulated and calibrated values. Precipitation and terrestrial water storage exert positive controlling effects on runoff, whereas potential evapotranspiration and underlying surface changes suppress runoff generation. In the source region of the Yellow River Basin, climatic factors (precipitation and potential evapotranspiration) contribute 33.9% to the overall runoff variation. The influence of underlying surface changes on runoff gradually increases along the downstream direction, accounting for 68.6%, 80.0%, and 87.6% of the variation in the upper, middle, and lower reaches, respectively. Seasonal runoff in arid regions shows greater sensitivity to the net effect of terrestrial water storage dynamics, accounting for 9.0% of the runoff variation in the upper Yellow River. A new methodological framework is provided in this study for diagnostic attribution and adaptive management of watershed water resources under evolving environmental conditions.}
}
@article{WU2026135625,
title = {An explainable physics-aware deep learning framework with improved spatiotemporal dependence matrices and signal decomposition for multi-station uncertainty daily runoff simulation},
journal = {Journal of Hydrology},
volume = {675},
pages = {135625},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135625},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007225},
author = {Weiran Wu and Yan Kang and Haoyue Zhang and Libin Lin and Xinyu Zhao and Lingjie Li and Songbai Song},
keywords = {Daily runoff simulation, Spatio-temporal deep learning, Signal decomposition, Iterative gradient integrated gradients, Adaptive bandwidth kernel density estimation, Wei River Basin},
abstract = {High-accuracy and high-timeliness efficient daily runoff simulation with strong explainability is essential for fine water resources management. However, existing single-station runoff simulation models struggle to meet basin-wide simultaneous scheduling and risk management demands due to insufficient consideration of non-stationarity, spatiotemporal dependencies, and multi-station interactions. In this paper, we propose a novel GVMD-PA-STGMD framework that integrates Variational Mode Decomposition with Grey Wolf Optimizer (GVMD), physics-aware methods (PA), and Spatiotemporal TCN-GNN-MHSA Deep-learning (STGMD) to improve multi-station daily runoff simulation in semi-arid areas. The STGMD model was developed by coupling Temporal Convolutional Network (TCN), Multi-Head Self-Attention (MHSA) and four Graph Neural Networks (GNNs) to capture spatiotemporal features of multi-station runoff. In particular, the multi-station Spatio-Temporal dependence matrices were innovatively proposed for explicitly characterizing spatial interactions and nonlinear temporal dependencies across hydrological stations, thereby improving the capability of GNNs. Meanwhile, two proposed physics-aware methods—multidimensional node characteristic and node decomposition methods were introduced to STGMD for extracting meteorological influences and reservoir regulation effects on runoff processes. Furthermore, we adopted GVMD into PA-STGMD models to decompose the multi-station nonstationary daily runoff into multiple relatively stationary sub-series for enhancing the stability of input data. Finally, the iterative gradient path integrated gradients (IG2) algorithm was employed for model explainability, while Adaptive Bandwidth Kernel Density Estimation (ABKDE) was used to provide the probabilistic interval simulation. Here, the proposed framework was validated by simulating multi-station daily runoff of Wei River, China. Results show that GVMD-PA-STGMD framework achieves the best performance, and GVMD-PA-STGMD3 in the framework show distinct improvements when compared to STGMD model in terms of both NSE (36.8%) and RMSE (48.7%), and improved NSE by 19.4% and RMSE by 42.3% over the PA-STGMD models. Additionally, compared with single-station models, the proposed framework not only achieves higher simulation accuracy but also maintains superior computational efficiency, improving simulation timeliness by 38.2%. Analyses from IG2 and ABKDE further confirm its strong explainability and low uncertainty. The study demonstrates that the proposed GVMD-PA-STGMD framework with a “multi-station Spatio-Temporal dependence matrices”–“physical awareness”–“non-stationary series decomposition”–“explainability analysis” modeling process is a promising approach, which enables accurate and computationally efficient non­stationary uncertainty daily runoff simulation with strong explainability and low uncertainty.}
}
@article{PHILIPPUS2026135620,
title = {Daily stream water temperature modeling and forecasting for ungaged watersheds at the CONUS scale},
journal = {Journal of Hydrology},
volume = {675},
pages = {135620},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135620},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007171},
author = {Daniel Philippus and Claudia R. Corona and Terri S. Hogue},
keywords = {Stream temperature, River temperature, Water temperature, Statistical model, Forecasting, Ungaged modeling, Contiguous United States},
abstract = {Stream water temperature (SWT) affects both societal and ecosystem functions, with impacts ranging from dissolved oxygen to algal blooms to lotic species mortality. The role of SWT in water chemistry and ecology has motivated rapid development in SWT modeling. Large-domain models support evaluation of current and future SWT conditions and impacts of disturbances or restorations across varied spatiotemporal scales, particularly for ungaged watersheds (no SWT observations). In the last decade, daily/kilometer-resolution, ungaged SWT models have been developed for the contiguous United States (CONUS), but do not support forecasting. Existing SWT forecasting models are constrained by lower spatial/temporal resolution or are applicable to smaller domains. Thus, there is a need for higher-resolution, large-domain forecasting to investigate future thermal conditions at scale. We present the first CONUS-scale, kilometer-resolution, forecasting-capable, daily, ungaged SWT model: “temperature estimation: near-term expected temperatures” (TempEst-NEXT). TempEst-NEXT can account for changing surface conditions (e.g., urbanization) and climate and is demonstrated for historical prediction and 1–16 day forecasting. TempEst-NEXT is also compatible with NOAA’s NextGen National Water Model framework. Forecast-forced historical tests (two-day lead) for mean daily SWT show a median RMSE of 2.3 ∘C (2.1 ∘C with estimated weather inputs), R2 of 0.92, and bias of 2.0% for ungaged watersheds, with similar performance in real-time forecasts (1–16 day lead). Unlike comparable SWT models, TempEst-NEXT forecasts do not require local calibration, supporting real-time decision-making for water-resource management, such as reservoir releases, where long-term observations are unavailable. Broadly, TempEst-NEXT enables efficient, flexible, large-scale prediction of stream thermal regimes.}
}
@article{BU2026135612,
title = {Integrating an improved SWAT model and geochemical constraints to assess climate change impacts on hydrological processes and extremes in mixed karst and non-karst basin},
journal = {Journal of Hydrology},
volume = {675},
pages = {135612},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135612},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007092},
author = {Chujie Bu and Jie Niu and Haiyang Hao and XingXing Cao and Pan Wu},
keywords = {Karst systems, Modified soil and water assessment tool (SWAT), Shared socio-economic pathways (SSPs), Hydroclimatic extremes},
abstract = {Climate change poses significant challenges to hydrological processes, particularly in mixed karst and non-karst basin. This study develops a SWAT-Duliujiang model to simulate hydrological processes in the Duliujiang River Basin, integrating a three-reservoir module for karst subbasins and geochemical constraints. The three-reservoir structure better represents karst aquifer dynamics, while model calibration divided subbasins into four groups based on geological background, with outputs constrained by regional geochemical signatures to ensure realistic simulations. Driven by bias-corrected 6th International Coupled Model Comparison Program (CMIP6) multi-model ensemble data under four Shared Socio-economic Pathways (SSP) scenarios (SSP1-2.6, SSP2-4.5, SSP3-7.0, and SSP5-8.5), the study projects hydrological responses across near-term (2015–2040), mid-term (2041–2070), and long-term (2071–2100) periods. The results show that the SWAT-Dliujiang model significantly improves the accuracy of hydrological simulations, and the incorporation of geochemical constraints effectively avoids outputs that are inconsistent with actual conditions. Across all scenarios, both streamflow and sediment yield increase significantly, with sediment yield exhibiting more pronounced spatial heterogeneity than streamflow. Compared with the historical period (2010–2017), the most pronounced changes in hydrological processes occur in the downstream region during the wet season under the long-term SSP5–8.5 scenario. Specifically, under this scenario, the long-term annual streamflow is projected to reach 43.76 m3/s, and the annual sediment yield is projected to reach 1579.35 × 103tons/month, which are 1.09 and 7.8 times the historical period values, respectively. Future annual maximum monthly streamflow (AMMS) is expected rise by 13%–57% in the long-term relative to the near-term. Random Forest analysis reveals distinct driving mechanisms: AMMS in karst regions are primarily controlled by wet season precipitation and groundwater, whereas non-karst regions are dominated by wet season precipitation. This study underscores the necessity of integrating geochemical constraints into hydrological process simulations in complex geological settings and highlights the importance of adopting region-specific adaptive strategies for water resources management and hydroclimatic extremes mitigation under climate change.}
}
@article{MIKHALEIKO2026135539,
title = {From puddles to lakes: hydrological and colloidal controls on element transport in peatland surface waters},
journal = {Journal of Hydrology},
volume = {675},
pages = {135539},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135539},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006360},
author = {Bogdan A. Mikhaleiko and Sergey N. Vorobyev and Danil G. Kurashev and Yuri Y. Kolesnichenko and Artem G. Lim and Rinat M. Manasypov and Larisa G. Kolesnichenko and Sergey N. Kirpotin and Oleg S. Pokrovsky},
keywords = {Wetland, Lake, Major, Trace element, Groundwater, Peat},
abstract = {Despite extensive knowledge of Siberian lake biogeochemistry during the open-water period, seasonal dynamics of small peatland water bodies remain poorly constrained. We investigated organic and inorganic nutrients and major and trace solutes, including ∼ 40 trace elements in peatland pools of the Great Vasyugan Mire (western Siberia), the world’s largest mire, across a size gradient from ephemeral spring puddles to permanent lakes > 1 km2 and through four hydrological seasons: post-ice-off spring, late summer, pre-ice autumn, and winter under ice. We hypothesized that small, hydrologically isolated pools would be dominated by organic-matter inputs and trace-element enrichment, whereas larger lakes would show stronger groundwater influence. Consistent with this framework, organic nutrients, and lithogenic trace elements increased with decreasing pool size, while larger lakes exhibited lower DOC aromaticity, higher pH, and elevated concentrations of labile inorganic solutes, including anions and alkali and alkaline-earth metals. Across seasons, concentrations of most dissolved constituents increased by a factor of 1.3–2.0 from spring to winter, indicating progressive winter accumulation and selective ice-induced fractionation. The smallest (<100 m2) pools showed peak spring DOC and associated Zn, Mn, and Cr concentrations, reflecting leaching from flooded mosses and vascular plants together with snowmelt inputs of atmospherically deposited elements. During spring and summer, 50–80% of dissolved alkali and alkaline-earth metals occurred in colloidal form (1 kDa–0.45 µm). Overall, peatland pool hydrochemistry reflects the combined influence of surface biomass leaching, peat-derived subsurface inflow, groundwater inputs, and atmospheric deposition; climate-driven increases in thaw season length and hydrological connectivity may enhance solute mobilization and transfer to downstream waters.}
}
@article{HUANG2026135628,
title = {Divergent pattern and trends of water color in global river mouths revealed by decadal Landsat observations},
journal = {Journal of Hydrology},
volume = {675},
pages = {135628},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135628},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007250},
author = {Liuhong Huang and Xiaomei Fan and Lin Huang and Shichang Gao and Chunqiao Song},
keywords = {Forel-Ule Index, River mouth, Water quality, Water color, Landsat-8, Remote sensing},
abstract = {River mouths serve as critical interfaces linking terrestrial and marine systems, where water color integrates signals of watershed processes, human activities, and hydrodynamic conditions. However, the complex interplay of river discharge and optical constituents necessitates effective remote sensing monitoring. The Forel-Ule Index (FUI), a 21-scale colorimetric classification, offers effective robust indicator of water quality. This study quantifies the spatial patterns, decadal trends, and seasonal variability of water color across 3,209 global river mouths using Landsat-8 imagery from 2013 to 2024. The results show that global river mouths exhibited a mean FUI of 17.76 ± 2.65, with substantial spatial heterogeneity. High FUI values were predominantly observed in, densely populated low-latitude regions (e.g., Southeast Asia, western Central America), while lower values were observed in Arctic coastal regions and the mid-latitude areas of the Northern Hemisphere. Small river mouths generally showed higher FUI than large ones due to limited dilution capacity, with regional exceptions in the Southeast Asia, Amazon, West Africa and West North America. Over the past decade, global FUI displayed a slight overall increase, with rising trends prevailing in the Arctic and low-latitude Southern Hemisphere, contrasting with declines in mid-latitudes. Seasonally, FUI peaked in summer and reached a minimum in winter. Notably, nearly 30% of river mouths exhibited negative trends across seasons, particularly in summer and winter, whereas persistent increases were mainly concentrated in eastern Australia. This study provides a global assessment of river-mouth water color dynamics, revealing the distinct scale effects and regional disparities in river mouth water quality. It is expected to offer critical scientific evidence for understanding land–ocean interactions under the dual drivers of climate change and anthropogenic perturbations.}
}
@article{HAO2026135594,
title = {Quantifying hydrological acceleration: A process-based framework and its application in arid regions},
journal = {Journal of Hydrology},
volume = {675},
pages = {135594},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135594},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006918},
author = {Xingming Hao and Jingjing Zhang and Mengtao Ci and Fan Sun and Qixiang Liang and Jinfan Xu and Xue Fan},
keywords = {Hydrological acceleration, Rate of Hydrological Change (), Climate change, Glacier mass loss, Inland river basins},
abstract = {Global warming is accelerating the global hydrological cycle, yet current assessments remain constrained by static water-balance methods that overlook dynamic flux rates and yield fragmented insights. To address this gap, we propose a novel rate of hydrological change (RHC) index that systematically quantifies hydrological acceleration in arid inland river basins of Northwest China. By integrating multi-source observations, models, and reanalysis data, our method provides a unified perspective on the coupled atmosphere-to-runoff system, including water-phase changes. Results demonstrated a consistent acceleration of the regional water cycle. Process-based variables, including glacial mass loss (+58.36%) and evapotranspiration (+26.83%), exhibited more pronounced increases than state variables, reflecting a stronger response of phase-change processes within the accelerated hydrological cycle. The spatially weighted hydrological change rates reached 22.58% based on state variables (RHCs) and 25.61% based on process metrics (RHCp), with clear spatial gradients observed across mountain systems. Glacial melt and precipitation‐to‐runoff conversion were identified as the primary drivers of acceleration. Large‐scale climate forcings, particularly atmospheric circulation patterns and ocean–atmosphere interactions, dominated hydrological variability, accounting for 73% to 80% of the explained variance, significantly surpassing the influence of local climate factors and human activities. Causal loop analysis further revealed bidirectional feedback mechanisms between water cycle acceleration and drought subsystems, showing that intensification of process variables amplified meteorological drought while buffering hydrological drought. Our study provides a systematic and mechanism-based perspective on hydrological cycle intensification in arid regions. The RHC framework offers a transferable approach to diagnosing complex hydrological responses to climate change, underscoring the need for process-based metrics in future water resource vulnerability assessments.}
}
@article{XING2026135591,
title = {Unraveling dissolved inorganic nitrogen dynamics in a sandy beach: The role of tidal forces and aquifer heterogeneity},
journal = {Journal of Hydrology},
volume = {675},
pages = {135591},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135591},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006888},
author = {Cheng Xing and Yan Zhang and Hongkai Qi and Ding He and Yi Liu},
keywords = {Intertidal Aquifer, Dissolved Inorganic Nitrogen, Tide, Heterogeneity, Remineralization, Nitrification},
abstract = {Coastal groundwater is one of the major nitrogen (N) sources for marine ecosystems, yet the estimates of the N flux have a large uncertainty due to limited understanding of in-situ biogeochemical processes in the intertidal aquifer under the influence of tidal fluctuations and aquifer heterogeneity. In this study, a high-resolution intertidal groundwater monitoring across spring-neap tidal cycles revealed vertically stratified dissolved inorganic N (DIN) speciation controlled by redox zonation. Nitrate (NO3– > 230 μM) dominated the shallow zone (< 1.5 m), while ammonium was extremely high (NH4+ > 340 μM) in the deep zone (> 1.5 m), where sediments consist of high-organic content and low-permeability marine deposits. A two-endmember mixing model indicates the local production of NO3– and NH4+ in the aquifer. The co-occurrence of high NH4+ and high salinity in the low-permeability, anoxic, organic-rich marine deposits suggests DIN production through the remineralization of soil organic matter (SOM) possibly driven by reduction of iron (Ⅲ) oxide and sulfate. NO3– enrichment in the shallow oxic zone (< 1.5 m) is a result of strong nitrification. Sediment incubation with labeled δ15N-NH4+ showed nitrification rate was 10-fold higher in the shallow zone than the deep zone. From neap to spring tides, submarine groundwater discharge increased by 15% from 6.94 to 8.00 m2 d-1, while DIN export decreased by 7% from 1.24 × 103 to 1.15 × 103 mmol m−1 d-1. This paradox is led by the enhanced flow dynamics during spring tide, which shortens average groundwater residence time from 7.15 to 6.20 d, thereby limits remineralization of SOM. Our findings highlight intertidal aquifers as dynamic biogeochemical reactors strongly influenced by aquifer heterogeneity and tidal forces. Locally geogenic N is one of the major sources of coastal groundwater N in addition to inputs from terrestrial groundwater.}
}
@article{YANG2026135599,
title = {Attributing terrestrial water storage changes on the Tibetan Plateau to climate and human drivers using a hybrid deep learning approach},
journal = {Journal of Hydrology},
volume = {675},
pages = {135599},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135599},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006967},
author = {Zhiqiang Yang and Aili Yang and Xiong Zhou},
keywords = {Tibetan Plateau, Terrestrial water storage, GRACE, VMD-CNN-LSTM, Attribution Analysis, Climate and anthropogenic impacts},
abstract = {The Tibetan Plateau (TP), referred to as “Water Tower” for Asia, is highly sensitive to both climate change and anthropogenic activities. However, assessing the spatiotemporal dynamics of terrestrial water storage (TWS) and attributing its changes across the TP remains challenging. This is primarily due to discontinuous satellite observations and the complex interactions between climatic drivers and potentially human-related influences. To address these limitations, we develop a VMD‑CNN‑LSTM‑based TWS Prediction and Hierarchical Attribution (VCLHA) framework. VCLHA can quantify the independent contributions of climatic factors (precipitation, evapotranspiration, runoff, and temperature) and a residual component potentially associated with human activities to TWSC. The evaluation results demonstrate that the framework has robust performance, achieving a Nash-Sutcliffe Efficiency (NSE) value of 0.983. Robustness is further supported by intercomparison with independent GRACE-like reconstructions (e.g., GRACE-REC, CSRM-Bayesian, and BNML_TWSA) during the GRACE/GRACE-FO observational gap (July 2017–May 2018), showing consistent plateau-mean evolution. The prediction results reveal pronounced spatial heterogeneity, with water increases of 1.87 mm yr−1 in northern TP and severe water decreases of 8.17mm yr−1 in the south. The precipitation is identified as the dominant climatic driver, explaining 43.2% of the variance in TWS change. However, while the residual component potentially associated with human activities shows no clear long-term trend (0.05 mm yr−1), it exhibits strong seasonality, characterized by positive effects in spring and negative effects in summer (−2.81 mm) and autumn (−1.62 mm). This seasonal variability amplifies water-storage deficits during summer–autumn (July–October), particularly in southern and outflow basins. These findings provide quantitative evidence for the relative roles of climate variability and human-related influence in regional water storage variability, thereby supporting adaptive and region-specific water-resource management strategies on the TP. Plain Language Summary. The Tibetan Plateau (TP) supplies freshwater to many of Asia’s major rivers and supports hundreds of millions of people downstream. However, it is challenging to determine how much recent changes in water availability are related to climate change and human-related influences. In this study, we develop a hybrid deep learning framework to reconstruct satellite gravity observations and to assess the relative roles of natural processes and a residual component potentially associated with human activities in water storage change. From 2003 to 2023, climate-related processes have led to a steady long-term decline in water storage (−0.10 mm per year). While the residual component potentially associated with human activities did not exhibit a consistent long-term trend, it had a pronounced seasonal impact, contributing to water gains in spring but intensifying losses in summer (−2.81 mm) and autumn (−1.62 mm). These seasonal deficits were most severe in southern, downstream basins, whereas northern and interior regions showed partial recovery in spring. Precipitation was found to be the most important climate factor influencing water storage. These insights can help improve drought preparedness, irrigation planning, and reservoir management as climate change continues to reshape the regional water cycle.}
}
@article{QIN2026135502,
title = {Deep learning-based adaptive multi-resolution characterization of CO2 storage sites from monitoring data},
journal = {Journal of Hydrology},
volume = {675},
pages = {135502},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135502},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005998},
author = {Zhen Qin and Yingxiang Liu and Harun Ates and Behnam Jafarpour},
keywords = {Adaptive parameterization, Multi-resolution inversion, Deep learning, Latent-space representation, Geological CO storage},
abstract = {In geological CO2 storage (GCS), characterization of subsurface properties and CO2 plume migration through inversion of monitoring data is challenging because the subsurface is spatially heterogeneous, leading to high-dimensional parameter fields, while monitoring data are sparse and unevenly distributed. This mismatch between parameter dimensionality and data coverage renders the inverse problem ill-posed, motivating low-dimensional parameterizations that balance model expressiveness with available observational constraints. Furthermore, heterogeneous data coverage calls for multi-resolution representations that enable spatially adaptive updates: coarse-scale adjustments in poorly informed regions and finer-scale detail where measurements provide stronger constraints. Such flexibility is largely absent in existing approaches, which typically employ a single, globally uniform resolution. To address these limitations, we propose a deep learning architecture that learns a spatially structured, multi-resolution latent representation of subsurface properties. The proposed model, termed the multi-resolution spatial autoencoder (MSAE), encodes parameter fields into latent features at multiple resolutions and decodes them to reconstruct permeability models at user-defined resolution levels. Explicit control of model complexity is achieved through a spatially adaptive, multi-resolution masking scheme that selectively activates latent components according to local data support. Building on MSAE, we demonstrate how the proposed parameterization can be coupled with established inversion frameworks—including gradient-based deterministic optimization and ensemble-based methods—to perform spatially adaptive, multi-resolution inversion under sparse monitoring conditions. The framework balances model complexity with available data support, achieving improved reconstruction and long-term plume prediction compared with fixed uniform-resolution parameterizations. Across both deterministic and ensemble-based inversion settings, it reduces overfitting, stabilizes posterior updates in poorly informed regions, and demonstrates the consistent advantages of adaptive multi-resolution representations.}
}
@article{TANG2026135575,
title = {Hybrid-cryo: a modular data-physics hybrid framework for cryospheric runoff simulation},
journal = {Journal of Hydrology},
volume = {675},
pages = {135575},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135575},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006724},
author = {Zijie Tang and Jianyun Zhang and Mengliu Hu and Hossein Hashemi and Feifei Yuan and Kang Xie and Zhongrui Ning and Cuishan Liu and Mingming Xie and Jiangjiang Zhang and Guoqing Wang},
keywords = {Cryospheric hydrology, Rainfall-runoff simulation, Physics-guided deep learning, Modular model, Hybrid model},
abstract = {Climate warming profoundly alters cryospheric hydrological cycles, exacerbating the challenge of simulating the poorly understood processes, particularly in complex, glacier- and permafrost-dominated headwater basins. This difficulty centers on accurately representing the compound runoff regimes generated by the complex, overlapping interactions between rainfall and multiple cryospheric melt processes. These overlapping processes yield highly nonlinear and state-shifting runoff responses, making cold-region hydrological simulation particularly challenging. To address this, we introduce Hybrid-Cryo, a modular data-physics hybrid framework for cryospheric runoff simulation, guided by a “skeleton-and-muscles” design philosophy. The framework’s physical “skeleton” reformulates process-based models (PBMs) into a differentiable architecture to enforce physical consistency and generate key hydrological states. Its adaptive “muscles”, comprising deep learning components, then learn the complex runoff dynamics from these states while correcting for the skeleton’s inherent biases. We evaluated the proposed framework in two major headwater basins on the Tibetan Plateau: the source regions of the Yangtze River (SRYZ) and the Yellow River (SRYE), benchmarking it against a suite of conventional PBMs, a standalone Long Short-Term Memory (LSTM), and other physics-guided deep learning (PGDL) approaches. Results show that the proposed approach outperformed all benchmark models, with test Kling-Gupta Efficiency (KGE) of 0.925 (SRYE) and 0.883 (SRYZ). The proposed framework also showed promising transferability to data-scarce upstream sub-basins with local fine-tuning. Analysis using Gradient-weighted Class Activation Mapping (Grad-CAM) uncovered the proposed framework’s internal problem-solving strategy, revealing that it learns to dynamically down-weight the contributions of poorly performing physical modules.}
}
@article{ZHAO2026135664,
title = {Declining precipitation frequency may increase vegetation recovery time following extreme drought},
journal = {Journal of Hydrology},
volume = {675},
pages = {135664},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135664},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007614},
author = {Shuai Zhao and Yimin Chen and Yuanzhi Yao and Hao Shi and Hui Zhang and Yang Li},
keywords = {Vegetation recovery, Drought recovery time, Precipitation frequency, Total precipitation, Ecosystem resilience, Standardized Precipitation Evapotranspiration Index (SPEI)},
abstract = {Under global climate change, drought events have become increasingly frequent and intense, posing growing risks to terrestrial ecosystems and carbon-cycle stability. Quantifying vegetation drought recovery time (DRT) and its controlling factors is therefore crucial for assessing ecosystem resilience and improving carbon-cycle assessments. While DRT is strongly influenced by post-drought precipitation, previous studies have mainly focused on total precipitation (Ptotal), whereas the role of precipitation frequency (Pfreq) remains unresolved. Here, we quantify how Pfreq influences DRT of global natural vegetation following extreme drought during 1982–2022. Extreme drought events were identified using the 3-month Standardized Precipitation–Evapotranspiration Index (SPEI-3), and DRT was defined as the time from maximum Normalized Difference Vegetation Index (NDVI) suppression to recovery of NDVI anomalies to the long-term mean for two consecutive months. We compared DRT sensitivity to Pfreq versus Ptotal using random-forest (RF) models interpreted with SHapley Additive exPlanations (SHAP). In the global model, DRT was generally more sensitive to Ptotal than to Pfreq (mean(|SHAP_Pfreq|)/mean(|SHAP_Ptotal|) = 0.67 (0.52–0.79)), although Pfreq remained a substantial predictor. In an RF-based scenario analysis, significant Pfreq declines occurred in 34.29% of naturally vegetated grid cells and were associated with DRT increases in 24.59% of grid cells (≈72% of the Pfreq-decline grid cells). Across vegetation types, mean DRT increases under Pfreq decline ranged from 13.57% to 19.52%. These results indicate that, although precipitation amount remains the dominant global precipitation-related control on drought recovery, precipitation frequency is an important complementary constraint that should be explicitly represented in global recovery assessments under shifting rainfall regimes.}
}
@article{ZUO2026135583,
title = {Multiscale discrete fracture-matrix method for simulating groundwater flow in fractured geological media},
journal = {Journal of Hydrology},
volume = {675},
pages = {135583},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135583},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006803},
author = {Chen Zuo and Lei Ma and Di Gao and Qiankun Luo and Yaping Deng and Jiazhong Qian},
keywords = {Multiscale, Fracture-matrix system, Coupling finite element, Fractured geologic media, Finite element method},
abstract = {Fractured geological media (FGM) are characterized by inherent multiscale features and strong spatial heterogeneity. When simulating groundwater flow in FGM, existing methods encounter a critical challenge in balancing accuracy against efficiency. This study proposes a novel Multiscale Discrete Fracture-Matrix (MsDFM) method. The method employs a hybrid modeling strategy that combines explicit, embedded, and implicit representations of different-scale fractures. Large-scale fractures that influence macroscopic flow are explicitly represented using matching meshes within the rock matrix, while the numerous and geometrically complex medium-scale fractures are represented by non-matching meshes that are embedded within the matrix domain. The two types of meshes are connected using the Coupling Finite Element Method, and the hydraulic head continuity between the fracture and matrix is enforced weakly via a penalty term. The performance of this method is evaluated using commercial software and various published methods in a series of calculation examples. In comparison with the benchmark cases, the results of this method matched well with those of 14 methods, and the number of fracture elements is reduced by 40%. The comparison with the DFN proved that this method can simulate the influence of a permeable matrix on local fracture water flow. Furthermore, comparison with MFEPM proves that MsDFM not only avoids local numerical errors caused by pseudo-connectivity, but also improves the calculation time by 8.7 times. The results show that the proposed method significantly reduces computational cost while ensuring high accuracy, providing a reliable and highly scalable new method for the accurate and efficient simulation of FGM.}
}
@article{LI2026135644,
title = {A process-informed multi-parameter downscaling framework for high-resolution source apportionment of riverine nutrients},
journal = {Journal of Hydrology},
volume = {675},
pages = {135644},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135644},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007419},
author = {Xia Li and Chouai Cai and Le Fang and Cheng Zhang and Ying Peng and Qichun Yang and Ze Ren and Xinhui Liu},
keywords = {Nutrient source apportionment, Total nitrogen (TN) and total phosphorus (TP), Downscaling, High-resolution modeling, Spatial heterogeneity, Watershed management},
abstract = {Eutrophication driven by excessive total nitrogen (TN) and total phosphorus (TP) poses a major threat to China’s aquatic ecosystems. Precise identification of nutrient hotspots is essential for effective mitigation but remains constrained by hydrologically mediated transport processes across multiple spatial scales. Process-based models such as the Soil and Water Assessment Tool (SWAT) are widely used, yet their coarse subbasin divisions obscure intra-subbasin heterogeneity and limit source apportionment. To address this, we developed a process-informed, multi-parameter downscaling framework integrating SWAT-derived subbasin outputs with high-resolution land use, topographic, and hydrological datasets. This approach downscaled nutrient source tracing from the SWAT subbasin scale (average ∼485 km2) to a 1 km × 1 km grid, achieving an approximately 485-fold improvement in spatial resolution, enabling fine-scale spatial patterns of TN and TP sources and revealing intra-subbasin heterogeneity that was not resolved by SWAT alone. The downscaling framework demonstrated robust performance, with calibration Radj2 of 0.916 and 0.911 and Nash-Sutcliffe efficiency coefficient (NSE) exceeding 0.90 for log-transformed TN and TP, and leave-one-out cross-validation Radj2 of 0.853 and 0.864, confirming strong model generalizability. Variation analysis further revealed substantial heterogeneity within the high-contributing subbasins, with 9 out of 11 for TN and 2 out of 13 for TP exhibiting internal variability over 30%. These results indicate that the downscaling analysis can uncover critical spatial variability in nutrient source distributions. Targeted interventions, such as upgrading sewage treatment and establishing constructed wetlands, should be directed to the precise internal hotspots responsible for disproportionate nutrient export. By bridging the gap between subbasin scale modeling and fine scale source delineation, this approach provides a more precise spatial representation of nutrient distributions and establishes a transferable framework for high-resolution nutrient management in diverse global watersheds.}
}
@article{ZHONG2026135571,
title = {High-Precision baseflow separation in data-scarce regions with machine learning models},
journal = {Journal of Hydrology},
volume = {675},
pages = {135571},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135571},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006682},
author = {Rong Zhong and Hang Lyu and Xiaosi Su and Tingting Deng and Aimin Cai and Yanxi Wu and Jingzun Mao and Peng Zhou},
keywords = {EC regression, Data-scarce regions, Machine learning models, Baseflow separation, CMB method},
abstract = {Accurate baseflow separation is vital for ecological conservation, hydrological model validation, and water resource management. However, the application of electrical conductivity (EC)-based methods is often constrained by the lack of daily EC observations in many basins, which limits the accuracy of baseflow estimation. To address this challenge, we reconstructed daily EC from sparse measurements using machine-learning models and commonly available hydroclimatic and basin data. Using data from 147 monitoring sites in the Colorado and Missouri River basins, which span contrasting climatic and basin conditions, we evaluated EC regression models across ecoregions under simulated data-scarce conditions. Weekly and monthly subsampling schemes were used to represent limited monitoring frequency, and support vector regression, decision tree, random forest (RF), and a conventional power-law function were compared. The results showed that RF achieved the highest accuracy, outperforming the power-law function by 24%, and that model performance varied systematically across five ecoregions according to key hydroclimatic and basin controls. The accuracy of the optimal regression model relied on the quality of the training set, particularly the negative streamflow-EC correlation, and we observed that correlation coefficients below −0.4 ensured more reliable results. To minimize costs in regions with limited conductivity data, our results suggest that monitoring EC about 156 times at weekly intervals over three years or 182 times at monthly intervals over 15 years can meet the RF model’s data requirements. These findings offer guidance for EC monitoring design and enable more reliable CMB-based baseflow separation in data-scarce regions.}
}
@article{WEI2026135616,
title = {Comparative analysis of JRA-3Q and JRA-55 reanalysis datasets as forcing for land surface model: implications for hydrological processes},
journal = {Journal of Hydrology},
volume = {675},
pages = {135616},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135616},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007134},
author = {Zixin Wei and Fan Bai and Zhongwang Wei and Yongjiu Dai},
keywords = {JRA-3Q, CoLM2024, Land surface model, OpenBench, Hydrological processes, Attribution analysis},
abstract = {Accurate simulation of land surface processes is important for understanding global water and energy cycles, as offline land surface models (LSMs) are heavily dependent on the quality of meteorological forcing data. The Japanese Meteorological Agency has developed JRA-3Q, a new-generation atmospheric reanalysis that succeeds JRA-55. This new dataset provides enhanced spatial resolution, improved representation of physical processes, and advanced data assimilation systems. This study evaluates the performance of JRA-3Q as forcing data for the CoLM2024 LSM, comparing it with JRA-55, with a focus on simulating hydrological processes. We conducted comprehensive model simulations from 2001 to 2010 using the False Discovery Rate (FDR) method to evaluate the statistical significance of variables and Partial Least Squares Regression (PLSR) to quantify attribution mechanisms between forcing variables and simulation outputs. Results show that JRA-3Q significantly improves the representation of precipitation, especially in arid regions, as well as air temperature, with these enhancements propagating through the LSM to improve global hydrological variables (evapotranspiration, surface soil moisture, total runoff, and streamflow). These advancements support drought detection, flood forecasting, and climate impact research. Attribution analysis reveals that hydrological improvements in arid regions benefit from enhanced precipitation accuracy. However, insufficient shortwave radiation in tropical regions limits the simulation of net radiation. Furthermore, increasing the simulation resolution does not necessarily enhance model performance, and the inclusion of dynamic leaf area index and biogeochemical modules introduces additional uncertainties, highlighting the complexity-performance trade-off. These findings emphasize the importance of regional characteristics in forcing data selection and suggest optimizing tropical radiation representation within integrated evaluation frameworks.}
}
@article{CAROLLO2026135619,
title = {Is the Weibull distribution reliable to describe the rainfall kinetic power and momentum in Mediterranean environments?},
journal = {Journal of Hydrology},
volume = {675},
pages = {135619},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135619},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600716X},
author = {F.G. Carollo and R. Caruso and V. Ferro and M.A. Serio},
keywords = {Rainfall erosivity, Rainfall intensity, Raindrop size distribution, Kinetic power, Weibull distribution},
abstract = {Understanding the characteristics of the rainfall drop size distribution (DSD) at the land surface is crucial for elucidating the mechanisms of precipitation that affect soil erosion processes. This study aims to both apply the Weibull distribution to more than 47,000 DSDs detected at Palermo (Italy) and El Teularet (Spain) experimental sites and deduce theoretically relationships for estimating the rainfall kinetic power and momentum of a DSD distributed as Weibull law having known parameters. The study confirms that the theoretical Weibull distribution can accurately reproduce measured DSDs, with highly consistent fitting results using the moment method (MM) for estimating its parameters. The results indicate that rainfall kinetic power and momentum are closely related to the characteristics of the DSD. No statistically significant correlation between the parameters of the Weibull distribution and rainfall intensity is detected. Moreover, the analysis highlights that the η parameter turns out to be related to the coefficient of variation of the DSD, and the parameter N0 represents the total number of drops, making the Weibull distribution physically based. Furthermore, a comparison between the Weibull and Ulbrich distributionsallowsfor the conclusion that, although both models exhibit similar performance in terms of fitting and reliability when describing rainfall kinetic power and momentum, the Weibull distribution offers advantages related to parameter estimation. Specifically, its parameters, unlike those of Ulbrich,possessaphysical, and not merely statistical, significance. The study concludes that the Weibull distribution is highly reliable for characterizing rainfall kinetic power and momentum in two experimental sites located in the Mediterranean region, and rainfall intensity cannot serve as a variable to comprehensively represent the characteristics of precipitation.}
}
@article{LEI2026135579,
title = {T-ResUNet: A deep-learning framework for spatiotemporal prediction of granular–fluid dam-break flows},
journal = {Journal of Hydrology},
volume = {675},
pages = {135579},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135579},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006761},
author = {Cheng-ming Lei and Shun Wang and Xuan Kang and Zheng-yang Su and Wei Wu},
keywords = {Dam-break flow, Granular–fluid interaction, Deep learning, Spatiotemporal prediction, Surrogate modeling},
abstract = {Accurate and efficient prediction of the spatiotemporal evolution of dam-break flows involving granular materials and interstitial fluid is essential for effective risk mitigation and emergency planning. In this paper, we introduce a spatiotemporal deep-learning surrogate model, T-ResUNet, for rapid prediction of two-phase dam-break flows triggered by granular column collapse. The proposed framework integrates a ResUNet architecture for spatial feature extraction with a Transformer module for temporal dependency modeling, enabling stable multi-step forecasting of flow dynamics. High-fidelity CFD–DEM simulations under varying granular and water column conditions are used to construct the training dataset. Results show that the model accurately reproduces the evolution of water volume fraction and achieves satisfactory performance in predicting flow velocity across 100 autoregressive steps. The model also demonstrates robust predictive capability for unseen parameter combinations within the training domain and maintains reasonable performance under limited extrapolation scenarios. These results demonstrate that the proposed T-ResUNet framework offers an efficient surrogate modeling strategy for laboratory-scale 2D-vertical granular–fluid dam-break flows. It achieves a favorable trade-off between computational efficiency and predictive accuracy while establishing a methodological foundation for future extensions to more complex fluid–solid coupled scenarios.}
}
@article{YAO2026135608,
title = {Unravelling the dynamic settling behaviour of silty sediments in turbulent water},
journal = {Journal of Hydrology},
volume = {675},
pages = {135608},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135608},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007055},
author = {Peng Yao and Zhongxing Qiao and Min Su and Yongping Chen and Yuan Wang and Zhengbing Wang},
keywords = {Silt-dominated sediment, Settling velocity, Turbulence effects, Process-approximating method, Annular flume experiment},
abstract = {Bulk settling velocity is a fundamental parameter characterizing the overall settling behaviour of mixed sediment and representing the downward sediment flux in sediment transport modelling. However, the influence of turbulence on this parameter for silty sediment remains insufficiently understood. To address this, annular flume experiments were conducted using three sediment mixtures with silt contents ranging from 24% to 85% under bed shear stresses up to 1.0 Pa. Bulk settling velocities were estimated using both the conventional McLaughlin method and a novel process-approximating method based on iterative numerical simulations. Results reveal a distinct four-stage evolution. Under very weak turbulence, the settling velocity remains constant. As turbulence intensifies, the loitering effect dominates, reducing the settling velocity to a minimum near three times the critical bed shear stress of discrete particles. As turbulence further rises, the fast-tracking effect enhances, causing the velocity to gradually recover. Under strong turbulence, it increases markedly. Importantly, particle inertia affects how sediments respond to turbulence: finer, silt-rich sediment with low inertia transition between settling regimes at weaker turbulence and exhibit greater enhancement in settling velocity under strong turbulence, whereas coarser sediment with greater inertia responds more sluggishly, resulting in a more pronounced reduction by loitering. Finally, a formula was proposed to quantify bulk settling velocity as a function of bed shear stress for sediments with varying silt contents. These findings highlight that settling velocity in turbulent waters is not constant but varies with turbulence, underscoring the critical roles of turbulence and silt content in governing settling behaviour.}
}
@article{CAPPELLI2026135660,
title = {Simulating sub-daily rainfall time series in the absence of sub-daily observations},
journal = {Journal of Hydrology},
volume = {675},
pages = {135660},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135660},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007572},
author = {F. Cappelli and E. Volpi and A. Langousis and R. Deidda and S.M. Papalexiou and A. Perdios and S. Grimaldi},
keywords = {Sub-daily rainfall simulation, Complete Stochastic Modelling System, Multifractal modelling, Canonical Multiplicative Random Cascade, Parsimonious rainfall model calibration},
abstract = {This paper presents a novel framework for simulating sub-daily rainfall time series in the absence of sub-daily observations, which are typically essential for calibrating conventional approaches. The proposed approach combines two classes of models: a daily rainfall model that generates long synthetic daily time series and a disaggregation model based on multifractal theory to refine the temporal resolution to sub-daily scales. The implemented procedure is parsimonious and relies solely on the observed daily rainfall time series and the power law exponent n of the intensity–duration–frequency curves, information widely available to practitioners. The framework was tested on a challenging case study consisting of 70 rain gauges in the Arno River basin (Italy), each with 20 years of continuous 15-minute rainfall data. The performance was evaluated by comparing key statistical attributes estimated from the benchmark dataset and the simulated rainfall time series at 15-minute temporal resolution, such as the dry frequency, the autocorrelation at lags 1 and 10, and the dependence of rainfall intensity on the duration of spatial averaging and return period as embodied in the well-established notion of intensity–duration–frequency (IDF) curves. The results show promising agreement, despite the limited sample size, which introduces some calibration challenges. The relative errors of the selected attributes fall within ± 15% for most of the analyzed time series, indicating that the framework offers a valuable alternative for hydrological studies, particularly in contexts where sub-daily observations are scarce or entirely absent.}
}
@article{IBNMURAD2026135632,
title = {Simulating and characterising concurrent lateral–vertical saltwater intrusion in low-lying coastal aquifers under pumping and storm-surge forcing},
journal = {Journal of Hydrology},
volume = {675},
pages = {135632},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135632},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007298},
author = {Khandakar Faisal {Ibn Murad} and Anner Paldor and Dilip Kumar Roy and Bithin Datta},
keywords = {Saltwater intrusion, Storm surge, Pumping, Fully-coupled modelling, Coastal aquifer},
abstract = {Salinisation of low-lying coastal aquifers arises via two interacting pathways—pumping-induced lateral saltwater intrusion (LSWI) and storm-surge-induced vertical saltwater intrusion (VSWI)—yet most studies model them separately, risking mischaracterisation of overall salinisation and suboptimal management. To address this gap, this study develops a fully-coupled, density-dependent surface–subsurface model that simulates the concurrent evolution and interaction of both intrusion pathways. A conceptual coastal aquifer is subjected to ten scenarios combining five pumping rates (0–200 m3/d) with either no surge or a single storm surge event over a 50-year horizon. Landward salt-mass is integrated and decomposed into LSWI, VSWI, and cross-effect components using normalised metrics. Results show that pumping is the primary control on multi-decadal salinisation and is nonlinear: stepwise increases in abstraction induce inland migration and thickening of the seawater wedge with more-than-proportional salt accumulation. A storm surge introduces an early vertical salt pulse whose magnitude and persistence increase with pumping. Without abstraction, the pulse peaks within a few years and largely flushes within ∼ two decades; with abstraction, it peaks later, decays more slowly, and at high rates leaves residual salinity that persists to year 50. Normalised analyses confirm that pumping amplifies surge impacts. Targeted comparison analyses under alternate hydraulic conductivity and recurrent-surge conditions indicate that the interaction framework remains qualitatively robust, although its expression depends on aquifer permeability and interruption of recovery by repeated flooding. Practically, the results argue for limiting overall pumping, temporarily curtailing abstraction during/after surges, and re-evaluating management interventions to avoid trapping surge-derived salinity in low-lying coastal aquifers.}
}
@article{JAFFRES2026135535,
title = {Scaling relationships between catchment area and peak discharge across the Fitzroy Basin, eastern Australia},
journal = {Journal of Hydrology},
volume = {675},
pages = {135535},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135535},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006323},
author = {Jasmine B.D. Jaffrés and Chris Cuff and Cecily E. Rasmussen},
keywords = {Specific discharge, Catchment area, Fitzroy Basin, Extreme flow events, Stream gauge analysis, Flow–area scaling},
abstract = {Specific discharge – the flow rate per unit catchment area – highlights the spatial variability of rainfall–runoff events. These events rarely affect entire catchments uniformly, particularly in large river systems such as the Fitzroy Basin in eastern Australia. Using peak historical flow rates from 136 stream gauges, this study evaluates log–log scaling relationships between catchment area and specific discharge across the entire basin and nine major, nested subcatchments. The site-specific historical peaks across such a large and hydrologically diverse basin are used to assess how scaling behaviour varies with operational record length, rainfall extent and subcatchment characteristics. Peak specific discharge exhibits a strong inverse relationship with catchment area, consistent with power-law scaling. However, this relationship is more robust for gauges with longer operational records. Short operational periods reduce the likelihood of capturing rare, high-magnitude flow events and can substantially weaken scaling regressions. The analysis identifies specific gauges that exert disproportionate influence on the fitted exponents, offering practical guidance for gauge selection in future scaling and flood-frequency studies. Accurate estimation of extreme flows is further complicated by highly complex, non-stationary riverbed cross-sections, with some floodplains spanning several kilometres, reducing the reliability of rating curves during major floods. Improved characterisation of peak specific discharge enhances the predictive capacity for extreme flow rates, particularly under projected increases in atmospheric moisture that are likely to amplify peak flows during extreme rainfall events.}
}
@article{XU2026135587,
title = {A semi-distributed model with physically-derived HRUs and time-dependent parameters for event-based flood simulation},
journal = {Journal of Hydrology},
volume = {675},
pages = {135587},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135587},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006840},
author = {Yingying Xu and Shan-e-hyder Soomro and Chengshuai Liu and Qiying Yu and Caihong Hu},
keywords = {Hydrological response unit classification, Adaptive spatiotemporal parameterization, Physically based hydrological modeling, Nonlinear rainfall-runoff processes, Short-term flood forecasting},
abstract = {Accurate real-time flood forecasting in heterogeneous watersheds is challenged by the nonstationary and nonlinear characteristics of rainfall-runoff processes. This study presents PHAST (Physically based Hydrological model with Adaptive Spatiotemporal parameters), a semi-distributed framework that integrates physically interpretable runoff generation mechanisms with dynamically evolving parameterization. Hydrological response units (HRUs) are delineated based on integrated soil, topographic, and land-use attributes, enabling a physically consistent representation of spatial heterogeneity. Key parameters controlling infiltration, runoff generation, and flow routing are updated adaptively in response to evolving hydrological conditions. Application to 20 historical flood events in the Xiagushan watershed demonstrates that saturated overland flow, subsurface flow, and groundwater contribute comparably to total runoff (33.00%, 34.27%, and 31.93%, respectively), while infiltration-excess overland flow is confined to a small fraction of the watershed area (0.80%). At a 1-h forecast lead time, PHAST achieves an average NSE of 0.97 and reduces peak discharge error to 2.87%, outperforming the static-parameter S-DHM model. Predictive skill decreases systematically with increasing lead time, with NSE declining to 0.58 at a 6-h horizon, reflecting the progressive accumulation of routing-related uncertainties and the diminishing influence of antecedent hydrological states as forecast lead time increases. Overall, PHAST provides a robust and physically interpretable framework for short-term flood forecasting and early warning in complex watersheds.}
}
@article{BILAL2026135604,
title = {A novel multi-link approach to drought propagation analysis using modified dynamic time warping},
journal = {Journal of Hydrology},
volume = {675},
pages = {135604},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135604},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007018},
author = {Syed Bakhtawar Bilal and Vivek Gupta},
keywords = {Drought propagation, Dynamic time warping, Meteorological drought, Hydrological drought},
abstract = {Drought propagation remains poorly quantified due to the limitations of existing metrics in capturing multi-link interactions, mechanisms, and temporal dynamics driving drought evolution from meteorological to agricultural and hydrological systems. Common methods for quantifying drought propagation such as correlation, copula analysis, and causal techniques are limited by single-point comparisons that fail to represent underlying mechanisms and system complexity. In contrast, our method captures time-varying, multi-link interactions, providing a more comprehensive representation of drought propagation mechanics. This study introduces a novel adaptation of Dynamic Time Warping (DTW), a technique that aligns two time series by allowing flexible temporal shifts, to more effectively capture the dynamics of drought propagation and applies it to analyze propagation patterns across 179 catchments in southern India. The proposed method integrates a forward only propagation band with a distance matrix framework to evaluate the temporally variable linkages involved in drought development. Results reveal shifting patterns in propagation lag, likely driven by climate change, and highlight a strong dependency of lag duration on precipitation anomalies. Notably, frequency analysis of wet and dry propagation events across catchments in southern India reveals a weakening of meteorological-hydrological linkages under above-normal precipitation conditions and a strengthening under below-normal conditions. These findings highlight the utility of Modified DTW in advancing our understanding of drought behavior and its response to evolving hydroclimatic stresses.}
}
@article{YANG2026135624,
title = {A bias-corrected deep learning-based data assimilation method for riverine bathymetry inversion},
journal = {Journal of Hydrology},
volume = {675},
pages = {135624},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135624},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007213},
author = {Runyi Yang and Jiangjiang Zhang and Lei Yao and Hongwu Zhang},
keywords = {Bathymetry inversion, Data assimilation, Non-Gaussian distribution, Ensemble smoother},
abstract = {Riverine bathymetry is essential for flood prevention, navigation planning, and ecological management, yet its direct measurements are often costly or impractical. Model-based inversion using readily available observations, such as flow velocity and water surface elevation, offers a promising alternative. Traditional deterministic approaches, however, are sensitive to observational and model errors and cannot fully quantify uncertainties. Within a Bayesian framework, bathymetry inversion can be treated as a stochastic inverse problem, producing more reliable, uncertainty-aware estimates. Ensemble-based methods, including the Kalman-based ensemble smoother (ES(K)) and the deep learning-based ensemble smoother (ES(DL)), provide computationally efficient implementations, with ES(DL) better capturing non-Gaussian features. Both methods, however, may exhibit biases in extreme value predictions. To address this, we propose a simple yet effective bias-correction strategy for ES(DL), resulting in the new EC(DL) method. Comprehensive numerical experiments show that ES(DL) matches ES(K) in Gaussian settings, while EC(DL) slightly outperforms both. In non-Gaussian scenarios involving extreme values, ES(DL) outperforms ES(K), and EC(DL) achieves the best overall performance. The proposed EC(DL) method demonstrates robust performance across diverse noise levels and observation layouts, highlighting its reliability, adaptability, and practical utility in riverine bathymetry inversion.}
}
@article{DESMEDT2026135648,
title = {Analytical solution for a slug test in an unconfined aquifer with mixed wellbore boundary conditions},
journal = {Journal of Hydrology},
volume = {675},
pages = {135648},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135648},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007456},
author = {Florimond {De Smedt}},
keywords = {Slug test, Unconfined aquifer, Phreatic aquifer, Mixed boundary conditions, Hydraulic conductivity, Specific storage coefficient},
abstract = {This study presents a novel semi-analytical solution for slug tests performed in partially screened wells in an unconfined aquifer, incorporating mixed boundary conditions at the well face. The model imposes a zero flux along the well casing and a constant pressure head over the screened interval, equal to the instantaneous water level within the well, conditions that represent the well-aquifer interaction more accurately than the generally accepted uniform flux boundary condition. The groundwater flow equations are transformed using Laplace and finite Fourier sine transformations, yielding an exact solution in the Laplace domain. Results show that, when the well screen is located far below the water table, the predicted head response in the well closely matches that obtained from traditional uniform flux models, despite significant differences in the spatial distribution of pressure head and flux along the filter. In contrast, for slug tests conducted near the water table, the uniform flux assumption introduces significant discrepancies in both simulated well responses and inferred aquifer properties. Neglecting mixed boundary effects can lead to substantial bias in estimated hydraulic conductivity, particularly near the water table where vertical flow components are important. The proposed method offers a more robust framework for interpreting slug tests in unconfined aquifers, especially when the position of the filter relative to the water table renders traditional models unreliable.}
}
@article{ZHAO2026135611,
title = {Shifting streamflow regimes in the arctic: a multi-basin analysis using the VIC model},
journal = {Journal of Hydrology},
volume = {675},
pages = {135611},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135611},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007080},
author = {Min Zhao and Xuezhi Bai and Shunqi Pan},
keywords = {Arctic hydrology, Streamflow regime shift, Climate–streamflow relationship, VIC model, Pan-Arctic rivers},
abstract = {Arctic runoff plays a crucial role in regulating the global freshwater balance, yet its long-term variability and controlling mechanisms remain insufficiently understood. This study investigates streamflow changes across six major Arctic River basins (Mackenzie, Yukon, Kolyma, Lena, Yenisei, and Ob) from 1972 to 2024, based on observational dataset analysis and simulations from the Variable Infiltration Capacity (VIC) hydrological model. Multi-scale statistical methods are applied to assess long-term trends and scale-dependent relationships between climate components and streamflow. VIC simulations further attribute these changes to shifting contributions from rainfall (Rf), evaporation (E), snow water equivalent change (ΔSWE), and soil moisture change (ΔSM), confirming a transition from snowmelt-dominated to increasingly rainfall- dominated streamflow regimes. Yukon and Kolyma exhibit early and complete regime shifts by the 2000s, whereas Lena and Mackenzie remain in transitional states. Ob exhibits a relatively stable regime with increasing rainfall influence, while Yenisei retains stronger snow-related regulation but also shows a transition toward a more mixed runoff regime. These basin-specific trajectories reveal the heterogeneous response of Arctic hydrology to ongoing warming. Evidence from this study demonstrates an ongoing transformation in Arctic hydrological processes under accelerated warming, with significant implications for freshwater export, permafrost–hydrology feedbacks, and land–atmosphere interactions in high-latitude environments.}
}
@article{LI2026135607,
title = {Threshold responses of runoff-sediment dynamics to hydrological connectivity},
journal = {Journal of Hydrology},
volume = {675},
pages = {135607},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135607},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007043},
author = {Taoxi Li and Qian Zeng and Yichen Yin and Gang Sun and Ruyi Zheng and Yichun Ma and Jiale Ye and Peiyao Xiao and Yaojun Liu},
keywords = {Rainfall, Hydrological connectivity, Runoff-sediment relationship, Watershed},
abstract = {Hydrological connectivity plays a critical role in regulating watershed runoff-sediment processes; however, the responses of runoff–sediment processes to hydrological connectivity remain insufficiently understood. This study quantified hydrological structural connectivity (HSC) and hydrological functional connectivity (HFC) using IC (Index of Connectivity) and IHC (Index of Hydrosedimentological Connectivity) indices in the Longyan watershed. A total of 320 erosive rainfall events recorded from 2015 to 2024 were analyzed to investigate threshold responses of runoff-sediment to hydrological connectivity. The results revealed pronounced threshold effects of hydrological connectivity on runoff and sediment responses, with three critical IHC thresholds identified at −1.77, −1.37, and −0.27. These thresholds define four response patterns of runoff-sediment relationship, which exhibit significant differences in runoff-sediment dynamics. The structural-dominated and weak functional-dominated patterns exhibit limited runoff and sediment generation capacities, whereas the strong functional-dominated pattern contributes substantially to both runoff and sediment export. The extreme rainfall-dominated pattern, although accounting for only 3% of events, contributes 50% of total sediment yield, reflecting markedly enhanced sediment transport efficiency. In this context, increasing the response threshold between hydrological connectivity and runoff-sediment processes is an effective approach to mitigating watershed erosion, particularly under extreme rainfall events. These findings deepen the understanding of watershed soil erosion processes from a hydrological connectivity perspective.}
}
@article{ZHUO2026135562,
title = {Simultaneous calibration of hydraulic head and deformation data for characterizing vertical aquitard heterogeneity via geostatistical inverse modeling},
journal = {Journal of Hydrology},
volume = {675},
pages = {135562},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135562},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006591},
author = {Yue Zhuo and Jinguo Wang and Weihua Liu and Weijian Li and Walter A Illman and Chao Zhuang},
keywords = {Aquitard heterogeneity, Hydraulic head, Deformation, Observation design, Geostatistical inversion},
abstract = {In multi-aquifer-aquitard systems, sustained and intensive groundwater extraction and recharge can induce both elastic and inelastic deformation in aquitards. Because aquitards are commonly heterogeneous, accurately characterizing the spatial distributions of hydraulic conductivity (Kv), elastic skeletal specific storage (Sske), and inelastic skeletal specific storage (Sskp) is essential for understanding aquitard drainage and deformation. In this study, the COMPAC model was used to generate synthetic hydraulic head and deformation responses in a thick aquitard under varying hydraulic head conditions in adjacent aquifers. A quasi-linear geostatistical approach (QLGA) was then applied to characterize aquitard heterogeneity in Kv, Sske and Sskp through joint calibration of hydraulic head and deformation data. Seven synthetic cases were designed to examine the effects of the initial hydraulic head observation point, the hydraulic head observation interval, and cumulative deformation zonation on inversion performance. The results show that the initial hydraulic head observation point mainly affects the estimated Kv field, whereas the hydraulic head observation interval and cumulative deformation zonation primarily influence the estimated Sske field. A smaller hydraulic head observation interval leads to poorer Sske inverse quality, while a more detailed deformation zonation markedly improves it. By contrast, the corresponding changes in Kv and Sskp are comparatively limited. Overall, an appropriate observation design for hydraulic head and deformation can improve inversion performance while reducing unnecessarily dense monitoring. This provides a reliable basis for characterizing vertical aquitard heterogeneity and offers quantitative guidance for optimizing observation design.}
}
@article{HU2026135651,
title = {Emerging global risks of extreme rain-on-snow events under climate warming},
journal = {Journal of Hydrology},
volume = {675},
pages = {135651},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135651},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007481},
author = {Keke Hu and Gulimire Hanati and Ping Jiao and Sulitan Danierhan and Wenjun Liu and Lei Jin and Jiahui Xie},
keywords = {Rain-on-snow, Climate warming, Spatiotemporal variability, High-risk regions, CMIP6},
abstract = {Global warming is profoundly altering precipitation regimes and snow cover dynamics, thereby reshaping both the frequency and intensity of rain-on-snow (ROS) events worldwide. Yet the future global risks and driving mechanisms of ROS events under climate warming scenarios remain insufficiently understood. Here, using ERA5-Land and a CMIP6 multi-model ensemble, we establish a global ROS event database covering the period 1950–2100 and characterize its spatiotemporal variability, driving mechanisms, and high-risk regions. We find that, relative to the historical period (1950–2023), future ROS events (2024–2100) will exhibit a contraction in spatial extent but an increase in occurrence frequency, with the most pronounced intensification occurring in mid- to high-elevation regions across the mid- to high-latitude Northern Hemisphere. A conditional probability analysis further reveals a synergistic mechanism among temperature, precipitation, and snow depth: when temperatures approach the 0 °C threshold, rainfall intensifies, and persistent snow cover is present, the likelihood of ROS events increases markedly. The projected rise in ROS events across mid- to high-latitude mountainous regions designates the Tibetan Plateau, the margins of Greenland, eastern and western North America, eastern Asia, and eastern Europe as global hotspots of extreme ROS events risk. These events peak in April and exhibit stronger intensities and higher recurrence under warmer climate scenarios. This study provides new insights into the future evolution of global ROS events in the context of ongoing climate warming.}
}
@article{CUI2026135593,
title = {Storage–supply regulation and rainfall responses driven by thermokarst lakes in permafrost-degrading catchments},
journal = {Journal of Hydrology},
volume = {675},
pages = {135593},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135593},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006906},
author = {Junhao Cui and Jia Qin and YongJian Ding and Yongyong Zhang and Bingfeng Yang and Feiteng Wang and Xiaobo He and Guangxi Ding},
keywords = {Thermokarst lakes, Qinghai-Tibet Plateau, Permafrost hydrology, Storage–supply regulation, Water balance},
abstract = {Thermokarst lakes are key indicators of permafrost degradation on the Qinghai–Tibet Plateau (QTP), yet their catchment-scale hydrological role under rainfall remains poorly understood. To address this, we conducted a paired-catchment study in the source region of the Yellow River, comparing a thermokarst-lake catchment (TLC) containing hundreds of lakes with a nearby non-lake catchment (nTLC). We combined annual water-balance closure with event-scale diagnostics, including soil–water storage change, groundwater-level change, lake-stage change, and hysteresis-based metrics to characterize storage–release behavior. Our results show contrasting annual water-retention outcomes: the TLC exhibited net storage depletion (−38.48 mm), whereas the nTLC showed net storage gain (+63.60 mm), and this contrast remained under both full and simplified closure formulations. At the event-scale, the TLC showed stronger rainfall-normalized subsurface responses than the nTLC, with groundwater responsiveness about six times higher and soil responsiveness about three times higher. Hysteresis analysis further revealed clearer rainfall-dependent switching in lake–river coupling than in groundwater–river coupling, with lake-specific transition thresholds concentrated within a relatively narrow rainfall range of 2.7–4.6 mm, whereas groundwater transitions were weakly constrained or unresolved at most wells. These results indicate that thermokarst lakes do not simply act as permanent water-retaining reservoirs, but instead reorganize the timing and pathways of water transfer, linking stronger event-scale connectivity with contrasting annual water-retention outcomes. This study provides a process-based reference for understanding hydrological regulation in lake-developing alpine permafrost catchments and evaluating future climate-change impacts on water balance in degrading permafrost regions.}
}
@article{LUO2026135574,
title = {Perception-enhanced bidirectional attention networks for short-term time series forecasting of water level in cascade reservoir system},
journal = {Journal of Hydrology},
volume = {675},
pages = {135574},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135574},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006712},
author = {Wei Luo and Yingjia Li and Feng Zhang and Xinpeng Yu and Shiruo Hu and Jianshi Zhao},
keywords = {Forecasting accuracy, Real-time operation, Atrous spatial pyramid pooling (ASPP), Selective attention networks, Squeeze-and-excitation networks (SeNet), Cascade reservoir forecasting},
abstract = {Real-time water level forecasting plays a crucial role in the operation of cascade reservoir systems; however, it remains challenging due to data uncertainties and error propagation. Motivated by recent advances in deep learning algorithms, this study proposes an improved Modern Temporal Convolutional Network (ModernTCN) for cascade reservoir water level prediction. We first develop a Multi-Scale Attention Atrous Spatial Pyramid (MSAASP) module by integrating Atrous Spatial Pyramid Pooling (ASPP) with Squeeze-and-Excitation Networks (SENet). This design enables more effective extraction of temporal features at multiple scales and adaptively reassigns weights to features according to their relative importance. The MSAASP module is then integrated into ModernTCN to construct the Perception-Enhanced Bidirectional Attention Network (PE-BANet). PE-BANet delivers substantial improvements in water level forecasting accuracy by expanding the model’s perceptual field and effectively learning temporospatial patterns. When applied to the Shenxigou–Zhentouba cascade reservoirs in the Dadu River Basin of China, the proposed method demonstrates superior predictive performance. The results show that PE-BANet outperforms transformer-based, MLP-based, RNN-based, and CNN-based models in both forecasting accuracy and computational efficiency. Specifically, for five-minute water level predictions within a one-hour forecasting horizon, PE-BANet achieves an average error of less than 0.15 m in the cascade reservoir system, thereby providing timely and precise information to support real-time operation and decision-making.}
}
@article{SINHA2026135538,
title = {Reconstruction of soil moisture time series with characterisation of drydown attributes},
journal = {Journal of Hydrology},
volume = {675},
pages = {135538},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135538},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006359},
author = {Jhilam Sinha and Ashish Sharma and Lucy Marshall},
keywords = {Bivariate recursive filtering, Drydowns, Reconstruction, SMAP, Soil moisture},
abstract = {Encapsulating soil water drying attributes in derived remote sensing products is essential for their application to various environmental studies. Systematic differences are observed for soil moisture (SM) drying phases (drydown) in Soil Moisture Active Passive (SMAP) level 4 (SMAP L4) product when compared to ground observations due to differences in measurement processes. An algorithm (BRF: Bivariate Recursive Filter) is able to translate drydown parameters, namely the drydown recession coefficient and initial wetness, to in-situ scale to enhance consistency with regional in-situ observations. Here, we propose a reconstruction procedure to structure the complete SM time series so that it is compatible with the bivariate transformed drydown attributes. The present study develops the reconstructed SM time series at any grid location SMAP L4 data is available at. The method is validated with 6 global in-situ networks and improvements have been observed in the reconstructed SMAP SM series. Significant enhancements are observed particularly during the drydown periods. Additional improvement is noticed when observations from spatially nearby in-situ stations for a target grid is used; this can assist in regional hydrological studies whenever ground data is available.}
}
@article{GUO2026135590,
title = {Integrating multi-isotope fingerprinting with machine-learning-informed Bayesian mixing reveals agricultural dominance of phosphorus sources in a River basin},
journal = {Journal of Hydrology},
volume = {675},
pages = {135590},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135590},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006876},
author = {Anqi Guo and Xuemei Chen and Junxi Yang and Jie Qin and Yuepeng Yin and Peng Wang and Ningtao Wang and Wen Zhang},
keywords = {Phosphate oxygen isotopes, Source apportionment, Machine learning, Multiple stable isotopes, Basin management},
abstract = {Precise identification and quantification of phosphate sources are essential for preventing eutrophication in river basins. Multi-isotope approaches, including phosphate oxygen isotopes (δ18Op), nitrogen isotopes (δ15N), and carbon isotopes (δ13C), are well-established for phosphate source tracing, but their quantitative estimates may be biased relative to actual source contributions. We integrated δ18Op, δ15N, and δ13C isotopes into a unified machine-learning coupling framework to quantitatively refine phosphate source tracing and constrain the inferential uncertainty inherent in multi-isotope mixing models. Qualitative multi-isotope fingerprinting identified Agricultural Phosphorus Sources (APS) as dominant, and the multi-isotope-Stable Isotope Mixing Models in R (SIMMR) apportionment under ML-informed priors yielded a posterior mean contribution of 56.11% for APS, with Phosphate Rock & Chemical Industry, Domestic Sewage, and Endogenous Release contributing 12.97%, 12.83%, and 18.09%, respectively. XGBoost accurately predicted total phosphorus in surface water (R2 = 0.76). SHAP (Shapley Additive Explanations) analysis identified agriculture-related pressure indicators (Agri-Fishery GDP, arable area, and phosphate fertilizer production) as the principal positive predictors of total phosphorus concentration. We further translated SHAP signals into a SHAP-based Agricultural Pressure Index to elicit weakly informative Dirichlet priors for SIMMR, narrowing 95% credible interval widths by 8.60–23.19% and shifting APS upward (mean 49.81%→56.11%), with minor reshuffling among secondary sources. This study integrates multi-isotope fingerprinting with a machine-learning-constrained SIMMR model to improve phosphorus-source apportionment.}
}
@article{LIU2026135643,
title = {Unraveling water sources and groundwater discharge in Mu Us Desert lakes using coupled 222Rn-2H-18O and hydrochemical tracers},
journal = {Journal of Hydrology},
volume = {675},
pages = {135643},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135643},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007407},
author = {Fengxia Liu and Guangcai Wang and Fu Liao and Hanxiao Wang and Xinming Song and Zheming Shi and Hongyu Zhang},
keywords = {Desert lake, Groundwater discharge, δH and δO, Radon-222, Rn mass balance},
abstract = {Desert lakes play a crucial role in sustaining hydrological and ecological equilibrium in arid regions, yet their water sources and groundwater discharge under anthropogenic pressures are not well understood. This study employed coupled hydrochemical and multi-isotopic (222Rn, δ2H, δ18O) tracers to identify water sources and estimate groundwater discharge in lakes along the eastern Mu Us Desert, an area with extensive coal mining history. Hydrochemical analysis revealed three distinct lake types: Type A (HCO3-Ca, lowest pH and EC), Type B (HCO3-Na·Ca, moderate pH and EC), and Type C (HCO3-Na, highest pH and EC), reflecting differing hydrological processes. Isotopic tracers and 222Rn mass balance modeling demonstrated that: (1) Type A lakes are predominantly recharged by shallow groundwater; (2) Type C lakes receive input from both treated and untreated coal mine drainage (CMD/TCMD); and (3) Type B lakes exhibit mixed sources of shallow groundwater and CMD/TCMD. Groundwater discharge rates were quantified at 119.47 ± 3.05 mm/d (Type A), 125.99 ± 2.43 mm/d (Type B), and 135.52 ± 11.48 mm/d (Type C). Monte Carlo simulations identified 222Rn activities (groundwater and lake water) and wind speed as the most sensitive parameters affecting discharge rate estimates. Accordingly, accurate measurement of 222Rn activity is essential for reliably determining groundwater discharge rates. Our findings provide new insights into desert lake maintenance mechanisms in mining-affected areas, offering a methodological framework for arid region hydrology studies.}
}
@article{MANOLI2026135663,
title = {Deep learning error post-processing improves stochastic watershed modeling},
journal = {Journal of Hydrology},
volume = {675},
pages = {135663},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135663},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007602},
author = {Benjamin Manoli and Sandeep Poudel and David K. Koval and Sarah Y. Murphy and Scott Steinschneider and Jonathan Lamontagne},
keywords = {Stochastic watershed modeling, Deterministic watershed modeling, Deep learning, Hydrologic extremes, Climate change},
abstract = {Hydrologic extremes, including floods and droughts, pose substantial societal risks that are expected to intensify with climate change. Deterministic watershed models (DWMs) remain a mainstay for modeling these extremes, but lack explicit representation of uncertainty, limiting their utility for risk-informed planning. Stochastic watershed models (SWMs) address this limitation by generating ensembles of streamflow via models of observed DWM residuals. However, most SWMs struggle with the complex dependence between DWM residuals and the underlying hydrologic state, which can complicate stochastic simulations under nonstationary climates. Deep learning (DL) models, whether used as standalone models or post-processors for process-based DWMs, offer a pathway to address this challenge by reducing conditional dependence. In this study, we evaluate SWMs applied to seven models: three process-based models (PRMS, Hymod, and HBV), their hybrid process-DL counterparts, and a pure DL DWM, focusing on daily simulations and extremes under both historical conditions and synthetic climate change scenarios. Results for a case study watershed in Massachusetts show that SWMs applied to hybrid or pure DL DWMs consistently outperform those applied to process-based DWMs. However, an SWM applied to the pure DL model exhibits weaknesses at low flows for this study basin, underscoring the value of hybrid approaches. Extending the analysis across 73 additional basins demonstrates that these improvements are robust and generalizable statewide. This work highlights the potential of a DL-enhanced stochastic watershed modeling framework to advance hydrologic risk prediction under changing climate conditions, offering a scalable methodology for integrating uncertainty into watershed modeling for long-term planning.}
}
@article{CHEN2026135598,
title = {Climatic drying-wetting cycles induced dynamic coupling effect between 3D soil desiccation cracking and moisture redistribution},
journal = {Journal of Hydrology},
volume = {675},
pages = {135598},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135598},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006955},
author = {Yu-Xuan Chen and Jun-Zheng Zhang and Chao-Sheng Tang and Run-Yang Lan and Qing Cheng and Jin-jian Xu and Ben-Gang Tian},
keywords = {Drought, Electrical Resistivity Tomography (ERT), Desiccation, Soil moisture, Soil resistivity},
abstract = {Desiccation cracking in clayey soils is a common natural phenomenon. The mechanical and hydraulic properties of cracked soil are sensitive to drying and wetting events, causing various geotechnical and environmental problems. This study characterizes the three-dimensional evolution of cracking morphology and moisture distribution of in-situ clayey soils. The soils were exposed to natural drying and to simulated rainfall events that replicated historical climate extremes. Electrical resistivity tomography was applied to monitor a 0.5 × 0.5 m clayey soil site with a desiccation cracking network during multiple drought and rainfall events. Laboratory measurements established the quantitative relationship between soil electrical resistivity and gravimetric moisture content. The resistivity tomograms successfully characterized the 3D desiccation-cracking network, including cracks that were invisible at the soil surface. Differences in resistivity evolution between soil near and away from cracks indicate that soil with closed cracks exhibits greater dynamic moisture changes and a heightened response to drying-wetting cycles. Results reveal a coupling effect between crack morphology dynamics and moisture distribution, in which the desiccation crack served as a preferential pathway for both evaporation and infiltration, while moisture localization around the crack can cause its closure. The resistivity model, combined with multi-source data, reconstructs the evolution of crack morphology and moisture distribution during drying-wetting cycles, providing crucial information for assessing soil and slope integrity.}
}
@article{WANG2026135554,
title = {Multimodal deep-learning–driven water-quality forecasting and scenario assessment: shifting from reactive monitoring to proactive basin management},
journal = {Journal of Hydrology},
volume = {675},
pages = {135554},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135554},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006517},
author = {Zile Wang and Baiqian Shi and Paul Osmond and Kefeng Zhang},
keywords = {Water quality prediction, Multimodal deep learning, Transformer, Transfer learning, Land-use scenarios, Explainable AI},
abstract = {Accurately forecasting river-water quality and assessing the impacts of prospective land-use or climate interventions remain central challenges for basin managers, particularly where monitoring networks are sparse. We present a multimodal deep-learning framework that fuses static and dynamic drivers, land-use composition, population density, Köppen climate class, meteorological and hydrological variables, and air-quality indicators, within a shared representation learned by a multimodal encoder–decoder architecture that combines LSTM, Transformer, and MLP encoders with a Transformer-based decoder. Trained on > 4 million samples from 1,801 monitoring stations in China, the model achieves Nash–Sutcliffe efficiencies of 0.72–0.96 for key parameters at 3-day lead time and maintains, or improves, predictive performance at 14-day, revealing latent trends in slowly responding pollutants (e.g., total nitrogen, COD). A modular fine-tuning approach that freezes the globally pretrained encoders uses only 1% local data yet outperforms a baseline retrained with a 50/50 train–test split of the local data, underscoring strong cross-site transferability. SHapley Additive Explanations (SHAP) analyses reveal that static land-use and socioeconomic features dominate baseline water quality, while air-quality and hydro-meteorological drivers govern short-term variability through cumulative, non-linear processes. Scenario simulations further indicate that replacing built or bare land with tree cover can reduce total nitrogen by up to 60% in densely populated, high-rainfall regions. Together, these findings demonstrate a pathway from reactive monitoring to proactive basin governance: sparse observations are translated into reliable forecasts; “what-if” scenarios become quantitative pollutant-reduction estimates; and managers gain an interpretable, scalable tool to align urban growth, ecological restoration, and climate-adaptation goals.}
}
@article{WANG2026135586,
title = {Driving factors of urban reclaimed water development in water-environment-sensitive regions: Coupled causal inference with double machine learning and causal forest},
journal = {Journal of Hydrology},
volume = {675},
pages = {135586},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135586},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006839},
author = {Chuanyi Wang and Fengping Wu and Xiangzeng Shi and Wentong Yang and Xinyu Liu},
keywords = {Urban reclaimed water development, Double machine learning, Causal forest, Causal inference, Region-tailored measures},
abstract = {Amid global water scarcity and ecological pressures, reclaimed water has become a key pathway to improving efficiency and alleviating water stress. Yet the causal mechanisms and heterogeneous responses remain underexplored. This study develops a six-dimension indicator system and advances a coupled double machine learning–causal forest framework, embedding city and year fixed effects to control unobservable heterogeneity and enhance robustness in causal inference. Using the Beijing–Tianjin–Hebei urban agglomeration as a case, nine core drivers are identified, including reclaimed water investment, per capita disposable income, pipeline length, and water sector employment, suggesting the importance of infrastructure conditions and underlying socioeconomic context. Cities exhibit distinct responses: resource-dominant cities show diminishing marginal returns, while peripheral cities display latecomer advantages. Development effects also reveal “high-efficiency windows” followed by “attenuation phases”, which may be associated with policy timing and urban development stages. These findings offer methodological innovation and practical guidance for differentiated, dynamic reclaimed water strategies.}
}
@article{BHERE2026135623,
title = {Non-stationary drought assessment through integration of rainfall and GRACE-based terrestrial water storage data},
journal = {Journal of Hydrology},
volume = {675},
pages = {135623},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135623},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007201},
author = {Sachin Bhere and Manne Janga Reddy},
keywords = {Drought assessment, GRACE, Terrestrial water storage, Standardised precipitation index, Non-stationary modelling},
abstract = {Droughts, defined as prolonged periods of abnormally low rainfall and water availability, cause severe agricultural losses, water scarcity, and ecological degradation, amplifying economic and social vulnerabilities. However, most assessments rely on stationary drought indices that emphasise rainfall deficits while overlooking critical hydrological components. This study presents a novel methodology that integrates rainfall data from the India Meteorological Department (IMD) with GRACE-derived Terrestrial Water Storage (TWS) to develop the Standardised Combined TWS–Rainfall Index (SCTRI) and the Standardised Precipitation Index (SPI) under both stationary and non-stationary frameworks. Unlike stationary indices, the non-stationary counterparts incorporate evolving climatic and hydrological dynamics, enabling more robust and accurate drought assessments. The proposed indices are evaluated across 34 meteorological subdivisions of India and tested against four major drought episodes (2009, 2012, 2014–2016, and 2019). Results indicated that the SCTRI reliably captures the progression from meteorological drought (detected earlier by SPI) to hydrological and groundwater droughts, with SCTRI frequently indicating greater severity during peak phases. Non-stationary formulations of both SCTRI and SPI outperform their stationary counterparts according to standard statistical criteria, revealing longer durations and increased intensity of droughts under non-stationary conditions, particularly across the southwestern, western, and some parts of central India. Return-period analysis further indicates that non-stationarity amplifies drought persistence and severity in several meteorological zones. Overall, the findings validate the SCTRI’s applicability for historical event analysis and highlight the need for regionally targeted, proactive drought management.}
}
@article{ZHAO2026135602,
title = {An end-to-end differentiable, graph neural network-embedded pore network model for permeability prediction},
journal = {Journal of Hydrology},
volume = {675},
pages = {135602},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135602},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006992},
author = {Qingqi Zhao and Heng Xiao},
keywords = {Permeability, Porous media, Data-driven fluid flow, Graph neural network, Pore network model, Adjoint method},
abstract = {Accurate prediction of permeability in porous media is essential for modeling subsurface flow. While pure data-driven models offer computational efficiency, they often lack generalization across scales and do not incorporate explicit physical constraints. Pore network models (PNMs), on the other hand, are physics-based and efficient but rely on idealized geometric assumptions to estimate pore-scale hydraulic conductance, limiting their accuracy in complex structures. To overcome these limitations, we present an end-to-end differentiable hybrid framework that embeds a graph neural network (GNN) into a PNM. In this framework, the analytical formulas used for conductance calculations are replaced by GNN-based predictions derived from pore and throat features. The predicted conductances are then passed to the PNM solver for permeability computation. In this way, the model avoids the idealized geometric assumptions of PNM while preserving the physics-based flow calculations. The GNN is first pretrained to regress PNM conductances from local pore and throat features, and is then fine-tuned using a single scalar permeability, avoiding the need for DNS derived pore-scale labels. This is made possible by backpropagating gradients through both the GNN (via automatic differentiation) and the PNM solver (via a discrete adjoint method), enabling fully coupled, end-to-end training. The resulting model achieves high accuracy and generalizes well across different scales, outperforming both pure data-driven and traditional PNM approaches. Gradient-based sensitivity analysis further reveals physically consistent feature influences, enhancing model interpretability. This approach offers a scalable and physically informed framework for permeability prediction in complex porous media, reducing model uncertainty and improving accuracy.}
}
@article{ZHANG2026135631,
title = {Depth-dependent controls on soil saturated hydraulic conductivity in the Loess Plateau},
journal = {Journal of Hydrology},
volume = {675},
pages = {135631},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135631},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007286},
author = {Pingping Zhang and Yunqiang Wang and Hui Sun and Ruijie Li and Jingxiong Zhou and Laiming Huang},
keywords = {Deep soil, Soil hydraulic properties, Pedotransfer function, Loess landscape, Watershed scale},
abstract = {Saturated hydraulic conductivity (Ks) is a critical parameter governing soil hydrological processes, yet most existing studies focus on upper soil layers (< 100 cm), the depth-dependent behavior of Ks in deep unsaturated soil (> 100 cm) is insufficiently characterized. This study investigated the vertical distribution, spatial variability, and controlling factors of Ks across 0–500 cm soil profiles in a small watershed on the Chinese Loess Plateau. Ks exhibited the highest values in the surface layer (0–5 cm) and decreased with depth, following power or parabolic functions (R2 = 0.58–0.71) depending on landscape unit. Ks differed significantly among landscape units, with values ranked as tableland ≥ slope land > gully land, and significantly higher values in tableland than slope land in the 200–500 cm layer (p < 0.05). Boosted regression tree analysis showed that soil properties dominated Ks variability across all depths (56.6%–79.4%), with bulk density and saturated soil water content as the most influential factors. In the upper 0–20 cm, topography and vegetation mainly influenced Ks indirectly via soil properties, while vegetation effects were more evident in the 5–20 cm layer. Below 20 cm, Ks was increasingly controlled by intrinsic soil characteristics, and vegetation effects weakened and became negligible below 200 cm. Although soil variables dominated model performance, incorporating topographic and vegetation variables generally improved predictions in deeper soils (> 20 cm), where they likely act as proxies for long-term geomorphic and pedogenic processes. These results highlight strong vertical heterogeneity in Ks and suggest that depth-explicit parameterization may improve hydrological modeling in loess regions.}
}
@article{ZHAO2026135526,
title = {A soil freezing characteristic model considering the tortuous structure and complex distribution of soil pores},
journal = {Journal of Hydrology},
volume = {675},
pages = {135526},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135526},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006232},
author = {Jianyuan Zhao and Shuangyang Li and Qi Jiang and Minqi Dong and Chun Bao and Shangqi Zhou and Huiyin Liu},
keywords = {Soil freezing characteristic curve, Particle size distribution, Pore size distribution, Log-normal distribution, Fractal theory},
abstract = {Unfrozen water content (UWC) significantly affects the hydro-thermo-mechanical behaviors of frozen soils and further affects hydrological processes and stability of engineering in cold regions. The UWC is strongly temperature-dependent and described by a soil freezing characteristic curve (SFCC), a fundamental hydraulic property of frozen soils. Numerous SFCC models have been established based on capillary theory, thermodynamic theories. However, most existing models idealize soil pores as bundles of cylindrical capillaries (BCC), which cannot adequately represent the tortuous pore geometry of natural soils, and the corresponding pore size distribution is often difficult to obtain experimentally. To address these limitations, a theoretical SFCC model, termed SFCC-FCPD, is developed by characterizing soil pores as fractal capillaries (FC) and deriving the cumulative pore distribution (PD) from the probability distribution of soil particles. The robustness of the SFCC-FCPD model was verified against measured data. The predicted results show good agreement with observations, with coefficients of determination R2 exceeding 0.95. In the SFCC-FCPD model, the cumulative distribution of pores is directly obtained from the probability distribution of soil particles, which avoids the time-consuming and laborious experiments. Moreover, the fractal theory is used to characterize irregular pore shapes, which makes the theoretical capillary close to the actual pore structures. Therefore, the SFCC-FCPD model exhibits excellent ability of predicting the UWC change in freezing soils, offering a critical insight into hydraulic characteristics in frozen soils as well as providing a key tool for the studying of hydrological, agricultural, engineering, and environmental studies in cold regions.}
}
@article{ZHANG2026135615,
title = {Young water proportion characteristics and influencing factors of large-scale basins: insights from long-term and high-frequency water sampling},
journal = {Journal of Hydrology},
volume = {675},
pages = {135615},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135615},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007122},
author = {Yong Zhang and Xinping Zhang and Xuhong Zhan and Chengcheng Xia and Jinzhao Liu and Zhiguo Rao and Xinguang He and Keshao Liu and Zhu Liu and Xiong Xiao},
keywords = {Stable isotopes, High-frequency sampling, Xiangjiang River Basin, Young water fraction, Sampling frequency},
abstract = {Climate change has increased extreme weather events, making understanding river response vital for water management. This study conducted a 15-year daily and 5-day sampling of precipitation and river water in Changsha from 2010 to 2025. By integrating in-situ isotopic measurements with hydrometeorological data from the Xiangjiang River Basin (XRB), isoGSM2-simulated precipitation, we applied multiple methods to estimate the young water fraction (Fyw) and assessed uncertainties. The results indicated that: (1) The XRB experienced warming and drying trends, leading to isotopically enriched river water due to enhanced evaporative fractionation within the basin storage water. (2) Our resampling experiment revealed that standard monthly sampling introduced over two-fold uncertainty in the estimations of Fyw compared to the 5-day sampling. Long-term high-frequency sampling is thus essential for constraining model uncertainty. (3) Influenced by precipitation, Fyw(Q) estimated for high-discharge intervals demonstrated higher accuracy (e.g., 90–95%, 95–100%, and Top 2.5%, with adjusted R2 of 0.66, 0.66, and 0.71, respectively). This result provided direct empirical evidence for an efficient young water transport process in the XRB during heavy precipitation events. (4) Global synthesis indicated that in humid monsoon regions, the Fyw is primarily driven by precipitation intensity. Short-duration heavy precipitation activates transient preferential flow pathways, allowing young water to bypass the large and older water storage in larger basins. This mechanism explains why, in large monsoon basins during wet years, the observed Fyw at a higher level than expected. Overall, this study identifies the impact of changes in hydrometeorological factors on Fyw within the XRB.}
}
@article{YUAN2026135603,
title = {Physics-informed extreme learning machine with time-marching and random features for unsaturated groundwater flow},
journal = {Journal of Hydrology},
volume = {675},
pages = {135603},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135603},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007006},
author = {Biao Yuan and Roberto Cudmani and Wei Yan and He Yang and Ana Heitor and Yanjie Song and Xiaohui Chen},
keywords = {Physics-informed machine learning, Extreme learning machine, Highly nonlinear PDEs, Unsaturated groundwater flow, Numerical modeling},
abstract = {Machine learning (ML) offers new opportunities for numerical modeling in engineering, yet purely data-driven approaches require large datasets and lack physical interpretability, while physics-informed neural networks (PINNs) often have high computational costs due to their gradient-based optimization. This study presents a Physics-Informed Extreme Learning Machine (PIELM) based on Time-Marching Strategy and Random Feature Method (TMS-RFM) to efficiently solve highly nonlinear unsaturated groundwater flow problems, namely TR-PIELM. Built upon shallow neural networks and physics-informed machine learning (PIML), TR-PIELM encodes the governing equations and initial-boundary conditions of unsaturated infiltration into the loss function, enabling both soft-constraint learning and hard boundary enforcement. Benchmark tests include 1D steady/transient flows, two-layer soil infiltration, coupled unsaturated infiltration and deformation, slope stability analysis, and 2D transient flows, demonstrating that TR-PIELM accurately captures pressure head dynamics. The results are compared with analytical or finite difference solutions. Quantitatively, TR-PIELM achieves up to 1010-fold reduction in relative L2 error compared with PINNs for steady problem and 102-fold reduction for transient problems, and attains accuracy comparable or even better than fourth-order Runge–Kutta (RK4) schemes while requiring significantly less computational time. Furthermore, the effects of key factors influencing model performance and potential improvement directions are discussed. This study highlights the method’s applicability to highly nonlinear PDEs in engineering, offering a fast, reliable, and scalable framework for simulating unsaturated seepage.}
}
@article{VILLA2026135627,
title = {Effects of temporary streamflow interruption on hyporheic oxygen dynamics},
journal = {Journal of Hydrology},
volume = {675},
pages = {135627},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135627},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007249},
author = {Alejandra Villa and Shai Arnon and Stephanie Spahr and Cara Beume and Jörg Lewandowski},
keywords = {Flow intermittency, Drying-rewetting disturbance, River metabolism, Planar optode imaging, Porewater sampling, Oxygen depth profiles},
abstract = {Short-term streamflow interruptions, i.e. brief recessions of surface water resulting in temporary drying of streams, are occurring more frequently nowadays due to climate change or water management operations. The impact of these streamflow disruptions on hyporheic oxygen dynamics and their legacy effect on stream metabolism remains unclear. This study aims to investigate the effects of a one-day streamflow interruption on oxygen patterns in surface water and the hyporheic zone by comparing conditions before and after the disturbance. We monitored oxygen concentrations in surface water and streambed sediment of a side channel of the River Erpe (Berlin, Germany) at different experimentally manipulated surface water velocities (0.1–0.5 ms−1) for five days before and fifteen days after the streamflow interruption. After rewetting, the diel amplitude of surface water oxygen concentrations decreased by 30% relative to pre-interruption conditions, and partially recovered within five days. Oxygen concentrations in deeper sediment layers were lower than before the interruption. This response pattern was observed across all surface water velocities (0.1–0.5 m s−1), and it was more pronounced at 0.4 and 0.1 ms−1. Three weeks after flow resumed, surface water and porewater oxygen concentrations remained around 2 mgL−1 lower than pre-interruption values. Five days after the disturbance, a gradual metabolic response was observed, with gross primary production and ecosystem respiration increasing in magnitude by 26% and 31%, respectively. These findings emphasize that short streamflow intermittency can trigger shifts in oxygen regimes and metabolism, and therefore needs to be accounted for in sustainable water management strategies.}
}
@article{NIU2026135647,
title = {Coordinated regulation of inter-basin water transfer projects and cascade reservoirs incorporating fairness and efficiency},
journal = {Journal of Hydrology},
volume = {675},
pages = {135647},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135647},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007444},
author = {Chen Niu and Jianxia Chang and Yimin Wang and Aijun Guo and Xuebin Wang and Zhehao Li},
keywords = {Fairness, Efficiency, Coordinated operation, Inter-basin water transfer, Yellow River Basin, South-to-North Water Transfer},
abstract = {Inter-basin water transfer (IBWT) projects represent one of the most effective approaches to alleviating water scarcity caused by the uneven spatiotemporal distribution of water resources. However, the long-term sustainability of these projects critically depends on scientific regulation. Beyond addressing the inherent trade-offs between fairness and efficiency, IBWT projects must be systematically coordinated with existing cascade reservoirs in the receiving basin, rather than functioning in isolation. To this end, this study develops a nested two-layer coordinated regulation framework that integrates fairness and efficiency for IBWT projects and cascade systems. This model is applied to Phase I of the South-to-North Water Transfer Western Route (SNWT-WI) in the Yellow River Basin (YRB). Three scenarios—Basic (without the SNWT-WI), SO (standalone operation), and CO (coordinated operation)—were established for comparative analysis. Compared to the SO scenario, the CO scenario demonstrates significant advantages in securing regional water supply. Although it involves minor trade-offs regarding in-stream ecology and total power generation, the CO water transfer process is substantially more flexible. This flexibility provides superior adaptability to hydrological variability and aligns more closely with the current socio-economic development demands of the YRB. Nevertheless, the augmented inflow from the SNWT-WI increases spillway discharge, presenting a new operational challenge for existing cascade hydroelectric stations. Overall, the proposed coordinated regulation model demonstrates broad applicability, offering valuable methodological insights for the sustainable management of large-scale IBWT projects worldwide.}
}
@article{XU2026135561,
title = {Including water-salinity stress hysteresis and compensation to empirical root water uptake models},
journal = {Journal of Hydrology},
volume = {675},
pages = {135561},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135561},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600658X},
author = {Yanqi Xu and Wanzi Hu and Qiang Zuo and Jianchu Shi and Yuchun Fan and Xun Wu and Alon Ben-Gal},
keywords = {Root distribution, Stress recovery, Transpiration, Numerical simulation, Feddes RWU, Soil water and salinity distribution},
abstract = {Root water uptake (RWU) is influenced not only by instantaneous soil conditions but also by two dynamic processes often neglected in models: stress hysteresis, arising from prior exposure to suboptimal water/salinity conditions, and compensation, whereby roots in favorable zones offset reduced uptake in zones less conducive to RWU. Empirical RWU models, such as the Feddes model (FM), are widely used but typically neglect these dynamic effects. Here, we extended FM by introducing a recovery coefficient to capture stress hysteresis and incorporating either a piecewise or continuous compensation function. Six models were tested: FM, single-process models WM (hysteresis), PM (piecewise compensation), and DM (continuous compensation); and combined-process models − WM-PM and WM-DM. Using data from a greenhouse soil column experiment with winter wheat, we found that both historical stress and spatial heterogeneity in root zone water and salinity strongly influence RWU and transpiration by plants. The coupled models (WM-PM, WM-DM) outperformed FM and single-process models in simulating transpiration dynamics, improving R2 by 10.1–12.9% and 3.8–29.7% for actual and relative transpiration, while reducing RMSE by 27.6–36.4% and 13.8–41.9%, respectively. The WM-DM showed the highest accuracy attributed to its compensation function incorporating soil hydraulic conductivity, matric potential, and osmotic potential. Coupled with the one-dimensional Richards and convection–dispersion equations, WM-DM successfully reproduced soil water and salinity dynamics in greenhouse soil column experiment and a two-year field study of a winter wheat–summer maize rotation. In addition, model robustness analysis showed that WM-DM exhibited limited sensitivity to most parameters, lower uncertainties for the salinity and recovery stress response parameters than for the water-deficit and compensation stress response parameters, and unavoidable parameter non-uniqueness under simultaneous optimization. These findings highlight the value of accounting for both stress hysteresis and compensation in empirical RWU models for improved irrigation scheduling and salinity management.}
}
@article{SUN2026135582,
title = {Machine learning models unravel contrasting enrichment of uranium and arsenic in groundwater from the Songnen Basin, China},
journal = {Journal of Hydrology},
volume = {675},
pages = {135582},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135582},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006797},
author = {Haowei Sun and Zhipeng Gao and Wengeng Cao and Xiaosi Su and Huaming Guo},
keywords = {Uranium, Arsenic, Groundwater, Random Forest model, Shapley additive explanations},
abstract = {The differential enrichment of uranium (U) and arsenic (As) in groundwater poses significant threats to drinking water safety and complicates water resource management. Although the contrasting geochemical behaviors of U and As in groundwater have been generally recognized, the key factors controlling their spatial distribution along a hydrogeochemical profile remain poorly quantified. This study combined hydrogeochemical analysis with an interpretable machine learning model to identify the dominant processes governing the differential distribution of U and As in groundwater of the Songnen Basin, China. Along the groundwater flow path, U concentrations decreased (from 31.8 to 0.37 μg/L), in contrast to the increasing trend of As levels (from 0.83 to 338 μg/L). This contrasting behavior was predicted using three different models (support vector regression, random forest, and extreme gradient boosting), among which the random forest model achieved the best performance. SHapley Additive exPlanations (SHAP) analysis furtheridentified NO3– and Ca2+ as the most influential factors for U enrichment in oxic-suboxic zones, indicating that U was mainly mobilized by NO3–-mediated U(IV) oxidation to U(VI), followed by the formation of highly soluble Ca-U-CO3 complexes. In contrast, the SHAP analysis revealed DOC, Fe(II), Mn2+, and HCO3– as the key drivers of As mobilization in anoxic zones, suggesting that As release was primarily governed by the reductive dissolution of As-bearing Fe/Mn oxides mediated by dissolved organic matter degradation, along with competitive adsorption by HCO3–. Anoxic conditions, characterized by negative ORP values and high Fe(II) and Mn2+ concentrations, facilitated the reduction of U(VI) to U(IV), thereby resulting in low dissolved U concentrations in the anoxic zones. This study provides a replicable framework for deciphering the contrasting behaviors of U and As in groundwater, thereby enabling the identification of safe drinking water sources with low concentrations of both U and As.}
}
@article{WU2026135642,
title = {A multi-AI framework for accurate characterization of preferential flow pathways using a field tracer experiment},
journal = {Journal of Hydrology},
volume = {675},
pages = {135642},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135642},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007390},
author = {Yanhao Wu and Haijian Xie and Mengcheng Zhang and Jiayi Hong and Mei Li and Jinzhong Wan and Tao Long and Shengtian Zhang},
keywords = {Preferential flow pathways, Generative adversarial network, Convolutional block attention module, Surrogate model, Data assimilation, Tracer experiment},
abstract = {Accurate identification of preferential flow pathways, which are high-conductivity zones in aquifers, is essential for effective groundwater remediation. However, conventional approaches face challenges in representing non-Gaussian heterogeneity of preferential flow pathways and are computationally expensive for parameter estimation. This study proposes a novel multi-AI inversion framework to achieve efficient characterization of preferential flow pathways. Firstly, spectral normalization was applied to a Wasserstein generative adversarial network (SNWGAN) to produce high-quality structural images for non-Gaussian preferential flow pathways representation. The SNWGAN was then used to generate prior datasets for the data assimilation (DA) algorithm. By coupling SNWGAN, the DA algorithm, and numerical models simulating groundwater flow and solute transport, the numerical model-based inversion framework (SNWGAN-DA) was established for preferential flow pathways inversion. This framework was validated using a field-scale tracer experiment conducted at a chemical industrial site in northeastern China. Subsequently, an attention-enhanced convolutional network model (AEANW) was developed as a surrogate for numerical models to address computational limitations. AEANW was integrated with SNWGAN and DA to form the surrogate model-based inversion framework (SNWGAN-AEANW-DA) for efficient preferential flow pathways inversion. Finally, based on the identified preferential flow pathways, a targeted remediation layout was designed for lead contamination in the study area. The results demonstrate strong concordance between preferential flow pathways identified by the surrogate model-based inversion framework and the numerical model-based inversion framework. Excellent agreement between simulated and observed tracer data confirms the reliability of the proposed approach. After training, the AEANW surrogate model requires only 0.2 s for a single prediction, improving computational efficiency by 99% compared to the numerical model. Based on the identification results, the designed remediation scheme reduced contaminant plume migration distance by 60.5% and total exceedance area by 78.3%. The findings present a promising technical pathway for the rapid assessment and precise remediation of groundwater contamination.}
}
@article{XIE2026135606,
title = {Event-based runoff-sediment response patterns and their driving mechanisms: a comparative study of typical watersheds on the Chinese Loess Plateau},
journal = {Journal of Hydrology},
volume = {675},
pages = {135606},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135606},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007031},
author = {Tianning Xie and Qin Liu and Chengshuai Liu and Gan Miao and Xiaoyu Li and Runxi Li and Kejia Wen and Caihong Hu},
keywords = {Individual flood events, MESH framework, Runoff-sediment relationship, Sediment transport, Hysteresis analysis, Loess Plateau},
abstract = {Significant variations in event-scale runoff-sediment response mechanisms across Loess Plateau watersheds introduce substantial forecasting uncertainties. This study developed the MESH framework—encompassing flood event identification, multi-dimensional characteristic extraction, and the integration of Spearman correlation, Random Forest, sediment rating curves (SRCs), and hysteresis analysis—to investigate 104 flood events in three typical watersheds on the Chinese Loess Plateau: Baijiachuan-Zhaoshiyao (BJC-ZSY), Wuqi (WQ), and Hongde (HD). Results show BJC-ZSY follows a “high-runoff, high-sediment” regime driven by rainfall, with sediment transport strongly correlated with peak discharge (r = 0.80). Conversely, WQ and HD exhibit “low-runoff, high-sediment” characteristics with low runoff efficiency but extreme sediment concentrations averaging 279.26 kg/m3 and 591.87 kg/m3, respectively. In these sediment-abundant areas, the dominant control on sediment yield modulus shifts from peak discharge to runoff depth. SRC analysis reveals that BJC-ZSY features a low coefficient and high exponent (a = 2.52, b = 0.68), suggesting limited supply but high transport efficiency, whereas HD shows a high coefficient and low exponent (a = 161.43, b = 0.33), indicating abundant supply but lower efficiency. Hysteresis analysis identifies a mixed-source transport model in HD driven by multiple erosion processes. In contrast, counter-clockwise loops dominate in BJC-ZSY (40.0%) and WQ (44.8%), suggesting a prevalence of distal sediment sources. These findings elucidate divergent runoff-sediment relationships and internal mechanisms across the Loess Plateau, providing a scientific basis for targeted regional soil and water conservation management and a robust analytical reference for other globally significant semi-arid regions facing severe erosion.}
}
@article{XIA2026135630,
title = {Arsenic cycling driven by hydrogeochemical-tidal coupling in a sandy subterranean estuary},
journal = {Journal of Hydrology},
volume = {675},
pages = {135630},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135630},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007274},
author = {Wenli Xia and Long Gao and Jiawei Liu and Yiqing Wang and Zijun Wu},
keywords = {Arsenic, Submarine groundwater discharge, Subterranean estuary, Tidal pumping, Reductive dissolution, Competitive adsorption},
abstract = {Submarine groundwater discharge (SGD) represents a significant but often poorly quantified pathway for terrestrial contaminants, such as arsenic (As), to the coastal ocean. This study investigates As dynamics in a subtropical sandy subterranean estuary (STE) located in Beihai, China. Our findings reveal that recirculated saline groundwater discharge (RSGD) dominates the seaward flux of As. Although dissolved As concentrations remain below the WHO guideline (<10 μg L−1) throughout the STE, the total SGD-derived As flux (0.25 ± 0.03 kg d−1) exceeds combined inputs from local rivers. The STE functions as both a filter and a conduit for As. Within the intertidal zone, the Upper Saline Plume (USP) facilitates seaward As transport from the mixing zone via tidal recirculation, while sediments at its base effectively remove terrestrially derived As through Fe-Si-As coprecipitation and adsorption onto iron oxides. Tidal pumping is the key driver, simultaneously intensifying the oxic conditions that enable this near-shore As sequestration and promoting seawater-groundwater exchange that sustains reducing conditions in deeper recirculation zones. In these anoxic zones, As mobility is regulated by Mn-oxide reductive dissolution and competitive anion exchange (notably with silicate and phosphate), which also controls As(III)/As(V) speciation. This work establishes STE as the dominant pathway for terrestrial As to the coastal ocean in this system. We propose a conceptual model that integrates tidal hydrodynamics with redox and adsorption geochemistry to explain As cycling in sandy STEs, providing a critical framework for predicting and managing As dynamics in vulnerable coastal systems worldwide.}
}
@article{BELL2026135517,
title = {Buffering of perennial flow and differential response of adjacent sub-catchments under a drying climate},
journal = {Journal of Hydrology},
volume = {675},
pages = {135517},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135517},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006141},
author = {Rose-Anne Bell and John Nikolaus Callow and Sarah A. Bourke},
keywords = {Streamflow, Rainfall, Hydrological transformation, Resilience, Changepoints},
abstract = {Rivers in the Southern Hemisphere mid-latitudes are particularly sensitive to climate-induced flow regime changes. Yet process-based studies on hydrological resilience under drying climates remain limited, especially at sub-catchment scales. This paper addresses these gaps through a hydrological analysis of three adjacent sub-catchments in southwest Western Australia’s high-rainfall forested region, which exhibit non-uniform responses to decreasing rainfall. The study area has experienced stepwise drying since the 1930–40s and 1960–70s with overall rainfall reductions of 10–28% at long-term gauges in surrounding catchments. To investigate streamflow responses and identify groundwater-mediated mechanisms buffering or sustaining perennial flow, we analysed long-term streamflow records and identified periods in the record where streams had undergone a hydrological change. To do this, we characterised dry season flow trends, identified statistical changepoints in rainfall and streamflow records, and analysed variations in streamflow yield (rainfall-runoff conversion) across hydrological seasons. Results reveal sustained streamflow decline across all sub-catchments amid rainfall reductions. However, while two streams transitioned to ephemeral and seasonally dry flow regimes (with statistical changepoints in 1975 and 2001), the third adjacent stream retained perennial flow, attributed to lower aridity and potentially landscape and hydrogeological features that enhance catchment storage and groundwater support. This work highlights subtle differences in climatic independence among adjacent sub-catchments, suggesting forms of hydrological resilience through groundwater buffering.}
}
@article{HUO2026135622,
title = {Robustness of correlation coefficient-based information criterion for characterizing short- and long-term dependence of hydroclimatic time series},
journal = {Journal of Hydrology},
volume = {675},
pages = {135622},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135622},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007195},
author = {Jingqun Huo and Yan-Fang Sang and Ping Xie and Vijay P. Singh},
keywords = {Hydroclimatic time series analysis, Dependence characteristics, Model order, Information entropy},
abstract = {Dependence amongst hydroclimatic processes is an inherent and important characteristic, and accurate determination of the optimal order of dependence models is required for describing hydroclimatic dependence characteristics, but it is a challenging issue. The coefficient-based information criterion (CCIC) was proposed for determining the optimal model order, however, its comparative advantage to other methods for handling short- as well as long-term dependence models has not been clarified. In this study, we first mathematically proved the asymptotical consistency of the CCIC method, and then systematically investigated the efficiency of determining the optimal order for both short- and long-term dependence models by seven methods, considering the influences of seven main factors and their interaction effects. Results of Monte-Carlo experiments and observed precipitation data analysis validated the higher accuracy of the CCIC method for determining the optimal model order compared to other six methods used widely, and also showed its robustness for handling both short-term and long-term dependence models. Comparatively, the AICc (Akaike Information Criterion with correction) and BIC (Bayesian Information Criterion) method gave acceptable order-determination accuracy; however, the HQIC (Hannan-Quinn Information Criterion), FPE (Final Prediction Error), AIC (Akaike Information Criterion), and SVD (singular value decomposition) methods exhibited low accuracy and are therefore not recommended. It is noted that the standard AICc method is theoretically suboptimal for handling symmetric moving average (SMA) models, due to the incompatibility of its bias-correction derivation with the SMA covariance structure. Consequently, the CCIC method is recommended for determining the optimal order of dependence models, however, the factors of data length, mean value, and signal-to-noise ratio of the hydroclimatic time series to be analyzed should be carefully checked and handled in practical applications of the method.}
}
@article{SHI2026135595,
title = {Snow phenology-guided regionalization for parameter optimization: enhancing runoff simulation in an alpine basin},
journal = {Journal of Hydrology},
volume = {675},
pages = {135595},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135595},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600692X},
author = {Yu Shi and Xiongpeng Tang and Zhanliang Zhu and Chao Gao and Xin Yin and Silong Zhang},
keywords = {Snow phenology, Parameter optimization, VIC model, Surrogate model, Alpine basin},
abstract = {Alpine basins are critical sources of freshwater for downstream regions, with their hydrology largely shaped by intricate snow dynamics. However, spatial snow heterogeneity challenges accurate runoff simulation in traditional hydrological models. This study aims to improve the runoff simulation accuracy of the Variable Infiltration Capacity (VIC) hydrological model in alpine basins by proposing a snow phenology-guided regional parameterization framework. The framework integrates remote sensing-based snow phenology data with PCA-K-means clustering for basin regionalization, introduces a spatially heterogeneous calibration strategy to enhance parameter representation, and constructs a surrogate model based on representative cells to reduce parameter dimensionality. The application in the Source Region of the Yellow River Basin (SYRB) demonstrated: (1) The regionalization method effectively identified three distinct snow phenology clusters. (2) The spatially heterogeneous calibration strategy outperformed the traditional approach, achieving a Nash-Sutcliffe efficiency (NSE) of 0.83 with a relative error (RE) of 8.59%, which represents a relative enhancement in dynamic simulation accuracy over the traditional baseline (NSE = 0.73, RE = 6.03%). A pronounced performance contrast was observed during snow seasons (Nov-Apr): NSE = 0.81, RE =  − 0.75% (baseline: NSE = 0.54, RE = 2.36%). (3) The surrogate modeling approach retained competitive performance during both the full period (NSE = 0.83, RE = 14.34%) and snow seasons (NSE = 0.68, RE = 13.16%) while significantly reducing parameter dimensionality. The framework provides an effective solution for enhancing runoff simulation capability in SYRB, yielding valuable insights into hydrological processes and offers insights for water‑resources management in similar regions globally.}
}
@article{EZECKIELHOUENAFA2026135597,
title = {GRHyMoLAP: A process-driven ODE catchment hydrology model inspired by GR4J and HyMoLAP approaches},
journal = {Journal of Hydrology},
volume = {675},
pages = {135597},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135597},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006943},
author = {Sianou {Ezéckiel Houénafa} and Melissa Latella and Lionel Cédric Gohouede and Cenk Sezen},
keywords = {Hydrological model, Ordinary differential equations, GR4J, HyMoLAP, GRHyMoLAP, Runoff ratio},
abstract = {Catchment hydrology can be represented using ordinary differential equations (ODEs), offering strong interpretability through a transparent and structured formulation. However, few ODE models, including the Hydrological Model based on the Least Action Principle (HyMoLAP), explicitly govern runoff evolution or fully leverage hydro-climatic inputs across diverse catchments. In this work, we introduce GRHyMoLAP, a process-driven, quasi-physical hybrid model with 4 parameters, that integrates the production store of the Génie Rural à 4 paramètres Journalier (GR4J) into the HyMoLAP framework, yielding an ODE formulation that replaces GR4J’s routine for simulating runoff dynamics. This integration produces a single, streamlined framework that eliminates the need for separate pre-simulations. Validated across 222 CAMELS-AUS and 671 CAMELS-US catchments, GRHyMoLAP consistently outperforms the original HyMoLAP in 98.6% and 97.2% of cases, respectively, reflecting its improved ability to balance immediate rainfall effects with internal catchment processes and deal with non-linearities. While average predictive accuracy is comparable to the GR4J and Hydrologiska Byråns Vattenbalansavdelning (HBV) models, GRHyMoLAP generally demonstrates enhanced robustness in low-performing catchments, under low-flow and extreme runoff ratio conditions, mainly due to its greater ability to capture recession dynamics. Sensitivity analysis using the Sobol method and uncertainty analysis within the Generalized Likelihood Uncertainty Estimation (GLUE) framework indicate that the parameters controlling recession shape (μ) and input scaling (γ) are the most influential. Owing to its distinctive formulation, GRHyMoLAP can serve as a complementary approach to HyMoLAP and GR4J. Moreover, its structure opens up opportunities for further developments, highlighting its potential as a versatile tool for water resources management.}
}
@article{LI2026135500,
title = {Systematic evaluation of atmospheric forcing, surface datasets, and mesh effects on kilometer-scale land surface and river modeling},
journal = {Journal of Hydrology},
volume = {675},
pages = {135500},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135500},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005974},
author = {Lingcheng Li and Gautam Bisht and Donghui Xu and Dalei Hao and Chang Liao and Dongyu Feng and Zeli Tan and Hongyi Li and Mingjie Shi and Tian Zhou and L. Ruby Leung},
keywords = {Kilometer-scale modeling, Land and river modeling, Model evaluation, Water, energy and carbon cycles},
abstract = {Earth system models are advancing toward kilometer-scale resolution to capture local climate impacts and extremes. High-resolution land and river modeling depends on multiple factors, including mesh, surface datasets, and atmospheric forcing, but their relative effects at kilometer scales remain unquantified. We evaluated five Energy Exascale Earth System Model land and river configurations over the Mid-Atlantic region using two meshes (1/8° structured versus variable-resolution unstructured mesh), two surface datasets (default versus newly developed), and three atmospheric forcings (NLDAS, MSWX, GSWP). Evaluation against satellite, reanalysis, and in situ benchmarks across water, energy, and carbon cycles quantifies how these factors affect model performance. Forcing selection produces the largest effects on simulations (12–99% of baseline bias change across variables), followed by surface datasets (5–75%) and mesh (up to 21%). Forcing effects vary by variable, with MSWX reducing biases for snow water equivalent, evapotranspiration, albedo, temperature, and gross primary productivity, GSWP for snow cover and runoff, and NLDAS for soil moisture and streamflow. The use of newly developed surface datasets improves gross primary productivity and evapotranspiration but increases soil moisture and albedo biases due to current modeling limitations. Variable-resolution unstructured mesh improves the simulation of small-basin streamflow through better capturing drainage networks, though mesh minimally affects other land variables. These findings provide important guidance for high-resolution modeling development and actionable science.}
}
@article{LI2026135573,
title = {A physics-informed multi-scale fourier neural operator framework for snow avalanche dynamics simulation},
journal = {Journal of Hydrology},
volume = {675},
pages = {135573},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135573},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006700},
author = {Xingkai Li and Yuanjun Jiang and Yu Zhuang and Xiaobo Hu and Binbin Zhao},
keywords = {Avalanche dynamics, Physics-informed neural operator, Shallow water equations, Near real-time risk assessment, Cross-terrain generalization},
abstract = {Avalanches are typical natural disasters in alpine watersheds. Near-real-time early warning and multi-scenario risk assessment require a balance between physical consistency and computational efficiency, yet traditional numerical solvers often suffer from severe computational bottlenecks in high-resolution simulations or large-scale scenario ensemble computations. To address this issue, this study proposes a Physics-Informed Neural Operator (PINO) framework for the efficient prediction of avalanche dynamic processes. The framework uses the Fourier Neural Operator as the backbone network and incorporates residual constraints of governing equations. By introducing architectural enhancements including dimensionless physical loss, a spatial feature extractor, and a channel attention mechanism, the model’s ability to learn complex avalanche evolution processes under varying terrain and physical parameters is significantly improved. Meanwhile, an active-region-prioritized sampling scheme and a progressive training strategy further enhance training efficiency. The model is trained and evaluated solely on 12 heterogeneous multi-scenario datasets generated by the RAMMS software. Results demonstrate that the model achieves relatively stable accuracy under cross-parameter and cross-terrain conditions, and its performance is significantly superior to traditional Physics-Informed Neural Networks (PINNs).Its zero-shot super-resolution performance also outperforms the standard FNO. Benchmark tests show that the inference time reaches the near-real-time level of seconds to tens of seconds, providing a feasible and novel paradigm for multi-scenario risk assessment and near-real-time prediction of avalanches and other shallow surface flow dynamic processes in alpine watersheds.}
}
@article{YAN2026135592,
title = {Prediction of urban stormwater runoff quality in data-deficient areas using a semi-supervised machine learning framework},
journal = {Journal of Hydrology},
volume = {675},
pages = {135592},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135592},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600689X},
author = {Haibin Yan and David Z. Zhu and Mark R. Loewen and Wenming Zhang and Bert van Duin and Khizar Mahmood},
keywords = {Semi-supervised machine learning, Random forest, Urban stormwater quality, Data-deficient, Pseudo-labeling},
abstract = {Urban stormwater quality modeling is essential for effective water resource management. Machine learning (ML) provides a powerful tool to capture the complex nonlinear interactions among rainfall, land use, and pollutant behavior, but its performance is often constrained by limited labeled data, defined here as rainfall events with observed event mean concentration (EMC) measurements. This study developed a semi-supervised Random Forest (RF) framework to improve stormwater quality prediction in data-deficient urban catchments by combining labeled data with abundant unlabeled data, referring to rainfall events for which input features are available but EMC observations are limited. Three supervised models (RF-M1, RF-M2, and RF-M3) were first constructed using different combinations of input variables and training datasets from multiple urban catchments to determine the optimal configuration. The best-performing supervised model (RF-M3) integrated multi-catchment datasets and catchment-specific variables, showing slightly reduced training accuracy but better validating and testing performance, demonstrating improved generalization and reduced overfitting. This model was then used to generate pseudo-labels for unlabeled data, forming the basis of the semi-supervised model (RF-Semi). Application to four urban catchments in Calgary, Canada, showed that RF-Semi achieved Nash–Sutcliffe efficiency (NSE) values of 0.85 and 0.62 for total suspended solids (TSS), 0.38 and –0.03 for total nitrogen (TN), and 0.68 and 0.62 for total phosphorus (TP) in the validation and testing datasets, respectively. By leveraging abundant rainfall data to enrich the training dataset, the semi-supervised framework effectively reduced dependence on labeled samples, and improved predictive performance under the studied conditions. Rainfall characteristics were consistently the most influential predictors. The proposed approach provides a practical solution for stormwater quality prediction in data-deficient areas under conditions similar to those examined areas in this study, with potential applicability to other regions where rainfall and catchment characteristics are comparable.}
}
@article{LU2026135658,
title = {Understanding of deep groundwater age characteristics in the Yangtze River Delta through the combined use of 14C and 81Kr},
journal = {Journal of Hydrology},
volume = {675},
pages = {135658},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135658},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007559},
author = {Shiang Lu and Zhaojun Xie and Xin Dai and Wei Jiang and Yueqing Xie and Andrew J. Love and Xulong Gong and Guo-Min Yang and Yan Zhang and Lei He and Zheng-Tian Lu and Rongbing Fu and Jichun Wu},
keywords = {Kr, C, Transit time distribution (TTD), Deep groundwater age, Yangtze River Delta},
abstract = {Assessing the replenishment potential of deep confined aquifers is essential for groundwater resource evaluation and management, yet remains challenging due to their concealed nature and hydrogeological heterogeneity. In this study, we integrate 14C and 81Kr dating with inverse-Gaussian transit time distribution (IG-TTD) modeling to quantify deep groundwater age characteristics in the Yangtze River Delta. For the first time, fossil groundwater up to 191 ± 12 ka was identified in Aquifer Ⅳ (>300 m, Neogene confined aquifer). Under the IG-TTD framework, the two Aquifer Ⅳ samples yielded one constrained solution (Γ = 44.2, Δ/Γ = 0.50) and one unresolved case, likely reflecting mixing dominated by an extremely old groundwater component, with contribution from a less old component. Together, these results suggest a substantial fossil-water component and highly limited replenishment in Aquifer Ⅳ. In contrast, Aquifer Ⅲ (150–350 m, Early Pleistocene confined aquifer) shows upper mean ages of 25.3–31.3 ka and relatively narrow TTDs (Δ/Γ = 0.24–0.44), indicating limited dispersion and an age structure consistent with previously reported late-Pleistocene recharge in the region. These findings provide the first direct evidence of exceptionally old groundwater in eastern China revealed by 81Kr and demonstrate that 14C-based apparent ages can remain valid where mixing is limited. More broadly, the combined use of IG-TTD and dual isotopes offers a robust framework for diagnosing age structure and assessing replenishment potential in deep aquifers, with important implications for both paleoclimate reconstruction and the sustainable management of fossil groundwater resources.}
}
@article{TANG2026135577,
title = {Enhancing large-scale streamflow prediction by coupling structural inductive bias with meta-learning},
journal = {Journal of Hydrology},
volume = {675},
pages = {135577},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135577},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006748},
author = {Xuan Tang and Yuting Zhao and Yuan Yu and MingRui Yu and Guanghua Qin and Hongxia Li},
keywords = {Streamflow prediction, Large-sample hydrology, Meta-learning, EA-LSTM, PUB},
abstract = {Deep learning has opened new opportunities for streamflow modeling, enabling the extraction of complex hydrological patterns from large-sample observations. However, large-scale streamflow prediction remains challenging, requiring robust generalization across diverse hydroclimatic conditions and reliable transfer to ungauged regions. To address these challenges, we propose a MAML-EA-LSTM framework that integrates Model-Agnostic Meta-Learning (MAML) with an entity-aware Long Short-Term Memory (EA-LSTM) architecture. The framework is evaluated using 468 basins from the CAMELS dataset. Results show that the proposed MAML-EA-LSTM achieves a mean Nash-Sutcliffe Efficiency (NSE) of 0.75, outperforming LSTM (0.70), EA-LSTM (0.69), MAML-LSTM (0.71), and the conceptual Sacramento Soil Moisture Accounting (SAC-SMA) model (0.57), with improvements observed in most basins. Reductions in both high-flow and low-flow bias further indicate enhanced predictive stability across contrasting hydrological conditions. Dominant attribute identification analysis shows that MAML-EA-LSTM also improves hydrological behavior learning, yielding an overall hit rate of 71.2%, higher than LSTM (43.6%), EA-LSTM (60.7%) and MAML-LSTM (51.5%). Transfer experiments under strictly spatially disjoint conditions further demonstrate stronger out-of-sample transferability in data-scarce basins. The proposed framework achieves an NSE of 0.553 with only one year of target-basin observations for fine-tuning. These findings indicate that the integration of structural inductive bias and meta-learning provides a promising pathway toward more robust and transferable large-sample hydrological modeling.}
}
@article{CHAI2026135496,
title = {Combining multiple groundwater hydrograph analyses to characterize aquifer dynamics and drivers in complex hydrogeological settings},
journal = {Journal of Hydrology},
volume = {675},
pages = {135496},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135496},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005937},
author = {Z. Chai and N.K. LeRoux and R.C. Jamieson and A.M.R. Hill and L.D. Somers and B.L. Kurylyk},
keywords = {Groundwater recharge, Groundwater levels, Aquifer characterization, Hydrograph classification, Groundwater elevation, Water table fluctuation},
abstract = {Groundwater level fluctuations reveal key aspects of aquifer behavior, including recharge timing, storage dynamics, and sensitivity to hydroclimatic forcing. However, in geologically heterogeneous and seasonally variable regions, interpreting these fluctuations remains challenging, and we lack standard approaches for characterizing aquifers based on groundwater hydrographs. In this study, we analyzed 13 years (2011–2023) of daily groundwater level data from 40 provincial observation wells across Nova Scotia, Canada, to characterize spatial and temporal groundwater dynamics. We extracted 17 hydrograph-derived indices for characterizing the hydrographs and aquifers and apply time series decomposition to quantify the magnitude, frequency, and timing of groundwater fluctuations. Most wells exhibited consistent seasonal patterns, with a median annual level range of 0.7 m and a dominant periodicity near 365 days. Seasonal components accounted for an average of 54% of the total variance and were the primary mode of variability in 80% of wells. The timing of annual groundwater maxima clustered in either spring or autumn–winter, depending on whether recharge was predominantly snowmelt- or rainfall-driven. Hydrograph clustering revealed four behavioral groups linked to differences in geology, depth, and precipitation responsiveness. Recharge estimation using the water table fluctuation method was applied to 14 seasonally dynamic wells, yielding mean annual recharge rates of 180–250 mm/year. Winter/early-spring recharge (January–April) accounted for 40% of annual recharge but only 32% of annual precipitation, indicating higher cold-season recharge efficiency. These findings demonstrate the efficacy of hydrograph-based analysis for understanding aquifer function and seasonal recharge dynamics across complex hydrogeological settings with changing snow-rain partitioning.}
}
@article{LI2026135585,
title = {Temporal scale dictates the dominant driver of lake dynamics on the Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {675},
pages = {135585},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135585},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006827},
author = {Ting Li and Yuanwei Wang and Lingxiao Wang and Lei Wang and Jing Zhou and Xiaoyu Guo and Jie Xu and Chenhao Chai and Zhaoyan Xie and Sichen Lin and Shiqi Ao and Xingjiao Zhang and Lin Zhao},
keywords = {Inner Tibetan Plateau, Lake dynamics, Temporal scale, Driving factors, SHAP analysis},
abstract = {The Tibetan Plateau (TP), widely known as the “Third Pole” and “Asian Water Tower”, hosts lakes that act as crucial indicators of climate change. While most TP lakes have expanded significantly in recent decades, gaps in high-temporal-resolution data and unclear scale-dependent driving mechanisms remain. Focusing on inner TP (ITP) lakes during 1972–2021, we used the self-attention-based imputation for time series (SAITS) deep-learning model to fill remote-sensing data gaps, Shapley additive explanation (SHAP) analysis to quantify factor contributions, and the Mann‒Kendall test to detect trend breakpoints. Results show the total ITP lake area increased from 2.69 × 104 to 3.66 × 104 km2 (36% growth) over 50 years: it remained relatively stable in 1972–1995, and entered a phase of marked expansion from 1996 (a breakpoint for annual mean area identified by Mann‒Kendall test), and slowed after 2006 (a 2006 breakpoint for October area). Two large lakes—Selin Co and Ayakkum Lake—saw the largest area increases, exceeding 300 km2 (+738 km2 and + 520 km2 respectively). A total of 433 new lakes formed over the period, with a combined area of 1255 km2 (accounting for 12.4% of total ITP lake expansion), mostly concentrated in northern ITP. Notably, temporal scale dictates the dominant drivers of lake dynamics: subsurface runoff dominates at the monthly scale (with positive SHAP contributions when subsurface runoff > 10 mm), while energy factors (e.g., downward surface thermal radiation) are the primary drivers at the annual scale. This study clarifies the multi-scale mechanisms of ITP lake dynamics, providing robust data support for regional water resource management.}
}
@article{CHENG2026135674,
title = {Study on water infiltration characteristics of surface cracks in shallow-buried tunnels in loess tableland areas},
journal = {Journal of Hydrology},
volume = {675},
pages = {135674},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135674},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007717},
author = {Xiaodong Cheng and Qiuyang Hong and Deiyi Wu and Guodong Shi and Yang Zhou},
keywords = {Loess, Surface cracks, Water infiltration, In-situ test, Numerical calculation},
abstract = {Differential settlement above shallow-buried loess tunnels frequently induces surface longitudinal cracks. During rainfall events, these fractures serve as preferential flow paths, fundamentally altering the intrinsic infiltration characteristics of the loess matrix. This study elucidates the infiltration mechanisms associated with construction-induced surface cracks in loess tableland regions via an integrated approach comprising in-situ ponding tests, laboratory experiments, and numerical simulations. The findings reveal that the infiltration process is governed by a synergistic interplay between fracture aperture, hydraulic head, rainfall intensity, and matrix permeability. When rainfall intensity exceeds the saturated hydraulic conductivity of the loess, the resulting surface ponding triggers a transition to preferential flow. For narrower fractures infiltration is primarily dominated by piston flow, as the effective flow path is restricted by fine-particle migration and matric swelling. As the aperture increases—typically within the 2–8 mm range—the flow regime transitions toward fingering or mixed piston-fingered flow. In contrast, macro-fractures exceeding 8 mm facilitate rapid, deep-seated preferential infiltration, bypassing the matrix. Furthermore, the upper 1 m of the soil profile exhibits high sensitivity to evaporation, characterized by a “spiral downward” moisture oscillation with alternating phases of depletion and recovery. These insights provide a robust theoretical framework for the risk assessment and mitigation of water-induced hazards in loess tunnel engineering.}
}
@article{ZHOU2026135610,
title = {Weight-optimized fusion of satellite precipitation over the Qinghai-Tibet Plateau: Comparison of machine learning approaches},
journal = {Journal of Hydrology},
volume = {675},
pages = {135610},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135610},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007079},
author = {Li Zhou and Chun Zhou and Zhongshun Gu and Yinan Guo and Ting Chen and Xiaojun Guo and Juan Du and Jiajia Yue and Keying Liu and Lingling Wu and Jingyuan Xue},
keywords = {Qinghai-Tibet Plateau, Satellite precipitation, Precipitation fusion, Machine learning},
abstract = {Precipitation estimation over the Qinghai-Tibet Plateau (QTP) is challenging due to strong spatial heterogeneity under climate change. Using ground observations as reference, we fused the Global Satellite Mapping of Precipitation (GSMaP) and the Integrated Multi-satellite Retrievals for the Global Precipitation Measurement mission (IMERG) products with auxiliary predictors (Digital Elevation Model (DEM), soil moisture, and land surface temperature) to develop four widely used machine-learning fusion models (Artificial Neural Network (ANN), Random Forest (RF), Long Short-Term Memory (LSTM) and Transformer), and further incorporated an intensity- and error-adaptive weighted mean squared error (WMSE) loss into all four fusion models as an explicit sample-reweighting strategy. The results demonstrate that WMSE-based weighting generally improved fusion performance relative to both the original satellite products and the corresponding unweighted baselines, with the most consistent gains appearing in precipitation-event detection. For RF, LSTM, and Transformer, POD increased by 13.8–30.0% and CSI by 12.1–19.1%, while FAR decreased by 1.5–3.2%. The improvement was rainfall-intensity dependent, with the most stable gains occurring for light-to-moderate precipitation, whereas stronger rainfall showed larger model-dependent variability associated with sample scarcity and the POD-FAR trade-off. Across elevation bands, the fusion models remained robust, and WMSE helped mitigate underestimation at high elevations. In addition, the weighted fusion models better reproduced the southeast–northwest precipitation gradient across the QTP than the satellite-only estimates. Overall, the WMSE-based fusion framework provides a practical strategy for precipitation estimation over complex high-altitude terrain.}
}
@article{HU2026135646,
title = {The hidden buffering: How carbonate geology and sediments suppress CO2 emissions from reservoirs},
journal = {Journal of Hydrology},
volume = {675},
pages = {135646},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135646},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007432},
author = {Xuan Hu and Wanfa Wang and Xixi Lu and Hongkai Qi and Amit Kumar and Dengming He and Shijun Tu and Yufei Bao and Jie Zeng and Qixin Wu and Hao Xia and Yuchun Wang and Si-Liang Li},
keywords = {Lancang river, Cascade reservoirs, Stable carbon isotopes, Carbonate buffering, High suspended sediment concentration, CO emissions},
abstract = {Research on carbon cycling in Qinghai–Tibet Plateau rivers has attracted considerable attention. However, the role of carbonate buffering in regulating carbon dioxide (CO2) dynamics within cascade reservoirs remains poorly understood, particularly in plateau regions characterized by carbonate-rich geology and high suspended sediment concentration (SSC). In carbonate-enriched sediments, carbonate buffering prolongs the equilibration timescales of both partial pressure of CO2 (pCO2) and stable isotopic composition of dissolved inorganic carbon (δ13CDIC) with the atmosphere by ∼10-fold and ∼100-fold, respectively, compared to non-buffered scenarios. Over extended timescales, water-carbonate interactions effectively limit the evasion of metabolically produced CO2 in cascade reservoirs of the Lancang River, reducing CO2 emissions flux (FCO2) by 24.4%. This buffering effect is particularly pronounced in the hypolimnion, where increased carbonate dissolution occurs, and remains sustained in the outflows. Globally, carbonate-dominated reservoirs with high SSC exhibit 82% lower FCO2 than those with low SSC, demonstrating that suspended sediments critically amplify carbonate buffering’s suppression of CO2 emissions. These findings highlight the necessity of incorporating coupled geological and sedimentary processes into global carbon budgets and climate assessments, particularly in high-altitude regions.}
}
@article{WANG2026135614,
title = {Rainfall intensity and slope gradient interact to control runoff carbon–nitrogen losses and DOC–TN coupling},
journal = {Journal of Hydrology},
volume = {675},
pages = {135614},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135614},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007110},
author = {Xiang Wang and Yanmin Zhao and Guoxian Huang and Wei Chen and Sichen Tong and Xiangzhou Xu and Dongfang Liang and Gang Zhou and Yuxi Nie and Yonghui Song},
keywords = {Rainfall intensity, Slope gradient, Dissolved organic carbon (DOC), Total nitrogen (TN), Nutrient coupling, Transport limitation},
abstract = {Rainfall intensity (I) and slope gradient (G) control carbon and nitrogen export from sloping farmlands, yet their interactive effects on dissolved organic carbon (DOC) and total nitrogen (TN) coupling are rarely quantified. Indoor rainfall simulations were conducted on sloping farmland developed on sandy-textured yellow soil using a full-factorial design (I = 40, 60, 90 mm h–1; G = 6°, 12°, 18°). Result show that runoff depth increased with I but decreased with G: on the G18, runoff depth at I90 was 2.7 times that at I40, and at I40 runoff depth at G18 was 37% lower than at G6. Two-way ANOVA showed a statistically significant I × G interaction for DOC concentration (p < 0.05), whereas TN export was mainly controlled by I. DOC export increased monotonically with I on G6 but peaked at I60 on G12–18, while runoff TN export showed an apparent optimum at I60 and TN concentrations exhibited an early-event peak. DOC–TN coupling was quantified using within-treatment DOC–TN regressions with BH–FDR adjusted q-values: G6 remained decoupled (q = 0.245–0.730; R2 ≤ 0.048); G12 showed significant positive coupling at I60–90 (q = 0.015–0.011; R2 = 0.193–0.212); and G18 showed only marginal coupling at I90 (q = 0.0519; R2 = 0.128). These results provide quantitative, state-based diagnostics of DOC–TN couplingthat go beyondstudies focusing on individual components. Therefore, different mitigation strategies are proposed for sandy-textured yellow-soil sloping farmland under comparable storm intensities: fertilizer timing should be optimized on gentle slopes, vegetated buffers should be installed at slope toes on moderate slopes, and surface protection and contour measures should be prioritized on steep slopes.}
}
@article{ASIF2026135601,
title = {Convolutional neural network model for rapid prediction of urban flash flood water depth and velocity maps},
journal = {Journal of Hydrology},
volume = {675},
pages = {135601},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135601},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006980},
author = {Muhammad Asif and Roberto Bentivoglio and Raffaele Albano},
keywords = {Convolutional neural network, Urban flash flood, Water depths maps, Flow velocities prediction, Deep learning},
abstract = {Urbanization and climate change have intensified the need for rapid and accurate predictions of flash floods, especially in urban areas. Although numerical models produce accurate predictions, their computational cost makes them impractical for real-time simulations. Several machine learning models have been proposed as surrogates for such applications. However, most models focus only on predicting water depths and have little insight into the required variety and amount of data to train such models. In this study, we present a Convolutional Neural Network (CNN) surrogate model designed to predict both water depths and flow velocities for urban pluvial flooding, using as inputs a rainfall hyetograph and seven hydro-morphological descriptors, such as aspect, curvature, slope, Manning’s roughness coefficient, topographic wetness index, flow accumulation, and digital terrain model. To train and test our approach, we considered a dataset of numerical simulations carried out using a 2D shallow-water hydrodynamic modeling in the city of Matera, Italy. For the physical-based simulations, we considered several rainfall hyetographs, either obtained from real events or derived from design scenarios for different return periods, and simulated the associated pluvial floods propagation extracting as outputs the corresponding maps of the maximum envelope of the water depths and flow velocities. The CNN model obtained a testing 0.37 cm mean absolute error (MAE), 1.7 cm root mean squared error (RMSE), and 0.80 critical success index (CSI) for water depth predictions, and 0.054 m/s MAE, 0.178 m/s RMSE, and 0.84 CSI for flow velocity predictions. The CNN model was 116.5 times faster than the physically-based hydrodynamic model using the same computational hardware. We also analyzed the effect of different combinations of rainfall events to train and validate the CNN model, showing that it benefits from a balanced dataset in terms of different return periods and presence of both synthetic and real hyetographs. We then employed the model to extrapolate urban flooding for higher return periods (200, 300, 500, and 1000 years), showing that the model can predict well severe extreme events, as highlighted by a high correlation between predicted maximum water volumes and total rainfall. This study contributes to the practical usability of deep learning models by providing essential support for real-time or low lead-time urban flash flood predictions, which are crucial for effective early warning and emergency management.}
}
@article{LIU2026135581,
title = {Surface water-groundwater interaction and its hydrogeochemical implications at northern foothills of the Qinling Mountains, China: New insights from the Heihe River Basin},
journal = {Journal of Hydrology},
volume = {675},
pages = {135581},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135581},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006785},
author = {Yuan Liu and Panpan Xu and Hui Qian and Jianbing Peng and Yanjun Shen and Jun Ma and Qiming Wang},
keywords = {Surface water-groundwater interaction, Interruption-reflow process, Hydrogeochemical implication, Isotope, Qinling Mountains},
abstract = {The complexity of surface water–groundwater interactions and their hydrogeochemical implications poses challenges to the stability of mountain–plain coupled systems. Taking the Heihe River Basin at the northern foothills of the Qinling Mountains in China as a case study, this study elucidates the evolution of the hydrochemical environment, water interactions and associated process chains using integrated hydrochemical and isotopic techniques. The results indicate that both surface water and groundwater are predominantly of the HCO3-Ca type. Their chemical compositions are primarily controlled by anthropogenic activities rather than natural factors, with contributions of 43.51% vs. 35.50% for surface water and 41.60% vs. 33.99% for groundwater, indicating strong hydraulic connectivity between them. In mountainous areas, 98.1% of surface water is recharged by low-mineralization bedrock fracture water, sustaining wetlands, aquatic germplasm resources and drinking water protection zones. Due to the unique hydrological pattern of flow interruption-recovery in the Heihe River, the plain system can be divided into runoff, waterless, reflow and confluence zones. In the runoff zone, which represents the transition from bedrock mountainous areas to the alluvial fan, surface water recharges groundwater (58.69%), accompanied by CO2 absorption. In the waterless zone, complete infiltration of surface water leads to strong dilution effects and loss of aquatic habitats. In the reflow zone, surface water originates entirely from groundwater discharge, with simultaneous CO2 release and notable impacts from agricultural infiltration and sewage inputs. In the confluence zone, surface water again recharges groundwater (58.35%), with anthropogenic activities exerting more pronounced influences. These findings advance the understanding of hydrological processes and their hydrogeochemical implications in mountain–plain coupled systems.}
}
@article{WU2026135605,
title = {Hundred-year changes in water and sediment in the Inner Mongolia reach of the Yellow River: trend transitions, driving mechanisms, and attribution quantification},
journal = {Journal of Hydrology},
volume = {675},
pages = {135605},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135605},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600702X},
author = {Jiatao Wu and Xiaomin Liu and Tingxi Liu and Anjun Deng and Hai Huang},
keywords = {Inner Mongolia reach of the Yellow River, Water–sediment relationship, Driving mechanism, Cascade reservoir},
abstract = {Under the combined effects of climate change and human activities, the water–sediment processes in the Yellow River Basin demonstrate significant evolutionary characteristics. Based on long-series hydrological and sediment data from the Inner Mongolia reach of the Yellow River collected between 1919 and 2024, this article investigates the water–sediment relationship using trend-sudden change-cycle identification and segmental diagnosis methods. Combined with data on reservoir construction and operation, land use, and vegetation index, it analyses the mechanisms driving changes at different phases and quantifies the contribution rate of each factor. The results obtained include: (1) Runoff and sediment transport on a centennial scale generally exhibited a significant decreasing trend (p < 0.01). Compared with the high flow and sediment period P2 (1933–1967), the average annual runoff at various stations during the multi-reservoir coordinated operation period P6 (2014–2024) decreased by 7.0–28.6%, while sediment transport decreased by 62.7–90.7%, with an even more significant reduction during the flood season. (2) The runoff volume changed abruptly in 1933, 1969, and 1986, and an additional abrupt change in sediment transport occurred in 2000, which coincided with the construction period of upstream hydraulic engineering. A cycle analysis showed that there were 38a, 14a, and 7a cycles in the runoff, while the sediment transport presented multi-scale fluctuation characteristics of 2-4a, 7-14a, 22-24a, and 46a. (3) The water–sediment relationship underwent a significant transition from a natural dominant phase (P1, P2) to a phase driven by both human activities and climate after 1968. Subsequently, human activities became the major factor influencing the modern water–sediment process, with contributions of more than 55% to runoff and more than 79% to sediment transport. (4) The construction of cascade reservoirs had a significantly stronger effect on sediment transport (mainly during the flood season) than on runoff. From 1980 to 2020, the expansion of forest land (+10.8%) and grassland (+1.3%) contributed to sediment reduction. On the other hand, the expansion of construction land (+37.1%) and the continuous increase in the Normalized Difference Vegetation Index (NDVI) (0.026/10a) led to an increase in evapotranspiration and ecological water use, which became significant factors in runoff reduction. This study reveals the driving mechanisms of water–sediment changes in the Inner Mongolia reach from both long-term and multi-phase perspectives. These results may serve as a quantitative reference for the water–sediment regulation and ecological protection of the Yellow River basin.}
}
@article{WANG2026135626,
title = {Efficiency of emulsion flooding for the removal of organic pollutants from soils: A pore-scale study on the effects of oil volume fraction, injection flow rate, and wettability},
journal = {Journal of Hydrology},
volume = {675},
pages = {135626},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135626},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007237},
author = {Shuxin Wang and Antonio {Rodriguez de Castro} and Fernando Leal-Calderon and Azita Ahmadi-Senichault and Abdelaziz Omari},
keywords = {Emulsion flooding, Pore-scale experiments, Microfluidics, Multiphase flow, Soil remediation},
abstract = {Emulsion flooding (EF) is a promising in situ strategy for remediating aquifers contaminated with organic pollutants, yet the pore-scale mechanisms driving its efficiency remain unclear. This study investigates EF at the pore scale using calibrated oil-in-water emulsions in micromodels mimicking pollutant infiltration and removal. The analysis systematically examines how emulsion oil volume fraction ϕ, injection flow rate, and micromodel wettability influence pollutant removal and shape the morphology and connectivity of trapped pollutant ganglia, offering a pore-scale insight largely absent from previous EF investigations. Shear-thinning emulsions with sub-pore droplets achieve ∼ 97% recovery at ϕ = 0.72 by combining piston-like displacement with progressive mobilization and fragmentation of residual blobs, a mechanism not observed in low-viscosity Newtonian emulsions (ϕ ≤ 0.45), which mainly follow water-saturated channels and exhibit poor sweeping efficiency. Wettability strongly influenced recovery by controlling initial pollutant distribution, connectivity, and pore wall coatings; in oil-wet micromodels, highly connected pollutant ganglia restricted the flow of low-concentrated emulsions. During EF, the average size of pollutant-containing pores decreased in water-wet systems, whereas in oil-wet systems, large pollutant islands were eroded with little pore-size selectivity, highlighting the role of pore structure and wettability in optimizing emulsion-based remediation. Residual pollutant blobs aligned mostly perpendicular to flow at maximum recovery, defining a limit for mechanical displacement of the pollutant. Higher injection rates enhanced pollutant mobilization, while excessive emulsion viscosity increased injection pressure, suggesting potential limits for operational feasibility. These findings provide physics-based guidance for optimizing EF operational parameters and underscore its potential for efficient aquifer remediation.}
}
@article{MOTLAGH2026135618,
title = {Computer vision-based monitoring of stormwater discharge: proof-of-concept for stage measurements},
journal = {Journal of Hydrology},
volume = {675},
pages = {135618},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135618},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007158},
author = {Mohammad Nooshzadi Motlagh and Sierra Young and Kenneth Chapman and Evelynn Wilcox and François Birgand},
keywords = {Stormwater, Deep Learning, Computer Vision, Visual Measurement, Water Stage},
abstract = {Stormwater systems serve as critical urban drainage infrastructure, maintaining municipal functionality and playing key hydrological and environmental roles. Yet, stormwater outlets are not designed for stormflow monitoring, making traditional contact-based sensors unsuitable for gauging highly variable and turbulent flows. To address this, we propose a computer vision approach that quantifies discharge from near-range images and videos of the outlet. Given the challenges of applying traditional computer vision in natural environments with variable lighting and environmental noise, our method employs a combination of machine learning and computer vision (CV-ML) techniques, leveraging the recognizable geometrical shape of culverts in otherwise very noisy images. Specifically, water stage is obtained through subtracting the extracted shape of the round culvert from the height of empty area above water. Subsequently, image-based measurements are transformed into real-world units by applying a homography transformation calibrated using a checkerboard reference object placed parallel to the outlet. Performance evaluation on a culvert of known dimensions demonstrated ± 1 cm accuracy in approximately 80% of measurements. For water stages evaluated under calm, moderately and turbulent flows, the method estimated, respectively, more than 80% of stages within ± 0.5 cm, more than 80% of stage values within ± 0.75 cm, and 63% of values within ± 1 cm (96% within ± 2 cm). These results show great promise in the use of image-based techniques in difficult and turbulent conditions where no traditional techniques are applicable. They are also the prerequisite for estimations of discharge, for which more work is necessary, and on-going.}
}