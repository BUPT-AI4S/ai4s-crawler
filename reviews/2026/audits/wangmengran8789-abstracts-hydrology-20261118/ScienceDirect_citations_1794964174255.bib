@article{ZHONG2026136540,
title = {A large-scale molecular dynamics investigation of anisotropic hydraulic conductivity in compacted clay system},
journal = {Journal of Hydrology},
volume = {680},
pages = {136540},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136540},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016379},
author = {Yu Zhong and Annan Zhou and Jiapei Du and Ali Zaoui},
keywords = {Hydraulic conductivity, Anisotropy, Dry density, Orientational order parameter, Cation exchange capacity, Molecular dynamics simulation},
abstract = {This study developed a large-scale molecular dynamics framework to investigate anisotropic hydraulic conductivity by linking directional water transport to compaction state, platelet fabric, and surface chemistry. A total of 150 multi-particle nanoflow models were constructed across dry densities (ρd) of 1.2–1.8 g·cm−3, orientational order parameters (S) of 0.60 to 0.92, and cation exchange capacities (CEC) of 0.11–97.44 cmol·kg−1. Simulated hydraulic conductivities ranged from 0.77 × 10-14 to 1.96 × 10-12 m·s−1, with 97.0% of available experimental measurements falling within this envelope. Mean horizontal hydraulic conductivity (kh) consistently exceeded mean vertical hydraulic conductivity (kv) by factors of approximately 2.4–5.6. Increasing dry density narrowed water-accessible pores, reduced independent spanning pathways and critical spanning diameters, and increased tortuosity, thereby decreasing both kh and kv. Platelet orientation differentiated the two flow directions by maintaining more direct horizontal pathways. Increasing CEC shifted pore water toward Na associated states and reduced the flux carried by interfacial only and free water, further lowering both kh and kv. Random Forest models achieved mean testing R2 values of 0.92 for kh and 0.88 for kv and identified dry density as the dominant descriptor in both directions. Platelet orientation had a greater relative influence on vertical than horizontal conductivity, whereas CEC made a smaller but consistent contribution. Fixed-density sensitivity analysis showed that increasing dry density shifted the relative sensitivity weight from platelet orientation toward CEC, particularly for kv. These findings clarify the distinct structural and physicochemical controls on directional water transport and hydraulic anisotropy in compacted clay barriers.}
}
@article{KETHAVATH2026136516,
title = {Aquifer settings and interflow dynamics across continental flood basalts: A synthesis of hydro-geophysical evidence},
journal = {Journal of Hydrology},
volume = {680},
pages = {136516},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136516},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016136},
author = {Lohithkumar Kethavath and Sahebrao Sonkamble and Madhusudan Rao},
keywords = {Continental flood basalts, Aquifer dynamics, Electrical resistivity method, Hydrogeological characterization, Groundwater modelling, DVP India},
abstract = {Continental flood basalts (CFBs), spanning over ∼75,000 line-km globally, offer exceptional opportunities to advance the understanding of aquifer settings and interflow dynamics across their margins, where distinct stratigraphic heterogeneity, variable weathering, fracturing, and complex hydrochemical processes create a dynamic and diverse hydroenvironment. This study applies an integrated hydro-geophysical methodology to characterize aquifer settings and dynamics along ∼115 line-km lateral margin of basalt-granite (B-G) in the Deccan Volcanic Province (DVP). Electrical resistivity tomography (ERT) with forward simulations was utilised to construct detailed litho-hydrogeological models, while steady-state numerical modelling quantified aquifer dynamics. The laterally constrained inversion (LCI) of ERT data enabled sharper delineation of the B-G vertical contact (nonconformity) by clearly distinguishing the low-resistive (10–200 Ωm) ferromagnesium-rich basaltic flow from the underlying high-resistive (>1000 Ωm) quartz-feldspar-rich granitic base. These geophysically derived layers were incorporated into numerical groundwater modelling to understand strata-specific aquifer dynamics. The resulting annual discharge (Q) estimates for basalt (QB = 273 MCM), B-G contact (QB-G = 580 MCM), and granite (QG = 296 MCM) aquifers revealed the order QB-G > QG > QB, indicating a preferential flow path and higher aquifer potentiality of the B-G contact. Hydrochemical evaluation across the B-G contact reveals mixed facies confirming dissolution of both basaltic and granitic minerals. Synthesizing the multidisciplinary approach, this study significantly reduces the inherent ambiguities of aquifers across B-G contact by quantitatively demonstrating the hydraulic dominance of the B-G contact and offers an adaptable framework with methodological insights and quantitative evidences for future comparative studies across CFBs worldwide.}
}
@article{ZHAO2026136568,
title = {Quantifying dynamic ponding–detention effects of microtopography in low-relief plains: insights from field-scale hydrological monitoring},
journal = {Journal of Hydrology},
volume = {680},
pages = {136568},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136568},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016653},
author = {Pengxuan Zhao and Gang Chen and Chuanhai Wang and Pingnan Zhang and Reinhard Hinkelmann and Jiale Gao and Yixiao Qian},
keywords = {Low-relief plains, Microtopography, Field hydrological monitoring, Hydrological connectivity, Ponding–detention effects, Hydrological model},
abstract = {Microtopography in low-relief plains exerts significant regulatory influences on surface hydrological responses. Yet its chaotic and nested configuration gives rise to highly dynamic ponding–detention processes that remain poorly understood. Based on field hydrological monitoring, this study proposed a process-based framework for quantifying microtopographic ponding–detention effects, comprising an elementary microtopographic unit (EMU)-based representation of hydrological connectivity, a microtopographic detention curve (MDC), and a microtopography-informed hydrological model (MIHM). The framework was evaluated using eighteen rainfall–runoff observations from two experimental plots together with high-resolution topographic data from seven representative sites. The EMU-based representation transformed intricate microtopographic configurations into an ordered topological network, enabling explicit characterization of the complex evolution of hydrological connectivity and ponding–detention processes. It reduced the number of units required for connectivity analysis by approximately one to two orders of magnitude while preserving the hierarchical organization of microtopography. The MDC effectively captured the nonlinear ponding–detention relationship, with mean R2 of 0.990 across seven study sites and 0.965 across 213 river-network polygons in the Taihu Basin. It exhibited scale dependence and strong transferability across DEM resolutions and spatial scales. Compared with the Taihu Basin Model–Plain Hydrological Module (TBM–PHM), the MIHM improved hydrograph simulations, increasing the mean NSE and KGE by 0.04 and 0.15, respectively, while reducing the relative total runoff error by 14.9% and the peak timing error by 2.5 min during validation. It was further incorporated into a hydrological–hydrodynamic modeling framework and applied across the Taihu Basin, demonstrating its applicability from field-scale plots to regional-scale river-network polygons. This study establishes a transferable framework for quantitatively describing microtopographic ponding-detention effects and advances understanding of hydrological mechanisms driven by microtopography in low-relief plains.}
}
@article{CRESPILLOLOPEZ2026136544,
title = {Tracking hydrological drought propagation in river networks: an event-based framework},
journal = {Journal of Hydrology},
volume = {680},
pages = {136544},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136544},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016410},
author = {Alex {Crespillo López} and Sergio M. Vicente-Serrano and Luis Gimeno},
keywords = {Hydrological drought, Drought propagation, River networks, Event-based analysis, Streamflow drought, Spatiotemporal dynamics, Network connectivity},
abstract = {Hydrological droughts are dynamic phenomena that evolve across space and time, propagating through river networks under the influence of climatic forcing, catchment properties, and human regulation. Despite substantial progress in drought research, most existing approaches rely on aggregated indicators or statistical relationships, limiting their ability to explicitly characterise how individual drought events propagate within connected river systems. This study introduces a novel event-based framework to analyse the spatiotemporal propagation of hydrological droughts along river networks. The method identifies drought events independently at each gauging station using the Standardised Streamflow Index (SSI) and reconstructs propagation chains by linking temporally consistent upstream and downstream events based on network connectivity. A set of propagation metrics is then derived to quantify the spatial extent, timing, and severity of drought propagation processes. The framework is applied to daily streamflow data from 33 gauging stations in the Ebro River basin (Spain) over the period 1961–2020, and it illustrates the substantial variability that may characterise the propagation dynamics, with events ranging from localised sub-basin responses to basin-wide droughts involving a large proportion of the upstream network and with timescales that vary from rapid responses to delayed, multi-annual processes. To support reproducibility and facilitate application in other basins, the methodology has been implemented in an open and modular computational workflow, enabling transparent replication and extension of the analysis. The proposed framework provides a process-orientated perspective on hydrological droughts, generating a propagation-chain catalogue that offers a new data foundation for characterising basin-specific drought dispersal regimes. Beyond its methodological contribution, the framework characterises upstream drought signals and cumulative downstream deficits, providing a reproducible basis for future research and for the development of early-warning applications following prospective validation.}
}
@article{SU2026136508,
title = {Evapotranspiration intensification will drive terrestrial water storage decline in the Turpan–Hami Basin},
journal = {Journal of Hydrology},
volume = {680},
pages = {136508},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136508},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016057},
author = {Yanxin Su and Guojing Gan and Jingyi Bu and Yanchun Gao},
keywords = {Turpan-Hami Basin, Terrestrial water storage anomaly, Evapotranspiration, Future projection},
abstract = {In the hyper-arid Turpan–Hami Basin (THB) of northwestern China, where water availability critically constrains socio-ecological sustainability, reliable hydrological characterization is essential yet insufficient. This insufficiency stems from a notable scarcity of integrated modeling studies that employ fully coupled surface–subsurface frameworks to resolve the complex hydrological interactions of the region. Furthermore, conventional potential evapotranspiration (PET) estimators (e.g., Penman-Monteith (PM), Priestley-Taylor (PT)) exhibit systematic biases under extreme arid conditions, while model calibration is often limited by sparse observational data. To overcome these dual challenges, this study developed a bias-corrected, fully coupled CWatM–MODFLOW model for the Turpan–Hami Basin and introduced a novel multi–objective calibration scheme. This scheme jointly constrains the model by simultaneously assimilating GRACE/GRACE–FO observations of terrestrial water storage anomalies (TWSA) and the PML–V2 evapotranspiration (ET) product, thereby significantly improving the simulation of regional water storage dynamics and flux partitioning and yielding more robust and physically consistent results. Based on this reliable modeling framework, the study further conducted an integrated assessment combining multi–objective calibration, scenario projection, and lag–based attribution analysis. Climate forcing data were obtained from the ISIMIP3b dataset, bias–adjusted to ERA5. We benchmark three potential PET schemes—PM, PT, and PT with α-tuning plus systematic bias correction and then diagnose 21st-century TWSA evolution under SSP scenarios, the sensitivities and contributions of precipitation (PRE) and ET to TWSA, lagged responses, and compound extremes. Results show: (1) Calibration (2003–2013) robustly reproduces basin-scale storage; while default PET schemes markedly underestimate ET (KGE = 0.016, NSE =  − 1.05, PBIAS =  − 97%), the PT-α and bias-corrected scheme substantially improves ET skill (KGE = 0.858, NSE = 0.707, PBIAS = 2.3%) without degrading TWSA performance (KGE = 0.783). (2) Validation (2014–2019) exhibits reduced TWSA skill, reflecting non-stationary hydroclimatic and anthropogenic drivers; the improved ET scheme maintains strong accuracy (KGE = 0.828, NSE = 0.690, PBIAS =  − 3.1%), indicating good cross-period generalization. (3) Future meteorology features accelerated warming with scenario dependence and moderate increases in precipitation; Tmin rises faster than Tmax, implying a narrowing diurnal temperature range (DTR) and more warm nights. (4) Projected TWSA and ET reveal scenario-dependent storage declines, stronger under SSP3-7.0 and SSP5-8.5; polynomial trends indicate the fastest acceleration under SSP5-8.5. (5) Attribution and sensitivity analyses demonstrate that the annual responses of dS to PRE and ET (bP>0, bET<0) are approximately symmetric and opposite in sign, with ∣bET∣·ΔET dominating dS under stronger forcing; monthly diagnostics indicate a negative lag from ET to TWSA. (6) The co-occurrence of low TWSA and elevated ET becomes more pronounced over 2041–2100, with a stronger signal under SSP5-8.5, followed by SSP3-7.0 and SSP1-2.6. Overall, the THB exhibits an energy–water coupling in which warming-driven ET intensification partially or fully offsets modest precipitation gains producing more rain without more storage, through vadose-zone and shallow-aquifer moisture memory, yields lagged storage deficits. Management should pivot from inputs to processes, prioritizing infiltration-oriented piedmont flood retention and managed aquifer recharge, seasonal irrigation rescheduling (night and segmented irrigation), and agronomic ET control to reduce ∣bET∣, shorten lag lengths, and mitigate end-century storage risk.}
}
@article{LIU2026136560,
title = {Hydrological regulation of patchy soil salinization: The role of soil profile structure},
journal = {Journal of Hydrology},
volume = {680},
pages = {136560},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136560},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016574},
author = {Chenggong Liu and Lidong Ren and Xuan Yu and Xiaoxu Jia},
keywords = {Salt-affected soils, Electrical resistivity tomography (ERT), Soil structure, Yellow River Delta},
abstract = {Salt-affected croplands often exhibit strong spatial heterogeneity in soil salinity, forming localized salt patches adjacent to vegetated areas with lower salinity. Although such patchiness is common, the role of soil-profile structure and horizon-specific hydraulic properties in regulating salt-patch formation remains poorly understood. This study compared representative salt-patch and vegetation-patch profiles in the Yellow River Delta, China, using electrical resistivity tomography, soil physical and hydraulic measurements, infiltration experiments, pore-size analysis, and HYDRUS-1D simulations. The results showed that soil water content did not differ significantly between the two patch types, whereas soil salt content was consistently higher in salt patches and was significantly associated with the observed resistivity differences. Salt patches exhibited greater penetration resistance at 27.5–35 cm, lower saturated hydraulic conductivity and higher bulk density in the plow layer, weaker sustained infiltration, fewer surface macropores, and greater subsoil micropore volume. Under identical atmospheric and groundwater forcing, simulations showed annual net upward water and salt fluxes across the 20-, 60-, and 120-cm interfaces in all three scenarios. The bare salt-patch profile showed 15–46% greater net upward water flux than the bare vegetation-patch profile. Together with its higher antecedent salinity, this resulted in 2.79–3.90 times greater net upward salt flux. Within the modeled scenarios, the contrast between the two bare-soil profiles was greater than the change produced by adding crop transpiration and root water uptake to the vegetation-patch profile, indicating that differences in profile hydraulic configuration exerted a stronger influence on simulated water and salt redistribution than the vegetation processes represented in the model. These findings suggest that future salt-patch management should emphasize profile-structure adjustment to enhance downward salt removal and limit groundwater-supported upward salt accumulation.}
}
@article{CHEN2026136552,
title = {Stage-specific water-quality reorganization and spatially differentiated risks during snowmelt in an arid urban river},
journal = {Journal of Hydrology},
volume = {680},
pages = {136552},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136552},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016495},
author = {Weihong Chen and Huili Bao and Yanyan Li and Rui He and Hao Wang and Dayi Qian and Hongzhi Ma},
keywords = {Urban rivers, Snowmelt period, ICWQII, Source-related composition, Ecological risk},
abstract = {Static assessments may underestimate snowmelt-driven water-quality changes in arid urban rivers. Eight sites in the Yining reach of the Ili River were monitored across three snowmelt stages in 2024, with ERA5-Land providing regional hydroclimatic context. Water quality was assessed using the improved comprehensive water quality identification index (ICWQII) with game-theory-based adaptive weighting and ecological risk coding. PMF-PCA, ecological risk and trophic assessments, and exploratory PLS-SEM characterized source-related composition, environmental pressures, and variable associations, respectively. TN exceeded 1.0 mg L–1 in 95.8% of site–stage records. NH3–N declined across stages and consistently met the Class III criterion, whereas NO3––N, TP, and COD reached their highest stage means during late snowmelt. Total recoverable Cr reached 0.383 mg L–1 at Y5 during peak snowmelt (Cr-related risks evaluated under conservative upper-bound Cr(VI) screening). Mean ICWQII increased from 2.42 to 3.12 and 3.40, with Y5 reaching 3.82 during peak snowmelt, approaching Class IV. PMF–PCA resolved source-related compositional factors, with F2 associated with domestic inputs during early snowmelt, Cr-dominated F3 contributing 67.67% at Y5 during peak snowmelt, and agriculture-associated F1 contributing over 50% at Y1, Y3 and Y8 during late snowmelt. RI remained low overall; during peak snowmelt, RI and the Cr-specific risk index at Y5 reached 21.48 and 15.31, respectively. Maximum late-snowmelt TLI was 75.91. Exploratory PLS–SEM indicated significant positive associations of F1 with TLI and of F3 with RI and the Cr-specific risk index. These findings reveal stage-specific shifts in water-quality composition and environmental pressures, supporting targeted monitoring and management of snowmelt-affected urban rivers.}
}
@article{DJIEUGOUE2026136528,
title = {Linking urban sanitation practices to water resource quality: A multi-tracer approach in a humid tropical context using nitrate isotopes and emerging organic contaminants},
journal = {Journal of Hydrology},
volume = {680},
pages = {136528},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136528},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016252},
author = {Boris Djieugoue and Bertil Nlend and Suzanne {Ngo Boum-Nkot} and Kamel Zouari and Rim Trabelsi and Wassef {Ben Nasr} and Jacques Etame and Frédéric Huneau},
keywords = {Urban water resources, Wastewater, Nitrate isotopes, Emerging organic contaminants, Sustainable water management, Cameroon},
abstract = {Urban water resources in large cities of sub-Saharan Africa are increasingly impacted by anthropogenic activities, mainly due to the limited access to adequate sanitation systems. In these highly anthropized contexts surface water and groundwater contamination sources are multiple. However, the interactions between these contamination sources and urban water bodies remain poorly investigated, despite the need for such understanding to support sustainable water-resource management. This study applied a multi-tracer approach combining hydrochemistry, nitrate stable isotopes (δ15N-NO3 and δ18O-NO3), and Emerging Organic Contaminants (EOCs) to identify contamination sources and pathways, and to characterize the biogeochemical processes affecting shallow aquifers and surface waters in a tropical urban environment. High Cl/Br molar ratios (>1000), indicated that NO3– and Cl- primarily originate from domestic wastewater inputs. Enriched δ15N-NO3 (6.6 to 25‰) and δ18O-NO3 (+3.3 to + 9.9‰), further confirmed the predominance of wastewater-derived contamination and revealed the occurrence of partial denitrification processes. Intermediate isotopic ranges (soil organic nitrogen and sewage) suggested the influence of mixed contamination sources. Widespread occurrence of EOCs, particularly persistent contaminants such as fluconazole (FCZ), highlighted the significant impact of wastewater on both groundwater and surface water quality. Strong correlations of FCZ with Cl-, δ15N-NO3, together with their similar spatial distribution, identified FCZ as the most effective wastewater co-tracer in the study area. Furthermore, the co-occurrence of FCZ with non-persistent compounds such as paracetamol indicated recent and continuous wastewater inputs affecting urban water resources. Sporadic detection of non-ubiquitous compounds such as carbamazepine reflects localized wastewater infiltration from septic or pit latrine sources. These results underscore the high vulnerability of shallow urban aquifers and demonstrate the relevance of nitrate isotopes and EOCs coupling to better understand contamination dynamics and support sustainable urban water management.}
}
@article{LEE2026136588,
title = {Hydrogeological controls on radial collector well intake: interactions among aquifer properties, clogging, and lateral hydraulics},
journal = {Journal of Hydrology},
volume = {680},
pages = {136588},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136588},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016859},
author = {Seonmin Lee and Min-Ho Koo and Jaeyun Jung},
keywords = {Radial collector well, Riverbank filtration, Aquifer anisotropy, Clogging, Lateral hydraulics, Aquifer–lateral flow coupling},
abstract = {Radial collector well (RCW) intake is governed by complex interactions among aquifer properties, river–aquifer connectivity, clogging processes, and hydraulic losses within collector laterals. This study investigates these controls using a coupled aquifer–lateral flow formulation implemented in MODFLOW, in which laterals are represented as Drain cells with iteratively updated heads and conductances to account for near-lateral resistance and internal frictional and momentum losses. A conceptual model was used to examine aquifer hydraulic conductivity and anisotropy, aquitard properties, river-to-caisson distance, filter-pack and riverbed clogging, caisson operational head, and lateral design parameters. Intake increased with aquifer hydraulic conductivity, although the response became nonlinear as lateral head losses intensified. Vertical hydraulic resistance caused by anisotropy or aquitards reduced intake and, under some conditions, produced a finite optimal river-to-caisson distance. Well clogging exerted a much stronger influence than riverbed clogging, and severe reductions in filter-pack hydraulic conductivity reduced intake to near-zero levels. Among the lateral design variables, lateral diameter had the strongest effect, particularly in high-conductivity aquifers. Longer laterals were more effective in low-conductivity aquifers, whereas adding laterals was more beneficial in high-conductivity aquifers, where groundwater could be supplied from multiple directions. These results show that RCW performance depends on the location and magnitude of the dominant hydraulic resistance within the coupled river–aquifer–well system. The findings provide a process-based framework for RCW design, performance interpretation, and clogging management under site-specific hydrogeological conditions.}
}
@article{SECCI2026136499,
title = {Hybrid physics–AI modeling in hydrogeology: a review of concepts, applications, and challenges},
journal = {Journal of Hydrology},
volume = {680},
pages = {136499},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136499},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015969},
author = {Daniele Secci and Valeria Todaro and J. Jaime Gómez-Hernández},
keywords = {Hydrogeology, Theory-guided machine learning, Physics-informed machine learning, Physics-aware machine learning, Differentiable programming},
abstract = {Artificial intelligence is reshaping hydrogeological modeling. The question is whether hybrid physics–AI approaches can reconcile the explanatory power of process-based models with the flexibility and speed of machine learning. We try to answer this question with a concept-driven review which traces the progression from purely data-driven approaches to emerging modeling paradigms incorporating physical knowledge. We show that hydrogeological modeling is moving beyond a simple opposition between mechanistic simulators and black-box algorithms toward a continuum of physics–AI integration, including theory-guided machine learning, physics-informed neural networks, physics-aware architectures, neural operators, generative models, and differentiable programming. Applications across key hydrogeological domains are reviewed, followed by a discussion of current limitations and barriers to operational deployment, including data requirements, transferability across hydrogeological settings, verification and validation, uncertainty quantification, and issues of trust. We conclude that hybrid physics–AI modeling should not be understood as a replacement for hydrogeological theory, but as an emerging methodological framework in which physical laws, numerical simulation, and machine learning are combined to produce models that are faster, more interpretable, more robust, and more useful for decision-making in groundwater science and management.}
}
@article{XIE2026136564,
title = {Hydrological diagnosis of preferential seepage and internal erosion in embankment dams and levees: From transient forcing to uncertainty-aware decisions},
journal = {Journal of Hydrology},
volume = {680},
pages = {136564},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136564},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016616},
author = {Zhiwen Xie and Liang Chen and Hanxuan Luo and Ruiyang Liu and Ding Sang},
keywords = {Embankment dam, Levee, Internal erosion, Transient groundwater, Hydrogeophysics, Risk-informed decision},
abstract = {Preferential seepage becomes evidence of internal erosion only when the hydraulic response can be linked to particle detachment and transport. This critical review examines that distinction in embankment dams and levees, considering how transient loading, storage, and geological structure affect both the physical process and its observation. Hydraulic records establish the response to changing loads, while thermal and geophysical surveys help constrain possible pathways. Particle sampling and investigation of sediment sources provide evidence of material loss that these indirect observations cannot establish alone. Joint interpretation of lag, attenuation, hysteresis, recession, and spatial coherence helps distinguish regional groundwater and bank-storage responses from localized seepage. The comparison of sensing and inverse methods shows why resolution, uncertainty, and verification must be assessed for the particular question being asked. We propose an evidence hierarchy and an observation-conditioned event tree to connect these interpretations with engineering decisions. For learned models and digital twins, testing on unseen events and assets, independent physical checks, and the consequences of false and missed alarms are central to evaluating practical benefit. The review emphasizes physically grounded, site-specific interpretation and verification as the basis for diagnosis and warning.}
}
@article{MENSAH2026136446,
title = {Drivers and controls of salinization in prairie ponds},
journal = {Journal of Hydrology},
volume = {680},
pages = {136446},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136446},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601543X},
author = {Michael Mensah and Andrew Ireson and Bruno Soares and Zohra Zahir and Ryan Rimas and Britt Hall and Kerri Finlay},
keywords = {Hydrology, Sulphate dynamics, Cattle access, Prairie pondscapes, Vegetation cover},
abstract = {High sulphate (SO42−) concentrations in ponds can support distinctive aquatic communities but can also promote salinization and disrupt aquatic ecosystem functioning, with implications for livestock watering. These contrasting effects are widespread across pondscapes of the Northern Great Plains, yet the interacting biophysical, limnological, and hydrological controls on SO42− dynamics remain underexplored. We investigated SO42− dynamics across upland soils, water columns, and sediments of prairie ponds comprising naturally occurring wetlands and artificially constructed dugouts (small, excavated water-storage ponds) spanning gradients in salinity, depth, upland vegetation cover, and hydrological setting. Wetlands exhibited higher SO42− concentrations in water and sediment than dugouts, consistent with differences in pond morphology, hydrological connectivity, and longer-term solute accumulation. Hydrological setting was strongly associated with pond SO42− concentrations, with discharge systems generally exhibiting higher concentrations than recharge systems. Across pondscapes, sediments had the highest SO42− concentrations, followed by upland soils and the water column, highlighting sediments as an important long-term SO42− reservoir. Structural equation modelling further identified hydrology, sediment and soil SO42−, soil organic matter, total dissolved nitrogen, and water depth as important predictors of pond salinization. Upland vegetation cover was negatively associated with SO42− desorption, suggesting a potential role in limiting solute mobilization, although its contribution appeared secondary to hydrological and geochemical controls. Collectively, these findings highlight the importance of hydrological setting, pond morphology, and long-term SO42− storage in regulating salinization across prairie pondscapes and provide insights into processes that may influence the suitability of ponds as livestock-water resources.}
}
@article{DU2026136556,
title = {Nonlinear sea level rise and storm surge interactions amplify future coastal flood hazards in the world’s largest urban delta},
journal = {Journal of Hydrology},
volume = {680},
pages = {136556},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136556},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016537},
author = {Haoxuan Du and Liang Gao and Limin Zhang and Lishu Xu},
keywords = {Storm surges, Joint probability method, Numerical modeling, Sea level rise, Tropical cyclones},
abstract = {Tropical-cyclone (TC)-induced coastal water-level hazards are expected to intensify as sea level rises and TC climatology responds to anthropogenic forcing. We develop a probabilistic framework for the Pearl River Delta (PRD) that combines SSP-conditioned CHIPS-CMIP6 synthetic TCs, the Joint Probability Method with Optimal Sampling and Bayesian Quadrature (JPM-OS-BQ), stochastic regional sea-level-rise (SLR) projections, and high-resolution hydrodynamic modeling. For SSP2-4.5, SSP3-7.0, and SSP5-8.5 during 2070–2100, JPM-OS-BQ selects 80 weighted storm-SLR combinations from the PRD-filtered candidate ensemble, reducing required hydrodynamic simulations by approximately 95%. The optimized subsets retain the principal marginal and pairwise statistical structures of the input parameter space. Response-level performance is further evaluated against the complete 2,351-event SSP5-8.5 hydrodynamic ensemble, showing good representation of the broad hazard structure but increasing site-specific discrepancies toward the far return-period tail. Relative to SSP2-4.5, the area-averaged event-maximum total water level under SSP5-8.5 is approximately 1.1 m (29%) higher at the 100-year return period and 1.7 m (43%) higher at the 1000-year return period. At Hong Kong and Macao, 100-year total water levels increase from approximately 2.4 and 3.5 m under SSP2-4.5 to 4.2 and 5.2 m under SSP5-8.5. Paired simulations reveal a spatially heterogeneous nonlinear SLR residual: total water levels are suppressed by up to about 0.2 m along parts of the open coast but amplified by a similar magnitude in some interior distributary channels. These results show that linear addition of SLR to baseline water levels can misrepresent future hazards in complex deltas and support adaptive flood-risk management.}
}
@article{ZHANG2026136487,
title = {Revealing hidden structural regimes in fluvial stage–discharge relationships using time-series imaging},
journal = {Journal of Hydrology},
volume = {680},
pages = {136487},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136487},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015842},
author = {Jiarui Zhang and Shenliang Chen and Yaoshen Fan and Hongyu Ji and Taihuan Hu and Jianbin Chen},
keywords = {Stage–discharge regime, Time-series imaging, Markov transition field, Physical interpretability, Structural monitoring},
abstract = {Stage–discharge relationships in alluvial rivers are widely recognized as nonstationary, yet it remains unclear whether their long-term variability is truly unstructured or instead organized into a finite set of recurrent structural regimes. This study addresses this issue using 75 years of daily stage and discharge records from the Lijin hydrological station on the lower Yellow River. We develop a physics-guided time-series imaging framework that integrates Markov Transition Field (MTF) encoding, dual-branch convolutional representation learning, derivative-based physics-guidance encoding, and hierarchical clustering to classify annual stage–discharge behavior within a fused structural space. Results demonstrate that annual stage–discharge dynamics do not vary as a smooth continuum but recur as a limited set of identifiable structural regimes. Relative to the non-physics-guided framework, the physics-guided framework reorganizes interannual similarity into less fragmented and more hydraulically consistent structural groups, albeit with a larger weighted mean within-cluster distance—indicating that geometric compactness alone does not guarantee physically meaningful partitioning. Distinctions among regimes manifest primarily in state persistence, cross-seasonal reconnection, and hysteretic coupling between stage and discharge. Inter-regime contrasts concentrate in a small number of cross-seasonal hotspot transition windows, indicating that nonstationarity is organized via specific seasonal pathways rather than being uniformly distributed across the year. Feature-attribution analysis further reveals that transition-structure metrics contribute more strongly to regime classification than magnitude-based hydrological indicators, while physics-derived features function primarily as a structural refinement layer rather than the primary source of regime separation. These insights may support adaptive management and structural monitoring in regulated river systems, while providing a potential transferable methodological paradigm for comparable fluvial systems worldwide.}
}
@article{WU2026136548,
title = {Distributed modeling reveals the evolution of supraglacial lakes: a multi-basin study on the Greenland ice sheet},
journal = {Journal of Hydrology},
volume = {680},
pages = {136548},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136548},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016458},
author = {Jiake Wu and Lei Zheng and Qi Liang and Teng Li and Quan Zhou and Chuyue Peng and Baojuan Huai and Zhuoqi Chen and Xiao Cheng and Fengming Hui},
keywords = {Greenland ice sheet, Supraglacial lakes, Distributed model, Surface runoff},
abstract = {Supraglacial lakes (SGLs) on the Greenland Ice Sheet play a critical role in modulating surface energy balance and meltwater storage, thereby influencing ice-sheet mass balance and hydrological processes. Accurately characterizing the evolution of SGLs is essential for elucidating the mechanisms governing lake behavior and for predicting the timing and conditions of lake drainage events. However, characterizing SGL evolution remains challenging because most existing SGL models either provide one-dimensional representations of vertical lake evolution or neglect vertical lake deepening altogether. Here, we present GlacierLake_v3, a distributed SGL model that simulates lake evolution in horizontal and vertical dimensions by explicitly resolving runoff generation, transport, loss, and accumulation across the ice-sheet surface. Meltwater losses occur during transport processes including retention, refreezing, evaporation, and drainage into crevasses, which are commonly neglected in previous models and are here collectively represented using a constant meltwater loss rate parameter. This parameter is calibrated for each catchment using satellite observations from different years. Validation across different basins demonstrates that GlacierLake_v3 accurately reproduces lake areas and volumes, with maximum R2 values of 0.89 and 0.95, respectively. The model also successfully captures the two-dimensional distribution of lake depth and its temporal evolution, showing close agreement with satellite-derived retrievals. Our results further show that daily and cumulative runoff from regional climate models (RCMs) were 14–79% and 6–122% higher, respectively, than the lake-volume-based estimates. These findings underscore the importance of incorporating more comprehensive meltwater losses into RCMs to improve their representation of supraglacial hydrology.}
}
@article{WANG2026136524,
title = {Pore-structure-mediated effects of incorporated Festuca arundinacea roots on water retention and unsaturated infiltration in loess},
journal = {Journal of Hydrology},
volume = {680},
pages = {136524},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136524},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016215},
author = {Xiaochan Wang and Hengxing Lan and Shijie Liu and Enlong Liu and Bei Zhang and Weifeng Sun and Pan Wang and Xuanchen Ren and Langping Li and Han Bao},
keywords = {Root-induced pore structure evolution, Soil water retention properties, Unsaturated infiltration, Van Genuchten model, Loess},
abstract = {Herbaceous roots can substantially alter soil water retention and unsaturated infiltration by modifying pore structure, yet the quantitative relationship between root-associated pore-structure changes and hydraulic behavior remains unclear. In this study, remolded root–soil composites were prepared by incorporating mature Festuca arundinacea roots into loess at five root mass ratios (RB). Soil-water characteristic curve (SWCC) measurements, soil column infiltration experiments, nuclear magnetic resonance (NMR), and scanning electron microscopy (SEM) were conducted to investigate water retention, pore structure, and unsaturated infiltration. Increasing RB promoted the development of medium and large pores, resulting in a more heterogeneous and multiscale pore structure. These pore-structure changes were associated with nonlinear variations in hydraulic parameters, characterized by increases in saturated water content θs and the air-entry-related parameter α, accompanied by decreases in residual water content θr and the shape parameter n. Based on quantitative relationships between pore-structure descriptors and hydraulic parameters, a structure-constrained parameter modification method for the van Genuchten (VG) model was proposed. To evaluate the proposed method, the modified parameterization was incorporated into the Richards equation, and infiltration under five uniform RB conditions and one condition representing the vertical root distribution of mature F. arundinacea was simulated using HYDRUS. The simulations reproduced the measured water-content dynamics and wetting-front migration well under different root configurations, demonstrating the applicability of the proposed method. These findings highlight the role of root-associated pore-structure changes in soil hydraulic behavior and provide parameter support for understanding vegetation–soil–water interactions and unsaturated infiltration in the Loess Plateau.}
}
@article{WANG2026136523,
title = {External source restructuring activates legacy sediment phosphorus cycling and delays recovery in a shallow plateau lake},
journal = {Journal of Hydrology},
volume = {680},
pages = {136523},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136523},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016203},
author = {Ziteng Wang and Fuhong Sun and Qingjun Guo and Aoping Mao and Royngfei Wei and Jingfu Wang and Fengchang Wu},
keywords = {SedimentaryP fractions, Reconstructed lake waterTP, Phosphate oxygen isotopes, Internal P loading, External source restructuring, legacy P feedback},
abstract = {Legacy phosphorus (P) stored in lake sediments can delay water quality improvement after external inputs decline, but the historical transition from external P enrichment to persistent sedimentary feedback remains poorly resolved. Here, we combined two dated sediment cores from Dianchi Lake, China, with sequential P fractionation, sediment inferred lake water total phosphorus (SI-TP), phosphate oxygen isotopes (δ18OPO4), structural equation modelling, and Bayesian source apportionment. SI-TP increased from 0.10 ± 0.02 mg L−1 during 1825–1870 to 0.32 ± 0.12 mg L−1 during 1990–2022. This increase was accompanied by a decline in the relative contribution of mineral associated HCl-P, expansion of NaHCO3-P and NaOH-P pools, and a 225.8% increase in net sediment P burial flux relative to Stage I. Disequilibrium of δ18OPO4 values increased most clearly in the labile NaHCO3-P fraction, indicating progressively stronger nonequilibrium processing associated with changes in P sources and sedimentary biogeochemical processes. Bayesian mixing models further indicated increasing contributions from fertilizer and industrial wastewater after 1960. Across the reconstructed time series, anthropogenic pressure and sedimentary P indicators were strongly associated with lake water TP, whereas climatic effects were predominantly indirect. Together, these results show that historical external P enrichment was recorded not only as greater sediment P accumulation but also as a reorganization toward more reactive P pools. This durable increased P burial flux and reorganisation are consistent with a legacy P feedback that may sustain eutrophication risk after external loading is reduced.}
}
@article{CAI2026136518,
title = {An improved Green-Ampt infiltration model of depth-dependent initial soil water content and its experimental verification},
journal = {Journal of Hydrology},
volume = {680},
pages = {136518},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136518},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601615X},
author = {Zheng-Long Cai and Jin Li and Yong-Dong Meng and Xiu-Wen Li and Wei-Jie Zhang and Bin Tian and Jia-Wen Zhou},
keywords = {Rainfall infiltration, Green-Ampt model, Initial water content, Depth-dependent distribution},
abstract = {Rainfall infiltration analysis is essential for evaluating slope stability. Conventional Green-Ampt models assume homogeneous soil or presume specific functional forms of the initial water content distribution, limiting their applicability to heterogeneous slopes. To overcome this limitation, this paper proposes a generalized improved Green-Ampt model that accommodates arbitrary distributions of initial soil water content by numerically solving the governing equation with the Newton-Cotes formula, and further incorporates the moisture-driven variation of hydraulic conductivity during infiltration. The model is validated through an indoor rainfall infiltration experiment on a physical slope model monitored by the high density electrical resistivity tomography (ERT). The results show that the depth-dependent distribution of initial soil water content governs the water storage capacity, whereas the moisture-driven variation of hydraulic conductivity mainly affects the seepage process after the onset of surface ponding. The calculated wetting front depths agree well with the experimental measurements, confirming the accuracy of the improved model and extending the Green-Ampt framework to practical rainfall infiltration analyses of slopes.}
}
@article{LIANG2026136539,
title = {Seasonal differences in Fe:P regulation of phosphorus source–sink dynamics in an urban shallow lake},
journal = {Journal of Hydrology},
volume = {680},
pages = {136539},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136539},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016367},
author = {Baowen Liang and Wen Xiong and Cong Xiao},
keywords = {Urban shallow lakes, Sediment-overlying water interface, Fe:P supply, Reactive Fe pools, P redistribution, Microbialfunctional potential},
abstract = {Internal phosphorus (P) release in urban shallow lake sediments is strongly coupled to iron (Fe) cycling, yet how the molar supply ratio of dissolved Fe(II) to phosphate-P (Fe:P) regulates P source‒sink dynamics remains unclear. Four seasonal field surveys in Nanhu Lake (Wuhan, China) and standardized low-oxygen incubations across Fe:P supply gradients were conducted to examine how Fe:P supply affects the timing and pathway of P transformation under contrasting seasonal sediment backgrounds. Field observations showed clear seasonal differences in Fe–P coupling at the sediment-overlying water interface, with higher aqueous P and Fe concentrations in summer and autumn, accompanied by a shift from HCl-extractable Fe(III) toward HCl-extractable Fe(II) in surface sediments. Under standardized low-oxygen conditions, winter- and summer-derived sediments exhibited contrasting P-transformation pathways. In winter-derived sediments, higher Fe:P supply accelerated early PO43- removal, but concentrations subsequently rebounded to 4.89-5.17 mg/L at 40 d, accompanied by transformation of reactive Fe pools. In summer-derived sediments, aqueous PO43- declined continuously to 0.06-0.14 mg/L at 40 d, with exchangeable P and organic P decreasing and Fe-bound P and authigenic P increasing. Metagenomic analysis indicated distinct microbial functional responses associated with these pathways, with Fe input being associated with lower functional potential for P solubilization and inorganic P transport. Overall, Fe:P supply modulated sediment P source–sink dynamics in association with coordinated, stage-dependent changes in reactive Fe pools, P fractions, and microbial functional potential rather than acting as a fixed threshold. These findings provide new insights into internal P risk assessment in urban shallow lakes.}
}
@article{KIM2026136515,
title = {Scaling properties and classification of urban drainage networks in an Asian megacity},
journal = {Journal of Hydrology},
volume = {680},
pages = {136515},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136515},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016124},
author = {Hyeonju Kim and Soohyun Yang},
keywords = {Sewer network, Hortonian scaling, Power-law relationship, Sewershed, Scaling-based framework},
abstract = {Urban drainage networks (UDNs) are critical infrastructure for public health and the mitigation of flood risk. As UDNs age and expand in scale and complexity, their structural properties are adapted to cope with new needs. Self-similarity of the structure of such drainage networks has been proposed as a naturally self-organized and optimal state of such systems but it remains unclear whether self-similarity is a universal feature of UDNs globally and how to interpret any differences in scaling from the classical scaling as seen in rivers. To address this, we analyzed 221 UDNs (3,942 km) in Seoul. We assessed three classical scaling metrics describing the spatial organization of river networks i.e., Hortonian scaling ratios, the power-law relationship between main-channel length and drainage area, and the area-exceedance probability distribution. While the latter two metrics had similar power-law scaling, UDNs showed a wider range of the power-law exponent in the length-area relationship and a lower power-law exponent in the area-exceedance probability distribution as compared to rivers. Just 50.2% of UDNs (68.5% of total length) satisfied Hortonian scaling invariance. Employing these ratios as criteria, we grouped UDNs and found that their structural properties are associated with sewershed size and commercial area ratio. Moreover, UDNs with scaling more similar to that of rivers had a lower side-to-main pipe-size ratio. These findings provide a systematic diagnosis of scaling heterogeneity across a large set of UDNs within a single megacity and offer a preliminary screening approach for identifying UDNs that may warrant further hydraulic assessment.}
}
@article{MOTAMEDI2026136507,
title = {Hydrometeorological and hydrogeological trends and drought dynamics in a cold-humid, coastal region},
journal = {Journal of Hydrology},
volume = {680},
pages = {136507},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136507},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016045},
author = {A. Motamedi and N.K. LeRoux and A.M.R. Hill and R.C. Jamieson and L.D. Somers and B.L. Kurylyk},
keywords = {Groundwater level, Net precipitation, Baseflow, Standardized indices, Hydrogeological extremes, Spatiotemporal variability},
abstract = {Quantifying groundwater response to droughts remains challenging, as aquifers typically respond to meteorological conditions with delays, and long-term groundwater records remain limited. This study investigated statistical relationships among meteorological, hydrogeological, and hydrological datasets in the Canadian province of Nova Scotia. Standardized Groundwater Index (SGI) values were calculated using daily groundwater level data (2009–2025) from 32 observation wells and compared with meteorological (Standardized Precipitation Evapotranspiration Index, SPEI) and hydrological (Standardized Base Flow Index, SBFI) drought indicators. To complement the statistical analyses of drought dynamics, geospatial drought layers were used to examine spatiotemporal patterns in drought severity and distribution. In most groundwater systems, SGI exhibited short (< 1 month) lag times and strong correlations (> 0.5 on average) with both SPEI and SBFI, suggesting the atmosphere-aquifer-stream hydrologic continuum patterns are strongly associated. Trend analysis revealed that the fall season is experiencing the most significant and persistent negative trends across the hydrological cycle (net precipitation, baseflow, and groundwater level). Significant negative fall trends were identified in 67% of net precipitation records, 60% of streamflow records, 40% of baseflow records, and 25% of groundwater level records. Kernel density analyses for summer and fall indicated significant shifts toward drier SPEI, SGI, and SBFI distributions (p < 0.05) after 2016. The geospatial drought layer analysis reveals that more intensive droughts are becoming more frequent and spatially extensive. Collectively, the results yield a better understanding of drought characteristics in a cold, coastal region, an essential step towards evaluating ongoing climate change impacts in similar environments worldwide.}
}
@article{ZEQIRAJ2026136559,
title = {Goal-oriented Bayesian experimental design for variable-density seawater intrusion: Adjoint expected information gain for joint monitoring and managed-aquifer-recharge placement},
journal = {Journal of Hydrology},
volume = {680},
pages = {136559},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136559},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016562},
author = {Dulian Zeqiraj},
keywords = {Seawater intrusion, Optimal experimental design, Expected information gain, Adjoint sensitivity, Variable-density flow, Managed aquifer recharge, Monitoring network design, Sedimentary facies},
abstract = {Coastal alluvial aquifers are increasingly threatened by seawater intrusion (SWI), and their protection requires both monitoring networks and active controls such as managed aquifer recharge (MAR). Existing SWI design relies largely on heuristic simulation–optimization without a goal-oriented information measure, and where observation and control are linked it is through a two-stage adaptive loop rather than through one objective; meanwhile, adjoint goal-oriented optimal experimental design (OED), now mature for single-density and generic PDE-constrained problems, has not been brought to variable-density SWI physics. This paper presents what is, to the author’s knowledge, the first adjoint-based goal-oriented expected information gain (EIG) framework for steady variable-density (Henry-class) seawater intrusion. The method derives a goal-oriented information operator from the coupled flow–transport adjoint and assembles one objective, the expected information gain about the management target under a facies-conditional prior net of cost, which places monitoring wells and MAR infrastructure jointly rather than in sequence. The discrete adjoint reuses an existing validated forward solver without modification, assembling the required Jacobian from its residual evaluator. It further establishes a poolability phase boundary: parameterizing the facies-stratified prior by a single cross-facies correlation ρF, a facies-blind design becomes provably suboptimal below a critical value ρc. In a linear-Gaussian synthetic study, ρc≈0.76, with the goal-information loss exactly zero above ρc (a “dead zone”) and reaching ≈19% of the pooled-design information below it; the threshold is structurally invariant across problem sizes. On a Henry-class variable-density benchmark, the discrete adjoint reproduces forward sensitivities to a relative error of 4.4×10-9, and the same solve places the mid-isochlor toe, taken at half the seawater concentration, at 0.696 of the cell length, within one per cent of an independent finite-element solution of the same problem. Application to the Tirana–Fushë-Kuqe–Lezhë coastal aquifer (Albania) recommends 5 monitoring and 3 MAR locations and gains about 10% of goal information over a facies-blind baseline (0.595 vs. 0.537 nats); the site lies marginally above the critical threshold, so facies-blind sampling is borderline admissible there. A reference MATLAB implementation is openly available (https://github.com/dulianzeqiraj/swi-goal-oed).}
}
@article{ZHOU2026136587,
title = {Extreme basin-scale flood-dry events induce dramatic alterations in water–sediment dynamics within the Yangtze Estuary},
journal = {Journal of Hydrology},
volume = {680},
pages = {136587},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136587},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016847},
author = {Ying Zhou and Zhijun Dai and Weihua Li and Xuefei Mei and Wenjun Zeng and Aoyang He},
keywords = {Hydrological process, Sedimentary dynamics, Extreme flood and dry years, Turbidity maximum zone, Yangtze(Changjiang) Estuary},
abstract = {Against the backdrop of increasing attention to the frequent occurrences of global extreme flood and dry events, understanding how these extreme hydrological events impact estuarine water and sediment dynamics remains insufficient. To address this, this study focuses on the Yangtze Estuary, a typical estuarine system governed by the hydrological processes of the Yangtze Basin, and selects the North Channel (NC), a representative bifurcated branch, as the study area. Based on continuous hydrological observations conducted at eight monitoring stations during the flood seasons of an extreme flood year (2020) and an extreme dry year (2023), combined with water–sediment analyses and the Empirical Orthogonal Function (EOF) method, the spatiotemporal variation characteristics of water and sediment dynamics under extreme hydrological conditions were systematically diagnosed. The results show that the average flow velocity during the extreme flood year reached 1.08 m/s, exhibiting a three-peak longitudinal structure. In contrast, during the extreme dry year, a double-peak structure was observed, with the flow velocity decreasing to 0.85 m/s and stagnant flow characteristics beginning to emerge. In Turbidity Maximum Zone (TMZ), peak flow velocities during the flood year exceeded 1.20 m/s, with Suspended Sediment Concentration (SSC) reaching up to 1.26 kg/m3 and showing a “peak dilution effect.” Conversely, during the dry year, flow velocity significantly weakened, with a peak of only 0.95 m/s, while SSC decreased to 0.66 kg/m3, its high-concentration layer exhibited a more vertically extended distribution. These variations in water and sediment dynamics reveal that during extreme flood year, river runoff suppresses marine tidal effects, leading to an overall increase in estuarine flow velocity and sediment supply. During extreme dry year, tidal effects are significantly amplified, causing the TMZ to migrate upstream. Accordingly, sediment resuspension and deposition are modified, jointly reshaping the estuarine water and sediment transport patterns. This study provides empirical evidence for understanding the response mechanisms of large river estuaries under extreme hydrological conditions.}
}
@article{WANG2026136527,
title = {Seasonal reversals in surface environmental gradients and a novel phytoplankton bloom risk assessment framework in the trans-Arctic Ocean},
journal = {Journal of Hydrology},
volume = {680},
pages = {136527},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136527},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016240},
author = {Chaofeng Wang and Bo Li and Hengchang Du and Longwen Fu and Sixian Huang and Yuhang Zhang and Xinyuan Chang and Juanling Zhou and Xiaoyu Wang},
keywords = {Arctic Ocean, Physicochemical heterogeneity, Seasonal reversals, Phytoplankton bloom risk assessment, The region under study, Climate change},
abstract = {The Arctic Ocean is undergoing unprecedented environmental changes driven by global warming, with profound consequences for biogeochemical cycles and ecosystem functioning. However, high-resolution spatiotemporal characterization of surface physicochemical heterogeneity and quantitative phytoplankton bloom risk assessment remain limited, hindering informed environmental management. Here, two zonal trans-basin transects (outbound and inbound) across the Arctic Ocean from August to October 2025, collecting continuous underway data at 1,271 stations spanning 19 degrees of latitude (65.1°N to 84.2°N) across six hydrographically distinct sea regions. Analyses revealed striking seasonal reversals in environmental gradients: in late summer, surface temperature decreased poleward from 6.3°C in the Pacific-Arctic Region to −0.4°C in the Eurasian Basin, while salinity increased from shelf to basin; in early autumn, the highest temperature (4.6°C) shifted to the Chukchi Sea shelf and salinity increased westward. Notably, dissolved inorganic nitrogen concentrations in the Pacific-Arctic region increased 33-fold from late summer to early autumn, alongside 3.4-fold and 5.6-fold increases in phosphate and silicate, respectively. Stoichiometric ratios exhibited equally strong seasonal and spatial variation: N:P ratios reached 8.1 in the Pacific-Arctic Region, while Si:N ratios peaked at 308.9 in the East Siberian Sea, indicating severe nitrogen limitation across most Arctic shelf regions. A novel phytoplankton bloom risk assessment framework based on integrated nutrient concentrations and stoichiometric matching to the Redfield ratio (N:P:Si = 16:1:15), classifying all stations into four risk tiers and identifying discrete high-risk zones in the Pacific-Arctic region and the East Siberian Sea. This study delivers the most comprehensive high-resolution dataset of Arctic surface environmental properties to date and offers a robust, management-oriented tool for predicting phytoplankton bloom dynamics under accelerating climate change.}
}
@article{MA2026136543,
title = {From end-of-pipe detention to source–process regulation: multi-objective optimization of gray–green infrastructure for urban flood mitigation},
journal = {Journal of Hydrology},
volume = {680},
pages = {136543},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136543},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016409},
author = {Haiyuan Ma and Wenqiu Tang and Hao Wu and Lei Chen and Haoran Zhu and Cheng Cheng and Jia Yan and Hongxiang Chai},
keywords = {Urban stormwater, Gray-green infrastructure, Multi-objective optimization, NSGA-II, Runoff-path-based spatial hierarchical design},
abstract = {Under climate change and rapid urbanization, urban flood risk has intensified, and traditional drainage systems are inadequate for extreme rainfall. To enhance the integrated regulation capacity of gray–green infrastructure (GGI) under intense rainfall and complex runoff processes, this study developed a multi-objective optimization framework for GGI. The framework coupled the Storm Water Management Model (SWMM) with the Non-dominated Sorting Genetic Algorithm II (NSGA-II) to analyze the effects of algorithm parameters and the diversion ratio of detention tanks on optimization performance. A runoff-path-based spatial hierarchical design (RSHD) strategy was introduced to explore the spatial configuration mechanisms of GGI, and joint optimization was performed under five rainfall return period scenarios ranging from 10 to 200 years. The entropy-weighted TOPSIS method was applied for scheme decision making. The results showed that: (1) the crossover and mutation distribution indices significantly affected convergence and solution diversity, while an appropriate diversion ratio facilitated hydraulic load matching between gray and green infrastructure, thereby improving regulation performance; (2) the RSHD strategy substantially altered the spatial configuration of facilities, increasing the minimum total node overflow reduction rate from 44% to 55%, the proportion of upstream detention tanks from 43.5% to 68.2%, and the proportion of high-frequency nodes from 47.8% to 77.3%. For representative schemes with nearly identical total node overflow reduction rates, the downstream overflow reduction rate increased by an average of 25.14%; and (3) with increasing rainfall return periods, gray infrastructure accommodated greater hydraulic loads by expanding detention capacity, whereas green infrastructure maintained a relatively stable source-control function, and the system gradually shifted toward full-chain coordination across source, process, and end-of-pipe stages. This study provides a basis for parameter selection and spatial guidance for GGI optimization in complex-terrain cities under climate change and offers theoretical support for the transition of urban stormwater management toward upstream-priority and coordinated regulation.}
}
@article{SYAMNANDIKANTI2026136498,
title = {Unearthing dominant controls of precipitation – streamflow interaction using information theory and explainable AI in large-sample hydrology},
journal = {Journal of Hydrology},
volume = {680},
pages = {136498},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136498},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015957},
author = {Siva Sai {Syam Nandikanti} and Maheswaran Rathinasamy},
abstract = {Understanding the interaction between precipitation (P) and streamflow (Q) across different hydrological regions is essential for the comprehensive interpretation of the catchment’s behaviour. The present study quantifies the strength of the P–Q interaction using the information-theoretic metric Transfer Entropy (TE) across the Conterminous United States. Daily precipitation, streamflow and 38 other variables related to hydrologic, climatic, soil and vegetation characteristics for 554 catchments were analysed. To identify the dominant factors influencing the TE values at the continental and regional scales, Shapley Additive Explanations (SHAP) were employed. The Conterminous US is delineated into homogeneous regions using the Gaussian Mixture Model clustering technique, using TE values and the continental-scale dominant factors as input attributes. The dominant factors governing the P-Q interaction at each cluster are also determined. The results exhibit that the spatial variability in TE is delineated into eight distinct regimes, with the lowest and Highest P-Q interactions observed in mountainous snow-dominated regions and humid catchments, respectively, indicating the dominance of storage components and rainfall, respectively. The SHAP analysis further reveals that the combination of variables regulates P-Q interactions across clusters, with runoff timing, flow signatures, vegetation dynamics, and snow fraction emerging as important controls in different regions. Overall, the findings demonstrate that P-Q interactions vary systematically across hydroclimatic settings and are governed by region-specific combinations of climatic, hydrologic, and physiographic factors.}
}
@article{XIAO2026136566,
title = {Using stable isotope to depict 3 typical tree species’ water use in a subtropical forest through three consecutive hydrological years},
journal = {Journal of Hydrology},
volume = {680},
pages = {136566},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136566},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601663X},
author = {Xiong Xiao and Yong Zhang and Xinping Zhang and Jinzhao Liu},
keywords = {Extreme drought, Subtropical secondary forest, Stable isotope, Water use strategy, Ecological niche},
abstract = {Against global climate change, more frequent extreme droughts have profoundly altered water cycling and plant water use strategies in the soil–plant–atmosphere continuum (SPAC). The subtropical monsoon region suffers frequent droughts despite abundant precipitation. Based on in-situ observations (June 2022 ∼ May 2025) covering a centennial extreme drought, we analyzed δ2H and δ18O in precipitation, xylem water of three dominant tree species, 0 ∼ 20 cm soil water, and 20 ∼ 100 cm weathered layer water in a subtropical secondary forest in Hunan, China, while plant water sources were quantified using the MixSIAR model. Our results showed that extreme drought enhanced non-equilibrium fractionation in the SPAC, markedly lowering the soil and xylem water line slope. In summer and in the extreme drought year, shallow and desiccated 0 ∼ 20 cm soil forced plants to rely heavily on the weathered layers as a “lifesaving water source”, with utilization of 20 ∼ 60 cm strongly weathered layer exceeding 35% and 60 ∼ 100 cm weakly weathered layer exceeding 20% for all three species. Under drought stress, species exhibited divergent strategies: the evergreen broad-leaved tree C. camphora showed flexible “opportunistic” water use; the deciduous broad-leaved tree L. formosana combined deep water uptake and leaf abscission for drought resistance; the evergreen coniferous tree P. massoniana suffered the highest physiological vulnerability and widespread mortality due to rigid hydraulic structure and cavitation risk. Extreme drought was a key driver reshaping plant water niches, with stronger impacts on water use depths, interspecific competition, and community stability than ordinary seasonal drought. Conservation should optimize stand structure, mitigate soil erosion, and apply targeted interventions during extreme drought events.}
}
@article{JI2026136490,
title = {Groundwater response to ice loading as a potential contributor to glacier surge dynamics at Hispar Glacier, Karakoram},
journal = {Journal of Hydrology},
volume = {680},
pages = {136490},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136490},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015878},
author = {Shuting Ji and Guoliang Wang and Zhenzhong Zeng and Zhilin Guo and Xiuyu Liang},
abstract = {Basal water contributions to glacier surging remains poorly understood due to complex basal hydrology and multiple potential water sources, where groundwater may play an important role. Here we develop an analytical poroelastic groundwater flow model to examine whether changes in ice loading induce upward groundwater flux through subglacial sediments, thereby potentially increasing basal water pressure and accelerating glacier sliding. Using the DEM-derived thickness-change record, the model predicts downward groundwater flow during ice thickening and exfiltration toward the glacier bed during thinning. Contrary to the expectation that thicker ice promotes faster motion through greater driving stress, glacier velocity increased as ice thickness decreased during the 2014–2016 surge of Hispar Glacier in the Karakoram. Meanwhile, modeled flux maxima occur near the June and December 2015 peaks in a nearby Sentinel-1-derived surface-velocity record, which varies inversely with ice thickness changes. This first-order temporal agreement may indicate groundwater exfiltration as a basal-water source that could raise water pressure and facilitate sliding. Groundwater may therefore be an overlooked component of glacier-bed coupling and surge dynamics, and further investigation is needed to confirm the relationship.}
}
@article{HUANG2026136563,
title = {Nitrate source–pathway coupling concentration varies across seasons in contrasting land-use catchments},
journal = {Journal of Hydrology},
volume = {680},
pages = {136563},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136563},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016604},
author = {Xuan Huang and Yuting Xie and Yifan Shen and Xing Yan and Yuhang Zhang and Weiyue Shi and Jian Guo and Dongli She and Yongqiu Xia},
keywords = {Riverine nitrate loading, Source–pathwaycoupling, Optimal transport, Landscape connectivity, Nitrogen management},
abstract = {Riverine nitrate loading depends not only on how much each source supplies and which pathway carries it, but on how the two are coupled. Source apportionment and pathway partitioning quantify these components separately, but neither resolves which source reaches the stream through which pathway, so neither shows whether delivery is dominated by a few strong couplings or spread across many weak ones. Using entropy-regularised optimal transport, we coupled isotope-based source apportionment to hydrograph-based pathway partitioning in three sub-catchments of the Qinhuai River Basin representing individual traditional-agricultural, intensive-agricultural and urban sites, in dry and wet seasons. The model routes each source along its least-resistance pathways and resolves allocation to delivery pathways before in-stream attenuation. Coupling was most concentrated in the dry seasons of the traditional-agricultural and urban catchments, where a single sewage–baseflow link carried 29.9% and 30.7% of nitrate, and most diffuse in the traditional-agricultural wet season, where no link reached 20% in the baseline solution. The intensive-agricultural catchment showed no comparable seasonal separation, consistent with the lack of coincident source and pathway dominance within a season. Coupling concentration informed management priorities: the intensive-agricultural fertilizer–surface runoff link was 76–77% re-routable at the defined inflection intensity but carried only 2.9–4.6% of the load, whereas the larger sewage–baseflow link supplied 29.8–30.7% of dry-season nitrate yet was far less responsive to increased transport resistance. Coupling concentration may therefore serve as a case-specific screening diagnostic for prioritizing nitrate management.}
}
@article{HABIBI2026136466,
title = {A physics-informed, soft-causal ensemble deep neural network for robust probabilistic water quality assessment in arid regions},
journal = {Journal of Hydrology},
volume = {680},
pages = {136466},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136466},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015635},
author = {Keyvan Habibi and Mohammad Reza Nikoo and Reza Kerachian and Rouzbeh Nazari and Jiří Šimůnek and Amir H. Gandomi},
keywords = {Water quality index, Directed acyclic graph, Probabilistic deep learning, Uncertainty-aware modeling, Soft-causal learning},
abstract = {Because reservoirs are critical assets for water supply in arid and semi-arid environments, safeguarding these resources is essential. Water quality assessment in such systems therefore requires predictive models that are not only accurate but also interpretable and capable of quantifying uncertainty. In this study, a Physics-Based Soft-Causal Ensemble Probabilistic Deep Neural Network (PBSCEP-DNN) was developed to predict the Water Quality Index (WQI), using 16,096 field measurements from an AAQ-RINKO Conductivity-Temperature-Depth (CTD) profiler. The model was constructed using a Directed Acyclic Graph (DAG), ensuring that the network topology reflects hypothesized environmental dependency pathways, both direct predictive relationships and confounder-related influences, rather than an unrestricted, fully connected structure. The proposed framework’s novelty lies in combining a network architecture based on hypothesized environmental dependencies, regularized through an L2 penalty on direct-path weights, with a deep ensemble of five probabilistic neural networks to capture both point predictions and associated uncertainty in reservoir water quality dynamics. The proposed framework achieved RMSE = 1.324 ± 0.222, MAE = 0.452 ± 0.110, R2 = 0.795 ± 0.075, and empirical coverage of Prediction Interval Coverage Probability (PICP) = 0.996 ± 0.003 for nominal 95% prediction intervals, indicating conservative overcoverage. Rather than optimizing point-prediction accuracy alone, the PBSCEP-DNN offers a more physically grounded and uncertainty-aware alternative to purely data-driven prediction.}
}
@article{LAAYOUNE2026136503,
title = {Recirculation tracer tests in long uncased boreholes: a simple way to identify hydraulic conductivity},
journal = {Journal of Hydrology},
volume = {680},
pages = {136503},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136503},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016008},
author = {Adam Laayoune and Philippe Pasquier},
keywords = {Recirculation tracer test, Tracer concentration monitoring, Hydraulic conductivity, Hydraulic parameter estimation, Standing column well},
abstract = {Standing column wells are ground heat exchangers that offer significant energy-saving potential, yet their optimal design requires accurate site-specific hydrogeological data. While continuous groundwater recirculation tests are routinely performed for thermal assessments, their potential to characterize aquifer hydrogeological properties remains underexploited. In this study, we improve the exploitation of these tests by injecting a conservative tracer to estimate the effective hydrogeological parameters of a fractured aquifer. A field protocol was deployed in a 215 m deep well located in Varennes, Canada, where fluorescein was injected during continuous recirculation and monitored in real time. To interpret the tracer signal, a 2D-axisymmetric finite-element model simulating groundwater flow and solute transport was developed and coupled with an inverse optimization algorithm. The numerical model accurately reproduced the experimental breakthrough curve, capturing the early-time homogenization oscillations with high accuracy and a characteristic period of 31.3 min. This enabled the simultaneous estimation of the rock mass flow and transport properties, identifying hydraulic conductivity with high precision. The hydraulic conductivity estimated from the recirculation tracer test was consistent with independent pumping-test estimates obtained at the same site, demonstrating that the proposed method can recover realistic hydraulic properties from a simple operational test. These results show that this new tracer-test method can transform a routine recirculation procedure into a high-precision and reliable hydrogeological characterization tool.}
}
@article{SEMPER2026136555,
title = {How reporting cadence shapes hourly precipitation extremes},
journal = {Journal of Hydrology},
volume = {680},
pages = {136555},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136555},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016525},
author = {Marc Semper and Manuel Curado and Jose F. Vicent and Leandro Tortosa},
keywords = {Sub-hourly rainfall, Precipitation extremes, Temporal aggregation, Reporting cadence, Phase alignment, Station networks, Uncertainty envelope},
abstract = {Hourly precipitation products are often assembled from station records with heterogeneous sub-hourly reporting cadences, yet users rarely know how much of the resulting difference in extreme diagnostics reflects temporal support, clock-hour alignment, the aggregation implementation, or the temporal structure of the rainfall. We present a controlled coarsening framework that separates these four causes within a single experiment in which the meteorology is held fixed and precipitation mass is conserved. That separation, rather than the well-established attenuation of short-duration intensity under aggregation, is the contribution. Using three years (2023–2025, UTC) of 5-min observations from 30 AVAMET stations in eastern Spain, we coarsen the same records to 15-, 30- and 60-min reporting across all phase offsets and reconstruct hourly products by naive and by overlap-aware aggregation. For the 99th percentile of the hourly interval-rate maximum during wet hours, the relative difference reaches −69.6% at 60-min reporting, and −76.0% when reporting windows are aligned with clock hours, so it is not an artefact of phase shifts. It is strongly regime-dependent: −66.2% for temporally concentrated rainfall against −5.2% for distributed rainfall, which is almost cadence-invariant. A cadence- and regime-aware correction reduces systematic differences but leaves substantial residual uncertainty, and an independent replication at 30 DWD 1-min stations (2023–2024) reproduces the main cadence-dependent signatures of the mechanism. Hourly extreme diagnostics should therefore not be treated as directly comparable across stations unless temporal support, phase alignment, aggregation method and rainfall regime are accounted for.}
}
@article{ZHENG2026136591,
title = {Physics-guided virtual sensors for low-cost spatial inference of river water quality under sparse monitoring},
journal = {Journal of Hydrology},
volume = {680},
pages = {136591},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136591},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016884},
author = {Yue Zheng and Weitian Chen and Huihui Wang and Yiping Zhang and Yongchao Zhou and Raziyeh Farmani},
keywords = {River water quality, Sparse monitoring, Virtual sensor, Deep learning, Physics-guided neural network},
abstract = {Spatially distributed river water quality information is essential for effective monitoring and management. However, the cost of installing and maintaining in situ monitoring stations limits the spatial coverage of river water-quality observations. This study developed a physics-guided virtual sensor to reconstruct water quality at sparsely monitored sites using adjacent-station observations and meteorological data. A long short-term memory (LSTM) encoder-decoder was trained with a regularization term that penalizes disagreement with estimates from an analytical advection–dispersion model. The framework was trained and tested using hourly observations of conductivity, dissolved oxygen, ammonia nitrogen, and total phosphorus from five river monitoring stations during 2021–2023. Target-site observations from 2021 to 2022 were subsampled to simulate sparse monitoring during model development. Data from 2023 were reserved for independent testing, with target-site observations used only for performance evaluation. Across the four variables, the data-driven model improved Nash-Sutcliffe efficiency (NSE) by 4.2–27.4 % relative to the mechanistic model. Transport-consistency regularization provided a further 1.5–7.4 % improvement over the data-driven baseline, with the largest gain for ammonia nitrogen. The physics-guided model also showed lower performance variability and lower sensitivity to independent Gaussian perturbations of adjacent-station inputs. These results support the use of physics-guided virtual sensing to extend river water-quality monitoring coverage where continuous target-site measurements are unavailable.}
}
@article{LI2026136486,
title = {Constrained differentiable hybrid hydrologic modeling across multiple process backbones: accuracy gains and risks to physical consistency},
journal = {Journal of Hydrology},
volume = {680},
pages = {136486},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136486},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015830},
author = {Jiaoyang Li and Guoqiang Tang and Jun Xia},
keywords = {Streamflow prediction, Hybrid hydrological modeling, Differentiable parameter learning, Physical interpretability, Conceptual hydrological models},
abstract = {Differentiable parameter learning (dPL) has emerged as a promising strategy for integrating process-based hydrological models with deep learning, but its applicability across hydrological model structures remains unclear. Moreover, in hybrid models where process-based modules are jointly optimized without explicit module-level constraints, strong final streamflow performance does not necessarily imply that the process-based module remains hydrologically meaningful or contributes substantially to the final prediction. Here, we investigate these issues across eight conceptual hydrological models using the CAMELS dataset and develop a constrained differentiable hybrid framework to mitigate the degradation of the process-based module during joint training. Our results show that dPL is strongly backbone-dependent. Under a single-component configuration, it generally does not outperform traditional CMA-ES calibration, and its gains under a multi-component configuration vary markedly across model structures. More importantly, in unconstrained hybrid models, the final streamflow accuracy can remain high even when the process-based module is poorly calibrated, indicating that the post-processing LSTM may partially bypass the physical backbone. To address this failure mode, we introduce a constrained joint objective that explicitly incorporates the streamflow loss of the process-based module. This strategy substantially improves the realism of the process-based module while maintaining or improving overall predictive skill. The best-performing constrained hybrid model achieves a median Nash–Sutcliffe efficiency (NSE) of 0.742, exceeding that of the baseline LSTM (0.724). In arid basins, the constrained hybrid model with the MOPEX2 backbone attains a median NSE of 0.505, compared with 0.394 for the LSTM. Overall, this study identifies a key failure mode in differentiable hybrid hydrologic modeling and provides practical guidance for improving runoff prediction without hollowing out the physical backbone.}
}
@article{ZHANG2026136547,
title = {A coupled optical-thermodynamic framework for predicting freezing onset in unsaturated saline silty clay},
journal = {Journal of Hydrology},
volume = {680},
pages = {136547},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136547},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016446},
author = {Haojin Zhang and Haihua Zhang and Xianfeng Ma and Jiangu Qian and Eiji Fukuzawa},
keywords = {Freezing onset temperature, Unsaturated saline soil, Soil water phase transition, Polymer optical fiber sensing, Cold-region hydrology},
abstract = {The onset of ice formation in unsaturated saline porous media controls frost heave, water redistribution and hydrothermal property changes in cold-region soils, yet it remains difficult to define because pore water freezes progressively rather than at a single temperature. Here we combine polymer optical fiber (POF) sensing with thermodynamic modelling to identify and predict the ice-formation onset temperature in silty clay. The exposed optical fiber segment responds to abrupt changes in refractive index and scattering caused by pore-ice formation, providing an optical criterion that is distinct from the conventional temperature-plateau method. Cooling experiments on three silty clays show that, under salt-free conditions, the onset temperature increases with water content, whereas addition of NaCl produces a further depression that increases with salt concentration. These trends indicate that freezing onset is governed by coupled pore-scale confinement, adsorption/capillary pressure and solution thermodynamics. We therefore develop a generalized Clausius–Clapeyron model that integrates the Gibbs–Thomson curvature effect, adsorption/capillary pressure and water activity, while accounting for pore-size distribution and unsaturated pore filling through a critical water-filled pore radius and an effective pore radius. The model reproduces the measured onset temperatures across different water contents and NaCl concentrations. This optical–thermodynamic framework provides a physically consistent criterion for ice-formation onset in unsaturated saline soils and improves the prediction of phase-transition thresholds that regulate water redistribution, salt migration and hydrothermal connectivity in cold-region hydrological systems.}
}
@article{MATIN2026136493,
title = {Hydrologically constrained genetic programming for interpretable rainfall–runoff model discovery: A process–informed machine learning approach},
journal = {Journal of Hydrology},
volume = {680},
pages = {136493},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136493},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015908},
author = {Naila Matin and Herath Mudiyanselage Viraj Vidura Herath and Abhishek Saha and Lucy Marshall and Vladan Babovic},
keywords = {Genetic programming, Rainfall–runoff modelling, Process-informed machine learning, Conceptual hydrological models, Model structure discovery},
abstract = {Advances in machine learning have improved rainfall–runoff prediction, but integrating these capabilities with interpretable, process-based model structures remains an open challenge. This study seeks a middle ground between conceptual hydrological modelling and modern data-driven prediction by automating model structure discovery while retaining interpretability and hydrological consistency. We introduce HydroXGP (Hydrological Model eXplorer using Genetic Programming) to reduce reliance on legacy model choices and subjective a priori structural assumptions by learning model structure directly from data during optimization. The framework evolves models from a modular, process-based component library adapted from the open-source MARRMoT toolbox, making the search process-informed through reusable flux and routing components and hydrologically constrained by enforcing mass balance during simulation. GP jointly optimizes model structure and parameters, while each discovered model remains explicit and interpretable. Evaluation on the CAMELS-US dataset showed that a proof-of-concept test in a snow-dominated basin achieved strong performance over the out-of-sample test period (NSE=0.849), and, when transferred to a hydrologically similar basin, the learned structure retained useful predictive skill (NSE=0.724). Across 18 basins (one representative basin per U.S. hydrologic region), median NSE reached 0.702, generally outperforming the mean performance of an ensemble of conceptual benchmark models while remaining competitive with some regional LSTM baselines. The findings support a modelling perspective in which structural hypotheses can be revisited and adapted as new data, diagnostics, or environmental signals become available, enabling basin-specific configurations that evolve in response to changing information rather than relying on a single fixed template.}
}
@article{GRANATA2026136519,
title = {Deep learning meets spectral analysis: reproducing long-term persistence in synthetic streamflow},
journal = {Journal of Hydrology},
volume = {680},
pages = {136519},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136519},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016161},
author = {Francesco Granata and Fabio {Di Nunno} and Senlin Zhu},
keywords = {Synthetic streamflow generation, Temporal convolutional networks, Hurst exponent, Long-term persistence, Spectral analysis, Stochastic hydrology},
abstract = {Synthetic streamflow generation requires simultaneous reproduction of flow distributions and temporal dependence across multiple scales, including long-term persistence (LTP). This study evaluates a three-stage framework that combines latent-space generation with a temporal convolutional network (TCN), low-frequency spectral adjustment, and quantile-based rank reordering. The framework was applied to daily discharge records from 24 UK river basins and benchmarked against autoregressive moving average (ARMA), k-nearest-neighbor (k-NN), and long short-term memory (LSTM) generators. Marginal distributions were reproduced closely (median Kolmogorov-Smirnov statistic = 0.00069; 99th-percentile ratios = 0.986–0.999). The median absolute difference in the rescaled-range persistence estimate was 0.028, with 79% of basins within a tolerance of 0.05. Detrended fluctuation analysis (DFA) produced a median scaling-exponent difference of 0.076; Monte Carlo tests showed that part of the R/S-DFA discrepancy reflects estimator-specific finite-sample behavior. The same experiments indicate that a 0.05 tolerance is approximately a two-standard-deviation band at the 7,300-day synthetic-series length, and that shorter records tend to inflate persistence estimates. ARMA produced a statistically indistinguishable median R/S error (0.024). For the nine records with no missing days, the proposed framework and k-NN showed very similar paired low-flow spell-duration errors. The proposed framework is therefore not uniformly superior to simpler alternatives; its main value is the combination of close marginal matching with an explicit spectral mechanism for controlling long-term persistence. Remaining limitations include weaker short-lag autocorrelation reproduction and incomplete recovery of threshold-conditioned spell clustering.}
}
@article{FENG2026136511,
title = {Flood modeling incorporating spatially heterogeneous rainfall and nonlinear routing mechanisms},
journal = {Journal of Hydrology},
volume = {680},
pages = {136511},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136511},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016082},
author = {Jing Feng and Keke Zhou and Jianzhu Li and Hongdong Song and Benlong Zhao and Hao Wang},
keywords = {Rainfall-runoff relationship, Ensemble Rainfall-Runoff Analysis (ERRA), Spatially heterogeneous rainfall, Nonlinear routing, Flood simulation},
abstract = {The spatial heterogeneity of rainfall and nonlinear catchment routing are important factors affecting the accuracy of flood simulation, yet they remain inadequately represented in conventional conceptual models. This study proposes an integrated flood simulation framework that employs Ensemble Rainfall-Runoff Analysis (ERRA) to identify rainfall-runoff response characteristics, correct spatially heterogeneous rainfall inputs, and construct rainfall-intensity-dependent unit hydrographs. The framework was applied and validated in the XDY catchment, a 4420 km2 basin located in a semi-arid-semi-humid region. First, linear and nonlinear net rainfall-surface runoff response functions were derived using ERRA, and mean areal precipitation was corrected using spatial response efficiency weights. The identified response functions were then incorporated into the Nash Instantaneous Unit Hydrograph (Nash IUH) to represent nonlinear routing under different rainfall intensities. The improved routing scheme was further coupled with the SCS-CN runoff generation module and a subsurface flow simulation module to establish an integrated flood simulation model. For five independent validation flood events, the Nash-Sutcliffe Efficiency (NSE) ranged from 0.89 to 0.95, the relative error in peak discharge ranged from −8.93% to 23.31%, the relative error in runoff volume ranged from 1.81% to 18.91%, and the peak timing error ranged from −3 to 2 h. Scenario comparisons showed that both the spatial rainfall correction and the ERRA-based refinement of the unit hydrograph improved model performance. The proposed model provides a parsimonious and potentially applicable approach for flood simulation in medium-sized catchments.}
}
@article{JING2026136562,
title = {Dynamic reliability analysis via stochastic unsteady seepage for high core-wall rockfill dams},
journal = {Journal of Hydrology},
volume = {680},
pages = {136562},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136562},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016598},
author = {Bo Jing and Mingyang Xu and Bin Xu and Yang Zhou and Jianan Shao and Rui Pang},
keywords = {Dynamic reliability, Stochastic unsteady seepage, Rockfill dam, Conditional reliability, Spatial variability},
abstract = {Seepage safety of high core-wall rockfill dams during impoundment and drawdown is affected by uncertain hydraulic-gradient responses induced by the spatial variability of hydraulic parameters. This study develops a dynamic reliability analysis framework for high core-wall rockfill dams under stochastic unsteady seepage conditions. First, the maximum hydraulic gradient in each material zone is selected as the controlling seepage response. Second, the probability density evolution equation (PDEE) is formulated based on probability conservation and solved using the exponential-spectral mapping method (ESMM) to obtain stochastic response distributions. Furthermore, the equivalent extreme-value event method and two-dimensional joint response distributions are used to evaluate whole-process dynamic reliability and conditional reliability among materials. Finally, the framework is applied to a 300 m-class high core-wall rockfill dam. Results show that high-probability regions of hydraulic-gradient responses migrate toward larger values during impoundment, and reliability reduction mainly occurs during water-level rising stages. During drawdown, most hydraulic gradients decrease, whereas the transition layer fluctuates due to delayed hydraulic-head dissipation and seepage-path redistribution. Joint response distributions provide additional information on the probabilistic relationships between the core wall and adjacent seepage-control materials. The proposed framework supports dynamic reliability assessment and operational safety analysis of high core-wall rockfill dams.}
}
@article{JIAO2026136538,
title = {Nitrate attenuation regulated by hydrofacies mean length in heterogeneous riparian aquifers},
journal = {Journal of Hydrology},
volume = {680},
pages = {136538},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136538},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016355},
author = {Tian Jiao and Jinxi Song and Jing Yang and Yan Zhang and Bing Xu and Ming Ye},
keywords = {Numerical model, Nitrate attenuation, Heterogeneous aquifer, Hydrofacies mean length, Solute spreading},
abstract = {Hydrofacies spatial organization strongly regulates groundwater flow and reactive transport in riparian aquifers, yet the influence of hydrofacies mean length on nitrate attenuation remains poorly understood. We developed a two-dimensional reactive transport model to investigate the effects of hydrofacies mean length on nitrate attenuation in a heterogeneous riparian aquifer under losing-river conditions. Five mean-length levels were combined with five hydrofacies compositions with varying proportions of sand, coarse sand, and silt, yielding 25 hydrofacies configurations. Results showed that increasing hydrofacies mean length generally enhanced river-aquifer exchange, nitrate transport, and nitrogen transformation, with magnitude of these responses strongly dependent on hydrofacies composition. Across the five hydrofacies compositions, increasing mean length from 0.2 to 2.0 times the baseline increased denitrification by 32–84% and nitrate removal efficiency by 8–47%. Coarse-sand-rich aquifers exhibited larger absolute changes in nitrate transport and nitrification, consistent with enhanced transport through more persistent high-permeability pathways, whereas silt-rich aquifers showed greater relative sensitivity to mean length, partly reflecting their lower baseline transport rates. The strongest enhancement in denitrification and the highest nitrate removal efficiency tended to occur near intermediate hydrofacies compositions, where enhanced solute transport coincided with sufficient organic-rich silt to support denitrification. Solute-spreading analysis further showed that increasing hydrofacies mean length enhanced plume spreading across all hydrofacies compositions, but larger increases in spreading did not necessarily translate into greater improvements in nitrate removal efficiency, as the response also depended on organic-rich silt abundance. Thus, hydrofacies mean length influenced nitrate attenuation by modifying hydrofacies persistence, transport pathways, and solute redistribution, while hydrofacies composition modulated the resulting biogeochemical response.}
}
@article{DAMONTI2026136514,
title = {Probabilistic sensor placement in water distribution networks: a Dynamic Residual Masking framework using game-theoretic pseudo-Jacobians},
journal = {Journal of Hydrology},
volume = {680},
pages = {136514},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136514},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016112},
author = {Elvio Damonti and Giancarlo Bernasconi},
keywords = {Explainable artificial intelligence, Leakage detection, Shapley values, Hydroinformatics, Probabilistic modeling},
abstract = {Optimal sensor placement in Water Distribution Networks (WDNs) traditionally relies on rigid sensitivity matrices requiring computationally prohibitive white-box hydraulic simulations. While data-driven alternatives utilizing game-theoretic machine learning, specifically, Shapley Additive Explanations (SHAP), offer computational relief, they inherently suffer from a “dimensional trap.” Raw SHAP values mathematically inherit the target variable’s dimensions, creating a dimensional incompatibility when applied to network hydraulics. To resolve this, a fully data-driven, probabilistic sensor placement framework is proposed. Random Forest (RF) regressors are trained on stochastic, non-stationary network data to extract these game-theoretic marginal contributions. Crucially, a novel “pseudo-Jacobian” transformation is derived that restores the physical dimensional integrity of the SHAP-derived sensitivities. These mathematically valid sensitivities are then mapped through a Gaussian noise Cumulative Distribution Function (CDF) to create a strict estimated probability of detection landscape, abandoning arbitrary deterministic thresholds. Finally, a Dynamic Residual Masking algorithm is introduced. A soft-masking greedy search tracks unmet network estimated probabilities to naturally repel highly correlated sensor pairs, commonly referred to in optimization literature as the “evil twin” phenomenon. Validation on the publicly available 500-scenario Hanoi WDN benchmark demonstrates that the proposed framework bypasses the computational bottleneck of traditional finite-difference simulations. Furthermore, the methodology achieves a 91.60% accuracy in faulty/non-faulty scenario detection with highly sparse coverage (5 sensors), closely approaching the 93.80% accuracy yielded by full network coverage (31 sensors). Concurrently, a 2.5% reduction in false positives is achieved compared to the classical explicit-Jacobian baseline. This establishes a rigorous, mathematically valid bridge between game-theoretic artificial intelligence and physical hydraulic engineering.}
}
@article{TANG2026136586,
title = {Dynamic-programming-based subwaveform retracking with along-track constraints for inland river water level retrieval from Sentinel-3 altimetry},
journal = {Journal of Hydrology},
volume = {680},
pages = {136586},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136586},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016835},
author = {Mengran Tang and Lihua Xiong},
keywords = {Dynamic programming, Subwaveform retracking, River water level retrieval, Sentinel-3 altimetry, Amazon basin},
abstract = {Sentinel-3 radar altimetry provides an important data source for inland water level monitoring, yet accurate retrieval over rivers remains difficult because contaminated waveforms complicate subwaveform identification. This study proposes a dynamic-programming-based subwaveform retracking (DPSR) method, which transforms conventional footprint-wise retracking into an along-track global optimization problem, enabling the selection of physically consistent subwaveforms from contaminated observations for river water level retrieval. DPSR is evaluated over the Amazon basin with 78 gauge-virtual station (VS) pairs and the Poyang Lake basin with 39 gauge-VS pairs, and is compared with several existing retracking methods. The results indicate that DPSR outperforms all benchmark methods, yielding a median RMSE of 0.41 m, which decreases by 0.02–1.2 m compared with other methods, while improving data availability by about 39% relative to benchmark retrackers. Moreover, DPSR performs particularly well in narrow rivers. The proposed method highlights the value of integrating spatial constraints into subwaveform interpretation and offers a robust solution for satellite altimetry retrieval of river water levels in complex environments.}
}
@article{WANG2026136506,
title = {Hysteretic response of water temperature and persistent thermal regime shift under extreme hydrological pulses},
journal = {Journal of Hydrology},
volume = {680},
pages = {136506},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136506},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016033},
author = {Yi Wang and Liqin Zhu and Baoshun Kan and Xiaolin Zhu and Haozhi Wang and Yongtao Zhu and Tao Wei and Xueping Huo and Peng Jiang},
keywords = {Extreme flood, River water temperature, Yongding River, Quantitative attribution, Steady-state shift},
abstract = {Unlike the gradual evolution of river water temperature under long-term climatic forcing, extreme floods impose high-intensity hydrological pulses that can rapidly alter river heat exchange and boundary conditions. Yet the abrupt cooling, delayed recovery and post-flood thermal anomalies induced by such pulses remain poorly constrained in ecohydrology. Here we use the July 2023 “23.7” extreme flood in the Haihe River Basin as a natural experiment. We analysed long-term water-temperature and meteorological records from 2009 to 2022, together with 2023 discharge and suspended-sediment data from the Yongding River Basin. We then combined an air-temperature baseline regression, lagged partial least-squares regression and a thermal recovery ratio (TRR) to quantify event-scale thermal responses and their drivers. The flood caused marked cooling within 24–48 h from the gorge reach to the downstream plain reach, with maximum decreases of 22.22–27.76% and cooling rates of 2.13–4.05 °C d−1. Relative to the non-flood meteorological baseline, discharge-related hydrodynamic changes, together with thermal inertia, explained most anomalous temperature fluctuations, whereas sediment-related contributions increased downstream. During recovery, river temperature shifted from upstream under-recovery to downstream over-recovery. TRR values at the downstream estuarine gate exceeded 1.3, and recovery-period temperatures were 1.9–3.1 °C higher than those in 2022. Google Earth Engine (GEE)-based evidence of post-flood changes in bank-zone wetness, vegetation condition and surface exposure further suggests that downstream over-recovery was associated with altered bank-zone and hydrological boundary conditions. These findings identify an event-scale sequence of abrupt cooling, delayed recovery and thermal over-recovery, providing evidence for assessing river thermal risk under intensifying hydrological extremes.}
}
@article{SI2026136461,
title = {Toward AI-driven digital twins for metropolitan floods: A conditional latent dynamics network surrogate of the shallow water equations},
journal = {Journal of Hydrology},
volume = {680},
pages = {136461},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136461},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015581},
author = {Phillip Si and Yuan Qiu and Omar Sallam and Jeremy Feinstein and Ziang He and Eugene Yan and Peng Chen},
keywords = {AI-driven digital twins, Neural surrogate modeling, Shallow water equations, Conditional latent dynamics networks, Terrain conditioning, Real-time flood forecasting},
abstract = {AI-driven flood digital twins demand fast hydrodynamic surrogates for ensemble forecasting and observation assimilation. Yet even GPU-accelerated two-dimensional shallow water equation (SWE) solvers still require ∼55 minutes per 96-hour run on a ∼4.2-million-active-cell metropolitan basin (the Des Plaines River basin at 30m resolution), making such workloads prohibitive at native resolution. We present the Conditional Latent Dynamics Network (CLDNet): a low-dimensional latent neural ODE driven by rainfall, paired with a coordinate-based decoder conditioned on static terrain (elevation, slope, Manning roughness) that reconstructs depth and discharge at arbitrary query points. Pointwise decoding decouples memory from grid size and handles irregular watersheds natively, enabling metropolitan-scale training on a single compute node and direct queries at exact gauge coordinates without raster snapping. We evaluate CLDNet on a synthetic 250,000-cell Texas benchmark and on a new Des Plaines case study of 94 real-rainfall Stage IV storms whose reference simulator we validate against United States Geological Survey (USGS) gauges during the April 2013 flood-of-record (Nash–Sutcliffe efficiency 0.57–0.94 on mean-recentered water-surface elevation). CLDNet reduces the relative root-mean-squared error of an unconditional baseline by 1.7–2.3×, outperforms regular-grid VAE–ConvLSTM and FNO baselines on the Texas benchmark (both presuppose a Cartesian grid and do not apply to the irregular Des Plaines watershed), reaches a critical success index of ≈81% at the 0.5m inundation threshold, and produces a full 96-hour basin-wide forecast in ∼29 seconds—a ∼115× speedup. Finally, we demonstrate that CLDNet’s compact latent state supports online observation coupling: using the Latent Dynamics Ensemble Score Filter (LD-EnSF), we assimilate water-depth observations at gauge locations into the surrogate’s latent dynamics and recover a mean Nash–Sutcliffe efficiency of 0.69 against USGS observations at six held-out gauges, from −1.03 for the rainfall-perturbed open-loop forecast, realizing the observation-update step required of an AI-driven flood digital twin.}
}
@article{ZHANG2026136522,
title = {Spatiotemporal evolution and driving mechanisms of superposition effects of rainfall-induced urban waterlogging and levee breach flooding},
journal = {Journal of Hydrology},
volume = {680},
pages = {136522},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136522},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016197},
author = {Ye Zhang and Xin Su and Guanghua Qin and Leizhi Wang and Jinhui Li and Lingjie Li and Yintang Wang and Xiting Li},
keywords = {Coupled riverine–pluvial flooding hazards, Risk superposition effects, Explainable machine learning, XGBoost-SHAP, Attribution analysis},
abstract = {Extreme rainfall and rapid urbanization have significantly exacerbated coupled riverine–pluvial flooding hazard interactions in urban areas, driven by the joint effects of pluvial flooding, river flooding, and levee instability. However, existing studies fall short of fully revealing the nonlinear interaction effects, hazard sources, and underlying driving mechanisms of “Pluvial flooding – Levee breach – Urban waterlogging” coupled riverine–pluvial flooding hazards. To address this gap, this study proposes an integrated framework using explainable machine learning to quantify and attribute the hazard superposition effects of this specific coupled riverine–pluvial flooding hazard chain. Taking the Yundong polder area in Wuxi City as a typical case study, we constructed single-rainfall, single-levee-breach, and coupled riverine–pluvial flooding hazard scenarios under recurrence intervals ranging from 20 to 200 years. By coupling hydrodynamic modeling with the Flood Superposition Index and Flood Superposition Increment, we categorized three types of superposition phenomena and seven classes of dominant-factor hazard zones. Combined with a coupled riverine–pluvial flooding hazard interaction transfer matrix and the XGBoost-SHAP approach, we quantitatively characterized the spatiotemporal evolution of hazard interaction types, as well as their dominant drivers and threshold behavior. The results indicate that coupled riverine–pluvial flooding interaction is not a simple linear combination of independent rainfall and levee breach events but exhibits pronounced nonlinear amplification effects under high recurrence intervals; the superposition effects show substantial spatiotemporal heterogeneity, characterized by hazard lag effects, severe inundation near the breach, strong amplification at the impact margin, and shifts in hazard attributes with increasing recurrence intervals; furthermore, the compound superposition effects are jointly governed by topography, distance to the breach, pluvial inundation depth, and breach inundation depth, with dominant drivers gradually shifting from breach dynamic factors to topographical factors under extreme scenarios. Overall, this study reveals the evolution and driving mechanisms of coupled riverine–pluvial flooding hazard interactions, supporting urban flood risk management and mitigation.}
}
@article{YANG2026136550,
title = {Soil evaporation dominates shifts in evapotranspiration seasonality in the Yangtze River Basin},
journal = {Journal of Hydrology},
volume = {680},
pages = {136550},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136550},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016471},
author = {Zelong Yang and Xiaomang Liu and Kaiwen Wang and Kang Liang and Zhengjie Yin and Changming Liu},
keywords = {Evapotranspiration components, Seasonal timing, Seasonal concentration, Seasonality decomposition, Yangtze River Basin},
abstract = {Understanding the seasonal dynamics of evapotranspiration (ET) is essential for assessing intra-annual water availability and regional water security. Although widespread shifts in ET seasonality have been well documented, how individual ET components shape these shifts remains poorly understood. Here, we used two metrics—the center of mass concentration (CMC) and center of mass timing (CMT)—to characterize the seasonality of ET and its components across the Yangtze River Basin during 1980–2023. A novel decomposition framework was developed to quantify the contributions of individual components to changes in ET seasonality (ΔCMC and ΔCMT). The results show that ET in the Yangtze River Basin has shifted toward an earlier and less concentrated seasonal regime. Decomposition analysis demonstrates that soil evaporation (Eb) is the largest contributor to shifts in both seasonal ET concentration and timing, contributing 47% and 57% to the ΔCMC and ΔCMT of ET at the basin scale, respectively. In contrast, although vegetation transpiration (Et) is the largest ET component in the basin and exhibits seasonal changes consistent with ET, its contributions to ET seasonality shifts (42% and 35%) are smaller than those of Eb. This is because the increasing magnitude of Et amplifies its intrinsically later and more concentrated seasonal characteristics relative to ET, thereby partially offsetting the contribution arising from its own seasonal shifts. These results show that the effects of ET components on ET seasonality shifts depend not only on changes in their magnitude and seasonality, but also on their seasonal phase relationships with total ET. Overall, our findings provide new insights into the mechanisms through which individual ET components drive ET seasonality shifts.}
}
@article{WANG2026136473,
title = {Spatiotemporal evolution and concentration of global meteorological drought from a three-dimensional object-based perspective},
journal = {Journal of Hydrology},
volume = {680},
pages = {136473},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136473},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015702},
author = {Heng Wang and Fuqiang Wang and Chong-Yu Xu and Heng Zhao and Shengzhi Huang and Huan Yang and Honglu Zhang and Lanbo Cui and Yutian Du},
keywords = {Meteorological drought, 3-D drought object, Area–duration, Drought burden, Atmospheric evaporative demand},
abstract = {Drought is a major hydroclimatic hazard, but conventional local or regional indicators can obscure how individual drought events connect and evolve across space and time. Here we track global meteorological drought as three-dimensional (3-D) objects using the 6-month Standardized Precipitation Evapotranspiration Index (SPEI-06) for 1901–2024. We identify 5,822 objects across global land. Compared with early 20th-century levels, the annual drought-object count declined by approximately 20%, whereas the annual total area–duration (AD) increased by about 40%. The 10% of objects with the highest AD account for 75.5% of total AD and 77.0% of cumulative severity. The objects fall into four recurring morphological types, with Type III comprising 19.0% of objects but contributing 50.1% of total AD. Most objects are precipitation-dominant, but the mean relative contribution of atmospheric evaporative demand (AED) is 7.28 percentage points higher in the top 10% by AD than in the remaining objects. Together, these results indicate that global meteorological drought burden is increasingly concentrated in fewer, larger, and longer-lived events, highlighting the value of connected drought-object metrics for drought monitoring and water-resource risk assessment.}
}
@article{CHEN2026136489,
title = {Hierarchical source-zone inversion and century-scale transport interpretation of landfill-derived groundwater contamination},
journal = {Journal of Hydrology},
volume = {680},
pages = {136489},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136489},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015866},
author = {Yang Chen and Yun Chen and Haijian Xie and Zhenxing Shi and Yunmin Chen and Jiawei Wu and Minmin Luo and Yong Xu and Shuang Zhao and Lili Zhu},
keywords = {Groundwater contamination, Source-zone inversion, Contaminant transport, Pollution control, Stochastic repeatability},
abstract = {Identifying source zones of landfill-derived groundwater contamination is challenging when multiple pollutants coexist, monitoring data are sparse, and source geometry is uncertain. This study developed a hierarchical framework linking multivariate screening, analytical inversion, and transport-constrained numerical modelling. Monitoring data for 24 pollutants were screened by significance testing, cluster analysis, and principal component analysis, from which an Aggregate Pollutant Concentration (APC) index was derived. Analytical APC-PSO inversion reduced the area-searching reference from 0.360 to 0.153 km2, and PTNS-PSO refinement defined a 0.108-km2 numerical search area, representing approximately 69.9% contraction rather than independently validated source geometry. Across 50 fixed-setting APC-PSO runs, reconstruction MSE ranged from 0.007 to 0.015, and the nominal 90% source-center dispersion ellipse had semi-axes of 99.3 and 52.7 m. Alternative APC constructions shifted the source centers by 23.4–39.8 m. A controlled analytical semi-synthetic benchmark produced configuration-dependent median mean source-location errors of 36.9–118.5 m. Conditional century-scale simulations showed that COD and chloride co-varied as early leachate indicators, whereas ammonia nitrogen and Pb exhibited persistent co-migration; ethylbenzene showed stronger spatial variability. Engineered barriers reduced concentration amplitudes without eliminating localized leakage, and fault-related migration remained important. Analytical and deterministic hydraulic-conductivity sensitivity tests characterized selected scenario dependence. The framework supports candidate-zone prioritization and pathway- and timescale-based monitoring, subject to source non-uniqueness and the prescribed hydrogeological conditions.}
}
@article{ZHAO2026136526,
title = {A two-stage framework integrating information entropy and machine learning for rapid pollution source identification in looped river networks},
journal = {Journal of Hydrology},
volume = {680},
pages = {136526},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136526},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016239},
author = {Lehao Zhao and Jiabiao Wang and Tongtiegang Zhao and Xiaohong Chen},
keywords = {Pollution source identification, Information entropy, Machine learning, Looped river network},
abstract = {Rapid source identification of sudden water pollution incidents in looped river networks remains challenging because of the complex connectivity, multiple transport pathways, and mixing at junctions. Pollution source identification has been widely studied in both surface water and groundwater systems, but studies focusing specifically on looped river networks remain limited. To address this gap, this study develops a two-stage framework integrating information entropy (IE) and machine learning (ML). Concentration and discharge time series measured at monitoring stations are first transformed into IE values, making the data more compact and easier to process. In the first stage, the IE values are used as inputs to ML models to identify the river containing the pollution source. In the second stage, the IE values are used to establish an IE-based empirical formula (IE-EF) that links IE to the exact source location in the identified river. The case study shows that the accuracy of river identification (RI) exceeds 98% in the first stage. In the second stage, the location identification (LI) error is generally less than 1 km. The proposed framework also demonstrates good stability and can support emergency water-quality management in looped river networks.}
}
@article{SUN2026136590,
title = {Tracing soil–water signatures from contrasting land uses in low-flow streamwater of a mixed headwater catchment},
journal = {Journal of Hydrology},
volume = {680},
pages = {136590},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136590},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016872},
author = {Zhixiang Sun and Junfang Cui and Xiangyu Tang and Lei Chen and Zhenyao Shen and Mohammad Sadegh Askari and Jialiang Tang},
keywords = {Low flows, DOM fluorescence, Stable water isotopes, Bayesian mixing model, Land-use type, Hydrological connectivity},
abstract = {Baseflow sustains water delivery from headwater catchments during non-event conditions and low flows. However, in mixed land-use headwater catchments, how land-use-related soil–water storage signatures are represented in low-flow streamwater and vary seasonally remain poorly understood. To address this gap, a two-year study involving monthly monitoring of a hilly purple-soil headwater catchment was conducted. We employed a combination of dissolved organic matter (DOM) fluorescence, stable water isotopes, and Bayesian mixing analysis to characterize source composition in low-flow streamwater, characterize temporal variation in dominant source signatures, and assess depth-related soil–water signatures under baseflow-dominated conditions. This study showed that orchard, sloping farmland, and paddy soil waters formed the main source-signature group, with a summed mean posterior attribution of 62.9% across the 19 retained samples, and summed monthly posterior-median attributions ranging from 52.7% to 72.8%, compared with a mean attribution of 10.7% to sampled valley shallow groundwater (monthly posterior-median range: 4.7%-26.1%). The dominant-source pattern showed seasonal variation among orchard, sloping farmland, and paddy soil waters, with estimated layer attributions favoring shallow layers (10 cm) in orchard and sloping farmland and middle layers (20–30 cm) in paddy; exploratory analyses indicated associations with bulk density and DOC. The findings indicate that different land-use types are associated with distinct soil–water storage signatures in low-flow streamwater, providing a basis for evaluating how future land-use changes may influence low-flow hydrological functioning.}
}
@article{HUANG2026136542,
title = {Trends in the frequency and duration of high flow events across climates},
journal = {Journal of Hydrology},
volume = {680},
pages = {136542},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136542},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016392},
author = {Amee Huang and Mercy Gijima and Caleb Dykman and Rory Nathan and Conrad Wasko},
keywords = {Streamflow, High flow, Flood, Trend, Duration, Australia},
abstract = {Flood events play a critical role in infrastructure design, floodplain management, water supply and natural ecology. While large floods are a risk to life and infrastructure, smaller flood events, here termed high flow events, are essential for maintaining biodiversity of wetlands and filling our water supplies. With climate change altering extreme rainfall magnitude, frequency, and timing there is a need to understand the impact of these changes on catchment flow response. Globally, studies have generally focused on changes in flood magnitude, and the drivers of these changes, and there remains a gap in understanding the historical changes in the frequency and duration of high flow events – those critical for sustaining ecosystem health and water supply. Here, using a set of 476 long record streamflow gauging stations across the continent of Australia, which span a wide range of climate zones, we investigate the trend in the frequency of high flow events and their duration. We find that, across most arid and temperate regions, the frequency of high flow events has decreased and their duration shortened, suggesting a reduction in water availability. In the tropics, there have been increases in the frequency of high flow events. Testing the robustness of the historical trends to the assumptions made in the analysis, we find that the rarer the event, the more likely it is to be increasing in frequency. These results provide some evidence that climate change is impacting both streamflow magnitude and frequency, which has significant implications for water supply, as well as the health of our ecological and environmental systems.}
}
@article{ZHAO2026136510,
title = {The impact of numerical error on hydrological model performance},
journal = {Journal of Hydrology},
volume = {680},
pages = {136510},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136510},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016070},
author = {Jianfei Zhao and Yanan Duan and Jialu Huang and Yiming Hu and Binquan Li and Jun Wang and Zhongmin Liang},
keywords = {Numerical error, Structure consistency, Model performace, Xinanjiang model, Convergence validation, CAMELS dataset},
abstract = {The simple yet crucial question of what impact numerical error has on performance of hydrological model has not received consistent answers. Discrepancies in previous studies can be attributed to model structural changes and insufficient watershed sample sizes. In this study, we focus on the Xinanjiang model, a widely used hydrological model in China. Two mathematical forms are considered: the original discrete equation form (DTE-XAJ), which prone to numerical error, and the differential equation form (ODE-XAJ), which serves as an reference with controlled numerical error. To assess structure consistency, we propose a convergence validation method by gradually shorting time step of the DTE-XAJ model and checking for convergence to numerical solution of the ODE-XAJ model. To address sample size limitations, we apply both models to 547 watersheds from the CAMELS dataset. The results show that: (1) state variables and fluxes of the DTE-XAJ model converge to those of the ODE-XAJ model under time step refinement, demonstrating structural consistency and the effectiveness of the convergence validation method; (2) numerical error significantly degrades Xinanjiang model performance during both calibration and validation period, meaning its negative effects cannot be fully compensated by the calibration procedure; (3) controlling numerical error leads to systematic performance improvements even for a mature model such as XAJ, providing empirical evidence of its non-negligible contribution to model uncertainty. This study proposes the convergence validation method to rigorously assess structural consistency, providing a theoretical foundation for future research. The findings underscore the importance of addressing numerical error in hydrological models.}
}
@article{WANG2026136517,
title = {Pore-network structure and transport responses across textures and salinization levels in seasonally frozen saline soils: evidence from CT scanning and lattice Boltzmann simulations},
journal = {Journal of Hydrology},
volume = {680},
pages = {136517},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136517},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016148},
author = {Fan Wang and Jianmin Bian and Zhiqi Gu and Dongmei Ruan},
keywords = {Salinization, Freeze–thaw cycles, Hydraulic characteristics, CT scanning, LBM},
abstract = {Salinization alters soil pore architecture and transport behavior in seasonally frozen regions; however, the relationships between three-dimensional pore structure and pore-scale flow and solute spreading remain poorly understood. We combined high-resolution X-ray computed tomography, pore-network analysis, and lattice Boltzmann simulations on six undisturbed cores representing three soil textures and two salinization levels, collected after spring thaw in western Jilin, China. A 600 × 600 × 600 voxel representative elementary volume was used for pore-scale characterization. Intrinsic permeability ranged from 2.56 × 10−11 to 3.88 × 10−10 m2 and was higher in the heavily salinized core of each texture pair. Longitudinal dispersion ranged from 1.51 × 10−9 to 2.83 × 10−9 m2 s−1, exhibiting the same heavy-to-light ordering. Heavily salinized cores consistently exhibited higher specific surface area, two-dimensional and three-dimensional fractal dimensions, and anisotropy, along with lower sphericity, whereas coordination number showed no consistent directional response across textures. Intrinsic permeability was most strongly correlated with anisotropy (Spearman ρ = 1.00, p = 0.003); associations involving dispersion were weaker, and the reduced redundancy analysis was not significant. Comparison with laboratory and field measurements revealed that the salinization-related contrast in flow capacity reversed at larger scales, while dispersion maintained the same ordering from the pore to laboratory scale but not at the field scale. Longitudinal dispersion increased sublinearly to approximately linearly with observation scale (n = 0.71–1.05). These results demonstrate that pore geometry provides a valuable structural basis for interpreting scale-dependent water and solute transport in seasonally frozen saline soils.}
}
@article{JIA2026136545,
title = {Projected droughts readily trigger vegetation decline},
journal = {Journal of Hydrology},
volume = {680},
pages = {136545},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136545},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016422},
author = {Zixu Jia and Tao Lin and Xiangzhong Guo and Faith Ka {Shun Chan} and Lichang Yin and Hongkai Geng and Yicheng Zheng and Junmao Zhang and Yuan Chen and Meixia Lin and Jing Lin and Yuqin Liu},
keywords = {Terrestrial water storage, Vegetation responses, Drought trigger thresholds, Climate change scenarios},
abstract = {Drought is intensifying under a warming climate, while the lag of vegetation response and the drought trigger thresholds for relative vegetation loss remain insufficiently quantified. Here we provide a global assessment of vegetation responses to the Terrestrial Water Storage Drought Severity Index (TWS_DSI) under historical and future climate scenarios. Using five vegetation indicators, including Leaf Area Index (LAI), Fraction of Photosynthetically Active Radiation (FPAR), Normalized Difference Vegetation Index (NDVI), kernel Normalized Difference Vegetation Index (kNDVI), and Gross Primary Productivity (GPP), we quantified their lagged responses to drought during the historical period. The mean optimal lag times ranged from 8.20 months for LAI to 10.59 months for NDVI, with FPAR (8.78 months), GPP (9.80 months), and kNDVI (10.42 months) showing intermediate lag responses. Based on future LAI simulations under the SSP126, SSP370, and SSP585 scenarios, the mean lag varied from 5.15 to 10.48 months. At predefined vegetation loss levels (≤40th, ≤30th, ≤20th, ≤10th), we identified the drought trigger thresholds for vegetation decline and mapped their spatial variability. Compared to the historical baseline, the average drought trigger thresholds increased by 30.0%, 36.3%, and 35.3% under the SSP126, SSP370, and SSP585 scenarios, respectively, indicating heightened vulnerability whereby even milder drought conditions in the future could trigger vegetation decline. Our findings characterize the temporal lags, threshold behavior, and projected changes of vegetation responses to terrestrial water deficits, providing a scientific basis for assessing ecosystem vulnerability and informing targeted ecological conservation and climate adaptation strategies.}
}
@article{LUTONSKY2026136500,
title = {Deep learning with upstream-aware terrain representations and rainfall adapter for generalizable pluvial flood prediction},
journal = {Journal of Hydrology},
volume = {680},
pages = {136500},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136500},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015970},
author = {Thomas Lutonsky and Viktor Birschitzky and Stefan Jeschke and Andreas Buttinger-Kreuzhuber and Nils Wandel and Daniel Cornel and Viola Haase and Reinhard Klein and Jürgen Waser and Michael Wimmer},
keywords = {Pluvial flooding prediction, Deep learning, Data-driven modeling, Two-stage training},
abstract = {Deep learning-based surrogate models can substantially accelerate pluvial flood simulations. However, most existing approaches struggle to generalize across heterogeneous terrains or modified topographies, limiting their applicability for real-world flood risk assessment unless retrained for each specific terrain. In this work, we investigate how deep learning flood surrogates can be designed to achieve robust spatial generalization across previously unseen terrain configurations without retraining. We train an attention-enhanced U-Net on diverse terrain and introduce upstream-aware input maps that propagate terrain properties into downstream regions, allowing the model to capture long-range spatial dependencies and supporting the learning of generalizable spatial features. In addition, we add architectural design choices to improve the model’s capacity to generalize beyond the training domain. We further propose a two-stage training strategy with an adapter-like rainfall encoder that enables efficient adaptation to previously unseen rainfall intensities while preserving spatial generalizability. The resulting model predicts maximum water depths and is evaluated on unseen catchments in Germany, Austria and Denmark, as well as on artificially modified terrains, such as terrains with added dikes. Our results demonstrate that combining a large training dataset with upstream-aware terrain representations and a generalization-oriented architectural design enables accurate flood predictions across unseen terrains, reaching an RMSE of 0.05m and CSI0.3 of 0.83 over all test domains.}
}
@article{ZHOU2026136509,
title = {HydroTreeNet: differentiable hydrological process trees for physically consistent rainfall–runoff modeling},
journal = {Journal of Hydrology},
volume = {680},
pages = {136509},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136509},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016069},
author = {Xuerui Zhou and Baowei Yan and Jianbo Chang and Shixiong Du and Dongxu Yang and Mingbo Sun},
keywords = {Differentiable hydrological modeling, River-network routing, Mass consistency, Process-constrained neural networks, Complementary allocation, Diagnostic modeling},
abstract = {Differentiable hydrological models increasingly combine process structure with neural parameterization, yet jointly representing spatially heterogeneous runoff generation, constrained flux partitioning, and explicit river-network propagation remains challenging. We present HydroTreeNet, a process-constrained differentiable rainfall–runoff framework that integrates node-scale snow and liquid–water storages, generalized complementary allocation at the infiltration, evapotranspiration, and recharge interfaces, and explicit routing over a mapped upstream–downstream river network. The model was evaluated across nine diagnostically selected CAMELS-SPAT catchments using repeated calibrations, validation-tuned neural and conceptual benchmarks, controlled component experiments, and numerical conservation audits. Predictive performance was strongly basin dependent, and no model dominated all catchments. HydroTreeNet was competitive in selected Mediterranean, humid, rain–snow, and large lowland-network settings, but exhibited a pronounced structural failure in an intermittent pulse-flow basin. Removing snow processes reduced NSE by 0.32–0.41 in two snow-influenced basins, whereas removing explicit network routing reduced NSE by up to 0.20 in several selected basins. Whole-system water-balance residuals remained below 2 × 10−7 relative to cumulative input, while repeated-seed differences in internal states revealed persistent equifinality despite similar outlet skill. HydroTreeNet therefore provides an auditable framework for separating predictive behavior, structural hypotheses, and numerical conservation within differentiable rainfall–runoff modeling; broader transferability and process realism require larger-sample, held-out-basin, and independent-state evaluation.}
}
@article{GUO2026136561,
title = {Rising risk of carbon sink-source transition in China’s terrestrial ecosystems under compound drought-heat extremes},
journal = {Journal of Hydrology},
volume = {680},
pages = {136561},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136561},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016586},
author = {Wenwen Guo and Shengzhi Huang and Shikun Sun and Deliang Chen and Qiang Huang},
keywords = {Compound drought-heat events, Carbon sink-source, Transition risk, CMIP6, China’s terrestrial ecosystems},
abstract = {The increasing frequency and intensity of compound drought-heat events pose a growing threat to terrestrial ecosystems, yet the carbon sink-source transition risks and dynamics under such combined stress remain poorly quantified. Here, we develop a risk assessment framework to evaluate historical and future carbon sink-source transition risks across terrestrial ecosystems in China, along with identifying the key drivers underlying their spatiotemporal evolution. Our results show that the warm temperate deciduous broad-leaved forest region in eastern China and southwestern China have historically exhibited elevated transition risks, with high-risk areas projected to expand southeastward under future climate scenarios. From the historical period to the SSP585 scenario, the national mean transition risk trend is projected to increase by approximately 1.69-fold relative to the historical level. Driver attribution indicates that precipitation is the dominant contributor to transition risk during the historical period (35.4%), followed by air temperature (13.4%) and vapor pressure deficit (11.3%). Notably, the influence of potential evapotranspiration and soil moisture on risk dynamics has intensified over time. Regions characterized by limited increases in precipitation combined with pronounced warming are projected to experience the largest increases in transition risks in the future. Overall, this study provides a systematic framework for assessing ecosystem carbon stability under compound climate extremes, offering critical insights for regional carbon management and climate adaptation strategies.}
}
@article{ASURZA2026136580,
title = {A prototype multi-hazard early warning system integrating flood and landslide forecasting: application in the upper Garonne River Basin},
journal = {Journal of Hydrology},
volume = {680},
pages = {136580},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136580},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601677X},
author = {Flavio Alexander Asurza and Marcel Hürlimann and Vicente Medina and Francis Nieto},
keywords = {Multi-hazard early warning, Quantile mapping, GEFS forecasts, Flood-landslide modeling},
abstract = {Multi-Hazard Early Warning Systems (MHEWS) are essential for disaster risk management, yet operational implementation remains limited by challenges in hazard integration, forecast uncertainty, and computational requirements. This study develops and evaluates a fast and lightweight prototype MHEWS integrating fluvial flooding and shallow landslide forecasting. The MHEWS couples snow-hydrological modeling (SNOW-17 and CREST) with a slope stability approach (infinite slope and Random Forest models) driven by bias-corrected Global Ensemble Forecast System (GEFS) meteorological forecasts. Quantile mapping bias correction substantially improves precipitation and temperature forecast performance, reducing variability errors and enhancing distributional agreement. Applied in the Upper Garonne River Basin (Spanish Pyrenees) using 24-hour lead time forecasts, multi-hazard analysis for 2010–2020 reveals asymmetric coupling between hazards: flood warnings respond rapidly to rainfall intensity, while landslide warnings depend on cumulative subsurface conditioning and antecedent soil moisture, with high-level warnings rarely coinciding. Evaluation of multiple forecast lead times (24, 48, 72 h) for June 2013 demonstrates systematic performance degradation with increasing lead time, reflecting amplified uncertainty propagation. This degradation is further compounded by the limitations of the quantile mapping approach; while it effectively aligns marginal statistics, it fails to preserve temporal autocorrelation or event persistence. This introduces residual biases in cumulative dynamics that disproportionately affect landslide prediction compared to flood estimation. The fully automated prototype, designed to be scalable and transferable, and built on open-source software and cloud infrastructure, demonstrates operational feasibility for real-time early warning applications across hydro-meteorologically complex environments.}
}
@article{LI2026136601,
title = {Perturbation of dissolved organic matter reactivity by tributary inflows in a large reservoir unveiled by reactomics and explainable machine learning},
journal = {Journal of Hydrology},
volume = {680},
pages = {136601},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136601},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016987},
author = {Qiaoqiao Li and Hai Huang and Mingxing Cao and Yixuan Ye and Yuhan Jiang and Hua Ma},
keywords = {River confluence, Tributary inflow, Dissolved organic matter, Reactomics, Machine learning},
abstract = {River confluences serve as biogeochemical hotspots in watersheds, yet the molecular-level mechanistic linkage between tributary-induced perturbations in dissolved organic matter (DOM) and their functional consequences for ecosystem processes remains poorly quantified. Here, we integrated ultrahigh-resolution mass spectrometry, reactomics (inference of reactivity potential networks from periodic mass difference analysis), and explainable machine learning across four confluences in the Three Gorges Reservoir (TGR). We demonstrate that despite tributaries delivering chemically distinct DOM pools, which distinguish urban-derived, protein-like molecules from terrestrial, aromatic compounds, their mixing with the mainstem is predominantly conservative. In contrast, functional profiling revealed that tributary DOM possesses higher intrinsic reactivity potential, with oxidoreductase pathways dominating the reaction network. A discharge-weighted mixing model confirmed overall conservatism in reactivity potential: measured values deviated from conservative predictions by less than ± 5%. We identified a critical exception: a low-discharge tributary created a disproportional reactivity potential hotspot, underscoring that even minor inputs can drive non-conservative processes. Explainable machine learning (SHAP) showed that higher O/C and NOSC values were associated with greater DOM reactivity potential, while higher S/C values were associated with lower reactivity potential. These three features together accounted for > 90% of feature importance, and the site-grouped cross-validated R2 (3 folds) of the XGBoost model ranged from 0.72 to 0.73 across the four reaches (mean = 0.73). Our findings, based on this synoptic survey, establish a framework that links molecular traits to DOM reactivity potential, providing predictive insights for managing carbon cycling and water quality in regulated river systems.}
}
@article{PAUL2026136513,
title = {Characterization and quantification of compound drought-heatwaves events along with population exposure},
journal = {Journal of Hydrology},
volume = {680},
pages = {136513},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136513},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016100},
author = {Ashesh Rudra Paul and Rajib Maity},
keywords = {Drought heatwave compound events (DHCEs), Population exposure, Climate change exposure, Compound climate extremes, Northeast India},
abstract = {Droughts and heatwaves each cause severe impacts on ecosystems, agriculture, and human health, but when they occur simultaneously their combined effects are far more devastating. These compound extremes, referred to as Drought-Heatwave Compound Events (DHCEs) amplify risks to water security, food systems and public health, creating cascading impacts that surpass those of individual events. Under climate change, DHCEs are projected to intensify worldwide, yet their combined consequences remain underexplored, particularly when population growth is considered. To address this gap, this study develops a methodological framework to assess DHCEs and their implications for human exposure. The framework is additionally evaluated using an alternative temporal concurrence criterion to assess the sensitivity of compound-event identification and population exposure estimates to the adopted definition of concurrence. Although adaptable to any geography, the methodology is applied here to Northeast India, including West Bengal, and Bangladesh (NEIB region), a climatically sensitive and densely populated zone, to demonstrate its efficacy. The findings reveal a marked intensification in DHCEs, with the regional maximum annual dry days rising from ∼5 to ∼35 days (about 7 times higher) towards the end of 21st century, while the regional maximum DHCE Magnitude Index (DMI) rises from 3.5 to 32 (about 9 times higher). Mean temperature of DHCE is projected to increase by 0.06 °C/year, highlighting intensifying dry and hot conditions. Across the NEIB region, the states Meghalaya, Assam, Arunachal Pradesh, Nagaland, Sikkim, and northeastern Bangladesh, are expected to experience the most pronounced changes post-2070. By integrating DHCE indicators with population density through Population Exposure Index (PExI), the identified exposure hotspot shifts towards more densely populated areas. Population exposure is projected to increase by roughly 3–6 times depending on the climate change scenario and parameters of the DHCE indices, i.e. magnitude, frequency, duration etc. Furthermore, a decomposition analysis suggests that the changes in climatic conditions account for the largest share of projected increases in population exposure, followed by population growth and interaction effect, especially in urbanized regions. These findings highlight strong spatial contrasts between climatic intensity and population exposure, underscoring the importance of jointly considering climate extremes and population distribution when assessing compound-event impacts under climate change.}
}
@article{LI2026136505,
title = {StreamFormer: A multi-resolution transformer for scalable global river streamflow prediction},
journal = {Journal of Hydrology},
volume = {680},
pages = {136505},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136505},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016021},
author = {Jinyang Li and Hayato Ushijima-Mwesigwa and Kuolin Hsu and Soroosh Sorooshian},
keywords = {Streamflow prediction, Self-attention, Multi-resolution inputs, Global hydrology, Computational efficiency},
abstract = {Data-driven streamflow models based on Long Short-Term Memory (LSTM) networks have achieved strong predictive skill but rely on long daily meteorological input sequences that impose substantial data storage and computational costs when scaled globally. We introduce StreamFormer (SF), a Transformer-based architecture that combines a hydrologically informed Multi-Resolution Scheme (MRS) and Dual-Scale Patching (DSP) to preserve short-term meteorological signals at high resolution while progressively compressing long-term history at coarser scales, substantially reducing both input storage and computational cost. Using data from over 6200 gauge stations worldwide, SF achieves an NSE of 0.753 and KGE of 0.757 under the multi-resolution scheme, comparable to the standard 365-day baseline but at substantially lower computational cost. Critically, SF maintains or improves performance with the shortened multi-resolution scheme while LSTM performance degrades, suggesting that attention-based models are better suited to heterogeneous temporal inputs. Stratified analysis reveals that catchments with high snow fraction and aridity benefit most from long-term context. SF also achieves faster training and inference, lower GPU memory, and reduced input storage compared to both the standard LSTM and vanilla Transformer baseline. The study demonstrates that hydrological domain knowledge can be used to compress inputs while preserving predictive accuracy at much lower computational cost, supporting scalable operational global hydrological modeling.}
}
@article{HAN2026136521,
title = {A framework for simulating and assessing the spatiotemporal cumulative effects of multi-reservoir operation on streamflow},
journal = {Journal of Hydrology},
volume = {680},
pages = {136521},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136521},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016185},
author = {Yu Han and Ann {van Griensven} and Yiwen Wang and Xinyuan Qian and Zixin Song and Mengxue Ben and Ping-an Zhong},
keywords = {Multi-reservoir systems, Reservoir operation, Parameterized operation rules, SWAT+ model, Spatiotemporal cumulative effects, Upper Yangtze River Basin},
abstract = {Accurately simulating multi-reservoir operation and assessing its spatiotemporal cumulative effects on streamflow remain major challenges in large-scale regulated basins. To address these challenges, this study develops a framework using the SWAT+ model, in which customized parameterized reservoir operation rules (CUS) are developed based on the seasonal operation patterns of reservoirs in the upper Yangtze River Basin. Results show that CUS reflects regional reservoir operation characteristics and improves streamflow simulations relative to the reference models at all control stations during both calibration and validation, with particularly good performance at the basin outlet. Evaluations of reservoir inflow, storage, and outflow further provide process-level validation of the model’s physical realism. Multi-reservoir operation shifts streamflow from the refill to the drawdown period, decreases high flows and increases low flows, and makes intra-annual distribution more uniform, whereas its impact on annual magnitude is limited. Spatial cumulative effects become more pronounced from tributaries to the mainstream and from upstream to downstream, controlled by the topology of the reservoir–river network. Temporal cumulative effects generally intensify across most streamflow indicators as the multi-reservoir system expands. The cumulative effects are dominated by mainstream reservoirs, particularly those in the lower Jinsha River and the Three Gorges Reservoir. Most streamflow indicators exhibit additive behavior, whereas low flow shows supra-additive behavior. These findings highlight the importance of explicitly and appropriately representing regional reservoir operation rules for hydrological modeling in large-scale regulated basin and advance understanding of the mechanisms governing the cumulative effects of multi-reservoir operation on streamflow.}
}
@article{BO2026136557,
title = {Physics-constrained deep learning for evapotranspiration estimation by integrating process-model information and observations},
journal = {Journal of Hydrology},
volume = {680},
pages = {136557},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136557},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016549},
author = {Yong Bo and Kai Liu and Shudong Wang and Long Li and Guoxu Li and Xueke Li},
keywords = {Physics-constrained deep learning, Remote sensing, Evapotranspiration},
abstract = {Accurate estimation of evapotranspiration (ET) is essential for characterizing regional water cycle dynamics and informing sustainable agricultural water management. However, conventional physics-based ET models are often hindered by complex parameterizations and uncertainties in forcing inputs, while purely data-driven approaches frequently suffer from weak physical consistency. This study develops a physics-constrained deep learning (PCDL) framework for generating high-resolution (daily, 100 m) ET by incorporating process-model information into a neural network learning architecture. The framework first constructs a consistent high-resolution dataset of land surface variables through multi-source data fusion. Building on this dataset, a baseline artificial neural network (ANN) is established using remotely sensed variables and in-situ eddy covariance observations, and is subsequently extended into a physics-constrained model by incorporating information derived from surface energy balance and vegetation biophysical processes. The framework is evaluated in the Middle Heihe River Basin during 2012–2016. Results show that PCDL outperforms the ANN model in cross-site transfer experiments, reducing root mean square error (RMSE) by ∼20% on average and by up to 32%. Compared with physics-based benchmark models, PCDL achieves an overall RMSE reduction of ∼30–40% and maintains an accuracy better than 0.7 mm/d. In addition, PCDL reduces large prediction errors by approximately 48% and demonstrates stable performance under limited training samples. Energy-balance-based diagnostics further show that PCDL consistently reduces physical inconsistencies across all evaluated sites, indicating greater consistency with the observed surface-energy balance. Overall, our work demonstrates that incorporating physical information into deep learning could provide an effective pathway for high-resolution ET estimation.}
}
@article{XU2026136491,
title = {Regionalization of mountainous catchments in China for flash floods based on natural and anthropogenic disaster-causing factors},
journal = {Journal of Hydrology},
volume = {680},
pages = {136491},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136491},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601588X},
author = {Shenghao Xu and Jiyang Tian and Jianzhu Li and Yuefen Zhang and Ping Feng and Ting Zhang and Jiacheng Duan},
keywords = {Flash flood regionalization, Small mountainous catchment, Machine learning, Disaster-causing factors, Anthropogenicinfluences, Prevention strategies},
abstract = {China experiences frequent flash flood disasters due to its extensive mountainous terrain and complex monsoon climate, posing serious threats to lives and property. Existing national-scale flash flood regionalization studies are limited by insufficient evaluation of regionalization effectiveness, a lack of validation using historical flash flood disasters and inadequate consideration of anthropogenic influences. To address these limitations, a regionalization method based on multiple natural and anthropogenic disaster-causing factors was developed. A total of 88,006 small mountainous catchments across China were regionalized to identify areas with similar environments for flash flood formation and triggering. Eleven key disaster-causing factors were selected through VIF and Pearson correlation analyses, and a SOM-K-means clustering method was applied to delineate regions. Regionalization effectiveness was then evaluated using PERMANOVA and non-parametric tests of the rainstorm concentration index (RCIt) derived from historical flash flood disasters. The results indicate that: (1) The 15 primary flash flood regions are consistent with China’s major topographic steps and key hydrological and climatic boundaries, while the 81 sondary regions capture finer-scale spatial differences in natural and anthropogenic disaster-causing factors. (2) PERMANOVA and non-parametric tests confirm significant heterogeneity among regions (P ≤ 0.001). (3) After controlling for population density, the partial Spearman correlation between bridge-culvert density and disaster frequency is 0.48 (P < 0.001), indicating a significant statistical association. The resulting scheme provides a basis for selecting suitable flash flood models by region and for parameter regionalization in ungauged areas, and it supports region-specific prevention and mitigation.}
}
@article{LU2026136589,
title = {Soil water movement and vapor effects in cold-region sandy land: implications for diurnal evaporation at the soil–atmosphere interface},
journal = {Journal of Hydrology},
volume = {680},
pages = {136589},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136589},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016860},
author = {Li Lu and Menglu Wang and Shinian Wang and Xiaosi Su and Rongda Li and Hang Lyu and Tiejun Song and Xiaofang Shen and Weihong Dong},
keywords = {Thermal vapor flux, Diurnal evaporation, Dry surface layer, HYDRUS-1D, Cold region sandy land},
abstract = {Vapor transport is important in coupled soil water–heat processes, but how temperature-gradient variations and liquid–vapor partitioning reorganize internal water transport and regulate diurnal evaporation after dry surface layer (DSL) formation remains unclear. This study combined lysimeter observations from the Songnen Sandy Land with HYDRUS-1D simulations of coupled liquid water–vapor–heat transport to quantify shallow flux partitioning and controls on thermally driven vapor flux (qvT). Total soil water flux was generally dominated by isothermal liquid flux (qlh). During dry periods, qvT increased markedly within the 3–10 cm layer, contributing 7–14% and up to 45% around midday. Temperature gradients determined qvT direction, whereas soil moisture regulated its magnitude through gas-phase connectivity. After DSL formation, evaporation showed a pronounced morning enhancement–midday suppression transition: nighttime vapor retention allowed actual evaporation (Ea) to approach potential evaporation (Ep) shortly after sunrise, whereas subsequent downward qvT offset upward qlh and reduced effective water supply. This transition formed the core of a four-stage pattern of nighttime recharge, morning enhancement, midday suppression, and weak afternoon recovery. Rainfall suppressed qvT by weakening near-surface temperature gradients and gas-phase connectivity, with delayed post-rainfall recovery. Sensitivity analyses showed that n exerted the strongest control on daily evaporation and vapor redistribution, whereas water-table depth had limited effects because the capillary fringe remained below the vapor-active layer. Although vapor transport did not dominate the overall water balance, it regulated the timing and effectiveness of shallow water supply, helping explain diurnal soil–atmosphere water exchange in cold-region sandy land.}
}
@article{LING2026136375,
title = {Pilot point-based geostatistical parameterization with deep learning models},
journal = {Journal of Hydrology},
volume = {680},
pages = {136375},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136375},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014721},
author = {Wei Ling and Behnam Jafarpour},
keywords = {Subsurface flow model calibration, Pilot point method, Deep learning, Ensemble data},
abstract = {Calibration of subsurface flow models in geologically complex environments with non-Gaussian spatial patterns remains a significant challenge in hydrology. A central difficulty is conditioning complex geological representations on nonlinear flow data (e.g., pressure and saturation) while preserving geological realism and spatial continuity. Traditional pilot point–based parameterization (PPM) provides an intuitive and physically meaningful calibration framework, but its applicability is limited when the underlying geostatistical interpolation or conditional simulation cannot adequately reproduce complex, non-Gaussian spatial patterns. To address this limitation, we propose a practical PPM extension that replaces the interpolation step with a multi-channel U-Net trained on channelized facies realizations. The U-Net generates facies distributions conditioned on sparse pilot points and hard data, retaining the interpretability of pilot points while learning non-Gaussian spatial structure from a training image, and is coupled with the Ensemble Smoother with Multiple Data Assimilation (ES-MDA) for iterative calibration. Reconstruction quality improves systematically with pilot-point density, and a controlled benchmark against Multiple-Point Statistics (MPS) across matched conditioning scenarios shows that the proposed approach outperforms MPS in facies reconstruction accuracy, with the advantage becoming most pronounced at higher conditioning densities. The framework is demonstrated on binary fluvial channel systems and provides a practical pathway for pilot point–based calibration where classical interpolation cannot reproduce non-Gaussian spatial structure.}
}
@article{ZHANG2026136391,
title = {Pollution loads and redox-controlled geochemical processes drive contrasting nitrate and ammonium accumulation in shallow groundwater of the Songnen Plain},
journal = {Journal of Hydrology},
volume = {680},
pages = {136391},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136391},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014885},
author = {Mingxin Zhang and Yanjia Chu and Baonan He and Qiwen Xia and Jiangtao He and Mengmeng Wu},
keywords = {Regional groundwater, Nitrate, Ammonium, Source apportionment, Nitrogen differentiation},
abstract = {Groundwater contamination by nitrate and ammonium poses a persistent threat to water security and public health. Although their behavior has been widely studied, quantifying how external loading, hydrochemical conditions, and hydrogeological settings shape their relative dominance remains challenging in a heterogeneous shallow aquifer system. Here, 1,026 shallow groundwater samples from the Songnen Plain and multi-source environmental data were analyzed to evaluate the spatial patterns, source-related factors, and controlling conditions of nitrate-N (NO3-N) and ammonium-N (NH4-N). Both species occurred across the two hydrogeologically defined subregions but showed contrasting dominant exceedance patterns. NO3-N exceedance was concentrated in the high plain (46.8%), whereas NH4-N exceedance was more frequent in the low plain (30.2%). PMF and GNMF results suggested that NO3-N exceedance was mainly associated with agricultural and industrial source-related factors, with model-derived grouped contributions of 57.5–62.5%. In contrast, NH4-N was linked to mixed organic-related and natural geochemical factors, with model-derived grouped contributions of 59.0–70.5%. Grouped XGBoost-SHAP importance analysis identified pollution-load-related variables as the dominant predictors of nitrate accumulation (72.4%), whereas NH4-N showed a more distributed predictor structure involving pollution-load-related variables (54.5%), redox-sensitive hydrochemical indicators (29.0%), and hydrogeological settings (16.5%). PLS-SEM results were consistent with contrasting accumulation pathways: nitrate enrichment was associated with anthropogenic inputs under oxic conditions favoring nitrification and nitrate persistence, while ammonium enrichment was favored in low-lying, organic-rich, and reducing settings where nitrification may be limited. These findings provided a model-supported comparison of nitrate and ammonium dominance in shallow groundwater.}
}
@article{CHEN2026136464,
title = {Efficient and high-precision urban flood forecasting model combining numerical weather prediction with real-time correction},
journal = {Journal of Hydrology},
volume = {680},
pages = {136464},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136464},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015611},
author = {Guangzhao Chen and Jingming Hou and Yan Li and Yuan Hu and Yanhong Wang and Xinxin Pan and Jiahao Lv and Baojun Guan},
keywords = {Urban inundation, High-precision forecasting, Numerical weather prediction, Real-time correction, Hydrological-hydrodynamic model},
abstract = {Urban flood forecasting is a crucial measure of reducing flood disaster risk, enabling early forecasting of flood events and informing emergency dispatch. However, traditional urban flood forecasting techniques face several challenges, including limited lead time and insufficient forecast accuracy. This work integrates NWP model with a hydrological–hydrodynamic model to construct an urban flood forecasting framework that can leverage GPU architecture to achieve efficient computation, thereby delivering high-resolution forecasts with extended lead time. Precipitation forecast data are generated from the NWP model, aiming to extend the forecasting horizon. Additionally, a rainfall real-time correction method is proposed to further enhance the reliability of rainfall forecast. The GPU-accelerated hydrological-hydrodynamic model is driven by the forecast rainfall data, and fine topographic data are employed to accurately represent the complex urban surface characteristics. This approach achieves high-precision urban flood forecasting without compromising computational efficiency. In a typical rainfall-flood event, the total rainfall forecast error after real-time correction is reduced from 2.8 mm to 0.6 mm, with the NSE values for forecast water levels exceeding 0.90. Additionally, the maximum water depth APE error is reduced to 4.2%, and the RMLSE error decreased to 0.002, demonstrating an improvement in the accuracy of both rainfall and flood forecasts. Meanwhile, within a simulation domain comprising 2.71 million grid cells, the urban flood forecasting model completed a 1 h inundation scenario forecasting with an average runtime of 2.12 min. Compared to traditional simulations executed on a CPU, the use of GPU acceleration technology increased the computational efficiency by a factor of 68.4, demonstrating high computational efficiency. This research effectively extends the lead time and enhances accuracy compared to traditional methods, thereby improving cities’ disaster prevention capabilities under extreme climate conditions.}
}
@article{BAE2026136504,
title = {Regional site suitability assessment for groundwater dams in South Korea using AHP-GIS},
journal = {Journal of Hydrology},
volume = {680},
pages = {136504},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136504},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601601X},
author = {Min Seo Bae and Jaehee Kim and Dayoung Kang and Jian Kim and Hanjoo Kwak and Soonjae Lee},
keywords = {Water resources planning, Groundwater dams, Site selection, Multi-criteria decision making, Expert judgement, Weighted overlay},
abstract = {Groundwater dams are increasingly considered a sustainable means of augmenting water-supply reliability and buffering climate-driven hydrological variability. In South Korea, 80 groundwater dam candidate sites have been identified through demand-driven national investigations, yet a standardized basis for inter-site comparison has been lacking. This study develops the AQCEG model, a regional site suitability assessment framework, which evaluates five criteria — water abundance, water quality, constructability, ecological compatibility, and governance — and expresses the result as a relative suitability index (0–5). National spatial datasets were compiled from public sources and preprocessed to a resolution of 100 m × 100 m grid. Ecological suitability and governance are applied as non-compensatory binary exclusion masks that separate technical suitability from legal and institutional acceptability, while the remaining criteria are calculated by weighted summation. The criterion weights were derived through the Analytic Hierarchy Process (AHP) from pairwise-comparison survey of 25 experts in water resources, hydrogeology, environmental science, and policy. Water Abundance received the highest group weight aggregated across the 25-expert panel (0.66), and present-state indicators were consistently preferred over forward-looking risk indicators across all criteria (CR < 0.04). GIS-based weighted overlay produced a nationwide suitability map whose high-suitability watersheds concentrate in mountainous headwaters of the eastern and southern uplands, outside major exclusion zones. Retrospective benchmarking against 80 pre-selected candidate sites showed that these sites occupy reaches of significantly above-average water abundance – while their separation from the national background weakened once all criteria were integrated, consistent with the assessment’s role as a permissive first-pass screen rather than a sharp site classifier. The AQCEG framework offers a transparent, reproducible, data-driven screening tool for groundwater dam planning at national and regional scales.}
}
@article{HUANG2026136525,
title = {Hydrodynamic connectivity reveals priority locations for surface flow constructed wetland deployment in complex plain river networks},
journal = {Journal of Hydrology},
volume = {680},
pages = {136525},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136525},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016227},
author = {Jinyaxuan Huang and Wei He and Shiqiang Gao and Xiaoyi Shen and Xuetong Zhang and Hongwu Tang and Andrew Western},
keywords = {Surface flow constructed wetlands, Water-quality improvement, Hydrodynamic connectivity, River-network structure, Current-flowbetweenness},
abstract = {Surface flow constructed wetlands (SFWs) are a promising strategy for improving water quality, yet their regulatory mechanisms in complex plain river networks remain poorly understood. Based on five years of observed water-quality data from the urban river network of Suqian, China, a coupled modelling framework integrating runoff generation, drainage systems, river networks, and SFWs was established and validated. Building upon long-term observations and multi-scenario simulations, a Structure–Process–Response–Deployment (SPRD) framework integrating process-based indicators, contribution analyses, and causal pathway modelling was developed to quantify how river-network structure controls hydrodynamic transport and water-quality responses. Results showed that (1) SFWs drove a cascading effect regulating network-wide water quality by reshaping hydrodynamic connectivity and redistributing pollutant exposure, rather than acting as localised sinks. During the 30-mm rainfall event, SFWs induced only minor hydrodynamic alterations yet reduced cumulative ammonia nitrogen exposure by 4.81%, indicating that limited hydraulic perturbations can generate substantial water-quality benefits. These effects exhibited strong spatial heterogeneity, with the greatest improvements occurring within deployment zones. (2) Across rainfall depths of 10–100 mm, the response indicators exhibited distinct non-monotonic patterns: the relative changes in cumulative exposure and peak concentration reached optimal values at 30 mm, whereas the change in exceedance duration was optimal at 20 mm. Hydrodynamic connectivity was identified as the dominant process variable. Strategies targeting reaches with high current-flow betweenness (a network metric quantifying a reach’s role in mediating flow pathways) outperformed those targeting low-betweenness reaches under light-to-moderate rainfall (10–40 mm), whereas this performance divergence diminished under extreme events (100 mm). These findings demonstrate that current-flow betweenness provides a practical indicator for prioritising SFW deployment and maximising network-scale water-quality benefits.}
}
@article{GUO2026136480,
title = {Contiguous evolution and hydroclimatic drivers of compound drought–heatwave events across mainland China},
journal = {Journal of Hydrology},
volume = {680},
pages = {136480},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136480},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015775},
author = {Hao Guo and Ying Cao and Xiangchen Meng and Yunqian Wang and Aminjon Gulakhmadov and Khusen Sh. Gafforov and Philippe De Maeyer},
keywords = {Compound drought–heatwave events, Three-dimensional event identification, Event classification, Mainland China, Hydroclimatic drivers},
abstract = {Compound drought–heatwave events (CDHEs) have intensified under global warming, yet the diversity of their contiguous evolution pathways and the hydroclimatic conditions associated with different evolution modes remain insufficiently understood. Distinguishing CDHEs according to their multidimensional propagation characteristics is therefore important for revealing process heterogeneity and identifying mode-specific hydroclimatic associations. In this study, contiguous CDHEs across mainland China during 1981–2024 were identified using a three-dimensional spatiotemporal algorithm based on the non-stationary Standardized Precipitation Evapotranspiration Index (NSPEI) and daily maximum temperature. Event characteristics were quantified, evolution modes were classified using six process-related features, and their hydroclimatic associations were examined using XGBoost–SHAP. A total of 1,711 CDHEs were identified. Over the 44-year period, grid cells covering 89.1 % of mainland China experienced more than 80 CDHEs, indicating widespread recurrence. Annual event frequency increased by 0.33 events yr⁻1, while the overall intensification was characterized mainly by more frequent, longer-lasting, and more intense events rather than a sustained expansion of affected area. Northwest China showed the strongest intensification. Four major evolution modes were identified, differing primarily in duration, spatial extent, migration speed, and directional stability. Localized slow-moving events with variable propagation directions were the most common, whereas long-lasting, large-area events were less frequent but exhibited greater duration, spatial extent, and intensity. Vapor pressure deficit was the dominant driver across the four modes, while other hydroclimatic factors contributed differently among modes. These findings demonstrate diverse contiguous evolution pathways of CDHEs across mainland China and provide an event-based basis for risk assessment and impact mitigation.}
}
@article{WEI2026136553,
title = {Satellite-derived nutrient reconstruction reveals the drivers of eutrophication risk in a subtropical estuary},
journal = {Journal of Hydrology},
volume = {680},
pages = {136553},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136553},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016501},
author = {Qiqi Wei and Shaohua Lei and Pengfei Wang and Yunfeng Tian and Yifei Fan and Feifei Wang and Wenzhi Cao},
keywords = {Dissolved inorganic nitrogen, Dissolved silicate, Salinity gradient, Estuarine biogeochemistry, Nutrient transport, Remote sensing inversion},
abstract = {Monitoring the dynamics of estuarine nutrients, specifically dissolved inorganic nitrogen (DIN) and silicate (DSi), is essential for assessing the ecological health of nearshore waters; however, traditional sampling methods struggle to provide the high-frequency temporal data and broad spatial coverage required for comprehensive assessment. Here, we developed a robust “two-step inversion” remote sensing framework (R2 > 0.70) that bridges the gap between remote sensing reflectance and salinity, subsequently linking salinity to DIN and DSi concentrations. By applying this model to the Jiulong River Estuary, we achieved a high-frequency, large-scale, and accurate reconstruction of surface DIN and DSi concentrations over the past decade. Both DIN and DSi exhibited a distinct land-to-sea gradient and significant seasonal fluctuations, characterized by higher concentrations in winter and lower concentrations in summer. The dissolved silicate-to-dissolved inorganic nitrogen molar ratio (Si/N ratio) remained stable between 1.27 and 1.34 over the long term but displayed marked spatial heterogeneity during the summer. Nutrient dynamics are influenced by salinity-driven mixing, biogeochemical processes, climatic variability, and human activities. Salinity-driven mixing primarily affects large-scale spatial patterns, whereas climatic factors are linked to seasonal variability. Furthermore, socioeconomic development and pollution control measures can affect long-term changes in nutrient levels. Our framework is an effective tool for monitoring non-optically active substances and has implications for eutrophication early-warning systems and integrated basin management.}
}
@article{SHARMA2026136494,
title = {Hydrological flux effectiveness index for assessing rainfall partitioning and hydrological functioning under climate change},
journal = {Journal of Hydrology},
volume = {680},
pages = {136494},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136494},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601591X},
author = {Rahul Sharma and S. Sreekesh},
keywords = {Hydrological flux dynamics, SWAT, Basin water balance, CMIP6 climate projections, Climate change impacts},
abstract = {This study proposes a novel Hydrological Flux Effectiveness Index (HFEI) to quantify rainfall partitioning effectiveness and evaluate watershed hydrological functioning under changing climatic conditions. Unlike conventional hydrological assessments that emphasize precipitation magnitude or isolated flux components, the HFEI integrates key gain and loss processes controlling subsurface storage and runoff generation into a single framework. The index is formulated using four dimensionless hydrological ratios derived from Soil and Water Assessment (SWAT) simulated fluxes: evaporation loss ratio (ELR), surface runoff to water yield ratio (SWR), recharge ratio (RR), and base-flow contribution ratio (BCR). The framework is implemented in the Chaliyar River Basin (CRB), with multi-site calibration–validation using Sequential Uncertainty Fitting algorithm (SUFI-2). Future climate simulations are driven by bias-corrected CMIP6 projections under SSP2 and SSP5 for 2025–2095. Annual sub-basin hydrological fluxes are used to compute HFEI independently for each GCM, and inter-model uncertainty is quantified using ensemble statistics (mean and standard deviation). For comparability, historical and future HFEI series are standardized using z-scores based on the historical baseline, enabling detection of deviations from historical hydrological functioning. Results show that HFEI effectively captures strong spatial heterogeneity in hydrological effectiveness, distinguishing subsurface-dominated sub-basins from runoff-dominated systems. Ensemble results indicate robust but spatially variable climate-driven shifts in hydrological partitioning. Sensitivity analysis confirms the stability of the equal-weighting structure and the robustness of the index formulation. Overall, HFEI provides a physically based and scalable framework for assessing hydrological resilience under changing climatic conditions.}
}
@article{DALBIANCO2026136541,
title = {Land-use controls on soil hydraulic functioning: the role of pore organization and gravel distribution in an agricultural catchment},
journal = {Journal of Hydrology},
volume = {680},
pages = {136541},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136541},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016380},
author = {Leandro Dalbianco and Jean Paolo Gomes Minella and Gizachew Ayalew Tiruneh and Maria Cândida Moitinho Nunes and José Miguel Reichert},
keywords = {Catchment hydrology, Pore connectivity, Saturated hydraulic conductivity, Water retention, Gravel, Spatial variability, Soil quality},
abstract = {Soil hydraulic functioning in headwater catchments reflects interactions among pore organization, land use, and coarse-fragment distribution, but the relative importance of these controls remains uncertain when point measurements are interpreted at broader spatial scales. This study evaluated how near-surface soil permeability and water storage varied among land-use and tillage systems and whether those variations were associated with soil structure and gravel distribution in a 1.19 km2 agricultural headwater catchment in southern Brazil. Physical and hydraulic properties were measured in the 0–0.05 m layer at 69 sampling points (414 undisturbed cores), including bulk density, pore-size distribution, saturated hydraulic conductivity (Ksat), air permeability (Ka), water retention across matric potentials, gravel content, texture, and soil organic carbon (SOC). Planned contrasts, Pearson correlations, and principal component analysis (PCA) were used to evaluate group differences and multivariate associations. Natural forest had lower bulk density and greater permeability-related attributes than grazed grassland, whereas conservation tillage increased water retention and plant-available water relative to conventional tillage without a consistent increase in Ksat. Gravel abundance was positively associated with macroporosity, Ka, and Ksat and negatively associated with water retention near field capacity, but these correlations do not establish a causal pathway. Land-use differences in water retention were strongest near saturation and diminished at higher suctions. The first two PCA axes explained 49.3% of total variance and separated transmission-related attributes (Ksat, Ka, macroporosity, total porosity, and saturated water content) from denser, storage-related conditions, while substantial variability remained in higher components. Overall, near-surface hydraulic functioning was more closely associated with pore organization and coarse-fragment abundance than with texture or SOC. Because the study represents only the surface layer of one catchment and did not explicitly model spatial autocorrelation or deeper pedogenetic discontinuities, extrapolation to profile- and catchment-scale flow should be made cautiously.}
}