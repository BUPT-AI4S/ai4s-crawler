@article{CAVUS2026136027,
title = {Enhanced data-based analysis introducing a previously unidentified empirical hydrological benchmark: baseflow dominance threshold},
journal = {Journal of Hydrology},
volume = {679},
pages = {136027},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136027},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011248},
author = {Yonca Cavus},
keywords = {Baseflow dominance threshold, Baseflow index, Baseflow separation, Hydrograph recession, Intermittent river, Recursive digital filter},
abstract = {Enhanced understanding of baseflow dynamics is critical for effective water resources management, especially in regions experiencing significant climatic variability. This study systematically investigates baseflow characteristics using an extensive daily streamflow dataset from 94 streamflow gauging stations across five climatically distinct river basins in Turkey. Employing the Recursive Digital Filter to separate baseflow, the study demonstrates that Baseflow Index (BFI) and streamflow have a unique relationship, where, from zero up to a given value of streamflow, BFI is unity, decaying exponentially afterward towards zero as streamflow increases. Significant variations were observed in the relationship between BFI and streamflow, reflecting local geomorphological and hydrological conditions, and clearly influenced by the presence or absence of zero-flow periods, and highlighting the importance of considering stream intermittency in hydrological analysis. However, the point where BFI starts to decay was found consistent over river basins, and this is the novel concept introduced as the Baseflow Dominance Threshold (BDT). The analysis revealed that this threshold exhibits a consistent normally distributed exceedance probability of approximately 0.05 basin-wide, underscoring a previously unidentified empirical hydrological benchmark. Another robust finding of the study is that streamflow is fully composed of baseflow in 20% of days on average consistently over the river basins studied. Extensive testing of probability distributions demonstrated that parametric approaches inadequately represent BFI variability, prompting the adoption of non-parametric methods. These methods revealed distinct hydrograph phase-specific differences, with recession limbs exhibiting higher and more stable baseflow contributions compared to ascension limbs. The findings emphasize the critical role of zero-flow conditions, seasonal variability, and regional hydrological characteristics in shaping baseflow dynamics. By providing a comprehensive, data-driven analysis framework and introducing the BDT, this study advances hydrological modelling practices and supports adaptive, informed water management strategies.}
}
@article{WANG2026136176,
title = {Intensive anthropogenic activities control the spatiotemporal heterogeneity of river eutrophication at the watershed scale},
journal = {Journal of Hydrology},
volume = {679},
pages = {136176},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136176},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012734},
author = {Xihua Wang and Shunqing Jia and Y. Jun Xu and Chaomeng Dai and Nianqing Zhou and Zejun Liu and Boyang Mao and Qinya Lv and Xuming Ji and Chengming Luo and Yan Dai and Yanxin Rong},
keywords = {Yiluo River, Eutrophication index, Nitrogen/phosphorus ratio, Watershed scale, Anthropogenic pressure index},
abstract = {Eutrophication in rivers under intense anthropogenic pressure presents a significant environmental challenge, yet its spatiotemporal heterogeneity and driving mechanisms remain understudied. To bridge this gap, we conducted a comprehensive investigation in the Yiluo River Watershed across three distinct seasons in 2022–2023. Our findings reveal a phosphorus-limited system (average N:P ratio = 56) with progressively worsening eutrophication, as evidenced by the rising Eutrophication Indices (EI) at the river mouth (53, 62, and 65, respectively). To elucidate the drivers of this heterogeneity, we developed a novel Anthropogenic Pressure Index (API) and employed multivariate statistical analyses, including Principal Component Analysis (PCA) and Cluster Analysis. The results identified distinct seasonal shifts in pollution patterns, transitioning from organic pollution and nutrient accumulation in autumn to nitrification-dominated processes in spring, and culminating in peak eutrophication driven by algal activity in summer. Furthermore, correlation analysis highlighted a dynamic seasonal influence of land use on eutrophication; the impact of cropland was most pronounced during the spring fertilization period, while impervious surfaces dominated during the wet season. The consistently strong positive correlation between the API and EI across all seasons confirms that overall human pressure is the fundamental driver of eutrophication in the watershed. This study provides robust, multi-faceted evidence underscoring the critical need for integrated, seasonally-aware management strategies to mitigate eutrophication in intensively used watersheds.}
}
@article{ZHOU2026136179,
title = {Global patterns and declines of precipitation persistence over the past six decades},
journal = {Journal of Hydrology},
volume = {679},
pages = {136179},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136179},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601276X},
author = {Yunqiu Zhou and Xiuyu Liang and Tzung-May Fu and Yi Zheng and Lian Feng and Chunmiao Zheng},
keywords = {Globalpatterns, Precipitation persistence, Spectral analysis, Rainfall predictability},
abstract = {Precipitation persistence influences how long wet or dry conditions last, influencing drought and flood risks, water resource planning, and agricultural stability. Yet its global distribution and long-term evolution remain poorly known. Using six decades of daily ERA5 reanalysis, together with independent comparisons with GHCN, GPCC and HOAPS/GPCC datasets over their available periods, we show that precipitation persistence, quantified by the temporal “memory” exponent (βP) in spectral analysis, displays strong spatial heterogeneity and a widespread decline under a 5-year moving window. Precipitation persistence is highest over tropical and subtropical continents and lowest over mid-latitude oceans. Meanwhile, βP correlates positively with the duration of wet and dry spells and with potential precipitation predictability (PPP). Cross-dataset comparisons further show decreasing tendencies in domain-mean βP over the common periods and valid domains of GPCC and HOAPS/GPCC, although the strong tropical belt-like decline in ERA5 is not consistently reproduced by independent products. These results suggest that spectral βP provides a useful diagnostic of precipitation temporal organization, and that weakening persistence may imply more fragmented precipitation variability with potential implications for hydrological forecasting and water resource management.}
}
@article{LI2026136200,
title = {Hierarchical water partitioning across different scales in sloped field: evidenced by soil pore water isotopic signatures},
journal = {Journal of Hydrology},
volume = {679},
pages = {136200},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136200},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012977},
author = {Jinzhuo Li and Xianwen Li and Mo Li and Liu Liu and Xiaorong Wei and Yaxian Hu},
keywords = {Soil pore water, Stable isotopes, Hillslope hydrology, D-excess, Water partitioning},
abstract = {Soil pore water is like blood cycling in soil and plant system. However, beyond enrichment or depletion in bulk water content, we know little about how the heterogeneous turnover rates of soil water in differently sized pores affect or are affected by slope-scale water cycling. In this study, a Mollisol was collected from the Upper, Middle and Lower position along a typical rolling slope. At each position, bulk soil cores were sampled from three depths (10, 20, and 45 cm), and respectively centrifuged to step-wisely collect soil water stored in five differently sized pores. After comparing the stable isotopic signatures of H and O (δ2H and δ18O) in each soil pore water, we observed that: (1) On average, > 83.5% of soil water was stored in pores < 6 μm, with stronger predominance at the Lower slope position and 45 cm deep. (2) Pore water δ2H and δ18O decreased with slope positions and depth, jointly resulting in enhanced Deuterium excess (d-excess) by 5.67‰ at the Lower slope position and by 3.56‰ at 45 cm deep. (3) Pore water δ2H and δ18O generally increased as pores became finer, and the d-excess maximized at 5.13‰ in Mesopores but minimized at –0.7‰ in Fine pores. The heterogeneous isotopic signatures and d-excess suggested that soil pore water did not cycle at the same rate but much more slowly in finer pores, resulting in much more advanced evaporative fractionation in smaller pores. Soil pores restructuring along the slope and profile, together with unequal evaporative fractionation and infiltration recharge, may have collectively contributed to the enhanced d-excess at Lower slope position and deeper layer. This is the first pore-scale evidence to decipher how water was partitioned across different spatial scales along hillslopes.}
}
@article{BAO2026136087,
title = {Environmental and physiological regulation of evapotranspiration key parameters and subsequent modeling in a rain-fed maize field, Northeast China},
journal = {Journal of Hydrology},
volume = {679},
pages = {136087},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136087},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011844},
author = {Rongxuan Bao and Haofang Yan and Jianyun Zhang and Guoqing Wang and Chuan Zhang and Desheng Zhang and Yudong Zhou and Biyu Wang and Yujing Han and Youwei Liu and Xuanxuan Wang and Rui Zhou},
keywords = {Evapotranspiration, Canopy resistance, PT coefficient, Crop coefficient, Advection},
abstract = {Accurate estimation of crop evapotranspiration (ETc) is crucial for yield prediction, irrigation management, and agricultural water resource assessment. A major challenge in applying widely used models such as the Penman-Monteith (PM), Priestley-Taylor (PT), and crop coefficient (Kc) models is the reliable calibration of key parameters, including canopy resistance (rc), Priestley-Taylor coefficient (α), and crop coefficient (Kc), under complex environmental and physiological dynamics. In this study, we evaluated the three models in a rain-fed maize field in Northeast China using meteorological data from 2020 to 2023, with a focus on the seasonal variations of rc, α, and Kc and their environmental and physiological drivers. The results indicated that daily α and Kc exhibited similar temporal patterns and were both linearly correlated with air temperature (Ta) and relative humidity (RH). In contrast, rc showed a significant exponential correlation with net radiation (Rn) and RH, and the curvature of the relationship between rc and Rn increased with increasing RH. All three parameters were linearly correlated with leaf area index (LAI), but these correlations weakened significantly whenLAI > 3 m2·m−2. Filtering out days influenced by strong advection effectively eliminated most extreme values of rc, α, and Kc, thereby substantially improving the robustness of parameter calibration and model evaluation. Among the tested models, the Kc model performed best (average R2 = 0.76, NSE = 0.74, MAE = 0.48 mm·d−1, RMSE = 0.68 mm·d−1), whereas the PT model exhibited the poorest performance (R2 = 0.76, NSE = 0.52, MAE = 0.56 mm·d−1, RMSE = 0.77 mm·d−1). The performance of the three models was relatively high when LAI > 3 m2·m−2, and generally improved with increasing RH and Ta.In particular, LAI = 3 m2·m−2 was identified as a critical structural threshold marking the physical transition from soil-dominated to canopy-dominated evapotranspiration. These findings provide a rigorous basis for improving ETc estimation in rain-fed agroecosystems and informing the refinement of land surface models under diverse climatic conditions.}
}
@article{WANG2026136116,
title = {Attention-based terrestrial heat flow reconstruction across the Tibetan Plateau: Insights into tectono-thermal coupling, hydrothermal activities, and geothermal targets},
journal = {Journal of Hydrology},
volume = {679},
pages = {136116},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136116},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012138},
author = {Yingchun Wang and Yi Wang and Haiwen Chen and Xintian Li and Yuhe Fan and Yinlei Hao and Jiao Tian},
keywords = {Terrestrial heat flow, Tibetan Plateau, TabPFN, Machine learning, Geothermal exploration},
abstract = {Accurate identification of the spatial distribution pattern of terrestrial heat flow (HF) in the Tibetan Plateau is crucial for geodynamic research and geothermal resource development. In this study, the TabPFN (Tabular Prior-Data Fitted Network) model was used for HF prediction in the Tibetan Plateau, a tectonically complex and data-sparse region. By integrating 13 geological and geophysical features, the model has been trained and evaluated on three spatial scales: global, Tibetan Plateau and its surroundings, and the Tibetan Plateau itself. The performance comparison with other three mature machine learning algorithms (GBRT, DNN, SVM) reveal that, at the global scale, TabPFN achieved the highest predictive performance (R2 = 0.963). Additional statistical validation and spatial block cross-validation further confirmed the robustness and spatial generalization capability of the model. SHAP (SHapley Additive exPlanations) analysis is further used to interpret model decisions, and the key controls on geothermal distribution are pointed out: plate tectonic boundaries, topography, gravity mean curvature, and Moho depth. These predictions successfully reproduced known thermal anomaly zones, such as the Yarlung Zangbo Suture (YZS), with average heat flow values of ∼ 90 mW/m2 and local anomalies exceeding 120 mW/m2, while also uncovering new patterns, including northeastward extensions and continuous distributions along faults in the southeastern margin. Three geothermal potential areas are delineated, each dominated by normal, strike-slip, or thrust faulting, reflecting the coupling among heat flow anomalies, active tectonics, and hydrothermal springs. A prioritized list of ten counties (e.g., Bangor, Seni, Shenzha, Gonghe, Damxung) defines the potential exploration targets. The results construct a high-resolution prior thermal field and provide direct guidance for geothermal exploration.}
}
@article{LI2026136192,
title = {Cascade-reservoir impoundment reshapes event-scale flood–sediment responses upstream of the Three Gorges Reservoir: evidence from rainfall patterns and driver attribution},
journal = {Journal of Hydrology},
volume = {679},
pages = {136192},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136192},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012898},
author = {Xin Li and Xinyu Peng and Wei Zhang and Ya Liu},
keywords = {Three Gorges Reservoir, Cascade-reservoir impoundment, Event-scale floods, Suspended sediment, Rainfall patterns, Random forest, Driver attribution},
abstract = {Event-scale flood and suspended sediment dynamics in heavily regulated large river basins are shaped by both rainfall forcing and human activities. However, how cascade-reservoir impoundment reorganizes rainfall–flood–sediment relationships remains insufficiently understood, particularly at the flood-event scale. Focusing on the inflow region of the Three Gorges Reservoir (TGR), this study analyzed 91 flood-season events during 2003–2020. Event-scale rainfall patterns were identified using K-means clustering based on rainfall magnitude, temporal variability, and spatial distribution. Flood and suspended-sediment responses were then compared before and after the impoundment of cascade reservoirs in the lower Jinsha River. A random forest framework, combined with SHAP interpretation and RF-MDI feature-importance validation, was further used to evaluate changes in the relative explanatory importance of climatic and anthropogenic drivers. Six distinct rainfall patterns were identified, providing a basis for comparing flood and sediment responses under different rainfall regimes. After cascade-reservoir impoundment, flood responses entering the TGR weakened moderately, with total flood volume, peak discharge, and flood duration decreasing by approximately 10.0%, 6.2%, and 8.5%, respectively. In contrast, sediment responses declined more sharply, with suspended-sediment load and mean/peak suspended-sediment concentrations decreasing by 49.4%, 52.9%, and 41.3%. Despite the overall reduction, flood events accounted for a slightly larger share of annual sediment load, indicating stronger event-scale concentration of sediment delivery under reduced sediment supply. SHAP-based driver attribution revealed a reorganization of flood and sediment controls after cascade-reservoir impoundment. For floods, rainfall magnitude remained dominant, with its mean relative importance increasing from 31.6% to 36.6%, while upstream cascade-reservoir impoundment emerged as the second most influential factor (23.8%). For suspended sediment, the hierarchy shifted more fundamentally: rainfall spatial distribution rose from 7.3% to 26.6%, rainfall magnitude declined from 45.1% to 31.1%, and upstream reservoir impoundment accounted for 17.6%. RF-MDI feature importance showed qualitatively consistent trends, corroborating the attribution. These findings reveal a pronounced event-scale decoupling between flood and sediment responses: flood dynamics remain primarily governed by rainfall magnitude, whereas sediment delivery has become increasingly sensitive to the spatial organization of rainfall and reservoir-induced sediment-supply limitation. These findings provide new event-scale insights for sediment monitoring, flood-season reservoir operation, and adaptive water–sediment management in large, heavily regulated river basins.}
}
@article{SONG2026136213,
title = {A pore-scale hydraulic conductivity model for frozen saturated soils incorporating wall-first and center-first freezing mechanisms},
journal = {Journal of Hydrology},
volume = {679},
pages = {136213},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136213},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013107},
author = {Xinye Song and Sai K. Vanapalli and Junping Ren},
keywords = {Pore-scale freezing mechanisms, Frozen sand, Hydraulic conductivity, Capillary bundle model, SFCC},
abstract = {Hydraulic conductivity of saturated frozen soils exhibits strong nonlinearity with temperature due to progressive changes in pore-scale liquid connectivity. To capture this behavior, a physically based hydraulic conductivity model for frozen soils is developed within a freezing-modified capillary-bundle framework that represents the potential coexistence of wall-first and center-first freezing mechanisms. An effective pore radius is derived to reflect both the volumetric distribution of unfrozen water and the geometry of hydraulically active pore classes. The model is parameterized directly from the soil freezing characteristic curve (SFCC), providing a physics-consistent link between temperature, unfrozen water content, and pore-scale flow properties. A machine-learning model based on a weighted ensemble of Transformer architecture and XGBoost is developed to estimate SFCCs from basic soil properties to facilitate its use when measured SFCC information is unavailable. The measured or estimated SFCCs serve as inputs to the proposed pore-scale saturated hydraulic conductivity model. The proposed model was validated against independent experimental datasets covering a wide range of soil textures and testing methods. Predictions show strong agreement with measured hydraulic conductivity over several orders of magnitude and successfully reproduce the observed nonlinear dependence on temperature and unfrozen water content. The results indicate that accurate prediction of hydraulic conductivity of saturated frozen soils requires information of both unfrozen water content and pore-scale freezing geometry. Overall, the proposed framework provides a robust and scalable approach for predicting the hydraulic conductivity of saturated frozen soils in cold regions.}
}
@article{XIE2026136160,
title = {Shared versus reservoir-specific policy architectures in multi-agent reinforcement learning for physically heterogeneous cascade reservoir operation},
journal = {Journal of Hydrology},
volume = {679},
pages = {136160},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136160},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012576},
author = {Zaichao Xie and Wei Xu and Yu Xie and Haonan Zhao and Aijun Jiang and Mi Zhou and Siyu Pu and Zhengxuan Li},
keywords = {Cascade reservoir operation, Multi-agent reinforcement learning, Reservoir heterogeneity, HAPPO, MAPPO, Policy parameter sharing},
abstract = {Cascade reservoir operation must coordinate reservoirs with different storage capacities, hydraulic heads, regulation horizons, and downstream service requirements. Cooperative multi-agent reinforcement learning often uses parameter sharing for scalability. However, a single unlabelled shared actor may weaken reservoir-specific release rules in physically heterogeneous cascades. This study examines whether reservoir-specific actor parameterization provides operational advantages over shared-actor parameterization in physically heterogeneous cascades. First, the actor-parameterization problem is framed as a controlled empirical question. Second, Heterogeneous-Agent Proximal Policy Optimization (HAPPO) is compared with aligned Multi-Agent Proximal Policy Optimization (MAPPO) and parameter-matched MAPPO (MAPPO-ParamMatch) under identical reward, action-space, and training settings. Finally, the comparison is evaluated in a representative five-reservoir cascade on the upper Yangtze River. The controlled settings range from the Xiluodu-Xiangjiaba mid-cascade pair to the full five-reservoir cascade including the Three Gorges Reservoir (TGR). In the two-reservoir setting, HAPPO and the MAPPO baselines perform comparably. The HAPPO advantage emerges when the controlled set includes reservoirs with different storage and service roles. In the full cascade, HAPPO increases mean total system generation by 2.46% and achieves relative percentage reductions of 64.8% and 90.9% in the action-violation and guaranteed-output violation rates, respectively, relative to aligned MAPPO. The gains were accompanied by differentiated storage and release decisions across upstream regulation reservoirs, transition reservoirs, and the downstream service reservoir. Under the fixed observation setting used here, reservoir-specific actors outperform the tested unlabelled shared actor when physically different reservoirs are controlled together in this upper Yangtze case.}
}
@article{EEBO2026136039,
title = {Investigating catchment predictors of the fraction of young water variability in streamflow in mesoscale Precambrian Shield catchments in Northeastern Ontario, Canada},
journal = {Journal of Hydrology},
volume = {679},
pages = {136039},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136039},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011364},
author = {Festus O. Eebo and April L. James and C.P.R. McCarter and Arghavan Tafvizi},
keywords = {Fraction of young water, Hydrograph separation, Damping ratio, Hierarchical partitioning regression},
abstract = {Understanding how catchments respond to precipitation under rapidly changing climate and land-uses, is key to long-term management of water resources, including in the understudied northeastern Ontario Canadian shield landscape. However, there is limited knowledge of streamflow generation processes in Precambrian Shield catchments beyond headwater catchments. We estimated the streamflow fraction of young water (Fyw) and damping ratios (DR) in the Sturgeon River-Lake Nipissing-French River (SNF) Basin in northeastern Ontario, Canada using five years of modelled precipitation isotope (δ18O) and 3 to 5 years of streamflow isotope (δ18O) records from sixteen catchments that ranged in size from 27 km2 to 6,919 km2. The Fyw varied between 16 % and 66 %, with no significant difference between unweighted (Fyw) and flow-weighted (Fyw*) estimates (r = 0.99, p < 0.001). Using Pearson correlation and hierarchical partitioning regression (HP), 70.1 % of total variance in Fyw was predicted by five landscape indices. Median topographic wetness index (TWI), fen + marsh area, and mixedwood forest areas were positively correlated with Fyw, while Fyw decreased with increasing area of lake and high runoff potential soil. The median TWI (slope and catchment area dependent) and percent area of fen + marsh were identified as statistically significant Fyw predictors across the basin, while lake area, mixedwood forest area, and high runoff potential soil were less important variables because they co-varied with the other statistically significantly independent variables (TWI and fen + marsh area). This study highlights how wetlands can play different hydrological roles (water storage versus conveyance) at new hydrological information at a scale (mesoscale) and landscape (Precambrian shield) that are underrepresented and yet critical for regional water management.}
}
@article{REN2026136144,
title = {A machine-learning-enhanced fuzzy evaluation framework for hydrochemical evolution and ecohydrological attribution in a megacity river basin},
journal = {Journal of Hydrology},
volume = {679},
pages = {136144},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136144},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012412},
author = {Jie Ren and Guilin Han and Xi Gao and Shitong Zhang and Qian Zhang},
keywords = {Megacity river, Hydrochemistry, Ecohydrological attribution, Fuzzy comprehensive evaluation, Random forest},
abstract = {Megacity rivers are crucial for urban sustainability, supporting water supply, flood control, and ecological services. This study investigated the hydrochemical evolution and driving factors of the Chaobai River basin, a representative megacity river in the Beijing-Tianjin-Hebei region, and developed a Fuzzy Comprehensive Evaluation (FCE) framework for boundary-sensitive water-quality assessment under winter baseflow conditions. The framework integrates Random Forest (RF), Analytic Hierarchy Process (AHP), and Entropy methods to construct a hybrid weighting scheme. Hydrochemical facies and ion-ratio diagnostics indicate a basin-scale downstream shift from carbonate-weathering control toward anthropogenic salinization and nutrient enrichment, evidenced by higher Ca2+/Na+ and Mg2+/Na+ ratios upstream (ANOVA, p < 0.01) and elevated Cl− signatures relative to background rivers (Mann-Whitney, p < 0.01). Comprehensive weighting highlighted Na+, Cl−, NO3−, and K+ as primary water-quality indicators, consistent with cumulative inputs from urban effluents and agricultural sources. FCE results indicated that 83% of samples were classified within Grades I ∼ III, reflecting generally good water quality, whereas the membership-probability analysis showed a dominant tendency toward Grade III ∼ IV, suggesting emerging anthropogenic dominance. The RF-improved FCE framework refined indicator weighting by incorporating nonlinear statistical relationships and provided a more interpretable basis for water-quality classification. Compared with the Entropy-weighted Water Quality Index (EWQI), the FCE method better captured boundary-adjacent conditions and emerging anthropogenic influence that were not resolved by a single composite index. This approach provides a boundary-sensitive framework for linking hydrochemical patterns with water-quality classification in the Chaobai River basin and a methodological reference for regulated rivers under comparable settings.}
}
@article{MISHMASTNEHI2026136131,
title = {A systematic approach to assess fused drone-satellite data for vertical water quality profile estimation in a deep reservoir},
journal = {Journal of Hydrology},
volume = {679},
pages = {136131},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136131},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601228X},
author = {Sadegh {Mishmast Nehi} and Mohammad {Reza Nikoo} and Malik Al-Wardy and Sadegh Vanda and Reza Kerachian},
keywords = {Water quality monitoring, Unmanned aerial vehicle (UAV), Multi-source remote sensing, Deep reservoirs, Water quality profiles, Wadi Dayqah reservoir},
abstract = {In-situ sampling for deep-reservoir water quality monitoring is accurate but often impractical for routine, high-resolution vertical monitoring. Remote sensing (RS) provides an alternative for estimating multiple water quality variables (WQVs), including both optically active and non-optically active variables. However, most existing studies have focused on surface-level estimations, which are inadequate for deep reservoirs where WQVs’ profiles vary significantly with depth. While previous studies have compared remote sensing data sources for estimating water quality, this work addresses a critical gap by providing one of the first systematic evaluations of different data sources specifically for assessing WQVs at lower levels in deep water bodies. To achieve this, we introduce a novel multi-platform systematic framework that evaluates multiple RS data sources (including Sentinel-2 and Landsat 8/9 satellite imagery as well as unmanned aerial vehicle (UAV) observations), alongside fused datasets and machine learning models to estimate vertical profiles of WQVs. The framework was applied to the Wadi Dayqah Dam (Oman), where seven WQVs (temperature, chlorophyll-a, turbidity, EC25, pH, oxidation–reduction potential, and dissolved oxygen) were modeled across depth zones using coincident in-situ measurements for training and validation. Results show that RS-based models can reproduce vertical WQV patterns beyond the surface layer, and that multi-source fusion improves estimation for several non-optically active variables compared with single-source models. Key contributions are: (1) a reproducible evaluation process for selecting RS sources and models for vertical profiling, (2) evidence that multi-source RS improves estimation of depth-varying WQVs in a deep reservoir, and (3) a demonstration on a large reservoir that the approach can extend operational RS monitoring below the surface. This framework can guide future vertical water-quality monitoring and multi-source RS integration.}
}
@article{XU2026136152,
title = {Differential controls of warming and phosphorus enrichment on CO2, CH4, and N2O emissions in shallow lake mesocosms},
journal = {Journal of Hydrology},
volume = {679},
pages = {136152},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136152},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012497},
author = {Xiaoqi Xu and Bowen Hu and Danni Yuan and Guohuan Su and Lan Wang and Ziqi Chen and Kangshun Zhao and Tao Wang and Jun Xu and Min Zhang},
keywords = {GHG fluxes, Climate change, Eutrophication, Submerged plant, Shallow lakes},
abstract = {Climate warming and eutrophication are reshaping greenhouse gas (GHG) emissions from shallow lakes, yet how different warming regimes interact with phosphorus enrichment remains poorly understood. Here, we conducted a year-long experiment using shallow-lake mesocosms planted with aquatic macrophytes to compare constant warming (a sustained 4°C increase) with variable warming (the same mean warming combined with short-term temperature fluctuations), together with phosphorus enrichment. Responses differed markedly among gases. Warming reduced annual CO2 emissions, primarily through indirect changes in macrophyte communities and water chemistry. In contrast, warming increased CH4 emissions mainly through direct thermal effects, although the increase was smaller under variable than under constant warming, reflecting distinct shifts in macrophyte functional composition under the two warming regimes. N2O fluxes were largely insensitive to warming but responded primarily to phosphorus enrichment, which shifted the system from a net annual source to a sink. These findings demonstrate that greenhouse-gas responses to global change cannot be generalized across gases and highlight the need to account for warming regime, nutrient status, and macrophyte functional composition when predicting climate feedbacks from shallow lakes.}
}
@article{ABBAS2026136136,
title = {Disentangling precipitation forcing and parameter uncertainty in a multi-objective surface–subsurface hydrologic modeling framework},
journal = {Journal of Hydrology},
volume = {679},
pages = {136136},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136136},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012333},
author = {Salam A. Abbas and Jeremy T. White and Ryan T. Bailey and Michael J. White and Natalja Čerkasova and Jeffrey G. Arnold},
keywords = {Coupled surface–subsurface hydrologic modeling, Precipitation forcing uncertainty, Ensemble calibration, Iterative ensemble smoother, SWAT+},
abstract = {Precipitation forcing uncertainty can substantially influence parameter estimation and predictive performance in coupled surface–subsurface hydrologic models, yet practical strategies for explicitly representing this uncertainty during calibration remain limited. Here, precipitation forcing was parameterized to represent precipitation uncertainty and aspects of model misspecification, thereby reducing compensatory adjustment of hydrologic parameters during calibration. We constructed coupled surface–subsurface hydrologic models (SWAT+ gwflow) for two humid-region watersheds, the Winnebago River basin (Iowa, USA) and the Monocacy River basin (Maryland, USA), and employed the Iterative Ensemble Smoother (iES) for calibration using monthly mean streamflow and remotely sensed evapotranspiration (ET). Three calibration configurations were evaluated: streamflow-only, ET-only, and joint streamflow–ET calibration. Two precipitation parameterization schemes were evaluated: Precipitation-Variable (PV), where daily precipitation inputs were adjusted using time-varying precipitation multipliers, and Precipitation-Fixed (PF), where precipitation remained constant during calibration. In the Winnebago River basin, PV resulted in significant improvement in streamflow simulation during simultaneous streamflow–ET calibration, increasing NSE from 0.48 to 0.79 during calibration and from 0.25 to 0.81 during testing relative to PF, while also decreasing groundwater head bias at several monitoring wells. In contrast, the Monocacy River basin exhibited similarly strong streamflow performance under both PV and PF experiments, demonstrating that the benefits of precipitation parameterization were watershed-dependent rather than universal. Simulated ET performance showed only insignificant variation among PV and PF experiments in both watersheds, with R2 values generally near 0.90. Water-balance partitioning differed significantly between experiments, with PV notably decreasing simulated groundwater recharge in the Winnebago basin relative to PF, showing how precipitation forcing uncertainty influences coupled surface–subsurface hydrologic fluxes and affects parameter sensitivity patterns. The proposed framework extends precipitation-uncertainty analysis to coupled surface–subsurface hydrologic modeling, providing insight into how precipitation forcing uncertainty interacts with parameter estimation, sensitivity patterns, and water-balance partitioning across contrasting watershed settings, with implications for uncertainty-aware model calibration and interpretation.}
}
@article{CUI2026136188,
title = {From longitudinal dispersal to vertical sequestration: Hydraulic regulation drives divergent antibiotic fates via suspended particulate matter dynamics across natural and engineered waterways},
journal = {Journal of Hydrology},
volume = {679},
pages = {136188},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136188},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012850},
author = {Yang Cui and Hui Xie and Jianwei Dong and Meiqi Shang and Shiya Gu and Wu Wen},
keywords = {Antibiotics, Hydraulic regulation, Suspended particulate matter, Natural rivers, Regulated canals},
abstract = {Hydrodynamic conditions fundamentally regulate contaminant transport, yet it remains unclear how anthropogenic hydrodynamic shifts drive divergent antibiotic fates across coexisting natural and artificial waterways, particularly through their impacts on suspended particulate matter (SPM) dynamics. This study compared antibiotic occurrence, transport, and fate between a natural river and a sluice-regulated canal within the same agricultural watershed. Aqueous-phase antibiotic concentrations were significantly higher in the river (p < 0.05), while solid-phase levels were comparable between the two systems. However, the river exhibited greater compositional complexity, whereas the canal showed a simplified solid-phase profile dominated by tetracyclines. In the natural river, high connectivity and active flow maintained antibiotics in dissolved and SPM-bound phases, promoting longitudinal transport and spatial dispersal. Conversely, the regulated canal functioned as a segmented reactor, divided into hydraulically distinct sections with distinct aqueous antibiotic compositions under closed-gate conditions (p < 0.05). Low-energy flow and finer-grained sediment accumulation synergistically enhanced the sediment-partitioning affinity of particle-reactive antibiotics, thereby transforming SPM from a mobile carrier in the river into a settling shuttle in the canal that sequestered contaminants locally. Additionally, gate operation may remobilize retained particles and sediment-associated antibiotics, shifting the canal from a sequestration-dominated state toward a transport/release state. Our findings revealed that hydraulic regulation fundamentally dictated antibiotic transport, sequestration, and remobilization by altering SPM dynamics. Consequently, optimizing infrastructure operations and managing particulate fluxes emerge as critical strategies for mitigating localized ecological risks in agriculturally impacted waterways.}
}
@article{WANG2026136195,
title = {Hydrologic connectivity from cryospheric waters to groundwater in the Southeastern Tibetan Plateau, China: recharge pathways and seasonal regulation from multiple tracers},
journal = {Journal of Hydrology},
volume = {679},
pages = {136195},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136195},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012928},
author = {Zejun Wang and Zhi Dou and Jinguo Wang and Liang Chen and Zhen Liao and Hao Yu and Zhifang Zhou},
keywords = {Tibetan Plateau, Cryospheric waters, Groundwater recharge, Hydrologic connectivity, Multi-tracer, Isotopes},
abstract = {Groundwater is a critical but insufficiently constrained component of water storage and transfer in cryosphere-influenced headwaters of the Tibetan Plateau. During 2024 − 2025, hydrologic connectivity from rainfall, snowmelt, glacial lake water, and river water to shallow and deep groundwater in the southeastern Tibetan Plateau was investigated using hydrologic monitoring, major ions, hydrogen and oxygen stable isotopes, radon-222, tritium, and radiocarbon. Estimated recharge elevations exceeded sampling elevations, indicating dominant lateral recharge from higher terrain rather than local infiltration across the catchment. Summer snowmelt yielded the highest recharge elevations and greatest apparent circulation depths, whereas glacial lakes buffered and mixed source waters and rivers transferred integrated cryospheric signals to groundwater. Bayesian apportionment showed that direct snowmelt contributed 4.6 − 16.1% of modeled groundwater, while glacial-lake and river water together accounted for 71.2 − 75.3%. Hydrochemical evolution toward groundwater involved increasing mineralization, stronger water − rock interaction, and enhanced cation exchange. Cave groundwater exhibited pronounced hydrochemical heterogeneity and very high summer radon-222, indicating seasonally activated fracture flow, rapid shallow recharge, and active groundwater − surface water exchange. In contrast, borehole groundwater represented a more buffered system, including river-coupled pathways in H1-H2 boreholes and a distinct lake-buffered pathway in H3 borehole. Measurable tritium in all groundwater samples demonstrated widespread modern recharge, whereas depressed radiocarbon activities and corrected apparent ages revealed simultaneous mixing with older stored water. This work shows that groundwater circulation in Tibetan Plateau is organized as a hierarchical and seasonally shifting multi-source connectivity network, providing critical insights for water and element cycling in the plateau’s critical zone.}
}
@article{ZHOU2026136163,
title = {Diverging hydrometeorological drivers of flashier floods in a warming climate},
journal = {Journal of Hydrology},
volume = {679},
pages = {136163},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136163},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012606},
author = {Fengjia Zhou and Shuo Wang and Louise Slater and Peirong Lin and Hanbo Yang and Sijie Tang and Amir AghaKouchak},
keywords = {Flash flood, Climate change, Explainable machine learning},
abstract = {The monitoring and forecasting of flash floods present significant challenges due to their rapid onset. While extreme rainfall events, a primary driver of flooding, are becoming flashier, there is no consensus on whether floods will exhibit similar trends in a warming climate. Here, we assess flash flood risk development over four decades across 741 basins globally using the flashiness index. Our findings reveal a significant shift towards flashier floods in nearly one-third of the basins, predominantly concentrated in cold and arid regions of the northern mid-latitudes. In these regions, the increase in flashiness is largely associated with larger flood peaks rather than changes in timing. We identify basins characterised by rising flood peaks, which are likely to require flood defence infrastructure capable of withstanding more severe flood events, as well as those marked by shorter onset times, which may face challenges in implementing short-term early warning systems. Specifically, the increase in flashiness in most North American basins is mainly associated with rising flood peaks, whereas in most European basins, it is dominated by shorter onset times. These findings underscore the urgency of implementing region-specific strategies to adapt to flashier floods in a warmer future.}
}
@article{CAO2026136187,
title = {Interpretable modeling of spatiotemporal variations of groundwater total hardness across China},
journal = {Journal of Hydrology},
volume = {679},
pages = {136187},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136187},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012849},
author = {Chenglong Cao and Qing Zhou and Junliang Jin and Fenghua You and Lei Yao and Hongzhe Pan and Wei Gan and Jiangjiang Zhang and Yijun Yao},
keywords = {Groundwater total hardness, China, Interpretable machine learning, Predictive modeling},
abstract = {High groundwater total hardness (GTH) poses significant risks to human health, agriculture, and industry, yet field observations suggest severe conditions in China. To investigate the spatiotemporal variations of GTH and its key predictors, we developed an interpretable machine learning model (validation R2 = 0.76) linking GTH observations compiled from published studies with 34 natural and anthropogenic variables, including geology and soil properties, climate conditions, human activities, and vegetation cover. The results reveal pronounced spatial heterogeneity, with higher GTH in northern and coastal regions and lower values in southern China, as well as distinct dominant predictors across land-use types. National mean GTH increased from 381.60 mg/L in 1980 to 399.26 mg/L in 2015, followed by a slight decline to 393.75 mg/L in 2020. Future projections indicate continued increases under constant 2020 human activity levels and under high-emission scenarios, while a low-emission pathway leads to a modest reduction. SHapley Additive exPlanations (SHAP) analysis identifies geology and soil properties (46.31%) and climate conditions (28.37%) as the most important predictor groups in GTH predictions, followed by human activities and vegetation. These findings provide insights into groundwater hardening and support targeted mitigation strategies combining climate regulation, geological and soil management, reduction of anthropogenic pressures, and vegetation restoration.}
}
@article{PAN2026136134,
title = {Estimating daily evapotranspiration from remotely sensed instantaneous observations with surface flux equilibrium (SFE) theory and maximum entropy production (MEP) principle},
journal = {Journal of Hydrology},
volume = {679},
pages = {136134},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136134},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601231X},
author = {Xin Pan and Zhanchuan Wang and Jinlong Shi and Yuanbo Liu and Zi Yang and Xu Ding and Suyi Liu and Hongjun Zhu and Congbao Zhu and Shile Yang and Yingbao Yang},
keywords = {Temporal upscaling, Evapotranspiration, Remote sensing, Surface flux equilibrium theory, Maximum entropy production principle},
abstract = {As the important component in the regional water and energy budget, territorial evapotranspiration (ET) can be derived from remote sensing with the help of temporal upscaling method. In this study, a temporal upscaling method was developed on basis of physics-based Surface Flux Equilibrium (SFE) Theory and Maximum Entropy Production (MEP) Principle. The proposed method eliminates the uncertainties derived from the empirical assumption of constant coefficients and the semi-empirical parameterization of resistances in traditional methods, and can be transferred to two conventional temporal upscaling method in some situations. Validated by ground observations at 80 globally distributed sites, the proposed method (only using ground observations) shows a satisfactory accuracy, especially in the situations of the medium aridity (RMSE: 16 W/m2), high vegetation coverage (RMSE: 20 W/m2) and low latitude (14 W/m2). Furthermore, the proposed method shows the best performance when only using remote sensing with a RMSE (R2) of 34 W/m2 (0.53). The proposed method also provides an optionally optimum simplification with a similar RMSE&RE and a relatively more significant underestimation (near to 25% of underestimation for only using remote sensing). It believed that the proposed method is helpful for the temporally upscaling (from remote sensed instantaneous ET to daily ET) in the producing of global daily or monthly ET products.}
}
@article{LIU2026136155,
title = {Differential response of floods to climate change and human activities in the Yalu River over the past two millennia: insights from hydrological modeling},
journal = {Journal of Hydrology},
volume = {679},
pages = {136155},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136155},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012527},
author = {Shengjing Liu and Yong Shi and Tao Liu and Tao Jiang and Chipeng He and Jixuan Lyu and Afei Hou and Guang Yang and Yang Yang and Xiaomei Xu and Shuo Zhang and Jianhua Gao},
abstract = {Floods are severe natural disasters threatening the world, and their long-term evolution patterns are crucial for regional security and sustainable development. Based on the hydrological model HYDROTREND, combined with the Generalized Extreme Value (GEV) analysis and scenario simulation experiments, this study reconstructs annual peak flow over the past 2000 years in the Yalu River and quantitatively analyzes the differential impacts of climate change and human activities on floods of different intensities. The GEV analysis provides long-term baseline estimates of return-period flood magnitudes, allowing the relative responses of floods with different intensities to climate change and human activities to be evaluated. Scenario simulations indicate that the impacts of human activities (reservoir regulation and changes in forest coverage) on floods decrease with increasing flood intensity, whereas the opposite applies to climate change: small-to-medium floods are more significantly influenced by human activities (both reservoir and forest effects >23%), while extreme floods are more sensitive to climate change (>27.06%). Comparison with the long-term evolution of large-scale climate modes suggests that variations in flood intensity in the Yalu River Basin are broadly consistent with the Pacific Decadal Oscillation (PDO), and tend to strengthen (weaken) during El Niño (La Niña) events. This study quantifies the differential impacts of climate change and human activities on floods of varying intensities in the Yalu River basin, and provides a scientific basis for basin-scale flood risk assessment and management under changing climatic and human activity conditions.}
}
@article{SHAHMANSOURI2026136082,
title = {Stability of physical and hydraulic characteristics of biochar- and rockwool-based growing media under wetting and drying processes},
journal = {Journal of Hydrology},
volume = {679},
pages = {136082},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136082},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011790},
author = {Shahrokh Shahmansouri and Mohammad Reza Mosaddeghi and Hossein Shariatmadari and Jean Caron},
keywords = {Water retention, Easily available water, Air-filled porosity, Water holding capacity, Saturated hydraulic conductivity, Water repellency},
abstract = {Growing medium plays an important role in providing water, air, and mechanical support for plants in soilless culture. There is little information about the stability of physical and hydraulic characteristics of growth media in consecutive cultivations and wetting–drying (W/D) cycles. It is evident that superior substrates are those with characteristics remaining stable over time and reusable for several cultivation cycles. Therefore, this study was conducted to investigate the effects of W/D cycles on physical and hydraulic characteristics of 14 growing media including biochar- and rockwool-based substrates and Coir pith-Perlite (as reference). Ten W/D cycles were applied on the substrates, and subsidence, mass reduction, water retention, saturated hydraulic conductivity, and some physical indicators were monitored. The W/D cycles significantly changed the physical and hydraulic characteristics which were related to fragmentation of particles, alteration of particle/pore size distribution and particle arrangement, swelling/shrinking and subsidence. The W/D cycles increased the frequency of micropores and saturated water content (θs, 0.694 → 0.742  cm3 cm⁻3). Besides, the W/D cycles had a positive effect on easily available water (EAW, 0.194 → 0.204  cm3 cm⁻3), water holding capacity (WHC, 0.603 → 0.615  cm3 cm⁻3), and air-filled porosity (AFP, 0.103 → 0.141  cm3 cm⁻3) in most substrates. However, the increase in pore tortuosity and micropores upon W/D cycles significantly decreased saturated hydraulic conductivity (Ks, 121 → 65.7  cm h⁻1) in most substrates. Intensive/dynamic quantities (such as Ks) are superior due to their importance in air/water relations and sensitivity to microstructure and pore size distribution. The increase of AFP and the decrease of residual water content showed that adsorbed water decreased due to the W/D cycles in most substrates. Water repellency (WDPT, 5.7 → 20.2  s) increased in most growing media upon W/D cycles, which could be due to the rearrangement of particles and decomposition of organic matter into hydrophobic particles. The properties of inorganic substrate RW(0.1)-Perlite (0.1 v/v rockwool and 0.9 v/v perlite) did not change after W/D cycles. Whereas the organic-based growing media altered greater upon the W/D cycles. Almost all substrates having biochar and rockwool showed comparable stability/suitability with Coir pith-Perlite. Our results would be valuable to recommend alternative stable substrates to greenhouse growers for long term use, provided the economic stands.}
}
@article{FENG2026136216,
title = {Artificial intelligence-based response surface stochastic dynamic programming for long-term operation rule derivation of cascade hydropower reservoirs},
journal = {Journal of Hydrology},
volume = {679},
pages = {136216},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136216},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013132},
author = {Zhong-kai Feng and Xuan Chao and Yang Xiao and Hong-wu Tang and Wen-jing Niu and Tao-tao Zhang and Ling-zhong Kong},
keywords = {Cascade reservoirs, Long-term optimal operation, Stochastic dynamic programming, Response surface, Artificial intelligence},
abstract = {Stochastic dynamic programming (SDP) is a classic method for long-term optimal power generation operation of hydropower reservoirs under uncertain inflow conditions. However, its inherent “curse of dimensionality” leads to an exponential increase in computation complexity with the number of state variables, severely limiting the solution efficiency and the timeliness of engineering applications. Thus, a response surface-based stochastic dynamic programming (RSSDP) algorithm is developed for long-term optimal power generation operation of hydropower reservoirs. This algorithm employs artificial intelligence models to replace the repetitive calculation of period-averaged power output in SDP, thereby avoiding redundant computations while fully preserving the core search mechanism and recursive structure of SDP, thus significantly improving computational efficiency. Taking the cascade hydropower reservoirs in the upper reaches of Yellow River as the study case, the effectiveness of our method was validated through designed multi-scenario comparative experiments. Results indicate that, while ensuring scheduling accuracy comparable to that of traditional SDP, RSSDP achieves a significant enhancement in computational efficiency, with the speedup ratio exceeding 6-fold for both 2-reservoir systems; furthermore, the larger the scale of the cascade system, the more pronounced the efficiency advantage becomes. Thus, RSSDP can provide an efficient and feasible technical pathway for the formulation of long-term optimal operation rules for cascade reservoirs.}
}
@article{HU2026136147,
title = {Beyond prediction accuracy: using differentiable hybrid models as a tool for hydrological knowledge discovery},
journal = {Journal of Hydrology},
volume = {679},
pages = {136147},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136147},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012448},
author = {Yuqian Hu and Wenhao Chu and Yuxuan Wang and Chunxiao Zhang and Rongrong Li and Heng Li and Yazhou Qi},
keywords = {Differentiable hybrid modelling, Process-based hydrological model, Knowledge discovery, Large-scale hydrology},
abstract = {Differentiable hybrid modelling has dramatically improved streamflow prediction, yet its potential as a tool for genuine scientific discovery remains largely untapped. This study introduces a closed “diagnosis-extraction-improvement” framework that repurposes differentiable hybrids to identify, correct, and theoretically advance structural deficiencies in traditional process-based hydrological models. Using a fully differentiable implementation of the widely used EXP-HYDRO model across 476 diverse CAMELS catchments, we report three primary findings: (1) Quantitative Diagnosis: Systematic replacement of individual process modules with neural surrogates quantitatively identified the temperature- and daylength-based Hamon potential evapotranspiration (PET) formulation as the dominant structural bottleneck at the continental scale, underscoring the limitations of temperature-only empirical approaches. (2) Knowledge Extraction: Symbolic regression successfully distilled the high-performing neural PET surrogate into a parsimonious analytical expression. This discovered equation, explicitly incorporating shortwave radiation and a nonlinear self-regulating term, recovered >85% of the predictive skill originally provided by the complex neural surrogate under both basin-specific and fully regionalised calibration strategies. (3) Theoretical Improvement: Reintegration of the discovered equation into the original EXP-HYDRO model fundamentally enhanced physical realism. The new formulation eliminated long-standing radiation-related systematic biases, substantially reduced long-term water balance errors, and restored consistency with the Budyko hypothesis across diverse hydroclimatic regimes. Importantly, these three findings form a framework that unlike previously reported improvements by (i) objectively ranking structural deficiencies, (ii) extracting an interpretable equation directly from constrained neural surrogates, and (iii) proving physical-bias elimination without compensation, a combination not previously achieved at continental scale. Collectively, these results demonstrate that differentiable hybrid systems combined with symbolic regression can serve as powerful tool for accelerating theory-guided discovery and systematic modernisation of hydrological process representations.}
}
@article{KONG2026136183,
title = {Integrating deep-learning detection and hydrological monitoring for driftwood flux estimation in a steep tropical watershed during a typhoon-driven flood},
journal = {Journal of Hydrology},
volume = {679},
pages = {136183},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136183},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012801},
author = {Qian-Yun Kong and Ci-Jian Yang and Cheng-Hua Tsai and Meng-Yu Lee},
keywords = {Driftwood flux, YOLOv8, RFID, Drones, Green carbon, Deep learning},
abstract = {Extreme climatic events, such as typhoons, mobilize massive amounts of deadwood in steep mountain watersheds, serving as a critical link in the global carbon cycle. However, capturing the event-scale dynamics of driftwood flux remains challenging due to the hazardous conditions and limitations of traditional monitoring. Here, we developed a reproducible workflow integrating deep learning (YOLOv8) with fixed-interval surveillance cameras and drone imagery to quantify driftwood flux and storage in the Liwu watershed, Taiwan. We used a comprehensive dataset comprising Swiss, Arctic, and local imagery to train separate domain-specific YOLOv8 models for three driftwood domain types: instream, riverbank, and nearshore. Two detection models were used: object detection for localisation, and instance segmentation to provide the polygon areas used in the quantitative calculations. To translate detection into volume of driftwood, we established an area-to-volume conversion using radio-frequency identification (RFID)-tagged logs. The YOLOv8 model demonstrated exceptional performance for instream detection (mAP50 = 94.36%; F1 = 92.59%), validating its feasibility for automated fixed-interval monitoring. Applying this model to Typhoon Kong-rey (2024), where the water stage rose from 40.5 to 45 m (increasing discharge from 19.94 to 705.73 m3 s−1), yielded an estimated instream driftwood mass of 1.12 ± 0.22 × 104 t and a corresponding carbon stock of 5.26 ± 1.05 × 103 tC. Moreover, post-event drone mapping revealed that driftwood preferentially accumulates along outer river banks and forms banded deposits on nearshore beaches. Our findings highlight pulsed driftwood transportation as a quantifiable component of green carbon and demonstrate the feasibility of integrating deep learning-based detection with hydrological monitoring for carbon budget assessments.}
}
@article{ZEYDALINEJAD2026136139,
title = {How to overcome hydrologic data scarcity in assessing potential groundwater risk to subterranean infrastructure: a finite-difference modelling approach},
journal = {Journal of Hydrology},
volume = {679},
pages = {136139},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136139},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012369},
author = {Nejat Zeydalinejad and Akbar A. Javadi and Mark Jacob and David Baldock and James L. Webber},
keywords = {Groundwater modelling, Groundwater infiltration, Sewer systems, MODFLOW, Data scarcity},
abstract = {Groundwater infiltration (GWI) in sewer networks is an increasing challenge under climate change and human pressures, threatening the sustainability of sewer infrastructure. However, data scarcity and complex hydrogeology complicate its risk assessment. This study develops a finite-difference groundwater flow model (MODFLOW) to identify GWI susceptibility hotspots in non-pressurised sewer networks in Dawlish, southwest United Kingdom. To address limited hydrological data and hard-rock hydrogeology, several transferable approaches were integrated into the modelling framework. Fracture flow was represented using a porous-medium approximation, while borehole logs were interpreted to define the bedrock surface and estimate hydraulic properties. Groundwater recharge was derived from land-cover data, missing river stages were estimated from discharge–stage relationships, and initial node heads were assigned from river-network connectivity and upstream–downstream positions. These inputs, together with hydraulic properties and recharge, were refined through calibration. The model was calibrated for October 2007 to September 2020 and validated over the following four years using monthly time steps, achieving a mean error of − 0.05 m, a mean absolute error of 0.94 m, and a root mean square error of 1.62 m. Then, sewer sections were classified as having high (groundwater level (GWL) above the sewer), intermediate (GWL within 2 m below the sewer), or low (GWL more than 2 m below the sewer) GWI susceptibility. More than 85% of storm overflow spills occurred in sewers classified as highly susceptible. The resulting hotspot maps provide a practical decision-support tool for prioritising sewer inspection, maintenance, and rehabilitation, supporting more sustainable sewer network management.}
}
@article{CHEN2026136175,
title = {Competitive adsorption and co-transport of live and hypochlorite-inactivated Azospirillum brasilense in saturated sand},
journal = {Journal of Hydrology},
volume = {679},
pages = {136175},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136175},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012722},
author = {Fengxian Chen and Zeev Ronen and Gilboa Arye},
keywords = {Plant growth-promoting bacteria, Bacterial transport, Competitive adsorption, Hypochlorite-inactivated bacterial cells, Drip irrigation inoculation},
abstract = {Azospirillum brasilense is widely applied in cereal production to enhance plant growth and stress tolerance, and its mobility in sandy soils is critical for successful root colonization. In irrigation systems, operational disinfection processes can unintentionally reduce bacterial viability, generating large fractions of inactivated cells that may coexist and interact with live cells during subsurface transport. Here, we investigated the physicochemical properties, adsorption behavior, and co-transport dynamics of live and hypochlorite-inactivated A. brasilense strains Sp7 and Cd in saturated sand. Inactivated cells exhibited slight reductions in cell size, increased hydrophobicity, and less negative surface charge, which together lowered the XDLVO interaction energy barrier and enhanced their affinity for sand surfaces. Adsorption isotherms showed clear competitive adsorption between live and inactivated cells, with inactivated cells exhibiting stronger overall attachment. Column transport experiments further revealed that live cells transported more rapidly and were recovered in greater proportions than inactivated cells, whereas inactivated cells showed stronger retention and lower detachment. In mixed systems, the presence of inactivated cells reduced the effective retention capacity available to live cells and altered their attachment behavior. The one-site and two-site attachment/detachment model with Langmuirian blocking successfully described the observed breakthrough curves and retention profiles. These results indicate that inactivated bacterial biomass is not inert but can influence bacterial retention and transport by competing for retention domains and modifying attachment dynamics. Accounting for viability-dependent changes in surface properties and competitive interactions may help improve predictions of beneficial bacterial mobility and delivery efficiency in sandy soils.}
}
@article{POTTER2026136143,
title = {Changing phosphorus dynamics across subtropical river networks in an urban watershed: insights from a 25-year record under a changing climate},
journal = {Journal of Hydrology},
volume = {679},
pages = {136143},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136143},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012400},
author = {Lee Potter and Gregg A. Snedden and Matthew Hiatt and John R. White},
keywords = {Phosphorus dynamics, ENSO variability, Watershed land use changes, SRP:TP, Subtropical rivers},
abstract = {Phosphorus (P) in aquatic systems is a key nutrient for primary productivity and has become increasingly important in global studies of water quality and eutrophication in coastal systems. This study examines P dynamics and watershed changes in four major tributaries of the Lake Pontchartrain estuary: the Amite, Tangipahoa, Tickfaw, and Tchefuncte rivers. Long-term monitoring data (2000–2024) and a targeted 2024 field campaign were utilized to evaluate nutrient concentrations, discharge, land-use changes, and climate patterns across the watersheds. Mean discharge ranged from 81.6 ± 201 m3 s⁻1 in the Amite to 8.5 ± 29.1 m3 s⁻1 in the Tchefuncte, with winter–spring flows accounting for 58–66% of annual totals. Total phosphorus (TP) concentrations averaged 0.15 ± 0.06 mg L⁻1 in the Amite and 0.11 ± 0.04 mg L⁻1 in the three remaining rivers. Nitrate (NOx; NO2 + NO3) was greatest in the Tangipahoa (0.25 ± 0.07mg L⁻1) compared to 0.16 ± 0.07 mg L⁻1 average across the three other rivers. Across all samples from the 2024 field sampling year, soluble reactive phosphorus (SRP) comprised an average of 57% of TP during the 2024 observational study, remaining constant at 58% during dry months relative to 52% in wet months, and accounted for 90% of total dissolved phosphorus (TDP) during the observational year. Land-use analysis (2000–2024) revealed a 12% increase of development land area, alongside declines in shrubland (–22%), pasture (−18%), and wetlands (−2%). El Niño-Southern Oscillation (ENSO) variability influenced discharge and precipitation patterns, with El Niño years characterized by 27% greater precipitation and elevated P and NOx loading compared to neutral years, and La Niña years associated with relatively lower flow dry years and a reversal of the typical relative wet and dry seasons. These results are consistent with the notion that P transport is temporally correlated with both hydrologic variability and watershed development. Additionally, the prevalence of SRP as the primary dissolved P fraction indicates a potential for rapid mobilization of bioavailable P under changing watershed and climate conditions.}
}
@article{GONG2026136162,
title = {Intensifying floods may not imply cascading flood risks in dryland rivers},
journal = {Journal of Hydrology},
volume = {679},
pages = {136162},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136162},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601259X},
author = {Xintong Gong and Qiang Zhang and Gang Wang and Xinning Gao and Linghua Qiu and Hushuang Ma and Anlan Feng and Zhi Li and Yungang Bai and Yaning Chen and Xuelian An and Xiaoqing Wu},
keywords = {Flood risk decoupling, Dryland floods, Exposure-vulnerability, Energy transmission modeling, Machine learning},
abstract = {Flood risk management has long assumed that hazard intensification drives proportional risk escalation. Yet the mechanisms by which exposure-vulnerability architecture decouples this relationship remain poorly constrained. Integrating 65-year flood records, hydrodynamic simulation, and machine-learning vulnerability assessment across three glacier-fed dryland rivers in China’s Xinjiang, we find that hazard intensity explains only 42% of flood risk variance (95% CI: 36–48%). The strongest-hazard basin carries less than half the risk of a basin with no significant hazard trend, a ranking inversion structurally produced by contrasting asset compositions where residential concentration amplifies realized risk independently of hydrological forcing and agricultural dominance suppresses it. High-efficiency regulation deepens this decoupling locally, as 67% peak attenuation in the Hotan River concentrates residual energy at breach corridors where localized risk reaches 60% of the unregulated baseline despite basin-wide suppression. Flood risk is thus an emergent property of exposure-vulnerability architecture, not a hydrological output-a finding with direct implications for infrastructure investment prioritization in water-scarce drylands globally.}
}
@article{BASIRIFARD2026136204,
title = {A hyperparameter tuning strategy for an LSTM model to simulate reservoir outflows: large-scale evaluation across 441 dams in the CONUS},
journal = {Journal of Hydrology},
volume = {679},
pages = {136204},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136204},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013016},
author = {Milad Basirifard and Jiaorui Zhang and Jie Cao and Xiaofeng Liu and Yi Hong and Tiantian Yang},
keywords = {Reservoir operation, Reservoir release prediction, Long short-term memory, Bayesian optimization, Tree-structured Parzen estimator, Hyperparameter tuning},
abstract = {Artificial intelligence (AI) and deep learning (DL) models are effective tools for simulating reservoir operations by representing nonlinear relationships among reservoir states, hydrological and climatic conditions, and human-controlled release decisions. However, the value of systematic hyperparameter optimization remains insufficiently evaluated across heterogeneous reservoir systems. This study applies Bayesian optimization using a Tree-structured Parzen estimator (BO-TPE) to reservoir-specific long short-term memory (LSTM) tuning for the simulation of daily releases from 441 reservoirs across the contiguous United States (CONUS). The BO-TPE-tuned LSTM (LSTM-TPE) was evaluated against two fixed-hyperparameter LSTM configurations and conventional machine-learning (ML) models, including artificial neural network (ANN), support vector regression (SVR), and random forest (RF), under both grid-search and fixed-budget TPE tuning. All models used six input variables: reservoir storage, inflow, precipitation, air temperature, the Palmer Drought Severity Index (PDSI), and snow water equivalent (SWE), representing key reservoir-state, hydrological, meteorological, and climatic controls on human-managed releases. The results showed that LSTM-TPE generally outperformed the conventional ML models and fixed-hyperparameter LSTM configurations, achieving median NSE and KGE values of 0.78 and 0.81, respectively. Using satisfactory-performance thresholds of NSE > 0.6 and KGE > 0.6, LSTM-TPE achieved satisfactory performance for 345 reservoirs (78.2%) and 356 reservoirs (80.7%), respectively. Bootstrap analysis was used to derive heuristic 95% confidence intervals (CIs) summarizing performance variability across sampled LSTM hyperparameter configurations. Narrower CIs were generally associated with better-performing reservoirs, whereas wider CIs were more common in southern and Intermountain regions and may reflect greater operational complexity and hydroclimatic variability.}
}
@article{ZHENG2026136115,
title = {Physics-guided urban flood modeling: spatial heterogeneity and diagnostic attribution via CMoE-HDAF},
journal = {Journal of Hydrology},
volume = {679},
pages = {136115},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136115},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012126},
author = {Shaoxu Zheng and Ziwu Fan and Xuan Huang and Guang Yang and Yipeng Liao and Yunfei Hong and Jingxiu Wu and Guoqing Liu and Chen Xie},
keywords = {Urban pluvial flood, Surrogate modelling, Explainable AI, Mixture of experts, Urban resilience},
abstract = {Urban flood forecasting in high-density cities requires models that can represent complex hydrodynamic responses while remaining computationally efficient. Conventional hydrodynamic models provide detailed simulations but are often too time-consuming for rapid scenario screening or ensemble analysis. This study develops CMoE-HDAF, a physically structured surrogate modelling framework that integrates a Cluster-based Mixture-of-Experts architecture with a Hierarchical Dominance Attribution Framework for the Longgang River Basin in Shenzhen, China. A calibrated InfoWorks ICM model was used to generate simulation-based reference inundation data for 45 rainfall scenarios over 243,944 computational nodes. The CMoE component partitions the basin into 25 hydrological regimes using static terrain, pipe-network, and hydrographic attributes, and regime-specific expert models are trained to represent local rainfall–inundation relationships. HDAF organizes feature-level contributions into subsystem-level diagnostic indicators for Terrain, Pipe Network, and Hydrography, supporting multi-scale interpretation of terrain, drainage, and hydrographic controls on inundation response. Compared with hydrodynamic simulations, the surrogate achieved a Nash-Sutcliffe Efficiency of 0.9761 and reduced basin-wide inference time to 32 s. The attribution analysis further characterized how the relative influence of terrain, pipe-network, and hydrographic conditions varied across rainfall scenarios and hydrological regimes. Overall, CMoE-HDAF provides a calibrated-model emulator and diagnostic attribution tool for rapid analysis and spatially structured interpretation of heterogeneous urban inundation responses.}
}
