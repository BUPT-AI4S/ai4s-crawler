@article{CHEN2026136153,
title = {Intensifying dry-to-wet extremes across Europe: long-term evolution and contrasting impacts on vegetation dynamics},
journal = {Journal of Hydrology},
volume = {679},
pages = {136153},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136153},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012503},
author = {Haiyan Chen and Ye Tuo and Niklas Boers and Markus Disse},
keywords = {Compound extremes, Hydroclimatic risks, Dry-to-wet extremes, Vegetation responses},
abstract = {Dry‑to‑wet extremes (DTWEs) pose mounting risks to ecosystems and human societies, yet their large‑scale ecological consequences remain unclear. Here, we present the first pan‑European assessment of DTWEs and their impacts on terrestrial ecosystems by coupling long‑term changes in DTWEs (1950–2022) with vegetation dynamics (1980–2020). We quantify DTWEs-vegetation linkages using a dual framework that combines correlation analysis with causal diagnostics (convergent cross mapping, CCM) to distinguish statistical association from inferred directional dependence. Our analysis reveals a pronounced intensification of DTWEs across Europe, characterized by increasing spatial extent, frequency, and intensity. Vegetation responses are season-dependent. Low-to-moderate intensity DTWEs occurring before the core growing season are generally associated with enhanced vegetation productivity, whereas those occurring during the growing season tend to be linked to widespread suppression. CCM-based analyses indicate that causal signals are more detectable early in the season, while signals during peak growth are more likely to be influenced by confounding factors. Specifically, soil moisture (SM) acts as an intermediate variable: controlling for SM strengthens the DTWE-vegetation association in the pre‑season window but weakens it during the growing season. Spatial analyses reveal heterogeneous vegetation sensitivity, with humid regions showing the largest spatial extent of significant responses and transitional climates exhibiting greater relative vulnerability to DTWEs. These findings reveal the ongoing intensification of DTWEs and demonstrate that their vegetation impacts vary with seasonal timing, antecedent soil-moisture, and regional climate, thereby informing targeted adaptation strategies amid increasing hydroclimatic volatility.}
}
@article{DENG2026136214,
title = {Identifying spatially non-stationary drivers of heavy metal contamination in karst groundwater using an interpretable geospatial framework},
journal = {Journal of Hydrology},
volume = {679},
pages = {136214},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136214},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013119},
author = {Jiayi Deng and Deshen Xu and Yu Hou and Min Wu and Dongyuan Luo and Qiang Tang and Shengyan Pu},
keywords = {Karst groundwater, Heavy metal contamination, Spatial differentiation, GeoDetector, GWRF, GeoShapley, Spatial non-stationarity},
abstract = {The dual-porosity conduit-fracture architecture of karst aquifers generates pronounced spatial heterogeneity in heavy metal contamination, yet conventional global models assume spatially homogeneous driver effects and thus fail to capture spatial non-stationarity—the phenomenon whereby the influence of environmental and socioeconomic factors on contamination varies, and may even reverse, across locations. To address this gap, we develop a stepwise analytical framework progressing from pattern identification (spatial autocorrelation) through global factor quantification (GeoDetector) to spatially explicit non-stationary attribution (GWRF-GeoShapley), and apply it to karst groundwater across Guangxi, southwestern China, focusing on lead (Pb) and arsenic (As) as geochemically contrasting representatives. Results show that factor interactions consistently enhance contamination effects for both elements, yet their spatial differentiation mechanisms diverge fundamentally. Pb contamination is primarily linked to anthropogenic activities, forming multi-core fragmented hotspots: land use dominates at the global scale, whereas at the local scale, factor effects are highly heterogeneous, with the same variable exerting opposing influences across economic–industrial zones and GDP per capita emerging as the most widespread local control. In contrast, As contamination is governed predominantly by natural geological background, with hotspots coinciding with coal-bearing carbonate strata: soil pH leads globally, while local effects exhibit coherent zonation aligned with geological boundaries, transitioning systematically from hydroclimatic dominance in lowland karst plains to geological-basement control in mountainous regions. These findings demonstrate that resolving spatial non-stationarity is essential for understanding heavy metal drivers in karst systems and provide a scientific basis for differentiated, region-specific groundwater management.}
}
@article{LI2026136145,
title = {How emergent-constrained precipitation projections reshape watershed hydrology?},
journal = {Journal of Hydrology},
volume = {679},
pages = {136145},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136145},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012424},
author = {Yilan Li and Tongbi Tu and Xiaohong Chen},
keywords = {Climate change, Emergent constraint, GCM selection, Uncertainty, Runoff predictability, Hydrological modeling},
abstract = {Intensifying climate change is expected to substantially reshape watershed hydrology, yet large discrepancies among global climate models (GCMs)—particularly in precipitation projections—remain a major obstacle to reliable runoff forecasting. Here, using the Xijiang River Basin as a testbed, we develop and apply a novel model-selection-based emergent constraint (EC) framework to constrain CMIP6 precipitation projections and reduce inter-model spread by identifying models that exhibit physically consistent historical–future relationships. The constrained projections are then integrated into a hybrid hydrological modeling framework to evaluate how reduced precipitation uncertainty propagates through watershed processes across multiple temporal scales. The EC increases projected precipitation growth rates by 7–84% relative to the raw CMIP6 ensemble while reducing their uncertainty by 6.8–15.2%. However, the corresponding reductions in hydrological uncertainty are comparatively modest: annual and monthly runoff uncertainties decrease by only 2.8–14.2% and 4.18–16.28%, respectively, and the uncertainty range of extreme floods expands by 1.81–22.55% in most scenarios. Across emission scenarios, hydrological responses consistently show enhanced wet-season runoff, reduced dry-season flows, and intensified extreme floods, suggesting a heightened risk of drought–flood alternation under future climate conditions. These results show that the model-selection-based emergent constraint framework effectively identifies GCMs suitable for regional projections, while also revealing that substantial reductions in precipitation uncertainty do not translate proportionally into improved hydrological predictability, reflecting the nonlinear and scale-dependent propagation of climate signals through watershed processes.}
}
@article{CORREAVARELA2026136197,
title = {The seasonality of geogenic-anthropogenic interplay drives iron and manganese mobilization in groundwater},
journal = {Journal of Hydrology},
volume = {679},
pages = {136197},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136197},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012941},
author = {Sebastián Correa-Varela and Matías Taucare and Linda Daniele and Renata Martínez-Barros and Antonio Delgado and Christian Antileo},
keywords = {Trace metals, Water quality, Groundwater pollution, Redox sequence, Hydrogeochemistry, Multivariate statistical analysis},
abstract = {Iron and manganese, although abundant in the Earth’s crust, usually remain in insoluble minerals. Under specific hydrogeochemical conditions, however, their mobilization compromises water quality, becoming a public health issue. While the environmental conditions controlling Fe-Mn solubility are well documented, the combined influence of geogenic, anthropogenic, and climatic factors in shaping these conditions remains poorly constrained. This study investigates how these factors converge to regulate Fe-Mn mobilization in shallow aquifers, through a seasonal hydrogeochemical, isotopic, and statistical approach in Southern Chile. Groundwater is characterized by low salinity (58.4–1254.0 μS/cm) with a persistent HCO3–-Ca2+ facies year-round, whereas seasonal contrasts were observed in groundwater levels, Eh, NO3–, and Fe2+. Winter exhibits shallow groundwater levels, oxidizing conditions (Eh up to 505.0 mV), and increased NO3– concentrations (up to 47.77 mg/L). In contrast, summer conditions show deeper levels, predominantly negative Eh (down to −201.2 mV), and maximum Fe2+ concentrations of 12,620 μg/L. Mn2+ displays broad variability (0.22–1562.05 μg/L), with generally higher concentrations during summer. Water stable isotopes reveal δ18O-depleted trends consistent with water–rock interaction in summer, whereas no fractionation occurs in winter, reflecting direct recharge from precipitation. Multivariate statistics support silicate dissolution as the background process and redox reactions associated with the negative correlation between Eh-NO3– and Fe2+-Mn2+. Our conceptual model suggests that winter recharge introduces NO3– from agricultural soils, promoting oxidizing conditions and simultaneously introduces organic matter. As groundwater levels decline towards summer, organic matter decomposition favors the redox evolution, consuming NO3– before the sequential mobilization of Mn2+ and Fe2+ under moderately and strongly reducing conditions. These findings hint that Fe-Mn mobilization reflects the seasonal synchrony among Fe-Mn-enriched lithology, agricultural soils, and aquifer hydrodynamics, a crucial insight for groundwater quality management under increasing environmental pressures.}
}
@article{JU2026136237,
title = {Historical evaluation and future projections of soil temperature at representative sites in the Huaibei Plain, China},
journal = {Journal of Hydrology},
volume = {679},
pages = {136237},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136237},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601334X},
author = {Qin Ju and Xiaoqian Sun and Tongqing Shen and Huiyi Cai and Junliang Jin and Wenyu Xia and Yiran Lu and Di Wang and Zhuoyan Luo and Yanli Liu and Qin Wang},
keywords = {Soil temperature, CMIP6, Huaibei Plain, CNN–LSTM, Climate change},
abstract = {Soil temperature is a key state variable in terrestrial hydrological systems, and characterizing its spatiotemporal evolution is essential for understanding hydrological responses to climate change. However, deep soil temperature exhibits lagged and nonlinear responses to surface climate forcing, and long-term continuous observations are limited, complicating accurate modeling and future projection. This study proposes a depth-resolved, data-driven framework for soil temperature modeling based on 30 years (1985–2014) of in-situ observations from five stations in the Huaibei Plain, explicitly incorporating feature selection and depth-dependent lag effects into model construction. Based on this framework, multiple deep learning models (CNN, LSTM, and CNN–LSTM) are implemented and compared to simulate soil temperature at depths of 10, 40, 100, and 200 cm, and the best-performing model is selected for climate scenario projections, followed by sensitivity analysis and SHAP-based explainability to quantify the contributions of meteorological drivers. Results indicate that the hybrid CNN–LSTM model outperforms the standalone network models across all soil depths. Future soil temperature exhibits a clear warming trend, with warming rates exceeding those observed during the historical period. Near-surface layers (10 and 40 cm) show the strongest response to climate change, accompanied by greater interannual variability compared to deeper soils. Soil warming further accelerates during the mid- to late 21st century (2051–2100) and reaches its maximum under the high–radiative forcing SSP5–8.5 scenario, which is also associated with the largest inter-model uncertainty. These findings show that the proposed framework effectively characterizes depth-dependent soil temperature responses and provides depth-resolved information for future hydrological and land-surface assessments.}
}
@article{HAN2026136148,
title = {High-resolution spatiotemporal monitoring of chlorophyll-a in small inland reservoirs using multi-source remote sensing data fusion},
journal = {Journal of Hydrology},
volume = {679},
pages = {136148},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136148},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601245X},
author = {Pengfei Han and Jian Wu and Jingjing Wu and Wei Wang and Chi Zhang and Zhuohang Xin},
keywords = {Chlorophyll-a, Spatiotemporal fusion, Sentinel-2, Sentinel-3, Small reservoir},
abstract = {Small reservoirs are highly vulnerable to rapid cyanobacterial blooms, yet routine monitoring is constrained by the spatial–temporal trade-off of single-sensor satellite observations. To address this limitation, we fused Sentinel-2 MSI (10–20 m, ∼5 d) and Sentinel-3 OLCI (300 m, daily) data using the Spatial and Temporal Adaptive Reflectance Fusion Model (STARFM) to generate a Sentinel-2-like dataset (10 m, daily) for Zhuwei Reservoir during the ice-free seasons (April–November) of 2016–2024. Validation against coincident Sentinel-2 scenes showed good agreement between the fused and reference reflectance fields (RMSE < 0.015 sr-1, PSNR > 37 dB, SSIM > 0.8). After excluding oligotrophic and severe-bloom samples that were not used for quantitative retrieval, the remaining 93 paired samples collected during ten field campaigns in 2023–2024 were used to compare several established Chlorophyll-a (Chl-a) retrieval algorithms. The Normalized Difference Chlorophyll Index (NDCI) showed the best performance and was therefore selected as the most suitable algorithm for moderate-bloom conditions (R2 = 0.72, RRMSE = 26.2%, and MAE = 11.89 μg/L). Application of the selected model to the fused record revealed a weak overall decline in reservoir-mean Chl-a (−0.313 μg/L/yr), pronounced summer maxima, and persistent hotspots in the northwestern, northern, and northeastern sectors. These results demonstrate the practical value of combining spatiotemporal fusion with locally evaluated Chl-a retrieval for gap-reduced monitoring of bloom dynamics in small reservoirs.}
}
@article{SALARKHORASANI2026136137,
title = {Forensic hydrological assessment of flood response under land use/land cover (LULC) change using ANN and HEC–HMS},
journal = {Journal of Hydrology},
volume = {679},
pages = {136137},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136137},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012345},
author = {Seyed-Mahdi Salar-Khorasani and Omid Bozorg-Haddad and Hugo A. Loaiciga},
keywords = {Forensic hydrology, Flood risk assessment, Land use change, Artificial Neural Networks (ANN), Hydrological modeling},
abstract = {This study develops an integrative methodological framework that combines forensic hydrology, artificial neural networks (ANNs), and physically-based hydrological modeling to assess the cascading impacts of projected land use/land cover (LULC) changes on future flood dynamics in the upstream watershed of Golestan Dam, Iran. A large-magnitude flood event analogous to the destructive 2019 flood was simulated under evolving LULC scenarios for three future horizons: 2030, 2040, and 2050. The curve number (CN) and lag time (Tlag) were reconstructed using linear and nonlinear interpolation and projected with ANN-based regression modeling. Mann-Kendall trend analysis was applied to assess the temporal consistency of ANN-predicted CN and Tlag series and support the selection of the most reliable synthetic datasets. The simulations revealed highly non-linear growth in peak discharges, with the Qarah Shur sub-basin projected to experience a 163.78% increase in flood intensity by 2050, resulting from a substantial increase in the contribution of barren land to flood intensification (from 22.89% to 78.88%) and a threefold increase in the contribution of sparse vegetation (from 9.04% to 31.13%). These two factors, individually and in combination, were identified as the most critical contributors to flood amplification in this sub-basin. The Galikesh sub-basin followed with a 68.99% increase by 2050, being the only sub-basin where the contribution of road expansion (from 8.88% to 27.41%) emerged as the dominant factor driving flood intensification. The Tamar Gorgan and Tangerah sub-basins demonstrated more moderate increases in discharge, 13.89% and 10.44%, respectively, driven by modest land degradation and road building. This work’s findings underscore growing risks to infrastructure, including embankment instability, bridge scour, and urban inundation, and to groundwater recharge, aquatic ecosystems, and water quality through the mobilization of pollutants and sediments under increasing flood risk. The spatial comparison of sub-basin-level responses captures the heterogeneity of flood vulnerability and the urgency of instituting adaptive land use policies grounded in hydrological sensitivity, riparian corridor protection, and nature-based flood mitigation.}
}
@article{MA2026136161,
title = {Natural and anthropogenic hydrodynamics shape selenium fate and risk in a sediment-laden river},
journal = {Journal of Hydrology},
volume = {679},
pages = {136161},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136161},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012588},
author = {Haotian Ma and Yidi Wang and Liang Shen and Hongbo Wang and Xavier Supe Tulcan and Ping Wang},
keywords = {Selenium, Suspendedparticulate matter, Hydrodynamic conditions, Anthropogenicregulation, Ecological and human health risks, Yellow River},
abstract = {Selenium (Se) dynamics in sediment-rich rivers are shaped by both natural hydrodynamics and anthropogenic regulation, but the mechanisms controlling its distribution among dissolved, suspended particulate, and sedimentary phases remain poorly understood. This study investigated the spatiotemporal patterns, controlling factors, and ecological and human health risks of Se in the Yellow River. Results showed that dissolved and sedimentary Se concentrations were consistently higher in autumn (dissolved mean: 1.14 μg/L; sedimentary mean: 0.30 mg/kg) than in spring (mean: 0.65 μg/L and 0.23 mg/kg, respectively), while suspended particulate matter (SPM)-Se exhibited an opposite seasonal trend, peaking in spring (mean: 0.50 mg/kg) compared to autumn (mean: 0.31 mg/kg). Spatial multivariate analyses revealed significant differences in Se distribution among different media, characterized by strong spatial heterogeneity in dissolved Se and comparatively homogenized patterns in particulate and sedimentary phases. Partitioning and driver identification analyses indicated that dissolved-particulate Se distribution was predominantly controlled by hydrodynamic conditions and suspended sediment variability. Partial Least Squares Structural Equation Modeling (PLS-based SEM) further confirmed that hydrological conditions, anthropogenic factors, and nutrients jointly influenced Se redistribution, and highlighted the role of SPM as a transitional carrier between dissolved and sedimentary phases. While the basin-wide ecological and human health risks remained generally low, a seasonal shift in moderate ecological risk from the plateau headwaters in spring to the middle-lower reaches in autumn was observed. These findings underscore the necessity of incorporating hydrological dynamics and anthropogenic regulation into the risk management of hazardous trace elements in regulated river systems.}
}
