url = {https://www.sciencedirect.com/science/article/pii/S0022169426012758},
author = {Quanshan Liu and Ningbo Cui and Shunsheng Zheng and Daozhi Gong and Zhihui Wang and Fei Chen},
keywords = {Soil moisture dynamics, Vertical propagation, Persistence, Soil moisture-temperature coupling, Environmental controls, Shandian River Basin},
abstract = {Understanding how soil moisture (SM) varies with depth is important for characterizing profile-scale water movement and storage behavior. However, the vertical propagation, persistence, and soil moisture–temperature (SM–ST) coupling of profile SM remain insufficiently quantified. Using multi-site observations at five depths (3, 5, 10, 20, and 50 cm) in the Shandian River Basin of northern China during the non-frozen periods from 2019 to 2022, this study quantified the temporal dynamics, vertical propagation, persistence, SM–ST coupling, and environmental controls of SM. Results showed a clear shift from a highly variable shallow layer to a delayed and persistent deep-soil regime. SM persistence increased by 164 % from 14 d at 3 cm to 37 d at 50 cm, accompanied by stronger spatial heterogeneity at depth. Vertical coupling between adjacent layers weakened downward by 18 %, with the median maximum correlation decreasing from 0.93 in the shallow intervals (3–5 and 5–10 cm) to 0.76 in the 20–50 cm interval, while the corresponding median lag increased from 0 to 5 d. For SM–ST coupling, shallow soil showed weak evaporation-related decoupling, whereas deeper soil showed positive hydrothermal co-variation; the median lag remained near zero but became spatially more constrained with depth. Environmental controls were predominantly nonlinear: clay content was more closely associated with deep-layer lag and persistence, whereas elevation showed a stronger influence on deep SM–ST coupling. These findings provide profile-scale observational evidence for representing depth-dependent soil moisture memory, vertical transmission, and SM–ST coupling in hydrological and land-surface studies.}
}
@article{SWIATEK2026136212,
title = {Hydrogeochemical response of Fe-enriched saturated soils to controlled mechanical disturbance},
journal = {Journal of Hydrology},
volume = {679},
pages = {136212},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136212},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013090},
author = {Szymon Świątek and Konrad Proczek and Karolina Lewińska},
keywords = {Soil, Redox, Iron, Water mineralization, Goethite, Liquefaction, Soft-sediment deformation structures},
abstract = {Earthquakes and mechanical disturbances can modify groundwater and soil geochemistry by altering redox conditions, fluid redistribution, and mineral–water interactions. However, the coupled physicochemical mechanisms controlling these changes remain insufficiently understood, particularly in Fe-rich saturated systems. This study investigates the hydrogeochemical response of saturated soil–water columns subjected to controlled low-amplitude mechanical disturbance under varying water mineralization and contrasting iron amendments: a reactive Fe(II)-rich system represented by ferrous sulfate (FeSO4) and a comparatively stable Fe(III)-oxyhydroxide system represented by goethite (FeOOH). Over a 12-month incubation experiment, changes in pH, redox potential (Eh), and dissolved Fe, Mn, and Al concentrations were monitored before and after vibration treatment. The strongest physicochemical response occurred in FeSO4-amended systems, where initially acidic conditions (pH < 3.1) evolved toward progressive stabilization during incubation. Mechanical disturbance induced rapid but temporary increases in pH, accompanied by pronounced decreases in Eh and transient peaks in dissolved Fe and Mn concentrations, particularly in low- and medium-mineralized waters. In contrast, FeOOH-amended systems displayed comparatively stable pH–Eh conditions and weaker metal mobilization. The experiment also produced liquefaction-related soft-sediment deformation features, including injection structures, disturbed lamination, Fe-rich bands, and nodular accumulations. The observed pH–Eh evolution is interpreted as the result of coupled physical–geochemical processes involving pore-water redistribution, microscale redox mixing, Fe2+ oxidation, oxygen consumption, Fe(III)-oxyhydroxide precipitation, CO2 degassing, and buffering reactions. Although the experiment represents a controlled laboratory model rather than a direct field-scale earthquake analogue, the observed hydrogeochemical trends are consistent with transient pH–Eh anomalies and Fe–Mn mobilization reported from natural post-seismic groundwater systems. The study provides a process-oriented framework for understanding how mechanically disturbed Fe-rich saturated environments may respond to changing redox conditions and repeated physical perturbation.}
}
@article{PANIQUECASSO2026136150,
title = {Human pressures exacerbate the impacts of hydroclimatic extremes on river greenhouse gas emissions},
journal = {Journal of Hydrology},
volume = {679},
pages = {136150},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136150},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012473},
author = {Diego G. Panique-Casso and Peter Goethals and Long Ho},
keywords = {River greenhouse gases, Water quality, Drought, Floods, Climate extremes, Human impacts},
abstract = {The natural release of greenhouse gas (GHG) from rivers is intensified by the deterioration in water quality caused by the combined effects of hydroclimatic extremes (droughts, heatwaves, rainstorms, and floods), and human activities (agriculture, urbanization). Yet, current models largely overlook these interactions, representing a critical gap in GHG inventories. To elucidate the general responses of water quality parameters and GHG fluxes to hydroclimatic events, this work combined global datasets on river water quality and streamflow, with measured GHG fluxes across four continents. By integrating random forest models and SHAP values, we identified the intricate interplay between climatic, land-use, geomorphic, water quality and riverine GHG fluxes during hydroclimatic extreme events. Our models showed that during drought-heatwave events, CH4 emissions from the rivers can increase by 18% on average likely because of intense urban pollution. In particular, reduced slopes from channel modifications were associated with disrupted river connectivity, pollutant accumulation, and emission hotspots. During rainstorm-floods, CO2 and N2O fluxes can rise by 6% in downstream rivers, where enhanced hydrological connectivity to pollution sources, including agricultural fields and wastewater overflows, was associated with higher pollution loads and turbidity, and elevated GHG emissions. These findings are highly relevant under future climate scenarios, where more frequent and prolonged hydroclimatic extremes could further elevate riverine GHG emissions.}
}
@article{XUE2026136202,
title = {Overlooked pathogenic dissemination and water security risks driven by hydrophobic lipid-like DOM under routine rainfall},
journal = {Journal of Hydrology},
volume = {679},
pages = {136202},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136202},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012990},
author = {Wenqi Xue and Chongjun Zhang and Han Cui and Chaofan Zhang and Dandan Zhou},
keywords = {Aquatic ecosystem security, Molecular-level analysis, Climate change, Allochthonous terrestrial inputs, FT-ICR-MS},
abstract = {Reports of water pathogen dissemination outbreaks following routine rainfall without apparent water quality deterioration are increasingly documented, yet the underlying causes remain poorly understood. Dissolved organic matter (DOM) links human activities to urban surface waters, with its molecular profiles serving as a key to deciphering the routine rainfall-driven pathogenic mechanism. This study analyzed urban surface waters shaped by distinct land uses, tracking rainfall induced shifts in pathogens, virulence factor genes (VFGs), mobile genetic elements (MGEs), and DOM-mediated pathogenic risks. Rainfall was associated with a 4.4% (Cohen’s d = 0.22) increase in VFGs and an 17.5% (Cohen’s d = 0.28) increase in MGEs. This shift coincided with a 183% surge in the connectivity of the Pathogen-VFGs-MGEs co-occurrence network and a marked shift in VFG subtypes toward invasion-related functions, collectively suggesting the enhanced virulence potential. Variance partitioning analysis confirmed DOM composition as the largest independent contributor, explaining 21.7% of the total variation. The catering/entertainment area (S2) exhibited the strongest response, generating 40% more newly emerged DOM, with 37% of post-rainfall DOM matching terrestrial signatures. Low molecular weight, highly hydrophobic, and saturated lipid-like DOM emerged as a notable correlate of elevated pathogenic risks following routine rainfall in urban surface waters. Our findings suggest that lipid-like DOM derived from anthropogenically altered terrestrial sources, notably catering and tourism, is a key correlate of elevated pathogenic risks in urban surface waters during routine rainfall. Under climate change, incorporating DOM molecular signatures into routine monitoring systems may improve the risks assessment for aquatic ecosystem security.}
}
@article{VANDEWEGHE2026136009,
title = {Advancing seasonal water supply forecasting for lakes and reservoirs using copulas},
journal = {Journal of Hydrology},
volume = {679},
pages = {136009},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136009},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011066},
author = {Alexander VanDeWeghe and Andrew D. Gronewold},
keywords = {Copula, Water supply forecasting, Stochastic hydrology},
abstract = {The future of water storage dynamics in lakes around the world is increasingly uncertain due to a changing climate and evolving anthropogenic demands. Now, more than ever, it is necessary to quantify the uncertainty in forecasts of future water supply and water levels. However, classical ensemble forecasting systems that rely on weighted repetitions of historical water flux sequences, or independently resampled then post-processed sequences, often fail to capture either the dependence between hydrological variables across space and time or the full range of plausible outcomes for these variables. In this paper, an alternative statistical approach is outlined for using high-dimensional distributions described by copulas to generate water supply ensembles which preserve the correlation structure among hydrological variables. This new approach is outlined in detail to support dispersed operational modeling efforts, demonstrated by one implementation of a copula-based model for seasonal to annual forecasting on the Laurentian Great Lakes. This model implementation performs similar to or better than current operational forecasts while extending the forecast horizon from 6 to 12 months.}
}
@article{QU2026136142,
title = {Increasingly diverse allochthonous input promote recalcitrance and homogenization of dissolved organic matter along the land-sea continuum},
journal = {Journal of Hydrology},
volume = {679},
pages = {136142},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136142},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012394},
author = {Liyin Qu and Mingxing Ren and Dezhong Wang and Ting Wang and Randy A. Dahlgren and Shengyao Sun and Jixin Chen and Xuwen Fang and Penghui Li and Weidong Guo},
keywords = {Dissolved organic matter, Allochthonous carbon, Land-sea continuum, Carbon transformation, FT-ICR MS},
abstract = {Estuaries are receiving increasingly diverse allochthonous dissolved organic matter (DOM) with variable reactivities as global change intensifies, yet the ultimate fate of this mixed-source DOM along the dynamic land-sea interface remains poorly constrained. Herein, we investigated spatiotemporal variability in DOM molecular composition along the Zhangjiang river-estuary-bay continuum, characterizing eight anthropogenic and wetland DOM endmembers. Dissolved organic carbon (DOC) and DOM chemodiversity increased along the continuum and peaked in the upper estuary across all hydrological periods. DOC addition from urban sewage, aquaculture effluent and mangrove creek runoff was comparable to riverine DOC input during the intermediate and dry seasons, whereas submarine groundwater discharge only contributed to elevated DOM chemodiversity. A thermodynamically-related biotransformation model further revealed that allochthonous aliphatics were stepwise transformed into recalcitrant islands of stability (IOS) molecules during seaward transport through successive dehydrogenation, denitrogenation and oxidation, with reactions shifting from thermodynamically favorable to increasingly constrained conditions. Nonetheless, over 70% of in situ produced RDOM molecules showed net removal along the estuary via adsorption/flocculation and sedimentation, potentially contributing to estuarine carbon burial. Ultimately, 26–56% of DOM molecules from different endmembers were removed during export, highlighting the estuary as a hotspot of carbon transformation and burial through efficient processing of diverse allochthonous DOM. These processes ultimately promoted homogenization of estuarine DOM pools. These findings provide mechanistic insights for predicting/constraining the carbon budgets of estuaries under ongoing environmental change.}
}
@article{GAUTAM2026136215,
title = {Is every flood rough on built environment? Flood fragility and vulnerability modeling for residential buildings},
journal = {Journal of Hydrology},
volume = {679},
pages = {136215},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136215},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013120},
author = {Suraj Gautam and Vivek Dumre and Pooja Lamichhane and Alok Dahal and Sanjay Kumar Sah and Binod Parajuli and Sneha Bhatta and Nitesh Sharma and Aakash Khanal and Biddhya Bhandari and Shudarshan Hamal and Dinesh Gurung and Shraddha Acharya and Sanjaya Devkota and Basanta Raj Adhikari and Dipendra Gautam},
keywords = {Flood fragility, Flood vulnerability, RC, Masonry, Wattle and daub, Hybrid construction, Uncertainty},
abstract = {Flood is one of the most frequent natural hazards, which often causes fatalities, injuries, physical damage to the built environment, and economic consequences. Although widely recognized as a frequent natural hazard/disaster, damage quantification models are sparsely reported in the literature, and most of those models consider well-known structural systems only. To quantify physical damage to buildings, plan flood-resilient housing construction, conduct risk/loss assessments, deploy insurance systems, and formulate evacuation and relocation programs, flood fragility/vulnerability models are instrumental at both local and regional scales. However, challenges persist in obtaining reliable data to construct high-fidelity models. To address this, the present paper develops high-fidelity fragility models for reinforced concrete (RC), wattle and daub, masonry, and hybrid construction systems using one of the largest actual damage survey datasets. Uncertainties are also quantified for each fragility/vulnerability model. We propose a new damage state definition framework that captures contents, nonstructural components (NSCs), structural components, and global damage in residential buildings. Equivalent damage ratios are also proposed for each damage state. The results highlight that the wattle and daub system is the most vulnerable construction system under flooding. In addition, functionality loss cannot be ruled out even in robust construction systems such as RC. Comparison between the proposed and existing models from other basins highlights that scalability and generalizability considerations are instrumental in adopting flood fragility/vulnerability models.}
}
@article{LI2026136126,
title = {Predominant vegetation control on baseflow index variations across China’s climatic basins},
journal = {Journal of Hydrology},
volume = {679},
pages = {136126},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136126},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012230},
author = {Yanzhong Li and Kaiwen Wang and Xiaomang Liu and Huan Wu and Xiaojun Guo},
keywords = {Baseflow separation method, Baseflow index, Different climatic basins, Vegetation greening, Dominant driving factors},
abstract = {Baseflow refers to the subsurface runoff component sustained solely by groundwater, expressed in units of mm or m3 s⁻1. The baseflow index (BFI), by contrast, is a dimensionless metric calculated as the ratio of baseflow to total streamflow, which is vital for evaluating ecosystem health and planning irrigation demands. To date, the long-term spatiotemporal dynamics and driving mechanisms of BFI (baseflow proportion) across China’s climatic basins remain poorly understood. Here, we conduct a novel systematic assessment of 12 baseflow separation methods (zero-, one-, and two-parameter) along a complete climatic gradient (humid-transition-arid) in China, and identify the most robust approaches for multi-climatic applications. We then investigate the spatiotemporal dynamics of the BFI in 17 typical watersheds across diverse climatic regions from 1982 to 2020, and provide quantitative evidence of the impacts of vegetation greening on BFI variability. Our results demonstrate that the two-parameter digital filter methods, including Boughton, Furey, Eckhardt, and Willems, perform optimally with the highest Kling-Gupta Efficiency (KGE) values. The multi-year mean BFI across all watersheds is 0.55 ± 0.10, with higher values observed in arid watersheds (0.60 ± 0.10) than in humid watersheds (0.52 ± 0.08). A significant increasing trend (p < 0.05) in BFI is detected in 8 of the 17 watersheds, with this upward trend being particularly pronounced in arid and transitional basins. Quantitative attribution analysis reveals that vegetation greening (Leaf Area Index, LAI) acts as the statistically dominant driver, explaining 54.4% of BFI variations-far exceeding the contributions of precipitation, potential evapotranspiration, aridity index, and precipitation seasonality. Our findings provide robust evidence that large-scale vegetation restoration has profoundly altered baseflow generation processes and streamflow partitioning across China’s climatic gradient.}
}
@article{PORCINO2026136239,
title = {Antarctic lakes: a systematic review and meta-analysis of major ions chemistry across the continent},
journal = {Journal of Hydrology},
volume = {679},
pages = {136239},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136239},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013363},
author = {Nunziatina Porcino},
keywords = {Antarctica, Lakes, Geochemistry},
abstract = {Antarctic lakes represent highly sensitive recorders of polar environmental shifts. However, evaluating continent-scale geochemical baselines has been historically impeded by fragmented, localized data (Heywood, 1972). This study presents a comprehensive synthesis of major ion chemistry from 4,457 water samples across 83 peer-reviewed publications to establish a unified hydrochemical framework. Major ion concentrations were harmonized and analyzed using compositional ratios and multivariate approaches to isolate dominant solute sources and geochemical control mechanisms. Across the continent, a dominant sodium-chloride signature emerges in coastal zones, with sodium-chloride molar ratios closely tracking seawater values (0.86), demonstrating a pervasive marine aerosol imprint. Conversely, inland isolated basins, particularly within the Continental Inland Ice-Free Valleys, exhibit profound geochemical modifications driven by the interplay of cryogenic concentration, intense sublimation, and localized rock-water interactions. Calcium-rich brines indicate advanced freeze-concentration cycles or localized carbonate leaching. By integrating these disparate datasets into a harmonized framework, this study clarifies the regional organization of Antarctic limnological systems and provides a crucial quantitative baseline for tracking future climate-driven variations in hydrologic fluxes, ice-free area expansions, and localized anthropogenic footprints.}
}
@article{LOTZ2026136207,
title = {Selective transferability mapping for cross-basin prediction of river electrical conductivity},
journal = {Journal of Hydrology},
volume = {679},
pages = {136207},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136207},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013041},
author = {Tom Lotz and Wenjun Chen and Thomas Hennig and Shoubao Su},
keywords = {Electrical conductivity, Ungauged basins, Catchment similarity, Data-driven water quality modeling, Random forest, Machine learning},
abstract = {Electrical conductivity (EC) is an important water-quality indicator, but measurements are unavailable for many rivers. Cross-basin prediction is difficult because models often assume that relationships learned in one basin remain valid elsewhere without evaluating hydrological similarity or failure risk. This study introduces Selective Transferability Mapping (STM), a suitability-guided framework that uses catchment similarity to evaluate whether model transfer is supported. Using 578 USGS stations, pairwise Random Forest models quantified transferability for four flow-conditioned EC statistics (mean, median, minimum, and maximum), and a classifier linked transfer success to differences in catchment and runoff characteristics. Twenty repeated holdouts excluded 100 target basins from all training steps. Under observed-flow conditions, STM achieved the highest mean R2 for mean, median, and minimum EC when compared with controls, but not for maximum EC. Under predicted-flow conditions, target-basin streamflow was withheld, and flow-duration curves were estimated from catchment attributes and modeled runoff characteristics. STM outperformed all comparison approaches, including methods based on catchment similarity and pooled donor data, for all four statistics on targets with sufficient donor support. STM also produced fewer negative and severe failures than models trained using all available donors. STM donor support also identified basins less prone to severe errors, providing reliability information that could inform other prediction approaches. Spatial-residual and stability analyses further characterized prediction reliability across locations and flow conditions. Overall, STM balances predictive reliability against spatial coverage by selecting donors in a transparent and hydrologically interpretable manner and withholding predictions for target basins with insufficient donor support.}
}
@article{LI2026136170,
title = {A spectral-constrained HVCE framework for adaptive optical-SAR fusion to enhance soil moisture retrieval},
journal = {Journal of Hydrology},
volume = {679},
pages = {136170},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136170},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012679},
author = {Yijie Li and Yifei Yao and Shikun Sun and Enhao Wang and Rong Liu and Jiale Ma and Pute Wu},
keywords = {Data fusion, Optical-SAR fusion, Eco-hydrological parameters, Soil moisture retrieval, Spatial-spectral fidelity},
abstract = {Soil moisture (SM) is a variable governing terrestrial water and energy cycles, with critical implications for agriculture, hydrology, and climate extremes. The fusion of Sentinel-1 SAR and Sentinel-2 optical data holds promise for constructing fine-scale SM-relevant representations by combining complementary spectral and scattering information, yet existing methods face a fundamental trade-off: pixel-level fusion prioritizes visual fidelity at the cost of spectral fidelity and quantitative retrieval relevance, while feature-/decision-level fusion often sacrifices pixel-level spatial-spectral details. A prior-free adaptive fusion framework that preserves pixel-level spatial-spectral fidelity while enhancing retrieval-relevant information is therefore needed. To address this issue, this study proposes a spectral-constrained Helmert variance component estimation (HVCE) adaptive fusion framework. This framework enables prior-free, adaptive fusion of optical-SAR imagery without requiring prior statistical error information, by constructing an HVCE error equation through the introduction of spectral index constraints, thereby synergistically preserving spatial-spectral fidelity with task-oriented information enhancement. Within this framework, we developed two advanced models: H-SVD and H-DWT, based on enhanced Multi-Resolution Singular Value Decomposition (SVD) and Discrete Wavelet Transform (DWT). The framework was validated across three large-scale heterogeneous areas (alpine meadow QLB-NET, China; woodland-grassland TXSON, USA; farmland GROW, Hungary) and two small-scale irrigation districts (Shaanxi, China). Results show the framework outperforms conventional benchmark fusion methods (Gram-Schmidt; PCA; Hybrid-MSD; SVD; DWT; Entropy-Optimized SVD and DWT models, E-SVD and E-DWT). Crucially, H-SVD and H-DWT increased the average correlation between fused data and in-situ SM by 59% and 50%. Machine learning models (SVM, ELM, XGBOOST) trained on fused data achieved an average improvement of 26.3% in R2 and an 11.8% reduction in nRMSE for SM retrieval. The framework also showed stable performance across vegetation types and phenological stages, and was extended to improve retrieval of leaf area index (LAI) and leaf water content (LWC). This study establishes a physically constrained, transferable, and task-adaptive paradigm for pixel-level remote sensing data fusion, providing a robust technical pathway for the synergistic retrieval of SM and key eco-hydrological parameters using multi-source remote sensing data.}
}
@article{QIU2026136154,
title = {Tidal hydrology drives the spatial distribution of aphids and their herbivorous effects on the Suaeda salsa seeds in the saltmarshes of the Yellow River Delta},
journal = {Journal of Hydrology},
volume = {679},
pages = {136154},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136154},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012515},
author = {Dongdong Qiu and Yanpeng Zhu and Zhichao Xu and Baoshan Cui},
keywords = {Aphids, Herbivorous effects, Saltmarsh, Seed germination, , Tidal hydrology},
abstract = {Tidal hydrological intensity and connectivity affect the community structure and processes in many coastal ecosystems. However, reports of how tidal hydrology drives the spatial distribution of aphids and their herbivorous effects on saltmarsh plants in saltmarshes are lacking. We therefore conducted field investigations and field manipulation experiment to study the associations between tidal hydrology, aphids and the native key plants Suaeda salsa along land-sea gradient in the saltmarshes of the Yellow River Delta, China. The results of two investigations demonstrated that the extent of aphid infestation on S. salsa plants (including the aphid egg density per individual S. salsa plant and the aphid egg density per unit dry biomass of S. salsa) gradually lessened along land-sea gradient. The potential germination rate of S. salsa seeds, tidal erosion rate and soil moisture content progressively increased along the land-sea gradient. The extent of aphid infestation on S. salsa plants exhibited negative correlations with soil moisture content and tidal erosion rate, while the potential germination rate of S. salsa seeds showed positive correlations with those. The potential germination rate of S. salsa seeds was negatively correlated with the extent of aphid infestation on S. salsa plants. The results of manipulation experiment showed that the extent of aphid infestation on S. salsa plants was significantly higher in both the procedural control and aphids present treatments than in the aphids absent treatment. The potential germination rate of S. salsa seeds was significantly lower in both the procedural control and aphids present treatments than in the aphids absent treatment. Thus, the results demonstrated that the herbivory of aphids damaged the S. salsa seeds, and the stronger tidal hydrology could reduce seed damage by suppressing aphid infestation. This study provides empirical evidence supporting hydrological management as a strategy to enhance saltmarsh ecosystem resilience and promote vegetation restoration.}
}
@article{YIN2026136174,
title = {Nonlinear flow behaviors through rough fractures in shale: Effects of fracture roughness and stress-induced closed-region evolution},
journal = {Journal of Hydrology},
volume = {679},
pages = {136174},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136174},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012710},
author = {Hao Yin and Yan-Hua Huang and Sheng-Qi Yang and Huan Sun and Zhen-Ni Ye and Shuang-Mei Wang and Jing-Hua Qi and Shi-Ao Wang},
keywords = {Shale fracture, Nonlinear flow, Stress-induced closure, Closed-region ratio, Flow localization, Forchheimer resistance},
abstract = {Nonlinear flow through rough shale fractures is governed by the coupled effects of stress-induced closure, geometric heterogeneity, and fluid inertia. In this study, CO2 seepage experiments, three-dimensional fracture reconstruction, and COMSOL simulations were combined to quantify these effects. The experiments showed that the standard-state outlet flow rate increased with injection pressure, whereas the apparent gas-flow index decreased with injection pressure, indicating progressive deviation from the linear squared-pressure response. The index also decreased with increasing confining pressure, reflecting stress-induced degradation of gas-flow capacity. Calibrated equivalent-aperture single-fracture core models reproduced the measured pressure-flow trends, with mean absolute percentage errors of 7.88%, 8.00%, and 20.87% for the three samples, respectively. The models also showed a rapid initial decline followed by a more gradual decrease in equivalent fracture permeability with increasing confining pressure. Dual-walled rough-fracture models further revealed that stress-induced closure increased the closed-region ratio, partitioned the connected flow domain, and localized flow within constricted channels. In the dual-walled water-flow model of Sample 3#, the fitted nonlinear coefficient increased by more than two orders of magnitude when the closed-region ratio reached 15.1%, relative to the 0 MPa open-fracture baseline. The resulting flow localization intensified pressure-field partitioning, velocity gradients, vorticity concentration, and viscous dissipation, thereby enhancing nonlinear resistance. These results establish a quantitative link between closed-region growth, flow localization, energy dissipation, and Forchheimer-type resistance. Water-flow simulations under the same fracture geometry were used to isolate the effects of fracture closure and fluid inertia on nonlinear resistance.}
}
@article{LIU2026136146,
title = {HydEquivNet: bridging classical unit hydrograph theory and data-driven hydrology via scale-equivariant learning},
journal = {Journal of Hydrology},
volume = {679},
pages = {136146},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136146},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012436},
author = {Jingzhe Liu and Chenhui Jiang and Yongnan Zhu and Shan Jiang and Ziqian Gong and Jiaqi Zhai and Jing Zhao and Yulong Gao and Tao Wang},
keywords = {Runoff simulation, Lie group equivariant network, Unit hydrograph theory, Physical consistency, Interpretability},
abstract = {Traditional data-driven Deep Learning (DL) hydrological models often suffer from poor physical consistency and weak extrapolation robustness. To address this, we propose HydEquivNet (HEN), a novel architecture that introduces Lie group equivariance into hydrological modeling. By employing steerable Hermite basis convolutions, HEN embeds scale-equivariant physical priors into feature extraction, drawing on classical unit hydrograph theory and mass-consistency considerations to form learnable routing priors. The model utilizes a hybrid structure, integrating equivariant layers for physical feature extraction with Long Short-Term Memory (LSTM) networks for nonlinear residual compensation. Extensive validation on 531 Catchment Attributes and Meteorology for Large-sample Studies (CAMELS) catchments shows that HEN achieves a median Nash-Sutcliffe Efficiency (NSE) of 0.724 and avoids negative NSE values in the evaluated catchments. Controlled precipitation-scaling experiments further indicate improved equivariance-guided proportional-response robustness under synthetic out-of-distribution input amplification. Furthermore, model-derived routing diagnostics show interpretable unit-hydrograph-like response patterns, including a 0.94 bin-averaged correlation between extracted Peak Lag Time (Tp) and a physically motivated concentration–time factor (CTF). HEN thus offers a parameter-efficient and transparent route toward more physically informed rainfall-runoff modeling under changing hydroclimatic conditions.}
}
@article{SINGH2026136198,
title = {Pore-scale sedimentary architecture controls the emergence and constitutive scaling of asymptotic hydrodynamic dispersion},
journal = {Journal of Hydrology},
volume = {679},
pages = {136198},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136198},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012953},
author = {Kuldeep Singh and Alexander Miller and Lichun Wang},
keywords = {Asymptotic dispersion, Dispersivity, non-Fickian to Fickian transport, Advection-dispersion equation, Péclet number scaling, Pore-scale heterogeneity},
abstract = {This study demonstrates that the magnitude and spatial organization of pore-scale heterogeneity jointly govern the emergence of asymptotic hydrodynamic dispersion in porous media. Two-dimensional digitally constructed pore networks representing graded, laminated, and random sedimentary architectures were generated with systematically varied heterogeneity index σg. Flow and solute transport simulations were performed over longitudinal domains exceeding 20 cm across multiple Péclet numbers to quantify the evolution from pre-asymptotic to asymptotic transport behavior. Results show that spatial architectural organization—rather than the magnitude of heterogeneity alone—exerts a first-order control on emergent continuum-transport behavior. Bulk velocity variance remained comparatively insensitive to σg, yet the asymptotic hydrodynamic dispersion coefficient and accompanying longitudinal dispersivity varied by orders of magnitude following the hierarchy laminated > graded > random, reflecting how spatially coherent velocity segregation imposed by sedimentary architecture governs emergent continuum-transport behavior. In the graded and laminated architectures, both transport metrics increased exponentially with σg, while the laminated architecture additionally exhibited power-law relationships with the permeability contrast between coarse and fine sediment layers, defining architecture-specific constitutive relationships absent in random architectures. The transition length to asymptotic Fickian transport depended on both sedimentary architecture and σg, exhibiting only a weak dependence on the Péclet number in the laminated and graded domains. In contrast, the relative increase from early-time to asymptotic dispersion showed no systematic Péclet number dependence, indicating primary structural control. Once asymptotic conditions were reached, longitudinal dispersivity became independent of the Péclet number, consistent with classical hydrodynamic dispersion theory. Asymptotic dispersivity values reproduced both the magnitude and vertical scatter of compiled field dispersivity–length datasets, supporting the interpretation that much of the observed field-scale variability at a given length likely reflects the impact of geological architectural heterogeneity rather than measurement uncertainty.}
}
@article{DING2026136114,
title = {Long-term increases in tree water-use efficiency across China are associated with CO2 and hydroclimatic variation},
journal = {Journal of Hydrology},
volume = {679},
pages = {136114},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136114},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012114},
author = {Yali Ding and Li Wen and Jingzhi Zhang and Wei Zhang and Hongsong Chen and Shanshan Song and Zongrui Lai and Jinxing Zhou and Guanghui Lin},
keywords = {Tree physiology, Water-use efficiency, Tree ring, CO deviation, GAMM},
abstract = {Rising atmospheric CO2 and hydroclimatic variability jointly shape forest carbon–water relations, with important implications for carbon sequestration, drought resilience, and water resources. However, their interactive effects on long-term intrinsic tree water-use efficiency (iWUE) remain difficult to quantify because atmospheric CO2 and calendar year are highly collinear over centennial timescales. Using a nationwide tree-ring δ13C dataset spanning the twentieth century across China’s major biogeographic zones, we examined long-term iWUE trajectories and tested whether non-trend CO2 deviations were associated with iWUE after accounting for zone-specific temporal trends and hydroclimatic variation. To address collinearity between CO2 and time, we decomposed atmospheric CO2 into a long-term trend and residual deviations (CO2_resid) and incorporated these into generalized additive mixed models (GAMMs) with zone-specific year smooths, tree-level random effects, and AR(1) temporal correlation. Model comparisons based on AIC, concurvity diagnostics, and blocked cross-validation showed that raw CO2 models achieved the lowest AIC but suffered severe concurvity with year, limiting attribution of long-term iWUE trends. In contrast, the CO2_resid parameterization markedly reduced concurvity while maintaining comparable predictive performance, allowing more stable inference about non-trend CO2 associations. Across all biogeographic zones, iWUE increased markedly over the twentieth century. The residualized CO2 model showed that positive non-trend CO2 deviations were associated with higher iWUE under lower annual precipitation contexts, had weak effects under intermediate precipitation, and were attenuated or slightly reversed under the highest annual precipitation contexts. Temperature exerted weaker moderating effects. Because CO2_resid represents departures from the long-term CO2 trajectory, these results should not be interpreted as a direct estimate of the contribution of rising CO2 to the centennial iWUE increase. Rather, they show that CO2-related iWUE responses are strongly hydroclimate-dependent. This study provides a statistical framework for separating long-term temporal trends from short-term CO2 variability and highlights the importance of moisture context when predicting forest carbon–water coupling under environmental change.}
}
@article{WANG2026136206,
title = {Unveiling the propagation and driving mechanisms of socioeconomic drought in the Aral Sea Basin: A vine copula and system dynamics ensemble simulation framework},
journal = {Journal of Hydrology},
volume = {679},
pages = {136206},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136206},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601303X},
author = {H. Wang and Y.P. Li and G.H. Huang and Y. Ma and Q. Zhang and P.P. Wang},
keywords = {Aral Sea Basin, Socioeconomic drought, Drought propagation, Vine copula, System dynamics, Driving mechanism},
abstract = {The propagation from meteorological drought (MD) to hydrological drought (HD) and ultimately to socioeconomic drought (SOCD) is a highly complex, nonlinear, and multi-dimensional process; however, the existing approaches often fail to capture the complicated cross-system interrelationships and are unable to quantify the mutual influence between human activities and climate change. This study develops a novel A vine copula and System Dynamics ensemble simulation framework (VCSD-ESF) that first integrates multi-dimensional vine copula, system dynamics (SD), and Soil and Water Assessment Tool (SWAT) into a general framework. Uniquely, VCSD-ESF excels at simulating social water supply and demand, estimating the probability of drought propagation risks under various future scenarios, and quantifying the respective impacts of human activities and climate change on drought propagation. Applying VCSD-ESF to the Aral Sea Basin (ASB) in Central Asia, key findings are: (1) from 2015 to 2050, the socioeconomic water use would continue to rise under all scenarios; however, full adoption of drip irrigation can reduce future water demand by approximately 9% (6.6 km3) and curb the peak of basin socioeconomic water demand during 2030–2035; (2) the average probability of drought propagation is expected to reach 48% (i.e., 6% higher than the historical level), with HD exerting twice the impact of MD on propagation probability; (3) significant spatial heterogeneity exists in driving contributions, with human activities dominating drought propagation in the Amu Darya Basin (49.7%) and climate change prevailing in the Syr Darya Basin (51.8%), highlighting the need for tailored agricultural development policies under climate change to suppress drought risk propagation into the socioeconomic domain.}
}
@article{CHEN2026136138,
title = {Seasonal river-level fluctuations regulate riparian nitrate removal through coupled hydrologic exchange and redox dynamics},
journal = {Journal of Hydrology},
volume = {679},
pages = {136138},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136138},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012357},
author = {Jiaxin Chen and Huiqiang Wu and Zhenbiao Xie and Chunhui Lu},
keywords = {Seasonal fluctuations, Denitrification, Riparian zone, Reactive transport, Numerical modeling},
abstract = {Riparian zones function as dynamic biogeochemical reactors that can attenuate river-borne nitrate, yet the role of seasonal river-level fluctuations in regulating this process remains poorly constrained. Here, we develop an idealized two-dimensional, coupled variably saturated flow and reactive transport model to examine how seasonal hydrologic dynamics control nitrate attenuation in riparian zones. The model resolves transient hyporheic exchange and simulates reactive transport of dissolved organic carbon, dissolved oxygen, nitrate, and ammonium under constant river-water chemistry. Results show that seasonal river-level fluctuations substantially modify the spatiotemporal dynamics of nitrate removal by regulating hydrologic exchange, solute delivery, and redox zonation within riparian aquifers. Sensitivity analyses indicate that net nitrate removal increases with fluctuation amplitude and sediment permeability because stronger exchange enhances river-water infiltration and expands denitrification hotspots, and that nitrate removal is greater under losing-river conditions than under gaining-river conditions. By contrast, the fraction of nitrate removed relative to the river-derived nitrate input is controlled primarily by carbon availability, as represented by the DOC concentration of the infiltrating river water. These results suggest that, under the modeled conditions, seasonal hydrologic forcing plays an important role in riparian nitrate attenuation by coupling flow dynamics with redox evolution, and that hydrologic exchange intensity and carbon availability play distinct roles in regulating total nitrate removed and percent nitrate removed.}
}
@article{YIN2026136158,
title = {Divergent seasonal dynamics of high-resolution phosphorus speciation in sediment porewater of small estuaries},
journal = {Journal of Hydrology},
volume = {679},
pages = {136158},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136158},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012552},
author = {Yeran Yin and Hanchang Zhou and Yurui Li and Zheng Wang and Kai Xiao and Zhanrong Guo and Feng Pan and Bojie Fu},
keywords = {Phosphorus speciation, Small estuary, Seasonal variation, Sediment-water interface, HR-Peeper},
abstract = {Dissolved reactive phosphorus (DRP) and dissolved organic phosphorus (DOP) are key constituents of the sediment porewater phosphorus (P) pool. However, a systematic understanding of their seasonal dynamics and coupling mechanisms, especially for DOP in small estuarine systems, remains limited. By combining in situ high-resolution porewater sampling with a microplate P digestion assay, we conducted a spatiotemporal investigation to elucidate the distribution, release mechanisms, and coupling with iron‑manganese (Fe-Mn) redox cycling of both DRP and DOP. The results showed that porewater DRP concentrations increased with depth and positively correlated with dissolved Fe-Mn, while DOP concentrations generally fluctuated with depth. DRP mobility was governed by the Fe-Mn redox sequence, featured by high availability under reducing conditions in summer and winter (mean of 0.36–0.44 mg L−1), whereas DOP production was driven by temperature-dependent organic matter (OM) mineralization merely in summer (mean of 0.79 mg L−1). The diffusion fluxes across the sediment–water interface confirmed these pathways: DRP release was minimal in oxic spring but increased in other seasons, while DOP release was strongly temperature-dependent, peaking exclusively in summer. Overall, the current results suggest that a seasonally differentiated dual‑pathway mechanism coordinates Fe-Mn redox and OM mineralization to control P speciation and release. These insights move beyond a simplistic view of internal P loading and are critical for understanding P dynamics in the two studied small estuarine systems.}
}
@article{HUANG2026136219,
title = {Geochemical heterogeneity and controlling factors of a multi-layer coastal brine system in southern Laizhou Bay: Evidence from aquitard porewaters},
journal = {Journal of Hydrology},
volume = {679},
pages = {136219},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136219},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013168},
author = {Xuebang Huang and Xiujun Guo and Bingxiao Lei and Zhen Wu and Mingbo Li and Yufeng Zhang},
keywords = {Subsurface brine, Br/Cl ratio, Aquitard, Spatial heterogeneity, Seawater evaporative concentration, Laizhou Bay},
abstract = {Coastal subsurface brine systems preserve geochemical records of transgression–regression cycles since the Late Pleistocene, yet whether their original genetic signals are retained under long-term intensive extraction remains an open question. This study investigates the multi-layer brine system of southern Laizhou Bay, the world’s only coastal brine district under large-scale commercial extraction, using Cl− concentrations and Br/Cl ratios from 129 leachate-reconstructed porewater samples across eight boreholes, combined with major ion time-series data from three sampling campaigns spanning non-pumping and pumping periods. The results reveal systematic geochemical contrasts between the eastern and western sectors, with all eastern samples yielding Br/Cl below the seawater reference value, whereas 75% of western samples exceed this threshold, with the maximum reaching more than twice this value. Multi-ion ratio analysis excludes evaporite dissolution and freeze-concentration, indicating that western porewaters retain a relict signal from a stage when the original brine had approached halite saturation, despite subsequent dilution. Time-series comparison shows that lateral freshwater infiltration during pumping periods produces spatially variable but ultimately reversible effects on ion ratio patterns; aquitard porewaters consistently yield higher Br/Cl than coeval aquifer samples, indicating more effective preservation of the original signal. This spatial heterogeneity reflects differential sedimentary evolution under the regional tectonic framework of western subsidence and eastern uplift: sufficient initial salt supply and superior aquitard confinement in the west preserved the evaporative signal, whereas the east is disadvantaged in both respects. Combining porewater and aquifer Br/Cl with multi-ion ratios and time-series data provides a reliable framework for brine genesis discrimination in long-term intensively exploited coastal settings.}
}
