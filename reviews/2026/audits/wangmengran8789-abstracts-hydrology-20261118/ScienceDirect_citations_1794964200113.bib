url = {https://www.sciencedirect.com/science/article/pii/S0022169426012783},
author = {Loren Tolley-Mann and Emilio Grande and Ate Visser and Jory Lerback and A. Jake Harm and Jean E. Moran},
keywords = {Noble gas thermometry, Isotope-derived recharge elevation, Spring hydrology, Oxygen-18 lapse rate, Cascade Range, Spring-fed rivers},
abstract = {Headwater springs in Northern California’s Cascade Range sustain river baseflow and provide thermal refugia for salmonids, but their recharge source areas are largely unknown. To constrain where and when recharge occurs, and how much spring water warms en route to the discharge points, we analyzed stable water isotopes and dissolved noble gases from six major spring complexes across California’s Cascade region between July 2023 and August 2025. We analyzed a total of 31 samples for stable water isotopes, of which 18 were also analyzed for noble gases. We derived a regional δ18O lapse rate from 52 small springs and creeks spanning elevations from 177 to 2588 m, producing a slope of −2.0‰/km (R2 = 0.89). Bootstrap analysis yielded a median lapse rate slope of −1.97‰/km with a 95% uncertainty interval of −2.17 to −1.70‰/km, which was propagated into recharge elevation estimates. Effective mean recharge elevations were consistently high, with values ranging from 1800 to 2900 m across the spring complexes. Noble gas thermometry yielded cold recharge temperatures (1.5–7.0 °C), commonly colder than local mean annual air temperature, consistent with high-elevation recharge during the snowmelt period. Comparing recharge temperatures with discharge temperatures indicates modest net subsurface warming of 2.9 to 8.6 °C and predominantly shallow theoretical flow depths, typically ∼75–250 m and up to ∼300 m. Because many recharge elevations overlap the band where snowpack declines are expected in Northern California due to climate change, these spring-fed systems are likely to warm and lose thermal buffering capacity. The integrated isotope, noble gases, and heat budget framework developed here provides a transferable approach for evaluating climate sensitivity in mountain spring systems.}
}
@article{JIANG2026135998,
title = {Quantifying hydrological responses to climate change and associated canopy variability using an integrated LSTM-SWAT modeling framework},
journal = {Journal of Hydrology},
volume = {679},
pages = {135998},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135998},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010954},
author = {Kunhao Jiang and Hui Ran and Xinyi Chen and Yingnan Wei and Yuanxin Dai and Qiang Yu and Hao Feng and Xiaotao Hu and Ning Yao},
keywords = {Climate change, Climate-driven canopy variability, Hydrological processes, LSTM-SWAT modeling, Topographic differentiation, Weihe River Basin},
abstract = {Climate change and climate-driven canopy variability jointly influence terrestrial hydrological processes, while their combined effects on individual water-balance components across complex terrains remain insufficiently quantified. This study integrated a modeling framework by coupling a Long Short-Term Memory (LSTM) network with the Soil and Water Assessment Tool (SWAT) to assess scenario-based hydrological responses in the Weihe River Basin (WRB) through 2100. The LSTM model was employed to predict grid-level Normalized Difference Vegetation Index (NDVI) trajectories under Coupled Model Intercomparison Project Phase 6 scenarios, including Shared Socioeconomic Pathway 2–4.5 (SSP245) and Shared Socioeconomic Pathway 5–8.5 (SSP585). The predicted NDVI trajectories were then converted into Leaf Area Index (LAI) and incorporated into SWAT as seasonal canopy constraints. The LSTM-based approach reasonably represented climate-driven canopy variability (R2 > 0.90), projecting increasing canopy density under future climate scenarios, particularly under SSP585. Climate change was projected to intensify simulated hydrological fluxes. In the diagnostic climate-change perturbation scenarios, mean streamflow increased by 12.0% under SSP245 and 21.2% under SSP585, whereas the integrated climate-canopy scenarios moderated these increases to 10.7% and 19.4%, respectively, through enhanced evapotranspiration (ET). Terrain-dependent variations in hydrological sensitivity were identified. Specifically, plain regions exhibited stronger responses in surface runoff (SURQ) and groundwater flow (GWQ), plateau regions (PLT) demonstrated larger changes in water yield (WYLD), and mountainous regions (MTN) displayed more pronounced responses in lateral subsurface flow (LATQ). These findings provide scenario-based diagnostic evidence for assessing how climate-driven canopy variability may moderate hydrological responses in topographically diverse watersheds.}
}
@article{WANG2026136184,
title = {FKDM: a frequency-guided Koopman dynamics model with heterogeneous mixture-of-experts for robust daily runoff forecasting under non-stationarity},
journal = {Journal of Hydrology},
volume = {679},
pages = {136184},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136184},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012813},
author = {Wen-Chuan Wang and Kun-Mei Luo and Miao Gu and Can-Can Shi and Yi-Yang Wang and Zong Li},
keywords = {Runoff forecasting, Frequency guided, Koopman operator theory, Mixture of experts, Hydrological interpretability},
abstract = {Accurately forecasting daily runoff processes under non-stationary conditions represents a pivotal challenge in hydrological forecasting. While existing deep learning models demonstrate robust non-linear fitting capabilities, they are generally constrained by several limitations: “spectral bias” arising from time-domain modeling hinders the capability to capture extremes; the absence of dynamical constraints leads to divergent inference; and homogeneous network architectures fail to accommodate the multi-scale evolutionary characteristics of heterogeneous hydrological signals. To address these limitations, this study proposes an end-to-end forecasting framework—the Frequency-guided Koopman Dynamics Model (FKDM)—which integrates frequency-domain theory with operator dynamics. First, the Adaptive Multi-scale Frequency Decoupling Module (FD) is employed to decompose the runoff series into high- and low-frequency components, achieving dynamic orthogonal separation. Subsequently, the Dual-channel Koopman Dynamics Embedding (DKDE) maps the nonlinear runoff evolution into a latent linear space, where spectral-norm constraints are used to ensure numerical stability of the operator iterations. Finally, the Multi-Band Feature Sharing Layer (MBF) overcomes the limitations of traditional homogeneous experts and realizes the adaptive fusion of local fluctuations and global trends via an energy-aware gating mechanism. Validation conducted across four representative basins in the western United States, characterized by diverse hydro-climatic and geomorphological features, including snow-dominated, mixed rain-snow, and high-gradient mountainous regimes, demonstrates the robustness of the proposed approach. Based on ten repeated experiments with different random seeds, the FKDM exhibits superior forecasting performance across all stations, with the Nash-Sutcliffe Efficiency (NSE) ranging from 0.9839 to 0.9849. Compared to benchmark models such as Long Short-Term Memory Networks (LSTMs) and Transformers, the FKDM reduces the Mean Absolute Error (MAE) by 48.70% and the Root Mean Square Error (RMSE) by 49.15%, while effectively controlling mean peak errors to within 7.38% during extreme flood events and reducing the average peak error by 64.6% relative to the benchmark models. Koopman spectral analysis confirms that eigenvalues are strictly distributed within the unit circle (|λ|max<0.73), ensuring asymptotic stability. Temporal Shapley Additive exPlanations (SHAP) analysis reveals that the model adaptively captures concentration lag effects of different basins (1–9 days). FKDM provides a new paradigm for data-driven hydrological forecasting, combining prediction accuracy, numerical stability, and physical interpretability.}
}
@article{GONG2026136156,
title = {An orthogonal residual physics-informed neural network with Karhunen-Loève expansion for inversion of heterogeneous soil hydraulic parameters},
journal = {Journal of Hydrology},
volume = {679},
pages = {136156},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136156},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012539},
author = {Xuezi Gong and Yuanyuan Zha and Shujie Guo and Yufan Zhang and Jiong Zhu and Yuzhe Ji and Liangsheng Shi and Xiaolong Hu and Boyu Wang},
keywords = {Physics-informed neural networks (PINNs), Karhunen-Loève expansion (KLE), Orthogonal residual learning, Parameter inversion, van Genuchten-Mualem parameters},
abstract = {Accurate inversion of heterogeneous soil hydraulic parameters is essential but ill-posed owing to nonlinear flow physics, coupled van Genuchten-Mualem (VGM) parameters, and incomplete boundary information. The Karhunen-Loève expansion (KLE) provides a useful geostatistical prior, but accurate priors are rarely available. Deep neural networks (DNNs) add flexibility, yet naive DNN-KLE coupling in physics-informed neural networks (PINNs) can create representational conflicts when the DNN overlaps the KLE subspace. We propose an orthogonal-residual KLE-PINN that separates prior-supported modes from neural residual components through an orthogonal projection. In controlled one-dimensional experiments, we benchmark the method for joint inversion of heterogeneous VGM parameters under an uncertain-boundary setting against unified and decoupled PINNs, a standard KLE-PINN, and a naive additive hybrid. Shared-output DNNs reproduce hydraulic states well but recover parameter fields poorly, whereas parameter-specific subnetworks only partly reduce this limitation. Under accurate priors, the additive hybrid degrades valid KLE solutions because its components compete for overlapping modes. Under biased priors, variance errors are mostly absorbed by coefficient rescaling, whereas correlation-length errors cause stronger structural bias and cross-parameter compensation. Overall, the proposed model achieves the most accurate and robust parameter reconstructions across tested prior settings by preserving prior-supported modes and assigning DNN flexibility to complementary structures. These results show that robust hybrid PINN inversion requires explicit separation of prior-supported modes and neural residual components.}
}