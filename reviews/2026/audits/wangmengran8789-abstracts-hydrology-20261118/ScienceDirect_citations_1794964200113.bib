@article{QIU2026136217,
title = {Cascading flood impacts of potential landslide dams revealed by InSAR and numerical simulation},
journal = {Journal of Hydrology},
volume = {679},
pages = {136217},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136217},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013144},
author = {Haijun Qiu and Jiarui Yang and Yijun Li and Yiwen Liang and Yaru Zhu and Jian Song},
keywords = {Outburst flood, Landslide-dammed lake, Cascading hazards, InSAR, Scenario simulation},
abstract = {Outburst floods triggered by landslide dam failure are typical cascading hazards in high mountain regions. However, the failure precursors of potential landslide dams and their cascading impacts after outburst floods remain inadequately understood, hindering the early recognition and quantitative assessment of such cascading hazards. This study integrates Interferometric Synthetic Aperture Radar (InSAR) with numerical modeling of physical processes to monitor and assess cascading hazards induced by landslide dams. Using InSAR, we identified multiple active landslides in the study area, three of which exhibited accelerated deformation after the Baige landslide event. We employed Massflow to simulate the potential collapse process of a landslide with high damming potential. Subsequently, the simulated landslide deposits were incorporated into a 2D hydrodynamic model to simulate the outburst flood under different breach scenarios. The simulation results show that under medium and high breach ratio scenarios, downstream active landslide areas exhibit high flow velocities, with stream power in multiple landslide areas exceeding 8 kW/m2 and shear stresses surpassing 550 Pa. These hydraulic forces induce intense toe erosion, potentially reactivating landslides. These findings highlight how outburst floods can propagate instability and amplify cascading hazards. The framework enhances early recognition and quantitative assessment of cascading hazards in alpine river systems.}
}
@article{WU2026136180,
title = {Hierarchical multi-objective management of cascade reservoirs: coordinating long-term strategy and daily operation under hydrological variability},
journal = {Journal of Hydrology},
volume = {679},
pages = {136180},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136180},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012771},
author = {Haotian Wu and Zhaoyang Zhu and Zhaocai Wang and Jiachen Kong and Qikai Liu and Zuowen Tan and Chenye Liu and Tianyu Ren},
keywords = {Cascade reservoir operation, Multi-objective optimization, Multi-timescale coordinated scheduling, Socio-economic-environmental trade-offs},
abstract = {A core challenge in large-scale cascade reservoir operation is the ineffective transmission of macro-scale planning to short-term scheduling, leading to conflicts among strategic objectives under increasing hydrological variability. To address this scale dilemma, this study proposes a Multi-scale Socio-Economic-Environmental Reservoir Management (MSEE-RM) framework. The core innovation lies in a novel “annual-periodic” hierarchical paradigm. The upper-layer model (operating on a 10-day time step) formulates annual strategic water level trajectories that serve as dynamic boundary conditions for the lower-layer model. The lower-layer model performs daily-scale optimization, explicitly tailored to the distinct hydrological and functional characteristics of three key periods: the drawdown period (focusing on fish spawning requirements), the flood season (balancing flood risk distribution), and the storage period (coordinating impoundment with navigation). To efficiently solve the resulting high-dimensional non-linear problems, a reinforcement learning-enhanced evolutionary algorithm (SPEA2-RLS) is developed to adaptively balance search exploration and exploitation. Additionally, an RF-AdaBoost-based surrogate model is integrated to provide computationally efficient predictions of water temperature at a key downstream section, thereby supporting repeated ecological-temperature evaluations during optimization. Results demonstrate that the framework significantly restores long-neglected ecological functions: in wet years, Effective Ecological Hydropeaking Days (EEHD) increased from 0 to 17; in dry years, the Ecological Flow Deficit (EFD) was substantially reduced by 42.9%. Crucially, ecological improvements and economic benefits are enhanced synergistically. In normal years, Total Power Generation (TPG) and System Minimum Power Output (SMPO) increased by 4.4% and 14.9%, respectively, while Navigation Interruption Days (NID) were reduced by 30.5%. Overall, this study quantifies the comprehensive benefits of reservoir operation and reveals the dynamic trade-offs among objectives, providing technical support for multi-objective coordination and watershed management in cascade systems.}
}
@article{CHEN2026136220,
title = {Multi-task learning of reservoir inflow and outflow for streamflow simulation},
journal = {Journal of Hydrology},
volume = {679},
pages = {136220},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136220},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601317X},
author = {Zexin Chen and Bingyao Zhang and Yu Li and Tongtiegang Zhao},
keywords = {Human-regulated catchment, Reservoir operation, Streamflow simulation, Multi-task learning, Long short-term memory},
abstract = {While most reservoir operation modules focus on the single task of outflow simulation, this paper introduces the multi-task learning (MTL) to simultaneously consider both inflow and outflow. Specifically, the long short-term memory (LSTM) network is used to characterize temporal features; the hard parameter sharing of MTL (MTL-HPS) uses one LSTM layer to extract common features; and the soft parameter sharing of MTL (MTL-SPS) employs two parallel LSTM layers and incorporates cross-stitch units to adaptively exchange information. As a benchmark, the single-task learning (STL) is trained separately for inflow and outflow. A case study of 71 reservoirs is designed to evaluate the effectiveness of the MTL-HPS and MTL-SPS. The results highlight that the MTL generally outperforms the STL. The median Kling-Gupta efficiency values of the STL, MTL-HPS and MTL-SPS are respectively 0.80, 0.76 and 0.82 for inflow and 0.62, 0.66 and 0.66 for outflow. The MTL-HPS and MTL-SPS outperform the STL in the simulation of outflow for irrigation, water supply and hydroelectricity reservoirs. By using linear probes to investigate internal states, it is found that the MTL tends to learn more reasonable relationships in reservoir operation than the STL and yields slightly higher correlations for storage. With the increasing length of training data, the effectiveness of the MTL-HPS and MTL-SPS is improved more remarkably than that of the STL, indicating that the MTL better leverages the information of both inflow and outflow. Overall, the MTL provides useful tools for streamflow simulation in human-regulated catchments such as the case study reservoirs.}
}
@article{TAN2026136209,
title = {Balancing segmentation accuracy and hydrological plausibility in multi-source remote sensing flood inundation mapping with adaptive terrain-constrained learning},
journal = {Journal of Hydrology},
volume = {679},
pages = {136209},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136209},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013065},
author = {Yuping Tan and Guoqiang Wang and Yinglan A. and Baolin Xue and Jin Wu and Yuntao Wang and Qiao Wang},
keywords = {Flood inundation mapping, Terrain-constrained learning, Hydrological plausibility, Multi-objective optimization, Multi-source remote sensing, Adaptive loss weighting},
abstract = {Remote sensing-based flood inundation mapping is commonly optimized as a semantic segmentation task using pixel-overlap objectives. However, flood extent is also a terrain-controlled spatial process, and accuracy-oriented models may generate locally implausible patterns, including downstream discontinuities, false positives on steep slopes, and incomplete detection of low-lying inundation. This study frames flood inundation mapping as a multi-objective problem that requires balancing image-based segmentation accuracy with terrain-hydrological plausibility. We propose an adaptive terrain-constrained learning framework that dynamically coordinates pixel supervision, regional overlap, boundary refinement, and DEM-derived terrain-consistency within a unified U-Net architecture. The terrain constraints are not intended to reproduce hydrodynamic processes; instead, they serve as lightweight soft constraints for reducing terrain-implausible patterns in discrete flood probability maps. Cross-regional 10-fold validation on the Sen1Floods11 dataset shows that reliable multi-source observability is a prerequisite for terrain-constrained optimization. Under the full SAR-optical-terrain input setting, fixed terrain-constrained losses reduced flow-direction violations but degraded F1-score and IoU, revealing an accuracy-plausibility trade-off. In contrast, the proposed Adaptive-Dynamic strategy achieved the best overall segmentation performance, with an F1-score of 0.864 and an IoU of 0.761, while maintaining low high-slope false positives and good lowland flood recovery. These results indicate that terrain-derived hydrological priors are most effective when introduced as adaptive soft constraints that regularize image-derived flood predictions without dominating image-based flood evidence, thereby reducing local prediction patterns that contradict basic terrain logic rather than simulating hydrological processes.}
}
@article{SUN2026136120,
title = {Enhanced chlorophyll-a concentration prediction in coastal waters using transformer networks with multivariate water quality parameters},
journal = {Journal of Hydrology},
volume = {679},
pages = {136120},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136120},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012175},
author = {Xiaoyao Sun and Lichen Xu and Jiayu Hong and Yijun Chen and Yuanyuan Wang and Hangjian Feng and Sensen Wu and Zhenhong Du},
keywords = {Harmful algal blooms, Chlorophyll- concentrations, Exogenous variables, Time series prediction, Transformer, Hierarchical structure},
abstract = {The accurate prediction of chlorophyll-a (Chl-a) concentrations in coastal waters is critical for mitigating the ecological and economic impacts of harmful algal blooms (HABs). Despite advancements in machine learning and deep learning methods, challenges remain in capturing the complex, time-varying dependencies of environmental factors and ensuring model interpretability. To address these gaps, we propose an innovative Transformer-based deep learning framework for Chl-a prediction using multiple exogenous variables, termed ExoCaT (Exogenous variable-integrated Chlorophyll-a prediction Transformer network), which integrates Variable Selection Networks (VSN) with a Hierarchical Encoder–Decoder (HED) architecture to enhance both forecasting accuracy and feature interpretability. The VSN offers insights into the temporal importance of environmental drivers and enables a better understanding of how key features influence Chl-a variability. To validate the proposed framework, ExoCaT is tested using data from two hydrological monitoring stations in the Ningbo and Zhoushan coastal areas. Compared to five state-of-the-art models in multistep-ahead predictive accuracy, our proposed model demonstrates substantial performance enhancements across both short-term and medium-term horizons, achieving a reduction of over 15% in the short-term prediction. Particularly under extreme bloom conditions, ExoCaT shows superior forecasting capability, effectively capturing Chl-a dynamics. Furthermore, interpretability analysis attests that electrical conductivity and water temperature are the most important factors for short-term prediction. By addressing the dual challenges of interpretability and temporal complexity, ExoCaT provides a useful operational tool for buoy-derived Chl-a prediction, supporting proactive decision-making in HABs management and marine conservation.}
}
@article{VERDI2026136140,
title = {KURVE: A web-based tool for estimating soil water retention and hydraulic conductivity curves using a k-nearest neighbor approach},
journal = {Journal of Hydrology},
volume = {679},
pages = {136140},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136140},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012370},
author = {Amir Verdi},
keywords = {HYPROP, WP4C, Pedotransfer functions, Unsaturated flow, Vadose-zone modeling},
abstract = {Direct measurement of the soil water retention curve (WRC) and hydraulic conductivity curve (HCC) is expensive and time-consuming. Pedotransfer functions (PTFs) are statistical models that estimate soil hydraulic properties using basic soil data that are typically available or easier to measure. This paper introduces KURVE, a novel web-based tool that uses a recently published HYPROP-WP4C-based German reference dataset and a k-nearest neighbor approach to estimate complete WRCs and HCCs. KURVE selects nearest soils from the reference dataset based on basic soil properties, including soil texture, bulk density (BD), and organic carbon content (OCC), and estimates target-soil hydraulic curves by averaging fitted van Genuchten (VG) and Peters–Durner–Iden (VG-PDI) hydraulic functions from the selected neighbors. The performance of KURVE was evaluated using two independent datasets, a large international dataset and a smaller regional dataset from California, USA, and was compared with the widely used Rosetta and Rosetta3 PTF models. KURVE showed promising performance for estimating both curves. For WRC prediction, KURVE achieved RMSE values as low as 0.061 cm3 cm⁻3 for the international dataset and 0.039 cm3 cm⁻3 for the California dataset, which was comparable to or slightly better than Rosetta-based models. For HCC prediction, KURVE substantially outperformed Rosetta-based models, with minimum log(K) RMSE values of 0.594 for the international dataset and 0.560 for the California dataset when soil texture and BD were used as inputs. The results also showed that adding BD to soil texture improved model performance, whereas adding OCC as an additional predictor did not provide consistent improvement. KURVE is freely available at kurve-ptf.streamlit.app and provides the scientific community with an accessible tool for applications that require soil hydraulic information.}
}
@article{PING2026136112,
title = {The role of surface water-groundwater mixing in regulating nitrogen hotspot distribution and nitrate fate},
journal = {Journal of Hydrology},
volume = {679},
pages = {136112},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136112},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012096},
author = {Xue Ping and Zhang Wen and Yang Xian and Stefan Krause and Songhu Yuan and Zhixin Zhang and Menggui Jin},
keywords = {Hyporheic zones, Surface water-groundwater interaction, Mixing-dependent reactions, Biogeochemical cycling},
abstract = {Hyporheic zones (HZs) modulate water quality by acting as natural buffers for groundwater-borne nitrate contaminants, facilitating biogeochemical reactions in surface water and groundwater (SW-GW) mixing zone (the colocation region of SW and GW) by complementary reactants delivery. However, how SW and GW mixing regulates mixing triggered nitrogen hotspot distribution (regions with higher turnover productions and rates) and GW-borne nitrate reduction remains unclear. Here we combined a flume experiment, characterizing coupled hydrodynamic, biogeochemical processes, microbial functions and communities in a simulated HZ with a numerical model, integrating flow, reactive solute transport, and microbial activities, to address this gap. In lowland HZs, a typical setting where nitrate-polluted GW discharges into streams with high available organic carbon, SW and GW mixing induces denitrification and dissimilatory nitrate reduction to ammonium (DNRA), with their hotspots segregated spatially: denitrification prevails in the mixing zone interior and downstream, whereas DNRA is localized to the upstream mixing zone. This stems from their distinct C/N demands: denitrification prefers low C/N conditions, while DNRA favors high C/N conditions, both are optimally met at the margins of mixing zone. DNRA-produced ammonium is subsequently nitrified under upstream aerobic conditions, impairing HZ self-purification and exacerbating stream eutrophication. Prior studies exclusively emphasizing mixing-triggered denitrification likely overestimate GW-borne nitrate attenuation by neglecting DNRA. Our findings advance understanding of mixing-driven nitrogen cycling and nitrate fate in hyporheic/riparian ecosystems.}
}
@article{CAI2026136132,
title = {Hydrologic–anthropogenic mismatch modulates carbon–nutrient stoichiometric instability in an integrated agriculture–aquaculture watershed of southern China},
journal = {Journal of Hydrology},
volume = {679},
pages = {136132},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136132},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012291},
author = {Yezhao Cai and Nian She and Kairong Lin and Pengjun Li},
keywords = {Integrated agriculture-aquaculture (IAA) system, Riverine carbon-nitrogen-phosphorus stoichiometry, Hydrological regimes, Spatiotemporal mismatch, Adaptive drainage management, Rural watershed},
abstract = {Hydrologic volatility driven by climate change and intensified anthropogenic interference in subtropical integrated agriculture-aquaculture (IAA) watersheds have substantially disrupted riverine biogeochemical cycles, yet the dynamics of carbon-nutrient stoichiometry under seasonally contrasting hydroclimatic and land-use conditions remain insufficiently characterized. This study integrated seven years (2018–2024) of monthly in-stream hydrochemical monitoring across 20 subcatchments of the Neikeng River watershed, southern China, employing an exploratory five-tier analytical framework to examine dissolved organic carbon (DOC), total nitrogen (TN), total phosphorus (TP) concentrations, as well as their stoichiometric molar ratios. Results revealed pronounced seasonal stoichiometric imbalance. Dry-season baseflow conditions, coinciding with aquaculture pond drainage, induced co-occurring carbon-limitation, with approximately 70% of subcatchment observations falling below DOC:TN = 5 and 40% below DOC:TP = 20, while the wet seasons exhibited co-occurring nitrogen and phosphorus enrichment and pseudo nitrogen-limitation, with more than 90% of subcatchment observations falling below TN:TP = 20. PLS-PM modeling indicated that chemical indices, particularly TN, TP, and NH3-N, as well as land-use composition, primarily suppressed DOC:TN and DOC:TP molar ratios, while hydroclimatic factors appeared to regulate TN:TP stoichiometric shifts. Convergent multi-method evidence supported a working hypothesis of a seasonal source-sink inversion of aquaculture ponds, challenging the temporally invariant assumptions of current export coefficient models. Hydrologic–anthropogenic mismatch, rather than absolute carbon-nutrient loading, emerged as the primary structural correlate of stoichiometric instability. These findings provided a stoichiometrically grounded basis for the development of seasonally adaptive drainage management of rural watersheds, advocating ratio-based intervention strategies over conventional concentration-reduction approaches.}
}
