@article{LI2026136201,
title = {A dependency-guided symbolic regression framework for overcoming error compensation in hybrid AI–physical models},
journal = {Journal of Hydrology},
volume = {679},
pages = {136201},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136201},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012989},
author = {Qingliang Li and Mujie Wu and Cheng Zhang and Zhongwang Wei and Wei Shangguan and Jinlong Zhu and Jing Wang and Xiaoning Li and Yuguang Yan and Zijian Zhang and Wenzong Dong and Xiaoming Shi and Yunfeng Lv and Yongjiu Dai},
keywords = {Symbolic regression, Hybrid AI-physical model, Hydrological modeling, Error compensation, Evapotranspiration, Streamflow simulation},
abstract = {Integrating AI-discovered formulas into process-based Earth system models is difficult. Earth functions as a connected system with directional dependencies from upstream to downstream. When components are trained in isolation and later embedded, error compensation can occur: downstream modules absorb upstream errors, local metrics appear strong, yet system performance and physical consistency decline. We use hydrologic modeling as a tractable testbed. Deep symbolic regression (DSR) provides transparent evapotranspiration (ET) formulas. A knowledge guided variant (KG-DSR) builds runoff relations that preserve links among surface runoff, interflow, and baseflow. These expressions are first trained and evaluated with observed meteorology, then inserted into the HBV model under several integration strategies, including a sequential scheme that stabilizes ET before calibrating runoff. ET formulas from DSR outperform the original HBV scheme in offline tests. More than 70% of basins show higher Kling–Gupta efficiency (KGE) and lower RMSE, with better representation of vegetation controls on ET. In coupled runs, adding only the ET module yields limited benefit. The sequential strategy improves system behavior: relative to embedding runoff alone, ET KGE rises by 16.1% and streamflow KGE by 4.9%; relative to the HBV baseline, gains reach 11.6% and 10.1%. Performance for extreme flows and baseflow indicators is also highest under the sequential strategy. Stabilizing upstream ET reduces error compensation and strengthens cross-process consistency in coupled hydrologic models. A stepwise inclusion of explicit, interpretable parameters offers a general path to transparent, AI-guided modeling of complex Earth system processes, with implications for drought forecasting, flood risk assessment, and low flow management.}
}
@article{QI2026136185,
title = {From temperature to VPD: shifting drivers of flash droughts amplify ecosystem risks in high-latitude cold climates},
journal = {Journal of Hydrology},
volume = {679},
pages = {136185},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136185},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012825},
author = {Long Qi and Chunyu Dong and Tingting Chen and Kairong Lin and Lei Chen and Xiaohong Chen},
keywords = {Drought, Climate change, VPD, Flash drought, Climate warming},
abstract = {Flash droughts—marked by rapid soil moisture depletion—are intensifying globally, yet their evolving drivers remain poorly quantified. Here, using the ERA5-Land reanalysis dataset spanning 1950–2023 and an explainable AI framework (XGBoost-SHAP), we uncover a fundamental shift in drought dynamics between two distinct epochs: the pre-period (1950–1986) and the post-period (1987–2023). While tropical and temperate zones maintain high absolute severity, the high-latitude cold zones of the Northern Hemisphere have emerged as epicenters of accelerated risk, exhibiting heightened frequency (+18.0%), duration (+2.1%), and severity (+6.9%). Crucially, within these rapidly warming cold climates, we find that intense atmospheric evaporative demand, driven specifically by vapor pressure deficit (VPD), appears to have superseded temperature as the dominant trigger of flash droughts. Concurrently, actual evapotranspiration (AET) during pre-drought and onset phases now appears to predominantly drive drought intensification and severity. These findings reveal that contemporary flash droughts in high-latitude cold zones are catalyzed by acute atmospheric thirst rather than gradual thermal increases. Consequently, updating current monitoring frameworks to incorporate VPD and AET sensitivities is critical for anticipating and mitigating compounding vulnerabilities in cold climate ecosystems.}
}
@article{WANG2026136218,
title = {Global plateau regions face rapid groundwater loss},
journal = {Journal of Hydrology},
volume = {679},
pages = {136218},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136218},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013156},
author = {Dong Wang and Bo-Hui Tang and Menghua Li and Guokun Chen and Dong Fan and Junyi Chen and Liang Huang and Xingming Zhu and Zhiwei He and Lei Wei and Fangliang Cai and Zhao-Liang Li},
keywords = {Global, Plateau, Groundwater, GRACE, Spatiotemporal dynamics},
abstract = {Plateaus, which host numerous glaciers, are recognized as critical reservoirs of global groundwater storage (GWS). Although GWS has been widely investigated at regional and global scales, a comprehensive assessment of GWS dynamics across global plateau regions (GPR) remains lacking. Here, GWS anomalies across GPR were reconstructed from 2002 to 2022 using GRACE and GRACE-FO observations combined with GLDAS-derived hydrological components. The reconstructed GWS was further validated against the Mascon solution and an independent GWS product, demonstrating strong consistency among different datasets. The results reveal that GWS in global plateaus has been undergoing an accelerating decline, accompanied by pronounced spatial and temporal heterogeneity in both amplitude and phase. On average, plateau regions have experienced a GWS decline of −0.213 ± 0.027 cm/yr, with the steepest reductions recorded in North America (−0.816 ± 0.061 cm/yr) and Europe (−0.579 ± 0.085 cm/yr). In contrast, major high-altitude lakes exhibit a modest increase in water storage (0.103 ± 0.03 cm/yr), thereby partially compensating for groundwater declines. Our findings provide new insights into GWS dynamics across GPR and offer scientific support for sustainable groundwater management under ongoing climate change.}
}
@article{ALWARDY2026136149,
title = {Assessing compound drought-heatwave events in Oman using non-stationary copula models},
journal = {Journal of Hydrology},
volume = {679},
pages = {136149},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136149},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012461},
author = {Malik Al-Wardy and Erfan Zarei and Mohammad Reza Nikoo and Maha Al-Balushi},
keywords = {Compound drought-heatwave events, Standardized precipitation evapotranspiration index (SPEI), Non-stationary copula, Climate extremes, Oman},
abstract = {Compound drought-heatwave (CDHW) events have severe ecological and socioeconomic consequences, particularly in Oman’s arid environments, where higher temperatures and increased aridity amplify their impacts. This study analyzes the frequency, duration, and severity of drought, heatwave, and CDHW events and the non-stationary joint probability of them in Oman using ERA5-Land data. Drought was measured using the Standardized Precipitation Evapotranspiration Index (SPEI), and heatwaves were identified using relative temperature thresholds. Compound events were defined as coincident drought and heatwave events. Spatial trends were assessed using the Mann-Kendall test and the Theil-Sen slope estimator, and k-means clustering classified regions by hazard exposure. Non-stationary copula models (Gaussian and Clayton) were employed to analyze dependencies between heatwaves and drought, with model performance evaluated by ΔAkaike Information Criterion (AIC). Results show pronounced spatial patterns: the interior and west of Oman experienced the highest incidence of drought, while heatwaves dominated the northern coasts. CDHW events were most common in central-western and northern regions, with 2023–2024 being record-breaking in severity. Trend analysis indicated an increasing drought frequency but stationary heatwave trends, while copula modeling indicated stronger dependencies in coastal regions. The location–scale non-stationary model, incorporating both joint location and scale parameters, provided the best fit, highlighting the dynamic behavior of compound extremes. The joint probabilities were highest in the southern and eastern coastal regions (up to 87%), while dependency strength ranged from −41% to 58%. These findings point to Oman’s growing vulnerability to CDHW events, particularly in coastal and desert areas.}
}
@article{LI2026136210,
title = {Deep learning-based precipitation nowcasting integrating radar echoes and rain gauge data},
journal = {Journal of Hydrology},
volume = {679},
pages = {136210},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136210},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013077},
author = {Leijing Li and Jianzhu Li and Yongtao Wang and Chongju Shang and Zhixia Li and Jin Liu},
keywords = {Deep learning, Radar echo extrapolation, Precipitation nowcasting, SAAR-UNet, RST-RainNet},
abstract = {For flood protection and disaster mitigation, reliable and accurate short-term heavy rainfall forecasts are essential. Yet precipitation nowcasting is a very difficult task due to the great temporal and spatial variability of precipitation at small spatial scales. To improve precipitation nowcasting accuracy, a radar echo extrapolation model (SAAR-UNet) and quantitative precipitation estimation model (RST-RainNet) were developed. By using an ASPP module, residual convolution, and a spatial attention mechanism, the SAAR-UNet greatly improved the extrapolation ability for the variation of strong echoes. Based on the extrapolated echoes, RST-RainNet employs a dual-branch framework that combines radar echo sequences with gauge-constrained QPE priors and performs residual-aware fusion for precipitation nowcasting. Extensive comparative experiments against attention-based and convolutional U-Net variants showed that SAAR-UNet achieved the most robust performance for strong echo extrapolation. For precipitation nowcasting, RST-RainNet was evaluated against optimized Z-R relationships, machine-learning models (MLP, RF, and XGBoost), and radar-only single-branch deep-learning baselines (UNet-ConvLSTM and UNet-Transformer). Across two independent storm events within the Liulin watershed, RST-RainNet consistently achieved the highest correlation coefficients and the lowest overall errors at both the one-hour and two-hour lead times, while more faithfully reproducing the temporal evolution and spatial structure of rainfall. The results indicate that combining radar echoes with gauge-constrained physically guided priors and residual correction can improve precipitation nowcasting accuracy and event-level robustness within the study watershed.}
}
@article{LI2026136230,
title = {Precipitation amount versus precipitation phase: a threshold in precipitation-amount change governs the shift in their relative influence on snowmelt dynamics},
journal = {Journal of Hydrology},
volume = {679},
pages = {136230},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136230},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013272},
author = {Dongsheng Li and Wei Ouyang and Shaoqing Liu and Jie Tang and Jing Chen and Kaiyue Ji and Anarmaa Sharkhuu and Soyol-Erdene Tseren-Ochir},
keywords = {Snowmelt runoff, Mechanism quantification, Future projections, Temperature index model, Climate change, Diffuse pollution},
abstract = {Snowmelt represents a critical freshwater source in mid-high latitude regions, yet its availability is increasingly threatened by climate change. Although snowmelt is jointly controlled by variations in precipitation amount and temperature-driven precipitation phase transitions, the relative importance of these mechanisms remains insufficiently disentangled and quantified. In this study, a terrain-enhanced temperature index model was coupled with an attribution approach that partition changes in snowfall between changes in precipitation amount and temperature-driven shifts in precipitation phase, thereby isolating and quantifying their respective effects on snowmelt dynamics across Mongolia for the historical (1980–2023) and future (2040–2099) periods. Results show that historical snowmelt declines were primarily driven by reductions in precipitation amount, with ∼54% of the decrease attributable to losses in cold season precipitation. A threshold of ±23 mm/decade in precipitation amount change was identified, marking a shift in the dominant control on snowmelt variability. When precipitation changes were minor (within ±23 mm/decade), snowmelt variability was mainly governed by temperature-driven precipitation phase shifts; beyond this range, precipitation amount exerted the dominant control. Under future scenarios, the dominance of precipitation amount strengthens further, with cold season precipitation accounting for up to ∼85% of the projected snowmelt increase. These findings establish a threshold-based framework for diagnosing the switching of dominant controls on snowmelt and provide transferable insights into cryospheric water-cycle responses to climate change in cold, mid-high latitude regions.}
}
@article{XU2026136141,
title = {Source identification of multi-process clogging in a deep groundwater recharge well: a combined mineralogical-geochemical approach},
journal = {Journal of Hydrology},
volume = {679},
pages = {136141},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136141},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012382},
author = {Yang Xu and Xinwang Li and Suying Ma and Yinhuan Fu and Xueyan Ye and Yalin Song and Xinqiang Du},
keywords = {Managed aquifer recharge, Deep groundwater recharge well, Wellbore deposits, Particle migration, Well corrosion, Carbonate preciptation},
abstract = {Deep groundwater recharge wells are vulnerable to clogging, but field identification of the responsible solids is difficult because they may originate from recharge water, aquifer materials, well construction, corrosion, and hydrochemical reactions. This study characterized clogging-associated deposits and mobilized solids from a deep groundwater recharge well in the North China Plain using X-ray diffraction, X-ray fluorescence, Fourier-transform infrared spectroscopy, water-quality analysis, and PHREEQC geochemical mixing simulations. Deposits on the galvanized pump pipe contained Zn-Fe corrosion phases, including hydrozincite, akaganeite, and hematite. Muddy and flange-associated deposits and solids discharged during air-lift rehabilitation contained quartz, feldspars, clay minerals, and Fe oxides, indicating the coexistence of mineral particles and corrosion-derived solids. Wellhead yellow foam was amorphous and multi-elemental but cannot represent in situ aquifer clogging deposits. Recharge water containing 8 mg/L total suspended solids introduced a gross external particle load of 611.2064 kg over 76,400.8 m3. Mineralogical overlap also indicated an internally available or previously deposited pool of mobilizable particles, although the relative contributions of external and internal sources could not be resolved. Geochemical modeling confirmed carbonate supersaturation under mixed recharge-native groundwater conditions. The results identify particle input and remobilization, well-material corrosion, and carbonate precipitation potential as coexisting clogging-related processes. Management should therefore combine particle-load control, improved well development, corrosion monitoring, and mixing-based geochemical assessment.}
}
