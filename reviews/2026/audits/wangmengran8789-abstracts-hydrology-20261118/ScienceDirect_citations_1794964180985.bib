@article{WAN2026136442,
title = {Moderate microplastic pollution and ecological risks in the Yellow River Basin},
journal = {Journal of Hydrology},
volume = {680},
pages = {136442},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136442},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015398},
author = {Shun Wan and Guoce Xu and Yahong Fan and Xin Chen and Zhanbin Li and Mengyao Tuo and Mengyuan Zhao and Kang Fang},
keywords = {Microplastics, Yellow River, Migration, Pollution source, Risk assessment},
abstract = {The Yellow River is one of the major rivers transporting microplastics (MPs) to the ocean in China, yet basin-wide information on MP distribution, sources, and ecological risks remains limited. Therefore, this study systematically investigated MPs across the entire Yellow River Basin. MP contamination was widespread throughout the Yellow River basin. The average abundances of MPs were 5.10 ± 0.68 items/L and 137.16 ± 20.11 items/kg in surface water and sediments, respectively. Small (<1 mm) and white MPs were the predominant categories, accounting for 86.9–91.2% and 57.0–65.5%, respectively. The morphology and polymer composition of the MPs in surface water were primarily characterized by polypropylene and polyethylene fibers, whereas those in sediments were predominantly characterized by pellet-shaped particles and polyester. Spatial analysis revealed significant differences in MP abundance and composition among media and river sections (P < 0.05). However, no significant differences were observed in MP abundance or composition between the mainstream and tributaries in the surface water or sediments. Anthropogenic factors, particularly the proportion of built-up land and population density, were identified as the key drivers of MP distribution in surface water. In contrast, the MP distribution in sediments was influenced by both natural (e.g., annual precipitation and annual mean temperature) and anthropogenic factors. Source apportionment indicated that wastewater treatment plant effluent, agricultural soils, and road dust were the primary MP sources, contributing 48.7%, 34.1%, and 17.0%, respectively. The ecological risk assessment based on species sensitivity curves suggested that the overall MP pollution in the basin posed a moderate ecological risk.}
}
@article{ZHANG2026136470,
title = {Benthic water exchange drives inorganic carbon export via paleochannels in deltaic seas},
journal = {Journal of Hydrology},
volume = {680},
pages = {136470},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136470},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015672},
author = {Runze Zhang and Guangquan Chen and William C. Burnett and Shibin Zhao and Tristan McKenzie and Honghai Zhang and Haowei Xu and Wen Liu and Tianyi Zhu and Xiaoyi Guo and Jia’ning Zhang and Miaomiao Zhang and Shuyang Huang and Chunmei Jiang and Zenghui Zhu and Shuo Ren and Ran An and Xiaopeng Lv and Sihui Liu and Zhigang Yu and Bochao Xu},
keywords = {Submarine groundwater discharge, Pore water exchange, Radium isotopes, Inorganic carbon export, Paleo-river channel, Yellow River delta},
abstract = {Submarine groundwater discharge (SGD, m-to-km scale) and cm-scale porewater exchange (PEX) are important benthic water flow processes that regulate nutrient and inorganic carbon dynamics in coastal seas. Partitioning SGD and PEX is useful for accurately quantifying their water and solute contributions. This is particularly important in deltaic systems underlain by well-developed, yet understudied, paleochannels. Here we employ an optimized multi-radium mass balance model to distinguish SGD from PEX and quantify the dissolved inorganic carbon (DIC), total alkalinity (TA), and CO2 fluxes in the Yellow River deltaic seas. Benthic water exchange hotspots were identified in the southern estuary, where the combined SGD and PEX fluxes were 3–6 times greater than those in the northern region. The extensive paleo-river channel network in the south may facilitate SGD. More spatial heterogeneity was observed during the wet season, with total SGD and PEX fluxes approximately twice those in the dry season. PEX dominated the total benthic water flux, exceeding SGD by a factor of 2–4 across regions and seasons. Both SGD and PEX contributed substantially to inorganic carbon export, especially during the wet season. Lateral exports of SGD- and PEX-driven HCO3– and CO32– fluxes exceeded vertical sedimentary carbon burial by 2–4 times on average. Considering the potential offset from CO2 emission and CaCO3 precipitation, SGD and PEX still represent important carbon sink contributor in the Yellow River delta. We propose that benthic exchange processes should be considered in future assessments of coastal carbon sinks.}
}
@article{MENG2026136462,
title = {Quantitative monitoring of DNAPL source zone evolution in heterogeneous aquifers via deep-learning fusion of time-lapse surface and cross-borehole ERT with borehole constraints},
journal = {Journal of Hydrology},
volume = {680},
pages = {136462},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136462},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015593},
author = {Fansong Meng and Yuting Zhang and Dejin Wang and Yaping Qi},
keywords = {Densenonaqueous phase liquids, Heterogeneous aquifer, Time-lapse electrical resistivity tomography, Multi-source data fusion, Source-zone characterization, Deep learning},
abstract = {Dense non-aqueous phase liquids (DNAPLs) persist for decades in heterogeneous aquifers, where characterizing source-zone evolution is essential for contamination control and remediation assessment. Borehole sampling is sparse and invasive, while individual electrical resistivity tomography (ERT) configurations suffer inherent resolution limits. This study presents a borehole-constrained, multi-source time-lapse electrical fusion inversion framework that couples multiphase flow and petrophysical simulation with a deep-learning architecture, allowing reconstruction of DNAPL saturation fields from time-lapse surface ERT, time-lapse cross-borehole ERT, and sparse borehole concentration data. Coupled simulations supply physically consistent training data unavailable from real contaminated sites. Relative to single-ERT approaches, the fusion strategy reduces the mean source-zone area estimation error from 29.41 to 49.64% to 20.67% and the mean migration-front error from 18.77% to 5.42%, reductions of up to 58.4% and 71.1%, respectively. Incorporating borehole concentration data as spatial constraints further reduces the boundary displacement error by 37.4% and the saturation mean squared error by 28.6%. In a heterogeneous laboratory sandbox experiment, the borehole-constrained fusion reached a mean intersection over union of 0.682, reduced the mean boundary error by 69.6% relative to standalone surface ERT, and lowered the source-area overestimation from 148% to 33%. A borehole-spacing analysis further identifies a practical drilling-density threshold of about 1.5 m for the tested configuration. The method may inform soil and groundwater protection efforts, including identification of high-risk source zones, the placement of remediation wells, and the estimation of contaminant mass flux for risk assessment, and provides a basis for further studies on monitoring complex contaminated sites.}
}
@article{NUSSBAUM2026136438,
title = {Dual urban runoff response to urbanization and contradictory precipitation trends driven by climate change},
journal = {Journal of Hydrology},
volume = {680},
pages = {136438},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136438},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015350},
author = {Raz Nussbaum and Moshe Armon and Efrat Morin},
keywords = {Urban runoff, Climate change, Urbanization, Urban runoff modeling, Heavy precipitation events (HPEs), Convection-permitting modeling, Mediterranean},
abstract = {Urban flooding poses a growing threat to cities worldwide, driven by the compounding effects of climate change and urbanization. This study examines the effect of urbanization and contradictory precipitation trends, defined as increasing storm intensity and decreasing total precipitation, on urban runoff. Analyzing CMIP6 projections, we show that contradictory precipitation is projected to impact 26% of urban areas globally. To examine how these trends manifest at finer scales, we analyze changes in heavy precipitation events at both regional and catchment scales using convection-permitting WRF simulations. Their hydrological implications are then assessed using a calibrated SWMM urban runoff model driven by an ensemble of over 5,300 spatially shifted simulations. We find that future storms become more spatially confined while their short-duration maximal intensities increase at both regional and catchment scales. Consequently, from a catchment-scale hydrological perspective, weak runoff peaks become weaker, while strong peaks become stronger, a pattern that is amplified by urbanization. Furthermore, peak runoff is increasingly governed by short-duration rainfall intensities under future conditions, an effect amplified by urbanization. Additionally, we suggest a mechanism whereby more compact future storms suppress runoff when they miss the catchment, yet amplify peaks when they overlap with it. Concurrently, drier antecedent conditions suppress runoff from weak events while intense bursts rapidly exceed infiltration and storage capacities. This contrasting urban hydrological response to climate change poses a critical challenge for urban flood management.}
}
@article{LIU2026136385,
title = {Strategies for correcting nonstationary resistivity–water content relations in time-lapse electrical resistivity tomography},
journal = {Journal of Hydrology},
volume = {680},
pages = {136385},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136385},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014824},
author = {Jianguo Liu and Simone Gelsinari and Andrew {van de Ven} and Matthias Leopold and Sally Thompson},
keywords = {Electrical resistivity tomography (ERT), Petrophysical relationship, Soil moisture, Particle filter, Data assimilation},
abstract = {Time-lapse Electrical Resistivity Tomography (ERT) provides an attractive framework for quantifying spatially distributed water-content dynamics, yet quantitative interpretation remains limited by uncertainty in the petrophysical relationship between resistivity (ρ) and volumetric water content (θ). This uncertainty is distinct from that associated with lithological heterogeneity, measurement resolution, or inversion artefacts, and can arise from temporal variability in the ρ–θ relationship itself. We examine two approaches for representing this nonstationary behaviour: a particle-filter data-assimilation framework that requires continuous or periodic co-located water-content observations from an independent sensor system to dynamically calibrate time-varying petrophysical parameters, and a machine-learning model that predicts θ from resistivity-based predictors together with auxiliary environmental information, including surface water content and contact resistance, after training. Synthetic experiments indicate that the imposed time-varying petrophysical scaling coefficient, a(t), and saturation exponent, b(t), can be recovered with low trajectory error across the tested ranges of parameter amplitudes, frequencies, and resistivity-noise levels. Applications at two sandy vadose-zone sites in Western Australia show that data-assimilation-based dynamic calibration of the petrophysical relationship substantially improves consistency between ERT-derived water-content reconstructions and the co-located water-content observations assimilated by the particle filter. The particle-filter reconstructions should therefore be interpreted as assimilation-constrained dynamic reconstructions that evaluate the benefit of updating the ρ–θ relationship through time relative to a stationary petrophysical calibration. The data assimilation framework provides a direct depiction of how the relationship evolves through time, capturing gradual seasonal shifts as well as extended periods of relative stability. Machine learning offers a practical alternative when sufficient and representative data are available. The observed variability in the effective petrophysical relationship covaried with near-surface environmental and electrode-contact conditions, as indicated in part by contact-resistance diagnostics. We interpret these associations as empirical and installation-specific, rather than as evidence that contact resistance is an intrinsic soil property or an independent causal control. Accounting for temporal variability in the petrophysical relationship improves the interpretability and reliability of quantitative time-lapse ERT analyses.}
}
@article{HU2026136477,
title = {Subsurface processes of Li isotopic fractionation: A study of groundwater at the semi-arid Lake Qinghai catchment, NE Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {680},
pages = {136477},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136477},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601574X},
author = {Yadan Hu and Yang Cao and Fei Zhang and Li Deng and Zhangdong Jin},
keywords = {Li isotopes, Hydrology, Groundwater, Water–rock interaction},
abstract = {Riverine lithium isotopic composition (δ7Li) has been widely used as a tracer for continental silicate weathering. Groundwater could have critical influences on continental rivers and marine Li budget, but the subsurface processes of Li isotopic fractionation remain unclear. This study systematically investigates δ7Li signatures of shallow groundwater within the Lake Qinghai catchment, northeastern Tibetan Plateau. Our results show significant variability in δ7Li of shallow groundwater, ranging from ∼5‰ to ∼27‰. Brackish groundwater generally exhibits higher δ7Li values relative to fresh groundwater, except for two samples characterized by very low δ7Li. Higher δ7Li values in brackish groundwater suggest more secondary phase formation associated with longer water–rock interaction times, leading to more 6Li incorporation into clays and larger isotopic fractionation, consistent with overall higher TDS. Lower δ7Li values in fresh groundwater are consistent with shorter water–rock interaction times, which would limit secondary mineral formation and suppress Li isotopic fractionation. Very low, rock-like δ7Li values in brackish groundwater reflect congruent weathering of silicate rocks. Similar to surface waters, water–rock interaction time may be an important control on Li isotope fractionation in groundwater. Importantly, the remarkable range of δ7Li values in shallow groundwater from this tectonically active catchment indicates that within a single basin, groundwater δ7Li is not systematically high or low and even encompasses the full range of riverine δ7Li. These findings provide new insights into the potential influence of subsurface δ7Li on interpretations of weathering processes in continental river basins.}
}
@article{GUO2026136474,
title = {A grid-informed physics-guided graph deep learning framework for interpretable distributed daily streamflow prediction},
journal = {Journal of Hydrology},
volume = {680},
pages = {136474},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136474},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015714},
author = {Zhonghui Guo and Dehua Mao and Chang Feng and Ting Wang and Yishu Li},
keywords = {Distributed streamflow prediction, Graph-based interpretation, Grid-based SWAT, GraphSAGE-BiLSTM, Grid-informed physics-guided graph deep learning, Hybrid hydrological modelling},
abstract = {Watershed refined management requires accurate, spatially explicit, and physically interpretable frameworks for distributed daily streamflow prediction. However, process-based models (PBMs) may be constrained by structural assumptions and parameterized process representations, whereas data-driven models (DDMs) often lack physical consistency and hydrologically interpretable spatial dependencies. We developed a Grid-informed Physics-Guided Graph Deep Learning (GPGDL) framework that integrates GSWAT-derived hydrological representations with a GraphSAGE-BiLSTM model. GSWAT, a grid-based implementation of the Soil and Water Assessment Tool (SWAT), provides grid-resolved upstream–downstream routing for constructing a weighted directed hydrological graph, together with process information for the gauging-station nodes. The framework was evaluated for multi-site daily streamflow prediction at 15 gauging stations in the Xiangjiang River Basin. The residual-learning configuration implemented within GPGDL achieved the best overall testing performance among the evaluated benchmark and ablation models. Its testing-period mean Nash–Sutcliffe efficiency (NSE) and coefficient of determination (R2) values were 0.754 and 0.771, respectively. Additional diagnostic experiments comparing GSWAT- and SWAT-based guidance showed that framework performance was jointly influenced by the quality of simulated intermediate hydrological information and the corresponding spatial graph representation. Graph-based interpretation (node, edge, and feature levels) indicated that streamflow prediction relied on a compact and hydrologically meaningful subgraph concentrated in the mid- to upper-basin region, and that the learned spatial dependencies were consistent with the basin’s confluence structure and runoff-routing processes. Overall, the proposed GPGDL framework demonstrates that grid-informed PBM-derived topological priors and hydrological process variables can serve as structured knowledge for graph deep learning, providing a promising pathway for coupling PBMs with DDMs and advancing physics-guided deep learning for interpretable watershed prediction.}
}
@article{DING2026136482,
title = {Anthropogenic activities dominate dissolved organic matter dynamics via direct rather than nutrient-mediated pathways in a karst river},
journal = {Journal of Hydrology},
volume = {680},
pages = {136482},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136482},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015799},
author = {Yuekai Ding and Jing Zhang and Rui Liu and Maofei Ni and Weihua Yuan},
keywords = {Dissolved organic matter, Anthropogenic activities, Karst river, Seasonal variation},
abstract = {As a major reactive carbon pool in aquatic ecosystems, dissolved organic matter (DOM) is highly sensitive to anthropogenic disturbances. However, the specific anthropogenic pathways regulating DOM dynamics remain poorly constrained, particularly in environmentally sensitive karst river systems. Here, we combined optical characterization with partial least squares path modeling to disentangle the seasonal linkages between anthropogenic activities and riverine DOM dynamics. We show that anthropogenic activities influenced DOM primarily through direct inputs, deviating from the nutrient-mediated pathways commonly reported in non-karst rivers. This dominance persisted across seasons despite substantial variability in nutrient conditions. Notably, population was associated with increased DOC and enhanced DOM humification, whereas mines were associated with DOC and chromophoric DOM enrichment, revealing that anthropogenic organic carbon in karst rivers may be propagated primarily through transport rather than nutrient-driven transformation. Building on this pattern, we propose a conceptual segmented DOM accumulation–consumption framework, in which direct anthropogenic inputs favor DOM preservation and accumulation, whereas stronger nutrient-mediated regulation promotes DOM transformation and consumption. Our findings highlight that anthropogenic activities should be explicitly considered as key regulators of carbon fate in karst river systems.}
}
@article{XUE2026136458,
title = {Ecological-priority multi-objective water allocation under hydrological and restoration scenarios in the Heihe River Basin},
journal = {Journal of Hydrology},
volume = {680},
pages = {136458},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136458},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015556},
author = {Lianqing Xue and Hongcong Guo and Yuanhong Liu and Youjia Zhang and Guang Yang and Shushan Li},
keywords = {Inland rivers in Northwest China, Water allocation, Ecological restoration, Socio-economic-environmental benefits, Carbon emissions},
abstract = {Water scarcity in arid inland river basins requires allocation strategies that reconcile downstream ecological restoration with intensive socioeconomic water use in midstream regions. This study developed an ecological-priority, scenario-constrained multi-objective water allocation framework for the middle and lower reaches of the Heihe River Basin. Three downstream ecological restoration levels (L1–L3) were combined with dry, normal, and wet hydrological conditions derived from Pearson Type Ⅲ frequency analysis to construct nine hydrological–ecological scenario boundaries. Yingluoxia runoff and local Zhangye precipitation were treated as independent hydrological inputs, defining midstream surface-water availability and agricultural effective rainfall, respectively. Scenario feasibility was screened using sectoral water-use quotas, a 29.32% agricultural water-saving target, effective rainfall utilization, and a groundwater-abstraction limit of 3.93 × 108 m3. An ecological–social–natural benefit-conversion and multi-criteria evaluation module was subsequently coupled with NSGA-Ⅲ to maximize comprehensive benefits while minimizing allocation-related carbon emissions and water-shortage rates within the feasible scenario space. The ecological release required at Zhengyixia increased to 11.59 × 108 m3 under L3, approximately 22% higher than under L1, thereby reducing the surface water available for midstream allocation. Conventional supply conditions were insufficient to satisfy peak irrigation demand, whereas improved irrigation efficiency and effective rainfall substantially reduced agricultural demand and residual groundwater dependence. Under the groundwater constraint, P1, P8, and P9 were retained as representative feasible scenario boundaries for dry, normal, and wet conditions, with groundwater requirements of 3.62, 2.43, and 0.33 × 108 m3, respectively. These scenarios represent feasible water-supply boundaries rather than final allocation solutions. Within each boundary, NSGA-Ⅲ generated non-dominated solution sets, from which representative compromise allocations were selected using normalized ideal-point distance and final constraint verification. Sensitivity analysis indicated that dry-condition feasibility was particularly vulnerable to reduced irrigation performance, while objective-ablation analysis showed that excluding the carbon objective shifted compromise selection toward higher-emission allocations. The framework provides a case-specific decision-support basis for coordinating ecological restoration, water-use benefits, shortage risk, and allocation-related carbon emissions in arid inland river basins with comparable water-management conflicts.}
}
@article{KAUR2026136434,
title = {Leveraging deep learning and kernel density representations for transformation-based regional flood frequency analysis},
journal = {Journal of Hydrology},
volume = {680},
pages = {136434},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136434},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015313},
author = {Sukhsehaj Kaur and Sagar Rohidas Chavan},
keywords = {Deep learning, Kernel density estimator, Regional flood frequency analysis, Regional goodness-of-fit test},
abstract = {This paper leverages deep learning (DL) and kernel density representations to determine design flood estimates at ungauged or sparsely gauged sites through transformation-based regional flood frequency analysis (T_RFFA) approach. A critical preliminary step in conventional RFFA approaches is to identify an appropriate regional frequency distribution through an effective regional goodness-of-fit (GOF) test. However, conventional regional GOF tests involve sample mean–based normalization of at-site peak flow data, which can violate key assumptions of RFFA. To address this, the proposed method reformulates regional GOF test as a classification problem wherein peak flow data from each site are transformed into a dimensionless space using mathematical transformations. Kernel density estimator (KDE) plots are then generated and used as inputs to a pre-trained Deep Neural Network (DNN) classifier that selects the most suitable regional distribution among the five widely recognized peak flow distributions, viz., Generalized Extreme Value, Generalized Pareto, Generalized Logistic, Generalized Normal, and Pearson Type 3 distributions. The DNN classifier achieved classification accuracies of 95.09% and 94.86% on training and test datasets, respectively. The effectiveness of the proposed DL-based RFFA approach is evaluated through Monte Carlo simulation experiments and real-world applications to catchments in the United States and peninsular India. Results demonstrate that the proposed approach yields comparable or better design flood estimates relative to conventional T_RFFA approach. Furthermore, the proposed DL-based GOF test is observed to be approximately 18 to 27 times faster than the conventional L-moment-based approach, offering a computationally efficient and robust alternative for RFFA.}
}
@article{ZHU2026136485,
title = {AnytimeHydroTwin: A deployment-valid inference-orchestration layer for AI-driven hydrological digital twins},
journal = {Journal of Hydrology},
volume = {680},
pages = {136485},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136485},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015829},
author = {Yue Zhu and Qingyang Liu},
keywords = {Hydrologic digital twins, AI-driven inference orchestration, Deployment-valid causal routing, Adaptive computation, Dynamic fidelity allocation, Water-quality nowcasting, Tidal-estuarine sensors},
abstract = {When does a water-quality nowcast need a process-resolving model, and when is the previous observation enough? Across eleven regimes on three tidal-estuarine systems, the answer is set by the signal, not the model. Estuarine pH and dissolved oxygen are persistence-dominated everywhere (lag-1 autocorrelation ρ1=0.978–0.9998): a high-fidelity (HF) neural nowcaster beats the previous observation in none of the nine such regimes. Only Sacramento Delta 15-min turbidity genuinely decorrelates (ρ1=0.819), reflecting episodic sediment resuspension, and it alone rewards HF (ΔNSE=0.158). Variability is not the discriminant—the two highest-variance regimes are persistence-dominated—giving an operational screen: above ρ1≈0.99, an expensive nowcaster will not repay its compute. We exploit this with AnytimeHydroTwin, an inference-orchestration layer rather than a full digital twin, whose deployment-valid pre-HF causal gate reads only observations available before the HF forward pass, so a skipped HF call is a real compute saving, not a post-hoc blend ratio. The gate is itself paid every step: an HF-invocation rate is not a compute saving, and we account for it in full. Our headline is a leakage-clean nested-split evaluation on Sacramento turbidity—NSE parity with HF-only, ΔKGE=+0.020 at 3.15% HF, an estimated +31% to +80% end-to-end wall-clock saving from measured component latencies—closed for the two LSTM headline regimes, open for the TCN stress case and ancillary CAMELS variant. On the nine persistence-dominated regimes it safely defers to lag-1 ≥95% of the time. This regime classification is robust across the three backbone families we evaluate (TCN, LSTM and Transformer): the structure reflects the signal more than the learner.}
}
@article{JING2026136343,
title = {Decoding dissolved oxygen dynamics using ensemble machine learning models: insights across multi-regional rivers},
journal = {Journal of Hydrology},
volume = {680},
pages = {136343},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136343},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601440X},
author = {Wang Jing and Ali Omran Al-Sulttani and Raad Z. Homod and Ricky Anak Kemarau and Sajjad {Firas Abdulameer} and Iliass Naouadir and Omer A. Alawi and Billel Salhi and Mehvish Bilal and Zaher Mundher Yaseen},
keywords = {Dissolved oxygen, Ensemble machine learning, River water quality, Multi-regional modeling},
abstract = {Dissolved oxygen (DO) is a key indicator of river water quality (RWQ) as it reflects aquatic ecosystem health, microbial and biological activity, and the balance of physicochemical processes within river systems. The study evaluates ensemble machine learning (ML) models to predict DO in the Brisbane River (Australia), the Piabanha River (Brazil), and two river systems in Hong Kong. Random Forest (RF), Extreme Gradient Boosting (XGBoost), Light Gradient-Boosting Machine (LightGBM), Extra Trees (ET), and Gradient Boosting Decision Trees (GBDT) models were developed using hierarchical feature combinations to assess model robustness under varying input dimensionality. Results indicated that the RF model achieved the best generalization performance for the Australian dataset, with a coefficient of determination (R2 = 0.87) during the testing phase, whereas the ET model achieved the best performance in Brazil (R2 = 0.95). In the case of Hong Kong, the ET model achieved the highest performance (R2 = 0.94) at Pai Min Kok, whereas the LightGBM model showed consistent performance at Kai Tak River (R2 = 0.85–0.86). Further, research results indicated that complete multivariate predictor sets generally improved ML model prediction accuracy. Overall, the ensemble models effectively captured the nonlinear variability of DO across diverse river systems, demonstrating their potential for data-driven river water quality assessment and prediction.}
}
@article{YANG2026136430,
title = {A knowledge-constrained improved Mean Flow method for planar sedimentary facies interpretation},
journal = {Journal of Hydrology},
volume = {680},
pages = {136430},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136430},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015271},
author = {Xu Yang and Shaoqun Dong and Xu Bai and Junkun Quan and Tao Xu and Sai Yao and Lianbo Zeng and Mingxuan Han and Naiyang Sun and Huangshuai Kong},
keywords = {Sedimentary facies interpretation, improved Mean Flow, Data-driven, Knowledge-constrained, Anisotropic variogram},
abstract = {Planar sedimentary facies interpretation conditioned on well data remains challenging because the limited spatial coverage of wells makes lateral continuity difficult to preserve. To address this, a knowledge-constrained improved Mean Flow (K-iMF) method is proposed, integrating data-driven velocity-field learning, variogram-regularized training, and variogram-guided candidate selection. Multi-directional variogram discrepancies regularize velocity-field learning during training. During inference, the fixed U-Net maps independently sampled latent variables in parallel and retains the candidate with the lowest discrepancy score. The method was evaluated on a fluvial facies dataset from the Hailar River system and a delta-front microfacies dataset from the Songliao Basin. Among the evaluated methods, K-iMF achieved the highest accuracy and F1-score on both datasets. Relative to iMF, K-iMF increased accuracy from 95.7% to 97.0% and F1-score from 90.9% to 93.8% on the fluvial dataset. On the delta-front dataset, accuracy increased from 84.5% to 88.8% and F1-score from 67.2% to 77.4%. The anisotropic variograms more closely reproduced the reference ranges and sills, while pixel-wise variance remained non-zero along facies boundaries, indicating that spatial consistency was improved without collapsing the stochastic realizations. Compared with the diffusion model, K-iMF achieved higher predictive performance while requiring less than 1/290 of its testing time. In blind well tests, the method achieved accuracies of 80% and 78% for the two datasets, respectively. Predictive performance improved and variability decreased as the number of conditioning wells increased, with both trends more pronounced for the delta-front dataset. Overall, K-iMF improves predictive performance and directional spatial consistency while retaining stochastic variability and efficient inference.}
}
@article{CHENG2026136422,
title = {A graph-based surrogate modeling framework for large-scale spatial optimization of low-impact development layouts in urban pluvial flood mitigation},
journal = {Journal of Hydrology},
volume = {680},
pages = {136422},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136422},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015192},
author = {Qiming Cheng and Jiayue Zhu and Ye Rao and Zhen Liu and Fei Liu and Yixin Mu and Kaifeng Wang and Yao Chen},
keywords = {Urban pluvial flood, Low-impact development, Spatial allocation optimization, Graph neural networks, Surrogate modeling, Large-scale multi-objective optimization},
abstract = {The increasing frequency of extreme weather events, coupled with anthropogenic modifications to urban land surfaces, has significantly exacerbated urban flooding. Low-impact development (LID) strategies have therefore been widely advocated as a primary approach for mitigating urban pluvial flood, the effectiveness of which highly dependents on the spatial layout of LID facilities and their construction costs. However, this multi-objective optimization approach faces formidable challenges. Existing approaches to LID spatial allocation optimization often fail to effectively balance cost-benefit heterogeneity across diverse configurations and become computationally intractable when applied to urban drainage systems characterized by numerous sub-catchments, complex hydraulic network topologies, or both. To address these challenges, we propose the GraphicSWMM framework, a deep learning surrogate model driven by real-world physical priors. Trained via an end-to-end architecture, this framework integrates a novel sampling strategy with advanced dimensionality reduction techniques. These methodological innovations collectively alleviate the dimensionality bottlenecks inherent in large-scale spatial optimization tasks. Empirical validation across two real-world urban regions confirms that GraphicSWMM consistently outperforms existing approaches and exhibits potential for transferability to regions with different climatic conditions. In urban catchments characterized by high-resolution drainage networks and constrained budgets, the proposed model achieves a 481.1-fold acceleration in computational efficiency compared to conventional workflows, while simultaneously reducing flood discharge volumes by 45.0% and inundation areas by 38.3%. This framework serves as a robust decision-support tool that balances flood mitigation performance with construction costs, facilitating more resilient urban drainage systems.}
}
@article{TAO2026136433,
title = {Land-use regulation of coupled carbon–nitrogen–phosphorus cycling and carbon-sink stability in karst surface water–groundwater systems: synthesis from the Shawan water–carbon cycle experimental test site, SW China},
journal = {Journal of Hydrology},
volume = {680},
pages = {136433},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136433},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015301},
author = {Pan Tao and Mingyu Shao and Sibo Zeng and Zaihua Liu and Qian Bao and Yikun Jia and Mohamed Aboueldahab and Hailong Sun and Liangxing Shi and Min Zhao and Xu Wang and Junyao Yan and Hang Li and Yirun Zhang},
keywords = {Surface water–groundwater interface, Land-use change, Coupled C–N–P cycling, Biological carbon pump, Carbon sink, Eutrophication risk},
abstract = {Karst inland waters receive substantial inputs of weathering-derived dissolved inorganic carbon (DIC), which can support aquatic primary production and the formation of autochthonous organic carbon. However, how land-use change alters the coupled delivery of DIC, nitrogen, and phosphorus, thereby regulating carbon sequestration potential and eutrophication risk, remains poorly understood. Here, we review previous studies and long-term observations from the Shawan Water–Carbon Cycle Experimental Test Site in Southwest China to evaluate how contrasting land-use types regulate coupled C–N–P cycling in karst aquatic systems. We propose a mechanistic framework linking land use, soil CO2 production, carbonate weathering, DIC export, nutrient stoichiometry, aquatic biological uptake, and sedimentary carbon–phosphorus preservation. The synthesis indicates that bare rock and bare soil systems generally have weak carbon-sink potential because limited vegetation cover reduces soil CO2 production, carbonate weathering, DIC delivery, and aquatic productivity. Cropland, in contrast, often increases nitrogen and phosphorus export disproportionately relative to effective inorganic carbon supply, promoting phytoplankton proliferation, cyanobacterial risk, and less efficient carbon preservation. Ecological restoration, especially grassland and shrubland recovery, can enhance soil CO2 generation and carbonate weathering while reducing nutrient export, creating high-DIC but relatively nutrient-constrained conditions. Under suitable hydrological and light conditions, this favors submerged macrophytes, epiphytic algae, and non-cyanobacterial autotrophs, thereby strengthening biological DIC utilization, autochthonous organic carbon production, phosphorus immobilization, and sedimentary carbon burial. Overall, land-use change regulates karst aquatic carbon sinks not only by altering DIC export but also by reshaping C–N–P stoichiometry and biogeochemical pathways across the land–water continuum. These findings highlight ecological restoration as a potential strategy to coordinate carbon sink enhancement with eutrophication control in karst waters. Future studies should integrate replicated mesocosm experiments, natural-water validation, and long-term regional monitoring to determine how land-use-driven C–N–P coupling regulates the transformation and long-term preservation of weathering-derived DIC in aquatic carbon pools after accounting for remineralization and CO2/CH4 losses.}
}
@article{HOUENAFA2026136449,
title = {S-GRHyMoLAP: A stochastic extension of the GRHyMoLAP model with different diffusion mechanisms for probabilistic rainfall-runoff modeling},
journal = {Journal of Hydrology},
volume = {680},
pages = {136449},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136449},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015465},
author = {Sianou Ezéckiel Houénafa and Lionel Cédric Gohouede and Romuald Daniel Boy-ngbogbele and Melissa Latella and Olatunji Johnson and Cenk Sezen},
keywords = {Watershed hydrology, Uncertainty, Interaction-driven diffusion, S-GRHyMoLAP, SHAP},
abstract = {Probabilistic rainfall-runoff modeling in watershed hydrology is strongly affected by uncertainties in inputs, model structure, parameters, and their potential interactions. In this study, we investigate alternative representations of these uncertainties by extending the recently released GRHyMoLAP into S-GRHyMoLAP, a stochastic differential equation (SDE) formulation with hydrologically motivated diffusion mechanisms. The proposed framework represents uncertainty through input-driven, internal-state-driven, and flow-driven diffusion formulations, while additionally introducing an input-state interaction-driven diffusion formulation. Evaluation across 526 catchments from the Catchment Attributes and Meteorology for Large-sample Studies-France (CAMELS-FR) dataset shows that input-driven diffusion provides the best probabilistic representation among the single-variable diffusion formulations, while the interaction-driven diffusion performs best in 70% of catchments. The framework matches the predictive interval score of the heteroscedastic Gaussian residual (HGR) benchmark method for GRHyMoLAP, while outperforming it for the Génie Rural à 4 Parameters (GR4J). Explainable machine learning combining Extreme Gradient Boosting (XGBoost) and SHapley Additive exPlanations (SHAP) reveals that, although the major catchment predictors are similar across diffusion formulations, their relative influence depends on the considered diffusion. The input-driven diffusion formulation favors catchments with strong hydroclimatic forcing, while the interaction-driven formulation remains sensitive to external factors and exhibits enhanced responsiveness to internal flow organization. These findings indicate that incorporating an interaction-driven diffusion formulation can improve probabilistic streamflow prediction and highlight the potential of S-GRHyMoLAP for investigating how uncertainty propagates through rainfall–runoff dynamics.}
}
@article{DING2026136501,
title = {Joint prediction of river discharge and suspended sediment load through a physics-informed capacity-supply decomposition framework},
journal = {Journal of Hydrology},
volume = {680},
pages = {136501},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136501},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015982},
author = {Can Ding and Shicheng Li and Nanbo Tang and Zhong Tian},
keywords = {River discharge, Suspended sediment load, Joint prediction, Capacity-supply decomposition, Physics-informed framework},
abstract = {River discharge (RD) and suspended sediment load (SSL) are inherently coupled in river systems, yet existing data-driven models often fail to explicitly represent their physical linkage, which limits physical interpretability and may reduce robustness under extreme conditions. To address this issue, this study proposes a physics-informed capacity-supply decomposition (PCSD) framework for joint prediction of RD and SSL. The key idea is to reformulate SSL prediction as a sequential decomposition problem, in which sediment load is expressed as the product of a discharge-dependent transport-capacity term and a supply-related modulation term. In this way, RD prediction and SSL prediction are linked within a physically meaningful sequential structure. To further enhance physical consistency, several constraints were incorporated into the framework, including monotonic constraints in the RD branch, as well as discharge-sediment envelope, low-flow threshold, and proxy-supervision constraints in the sediment branch. The framework was evaluated in the Beijiang River Basin, China, using daily hydro-meteorological data from 1991 to 2010, and was compared against several benchmark data-driven models. Results showed that the proposed framework maintained high RD prediction accuracy while achieving the best point-estimate performance for SSL among the evaluated models. For one-step SSL prediction, PCSD achieved the best overall performance, with RMSE, NSE, R2, and KGE of 195 kg/s, 0.89, 0.90, and 0.94, respectively. Its advantage was especially evident under extreme flood conditions, where it reproduced major sediment peaks more accurately than all benchmark models. Additional multi-lead-time experiments showed that PCSD retained SSL prediction skill across 1–7-day forecasting horizons and consistently outperformed decomposition-based and conventional data-driven benchmarks. These results suggest that the proposed decomposition framework provides a physically interpretable approach with strong predictive performance for coupled hydro-sediment prediction.}
}
@article{BRASIL2026136380,
title = {A digital twin framework for real-time probabilistic forecasting of permeable pavement performance},
journal = {Journal of Hydrology},
volume = {680},
pages = {136380},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136380},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014770},
author = {Jose Brasil and Marcus Nóbrega {Gomes Jr.} and Drew W. Johnson and Athanassios T. Papagiannakis and Eduardo Mario Mendiondo and Marcio Hofheinz Giacomoni},
keywords = {Digital twin, Data assimilation, Permeable pavement, Low-impact development},
abstract = {Low Impact Development (LID), such as permeable pavements, mitigates some of the urban runoff effects. Their hydrologic response can be enhanced with real-time forecasting and management. Digital Twins (DT), which integrate physical models with sensor data, offer a solution, yet require methods to handle uncertainties in model inputs and observations. This study presents a DT framework for permeable pavement systems that couples a one-dimensional, explicit-state hydrologic model with a Particle Filter (PF) data assimilation scheme. The framework assimilates real-time underdrain outflow observations to refine model states and provide probabilistic forecasts. Uncertainty characterization revealed that sensor measurement error depends on the underdrain outflow, while rainfall forecast error from the High-Resolution Rapid Refresh model is a function of the magnitude of the rainfall event. The DT framework was evaluated against a baseline model using field data from four permeable pavement types. The data assimilation approach reduced the ensemble forecast error by an average of 20%, as measured by the Continuous Ranked Probability Skill Score (CRPSS), with positive skill scores in 96.2% of forecast events. The deterministic performance of the PF ensemble median, evaluated by Nash-Sutcliffe Efficiency (NSE) and Root Mean Square Error (RMSE), also exceeded that of the baseline model. The data assimilation framework yielded more accurate forecasts than a deterministic modeling approach and is computationally efficient for operational deployment. However, outflow forecast accuracy is constrained by the structural limitations of the baseline model, evidenced by poor prediction interval coverage during some high-intensity events, highlighting areas for future model development.}
}
@article{DING2026136441,
title = {Assessing future soil erosion responses to freeze–thaw cycle representation in SWAT in the seasonally frozen Songhua River watershed},
journal = {Journal of Hydrology},
volume = {680},
pages = {136441},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136441},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015386},
author = {Beibei Ding and Siying Huangyi and Junyu Qi and Srinivasulu Ale and Puyu Feng and De Li Liu and Raghavan Srinivasan and Yong Chen},
keywords = {Freeze-thaw cycles, Cold-region hydrology, Future climate change, SWAT-FT, Soil and water conservation},
abstract = {Freeze-thaw cycles (FTCs) significantly contribute to the hydrological cycle and soil erosion in a seasonally frozen watershed in northeastern China, making their representative simulation essential. An enhanced Soil and Water Assessment Tool with a physically-based FTCs module (SWAT-FT) was applied to comprehensively investigate the impacts of future climate change on soil hydrothermal dynamics and soil erosion in the Songhua River watershed in northeastern China. The results demonstrated that SWAT-FT substantially improved soil temperature simulation throughout the year compared to the original SWAT, particularly during the freeze–thaw season. SWAT-FT simulated more realistic liquid soil water content (3-7 percentage points lower than the original SWAT) and consistently better streamflow performance during March to June. Unlike the original SWAT model, which uses a simple empirical soil temperature equation, SWAT-FT represents the insulation effect of snow cover and the soil water-phase changes during the freeze–thaw process, which is the reason for the improvements. These improvements further led to large differences in simulated hydrological and erosion responses. Consequently, the SWAT-FT model predicted substantially lower surface runoff (55%-57%) and soil erosion (34%-70%) than the original SWAT during the freeze–thaw season. Relative to the historical period, future global warming was projected to exacerbate soil and water loss, with the SWAT-FT model forecasting a 51% to 66% increase in surface runoff and a 91% to 292% increase in soil erosion under three SSP scenarios by the end of the 21st century. Overall, SWAT-FT provided a more physically based representation of soil hydrothermal dynamics and runoff partitioning, which in turn modified the MUSLE-based soil erosion estimates, thereby enhancing its applicability for soil and water conservation policymaking in cold regions worldwide.}
}
