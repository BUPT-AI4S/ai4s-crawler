@article{LUAN2026136469,
title = {Stomatal conductance dominates land surface hydrological responses to rising CO2 concentrations in the Yellow River Basin},
journal = {Journal of Hydrology},
volume = {680},
pages = {136469},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136469},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015660},
author = {Jinkai Luan and Ning Ma and Jun Ge and Fengxue Gu and Yunfei Wang and Wei Li and Qingyu Jia and Yuanyuan Yang and Hua Li and Zhihui Wang and Zhiguo Yu},
keywords = {Atmospheric CO concentration, Stomatal conductance, Vegetation structure, Evapotranspiration, Runoff, Yellow River Basin},
abstract = {Rising atmospheric CO2 concentrations are known to perturb the terrestrial hydrological cycle, yet the relative roles of CO2-driven vegetation physiological and structural change in shaping land surface hydrology remain unclear. Here we use a process-based ecohydrological model to quantify how these two pathways modulate evapotranspiration (ET) and runoff (Q) across the Yellow River Basin (YRB) in northern China. We show that CO2-induced stomatal conductance (ΔETstomata and ΔQstomata) and vegetation structure (ΔETstructure and ΔQstructure) reductions suppress ET but enlarge runoff, while the impact of changes in stomatal conductance is substantially greater than that of structural modifications. By contrast, their interaction increases ET (ΔETinteraction) and decrease runoff (ΔQinteraction). Within the controlled CO2-sensitivity experiments, the LAI-mediated contribution to ET change was substantially smaller than the fixed LAI physiological contribution. Basin-wide sensitivity analysis indicates that a 100 ppm increase in atmospheric CO2 reduces ET by ∼6.7 mm, primarily due to a ∼7.6 mm reduction in ΔETstomata, with a marginally offset (<1 mm) from decreased ΔETstructure and 1.8 mm increase in ΔETinteraction. Runoff showed a comparable but opposite sensitivity, dominated by the stomatal conductance component. The influence of increasing CO2 on hydrological variables varies substantially in space, with larger effects in the southeastern YRB than in the northwestern and western regions, and across ecosystem types, with the highest and the lowest sensitivities occurring in forests and deserts, respectively. By explicitly separating plant physiological and structural effects, our results clarify the pathways by which rising CO2 reshapes hydrological processes in a typical dryland basin, providing valuable insights for reducing uncertainty in water resource projections across semi-arid and arid regions.}
}
@article{ROSTAMI2026136412,
title = {Coupled thermal-hydraulic model of the continental subsurface: theory, regimes, and reduced solver},
journal = {Journal of Hydrology},
volume = {680},
pages = {136412},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136412},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601509X},
author = {Masoud Rostami and Bijan Fallah and Farahnaz Fazel-Rastgar and Li-Yun Fu},
keywords = {Coupled thermal-hydraulic model, Extended Richards equation, Enthalpy-based freeze-thaw, Dimensionless numbers, Regime diagrams, Permafrost hydrology},
abstract = {The thermal regime of the continental subsurface is shaped by the interplay of atmospheric forcing, groundwater flow, and solid Earth heat. While many existing models couple groundwater flow and heat transport, and in some cases incorporate freeze-thaw or thermo-hydro-mechanical processes, representing the full spectrum of two-way feedbacks often remains challenging. This paper has two components and keeps them distinct throughout. The first is theoretical: a continuum formulation that explicitly couples two-way thermal-hydraulic feedback with a smooth freeze-thaw treatment. From first principles, we derive the governing equations for mass and energy and perform a scaling analysis that yields nine dimensionless numbers, including a newly identified thermal-hydraulic coupling metric (ΓNα). These numbers quantify the competition between pressure diffusion, saturation storage, thermal expansion, conduction, advection, and latent heat, and they define quantitative regime diagrams for the three interfaces (land surface, subsurface, crust-mantle). We reduce the full three-dimensional system to a closed one-dimensional vertical column suitable for basin-scale applications. The second component is a reduced thermal-hydraulic numerical implementation, narrower than the theory. This open-source finite-volume solver (implicit time stepping, upwind advection, apparent-heat-capacity freeze-thaw) carries the thermal-expansion feedback, Darcy advection and freeze-thaw, but omits the phase-change mass source, the poroelastic porosity evolution, the skeleton momentum balance, and the gas phase. The solver reports its own mass- and energy-budget residuals, and those diagnostics show that the omitted source is a first-order wherever the freezing point is crossed. The solver is cross-verified against an independent finite-difference Crank-Nicolson code and passes six analytical benchmarks (Carslaw-Jaeger, Stefan, Theis, Terzaghi, undrained thermo-poroelastic ratio, Bonacina), most of which are operator verifications. Four canonical 1-D case studies (permafrost, geothermal reservoir, arid basin, thermo-poro coupled) demonstrate consistency between the designed inputs and the proposed theoretical classification, and a 2-D extension explores lateral basin recharge-discharge and permafrost edge effects. The open-source solver, within its applicability domain, equipped with a test suite and conservation diagnostics, provides a computational tool for attributing subsurface thermal anomalies to their physical drivers and for projecting future thermal evolution under changing environmental conditions.}
}
@article{ZHU2026136453,
title = {Spatial heterogeneity and drivers of PFASs distribution in an arid-semiarid city waters system},
journal = {Journal of Hydrology},
volume = {680},
pages = {136453},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136453},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015507},
author = {Xuemei Zhu and Wenjing Sun and Ying Sun and Xiaotao Fu and Bing Sun and Yihan Li and Changwei Lü and Shenghu Zhang and Xin Wang and Chengmei Liao},
keywords = {PFASs, arid and semi-arid cities, spatial heterogeneity, ecological risk, Yellow River Basin},
abstract = {Investigating the occurrence of emerging per- and polyfluoroalkyl substances (PFASs) in diverse urban surface water bodies of Hohhot, a representative arid and semi-arid city, is essential for understanding their environmental behavior and potential ecological risks under water-scarce conditions. This study systematically characterized the occurrence, spatial distribution, compositional profiles, and environmental factors associated with the spatial heterogeneity of PFASs. The concentrations of ΣPFASs exhibited pronounced spatial heterogeneity (6.3–81.4 ng/L), with elevated levels observed in water bodies more strongly influenced by anthropogenic activities. PFASs compositional profiles differed among water body types, with short-chain PFASs constituting a substantial proportion of the overall PFASs composition. Long-chain PFASs nevertheless remained widely detectable across the studied waters. PFASs covaried with multiple hydrochemical characteristics, but these associations weakened after accounting for functional water-body type, highlighting water-body differentiation as an important context for PFASs spatial heterogeneity. Despite the higher concentrations of short-chain PFASs in several water bodies, ecological risk was primarily associated with residual long-chain PFASs, particularly perfluorooctanoic acid (PFOA) and perfluorooctanesulfonic acid (PFOS). Collectively, these findings highlight the need for source-oriented monitoring and region-specific PFASs management in arid–semi-arid urban watersheds, while the potential influence of hydroclimatic conditions requires quantitative hydrological validation.}
}
@article{LUO2026136445,
title = {Moderate litter biomass benefits soil water replenishment in semiarid grasslands},
journal = {Journal of Hydrology},
volume = {680},
pages = {136445},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136445},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015428},
author = {Yang Luo and Kemiao Li and Jie Zhang and Bingcheng Xu},
keywords = {Loess Plateau, Runoff, Infiltration, Standing litter, Simulated rainfall},
abstract = {Litter plays a crucial role in rainfall redistribution and hydrological cycles, and understanding its hydrological effects is of great significance for ecological management and restoration. Decades of vegetation restoration on the Loess Plateau have resulted in accumulated litter, which has further influenced regional ecohydrology and sustainable grassland restoration. To elucidate grassland litter interception capacity and its role in regulating runoff and infiltration, plot-scale experiments were conducted using immersion and simulated rainfall (10, 20, and 40 mm) methods. Three ground litter types (Bothriochloa ischaemum, Stipa bungeana, and Artemisia gmelinii) and the standing litter of A. gmelinii were evaluated across four biomass gradients (0, 100, 200, and 300 g m−2). The results showed that the interception capacity quantified via simulated rainfall was 2.54 to 6.82 times higher than that of immersion method. Litter type, biomass, and rainfall amount significantly influenced the proportion of interception, runoff, and infiltration. Ground litter of A. gmelinii exhibited significantly higher interception and infiltration proportions than B. ischaemum and S. bungeana. As litter biomass increased, the interception proportion rose consistently, whereas the soil infiltration proportion increased initially, then decreased. Increases in rainfall amount were partitioned mainly into the proportion of surface runoff. Litter thickness was the strongest predictor of interception, whereas soil bulk density and initial soil water storage were the main predictors of runoff and infiltration. Among the tested levels, approximately 100 g m−2 produced the greatest soil water replenishment, whereas higher biomass increased litter interception. These findings suggest that litter accumulation during long-term restoration may reduce effective rainfall and that maintaining moderate litter biomass could improve soil water replenishment in semiarid grasslands.}
}
@article{XU2026136497,
title = {Partitioning groundwater and porewater reveals seasonal controls on nutrient export to a chronically eutrophic bay},
journal = {Journal of Hydrology},
volume = {680},
pages = {136497},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136497},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015945},
author = {Haowei Xu and Shibin Zhao and Natasha T. Dimova and Wen Liu and Disong Yang and Runze Zhang and Miaomiao Zhang and Shuyang Huang and Jianing Zhang and Sihui Liu and Tianyi Zhu and Xiaoyi Guo and Bochao Xu},
keywords = {Submarine groundwater discharge, Porewater exchange, Radium isotopes, Nutrient export, Intertidal aquifer, Jiaozhou Bay},
abstract = {Coastal eutrophication caused by excess nutrient inputs has increased worldwide. Of the nutrients sources to coastal ocean, benthic advective pathways, including large-scale submarine groundwater discharge (SGD) and centimeter-scale porewater exchange (PEX), remain the most uncertain relative to surface inputs such as rivers. In particular, the biogeochemical signatures and spatiotemporal variability of individual subsurface flows are poorly understood. Here, we present monthly field observations from January 2022 to April 2024 to assess seasonal dynamics of nutrient loading from different benthic advective processes and their ecological impacts in a chronically eutrophic semi-enclosed bay. We found that longer porewater residence times promoted ammonium and silicate accumulation, alongside the attenuation of nitrate and nitrite in the intertidal sandy aquifer. PEX dominated benthic advection, with enhanced water and solute fluxes during wet seasons driven by intensified hydrodynamic forcing and biological activity. Despite covering < 5% of the bay area, SGD and PEX together derived 12–48% of dissolved nitrogen and 0.5–20% of dissolved phosphorus relative to riverine inputs, while PEX alone supplied > 41% of dissolved silicate sources to the entire bay. By altering the magnitude and stoichiometry of nutrients, PEX and SGD exports likely exacerbate phosphorus deficiency. Partitioning the contributions of individual benthic advective pathways to long-term nutrient dynamics is key to mitigate coastal eutrophication.}
}
@article{XIE2026136348,
title = {Predicting root-zone soil moisture using a small sample deep learning approach},
journal = {Journal of Hydrology},
volume = {680},
pages = {136348},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136348},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014459},
author = {Yalin Xie and Jing Tian and Yongqiang Zhang and Xuanze Zhang and Longhao Wang and Haoshan Wei and Xian Wang and Zixuan Tang},
keywords = {Root-zone soil moisture, TabPFN, Regionalization, Data scarcity},
abstract = {Estimating root-zone soil moisture (RZSM) under sparse in-situ observations is closely related to the broader Prediction in Ungauged Basins (PUB) challenge. This study introduces a novel application of the Tabular Prior-data Fitted Network (TabPFN) for predicting RZSM using small sample sizes (fewer than 10,000) and evaluates its robustness under extreme data sparsity conditions. Using five-fold spatial cross-validation conducted at the grid-cell level, TabPFN was trained on sampled data, while the baseline models (RF, XGBoost, CatBoost and Tabular ResNet) were trained on both sampled and full datasets. All models were evaluated on full test sets to ensure a consistent benchmark. Our results indicate that under extremely sparse training conditions (one sample per grid), TabPFN achieves the highest prediction accuracy (R = 0.726 ± 0.002; RMSE = 0.069 ± 0.0004; MAE = 0.053 ± 0.0003), improving correlation by 2.5–9.2% and reducing prediction errors by 2.6–9.8% compared to benchmark models. In time-specific modeling, where separate models were constructed for each day, week, and month, its performance advantage was broadly maintained across changing hydro-climatic states and under consistent temporal aggregation. Its performance also remained relatively stable as training grid density decreased, including when fewer than 40% of the available training grids were used. These results demonstrate that TabPFN enables robust RZSM prediction using small samples and provides a practical tool for drought monitoring and water assessment in data-scarce or poorly monitored regions.}
}
@article{LIU2026136437,
title = {A dual post-processing framework for probabilistic streamflow forecasting using deep learning ensembles: Integrating residual correction and Vine Copula-based BMA},
journal = {Journal of Hydrology},
volume = {680},
pages = {136437},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136437},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015349},
author = {Wen-jie Liu and Zhong-kai Feng and Yang Xiao and Tie-sheng Guan and Tao Yang and Wen-jing Niu and Hong-wu Tang},
keywords = {Probabilistic streamflow forecasting, Dual post-processing, Residual correction, Ensemble probabilistic forecasting, Vine Copula-based BMA},
abstract = {Quantifying forecasting uncertainty and providing probabilistic streamflow forecasts are fundamental for flood and drought mitigation, reservoir operation, and water resources management. However, existing post-processing approaches usually address either residual error modeling or multi-model ensemble fusion, while few studies integrate them both. This study proposes a dual post-processing framework termed RC-VCBMA for multi-step probabilistic streamflow forecasting. To account for input, structural, and parameter‑related sources of ensemble diversity, ensemble forecast members are generated using GEFS forecast precipitation, three deep learning architectures, and multiple objective functions. A Mixture Density Network utilizing Countable Mixtures of Asymmetric Laplacians with LSTM backbone is then developed to generate time-varying mixture distributions of member-level hydrological residuals, enabling deterministic residual correction via the conditional expectation while capturing non-Gaussianity, autocorrelation, and heteroscedasticity. Building on the corrected members, a Vine Copula-based Bayesian Model Averaging method is further introduced to derive member-wise conditional posterior distributions by characterizing the three-dimensional dependence among baseline, observed, and forecast flows, and fuse them into an ensemble posterior distribution. The proposed framework is evaluated for 6-hourly multi-step inflow forecasting from 6 h to 48 h ahead for the Three Gorges Reservoir. Results show that compared with RC-HUPBMA, RC-VCBMA reduces WIS and CRPS by 15.3% and 13.5%, respectively. Compared with CMAL-DBMA, RC-VCBMA improves WIS and α_index by 8.1% and 6.8%, respectively, and reduces IGN by 3.713 on average, while remaining competitive in CRPS. Overall, RC-VCBMA achieves a favorable trade-off among distributional accuracy, interval sharpness, reliability, and predictive density concentration, highlighting its effectiveness as a probabilistic post-processing framework.}
}
@article{KIM2026136465,
title = {Multi-objective optimization of best management practices in agricultural watersheds using single-step deep reinforcement learning},
journal = {Journal of Hydrology},
volume = {680},
pages = {136465},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136465},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015623},
author = {Jinuk Kim and Byeongchan Yun and JongCheol Pyo and Li-Chi Chiang and Jin Hwi Kim and Kyeong Hwa Cho},
keywords = {Best management practices, Deep reinforcement learning, Soil and Water Assessment Tool, Non-dominated Sorting Genetic Algorithm Ⅱ, Watershed management, Nonpoint source pollution},
abstract = {Optimal placement and intensity of best management practices (BMPs) in watershed management needs balancing pollutant reduction with implementation cost. We proposed a deep reinforcement learning (DRL) framework for cost-aware, SWAT-based BMP implementation, applied to the Namyang estuarine reservoir watershed in South Korea. The framework jointly optimized continuous application intensities of four structural BMPs, vegetative filter strip (VFS), grassed waterway (GWW), terrace, and detention pond (DTP), across 31 subbasins in a single-step optimization environment. Three DRL algorithms and NSGA-Ⅱ were compared under an identical budget of 1,000 SWAT simulations. Among the algorithms, proximal policy optimization (PPO) achieved the highest final reward, approximately 66% and 68% higher than those of TD3 and SAC, respectively. The best PPO solution achieved 92.4% of the maximum attainable combined reduction of suspended sediments (10.2%) and total phosphorus (82.2%) at a cost of $5.02 million, corresponding to 9.6% of the full implementation cost, whereas NSGA-Ⅱ required $14.62 million to reach the same reduction level. Consequently, PPO was approximately 2.9 times more cost-efficient than NSGA-Ⅱ under the identical evaluation budget. Additionally, the learned PPO policy showed a spatially differentiated pattern. The VFS was broadly applied across the watershed, GWW was selectively combined with VFS in steeper subbasins, and DTP was concentrated in a single key subbasin. Thus, PPO-based DRL provides a cost-efficient and interpretable alternative to conventional multi-objective evolutionary optimization for direct SWAT-in-the-loop applications.}
}
@article{CHEN2026136460,
title = {Grid-based optimization for irrigation and water quality synergies},
journal = {Journal of Hydrology},
volume = {680},
pages = {136460},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136460},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601557X},
author = {Yingshan Chen and Qiang Fu and Vijay.P. Singh and Yijia Wang and Zhaoqiang Zhou and Yaowen Xu and Luchen Wang and Mo Li},
keywords = {Economy-environment synergy, Distributed non-point source pollution simulation, Crop growth simulation, Water optimization modelling, Climate change, Simulation-optimization of spatial grid},
abstract = {Water scarcity and agricultural non-point source pollution increasingly challenge irrigation management under climate change, yet existing approaches rarely capture climate-driven pollutant transport and spatially heterogeneous irrigation needs. We develop a grid-scale simulation–optimization framework coupling SWAT, DSSAT, and a cellular automata-based multi-source irrigation model, and apply it to the Sanjiang and Songnen Plains to assess water-saving and pollution-reduction synergies under current and future climates. Results show that optimal irrigation strategies vary markedly among regions because of spatial differences in pollutant emissions and water-use efficiency. Overall, optimized water-saving irrigation reduces pollutant emissions by approximately 12.96% and irrigation water use by 24.57%. In western regions, a 49.25% expansion of water-saving irrigation improves the coordination among economic, environmental, and water-resource objectives by 33.07%. Under future climate scenarios, precipitation strongly influences pollutant transport, while pollutant migration is inversely related to water-saving irrigation potential. These findings provide a spatially explicit basis for climate-resilient irrigation planning and coordinated agricultural water and pollution management.}
}
@article{QIU2026136481,
title = {Root water uptake estimation and associated ecohydrological functions based on distributed moisture storage dynamics in soil-weathered bedrock profiles},
journal = {Journal of Hydrology},
volume = {680},
pages = {136481},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136481},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015787},
author = {Yang Qiu and Zekang He and Zhiqiang Yin and Dongmei Han and Ling Peng and Aifang Jin and Chuanming Ma and Lei Zhao and Xianfang Song},
keywords = {Root water uptake, Weathered bedrock moisture, Non‑parametric framework, Ecohydrology, Larch plantations},
abstract = {Root water uptake (RWU) is a key process linking subsurface moisture redistribution and the atmospheric water cycle. However, it is difficult to quantitatively simulate under strong heterogeneity of the medium or a lack of hydraulic parameters, especially for weathered bedrock. Therefore, we developed a non‑parametric, observation‑driven diagnostic framework that integrates mass conservation with water‑demand allocation to infer layer‑wise flux and RWU across soil and weathered bedrock profiles. We further applied it in two larch plantation plots underlain by sandstone and tuff. It clearly reversed the layer-wise moisture dynamics driven by freeze-thaw cycles, infiltration, and transpiration. Then, the RWU sourced from different layers were estimated. Although soil moisture supported the dominant water source for the shallow-rooted larch plantation (over 90%), RWU from the weathered bedrock layer still cannot be ignored. The weathered sandstone moisture provided about 7.85% and 3.25% RWU (based on lower-bound estimations) during the growing and post-growing seasons, respectively, whereas it was about 1.13% and 4.88% from weathered tuff. Additionally, this framework can also estimate the layer-wise vertical drainage flux. It was verified that the weathered bedrock layers act as deep moisture buffers during the wet season and provide stable water retention during the dry season. Our study provides a reproducible computational framework for simulating moisture transport and RWU in profiles where parameters are difficult to obtain or where the medium heterogeneity is strong. Our results also highlighted that incorporating bedrock moisture dynamics into evapotranspiration frameworks is essential for improving assessments of drought resilience and guiding water‑limited afforestation strategies.}
}
@article{ZHAN2026136405,
title = {Integrating SWOT data and machine learning for high-resolution river surface velocity retrieval in data-scarce headwater regions},
journal = {Journal of Hydrology},
volume = {680},
pages = {136405},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136405},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015027},
author = {Pengfei Zhan and Kai Liu and Jiaming Na and Tan Chen and Jinkai Guo and Chunqiao Song},
keywords = {Tibetan Plateau, River, Flow velocity, SWOT, Hydrodynamics, Machine learning},
abstract = {River surface velocity is a critical hydrodynamic variable governing flood wave propagation, sediment transport, and aquatic ecosystem stability, yet it remains poorly observed in data-scarce headwater rivers of the Tibetan Plateau (TP). While the Surface Water and Ocean Topography (SWOT) mission provides high resolution observations of water surface elevation, it does not directly measure river surface velocity. To address this gap, this study develops a hydraulically informed machine learning (ML) framework that integrates SWOT Level-2 Pixel cloud data with in-situ velocity measurements to retrieve spatially continuous river velocity fields in data-scarce alpine environments. We constructed a high-fidelity dataset with 212 paired samples from seven representative field sites, encompassing diverse hydraulic conditions. Among four candidate ML algorithms, the XGBoost model enforced with longitudinal water surface slope (WSS), river width, and discharge as mandatory hydraulic predictors, demonstrated superior performance. The final model achieved strong independent testing skill (R2 = 0.80, MAE = 0.09 m/s, RMSE = 0.17 m/s, MAPE = 8.44%), maintaining robustness even in low-velocity conditions (< 1 m/s). SHAP-based interpretability analysis indicates that longitudinal WSS was the dominant predictor (35.51%), while temperature (25.88%) and NDVI (8.51%) provided additional information as hydroclimatic and riparian context proxies. We further applied the optimal model to generate reach-aggregated surface velocities for 5,434 2-km river reaches across the eastern TP, spanning 0.87–1.70 m/s (median 0.95 m/s; IQR 0.92–1.46 m/s). Across the study basins, the mapped reach-scale velocities exhibit spatial contrasts in both central tendency and spread. The Qaidam Basin shows persistently low and spatially coherent velocities, whereas the upper Yangtze and upper Yellow River basins display wider distributions and stronger spatial heterogeneity, including contiguous fast-flow corridors and localized low-velocity zones. These findings demonstrate that integrating SWOT altimetry with ML models offers a scalable pathway for monitoring river hydrodynamics in ungauged high-altitude river systems.}
}
@article{ZHENG2026136457,
title = {Propagation from precipitation extremes to root-zone soil moisture and attribute changes in dry and wet events: A global paired event analysis},
journal = {Journal of Hydrology},
volume = {680},
pages = {136457},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136457},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015544},
author = {Yanhui Zheng and Sile Li and Peng Wang and Lina Wang and Xihui Gu and Jiangchao Qiu and Xiaohong Chen},
keywords = {Drought propagation, Dry–wet asymmetry, Soil moisture memory, Root-zone soil moisture, Aridity regimes, Land–atmosphere coupling},
abstract = {Precipitation extremes do not invariably correspond to soil moisture extremes, yet propagation studies emphasize occurrence and timing rather than attributes of matched events. Using calendar month standardized anomalies, we compared monthly dry and wet events in precipitation from the Global Precipitation Climatology Centre (GPCC) and surface and root-zone soil moisture from the Global Land Evaporation Amsterdam Model (GLEAM) over land between 60°S and 60°N during 1981–2024. Same sign events were matched independently one-to-one along three pathways: precipitation to surface soil moisture (P → SMs), precipitation to root-zone soil moisture (P → SMrz), and surface to root-zone soil moisture (SMs → SMrz). Propagation probability was the matched fraction of all source events, matched pair changes in duration, severity, and peak intensity were expressed as log2(target/source). Area-weighted mean P → SMrz propagation probabilities were 0.370 for dry events and 0.405 for wet events. Duration changes were + 0.672 and + 0.452, respectively. Peak intensity changes were positive for dry events (+0.222) and negative for wet events (−0.260), while severity increased for both. P → SMs showed the same peak contrast but smaller duration increases. In GLEAM, SMs → SMrz events matched more frequently but had smaller duration changes. Propagation probability and attribute changes varied across four aridity regimes without a common monotonic gradient, but the dry-positive/wet-negative peak contrast persisted in every regime. Redefining event boundaries using 1- and 3-month standardized precipitation and soil moisture indices retained the P → SMrz duration and peak directions. ERA5-Land reproduced the duration and peak directions in both precipitation-to-soil moisture comparisons, whereas SMs → SMrz peak directions differed between products. Monthly precipitation and soil moisture extremes therefore exhibit incomplete event correspondence and sign-dependent attribute differences among successfully matched pairs; occurrence, persistence, and peak intensity describe distinct aspects of their relationship.}
}
@article{WANG2026136395,
title = {Long-term monitoring of lake dynamics across the Yangtze River Basin using multi-source altimetry fusion},
journal = {Journal of Hydrology},
volume = {680},
pages = {136395},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136395},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014927},
author = {Yong Wang and Yulin Gong and Yinghong Jing and Xiaojun She and Shanlong Lu and Yao Li},
keywords = {Lake water level, Area–elevation relationship, Multi-source fusion, Satellite altimetry, Yangtze River basin},
abstract = {The Yangtze River Basin (YRB) contains numerous natural lakes whose water level fluctuations are typically an order of magnitude smaller than those of managed reservoirs, posing a major challenge for high-resolution, long-term monitoring. To address this limitation, we developed a multi-source satellite altimetry fusion algorithm to enhance the detection of subtle water level variations and integrated it with long-term optical observations to enable consistent basin-scale monitoring. These resulting records are compiled into the YRB Lake Dynamics (YLD) dataset, which provides monthly time series of lake area, water level, and lake water storage variations from 1990 to 2023. The YLD dataset delivers an enhanced water level product derived from multi-source altimetry fusion for 883 lakes (accounting for >99% of total lake area). It establishes robust area–elevation (A–E) relationships for 440 lakes (>90% of total lake capacity), with a mean coefficient of determination (R2) of 0.76. Validation against in situ observations from 12 lakes demonstrates strong agreement in reconstructed dynamics, with a mean correlation coefficient (CC) of 0.73, a mean root-mean-square error (RMSE) of 0.73 m, and a normalized RMSE (NRMSE) of 14.05%. Over the past three decades, approximately 70% of large lakes within the basin have contracted, driving declines in total lake area and water storage at rates of 16.07 ± 6.95 km2 yr⁻1 and 144.28 ± 44.11 Mm3 yr⁻1, respectively. In contrast, about 61% of small lakes have expanded, accompanied by a mean water level rise of 1.65 ± 0.50 cm yr⁻1. Spatially, a distinct pattern of “shrinkage in the middle reaches and expansion in the upper and lower reaches” emerges, indicating the combined influence of climate change and human activities across different hydrological regions. Overall, this study demonstrates the effectiveness of multi-source altimetry fusion for high-resolution monitoring of lakes with subtle water level variations, thereby providing a transferable methodological framework and a long-term dataset for investigating lake dynamics in similar systems worldwide.}
}
@article{AI2026136463,
title = {Physics-informed neural networks for hydrodynamic inversion and discharge estimation in river flows over complex bed topography},
journal = {Journal of Hydrology},
volume = {680},
pages = {136463},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136463},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601560X},
author = {Congfang Ai and Yuxiang Ma and Junzheng Li and Jiajie Song and Jiaxiang Sun},
keywords = {Physics-informed neural networks, Hydrodynamic inversion, Discharge estimation, Bed-topography inference, Complex bed topography},
abstract = {Accurate estimation of river discharge and internal hydraulic states remains a fundamental challenge in hydrological monitoring, particularly when observations are limited and key flow variables cannot be directly measured. In this study, we develop a physics-informed neural network (PINN)-based framework for hydrodynamic inversion and discharge estimation in river flows over complex bed topography under limited observations. The proposed approach embeds the Serre–Green–Naghdi (SGN) equations into the neural network training process to enforce physical consistency while assimilating limited observations, such as water-depth or bottom-pressure-head observations. Within this framework, hydraulic states and river discharge can be reconstructed, and bed topography can be inferred when discretized bed-elevation data are available. The unified inverse formulation is implemented in three task-specific configurations for different observation types and bed-information conditions. For prescribed continuous and smooth bed profiles, water-depth or bottom-pressure-head observations are utilized to reconstruct hydraulic states and estimate discharge. When only sparse discretized bed information is available, the framework is extended to simultaneously reconstruct water depth, bottom pressure, bed topography, and discharge within a unified learning process. The proposed approach is evaluated through representative numerical experiments. Results demonstrate that the framework can reliably estimate discharge and reconstruct hydraulic states under limited observation conditions. In scenarios with sparse bed information, the method successfully recovers bed topography while maintaining accurate discharge estimation and consistent hydraulic state reconstruction. These findings demonstrate the feasibility of using SGN-constrained physics-informed learning for observation-limited hydrodynamic inversion, discharge estimation, and bed-topography recovery in controlled benchmark cases.}
}
@article{PESSOTTIMORO2026136484,
title = {Proposal for using daily thermal amplitude to estimate reference evapotranspiration without relative humidity},
journal = {Journal of Hydrology},
volume = {680},
pages = {136484},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136484},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015817},
author = {Iulo {Pessotti Moro} and Sidney {Sara Zanetti} and Roberto {Avelino Cecílio} and José {Eduardo Macedo Pezzopane}},
keywords = {Vapor pressure deficit, Dew point temperature, Actual vapor pressure, Penman-monteith with limited data},
abstract = {The FAO-56 Penman-Monteith (PM) method is the standard for estimating reference evapotranspiration (ETo), but its application is frequently limited by the scarcity of relative humidity data. In these cases, assuming the dew point temperature (Tdew) is equal to the minimum temperature (Tmin) is a common practice; however, it ignores the physical reality of dry environments, leading to overestimations of the actual vapor pressure (ea) and biases in ETo. Since atmospheric humidity acts by moderating temperature variations, the daily thermal amplitude (TA) serves as a consistent physical indicator of the hygrometric state of the atmosphere. Based on this premise, this study aims to propose and validate a new method to estimate Tdew as a function of Tmin and TA, aiming to calculate ea and ETo in data-limited scenarios. The method was calibrated and evaluated using daily meteorological data from 584 automatic stations across different Brazilian climates. The model’s performance was compared to the standard PM method. The proposed general approach systematically reduced estimation errors and mitigated systemic biases in a large part of the studied territory, outperforming traditional methods. However, in regions with extreme hygrometric conditions, such as severe water deficit, there was an inferior performance when compared to humid regions. The incorporation of the daily thermal amplitude eliminates the subjectivity of arbitrary correction factors. This approach provides a physically consistent and easily applicable alternative for estimating ETo in regions without relative air humidity data, supporting water resources management and irrigation planning.}
}
@article{AKTAS2026136298,
title = {Isotopic responses of hot and cold groundwaters to the 2023 Kahramanmaraş earthquakes: Evidence from oxygen-18 (δ18O), deuterium (δ2H), and tritium (3H, TU)},
journal = {Journal of Hydrology},
volume = {680},
pages = {136298},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136298},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013958},
author = {Emine Aktaş and Muhittin Karaman and Yusuf Uras and Sercan Öztürk and Cihan Yalçın and Oktay Canbaz and Emre Özelkan and Mustafa Kumral},
keywords = {2023 Kahramanmaraş earthquakes, Isotope hydrology, Stable isotopes, Tritium, Groundwater response, Seismic deformation},
abstract = {The extensive surface ruptures created by the February 6, 2023, Kahramanmaraş earthquake sequence (Mw 7.7 and Mw 7.6) along the East Anatolian Fault Zone have provided data for the detailed evaluation of earthquake-induced hydrogeochemical responses in groundwater systems. This study investigates the spatial variability of groundwater responses in a structurally complex tectonic setting by assessing post-seismic changes in hot and cold springs using stable isotopes (δ18O and δ2H) and radioactive isotope (3H) data. The isotopic compositions indicate that the studied waters are mainly of meteoric origin and lie between the Global Meteoric Water Line and the Mediterranean Meteoric Water Line. Tritium data were further evaluated using a piston-flow model and Monte Carlo uncertainty analysis to provide a comparative assessment of apparent groundwater ages. Comparison of isotope data before and after the earthquake showed that the groundwater responses were very heterogeneous spatially. Three typical response patterns were identified: (i) large changes in tritium with no associated shifts in stable isotopes, (ii) large shifts in stable isotopes with no detectable changes in tritium, and (iii) no measurable change in either tracer. The different response patterns suggest that stable isotopes and tritium can be used as tracers for different characteristics of the groundwater system and may have different responses to seismic disturbances. Variable isotope responses were observed even for springs near the mapped surface rupture, suggesting that proximity to the rupture alone does not govern post-seismic hydrogeochemical behaviour. Instead, the observed responses reflect the influence of local geological and hydrogeological conditions on the groundwater systems. Results emphasise the utility of combining stable isotopes and tritium to characterise pre- to post-earthquake differences in groundwater systems and provide a regional isotopic baseline for future post-seismic hydrogeochemical studies in tectonically active areas.}
}
@article{TUMUSHABE2026136387,
title = {Enhancing river flow prediction accuracy in data scarce catchments using a time varying ensemble deep learning approach},
journal = {Journal of Hydrology},
volume = {680},
pages = {136387},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136387},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014848},
author = {Angel I. Tumushabe and Seith N. Mugume and Johanna Sörensen},
keywords = {Bayesian model averaging, Data scarcity, Deep learning, Ensemble modelling, River flow prediction, Time-varying dynamic model averaging},
abstract = {Ensemble deep learning (EDL) methods offer an effective way to reduce model structural uncertainty and improve the reliability of river flow predictions, especially in catchments with limited data. This study evaluated the performance of a Time-Varying Dynamic Model Averaging (TV-DMA) ensemble for integrating heterogeneous machine learning and deep learning architectures, including FFNN, 1D-CNN, LSTM, CNN-LSTM and Diff-FFNN-LSTM models, for river flow prediction in two hydrologically distinct, data-scarce tropical catchments in the Upper White Nile Basin. Results show that the heterogeneous, first-order differential processing Diff-FFNN-LSTM model consistently achieved the highest individual-model river flow predictive performance (NSE ≥ 0.980), due to its ability to stabilise non-stationary river flow time series by mitigating boundary effects associated with decomposition methods, thereby improving representation of rapid flow transitions. Additionally, the TV-DMA resulted in more superior performance in both the Semliki (NSE = 0.910; PBIAS = −0.42%) and Tochi (NSE = 0.831; PBIAS = −0.34%) catchments when compared to the Bayesian Model Averaging (BMA) ensemble (Semliki: NSE = 0.848; PBIAS = −0.20% and Tochi: NSE = 0.710, PBIAS = −18.86%). BMA and TV-DMA also improved computational efficiency by 98–98.4% and 77–81%, respectively, relative to the process-based HEC-HMS model. The findings highlight the principal value of TV-DMA’s dynamic update of individual model weights based on predictive error distributions, which enhances river flow predictive performance, particularly in the rainfall-runoff-dominated Tochi catchment. This EDL approach can improve the accuracy and efficiency of river flow modelling and support the development of flood forecasting and early warning systems in data scarce regions.}
}
@article{GAO2026136421,
title = {Artificial interventions temporarily influence bacterial community spatial patterns along a natural river continuum},
journal = {Journal of Hydrology},
volume = {680},
pages = {136421},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136421},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015180},
author = {Han Gao and Yujia Zhai and Yanci Zhang and Hongjie Wang and Baoshan Cui},
keywords = {Bacterial community, Natural-artificial continuum, Community assembly, Co-occurrence networks, Source tracking analysis, River-lake system},
abstract = {River networks increasingly connect natural and engineered reaches, yet spatial variation in nearshore sediment bacterial communities across these connected habitats remains poorly resolved. This study investigated the spatial dynamics of bacterial communities in nearshore surface sediments along the natural-artificial continuum of the Daqing River Basin during the dry season. Alpha diversity was 22.58% lower at the estuary than in the upstream reach. Assembly metrics, network topology, and source assignments also varied among sampled reaches. At the confluence, the median source assignment to the engineered channel was 24.2%, compared with 15.1% assigned to the upstream river; farther downstream, the upstream river was the largest identified source (38.4%). This study elucidates bacterial community dynamics in complex river–lake systems and supports prioritizing natural hydrological connectivity conservation for ecosystem health in the Beijing-Tianjin-Hebei region.}
}
@article{ZHANG2026136404,
title = {A dual-scale optimization framework linking annual assessment with event-based erosion risk for watershed conservation},
journal = {Journal of Hydrology},
volume = {680},
pages = {136404},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136404},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015015},
author = {Xinyu Zhang and Fan Zhang and Shouhong Zhang and Yufei Ren},
keywords = {Watershed management, Soil and water conservation, Extreme rainfall events, Ecosystem services, Ecological restoration, Multi-objective optimization},
abstract = {Soil erosion in small watersheds is influenced by both long-term hydro-climatic conditions and short-term extreme rainfall events, challenging robust conservation strategy design. However, most optimization studies are limited to annual assessments, which may underestimate erosion risks under extreme rainfall and obscure trade-offs among soil conservation, water yield, and carbon storage. In this study, we propose a multi-objective framework integrating annual ecosystem service assessment and event-based erosion constraints. It integrates RUSLE and InVEST with 0–1 integer programming to optimize conservation configuration considering soil retention, water yield, carbon storage, and cost. An event-based soil loss model is further applied to stress-test the optimized configurations under annual maximum rainfall. The framework was applied to a severely eroded watershed on the Loess Plateau. The initial assessment revealed an alarming mean soil erosion rate of 4885.73 t·km−2·yr−1, alongside suboptimal water yield and carbon storage. Results show that the optimized configuration reduces annual soil erosion to 13.34% of the baseline level, decreases soil organic carbon loss to 13.24%, and increases carbon storage by approximately 4%. These improvements are achieved with a moderate reduction in water yield (to 93.78% of the baseline) and under the constraint of acceptable implementation costs. Furthermore, the supplementary event-based optimization mitigates erosion risks under rainfall events, ensuring soil loss remains below the tolerable threshold. This study demonstrates that integrating event-based erosion constraints with annual optimization improves the robustness of conservation planning under hydrological variability. The proposed framework provides a spatially explicit and computationally efficient decision-support tool for watershed management, particularly in erosion-prone regions with limited data.}
}
@article{ZHANG2026136456,
title = {The overlooked role of plant hydraulics in shaping groundwater recharge projections},
journal = {Journal of Hydrology},
volume = {680},
pages = {136456},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136456},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015532},
author = {Xue-Yan Zhang and Yuan Qiu and Zhi Li and Xubin Zeng and Guo-Yue Niu},
keywords = {Plant hydraulics, Groundwater recharge, Future projections, Ecohydrology},
abstract = {Groundwater resources in the western U.S. are increasingly stressed by climate change and growing water demand, yet vegetation processes remain poorly represented in projections of groundwater recharge. Here, we quantify the influence of plant hydraulics on projected recharge using the Noah-MP land surface model with advanced representations of plant hydraulics and soil hydrology. Historical simulations are evaluated against a USGS recharge product, Budyko-based water balance constraints, observed runoff, and GRACE terrestrial water storage anomalies over 1980–2018, demonstrating the model’s ability to capture large-scale hydrologic behavior. We project recharge for 2070–2099 under the SSP3–7.0 scenario using WUS-D3 simulations driven by three global climate models spanning a range of projected temperature and precipitation changes. Relative to 1980–2018, ensemble-mean recharge averaged across the western U.S. decreases by 20.0 %, with the largest reductions occurring in mountainous regions. To isolate the influence of plant hydraulics, we conduct sensitivity experiments that replace the explicit plant hydraulics representation with a traditional soil moisture-based plant water stress function. Averaged across the western U.S., neglecting plant hydraulics increases projected recharge by an amount equivalent to 10.1 % of historical recharge, while the mean absolute plant hydraulics effect reaches 38 % of the inter-GCM spread. Without plant hydraulics, stronger plant water stress suppresses warm-season transpiration, leaving more soil water available to enhance recharge primarily during winter and spring. These findings demonstrate that plant hydraulics can substantially affect recharge projections, highlighting the need to better represent vegetation–hydrology interactions in assessments of future groundwater resources.}
}
@article{LIN2026136359,
title = {Organic carbon dynamics in a subtropical watershed: hydrological processes and land use controls},
journal = {Journal of Hydrology},
volume = {680},
pages = {136359},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136359},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014563},
author = {Guan-Zhou Lin and Li-Chi Chiang},
keywords = {SWAT-C, Soil organic carbon (SOC), Dissolved organic carbon (DOC), Particulate organic carbon (POC), Extreme rainfall events, Terrestrial-aquatic linkages, Subtropical mountainous watershed},
abstract = {Land use and hydrological processes jointly influence soil organic carbon (SOC) storage and riverine organic carbon (OC) export in subtropical watersheds. This study employed the SWAT-C model to quantify SOC storage and the export of dissolved organic carbon (DOC) and particulate organic carbon (POC) in the Wu River Basin, Taiwan, during 2012–2017. Model calibration against observed total organic carbon (TOC) fluxes achieved robust performance (NSE ≥ 0.7), supporting its applicability for representing watershed-scale and seasonal carbon transport in high-energy, data-scarce basins. Simulations estimated mean annual DOC and POC exports of 10.4 and 6.9 kg ha−1 yr−1, respectively, with SOC stocks ranging from 155 to 294 t ha−1 (mean: 224 t ha−1), based on soil profile depths defined by the soil-layer data incorporated into the SWAT-C model. The results reveal pronounced spatiotemporal heterogeneity, with annual OC export varying by more than one order of magnitude across subbasins. Irrigated paddy fields functioned as significant carbon sinks, whereas bare land and rainfed croplands on steep slopes emerged as major POC source areas. More than 60% of annual OC export occurred during the wet season (June–September), and the peak export months (July–August) contributed over 30% of annual POC export and over 20% of annual DOC export. These results indicate that wet-season hydrological conditions strongly regulate seasonal carbon mobilization, without implying precise event-scale simulation. Overall, the findings demonstrate how hydrological routing and land-use intensity interact to modulate SOC retention and riverine OC export. This study offers a scientific basis for targeted erosion control and enhanced SOC sequestration to strengthen watershed resilience and sustainable management in subtropical monsoon regions.}
}
@article{PRASHANTH2026136472,
title = {Analyzing hydrological degradation vulnerability of non-perennial rivers shaped by groundwater stress, geogenic hazard and limited storage potential},
journal = {Journal of Hydrology},
volume = {680},
pages = {136472},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136472},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015696},
author = {Thallam Prashanth and Sayantan Ganguly},
keywords = {Hydrological degradation, Non-perennial rivers, Data scarce regions, River aquifer stress index, , Stage of groundwater extraction},
abstract = {Hydrological degradation, which poses a significant threat to river segments in a basin/watershed, manifests as a substantial decline in total water storage (TWS) in the river basin owing to rising climatic & anthropogenic stress, and formation of subsurface erosional landforms. Assessing and analyzing spatiotemporal variations of hydrological degradation vulnerability (HDV) across heterogeneous watersheds remains challenging in data-sparse semi-arid environments. In this context, the present research aims to assess the HDV in ungauged river segments using the proposed novel approach (S4H). The HDV computed using the S4H approach is validated using the proposed depth-duration curve-based river aquifer stress index (DDC–RASI). The HDV estimated by the proposed method is cross-validated using a newly proposed hypsometric-integral-based standardized TWS anomaly (HI–STWSA) duration curves derived from the Gravity Recovery and Climate Experiment (GRACE) and GRACE Follow-On (FO) satellite missions. To improve spatial patterns of hydrological stress & recovery, the HI–STWSA computed at the basin scale is downscaled to the watershed scale. The study finds that certain segments of the Pennar River in southern India exhibit high vulnerability, primarily due to intensive groundwater extraction and extensive sinkhole development, which severely disrupt subsurface storage and flow accumulation. In contrast, the downstream reach of the river near Nellore shows comparatively lower vulnerability, reflecting a lower stage of extraction and better groundwater-surface water connectivity. These findings highlight the urgent need for region-specific water management strategies to mitigate hydrological degradation.}
}
@article{JIA2026136448,
title = {Energy mechanism and modeling of watershed water–sediment event variations on the Loess Plateau},
journal = {Journal of Hydrology},
volume = {680},
pages = {136448},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136448},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015453},
author = {Lu Jia and Zhanbin Li and Mingjiang Deng and Kunxia Yu and Peng Li and Jiwei Zhu and Guoce Xu and Jiao Zhang and Shengde Yu and Siyi Tang},
keywords = {Energy mechanism, Water-sediment event, Energy-sediment model, Watershed, Loess Plateau},
abstract = {The Loess Plateau constitutes the primary sediment source of the Yellow River basin, where water–sediment event dynamics are shaped by complex interactions among erosion energy, terrain and human activities. Here, a research framework for watershed water–sediment events grounded in runoff erosion energy theory is developed, and applied to 16 typical watersheds across the Loess Plateau to elucidate the energy mechanisms underlying water–sediment event variations and improve the accuracy of sediment modelling. Quantitative analyses reveal that runoff erosion power, which quantifies event-scale runoff erosion energy acts as the primary driver of sediment load during event-scale water–sediment events, with the event-scale R2 for their relationship spanning 0.54 to 0.82, and its values exceeding 0.70 in 52% of the studied watersheds. This explanatory power far surpasses that of precipitation, for which the maximum R2 is less than 0.43, and runoff alone. Runoff surge shows an extremely significant positive correlation with sediment load, with R2 greater than 0.70 in 81.25% of watersheds (p < 0.001). Its integration into the energy-sediment model elevates simulation accuracy by an average of 10.98% and by as much as 26.79% in the most pronounced cases. In contrast, vegetation, characterized by the NDVI, exerts only a limited influence on sediment simulation and average contributes just 4.94% to the explained variance in sediment load. Runoff surge and runoff erosion power are identified as the primary drivers of sediment dynamics for watershed water–sediment events, with respective average contributions of 38.56% and 33.06% to the variance in sediment load. Parameters of the energy-sediment model display a nonlinear decrease–increase–decrease response to increasing watershed area, with two critical thresholds at 9400 km2 and 62,000 km2 governing shifts in their controlling factors. This work establishes a conceptual framework that links climate change and ecological restoration to watershed water-energy-sediment processes, delivering evidence-based insights to inform sustainable watershed management strategies in the Loess Plateau and analogous erodible regions worldwide.}
}
@article{SPICER2026136351,
title = {Controls on carbon and nutrient transport in a tidal creek across a coastal forest-marsh transition under sea-level rise},
journal = {Journal of Hydrology},
volume = {680},
pages = {136351},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136351},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014484},
author = {Nathaniel Spicer and Brian Moyer and Dannielle Pratt and Holly A. Michael and Ashleigh R. Montgomery and Angelia L. Seyfferth and Katherine Tully},
keywords = {Sea level rise, Saltwater intrusion, Tidal creeks, Nutrient transport, Biogeochemistry},
abstract = {Sea level rise (SLR) and saltwater intrusion (SWI) drive ecological and biogeochemical changes in coastal forests that alter solute fluxes between marshes and estuaries. Tidal creeks mediate transport of carbon (C), iron (Fe), and nitrogen (N) during flood and ebb tides, yet quantifying elemental fluxes is challenging due to bidirectional tidal flow and frequent bank overtopping. We quantified surface-water transport of C, Fe, and N during spring tides and storm events (2022–2023) in a tidal creek draining a transitioning coastal forest along the Delaware Bay. Discharge was estimated using a novel rating-curve model that incorporates bank overtopping dynamics. Groundwater wells and redox probes along a marsh-to-forest transect monitored water table elevation, salinity, and redox potential. We observed net imports of dissolved organic carbon (DOC), dissolved organic nitrogen (DON), dissolved Fe, and ammonium (NH4-N). DOC hourly loads were positively correlated with dissolved Fe loads, suggesting microbial dissolution of C-bearing Fe oxides during flood tides, and re-precipitation and C retention on ebb tides. Plant uptake and nitrification drove NH4-N and DON imports, as plant uptake during high tide could remove N from the water column. There was no import or export of nitrate (NO3-N), but NO3-N hourly loads were positively correlated with marsh redox potential, consistent with denitrification under reduced conditions. As the coastal zone responds to accelerating SLR, dissolution of Fe protected C will inhibit C sequestration and marsh loss to SLR could increase N delivery to coastal waters as plants uptake less N, with downstream implications for eutrophication.}
}
@article{CAI2026136440,
title = {Improving and evaluating the performance of change detection methods for soil moisture retrieval using Sentinel-1A over a forest-dominated mountainous study area in Beijing, China},
journal = {Journal of Hydrology},
volume = {680},
pages = {136440},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136440},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015374},
author = {Haotian Cai and Nan Ye and Rui Tong and Fuqiang Tian and Jingan Lin and Yao Zhuang},
keywords = {Change detection, High resolution, Sentinel-1, Soil moisture, Mountainous areas},
abstract = {Surface Soil Moisture (SSM) plays a crucial role in the development of natural disasters over mountainous areas, particularly in triggering flash floods caused by precipitation following antecedent rainfall. Numerous spaceborne SSM products can be used in flood models for forecasting and early warning of flash flood events. In recent decades, passive microwave remote sensing has been widely acknowledged as the most accurate technique for global SSM mapping. However, its spatial resolutions are limited to the order of 10 km from space. While Synthetic Aperture Radar (SAR) and optical sensors onboard satellites can enhance the spatial resolution of passive microwave SSM data or directly retrieve high-resolution SSM, the accuracy of SSM products is adversely affected by ground geometry and vegetation coverage over mountainous areas. In this study, the Advanced Change Detection method for Mountainous areas (ACD_M) was developed as an attempt to adapt the ACD framework for high-resolution SSM retrieval over forest-dominated mountainous areas using multi-temporal repeat orbit Sentinel-1A SAR data. ACD_M incorporates two key adaptations into the ACD framework. First, the Helsinki University of Technology (HUT) forest backscattering model was introduced to consider volume scattering in the ACD_M. Second, the SMAP passive microwave 9-km SSM product was downscaled, and pixel-wise SSM constraints were derived from local spatial variability to account for mountainous heterogeneity. The ACD_M was evaluated over a forest-dominated mountainous study area in northern Beijing, China. SSM with a spatial resolution of 25 m was retrieved from Sentinel-1A L1 radar backscatter data and subsequently validated using time series of ground SSM measurements from a monitoring station network for the period from January 2020 to May 2024. The ACD_M was also inter-compared with the existing short-term change detection methods, demonstrating superior overall retrieval accuracy. Compared to ACD, the ACD_M demonstrated higher and more stable retrieval accuracy, with an increase of 0.011 in R and a reduction of 0.022 cm3/cm3 in Bias. Furthermore, the potential for further enhancing the retrieval accuracy of the ACD_M by optimizing model constraints was explored. For instance, the mean R increased by 0.018 and the RMSE decreased by 0.008 cm3/cm3 after introducing a statistical relationship between geographical factors and SSM in the upper constraints. ACD_M showed limitations under high SSM conditions, indicating that caution is required when applying the retrieved SSM to near-saturated or flash-flood-related hydrological conditions.}
}
@article{MA2026136492,
title = {A hybrid smoothed particle hydrodynamics framework for modelling erosion in deformable riverbank},
journal = {Journal of Hydrology},
volume = {680},
pages = {136492},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136492},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015891},
author = {Guodong Ma and Annan Zhou and Ha H. Bui},
keywords = {Hybrid Smoothed Particle Hydrodynamics (SPH), Free-surface water, Riverbank erosion, Unsaturated soil, Large deformation},
abstract = {Riverbank erosion is an important geomorphological process that significantly influences river morphology, ecological systems, and infrastructure stability. Existing morphodynamic modelling approaches are generally unable to fully reveal the underlying hydro-mechanical mechanisms governing riverbank erosion because of the lack of suitable numerical models capable of simultaneously modelling free-surface flow, seepage, soil deformation, and large-deformation failure processes. This study proposes a hybrid smoothed particle hydrodynamics (SPH) framework to address the challenging coupled riverbank erosion processes. The proposed fully coupled SPH framework is first validated through benchmark problems involving submerged soil column consolidation, submerged deformable landslide motion, and wave-scouring-induced landslide failure. Subsequently, a field-scale riverbank erosion simulation is conducted to demonstrate the capability of the proposed approach and to investigate the hydro-mechanical mechanisms governing riverbank erosion and retreat. The results show that repeated wave fluctuations induce long-term seepage erosion near the riverbank surface, resulting in progressive mass loss and degradation of soil strength. Continuous erosion causes undercutting and stress deterioration within the bank, eventually leading to instability of the overhanging riverbank and subsequent block collapse. The collapsed soil mass is further fluidized and eroded by cyclic wave action, producing repeated cycles of erosion, collapse, and retreat that progressively reshape the riverbank geometry. The proposed SPH framework provides a promising hydro-mechanical modelling tool for investigating complex riverbank erosion processes involving strong fluid-soil interaction and large deformation.}
}
@article{WANG2026136432,
title = {Recirculated and fresh submarine groundwater discharge fluxes of dissolved carbon in a temperate seagrass lagoon},
journal = {Journal of Hydrology},
volume = {680},
pages = {136432},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136432},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015295},
author = {Yusi Wang and Bangjian Zhang and Qiangqiang Zhong and Xu Ren and Shiqing Sun and Yuda Chen and Miao Li and Ronggen Jiang and Jinzhou Du and Fenfen Zhang and Isaac R. Santos},
keywords = {Seagrass meadows, Coastal carbon, Blue carbon, Subterranean estuaries, Carbon budgets},
abstract = {Submarine groundwater discharge (SGD) is a critical hydrological process linking coastal aquifers, sediments, and ocean waters. However, bulk SGD estimates often cannot distinguish the relative contributions of fresh submarine groundwater discharge (FSGD) and recirculated submarine groundwater discharge (RSGD) to dissolved carbon export. In this study, we employ a modified pathway-specific Ra model that separates FSGD from RSGD by contrasting mixed porewater Ra endmembers. By coupling these partitioned water fluxes with measurements of dissolved inorganic carbon (DIC), dissolved organic carbon (DOC), and fluorescent dissolved organic matter (FDOM), we quantify pathway-specific dissolved carbon export within a temperate seagrass lagoon. The dual-Ra (223Ra and 224Ra) model revealed that RSGD was substantially higher than FSGD, with fluxes of 2.6 (2.2–3.3) and 0.9 (0.7–1.5) cm d-1, respectively. Porewater DIC and DOC concentrations were approximately 1.7 and 2.0 times greater than those in seawater. Consequently, RSGD accounted for approximately 82% and 87% of the total net SGD-associated DIC and DOC fluxes, respectively, corresponding to RSGD-associated area-normalized fluxes of 71 (41–101) and 12 (9–15) mmol m−2 d-1. Optical analyses further revealed that SGD transported both humic-like and protein-like fluorescent DOM components, with humic-like components dominating the exported FDOM pool. Together with the enrichment of DIC and DOC in porewater relative to seawater, these findings provide evidence that RSGD drives the advective export of carbon-enriched porewater into the lagoon. Our results demonstrate that pathway-specific separation of FSGD and RSGD is essential to attribute dissolved carbon fluxes in coastal aquifers and to properly evaluate groundwater-mediated lateral exchange in coastal blue carbon budgets.}
}
@article{WU2026136363,
title = {Overcoming phosphate scarcity in summer: DOP bioavailability mediates nutrient cycling in the Yellow Sea},
journal = {Journal of Hydrology},
volume = {680},
pages = {136363},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136363},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014605},
author = {Peiyun Wu and Yingxue Qu and Dongdong Zhu and Zhengqing Chai and Wen Liang and Su Mei Liu},
keywords = {Nutrients, Phosphorus speciation, Dissolved organic phosphorous, Molecular weight, Bioavailability, Yellow Sea},
abstract = {Phosphorus (P) limitation is pervasive in the summer Yellow Sea (YS), where strong stratification restricts vertical nutrient supply and shapes the cycling of dissolved and particulate P species. This study investigated nutrient dynamics and P speciation during summer, with an emphasis on the potential bioavailability of dissolved organic phosphorus (DOP) under P-depleted conditions. Our findings reveal that nutrient partitioning was principally regulated by physical stratification and the Yellow Sea Cold Water Mass (YSCWM), resulting in distinct vertical gradients in P speciation that also varied spatially across the study region. DOP dominated the total dissolved P pool in the surface layer (67%), reflecting active biological uptake of DIP and subsequent organic matter transformation. In contrast, bottom waters were characterized by DIP as the dominant fraction (75%), driven by microbial degradation and adsorption–desorption processes. Low-molecular-weight DOP (< 3 kDa) dominated the DOP pool (52% of total DOP), and was found to exhibit greater bioavailability compared to higher molecular weight fractions. Incubation experiments revealed that up to 20% of DOP could be utilized by heterotrophic bacteria under P scarcity, with microbial growth sustained at a DOP concentration as low as 0.101 μmol L−1. The minimum DIP concentration required to sustain bacterial growth was approximately 0.014 μmol L−1. In addition, terrestrial inputs and sediment resuspension influenced the particulate P dynamics in the YS. This study also highlights the interplay between physical transport processes (e.g., stratification and water mass mixing) and biological transformations in regulating of P cycling. Our results emphasize the critical role of DOP in maintaining the stability of ecosystems in P-limited marine environments.}
}
@article{SONG2026136476,
title = {Effect of land reclamation on denitrification processes in intertidal zones of beach aquifers},
journal = {Journal of Hydrology},
volume = {680},
pages = {136476},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136476},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015738},
author = {Wenjin Song and Chunhui Lu and Huiqiang Wu and Jian Luo},
keywords = {Land reclamation, Subterranean estuary, Denitrification, Numerical modeling, Beach aquifers},
abstract = {Biogeochemical processes in intertidal aquifers regulate the nutrient levels of groundwater that ultimately discharges into the marine environment. Most previous studies of intertidal reactivity have focused on natural beach aquifers, while the impact of coastal land reclamation on these processes remains largely unknown. This study investigated the denitrification in an intertidal aquifer modified by land reclamation using a two-dimensional variable-density groundwater flow and reactive transport model. Simulations were performed for a range of reclaimed soil permeabilities, along with different beach slopes and tidal amplitudes after land reclamation. The results show that the heterogeneity introduced by reclamation induces significant changes in the extent and distribution of denitrification hotspots, whereby higher reclaimed soil permeability results in a larger denitrification zone and thus a greater nitrate removal efficiency. Sensitivity analyses indicate that nitrate removal efficiency is most influenced by tidal amplitude, followed by reclaimed soil permeability and beach slope. These findings provide insights into how land reclamation affects the biogeochemical functions of beach aquifers, with important implications for the coordinated management of coastal land reclamation, groundwater nutrient fluxes, and the health of marine ecosystems.}
}
@article{LEE2026136468,
title = {Hydrologic and biogeochemical controls on stochastic water and pollutant dynamics in stormwater ponds},
journal = {Journal of Hydrology},
volume = {680},
pages = {136468},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136468},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015659},
author = {Kuan-Ying Lee and Jacques C. Finlay and Benjamin D. Janke and Anthony J. Parolari and Xue Feng},
keywords = {Stormwater ponds, Stochastic processes, Climate change, Biogeochemical reactions},
abstract = {Stormwater ponds are a critical part of urban infrastructure for flood mitigation and pollutant removal. They may experience increasing external and internal pollutant loading under climate change, compromising their performance. To evaluate the impact of climate change on pond performance, a coupled stochastic model of stormwater pond water and pollutant dynamics was developed. This study examined the effects of climate variability through stochastic runoff inputs that drive stochastic outflows and incorporated the effects of internal biogeochemical processes on pollutant dynamics via first-order reaction kinetics. Concise analytical solutions for the probability distributions of pond water depth and for the mean pond pollutant concentration were derived. The model was validated in two stormwater ponds in the Twin Cities, Minnesota: USA, Alameda Pond (AP) and Church Pond (CP), using measured total phosphorus concentrations, one of the primary targets for water quality treatment by ponds. Under the 2018 climate conditions, the internal reaction rates for total phosphorus in AP and CP were −0.0146 [day−1] and −0.0022 [day−1], respectively, indicating that AP was a stronger sink for total phosphorus. Compared with AP, CP showed greater variation in total phosphorus concentration. Finally, under the 2050 and 2090 climate scenarios, the projected concentration trends indicated that reduced internal consumption caused a nonlinear increase in concentration. These results suggest that internal reactions predominantly control pond function in the consumption or release of redox-sensitive pollutants, and regular pollutant removal, such as street sweeping in the watershed and pond dredging, can improve pond function and resilience to climate change.}
}
@article{GABBARDODOSREIS2026136402,
title = {Improving flood forecasts: the combined impact of data assimilation and machine learning post-processing},
journal = {Journal of Hydrology},
volume = {680},
pages = {136402},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136402},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601499X},
author = {Gustavo {Gabbardo dos Reis} and Paul C. Astagneau and François Bourgin and Vazken Andréassian and Charles Perrin},
keywords = {Hydrological modeling, Forecasting, Data assimilation, Post-processing, Machine learning},
abstract = {Accurate streamflow forecasts are essential for flood risk management and impact mitigation. Coupling hydrological models with machine learning techniques has gained increasing attention as a means to improve forecast skill, with post-processing emerging as a promising approach to correcting systematic model residuals. However, the interaction between machine-learning post-processing, data assimilation and calibration strategies remains insufficiently explored. In this study, we assess the contribution of machine-learning-based post-processing to hourly streamflow forecasts for 687 catchments in metropolitan France, generated using a GR-family hydrological model (GR5H-RI) under three forecasting approaches differing in calibration strategy and use of data assimilation. Random Forest and Multilayer Perceptron models are used to post-process forecasts at lead times of 3, 6, 12 and 24 h. Forecast performance is evaluated using both continuous skill metrics relative to persistence and threshold-based metrics for flood event detection. Results show that (1) post-processing consistently improves forecast skill at short lead times, especially for slower-response catchments, with the median persistence score increasing from 0.33 to 0.54 at a 3-h lead time in the highest-skill forecasting setup and performance improving in 89.7% of catchments; (2) the largest gains occur for forecasts without data assimilation, suggesting that post-processing can partially compensate for the lack of state updating but cannot fully replace it; and (3) neural network-based post-processing slightly outperforms tree-based models in continuous metrics, while differences are more limited for event detection. Overall, results highlight the complementary roles of data assimilation and machine-learning post-processing and demonstrate the potential of such frameworks for operational flood forecasting.}
}
@article{YIN2026136444,
title = {Ecological water replenishment reshapes the spatiotemporal patterns of groundwater hydrochemistry in the North China plain},
journal = {Journal of Hydrology},
volume = {680},
pages = {136444},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136444},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015416},
author = {Ziyue Yin and Jianfeng Wu and Xiaomin Sun and Jian Song and Yun Yang and Jichun Wu},
keywords = {Ecological water replenishment, Groundwater quality, Spatiotemporal pattern, Differentiated hydrochemical response, North China Plain},
abstract = {Groundwater depletion and the associated ecological degradation have become critical challenges worldwide. Integrated water management and targeted policy interventions have proven effective in stabilizing or even restoring groundwater storage. However, the hydrochemical responses and potential environmental trade-offs associated with such interventions remain insufficiently understood. In this study, groundwater hydrochemical data from three key pilot river systems (i.e., the Hutuo, Fuyang, and South Juma Rivers) in the North China Plain (NCP) were analyzed for the period 2017–2019. Statistical analyses, principal component analysis, and non-metric multidimensional scaling were employed to examine groundwater hydrochemical changes associated with ecological water replenishment. The results revealed pronounced spatiotemporal heterogeneity in groundwater hydrochemical responses. Temporally, the groundwater system exhibited clear stage-dependent hydrochemical variations, with marked hydrochemical perturbation in 2018 followed by comparatively constrained adjustment in 2019. Spatially, hydrochemical responses varied substantially among river systems and aquifer types. Horizontally, distinct river-specific hydrochemical trajectories were observed: the Hutuo River groundwater system showed a relatively systematic longitudinal evolution, whereas the Fuyang River groundwater system displayed more fragmented and spatially reorganized hydrochemical hotspots. Vertically, the unconfined aquifer showed stronger and more stage-dependent hydrochemical variations, consistent with greater sensitivity to hydrodynamic perturbations, while the confined aquifer exhibited weaker and less systematic temporal differentiation. These findings indicate that evaluating groundwater restoration should extend beyond groundwater storage recovery to account for hydrochemical restructuring and associated water quality risks. This study provides a process-oriented basis for optimizing large-scale replenishment efforts and supports a quantity-quality coupled paradigm for long-term sustainability.}
}
@article{SUN2026136496,
title = {Hydrogeochemical relationship between large river and adjacent aquifer controls nitrogen accumulation and transformation in riparian zone},
journal = {Journal of Hydrology},
volume = {680},
pages = {136496},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136496},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015933},
author = {Haichuan Sun and Qi Zhu and Luguang Liu and Yan Li and Yuhang Liang and Gohar Murad Khan and Yize Wang and Zhang Wen and Hui Liu},
abstract = {Nitrogen behavior in large-river riparian aquifers is difficult to predict because lateral river-groundwater exchange and vertical connectivity between phreatic groundwater (PGW) and confined groundwater (CGW) are highly heterogeneous. This study investigated how the Yangtze River (YR), a representative of a large river, and its lateral PGW and CGW jointly regulate nitrogen distribution and transformation in three riparian profiles with contrasting hydrogeochemical properties: Jiangling (JL), Jianli (JLX), and Honghu (HH). Groundwater-level monitoring, hydrochemistry, and multiple isotope tracers (δ2H-H2O, δ18O-H2O, δ15N-NO3−, δ18O-NO3−, and δ15N-NH4+) were integrated to identify hydrological connectivity, nitrogen distribution, sources, and transformation pathways. The results show that: (1) large-river riparian aquifers have strong lateral and vertical connectivity heterogeneity. The CGW response distance to the YR decreased from approximately 10 km in JL to 5 km in JLX and 2 km in HH, while PGW-CGW leakage fluxes varied from 209.4-1012.2 m3/d in JL to −141.2–154.2 m3/d in HH, under the hydrological conditions of this study; (2) distinct hydrogeochemical variables controlled nitrate and ammonium accumulation. Connected and relatively oxic pathways favored NO3−-N enrichment in JL, with maximum concentrations of 11.81 mg/L in PGW and 11.95 mg/L in CGW. In contrast, weak flushing, reducing confined groundwater, favored NH4+-N accumulation, reaching 8.43 mg/L in JLX-CGW and 4.76 mg/L in HH-CGW; and (3) nitrogen transformation was regulated by the interaction between river-driven oxygen supply and confined-aquifer reducing capacity. Nitrification and nitrate accumulation dominated in connected oxic zones, while organic nitrogen mineralization and ammonium preservation dominated in reducing confined groundwater. These findings provide a connectivity-redox framework for identifying nitrate-transport and ammonium-preservation zones in large alluvial river basins, supporting nitrogen pollution assessment and groundwater protection in layered aquifer systems.}
}
@article{GONG2026136399,
title = {Straw return enhances groundwater nitrate attenuation by fueling subsurface carbon–nitrogen coupling: Evidence from field monitoring and metagenomics},
journal = {Journal of Hydrology},
volume = {680},
pages = {136399},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136399},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014964},
author = {Shuo Gong and Jia Xin and Kang Yue and Linna Jia and Yueqi Wang and Xiaoxi Yu and Wenlin Ren and Hang Fu and Jie Dong},
keywords = {Straw return, Unsaturated–saturated zone, Carbon–nitrogen coupling, Nitrate attenuation},
abstract = {Excessive nitrate contamination of groundwater from agricultural activities is a global concern, yet natural attenuation is often limited by insufficient bioavailable organic carbon. Straw return has the potential to stimulate nitrate attenuation by supplying labile carbon; however, carbon–nitrogen coupling mechanisms across the unsaturated–saturated zone continuum remain unclear. Here, a field experiment compared straw return with low nitrogen fertilization (SL) and conventional fertilization (CK), integrating hydrological monitoring, geochemical analysis, dual nitrate isotope tracing, and metagenomics. Straw return significantly increased dissolved organic carbon (DOC) in soil and groundwater, with 32% higher peak soil DOC in SL. Groundwater NO3−-N stock was consistently lower under SL, resulting in net removal (5.50%), whereas CK showed net accumulation (−30.98%). Dual isotope signatures (δ15N and δ18O of NO3−) indicated that moderate denitrification occurs in groundwater. Metagenomics further revealed that straw-derived DOC selectively enriched heterotrophic denitrifiers and organic matter degraders. The carbon–nitrogen functional gene network in SL groundwater showed higher connectivity, suggesting enhanced metabolic coupling. Structural equation modeling identified DOC as the primary regulating factor, mediating a shift in nitrogen transformation pathways by promoting denitrification while concurrently suppressing nitrification. Collectively, these results reveal a mechanistic framework in which exogenous carbon inputs facilitate nitrate attenuation by strengthening microbial metabolic coupling, reorganizing biogeochemical pathways toward reductive nitrogen processes, and ultimately driving net nitrate removal in groundwater systems. These findings provide mechanistic insights and practical support for developing sustainable in situ remediation strategies for agricultural nitrate pollution in groundwater.}
}
@article{ZHIHAO2026136436,
title = {Multi-scale mapping of GDEs from remote sensing and field surveys in the Urumqi River–Chaiwopu Basin},
journal = {Journal of Hydrology},
volume = {680},
pages = {136436},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136436},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015337},
author = {Ye Zhihao and Zhou Qiang and Zheng Mingxia and Zhang Peng and Sun Hao and Zhang Xiaoyu and Zhou Xin and He Liansheng and Huang Longhao and Meng Rui},
keywords = {Groundwater-dependent ecosystems, Urumqi River-Chaiwopu Basin, Identification analysis, Geographic information system, Field validation, Field data},
abstract = {Groundwater-Dependent Ecosystems (GDEs) are widely distributed in arid and semi-arid regions and provide critical ecological services. However, their precise identification and mapping remain challenging due to insufficient integration of geospatial technologies with field measurement techniques. This study selected the terminal year of a prolonged drought and the most recent year for analysis, covering the period 2001–2023. We employed key indicators including Fractional Vegetation Cover (FVC), the difference between evapotranspiration and precipitation (ET-P), the Terrain Wetness Index (TWI), and the Vegetation Groundwater Accessibility Index (VGUI). The K-means clustering algorithm was applied for classification, and spatial overlay analysis was conducted in the Urumqi River–Chaiwopu Basin in Xinjiang, China, to assess the spatial distribution and temporal variations of GDEs. The results were validated by integrating wetland distribution data with field investigations. The findings indicate that areas classified as “likely” or “very likely” GDEs are predominantly concentrated around Dongdao Haizi, Chaiwopu Lake, the salt lakes, and adjacent regions, covering 45.4% of the potential area (4,197.89 km2). Wetland-based validation yielded a producer’s accuracy of 84.1%. Over time, the area classified as “unlikely” or “very unlikely” for GDEs showed an increasing trend. After incorporating VGUI, the likelihood class decreased across 41.0% of the typical areas, with cultivated and built-up land accounting for 64.9% of this decrease. By incorporating field-based VGUI data, the study reduced interference from anthropogenic factors such as irrigation in the identification of GDEs within typical areas, enabling refined mapping.}
}
@article{LIU2026136488,
title = {Conditional normalizing flows: a generative framework for probabilistic streamflow forecasting},
journal = {Journal of Hydrology},
volume = {680},
pages = {136488},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136488},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015854},
author = {Mingyang Liu and Zhongmin Liang and Jianfei Zhao and Yiming Hu and Binquan Li and Jun Wang},
keywords = {Probabilistic streamflow forecasting, Conditional normalizing flows, End-to-end learning, Distribution-flexible, Uncertainty quantification},
abstract = {This study develops an end-to-end probabilistic streamflow forecasting framework that combines a gated recurrent unit (GRU) encoder with a conditional normalizing flow (CNF). Rational quadratic spline transformations are used to learn an explicit conditional streamflow density and generate predictive quantiles within a unified trainable framework. The framework was first evaluated in a one-day-ahead regional experiment using a shared model across Catchment Attributes and Meteorology for Large-sample Studies (CAMELS) catchments and was subsequently examined in a 1- to 4-day case study in the Tunxi catchment. In the CAMELS experiment, the deterministic performance of CNF was comparable to that of the other frameworks, and 92.0% of catchments exceeded both the deterministic-skill and interval-reliability diagnostic thresholds. For CAMELS catchments where test-period high flows exceeded the training-period maxima, CNF remained among the leading frameworks in both deterministic and probabilistic performance. In the Tunxi experiment, CNF achieved the highest deterministic skill at the 1- to 3-day lead times and the lowest continuous ranked probability score (CRPS; 12.189–48.044 m3/s) and highest containing ratio coefficient (CRC; 0.9718–0.9976) across all four lead times. A matched long short-term memory (LSTM) backbone control further showed comparable overall performance between LSTM-CNF and an LSTM-based quantile regression neural network (LSTM-QRNN), with LSTM-CNF showing slight advantages in average point-forecast accuracy and CRC. These results demonstrate that CNF provides an end-to-end optimized, explicit, and flexible conditional-density representation while maintaining predictive performance competitive with the comparison frameworks.}
}
@article{DU2026136394,
title = {Assessment of multi-driver human interventions on streamflow and its components based on information and complexity metrics},
journal = {Journal of Hydrology},
volume = {680},
pages = {136394},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136394},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014915},
author = {Xinyue Du and Tian Lan and Huanhuan Li and Wenzhe Feng and Tianling Qiao and Tongyong Wang and Haoyan Wei and Huijie Li and Yanwei Lu},
keywords = {Multi-driver human interventions, Streamflow components, Information and complexity measures, Nonlinear dependencies},
abstract = {Human activities increasingly modify river systems, yet quantifying their independent and combined effects on streamflow remains challenging due to nonlinear, multi-driver interactions and time-lagged hydrological responses. This study proposes a framework that combines information-theoretic and complexity metrics to evaluate how diverse human interventions affect total streamflow and its components. Total streamflow was decomposed into fast-streamflow, intermediate interflow, slow-streamflow, and dry-weather flow through an improved multi-component streamflow separation method. Complex relationships between anthropogenic drivers and streamflow components were assessed through a Multi-Source Human Intervention Index (MSHI) derived from information-theoretic dependence, with human activities represented by remote-sensing indicators. Case-study results show that fast-streamflow and dry-weather flow are most sensitive to human activities, with mean MSHI values exceeding 0.6 in study cases. Night-time light and impervious surface percentage were the most influential drivers. Basin complexity was further employed to examine the consistency and interpretability of the assessment results. Building on these findings, this study provides a scalable approach for assessing the complex, nonlinear impacts of human interventions on river systems.}
}
@article{FRAU2026136483,
title = {Fourier spectral heuristic indices for streamflow complexity and predictability},
journal = {Journal of Hydrology},
volume = {680},
pages = {136483},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136483},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015805},
author = {Francisco Javier Frau and Dragutin T. Mihailović and Slavica Malinović-Milićević and Vijay P. Singh},
keywords = {Kolmogorov complexity measures, Fourier spectral analysis, Lyapunov exponent, Lyapunov time, Streamflow predictability, Chaos, Time series analysis},
abstract = {This research investigates the complexity, temporal organization, and chaotic dynamics of streamflow by introducing two novel heuristic indices derived from Fourier spectral analysis and comparing them with Kolmogorov complexity (KC), its derivatives, and the Largest Lyapunov Exponent (LE). The proposed indices are the Participation of Non-seasonal Frequencies (PNSF) and the Standard Triperiod Index (STP). These indices are applied to monthly streamflow records from rivers in the Mendoza Basin, Argentina, and the continental United States. The results show that PNSF characterizes the redistribution of non-seasonal spectral participation associated with streamflow variability, whereas STP quantifies temporal organization related to dominant seasonal cycles, providing complementary information for distinguishing hydrological regimes. Significant correlations between the proposed indices and established complexity measures indicate that PNSF and STP complement existing information-theoretic and nonlinear dynamical frameworks. Although the proposed indices do not directly quantify the defining properties of chaos or predictability, they provide additional descriptors of spectral regularity and temporal organization that are associated with complex hydrological dynamics. Future research will further validate these indices and evaluate their applicability across diverse hydrological conditions.}
}
@article{SHI2026136452,
title = {Threshold-like bacterial community reorganization and microbial health risk along phosphorus-enrichment gradients in urban rivers},
journal = {Journal of Hydrology},
volume = {680},
pages = {136452},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136452},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015490},
author = {Kun Shi and Jiafeng Zhang and Kexuan Zhang and Shilei Zhou},
keywords = {Urbanrivers, Phosphorus enrichment, Bacterial communities, Dissolved organic matter, Microbial health risk},
abstract = {Whether phosphorus enrichment is associated with threshold-like reorganization of urban river bacterial communities and how this relates to microbial health risk remain poorly understood. We integrated DOM characterization, 16S rRNA gene sequencing, machine learning, life-history analysis, microbial health risk assessment, and metagenomics across an urban river network in Shijiazhuang. Two distinct community states were identified, with total phosphorus emerging as the strongest measured environmental predictor and 0.025–0.039 mg L−1 representing a putative, survey-specific transition interval. State B showed stronger deterministic reassembly, greater contributions of rapidly responding r-strategists, and weaker cohesion-based structural buffering. Path modeling supported an association cascade linking phosphorus-associated nutrient conditions with DOM and life-history reorganization, potential pathogen accumulation, and increased microbial health risk. Consistently, the potential pathogen health risk index increased from 41.33 ± 7.78 to 54.39 ± 9.52, accompanied by enrichment of resource-acquisition, antimicrobial-resistance, and virulence-related functions. Overall, phosphorus enrichment was associated with a coordinated nutrient–community–risk cascade from ecological reorganization to elevated microbial health risk, providing a basis for early warning and nutrient management in urban rivers.}
}