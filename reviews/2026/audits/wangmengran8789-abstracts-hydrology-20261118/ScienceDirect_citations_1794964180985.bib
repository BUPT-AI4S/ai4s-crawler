@article{LIU2026136427,
title = {Grain size and thickness of event layers in relation to the flood magnitude: examples from floodplains in the middle and lower Yangtze River, China},
journal = {Journal of Hydrology},
volume = {680},
pages = {136427},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136427},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015246},
author = {Xiu Juan Liu and Albert J. Kettner and Hui Ling Li and Feng Yang Min and Dao Sheng Wang},
keywords = {Event deposits, Flood plain, Flood event, Flood magnitude, Grain size, Yangtze River},
abstract = {River floodplain deposition occurs typically when floodplains inundate. It is widely used for reconstructing historical floods. However, linking specific deposition event layers to specific flood magnitudes is still challenging. We analyzed the responses of suspended sediments and their sedimentary records to flood events of various magnitudes in the middle and lower Yangtze River. Results indicate that the 2020 large flood and 2012 and 2016 moderate floods do not cause coarsening of suspended sediment or increases of sand content in suspended sediment compared to the floods of smaller magnitudes. However, these three floods resulted in coarser and thicker flood event layers for the floodplains. The coarsest sections of event layers correspond to flood peak periods. We speculate and verify that both grain size and sand content of floodplain deposits correlate to flood magnitude by variation of the settling probability of different components of suspended sediment during high water discharge of moderate and large floods, rather than by changes in grain size composition of suspended sediment. In addition, the 2012 event deposition layer is thicker than the 2016 that was formed under higher flood magnitude conditions. This is most likely due to differences in sediment source areas for these two floods, i.e., event layer thickness of flood deposits is determined by both the magnitude and source area of flood event. These findings improve the understanding of the relationship between the characteristics of floodplain deposits and the magnitudes of flooding events, and accuracy of the interpretation of floodplain deposition.}
}
@article{HE2026136479,
title = {Dynamic risk assessment of water inrush from coal seam roof by coupling numerical modeling of groundwater flow and static risk model: a case study in Southwest China},
journal = {Journal of Hydrology},
volume = {680},
pages = {136479},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136479},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015763},
author = {Enyang He and Xinyang Luo and Hongbin Zhan and Juan Fan and Quanrong Wang},
keywords = {Dynamic risk assessment, Transient groundwater modeling, Normal cloud model, Game theory, Water-inrushrisk},
abstract = {Spatial distribution of groundwater is a critical factor in the risk assessment model of water inrush in a coal mine. However, it is assumed to be time independent in previous models (e.g., multi-year average water level), which is named the static risk model (SRM) in this study. Actually, groundwater level fluctuates seasonally and is also affected by anthropogenic activities. This study integrates transient groundwater flow modeling into the SRM framework to evaluate the impact of groundwater level dynamics on water inrush risk. The proposed model incorporates 10 key controlling factors, including carbonate rock thickness, carbonate rock proportion coefficient, coal seam thickness, aquitard thickness, aquifer thickness, distance to rivers, groundwater level, precipitation, spring density, and distance to faults. The weights of these factors are determined using a combination of the analytic hierarchy process (AHP) for subjective weighting and the entropy weight method (EWM) for objective weighting, with game theory (GT) applied to derive the optimal integrated weights for a comprehensive risk assessment. The risk is categorized into five levels, and normal cloud model is employed to calculate the membership degree of each spatial unit to each risk level. The membership degrees are integrated using a centroid method to derive a continuous risk grade, enabling continuous risk grading at the raster-cell scale that conventional discrete classifications cannot achieve. The new model is applied to the Longfeng Coal Mine in southwestern China. Results indicate that the risk index is significantly influenced by groundwater level fluctuations. Specifically, the spatial patterns during the normal season are generally similar to those in the dry season, whereas more pronounced variations are observed during the wet season. Under increased precipitation recharge, groundwater levels rise moderately, leading to enhanced hydraulic conditions and an appreciable increase in overall risk. Quantitatively, the dynamic model identifies an approximately 61.8% larger high-risk zone during the wet season compared to the static model, demonstrating that traditional assessments systematically underestimate water-inrush risk under seasonal groundwater fluctuations. Furthermore, the risk centroid shifts southeastward by approximately 423.56 m from the dry to the wet season, revealing that elevated hydraulic gradients not only intensify local hazards but also drive directional risk migration along preferential structural pathways. The integration of continuous risk grading with transient hydraulic simulation enables the model to characterize the temporal evolution of risk across different hydrological periods, thereby informing dynamic mine surveillance and seasonally tailored prevention and control strategies.}
}
@article{PARTRIDGE2026136403,
title = {Inverse modeling for post-wildfire hydrologic process understanding over snow-dominated watersheds},
journal = {Journal of Hydrology},
volume = {680},
pages = {136403},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136403},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015003},
author = {Trevor F. Partridge and Michelle A. Walvoord and Sheila F. Murphy and Michael N. Fienen and Aubrey L. Dugger and Brian A. Ebel},
keywords = {Wildfire, Hydrologic response, Hydrologic model, Parameter estimation, Surface water, Snow, Runoff},
abstract = {Wildfire-induced changes to vegetation and soil properties can alter snowpack dynamics and hydrologic processes in ways that complicate predictions of post-wildfire water availability. To better understand these effects, we coupled the Parameter ESTimation in C++ (PEST++) software with the Weather Research & Forecasting Hydrologic model (WRF-Hydro) across three burned, snow-dominated watersheds in the western United States. We incorporated three burn-severity-based land cover categories into WRF-Hydro and used an iterative Ensemble Smoother (iES) within PEST++ to estimate model parameters controlling snow accumulation and melt, infiltration, and streamflow generation. This framework supported three complementary objectives: (1) assessing parameter sensitivities under pre- and post-wildfire conditions, (2) comparing pre- and post-wildfire parameter ensembles to identify wildfire-driven shifts in hydrologic processes, and (3) using counterfactual simulations to isolate the hydrologic response to wildfire from interannual climate variability. Our findings indicate that model parameter sensitivity varied by domain and shifted following wildfire. Maximum snow albedo and snow albedo decay were most influential in the higher-elevation East Troublesome domain, while the rain-snow partitioning temperature threshold dominated in the lower-elevation Chippy Creek and Las Conchas domains. Following wildfire, streamflow sensitivity shifted away from snowpack parameters toward soil hydraulic parameters, consistent with wildfire-driven reductions in evapotranspiration and increases in soil moisture. Incorporating wildfire effects led to complex changes in simulated snowpack accumulation and streamflow timing, generally leading to earlier snowmelt freshet initiation and cessation and reduced late season flows. Simulations were more sensitive to interannual climate variations than wildfire land cover changes. These results highlight both the potential and challenges of ensemble-based inverse modeling for understanding post-wildfire hydrologic change in snow-dominated watersheds.}
}
@article{GUPTA2026136455,
title = {Balancing subsurface complexity and model simplicity: How much spatially distributed field data is needed to simulate streamflow in a subalpine critical zone},
journal = {Journal of Hydrology},
volume = {680},
pages = {136455},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136455},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015520},
author = {Aniket Gupta and Jean-Martial Cohard and Alix Reverdy and Romain Biron and Catherine Coulaud and Hervé Denis and Marc Descloitres and Thierry Dumont and Stéphane Garambois and Basile Hector and Jean-Pierre Vandervaere and Didier Voisin},
keywords = {Critical zone, Geophysical exploration, Parflow-clm, Snow hydrological modeling, Subalpine catchment, Subsurface heterogeneity},
abstract = {Representing subsurface heterogeneity in spatially-distributed hydrological models is particularly challenging, as geological and geophysical data are often sparse and infrequent. Hydrologists face two main challenges in subsurface characterization: determining the necessary depth and detail for accurate flow modeling, and developing cost and time-effective methods to capture subsurface heterogeneity. In this study, we conducted preparatory geological and geophysical surveys to investigate subsurface structures and develop conceptual models for the studied catchment. We began with a simple single-layer subsurface model based on initial field investigations and progressively refined it into a more complex three-layer model that incorporates geological, geophysical, and hydraulic properties measured in the field. These conceptual subsurface models were used to inform a 3D hydrological model applied to a 15.28 ha subalpine catchment at Lautaret Pass. Results show that both the three-layer homogeneous and three-layer heterogeneous models perform best, yielding comparable results for runoff (KGEnp = 0.89, 0.91), soil moisture (MAPE = 0.23, 0.22), and evapotranspiration (MAPE = 6.65, 6.60). The three-layer model introduces an active regolith layer at an optimal depth, which is responsible for storing and releasing infiltrated water. We argue that conceptual homogeneous models can meet hydrological objectives, provided they are grounded in reliable geological and geophysical field data. However, we also show that the heterogeneous model performs slightly better in capturing snowmelt amplitude, baseflow, evapotranspiration, and surface heterogeneities. These results highlight how cost and time-effective geophysical methods that capture vertical heterogeneity can be leveraged to upscale critical zone processes.}
}
@article{SWARR2026136471,
title = {Geodetic constraints on regional scale mountain bedrock aquifer properties},
journal = {Journal of Hydrology},
volume = {680},
pages = {136471},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136471},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015684},
author = {Matthew J. Swarr and Donald F. Argus and Zachary H. Hoylman and Brett J. Oliver and W. Payton Gardner},
keywords = {Groundwater, Western US water, Groundwater simulation, Mountain groundwater, Geodesy, Hydrogeodesy},
abstract = {Groundwater in mountainous, fractured-bedrock systems is increasingly recognized as a critical component of water storage and transmission, yet characterizing the hydraulic properties of these systems remains challenging due to sparse observations. Here, we use estimates of groundwater storage change in the Sierra Nevada and Cascades mountain ranges over the last two decades derived from Global Navigation Satellite Systems (GNSS) observations of vertical surface displacement to estimate mountain-range-scale effective groundwater hydraulic parameters. We estimate mountain-range-scale hydraulic conductivity and specific yield by fitting models of groundwater storage change to GNSS-derived storage estimates during groundwater discharge periods. We estimate hydraulic conductivity (7.03 × 10−6 m/s and 5.1 × 10−5 m/s) and specific yield (0.063 and 0.15) for the Sierra Nevada and Cascades, respectively, which align with published values based upon their unique bedrock lithologies. The relatively high hydraulic conductivities within each region indicate that fractured and/or weathered bedrock strongly influences the storage and release properties of these regional groundwater systems. The estimated characteristic drainage lengths of 727 m for the Sierra Nevada are consistent with average channel spacing of both perennial and intermittent streams, while the characteristic drainage length of 984 m for the Cascades is consistent with the average spacing of perennial streams only, indicating differing connections between surface water and groundwater within each region. This new method demonstrates the utility of geodetic observations in studying mountain groundwater systems and may provide improved constraints on large-scale simulations of mountain groundwater flow, furthering our understanding of these systems.}
}
@article{LI2026136447,
title = {A coupled flood forecasting framework of HYDRUS-1D and Xinanjiang models based on the transfer of physically-based soil moisture fields},
journal = {Journal of Hydrology},
volume = {680},
pages = {136447},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136447},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015441},
author = {Qiaoling Li and Yang Wang and Hongde Li and Xingwen Liu and Zhijia Li and Yang Xiao},
keywords = {Initial soil moisture, HYDRUS-1D, Xinanjiang model, State variable transfer, Model coupling, Flood forecasting},
abstract = {Initial soil moisture is a critical state variable influencing the accuracy of event-based flood forecasting. The Xinanjiang (XAJ) model often suffers from error accumulation and spatial homogenization when estimating initial soil moisture through recursive water balance calculations. To address this limitation, this study utilizes the physically-based HYDRUS-1D (H1D) model to support a more physically consistent initialization of the XAJ model and proposes a flood forecasting framework (XAJ-H1D) based on the transfer of physically-based soil moisture fields. By establishing a water balance-based soil moisture state variable transfer mechanism, the framework links the H1D model with the XAJ model for flood forecasting. In the near-dam area of the Wuqiangxi Reservoir, reliable soil moisture observations were obtained from the monitoring network after sensor calibration and used to support the calibration of H1D soil hydraulic parameters through an improved NSGA-II multi-objective optimization algorithm. Based on a virtual–actual integration strategy, the calibrated H1D model was extended from the in-situ monitoring stations to selected virtual stations, thereby increasing the spatial density of soil moisture simulation points across the basin. Soil moisture simulated at the 34 in-situ and virtual stations was subsequently averaged within each sub-basin to construct multilayer soil moisture fields. Physical conversion relationships were then applied to transform H1D-simulated volumetric water content into the soil water storage required by the XAJ model, allowing physically-based soil moisture information to be transferred into the subsequent recursive water balance calculations of the XAJ model. Results show that the optimized H1D model captures point-scale soil moisture dynamics with a mean root mean square error (RMSE) of 0.025 cm3·cm−3. Across 8 flood events in 2023 and 2024, the XAJ-H1D framework reduced the mean relative error of flood volume from 12.99% to 5.27% and that of peak discharge from 17.35% to 9.00%, while increasing the mean Nash-Sutcliffe efficiency (NSE) from 0.53 to 0.75 compared with the conventional XAJ initialization. More pronounced improvements were found during the early flood season or under relatively dry antecedent conditions. These results suggest that the proposed state variable transfer mechanism can mitigate initialization bias in conceptual hydrological models and improve basin-scale flood forecasting performance under the evaluated conditions.}
}
@article{YAN2026136411,
title = {Assessment of agricultural drought resilience in China based on coupled drought propagation and recovery processes},
journal = {Journal of Hydrology},
volume = {680},
pages = {136411},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136411},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015088},
author = {Ziyi Yan and Zhiming Han and Limin Duan and Wenrui Zhang and Fang Yang and Dexin Cui and Xiaolan Yu and Hu Liu and Jianan Wang and Zhi Li},
keywords = {Meteorological drought, Agricultural drought, Recovery threshold, Propagation threshold, Resilience index, Risk assessment},
abstract = {As extreme drought events become more frequent and intense, the recovery process has emerged as a critical component of drought risk assessment. However, existing studies have focused primarily on drought propagation, while the recovery process and its linkage to system resilience remain largely underexplored. Here we propose a logistic regression-based framework for identifying agricultural drought recovery thresholds. It incorporates initial soil moisture conditions to quantify the meteorological drought conditions required for agricultural drought to recover to normal conditions. Building on this framework, we construct a novel resilience indicator that integrates the propagation and recovery thresholds of agricultural drought. The results show that, compared with northwestern China, agricultural drought in southern China is more easily triggered by meteorological drought. Agricultural drought recovery thresholds and resilience exhibit a pronounced spatial pattern across China, with higher values in the northwest and lower values in the southeast. As initial soil moisture decreases, the standardized precipitation evapotranspiration index (SPEI) threshold required for agricultural drought recovery increases, whereas it gradually decreases with increasing lead time. Furthermore, the conditional probability of agricultural drought recovery rises markedly with higher SPEI thresholds. Agricultural drought resilience in China is predominantly governed by the propagation process. By coupling drought propagation and recovery processes, this study provides a new drought resilience indicator based on propagation and recovery thresholds. This framework provides a new perspective for assessing drought resilience and offers a scientific basis for refining drought risk assessment and improving the accuracy of drought early warning.}
}
@article{XU2026136439,
title = {A dual-channel framework for video-based rainfall intensity estimation using weakly supervised rain streak extraction},
journal = {Journal of Hydrology},
volume = {680},
pages = {136439},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136439},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015362},
author = {Jiarui Xu and Naliang Guo and Fubao Sun and Feng Wu},
keywords = {Opportunistic sensing, Rainfall intensity estimation, Surveillance video, Computer vision, Weakly supervised learning},
abstract = {High-spatiotemporal rainfall data are essential for hydrological analysis and urban flood early warning. By leveraging existing urban surveillance cameras, video-based rainfall intensity estimation is a potential high-resolution complement to traditional rainfall observations. However, most recent video-based methods feed the raw video clips into an end-to-end model for rainfall intensity estimation, and existing rain streak extraction algorithms cannot adapt to complex real-world daytime scenes. This impairs the capture of useful visual rainfall features, ultimately limiting estimation performance. To address these limitations, we first develop a weakly supervised rain streak extraction framework. It employs a self-learning network to generate rain-streak pseudo-labels, enabling adaptive extraction with weak supervision and knowledge distillation. Second, we design a dual-channel rainfall intensity estimation network grounded in an analysis of the formation mechanisms of visual rainfall features. This network independently extracts global visual features from raw frames and high-frequency features from rain streak layers. These features are then fused spatially and temporally for rainfall intensity estimation. Experiments on surveillance videos from two cameras with different imaging conditions demonstrate that the rain extraction framework can adaptively extract rain streaks while reducing interference from background disturbances. The dual-channel model was evaluated on six independent rainfall events recorded by a fixed surveillance camera, covering rainfall intensities from 0 to 1.1 mm/min, and achieved an NSE of 0.894, outperforming the raw-clip-only end-to-end baseline. These results demonstrate the effectiveness of the proposed dual-channel concept for video-based rainfall intensity estimation and may provide a potential rainfall sensing approach for future hydrological applications.}
}
@article{CHEN2026136431,
title = {Explainable method for advanced early-warning of hypoxic events in estuaries: coupling Kolmogorov-Arnold networks with self-attention mechanism},
journal = {Journal of Hydrology},
volume = {680},
pages = {136431},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136431},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015283},
author = {Xingda Chen and Chenyao Zhao and Xingming Liao and Anxiang Di and Jinyue Chen and Mengjun Ku and Zhenyu Gao and Zhen Zhang and Qianling Ci and Yida Lu and Lili Wen and Shuisen Chen and Peijian Zeng},
keywords = {Hypoxia, Estuaries, Early-warning, Kolmogorov-Arnold, Self-attention},
abstract = {Hypoxic events are increasingly threatening estuarine ecosystems, leading to the formation of dead zones and drastic shifts in ecosystem structure. However, existing dissolved oxygen (DO) predictions often struggle to capture long-term trends and achieve early-warning, and lack interpretability into driving factors. To address these limitations, this study proposes a novel interpretable deep learning method to forecast DO and capture hypoxic events, that was named as KTDO, which couples Kolmogorov-Arnold Networks (KAN) with a self-attention mechanism and training with noise-robust strategy (NRS). The method enables powerful global dependency modeling and enhanced capability of catching up the extreme hypoxic events (DO < 2 mg/L). Experiments are conducted based on 114,174 measurements from typical estuaries along coastal China, and (1) the KTDO has better performance than other eight state-of-the-art (SOTA) benchmarks in numerical DO prediction (mean R2 = 0.954, RMSE = 0.293 mg/L) and hypoxic events early-warning (Probability of Detection (POD) = 85.09%). (2) Ablation studies confirm the key role of the Kolmogorov-Arnold Spline Module (KASM) in capturing biogeochemical processes and the training strategy of NRS in improving generalization across heterogeneous estuaries (models with KASM and NRS have highest R2 and lowest RMSE in most estuaries). Further evaluation between KTDO and the Autoregressive Integrated Moving Average (ARIMA) model reveals the advantage of integrating both DO autocorrelation and supplementary water quality information, maintaining robust performance across all estuaries and time horizons (1-, 3-, 5-, and 7-day); notably, when the dominant DO_lag1 feature is removed, KTDO retains stable accuracy while ARIMA degrades sharply, confirming that this robustness stems from multivariate information fusion rather than reliance on the most recent DO observation. (3) Global interpretability analysis reveals a strong autocorrelation in the DO and lag features in time series and identifies two dominant prediction patterns: one driven by a few key features with huge contribution, and another by synergistic multi-feature interactions·NH3-N and pH contribute to DO prediction more frequently than other water quality parameters (WQPs) and the canonical WT-DO relationship is context-dependent and can be obscured in dynamic estuaries with high variability. (4) Deconstruction of model decision-making process in predictions with largest errors indicates that confounding effects among WQPs often mislead the direction of model output. (5) Cross-basin experiments further show that KTDO generalizes well at short lead times but degrades over longer horizons, underscoring the need to integrate multi-basin and multi-station information in future work. By providing accurate and interpretable numerical prediction together with hypoxia early warning, KTDO offers a potential solution for science-informed DO management.}
}
@article{WU2026136423,
title = {Improvement and testing of the SWAT model for simulating hydrological processes and non-point source pollution in the paddy-dominated polder},
journal = {Journal of Hydrology},
volume = {680},
pages = {136423},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136423},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015209},
author = {Haitao Wu and Zenglin Peng and Meng Xiang and Yufeng Luo and Yuanlai Cui},
keywords = {Modified SWAT, Polders, Hydrology, Paddy fields, Non-point source pollution},
abstract = {Paddy-dominated polders are critical agricultural landscapes in low-lying regions, where integrated irrigation-drainage management plays a decisive role in hydrological processes and non-point source (NPS) pollution dynamics. However, widely used watershed models like SWAT often oversimplify the unique structural and operational features of polders. This study developed SWAT-PP (SWAT for paddy-dominated polders) by incorporating key processes, including paddy water storage dynamics, sluice-gate-regulated water diversion, pumping-station-controlled drainage, and spatially distributed pond combinations. The SWAT-PP model was applied and tested in the Dongwan Polder (DWP) within China’s Chaohu Lake Basin. Results showed that SWAT‑PP effectively simulated field‑scale hydrology and nutrient dynamics (R2 > 0.6, NSE > 0.5, PBIAS < 25%) and outperformed both the original SWAT and the paddy‑adapted SWAT‑MD model, with better generalization in simulating monthly pumping‑station discharge, improving R2 and NSE by approximately 0.1 and reducing absolute PBIAS by about 1–11% compared to SWAT‑MD. The SWAT-PP model also simulated total nitrogen/total phosphorus (TN/TP) concentrations in the pumping station’s forebay (R2 > 0.5, NSE > 0.4, PBIAS < 15%). Water balance analysis indicated that irrigation contributed nearly 30% of total inflow, with about 17% of diverted water returning to ditches as tailwater. Nutrient source apportionment revealed that external river diversion and sediment resuspension each accounted for roughly 10% of total TN/TP loads, while ponds retained approximately 80%–90% of nutrients from residential runoff. SWAT-PP provides a promising tool for simulating coupled hydrological and water quality processes in polder systems, supporting improved water management and NPS pollution control in these vulnerable agro-hydrological settings.}
}
@article{ZHUO2026136475,
title = {A physically constrained multivariate bias correction framework for projecting compound drought and heatwave risk in the Yangtze River Basin},
journal = {Journal of Hydrology},
volume = {680},
pages = {136475},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136475},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015726},
author = {Yue Zhuo and Zhiyong Wu and Hai He and Salvatore Pascale and Zhenchen Liu and Yuqing Feng and Yangqian Li and Shuhao Mei},
keywords = {CycleGAN-BiLSTM, Multivariate bias correction, CMIP6, Compound drought and heatwave},
abstract = {Compound drought and heatwave (CDHW) events pose growing threats to water security and ecosystems in the Yangtze River Basin. Reliable projections require an accurate representation of the joint behavior of precipitation and temperature. However, biases in CMIP6 simulations and conventional univariate correction may distort this dependence, increasing projection uncertainty. This study developed a physically constrained, dependence-preserving multivariate bias-correction framework integrating CycleGAN, BiLSTM, and quantile delta mapping (QDM) to jointly correct daily precipitation, maximum temperature (Tmax), and minimum temperature (Tmin) from 13 CMIP6 models. The framework improved CDHW-relevant hot-dry dependence and reproduced the observed spatial pattern of historical normalized cumulative CDHW intensity with a correlation of 0.64. QDM compensation improved preservation of the raw CMIP6-projected Tmax warming signal, while CycleGAN–BiLSTM reduced Tmax–precipitation dependence errors relative to QDM alone. Under a fixed historical-reference heatwave threshold, projected CDHW occurrence increased, particularly under SSP5-8.5, mainly because more days exceeded the historical heat threshold. In contrast, under period-adaptive thresholds, CDHW occurrence conditional on concurrent heatwave and drought did not increase relative to the historical period. Sensitivity analyses showed that the magnitude and interpretation of projected CDHW changes depended on the heatwave-threshold definition and potential evapotranspiration formulation.}
}
@article{HUANG2026136467,
title = {Seasonal responses of chemical oxygen demand and dissolved oxygen to dam regulation in the Yangtze and Yellow Rivers during 1988–2018: Role of altered flow regimes},
journal = {Journal of Hydrology},
volume = {680},
pages = {136467},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136467},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015647},
author = {Anqi Huang and Guangyao Gao and Yadu Pokhrel and Liqiang Yao and Hong Zhang},
keywords = {Large River basin, Water quality, River discharge, Inter- and intra-annual variations, Dam regulation, Natural and anthropogenic factors},
abstract = {The riverine chemical oxygen demand (COD) and dissolved oxygen (DO) dictate water quality and biogeochemical health. Mega-dams substantially alter the flow regimes in large river basins, yet their impacts on seasonal COD and DO dynamics in the long term remain unclear. This study examined the changes in annual and monthly COD and DO exports from the Yangtze and Yellow Rivers during 1988–2018, and quantified the influences of natural and anthropogenic factors in the pre- and post-dam periods using the machine learning (ML) approach and partial least squares-structural equation modeling (PLS-SEM). There was a pronounced decrease in annual average COD in Yellow (−35.0%) but an increase in Yangtze (3.7%), and DO increased substantially in Yellow (9.8%) but remained stable in Yangtze from pre- to post-dam period. The seasonal variation of COD substantially weakened in Yellow, and the peak of COD and DO flux occurred one month earlier in Yellow but later in Yangtze in the post-dam period. The relationships of COD and DO fluxes with discharge became stronger in the post-dam period, especially in the Yellow. The COD-discharge coupling shifted toward enrichment in the Yangtze River and weakened in the Yellow River during the post-dam period. From the pre- to post-dam period, the relative contribution of hydroclimatic and vegetation factors in the Yangtze increased to 72.62% for COD flux and dominated COD and DO concentration variability in the Yellow over the Yangtze (56.60% vs. 38.02%). Altered flow regimes under dam regulation changed the timing and magnitude of COD and DO flux responses, and amplified the role of sediment as a carrier of organic pollutants. Furthermore, vegetation greening improves water quality in the Yellow, whereas increasing precipitation and discharge enhance pollutant mobilization in the Yangtze. This study reveals that dam regulation is strengthening the flow-water quality connection and elevating the relative importance of hydroclimatic and vegetation factors in explaining water quality variation, with important implications for sustaining riverine health in heavily regulated basins including the Mekong and Amazon.}
}
@article{CHEN2026136370,
title = {Understanding hydrological drought recovery patterns in a changing environment: Insights from a non-stationary multivariate analysis},
journal = {Journal of Hydrology},
volume = {680},
pages = {136370},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136370},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014678},
author = {Yeting Chen and Tao Peng and Vijay P. Singh and Ji Liu and Xiaohua Dong and Qingxia Lin and Jiali Guo and Chao Song and Changwen Li and Yinghai Li and Dan Yu and Chong Wei and Yan Huang},
abstract = {Understanding hydrological drought recovery under non‑stationary conditions is critical for water management in a changing environment, yet remains poorly quantified. This study presented a novel grid‑based, daily‑scale framework that integrated non‑stationary drought identification, multivariate probabilistic recovery assessment, and machine learning driver analysis. Applied to the four sub‑basins of the Dongting Lake basin (DLB), a non‑stationary Standardized Runoff Index (NSRI) was constructed using the GAMLSS framework with large‑scale climate indices as covariates. Drought recovery characteristics, including recovery time, water requirement (WR), and recovery probability, were estimated using run theory and a copula‑Bayesian approach, with random forest (RF) used to rank the influencing factors. Results showed that NSRI captured drought onset and peak more sensitively than the stationary SRI. The average recovery time ranged from 83.5 days in the Zi River (ZR) to 97.3 days in the Li River (LR), revealing notable spatial heterogeneity across the basin. WR increased sharply under severe and extreme drought conditions, while recovery probability dropped below 0.61 for extreme drought. Human activities, particularly water use and population density, dominated drought recovery in three sub‑basins, whereas climate and vegetation factors controlled recovery in the fourth. This framework enhances the accuracy and spatial resolution of drought recovery assessments and provides quantitative support for adaptive water management under a changing environment.}
}
@article{FANG2026136443,
title = {Water quality data imputation based on spatial neighborhood-aware and error-adaptive dynamic fusion model},
journal = {Journal of Hydrology},
volume = {680},
pages = {136443},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136443},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015404},
author = {Xinwei Fang and Zhonglian Jiang and Lei Liu and Xuejun Feng and Jianqun Guo},
keywords = {Water quality, Data imputation, Spatial neighbourhood features, Error-adaptive fusion, Marine environmental management},
abstract = {Marine water quality data frequently suffer from missing values, undermining the reliability of data analysis and the scientific basis for environmental management decisions. To enhance the completeness and accuracy of water quality data imputation, a Spatial Neighborhood-aware and Error-Adaptive dynamic Fusion (SN-EAF) imputation model has been proposed. It improves the spatial perception capability by constructing enhanced spatial neighborhood information features, employs multiple base imputation models with error predictors to assess sample-level prediction errors, and eventually achieves personalized data fusion through dynamic weighting. Experimental results demonstrate that, for salinity indicator, the proposed model achieved mean R2 values of 0.913 (Missing Completely at Random) and 0.868 (Continuous Block Missing), while the RMSE was reduced by 12.1%–28.2% and 17.4%–30.1% approximately, compared with the best-performing base model. The model adaptively adjusts the weights of base models according to the spatial distribution characteristics of water quality parameters, with error-prediction R2 values ranging from 0.759 to 0.909 for three representative base models under two data missing scenarios. It consistently outperforms the contrast methods across four additional water quality indicators (Dissolved Oxygen, Total Nitrogen, Particulate Organic Carbon and Chlorophyll-a) and 19 distinct data missing scenarios. The results verify its robustness in complex marine monitoring applications and provide a promising tool for intelligent imputation of marine water quality indicators. The present study shares valuable insights into the data imputation and marine environmental management.}
}
@article{ZHANG2026136459,
title = {Influence of water network structure on regional water allocation under supply variability},
journal = {Journal of Hydrology},
volume = {680},
pages = {136459},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136459},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015568},
author = {Yalin Zhang and Xin Li and Wenyan Wu and Lixiang Dong and Guohua Fang and Huayu Zhong},
keywords = {Regional water allocation, Water network structure, Water supply variability, Complex network, Multi-objective optimization},
abstract = {Regional water systems are increasingly shaped by interannual variability in allocatable water supply and growing interconnection across spatial scales. While existing studies primarily treat water availability as an exogenous constraint, the role of water network structure in conditioning allocation outcomes under variable supply remains insufficiently understood. This study treats regional water allocation as a structurally constrained process, in which network topology influences resource accessibility, transmission pathways, and redistribution capacity. An integrated framework has been developed to link supply uncertainty characterization, complex network-based structural representation, and multi-objective allocation modeling. Using the coupled system of the Taizhou water network and the Eastern Zhejiang Water Transfer Project as a case study, a series of water network structure scenarios have been constructed to represent different development pathways. Results show that network structure strongly affects allocation performance under supply variability: enhanced connectivity and path redundancy improve shortage mitigation and equity without increasing total supply, while also enabling more efficient utilization of externally introduced water resources. Moreover, the effects of supply expansion depend strongly on the underlying network configuration, highlighting the interdependence between infrastructure development and allocation outcomes. These findings indicate that water network structure strongly influences allocation performance and supply utilization under uncertainty. The proposed framework provides a systematic basis for evaluating structural interventions and supports the transition from supply-centric planning toward structure-informed optimization of regional water systems.}
}
@article{XIONG2026136435,
title = {Regional landslide early warning through machine-learning-based rainfall threshold and hydromorphological slope units},
journal = {Journal of Hydrology},
volume = {680},
pages = {136435},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136435},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015325},
author = {Muqi Xiong and Youcun Qi and Zhanfeng Zhao and Xun Li},
keywords = {Rainfall-induced landslides, Rainfall threshold, Slope units, Machine learning, Landslide early warning},
abstract = {Regional landslide early warning (LEW) remains a fundamental challenge because of the spatial heterogeneity of hydrological–geomorphological units and the nonlinear responses inherent in rainfall-triggering processes. This study develops an integrated LEW framework that combines landslide susceptibility prediction (LSP) with rainfall-threshold modeling based on machine learning (ML) to advance the quantitative characterization of regional-scale rainfall-landslide hydrology. For spatial characterization, we propose a novel LSP model that integrates hydrological analysis (HA) and multi-scale segmentation (MSS) to better represent hydromorphological controls on the spatial distribution of slope failures. The HA–MSS model demonstrates strong spatial discriminability: “very high susceptibility” zones capture 69.33 % of observed landslides while occupying only 6.76 % of the total area. For temporal prediction, an ML-based rainfall-threshold model trained jointly on triggering and non-triggering events achieves a probability of detection of 0.82, an accuracy of 0.85, a probability of false detection of 0.13, and a Hanssen–Kuipers index of 0.69, substantially outperforming the empirical E–D baseline. Feature-importance analysis identifies event cumulative rainfall (ECR), maximum intensity (Imax), intensity (I), and duration (D) as dominant predictors, whereas antecedent rainfall variables (AR3, AR5, AR7) contribute 35.2 % of the total feature importance, highlighting the importance of antecedent wetness conditions in rainfall-induced landslide triggering. The integrated framework supports dynamic warning updates at hourly resolution through a spatiotemporal warning matrix. Retrospective assessment of the integrated LEW showed that approximately 87 % of historical landslides were associated with red or orange alert levels, while the August 2021 hindcast reproduced the temporal escalation and spatial evolution of warning levels during an intense rainfall event.}
}
@article{WANG2026136451,
title = {Physics-informed hydrological graph neural network for distributed daily streamflow prediction in directed river networks},
journal = {Journal of Hydrology},
volume = {680},
pages = {136451},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136451},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015489},
author = {Tao Wang and Dingzhi Peng and Yuwei Gong and Xingtong Chen and Qianxue Yang and Linghua Qiu and Yunqing Xuan},
keywords = {Graph neural network, Physics-informed, Streamflow forecasting, Spatiotemporal extrapolation},
abstract = {The basin in high-altitude mountainous areas is constrained by sparse station networks, complex river networks, and significant non-stationary hydrological processes, making it difficult for traditional time series models to simultaneously consider spatial connectivity and physical consistency. To address this issue, we propose Physics-Informed Hydrological Graph Neural Network (PI-HydroGNN) for distributed daily streamflow prediction in directed river networks. It combines temporal feature extraction, upstream connectivity and topological inflow aggregation, graph-based topology message passing, and physical constraints in a unified framework to represent temporal dynamics, river-network connectivity, and local mass conservation. The model was evaluated through comparisons with independent station-wise LSTM, regional multi-output LSTM, GCN and SWAT, together with ablation experiments, multi-step forecasting, analysis of Quality Balance Violations and ungauged basin extrapolation. The results showed that PI-HydroGNN outperformed the benchmark models in the training, validation, and testing periods, with an average NSE of 0.84 during the testing period and a RMSE reduction of about 16% compared to station-wise LSTM. The ablation experiment results showed that all the modules we considered made significant contributions to the predictive performance and exhibited significant spatial heterogeneity. At Yangbajing, the model still maintains good simulation ability, with an NSE of 0.79 and an R2 of 0.80, providing preliminary evidence of its spatial extrapolation capability. Overall, this study demonstrates that combining prior knowledge of hydrological physics with graph learning offers a promising approach for streamflow prediction in complex river networks, and suggests potential for application in ungauged basins that should be further validated under broader hydro-climatic conditions.}
}
@article{ZHANG2026136454,
title = {Nitrate transport and transformation in riverbeds under vegetation-induced hyporheic exchange},
journal = {Journal of Hydrology},
volume = {680},
pages = {136454},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136454},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015519},
author = {Siyi Zhang and Kaiwen Zhang and Yuhang Tian and Hexiang Chen and Xinyi Luo and Guangqiu Jin},
keywords = {Surface water-groundwater interface, Hyporheic exchange, Nitrogen cycling, Denitrification, Reactive transport, Emergent vegetation},
abstract = {Flow around emergent vegetation creates spatial pressure differences along the riverbed surface, but the resulting effects on nitrate delivery and transformation in the hyporheic zone remain insufficiently quantified. A three-dimensional model was developed to couple overlying flow, pore water flow, and reactive solute transport in a permeable riverbed. The results show that vegetation altered solute transport from shallow diffusion near the sediment surface to advective exchange driven by pressure gradients. Compared with the flat bed, vegetation increased nitrate influx into the bed by about 7 orders of magnitude under the reference conditions, while total denitrification was 6.8 times that in the flat-bed case. The difference in nitrate influx between the flat-bed and vegetated cases varied with background hydraulic gradient and flow velocity. Streamwise spacing (Sx) mainly affected the solute transport pathway length in the pore water and the residence time. Shorter Sx promoted oxygen supply and nitrification near the surface, whereas larger Sx increased the residence time and expanded anoxic zones favorable for denitrification. The nitrate consumption fraction at Sx = 20 cm was 1.79 times that at Sx = 3 cm. Spanwise spacing mainly affected the exchange rate and oxygen penetration. Higher flow velocity increased nitrate influx and reaction rates, but reduced nitrate consumption fraction because pore water returned to the surface water before nitrate reduction was complete. These results indicate that nitrate removal in riverbeds with vegetation is not determined by the exchange rate alone. Péclet (Pe) − Damköhler (Da) analysis showed that high Pe favored nitrate supply, while high Da indicated a longer residence time relative to the characteristic time scale of DOC oxidation. The most favorable condition occurred when nitrate supply and residence time were both maintained. At low flow velocity and wider vegetation spacing, residence time was longer (Da = 1536.7, Pe = 5.7) and the nitrate consumption fraction was the highest. Under high velocity and dense spacing, nitrate supply was high (Pe = 472.8), but nitrate consumption fraction was lowest because the residence time was short (Da = 16.4). Power-law regressions described the relationships among Reynolds number, vegetation spacing, nitrate influx, nitrate consumption rate, and consumption fraction. This study explains how hyporheic exchange induced by vegetation affects nitrate transport and transformation in riverbeds by altering nitrate supply, residence time, and reaction conditions.}
}
@article{LIU2026136429,
title = {Drought recurrence across China under diverse ENSO and IOD modes (1941–2023)},
journal = {Journal of Hydrology},
volume = {680},
pages = {136429},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136429},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601526X},
author = {Zhenchen Liu and Wen Zhou and Bo Tong and Zhiyong Wu and Hao Yin},
keywords = {Drought event, China, ENSO, IOD, Drought recurrence},
abstract = {El Niño‑Southern Oscillation (ENSO) and Indian Ocean Dipole (IOD) strongly modulate extreme droughts across China. When particular ENSO/IOD modes recur, extreme droughts can repeatedly occur within consistent regions and seasons, a phenomenon defined herein as “ENSO/IOD‑related drought recurrence”. Although this phenomenon suggests predictable drought responses, the underlying characteristics and physical mechanisms remain poorly understood. This study aims to systematically characterize ENSO/IOD‑related drought recurrence over China and reveal its associated physical drivers. Based on historical extreme drought events for 1941‑2023, we adopt an event‑based ENSO/IOD classification system, and apply the newly proposed three‑dimensional Drought Recurrence Index (DRI) to identify recurrent drought groups. Linear baroclinic model and ocean‑atmosphere coupling sensitivity experiments are further used to diagnose circulation responses forced by typical SSTA patterns. Our analyses show that approximately 75% of the identified extreme drought events are associated with specific ENSO/IOD modes, among which ∼ 53% occur during the developing phases of El Niño or La Niña. Distinct response asymmetry exists: developing‑phase El Niño triggers near‑immediate drought responses within two months, whereas La Niña produces large‑scale, persistent droughts with lags longer than five months. Eight groups of recurrent droughts are further distinguished. Summer‑autumn droughts over northern China during El Niño development represent the most frequent recurrence pattern, while compound La Niña‑negative IOD modes drive cross‑seasonal and cross‑regional recurrent drought events. Model experiments reproduce these asymmetric drought responses under representative summertime El Niño, autumn positive‑IOD, and cross‑seasonal La Niña SSTA forcing. These results provide an important reference for developing long‑term drought prediction systems incorporating ENSO/IOD signals.}
}
@article{WANG2026136450,
title = {Warm-wet shift reshapes hydroclimatic synchronization networks across the Arid Area of Northwest China},
journal = {Journal of Hydrology},
volume = {680},
pages = {136450},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136450},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015477},
author = {Jiayou Wang and Zhi Li and Yaning Chen and Ruiting Wu and Lingxin Kong},
keywords = {Warm–wet shift, Hydroclimatic synchronization, Normalized mutual information, Community structure, Mean first passage time, Complex network},
abstract = {Global warming has profoundly reshaped hydroclimatic regimes in the Arid Area of Northwest China (AANC), yet how the regional warm–wet shift reorganizes hydroclimatic synchronization and drought propagation dynamics remains poorly understood. Based on multi-timescale SPEI records (1962–2021) from 114 stations, we built constrained hydroclimatic synchronization networks via normalized mutual information. Temporal autocorrelation was accounted for through prewhitening, while spatial dependence was assessed and statistically controlled using topography-constrained null models, allowing us to examine stage-varying network topology and propagation dynamics. The warm–wet transition was initiated by an abrupt precipitation increase in 1987, followed by a stepwise temperature rise in 1997. During the transition period (1988–1996), short-timescale synchronization networks became highly fragmented, with sharply reduced connectivity, enhanced community partitioning and strongly inhibited propagation, indicating a temporary breakdown of regional hydroclimatic coherence. In contrast, long-timescale networks remained relatively integrated, with weaker community boundaries and more efficient large-scale propagation driven by persistent low-frequency hydroclimatic variability. Across all stages, longer SPEI accumulation timescales consistently strengthened network connectivity while weakening community partitioning and propagation barriers, revealing robust timescale-dependent reorganization of hydroclimatic synchronization. Comparisons between raw and residual networks further confirm the robustness of observed patterns and highlight notable long-timescale biases induced by temporal persistence. These findings demonstrate that the AANC warm–wet shift represents a nonlinear reorganization of hydroclimatic synchronization through coordinated reorganization of network topology, community structure and propagation dynamics, rather than a simple regional wetting process, providing new insights into drought synchronization mechanisms and hydroclimatic risk propagation in arid regions.}
}
@article{JIANG2026136502,
title = {The effect of macropore flow on nitrogen migration and transformation in layered media structure bioretention systems},
journal = {Journal of Hydrology},
volume = {680},
pages = {136502},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136502},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015994},
author = {Chunbo Jiang and Yizhuo Gou and Junpeng Zhang and Jiayu Gao and Jiake Li},
keywords = {Bioretention, Macropore flow, Media structure, Nitrogen transformation, Seasonal differences},
abstract = {Macropore flow, a manifestation of preferential flow, strongly affects water and solute transport in bioretention media, but previous studies have often relied on short-term experiments, influent and effluent measurements, or homogeneous media simulations. To address these limitations, this study combined three seasonal experimental phases in pilot-scale systems that had operated for seven years, post-experiment X-ray computed tomography (CT) analysis of the internal macropore network, and HYDRUS-3D dual-porosity simulations of homogeneous and layered media. Effluent Cl− concentrations varied more widely in the homogeneous system than in the layered systems, consistent with flow redistribution caused by local saturation at the coarse–fine interface. The ANOVA results show that seasonal factors have a significant impact on breakthrough time and average effluent Cl− concentration, while the medium structure has a significant effect on breakthrough time. Using the total influent ammonium mass as the denominator, the mean fractions across summer, autumn, and winter were 4.89% unreacted, 7.91% soil adsorbed, 1.58% present as intermediate products, 5.28% immobilized by microorganisms, 12.54% nitrified, 14.80% taken up by plants, and approximately 53% assigned to the mass-balance residual attributed to gaseous losses. Overall, seasonal effects were more widespread, with all seven fractions significantly affected (P < 0.05). CT scan slices of soil columns were imported into AVIZO 2022 3D image processing software to construct a visual 3D model of the pore structure of the samples. The upper-layer samples had higher macroporosity (10.07%–12.66%), connectivity (8.36%–10.79%), and pore volume (141 × 103–179 × 103 mm3) than the lower-layer samples. The three-dimensional equivalent pore size in the media is mainly 0.75 ∼ 1 mm(≈55%), yet their volumetric contribution was only 2.35%–5.51%. A dual-porosity model within HYDRUS-3D was calibrated and validated for simulating macropore water flow (R2 > 0.95) and solute transport (R2 > 0.71 and NSE > 0.65), providing satisfactory performance for comparative scenario analysis. The simulation results predict that the coarse-over-fine layered structure can more effectively utilize the adsorption capacity of the filter media under various inflow conditions.}
}
@article{BEN2026136426,
title = {A spatiotemporal decomposition–coordination optimization method for multi-objective real-time flood-control operation of cascade reservoir systems},
journal = {Journal of Hydrology},
volume = {680},
pages = {136426},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136426},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015234},
author = {Mengxue Ben and Ping-an Zhong and Feilin Zhu and Bin Wang and Yukun Fan and Juan Chen and Yu Han and Zixin Song and Bin Xu and Sunyu Xu},
keywords = {Flood-control operation, Cascade reservoir systems, Recursive excess water volume, Large-scale system decomposition–coordination},
abstract = {Cascade reservoir systems involve close upstream–downstream hydraulic connections and complex spatiotemporal interactions with flood-control sections, leading to a high-dimensional and strongly coupled model for real-time joint flood-control operation. To address this issue, this study proposes a spatiotemporal decomposition–coordination optimization framework based on recursive excess water volume. By introducing the concept of recursive excess water volume, the framework transforms the spatiotemporally coupled flow constraints into a spatially coordinated water-volume allocation problem. It then establishes a decomposition structure integrating spatial allocation, temporal operation, and feedback coordination, thereby enabling structural decoupling and efficient solution of the complex joint operation problem. Multi-scenario numerical experiments are conducted for the cascade reservoir system in the lower Jinsha River. The results show that: (1) The proposed framework reduces the coordination complexity of joint operation under strong spatiotemporal coupling and enables decomposition-based solution of high-dimensional spatiotemporal optimization problems, with the computation time (CT) for a single operation scheme remaining below 1 s. (2) The proposed framework exhibits strong adaptability to different scenarios and satisfies the requirements of joint flood-control operation, with the safety constraint deviation (SCD) at the primary control section remaining within 2% and the coefficient of variation (CV) of reservoir risk indices remaining below 0.02. (3) Compared with conventional multi-objective evolutionary algorithms, the proposed framework generates trade-off solution sets with superior overall performance and produces more balanced and interpretable risk-sharing solutions among reservoirs. The proposed framework provides methodological support for real-time flood-control operation of cascade reservoir systems.}
}
