@article{YI2026135820,
title = {Molecular responses of dissolved organic matter to surface water–groundwater interactions in the Tibetan Plateau},
journal = {Journal of Hydrology},
volume = {677},
pages = {135820},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135820},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009170},
author = {Bing Yi and Shiyu Liu and Wei He and Xiaorui Chen and Xu Cao and Wei Kang and Xianjiang Zeng and Xian-ge Wang and Bing Zhou and Liang Zhu and Fei Liu},
keywords = {Tibetan Plateau, Surface water–groundwater interactions, Dissolved organic matter, Fourier transform ion cyclotron resonance mass spectrometry},
abstract = {Surface water-groundwater interactions (SGI) zones act as critical biogeochemical hotspots regulating the transport and transformation of dissolved organic matter (DOM) in alpine watersheds, where seasonal precipitation and snowmelt influence carbon cycles by modulating SGI patterns. To elucidate these complex hydro-biogeochemical linkages within a representative alpine context, optical indices, molecular characteristics, and stable water isotopes were combined to investigate DOM sources, composition, and transformation in surface water and groundwater in the Datonghe watershed, a typical high-altitude catchment in the northeastern Tibetan Plateau characterized by intense and climate-sensitive SGI. The main findings showed that DOM in groundwater predominantly recharged by precipitation (GRP) exhibited lower aromaticity and double bond equivalents (DBEwa = 7.4), higher S275-295 values (15.46 ± 9.77 μm−1), and enrichment in aliphatic compounds and peptides. In contrast, surface water and non-GRP groundwater were dominated by aromatic hydrocarbons and carboxyl-rich alicyclic molecules (CRAM) with higher molecular weights. Notably, GRP contained five times more high-oxygen sulfur compounds (O/S > 12) than other water types, suggesting oxidative inputs from atmospheric aerosols. Overall, precipitation intensity drove DOM dynamics by activating distinct SGI pathways. SGI functioned as bidirectional yet asymmetrical biogeochemical regulator. Although vertical recharge during intense rainfall delivered photochemically oxidized, aliphatic-rich atmospheric signatures into the aquifer, lateral transport drove intensive redox-mediated nitrogen and sulfur transformations. Consequently, whereas groundwater underwent robust molecular reworking, the riverine DOM pool remained shaped by the mixing of recalcitrant, subsurface-processed groundwater end-members. Therefore, hydrological connectivity and recharge pathways exerted first-order controls on DOM oxidation, redox turnover, and carbon mobility across the surface water–groundwater continuum.}
}
@article{LIU2026135771,
title = {FlowGATFormer: A streamflow prediction model based on spatiotemporal dual attention},
journal = {Journal of Hydrology},
volume = {677},
pages = {135771},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135771},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008681},
author = {Feng Liu and Zhigang Han and Jingru Ma and Peiqing Xiao and Pan Zhang and Fengrui Chen and Xiang Yu},
keywords = {Streamflow modeling, Spatiotemporal prediction, Attention mechanism, Graph neural network, LSTM},
abstract = {Achieving high accuracy in long-term river streamflow prediction is essential for simulating the terrestrial hydrological cycle and managing water resources. However, traditional hydrological models are often computationally expensive and require complex parameter estimation and calibration. Deep learning models, particularly long short-term memory (LSTM) networks, have shown promise in streamflow forecasting, but their predictive accuracy tends to decrease at longer forecast horizons. To address these issues, this study proposes FlowGATFormer, a streamflow forecasting model that integrates a graph attention network (GAT) with the Informer architecture. The model introduces a dual spatiotemporal attention to capture spatial dependencies and temporal dynamics in river systems. FlowGATFormer is applied to predict streamflow at five forecast horizons including 1, 6, 12, 16, and 24 days ahead. Specifically, the GAT models spatial dependencies among hydrological stations located upstream and downstream of a river network, while the Informer captures temporal dependencies within long-term streamflow series derived from the same hydrological station. Based on data from 11 stations in the CAMELS-CH dataset (1999–2020), FlowGATFormer significantly outperforms baseline models by achieving a Nash–Sutcliffe efficiency (NSE) of 0.5616 (NSE > 0.5) for the 12-day-ahead prediction. Compared to the LSTM baseline, the NSE improvement gradually increases with the prediction horizon, rising from 3.09% for the 6-day-ahead prediction to 10.98% for the 24-day-ahead prediction. We believe that the FlowGATFormer has the potential to be a robust data-driven approach for high-accuracy, long-term river streamflow prediction.}
}
@article{PAL2026135816,
title = {Extending dam-system efficiency in arid regions via sediment-connectivity modeling and multi-objective optimization},
journal = {Journal of Hydrology},
volume = {677},
pages = {135816},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135816},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009133},
author = {Debasish Pal and Sonam S. Dash and Nikola Ivanović and Stefano Galelli and Hannu Marttila and Hylke E. Beck},
keywords = {Water erosion, Reservoir sedimentation, Dam-system planning, Multi-objective optimization, Evolutionary algorithms, Arid watersheds},
abstract = {Dam-systems are critical for water security and flood protection in arid region watersheds, yet their performance is often compromised by rapid reservoir sedimentation. Traditional planning often prioritizes individual site capacity, neglecting the cascading sediment fluxes through the dam-system within drainage networks of the watershed. This study presents a comprehensive modeling and optimization framework for sediment-informed dam-system planning. The methodology integrates the WaTEM/SEDEM model, which quantifies spatially distributed erosion and sediment delivery to the drainage network, with StoDyM+ (Storage Dynamics Model Plus), a directed-network model simulating cascading sediment routing through the dam-system. This approach quantifies annual variations in reservoir sediment trapping, remaining storage, and dam lifespans. To solve this high-dimensional problem—characterized by the simultaneous optimization of spatial locations and storage capacities across five competing objectives of system longevity, sediment retention capacity, and functional resilience—the framework utilizes a multi-objective optimization approach powered by the advanced evolutionary algorithm, NSGA-III. Applied to the Wadi Baysh watershed (7076 km2), Saudi Arabia, using the same number of dams and cumulative storage as the existing system, results demonstrate that a connectivity-based redistribution of locations and storage configurations substantially improves dam-system performance. The optimized configuration achieved a mean dam lifespan of 77 years, compared to 47 years for the existing infrastructure, showing improved siltation resilience by better balancing sediment inflows to the reservoirs with their respective storage volumes. The framework provides a scalable decision-support tool for cost-effective planning and sustainable water infrastructure management in data-scarce, erosion-prone arid watersheds.}
}
@article{WANG2026135811,
title = {Mechanism of differential regulation of hydrogeological parameters (V and K) on denitrification (DEN) and dissimilatory nitrate reduction to ammonium (DNRA) under groundwater-surface water interaction},
journal = {Journal of Hydrology},
volume = {677},
pages = {135811},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135811},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600908X},
author = {Xihua Wang and Zejun Liu and Y.Jun Xu and Chaomeng Dai and Rongbing Fu and Nianqing Zhou and Boyang Mao and Shunqing Jia and Chengming Luo},
keywords = {Groundwater-surface water interaction, Migration and transformation, Machine learning, Nitrogen-nitrate, Soil column experiments},
abstract = {Due to the differences in hydrological and environmental characteristics, the interaction between groundwater (GW) and surface water (SW) causes the complexity of material migration and transformation in the interaction zone. However, the specific mechanisms by which flow velocity (V) and hydraulic conductivity (K) differentially regulate denitrification (DEN) and dissimilatory nitrate reduction to ammonium (DNRA) through hydraulic retention time remain unclear. This study conducted a series of one-dimensional soil column experiments, through changing the GW-SW interaction mode, V and K, the influence of hydraulic conditions on nitrogen-nitrate migration and transformation was evaluated. Light Gradient Boosting Machine (LightGBM) and SHapley Additive exPlanations (SHAP) methods were applied to study influencing factors of nitrogen migration and transformation. Results showed that during the process of GW recharge SW, higher V and lower K led to an accelerated increase of the growth rate of c(NO3–-N) in the sediment layer and base soil layer, the equilibrium concentration of c(NO3–-N) in the sediment layer also increased. c(TN) showed the similar trend and decreased in the reaction equilibrium stage. c(NO2–-N) and c(NH4+-N) showed the reverse trend as V decreased and K increased. During the process of SW recharge GW, the decreasing rate of nitrogen concentration accelerated as V increased and K decreased. SHAP analysis identified EC, DOC, pH, Eh and T as the most influential environmental factors governing nitrogen speciation. c(NO3–-N), c(NO2–-N) and c(NH4+-N) was the main factor affecting c(TN). Our key innovation is the systematic decoupling of how V and K differentially regulate DEN and DNRA through hydraulic retention time. Results provided important references for hydrological cycling, nitrogen pollution and control and ecological environmental effects of GW-SW interaction.}
}
@article{ROTH2026135832,
title = {An analysis of direct and indirect methods of estimating evaporation from a water supply reservoir},
journal = {Journal of Hydrology},
volume = {677},
pages = {135832},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135832},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009297},
author = {Holly A. Roth and Peter D. Blanken},
keywords = {Evaporation, Eddy covariance, Reservoir, Water management, Water balance},
abstract = {Evaporation is an important but often misrepresented or neglected term in managing water supply reservoirs. Many methods are available to estimate evaporation, but it is important to understand the practicality, error, and uncertainty among methods. To address this, we compared evaporation rates from six methods: the eddy covariance technique, a Class-A evaporation pan, an evapotranspiration gauge, the mass-transfer and bulk aerodynamic formulae, and a Bowen ratio estimate for May–October 2020–2024. Since meteorological measurements used for empirical estimates are often land-based, we assessed the influence of fetch on these estimates. Compared to water-fetch conditions, land-fetch winds were weaker (−1.0m s−1) and advected hotter (+0.7°C) and drier (+0.3 kPa, vapor pressure gradient) conditions to the sensors. Taking fetch effects into account, the mass-transfer estimate agreed best with eddy covariance and Bowen ratio estimates on seasonal timescales. A monthly, site-specific coefficient improved total study period evaporation pan-based water balance calculations by an average of 0.5x106 m3 and reduced uncertainty by up to 4% in the summer months. An important finding was the influence of heat storage change and fluctuating water levels on evaporation estimates, as displayed by Bowen ratio estimates. These estimates increased in the fall when water levels were low and stored heat was being released, yet eddy covariance and other methods often decreased. This study exemplified the variability intrinsic to evaporation estimates, but elucidated physical drivers of that variability so managers can make informed decisions that are accessible to their needs.}
}
@article{CHOWDHURY2026135808,
title = {Spatiotemporal quantification of relative contributions of compound flood drivers using Shapley value-based approach},
journal = {Journal of Hydrology},
volume = {677},
pages = {135808},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135808},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009054},
author = {Md Enayet Chowdhury and Jun-Whan Lee and Wonhyun Lee},
keywords = {Compound Flooding, Relative Contribution, Shapley Value, Hurricane Beryl, Hurricane Harvey, SFINCS},
abstract = {Understanding flood driver interactions is essential for assessing compound floods, as their nonlinear contributions largely determine flood severity. This requires quantifying the spatiotemporal contributions of each driver to the compound water level across all combinations. Although several mathematical approaches have been developed, none fully account for all possible driver combinations or accurately represent the proportional contribution of each driver to the compound water level. To address these limitations, we introduce a Shapley value-based approach to compute the relative contributions of four flood drivers: tide, storm surge, river discharge, and precipitation, simulating Hurricane Beryl (2024) in the Houston–Galveston region, Texas. The spatiotemporal analysis revealed how compound flooding changes across space and time, including instances where certain drivers contributed negatively (reduced the compound water level when considered nonlinearly along with other flood drivers) to the overall water level. The comparison with Hurricane Harvey confirmed the method’s ability to capture variations in flood driver contributions across different hurricanes. By incorporating all driver combinations with non-uniform weights, our method accurately reproduced the compound water levels, including all four flood drivers. Overall, this Shapley value-based approach provides new insights into the spatiotemporal dynamics of each flood driver’s contributions and has the potential to inform flood driver-specific, targeted mitigation and risk management strategies.}
}
@article{ZHANG2026135812,
title = {Station-based assessment of reanalysis surface air temperature and warming trends over the Tibetan Plateau (1980–2018)},
journal = {Journal of Hydrology},
volume = {677},
pages = {135812},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135812},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009091},
author = {Shun Zhang and Zhiguo Li and Ning Xu and Yongqiang Zhang and Xinyu Zhu and Yetang Wang},
keywords = {Reanalysis data, Surface air temperature, Tibetan Plateau, Warming trends},
abstract = {The Tibetan Plateau (TP), one of the most climate-sensitive and hydrologically crucial regions on Earth, poses significant challenges for the accurate estimation of surface air temperature. In this study, we evaluate five widely used global reanalysis datasets (ERA-Interim, JRA-55, MERRA-2, ERA5, ERA5-Land) against observations from 132 meteorological stations during 1980–2018. For daily temperature accuracy, the overall ranking is JRA-55 > ERA-Interim > ERA5 > MERRA-2 > ERA5-Land. JRA-55 and ERA5 provide the most reliable overall representation of warming trends over the TP. The observed median annual warming trend is about 0.45 °C/decade, with the strongest warming in winter (0.47 °C/decade). All five reanalysis datasets show negative trend biases, indicating systematic underestimation of observed warming. Errors are largest in winter and are consistently concentrated in the topographically complex and monsoon-influenced southeastern TP, a hydrologically important headwater region. The post-2000 warming dipole, characterized by accelerated warming in the southeast and relative slowdown toward the northeastern TP, is reproduced best by JRA-55 and ERA-Interim and is weakest in MERRA-2. Overall, JRA-55 provides the highest overall accuracy, while JRA-55 and ERA5 provide the most reliable representation of warming trends over the TP.}
}
@article{ZHU2026135747,
title = {A physics-guided and interpretable machine learning framework for rapid flood inundation mapping in complex flood retention areas},
journal = {Journal of Hydrology},
volume = {677},
pages = {135747},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135747},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008449},
author = {Changjun Zhu and Ting Zhang and Qiang Ma and Aiqing Kang and Yunpeng Bai and Chengjian Wang and Philippe Gourbesville},
keywords = {Flood inundation mapping, Synthetic Aperture Radar (SAR), Physics-guided machine learning, Explainable AI (XAI), Flood retention area, Emergency response},
abstract = {Rapid and accurate flood mapping using Synthetic Aperture Radar (SAR) imagery is a critical tool for emergency response. While machine learning (ML) models have significantly enhanced the accuracy and efficiency of flood mapping, their “black box” nature limits their trustworthiness for critical emergency response applications. To address this issue, we developed an interpretable flood mapping framework based on Gaofen-3 (GF-3) SAR imagery that fuses remote sensing physics with data-driven analysis. The framework comprises three core components: (1) a novel physics-guided feature, the Generalized Normalized Difference Polarization Index (GNDPI), which transforms skewed backscatter data into a more separable bimodal distribution; (2) a Random Forest (RF) classification model incorporating multi-source features, including Gray-Level Co-occurrence Matrix (GLCM), Local Binary Pattern (LBP), and Haar Wavelet; and (3) the SHapley Additive exPlanations (SHAP) method, utilized to interpret the model’s decisions. The framework was successfully applied to the Dongdian flood retention area (DFRA) during China’s “23·7″ major flood event, yielding high accuracy (Overall Accuracy (OA) = 97.72%, Kappa = 0.953). In model comparisons, the RF model demonstrated over four times the computational efficiency of XGBoost, with a minimal 0.11% loss in accuracy, proving its practical value for emergency scenarios. Crucially, SHAP analysis revealed that the model learned a physically consistent decision logic, prioritizing features for macroscopic smoothness and microscopic uniformity, and leveraging complex feature interactions to differentiate water from non-water pixels. This study’s framework not only improves flood mapping performance but also demystifies the model’s decision logic via SHAP, offering a transparent and robust tool for rapid emergency response in data-scarce basins.}
}
@article{SANCHEZLOPEZ2026135799,
title = {High-resolution study of pollutant mobility in an acid mine drainage-impacted estuary under changing tidal and river contributions},
journal = {Journal of Hydrology},
volume = {677},
pages = {135799},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135799},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008966},
author = {Laura Sánchez-López and Jonatan Romero-Matos and Carlos R. Cánovas and Rémi Freydier and Rafael Pérez-López},
keywords = {Ría de Huelva estuary, Acid mine drainage, Seawater mixing, Partitioning, Tide-flow interactions},
abstract = {The present study investigates the behaviour of acid mine drainage (AMD)-derived contaminants in the Tinto River estuary (SW Spain) using five high-resolution (hourly) fixed-point sampling campaigns conducted under contrasting hydrological and tidal regimes: low-riverflow neap and spring tides, and high-riverflow events following rainfall across different tidal coefficients. Water chemistry and mineral phases were characterised using established analytical techniques and electron microscopy, while aqueous speciation and mineral saturation indices were evaluated through PHREEQC geochemical modelling. The results indicate that Mn, Zn, Co, Ni and Cd exhibit quasi-conservative behaviour, with low partition coefficients (Kd) and predominance in the dissolved phase. In contrast, Fe and Al sequentially precipitate as schwertmannite and basaluminite, respectively, dominating the suspended particulate matter (SPM) and acting as sinks for other metal(oid)s (As, Pb and Cu). Arsenic is initially removed under acidic conditions and remobilized when pH exceeds 6 due to desorption from schwertmannite. Lead exhibited a singular response, with episodically high dissolved concentrations under specific high-flow conditions, likely linked to sulfate-mineral solubility and evaporite washout in the fluvial basin. Low-flow conditions, particularly during spring tides, and highly diluted high-flow events reduce metal mobility by enhancing partitioning into SPM and deposition in the upper estuary (except for As). Conversely, less diluted high-flow conditions promote downstream transport and export to the Atlantic Ocean. This work provides the first tide-resolved and hydrologically contrasted assessment of contaminant dynamics in an AMD-impacted estuary and offers a transferable framework for predicting metal(loid) fluxes to coastal systems under increasing hydrological variability.}
}
@article{ZHOU2026135844,
title = {An end-to-end framework for semi-automated and cost-effective urban drainage system design: integrating deep learning, topology generation, and multi-objective optimization},
journal = {Journal of Hydrology},
volume = {677},
pages = {135844},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135844},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009418},
author = {Qianqian Zhou and Shuya He and Zihao Guan and Qisheng Zhong and Xiaoguang Ge and Jianliang Zhang and Qi Wang and Zhiwei Zhao and Huiting Shi},
keywords = {Land-use identification, Dual-criterion impact factor system, Network topology generation, Shortest path algorithm, Multi-objective optimization},
abstract = {Driven by climate change and urbanization, extreme rainfall events are becoming more frequent. Traditional experience-based drainage design methods lack global optimization and efficiency, making them increasingly unable to meet cost-effectiveness demands. This study introduces a novel framework comprising four key steps: (1) land-use identification and hydrological characterization via an enhanced DeepLabv3+ model applied to satellite imagery, facilitating subcatchment delineation and runoff coefficient estimation; (2) development of the dual-criterion impact factor system considering both construction and layout rationalities, along with a weight matrix to examine the influence of these factors on design schemes; (3) automated generation of network topology and capacity calculation using the improved shortest path algorithm within a directed weighted network; and (4) multi-objective optimization based on SWMM simulations under various rainfall scenarios to evaluate Expected Annual Damage (EAD) and construction costs, thereby deriving Pareto-optimal solutions. Results indicate that the segmentation model, enhanced by incorporating a prior knowledge mask, effectively identified major urban land-use types, particularly buildings, roads, and water. Prioritizing construction-related impacts guided the model toward design schemes with more favorable slopes and lower costs. Under comparable flood risk conditions, the optimized design achieved a 9.4% reduction in the maximum pipe diameter, a 21.9% decrease in the average burial depth in localized regions, and an approximate 25.0% reduction in total cost. Applications to the districts in Lanzhou and Guangzhou demonstrated the framework’s robust applicability across diverse urban environments. The proposed framework presents a systematic, data-driven approach to generating cost-effective urban drainage designs with reduced manual effort.}
}
@article{NIU2026135783,
title = {Non-stationary framework of quantifying heat-driven drought propagation mechanisms in the Yellow River Basin of China},
journal = {Journal of Hydrology},
volume = {677},
pages = {135783},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135783},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008802},
author = {Ben Niu and Yi Li and Xingyun Qi and Maokai Song and Guiyuan Zhang and Yurui Fan and Zhi Li and Shie-Yui Liong},
keywords = {Non-stationary drought, Drought propagation, Heat stress, Explainable machine learning, Sensitivity analysis},
abstract = {Drought evolution in the Yellow River Basin has become increasingly complex under climatic warming and intensified human disturbance, challenging conventional stationary monitoring approaches. In this study, we developed an integrated framework to characterize meteorological (MD), agricultural (AD), and hydrological (HD) droughts by combining GAMLSS-based non-stationary drought indices (NSPEI, NSSMI, and NSRI), three-dimensional spatiotemporal event identification, hierarchical grade-cascade analysis, and explainable machine learning. A two-level attribution strategy was further applied to diagnose dominant drivers at both the event- and grid-levels, and sensitivity experiments were conducted to evaluate the robustness of the framework. The results showed that MD occurred most frequently and covered the widest area, while AD and HD were generally less frequent but more persistent. Drought propagation exhibited clear pathway dependence: meteorological drought acted as the primary trigger and propagated more widely to agricultural and hydrological droughts, whereas the AD–HD linkage was less frequent and showed greater temporal persistence and complexity. MA and MH propagation events were dominated by short durations and positive propagation times, with most events concentrated at 2–3 months. Across attribution analyses, high-temperature days emerged as the most consistent dominant driver, while precipitation- and surface-moisture-related factors played stronger roles in AD and HD. Sensitivity analysis further showed that data perturbations and threshold adjustments had limited influence on drought characteristics and propagation structure. These findings highlight the intensifying role of heat stress in cross-type drought evolution and provide a basis for adaptive drought early warning and water-resource management under non-stationary climate conditions.}
}
@article{LI2026135795,
title = {Precision mapping of evapotranspiration in arid basins: Spatiotemporal optimization and sensitivity to extreme climate conditions based on multi-mechanism model fusion},
journal = {Journal of Hydrology},
volume = {677},
pages = {135795},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135795},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008929},
author = {Xiang Li and Jinlong Shi and Jianli Ding and Tongren Xu and Lisheng Song and Jinjie Wang and Ziwei Xu and Dongxing Wu and Xinlei He and Yuan Zhang and Zijie Pang and Feihu Xue and Ziyan Xu},
keywords = {Evapotranspiration, Heihe River Basin, Mechanistic models, Data fusion, Extreme climate sensitivity, Remote sensing},
abstract = {Conventional ground-based ET measurements are inadequate for large-scale areas, while remote sensing models exhibit inconsistent accuracy over heterogeneous surfaces due to variations in physical mechanisms and parameterization schemes. This study, based on remote sensing data from 2012 to 2016, utilized the Surface Energy Balance Algorithm for Land (SEBAL), Surface Energy Balance System (SEBS), Penman-Monteith (PM) and Priestley-Taylor (PT) models to estimate evapotranspiration (ET) in the Heihe River Basin. After the multi-model resultswerefused and optimized using Triple Collocation (TC) and Maximum Likelihood Estimation (MLE) methods, the model accuracywassystematically evaluated across various spatial (site and basin) and temporal scales, as well as across diverse land cover types, with a further sensitivity analysis conducted under extreme heat conditions. The results showed that, the SEBAL achieved the highest accuracy (R = 0.76, RMSE = 1.18 mm/day), followed by PM (R = 0.74, RMSE = 1.28 mm/day) and SEBS (R = 0.72, RMSE = 1.34 mm/day), and the PT model had the lowest accuracy (R = 0.65, RMSE = 1.47 mm/day); Among the single models, SEBAL showed slightly higher accuracy, but each exhibited biases under specific land cover types or climatic conditions. To overcome this limitation, fusion models (TC_PET and MLE_PET) were developed, leveraging the strengths of individual models to achieve superior overall accuracy, the fusion models demonstrated significantly higher accuracy (R ≥ 0.79, RMSE < 0.9 mm/day) than single models. Spatially, ET exhibited a decreasing trend from upstream to downstream regions, with the highest values in the upper reaches and the lowest in the lower reaches. Under extreme high-temperature conditions, single-model accuracy significantly declined. Fusion models can effectively reduce such errors and uncertainties, and they achieve the most significant improvement in accuracy over single models in complex surface scenarios such as croplands and grasslands. The proposed fusion framework substantially enhances the reliability and robustness of ET estimation in complex environments, providing theoretical and technical support for water resource management and ecological conservation in arid/semi-arid regions.}
}
@article{LI2026135763,
title = {A novel hybrid modeling-based artificial intelligence agent for water-food-ecology-environment-economy system trade-offs},
journal = {Journal of Hydrology},
volume = {677},
pages = {135763},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135763},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008607},
author = {Yue Li and Zhijun Chen and Min Hu and Xinyi Li and Yufei Han and Dongyang Ren and Xu Xu and Yunwu Xiong and Quanzhong Huang and Guanhua Huang},
keywords = {Artificial intelligence, Hybrid modeling, Multi‑objective synergistic regulation, Decision–making efficiency, Sustainable agricultural management},
abstract = {The mismanagement of irrigation, fertilization, and cropping systems intensifies conflicts within the Water-Food-Ecology-Environment-Economy (WFEEE) system. To address this challenge, we developed a novel artificial intelligence (AI) Agent by integrating agro-hydrological model (AHC), machine learning algorithm, multi-criteria decision-making (MCDM) method, and large language model (LLM) for WFEEE system trade-offs, within an AI development platform. The AI Agent can automatically optimize irrigation, fertilization, and crop planting structures by balancing irrigation water productivity (IWP), crop yield, ecosystem service value (ESV), nitrogen pollution load (NPL), and economic benefit (EB). Applied to the Wuliangsuhai lake watershed of North China under 90 combined irrigation, nitrogen application and hydrological year scenarios, along with 8 planting structure scenarios, the AI Agent demonstrated significant improvements in sustainability of the WFEEE system by strategically reducing irrigation and nitrogen inputs while optimizing wheat-to-maize ratio. Compared to conventional practices, the AI-driven solution increased IWP by 65%, reduced NPL by 78% and negative ESV by 20%, while limiting yield and EB losses below 10% and 2%, respectively. As a result, the WFEEE system’s sustainability index improved by 145%. Notably, the AI Agent achieved a 5.7- to 11.5-fold increase in decision-making efficiency over traditional externally linked approaches, and a 2.6- to 3.7-fold higher stability of decision outcomes over conventional MCDM-based single‑layer decision. These improvements stem from the AI Agent automating previously manual tasks (including model execution, decision indicator calculation, data format conversion and transmission) and incorporating an LLM-based second-layer decision. This study underscores the capability of AI Agent to support intelligent management in complex agricultural systems, providing a practical pathway for future advancements.}
}
@article{ZHANG2026135727,
title = {Temporal inductive biases in hourly flood forecasting: a comparative analysis of recurrent, attention-based, and state-space neural networks},
journal = {Journal of Hydrology},
volume = {677},
pages = {135727},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135727},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008243},
author = {Binlan Zhang and Chaojun Ouyang and Qingsong Xu and Yanlin Liu and Zili Wang and Quan Tang},
keywords = {Deep learning, Hourly forecasting, Runoff, Flood, Mamba, Benchmark},
abstract = {Daily-resolution flood forecasts often encounter difficulties in capturing rapid runoff fluctuations over short time periods. To address this limitation, moving to hourly-scale modeling is essential, yet identifying which deep learning architectures possess the optimal temporal inductive biases for such high-frequency dynamics remains an open challenge. In this study, we conduct a comprehensive comparative analysis of recurrent, attention-based, and state-space neural networks, benchmarked against simple layered structures on discharge-assisted forecasting tasks across 516 CAMELS catchments. The results indicate that the Patch Transformer achieves the best predictive performance. This suggests that patch-based processing acts as a superior inductive bias by smoothing high-frequency noise and extracting local temporal semantics, which effectively captures long-term routing and hydrological dependencies better than point-wise attention. While the traditional LSTM maintains robust performance, the Mamba model demonstrates a promising balance between accuracy and computational efficiency. Furthermore, through an interpretability analysis combining attention weights with Integrated Gradients (IG), we reveal that attention models successfully capture physical hydrological patterns, such as time-lagged responses and the dominance of dynamic meteorological drivers over static attributes. This work offers theoretical insights into how architectural choices determine short-term forecasting capability under diverse hydro-climatic regimes.}
}
@article{LIU2026135824,
title = {Interactive effects of freezing-thawing and subsurface seepage on detachment rate: Chinese Mollisol under simulated snowmelt runoff},
journal = {Journal of Hydrology},
volume = {677},
pages = {135824},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135824},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009212},
author = {Bo Liu and Haiou Shen and Haoming Fan and Renming Ma and Qiang Gao},
keywords = {Freezing-thawing effects, Subsurface seepage, Soil structure characteristic, Shear strength, Detachment rates},
abstract = {During the spring thawing period, soil detachment under snowmelt runoff is significantly influenced by the alterations in soil structure due to freezing-thawing effects and the occurrence of subsurface seepage. To explore the mechanism underlying the interactive effects of freezing-thawing and subsurface seepage on detachment rate of Mollisol, soil tanks underwent a series of freezing-thawing treatments, and the shear strength (Ss) and detachment rate (Dr) were measured under subsurface seepage conditions. Pore structure and aggregate characteristics were quantitatively analyzed using a 25-μm resolution industrial CT and dry or wet sieving, respectively. Partial least squares regression (PLSR) was employed to examine the relationships between soil structure characteristics and the Ss. Findings indicated that freezing-thawing effects significantly altered pore structure and aggregate characteristics. The Dr increased as the Ss decreased under freezing-thawing effects, closely linked to soil structure characteristics. Soil structure characteristics, including the porosity (≥80 μm), the proportion of dry aggregates (excluding 2–1 mm), the proportion of water-stable aggregates (5–2 and 1–0.5 mm), mean weight diameter, and fractal dimension of dry aggregates, were identified as the primary factors influencing the Ss. Pore structure and aggregate characteristics accounted for 89.5% of the variation in the Ss. The occurrence of subsurface seepage significantly diminished Ss, exhibiting a negative power relationship with the Dr. The findings advanced the understanding of the generation mechanism of snowmelt erosion in response to the interactive effects of freezing-thawing and subsurface seepage during the spring thawing period.}
}
@article{THAKUR2026135840,
title = {Advancing the calibration of macroscale hydrological models by integrating sensitivity analysis, adaptive pseudo-modeling optimization and multi-site calibration},
journal = {Journal of Hydrology},
volume = {677},
pages = {135840},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135840},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009376},
author = {Chandni Thakur and Venkatesh Budamala and K.S. Kasiviswanathan and Claudia Teutschbein and Bankaru-Swamy Soundharajan},
keywords = {Adaptive pseudo-modeling optimization, Variable infiltration capacity, Multi-site calibration, Sensitivity analysis, Equifinality},
abstract = {Accurate estimation of parameters in macroscale, complex hydrological models (HMs) using effective calibration procedures can improve the characterization of real-world phenomena of hydrological fluxes. This study presents a novel, model-agnostic calibration framework that integrates global sensitivity analysis (SA) with an adaptive pseudo-modelling optimization strategy. The framework is designed to overcome key limitations of conventional calibration methods, such as reliance on exhaustive one-shot sampling, absence of formal parameter screening, and restriction to single site calibration. To demonstrate the potential of the proposed framework, catchment-specific sensitive parameters of the variable infiltration capacity model (VIC) with a 0.15° spatial resolution were calibrated for streamflow simulations over the Godavari River basin in India using both single- and multi-site calibration. An ensemble of pseudo models, including Gaussian process regression, kriging, and artificial neural networks, was employed to enhance robustness and generalization. Although the performance indicators (NSE, KGE ≥ 0.8 and PBIAS ≤ 15) in both scenarios demonstrated similar model performance at the catchment outlet, scenario 2 outperformed single-site calibration in terms of equifinality reduction, less parameter uncertainty and improved computational efficiency. By combining Sobol SA, ensemble pseudo modelling, and multi-site calibration, the framework efficiently explored hydrologically relevant regions of the parameter space, reduced dimensionality by excluding non-influential parameters, and lowered overall computational burden. The proposed framework is a robust method for improving the simulation capability of macroscale HMs under diverse hydroclimatic conditions.
Plain language summary
Hydrological models, such as the VIC model, are powerful computer-based tools used to study and understand water movement on a local to large scale, particularly at the river basin scale. The calibration process involves adjusting the model’s parameters to ensure that the model outputs align with real-world observations. Improving the calibration of hydrological models, like VIC, enhances their ability to make reliable predictions, which is vital for effective water resource management and decision-making. This paper presents a novel hybrid modelling framework combining sensitivity analysis and an adaptive optimization algorithm to calibrate complex hydrological models automatically. The proposed approach can be a robust and time-efficient method for improving large-scale hydrological models, enabling decision-makers to make informed choices and develop effective strategies for addressing water-related challenges.}
}
@article{MCGREGOR2026135770,
title = {Applicability of an analytical probabilistic stormwater management model for large rural watersheds},
journal = {Journal of Hydrology},
volume = {677},
pages = {135770},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135770},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600867X},
author = {Lauren McGregor and Sonia Hassini},
keywords = {Rainfall event, Large rural watershed, Peak discharge frequency, Analytical probabilistic approach, Stormwater management},
abstract = {Accurate peak flow predictions are critical for effective stormwater management. A wide range of techniques has been developed to estimate peak flows at pour points of interest. In many cases, the suitability of a model for a given watershed depends on numerous factors such as climate, catchment characteristics, data availability, and project objectives. This study focuses on extending the applicability of the Analytical Probabilistic Stormwater Management Model (APSWM), which was developed for small urban catchments. The APSWM peak flow model was recently enhanced to incorporate trapezoidal hydrograph shapes, referred to as APSWM(Tra), beyond the original triangular assumption. The model’s performance was investigated in a relatively large rural watershed within the Upper Thames River Basin in southwestern Ontario, Canada. APSWM(Tra) predicted peak flows within 14% of observed rates for return periods of 2, 5, 10, 25, 50, and 100 years and had a percent bias (PBIAS) of 13%. However, 2- and 5-year peak flows were underestimated. The study results suggest that APSWM(Tra) shows good potential as a tool for further development and use in large rural watersheds but further investigations and validations would be required before broader application.}
}
@article{LIU2026135791,
title = {A novel fusion framework for generating 30 m daily seamless soil moisture with reliable performance},
journal = {Journal of Hydrology},
volume = {677},
pages = {135791},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135791},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008887},
author = {Yangxiaoyue Liu and Ying Xin and Yuan Tian},
keywords = {30 mdaily seamless soil moisture, Super resolution, Reliable accuracy, SMAP/Sentinel soil moisture},
abstract = {High-resolution (30 m) daily soil moisture (SM) dataset is critical for precision agriculture, drought monitoring, and water resource management. However, such dataset remains challenging to obtain due to the limited spatial and temporal resolutions in existing satellite products. To address this issue, this study proposes a novel two-step deep learning framework to produce a high-resolution (30 m) daily seamless SM with reliable accuracy, leveraging strengths from open-access remotely sensed products, terrain, and soil property datasets. The framework is independent from in-situ measurements. First, a convolutional neural network-based super-resolution model (MSRNet) downscales 500 m MODIS spectral bands (8 bands including visible, near-infrared, and thermal infrared) to 30 m resolution using Harmonized Landsat-Sentinel (HLS) data of the corresponding 8 bands. Second, a SM simulation network (SMSNet) learns the relationship between SM and 16 explanatory variables, including the downscaled MODIS bands, terrain features, soil properties, and 1 km SMAP/Sentinel SM at an intermediate resolution of 125 m. Third, the trained SMSNet is applied to 30 m inputs to generate seamless daily high-resolution SM estimations. Validated against in-situ measurements in Naqu (central Tibet Plateau) with significance test (p < 0.01), the 30 m SM achieves significant accuracy improvements over the original SMAP/Sentinel product, with increased correlation (R = 0.70 vs. 0.68) and reduced errors (RMSE = 0.09 m3/m3 vs. 0.12 m3/m3, ubRMSE = 0.07 m3/m3 vs. 0.10 m3/m3). Moreover, the cross-regional validation is conducted at the Maqu (northeast Tibet Plateau) for generalizability and transferability test of the established SMSNet, and achieves reasonable performances. This research provides a feasible solution for large spatial–temporal scale improvement of SM simulation through the combination of MSRNet and SMSNet, enabling field-scale SM applications, as demonstrated in the Tibetan Plateau region, without reliance on ground-based networks.}
}
@article{EINI2026135767,
title = {From fixed calendars to dynamic triggers: climate-responsive field management with SWAT+ decision tables},
journal = {Journal of Hydrology},
volume = {677},
pages = {135767},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135767},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008644},
author = {Mohammad Reza Eini and Birgit Müller and Michael Strauch},
keywords = {Hydrological modeling, Global warming, Crop management, Food security},
abstract = {Climate-change impact assessments using agro-hydrological models often assume that farmers will stick to the same planting and harvest dates in the future, even as the climate warms. This “fixed-calendar” assumption conflicts with reality, as farmers naturally adapt to shifting seasons, leading models to miscalculate crop yields and water use. To address this, we developed a workflow in the SWAT+ model that replaces static calendar dates with dynamic rules that respond to the environment. We first analyzed historical management records to identify the specific weather conditions, such as accumulated heat or dry days, that actually prompt farmers to plant or harvest. We then translated these observations into “if-then” rules (decision tables) and tuned them to ensure they accurately reproduced historical farming timing. We applied this dynamic approach to winter wheat and corn silage in a German catchment under cool–dry, cool–wet, and warm–wet late-century climates. Rule-based management successfully adapts to future warming without requiring manual adjustments. For winter wheat, the median growing season is shortened from a historical ∼ 312 days to roughly 293–306 days in the future due to faster maturation. Conversely, corn silage growing seasons extended from a historical 144 days to 162–172 days in wet scenarios, driven by significantly earlier planting. Dynamic management consistently improved corn silage yields (+28.0% to + 47.9%) compared to the fixed-calendar approach. Environmentally, the dynamic rules were far more effective at mitigating pollution: nitrate runoff decreased by 48.5% to 86.6% for winter wheat relative to the baseline. In contrast, sticking to fixed dates resulted in erratic outcomes, such as a 30.6% increase in nitrate losses under cool–dry conditions. This study demonstrates that using adaptive rules instead of fixed dates reduces bias and produces more realistic climate-change impact assessments.}
}
@article{IBHAGUI2026135804,
title = {Temporal evolution of stormwater basin soil properties and infiltration rates},
journal = {Journal of Hydrology},
volume = {677},
pages = {135804},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135804},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009017},
author = {Eimienwanlan Ibhagui and Sara Bonetti and Anthony J. Parolari},
abstract = {Infiltration-based green stormwater infrastructure (GSI) practices are widely used to mitigate the hydrologic impacts of urbanization. However, how GSI performance evolves over time remains poorly understood. In particular, there is little consensus among published studies on whether GSI infiltration rates increase, decrease, or remain constant as GSI practices age. To address this gap, we hypothesized that GSI soil properties change with age and these changes drive corresponding changes in the infiltration rate. Soil properties and infiltration rates were measured in 28 stormwater infiltration basins along a chronosequence ranging in age from 2 to 20 years. Clay, silt, and organic matter contents increased with age while bulk density decreased with age, suggesting that vegetation and soil biota activity as well as fine sediment accumulation contributed to soil profile evolution. Age, clay, silt, and organic matter correlated with infiltration rate, whereas bulk density and porosity did not. Percent silt content was the best predictor of infiltration rate (R2 = 0.46–0.65, p < 0.001); however, age alone provided moderate predictive power (R2 = 0.16–0.45, p = 0.035–0.001). The best performing single and multiple regression models of infiltration rate used age, organic matter, and silt as predictors (R2 = 0.61–0.65, p < 0.001). These data and models revealed that infiltration rate decreased with basin age and silt content, and increased with organic matter, providing a quantitative link between soil properties and infiltration rate evolution with basin age.}
}