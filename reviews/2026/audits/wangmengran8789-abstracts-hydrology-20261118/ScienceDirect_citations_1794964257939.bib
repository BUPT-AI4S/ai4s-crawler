@article{URREAMENDEZ2026135762,
title = {Multivariate design storms using vine copulas and Gaussian process regression},
journal = {Journal of Hydrology},
volume = {677},
pages = {135762},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135762},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008590},
author = {Diego {Urrea Méndez} and Dina Vanessa {Gómez Rave} and Manuel {del Jesus}},
keywords = {Multivariate design storms, Joint return periods, Vine copulas, Gaussian processes, Spatial intermittency},
abstract = {Multivariate design storms represent events associated with a defined Joint Return Period (JRP) while preserving observed spatial dependence. They enable the synthetic generation of storms that have not yet been observed but are plausibly likely, thereby expanding the scenario space for design and risk assessment. Two practical challenges persist: (i) embedding JRPs within storm-generation procedures beyond three dimensions, which is computationally demanding; and (ii) representing spatial intermittency, which has so far been treated only with a bivariate Multivariate Mixture Model (MMM). We present a method that addresses both challenges concurrently. We compare five copula-based approaches for high-dimensional dependence, employ Gaussian process regression (GPR) to accelerate JRP estimation, and extend the MMM to represent intermittency in multiple dimensions. The framework is applied to the Besaya River basin (northern Spain). Results show that GPR reduces computational cost by an order of magnitude while maintaining approximation errors on the order of 10−3, and that the MMM captures intermittency in multidimensional settings. Flexible vine copula–based approaches best preserve spatial and multidimensional dependence in multivariate storm generation, whereas Gaussian-based and univariate benchmarks systematically underestimate storm totals.}
}
@article{SABUT2026135851,
title = {Distinguishing drought and flash drought: definitions, processes, and consequences},
journal = {Journal of Hydrology},
volume = {677},
pages = {135851},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135851},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009480},
author = {Amitesh Sabut and Ashok Mishra and Vijay Sreeparvathy and Benjamin Zaitchik},
keywords = {Flash drought, Conventional drought, Land–atmosphere interactions, Agricultural impacts},
abstract = {Drought severely impacts water, food, energy, and ecosystems, creating widespread socio-economic risks. Conventional droughts (CDs) are well understood as slow-developing events driven by prolonged precipitation deficits and large-scale climate variability. In contrast, recent decades have highlighted growing recognition of flash droughts (FDs), which develop rapidly with high intensification rate at sub-seasonal scales due to short-term precipitation breaks, heightened evaporative demand, and strong land–atmosphere feedbacks. Their rapid onset, limited early warnings, and severe agricultural and ecological impacts have exposed major gaps in current monitoring and early-warning systems, which remain largely tailored to slow-onset drought events. Despite growing research attention, inconsistent definitions, diverse diagnostic methods, and uncertainty about transitions between CDs and FDs continue to fragment scientific and operational understanding. Although individual studies on FD and CD have gained considerable attention, research explicitly distinguishing between the two remains limited. This review aims to synthesize existing findings and help address this important research gap. In this review, we synthesize recent advances in four areas: (i) evolving drought typologies and the position of FDs within the broader drought spectrum, (ii) physical processes shaping onset and intensification, including teleconnections, land atmospheric interactions, and atmospheric circulation anomalies, (iii) predictability across timescales, contrasting the boundary-forced skill of CDs with the sub-seasonal challenges of FDs, and (iv) sectoral and systemic consequences across agriculture, hydrology, ecosystems, and society. We also highlight emerging evidence on compound extremes, where FDs act as precursors or amplifiers of heatwaves, wildfires, and multi-breadbasket failures. Finally, we highlight the need for a unified drought typology that bridges slow and rapid onset events, standardizes diagnostic criteria, and integrates physical drivers with impact pathways. By advancing hybrid monitoring and predictive frameworks that combine dynamical models, statistical approaches, and machine learning, the field can move toward adaptive, impact-aware strategies to strengthen resilience in a warming world.}
}
@article{JADALLAH2026135839,
title = {Model-based disaggregation of satellite-based total water storage anomalies for the Upper Colorado River Basin},
journal = {Journal of Hydrology},
volume = {677},
pages = {135839},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135839},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009364},
author = {Nicholas Jadallah and Reed M. Maxwell},
keywords = {Integrated hydrologic modeling, Groundwater, Groundwater-surface water interactions, GRACE, Colorado river, Upper Colorado River Basin},
abstract = {This study demonstrates the capability of an integrated hydrologic model of the Upper Colorado River Basin to disaggregate total water storage anomalies into constituent parts over a 45-year simulation period of pre-development hydrology. The Upper Colorado River Basin is a critical transboundary water source that supports tens of millions of people in North America. Groundwater plays an important role in basin hydrology, but few methods explicitly measure or simulate groundwater at the basin scale. Here, we developed a physically based groundwater-surface water-land surface model and decomposed basin-wide water storage trends into constituent parts. We evaluated model output (i.e. streamflow, snow, evapotranspiration, and water storage) against a suite of observations. The simulated data match observations well, particularly at monthly timescales—which is the temporal resolution of GRACE. Simulated trends in subsurface water storage are sensitive to the initial condition, which required careful attention to the model’s transient initialization process to ensure that residual trends from spinup did not obscure the total water storage signal. Each component of total water storage contributes uniquely to sub-annual and inter-annual trends in basin hydrology at the basin and subbasin scales. Here, we demonstrate that the integrated hydrologic model presented in this work explicitly partitions natural water storage trends into soil moisture and groundwater components, enabling improved water management strategies for the Upper Colorado River Basin.}
}
@article{LI2026135815,
title = {Goodness-of-fit can be misleading: probability plots},
journal = {Journal of Hydrology},
volume = {677},
pages = {135815},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135815},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009121},
author = {Xiaoyang Li and Brent Boehlert and Richard M. Vogel and Lei Ye},
keywords = {Probability distribution, PPCC, Pearson correlation, Q–Q plot, P–P plot, Outliers},
abstract = {When modeling the relationship between the frequency and magnitude of a natural hazard, there is a need to select and fit a probability distribution function (pdf) that mimics the unknown parent distribution. Goodness-of-fit metrics are often used to assess how well a hypothesized pdf fits observations. The goal of such evaluations is to ensure that the chosen pdf reproduces various important properties associated with the correct pdf. The probability plot correlation coefficient (PPCC) test based on a quantile–quantile (Q–Q) probability plot is a widely used tool for evaluating the goodness-of-fit of a hypothesized pdf to a sample of observations. Among 200 flood series from rivers in the U.S. with very long records, it was generally only those rivers that experienced extraordinary floods, which led to very low PPCC values, raising questions about the value of the PPCC statistic. Monte Carlo experiments reveal that the PPCC goodness-of-fit metric based on a Q–Q probability plot, is highly sensitive to outliers, and as a result can be quite misleading, causing us to reject the correct pdf in situations when it would have been very important to identify it as the distribution most consistent with the observations. Variable transformations for Q–Q plots and PPCC goodness-of-fit metrics based on probability-probability (P–P) plots are shown to give a much more balanced assessment of a hypothesized pdf. Our findings apply to any natural hazard which exhibits heavy tailed behavior.}
}
@article{ZHANG2026135831,
title = {A localisation strategy for scalable and efficient multi-source precipitation blending at high resolutions over large domains},
journal = {Journal of Hydrology},
volume = {677},
pages = {135831},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135831},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009285},
author = {Yuhang Zhang and Quan J. Wang and Andrew J. Frost and Jayaram Pudashine and Blair Trewin and Carlos Velasco-Forero and Chun-Hsu Su and Vincent Villani},
keywords = {Precipitation analysis, Multi-source blending, Sub-daily, Kilometre-scale},
abstract = {Driven by growing demands for higher resolution and quality in hydrometeorological applications, precipitation products are increasingly being developed at sub-daily and kilometre-scale resolutions by blending information from multiple data sources. However, these developments face substantial modelling complexity, as the integration of multiple heterogeneous sources expands the inter- and intra-source error relationships that need to be represented, particularly when applied across large spatial domains. To address this challenge, this study presents the theoretical formulation and scalable implementation strategies for generalised multi-source precipitation blending within a statistical interpolation framework. We use an error-informed localisation concept, which formalises the insight that, in most blending scenarios, only observations that are both spatially representative and characterised by relatively low errors exert meaningful influence on blended precipitation field. Motivated by this concept, we develop a highly efficient implementation that approximates source influence by selecting only the nearest grid cell from each additional spatial input, enabling a substantial reduction in covariance modelling while preserving the essential blending characteristics. The framework is demonstrated in a three-source blending experiment integrating satellite, radar, and gauge data to produce 2-km and hourly rainfall fields over two radar domains in Australia. Qualitative assessment of precipitation and error spatial structures during extreme events, together with quantitative evaluation using the fractions skill score (FSS), show that the simplified implementation retains blending performance comparable to a comprehensive scheme, while requiring only a fraction of the computational cost. This work provides both conceptual understanding and practical implementation strategies to support large-scale, high-resolution, multi-source precipitation product development.}
}
@article{NIE2026135807,
title = {Soil moisture retrieval using multi-system GNSS-IR with a marginal improvement threshold for satellite combination optimization},
journal = {Journal of Hydrology},
volume = {677},
pages = {135807},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135807},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009042},
author = {Shihai Nie and Xiaoyun Wan and Peng Li and Jinsheng Tu and Xing Wu and Kai Yan},
keywords = {Multi-system combinations, GNSS-IR, SMC, Machine learning, Marginal improvement threshold},
abstract = {Global navigation satellite system interferometric reflectometry (GNSS-IR) is widely used for surface soil moisture content (SMC) retrieval. However, under multi-system cooperative observation conditions, an interpretable quantitative criterion for determining the optimal size of multi-satellite combinations remains lacking, limiting the quantitative characterization of information gain and the constraint of combination size. To address this issue, this study proposes a multi-system GNSS-IR soil moisture retrieval method based on a marginal improvement threshold. Within a multi-system collaborative GNSS-IR observation framework, a quantitative relationship between interferometric phase and soil moisture is established. The average pairwise correlation coefficient among satellites is introduced to characterize inter-satellite correlation and information redundancy and to constrain the marginal gain associated with combination size. On this basis, a marginal improvement threshold model is developed to describe the diminishing-return and saturation behavior of retrieval performance with increasing satellite number, thereby providing a tractable criterion for determining the optimal size of multi-system multi-satellite combinations. The results show that multi-system multi-satellite combinations significantly improve GNSS-IR soil moisture retrieval accuracy, while the associated performance gain exhibits diminishing returns and gradually approaches saturation with increasing satellite number. The optimal satellite combination sizes are 5, 7, 10, and 14 for the single-, dual-, triple-, and quadruple-system dual-frequency schemes, respectively. Under the optimal configuration, the quadruple-system dual-frequency multi-satellite scheme achieves R2 values of 0.977 at station P031 and 0.990 at station P387, outperforming all other schemes. These findings provide a quantitative basis for designing multi-system GNSS-IR multi-satellite configurations and a methodological reference for surface hydrological monitoring under complex environmental conditions.}
}
@article{MA2026135778,
title = {Soil erosion processes on layered loess slopes under extreme rainfall events},
journal = {Journal of Hydrology},
volume = {677},
pages = {135778},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135778},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008759},
author = {Yuying Ma and Xiaohui Zhuang and Fuyun Lu and Zhi Zhao and Wei Wang},
keywords = {Plough pan, Rainfall intensity, Slope gradient, Erosion addition runoff, Soil loss},
abstract = {Clarifying the role of low-permeability subsurface layers in intensifying soil erosion triggered by extreme rainfall is fundamental to refining erosion risk assessment and designing targeted conservation strategies for sloping lands. For this purpose, a layered soil profile was established to simulate a plough layer underlain by a compacted plough pan. The layered slope was subjected to artificial rainfall erosion to quantify runoff and sediment yield responses. The experimental results showed that the plough pan restricted downward water movement, causing infiltrated rainwater to accumulate in the plough layer. As rainfall continued, saturated zones developed within the plough layer, which triggered the sharp increase in erosion that emerged as a distinct transition point in the corresponding erosion response curve. Longer rainfall duration intensified water accumulation within the plough layer and promoted the development of saturated zones, leading to increased soil loss. Under the rainfall intensity of 80 mm h−1 with a duration of 120 min, mean soil loss was 20.88, 65.09, and 70.49 kg m−2 on slopes of 5°, 10°, and 20°, respectively. Notably, the soil loss occurring after the transition point dominated the total erosion output, accounting for 97.8%, 99.4%, and 97.8% of the total soil loss on slopes of 5°, 10°, and 20°, respectively. In addition, steeper slope gradients led to an earlier transition point, resulting in more severe hillslope erosion. The erosion process on layered slopes exhibited distinct stage characteristics, and the development of saturated zones within the plough layer accelerated soil loss, further increasing the difficulty of implementing soil and water conservation measures on sloping farmland. This finding advances the understanding of erosion processes on loess slopes with a plough pan and provides a theoretical basis for conservation planning in the context of increasingly frequent extreme rainfall events driven by climate change.}
}
@article{TUDAJI2026135801,
title = {HydroCraft: an efficient online platform for hydrological modeling integrated with a large language model agent},
journal = {Journal of Hydrology},
volume = {677},
pages = {135801},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135801},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600898X},
author = {Mahmut Tudaji and Fuqiang Tian and Xiannan Wu},
keywords = {Hydrological modeling, Large language model (LLM) agent, Retrieval-augmented generation (RAG), Watershed delineation, HydroCraft},
abstract = {Hydrological modeling is essential for water resources management but often requires specialized expertise, creating a significant barrier to its broad application. To address this challenge, we developed HydroCraft, a web-based platform designed to democratize the modeling process. HydroCraft provides a comprehensive and integrated workflow for basin extraction, driving data generation, parameter calibration, and result visualization, enabling rapid modeling for any watershed globally. Key features of the platform include: an adaptive watershed delineation method that optimizes the distribution of computational units based on user-defined sub-basin area thresholds; the integration of three hydrological models (THREW, Xin’anjiang, and Miyun Hydrological Model) suitable for diverse climatic and geological conditions; and the incorporation of a Large Language Model (LLM) agent, which serves as a robust assistant to provide guidance and automated task execution. Users only need a device with a web browser and an internet connection to perform advanced hydrologic simulations. Two case studies (user-driven vs. LLM-agent-assisted) demonstrated the platform’s efficiency and intelligence. The platform advances hydrological modeling toward greater intelligence and accessibility, providing support for applications such as water resource management and flood forecasting.}
}
@article{FENG2026135754,
title = {Multicomponent geochemical reactions control arsenic mobilization in groundwater: novel insights from machine learning and geochemical model},
journal = {Journal of Hydrology},
volume = {677},
pages = {135754},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135754},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008516},
author = {Yanbo Feng and Shaogang Dong and Qingqiu Hou},
keywords = {High arsenic groundwater, Self-organizing maps, Multicomponent inverse geochemical model, Arsenic cycling},
abstract = {Redox sensitive elements, including carbon (C), nitrogen (N), sulfur (S), iron (Fe), and manganese (Mn), play critical roles in groundwater arsenic (As) cycling. However, the behavior of As under the simultaneous influence of multiple interacting geochemical cycles remains poorly understood. In this study, self-organizing maps (SOM) and absolute principal component scores-multiple linear regression (APCS-MLR) were applied to identify the dominant mechanisms controlling As mobilization and transformation in groundwater. Based on these analyses, a multicomponent inverse geochemical model (MC-IGM) was developed for the Hasuhai Basin, China to elucidate coupled C-N-S-Fe-Mn-As cycling in groundwater. Integrated PCA-APCS-SOM analysis further identified four dominant factors controlling geogenic As contamination in groundwater, including geogenic sources (30.75%), Fe/Mn oxide redox transformations and anthropogenic inputs (35.63%), evaporative processes (0.97%), and water–rock interactions (32.66%). Geochemical modeling indicates that the redox cycles of Fe/Mn oxides govern the interconversion between As(III)/As(V). Heterotrophic dissimilatory NO3− reduction to NH4+ (h-DNRA), organic nitrogen (Org-N) mineralization, sulfate reduction, and methanogenesis promote the enrichment of As. In contrast, nitrification enhanced As adsorption through coupling with Fe/Mn oxidation process. Collectively, these findings identify carbon cycling as the central process coupling N, S, Fe, and Mn transformations, ultimately controlling As mobility and speciation.}
}
@article{YIN2026135843,
title = {Disentangling hydroclimatic controls on drought-induced vegetation productivity loss at the basin scale across China},
journal = {Journal of Hydrology},
volume = {677},
pages = {135843},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135843},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009406},
author = {Xiaowei Yin and Yiping Wu and Sergey Kivalov and Georgii Alexandrov and Ji Chen and Shuguang Liu and Linjing Qiu and Fubo Zhao and Weiqin Dang and Zhao Jin and Yongming Han and Zhangdong Jin},
keywords = {Drought, Net primary productivity (NPP), Water availability, Ridge regression analysis},
abstract = {As a frequent extreme event under global climate change, drought significantly threatens the net primary productivity (NPP) of terrestrial ecosystems. Although numerous studies have reported drought-induced declines in NPP, the hydroclimatic mechanisms behind remain insufficiently understood. The strong interdependence among temperature, precipitation, and water availability has made it challenging to quantify their independent effects on vegetation productivity under drought stress. Here, we assessed basin-scale NPP responses to drought across mainland China from 1982 to 2018 and applied a ridge regression method to disentangle the individual impacts of multiple hydroclimatic drivers on NPP variability, which overcomes the limitations of conventional correlation-based analyses by accounting for multicollinearity, thereby allowing a more robust identification of the dominant controls on drought-induced NPP variations. Our results revealed pronounced spatial heterogeneity in NPP responses among major basins, with the strongest productivity losses in the Songliao River basin and the Yellow River basin (12.41 g·C·m⁻2·yr⁻1 and 11.71 g·C·m⁻2·yr⁻1, respectively). Ridge-derived coefficients indicated that water availability was the primary driver of NPP sensitivity to drought, and stronger water-availability control was typically associated with greater NPP losses during drought in water-limited basins. By integrating basin-scale analysis with a multivariate attribution framework, this study isolated the hydroclimatic controls of vegetation productivity under drought. The findings can improve understanding of terrestrial carbon dynamics and be informative for enhancing drought resilience and optimizing water–carbon management strategies in terrestrial ecosystems.}
}
@article{WANG2026135773,
title = {Streamflow seasonality responds to changes in snowfall fraction in the Upper Indus Basin},
journal = {Journal of Hydrology},
volume = {677},
pages = {135773},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135773},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600870X},
author = {Yixuan Wang and Yan-Jun Shen and Xiaolong Zhang and Muhammad Zaman and Muhammad Imran Khan},
keywords = {The Upper Indus Basin, Snowfall fraction, Snowmelt timing, Streamflow concentration Index, Water resources management},
abstract = {Variations in snowfall fraction (SF) drive streamflow timing shifts globally, yet basin-specific patterns and underlying mechanisms remain poorly understood. This is particularly critical for the climate-vulnerable, snow-dependent Upper Indus Basin (UIB) where significant sub-basin differences in SF influence streamflow seasonality. Here, we investigate the impacts of variations in SF on streamflow seasonality in the UIB across various sub-basins from 1971 to 2017 using streamflow center time (QCT) and concentration index (QCI), with sensitivity indices quantifying precipitation timing (PCT) versus snowmelt onset timing (MOD) controls. We find that the Karakoram sub-basins (Shyok, Hunza, and Shigar) exhibited the highest SF (0.82–0.88) in the UIB; despite an overall declining trend basin-wide, 64% of the area showed increasing SF trends, with significant rises in high-altitude zones. Higher SF correlates with later (increased QCT) and more concentrated (higher QCI) streamflow, especially in Karakoram basins. Crucially, we identify an SF threshold of 0.8 that triggers a regime shift where MOD replaces PCT as the primary driver of runoff timing. This threshold provides a mechanistic explanation for the Karakoram’s distinctive “accumulation-concentration-lag” phenomenon, revealing that its high-altitude snowpack acts as a physical buffer that stabilizes seasonal streamflow and delays the hydrological response to early-season warming.}
}
@article{XU2026135794,
title = {Long-term and interannual variability of African terrestrial water storage revealed by GRACE/GRACE-FO and models},
journal = {Journal of Hydrology},
volume = {677},
pages = {135794},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135794},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008917},
author = {Guodong Xu and Jianli Chen and Yufeng Nie and Shuo Zheng and Jing Li},
keywords = {Terrestrial water storage, Africa, GRACE/-FO, Water balance, EOF},
abstract = {Climate change is intensifying the hydrologic cycle, and terrestrial water storage (TWS) provides an integrated indicator of these shifts. In this study, we analyzed long-term and interannual TWS variations across Africa over April 2002-December 2024 using GRACE/GRACE Follow-On (GRACE/-FO) satellite gravimetry, together with land surface models (LSMs) and satellite altimetry derived lake storage. GRACE/-FO revealed a continental TWS increase of 96.1 ± 13.4 Gt yr−1 (2σ), with an acceleration of 11.6 ± 3.83 Gt yr−2. Basin-scale attribution exhibited that large lakes/reservoirs storage increases largely contributed to the observed TWS gains, whereas model predicted soil moisture showed a general declining trend, likely indicating the limitations of LSMs in this region. The long-term TWS increase was further quantitatively supported by a rising water balance. Interannual variability was structured by large-scale climate modes: El Niño-Southern Oscillation (ENSO) and the Indian Ocean Dipole (IOD) paced continental and tripole-like responses, respectively, as identified by empirical orthogonal function (EOF) analysis. Our results elucidated new observational constraints on the drivers of African TWS dynamics and their responses to a changing climate.}
}
@article{XIE2026135786,
title = {A hierarchical hybrid flood modeling framework: deconstructing runoff response into initiation states and generation processes},
journal = {Journal of Hydrology},
volume = {677},
pages = {135786},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135786},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008838},
author = {Tao Xie and Lu Chen and Bin Yi and Zhiyuan Leng and Siming Li and Yazhong Wu and Deming Zhu},
keywords = {Rainfall-runoff modeling, Runoff initiation, Runoff generation mechanisms, Interpretable machine learning},
abstract = {Catchment runoff response physically entails two hierarchical phases: runoff initiation and runoff generation mechanisms. However, existing hydrological models rarely capture the temporal dynamics and process heterogeneity of both phases simultaneously. This simplification forces models to adapt to varying hydrological behaviors using static structures and parameters, inevitably leading to structural deficiencies and parameter compensation. To address this, we propose a Hierarchical Hybrid Flood Modeling Framework implemented through three progressive components. First, a two-stage flood event partitioning protocol is established to define runoff initiation states using physical thresholds and discriminate dominant runoff generation mechanisms via hypothesis testing. Second, an interpretable machine learning module is developed to dynamically recognize these hydrological categories based on real-time rainfall characteristics and antecedent catchment conditions. Third, a flexible hydrological modeling architecture incorporating multiple runoff generation mechanisms is constructed to adaptively simulate the identified physical processes based on recognition results. Application in the Han River basin demonstrates substantial performance improvements over traditional models, increasing the validation Nash-Sutcliffe Efficiency from 0.62 to 0.68, 0.77 to 0.80, 0.62 to 0.64, and 0.73 to 0.80 across the four catchments, respectively. Furthermore, SHAP-based interpretability analysis confirms the physical realism of the framework by elucidating the controlling factors for both runoff initiation thresholds and distinct runoff generation mechanisms. By reconciling the conflict between static model structures and dynamic hydrological processes, this framework achieves simulation results that are more consistent with the actual physical processes of the catchment.}
}
@article{ZANG2026135803,
title = {Groundwater level recovery drives soil nitrate losses into groundwater: evidence from integrated modeling and statistical analysis},
journal = {Journal of Hydrology},
volume = {677},
pages = {135803},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135803},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009005},
author = {Yongge Zang and Hong Yu and Xu Han and Xinjuan Wang and Yu Yang and Yonghai Jiang},
keywords = {Soil nitrate losses, Groundwater level recovery, Soil nitrate stock, Thick vadose zone, Groundwater nitrate},
abstract = {Abundant soil nitrate (NO3−) have been reported to be accumulated in regions where both the thick vadose zone (TVZ) and intensive agricultural cultivation prevail. The residual NO3− profoundly disrupts terrestrial nitrogen cycles and poses a serious threat to groundwater quality. In particular, the groundwater level (GWL) in these regions, driven by mitigation countermeasures for groundwater depletion, were greatly elevated over recent years, thereby further exacerbating the pollution risk mentioned above. Nevertheless, it remains indistinct how soil NO3− stock in the TVZ respond to this large-scale GWL recovery and whether the underlying regulatory mechanism for their losses is affected at a regional scale. Aimed at this problem, this study established a process-oriented integrated model for the vadose zone-groundwater coupled system in a typical GWL recovery region, followed by multi-variable statistical analysis including correlation analysis, random forest and structural equation modeling. The attained results classified soil NO3− losses across the entire vadose zone into two distinct pathways: leaching driven by water infiltration, and mobilization via physical displacement and hydrodynamic mixing into rising groundwater. The amount of these two losses, triggered by the GWL recovery, increased by 0.74 times and 2.35 times, respectively. Moreover, the mobilization losses gradually replaced the leaching ones as the dominant component of soil NO3− losses. In addition, the GWL recovery has superseded the original critical driver, soil NO3− stock, to become the new primary driver of soil NO3− losses. More importantly, the encounter between soil NO3− content peak and groundwater, stimulated by the GWL recovery, also occurred 0.36–0.79 times earlier, particularly in areas characterized by substantial GWL rise, coarse soil textures, and a thin vadose zone. Appropriate recharge schemes and soil NO3− reduction strategies are therefore urgently required to alleviate the adverse effects associated with the GWL recovery.}
}
@article{YUAN2026135782,
title = {Multi-agent reinforcement learning for competitive-cooperative inter-city water resources allocation: a dynamic strategy optimization framework},
journal = {Journal of Hydrology},
volume = {677},
pages = {135782},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135782},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008796},
author = {Mingkang Yuan and Xueling Guo and Jiabei Hu and Yang Yang},
keywords = {Multi-agent reinforcement learning, Watershed water allocation, Multi-objective optimization, Markov game, CVaR constraints},
abstract = {Climate change and inappropriate anthropogenic activities have intensified the complexity of watershed water resource allocation, creating unprecedented challenges for balancing economic efficiency, social equity, and environmental sustainability. Traditional centralized allocation approaches inadequately capture the strategic interdependencies and dynamic feedback mechanisms inherent in multi-city water distribution processes, particularly under uncertainty and conflicting stakeholder objectives. This study proposes an integrated framework combining Multi-Agent Proximal Policy Optimization (MAPPO) with multi-objective optimization for dynamic watershed water resource allocation. The framework incorporates economic benefit maximization, Gini coefficient-based equity minimization, and cross-regional satisfaction enhancement. It introduces Conditional Value-at-Risk (CVaR) constraints to accommodate risk preferences under hydrological uncertainty. The watershed allocation process is reformulated as a multi-agent Markov game, modeling competitive-cooperative dynamics among cities as autonomous decision entities through continuous state-action interactions and temporal policy evolution. The framework was applied to the Minjiang River Basin in western China across multiple seasons and water use sectors (domestic, agricultural, industrial, and ecological). MAPPO achieved a regional economic output of 8.20 × 1012CNY while maintaining comparable equity levels and attaining the highest satisfaction scores. Scenario analysis demonstrated that CVaR parameter adjustments enabled systematic rebalancing of efficiency-equity-satisfaction trade-offs. Spatial allocation results revealed the framework’s ability to capture urban functional differentiation: agricultural cities (e.g., Meishan) received 60.0% agricultural allocation, industrial cities (e.g., Yibin) obtained 33.5% industrial allocation, and ecologically sensitive regions (e.g., Neijiang) maintained 12.6% ecological allocation. Robustness analysis across multiple independent runs confirmed the superior stability and convergence properties of MAPPO. This integrated framework effectively captures joint resource scarcity risks and provides a scientifically robust foundation for enhancing adaptive water resource management under increasing uncertainty and resource constraints.}
}
@article{ZHANG2026135802,
title = {How does the roots architecture affect the runoff –infiltration –erosion processes under varying rainfall events?},
journal = {Journal of Hydrology},
volume = {677},
pages = {135802},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135802},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008991},
author = {Lin Zhang and Yutong Li and Bingchen Wu and Shi Qi},
keywords = {Root–soil composite, Root architecture, Soil erosion, Soil infiltration, Surface runoff},
abstract = {Plant roots play a critical role in regulating surface–belowground hydrological processes, yet the mechanisms by which root regulates runoff, infiltration and erosion under different rainfall events remain insufficiently understood. In this study, root–soil composites of Moso bamboo (Phyllostachys edulis) with three stand densities, including high-density (S1: 2400 plants ha–1), medium-density (S2: 2000 plants ha–1), and low-density (S3: 1600 plants ha–1), were investigated. Controlled rainfall simulations representing low (20 mm h–1), moderate (30 mm h–1), and high (40 mm h–1) rainfall intensities were applied to quantify the dynamic movement processes of surface runoff, subsurface flow, vertical infiltration and surface sediment were collected and quantified using a custom-designed soil water movement monitoring device. Root architecture and soil pore structure were quantified using CT scanning and pore network modelling. Structural equation modelling was further applied to elucidate root–pore–hydrology linkages. Results indicate that (1) under low to moderate rainfall (20–30 mm h–1), subsurface flow was the dominant hydrological component, accounting for 49.87%–88.70% in S1, 50.57%–89.20% in S2, and 41.60%–81.60% in S3 of the total runoff and infiltration amount. In contrast, under high-intensity rainfall (40 mm h–1), surface runoff became dominant, contributing 72.6%–75.0% across all densities, surface runoff rates ranged from 0.052–0.486 L min–1 m–2 across treatments. (2) Relative to S3, under 20–30 mm h–1, surface runoff and sediment yield in S1 and S2 were 11%–32% and 31%–62% lower, respectively, while subsurface flow in the 10–20 cm and 20–40 cm layers increased by 48.31%–54.68% and 27.76%–30.59%, respectively. However, under 40 mm h–1, no significant density effects were detected for runoff partitioning or sediment yield (P＞0.05). (3) Root effects were mainly indirect and mediated by pore structural changes: the total effects of throat radius, connected porosity, and throat length on surface runoff were − 0.29, 0.35, and 0.24, on subsurface flow were 0.43, 0.48, and − 0.41, and on surface sediment were − 0.21, −0.31, and 0.24, respectively. These results suggest the presence of a potential rainfall-intensity threshold, beyond which the regulatory effects of root–pore structure on runoff partitioning and sediment reduction become substantially weaker.}
}
@article{CHRYSOCHOIDIS2026135842,
title = {The localized sediment resuspension (LSR) model: demonstrating the importance of spatial heterogeneity for improved TSS predictions in combined sewer systems},
journal = {Journal of Hydrology},
volume = {677},
pages = {135842},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135842},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600939X},
author = {Vasileios Chrysochoidis and Peter Steen Mikkelsen and Luca Vezzaro},
keywords = {Urban drainage systems, Sewer Network Modeling, Pollution-based real-time control (P-RTC), Peak-Weighted Dynamic Time Warping (PW-DTW), Spatial Heterogeneity},
abstract = {This study introduces the Localized Sediment Resuspension (LSR) model, which considers spatial heterogeneity in sediment accumulation and resuspension processes across sewer networks to improve predictions of total suspended solids (TSS) fluxes in Combined Sewer Overflows (CSOs). The LSR model involves identifying areas prone to sediment accumulation (virtual hotspots), simulating sediment release based on local hydraulic variables, and routing resuspended sediments along the network. The LSR model results are superimposed on TSS predictions from a detailed hydrodynamic model, improving the representation of TSS peaks during CSO events. To evaluate performance improvements, the newly developed Peak-Weighted Dynamic Time Warping (PW-DTW) metric, which emphasizes peak matching, was employed. The LSR performance was evaluated for different levels of parameter heterogeneity and model complexity. Better TSS predictions were obtained with the model structure that balances uniform sediment accumulation characteristics with spatial heterogeneity in resuspension processes, achieving a 40.1% median improvement in PW-DTW across verification events, with performance improvements observed in all 17 events classified as resuspension-dominated. The performance of the LSR model did not degrade when parameters were estimated using low-temporal-resolution data (composite samples) instead of high-resolution turbidity measurements. Under this low-resolution scenario, a 40.6% median PW-DTW improvement was obtained, again improving all 17 resuspension-dominated events. Overall, the LSR model demonstrates that explicitly considering spatial heterogeneity is essential for improving the modelling of TSS discharges during CSO events, ultimately supporting more effective pollution control strategies.}
}
@article{VINCK2026135774,
title = {Event-based calibration of build-up parameters in conceptual water quality models using turbidity data},
journal = {Journal of Hydrology},
volume = {677},
pages = {135774},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135774},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008711},
author = {Evi Vinck and Matej Radinja and Neil {Van den Broeck} and Margherita Evangelisti and Birgit {De Bock} and Arnout Roukaerts and Stijn {Van Hoey} and Niels {De Vleeschouwer} and Sacha Gobeyn and Dario Frascari and Vittorio {Di Federico}},
keywords = {Event-based calibration, Turbidity monitoring, Build-up/wash-off modeling, Total suspended solids, Urban runoff, Stormwater quality, Traffic-related pollution},
abstract = {Build-up/wash-off water quality models are frequently used to assess stormwater runoff quality. In this work, we explore the possibility of using continuous turbidity data to calibrate and validate such models under realistic conditions in two case studies located in Flanders, Belgium. By using such rich continuous data, a much larger number of rainfall events can be used for calibration than it is feasible with grab samples. The approach shows that the build-up rate used in these conceptual models varies widely during different rainfall events between 100 and 1350 kg/ha/y in the first case study and between 100 and 1750 kg/ha/y in the second case study. The time dependence of the build-up rates from different catchment types and its correlations with site-specific information/external conditions, such as wind speed, temperature and traffic volume are investigated. The modelled build-up rates are lower during storm events in weekend days compared to week days, consistent with traffic measurements. Furthermore, emission factors for different vehicle types previously published in literature can be used to estimate the build-up rate for streets. In one case study a strong negative correlation between wind speed and build-up rate was observed (r = −0.89). Overall, our study shows that continuous turbidity data can be used to study the impact of external conditions on the build-up rate in conceptual water quality models.}
}
@article{TAN2026135746,
title = {Copula-based risk identification and HydroFusionNet-driven prediction with potential causal-linkage interpretation for compound drought–heat events},
journal = {Journal of Hydrology},
volume = {677},
pages = {135746},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135746},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008437},
author = {Zuowen Tan and Zhengxuan Liu and Yinzhe Ou and Zhaoyang Zhu and Yuanzhuo Zhong and Chao Ma and Zhaocai Wang and Yuxue Guo},
keywords = {Compound drought-heat events, Copula function, Deep learning model, Shapley additive explanations, Convergent cross mapping},
abstract = {Under global warming, compound drought–heat events (CDHEs) have intensified and pose increasing risks to water resources, ecosystems, and agricultural production, particularly in semi-arid transitional basins. However, the joint-risk characteristics, categorical predictability, and driving mechanisms of CDHEs in the Weihe River Basin remain insufficiently understood. This study develops an integrated analytical framework combining Copula-based risk identification, HydroFusionNet-driven prediction, and potential causal-linkage interpretation to assess CDHEs. First, the Standardized Precipitation Index (SPI) and Standardized Temperature Index (STI) were used to characterize drought and heat anomalies, and multiple Copula functions were applied to quantify the joint occurrence probabilities and return periods of CDHEs under different intensity combinations. Second, HydroFusionNet was developed by integrating temporal embedding, residual convolutional feature extraction, bidirectional recurrent sequence modeling, and Transformer-based global dependency learning to predict CDHE occurrence using meteorological, hydrological, and vegetation-related variables. Finally, Shapley Additive Explanations (SHAP) was combined with convergent cross mapping (CCM) to identify the relative contributions of key drivers and further examine potential causal linkages between major hydrothermal variables and CDHEs. The results show that the frequency of moderate-to-severe heat events in the Weihe River Basin has increased markedly since 2000, and the return period of extreme drought–heat combinations in the North Luohe River sub-basin reaches approximately 40–70 years, which is substantially higher than those in other sub-basins. SHAP results indicate that precipitation contributes most to CDHE prediction, accounting for 23.2%–35.8% of the total importance, followed by minimum temperature and mean temperature. CCM analysis further reveals stable hydrothermal coupling among temperature-, moisture-, and vegetation-related variables. Large-scale circulation diagnostics show that CDHE occurrence is significantly and negatively correlated with synchronous AO and with the one-month lagged PNA and PDO; meanwhile, CDHE months are generally associated with lower AO, NAO, and PDO and higher NP and GAT, indicating that regional CDHEs are jointly influenced by local hydrothermal conditions and large-scale background signals.}
}
@article{GUO2026135798,
title = {Analyzing the interaction mechanism between the loose rock aquifer system and river based on the Reynolds-Averaged Navier–Stokes equations},
journal = {Journal of Hydrology},
volume = {677},
pages = {135798},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135798},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008954},
author = {Yudong Guo and Yuan Gao and Xiaonong Hu and Xiaoguang Wang},
keywords = {Interaction between the loose rock aquifer system and river, Macropore preferential flow, Reynolds-averaged Navier–Stokes (RANS) equations, Rainfall-driven, Non-Darcy flow},
abstract = {Understanding the interaction between rainfall-driven unconsolidated rock aquifer systems and riverbank processes, particularly the flow behavior and dynamic saturation processes of groundwater within various media of the unconsolidated rock aquifer during such interactions, holds significant theoretical guidance for the accurate assessment and sustainable development and utilization of such groundwater resources. Currently, the mechanisms governing this interaction remain unclear, and existing models struggle to characterize microscopic flow behavior, turbulence effects, and the dynamic evolution of medium saturation in macro-porous media. To address these issues, this study develops a three-dimensional gas–liquid two-phase flow model that couples the Volume of Fluid (VOF) method, Reynolds-Averaged Navier-Stokes (RANS) equations, and dual-continuum theory, and defines two dimensionless parameters-dynamic hydraulic tortuosity and characteristic time ratio—for quantitative analysis. The results show that rainfall intensity governs the shift in recharge-discharge direction between media and the distribution of runoff. Under high-intensity rainfall, rapid drainage through macropores raises river levels and induces river recharge to sedimentary layers, altering aquifer-river interaction behavior. The effects of turbulent eddy viscosity and inertial resistance modify hydrological response characteristics. Compared to laminar flow assumptions and the Boussinesq semi-analytical solution based on homogeneous Darcy flow, the RANS numerical solution exhibits lower drainage peaks, peak lag, and multi-peak fluctuations, reflecting the dynamic storage and buffering capacity of the aquifer system. Dynamic hydraulic tortuosity decays exponentially with increasing rainfall, representing the physical process in which the characteristic length of groundwater motion is progressively reduced by the constraints of the medium skeleton. The characteristic time ratio of macropore flow to matrix flow transitions from a power-law increase to an exponential jump, indicating a shift in system dominance from matrix flow to macropore flow on the temporal scale. This study provides a microdynamic basis for the accurate assessment of unconsolidated rock groundwater resources and the prevention and control of flood disasters.}
}
@article{FAN2026135814,
title = {Consistency of rain storm properties observed by TRMM and GPM for climatological trend analysis},
journal = {Journal of Hydrology},
volume = {677},
pages = {135814},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135814},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600911X},
author = {Xiaoye Fan and Banghai Wu and Yu Wang and Jing Xi and Shi Liu and Yixiao Fu and Zuqian Su},
keywords = {TRMM, GPM, Rain Storm, Consistency, Climate Dataset},
abstract = {Precipitation plays an essential role in the Earth’s water and energy cycles. Investigating long-term climatological changes in rainstorm characteristics, such as three-dimensional (3-D) structure, can provide valuable insights into global precipitation variation and the response of multiple complex physical mechanisms within precipitation systems to climate change. In this study, various rainstorm properties observed by the Precipitation Radar onboard the Tropical Rainfall Measuring Mission (TRMM) satellite and the Dual-frequency Precipitation Radar on the Global Precipitation Measurement Mission (GPM) satellite are compared. The results suggest that the discrepancy in detection ability of weak precipitation between them is expected as the primary cause for the differences in most rainstorm properties. To ensure consistency in the construction of the climatic rainstorm dataset consisting of observations from the two radars, three strategies are employed, including excluding pixels within rainstorms with surface rain rates less than 0.5 mm/h, using specific reflectivity thresholds to indicate the 3-D scales, and choosing characteristic parameters that are less affected by weak precipitation. In addition, the consistency can be further enhanced by selecting those rainstorms with an averaged rain rate exceeding 1.5 mm/h, contributing over 90% of the total global rainfall amount. Finally, a 21-year (2002–2022) rainstorm dataset including 12 highly consistent feature parameters to describe 3-D scale and intensity is constructed for climate trend analysis. Results indicate an increasing horizontal size over tropical land but a decreasing precipitation intensity over the tropical ocean, whereas no significant trend in vertical extent. Additionally, a notable trend disparity exists between the overall rainstorm and its heavy precipitation component, with the latter exhibiting a decreasing horizontal size and an increasing vertical extent in most tropical regions. These findings provide valuable support for the development of a long-term, continuous, and consistent rainstorm feature dataset from satellite observations for precipitation climatology research, contributing to better climate model evaluations and predictions.}
}
@article{SONG2026135790,
title = {Parameterized physics-informed neural networks for flow reconstruction around idealized islands under data-sparse conditions},
journal = {Journal of Hydrology},
volume = {677},
pages = {135790},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135790},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008875},
author = {Xiaolong Song and Boliang Liu and Zhong Xiao and Haijue Xu and Yuchuan Bai},
keywords = {Coastal hydrology, Parameterized physics‑informed neural networks, Sustainable water management, Island environments, Data-scarce regions, Eco-hydraulics},
abstract = {Sustainable management of coastal island environments is often hampered by limited observational data and the high computational cost of resolving complex flow dynamics. This research introduces a parameterized physics–informed neural network (PINN) framework that integrates experimental measurements with flow physics to reconstruct three-dimensional flow fields around islands. The methodology employs a multi-stage training approach: initial learning from domain-wide large eddy simulations, followed by refinement using tomographic particle image velocimetry data, and final optimization across multiple flow regimes. Validation against independent experimental datasets demonstrates robust performance across Reynolds numbers 24,000–96,000, achieving correlation coefficients exceeding 0.9 for primary flow components. Crucially, the framework successfully infers flow characteristics in unmeasured regions, particularly near‑bed zones essential for assessing erosion processes and benthic habitat stability. Analysis reveals complex, regime-dependent relationships between hydrological parameters and wake dynamics that traditional discrete sampling cannot resolve. Specifically, the model identifies an optimal eco-hydrological stability window at intermediate Reynolds numbers (Re≈48,000), driven by a stable wake reattachment mechanism that shelters downstream habitats. Furthermore, it quantifies a distinct thrust generation window and significant low-Re flow asymmetry, providing critical insights for sediment transport pathways. The trained model enables rapid generation of: (i) eco-hydrological suitability maps for marine spatial planning, (ii) erosion risk assessments based on bed shear stress distributions, and (iii) hydraulic resistance characterizations for regional scale modeling. This approach offers significant advantages for coastal hydrology by providing high-fidelity field reconstruction from experimental data, offering a valuable tool for water resource management and environmental protection in complex island systems.}
}
@article{CUI2026135827,
title = {Soil moisture thresholds for runoff generation: depth sensitivity and mechanistic controls},
journal = {Journal of Hydrology},
volume = {677},
pages = {135827},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135827},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009248},
author = {Zhen Cui and Fuqiang Tian},
keywords = {Runoff generation, Threshold, Soil moisture integration depth, Segmented regression, Stormflow prediction},
abstract = {A compound wetness index combining antecedent soil moisture and event rainfall (S0 = ASI0 + P) is commonly used to analyze threshold-based runoff responses. However, it remains unclear how the depth of soil moisture integration affects threshold detection and predictive performance. Here, we examined the relationship between runoff thresholds and maximum integration depth (MID) across four experimental catchments spanning diverse climates and runoff generation mechanisms. Using segmented regression across multiple MIDs and monitoring sites, we identified runoff thresholds and evaluated the explanatory power of S0 for stormflow using post-threshold coefficients of determination (Rh2). Thresholds were consistently detected across integration depths, but explanatory power varies strongly among catchments. In storage-controlled systems, Rh2 increased with depth, indicating that deeper soil moisture integration better captured subsurface storage controls on stormflow initiation. In contrast, in connectivity-limited or shallow flow-dominated systems, shallow integration depths performed better because near-surface wetting controlled preferential flow or infiltration-excess runoff, whereas deeper integration included hydrologically inactive storage. These results show that the optimal integration depth is catchment dependent and closely linked to dominant runoff generation processes. Accounting for this depth dependence can improve threshold-based runoff analysis and support more process-consistent soil moisture monitoring and hydrological modeling.}
}
@article{LIN2026135806,
title = {Physical mechanisms controlling summer hypoxia hotspots in a large multi-outlet estuary},
journal = {Journal of Hydrology},
volume = {677},
pages = {135806},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135806},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009030},
author = {Zhenkun Lin and Xiangyu Li and Zheng Chen and Aijun Wang and Jiatang Hu and Jiaxue Wu},
keywords = {Pearl River estuary, 3-D hydrodynamic-biogeochemical modeling, Hypoxic hotspots, Tidal straining, Mixing timescale},
abstract = {Coastal stratification is traditionally considered the primary physical driver of hypoxia by suppressing vertical mixing and dissolved oxygen (DO) ventilation. However, this classical paradigm often fails in highly dynamic estuaries. Using a validated hydrodynamic-biogeochemical model, we reconstructed summer hypoxia in the Pearl River Estuary (PRE) to investigate the physical mechanisms controlling hotspots in the western (WHZ) and eastern (EHZ) shelf regions. A DO budget analysis reveals that, despite significantly stronger stratification, WHZ exhibits a vertical diffusive DO flux that is twice that of EHZ, making it the overwhelmingly dominant term in bottom physical DO supply. This paradox is driven by tidal straining: in WHZ, intense negative tidal straining (<−1.5 × 10−4 psu2 s−1) disrupts stratification and enhances DO diffusion during the late flood phase, even under low shear stress (<0.1 Pa). In contrast, weak tidal straining in the EHZ leaves DO diffusion governed almost entirely by bottom shear stress. Furthermore, in the EHZ, mixing requires nearly a full tidal cycle; by contrast, tidal straining-induced bottom mixing in the WHZ efficiently penetrates the entire water column within half a tidal cycle, making bottom DO dynamics in WHZ strongly tied to stratification fluctuations. This study provides a physical mechanism that explains the bias in the traditional stratification-controlled DO pattern, thereby improving our ability to manage hypoxia in highly dynamic coastal systems.}
}
@article{CONGTHI2026135822,
title = {Integrating petrophysical uncertainty in salinity estimation from ERT and well data using indicator kriging},
journal = {Journal of Hydrology},
volume = {677},
pages = {135822},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135822},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009194},
author = {Diep Cong-Thi and Ellen Van {De Vijver} and Linh Pham Dieu and Hieu Ho Huu and Frédéric Nguyen and Thomas Hermans},
keywords = {Saltwater intrusion, Coastal aquifers, Indicator kriging, Electrical resistivity tomography, Probabilistic mapping},
abstract = {Understanding and mapping saltwater intrusion (SI) in coastal aquifers is crucial for safeguarding freshwater resources, yet its spatial characterization remains highly uncertain. Conventional well sampling delivers accurate salinity measurements but is spatially limited, whereas geophysical imaging captures broader subsurface patterns but provides only indirect information constrained by uncertain petrophysical models. To address this, we integrate hydrochemical and geophysical datasets within a probabilistic geostatistical framework. Specifically, total dissolved solids (TDS) concentrations from 70 shallow wells (5–10 m) are combined with electrical resistivity tomography (ERT) data collected along 28 transects in the Luy River catchment, Vietnam. Laboratory experiments established two distinct resistivity–salinity relationships for clay-free and clay-bearing sediments. Uncertainty arises from the unknown clay content at specific locations, representing a key source of ambiguity in petrophysical relationships. Accordingly, each resistivity value was expressed as a probability of exceeding predefined salinity thresholds derived from the TDS distribution. Both a traditional binary indicator transformation and an extended encoding with continuous probabilities were tested. As highlighted by a cross-validation analysis, the combined dataset produces a more consistent and spatially detailed delineation of SI than TDS-only kriging. Moreover, the probabilistic framework explicitly accounts for alternative petrophysical scenarios and quantifies the likelihood of crossing critical salinity limits. This study illustrates the effectiveness of integrating hydrochemical observations with geophysical measurements using indicator kriging to improve the reliability of SI mapping in heterogeneous coastal aquifers.}
}
@article{CHEN2026135830,
title = {Scale-specific controls of annual suspended sediment yield in Yellow River Basin},
journal = {Journal of Hydrology},
volume = {677},
pages = {135830},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135830},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009273},
author = {Zhongmin Chen and Sixiao Zhang and Wenhai Shi and Juan Zhao},
keywords = {Soil erosion, Multivariate empirical mode decomposition, Multiscale analysis, Yellow River Basin},
abstract = {Sediment transport is inherently multi-scale and nonlinear, driven by interactions among meteorological, hydrological and ecological processes. However, the scale-dependent relationships between sediment yield and its potential drivers remain poorly understood since multiple underlying mechanisms overlap at the observational scale. To address this gap, this study applies multivariate empirical mode decomposition (MEMD) to identify the scale-specific controls on sediment production. Annual sediment yield and five influencing factors—runoff, temperature, precipitation, potential evapotranspiration, and the normalized difference vegetation index—were compiled for six sub-basins of the Yellow River Basin during 1985–2017. Each variable was decomposed into intrinsic mode functions (IMFs) and a residual component, allowing scale-specific sediment–environment linkages to be identified. The results showed that sediment yield exhibited significant associations at specific scales, including cases where no significant relationship was observed at the observational scale. These controlling relationships were strongly scale-dependent and spatially heterogeneous, with several predictors exerting greater influence at longer time scales. Scale-specific drivers reproduced sediment yield effectively for individual IMFs and residuals, while sediment yield at the observational scale was accurately reconstructed by summing all scale-based predictions. Runoff and precipitation emerged as the dominant predictors in most sub-basins, whereas basin-specific differences were observed for temperature and potential evapotranspiration. MEMD-based modeling substantially improved sediment prediction accuracy (R2 = 0.71–0.93) compared with models using undecomposed data (R2 = 0.37–0.86). These results demonstrate that sediment–environment interactions cannot be fully captured at a single time scale and highlight the potential of MEMD for disentangling multiscale sediment dynamics and improving sediment-yield predictions in large river basins.}
}
@article{LI2026135785,
title = {Performance of self-supervised learning for estimating lake water quality parameters under scarce in-situ data},
journal = {Journal of Hydrology},
volume = {677},
pages = {135785},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135785},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008826},
author = {Kaiji Li and Guoqiang Wang and A Yinglan and Jin Wu and Shuyu Zeng and Qiao Wang},
keywords = {Water quality, Remote sensing, Self-supervised learning, Limited labels},
abstract = {Remote sensing is useful for large-scale water quality monitoring. However, traditional methods rely on sizeable ground-truth data synchronized with satellite overpasses, which are scarce owing to the limitations of satellite revisit cycles. Although self-supervised learning (SSL) can reduce the dependence on labeled data, it has limited applications in quantitative estimation of aquatic environments. This study takes as cases representative lakes with significant differences across northern and southern China, with a focus on estimating total phosphorus (TP) and total nitrogen (TN), constructing a general framework for aquatic environment estimation based on self-supervised learning, and explores the optimal inversion path of “learning-representation-regression” for limited labeled data of aquatic environment parameters. First, a self-supervised learning framework was constructed in Lake Taihu, and the performance of the combined estimation with different learning paradigms (variational autoencoder, VAE; Bootstrap Your Own Latent, BYOL) and multiple regressors was compared. The results showed that the model has high performance despite the limited number of satellite-ground matched samples (N = 106). Among them, the combination based on VAE representation and coupled with multilayer perceptron (MLP) regression worked best (TP: mean absolute error (MAE) = 23.03%, Bias = 6.00%, RMSE = 0.022 mg/L; TN: MAE = 39.14%, Bias = 4.77%, RMSE = 0.54 mg/L) among all candidate models. Comparisons with traditional supervised regressors, strong baselines and stability analyses further supported the robustness of the selected model under limited labeled samples, although TN showed greater sample sensitivity than TP. The same framework was further applied to Lake Hulun for cross-lake validation and maintained good performance, partly associated with the lower relative heterogeneity of the Hulun samples. Finally, the historical spatiotemporal patterns of TP and TN during the growing season in Lake Taihu since 2019 were reconstructed, and their temporal variations were discussed in relation to possible meteorological and lake-management influences. Overall, the framework constructed in this study provides a practical and feasible technical pathway for water quality estimation in lake regions where samples are scarce and large-scale sampling is challenging.}
}
@article{LIU2026135680,
title = {Application of real-time data assimilation system to improve streamflow forecasts in Japan},
journal = {Journal of Hydrology},
volume = {677},
pages = {135680},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135680},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007778},
author = {Yingying Liu and Kei Yoshimura and Menaka Revel and Yuting Zhu},
keywords = {Data assimilation, Real-time, Large-scale hydrodynamic modeling, Flood forecasting, National-scale decision support},
abstract = {Accurate and timely flood forecasting is vital for effective water management and disaster mitigation. Data assimilation (DA) can improve hydrodynamic model performance by integrating real-time observations, yet its practical use at national scale remains limited. This study presents the first development of a real-time online DA system in Japan for a large-scale hydrodynamic model, assimilating hourly water surface elevation (WSE) observations from 1800 in-situ gauges across the country. The system employs the Local Ensemble Transform Kalman Filter (LETKF), which updates model states using only spatially relevant observations. This localization expands DA coverage from 10% to 58.4% by leveraging nearby gauges to correct conditions even at non-observed locations. System performance was evaluated across three major flood events in Japan and assessed on WSE, river discharge, and inundation extent. At assimilated stations, DA improved WSE accuracy at 78%-95% of stations. For discharge, 65% of stations improved, with over 60% achieving a Kling-Gupta Efficiency (KGE) above 0.5, demonstrating benefits for non-assimilated variables as well. When assimilating only surrounding gauges, over 80% of stations still showed improved WSE. Forecasting skill was also enhanced. In events with relatively good open-loop (OL) predictions, DA outperformed OL simulations for lead times of up to 5 hours. In events with poor OL predictions, DA consistently enhanced forecasts one-day-ahead. Comparison with SAR-derived flood extent further confirmed improved inundation mapping within 24-hour lead times, as DA results exhibited reduced overestimation relative to OL. These results demonstrate a practical real-time DA framework for national-scale flood forecasting and management.}
}
@article{WANG2026135777,
title = {An approximate surface-sewer coupling framework for urban flood modeling under data scarcity},
journal = {Journal of Hydrology},
volume = {677},
pages = {135777},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135777},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008747},
author = {Xiao Wang and Hui Chen and Yanqing Li and Jia Wang},
keywords = {Urban flood modeling, Surface-sewer coupling, Equivalent representation, Spatial constraints, Drainage influence zones, Data-scarce},
abstract = {One of the major challenges in urban flood modeling is the accurate representation of surface-sewer hydrodynamic interactions under limited data availability. Existing bidirectional coupling models can capture flow dynamics, however, their heavy reliance on detailed sewer network data severely restricts their applicability. To address this issue, an approximate coupling framework is proposed based on equivalent representations and spatial constraints, with the aim of balancing physical realism and computational efficiency. Within this framework, equivalent topological relations and exchange nodes are established between the surface and sewer systems by integrating road-derived flow routes, the spatial distribution of stormwater inlets, and the configuration of flood-prone units. Based on this, drainage influence zones are delineated, and a spatial-domain control mechanism is introduced to regulate the extent and intensity of water exchange. This approach preserves spatial consistency and mitigates distortions caused by neglecting sewer network heterogeneity in conventional models. The framework was assessed through two complementary case studies: a benchmark comparison against a model based on the actual sewer network in a data-rich urban area, and an observation-based validation using monitored water depths in a data-scarce urban area under rainfall events of varying intensities. The results demonstrate that the proposed approach achieves a coherent representation of the water exchange mechanism by integrating equivalent representation, spatial constraints, and temporal consistency, thereby providing a simple yet robust tool for urban drainage planning and flood risk assessment under data-scarce conditions.}
}
@article{CHU2026135793,
title = {An efficient fracture network reduction method for characterizing flow and mass transport in three-dimensional fracture networks},
journal = {Journal of Hydrology},
volume = {677},
pages = {135793},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135793},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008905},
author = {Tong Chu and Ziyue Yin and Jian Song and Yun Yang and Xiaomin Sun and Jianfeng Wu and Jichun Wu},
keywords = {Fracture network, Topology, Network simplicity, Network analysis, Flow and transport, Modified sweep-and-prune},
abstract = {It remains a long-standing challenge in hydrological modeling to accurately and efficiently simulate flow and solute transport in fractured rock. This study establishes a topology-transport correlation through network analysis and develops a network-system reduction method that retains only the key subnetworks where flow and solute transport are highly concentrated, thereby addressing the long-standing trade-off between efficiency and fidelity in conventional methods. The approach integrates betweenness centrality with the Dijkstra’s algorithm, and employs an optimized sweep-and-prune technique for rapid fracture intersection detection. Its performance is evaluated using two test cases: a semi-generic synthetic network and field data from the Beishan Underground Research Laboratory in Gansu Province, Northwest China. Global and local network analyses demonstrate that the connected subnetwork formed by dominant fractures governs mass transport processes across the entire network, with flow modeling errors remaining below 2%. The optimal pruning schemes for different networks not only preserve essential adsorption and transport characteristics but also achieve computational savings of 50% or even more than 90%, effectively balancing fidelity and efficiency. For the Beishan granite test case, a reduced network comprising approximately 30% of the original fractures reproduces about 85% of the reference flow response while requiring only about one-tenth of the computational time. Although dominant transport pathways vary among fracture networks with different structural features, the 50% simplification scheme consistently maintains over 80% fidelity across all test scenarios and serves as a robust initial pruning strategy. Unlike conventional geometric equivalence methods, the proposed approach is based on a physically guided topology–performance relationship, enabling accurate representation of key hydrological processes. It offers a computationally efficient and physically consistent tool with strong potential for applications in contamination control, geothermal energy, and hydrocarbon reservoir modeling.}
}
@article{WANG2026135826,
title = {Impact of fire-induced hydrophobic layer formation on hydraulic conductivity in sandy soil},
journal = {Journal of Hydrology},
volume = {677},
pages = {135826},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135826},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009236},
author = {Shuda Wang and Qihao Li and Vinayak Srivastava and Chen Chen and Hong Je Cho and Haejun Park and Ruiqing Shen and Jaime C. Schussler},
keywords = {Post-wildfire hydrology, Hydrophobic layer, Hydraulic conductivity, Water vapor adsorption},
abstract = {Wildfires alter soil properties and hydrological processes by depleting moisture and forming hydrophobic layers that reduce infiltration and increase runoff. This study used a cone heater to simulate one-dimensional surface heating on sandy soils with and without organic matter and characterized hydrophysical responses through hydraulic conductivity and water vapor adsorption tests. Target temperatures ranging from 100 to 400°C were applied to the samples and achieved when the thermocouple nearest the surface (i.e., 1.27 cm depth) reached the temperature. The hydrophobic layer migrated deeper into the sample as surface heating increased in temperature, and its presence was confirmed through the water vapor adsorption tests. The hydrophobic layer was located between the surface and 1.27 cm depth at 100°C, whereas at 400°C it shifted to the interval between 1.27 and 2.54 cm. Quantitatively, the hydraulic conductivity was reduced by approximately 98% at 100°C and 65% at 400°C. These results offer a reproducible framework for elucidating hydrophobic layer formation, migration, and infiltration response when joined with hydraulic conductivity and water vapor adsorption tests. The results of this study will support improved parameterization of post-wildfire hydrological models and can inform water-resource management in fire-impacted landscapes.}
}
@article{QUBAJA2026135765,
title = {Open canal evaporation in an arid urban environment in Arizona estimated with measurements of water isotopes},
journal = {Journal of Hydrology},
volume = {677},
pages = {135765},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135765},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008620},
author = {Rafat Qubaja and Enrique R. Vivoni and Murray Moinester and Diane E. Pataki},
keywords = {Stable water isotopes, Isotopic enrichment, Open water evaporation, Canal system, Water management, Solar-canal photovoltaic systems},
abstract = {Stable isotopes of water have extensive applications for studying hydrological processes. Isotopic enrichment can be used to estimate evaporation from concrete-lined open water canals which is important for water resources management in arid regions. In this study, the isotopic composition (δ18O and δ2H) of water was sampled along two Canals in Phoenix, Arizona, USA (Arizona Canal; AC, and Crosscut canal; CC) over about one year (June 2023 to May 2024), prior to photovoltaic (PV) canal coverage. Measurements showed a trend of progressive enrichment of heavy isotopes along the length of both canals, indicative of evaporative enrichment. Using the Craig-Gordon (C-G) evaporation model, we estimated evaporation losses of 5.2 ± 2.3% and 3.3 ± 1.5% for AC and CC, respectively, with large seasonal differences and greater rates of evaporation in summer that reached 8.5%. The Canal Water Evaporation Line (CWEL) slope for the AC and CC was 5.0, with no significant differences between the two canals. Isotope-based canal evaporation losses were consistent with pan evaporation data, with Normalized Root Mean Square Errors (NRMSE) of 6 and 3% for AC and CC, respectively, against pan evaporation. This approach provides a means for monitoring evaporative losses from open water canals in arid areas which can aid water resources managers with closing the large delivery systems water budgets, and provides baseline data for assessing future solar panel canal installations in arid cities.}
}
@article{YANG2026135818,
title = {Thaw slump susceptibility assessment in the central Qinghai–Tibet Plateau permafrost region based on an interpretable 2D-CNN framework with SBAS-InSAR deformation},
journal = {Journal of Hydrology},
volume = {677},
pages = {135818},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135818},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009157},
author = {Yuting Yang and Rui Wang and Chen Liu and Xia Hu and Jifu Liu and Lianyou Liu and Xiaoyan Li and Hao Zheng},
keywords = {Permafrost degradation, Thaw slump susceptibility, SBAS-InSAR, Interpretable 2D-CNN, Environmental controls, Qinghai-Tibet Plateau},
abstract = {Permafrost degradation has substantially accelerated the development of thaw slumps in response to climate warming on the Qinghai-Tibet Plateau (QTP). Thaw slumps represent thermokarst-related hydro-geomorphic features that significantly affect landscape stability and hydrological processes. Thaw slump susceptibility assessment is an effective tool for understanding permafrost landscape responses to climate warming and supporting risk-informed management. However, existing assessments often overlook permafrost surface deformation and the spatially coupled interactions of environmental factors, limiting understanding of thaw slump development mechanisms. In this study, an interpretable two-dimensional convolutional neural network (2D-CNN) framework was employed to assess thaw slump susceptibility, incorporating surface deformation derived from small baseline subset (SBAS) InSAR to capture spatially coupled environmental controls. In addition, the influences of environmental factors were quantitatively analyzed using Shapley additive explanations (SHAP) and structural equation modeling (SEM). Results indicate that integrating SBAS-InSAR–derived surface deformation substantially improved thaw slump susceptibility prediction, with the model achieving an AUC of 0.981 and outperforming models without deformation or pixel-based approaches. Based on the susceptibility assessment, incorporating surface deformation enhanced the spatial targeting of high-risk areas, with 177.28 km2 covering 85.23% of mapped thaw slumps, compared with 223.61 km2 and 84.86% without deformation data, indicating a substantial reduction in false-positive predictions. The NDVI, slope, and surface deformation rate were identified as the primary factors associated with thaw slump development, and further analysis revealed that non-linear interactions among these factors are closely related to surface instability. This study presents a robust and interpretable framework for evaluating thaw slump susceptibility, providing new insights into environmental controls while supporting landscape management in permafrost regions.}
}
@article{MING2026135757,
title = {Uranium and neodymium isotopic constraints on provenance of aquifer sediments hosting high arsenic groundwater},
journal = {Journal of Hydrology},
volume = {677},
pages = {135757},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135757},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008541},
author = {Xiaoxing Ming and Huaming Guo and Zhipeng Gao and Yao Li and Zhuo Zhang},
keywords = {Geologic arsenic, Sediment provenance, Large, hot orogens, Tibetan Plateau, Sedimentary basin},
abstract = {Although high arsenic (As) groundwater occurs throughout the world, the lack of powerful evidence from the aquifer sediments hinders the understanding about source of aquifer sediments hosting high As groundwater. In this study, the U isotopes, Nd isotopes, and elemental ratios of aquifer sediments were used to investigate the provenance of aquifer sediments hosting high As groundwater in the Hetao Basin, China and test the hypothesis that aquifer sediments hosting high As groundwater was originally sourced from large, hot orogens. The aquifer sediments in the basin generally had high εNd values (−11.2 ± 0.8) and low (234U/238U) values (0.953 ± 0.010), indicating that these sediments were mainly from the Northeastern Tibetan Plateau (large, hot orogens) in the Upper Yellow River (72% ± 15%). The aquifer sediments from the Upper Yellow River had higher contents of As (up to 29.6 mg/kg) than those from the Yinshan Mountains (up to 9.8 mg/kg). The aquifer sediments with high contents of As inherited source rocks, which was evidenced by low Chemical Index of Alteration (CIA) values (about 50 to 60) and weak correlations between CIA values and As/Al2O3 ratio. In the alluvial fans and the transition area, the sediment provenance predominantly influenced groundwater As concentrations, where groundwater from aquifers sourced from the Upper Yellow River generally had higher As concentrations than that from the Yinshan Mountains. In the flat plain, both sediment provenance and hydrogeochemical processes collectively regulated As concentrations in groundwater. The study provides direct evidence for the provenance of the aquifer sediments and its effect on As contents in the aquifer sediments and groundwater.}
}
@article{XU2026135846,
title = {Spatiotemporal evolution, physical drivers, and future prediction of global terrestrial moisture imbalance: a multi-expert AI-agent approach based on SVBI},
journal = {Journal of Hydrology},
volume = {677},
pages = {135846},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135846},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009431},
author = {Longhao Xu and Kebiao Mao and Zhonghua Guo and Jiancheng Shi and Sayed M. Bateni and Zijin Yuan},
keywords = {Standardized Vapor Balance Index (SVBI), Physical driving mechanisms, SHAP analysis, Multi-expert AI-Agent, Future risk projection},
abstract = {Global warming intensifies terrestrial moisture imbalance (vapor supply–demand mismatch), while traditional indices exhibit limitations in capturing flash anomalies induced by water vapor dynamic feedback. This study proposes the Standardized Vapor Balance Index (SVBI) and a collaborative framework based on AI-Agent routing and multi-expert systems to systematically analyze global moisture imbalance evolution, physical drivers, and projections from 1979 to 2024. Results demonstrate a physical decoupling between SVBI and SPEI (R = 0.185), with SVBI exhibiting superior sensitivity to flash signals. Global imbalance displays pronounced seasonality, the summer grid trend reaches 0.277 decade−1, while the North Frigid Zone winter shows a negative evolution (−0.213 decade−1) under polar locking. Extreme events feature “high intensity and long duration,” with a tropical peak severity of 6.36 and a maximum duration of 5.40 months in the North Frigid Zone. Nonlinear attribution identifies TCWV as the dominant variable (21.3% contribution), with summer imbalance governed by dynamic processes (70%) and winter strictly constrained by thermodynamics. Projections across three emission scenarios (SSP1-2.6, 2–4.5, 5–8.5) via the Agent-Expert framework reveal a risk landscape of “northern intensification and southern stability.” Regional peak intensities, particularly in mid-to-high latitudes, consistently exceed the 3.0 high-risk threshold, with North Frigid Zone variability reaching 0.878, signaling systemic non-stationarity in high-latitude moisture cycles. These findings inform global moisture risk monitoring and regional water resource management.}
}
@article{RUELLAND2026135769,
title = {Representing glacier evolution for modelling hydrological responses to climate change in mountainous catchments},
journal = {Journal of Hydrology},
volume = {677},
pages = {135769},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135769},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008668},
author = {Denis Ruelland and Florian Antoine and Antoine Rabatel},
keywords = {Glacier dynamic model, Glacier retreat, Glacier contribution to runoff, Transient regime, French Alps},
abstract = {This paper presents the integration of a glacier evolution scheme into the spatially distributed Snow and Ice Accounting Routine (SIAR) and its coupling with a daily runoff model to assess the influence of glacier recession on streamflow in glacierized catchments of the French Alps. Glacier changes are simulated using the Δh parameterization within SIAR, allowing dynamic representation of glacier area and ice mass evolution. Model calibration follows a multi-criteria strategy combining streamflow, snow water equivalent (SWE), remotely sensed snow and ice cover, and glacier areas for 1967–2024. SWE and glacier extent data are shown to be key for constraining accumulation, melt, and long-term mass balance. Despite incorporating glacier evolution, only a few hydrological parameters require calibration, demonstrating the feasibility of a parsimonious yet process-based representation of snow and ice. In particular, adjusting precipitation inputs for orographic effects and wind under-catch reduces parameter complexity while maintaining consistency across multiple variables. Although accounting for glacier evolution does not systematically improve streamflow metrics, it enhances the physical realism of simulated snow and ice processes. Results also reveal two distinct hydrological responses depending on glacier coverage: in highly glacierized catchments (>15%), sustained meltwater input continues to support summer flows, indicating that peak water has not yet been reached; in contrast, catchments with limited glacier extent exhibit a shift toward snow-dominated regimes and reduced summer runoff. These contrasting behaviours highlight differences in glacier storage capacity and response time, emphasizing the importance of accounting for evolving cryospheric processes in hydrological modelling under climate change.}
}
@article{WU2026135858,
title = {Radial flow in an anisotropic aperture field in a rough-walled fracture},
journal = {Journal of Hydrology},
volume = {677},
pages = {135858},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135858},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009558},
author = {Xiao-long Wu and Kent Novakowski and Bernard H. Kueper},
keywords = {Preferential flow, Scale effect, Shear displacement, Surface roughness, Fracture closure},
abstract = {Preferential flow channels with low hydraulic resistance in a single fracture can transmit large fluid volumes in fractured rock. Characterizing these channels and the associated flow channeling at the field scale, however, remains challenging. In this study, a hybrid iterative computational workflow was used to generate a field-scale (30 m diameter) synthetic fracture with self-affine surfaces and a high-resolution (2 mm spatial resolution) aperture field. We investigate the effects of anisotropic surface roughness, shearing displacement, and closure ratio on flow channeling in a radial flow system using advective Lagrangian particle tracking and advection–dispersion numerical simulations. Results show a transition from local microscale channeling effects to a homogenous flow pattern at the field-scale within rough-walled fractures. The transition is enhanced by the increasing microscale channels which occur via surface roughness anisotropy. Surface shearing displacement and anisotropic surface roughness control the fracture closure area and principal orientations, aligning with the tortuosity and direction of preferential flow pathways. The solute peak arrival times in synthetic fractures are similar to those in smooth fractures with an equivalent Cubic Law aperture. This demonstrates the applicability of the Cubic Law aperture in predicting bulk arrival times, even in the presence of flow channeling within sheared synthetic fractures. The strong flow channeling behavior observed in some field studies is therefore likely related to local geological conditions (stress included) and post-fracturing processes, underscoring the need to integrate initial fracturing and subsequent weathering history obtained using rock sample properties and outcrop analysis when investigating channeling effects.}
}
@article{XIONG2026135789,
title = {An integrated framework for identifying throughfall spatiotemporal patterns: revealing dry zones as potential markers of pattern persistence},
journal = {Journal of Hydrology},
volume = {677},
pages = {135789},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135789},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008863},
author = {Feng Xiong and Chuan Yuan and Yafeng Zhang and Yanting Hu and Zhiyun Jiang and Kazuki Nanko and Qin Liu and Sheng Wang and Yaoyan Li and Delphis F. Levia},
keywords = {Throughfall, Temporal stability, Shrub, Rank-based, Machine learning},
abstract = {Throughfall temporal stability is critical for maintaining spatial consistency in soil water amount and nutrient inputs, serving as a fundamental pillar for the structural and functional stability of vegetated ecosystems. However, traditional time stability plots rely on subjective visual interpretation. Quantitative alternatives like the relative difference and Spearman rank correlation coefficient methods fail to differentiate the specific contributions of distinct throughfall regimes (dry vs. wet zones) to overall stability. This study developed an integrated framework coupling Gaussian Mixture Model (GMM) with geostatistical analysis and statistical metrics, including the coefficient of variation in ranks (CVr) and global Moran’s I. Validated using field data from two dominant shrubs (Caragana korshinskii Kom. and Salix psammophila C. Wang & C. Y. Yang) in the semi-arid Loess Plateau of China, this framework accurately quantified species-specific throughfall spatiotemporal patterns: S. psammophila exhibited greater spatial heterogeneity and temporal stability along direction and distance gradients. Spatial autocorrelation examination via Moran’s I confirmed significant clustering in throughfall distribution (p < 0.05). GMM-identified dry zones, receiving significantly less throughfall (65.0% vs. 77.1%, p < 0.001), maintained higher stability evidenced by smaller CVr (23.4% vs. 68.5%, p < 0.01). They functioned as potential markers for the persistence of overall throughfall patterns, distinct from wet zones acting as biogeochemical hotspots. Therefore, this framework provides a mechanistic tool to decipher throughfall spatiotemporal pattern, enhancing the predictability of throughfall fluxes and offering new insights into ecosystem stability particularly in water-limited environments.}
}
@article{XIONG2026135761,
title = {Hydro-mechanical coupling between pore pressure and crustal deformation following earthquakes: insights from groundwater tidal response and InSAR analysis},
journal = {Journal of Hydrology},
volume = {677},
pages = {135761},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135761},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008589},
author = {Luoyao Xiong and Guanru He and Zheming Shi and Guangcai Wang and Zhiyu Qi and Peng Ye and Guoying Li},
keywords = {Groundwater, Earthquakes, InSAR, Permeability, Hydro-mechanical coupling},
abstract = {Hydro-mechanical coupling in the shallow crust affects a suite of geological processes such as tectonism, seismicity, deposition and erosion dynamics. However, direct field observations that illustrate the coupling between the pore pressure and crustal deformation remain scarce. Here, we combine Interferometric Synthetic Aperture Radar (InSAR) and groundwater tidal response analysis to quantify the co-seismic and post-seismic impacts of the 2022 Luding (Ms 6.8) and Menyuan (Ms 6.9) earthquakes on crustal permeability, vertical displacement patterns, and groundwater-level fluctuations. The results show that the temporal trend of crustal permeability shifts from progressive enhancement to gradual attenuation following earthquake, together with a transition from surface uplift to subsidence in wells proximal to the active fault and the epicenter. Furthermore, the observed co-seismic groundwater-level steps are generally consistent with the modeled static strain field, showing rises in compressional zones and declines in extensional zones for most wells (e.g., MY, SMC20, SMC49), although exceptions exist (e.g., well ZS). The cross-correlation analyzes revealed strengthened correlations between permeability evolution and vertical displacement during the post-seismic phase compared to pre-seismic phase, indicating substantial reorganization of subsurface fault architectures and fluid pathways induced by seismic strain. Our results from five monitoring wells provide site-specific observations of the transient relationships between subsurface fluid dynamics and surface deformation during hydro-mechanical perturbations in active tectonic regions.}
}
@article{ZHANG2026135829,
title = {Using stable isotopes in water vapor to identify the onset date of the East Asian summer monsoon over the Loess Plateau},
journal = {Journal of Hydrology},
volume = {677},
pages = {135829},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135829},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009261},
author = {Yujiao Zhang and Yudong Shi and Shengjie Wang and Hayoung Bong and Kei Yoshimura and Shijun Lei and Meng Xing and Yinmei Yang and Jianwen Zhao and Mingjun Zhang},
keywords = {East Asian summer monsoon, Stable isotopes, Water vapor, Loess Plateau},
abstract = {The East Asian summer monsoon (EASM) is a key atmospheric circulation system that regulates the hydroclimatic patterns and ecological processes of the Loess Plateau. Its onset date has important implications for the seasonal distribution of regional precipitation, water resource allocation, and land–atmosphere interactions. In this study, we developed a quantitative framework for identifying monsoon onset based on the daily time series of water vapor δ18O. Using observed water vapor isotope records from Lanzhou and Xi’an across the Loess Plateau, we determined a robust onset signal characterized by a maximum in δ18O followed by sustained isotopic depletion. After applying a 10-day Fourier low-pass smoothing, objective criteria with a cumulative decrease of at least 2‰ were established to identify the monsoon onset date. This framework was further applied to long-term daily isotope simulations of IsoGSM4 to reconstruct the interannual variability of EASM onset over the Loess Plateau. The results show that the summer monsoon typically reaches the Loess Plateau in June and exhibits a stable southeast-to-northwest propagation pattern. On average, monsoon onset occurs in Xi’an in early June, whereas Lanzhou lags by approximately 15–20 days. The inter-annual variability of monsoon onset date is consistent with recent evidence for a northward shift of the East Asian rain belt. This isotope-based framework provides a robust quantitative indicator for identifying EASM onset across the Loess Plateau, and helps in understanding the long-term hydrological changes in the monsoon marginal regions.}
}
@article{QIANG2026135821,
title = {Decoupling of evapotranspiration from atmospheric demand: mechanistic insights into the local evaporation paradox in arid shrublands via physical and physiological resistance thresholds},
journal = {Journal of Hydrology},
volume = {677},
pages = {135821},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135821},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009182},
author = {Yuquan Qiang and Mingjun Zhang and Yu Zhang and Shengjie Wang and Xianying Xu and Jinchun Zhang and Guiquan Fu and Zhilan Wang and Meilin Sun and Peng Zhao and Shiquan Liu},
keywords = {Evapotranspiration partitioning, Shuttleworth-Wallace model, , Stomatal resistance, Arid region},
abstract = {Accurate quantification of hydrological fluxes in arid ecosystems is fundamental for modeling regional water cycle dynamics under progressive global aridification. Modeling these fluxes is complicated by the ’evaporation paradox,’ a hydro-meteorological anomaly where actual evapotranspiration (ET) stagnates or declines despite rising atmospheric evaporative demand. Existing land surface models often lack the capacity to resolve the complex, nonlinear interactions between sparse vegetation canopies and soil water deficits. To address these structural limitations, we propose a Physiologically Constrained Shuttleworth-Wallace (PC-SW) two-source model tailored for temperate desert shrublands (Haloxylon ammodendron). The model integrates three physical modifications: (1) A piecewise linear soil resistance function was formulated to account for the disruption of liquid water continuity in shallow soil layers during desiccation, capturing the abrupt ’two-stage switching’ effect triggered by dry surface layer (DSL) formation. (2) A hydraulic-stomatal regulation module, incorporating deep root zone moisture signals and Leaf Area Index (LAI) thresholds, was established to quantitatively characterize plant “physiological dormancy” under extreme drought. (3) A clumping index correction based on geometric optics was applied to rectify radiative transfer errors associated with patchy shrub canopies. Model performance was evaluated using high-frequency eddy covariance and sap flow data collected across two growing seasons (2023–2024) in the Minqin Oasis-Desert Transition Zone, China. Results indicate that the PC-SW model mitigates the systematic overestimation of soil evaporation inherent in the standard S-W model (reducing bias by ∼ 45%) and achieves high simulation accuracy (R2 > 0.90). Hydrological flux partitioning indicated that plant transpiration serves as the primary pathway for ecosystem water loss—contributing over 96% during the peak growing season—and is sustained largely by deep soil water reservoirs (40–300 cm). This analysis explicitly identifies the localized thermodynamic feedbacks driving the evaporation paradox. While the concept of “functional decoupling” induced by high surface resistance is recognized in ecohydrology, this study advances its predictive modeling by mathematically formalizing the specific physical and physiological thresholds that trigger this process. By incorporating a piecewise linear soil resistance model and an explicit dormancy threshold, the PC-SW model better captures the abrupt restriction of actual ET under severe water limitation. Consequently, excess radiant energy is preferentially partitioned into sensible heat, providing a mechanistic, threshold-driven explanation for the local evaporation paradox.}
}
@article{ZHANG2026135748,
title = {Integrating multiple graph features in graph neural networks for water level prediction},
journal = {Journal of Hydrology},
volume = {677},
pages = {135748},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135748},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008450},
author = {Ruojing Zhang and Sen Ju and Zhengli Yao},
keywords = {Water level prediction, Graph neural networks, Graph structure construction, Chebyshev graph convolution, Multi-graph feature fusion},
abstract = {Accurate and rapid water level prediction plays an important role in water resource management and flood prevention. Existing studies usually rely on the geographical location of hydrological stations for modelling, while this single spatial perspective may not adequately reflect the complexity and diversity of water level changes. On this basis, similarity relationship among hydrological time series can provide richer spatial and temporal information. This study proposes a GNN framework called Fused Multi-Graph Temporal Graph Neural Network (FMG-TGNN), which captures spatio-temporal dependencies by constructing multiple graph structures and integrating them to enhance the accuracy of water level prediction. Specifically, three distinct graph structures are constructed based on the hydrological linkage, the Pearson correlation coefficient, and the Dynamic Time Warping (DTW). Chebyshev graph convolution (ChebConv) is then applied to each of these structures to extract features. These extracted features are subsequently fused through a learnable weighted summation and then concatenated with the raw data and fed into the GRU layer. This process enables effective capture and integration of spatiotemporal dependencies. The proposed framework is evaluated using data from 13 hydrological monitoring stations in Changzhou. The experimental results show that the framework performs well in both single-step and multi-step short-term water level forecasting, validating its effectiveness in improving the accuracy of water level prediction.}
}
@article{ZHANG2026135772,
title = {A probabilistic modeling framework for data-driven forecasting of rainfall-induced debris flows},
journal = {Journal of Hydrology},
volume = {677},
pages = {135772},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135772},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008693},
author = {Siling Zhang and Xiaojun Guo and Yong Li and Jianyi Cheng},
keywords = {Debris flow, Probabilistic forecasting, Bayesian inference, Rainfall parameter, Triggering threshold},
abstract = {Debris flow is often forecast based on relationships between rainfall parameters and debris flow occurrences. The traditional forecasting methods often face the challenges of overreliance on monitored data, high false alarms, and missed detections. This work proposes a probabilistic modeling framework to address such limitations. (1) The Copula method is applied to expand the limited original dataset. (2) A Mixture Model is used to group the data corresponding to the triggering mechanisms, enhancing the physical interpretability; and (3) Triggering thresholds are integrated with Bayesian inference to improve the model’s stability and predictive accuracy. The framework was constructed based on monitoring data of rainfall and debris flow in a small catchment between 2006 and 2023. Compared to conventional binary forecasting models, the proposed model demonstrates superior forecasting precision, particularly under conditions of low-precision input data. It also represents a shift from binary classification to probabilistic forecasting,enabling estimation of the occurrence probability for any given rainfall event. This improvement enhances flexibility and applicability in practical early warning of debris flows.}
}
@article{CAI2026135809,
title = {Disentangling the influence of precipitation on nitrogen loss in the Pearl River Basin},
journal = {Journal of Hydrology},
volume = {677},
pages = {135809},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135809},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009066},
author = {Xitian Cai and Xiaolu Wu and Haijun Huang and Xuezhi Tan and Zhen Li and Latifah Munirah Kamarudin and Nasir Abbas and Syed Asim Hussain and Li Dan},
keywords = {Precipitation dynamics, Noah-MP-CN, Nitrogen loss, Pearl River Basin, Nonlinear response},
abstract = {Nitrogen loss from terrestrial ecosystems is vital to water quality regulation and ecosystem stability. Understanding its response to precipitation variability is crucial for effective watershed management under climate change. Using nitrogen loss in the Pearl River Basin as a case study, this work advances a novel approach to water quality assessment by applying a state-of-the-art land surface model, Noah-MP-CN, to simulate nitrogen loss under varying precipitation regimes. Results show a strong linear relationship between annual precipitation and nitrogen loss (R2 > 0.7), indicating that long-term hydrological conditions dominate baseline nitrogen export. Extreme rainfall events induce sharp nitrogen fluxes that closely coincide with rainfall peaks and typically account for less than 20% of annual nitrogen loss, serving as important short-term amplifiers. Moreover, precipitation intensity exhibits a nonlinear and time-dependent effect: short-term (7-days) changes have limited impact due to watershed buffering, while sustained increases over longer periods (21 days) significantly enhance nitrogen loss by promoting runoff and nitrogen mobilization. Spatially, higher risks are observed in agricultural areas of the mid- to lower basin. These findings underscore the need to consider both the magnitude and temporal characteristics of precipitation—including intensity and duration—when assessing nitrogen export risks, and to integrate these dynamics into adaptive watershed-scale strategies for water quality protection under future climate extremes.}
}
@article{EBTEHAJ2026135784,
title = {Process-informed feature engineering for explainable optimization-driven AI in groundwater-level prediction},
journal = {Journal of Hydrology},
volume = {677},
pages = {135784},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135784},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008814},
author = {Isa Ebtehaj and Amani Aissi and Afshin Amiri and Hossein Bonakdari and Silvio José Gumiere},
keywords = {Bayesian optimization, Extreme gradient boosting (XGBoost), Feature engineering, Groundwater-level modeling, SHAP analysis, Sustainable water management},
abstract = {Accurate prediction of groundwater levels is crucial for sustainable water management, yet most machine-learning approaches remain black boxes that overlook delayed recharge and cumulative hydroclimatic effects. To address this gap, this study developed an explainable, optimization-driven artificial intelligence framework integrating Bayesian optimization with XGBoost to capture temporal dependencies and identify dominant hydroclimatic controls in the Bécancour River Basin, Québec, Canada. The framework combines automatic hyperparameter tuning with process-informed feature engineering, incorporating lagged discharge, temperature, precipitation, and rolling and antecedent indices representing cumulative hydrological effects. A 12-year daily hydro-meteorological dataset (2010–2022) was used to evaluate model performance across monitoring wells. The baseline BOXGBoost model captured overall groundwater dynamics but exhibited spatial inconsistencies in upland regions, whereas process-informed features produced consistent improvements across wells. Process-informed engineered features markedly improved performance, achieving mean Nash–Sutcliffe efficiency (NSE) and coefficient of determination (R2) values of ∼ 0.92 and a Kling–Gupta efficiency (KGE) of ∼ 0.90, and reduced Root Mean Square Error (RMSE) and Mean Absolute Error (MAE) to ∼ 0.14 m and ∼ 0.10 m, respectively. Relative to the baseline model, the enhanced framework increased NSE and R2 by about 81%, improved KGE by 53%, and reduced RMSE and MAE by about 56%. To further assess robustness, a temporally ordered validation (train-on-past/test-on-future) was conducted, confirming that the model maintains strong predictive performance under realistic forecasting conditions with only a limited impact on performance. SHAP-based analysis revealed that lagged features alone account for 46.46% of the total contribution, followed by rolling statistics at 23.30%, with water temperature (17.8%) and discharge at key stations (10.5% and 9.9%) among the most influential individual predictors. Together, lag and rolling features account for nearly 70% of the predictive importance, confirming the dominance of delayed recharge and cumulative hydrological responses. The BOXGBoost framework delivers accurate and interpretable groundwater-level predictions and supports groundwater monitoring, drought forecasting, and sustainable water management under variable hydroclimatic conditions.}
}
@article{ANSARI2026135787,
title = {Geodetic evidence of water mass loss from global navigation satellite system measured land uplift in Türkiye},
journal = {Journal of Hydrology},
volume = {677},
pages = {135787},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135787},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600884X},
author = {Kutubuddin Ansari and Emine Tanır Kayıkçı},
keywords = {Terrestrial water storage, GRACE, GLDAS, GLWS, Singular Spectrum Analysis, Vertical land motion},
abstract = {This study quantifies terrestrial water storage (TWS) variations in Türkiye (2009–2024) using vertical land motion derived from a dense Global Navigation Satellite System (GNSS) network. Singular Spectrum Analysis (SSA) was applied to separate long-term deformation from seasonal oscillations in GNSS height time series, and elastic loading inversion was performed to convert vertical displacement into monthly equivalent water height (EWH) estimates. The resulting monthly GNSS-based TWS estimates were validated with Global Land Water Storage (GLWS), Global Land Data Assimilation (GLDAS)-Noah and Gravity Recovery and Climate Experiment (GRACE) products. Results reveal pronounced TWS depletion-induced uplift across Southeastern Türkiye and Central Anatolia, reflecting groundwater stress in agricultural basins, while coastal and northern regions show positive water anomalies controlled by precipitation and snowmelt recharge. Seasonal amplitudes peak over the Black Sea and western regions, with phase shifts showing earlier TWS maxima in eastern snow-fed basins. Although GNSS-derived amplitudes are lower due to the sparse network and inversion smoothing, strong seasonal coherence with GRACE, GLDAS, and GLWS confirms the robustness of the approach. Overall, this work provides the first GNSS-based hydro-geodetic assessment of TWS over Türkiye and demonstrates GNSS as a complementary tool for drought monitoring and climate-driven water-storage evaluation.}
}
@article{CHERAMPATTAMANA2026135776,
title = {Fire can explain rainfall-runoff shifts during and after drought},
journal = {Journal of Hydrology},
volume = {677},
pages = {135776},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135776},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008735},
author = {Sreelakshmi {Cherampatta Mana} and Tim J. Peterson and Barry Croke and Takuya Iwanaga and Steven J. Lade},
abstract = {State shifts in rainfall-runoff relationships, driven by disturbances such as droughts and bushfires, can persist long after the disturbance, resulting in reduced streamflow per unit rainfall. However, droughts and fires are highly correlated, and fires can also affect runoff patterns. In this study, we investigated the joint influence of fires and prolonged drought on rainfall-runoff relationships in the Australian Capital Territory (ACT) and neighbouring Queanbeyan catchments. State shifts in rainfall-runoff relationships were detected using Hidden Markov Modelling (HMM) of runoff, incorporating Kuczera fire parameters that characterise the duration and magnitude of streamflow reduction following fire. Hidden Markov Models avoid the need for a priori definition of drought periods and provide a flexible framework to identify the state changes in the rainfall-runoff relationship. We found that: (1) Fire can explain apparent state shifts in rainfall-runoff relationships during and after drought. Based on previous literature, we hypothesised the existence of multiple hydrological states in the western forested region, however the inclusion of fire as a factor removed most of the two-state behaviour (3 of 6 gauges); (2) State shifts, in this study, were more common in non-urban non-forested catchments (4 gauges) rather than the forested ones (1 of 7 gauges), contrary to expectation; (3) Moreover, almost all gauges (13 of 16) did not display a long-term rainfall-runoff state shift following drought, suggesting that the study catchments are resilient to drought. The catchments exhibited recovery behaviour even when fire events that occurred amid prolonged drought were considered for the analysis. These findings underscore the importance of integrating both fire and drought in hydrological modelling to better understand their combined effects on catchment behaviour.}
}
@article{LIU2026135687,
title = {Explainable physics-informed Bayesian graph neural networks (PI-BSTGNN) for groundwater surrogate modeling and sensitivity analysis},
journal = {Journal of Hydrology},
volume = {677},
pages = {135687},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135687},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007845},
author = {Fan Liu and Zhao Guo and Futian Ren and Hassina Mouri and Danbing Mei and Zhengzheng Zhang and Xiaowei Lu and Lei Huang},
keywords = {Heterogeneous aquifer systems, PI-BSTGNN, Bayesian uncertainty quantification, Out-of-distribution generalization, Explainable AI analysis},
abstract = {Groundwater contamination from industrial and agricultural sources threatens sustainable development. To bridge the gap between expensive mechanistic models and physics-agnostic data-driven methods, we propose PI-BSTGNN, a Physics-Informed Bayesian Spatio-Temporal Graph Neural Network. Using MODFLOW6 to generate 100 stochastic realizations of a 3D heterogeneous aquifer system, we embed hydrodynamic constraints (mass conservation, Dirichlet boundaries) directly into the loss function. Evaluated on a 3D random-field heterogeneity case, the framework achieves a head RMSE of 3.61 m (R2 = 0.896) and a concentration RMSE of 1.02 mg/L (R2 = 0.864). Out-of-Distribution (OOD) tests reveal that the physics-informed anchor maintains a head R2 of 0.663, while standard CNN and RF models diverge catastrophically (R2 < 0). Furthermore, two-stage training proved essential for concentration accuracy, preventing error propagation from velocity fields. SHAP analysis reveals that aquifer geometry and river boundaries are dominant drivers. These results demonstrate that PI-BSTGNN provides a scalable, physically consistent, and uncertainty-aware surrogate for sustainable groundwater management.}
}
@article{ZHANG2026135800,
title = {Dynamic changes of dissolved organic matter chemical properties and compositions with salinity gradients in saline and hypersaline lakes in the Qiangtang Plateau},
journal = {Journal of Hydrology},
volume = {677},
pages = {135800},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135800},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008978},
author = {Yaoling Zhang and Xin Liu and Hongmei Chen and Qingkuan Li and Haitao Feng and Hao Wang and Jiaqi Chen and Wu Li and Keli Yang},
keywords = {Dissolved organic matter (DOM), Saline and hypersaline lake, The Tibetan Plateau (TP), The Qiangtang Plateau (QP), EEMs, FT-ICR-MS},
abstract = {Lakes distributed in the Tibetan Plateau (TP) vary greatly in salinities and are undergoing rapid changes of hydrologic features and allochthonous input under the influence of climate change. However, how these changes will impact the biogeochemical cycle of natural dissolved organic matter (DOM) in the TP lakes, especially saline and hypersaline lakes with different salinities remains unclear. In this study, DOM obtained from forty-five saline and hypersaline lakes and two freshwater lakes in the Qiangtang Plateau of the TP were investigated to evaluate links between DOM compositions and salinity variations. Spectral characteristics and molecular compositions of DOM were analyzed by ultraviolet–visible absorbance (UV–Vis), fluorescence excitation-emission matrices (EEMs), and ultrahigh-resolution Fourier transform ion cyclotron resonance mass spectrometry (FT-ICR-MS). Results showed a dominant microbial and autochthonous source of DOM in most of the saline and hypersaline lakes. Along the salinity gradient, lacustrine DOM concentrations increased, whereas average molecular weight decreased and autochthonous characteristics became more pronounced. In addition, higher salinity was associated with a greater proportion of heteroatom-containing molecules, especially sulfur-containing compounds. These salinity-related changes in lacustrine DOM likely result from the combined effects of evapoconcentration, photodegradation, microbial processing, and flocculation. This study highlights how salinity and environmental factors may influence the quantity and chemical properties of DOM and thus to better understand the transformation and cycling of DOM with varying salinities in the TP lakes under the context of global climate warming.}
}
@article{CHAO2026135764,
title = {A two-stage data fusion framework for multi-source precipitation estimates integrating gauge, radar, and satellite observations via deep learning and Bayesian model averaging},
journal = {Journal of Hydrology},
volume = {677},
pages = {135764},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135764},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008619},
author = {Lijun Chao and Tingting Hou and Sheng Wang and Zhixin He and Ke Zhang and Guoqing Wang},
abstract = {Reliable precipitation estimation over complex terrain requires the integration of complementary information from rain gauges, weather radar, and satellite products. Effective data fusion remains challenging due to scale inconsistencies, spatial heterogeneity, and source-dependent uncertainties. We propose a transparent two-stage deep-learning–Bayesian multi-source precipitation fusion framework (DBMPF) integrating spatiotemporal deep-learning (DL) correction with probabilistic ensemble calibration. The first stage employs a hybrid 3-dimensional convolutional neural network (3D-CNN) and convolutional long short-term memory (ConvLSTM) architecture to extract station-centered spatiotemporal features from multi-source data cubes and to produce corrected member ensemble members corresponding to different source combinations. The second stage applies Bayesian model averaging (BMA) to merge these members into a calibrated predictive distribution through the expectation–maximization (EM) algorithm. A Box-Cox transformation is introduced to better satisfy Gaussian residual assumptions, facilitating uncertainty quantification through prediction intervals and probabilistic evaluation metrics. The DBMPF framework is assessed in the Tunxi River basin (Anhui, China) during May–September, trained on 2019–2020, and validated in 2022 for validation at daily, hourly, and half-hourly temporal resolutions. Across all scales, DBMPF surpasses both the source products and benchmark approaches. At the daily scale, the correlation coefficient (CC) increases from 0.942 for radar to 0.994,root mean square error (RMSE) decreases from 5.231 to 1.685 mm/day, and Kling-Gupta efficiency (KGE) rises from 0.750 to 0.972, accompanied by negligible bias. At sub-daily resolutions, improvements are observed in event detection performance as measured by critical success index (CSI) and false alarm ratio (FAR), and the framework achieves superior probabilistic performance for 95% prediction intervals, attaining the lowest continuous ranked probability score (CRPS), PICP values closest to the nominal 0.95 level, and the smallest absolute coverage error (ACE) across precipitation intensity categories while maintaining relatively narrow mean prediction interval width (MPIW). A progressive gauge-density experiment involving 18–45 stations reveals substantial performance gains under sparse observational networks and diminishing returns at moderate to high densities, offering guidance for cost-efficient network configuration. The proposed DBMPF framework provides a modular approach for generating high-resolution deterministic and probabilistic precipitation estimates, with particular potential for flood-focused hydrological applications requiring uncertainty-aware precipitation inputs.}
}
@article{RULFF2026135542,
title = {Computational electromagnetic geophysics for groundwater system studies: A review of established practices and recent advances},
journal = {Journal of Hydrology},
volume = {677},
pages = {135542},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135542},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006396},
author = {Paula Rulff and Octavio Castillo-Reyes and Wouter Deleersnyder and Maria {Carrizo Mascarell} and Burke J. Minsley and Jude King},
keywords = {Electromagnetic geophysics, Groundwater, Computational methods},
abstract = {Identifying effective solutions for locating groundwater resources and ensuring the quality of drinking water is increasingly urgent, given the challenges posed by climate change and population growth. This review investigates electromagnetic geophysical imaging techniques, in both time- and frequency-domain, that can provide valuable insights for groundwater assessment. We explore computational electromagnetic methods used to evaluate electromagnetic data and several recent hydrogeophysical case studies. As open-source frameworks for modeling electromagnetic geophysical problems become available, a broader range of researchers can interpret their data with computationally advanced software. We provide an overview of documented open-source codes for evaluating electromagnetic data and analyze various hydrological targets in relation to their electromagnetic surveying technique and the computational method applied. Furthermore, we evaluate the potential of advanced computational techniques, including three-dimensional modeling, non-deterministic inversion and machine learning, to couple geophysical with numerical groundwater modeling and apply it in groundwater system studies. Despite obstacles such as complexity and resource demands, our findings indicate that the quantification and integration of predictive uncertainties from both electromagnetic and hydrological data and simulations would significantly improve the reliability of hydrogeophysical models. This can lead to a deeper understanding of groundwater systems and improved management practices.}
}
@article{MENG2026135828,
title = {Investigation of sediment incipient velocity in ice-covered flow under slope effects and dual riverbed roughness boundary conditions},
journal = {Journal of Hydrology},
volume = {677},
pages = {135828},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135828},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600925X},
author = {Shaomin Meng and Xiaomin Liu and Tingxi Liu and Anjun Deng and Hai Huang},
keywords = {Ice-covered flow, Incipient velocity, Riverbed slope, Ratio of dual riverbed roughness coefficients, Ice cover influence factor},
abstract = {The formation of ice covers over rivers in cold regions can substantially change hydraulic boundary conditions and the dynamic structure of river flows, thereby affecting sediment erosion and deposition processes and escalating the risk of ice flooding. Conventional open-channel flow theory has notable limitations in forecasting sediment incipient motion under ice cover, especially with respect to slope effects. Using theoretical analysis, model development and slope-varying flume experiments, this study systematically examines the incipient velocity laws for non-uniform sediment, accounting for slope effects under ice cover and dual riverbed roughness boundary conditions. It establishes a probabilistic model of sediment incipient motion that integrates slope and the relative exposure randomness of particles. In addition, this research proposes a mid-perpendicular average flow velocity formula applicable to both open-channel and ice-covered flow conditions. The root-mean-square errors of the model and the formula were 0.01973 m/s and 0.01279 m/s, respectively, further demonstrating good predictive accuracy. The experiments revealed a distinctive phenomenon – incipient motion at a low Froude number – in ice-covered flow, driven by enhanced bed shear stress and the increased energy efficiency at the riverbed surface, which collectively reduce the macroscopic hydrodynamic force required for incipient motion. The dominant effect of the ratio of dual riverbed roughness coefficients (ni/nc) was further quantified by defining the ice cover influence factor (ICIF). Notably, ICIF intensified significantly with increasing ni/nc. In addition, fine sediments were more sensitive to variations in ni/nc. The parameter sensitivity analysis demonstrated that particle size exerted the greatest influence on incipient velocity, followed by slope and ice cover roughness. Among these factors, particle size was the absolutely dominant variable. This study delves into the mechanism of sediment incipient motion in ice-covered flows and provides theoretical support for predicting sediment transport and regulating ice floods in frozen rivers.}
}
@article{YANG2026135825,
title = {Laboratory investigation of anchor ice evolution under steady and varying heat fluxes},
journal = {Journal of Hydrology},
volume = {677},
pages = {135825},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135825},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009224},
author = {Jiaqi Yang and Yuntong She and Mark Loewen},
keywords = {Anchor ice evolution, Growth stages, Growth rate, Net heat flux, Heat variation, Second principal supercooling},
abstract = {Anchor ice formation, growth, and release in rivers impact flooding risk, sediment transport, and aquatic habitats in winter. The heat flux is known to significantly affect the growth of anchor ice, but there have been no studies on how the anchor ice growth rate is affected by variations in the heat flux. This study investigated anchor ice evolution under steady and varying heat flux conditions in the laboratory. Anchor ice images were captured using a high-resolution camera, and air and water temperatures measurements were collected. Four steady cases with constant heat flux and six varying heat flux cases, in which the heat flux was increased by either decreasing the air temperature or applying wind at three different times during a supercooling event, were examined. Results showed that anchor ice growth during steady heat flux cases experienced initial, transitional, and final growth stages in sequence. An additional heat change stage, which was defined as the time period of increased anchor ice growth following an increase in heat flux, always occurred prior to the final stage in varying heat flux cases. The anchor ice growth rate (i.e., the rate of change of anchor ice thickness) during the heat change stage was 150% and 80% larger on average compared to the transitional and final stages, respectively. The peak anchor ice growth rate reached an upper limit of ∼9 cm/h when the heat flux exceeded ∼300 W/m2, and the growth rate during the transitional and final stages increased approximately linearly with the heat flux.}
}
@article{ALONGI2026135780,
title = {Refining image-based approaches for river monitoring: a focus on graphical enhancement and software parameter sensitivity},
journal = {Journal of Hydrology},
volume = {677},
pages = {135780},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135780},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008772},
author = {Francesco Alongi and Robert Ljubičić and Silvano Fortunato {Dal Sasso} and Leonardo Valerio Noto},
keywords = {LSPIV, Surface velocity estimation, Graphical enhancement filters, Optical flow, PIVlab, SSIMS-flow, River monitoring},
abstract = {Image-based techniques for estimating river surface velocity include traditional Large-Scale Particle Image Velocimetry (LSPIV), which infers tracer displacement by computing cross-correlation between pairs of consecutive frames, and optical flow approaches, which derive motion from image intensity gradients. Their accuracy strongly depends on image quality and processing configurations. However, the influence of enhancement techniques and parameter settings on large-scale velocimetry has not yet been systematically explored, due to complex interactions between field conditions, enhancement methods, and software-specific options. As a result, most studies still rely on authors’ experience and the processing tools available in the selected software. This study presents a sensitivity analysis evaluating the impact of different combinations of graphical enhancement filters and software parameterizations under varying environmental conditions. Image-based measurements were performed in two case studies in Sicily (Italy): the Oreto and Platani rivers. Acquired videos were pre-processed applying enhancement filters and multiple parameter configurations were tested. Analyses were performed using PIVlab and SSIMS-Flow, each tested with distinct processing setups. Overall, 1296 surface velocity fields were derived and compared to ADCP reference data. Water clarity and background complexity were objectively quantified using the Normalized Difference Turbidity Index (NDTI). Results demonstrate that both filter selection and software settings significantly influence image velocimetry accuracy. PIVlab, relying on cross-correlation, showed greater robustness in visually complex scenarios, while SSIMS-Flow, based on intensity gradients, achieved higher accuracy in uniform and turbid conditions. Poor performance generally corresponded to unsuitable filter-parameter combinations. Overall, the proposed framework helps refine image-based velocimetry workflows for more accurate field implementations.}
}
@article{LU2026135817,
title = {Asymmetric evolution of capturability of atmospheric water (CAW) across global arid and humid regions},
journal = {Journal of Hydrology},
volume = {677},
pages = {135817},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135817},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009145},
author = {Hou-Liang Lu and Hong-Ru Wang and Hui-Min Zuo and Han Zhou and Yu-Fei Jiao and Bill X. Hu},
keywords = {Capturability of atmospheric water, Potential evapotranspiration, Semi-arid region, Hydrological cycle, Climate change},
abstract = {Global warming has intensified water cycle processes, necessitating the study of atmospheric and terrestrial water dynamics across various arid-humid subregions under climate change. This work introduces the Capturability of Atmospheric Water (CAW) index, which measures the conversion of atmospheric to terrestrial water based on horizontal water vapor transport. We develop a conceptual framework to explore CAW evolution influenced by local and large-scale circulation factors. Our findings reveal significant spatial heterogeneity in CAW across different subregions. Specifically, CAW in semi-arid subregions (with precipitation of 200–600 mm yr−1) shows a marked increase during the cold season (November to March). Conversely, humid regions show a significant decrease in CAW, challenging the “dry gets drier, wet gets wetter” paradigm. Key hydrological variables in semi-arid regions, including precipitation, evaporation, and runoff, have increased, indicating an accelerated hydrological cycle over the past four decades. Our analysis reveals that local CAW changes are influenced by factors such as actual evapotranspiration, surface temperature, wind speed, and cloud cover. Notably, in about 80% (cold season) and 95% (warm season) of grids, there is a negative correlation between potential evapotranspiration and CAW, suggesting that increased atmospheric evapotranspiration capacity hinders the conversion of atmospheric water to precipitation. At a larger scale, CAW changes are influenced by large-scale circulation patterns, with equatorial Pacific Sea surface temperature anomalies playing a significant role in most of the semi-arid regions at low and middle latitudes. These findings have important implications for regional water resource management and climate adaptation strategies.}
}
@article{NIE2026135768,
title = {Revealing irregular sediment shape effects in bedload transport rate based on state probability correction},
journal = {Journal of Hydrology},
volume = {677},
pages = {135768},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135768},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008656},
author = {Yipin Nie and Xiekang Wang},
keywords = {Bedload transport rate, Irregular sediment, Initiation probability, State probability, Markov chain process},
abstract = {Sediment transport processes not only reshape river channel geomorphology but also directly influence the accuracy of flood routing and watershed ecological management. However, bedload transport calculations in traditional hydrological models are predominantly based on the assumption of ideal spherical particles, often neglecting the irregular shapes of sediment in natural channels. This simplification limits the models’ ability to interpret and predict sediment motion mechanisms under complex hydrodynamic conditions. Building upon existing theories of sediment motion state probability, this study modifies the classical computational framework by introducing the Corey shape factor (Sf). This modification employs Markov chain processes to quantify the transition probabilities of sediment particles between different motion states. It focuses on correcting physical parameters—specifically the effective frontal projected area, settling velocity, and drag coefficient—for irregular particles, thereby integrating microscopic shape effects into macroscopic transport rate calculations. Validation against approximately 1,650 experimental datasets covering a wide range of transport intensities (dimensionless sediment transport intensity Φ ranging from 10-4 to 103) demonstrates that the corrected method captures how sediment irregularity significantly enhances the capacity of particles to extract energy from the flow by increasing the drag coefficient and frontal projected area. Under specific flow intensities, the transport rates of irregular particles can be tens of times higher under specific flow intensities. Furthermore, applying this modified framework to the numerical simulation of a flood event in the Xiaoshi River reveals that, compared to traditional formulas, the corrected model more physically plausibly represents the riverbed surface armoring process and the dynamic adjustment of the longitudinal grain size distribution during the flood. This study confirms that explicitly correcting for sediment shape effects in numerical models holds critical hydrological significance for improving the reliability of riverbed evolution predictions under unsteady flow conditions, providing a more physically grounded computational basis for quantifying watershed sediment flux and for engineering design.}
}
@article{IM2026135813,
title = {Persistent performance of the power-function complementary relationship in Earth system models under a warming scenario},
journal = {Journal of Hydrology},
volume = {677},
pages = {135813},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135813},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009108},
author = {Seokwoo Im and Minha Choi and Daeha Kim},
keywords = {Terrestrial evapotranspiration, Complementary relationship, Power-function CR, Earth system models, Global warming},
abstract = {This study presents a systematic evaluation of the power-function complementary relationship (CR) for estimating global terrestrial evapotranspiration (E) under a high-emission warming scenario. Three parameterization strategies for the exponent b—the polynomial method (b = 2), the combined CR-Budyko framework, and the isenthalpic index approach—were applied independently to atmospheric forcing from eighteen Earth System Models (ESMs) participating in the Coupled Model Intercomparison Project Phase 6 (CMIP6) under the SSP5-8.5 pathway over 1980–2100. CR-based E was evaluated against ESM-simulated E at both the global and basin scales to assess the robustness of each parameterization approach across space and time. All three approaches demonstrated strong agreement with the reference E, maintaining basin-scale Nash–Sutcliffe efficiency > 0.88 and Pearson r > 0.95 throughout the study period, even under intensified warming. The polynomial method provided stable and globally neutral performance, with the smallest basin-scale bias across all periods. The CR-Budyko framework most closely reproduced tropical E during the historical period but exhibited growing overestimation under future warming. The isenthalpic index approach most faithfully tracked the global E anomaly trend and performed comparably to the polynomial method in warm and arid regions. The results suggest that the power-function CR provides a physically grounded, calibration-free framework for E assessment in CMIP6 ESMs under warming, while demonstrating that the choice of b parameterization strategy has meaningful implications for regional E estimation across diverse hydroclimatic regimes.}
}
@article{LIN2026135792,
title = {Quantifying heterogeneous hydrological interactions in complex river basins: an interpretable spatiotemporal deep learning approach},
journal = {Journal of Hydrology},
volume = {677},
pages = {135792},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135792},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008899},
author = {Jie Lin and Wei Ding and Huicheng Zhou and Jing Hu and Hao Wang},
keywords = {Spatiotemporal, Hydrological interactions, Interpretable deep learning, River basin, Graph convolutional network, Shapley additive explanations},
abstract = {Hydrological regimes in complex river basins are governed by heterogeneous hydrological interactions, including driver-to-response interactions induced by multi-source inflows and response-to-response interactions within basin-scale hydrological processes. These interactions are essential for guiding scientific river-basin regulation, while their systematic quantification remains challenging, constrained by computation-intensive modeling and scenario-limited analysis. To this end, this study develops an Interpretable Spatio-Temporal Hydrological Interaction Learning (InSTIL) framework, which combines LSTM-based temporal encoding, graph-based spatial propagating and Shapley Additive Explanations, to explicitly capture and quantify the hydrological interactions. Applied to the Three Gorges Reservoir (TGR) and Dongting Lake (DTL) system, InSTIL delivers robust simulations of lake water levels with an average RMSE of 0.425 m, consistently outperforming LSTM and GCN benchmarks, particularly under extreme conditions. Furthermore, interaction interpretation reveals that: (1) For driver-to-response interactions between rivers and the lake, their spatial patterns from different rivers are governed by inflow locations and runoff volumes, with TGR releases exerting the dominant influence (contributing 32.89%-48.58% across individual sites) and tributary Yuan River ranking second. Meanwhile, these interactions appear unimodal over time, showing the strongest daily impacts at 1–3 days before lake’s responses. Their multi-day cumulative effects inform an effective regulation window of 7–15 days. (2) For response-to-response interactions within the lake, the heterogeneous response timing and magnitude across DTL reveal the weak hydraulic connectivity in the south sub-lake and the presence of a cross-sublake hydraulic pathway. Overall, InSTIL provides a transferable paradigm for robust hydrological simulations and systematic interaction interpretation, offering practical insights for sustainable river-basin management.}
}
@article{SHI2026135760,
title = {N2O emissions and driving factors of coastal agricultural drainage ditches: implications for the nitrogen cycle},
journal = {Journal of Hydrology},
volume = {677},
pages = {135760},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135760},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008577},
author = {Zhenqi Shi and Xiang Liu and Dongli She and Alimu Abulaiti and Junhan Zhao and Yihua Huang},
keywords = {NO emission factor, Coastal agricultural ditches, Salinity, DOC:DIN, Dissolved NO concentration},
abstract = {Agricultural drainage ditches are important sources of nitrous oxide (N2O) emissions associated with non-point source pollution. In coastal agricultural ditches, shallow groundwater fluctuations and tidal intrusion cause persistent salinity variations, which may alter N2O production, emission fluxes, and emission efficiency. However, quantitative evidence linking salinity fluctuations to N2O emission patterns in coastal agro-ecosystems remains limited. In this study, a two-year field survey was conducted in coastal agricultural drainage ditch systems in Jiangsu Province, China, from 2023 to 2025. Physicochemical properties, dissolved N2O concentrations, indirect N2O fluxes, and N2O emission factors (EF5) were monitored across ditch networks with increasing salinity from inland ditches to estuarine outlets. Key environmental drivers were identified using statistical analyses and random forest modeling. N2O emissions showed clear seasonal variation, with higher values in spring and summer and lower values in autumn and winter, consistent with periods of intensive agricultural activity. Spatially, main and branch ditches acted as N2O emission hotspots, whereas estuarine sites showed the lowest emission levels. The mean EF5 was 0.0009, lower than the updated reference values for rivers (EF5r = 0.0026) and groundwater/surface drainage (EF5g = 0.0060), while the mean indirect N2O flux was high at 440.29 μg N m−2h−1, indicating low emission efficiency but strong emission intensity. Temperature, electrical conductivity (EC) and the DOC:DIN ratio were identified as key factors regulating N2O emissions. N2O emissions increased within the intermediate EC range observed in this study (391–1470 μS cm−1), but was suppressed when EC exceeded 1693 μS cm−1. These findings suggest that coastal agricultural drainage ditches may contribute substantially to regional greenhouse gas budgets despite low EF5 values, and that DOC:DIN can serve as a robust predictor for refining N2O emission-factor estimates across salinity gradients.}
}
@article{WU2026135805,
title = {Effective risks and dominant factors of drought-flood abrupt alternation events to global socio-ecological systems},
journal = {Journal of Hydrology},
volume = {677},
pages = {135805},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135805},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009029},
author = {Bohua Wu and Ziqi Yan and Denghua Yan and Yaping Cheng and Baisha Weng and Jianzhu Li},
keywords = {Drought-flood abrupt alternation, Risk assessment, Social system, Ecological system},
abstract = {Drought-flood abrupt alternation (DFAA) events are an important manifestation of instability in the global climate system and pose substantial risks to society and ecosystems. However, the risks that DFAA events impose on affected systems have not yet been systematically quantified at the global scale. Based on the three key components of hazard, exposure, and vulnerability, this study applies a multiplicative model to assess global DFAA risk, develops a “double-mean, double-threshold, and double-driver” analytical framework, quantifies the effective risks of DFAA events to social and ecological systems, and identifies their major influencing factors. The results showed that, although the global mean DFAA hazard increased slightly, regional differences are pronounced. The social system exhibited a pattern of increasing exposure and decreasing vulnerability, whereas the ecosystem showed simultaneous increases in both exposure and vulnerability. Although the spatial extent of flood-to-drought risk was smaller than that of drought-to-flood risk, it was more destructive in some regions. The overall centroid of social system risk shifted toward the southeast and southwest, whereas that of ecosystem risk shifted toward the northeast. The mechanisms driving risk also showed pronounced asymmetry, with socio-ecological system factors dominating during the drought-to-flood stage and climatic factors playing a leading role during the flood-to-drought stage. Overall, this study reveals the differences in DFAA risk and the asymmetric driving characteristics affecting social and ecological systems at the global scale, providing a scientific basis for risk warning, adaptive management, and sustainable development decision-making related to DFAA events.}
}
@article{VILORIAMARIMON2026135796,
title = {Performance-based assessment of tropical cyclone parametric precipitation models for flood simulation applications},
journal = {Journal of Hydrology},
volume = {677},
pages = {135796},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135796},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008930},
author = {Orlando M. Viloria-Marimón and Felix L. Santiago-Collazo and Matthew V. Bilskie and Avantika Gori and Thomas L. Mote},
keywords = {Parametric precipitation models, Hydrologic and hydraulic modeling, Tropical cyclones, Caribbean islands, Rainfall pattern},
abstract = {Tropical cyclone (TC) rainfall is one of the primary drivers of flooding in coastal watersheds; therefore, accurate rainfall estimation is essential for reliable hydrologic and hydraulic (H&H) modeling. In TC-prone regions like the Caribbean Islands, which are also topographically complex, the wide range of models available for estimating TC rainfall presents a challenge in identifying the most suitable Parametric Precipitation Models (PPMs) for flood modeling applications. Thus, this study proposes a dual-component framework for benchmarking PPM-derived rainfall: (i) a rainfall-level comparison of PPMs and (ii) a performance-based assessment of the rainfall fields produced by PPMs for flood simulations applications. The proposed framework was applied to a watershed in Puerto Rico and tested under three historical hurricanes using five PPMs and Stage IV radar-based rainfall as a benchmark. The rainfall-level analysis assessed precipitation accumulation distribution, patterns, and cumulative totals, while the performance-based assessment examined the impacts on riverine flow timing, peak discharge, and overland flood levels in the selected watershed. Results show that the Parametric Hurricane Rainfall Model (PHRaM) and its shear-excluded variant performed most consistently across all metrics. However, PPM-derived rainfall fields are unreliable for real-time forecasting in their current state. Importantly, simulated peak flows were more affected by the rainfall uncertainty than flood extents. Thus, this study highlights the need to select an appropriate tool for assessing flood risk, particularly in steep, complex terrain. Although PPMs are efficient in data-scarce regions, their inherent structural limitations must be carefully evaluated to ensure reliable flood hazard predictions.}
}
@article{KHEIRKHAH2026135852,
title = {Geochemical footprints of climate-driven increases in groundwater contributions in a Canadian Rocky mountain watershed},
journal = {Journal of Hydrology},
volume = {677},
pages = {135852},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135852},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009492},
author = {Sepideh Kheirkhah and Jianxun He and Brandi Newton and Jean Birks and Nadine Taube and M. Cathryn Ryan},
keywords = {Mountain hydrology, Climate change, Groundwater contribution, River geochemistry, Water–rock interaction, Concentration-discharge relationships, Causality analysis},
abstract = {Mountain watersheds are highly vulnerable to climate change, as rising temperatures and shifting precipitation patterns can alter streamflow sources and subsurface flow pathways. Such changes are often reflected in river geochemistry. This study examines changes in geogenic solutes and their relationship to climate change over the past few decades in the Sheep River, an Eastern Slope River of the Canadian Rockies. We integrated principal component analysis, concentration–discharge (C–Q) relationships, conductivity-based mass balance, mixing diagrams, trend analysis, and convergent cross mapping to characterize hydrogeochemical behavior, quantify groundwater and aquifer contributions, and evaluate hydrogeochemical changes and their potential climatic controls. Groundwater contributes ∼43–58% of mean annual discharge at Okotoks and ∼50–67% at Diamond Valley and sustains nearly all streamflow during the low-flow period. River chemistry is dominated by signals from carbonate aquifers (∼60–75%), with secondary contributions from siliciclastic aquifers. Over the past five decades, most geogenic solutes have increased significantly, and C–Q relationships indicate a shift toward more chemostatic behavior, despite no significant trend in streamflow. Causality analysis reveals both immediate and lagged effects of climatic variables on river chemistry, highlighting their roles in controlling groundwater recharge, subsurface storage, and consequently water–rock interactions. Together, these findings demonstrate a hydrogeochemical transition toward more persistent groundwater contributions to streamflow, and intensified water–rock interactions under a changing climate. This study underlines climate-driven hydrological changes mediated through groundwater, providing insight for adaptive water management in alpine and subalpine regions.}
}
