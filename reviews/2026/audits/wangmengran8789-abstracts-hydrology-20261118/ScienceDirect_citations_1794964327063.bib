@article{SINGH2026135240,
title = {Global shifts in rainfall drought relationship: weakening association in tropics},
journal = {Journal of Hydrology},
volume = {671},
pages = {135240},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135240},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003379},
author = {Gauranshi Raj Singh and C.T. Dhanya and Aniket Chakravorty},
keywords = {Hydrological connectivity, Wetland partitioning, Water level characteristic value, Cluster analysis, Zhalong Wetland},
abstract = {Climate change–driven warming has amplified the widespread impacts of droughts, causing severe socio-economic stress and resource insecurity, thereby highlighting the need for accurate quantification of drought intensity for timely and effective mitigation. Drought has been traditionally associated with rainfall deficit (below-normal precipitation), yet emerging evidence suggests that changes in distribution of precipitation spells (precipitation variability) may intensify drought risk. In this study, we examine global meteorological drought dynamics during 1951–2016 to assess whether the precipitation–drought linkage has changed. Further an attribution analysis to identify the dominant climatic drivers has also been conducted. Our results reveal that between 1951 and 2016, global drought frequency has increased up to six times, primarily due to changing climatic variables like rainfall deficit, evaporative losses, and rainfall variability. Predominant post the 1980 s, this trend is concentrated in the Tropical and Subtropical regions. Further, the traditional link between drought events and rainfall deficit has weakened, wherein drought likelihood during surplus rainfall years rose by 60 %. While total precipitation remained relatively stable, drought-prone hotspots experienced a 40 % increase in meteorological droughts, attributed to enhanced variability in precipitation distribution. This variability has led to significant drought events, with drought index values falling below −1. This impact is profound, in the Tropical zone, affecting diverse climates from monsoon regions to arid deserts. This pattern highlights how precipitation variability—more than mean rainfall deficit alone— drives tropical drought dynamics, reshaping our understanding of hydroclimate behavior and risk in Earth-system contexts.
Plain language summary
From 1951 to 2016, the number of drought episodes worldwide have increased up to six times. This increase was predominant after the 1980 s specially in the tropical and subtropical regions. Interestingly, we find that a nearabout 60 % increase is witnessed in drought events occurring during wetter-than-normal years. Thus, droughts are no longer explained only by reduced total rainfall. This shift signals that rainfall patterns are undergoing uneven distribution over time and space, specially over drought hotspots where drought frequency increased by 40 % with minimal change in rainfall magnitudes. These findings show that rainfall variability, rather than mean rainfall decline alone, is increasingly driving drought risk in the tropics. This can prove to be a vital contribution in modifying drought early-warning systems and water planning measures to better manage future drought impacts.
Key points:
1. Global drought frequency exhibits a sixfold increase since 1951, with hints of intensification over the Tropical zone. 2. The probability of occurrence of droughts, despite surplus rainfall, is on the rise in most parts of the global stretch. 3. Rainfall variability dictates the evolution of the Global Tropical droughts.}
}
@article{HE2026135292,
title = {Gaussian random field-based downscaling for drought projections: linking CMIP6 SSPs to local hydrology in a subtropical river basin},
journal = {Journal of Hydrology},
volume = {671},
pages = {135292},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135292},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003896},
author = {Sizhong He and Xiaosheng Qin and Zhenzhen Ma and Yicheng Wang},
keywords = {CMIP6, Downscaling, Gaussian random field, Climate change, Drought analysis},
abstract = {Faithful representation of spatial correlation structures in meteorological fields is critical for assessing climate impacts within river basins. This study develops a Gaussian random field (GRF)-based downscaling framework to translate coarse-resolution CMIP6 outputs into basin-scale meteorological fields. The GRF-downscaled projections are integrated with the distributed Xinanjiang model to simulate hydrological processes, while K-means clustering is applied to identify annual wet and dry seasons. Meteorological and hydrological droughts are then assessed using standardized drought indices. Using the Yuanhe river basin as a case study, the results demonstrate that the GRF-based framework effectively preserves spatial correlation characteristics across six CMIP6 models under both SSP2-4.5 and SSP5-8.5 scenarios. Long-term projections reveal a shortening of dry season, with basin-wide meteorological and hydrological drought intensity weakening at yearly and seasonal scales during the mid- to late 21st century. However, pronounced intra-annual variability emerges: October is projected to become drier, whereas wet-season months tend to become wetter. Drying under SSP5-8.5 is markedly stronger than under SSP2-4.5. Moreover, GRF reconstruction enhances the spatial variation of drought indices within the river basin compared to cases without it. The proposed GRF-based framework preserves spatial coherence beyond conventional interpolation and, when coupled with hydrological modeling and clustering analysis, provides high-resolution, basin-scale drought projections. These capabilities support early-warning systems, adaptive water allocation, and long-term climate resilience planning.}
}
@article{MENDES2026135313,
title = {Effluent dynamics from a degraded peatland catchment and the influence of an on-site pond—a warning sign},
journal = {Journal of Hydrology},
volume = {671},
pages = {135313},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135313},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004105},
author = {Lipe R.D. Mendes and Catharine M. Pschenyckyj and Behzad Mozafari and Michael Bruen and Fiachra O’Loughlin and Florence Renou-Wilson},
keywords = {Ammonia, Dissolved organic carbon, Nitrate, Peat extraction, Sedimentation pond, Water quality},
abstract = {Peatlands are important stores of carbon and nutrients, but drainage for peat extraction disrupts hydrology and water quality, enhancing leaching of organic matter and nutrients. This study examined the seasonal dynamics of water quality from a 16.4 ha industrial cutaway peatland catchment in Ireland following storm events and evaluated the influence of an on-site sedimentation pond. Water quality, including carbon, nitrogen and major ions, was monitored over three years using automated storm-event sampling, grab sampling and continuous flow measurements to assess seasonal variability, pond treatment effects and relationships with climatic drivers (flow and temperature). High flows (≥25 L/s) were infrequent, whereas low flows (≤5 L/s) were common. Carbon and nitrogen concentrations varied markedly between storm events, with increasing flow generally causing dilution. Despite their rarity, short-lived high flows accounted for a large proportion (>70–85%) of annual nutrient export. Effluent water quality exhibited clear seasonal patterns and was strongly related to flow and temperature. Warm, dry periods produced more neutral, nutrient-rich effluents, whereas colder, wetter conditions generated more acidic waters with lower concentrations, regulated by pH. Oxygen availability within the catchment appeared to influence carbon production in effluents concurrently with ammonia production. The pond received subsurface inflows low in dissolved oxygen and exhibited highly variable hydraulic retention times (mean ± standard deviation 90 ± 551 days; median 15 days). While the pond retained particulate material, its influence on dissolved constituents was limited. These effluents pose risks to receiving waters, highlighting the need for improved mitigation strategies in extracted peatland catchments.}
}
@article{ZHANG2026135276,
title = {Quantification method for comprehensive flood control benefits of an earth-rockfill dam reservoir considering dam break effects},
journal = {Journal of Hydrology},
volume = {671},
pages = {135276},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135276},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003732},
author = {Yadong Zhang and Jian Zhou and Yutie Jiao and Haoyuan Sun and Heqiang Sun and Wei Ge and Zongkun Li},
keywords = {Dam break effects (), Earth-rockfill dam reservoir, Extreme floods, Flood control benefits ()},
abstract = {Quantifying the flood control benefits (FCB) of earth-rockfill dam reservoirs is critical for evaluating investment rationality. Although earth-rockfill dam reservoirs can reduce flood losses to generate FCB when encountering small floods, their failure during extreme floods results in greater flood losses—a phenomenon herein defined as the dam break effects (DBE). This study proposed methods for determining the critical overtopping flood that causes DBE, calculating the single dam break effects (SDBE) when a reservoir encounters an extreme flood and the average DBE, and quantifying comprehensive flood control benefits (CFCB) by integrating DBE and FCB. The case study shows that SDBE increase with flood scale: at an reservoir initial water level of 400.5 m, the 100,000-year flood SDBE are 1.2 times that of the 10,000-year flood. Additionally, DBE rise with reservoir initial water level—specifically, DBE at 415 m are more than twice that at 400.5 m. In contrast, FCB and CFCB decrease: FCB at 400.5 m are 17.8 times that at 415.0 m, and CFCB drop from 98.1 million yuan to –0.8 million yuan. Moreover, at low reservoir initial water level (400.5 m), CFCB are dominated by FCB (accounting for 97%); at high levels (e.g., 415 m), they shift drastically to being dominated by DBE (accounting for 53%). The proposed method is more accurate compared with traditional methods, especially when the reservoir initial water level is high. It also holds applications in dam type selection, determination of optimal water levels, and decision-making on dam decommissioning.}
}
@article{ADHIKARI2026135248,
title = {Design of stormwater bioretention systems for improved volume and peak runoff reduction},
journal = {Journal of Hydrology},
volume = {671},
pages = {135248},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135248},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003458},
author = {Utsav Adhikari and Ico Broekhuizen and Godecke-Tobias Blecken and Maria Viklander},
keywords = {Biofilters, Hydrologic performance, Climate change, Stormwater management, SWMM, Factorial design},
abstract = {Stormwater bioretention systems are primarily designed to manage stormwater quality as well as restore more natural hydrology during less intense rainfall events. Thus, design modifications are required to manage intense rain events resulting from climate change. This study examined 54 bioretention system design combinations by varying four design factors: filter media fraction of the total soil depth (i.e. filter media + drainage gravel layer), hydraulic conductivity of the filter media, ponding depth, and storage connection diverting surface water to the storage layer through a pipe. Using a calibrated field-scale Storm Water Management Model (SWMM), the performance of these designs was assessed for volume reduction during common rain events, peak flow reduction during a 10-year return interval rain event (180 mm, 1 h), and the number of overflows in a year. Using a storage connection consistently improved performance, enhancing volume reduction by up to 32% and reducing overflow events (up to 11 of 29), as expected since the storage layer provides additional high-porosity detention. Higher filter media fractions (85%) improved volume reduction during common rain events by approximately 50%. Interestingly, lower fractions (15%) were more beneficial for reducing overflow events (in about 17 out of 29 events annually), suggesting that higher porosity and drainage can sometimes prevent excessive surface ponding. These findings underscore the potential of bioretention system designs to enhance climate resilience and emphasize the need for a balanced approach that improves volume reduction during common rain events while also reducing overflow events during high-intensity rainfall.}
}
@article{FU2026135300,
title = {Global distribution of the terrestrial moisture dynamics response to the meteorological dry-wet abrupt alternation},
journal = {Journal of Hydrology},
volume = {671},
pages = {135300},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135300},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003975},
author = {Jianyu Fu and Mingzhu Cao and Yang Lu and Chunzhu Wei and Xuejin Tan and Meiling Zheng and Liqian Peng and Wenhao Jia and Bingjun Liu},
keywords = {Dry-Wet abrupt alternation, Hydroclimatic extreme propagation, Event coincidence analysis, Climate change},
abstract = {Dry-wet abrupt alternation (DWAA) disasters are not merely atmospheric phenomena but are also significantly influenced by land–atmosphere interactions. Understanding the propagation of meteorological dry-wet abrupt alternation (M-DWAA) to terrestrial systems (T-DWAA) is crucial for assessing compound hydroclimatic risks, yet a global assessment is lacking. This study quantifies the global pattern and trends in the coincidence between M-DWAA and T-DWAA events (1982–2015) using Event Coincidence Analysis. We find that approximately 17.4% of M-DWAA events coincide with a T-DWAA within the subsequent season globally, with strong spatial heterogeneity. High coincidence rates (>20%) are concentrated in humid, well-vegetated regions characterized by strong land–atmosphere coupling (e.g., northern Eurasia, monsoon regions), while arid and mountainous regions show lower rates (<20%). Critically, the alternation velocity of M-DWAA events, rather than their mere frequency or intensity, emerges as the dominant factor influencing this propagation likelihood. Furthermore, the linkage is strengthening in regions like the Atlantic Americas and northern Eurasia, primarily associated with increasing M-DWAA velocity, thereby escalating compound hydrological risks. Conversely, a weakening linkage (decreasing coincidence) in some dry regions correlates with reduced meteorological alternation velocity. These findings highlight the pivotal role of the transition velocity of meteorological DWAA in lagged coincidence with terrestrial extremes and provide a global framework to guide future mechanistic research and targeted adaptation strategies.}
}
@article{ATMAJA2026135284,
title = {Integrative statistical analysis of compound flood dynamics under climate variability in China’s coastal zone},
journal = {Journal of Hydrology},
volume = {671},
pages = {135284},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135284},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003811},
author = {Tri Atmaja and Duu-Jong Lee},
keywords = {Compound flood, Storm surge, Reanalysis data, Copula, Climate variability, Temporal dynamics},
abstract = {Compound flood (CF) is a major coastal hazard exacerbated by climate change, posing significant risks to coastal communities. These events exhibit considerable temporal and spatial variability, driven by climatic factors and regional characteristics. Despite recent advances, current CF assessments often fail to adequately integrate key flood drivers—storm surge, rainfall, and river discharge—and frequently overlook the influence of climate variability. This study addresses this gap by systematically analyzing CF dynamics, integrating key flood drivers, and considering multi-scale climate variability using statistical approaches, including Gaussian copulas, Long Short-Term Memory (LSTM), and Poisson regression modeling. Utilizing daily satellite and reanalysis data from the 391-GTSM location along China’s extensive coastline (1979–2020), the results reveal apparent spatial–temporal differences in CF occurrences. Rainfall–discharge CF (CF type 4) dominates southern and central regions due to monsoon influences, whereas surge–rainfall (CF type 2) CF events primarily affect typhoon-prone coastal areas. Analysis of joint return periods indicates frequent surge–rainfall (CF type 2) and rainfall–discharge (CF type 4) events, particularly during boreal summer and autumn. Furthermore, the influence of climate variability, particularly the El Niño-Southern Oscillation (ENSO) and the Interdecadal Pacific Oscillation (IPO), significantly modulates the frequency of all CF types, exhibiting pronounced spatial variations. The predictive skill of LSTM models varied notably among CF types, with the highest accuracy for rainfall–discharge events. These findings offer critical insights into regional hydrometeorological hazards, underscoring the need to incorporate climate-driven CF dynamics into flood management strategies to enhance coastal resilience under future climate conditions.}
}
@article{WU2026135235,
title = {Downscaling GRACE(−FO) with mass-conserving XGBoost approach reveals high-resolution patterns and drivers of hydrometeorological-induced mass changes in High Mountain Asia},
journal = {Journal of Hydrology},
volume = {671},
pages = {135235},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135235},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600332X},
author = {Haotian Wu and Jiangjun Ran and Natthachet Tangdamrongsub},
keywords = {GRACE(−FO), Downscale, Machine learning, XGBoost, HMA},
abstract = {High Mountain Asia (HMA), the largest extra-polar repository of glaciers, critically regulates water resources for nearly two billion people and regional climate systems. Understanding climate impacts and regional water security requires quantifying regional mass changes at fine spatial scales, but the coarse resolution of GRACE(−FO) satellite data impedes this quantification. To address these limitations, this study proposes an XGBoost downscaling method integrated with mass-conservation correction. After obtaining preliminary downscaling results with low uncertainty and RMSE using the XGBoost model, the weighted forward modeling approach is further applied to enforce mass-conservation correction, thereby enhancing physical consistency. This correction reduces the RMSE of the regional mean time series from 0.85 cm to 0.08 cm, demonstrating that mass conservation effectively improves the downscaled solution. The downscaled solution was validated against the public ASTER-derived global digital elevation model, yielding a mean absolute trend error of only 0.53 Gt/yr, and outperforms existing Mascon solutions. Analysis identifies a pronounced atmospheric oscillation over the Caspian–Black Sea region, which induces interannual variations in moisture transport along the northern branch of the westerlies. This modulation of moisture pathways leads to oscillatory precipitation variability across Central Asia, ultimately giving rise to a distinct 6–7 year interannual mass oscillation in the Tien Shan–Pamir region. The strong correlation (greater than 0.7) between this mass variability and detrended cumulative precipitation highlights the dominant role of large-scale atmospheric circulation in shaping fine-scale hydrometeorological-induced mass changes across HMA.}
}
@article{HEIDARI2026135256,
title = {Controls of aquifer geometry and sediment characteristics on land subsidence rates: insights from machine learning in western Iran},
journal = {Journal of Hydrology},
volume = {671},
pages = {135256},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135256},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003537},
author = {Mojtaba Heidari and Bahman Saedi and Seyed Hosein Jalali and Behnam Saedi},
keywords = {Land subsidence, Machine learning, Sediment thickness, Geological model, Bedrock depth},
abstract = {Groundwater-level decline is a primary driver of land subsidence in alluvial aquifer systems, yet quantifying the relative roles of aquifer geometry and sediment composition remains challenging. This study presents an integrated framework combining Sentinel-1 InSAR observations, three-dimensional geological modeling, and machine-learning (ML) techniques to analyze land subsidence in the Asadabad and Chardooli plains, western Iran. Surface deformation time series were derived using the LiCSAR processing chain and decomposed into vertical displacement components. A detailed 3D geological model was developed in RockWorks using borehole logs, geoelectrical resistivity data, and piezometric measurements to characterize sediment thickness and bedrock depth. Bedrock depth and thickness of clayey and loamy soils were incorporated as predictors in ML models to estimate vertical subsidence rates. Spatial thinning and spatial cross-validation were applied to reduce spatial autocorrelation and ensure robust model evaluation. The results show widespread subsidence affecting more than 60% of the study area, with maximum rates exceeding 180 mm/y in the Asadabad Plain. Feature-importance analysis reveals that bedrock depth is the dominant control on subsidence, followed by clay and clay-rich sediment thickness, whereas sandy units exhibit weaker or inverse relationships. The ML models achieved strong predictive performance, with high coefficients of determination and Nash–Sutcliffe efficiencies on spatially independent test data, indicating good generalization to previously unobserved areas. The proposed framework improves both predictive accuracy and physical interpretability, offering a transferable approach for subsidence assessment and groundwater-management applications in structurally complex aquifer systems.}
}
@article{LI2026135272,
title = {A tailored deep learning method to improve spatial rainfall downscaling},
journal = {Journal of Hydrology},
volume = {671},
pages = {135272},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135272},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003690},
author = {Tinghui Li and Shuiqing Yin and Yuanyuan Xiao and Nadav Peleg},
keywords = {Rainfall downscaling, Spatial pattern, Storm center, Intermittency, Extreme rainfall, Deep Learning},
abstract = {Rainfall exhibits highly complex spatial patterns influenced by atmospheric dynamics and thermodynamic factors. Hydrological hazard assessments require long-term, consistent, high-resolution (e.g., hourly and at the km scale) rainfall data; however, such data are lacking across most regions. Deep learning provides effective tools for downscaling rainfall from low-resolution available records, such as remote sensing data. But a key challenge is to downscale heavy rainfall intensities while also obtaining the rainfall spatial structure correctly. It is even more challenging to do so when high-resolution training data are only limitedly available, and when the level of agreement between the high-resolution training and low-resolution target data is low. To address this, we applied a spatial correction algorithm to the training data and tailored a deep learning model, RM-ResNet, which simultaneously learns where rainfall occurs and its magnitude for rainfall downscaling. We used Beijing as the case study, a city that experiences frequent summer heavy rainfall and has records of rainfall fields available at a resolution of 1 km and hourly since 2015. Using the spatially corrected training data in RM-ResNet, we downscaled hourly satellite estimates (CMORPH) from 8 km to 1 km resolution. The downscaling results showed that both hourly and daily extremes are consistent with observations, and that the downscaled spatial structures were well captured. The missing storm centers in CMORPH have been more realistically represented after downscaling, and remain within a reasonable physical range. Our strategy enables rainfall downscaling with lightweight deep learning networks that can be applied anywhere.}
}
@article{ATHUKORALALAGE2026135236,
title = {The impact of a mega-flood event on the water quality of the southern Murray-Darling Basin, Australia},
journal = {Journal of Hydrology},
volume = {671},
pages = {135236},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135236},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003331},
author = {Dilanka Athukoralalage and Justin D. Brookes and Richard W. McDowell and Luke M. Mosley},
keywords = {Extreme events, Flooding, Nutrients, Dissolved organic carbon, River Murray},
abstract = {Extreme floods, driven by climate change, are becoming more frequent and severe across many regions, but the impacts on water quality are uncertain. The Murray-Darling Basin (MDB), in Australia, is a large arid to semi-arid river system, that has experienced major drought and flood events over recent decades. In this study, we investigated the dynamics of Total Nitrogen (TN), Total Phosphorus, and Dissolved Organic Carbon (DOC) in six major flow events from 2011 to 2023, including a 2022–2023 ‘mega-flood’ the largest since 1956. We applied statistical and hysteresis analysis from 3 study sites, spanning the upper to lower regions in the southern MDB. The mega-flood event accounted for over 30% of the total flow and ∼18% of the TN and ∼20% of the TP yield within the entire study period, with higher nutrient peaks and concentrations in downstream sites. This was likely due to a combination of overbank flows, extensive floodplain inundation, and increased nutrient transport from adjacent agricultural catchments. Nutrient concentrations during the mega-flood exhibited distinct counter-clockwise hysteresis, with higher concentrations on the falling limb of the hydrograph, indicating delayed release from floodplains. This contrasts with the upstream headwater site, which showed weak clockwise hysteresis, reflecting rapid hillslope-driven mobilisation. Our findings demonstrate that more frequent climate-driven mega-floods may lead to proportionally larger nutrient loads and prolonged water-quality degradation. However, the magnitude of nutrient export ultimately depends on antecedent catchment conditions and the availability of transport-ready nutrient stores, which can vary substantially between flood events.}
}
@article{BAGHERI2026135244,
title = {RetroSight and ForeSight ensemble model (ReForM) for improved time series prediction: A case study on river temperature prediction},
journal = {Journal of Hydrology},
volume = {671},
pages = {135244},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135244},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003410},
author = {Faezeh Bagheri and Jon Hathaway and Nathan Michael Barber and Colleen Rice Montgomery and Anahita Khojandi},
keywords = {Time series analysis, Machine learning, Ensemble model, River temperature prediction},
abstract = {This study introduces the RetroSight and ForeSight Ensemble Model (ReForM), a new class of data-driven and physics-informed ensemble prediction models. Unlike traditional prediction, which relies solely on historical learning, ReForM leverages the strengths of both historical data and physics-based simulations of future conditions to generate highly accurate predictions of the target variable over extended future time frames. By incorporating insights about potential future trends, ReForM can dynamically adjust its historical learning. To illustrate the performance of this approach, we apply it to a specific context within the field of river management by conducting a case study on the Buffalo River located in Tennessee, USA. Driven by mounting concerns about global warming and its detrimental effects on river ecosystems, governments have enacted stricter regulations on river temperature to safeguard aquatic life. These regulations pose challenges for power plants, which, in many cases, rely heavily on river water. To address this challenge, we employed ReForM to forecast river temperatures far into the future, facilitating proactive planning initiatives necessary to ensure optimized river management. The model’s performance was evaluated across various lead times, representing how far into the future the predictions extended. The computational results show that ReForM achieves a root mean square error of 1.456 ∘C across all experiments. This represents an average improvement of approximately 38% (or ≈ 1 ∘C) over state-of-the-art machine learning benchmarks that solely rely on historical data. Comparative statistical analyses with widely recognized Autoregressive, Wavelet Artificial Neural Network, Random Forest, XGBoost and SVM models in river temperature prediction further validate ReForM’s superior performance, highlighting its capability to efficiently utilize historical data alongside future insights from physics-based models, resulting in reliable short-term and medium-term forecasts.}
}
@article{ZHANG2026135308,
title = {ESMDA-BaPC: an efficient bayesian surrogate approach for contaminant source identification},
journal = {Journal of Hydrology},
volume = {671},
pages = {135308},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135308},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004051},
author = {Guodong Zhang and Teng Xu and Wenjun Zhang and Jie Yang and Yu Ye and Chunhui Lu},
keywords = {Ensemble smoother with multiple data assimilation, Arbitrary polynomial chaos expansion, Bayesian, Contaminant source identification},
abstract = {Identifying contaminant sources is a complex challenge that demands a careful balance between computational efficiency and accuracy. While the ensemble smoother with multiple data assimilation (ES-MDA) method is recognized as an effective approach for estimating contaminant source information, its computational cost remains a limitation. To address this issue, we present ESMDA-BaPC, a novel approach that integrates ES-MDA with a Bayesian framework using arbitrary polynomial chaos expansion (BaPC) to efficiently identify contaminant source parameters consisting of release location and mass-loading rate. In this method, BaPC first serves as a surrogate model within the ES-MDA data assimilation process. Then, ESMDA-BaPC iteratively refines both the surrogate model and the contaminant source parameters to achieve more precise results. Our results demonstrate that ESMDA-BaPC outperforms traditional ES-MDA, delivering comparable accuracy while drastically reducing computation time, with the runtime reduced by approximately 80%. Moreover, the surrogate model accurately predicts contaminant plume, with predicted concentrations closely aligning with real monitoring well data, achieving the R2 value of up to 0.9962 and the RMSE as low as 0.0021.}
}
@article{FU2026135294,
title = {Study of causes and factors affecting abnormal seepage discharge in drainage ditches of earth-rock embankments},
journal = {Journal of Hydrology},
volume = {671},
pages = {135294},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135294},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003914},
author = {Yuchen Fu and Yaoying Huang and Xiaoya Wu and Yujie Zhou and Chunguang Li and Chengdong Liu},
keywords = {Earth-rock embankment, Abnormal seepage discharge, Monitoring factors, External influence factors, Internal influence factors},
abstract = {The seepage discharge collected in the drainage ditches of earth-rock embankments is affected by monitoring methods, the section sizes, and other complex internal and external factors. To systematically analyze the causes of abnormal seepage discharge exceeding the upper limit of 300 L/s of the weir measurement method in embankment drainage ditches, this study proposes a comprehensive analytical methodology comprising inspection, field testing, safety monitoring, numerical simulation, forward and inverse analysis, and feedback analysis. Taking the abnormal seepage discharge in the drainage ditch of the Wangfuzhou Water Conservancy Project embankment as the research target, this study analyzes the status of the seepage discharge in the drainage ditch, verifies the section size and the elevations of the drainage ditch at the monitoring sections, and compares different monitoring methods to assess the reliability of seepage-discharge measurements. Subsequently, both external and internal factors affecting the seepage discharge are systematically analyzed. Finally, the primary causes of abnormal seepage discharge in the embankment drainage ditch are identified through a comprehensive analysis. The results indicate that the embankment foundation consists of approximately horizontal and highly permeable 10–12 m thick medium-sand and sand-gravel layers. The drainage ditch is constructed on these medium sand and sand-gravel layers, which connect the reservoir and the drainage ditch. Consequently, although the geomembrane installed on the upstream slope and the horizontal blanket of the embankment extend the seepage path, it does not completely sever the seepage pathway, which constitutes the primary cause of abnormal seepage discharge in the embankment drainage ditch. The findings of this study provide a reference for identifying abnormal seepage in similar earth-rock embankments.}
}
@article{BOSSERELLE2026135274,
title = {Classifying vulnerability to sea-level rise of coastal shallow groundwater at the national scale for New Zealand},
journal = {Journal of Hydrology},
volume = {671},
pages = {135274},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135274},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003719},
author = {Amandine L. Bosserelle and Leanne K. Morgan and Rogier Westerhoff},
keywords = {Coastal groundwater, Sea-level rise, Vulnerability assessment, New Zealand, Groundwater classification, Saltwater intrusion, Water table rise, Hydrogeological systems},
abstract = {A national-scale assessment provides a comprehensive classification of near-surface unconfined coastal groundwater systems in New Zealand and predicts their vulnerability to sea-level rise. Using high-resolution national datasets, the research applies the water table ratio framework to classify aquifers into head-controlled (topography-limited) or flux-controlled (recharge-limited) systems based on their water table dynamics. Head-controlled aquifers are identified as more vulnerable to saltwater intrusion and the exposure of shallow groundwater, leading to subsurface and infrastructure risks. In contrast, flux-controlled systems are primarily susceptible to water table rise and subsequent groundwater flooding. The findings indicated that while flux-controlled systems are more prevalent by catchment count along the New Zealand coastline (64% of catchments), head-controlled systems dominate in terms of land area (56% of coastal catchment area) and are characteristic of most low-elevation coastal zones (71%). In terms of length of coastline, the majority was flux-controlled (60% of coastline length). This national-scale assessment significantly refines prior coarser global predictions, which estimated that 75% of the NZ coastline was head-controlled. Location-dependent insights are essential for informing effective national water management and enhancing resilience against climate change impacts on New Zealand’s coastline.}
}
@article{WANG2026135239,
title = {A wetland partitioning method based on the hydrological connectivity and the underlying causes of their occurrence},
journal = {Journal of Hydrology},
volume = {671},
pages = {135239},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135239},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003367},
author = {Weize Wang and Peng Hu and Zefan Yang and Qin Yang and Jianhua Wang and Dandong Cheng and Jiwei Zhu},
keywords = {Hydrological connectivity, Wetland partitioning, Water level characteristic value, Cluster analysis, Zhalong Wetland},
abstract = {Human activities have reduced hydrological connectivity in many wetlands, leading to weakening of the mediating role of water in facilitating the diffusion and exchange of materials, energy, and ecological information, resulting in ecosystem fragmentation. In this study, hydrodynamic modelling, characteristic value extraction, and spatially constrained hierarchical clustering were employed to develop a wetland partitioning method based on hydrological connectivity. The spatial variations in hydrologically connected subareas in different hydrological years and the impacts of hydraulic engineering and topography on hydrological connectivity in the Zhalong Wetland, China, were investigated. The results indicated that hydrologically connected subareas in wetlands can be delineated via this method. In wet year, the study area can be divided into 7 hydrologically connected subareas. Moreover, the number of subareas is larger in normal and dry years (11 and 12 hydrologically connected subareas, respectively) than in wet year. These subareas are the result of erosion due to reservoir discharge, obstruction of roads and ditches, and natural topography. The surface water quality parameters in wetlands vary among hydrologically connected subareas owing to differences in flow patterns, source‒sink dynamics, and aquatic vegetation distributions. Compared with field sampling and statistical clustering, this method requires substantially less data, which makes it potentially applicable in data-scarce regions. This study provides technical support for hydrological and ecological monitoring and wetland management.}
}
@article{ZHOU2026135291,
title = {Spatiotemporal dynamics and drivers of water and carbon use efficiency in the Yellow River basin with harmonized MODIS and GLASS data},
journal = {Journal of Hydrology},
volume = {671},
pages = {135291},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135291},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003884},
author = {Shilun Zhou and Ruiting Lyu and Feiyang Wang and Xiaodan Guan and Ning Nie},
keywords = {Water use efficiency, Carbon use efficiency, Remote sensing data harmonization, Yellow River Basin, Environmental drivers},
abstract = {The interplay of global environmental change and human activities has increasingly disrupted ecosystem stability, posing significant challenges for effective water and carbon resource management. Water use efficiency (WUE) and carbon use efficiency (CUE) are critical indicators for assessing ecosystem responses to climate change and resource utilization. However, inconsistencies in remote sensing datasets and limited observational records pose significant challenges to the synchronous and long-term assessment of WUE and CUE, underscoring the need for more robust and harmonized datasets. This study aimed to harmonize long-term MODIS and GLASS datasets and explore the spatiotemporal evolution of water and carbon use efficiency in the Yellow River Basin (YRB) using machine learning models. This study employs Cubist, Random Forest (RF), XGBoost, and Min-Max Stretch Transformation models to harmonize MODIS and GLASS vegetation datasets, generating a robust Gross Primary Productivity (GPP) and Net Primary Productivity (NPP) dataset for the YRB from 1982 to 2023. Using this harmonized dataset, we systematically investigated the spatiotemporal patterns of WUE and CUE, as well as their underlying drivers. Results show that WUE demonstrated a statistically significant increasing trend (p < 0.05) over the 42-year period, whereas CUE showed a notable decreasing trend (p < 0.05). Approximately 54.51% of the YRB exhibited a coupled pattern of increasing WUE and decreasing CUE, with 69.47% of croplands, 49.71% of grasslands, and 22.07% of forest ecosystems exhibiting this trend. Geodetector analysis revealed that among climatic factors, minimum temperature (Tmin), mean temperature (Tmean), and maximum temperature (Tmax) were key determinants of CUE, whereas WUE was primarily influenced by Tmin, Climate Water Deficit (CWD), and Tmean. Interactions between precipitation and other factors exhibited particularly strong impacts. The RF model analysis further highlighted the varying influence of environmental factors on WUE and CUE across diverse ecosystems before and after 2000. This study provides a robust, globally transferable framework for harmonizing long-term datasets and analyzing water-carbon coupling dynamics, offering critical insights for advancing ecosystem management strategies and promoting sustainable development in regions facing similar environmental challenges.}
}
@article{PAN2026135129,
title = {Evaluating saturated hydraulic conductivity schemes: impacts on soil moisture simulations and soil texture-dependent applicability},
journal = {Journal of Hydrology},
volume = {671},
pages = {135129},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135129},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600226X},
author = {Yongjie Pan and Danyun Wang and Shihua Lyu and Xia Li and Suosuo Li and Youqi Su},
keywords = {Saturated Hydraulic Conductivity, Land surface model, Soil moisture, Tibetan Plateau},
abstract = {Soil saturated hydraulic conductivity (Ksat) is a key parameter in hydrological processes. While numerous Ksat estimation schemes have been developed and evaluated against laboratory measurements, their integration into land surface models (LSMs) and their subsequent impact on simulating soil hydrology have been less explored. In this study, five typical Ksat schemes were evaluated with laboratory measurements and then incorporated into the latest version of the Community Land Model (CLM5.0) to evaluate their performance in simulating soil moisture of the Tibetan Plateau (TP). Against laboratory measurements, most schemes overestimated Ksat to varying degrees, except for the Campbell scheme. The CLM5.0 default scheme performed best in terms of overall accuracy, yet it failed to adequately capture the full range of observed variability. The results of the site-scale soil water content simulations at the 12 sites showed that the Chapuis scheme exhibited the smallest root mean square error and the United States Bureau of Reclamation (USBR) scheme had the highest temporal correlation. Analysis of the entire study area indicated that all simulation schemes exhibit similar performance, with the USBR scheme overall better than the others, with RMSE of 0.106 m3·m⁻3. Sub-regional analysis further highlighted that the optimal scheme depends on soil texture and organic matter. XGBoost/SHAP analysis of the soil texture-dependent reveals that simulated shallow soil moisture in all schemes was predominantly controlled by soil organic matter (SHAP range: 0.04–0.06), with this influence diminishing with depth. These findings enhance the capability and applicability of LSMs for simulating soil hydraulic processes.}
}
@article{HU2026135275,
title = {A semi-supervised LSTM framework for spatiotemporal downscaling of GRACE-derived terrestrial water storage anomalies to improve flood monitoring in the Yarlung Tsangpo River basin},
journal = {Journal of Hydrology},
volume = {671},
pages = {135275},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135275},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003720},
author = {Ying Hu and Xiaoming Cai and Yue-Ping Xu and Haiting Gu and Jingkai Xie and Sirui Dai},
keywords = {GRACE/GRACE-FO, YarlungTsangpo River Basin, Semi-supervised learning, Spatiotemporal downscaling, Flood monitoring},
abstract = {The Gravity Recovery and Climate Experiment (GRACE) and its follow-on mission (GRACE-FO) provide essential observations for flood monitoring in medium and large basins. However, their applications are constrained by coarse spatiotemporal resolution, data gaps, and product inconsistencies. In this study, GRACE-derived terrestrial water storage anomalies (GRACE-TWSA) products from three major agencies were fused using the Bayesian three cornered hat (BTCH) to reduce uncertainty in the Yarlung Tsangpo River Basin (YTRB), China. Building on this, we developed a novel semi-supervised spatiotemporal downscaling framework based on long short-term memory networks (SSDF-LSTM). This framework leveraged both labeled and unlabeled data, applied physical constraint during pseudo-label refinement, and adopted a spatially stratified training strategy that preserved complete temporal signals. As a result, the monthly 0.5° TWSA was downscaled to daily 0.25° resolution while filling missing data and maintaining high consistency with GRACE observations, achieving a correlation coefficients (CC) of 0.97, Nash-Sutcliffe efficiencies (NSE) of 0.92, and root mean square error (RMSE) of 22.26 mm. Furthermore, we proposed a daily detrended normalized flood potential index (D-DNFPI) which demonstrated higher accuracy (0.85) and precision (0.80) than conventional indices. Overall, this study established a robust methodological framework for enhancing the spatiotemporal resolution of GRACE-TWSA and advancing its applications in flood monitoring.}
}
@article{ZAFAR2026135186,
title = {Temporal transferability of spatially derived Manning’s roughness across flood regimes in the Mississippi River},
journal = {Journal of Hydrology},
volume = {671},
pages = {135186},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135186},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426002830},
author = {Muhammad Bilal Zafar and Mantha S. Phanikumar},
abstract = {Evaluating the temporal transferability of spatially derived roughness across flood regimes is important to balance the use of consistent roughness values for model reliability with adjustments needed to reflect changing conditions and improve model performance. We applied a high-resolution 2D unstructured grid hydrodynamic model to simulate flood events on the Middle Mississippi River focusing on two significant flood years (2011 and 2019) and a year with moderate flooding (2022). Model results were evaluated using gauge data from USGS stations and high-resolution data on flood inundation extents from Planet Labs Dove satellites for 2019 and 2022 to ensure robust evaluation. Simulations for all years used the same set of spatially variable Manning’s roughness (n) values, which remained temporally invariant. The model exhibited excellent performance across all years, with Nash–Sutcliffe Efficiency values of 0.98–0.99 for water surface elevations and 0.92–0.99 for discharge, as well as strong agreement with observed flood inundation extents. Discrepancies in model performance in 2011, particularly in flood peak magnitude and timing, were attributed to substantial unaccounted inflows (e.g., from tributaries) entering the model domain that were not represented in the boundary conditions. The consistently strong model performance using spatially derived roughness over a decade suggests that reductions in performance are more likely caused by hydrologic forcing (missing flow inputs) rather than by temporal changes in roughness. This study highlights the need for a careful assessment of whether sufficient evidence justifies using time-dependent roughness values and advocates against treating Manning’s n as a free, catch-all parameter.}
}
@article{SHU2026135271,
title = {High-resolution urban flooding inundation forecasting through hydrodynamic interaction and multimodal deep learning},
journal = {Journal of Hydrology},
volume = {671},
pages = {135271},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135271},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003689},
author = {Xinyi Shu and Zongxue Xu and Silong Zhang and Depeng Zuo and Chenlei Ye and Xudong Zhang and Lei Yu},
keywords = {Urban pluvial flooding, Tightly coupling, Multimodal deep learning, Hydrological-hydrodynamical model, Attention mechanisms},
abstract = {Urban areas are experiencing escalating flood risks driven by climate change and rapid urbanization. Coupled hydrological-hydrodynamic models and data-driven approaches were widely adopted for flooding forecasting. However, existing research typically focuses on the spatiotemporal nonlinear mapping of flooding series, with limited exploration of the interaction between hydrodynamic processes and inundation prediction, multimodal data feature extraction, and accurate flood mapping in discrete urban areas. This research proposes a multimodal deep learning model surface multimodal deep flood net (SMDFN), primarily combining hydrodynamic simulations. A tightly coupled model is developed to capture the interaction between 1D and 2D process through the discharge in manholes, generating high-resolution inundations datasets. SMDFN is constructed based on encoder-decoder architecture, integrating the residual connections, spatial attention, channel attention, and mask filtering. Model performance is evaluated under varying rainfall scenarios, with successful application demonstrated in Jinan, China. The results indicate that tightly coupling performs better than loose coupling in representing the hydrodynamic features of the interaction between surface and drainage flooding. The inundation depth in flood-prone areas ranged from 0.76 m to 1.40 m under loose coupling, normally higher than the depth through tightly coupling. SMDFN enables multimodal feature extraction and parallel prediction across multiple regions, demonstrating strong applicability under both disturbed and idealized rainfalls. By incorporating attention mechanisms and residual blocks, the model’s performance is significantly improved, with a 13.8% reduction in RMSE. This research provides an innovative multi-region collaborative forecasting solution for rapid urban flood forecasting and risk management.}
}
@article{CHEN2026135255,
title = {Modelling and assessing eutrophication and antibiotic risks in a lake system under large‑scale water diversion},
journal = {Journal of Hydrology},
volume = {671},
pages = {135255},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135255},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003525},
author = {Yihan Chen and Shuanggang Hu and Yongjie Yang and Kangping Cui and Chao Zhu and Min Zhang and Youde Zhang and Chen-Xuan Li and Sanjeeb Mohapatra and Peng Jiang and Xuneng Tong},
keywords = {Water diversion project, Hydrodynamic-environmental model, Risk assessment, Antibiotics, Eutrophication, Water quality management},
abstract = {Water diversion projects are widely implemented to address water scarcity, improve water quality, and restore ecological conditions in degraded aquatic systems. This study applies a process-based hydrodynamic-environmental model to investigate the dynamics of eutrophication and the representative antibiotic tetracycline in Chaohu Lake under the influence of the Yangtze–Chaohu Water Diversion Project. To explore the influence of different diversion pathways, two numerical scenarios were developed representing two alternative water diversion options: western and eastern routes. The model was validated against field data, achieving Nash–Sutcliffe efficiency values ranging from 0.34 to 0.80 and absolute relative differences between 9.31% and 18.64%, indicating satisfactory performance. Assessment results revealed that tetracycline posed high ecological risks during summer, while nutrient concentrations and eutrophication levels remained within mild to moderate ranges throughout the study period. Comparison of the two scenarios indicated that the western route more effectively reduced ecological risks, yielding annual reductions of 9.12% in total phosphorus, 13.68% in chlorophyll-a, and 11.5% in tetracycline concentrations. This study provides critical insights for optimizing the operation of water diversion projects and supports the sustainable management of aquatic ecosystems, particularly in mitigating the combined threats of eutrophication and antibiotic pollution.}
}
@article{UYSAL2026135279,
title = {A data-assimilated SEAS5 forecasting framework for seasonal hydropower inflows in a snow-dominated basin},
journal = {Journal of Hydrology},
volume = {671},
pages = {135279},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135279},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003768},
author = {Gökçen Uysal and Marie-Amélie Boucher and Charles Mathieu and Rodolfo Alvarado-Montero and Ali Arda Şorman},
keywords = {Seasonal forecasting, Data assimilation, Snowmelt, Hydropower inflow, Manicouagan basin},
abstract = {Seasonal inflow forecasting is critical for optimizing hydropower operations in snow-dominated basins, where climate-induced non-stationarity challenges traditional methods. This study integrates a variational data assimilation (VarDA) scheme into a semi-distributed hydrological model (HBV) to enhance seasonal predictions of inflow, snow cover area, and snow water equivalent in the Manic-5 basin, Québec, Canada. The hydrological model is calibrated and validated using observed hydro-meteorological data, IMS-based snow cover area, and in-situ/ERA5-Land snow water equivalent datasets. A closed-loop hindcasting framework is applied for 2017–2022 under three meteorological forcing scenarios: single perfect forecasts, climatology-based ensemble forecasts with the Extended Streamflow Prediction (ESP), and meteorological data-based ensemble forecasts from ECMWF (European Centre for Medium-Range Forecast) Seasonal Forecasting System version 5 (SEAS5). Results show that variational data assimilation significantly improves both inflow and snow water equivalent forecasts across all scenarios, particularly during the first 1–3 months of lead time. SEAS5 outperforms ESP in capturing climate signals, while ESP retains skill through historical analogs. Forecast skill is evaluated using mean continuous ranked probability score, Brier skill score, and reliability diagrams. Variational data assimilation enhances model initialization through the assimilation of sparse in-situ snow water equivalent data, especially in spring. The findings highlight the potential of combining ensemble-based forecasting with data assimilation to improve seasonal hydrological predictability and support climate-resilient hydropower planning in cold-region basins.}
}
@article{CIRILO2026135263,
title = {From small to mega river basins−adaptation of a lumped hydrological model for runoff simulation},
journal = {Journal of Hydrology},
volume = {671},
pages = {135263},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135263},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003604},
author = {José Almir Cirilo and Dênia Santos {de Oliveira} and Gadadhara {de Figueiredo Ferraz} and Fellipe Henrique Borba Alves and Mariana {de Lucena Corrêia Campos} and Luttemberg Ferreira {de Araújo} and Othon Fialho {de Oliveira} and Júlia Daniele Silva {de Souza} and Sabrina {da Silva Correa} and Hellen Xavier Tavares Vasconcelos and Noemy Xavier Tavares Vasconcelos and Agnes Sales Alves {de Sousa}},
keywords = {Mega river basins modelling, Lumped hydrological models, CAWM, GR4J, HMS},
abstract = {Conceptual lumped hydrological models are widely used to simulate surface runoff in small catchments, particularly in intermittent or temporary river systems. This study presents an updated version of the CAWM IV (Campus Agreste Watershed Model), originally developed for hydrological simulations in small semi-arid basins, in which the core mathematical structure is preserved while key conceptual extensions are introduced. The main update consists of the inclusion of a groundwater reservoir and an explicit soil–groundwater exchange threshold, enabling the representation of baseflow generation and runoff processes in perennial rivers and under more humid conditions. The applicability of the updated CAWM model is evaluated across six Brazilian river basins with contrasting drainage areas, ranging from 1,316 km2 to approximately 4.6 million km2, including the Amazon, Madeira, Tocantins–Araguaia, Parnaíba, das Velhas, and Sirinhaém basins. Model performance is assessed during calibration and validation periods using standard efficiency metrics and compared with the GR4J and HEC-HMS models. Across the mega basins, CAWM showed robust and stable performance, with Nash–Sutcliffe Efficiency (NSE) values ranging from approximately 0.76 to 0.94 and low volumetric bias. In the smaller basins, CAWM achieved satisfactory to very good performance (NSE typically between 0.74 and 0.85), comparable to or better than HEC-HMS and clearly outperforming GR4J. Overall, the results demonstrate that the updated CAWM model can reliably reproduce river flow dynamics across basin scales.}
}
@article{HEMMATZADEH2026135287,
title = {Physics-informed machine learning with embedded sediment rating curve constraints for high-fidelity multi-lead-time forecast of suspended sediment concentration},
journal = {Journal of Hydrology},
volume = {671},
pages = {135287},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135287},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003847},
author = {Yousef Hemmatzadeh and Sadra Shadkani and Ali Hosseinzadeh Dalir and Sepideh Karimi and Jalal Shiri and Ali Saber},
keywords = {Extreme gradient boosting, Flow regime classification, Multi-lead-time forecast, Physics-informed machine learning, Sediment rating curve, Suspended sediment concentration},
abstract = {Suspended sediment concentration (SSC) critically influences fluvial morphodynamics, sediment transport, and ecological health. Its forecast is hindered by nonlinear, nonstationary dynamics driven by hydrologic variability and multiscale interactions. Conventional models often fail to capture these complexities, necessitating adaptive, physics-informed approaches. This study developed a physics-informed machine learning framework that embeds empirical sediment rating curves as differentiable regularization terms within MLP-SGD and XGBoost loss functions. Two formulations were tested: the single-regime equation of Fernández et al. (2018) and a novel, threshold-based piecewise curve. Evaluated on daily discharge (Q) and SSC data (1982–2022) from Chester (CH) and Thebes (TH) stations on the lower Upper Mississippi River, the advanced Physics-informed eXtreme Gradient Boosting Tree model with six inputs (APhyXGBoost-6), integrating current Q and three-day antecedent SSC and Q, achieved R2 = 0.981 (CH) and 0.986 (TH), surpassing conventional XGBoost by 15.5–16.1% in R2 and reducing scatter index by over 66%. It accurately replicated extreme SSC events and the heavy-tailed distribution, maintaining skill up to 14-day lead times. Under high-flow conditions, where empirical rating curves failed (NSE < − 16), APhyXGBoost-6 retained high fidelity (R2 > 0.95). Performance peaked when real-time discharge was combined with antecedent sediment memory, reflecting physical coupling of hydraulic forcing and sediment availability. Critically, it reproduced observed clockwise hysteresis loops during major floods (2013–2019), with predicted Hysteresis Index values matching observations within a mean absolute error of 0.02. This work establishes a generalizable framework for embedding regime-aware knowledge into data-driven models, advancing operational SSC forecasting in complex river systems.}
}
@article{LUO2026135227,
title = {Influence of anthropogenic water dissipation on urban heat island – a case study of Beijing},
journal = {Journal of Hydrology},
volume = {671},
pages = {135227},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135227},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003240},
author = {Zhuoran Luo and Xianzhi Wang and Jiahong Liu and Shanghong Zhang and Li Zhang and Weiwei Shao and Yinxin Ge},
keywords = {Anthropogenic water dissipation, UCM, Temperature, Latent heat flux, Coupled model},
abstract = {In the process of rapid urbanization, anthropogenic water use activities (such as indoor building water use, road sprinkling, and vegetation irrigation, etc.) have become an important part of urban water cycle, and the water vapor dissipation generated by evaporation and transpiration has a significant impact on urban energy balance and local climate. However, the current mainstream urban climate models generally lack a detailed description of urban anthropogenic water dissipation process, which limits their ability to simulate urban heat island effect and hydrological process. This study constructed a calculation model for urban anthropogenic water dissipation, incorporated moisture fluxes from anthropogenic water consumption activities into the UCM and coupled it with the WRF model for simulation. Taking typical periods of summer and winter in Beijing as examples, the influence of anthropogenic water dissipation on the UHI was simulated and analyzed. The results show that anthropogenic water dissipation significantly increases the latent heat flux (LH) and specific humidity in urban areas. In summer, the LH in urban areas increases by about 30 W/m2, and the 2 m average temperature decreases by about 0.7 ℃, thus effectively reducing the intensity of the UHI. Although the anthropogenic water dissipation decreases in winter, it still has a positive effect on maintaining a relatively high specific humidity. The specific humidity in urban regions increases by about 0.12 g/kg. The simulation results are verified by observational data with high accuracy, emphasizing the necessity of incorporating anthropogenic water dissipation processes in urban climate model.}
}
@article{LACHAPELLE2026135251,
title = {Quantifying the hydrological services of wetlands with respect to the Strahler order of their river segments},
journal = {Journal of Hydrology},
volume = {671},
pages = {135251},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135251},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003483},
author = {Simon Lachapelle and Etienne Foulon and Alain N. Rousseau and Marianne Blanchette and Stéphane Savary},
keywords = {Hydrologic modeling, Lake Champlain, PHYSITEL/HYDROTEL, Wetland loss, Flood mitigation, Wetland network dynamics, Catchment-scale analysis},
abstract = {Hydrological services associated with wetlands are critical for water resource management, particularly in mitigating extreme flows and maintaining hydrological stability. This study quantifies these services by examining the spatial distribution of wetlands relative to the Strahler order of their associated river segments within the USA-Canada transboundary Lake Champlain-Richelieu River (LCRR) watershed. A semi-distributed hydrological model (PHYSITEL/HYDROTEL) was employed to simulate the effects of wetland loss across 20 subwatersheds, spanning diverse sizes and hydrographic configurations. Three assessment methods (cumulative upstream-to-downstream, sequential, and cumulative downstream-to-upstream) were used to evaluate changes in key hydrological indicators, including high flows (Q2, Q10, Q50) and low flows (7Q2, 7Q10, 30Q5), under various wetland scenarios. The results reveal that upstream wetlands, particularly those associated with Strahler order 1 segments, exert a disproportionate influence on hydrological regulation. Wetland loss was shown to amplify high flows linearly, with a 3.5% loss in wetland area corresponding to a 1% increase in high flow indicators. Conversely, low flows exhibited an exponential decline in response to wetland loss, highlighting the reduced resilience to drought conditions. By analyzing many subwatersheds with varying sizes and configurations, this study provides insights that extend beyond the LCRR, offering a framework applicable to other watersheds with heterogeneous characteristics. This research is novel in its use of 20 diverse subwatersheds to identify generalizable trends in wetland hydrological services, a scale and heterogeneity not previously addressed in similar studies. It underscores the necessity of preserving upstream wetlands to mitigate flooding and sustain baseflows, particularly in regions facing increasing hydrological variability. While an empirical rule for high flow regulation was identified, more work is needed to refine low flow relationships and incorporate typological wetland distinctions (e.g., riparian vs. isolated). These findings provide actionable insights for land management planning and wetland conservation, emphasizing their role in promoting hydrological stability at both local and regional scales.}
}
@article{ZHOU2026135312,
title = {Detecting drought propagation pathways in different climatic regions of China},
journal = {Journal of Hydrology},
volume = {671},
pages = {135312},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135312},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004099},
author = {Zhaoqiang Zhou and Linqi Li and Yibo Ding and Yiyang Zhao and Haiyun Shi and Renjie Hou and Ping Wang and Ping Xue and Tian Wang and Peng Chen},
keywords = {Meteorological drought, Hydrological drought, Agricultural drought, Causality, Drought propagation},
abstract = {Different types of droughts have complex relationships with each other, and accurately identifying these relationships and drought propagation pathways is crucial for understanding the formation and evolution of droughts. This study evaluated the meteorological drought (MD), hydrological drought (HD), and agricultural drought (AD) characteristics of different climate regions in China based on the hydro meteorological data of ECMWF Reanalysis 5th Generation (ERA5) from 1950 to 2022. The relationships between different drought types are explored using Pearson correlation coefficient (PCC) and convergent cross-mapping (CCM), and drought propagation pathways are identified with CCM. The results indicated that (1) there is some spatial similarity in the distribution characteristics of HD and AD, whereas MD has greater duration and severity in northwestern China; (2) there is a complex interaction between different types of drought in most regions of China; and (3) in 57.3% of China, the drought propagation pathway is MD-AD-HD, whereas in 38.72% of China, it is MD-HD-AD. This study provides new insights into the mutual feedback relationships between multiple types of droughts and enhances the understanding of the mechanisms of drought formation and evolution.}
}
@article{ZHU2026135307,
title = {Urban expansion and climate variability drive hypoxia: A Landsat-based 1986–2024 dissolved oxygen climatology in China’s Greater Bay area},
journal = {Journal of Hydrology},
volume = {671},
pages = {135307},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135307},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600404X},
author = {Xiaotong Zhu and Hongwei Guo and Han Zhang and Peng Zhang and Shiqiang Zhou and Minghua Zhou},
keywords = {Dissolved oxygen, Machine learning, Ensemble model, Remote sensing},
abstract = {Dissolved oxygen (DO) serves as a fundamental parameter for assessing the ecological well-being of coastal waters and is vital for sustaining the equilibrium of aquatic ecosystems. However, the trends and drivers of DO in coastal waters influenced by climate change and extensive human activities are still not well understood across vast spatial and temporal extents. Using the Greater Bay Area (GBA) as a representative urbanized coastal region, this study developed a robust ensemble machine learning (EML) algorithm to estimate DO concentrations and reconstruct a continuous DO time series from 1986 to 2024 based on Landsat satellite data. Thus, the reconstructed DO time series in the GBA were correlated with land-use and climate and factors to explore the underlying drivers of DO fluctuations. The results demonstrated that EML reliably estimated DO from Landsat Rrs, with Error, Bias, Slope, and mean absolute error of 8.31%, −0.1%, 0.30 and 0.75 mg L−1 on validation set, respectively. The DO concentrations remained relatively stable overall with an average of 6.04 ± 0.51 mg L−1, while hypoxic areas declined significantly from 1,445.2  km2 in 1986 to 271.4  km2 in 2024. The lower DO concentrations occurred in summer, with persistent hypoxia in estuarine nearshore zones. Nevertheless, historical trends indicated significant increases in DO concentrations and reductions in hypoxic extent. The SHAP-driven factor analysis indicated that these improvements were linked to land-use changes, including a reduction in cropland and urban expansion. This suggests that targeted policy interventions have mitigated the adverse effects of urbanization on coastal oxygen dynamics. These findings not only illustrate the applicability of remote sensing for reconstructing spatiotemporal DO patterns, but also offer valuable insights into the complex mechanisms underlying DO variability in coastal environments.}
}
@article{LIANG2026135273,
title = {WetFramework: A deep learning framework for coastal wetland boundary extraction and inundation frequency estimation},
journal = {Journal of Hydrology},
volume = {671},
pages = {135273},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135273},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003707},
author = {Jintao Liang and Yong Zhang and Yi Wang and Chao Chen},
keywords = {Coastal wetland modeling, Semantic segmentation, Feature complementarity, Fourier fitting, Inundation frequency},
abstract = {Coastal wetlands, characterized by their geomorphological sensitivity and tidal dependence, exhibit pronounced vulnerability under global warming. While the persistent threat of sea-level rise to coastal wetlands has been extensively documented at the macroscale, there remains a lack of systematic quantitative frameworks for mapping these trends to the microscale dynamics of wetland evolution. To address this gap, this paper proposes WetFramework, a novel approach for joint modeling of spatial structure and temporal variation in wetlands. (1) In the encoder, Transformer and Mamba modules are integrated to enhance multiscale feature representation through the synergy of global attention and implicit sequence modeling, with a Token-Driven Attention Mechanism (TDAM) designed to facilitate deep interactions between features. (2) In the decoder, a Wavelet-Enhanced Reconstruction Module (WERM) is introduced to improve spatial structure modeling via wavelet transforms, thereby optimizing boundary delineation and fine detail representation for precise mapping of coastal wetland extents. (3) To capture periodic inundation characteristics, a Fourier-Based Inundation Estimation Module (FBIEM) is further proposed, incorporating tidal-height observations to enable unsupervised modeling of pixel-level hydrological responses and quantitative expression of inundation rhythms. Extensive experiments conducted in four representative coastal regions—Yancheng and Dongying (China), Mont-Saint-Michel Bay (France), and San Francisco Bay (USA)—demonstrate that the proposed framework outperforms state-of-the-art models across multiple evaluation metrics and exhibits robust cross-regional generalization and dynamic modeling capabilities. This study provides an effective paradigm for intelligent remote sensing-based wetland identification and long-term hydrological modeling, and offers key hydrological information to support inundation-dynamics monitoring and management decision-making.}
}
@article{KRAKOWIAK2026135262,
title = {Elucidating seasonal pathways and sources of chloride to freshwater streams across urban and rural catchments},
journal = {Journal of Hydrology},
volume = {671},
pages = {135262},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135262},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003598},
author = {Ryan E. Krakowiak and Charles J. Paradis and Timothy J. Wahl and Timothy J. Grundl and Leah E. Dechant},
keywords = {Freshwater, Salinization, Baseflow, Chloride, Road Salt},
abstract = {Prior studies of freshwater salinization have focused on pathways in either urban or rural areas, often without chemical analyses of source identification, and with incomplete seasonal data; this study aimed to fill these important knowledge gaps. Discrete samples of chloride, bromide, and total nitrogen along with continuous measurements of stream discharge and specific conductance were collected. Data was analyzed for pathways using hydrograph separation, for sources using bivariate mixing diagrams, and for chloride mass loading using regression-based modeling. Baseflow pathways contributed 46% of total chloride loading in the urban area compared to 51% in the rural area, likely due to a difference in total impervious surface coverage. Road salt sources of chloride were predominant in both urban and rural areas, despite sharply contrasting land cover. The urban area contributed approximately 99 tons of chloride per square mile compared to 41 tons by the rural area, likely due to a difference in road salt application. Chloride loading in the urban area was most prominent in the early spring, likely due to road salt runoff driven by precipitation events. Chloride loading in the rural area was most prominent in the summer, likely due to baseflow of legacy road salt. The results of this study were novel and significant in that they showed the importance of baseflow pathways and legacy road salt sources of chloride in both urban and rural areas throughout all four seasons.}
}
@article{YANG2026135246,
title = {Quantitative assessment impact of anthropogenic heat flux on global urban evapotranspiration retrieval at multiple temporal scales},
journal = {Journal of Hydrology},
volume = {671},
pages = {135246},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135246},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003434},
author = {Zi Yang and Xin Pan and Hongjun Zhu and Fanggang Li and Xiangjin Meng and Rufat Guluzade and Yuanbo Liu and Suyi Liu and Wen He and Zhenwei Wang and Yingbao Yang},
keywords = {Urban evapotranspiration, Anthropogenic heat flux, Retrieval, Assessment of the impact},
abstract = {Urban evapotranspiration (ET), a crucial component of the urban surface water–energy balance, is challenging to estimate accurately because most existing methods neglect the anthropogenic heat flux (AHF) generated by urbanization and human activities. This study quantified the global impact of AHF on ET estimation by comparing remote sensing–derived ET that includes and excludes AHF across 668 cities worldwide. On an annual scale, neglecting AHF resulted in significant ET underestimation, with absolute (relative) differences of 2.23 W/m2 (7.9%) in cold regions, 2.56 W/m2 (9.8%) in Europe, and 2.81 W/m2 (11.0%) in megacities. In cold-region megacities, relative differences reached 16.0%, approximately 1.8 times higher than those in medium-sized cities in arid zones, and further increased to 9.70 W/m2 (32.7%) in compact high-rise and mid-rise building districts. Seasonally, the discrepancy peaked in summer (3.95 W/m2), nearly four times that in winter. During summer, cold-region megacities exhibited the largest differences (mean 8.49 W/m2), with maximum values up to 20.80 W/m2 in compact high-rise and mid-rise building districts. These findings provide the first global-scale quantitative evidence identifying the conditions under which the AHF should be considered in urban ET estimation. Moreover, incorporating the AHF improves the accuracy of ET retrieval and strengthens the assessment of urban water and energy budgets.}
}
@article{ADOMBI2026135249,
title = {DeepDiscover: towards autonomous discovery of bucket-type conceptual models – a proof of concept applied to hydrology},
journal = {Journal of Hydrology},
volume = {671},
pages = {135249},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135249},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600346X},
author = {Adoubi Vincent De Paul Adombi},
keywords = {DeepDiscover, Autonomous reservoir model discovery, Physics-embedded machine learning, Scientific machine learning, Streamflow prediction},
abstract = {Conceptual hydrological models are widely used to represent rainfall-runoff dynamics at the catchment scale. However, their structure and governing equations are traditionally defined a priori by a human expert. This reliance on expert-defined formulations limits scalability, constrains structural diversity, and hampers the systematic exploration of alternative process representations. In this study, we introduce DeepDiscover, a framework designed to autonomously infer bucket-type conceptual hydrological models from data within a physics-embedded machine learning (PeML) setting. The approach relies on a modular neural architecture composed of elementary units intended to represent reservoirs within bucket-type conceptual models. In this architecture, hydrological processes are not explicitly prescribed but are learned implicitly under explicit physical constraints. DeepDiscover is evaluated on the CAMELS-US dataset in a streamflow prediction task through three complementary experiments. In the first experiment, predictive performance is assessed against several benchmark models: EXP-HYDRO (conceptual model), EXP-PeML, a 1D-CNN, and an LSTM, all trained under identical sequence-to-sequence conditions. The DeepDiscover-based model (DD-PeML) outperforms all benchmarks, achieving median NSE and KGE values of 0.68 and 0.70, respectively, on the test set. The second experiment investigates whether DeepDiscover can recover hydrologically meaningful internal dynamics when trained to mirror EXP-HYDRO. The inferred process and state variables closely match those of EXP-HYDRO, with median R2 of approximately 70 % for processes and 80 % for states. An additional exploratory analysis increases the number of candidate processes, showing that the learned fluxes can still be consistently associated with known hydrological process types, supporting the framework’s capacity for data-driven process discovery. Finally, perturbation experiments demonstrate physically coherent responses to changes in precipitation and temperature, confirming that the learned dynamics remain consistent with fundamental hydrological behavior. Overall, this work demonstrates that autonomous inference of bucket-type conceptual hydrological models from data is feasible within a physically constrained learning framework, and represents a step toward reducing dependence on expert-defined model formulations.}
}
@article{LI2026135254,
title = {Influence of shape on the incipient motion of exposed microplastics},
journal = {Journal of Hydrology},
volume = {671},
pages = {135254},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135254},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003513},
author = {Zhiwei Li and Haokun Feng and Bin Sun and Carlo Gualtieri and Qiuhua Liang and Wei Zhang and Feifei Wang},
keywords = {Microplastics, Incipient motion, Shape effect, Aging, Critical shear stress},
abstract = {Microplastics are now widely detected in aquatic environments, with rivers serving as key transport pathways from land to the ocean. Understanding the incipient motion thresholds of microplastic is essential for predicting their transport dynamics in water bodies. Upon entering the environment, microplastics undergo aging processes that alter their physical and chemical properties, yet existing models for predicting incipient motion thresholds do not account for these effects. This study determines the critical flow velocity for aged microplastics and assesses the influence of aging and shape factors on their mobilization using both experimental data from the literature and new experiments. To incorporate particle shape effects, the repose angle and drag coefficient of microplastics were considered. A new explicit formula was developed to directly calculate incipient motion thresholds for both aged and unaged microplastics, achieving a relative average error of 12.1%, which outperforms existing models.}
}
@article{GOU2026135278,
title = {Chloride source dynamics under dry–wet conditions in a watershed with imbalanced chloride input–output: Insights from tracer-aided modeling},
journal = {Journal of Hydrology},
volume = {671},
pages = {135278},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135278},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003756},
author = {Jianfeng Gou and Simin Qu and Wenjie Liu and Chong Wei and Xueliang Feng},
keywords = {Chloride sources, Dry-wet condition, Tracer-aided modeling, StorAge Selection method},
abstract = {Understanding salt transport within watersheds is crucial for addressing freshwater salinization. However, the dynamic response of stream chloride sources to dry-wet conditions remains unclear. This study adopted a Two-Reservoir StorAge Selection (TRSAS) model in the Scott Creek watershed (South Australia), a typical system with imbalanced chloride input–output, to investigate temporal variations in chloride contributions from atmospheric deposition, interflow, and groundwater. Hydrological conditions were classified into four types (drought, dry-to-wet, wet, wet-to-dry) using the Daily Evapotranspiration Deficit Index (DEDI). Results revealed that while the contribution of dissolved soil salinity via interflow was relatively stable during drought (mean = 0.31) and wet (0.36) conditions, the young water fraction varied considerably (0.41 vs. 0.58). Transitional periods showed the most pronounced shifts, with interflow contributions lowest during the dry-to-wet transition (0.18) and highest during the wet-to-dry transition (0.42). Moreover, similar precipitation events generated markedly different chloride exports depending on watershed storage. The mean chloride load peaked under wet conditions (11.4 t), 4.2 times greater than during drought (2.7 t). These results demonstrate that watershed storage, rather than precipitation magnitude, governs event-scale chloride export by modulating hydrological connectivity and flow-path activation. The findings advance our understanding of the interplay between hydrological conditions and chloride transport processes, offering important insights for the development of effective watershed-scale salt management strategies.}
}
@article{MA2026135189,
title = {A prototype hyper-resolution groundwater digital twin for the contiguous United States: integrating physics-based modeling, machine learning, and observations},
journal = {Journal of Hydrology},
volume = {671},
pages = {135189},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135189},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426002866},
author = {Yueling Ma and Danielle Tijerina-Kreuzer and Amy Defnet and Georgios Artavanis and Laura E. Condon and Reed M. Maxwell},
keywords = {Digital twin, Decision support, Groundwater modeling, Hyper-resolution, Machine learning, Hybrid modeling, Continental Scale},
abstract = {To advance large-scale hyper-resolution groundwater modeling, we leverage existing physically-based simulation results and water table depth (WTD) observations to develop a prototype groundwater digital twin for the contiguous United States (CONUS). This framework represents a continuously updatable virtual representation that integrates observations with physics-based predictions to support operational decision making. An adjusted random forest model is trained to downscale 1 km simulation results from the integrated physically-based hydrologic model ParFlow-CLM to 1 arcsec (∼30 m) and bias-correct to observations, producing daily 1 arcsec WTD and associated uncertainties across the CONUS. Trained on water year 2003 (WY2003), the model reliably estimates temporal variations in WTD at most previously unseen grid cells, achieving a median Spearman’s ρ of 0.66. Over half of the grid cells that contain continuous daily records in WY2003 exhibit good performance, with ρ ≥ 0.5. At the subbasin scale, the digital twin captures more detailed groundwater variability than ParFlow-CLM, especially in areas with strong surface–groundwater interactions. During the future time period (WY2024), the model consistently outperforms ParFlow-CLM, increasing the median ρ by 0.13. Enabled by multi-GPU computing, the digital twin generates each daily 1-arcsec resolution WTD map in approximately 35 min of GPU time, providing insights into groundwater systems across multiple scales. The success of the physics-guided machine learning (ML) digital twin highlights the advantage of combining ML and physically-based modeling in groundwater applications. This groundwater digital twin demonstrates a path toward operational capability, enabling near-real-time monitoring, scenario exploration, and decision support at unprecedented spatial resolution.}
}
@article{DONG2026135234,
title = {A two-stage approach to evaluate parameter equifinality in build-up/wash-off stormwater quality models},
journal = {Journal of Hydrology},
volume = {671},
pages = {135234},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135234},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003318},
author = {Zhaokai Dong and Sabrina Jivani and Pradeep Goel and Clare E. Robinson},
keywords = {Urban stormwater quality, Build-up/wash-off model, Equifinality, Uncertainty, Calibration, Non-point source pollutant},
abstract = {Build-up/wash-off models are widely used in urban stormwater quality modeling to estimate pollutant loads. However, their empirical structure often introduces equifinality, the presence of multiple parameter sets yielding similar predictions, raising concerns about the robustness and physical interpretability of model outputs. In addition to structural limitations, three key modeling considerations – land use representation, pollutant type, and the temporal scale of parameter calibration – can influence equifinality. This study introduces a novel two-stage calibration-evaluation framework that integrates seasonal parameter pooling and sequential conditional/joint likelihood reweighting to examine equifinality while accounting for these factors. The framework is implemented using the Generalized Likelihood Uncertainty Estimation (GLUE) approach and applied to simulate total suspended solids (TSS), total phosphorus (TP), and soluble reactive phosphorus (SRP) loads in a mixed urban land-use catchment in London, ON, Canada. Simulation results indicate that deterministic calibration often yields parameters with limited transferability between events due to parameter equifinality. Land uses with high impervious cover were found to have relatively low equifinality, and seasonal calibration improved parameter generalizability for SRP and TP, but was less effective for TSS. The new proposed framework provides a flexible, performance-driven alternative to deterministic approaches in build-up/wash-off modeling. It enables explicit evaluation of parameter generalizability and predictive reliability under equifinality, supporting robust scenario-based stormwater quality modeling and informed decision-making.}
}
@article{KIM2026135286,
title = {Use of Gaussian mixture model for standardized precipitation index in monsoon region},
journal = {Journal of Hydrology},
volume = {671},
pages = {135286},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135286},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003835},
author = {Hyung Ju Kim and Eun-Sung Chung},
keywords = {Drought, East asian monsoon, Gaussian mixture model, Standardized precipitation index, Probability distribution},
abstract = {This study analyzed precipitation patterns across South Korea using daily data from 55 Automated Synoptic Observation System stations with over 30 years of records. The study region encompasses diverse climatic zones within the East Asian monsoon system, from coastal areas to mountainous regions, representing the full spectrum of Korea’s temperate monsoon climate variability. This study developed and evaluated a hybrid distribution selection framework for Standardized Precipitation Index (SPI) calculation that addresses the limitations of the conventional single-distribution approach in monsoon climates. This combined kernel density estimation for precipitation pattern detection with selective application of Gaussian Mixture Models (GMM) where multi-peak distributions are identified, compared against traditional Gamma and Weibull approaches across 3–24 month time scales. Results showed systematic multi-peak precipitation patterns at 76.4% of stations for 6-month duration and 69.1% for 24-month, reflecting the complex seasonal characteristics of the East Asian monsoon region. GMM substantially enhanced statistical fit in regions with the highest precipitation complexity (mean ΔAIC improvements of −8 to −9), whereas SPI-15 and SPI-18 incorporating complete annual cycles, exhibited optimal performance with the Weibull distribution. This framework provides the first systematic guidance for distribution selection in monsoon regions, demonstrating that hybrid approaches combining Weibull and GMM distributions substantially improve drought probability assessment compared to conventional single-distribution methods.}
}
@article{GOODMAN2026135242,
title = {Modeling cumulative hydrologic effects of multiple floodplain restoration projects in a 4th-order river channel network},
journal = {Journal of Hydrology},
volume = {671},
pages = {135242},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135242},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003392},
author = {Lucas M. Goodman and Durelle T. Scott and Erich T. Hester},
keywords = {Stage 0, Floodplain reconnection, River restoration, Stream restoration, Flood propagation, Flood attenuation, Watershed},
abstract = {River floodplains provide ecosystems services, including attenuation of flood risks downstream, yet rivers have been disconnected from their floodplains by human actions. River floodplain restoration approaches aim to restore such services. While applications of river restoration aim to reverse widespread degradation in large watersheds, few studies have focused on cumulative effects at the watershed or channel network scale. We used HEC-RAS to evaluate how the extent and location of floodplain restoration influence flood propagation in a generic 4th-order channel network using average parameters from the Chesapeake Bay watershed. We found that flood attenuation and floodplain exchange generally increased with the length of restored channel, but the benefits of individual projects were influenced by project location and amount of restoration already in place. To guide planning, we introduce planning curves relating project placement and extent to watershed outcomes (analogous to traditional design curves that relate project design parameters to site scale outcomes). Our results show coordinated efforts on a watershed scale can pay dividends where leeway for more substantial manipulation exists in lower-order channels that provide benefits both locally and in more constrained river corridors downstream in the network. While restoration provides flood attenuation in most of our simulations, it can unintentionally exacerbate flooding in some cases due to peak flow synchronization. This highlights the importance of future simulations that vary channel network structure, but also managing expectations in practice and the necessity for channel network models to inform permitting and planning.}
}
@article{MALASANI2026135250,
title = {Experimental study of suspended sediment transport at river confluence},
journal = {Journal of Hydrology},
volume = {671},
pages = {135250},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135250},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003471},
author = {Gopi Chand Malasani and Murali Kantharaj and Venu Chandra},
keywords = {Confluence hydrodynamic zone, Sediment mixing, Turbulence, Quadrant analysis, Sediment fluxes},
abstract = {River confluences are critical nodes in fluvial networks, significantly influencing flow dynamics, sediment transport, and overall river morphology. However, the suspended sediment transport at river confluence and its dependence on complex hydro-morphology is rarely studied. The present study investigates the flow and sediment transport dynamics within a 90° river confluence model under varying discharge ratios. Detailed measurements of 3D velocity, turbulence, and suspended sediment concentration were conducted in a laboratory flume. Results reveal that the shear layer significantly influences the spatial distribution of flow and sediment transport parameters. Elevated levels of turbulent kinetic energy and Reynolds shear stress are observed within the shear layer, indicating intense mixing and energy dissipation. The shear layer also acts as a barrier for sediment mixing, separating regions with distinct sediment concentrations from main channel and tributary. The analysis of sediment fluxes reveals that longitudinal sediment fluxes are dominant, but significant lateral and vertical components are also present, particularly within the shear layer and flow separation zones. Further, study of coherent structures using quadrant analysis revealed that ejection and sweep events dominate in the flatbed and scour hole regions, whereas interaction events dominate in sediment bar. The study contributes to understanding of sediment dynamics at river confluence, highlighting the importance of 3D flow field and turbulence. These results have implications for ecological health and infrastructure design in riverine environments.}
}
@article{CHEN2026135258,
title = {Combined effect of tides, irregular waves and beach recovery on groundwater flow and marine-sourced salt transport in coastal unconfined aquifers},
journal = {Journal of Hydrology},
volume = {671},
pages = {135258},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135258},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003550},
author = {Weilun Chen and Jun Kong and Jun Wang and Saihua Huang and Huawei Xie and Chao Gao},
keywords = {Irregular waves, Beach recovery, Groundwater flow, Salt transport, Numerical modeling},
abstract = {Based on three generalized beach profiles, this study utilizes a numerical modeling approach to investigate the combined effect of tides and irregular waves on groundwater dynamics and marine-sourced salt transport during beach recovery. Compared to tidal-only conditions, the inclusion of non-overtopping waves amplifies differences between berm profile and storm profile in upper saline plume (USP) features (area and salt content), salt-freshwater mixing zones. With overtopping waves, these differences are further magnified due to high-salinity zones formed by infiltration of ponding water in backshore depressions behind berms. Particle tracking shows that wave action introduces additional deceleration phases in particle movement, leading to more complex travel speed distributions. Furthermore, overtopping waves intensify water and salt exchange across the aquifer, elevating intertidal saline infiltration (ISI) and submarine groundwater discharge (SGD) by up to 1,248% and 182%, respectively. This research underscores the critical role of wave overtopping in enhancing subsurface mixing and solute transport during beach recovery, with important implications for managing seawater intrusion in vulnerable shorelines.}
}
@article{WANG2026135230,
title = {Spatial evolution and attribution of aquatic community dynamics to ecohydrological drivers in a semi-arid river basin based on a niche-based metacommunity dynamics model},
journal = {Journal of Hydrology},
volume = {671},
pages = {135230},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135230},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003276},
author = {Donghua Wang and Limin Duan and Siyi Chen and Yuhao Qiu and Canyang Guo and Yanyun Luo and Yibo Wang and Pan Liu and Ruizhong Gao and Bing Sun and Guoqiang Wang and Tingxi Liu},
keywords = {Metacommunity dynamics model, Ecohydrological drivers, Attribution analysis, Biotic interactions, Semi-arid river basin},
abstract = {Ecohydrological processes are undergoing significant reorganization under environmental stress, complicating process-based attribution of biological responses to hydrological and water quality conditions. Focusing on the Dahei River (a semi-arid Yellow River tributary), this study investigates the coupled dynamics of hydrology, water quality, and aquatic communities along the longitudinal gradient. The MDM was applied to partition the explanatory power of hydrological, water quality, and biotic variables, while characterizing longitudinal connectivity using Cumulative Dispersal Volume (CDV) and Relative Dispersal Potential (RDPI). Quantile regression estimated key niche parameters, including environmental optima, niche breadths, and interspecific interaction coefficients. Results indicate that planktonic communities exhibit broader niche breadths and higher adaptability than zoobenthos, which show greater sensitivity to environmental disturbances. Model performance was higher for plankton than zoobenthos, reflecting their contrasting associations with hydrological variability. A longitudinal “upstream output–downstream input” pattern was captured, with zooplankton demonstrating the highest spatial exchange potential. Attribution analysis indicates that biotic interactions account for substantial explanatory power, while associations with hydrological and water quality variables vary among groups: planktonic communities show higher sensitivity to water quality, whereas zoobenthos respond more strongly to hydrological alterations. Hydrological influence intensifies downstream, while water quality effects are more pronounced midstream, reflecting heterogeneous ecohydrological patterns. These findings deepen the understanding of multi-dimensional coupling among hydrology, water quality, and aquatic communities, demonstrate the robustness of the MDM framework in process-based attribution, and offer a process-oriented perspective for resolving ecohydrological complexity in water-stressed river systems.}
}
@article{YE2026135282,
title = {Leveraging water vapor to extend forecast horizons for forecast-informed reservoir operations: a vapor-precipitation-streamflow three-line defense},
journal = {Journal of Hydrology},
volume = {671},
pages = {135282},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135282},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003793},
author = {Hao Ye and Pan Liu and Xiaojing Zhang and Lei Cheng and Weibo Liu and Qian Cheng and Lei Guo and Jing Huang},
keywords = {Precipitable water vapor, Precipitation, Streamflow, Forecast-informed reservoir operations, Dynamic control},
abstract = {Forecast-informed reservoir operations (FIRO) have improved the efficiency of floodwater utilization by leveraging hydrometeorological forecasts. However, current precipitation-streamflow (PS) FIRO schemes rarely consider precipitable water vapor (PWV), which can provide early signals of precipitation. To address this issue, a vapor-precipitation-streamflow (VPS) FIRO scheme is proposed to extend forecast horizons by leveraging PWV. VPS-FIRO is informed by potential precipitation (PP) derived from water vapor based on the atmospheric water balance. VPS-FIRO then estimates potential flood volumes and performs prerelease operations with PP. Thus, the forecast lead time is extended with a robust estimation of potential floods. The Jiaokou Reservoir in Zhejiang Province, China, is selected as a case study to evaluate VPS-FIRO using historical floods. Results show that (1) PP provides a reliable upper bound for precipitation, with a maximum precipitation-to-PP ratio of 0.86; (2) the prerelease under VPS-FIRO is 24 h earlier than under PS-FIRO; and (3) the mean volume of spilled water at the Jiaokou Reservoir is reduced by 5.6% compared to PS-FIRO, and the duration of exceeding maximum prerelease outflow decreases from 1% to 0.3% under VPS-FIRO. Overall, this study presents a methodology for integrating vapor to extend forecast horizons and enhance floodwater utilization through a VPS three-line defense approach.}
}
@article{WU2026135238,
title = {A two-level attribution method for water resource changes based on water budget balance and distributed simulation},
journal = {Journal of Hydrology},
volume = {671},
pages = {135238},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135238},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003355},
author = {Qingsong Wu and Hao Wei and Xing Yuan and Lu Lu and Shengqi Jian and Jiawei Li},
keywords = {Two-level attribution, Climate change, Distributed human-water relationship model, Dualistic water cycle, Runoff change, Water budget balance},
abstract = {Attribution of water resource changes is crucial for revealing the evolutionary laws of water resource systems and improving the efficiency of water resource management. This study conducts systematic research through theoretical interpretation, methodological development and case application. First, the water balance principle and water budget balance theory are integrated to clarify an attribution framework centered on the water cycle process. Second, a water budget balance equation and a distributed human-water relationship model covering the entire “input-transformation-consumption-output” chain are constructed. Third, a two-level attribution system is established by coupling the balance equation, distributed model, control variable method and contribution rate quantification: the first level quantifies the driving contributions of climate change and human activities to changes in natural runoff; the second level analyzes the driving effects of precipitation, incoming surface runoff, natural evapotranspiration, human water consumption, external transferred water and water storage on actual runoff changes. Finally, the method is applied to the Qin River Basin in China across multi-temporal (multi-year average, annual, monthly) and spatial (entire basin, basin divisions) scales. Results show that the method integrates multi-source information to clarify the driving mechanisms of water resource changes, with strong effectiveness and applicability across scales; basin runoff changes during 2001–2022 were dominated by climatic factors, while human activities promoted natural runoff increase but reduced actual runoff; the basin’s natural runoff decreased by 0.982 × 108 m3 when comparing the periods 2001–2010 and 2011–2020, with the contribution rates of climate change and human activities being −118.0% and 18.0%, respectively; the combined effects of reduced precipitation, decreased natural evapotranspiration, increased human water consumption, increased external transferred water, and increased water storage led to a 0.508 × 108 m3 decrease in actual runoff, with the corresponding contribution rates of −47.3%, 276.4%, −173.5%, −1.1%, and −154.5%. The primary novelty lies in a hierarchical framework that distinguishes between natural and actual runoff drivers, providing finer attribution resolution compared with conventional methods.}
}
@article{LI2026135290,
title = {Radon tracing to identify water sources in karst springs during rainstorm events},
journal = {Journal of Hydrology},
volume = {671},
pages = {135290},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135290},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003872},
author = {Zhijie Li and Guanghui Jiang and Fang Guo and Fan Liu and Liqiong Wei and Qigang Wang},
keywords = {Extreme rainfall, Peak cluster depression, Hydrograph separation, Radon activity, Karst spring},
abstract = {Understanding rapid hydrological responses of karst systems at the storm-event scale remains a key challenge in hydrological research. However, tracer approaches that can be reliably applied to storm processes under natural conditions remain limited. The natural radioactive tracer 222Rn has been widely used to investigate groundwater–surface water exchange and water-body mixing. Its application at the storm-event scale, however, has received comparatively little attention. Consequently, the applicability of 222Rn during extreme rainfall events requires systematic evaluation. The Guilin peak-cluster depression in southern China is characterized by thin and discontinuous soils, well-developed conduit networks, and strong hydraulic connectivity between surface depressions and springs. These features lead to rapid and spatially heterogeneous recharge responses. In three rainstorm events, high-frequency monitoring of 222Rn activity in spring discharge was conducted and combined with hydrochemical indicators. A three–end-member mixing model was applied to analyze storm-driven recharge processes and the relative contributions of different water sources. The results show that storm events drive clear shifts in runoff components in spring discharge. Event water rapidly becomes a major component of spring flow. The proportion of conduit-dominated event water is sensitive to rainfall characteristics and, under highly intense rainfall conditions, it can account for up to approximately 70% of total discharge at peak flow. In contrast, percolation-dominated event water exhibits relatively stable contributions, typically ranging between 10% and 30%. Storm-scale variations in 222Rn activity clearly distinguish the responses of two different recharge pathways, demonstrating that 222Rn is an effective natural tracer for resolving storm-driven recharge processes in small, fast-responding karst systems.}
}