@article{ALONSO2026136309,
title = {Coastal aquifer vulnerability to salinization under sea-level rise and groundwater abstraction pressure in a Mediterranean karst system},
journal = {Journal of Hydrology},
volume = {679},
pages = {136309},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136309},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601406X},
author = {R. Álvarez Alonso and P.A. Robledo Ardila and C.A. Melo Aguilar and J.J. Durán Valsero and R. Morales and S. Martínez Pérez},
keywords = {Coastal karst aquifers, Groundwater abstraction pressure, Coastal aquifer vulnerability, Sea-level rise, Groundwater salinization, Seawater intrusion},
abstract = {Sea-level rise and groundwater abstraction are reshaping coastal systems in karst environments, particularly in low-gradient coastal plains where groundwater-dependent ecosystems are strongly coupled to aquifer dynamics. However, most coastal assessments remain based on topographic inundation and shoreline retreat, neglecting groundwater processes that influence the inland propagation of marine influence. This study presents a GIS-based hydro-coastal vulnerability screening framework designed to identify areas potentially influenced by the combined effects of sea-level rise and groundwater stress. The approach integrates (i) DEM-based potential marine inundation, (ii) hydrogeological signals of piezometric decline and salinization derived from monitoring data, and (iii) a multi-criteria hydro-coastal vulnerability index incorporating ecological sensitivity, hydrogeological susceptibility, anthropogenic pressure, and system resilience. Direct potential marine inundation alone affects between 9.24 and 43.76 km2 (0.25–1.20% of the island) across sea level rise scenarios but underestimates the inland extent of coastal influence. Including groundwater indicators identifies a broader scenario-based coastal influence zone and increases ecosystem exposure, with up to 97% of wetland area potentially exposed within the integrated coastal-influence zone under high-end scenarios. Vulnerability is concentrated in low-lying coastal plains, particularly in s’Albufera, Campos–Es Trenc, and Albufereta, where strong aquifer–sea connectivity and anthropogenic pressure converge. These findings suggest that coastal evolution in Mediterranean karst settings emerges from the interaction between surface and groundwater processes and highlight that hydrogeologically informed regional screening approaches may identify coastal areas extending beyond static representations of the MTPD, thereby informing future coastal-domain management rather than redefining regulatory boundaries.}
}
@article{ZHAO2026136314,
title = {Optimal layout of LID facilities at an urban basin scale in piedmont cities: Case study of Jinan City, China},
journal = {Journal of Hydrology},
volume = {679},
pages = {136314},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136314},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014113},
author = {Yanjun Zhao and Jun Xia and Zongxue Xu and Lei Cheng and Gang Zhao and Xiang Zhang},
keywords = {Urban floods, TVGM-USWM model, LIDs, Cost-effectiveness, Piedmont cities, Sponge city},
abstract = {Urban flooding has become an urgent issue for cities around the world, endangering human life and property. Piedmont cities have a special topography and complicated overland flow processes, thus creating challenges for the spatial optimization of LID facilities. We developed an urban hydrological model by coupling the TVGM-USWM and SWMM-LID module, considering various LID facilities and flow routing in urban drainage systems. We applied this model to the Huangtaiqiao drainage basin in Jinan City, which is one of China’s first pilots for sponge city construction. The NSGA-II algorithm was combined with the urban hydrological model to investigate the most cost-effective flood reduction scheme of LID facilities under different design rainfall processes. Results showed that: (1) The five LID facilities provided by the model were effective in reducing runoff volume and peak flow, thus demonstrating the model’s applicability; (2) There was a non-linear correlation between flood reduction rate and economic costs, with the cost-effectiveness of LID facilities decreasing when the design rainfall return period increased; and (3) PP and RB generated better economic returns in both RV and RP. LIDs in the PSA were more cost-effective under different design rainfall events, particularly GR in RP. Moreover, the study can provide LID layout schemes that either maximize flood reduction for a given economic cost, or minimize the economic cost for a given level of flood reduction. The findings of this study could provide the scientific decision-making for LID spatial layouts at the urban basin scale in piedmont cities.}
}
@article{LUO2026136330,
title = {Global assessment of river flow regimes simulated by reach-level streamflow datasets},
journal = {Journal of Hydrology},
volume = {679},
pages = {136330},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136330},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014277},
author = {Qiuyu Luo and Xiaomang Liu and Kaiwen Wang and Peng Bai and Zelong Yang and Ye Jing and Changming Liu},
keywords = {Streamflow, River regime, Reach-level, Dataset performance, Kling-Gupta Efficiency},
abstract = {Global river flow regimes reflect riverine environmental conditions and are essential for sustaining natural ecosystems and human socio-economic systems. Recent advances in reach-level streamflow datasets have enabled spatiotemporally continuous representation of river flow, more closely reflecting real-world river networks than previous coarse grid-scale approximations. Assessment of these reach-level datasets is a prerequisite for their broad application, yet, existing assessments predominantly focus on their agreement with daily observations, overlooking their ability to capture multi-dimensional flow regime characteristics. Here, we assessed the performance of three reach-level datasets, namely the Global Reach-Level Flood Reanalysis (GRFR), the Global River Discharge Reanalysis (GRDR), and the Global Daily Reach‐Level River Discharge Data Set Based on Grid LSTM‐RAPID (GRADES-hydroDL). Using these datasets, we derived 38 streamflow indices across five flow regime dimensions (i.e., streamflow magnitude, frequency, duration, timing, and variability) and evaluated them against observations from 4,698 hydrological stations worldwide via different statistical methods. Using the Kling-Gupta Efficiency (KGE) across streamflow indices, we find that GRADES-hydroDL outperforms the other datasets but remains limited in capturing low-flow magnitude and in frequency and duration characteristics (KGE as low as − 0.11). Further decomposition of KGE into its three components reveals that performance loss can be largely attributed to temporal correlation and mean flow bias. Additional analyses of intermittent rivers show that all datasets consistently underestimate hydrological intermittency, although GRDR performs comparatively better. These findings provide guidance for selecting reach-level datasets based on their performance across different flow regime dimensions.}
}
@article{ZHOU2026136382,
title = {Duration-conditioned temporal profiles and synchronization networks reveal regional organization of midlatitude precipitation events},
journal = {Journal of Hydrology},
volume = {679},
pages = {136382},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136382},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014794},
author = {Chun Zhou and Li Zhou and Luca Brocca and Xiaojun Guo and Ting Chen and Jiajia Yue and Keying Liu and Ming Li},
keywords = {Hourly precipitation, Precipitation events, Within-event rainfall structure, Event synchronization, Extreme precipitation events},
abstract = {Short-duration precipitation events are important drivers of flash floods and urban pluvial flooding, yet broad-scale comparisons of their within-event temporal structure and spatial coordination remain limited. We analyse quality-controlled hourly rain-gauge observations from the contiguous United States, selected European countries and Japan using a consistent event-based framework. Events are grouped by duration and characterized by peak-normalized within-event rainfall profiles; spatial coordination is evaluated with event-onset synchronization networks; and extreme events are analysed separately using regional 95th-percentile thresholds for peak intensity, event total and duration. Under the baseline 3 h minimum inter-event time, short- and medium-duration events account for 84.6% of the catalogue, whereas longer events are less frequent but more persistent. Short-duration events are widely represented, whereas longer-duration events show more localized areas of high station-level fraction. Network structure is strongly conditioned by gauge availability, and reference-density matching substantially reduces cross-domain differences in network degree. Over the region-specific effective analysis periods, Europe shows significant positive fitted slopes in extreme-event frequency and magnitude diagnostics, Japan shows no significant temporal changes, and the United States shows a significant decline only in extreme-event frequency. The extreme-event subset shows substantial regional overlap in principal component analysis space but distinct intensity–duration scaling: the Japanese station centroid is shifted toward higher scores on the magnitude-related second principal component, Japan shows the strongest increase in event total with duration, and the United States shows the steepest decline in peak intensity. These results provide a consistent event-based description of regional precipitation organization from hourly observations.}
}
@article{LI2026136358,
title = {Grounding large language models in hydrologic modelling},
journal = {Journal of Hydrology},
volume = {679},
pages = {136358},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136358},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014551},
author = {Yingjia Li and Shiruo Hu and Feng Zhang and Xinpeng Yu and Wei Luo and Dingxiao Liu and Bin Xu and Jianshi Zhao},
keywords = {Multi-agent architecture, Time series forecasting, Automated machine learning, Agentic workflow},
abstract = {Although large language models (LLMs) possess extensive hydrological knowledge, they often struggle to appropriately simulate complex physical processes in hydrological systems. To address this limitation, we present an LLM-based agentic intelligent modelling approach for hydrological time-series forecasting (HydroAIM). HydroAIM decouples the multi-agent architecture through the model context protocol (MCP) to integrate an expert task workflow, a standardised algorithmic workflow (SAW) library, and an iterative feedback closed-loop execution toolbox. Comprehensive experiments demonstrated that across 125 modelling tasks of varying types utilising five LLMs, HydroAIM achieved an execution success rate of 92.8%. Ablation studies have revealed that removing the expert task workflow causes complete system failure owing to planning chaos, plummeting the success rate to 0%. This result indicates that long-horizon task planning is the core bottleneck restricting LLMs from executing hydrological modelling tasks. Furthermore, when applied to 531 catchments in the Catchment Attributes and Meteorology for Large-sample Studies (CAMELS) dataset without human intervention, HydroAIM achieves median Nash-Sutcliffe efficiency (NSE) values of 0.58 and 0.73 for local and global modelling, respectively, achieving usable modelling performance. This study demonstrates that, when properly supported and constrained, LLM-based agents can be effectively grounded in automated hydrological modelling, providing a scalable pathway for quantitative tasks in specialised scientific domains.}
}
@article{VITALE2026136306,
title = {Hydrologic and economic performance of groundwater-conservation policies for agricultural and residential water use in the Oklahoma Ogallala Aquifer},
journal = {Journal of Hydrology},
volume = {679},
pages = {136306},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136306},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014034},
author = {Jeffrey D. Vitale and Frank A. Ward},
keywords = {Ogallala Aquifer, Groundwater conservation, Hydroeconomic modeling, Pumping allocation, Agricultural–urban water use},
abstract = {Groundwater depletion threatens irrigated agriculture and rural household water security across the High Plains, yet the hydrologic and economic consequences of alternative pumping institutions remain poorly resolved at county scale. This study develops a spatially disaggregated hydroeconomic optimization model for agricultural and residential groundwater use in seven Oklahoma counties overlying the Ogallala Aquifer during 2016–2021. The framework integrates county-specific aquifer geometry, measured water-level trends, pumping depths, crop acreage, evapotranspiration, crop prices, household demand, and groundwater pumping costs. Positive mathematical programming calibrates agricultural land and water use to observed conditions, while a calibrated inverse-demand system represents residential use. Five institutional regimes are compared: unrestricted pumping, cap-and-trade, proportional cap-and-share, urban-priority allocation, and irrigation-priority allocation. The four conservation scenarios impose the same terminal water-table target and the same stress-test assumption of one-half of the calibrated recharge flux; therefore, comparisons among the four conservation rules isolate allocation effects, whereas differences from the unrestricted baseline reflect both the tighter terminal target and the lower recharge assumption. Under cap-and-trade, cumulative irrigation pumping falls from about 3.48 to 2.14 million acre-feet, while most residential use is preserved. Cap-and-share achieves a similar terminal outcome but imposes larger economic costs in several counties. Urban priority nearly preserves historical residential use, whereas irrigation priority transfers most shortages to households. County outcomes vary because of differences in saturated thickness, pumping depth, irrigated acreage, crop mix, and measured decline. The findings show that, under a common conservation stress test, institutional rules strongly affect where pumping reductions occur and who bears their economic cost.}
}
@article{TIAN2026136322,
title = {The influence of hydrophobic agent on unsaturated seepage mechanisms in silty clay: insights from electrical resistivity monitoring},
journal = {Journal of Hydrology},
volume = {679},
pages = {136322},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136322},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014198},
author = {Jiayi Tian and Deliang Ma and Xiaoliang Yao and Teng Li and Tianyang Lan and Dongliang Ji and Huaiping Feng},
keywords = {Hydrophobic soil, Unsaturated hydraulic conductivity, Resistivity monitoring, Transient profile method},
abstract = {Hydrophobic modification represents a promising approach to limiting water ingress into geotechnical structures. During water migration, soil hydrophobicity and water content interact dynamically, rendering barrier performance moisture dependent and difficult to characterize using conventional equilibrium based methods. To address this limitation, a soil column apparatus integrating multilevel electrical resistivity monitoring with the transient profile method was developed to continuously monitor water infiltration in hydrophobic soil and determine unsaturated hydraulic conductivity. One dimensional infiltration tests were conducted on silty clay specimens with n-octyltriethoxysilane (OTES) contents of 0–0.8%, and resistivity measurements were used to reconstruct volumetric water content profiles. The sequential resistivity responses at different height levels captured the upward propagation of the wetting front. Increasing OTES content delayed initiation onset, prolonged the time required to reach moisture equilibrium, reduced equilibrium volumetric water content, and increased spatial differences in water content along the soil column. OTES treatment reduced hydraulic conductivity by approximately one order of magnitude. A modified content-dependent Gardner (C-G) model was established by relating the Gardner parameters to OTES content. The proposed framework enables continuous, non-destructive monitoring of water migration and determination of unsaturated hydraulic conductivity in hydrophobic soils.}
}
@article{WIRTHENSOHN2026136350,
title = {Learning water diversion behaviour in regulated river networks using graph neural networks and neural decision trees},
journal = {Journal of Hydrology},
volume = {679},
pages = {136350},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136350},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014472},
author = {Moritz Wirthensohn and Ye Tuo and Markus Disse},
keywords = {Graph attention networks, Deep learning, Human water management, Operational rule learning, Hybrid modelling, Interpretability},
abstract = {Human water diversions alter river dynamics and are difficult to represent when operational rules are uncertain or discontinuous. This study investigates how graph-based deep learning models represent diversion behaviour in river networks under varying degrees of prior operational knowledge. Using SWAT+ simulations as an internally consistent synthetic benchmark, we design controlled diversion scenarios of increasing rule complexity. We compare graph attention networks that embed river network topology and diversion connectivity directly into their model structure, with no prior operational information, with partial structural constraints, with fully prescribed rules applied in post-processing, and with a hybrid architecture that explicitly separates hydrological prediction from operational decision-making via a Neural Decision Tree. All approaches reproduce total flow before diversion robustly, while diverted flow skill declines with operational complexity. Additional operational knowledge does not consistently improve predictive accuracy, as diversion errors are dominated by propagation from total-flow uncertainty. The hybrid model achieves comparable skill while providing explicit and analysable decision representations, highlighting trade-offs between flexibility, robustness, and interpretability. The modular and structurally explicit formulation illustrates how graph-based AI components can support transparent and interpretable representations of operational decision-making in regulated river systems, though validation across diverse catchments and real-world operational conditions remains necessary.}
}
@article{SCRINZI2026136342,
title = {Multivariate and hydrochemical assessment of rivers and groundwater in the Mediterranean Besòs basin (Spain)},
journal = {Journal of Hydrology},
volume = {679},
pages = {136342},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136342},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014393},
author = {Luciana Scrinzi and Anna Jurado and Sandra Pérez and Estanislao Pujades-Garnes},
keywords = {Groundwater, Surface water, Multivariate analysis, Hydrochemistry, Land use},
abstract = {In the context of climate change, integrated strategies to preserve water quantity and quality in Mediterranean basins are increasingly needed. Here, we investigate hydrochemical patterns of rivers and aquifers in the Besòs basin (NE Spain) and assess how hydrological variability influences these patterns at basin scale. Long-term monitoring data (2007–2024) from river stations and wells were analysed using site-level median concentrations of major ions and nutrients, wet-dry contrasts, flow and groundwater level time series, and multivariate statistical analyses. Groundwater shows higher Ca2+, HCO3- and NO3- concentrations, particularly in forested and agricultural areas, consistent with recharge and carbonate mineralization. Lower concentrations in wells close to rivers are consistent with groundwater-river interactions, including groundwater discharge and local mixing along losing reaches. River waters display higher pH and lower geogenic solute concentrations, consistent with groundwater influence and dilution by runoff. Spatial salinity patterns in both compartments are associated with Na+, Cl- and K+ inputs from urban and industrial land use and with dilution capacity. In impacted sites, Na+ and Cl- may dominate over Ca2+ and HCO3- and are often accompanied by higher TOC and PO43-. Rivers’ salinity-related ions increase during low-flow periods, sometimes exceeding groundwater concentrations, whereas concentrations decrease during high-flow periods indicating rainfall-driven dilution. Groundwater-related ions show limited sensitivity to hydrological variability, consistent with a buffered origin. Overall, groundwater-river connectivity and land use are associated with spatial hydrochemical patterns, while hydrological variability modulates dilution and anthropogenic influence.}
}
@article{LIU2026136079,
title = {Numerical modeling of redox-sensitive transformations in a dynamic capillary fringe},
journal = {Journal of Hydrology},
volume = {679},
pages = {136079},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136079},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011765},
author = {Xin Liu and Zengyu Zhang and Alex Furman},
keywords = {Nitrogen, Carbon, Redox potential, Capillary fringe, Multiple-Monod kinetics, Butler-Volmer equation},
abstract = {Subsurface contamination is a significant problem due to excessive fertigation and wastewater discharge. However, depth and spatial extent often make it difficult to understand the nature of contaminant spread and its attenuation. Numerical modeling is an essential tool for exploring less-understood processes. However, there is a gap in the systematic simulation of the relationship between biogeochemical processes and redox potential, a relatively straightforward measure of subsurface biogeochemical state. Thus, a model is needed to facilitate an understanding of subsurface processes and provide a further theoretical basis for practice. This research aims to simulate subsurface biogeochemical dynamics and their correlation with redox potential. Water flow and biogeochemical dynamics are considered in both physical and biogeochemical models, incorporating the biogeochemical cycles of C, N, O, Mn, Fe, and S. The physical and biogeochemical models are coupled with the redox potential model addressed by the Butler-Volmer equation. A synthetic case study that mimics the conditions in a dynamic capillary fringe under a soil-aquifer treatment (SAT) facility was used to demonstrate the model. We demonstrate that the redox potential can reflect redox species concentrations (i.e., oxygen and nitrate) and reaction rates (i.e., nitrification, denitrification, and DOC aerobic oxidation), because the intrinsic mechanism of this model is superior to traditional simplified models. In our mechanistic model, both redox reactions and potentials are governed by multiple redox species and parameters, and the simulation can be adjusted by varying these parameters, making it more suitable for dynamic systems. This is especially important when saturation conditions change frequently. Further, we demonstrate that nitrification, denitrification, and DOC oxidation coexist at different depths, and that flow dynamics can dictate reaction rates and the depths at which they occur.}
}
@article{YE2026136334,
title = {Groundwater data assimilation under prior misspecification: A comparative study of state-of-the-art methods},
journal = {Journal of Hydrology},
volume = {679},
pages = {136334},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136334},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014319},
author = {Yuxin Ye and Jiangjiang Zhang and Lei Yao},
keywords = {Groundwater modeling, Data assimilation, Non-Gaussianity, Prior misspecification, Aquifer},
abstract = {Data assimilation (DA) is a key tool for parameter estimation and uncertainty quantification in groundwater modeling. For high-dimensional groundwater DA problems, the ensemble smoother with multiple data assimilation (ESMDA), the iterative local updating ensemble smoother (ILUES), and the deep-learning-based ensemble smoother (ES(DL)) can be employed under different problem settings and assumptions. These methods are commonly formulated within a Bayesian framework, in which performance depends strongly on the proper specification of prior information, observation operators, and error statistics. In practice, however, prior misspecification is often unavoidable because of incorrect assumptions about parameter ranges, spatial structures, and probability distributions, yet its impact on groundwater DA performance remains poorly understood. Here, this study presents a systematic evaluation of groundwater DA under diverse prior misspecification scenarios. Specifically, this study considers a challenging joint inversion problem involving eight contaminant source parameters and a 3321-dimensional heterogeneous hydraulic conductivity field, constrained by limited and weakly informative observations of hydraulic head and contaminant concentration. The performances of ESMDA, ILUES, and ES(DL) are examined under various types of prior misspecification. The results show that prior misspecification can degrade assimilation performance for all three methods, while their relative robustness depends on the inversion target, evaluation metric, and the type and severity of prior misspecification. These findings highlight both the critical role of prior misspecification in groundwater DA and the importance of selecting appropriate DA methods based on specific inversion objectives and prior conditions.}
}
@article{CHENG2026136386,
title = {Impacts of submarine groundwater discharge on inland and seaside basins of estuaries},
journal = {Journal of Hydrology},
volume = {679},
pages = {136386},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136386},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014836},
author = {Qinbo Cheng and Yuyang Cai and Rongjiang Yao and Wenping Xie and Tianping Xu and Bradley A. Weymer and Xuan Yu},
keywords = {Submarine groundwater discharge, Estuary hydrodynamics, Salinity, Surface water-groundwater interactions, Residence time, Particle tracking},
abstract = {The interface between terrestrial aquifers and coastal water bodies, commonly described as a subterranean estuary, is increasingly recognized as an important pathway for freshwater and solute transport. Although the biogeochemical significance of submarine groundwater discharge (SGD) has been widely documented, the influence of groundwater–estuary exchange on estuarine hydrodynamics remains underrepresented in many surface-water modeling approaches. This study uses coupled surface water–groundwater modeling to quantify how a permeable-bed representation affects salinity, tidal storage, and transport across eight synthetic estuary types and three tidal amplitudes. Paired permeable- and impermeable-bed simulations used the same total freshwater input, although freshwater was delivered through the subsurface in the permeable cases and through the surface domain in the impermeable cases. The impermeable-bed simulations consistently produced higher estuarine salinity: in the reference tidal case, mean salinity ranged from 14.7 to 32.1 g/L, whereas the coupled permeable-bed representation reduced mean salinity by 0.1 to 8.8 g/L across estuary types. Permeable sediments also delayed the tidal response of inland-basin water storage, indicating that shallow subsurface exchange provides distributed transient storage that modifies basin filling and drainage. Particle-tracking diagnostics further showed that groundwater–estuary exchange alters transport pathways and residence behavior, with effects that depend strongly on estuary morphology and basin connectivity. These results show that treating the estuary bed as a no-flow boundary can bias predictions of salinity, residence behavior, and exchange pathways, with consequences for nutrient budgets, contaminant transport, and eutrophication management.}
}
@article{GENG2026136378,
title = {CO2 migration and storage in layered saline aquifers: effects of vertical high-permeability channel width},
journal = {Journal of Hydrology},
volume = {679},
pages = {136378},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136378},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014757},
author = {Wenyu Geng and Ke Chen and Jingru Zhang and Weiming Cheng and Yi Zhang and Lanlan Jiang and Yongchen Song},
keywords = {CO storage, Saline aquifers, CO leakage, Density-driven convection, Salt precipitation, Numerical simulation},
abstract = {Deep saline aquifers in offshore regions are key storage sites for large-scale CO2 geological sequestration. However, multiple low-permeability cap rocks and localized high-permeability channels can strongly influence CO2 migration pathways and storage safety. This study addresses the limited understanding of the coupled effects of high-permeability channels on CO2 migration and multiple trapping mechanisms in multi-layer cap rock conditions. A two-dimensional numerical model based on geological characteristics in a South China Sea region was developed, and CO2 migration was systematically studied using CMG-GEM under two different vertical high-permeability channel widths (10 m and 50 m). The results show that channel width has a coupled influence on CO2 migration mechanisms: a 50 m wide channel accelerates pressure propagation and promotes horizontal CO2 migration (before entering the channel), while a 10 m wide channel exhibits a stronger flow focusing effect, enhancing vertical gas migration. The channel width significantly controls the accumulation and lateral diffusion of CO2 beneath different cap rocks, affecting the proportions of structural, dissolution, and residual storage. Salt precipitation occurs similarly across both scenarios but is more pronounced with wider channels, with the maximum reduction in porosity being approximately 0.076% for the 10 m channel and 0.11% for the 50 m channel, leading to a permeability decrease of about 0.23% and 0.33%, respectively. The impact on overall reservoir flow capacity is minimal. This study provides a quantitative assessment of the coupled effects of high-permeability channel width on CO2 sequestration, offering valuable insights for impact assessment and long-term safety analysis in offshore saline aquifer CO2 storage.}
}
@article{CHO2026136346,
title = {Toward transferable flash flood oriented high flow prediction in ungauged basins using a decoupled physics–DL framework},
journal = {Journal of Hydrology},
volume = {679},
pages = {136346},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136346},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014435},
author = {Hyunjin Cho and Hyojun Bak and Gunhaeng Lee and Changhwan Kim and Hyejin Park and Dae-Hong Kim},
keywords = {Flash flood prediction, Ungauged basin, Regionalization, Dynamic wave-based instantaneous unit hydrograph, Transferability},
abstract = {Accurate flash flood prediction in ungauged basins remains a fundamental challenge. Process-based models often require extensive site-specific calibration, whereas end-to-end deep-learning (DL) models may lack physical consistency and can be difficult to transfer to ungauged settings. To address these limitations, we propose a decoupled physics–DL framework that separates the rainfall–runoff process into two components: physics-based surface runoff routing and a DL-based estimation of event-scale effective rainfall. Surface runoff was routed using a dynamic wave-based instantaneous unit hydrograph (DIUH) derived a priori from topographical and land-cover information, whereas rainfall losses were estimated by a multilayer perceptron (MLP) trained as a regionalization model using basin descriptors and rainfall event characteristics. The framework was evaluated using data from 62 basins in South Korea under a strict pseudo-ungauged design, in which 15 target basins were divided into three folds of five basins and each fold was withheld in turn for blind evaluation. In this evaluation, the framework achieved a median critical success index (CSI) of 0.50 under the strictest warning criteria, with the CSI increasing under more relaxed tolerance settings, and a median Kling–Gupta efficiency (KGE) of 0.75 for stage-hydrograph reproduction. The SHapley Additive exPlanations (SHAP) analysis further indicated that the MLP module produced statistically interpretable predictor–response patterns that were broadly consistent with the hydrological expectations. These results show that combining physics-based routing with regionalized DL hydrological loss estimations provides an effective and interpretable approach for flash flood oriented high flow prediction in pseudo-ungauged basins without local calibration in temperate monsoon-driven basins.}
}
@article{WANG2026136398,
title = {Optimizing evapotranspiration products by merging multi-source datasets with three no-prior-knowledge methods over China},
journal = {Journal of Hydrology},
volume = {679},
pages = {136398},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136398},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014952},
author = {Dayang Wang and Dagang Wang and Xiaogang Shi and Shaobo Liu and Mingfei Ji and Ya Huang and Zequn Lin and Kaihao Long and B. {Larry Li} and Haoyu Wang},
keywords = {Evapotranspiration, Data fusion, No-prior-knowledge, Multi-source datasets, China},
abstract = {Accurate quantification of evapotranspiration (ET) is critical for understanding the hydro-climatologic processes and the interactions of the Earth system. Due to considerable uncertainties in single algorithm-based ET products, data fusion provides a promising pathway for improving ET estimation. In this study, we proposed a data fusion framework for optimizing ET products by merging four ET datasets (i.e., ERA5-Land, GLDAS, GLEAM and SiTH) using three fusion methods (i.e., ensemble mean (EM), Bayesian-based three-cornered hat (BTCH) and extended triple collocation (ETC)) without prior knowledge. Twelve fused ET datasets were generated, and their performances were comprehensively evaluated at both site and basin scales. Results show that merged ET datasets generally demonstrate better performances than the original ET datasets in most sites and basins, with lower mean bias error (MBE) and relative root mean square error (RRMSE), and higher coefficient of determination (R2) and Kling-Gupta efficiency (KGE). At the site scale, the greatest improvement occurs at cropland and barren sites, whereas the modest modification appears at forest and grassland sites. At the basin scale, the overestimation in the Songhua River Basin (SHRB) and Liao River Basin (LRB), and the underestimation in the Huai River Basin (HRB) are also reduced by merging ET. Among the ET candidates, SiTH is the dominant ET dataset with the highest fusion weights, while GLDAS has the lowest fusion weights in most triplets. Overall, BTCH and ETC exhibit comparable ET fusion performances and are both superior to the EM method. Additionally, the two methods yield broadly consistent spatial patterns of fusion weights and dominant ET for most triplets. However, BTCH tends to generate more stable weights than ETC when applied to the same triplet. As for the triplet, triplet-1 (ERA5-Land, GLDAS and GLEAM) and triplet-3 (ERA5-Land, GLEAM and SiTH) generally show more outstanding performances than the other triplets for most sites and basins. The fused ET results are more sensitive to the input triplet composition than to the selection of fusion method. The findings of this study can provide valuable insights into the ET data fusion without prior knowledge.}
}
@article{ZHU2026136362,
title = {Rapid temperature flips accelerate and amplify winter hypoxia and internal loading in a reservoir at the tropic of cancer},
journal = {Journal of Hydrology},
volume = {679},
pages = {136362},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136362},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014599},
author = {Ya Zhu and Yiping Li and Yu Chen and Yaning Wang and Daobin Ji and Xingxing Zhao and Carlo Gualtieri and Martin Schmid},
keywords = {Rapid temperature flips, Winter mixing, Internal loading, Manganese, Ammonium nitrogen, Drinking-water reservoir},
abstract = {Although rapid temperature flips (RTFs) are recognized as an emerging form of climate variability, their effects on reservoir mixing and internal loading remain poorly constrained, especially in (sub)tropical reservoirs. Here, we integrated 12 months of high-frequency observations from Dawangtan Reservoir with three-year water-quality records and a mixed-layer mass-balance framework to examine how RTFs regulate winter hypoxia and the loading of reduced solutes (e.g., Fe2+, Mn2+, NH4+). During the moderately warm winter of 2024, RTF frequency reached a five-decade high, driving repeated cycles of rapid mixing and short-lived restratification. These events caused sharp oscillations in Schmidt stability and thermocline depth, prevented sustained hypolimnetic reoxygenation, and produced synchronous increases in Mn and NH3-N as dissolved oxygen declined. Short recurrence intervals between RTFs resulted in the accumulation of oxygen deficits, ultimately causing whole-column anoxia. Rapid warm-cold flips entrained hypolimnetic water enriched with reduced solutes into the expanding mixed layer, whereas subsequent restratification allowed the depleted hypolimnetic solute pool to be replenished by sediment-derived solutes before the next mixing event. This transport–replenishment cycle, combined with shortened oxidation windows, concentrated internal loading into brief event periods. Four mixing events lasting only 25 days (6.8% of the year) accounted for 57.9% of annual Mn and 34.0% of annual NH3-N loads. Annual internal loads during 2023–2024 were over twice those in the previous two years. These findings show that intensified RTFs can convert gradual seasonal internal loading into abrupt winter water-quality shocks, highlighting the need for event-based monitoring and rapid reservoir–waterworks response under increasing climate variability.}
}
@article{SANIKHANI2026136301,
title = {Large-scale climate teleconnections and multiscale controls on river water temperature},
journal = {Journal of Hydrology},
volume = {679},
pages = {136301},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136301},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013983},
author = {Hadi Sanikhani and Mostafa Khorsandi and Stephen J. Déry and André St-Hilaire},
keywords = {Climate teleconnections, Multiscale variability, Salmon thermal stress, River thermal regime},
abstract = {River water temperature dynamics are influenced by climate variability and large-scale atmospheric teleconnections, particularly in regulated river systems where anthropogenic controls interact with natural hydroclimatic drivers. This study investigates the multiscale influence of the El Niño-Southern Oscillation (ENSO) and the Pacific Decadal Oscillation (PDO) on river water temperature variability in a cold-region Pacific watershed influenced by Pacific climate variability. Long-term daily water temperature series were reconstructed for 1950–2024 using the hybrid Air2Stream model, and the resulting series were analyzed over the common 1950–2021 period using wavelet techniques, including the continuous wavelet transform and bivariate, partial, and multiple wavelet coherence. Results indicate that while seasonal atmospheric forcing dominates the annual thermal cycle, significant non-stationary variability emerges at interannual (2–7 years) and decadal scales. The PDO exhibits persistent and coherent coupling with river water temperature over multi-year to decadal timescales, whereas ENSO influences are episodic and primarily confined to interannual timescales. Joint PDO-ENSO interactions are most pronounced at decadal (8–16 year) periods. Comparison between regulated and natural stations suggests that flow regulation may differentially filter low-frequency variability, reducing raw interannual-to-decadal power while partially preserving coherent phase relationships with basin-scale climate modes in regulated reaches. Summer-focused analyses reveal that positive PDO phases are consistently associated with elevated river water temperatures, with mean July-September (JAS) anomalies of approximately 0.2–0.8 °C and increased exceedance frequencies above ecologically relevant thresholds (e.g., 20 °C). In contrast, ENSO-related summer temperature anomalies are weaker and spatially inconsistent. Overall, the results demonstrate that decadal-scale Pacific climate variability, particularly the PDO, plays a persistently influential role in shaping river water temperature variability in cold-region systems, highlighting the importance of accounting for non-stationary climate controls in hydrological thermal assessments.}
}
@article{SNIR2026136390,
title = {Real-time control of rainwater harvesting in an urban catchment: a model predictive control approach under forecasting uncertainty},
journal = {Journal of Hydrology},
volume = {679},
pages = {136390},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136390},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014873},
author = {Ofer Snir and Eran Friedler and Luca Vezzaro},
keywords = {Rainwater harvesting, Real time control, Model predictive control, Urban drainage, Uncertainty},
abstract = {Rainwater harvesting (RWH) is gaining popularity in urban water systems as a tool to address the challenges posed by urbanization and climate change. Urban areas face water scarcity and increased runoff due to growing population and the conversion of natural areas into impermeable surfaces. RWH systems can serve as stormwater control measures while storing and supplying rainwater for non-potable uses. However, RWH systems become less effective as storm events exceed their storage capacity. To overcome this limitation, the field of real-time controlled RWH systems has emerged in the latest research. These systems release water from tanks before and during significant rain events, reducing uncontrolled overflows. This study examines the effects of favourable control policies on an urban catchment retrofitted with RWH systems. A simulation-optimisation procedure is developed to generate flexible control policies that adapt to changing rainfall forecasts using concepts from the Model Predictive Control approach. The methodology aims to reduce peak flows, minimise rainwater release, and optimise a single objective function without complex procedures. The methodology is evaluated through simulations of 73 rain events in a case study catchment. The MPC achieved a median peak flow reduction of 29% while maintaining low rainwater availability losses (median rainwater availability reduction: 1.5–2.0%). Forecast uncertainty had only a minor impact on performance, and the MPC consistently outperformed rule-based control strategies, providing superior flood mitigation while preserving stored rainwater. The results show promising outcomes in mitigating flows while maximising water availability, suggesting potential to enhance urban resilience.}
}
@article{WU2026136373,
title = {High-spatiotemporal-resolution GRACE(-FO)-constrained terrestrial water storage reconstruction captures the hydrological footprints of successive typhoons in southern mainland China},
journal = {Journal of Hydrology},
volume = {679},
pages = {136373},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136373},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014708},
author = {Haotian Wu and Jiangjun Ran and Natthachet Tangdamrongsub and Yulong Zhong},
keywords = {GRACE, Typhoon, Downscaling, Reconstruction, XGBoost, Pearl River Basin},
abstract = {The southern coastal region of mainland China faces persistent typhoon-related hydrological hazards, highlighting the need to monitor rapid variations in terrestrial water storage during extreme precipitation events. Satellite gravity missions provide observations of large-scale mass redistribution, but their coarse effective spatiotemporal resolution limits their ability to resolve short-lived, localized hydrological responses to typhoons. This study proposes a cascading framework that combines empirical-statistical reconstruction with machine-learning downscaling of reconstruction parameters to generate a climate-driven terrestrial water storage anomaly (TWSA) reconstruction at high spatiotemporal resolution. First, an improved empirical-statistical reconstruction model was calibrated against monthly GRACE(-FO) observations and used to reconstruct daily TWSA from precipitation and temperature data. Subsequently, the model parameters were spatially downscaled using XGBoost with climatic, topographic, soil, and vegetation predictors. The downscaled parameters were then reintroduced into the reconstruction model to generate daily TWSA at 0.1° spatial resolution. Cross-product comparisons with GRACE(-FO)-based products and estimates from land surface models showed overall consistency. Application of the framework in the Pearl River Basin during four successive typhoons in 2023 revealed distinct patterns in the reconstructed TWSA responses. During sustained post-landfall rainfall associated with Typhoon Haikui, reconstructed TWSA increased further to annual maxima across all four coastal sub-regions. The Pearl River Delta showed the largest increase, reaching 6.72 cm above the pre-typhoon baseline. These findings characterize cumulative and regionally heterogeneous reconstructed TWSA variations during successive typhoon events. The resulting dataset provides fine-scale information for characterizing extreme hydrological events and extends the utility of satellite gravity observations for studying rapid hydrological responses.}
}
@article{ZHENGHAO2026136393,
title = {Integrated remote sensing retrieval of surface and root-zone soil moisture through physical mechanisms-guided machine learning},
journal = {Journal of Hydrology},
volume = {679},
pages = {136393},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136393},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014903},
author = {Li Zhenghao and Yuan Qiangqiang and Yue Linwei and Yang Qianqian and Shen Huanfeng and Zhang Liangpei},
keywords = {Surface soil moisture, Root-zone soil moisture, Physical mechanism, Machine learning, Radiative transfer model, Soil moisture dynamics},
abstract = {Surface soil moisture (SSM) and root-zone soil moisture (RZSM), as key variables in the water cycle, play a crucial role in regulating water, energy, and carbon exchanges between the land surface and the atmosphere. Currently, satellite remote sensing retrieval technology is widely applied as an effective method for acquiring large-scale SSM data. However, the limited penetration capability of remote sensing signals into the soil presents significant challenges for the retrieval of RZSM. Physical and machine learning (ML) retrieval models require extensive labeled data to achieve high-accuracy retrieval, which poses difficulties in regions with limited in-situ data. To address these challenges, this study proposed an integrated retrieval framework for SSM and RZSM that combines physical mechanisms with ML models. This framework operates in two stages: in the first stage, a radiative transfer model based on brightness temperature data serves as the core, with the ML model employed to optimize the structure and parameters of the physical model, thereby enabling accurate retrieval of SSM. The SSM outputs subsequently serve as direct inputs for the subsequent stage. In the second stage, the ML retrieval model serves as the cornerstone, where the knowledge of soil moisture dynamics informs feature optimization to enable high-accuracy RZSM estimation. The retrieval framework demonstrated strong generalization and spatial extrapolation capabilities in jointly retrieving SSM and RZSM within the validation area in China. The development of this retrieval framework enables high-accuracy soil moisture retrieval in areas with limited monitoring sites, which lays the groundwork for generating large-scale soil moisture products, and provides robust data support for hydrological and climate-related research.}
}
@article{HE2026136310,
title = {Regional variability and driving mechanisms of runoff coefficient on the Loess Plateau},
journal = {Journal of Hydrology},
volume = {679},
pages = {136310},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136310},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014071},
author = {Qilin He and Peng Zhang and Binbin Li and Nan Shen and Mingyi Yang and Dongli She and Fengbao Zhang},
keywords = {Runoff coefficient, Runoff plot, Land use, Rainfall type, the Loess Plateau},
abstract = {The runoff coefficient (RC), defined as the proportion of precipitation converted into surface runoff during an individual rainfall event, exhibits pronounced spatial variability across different geomorphic regions owing to the combined influences of climate, topography, vegetation, and human activities. Using the Loess Plateau as a representative study area, we integrated multi-site observations and conducted a cross-regional comparative analysis to quantify the regional variability of event-based RC and identify its driving mechanisms. The results showed that the hilly–gully region (HG) showed the highest mean RC (0.14), followed by the earth–rock mountain (RM, 0.11), whereas the sandy zone (SD, 0.08), gully region (GR, 0.07), and valley plain (VP, 0.06) exhibited considerably lower values. RC showed a distinct land use gradient, with bare land > cropland > orchard > forest > shrub > grassland. Under Light, Moderate, and Heavy Rain, HG showed the highest RC, whereas RM exhibited the highest RC under Storm Rain. Structural equation modeling identified rainfall characteristics and land use as the dominant drivers of RC. Rainfall exerted positive total effects on RC in RM (0.41), GR (0.36), HG (0.31), and SD (0.29), but a slightly negative total effect in VP (−0.08). Land use exerted positive total effects on RC, particularly in RM, VP, and SD (0.42, 0.36, and 0.49, respectively), whereas vegetation exerted negative total effects (−0.37, −0.22, and −0.19, respectively). Soil moisture and terrain generally exerted weaker total effects on RC, with total effects varying markedly among regions. Overall, these results provide new insights into the regional variability and controlling mechanisms of RC across the Loess Plateau, supporting region-specific soil and water conservation strategies.}
}
@article{HDEIB2026136407,
title = {A historical data curation (HDC) framework integrated with GIS-based multi-criteria decision analysis to inform flood risk prioritization in data-scarce regions},
journal = {Journal of Hydrology},
volume = {679},
pages = {136407},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136407},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015040},
author = {Rouya Hdeib and Chadi Abdallah and François Colin and Hassan Sabeh and Roger Moussa},
keywords = {Historical floods, Flood risk, Data-scarce, socio-hydrology, Newspaper records, Perceived impact, Lebanon, Knowledge curation, HELPING},
abstract = {Data-scarce regions lack reliable long-term gauging records and standardized flood databases which constrains classical flood risk assessments and fail to adequately reflect local contexts. Global initiatives emphasize investments in non-traditional data curation to improve the representation of vulnerability and to transform how disaster risk is addressed, complementing systematic flood risk assessment strategies. In this study, we present the outcomes of past flood information curation from newspapers and archives to build a national flood database and evaluate the basin-scale flood risk. We particularly propose a reproducible Historical Data Curation– Multi-Criteria Decision Analysis (HDC–MCDA) framework that transforms qualitative historical archives into standardized quantitative Curated Historical Flood Descriptors (CFD) and integrates them with conventional GIS-based MCDA flood risk analysis. We curated a database of 700 flood events (1955–2020) in Lebanon with documented description and impacts. Two CFD, Historical Flood Occurrence (Ne) and Historical Flood Severity (Sev), were developed through text processing and integrated in the MCDA analysis. The study was applied for 16 basins, where hazard and vulnerability are represented by conventional morphological, hydrological and land-use descriptors extracted from available data. Across the studied scenarios, HDC-MCDA led to notable shift in flood risk level, suggesting that HDC captures the realized impact and recalibrates flood risk prioritization by perceived impact information that is often not reflected by scarce hazard and vulnerability data. The study provides a reproducible framework for “soft” documentary data curation and integration into risk assessments, informing prioritization of mitigation and early warning efforts in data-scarce countries.}
}
@article{MASTEN2026136337,
title = {Climate change impacts on alpine springs in Austria: shifts in discharge seasonality and water availability},
journal = {Journal of Hydrology},
volume = {679},
pages = {136337},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136337},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014344},
author = {Martin Masten and Magdalena Seelig and Simon Seelig and Matevž Vremec and Thomas Wagner and Maria Obwegs and Matthias Hausleber and Jutta Eybl and Gerfried Winkler},
keywords = {Climate change impact, Alpine hydrogeology, Rainfall-runoff modelling, Snow, Discharge seasonality},
abstract = {Spring water supplies about half of Austria’s drinking water demand and is the sole source in some regions. Climate change is rapidly altering hydrological conditions in the Alps, making projections of future spring discharge essential for sustainable water management. This study assesses climate change impacts on 70 alpine springs across the Austrian Alps, covering a wide range of climatic and hydrogeological settings. Plausible catchments were identified using a rainfall–runoff model with a snow module, which was forced with climate projections from three emission scenarios (RCP 2.6, 4.5, and 8.5) and 40 model realizations to evaluate impacts until 2100. Changes were assessed by comparing a historical reference period (1980–2009) with a near-future period (2030–2059) and a far-future period (2070–2099). Analyses were conducted for individual springs and hydrologically classified spring groups. Results indicate decreasing spring discharge in western Austria under all scenarios and periods. Under RCP 4.5 and 8.5, discharge reductions also emerge in southern Austria. Annual discharge changes generally remain within single-digit percentages, in both positive and negative directions, but differ among spring groups. Snow-dominated and recession-dominated springs show the highest sensitivity to emission scenarios, whereas fast-responding springs maintain positive annual changes. Seasonal shifts are pronounced, with increased spring time discharge for snow-dominated springs and reduced summer and autumn discharge for both snow-dominated and fast-responding springs. Low flows shift from late winter and early spring toward summer and autumn, intensifying under higher-emission scenarios. These results provide a basis for climate adaptation and sustainable water management in Austria.}
}
@article{ZHENG2026136389,
title = {Hydroclimatic seasonality, bacterioplankton, and dissolved organic matter in a semi-enclosed plateau lake},
journal = {Journal of Hydrology},
volume = {679},
pages = {136389},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136389},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014861},
author = {Wei Zheng and Fan Xia and Qian Bao and Yalan Zhu and Muzi Li and Xiaoyan Tang},
keywords = {Dissolved organic matter (DOM), Bacterioplankton, Hydroclimatic variability, Microbial diversity, Plateau lake ecosystems},
abstract = {Dissolved organic matter (DOM) is a central component of carbon cycling, yet the associations among hydroclimatic conditions, bacterioplankton communities, and DOM composition remain insufficiently understood in plateau lakes. This study investigated the seasonal variation of chromophoric dissolved organic matter (CDOM) and its associations with bacterioplankton communities in Qionghai Lake, a semi-enclosed plateau lake in southwestern China. Across the four sampling campaigns, CDOM exhibited a strong autochthonous and microbial signature, with protein-like components accounting for 53.2% of the total fluorescence. CDOM abundance peaked in autumn, when aCDOM(355) reached 1.94 ± 0.24 m−1, coinciding with elevated concentrations of TN and NH4+-N and a higher contribution from the microbial humic-like component C1. In contrast, winter exhibited the lowest aCDOM(355) (0.85 ± 0.23 m−1), the highest Ca2+ concentrations, and the lowest contribution from the tryptophan-like component C4. Bacterioplankton communities also showed clear seasonal shifts, and network analysis identified different bacterial assemblages associated with humic-like and protein-like CDOM fractions. At the annual scale, partial least squares path modeling revealed contrasting microbial patterns: nutrient conditions were positively related to α-diversity, which was inversely related to microbial CDOM, whereas physicochemical conditions were more strongly related to β-diversity, which covaried positively with terrestrial CDOM. Overall, seasonal hydroclimatic variation was accompanied by shifts in CDOM abundance, composition, and bacterioplankton community structure, providing new insights into seasonal carbon cycling and bacterioplankton–DOM linkages in plateau lakes.}
}
@article{WANG2026136313,
title = {A comprehensive distributed hydrological framework for assessing flood responses to environmental change under multiple human disturbances},
journal = {Journal of Hydrology},
volume = {679},
pages = {136313},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136313},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014101},
author = {Yuhao Wang and Ke Zhang and Edwark Park and Yuning Luo and Jie Liu and Shunzhang Li and Zhaoan Zhang and Yue Kong and Sheng Wang},
keywords = {Hydrologic modeling, Environmental change, Flood response, Human disturbances, Field ridge interception, Water table decline},
abstract = {Understanding flood responses to environmental change and simulating flood processes under multiple human disturbances are essential for reliable prediction under a changing environment. To address these challenges, this study enhances the GHydroMod-SIM-DAI model to develop a comprehensive distributed hydrological framework that explicitly represents human disturbances, including groundwater exploitation, hydraulic structure operation, land cover change and on-farm water storage. An improved underground reservoir module is introduced to capture the effects of water table decline on runoff generation in mountainous watersheds, while a field ridge interception module is incorporated to quantify surface flow interception by agricultural ridges. The proposed framework is applied to five representative watersheds in the Haihe River Basin. During the baseline period (1980–1991), it demonstrates improved performance across all watersheds, with the best results in the Zijingguan Basin, followed by the Fuping, Songxi River, Qingshui River, and Shili River basins. Peak flow analysis indicates substantial attenuation due to human disturbances, with the largest reductions in the Qingshui River Basin (93.0%), followed by the Songxi River (59.9%), Zijingguan (42.5%), Shili River (41.3%), and Fuping (39.1%) basins. Afforestation, water table decline, and field ridge interception are identified as the dominant mechanisms driving peak flow reduction in different watersheds. During the change period (2006–2019), the enhanced underground reservoir module markedly improves performance in mountainous watersheds including the Shili River, Zijingguan, and Songxi River basins, while field ridge interception dominates peak flow reduction in the Qingshui River Basin, with a mean contribution exceeding 95% across the ten flood events. Although predictive uncertainty increases under a changing environment, the framework maintains satisfactory accuracy for moderate and major floods. Overall, this study provides a robust, process-based tool for quantifying flood responses to environmental change under multiple human disturbances in rapidly evolving watersheds.}
}
@article{MING2026136329,
title = {MPM-DEM simulation of woody debris flow interaction with slit-check dams},
journal = {Journal of Hydrology},
volume = {679},
pages = {136329},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136329},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014265},
author = {Liu Ming and Xiaoqin Lei and Xinpo Li and Siming He and Xiaojun Guo and Liangliang Wang},
keywords = {MPM-DEM coupling, Boulders, Driftwood, Impact force, Slit-check dam},
abstract = {This study develops a coupled Material Point Method-Discrete Element Method (MPM-DEM) framework to simulate the dynamic, multiphase behavior of debris flows containing water, boulders, and driftwood impacting slit check dams. Results show that driftwood plays a pivotal role in blocking slit openings across a range of flow conditions, while boulders dramatically increase peak impact forces through high-velocity impulsive strikes. Driftwood and boulders interact synergistically: the volume and size of woody debris control blockage probability, alter flow patterns, and amplify subsequent boulder impacts on the dam. Parametric analyses also highlight the influence of bulk flow properties on flow hydrographs and impact force profiles. The study clarifies the driving mechanisms behind extreme loadings induced by natural debris flows containing both boulders and driftwood, and offers a reliable numerical modelling approach that enables rational design and performance optimization of check dams, ultimately enhancing hazard mitigation and risk management in steep, forested mountain catchments.}
}
@article{LIU2026136381,
title = {A routing-based approach to rank LID locations for runoff management at the watershed scale},
journal = {Journal of Hydrology},
volume = {679},
pages = {136381},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136381},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014782},
author = {Yang Liu and Yuzhi Xiao and Anyang Tong and Shengle Cao and Guoqing Sang},
keywords = {LID, Distributed deployment, Routing-based index, Watershed–scale, Stormwater modelling},
abstract = {Low Impact Development (LID) is widely used to mitigate urban flood runoff, yet selecting suitable locations at the watershed–scale remains challenging because hydrologic benefit depends on both local runoff-generation potential and upstream–downstream routing (the latter is often overlooked in previous research). We propose the Routing-Based LID Distribution Approach (RLDA), a routing-informed screening framework that ranks candidate locations by combining a Hydrologic Index (HI) and a Routing-Based Index (RBI) into a Comprehensive LID Benefit Index (CLBI). We discretize the watershed into Hydrologic Location Units, and represent LID options using permeable pavement and rain barrels. The framework was validated in the Xingjihe urban watershed in Jinan, China (294.78 ha), and further tested in the independent Green Acre Branch catchment. PySWMM is used to develop the catchment models to implement four deployment strategies, namely: CLBI-ranked, HI-ranked, RBI-ranked, uniform deployment, against a no-LID baseline deployment under four deployment budgets and five design storms (2-, 5-, 10-, 20-, and 50-year return periods). Across all return periods, the CLBI-ranked strategy generally produced the highest mean peak-flow reduction and total runoff reduction under the tested scenarios. However, the performance gap among strategies narrowed as storm intensity increased, indicating that routing-informed prioritization is most advantageous for frequent-to-moderate events while extreme storms increasingly overwhelm local controls. These findings provide an efficient, connectivity-aware ranking framework that bridges index-based screening and process-based validation for watershed–scale LID planning.}
}
@article{SUN2026136418,
title = {Response-pattern-aware graph neural network for rapid compound rainfall-tide urban drainage prediction},
journal = {Journal of Hydrology},
volume = {679},
pages = {136418},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136418},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015155},
author = {Peiyuan Sun and Maochuan Hu and Kui Xu and Yongjie Wong and Bingjun Liu and Xiaohong Chen},
keywords = {Compound rainfall–tide flooding, Urban drainage, Graph neural network, SWMM surrogate, Response heterogeneity},
abstract = {Rapid compound rainfall-tide drainage prediction supports multi-scenario assessment in coastal cities, but network-wide surrogate errors can obscure high-response nodes, dynamic hotspots and peak-recession behavior. This study develops RPAG-GNN, a SWMM-supervised graph surrogate for rapid same-network node-level hydraulic-head prediction and response-oriented diagnostic analysis. RPAG-GNN combines drainage topology, historical hydraulic states, antecedent tide-memory descriptors and prescribed rainfall-tide forcing within a response-supervised residual-update allocation framework. During training, SWMM-derived response-state, peak-intensity and phase-evolution cues guide a bounded gate that allocates node- and step-specific residual head updates. In the fixed Cuiping catchment, 832 candidate scenarios were constructed from 64 rainfall and 13 tide-boundary processes, and 160 mutually exclusive events were used for training, validation, independent testing and pressure testing. Node responses were strongly heterogeneous: median response amplitude was 0.91 m, the 95th percentile reached 4.37 m and four response regimes were identified. RPAG-GNN achieved node-event median main and high-response RMSE values of 0.151 and 0.266 m; the corresponding event-level medians were 0.328 and 0.450 m, and pressure-test medians were 0.462 and 0.614 m. Median peak-timing error was 5 min, gate activation correlated strongly with response amplitude (Spearman ρ = 0.829), tide-memory gain concentrated in medium- and high-tide-imprint nodes, and a representative event showed 89.39–98.48% hotspot overlap. These results support response-supervised update allocation for same-network compound drainage prediction within the tested Cuiping topology, without implying direct inundation mapping, operational warning issuance or cross-network validation.}
}
@article{CHAI2026136321,
title = {A differentiable Xin’anjiang model incorporating transfer learning for cross-basin flood prediction under data scarcity},
journal = {Journal of Hydrology},
volume = {679},
pages = {136321},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136321},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014186},
author = {Yikai Chai and Wenyu Ouyang and Xuezhi Gu and Yong Peng and Xiaolan Chen and Yulin Yang and Minglei Ren},
keywords = {Differentiable hydrological modeling, Transfer learning, Data scarcity, Cross-basin generalization, Parameter identification},
abstract = {In data–scarce basins, hydrological models often fail to capture the peak–dominated, nonstationary behaviour of rainfall–runoff events, limiting cross–basin generalization. To reconcile physical interpretability with deep learning capacity, we develop a differentiable Xin’anjiang model (dXAJ) that couples the conceptual XAJ structure with an LSTM network via differentiable programming, and further integrates transfer learning to enhance regional adaptability. Using 663 flood events from 18 diverse basins in Anhui Province, China, we evaluate dXAJ against the XAJ and LSTM under three tiers: data–rich training, zero–shot ungauged transfer, and fine–tuning with limited local data. Regionally trained dXAJ achieves a median KGE of 0.785 on the test set, rising to 0.811 for large floods, confirming robust temporal generalization. In zero–shot transfer, the multi–source pre–trained dXAJ attains a median KGE of 0.694 and a median absolute peak error of 21.4%, with log–regression R2 > 0.90 for peak flows, demonstrating strong spatial transferability. With transfer learning, fine–tuning using only 33% of local events yields a KGE of 0.785 and reduces peak error to 15%, matching full–data performance, indicating that the primary benefit lies in lowering data demand rather than raising the upper bound. Parameter analysis further shows that transfer–learning corrections align with the natural drift induced by expanded data (84% directional consistency, correlation 0.64), confirming a physically consistent parameter space. These findings demonstrate that differentiable hydrological modelling integrated with transfer learning provides a practical, interpretable framework for improving flood prediction and cross–basin generalization in data–scarce regions.}
}
@article{DONG2026136349,
title = {Unraveling meteorological contributions and lagged effects on multi-depth soil moisture prediction using Transformer-SHAP framework},
journal = {Journal of Hydrology},
volume = {679},
pages = {136349},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136349},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014460},
author = {Jiankang Dong and Wenxue Xia and Huiqing Hao and Yi Lian and Furong Yu and Yonghong Hao and Tian-Chyi Jim Yeh},
keywords = {Transformer, Soil moisture, Timeseries forecasting, SHAP},
abstract = {Soil moisture (SM) is a key state variable linking meteorological forcing with land surface hydrothermal processes. Accurate prediction of SM across soil depths and clarification of meteorological contributions and lagged effects are important. Here, meteorological contributions refer to the SHAP quantified contributions of individual predictors to SM predictions, whereas lagged effects refer to the historical period over which antecedent meteorological information remains useful for predicting current SM. We developed separate Transformer models for the 5, 20, 45, and 80 cm soil layers and identified the optimal historical input window for each depth. The models achieved NSE values of 0.82, 0.78, 0.70, and 0.90, respectively. The optimal windows increased from 20 days at 5 cm to 21, 29, and 40 days at 20, 45, and 80 cm, indicating longer dependence on antecedent meteorological information with increasing depth. SHAP analysis revealed depth related changes in meteorological contributions. At 5 cm, net radiation and average air temperature contributed 31.5% and 26.7%, while precipitation and maximum relative humidity also contributed substantially. At 20–45 cm, the contribution of precipitation decreased, whereas those of wind speed and minimum relative humidity increased. At 80 cm, net radiation, average air temperature, and minimum relative humidity were the three largest contributors. These results indicate a shift from rapid shallow responses to near surface energy conditions and precipitation toward more delayed deep responses associated with antecedent wetness and profile scale moisture redistribution. Overall, the Transformer-SHAP framework provided reliable predictions and enabled interpretable comparisons across soil depths.}
}
@article{HATAMI2026136410,
title = {Climate change both increases and decreases winter snowmelt across North America},
journal = {Journal of Hydrology},
volume = {679},
pages = {136410},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136410},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015076},
author = {Shadi Hatami and Masoud Zaerpour and André S. Ballarin and Rahim Barzegar and Simon Michael Papalexiou and Alain Pietroniro and Jan Franklin Adamowski},
keywords = {Winter snowmelt, Climate change, Compound impacts, Multivariate copula, North America},
abstract = {Snowmelt, a vital source of freshwater for a large portion of North America’s population, is increasingly vulnerable to the impact of climate change. Air temperature and precipitation are significant climatic controllers regulating snowmelt dynamics. In this study, we quantified the response of winter snowmelt magnitude to changing temperature and precipitation across North America (Canada and the United States) using gridded, observation-driven data and future projections. Our analysis of far-future conditions (2091-2100) reveals a significant increase (>60%) in winter (November-March) snowmelt in northern latitudes, while southern latitudes are projected to experience a decline (<38%). Projected snowmelt changes are strongly associated with changes in winter temperature, while projected declines are consistent with regions experiencing reduced snowfall under warming climates. Our findings suggest that the probability of an increase in winter snowmelt is high under the warmer and wetter climatic conditions prevailing in northern regions. In contrast, winter snowmelt across southern latitudes is likely to decrease.
Plain language summary
Snowmelt plays a critical role in sustaining water resources for large populations across North America. As temperature and precipitation are major climatic factors regulating snowmelt dynamics, changes in these variables can affect the magnitude of snowmelt. Given projected climate change, it is essential to assess the vulnerability of snowmelt magnitude to changing temperatures and precipitation to understand future water availability. Our analysis of future winter snowmelt under compound changes in air temperature and precipitation across North America indicates that winter snowmelt could increase by 60% in many regions of Canada. In contrast, in southern areas, the winter snowmelt volume could decrease by as much as 38%. These results suggest that warmer winters are the primary driver of increased snowmelt, while reduced snowfall primarily governs the projected snowmelt declines.}
}
@article{HU2026136341,
title = {Incorporating soil cracks improves nitrogen transport modelling in paddy soils under contrasting irrigation and biochar management},
journal = {Journal of Hydrology},
volume = {679},
pages = {136341},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136341},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014381},
author = {Jiazhen Hu and Shihong Yang and Honghui Sang and Dongxing Su and Liang Li and Xinyu Zhao and Zewei Jiang and Haonan Qiu and Yi Xu and Xinyi Li},
keywords = {Paddy soil cracks, Nitrogen transport, COMSOL-2D, Controlled irrigation, Biochar amendment},
abstract = {Crack-induced preferential flow in water-saving paddy systems may accelerate nitrogen transport beyond the root zone, increasing the risk of fertilizer loss and agricultural non-point source pollution. However, how soil cracks regulate NH4+–N and NO3−–N redistribution under irrigation and biochar management remains insufficiently quantified. Here, we developed a crack-incorporated COMSOL-2D model that explicitly represented cracks with prescribed geometries and dimensions and quantified crack–matrix water exchange based on the transverse hydraulic gradient across crack walls, while coupling root water uptake, nitrogen transformation, and adsorption processes. Experiments were conducted during the 2022 and 2023 rice-growing seasons under controlled irrigation without biochar, controlled irrigation with 10, 30, and 60 t ha−1 biochar, and flooded irrigation without biochar. The model was calibrated using the 2022 data and independently validated using the 2023 data. Compared with the crack-free model, the crack-incorporated model reduced RMSE by 14.50–25.80%, increased the index of agreement by 0.20–9.80%, and improved the Nash–Sutcliffe efficiency by 0.50–25.10% for NH4+–N simulation in 2022. For NO3−–N simulation, RMSE decreased by 1.70–18.37%, and the index of agreement increased by 0.50–33.70%. Model improvements were more evident in the 10–40 cm soil layers, suggesting that explicit crack representation better captured preferential nitrogen movement in the deeper part of the observed profile. NH4+–N was mainly retained in the upper soil profile during the early growth stage and redistributed downward later in the season, whereas NO3−–N showed greater sensitivity to irrigation events and crack characteristics. During the later growth stage, biochar-amended treatments maintained 17.5–52.5% higher NO3−–N concentrations than controlled irrigation without biochar (CK). Scenario simulations showed that crack depth exerted a stronger influence on nitrogen redistribution than crack number or morphology. Increasing crack depth reduced nitrogen accumulation within the observed soil profile and increased the potential for downward nitrogen transport, particularly for NO3−–N. These results suggest that crack-free models may underestimate downward nitrogen transport in water-saving paddy systems, supporting the explicit consideration of soil cracks in modeling nitrogen transport under water-saving irrigation.}
}
@article{MA2026136388,
title = {Benchmarking a bounded-coordinate DeepONet for unsaturated flow and solute transport under time-varying infiltration},
journal = {Journal of Hydrology},
volume = {679},
pages = {136388},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136388},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601485X},
author = {Zhitong Ma and Xueyang Sun and Wenke Wang and Jing Li and Shuyao Ma},
keywords = {Neural operator, DeepONet, Unsaturated flow, Solute transport, Distribution shift, Surrogate modelling},
abstract = {Repeated solution of the Richards and advection–dispersion equations can make large-scale ensemble evaluation of unsaturated-flow and solute-transport scenarios computationally restrictive. We evaluate RegShift-DeepONet, a bounded-coordinate variant of Shift-DeepONet that receives a time-varying infiltration hydrograph qtop(t) and soil hydraulic parameters and predicts pressure head h(z,t) and concentration c(z,t). The tanh-bounded affine transform is treated as a guardrail on coordinate adaptation rather than as a hard physical constraint. Five architectures are compared using common data splits, three random seeds, and parity in training budgets under in-distribution (IID), high-peak, and late-peak forcing tests. For the median sample-wise concentration relative L2 error, the bounded model obtains 0.0617±0.0023, 0.0714±0.0081, and 0.0692±0.0096, respectively. The corresponding unconstrained Shift-DeepONet errors are 0.0612±0.0115, 0.0698±0.0136, and 0.0753±0.0158. Thus, their differences under IID and high-peak forcing are smaller than the observed three-seed variability, while bounding reduces concentration error by 8.1% under the late-peak shift. A tuned Fourier neural operator gives errors of 0.1184−−0.1305. Supplementary temporal-shape and joint forcing–soil stress tests delineate the conditions under which process-model confirmation is required. Mass-balance error is used as a conservative trigger for HYDRUS review rather than as a stand-alone accuracy certificate. The results support a focused conclusion: bounded coordinate adaptation can selectively stabilise temporal extrapolation, with applicability checks and HYDRUS confirmation providing an auditable screening workflow.}
}
@article{WANG2026136333,
title = {Groundwater discharge dominates CO2 emission with low CH4 efflux in a glacier-fed stream on the Qinghai-Tibet Plateau},
journal = {Journal of Hydrology},
volume = {679},
pages = {136333},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136333},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014307},
author = {Chuan Wang and Xin Dai and Sen Xu and Yueqing Xie and Yanxia Shen and Chunhui Lu and Wei Zhi},
keywords = {Glacier-fed stream, Groundwater–surface water interaction, Greenhouse gas, Carbon cycle, Dissolved gas analysis, Cryosphere},
abstract = {Glacier-fed streams are important yet poorly understood components of the cryospheric carbon cycle. It remains unclear whether these streams act as carbon sources or sinks, and what mechanisms drive carbon gas exchange. Here, we combined salt slug injection experiments, dissolved gas tracing (4He, 40Ar, 84Kr, O2, CO2, CH4), and 222Rn mass balance modeling to constrain CO2 and CH4 exchange in a glacier-fed stream on the Qinghai-Tibet Plateau. Concurrent increases in stream discharge, electrical conductivity, stable water isotopes, and major ion concentrations indicated notable groundwater discharge. The 222Rn mass balance model revealed groundwater discharge rates per unit stream length of 3.2–43.1 m2 d−1 (∼34.7 % of increased stream discharge) and gas transfer velocities of 3.6–148.1 m d−1. The stream remained persistently oversaturated with CO2, whereas CH4 stayed near atmospheric equilibrium. Paired dissolved gas analysis indicated that in-stream metabolic CO2 production was limited (1.5–2.7 mmol m−2 d−1). In contrast, groundwater discharge supplied substantial CO2 inputs (11–2121 mmol m−2 d−1), sustaining oversaturation and driving rapid CO2 emissions (21.7–853.7 mmol m−2 d−1), which are comparable to or even higher than the global average for rivers. Groundwater CH4 inputs were small (0.1–21.5 μmol m−2 d−1), leading to low atmospheric exchange fluxes (−45.3 to 70.9 μmol m−2 d−1). Higher CH4 emissions occurred in reaches with elevated groundwater CH4 concentrations and high groundwater discharge rates. Our findings suggest that the glacier-fed stream can be a CO2 emission hotspot driven by groundwater discharge. We underscore that groundwater discharge, a fundamental yet underrepresented hydrological pathway, should be explicitly integrated into carbon cycling models for glacier-fed streams.}
}
@article{LI2026136401,
title = {On non-axisymmetric flow near circumferentially partially clogged artesian wells with mixed boundary conditions},
journal = {Journal of Hydrology},
volume = {679},
pages = {136401},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136401},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014988},
author = {Jiong Li and Yingjun Liu and Hongbin Zhan and Shuo Zhang and Yuefei Huang and Peipeng Wu},
keywords = {Mixed boundary condition, Circumferentially partially clogged well, Non-uniform flux, Integral transform, Semi-analytical solution},
abstract = {Conventional models of well hydraulics assume a fully penetrating well screen, imposing axisymmetric flow at the well face. In practice, partial clogging can restrict the hydraulic connection to only a portion of the circumference, creating a non-axisymmetric flow field that existing radially symmetric models cannot describe. In this study, we develop a non-uniform flux (NUF) semi-analytical model for transient groundwater flow to and from a circumferentially partially clogged well in a confined aquifer. A mixed boundary condition, consisting of an impermeable condition on the non-screened section and a uniform-drawdown condition on the screened section, allows well-face flux to vary angularly. We solve the resulting initial-boundary value problem with mixed boundary conditions by discretising the screened section into piecewise-uniform flux segments, sequentially applying the Laplace transform and finite Fourier cosine transform, and performing time-domain inversion using the Stehfest algorithm. The NUF solution reduces to the uniform-flux (UF) solution when the number of flux segments is set to one. Parametric analysis reveals that partial circumferential screen blockage mainly produces a localized near-well effect under constant-rate test (CRT) conditions, whereas its influence can persist throughout almost the entire flow domain under constant-head test (CHT) conditions. Across all conditions, NUF predictions fall between the UF and fully penetrating-well solutions and are consistently closer to the latter, indicating that the UF assumption overestimates the mitigating effect of the non-screened region. These findings establish the NUF model as a more accurate framework for interpreting pumping or injection tests in wells affected by circumferential clogging and improve understanding of flow behaviour in circumferentially partially clogged wells.}
}
@article{VANPUTTE2026136288,
title = {The iFLUX sensor for real-time measurement of horizontal groundwater flux magnitude and direction},
journal = {Journal of Hydrology},
volume = {679},
pages = {136288},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136288},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013855},
author = {Niels {Van Putte} and Goedele Verreydt},
keywords = {Groundwater flux sensor, Groundwater flow, Darcy velocity, Hydrogeology, Numerical modelling, Laboratory validation, In-well methods},
abstract = {Groundwater management requires reliable insights into subsurface water flux, yet effective long-term remote flux monitoring remains technically challenging due to power requirements, the difficulty of detecting low flux magnitudes, and the high operational on-site effort required by some methods. Here, we present the iFLUX horizontal flux sensor, which measures groundwater flux magnitude and direction in real time by using two perpendicularly oriented microfluidic flow chips, representing the first in situ hydrogeological application of this technology. The sensor is designed for use in fully saturated, non-cohesive porous media and is installed within a dedicated prepack filter. The complete system is deployed in a borehole drilled specifically for this purpose to ensure controlled and reproducible installation depth and orientation of the sensor. We evaluated the sensor’s magnitude and directional accuracy and assessed the stability of the measurements in a controlled laboratory sand tank experiment. Furthermore, we calibrated the sensor for flow-field distortion across a range of hydraulic conductivities using numerical modelling. Within the imposed range of 1 – 35 cm/day Darcy flux, the measured flux magnitude followed the imposed flux with an RMSE of 1.15 cm/day and an R2 of 0.99, while directional accuracy was 4.55° (RMSE). A sensitivity analysis indicated that sensor-based flux measurements are less sensitive to uncertainty in hydraulic conductivity than Darcy-based flux calculations, where flux errors scale linearly with hydraulic conductivity errors. Overall, the sensor’s low power demand, fast response and sensitivity for low flux magnitudes suggest potential for long-term autonomous monitoring of groundwater flux in low-gradient and dynamic environments.}
}
@article{LIU2026136325,
title = {Organic phosphorus fractions drive microbial diversity and assembly in the largest freshwater lake in northeast Asia},
journal = {Journal of Hydrology},
volume = {679},
pages = {136325},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136325},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014228},
author = {Xinghong Liu and Zijian Xie and Bo Bo and Weiwei Wei and Chunhua Li and Chun Ye},
keywords = {Bacterial and archaeal communities, Sediment phosphorus fraction, Community assembly processes, Lake eutrophication, Xingkai Lake},
abstract = {Phosphorus (P) is a key limiting nutrient governing lake productivity and eutrophication, yet the role of P fraction in shaping microbial community succession in large freshwater lakes remains poorly understood. Sediment bacterial and archaeal communities were investigated across vertical depth gradients in Xingkai Lake, the largest freshwater lake in Northeast Asia. which consists of two hydrologically connected sub-lakes—Daxingkai (DXKL) and Xiaoxingkai (XXKL)—that differ in area, water depth and trophic state. By integrating P sequential extraction, metagenomic sequencing and multivariate analyses, the influence of P fraction on microbial community succession was examined in these contrasting sedimentary environments. Results showed that distinct depth-dependent patterns emerged. Bacterial α-diversity decreased significantly with depth only in XXKL, while archaeal diversity exhibited a unimodal trend in DXKL. Deterministic processes dominated archaeal community assembly in DXKL, whereas stochastic processes, as inferred by the neutral community model, played a more important role in XXKL. Organic P fractions (HCl-Po or NaOH-Po) consistently emerged as the primary drivers of microbial diversity, with lake-specific shifts regulated by sediment pH: HCl-P prevailed in neutral-to-weakly alkaline DXKL, while NaOH-P dominated in weakly acidic XXKL. Structural equation modeling further revealed that organic matter and pH indirectly shaped community composition by modifying P bioavailability. Collectively, these findings demonstrate that P fraction composition fundamentally regulates microbial community assembly and vertical succession via its control over P fraction bioavailability. This study provides useful mechanistic understanding for P management and ecological restoration in large freshwater lakes facing eutrophication risks.}
}
@article{LI2026136377,
title = {Self-similarity criticality of the world’s large river systems},
journal = {Journal of Hydrology},
volume = {679},
pages = {136377},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136377},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014745},
author = {Zhenqi Li and Yichu Wang and Jinren Ni},
keywords = {River network, Self-similar regime, Golden ratio, Criticality threshold, Energetic response, Hydrogeomorphic forcing},
abstract = {River networks, as hierarchical conduits of material transport and energy conversion, exhibit self-similar structural patterns that are fundamental to hydrological processes. Yet, the mechanisms constraining their self-similarity boundaries remain elusive. Here, by analyzing 66 global large river basins (≥ 100,000 km2) using HydroATLAS data, we define a self-similar validity ratio (SVR) to quantify the normalized stream-order domain over which scale-invariant organization persists. River networks converge at low-to-medium stream orders (1–5) but diverge at higher orders (6–10), with the global SVR distribution having a dominant range of 0.57–0.67 that statistically aligns with the golden-ratio conjugate (φ = 0.618). This motivates classification of three self-similar criticality regimes, i.e., sub-golden, golden-aligned, and supra-golden rivers. By further constructing a self-similar criticality framework supported by three domain-guided composite hydrogeomorphic indices, validated against an energetic response index derived from the criticality thresholds at the self-similar collapse boundary, we reveal that the three regime types of rivers respectively correspond to energy-limited, energy-balanced, and energy-surplus states, and the alignment between SVR and φ marks a stable equilibrium state of hierarchical energy redistribution within river networks, where hydrological carrier capacity, geomorphic potential energy, and network geometry coordinate well to maintain long-term self-similar organization. These findings transform self-similarity from structural descriptions into physically based energetic analysis, which advances predictive tools for basin resilience under climate change, enabling optimized flood-hazard screening, erosion risk diagnosis, sediment management, and strategic hydropower planning.}
}
@article{GUO2026136414,
title = {Monthly dynamics of global surface water from 2015 to 2023},
journal = {Journal of Hydrology},
volume = {679},
pages = {136414},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136414},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015118},
author = {Xiaoyang Guo and Yuchen Liu and R.Iestyn Woolway and Ting Du and Lai Lai and Yongqi Sun and Yanjun Tian and Yongnian Gao},
keywords = {Global surface water, Monthly water dynamics, Sentinel-1/2, 10 m resolution, Google Earth Engine, Surface water variability},
abstract = {Surface water plays a central role in regulating global water, energy, and biogeochemical cycles, yet its strong spatial and temporal variability makes consistent monitoring difficult. Existing global products have greatly advanced surface water mapping, but they still struggle to combine fine spatial detail, monthly continuity, and reliable observations under frequent cloud cover. Here, we developed the High precision Global Monthly Surface Water dataset (HGMSW), a 10 m monthly surface water record from 2015 to 2023. The framework combines Sentinel 1 SAR and Sentinel 2 multispectral observations in a complementary way. Sentinel 2 time series imagery was used to construct a noise reduced maximum inundation extent, while monthly Sentinel 1 VV backscatter composites were used with the Calibrated Edge Otsu configuration to delineate water dynamics within this spatial constraint. Global validation showed that HGMSW achieved an overall accuracy of 97.59%, an F1 score of 97.55%, and a Kappa coefficient of 95.18%. The correct classification rate for small water bodies reached 88.83%, demonstrating the advantage of 10 m mapping for fragmented water features. Independent monthly validation using 3 m PlanetScope imagery across nine representative regions yielded a mean overall accuracy of 97.8%, confirming the ability of HGMSW to capture monthly boundary dynamics. HGMSW revealed a global monthly mean surface water area of 2.95 × 106 km2 during 2017–2021, with an average annual growth rate of 2.08%. The dataset further identified stronger seasonal variability in Northern Hemisphere continents, weaker variability in ocean influenced Southern Hemisphere regions, a weak bimodal pattern in Africa, and basin scale disruptions associated with droughts, floods, and reservoir impoundment. HGMSW fills an important gap between long term 30 m water products and static 10 m land cover datasets, providing a spatially detailed monthly record for monitoring surface water dynamics and their responses to climate variability and human regulation.}
}
@article{HAJIKA2026136369,
title = {Hillslope lag times for flood runoff are extremely short in high-relief meso-scale catchments},
journal = {Journal of Hydrology},
volume = {679},
pages = {136369},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136369},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014666},
author = {Takafumi Hajika and Yosuke Yamakawa and Taro Uchida},
keywords = {Peak lag time, Propagation speed, High-relief, Meso-scale, Contributing area},
abstract = {Understanding flood propagation in mountainous areas during heavy rainfall is crucial for disaster prevention. A previous study on flood propagation reported that the hillslope lag time is extremely short and almost negligible in meso-scale (1–10 km2) and medium-relief catchments. However, hydrological observations during heavy rainfall events in high-relief meso-scale catchments remain scarce. Therefore, this process has rarely been discussed. This study aimed to clarify flood propagation in high-relief meso-scale catchments with long and steep hillslopes. Seven mountain catchments (0.16–9.01 km2) underlain by accretionary sedimentary rock in Japan were investigated. Rainfall and water-level data over approximately 1.5 years were analyzed. The modal flow path lengths in the channel and hillslope at each site were calculated, and their relationships to the peak lag time (the time difference between rainfall and runoff peaks) were analyzed. Events showing a significant positive correlation between modal channel length and peak lag time accounted for only up to 15% of all events; in these events, hillslope lag time was estimated to be relatively uniform and extremely short (mean: −0.84 min; maximum: 160 min). This rapid hillslope response was confirmed even when the contributing area expanded. Conversely, some events exhibited a significant negative correlation. Although the lag time in larger catchments was similar to that observed in positively correlated events, a remarkably long peak lag time occurred in smaller catchments. This suggests that the initial rainfall loss and groundwater contribution may have been relatively greater in smaller catchments.}
}
@article{ZHENG2026136300,
title = {A path-driven structural evolution framework for SWRC hysteresis inspired by pore expansion and contraction processes},
journal = {Journal of Hydrology},
volume = {679},
pages = {136300},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136300},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013971},
author = {Shiwei Zheng and Gang Chen and Chuanhai Wang and Yue Yu},
keywords = {Soil water retention curve, Unsaturated soil, Hysteresis, Path-driven framework, Pore-scale effects, Scanning curves},
abstract = {Despite extensive development of soil water retention curve (SWRC) models, hysteresis effects are often neglected or represented in simplified forms, and a generally applicable approach for incorporating hysteresis into conventional formulations remains limited. This study presents a path-driven structural evolution framework for modeling SWRC hysteresis, inspired by pore expansion and contraction processes. The proposed framework introduces a hysteresis mechanism into conventional SWRC models through four additional parameters. It provides an implicit representation of pore-scale structure by controlling the evolution of a pore size factor, thereby governing the width of hysteresis loops as well as the curvature and transition behavior between wetting and drying paths, without modifying the original functional forms of the selected models. Application of the framework to 10 SWRC models and 20 soil samples from the UNSODA database shows stable and consistent performance across a representative range of soil textures, with an average RMSE of 0.0133, while the majority of samples exhibit RMSE values below 0.025. Furthermore, analysis of higher-order scanning curves demonstrates that the framework can reproduce key features of path-dependent hysteresis, including main drying and wetting cycles and intermediate scanning behavior. Comparison with the widely used Kool-Parker hysteresis model further demonstrates that the proposed framework provides a more flexible representation of scanning behavior while requiring only one main drying or main wetting curve for primary curve characterization, with framework parameters calibrated from observed data.}
}
@article{WANG2026136345,
title = {Mapping new pre-consolidation head, safe pumping buffer, and safe pumping volume for groundwater management in post-subsidence cities: a case study from Houston, Texas},
journal = {Journal of Hydrology},
volume = {679},
pages = {136345},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136345},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014423},
author = {Guoquan Wang},
keywords = {Intrinsic vertical hydraulic gradient, Groundwater management, Post-subsidence, New pre-consolidation head, Safe pumping buffer, Safe pumping volume},
abstract = {The New Pre-Consolidation Head (NPCH), Safe Pumping Buffer (SPB), and Safe Pumping Volume (SPV) are critical thresholds for the safe use of groundwater resources without reactivating land subsidence in post-subsidence urban areas. NPCH refers to the hydraulic head in a confined aquifer system at the time subsidence ceased; as long as heads remain above this level, permanent subsidence will not resume. SPB represents the difference between the current hydraulic head and the NPCH, indicating the maximum permissible hydraulic head decline before subsidence is reactivated. SPV estimates the maximum volume of groundwater that can be safely extracted within the SPB limit. Although these concepts are well-established theoretically, their practical application is hindered by the complex temporal and spatial variability of hydraulic heads in thick confined aquifer systems, as well as limitations in field monitoring data such as the spatial density and temporal coverage of monitoring wells. This study demonstrates practical approaches for mapping NPCH, SPB, and SPV in Harris-Galveston Subsidence District (HGSD) of southeast Houston, Texas. The resulting maps reveal significant spatial variability in subsidence vulnerability and available safe reserves. Critically, the NASA-Clear Lake area—a densely populated high-technology hub hosting the NASA Johnson Space Center—retains only approximately 5 m of SPB as of 2025, implying that increased groundwater pumping in this area could promptly reinitiate unrecoverable subsidence. In contrast, the adjacent Pasadena area maintains a substantially larger SPB of 24 m, with a corresponding SPV sufficient to serve as an emergency water source for neighboring zones. As of 2025, the total SPV across HGSD Areas 1 and 2 is estimated at about 58 MGD (million gallons per day) on an annual basis, equivalent to roughly 1.5 times recent annual groundwater use. The mapping techniques for NPCH, SPB, and SPV presented here are adaptable and can be implemented in other urban areas where subsidence has ceased.}
}
@article{ADOMBI2026136397,
title = {Ensembling or not? On the value of boosting and bagging for physics-aware machine learning in hydrology},
journal = {Journal of Hydrology},
volume = {679},
pages = {136397},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136397},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014940},
author = {Adoubi Vincent De Paul Adombi},
keywords = {Ensemble Machine Learning, Scientific Machine Learning, Physics-aware Machine Learning, Streamflow prediction, CAMELS-US},
abstract = {Ensemble machine learning methods such as bagging and boosting are widely used to improve predictive performance in hydrological modeling. However, their value when applied to physics-aware machine learning (PaML) models remains largely unexplored. This study investigates whether ensemble strategies provide tangible predictive gains over a standalone PaML model for streamflow simulation. Four controlled experiments were conducted on five representative catchments from the Catchment Attributes and Meteorology for Large-sample Studies dataset for the contiguous United States (CAMELS-US) to evaluate the influence of training epochs, base learner capacity, ensemble size, and training data length. Bagging, classical boosting, and a growth-based boosting formulation inspired by GrowNet were compared against both weak and well-configured single PaML models. Predictive performance was assessed using the Nash-Sutcliffe efficiency (NSE), the Kling-Gupta efficiency (KGE) and the normalized root mean square error (NRMSE). Results show that ensemble strategies do not yield substantial improvements over a properly configured standalone PaML model, despite requiring greater computational resources. While classical boosting can compensate for intentionally reduced model capacity by aggregating low-capacity PaML learners, the resulting gains remain marginal relative to a moderately expressive single model. Bagging provides limited additional benefits, and the growth-based boosting formulation exhibits non-monotonic and basin-dependent behavior. Overall, the findings suggest that, within the investigated framework, refining the architecture and capacity of a single PaML model is generally more effective than adopting ensemble strategies. These results contribute to clarifying the practical role of ensemble learning in physics-aware hydrological modeling.}
}
@article{SHAKYA2026136406,
title = {A generalized three-dimensional manifold for the Budyko hypothesis: analytical derivation and structural stability in open hydrological systems},
journal = {Journal of Hydrology},
volume = {679},
pages = {136406},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136406},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015039},
author = {Chandra Mohan Shakya and Rajib Kumar Bhattacharjya},
keywords = {SQX manifold, Three–dimensional Budyko framework, Openness parameter φ, GRACE uncertainty, Cross-validation, Brahmaputra Basin, Basin transferability},
abstract = {The classical Budyko framework assumes hydrological closure, limiting its applicability to basins influenced by glacier melt, groundwater depletion, reservoir regulation, or inter-basin water transfers. This study presents the ShakyaQX (SQX) manifold, a three-dimensional extension of the Budyko framework that represents hydroclimatic partitioning as a surface in (x, φ, E/P), where x = PET/P is the aridity index and φ = 1 + ΔS/P is a non-rescaled openness coordinate. Unlike input-rescaling approaches, SQX preserves the climatic coordinate while representing basin openness through a separate, non-rescaled dimension, relocating the associated input-rescaling singularity to the boundary of the admissible domain (φ → 0) and providing a single continuous formulation across storage-gain and storage-loss states. The formulation reduces exactly to the Mezentsev–Choudhury–Yang curve when φ = 1. Applied to the Brahmaputra Basin (2002–2021), SQX shows no annual-scale predictive advantage over the classical closed-system formulation (NSE =  − 1.407 versus − 0.601) for this basin, where annual φ ranges only from 0.92 to 1.09. At the monthly scale, however, SQX substantially outperforms the classical baseline for the 63 admissible months (NSE = 0.650 versus − 0.005), with performance retained under leave-one-out cross-validation and GRACE Monte Carlo uncertainty propagation. Independent application to seven GRDC-gauged basins in the monsoon-dominated Irrawaddy–Chindwin system shows that SQX does not outperform the classical formulation in six of seven basins. Diagnostic analyses attribute this to numerical conditioning of φ under low dry-season precipitation, rather than to basin size, measurement noise, or failure of the openness concept, thereby defining an explicit boundary condition for the present implementation.}
}
@article{WANG2026136018,
title = {Spectral-enhanced cross-domain network: a novel daily runoff prediction model based on energy amplification and cross-domain multi-scale collaboration},
journal = {Journal of Hydrology},
volume = {679},
pages = {136018},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136018},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011157},
author = {Ruohan Wang and Tao Yang},
keywords = {Hydrological prediction, Deep learning, Frequency-domain modeling, Cross-domain collaboration, Extreme events},
abstract = {Accurate daily runoff forecasting is essential for water resources management and flood early warning, particularly in the context of intensifying climate change and anthropogenic pressures. However, existing deep learning models exhibit a spectral bias—a tendency to prioritize low-frequency trends over high-frequency signals—resulting in extreme- value smoothing that masks critical information about peak flows. Furthermore, single-perspective modeling paradigms struggle to disentangle the complex nonlinear dependencies of hydrological processes across the frequency, feature, and time domains. To address these challenges, we propose the Spectral-Enhanced Cross-domain Network (SEC), a novel daily runoff forecasting model that integrates a spectral energy modulator with cross-domain multi-scale collaboration. First, the Spectral Energy Modulator is proposed to enhance the capability of capturing flood rising points and low-flow fluctuations, mitigating the extreme-value smoothing problem inherent in traditional models by adaptively amplifying and recovering weak high-frequency abrupt signals in the frequency domain. Second, a Cross-Domain Multi-Scale Collaboration Mechanism is constructed, integrating Seasonal-Trend Decomposition, the Semi-Channel Interaction Block, and the Multi-scale Temporal Graph Neural Network. This architecture jointly models physical component separation, multivariate coupling, and local–global dependencies, providing a unified framework for non-stationary hydrological sequences. Experimental results conducted on natural catchments across six representative stations representing diverse hydro-climatic regions in the United States demonstrate that the SEC model comprehensively outperforms nine mainstream benchmark models, including PatchTST and TimesNet, in terms of NSE, KGE, MAE, and RMSE. SEC model achieved maximum NSE and KGE values of 0.977 and 0.986, respectively, reducing MAE by 0.6%–84.9% and RMSE by 2.8%–80.1%. This study demonstrates the utility of spectral energy modulation and cross-domain multi-Scale collaboration for modeling non-stationary hydrological sequences. The proposed framework provides an improved approach for analyzing extreme hydrological events and has potential for assisting in short-term extreme event forecasting.}
}
@article{ZHOU2026136396,
title = {A dual-threshold framework for antecedent wetness controls on hydrological connectivity and nitrate source dynamics in a subtropical agricultural watershed},
journal = {Journal of Hydrology},
volume = {679},
pages = {136396},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136396},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014939},
author = {Jia Zhou and Hao Wu and Yucang Wang and Xinyi Jiao and Yuhan Han and Hongrui Wu and Qi Ling and Yi Pan and Zheqi Pan and Sijie Li and Kexin Xu and Guangle Dong and Xiaochen Liu and Minpeng Hu and Dingjiang Chen},
keywords = {Antecedent precipitation index, Baseflow index, Hydrological connectivity, Stable isotopes, Nitrogen source},
abstract = {Season-based hydrological classifications often fail to resolve the short-term wetness controls that reorganize connectivity and nitrate transport in monsoon-influenced agricultural catchments. To address this issue, daily precipitation and discharge records (1980–2023) were combined with monthly hydrochemical monitoring and dual isotopes of water (δ2H-H2O, δ18O-H2O) and nitrate (δ15N-NO3–, δ18O-NO3–; 2014–2023) from six monitoring sites in a subtropical agricultural watershed in eastern China. A 7-day antecedent precipitation index (API7) and the daily baseflow index (BFI) identified two operational thresholds: 34.3 mm for initial hydrological activation and 133 mm for saturated connectivity. These thresholds partitioned the hydrologic record into Baseflow, Transition, and Storm regimes, representing 68.4 %, 29.2 %, and 2.4 % of the record, respectively. Water isotopes showed that the first threshold mainly reflected increased discharge through displacement of stored, evaporatively enriched pre-event water, whereas the second threshold marked a stronger contribution of event water and a pronounced decline in specific conductance. In contrast, riverine NO3– concentrations changed only modestly at most sites. However, NO3– isotopes and MixSIAR revealed marked regime-dependent source reorganization in spite of the weak concentration response, with lower δ15N-NO3– values and shifts in the relative contributions of fertilizer-, soil-, and sewage-derived NO3– across human-impacted sub-catchments. Random Forest analyses further showed that specific conductance and δ15N-NO3– remained consistent predictors of NO3– variability, whereas antecedent wetness, dissolved oxygen, and δ18O-H2O became more influential under Storm conditions. Overall, antecedent wetness governed not only runoff partitioning but also when cryptic NO3– source switching became hydrologically expressed, providing a process-based alternative to conventional dry/wet seasonal classification.}
}
@article{ABBAS2026136364,
title = {Contrasting hydrologic pathways controlling nitrate and phosphorus transport in an agricultural critical zone},
journal = {Journal of Hydrology},
volume = {679},
pages = {136364},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136364},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014617},
author = {Salam A. Abbas and Ryan T. Bailey and Jeffrey G. Arnold and Michael J. White and Natalja Čerkasova},
keywords = {Coupled surface–subsurface modeling, Nutrient transport, Sensitivity analysis, Ensemble calibration, Agricultural watersheds, SWAT+},
abstract = {Understanding the influence of hydrologic processes on nutrient transport remains a critical challenge in agricultural watersheds, where nitrate (N) and phosphorus (P) often exhibit contrasting export patterns. In this study, we developed a coupled surface–subsurface modeling framework using SWAT + integrated with the gwflow module to simulate hydrologic fluxes and nutrient transport in the Choptank River watershed, USA. An unstructured (quadtree) groundwater grid was implemented in the SWAT + gwflow module to improve representation of groundwater gradients near tile drains and channels. The model was calibrated and tested using the iterative ensemble smoother (iES) and evaluated against streamflow, groundwater head, and annual nutrient loading observations. The Morris global sensitivity analysis method was applied to identify and rank the dominant hydrologic controls on streamflow, groundwater dynamics, and nutrient transport. The coupled SWAT + gwflow framework identified distinct hydrologic controls governing streamflow, groundwater dynamics, and nutrient transport. Streamflow is primarily controlled by surface runoff generation, soil water retention, and channel conveyance, whereas groundwater dynamics are governed by aquifer properties and drainage mechanisms. The sensitivity analysis indicates that simulated nitrate transport is primarily influenced by soil nutrient processes and subsurface flow pathways (e.g., percolation and groundwater connectivity), whereas simulated phosphorus transport appears to be more strongly associated with fertilizer inputs and surface/aquatic processes, reflecting event-based mobilization through runoff and sediment transport. Basin-scale flux analysis further indicates that surface processes control short-term variability, whereas subsurface processes regulate longer-term (“legacy”) transport. These findings demonstrate the capability of the coupled surface–subsurface framework to diagnose hydrologic pathway partitioning governing nutrient transport within the critical zone. They also highlight limitations of single-objective calibration, as parameters controlling subsurface processes (relevant to nitrate) differ from those governing surface processes (relevant to phosphorus). This study provides a mechanistic framework linking hydrologic controls to nutrient-specific transport pathways and offers guidance for improved model calibration and targeted nutrient management in agricultural systems.}
}
@article{ZHENG2026136360,
title = {Depth-dependent freeze–thaw propagation and antecedent controls on post-thaw soil water storage in a seasonally frozen basin},
journal = {Journal of Hydrology},
volume = {679},
pages = {136360},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136360},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014575},
author = {Shunsheng Zheng and Fei Chen and Quanshan Liu and Ningbo Cui and Tianao Wu and Zhihui Wang},
keywords = {Freeze–thaw, Soil water storage, Antecedent moisture, Soil moisture memory, Spatial persistence, Thaw lag},
abstract = {Seasonally frozen soils undergo vertically asynchronous freeze–thaw transitions, but the relative roles of antecedent wetness and winter thermal conditions in shaping post-thaw profile storage remain unclear. We analyzed observations from 34 sites in the Shandian River Basin over three cold seasons (2019–2022), with soil temperature and water content monitored at 3, 5, 10, 20, and 50 cm. Freeze–thaw phenology, monitored-profile thaw completion, autumn-to-spring changes in soil water storage (SWS), within–between decomposition, hierarchical regression, and spatially structured validation were evaluated. Stable freezing and thawing at 50 cm occurred 16 and 8 d later than at 3 cm, respectively, while freezing degree days declined by 49.7%. Median monitored-profile thaw completion lagged stable thaw at 3 cm by 3 d for 0–20 cm and 9 d for 0–50 cm, although maximum observed lags reached 31 and 34 d. Median post-thaw SWS exceeded pre-freeze SWS by 32% and 23% in the two profiles. Between-site persistence dominated the 0–20 cm relationship (β = 0.857 versus 0.137 within sites), whereas the 0–50 cm profile showed a weaker between-site coefficient and a larger, window-sensitive within-site coefficient (β = 0.600 and 0.329). Models containing pre-freeze SWS and winter fixed effects explained 78.5% and 62.8% of post-thaw variation; the partial R2 of pre-freeze SWS was 0.626 and 0.567, whereas freeze–thaw descriptors added only 0.8 and 3.2 percentage points. Antecedent-only models yielded R2 = 0.765 and 0.572 under station-grouped cross-validation and pooled R2 = 0.615 and 0.573 under spatially blocked validation, although performance varied among individual spatial blocks. These results distinguish the thermal timing of monitored-profile thaw from the antecedent-state dependence of post-thaw storage and indicate greater uncertainty in predicting deeper-profile SWS.}
}
@article{HEMACHANDRA2026136308,
title = {Soil-crop hydrology modelling approaches for conjunctively estimating recharge, crop demand and pumping in irrigated agriculture: a review},
journal = {Journal of Hydrology},
volume = {679},
pages = {136308},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136308},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014058},
author = {E.M.G.P. Hemachandra and L.P. Reading and A.D. Werner and P. Egodawatta},
keywords = {Water resources, Soil-crop hydrology models, Unsaturated zone, Groundwater management, Salinity, Crop growth},
abstract = {Soil-crop hydrology models are frequently used to estimate regional-scale groundwater recharge, crop water use, runoff and freshwater extraction rates to support irrigation demands. Because interactions between soils, crops and irrigation practices influence recharge, crop water requirements and pumping, it is important to apply models that can simulate these processes simultaneously. This review examines 16 soil-crop hydrology models and 13 case study applications in which recharge, irrigation demand and extraction rates (i.e., from surface water and/or groundwater) were estimated to support regional water accounting and water-resource investigations. Model functions for runoff, soil water movement, root water uptake, crop growth and irrigation were compared to identify differences between models and their limitations. This review showed that 13 of the 16 models incorporate crop growth simulation linked to soil water dynamics, while 7 also account for salinity stress. Twelve models allow irrigation to be triggered based on soil water content, with 4 also allowing irrigation to respond to crop stress factors. The reliability of soil-crop hydrology models for estimating pumping rates remains uncertain because pumping was validated against metered data in only 2 of the 13 case studies reviewed. In those studies, metered extraction data provided important constraints on model parameterisation. Although runoff was simulated, it was reconciled with field observations in only 1 of the 13 case studies. Soil-crop hydrology models remain important tools for estimating recharge and irrigation demand, however, the representation of conjunctive use of groundwater and surface water, and the resulting pumping estimates, are commonly imposed externally and remain weakly validated against field observations.}
}
@article{ZHANG2026136425,
title = {Contrasting effects of arsenic and cadmium on PFAS transport in soils: Mechanistic insights and mathematical models},
journal = {Journal of Hydrology},
volume = {679},
pages = {136425},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136425},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015222},
author = {Wei Zhang and Yajing Wang and Xueqi Zhang and Boyun Ma and Yuting Wang and Bingyue Guo and Dongmei Zhou and Qiming Xian},
keywords = {PFAS-HMs co-contamination, Batch and column methods, Interaction mechanisms, Nonequilibrium transport model, Long-term transport},
abstract = {PFAS and heavy metals (HMs) coexist in contaminated sites mainly due to chemical production and waste disposal. This study comprehensively investigated the transport behaviors PFOS, PFOA, and PFHxS under coexisting As(V)/Cd(II) in water-saturated soils. Combining batch experiments, column tests, and Hydrus-1D, the retention and transport dynamics of PFAS were examined. Sorption affinity followed the order: PFOS > PFOA > PFHxS, while the opposite order was observed for desorption and transport. At 500 μg/L, breakthrough curves (BTC) of PFOA and PFHxS are generally symmetric, but the BTC of PFOS displays a nonideal transport. Critically, As(V) accelerated PFOS transport by 9.4–34.9% through pH-induced repulsion and site competition, while Cd(II) enhanced PFOS retention by 61.6–86.8% through electrostatic attraction and cation bridging. Hydrophobic interactions, electrostatic forces, and HMs speciation play critical roles in determining the fate of PFAS. Furthermore, multiple PFAS transport datasets were used to validate a mathematical model incorporating advection–dispersion and chemical nonequilibrium sorption, and the model was applied for the first time to simulate the PFAS transport in the saturated zone affected by HMs. Long-term simulation (50 years) showed that As(V) accelerates PFOS migration to groundwater (5 m), whereas Cd(II) restricts its penetration to a depth of 0.2 m. Given weak sorption, PFOA and PFHxS quickly leach downward and threaten groundwater safety within 10 years. This study developed predictive frameworks for PFAS-HMs transport and risk assessment in industrial sites, enhancing priority management and remediation strategies based on the characteristics of co-contaminants to protect the soil environment and groundwater sources.}
}
@article{MO2026136328,
title = {Optimal reservoir flood-control operation under successive rainfall events during the Meiyu season},
journal = {Journal of Hydrology},
volume = {679},
pages = {136328},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136328},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014253},
author = {Yuchang Mo and Yunfei Li and Shuaisen Ma and Qingan Qiu and Rui Peng},
keywords = {Reservoir flood-control operation, Meiyu season, Successive rainfallevents, Marked Hawkes process, Staged spillway operation},
abstract = {Reservoir flood-control operation during the Meiyu season is challenged by successive rainfall events, compound flood-wave superposition, and the conflicting objectives of flood safety and operational economy. Existing studies often represent rainfall uncertainty through independent events or aggregated inflow scenarios, which may overlook the temporal clustering and self-exciting characteristics of successive Meiyu rainfall events. This work develops a dynamic staged spillway-operation framework for reservoir flood-control scheduling under clustered rainfall conditions. A marked Hawkes process is employed to characterize the stochastic occurrence and temporal dependence of successive rainfall events, while a duration-corrected Gamma response kernel is introduced to describe the runoff generation and superposition process. Based on these components, a threshold-driven scheduling model is established, in which spillway operation levels are adaptively adjusted according to the real-time conditional non-failure probability. The optimal threshold structure is obtained by minimizing the expected operating cost through a nested Monte Carlo simulation framework coupled with particle swarm optimization. A case study of the Xin’anjiang Reservoir demonstrates that the proposed framework provides a better balance between flood-control reliability and operational cost compared with empirical, conservative, and aggressive scheduling strategies. Further analyses reveal that rainfall clustering characteristics, runoff-response parameters, and initial reservoir storage conditions significantly influence the optimal operation strategy. The proposed framework offers a risk-responsive and cost-aware approach for reservoir flood-control operation under successive rainfall events during the Meiyu season.}
}
@article{LI2026136304,
title = {Vegetation change reshapes meteorological-hydrological drought characteristics and propagation process in the Yellow River Basin, China},
journal = {Journal of Hydrology},
volume = {679},
pages = {136304},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136304},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014010},
author = {Xiaoyang Li and Jun Xia and Beibei Hu and Xuanxuan Wang and Lingling Bin and Xilong Wang and Juan Zhang and Guangpeng Wang},
keywords = {Meteorological drought, Hydrological drought, Vegetation change, Drought propagation, Drought characteristics},
abstract = {Current large-scale global vegetation restoration has profoundly altered the terrestrial water cycle, but its feedback regulation on drought evolution warrants deeper investigation. Taking the Yellow River Basin (YRB) from 2001 to 2024 as a case study, this research employed a distributed hydrological model incorporating vegetation dynamics (DTVGM-PT-JPL) to derive meteorological (SPEI) and hydrological drought indices (SRI) from simulation results under changing and constant vegetation scenarios, thereby linking vegetation with drought and evaluating how vegetation change in YRB regulated drought characteristics and propagation processes. Results showed that meteorological and hydrological droughts across YRB generally weakened during the study period due to the warming-wetting climate tendency in upstream regions, while scenario comparison indicated that the characteristics of both drought types exhibited asymmetric sensitivity to vegetation change. In the middle reaches where vegetation restoration was significant, the frequency, duration, and intensity of hydrological drought increased beyond the extent of meteorological drought. The propagation process from meteorological to hydrological drought also exhibited spatial heterogeneity, with shorter propagation times and higher probabilities in the middle and lower reaches, while the upper reaches showed the opposite patterns. Compared to the vegetation constant scenario, the vegetation change scenario exhibited a shorter drought propagation time within the basin and exerted a nonlinear amplifying effect on drought propagation across different severity levels. The vegetation change driven by restoration in YRB primarily raised the probability and thresholds for meteorological drought to trigger mild and moderate hydrological droughts under the adopted scenario framework, but this enhancement gradually weakened as hydrological drought severity increased. These research findings can provide scientific reference for synergistic management of ecological restoration and drought risk at the basin scale.}
}
@article{SHI2026136320,
title = {Rainfall selectivity in large dry heatwave events across the contiguous United States},
journal = {Journal of Hydrology},
volume = {679},
pages = {136320},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136320},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014174},
author = {Yajie Shi and Wei Dai and Xiangrui Xu and Yuyou Zhi and Xi Zhang and Yinglong Chen and Weijun Fu},
keywords = {Heatwaves, Rainfall, Lagrangian event tracking, Hydroclimatic extremes, Rainfall propagation},
abstract = {Large dry heatwave events are generally treated as rainfall-suppressed extremes, yet whether rainfall can still emerge within these dry-hot envelopes, and under what controls, remains unclear. Here we analyse 821 large summer dry heatwave events across the contiguous United States during 1950–2024 using an event-based Lagrangian framework that tracks retained heatwave envelopes, rainfall propagation and local candidate-front realization. Rainfall was not uniformly excluded from these events. Instead, rainfall realization was spatially reorganized: at the main threshold of ≥ 1 mm d–1, the United States-mean trend was weak (−0.13 percentage points per decade), but this masked a much stronger eastern increase (+1.09 percentage points per decade). Larger heatwave envelopes also did not translate into proportional rainfall occupation: event-scale area coupling between heatwave and rainfall extent weakened from r = 0.64 at ≥ 1 mm d–1 to r = 0.33 at ≥ 5 mm d–1, while zero-rain events increased from 49 to 357. Heatwave geometry constrained rainfall propagation more strongly in distance than in direction, with displacement coupling remaining positive but weakening from r = 0.79 to r = 0.59 as rainfall intensity increased. At the local front scale, realized rainfall cells were preferentially selected towards stronger humidity, moisture convergence and instability support, and four-variable discrimination skill increased from an AUC of about 0.74 at ≥ 1 mm d–1 to about 0.84 at ≥ 5 mm d–1. These results show that large dry heatwaves are not uniformly rain-free hazards, but spatially selective hydroclimatic structures in which rainfall can still be realized where atmospheric moisture, convergence and instability provide local support within an otherwise dry-hot envelope.}
}
@article{FU2026136372,
title = {Glacial meltwater-driven suppression of riverine methane emissions in the high-altitude cryospheric regions},
journal = {Journal of Hydrology},
volume = {679},
pages = {136372},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136372},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014691},
author = {Jiaxing Fu and Tanguang Gao and Meilin Chen and Xuexue Shang and Yulan Zhang and Liwei Zhang and Yongqin Liu and Shichang Kang},
keywords = {Riverine CH emissions, Cryosphere, Glacial meltwater, High altitude, Headwater rivers},
abstract = {Headwater streams are widely recognized as hotspots of riverine methane (CH4) emissions; however, this understanding remains to be clarified in high-altitude cryospheric regions by the overriding influence of glacial meltwater. Based on chamber measurements from a four-year monitoring program (2020–2023) across 16 non-glacier-fed and 9 glacier-fed riverine sampling sites in the upper Heihe River of the northern Tibetan Plateau, we investigated the spatiotemporal dynamics of CH4 and evaluated the role of glacial meltwater in regulating riverine CH4 emissions. The results indicated that the downstream riverine sections of the upper Heihe River basin were weak atmospheric CH4 sources (0.39 ± 0.02 t CH4 yr−1). The riverine CH4 fluxes showed no significant correlation with river orders. This deviation is attributed primarily to the potent inhibitory effect of glacial meltwater. This suppression mechanism consists of a dual regulatory process: (1) thermal regulation, namely the relatively low temperatures of glacier meltwater can inhibit methanogenesis, and (2) biogeochemical dilution, namely the oligotrophic meltwater further reduced key methanogenic substrates (e.g., dissolved organic carbon). Consequently, the suppression can disturb seasonal variations in glacier-fed rivers and reduce overall watershed emissions by 13% ± 7% relative to a non-glacier-fed scenario. This study proposes a new conceptual framework for cryosphere-regulated hydro-biogeochemical coupling, highlighting the necessity of integrating these unique mechanisms into carbon cycle models for cryospheric regions.}
}
@article{KUMARI2026136312,
title = {Improving predictions of annual nutrient and sediment loads across the Southeast United States with refined SPARROW model parameters},
journal = {Journal of Hydrology},
volume = {679},
pages = {136312},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136312},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014095},
author = {Anjali Kumari and Ebrahim Ahmadisharaf and Victor Roland and Sumon Hossain Rabby},
keywords = {Water quality modeling, Nutrients, Suspended sediment (SS), SPAtially Referenced Regression On Watershed attributes (SPARROW), Multi-scale model evaluation},
abstract = {Limited research has focused on predicting nutrients and sediments across large regions. The SPAtially Referenced Regression on Watershed attributes (SPARROW) is a primary example of a regional water quality model for the Contiguous United States. In some regional versions of the model, such as the Southeast SPARROW model, urban land cover is the only explicit land cover source term, limiting its ability to fully account for underlying nutrient and sediment processes. Here, we refined the Southeast model (1.6 million km2) by introducing cropland, pasture, forest and wetland as explicit diffuse source and delivery terms, coupling land cover with Soller surficial geology classifications to represent geology-dependent sediment generation and re-estimating land-to-water delivery and in-stream transport/decay parameters. The refined model (RSPARROW) was calibrated against estimated mean annual loads of total nitrogen (TN), total phosphorus (TP) and suspended sediment (SS) at ∼600 monitoring stations across the Southeast United States. Compared to the baseline model, the refined RSPARROW improved Kling–Gupta efficiency by up to 21% for TP (0.58–0.70), with predictive uncertainty reduced by up to 31.5% for SS. Improvements were generally greater at smaller spatial scales, in catchments with milder slopes and in homogeneous, low-relief ecoregions in terms of all water quality parameters; the relationship between ground slope and model performance was stronger at larger spatial scales. The refined model can be used to more accurately predict annual loads and yields of nutrients and sediment across the Southeast United States and support coordinated water quality management among agencies charged with pollution control.}
}
@article{RUSJAN2026136409,
title = {Investigating streamflow dynamics in heterogeneous catchments through sensitivity function analysis},
journal = {Journal of Hydrology},
volume = {679},
pages = {136409},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136409},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015064},
author = {Simon Rusjan and Klaudija Lebar and Mojca Šraj},
keywords = {Heterogeneous catchments, Karst springs, Torrential streams, Discharge recession, Sensitivity function, Antecedent hydrological conditions},
abstract = {Comprehending hydrological responses in heterogeneous catchments poses a considerable challenge, primarily due to the spatial variability and complexity of rainfall-runoff processes. This study investigates the streamflow recession behavior within the Vipava River catchment in southwestern Slovenia. The catchment is characterized by contrasting hydrogeological regions, including karst plateaus and impermeable flysch valleys. The analysis focuses on comparing the karst spring-fed upper Vipava river and the torrential Branica stream draining flysch areas. An analysis of long-term daily discharge data was conducted to extract information on streamflow recession. The catchment sensitivity functions were derived to discern discrepancies in hydrological response under varying antecedent conditions. The karst spring sensitivity function exhibits sustained discharge, with activation of underground karst conduits during periods of high flow. Conversely, the flysch-dominated Branica stream demonstrates rapid increases and fast recession, leading to extremely low flows and possible drying out during extended rainless periods. The results highlight the information content of discharge recession data for identifying spatial heterogeneity and distinct flow mechanisms in catchments with different storage characteristics. When expressed through catchment sensitivity functions, this recession-derived information can be incorporated into diagnostic hydrological simulations to compare the hydrological responses of heterogeneous catchments and improve understanding of their functioning under contrasting antecedent conditions.}
}
@article{LAZZARIN2026136384,
title = {P-FLOOD: a probabilistic framework for flood hazard mapping in levee-protected floodplains},
journal = {Journal of Hydrology},
volume = {679},
pages = {136384},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136384},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014812},
author = {T. Lazzarin and A. Domeneghetti and R. Vacondio and M. Marani and D.P. Viero},
keywords = {Probabilistic flood mapping, Levee breaching, Flood hazard assessment, Hydraulic modelling, Flood risk analysis},
abstract = {The paper presents a probabilistic framework for mapping hazard induced by river floods in levee-protected floodplains. Large-scale hazard maps of water depth (or any other hazard variable) are derived from the corresponding cumulative probability distributions, estimated throughout the domain from a set of flood simulations that combine different inflow hydrographs and multiple levee-failure scenarios. For each simulation, levee breach probabilities are estimated using fragility functions conditioned on the local hydraulic loading. By accounting for the joint probability of hydrological and breaching events, the method enables a probabilistic characterization of hazard metrics and produces hazard maps associated with any exceedance probability, without being constrained by the discrete return periods of the hydrological inputs. Flood simulations require integrated two-dimensional hydrodynamic models to include flood routing, breach formation, and ensuing floodplain inundation. To limit the computational load, a scalable parent–child strategy is proposed to reduce the number of simulations while retaining acceptable accuracy in the estimated probability field. Moreover, the available simulations can be reused to recompute hazard maps at negligible cost to consider changes in the probability of hydrological and/or breaching events (due to climate change, levee reinforcements, etc.). The framework is applied to a pilot case study in the Adige River (Northern Italy), considering fragility functions for overflow-induced failures and a flood-prone area of ∼100 km2. The results suggest that, if supplied with realistic estimations of levee fragility, P-FLOOD can provide improved hazard predictions compared with traditional approaches, especially for frequent flood events, thereby supporting more informed flood risk management and planning.}
}
@article{LI2026136400,
title = {Heavy metal accumulation and biological responses at sediment-microplastic interface in hyporheic zone: the importance of dissolved organic matter},
journal = {Journal of Hydrology},
volume = {679},
pages = {136400},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136400},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014976},
author = {Bingjie Li and Jiayuan Feng and Jinxi Song and Qi Li and Ruichen Mao and Wanying Xu},
keywords = {Aquatic ecosystem, Emerging pollutants, Composite pollution, Periphytic algae, Loess Plateau},
abstract = {The competitive adsorption of heavy metals (HMs) in the river hyporheic zone at the interface between sediments and microplastics (MPs) poses a serious threat to aquatic organisms and ecological safety. Focusing on HMs pollution in the Beiluo River hyporheic zone, a typical river on the Loess Plateau, this study systematically explored the multi-interface distribution characteristics of HMs, the potential mediating role of dissolved organic matter (DOM), and its impact on periphytic algae. Per unit mass, MPs exhibited a strong accumulation potential for HMs (As, Pb, Cr, Cu, and Cd). DOM in the hyporheic zone was mainly composed of micro-sourced humic-like, endogenous protein-like, and terrestrial humic-like; its spatial evolution was driven by redox conditions, salinity background, and adsorption of mineral cations. Statistical modeling suggests that DOM is closely associated with the interface distribution of HMs, directly driving and indirectly transferring them from the external environment. High-molecular-weight terrestrial humic-like substances promote the accumulation of HMs in sediments, whereas low-molecular-weight protein-like and microplastic-heavy metal (MP-HM) have a more closely related distribution pattern. Most importantly, HMs pollution in sediments has a high explanatory power on the biomass of periphytic algae, and the interaction between MP-HM and DOM significantly drives the distribution of periphytic algae. This finding deepens the understanding of the driving mechanism of composite pollution in complex systems and provides scientific support for the bioremediation and refined ecological management of emerging pollutants in watersheds.}
}
@article{LIU2026136324,
title = {Asynchronous response relationships between groundwater recharge and river–aquifer exchange in the urbanized karst river basin},
journal = {Journal of Hydrology},
volume = {679},
pages = {136324},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136324},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014216},
author = {Jialu Liu and Jie Niu and Mingxia He and Bin He and Bill X. Hu and Pan Wu},
keywords = {Urbanized karst watershed, SWAT–MODFLOW, Groundwater recharge, Aquifer storage, River–aquifer exchange, Nanming River Basin},
abstract = {Urbanized karst watersheds are characterized by strong heterogeneity in groundwater recharge, aquifer storage change, and river–aquifer exchange. However, under the combined influence of karstification and urbanization, the temporal response relationships among recharge input, aquifer storage dynamics, and river–aquifer exchange remain insufficiently quantified. In this study, these coupled processes were investigated in the Nanming River Basin, a representative urbanized karst watershed in southwestern China. A coupled SWAT–MODFLOW model was developed to simulate groundwater recharge, aquifer storage change, and river–aquifer exchange. The model reproduced the main seasonal patterns of streamflow and groundwater levels, with streamflow R2 and NSE values of 0.55–0.85 and 0.51–0.83, respectively, and groundwater-level BIAS values of −0.020 m and −0.352 m at the two observation wells. The results show that groundwater recharge exhibited pronounced temporal pulsing and spatial heterogeneity. High recharge cells accounted for 25.03% of the active model area but contributed 79.38% of the total recharge. Recharge generated by SWAT and transferred to MODFLOW showed strong temporal consistency, indicating that the coupled framework effectively propagated recharge signals. In contrast, river–aquifer exchange varied more gradually and lagged groundwater recharge by 2 days in the coupled-model outputs. Across the 24 selected month-end output days, the Nanming River generally functioned as a gaining river, with positive net exchange occurring in 95.8% of the analyzed output periods and a cumulative net exchange of 3.61 × 106 m3. River–aquifer exchange also showed clear spatial concentration, with a few key river-connected subbasins contributing most of the cumulative net exchange. These findings indicate that groundwater recharge, aquifer storage change, and river–aquifer exchange do not respond as a simple synchronous system. The buffering role of aquifer storage and the detailed mechanisms underlying the asynchronous response require further verification.}
}
@article{GU2026136376,
title = {MEDAL: a mechanism-embedded dual-physics attention learning framework for snowmelt-driven runoff prediction in cold-region basins},
journal = {Journal of Hydrology},
volume = {679},
pages = {136376},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136376},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014733},
author = {Miao Gu and Wen-chuan Wang and Kun-mei Luo and Can-can Shi and Dong-mei Xu},
keywords = {Snowmelt-driven runoff prediction, Mechanism-embedded deep learning, Dual-physics attention mechanism, Physical interpretability, Cold-region hydrology},
abstract = {This study proposes a Mechanism-Embedded Dual-Physics Attention Learning (MEDAL) framework for daily runoff prediction in snowmelt-driven cold-region basins. As an architectural improvement to existing physics-guided hybrid modeling approaches, MEDAL employs the snowmelt-enhanced conceptual model SIMHYD-Snow as an upstream physical feature extractor to obtain static calibrated parameters and dynamic physical states, including snow water equivalent, soil moisture, and groundwater storage. These two types of information characterize the relatively stable physical boundary conditions of a basin and its dynamic hydrological memory, respectively. Building on this foundation, a dual-physics attention mechanism embeds both types of physical priors into meteorologically driven temporal representations, enabling them to jointly guide the selection of historical information across different hydrological stages. MEDAL achieved the best performance across all eight evaluation metrics in the five study basins. Ablation analyses in three representative basins further showed that, compared with the ablated models, MEDAL reduced mean absolute error (MAE) and root mean square error (RMSE) by an average of 31.3%–51.1% and 24.2%–35.2%, respectively, and its advantages across the five overall evaluation metrics were statistically significant (Holm-adjusted p < 0.001). Evaluations by year, season, and representative snowmelt event showed that MEDAL generally maintained stable advantages across different temporal subsets. Supplementary comparisons with two benchmark models adapted from recent physics-guided hybrid architectures further supported these findings. Under scenarios with 10% noise or missing data, the model achieved Nash–Sutcliffe efficiency (NSE) values above 0.9, indicating good robustness to data perturbations. Its one-step joint inference latency ranged from 1.35 to 2.17 ms, demonstrating the computational efficiency required for daily runoff prediction. The results indicate that, under the data and experimental conditions of this study, MEDAL can balance predictive accuracy, physical consistency, process interpretability, and computational efficiency, providing a physics-guided hybrid modeling approach for snowmelt-driven runoff prediction in cold regions.}
}
@article{ZHANG2026136371,
title = {From precipitation forecasts to optimal reservoir operation: an integrated downscaling-forecasting-operation framework for reservoir floodwater utilization},
journal = {Journal of Hydrology},
volume = {679},
pages = {136371},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136371},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601468X},
author = {Libin Zhang and Keke Zhou and Yonggen Zhang and Jianzhu Li and Ping Feng and Zhanguo Sun and Qinghua Liu and Lutz Weihermüller},
keywords = {Floodwater utilization, Precipitation downscaling, Hydrological forecasting, Deep learning, Rolling horizon control},
abstract = {Intensifying climate change and hydrological extremes have significantly transformed streamflow characteristics, challenging conventional reservoir operations. Floodwater utilization (FU) has emerged as a critical strategy to balance flood control and water conservation, yet existing operations struggle to systematically integrate high-resolution meteorological forecasts and their inherent uncertainties into real-time decisions. To address this gap, this study develops an integrated FU framework that establishes forecasting-and-control system coupling a deep learning precipitation downscaling model (DeepSD), multi-model hydrological forecasting, and a rolling horizon control (RHC) optimization strategy. Evaluated during the 2023 extreme floods at the Lincheng and Zhuzhuang reservoirs in China, DeepSD effectively improved short-lead precipitation accuracy, reducing the 1-7 day lead-time mean RMSE from 11.93-26.69 mm to 11.00-25.51 mm. For inflow forecasting, the Graph Neural Network (GNN) achieved the best overall performance among the three hydrological models, with NSE values of 0.64 and 0.82 for the two reservoirs, respectively. Driven by precise meteorological forcing and topologically aware inflow predictions, the RHC-based optimization dynamically balanced competing objectives. This adaptive mechanism successfully mitigated flood risks through timely pre-releases while enhancing reservoir storage through adaptive post-peak impoundment. Compared to historical operations, the framework increased end-of-season storage ranging from 14.85 to 17.36 million m3 for the two reservoirs while ensuring downstream ecological flows. This work provides a generalizable framework for transitioning from passive flood defense to proactive water management, offering a transferable pathway to enhance the climate resilience of water resource systems under changing environments.}
}
@article{MELLO2026136392,
title = {Shifting controls on DIC export in the Doce River Basin during baseflow conditions: from rock weathering to anthropogenic forcing},
journal = {Journal of Hydrology},
volume = {679},
pages = {136392},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136392},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014897},
author = {Isadora Mello and Eduardo Duarte Marques and Daniela Vasconcelos Machado and Rafael Tarantino Amarante and Eduardo Paim Víglio and Emmanoel Vieira Silva-Filho},
keywords = {Hydrogeochemistry, Fluvial carbon export, Dissolved inorganic carbon, Water-rock interaction, Chemical weathering, Land use},
abstract = {Tropical rivers play a disproportionately important role in global carbon fluxes, yet they remain underrepresented in biogeochemical datasets. This study investigated the fluvial fluxes of Dissolved Inorganic Carbon (DIC) and dominant hydrochemical processes in 499 small tropical rivers and streams across the Doce River Basin (DRB), Brazil, a region affected by the 2015 Fundão Dam collapse, the world’s largest mining tailings dam failure and Brazil’s most severe environmental disaster. Water samples were collected during dry-season baseflow conditions in 2010. Surface-water chemistry reflects the combined influence of silicate weathering and anthropogenic inputs, with a mean DIC fluvial flux of 5.44 kg C km−2 day−1. Rock weathering is the dominant basin-scale control on DIC concentrations, as indicated by a factor explaining 40.6% of the total hydrochemical variance (Ca2+, Mg2+, Na+, HCO3−), consistent with the basin’s predominantly silicate lithology and localized contributions from carbonate-bearing units upstream. Anthropogenic inputs act as a secondary but systematic control, particularly in the midstream sector, where pasture land use is associated with higher DIC concentrations (r = +0.448, p < 0.001), while mining and urban effluents locally enrich alkalinity and major ions. Micro-basins dominated by natural land cover show lower mean DIC concentrations (5.24 mg C L−1) than anthropogenically influenced sub-basins (11.13 mg C L−1), a 2.1-fold difference. As these results derive from a single dry-season campaign, they should not be extrapolated to an annual DIC budget. Overall, this study provides a hydrogeochemical characterization of tributary systems in the DRB, supporting future monitoring and environmental assessment efforts.}
}
@article{WANG2026136413,
title = {Coastal aquifer modification of dissolved barium during submarine groundwater discharge to a semi-enclosed bay},
journal = {Journal of Hydrology},
volume = {679},
pages = {136413},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136413},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015106},
author = {Yancheng Wang and Guangquan Chen and Shan Sun and Shibin Zhao and Jianing Zhang and Xiaowei Wang and Guiyao Xiong and Lijun Song and Xinbin Zhao and Liyuan Pan and Xingyong Xu},
keywords = {Submarine groundwater discharge, Dissolved barium cycle, Radium and radon isotopes, Monte Carlo, Laizhou Bay},
abstract = {Submarine groundwater discharge (SGD) is increasingly recognized as a crucial vector for transporting trace elements to the ocean, yet the mobilization and liberation process of dissolved barium (Ba) at the land–ocean interface of semi-enclosed bays remains poorly constrained. In this study, a multi-isotope tracer (224Ra, 226Ra and 222Rn) approach was employed to elucidate the multi-scale SGD processes in Laizhou Bay, China, a typical semi-enclosed bay. Input parameters were assigned probability distributions based on the observed data using Monto Carlo simulations, and further incorporated into the Ra and Rn mass balance model for calculation. Thus, the result provides a wide range of estimates of the uncertainty associated with SGD flux. The median SGD was 5.38 × 108 m3 d-1 (14.87 cm d-1) in Laizhou Bay, specifically median terrestrial groundwater discharge (TGD) was 0.96 × 108 m3 d-1 (2.66 cm d-1) and median recirculating seawater discharge (RSGD) was 3.24 × 108 m3 d-1 (8.94 cm d-1). SGD-derived Ba fluxes are shown to play a major role in regulating the oceanic Ba budget. The estimated net SGD-derived Ba fluxes ranged from 0.58 × 1010 mg d-1 to 3.19 × 1010 mg d-1, accounting for approximately 32 to 72% of the total terrigenous input. RSGD plays a dominant role in the SGD process, the net Ba flux carried by RSGD is about twice that of TGD. Dissolved Ba exhibited pronounced non-conservative behavior within the coastal aquifer. Sediment-water interactions during seawater-groundwater mixing enhanced dissolved Ba mobilization, increasing the Ba carried by groundwater discharge to Laizhou Bay. Furthermore, due to the long-term neglect of the migration behavior of Ba in groundwater, the Ba flux driven by TGD has been underestimated by approximately 61%. These findings challenge the traditional methods for estimating the SGD-derived solute flux and emphasize that different forms and mobilization of solute in the coastal aquifer should be taken into account.}
}
@article{HUANG2026136344,
title = {Hydrodynamic reconstruction of tidal river networks based on sensitivity analysis of responses to sluice–pump scheduling: a case study of episodic pollution control},
journal = {Journal of Hydrology},
volume = {679},
pages = {136344},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136344},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014411},
author = {Ming Huang and Hongwu Tang and Xianglong Wei and Xiangju Cheng and Saiyu Yuan and Qihua Ran and Fuxin Zhang and Wei He},
keywords = {Plain tidal river network, Episodic pollution control, Hydrodynamic reconstruction, Joint sluice–pump scheduling, Sensitivity analysis},
abstract = {Episodic pollution under complex hydrodynamic conditions poses a major challenge to hydraulic regulation and water-environment management in plain urban tidal river networks worldwide. Hydrodynamic reconstruction based on sluice–pump scheduling is a direct engineering measure for addressing this problem. However, conventional multi-criteria decision-making methods tend to emphasize aggregate performance and may overlook engineering feasibility and section-level local weaknesses, whereas direct comparison of scenario outcomes provides limited insight into the underlying scheduling–response mechanisms. In this study, a one-dimensional hydrodynamic–water-quality model was used to characterize the responses of different sluice–pump operation scenarios. Seven response indicators were established to characterize hydrodynamics, water quality, water environment, and sluice–pump operation. Sensitivity analysis was used to quantify scheduling–response relationships and to inform a scenario evaluation and selection framework that explicitly accounts for engineering feasibility, management preferences, and local weaknesses. Using this framework, an optimized hydrodynamic reconstruction scheduling scheme with strong overall performance, engineering feasibility, and local operational reliability was identified. Taking a representative river system in Shanghai, China, as a case study, the optimized scheme was tested in field operation for 7 months. During the flood season, when episodic pollution was most severe, representative water quality indicators in the district improved by 29.2% relative to the previous two years, while pollutant peak concentration and the interquartile range decreased by 65.6% and 53.6%, respectively. The proposed approach integrates mechanism diagnosis with engineering-oriented scenario screening and provides an interpretable framework with demonstrated engineering applicability for episodic pollution control in tidal river networks.}
}
@article{DU2026136374,
title = {Projected intensification of compound river flooding and urban waterlogging in riverside cities of the Yangtze river basin},
journal = {Journal of Hydrology},
volume = {679},
pages = {136374},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136374},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601471X},
author = {Hong Du and Sidong Zeng and Yongyue Ji and Yating Hu and Zhuo Liu and Hayley J. Fowler and Jun Xia},
keywords = {Climate change, Compound flooding, River flooding, Urban waterlogging, Copula analysis, Composite flooding and waterlogging index (CFWI), Yangtze River Basin},
abstract = {Compound river flooding and urban waterlogging driven by fluvial and pluvial processes will increase flood risk in riverside cities. However, quantitative assessment of these compound flooding and waterlogging events (CFWE) remains challenging due to their complex dynamics and spatial heterogeneity. To address this, we propose a novel two-dimensional Composite Flooding and Waterlogging Index (CFWI) based on a nonstationary Copula-based framework incorporating antecedent hydrological conditions, which integrates both the severity and pattern of CFWE enabling identification of dominant contributions and facilitating consistent cross-regional comparison. The CFWI is applied to 48 riverside cities in the Yangtze River Basin, using hydrological simulations from the Distributed Time Variant Gain Model (DTVGM) driven by climate projections from ten CMIP6 global climate models under four Shared Socioeconomic Pathway scenarios (SSP1–2.6, SSP2–4.5, SSP3–7.0, and SSP5–8.5). Results show that both the frequency and severity of CFWE increase under all future scenarios. The frequency of high flooding–high waterlogging (HFHW) events are most strongly in tributary subregions, while the severity of HFHW and high flooding–low waterlogging (HFLW) events intensifies primarily along the main reaches of the Yangtze River. Under natural conditions, CFWE hazards increase most markedly along the main river reach, with river flooding and urban waterlogging contributing approximately equally. However, when existing flood control and drainage capacities are considered, the largest increases in CFWE risk (approximately 0.3–0.6) occur in the upper reaches and tributary cities, while risk increases are smaller in the lower reaches (approximately 0.2). Across the basin, CFWE risk remains predominantly driven by urban waterlogging, highlighting persistent deficiencies in urban drainage systems, while river flooding becomes the primary driver of risk along the lower main reach. This study demonstrates that compound flooding in the Yangtze River Basin will become more frequent, more severe, and more spatially differentiated under climate change, and highlights the need to prioritise urban drainage capacity enhancement, particularly in tributary cities.}
}
@article{QIAN2026136332,
title = {Recent intensification of the negative physiological effect of CO2 on terrestrial evaporation},
journal = {Journal of Hydrology},
volume = {679},
pages = {136332},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136332},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014290},
author = {Haiyang Qian and Weiguang Wang and Zefeng Chen and Akash Koppa and Guoshuai Liu and Jian Zeng and Jianyu Fu and Shuai Cheng and Diego G. Miralles},
keywords = {Atmospheric CO, Terrestrial evaporation, Stomatal conductance, Vegetation greening, TRENDY, Analog approach},
abstract = {Atmospheric carbon dioxide (aCO2) directly modulates global terrestrial evaporation (ET) through two counteracting plant physiological effects: vegetation greening and a reduction in stomatal conductance. The extent to which these two aCO2 physiological effects translate into ET trends, and their individual contributions, are still subjects of debate. Here we present a novel analog framework to decouple and quantify their respective contributions using a suitable global dynamic vegetation model ensemble from the TRENDY project, rigorously constrained by satellite observations. Our analysis, enabled by isolating the aCO2 physiological effect, reveals that the net physiological effect of CO2 on ET is globally negative during 1982–2018, as stomatal conductance reductions overcome the positive effect of greening. However, in water-limited arid regions, the decoupled effect shows a near-zero positive response. As aCO2 has increased in recent decades, this net negative physiological effect on ET has progressively intensified and is expected to attenuate the projected increases in ET due to global warming and the consequent acceleration of the water cycle.}
}
@article{SHAHBAZBEGIAN2026135881,
title = {Global mapping of potential hydropolitical system archetypes in international transboundary basins: a shift in perspective from geopolitical temperature into structural process},
journal = {Journal of Hydrology},
volume = {679},
pages = {135881},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135881},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426009789},
author = {Mohammadreza Shahbazbegian and Qiuhong Tang and Mohammadreza Shirinzadeh and Roohollah Noori},
keywords = {Hydropolitical System Archetypes (HSAs), International Transboundary rivers, System archetypes, Hydropolitics, Basin At Risk (BAR)},
abstract = {Transboundary water resources pose significant governance challenges as climate change, population growth, and geopolitical tensions increase competition over shared waters. International river basins spanning 150 countries and supporting approximately 40% of the global population require frameworks that move beyond event-based conflict tracking to understand the underlying structural dynamics that generate hydropolitical tensions. This study develops a novel framework for systematically mapping Hydropolitical System Archetypes (HSAs) across 286 international river basins, addressing a critical gap in global water governance research. By integrating system archetypes theory with hydropolitical analysis, this research identifies recurring patterns of conflict and cooperation, categorizing them into five HSAs based on power asymmetries, institutional fragility, resource dependency, and geopolitical factors. Our findings reveal the uneven distribution of HSAs worldwide, demonstrating how physical geography, historical treaties, and socio-political conditions shape water-sharing interactions. Critically, this framework shifts analytical perspective from geopolitical temperature, the observable heat of diplomatic events captured by event-based indices, to structural process, the underlying feedback mechanisms that generate hydropolitical behavior. A comparative analysis with the Basin at Risk (BAR) event-based index reveals that several basins classified as cooperative by BAR metrics simultaneously exhibit all five HSAs, indicating high structural risk. This approach enables early detection of conflict preconditions even during periods of diplomatic calm, supports adaptive governance strategies, and promotes more equitable transboundary water-sharing mechanisms in an era of increasing environmental uncertainty.}
}
@article{JIANG2026136331,
title = {Integration of vertical and lateral erosion in modelling landslide mass flows, debris flows and flash floods},
journal = {Journal of Hydrology},
volume = {679},
pages = {136331},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136331},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014289},
author = {Ruochen Jiang and Wenjun Lu and Shihao Xiao and Xin He and Ruiqiang Bai and Yingyue Han and Mingdong Wei and Dalei Peng and Jian He and Limin Zhang},
keywords = {Landslides, Debris flows, Flooding, Overtopping erosion, Lateral erosion, Bank failure, Dam-breaching flood},
abstract = {Overtopping and lateral erosion play a critical role in geomorphological evolution due to landslides, debris flows, fluvial floods and dam-breaching floods. These processes contribute substantial materials to runoff channels, significantly amplifying the flow volume and destructive power. Existing physics-based models suffer from oversimplified flow dynamics (e.g., constant flow properties or 1D approaches that ignore lateral erosion) or high computational costs (e.g., full 3D fluid dynamics simulations), limiting their accuracy and applications. To address these limitations, this study presents a novel depth-averaged numerical framework that simultaneously captures overtopping and lateral erosion dynamics. Beyond simulating these key erosional mechanisms, the model uniquely incorporates dynamic feedback between erosion processes and evolving properties of the flowing mass. The model performance is demonstrated through rigorous validation across three benchmark cases: (1) controlled dam-breaching experiments, (2) the 2020 Zelunglung landslide-debris flow cascade, and (3) the 2018 Sedongpu outburst flood. The simulations closely match measured topographic changes, confirming the framework ability to capture coupled erosion dynamics. The proposed model offers a useful tool for assessing large-scale cascading hazards and their geomorphic impacts, bridging the gap between computational efficiency and physical reality.}
}
@article{TIAN2026136420,
title = {Tracing the journey of size-fractionated particles in the river-to-estuary continuum: insights from short-lived 210Bi},
journal = {Journal of Hydrology},
volume = {679},
pages = {136420},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136420},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015179},
author = {Jie Tian and Weifeng Yang and Min Chen and Ziming Fang and Minfang Zheng and Mengya Chen},
abstract = {Riverine particles deliver an enormous amount of material to the sea; however, their transport along the river-to-coast continuum remains poorly constrained due to a lack of tools capable of resolving large changes over short timescales. Here, we present the first examination of short-lived 210Bi (T1/2 = 5.01 d) in size-fractionated particles (>60 μm, 10–60 μm, 3–10 μm), together with 210Pb and particulate components, along a river-to-estuary transect. In river water, both δ13C and C/N evidenced the predominantly autochthonous origin of POC, though lithogenics accounted for 77 ± 16% of particles. In contrast to the 210Bi deficit in 10–60 μm fraction, the 210Bi/210Pb equilibrium for > 60 μm indicated a dominant terrestrial origin for > 60 μm particles and minimal conversion between the two sizes. The correlation between POC and 210Bi supports the use of 210Bi to trace the cycling of POC. The greater 210Bi deficit for 10–60 μm and the higher specific activities of 210Bi and 210Pb for 3–10 μm support an overall disaggregation and/or reorganization of 10–60 μm organo-mineral complexes into 3–10 μm fraction. In estuarine surface water, both the greater 210Bi deficit for 3–10 μm and the comparable specific activities of 210Bi or 210Pb to those in the 10–60 μm fraction indicate an aggregation of 3–10 μm POC. The 210Bi-derived transport rates highlight the settling of most particles within the mid-salinity zone (∼10–22), and <33% of riverine POC reached the open sea. This study reveals that available riverine carbon export to the ocean is largely overestimated.}
}
@article{FENG2026136335,
title = {Reconstructing terrestrial water storage and quantifying drought evolution in Australia using LSTM networks},
journal = {Journal of Hydrology},
volume = {679},
pages = {136335},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136335},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014320},
author = {Bo Feng and Yan Xu and Nan Jiang and Biaobiao Guo and Peng Yin and Ao Guo and Tianhe Xu and Harald Schuh},
keywords = {GNSS, GRACE, Terrestrial water storage, LSTM, Drought monitoring},
abstract = {High-precision monitoring of Terrestrial Water Storage (TWS) is critical amid climate-driven increases in drought severity. To overcome the inherent limitations of the Gravity Recovery and Climate Experiment (GRACE)—coarse spatial resolution and data gaps and the Global Navigation Satellite System (GNSS)—uneven station distribution and high-frequency noise, we introduce a Long Short-Term Memory (LSTM) framework. This framework reconstructs high-quality TWS across Australia by integrating Equivalent Water Height (EWH) time series, meteorological data, and temporal markers to effectively capture GNSS-GRACE discrepancies. Joint inversion results demonstrate substantial spatiotemporal consistency with Global Land Data Assimilation System (GLDAS), GRACE, and precipitation records. Notably, the LSTM-enhanced EWH significantly improves agreement with benchmarks: the correlation with GRACE reached 0.854 in the Northern Territory and surged from 0.290 to 0.656 in station-sparse Western Australia. Crucially, the model successfully bridges the GRACE mission gap, ensuring TWS continuity. Furthermore, the quantification of drought evolution (2011–2023) using a derived Drought Severity Index (LSTM-DSI) and NscPDSI revealed a correlation of 0.663, demonstrating robust consistency in capturing extreme hydrological signals. By integrating the temporal resolution of GNSS with the physical stability of GRACE, this multi-source fusion approach provides a robust foundation for investigating hydroclimatic interactions in Australia.}
}
@article{MANIKANTA2026136424,
title = {Understanding data sufficiency and temporal informativeness for hydrological model calibration in data scarce regions},
journal = {Journal of Hydrology},
volume = {679},
pages = {136424},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136424},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015210},
author = {Velpuri Manikanta and Surya Kiran Guniganti and Daneti Arun Sourya and Rathinasamy Maheswaran},
keywords = {Sparse data calibration, Data scarcity, Calibration data length, Model predictability, Symbolic regression, Classification and regression tree, Large-sample hydrology},
abstract = {Reliable hydrological model calibration is often constrained by limited continuous discharge records, yet it remains unclear whether the amount and timing of calibration data required by a catchment can be predicted in advance from its physical characteristics. This study develops and tests an a priori predictive framework using Classification and Regression Tree (CART) analysis and Symbolic Regression to estimate calibration data requirements and identify the most informative calibration period. The framework was evaluated across 671 catchments in the United States, including 477 rainfall-dominated and 194 snow-dominated catchments, using calibration periods spanning one month to one year. CART identified mean annual precipitation, snow fraction, aridity, and soil depth as dominant controls on performance loss under sparse calibration. Symbolic Regression, incorporating dynamic meteorological inputs and static catchment attributes, derived compact analytical expressions for predicting the optimal calibration month. Results show that calibration requirements depend more on hydrologic regime and seasonal process dynamics than on calibration length alone. One-month calibration reproduced benchmark performance in 23% (110/477) of rainfall-dominated catchments, whereas 44% (85/194) of snow-dominated catchments required 12 months to represent snowmelt and storage dynamics adequately. Higher aridity and evapotranspiration variability increased sensitivity to sparse calibration. Objective function choice also affected calibration performance because different metrics emphasize different hydrograph segments. Together, these results provide a process-oriented, data-driven framework for identifying when limited discharge records can support reliable calibration and anticipating these requirements a priori in new or ungauged catchments.}
}
@article{GAO2026136327,
title = {Flood susceptibility assessment using a multi-sampling discriminative Bayesian network},
journal = {Journal of Hydrology},
volume = {679},
pages = {136327},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136327},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014241},
author = {Xinyu Gao and Shanhu Jiang and Xiuqin Fang and Xiaoxiang Zhang and Feiyu Li and Miao He and Mingyan Wu and Moran Xu and Liliang Ren},
keywords = {Flood susceptibility, Bayesian network, Machine learning, GIS, China},
abstract = {Flood susceptibility assessment (FSA) is an important tool for reducing flood-related losses. The Bayesian network (BN), owing to its interpretability and ability to integrate prior knowledge, has been increasingly used in FSA. However, existing BN-based studies often suffer from subjective data discretization, method-dependent variability and bias in factor importance assessment and screening, and network construction that relies heavily on subjective settings, thereby limiting their suitability for robust FSA applications. Focusing on flood-prone Xiushui County, this study addresses these issues from three aspects. First, an adaptive discretization algorithm is proposed to achieve objective and data-driven discretization of continuous variables. Second, a collaborative factor importance evaluation approach combining GeoDetector and Information Gain Ratio (IGR) is introduced to identify key factors while reducing the method-dependent variability and bias associated with single-method selection. Third, a task-oriented multi-sampling discriminative Bayesian network (MSD-BN) is developed for flood susceptibility assessment. The model integrates discriminative structure learning guided by internal validation scoring, multi-sampling-based structure selection, and robust probability estimation under sparse configurations into a unified workflow. It is intended to help address the mismatch between generative scoring and predictive objectives, as well as the problem of data sparsity in geographically heterogeneous settings. The results show that MSD-BN achieved favorable overall predictive performance relative to the compared models, with an AUC of 0.9666 and an MCC of 0.8417. In addition, the collaborative evaluation identified the normalized difference vegetation index (NDVI) as the highest-ranked flood conditioning factor. Spatially, highly flood-susceptible zones were mainly associated with low NDVI, flat terrain, and proximity to rivers and roads, and were concentrated in cropland, grassland, and impervious surface areas. The proposed model provides a practical and interpretable approach for improving FSA and offers useful support for land-use planning and flood disaster mitigation.}
}
@article{LENG2026136408,
title = {Well-balanced lattice Boltzmann modelling of the depth-averaged age equation and its correlations with environmental indicators in a typical urban flood retention area},
journal = {Journal of Hydrology},
volume = {679},
pages = {136408},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136408},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426015052},
author = {Fei Leng and Haifei Liu and Fan Zhang and Shan He and Liyun Zhang and Yujun Yi},
keywords = {Urban flood retention area, Water age, Environmental indicators, Lattice Boltzmann method},
abstract = {With the increasing tension on urban spatial resources, urban flood retention areas, as valuable multi-functional spaces integrating flood control, water regulation and ecological conservation, are still plagued by prominent water environment and ecological problems, such as long hydraulic retention time, low water quality and insufficient utilization of ecological space. Water age, as a key indicator reflecting the renewal capacity and hydrodynamic characteristics of water bodies, has a direct and profound impact on water quality parameters (e.g., dissolved oxygen, nutrients, and organic matter) by regulating material cycling and activities of aquatic organisms. This study aims to conduct the refined simulation of water age and clarify its correlations with multiple environmental indicators in a typical urban flood retention area, providing scientific support for sustainable water management. In this study, a well-balanced lattice Boltzmann method (LBM) was developed to simulate the water age distribution of the flood retention area under controlled hydrological conditions. Meanwhile, a year-round comprehensive monitoring program was implemented to collect water environmental data, including ammonia nitrogen (NH3-N), total phosphorus (TP) and dissolved oxygen (DO). By integrating numerical simulation results and in-situ monitoring data, the correlation between water age distribution and environmental indicators in the flood retention area was systematically analyzed. The results indicate that there is a significant nonlinear correlation between water age and these three indicators, with prolonged water age leading to the increasing concentrations and eutrophication risk. Based on these findings, targeted management suggestions are proposed, including optimizing the water dispatch mode to shorten the average water age, constructing ecological corridors to enhance water connectivity, and establishing a dynamic monitoring system combining numerical simulation and in-situ observation.}
}
@article{WANG2026136379,
title = {Spatiotemporal dynamics of reference evapotranspiration in China (1981–2020): Insights into its teleconnection with sea surface temperature patterns},
journal = {Journal of Hydrology},
volume = {679},
pages = {136379},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136379},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014769},
author = {Yudong Wang and Xin Lan and Mengyang Wu and Ahmed Elbeltagi and Juan Wang and Xinchun Cao},
keywords = {Climate teleconnection, Machine learning models, Reference evapotranspiration, Warmand coldphases, Wavelet coherence analysis},
abstract = {Reference evapotranspiration (ET0) governs agricultural irrigation water demand, yet its teleconnection with sea surface temperature (SST) patterns remains poorly understood under climate change. This study revealed the teleconnection between China’s ET0 and SST patterns based on the Penman-Monteith equation, multi-source data, machine learning models, and wavelet coherence analysis. Spatially, ET0 was highest in Northwest China (8.24 mm·d-1). Temporally, it increased significantly (0.0013 mm·d-1·yr−1, p < 0.05), peaking at 1.22 mm·d-1 in 2007. Multiple abrupt change points in ET0 coincided with strong Niño3.4, DMI and EMI events. SST patterns exert a clear phase-contrast influence on ET0: cold phases are predominantly associated with negative anomalies, whereas warm phases drive a widespread shift toward positive anomalies—especially during the WIOD phase, where the area with positive anomalies reaches 91.74%. Wavelet analysis reveals a significant multivariate synergistic enhancement effect between ET0 and SST patterns. The bivariate coupling of Niño3.4 + EMI exhibited the strongest explanatory power, with Average Wavelet Coherence (AWC) and Percentage Area of Significant Coherence (PASC) reaching 0.55 and 11.33%, respectively. When controlling for single-factor variables, the influence of DMI was more pronounced. Coupling of multiple SST patterns enhances the AWC with ET0, under the combined influence of all three SST patterns, the AWC reached 0.71. This study reveals that the synergistic effect of Niño3.4 and EMI on ET0 is stronger than that of any single SST pattern, providing new insights for agricultural water resource management under the impact of climate change.}
}
@article{FAGUNDES2026136383,
title = {Integrating hydrogeomorphic changes into flood hazard assessment: approach for an eco-touristic mountainous river},
journal = {Journal of Hydrology},
volume = {679},
pages = {136383},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136383},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014800},
author = {Marina R. Fagundes and Ronald E. Poeppl and Fernando M. Fan and Bruno H. Abatti and Gean P. Michel and Masato Kobiyama},
keywords = {Riverbed changes, Fluvial morphodynamics, Extreme flood events},
abstract = {Traditional flood risk assessments often overlook the hydrogeomorphic changes that occur during extreme events, despite their significant impact on subsequent flood behavior. This study investigates the influence of riverbed evolution on flood hazards in the Boi River catchment, located in a mountainous region in southern Brazil characterized by canyons, intense orographic precipitation, and ecotourism activities, through the application of the CAESAR-Lisflood Landscape Evolution Model. The Boi River has experienced recurrent flash floods that reshape its morphology. The model was calibrated using historical flood data, and its morphological response was locally evaluated at one downstream cross-section using pre- and post-event field surveys. Simulations were conducted for design storms with return periods of 2, 5, 25, and 100 years to analyze morphological changes, and the resulting Digital Elevation Models were then used as fixed terrain inputs in controlled RP002 simulations to isolate the hydraulic legacy of each individual antecedent event. Findings reveal that more extreme events cause significant bed aggradation and hydraulic spreading, altering flow depth, velocity, and hazard at selected exposed locations. Notably, the flood extent for a 2-year event increased by 16% when preceded by a 100-year event. A supplementary mobile-bed diagnostic for the RP100–RP002 case produced similar domain-wide inundation and HI-threshold exceedance results. These findings underscore the importance of accounting for sediment transport and morphological dynamics in flood hazard assessments. The CAESAR-Lisflood model provided a useful framework for exploring how flood-induced morphological changes may modify subsequent hazard patterns, although its morphological performance could only be evaluated locally.}
}
@article{LONG2026136302,
title = {Differences in watershed hydrochemical evolution driven by anthropogenic disturbances and geological heterogeneity: from source apportionment to hydrological process response},
journal = {Journal of Hydrology},
volume = {679},
pages = {136302},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136302},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013995},
author = {Qi Long and Hui Qian and Yicheng Duan and Kang Li and Yanyan Gao and Yixin Liu and Siqi Li and Xiaoxin Shi and Zhiming Cao and Qiaoyang Yang},
keywords = {Surface water-groundwater interaction, Stable isotopes, Source apportionment, Bayesian mixing model, Hydrochemistry},
abstract = {Quantitatively resolving surface water and groundwater sources and clarifying how surface water-groundwater interactions (SGI) control hydrochemical evolution under anthropogenic disturbances and heterogeneous geological environments are crucial for watershed management. This study selected the Lao River and Feng River basins in the Guanzhong Basin, characterized by distinctly different geological features, as study areas. By employing hydrochemical and isotopic analyses combined with the Positive Matrix Factorization (PMF) and Bayesian isotope mixing (MixSIAR) models, we systematically investigated hydrochemical evolution processes and SGI characteristics under varying geological backgrounds and human activities. The results reveal pollution patterns and hydrological processes driven by geological heterogeneity and human activities. Both rivers are primarily controlled by natural weathering. However, the Lao River is profoundly influenced by agricultural activities, whereas the Feng River receives relatively minor agricultural impact. Although both rivers exhibit similar spatial SGI patterns, notable differences emerge in their second reaches. The Feng River, characterized by fine-grained sediments and clay interlayers, maintains perennial runoff primarily through upstream surface water recharge (73.5%). Conversely, the widespread distribution of coarse-grained aquifers with strong vertical connectivity in the Lao River basin leads to river drying, with groundwater recharge to surface water accounting for 48.3%, presenting a higher estimated contribution compared to that of the Feng River (18.6%). The contrasting SGI patterns generate distinct environmental risks. In the Lao River, groundwater discharging into surface water may elevate nitrate concentrations, threatening water quality, while the Feng River faces rapid pollutant migration and potential urbanization impacts. These findings emphasize the necessity for differentiated watershed management strategies. Ultimately, this study establishes an integrated framework combining chemical source apportionment with SGI analysis, demonstrating the efficacy of comprehensive hydrochemical and isotopic approaches in uncovering geochemical processes under complex environmental conditions.}
}
@article{YU2026136326,
title = {Physics-guided symbolic regression of nonlocal transport memory from sparse observations in aquatic systems},
journal = {Journal of Hydrology},
volume = {679},
pages = {136326},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136326},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601423X},
author = {Xiangnan Yu and Yong Zhang and HongGuang Sun and Zhibo Chen and Yuntian Chen},
keywords = {Non-Fickian transport, Nonlocal transport, Memory function, Physics-informed machine learning, Symbolic regression, Continuous-time random walk, Streamtube model},
abstract = {Predicting non-Fickian transport in aquatic systems from sparse observations is challenging because historical effects and spatial heterogeneity often control present behavior. We introduce a physics-guided, sequential hybrid framework that couples nonlocal transport theory with deep-learning-assisted symbolic regression to infer transport memory directly from one-dimensional observations, such as breakthrough curves (BTCs) or spatial concentration snapshots. The physics module maps observations to a nonparametric memory representation derived from the statistics of microscopic particle dynamics, including temporal memory associated with mass-transfer-controlled transport and spatial (kinematic) memory represented by the streamtube velocity probability density function (PDF) for conductivity-driven spreading, thereby unifying temporal and spatial nonlocality within a single construct. Neural reconstruction, coupled with a stable numerical Laplace transform, produces denoised, high-resolution spectral representations, from which symbolic regression identifies compact, closed-form expressions for transport memory that are embedded back into the nonlocal model. Validation spans synthetic and experimental systems: semi-analytical fractional diffusion and a Cr(VI) column experiment (power-law kernels); a Red Cedar River tracer test (reach-specific, exponentially tempered kernels); random-walk particle tracking (Gamma-family velocity laws); groundwater tracer transport at the MADE field site (independently inferred inverse-Gamma velocity PDFs for MADE-1 and MADE-2 with out-of-sample predictive skill); and sediment transport in the North Loup River (a symmetric heavy-tailed velocity PDF capturing both backward and forward scaling). Across all cases, the inferred models reproduce observed transport behavior and accurately predict downstream profiles while remaining interpretable and parsimonious, without requiring quantitative prior characterization of aquatic system properties beyond geometry and boundary conditions. Compared to a purely data-driven sparse-regression approach on the same MADE-2 dataset, which yields only a near-integer-order advection equation (α≈1) with no dispersion, our physics-guided framework captures the anomalous spreading and predicts out-of-sample concentration snapshots, demonstrating enhanced robustness under sparse, noisy conditions. By bridging data-driven inference with nonlocal transport physics and expanding the concept of transport memory to encompass both temporal and spatial nonlocality, the proposed framework provides a practical and interpretable pathway for modeling anomalous transport under observational constraints common in laboratory and field hydrologic systems. This capability enables practical inference of transport memory and plume evolution in field systems where only sparse monitoring data are available, once the dominant transport mechanism has been qualitatively identified.}
}
@article{CAO2026136347,
title = {Anthropogenic dominance of water storage variability in the Yellow River Basin: A machine learning synthesis of multi-source data (1981–2031)},
journal = {Journal of Hydrology},
volume = {679},
pages = {136347},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136347},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014447},
author = {Yanping Cao and Zunyi Xie and Dandan Liu and Chaolin Mu and Jielun Wang and Yihao Chang and Yingjun Pang},
keywords = {Total water storage, Nature-human transition, Water resource management, Ecohydrological sustainability, Machine learning},
abstract = {Water is critical to sustainable development in arid river basins such as the Yellow River Basin (YRB), where rapid population and economic growth have profoundly altered the hydrological regime. However, the historical evolution and future trajectories of water resources, together with the relative roles of natural and anthropogenic influences, remain incompletely understood, limiting effective water management and ecohydrological sustainability. Here, we integrated satellite observations, model simulations, and machine learning methods to reconstruct terrestrial water storage anomalies (TWSA) from 1981 to 2002 and forecast monthly TWSA through 2031. Our results identify a pivotal transition around 2000, when TWSA variability in the YRB shifted from being predominantly associated with climatic fluctuations to being increasingly associated with human activities. This transition was accompanied by concurrent changes in climatic and ecohydrological conditions and increasing anthropogenic pressures. Before 2000, TWSA variations were primarily associated with natural hydroclimatic fluctuations and showed only a modest decline. After 2000, socioeconomic development and large-scale ecological restoration became increasing associated with accelerated TWSA depletion. More recently, depletion moderation alongside water-conservation initiatives and increasing precipitation, although no statistically significant hydrological turning point was detected. Across three Shared Socioeconomic Pathways, residual non-climatic influences, which may include anthropogenic effects and processes not represented by the selected climatic predictors, accounted for approximately 84%–97% of the projected TWSA trends. This dominant residual contribution highlights the importance of non-climatic influences on future water storage trajectory in the basin. This study provides sustainable water management, policy, and adaptation in water-limited basins facing growing supply–demand imbalances.}
}
@article{DONG2026136286,
title = {Mechanistic characterization of the discrepancies in enrichment of nitrate between agricultural and urban-industrial rivers in the semi-arid areas of northern China: Insights from multi-element stable isotope analysis},
journal = {Journal of Hydrology},
volume = {679},
pages = {136286},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136286},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013831},
author = {Ang Dong and Yu Liu and Guiqi Liu and Guangzhi Rong and Shuaihao Liu and Mingjun Mo and Haixia Wang and Guoguang Wang},
keywords = {Nitrate dynamics, Semi-arid rivers, Multi-element isotopes, Source apportionment, Sediment-water exchange},
abstract = {Numerous studies have investigated nitrate sources and transformations in surface waters, yet the mechanisms sustaining winter nitrate maxima in semi-arid rivers, where hydrological constraints limit external inputs, remain poorly understood. This study investigated the seasonal dynamics, driving mechanisms, and biogeochemical fate of nitrate in the agricultural and urban-industrial rivers of the semi-arid areas via the analysis of multi-element stable isotopes (δ15N-NO3-, δ18O-NO3-, δD-H2O and δ18O-H2O). Nitrate concentrations showed seasonal discrepancies in both rivers, with high concentrations in winter. Principal component analysis implied that monsoon-driven hydrological dilution was the main factor controlling the seasonal variability of nitrate in the two rivers. Partial least squares path modelling revealed divergent winter enrichment mechanisms: in the agricultural river, water-column nitrification (59.56 ± 26.47%) and benthic nitrate release (40.44 ± 26.47%) jointly contributed; in the urban-industrial river, physically driven benthic release dominated. Fractionation-corrected Bayesian mixing modelling confirmed that the nitrate was primarily derived from the chemical fertiliser and soil organic nitrogen in the agricultural river, while fertiliser and sewage dominated the non-urban and urban reaches of the urban-industrial river, respectively. However, winter apportionment results likely reflected legacy nitrogen historically accumulated in the sediment pool rather than contemporaneous external inputs. By contrasting agricultural and urban-industrial catchments, this study demonstrates that urban-industrial development has fundamentally reshaped nitrogen migration and transformation pathways in semi-arid rivers, providing a scientific basis for differentiated nitrate management strategies tailored to catchment-specific land-use conditions.}
}
@article{ZHANG2026136323,
title = {Spatially distributed modeling of biofilm-induced hydrodynamic evolution in porous media},
journal = {Journal of Hydrology},
volume = {679},
pages = {136323},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136323},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014204},
author = {Hongcheng Zhang and Chaomeng Dai and Jixiang Li and Jiajun Hu and Wang Kai Tong and Jia Jie Zou and Min-tian Gao and Zhi Li and Xihua Wang and Yalei Zhang and Kah Hon Leong and Swee Pin Yeap and Araceli Martín Candilejo},
keywords = {Biofilm barrier, Model simulation, Porous media, Hydrodynamic transport, Spatial heterogeneity, Velocity distribution},
abstract = {Biofilm growth in porous media significantly alters flow and transport properties in groundwater remediation, filtration and bioreactor operation, and membrane-related processes. However, most models treat biofilm zones as hydraulically uniform, neglecting internal heterogeneity and potentially compromising flow-field predictions. Here, we establish a spatially distributed framework for modeling the evolving hydrodynamics of biofilm growth in porous media by translating time-lapse biofilm images into distributed porosity and permeability fields, and evaluate it against the conventional uniform strategy. The results show that geometric heterogeneity promotes preferential colonization in narrow throats and the formation of larger pore-spanning clusters. Under the uniform strategy, multiple porosity–permeability combinations can reproduce the same bulk pressure drop and collapse onto a narrow compensation ridge (slope −11.15), revealing strong equifinality in hydraulic calibration and limited transferability of the calibrated parameters across growth stages. By contrast, the spatially distributed strategy reproduces the pressure drop evolution across growth stages. Although bulk pressure-drop calibration alone does not uniquely identify the absolute local values of n and k, the hydraulically admissible mappings yield effective hydraulic-property fields with broadly consistent spatial organization. Under the examined conditions, the resulting permeability distributions exhibit high-permeability tails that can be described by a Pareto-II distribution. Although both the uniform and spatially distributed strategies reproduce similar bulk pressure drops, the uniform treatment predicts more pronounced fast–slow segregation and velocity extremes. These findings establish a new framework for translating biofilm structure into hydraulically meaningful parameter fields, advancing predictive modeling of biofilm-driven hydrodynamics in porous media.}
}
@article{YUAN2026136315,
title = {Where are the retention hotspots of microplastic particles in the riverbed with complex topography},
journal = {Journal of Hydrology},
volume = {679},
pages = {136315},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136315},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014125},
author = {Haiyu Yuan and Guangqiu Jin and Kaiwen Zhang and Xue Ping and Ran Ma and Guiqiao Wang and Xiangfei Qi and Hanqing Zhao},
keywords = {Microplastics, Hyporheic zone, Retention, Riverbed, Groundwater},
abstract = {Riverbeds are critical microplastic (MP) sinks, yet the spatial heterogeneity of retention within three-dimensional complex topographies remains poorly understood. This study developed a coupled surface water-groundwater model, combined with laboratory-derived filtration properties, to investigate the spatiotemporal accumulation and retention hotspots of MPs. Results demonstrate that MP infiltration is governed by the competition between intrinsic settling/rising velocities and topography-induced interfacial fluxes across diverse polymer types. While small MPs act as near-passive tracers following hyporheic streamlines, larger MPs are dominated by gravitational settling, with over 95% of the input mass retained within 5 days. Spatiotemporal mapping identifies high-intensity hotspots primarily on the lee faces of bedforms and near reattachment zones. Vertically, retention mass exhibits an increase from the crest followed by a power-law decline, with maximum accumulation occurring near the trough elevation and reaching depths of up to 9 cm. Crucially, 3D morphological features, such as saddles and lobes, create distinct longitudinal filtration strips that significantly diverge from idealized 2D predictions. This extreme spatial heterogeneity implies that MP stocks estimated from single sediment cores may contain substantial errors depending on the sampling position relative to riverbed topography. This research provides a mechanistic framework for identifying MP hotspots in natural rivers, highlighting the critical role of bedform morphology in shaping the long-term distribution of MP pollution legacies.}
}
@article{BIKKUMALLA2026136245,
title = {Evaluation of Sobol’ sensitivity indices conditioned on model performance},
journal = {Journal of Hydrology},
volume = {679},
pages = {136245},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136245},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426013429},
author = {Rishitha Bikkumalla and Rao S. Govindaraju},
keywords = {Global sensitivity analysis, Sobol’ indices, Hydrological modeling, HEC-HMS},
abstract = {Hydrological modeling studies rely on global sensitivity analysis to determine parametric importance and to support calibration. In this regard, Saltelli’s Matrices Method (SMM) is widely used to construct Sobol’ sensitivity indices that quantify the fraction of output variance explained by individual parameters and their interactions. Sensitivity estimates depend not only on the objective function used to evaluate goodness of fit (e.g., NSE, KGE, RMSE), but also on the choice of a performance measure (e.g., NSE > 0.7) that determines which parameter combinations are deemed acceptable. However, filtering samples to retain only those that satisfy a performance criterion violates the paired matrix structure required by SMM, and no prior study has proposed a principled way to address this structural violation while preserving SMM’s efficiency. To resolve this gap, the Constrained Saltelli Matrix Method (CSMM) is proposed in this study. CSMM is a two-step filtering procedure that first retains samples satisfying a performance threshold in the first step and then reorganizes them into the design matrices amenable to SMM in the second step, yielding an “acceptable” subset on which Sobol’ indices can be estimated within a performance-constrained parameter space. The second filtering step distorts the input parameter distribution relative to the threshold-filtered space, and the Hellinger distance is proposed as a practical diagnostic to quantify this distortion and assess the reliability of the resulting sensitivity indices. CSMM is applied to the HEC-HMS rainfall-runoff model for twelve events across three watersheds in the Midwestern USA, with Time of Concentration (Tc) and Storage Coefficient (R) treated as uncertain parameters. Sensitivity estimates from CSMM are compared against a brute-force binning method applied to both threshold-filtered and acceptable samples. CSMM estimates are found to be in good agreement with the binning results when the Hellinger distance is small, and to diverge as distortion increases, supporting the use of the Hellinger distance as a guide to CSMM’s applicability. The results further show that parameter sensitivities shift as the performance threshold becomes more stringent, with a Tc–R trade-off emerging under NSE-based conditioning, while R dominates under KGE and peak-flow-based conditioning. These findings underscore that variance-based parameter sensitivity is linked to both the modeling objective and the level of acceptable performance, and that CSMM provides a principled means of conducting Sobol’ sensitivity analysis conditional on satisfactory model performance.}
}
@article{LEI2026136311,
title = {Impacts of climate change on rain-on-snow events and spring agricultural drought in Northeast China},
journal = {Journal of Hydrology},
volume = {679},
pages = {136311},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136311},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426014083},
author = {Zhenyuan Lei and Jia Liu and Yi Yang and Yonggang Hao and Moran Xu and Chong Du and Zhang Guangxin and Peng Qi},
keywords = {Climate change, Rain-on-snow, Spring agricultural drought, Northeast China},
abstract = {Snowmelt is a critical water source for spring agriculture in high-latitude regions. However, research remains insufficient regarding how future climate change is expected to alter the timing and intensity of snowmelt, thereby increasing the risk of floods triggered by “rain-on-snow” (ROS) events and the uncertainty surrounding spring agricultural droughts. This paper examines Northeast China, the largest commercial grain production base, as a case study. The semi-distributed hydrologic model (SWAT) was combined with CMIP6 meteorological data to simulate hydrological processes under, four shared socioeconomic paths (SSP126, SSP245, SSP370, and SSP585). ROS and Soil Moisture Deficit Index (SMDI) were used to quantify the changes in snowmelt risk from historical periods (1980–2019) to future periods (2021–2100) and the evolution of agricultural drought in spring. The results indicate that: (1) Snowmelt begins earlier in future periods, with higher emissions leading to an earlier onset; (2) In the long-term (2061–2100), higher emissions result in a faster decline in snowmelt, with interannual rates of change at SSP126, SSP245, SSP370, and SSP585 of −13%, −16%, −18%, and –22%, respectively; (3) In the future, the agricultural drought in spring will generally show a trend of mitigation, but the long-term future shows a trend of ’ moderate drought aggravation and extreme drought mitigation ’ compared with the near-term future. This study provides valuable insights into the mechanisms by which snowmelt affects spring agricultural drought under climate change, offering a foundation for better adaptation and water resource management.}
}