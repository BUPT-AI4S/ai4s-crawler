@article{HAO2026136025,
title = {Enhancing river surface velocimetry through frequency-spatial feature fusion and confidence-based quality control},
journal = {Journal of Hydrology},
volume = {678},
pages = {136025},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136025},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011224},
author = {Junjie Hao and Yuekun Ma and Yukun Li and Shuli Yu},
keywords = {River surface velocity measurement, Optical flow estimation, Wavelet transform, Frequency–spatial feature fusion, Confidence-based quality control},
abstract = {Accurate measurement of river surface flow velocity is fundamental to hydrological monitoring and flood warning systems. In recent years, deep learning-based optical flow networks have shown great potential for river velocity estimation. However, existing approaches face two key challenges. First, models relying on spatial convolution are constrained by limited water surface texture. In weakly textured regions, insufficient local information leads to features lacking distinctiveness, resulting in multiple similar matching candidates during inter-frame feature correlation and thereby increasing optical flow estimation errors. Second, uneven tracer distribution and continuous surface deformation cause significant spatiotemporal variations in prediction reliability, yet existing evaluation methods apply indiscriminate averaging across spatial pixels and temporal frames, diluting high-quality estimates with low-quality results. This study proposes a wavelet-enhanced optical flow framework (WRAFT) built on the Recurrent All-Pairs Field Transforms (RAFT) architecture, addressing these challenges through frequency-spatial feature fusion and confidence-based quality control. For weakly textured regions, a frequency-domain branch extracts multi-scale flow information via wavelet transforms and fuses it with spatial features to enhance distinctiveness. For spatiotemporal reliability variations, a confidence module assesses prediction quality, selectively retaining high-reliability predictions while discarding low-quality results. Extensive evaluations based on seven public river datasets show that WRAFT consistently outperforms large-scale particle image velocimetry, space time image velocimetry, and baseline models under challenging conditions such as sparse tracers, specular reflections, and occlusions. The framework adapts effectively to diverse river scenarios with reduced reliance on site-specific parameter tuning, offering a practical solution for automated river monitoring.}
}
@article{SARKAR2026136077,
title = {Global changes in precipitable water vapour during 1980–2100 and its spatial, temporal, radiative and causal insights for enhanced climate warming},
journal = {Journal of Hydrology},
volume = {678},
pages = {136077},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136077},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011741},
author = {S. Sarkar and J. Kuttippurath and G.S. Gopikrishnan},
keywords = {Water vapour, Precipitation, Trend, Causal discovery, Climate change},
abstract = {Understanding the spatial and temporal variability and trends in precipitable or total column water vapour (TCWV) is crucial for assessing climate change and hydrological processes. This study utilises European Centre for Medium-Range Weather Forecasts (ECMWF) reanalysis v5 (ERA5) data from 1980 to 2020 to analyse global and regional TCWV and its key drivers, by applying a combined multi-linear regression (MLR) and Peter and Clark Momentary Conditional Independence (PCMCI) causal framework. Equatorial regions (Amazon, Central Africa, and Southeast Asia) show the highest TCWV (> 50 mm), with seasonal peaks during JJA (June–August) and DJF (December–February) linked to monsoon circulation and ITCZ migration, indicating the role of monsoon-driven atmospheric moisture transport in regulating regional precipitation and the global hydrological cycle. Long-term trends show increasing TCWV, particularly over oceans, with strongest seasonal increases over the western Pacific and Indian Oceans (up to 0.18 mm/yr in DJF) and enhanced monsoon-region moisture convergence during JJA (up to 0.16 mm/yr). Our study identifies Amazonia, Central Africa, and West Pacific Warm Pool (WPWP) as critical moisture hubs (35–50 mm) that govern the global hydrological cycle, while Sahara, Sahel, and Third Pole as regions of persistent atmospheric aridity (5–15 mm) with distinct climatic sensitivities. PCMCI identifies regionally distinct drivers of TCWV (φ ≈ 0.12–0.23), with evaporation and Sea Surface Temperature dominating WPWP, wind divergence controlling Sahel and Sahara, moisture export and evapotranspiration – temperature feedbacks regulating Amazon humidity, while El Niño Southern Oscillation, Pacific Decadal Oscillation, and Arctic Oscillation exert significant teleconnected influences. CMIP6 model future projections show a rising TCWV (5 – 25 mm), serving as a major driver of enhanced latent energy, extreme weather events, and regional climate feedback mechanisms. Additionally, projected increase in TCWV-driven radiative-flux equivalent forcing intensifies regional warming, which ranges from about 0.006 W/m2 (SSP2-4.5) to 0.012 W/m2 (SSP5-8.5) by 2100.}
}
@article{DU2026136041,
title = {Pore-scale quantification of interfacial mixing and reaction during radial injection in porous media},
journal = {Journal of Hydrology},
volume = {678},
pages = {136041},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136041},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011388},
author = {Zhipeng Du and Kaiyu Shi and Haixu Duan and Xianghua Yan and Xingrun Wang and Jiajun Chen},
keywords = {Radial injection, Pore-scale mixing, Reactive transport, In situ remediation},
abstract = {Understanding pore-scale mixing and reaction during radial injection is essential for evaluating the efficiency of in situ remediation processes. However, the influence of the continuously decaying radial velocity field (v ∝ 1/r) on interface dynamics remains poorly understood. This study used a microfluidic radial-flow platform featuring controlled cylindrical pillar arrays and a high-resolution colorimetric reaction system to capture transport-regime transitions across three orders of magnitude in Péclet number (Pe) and Damköhler number (Da) by systematically adjusting injection conditions, and to investigate the spatiotemporal evolution of the reactive front. The results showed that, as Pe increased across this range, the cumulative product mass, MC(t), decreased by nearly half. Under these conditions, due to the limitation of pore-scale mixing, the growth kinetics shifted from a t1/2 trend to a slower type behavior, indicating a transition to mixing-limited kinetics. Furthermore, increased porosity improved average reaction rate by approximately 35% by enhancing pore accessibility and interfacial exchange, whereas increased particle size enhanced the effective pore throat size and streamline length. Finally, the dynamic variation of apparent dispersion parameters demonstrated that a single constant dispersion parameter is insufficient to describe the complete radial reactive-transport process. These findings provide pore-scale insights into radial amendment delivery and highlight the need to balance delivery radius, injection rate, and local mixing efficiency in in-situ remediation design.}
}
@article{TU2026136084,
title = {Toward coordinated water allocation in urban agglomerations under joint supply-demand uncertainty: A distributionally robust bi-level multi-objective framework},
journal = {Journal of Hydrology},
volume = {678},
pages = {136084},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136084},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011819},
author = {Yan Tu and Qian Li and Yiqian Ding and Yongzheng Lu and Benjamin Lev},
keywords = {Water resource coordination, Urban agglomeration, Joint supply-demand uncertainty, Wasserstein distributionally robust optimization, Bi-level multi-objective programming, Lexicographic priority},
abstract = {Coordinated water allocation is vital for urban agglomerations where high inter-city dependence amplifies systemic risks. However, traditional management faces strains from climate change and urbanization alongside conflicting interests across management levels. To this end, this study develops a distributionally robust bi-level multi-objective water allocation (DRBMWA) framework to facilitate coordination by integrating a Wasserstein-based distributionally robust representation of joint supply-demand uncertainty. The model features a bi-level multi-objective structure balancing economic cost, environmental load (COD), equity between cities (Gini coefficient), and systemic coordination, with lexicographic priorities (Living > Ecology > Production) reflecting social mandates. The original bi-level model is solved through a tractable single-level reformulation that embeds the lower-level lexicographic responses while preserving the hierarchical decision logic. Applied to the Shandong Peninsula urban agglomeration, results show that: (1) The DRO results reveal a robustness premium, as increasing the conservatism parameter α, which reflects the decision maker’s preference for uncertainty protection, from 1.0 to 1.5 raises the compromise cost by 34.88% while reducing the Gini coefficient from 0.034 to 0.018. (2) Under joint supply-demand stress, the deterministic compromise solution reaches a maximum city–sector shortage rate of 85.64%, whereas the DRBMWA solution maintains sectoral shortage levels within a more controllable range. (3) Compared with the single-level model, the bi-level model reduces the maximum city shortage rate from 21.16% to 14.19% and strengthens the protection of living and ecological water, although at higher transfer cost and COD discharge. (4) Scenario analysis shows that worsening supply-demand conditions substantially increase transfer costs and weaken coordination performance, indicating a greater need for earlier transfer activation and larger fiscal reserves. These findings support annual quota setting, transfer planning, sectoral allocation, and contingency preparation under uncertain water availability.}
}
@article{DEOPA2026135999,
title = {Coupled hydrological and public health risks from urban flooding: integrated remote sensing, machine learning, and hydrodynamic–ecological modelling},
journal = {Journal of Hydrology},
volume = {678},
pages = {135999},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135999},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010966},
author = {Rahul Deopa and Vaibhav Tripathi and PS Nandana and Mohit {Prakash Mohanty}},
keywords = {Hydrodynamic modeling, Machine learning, Public-health risks, Urban flood risks, Water quality modeling},
abstract = {Urban flooding poses concurrent threats to infrastructure, human safety, and public health, particularly in densely populated megacities around the globe, where floodwater often acts as a mobile pathway for microbial contamination. This study develops an integrated remote sensing–machine learning–hydrodynamic modelling framework to quantify coupled flood and microbial health risks. Water surface temperature retrieved from Landsat thermal infrared imagery was used as a predictor in a Support Vector Regression model to estimate spatio-temporal variations in E. coli concentration. These predicted microbial loads were subsequently incorporated into a 3-way coupled MIKE + Flood–ECO Lab framework to simulate flood inundation, contaminant transport, and exposure pathways under flood conditions. Hydro-meteorological forcings, including rainfall, streamflow, and urban drainage flow, together with spatial inputs such as topography and land use–land cover, were used to drive the hydrodynamic simulations. The predicted E. coli concentrations were used to parameterize microbial loading, and infection risks for adults and children exposed to contaminated floodwater were quantified using the β-Poisson dose–response model. Experimenting with the proposed framework over Delhi (India)- a city highly prone to flooding and waterborne health hazards, reveals that ∼ 63% of floodplains faced “high” to “very high” flood hazards, with E. coli levels consistently exceeding safe bathing thresholds (500 MPN/100 mL). Estimated annual infection risks surpassed the USEPA benchmark, with children being the most vulnerable. The study provides actionable recommendations for holistic flood management and emphasizes the urgent need to integrate microbial water quality into flood risk assessment and public health planning, particularly in rapidly urbanizing, climate-sensitive regions.}
}
@article{CHU2026136036,
title = {Physics-guided multi-task learning for urban flood prediction under drainage sedimentation scenarios},
journal = {Journal of Hydrology},
volume = {678},
pages = {136036},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136036},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011339},
author = {Wenhao Chu and Yuqian Hu and Chaosen Jin and Chunxiao Zhang and Suchuang Di and Rongrong Li and Tianbao Wang and Heng Li},
keywords = {Urban pluvial flooding, Drainage system sedimentation, Physics-guided multi-task learning, Multi-gate mixture-of-experts},
abstract = {Compounding pressures from global climate change and rapid urbanization have intensified urban pluvial flooding, creating an urgent need for efficient and reliable prediction tools. However, existing data-driven models typically treat key hydraulic quantities, such as inundation depth and flow velocity, as independent targets. This approach fails to capture hydrodynamic coupling and physical consistency, particularly under drainage network sedimentation scenarios where hydraulic responses are highly non-linear. To address this gap, this study develops a physics-guided multi-task learning framework for pipe-sedimentation conditions, validated using a case study in Beijing. High-fidelity two-dimensional flood fields were generated using a physically-based model across diverse rainfall and sedimentation scenarios. Following a systematic comparison of single-task and multi-task architectures, we incorporated kinetic-energy- and momentum-based constraints as soft physical regularization. Results demonstrate that multi-task learning (MTL) outperforms single-task modeling, achieving higher accuracy in the joint prediction of maximum inundation depth and velocity components. Among the tested architectures, the Multi-gate Mixture-of-Experts (MMOE) network delivered superior performance. Notably, momentum-based constraints outperformed kinetic-energy constraints in enhancing depth–velocity coupling and overall physical consistency. The resulting physics-guided MMOE (PG-MMOE) exhibited robust predictive accuracy and spatial generalization across unseen rainfall–sedimentation combinations, while providing a 113.4- to 277.0-fold acceleration over physically-based model. In summary, this study shows that embedding hydrodynamic priors into MTL through task-aligned physical constraints is an effective strategy for improving urban flood surrogate models. The proposed PG-MMOE framework provides a trustworthy surrogate for scenario-based flood risk assessment, offering quantitative support for maintenance decisions and emergency response under complex urban conditions.}
}
@article{WANG2026136088,
title = {Effects of aquifer heterogeneity and anisotropic conductivity on non-Darcian flow to partially penetrating wells},
journal = {Journal of Hydrology},
volume = {678},
pages = {136088},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136088},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011856},
author = {Qing Wang and Zhenming Shi and Yong Zhi Zhao},
keywords = {Non-Darcian flow, Partially penetrating well, Multi-layered model, Skin effect, Transformed differential quadrature method},
abstract = {This study investigates non-Darcian flow to a partially penetrating well in confined aquifers, considering the stratification of the aquifer. A layered computational model is developed based on the transformed differential quadrature method (TDQM) and the Izbash equation. The continuity equation governing groundwater flow under Izbash’s law is first linearized through an approximation technique. The proposed solution is derived under the adopted linearization approximation and is therefore expected to provide the most reliable predictions during intermediate and late pumping periods. The Laplace transform is then applied, and the radial and vertical directions across multiple layers are discretized using the TDQM scheme, leading to a system of algebraic equations. By incorporating boundary conditions and enforcing inter-layer continuity, a global system matrix is constructed. Solving this matrix system and performing the inverse Laplace transform yield the non-Darcian drawdown solution for the multi-layered confined aquifers. After two validations, case studies are designed to analyze the effects of various parameters on drawdown, including non-Darcian index, comparisons between layered model and the equivalent homogeneous model, sensitivity analysis of hydraulic conductivities, effect of well partial penetration and the influence of well skin.}
}
