@article{ATTAAMPONSAH2026136016,
title = {The application of geospatially-integrated machine learning models for flood prediction: A review},
journal = {Journal of Hydrology},
volume = {678},
pages = {136016},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136016},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011133},
author = {Christopher {Atta Amponsah} and Barnali Dixon and Yi Qiang and Eugene Y. Yan},
keywords = {Machine learning, Flood prediction, Models, Fluvial, Pluvial, Coastal, Compound},
abstract = {With the increase in flooding events globally, Artificial Intelligence (AI) approaches, particularly geospatially integrated machine learning (ML), have emerged as a viable tool for flood modeling. This review systematically analyzed 100 peer-reviewed articles published between 1990 and 2024 to examine trends in ML applications across different flood types, their performance, opportunities, and limitations, and to identify gaps between research activity and flood occurrence, highlighting the need for capacity building in some regions. Results show that ML models are most frequently applied to pluvial floods (44%), followed by fluvial (40%), compound (9%), and coastal (7%) floods, while applications for pluvial, coastal, and compound flooding continue to increase. ANN-based models were the most commonly applied approaches, particularly in fluvial and compound flood studies, followed by SVM and RF models. Reported model performance varied substantially across studies depending on flood type, data availability, and validation strategy, with several localized studies reporting very high predictive accuracy under controlled validation conditions. The geographical distribution of 2,395 flood occurrences from the EM-DAT database revealed disparities between research output and flood occurrence. Publications align relatively well with Asia (50% of publications; 1,450 flood events), Europe (22%; 336 events), and North America (17%; 207 events), whereas Africa (5%; 97 events) and South America (5%; 244 events) remain underrepresented despite significant flood exposure. These findings highlight the need for improved data access, capacity building, and transferable ML approaches to support flood prediction research in underrepresented but flood-prone regions.}
}
@article{PRASHANT2026136068,
title = {Compound droughts as emergent outcomes of cascading drought propagation},
journal = {Journal of Hydrology},
volume = {678},
pages = {136068},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136068},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011650},
author = {Prashant Prashant and Surendra Kumar Mishra and Anil Kumar Lohani and Vijay P. Singh},
keywords = {Cascading drought, Compound drought, Copula, Machine learning, Peninsular India},
abstract = {Compound drought is a complex phenomenon involving various components of the water cycle. Clarifying drought propagation pathways across meteorological, agricultural, and hydrological systems is therefore essential. However, the coupled and non-linear interactions among these drought types that give rise to compound drought conditions remain poorly understood. Here, we investigate compound drought as an emergent outcome of cascading drought propagation across Peninsular India. The proposed framework integrates drought propagation analyses to quantify the scale-dependent propagation of meteorological drought (MD) into agricultural drought (AD) and hydrological drought (HD). It also develops a trivariate copula-based Compound Peninsular India Drought Index (CPIDI) to characterize nonlinear joint drought occurrence and applies machine-learning (ML) emulation with SHapley Additive exPlanations (SHAP) to interpret predictor contributions within the CPIDI emulation framework. MD, AD, and HD are characterized using the Standardized Precipitation Evapotranspiration Index (SPEI) at multiple scales (3, 6, and 12 months), the Standardized Soil Moisture Index (SSI), and the Standardized Runoff Index (SRI) over 1980–2020. The drought-propagation hotspot analysis identified localized and pathway-dependent drought-prone catchments with priority hotspots concentrated over central India, parts of the eastern plateau, and selected southern catchments. CPIDI captured major historical drought years across SPEI scales. Furthermore, ML emulation reproduced CPIDI with high test performance and SHAP indicated that the CPIDI emulators relied mainly on SSI-1, SRI-1, and the scale-matched SPEI, confirming structural consistency within the CPIDI emulation framework. These findings provide empirical evidence that compound droughts emerge as outcomes of cascading drought propagation. Overall, this integrated framework provides a methodological foundation for future operational drought monitoring and assessment for water resources.}
}
