@article{PIAO2026136048,
title = {An improved grout bag–secondary grouting (GBSG) method with time-dependent viscosity modeling for hydrodynamic sealing in karst groundwater conduits},
journal = {Journal of Hydrology},
volume = {678},
pages = {136048},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136048},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011455},
author = {Miao Piao and Qiao Wang and Fusheng Zha and Dongmei Zhang and Long Xu and Bo Kang and Shixian Ren},
keywords = {Underground grouting engineering, Karst conduits, Water inrushes control, CFD simulation, Grouting optimization},
abstract = {Large-scale karst conduits pose persistent challenges for underground sealing because of strong groundwater flow, highly irregular geometries, and severe grout loss. In this study, an innovative grout bag-secondary grouting (GBSG) methodology is introduced. The sealing mechanisms and construction design principles of the GBSG method are investigated using a newly developed extensible time-dependent viscosity model (ETDVM) implemented in OpenFOAM. The ETDVM incorporates a modified Herschel-Bulkley formulation to simulate the time-dependent rheological behavior of grout. The results showed that: (1) in the GBSG method, the grout bag acts as a hydrodynamic buffer, reshaping the internal flow field and generating low-velocity recirculation zones that markedly reduce grout loss; (2) among the investigated variables, water-flow velocity and grout ratio are the dominant factors controlling sealing performance, and the grout with the R3 ratio exhibited the best performance because its higher viscosity and faster setting rate provided the strongest resistance to flow-induced washout; and (3) the combination of a circular bag, an R3 grout ratio, and a relative bag diameter of 1.5 m yielded the best overall performance. Overall, by developing a new numerical viscosity model capable of capturing time-dependent grout rheology, this study enables the optimization of a novel grouting method for large-scale karst conduits and provides a generalizable numerical framework for process innovation and optimization of non-Newtonian grouting in complex hydrogeological environments.}
}
@article{NAG2026136024,
title = {Data-driven simultaneous accounting of diverse agronomic and eco-hydro-climatological stressors for guiding targeted watershed restoration strategies},
journal = {Journal of Hydrology},
volume = {678},
pages = {136024},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136024},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011212},
author = {Swetasree Nag and Ankur Sharma and Icy Trisha and Ravisha Gambhir and Srinivas Rallapalli},
keywords = {Climate variability, Hydrological Stress, Watershed vulnerability and restoration, SWAT, Entropy-COPRAS},
abstract = {Watershed degradation-driven by land use transformation, climatic variability, and agro-ecological disturbances-poses severe threats to water security, agricultural productivity, and ecosystem resilience. Past studies often fail to simultaneously account for the interacting hydrological, climatological, agro-ecological, and terrain-related stressors that collectively determine watershed health. This study develops an integrated vulnerability assessment framework that systematically evaluates 98 sub-watersheds using 20 environmental indicators derived from satellite observations and process-based hydrological simulations. The methodology incorporates both beneficial and non-beneficial indicators—including sediment yield, water stress, drought intensity, vegetation condition, and topographic complexity—aggregated using the Complex Proportional Assessment (COPRAS) method. The key novelties of the approach are threefold: (i) indicators are treated in a sign-consistent manner, ensuring that protective and hazardous factors are evaluated without mutual masking; (ii) indicator weights are derived objectively using entropy, reducing subjectivity and emphasizing variables with higher discriminatory power; and (iii) a two-stage aggregation framework (domain-level followed by composite integration) preserves interpretability while capturing interactions among multiple stressor domains. Results indicate that watershed degradation emerges from the interaction of hydro-climatic variability, ecological condition, and terrain controls, rather than any single dominant factor. While the overall spatial prioritization pattern remains broadly consistent, noticeable sub-watershed-level variations highlight the influence of interannual variability on degradation dynamics. Domain-specific analysis further reveals the coexistence of structurally persistent and temporally sensitive vulnerability regimes, emphasizing the need for differentiated management strategies. The framework is scalable and transferable to other basins, particularly in data-scarce regions, and provides a foundation for prioritizing conservation investments and supporting adaptive watershed management.}
}
@article{TEJA2026136113,
title = {Preserving forecast accuracy with reduced ensemble size: A framework for optimal ensemble selection},
journal = {Journal of Hydrology},
volume = {678},
pages = {136113},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136113},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012102},
author = {Kalakuntla Nikhil Teja and N.V. Umamahesh},
keywords = {Ensemble prediction systems, Ensemble reduction, Post-processing, Verification, Optimal ensemble size, Computational efficiency, Godavari River Basin, India},
abstract = {The utilization of Ensemble Prediction Systems (EPS) from multiple Numerical Weather Prediction (NWP) models for hydro-meteorological analyses, can significantly increase computational requirements. The quest for optimal ensemble size while maintaining comparable accuracy as a full ensemble has been an ongoing area of investigation. In this study, conducted over the Godavari River Basin in India, ensemble precipitation forecasts from the ECMWF and NCEP EPS available in the THORPEX Interactive Grand Global Ensemble (TIGGE) archive for the period 2006–2020 are utilized, while IMD gridded precipitation data for the same period are used as reference observations. The precipitation EPS data are combined into a Grand Ensemble (GE) to evaluate the optimal ensemble size. This was achieved by creating subsets of this GE, also called reduced ensemble sets, using various selection criteria such as correlation, Kling-Gupta Efficiency (KGE), and Probability of Detection (POD) for both 1 mm and 10 mm thresholds. Subsequently, the reduced ensemble sets are post-processed for bias and dispersion correction using the Quantile Regression Forests (QRF) machine-learning model. The results indicate that post-processing effectively achieves the same level of forecast accuracy as the full ensemble but with fewer ensemble members. Spatial plots and boxplots are generated to analyse the results in order to identify the optimal ensemble size. The analysis demonstrates the effectiveness of the proposed framework in identifying reduced ensemble subsets that preserve forecast accuracy while significantly reducing computational cost. The results further indicate that the choice of selection criteria does not substantially influence the optimal ensemble size. The proposed framework is transferable across river basins, alleviating computational burden without compromising predictive performance.}
}
@article{XIE2026136075,
title = {Quantifying the contributions of moisture recycling to precipitation in the monsoon transition zone: Insights from stable isotope data},
journal = {Journal of Hydrology},
volume = {678},
pages = {136075},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136075},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011728},
author = {Cong Xie and Liangju Zhao and Ninglian Wang and Keke Ma and Yuye Qin and Weiwen Yi and Yue Lu},
keywords = {Moisture recycling, Stable hydrogen and oxygen isotope, Isotopic mixing model, Qinling mountains, Monsoon transition zone},
abstract = {Quantifying the moisture recycling ratio derived from surface evaporation and plant transpiration to local precipitation is critical for understanding hydrological processes and land–atmosphere interactions in a changing climate, particularly in the Asian summer monsoon transition zone with complex moisture sources. This study employed a Bayesian three-component isotopic mixing model, combined with stable hydrogen and oxygen isotope data from precipitation and surface water at six sites in the north of the Qinling Mountains during 2020 to 2024, and the simulation data from Isotope-incorporated Global Spectral Model to quantify seasonal variations in the moisture recycling ratio from March to November. Results demonstrate that advected vapor serves as the dominant source of precipitation, with the mean moisture recycling ratio ranging between 32.9% and 40.5%, equivalent to 173.86 to 299.40 mm of local annual precipitation. During the monsoon season (June to October), the ratio varied from 32.5% to 36.0%, compared to 26.5% to 41.5% during the non-monsoon season. Spatially, the recycling ratio exhibited a distinct increasing gradient eastward reflecting the influence of the summer monsoon gradually weakening as it transports from east to west. The proportional contributions from transpiration (21.8 to 29.8%) consistently surpassed those from surface evaporation (7.8% to 13.4%), with the latter showing significantly lower values in summer than in spring and autumn. Temperature emerged as the primary driver of moisture recycling during the monsoon season, while vapor pressure deficit dominated during the non-monsoon period. These findings highlight the importance of recycled moisture to precipitation across the monsoon transition zone and reveal systematic spatiotemporal variations shaped by diverse moisture sources, providing crucial insights for understanding regional hydrological processes.}
}
@article{YAN2026136083,
title = {Identification of spatiotemporal sensitivity of karst spring discharge to precipitation and evaporation: an LSTM–Transformer Decoder framework},
journal = {Journal of Hydrology},
volume = {678},
pages = {136083},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136083},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011807},
author = {Xiping Yan and Meihong Ma and Yonghong Hao and Chunmei Ma and Wenrui Zhang and Qi Wang and Xiaogang Shi and Huiqing Hao and Xinyao Luo and Tianchyi Jim Yeh},
keywords = {Karst spring discharge, Discharge differences, LSTM, Transformer, Hydroclimatic sensitivity, Turning point},
abstract = {Karst hydrological processes are driven by seasonal precipitation and evaporation and modulated by anthropogenic activities within highly heterogeneous aquifers. These processes produce spatiotemporally differentiated and magnitude-dependent responses that remain difficult to simulate and interpret. This study develops an LSTM–Transformer Decoders (LSTM–TDs) framework that links discharge-difference prediction with attention-based hydroclimatic sensitivity identification. To characterize discharge-change dynamics, the LSTM encodes historical first-order discharge differences into a discharge-change state, which then serves as the query for two spatiotemporal Transformer Decoder pathways separately attending to precipitation and evaporation inputs. The resulting attention structures are used to identify meteorological relevance across space, lag, and forcing magnitude. Applied to the Niangziguan Springs in North China, LSTM–TDs outperformed the evaluated benchmark models, with NSE = 0.85, RMSE = 0.34 m3/s, MAE = 0.26 m3/s, and MAPE = 3.88%. Relative to the non-differenced version, the discharge-difference design increased testing NSE from 0.79 to 0.85 and reduced MAPE by 19.8%. Attention-based sensitivity identification showed hydrologically plausible spatial and temporal patterns. Precipitation relevance was mainly concentrated in the main recharge–runoff area with relatively high groundwater levels, evaporation relevance was stronger in soil-moisture-rich areas, and dominant lags were consistent with cross-correlation-derived response times. The model-derived sensitivity turning points were approximately 42.0 mm for precipitation and 130.2 mm for evaporation, and their spatial variations were consistent with differences in infiltration partitioning, terrain-controlled redistribution, and aquifer storage conditions. These results indicate that the LSTM–TDs framework can support spring discharge prediction while providing interpretable diagnostics of hydroclimatic sensitivity in karst systems.}
}
@article{BIONDI2026136043,
title = {A decision-theoretic framework for probabilistic flood warnings},
journal = {Journal of Hydrology},
volume = {678},
pages = {136043},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136043},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011406},
author = {Daniela Biondi and Ezio Todini},
keywords = {Bayesian decision theory, Predictive uncertainty, Flood early warning systems, Decision-making under uncertainty},
abstract = {Early warning systems for weather-related hazards are critical tools for increasing societal resilience, but their effectiveness depends on reliability and ability to support decision-making in the face of uncertainty. While many operational contexts rely on expert judgment and predefined warning thresholds, decision-making processes rarely incorporate a formal assessment of the operational and economic impacts associated with the chosen actions. This study proposes a decision-theoretic approach for issuing flood warnings in Italy’s Sieve basin (Tuscany), integrating probabilistic precipitation forecasts from the national Civil Protection system with a statistical post-processing method to explicitly evaluate predictive uncertainty. The proposed framework introduces a loss function that adapts to multiple warning levels and accommodates different risk propensities (from risk-averse to risk-prone), effectively meeting the operational needs of diverse stakeholders. The system’s performance is evaluated by comparing a Bayesian decision scheme with one that explicitly accounts for precipitation forecast uncertainty, assessing cumulative economic costs against different baseline scenarios. Results demonstrate that adopting a Bayesian cost-based approach yields economic benefits and substantial improvements in the Relative Economic Value (REV). Furthermore, incorporating precipitation uncertainty drives the system toward more cost-effective warning strategies, reducing false alarms and expected losses.}
}
@article{PAN2026136090,
title = {A refined reservoir evaporation loss estimation approach through improved wind function expression accuracy},
journal = {Journal of Hydrology},
volume = {678},
pages = {136090},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136090},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601187X},
author = {Cuihong Pan and Zengliang Luo and Lunche Wang and Zigeng Niu and Zushuai Wei and Ruijie Wang},
keywords = {Weighted wind direction method, Penman equation, Reservoir evaporation, Global scale, Seasonality},
abstract = {Reservoir evaporation is a key component of the hydrological cycle, but its accurate estimation is hindered by complex reservoir geometry and spatially heterogeneous wind fields. Penman–based estimates of reservoir evaporation commonly represent wind direction using spatial averages over reservoir, neglecting shape effects and wind field heterogeneity, which introduces substantial uncertainty into evaporation estimates, especially for elongated reservoirs. This study proposes a reservoir–scale weighted wind direction method that incorporates reservoir geometry, spatial distribution features, while accounting for influencing factors. The method is applied to 6853 large reservoirs worldwide to estimate and analyze monthly evaporation during 1985–2021. The results showed that: (1) Compared with the mean wind direction method, weighted wind direction method yielded systematically lower wind direction variability (Stdweighted<Stdmean, with negative mean relative bias and paired T–statistics), and showed better agreement with ground-based meteorological observations, with mean rRMSE and MAPE reduced by 0.29 and 25.43%, respectively. Accordingly, evaporation estimated using weighted wind direction method was more consistent with the TerraClimate, ERA5–Land and FLUXCOM evaporation products; (2) Differences in fetch length between the two methods were significantly negatively correlated with differences in evaporation (CC ≤  − 0.7), indicating that larger fetch length differences generally resulted in lower evaporation estimates derived from the weighted wind direction method, whereas similar fetch lengths between the two methods tended to produce relatively higher evaporation estimates from the weighted wind direction method; (3) During 1985–2021, the seasonality of monthly reservoir evaporation showed a clear spatial pattern, weakening from high latitudes in the Northern Hemisphere toward the Southern Hemisphere. Overall, 53.92% of reservoirs exhibited increasing trends, while 12.31% showed decreasing trends. These reservoirs were mainly used for irrigation and water supply, suggesting a potential link to intensified anthropogenic water use.}
}
@article{CHRISTIANSEN2026136067,
title = {Mapping temperate groundwater-dependent terrestrial ecosystems in Denmark},
journal = {Journal of Hydrology},
volume = {678},
pages = {136067},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136067},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011649},
author = {David Terpager Christiansen and Guy Schurgers and Rasmus Ejrnæs and Julian Koch},
keywords = {Groundwater-dependent ecosystems, Remote sensing, Positive-unlabeled learning, NDVI, Temperate wetlands, Machine learning, Sentinel-2},
abstract = {Groundwater-dependent Ecosystems (GDEs) are critical biodiversity hotspots and drought refugia that are driven by complex groundwater and ecological interactions. The detection of GDEs in temperate regions remains challenging due to weak phenological contrasts with surrounding vegetation. We developed a Positive-Unlabeled (PU) machine learning framework to detect temperate GDEs in Denmark using minimal input variables: two Normalized Difference Vegetation Index (NDVI) variables derived from Sentinel-2 imagery, and Height Above Nearest Drainage. The approach exploits two NDVI signals: the drought-resilience of GDEs during dry summers (dry-season analogue), and their delayed spring green-up caused by waterlogged soils. Our model achieved 79% detection of field-mapped GDEs within Danish NATURA 2000 areas while identifying 7 times more potential GDE area (122.500 ha) and finds further 222.000 ha of GDEs in river valleys outside the monitored NATURA 2000 areas. Plausibility analysis using a Water table depth (WTD) dataset, and tree species dataset showed good agreement between labeled and predicted GDEs. Sensitivity analysis across different model parameterizations revealed predicted GDE coverage ranging from 22% to 65% of the study area, with true positive rates of 45% to 93%. The framework addresses key limitations in GDE mapping by requiring only positive training labels and few input variables. The model performs comparably to dryland GDE detection methods while operating without explicit dry season dynamics. These results establish a baseline for temperate GDE detection across regions, supporting land- and water-resources management, and compliance with environmental directives requiring GDE identification.}
}