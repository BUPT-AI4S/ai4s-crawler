@article{ROJASARAYA2026136044,
title = {Photo-dependent processes and their effect on the CO2 dynamics in high-altitude wetlands},
journal = {Journal of Hydrology},
volume = {678},
pages = {136044},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136044},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011418},
author = {Josefa Rojas-Araya and Gino Vera and Francisco Gracia and Alberto {de la Fuente} and Ana L. Prieto},
keywords = {High-altitude wetlands, Saline lakes, CO flux dynamics, Photo-dependent processes, Photocatalytic reduction},
abstract = {High-altitude wetlands in South America, or “salares,” are found in the central depression of the closed catchments in the Andean Altiplano region of Chile, Bolivia, Peru, and Argentina. Formed by groundwater upwelling and surface evaporation, salares are subjected to severe environmental conditions and host mineralogically rich soils dominated by metallic oxides, including TiO2. This study combines field observations of CO2 fluxes across the air–water interface (AWI), water quality parameters, soil mineralogy composition, and phenomenological models to characterize the transport and reactivity of CO2 at the Salar del Huasco (Chile). Eddy-covariance measurements at Huasco’s Water and adjacent Desert sites show that CO2 uptake is tightly coupled to shortwave solar radiation and humidity, a pattern inconsistent with benthic photosynthesis alone and indicative of an uncharacterized photo-dependent sink. As a first step toward characterizing potential photo-dependent processes, the photocatalytic reduction of CO2 to CH4 and the deposition of carbonates were evaluated in controlled laboratory experiments.Although field data reveal net CO2 uptake of up to 4 g CO2 m−2 d−1 during austral spring, photocatalytic reduction and carbonate formation were not confirmed under laboratory conditions. Nevertheless, a first-order transport–reaction model reproduced observed fluxes across three independent field campaigns (NSE = 0.73–0.78, ρ = 0.89–0.92), with a single set of photochemical parameters transferable between Huasco’s Water and Desert sites. This study provides previously overlooked insights into the role of photo-dependent processes in high-altitude wetlands; however, future work should identify specific photo-dependent processes and their spatial/seasonal contributions to the CO2 dynamics of the Salar del Huasco.}
}
@article{LI2026136133,
title = {Climate network-based synchronized structural identification of extreme drought and pluvial events in cross-basin regions},
journal = {Journal of Hydrology},
volume = {678},
pages = {136133},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136133},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012308},
author = {Wenyu Li and Jun Xie and Juan Cao and Kaiwen Li and Kai Liu and Ming Wang},
keywords = {Cross-basin regions, Climate network, Reverse dipole extreme event, Drought and pluvial events},
abstract = {Global warming has intensified the frequency and intensity of synchronous climate extremes, posing severe threats to the water‒food‒energy‒ecosystem nexus and challenging regional sustainability. In previous studies, scholars have often overlooked the inverse symbiotic relationship between drought and pluvial events and the complex, nonlinear spatiotemporal correlations underlying transregional climate extremes. Here, by using a complex network, we systematically identify the synchronous structure of drought, pluvial, and drought–pluvial dipole (DPD) events along the western route of the South-to-North Water Diversion Project in China. Our analysis reveals a distinct wet‒dry co-variability between the Yangtze and Yellow River Basins and elucidates the physical coupling between extreme hydroclimatic events and circulation anomalies, as well as the moisture transport pathways. Remote coupling zones of DPD events are identified alongside a pronounced spatial asymmetry in cross-basin hydroclimatic behavior. Compared with DPD events, which exhibit robust cross-basin teleconnections, drought and pluvial synchronicity are predominantly characterized by short-to-medium spatial scales. Notably, the signal sources for these extremes are anchored in the southwestern portion of the study area. We show that positive geopotential height anomalies, airflow subsidence, and monsoon disruption drive drought conditions, whereas the transport of warm, moist air generates pluvial events, together forming a “drought‒pluvial seesaw” at the climatic scale. Our findings offer valuable insights into adaptive strategies for cross-basin water resource management and pluvial–drought risk assessment.}
}
@article{LI2026136121,
title = {Physics-informed machine learning of hyporheic exchange driven by channel blockage and riverbed morphodynamics},
journal = {Journal of Hydrology},
volume = {678},
pages = {136121},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136121},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012187},
author = {Hang Li and Linlin Li and Defu Liu and Genguang Zhang and Jiahao Zou and Yu Lei and Canyong Li},
keywords = {Hyporheic exchange, Large woody debris, Scour-deposition morphology, Physics-Informed Machine Learning},
abstract = {Riverbed morphodynamic alterations induced by channel blockages, particularly those associated with large woody debris (LWD), play a critical role in modulating hyporheic exchange processes. However, most existing predictive approaches have not fully accounted for scour–deposition evolution, limiting the accuracy of hyporheic exchange flux (HEF) estimation. To address this, our study develops an enhanced physics-informed machine learning (PIML) framework to quantify the combined effects of hydraulic conditions, structural configuration, and riverbed morphology on hyporheic exchange dynamics. The computational framework generates 97 synthetic LWD-flow interaction cases, with six representative morphodynamic descriptors extracted to parameterize the resultant scour–deposition architecture. HEF was predicted through a hierarchical framework integrating empirical regressions, machine learning, and PIML, enabling adaptive estimation under varying data conditions. With morphodynamic descriptors available, both the empirical equation and ensemble learning models reproduced HEF with high accuracy (NSE ≈ 0.96); whereas using only initial flow–structure inputs reduced accuracy and the PIML approach, which incorporates the study-derived empirical flux equation, maintained higher performance (NSE = 0.79). SHAP analysis revealed that HEF is primarily governed by flow–morphology interactions and effective submergence ratio. Ensemble-based models, particularly Extra Trees and Gradient Boosting, demonstrated high predictive skill in capturing nonlinear morphodynamic responses. These results demonstrate that the hierarchical framework provides a unified and physically consistent strategy for predicting HEF across variable hydraulic–morphologic conditions.}
}
@article{MA2026136052,
title = {High-resolution floodplain topography mapping from ICESat-2 and Sentinel-2 using slope-corrected inundation frequency},
journal = {Journal of Hydrology},
volume = {678},
pages = {136052},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136052},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011492},
author = {Ju Ma and Ming Zhong and Shengmei Yang and Song Ye and Xuan Ban and Qinchuan Xin and Feng Ling},
keywords = {ICESat-2, Sentinel-2, Inundation frequency, River-floodplain topography, Slope correction},
abstract = {Accurate representation of floodplain topography is essential for hydrological modeling, ecosystem assessment, and flood risk estimation. This study proposes a novel approach to produce high-resolution floodplain topography maps, integrating inundation frequency map derived from Sentinel-2 imagery and river cross-sectional terrain from Ice,Cloud, and Land Elevation Satellite-2 (ICESat-2). While satellite-derived inundation frequency (IF) maps provide indirect elevation information, they are susceptible to slope-induced bias in river floodplains. To eliminate the spatial heterogeneity introduced by gradient along the river channel, a quantitative relationship between floodplain elevation and inundation frequency was established, incorporating slope correction. Specifically, we calculated the slope gradient sequence of the river in the study area to construct a slope correction lookup table (LUT). Then, we calibrated the elevation of each sample point by eliminating the slope gradient based on the correction origin. This study uses the lower Han River floodplain as a case study, covering approximately 100 km of river reach with an elevation variation of about 5 m. The proposed method yielded RMSEs of 1.039 m, 1.364 m, and 1.375 m for the Han River, Mississippi River, and Han River in-situ validation, respectively, indicating high predictive accuracy and strong robustness across validation settings. The stable model performances were present by comparing the algorithmic accuracy across 10- meter, 5- meter, 2.5-meter spatial resolutions of inundation frequency. Different slope data is also suit for this slope-corrected method, such as SWORD-derived slope information. The model error. This method requires no in-situ measurements, making it broadly applicable to data-scarce or inaccessible floodplains worldwide.}
}
@article{CHEN2026135971,
title = {Morphological optimization of urban small watershed blue–green infrastructure to enhance stormwater management benefits: a case study of the Xuanwu Lake Watershed, Nanjing},
journal = {Journal of Hydrology},
volume = {678},
pages = {135971},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135971},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010681},
author = {Xin Chen and Xiaojun Wang},
keywords = {Urban stormwater management, Urban small watershed, Blue–green infrastructure, Morphological optimization},
abstract = {Climate change combined with high density urban development has continuously intensified stormwater risks in small urban watersheds, placing increasing pressure on drainage systems. The morphology of blue-green infrastructure (BGI) is widely recognized as a critical determinant of stormwater performance, yet a clear framework for morphological optimization is still lacking. This study develops an innovative methodological framework that integrates type, configuration, distribution, and network to guide BGI morphological optimization. The river network was first optimized, followed by the design of multiple BGI types and connection paths schemes that incorporate river corridors, bioretention systems (BSs), and green roofs (GRs). These were combined with several configuration levels to generate a series of scenarios. Using the 33 km2 Xuanwu Lake watershed in Nanjing as a case study, 26 scenarios were evaluated with the Storm Water Management Model (SWMM) and the Australian National University and Geoscience Australia hydrodynamic model (ANUGA). The analyses focused on total flood volume, peak flow at watershed outlets, maximum water depth, unit scale average water depth, and unit scale peak flow. The efficiency patterns associated with each configuration level were examined, and based on these observations, a composite strategy of “an overall appropriate configuration level with interventions in high-risk units” was proposed. The results indicate that optimizing the river network alone can reduce total flood volume by 35.86% under the 10-year return period (RP10) event. Under the RP10 event, increasing green-space configuration substantially improved system performance. At the 25% level, peak flow and total flood volume were reduced by an average of 26.64% and 59.54%, respectively. When configuration reached 100%, the corresponding reductions increased to 53.41% and 92.91%. Converting BS installations from isolated distribution to connected distribution with surrounding pervious and impervious surfaces provided an additional 15.9%–45.35% reduction in total flood volume. Linking the GR and BS in series improved regulation by a maximum of 2% and enhanced system stability. Marginal efficiency exhibited clear stage-dependent characteristics. The 0%–25% configuration interval achieved the highest reduction in total flood volume, while the 25%–50% interval showed an improvement in peak flow reduction. Beyond 50%, the benefits declined markedly. Efficiency responses at the watershed and unit scales were generally consistent. These findings provide a solid evidence base for spatial BGI morphological planning and offer a scalable methodological framework for strengthening the resilience of urban watersheds.}
}
@article{YONG2026136060,
title = {Spatiotemporal evolution and propagation of GNSS-derived PWV-based meteorological and soil moisture drought: a case study of the contiguous United States (2003–2022)},
journal = {Journal of Hydrology},
volume = {678},
pages = {136060},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136060},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011571},
author = {Weiao Yong and Xiaolei Wang and Hao Yang and Jinsheng Tu},
keywords = {Global navigation satellite system, Precipitable water vapor, Meteorological drought, Soil moisture drought, Drought propagation},
abstract = {Accurate drought characterization requires indicators that can capture atmospheric and terrestrial processes over multiple scales. While traditional drought indices derived from satellite and reanalysis data are well established, Global Navigation Satellite System (GNSS)-derived precipitable water vapor (PWV) offers a high-temporal-resolution, all-weather alternative that remains underutilized in current drought monitoring frameworks. In addition, understanding the propagation from meteorological drought (MD) to soil moisture drought (SMD) is essential for revealing drought evolution mechanisms. In this study, a novel application of GNSS PWV, in combination with precipitation, was used to construct a Standardized Precipitation Conversion Index (SPCI) for characterizing meteorological droughts across the contiguous United States (CONUS) during 2003–2022, while SMD were quantified using the Standardized Soil Moisture Index (SSMI) to further investigate drought propagation dynamics. Results revealed that the SPCI demonstrates strong agreement with SPI and SPEI across multiple timescales. MD showed a tendency toward intensification in 50.19% of the CONUS, while only 4.07% showed significant trends (p < 0.05), with drought events characterized by high frequency and long durations. SMD exhibited even greater intensification, with 59.56% of the CONUS showing worsening drought conditions, with 40.53% showing significant trends (p < 0.05), and events tending to be more prolonged and severe. Leveraging both indices, a spatiotemporal analysis of drought propagation from MD to SMD was conducted. A widespread and rapid propagation was identified, with approximately 73.80% of the region exhibiting a propagation time within 0–1 month. The fastest propagation (around 0.1 month) occurred in the Southwest and West climate regions, while arid and humid zones showed longer propagation durations than semi-arid and semi-humid regions. To further understand the underlying mechanisms, driver attribution analysis was performed. Precipitation was identified as the dominant driver for both MD and SMD, while dew point temperature emerged as an important secondary factor, particularly for SMD development in the southwestern CONUS. These findings suggest that incorporating GNSS-derived PWV provides additional atmospheric moisture information that improves the understanding of drought characteristics and their propagation from the atmosphere to the land surface, supporting improved drought monitoring and early warning.}
}
@article{FURLANETTO2026136020,
title = {Embedding geological realizations in global sensitivity analysis: a Morris-based screening approach for complex aquifer systems},
journal = {Journal of Hydrology},
volume = {678},
pages = {136020},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136020},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011170},
author = {Davide Furlanetto and Rodrigo Pérez-Illanes and Daniel Fernàndez-Garcia and Matteo Camporese},
keywords = {Geological uncertainty, Multilayer aquifer, Confined aquifer, MODFLOW, Morris’ method, Global sensitivity analysis},
abstract = {Global sensitivity analysis (GSA) is increasingly used for interpreting complex hydrogeological models and identifying the relative importance of different sources of uncertainty. Although classical methods focus primarily on parameter uncertainty, the role of geological uncertainty, arising from incomplete knowledge of the spatial arrangement of the hydrogeological facies, may be equally relevant. In this study, we propose an extension of the Morris’ Elementary Effects Test to incorporate geological uncertainty represented through multiple geostatistical facies realizations in a GSA framework. This general approach enables a combined assessment of the influence of parametric and geological uncertainty within a computationally parsimonious diagnostic framework, identifying the factors that most strongly affect different model outputs. The methodology is applied to a complex regional-scale aquifer system located in northern Italy, with integrated modeling of river–aquifer interactions. Across all investigated outputs, the saturated hydraulic conductivity of the gravelly aquifers consistently emerges as the dominant source of uncertainty. However, the spatial arrangement of the facies and the hydraulic properties of the confining units can locally influence hydraulic heads and advective particle tracking as much as aquifer parameters. We also show that parameters controlling river–aquifer exchange processes can affect advective transport pathways even in deep confined aquifers. The proposed approach provides actionable guidance for model refinement, data prioritization, and sensitivity-informed parameter selection.}
}
@article{HAAS2026136056,
title = {Ecohydrological trend detection in the Mobile Bay Watershed-AL using a rolling window Mann-Kendall test},
journal = {Journal of Hydrology},
volume = {678},
pages = {136056},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136056},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011534},
author = {Henrique Haas and Musa Esit and Latif Kalin and John Lehrter},
keywords = {Rolling Mann–Kendall test, Hydrological trends, Trends within trends, Ecological flow metrics, Mobile Bay Watershed},
abstract = {Detecting temporal variability in streamflow is critical for sustainable water management and ecological conservation. Traditional monotonic trend analysis methods, such as the Mann-Kendall (MK) test and Sen’s slope estimator, often fail to capture episodic or evolving trends embedded within hydrological time series. In this study, we apply a Rolling Window Mann-Kendall (RW-MK) method to identify “trends within trends” in streamflow metrics across the Mobile Bay watershed (MBW) in the southeastern United States. This method applies the MK test and Sen’s slope estimator across overlapping 30-year windows with a one-year lag, revealing subtle temporal variations that conventional approaches overlook. We assess annual, monthly, and ecologically relevant flow metrics derived using the Indicators of Hydrologic Alteration (IHA) framework. While traditional whole-period (monotonic) analysis showed no significant changes in mean annual flow, a rolling-window trend test uncovered significant declines in low flows (e.g., 1-day minimum flow at –1.94 m3/s/year for 1979–2008) and high flows (e.g., 7-day maximum flow at –70.91 m3/s/year for 1978–2007). Seasonal and percentile flow analyses further demonstrated spatiotemporal heterogeneity in trends, with significant decreases in both low and high percentile flows. Correlation analyses revealed that long-term declines in low-flow metrics were strongly associated with declining populations of oysters (Crassostrea virginica) and blue crabs (Callinectes sapidus), while spotted seatrout (Cynoscion nebulosus) exhibited opposite responses, highlighting potential ecological consequences of altered freshwater inflows in the Mobile Bay estuary. To facilitate broader application of the proposed methodology, we developed the open-source rwMK R package, which provides reproducible tools for rolling-window trend analysis and visualization. Our findings offer novel insights into the temporal variability of hydrological trends and support the use of moving window approaches in ecohydrological research.}
}
@article{KIM2026136072,
title = {Groundwater flow regimes and intrinsic vulnerability in a fractured bedrock aquifer: insights from hydrochemistry, isotopes, geophysics, and groundwater age},
journal = {Journal of Hydrology},
volume = {678},
pages = {136072},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136072},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011698},
author = {Jaeyeon Kim and Ye Ji Kim and Chung-Mo Lee and Seho Hwang and Dong-Chan Koh and Yoon Yeol Yoon and Kang-Kun Lee and Hanna Choi},
keywords = {Groundwaterflow system, Intrinsic vulnerability, Fractured bedrock aquifer, Groundwater age, Groundwater renewal, Hydrogeophysics},
abstract = {Intrinsic vulnerability in fractured bedrock aquifers is commonly evaluated using index-based approaches, yet these methods often underestimate the role of flow system architecture, recharge mechanisms, and groundwater renewal in controlling contaminant susceptibility. In structurally complex aquifers, vulnerability patterns are strongly controlled by heterogeneous flow paths and residence time distributions, which are not adequately represented by static approaches. This study integrates hydrochemistry, environmental isotopes (δ18O, δ2H, 87Sr/86Sr), tritium-based groundwater age modeling, multivariate statistical analysis, and geophysical investigations to constrain groundwater flow systems in a fractured bedrock aquifer in the Boeun region, Korea. Integration of these independent datasets reveals three distinct groundwater flow regimes: (i) a laterally dominated shallow system with strong surface connectivity, (ii) a vertically stratified mountain front recharge system with fracture-controlled deep circulation, and (iii) a rapidly renewed shallow system characterized by short residence times and diffuse recharge. The identified flow regimes provide a processed-based framework for interpreting intrinsic vulnerability. Despite groundwater quality index values indicating excellent water quality at present, DRASTIC results show moderate to high vulnerability associated with rapid recharge and structurally connected flow paths. This contrast demonstrates that intrinsic vulnerability is primarily controlled by recharge processes, groundwater flow systems, and renewal dynamics, rather than by static hydrogeological parameters alone. These findings highlight the importance of incorporating groundwater renewal dynamics, residence time structure, and flow system heterogeneity into vulnerability assessments of fractured aquifers.}
}
@article{HAILU2026136125,
title = {Introducing IQR–DEMO for precipitation network design optimization},
journal = {Journal of Hydrology},
volume = {678},
pages = {136125},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136125},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012229},
author = {Assefa Hayelom Hailu and Paulin Coulibaly},
keywords = {IQR, DEMO, Precipitation monitoring networks, Multiobjective optimization, NSGA-II, Inverse distance weighting},
abstract = {This study introduces an integrated Information Quality Ratio (IQR) and Dual Entropy Multiobjective Optimization (DEMO) framework for optimizing precipitation network design. In the proposed IQR–DEMO framework, IQR analysis is directly embedded within the DEMO algorithm. Although entropy-based methods such as DEMO effectively maximize information content and minimize redundancy among selected stations, they often overlook spatial imbalances across the basin and generate a large set of non-dominated solutions that can hinder practical decision-making. IQR, which quantifies station redundancy within a network, has been used as a post-design evaluation method, thereby limiting its influence on the optimization itself. To address this gap, the proposed framework incorporates IQR as a spatial penalty during the evolutionary search. For each candidate solution, an IQR analysis is performed, and the resulting values are interpolated over a high-resolution grid. The fraction of the basin falling outside a predefined IQR range is then used to penalize spatially imbalanced configurations through the objectives. This integration guides the algorithm toward network layouts that are both information-rich and spatially representative of the entire basin. The framework is demonstrated using three contrasting case studies, and the results show that the IQR–DEMO generally improves spatial coverage, reduces clustering of stations, and enhances basin-wide information quality. Sensitivity analyses further highlight how variations in the upper IQR threshold and penalty coefficient can influence network spatial coverage. Overall, the proposed approach offers a practical, adaptive, and spatially sensitive tool for designing efficient and spatially representative precipitation monitoring networks.}
}
@article{TACCARI2026136064,
title = {AIFL: A global daily streamflow forecasting model using deterministic an LSTM pre-trained on ERA5-Land and fine-tuned on IFS},
journal = {Journal of Hydrology},
volume = {678},
pages = {136064},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136064},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011613},
author = {Maria Luisa Taccari and Kenza Tazi and Oisín M. Morrison and Andreas Grafberger and Juan Colonese and Corentin {Carton de Wiart} and Christel Prudhomme and Cinzia Mazzetti and Matthew Chantry and Florian Pappenberger},
keywords = {Global hydrology, Streamflow forecasting, Long short-term memory (LSTM), CARAVAN MultiMet},
abstract = {Reliable global streamflow forecasting is essential for flood preparedness and water resource management, yet data-driven models often suffer from a performance gap when transitioning from historical reanalysis to operational forecast products. This paper introduces AIFL (Artificial Intelligence for Floods), a deterministic LSTM-based model designed for global daily streamflow forecasting. Trained on 18,588 basins curated from the Caravan dataset, AIFL utilises a two-stage transfer-learning strategy to bridge the reanalysis-to-forecast domain shift. The model is first pre-trained on 40 years of ERA5-Land reanalysis (1980–2019) to capture robust hydrological processes, then fine-tuned on operational Integrated Forecasting System (IFS) forecasts (2016–2019) to adapt to the specific error structures and biases of operational numerical weather prediction. Ablation experiments confirm that this two-stage approach outperforms both a naive IFS-only baseline and a mixed-forcing single-stage alternative. To our knowledge, this is the first global model trained end-to-end within the Caravan ecosystem. On an independent temporal test set (2021–2024), AIFL achieves high predictive skill with a median modified Kling–Gupta Efficiency (KGE′) of 0.66 and a median Nash–Sutcliffe Efficiency (NSE) of 0.53. Benchmarking results show that AIFL achieves comparable accuracy to current state-of-the-art global systems. The model provides a streamlined and operationally robust baseline for the global hydrological community.}
}
@article{SUN2026136059,
title = {Learning geometry-aware streamflow forecast models from a large-scale river graph dataset},
journal = {Journal of Hydrology},
volume = {678},
pages = {136059},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136059},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601156X},
author = {Alexander Y. Sun and Albert A. Sun},
keywords = {Streamflow forecast, Graph neural networks, CAMELS, Meshgraphnet, Geometry-aware ML, Hybrid machine learning},
abstract = {Streamflow forecasting is a central component of hydrological modeling, providing critical decision support to a wide range of water resources applications. In recent years, numerous data-driven and hybrid machine learning (ML) methods have been introduced, yet their predictive capacity depends critically on how effectively complex spatial and temporal processes across multiple scales are represented. Here we investigate the feasibility of incorporating river network geometry as a structural constraint in training basin-agnostic streamflow forecasting models. We curate a large-scale graph dataset comprising more than 500 U.S. basin networks, nearly 100,000 river nodes, and approximately six billion data points. River graphs are constructed from high-resolution hydrofabric layers. Message-passing graph neural network (GNN) models are developed to learn generalizable latent representations of river network dynamics, using inputs/outputs of the U.S. National Water Model (NWM). Results demonstrate that a single GNN may be pretrained to approximate the NWM streamflow dynamics reasonably well, with the best-performing GNN model achieving a median Kling-Gupta Efficiency (KGE) exceeding 0.8 across all river network nodes and 0.96 at basin outlet nodes for 3-hour-ahead forecasting. The pretrained GNN model exhibits robust performance when tested on holdout basins outside the range of training basins. Furthermore, fine-tuning the pretrained model using gauge observations reduces model biases inherited from the NWM, further improving predictive performance. These findings highlight the potential of geometry-aware GNNs as a new class of scalable hydrological ML models.}
}
@article{WANG2026136080,
title = {Coupled shallow-water hydrodynamics and reactive transport of emerging contaminants in unsteady flows},
journal = {Journal of Hydrology},
volume = {678},
pages = {136080},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136080},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011777},
author = {Mengyun Wang and Mario Morales-Hernández and Pilar Brufau and Pilar García-Navarro},
keywords = {Emerging contaminants, Shallow-water reactive transport, Integrated physicochemical/biochemical processes, GPU-accelerated computation, Reference solution verification, Sobol sensitivity analysis},
abstract = {Emerging contaminants (ECs) pose persistent risks to aquatic ecosystems, yet their transport and fate in dynamic surface-water systems remain difficult to quantify because of trace concentrations and costly measurements. Existing shallow-water transport models often treat ECs as passive tracers or adopt simplified first-order decay formulations, limiting their ability to represent the integrated effects of hydrodynamic transport and physicochemical/biochemical reactions. To address this gap, this study develops one-dimensional (1D) and two-dimensional (2D) shallow-water reactive transport models for simulating the transport and fate of ECs in transient free-surface flows. The proposed framework integrates key EC-specific processes, including biodegradation, hydrolysis, photolysis, volatilization, bioconcentration/depuration, and sorption/desorption, within an advection–dispersion-reaction formulation coupled to shallow-water hydrodynamics. The models are first verified against reference solutions and then applied to a real flood event in the Ebro River using a hypothetical antibiotic release scenario. Results show that release timing strongly controls EC exposure patterns: for identical source loads, peak-flow releases produced lower concentration maxima because of stronger dilution and faster plume spreading, whereas recession-flow releases led to more persistent detectable concentrations. The 2D simulation also reveals flood-driven lateral transport from the main channel into inundated agricultural areas, highlighting the role of floodplain connectivity in shaping EC exposure under extreme events. To support high-resolution 2D applications, the model has been implemented on graphics processing units (GPUs), which reproduces the CPU results with significant computational saving. Overall, the study provides a computationally robust, efficient, and physically based framework for integrated simulation of EC transport and fate in dynamic shallow-water systems.}
}
@article{XIAO2026136040,
title = {Two new analytical models for constant rate pumping test in double-porosity multilayered confined systems: New Robin flow equation for aquitards},
journal = {Journal of Hydrology},
volume = {678},
pages = {136040},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136040},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011376},
author = {Yexi Xiao and Ching-Sheng Huang},
keywords = {Constant rate pumping test, Double porosity, Aquitard flow equation, Robin boundary condition, Analytical model, Numerical model},
abstract = {Accurate numerical solutions to aquitard flow equations derived based on an infinitesimal cubic require fine spatial discretization in aquitards. This study applies the divergence theorem of Gauss to derive a new Robin flow equation based on a finite-thickness element enabling no discretization in aquitards. Two analytical models are built for constant rate pumping test in a double-porosity three-layer confined system of two aquifers and one aquitard in between. One model applies the new Robin flow equation while the other applies a traditional aquitard flow equation. The semi-analytical solutions of the models are derived. The finite element solutions are also derived. Results suggest the new Robin flow equation is applicable within 5% relative error in predicting drawdowns when quantitative conditions are met. The new Robin flow equation reduces to a new double-porosity lagging Robin boundary condition, and a typical Robin boundary condition in groundwater textbooks. Temporal aquifer drawdown can be triple-humped distribution with three flats due to the storage effects of the matrices in aquifers and aquitard. The finite element solution with the traditional aquitard flow equation can be accurate but requires about 106 nodes to discretize the aquifers and aquitard. The accurate finite element solution incorporating the new Robin flow equation requires only 2,002 nodes representing coarse square discretization in the aquifers and no discretization in the aquitard and takes 1/1503 of the computing time of obtaining the other accurate finite element solution with the traditional aquitard flow equation. The present solution applies to a field constant rate pumping test.}
}
@article{YANG2026136092,
title = {Characterizing water quality responses to connectivity frequency and flow magnitude in a regulated river–lake system},
journal = {Journal of Hydrology},
volume = {678},
pages = {136092},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136092},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011893},
author = {Su Yang and Guishan Yang and Rongrong Wan and Xijun Lai and Luhua Gu and Bing Li and Hengpeng Li and Chen Xu},
keywords = {Hydrological connectivity, Water quality, Scenario-based simulation, Urbanized plain river network, Connectivity frequency, Flow magnitude},
abstract = {The construction of large-scale hydraulic projects has disrupted hydrological connectivity between rivers and lakes, directly affecting water quality and posing profound risks to water security. However, the quantitative understanding of how different modes of connectivity affect water quality in the sluice-controlled river network area remains limited. In this paper, we proposed a novel scenario-based framework to assess the water quality responses to connectivity from the dual perspectives of temporal frequency and flow magnitude, which is regulated by hydraulic facilities’ operation. Regional water quality was simulated under a series of connectivity frequency scenarios using connectivity–water quality response formulas. Meanwhile, the water quality of major rivers under varying discharge conditions was evaluated by the hydrodynamic–water quality model. Results indicate that continuous operation of recession and regulating sluices, together with extending the nonflood operation of pumping stations to 3–41 days, significantly reduces TP, TN, NH3-N, and CODMn concentrations by 1% to 4%. Besides, increasing inflow discharge results in moderate improvements in water quality, with a discharge of 50 m3/s reducing the mean TN concentration by approximately 1.4 mg/L compared with baseline conditions. Maintaining stable low-flow discharge at outflow sluices prevents prolonged stagnation and supports overall nutrient export. These findings demonstrate that water quality changes in regulated river–lake networks are jointly governed by connectivity timing and flow intensity, providing an analytical framework for adaptive water management in urbanized plain river networks.}
}
