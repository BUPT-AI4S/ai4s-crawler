@article{YINGXIAO2026136031,
title = {Silicon-mediated stoichiometric controls on phytoplankton community shifts in the Yangtze and Yellow Rivers},
journal = {Journal of Hydrology},
volume = {678},
pages = {136031},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136031},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011285},
author = {Li Yingxiao and Chi Yuning and Zhong Xiaosong and Liu Xiaotian and Lv Zongqing and Wu Wentao and Ran Xiangbin},
keywords = {Dissolved silicate, Phosphorus-limited, Phytoplankton diversity, Nutrient stoichiometry, Yangtze river, Yellow river},
abstract = {Anthropogenic nutrient enrichment has restructured phytoplankton communities in major river ecosystems by altering nutrient stoichiometry. This study compares divergent nutrient regimes and phytoplankton dynamics in the Yangtze and Yellow Rivers, identifying distinct environmental characteristics shaped by nutrient stoichiometry and sediment transport. While both rivers exhibit comparable levels of dissolved inorganic nitrogen (DIN) and silicate (DSi), phosphorus (DIP) remains the primary limiting nutrient. Notably, the Yellow River is distinguished by significantly higher suspended sediment (SS), which regulates light availability and nutrient limitation. Our findings identify DIP as the primary determinant of the Diatom Index, whereas DSi availability constrains total biomass. Spatial analysis reveals a river course peak in phytoplankton diversity and biomass in the midstream sections, predominantly composed of Bacillariophyta, followed by a downstream transition toward Cyanobacteria and Chlorophyta. This successional shift is associated with variations in DSi/DIN and DSi/DIP ratios, together with other interacting environmental factors. Anthropogenic pressures have altered nutrient molar ratios and SS transport, leading to a decline in diatom dominance and potentially promoting cyanobacterial blooms. These findings indicate the need for basin-specific nutrient management strategies to protect the integrity of freshwater ecosystems.}
}
@article{DENG2026136051,
title = {Precipitation water conversion rate variations and driving mechanisms in the Yangtze-Huang-Huai-Hai river basin over the past 60 years},
journal = {Journal of Hydrology},
volume = {678},
pages = {136051},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136051},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011480},
author = {Haodong Deng and Yu Wang and Qingming Wang and Chaoqun Li and Fusheng Li and Dengming Yan and Xiaoxue Chen and Dongqing Zhang and Kai Hou and Benxing Lou and Lichuan Wang},
keywords = {PWCR, Precipitation, Water vapor content, The Yangtze-Huang-Huai-Hai River basin},
abstract = {Precipitation water conversion rate (PWCR) is a key indicator of the efficiency with which atmospheric vertically integrated water vapor content (IWV) is converted into precipitation. This study investigates the long-term variations and driving mechanisms of PWCR in the Yangtze-Huanghe-Huaihe-Haihe River (YHHH) basin, China, from 1956 to 2024. The results show that PWCR decreased significantly at a rate of −1.19%·dec−1, while IWV increased by 2.83 mm·dec−1 and precipitation decreased by −18.95 mm·dec−1. These opposite trends indicate that increasing atmospheric moisture did not translate into enhanced precipitation conversion. Seasonal analysis further reveals distinct mechanisms in summer and winter. In summer, PWCR is mainly controlled by precipitation changes jointly regulated by relative humidity (RH) and temperature. Higher RH favors precipitation formation, whereas warming may reduce conversion efficiency by increasing atmospheric moisture-holding capacity. In winter, PWCR is primarily governed by RH-mediated precipitation processes. Overall, the decline in PWCR reflects a weakening efficiency of atmospheric water vapor conversion under a warming and drying background. These findings improve understanding of water vapor–precipitation transformation in large monsoon-influenced basins and provide useful evidence for hydrological modeling and climate adaptation.}
}
@article{TIAN2026136124,
title = {Responses of soil physicochemical properties to land preparation measures revealed by fractal parameters of soil particle size distribution: effectiveness and limitations},
journal = {Journal of Hydrology},
volume = {678},
pages = {136124},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136124},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012217},
author = {Zhuo Tian and Kangye Deng and Qinxue Xu and Xin Jin and Shuaipu Zhang},
keywords = {Rocky desertification slope, Land preparation measure, Soil particle size distribution, Physicochemical properties, Fractal theory},
abstract = {Rocky desertification slopes are characterized by shallow soil layers and limited water and nutrient storage, which severely restrict plant growth. The construction of reverse slopes (RS) and flat terraces (FT) can alter the redistribution processes of soil particles by modifying surface microtopography, thereby improving soil moisture and nutrient conditions. However, the application of RS and FT on rocky desertification slopes remains limited. Moreover, the critical role of soil particle redistribution in regulating soil physicochemical properties has not yet been fully elucidated. Therefore, RS and FT were innovatively constructed on rocky desertification slopes in this study, and fractal parameters of soil particle size distribution (SPSD) were employed to reveal the responses of soil hydraulic properties and nutrient contents to different land preparation measures. Results demonstrated that SPSD under different land preparation measures were predominantly concentrated within the range of 0.07–93.95 μm, accounting for 92.75% of the total particle distribution. RS exhibited the highest values of symmetry degree Δf, capacity dimension D(0), information dimension D(1), correlation dimension D(2), and D(1)/D(0), reaching 0.64, 0.95, 0.92, 0.90, and 0.96, respectively. The construction of RS simultaneously improved soil hydraulic properties and nutrient conditions on rocky desertification slopes, and their coupled regulation processes revealed the underlying mechanisms governing changes in soil hydraulic properties and nutrient dynamics. Among them, the construction of RS produced the most pronounced improvements in soil saturated hydraulic conductivity (Ks) and organic matter (OM). Relative to natural slopes (NS), Ks and OM under RS increased by 330.43% and 94.85%, respectively. Fractal parameters are important indicators for characterizing SPSD and can reflect soil physicochemical properties to a certain extent. However, soil properties are simultaneously influenced by external environmental conditions, internal pore structures and biogeochemical processes, resulting in inherent limitations when fractal parameters are used alone to characterize soil properties. This study highlights the effectiveness and limitations of fractal parameters in revealing soil physicochemical properties, while providing scientific guidance for sustainable cultivation and ecological management on rocky desertification slopes.}
}
@article{WANG2026136003,
title = {A decision-making framework for the trade-off between water conservation and water supply functions in the Wei River basin},
journal = {Journal of Hydrology},
volume = {678},
pages = {136003},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136003},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011005},
author = {Dongdong Wang and Yangwen Jia and Cunwen Niu and Jiajia Liu and Yaobing Sui and Chunfeng Hao},
keywords = {Water conservation function, WEP-L model, Decision-making, Ideal point method, Scenario analysis, The Wei River},
abstract = {It remains a major challenge to determine the suitable spatial extent of vegetation restoration within a watershed to balance upstream water conservation (WC) and downstream water supply. To address this trade-off, we propose a novel framework that integrates scenario analysis with multi-objective decision-making methods. The framework primarily consists of three key steps. Firstly, the Water and Energy process in Large River Basin (WEP-L) model is employed to identify the most suitable Land Use/Land Cover (LULC) conversion type to enhance the main WC functions in each sub-basin. Secondly, a multi-objective decision-making approach was developed to simultaneously maximize upstream WC and downstream water supply, incorporating a food security constraint for the study area. Finally, the ideal point method was applied to determine the optimal extent of vegetation restoration that best balances these competing objectives. The framework is implemented in the water conservation area of the Wei River Basin (WCA-WRB), a critical region in the Wei River Basin of China. The results indicated that converting 28% of the study area to the LULC type most suitable for the function of decreasing floods would be the most effective strategy. This corresponds to a vegetation restoration area of approximately 3757 km2, of which approximately 3092 km2 of cropland was converted to vegetation, representing 5% of the total study area. This proposed framework offers a valuable reference for guiding vegetation restoration projects in similar semi-arid and semi-humid regions.}
}
@article{YAO2026136055,
title = {Projecting flood exposure in China under future climate and population change: an age-structured analysis based on the SSP-RCP scenarios},
journal = {Journal of Hydrology},
volume = {678},
pages = {136055},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136055},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011522},
author = {Qian Yao and Can Lu and Mengya Li and Jiangyang Lin and Hanqing Xu and Dai Yamazaki and Jun Wang},
keywords = {Flood exposure, Climate change, Population vulnerability, SSP-RCP scenarios, China},
abstract = {Accurate projecting future flood exposure requires accounting for both climatic drivers and population structure. However, most assessments overlook age-related disparities in exposure, focusing on total population or economic losses. Here, we present age-structured flood exposure projections in China under future climate and population changes, based on SSP scenarios. We integrate multi-model climate projections, a physically-based hydrodynamic model, and age-structured population data to assess future flood exposure among children, working-age adults, and the elderly. Results show that, although the total population may decline, climate-driven flood hazards will dominate, with overall flood exposure projected to increase by 2.9 (2.4–6.5) times by 2100. The elderly will face the most dramatic increase—up to 6.9 (6.7–18.8) times—potentially surpassing working-age adults. Decomposition analysis reveals that the interaction of climate and population change accounts for up to 53% of the increase in elderly exposure, exceeding the independent effect of climate alone. Our findings highlight the urgency of integrating population structure into multiscale flood exposure assessments, and call for targeted adaptation strategies to address age-related vulnerabilities under future scenarios.}
}
@article{GYAMFI2026136014,
title = {Multi-modal dual-target spatio-temporal graph learning for regional evapotranspiration estimation},
journal = {Journal of Hydrology},
volume = {678},
pages = {136014},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136014},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601111X},
author = {Kwame Adutwum Gyamfi and Eun-Sung Chung},
keywords = {Evapotranspiration, Graph neural networks, Dual-encoder learning, Multi-source supervision, Multi-horizon forecasting},
abstract = {Accurate evapotranspiration (ET) estimation remains challenging because physically based formulas rely on simplifying assumptions, whereas satellite products contain retrieval uncertainty. We develop a multi-modal dual-encoder, dual-target spatio-temporal graph neural network for regional ET estimation over the Korean Peninsula. The framework treats meteorological forcing and MODIS-derived surface descriptors as heterogeneous but complementary modes. A hybrid graph represents geographic-distance and inter-station-correlation structure, modality-specific graph encoders and a recurrent temporal encoder capture spatio-temporal dependence, and a learnable gate fuses climate and satellite representations while quantifying their relative contributions. The model is trained jointly against MODIS ET and FAO-56 Penman–Monteith reference ET (PM ET0), combining satellite-observed actual ET with meteorological evaporative demand. On the holdout test set, the model achieved MAE/RMSE/R2 of 2.197/3.503/0.883 for MODIS ET and 0.473/0.615/0.999 for PM ET0. Relative to a graph-free CNN + LSTM dual-head baseline, MAE decreased by 33.3% for MODIS ET and 39.0% for PM ET0. Component ablation showed that the full multi-modal dual-target configuration reduced joint MAE by 40.0% and RMSE by 38.6% relative to the single-encoder MODIS variant. Gate analysis showed that climate and satellite contributions vary by season and input position, making the fusion interpretable rather than fixed. MC-dropout uncertainty with isotonic calibration achieved PICP90 of 0.895 and 0.899 for MODIS ET and PM ET0, respectively. Multi-horizon tests retained seasonal predictability up to 12 months.}
}
@article{PRASHANT2026136035,
title = {A holistic index for hydrological characterization of catchments},
journal = {Journal of Hydrology},
volume = {678},
pages = {136035},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136035},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011327},
author = {Prashant Prashant and Surendra Kumar Mishra and Anil Kumar Lohani and Vijay P. Singh},
keywords = {Runoff restricting potential index, Ideal gas law, Peninsular India, Agro-ecological zones},
abstract = {Hydrological indicators like runoff coefficient, evaporative index, etc., often capture only fragments of the underlying catchment behaviour that governs runoff generation, particularly under long-term climatic and land-use changes. We introduce a novel, holistic, non-dimensional runoff restricting potential index (RRPI) that quantifies the runoff-restricting behaviour of catchments. RRPI is conceptually and structurally analogous to the ideal gas law. It conceptualizes catchments as open hydrological systems, where climatic forcings such as rainfall, volumetric storage, energy-driven evapotranspiration, and mobilized runoff interact to characterize catchments’ behaviour. For pragmatic applicability, RRPI was transformed into a bounded form using a non-linear function, making it a normalized RRPI (NRRPI), useful for inter-catchment comparison and classifying catchments. NRRPI classifying catchments were derived using an integrated hybrid Shannon Entropy–TOPSIS–Jenks framework and were applied to 406 catchments across Peninsular India from 1980 to 2020, enabling long-term hydrological characterization using annual-scale data. Principal Component Analysis (PCA) confirmed the distinct behaviour of NRRPI from conventional hydrological indicators and explained 86.8% of total variance. The Mann-Kendall (MK) test showed 93 trend-affected catchments, i.e., 53.8% show increasing NRRPI, and 46.2% significantly (p-value < 0.05) decreasing in the peninsular catchments. Further, stratifying NRRPI trends by 11 Agro-Ecological Zones (AEZs) highlights increasing, decreasing, and stable catchments. The study finds NRRPI to be efficacious in integrating key water balance components into a consistent and system-responsive indicator for interpreting catchment behaviour in terms of its functioning and hydrological changes.}
}
@article{REN2026136063,
title = {Simultaneous aridification of soil moisture driven by anthropogenic activities in China’s loess critical zone},
journal = {Journal of Hydrology},
volume = {678},
pages = {136063},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136063},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011601},
author = {Meng Ren and Yu Liu and Huiming Song and Qiufang Cai and Qiang Li and Changfeng Sun and Xiangyu Duan and Zekun Hu},
keywords = {Soil moisture reconstruction, Anthropogenic activity, Tree-tree δO, Chinese Loess Plateau, Simultaneous aridification},
abstract = {The Chinese Loess Plateau (CLP), as China’s loess critical zone, exhibits pronounced sensitivity to soil moisture variations, which critically govern regional hydrological cycles and agro-ecological security. However, limited by scarcity of long-term in-situ soil moisture observations, the historical variations, trends and driving mechanisms of soil moisture in this region remain unclear, severely hindering accurate assessments of current and future ecological drought risks. Here, we present the first reconstructions of summer 0–10 cm soil moisture historical variations for the northeastern CLP (NEC) (1675–2012 CE) and southwestern CLP (SWC) (1556–2015 CE), based on tree-ring stable oxygen isotopes (δ18O). The study revealed a significant synchronous decline in soil moisture across both the NEC and SWC since the Industrial Revolution, with decline rates of 6.1 %/10a and 9.0 %/10a, respectively. Compared to the pre-industrial era, the soil moisture variation trends in both regions since the 1850s exhibited higher interdecadal coherence, along with significant increases in the frequency of extreme drought events.Attribution analysis of multi-model ensembles of Coupled Model Intercomparison Project Phase 6 (CMIP6) demonstrates that anthropogenic activities are the dominant drivers of the simultaneous aridification of soil moisture in the NEC and SWC since the 1850s.Concurrently, internal climate variability has synergistically amplified the soil moisture aridification trends and their spatial coherence on both interannual and decadal timescales. Our findings imply that regional soil moisture aridity will further worsen if global warming and anthropogenic activities intensify in the future.}
}
@article{JI2026136042,
title = {Hydrogeochemical evolution in a semi-arid basin: coupled effects of hydrogeological processes, mineral weathering, and biogeochemical processes},
journal = {Journal of Hydrology},
volume = {678},
pages = {136042},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136042},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601139X},
author = {Deshuai Ji and Wenke Wang and Jie Li and Ning Liu and Manhong Xia and Xiaoqin Huang},
keywords = {Hydrogeochemical evolution, Nutrient cycling, Hydrogeological processes, Mineral weathering, Biogeochemical processes, Yinchuan Plain},
abstract = {Large sedimentary basins in semi-arid regions typically develop hierarchically nested groundwater flow systems. Their large spatial scales challenge the elucidation of hydrogeochemical evolution within thick aquifers. This study aims to reveal the coupled control mechanisms of hydrogeological processes, mineral weathering, and biogeochemical transformations on hydrochemical evolution and nutrient cycling. Relying on a representative multi-level monitoring transect to collect vertically discrete samples along flow paths in the Yinchuan Plain, China, we systematically elucidated hydrogeochemical evolution by integrating hydrodynamics, multivariate statistics, and multi-isotope tracers (3H, 15N, 34S, 18O, 13C, 14C, and 87Sr/86Sr). Results indicate that hydrodynamics drives geochemical environment and hydrochemical evolution. From recharge to discharge zones, decreasing flow velocities and progressive electron acceptor consumption shift groundwater from oxidizing conditions dominated by nitrification and sulfide oxidation to reducing conditions where Fe/Mn reduction and DNRA occur. Concurrently, prolonged residence times alter mineral thermodynamic equilibria, shifting dominant water–rock interactions from silicate/carbonate weathering to evaporite dissolution. Notably, the mechanisms controlling groundwater quality evolution vary across different hierarchical flow systems. Local flow systems are controlled by the combined influence of anthropogenic activities and biogeochemical processes, with anthropogenic inputs contributing up to 76.2% of nitrate pollution. In contrast, intermediate and regional flow systems are primarily impacted by evaporite dissolution and DNRA. Furthermore, geological faults in the discharge zone force the upwelling of the regional flow system, which has a contribution rate of 52%–57% to the groundwater quality in the mixing zone, leading to anomalous solute enrichment. Ultimately, this study establishes a conceptual model of hydrogeochemical evolution driven by coupled hydrogeological processes, mineral weathering, and biogeochemical processes. These findings provide a crucial scientific basis for groundwater resources and water quality management in semi-arid basins under anthropogenic pressures.}
}
@article{MAHAPATRA2026136091,
title = {Hydrology-driven transport-storage dynamics, metals interaction, and ecological risk of downstream riverine microplastics},
journal = {Journal of Hydrology},
volume = {678},
pages = {136091},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136091},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011881},
author = {Sarbanee Mahapatra and Jyoti Prakash Maity and Gobinda Dey and Tanisha Mishra and Shuvendu Singha and Alok Chandra Samal and Sourasis Chattopadhyay and Sutanu Mangal and Prosun Bhattacharya},
keywords = {Microplastics, Transport-storage dynamics, Seasonal variation, Physiochemical elemental characteristic, Riverine system, Ecological risk},
abstract = {The occurrence of microplastics (MPs) in monsoon-dominated rivers is influenced not only by the source inputs but also by seasonal hydrological shifts that regulate their transport to storage in downstream regions of the riverine system. The present study investigated MPs in surface water and bed sediments of the downstream riverine system during the pre-monsoon, monsoon, and post-monsoon periods to determine how discharge influences abundance, sediment–water partitioning, polymer-density sorting, metal association, and screening-level ecological risk. The results showed that MPs in surface water followed the order: monsoon (1169.8 ± 68.81 items/m3) > pre-monsoon (951.9 ± 45.42 items/m3) > post-monsoon (598.4 ± 69.42 items/m3), indicating enhanced runoff-driven mobilization and downstream transport under high-discharge conditions. In contrast, sediment MPs showed the trend: post-monsoon (1251.5 ± 32.04 items/kg) > pre-monsoon (976.1 ± 30.67 items/kg) > monsoon (971.9 ± 36.09 items/kg), reflecting a transition from monsoon-driven export to post-monsoon depositional storage. This pattern was further supported by the sediment–water enrichment index, which increased from 0.83 in the monsoon to 2.09 in the post-monsoon, confirming greater sedimentary retention under reduced hydrodynamic forcing. White/transparent particles, fragments, and fibres dominated both matrices, indicating mainly secondary and weathered MPs. Raman analysis identified polymers in the order PP > PE > PET > PS > PVC, and showed density-driven sorting between water and sediment. FESEM–EDX revealed weathered surfaces and associated potentially toxic elements, suggesting that MPs may act as carriers of co-contaminants. This findings highlight that monsoon hydrology strongly regulates MPs transport, storage, and ecological risk in tropical river systems.}
}
@article{CHENG2026136071,
title = {Coexistence of Darcy and non-Darcy flows in deep limestone aquifers: insights from multi-scale imaging and pore-scale simulation},
journal = {Journal of Hydrology},
volume = {678},
pages = {136071},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136071},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011686},
author = {Wenju Cheng and Chao Niu and Huiyong Yin and Lele Xiao and Qiang Sun and Chengwei Zhang and Songsong Cheng and Dabao Zeng},
keywords = {Jungar coalfield, Top of the ordovician, Limestone aquifer, Multi-scale characterization, Micro-mesoscopic structure, Seepage simulation},
abstract = {The deep Ordovician limestone aquifer in the Jungar coalfield has undergone intense physical dissolution and chemical filling, forming a highly heterogeneous and complex micro-pore-fracture multi-media system, which is a critical hazard-causing factor inducing mine water inrush. To reveal the seepage laws and micro-dynamic control mechanisms of the complex karst media, this study adopted multi-scale pore structure characterization techniques to finely and quantitatively extract the micro- and meso-scopic void topological structures of the limestone samples, and conducted pore-scale nonlinear dynamic simulations based on 3D digital core reconstruction. The results indicate that the porosity of the deep limestone media in the study area ranges from 2.1% to 4.2%, developing a highly heterogeneous coupled network of dissolution pores and micro-fractures. Among them, the micro-fracture system, with apertures mainly distributed between 14 and 60 μm, acts as the key hub connecting isolated dissolution pores, constituting the absolute dominant channel for fluid migration. The pore-scale simulations quantitatively revealed the significant characteristics of “multi-flow regime coexistence” within the complex and strongly heterogeneous media: in micro-dissolution pores and poorly connected regions, fluid momentum transfer is completely dominated by viscous resistance, manifesting as typical linear Darcy laminar flow; whereas in well-connected dominant micro-fracture channels and at locations with abrupt changes in pore-throat morphology, the fluid undergoes intense convergence and convective acceleration, leading to a significant increase in inertial forces. Driven by high hydraulic gradients, the flow regime within the dominant channels evolves into non-Darcy flow strongly controlled by local microstructures. From a micro-quantitative perspective, this study elucidates the coexistence mechanism of multiple flow regimes involving Darcy and non-Darcy flows in deep karst dual-media systems. The findings provide a solid micro-physical basis and novel insights for breaking through the single Darcy flow assumption, modifying macroscopic water inrush prediction models in mining areas, and formulating precise prevention and control strategies for coal mine floor water hazards.}
}
@article{QIU2026136047,
title = {A procedure for geostatistical inversion incorporating a high-resolution initial hydraulic-conductivity field from travel time inversion},
journal = {Journal of Hydrology},
volume = {678},
pages = {136047},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136047},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011443},
author = {Huiyang Qiu and Ning Luo and Yong Huang and Chao Zhuang and Xiaolan Hou and Walter A. Illman and Rui Hu},
keywords = {Subsurface heterogeneity, Novel inversion procedure, Geostatistical inversion, Travel time inversion},
abstract = {Hydraulic tomography (HT) has been proven as a robust approach to map subsurface heterogeneity through the joint inverse modeling of multiple pumping test data. A persistent difficulty is that GI can produce overly smooth or biased tomograms in data-sparse regions. TTI offers complementary information because it can efficiently recover a diffusivity (D) structure from early-time hydraulic responses. In this study, we propose a TTI-informed GI procedure. The procedure first estimates a D tomogram by TTI, converts that D tomogram into a heterogeneous hydraulic conductivity (K) field; which is utilized as initial K guess for GI. Three cases of HT analyses with various initial guesses are designed for a noise-free numerical case study, which are: (a) effective homogeneous K and Ss; (b) zonation model results built by different structure information; (c) heterogeneous initial guess of K from TTI. The comparisons show that the proposed procedure is demonstrated effective for the Herten aquifer analogue, which is a well-characterized geological database in Germany. It has outstanding performance similar to a scenario of integrating a zonation model with accurate geological information. This study highlights that the TTI results with acceptable quality can contribute to improving the performance of GI in data sparse areas, especially when geological information is not available.}
}
@article{YUAN2026136045,
title = {Rainfall event timing and thresholds govern reverse sap flow in desert shrubs},
journal = {Journal of Hydrology},
volume = {678},
pages = {136045},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136045},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601142X},
author = {Zixuan Yuan and Yiben Cheng and Zhiming Xin and Yuxuan Liu and Tao Yu and Jingwen Li and Lixia Chu},
keywords = {Ulan Buh Desert, Reverse sap flow, Foliar water uptake, Rainfall pulses, Hydraulic redistribution},
abstract = {Precipitation in arid regions typically occurs as short, pulsed events that simultaneously alter atmospheric humidity and soil moisture, making it difficult to disentangle their respective effects on plant water transport. This study aimed to isolate the atmospheric pathway and quantify sap flow responses of two desert shrubs, Haloxylon ammodendron and Tamarix ramosissima, to pulsed rainfall events. Controlled rainfall experiments (2, 6, and 10 mm) were conducted at three times of day (morning, afternoon, and night) during the peak growing season (June–August) of 2024 and 2025 in the Ulan Buh Desert. Sap flow was continuously monitored in primary branches, main trunks, and roots. Sap flow responses depended on rainfall timing, rainfall amount, and species. Rainfall events generally reduced sap flow relative to pre-event conditions and often induced transient reverse flow, defined here as a temporary reversal of xylem water movement from aboveground tissues toward stems or roots, particularly at night. Nighttime rainfall produced the strongest responses, indicating that atmospheric moisture inputs can rapidly modify plant water potential gradients. Responses showed clear threshold-like patterns: H. ammodendron was more sensitive to small and moderate rainfall pulses (∼6 mm), whereas T. ramosissima generally required larger inputs (∼10 mm) to produce comparable responses. Response lags followed a top–down sequence, with faster adjustments in aboveground organs and delayed responses in roots, and these patterns differed between species. Among the meteorological drivers examined, photosynthetically active radiation (PAR) explained the largest proportion of sap flow variability across species and organs. These results indicate that small, well-timed rainfall pulses, especially those occurring at night, can temporarily regulate plant water transport through atmospheric pathways. The findings improve our understanding of soil–plant–atmosphere interactions in arid ecosystems and provide insights for vegetation restoration and water management under pulsed water availability.}
}
@article{QIN2026136066,
title = {Variations in rainfall DOM as a driver of surface water concentration in the Chinese Loess Plateau-Qinling Mountains transition zone},
journal = {Journal of Hydrology},
volume = {678},
pages = {136066},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136066},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011637},
author = {Caiqing Qin and Pinrong Ji and Ke Xu and Adrian M. Bass and Pan Zhang and Ji Chen and Yiping Wu},
keywords = {Rainwater, Dissolved organic matter, Carbon cycle, Loess Plateau-Qinling Mountains transition zone, Backward trajectory},
abstract = {Wet deposition of dissolved organic matter (DOM) is important yet understudied for fluvial carbon cycling. To investigate rainwater DOM sources and their contributions to riverine systems in the Chinese Loess Plateau (CLP)-Qinling Mountains (QM) transition zone, this study captured 57 rainwater samples with varying rainfall intensities over one year, accompanying monthly surface water sampling from an adjacent river. Three major fluorescent DOM (FDOM) components were observed in rainwater, including a polycyclic aromatic hydrocarbon-like component (C1), a low-aromaticity humic-like component (C2), and a tryptophan-like proteinaceous component (C3). C1 dominated FDOM and exhibited seasonal variations, highlighting the importance of anthropogenic inputs, especially in summer. Higher aromaticity and humification in autumn and winter reflected the combined effects of anthropogenic inputs and photochemical processes. The results confirmed the influence of CLP dust on rainwater DOM, particularly during spring dust episodes. Backward trajectories revealed the contributions of air masses originating from dust source regions to increased particulate matter and associated organic compound inputs. The high-altitude QM acts as a geographical-climatic barrier regulating DOM transport. Rainwater-derived DOM contributed <1% to surface water directly, highlighting rainstorm-induced terrestrial runoff and in-stream biogeochemical processes for riverine DOM, consistent with the higher humification and aromaticity of riverine FDOM and their smaller seasonal fluctuation. The discrepancies in DOM between rainwater and surface river indicate different dominant source controls and processing pathways, while likely remaining linked through rainfall-runoff and post-precipitation transport. This study highlights the significance of underlying surface characteristics across CLP-QM regions in affecting rainwater DOM and its contribution to terrestrial riverine systems. Rainstorm-induced soil washing and runoff processes deserve attention for quantifying riverine DOM sources in the future.}
}
@article{LI2026136074,
title = {Synthetic DNA fragments enable improved characterization of specific storage heterogeneity through multi-source data fusion},
journal = {Journal of Hydrology},
volume = {678},
pages = {136074},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136074},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011716},
author = {Xinlin Li and Zhaofei Duan and Xiaoting Xie and Jirka Šimůnek and Renkuan Liao},
keywords = {Hydrological tracer, Aquifer heterogeneity, Fusion approach, Uncertainty quantification, Hydraulic characteristics},
abstract = {Characterizing the spatial heterogeneity of aquifer specific storage (Ss) at high resolution remains a major challenge in subsurface hydrology. This study developed a novel precision-weighted fusion framework that combines hydraulic conductivity (K) estimates obtained from steady-state hydraulic tomography (SSHT) and synthetic DNA tracer tomography (TT), along with diffusivity (D) estimates generated from travel-time hydraulic tomography (TTHT), to enable high-resolution characterization of Ss through the decoupled relationship Ss = K/D. The framework was further evaluated through controlled laboratory sandbox experiments with known layered heterogeneity, comparing homogeneous (same-source) and heterogeneous (cross-source) fusion scenarios. Results demonstrated that the heterogeneous fusion of structurally independent data sources (pressure-field hydraulic tomography and tracer ray-path tomography) is critical for accurate Ss characterization. Uncertainty analysis revealed that, relative to the individual tracer arrays, homogeneous fusion reduced the mean K-field uncertainty σ(ln K) by 29.6%, whereas heterogeneous fusion reduced it by 44.0%; the corresponding reductions in Ss uncertainty σ(ln Ss) were 11.5% and 15.9%, respectively. Synthetic DNA tracers, whose virtually unlimited unique sequences enable simultaneous multi-array tomographic surveys without cross-interference using qPCR detection, proved particularly effective in this framework. The synthetic DNA-based heterogeneous fusion achieved improved predictive accuracy (R2 = 0.81, MAE = 0.54 cm) compared to dye-based fusion (R2 = 0.71, MAE = 0.57 cm), preserving stronger structural fidelity throughout the fusion chain. The findings offer the potential for high-resolution characterization of the spatial and temporal characteristics of aquifer specific storage, providing a prerequisite for accurate prediction and effective management of groundwater.}
}
@article{QU2026136127,
title = {Hydrogeochemical dynamics of boron associated with groundwater discharge in river and lake basins},
journal = {Journal of Hydrology},
volume = {678},
pages = {136127},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136127},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012242},
author = {Shen Qu and Lijuan Hu and Wei Bao and Le Qiao and Chuntao Zhao and Wengeng Cao and Limin Duan and Xiaomin Liu and Ruihong Yu},
keywords = {Boron, Groundwater discharge, Hydrogeochemistry, Environmental isotopes, River and lake basins},
abstract = {Boron (B) is a trace element widely distributed in nature and actively participates in biogeochemical cycles in aquatic systems. However, the mechanisms governing B enrichment and migration associated with groundwater discharge across different basin types remain insufficiently understood. In this study, a hybrid isotopic approach integrating multiple isotopic tracers (D, 18O, 11B, and 222Rn) with quantitative models was used to elucidate and quantify the sources and transport dynamics of B in the Bahannao Lake Group Basin (BLGB) and the Xiliugou River Basin (XRB) in Inner Mongolia, China. The results indicated that the average B concentration in surface water of the BLGB (4.03 mg/L) was substantially higher than that in the XRB (0.64 mg/L). In the BLGB, B enrichment was jointly regulated by relatively balanced contributions from natural processes (evaporation, mineral dissolution, and desorption) and anthropogenic inputs. In contrast, B enrichment in the XRB was predominantly driven by anthropogenic inputs. Moreover, lacustrine groundwater discharge (LGD) and riverine groundwater discharge (RGD) exerted a potential influence on B enrichment in both systems. The B flux associated with groundwater discharge in the BLGB (3.83 × 104 g/d) was markedly higher than that in the XRB (1.47 × 104 g/d). This study elucidates the different mechanisms underlying B enrichment in lake and river basins and provides a scientific basis for B risk management in similar regions.}
}
@article{LI2026136038,
title = {TCE redistribution and inferred entrapment in loess under groundwater table fluctuation patterns},
journal = {Journal of Hydrology},
volume = {678},
pages = {136038},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136038},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011352},
author = {Yaoxiang Li and Ningjie He and Xiaoqian Li and Aiguo Zhou and Lei Zhao and Yuxuan Fang},
keywords = {Groundwater table fluctuation, Coupled amplitude and velocity, TCE redistribution, Inferred entrapment, Loess},
abstract = {Groundwater table fluctuations (GTF) regulates the multiphase distribution and mass transfer of trichloroethylene (TCE) through the coupling amplitude and velocity, which determine moisture content redistribution and hydrodynamic forcing. This study quantified TCE redistribution in metastable loessial silt under various GTF patterns using soil column experiments. Results demonstrate that fluctuation amplitude determines the vertical range of elevated moisture content, while velocity dictates the moisture content distribution within the affected zones. From a transfer perspective, high moisture content facilitates TCE desorption in the source zone but inhibits adsorption in surrounding soil layers due to competitive site occupancy. Hydrodynamic conditions and moisture content also govern the mass transfer processes: high-amplitude fluctuations generate a stronger piston effect that drives vapor-phase TCE toward surface, whereas low-amplitude fluctuations provide insufficient hydrodynamic force to break through the upper buffer zone. Furthermore, fluctuation velocity regulates the rate and magnitude of concentration changes in both the vapor and aqueous phases. Capillary moisture content regulates vapor-phase entrapment and aqueous-phase transport efficiency. Mechanistically, we propose a conceptual link wherein high-moisture-triggered structural collapse of metastable soil skeleton reduces pore size and enhances physical entrapment. These results highlight the necessity of integrating medium metastability into environmental risk assessment to avoid underestimating vapor intrusion and secondary release hazards driven by physical entrapment.}
}
@article{LIU2026136119,
title = {An attention-enhanced hybrid physics-informed neural network for multi-parameter inversion of heterogeneous reservoirs in CO2 geological storage},
journal = {Journal of Hydrology},
volume = {678},
pages = {136119},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136119},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012163},
author = {Zhankui Liu and Peixue Jiang and Ruina Xu and Zhen Wang},
keywords = {Parameter inversion, Physics-informed neural network, Attention mechanism, Karhunen-Loève expansion, CO geological storage},
abstract = {Accurate characterization of heterogeneous reservoir properties and robust prediction of CO2 plume migration are critical for the safety assessment and monitoring of geological carbon storage. Geological parameter inversion in high-dimensional heterogeneous reservoirs under limited observations remains a strongly ill-posed problem. In this study, an attention-enhanced hybrid physics-informed neural network inversion framework is developed. This framework integrates multiphase flow governing equations, rock-physics constraints, observational data, low-dimensional geological priors, and attention-enhanced neural-network representations into a unified inversion architecture and loss formulation. A hybrid attention mechanism combining parallel sub-networks, self-attention, and cross-attention is designed to improve the network’s ability to learn complex nonlinear features. Karhunen-Loève expansion (KLE) is employed to construct a low-dimensional and geologically constrained prior parameter representation. Gaussian kernel feature mapping is also used to improve the caption of localized variations. The proposed framework is validated using a two-dimensional single-well CO2 injection scenario in a heterogeneous reservoir. Numerical results demonstrate that the framework can accurately reconstruct pressure and saturation fields, as well as heterogeneous distributions of porosity and permeability. A systematic ablation study further confirms the critical roles of attention mechanisms and KLE-based prior representations in improving inversion accuracy and stability. This study provides a promising tool for prediction and risk assessment in CO2 geological storage applications.}
}
@article{PEREZ2026136022,
title = {Re-evaluating probable maximum precipitation estimates: sensitivity to transposition domains and storm rotation using modern datasets},
journal = {Journal of Hydrology},
volume = {678},
pages = {136022},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136022},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011194},
author = {Gabriel Perez and Scott T. DeNeale and Shih-Chieh Kao and Felipe Quintero},
keywords = {Probable maximum precipitation, Storm transposition, Rainfall maximization, Storm rotation},
abstract = {This study examines the sensitivity of Probable Maximum Precipitation (PMP) estimates to key methodological decisions embedded in the legacy approach adopted in the U.S. National Weather Service Hydrometeorological Reports No. 51 and No. 52. Although widely used for infrastructure design and risk regulation, fundamental aspects of PMP estimation—such as storm sample size, transposition domain, maximization procedures, and storm rotation—remain poorly constrained and lack formal guidance. Using the Red Rock watershed in Iowa as a case study, and leveraging the 2002–2023 NOAA Analysis of Record for Calibration (AORC) precipitation dataset, we systematically evaluate how each methodological choice, individually and in combination, influences PMP estimates. Our findings demonstrate that PMP is not a fixed physical upper bound but rather a modeling construct shaped heavily by user-defined assumptions. Notably, PMP values derived from modern gridded rainfall datasets can be substantially higher than the legacy estimate used in the original spillway design for Red Rock Dam. Decisions regarding storm sample size, domain extent, climatological window, and particularly storm rotation all contributed to higher PMP estimates. Storm rotation alone—a loosely constrained element in the current PMP practice—can amplify PMP by more than 25%. These results reveal the lack of standardized bounds in current PMP workflows and the need for systematic sensitivity and uncertainty analysis. As PMP estimation shifts toward probabilistic approaches, incorporating physically meaningful storm attributes will be key to developing more transparent, defensible methods for dam safety and climate-resilient infrastructure.}
}
@article{QI2026135989,
title = {Monitoring-constrained GPR inversion reveals profile-scale hydrothermal heterogeneity in a retrogressive thaw slump},
journal = {Journal of Hydrology},
volume = {678},
pages = {135989},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135989},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426010863},
author = {Shunshun Qi and Fei Wang and Guoyu Li and Wei Ma and Dun Chen and Fujun Niu and Mingtang Chai and Yougang Yang and Qingsong Du and Kai Gao and Yapeng Cao and Jiawei Yang},
keywords = {Monitoring-constrained inversion, Retrogressive thaw slump, Near-zero temperature zone, Hydrologic connectivity, Ground-penetrating radar, Permafrost degradation},
abstract = {Retrogressive thaw slumps (RTSs) rapidly reshape microtopography and near-surface structure on permafrost hillslopes, altering infiltration pathways, hillslope–channel hydrologic connectivity, and subsurface heat–water exchange. However, point observations remain insufficient to resolve hydrothermal heterogeneity and near-zero temperature-zone processes at the profile scale. Here, using a representative RTS site in the northeastern Qinghai–Tibet Plateau (QTP), we develop a monitoring-constrained ground-penetrating radar (GPR) framework for profile-scale hydrothermal inversion. Stratified monitoring data from an undisturbed reference area are used to establish relationships among relative permittivity, temperature, and volumetric water content, which are then applied to multi-temporal GPR profiles to reconstruct two-dimensional temperature and water-content fields. The temperature inversion retains high accuracy near phase transition, with an RMSE of 0.219 °C. The reconstructed profiles reveal clear seasonal contrasts in the near-zero temperature zone, with areal proportions of 0.482–0.485 in early July and 0.738–0.744 in late October. Among the late-October profiles, the mean depth of the 0 °C isotherm varies little, whereas its lateral roughness ranges from 0.114 to 0.135 m, indicating stronger lateral thermal heterogeneity. At the slump head, shallow mean water content differs little among profiles, but wet-zone occupancy differs by 14.7 percentage points at a water-content threshold of 0.35 and nearly doubles at 0.40. These results show that structural metrics provide more sensitive profile-scale constraints for interpreting subsurface water redistribution and heat-transfer processes under RTS disturbance, thereby providing a useful reference for assessing hydrothermal reorganization in degrading permafrost landscapes.}
}
@article{BAGHERIGAVKOSH2026136050,
title = {Hydrological effectiveness of multiple natural flood management interventions in rapid responses catchments},
journal = {Journal of Hydrology},
volume = {678},
pages = {136050},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136050},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011479},
author = {Mehdi Bagheri-Gavkosh and Alan Puttock and Diego Panici and Richard E. Brazier},
keywords = {Natural flood management, Small catchments, Flash flooding, Peak flow reduction, Lag time, Flood risk management},
abstract = {Small, steep, rapidly responding catchments are vulnerable to flash flooding, as intense, short-duration rainfall events generate rapid rises in high-magnitude flows, posing significant risks to life and infrastructure. This study aimed to quantify the hydrological effectiveness of Natural Flood Management (NFM) interventions in such catchments. A systematic, high-frequency hydrological monitoring network comprising 16 water depth data loggers and four rain gauges was established across five catchments in south-west England, where multiple, spatially distributed NFM measures were implemented. Intervention effects were evaluated using a site-dependent combination of Control–Impact (CI) and Before–After Control–Impact (BACI) approaches, alongside event-based data extraction over monitoring periods of 15–36 months, capturing a total of 662 flood events. Event Peak Flow (EPF) analyses showed statistically significant attenuation across monitoring designs, with CI comparisons indicating median absolute reductions of ∼0.04–0.58 m3 s−1. NFMs also increased flood event lag times, with median extensions of ∼7 to 50% across sites, with strongest effects observed where diverse, densely implemented measures were hydraulically connected to dominant runoff pathways. Seasonal performance varied according to antecedent moisture and hydraulic activation thresholds, with storage-dominated NFM approaches exhibiting consistent attenuation across dry conditions, while leaky barrier-based approaches were primarily threshold-driven and event-controlled. Event-scale Peak Flow Reduction for CI approaches (PFR-CI) ranged from ∼20% to 80% across exceedance probabilities, with only marginal evidence of reduced attenuation for higher-magnitude events (≤5% exceedance probability), highlighting potential hydraulic and storage-related constraints. Collectively, these findings provide robust empirical evidence that well-integrated NFMs can deliver measurable flood-risk benefits in small, rapidly responding catchments, highlighting the importance of catchment-specific design, long-term monitoring and consideration of antecedent conditions to optimise NFM performance.}
}
@article{WANG2026136078,
title = {Drivers, dynamics, and cascading effects of phased drought-flood abrupt alternation on basin water quality},
journal = {Journal of Hydrology},
volume = {678},
pages = {136078},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136078},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011753},
author = {Zhenxiong Wang and Xiaoyan Bai and Jiefeng Wu and Yulei Xie and Zhenxing Zhang},
keywords = {Drought-flood abrupt alternation, Water quality, Dynamics, Cascading effects, Driving factors},
abstract = {With the intensification of global climate change, the frequency and intensity of drought-flood abrupt alternation (DFAA) events have been on the rise. However, current understanding of their cascading effects and dynamic impacts on river water quality remains insufficient. To this end, this study employed the Multiscale Multifactor Standardized DFAA Index (MSDFI) to identify monthly DFAA events from 2006 to 2018 in Southern China’s Lijiang River Basin. The events were categorized into two sub-events—Drought and Flood, and three periods: the Drought Development Period (DDP), the Drought Recovery Period (DRP), and the Flood Period (FP), for analyzing the dynamic changes and cascading effects on water quality (including pH, dissolved oxygen (DO), chemical oxygen demand (CODMn), and ammonia nitrogen (NH3-N)). The results indicated that: (Ⅰ) within DFAA events, pH and DO levels were elevated during droughts compared to normal conditions but decreased during floods, while the trend for CODMn was the opposite (lower during droughts and higher during floods). Besides, NH3-N concentrations exceeded normal levels in both the drought and flood periods. (Ⅱ) pH and DO showed linear variation patterns across different phases of DFAA events. CODMn and NH3-N demonstrated phase-integrated response patterns throughout the drought-to-flood (DTF) process, but their nonlinear characteristics became more pronounced during the flood-to-drought (FTD) processes. (Ⅲ) The alternation intensity of DTF events had a positive regulatory effect on CODMn levels. During FTD events, pH and DO levels were positively correlated with the alternation intensity, whereas NH3-N levels showed a negative correlation (p ≥ 0.05). (Ⅳ) pH and DO are primarily influenced by natural factors, while CODMn and NH3-N are regulated by deeper factors. This research provides valuable scientific insights into the dynamic changes in water quality and their driving forces during DFAA events, which is essential for formulating targeted water quality management strategies and enhancing the resilience of river ecosystems in the context of climate change.}
}
@article{JIANG2026136058,
title = {Quantifying the effect of lateral seepage on the vertical saturated hydraulic conductivity of loess determined by the double-ring infiltration tests},
journal = {Journal of Hydrology},
volume = {678},
pages = {136058},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136058},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011558},
author = {Xiaohu Jiang and Haijun Hu and Zhenghong Liu and Haotian Wang and Shuo Chen and Hui Wang and Yueting Huang},
keywords = {Vertical saturated hydraulic conductivity, Loess, Double-ring infiltration, Test pit immersion test, Numerical tests, Lateral seepage},
abstract = {The double-ring infiltration test is widely used to determine the vertical saturated hydraulic conductivity (Ksv) of soil in situ. While the lateral seepage inside the inner ring has been acknowledged, the effect of the lateral seepage on Ksv and how to control this effect remains to be quantitatively investigated. In-situ double-ring infiltration tests, a test pit immersion test, and numerical simulations were conducted in this research to reliably obtain the Ksv of Q3 loess and quantify the effect of lateral seepage on the Ksv determined by the double-ring infiltration tests. The determination of lateral seepage quantity was developed in numerical tests and the reliability was verified by comparing the proportion of total lateral seepage obtained by an inner diameter 60 cm × outer diameter 150 cm double-ring apparatus in-situ test using the water profile at the end of the test. In conventionally sized double-ring infiltration tests, real-time lateral seepage typically accounts for more than 50% or even 90% of the total flow during the steady infiltration stage, indicating that lateral seepage from the inner ring cannot be completely eliminated and may lead to an overestimation of the determined Ksv. When real-time lateral seepage accounts for less than 55%, the total infiltration rate approximately equals the one-dimensional infiltration rate, i.e., the Ksv determined by the double-ring infiltration test almost equals the true Ksv value. It has been verified that this conclusion is universally applicable across other soil types. This study quantifies lateral seepage, previously considered merely a vague error source, and clarifies its mechanism of influence on the measurement of Ksv and confirms that the equivalent frontal suction, which controls lateral seepage, is a key parameter governing the selection of double-ring dimensions. The findings provide a theoretical basis for optimizing the dimensions of double-ring infiltrometers and improving the accuracy of Ksv determined by double-ring infiltration tests.}
}
