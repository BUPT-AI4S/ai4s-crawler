@article{XU2026136034,
title = {IrriTwin: Integrating reinforcement learning with soil water and crop models toward digital-twin-oriented irrigation scheduling},
journal = {Journal of Hydrology},
volume = {678},
pages = {136034},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136034},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011315},
author = {Menghua Xu and Xiujuan Wang and Mengzhen Kang and Fangle Chang and Jing Hua and Haoyu Wang and Philippe {de Reffye}},
keywords = {Reinforcement learning, Irrigation, Decision-making, Crop model, Digital twin},
abstract = {Improving agricultural water-use efficiency under increasing water scarcity is a central challenge for sustainable agriculture. However, intelligent irrigation control is constrained by the high cost of trial-and-error interaction in real fields, while purely reinforcement-learning-based approaches have limited ability to explicitly represent soil water dynamics and crop physiological processes. To address these limitations, this study proposes IrriTwin, a digital-twin-oriented irrigation scheduling framework that couples the Soft Actor-Critic (SAC) algorithm with a soil water model and the GreenLab crop growth model, thereby establishing a model-in-the-loop virtual soil–crop–water environment for policy learning under water resource constraints. Experimental results show that, under the same total irrigation amount, the SAC-based strategy achieves higher fruit biomass than baseline methods. The learned policy exhibits dynamic adaptability to soil moisture conditions and crop phenological stages, effectively balancing vegetative growth and reproductive demands. Additional comparisons with reinforcement learning baselines further indicate that the proposed dual-action SAC achieves more stable convergence and higher final returns in the representative maize case. Stability analysis further shows that the strategy remains effective under simulated rainfall and irrigation-failure disturbances. Experiments on sunflower and maize demonstrate the effectiveness of IrriTwin. These results indicate that integrating reinforcement learning with mechanistic soil–crop–water models provides a promising foundation for digital-twin-enabled, precise, and water-efficient irrigation management.}
}
@article{WANG2026136086,
title = {Applications of artificial intelligence models in seawater intrusion: progress, challenges, and future directions},
journal = {Journal of Hydrology},
volume = {678},
pages = {136086},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136086},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011832},
author = {Xiangdan Wang and Zhenxue Dai and Hao Wang},
keywords = {Seawater intrusion, Artificial intelligence, Machine learning, Deep learning, Surrogate modeling, Coastal aquifer management},
abstract = {Seawater intrusion (SWI) poses a critical threat to global coastal freshwater security, exacerbated by the synergistic effects of anthropogenic groundwater extraction and climate-driven sea-level rise. While physics-based numerical models have traditionally underpinned aquifer management, their application is increasingly constrained by prohibitive computational costs and high-dimensional parameter uncertainty. This paper provides a critical review of the emerging application of artificial intelligence (AI) models in SWI management. We synthesize recent advancements across four key domains: salinity and water level prediction, real-time monitoring, dynamic vulnerability mapping, and multi-objective management strategies. The analysis demonstrates that deep learning architectures and data-driven surrogate models can effectively capture nonlinear temporal dynamics and accelerate optimization workflows compared with conventional methods. However, the operational maturity of these technologies remains hindered by significant bottlenecks, including heavy reliance on high-quality training data and the “black-box” nature of algorithms that lack physical interpretability and consistency with mass conservation laws. To address these limitations, we propose a strategic roadmap for future research focusing on the development of “grey-box” paradigms, in which hydrogeological knowledge and physical constraints are embedded into AI models. We further advocate integrating multi-source data fusion and adaptive real-time learning systems to bridge the gap between computational efficiency and hydrogeological reliability. This review offers a comprehensive framework for researchers and practitioners to leverage next-generation AI tools for resilient and sustainable coastal aquifer management.}
}
@article{CHEN2026136123,
title = {Intensifying negative asymmetry in gross primary productivity response to precipitation anomalies across the Northern Hemisphere: evidence and drivers},
journal = {Journal of Hydrology},
volume = {678},
pages = {136123},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136123},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012205},
author = {Jiaxuan Chen and Zongsen Wang and Zijun Wang and Yangyang Liu and Tingyi Xue and Zhongming Wen and Haijing Shi and Zhenqian Wang and Ercha Hu and Stephen Sitch and Wenping Yuan},
keywords = {Northern Hemisphere, Climate variability, TRENDY multi-model, CMIP6, Asymmetry index},
abstract = {Asymmetry index of Gross Primary Productivity (GPPAI) is a key metric characterizing the asymmetric response of ecosystem productivity to precipitation anomalies, defined as the difference between Gross Primary Productivity (GPP) increase in wet years and GPP decrease in drought years. Investigating the spatiotemporal patterns of GPPAI and its response to environmental changes deepens our understanding of ecosystem carbon cycle processes. This study integrated multi-source remote sensing data (1982–2018), TRENDY dynamic global vegetation model outputs, and CMIP6 future scenario simulations (2015–2100) to systematically examine the spatiotemporal characteristics and driving mechanisms of asymmetric GPP responses to precipitation anomalies across the Northern Hemisphere. The results indicate: (1) Negative asymmetry (GPP reduction in drought years exceeding GPP increase in wet years) prevailed in 75.71% of the Northern Hemisphere. During 1982–2018, the overall GPPAI declined significantly at a rate of –3.68 × 10−3 year−1 with the most rapid decreases observed in semi-arid regions (slope = –3.59 × 10−3year−1) and grasslands (slope = –3.77 × 10−3year−1) based on multi-source remote sensing data. (2) Multi-factor attribution analysis using dynamic vegetation models revealed that climate change, CO2, and land-use change contributed 58.99%, 34.89%, and 6.11% to GPPAI variations, respectively, with climate change being the dominant driver. Random Forest attribution analysis showed that increased radiation, precipitation, temperature, vapor pressure deficit (VPD), and decreased wind speed all positively contributed to GPPAI changes. Temperature and precipitation were identified as primary drivers, while VPD played a relatively minor role. PCMCI causal analysis indicated that precipitation directly influenced GPPAI in humid and shrubland regions but exerted indirect effects in semi-arid and forest areas. Temperature impacts were region-specific, indirectly regulating GPPAI through other climate factors in forest and shrubland ecosystems. (3) High-emission scenarios (SSP3-7.0 and SSP5-8.5) exhibited higher mean GPPAI values than low-emission scenarios (SSP1-2.6 and SSP2-4.5), primarily reflecting stronger modeled CO2 fertilization effects. However, this does not necessarily indicate enhanced ecosystem resilience, as asymmetry trends continued to decline more rapidly under high-emission pathways.}
}
@article{OJHA2026136046,
title = {A comprehensive assessment and comparison of streamflow simulations performance between the national water model versions 3.0 and 2.1 across the continental United States},
journal = {Journal of Hydrology},
volume = {678},
pages = {136046},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136046},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011431},
author = {Ashish Ojha and Haowen Yue and Kendra Dresback and Long Jiang and Tiantian Yang},
keywords = {National water model, Performance analysis, Streamflow, Continental-scale hydrological model},
abstract = {The National Water Model (NWM) has undergone several updates since its inception. The performance of its latest release, version 3.0, has yet to be comprehensively evaluated. This study presents the first comprehensive CONUS-wide evaluation of NWMv3.0 retrospective streamflow simulations (1979–2020) and compares them against the preceding NWMv2.1. Using observed streamflow from over 4300 United States Geological Survey (USGS) gages, we jointly evaluated both daily flow and annual peak-flow performance across spatial, seasonal, and categorical dimensions. Results showed that NWMv3.0 generally outperformed NWMv2.1 in both daily flow and peak flow statistics. For daily flow, the mean Kling-Gupta Efficiency (KGE) improved from −0.15 to 0.07, while the mean Percent Bias (PBIAS) dropped from 70.98% to 42.19%. For peak flows, mean Average Annual Peak Flow Bias (AAPFB) decreased from 690% to 234%, and mean Average Annual Peak Timing Error (AAPTE) reduced from 0.62 to 0.27 h from v2.1 to v3. Geographically, the Eastern U.S. generally showed better performance than the Central and Western regions, although the latter showed the greatest relative improvements despite overall lower performance. Seasonally, both versions performed best in spring and worst in winter in terms of mean KGE, with the most substantial statistical improvements observed in winter. Additionally, we also found that the natural gages consistently outperformed human-impacted gages for both versions. Despite overall statistical gains in NWMv3.0, spatial variability in performance still highlights the need for region-specific refinements in future NWM development to better capture diverse hydrologic conditions.}
}
@article{GUERRERO2026136062,
title = {Influence of extensive gold mining in the southwestern Amazon on the spatial and temporal dynamics of suspended sediment transport in the Madre de Dios River},
journal = {Journal of Hydrology},
volume = {678},
pages = {136062},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136062},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011595},
author = {Leo Guerrero and Kory M. Konsoer and Lei Wang and Yulissa Estrada and Pedro Rau and Clinton S. Willson},
keywords = {Landsat-Sentinel harmonization, Floodplain connectivity, Mercury transport, Cohesive sediment, Amazon basin},
abstract = {The Madre de Dios (MDD) watershed in the southwestern Amazon has experienced extensive environmental degradation and mercury (Hg) contamination due to rapid gold mining expansion. Previous studies documented increased suspended sediment concentration (SSC) using satellite-derived estimates at river inlets and outlets. However, the spatial and temporal variability of SSC along the MDD River, as well as cross-sectional patterns and grain-size distribution, remain insufficiently quantified. This study integrated harmonized surface reflectance data from Sentinel 2 and Landsat 7 and 8, combined with field campaigns, to investigate spatial and temporal SSC dynamics along the MDD River and their response to flow conditions and mining activity. The analysis focused on two phases: the initial mining expansion (1999–2009) and the subsequent floodplain mining intensification (2010–2024), across two reaches influenced by the Colorado and Inambari tributary confluences. Results revealed pronounced daily-to-weekly SSC fluctuations associated with peak flow conditions and mining activity, particularly in the upper reach, with marked attenuation downstream. Gold mining altered floodplain hydrology by reactivating tie channels and paleochannels, leading to elevated sediment inputs and atypical sediment exchange between the river and oxbow lakes. Furthermore, the vertical distribution of sediment, dominated by cohesive material representing approximately 60–90% of total SSC and remaining relatively uniform throughout the water column, provided key insights into the potential enhanced transport of Hg along the MDD River system, driven by the strong adsorptive capacity of fine sediment. These findings support improved sediment management and sustainable mining practices aimed at preserving geomorphological stability and ecological integrity in tropical environments.}
}
@article{LI2026136054,
title = {Thermal effects on aquifer storage and recovery in brackish aquifers},
journal = {Journal of Hydrology},
volume = {678},
pages = {136054},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136054},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011510},
author = {Hongkai Li and Zhilin Guo and Zidong Pan and Yang Zhan and Sichen Wan and Hua Zhong and Chunhui Lu and Chunmiao Zheng},
keywords = {Aquifer storage and recovery, Groundwater, Variable-density flow, Managed aquifer recharge, Heat transport, Water temperature},
abstract = {Aquifer storage and recovery (ASR) implemented in brackish aquifers is commonly analyzed within a variable-density framework that accounts for salinity contrast between injected and native groundwater. While previous ASR studies commonly assumed isothermal conditions, the thermal characteristics of recharge water vary widely in practice and may alter buoyancy-driven mixing and freshwater recoverability. Using an axisymmetric SEAWAT model, we explicitly simulate coupled heat and solute transport to quantify how injection temperature governs flow dynamics, freshwater-saltwater interface evolution, and recovery efficiency (RE) of injected freshwater across multiple ASR cycles and hydrogeological settings. Results show that cold injection suppresses density-driven convection, producing near-vertical freshwater-saltwater interfaces and yielding RE values of 47–77% over the first five cycles even in high-permeability, strongly brackish aquifers where isothermal systems fail. We introduce a thermally adjusted convection index (TACI) that integrates salinity- and temperature-induced buoyancy effects and provides a unified diagnostic framework for interpreting interface tilting, mixing, and RE. Hydrogeological factors (e.g., vertical confinement and localized permeability deviations) influence thermal dissipation and circulation patterns but are secondary to injection-temperature control. Multi-cycle simulations demonstrate that cooling-assisted ASR (i.e., lowering injection temperature to mitigate buoyancy instabilities) remains effective under mild, short-lived warming but becomes increasingly fragile under stronger or prolonged temperature excursions. These findings highlight the previously underappreciated role of thermal processes in ASR performance and demonstrate that lowering injection temperature offers a simple and effective strategy to enhance ASR performance in brackish aquifers.}
}
@article{TAN2026136070,
title = {Uncertainty propagation in water systems decision-making: A multi-parameter robustness framework},
journal = {Journal of Hydrology},
volume = {678},
pages = {136070},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136070},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011674},
author = {Chao Tan and Xi Yang and Yulei Xie and Fenghua Huang and Min Qin and Zhihe Chen},
keywords = {Water systems, Decision robustness, Reservoir operation, Urban water supply, Multi-parameter perturbation, Coordinated perturbations},
abstract = {Water systems are increasingly affected by hydrological variability, socio-economic change, and evolving management constraints, creating challenges for robust decision-making. Existing multi-criteria decision-making (MCDM) approaches commonly rely on isolated parameter or weight perturbations and therefore provide limited insight into how multiple uncertainties jointly affect the robustness of decision outcomes. This study proposes a multi-parameter robustness framework to evaluate decision stability under interacting uncertainties. The framework combines objective weighting, coordinated perturbation of multiple criteria, and interval-based robustness diagnostics to assess the sensitivity of alternative rankings under large ensembles of disturbed scenarios. It is applied to two contrasting problems, namely reservoir flood-control operation at the Hongjiadu Reservoir and urban water supply planning in Zhengzhou. Results show that reservoir strategies emphasizing hydropower benefits tend to exhibit wider performance intervals and greater ranking volatility, whereas more risk-oriented strategies remain comparatively robust under changing conditions. In the urban water supply case, designs emphasizing a more balanced trade-off among investment, reliability, and long-term performance remain comparatively robust under concurrent disturbances. Across both cases, the results show that ranking robustness depends not only on the decision method itself, but also on the interaction between uncertainty structure and management objectives. The proposed framework provides a practical tool for identifying ranking vulnerabilities under bounded multi-parameter uncertainty and supports robustness-oriented planning for reservoir operation and urban water supply.}
}
@article{ZHANG2026136053,
title = {Decoupling geogenic and anthropogenic drivers of groundwater natural background levels using machine learning and high-resolution maps},
journal = {Journal of Hydrology},
volume = {678},
pages = {136053},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136053},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011509},
author = {Yunhui Zhang and Rongwen Yao and Domenico Cicchella and Ming Luo and Md. {Galal Uddin}},
keywords = {Natural background level, Machine learning, Spatial heterogeneity, Uneven groundwater sampling, Explainable artificial intelligence},
abstract = {Accurate determination of natural background levels (NBLs) of groundwater hydrochemistry is critical for setting water quality standards, yet traditional approaches often fail to capture spatial heterogeneity, particularly in large-scale regions with uneven monitoring networks and human activities. To bridge the gap, this study proposes a novel framework that integrates machine learning models (TabPFN and XGBoost) with spatial grid resampling to model NBLs and their controlling factors (strata, land use/land cover, topographic slope, population, and nitrogen fertilizer use), thereby generating high-resolution NBL maps. A total of 1250 groundwater samples from the northwest Sichuan Basin, China, were used to validate this framework. The results showed that TabPFN outperformed XGBoost in NBL prediction across all parameters, yielding higher R2 (0.933–0.979) and reduced uncertainty by 15%–44%. The high-resolution NBL maps revealed that, although lithology remained the primary control on geogenic indicators (e.g., Ca2+, Mg2+), anthropogenic drivers reshaped the baseline patterns of hydrochemical parameters (e.g., NO3-N, Cl−, and Na+). The dissolution of mirabilite, dolomitic strata (Cretaceous), and calcareous formations (Jurassic) explained the elevated SO42−/Na+ in the groundwater environmental unit (GEU) Ⅰ, Mg2+ in GEU Ⅱ, and Ca2+ in GEUs Ⅲ–Ⅵ, respectively. Slow groundwater runoff increased hydrochemical concentration in GEUs Ⅰ and Ⅲ–Ⅵ. Domestic sewage and nitrogen fertilizer application were identified as the primary sources of elevated Na+/Cl− and NO3-N levels, respectively, which notably affected GEUs Ⅰ and Ⅲ–Ⅴ. The maps characterized the spatial heterogeneity of NBLs, thereby enhancing the understanding of baseline hydrochemistry. Contemporary NBL should be regarded as a present-day baseline modified by modern human activities. These findings provide an effective approach for determining groundwater NBLs across large, unevenly sampled areas.}
}
@article{CHEN2026136089,
title = {Simulation of soil water and nitrogen transport under drip fertigation using a dynamic infiltration boundary in HYDRUS},
journal = {Journal of Hydrology},
volume = {678},
pages = {136089},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136089},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011868},
author = {Rui Chen and Peng Li and Weibin Zhang and Haitao Wang and Hui Wu and Xinjie Xu and Lei Zhang and Jian Wang},
keywords = {Drip fertigation, Surface ponding radius, Variable infiltration boundary, HYDRUS, Model accuracy},
abstract = {Accurate simulation of soil water and nitrogen transport under drip fertigation is crucial for optimizing water and fertilizer management. While the HYDRUS software is widely used for this purpose, the common approach of using a constant infiltration boundary often fails to represent the dynamic expansion of the surface ponding zone. This study developed a novel numerical approach to simulate soil water and nitrogen transport under drip fertigation by integrating a dynamic surface ponding radius model and parameterizing time-varying infiltration boundaries in HYDRUS-2D. The model was validated using a detailed dataset from a soil tank experiment with a silt loam soil. The simulation accuracy for soil water content and ammonium nitrogen (NH4+-N) concentration was systematically evaluated under three infiltration boundary methods: a novel variable infiltration boundary method, a large constant infiltration boundary, and a small constant infiltration boundary with long fertigation duration. Results demonstrated that the variable infiltration boundary method significantly improved the prediction of soil water content, achieving high goodness-of-fit (NSE > 0.85, IA > 0.96, rP > 0.96) and low errors (MRE < 0.17, NRMSE < 0.15, PBIAS < 0.13). The optimal final infiltration boundary length was identified to be 5–10 cm larger than the maximum observed horizontal wetting front during the irrigation. For a constant infiltration boundary, its length should not be less than the soil horizontal wetting front at the end of irrigation and should not exceed this horizontal wetting front by more than 10 cm. Unlike soil water contents, NH4+-N simulations were most accurate with a small constant infiltration boundary, highlighting a model limitation in assuming uniform solute concentration across the infiltration area, which likely does not reflect real-world solute accumulation beneath the emitter. This study concludes that a dynamically parameterized infiltration boundary enhances water flow simulation in soil under drip fertigation, but further refinement is needed for solute transport to account for spatial concentration gradients in the ponding zone.}
}
@article{MU2026136013,
title = {A probabilistic prediction model based on uncertainty quantification and interpretable deep learning: Application to runoff prediction in the Yellow River mainstream},
journal = {Journal of Hydrology},
volume = {678},
pages = {136013},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136013},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011108},
author = {Liang Mu and Junxi Chen and Zhiguo Yu and Hong Zhao and Zhibo Yang},
keywords = {Yellow River, Runoff prediction, Uncertainty quantification, Interpretable deep learning},
abstract = {Accurate and reliable runoff prediction is essential to water resources planning and management. Runoff in the Yellow River mainstream is influenced by both climate change and human activity, leading to pronounced nonlinearity, non-stationarity, and predictive uncertainty. Conventional deterministic forecasting models generally provide only point estimates and therefore cannot fully reflect runoff uncertainty. To address this limitation, we develop a probabilistic runoff prediction method that integrates uncertainty quantification with interpretable deep learning for both point and probabilistic runoff forecasting. First, a directed adjacency matrix is created by combining spatial features such as the topological structure of the Yellow River mainstream and tributaries, spatial distances between hydrological stations, and station elevation. This matrix enables the spatio-temporal graph convolutional network (STGCN) to capture runoff-related spatial dependencies. Second, we use predictive variance and the Gaussian negative log-likelihood function to quantify data uncertainty, and MC Dropout to quantify model uncertainty. The two uncertainty components are incorporated into the training objective to guide uncertainty model learning. The sampled predictive outputs are further transformed into runoff probability distributions using Gaussian kernel density estimation, yielding both deterministic point forecasts and probabilistic prediction function. Finally, SHAP is introduced to interpret the influence mechanism of multiple input features on runoff prediction. A case is conducted using daily observations from hydrological stations along the Yellow River mainstream. Compared with benchmark models, the proposed model improves RMSE, MAE, and MAPE for point prediction by at least 11.46%, 13.21%, and 15.45%, respectively, and improves CRPS and PICP for probabilistic prediction by at least 10.42% and 7.32% respectively. The results demonstrate that this study can provide reliable runoff prediction information for water resources planning in the Yellow River Basin.}
}
@article{HE2026136065,
title = {Sustainable water management in an upstream watershed under transboundary eco-compensation policy: a bi-level robust optimization model},
journal = {Journal of Hydrology},
volume = {678},
pages = {136065},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136065},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011625},
author = {Linhuan He and Yee Van Fan and Yuhong Shuai and Liming Yao and Petar Sabev Varbanov and Ting Pan},
keywords = {Sustainable water management, Transboundary watershed, Eco-compensation policy, Bi-level robust optimization},
abstract = {Transboundary water pollution poses persistent challenges for river basin sustainability due to spatial externalities and mismatched environmental responsibilities between upstream and downstream regions. This study develops an allocation and trading framework for wastewater emission permits (WEPs) in the upstream watershed by integrating a cross-provincial watershed eco-compensation scheme (CpWES). A bi-level robust optimization model with uncertain parameters is established, in which the Bureau of Ecology and Environment as the upper-level seeks to maximize eco-economic benefits under uncertainty, while lower-level governments allocate WEPs across sectors to optimize local environmental-economic benefits. The model is applied to the Xin’an River Basin, and the results show that: (1) The eco-compensation policy exhibits an inverted U-shaped impact on the upstream economic benefits, suggesting the need for moderately calibrated compensation levels; (2) Huizhou County exhibits the highest emission reduction potential, with an annual load reduction of up to 394 tons; and (3) Under hydrological uncertainty, urban and industrial sectors achieve 4.5%-11.7% and 10%-16% annual reductions in pollutant loads, respectively, contributing to improved compliance with basin water quality targets. Overall, breaking administrative barriers and establishing basin-wide emission trading mechanisms can markedly enhance the sustainable development in upstream regions of transboundary river basins, providing practical support for upstream water pollution management under cross-provincial eco-compensation policies.}
}
@article{FENG2026136076,
title = {A framework for analyzing spatial hydrological drought dependence based on extreme value theory and nonstationary copulas},
journal = {Journal of Hydrology},
volume = {678},
pages = {136076},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136076},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601173X},
author = {Yuqing Feng and Zhiyong Wu and Hai He and Zhenchen Liu and Yue Zhuo and Yangqian Li and Sergio M. Vicente–Serrano},
keywords = {Hydrological drought, Concurrent drought risk, Nonstationary copula, Extreme value theory, Spatial dependence structure, Joint probability distribution},
abstract = {Hydrological droughts are characterized by pronounced persistence and strong spatial dependence. Through river network connectivity, drought signals propagate across basins and frequently manifest as concurrent events in multiple regions. Their spatial dependence structures exhibit substantial regional heterogeneity and temporal evolution, posing methodological challenges for reliable risk assessment. This study proposes an integrated analytical framework that combines event-scale extreme value theory with nonstationary copulas to investigate hydrological drought dependence and concurrence risk. The framework characterizes the copula-based joint probability structure of upstream–downstream drought durations at the river network scale and explicitly accounts for its temporal nonstationarity. Hydrological drought events are first identified and matched at the event scale, and extreme samples are extracted using a Peaks Over Threshold approach. Time-varying parameters are then introduced to model both marginal extreme distributions and copula dependence parameters, enabling explicit representation of the temporal evolution of inter-site drought dependence structures. The framework is applied to the Yangtze River basin to systematically examine the spatiotemporal variation of hydrological drought dependence and concurrent drought probability under different upstream–downstream configurations. Results indicate that both the joint distribution structure and concurrent drought risk at the river network scale exhibit pronounced spatial heterogeneity and temporal nonstationarity, with no uniform evolutionary pattern across river reaches. Compared with stationary models, the proposed nonstationary framework more accurately captures changes in dependence structures and reveals temporal redistribution in the joint probability structure during upstream-to-downstream drought propagation. Overall, the proposed approach provides a statistically consistent and physically interpretable basis for assessing concurrent hydrological drought risk in large river networks under nonstationary conditions.}
}
@article{DUAN2026136073,
title = {Eutrophication reshapes lake-size scaling and amplifies the dominance of large lakes in regional CO2 and CH4 emissions across eastern China},
journal = {Journal of Hydrology},
volume = {678},
pages = {136073},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136073},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011704},
author = {Hongtao Duan and Qitao Xiao and Tianci Qi and Juhua Luo},
keywords = {Carbon emissions, Satellite remote sensing, Greenhouse gases, Inland waters},
abstract = {Accurate estimation of carbon dioxide (CO2) and methane (CH4) emissions from lakes is essential for refining the global carbon budget and understanding climatic feedback from inland waters. Previous lake carbon-flux estimates have often relied on field datasets dominated by small lakes, which exhibit high areal emission rates but may underestimate the contribution of large lakes. Satellite remote sensing offers an opportunity for spatially continuous monitoring of large and heterogeneous lake systems, yet robust methods for concurrently estimating CO2 and CH4 fluxes remain limited. Here, we developed polynomial regression models using Sentinel-3 satellite data to quantify dissolved CO2 and CH4 concentrations and their diffusive fluxes across 113 meso- to eutrophic lakes larger than 10 km2 in eastern China (R2: 0.50–0.78). By synthesizing multi-year midday observations under cloud-free conditions, we found that eutrophication reshaped conventional lake-size scaling of carbon emissions. Within the studied size range, smaller, highly productive lakes frequently acted as CO2 sinks, whereas larger lakes remained important CO2 sources. Nonetheless, the studied lakes acted regionally as net carbon sources because CH4 emissions offset the CO2 uptake in CO2-equivalent units. Large lakes (>100 km2), representing only 23% of lake number but 85% of total surface area, contributed 92% of regional CO2-equivalent diffusive efflux. These results suggest that eutrophication can fundamentally alter conventional lake-size scaling and should be explicitly considered in regional carbon upscaling. This study demonstrates the potential of satellite-based approaches for improving spatially explicit assessments of global carbon budgets, while emphasizing the need for broader validation and improved temporal representativeness.}
}
@article{ZHOU2026136122,
title = {Effect of landslide location on glacial lake outburst flood at Badongcuo, Tibetan Himalaya},
journal = {Journal of Hydrology},
volume = {678},
pages = {136122},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136122},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012199},
author = {Yangli Zhou and Shuai Zhang and Cong Dai and Chenxu Su and Yunhong Lv and Martin Mergili and Ashim Sattar and Limin Zhang},
keywords = {GLOF, Piping-overtopping combined effect, Landslide location, Hazard assessment},
abstract = {The current highest glacial lake outburst floods (GLOFs) risk level is centered in the eastern Himalaya. Climate change-driven glaciers retreating and glacial lakes expanding will continue enhancing such GLOFs, which represent a serious threat to downstream inhabitants and ecological environment. This study evaluates such hazards of Lake Badongcuo located in the southeastern Tibetan Plateau. Drawing upon field investigations, 3D unmanned aerial vehicle (UAV) modeling, and satellite images, we model a series of scenarios. These scenarios assume three hazard levels (high, moderate and low) and two potential landslides plunging into the lake, generating impulse waves, triggering dam-breach erosion, then resulting outburst floods that propagate downstream along the flow channel. Field evidence of seepage in the terminal moraine dam prompted us to consider the combined effects of piping and overtopping in breach formation. A multi-phase depth-averaged model was employed to simulate the entire GLOF process chain. Particular attention is given to the hydraulics of flood propagation at six downstream locations, including the planned Luolong Station of the Sichuan-Tibet Railway. For the high- and moderate-magnitude GLOF events, the maximum modeled breach outflow peak reaches 87,345 m3 s−1, the inundation can affect downstream up to 16 km from the lake, and the earliest flood arrival time is about 44 min at the Luolong Station. The low-magnitude GLOFs, though the more frequent type, have limited volume and peak discharge, causing less impact downstream. Further discussion reveals that the dynamics of impulse waves by landslides are pivotal to the GLOF process. The landslide entry position, water depth, and lakebed morphology are important factors governing GLOF intensity. Therefore, the proposed comprehensive methodology offers valuable support for local governments and hazard-management authorities in GLOF-prone regions to develop hazard magnitude-based mitigation measures and emergency response plans, thereby substantially reducing potential loss of life and infrastructure damage. Moreover, our findings can assist GLOF researchers to increase their understanding of key challenges they are facing regarding GLOF mechanisms.}
}
@article{GUPTA2026136061,
title = {Impact of reservoir storage on propagation from meteorological to hydrological drought},
journal = {Journal of Hydrology},
volume = {678},
pages = {136061},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136061},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011583},
author = {Ajay Gupta and Manoj Kumar Jain and Rajendra Prasad Pandey and David M. Hannah},
keywords = {Drought Propagation, Meteorological-to-Hydrological Drought, Reservoir Storage, Downstreamness Concept, Upstream-Downstream Reservoir},
abstract = {Reservoirs are central to moderating and mitigating drought, yet their influence on drought propagation through socio–hydrological systems remains under–examined. This study quantifies how reservoir storage shapes the progression of meteorological, agricultural, reservoir, and streamflow droughts across 11 major reservoirs in the semi–arid Krishna River Basin, India (2000–2019). Using the SPEI, SSMI, SRSI, and SSI indices, we estimate initiation, peak, and termination lags at multiple timescales and thresholds. Reservoir influence is further assessed using the Downstreamness concept to capture upstream–downstream hydrological connectivity. Results show that drought propagation varies markedly across indices due to contrasting system response times. Meteorological–to–agricultural drought propagates rapidly at short timescales, whereas agricultural–to–reservoir and reservoir–to–streamflow droughts exhibit longer delays linked to reservoir buffering. Termination is most variable for agricultural–to–reservoir drought and shortest for reservoir–to–streamflow drought, reflecting rapid downstream recovery once reservoirs refill. Upstream–downstream analysis reveals that mild and moderate upstream reservoir droughts rarely propagate, but severe upstream droughts consistently transmit downstream, with longer duration, greater severity, and delayed onset. Downstreamness dynamics further show shifting patterns of water retention over the drought cycle, underscoring the importance of hydrological connectivity in shaping drought outcomes. These findings provide actionable insights for basin–scale water management, highlighting the need to incorporate reservoir connectivity and drought–severity thresholds into drought mitigation strategies. The approach offers transferable value for other semi–arid basins facing similar multi–stage drought propagation challenges.}
}
@article{WANG2026136037,
title = {Development and optimization of a multifunctional sensor for measuring soil thermal properties, water retention characteristics and electrical conductivity},
journal = {Journal of Hydrology},
volume = {678},
pages = {136037},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136037},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011340},
author = {Xiangwei Wang and Jiagui Hou and Yaohui Cai and Chaoyue Zhao and Junru Chen and Zuyao Chen and Francis Zvomuya and Miles Dyck and Hailong He},
keywords = {Thermo-TDR, Thermal/heat dissipation, Matric potential, Heterogeneity, Spatial sensitivity, Finite element simulation},
abstract = {Soil water content, matric potential, thermal properties, and electrical conductivity are fundamental and interrelated properties required by a variety of applications in soil science, hydrology, agriculture, and engineering. However, the measurements of the properties are affected by the temporal and spatial variability of soil due to employment of a variety of sensors, which hinders the research and modeling of coupled water, heat and solute transport. In addition, the laborious, costly and time-consuming sensor optimization is always a challenge for traditional sensor development. The objective of this study was to develop a multifunctional sensor integrating heat pulse, time domain reflectometry and porous ceramic matrix and optimize the sensor with COMSOL based numerical simulations. COMSOL simulated ceramic properties (e.g., thermal conductivity, volumetric heat capacity, dielectric permittivity, electrical conductivity) and soil properties (e.g., thermal conductivity and volumetric heat capacity) with different scenarios of sensor dimensions (e.g., the radius and length of the ceramic and extended rod length) were systematically evaluated and verified with experimental data. Our results show that the optimal radius and length of the ceramic are 18 mm and 40 mm, respectively, and the optimal rod length extended out of the ceramic is 50 mm. The optimized results indicate low estimation errors for dielectric permittivity (±1%), electrical conductivity (±1%), thermal conductivity (±2%), and volumetric heat capacity (±1%) of the ceramic as well as thermal conductivity (±3%) and volumetric heat capacity (±1%) of soil. The new multifunctional sensor can provide accurate measurement and modeling of soil hydrothermal properties.}
}
@article{FU2026136118,
title = {Physics-constrained neural network modeling of soil thermal conductivity curve across full saturation},
journal = {Journal of Hydrology},
volume = {678},
pages = {136118},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136118},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426012151},
author = {Yongwei Fu and Lingzao Zeng and Hu Zhou and Joshua Heitman and Tusheng Ren and Robert Horton},
keywords = {Soil thermal conductivity, Physics-constrained neural network, Degree of saturation, Physical constraints, Modeling},
abstract = {Accurate modeling of the soil thermal conductivity (λ) versus degree of saturation (Sr) curve is essential for simulating coupled heat and water transfer in soils. Unlike point-wise estimates at selected water contents or at the saturated endpoint, a continuous λ(Sr) curve over the full saturation range is needed to represent soil heat-transfer behavior from dry to saturated conditions. Traditional theoretical models and standard data-driven approaches often struggle with generalization, overfit measurement noise, or yield physically implausible estimates when extrapolated beyond their training data. To address these limitations, this study introduces a Physics-Constrained Neural Network (PCNN) to learn a continuous, soil-specific λ(Sr) curve over 0 ≤ Sr ≤ 1 while applying established physical constraints. These embedded penalty terms promote monotonicity, nonlinear but smooth curve shapes, and physically realistic value ranges. The proposed PCNN is benchmarked against a purely data-driven Multi-Layer Perceptron (MLP) using a comprehensive dataset of 1846 measurements across 211 distinct soil samples. The MLP achieves lower error on the training dataset and a slightly lower testing RMSE, whereas the PCNN provides comparable testing accuracy while producing smoother and more physically consistent derivatives behavior. The PCNN maintains a robust testing-to-training RMSE ratio of 1.16 compared to the MLP’s ratio of 1.60, indicating stronger regularization rather than a large improvement in point-wise testing accuracy. Derivative-based analysis further shows that the MLP produces erratic, oscillatory curves and occasional physically impossible negative gradients, whereas the PCNN avoid negative derivatives in the diagnostic grid. These findings show that embedding physical constraints produces a continuous full-range λ(Sr) function with more physically regular behavior than point-wise error minimization alone. By providing λ continuously as Sr varies, the learned curve is intended as a constitutive input for simulations that traverse changing soil–water states. Future work should evaluate direct coupling of the learned relationship within larger-scale numerical heat-transfer simulations.}
}
@article{YANG2026135939,
title = {Nonlinear response of soil erosion to rainfall erosivity: effects of vegetation cover and rainfall intensity},
journal = {Journal of Hydrology},
volume = {678},
pages = {135939},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135939},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601036X},
author = {Xue Yang and Huanxu Lv and Enwei Zhang and Yawen Li and Xingwu Duan},
keywords = {Soil erosion, Rainfall erosivity, Vegetation cover, Plot experiments, Root zone},
abstract = {Does rainfall erosivity (R) always translate into soil erosion in a linear manner? Widely used soil erosion models assume a linear relationship between rainfall erosivity and soil erosion modulus (A) (R–A), yet increasing evidence from extreme rainfall events suggests that this assumption may not hold under different vegetation conditions. Here, we hypothesize that land use and vegetation regulate the R–A relationship, and we test this hypothesis using field monitoring, model evaluation, and controlled rainfall simulation experiments conducted. Results showed that the R–A relationship was approximately linear on bare land, but strongly non-linear on cropland, forest, and orchard plots, with inflection points beyond which erosion increased sharply. Controlled rainfall experiments further demonstrated that under a fixed vegetation cover of 60%, soil loss increased from 1.70 t·km⁻2 at 30 mm·h⁻1 to 3.22 t·km⁻2 at 50 mm·h⁻1 and 6.37 t·km⁻2 at 80 mm·h⁻1, while at a fixed rainfall intensity of 50 mm·h⁻1, increasing vegetation cover from 0% to 40% reduced erosion by 78.5%. Root-zone experiments further indicated that root-only treatments reduced erosion by 11%–94% relative to bare soil, with relatively small differences compared with intact plants at the maturity stage and under the highest rainfall intensity. These results indicate that vegetation, including both aboveground parts and root systems, fundamentally alters the R–A relationship, producing nonlinear erosion responses that are effective under moderate rainfall but progressively weaken under extreme rainfall conditions. This provides a scientific basis for improving soil erosion models under global change.}
}
@article{GAO2026136033,
title = {Evaluating the impact of climate change on water supply system reliability – a robust assessment framework using stochastic data},
journal = {Journal of Hydrology},
volume = {678},
pages = {136033},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136033},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011303},
author = {Zitian Gao and David E. Robertson and Tze Ling Ng and Patrick Russell and Francis H.S. Chiew and John Frdelja},
keywords = {Climate change, Sensitivity analysis, Water supply system, System augmentation, Rainfall-runoff modelling, Global Climate Model},
abstract = {This study presents a stochastic data-based framework that enables dynamic and uncertainty-aware evaluation of water supply system performance under climate change and climate variability, and supports the determination of optimal timing for system augmentation. Stochastic climate data were generated for 12 sensitivity scenarios with varying projected trends in rainfall, temperature and evaporation. The sensitivity analysis enables evaluation of system performance across a wide range of climate conditions, supporting robust decision-making to ensure system reliability under diverse future pathways. Stochastic runoff was generated from stochastic climate data, and both were used in a case-study water supply system model. Results showed that the water supply system became less reliable under two different climate pathways: 1) a large increase in evaporation and temperature (8 % and 2 °C) coupled with a moderate decrease in rainfall (5 %), and 2) a substantial decrease in rainfall (10 % or 15 %). Under these pathways, system restrictions and shortfalls increased rapidly over time, and the system became more expensive to operate due to increased reliance on groundwater and the need to draw water from a reservoir that may have quality issues. Under an extremely hot and dry climate scenario, the proposed augmentation, framed as a 20 % reduction in annual demand, helped to alleviate system restrictions, and early augmentation was more effective than late augmentation. The modelling and assessment approach presented here is transferable to different water supply systems, providing a valuable tool for understanding current and future system performance and evaluating probabilistic risk-reward trade-offs of system augmentation.}
}
@article{KARIMI2026136085,
title = {Improving reference evapotranspiration estimation by attention-enhanced autoencoders and hybrid neural networks under noisy chaotic conditions},
journal = {Journal of Hydrology},
volume = {678},
pages = {136085},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136085},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011820},
author = {Sepideh Karimi and Mostafa Sadeghzadeh and Jalal Shiri and Pau Martí},
keywords = {Climate-adaptive, Noise-resilient evapotranspiration, Attention mechanism, Lyapunov stability, Recurrence quantification, Hybriddenoising architectures},
abstract = {The present study established a climate-adaptive Multi-Layer Perceptron-Self Attention (MLP-SA) framework for robust estimation of reference evapotranspiration (ETo) under noise-distorted conditions under different climatic conditions. The proposed model redefined noise-resilient ETo estimation through a climate-physics-informed two-stage architecture design: i) a denoising autoencoder (DAE) that first purifies noisy input data (meteorological variables, e.g. air temperature) by convolutional encoding–decoding, and ii) an MLP enhanced with a climate-adaptive self-attention mechanism, which dynamically recalibrated feature importance based on climate-specific physics. The proposed methodology was evaluated by using data from humid (north) and arid (south) regions. Despite statistical-based evaluation, the process-based hydrological analysis, as well as time persistence and hydrologically-significant error assessments, revealed the superiority of the proposed model under both climatic conditions. In the humid region, the model demonstrated a promising goodness-of-fit (R2 = 0.951; RMSE = 0.064 mm/day and MAE = 0.047 mm/day at 20% noise) by highlighting its dominance in suppressing high-frequency artifacts, outperforming hybrid models by more than 17% of R2. In the arid region, it provided optimal Lyapunov stability (λ = 0.531 at 40% noise, capturing 90.5% of observed chaotic dynamics), despite nonlinear degradation (ΔR2 = 0.108 from 0% to 40% noise). Climate-based assessment revealed that the humidity reduced feature interaction nonlinearity withlower SHAP distortion in the humid (|ΔSHAP|=0.151) compared to the arid (|ΔSHAP|=0.450) region. Furthermore, the attention mechanisms dynamically prioritized radiation-dominated hierarchies in the humid region (weight: 0.639), while multi-factorial weight assignment was detected in the arid region (Rs: 0.291, Ws: 0.290, RH: 0.263). The pure-attention architectures failed catastrophically (λ deficits exceeding 25%) due to inadequate chaos management. Further chaos-based assessment via the correlation dimension, phase reconstruction, and recurrence quantification analyses confirmed the promising ability of the proposed model in estimating ETo under different climatic conditions and noise levels.}
}
@article{PREVIATI2026136028,
title = {Probabilistic prediction of thermal plumes from groundwater heat pump wells using ANN surrogate modeling},
journal = {Journal of Hydrology},
volume = {678},
pages = {136028},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136028},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601125X},
author = {Alberto Previati and Valerio Silvestri and Paolo Frattini and Giovanni Crosta},
keywords = {Groundwater heat pump (GWHP), Thermal interference, Shallow geothermal energy, Surrogate modeling, Probabilistic risk assessment, Urban groundwater management},
abstract = {Groundwater heat pumps (GWHPs) represent an efficient solution for urban heating and cooling, but their widespread adoption raises concerns about thermal interference and long-term sustainability in densely exploited aquifers. This study presents a novel data-driven framework for predicting GWHP thermal plumes to support risk-based groundwater thermal resource management. A fully connected neural network (FCNN) surrogate model was developed and trained on 4,500 3D finite-element heat transport simulations, spanning a wide range of hydrogeological conditions and GWHP operational scenarios, including variable injection rates and combined heating/cooling operations. The surrogate reproduces numerical results with high accuracy, achieving a mean absolute percentage error of 5% in predicting the extent of the ±1°C thermal perturbation isotherm after 20 years of operation. The robustness and generalization capability of the model were assessed through a bootstrapping testing procedure with scenario-based data splitting. The model is embedded in a Monte Carlo framework to explicitly account for uncertainty in hydrogeological parameters and system operation, enabling probabilistic mapping of thermal perturbation. The methodology is applied at the city scale in Milan (Italy), producing probability maps of thermal interference for existing GWHP installations. Furthermore, the approach is extended to resource planning by estimating the maximum extractable groundwater volume for new installations while limiting temperature perturbations at existing wells to ±1°C. The proposed framework bridges the gap between analytical screening tools and computationally intensive numerical models, providing a scalable and robust decision-support tool for sustainable shallow geothermal energy management in urban aquifers.}
}
@article{DAU2026136049,
title = {Hindcasting compound coastal-inland flood events caused by post-tropical storms},
journal = {Journal of Hydrology},
volume = {678},
pages = {136049},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136049},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011467},
author = {Quan Van Dau and Rana Ali Nawaz and Xiuquan Wang},
keywords = {HEC-RAS, HRDEM breaching, Dorian, Fiona, High water mark, Hindcasting},
abstract = {This study presents a hindcasting framework for reconstructing compound coastal-inland flooding in Prince Edward Island (PEI) during post-tropical storms Fiona (2022) and Dorian (2019). Using observed rainfall and high-water marks (HWMs), with a high-resolution terrain model enhanced with hydro-infrastructure, we simulated flood extents at municipal and island-wide scales using HEC-RAS 2D. The hindcasting results show spatially varying impacts across the island, with Fiona producing greater inundation in eastern PEI and Dorian in the northwest. Fiona’s flood extent exceeded Dorian’s by up to 7.32% in parts of Kings County, while Dorian produced more than twice the inundation of Fiona in portions of Prince County (9.94%). This study advances previous PEI flood modeling efforts by explicitly integrating observed coastal HWMs with inland hydrological forcing within a unified 2D hydrodynamic framework, enabling more accurate reconstruction of compound flooding processes. The HRDEM breaching approach further improved hydraulic connectivity by identifying 2,895 hydraulic structures, more than twice the number contained in the official inventory, thereby enhancing island-scale flood routing. This hindcasting framework demonstrates the value of integrated coastal and inland data for accurately reproducing real flood events and supports future climate adaptation planning in storm-prone regions.}
}
@article{SUN2026136081,
title = {Decadal basin-wide nitrogen recovery and localized estuarine deterioration in the Bohai Sea revealed by physics-guided spatially adaptive machine learning},
journal = {Journal of Hydrology},
volume = {678},
pages = {136081},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136081},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011789},
author = {Ruiteng Sun and Yuan Li and Longwen Fu and Kun Wang and Jing Yu and Fengshuo Yang and Yanfang Li and Xiaoguang Li and Shichao Tian and Youcai Liu and Dejuan Jiang and Yongming Luo},
keywords = {Dissolved inorganic nitrogen, Machine learning, Geographically weighted regression, Semi-enclosed sea, Bohai Sea},
abstract = {Excessive dissolved inorganic nitrogen (DIN) drives coastal eutrophication in semi-enclosed seas, yet retrieving this non-optically active nutrient in optically complex waters remains difficult, limiting decadal assessments of management progress. Here we reconstruct surface DIN across the Bohai Sea from 2013 to 2023 using a physics-guided, spatially adaptive machine-learning framework (GW-PGML-XGBoost) trained on 4,409 in-situ match-ups. The reconstruction reveals a decadal divergence: most of the basin recovered, while localized estuarine zones deteriorated. On the independent test set, the framework reproduced observations with R2 = 0.73 and RMSE = 0.094 mg L−1. Ablation attributed this skill to the coupled spatial and physical constraints, which raised R2 from 0.58 for standalone XGBoost. Prediction uncertainty, dominated by observational noise rather than model structure, was propagated into the trends, confirming that the divergence is robust to retrieval error. Sea surface salinity, sea surface height, and water depth were the dominant predictors, reflecting physical mixing and terrestrial loading. The climatology shows a persistent nearshore-high to offshore-low gradient and a seasonal cycle of summer minima and autumn–winter maxima. DIN declined significantly across the basin, tracking reductions in sewage, atmospheric, and agricultural nitrogen inputs. In Bohai Bay, the decline reached (−2.11 ± 1.17) × 10−3 mg L−1 yr−1 (p < 0.01), the steepest in the study area. Laizhou Bay, the most DIN-rich subregion, held steady at a high baseline (p = 0.39). In contrast, the localized estuarine increases coincided with intensified riverine inputs. Nutrient management in semi-enclosed seas should therefore shift from uniform annual-load reduction toward spatially precise, high-flow-season strategies.}
}
@article{NIU2026136057,
title = {Cascade structure and event-level attribution of three-dimensional compound drought–heat events in China: contrasting meteorological and agricultural systems},
journal = {Journal of Hydrology},
volume = {678},
pages = {136057},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136057},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011546},
author = {Ben Niu and Yi Li and Shasha Han and Jinxuan Zhao and Darrell W.S. Tang and David M. Hannah},
keywords = {Compound drought–heat event, Three-dimensional framework, Copula model, Multi-level event-cascade analysis, Explainable machine-learning model},
abstract = {Compound drought–heat events are among the most damaging climate extremes because concurrent water deficits and heat stress amplify impacts on ecosystems and agriculture. Here, we investigated compound drought–heat events across China during 1961–2023 using monthly 0.25° × 0.25° gridded CN05.1 and GLDAS datasets. Non-stationary drought and heat indices were first developed using GAMLSS to represent time-varying marginal distributions, and Copula models were then used to derive meteorological and agricultural compound drought–heat indices. A spatial-overlap-constrained three-dimensional event-identification framework was applied to characterize event evolution, cascade structure, and key spatiotemporal features, and explainable machine-learning models were used to diagnose dominant event-level predictors. Results showed that compound drought–heat events were more concentrated in the upper tails of area–severity distributions than single drought or heat events, especially in the meteorological system. Since the 1990 s, both systems intensified, but meteorological events showed higher intensity, peak, and migration, whereas agricultural events persisted longer once established. Multi-level event-cascade (Grade-cascade) analysis further revealed that many apparently mild long-duration events contained embedded higher-grade subevents; agricultural systems also exhibited a substantially greater proportion of many-to-many cascades, indicating stronger internal fragmentation and heterogeneity. Model-based attribution showed that meteorological compound events were mainly associated with atmospheric moisture-demand and thermal predictors, whereas agricultural compound events were linked to both climatic forcing and land-surface energy–water predictors. These findings show that compound drought–heat events should be treated as evolving three-dimensional systems rather than simple temporal overlaps.}
}
@article{LI2026136017,
title = {Physics-informed operator learning for rapid hydrograph-to-field prediction on an unstructured-mesh flood benchmark},
journal = {Journal of Hydrology},
volume = {678},
pages = {136017},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136017},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011145},
author = {Yichen Li and Qiang Ye and Shanliang Zhang and Tiechui Liu and Lingzao Zeng},
keywords = {Physics-informedDeepONet, Flood surrogate modeling, Two-dimensional shallow water equations, Operator learning, Unstructured mesh},
abstract = {Rapid two-dimensional flood surrogate modeling requires fast full-field evaluation when many forcing scenarios must be screened, yet high-resolution shallow-water solvers remain computationally expensive in many-query settings. Here we develop a physics-informed Deep Operator Network (PI-DeepONet) for fixed-domain hydrograph-to-field prediction on a high-resolution unstructured-mesh flood benchmark. The model learns a mapping from upstream inflow hydrographs to spatiotemporal water-depth and velocity fields while incorporating reduced shallow-water-equation residuals as soft regularization terms during training. The benchmark reference fields are generated using HEC-RAS v6.6 simulations over a 9.27 km2 sub-basin of the Qingshui River Basin, China, discretized with 91,959 unstructured cells. Relative to an architecture-matched data-driven DeepONet baseline, PI-DeepONet reduces localized errors near wet–dry fronts, mitigates non-physical leakage, and shows improved transient routing behavior under the evaluated steady and unsteady benchmark conditions. Under the withheld extreme event, the model also shows improved RVF behavior and lower event-scale volume error relative to the baseline. After offline training, GPU-accelerated inference requires only seconds, corresponding to approximately three orders of magnitude faster online evaluation than CPU-based HEC-RAS in the present setup. Tests on identical CPU hardware also indicate an algorithmic speed-up of more than two orders of magnitude. These results support physics-regularized operator learning as a viable benchmark-specific surrogate strategy for rapid multi-scenario screening under fixed-domain flood-model settings.}
}
@article{FENG2026136069,
title = {Multi-objective optimization of water–sediment-ecology coordinated operation for cascade reservoirs in the Yellow River Basin},
journal = {Journal of Hydrology},
volume = {678},
pages = {136069},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136069},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426011662},
author = {Zhong-kai Feng and Liang Shen and Tie-sheng Guan and Ai-hua Long and Qin Xu and Xing Chen and Wen-jing Niu},
keywords = {Water-sediment-ecology nexus, Cascade reservoir operation, Silt-laden rivers, Multi-objective optimization, Copula functions},
abstract = {Effective management of the water–sediment-ecology nexus in silt-laden rivers is a critical challenge for global hydrological sustainability. This study investigates the multi-objective coordinated operation of the Sanmenxia (SMX) and Xiaolangdi (XLD) cascade reservoirs in the Yellow River Basin, a system characterized by severe sedimentation and competing water demands. To address the complex, non-linear trade-offs between hydropower generation, sediment flushing, and downstream ecological protection, we implement an adaptive multi-objective JAYA algorithm (MOJAYA). The MOJAYA framework incorporates a two-population progressive optimization strategy and multidimensional adaptive search techniques to navigate the high-dimensional search space and stringent physical constraints inherent in multireservoir systems. Furthermore, a multivariate dependence analysis using Gaussian Copula functions is employed to quantify the inherent conflict intensity between the three objectives. Our results indicate a pervasive negative correlation across the operational landscape (r=-0.90), statistically validating the “high-water-head versus low-water-level” trade-off required for simultaneous hydropower and sediment management. Simulation results across representative wet, normal, and dry hydrological years demonstrate that the optimized schemes significantly outperform actual operations. Specifically, in wet years, power generation increases by 5% while the ecological water shortage rate is reduced from 2.01% to 0.84%. In dry years, the joint scheduling effectively mitigates the severe disruptions to ecological flow while maintaining energy reliability. This research provides a robust decision-support framework for balancing economic development and ecological integrity in complex, sediment-heavy river basins.}
}
