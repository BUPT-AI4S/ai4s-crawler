@article{KONG2026135721,
title = {Divergent trends in global vegetation sensitivity to soil moisture and atmospheric dryness},
journal = {Journal of Hydrology},
volume = {676},
pages = {135721},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135721},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008188},
author = {Mengxiang Kong and Yu Feng and Ziqi Lin and Chunmiao Zheng},
keywords = {Vapor pressure deficit, Soil moisture, Drought, Vegetation sensitivity, Climate change, CMIP6},
abstract = {Soil moisture (SM) and vapor pressure deficit (VPD) are key environmental drivers that regulate vegetation growth and thereby play a critical role in mediating the terrestrial carbon cycle. However, temporal inconsistencies in satellite derived vegetation indices have left long-term changes in vegetation sensitivity to SM and VPD under active debate. Here we estimated global vegetation sensitivity to SM and VPD during 1982–2021 by applying explainable machine learning with a temporal consistency prioritized normalized difference vegetation index (NDVI) dataset and hydro-climate anomalies. We reveal that SM generally enhances NDVI dynamics across most vegetated areas, particularly in arid and semi-arid regions, with its positive sensitivity increasing with aridity. Conversely, negative SM sensitivity is observed in boreal and humid areas due to confounding energy-related effects. VPD sensitivity generally shows a negative relationship with NDVI, except for an anomalous positive response on the Tibetan Plateau. Our analysis of inter-annual trends indicates increasing SM sensitivity in many regions (e.g., Horn of Africa, eastern North America), suggesting heightened drought risk, while VPD sensitivity generally decreased in southeastern Europe. State-of-the-art Earth system models capture the overall increase in global vegetation sensitivity to SM but do not reproduce the trend of vegetation response to VPD, possibly due to inability to accurately simulate the stomatal closure response of vegetation to continuously rising VPD. These findings highlight the critical importance of accurately simulating vegetation responses to water availability, as vegetation vulnerability to water stress is likely to intensify under ongoing climate change.}
}
@article{PENG2026135705,
title = {Freshwater carbon sequestration in eutrophic reservoirs: Superior burial efficiency compared to coastal seagrass, marsh, and mangrove blue carbon habitats under global warming},
journal = {Journal of Hydrology},
volume = {676},
pages = {135705},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135705},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008024},
author = {Yuening Peng and Keisuke Nakayama and Taketoshi Shimizu and Junpei Omori and Kohji Uno and Tomoyasu Fujii and Hao-Chi Lin and Jeng-Wei Tsai},
keywords = {Freshwater carbon, CO, Stratification, Net ecosystem production, Algae, Freshwater lake},
abstract = {Assessing “freshwater carbon” budgets is essential for mitigating global warming, yet carbon dynamics in eutrophic reservoirs remain poorly understood. This study investigated the Karasuhara Reservoir, a typical eutrophic system in Japan, using long-term data from two periods: 1982–1999 (“past”) and 2010–2018 (“present”). Our study centered on two key objectives: identifying the main drivers of reservoir DIC and evaluating how warming influences carbon burial mechanisms. By employing structural equation modeling (SEM), we revealed that river inflow, phytoplankton CO2 absorption, and dissolved organic carbon (DOC) mineralization are the primary drivers of dissolved inorganic carbon (DIC) dynamics in the epilimnion. Our net ecosystem production model further quantified these temporal dynamics, demonstrating that DIC fluctuations are governed by the balance between phytoplankton uptake, DOC mineralization, and bottom-layer leaching. Although extended residence times (>200 days) and stable stratification facilitate carbon sequestration by inhibiting the upwelling of bottom waters; however, these favorable conditions are being undermined by global warming. Net carbon burial rates dropped significantly from a mean of 158 mg-C m–2 d–1 (1982–1999) to 101 mg-C m–2 d–1 (2010–2018), likely as increased water temperatures reduced photosynthetic activity. Despite this decline, the reservoir exhibited a high burial efficiency (57% to 68%), underscoring the pivotal yet temperature-sensitive role of eutrophic freshwater systems in global carbon sequestration. Leveraging a 35-year continuous monitoring record and an integrated SEM + process-based NEP modeling framework, this study provides a site-scale empirical attribution of how a + 1.1 °C inter-period warming corresponded to a − 57 mg-C m–2 d–1 change in net carbon burial in an under-represented ecosystem type — an enclosed temperate eutrophic reservoir.}
}
@article{BUDAMALA2026135672,
title = {Process guided graph-based transformer learning for streamflow predictions in data-sparse river basins},
journal = {Journal of Hydrology},
volume = {676},
pages = {135672},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135672},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007699},
author = {Venkatesh Budamala and Sai Vikas Kona and Rajarshi Das Bhowmik and Hyunglok Kim},
keywords = {Prediction in Ungauged Basins (PUB), Process-guided machine learning, Graph transformer networks, Streamflow prediction, Data-sparse river basins, Hydrological model emulation},
abstract = {Streamflow prediction in data-sparse regions has traditionally relied on process-based hydrological models (PBMs) or hybrid approaches that combine physical modeling with data-driven learning. However, these methods typically require extensive calibration using local observations and detailed knowledge of internal model parameters, which limits their transferability and interpretability when applied to ungauged basins. To address these challenges, we introduce a novel Process-Guided Graph–Transformer (PGT) framework that surrogates PBMs and enhances streamflow prediction in ungauged basins (PUB) using uncalibrated PBM parameters without explicit calibration or optimization. The proposed framework integrates uncalibrated PBM outputs, river network topology, Graph Neural Networks, and Transformers for spatio-temporal learning, and is evaluated across three hydrologically contrasting river basins in India, Australia, and the United States. Results show that PGT consistently improves predictive skill, increasing median KGE from −0.5 to 0.4 for baseline models (SWAT and SWAT-SUFI2) to 0.50–0.75, while maintaining PBIAS within ± 10%, compared with baseline overprediction frequently exceeding 50%. PUB generalization experiments further demonstrate robust skill transfer from gauged to ungauged subbasins, with ΔKGE remaining near 0.0 ± 0.2 across hydrological distances of 0–300 km. Additional analyses indicate improved extreme-event detection (Critical Success Index ≈ 0.8–0.9 compared to 0.4–0.6 for baselines), reliable uncertainty characterization (p-factor: 0.5–1.0 compared to 0.25–0.6 for baselines), and an 8–40 × reduction in computational cost relative to traditional calibration-based approach (SWAT-SUFI2). Overall, these results demonstrate that PGT provides a scalable and process-consistent solution for multi-site streamflow prediction in data-sparse and ungauged regions.}
}
@article{GONG2026135745,
title = {Groundwater-mediated controls and future projections of carbon stocks in coastal wetlands},
journal = {Journal of Hydrology},
volume = {676},
pages = {135745},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135745},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008425},
author = {Xulong Gong and Ying Liang and Xue Jiang and Rui Ma and Yuan Liu and Shun Hu and Yanxin Wang},
keywords = {Hydrological processes, Coastal wetland, Carbon stocks, Groundwater dynamics, Climate change impacts},
abstract = {Coastal wetlands are critical blue carbon reservoirs, yet the role of groundwater dynamics in regulating carbon stocks remains poorly quantified in current assessments. Taking the Jiangsu coastal wetland area as the study site, this study quantified the spatial distribution of carbon stocks, identified key environmental drivers, and projected future carbon stock trajectories under sea-level rise scenarios. An integrated framework combining linear mixed effects models, structural equation modeling, ensemble machine learning models, and land-use simulation was developed to assess carbon stocks from 1988 to 2022 and project their changes to 2100. The results showed that climatic factors uniquely contributed more than 30% to aboveground biomass, whereas groundwater hydrodynamic and hydrochemical variables jointly accounted for a unique contribution of 14.2% to the variation in soil organic carbon. Structural equation modeling suggested that groundwater-mediated pathways were more strongly associated with climate-driven variation in soil organic carbon density than vegetation-mediated pathways. Historical analysis indicated that total carbon stocks declined by 35.1% from 1988 to 2022, mainly associated with land-use conversion and sea-level rise. To forecast future changes, a novel dual scale projection framework was developed to simultaneously account for shifts in carbon density and wetland spatial extent. Compared with the 4 mm/y sea-level-rise scenario, the 7 mm/y scenario produced a net carbon stock loss of 3.7 × 103 t by 2100. This study advances the understanding of groundwater-mediated controls on coastal carbon stocks and provides a transferable modeling framework for blue carbon management under climate change.}
}
@article{AN2026135676,
title = {Physics-informed dual-modal decomposition and deep hybrid learning with interpretability for reliable prediction of dissolved oxygen in complex riverine systems},
journal = {Journal of Hydrology},
volume = {676},
pages = {135676},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135676},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007730},
author = {Mengyao An and Zhaocai Wang and Xiaoguang Bao and Zuowen Tan and Zhaoyang Zhu},
keywords = {Dissolved oxygen (DO) prediction, Physics-informed deep learning, Improved Dung Beetle Optimization Algorithm (IDBO), Variational Mode Decomposition (VMD), Bidirectional Temporal Convolutional Network (BiTCN), Improved Transformer (iTransformer)},
abstract = {Dissolved oxygen (DO) is a critical indicator of riverine aquatic ecosystem health, making high-precision DO forecasting models indispensable for watershed water quality risk early warning and water resource security. Existing methodologies, however, predominantly rely on historical data for water quality simulation, often overlooking inherent physical biases, limited non-linear data processing capabilities, inadequate coupling of long- and short-term dependencies, and empirical parameter reliance. To address these deficiencies, this study first constructs a four-dimensional feature system integrating target, surrounding, and upstream monitoring indicators along with meteorological factors. Subsequently, based on the one-dimensional convection–diffusion-reaction equation for riverine DO, we derive Péclet and two types of Damköhler numbers as core physical prior parameters to incorporate into the model. We next adopt a dual-modal decomposition approach − combining Variational Mode Decomposition (VMD) and Complementary Ensemble Empirical Mode Decomposition with Adaptive Noise (CEEMDAN) − to separate the long-term evolutionary patterns and short-term dynamic variations in the dataset. Furthermore, an Improved Dung Beetle Optimizer (IDBO) is introduced to optimize VMD decomposition parameters and Bidirectional Temporal Convolutional Network (BiTCN) hyperparameters. Finally, by integrating the physicochemical interaction mechanisms of water temperature, permanganate index, and DO, we refine the loss function to construct the IDBO-VCEEMDAN-TiTransformer-PDL model, which leverages BiTCN and Improved Transformer (iTransformer) for efficient fusion of long- and short-term data features. Experimental results demonstrate the model’s superior predictive performance, with coefficient of determination (R2) values exceeding 0.99 across six upstream and downstream monitoring stations. Notably, the Wolongsi Bridge station achieved an R2 of 0.9989, while the Shawangdu station exhibited remarkably low root mean square error (RMSE) and mean absolute error (MAE) of 0.0660 and 0.0533, respectively, far outperforming benchmark comparison models. Experiments confirm that the integration of physical prior mechanisms contributes most significantly to model performance enhancement, accounting for 4.62%, with two-modal decomposition and IDBO hyperparameter optimization yielding improvements of 4.07% and 2.93%, respectively. This model retains the computational efficiency of data-driven approaches while ensuring prediction accuracy and generalizability through physical mechanism constraints, offering a robust technical solution for precise riverine DO concentration forecasting and refined watershed water environment management.}
}
@article{HUANG2026135700,
title = {Towards more accurate streamflow and flood prediction via explainable CNN-LSTM: leveraging ERA5 gridded precipitation and hydrological observations through input-architecture co-design},
journal = {Journal of Hydrology},
volume = {676},
pages = {135700},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135700},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007973},
author = {Sheng Huang and Tianyi Nan and Yueling Wang},
keywords = {CNN-LSTM, Streamflow prediction, Heterogeneous data structures, Model architectures, ERA5, Explainable deep learning},
abstract = {Deep learning has achieved high accuracy in hydrological and hydrodynamic modeling, yet effectively incorporating ungauged, precipitation-driven lateral small tributaries into model architectures for more accurate streamflow prediction remains underexplored. This challenge is particularly pronounced under spatially heterogeneous rainfall, where dimensional mismatches between gridded precipitation data and sparse upstream observations hinder accurate source-sink representation. Here, we propose an integrated framework that combines a three-dimensional Convolutional Neural Network (3D-CNN) with a Long Short-Term Memory (LSTM) network, enabling flexible fusion of gridded precipitation (e.g., ERA5) and upstream hydrological observations. The proposed 3D-CNN-LSTM model incorporating richer spatiotemporal precipitation information yields more accurate and stable streamflow and flood predictions across most stations compared to models using only upstream streamflow and spatially averaged precipitation. Even where precipitation-driven tributary inflows account for as little as 5% of downstream flow, the model improves flood prediction in 80% of events relative to a streamflow-only LSTM. When such tributary inflows contribute positively to downstream streamflow, incorporating spatially distributed precipitation through the 3D-CNN-LSTM leads to improved predictions, even under complex river–lake interactions. In contrast, when precipitation acts as irrelevant or uninformative inputs (e.g., under flow diversion with complex routing pathways), the streamflow-only LSTM architecture performs adequately without the added precipitation noise. Explainable deep learning techniques further provide diagnostic insights into the 3D-CNN-LSTM model’s sensitivity to lagged upstream inputs and reveal patterns that are broadly consistent with known hydrological behavior. This integrated input-architecture co-design strengthens deep learning’s capacity to uncover and interpret streamflow generation mechanisms.}
}
