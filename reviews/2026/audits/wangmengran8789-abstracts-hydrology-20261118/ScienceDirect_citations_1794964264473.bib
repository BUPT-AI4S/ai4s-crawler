@article{QI2026135659,
title = {Enhancing understanding of vegetation responses to flash droughts: the need for high-temporal-resolution monitoring data},
journal = {Journal of Hydrology},
volume = {676},
pages = {135659},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135659},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007560},
author = {Zixuan Qi and Yuchen Ye and Yanpeng Cai and Chaoxia Yuan and Qian Tan and Lian Sun and Zhifeng Yang and Guanhui Cheng},
keywords = {Flash drought, Full lifecycle dynamics, High temporal resolution, Response time, Ecosystem structure and function},
abstract = {Flash droughts, characterized by rapid declines in soil moisture, have become increasingly frequent and exert sustained pressure on terrestrial carbon and water cycles. However, a practical framework is still lacking to systematically track vegetation ecosystems’ coupled structural and functional responses before, during, and after flash-drought onset. We integrate daily observations of the Normalized Difference Vegetation Index (NDVI), gross primary productivity (GPP), water-use efficiency (WUE), and underlying WUE (uWUE) for China from 1982 to 2019, and use these data to develop a high-temporal-resolution Vegetation Flash Drought Response Framework (HTR-VFDRF). The framework characterises three sequential lag windows: the negative anomaly response time, peak point time, and lag recovery time. Furthermore, we applied the KDE method to analyze the temporal patterns of vegetation structural and functional response sensitivity under flash drought stress, while also employing interpretable machine learning and the geographic detector to analyze the multidimensional drivers of land surface, meteorological, and land–atmosphere coupling factors that influence the negative anomaly peak points in vegetation structure and function. Our results show that vegetation ecosystem functional indicators are more sensitive to flash drought than structural indicators. Preceding and following flash drought events, the vegetation ecosystem function daily-scale negative anomaly response curves exhibit a rapid V-shaped decline and subsequent recovery in humid southeastern China, in contrast to a more gradual S-shaped increase and stabilization in cold-dry and semi-arid regions. Negative anomaly peaks in GPP, WUE, and uWUE deepen from arid to humid zones along a climatic aridity gradient, with mixed forests exhibiting the highest functional stability among vegetation types. Mechanistic analysis reveals that across both monsoon and non-monsoon regions of China, flash drought-induced declines in vegetation carbon uptake are primarily driven by synergistic shifts in soil moisture, air temperature, and surface energy fluxes (SSHF and SLHF), which jointly constrain evapotranspiration and photosynthetic efficiency. Moreover, the interaction between flash-drought intensity and bedrock depth explains approximately 70% of the spatial heterogeneity in long-term mean GPP negative anomaly peak points. These findings emphasize the essential role of high-temporal-resolution monitoring for detecting early functional decline and recovery, and demonstrate that the HTR-VFDRF can serve as a scalable method for evaluating global vegetation resilience and vulnerability to flash drought under continued climate warming.}
}
@article{ZHAO2026135720,
title = {Divergent effects of natural and socioeconomic drivers on water use in China from 2000 to 2022},
journal = {Journal of Hydrology},
volume = {676},
pages = {135720},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135720},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008176},
author = {Tianqing Zhao and Wen Wang and Xueke Yan and Fuxiong Guo},
keywords = {Water resources, Water use, Random forest regression, SHAP framework},
abstract = {The uneven distribution and imbalance between supply and demand of water resources in China pose serious challenges to sustainable socioeconomic development. This study examined the spatiotemporal dynamics of total water use (WU at the national scale, area-normalized as WU/A at the provincial scale), per capita water use (WU/C), and water use per 10,000 yuan of GDP (WU/G) at both the national and provincial scales from 2000 to 2022. A random forest regression model combined with the SHAP framework was applied to assess relative importance and contributions of natural factors (annual precipitation, annual mean temperature, and NDVI) and socioeconomic factors (cropland proportion, built-up land proportion, secondary industry proportion, population density, and GDP per capita) for each water use indicator. The results show that, at the national scale, population density, built-up land proportion, and NDVI are the dominant drivers of WU, WU/C, and WU/G. Economic factors dominate water use in most provinces, with built-up land proportion and population density exerting a negative impact on WU/G, whereas their effects on WU/A and WU/C vary regionally. For WU/C, provinces driven by both natural and socio-economic factors have a wider distribution. In contrast, WU/G is not dominated by natural factors in any province. These findings improve understanding of how natural and socioeconomic drivers affect water use patterns and provide a scientific basis for developing region-specific strategies for improving water-use efficiency.}
}
@article{FENG2026135712,
title = {Daily inference of reservoir surface water area at large scales via a systematic deep learning framework synergistically integrating multisource remote sensing imagery},
journal = {Journal of Hydrology},
volume = {676},
pages = {135712},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135712},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008097},
author = {Yunye Feng and Lihua Xiong and Qiumei Ma and Shuang Li and Xiongfeng Bai and Mengran Tang},
keywords = {Reservoir surface water area, Remote sensing, Conditional generative adversarial network, Yangtze River Basin},
abstract = {Reservoir surface water area (SWA) serves as a pivotal indicator for characterizing storage changes and water balance, with important implications for assessing the effects of anthropogenic regulation and protecting aquatic ecosystems. Although satellite observations offer indispensable data support for reservoir SWA monitoring, the trade-off between spatial and temporal resolutions in single-source satellite datasets severely impedes the comprehensive quantification of rapid SWA dynamics. To address this challenge, we develop a systematic deep learning framework for daily SWA inference that synergistically combines cloud-free optical image reconstruction and surface water extraction. The reconstruction module generates daily cloud-free Landsat-like optical images by fusing heterogeneous data from Sentinel-1, MODIS, and Landsat-derived NDVI via a multi-branch feature fusion mechanism. Using the reconstructed imagery as input, the surface water extraction module accurately delineates reservoir SWA. Comparative experiments demonstrate that the proposed framework achieves robust performance in cloud-free image reconstruction (RMSE = 0.021, SSIM = 0.737) and high accuracy in water extraction, with both user’s and producer’s accuracies exceeding 0.970. The framework is applied to 288 large reservoirs across the Yangtze River Basin, and its scalability for large-scale inference is further validated using in situ water elevation measurements from 77 reservoirs. Overall, this framework provides a robust and scalable solution for daily large-scale reservoir SWA inference, laying a solid foundation for hydrological analysis, optimal reservoir operation, and sustainable water resource management.}
}
@article{LYU2026135695,
title = {Hydrological response to glacier peak water in the largest inland river basin of China},
journal = {Journal of Hydrology},
volume = {676},
pages = {135695},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135695},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007924},
author = {Haodong Lyu and Gonghuan Fang and Yaning Chen and Wenting Liang and Lei Wang and Jianmin Qiao and Man Chen and Xiaolong Yan and Ruoyan Li and Shiru Han},
keywords = {Glacier peak water, ISIMIP3b, Runoff change, Long short-term memory (LSTM), AlpineTarim River},
abstract = {Glacier meltwater is crucial for river runoff in highly glacierized basins; however, whether total runoff will decline after the peak of glacier runoff remains unclear at the basin scale. To address this, we projected monthly and daily runoff for seven headwaters of the glacier-fed inland Tarim River using an attention-enhanced LSTM model for reliable long-term performance. The results indicate that most headwater catchments are projected to experience increasing runoff during the 21st century under SSP245, SSP370, and SSP585, whereas changes under SSP126 are generally weak and spatially heterogeneous. For the late 21st century (2071–2100), runoff in the southern Tianshan Mountains is projected to increase by 10% and 21% in the Aksu River under SSP245 and SSP585, and by 11% and 18% in the Kaidu River. Larger increases are projected for the northern slope of the Kunlun Mountains, with increases of 64% and 55% in the Yarkant River, and 74% and 185% in the Hotan River under SSP245 and SSP585, respectively, relative to the 2000–2014 baseline. Passing the glacier peak water does not necessarily lead to an immediate outlet runoff decline, despite the significant contribution of glaciers. The annual river runoff was projected to increase by 8.48% and by 14.40% during and after peak water periods, respectively, compared to the period before peak water.}
}
@article{SHU2026135724,
title = {Mapping near-daily large lake water surface topography by integrating SWOT swath observations with multi-mission satellite radar altimetry},
journal = {Journal of Hydrology},
volume = {676},
pages = {135724},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135724},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008218},
author = {Song Shu and Hongxing Liu and Richard Beck and Lei Wang and Dan Tian and Jihee Seo},
keywords = {Near-daily water levels, 2D lake water level maps, SWOT, EOF analysis},
abstract = {Large lakes exhibit spatial variations in water levels, leading to distinct lake surface topography. Accurate characterization of this topography enables an improved understanding of lake dynamics, hydrological exchanges and water balance assessments. While satellite radar altimetry is widely used to monitor lake water, most missions utilize nadir-looking profiling altimeters that measure water levels only along fixed ground tracks, leaving significant data gaps in between. The recently launched Surface Water and Ocean Topography (SWOT) mission provides wide-swath 2D elevation measurements at high spatial resolution over the water bodies on a global scale. However, its 21-day repeat cycle limits the temporal frequency of observations. In this study, we present a framework capable of mapping lake water surface topography on a near-daily basis by integrating 2D SWOT observations with 1D radar altimetry. The method consists of three components: first, inter-mission biases between SWOT and four operational radar altimetry missions (Jason-3, Sentinel-3A, −3B, and Sentinel-6) are estimated using concurrent and co-located overpasses. Second, the stable and average intra-lake spatial pattern of water surface topography is derived by applying an Empirical Orthogonal Function (EOF) to the SWOT time series wide-swath measurements. Third, the SWOT-calibrated profiling altimetry measurements from the four radar altimetry mission were propagated to the entire lake based on that stable spatial pattern. This method has been successfully applied to Lake Ontario by using SWOT Calibration/Validation data, generating a near-daily time series of water surface topography maps with Root Mean Square Error (RMSE) for spatial and temporal water level variations below 4 cm and 5 cm, respectively.}
}
@article{WANG2026135675,
title = {Partitioning nighttime sap flux into transpiration and stem refilling: Towards improved baselining and sap flux interpretation},
journal = {Journal of Hydrology},
volume = {676},
pages = {135675},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135675},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007729},
author = {Mianzhi Wang and Matti Räsänen and Teemu Hölttä},
keywords = {Baseline, Evapotranspiration, Nighttime sap flux density, Refilling, Thermal dissipation probes, Transpiration},
abstract = {Nighttime sap flux is important for understanding tree water-use dynamics in ecohydrological studies, as it represents the diurnal minimum of sap flow and often serves as the reference period for establishing thermal dissipation probe baselines. The baseline indicates simultaneous cessation of both nighttime transpiration and refilling of trees internal water stores. However, finding this moment is challenging as the baseline is dynamically changing, and the complete sap flux cessation may not even occur for boreal forests. Here, we proposed a novel framework using VPD and dendrometer measurements to partition transpiration and refilling from nighttime sap flux density, and introduced a night-by-night baselining scheme that does not rely on identifying the zero-flow moment. One conventional baselining method using the maximum probe voltage (or temperature) difference substantially underestimated sap flux density by 204.56% for nighttime, 28.30% for daytime, and 45.20% for full-day flux in P. sylvestris, and by 344.77%, 45.68%, and 54.76%, respectively, in A. glutinosa. Evaluation through leaf gas exchange and evapotranspiration data confirmed the accuracy of partitioning between nighttime transpiration and refilling, demonstrating that nighttime transpiration can drive measurable nighttime evapotranspiration responses. Seasonally, sap flux density showed an initial increase in both transpiration and refilling, followed by a decline, with transpiration dominating until mid-summer before refilling gradually took precedence.}
}
@article{ZHAO2026135698,
title = {Projected response of global rainfall-induced landslides to future climate change},
journal = {Journal of Hydrology},
volume = {676},
pages = {135698},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135698},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600795X},
author = {Kailiang Zhao and Haijun Qiu and Ya Liu and Guoqing Yang and Zijing Liu and Wanqi Luo and Yaru Zhu and Guoyu Wang and Mohib Ullah},
keywords = {Rainfall-induced landslides, Climate change, Deep learning, Susceptibility prediction},
abstract = {Global climate change is expected to intensify extreme weather events, leading to an increase in the frequency and severity of rainfall-induced landslides. However, future trends in landslide susceptibility remain unclear. In this study, we constructed three models: Random Forest (RF), eXtreme Gradient Boosting (XGBoost), and Convolutional Neural Networks (CNNs) by integrating the global historical landslide catalog with both dynamic and static environmental factors. The models achieved AUC values of 0.91, 0.88, and 0.92, respectively, with the CNNs model performing best. Thus, CNNs was used for future landslide susceptibility prediction. Using 2021 as the baseline, the global landslide susceptibility distribution for 2050 and 2100 was predicted using three Shared Socioeconomic Pathway (SSP) scenarios from the Coupled Model Intercomparison Project Phase 6 (CMIP6). The results show that the areas that are susceptible to landslides in 2050 and 2100 are primarily located in tropical and subtropical mountainous regions, characterized by high rainfall and steep terrain. In contrast, areas with lower landslide susceptibility are concentrated in plains, deserts, and temperate regions. Higher emission scenarios continue to amplify landslide risks, significantly increasing very high susceptibility by 177%-209% from 2050 to 2100, while low susceptible areas remain dominant (>75%) across all scenarios. Six continents exhibit different characteristics of change. These findings quantify future trends in global landslide susceptibility under different scenarios, providing a scientific basis and decision support for countries to develop scenario-based disaster early warning systems and adaptive policies.}
}
@article{LI2026135691,
title = {From subordinate recharge to dominant pollution: the role of lacustrine groundwater discharge in sandy saline-salt lakes},
journal = {Journal of Hydrology},
volume = {676},
pages = {135691},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135691},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007882},
author = {Xiangwei Li and Ruihong Yu and Renpu Wang and Dongchao Huo and Zongbao Yue and Xiaozhuang Wang and Bowen Ye and Ao Gao and Hanyu Li and Yufei Bai and Yuanzhen Zhao and Heyang Sun and Shen Qu and Tingxi Liu and Xixi Lu},
keywords = {Lacustrine groundwater discharge (LGD), Pollutant fluxes, Radon (Rn), Saline-salt lakes, Mu Us Sandy Land},
abstract = {Sandy lakes are ecologically vulnerable to anthropogenic and climatic stressors. Although lacustrine groundwater discharge (LGD) is recognized as a crucial component of lake hydrology and nutrient cycling, its specific role in regulating environmental vulnerability in these sensitive ecosystems remains poorly quantified. This study employed an integrated approach, combining hydrochemical analysis, water source identification, and a radon (222Rn) isotope mass balance model, to investigate the sources and drivers of major pollutants in saline-salt lakes of the Mu Us Sandy Land. Particular emphasis was placed on the impact of LGD on lake water (LW) quality. The enrichment of nitrogen substances and Mg2+ represented the primary environmental issue within the watershed. Total nitrogen (TN), primarily derived from manure application, and total phosphorus (TP), originating from industrial activities, were identified as the major pollutants of groundwater (GW) and LW. Spatially, saline lakes exhibited better water quality than salt lakes, and lakes in the upper and middle reaches generally had better quality than those downstream. Temporally, water quality variations were closely linked to changes in lake surface area, which were predominantly controlled by precipitation-the primary source of lake recharge, accounting for 65.6% of total inflow. The concentration of 222Rn decreased progressively from GW to porewater and then to LW (2030.17, 1477.41, and 40.61 Bq/m3, respectively), indicating active LGD processes, with a mean LGD rate of 63.60 mm/d within the watershed. This process delivered fluxes of 1.88, 7.92, and 3.18 g/m2/d for TN, NO3–, and Mg2+, respectively, facilitating their accumulation in the lakes. The ratio of GW input height to lake depth revealed that shallower lakes received a greater proportion of water and nutrient inputs via LGD and consequently exhibited poorer water quality, highlighting the substantial regulatory role of LGD on lake environments. Random forest analysis further indicated that mitigation strategies should target the root causes, namely, industrial/agricultural pollution sources and the LGD pathway. Controlling inputs from these terrestrial sources is therefore essential to reduce pollutant loading in GW and limit their influx into lakes.}
}
@article{MOVAHEDI2026135752,
title = {Tidal current reversals drive dynamic bedform-induced benthic exchange in a large estuary},
journal = {Journal of Hydrology},
volume = {676},
pages = {135752},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135752},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008498},
author = {Neshat Movahedi and Madelaine Reid and Li Zheng and Adam Skarke and James W. Heiss},
keywords = {Groundwater-surface water interactions, Coastal aquifer, Tidal current, Benthic exchange, Hydrodynamics, Estuary},
abstract = {Currents flowing over bedforms drive exchange of surface water and groundwater across sediment–water interfaces, leading to biogeochemical transformations that impact surface water quality. Current understanding of current-bedform exchange is primarily limited to fluvial systems with unidirectional current flow. Within estuaries, tidal current reversals create complex surface water hydrodynamics that are likely to drive dynamic current-bedform exchange patterns. In this study we investigate controls of tidal current reversals over estuarine bedforms on benthic exchange rates and patterns in the freshwater zone of a large estuary. We employ a novel three-way nested modeled approach involving a calibrated estuary-scale hydrodynamic model, small-scale computational fluid dynamics models, and numerical groundwater simulations. Model results show that tidal current reversals generate spatially and temporally variable benthic exchange rates along bedform surfaces though flood and ebb tidal phases. Benthic exchange ranges from 0 cm/d at slack tide to ∼2 cm/d during peak ebb tide. Groundwater flow within individual bedforms reverses direction from downstream to upstream over tidal cycles, while benthic exchange rates vary spatially along the estuary owing to complex estuary hydrodynamics. Simulation results indicate that 2.3% of Delaware River discharge cycles through bedforms within the tidal freshwater reach. Tidal current-induced exchanges are higher relative to exchanges in systems with similar unidirectional flows, indicating that tidal current acceleration over bedforms should be considered when quantifying groundwater-surface water interactions in the coastal zone. The findings have implications for biogeochemical processing of estuarine surface water and land to ocean material fluxes.}
}
@article{WANG2026135788,
title = {Dual roles of leaf water storage in Robinia pseudoacacia: delaying stomatal closure and mitigating xylem embolism during drought},
journal = {Journal of Hydrology},
volume = {676},
pages = {135788},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135788},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008851},
author = {Xia Wang and Guangyuan Du and Chenyang Li and Haoyan Wei and Mingjing Zhou and Yanli Fan and Tamir Kamai and Sperling Or and Bingcheng Si and Min Li},
keywords = {Leaf water storage, Stomata closure, Hydraulic failure, Drought stress, Water potential},
abstract = {Leaf water storage alleviates drought stress in plants by allowing stored water to be used rapidly and directly in transpiration. Nevertheless, the dynamics of leaf capacitance variation and its impact on plant survival under drought stress remain inadequately understood. In this study, we analyzed the variations in leaf relative water content, stomatal conductance, and xylem conductance with respect to xylem water potential in Robinia pseudoacacia (R. pseudoacacia) during continuous drought, and compared their critical water potentials. Water stored in locust leaves is continuously released from mild drought stress until leaf fall, while leaf-specific water capacity increases significantly at the onset of stomatal closure. Prior to complete stomata closure, the released water replenished transpiration to delay stomatal closure. This released water can independently sustain seedlings transpiration for 0.2 ∼ 0.3 h. Furthermore, the residual leaf water storage post-stomata closure functions as a long-term reservoir enabling trees to withstand severe drought. At this stage (within the water potential range from stomatal closure to 50% loss of xylem hydraulic conductivity), the water released by leaves can independently support seedling transpiration for 1.3–3.9 h. In conclusion, the leaf water storage release of R. pseudoacacia may significantly contribute to the delay of stomatal closure and the prevention of catastrophic embolism during drought. Therefore, greater attention should be devoted to understanding the characteristics of leaf water storage release and their profound impact on plants, particularly with regards to application and development in ecological models.}
}
@article{ZHOU2026135704,
title = {Water levels shape different dissolved organic matter chemistry across Yellow River Deltaic distributary channels},
journal = {Journal of Hydrology},
volume = {676},
pages = {135704},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135704},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008012},
author = {Yuping Zhou and Yuxuan Zhu and Yihua Xiao and Kai Wang and Zhenwei Yan and Ding He and Yujue Wang},
keywords = {Dissolved organic matter, River deltas, Distributary channels, Water levels},
abstract = {River deltas supply a substantial source of DOM to oceans and exert a disproportionate control on marine biogeochemistry by splitting the fluvial flow into several branches. Although water levels is a critical factor altering biogeochemical processes of DOM, the role of water levels in modulating DOM composition and reactivity across different distributary channels of deltas remains unclear. In this study, two main distributary channels with different water levels of the Yellow River Delta were selected to feature DOM sources and composition by employing mass spectrometry, fluorescence spectroscopy and statistical analysis. Results display that water levels shape different DOM composition in deltaic distributary channels. The primary distributary channel with high water level facilitates the export of fluvial terrestrial DOM throughout deltas, whereas low water level promotes internal cycling of autochthonous phytoplankton-derived organic matter and allochthonous soil organic matter in secondary distributary channels. Internal biogeochemical processes of secondary distributary channels increase the abundance of labile DOM and N/S-containing compounds, and their discharges could alter coastal biogeochemistry through microbial remineralizations. Enriched CRAM could also imply that secondary distributary channels contribute to the refractory carbon pool of coastal oceans. These findings clarify secondary distributary channels with low water levels assert different controls on the export of organic matter throughout river deltas, and numerous secondary distributary channels of river deltas could be the overlooked way transferring diverse DOM from lands to oceans. Linking hydrological conditions of distributary channels with DOM features would be a better way to quantifying the role of river deltas in carbon transfer and has important implications for coastal ecosystems.}
}
@article{HAO2026135728,
title = {A dual-stream LSTM–XGBoost framework for mine water inflow forecasting: a case study of the Longfeng coal mine},
journal = {Journal of Hydrology},
volume = {676},
pages = {135728},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135728},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008255},
author = {Wang Hao and Li Bo and Zeng Yi Fan and Liu Pu and Chen Wei and Wang Ze Hui and Che Lu Lu},
keywords = {Groundwater inflow prediction, Dual-stream LSTM, XGBoost, Uncertainty quantification, SHAP interpretability, Water resources management},
abstract = {Accurate prediction of groundwater inflow into mining excavations is critical for operational dewatering system design and regional water resources management, yet existing models struggle to effectively integrate heterogeneous hydrological drivers encompassing temporal dynamics and spatial hydrogeological controls. This study presents a case study of the Longfeng coal mine in which we propose a dual-stream LSTM-XGBoost hybrid framework that employs parallel architectures to separately extract temporal features from historical inflow sequences and spatial features from multi-source hydrometeorological and mining operational factors, with a two-stage training strategy enabling synergistic integration of deep learning representation and ensemble learning paradigms. Applied to daily monitoring data spanning November 2021 to October 2024, the model achieves test performance of R2 = 0.855, RMSE = 23.65 m3/h, MAE = 11.55 m3/h, MAPE = 5.82%, and Nash–Sutcliffe efficiency (NSE) = 0.855, outperforming all benchmarks evaluated under an identical hyperparameter-optimization budget. Framed as an autoregressive-exogenous (ARX) operational forecasting system, an ablation decomposition quantifies the distinct contributions of hydraulic persistence (target history) and exogenous drivers: removing target-history inputs degrades RMSE to 45.64 m3/h, confirming that lagged inflow is a major predictability source, whereas the dual-stream design still delivers a 7.1% RMSE improvement over a target-history-only LSTM and better captures peak-event responses. Monte-Carlo Dropout uncertainty quantification yields 97.24% empirical coverage at the nominal 95% predictive interval, with aleatoric uncertainty dominating total predictive variance. SHAP analysis reveals a “macro-equilibrium, micro-concentration” contribution structure in which temporal and spatial pathways play complementary roles consistent with groundwater memory effects and recharge–discharge mechanisms. Built on process-informed design, the framework provides a transferable solution for mining-affected groundwater inflow prediction. Its current demonstration at a single mining district lays the groundwork for multi-site validation, which will be pursued to strengthen cross-regional applicability.}
}
@article{LUO2026135716,
title = {Multi-scale reactive transport modeling of water–rock interactions during uranium in situ recovery},
journal = {Journal of Hydrology},
volume = {676},
pages = {135716},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135716},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008139},
author = {Haohao Luo and Adam J. Siade and Chao Li and Baheten Boassen {Guillaume Herman} and Henning Prommer and Jing Sun},
keywords = {Water-rock interactions, Uranium recovery, Reactive transport modeling, Uncertainty quantification, Gangue minerals},
abstract = {In situ recovery (ISR) is widely used for uranium mining without physical excavation of the ore. Successful ISR requires an accurate understanding of how lixiviants interact hydrochemically with the ore and how these processes scale from laboratory experiments to the field. Here, we developed a multi-scale reactive transport modeling (RTM) and uncertainty quantification framework to investigate water–rock interactions controlling uranium recovery during ISR under uncertainty. A laboratory-scale RTM was first constructed to analyze column leaching experiments on sandstone-hosted ores using acidic and alkaline lixiviants, and a particle swarm optimization-based Monte Carlo approach was used to quantify parameter uncertainty. The results show that uranium-bearing mineral dissolution was kinetically controlled, whereas gangue mineral dissolution competed for the lixiviant and delayed significant uranium leaching by approximately 72 h. The most sensitive and uncertain parameters were both associated with uranium dissolution kinetics. The model was subsequently extended to the field scale using residence time-dependent rate laws, incorporating a dual-domain transport framework and stochastic spatial heterogeneity. By propagating posterior geochemical parameter distributions from the laboratory-scale model, field-scale predictive uncertainty was assessed. The results indicate that physical heterogeneity and mass transfer limitations strongly shape the uncertainty distribution and prevent the over-optimistic recovery predicted by idealized homogeneous models. The predicted cumulative uranium recovery ranged from 1,139 to 1,630 kg, with a mean of 1,380 kg, and followed an approximately normal distribution. Uranium yields were governed by nonlinear multivariate interactions, with high recovery occurring when high initial uranium loading, fast dissolution kinetics, and low gangue interference coincided. This study constrains the water–rock interactions governing ISR and provides a process-based multi-scale modeling tool for prediction under uncertainty.}
}
@article{LIANG2026135679,
title = {Changes in sediment transport capacity in the lower Yellow River: Analysis using an improved formula based on energy theory},
journal = {Journal of Hydrology},
volume = {676},
pages = {135679},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135679},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007766},
author = {Dong Liang and Zhe Huang and Junzheng Liu and Yan Li and Yuchuan Bai and Haijue Xu},
keywords = {Sediment transport capacity, Energy theory, Lower Yellow River, Low-sediment concentration flow, Riverbed coarsening},
abstract = {Sediment transport capacity (STC) is fundamental for quantifying hydro-sediment dynamics in the lower Yellow River (LYR). Since the Xiaolangdi (XLD) reservoir began operating in 2000, downstream flow-sediment conditions in the LYR have changed markedly, with more frequent low-sediment flows, channel adjustment, and riverbed coarsening, rendering traditional STC formulations less suitable for post-XLD conditions. In this study, a new STC formula for the post-XLD LYR was developed within the classical energy-based framework, based on the energy conservation equations of sediment-laden flow. Using a near-equilibrium sediment-transport criterion, 360 sets of measured flow-sediment data from 2000 to 2010 were retained for parameter calibration, and 208 sets of measured data from 2011 to 2022 were used for validation. Comparative evaluation shows that the proposed formula provides the best overall predictive performance for the datasets considered in this study and performs well under post-XLD low-to-moderate sediment concentration conditions. The formula was subsequently applied to investigate the relationships among STC, flow rate, cross-sectional morphology, and bed-material gradation. Results indicate a significant decline in STC after XLD operation, which is interpreted as the result of coupled hydrodynamic, morphological, and bed-material adjustments, with riverbed coarsening acting as one important contributing factor. The proposed formula is intended primarily for similar conditions of post-XLD in LYR, while its application to other alluvial rivers should be understood as restrictive and requires further validation.}
}
@article{ZOU2026135699,
title = {Modifying the WRF-Noah irrigation representation to simulate regional climate effects of irrigation over the humid middle-lower Yangtze Plain, China},
journal = {Journal of Hydrology},
volume = {676},
pages = {135699},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135699},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007961},
author = {Liangfeng Zou and Dongguo Shao and Yuanyuan Zha and Yuqing Diao and Jiong Zhu and Shu Chen and Wenquan Gu and Mengzi Li},
keywords = {Climatic effects, Irrigation scheme, WRF-Noah, Surface energy budget, Precipitation, Paddy irrigation},
abstract = {Exploring the climatic effects of agricultural irrigation and potential mechanisms is essential for guiding sustainable irrigation development. However, the impacts of irrigation on the climate of the humid Middle-Lower Yangtze Plain (MLYP) region in China, a global hotspots of irrigation, remain unclear. The region employs intricate rotation patterns, with paddy as the primary crop cultivated in inundated fields. Due to the simplification of differentiated irrigation for various crops and paddy ponding irrigation in land surface models, realistically modeling irrigation practices in the MLYP is challenging. Therefore, this study developed a subgrid-scale multi-crop demand-driven irrigation scheme and coupled it with the Weather Research and Forecasting-Noah (WRF-Noah) model, incorporating a new ponding submodule to simulate water and energy budget processes in paddy field subgrids. Two experiments (irrigation on and off) were designed to explore the impacts and mechanisms of irrigation on the regional climate of MLYP. Results indicate that the modified scheme improved the simulation accuracy of surface fluxes, soil moisture, and irrigation amount. Irrigation significantly increased latent heat flux, leading to domain-averaged cooling of 0.316°C during spring and summer, while the irrigated subgrids reached 0.647°C. Reduced planetary boundary layer height strengthened atmospheric stability and suppressed summer local convective precipitation over MLYP. Irrigation-induced anomalous anticyclone and large-scale circulation perturbation inhibited internal moisture convergence and external imports, reducing summer non-convective precipitation. Our study emphasizes the critical importance of realistic irrigation representation in climate studies and advances the mechanism-level understanding that water management modulates land–atmosphere interactions.}
}
@article{BHARGHAVI2026135650,
title = {Multi-scale spatiotempral characterization and trend analysis of meteorological and geographical characteristics of drought in India’s arid and semi-arid regions},
journal = {Journal of Hydrology},
volume = {676},
pages = {135650},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135650},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600747X},
author = {Kandula Bharghavi and Thotli Lokeswara Reddy and Hemalatha Kapa and Penti Rajesh and Renati Siddi Raju and Krishnareddigari Krishna Reddy},
keywords = {Climate variability, Drought intensity, Drought duration, Drought frequency, Drought trend analysis, Spatiotemporal assessment},
abstract = {Drought is a complex and pervasive climate hazard that significantly affects agricultural productivity, water resources, and socioeconomic conditions. While numerous studies have analyzed drought in India at national or state scales, there is limited understanding of its evolution across distinct arid and semi-arid sub-climatic zones, particularly the hot and cold arid and semi-arid regions, which are highly vulnerable to climate variability and rising temperatures. To address this gap, the present study conducts a comprehensive, multi-scale spatiotemporal assessment of drought characteristics using the Standardized Precipitation Index (SPI) and the Standardized Precipitation Evapotranspiration Index (SPEI) from 1981 to 2020. Drought duration, frequency, and intensity were quantified at 1-, 3-, 6-, 12-, and 24-month temporal resolutions, and trend analysis was performed using the non-parametric Mann-Kendall test and Sen’s slope estimator. Results reveal that SPEI consistently outperforms SPI in capturing prolonged droughts, especially at longer temporal scales, due to its sensitivity to temperature-driven evapotranspiration. Drought frequency generally increases with temporal scale, with the Hot Semi-Arid zone exhibiting the highest frequency at 24 months, while the Cold Arid region shows comparatively lower frequencies. Spatial trends indicate rising drought duration in northern cold zones and decreasing intensity in parts of the Hot Arid zone. Moderate droughts dominate most regions, whereas severe and extreme events intensify at longer scales, particularly in hot semi-arid areas. Significant interannual variability is observed in both SPI and SPEI anomalies, highlighting the vulnerability of arid regions to prolonged dry periods. The correlation between SPI and SPEI strengthens with increasing temporal scale, reflecting the growing influence of evapotranspiration under warming conditions. This study is among the first in India to systematically compare SPI and SPEI across all major arid and semi-arid sub-zones and quantify long-term drought characteristics. The findings provide critical insights for effective drought monitoring, risk assessment, and climate adaptation strategies in vulnerable ecosystems.}
}
@article{ZHANG2026135671,
title = {A prompt-guided differentiable physics model for flood forecasting in data-scarce basins},
journal = {Journal of Hydrology},
volume = {676},
pages = {135671},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135671},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007687},
author = {Jiru Zhang and Jun Feng and Runliang Xia and Pingping Shao and Xin Chi},
keywords = {Prompt learning, Differentiable physics, Flood forecasting, Data-scarce basins, Transformer network},
abstract = {Flood forecasting remains one of the long-standing challenges in hydrology. Most existing approaches, trained on single or limited data-rich basins, struggle to transfer hydrological knowledge to data-scarce ones. Moreover, these models neglect the spatiotemporal heterogeneity of hydrological processes, and lack explicit physical constraints on flood dynamics during training, which limit their physical consistency and predictive accuracy. Therefore, we propose a prompt-guided differentiable physics model (PGDP) for accurate and interpretable flood forecasting in data-scarce basins. Specifically, we introduce a static-temporal (ST) masking strategy for pretraining to capture complex spatiotemporal dynamics. Additionally, we design a dual-path prompting approach to enable robust knowledge transfer and improve generalization in data-scarce catchments. The first path leverages learnable prompts to adaptively retrieve relevant temporal patterns, while the second path introduces supplementary prior knowledge about physical parameter distributions through discrete prompt embeddings. Importantly, the interpretability of the PGDP is established by adding a differentiable physics simulation layer, which integrates the governing equations of the Xin’anjiang model into a differentiable computational graph through end-to-end training. Furthermore, under the guidance of evapotranspiration, runoff smoothness, and water balance principles, we design three loss functions of the proposed model to ensure the predicted results are more consistent with the laws of flood physics. Experiments on the CAMELS dataset demonstrate that PGDP outperforms existing methods in prediction accuracy, especially in data-scarce basins. Compared with benchmark models, it achieves substantial average improvements of 28.43% in NSE and 20.26% in KGE across eight data-scarce basins.}
}
@article{WANG2026135744,
title = {Large-scale evaluation of long-term water conservation capacity dynamics using satellite images},
journal = {Journal of Hydrology},
volume = {676},
pages = {135744},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135744},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008413},
author = {Lei Wang and Yi Yi and Changsen Zhao and Zhongkun Luo and Chunhua He and Yanqing Lian and Guoqing Wang},
keywords = {Water conservation capacity, Driving factors, Spatiotemporal variation, Geographical detectors},
abstract = {Assessing water conservation functions is critical for sustainable water resource utilization under the changing climate. Spatiotemporal variations of water conservation capacity, driven by climate change and human activities, cause regional socio-economic disparities, yet existing methods fail to accurately characterize factor interactions and are limited to single underlying surfaces, reducing global applicability. To address this, this study integrates the Water Conservation Index (WCI) and geographic detector to evaluate 1985–2022 long-term dynamic changes of water conservation capacity and its driving factors in China’s Yellow River Water Conservation Area with complex underlying surface and severe climate change, improving large-scale research reliability. Results show an abrupt 2000 shift in capacity, decline then rise, consistent with climate change; it displays a south-high-north-low pattern, consistent with soil water content (SWC). SWC dominates spatial distribution, followed by EvapoTranspiration (ET), Land Surface Temperature (LST), and Leaf Area Index (LAI) yet precipitation drives SWC. Two-factor interactions between SWC and ET exceed single-factor effects. Post-2000, land use change, urban expansion, and GDP growth boosted Fractional Vegetation Cover (FVC) and thereafter capacity. These findings provide a theoretical and methodological foundation for water conservation protection under complex conditions, and scientific support for water resource allocation and climate change adaptation policies, facilitating global sustainable development.}
}
@article{LIN2026135731,
title = {Occurrence and driving factors of microplastics in the surface water of a grassland river in China},
journal = {Journal of Hydrology},
volume = {676},
pages = {135731},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135731},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008280},
author = {Tong Lin and Zeyuan Liu and Qifeng Liu and Ruihong Yu and Haizhu Hu},
keywords = {Microplastics, Grassland river, Human activity, Hydrological season, Risk assessment},
abstract = {Microplastics (MPs) pollution in rivers has become a global environmental problem, especially in urban areas. The occurrence, drivers and risks of riverine MPs in rural areas remains poorly understood. This study investigated the spatiotemporal distribution, driving factors and ecological risk of MPs in a typical grassland river, Xilin River. Results showed that MPs abundance was significantly higher in the wet and dry seasons compared to the spring flood season. MPs abundance increased from the upper to the lower reaches. The dominant polymer types in the dry and wet seasons were polyethylene terephthalate (PET) and polyamide (PA). In the spring flood season, the proportion of PET decreased significantly, with a concurrent increase in Polyethylene (PE) and acrylate (ACR). Most MPs were pellets with size in 20–50 μm range. The Partial Least Squares Structural Equation Modeling analysis showed that driving mechanisms of MPs abundance varied seasonally. The primary controls on MPs shifted from hydrodynamic conditions in the wet season to river water chemistry in the dry season, with a combination of hydrodynamic conditions and potential sources jointly controlling in the spring flood season. The spatial distribution of riverine MPs was shaped by hydrological forces in the upper reaches versus anthropogenic pressures in the lower reaches. The MPs pollution risk was highest in the densely populated lower reaches and lowest in the upper reaches. MPs risk levels were highest during the wet season and lowest during the spring flood season. This study provides a foundation for understanding and addressing MPs pollution in grassland river ecosystems.}
}
