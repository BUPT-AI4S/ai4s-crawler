@article{JIANG2026135710,
title = {A hydrodynamics-assisted remote sensing method for estimating vertical distribution of total suspended matter in lakes: a case study of Poyang Lake},
journal = {Journal of Hydrology},
volume = {676},
pages = {135710},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135710},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008073},
author = {Hui Jiang and Jiawei Ouyang and Yao Liu and Lingfeng Wan and Yungen Sun},
keywords = {Poyang Lake, Total Suspended Matter (TSM) concentration, Hydrodynamic model, Remote sensing retrieval, Spatial distribution characteristics},
abstract = {Although little is known about the vertical distribution of TSM, knowledge of its submerged profiles is essential for studying sediment dynamics, nutrient/pollutant transfer, water column light attenuation, and lacustrine geomorphological evolution. This study developed and evaluated a novel method to estimate the vertical distribution of TSM in Poyang Lake, China, using remote sensing (Landsat-8/9), field data, and a 3D hydrodynamic model. The approach first identified the most highly correlative/predictive Rrs band ratio to map surface TSM, then incorporated hydrodynamic velocity data into a multilayer regression model to retrieve depth-specific TSM. Results showed that including the hydrodynamic factors significantly improved model accuracy. There were distinct spatial patterns observed between seasons. TSM generally increased with depth with unexpected bottom decreases in the central regions. Key findings include: (1) The hydrodynamics-assisted framework significantly outperformed conventional layer-wise retrieval models. Quantitative error analysis revealed exceptional retrieval accuracy, with the optimal model yielding a maximum coefficient of determination (R2) of 0.9971, alongside a minimal Root Mean Square Error (RMSE) of 1.31 mg/L and a mean relative error (MRE) of 3.36%; (2) During the high-water period (July-August), TSM plane distribution followed Central Lacustrine Zone > North Lower Channel of Poyang Lake > Northeastern Bay, whereas the low-water period (September) exhibited Northeastern Bay > Central Die-shaped Lakes > North Lower Channel of Poyang Lake; (3) Vertical profiles generally increased with depth, showing attenuated stratification in upper layers due to wind-wave effects, while anomalous bottom TSM decreases occurred in central regions during both 2017 and 2024 hydrological extremes, contrasting with stable increasing gradients in the Lower Channel of Poyang Lake. This method systematically reveals the spatial and temporal distribution pattern of TSM concentration in Poyang Lake, which provides a high-precision method to support the remote sensing monitoring of the environment of Poyang Lake, and at the same time provides a theoretical reference for the retrieval study of TSM in the vertical water body of similar shallow lakes.}
}
@article{TAN2026135742,
title = {Improving spatiotemporal assessment of watershed soil redistribution by integrating source-sink theory into a multi-model framework},
journal = {Journal of Hydrology},
volume = {676},
pages = {135742},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135742},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008395},
author = {Rui Tan and Yu Tao and Geng Guo and Kaiwen Huang and Zicheng Liu and Lin Chen and Xin Liu and Jie Lin},
keywords = {Multi-source remote sensing, Soil erosion-deposition, LSU-RUSLE-TLSD framework, Vegetation cover, Driving mechanisms},
abstract = {Understanding the spatiotemporal dynamics of soil redistribution is essential for quantifying watershed-scale soil erosion and regional carbon cycling. Previous research has predominantly emphasized soil detachment from “source” areas, while sediment re-deposition and the regulatory role of non-photosynthetic vegetation (NPV) remain insufficiently accounted for, leading to biased estimates of net erosion fluxes. To address this limitation, this study developed a novel multi-model coupled framework based on Linear Spectral Unmixing (LSU) and geomorphological source-sink theory to quantitatively characterize long-term erosion-transport-deposition dynamics. Within this framework, partial correlation analysis and an XGBoost-SHAP approach were integrated to disentangle the relative importance and interactions of dominant drivers. Simulations based on the Revised Universal Soil Loss Equation (RUSLE) coupled with a Transport Limited Sediment Delivery (TLSD) model (R2 = 0.80) revealed an overall declining yet fluctuating trend in net erosion rates from 1975 to 2023 (63.86-302.64 t·km−2·a−1), with localized rebounds after 2005 driven by climate variability. Incorporating NPV into C-factor estimation improves the representation of vegetation controls and uncovers a unimodal, nonlinear threshold response between vegetation cover and net erosion. A “sensitive erosion transition zone” (16% < fNPV < 27% and 14% < fPV < 32%) is identified, reshaping the linear paradigm linking vegetation cover to erosion. Overall, net erosion dynamics arise from nonlinear interactions among topography, vegetation, climate, and human disturbance. The proposed LSU-RUSLE-TLSD framework grounded in “erosion source” and “deposition sink” theory provides a robust and transferable tool for assessing watershed-scale soil redistribution and its underlying driving mechanisms.}
}
@article{ZHANG2026135726,
title = {A study on a seepage detection method for Concrete Face Rockfill Dams coupling data-driven screening with multiphysics-field validation},
journal = {Journal of Hydrology},
volume = {676},
pages = {135726},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135726},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008231},
author = {Caiyi Zhang and Jie Ren and Ying Li and Shenghao Nan},
keywords = {Concrete Face Rockfill Dam, Leakage detection, Integrated detection method, Data anomaly detection, Multiphysics-field analysis, Pseudo-flow field method},
abstract = {Seepage in Concrete Face Rockfill Dams is typically characterized by strong concealment and discretely distributed flow paths, making it difficult for a single monitoring or detection technique to effectively constrain leakage locations under complex engineering conditions. Therefore, this study proposes a leakage detection method for CFRDs that couples data-driven screening with multiphysics-field validation. First, monitoring data from piezometers and three-dimensional joint meters installed in the dam body are selected, and their statistical features are extracted as inputs. A Density-Based Spatial Clustering of Applications with Noise (DBSCAN) clustering method is then employed to identify anomalous monitoring points, enabling preliminary screening of potential leakage risk zones. Subsequently, the pseudo-flow field method is introduced to analyze the spatial distribution characteristics of electric potential differences, providing further spatial constraints on the screened zones and narrowing the range of potential leakage pathways. Building on this, ink injection experiments are conducted using an underwater robot to perform near-field observations in suspected leakage areas. Image enhancement algorithms are further applied to improve the distinguishability of ink trajectories, assisting in the identification of flow directions of weak leakage and their potential exit locations. Taking the upper reservoir of the WD pumped-storage power station as an engineering case, the results show that the spatial distribution of anomalous monitoring points, high electric potential difference zones identified by the pseudo-flow field analysis, and flow directions revealed by the underwater ink injection experiments exhibit good spatial consistency, allowing the leakage area to be progressively narrowed and located under engineering conditions. The study demonstrates that the proposed method can provide effective technical support for the rapid identification and engineering remediation of leakage hazards in CFRDs.}
}
@article{CHEN2026135621,
title = {Wetlands as a critical water source for local and downwind ecosystems and societies over China through atmospheric moisture transport},
journal = {Journal of Hydrology},
volume = {676},
pages = {135621},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135621},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007183},
author = {Yanhui Chen and Wenhan Pei and Jiping Liu and Xu Lian and Jiangpeng Cui},
keywords = {Wetland, Moisture recycling, Downwind benefits, Wetland conservation},
abstract = {Wetlands, as areas permanently or seasonally water-saturated, provide essential ecosystem services both locally and to surrounding regions. However, their impacts on the societies and ecosystems in remote downwind areas through atmospheric moisture transport are poorly understood. Using atmospheric moisture transport data, satellite observations, and socio-economic statistics, here we find that wetlands exert a widespread impact on local and downwind precipitation via terrestrial moisture recycling, which has the potential to support up to 3.5 × 104 km2 of forest growth, and provide freshwater availability for sustaining a gross domestic product (GDP) of 587.8 billion US dollars (USD) and population of 210.3 million over China. More importantly, these benefits of wetlands are mainly realized in downwind regions. For forest growth, GDP, and population, the downwind regions account for 74.1%, 79.1%, and 89.0% of the total effects, respectively. Furthermore, inland wetlands are the major contributors (including local and downwind effects) to forest growth (61.8%) and GDP (67.2%). In contrast, coastal wetlands exhibit the largest contribution to population livelihoods, which accounts for 54.8% of the total contribution. Our findings highlight the critical downwind benefits of wetlands to ecosystems and societies, which have not been widely recognized by the scientific community and public as an increment to known services of wetlands. Our results also imply these benefits may diminish as wetlands degrade under land use and climate change, indicating the urgency for wetland management and conservation in China.}
}
@article{HAILE2026135718,
title = {Unravelling global patterns of drought-flood alternations},
journal = {Journal of Hydrology},
volume = {676},
pages = {135718},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135718},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008152},
author = {Gebremedhin Gebremeskel Haile and Md Sariful Islam and Qiuhong Tang and Danielle Wood},
keywords = {Drought, Flood, Drought to flood, Flood to drought, Abrupt alternation},
abstract = {Droughts and floods are among the most damaging climate extremes, yet their abrupt alternations, rapid shifts from one to the other, remain poorly understood on a global scale. This study presents a comprehensive spatiotemporal analysis of abrupt drought-to-flood (DTF) and flood-to-drought (FTD) alternations worldwide from 1981 to 2023. Results show that these events are frequent, spatially widespread, and often occur concurrently with increasing levels of abrupt transitions in both directions. Regions with increasing FTD and DTF trends include the Yangtze Basin, Eastern India, Pakistan, and Southeast Africa, while California, Southern Africa, and Emilia-Romagna show declining trends, with California exhibiting a statistically significant decrease in FTD events (p < 0.1). In Southern Africa, the FTD coverage peaked at 5.5% in 1990, then declined to 4.6% in 2016. Emilia-Romagna (Italy) demonstrated greater temporal variability, with FTD areas rising from 7% in 1982 to 11% in 2005, before falling to 9% by 2022. DTF events were most frequent in Southern Africa (7.06 DTFs in 43 years) and Emilia-Romagna (7.13), while FTD events were highest in the Mississippi (8.73) and Yangtze (6.86) basins. Conversely, Eastern India and California exhibited consistently low frequencies of both DTF and FTD. These spatial disparities underscore the complex and region-specific dynamics of hydroclimatic extremes. Improved understanding of drought-flood alternations is essential for strengthening early warning systems, risk management, and adaptation strategies in vulnerable regions worldwide.}
}
@article{AGNESE2026135665,
title = {Analysis of the dependence of daily rainfall depth on wet spell duration across Europe},
journal = {Journal of Hydrology},
volume = {676},
pages = {135665},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135665},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007626},
author = {Carmelo Agnese and Giorgio Baiamonte and Carmelo Cammalleri and Elvira Di Nardo and Stefano Ferraris and Tommaso Martini},
keywords = {Polylog distribution, Rainfall statistical modelling, Time series, Conditioned rainfall depths},
abstract = {The statistical modelling of daily rainfall depth is commonly carried out independently from the rainfall occurrence process (dry/wet alternation). In this study, we investigate the effects of accounting for the dependence between rainfall depth (h) and wet spell duration (ws) using rain gauge data collected on 34 sites across Europe between 1971 and 2016. For each site, a set of conditioned h|ws sub-datasets was generated, and the two-parameter Polylog distribution was fitted on these sub-datasets. The results of the fittings highlight a good capability of the Polylog distribution to capture the statistical behavior of h|ws, as well as the presence of statistically significant differences in the various h|ws fittings obtained in some of the sites. This dependence has been quantified as “Weak” in about 13 sites (38%), and “Strong” in 9 sites (26%). The h|ws dependence was directly modelled for each site with a logarithmic function, showing how this approach is able to well reproduce the arithmetic and geometric means of the sub-samples (standard estimate errors of 0.62 and 0.42 mm, respectively). An attempt at explaining the spatial variability of the dependence through a penalized regression highlighted some key factors, such as longitude and distance from the shoreline; however, the selected features only partially explained the variability and the connection to climate factors. Overall, this research introduces a simple procedure to directly account for the h|ws dependence, which can provide a more robust modelling of the rainfall processes, as well as an improved understanding of the rainfall generating processes.}
}
@article{QIN2026135689,
title = {Microbial carbon pump promotes refractory organic carbon accumulation in karst waters: Coupled responses of bacterial communities and dissolved organic matter under thermal stratification},
journal = {Journal of Hydrology},
volume = {676},
pages = {135689},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135689},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007869},
author = {Jia Qin and Xinlu Su and Yikun Jia and Peng Chen and Qiufang He and Wen Lai and Tao Zhang and Jianhong Li and Junbing Pu},
keywords = {Dissolved organic matter, Microbial carbon pump, Refractory dissolved organic carbon, Thermal stratification, Karst carbon sink},
abstract = {Inland waters are vital to the global carbon cycle, yet bacterial-driven carbon sequestration in karst aquatic systems with intense carbonate weathering and high dissolved inorganic carbon (DIC) concentrations remains unclear. This study examines a typical karst reservoir in southwestern China, combining seasonal field sampling and in situ microbial incubation experiments to investigate the bacterial-driven transformation of dissolved organic carbon (DOC) into refractory dissolved organic carbon (RDOC) in karst waters. The results show that thermal stratification creates vertically heterogeneous microenvironments, significantly influencing dissolved organic matter (DOM) composition and bacterial community structure. Bacteria–DOM coupling varies across layers, with the thermocline serving as a key zone for DOM transformation. During the strong thermal stratification (STS) period, RDOC conversion efficiency is approximately 2.6 times higher than during the isothermal mixing (IM) and early thermal stratification (ETS) periods. Overall, thermal stratification regulates microhabitats and bacterial community structure, while high DIC concentrations enhance carbon substrate supply; together, these factors promote the activity of the microbial carbon pump (MCP) in karst waters. This study reveals the potential for RDOC accumulation in karst aquatic systems and confirms their role as an important microbially driven “hidden carbon sink”.}
}
@article{ZHANG2026135657,
title = {Coupled controls of river stage dynamics and vegetation evapotranspiration on the retention of dissolved organic carbon in the riparian zone},
journal = {Journal of Hydrology},
volume = {676},
pages = {135657},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135657},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007547},
author = {Zhibo Zhang and Shaolin Yang and Chaomeng Dai and Zhi Li},
keywords = {Riparian zone, Numerical modelling, Solute transport, Evapotranspiration},
abstract = {Riparian zones serve as crucial transitional zones linking terrestrial and aquatic ecosystems. Their intense hydrological exchange processes render them significant hotspots for biogeochemical cycling. However, the combined influence of hydraulic forcing induced by river stage fluctuations and ecological regulation driven by vegetation evapotranspiration on the migration of externally sourced dissolved organic carbon (DOC) remains insufficiently understood. This study developed a coupled numerical model simulating the movement of soil water and solute transport under variable saturation conditions. A vertical two-dimensional simulation domain was established based on China’s Jianghan Plain. Multiple numerical scenarios were designed with different river stage amplitudes ranging from 0 to 1.5 m and leaf area index scaling coefficients (LAIsc) ranging from 0 to 1.5. The model systematically analysed the interactive effects governing riparian DOC exchange fluxes, their spatiotemporal distribution, and enrichment processes. The results showed that river stage fluctuations acted as the primary physical driver controlling the strength of external solute inputs. In contrast, vegetation cover primarily reshaped internal solute distribution by altering the hydrodynamic field. The hydraulic pump effect generated by vegetation transpiration, coupled with in situ evaporation and concentration processes, jointly drove the active accumulation of solutes from deep pore water towards the root zone. The temporal analysis revealed a pronounced counterclockwise hysteresis in the response of DOC transport to hydraulic gradients. This pattern indicated that vegetation evapotranspiration effectively retained high solute concentrations during the recession phase of river stage fluctuations. Moreover, the fitted results from the Generalized Additive Model (GAM) indicate that a nonlinear threshold in soil hydraulic properties constrains the enhancing effect of vegetation on solute enrichment. At low cover levels, increased vegetation significantly boosts enrichment efficiency. However, when leaf area index (LAI) exceeds the threshold of 4.5, the partial effect actually shows a declining trend. In summary, this study clarifies the physical mechanisms of solute transport in riparian zones, explaining its shift from hydraulic-driven input to vegetation-controlled retention. These findings provide a scientific basis for managing riparian carbon sinks through optimized vegetation and hydrologic regulation.}
}
@article{HUANG2026135693,
title = {Crop spatial concentration enhances water productivity while threatening regional agricultural water sustainability},
journal = {Journal of Hydrology},
volume = {676},
pages = {135693},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135693},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007900},
author = {Hongrong Huang and Qiangqiang Rong and Yiping Wu and Yulei Xie and Wei Wang and Xiangxiang Ji and Zenghui Xu and Jie Gao and Meirong Su and La Zhuo},
keywords = {Agricultural land use, Spatial shift, Water planetary boundary, Regional sustainability, Food–water nexus},
abstract = {Crop production is increasingly concentrated in fewer regions, but whether this spatial concentration improves water productivity at the expense of regional agricultural water sustainability remains unclear. Here, we investigate this efficiency–sustainability trade-off for rice, wheat, and maize production in China from 2000 to 2021. We integrated AquaCrop simulations with water footprint accounting, a production concentration index, planetary-boundary-based sustainability assessment, and panel quantile regression to quantify crop concentration and its heterogeneous effects on water productivity and regional agricultural water sustainability. Results showed that the spatial concentration indices of rice, wheat, and maize increased by 8.0%, 17.6% and 9.8%, respectively, between 2000 and 2021. Increasing crop concentration improved water productivity but reduced regional agricultural water sustainability, revealing a clear trade-off. The trade-off was strongest for wheat: each 1% increase in the spatial concentration of wheat production enhanced water productivity by 0.38% but reduced regional agricultural water sustainability by 0.74%. This pronounced wheat trade-off reflects the increasing concentration of wheat production in groundwater-dependent northern regions, where peak irrigation demand coincides with limited precipitation. These findings suggest that crop concentration policies should move beyond productivity-oriented evaluation and more explicitly incorporate regional water constraints to reconcile water productivity gains with long-term agricultural water sustainability.}
}
@article{CHEN2026135684,
title = {Groundwater pumping alters land-sourced solute transport in tide-controlled coastal aquifers},
journal = {Journal of Hydrology},
volume = {676},
pages = {135684},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135684},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600781X},
author = {Qian Chen and Haixia Shui and Chengji Shen and Jiaxu Zhang and Chunhui Lu},
keywords = {Land-sourced solute transport, Groundwater pumping, Tides, Upper saline plume, Unconfined coastal aquifers},
abstract = {The increasing proliferation of pumping wells worldwide and the existence of tidal aquifers necessitate a systematic understanding of how groundwater pumping and tides would jointly influence the fate of land-sourced solute in unconfined coastal aquifers. This study numerically addresses the research gap by considering a land-sourced conservative solute plume in a 2-D-cross-shore unconfined coastal aquifer. The results demonstrate that groundwater pumping significantly alters the land-sourced solute transport trajectory and causes the plume sucked into the well, forming a cusp-shaped cone. Meanwhile, pumping greatly modifies the solute dispersion pattern from unimodal to bimodal, reduces the maximum dispersion area and prolongs the residual time of solute plume in the aquifer. Furthermore, pumping concentrates the solute efflux in a narrower zone and shifts the position of maximum solute efflux from the low-tide mark to a lower position. The sensitivity analysis highlights that solute dispersion is strongly influenced by the pumping rate and well location, while the vertical distance between the well and solute source affects significantly solute retention. These findings provide mechanistic insights into complex solute transport in pumped tidal aquifers and support sustainable management of coastal groundwater resources.}
}
@article{HONG2026135673,
title = {Sediment hysteresis loop variability in watersheds during rainfall-runoff erosion: effects of internal watershed controls revealed by process-based modeling},
journal = {Journal of Hydrology},
volume = {676},
pages = {135673},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135673},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007705},
author = {Seonghyeon Hong and Soyoung Kim and Dae-Hong Kim},
keywords = {Soil erosion, Hysteresis loop, Particle size distribution, Rainfall characteristics},
abstract = {Sediment hysteresis loops are widely employed to interpret watershed erosion responses; however, their high variability between events has raised concerns about their reliability as consistent indicators. This study investigates the physical mechanisms controlling hysteresis loop variability using process-based numerical simulations conducted under idealized conditions. Key watershed and hydrological factors, including particle size distribution (PSD), microtopographic features, raindrop impact, and rainfall duration, were systematically varied to isolate their individual and combined effects on sediment dynamics. The simulations demonstrated that, even when discharge hysteresis at the watershed outlet remained consistent, sediment responses diverged substantially depending on internal watershed characteristics. Loop steepness was primarily governed by surface particle size and PSD: fine particles, with higher erodibility and lower settling velocities, generated steeper loops, whereas surface coarsening, driven by selective transport, reduced fine particle availability and flattened the loops. Rotational direction was determined by detachment mechanisms and sediment availability: intense raindrop impact triggered rapid initial mobilization, producing clockwise loops, whereas the absence of raindrop impact promoted overland flow-driven detachment, resulting in positive transport lags and counterclockwise loops. Loop width displayed a clear power-law relationship with the product of the loop gradient and the degree of surface coarsening indices, indicating that these metrics jointly capture the integrated effects of rainfall, soil properties, and microtopography and can infer in-watershed coarsening from outlet signals. Overall, this study provides a process-based, quantitatively supported interpretation of how key hydrological and geomorphological drivers shape the slope, rotation, and width of sediment hysteresis loops under shallow overland-flow conditions.}
}
@article{LIU2026135697,
title = {Unveiling urban process-dependent hydrological responses via rainfall “fingerprints”},
journal = {Journal of Hydrology},
volume = {676},
pages = {135697},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135697},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007948},
author = {Ting Liu and Lina Yuan and Yuying Li and Zijiang Song and Linlin Ye and Ao Xu and Tsering Namgyal and Chao Li and Min Liu},
keywords = {Rainfall fingerprints, Rainfall process archetypes, Urban hydrology, Machine learning},
abstract = {Characterizing rainfall variability is essential for hydrometeorological analysis and building flood-resilient cities. However, progress is hindered by an incomplete grasp of rainfall heterogeneity, ambiguous links to hydrological impacts, and a lack of tools for systematically and operationally identifying event-scale rainfall processes. Here, we analyze 23 years of hourly rainfall observations from 61 gauges in Shanghai and introduce an integrated machine learning methodology combining unsupervised and supervised learning to: (1) extract reproducible spatiotemporal rainfall “fingerprints,” hydrologically meaningful event-scale rainfall process archetypes, (2) validate their hydrological responses, and (3) build an automated fingerprint classifier. A pronounced west–east contrast in fingerprint diversity emerges across the city, with more homogenized fingerprints in highly urbanized sectors. Fingerprints also display strong spatiotemporal heterogeneity in rainfall process evolution, forming station-specific archetypes that are internally coherent yet indistinguishable by rainfall intensity or accumulation alone. Hydrological analysis reveals an asymmetric relationship between rainfall fingerprints and hydrological response: peak water level is primarily associated with cumulative rainfall and duration, whereas the rising rate is more sensitive to peak intensity. Identical fingerprints can produce different responses, while distinct fingerprints may yield similar responses under varying boundary conditions. The proposed classifier achieves >80% accuracy in identifying the rainfall fingerprints of unseen events at over 50 stations, supporting the potential for automated rainfall process type recognition. The methodology established here not only deepens understanding of urban rainfall but also provides a scientific and technical foundation for site-adaptive, process-informed urban flood governance.}
}
@article{WEI2026135706,
title = {Physics-informed gated transformer for robust flash flood forecasting in data-scarce small catchments via variance-constrained learning},
journal = {Journal of Hydrology},
volume = {676},
pages = {135706},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135706},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008036},
author = {Siqi Wei and Xiekang Wang},
keywords = {Flash flood forecasting, Physics-informed deep learning, Explainable AI (XAI), Gated Residual Network (GRN), Variance-constrained loss, Spatial generalizability},
abstract = {Accurate operational flash flood forecasting in small, data-scarce catchments remains a persistent challenge due to sparse monitoring networks, severe spatial scale mismatches, and highly noisy input data. This study proposes a Physics-Informed Gated Transformer with Variance-Constrained Learning. In contrast to hard-constrained Physics-Informed Neural Networks, this framework utilizes hydrological mechanisms as soft inductive biases. First, it integrates a causally-strict, leakage-free baseflow separation and saturation-excess effective rainfall to physically constrain the solution space. Second, a Gated Residual Network is deployed to dynamically filter high-frequency noise from multi-source inputs. Third, a variance-constrained multi-step loss function is mathematically formulated to explicitly penalize the attenuation of flood peaks. Application in the highly flashy Guanshan River Basin demonstrates that the proposed architecture achieves competitive forecasting accuracy at a 1-hour lead time, effectively mitigating systemic phase-lag and performing favorably against strictly recalibrated baselines including HBV (NSE = −0.044) and standard LSTM (NSE = 0.315). The GRN preserves stable predictive accuracy even under 80% synthetic noise injection. Furthermore, Explainable AI attribution via Gradient SHAP empirically indicates that the network handles spatial scale mismatch by deploying coarse ERA5 data primarily as an antecedent moisture “macro-state proxy”. Finally, zero-shot spatial generalization testing on twelve climatically-matched small forested basins drawn from the CAMELS-US dataset shows that the proposed architecture maintains performance comparable to two state-of-the-art large-sample benchmarks and significantly outperforms a Vanilla Transformer counterpart. These findings highlight that coupling soft physical inductive biases with gated architectures offers a transferable, physics-constrained framework for operational early warning in poorly gauged catchments.}
}
@article{LI2026135758,
title = {Quantitatively linking karst groundwater quality to hierarchical recharge via uncertainty-aware Bayesian coupling},
journal = {Journal of Hydrology},
volume = {676},
pages = {135758},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135758},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008553},
author = {Changsuo Li and Zhenjie Zhang and Xiancang Wu and Tao Hu and Shasha Wu and Shuai Gao and Chunwei Liu and Bin Sun and Jiutan Liu and Rui Liu},
keywords = {Hierarchical recharge, Tracer optimization, Bayesian mixing, Entropy-weighted water quality index},
abstract = {Groundwater recharge and water quality in heterogeneous karst systems are difficult to quantify because recharge sources mix along connected flow paths and tracer-based apportionment is uncertain. This study investigated the Baotu Spring karst system in Jinan, China, and developed an integrated workflow that links recharge composition to groundwater quality while propagating uncertainty. Stable isotopes (δ18O, δ2H) and hydrochemistry were first used to characterize recharge and water–rock interaction. A multi-criterion tracer screening framework combining Kruskal–Wallis testing, linear discriminant analysis, random forest importance, and Boruta confirmation identified a parsimonious tracer set of Na, Cl, and d-excess. These tracers constrained a hierarchical Bayesian mixing model (simmr) to estimate source contributions with sample-specific posterior credible intervals. Results reveal distinct hierarchical recharge patterns. The indirect recharge area receives mixed inputs from precipitation, metamorphic margins, and surface-water losses. In contrast, the direct recharge area is dominated by routed inflow from the indirect zone. The discharge area integrates multiple components and is dominated by the direct recharge contribution, and the overlying Quaternary aquifer is mainly sustained by exchange with the discharge-zone karst groundwater. Groundwater quality assessed by the entropy-weighted water quality index (EWQI) is generally excellent to good but shows localized hotspots, with dominant controlling parameters varying by hydrogeological setting. To link recharge and quality, we employed posterior-propagated Bayesian regressions. This approach explicitly transfers mixing uncertainty into the assessment. The regressions reveal a robust positive association between EWQI and direct recharge in the discharge area. Additionally, Quaternary water quality is highly sensitive to the balance between karst-water exchange and precipitation dilution. The proposed framework provides transferable, uncertainty-aware evidence for targeting recharge resource and discharge-zone management in karst spring basins.}
}
@article{ZHAI2026135669,
title = {Precise waterbody mapping at the city scale using a novel connectivity preservation and boundary refinement network based on medium-resolution remote sensing imagery},
journal = {Journal of Hydrology},
volume = {676},
pages = {135669},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135669},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007663},
author = {Han Zhai and Ziyu Liu and Yiran Kuang and Yiming Xiao},
keywords = {City waterbody mapping, Connectivity preservation, Boundary refinement, Dense dynamic snake convolution module, High-frequency multiscale feature fusion module},
abstract = {Waterbody mapping has always been a research hotspot, with utmost significance in water resource management. Although deep learning approaches have achieved remarkable accomplishments, most of them are designed for high-resolution images, with limited adaptability to the city scale, and suffered from serious misjudgments, frequent breakages, and rough morphologies in complex scenarios. To overcome these obstacles, this paper proposes an innovative connectivity preservation and boundary refinement network (CB-Net), to precisely delineate waterbodies at the city scale using medium-resolution remote sensing images, which explicitly focuses on geometrical characteristic mining of waterbodies. Specifically, with regard to frequent breakages and rough morphologies, an effective dense dynamic snake convolution module is developed, to deeply learn felicitous geometrical features for various waterbodies and aggregate hierarchical expressions to preserve connectivity, which enables continuous and detailed waterbody extraction. In addition, to improve boundary localization and morphology expressivity, a valid high-frequency multiscale feature fusion module is designed as skip connections, to learn multidirectional high-frequency information and leverage multiscale directional expressions to generate structure-and-position-aware features, thus facilitating fine-grained segmentations. A challenging waterbody dataset based on Sentinel-2 images (S2-Water) is constructed for performance validation, which compensates for the scarcity of specialized datasets and advances future researches. Extensive experimental results illustrate that CB-Net significantly outperformed the other state-of-the-art alternatives to yield promising results for Wuhan City and Jinan City, indicating its good adaptability and generalizability to various waterbodies in complex scenarios. Generally, CB-Net achieved a mean F1-sore of 88.69% and IoU (Intersection over union) of 79.79%, which well satisfies applicational requirements.}
}
@article{XU2026135730,
title = {Dynamic capillary effects in layered porous media: dependence on flow direction and displacement front stability},
journal = {Journal of Hydrology},
volume = {676},
pages = {135730},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135730},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008279},
author = {Xinang Xu and Yajuan Zhuang and Dingjiang Chen and Lingzao Zeng},
keywords = {Dynamic capillary effect, Flow directionality, Layered porous media, Multiphase flow, Microfluidics},
abstract = {Conventional static equilibrium models do not fully capture the coupling among transient interfacial dynamics, fluid viscosity, and pore-scale heterogeneity, which complicates the quantification of dynamic capillary effects and the identification of an appropriate quasi-static reference. To address these issues, we conducted microfluidic drainage experiments in oil-wet layered porous media and evaluated the use of interfacial-area-weighted capillary pressure as a quasi-static interfacial capillary reference. The non-equilibrium deviation was interpreted within a pressure-work-density framework and used to quantify the dynamic capillary coefficient τ. The results reveal a systematic directional dependence of the dynamic response: under favorable viscosity-ratio conditions, coarse-to-fine (CTF) displacement exhibits stronger non-equilibrium behavior, with τ values 30% to 175% higher than those in fine-to-coarse (FTC) displacement. This contrast suggests that structural constraints associated with the coarse–fine transition can outweigh interfacial-area effects under stable displacement conditions. We further show that displacement-front stability modulates how layered heterogeneity is expressed: stable fronts preserve the influence of permeability gradients, whereas unstable viscous fingering tends to mask directional characteristics associated with pore-scale asymmetry. Overall, these findings indicate that the dynamic coefficient depends not only on fluid properties and saturation, but also on flow directionality and pore structure, which has implications for developing predictive models that reduce upscaling bias in layered aquifers and remediation flushing.}
}
@article{CAI2026135661,
title = {Evaluating precipitation forecasts from the TIGGE via fuzzy mathematics from the perspective of hydrological research},
journal = {Journal of Hydrology},
volume = {676},
pages = {135661},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135661},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007584},
author = {Chenkai Cai and Jing Wang and Yingjie Zhao and Helong Wang and Jianqun Wang and Xinyi Shen},
keywords = {Precipitation forecast, Fuzzymathematics, Accuracy evaluation, TIGGE},
abstract = {Three rates are traditionally employed when evaluating precipitation forecasts, i.e., hit rate, miss alarm rate and false alarm rate. These indicators are influenced by the selection of artificial classification standards, wherein unreasonable standards can yield performance over- or underestimation. To overcome this deficiency, three new general indicators, namely, three fuzzy rates, were developed through fuzzy mathematics theory. Three practical examples based on an artificially designed dataset, control forecasts of six global weather centers, global satellite precipitation products and ground-based station data from Zhejiang Province, China, were designed to examine the effects of the three fuzzy rates. The results revealed that these fuzzy rates not only outperform the three traditional rates by distinguishing between precipitation over- and underestimation but are also unaffected by the classification standard. Evaluations of precipitation forecasts from the six centers on the basis of satellite products and station data from global and regional scales indicated that the precipitation forecasts of no single center are always superior to those of the other centers. Moreover, the three traditional rates caused significant underestimation of the precipitation forecast performance. Furthermore, the precipitation forecast performance tended to decrease as the lead time and magnitude increased. In conclusion, the three fuzzy rates are effective indicators for evaluating precipitation forecasts and provide a reference for hydrological forecasting or reservoir regulation. Notably, the membership function of the three fuzzy rates may significantly affect the evaluation results, which may warrant flexible selection depending on the purpose.}
}
@article{PEEPLIWAL2026135734,
title = {When heat meets drought: understanding the rising persistence of compound dry-hot extremes through Markov-Chain analysis},
journal = {Journal of Hydrology},
volume = {676},
pages = {135734},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135734},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008310},
author = {Vikash Peepliwal and Somil Swarnkar and Abhinav Wadhwa and Radheshyam Sharma and Ashish Sharma},
keywords = {Compound extremes, Drought, Heatwaves, Markov chain, Rajasthan},
abstract = {Understanding the dynamics of compound dry-hot extremes (CDHEs) is critical for climate risk assessment in semi-arid regions. This study over the state of Rajasthan in India investigates the evolution of rainfall deficits (defined by the 30th percentile precipitation threshold, P30) and temperature extremes (defined by the 70th percentile temperature threshold, T70), and their co-occurrence over six decades (1960–2024) using regridded district-level TerraClimate reanalysis data. Extreme thresholds were identified through percentile-based indices, and both frequency and persistence of events were analyzed. A first-order Markov chain framework developed based on exiting methodology was further applied to estimate stationary and transition probabilities, providing insights into long-term likelihoods and state-to-state shifts of compound extremes. Results show a fundamental spatio-temporal shift in extremes. Long-duration rainfall deficits that previously dominated the eastern and south-eastern regions have declined and are replaced by shorter but more frequent P30 events. Simultaneously, T70 events have increased sharply in frequency and persistence across the state, leading to more common co-occurrence of CDHE conditions. The early 2000s marked a peak in CDHE frequency and mean duration, particularly across central, south-western, and south-eastern Rajasthan. Stationary probabilities confirm that rainfall-only droughts since the 2000s occur infrequently, while heat-only and compound CDHE states persisted for all study period (1960–2024). Transition probabilities further indicate that both rainfall deficits and heat extremes have a high likelihood of evolving into compound states, with strong persistence once compounding begins. These findings highlight that Rajasthan’s climate is moving into a regime defined by frequent and intensified compound extremes. The shift poses adverse implications on agriculture, water resources, and livelihoods, underscoring the urgent need for designing integrated monitoring and adaptation strategies for similar semi-arid regions across the globe to address concurrent rainfall variability and rising temperatures.}
}
@article{SHENG2026135701,
title = {Paleo-hydrological controls on continental-shelf groundwater salinity distribution offshore New Jersey, USA},
journal = {Journal of Hydrology},
volume = {676},
pages = {135701},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135701},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007985},
author = {Chong Sheng and Christian Hensen and Ariel T. Thomas and Thomas Müller and Mark Schmidt},
keywords = {Offshore relatively fresh groundwater, Paleo-hydrogeological model, Aquifer heterogeneity, Continental shelf, Sea level change},
abstract = {Continental shelves host extensive offshore relatively fresh groundwater (ORFG) systems whose origin, distribution, and persistence are strongly influenced by paleo sea-level fluctuations; however, the paleo-hydrological controls governing their present-day salinity patterns remain poorly constrained. Here, we investigate the ORFG system offshore New Jersey, USA, by integrating high-resolution seismic profiles, borehole constraints, geochemical and isotopic data, and three-dimensional variable-density groundwater flow and solute transport modeling. Model results indicate that most ORFG was emplaced by topographically driven groundwater flow during sea-level lowstands over the past ∼ 100 kyr. During Pleistocene lowstands, enhanced hydraulic gradients across the exposed continental shelf promoted widespread seaward groundwater flow, leading to the development of low-salinity groundwater over large areas. Subsequent marine transgression led to partial salinization through diffusive and density-driven mixing with seawater. Our results further demonstrate that cyclical flushing and re-salinification of shelf sediments over glacial–interglacial timescales are inherently asymmetric, favoring the long-term retention of freshened groundwater. Compared with conventional layered modeling approaches, the incorporation of depth-migrated seismic stratigraphy and geostatistical property modeling substantially improves the characterization of ORFG spatial heterogeneity and volume distribution. However, these results are based on a single representative geostatistical realization and therefore do not explicitly quantify stochastic uncertainty. Overall, this study highlights the long-term legacy of paleo-hydrological conditions on continental-shelf groundwater systems and provides a process-based perspective for interpreting ORFG occurrence, evolution, and vulnerability along passive continental margins.}
}
@article{LI2026135685,
title = {A flow-direction guided spatiotemporal graph neural network (FD-STGNN) framework for multi-source soil moisture data fusion over the Qinghai-Tibet Plateau},
journal = {Journal of Hydrology},
volume = {676},
pages = {135685},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135685},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007821},
author = {Xinghao Li and Qinli Yang and Junran Yang and Junming Shao},
keywords = {Soil moisture, Multi-source data fusion, Qinghai-Tibet Plateau, Flow-directed graph neural network, Spatiotemporalmodeling, Physics-guided},
abstract = {Accurate soil moisture estimation over the Qinghai-Tibet Plateau (QTP) remains challenging due to complex terrain and climate conditions, and the limited reliability of individual data products. To address this issue, we propose a Flow-Direction Guided Spatiotemporal Graph Neural Network (FD-STGNN) framework for multi-source soil moisture data fusion, integrating in situ observations (ISMN), satellite retrievals (AMSR2), and auxiliary variables. The proposed framework explicitly incorporates terrain-induced flow direction as a physical prior to construct a directed graph, where 0.1° grid cells serve as nodes and hydrological connectivity defines edges. A hybrid architecture combining CNN, LSTM and Graph Attention Network (GAT) is employed to capture spatial features, temporal dynamics, and upstream–downstream dependencies, respectively. Spatial five-fold cross-validation over the QTP shows that compared with the original AMSR2 data, the fused product substantially improves consistency with in situ observations, increasing correlation coefficient (CC) from 0.52 to 0.82, reducing RMSE from 0.128 to 0.063 m3/m3 (a reduction of 51%) and ubRMSE from 0.089 to 0.044 m3/m3. It outperforms the conventional deep learning (CNN-LSTM) and existing GNN-based models (STGCN, GCN-LSTM). In addition, a daily soil moisture dataset at 0.05° resolution is generated for the period 2012–2019, with reduced systematic overestimation across the QTP. These results demonstrate the effectiveness of incorporating flow direction constraints into graph-based frameworks for improving soil moisture estimation in complex terrains.}
}
@article{JI2026135725,
title = {Adaptive spatio-temporal fusion network for high-frequency water quality forecasting},
journal = {Journal of Hydrology},
volume = {676},
pages = {135725},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135725},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600822X},
author = {Ruikang Ji and Zhixian Chen and Jiahao Yan and Xiangqi Bai and Chiwentao Zhang and Jie Chen},
keywords = {Water quality, Spatiotemporal forecasting, Multi-horizon prediction, Graph neural network, High-frequency monitoring, Gated fusion},
abstract = {High-frequency water quality forecasting is essential for operational early warning and refined water-environment management. However, it remains challenging due to pronounced nonlinearity and non-stationarity, multi-scale temporal variability, cross-indicator heterogeneity, and event-driven disturbances. In this study, an adaptive spatio-temporal fusion network (STFusionNet) is proposed for high-frequency multi-indicator forecasting using 4-hourly automatic monitoring records from a dense lake-basin network (96 stations) spanning from June 17, 2021 to February 14, 2025. The forecasting task is structured as multi-horizon prediction with a 7-day historical input window (42 steps) and lead times of 12, 24, 48, 120, and 168 h. STFusionNet combines a geographic k-nearest-neighbor graph (k = 6) with Gaussian distance weighting (σ = 20 km) and a learnable adaptive adjacency matrix to capture spatial dependencies. The model employs parallel temporal encoders to extract complementary representations, and adopts a gated fusion mechanism to dynamically aggregate multi-scale temporal features for joint forecasting of six key indicators. Comprehensive experiments benchmark STFusionNet against representative baselines, including convolutional neural network (CNN), temporal convolutional network (TCN), long short-term memory (LSTM), iTransformer, patch time series transformer (PatchTST), spatio-temporal graph convolutional network (STGCN), and diffusion convolutional recurrent neural network (DCRNN), using evaluation metrics such as Nash–Sutcliffe efficiency, root mean square error, and mean absolute error. Results indicate that STFusionNet consistently achieves superior predictive performance across indicators and forecasting horizons, with representative time-series evaluations showing Nash–Sutcliffe efficiency values of 0.91 for conductivity, 0.90 for total phosphorus, and 0.91 for permanganate index, demonstrating robust improvements over conventional temporal, Transformer-based, and graph-based spatio-temporal baselines. The proposed framework thus provides accurate and reliable support for real-time water quality monitoring and risk-informed management.}
}
@article{XIAO2026135677,
title = {Land use and rainfall drive riverine DOM source dynamics: Insights from spectroscopic and stable carbon isotope analyses},
journal = {Journal of Hydrology},
volume = {676},
pages = {135677},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135677},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007742},
author = {Lunjing Xiao and Zhenzhen Jia and Kaiheng Guo and Yingjie Cao and Jiatang Hu},
keywords = {Dissolved organic matter (DOM), Land-use pattern, Rainfall, End-member mixing analysis (EMMA), Coupling effect},
abstract = {Land use and rainfall are key drivers of dissolved organic matter (DOM) dynamics in rivers, yet their coupling effects on DOM sources in heterogeneous urbanized watersheds remain unclear. Here we combine fluorescence spectroscopy and stable carbon isotopes within end-member mixing analysis (EMMA) framework to trace DOM sources along the Guangzhou reach of the Pearl River under contrasting land use and rainfall conditions. The optimized three-dimensional subregional EMMA model (BIX–HIX–δ13C-DOC) substantially outperformed two-dimensional and whole-watershed alternatives, reducing prediction error by 45–50%. Upstream agricultural areas were dominated by soil-derived, humic-rich DOM, whereas midstream and downstream urbanized reaches showed greater wastewater contributions and microbial characteristics. Rainfall increases DOM loads across all zones but variably alters source composition depending on land use. The strongest coupling effect occurs in the midstream agricultural–urban transition zone, where rainfall enhances the surface soil input but decreases the wastewater contribution. By comparison, downstream reaches show minimal source shifts after rainfall, reflecting buffering by continuous wastewater inputs. This study evaluates land use-rainfall interactions on DOM sources, and provides an optimized subregional EMMA approach for DOM source apportionment in tropical and subtropical urban rivers.}
}
@article{YUAN2026135709,
title = {Quantitative study on multiphase flow displacement processes of water-LNAPL-gas influenced by groundwater table fluctuations},
journal = {Journal of Hydrology},
volume = {676},
pages = {135709},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135709},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008061},
author = {Zhijiang Yuan and Xiaosi Su and Chao Wang and Hang Lyu and Weihong Dong and Xiaofang Shen and Ningfei Li and Haiting Liang and Yazhi Song},
keywords = {Multiphaseflowdisplacement, Groundwater table fluctuation, Light transmission visualization technique, Machinelearningalgorithm, LNAPL migration patterns, VGM model},
abstract = {Large-scale petroleum spills pose a serious environmental hazard, inducing profound contamination risks to groundwater and soil. Nevertheless, the mechanisms governing the redistribution of light non-aqueous phase liquids (LNAPLs) derived from petroleum spills within the groundwater table fluctuation (GTF) zone remain poorly understood. Although light transmission visualization (LTV) technique has been used to quantify fluid saturations in three-phase systems, existing methods suffer from limited precision and spatial resolution. This study improved the inversion model of water-LNAPL-gas saturations based on the LTV technique by incorporating machine learning algorithms. Subsequently, the optimized LTV technique was used to investigate fluid redistribution under dripping and smearing patterns in a porous-media-packed flow chamber. The optimized inversion model achieved a mean absolute error of 0.08–0.12% for water-LNAPL-gas saturations. Under both patterns, when the GTF-induced pressure gradient reached the critical entry pressure, suction and piston effects triggered multiphase fluid migration, and the displacement process followed the van Genuchten-Mualem model. During GTF, the maximum LNAPL relative permeabilities under the dripping and smearing patterns were 0.027 and 0.076 at the monitored layers, respectively, while groundwater table rise reduced the LNAPL relative permeability to below 0.002 under both patterns. Controlled jointly by migration pattern and relative permeability, 67.2% of the released LNAPL under the dripping pattern and 99.6% under the smearing pattern were retained within the GTF zone, creating a long-term contamination risk for groundwater. Collectively, these findings provide critical insights into LNAPL fate under dynamic GTF and inform the design of precise remediation strategies for LNAPL-contaminated sites.}
}
@article{RAI2026135652,
title = {Volumetric analysis of a playa lake using SWOT data: An improved understanding of the inflows to Kati Thanda-Lake Eyre},
journal = {Journal of Hydrology},
volume = {676},
pages = {135652},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135652},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007493},
author = {Atul Kumar Rai and Timothy J. Cohen and Moshe Armon and Samuel K. Marx},
keywords = {SWOT, Arid basin, Volume, Water level},
abstract = {Kati Thanda–Lake Eyre (KT-LE) is the largest terminal lake in Australia and the fourth largest worldwide. It is fed by the Lake Eyre Basin (LEB), the country’s largest internal drainage system. The LEB covers nearly one-seventh of the landmass area of Australia. The lake serves as a focal point for receiving inflow from tributary channels, making it pivotal in understanding the water balance in the drylands of the country, particularly amidst climate change. Unfortunately, due to its remoteness and vast size, no comprehensive water storage monitoring is available. However, the recent launch of the Surface Water and Ocean Topography (SWOT) satellite offers a promising solution for water monitoring in areas with limited in situ data at a 21-day frequency, with very high accuracy. In this study, we applied a method to estimate direct water storage from SWOT data, integrated with Sentinel-3 data, achieving an high level of precision. The method was applied to the 2024 filling event of Kati-Thanda to quantify event-scale water storage changes (surface area: 910 km2; maximum depth: 1.42 m and volume: 0.82 km3). The derived water depth and surface water extent exhibited satisfactory performance, showing strong agreement with both optical satellite masks (Landsat 8 and Sentinel-2) and ICESat-2 height measurements. The overall mean absolute percentage error (MAPE) for surface water extent was 15.1% for Landsat 8 and 14.4% for Sentinel-2. The estimated water depth demonstrated high precision, with a root mean square error (RMSE) of 0.30 m and a MAPE below 20% when compared with ICESat-2 data. Inherent limitations, such as bathymetry quality, sample size, and inundation coverage, were identified. Overall, the proposed method demonstrates its feasibility for monitoring direct water storage in KT-LE. This method has the potential for use in monitoring lake storage in other ungauged playa lakes and assessing long-term variability with similar climatic and terrain challenges.}
}
@article{CASTELLINI2026135717,
title = {Effects on infiltration of different wetting methods: an investigation through two-stage beerkan runs in a conventionally tilled and a no-tilled loam soil},
journal = {Journal of Hydrology},
volume = {676},
pages = {135717},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135717},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008140},
author = {Mirko Castellini and Dario Autovino and Vincenzo Bagarello and Alessia Flammini and Massimo Iovino and Renato Morbidelli},
keywords = {No-tillage, Conventional tillage, Multi-heightbeerkan method, Surface hydrological processes, Gravitational potential energy},
abstract = {Soil water infiltration implies wetting of the porous medium but the manner in which the soil is wetted can vary. The multi-height beerkan (MHB) infiltration experiment allows investigating in the field the soil hydrodynamic behavior by distinguishing between wetting and water mechanical impact effects on infiltration rate, ir. In this investigation, the MHB method with three heights of water pouring (low, L ≈ 0.03 m; intermediate, M = 1.0 m; high, H = 2.0 m) was applied to evaluate wetting alone (L) and wetting plus water impact (M and H) effects on ir. Two-stage MHB runs without interruption (LL, ML and HL) were performed and the effects on ir were evaluated for both a conventionally tilled (CT) and a no-tilled (NT) loam soil. Infiltration rates were consistently higher in the NT soil than the CT soil (on average, 533 mm/h against 230 mm/h), regardless of whether infiltration was established by wetting alone or by wetting combined with water mechanical impact, probably due to a higher presence of relatively large and water stable aggregates under undisturbed soil conditions. An initial wetting with some water mechanical disturbance at the soil surface made the subsequent classical beerkan infiltration run more stable, especially in CT soil, and slower than that established in a wetted soil without intentional disturbance. Infiltration rates appeared not to depend much on the manner in which water was applied for large values of the overall dissipated gravitational potential energy. In conclusion, for a given soil, the water impact effects on the soil surface vary with soil management and the MHB method appears suitable for capturing these effects under hydrologically relevant field conditions.}
}
@article{WANG2026135683,
title = {Neural operator-based multi-objective optimization for spatiotemporal data-informed seepage parameter identification: a case study on deep overburden in a dam foundation},
journal = {Journal of Hydrology},
volume = {676},
pages = {135683},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135683},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007808},
author = {Libo Wang and Weijun Cen and Bo Liu and Jiahao Qian and Changhai Zheng},
keywords = {Seepage parameter identification, Multi-objective coati optimization algorithm, Deep operator network, Weighting strategy, Spatiotemporal monitoring data, Deep overburden},
abstract = {Accurate identification of seepage parameters for deep overburden in dam foundations is critical for reliable seepage analysis and safety evaluation. Conventional identification approaches remain constrained by single-time-point conditions, incomplete spatial coverage of engineering information, and two-dimensional domains, which may result in biased parameter estimates. This study proposes a spatiotemporal data-informed seepage parameter identification framework that integrates a deep operator network (DeepONet) surrogate with an improved multi-objective coati optimization algorithm (IMOCOA). Time-varying water levels and spatially distributed (left bank, riverbed, and right bank) monitoring data from multiple seepage-pressure points are fused into a unified multi-objective formulation. DeepONet is conditioned on physics-informed spatial descriptors, enabling operator learning of the mapping from seepage parameters to spatiotemporal pressure responses, and achieving high prediction fidelity (R2 = 0.994–0.999). The optimization efficiency of IMOCOA is enhanced by the Sobol initialization, dynamic β-η learning, and ε-dominance-based truncation, achieving a low inverted generational distance (0.109) and a high hypervolume (0.539). A reliability-informed weighting strategy considering engineering preference is proposed to extract a representative compromise solution from Pareto alternatives. The framework is validated on a rockfill dam founded on deep overburden with a thickness of 148 m, and the identified parameters reproduce observed seepage-pressure evolution and yield physically consistent seepage behavior. Comparative analyses demonstrate that the framework achieves higher computational efficiency and robustness for seepage parameter identification by explicitly integrating domain-specific physical information, demonstrating its potential for broader application in complex geotechnical and hydraulic engineering problems.}
}
@article{HUANG2026135667,
title = {Integrating hydraulic processes and graph neural networks for event-scale river morphodynamics},
journal = {Journal of Hydrology},
volume = {676},
pages = {135667},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135667},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600764X},
author = {Pin-Chun Huang},
keywords = {Channel morphology, Dynamic morphodynamic interactions, Floodplain evolution, Spatio-temporal graph neural network (ST-GNN)},
abstract = {Riverbank erosion is a fundamental process shaping channel morphology, sediment dynamics, and floodplain evolution, yet its prediction remains challenging due to the nonlinear interplay between hydraulic forcing, sediment transport, and geotechnical resistance. Traditional physics-based models grounded in the shallow water equations and the Exner sediment continuity equation provide mechanistic insights but are computationally intensive and sensitive to parameter uncertainties. Conversely, machine learning methods offer rapid and accurate predictions but often lack physical interpretability and generalization. This study introduces a novel spatio-temporal graph neural network (ST-GNN) with a GRU backbone, designed to capture directed hydraulic connectivity and dynamic morphodynamic interactions across a river network. The framework of this research is developed as a surrogate model trained on high-fidelity labels derived from a validated hydromorphodynamic model that explicitly incorporates toe scour, excess-slope failure, and toe-transport mechanisms. This approach enables the ST-GNN to emulate complex morphodynamic responses with high computational efficiency and accuracy, providing a reliable approximation of process-based simulations. The key innovation of this work lies in leveraging a physics-guided graph topology to represent hydraulic connectivity within a machine learning framework. Results demonstrate that the model effectively captures reach-consistent spatio-temporal patterns of bed and bank adjustments. This approach contributes to the predictive science of river morphodynamics by establishing a high-fidelity surrogate that maintains physical consistency while overcoming the computational bottlenecks of traditional numerical solvers.}
}
@article{LIU2026135688,
title = {Tracing hydrological connectivity in a coastal salt marsh during intertidal exposure using stable isotopes},
journal = {Journal of Hydrology},
volume = {676},
pages = {135688},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135688},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007857},
author = {Yue Liu and Zibo Yu and Junhong Bai and Weixiang Ren and Jichen Qiu and Yongkang Zhao},
keywords = {Hydrological connectivity index, Stable isotope, Spatiotemporal variations, Tidal flat exposure periods, Intertidal zone},
abstract = {Hydrological connectivity is considered a key mechanism that governs wetland ecosystem functions. However, accurately quantifying hydrological connectivity during intertidal flat exposure periods remains a significant methodological challenge. Here, we developed a stable isotope-based hydrological connectivity index (HCIH and HCIO) using stable water isotopes (δ2H and δ18O) as tracers. This method simplifies the complexity associated with the conventional hydrological connectivity index (HCI) established based on multiparameter datasets and provides a more precise quantification of hydrological connectivity during the tidal flat exposure phase. The results revealed significant spatial heterogeneity and seasonal variability in both HCIH and HCIO in low-, middle- and high- marsh zones (p < 0.01). Specifically, the HCIH and HCIO values ranged from −1.46 to −0.07 and from −1.93 to −0.07, respectively, whereas the conventional HCI values varied from −2.9 to 2.8. The HCI was highest in summer in the intertidal zone, and the greatest spatial variation in HCI values occurred in the intertidal zone in winter. Regression analysis demonstrated that HCIH (excluding spring data) was more strongly correlated with the conventional HCI (R2 > 0.6) than HCIO, suggesting that HCIH may serve as a more reliable index for hydrological connectivity in the study area. Water source partitioning revealed that precipitation and seawater were the dominant sources in the middle- and low-marsh zones, whereas the high-marsh zones featured four water sources, including precipitation, seawater, groundwater, and river water. IsoSource analysis effectively resolved source ambiguity and improved the accuracy of the HCI (R2 > 0.7). These findings suggest a practical and accurate tool for quantifying hydrological connectivity dynamics during tidal flat exposure, contributing to the optimization of tidal creek networks in coastal wetland hydrological restoration practices.}
}
@article{WANG2026135733,
title = {Composite copula adaptive metropolis for joint parameter estimation in hydrological models},
journal = {Journal of Hydrology},
volume = {676},
pages = {135733},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135733},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008309},
author = {Feng Wang and Guohe Huang and Yurui Fan and Yongping Li and Zhenyao Shen and Ya Zhou},
keywords = {Copula, Bayesian Inference, Metropolis Algorithm, Uncertainty Quantification, Hydrological Simulation},
abstract = {Hydrological modeling is subject to significant uncertainties arising from complex parameter interactions and dynamic processes. Parameter calibration involving interacting variables remains a persistent challenge, often leading to low sampling efficiency, particularly in high-dimensional spaces with strong parameter dependence. To address this issue, this study proposes a composite copula Bayesian-inferred hydrological model (CBIH). Specifically, a hybrid copula-based adaptive Metropolis algorithm (HCopAM) is developed by combining a copula-based Metropolis–Hastings scheme (CopMH) with adaptive Metropolis (AM), improving sampling efficiency while reducing sample concentration. The method is evaluated using two benchmark distributions, one synthetic case, and two real-world hydrological simulations. Results indicat that, compared with AM and differential evolution adaptive Metropolis (DREAM), the copula-based algorithms improve the acceptance rate, increase the number of effective samples, and reduce the autocorrelation of markov chain due to sampling based on joint probability density. Relative to CopMH, the HCopAM further improves sampling efficiency and reduces sample concentration in high-dimensional settings. In hydrological applications, HCopAM accurately identifies parameter values and significantly enhances simulation performance. For example, during HYMOD validation in the Ruihe Watershed, the Nash–Sutcliffe efficiency increases from 0.264 (AM) to 0.804 (HCopAM), while the root mean square error decreases from 6.726 to 3.410 (m3/s). These improvements highlight the importance of capturing parameter interdependence for reliable uncertainty quantification. The Sensitivity analysis indicates that the hybrid proportion strongly influences performance of HCopAM, reflecting a trade-off between sampling efficiency and posterior accuracy; a CopMH proportion greater than 0.5 is not recommended. Overall, this study provides an effective extension of copula-based Bayesian inference and offers a scalable approach for posterior estimation in complex hydrological models.}
}
@article{LI2026135753,
title = {Hydrologically driven apparent photosynthetic aging effect in karst aquatic ecosystems and its implications for aquatic carbon cycling},
journal = {Journal of Hydrology},
volume = {676},
pages = {135753},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135753},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008504},
author = {Dong Li and Hailong Zhang and Zaihua Liu and Min Zhao and Qian Bao and Meixun Zhao},
keywords = {Photosynthetic aging, Old carbon, δC–ΔC, Karst aquatic ecosystems, Hydrological control},
abstract = {Land use changes alter water–rock interactions and residence times by modifying soil CO2 production and infiltration, thereby affecting the karst groundwater 14C age of dissolved inorganic carbon (DIC). Through a controlled experiment with different land-use types (bare rock, bare soil, cropland, grassland, shrubland) at a karst simulated test site in SW China, we measured the δ13C and Δ14C of DIC, aquatic plants, particulate organic carbon (POC), dissolved organic carbon (DOC), and sediments. Groundwater DIC Δ14C ranged from –284‰ (bare soil) to –106‰ (grassland), corresponding to14C ages of ∼900–2400 years before present. The 14C isotopic composition of all other measured carbon also showed an old signature, ranging from –100 to –300‰. Aquatic plant Δ14C showed a near 1:1 correlation with DIC Δ14C (r2 = 0.96), demonstrating the direct transfer of aged DIC into autochthonous organic matter (Auto-OM)—a phenomenon we term the “apparent photosynthetic aging effect”. Quantitative modeling showed that incorporation of this aged Auto-OM shifts bulk POC Δ14C by –48% to + 51% and DOC Δ14C by –982% to 0% relative to global median values. For sediment14C dating, using aquatic materials yields ages ∼ 800–2800 years older than the true ages. A quantitative hydrological framework linking land use → recharge → DIC age → photosynthetic aging → biogeochemical impacts is established. We conclude that the apparent photosynthetic aging effect is a hydrologically driven process that fundamentally alters the radiocarbon baseline of karst aquatic ecosystems, with significant implications for carbon source tracing, food web studies, and sediment dating.}
}
@article{LI2026135756,
title = {Seepage evolution in loess driven by freeze-thaw cycling: a multiscale investigation},
journal = {Journal of Hydrology},
volume = {676},
pages = {135756},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135756},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600853X},
author = {Xi-An Li and Yajun Yang and Jinshuan Chen and Weiping Wang},
keywords = {Freeze-thaw cycles, Loess, Numerical simulation, Porous media hydraulics, Microstructure},
abstract = {The Loess Plateau, a region characterized by ecological fragility and geohazard susceptibility, is increasingly affected by intensified freeze–thaw cycling and shifting precipitation patterns driven by climate change, which significantly altering the regional soil–water environment and escalating disaster risks. Elucidating the hydraulic response of loess, a representative porous medium, under freeze–thaw cycling is crucial for predicting its structural response and seepage evolution in seasonal frozen soil regions. In this study, the effects of freeze–thaw cycles on seepage behavior were systematically investigated using laboratory permeability tests, scanning electron microscopy (SEM), and particle flow code (PFC) numerical simulations. Results indicate that during the initial freeze–thaw stage (0–3 cycles), the permeability growth rate (η) peaked at 275 %, whereas it approached zero in the later stages (11–15 cycles). The freeze–thaw sensitivity coefficient (SFT) peaked at 1.0 after 11 cycles and subsequently decreased to 0.78 after 15 cycles. Both η and SFT increased and decreased with increasing dry density, with the peak points shifting toward higher initial dry density. Microscopic analysis revealed that the freeze–thaw cycles increased damage to the pore structure, increasing the porosity growth rate from 9 % to 25.7 %. Numerical simulations demonstrated that the freeze–thaw cycles increased the number of particles with large displacements and led to an exponential decline in the average number of contact bonds. Following the freeze–thaw cycles, particle displacement increased exponentially with seepage frequency. The growth rate of minimum displacement was slightly higher than that of maximum displacement, and total displacement increased with seepage pressure and frequency. This study provides new insights into how freeze–thaw cycles alter the hydraulic properties of porous media, providing a theoretical reference for disaster prevention and engineering construction in seasonal frozen soil regions.}
}
@article{SHEN2026135696,
title = {Four decades of dissolved organic carbon dynamics in Lake Taihu using comprehensive Landsat-5/7/8 observations and advanced machine learning models with investigation on driving factors},
journal = {Journal of Hydrology},
volume = {676},
pages = {135696},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135696},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007936},
author = {Feilong Shen and Jifeng Li and Tianwei Wang and Nian Li and Jiawei Yang and Mengyang Xu and Yange Yan and Linhuan He and Yulong Guo and Zhongbing Chen},
keywords = {Carbon storage, Dissolved organic carbon, Driving factors, Lake Taihu, Landsat, Machine learning},
abstract = {Dissolved organic carbon (DOC) plays a crucial role in lake carbon cycling, yet its long-term variations and key drivers remain poorly understood, particularly in large eutrophic lakes. Using 40 years of Landsat data and four machine learning (ML) models, we reconstructed DOC concentration (DOCc) and storage (DOCs) in Lake Taihu for the whole lake (T0) and six open-water zones: Gonghu Bay (T1), Meiliang Bay (T2), Zhushan Bay (T3), Central Lake (T4), Northwest Lake (T5), and Southwest Lake (T6). The XGBoost model achieved high accuracy (validation: R2 = 0.73, RMSE = 0.51 mg/L, MAPE = 8.66%, RPD = 1.70), revealing spatiotemporal DOC variability (2.49–6.36 mg/L). DOCc peaked at 4.90 mg/L in 1996 and declined after 2000, with lower levels in several zones after 2010. Lake-wide DOCs showed interannual variability and a slight decrease, peaking at 16,906 t C in 2010 and showing a linear trend of −138.51 t C/decade. Regional differences highlight strong hydrodynamic flushing in T6 (−106.63 t C/decade), while localized increases in T1 and T5 may reflect nutrient-driven productivity and sedimentary carbon accumulation. Meteorological factors were the strongest direct controls on DOCc (−0.72) and DOCs (−0.98), exceeding human-activity proxies and other driver groups. These results highlight the potential of combining remote sensing with ML to provide a spatially explicit, long-term baseline for DOC monitoring and attribution in large optically complex lakes, thereby improving understanding of lake carbon dynamics under anthropogenic pressures and climate change.}
}
@article{LIU2026135668,
title = {Error-replaced recurrent randomized-based ensemble algorithm for water level prediction},
journal = {Journal of Hydrology},
volume = {676},
pages = {135668},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135668},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007651},
author = {Zongying Liu and Wenru Zhang and Mingyang Pan and Chu Kiong Loo and Dong Chen},
keywords = {Random ensemble structure, Randomization-based model, Error-replaced recurrent algorithm, Water level prediction},
abstract = {With the rapid development of inland waterways and coastal management, accurate water level prediction has become increasingly important. Reliable forecasting of water levels is essential for flood mitigation, water resource management, and the operation of inland waterways and ports. However, challenges remain due to algorithmic limitations and the complex dynamics of natural water systems. This study introduces a novel algorithm, the Error-Replaced Recurrent Random Ensemble Algorithm (ER-REA), designed to enhance both accuracy and stability in water level prediction. The proposed method constructs a randomized ensemble architecture and incorporates an error-replaced recurrent mechanism that dynamically updates the output weights at each forecasting step, thereby mitigating error accumulation in multi-step prediction. The performance of ER-REA is evaluated against several baseline models, including Extreme Learning Machine, Echo State Network, and AdaBoost Extreme Learning Machine, across seven real-world water level datasets. Experimental results demonstrate that ER-REA consistently achieves superior predictive accuracy and stability across multiple forecasting horizons, reducing average error by 37.06% compared with the best-performing baseline model. Comparisons with conventional machine learning and deep learning models further demonstrate the competitiveness of ER-REA. In summary, the proposed model provides a reliable tool for water level prediction, contributing to improved flood risk mitigation and sustainable port operations.}
}
@article{ZHOU2026135708,
title = {Identifying driving factors of lacustrine groundwater discharge in Lake Taihu with integrated surface-subsurface numerical modeling},
journal = {Journal of Hydrology},
volume = {676},
pages = {135708},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135708},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600805X},
author = {Hao Zhou and Yadong Shi and Yue Zou and Ya Jiang and Na Zheng and Subin Cheng and Donghao Wu and Xin Luo and Chaomeng Dai and Juntao Zheng and Zhi Li},
keywords = {Lacustrine groundwater discharge, Integrated surface-subsurface modeling, Lake taihu, SERGHEI, Wind-induced oscillations},
abstract = {Lacustrine groundwater discharge (LGD) is a critical but often overlooked pathway for nutrient loading in eutrophic lakes. Accurate quantification of LGD and its spatiotemporal distribution patterns remains challenging. This study employs SERGHEI (Simulation Environment for Geomorphology, Hydrodynamics, and Ecohydrology in Integrated form), a high-performance, fully coupled surface–subsurface hydrodynamic model, to quantify LGD and investigate its driving mechanisms in Lake Taihu, China. The model integrates complex bathymetry, dynamic groundwater levels, river inflow/outflow and atmospheric forcing to simulate lake–groundwater interactions. The simulation results reveal strong spatial heterogeneity in lake-groundwater exchange fluxes. LGD is dominant along lake shorelines adjacent to mountainous terrain, driven primarily by lake-groundwater hydraulic gradients, whereas the lake interior exhibits weaker exchange modulated by wind-induced free-surface oscillations. Neglecting wind forcing in the model resulted in an underestimation of LGD by approximately 10%, underscoring the importance of surface water dynamics in LGD estimation. The simulated LGD fluxes were 1–2 orders of magnitude lower than previous isotope-based estimates, a discrepancy attributed to the model’s coarse representation of aquifer hydraulic properties (e.g., the potential neglect of fracture flow and other preferential pathways) and the potential overestimation inherent in steady-state isotope models. Sensitivity analyses further demonstrate that simulated LGD rates are highly sensitive to subsurface hydraulic conductivity. These findings highlight the necessity of synergistic approaches combining integrated hydrodynamic modeling with detailed hydrogeological characterization to resolve complex lake–groundwater interactions.}
}
@article{HUANG2026135729,
title = {Prediction of solute transport in three-dimensional rough-walled rock fractures: The role of geometrical heterogeneities},
journal = {Journal of Hydrology},
volume = {676},
pages = {135729},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135729},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008267},
author = {Na Huang and Zhenhui Wang and Yujing Jiang and Ju Wang and Bo Li},
keywords = {Rock fracture, Solute transport, Geometrical heterogeneity, Predictive model, BTC},
abstract = {Predicting solute transport in rough-walled rock fractures remains challenging due to geometric complexities. This study develops a direct predictive framework for solute transport in rock fractures by explicitly incorporating geometric heterogeneities characterized by relative standard deviation (RSD) of the local mechanical aperture and the contact area ratio (cr), under laminar flow conditions. We conducted a series of experimentally validated numerical simulations of solute transport in 3D rough-walled fractures with different apertures and contact areas. The resulting breakthrough curves (BTCs) were inversely analyzed by the classical advection dispersion equation (ADE). The fitted transport coefficients (transport velocity and hydrodynamic dispersion coefficient) were normalized against the smooth parallel-plate model, and subsequently parameterized in terms of RSD and cr. A semi-empirical analytical model is proposed that integrates these parameterized relationships into a modified ADE framework. The model enables direct prediction of solute transport based on measurable geometric parameters, without the need to resolve the velocity and concentration fields. It adaptively degenerates to the classical analytical solution for a smooth parallel-plate model when the geometric heterogeneity diminishes. Validation against fracture samples from prior experiments shows that the proposed model achieves high accuracy.}
}
@article{CHENG2026135781,
title = {Advancing drought monitoring with a three-dimensional feature space framework},
journal = {Journal of Hydrology},
volume = {676},
pages = {135781},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135781},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008784},
author = {Minghan Cheng and Zhangxin Liu and Jingwen Sun and Linyu Wang and Zhengxian Zhang and Xiuliang Jin and Chengming Sun},
keywords = {Drought monitoring, Feature space, Dry/wet limits, Domain size, Spatial ambiguity},
abstract = {Accurate agricultural drought monitoring is fundamental to effective management strategies. Feature space methods have proven robust and are extensively utilized in this domain. To address lingering uncertainties—specifically the nonlinear characteristics of dry/wet limits, the influence of spatial domain size, and the scalability of three-dimensional feature spaces—this study developed and compared the land-air temperature difference (dT)-NDVI space and the LST-NDVI-NSAT space. Utilizing remotely sensed land surface temperature (LST), NDVI, and near-surface air temperature (NSAT), we evaluated the performance of the Temperature Vegetation Dryness Index (TVDI) and the Three-dimensional Drought Index (TDDI). The findings demonstrate that: (1) Nonlinear (quadratic) functions provide a superior fit for the dry/wet limits, with the three-dimensional configuration achieving higher precision; (2) The LST-NDVI-NSAT space stabilizes when the domain size encompasses a sufficient range of hydrothermal extremes, yielding highly consistent TDDI values; (3) TDDI exhibits a significant correlation with soil moisture content (SMC), which is further amplified under drought conditions. Compared to TVDI, VHI, and NDVI, TDDI more accurately delineates the temporal evolution of drought. Consequently, this study provides a reliable and transferable quantitative framework for drought monitoring and offers novel insights into feature space-based methodologies.}
}
@article{ZHEN2026135692,
title = {Driving pathways and spatial heterogeneity of dissolved inorganic carbon (DIC) and organic carbon (DOC) in the Lijiang River Basin},
journal = {Journal of Hydrology},
volume = {676},
pages = {135692},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135692},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007894},
author = {Yan Zhen and Xin Liu and Haodong Zheng and Qiong Xiao and Xiang Zeng and Xiaowei Liu and Yantao Deng},
keywords = {Dissolved inorganic carbon, Dissolved organic carbon, Structural equation modeling, Rock desertification, Machine learning},
abstract = {Karst riverine carbon export is jointly regulated by climate, topography, and ecological degradation/restoration. Clarifying the dominant controls on dissolved inorganic carbon (DIC) and dissolved organic carbon (DOC) across different section types, together with their underlying pathways, is essential for diagnosing watershed carbon processes and evaluating ecological restoration outcomes. Taking the Lijiang River Basin as a case study, this study integrates XGBoost–SHAP analysis with multi-group structural equation modeling (SEM) to disentangle the driver assemblages, directional responses, and direct–indirect effect chains governing DIC and DOC in three spatial groups of sampling sections: main-channel control sections, confluence-affected sections, and tributary sections. The results show that both DIC and DOC differ significantly among section types. XGBoost–SHAP analysis indicates that the key controls on DIC are primarily characterized by the joint constraint of topographic background and carbonate-weathering-derived solute signals, whereas the explanatory factors for DOC are relatively consistent across section types, being mainly regulated by external inputs and redox conditions. Multi-group SEM further reveals that DIC is produced predominantly through carbonate weathering. The influence of rocky desertification on DIC is exerted mainly indirectly, through alterations in carbonate weathering intensity and watershed solute supply, thereby generating section-dependent differences: its overall effect is suppressive in the main-channel and confluence-affected sections, but it can be promotive in tributary sections. DOC, by contrast, is chiefly controlled by the combined enhancement of allochthonous organic/solute inputs and intensified oxygen-consuming decomposition, and the direction of rocky desertification effects on DOC also varies among section types. These findings reveal the differential control mechanisms and spatial heterogeneity of DIC and DOC in karst watersheds, and provide a quantitative basis for section-specific carbon-process diagnosis and carbon export assessment under ecological management and restoration.}
}
