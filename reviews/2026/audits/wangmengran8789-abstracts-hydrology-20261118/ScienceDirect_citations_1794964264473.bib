@article{CHEN2026135682,
title = {Influences of hydrology and anthropogenic activities on source and quality of dissolved organic matter in karst headwater streams},
journal = {Journal of Hydrology},
volume = {676},
pages = {135682},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135682},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007791},
author = {Shiqin Chen and Y.Jun Xu and Pan Wu and Xingxing Cao and Guangxi Long and Zhangxing Liu},
keywords = {Dissolved organic matter, Source and quality of DOM, Domestic wastewater, Land use/land cover, Headwater streams, Karst region},
abstract = {Dissolved organic matter (DOM) plays an essential role in regulating water quality and biogeochemical processes in aquatic ecosystems. However, how hydrological variability interacts with anthropogenic disturbance to shape DOM dynamics in karst headwater rivers — particularly under wastewater inputs — remains poorly understood. In this study, we investigated the sources and composition of DOM in three headwater streams draining an urban-dominated, an agriculture-dominated, and a forest-dominated catchment, all located in one of the world’s most significant karst regions in Southwest China. Field sampling and measurements were conducted during a dry-cool season and a wet-warm season. Our results reveal that hydrology is the primary driver of DOM source and composition, with runoff and in-stream production dominating during the wet-warm season, and longer water residence time promoting microbial processing during the dry-cool season. Superimposed on these seasonal patterns are clear spatial differences linked to land use/land cover (LULC) types and human activities. The stream draining the agriculture-dominated catchment exhibited a predominance of terrestrial DOM inputs, whereas streams in the urban-dominated and forest-dominated catchments showed evidence of higher microbial activity. Wastewater significantly reshapes DOM composition: treated effluents remove labile protein-like components, while untreated sewage enhances nutrient-driven in-stream production and increases the abundance of humic and terrestrial DOM. Collectively, these findings demonstrate that DOM dynamics in karst headwater streams are jointly regulated by hydrological variability and LULC types, offering new insights into anthropogenic impacts on carbon biogeochemistry in karst aquatic systems.}
}
@article{ZHANG2026135703,
title = {Modelling the spatial mismatch of nutrient sources and exports: A case study of Baiyangdian Basin, North China},
journal = {Journal of Hydrology},
volume = {676},
pages = {135703},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135703},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008000},
author = {Yali Zhang and Qiangang Feng and Chunxue Yu and Zhihao Xu},
keywords = {Nutrient transport, Spatial mismatch, Source-export dynamics, Non-point sources, SPARROW model},
abstract = {Understanding how the spatial configuration of nutrient sources and exports regulates watershed nutrient delivery is critical for effective water quality management. However, nutrient load-based analyses often lack explicit metrics to quantify source-export mismatch, and thereby hindering targeted prioritization of interventions. We applied the SPAtially Referenced Regression On Watershed attributes (SPARROW) model over 2000–2020 to simulate nutrient generation, routing, and delivery in Baiyangdian Basin, China. The calibrated model explained 88% and 75% of spatial variability in total nitrogen (TN) and total phosphorus (TP) loads, respectively. Prior to 2015, TN and TP loads fluctuated around 400 t·yr−1 and 58 t·yr−1, respectively. Then the Ten-Point Water Plan implemented post-2015 reduced TN and TP loads by 43% and 38%, leading to decreases in in-lake nutrients concentration from 6 mg·L−1 to 3 mg·L−1 for TN and from 0.45 mg·L−1 to 0.30 mg·L−1 for TP. On average, point sources (PS) contributed nearly 70% of TN, but made comparable contributions to TP as non-point sources (NPS). Over time, the contribution of NPS increased from 28% to 40% for TN and from 52% to 61% for TP. We introduced a spatial mismatch index to quantify source-export divergences, revealing that 37.35% of sub-basins exhibited mismatches. High-input/low-export mismatches are concentrated in the central and southern plains where dense drainage ditches and sluggish flows enhance long-term average nutrient retention effect. Conversely, low-input/high-export mismatches prevail in the northern mountainous regions dominated by runoff-driven export. Temporal mismatches tracked the PS-NPS shift, with low-input/high-export areas expanding in response to increasing NPS loads. Our findings provide empirical evidence to guide differentiated watershed nutrient governance prioritization.}
}
@article{QIU2026135722,
title = {Parametrization and improvement of the soil evaporation estimation model: Coupling superposition based on fractional canopy cover and soil moisture},
journal = {Journal of Hydrology},
volume = {676},
pages = {135722},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135722},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600819X},
author = {Xuefeng Qiu and Xiaoyang Liang and Hang Wang and Jiandong Wang and Guoli Li and Lei Zhang and Hao Zhang and Dingtian Zhou and Xurong Mei},
keywords = {Drip irrigation, Soil evaporation model, Fractional canopy cover, Soil moisture, Model parametrization improvement},
abstract = {Estimating soil evaporation (Es) is crucial to accurately regulate the composition of crop water consumption and optimize regional agricultural water use strategies. However, its nonlinear characteristics pose challenges for accurately estimating Es. Focusing on shallow subsurface drip irrigation (SSDI) and surface drip irrigation (DI), this study, within a reference Es modeling framework, pursues two objectives: (i) replace leaf area index (LAI) with fractional canopy cover (fc) to represent attenuation of surface net radiation (Rns), and (ii) incorporate soil water content (θ) and the surface wetted fraction (P) to develop a unified Es model applicable to both SSDI and DI. Plot-scale experiments show that fc can substitute for LAI in computing the dynamics of Rns; a model using an fc-based parameterization energy term together with a vapor-pressure-deficit (VPD) term achieved R2 = 0.71. With θ and P further included, the unified model yielded R2 = 0.73 and RMSE < 0.33 in validation. We provided an Es model with high prediction accuracy by parameterizing Rns and employing multi-parameter coupling superposition. The key parameters (fc, θ) can be efficiently and rapidly acquired using agricultural informatization techniques, such as drones and sensors. Consequently, this study holds substantial scientific significance and practical value for rapidly and accurately determining regional water-consumption structures and scientifically guiding irrigation water scheduling.}
}
@article{QIU2026135711,
title = {Physical ventilation failure drives rapid reservoir hypoxia during heatwaves},
journal = {Journal of Hydrology},
volume = {676},
pages = {135711},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135711},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008085},
author = {Siqian Qiu and Lianghong Long and Hui Xu and Zhongyong Yang and Yufen Ren and Yubo Huang and Daobin Ji},
keywords = {Hypoxia, Reservoir, Stratification, Heatwave},
abstract = {Climate warming is accelerating deoxygenation in stratified reservoirs, yet distinguishing whether rapid hypoxia stems from enhanced biological consumption or suppressed physical ventilation remains a challenge. This uncertainty hinders effective mitigation during extreme weather events. Here, we combined spatial surveys with high-frequency time series in the Pengxi River (Three Gorges Reservoir) to disentangle these competing mechanisms during a rapid deoxygenation event, where hypoxia covered ∼74% of the water column within 11 days. Quantitative attribution revealed that oxygen-supply reduction dominated the hypoxia (68%–72%), whereas oxygen-demand increase played a secondary role (28%–32%). This physical control was further validated by a tight quantitative coupling, where each unit relaxation in maximum buoyancy frequency (N2_max) drove a ∼3.8 mg/L rebound in bottom-water DO (ΔDO = 3.79 × ΔN2_max − 0.19, R2 = 0.87). Mechanistically, the heatwave imposed a “dual-lock” on bottom water: (i) surface heating intensified the thermocline, effectively shutting down vertical mixing; and (ii) thermal buoyancy altered inflow trajectories, diverting oxygen-rich water from plunging currents to surface interflows, thereby starving the hypolimnion of replenishment. The results explain why intense thermal events trigger rapid deoxygenation and suggest that monitoring physical stability, rather than just water quality, is critical for forecasting. The partitioning approach is transferable to stratified reservoirs, supporting risk-based management under a warming climate.}
}
@article{XIE2026135694,
title = {A two-layer safe reinforcement learning framework for multi-constraint reservoir operation: Integrating action masking and lagrangian dual method},
journal = {Journal of Hydrology},
volume = {676},
pages = {135694},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135694},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007912},
author = {Zaichao Xie and Xiaoli Zhang and Wei Xu and Guoguo Lin and Dong Li and Shuncai Zhang and Hongyan Chen and Sheng Yang},
keywords = {Reservoir operation, Safe reinforcement learning, Lagrangian dual method, Action masking, Non-linear action mapping, Three gorges reservoir},
abstract = {Reservoir operation is a safety-critical sequential decision problem that must balance multiple operational objectives under strict water-level and release constraints. However, Deep Reinforcement Learning (DRL) algorithms frequently violate safety constraints during exploration, limiting their applicability in real-world engineering. This study proposes a two-layer Safe Reinforcement Learning (SafeRL) framework. The first layer is a state-driven action mask that filters infeasible actions before policy sampling; the second layer is a Proximal Policy Optimization (PPO)-Lagrangian implementation that adaptively adjusts the constraint multiplier to balance safety and performance. Unlike single-mechanism approaches that rely solely on post-hoc correction or fixed penalties, this design combines proactive filtering with adaptive optimization. Additionally, a non-linear action mapping is introduced to improve learning efficiency in constraint-critical regions. The framework is validated on the Three Gorges Reservoir using 60 years (1965–2024) of daily inflow records. Results show that the Lagrangian dual method reduces the total absolute constraint cost by 71.5% and increases generation reward by 4.9% compared with the correction-based baseline. In the baseline evaluation, the FullMask reduces the action-correction violation rate from 21–79% to zero, and the square mapping yields a further 0.54% gain in total energy generation. These results support the proposed SafeRL framework as a model-consistent decision-support approach for long-horizon reservoir operation under the modeled constraints.}
}
@article{OMER2026135755,
title = {Climate-driven hydrological shifts generate nutrient-mobilization hotspots in northern catchments: Evidence from the Vantaanjoki, Finland},
journal = {Journal of Hydrology},
volume = {676},
pages = {135755},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135755},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008528},
author = {Abubaker Omer and Joy Bhattacharjee and Kati Anttila and Eliisa Lotsari and Harri Koivusalo},
keywords = {Nutrient-dynamic, Climate-change, Hotspot mapping, Northern-catchments, SWAT+},
abstract = {Evidence is accumulating that climate change is driving fundamental shifts in hydrological regimes across northern catchments. Yet the biogeochemical consequences of these shifts and their implications for surface-water quality remain poorly understood. Here, we developed a process-based diagnostic framework that integrates hydrology–water-quality modeling, climate scenarios (SSP1-2.6, SSP2-4.5, SSP5-8.5), and statistical methods to identify the mechanisms by which climate forcing generates new hotspots of nitrogen and phosphorus mobilization in northern catchments. The framework was applied to the Vantaanjoki catchment, a well-characterized northern system with a documented history ofnutrient export to the Gulf of Finland and the Baltic Sea. We found statistically significant hydrological shifts under climate change scenarios, characterized by reduced snow storage and intensified winter–autumn runoff. Phenological mismatch between nutrient supply and plant uptake is projected to intensify under climate change, with nutrient release and mobilization increasingly occurring during periods of low biological demand. Combined with hydrological shifts, this leads to higher off-season losses and a transition in nutrient inputs to the Gulf of Finland from melt- to rainfall-driven pathways. Consequently, the seasonal share of annual nutrient export is projected to decrease in spring from 33% to 23–28%, while increasing in winter and autumn from 24% to 27–31% and from 30% to 36–40%, respectively, under SSP scenarios relative to the current condition. Moreover, climate change is projected to alter the emergence and expansion of nutrient-mobilization hotspots in vulnerable cropland and urban–agricultural transition zones through hydrological shifts and weakened nutrient–biological coupling. Based on the study’s findings, we present a transferable, mechanism-guided nutrient management framework to address climate-driven biogeochemical risks in comparable systems worldwide.}
}
@article{LI2026135666,
title = {CWN-Net: a precise segmentation model for composite water networks using multi-source and multi-temporal remote sensing imagery},
journal = {Journal of Hydrology},
volume = {676},
pages = {135666},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135666},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007638},
author = {Mingyang Li and Huimin Lei and Fulin Li and Jiwen Huang and Yuzhi Shi and Shangjie Xu and Han Wang and Sinan Wang and Rui Wang and Lili Liu and Suzhen Cheng and Lei Guo and Hongjie Xin and Zhen Yang and Guanghui Wang and Xianhu Guo and Jingjing Sun},
keywords = {Composite water network segmentation, Multi-source remote sensing imagery, Deep learning, SHAP Interpretability, Boundary-sensitive dual-branch architecture},
abstract = {Precise segmentation of composite water networks diverges from conventional water body detection due to challenges like intermittent channel flows, spectral confusion from aquatic or riparian vegetation obscuring waterways or dry riverbeds, morphological heterogeneity, and limitations of existing datasets. To address these, this study proposes CWN-Net, a high-fidelity model leveraging multi-source (Sentinel-1 SAR, Sentinel-2 multispectral) and multi-temporal remote sensing imagery. Built on U-Net, it integrates a shared CNN encoder, Swin Transformer module, temporal attention, dual-branch point-area segmentation heads, and consistency loss, enhanced by SHAP for interpretability. Validated in four Shandong Province cities (37,077 km2) as a “natural rivers–artificial channels–agricultural irrigation canals” study area, the datasets incorporate seasonal features. Comparative evaluation against LightGBM, MobileNetV2, DeepLabv3+, SegFormer-B0, Swin-Unet and two others shows CWN-Net, with 2.96 million parameters, achieves Precision 0.9320, F1 Score 0.9408, and IoU 0.8883, outperforming benchmarks in narrow irrigation channels, vegetation-covered regions, and urban shadows. SHAP analysis highlights third-quarter near-infrared and fourth-quarter green bands as primary contributors, with multi-source fusion mitigating SAR speckle noise in dry periods. The generated datasets augment HydroRIVERS and OSM deficiencies, adding 8.22 km urban hidden networks and 86.877 km unlabeled channels/mountainous rivers, providing high-precision support for regional water management, flood risk assessment, and irrigation optimization.}
}
@article{CAO2026135686,
title = {Large-scale urban flood modeling and zero-shot high-resolution generalization with LarNO},
journal = {Journal of Hydrology},
volume = {676},
pages = {135686},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135686},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007833},
author = {Xiaoyan Cao and Yao Yao and Zhi Wang and Zhangxinyue Zhao and Alistair G.L. Borthwick and Huapeng Qin},
keywords = {Urban flood, Spatiotemporal forecasting, Large scale, Neural operator, Deep learning, Transfer learning},
abstract = {In urban areas, real-time early warning systems help mitigate the severe impacts of pluvial flooding. Although such systems have undergone significant recent development with the use of deep learning methods, urban-scale high-resolution modeling processes remain fundamentally constrained by the massive amount of GPU memory that is required for training neural networks. To overcome this bottleneck, we present LarNO, a memory-efficient, discretization-invariant neural operator that learns continuous-space hydrodynamic mappings to predict the spatiotemporal distributions of water depths based on dynamic rainfall and static topographic and drainage conditions. This approach enables zero-shot generalization to high resolutions when trained solely on low-resolution data. Additionally, existing autoregressive neural operators compress complex dynamics into a single physical variable, leading to an information bottleneck when modeling complex nonlinear spatiotemporal dependencies. To resolve this issue, we embed spatiotemporal feature extractors into a neural operator to implement latent autoregression. Theoretically, we prove that our approach universally approximates continuous operators and enables the generalization of zero-shot super-resolution. An empirical case study of a highly urbanized region of nearly 100 km2 in Shenzhen, China, subjected to observed rainfall events with spatiotemporal heterogeneity, demonstrates that LarNO achieves large-scale, high-resolution (5 m, 5 min), long-duration (6 h), real-time spatiotemporal urban flood forecasting at mm-level depth accuracy, reducing prediction errors by more than half relative to state-of-the-art neural operators. Simultaneously, it delivers two-orders-of-magnitude faster inference speedup than a traditional hydrodynamic model. Notably, these improvements incur negligible parameter overhead (only 0.024% more than the baseline neural operator), and LarNO uniquely, among the compared neural operators, supports multi-GPU distributed training and TensorRT-accelerated inference. In addition, the results of an ablation study validate the effectiveness of latent autoregression. Moreover, LarNO supports few-shot transfers to unseen catchments via fine-tuning. Furthermore, comprehensive parameter sensitivity analyses demonstrate the robustness and effectiveness of LarNO. Our work provides a novel framework delivering real-time early warnings about large-scale urban flood events and achieving refined management schemes. The source code is available at https://github.com/holmescao/LarNO.}
}
@article{MURGIA2026135569,
title = {Capturing temporal shifts in forest soil-atmosphere feedbacks: evidence from a Mediterranean catchment},
journal = {Journal of Hydrology},
volume = {676},
pages = {135569},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135569},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006669},
author = {Ilenia Murgia and Christian Massari and Matteo Verdone and Konstantinos Kaffas and David Labat and Daniele Penna},
keywords = {Eco-physiological feedback, Leading-lagging dynamics, Trees’ water-saving strategies, Wavelet analysis},
abstract = {This study explores the complex interactions among eco-hydro-meteorological (EHM) variables, such as soil moisture (SM), precipitation (P), vapor pressure deficit (VPD), and sap flow velocity (SF), in the Mediterranean climate, where water scarcity and the effects of climate change are becoming increasingly pronounced. While previous studies have identified thresholds controlling runoff generation in Mediterranean catchments, it remains unclear how lead-lag dynamics among EHM variables govern ecological responses. This study addresses this gap by using wavelet analysis to explore the controls and dynamics of FSM−P and FSM−VPD feedbacks across different time and frequency scales, investigating whether EHM interactions exhibit evident thresholds that trigger feedback switches in response to SM availability and atmospheric demand. These dynamics were studied during the 2021 growing season at two topographic positions (riparian and hillslope) on an experimental hillslope in a Mediterranean forested catchment, central Italy. Our results revealed that SM in the hillslope position showed rapid, event-driven responses to P, with soil water recharge processes that differed significantly between the wet and dry seasons. This sensitivity to climatic forcings was greater in the hillslope SM than in the riparian one, which was characterized by more uniform and smoothed responses. Furthermore, the results highlighted the activation of proactive water-saving strategies adopted by trees located in the hillslope position, as evidenced by a critical SM threshold of 0.15 m3/m3 below which not only was P ineffective, but also SF was severely limited. In contrast, the constant availability of soil water in riparian areas allowed trees to maintain higher transpiration rates, showing a more passive response to atmospheric demand. In conclusion, although P is the main source of soil water recharge, its effectiveness on water availability and tree transpiration depends on complex interactions within the soil-plant-atmosphere continuum, with topography acting as the dominant controlling factor. These insights are critical for improving our understanding of the resilience of forest ecosystems and for guiding more effective water and forest management strategies.}
}
@article{PENG2026135662,
title = {Scale-aware triple collocation: optimizing spatiotemporal windows for enhanced multi-source fusion of meteorological data},
journal = {Journal of Hydrology},
volume = {676},
pages = {135662},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135662},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007596},
author = {Zhixin Peng and Lingjie Li and Yintang Wang and Guoqing Wang and Yong Liu and Zhaode Yun and Rui Gao and Leizhi Wang and Xin Su},
keywords = {Triple collocation, Spatiotemporal nonstationary errors, Localized spatiotemporal window, Potential evapotranspiration, Data fusion, Yellow River Basin},
abstract = {Triple Collocation (TC) is a widely adopted approach for multi-source data fusion in meteorological variable estimation, particularly in areas lacking ground-based observations. However, a significant limitation of TC is its inability to account for nonstationary spatiotemporal errors, which can considerably degrade estimation accuracy. Although the previously introduced Dual Time-Space Triple Collocation (TC-2D) accounts for errors nonstationary in either time or space alone, it still overlooks the influence of the spatiotemporal domain scale on fusion performance. To address this limitation, this study proposes two novel fusion frameworks applied to estimate potential evapotranspiration in the middle and upper reaches of the Yellow River Basin: (1) a dynamic TC-2D utilizing localized spatial and temporal slice data (TC-2D-LST), and (2) a three-dimensional TC that incorporates neighborhood-based spatiotemporal information (TC-3D). Results indicate that the fusion accuracy is more sensitive to the temporal window of nonstationary errors than to their spatial window in both methods. By employing optimal window settings, both proposed frameworks achieve improved Kling-Gupta Efficiency (KGE’) values at over two-thirds of the stations compared to TC-2D. Specifically, the daily KGE’ shows an increase from 0.695 to 0.725 or higher, while the pentad-scale value surpasses 0.774, rising from 0.717. Furthermore, TC-3D demonstrated comparable or superior accuracy to TC-2D-LST, even with smaller windows, thus offering a more computationally efficient solution. Overall, the proposed dynamic and localized fusion frameworks extend the applicability of TC, provide a robust, generalizable, and transferable method for multi-source meteorological data integration.}
}
@article{CHEN2026135707,
title = {Enhanced water level fluctuations reduced the competitive advantage of cyanobacteria},
journal = {Journal of Hydrology},
volume = {676},
pages = {135707},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135707},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008048},
author = {Yan Chen and Rui Xia and Ruining Jia and Junde Ming and Kai Zhang and Jinghui Dou and Tianxiang Zhao and Xiang Li and Qin Zhang and Qi Zhang},
keywords = {Han River, River confluence area, Flow patterns, Competitive advantage, Structural equation model, Driving pathways},
abstract = {Hydrological changes in large river confluence zones, such as the Han River confluence area, driven by water infrastructure and natural inflows, alter regional biogeochemical processes. However, quantitative thresholds of hydrodynamic regimes and their drivers for algal succession remain unclear. This study, focusing on the Yangtze–Han River confluence under the SNWD middle route, refined the classification of flow patterns and developed a method to assess algal competitive advantage. We quantitatively revealed the succession mechanisms of algae under varying flow conditions. Results show: (1) five typical flow patterns were identified: strong and weak flow backward, top support, weak and strong natural flow; (2) the cyanobacterial competitive advantage exhibited a significant three–stage nonlinear response to flow patterns (R2 = 0.682); (3) structural equation modeling revealed three key driving pathways through which flow patterns influence algal succession: hydrodynamic, water temperature, and nutrient pathways. Enhancing hydrodynamic conditions can weaken cyanobacterial competitiveness, thereby mitigating riverine harmful algal bloom risk.}
}
@article{BARRE2026135759,
title = {Downstream hydrological consequences of existing and potential glacial lakes in a changing climate},
journal = {Journal of Hydrology},
volume = {676},
pages = {135759},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135759},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008565},
author = {Satheesh Barre and Arup Kumar Sarma},
keywords = {HIGTHIM, Glacial lakes, SWAT, Modified Reservoir Routine, Streamflow, Sediment load},
abstract = {Glaciers and glacial lakes are vital components of high-mountain hydrology; their continual existence and evolution greatly influence downstream subbasin-scale water resources. Previous studies have focused on GLOF risk assessment, however, there is an increasing need to concentrate on understanding the hydrological function of glacial lakes in regulating river flow. To address this limitation, we used the HIGTHIM tool to estimate ice thickness for 78 glaciers and mapped 28 potential glacial lakes through overdeepenings in subbasins 59 and 62 in the Subansiri River basin. Using PlanetScope imagery, we also delineated 55 existing glacial lakes. Thereafter, we validated the SWAT model at the basin outlet for streamflow and sediment load, and projected these variables using CMIP6 data. The ensemble mean projections indicate consistent positive changes in streamflow, with increases of 3.85%, 3.63%, 6.78%, and 9.55% under SSP1-2.6, SSP2-4.5, SSP3-7.0, and SSP5-8.5, respectively. Further, we modified the SWAT source code to incorporate these 83 glacial lakes as ungated reservoirs through the Modified Reservoir routine during future periods to assess their influence on streamflow. The dry season streamflow increases across four SSPs are 19.65, 18.65, 16.61, and 14.34 m3/s (subbasin 59), and 8.94, 8.34, 7.36, and 5.6 m3/s (subbasin 62), respectively. The wet season streamflow reductions across four SSPs are 5.06, 18.08, 18.94, and 19.17 m3/s (subbasin 59), and 20.64, 30.65, 30.61, and 28.59 m3/s (subbasin 62), respectively. These projections represent a scenario where potential lakes are fully formed, which may slightly overestimate baseflow enhancements during early stages of lake development. However, these results provide critical insights into glacial dynamics and water resource management strategies in the basin amid its rapidly changing climate.}
}
@article{NONG2026135690,
title = {Regression-calibrated GloFAS modelling of nitrogen speciation dynamics in a large reservoir: Responses to hydrology, loading, and climate},
journal = {Journal of Hydrology},
volume = {676},
pages = {135690},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135690},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007870},
author = {Xizhi Nong and Zhongan Li and Lihua Chen and Jiahua Wei},
keywords = {Environmental fluid dynamics code, Reservoir regulation, Water quality management, Climate change, Nitrogen pollution},
abstract = {Managing nitrogen pollution in reservoirs is crucial for water quality safety, especially under the influence of climate change and human activities. Water environment models are critical tools for investigating such issues. However, their simulation reliability is limited when hydrological boundary data are incomplete or unavailable. To improve this, a method was proposed to calibrate the Global Flood Awareness System (GloFAS) using a regression model. This method has been applied in the construction of the hydrodynamic and water quality coupling model of Danjiangkou Reservoir (DJKR) using the Environmental Fluid Dynamics Code (EFDC). The core analysis objects are the dam discharge (P1) of the DJKR and the water intake (P2) of the Middle Route of the South-to-North Water Diversion Project of China. The migration and transformation of nitrogen under different hydrological regimes, tributary loads, and climate changes were simulated and analyzed. The results show that the model calibrated by regression models (R2: 0.43 to 0.94) performs better than the GloFAS model without incorporating tributary data. This improvement is reflected in a 1.652 m reduction in RMSE. When inflow and water diversion increase, the risk of total nitrogen pollution at P1 and P2 rises (0.02% to 5.35%). Reducing nitrogen in the Shendinghe River and Sihe River improved ammonia nitrogen (NH3-N) and nitrate nitrogen by only −0.03% to −0.9%. In contrast, reducing Hanjiang River inflow (R1) significantly decreased pollution by −3.37% to −20.62%. This highlights the dominant role of major tributary load reduction in improving reservoir water quality. Under the drought-flood abrupt alternation (DFAA) scenario, except for the inorganic nitrogen concentration of P1 (−0.34% and −0.36%), the concentrations of the rest all increase (0.05% to 1.14%). Higher temperatures reduce organic nitrogen (−0.14% to −4.31%) but raise inorganic nitrogen (0.70% to 1.65%), excluding NH3-N at P2. This indicates that future global warming and the increasing frequency of DFAA events will significantly alter the transport and transformation processes of nitrogen species in the reservoir. The research results have important guiding significance for high-quality management of water quality in large reservoirs.}
}
@article{CAI2026135751,
title = {Enhancing simulation accuracy of a semi-distributed conceptual hydrological model using satellite soil moisture products},
journal = {Journal of Hydrology},
volume = {676},
pages = {135751},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135751},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008486},
author = {Haotian Cai and Yi Nan and Rui Tong and Fuqiang Tian and Jingan Lin},
keywords = {Hydrological model, Runoff simulation, Soil moisture, Data incorporation},
abstract = {An accurate representation of the soil moisture (SM) state is fundamental to both refining the physical basis of parameters and to reducing uncertainty of runoff simulation in conceptual hydrological models. However, the specific impacts and underlying mechanisms of incorporating passive satellite SM products into semi-distributed conceptual models remain unclear. To address this gap, we employed the semi-distributed conceptual hydrological model, Tsinghua Representative Elementary Watershed (THREW), in 12 diverse watersheds across China. We assimilated two multi-resolution (1 km and 36 km) SM products derived from the AMSR-E/2 series using an exponential filter. We designed and compared three calibration strategies: a runoff-only benchmark, and two joint scenarios using different SM product resolutions. Results demonstrate that the SM product reduces the overestimation of small-to-medium flood peaks by correcting the antecedent top-layer moisture of the model. This corrective effect is most pronounced during seasonal transitions of spring-to-summer and summer-to-autumn characterized by distinct wet-dry shifts of SM within the whole year mainly in humid subtropical monsoon climate regions. However, the simulation accuracy for large flood events was compromised when calibrating with satellite SM, primarily due to the inconsistent sensitivity to rainfall inputs between the satellite data and the modeled top-layer moisture. This limitation is effectively mitigated by replacing the stringent KGE metric evaluating SM simulation with weaker constraints: the correlation coefficient (R) and the ratio of standard deviations (SDR).}
}
@article{ZHOU2026135678,
title = {Mathematical modeling for interactions and transport of particulate bioavailable phosphorus with sediment dynamics},
journal = {Journal of Hydrology},
volume = {676},
pages = {135678},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135678},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007754},
author = {Ya Zhou and Lei Huang and Man Zhang and Danny Reible and Hongwei Fang},
keywords = {Particulate bioavailable phosphorus, Sediment transport, Mineral properties, Environmental factors, Modeling},
abstract = {Particulate bioavailable phosphorus (PBAP) plays a critical role in biogeochemical cycling and primary productivity in aquatic ecosystems, particularly in ecologically vulnerable alpine regions. However, the understanding of PBAP dynamics remains limited due to the complex interaction and transport processes. To address this gap, we developed a mathematical model that coupled hydrodynamics, sediment transport, and dissolved and particulate phosphorus dynamics to simulate PBAP transport. PBAP bound to sediment was represented by coupling sediment mineral properties and environmental factors. Lateral inputs of water, sediment, and phosphorus from the watershed were incorporated using the Soil and Water Assessment Tool (SWAT). The model was applied to the Yarlung Tsangpo River and successfully reproduced PBAP distributions, with spatiotemporal concentrations ranging from 0.20 to 0.38 mg g−1, consistent with field measurements. The estimated annual PBAP flux was 2.77 Gg yr−1, partitioned as 46.0% Ex‑P, 37.7% Fe‑P, and 16.3% Al‑P, which exceeded the flux of dissolved phosphorus (∼0.80 Gg yr−1). Furthermore, over 95% of annual PBAP flux occurred between June and September, indicating strong temporal variability in PBAP dynamics within monsoonal alpine basins. This model advances process-based quantifications of PBAP dynamics and has far-reaching implications for water environment management.}
}
@article{FENOGLIO2026135681,
title = {High resolution river and estuarine water level topography from nadir altimetry},
journal = {Journal of Hydrology},
volume = {676},
pages = {135681},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135681},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600778X},
author = {Luciana Fenoglio and Jiaming Chen and Stefano Vignudelli and Ron Abileah and Elena Zakharova and Marco Restano and Jerome Benveniste and Jürgen Kusche},
keywords = {Radar nadir-altimetry, Fully-focused SAR, Unfocused SAR, Water surface elevation, Hydrological topography},
abstract = {Standard unfocused Synthetic Aperture Radar (UFSAR) nadir-altimeter products with a posting rate of 20 Hz provide water level heights with an along-track spacing of 300 meters, which is far from being optimal for coastal zone and inland studies. The fully focused FFSAR processing, which allows much higher resolution and posting rate, shall resolve small scales interferences along-track and thus improve the accuracy and precision of the geophysical estimates. This study looks at different water surfaces in rivers, lakes and coastal zones to investigate under which conditions and processing schemes the accuracy of water level measurements is higher with FFSAR rather than with UFSAR. We focus on Sentinel-3A, -3B and -6A missions during 2016–2023. Starting from the UFSAR products at a 20 Hz posting rate, we investigate the optimal choice for the Level 1 to Level 2 processing algorithms and parameters. We find that posting rates of 80 Hz for Sentinel-3 and 140 Hz for Sentinel-6 are best suited for all inland targets. Our results indicate that the FFSAR, combined with the SAMOSA+ physical retracker, is likely to provide the highest accuracy and the largest number of observations for all targets, with averages of 15–20 cm in rivers, 6 cm in lakes, 40 cm in estuaries and 10 cm at the coast. The gain in accuracy of FFSAR over UFSAR is, for the same posting rate and retracker, smaller than 5 %, except for small targets with river widths smaller than 100 meters, areas smaller than 0.1 km2 and proximity to the coast. This study recommends FFSAR processing, although nadir-altimetry does not deliver longitudinal river profiles all along the river. Where water surfaces decorrelate quickly over time, the FFSAR accuracy may degrade, with a more pronounced impact over the open ocean compared to lakes.}
}
@article{LIU2026135702,
title = {Global assessment of extreme precipitation in response to climate warming: revisiting the Clausius–Clapeyron relation},
journal = {Journal of Hydrology},
volume = {676},
pages = {135702},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135702},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007997},
author = {Yishuo Liu and Yuting Yang and Zhuoyi Tu and Yuhan Guo},
keywords = {Extreme precipitation, Climate warming, Clausius–Clapeyronrelationship, Dynamic and thermodynamic factors},
abstract = {The Clausius–Clapeyron (C–C) relationship suggests that rising temperatures under global warming should enhance the atmosphere’s moisture-holding capacity, leading to intensified extreme precipitation (PE) at an expected rate of approximately 7% per degree Celsius. However, observational studies often report deviations from this theoretical expectation. A key methodological distinction lies in whether extremes are defined conditionally within temperature bins or unconditionally from the full precipitation distribution. The conventional binning technique method characterizes the variation of upper-quantile precipitation across temperature bins, but it does not directly capture the intensity changes of true PE over the temperatures where these extremes occur. Here, we introduce a complementary approach that first identifies unconditional true PE from the full precipitation record and then examines how their intensity varies with temperature. Applying this method to global observational data for the past five decades, we find that approximately 85% of regions exhibit positive PE–T scaling, with a global mean rate of ∼ 2%/°C—substantially lower than the theoretical C–C rate. A physical decomposition framework further reveals that non-thermodynamic factors, particularly atmospheric dynamics and precipitation efficiency, play a major role in suppressing the scaling rate, especially in tropical regions. These results suggest that the response of extreme precipitation to warming is more complex than previously assumed, underscoring the importance of incorporating dynamic and microphysical processes into climate projections of hydrological extremes.}
}
@article{CAI2026135723,
title = {Land use and land cover change have reduced meteorological-hydrological compound drought on a global scale},
journal = {Journal of Hydrology},
volume = {676},
pages = {135723},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135723},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008206},
author = {Xitian Cai and Haijun Huang and Zichun Zhao and Jie Wang and Guo Zhang and Joshua B. Fisher},
keywords = {LUMIP, Compound drought, Land use and land cover change, Droughtcharacteristics, Grazing lands, CMIP6},
abstract = {Drought poses increasing threats to natural ecosystems and human societies. While historical land use and land cover change (LULCC) has generally been linked to increased drought duration and severity, its specific influence on compound droughts remains insufficiently understood. This study investigates the global impact of LULCC on meteorological-hydrological compound droughts (MHCDs) from 1850 to 2014, utilizing the Land-Use Model Intercomparison Project (LUMIP) experiments, run theory, and ridge regression. Our findings reveal that, contrary to general trends for single droughts, historical LULCC has mitigated MHCDs globally, leading to overall reductions in their duration by an average of 0.11 months and severity by 0.12 units. However, this generalized trend masks complex regional variations and differing impacts on individual drought types: LULCC tended to intensify meteorological droughts while simultaneously reducing hydrological droughts. Additionally, MHCDs in arid zones display the most significant sensitivities to LULCC. Ridge regression analysis further elucidates the relative contributions of urban areas, forests, croplands, and grazing lands. Grazing lands and croplands exert dominant yet spatially heterogeneous influences, with effects on MHCDs opposing one another across different continents, underscoring the critical role of regional context in LULCC-drought interactions. These results highlight the multifaceted influence of human land management on drought dynamics and provide crucial insights for developing regionally tailored adaptation and mitigation strategies.}
}
@article{ZHU2026135589,
title = {Regulation of river water temperature and dissolved oxygen under cascade reservoir systems: Hydropower-ecological synergy based on a simulation–optimization-causal explanation framework},
journal = {Journal of Hydrology},
volume = {676},
pages = {135589},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135589},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426006864},
author = {Zhaoyang Zhu and Zhaocai Wang and Jiachen Kong and Jiahao Zou and Xuanxuan Wang and Zuowen Tan and Chenye Liu and Qikai Liu},
keywords = {Reservoir optimization operation, Multi-objectiveoptimization, Causal relationship, Machine learning, Ecological operation},
abstract = {Under the combined pressures of global warming and large-scale cascade damming, river water quality dynamics are increasingly deviating from their natural patterns, resulting in abnormal water temperature (WT) regimes and amplified dissolved oxygen (DO) fluctuations that threaten key ecological processes such as fish spawning. Mitigating the adverse impacts of cascade reservoir operations on downstream ecosystems while ensuring reliable power supply has become a critical challenge for river basin management. To address this issue, this study proposes a multi-objective management framework for cascade reservoirs, termed Simulation–Optimization–Causal Explanation (SOCE). An RF–AdaBoost surrogate model incorporating prior physical knowledge is first developed to simulate WT and DO dynamics under limited water quality observations. The surrogate model is then coupled with a reservoir operation model, and a reinforcement learning (RL)-based NSGA-III algorithm is employed to solve the multi-objective optimization problem balancing hydropower generation and ecological requirements. Furthermore, interpretability is integrated with Convergent Cross-Mapping (CCM) to identify and validate the causal effects of operational decisions on downstream water quality. Using the Xiluodu–Xiangjiaba (XLD-XJB) cascade system as a case study, the results show that hydropower generation increases by 94–106 million kWh, while DO suitability reaches 98.17% under three typical inflow scenarios. The proposed framework effectively enhances total power generation while mitigating ecological risks during fish spawning periods. In addition, its causal interpretability expands the feasible space of ecological scheduling strategies. Overall, the SOCE framework provides a scalable and interpretable decision-support tool for ecological reservoir operation.}
}
@article{WANG2026135670,
title = {Mamba-enhanced multi-scale state space model for robust runoff prediction under data-scarce conditions across climatic zones},
journal = {Journal of Hydrology},
volume = {676},
pages = {135670},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135670},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426007675},
author = {Wen-chuan Wang and Tao Zhang and Dong-mei Xu},
keywords = {Runoff forecasting, Multi-scale modeling, State space model, Mamba, Cross-climate, Data-scarce conditions, Pawcatuck River},
abstract = {To address the problems of constrained data quality, mixed multi-scale characteristics, and low efficiency in long-range dependency modeling in hydrological runoff prediction, this study proposes a Multi-scale Mamba (MSM) model. This model adopts a progressive architecture comprising “multiscale feature extraction – long-range dependency modeling – key information enhancement,” with three core customized modules: a multiscale convolutional-attention fusion block, which simultaneously extracts multiscale runoff features through parallel convolutional branches at different temporal scales and suppresses observational data noise via a cross-scale attention-weighted fusion mechanism; a Residual-Enhanced Mamba block, which efficiently captures long-range hydrological dependencies with linear time complexity based on a selective state-space model, and optimizes gradient propagation in deep networks via residual connections to address training degradation issues; and a temporal attention module, which adaptively focuses on critical time steps of extreme hydrological events to enhance the fitting capability for hydrological extreme events. Experiments are carried out at four hydrological stations, namely Hongshan River, Yingluoxia, Tangnaihai, and Pawcatuck, covering arid, alpine, and temperate humid regions, with comparisons against five mainstream models including Transformer, TCN, GRU, LSTM, and Mamba. The results show that, under conditions of limited data quality and sparse samples, the MSM model achieved an average NSE of 0.918 across four stations, representing an 8.3% improvement over the arithmetic mean of the five baseline models, a 28.51% reduction in RMSE, and a 10.2% increase in KGE; Compared to the original Mamba model, the efficiency of long-range dependency modeling improved by 30%, and the prediction error for extreme runoff events decreased by 17.6%. Compared to existing mainstream methods, the MSM model overcomes the core bottlenecks of traditional models—namely, poor generalization in data-scarce or high-noise scenarios and the difficulty in balancing long-series modeling accuracy with computational efficiency. It demonstrates excellent prediction accuracy and robustness across different climate zones and land surface conditions, providing efficient and reliable technical support for hydrological runoff prediction in data-scarce basins.}
}
@article{WANG2026135743,
title = {Response mechanisms of soil water-heat-nitrogen transport and crop growth to shallow buried drip irrigation with film mulching},
journal = {Journal of Hydrology},
volume = {676},
pages = {135743},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135743},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008401},
author = {Biyu Wang and Haofang Yan and Chuan Zhang and Hexiang Zheng and Jiabin Wu and Jianyun Zhang and Guoqing Wang and Desheng Zhang and Xuanxuan Wang and Rongxuan Bao and Youwei Liu and Yujing Han},
keywords = {Maize growth, Shallow buried drip irrigation, Film mulching, Soil physical and chemical properties},
abstract = {The uneven distribution and limited availability of water resources exacerbated the vulnerability of agricultural cultivation in Northwest China. The shallow buried drip irrigation (SBDI) with film mulching (FM) as one of the key water-saving irrigation method developed locally to improve water use efficiency and alleviate water shortages, still has its influence on field water-heat-fertilizer transfer regimes unclear. In this study, a three-year (2022–2024) field experiment was conducted to investigate the effects of SBDI levels (Isuf: 37.5 mm; and Idec: 30.0 mm) with FM on soil water, heat and nutrient conservation, evaporation suppression, and maize growth. The results showed that: 1) FM significantly increased the shallow soil temperature (Ts) by altering surface energy partitioning, with the Ts at 15 cm rising by up to 2.9°C compared to the non-mulching (NM) treatment, meanwhile, FM reduced surface soil water evaporation, thereby increasing the soil water content in the 0–40 cm layer by 4.3% to 6.0% during the sowing-jointing stage. In addition, it improved the utilization efficiency of deep soil water (60–100 cm) after the maize tasseling stage. FM reduced the soil nitrate nitrogen (NO3−-N) content at 0–40 cm by 38.42–42.18% compared to the NM treatment. Decreasing the irrigation amount (Idec) under FM and NM led to a decrease in the average NO3−-N content by 8.82% to 17.83% compared to the sufficient irrigation (Isuf). 2) FM not only increased maize plant height, stem diameter, and leaf area index, but also improved water use efficiency by 26.7–34.3%. It increased the yield by 18.2–21.6% in 2023 and 2024. The maize yield under the FM-Idec was 13.69% and 14.0% higher than that under the NM-Isuf in 2023 and 2024, respectively. The economic benefit analysis indicated that the yield gains associated with FM ultimately resulted in an increase in net profit, particularly in 2023 and 2024, during which net profit rose by 16.3% and 11.0%, respectively.}
}
@article{DU2026135715,
title = {Elevation-conditioned isotope diagnostics of seasonal reversals in surface water–suprapermafrost groundwater exchange in Tibetan Plateau headwaters},
journal = {Journal of Hydrology},
volume = {676},
pages = {135715},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135715},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426008127},
author = {Fa Du and Zongxing Li and Juan Gui and Jian Xue and Ahui Zhang and Deyu Zhao},
keywords = {Surface water–groundwater interaction, Alpine permafrost, Suprapermafrost groundwater, Freeze–thaw processes, Stable isotope},
abstract = {Riassunto
Alpine permafrost headwaters act as critical water towers, yet the timing and direction of surface water–suprapermafrost groundwater (SW–SPG) exchange remain difficult to diagnose at basin scale. In this study, we use 861 event-based precipitation samples to construct a local meteoric water line (LMWL; δ2H = 7.70 × δ18O + 8.14) and propose an elevation-conditioned, bidirectional exchange (ECBE) framework that interprets SW and SPG isotopes against this precipitation reference. The framework combines δ18O–δ2H diagnostics with LMWL-referenced lc-excess and quantifies two precipitation-referenced net exchange indicators —Rspg (SW → SPG tendency) and Rsw (SPG → SW tendency) — with explicit uncertainty propagation. Across the Three-River Headwaters Region, Rspg and Rsw reveal a seasonally structured reversal of exchange tendency: SW → SPG is favored in early and late ablation, whereas a mid-summer strengthening of SPG → SW emerges most clearly in the Yellow and Yangtze headwaters, consistent with thaw-season groundwater level evolution. Elevation further organizes the exchange regime. SW d-excess and LMWL-referenced lc-excess exhibit a step-like transition around ∼4500–4600 m, defining an operational meltwater presence line (MPL) that indicates a transition to meltwater-dominated isotopic signatures in the highest zones. Overall, ECBE provides an uncertainty-aware and transferable basis for diagnosing when and where SW–SPG exchange reverses across high-elevation permafrost basins. It thus enables robust comparisons of connectivity as thaw and meltwater influence evolve.}
}