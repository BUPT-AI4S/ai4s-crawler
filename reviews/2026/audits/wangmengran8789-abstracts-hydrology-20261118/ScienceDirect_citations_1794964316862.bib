@article{FU2026135411,
title = {Evapotranspiration-partitioned generalized complementary relationship model for heterogeneous vegetation},
journal = {Journal of Hydrology},
volume = {673},
pages = {135411},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135411},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005081},
author = {Chong Fu and Weilin Liu and Xiaoyu Song and Lanjun Li and Lu Xia and Jing Yuan},
keywords = {Evaporation, Generalized complementary relationship, Grassland, Interception, Plantation, Transpiration},
abstract = {Evapotranspiration (ET) encompasses three components: vegetation transpiration (TR), soil evaporation (E), and interception evaporation (I). The complementary relationship (CR) only provides total ET. This study proposes an evapotranspiration partitioning method to be used with the generalized complementary relationship, which is called the evapotranspiration-partitioned generalized complementary relationship (EPGCR). It requires only meteorological and leaf area index data. The EPGCR employs the dynamically scaled generalized complementary relationship (S2017) for total ET estimation. By introducing the Beer and modified Priestley-Taylor equations and further assuming that the apparent potential and potential evaporation terms of I could separately be estimated as a certain multiple of the corresponding ET, the actual TR and E can be obtained. The actual ET estimates of S2017 were used as force-closure conditions to acquire I. The EPGCR has three adjustable parameters α, k, and q, controlling simulations of ET, TR, as well as E and I, respectively. Applying it to heterogeneous vegetation with data from a 10-year field experiment (a Robinia pseudoacacia plantation and a natural grassland, 2015 ∼ 2024), the overall performance was high (the Nash-Sutcliff Efficiency (NSE) is 0.75 in the validation period) and maintained consistent parameters in different vegetation plots. It also exhibited high accuracy for all ET components with NSE of TR (0.80), E (0.7), and I (0.71). Furthermore, this study proved that the CR is applicable for the estimation of TR and E, the same as ET. In contrast, I does not have a complementary relationship with its apparent potential term, which might be a source of error when employing the CR for estimating ET. This study significantly expands the potential application range of the CR while pointing out the direction for its future development.}
}
@article{LONG2026135419,
title = {A multidimensional Tucker tensor fusion method for multi-satellite derived chlorophyll-a concentrations in an Early Eutrophic Plateau lake},
journal = {Journal of Hydrology},
volume = {673},
pages = {135419},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135419},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005160},
author = {Haibo Long and Jianzhong Lu and Jiahui Chang and Shoujing Yin and Qihang Liu and Chang Huang and Xiaoling Chen},
keywords = {Chlorophyll-a, Spatiotemporal fusion, Multidimensional Tucker tensor fusion, Multi-source satellite imageries},
abstract = {Lakes constitute a critical component in sustaining the stability of inland aquatic ecosystems. Chlorophyll-a (Chla) serves as a pivotal proxy for evaluating the occurrence and intensity of algal blooms, thereby necessitating long-term and continuous monitoring to facilitate effective ecological management of lacustrine systems. Although significant progress has been made in developing methodologies for estimating Chla concentrations through optical satellite imageries, these approaches continue to face inherent constraints. Existing spatiotemporal fusion algorithms lack decision-level fusion algorithms. To address this gap, this study introduces a novel decision-level fusion algorithm that integrates multi-source satellite imageries from Sentinel-2 MSI, Landsat-8 OLI, and Landsat-9 OLI-2. This study proposes a two-stage method for inverting lake Chla. Initially, Chla inversion is performed using band combination algorithms (MCI and BR). Subsequently, a multidimensional Tucker tensor fusion method (MTTFM) is employed to synergistically integrate these Chla maps in decision-level, leveraging the complementary strengths of different satellite platforms. Erhai Lake is selected as the study area, with observed Chla serving as ground-truth references for comprehensive model evaluation. The results demonstrate strong model performance, with a coefficient of determination (R2) of 0.73, a mean absolute error (MAE) as low as 5.18 μg/L and a root mean square error (RMSE) as low as 8.19 μg/L, indicating high accuracy and reliability. This method integrates multi-source satellite imageries to achieve high temporal resolution (2.5–3.4 days) and spatial resolution (10 m) for lake surface Chla inversion. It significantly advances lake water environment research by providing enriched datasets and refined methodological tools for monitoring and managing lacustrine ecosystems.}
}
@article{LI2026135403,
title = {A physically based neural network for flood routing: The Muskingum-Recurrent neural network},
journal = {Journal of Hydrology},
volume = {673},
pages = {135403},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135403},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005007},
author = {Zhaoxi Li and Tiejian Li and Jian Sun and Jiaye Li and Weidong Li and Jie Zhao and Jiahua Wei},
keywords = {Flood routing, Muskingum method, Physics-informed neural network, Mass conservation, Hydrological modeling},
abstract = {Flood routing is crucial for effective flood forecasting and control, for which the Muskingum method provides a simple and robust solution with clear physical mechanisms. Recently, data-driven models have been widely applied in this field; however, their lack of underlying physical foundations raises interpretability concerns and risks of violating water mass conservation, which ultimately limits their generalizability and transferability to ungauged basins or extreme flood events. This study addresses this gap by developing a Muskingum-Recurrent Neural Network (MRNN) that integrates the Muskingum routing equations into RNN’s internal structure, with Muskingum coefficients defining the network’s weights. Unlike soft-constraint approaches, MRNN enforces mass conservation as a hard architectural constraint. We validated MRNN through three complementary stages. The first stage on artificial channels demonstrates that MRNN requires far fewer parameters than ANN, RNN, and LSTM, yet achieves faster convergence, while preserving water mass balance with orders of magnitude less water loss. The second stage on classical benchmark floods shows that MRNN achieves lower MSE than most of existing Muskingum parameter optimization methods. The third stage on floods in Village Creek shows that MRNN achieves a higher pass rate than these three networks, with peak timing errors consistently within one hour. Robustness tests reveal that when the training set is reduced from 80% to 20%, MRNN exhibits substantially smaller degradation in Nash-Sutcliffe Efficiency than these three networks. The results demonstrate that embedding physical equations into neural network architecture provides a powerful paradigm for developing interpretable, data-efficient, and physically consistent flood routing models.}
}
@article{LOISEAU2026135451,
title = {EA-ERT: a new ensemble approach to convert time-lapse ERT data to soil water content},
journal = {Journal of Hydrology},
volume = {673},
pages = {135451},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135451},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005482},
author = {B. Loiseau and S.D. Carrière and N.K. Martin-StPaul and R. Clément and C. Champollion and V. Mercier and J. Thiesson and S. Pasquet and C. Doussan and T. Hermans and D. Jougnot},
keywords = {Hydrogeophysics, Electrical Resistivity Tomography (ERT), Inversion, Time-lapse, Soil water content, Ensemble approach},
abstract = {Electrical Resistivity Tomography (ERT) is increasingly used to study subsurface hydrological processes; it shows promising potential for estimating soil water content, a key but challenging property to quantify. However, the complexity of converting the resistivity signal to water content led us to develop approaches to increase the estimate robustness while facilitating uncertainty evaluation. In this paper, we propose an innovative method, called the Ensemble Approach ERT (EA-ERT) that builds an ensemble model of electrical resistivity calibrated from field data and then converts it to a spatial distribution of water content. This approach combines time-lapse ERT data with point-based in-situ soil water content measurements. It makes it possible to (i) circumvent inversion parameter choice by evaluating the performance of multiple models, (ii) estimate uncertainty in the final model by calculating the coefficient of variation among the models that make up the ensemble, and (iii) convert electrical resistivity models to water content. The method was tested at two dissimilar field sites in southern France and on a synthetic case. For each site, an ensemble model, built from multiple inversions, was selected and converted to soil water content. The calculated values showed a strong fit (r ≥ 0.8), with minor differences (RMSE ≤ 3.24% vol.) compared to in-situ measurements. Areas of high uncertainty were identified, providing information that complements more traditional indicators provided by the inversion code. EA-ERT provides a robust and automatable method to convert ERT data to related parameters, contributing to improved monitoring and more complete understanding of subsurface processes.}
}
@article{NIKROU2026135410,
title = {Intercomparison of flood inundation models across land use types and hydrological flood stages},
journal = {Journal of Hydrology},
volume = {673},
pages = {135410},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135410},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600507X},
author = {Parvaneh Nikrou and Sadra Seyvani and Sagy Cohen and Sudershan Gangrade and Joseph L. Gutenson and Dan Tian and Anupal Baruah and Michael L. Follum and Shih-Chieh Kao},
keywords = {Flood inundation mapping, Hydrodynamic modeling, Terrain-based flood models, Neuse River Basin, Remote sensing validation},
abstract = {Flood Inundation Mapping (FIM) model selection is a key operational decision because accurate, rapid mapping underpins early warning and resource allocation. FIM performance is context-dependent and can vary with hydrograph phase, land-use/land-cover (LULC), and the evaluation benchmark. Intercomparison studies typically assess a single near-peak snapshot against one reference dataset. Here, we provide a context-stratified intercomparison across (i) multiple hydrograph phases, (ii) LULC classes, and (iii) benchmark types, for five FIM approaches spanning a wide range of physical complexity and operational cost (TRITON, LISFLOOD-FP, HEC-RAS 2D, ARC-Curve2Flood, and OWP HAND-FIM). We use the Hurricane Matthew flood (2016) in the Neuse River Basin, North Carolina, USA, as a case study. Using high-resolution remote sensing-derived flood inundation maps, hand-labeled points, and building footprints, we assess model skill across two rising and two falling hydrograph limbs and across major LULC types. Results show that model rankings shift systematically across contexts: LISFLOOD-FP ranks highest in three of four flood phases, while TRITON leads during one rising limb phase; LISFLOOD-FP performs best in vegetated areas, whereas HEC-RAS improves relative performance in agricultural and urban areas; and benchmark choice influences conclusions, with LISFLOOD-FP performing best for flooded-building detection in the late falling limb, while TRITON ranks highest against hand-labeled points. We also report representative wall-clock runtimes for each workflow to provide use-case context for operational feasibility. Together, these results offer transferable guidance for model selection and for designing large-scale, benchmark-aware FIM intercomparison studies.}
}
@article{SHI2026135431,
title = {Solute migration in a cut-off wall and hole multi-domain system: Analytical solution and field study},
journal = {Journal of Hydrology},
volume = {673},
pages = {135431},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135431},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005287},
author = {Yanghui Shi and Haijian Xie and Majid Sedighi and Lingchi Chen and Jiayi Hong and Yongqiang Zhang and Yanbo Chen and Jiaying Ye},
keywords = {Cut-off wall, Analytical solution, Leakage detection, Contaminant migration, Performance deterioration},
abstract = {Leakage caused by wet-dry cycles or freeze–thaw cycles significantly deteriorates the cut-off wall performance. The depth of holes and the complexity of the stratigraphic environment make it difficult to detect the cut-off wall leakage. This paper proposes a 2-D analytical solution for solute transport in the upper cut-off wall-hole-lower cut-off wall three-domain system. Two typical inlet boundary conditions including the constant concentration source (for contaminant migration) and pulse flux-type source (for tracer experiment) are investigated. Comparisons with an existing analytical solution and numerical models are conducted to validate the proposed model. Combined with the genetic algorithms and field tracer experiments, the analytical model can detect the hole in the barrier. Accurate predictions (coefficients of determination > 0.91) for the cut-off wall hole locations in a small domestic waste landfill in China have been achieved. Additionally, a comprehensive analysis of the influences of the hole parameters (diameter and hydraulic coefficient), system thickness and head loss on the cut-off wall performance is conducted. The results show that the hole parameters pose more significant impacts on the cumulative mass outflows (CMFs) than the average relative concentrations (ARCs). Additionally, the hydraulic conductivity of soil in the hole and head loss have the most significant impact on CMFs and ARCs, respectively. Moreover, although reducing head loss can improve the cut-off wall performance, the breakthrough time of a cut-off wall with a hole cannot exceed 20 years, even if the head loss is controlled at a very low value (e.g., 0.3 m).}
}
@article{HUANG2026135370,
title = {Human activities dominate the euphotic zone depth in Yunnan plateau lakes from Landsat observations (1986–2024)},
journal = {Journal of Hydrology},
volume = {673},
pages = {135370},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135370},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004671},
author = {Chao Huang and Yiming Yang and Yunmei Li and Xianzhang Dong and Yanhong Yu and Heng Lyu and Junda Li and Yuxin Zhu and Jianzhong Li and Wenyu Liu and Gaolun Wang and Mengmeng Song and Guotao Fan},
keywords = {Landsat, Plateau lakes, Euphotic zone depth, Spatial-temporal patterns, Influencing factors, Human activity},
abstract = {Yunnan plateau lakes are fragile ecosystems that have experienced severe environmental degradation due to decades of intensive human activities. These anthropogenic pressures have profoundly altered the lakes’ underwater light environment, posing a significant threat to overall aquatic health. Consequently, retrieving the euphotic zone depth (Zeu), a crucial indicator of underwater light availability and primary productivity, is essential. However, there are limitations to understanding the long-term changes of Zeu in these lakes, particularly in response to environmental changes. To address this gap, this study utilizes Landsat archives (1986–2024) to retrieve the spatial–temporal patterns of Zeu across these nine major lakes and explore mechanisms driving these changes. Our results revealed that Zeu varied widely across the lakes (1.27–14.55 m) and exhibited a significant increase trend, with an inter-annual trend of 0.01 m yr−1 and seasonal variability (0.02 m yr−1 for wet, and 0.01 m yr−1 for dry). These lakes displayed nearshore-central, north–south, and east–west spatial patterns were observed, with 6 lakes showing a broadly increasing trend in most waters. Human activities primarily influenced Zeu dynamics, shaping its spatial patterns with lake characteristics and directly driving temporal variations as the dominant factor (contributing 33.07%–68.22%). Mechanistically, this anthropogenic control operates through multiple processes: direct input of pollutants, modification of terrestrial landscapes, and human-ecological-climate interactions (10.12%–28.30%). These findings underscore the crucial role of human activities in reshaping the underwater light environment and provide an important foundation for these fragile ecosystems.}
}
@article{KUI2026135407,
title = {Detection of nine plateau lakes water level changes in Yunnan, China from ICESat-2 data},
journal = {Journal of Hydrology},
volume = {673},
pages = {135407},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135407},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005044},
author = {Mengyun Kui and Jinliang Wang and Jieying Lao and Jiya Pan and Jianpeng Zhang and Yuncheng Deng},
keywords = {ICESat-2, Satellite laser altimetry, Plateau lakes, Water level monitoring, Causes of change},
abstract = {Lake water level is a critical indicator of water balance and the hydrological cycle. Its monitoring is essential for detecting ecological and environmental changes, as well as for water-resource assessment and management. However, long-term, high-accuracy water-level monitoring remains challenging due to complex terrain, harsh environmental conditions, and the scarcity of in-situ observations. This study employs the ICESat-2 ATL13 global inland water dataset from October 2018 to December 2024 and proposes an outlier-detection framework that integrates geospatial clustering and a dynamic-threshold robust Z-score approach. Using this framework, we retrieve water levels and analyze their temporal variations for nine major plateau lakes in Yunnan Province, and further explore the primary drivers of lake-level changes using the SHAP method. The results show that: (1) ICESat-2–derived water levels exhibit high consistency with observed annual levels, Big Earth Data monthly water levels, and DAHITI trends, with R2 values exceeding 0.8 and RMSE ranging from 0.04 to 0.13 m, representing a substantial improvement over previous studies; (2) Most lakes experienced declining water levels from 2018 to 2024, with Lake Fuxian, Lake Qilu, Lake Dianchi, and Yangzonghai showing the most pronounced decreases, at −0.41, −0.23, −0.06, and −0.12 m/a, respectively. Lakes within the same basin exhibited certain similarities in their temporal trends; (3) lake-level drivers show a seasonal pattern characterized by “natural factors dominating and anthropogenic factors modulating.” During the wet season, precipitation–runoff inputs control water-level increases, whereas during the dry season, temperature-induced evapotranspiration losses dominate water-level declines. Meanwhile, cropland area exerts opposite seasonal effects through two pathways: reservoir irrigation return flows during the dry season and agricultural water consumption/discharge during the wet season. Overall, the integration of ICESat-2/ATL13 data with the enhanced outlier-removal strategy provides a robust foundation for long-term monitoring of plateau lake water-level dynamics, offering reliable data support and scientific guidance for watershed water-resource regulation and lake ecosystem management.}
}
@article{LAU2026135439,
title = {Trapping efficiency of non-buoyant microplastics by river groynes},
journal = {Journal of Hydrology},
volume = {673},
pages = {135439},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135439},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005366},
author = {Kelly Y.K. Lau and Abdolmajid Mohammadian and Abolghasem Pilechi and Ioan Nistor},
keywords = {Microplastics, Groyne, Rivers, Plastic pollution mitigation, Microplastics trapping},
abstract = {Microplastics (MPs) are an emerging environmental concern driven by extensive plastic use and inadequate waste management. As rivers act as major transport pathways and temporary sinks, reducing MPs loads within them can limit their transfer into seas and oceans. This study examines the ability of groynes, structures originally designed for flow and erosion control, to trap non-buoyant MPs. Ten configurations formed from pairwise combinations of four common groyne geometries were tested using MPs (of equivalent diameter deq = 2.29 mm) of two densities (ρs = 1.08 and 1.11 g/cm3) under subcritical turbulent flow in a recirculating flume. A particle tracking model was applied to derive particle trajectories, trapping efficiencies, and retention zones. It was observed that MPs entered the groyne field from the downstream end and formed a major gyre. All scenarios retained > 6% of particles during the test period. When both groynes shared the same shape, upstream-facing inclined groynes exhibited the greatest trapping potential, achieving retention rates up to 20.7 ± 3.7%. Straight and T-shaped groynes had lower entrainment but higher stability, with less than 3% escape. In cases where the upstream groyne was straight and the downstream geometry was varied, particle escape was negligible, with downstream repelling groynes consistently trapping more MPs than other configurations. Particle density had minimal effect on entrainment, though lighter MPs exhibited lower escape and smaller retention zones, reflecting sensitivity to vertical flow dynamics within the groyne field. The study highlights groynes’ potential role in mitigating riverine plastic pollution.}
}
@article{SHI2026135415,
title = {Unraveling evaporative driver of soil salinization in an arid desert ecosystem: Insights from stable water isotopes},
journal = {Journal of Hydrology},
volume = {673},
pages = {135415},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135415},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005123},
author = {Peijun Shi and Xin Cui and Xiaoxiao Liu and Puyuan Zhang and Zhi Li},
keywords = {Soil evaporation, Salinity distribution, Stable isotope, Desert ecosystem},
abstract = {Soil salinization poses a significant threat to agricultural productivity and ecosystem stability in arid regions. However, the mechanisms driving salinization processes remain poorly understood, yet it is critical for developing sustainable land management strategies. This study aims to quantitatively assess the linkage between evaporation losses and salt distribution in an arid desert ecosystem. Using an isotope mass balance model, we estimated soil evaporation loss across different soil layers and vegetation types, and measured electric conductivity (EC). Results indicated that surface soils (0 − 40 cm) had significantly higher salinity than deep soils (40 − 100 cm). Similarly, lc-excess values were more negative in surface soils (−45.2 ± 5.4‰) and relatively enriched in deep soils (−28.6 ± 5.5‰). Evaporation loss varied widely, ranging from 10%±7% to 96 ± 3% across soil layers, and from 16 ± 13% to 82 ± 8% among vegetation types. Surface soils exhibited higher evaporation losses (74 ± 5%) compared to deep soils (59 ± 5%). Evaporation loss was negatively correlated with lc-excess but positively correlated with salinity within each vegetation type. These findings demonstrate that while evaporation is the primary driver of surface soil salinization, its impact is regulated by vegetation type. The study highlights the importance for integrated management practices to effectively mitigate salinization in the arid ecosystems.}
}
@article{SADEGHI2026135467,
title = {Vadose zone analytical algorithm (VZAA): a non-iterative algorithm for vadose zone soil moisture and groundwater recharge},
journal = {Journal of Hydrology},
volume = {673},
pages = {135467},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135467},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005640},
author = {Morteza Sadeghi and Scott E. Boyce and Emin C. Dogrul and Guobiao Huang and Lan Liang and Uditha Bandara and Craig R. Altare and Tyler Hatch and Scott A. Bradford},
keywords = {Groundwater, Unsaturated zone, Richardson-Richards equation, Soil moisture, Recharge},
abstract = {Conventional groundwater models often overlook the water flow dynamics within the unsaturated zone of the soil profile, referred to as “vadose zone”. Water flow in the vadose zone is often assumed to be unidirectional, always from the soil surface toward the groundwater, due to the gravitational force. In these unidirectional (UD) vadose zone models, the diffusive water flow due to the soil moisture gradient is neglected because calculating the soil moisture gradient requires costly globally iterative schemes at large scales. This simplification, however, can lead to large errors in the simulated vadose zone soil moisture and recharge to the groundwater. In this paper, we introduce a novel algorithm, named “Vadose Zone Analytical Algorithm” (VZAA), that accounts for bi-directional exchanges of water between the saturated and unsaturated zones due to both gravitational force and soil moisture gradient. Unlike traditional numerical solvers of the Richardson-Richards equation that solve the entire soil profile simultaneously through global iterations, VZAA proceeds layer by layer in a sequential manner. VZAA solves each layer’s water balance using closed-form algebraic equations linking soil moisture to soil water flux. This structure eliminates the need for globally coupled iterative solvers, thereby reducing computational demands. This algorithm was tested using HYDRUS-1D as a reference model for various soil and flux scenarios. In most cases, VZAA showed a close agreement with HYDRUS. VZAA’s performance was also compared with a UD model and showed significantly more accurate results. Therefore, VZAA can be potentially used in existing regional-scale groundwater models to improve accuracy at no significant extra cost.}
}
@article{LIU2026135423,
title = {Adaptive physics-informed graph convolutional network for flow prediction in the downstream river network of the dongjiang river},
journal = {Journal of Hydrology},
volume = {673},
pages = {135423},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135423},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005202},
author = {Yueyi Liu and Hang Zheng and Kun Gao and Jianshi Zhao},
keywords = {Tidal river network, Physics-informed deep learning, Graph convolutional network, Mass-balance constraint, Adaptive weighting, Dongjiang River},
abstract = {Accurate flow prediction in tidal–sluice river networks remains challenging due to nonlinear hydrodynamics, bidirectional flow propagation, and complex multi-source interactions. This study develops an Adaptive Physics-Informed Graph Convolutional Network (PI-GCN) to achieve physically consistent flow forecasting in the downstream river network of the Dongjiang River, China. The model embeds node-level water-balance equations into the graph-learning process and introduces an adaptive weighting mechanism that dynamically adjusts the contribution of the physical loss term based on training convergence. By integrating the spatial learning capability of GCN with physics-guided constraints, the PI-GCN enables simultaneous optimization of data fidelity and mass-conservation consistency. Using hourly discharge data from a calibrated HEC-RAS model covering 235 cross-section nodes, the PI-GCN achieved a mean R2 of 0.87, outperforming conventional GCN and 1D-CNN models by 25–55% in MAE reduction. The node-level mass-balance residuals (water-balance equation errors) approach zero, indicating near-perfect mass balance across the river system. The model maintains stability under tidal backwater and sluice-operation conditions and demonstrates an optimal configuration with a 7–12 h history window and 3 h forecast horizon, balancing accuracy and temporal adaptability. This study provides a unified and generalizable framework for integrating adaptive physical constraints into graph-based hydrodynamic prediction, offering a physically interpretable and robust approach for data-driven river-network forecasting.}
}
@article{LIU2026135442,
title = {Microbial–organic coupling mediates groundwater ammonium dynamics under seasonal hydrological fluctuations},
journal = {Journal of Hydrology},
volume = {673},
pages = {135442},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135442},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005391},
author = {Wenhui Liu and Yao Du and Xuelin Guo and Wenkai Qiu and Cong Wang and Yanxin Wang},
keywords = {Groundwater, Ammonium, Dissolved organic matter, Microbial nitrogen cycle, Seasonal variations},
abstract = {Naturally occurring (i.e., geogenic) ammonium (NH4+) in groundwater is increasingly recognized as a widespread water-quality concern, commonly attributed to microbially mediated degradation of nitrogen-containing organic matter (OM). However, how seasonal hydrological fluctuations regulate microbial nitrogen cycling, organic substrate availability, and the resulting NH4+ dynamics remains poorly constrained. Here, we selected an NH4+-rich aquifer system in the Jianghan Plain (central Yangtze River Basin) and investigated its seasonal NH4+ dynamics by combining hydrogeochemical and isotopic analyses with microbial community and functional profiling and molecular-level OM characterization. Seasonal groundwater-level fluctuations altered redox conditions and OM availability, driving clear shifts in microbial nitrogen cycling pathways. During the dry season, sub-oxic conditions enabled partial NH4+ removal via nitrification, while ammonification and dissimilatory nitrate reduction to ammonium (DNRA) supplied NH4+. In the normal season, nitrification weakened and NH4+ production shifted toward DNRA under more reducing conditions, with Feammox becoming a major NH4+ sink. In the wet season, strongly reducing conditions suppressed nitrification and promoted NH4+ accumulation dominated by OM mineralization. Molecular characterization of OM further indicated that NH4+ enrichment was preferentially associated with the transformation of highly unsaturated compounds and polyphenols. Co-occurrence network analysis revealed strong seasonality in microbial–organic coupling: during the dry and wet seasons, dense and highly-connected networks linked specific OM formulas to key NH4+-producing microorganisms and functional genes (notably ureC and nrfA), whereas network complexity decreased markedly in the normal season. Together, these findings demonstrated that hydrology-driven reorganization of redox-sensitive microbial pathways and substrate-specific OM processing jointly determined seasonal NH4+ dynamics in groundwater, providing a mechanistic basis for predicting NH4+ risk and guiding groundwater management under intensifying hydrological variability.}
}
@article{QI2026135450,
title = {Assessing the impact of ice thickness uncertainty on future glacier evolution in the Himalayas using a higher-order glacier flow model},
journal = {Journal of Hydrology},
volume = {673},
pages = {135450},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135450},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005470},
author = {Xiaoning Qi and Yuzhe Wang and Tong Zhang and Lei Wang and Baojuan Huai and Hongmin An and Weijun Sun},
keywords = {Himalayan glaciers, Ice thickness, Future glacier change, Ice flow model, Higher-order ice dynamics},
abstract = {Understanding future glacier evolution in the Himalayas is essential for anticipating changes in regional water resources. However, significant uncertainty remains due to differences in the glacier ice thickness datasets used to initialize projection models. This study investigates the influence of ice thickness uncertainty on modeled glacier changes using a higher-order flowline model. We simulate the future evolution of 30 glaciers across the western, central, and eastern Himalayas under a committed climate scenario, assuming constant climate conditions from 1991 to 2020. Seven widely used global ice thickness datasets are applied to assess their impact on projections of glacier thickness, volume, and surface velocity. By 2100, glaciers are projected to lose an average of 23.4 ± 3.7 m in thickness, 0.10 ± 0.02  km3 in volume, and 0.67 ± 0.54  m a−1 in surface velocity. Differences among thickness datasets lead to a standard deviation of 1.5%–6.2% in projected volume loss, with larger divergence in the central Himalaya. The inter-dataset variability decreases with glacier elevation and size, whereas smaller and lower-elevation glaciers remain more sensitive to initial thickness differences. Although the overall magnitude of uncertainty is moderate, its influence persists throughout the century and is comparable to, that from climate model resolution. The use of a higher-order model further amplifies these differences due to its sensitivity to initial geometry. These findings highlight the need for improved thickness observations and emphasize the importance of incorporating multiple thickness datasets in regional glacier modeling.}
}
@article{WU2026135426,
title = {Effect of layered heterogeneity on the efficiency of freshwater injection in controlling saltwater intrusion in tidally-influenced coastal aquifers: insight from numerical simulations},
journal = {Journal of Hydrology},
volume = {673},
pages = {135426},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135426},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005238},
author = {Peipeng Wu and Yongjie Zhang and Jean-Christophe Comte and Yinhuan Fu and Xinqiang Du and Chunyan Zhang},
keywords = {Managed aquifer recharge, Tidal coastal aquifer, Layered heterogeneity, Saltwater intrusion, Numerical simulations, Feflow},
abstract = {Managed aquifer recharge (MAR) is recognized as a potentially effective method for controlling saltwater intrusion in coastal aquifers. However, the effect of layered aquifer heterogeneity linked to geological layering on MAR performance remains poorly understood, particularly under tidal forcing, where salt transport patterns differ markedly from those in the absence of tides. Assuming a low- or high-permeability interlayer in the coastal aquifer with the injection well beneath it, FEFLOW-based numerical experiments (laboratory and field scales) tested groundwater flow and salt transport during freshwater injection, with laboratory simulations based on prior physical model experiments (Wu et al., 2023). Using three evaluation metrics—Δxtoe (isohaline-tracked saltwater toe retreat distance), USP geometry, and mixing zone extent—our findings show that under constant tidal conditions, a low-K interlayer elevates well-injection-driven Δxtoe, while a high-K interlayer diminishes this retreat distance. Both low and high K interlayer scenarios reduce the extent to which the USP is compressed. Meanwhile, high- and low-permeability interlayers induce complex variations in the mixing zone, driven by notable changes in groundwater flow regimes within layered aquifers—whether with or without well injection. Additionally, the magnitude of Δxtoe induced by freshwater injection under a consistent total transmissivity was also explored. Based on the analysis of TCEs—defined as the sum of the product of each layer’s transmissivity with its elevation above the aquifer base, divided by the total aquifer transmissivity—the results further confirm the aforementioned research conclusion. Moreover, sensitivity analysis revealed that in high-K interlayer aquifers, well-injection-induced saltwater wedge toe retreat and USP thickness are more sensitive to tidal variations (i.e., tidal amplitude and period) than in low-permeability counterparts. This study provides insights that have implications for the design of effective MAR systems using freshwater injection wells in layered coastal aquifers.}
}
@article{BAH2026135413,
title = {A new comprehensive monitoring framework for global drought assessment},
journal = {Journal of Hydrology},
volume = {673},
pages = {135413},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135413},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600510X},
author = {Alhassane Bah and Asim Biswas and Hao Feng and Qiang Yu and Qianfeng Wang and Yi Li},
keywords = {Drought monitoring, Principal Component Analysis (PCA), Climate change, Multidimensional drought assessment, Composite drought index},
abstract = {We present a novel Comprehensive Drought Index (CoDI) for global drought assessment that integrates meteorological, agricultural, and hydrological drought dimensions. Using Principal Component Analysis (PCA), CoDI optimally combines the Standardized Precipitation Index (SPI), Standardized Soil Moisture Index (SSI), and Standardized Runoff Index (SRI) with continent-specific probability distributions. We validated CoDI across sixty (60) major basins spanning multiple continents and against 22 historical drought events. The CoDI demonstrates substantial agreement with other indices in capturing historical and seasonal drought events, including scPDSI and SPEI. The Terrestrial Water Storage Anomaly (TWSa) response to CoDI exhibits short lag time (0 to 2 months) in the majority of the 60 selected basins, in contrast to the scPDSI, which displays longer lag times. The CoDI was able to capture the seasonal drought events in the Australia’s southwestern region that occurred from January to March 2011 while the SPEI_cru captured only the January drought event. This demonstrate the capability of CoDI to capture different types of drought conditions compare to the SPEI and the importance of integrating meteorological, hydrological, and agricultural drought components. Global drought characterization from 1982 to 2018 identified key drought hotspots in the Sahel, Central Asia, and parts of South America, with drought duration ranging from 40-131 months. CoDI provides consistent drought characterization across diverse hydroclimatic regimes at multiple timescales, enabling improved early warning, water resource management, and climate adaptation strategies. This framework represents a significant advancement in transforming drought monitoring from single-variable approaches to integrated, multidimensional assessment.}
}
@article{DENG2026135434,
title = {A generalized enhanced snow/ice index based on Landsat imagery for accurate snow/ice mapping in mountainous areas},
journal = {Journal of Hydrology},
volume = {673},
pages = {135434},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135434},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005317},
author = {Gang Deng and Xiuguo Liu and Qihao Chen and Zhiguang Tang and He Chen and Zhaojun Zheng and Tongchang Zhang and Yan He},
keywords = {Snow/ice index, Snow cover, Glacier, Remote sensing, Landsat images},
abstract = {Accurate mapping of snow/ice cover is vital for water resource management, ecological security, and climate change research. However, existing methods face notable challenges under complex land surface conditions, such as snow cover–vegetation mixing and snow/ice–water confusion, and their performance in typical snow/ice-covered areas lacks systematic evaluation. This study proposed the Generalized Enhanced Snow/Ice Index (GESII) based on Landsat imagery and developed a corresponding GESII-based mapping method. A comprehensive evaluation was conducted in two representative regions—the western United States and High Mountain Asia (HMA)—comparing the GESII-based method with seven representative methods. Results show that the GESII-based method exhibits outstanding spatial detection capability in both seasonal snow-covered and glacial areas. It performs especially well in vegetation-mixed seasonal snow-covered area and effectively differentiates snow/ice from water body, including glacial lakes in glacial area.Validation using high-resolution Airborne Snow Observatory (ASO) snow products in the western United States shows that the GESII-based method achieves the relatively higher accuracy performance among all evaluated methods, with an overall accuracy (OA) of 0.937, Recall of 0.942, F1 score of 0.925, and a Kappa coefficient of 0.807. It also maintains robust performance under varying snow depth thresholds in HMA. Furthermore, the GESII-based method consistently delivers high accuracy across various land cover types and surface topography conditions. Overall, the qualitative and quantitative results indicate that the GESII-based method performs well for snow/ice mapping using Landsat imagery. Owing to the similar spectral configurations of other optical sensors (e.g., Sentinel-2), the proposed method also shows potential for extension to multi-sensor applications and large-scale or global snow/ice mapping in future studies.}
}
@article{WHITFIELD2026135389,
title = {Rogue and extreme floods in North America},
journal = {Journal of Hydrology},
volume = {673},
pages = {135389},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135389},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004865},
author = {Paul H. Whitfield and Donald H. Burn},
keywords = {Rogue floods, Flood timing, Flood magnitude, Outliers},
abstract = {Unusual flood events are important for understanding the nature of the flood regime of a watershed and for identifying changes to the flood regime at a location. This study presents a methodology to identify Flood-of-Record (FoR) events that are large in magnitude but occur outside the most common flood season. The method combines detection of single dimension magnitude and timing outliers, and multi-dimensional magnitude/timing density outliers. Conceptually, the flood-of-record is generally well known; the methods here identify large FoR events that are outliers in several distinct ways that are thus considered Rogue events. These events that are particularly interesting are outside the commonly observed timing of events that suggests a different generating process, i.e., they are completely different to the ‘regular’ flood-generating mechanism. An example would be a nival catchment where the annual peak is usually from snowmelt in spring/summer, but large events that occurred in fall or winter are generated by an alternate process [hurricane, atmospheric river]. The methodology is applied to more than 2100 natural streamflow hydrometric stations across North America. The spatial and temporal distributions of these events are compared. Rogue events are often associated with atmospheric phenomenon that occur outside the normal high flow period, which in North America is associated with snowmelt. The implications of these Rogue events in flood frequency analysis and in trend studies are discussed.}
}
@article{JIN2026135397,
title = {Microbial effects on single-well push–pull tests: Insights into bioclogging and parameter estimation},
journal = {Journal of Hydrology},
volume = {673},
pages = {135397},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135397},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004944},
author = {Aohan Jin and Eungyu Park and Hongbin Zhan and Wenguang Shi and Quanrong Wang},
keywords = {SWPP test, Biogeochemical reactions, Microbial effects, Parameter estimation},
abstract = {Single-well push–pull (SWPP) test models typically assume a steady-state flow field and are primarily designed to determine reactive transport parameters. When water-level responses are monitored during SWPP tests, they can additionally be exploited to estimate hydraulic properties, such as hydraulic conductivity. However, previous SWPP models neglected the bioclogging effect induced by elevated dissolved oxygen (DO), particularly in petroleum-contaminated aquifers. In this study, we develop a multispecies reactive transport model of a microbial-mediated SWPP test under transient flow field, considering the bioclogging-induced spatiotemporal variations in porosity and hydraulic conductivity. The Markov chain Monte Carlo (MCMC) algorithm is employed for parameter estimation and uncertainty quantification. Results indicate that microbial growth reduces near-wellbore porosity and hydraulic conductivity by approximately 32.2% and 45.7%, respectively, which results in an anomalous hydraulic head bulge at the late stage of the injection phase and an earlier arrival in the breakthrough curve during the extraction phase. Additionally, high DO and substrate concentrations lead to greater underestimation of hydraulic conductivity (Kr), porosity (θ), and dispersivity (αr) by roughly 47.9%, 68.0% and 37.0%, respectively. This demonstrates that neglecting bioclogging in SWPP models may introduce substantial errors in the estimation of both flow and transport parameters. More importantly, increasing injection rate (Qinj) significantly increases the accuracy of the estimated of Kr, θ and αr by approximately 4.4%, 23.7% and 41.0%, respectively. Accordingly, for SWPP models that do not consider bioclogging, we suggest using a higher injection rate and a longer injection time to determine the flow and transport parameters in petroleum-contaminated aquifers.}
}
@article{LIU2026135489,
title = {Conceptualizing a spring flood classification for cold regions based on water available for runoff mechanisms},
journal = {Journal of Hydrology},
volume = {673},
pages = {135489},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135489},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600586X},
author = {Fan Liu and Yuefeng Wang and Guangxin Zhang and Y. Jun Xu and Fengping Li},
keywords = {Cold region spring floods, Water available for runoff mechanisms, Flood generation mechanisms, Machine learning models, Rain-on-snow, Songhua River Basin},
abstract = {Spring snowmelt floods in cold regions are undergoing significant changes due to climate change. Understanding their driving mechanisms is essential for flood risk assessment and water resources management, particularly in higher latitude regions. This study aimed to determine the dominant drivers of different flood types in spring snowmelt floods for China’s far northeast cold region, the Songhua River Basin (SRB). Future changes in floods under different mechanisms were projected by integrating the Variable Infiltration Capacity (VIC) hydrological model and CMIP6 scenarios. Three primary mechanisms were identified including rainfall-dominating (RAIN), snowmelt-dominating (MELT), and rain-on-snow-dominating (ROS). Based upon, we developed a triangle concept demonstrating the dominant water source for runoff in spring floods classification in cold regions. We then applied this concept to China’s far northeast cold region of 561,200 km2 for the period from 2006 to 2020 as well as for two climate change scenarios, i.e., SSP2-4.5 and SSP5-8.5. The study found a shifted spring snowmelt flood regime across the river basin, characterized by an earlier onset of flood peak but a reduced peak discharge. Between 2006 and 2020, ROS was the dominant flood type, accounting for 74.56% of all events. Key drivers of flood peaks and total runoff varied significantly across flood types. Under both climate change scenarios, our modeling found that this cold region will likely experience a pronounced shift toward RAIN-dominating floods, with RAIN events increasing to 63.8% and 70.6%, respectively, while MELT and ROS events decline substantially.}
}
@article{ATTIA2026135377,
title = {Integration of airborne geophysical data and saltwater intrusion modeling to assess alluvial aquifer dynamics: salinization, upconing, and management implications},
journal = {Journal of Hydrology},
volume = {673},
pages = {135377},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135377},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004749},
author = {Michael Attia and Shuo Yang and Yuqi Song and Frank T.-C. Tsai},
keywords = {Airborne electromagnetic resistivity, Groundwater modeling, Hybrid machine learning–physics modeling, Saltwater intrusion, Mississippi River Valley alluvial aquifer},
abstract = {This study investigates the dynamics of groundwater flow along with salt plume migration mapped from airborne electromagnetic (AEM) surveys in the Mississippi River Valley alluvial aquifer (MRVA). A high‑resolution MRVA groundwater model, derived through AEM–borehole data fusion, was implemented in physics‑based modeling (MODFLOW 6) and integrated with the Mississippi embayment model to simulate inter‑aquifer groundwater exchanges. The MRVA groundwater model includes hydrologic variables, such as surficial recharge, stream-aquifer interactions, and groundwater withdrawals. An iterative ensemble smoother (iES) method was used for model calibration to estimate model parameters, and model performance was evaluated using spatially distributed error metrics. A density-varied two-way coupled saltwater intrusion model was employed to predict progressive saltwater upconing from 2025 to 2045 arising from the MRVA base due to groundwater pumping after the calibration period of 2020–2024. The MRVA geological framework and initial chloride distribution were informed by machine‑learning‑assisted interpretation of AEM, borehole data, and water samples; however, all long‑term predictions were performed using physics‑based groundwater flow and solute transport models within a hybrid machine learning–physics modeling framework. The simulation results show three distinct cones of depression in Arkansas and one in Louisiana. Saltwater upconing is likely to occur given the status quo of groundwater pumping in 2020 for the next 25 years. The study highlights the significant influence of groundwater pumping on MRVA groundwater levels and salinization and offers critical insights for effective groundwater management.}
}
@article{PARISAY2026135309,
title = {A bayesian framework for dynamic monthly curve number conditioning using vegetation, soil, and climate proxies},
journal = {Journal of Hydrology},
volume = {673},
pages = {135309},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135309},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004063},
author = {Zahra Parisay and Mahsa Mirdashtvan and Khodayar Abdollahi and Vahedberdi Sheikh},
keywords = {Curve number, Bayesian inference, Dynamic parameter, Rainfall-runoff modeling, Leaf Area Index (LAI), Conceptual hydrology},
abstract = {The Soil Conservation Service Curve Number (SCS-CN) method is a cornerstone of applied hydrology, yet its utility in continuous simulation is hampered by the static nature of its core parameter, the Curve Number (CN). This study introduces a novel Bayesian conditioning framework to transform the CN from a static parameter into a dynamic monthly variable, reflecting time-varying watershed characteristics. We developed a monthly rainfall-runoff model where the CN is probabilistically determined based on three physically meaningful covariates: Leaf Area Index (LAI) derived from MODIS imagery, a soil type parameter (Theta), and the number of monthly rainy days (nr). We tested nine scenarios, varying the discretization of these covariates, in the Arazkuseh watershed, Iran. The results demonstrate that a finer discretization (10 classes) significantly improves model performance. The optimal scenario achieved robust performance in both calibration (Nash-Sutcliffe Efficiency, NSE = 0.61; R2 = 0.73) and validation (NSE = 0.59; R2 = 0.63) periods, with minimal bias (0.03). This dynamic approach allowed the monthly CN to vary realistically from 60 to 82.5, capturing seasonal shifts in vegetation and wetness. This research presents a robust methodology to evolve the classic CN approach into a more physically realistic tool for monthly water balance modeling, leveraging readily available remote sensing data.}
}
@article{AHMMED2026135406,
title = {Appraising aquifer storage recovery (ASR) for irrigation potential in a coastal environment},
journal = {Journal of Hydrology},
volume = {673},
pages = {135406},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135406},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005032},
author = {Md.Helal Ahmmed and Md.Sabbir Hossain and Sara Nowreen and Md. Moniruzzaman and A.H.M. {Shofiul Islam Molla Jamal} and Mohammad Moniruzzaman and Iffat Jahan Shammee and Ratan Kumar Majumder and Afroza Sharmin and Shahrina Akhtar and Nabanita Chowdhury and Saifullah Sayed},
keywords = {Crop water salinity, Freshwater bubble mixing, Irrigation intensification, Isotope signatures, Managed aquifer recharge},
abstract = {Aquifer Storage Recovery (ASR) technology is increasingly utilised to reduce groundwater salinity worldwide, yet its operational effectiveness for coastal agricultural use remains poorly understood. Local farmers in coastal areas are now autonomously adopting ASR without scientific guidance, prompting questions regarding its efficacy. This study evaluated an agricultural ASR system over a three-year period, integrating in-site monitoring (electrical conductivity, water table, infiltration rates, and pumping volume), hydro chemical analyses of major ions (i.e., Na+, K+, Ca2+, Mg2+, Cl−, SO42−, NO3−, HCO3−), microbiological assessments (i.e., faecal and total coliforms), water isotope analyses (δ18O and δ2H) and land use land cover classification using 3-m resolution PlanetScope imagery. Initial benefits of agri-ASR included a 50% increase in dry rice production, a rapid 0.24 m rise in groundwater table during the early monsoon (April − May) under normal rainfall intensities (4–9 mm/hr) and a reduction in biological contaminants from infiltrated surface water. However, recharge rates declined over time despite higher rainfall intensities (21–56 mm/hr). While ASR infiltration momentarily lowered salinity, isotope signatures revealed inadequate freshwater bubble formation, which could not maintain low-saline water throughout the year. Extracting 34–367 m3 (16% of total irrigation demand) from a 3.2 m3 filtration chamber resulted in a swift return to ambient salinity. Infiltration rates (2–2.75 L/min) diminished significantly within 100 min, signifying rapid clogging. These findings, together with irrigation suitability indices, highlight that ASR provides only short-term low-salinity irrigation water unless multiple ASR units, non-rice or salt-tolerant crops, and continuous clogging control are adopted.}
}
@article{YANG2026135422,
title = {ReDF-net: a feature extraction and dynamic fusion framework based on residual networks for runoff forecasting},
journal = {Journal of Hydrology},
volume = {673},
pages = {135422},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135422},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005196},
author = {Zhuo Yang and Dong Wang and Vijay {P. Singh} and Along Zhang and Chenlu Yu and Xiaoyu Ye and Qingwen Deng and Xiankui Zeng and Jianguo Jiang and Jichun Wu},
keywords = {Bidirectional gated recurrent unit, Image feature extraction, Dynamic feature fusion, SHAP interpretability analysis, Precipitation-runoff modeling},
abstract = {Deep learning has become an important tool for rainfall–runoff prediction, achieving strong performance across diverse basins and climatic conditions due to its ability to capture complex nonlinear relationships. In recent years, the rapid growth of satellite remote sensing and reanalysis products has enabled richer hydrometeorological information, driving a shift from unimodal inputs toward multimodal fusion for a more complete representation of hydrological processes. However, existing approaches remain limited: gridded feature extraction and temporal prediction are often performed independently, lacking task-oriented optimization; conventional convolutional architectures struggle with high-dimensional spatiotemporal dependencies and unstable training; and multimodal inputs are rarely accompanied by unified mechanisms to quantify the relative contributions of different modalities. To address these challenges, we propose ReDF-Net, a residual network–based dynamic fusion framework. Learnable attention parameters in an improved ResNet module allow spatial feature extraction to adaptively couple with temporal modeling. Optimized residual blocks enhance the representation of complex multimodal features while improving training stability. A unified contribution quantification module systematically evaluates the relative importance of different inputs, strengthening both physical consistency and interpretability. We integrated ReDF-Net with three mainstream temporal forecasting models (LSTM, GRU, and BiGRU) and evaluated it in two Chinese basins with contrasting climates. Results showed that ReDF-Net coupled with BiGRU achieved the best performance, with Nash–Sutcliffe efficiency (NSE) exceeding 0.97 in both basins, significantly outperforming conventional data-driven baselines (e.g., Random Forest), physically based hydrological modeling using SWAT, baseline models and the state-of-the-art iTransformer. SHAP-based analysis further validated the framework’s interpretability. We present ReDF-Net as a generalizable paradigm for multimodal runoff prediction with improved accuracy and interpretability.}
}
@article{WANG2026135414,
title = {The impact of land use change on the spatiotemporal dynamics of phosphorus cycling in the Yangtze River Basin},
journal = {Journal of Hydrology},
volume = {673},
pages = {135414},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135414},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005111},
author = {Hanzhi Wang and Jiaxue Wang and Yongxin Liao and Yi Lv and Liandong Zhu},
keywords = {Yangtze River Basin, Watershed phosphorus dynamics, Phosphorus emissions, Hydrological transport, Land-use change},
abstract = {Understanding phosphorus (P) dynamics and their interactions with land-use change is essential for effective basin-wide nutrient management. This study integrates an improved P substance flow model with land-use based geospatial downscaling to characterize, for the first time, the spatiotemporal patterns and drivers of P flows in the Yangtze River Basin (YRB) from 2000 to 2020. Human-induced disturbances substantially reshaped P cycling during this period. Rapid economic development, agricultural intensification, and the expansion of large-scale livestock operations collectively amplified anthropogenic P inputs, while P fertilizer use increased by 33.0% but utilization efficiency remained consistently low. Industrial feed use became the dominant driver in the livestock sector, accounting for 33.9% of total feed-related P inputs in 2020. Spatial analysis revealed pronounced P emission hotspots in the highly urbanized middle and lower YRB, where dense impervious surfaces and stronger hydrological connectivity facilitated more efficient P transport to downstream rivers. In contrast, emissions in the upper basin remained relatively stable because anthropogenic pressures were lower and the landscape exhibited greater retention capacity. The results indicate that land-use transitions, including the expansion of urban areas and the intensification of cropland use, influence both the magnitude and the spatial distribution of P emissions by changing source patterns and modifying runoff pathways. This study underscores the importance of accounting for land-use change and adopting hydrologically informed management strategies to reduce basin-wide P pollution.}
}
@article{MA2026135441,
title = {Mechanistic two-scale modeling of colloid transport in dual-porosity media: the role of intraparticle diffusion},
journal = {Journal of Hydrology},
volume = {673},
pages = {135441},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135441},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600538X},
author = {Enze Ma and Qiang Zhang and Yuqing Zhao and Chenyan Wen and Jinchi Xie and Jiangwei Zhang and Qian Wang},
keywords = {Colloid transport, Dual-porosity media, Intraparticle diffusion, Mass exchange, Mechanistic modelling},
abstract = {Colloid transport in porous media plays a critical role in subsurface contaminant mobility, water quality evolution, and the long-term performance of natural and engineered filtration systems. Despite substantial advances in colloid transport modelling, existing approaches do not explicitly represent intraparticle diffusion—the process by which colloids penetrate grain-internal micropores and experience rate-limited retention and release. This study develops a mechanistic two-scale model that couples macropore advection–dispersion–deposition with intraparticle radial diffusion and deposition, providing a physically based description of mass exchange between interparticle macropores and intraparticle micropores. The model is non-dimensionalized to identify key controlling parameters and is applied to simulate both continuous-injection and step-injection configurations. Numerical results demonstrate that intraparticle diffusion induces delayed breakthrough, deep retention, strong non-equilibrium exchange, and long-term elution tailing—behaviors that are simplified in conventional mono-porosity models, which prioritize macroscopic transport approximation over explicit internal mass exchange. Systematic variation of the Péclet number (Pe) and intraparticle diffusion ratio (κ) reveals their distinct yet coupled influences on colloid migration and storage dynamics. Model validation against two independent laboratory datasets confirms that explicit treatment of intraparticle diffusion is essential for reproducing the breakthrough behavior and depth-dependent retention observed in dual-porosity materials. Overall, this work provides a robust mechanistic basis for understanding colloid mobility in hierarchical porous structures, with broader environmental implications for predicting colloid-facilitated contaminant transport, assessing groundwater vulnerability, and optimizing filtration and remediation strategies.}
}
@article{WANG2026135462,
title = {Canopy resistance-based modeling of maize evapotranspiration in Heilongjiang Province: a multi-site assessment integrating Sentinel-2 data and ground observations},
journal = {Journal of Hydrology},
volume = {673},
pages = {135462},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135462},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005597},
author = {Biyu Wang and Haofang Yan and Jianyun Zhang and Guoqing Wang and Desheng Zhang and Chuan Zhang and Xuanxuan Wang and Rongxuan Bao and Youwei Liu and Yujing Han and Yida Zeng and Zhongyu Liu and Rongyang Wang},
keywords = {Evapotranspiration, Influencing factors, Canopy resistance, Maize, Vapor pressure deficit},
abstract = {The accurate spatial upscaling of evapotranspiration (λET) models from point to regional scale is crucial for enhancing irrigation efficiency, optimizing water resource allocation, and ensuring food security. However, challenges including model parameter uncertainty and data fusion complexity have significantly limited the reliability and broad application of these models. In this study, based on the Penman-Monteith (PM) framework, three canopy resistance (rc)-based λET models were developed using observations from a Bowen Ratio Energy Balance (BREB) system and field-measured Leaf Area Index (LAI) data from a maize field in Daoli District, Harbin, Heilongjiang Province, China, collected between 2021 and 2024. These models incorporate aerodynamic resistance (the PMrc-KP model), the canopy-air temperature difference (the PMrc-IS model), and combined meteorological and crop physiological factors (the PMrc-ST model), respectively. Parameterized versions of these models were applied to estimate maize λET at 19 representative sites across Heilongjiang Province, utilizing Sentinel-2 high-resolution remote sensing data and ground meteorological observations. The model estimates were validated against ERA5-Land reanalysis data. The results indicate that the PMrc-ST model consistently outperformed the PMrc-KP and PMrc-IS models at all sites. The λET estimates from the PMrc-ST model achieved R2 values above 0.92, with RMSE ranging from 36.92 to 96.37 W m−2 across sites. The PMrc-KP model ranked second in performance, while the PMrc-IS model showed relatively lower accuracy, with notably higher RMSE and MAE values. Vapor Pressure Deficit (VPD) was identified as the primary factor influencing the performance of all three models, showing a significant positive correlation with model residuals. In contrast, LAI exhibited a significant negative correlation with the residuals of the PMrc-ST model. Regional climate differences introduced considerable spatial variability in model performance. Highest accuracy was observed at sites in humid regions, such as Baoqing and Jixi, whereas performance was constrained at sites like Anda (semi-arid) and Huma (cold, high-latitude) due to water and heat stress. This study provides valuable insights for regional farmland-scale λET estimation and demonstrates the potential application of such models for precision agricultural water management.}
}
@article{ALFATTA2026135438,
title = {Quantifying groundwater depletion in an agricultural region using integrated in-situ and satellite-based approaches: insights from the San Luis Valley, CO},
journal = {Journal of Hydrology},
volume = {673},
pages = {135438},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135438},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005354},
author = {Abdullah {Al Fatta} and Ryan Smith and Sanaz Vajedian and Willem Schreuder and James J. Butler},
keywords = {Groundwater, Pumping, Net inflow, Water level, InSAR, Storativity, Time-varying recharge},
abstract = {Sustainable groundwater management requires accurate tools to assess changes in aquifer storage as climate extremes intensify and water demand grows. Currently, inadequate in-situ data and uncertainty in storativity estimates limit such assessments. We address these challenges by integrating in-situ observations with Interferometric Synthetic Aperture Radar (InSAR) to estimate aquifer properties and groundwater storage change in Colorado’s San Luis Valley. We estimate storativity for management subdistricts based on the relationship between pumping and water levels, comparing a constant net inflow assumption against a refined time-varying net inflow regression that incorporates climate drivers. Both approaches yield consistent results across diverse hydrogeological settings, producing storativity estimates ranging from 0.03 in primarily confined aquifers to 0.21 in unconfined aquifers. Our results reveal a declining trend in groundwater storage, with a total storage loss of 6.3×108 m3 from coarse-grained layers for our studied subdistricts from 2010 to 2023, driven primarily by drought conditions. We further quantified the partitioning of storage loss, finding that in regions with significant pumping from confined aquifers, inelastic compaction accounts for a much higher portion of the total water withdrawn (39%) compared to regions where pumping is mainly from the unconfined aquifer (9%). In that case, gravity drainage is the dominant mechanism. Conversely, confined aquifers with no long-term depletion show elastic deformation patterns, with no storage loss in fine-grained units. This research offers a transferable framework for assessing groundwater storage loss and prospects for sustainability in data-limited regions and supports adaptive management in water-stressed basins worldwide.}
}
@article{LI2026135352,
title = {A flood peak prediction in data-scarce mountain river basins considering the time distribution of rainfall},
journal = {Journal of Hydrology},
volume = {673},
pages = {135352},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135352},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600449X},
author = {Siming Li and Lu Chen and Binlin Yang and Bin Yi and Zhiyuan Leng and Tao Xie and Yang Song},
keywords = {Flood peak prediction, Rainfall-time distribution, Mountain river basins, Data-scarce basins, Hydrological modeling, Flood peak prediction model},
abstract = {Flood prediction has garnered significant attention due to its vital role in disaster risk reduction, and water resource management. However, in data-scarce mountain river basins, accurate flood peak prediction remains challenging due to the limitations of conventional models in handling sparse data, the neglect of rainfall-time distribution effects, and the lack of a mechanism-based approach to integrate key factors such as initial soil moisture and nonlinear responses. To overcome these limitations, this paper proposes a novel flood peak prediction model considering rainfall-time distribution (RTD-FPP), which requires only few parameters. Moreover, the model not only utilizes simple input data but is also grounded in runoff generation and routing mechanisms, comprehensively incorporating the effects of rainfall-time distribution, initial soil moisture, and nonlinear factors on flood peak. The model is applied to hundreds of flood events in eight catchments, and compared with the Xin’anjiang (XAJ) model using five statistical metrics on the premise of ensuring sufficient data required by the XAJ model. Results indicate that RTD-FPP exhibits an average improvement of approximately 44%, 288% and 40% in coefficient of determination (R2), Nash-Sutcliffe efficiency coefficient (NSEC) and qualified rate (QR) values, respectively. The average reductions in root mean squared error (RMSE) and mean absolute relative error (MARE) values are approximately 64% and 56%, respectively. It is evident that the proposed method contributes to flood risk management.}
}
@article{LIU2026135446,
title = {A hybrid machine learning and optimal stomatal behavior model to reveal the role of vegetation dynamics in potential evapotranspiration and drought},
journal = {Journal of Hydrology},
volume = {673},
pages = {135446},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135446},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005433},
author = {Weiqi Liu and Shaoxiu Ma and Haiyang Xi and Bingyao Wang and Kun Feng and Atsushi Tsunekawa},
keywords = {Potential evapotranspiration, Drought monitoring, Vegetation effects, Canopy resistance, Physics-based constraint},
abstract = {Potential evapotranspiration (PET) is a key component of the terrestrial water cycle, and its estimation accuracy directly affects the reliability of drought monitoring. The FAO56 Penman–Monteith method is widely regarded as a standard PET model in drought monitoring. However, it employs a static, non-water-limited canopy resistance parameter (rcNWL), which fails to fully capture the regulatory effects of vegetation on PET and drought. In this study, we investigated the canopy resistance (rc) models from empirical, process-based, machine learning, and physically constrained machine learning approaches based on worldwide eddy flux data and remote sensing data to simulate dynamic rcNWL, aiming to build up a PET model that accounts for vegetation dynamics and hence represents drought realistically. The results indicated that the hybrid machine learning and optimal stomatal behavior (rc-USO-ML) is the best model to simulate dynamics of canopy conductance behavior (highest Global Performance Indicator, GPI), as rc-USO-ML model significantly outperforming traditional empirical (rc-Jarvis) and process-based (rc-USO-Lin) models. Following the PET assumption, we formulated the PETrcNWL-USO-ML model by removing the soil water stress on rc-USO-ML. Compared with conventional PET models, the PETrcNWL-USO-ML model more accurately reproduced observed PET (R2 > 0.85, RMSE < 0.66 mm/day), and showed stronger increasing trends in PET and drought characteristics. Notably, in the arid regions of northwest China, neglecting vegetation dynamics led to an underestimation of increasing trends in drought duration, severity, and intensity by 74%, 51%, and 23%, respectively. Overall, this study highlighted the necessity of fully accounting for the integrated effects of vegetation physiology in drought monitoring and future risk assessments.}
}
@article{XIE2026135421,
title = {Deep reinforcement learning for long-horizon reservoir operation: Temporal horizon, state representation, and hydrological data synthesis},
journal = {Journal of Hydrology},
volume = {673},
pages = {135421},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135421},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005184},
author = {Zaichao Xie and Minglei Ren and Wei Xu and Te Zhang and Bing Zhu and Dong Li and Shuncai Zhang and Junbo Wang},
keywords = {Reservoir operation, Deep reinforcement learning, Episode length, State representation, Synthetic inflow},
abstract = {Deep reinforcement learning offers a flexible paradigm for reservoir operation. However, its deployment in long-horizon settings remains difficult when rewards must be propagated across years under strong seasonal regularities and limited multi-year inflow trajectories. Principled designs for episode horizons, seasonality-aware states, and inflow data augmentation are still lacking. This study aims to develop a DRL environment tailored to long-horizon reservoir operation and systematically evaluate its performance. First, five episode-length configurations are compared within a unified Actor-Critic framework to determine the case-specific optimal training horizon for the Three Gorges Reservoir (TGR). Second, a state-space ablation study is conducted to quantify the independent contribution of each state dimension. Third, a synthetic inflow generation scheme is proposed to mitigate data scarcity. The scheme integrates STL (seasonality-trend-remainder) decomposition, autoregressive modeling, and Markov year-type transitions to synthesize hydrologically consistent inflow data. The results from the TGR case study show that a 4-year episode length achieves an optimal balance between training efficiency and value-estimation stability. Two-dimensional periodic date encoding yields an 85.5% performance improvement over the baseline without date encoding by endowing the agent with explicit seasonality awareness. The proposed synthetic inflow scheme generates large-scale training data while closely preserving key multi-scale hydrological statistics and enables robust policy performance under consecutive extreme inflow scenarios. The DRL environment, state representation, and data-generation designs developed in this study provide reusable methodological templates for DRL development and deployment in long-horizon reservoir operation.}
}
@article{ASIRI2026135386,
title = {Surrogate modelling of dispersive, variable-density flow with application to seawater intrusion in leaky offshore aquifers},
journal = {Journal of Hydrology},
volume = {673},
pages = {135386},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135386},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600483X},
author = {Zayed Mohammed Asiri and Anthony D. Miller and Adrian D. Werner and Sergiy Shelyag},
keywords = {Computational modelling, Freshwater-saltwater interface, Offshore fresh groundwater, Dispersive correction factor, Coastal aquifer},
abstract = {In this study, we develop a surrogate model for the efficient estimation of the seawater extent in leaky offshore aquifers, in which the dispersive mixing zone is represented approximately. The model is trained using factorial sampling of a five-parameter non-dimensional parameter space. The samples are modelled with a numerical code (SEAWAT), and the results are used to correct the parameters of a two-parameter semi-analytical sharp-interface model to take into account the mixing zone, which is represented by the 5% and 50% seawater concentration contours (isochlors). These corrections allow both the tip and the toe (where a specified isochlor meets the top and bottom, respectively, of the aquifer) to be approximated. The method applies corrections to the freshwater–seawater density difference, the rate of freshwater inflow, and the head drop across the offshore aquitard, allowing the semi-analytical approach to match the dispersive, numerical solution. This approach builds on previous dispersive correction formulae developed for onshore coastal aquifers. This surrogate model requires that the tip is located offshore and provides a rapid method for estimating the offshore freshwater extent and volume, and any seawater intrusion (represented by a shift from one steady-state condition to another) arising from changes to the stresses of the system, e.g., due to sea-level rise or modified submarine groundwater discharge. A macro-enabled Excel workbook implementing the correction is provided to disseminate the methodology. This is available at https://github.com/ZAsiri/Surrogate-Model-.git.}
}
@article{XU2026135449,
title = {Hydro-meteorological drivers of spatiotemporal variability in lake water storage across China: Evidence from ICESat-2},
journal = {Journal of Hydrology},
volume = {673},
pages = {135449},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135449},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005469},
author = {Haowei Xu and Jingru Zhou and Fei Zhang and Chi Yung Jim and Mou Leong Tan and Shuping Pan and Lifei Wei and Dong Liu and Xu Ma and Changjiang Liu},
keywords = {Chinese lake, Water level, Water storage, Climate change, Extreme drought, Machine learning model},
abstract = {Lakes are crucial indicators and regulators of climate change, moderators of regional climate dynamics, and pointers of global environmental shifts. However, the underlying meteorological and hydrological mechanisms shaping lake water levels remain inadequately understood. This study leveraged ICESat-2 satellite data to measure the water level of 237 medium and large lakes across China’s five lake regions in 2019‒2024. Four machine learning models were employed to fill missing water-level data, facilitating a detailed examination of the spatiotemporal dynamics in seasonal variations of lake water level (LWLsv) and lake water storage (LWSsv). Sixteen feature climatic, hydrological and surface-physical variables were selected for modeling. Correlation and trend analyses assessed the impact of drought factors, as measured by meteorological and hydrological drought indices, on LWSsv changes under compound conditions. The findings reveal that: (1) ICESat-2 satellites provide effective monitoring of LWL changes despite data gaps for some lakes due to size and shape limitations; (2) Among the tested models, XGBoost demonstrated superior performance, highlighting significant spatial variability in LWLsv across China’s lakes, discovering a macro-scale nationwide pattern of “higher levels in the east, lower levels in the west, stable in plateaus, and large fluctuations in plains”; (3) From 2019 to 2024, the total LWSsv for Chinese lakes reached 53.80 Gt, mirroring considerable inter-regional spatial heterogeneity in LWLsv patterns. Lakes in the middle and lower Yangtze River accounted for approximately 50% of the national LWSsv, while the Qiangtang Plateau’s inland lakes ranked second due to their abundance and size; (4) Water storage fluctuations displayed distinct responses to meteorological, hydrological, and compound conditions, with around 140 lakes influenced jointly by climatic and hydrological factors. The dominant drivers showed notable regional variations, reflecting the intricate interactions between meteorological and hydrological processes in lake ecosystems. The findings offer key scientific insights for water hydrological management and biodiversity conservation.}
}
@article{LABBE2026135336,
title = {A new approach for groundwater fluxes assessment in alluvial aquifers using active-DTS with a Brillouin-based sensor},
journal = {Journal of Hydrology},
volume = {673},
pages = {135336},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135336},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004336},
author = {Jordan Labbe and Maxime Romanet and Hélène Celle and Maxime Zerbib and Kien Phan Huy and Alexandre Matic and Victor Klaba and Gilles Mailhot and Jean-Charles Beugnot},
keywords = {Brillouin, Active-DTS, Fiber optic, Groundwater flux, Alluvial aquifer},
abstract = {Fiber optic distributed temperature sensing has become a widely used approach to estimate groundwater fluxes in various hydrogeological contexts. Raman-based sensors are the most commonly adopted DTS units but they rely on calibration baths that may be challenging to maintain for experiments extending over several days. In this paper, a novel method using a Brillouin-based sensor (DITEST) is proposed. This approach relies on the linear relationship between the Brillouin Frequency Shift and the fiber temperature which is not affected by optical losses. The proposed methodology was tested at the experimental site of Port-Douvot where an Electrical Resistivity Tomography profile and a core sample were conducted to assess vertical and lateral heterogeneities. These investigations have identified that the alluvial deposits extend to an average thickness of 10 m with a top layer of clayey sands (∼5 m) overlying a second layer of coarse gravel and pebbles (∼5 m). Point Dilution Tests were carried out to investigate the range of possible groundwater fluxes q, the results of which have revealed fluxes ranging from 1.2 × 10−5 to 8.2 × 10−7 m/s. Brillouin active-DTS measurements were conducted with a spatial resolution of 1 m, a sampling interval of 0.25 m and a temperature sensitivity of 0.2°C. The vertical variations of horizontal groundwater fluxes q are consistent with subsurface heterogeneities. Estimated fluxes spanned a shorter interval than Point Dilution Tests, between 1.0 × 10−7 to 7.0 × 10−7 m/s, but remain plausible. The fact that frequency measurements are absolute and do not require any field calibration makes Brillouin sensing an attractive tool for long-term monitoring.}
}
@article{TANG2026135425,
title = {Global reservoir storage patterns from 2001 to 2023 characterized by satellite observations and their climatic attribution},
journal = {Journal of Hydrology},
volume = {673},
pages = {135425},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135425},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005226},
author = {Li Tang and Xin Yin and Zhiwen Xiong},
keywords = {Reservoir storage, Satellite observation, Filling state, Anthropogenic-climatic attribution, SPEI, Climate change, Water management},
abstract = {Reservoir storage is critical for water security, yet understanding global patterns is hindered by restricted in-situ data. While recent altimetry studies assess annual fill-up trends for limited sites, global monthly filling states and their anthropogenic-climatic drivers remain poorly understood. This study addresses this gap by reconstructing monthly storage for 6,573 reservoirs (2001–2023) using satellite areas and bathymetry curves. We provide the first comprehensive validation using 542 in-situ data, achieving a median CC of 0.76 and an anomaly CC of 0.8. Results reveal divergent filling disparities across reservoir types where hydroelectric reservoirs exhibit a 51.2% frequency of High-Storage States (HSS, flood-limit or > 60% capacity), whereas arid irrigation reservoirs reach Low-Storage Extremes (LSE, <20% capacity) at a 25.2% frequency. 2011 was identified as a critical hydro-climatic pivot because the annual occurrence of reservoirs experiencing at least one HSS per year (44.3% pre-2011) entered a systemic contraction as global SPEI shifted toward a persistent drying phase. Further, 87.6% of reservoirs are climate-decoupled by human management, whereas 12.4% are predominantly irrigation-dominated and remain tightly coupled to climate (CC > 0.5 with SPEI). These findings can support enhance global reservoir resilience under intensifying climate challenges.}
}
@article{CHEN2026135477,
title = {Real-time and accurate burst localization in water distribution networks with graph-based deep learning},
journal = {Journal of Hydrology},
volume = {673},
pages = {135477},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135477},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005743},
author = {Lei Chen and Tao Tao and Li He and Xiao Zhou and Pijun Duan and Zhiyu Shao and Haiyuan Ma and Hongxiang Chai},
keywords = {Water distribution network, Pipe burst, Burst localization, Graph neural network, Topological simplification},
abstract = {Pipe burst events in water distribution networks (WDNs) are highly disruptive, causing severe water losses and threatening urban infrastructure. Accurate real-time burst localization is critical for improving system reliability and enhancing urban resilience. However, most existing methods rely solely on pressure and flow data, overlooking the role of WDNs’ topology in the propagation of hydraulic information. This limitation reduces their capability to accurately characterize burst-induced disturbances, especially when monitoring data are sparse. Moreover, it remains unclear whether deep learning models trained with hydraulic simulation data can be effectively applied to real-world scenarios, particularly when model simplifications are present. To address these challenges, this study proposes a Real-Time Burst Localization Framework based on Graph Neural Networks (RBLFG), which balances responsiveness and accuracy. A Multi-Scale Attentional Graph Convolutional Network (MA-GCN) is developed to integrate hydraulic data with network topology. Validation across three representative networks shows that MA-GCN achieves average localization accuracy of 80.99% in small-scale WDNs and 97.2% in medium-scale WDNs. In a large-scale real-world case, the model localized bursts within 52.78 m using data from only a single burst time step. Furthermore, this study demonstrates that models trained on simplified hydraulic simulations can still achieve localization within 500 m in a 24-km system. These findings demonstrate the effectiveness and practical applicability of the proposed framework for real-time, high-precision burst localization in complex WDNs.}
}
@article{WANG2026135360,
title = {A novel temporal distribution smoothing alignment network for water level interval forecasting in hydropower systems},
journal = {Journal of Hydrology},
volume = {673},
pages = {135360},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135360},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004579},
author = {Jiayang Wang and Liangyu Pan and Xinran Li and Yang Zhou},
keywords = {Water level interval forecasting, Deep learning, Temporal distribution shift, Domain generalization, Pinball loss},
abstract = {Accurate water level forecasting is critical for hydropower scheduling and disaster prevention. However, most existing methods assume that training and testing data are independently and identically distributed (i.i.d.), overlooking the temporal distribution shift commonly observed in real-world scenarios. Moreover, traditional point forecasting models lack the capability to quantify predictive uncertainty, limiting their reliability under extreme conditions. To address these challenges, we propose a novel Temporal Distribution Smoothing Alignment Network (TDSAN) for water level interval forecasting under dynamic temporal distribution shifts. Specifically, a Gaussian Mixture Model (GMM) is first employed to segment the dataset into subdomains with distinct distributions. Then, based on a modified Domain Adversarial Neural Network (DANN), the proposed framework learns domain-invariant features through adversarial training. Furthermore, to enable interval prediction and enhance the stability of the training process, we introduce a Huber-regularized Pinball loss. Extensive experiments on the Barra Grande Hydroelectric Dam dataset demonstrate that TDSAN significantly outperforms baseline and Transformer-based models in both point and interval prediction metrics.}
}
@article{ZOGHI2026135433,
title = {Lessons learned from the modeling of nature-based solutions for urban flood mitigation in Ottawa, Canada},
journal = {Journal of Hydrology},
volume = {673},
pages = {135433},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135433},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005305},
author = {Ali Zoghi and Ryan Cooke and Muhammad Naveed Khaliq and Jennifer Drake},
keywords = {SWMM, Hydrologic modeling, Blue-green infrastructure, Flood-resilience, Low impact development, Urban land use planning},
abstract = {Urbanization has expanded impervious surfaces globally, increasing surface flood risk—a challenge intensified by climate change. Nature-Based Solutions are increasingly adopted to manage urban stormwater and restore hydrologic function. This study evaluates the flood mitigation potential of bioretention cells (BRCs) in two Ottawa catchments called Byron & Golden, and Crystal Beach, using two modeling approaches: (1) Lot-level delineation, assigning subcatchments to individual properties, and (2) Topographic delineation, based on natural drainage patterns. City of Ottawa provided PCSWMM models were refined and calibrated to simulate BRC performance under three scenarios: placement only in the road right-of-way (ROW), only on private property (PRIV), and Full-scale implementation (both). Simulations were conducted for 10-, 50-, and 100-year 4-hour Chicago design storms, as well as for the observed August 2023 flash flood event. Results show that BRCs significantly reduced flood volume, peak discharge, and inundation extent, with Full-scale implementation achieving the greatest reductions. Across all storms and catchments, flood volume reductions ranged from 12 to 56% and peak flow reductions ranged from 12.5 to 63%, while flooded extent reductions ranged from 10 to 75% (Full-scale: 39–75%). PRIV configurations often produced larger absolute reductions due to more distributed runoff capture and infiltration. However, per-hectare analysis revealed that ROW BRCs sometimes had higher efficiency, particularly in Crystal Beach under topographic routing. Topographic models, which routed surface flow over pervious areas, projected greater reductions (in total flood volume, peak flow, and flooded extent) than lot-level models, which routed flow towards impervious roadways. The August 2023 storm, despite similar rainfall depth to the 50-year event (74.6 vs. 70 mm), yielded stronger reductions due to its front-loaded hyetograph—e.g., Full-scale flood-volume reductions were 29–48% in Crystal Beach and 35–56% in Byron & Golden. The findings of this study underscore the importance of distributed BRCs, performance normalization, and testing under both synthetic and observed storms to inform urban flood mitigation strategies.}
}
@article{XIA2026135444,
title = {The interactive effects of climate and land-use changes on soil water erosion across China under shared socioeconomic pathways},
journal = {Journal of Hydrology},
volume = {673},
pages = {135444},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135444},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600541X},
author = {Yujin Xia and Wen Dai and Qigen Lin and Yuqi Wang and Wei Shao and Guojie Wang},
keywords = {China, Soil water erosion, RUSLE, Climate change, Land-use change, Driving factor contribution},
abstract = {Soil erosion results from the combined effects of natural processes and human activities, with climate change and land use change recognized as two key drivers influencing the future evolution of erosion risk. However, their independent and interactive contributions to soil erosion under different emission pathways remain insufficiently quantified. Based on the Revised Universal Soil Loss Equation (RUSLE), this study utilizes rainfall erosivity derived from a multi-model ensemble (MME) of 18 CMIP6 global climate models (GCMs) and land use data to assess soil erosion changes in China during 2025–2050 under different shared socioeconomic pathways scenarios (SSPs). The relative contributions of climate change, land use change, and their interaction are systematically decomposed. Results show that climate change generally intensifies soil erosion across China. Under the climate-change-only scenario (R-only), the area with increasing erosion expands as emission intensity rises. Its proportion reaches a maximum of 11.43% under SSP5-8.5. Land use change exhibits a bidirectional regulating effect on soil erosion. When combined with climate change (R-LULC), national-scale erosion rate decreases by approximately 7%-18%, while areas with significantly increased erosion expand by 1.4%-3.5%. Attribution analysis reveals that land use change dominates erosion changes at the national scale during 2025–2050, contributing over 80% in most scenarios. Although the relative contribution of climate change declines over time, its influence strengthens under SSP5-8.5 in the Eastern Plains and Southeastern Hills Regions. The interaction contribution rate is minor at the national scale (typically below 5%) but remains non-negligible in regions such as Northwestern Basins. These findings quantitatively characterize the relative contributions of climate change, land use change, and their interaction on soil erosion changes, providing a scientific basis for future soil and water conservation policy assessment and regional adaptive management.}
}
@article{YU2026135473,
title = {Spatiotemporal dynamics of greenhouse gas emissions under land-use change in coastal diversion canals},
journal = {Journal of Hydrology},
volume = {673},
pages = {135473},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135473},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005706},
author = {Mingye Yu and Peiyuan Zhu and Xiaogang Chen and Yan Zhang and Xingyu Chen and Ling Li},
abstract = {Coastal diversion canals (CDCs) have emerged as critical hotspots for greenhouse gas (GHG) emissions, with their dynamics influenced by land-use change. However, the spatiotemporal dynamics of GHG emissions in CDCs characterized by intensified anthropogenic activities and land-use transitions remain poorly understand. This study provides a systematic investigation of GHG driving mechanisms and emission dynamics within a representative CDC system experiencing pronounced land-use transitions, employing a framework that integrates field measurements with biogeochemical assessments. This study demonstrates that land-use patterns exert differential controls on GHG emissions through modulating seasonal hydro-climatic gradients, groundwater dynamics, anthropogenic nutrient loading, and connectivity shifts across heterogeneous catchments. Agricultural areas within the CDC exhibited 2.4- and 1.8-fold increases in CO2 and CH4 emissions, respectively, compared to adjacent wetlands. Seasonal disparities were pronounced, with winter emissions exceeding autumn levels by 5.6-fold (CO2) and 6.2-fold (CH4). When contextualized within global aquatic ecosystems, CDC-driven GHG emissions demonstrated comparable magnitudes to over 50% of coastal aquatic systems. These results underscore the critical role of CDCs in regional carbon cycling and provide foundational data for refining coastal GHG budgets. The study emphasizes the necessity of integrating GHG dynamics under land-use change into climate mitigation frameworks for CDCs undergoing rapid anthropogenic transformation.}
}
@article{GOMEZ2026135429,
title = {Accounting for the uncertainty of precipitation forecasts and its impacts on probabilistic flood inundation mapping skill},
journal = {Journal of Hydrology},
volume = {673},
pages = {135429},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135429},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005263},
author = {Francisco J. Gomez and Keighobad Jafarzadegan and Hamed Moftakhari and Hamid Moradkhani},
keywords = {SFINCS, Quantitative Precipitation Forecast, Flood Inundation Mapping, HRRR, Hurricane},
abstract = {Uncertainty in operational weather forecasts, particularly in predicting storm location and precipitation patterns, presents challenges for flood inundation mapping. As hurricane forecasts evolve, spatial discrepancies in precipitation estimates lead to misalignment between forecasted and observed rainfall, affecting flood prediction accuracy. This study implements a storm-position–conditioned Quantitative Precipitation Forecast (QPF) displacement ensemble using HRRR forecasts and propagates those precipitation placement perturbations through a 2D hydrodynamic model (SFINCS) to quantify impacts on deterministic and probabilistic flood inundation mapping. The analysis, focused on Hurricane Beryl (July 2024), evaluates the impact of multiple storm location scenarios over 24-hour forecast periods for cycles generated in 6-hour intervals. QPF fields are used as input to the Super-Fast INundations of CoastS (SFINCS) model, applied to the highly urbanized central Houston area, to generate forecast maps of flood extent and water surface elevations. Results show that incorporating HRRR forecasts and spatial displacement of QPF fields improves the correlation with in-situ meteorological and water elevation observations, reduces biases in predicted flood depths, and better represents the spatial variability of flood impacts across the study area. The probabilistic flood inundation mapping generated through this approach highlights the benefits of ensemble-based forecast integration, providing decision-makers with a range of plausible flooding scenarios. By accounting for uncertainties in storm position, rainfall intensity, and timing, the methodology enhances the reliability and operational value of short-term flood forecasts in urban environments, supporting improved flood risk management and emergency preparedness.}
}
@article{DONG2026135405,
title = {Complex-terrain correction of land surface temperature using a temporal–spatial coupling data-driven model},
journal = {Journal of Hydrology},
volume = {673},
pages = {135405},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135405},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005020},
author = {Ben Dong and Rongcai Song and Lirui Luo and Xiushi Jiang and Haiwen Chen and Bo Li and Feng Zheng and Yingchun Wang},
keywords = {LST, Complex terrain, Terrain correction, Temporal-spatial coupling},
abstract = {Land surface temperature (LST) governs the exchange of energy and water between the land and atmosphere, exerting a fundamental influence on ecological monitoring, agricultural productivity, geothermal resource assessment, and disaster risk reduction. However, in mountainous regions covering approximately 24% of Earth’s land area, complex topography induces significant systematic radiative biases, thereby undermining the reliability of remote sensing products. Here we systematically quantify how terrain attributes (slope, aspect, and shadow) nonlinearly amplify LST variability over two mountainous regions on the eastern Tibetan Plateau: the coefficient of variation increases from ∼5% to ∼12% once slope exceeds 10°, while shadowed slopes exhibit seasonal LST deviations of 3–4 °C. To overcome these distortions, we introduce a Temporal–Spatial Coupling Terrain–Correction Gradient Residual Model (TC-GRM), which integrates dynamic temporal indicators (NDVI, net radiation, atmospheric transmittance) with static terrain descriptors (slope, sky-view factor) in a unified framework. The architecture combines a dual-layer Gated Recurrent Unit (GRU) network with an attention mechanism to capture temporal dynamics, and a localized random forest regression to model nonlinear terrain–vegetation–atmosphere interactions. Applied to Landsat 8 L2_C2 LST products, TC-GRM reduces mean RMSE by ∼40%, sharpens spatial detail by 30–50% in high-slope zones, and improves ground-validation accuracy from an RMSE of 4.2 °C to 1.8 °C (R2 gain: +0.20 to + 0.40). Our findings reveal an overlooked, nonlinear amplification of terrain effects on LST retrievals and demonstrate that TC-GRM delivers robust corrections in rugged terrain. In addition to its regional applications on the Tibetan Plateau, this method utilizes publicly available data to establish a scalable, terrain-aware LST framework. This framework can be used to improve estimates of evapotranspiration and energy-water balance in mountainous areas, support hydrological monitoring and water resources management, and pave the way for the generation of reliable next-generation remote sensing temperature fields.}
}
@article{NADITHAIMBULANA2026135437,
title = {Stochastic modeling of two-dimensional transient unconfined groundwater flow in terms of its time–space evolutionary probability distribution},
journal = {Journal of Hydrology},
volume = {673},
pages = {135437},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135437},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005342},
author = {K.A. {Naditha Imbulana} and M. {Levent Kavvas}},
keywords = {Stochastic, Unconfined aquifer, Uncertainty, Fokker-Planck, Hydraulic head, Source/ sink term},
abstract = {Stochastic models are preferable over deterministic methods in modeling groundwater flow, especially at watershed scales, since they can account for spatial variability and uncertainty of aquifer properties and hydrologic conditions. This study aims to develop a novel stochastic formulation of the two-dimensional governing flow equation for a heterogeneous, anisotropic unconfined aquifer with asymmetric properties, accounting for uncertainties in hydraulic conductivity, source/ sink term, and boundary conditions in the form of a Lagrangian-Eulerian extension of the Fokker-Planck equation (LEFPE). The derived theoretical formulations were used to obtain the time–space evolving ensemble average behavior, standard deviation, and probability density functions, thereby providing a comprehensive model of the probabilistic behavior of the stochastic unconfined aquifer flow process by the methodology developed in this study. The comparison of results against Monte Carlo Simulations showed that the first two moments of the process and the probability density function exhibit strong agreement with those obtained from the Monte Carlo method. Furthermore, the importance of stochastic representation of the source/ sink term, and the effectiveness of stochastic modeling of boundary conditions are evident. Therefore, the results highlight the accuracy and robustness of the LEFPE methodology introduced in this study in capturing the evolutionary probabilistic behavior of the hydraulic head in a heterogeneous, asymmetric unconfined aquifer. Such a model can efficiently facilitate well-informed groundwater management decisions.}
}
@article{YU2026135445,
title = {Performance of turbulence closure models for 3D RANS simulation of urban flooding with exchanges between flooded streets and building openings},
journal = {Journal of Hydrology},
volume = {673},
pages = {135445},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135445},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005421},
author = {Shuyue Yu and Xuefang Li and Vasileios Kitsikoudis and Guilhem Dellinger and Lihua Chen and Chengguang Lai and Léo Guiot and Sébastien Erpicum and Benjamin Dewals},
keywords = {Urban flooding, Flow structure, Turbulence closure model, 3D modelling},
abstract = {Urban flooding poses significant risks to densely populated areas, necessitating accurate predictive models for effective risk management. While 3D computational fluid dynamics (CFD) models are increasingly used to simulate flood dynamics, the selection of an appropriate turbulence closure model remains critical yet underexplored in the context of urban flooding. This study evaluates the performance of three widely used Reynolds-Averaged Navier-Stokes (RANS) turbulence models: standardk-ε, k-ω, andk-ω SST, in simulating urban flooding in an idealized urban district model with flow intrusion into buildings. Based on laboratory experiments reported in the literature, we conducted three-dimensional simulations using OpenFOAM. Nine urban configurations were considered, each with different opening layouts that allow flow intrusion into buildings. The discharge distribution, surface flow patterns, and velocity fields at selected cross-sections were analyzed. Results show that the simulated discharge partitions match the measured values closely and lie within the ± 1.5% uncertainty of the experimental data with all three tested turbulence closures, demonstrating the reliability of the numerical approach. In terms of surface flow and velocity characteristics, the k-ε and k-ω SST models showed better agreement with experimental observations than the k-ω model, particularly in capturing complex surface structures, internal recirculation zones, and along-stream velocity variations. This study provides insights into turbulence model selection for urban flood simulations, particularly those involving flow intrusion into buildings. It constitutes a useful reference for future urban flood modeling.}
}
@article{YU2026135409,
title = {Flood inundation monitoring with multi-source satellite imagery based on deep learning and explainable frameworks},
journal = {Journal of Hydrology},
volume = {673},
pages = {135409},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135409},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005068},
author = {Hongjie Yu and Yue-Ping Xu and Yintao Huang and Yen-Ming Chiang},
keywords = {Deep learning, Explainable, Flood inundation monitoring, Satellite},
abstract = {Flood inundation monitoring using satellite data plays a crucial role in emergency response. To harness the advantages of Multispectral (MS) and Synthetic Aperture Radar (SAR) sensors while mitigating their limitations, an integration of multi-source satellite imagery is crucial. In this study, we introduced U-Net to extract water bodies from scenes captured by Sentinel-1 and Sentinel-2 satellites. The performance of the U-Net model was evaluated using both a standard dataset and real-world cases. Different combinations of multi-source satellite imagery were then compared to investigate the variations across images and identify the most effective inputs. Finally, an explainable framework called Grad-CAM was employed to gain insights into the active regions within the deep learning models’ inner layers. The U-Net model achieved strong segmentation performance on Sentinel-1 imagery, with an overall accuracy of 0.95 and an intersection over union (IoU) of 0.33. The model produced a 1.41% false-water rate and a 34.62% false-dry rate, both outperforming the baseline. When Sentinel-1 and Sentinel-2 data were jointly used as inputs, overall accuracy increased to 0.97 and IoU increased to 0.33, while the false-positive and false-negative rates decreased to 0.86% and 27.85% respectively, surpassing models trained on either data source alone. Additionally, the incorporation of auxiliary information such as DEM further enhanced the model’s performance. The analysis of the shallow layers revealed their remarkable transparency and emphasized the necessity of introducing deep learning architecture in multi-source satellite imagery applications. This study can help enhance the utilization efficiency of multi-source satellite data and improve the understanding of deep learning models used for monitoring flood inundation.}
}
@article{LING2026135461,
title = {Advancing the understanding of drought propagation in glacierized catchments by accounting for meltwater and catchment control in a newly introduced bi-stage framework},
journal = {Journal of Hydrology},
volume = {673},
pages = {135461},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135461},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005585},
author = {Yunan Ling and Yue Huang and Xiaohui Pan and Xiaofei Wang and Tie Liu and Chanjuan Zan and Zhengyang Li and Xi Chen and Philippe De Mayer and Amaury Frankl},
keywords = {Drought propagation, Hydrological drought, Meteorological drought, Glacier, Recharge drought, Standardized glacierized catchment recharge index (SGI)},
abstract = {Because of the influence of glacier meltwater, it is challenging to investigate the propagation process of meteorological drought to hydrological drought in glacierized catchments from the event perspective. To address this challenge, we developed a bi-stage drought propagation analysis framework (BDPF). This framework introduces the concept of recharge drought, establishing an intermediate state between meteorological and hydrological droughts, thereby dividing the propagation process into two stages: one attributed to meltwater release and the other to catchment controls. Using data from 1982 to 2013, we identified drought events using the run theory, evaluated the effectiveness of BDPF, and investigated drought propagation patterns. Our results demonstrated that the BDPF outperformed traditional frameworks in terms of event matching and interpretability. We also captured drought propagation at the intra-annual scale. Specifically, we found that meltwater reduced the drought propagation rate, duration, and severity. While glaciers had a more pronounced effect at the inter-annual scale, catchment snow dynamics has a greater impact at the intra-annual scale. We determined the sensitivity of drought propagation to catchment control as well. Due to the limited capacity of baseflow to buffer drought, the catchment control tended to amplify drought signals, thereby contributing to more prolonged and severe hydrological droughts. This study highlights the key influencing factors and complex dynamics of drought propagation in glacierized catchments, providing a theoretical foundation for early drought warning systems and adaptive water resource management under cold-climate conditions.}
}
@article{WANG2026135453,
title = {Hydrological connectivity–guided localized land use optimization shows potential for watershed–scale nutrient reduction},
journal = {Journal of Hydrology},
volume = {673},
pages = {135453},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135453},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005500},
author = {Yao Wang and Yiqi Yu and Zhongyao Liang and Qibiao Yu and Dan Yu and Nengwang Chen and Xin Luo},
keywords = {Artificial intelligence, Hydrologically sensitive areas, Nutrient flux, Watershed management, Land–sea coordination},
abstract = {Unsustainable land use practices in coastal zones have exacerbated nutrient overloads in aquatic ecosystems under hydrological connection. However, implementing effective strategies for the balance between human development and water environmental protection is crucial for land–sea coordination but remains challenging. Here, we combined geospatial data, multiple data–driven models with transfer learning, and 12–year seasonal water quality monitoring to systematically reveal the linkages between land use, hydrological connectivity, and riverine nutrient fluxes in a representative subtropical watershed in Southeast China. We found that hydrologically sensitive areas (HSAs), despite covering less than 20% of the watershed area, show disproportionately strong statistical associations with riverine nutrient fluxes. Reducing anthropogenic lands (agricultural and built–up lands) or related human activities in small–area HSAs is significantly associated with reduced riverine nitrogen and phosphorus exports to the coast across seasons (p < 0.001), with the strength of these associations comparable to those observed at the watershed–scale. This approach suggests a potentially cost–effective solution for precision water pollution control and systematic watershed management, supporting the land–sea coordination strategy.}
}
@article{LI2026135472,
title = {Vertical profiling of phytoplankton biomass in a large deep reservoir: patterns and controlling factors},
journal = {Journal of Hydrology},
volume = {673},
pages = {135472},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135472},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600569X},
author = {Yuan Li and Kun Shi and Yulong Guo and Mengyuan Zhu and Huiyun Li and Song Miao},
keywords = {Xin’anjiang Reservoir, Phytoplankton biomass profile, XGBoost, SHAP, Meteorological and hydrological factors},
abstract = {In aquatic ecosystems, phytoplankton biomass profiles often exhibit nonuniform vertical distributions under certain environmental conditions. Their distribution patterns and structural characteristics serve as important indicators of the stability and ecological health of aquatic ecosystems. However, the patterns and structures of phytoplankton biomass profiles in deep-water reservoirs, as well as the influences of surface water quality, meteorological conditions, and hydrological factors on these profiles, remain insufficiently understood. To characterize the patterns of phytoplankton biomass profiles in deep-water reservoirs, six years of high-frequency profiling buoy data collected from the large, deep Xin’anjiang Reservoir in China were analyzed using nonlinear fitting. Furthermore, ten potential controlling factors—including surface water quality parameters, meteorological and hydrological variables—were selected and analyzed using the extreme gradient boosting (XGBoost) model to assess their relative contributions and impacts on phytoplankton biomass patterns and structures. The results indicated that nonuniform phytoplankton biomass profiles could be parameterized using a generalized Gaussian function, while uniform profiles were more appropriately described by sigmoid or linear functions. In addition, the structural metrics of the phytoplankton biomass profiles exhibited significant spatial and temporal variations. On the other hand, air temperature (AT), dissolved oxygen (DO), and rainfall (RF) were the primary factors influencing the patterns of phytoplankton biomass profiles. Chlorophyll a (Chla), DO, and air pressure (AP) were the primary factors affecting the structures of nonuniform-type phytoplankton biomass profiles, while Chla, AP, and AT mainly influenced the uniform-type phytoplankton biomass profiles. Our work has significant implications for effectively managing water quality and scientifically estimating phytoplankton biomass in the entire water column.}
}
@article{ALFIO2026135417,
title = {Fifty years of monitoring coastal aquifer dynamics: climate and human forcing effects on the transition zone assessed via electrical conductivity depth profiles},
journal = {Journal of Hydrology},
volume = {673},
pages = {135417},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135417},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005147},
author = {Maria Rosaria Alfio and Gabriella Balacco and Giuseppe Ferrari and Gaetano Daniele Fiorese and Alessandro Parisi and Maria Dolores Fidelibus},
keywords = {Multi-year drought, Precipitation anomalies, Groundwater drought, Groundwater salinisation, Total dissolved solids, Freshwater-saltwater interface},
abstract = {Coastal aquifers face serious risks from overuse, pollution, and climate change, especially in semi-arid areas. Despite advances in modelling, empirical knowledge of long-term changes in the freshwater–saltwater equilibrium in real aquifers remains limited. A comprehensive 50-year dataset (1974–2024) of Electrical Conductivity (EC) depth profiles for the Salento coastal karst aquifer in Puglia, Southern Italy, is presented. This dataset derives from a monitoring well designed to capture density layering under horizontal flow. The data enable reconstruction of long-term changes in density distribution within a 160 m-thick saturated zone including the saltwater layer, as well as analysis of groundwater salinisation dynamics. Cumulative probability plots of Total Dissolved Solids (TDS) profiles, derived from EC-TDS calibration, enabled the delineation of freshwater, transition, and saltwater zone thicknesses. The theoretical Sharp Interface and Equivalent Saltwater Head, calculated through TDS-density calibration, serve as proxies of salinisation evolution. TDS distributions over time highlight the widening and upward migration of the transition zone, along with a decline in freshwater quality and quantity. Today, the system suffers from a persistent freshwater-saltwater disequilibrium after four multi-year droughts in the last four decades. The climate-exploitation nexus mostly explains the evolution of groundwater salinisation, but the individual roles of droughts and exploitation cannot be disentangled. The timescales of these phenomena cannot be precisely determined either. The results provide an innovative perspective on monitoring by focusing on the aquifer’s vertical development rather than just its horizontal development, and by using a sufficiently long monitoring time frame to reveal delayed phenomena.}
}
@article{YE2026135412,
title = {Agent-based intelligent real-time control for pluvial flood mitigation at urban scale},
journal = {Journal of Hydrology},
volume = {673},
pages = {135412},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135412},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005093},
author = {Chenlei Ye and Zongxue Xu and Kai Liu and Ming Wang and Xinyi Shu and Lei Yu},
keywords = {Urban pluvial flooding, Functional surface, Hydrological heterogeneity, Deep reinforcement learning, Real-time control},
abstract = {Urban pluvial flooding, driven by climate change and urbanization, poses a serious threat to urban safety. One of the key challenges is optimizing real-time flood management and control. Hydrological-hydrodynamic coupled models are widely used for urban surface flood simulations. However, existing research mainly focuses on predicting extreme flooding events while neglecting the simulation and optimization of intelligent flood control strategies for highly heterogeneous urban surfaces. At the meso-scale at urban area, the coupled models of surface and underground drainage systems exhibit highly nonlinear characteristics, particularly when faced with uncertain and unknown rainfall scenarios. This presents challenges in generating decision-making solutions that are both timely and accurate. This study integrates hydrological-hydrodynamic models with deep reinforcement learning (DRL) methods to propose an urban flooding control model (UFCM) suitable for urban-scale flood events. UFCM consists of two main modules: (1) a physically-based model (UFCM-PBM) for simulating urban surface floods, and (2) an intelligent control model (UFCM-ICM) based on agent-based deep reinforcement learning. Our intelligent control is trained using DRL to develop the control strategy based on real-time flooding state. To enhance the model’s performance, we propose a FUSE scheme with a voting mechanism, which combines multiple DRL agents’ generated control sequences into a unified FUSE solution. This ensures that the FUSE scheme operates within a stable and reliable range. The UFCM was applied to Jinan, China, and validated through multiple storm flood events, successfully identifying risk-prone areas. The results reveal: First, heuristic algorithms are effective for pluvial flooding model calibration under multi-functional subareas, achieving excellent simulation results across multiple flooding events. Second, the coupling of physical mechanisms with DRL in UFCM provides efficient and accurate decision-making solutions for complex urban flood system scheduling and control, with significant improvements over traditional water level-based real-time control (RTC) strategies. Under the regulation of the FUSE agent, the inundated area accounts for 43.69% of the original scenario without the involvement of water engineering under the 2-year rainfall and 82.45% under the 50-year rainfall. This study offers valuable insights into urban pluvial flood modeling and intelligent real-time control at the meso-scale.}
}
@article{GUO2026135331,
title = {Latitude/elevation-dependent response of snow phenology to climate change in the Northern Hemisphere from 1972 to 2022},
journal = {Journal of Hydrology},
volume = {673},
pages = {135331},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135331},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004282},
author = {Hui Guo and Xiaoyan Wang and Zecheng Guo and Gaofeng Zhu and Tao Che},
keywords = {Snow cover dynamics, Spatiotemporal variations, Latitudinal/elevational contribution, Climate sensitivity},
abstract = {Snow phenology, characterized by recurrent seasonal patterns in snow cover and snowfall, has been significantly influenced by global warming. The dynamic variability in snow phenology affects the regional climate. Snow phenology includes key metrics such as snow cover onset date (SCOD), snow cover end date (SCED) and snow cover duration (SCD). In this study, we investigated the spatiotemporal variations of snow phenology, its sensitivity to climate change, and the associated zonal and vertical differences across the Northern Hemisphere (NH) from 1972 to 2022. The results revealed that, over the past 50 years, an earlier SCOD and SCED was observed, with trends of − 3.4 days per decade (decade-1) and − 1.2 days decade-1, respectively. SCD has decreased at a rate of − 1.32 days decade-1. There were obvious differences in the contributions of snow phenology changes across latitudes and elevations to overall trends in the NH. The contribution rates between latitudes 25° and 75°N accounted for more than 90%, with low-elevation areas (<1000 m asl) making a significant positive contribution to snow phenology across the NH, which indicated that the changes in snow phenology in low-elevation areas are aligned with the trend observed across the NH. SCOD was influenced by snow accumulation season mean temperature (Ta, accounting for 51.04%) and snow accumulation season total precipitation (Pa, accounting for 48.96%), whereas SCED was primarily controlled by the snow melting season mean temperature (Tm). The response of snow phenology to climate change varied significantly across regions with different elevations and latitudes. With increasing elevation, the sensitivity coefficient of SCOD to temperature and precipitation shifted from negative to positive. Across all elevation zones, the sensitivity coefficient of SCED to Tm was negative, but at elevations above 4500 m asl, SCED displayed a strong positive response to Pa, indicating that more precipitation caused SCED to be later.}
}
@article{GUO2026135420,
title = {The effect of hydrology on the spatial–temporal distribution and transport of PAHs in the Yangtze River mainstream},
journal = {Journal of Hydrology},
volume = {673},
pages = {135420},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135420},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005172},
author = {Xudong Guo and Moshan Cen and Yan Zeng and Ying An and Tian Lin and Jing Zhang and Yuchun Wang and Jingfu Wang and Jingan Chen},
keywords = {Polycyclic aromatic hydrocarbons, Seasonal hydrological fluctuations, Dam construction, Transport and transformation, Yangtze River},
abstract = {Polycyclic aromatic hydrocarbons (PAHs) have long been of concern due to their persistence, bioaccumulation, high toxicity, strong long-distance migration ability, and wide sources. However, the effects of seasonal hydrological fluctuations and dam construction on the forms, migration, and transformation characteristics of PAHs in large rivers have not been systematically studied. In this study, water and sediment samples were collected from the Yangtze River mainstream from Chongqing to Jiangsu Section in spring and autumn. Dissolved PAHs (DPAHs) and particulate PAHs (PPAHs) in water, PAHs in sediment (SPAHs), and the relative physicochemical parameters were analyzed. The results showed that DPAH concentrations were 13.55–250.99 ng/L in spring and 7.76–42.61 ng/L in autumn; PPAHs concentrations were 9.05–102.95 ng/L in spring and 4.78–67.94 ng/L in autumn; and PAHs in sediment (SPAHs) were 27.91–1671.37 ng/g in spring and 9.01–744.53 ng/g in autumn. The enhanced precipitation in the basin in spring intensified the flushing input of accumulated PAHs in the basin into the river channel, resulting in significantly higher PAHs concentrations in both water and sediment than in autumn, and a tendency towards enrichment in the sediment. However, the stronger hydrodynamic conditions in autumn promoted the downstream migration of PAHs, resulting in a downstream accumulation trend. PAHs concentrations in both water and sediment in the Three Gorges Reservoir were higher in spring compared to autumn. This was attributed not only to inputs but also reservoir seasonal storage regulation. Additionally, strong hydrodynamic conditions can resuspend sediment, increasing the risk quotient (RQ) values of specific PAH homologues.}
}
@article{WU2026135427,
title = {Widespread diverse impacts of climate change on the multi-attribute characteristics of flash drought in China: A three-dimensional dynamic assessment based on CMIP6 multimodel ensembles},
journal = {Journal of Hydrology},
volume = {673},
pages = {135427},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135427},
url = {https://www.sciencedirect.com/science/article/pii/S002216942600524X},
author = {Chuanhao Wu and Pat J.F. Yeh and Zitao Li and Jiayun Li and Kai Xu and Min Shi and Jie Niu and Wenpeng Wang and Xiaoyan Cao and Qiongfang Li},
keywords = {Flash drought, Spatiotemporal dynamics, CMIP6, Projections, China},
abstract = {Flash drought (FD) is a type of extreme events characterized by rapid intensification of drought/dryness conditions, severely affecting vegetation growth and agricultural production. However, how the spatiotemporal dynamic risk of FD will change under future climate warming remains unclear owing to the limitations in the identification methods of FD dynamic characteristics and large uncertainty in global climate model projections. Here, we propose a comprehensive framework for projecting spatiotemporal dynamic characteristics of FD under future climate change by coupling the CMIP6 multi-GCM ensembles, the Variable Infiltration Capacity model, and an extended three-dimensional (3D) FD identification method. Based on this framework, we assess the projected changes in 3D dynamic characteristics of FD in China under SSP126, SSP245 and SSP585 scenarios. Model projections indicate a significant influence of climate change on FD characteristics, but the effects on different FD characteristics vary significantly. Climate change is expected to exacerbate FD severity and intensity for almost 75.3% of the national total area in China under three SSP scenarios, and prolong FD duration by 4.2%∼9.7%, especially under the higher SSP scenarios. Moreover, the migration distance of long-duration (>2-month) FD events tends to extend over time under all SSP scenarios, leading to an expansion of FD impact area in China under SSP245 and SSP585 (<36.4%). However, climate change will not alter the overall migration direction of FD, mostly from the humid South China to the arid and semi-arid North China regions. Our results emphasize the great importance of understanding the climate warming impacts on FD from a multi-attribute perspective.}
}
@article{WANG2026135448,
title = {A multi-source precipitation blending method combining hydrological model-guided precipitation adjustment and double transfer learning-based data merging},
journal = {Journal of Hydrology},
volume = {673},
pages = {135448},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135448},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005457},
author = {Jingyang Wang and Xiang Li and Ruiyan Wu and Xiangpeng Mu and Jiahua Wei and Yuefei Huang and Shenglong Gu and Dongqin Yin and Xin Tao and Keyan Xu},
keywords = {Precipitation blending, HBV-guided precipitation adjustment (HBV_PA), Double transfer learning (DTL), The source area of the Yellow River (YRSA)},
abstract = {Precipitation blending has been established as an effective approach for enhancing quantitative precipitation estimation accuracy. However, conventional precipitation blending methods exhibit two inherent limitations: (1) poor applicability in regions with sparse rain gauge networks; and (2) degraded estimation performance due to insufficient accuracy of input data sources. To address these limitations, this study proposes a multi-source precipitation blending (MSPB) method to integrate three datasets—ground, gridded precipitation, and auxiliary meteorological datasets—characterized by high spatiotemporal resolution and real-time capability. The methodology involves: (1) preprocessing all datasets into standardized input–output structures; (2) implementing an HBV-guided precipitation adjustment (HBV_PA) model to enhance data quality; (3) developing a double transfer learning (DTL) model using the corrected datasets to generate the blended precipitation product; and (4) conducting comprehensive performance evaluation against comparative objects, with demonstration through a case study in the source area of the Yellow River (YRSA). The evaluation metrics include probability of detection (POD), false alarm ratio (FAR), and critical success index (CSI) for event detection, as well as the Nash-Sutcliffe efficiency (NSE), Kling-Gupta efficiency (KGE), and root mean square error (RMSE) for quantitative assessment. Results demonstrate that HBV_PA-adjusted precipitation products significantly outperform the three original sources (IMERG-Late, GSMaP-Gauge, and ERA5-Land) across most statistical metrics in both temporal and spatial dimensions. Following the application of DTL to fuse HBV_PA-adjusted multi-source precipitation inputs, the MSPB method exhibits enhanced rainy-event detection performance (POD = 0.87 ± 0.01, FAR = 0.23 ± 0.01, CSI = 0.69 ± 0.01) alongside optimal precipitation quantification capabilities (NSE = 0.46 ± 0.02, KGE = 0.62 ± 0.01, RMSE = 2.28 ± 0.04), and outperforms other multi-source precipitation products and benchmark methods. Benchmark experiments conducted in the Tangnaihai–Lanzhou reach (TLR) further confirm that the proposed DTL model outperforms all benchmark methods by effectively leveraging extra-basin information, offering a superior solution for reliable estimation in data-sparse basins. Contribution analysis further reveals distinctive functional roles of input data sources in merging performance, confirming the substantial contribution of multi-source precipitation data and auxiliary meteorological information to precipitation estimation accuracy. This study establishes the MSPB method as a scalable solution for developing high-precision precipitation products. By integrating physically meaningful adjustments with a powerful transfer learning capability, the framework achieves robust predictive performance while effectively overcoming the critical challenge of in-situ data scarcity in sparsely gauged basins.}
}
@article{MA2026135480,
title = {A spatiotemporally differentiated hybrid hydrological modeling strategy with dynamically adaptive runoff generation modes},
journal = {Journal of Hydrology},
volume = {673},
pages = {135480},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135480},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005779},
author = {Xiaozan Ma and Yufei Ma and Qin Ju and Cuishan Liu and Junliang Jin and Yao Xiao and Haowen Liu and Guoqing Wang},
keywords = {Runoff generation modes, Machine learning, Hydrological modeling, Spatiotemporal heterogeneity, Flood forecasting},
abstract = {Accurate representation of event-dependent runoff generation is essential for flood forecasting in small-to-medium hilly basins, where dominant runoff processes can shift with rainfall characteristics and antecedent wetness. However, most existing hydrological models still rely on predefined and fixed runoff generation schemes, limiting their ability to capture such variability. To address this issue, this study integrates machine learning with classical runoff generation formulations and proposes a spatiotemporally differentiated hybrid hydrological model (STHM) with dynamically adaptive runoff generation modes. The proposed framework switches among infiltration-excess runoff, saturation-excess runoff, and vertical mixed runoff according to event conditions, thereby enabling more refined flood forecasting in small-to-medium basins. The Tunxi Basin was selected as a case study, and four conventional hydrological models were used as benchmarks for comparison. Results show that the random forest classification model achieves high accuracy and robustness, with a balanced accuracy of 86.65% on the test set and consistently high recall across the three runoff generation modes. Driven by the dynamically identified runoff generation modes, the STHM yields the best and most stable simulation performance among all models, with NSE values of 0.855 during calibration and 0.850 during validation, and shows strong adaptability across different flood event types. SHapley Additive exPlanations (SHAP) analysis further reveals distinct responses of the three runoff generation modes to rainfall characteristics and soil moisture conditions, providing additional support for the necessity of differentiated and dynamic runoff generation strategies. Overall, the proposed STHM offers a physically meaningful and effective framework for flood forecasting in small-to-medium basins under complex hydrological conditions, with potential value for flood risk assessment and water management decision-making.}
}
@article{HALICKI2026135367,
title = {Daily river water levels from multi-mission altimetry: A reach-based regression method using the unique SWOT data geometry},
journal = {Journal of Hydrology},
volume = {673},
pages = {135367},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135367},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426004646},
author = {Michał Halicki and Tomasz Niedzielski and Christian Schwatke and Daniel Scherer and Denise Dettmering},
keywords = {Satellite altimetry, SWOT, River water level, Spatio-temporal densification, Hydrological monitoring},
abstract = {The launch of the Surface Water and Ocean Topography (SWOT) satellite marks a new era in global hydrological monitoring, providing unprecedented spatial coverage of river water surface elevation (WSE) measurements. However, similar to previous nadir altimetry missions, the sampling frequency of SWOT is still insufficient to capture the rapid dynamics of flood events. In this study, we present the first approach for generating daily WSE time series from multi-mission satellite altimetry (SWOT, Sentinel-3A/B, Sentinel-6A). The approach, named Reach-Reg, benefits from the unique SWOT measurement geometry, which observes multiple river reaches simultaneously. This enables the construction of a linear regression for each neighbouring reach pair, which is subsequently used in a chained approach to transfer WSE between river locations. To account for the time lag, river velocity is estimated using the Manning formula and the at-a-station hydraulic geometry simplification. Finally, the application of outlier rejection, smoothing, aggregation, and interpolation yields the daily WSE time series. Reach-Reg has been validated on 95 stations located on 8 rivers (Elbe, Ganges, Mississippi, Missouri, Oder, Po, Rhine, Solimões), obtaining a mean RMSE, NRMSE, and NSE of 0.30 m, 4.2%, and 0.94, respectively. Reach-Reg significantly outperforms previous densification methods in terms of both accuracy and temporal resolution. The method is computationally efficient, automated, and relies solely on altimetry observations, offering high scalability for monitoring medium to large rivers globally. This marks a fundamental step towards operational hydrological monitoring using satellite altimetry.}
}
@article{SUBHADARSINI2026135404,
title = {EXtreFormer: a general deep learning framework for forecasting compound extreme events: experience with dry-hot extremes and vegetation response},
journal = {Journal of Hydrology},
volume = {673},
pages = {135404},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135404},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005019},
author = {Suchismita Subhadarsini and D. {Nagesh Kumar} and Rao S. Govindaraju},
keywords = {Deep learning, Multivariate, Extreme events, Hydro climatology, Physical interpretability},
abstract = {Extreme compound hydrologic events result from complex interactions between land use, climate dynamics, and other influencing factors. The sporadic nature of these intense and rare events prevents the use of established statistical methods that rely on temporal and/or spatial continuity. Using data from the Godavari River Basin in India as a testbed, this study utilized deep learning to develop EXtreFormer, a framework for long-horizon compound extreme event forecasting in multivariate space, by exploiting the interplay between temperature and soil moisture extremes for drought conditions along with Normalized Difference Vegetation Index (NDVI). Novel integrations of advanced embedding (RoPE) and attention (mTAN) mechanisms were incorporated in EXtreFormer to achieve superior performance for predicting extreme events over multiple horizons and enabling interpretability by identifying relevant past variables and time steps through attention maps. An ablation study revealed the model’s versality across the dominant land use and land cover (LULC) types in the basin − namely grasslands, broadleaf croplands, savannas, and deciduous broadleaf forests − achieving tail-Kling-Gupta Efficiency (tKGE) scores up to 0.86, underscoring its robustness and effectiveness in capturing the unique dynamics over each LULC category. For comparison, attention maps were also generated for regular events using a Modified Transformer for temperature, soil moisture and NDVI. Results indicate that regular events maintained balanced variable interactions, while compound extreme events tended to prioritize temperature and soil moisture.}
}
@article{ALKARYANI2026135464,
title = {Hydrogeological control of water persistence in the Libyan Sahara: the role of the Nubian sandstone aquifer system in paleohydrology},
journal = {Journal of Hydrology},
volume = {673},
pages = {135464},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135464},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005615},
author = {Belkasem Alkaryani and Mohamed Saleh},
keywords = {Green Sahara, Paleohydrology, Nubian sandstone aquifer system, Hydrogeological control, Structural geology, Paleowater, African humid period, Libya},
abstract = {The prevailing narrative of the “Green Sahara” attributes the past presence of extensive water resources and biological corridors in North Africa primarily to orbitally driven climatic shifts, specifically multiple African Humid Period (AHP) spanning the Late Pleistocene and Holocene (∼14,800–5,500 years ago). While climate-driven precipitation undoubtedly controlled aquifer recharge during these humid phases, this perspective often underestimates the critical role of deep-seated geological structures in determining the long-term persistence and spatial distribution of water resources, particularly in Libya. This paper argues that the vast fossil water reserves of the Nubian Sandstone Aquifer System (NSAS) represent a hydrogeological control that fundamentally decouples Libyan paleohydrology from the transient, climatically driven surface water cycles of the AHP. The NSAS, a massive, transboundary aquifer with an estimated storage volume of 150,000–450,000 km3, provided a stable, long-term water source through “paleowater” recharged during multiple pluvial episodes spanning hundreds of thousands of years. Evidence from hydrostratigraphy, structural geology, and petroleum exploration demonstrates that the NSAS’s thick confining units preserved this water over geological timescales (105-106 years), while deep-seated faults acted as conduits for its surface discharge, directly sustaining oases and ancient settlements long after climatic conditions became arid. This paper presents quantitative estimates of groundwater contribution and detailed case studies from Kufra and Tazerbo oases showing that structural controls on discharge were the primary determinants of water availability for sustained human and ecological activity. This study proposes an integrated paleohydrological model for the Libyan context where climate drives recharge pulses on millennial timescales, geological architecture stores and preserves recharged water on geological timescales (105–106 years; grounded in isotopic ages of 400,000–1,000,000 years from 81Kr and 36Cl dating, and structural pathways maintain surface accessibility on short timescales (101–102 years). Understanding the “Green Sahara” in Libya requires recognition that the NSAS transformed ephemeral climatic moisture into a geologically controlled, persistent water resource. Where climate drives recharge pulses on millennial timescales (103–104 years).}
}
@article{NURIEL2026135452,
title = {From water-rock interactions to flow rates: insights from 234U/238U activity ratios and REE patterns of the ancient Kurnub Group Aquifer},
journal = {Journal of Hydrology},
volume = {673},
pages = {135452},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135452},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005494},
author = {Perach Nuriel and Daniel Ish-Shalom and Roi Ram and Christian Siebert and Boaz Lazar and Ludwik Halicz and Avihu Burg},
keywords = {REE, U/U activity ratios, Kurnub aquifer, Groundwater dating, Groundwater flow velocity},
abstract = {Measurements of uranium isotopes and Rare Earth Element (REE) compositions were used to evaluate water–rock interaction processes, mixing, and flow rates in the Kurnub Group Aquifer (KGA), a deep confined regional sandstone aquifer extending from the Sinai Peninsula (Egypt) to the Negev Desert (Israel). The study involved developing a methodology that allowed to separate both U and REE from the brackish groundwater using a single column. Groundwater was sampled along two main flow paths of the KGA: East (n = 9) and North (n = 8), and from the overlying Judea Group Aquifer (JGA; n = 2). Overall, samples along the two KGA flow paths show consistent low REE concentrations (ppt levels) and patterns, with low LREE and HREE and high MREE. A systematic decrease in 234U/238U Activity Ratio (AR) downflow is observed along two main trend lines, from 8.37 upstream to 1.41 (non-linear) and to 3.72 (linear), with remarkable correlation to the distance from the Dead Sea outlets (R2 = 0.98). These trends suggest that uranium tracer is controlled by processes during the travel time downflow with potential relation to residence time and flow rates. Assuming minimal water–rock interactions downflow and a decrease in AR solely due to radioactive decay, long-term average flow rate of 0.29 m·yr−1 is assessed, similar to recently obtained 81Kr-based age estimates. The exceptionally high AR is observed near a major fault zone, suggesting that the highly enriched 234U may originate from this deep-seated active deformation zone, whereby fluid interactions with fractured rocks lead to the preferential leaching of the 234U isotope.}
}
@article{ANTONIADOU2026135428,
title = {A Bayesian spatial framework for modeling sub-hourly to daily extreme precipitation in Denmark using SPDE with INLA},
journal = {Journal of Hydrology},
volume = {673},
pages = {135428},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135428},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005251},
author = {Nafsika Antoniadou and Jonas W. Pedersen and Anders Stockmarr and Hjalte Jomo {Danielsen Sørup} and Torben Schmith and Peter Steen Mikkelsen},
keywords = {INLA, Spatial statistics, Bayesian analysis, Generalized Pareto distribution, Extreme precipitation},
abstract = {We present a new methodology for regional modeling extreme sub-daily precipitation events, aimed at producing spatially continuous return level maps with associated uncertainties. The approach is implemented within a Bayesian generalized additive modeling framework using a two-stage modeling procedure. In the first stage, exceedance frequencies are modeled with the Negative Binomial distribution. In the second, exceedance magnitudes are modeled with the Generalized Pareto distribution. Both stages contain latent spatial random effects modeled as Gaussian random fields. Bayesian inference is performed using the Integrated Nested Laplace Approximation (INLA), a fast and accurate alternative to MCMC for latent Gaussian models. We apply the methodology to a dataset of sub-hourly precipitation time series from stations across Denmark. The model captures spatial variation in both the frequency and magnitude of extremes, and produces high-resolution return level maps with associated uncertainty. In addition, sensitivity analyses with synthetic gauge networks show that wide spatial coverage of an area is more important than station density for predictive skill, highlighting the crucial role of network structure and design in reliable extreme rainfall modeling. Our two-stage Bayesian model provides a flexible alternative to the model currently used in Denmark. For longer durations (360 and 1440 min), the two models show good agreement, whereas for shorter durations (30 and 60 min), notable differences appear in both spatial variability and uncertainty. The methodology presented in this work can be adapted to different studies on extremes and can be extended to include additional covariates.}
}
@article{STRACK2026135222,
title = {An exact solution for steady subsurface irrigation with free boundary},
journal = {Journal of Hydrology},
volume = {673},
pages = {135222},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135222},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426003197},
author = {Otto D.L. Strack},
keywords = {Groundwater, Evaporation, Irrigation, Phreatic surface, Hodograph},
abstract = {We present an exact solution for subsurface irrigation via horizontal perforated parallel pipes filled with water under pressure. Fluid passes through the water table into the root zone. The aquifer is fully saturated in the zone between the horizontal impermeable base and the phreatic surface, which is under atmospheric pressure. The solution is valid for any number of pipes, placed arbitrarily, but horizontal and in the vertical plane. The solution is obtained by application of a combination of the analytic element method, a reference function defined in the upper half plane, and the hodograph method.}
}
@article{KIFELEW2026135436,
title = {Characterization of groundwater storage dynamics and responses to meteorological stress and climate teleconnections across river basins and climate zones in Ethiopia},
journal = {Journal of Hydrology},
volume = {673},
pages = {135436},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135436},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005330},
author = {Mekash S. Kifelew and Song Xianfang and Yang Lihu and Dongmei Han and MA Ying and BU Hongmei},
keywords = {Groundwater drought, GRACE/GRACE-FO, Groundwater storage anomalies, Drought propagation, Climate teleconnections, Data-scarce regions, Ethiopia},
abstract = {Groundwater plays a vital role in Ethiopia’s water security, yet its long-term dynamics and drought behaviour remain poorly understood due to sparse monitoring and reliance on precipitation-based indicators. This study investigates groundwater (GW) storage dynamics and groundwater drought characteristics across Ethiopia during 2003–2024, using combined data from the Gravity Recovery and Climate Experiment and its follow-on mission, together with outputs from the Global Land Data Assimilation System land-surface model. Groundwater storage anomalies (GWSA) were derived, and groundwater drought was quantified using a Standardized Groundwater Drought Index (SGDI). Multi-timescale relationships between meteorological drought (SPI at 1–24 months) and groundwater drought were studied across 12 major river basins and aridity-based climate zones, while the influence of large-scale climate teleconnections (Niño3.4, DMI, and EMI) was assessed using cross-wavelet coherence analysis. Results reveal pronounced spatial heterogeneity in groundwater storage behaviour, with stronger SPI–SGDI coupling during longer accumulation periods (12–24 months), with peak correlations exceeding 0.6 in several basins, indicating substantial groundwater memory and delayed drought propagation. This research underscores the importance of satellite data in monitoring groundwater drought in Ethiopia, where in situ data are limited. Groundwater drought conditions (SGDI <  − 1) occurred during approximately 10–15% of the study period at the national scale, with mean event durations of 3–4 months and maximum durations exceeding 6 months in arid and semi-arid regions. Teleconnection impacts were intermittent and scale-dependent, with Niño3.4 and DMI accounting for 15–25% of groundwater drought variability during specific periods, while local hydroclimatic factors exerted dominant control. These findings highlight the cumulative nature of groundwater drought in Ethiopia and demonstrate the value of satellite gravimetry for groundwater drought monitoring and water-resources management in data-scarce regions.}
}
@article{NAMBIAR2026135468,
title = {Performance of hydraulic conductivity models for use in numerical simulations of water flow in unsaturated soils},
journal = {Journal of Hydrology},
volume = {673},
pages = {135468},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135468},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005652},
author = {Asha Nambiar and Gerrit H. {de Rooij}},
keywords = {Soil hydraulic conductivity, Soil physics, Unsaturated flow, Numerical modeling, Soil hydraulic properties},
abstract = {Numerical solvers of the partial differential equation for soil water flow (Richards’ equation) require the soil water retention curve (SWRC) and the unsaturated soil hydraulic conductivity curve (UHCC). Recent UHCC models included water flow in films in addition to capillary flow to improve the description of the dry-range conductivity. Here, we consider an established UHCC model with capillary flow only, an additive model that sums conductivities for water in films and capillaries, and a junction model that has only film flow in the dry range and only capillary flow in the wet range. We tested the effect of the UHCC models and different combinations of fitted and fixed model parameters on water fluxes calculated by Hydrus-1D, a popular Richards’ solver. All UHCC models were used in conjunction with a recent SWRC model with physically sound behavior in the dry range and at saturation. The test focused on fluxes across the soil surface and at 2  m depth, calculated for three uniform soils subjected to three climates. All three UHCC models fitted measured conductivities well, even though the capillary-only and the junction model had one parameter less than the additive model. The calculated fluxes were in general agreement, but Hydrus crashed more often for the additive model than for the other two. The effect of film flow was small. Calculations based on different sets of fitting parameters showed that often, not all parameters need to be fitted. This favors the more parsimonious and robust capillary-only and junction models.}
}
@article{BINMAMOON2026135432,
title = {Nonlinear dynamics of stream nutrient concentrations: low dimensionality, structured complexity, and seasonal predictability horizon},
journal = {Journal of Hydrology},
volume = {673},
pages = {135432},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135432},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005299},
author = {Wasif {Bin Mamoon} and Richard J. Povinelli and Anthony J. Parolari},
keywords = {Nutrient concentration time-series, Nonlinear dynamics, Chaos, Dimensionality, Predictability horizon, Dynamical complexity},
abstract = {Stream nutrient (i.e., nitrogen or phosphorus) dynamics depend on the complex interactions between watershed structural components (soil, water, vegetation, and topography) and random climate inputs. These complex interactions make it challenging to predict and forecast stream nutrient concentrations. Quantifying the nonlinear time series properties of nutrient signals can help determine the predictability of stream nutrients and the parsimony required of robust models to estimate nutrient concentrations and loads. Relevant nonlinear properties include the number of dominant variables, the inherent complexity, and the existence of chaotic behaviour. This study used nonlinear dynamic and chaos-based metrics to characterize multiple daily monitored nutrient signals, i.e., 21 Nitrate-Nitrite (NOx), 39 Total Phosphorus (TP), and corresponding flow (Q) time series, across the Midwest region of the US. Over 70% of the nutrient and flow signals exhibited chaotic behavior, reflecting both sensitivity to initial conditions and hidden determinism. This implies the possibility of accurate short-term forecasting for these signals, which appear random. The predictability horizon was approximately 2.5–5.5 months (NOx) and 1–4.5 months (TP), on average, indicating the interval within which daily concentrations can be forecasted accurately. The dimensionality of most nutrient signals was between 5 and 10, indicating that few key variables are needed to describe nutrient dynamics, whereas the dimensionality of flow signals was between 5 and 23. The observed dynamical complexity showed that most NOx and TP signals were difficult to predict but had some hidden order, indicating that their variability was not purely random. These results indicate that stream nutrient concentrations and loads can be forecast within a season and modeled with relatively parsimonious models, enabling more data-efficient modeling.}
}
@article{WANG2026135476,
title = {Quantification and source identification of uncertainty in non-point source pollution loads},
journal = {Journal of Hydrology},
volume = {673},
pages = {135476},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135476},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005731},
author = {Kang Wang and Xiaoli Jin},
keywords = {Non-point Source Pollution, Uncertainty, Alpha Shapes algorithm, Underlying surface conditions},
abstract = {Quantifying uncertainty associated with non-point source (NPS) pollution loads and identifying its key sources are crucial for enhancing the accuracy of NPS load simulation and prediction, understanding NPS variability under climate change and extreme weather events, and enabling effective watershed pollution control. The objectives of this study are to quantify the uncertainty associated with NPS loads and to determine the impacts of meteorological conditions and underlying surface characteristics on NPS load uncertainty across 74 catchments located in the Mintuo River and Jialing River basins, which are tributaries of the upper Yangtze River. Using eight years of daily monitoring data on flow, water quality, and pollution sources, the relationship between NPS loads and streamflow was established. The non-parametric Alpha Shapes algorithm was employed to characterize flow-dependent variations in NPS loads. The variation range of NPS loads was quantified using three indicators: the upper boundary envelope angle, the lower boundary envelope angle, and the envelope angle. The NPS load of all pollutants—namely ammonia nitrogen (NH3-N), permanganate index (CODMn), total nitrogen (TN) and total phosphorus (TP)—followed consistent right-skewed log-normal distributions. Statistically significant positive correlations were observed between streamflow and both the magnitude and variability of NPS pollutant loads of NH3-N, CODMn, TP, and TN. The variation in maximum pollutant loads was substantially greater than the variation in average loads. Although envelope angles tended to decrease under high-rainfall conditions, both the upper and lower boundary angles generally increased with rainfall overall. The variability in upper boundary envelope angles for NH3-N, CODMn, and TP loads exceeded that of the lower boundary envelope angles. NH3-N and TP loads exhibited greater sensitivity to runoff changes compared to other pollutants. The uncertainty in CODMn and TN loads was predominantly influenced by underlying surface conditions, whereas the uncertainty in TP exhibited dual dependence on both hydrology processes and surface conditions·NH3-N exhibits no significant correlation with underlying surface conditions.}
}
@article{WANG2026135440,
title = {Impact of band length on the spatiotemporal evolution of CO2-water displacement in heterogeneous sandstone},
journal = {Journal of Hydrology},
volume = {673},
pages = {135440},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.135440},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426005378},
author = {Yuxuan Wang and Yi Li and Li He and Wendong Dan and Xiaoyuan Li and Jiaqi Zhao},
keywords = {CO geological storage, CO-water displacement, Band length, Pore structure characteristics, Residual water saturation},
abstract = {Improving the efficiency of CO2 geological storage is crucial for mitigating climate change and ensuring energy security. However, there is still a lack of in-depth understanding of how banded heterogeneous reservoirs influence the CO2-water displacement process. To address this issue, this study utilized nuclear magnetic resonance (NMR) technology and fractal theory, conducting supercritical CO2 displacement experiments on five sets of water-saturated artificial sandstone cores, which were embedded with different lengths of low-/high-permeability bands. The results show that the length of the bands influences the variation in residual water saturation by regulating the heterogeneity of the rock core. Increasing the length of both low-/high-permeability bands significantly reduce residual water saturation. While low-permeability bands enhance the uniformity of CO2 distribution in different pore regions and weaken the capillary end effect to optimize the displacement path; high-permeability bands, act as low-resistance channels to improve CO2 flow connectivity, optimize the injection path, and enhance the displacement effect. Furthermore, the fractal dimensions of both the whole rock core and its macropores exhibit a positive correlation with the low-/high-permeability bands lengths. Longer band lengths lead to more complex pore structures, which in turn effectively improves CO2 flow connectivity and ultimately enhances displacement efficiency. This study reveals the spatiotemporal evolution of CO2-water displacement under varying band lengths, and elucidates the mechanisms by which these bands affect pore structure heterogeneity and fluid flow connectivity. This study establishes a theoretical basis for optimizing the design of CO2 geological storage schemes and enhancing their long‑term controllability and stability.}
}