@article{BEHNOOD2026115857,
title = {Galactic Margin Machines: A physics-inspired framework for nonlinear classification},
journal = {Applied Soft Computing},
volume = {202},
pages = {115857},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115857},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013050},
author = {Ali Behnood},
keywords = {Galactic Margin Machine, Potential-field learning, Interpretable machine learning, Sparse classification, Geometry-aware decision boundaries},
abstract = {Margin-based classifiers such as support vector machines achieve strong generalization by maximizing geometric separation in feature space, yet their decision boundaries are often constrained by implicit kernel geometry and offer limited physical interpretability. This paper introduces Galactic Margin Machines (GMM), a physics-inspired classification framework that formulates learning as the interaction of competing potential fields generated by labeled training samples. Each sample is assigned a non-negative mass that determines its influence, generating a smooth potential landscape whose equilibrium surface defines the decision boundary. In this formulation, classification corresponds to partitioning feature space into regions of dominant potential, while the margin is interpreted as the minimum potential advantage of the correct class. The proposed framework naturally yields curved, geometry-aware decision boundaries and promotes sparsity through mass regularization, leading to a compact set of influential training samples termed support stars. A theoretical analysis establishes stability guarantees based on potential margins and connects the model to classical potential theory. Extensive experiments on synthetic datasets with complex geometric structure and on standard UCI benchmark datasets demonstrate that GMM achieves competitive performance comparable to strong baseline classifiers across multiple error metrics, including linear and nonlinear support vector machines, logistic regression, k-nearest neighbors, and random forests. Qualitative visualizations further illustrate the interpretability of the learned decision surfaces and the emergence of sparsity. Overall, the results demonstrate that potential-field learning provides an interpretable and competitive alternative to conventional kernel-based classifiers.}
}
@article{KABIR2026115847,
title = {LSTM time-series max-value selection based cryptographic federated learning with load forecasting anomalies observations for autonomous smart grid system},
journal = {Applied Soft Computing},
volume = {202},
pages = {115847},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115847},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012950},
author = {S. Rayhan Kabir and Mohammad Kamrul Hasan and Simi Bajaj and Shayla Islam and Salwani Abdullah and Thippa Reddy Gadekallu},
keywords = {Smart Grid, Federated Learning, Distributed Machine Learning, Advanced Metering Infrastructure, Data Privacy},
abstract = {Autonomous energy grid is a futuristic infrastructure that leverages adaptive decision-making to securely manage energy through AMI (Advanced-Metering-Infrastructure) and SCADA (Supervisory-Control-and-Data-Acquisition) systems of smart-grid. In existing smart grids, machine-learning-based energy load forecasting shows high or low or unbalanced demand estimates, which prevents the smart grid from upgrading to an autonomous system. Moreover, insecure energy data computation-based information leakage and cyber-attacks-based data-breaches are also noticeable in smart grids. At the beginning of this article, anomalies of energy load forecasting computation such as lower-and-over estimation-of-demand, high overfitting-underfitting, future time-series based forecasting errors, and cyber-threats are highlighted. To overcome these problems, this paper proposes a secure federated learning-empowered energy load forecasting approach for future time series that can contribute to improving smart-grids into autonomous systems. Here, double layered LSTM (Long-Short-Term-Memory) neural-networks computed with cryptographic federated learning. In the proposed approach, after LSTM neural network weight computation, future-time-series-based forecasting computation is performed on edge nodes. Then, the forecasting data frame is encrypted and aggregated to server nodes to generate overall forecasting. At each smart meter node, the LSTM-based 30-day testing prediction, the 30-day actual observation, and the last 30 days of historical data are compared to calculate the maximum kWh (kilowatt-hour) value in each 30-day index. The LSTM-TSMVS-CryptFedAggSum (LSTM-TSMVS-based Cryptographic Federated Learning Aggregation via Summation) algorithm securely aggregates forecast data from each edge smart-meter node, using AES (Advanced-Encryption-Standard) cryptography. The overall process enhances autonomous decision-making by generating energy demand while also protecting grid data privacy. The results of the proposed approach show that the anomalies mentioned have been mitigated and it has shown better performance in comparison to existing approaches.}
}
@article{LI2026115856,
title = {Learning discriminative directional anchors for open-set recognition},
journal = {Applied Soft Computing},
volume = {202},
pages = {115856},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115856},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013049},
author = {Yulin Li and Jinjiang Li and Liying Hu and Kunpeng Xu and Lifei Chen},
keywords = {Open-set recognition, Prototype learning, Unknown class, Directional anchors, Anchor points, Direction points, Embedding space},
abstract = {Open-Set Recognition (OSR) aims to accurately classify samples from known classes while effectively detecting and rejecting those from unknown classes. Prototype learning provides an effective paradigm for addressing this problem. However, existing prototype-based OSR methods typically represent each class using a single anchor and rely on isotropic distance metrics (e.g., Euclidean distance), which fail to capture discriminative directional information in the feature space. To address this limitation, we propose learning discriminative directional anchors (LDDA) for OSR, where each class is represented by a directional anchor constructed from multiple anchor-direction point pairs, which together capture class-specific discriminative directions. LDDA measures a sample’s projection distance onto the directional anchor, incorporating both distance and orientation for classification and unknown rejection. Furthermore, we propose a direction management regularization term to maximize the directional distinctiveness between classes, enhancing inter-class separability in the embedding space. Experiments on multiple benchmarks show that LDDA improves both closed-set accuracy and open-set detection.}
}
@article{ZHUANG2026115811,
title = {Data-driven KNN modeling via optimized weighted distance learning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115811},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115811},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012597},
author = {Liangliang Zhuang and Gauthier Barbosa and Zhisheng Ye},
keywords = {Data-driven method, K-nearest neighbors, Heterogeneous predictors, Linear programming, Weighted distance measures},
abstract = {Many tabular prediction tasks involve predictors with different representations, for which standard KNN may be limited by its fixed distance metric and uniform neighbor weighting. This can lead to poorly represented neighborhood structures and suboptimal predictive performance. To overcome these limitations, we propose a data-driven KNN framework that incorporates an optimized weighted distance function. Specifically, we extend classical KNN by introducing feature- and neighbor-level weights, enabling the model to better account for mixed feature types and local sample relevance. We then develop a tractable linear approximation to the learning objective, reformulating it as a large-scale linear program that allows efficient estimation of weights. Theoretically, we prove that the proposed method preserves the locality principle fundamental to KNN and satisfies Fisher consistency under standard asymptotic conditions. Experiments on simulated data and several real-world datasets demonstrate that our method achieves competitive and stable performance relative to existing KNN variants. In particular, the simulation results illustrate its empirical robustness under different data-generating mechanisms, feature-importance patterns, and response-noise levels.}
}
@article{SHARMA2026115884,
title = {Higher-order object relation network with triple attention transformer decoder for image captioning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115884},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115884},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013323},
author = {Dhruv Sharma and Gagan Abbot and Gagan Singh},
keywords = {Appearance features, Spatial configuration, Triple attention, Image captioning, Computer vision, Natural language processing, Transformer},
abstract = {Image captioning, amalgamation of computer vision and natural language processing describe the contents of image in the form of natural language. Earlier methods focus on visual features and ignoring the relationship between different objects and regions for generation of corresponding captions. To address this concern this paper presents a novel transformer-based model, Higher-order Object Relation Network Transformer (HORN-T) to generate semantically and syntactically correct descriptions of images. The proposed model, for extraction of higher-order relationship between different objects and the scenes exploits appearance feature and spatial configuration. To further enhance the extracted features, Parallel Co-Attention (PCo-AM)-based transformer encoder is incorporated. Furthermore, for generation of coherent and diverse captions, the proposed model utilizes a triple attention (Convolutional Attention Module (CAM), Modified Multi-head Attention (MHA), and Position-aware attention (PAA)) based transformer decoder. To quantitatively and qualitatively evaluate the effectiveness of the proposed framework extensive experiments are conducted on three benchmarks for image captioning Flickr8K, Flickr30K, and MSCOCO. The proposed model provided state-of-the-art results on all the benchmarks by generating more informative descriptions with significant n-grams captured from a complex word space. An ablation is also carried out to study the influence different attention modules and parameters.}
}
@article{YANG2026115839,
title = {A triple logic–causality network for robust and interpretable text-to-image Re-identification},
journal = {Applied Soft Computing},
volume = {202},
pages = {115839},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115839},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012871},
author = {Kaicheng Yang and Sichen Zhang},
keywords = {Logic-Aware Constraint Modeling, Exclusion Attributes, Cross-Modal Retrieval, Text-to-Image Re-Identification, Counterfactual Constraint Learning},
abstract = {In text-to-image person re-identification (T2I-ReID), textual descriptions provide essential semantic cues for retrieving target pedestrian images. Existing methods mainly rely on fine-grained representation learning and cross-modal feature alignment. However, when a query contains exclusion-oriented attribute constraints, such as attributes that should not appear in the target image, these constraints are usually embedded into the same representation space as affirmative attributes, making it difficult to explicitly suppress constraint-violating candidates. To address this issue, we propose the Triple Logic–Causality Network (TLCN), an exclusion-aware attribute constraint modeling framework for T2I-ReID. TLCN introduces three complementary modules: a logic layer, a Boolean constraint layer, and a counterfactual removal layer. The logic layer separates textual attributes into required, forbidden, and optional constraints, enabling attribute-level constraint scoring. The Boolean constraint layer composes these constraints through differentiable soft-truth operators, allowing exclusion conditions to participate in retrieval ranking. The counterfactual removal layer provides additional supervision for forbidden attributes by simulating the removal of exclusion-related visual evidence. Extensive experiments on three benchmark datasets demonstrate that TLCN improves retrieval accuracy, ranking stability, and interpretability, especially under controlled without-query settings.}
}
@article{SENDRAARRANZ2026115879,
title = {Cultural evolution of perceptually grounded compositional lexicons in swarm robotics systems},
journal = {Applied Soft Computing},
volume = {202},
pages = {115879},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115879},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601327X},
author = {Rafael Sendra-Arranz and Álvaro Gutiérrez},
keywords = {Swarm robotics, Cultural evolution, Language games, Compositional lexicon, Semiotics, Symbol grounding problem},
abstract = {Communication in swarm robotics has traditionally been addressed from the evolutionary robotics perspective. However, cultural evolution, language games, and cultural transmission offer promising alternatives for achieving richer and more complex emergent communication. Within this framework, the ability to self-organize and share a common lexicon to refer to relevant objects, events, or concepts in the environment is essential for language-like communication among robots. In this paper, we show that robot swarms can self-organize a compositional lexicon to refer to multiple types of objects, with all swarm members converging to the exact same set of words. Our proposed system is based on cultural evolution, language games, semiotics, and the principle of embodiment, ensuring that words and meanings are perceptually grounded in each robot’s sensory experience and interaction with the environment. We assess the scalability of the proposed system and demonstrate that swarms of up to 100 robots can achieve a common lexicon of 26 different words. We further demonstrate that compositionality of the lexicon is shared by all robots in the swarm, even though individual meanings and compositional rules remain private to each agent.}
}
@article{LI2026115876,
title = {A symmetric dual-stream architecture with deep inter-layer fusion for high-precision infrared-visible road crack detection},
journal = {Applied Soft Computing},
volume = {202},
pages = {115876},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115876},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013244},
author = {Xiang Li and Wenyuan Xu and Yongcheng Ji},
keywords = {Deep learning, Multi-modal fusion, Road crack detection, YOLOv8n, Infrared thermography},
abstract = {Automated road crack detection involves handling significant information uncertainty caused by complex environmental factors like variable lighting and shadows. Current assessments relying on single-modal sensors often fail to capture reliable features under such distinct conditions. To address this and achieve robust perception, this paper proposes a Deeply-Integrated Dual-stream fusion framework (yolov8n_f4_scaff2_adf) for infrared-visible pavement damage assessment. This model explicitly formalizes and integrates heterogeneous knowledge sources: the high-resolution textures of visible light and the thermophysical properties of infrared thermography. The core innovation lies in a systematic multi-stage fusion strategy, comprising: (1) a symmetric dual-branch backbone for foundational semantic alignment; (2) a deep inter-layer backbone integration to promote early feature interaction; (3) a parallel neck architecture with inter-neck cross-fusion, which enables reciprocal guidance between modalities during multi-scale refinement; and (4) the advanced Split-Cross-Attention Feature Fusion (SCAFF2) module, which dynamically recalibrates features to mitigate modal misalignment. Comprehensive experimental results demonstrate that the proposed model significantly outperforms single-modal baselines and state-of-the-art methods, including Transformer-based detectors. In terms of core metrics, the model achieves an accuracy of 0.885, a recall of 0.876, and a mean Average Precision (mAP) at 50 of 0.922, while effectively improving the rigorous mAP@50–95 from 0.646 to 0.711. By effectively fusing multi-modal engineering data, this work provides a robust scientific base for automated crack detection decisions, striking a favorable balance between inspection precision and computational efficiency.}
}
@article{SAINI2026115852,
title = {A-PINN: Auxiliary Physics-informed neural networks for structural vibration analysis in continuous Euler-Bernoulli beam},
journal = {Applied Soft Computing},
volume = {202},
pages = {115852},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115852},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013001},
author = {Shivani Saini and Ramesh Kumar Vats and Arup Kumar Sahoo},
keywords = {Scientific machine learning, Auxiliary physics-informed neural networks, Euler-Bernoulli beam, Structural vibrations, Adaptive optimization},
abstract = {Recent advancements in physics-informed neural networks (PINNs) have garnered substantial focus due to their effectiveness in solving both forward and inverse dynamical problems. In this research, a modified Auxiliary physics-informed neural network (A-PINN) with balanced adaptive optimizers is proposed for the analysis of structural vibration phenomena. Accurate representation of structural systems is essential to capture vibration phenomena and ensure reliable predictive analysis. So, our investigations are crucial for gaining deeper insight into the robustness of scientific machine learning models for solving vibration problems. Further, to evaluate the performance of A-PINN, we conducted three experiments to approximate the Euler-Bernoulli beam equations under various scenarios. The numerical results substantiate the enhanced performance of our model in terms of both numerical stability and predictive accuracy. The proposed model achieves more than 40% improvement over baseline methods.}
}
@article{MAI2026115868,
title = {Rank adaptive matrix completion for image restoration via dual-phase learning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115868},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115868},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013165},
author = {Jiajie Mai and Qingping Sun and Xiao-Peng Li and Yiuyu Chan and Chi-Sing Leung and Eric W.M. Wong},
keywords = {Low-rank matrix completion, Untrained neural network, -norm regularizer, Multi-scale convolutional neural network},
abstract = {Matrix completion aims to fill in the missing entries of a matrix and has numerous applications in image processing and machine learning. However, traditional low-rank matrix completion (LRMC) methods often struggle to recover fine details under complex corruption due to their reliance on the low-rank assumption and limited expressiveness. To overcome these limitations, we propose a hybrid approach, namely, the Dual Phase Rank Adaptive Bi-branch Network (DRBiN), which integrates the interpretable LRMC framework with a multi-scale convolutional neural network. Our approach comprises two key modules, i.e., the Rank-Adaptive Bi-branch Neural Network (RiBNN) and the Hierarchical Feature Refinement Module (HFRM). The former extracts a low-rank representation from noisy input without requiring manual rank selection. The latter improves recovery quality by injecting high-rank details, including textures and fine-grained structural information, via the multi-scale convolutional neural network. Experimental results on multiple datasets demonstrate that DRBiN consistently outperforms existing methods across scenarios involving missing pixels, Gaussian noise, and salt-and-pepper noise.}
}
@article{WANG2026115860,
title = {Dioxin emission reduction optimization based on an improved particle swarm optimization algorithm},
journal = {Applied Soft Computing},
volume = {202},
pages = {115860},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115860},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013086},
author = {Tianzheng Wang and Jian Tang and Loai Aljerf},
keywords = {Municipal solid waste incineration, Dioxins emission concentration, Emission reduction optimization, Interval type-2 fuzzy decision tree, Particle swarm optimization, Dual-mode evaluation mechanism},
abstract = {Dioxins (DXN), released in trace amounts during municipal solid waste incineration (MSWI), are hazardous pollutants with significant impacts on environmental stability and human health. Controlling its emissions has long been a priority for both the incineration industry and environmental protection agencies. However, delayed detection, high detection cost, and uncertainty caused by the “memory effect” make it challenging to construct efficient indicator models and determine optimal manipulated variables (MVs) for DXN emission reduction. To this end, this article proposes an DXN emission reduction optimization strategy based on an improved particle swarm optimization (PSO) algorithm. First, a mechanistic analysis of DXN characteristics in MSWI process is performed to select various process parameters as inputs for the indicator model. An interval type-2 fuzzy decision tree (IT2FDT)-based approach is then adopted for constructing the DXN indicator model, facilitating better interpretability and uncertainty handling. Finally, a dual-mode evaluation (DME) mechanism, integrating static and dynamic information, is incorporated into the PSO algorithm to fully utilize population information and achieve adaptive parameter adjustment. The convergence behavior of the developed DME-PSO algorithm is theoretically analyzed, its practical effectiveness is confirmed through experiments on benchmark functions and a DXN dataset from an MSWI plant in Beijing. Experimental results on benchmark functions show that DME-PSO achieves the best Best/All result on 7 out of 10 test functions and yields statistically significant improvements over most competitors. Engineering validation further shows an average DXN emission reduction of 60.7%, with consistent MV recommendations across repeated runs.}
}
@article{LI2026115815,
title = {Time-varying disturbance observer-based adaptive neural network control for uncertain nonlinear systems},
journal = {Applied Soft Computing},
volume = {202},
pages = {115815},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115815},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012639},
author = {Xinyi Li and Yancai Hu},
keywords = {Backstepping, Adaptive control, Time-varying disturbance, DSC technology, Neural network technology},
abstract = {Based on the problems of lag and insufficient robustness of traditional control in the scenario of nonlinear systems with time-varying disturbances, an innovative control architecture integrating a time-varying disturbance observer with adaptive compensation is proposed. By employing the backstepping adaptive framework, dynamic surface control (DSC), and neural network (NN) approximation algorithm, a direct adaptive neural network controller with a dual compensation mechanism is constructed. Combining DSC with the disturbance observation error compensation mechanism, the asymptotic stability of the closed-loop system is strictly proved by Lyapunov stability analysis. The explicit pole configuration method for observer gain and the complete simplification process of Lyapunov function derivative are given, and the physical connotation and application conditions of all system assumptions are clarified to make the theoretical derivation rigorous and traceable. Simulation results demonstrate that the developed algorithm significantly enhances tracking performance and control quality. This improvement stems from a disturbance-derivative-augmented observer that enables accurate high-frequency disturbance tracking without error accumulation, combined with a dual compensation structure where observer-based feed forward and neural network adaptive learning synergistically address both structured disturbances and unstructured uncertainties.}
}
@article{LI2026115843,
title = {MCHH-TF: Dynamic hypergraph optimization framework based on hyperbolic space and coupled tensor and its application in organizational networks},
journal = {Applied Soft Computing},
volume = {202},
pages = {115843},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115843},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012913},
author = {You-Hong Li and Xiao-Kang Wang and Jian-Qiang Wang and Le Gao and Tian-Yu Wang and Hao-Ming Mo and Adel Nasri and Ruo-Bing Liu},
keywords = {Dynamic hypergraph, Hyperbolic space, Coupled tensor, Multi-objective optimization, Organizational collaboration},
abstract = {Dynamic organizational networks are characterized by evolving collaborations, hierarchical structures, and cross-departmental goal conflicts, which challenge existing community discovery and resource allocation methods. To address these issues, we propose MCHH-TF, a dynamic optimization framework that integrates adaptive time-window segmentation (ATWS), curvature-adaptive hyperbolic space embedding (HSE), a fourth-order management coupling tensor (M-Tensor) for hierarchical-temporal conflict modeling, and a stability-constrained NSGA-II procedure to jointly optimize community quality, cross-layer conflict, and allocation cost. Experimental validation on six real-world and large-scale network datasets demonstrates that MCHH-TF consistently outperforms state-of-the-art approaches. It achieves high-quality community partitioning, with an average modularity of about Qh≈0.79 and an improvement of approximately 8–10% over the strongest competitive baselines. Meanwhile, MCHH-TF reduces cross-layer conflict intensity by about 25–35% and lowers resource allocation cost by about 35–45%, while maintaining lower runtime and stable F1-score performance across datasets. Moreover, MCHH-TF remains robust under noise interference, showing only limited performance degradation under strong perturbations. These results indicate that MCHH-TF offers an effective decision-support tool for enterprise resource allocation and cross-department collaboration optimization in dynamic organizational settings.}
}
@article{WU2026115838,
title = {Hierarchical dynamic graph neural network for multivariate spatio-temporal forecasting},
journal = {Applied Soft Computing},
volume = {202},
pages = {115838},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115838},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601286X},
author = {Xiaomeng Wu and Dongmei Fu and Zhong Li and Tao Yang and Lizhen Shao},
keywords = {Multivariate spatio-temporal data, Hierarchical graph neural networks, Dynamic adjacency matrices, Variable graph, Entity graph},
abstract = {With the rapid advancement of sensor and data acquisition technologies, massive amounts of multivariate spatiotemporal data have been generated in fields such as intelligent transportation, meteorology, and healthcare. These data are typically represented as third-order tensors with the dimensions of time, entity, and variable (time × entity × variable). Existing research primarily constructs graph structures at the entity level and employs graph convolution to extract spatial features, but often overlooks the interactions among auxiliary variables. Moreover, most existing approaches assume a static adjacency matrix, which limits their ability to effectively capture the dynamic evolution of spatiotemporal dependencies. To address these issues, this study proposes a Hierarchical Dynamic Graph Neural Network (HDGNN) that enables multi-granularity modeling of spatiotemporal dependencies at both the variable and entity levels. Furthermore, this model introduces an adaptive dynamic adjacency mechanism to adaptively update the spatial connectivity structure. Extensive experimental results demonstrate that HDGNN significantly outperforms mainstream baseline methods in multivariate spatiotemporal data prediction tasks, exhibiting superior performance in both prediction accuracy and model robustness.}
}
@article{ZHANG2026115835,
title = {Adversarial-guided invertible network for multiple image steganography},
journal = {Applied Soft Computing},
volume = {202},
pages = {115835},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115835},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012834},
author = {Kehan Zhang and Jingwen Cai and Fen Xiao and Xieping Gao},
keywords = {Multi-image steganography, Invertible image steganography, Adversarial learning, Mutual information decoupling},
abstract = {Multi-image steganography enables high-capacity information concealment by embedding multiple secret images into a single cover image. Invertible Neural Networks (INNs) offer stable training and precise reconstruction for multi-image steganography. However, prevailing sequential INN modules often introduce structural complexity and lead to feature entanglement among secret images. The reconstruction accuracy remains a challenge in multi-image steganography. To overcome these limitations, we propose an Adversarial-Guided Invertible Steganography (AGIS) framework that incorporates adversarial guidance into INNs to mitigate feature entanglement across multiple secret images during both the embedding and recovery processes. In the embedding phase, an Adversarial Attention Module (AAM) utilizes spatial attention to conceal secret information within secure regions of the cover image. Combined with adversarial training, this strategy effectively minimizes perceptual distortions in the resulting stego image. During recovery, a Mutual Information Decoupling Module (MIDM) maximizes the mutual information between the stego image and the secret images. The resulting informative cues are then reintegrated into the invertible network to facilitate feature disentanglement and substantially improve the accuracy of image reconstruction. Extensive experiments demonstrate that the proposed AGIS framework consistently surpasses state-of-the-art methods in both reconstruction quality and security. Moreover, its lightweight architecture ensures high computational efficiency, underscoring its strong practical applicability in resource-constrained environments.}
}
@article{ALI2026115851,
title = {Enhancing sustainable energy strategies through p,q- quasirung orthopair trapezoidal fuzzy numbers in hybrid energy system planning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115851},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115851},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012998},
author = {Tausif Ali and Arun Sarkar and Souvik Gayen and Nazli Ersoy and Mahmood Reaz Sunny and Animesh Biswas and Dragan Pamucar},
keywords = {Hybrid energy system, Multicriteria decision making, P,q-quasirung orthopair fuzzy number, Aggregation operators},
abstract = {The problem in hybrid energy system (HES) planning lies in the over-reliance on quantitative optimization data, which may obscure critical qualitative factors like long-term sustainability. Additionally, slight variations in results from different optimization tools, despite identical inputs, further complicated decision-making, highlighting the need for advanced tools like p,q- quasirung orthopair trapezoidal fuzzy numbers (p,q-ROTrFNs) to enhance accuracy and clarity in evaluating alternatives. Therefore, in this study a novel concept of p,q-ROTrFNs is introduced as an extension of traditional trapezoidal fuzzy numbers, designed to address limitations in handling uncertainty and vagueness in HES planning. A more refined representation of membership and non-membership functions is offered by incorporating the p and q parameters, providing enhanced flexibility in managing imprecise data in multi-criteria decision-making processes. Additionally, score and accuracy functions based on expected values are developed to allow the comparison and ranking of p,q-ROTrFNs. Also, New operational rules for p,q-ROTrFNs are formulated to support their application in diverse decision-making scenarios, ensuring mathematical consistency. Moreover, p,q-ROTrFNs Preference Ranking on the Basis of Ideal-average Distance is method is proposed as a comprehensive framework for ranking alternatives in decision-making scenarios characterized by complex uncertainty. To develop the method two types of aggregation operators based on Schweizer-Sklar t-norms and t-conorms and a distance measure are introduced for aggregating p,q-ROTrFNs and quantify the similarity or dissimilarity between p,q-ROTrFNs respectively. After implementing the proposed method, the PV-WT-HKT-DG-BT alternative achieved the highest score among the seven options. A group decision making of seven experts demonstrated consistency in ranking. Additionally, sensitivity analysis confirmed the method's reliability, while a comparative study validated its effectiveness.}
}
@article{LIANG2026115775,
title = {A pre-evolution-based cooperative co-evolution algorithm for large-scale optimization},
journal = {Applied Soft Computing},
volume = {202},
pages = {115775},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115775},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012238},
author = {Min Liang and Hong Zhao and JianYu Li},
keywords = {Large-scale global optimization problems, Cooperative co-evolution, Pre-evolution, Differential evolution, Variable interaction},
abstract = {Large-scale global optimization problems (LSOPs) suffer from the curse of dimensionality due to complex interactions among decision variables and the exponential growth of the search space. Although decomposition-based cooperative co-evolution (CC) algorithms have shown efficiency in dealing with LSOPs via variable grouping, they often face two challenges. First, accurate grouping methods often incur high computational costs, while inaccurate grouping can degrade the effectiveness of CC. Second, existing methods mainly focus on grouping to mitigate variable interactions, but often neglect the potential of improving the search-space structure before grouping and CC. To address these challenges, this paper proposes a pre-evolution-based cooperative co-evolution (PEBCC) algorithm with three key contributions. First, a pre-evolution method is proposed to construct a pre-evolved population using an archive update mechanism before the grouping and CC process. This method preserves elite information, maintains diversity, and constructs a pre-evolved population that induces a more favorable fitness landscape for subsequent grouping and CC. It effectively reduces the effective search region that needs to be explored during grouping and co-evolution, and thus enhances the search efficiency of the overall algorithm. Second, a component-based variation neighborhood differential evolution (CbVNDE) operator is developed. This algorithm explicitly considers the interference from interactions among decision variables. Moreover, the pre-optimized population effectively narrows the effective search region explored by subsequent cooperative co-evolution. Third, the proposed methods are integrated into the CC framework to construct PEBCC for solving LSOPs efficiently. Experimental results on the CEC’2013 and CEC’2010 large-scale benchmark suites demonstrate the effectiveness and competitiveness of PEBCC in solving complex LSOPs.}
}
@article{WU2026115803,
title = {Feature purification and modality cross-fusion dual-strategy for multimodal graph recommendation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115803},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115803},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012512},
author = {Guodong Wu and Yunyue Wang and Dongchen Xie and Jingxia Li},
keywords = {Multimodal, Feature purification, Cross-fusion, Graph neural network, Recommendation system},
abstract = {Multimodal recommendation systems have achieved significant progress in recent years, yet they often overlooked the challenge of noise contamination in raw modalities. Such noise, including irrelevant elements like extraneous image backgrounds and redundant text descriptions, distorted the modeling of user preferences during information propagation. To address this issue, we proposed FFRec, a novel dual-strategy enhanced graph neural network model for multimodal recommendations. FFRec enhanced the accuracy of user preference modeling and improved recommendation performance. The model first employed a modal feature purification module that extracted essential information from raw modal features using a tailored modal similarity kernel function designed for multimodal datasets. Subsequently, to mitigate potential loss of complementary information across modalities during purification, FFRec introduced a cross-fusion module. This module decomposed refined features into shared and modality-specific components and applied a specialized graph convolutional network to propagate information among shared features. This process strengthened inter-modal complementary information, resulting in more robust user preference representations and superior recommendation quality. Empirical evaluations on three benchmark datasets showed that FFRec consistently outperformed state-of-the-art models, demonstrating its effectiveness in multimodal recommendation tasks. The source code is available at https://github.com/wyy-up/FFREC.}
}
@article{BU2026115864,
title = {Generalization of large models: Methods, limitations and applications},
journal = {Applied Soft Computing},
volume = {202},
pages = {115864},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115864},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013128},
author = {Kun Bu and Yuanchao Liu and Wenbo Wang and Ziyi Cao},
keywords = {Large models generalization, Industrial large models, Computer science, Control science},
abstract = {Generalization is a cornerstone capability of Large Models (LMs), encompassing the transferability of pre-trained knowledge to novel tasks, unseen domains, or unprecedented combinatorial settings. It critically underpins LM performance in terms of robustness, reliability, and fairness, making it a persistent research hotspot. In recent years, LMs have attracted extensive attention due to their remarkable generalization prowess, zero-shot performance, and latent cross-domain value, progressively evolving into Industrial Large Models (ILMs). While these capabilities are primarily derived from large-scale unsupervised pre-training, significant limitations remain unaddressed. This paper presents a comprehensive survey of 150 recent studies on LM generalization, systematically categorizing them into 7 meta-tasks, and explores the role of efficient parameterization techniques, such as tensor decomposition. Building upon this foundation, we conduct 170 extensive empirical studies across 8 major industrial sectors and 4 industrial data formats, spanning the period from 2018 to 2026, to delineate the current landscape of ILMs. Conclusively, we propose the CS2 (from Computer Science to Control Science) framework, which offers a holistic discussion on the effective integration of LM generalization methodologies into real-world industrial applications. The key contributions of this paper are the innovative establishment of a systematic classification paradigm for LM generalization methods, ensuring structured organization of the field; the proposal of a bridging framework that aligns generalization strategies from computer science with the stringent control requirements of industrial scenarios; and the synthesis of mainstream ILM industrial practices, inclusively covering non-Western LMs. We also discuss the limitations and provide directions for future research.}
}
@article{ZHOU2026115767,
title = {Fuzzy multi-label feature selection via pairwise feature correlation and weighted label redundancy},
journal = {Applied Soft Computing},
volume = {202},
pages = {115767},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115767},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012159},
author = {Tong Zhou and Ligeng Zou and Xiongtao Zou and Jianhua Dai},
keywords = {Fuzzy rough set theory, Granular computing, Multi-label feature selection, Pairwise feature correlation, Weighted label redundancy},
abstract = {Multi-label feature selection and fuzzy rough set theory have shown great potential in processing high-dimensional multi-label data. However, most existing methods typically assume that the contributions of features to labels are independent, thus ignoring the influence of candidate features on the classification information provided by the selected features. Furthermore, the complex relationships between different labels in multi-label data are often underutilized. Currently, relevance-reinforced feature selection methods rarely address scenarios involving hybrid multi-label data. To address these issues, this paper proposes a hybrid multi-label feature selection method based on fuzzy rough set theory. First, a hybrid fuzzy similarity relation is defined to effectively characterize the similarity of hybrid multi-label data without requiring data discretization. Second, a pairwise feature correlation criterion is proposed to describe the interactions between candidate features and selected features, thereby selecting features that enhance the discriminative power of the selected feature subset. Then, a weighted label redundancy criterion is developed to reduce redundant information between labels given candidate features. Finally, extensive experimental results on fifteen benchmark multi-label datasets demonstrate that the proposed method achieves superior performance on multiple evaluation metrics.}
}
@article{WANG2026115846,
title = {Group sparse regularization for adaptive multi-view feature selection},
journal = {Applied Soft Computing},
volume = {202},
pages = {115846},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115846},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012949},
author = {Yadi Wang and Pengfei Ma and Yinfeng Hao and Liming Liu and Yanling Shao},
keywords = {Multi-view learning, Feature grouping, Feature selection, Group sparsity},
abstract = {Multi-view learning has emerged as an important paradigm in machine learning because data collected from different sources are available in multiple representations. However, accurately and efficiently extracting a discriminative subset of features from high-dimensional multi-view data remains a significant challenge. Although existing multi-view feature selection methods have made some progress, they typically treat each feature independently, neglecting the correlation structures between features. In addition, effectively exploiting the information contained in different views to improve the performance of feature selection methods remains an unsolved problem. To fully account for the correlation structures between features, we adopt a density clustering method to group intra-view features and design a group sparse regularization to distinguish the importance of different feature groups. At the same time, we apply the L2,1 norm for intra-view feature selection and fuse multi-view data by adaptive weighting. Based on the above, this paper proposes a Group Sparse Regularization for Adaptive Multi-view Feature Selection (GSAMFS) method. Furthermore, an alternating iterative algorithm is designed to obtain the optimal solution. Finally, extensive experimental results on nine benchmark datasets demonstrate that our method outperforms state-of-the-art multi-view feature selection methods.}
}
@article{WANG2026115822,
title = {Multivariable temporal-frequency reconstruction model with two-stage decomposition and explainable AI-driven feature selection for highly volatile time-series forecasting},
journal = {Applied Soft Computing},
volume = {202},
pages = {115822},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115822},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012706},
author = {Maohuan Wang and Jie Xu and Lei Sun and Tao Zhang},
keywords = {Multivariate time-series forecasting, Data decomposition, Feature selection, Explainable artificial intelligence, Hybrid forecasting model},
abstract = {Highly volatile time series contain complex patterns that current models struggle to fully capture, while the trade-off dilemma between data decomposition and feature selection limits the modeling of temporal and inter-variable dependencies. To address the above challenges, a hybrid forecasting model, called Multivariable Temporal Frequency Reconstruction (MTFR), is proposed. It integrates a two-stage decomposition algorithm with an innovative feature selection method. The two-stage decomposition algorithm contains temporal and frequency modules, leveraging STL (Seasonal-Trend decomposition using Loess), SSA (Singular Spectrum Analysis), DFT (Discrete Fourier Transform), and MWT (Multi-level Wavelet Transform) to decompose data into multi-scale components. Subsequently, Feature Selection based on Permutation Feature Importance (FSPFI) is proposed to adaptively screen out appropriate variables for each multivariable decomposed component. Utilizing the explainable artificial intelligence technique, FSPFI can assess the variable contributions with linear computational complexity. Finally, the forecasts of each decomposed component are reconstructed into the final result. Comparison experiments on 16 forecasting tasks across diverse datasets demonstrate that MTFR outperforms the state-of-the-art models and reduces errors by 0.80% ∼ 84.04% across the prediction horizons from 3 to 168 steps. Extensive parameter and ablation studies validate the effectiveness of the components of MTFR. The code is available at https://github.com/WangmhCHN/MTFR.}
}
@article{NAEEM2026115935,
title = {Resource-efficient and fair spatial graph attention networks for edge-based multi-label cardiac abnormality detection},
journal = {Applied Soft Computing},
volume = {202},
pages = {115935},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115935},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013839},
author = {Mohamed Naeem},
keywords = {Electrocardiography, Graph neural networks, Algorithmic fairness, Deep learning, Attention mechanisms, Health equity, Cardiovascular diagnosis, Medical Artificial Intelligence},
abstract = {Background
Cardiovascular mortality claims 20.5 million lives annually, yet deployed ECG artificial intelligence systems exhibit systematic diagnostic disparities across demographic groups — particularly between male and female patients — precluding equitable clinical deployment. Current fairness approaches suppress demographic information, discarding clinically meaningful physiological variation rather than leveraging it.
Methods
We introduce SC-GAT, a Spatial-Conditioned Graph Attention Network for resource-constrained edge deployment. SC-GAT models the 12 ECG leads as a graph (leads as nodes; edges encoding anatomical adjacency and Pearson signal correlations) and incorporates patient age and sex directly into every attention layer via a low-overhead sigmoid gating mechanism. A fairness-aware multi-task curriculum jointly optimises diagnostic accuracy, demographic representation, and equalized-odds regularisation across three progressive training phases. The model comprises 2.4 M parameters (≤16 MB RAM), compatible with ARM Cortex-M7-class wearable processors.
Results
Evaluated on PTB-XL (21,837 recordings, 5-fold stratified cross-validation), SC-GAT achieves F1 = 0.8660 and AUROC = 0.9577, outperforming all eight baselines — including transformer and graph-based architectures — with p < 0.05 and Cohen’s d > 2.0. SC-GAT reduces the male–female diagnostic performance gap from 16.67% to 3.93% (76.4% reduction), simultaneously satisfying both ΔDP < 0.05 and ΔEO < 0.10 clinical fairness thresholds within an edge-deployable parameter budget — a combination not demonstrated by any compared baseline.
Conclusions
SC-GAT empirically falsifies the accuracy–fairness trade-off: treating demographic context as a physiological resource rather than a statistical nuisance simultaneously advances diagnostic accuracy and demographic equity, establishing fairness-through-awareness as a principled design paradigm for equitable cardiac AI.}
}
@article{GAO2026115880,
title = {A link prediction model based on feedforward neural network and concept-cognitive learning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115880},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115880},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013281},
author = {Zhiqi Gao and Mengyu Yan and Jinhai Li and Xizhao Wang},
keywords = {Link prediction, Graph structure information, Feedforward neural network, Three-way concept analysis},
abstract = {How to accurately perform link prediction is an important problem in complex networks. However, existing link prediction algorithms often focus on capturing structural information based on similarity, ignoring the diversity of node relationships (such as competitive relationships). It should be noted that concept-cognitive learning has significant advantages in information extraction and there is a lack of models that capture the structure of the graph network in link prediction tasks. In this work, we start from the graph structure and construct a three-way graph structure concept neural network (TWGSCFNN) model that can effectively capture the structural information of graph networks in static unattributed undirected graphs and apply it to link prediction tasks. Firstly, we propose a three-way graph structure granular concept, which aggregates node information through concepts. Then, considering factors such as neighbors, contributions, competitions, and paths, we construct five edge features to depict the possibility of a connection between two nodes. Moreover, considering the potential nonlinear relationships among the five features, we incorporate a feedforward neural network, which allows the model to adaptively fuse the five features based on the network type, and then we obtain the final connection score. Finally, link prediction experiments are conducted to verify the effectiveness of the model on datasets of various types and scales.}
}
@article{ASLAM2026115818,
title = {Spatial-aware self-attention feature fusion DQN for path planning of USV in static and dynamic environments},
journal = {Applied Soft Computing},
volume = {202},
pages = {115818},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115818},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012664},
author = {Ayesha Aslam and Xiaojun Yang},
keywords = {Path planning, Self-attention, Feature fusion, Deep Q-learning, Unmanned vehicles, Static obstacles, Dynamic obstacles},
abstract = {Unmanned Surface Vehicles (USVs) operate in maritime environments where navigation is challenged by static and dynamic obstacles of both small and large sizes. Efficient path planning is critical to avoid collisions and ensure mission success, especially in dense or multi-USV scenarios. Handling varying obstacle sizes and movement in real time is essential for safe and reliable autonomous maritime operations. This study proposes the spatially aware self-attention feature-fusion deep Q-learning network (SA-FF-DQN) for USV path planning. The proposed hybrid deep reinforcement model integrates the Deep Q-Network (DQN) model and a Self-Attention Feature Fusion Module. The proposed SA-FF-DQN extracts spatial features and fuses them using a self-attention mechanism that dynamically weights each feature. The obtained fused representation is fed to the DQN to compute Q-values for state-action pairs, enabling the agent to take an optimized action. The incorporation of self-attention enables the model to consider long-term dependencies and contextual relevance in the data, resulting in better convergence, adaptability, and performance in dynamically changing spatial environments. The experiment evaluates the performance of USV navigation across diverse scenarios, including single and multiple USVs operating in environments with small and large static obstacles and dynamic obstacles. SA-FF-DQN performs better than existing methods across all scenarios, achieving high success rates (98%), efficient trajectories (21-25 steps), and low computation time (3-4s). It effectively supports both single- and multi-USV navigation in environments with varying obstacle sizes, densities, and dynamic conditions, while maintaining minimal detours and strong computational efficiency.}
}
@article{SHI2026115855,
title = {Glyph formation fused contrastive learning for few-shot ancient Chinese seal recognition},
journal = {Applied Soft Computing},
volume = {202},
pages = {115855},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115855},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013037},
author = {Yuanlin Shi and Tianquan Wu and Jiaqi Liu and Shuo Fan and Kaili Wang},
keywords = {Ancient Chinese seal recognition, Few-shot learning, Cross-modal, Contrastive language-image pretraining, Knowledge acquisition-applied recognition},
abstract = {The digitization and preservation of ancient textual artifacts have emerged as critical priorities in cultural heritage conservation. The automated recognition of ancient seal text presents unique challenges due to their intricate logographic structures, substantial historical typographic variations, and long-tail distribution characteristics. To address these challenges, this study draws pedagogical parallels from elementary Chinese literacy acquisition, introduces a knowledge acquisition-applied recognition paradigm, and proposes a novel cross-modal Chinese ancient seal recognition method that synergizes glyph decomposition knowledge with contrastive learning. During the knowledge acquisition phase, an enhanced CLIP architecture is employed to establish cross-modal alignment between character images and corresponding decomposed structural descriptors; subsequently, in the applied recognition phase, these learned representations guide a transformer-based recognition model through attention-based feature fusion. To support this research, we establish CNSeal-2602—currently the most comprehensive publicly available benchmark for ancient Chinese seal recognition (ACSR), containing 27,520 annotated character samples across 2602 categories. The 3.86% and 42.44% gains over the baseline method and one-shot samples, as well as comparative experiments demonstrate the superior performance of the proposed method, particularly in long-tailed few-shot categories.}
}
@article{GAO2026115875,
title = {Granular-ball rough set for robust twin support vector classification in medical image detection},
journal = {Applied Soft Computing},
volume = {202},
pages = {115875},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115875},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013232},
author = {Ruiyao Gao and Kai Qi},
keywords = {Granular-ball computing, Robustness, Geometric twin support vector machine, Robust loss function, Nonconvex optimization},
abstract = {Granular-ball (GB) computing is an efficient and scalable method for robust learning. However, while GB can partially mitigate the impact of label noise (outliers), numerous outliers may still persist after GB generation, indicating that the robustness of GB-based classifiers requires further improvement. The recently proposed granular-ball twin support vector machine (GBTSVM) achieves good robustness, efficiency and scalability. Nevertheless, it still has two major limitations. First, there exists inconsistency between the training and prediction processes, which leads to poor generalization performance. Second, it remains sensitive to residual label noise. To address these issues, this paper proposes a novel robust geometric twin support vector machine based on a Robust, Bounded, Sparse, and Smooth (RoBoSS) loss via granular-ball computing, termed as GB-RGTSVM. Specifically, an average hyperplane is introduced to ensure consistency between training and prediction, thereby strengthening generalization ability. Additionally, the incorporation of RoBoSS loss further enhances robustness against label noise. Statistical analysis reveals a tighter upper bound on the influence function for GB-RGTSVM compared to GBTSVM, confirming its superior robustness. To obtain the solution, a proximal gradient descent algorithm is implemented for the non-convex GB-RGTSVM optimization problem. Extensive experiments are conducted to validate the effectiveness and robustness of the proposed method. Furthermore, empirical results on the real-world medical image dataset (MedMNIST) for detection tasks demonstrate the superior performance of GB-RGTSVM compared with other state-of-the-art SVM methods.}
}
@article{WANG2026115830,
title = {Optimization algorithm improved by multi-autoencoder and difference smoothing for digital human sign language actions},
journal = {Applied Soft Computing},
volume = {202},
pages = {115830},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115830},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012780},
author = {Yongfei Wang and Meng Yi and Huimin Sun and Xiulong Ma and Changzhi Lv and Di Fan},
keywords = {Motion data optimization, Stacked autoencoder, Temporal attention mechanism, Finite difference smoothing algorithm},
abstract = {The current optimization of sign language motion data faces problems of excessive degrees of freedom and high correlation in high-dimensional data, which complicate optimization in high-dimensional spaces. To address these problems, this paper proposes an improved stacked autoencoder combined with a convolutional autoencoder to optimize the motion data, using the bidirectional information transfer of the stacked hourglass network model to improve the accuracy of the gesture estimation, and using the mapping process from the motion data to the hidden variable space and then back to the motion data to enhance the smoothness of the action. In order to ensure the optimization of sign language actions, a temporal attention mechanism is introduced into the encoder, so that the model pays more attention to the motion information of the sequential part of the hand data, and improves the quality of the optimization of sign language actions. From the results of the ablation experiment and the comparison experiment, the improvement of each part performs well, the position error is reduced by 25.11%, the smoothing error is reduced by 34.14%, and the perceptual error is reduced by 9.94%. Consequently, the accuracy and the smoothness of the sign language action are improved, and the optimization effect is good.}
}
@article{ZHAO2026115867,
title = {A novel dynamically-weighted data augmentation method for imbalanced bearing fault diagnosis},
journal = {Applied Soft Computing},
volume = {202},
pages = {115867},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115867},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013153},
author = {Wenxuan Zhao and Jianxiong Gao and Yiping Yuan and Rui Pan},
keywords = {Conditional generative adversarial networks, Imbalanced data, Fault diagnosis, Progressive disentanglement, Swin transformer},
abstract = {In engineering practice, the scarcity of fault samples severely constrains the performance of fault diagnosis (FD) systems. To address the prevalent issue of data imbalance in FD, the study proposes a dynamically-weighted data augmentation framework based on Conditional Generative Adversarial Networks (CGAN). Initially, the raw signals are transformed into two-dimensional time-frequency (TF) images via continuous wavelet transform (CWT), which are then fed into the model. This framework constructs a progressive decoupling generation architecture specifically designed for the physical characteristics of CWT time-frequency representations. It achieves a three-stage controllable decoupling mechanism—from semantic features to structural representations and finally to textural details—within the generative model, thereby significantly enhancing the physical plausibility and diagnostic discriminability of synthesized samples. The discriminator employs 3 × 3 convolutions to output a 16 × 16 discrimination matrix, enabling localized assessment of synthesized samples through patch-level adversarial evaluation. Furthermore, the Synthetic Minority Over-sampling Technique (SMOTE) is integrated to interpolate between real and generated samples, thereby increasing the diversity of minority class samples. To further improve the model’s sensitivity to critical features and enhance the structural and semantic quality of generated images, a deep feature-based perceptual loss mechanism is constructed, improving the discriminability and utility of synthetic samples. Additionally, a comprehensive evaluation framework is proposed to assess the quality of generated samples from multiple perspectives. Experimental results on two datasets demonstrate that the samples generated by the proposed model can effectively substitute real samples, achieving accuracy rates of 98.48% and 98.52% respectively in a ResNet18 classifier under balanced conditions.}
}
@article{JIA2026115814,
title = {A one-shot AutoML framework and transformer to enhance accuracy and efficiency in natural gas price forecasting},
journal = {Applied Soft Computing},
volume = {202},
pages = {115814},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115814},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012627},
author = {Xu Jia and Guozhu Jia},
keywords = {Natural gas price, CEEMDAN-SE, Time-aware Transformer, H2O AutoML, Model selection},
abstract = {Due to the accelerating transition toward clean energy and increasing demand-side uncertainty, accurate forecasting of natural gas prices has become crucial for market planning and energy security. However, in previous studies, the challenge of quickly selecting an appropriate model while accurately forecasting the highly volatile natural gas prices has rarely been overcome. To tackle this challenge, we employ AutoML and propose a novel hybrid framework termed CEEMDAN-SE-Time-Aware Transformer. First, we use LASSO for initial feature selection. Then, H2O AutoML is employed to automatically identify the optimal machine learning model in a short time, with the Distributed Random Forest (DRF) model achieving an R2 of 0.9903. Subsequently, the CEEMDAN-SE method decomposes the original natural gas price series into subsequences with distinct complexities, which are then reconstructed into new subsequences. Finally, a Time-Aware Transformer model is utilized to forecast the natural gas prices. The results indicate that the proposed model achieves an R2 of 0.9936 for next-day prediction and reaches up to R2 of 0.9979 in mid-term multi-step forecasting, outperforming baseline models across all evaluation metrics. These results highlight the potential of H2O AutoML in rapidly identifying optimal models, alongside the CEEMDAN-SE-TA-Transformer's ability to enhance natural gas price forecasting accuracy.}
}
@article{ZHOU2026115842,
title = {Multi-task learning for tumor segmentation and classification via dynamic cross guided learning and adaptive perturbation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115842},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115842},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012901},
author = {Yang Zhou and Huiyan Jiang and Qiu Luan and Yaming Li and Xuena Li},
keywords = {Multi-task learning, Multi-objective optimization, Feature optimization, Tumor analysis},
abstract = {Current multi-task learning methods for tumors often overlook the optimization effects generated by the interaction between the features of different tasks. The adaptive optimization process of neural networks leads to strong correlations between task features and attributes in multi-task networks. When the model continues to deepen the training, the segmentation features only focus on local shape and texture features, and the classification features only focus on global discriminative features. If the features of different tasks lack interaction with each other, the sample specificity of their own characteristics is lost in the same case. The simultaneous constraint of different task loss functions also results in a loss of task specificity of the task features themselves. In order to better adapt to multi-task learning and multi-objective optimization, this paper proposes a new multi-task training method, dynamic cross guided learning. By iteratively and dynamically updating the guidance features calculated from different task branches, cross guidance is used to train the corresponding task branches. This strengthens the interaction process of the features of the tasks and enhances the specificity of the task features. This paper also proposes an adaptive perturbation method that combines similarity evaluation with noisy images to improve the model’s performance and generalization, and to enhance sample-specific feature specificity. The experiment used private datasets for liver tumor segmentation and subtype classification, as well as public datasets for melanoma and lymphoma segmentation and disease classification, and segmentation and metastasis identification of soft tissue sarcoma. This method achieved case level Dice coefficients of 0.7772, 0.7430, and 0.7694 in segmentation tasks. In the classification tasks, the areas under the curves are 0.8651, 0.9784, and 0.7895, respectively. The proposed multi-task optimization learning method shows consistent performance improvement under different baselines.}
}
@article{GUL2026115882,
title = {Solving the systems of fuzzy fractional partial differential equations using the Laplace transform iterative method},
journal = {Applied Soft Computing},
volume = {202},
pages = {115882},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115882},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601330X},
author = {Nisar Gul and Tingting Wu and Loredana Ciurdariu and Siyar Gul and Imad Khan},
keywords = {Iterative method, Laplace transformation, Conformable derivative, Fuzzy fractional partial differential equations, Numerical experiments},
abstract = {The potential of fuzzy fractional-order partial differential equations to model complex physical systems with intrinsic properties and memory effects has attracted a lot of attention. One such system is the Burger’s equation, a fundamental model for describing turbulence, nonlinear waves, and the behavior of viscous fluids. In this work, we use the Laplace transform iterative method (LTIM), which employs the conformable derivative to estimate the approximate solution of system of fuzzy fractional partial differential equations. The benefit of the suggested approach is that it does not require limiting assumptions or discretization for computing the solution. To demonstrate the efficacy of the proposed approach, three distinct examples are provided. We investigate the approximate solutions to the problems and demonstrate the effectiveness of the recommended approach, using 2D and 3D graphs as well as different tables. This method effectively identified approximate solutions to fuzzy fractional partial differential equations because the results of this investigation also agreed with the exact findings.}
}
@article{XU2026115834,
title = {Prediction of bolt preload with friction-insensitive model using auxiliary task and CNN–GRU-based framework},
journal = {Applied Soft Computing},
volume = {202},
pages = {115834},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115834},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012822},
author = {Lingchao Xu and Yongsheng Xu and Ke Wang and Lin Ye and Weigang Zhang},
keywords = {Bolt preload prediction, Friction-insensitive model, Convolutional neural network, Gated recurrent unit, Auxiliary task},
abstract = {Precise preload control is essential in practical bolt tightening, and deep-learning methods have demonstrated high accuracy preload prediction. However, friction variations between bolted joints critically degrade prediction performance. In particular, existing studies have largely overlooked preload prediction across broad friction distributions when training data are limited to narrow friction ranges, restricting the applicability of deep-learning approaches. To address this limitation, we developed a convolutional neural network–gated recurrent unit preload-prediction model incorporating an auxiliary task for bolt stiffness-ratio prediction. This model was developed based on tightening theory to mitigate friction effects. Additionally, data augmentation and torque normalization were employed to further reduce the effect of friction variations on prediction performance. To objectively evaluate the proposed method, tightening datasets (hydraulic pressure data) with independent friction distributions were constructed under varying lubrication conditions. Only one lubrication condition was used for training and validation, and the remaining conditions served as test data. Experimental results revealed that the proposed method achieved superior prediction accuracy and stability across varying friction conditions compared with conventional tightening methods and existing deep-learning models, with prediction accuracy improvements ranging from 30.18% to 90.15% in terms of the mean absolute error. Thus, the proposed approach provides an effective solution for preload prediction under the same bolt specification and unknown friction conditions, thereby improving the generalizability of deep-learning methods in bolt-tightening applications.}
}
@article{LIAN2026115850,
title = {CarbonDyn: A dynamic expert routing framework with multi-scale spatiotemporal attention for meteorology-informed global CO2 forecasting},
journal = {Applied Soft Computing},
volume = {202},
pages = {115850},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115850},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012986},
author = {Jie Lian and Hang Yuan and Zhanyuan Chang and Sirong Huang and Xiao Wang and Hansong Xu},
keywords = {Carbon emissions forecasting, Deep learning, Multi-source data fusion, Temporal decomposition},
abstract = {Carbon dioxide (CO2) emissions are a key driver of climate change, and accurate forecasting of anthropogenic CO2 emissions is essential for engineering applications in energy planning, climate mitigation, and environmental monitoring. However, existing forecasting approaches generally have limited spatiotemporal modeling capabilities and omit meteorological drivers, limiting their capacity to capture complex emissions dynamics. This study proposes CarbonDyn, a dynamic expert routing framework to capture complex temporal dynamics and multi-scale spatiotemporal dependencies, specially designed for global CO2 emissions forecasting. First, a multi-source data fusion module integrates various meteorological factors with historical emission records and employs seasonal-trend decomposition to separate long-term trends from short-term fluctuations, thereby capturing temporal patterns more precisely. Second, we propose a Dynamic Expert Routing mechanism that adaptively allocates input data to specialized sub-networks based on dominant seasonal or trend features, significantly enhancing model adaptability. Finally, a Multi-scale Patch Cross-Attention module jointly processes spatial and temporal patches across multiple scales, effectively capturing both local and global spatiotemporal dependencies. Experiments on the GRACED (Global Reanalysis of Carbon Emissions Data) demonstrate that CarbonDyn outperforms state-of-the-art methods. Specifically, on the global domain, CarbonDyn achieves a global Root Mean Squared Error (RMSE) of 403.285 kgC h−1 with a 1.32% improvement over the second-best model, while it attains an R2 of 0.930 and RMSE of 40.763 kgC h−1 (5.1% reduction) in the Northeast China forest area, validating the framework’s superior predictive capability. As an engineering application, CarbonDyn delivers high-resolution, meteorologically informed CO2 forecasts that can be seamlessly integrated into energy management systems, support data-driven climate policy decisions, and optimize low-carbon transition strategies in power grids and industrial networks.}
}
@article{LIU2026115826,
title = {HNAS-EEG: Hierarchical neural architecture search for robust multi-source cross-subject EEG emotion recognition},
journal = {Applied Soft Computing},
volume = {202},
pages = {115826},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115826},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012743},
author = {Huan Liu and Guanjian Liu and Yuhan Shi and Yuzhe Zhang and Dalin Zhang},
keywords = {EEG-based emotion recognition, Hierarchical neural architecture search, Multi-source domain adaptation},
abstract = {Electroencephalography (EEG)-based emotion recognition remains challenging due to strong inter-subject variability and significant distribution shifts between training and testing data. Existing multi-source domain adaptation approaches alleviate part of this mismatch, but their performance is fundamentally limited by fixed, hand-crafted architectures that fail to capture heterogeneous EEG patterns across subjects. To address this limitation, we propose HNAS-EEG, a multi-source domain adaptive emotion recognition framework driven by hierarchical neural architecture search (NAS). The method automatically constructs a cross-domain feature extractor through joint micro–macro architecture optimization. At the micro level, a soft parameterized derivation mechanism searches for diverse spatiotemporal operators. At the macro level, a predefined connectivity scheme enables the flexible discovery of effective topological structures. On top of the searched backbone, lightweight domain-specific perceptrons refine shared representations and enhance transferability through MMD-based alignment and classifier discrepancy minimization. Experiments on SEED, SEED-IV and DEAP demonstrate that HNAS-EEG consistently outperforms state-of-the-art handcrafted and NAS-based models, achieving notable improvements in both accuracy and F1-score. These results validate the effectiveness of hierarchical NAS in learning domain-invariant yet adaptable representations for robust cross-subject EEG emotion recognition.}
}
@article{JI2026115821,
title = {GCQRIME: An enhanced RIME algorithm with adaptive elite-guided Gaussian-Cauchy mutation and quadratic interpolation for feature selection},
journal = {Applied Soft Computing},
volume = {202},
pages = {115821},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115821},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601269X},
author = {Zunhao Ji and Yi Chen and Huiling Chen},
keywords = {RIME, Feature selection, Metaheuristic, Global optimization},
abstract = {Feature selection is a preprocessing step of paramount importance in machine learning. Its core objective is to select the most relevant feature subset from the original data while eliminating irrelevant or redundant features, ultimately achieving dimensionality reduction, improved model prediction performance, accelerated training speed, and enhanced model interpretability. The application of metaheuristic algorithms to feature selection has become increasingly prevalent in recent years, with researchers proposing various metaheuristic approaches for this task. Among them, RIME is an effective and recently proposed metaheuristic algorithm whose design is rooted in the physics of rime-ice growth. However, the RIME algorithm tends to converge locally and exhibits limited exploration, which constrains its overall performance. To overcome these limitations, this paper introduces three strategies, Adaptive Elite-Guided Gaussian Mutation (AEGM), Adaptive Elite-Guided Cauchy Mutation (AECM) and Quadratic Interpolation (QI), to enhance the original RIME algorithm, resulting in the proposed GCQRIME. The AEGM strategy guides the algorithm to perform extensive exploration at the beginning and then gradually shifts its behavior toward more refined local searching. The AECM strategy strengthens the algorithm's capacity to avoid getting trapped in local optima and promotes convergence. The QI strategy improves the algorithm's performance in local exploitation. GCQRIME was evaluated through various experiments on the IEEE CEC 2014 benchmark functions, validating the effectiveness of these three strategies. Furthermore, this paper proposes a binary version of GCQRIME (bGCQRIME) and performs feature selection experiments on 15 different public datasets against multiple algorithms. The final results indicate that bGCQRIME achieves strong effectiveness in addressing feature selection problems.}
}
@article{NIE2026115863,
title = {Long and short-term hybrid opinion dynamics model with self-stubbornness},
journal = {Applied Soft Computing},
volume = {202},
pages = {115863},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115863},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013116},
author = {Junyu Nie and Xianyong Li and Siyuan Ni and Yajun Du and Dong Huang and Jian Zhu and Zhicheng Dong and Xiaoliang Chen},
keywords = {Opinion dynamics, Deep learning, Self-stubbornness, Social networks},
abstract = {The formation and evolution of opinions are essential phenomena in social networks. Previous work has rarely integrated opinion dynamic models with deep learning. This paper proposes a long and short-term hybrid opinion dynamics model with self-stubbornness (LSSHOD). Considering social interaction mechanisms and data-driven approaches, the model introduces a data augmentation module. Combining long and short-term opinions, it uses a self-attention mechanism to learn user long-term opinion features and a gated recurrent unit to capture user short-term opinion features. In addition, we introduce self-stubbornness to measure an individual’s level of adherence to their initial opinions and propose a hybrid ordinary differential opinion dynamic model with self-stubbornness. The experimental results show that the accuracy (ACC), Macro average (Macro-F1), Precision, and Recall scores perform better than other baseline methods in predicting users’ opinions on the three synthetic, Twitter Abortion, and Twitter BlackLivesMatter (BLM) datasets. The ablation experiment also proves the effectiveness of each module in the LSSHOD model.}
}
@article{SONG2026115915,
title = {MEN-OCSVM: Robust one-class classification by integrating manifold learning and elastic net with a Huberized pinball loss},
journal = {Applied Soft Computing},
volume = {202},
pages = {115915},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115915},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013633},
author = {Yunyan Song and Wenxin Zhu},
keywords = {Manifold elastic net, One-class support vector machine, Proximal gradient algorithm, Friedman test, Nemenyi post hoc test},
abstract = {One-class support vector machines (OCSVMs) are widely adopted for anomaly detection scenarios where only single-class target data is accessible. However, traditional OCSVMs suffer from several critical drawbacks: high sensitivity to outliers induced by the hinge loss, challenges in feature selection and manual parameter tuning, poor scalability of dual optimization formulations, and insufficient exploitation of the intrinsic geometric structure of unlabeled data. To tackle these issues, this paper proposes a novel Manifold Elastic Net OCSVM (MEN-OCSVM), which integrates manifold learning and elastic net regularization into a unified framework with a Huberized pinball loss. Elastic net regularization enhances robust feature selection and addresses feature multicollinearity, while manifold regularization leverages both labeled and unlabeled samples to capture the inherent geometric structure of data distributions. The Huberized pinball loss further boosts the model’s robustness to noise and outliers, and a proximal gradient algorithm is employed to efficiently optimize the primal problem, significantly improving computational efficiency. Extensive experiments are conducted on synthetic datasets, classic benchmark datasets (including facial recognition (Yale, ORL), handwritten digits (USPS), and multiple UCI benchmarks), and the real-world SKAB fault diagnosis dataset. Comprehensive evaluations across key metrics (AUC, F1-score, G-mean, PR-AUC), rigorous parameter sensitivity analysis, and statistical significance tests confirm that MEN-OCSVM outperforms state-of-the-art methods in detection performance, maintains strong feature selection capability, and exhibits stable performance across reasonable parameter ranges. The results underscore the method’s superior robustness to noise and great potential for practical anomaly detection applications in complex, noisy real-world environments.}
}
@article{KANWAL2026115845,
title = {Deepfake detection: A review of audio, visual and multimodal techniques},
journal = {Applied Soft Computing},
volume = {202},
pages = {115845},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115845},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012937},
author = {Rimsha Kanwal and Humaira Ashraf and N.Z. Jhanjhi and Qurat ul Ain Zam Zam Mirza},
keywords = {Deepfake detection, Multimodal fusion, Audio-visual forensics, Generative models (GANs, Diffusion), Explainable detection, Robustness and generalization, Benchmark datasets, Security and privacy in detection, Transformer models, Social media manipulation},
abstract = {Deepfakes have become one of the major risks to the integrity of digital information, especially on social media sites where it is possible to spread images, videos, and audio content quickly. The development of generative models, such as generative adversarial networks (GANs), transformers, and diffusion-based architectures, has facilitated the development of highly realistic synthetic media, exposing people to an increased threat of misinformation, fraud, and manipulation on the Internet. The paper will present a detailed overview of the deepfake detection systems in the image, video, audio, and multimodal domains with the focus on the development within the period of 2021–2025. It systematically examines state-of-the-art approaches in terms of accuracy of detection, robustness, dependence on the dataset, and cross-domain generalization, and highlights the applications of the approach under realistic settings, including compression, noise, and platform-specific artifacts. In addition, the review identifies major shortcomings of the current methods such as lack of the ability to generalize across datasets, vulnerability to quality deterioration, computational infeasibility, and low interpretability. To overcome these issues, the conceptual proposal is presented for a multimodal deepfake detector, combining features of cross-modal fusion, adaptively weighted reliability-awareness, uncertainty modeling, and explainability models to promote robustness and scalability in practical settings. In general, the review summarizes the recent trends in the research and offers some comparative information on the approaches to detection, and reveals the unresolved issues and the future research perspectives that can help to create effective and generalizable systems that can detect deepfakes.}
}
@article{YAO2026115859,
title = {A multi-objective robust two-population cooperation search algorithm for cascade hydropower reservoir operation under uncertain environment},
journal = {Applied Soft Computing},
volume = {202},
pages = {115859},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115859},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013074},
author = {Xin-ru Yao and Tie-Sheng Guan and Zhong-kai Feng and Li Zhang and Xin Yin and Yi-fan Xia and Wen-jing Niu},
keywords = {Multi-objective optimization, Uncertainty, Evolutionary algorithms (EAs), Robust optimization, Risk perturbations, Cooperation Search Algorithm (CSA)},
abstract = {Uncertainty in robust multi-objective optimization introduces significant challenges in risk characterization, performance evaluation, and striking a trade-off between optimality and robustness. To address these challenges, we propose a novel robust two-population cooperative evolutionary algorithm (RTPCEA) that integrates a two-population cooperative search strategy with a dynamic robust fitness evaluation mechanism. The proposed algorithm efficiently tackles high-dimensional and complex problems while preserving both optimality and robustness. Furthermore, it establishes a dynamic and adaptive evaluation framework for non-dominated solution sets, featuring a controllable computational cost and a comprehensive quantification of solution set resilience. When evaluated against state-of-the-art robust optimization algorithms on benchmark functions, RTPCEA consistently achieves optimal and stable Inverted Generational Distance (IGD) and Hypervolume (HV) metrics under various perturbations, maintaining a feasibility rate (FR) strictly above 0.95. These results substantiate its enhanced stability and overall performance. In applying RTPCEA to the robust optimization of cascade reservoirs under multiple sources of uncertainty, runoff inputs and decision variables are modeled as risk perturbation factors, enabling the quantitative characterization of risk impacts and ensuring practical operational reliability. The case study confirms that RTPCEA generates a more uniformly distributed Pareto front with superior convergence characteristics. Under scenarios considering multiple perturbations, the resulting scheduling schemes exhibit a more robust distribution, effectively avoiding extreme decisions that are highly sensitive to uncertainty. Ultimately, RTPCEA exhibits notable computational efficiency and solution quality when solving constrained, complex real-world problems, significantly enhancing the feasibility of the resulting decision-making schemes. Future research will focus on advancing intelligent decision-making under complex uncertainty by integrating enhanced computational efficiency with a more nuanced characterization of risk factors.}
}
@article{LI2026115871,
title = {Adaptive dispersed decision-making system with three-way conflict analysis},
journal = {Applied Soft Computing},
volume = {202},
pages = {115871},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115871},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013190},
author = {Xiaonan Li and Zhuohao Qian},
keywords = {Three-way decision, Dispersed decision-making system, Conflict analysis, Adaptive clustering},
abstract = {This paper presents a novel dispersed decision-making system, aiming to improve its adaptability and enhance the efficiency of handling complex, dispersed knowledge. Dispersed decision-making systems are crucial for managing knowledge stored in a distributed fashion, where the selection of relevant objects significantly affects decision outcomes. To address this, we propose an adaptive method for calculating relevant objects based on k-means clustering, ensuring alignment with data characteristics. Moreover, a relationship definition that simultaneously considers the membership degree differences and rank differences of decision vectors among agents is introduced, which is convenient for handling complex and dispersed knowledge. After the initial agent division, three-way clustering is applied to manage the relationship between neutral and alliance agents, optimizing the role of neutral agents in decision-making. The effectiveness of this adaptive dispersed decision-making system with three-way conflict analysis (ADDS) is verified by a real-world illustrative example and the experimental results obtained from the data in the UCI repository.}
}
@article{HE2026115841,
title = {PDIFormer: Price-discovery-informed deep temporal learning for price dynamics in small-scale commodity markets},
journal = {Applied Soft Computing},
volume = {202},
pages = {115841},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115841},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012895},
author = {Jiaqi He and Linfei Xiong and Hanwen Ning},
keywords = {Small-scale commodity markets, Price discovery, Deep temporal learning, Cross multi-head attention, PDIFormer},
abstract = {The price dynamics of small-scale commodity markets are of great importance but remain insufficiently explored. This study investigates the distinctive price discovery characteristics of small-scale commodity markets and proposes a novel price-discovery-informed deep temporal forecasting network for such markets. First, to address the limitations of existing price discovery measures in low-liquidity markets, we propose an improved price discovery share (IPDS) measure that provides more robust and economically interpretable estimates of the lead–lag relationship between futures and spot markets. Second, based on the identified lead–lag structure, we design a price discovery guidance module (PDGM) and integrate it with parallel multi-scale temporal convolutional encoders and cross multi-head attention mechanisms to construct the proposed Price-Discovery-Informed Transformer (PDIFormer). The proposed framework incorporates price discovery information into the forecasting architecture, enhancing both predictive performance and economic interpretability. Extensive experiments on the polypropylene (PP), rapeseed meal, cotton, and purified terephthalic acid (PTA) markets show that the proposed IPDS measure provides more stable price discovery results. Meanwhile, PDIFormer consistently outperforms a wide range of benchmark models in forecasting accuracy and robustness. This study highlights that econometric insights can be effectively incorporated into deep learning architectures, offering a promising paradigm for economically informed forecasting in financial markets.}
}
@article{JIN2026115862,
title = {Stock look-ahead prediction and portfolio management using fuzzy transformer architecture and reinforcement learning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115862},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115862},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013104},
author = {Hui Jin and Qi Cao and Chai Quek},
keywords = {Fuzzy transformer architecture, Look-ahead predictions, Predicted technical indicator, Portfolio management},
abstract = {In the modern Artificial Intelligence (AI) centric world, the unmatched data processing prowess of deep learning is often overshadowed by its black box nature, making its predictions seem arcane in certain industrial sectors. It is beneficial to understand the rationale behind the decisions or predictions by the networks. The need for interpretability gradually becomes desirable. This research introduces an innovative type of fuzzy neural network (FNN), incorporating the favourable performance offered by a Transformer network with a five-layer fuzzy logic system. The proposed fuzzy Transformer architecture combines the attention layers in the encoder-decoder structure with human understandable fuzzy rules, which maintains favorable predictive performance while enhancing its interpretability. Based on the multi-day look-ahead prediction results of fuzzy Transformer architecture, a predicted Moving Average Convergence Divergence (MACD) technical indicator is derived, which greatly alleviates the latency problem inherent in the vanilla MACD indicator. A framework is developed using the fuzzy Transformer architecture to take in time series financial data after preprocessing, normalization and feature selections. With the predicted MACD indicator from the fuzzy Transformer architecture, a reinforcement learning (RL) agent is revised and trained for portfolio management comprising three financial assets. Experiments are conducted on fuzzy Transformer architecture to forecast the multi-day look-ahead prices, up to 10 days look-ahead. Prediction performance on individual assets is evaluated and compared with those of another four deep learning neural networks. The proposed fuzzy Transformer architecture achieves higher average improvement results by 3.2–154.5%. The predicted MACD performance results are also compared with four deep learning models and the vanilla MACD. The proposed fuzzy Transformer outperforms most benchmark models on multiple metrics. The performance of portfolio management with the RL agent is also analyzed, with the tunable hyper parameters. Observed from the experiment results, the developed system consisting of revised feature selection algorithm, fuzzy Transformer architecture and revised RL agent is able to improve the performance in trading tasks and portfolio management.}
}
@article{LIU2026115854,
title = {Predicting cancer risks by a deep causal network with unobserved deconfounding},
journal = {Applied Soft Computing},
volume = {202},
pages = {115854},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115854},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013025},
author = {Li Liu and Shanshan Huang and Lei Wang and Shu Wang and Xianping Zhang and Sixi Zha and Guoxin Su and Qing Tao},
keywords = {Cancer risk prediction, Unobserved confounders, Causal network, Latent representations},
abstract = {A key challenge in cancer risk prediction is the fact that existing models can often yield convincing predictive results but lack interpretability and reliability of the underlying characteristics, which, however, are extremely significant in cancer diagnosis. Causal models greatly improve reliability, yet they heavily rely on the assumption that all confounders are observed. Unfortunately, such an assumption is difficult to meet in reality. This leads us to present an end-to-end deep generative multi-causal model that employs Transformer and GAN to generate unobserved confounders in the latent space by inferring various treatment assignments. The model incorporates these confounders into a deep prediction network, thereby explicitly mitigating the influence of unobserved confounders on causal effect estimation. Moreover, it can be analytically shown that the model possesses the capability to estimate the effects of multiple causes on the outcome. Empirical evaluations on benchmark datasets suggest that our approach significantly outperforms the state-of-the-art methods.}
}
@article{WU2026115809,
title = {Adaptive cost-sensitive neural network with metric pre-training for disease diagnosis on high-dimensional imbalanced clinical data},
journal = {Applied Soft Computing},
volume = {202},
pages = {115809},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115809},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012573},
author = {Yao Wu and Lean Yu and Sutong Wang},
keywords = {Metric pre-training, Adaptive cost-sensitive learning, High-dimensional imbalanced data, Disease diagnosis},
abstract = {Building an intelligent diagnosis model based on clinical data improves the efficiency of medical decision-making and reduces healthcare costs. However, the uneven distribution of disease prevalence (imbalanced dataset) and multiple clinical features (high-dimensional features) significantly impact the model’s prediction performance, leading to occurrences of misdiagnosis and underdiagnosis. This paper proposes an Adaptive Cost-sensitive Neural Network with Metric Pre-training (AdaCSNN-MPT) to address the above issues. Firstly, metric pre-training is proposed to learn effective low-dimensional representations and provide better parameter initialization. Secondly, an adaptive cost-sensitive neural network is proposed to improve the overall classification performance by identifying hard-to-classify invaded samples. Experiments on six real-world disease diagnosis tasks demonstrate that AdaCSNN-MPT outperforms the baseline models.}
}
@article{YANG2026115870,
title = {Target-free causal-gated domain generalization for rotating machinery fault diagnosis under operating-condition shifts in smart factories},
journal = {Applied Soft Computing},
volume = {202},
pages = {115870},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115870},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013189},
author = {Tingwei Yang and Xiao Wang and Qinmu Wu and Zhiqin He},
keywords = {Smart factories, Domain generalization, Rotating machinery, Cross-domain fault diagnosis, Variable operating conditions},
abstract = {Rotating machinery in smart factories often operates under varying speeds and loads, leading to distribution shifts in vibration signals and degraded diagnostic performance under unseen operating conditions. Since target-condition data may be unavailable before deployment, this study investigates fault diagnosis under a target-free domain generalization (DG) setting, where no target-domain samples are used during training. To address this problem, we propose CGDG-Net, a causal-gated DG framework designed to improve cross-condition representation robustness by emphasizing mechanism-relevant fault cues and reducing operating-condition–coupled nuisance information. Specifically, multiscale deformable feature extraction is introduced to characterize condition-induced temporal pattern variations, while selective-kernel attention adaptively fuses complementary multiscale responses. In addition, a causal gating mechanism is incorporated to modulate feature channels in a stability-oriented manner, encouraging class-consistent responses across source operating conditions. Experiments on eight cross-domain tasks constructed from the Paderborn University bearing dataset and the University of Ottawa Electric Motor Dataset show that CGDG-Net improves the average diagnostic accuracy by 2.11 and 1.02 percentage points, respectively, over the strongest compared DG baseline. Further evaluations under wide-range speed and load variations, together with ablation studies and representation diagnostics, support the effectiveness and robustness of the proposed framework for target-free cross-condition fault diagnosis.}
}
@article{SINGH2026115801,
title = {A multi-criteria group decision-making approach with incomplete weight information: A case study on selecting third-party reverse logistics providers},
journal = {Applied Soft Computing},
volume = {202},
pages = {115801},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115801},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012494},
author = {Meenu Singh and Lingping Kong and Millie Pant and Václav Snášel},
keywords = {MCGDM, Ranking, Weighting method, Incomplete data, Matrix completion, Data imputation, VIKOR, 3PRLPs selection},
abstract = {Missing or incomplete values are often a common problem in real-life, data-dependent, decision-making problems. The situation becomes worse with the increase in the number of decision-makers (DMs) in multi-criteria group decision-making (MCGDM) problems, leading to incorrect or biased conclusions. This study presents a new approach, named the Modified D-matrix (MoDM) approach, designed to enhance decision-making functionality by addressing missing or incomplete preference information in MCGDM. The method transforms qualitative pairwise judgments of decision-makers into a dominance-based quantitative matrix and incorporates an imputation mechanism to handle incomplete preference information. During the imputation process, it utilizes a gradient descent algorithm for minimizing the error between the initial and the estimated dominance matrix, enabling the evaluation of weights while handling incomplete information. The effectiveness of MoDM is validated through comparisons with existing multi-criteria decision-making (MCDM) weighting methods using objective performance metrics and qualitative characteristics, demonstrating its consistency, robustness, transparency, and computational efficiency. The derived weights are combined with Vlse Kriterijumska Optimizacija I Kompromisno Resenje (VIKOR) to rank the third-party reverse logistics providers (3PRLPs) in the packaging industry. The VIKOR results reveal that rankings are highly sensitive to different weight sets, with noticeable differences between biased and bias-free weights, thereby highlighting the critical role of accurate weight estimation. Overall, the proposed MoDM - VIKOR framework effectively handles incomplete preference information and enhances the decision-making processes in practical scenarios.}
}
@article{WU2026115874,
title = {FDRMFL: Multimodal federated feature extraction model based on information maximization and contrastive learning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115874},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115874},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013220},
author = {Haozhe Wu},
keywords = {Multimodal data analysis, Feature extraction, Federated learning, Contrastive learning},
abstract = {We propose FDRMFL, a task-driven multimodal feature extraction framework for federated regression under non-IID data distributions. Extracting predictive features from high-dimensional multimodal inputs is particularly challenging in this setting: data cannot leave each client, local samples are scarce and heterogeneously distributed, and unsupervised dimensionality reduction discards task-relevant information while federated training introduces representation drift across communication rounds. FDRMFL addresses these challenges through a unified four-term local objective: MSE prediction loss, a correlation-based mutual information surrogate that preserves dependence between the fused representation and the continuous target, a symmetric KL penalty that aligns cross-modal latent distributions before fusion, and an InfoNCE-style contrastive loss that anchors local representations to the global consensus. Experiments on three synthetic and two real-world near-infrared spectroscopy datasets under non-IID federated partitions, with comprehensive ablation and sensitivity analyses, demonstrate that each component contributes to the framework’s effectiveness. FDRMFL reduces mean MSE by 33.8% relative to the best traditional baseline (PCA) and by 43.0% relative to VAE in simulation, and attains the lowest overall mean MSE among six federated algorithms including FedAvg, FedProx, MOON, SCAFFOLD, and FedBN.}
}
@article{MIAO2026115890,
title = {Reducing the attack surface of adversarial example detectors with implicit keys},
journal = {Applied Soft Computing},
volume = {202},
pages = {115890},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115890},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013384},
author = {Junzhong Miao and Likun Liu and Zhichao Hu and Mengmeng Ge and Bei Zhao and Zhaolin Wan and Xiangzhan Yu},
keywords = {Adversarial example detection, Contrastive learning, Topological distortion, Implicit keys, Attack surface},
abstract = {Adversarial example detection is an important defense for safeguarding deep neural networks. However, since many existing detectors are themselves DNN-based models, attackers can apply gradient-based optimization strategies similar to those used against classifiers to craft adversarial examples (AEs) that both fool the target classifier and evade detection, thereby introducing an additional attack surface into the defense system. To address this challenge, we propose an AE detection framework based on implicit keys, which introduces a set of external random keys as hidden reference points. Instead of relying only on the input representation itself, the detector measures the relative distance distribution between an input and the implicit keys in a contrastive embedding space. We observe that natural examples (NEs) tend to preserve a relatively uniform relationship with these keys, whereas AEs exhibit more uneven distance distributions with respect to the keys. Leveraging this insight, we define topological distortion by characterizing the unevenness of the distance distribution between inputs and implicit keys, and train a dual-encoder detector to minimize the distortion of NEs while maximizing that of AEs. Since the implicit keys are independent of the training data and hidden from attackers, the proposed design reduces the exposed attack surface and improves robustness against adaptive attacks. Extensive experiments on CIFAR-10, CIFAR-100, SVHN, and ImageNet-100 under eight adversarial attack settings show that our method achieves an average AUROC of 98.63% and ranks first in 23 out of 32 evaluation settings. Moreover, the average AUROC degradation under adaptive attacks is only 0.5% in the gray-box setting and 2.1% in the white-box setting, demonstrating the effectiveness and robustness of the proposed detector.}
}
@article{YANG2026115866,
title = {Solving the capacitated vehicle routing problem via a collaborative adaptive fusion transformer},
journal = {Applied Soft Computing},
volume = {202},
pages = {115866},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115866},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013141},
author = {Zhongzhi Yang and Junqing Li and Yanan Wang and Hui Zhang},
keywords = {Deep reinforcement learning, Transformer, CVRP, Deep models},
abstract = {In recent years, Deep Reinforcement Learning (DRL) has emerged as a promising approach to solving Vehicle Routing Problems (VRPs). However, most existing methods primarily focus on learning constructive policies, which often result in suboptimal generalization performance and low inference efficiency. Even state-of-the-art improvement-based DRL methods (e.g., DACT) suffer from redundant heterogeneous feature fusion, inadequate structural characterization of routing solutions, and training frameworks that are not adapted to the iterative optimization paradigm. To address these limitations, this study proposes a Collaborative Adaptive Fusion Transformer (CAFT) model within the encoder–decoder framework, aiming to iteratively optimize complete solutions and derive improved policies. The core innovations of CAFT that fundamentally distinguish it from existing works are threefold: (1) A novel Collaborative Adaptive Fusion Attention Mechanism (CAF-AM) is designed, which adopts a primary-auxiliary dual-branch architecture (instead of the peer dual-branch design in DACT) to jointly learn node feature embeddings and visit index embeddings, with a MultiFocusNet module to dynamically balance the contribution of two branches, effectively reducing noise and inconsistent correlations in heterogeneous feature fusion. (2) We adapt the cyclic positional encoding framework for our primary-auxiliary architecture to generate Visit-Index Embeddings (VIE), which captures the inherent circular and symmetric characteristics of VRP solutions. Specifically, the VIE is fully updated after each route modification across iterations, and reused across encoder layers within a single iteration to maintain a stable sequence reference, avoiding semantic drift and redundant computation. (3) A task-adaptive PPO training framework with curriculum learning is developed, which is tailored for the iterative improvement paradigm and deeply coupled with our encoder design, ensuring fast and stable convergence. We evaluate the effectiveness of CAFT on the Capacitated Vehicle Routing Problem (CVRP). Experimental results demonstrate that CAFT outperforms state-of-the-art DRL methods in terms of solution accuracy, and achieves significant improvements in inference efficiency over DACT, with gains of 24.05%, 13.73%, and 3.87% on CVRP20, CVRP50, and CVRP100, respectively. On small-scale CVRP20 instances, CAFT yields statistically comparable near-optimal solution quality relative to the LKH heuristic under data augmentation. Furthermore, CAFT exhibits strong zero-shot cross-distribution generalization on the CVRPLIB benchmark, demonstrating its adaptability and robustness, indicating potential for further practical applications in logistics.}
}
@article{LI2026115837,
title = {MS-DeepLabv3+: A lightweight attention-enhanced model for accurate road damage segmentation with long-range contextual modeling},
journal = {Applied Soft Computing},
volume = {202},
pages = {115837},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115837},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012858},
author = {Guangming Li and Ruiyang Sun and Guizhen Niu and Tingting Duan and Baozhen Zhang},
keywords = {Road damage, Damage detection, Semantic segmentation, Image segmentation, Lightweight network},
abstract = {Precise segmentation of road surface damage is crucial for intelligent maintenance of transportation infrastructure. However, existing methods often suffer from fragmented segmentation, inadequate capture of long-range dependencies, and excessive computational overhead. To address these limitations, this work proposes MS-DeepLabv3+. Specifically, the proposed model adopts a lightweight MobileNetV3 backbone to improve inference efficiency. Furthermore, a Mixed Local Channel Attention (MLCA) mechanism is introduced to enhance feature discrimination and refine the feature representation of fine-grained damage. Additionally, a Strip Pooling Module (SPM) is integrated to capture long-range dependencies of elongated cracks. Extensive experiments were conducted on a self-constructed multi-type road damage dataset and the public Crack500 dataset, including comparisons with lightweight and long-range context modeling architectures. On the self-constructed dataset, MS-DeepLabv3+ improves average pixel accuracy (mPA) from 83.6% to 89.3% and mean intersection over union (mIoU) from 71.3% to 73.7% compared with the lightweight DeepLabv3+ baseline. The model maintains a compact size of 6.7 M parameters and achieves real-time inference speed. The ablation and comparative experiments further demonstrate that compared to the original DeepLabv3+ and other algorithms, MS-DeepLabv3+ significantly reduces inference time, making it more suitable for real-time deployment. These results suggest that MS-DeepLabv3 + offers a practical and scalable solution for real-time, robust, and high-accuracy road damage detection in real-world deployment scenarios. A preliminary edge deployment test on Jetson Orin NX using INT8 inference achieved 22.1 FPS with less than 2.1% accuracy degradation compared with desktop GPU inference, suggesting the potential feasibility of MS-DeepLabv3 + for real-time road damage segmentation on representative edge hardware.}
}
@article{TAVEIRA2026115829,
title = {Sentiment analysis using word centrality based on ant colony optimization pheromones},
journal = {Applied Soft Computing},
volume = {202},
pages = {115829},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115829},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012779},
author = {Rafael de Oliveira Taveira and André Ricardo Backes},
keywords = {Ant colony optimization, Sentiment analysis, Text mining, Complex network, Social network},
abstract = {Sentiment analysis and text mining techniques allow researchers and companies to identify trends, patterns, and emotions expressed in posts on social networks. This can be used for various purposes, from improving marketing strategies to understanding social and political issues. This project develops an innovative methodology for analyzing text sentiment, using word centrality—a metric that quantifies the importance of individual words in a network of word relationships—based on Ant Colony Optimization (ACO) pheromones, an algorithm inspired by how ants find optimal paths using chemical trails. The model allows a deep and contextualized analysis of sentiments by treating pheromone accumulation as a dynamic centrality measure that reinforces sentiment-consistent word co-occurrences through iterative exploration. The results of the experiments show that combining ACO and its integration with other centrality measures, such as Katz, PageRank, EigenVector, and Degree Centrality, significantly improves the accuracy of sentiment analysis on various datasets, showing a 5% absolute improvement in US Airlines and 10% in Tweets With Theme compared to the best-performing individual centrality baseline. These results indicate that the proposed methodology is effective in capturing the emotional nuances present in texts.}
}
@article{CHARIZANOS2026115833,
title = {A new fuzzy-Bayesian multiple imputation approach for missing data},
journal = {Applied Soft Computing},
volume = {202},
pages = {115833},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115833},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012810},
author = {Georgios Charizanos and Haydar Demirhan and Duygu İçen},
keywords = {Missing values, Fuzzy numbers, JAGS, Linear regression, Model uncertainty, Nonlinear relationships},
abstract = {Missing values pose a fundamental challenge and must be imputed accurately in data-driven applications. Imputation and model uncertainties, as well as the impact of data characteristics such as non-linear relationships, skewness, and outliers, must be addressed through multiple imputation. Mainly, we use statistical, machine learning, and deep learning methods for this purpose. Available methods struggle to simultaneously handle the multiple imputation challenges. Statistical methods often rely on strong distributional assumptions or struggle with data challenges. Although machine learning and deep learning methods improve upon the imputation uncertainty, they remain sensitive to data irregularities and do not quantify model uncertainty. To address these limitations, we introduce the fuzzy-Bayesian multiple imputation (FBMI) framework, which integrates Bayesian modeling with fuzzy operations, employing Gaussian fuzzy numbers. FBMI handles imputation and model uncertainty while capturing challenging data characteristics. Moreover, we conduct an extensive benchmarking study against ten widely used statistical, machine learning, and deep learning imputation methods across twenty five datasets, under varying levels of outlier contamination and distributional characteristics. The results demonstrate that while FBMI consistently outperforms benchmark methods across different missingness settings, improving imputation accuracy on average by between 26% and 68% across multiple performance indicators, it is also computationally efficient and supported by openly available software.}
}
@article{ZHOU2026115894,
title = {Improving the prediction accuracy of aircraft engine non-volatile particulate matter emission indices through deep learning model},
journal = {Applied Soft Computing},
volume = {202},
pages = {115894},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115894},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013426},
author = {Limin Zhou and Zhenhong Yu and Ye Lu and Yiwei Zhao and Longfei Chen and Yushan Ni},
keywords = {Aircraft engine, Non-volatile particulate matter, CNN-SVM model, LTO cycle, Prediction model},
abstract = {Accurate prediction of aircraft engine non-volatile particulate matter (nvPM) emissions during the landing and take-off (LTO) cycle is crucial for assessing its environmental impact on airport air quality. However, existing statistical methods recommended by the civil aviation industry rely on the engine smoke number and other indirect influencing parameters. By utilizing the parameter fitting ability of convolutional neural network (CNN) and the parameter selection ability of support vector machine (SVM) under small-sample datasets, an integrated CNN-SVM model to predict aircraft engine nvPM mass and number emission indices in the LTO cycle is proposed in this study. The prediction accuracy of the CNN-SVM model is compared with that of the statistical model, and the predicted nvPM mass and number emission indices for typical aircraft engines are subsequently used to evaluate their emission performance. Results show that over 90% of estimated nvPM mass and number emission indices fall within the 95% prediction interval for all LTO phases, outperforming relevant statistical method with higher R² (0.95 vs. 0.8 and 0.94 vs. 0.82) and lower RMSE (43.85 mg/kg vs. 82 mg/kg and 8.36*1014 #/kg vs. 1.6*1015 #/kg) respectively. Additionally, the evaluation of typical engine nvPM emission performance based on predicted values via CNN-SVM model is consistent with relevant certification results, demonstrating its feasibility for engine emission compliance assessment. Therefore, the proposed CNN-SVM model can not only achieve high-accuracy data to assess the environmental impact of aircraft engine nvPM emissions generated in the LTO cycle, but also potentially provide an effective data-driven approach for equivalent airworthiness evaluation of aircraft engine nvPM emissions in the global aviation industry.}
}
@article{MOHAMED2026115849,
title = {A generative adversarial network framework for intelligent crowd anomaly detection in metaverse airport surveillance},
journal = {Applied Soft Computing},
volume = {202},
pages = {115849},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115849},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012974},
author = {Soha Abd El-Moamen Mohamed and Heba Askr and Aboul Ella Hassanien},
keywords = {Crowd-based anomaly detection, Airport video surveillance, Generative adversarial network (GAN), Generative artificial intelligence, YOLOv8, Metaverse},
abstract = {This paper presents an innovative anomaly detection system at virtual airport crowd surveillance in the Metaverse, employing the functionalities of Progressive Growing of Generative Adversarial Networks (PGGAN). The suggested system uses the immersive and scalable qualities of Metaverse simulations to deal with the difficulties of keeping an eye on crowds in a virtual setting. It makes it possible to watch and study how large groups of people act in real time. The proposed system works in three main steps. The first step is to create a new dataset that consists of videos that were captured from surveillance cameras at different places at the virtual airport. The second step uses GANs to predict strange events that will happen in the future. The third step is the YOLOv8 model to find strange crowd movements and traffic jams. To train and test the system, a custom dataset with 13,815 frames was made. It includes both normal and abnormal behaviors in three different virtual airport scenarios. PGGAN is used to generate synthetic frames, which add more scenarios to the dataset and make it more useful. The framework shows good performance based on the experimental results, achieving 0.99 precision, 0.97 recall, and 0.98 mean Average Precision (mAP). This system can be considered a useful step for improving security in virtual airport environments, as it combines GAN-generated data with metaverse features.}
}
@article{YANG2026115886,
title = {The combined FP-growth and ant colony optimization algorithms in scientific research project management},
journal = {Applied Soft Computing},
volume = {202},
pages = {115886},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115886},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013347},
author = {Dan Yang and Xuying Dong and Wanlin Qiu},
keywords = {FP-Growth algorithm, Ant colony optimization, Scientific research project management, Optimization model, Data mining},
abstract = {This study addresses the complexity of resource allocation and task scheduling in scientific research project management. To this end, a hybrid optimization framework integrating the Frequent Pattern Growth (FP-Growth) algorithm and Ant Colony Optimization (ACO) is proposed. First, FP-Growth is applied to preprocessed project data to identify key tasks and strongly associated task combinations. Based on these results, an improved ACO algorithm is then employed for task allocation and resource scheduling, where ant-inspired search behavior is used to optimize task execution paths. Experimental comparisons with conventional methods demonstrate the effectiveness of the proposed model. The FP-Growth–ACO approach reduces path length by 45.22%, decreases iteration counts by 78.85%, and improves convergence efficiency by 83.92%. In addition, the number of turning points is reduced by 31.94%, indicating more efficient path structures. From a project management perspective, the proposed model also achieves superior performance across multiple evaluation metrics, including resource utilization (0.87), cost-effectiveness (0.96), operational efficiency (0.91), technological benefit (0.87), and social benefit (0.76). Overall, the results confirm that the proposed hybrid optimization model effectively improves resource allocation and task scheduling efficiency in scientific research project management, outperforming traditional approaches in both computational and managerial performance.}
}
@article{REN2026115832,
title = {A neural distinguisher based on neural architecture search for information entropy maximization},
journal = {Applied Soft Computing},
volume = {202},
pages = {115832},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115832},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012809},
author = {Wenhuan Ren and Tianyuan Liu and Ting Cui and Linyuan Wang and Libin Hou and Jian Chen and Bin Yan},
keywords = {Neural architecture search, Information entropy maximization, Neural distinguisher, Differential cryptanalysis, Lightweight encryption algorithm},
abstract = {At CRYPTO 2019, Gohr applied deep learning techniques to differential cryptanalysis of SPECK32. The neural distinguisher (ND) he designed achieved higher classification accuracy than traditional differential distinguishers. This achievement offers new perspectives on data security in the Internet of Things (IoT). However, the design and optimization of NDs rely heavily on expert experience, and optimizing network structural hyperparameters requires a great deal of time and resources. To address this issue, we design a neural distinguisher called ND-IEM (Neural Distinguisher based on Information Entropy Maximization). First, we construct the search space of structural hyperparameters by referencing Gohr’s ND. Second, with information entropy maximization as the optimization objective, we obtain an optimized neural distinguisher model by characterizing constraints on network effectiveness, network width, uniformity of network depth distribution, and convolution kernel size. Third, by solving this optimization model, a superior neural distinguisher structure is automatically searched within the search space. Finally, we construct ND-IEM and train it on 11 different ciphertext datasets. Experimental results show that ND-IEM achieves a classification accuracy exceeding 0.505 for 10-round PRESENT and 9-round SPECK64. Furthermore, for SPECK32, SIMON128, SIMON32, SIMON64, SPECK128, GIMLI, XTEA, TEA, and LEA, ND-IEM also achieves higher classification accuracy than the previously superior DBitNet and SE-ResNet. Specifically, ND-IEM achieves significant classification accuracy improvements of 11.2% for 10-round SPECK128 compared to DBitNet.}
}
@article{LI2026115858,
title = {YUV-guided deep compression for low-bitrate IoT image transmission},
journal = {Applied Soft Computing},
volume = {202},
pages = {115858},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115858},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013062},
author = {Kaiyao Li and Mingjun Ouyang and Guanzhong Liao and Xiangwei Zhu and Zhisheng Luo and Yuanling Li and Xuelin Yuan},
keywords = {Learned image compression, YUV space, Low bitrate, Narrowband transmission},
abstract = {Low-bitrate image transmission is a critical prerequisite for Visual IoT applications constrained by stringent bandwidth limits. Despite the emergence of Learned Image Compression (LIC) as a compelling solution, bit resources remain a critical bottleneck in these bandwidth-limited environments. A critical limitation of existing LIC models is their lack of active content awareness, which results in a failure to precisely steer the limited coding budget toward information-rich texture regions. This deficiency leads to inefficient bit allocation: redundant smooth backgrounds consume disproportionate resources, whereas critical structural details are blurred due to allocation starvation. Furthermore, at the optimization level, the standard MSE objective exhibits an inherent spectral bias, tending to discard high-frequency details to minimize global variance. To break this bottleneck, we propose YSG-Net, an asymmetric dual-domain framework. In the feature space, we introduce a YUV Structure Prior Module (YSPM). By leveraging decorrelated structural cues from the Y-channel, we force the model to refocus attention on fine-grained semantic textures, thereby rectifying the bit allocation imbalance between structures and backgrounds. Spectrally, we incorporate Frequency-Aware Regularization (FAR) to impose explicit constraints that penalize high-frequency loss. Extensive experiments on Kodak and FS-30 datasets demonstrate that YSG-Net achieves a 72.43% BD-Rate reduction over JPEG. It not only enhances texture fidelity at low bitrates but also maintains practical inference feasibility on edge devices.}
}
@article{WU2026115885,
title = {Multi-height wind speed forecasting based on multivariate decomposition-driven spatio-temporal residual fusion network},
journal = {Applied Soft Computing},
volume = {202},
pages = {115885},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115885},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013335},
author = {Xiaobang Wu and Deguang Wang and Ming Yang},
keywords = {Wind speed forecasting, Multi-height, Adaptive multivariate variational mode decomposition, Dual-channel architecture, Gated residual fusion network},
abstract = {Accurate multi-height wind speed forecasting is critical for the reliable integration of wind energy into modern power systems. However, existing methods often fail to capture vertical variability and are prone to data leakage during signal decomposition. To address these challenges, this study proposes a novel spatio-temporal hybrid forecasting model. First, an adaptive multivariate decomposition method with an overlapping buffer mechanism is introduced to eliminate boundary effects and prevent data leakage. Subsequently, a parallel dual-channel architecture is constructed, where bidirectional recurrent units model long-range temporal dependencies, while a graph isomorphism network with physically meaningful edge features captures vertical topology using wind shear indices. To reconcile the heterogeneity between temporal and spatial representations, a gated residual fusion network is further designed to enable refined nonlinear integration without sacrificing physical information. Experiments on real-world datasets from two wind farms demonstrate that the proposed model consistently outperforms the competing benchmarks. These results indicate that the integration of leakage-free adaptive decomposition, physics-informed vertical topology modeling, and gated feature fusion provides a robust and effective solution for multi-height wind speed forecasting.}
}
@article{BAHADIR2026115937,
title = {A recommendation-based directed-graph framework for construction activity sequencing},
journal = {Applied Soft Computing},
volume = {202},
pages = {115937},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115937},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013852},
author = {Ümit Bahadır and Fatemeh Mostofi and Vedat Toğan},
keywords = {Construction scheduling, Activity sequencing, Graph neural networks, Graph representation learning, Recommendation systems},
abstract = {Despite increased digitization, the underlying logic of construction sequencing often lacks an explicit structure for data-driven successor-activity recommendation. Existing models, particularly classification-based formulations, may suffer from performance degradation under data sparsity and class imbalance, limiting their operational utility. Furthermore, deep sequence models may be difficult to apply effectively in construction contexts because they typically benefit from dense, repetitive sequences and feature-rich activity descriptions. To address this gap, this study develops a recommendation-based directed-graph framework that formulates construction activity sequencing as a link-prediction problem. Standardized construction activities are represented as nodes, while observed predecessor–successor relationships are represented as directed edges, enabling plausible successor activities to be ranked from historical schedule structures. The framework evaluates Association Rule Mining (ARM) as a rule-based recommendation method, DeepWalk and node2vec as random-walk embedding methods, and GCN, GAT and GraphSAGE as graph neural network (GNN) benchmarks. Experiments were conducted on directed activity graphs derived from 24 completed construction-project schedules across six test groups with different network scales. ARM achieved approximately 78% accuracy in the smaller test group, where recurrent sequencing relations were more evident. In the larger test groups, DeepWalk achieved approximately 75% accuracy, indicating stronger generalization as graph size and structural diversity increased, whereas the GNN baselines showed lower and less stable results. In the practical evaluation of Project P9, ARM achieved 77% accuracy, generated a sequence containing 46 activities and flagged 13 activities for manual review. The findings demonstrate that framing construction activity sequencing as a recommendation-oriented link-prediction problem enables scalable and data-efficient generation of editable, project-specific draft schedules while preserving planner oversight under sparse construction graph conditions.}
}
@article{CHEN2026115840,
title = {A scene-aware soft multimodal transformer with controllable alignment for interactive narrative generation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115840},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115840},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012883},
author = {Siyu Chen and Xinjin Ge and Manzhou Li and Yan Li and Yan Zhang},
keywords = {Soft computing, Multimodal learning, Scene-aware modeling, Controllable generation, Uncertainty-aware fusion},
abstract = {Interactive narrative systems for film and television require robust modeling of heterogeneous audiovisual and textual signals to support coherent, emotionally consistent, and real-time user interaction. However, existing approaches often rely on text-centric generation or shallow multimodal fusion, which limits their ability to capture scene-level semantics, narrative rhythm, and affective cues inherent in cinematic content. To address these challenges, this paper proposes a Scene-Aware Multimodal Transformer (SAMT) for controllable interactive narrative generation. The proposed framework adopts an end-to-end soft computing paradigm and integrates three key components: (1) a cross-modal alignment module based on contrastive learning to mitigate distributional discrepancies among video, audio, and text modalities; (2) a scene-aware fusion module with hierarchical cross-modal attention to model spatiotemporal dependencies and contextual audiovisual semantics; and (3) a contextual generation module that introduces explicit emotion and rhythm constraints to regulate narrative tone and pacing. In addition, a multimodal interactive film-fragment dataset is constructed to support systematic evaluation. Extensive experiments demonstrate that SAMT consistently outperforms representative multimodal baselines and large-scale multimodal language models in terms of text generation quality, multimodal consistency, scene coherence, and user engagement, while maintaining low inference latency suitable for real-time interaction. These results indicate that soft alignment, scene-aware fusion, and controllable generation are critical for effective multimodal narrative modeling in complex interactive systems.}
}
@article{TURZA2026115901,
title = {Machine learning in ant biology research: A systematic review},
journal = {Applied Soft Computing},
volume = {202},
pages = {115901},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115901},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013499},
author = {Filip Turza and Wojciech Książek},
keywords = {Ants, Datasets, AI, Artificial intelligence, Deep learning, Neural networks, Machine learning},
abstract = {Machine learning (ML) has become a powerful tool across diverse scientific disciplines, enabling advanced interdisciplinary research. In ant studies, ML helps overcome challenges posed by high species richness, complex colony structures, labor-intensive behavioral observations, and the limited availability of taxonomic expertise. Moreover, ant biology research generates large and often publicly accessible datasets (e.g., AntWeb, GABI), including high-resolution images, videos, georeferenced records, and detailed descriptive data, which create significant opportunities for computational analysis. In recent years, ML techniques have been increasingly applied to automate species identification, track individuals and colonies, detect nests, analyze behavior, and predict global species distributions. Yet, despite the growing number of empirical applications, a systematic synthesis of the advancements achieved in this field remains lacking. This study addresses this gap by providing, for the first time, a comprehensive overview of current approaches, highlighting key methodological trends and offering guidance for future research. Importantly, we emphasize the need for stronger interdisciplinary collaboration between biologists and computer scientists to fully harness the potential of ML in advancing ant research and related biological disciplines.}
}
@article{ZHAO2026115816,
title = {Dynamic multi-drone parcel delivery via cooperative multi-objective particle swarm optimization},
journal = {Applied Soft Computing},
volume = {202},
pages = {115816},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115816},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012640},
author = {Xinyi Zhao and Puxi Liu and Long Ma and Bailing Tian},
keywords = {Urban air logistics, Multi-drone task allocation, Multi-objective optimization, Particle swarm optimization},
abstract = {Urban air logistics (UAL) requires multi-drone task allocation methods that can simultaneously handle conflicting objectives and complex constraints. To address this challenge, this paper formulates the cooperative pickup and delivery service problem with multiple drones (CPDS-MD), where total travel distance, delivery delay, and drone-deployment cost are jointly optimized under practical constraints. To solve this problem, an adaptive fitness evaluation strategy (AFES)-guided cooperative multi-objective particle swarm optimization (MOPSO) algorithm is proposed, which contains a unified fitness function to better coordinate convergence and diversity. On this basis, a team-based cooperative framework is further developed by integrating team formation, leader selection and role-specific velocity updates, thereby improving convergence-diversity coordination, strengthening exploration robustness, and accelerating convergence in dynamically constrained search spaces. Experiments demonstrate that the proposed approach achieves faster convergence and better diversity in dynamic multi-drone task allocation in UAL.}
}
@article{LIU2026115877,
title = {Multi-objective evolutionary automatic deepening method with pruning for quality defect detection in steel materials},
journal = {Applied Soft Computing},
volume = {202},
pages = {115877},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115877},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013256},
author = {Chang Liu and Zherui Tao and Baide Chen},
keywords = {Automatic deepening method, Pruning strategy, Multi-objective evolutionary, Steel materials, Quality defect detection},
abstract = {The quality reliability of the steel manufacturing industry relies on efficient defect detection methods. However, existing high-precision detection methods are often constrained by complex deep learning models, and their deployment in real-world industrial scenarios is frequently hampered by limited computing resources. To address this challenge, this paper proposes a multi-objective evolutionary learning framework that integrates automatic architecture deepening with pruning strategies to significantly reduce computational complexity while preserving model performance. Residual networks are adopted due to their strong representation capability and their effectiveness in alleviating the vanishing gradient problem through skip connections. This design lays a solid foundation for dynamic model deepening and flexible pruning, enabling the network to effectively avoid gradient vanishing during automatic growth while reserving sufficient space for subsequent operations. To achieve an optimal trade-off between model accuracy and complexity, this paper employs a multi-objective differential evolution algorithm to guide the pruning process. The effectiveness of the proposed method is validated on real-world production data for steel surface defect detection. Moreover, cross-domain experimental results demonstrate that the model exhibits superior generalization performance compared to existing state-of-the-art models.}
}
@article{LEE2026115853,
title = {Chance-corrected utility-weighted metrics for binary classification and information retrieval: A conceptual and analytical framework},
journal = {Applied Soft Computing},
volume = {202},
pages = {115853},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115853},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013013},
author = {Wen-Chung Lee},
keywords = {Utility theory, Sensitivity, Specificity, Precision, Recall},
abstract = {Standard confusion-matrix metrics (e.g., AUROC, Youden’s index, F1, Jaccard) often do not explicitly account for class imbalance, asymmetric utilities, or performance relative to a no-information baseline. These limitations can obscure the utility structure relevant to model choice. We propose a unified utility-weighted evaluation framework for binary classification and information retrieval, together with a kappa-like chance correction. For classification, we define the utility-weighted accuracy rate (UWAR) by normalizing expected utility to the perfect-model utility, yielding a weighted average of sensitivity and specificity controlled by a single utility-weighting parameter that combines positive-class prevalence with the relative benefit of a true positive compared with a true negative. We then introduce the chance-corrected UWAR (ccUWAR) to quantify utility-weighted performance above the no-information baseline, with interpretable special cases that connect to familiar indices such as AUROC and Youden’s index. For information retrieval, we develop parallel measures in the positivity-conditioned space: the conditional utility-weighted accuracy rate (CUWAR) and its chance-corrected version (ccCUWAR), parameterized by the relative cost of missed relevant items versus retrieved non-relevant items and the prevalence of relevant items; CUWAR reduces to the Jaccard index and is directly related to the F1 score when these error costs are equal. We further derive better-than-chance regions, indifference points, and regions of dominance. Through controlled analytical examples, we illustrate that rankings that appear fixed under symmetric metrics can reverse once utility structure and chance correction are made explicit. The framework is intended as a conceptual and analytical tool for utility-aligned evaluation rather than as a universal replacement for existing metrics.}
}
@article{AUNSRI2026115808,
title = {A hybridization of particle filter and firefly algorithm for modal frequency and dispersion curve estimation in ocean acoustics},
journal = {Applied Soft Computing},
volume = {202},
pages = {115808},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115808},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012561},
author = {Nattapol Aunsri and Sai Laung Kham},
keywords = {Firefly algorithm, Particle filter, Particle diversity, Frequency estimation, Spectrogram, Signal processing},
abstract = {Particle filters (PFs) have been extensively utilized to estimate time-varying state variables. Integrating the firefly algorithm (FA) into PFs enhances the accuracy of estimation by attracting dimmer fireflies toward brighter ones. This mechanism guides low-weight particles toward regions of high likelihood. In this work, we propose a new firefly particle filter (FFPF) to improve the efficiency of estimating the modal frequencies and dispersion curves of the ocean acoustic signal. The FA mechanism not only suppresses poor quality particles, but also propagates high-quality particles to subsequent generations, increasing the probability of discovering additional high quality estimates. Finally, Monte Carlo root mean squared error (MCRMSE) evaluation shows that the proposed FFPF achieves average RMSE and MAE values of 2.3897 and 1.2168, respectively, outperforming conventional PFs while maintaining real-time computation with an average runtime of 0.0048s per iteration. In ocean acoustic signal tracking experiments, the proposed method consistently attains the lowest MCRMSE across SNR levels from −5 to 15 dB, with values of 17.49 12.82, 10.42, 5.11, and 1.73, respectively, offering the superiority over the state-of-the-art methods including SIRPF, APF and GORPF.}
}
@article{SINGH2026115869,
title = {Probabilistic computing forecasting approach for EV charging load forecasting using meta-learning enhanced informer},
journal = {Applied Soft Computing},
volume = {202},
pages = {115869},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115869},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013177},
author = {Arpana Singh and Uma Nangia and M. Rizwan},
keywords = {Electric vehicle, Electric vehicle charging station, Informer, Transformer, Probabilistic computing, Model agnostic meta-learning},
abstract = {The growing prevalence of electric vehicles has led to variable and spatially diverse charging demand, generating challenges for grid planning, particularly when historical data are limited. These variations increase operational uncertainty overload conditions, congestion, and inefficient energy scheduling. To address this challenge, this research proposes Model Agnostic Meta-Learning (MAML)-Informer model that uses meta-learning to improve data utilisation and quickly adapt to changing charging patterns. Initially, the model first learns the common charging demand patterns across different clusters. An enhanced Informer model then utilises these patterns to identify long-term trends and create multi-step demand forecasts, providing the grid operation with accurate and uncertainty-aware forecasting. Experiments conducted on three real-world electric vehicle charging datasets show that the proposed approach outperforms existing baselines, achieving up to 51.21% lower quantile root mean square error and 12.53% higher prediction-interval coverage. The results demonstrate its ability to deliver reliable forecasts under limited and changing data conditions. Additionally, computational and ablation analyses are conducted, demonstrating modest training overhead, near–real-time inference capability, and stable performance under varying adaptation settings, reinforcing practical deployment of charging stations using the proposed framework.}
}
@article{GOSWAMI2026115861,
title = {DoRA+: Enhancing weight-decomposed low-rank adaptation for hospital discharge paper summarization},
journal = {Applied Soft Computing},
volume = {202},
pages = {115861},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115861},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013098},
author = {Joyeeta Goswami and Kaushal Kumar Prajapati and Ashim Saha and Apu Kumar Saha},
keywords = {Large language model (LLM), LoRA (Low rank Adaptation), DoRA (Weight-Decomposed Low Rank Adaptation), Parameter efficient fine-tuning (PEFT), Hospital discharge summary (HDS)},
abstract = {Parameter efficient fine-tuning (PEFT) methods are essential for adapting large language models (LLMs) for specific tasks with a reduced computational cost. One of the most widely used PEFT methods for domain specific tasks is Low Rank Adaptation or LoRA, in short. LoRA+ improves the performance and fine-tuning speed of LoRA, by using the different learning rates for the adapter matrices. On the other hand, DoRA (Weight-Decomposed Low Rank Adaptation) finetuning decomposes the pre-training weight into two components to enhance learning stability. However, current methods often force trade-offs between performance, efficiency, and stability. This research proposes DoRA+, an enhanced hybrid fine-tuning method that combines the strengths of both LoRA+ and DoRA by implementing optimized and different learning rates. The proposed DoRA+ disaggregates the pre-trained weights of the LLM into two parts, viz. magnitude and direction, and applies LoRA+ fine-tuning to fine-tune both the components for optimization. This decomposition empirically improves the learning capacity of the model within the evaluated summarization tasks, while maintaining parameter efficiency and minimizing the computational cost. Moreover, this work addresses the limitation of LoRA's usage of a learning rate (η) in the 0–1 range. Using a η value greater than 1 improves model performance. The proposed DoRA+ fine-tuning is applied to summarize the hospital discharge summary (HDS) papers and found that DoRA+ accurately generates brief but compact summaries for lay people, draws out concentrated themes, making HDS more patient-friendly. By effectively extracting key information from complex medical documents, DoRA+ showcases its potential to significantly improve the readability and utility of specialized texts, offering a more powerful and efficient pathway for adapting LLMs to high-impact domains.}
}
@article{BENALAIA2026115844,
title = {Forecasting financial markets with tempered memory: An optimized fractional autoregressive approach},
journal = {Applied Soft Computing},
volume = {202},
pages = {115844},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115844},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012925},
author = {Essia {Ben Alaia} and Slim Dhahri and Omar Naifar},
keywords = {Tempered fractional calculus, Financial forecasting, Time series analysis, Gradient descent optimization, Risk management, Trading strategies, Memory effects, Parameter estimation},
abstract = {Financial return forecasting is difficult because market series are noisy, nonstationary, heavy-tailed, and often influenced by memory effects that standard short-memory models do not capture well. This paper proposes a Tempered Fractional Autoregressive Moving Average (TF-ARMA) framework for interpretable financial forecasting. The model combines discrete fractional-memory kernels with exponential tempering, so that short- and medium-lag dependence is retained while remote-lag effects are damped to a finite effective horizon. Parameters are estimated with a truncated-memory Tempered Fractional Gradient Descent (TFGD) algorithm that is aligned with the theoretical formulation and feasible for repeated walk-forward estimation. Theoretical analysis establishes absolute summability, bounded effective memory, and second-order well-posedness under finite-moment assumptions suitable for financial returns. Empirically, we evaluate SPY and BTC-USD daily log-returns using a strict expanding-window walk-forward protocol and compare TF-ARMA + TFGD with ARIMA, AR(1)-GARCH(1,1), LSTM, and GRU baselines. The results show that TF-ARMA + TFGD is competitive across datasets and achieves a statistically significant block-level forecast-loss improvement over ARIMA on SPY, while BTC results are more regime-dependent and do not show statistically significant pairwise superiority at the 5% level. Additional sensitivity, reproducibility, and trading-diagnostic analyses clarify where the method is useful and where caution is required. Overall, the proposed framework contributes a compact and interpretable tempered-memory model that balances fractional dependence modeling with practical forecasting and risk-analysis requirements.}
}
@article{WANG2026115836,
title = {Action-attentive deep reinforcement learning for autonomous alignment of beamlines},
journal = {Applied Soft Computing},
volume = {202},
pages = {115836},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115836},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012846},
author = {Siyu Wang and Shengran Dai and Jianhui Jiang and Shuang Wu and Yufei Peng and Junbin Zhang},
keywords = {Deep reinforcement learning, Autonomous alignment of beamlines},
abstract = {Synchrotron radiation sources play a crucial role in fields such as materials science, biology, and chemistry. The beamline, a key subsystem of the synchrotron, modulates and directs the radiation to the sample for analysis. However, the alignment of beamlines is a complex and time-consuming process, primarily carried out manually by experienced engineers. Even minor misalignments in optical components can significantly affect the beam’s properties, leading to suboptimal experimental outcomes. Current automated methods, such as Bayesian optimization (BO) and reinforcement learning (RL), although they enhance performance, have limitations. The relationship between the current and target beam properties, crucial for determining the adjustment, is not fully considered. Additionally, the physical characteristics of optical elements are overlooked, such as the need to adjust specific devices to control the output beam’s spot size or position. This paper addresses the alignment of beamlines by modeling it as a Markov Decision Process (MDP) and training an intelligent agent using RL. The agent calculates adjustment values based on the current and target beam states, executes actions, and iterates until optimal parameters are achieved. A policy network with action attention is designed to improve decision-making by considering both state differences and the impact of optical components. Experiments on two simulated beamlines demonstrate that our algorithm outperforms existing methods, with ablation studies highlighting the effectiveness of the action attention-based policy network.}
}
@article{WANG2026115873,
title = {Adaptive multimodal diffusion model for mural inpainting with language-driven semantic priors and structural guidance},
journal = {Applied Soft Computing},
volume = {202},
pages = {115873},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115873},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013219},
author = {Yuning Wang and Pengbo Zhou and Wei Liang and Lipeng Yan and Guohua Geng and Shunli Zhang},
keywords = {Image inpainting, Diffusion model, Semantic priors},
abstract = {Digital inpainting offers an efficient and non-invasive solution for mural restoration. Despite recent progress, existing mural inpainting methods still suffer from semantic inconsistency, style discontinuity, and blurred texture reconstruction. To address these challenges, we propose an adaptive multimodal diffusion framework that synergistically integrates high-level semantic knowledge with structural priors to guide the restoration process. Specifically, we design an inpainting-oriented structured prompt strategy that exploits the strong reasoning capability of a multimodal large language model (MLLM) to generate fine-grained high-level semantic descriptions. Concurrently, a masked autoencoder is utilized to reconstruct the global structural layout, providing the spatial geometry that textual descriptions lack. We introduce a Bidirectional Cross-modal Interaction Module (BCIM) that performs bidirectional cross-attention between textual and visual features to produce complementary multimodal representations. To effectively inject multimodal priors into the diffusion model, we further design an Adaptive Multimodal Prior Selection and Injection Module (AMPSIM) that selects informative cues while suppressing low-frequency interference. We further construct CNMural-MM, a diverse multimodal mural dataset tailored for inpainting. Extensive experiments on CNMural-MM and several public benchmarks demonstrate that our method achieves state-of-the-art performance and exhibits strong generalization ability.}
}
@article{TANG2026115807,
title = {Dual-branch soft-activation switch distillation network for efficient image super-resolution},
journal = {Applied Soft Computing},
volume = {202},
pages = {115807},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115807},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601255X},
author = {Yinggan Tang and Xinming Cai and Jing Chen},
keywords = {Image super-resolution, Lightweight vision model, Feature distillation, Dual-branch feature extraction, Frequency-aware feature modulation},
abstract = {Efficient image super-resolution (SR) aims to achieve a favorable trade-off between reconstruction performance and computational cost, which is crucial for deployment on resource-constrained devices. However, existing lightweight SR methods often fail to fully exploit informative channel-wise features and lack effective modeling of interactions between low-frequency and high-frequency components, resulting in over-smoothed regions and insufficient recovery of fine details. To address these issues, we propose a lightweight Dual-Branch Soft-Activation Switch Distillation Network (DBSDN). The proposed method enhances feature representation by jointly improving channel-wise feature selection and modeling cross-frequency interactions through a heterogeneous dual-branch design. Specifically, a Depthwise Soft-Switchable Convolution (DSSConv) is introduced to adaptively emphasize informative features via a learnable gating mechanism, while a Heterogeneous Dual-Branch Feature Extraction Block (HDFEB) enables interactive refinement between low-frequency and high-frequency features. Extensive experiments demonstrate that DBSDN achieves superior performance among state-of-the-art lightweight SR models. With only 652K parameters, DBSDN outperforms competitive methods, including VapSR and BSRN, by 0.13–0.43 dB in PSNR for the ×4 super-resolution task, with consistent improvements on challenging datasets such as Urban100 and Manga109. These results indicate that coordinated channel-wise feature selection and cross-frequency interaction are critical for efficient SR. The proposed DBSDN therefore provides an effective and practical solution for achieving a better balance between model complexity and reconstruction quality.}
}
@article{ZHAO2026115820,
title = {Bee-YOLO: Enhancing small and dense object detection via Bee-eye inspired mechanisms},
journal = {Applied Soft Computing},
volume = {202},
pages = {115820},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115820},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012688},
author = {Qing Zhao and Yi Zhang and Xurui Xie and Jiawei Huang and Yu Zhang and Ming Fang and Zhen Zhang},
keywords = {Bee-YOLO, Small and dense target detection, Feature enhancement, Dual-branch structure, YOLO11},
abstract = {Aiming at the core issues in complex scenarios, such as feature loss in small object detection, feature overlap and confusion in dense object detection, and the difficulty in balancing accuracy and lightweight efficiency in existing solutions, this paper proposes an improved method inspired by the bee visual mechanism—Bee-YOLO. Built upon the YOLO11 framework, the algorithm enhances detection performance via two core improvements: first, the innovative Bee-eye Dual-branch Enhancement Module (BDEM), which draws on the dual-functional differentiation of bee compound eyes to construct a dual-branch structure, integrating gated fusion and attention mechanisms to alleviate small object feature loss and dense object feature overlap; second, detection head reconstruction, which removes redundant branches and adds a dedicated detection head for shallow-level features. Using high-resolution features and upsampling, this reconstruction mitigates low localization accuracy for small objects while streamlining computation to balance accuracy and efficiency. Experimental results show that on the VisDrone and COCO datasets, the mAP@50 of the proposed method is increased by 3.7% and 2.5% respectively compared with the baseline YOLO11, verifying the effectiveness of the proposed improvements. This study provides a feasible solution for small and dense target detection in complex scenarios and shows potential application value in intelligent surveillance, autonomous driving and other fields.}
}
@article{ZHANG2026115848,
title = {GBFTTA: A granular-ball-based football team training algorithm for real-world engineering optimization problems},
journal = {Applied Soft Computing},
volume = {202},
pages = {115848},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115848},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012962},
author = {Yong Zhang and Caihui Liu and Zeqiang Xian},
keywords = {Football team training algorithms, Lévy flights, Granular-ball, Elite mutation, Real-world engineering problems},
abstract = {Metaheuristic algorithms play an important role in solving real-world optimization problems, and developing metaheuristic algorithms that are efficient, accurate, and robust has become an important goal in optimization research. Although the football team training algorithm (FTTA), as a newly proposed training-driven optimization method, has demonstrated strong competitiveness, its studying and communication stages employ fixed parameters, and its population partitioning process incurs high computational costs, which make the algorithm quickly fall into local optima, result in slow convergence, and limit its scalability. To address these problems, this paper proposes a granular-ball-based football team training algorithm (GBFTTA), which introduces a granular-ball clustering mechanism and dynamic update strategies (Lévy flight, a parameter dynamic update mechanism, and elite mutation) to adaptively maintain population diversity and accelerate convergence. Unlike existing variants that rely on static operators, GBFTTA adopts a co-evolutionary update process in which mutation and clustering work collaboratively to prevent premature convergence and reduce redundant fitness evaluations. The effectiveness of GBFTTA has been validated on the CEC2005 and CEC2019 benchmark suites, including 13 benchmark functions under multiple dimensional settings (dim = 30, 100, and 500). In addition, GBFTTA is also applied to solve four real-world engineering design problems. Experimental results and three statistical tests show that the proposed GBFTTA performs competitively with the other 11 state-of-the-art algorithms, including FTTA.}
}
@article{JEON2026115909,
title = {Forecasting multi-sectoral technology convergence and manifestation through feasibility prediction via multiplex network, association rule mining, and machine learning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115909},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115909},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013578},
author = {Eunji Jeon and Seoyeon Lee and So Young Sohn},
keywords = {Multi-technology convergence, Convergence prediction, Convergence feasibility, Multiplex network embedding, Association rule mining},
abstract = {Opportunities for unexplored advancements across technological fields highlight the growing importance of cross-sectoral convergence. Although each technological field follows a unique development trajectory, existing studies on multi-sectoral technological convergence often overlook these distinct patterns against the characteristics shared across fields. Moreover, current methodologies offer only vague insights into the practical realization of predicted convergence, disregarding its varying feasibility under different technological fields. To address these gaps, we propose a novel framework that predicts technological convergence via link prediction on a multiplex network and assesses its feasibility via association rule mining and tree-based regression. The multiplex network is constructed with layers corresponding to different technological fields. The nodes represent entire International Patent Classification (IPC) codes across fields, whereas the edges denote their co-occurrence in the corresponding field. The tree-based feasibility prediction model was trained using association rules derived from the sets of IPC codes across fields. Feasibility is calculated using the support and lift metrics of the rules. The proposed framework was applied to predicting feasible educational convergences with the metaverse and assistive technologies using patents granted by the United States Patent and Trademark Office. The link prediction model achieved a receiver operating characteristic area under the curve of 0.896, outperforming single-layer network-based methods. The feasibility assessment model yielded a mean squared error of 0.0001, 14.8% lower than that of the second-best method. The framework estimates the feasibility of predicted convergence with mature technologies under each field, offering stakeholders actionable insights for multi-sectoral convergence.}
}