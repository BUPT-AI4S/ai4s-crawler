@article{GE2026115445,
title = {Multi-stage cost-efficient multi-label active learning},
journal = {Applied Soft Computing},
volume = {201},
pages = {115445},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115445},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008938},
author = {Yaling Ge and Yunpeng Ma and Guoliang Su and Yujia Ye and Chuan Liu and Jun Zhou},
keywords = {Multi-label active learning, Semi-supervised learning, Multi-stage example annotation, Structural hierarchy information},
abstract = {Due to the structured hierarchical information of multi-label examples, multi-label active learning is challenging to evaluate the value of manually annotated examples and make comprehensive cost-effective decisions. However, because of this extensive structural hierarchy information, the label vector of a single multi-label example can be described by all of its subexample labels, making the multi-label active learning strategy flexible. Herein, a multi-stage cost-effective multi-label active learning (MCMAL) strategy is designed based on the structural characteristics of multi-label examples. It aims to minimize the cost of annotation of multi-label datasets by developing a novel multi-label active learning strategy, MCMAL. In this study, we propose for the first time to design a multi-stage active learning strategy that uses automatically labeled minimum-valued example-label pairs (subexample-label pairs) and label entropy to effectively reduce labeling costs. MCMAL first selects the most valuable example-label pairs based on uncertainty before annotating them in each iteration. During the manual annotation phase, domain experts select the most valuable subexample-label pairs, which are more likely to be labeled as positive. Meanwhile, the algorithm annotates the least valuable example-label pairs automatically. Then, to mitigate the negative effects of automatic annotation, the label entropy of labeled examples in each iteration is used to select the most valuable example-label pairs for manual reannotation. An experimental study involving four widely used multi-label datasets from various fields demonstrates that MCMAL effectively uses the structural hierarchy information of multi-label examples to refine the annotation cost of the examples to the subexample level. The empirical results demonstrate that MCMAL can make cost-effective decisions, significantly reducing the annotation cost of multi-label examples.}
}
@article{ACIKGOZ2026115494,
title = {PVEL-ViT: Adaptive token selective vision transformer for photovoltaic cell defect classification in electroluminescence imaging},
journal = {Applied Soft Computing},
volume = {201},
pages = {115494},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115494},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009427},
author = {Hakan Acikgoz and Deniz Korkmaz and Cafer Bal and Resul Coteli and Besir Dandil},
keywords = {Photovoltaic systems, Defect classification, Vision transformer, Attention module, Deep learning},
abstract = {The rapid expansion of photovoltaic (PV) technology has increased the need for reliable and automated defect detection to ensure the long-term efficiency and durability of PV modules. Electroluminescence (EL) imaging provides detailed visualization of internal defects and is a key modality for data-driven classification systems. This study proposes a vision transformer (ViT)-based framework, named PVEL-ViT, for accurate classification of PV cell defects from EL images. The architecture is constructed on a MetaFormer-based backbone and integrates an embedded multi-scale feature fusion module with an adaptive token selective attention mechanism. The designed PVEL-ViT captures fine-grained local defect patterns and global context while dynamically emphasizing defect-relevant tokens and suppressing redundant background information, thereby improving discriminative feature learning and robustness. The proposed framework is evaluated on an EL imaging dataset and compared against recent convolutional and transformer-based models. Experiments show that EfficientNetV2-m and EfficientViT-b2 achieve accuracy rates of 0.9386 and 0.9359, respectively, whereas PVEL-ViT attains a higher accuracy of 0.9584, corresponding to accuracy gains of 2.11% and 2.40% over these models. The obtained results indicate that PVEL-ViT provides a robust and scalable defect classification performance on EL imagery, enhancing the reliability of automated PV inspection pipelines and supporting monitoring in PV modules.}
}
@article{ROJASMORALES2026115549,
title = {Understanding Ant Colony Optimization search through Local Optima Networks},
journal = {Applied Soft Computing},
volume = {201},
pages = {115549},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115549},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600997X},
author = {Nicolás Rojas-Morales and Elizabeth Montero and Leslie Pérez and Gabriela Ochoa and María Cristina Riff},
keywords = {Fitness landscape analysis, Ant Colony Optimization, Local Optima Networks},
abstract = {The behavior of Ant Colony Optimization (ACO) algorithms is based on a collective learning process defined by a pheromone mechanism. This process is difficult to understand due to the scheduling of pheromone deposition and evaporation, the influence of parameter values, the bias in solution construction, and the problem instance size. This work aims to extend Local Optima Networks (LONs) to understand the path traversed by the pheromone learning mechanism in the fitness landscape described by ACO algorithms. Our ant-based LONs incorporate a definition of network edges that expresses the persistence of the pheromone influence in the search process. Also, we study a simplified network, Deposit LON, that contains only nodes that deposit pheromones. We aim to analyze a population-based search algorithm’s exploitation and exploration behavior through its network features. We evaluate our proposal on a MAX−MIN Ant System algorithm coupled with a Lin-Kernighan local search for solving the Traveling Salesman Problem. The comparative analysis of the networks reflects the exploration/exploitation balance of the algorithms, indicating the exploratory behavior of the MAX−MIN Ant System. We study networks generated under different pheromone influence persistence levels and conclude that this setting does not significantly affect the overall network structure. To complement our analysis, we present plots of the generated networks, a detailed report of their metrics, and a comparison with other algorithms’s LONs. Our work contributes to providing a tool for analyzing ant-based algorithms’ search performance using LONs.}
}
@article{ZAHMATKESHAN2026115502,
title = {Flexural optimization in repair of notched 3D-printed PLA with variable PLA patches: A Support Vector Regression and Bayesian Optimization approach for circular economy applications},
journal = {Applied Soft Computing},
volume = {201},
pages = {115502},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115502},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009506},
author = {Mohammad Hadi Zahmatkeshan and Farid Reza Biglari and Bijan {Mollaei Dariani}},
keywords = {Soft computing, Support Vector Regression, Bayesian Optimization, Uncertainty quantification, Circular economy, Fused deposition modeling, PLA repair, Life cycle assessment, Sustainable manufacturing},
abstract = {Optimizing repair processes for additively manufactured components requires navigating complex trade offs between mechanical performance, environmental impact, and experimental cost a challenge ill-suited to traditional Design of Experiments (DOE) approaches that demand exhaustive testing. This study introduces a hybrid Support Vector Regression–Bayesian Optimization (SVR-BO) framework for uncertainty-aware analysis of Fused Deposition Modeling (FDM) repair processes, demonstrating its application to flexural restoration of notched Polylactic Acid (PLA) specimens within a Circular Economy context. The core innovation lies in integrating three synergistic soft computing capabilities: (1) SVR's robustness for modeling nonlinear mechanical responses from limited experimental data with an RBF kernel; (2) Bayesian Optimization's probabilistic exploration of design spaces via Gaussian process surrogates; and (3) uncertainty quantification through 95% credible intervals, enabling reliable predictions critical for sustainable decision-making. Experimental validation across 36 specimens (varying body raster angles: 0°, 45°, ±45°, 90°; patch raster angles: 0°, 45°) demonstrated substantial mechanical improvements, including a 37% increase in maximum flexural stress (88.5 ± 3.2 MPa) and a 46% enhancement in energy absorption (127.9 ± 4.1 MPa·%). The SVR model achieved an RMSE of 1.96 MPa (R² = 0.98) for stress prediction, validated through 5-fold cross-validation and bootstrapping analysis. Retrospective convergence analysis confirmed that the Bayesian Optimization framework identifies optimal configurations (0° body/0° patch, 98.6 MPa predicted stress) within approximately 20 iterations, demonstrating potential efficiency gains of approximately 40% reduction in experimental trials compared to exhaustive grid searches in prospective applications. Finite element simulations in ABAQUS showed approximately 10% deviation from experimental values, providing satisfactory baseline validation. Life Cycle Assessment indicates significant circular economy benefits, with 77% material waste reduction and 62% energy savings per repaired component. This work establishes SVR-BO as a transferable soft computing framework for sustainable manufacturing optimization, with the retrospective analysis providing a validated foundation for prospective experimental design in future repair qualification workflows.}
}
@article{KUMAR2026115526,
title = {Q-learning-driven real coded genetic algorithm for dynamic dose optimization in radiotherapy},
journal = {Applied Soft Computing},
volume = {201},
pages = {115526},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115526},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009749},
author = {Yogesh Kumar and Kusum Deep},
keywords = {Real coded genetic algorithm, Reinforcement learning, Q-learning, Dose optimization, Tumor conformity},
abstract = {Optimizing dose distribution in radiotherapy to achieve maximum coverage of tumors while minimizing exposure to surrounding healthy tissues remains a significant challenge in both academia and medical industry. This paper introduces a mathematical model based on a relaxed circle packing problem to minimize dose of radiation while maximizing coverage of the target area. The proposed solution integrates a Real Coded Genetic Algorithm (RCGA) driven by Q-learning, which adaptively controls the crossover rate and mutation rate based on the fitness landscape and solution quality. This dynamic adjustment helps balance exploration and exploitation during optimization, improving convergence. Q-learning also regulates the number of radiation shots to minimize redundant dose exposure while maintaining tumor coverage. The proposed methodology, Q-Learning-Driven Real Coded Genetic Algorithm (QLRCGA), is compared with state-of-the-art algorithms such as RCGA, classical Particle Swarm Optimization (PSO), classical Differential Evolution (DE), Adaptive Differential Evolution with Optional External Archive (JADE), and Adaptive Particle Swarm Optimization (APSO). The experimental results demonstrate the effectiveness of the proposed QLRCGA, which achieves 92.13% tumor coverage and a 34% improvement in overall fitness compared to the classical RCGA. It also outperforms PSO, DE, JADE and APSO in terms of dose homogeneity and conformity, highlighting its superior performance in radiotherapy dose optimization. This study highlights the advantages of integrating reinforcement learning into RCGA for radiotherapy dose planning, underscoring its potential as a robust and adaptable solution for personalized cancer treatment. Additionally, the approach was validated on two actual clinical datasets from the AAPM RT Plan Challenge, where QLRCGA performed better than clinical RTDOSE plans. In terms of dose homogeneity and conformity, QLRCGA produces superior dosimetric results compared to the clinical treatment plans, demonstrating it as a significant and promising approach to personalized cancer therapy.}
}
@article{CAI2026115530,
title = {Multi-objective evolutionary algorithm based on reinforcement learning for flexible job shop scheduling with limited transportation resources},
journal = {Applied Soft Computing},
volume = {201},
pages = {115530},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115530},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009786},
author = {Yihao Cai and Guohui Zhang and Nana Yu and Wenqiang Zhang and Zhengfeng Li},
keywords = {Limited transportation resources, Flexible job shop scheduling problem, Neighborhood structure, Reinforcement learning, Energy-conscious},
abstract = {Integrating intelligent transport equipment with multi-variety small-batch manufacturing has significantly increased production-scheduling complexity. The efficient coordination between intelligent transport equipment and machines is a growing challenge in practical production. This study addresses the flexible job shop scheduling problem with limited transportation resources (FJSP‑LT), aiming to minimize makespan, energy consumption, and total earliness/tardiness penalties. First, a mathematical model is formulated using mixed‑integer linear programming. Subsequently, a reinforcement learning-based evolutionary algorithm is proposed to solve this model. The proposed algorithm implements four initialization strategies specifically devised to yield a high-quality initial population. Concurrently, it incorporates a self-adaptive strategy, relying on reinforcement learning, to enable dynamic parameter tuning throughout the optimization process. The state representation and reward function are designed according to the multi‑objective characteristics of the problem, facilitating comprehensive capture of state information and effectively guiding the algorithm to identify critical actions. Moreover, to prevent the algorithm from being trapped in the local optima, six neighborhood structures based on critical paths are devised, and a tabu search algorithm is incorporated to improve search efficiency. Finally, numerical simulations of 41 benchmark instance variants and a real‑world industrial case are performed. The results confirm the effectiveness of the proposed enhancement strategies. Through comparative analysis with five existing algorithms, the superiority of the proposed approach in solving the FJSP‑LT is demonstrated.}
}
@article{HOANG2026115538,
title = {CL-GAN: Mitigating catastrophic forgetting in generative adversarial networks under continual learning},
journal = {Applied Soft Computing},
volume = {201},
pages = {115538},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115538},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009865},
author = {Ngoc Thanh Hoang},
keywords = {Continual learning, Generative adversarial networks, Catastrophic forgetting, Generative replay, Intrusion detection systems, Non-stationary data},
abstract = {In non-stationary data environments, generative adversarial networks (GANs) suffer from catastrophic forgetting when trained sequentially on evolving data distributions. While GANs are widely used for generative replay in continual learning, their capability as continual learners remains underexplored. This work presents CL-GAN, a continual learning framework that treats GANs as distribution learners and integrates snapshot-based generative replay into adversarial training, enabling incremental learning without storing past data. The framework is evaluated in a non-stationary intrusion detection setting using both generative and downstream IDS metrics, including FID-forgetting, Maximum Mean Discrepancy (MMD), and coverage-based measures (CCS and wCCS). Experimental results show that CL-GAN can mitigate catastrophic forgetting and provide modest improvements over naive continual learning under suitable conditions, particularly on relatively stable datasets, while its effectiveness degrades under more complex and highly non-stationary data. Importantly, low FID or MMD does not necessarily imply effective retention, as distributional coverage may still degrade over time. These findings suggest that forgetting in generative replay is primarily driven by loss of coverage rather than distance-based divergence, and that the effectiveness of replay depends on how well past distributions are approximated. Overall, this work highlights that an important role of GANs in continual learning is to preserve data distributions over time and mitigate forgetting, rather than significantly improve predictive performance, and emphasizes the importance of coverage-aware evaluation in continual generative learning.}
}
@article{TANG2026115433,
title = {State of health estimation of lithium-ion batteries based on multi-stage feature engineering and deep learning fusion},
journal = {Applied Soft Computing},
volume = {201},
pages = {115433},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115433},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008811},
author = {Hongjie Tang and Shuwen Zheng and Kaixuan Zheng and Cong Wang and Yunxia Chen},
keywords = {Lithium-ion batteries, Feature engineering, Variational sparse autoencoder, Extended long short-term memory network, State of health},
abstract = {Accurate estimation of the state of health (SOH) for lithium-ion batteries is a critical technical challenge in the operation and maintenance of battery management systems. To address the limitations of existing data-driven methods, such as feature redundancy, noise sensitivity, and insufficient generalization, this paper proposes a novel SOH estimation approach that integrates multi-stage feature engineering with deep learning. The framework introduces a systematic paradigm for dynamic feature evaluation and noise-resilient feature reconstruction. Multi-source health features are extracted from experimental battery data, incorporating direct measurements, evolutionary trends, and statistical characteristics. A synergistic feature selection process combining maximal information coefficient analysis, null importance ranking, and Shapley additive explanations verification is employed to construct an optimal feature set. To mitigate high-frequency noise interference, an improved complete ensemble empirical mode decomposition with adaptive noise, combined with dual statistical test, is then applied to identify and reconstruct significant modes for feature enhancement. On this basis, a hybrid deep learning model combining a variational sparse autoencoder (VSAE) and an extended long short-term memory network is developed for SOH estimation. Hyperparameter optimization is adaptively performed using the Optuna library, and uncertainty is quantified by leveraging the reparameterization trick of the VSAE. Validation on public battery datasets demonstrates good performance compared to existing methods, with average root mean square error, mean absolute error, mean absolute percentage error all below 1%. Notably, zero-shot cross-dataset evaluations across batteries with heterogeneous chemistry and operating conditions confirm the robust generalization capability.}
}
@article{MA2026115491,
title = {A generalized adaptive robust twin support vector machine framework for pattern classification},
journal = {Applied Soft Computing},
volume = {201},
pages = {115491},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115491},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009397},
author = {Jun Ma and Boya Wang},
keywords = {Robustness, Twin support vector machine, Generalized adaptive robust loss function, Proximal gradient descent method},
abstract = {Traditional twin support vector machines (TWSVMs) often exhibit sensitivity to outliers, limiting their applicability in real-world scenarios with complex noise. This work proposes a generalized adaptive robust twin support vector machine (GARTSVM) framework to address this limitation by introducing a unified superset of robust loss functions. The core innovation of GARTSVM framework is a generalized adaptive robust loss, Lgen(z)=min{α|z|p,β(1−e−θ|z|)}, (α,β≥0,p∈{1,2}), which strategically integrates dual error suppression mechanisms. The polynomial term (α|z|p) ensures precise fitting for inliers, while the exponentially saturated term (β(1−e−θ|z|)) provides robust outlier suppression. Theoretical robustness is achieved through dynamic error weighting, where the ratio α/β→0 facilitates a smooth transition between these two regimes. An analytically derived switching threshold τ, determined by ατp=β(1−e−θτ), governs this mechanism: polynomial precision is applied to residuals below τ, and exponential robustness is activated for larger deviations. The framework is theoretically grounded, featuring bounded gradients and guaranteed proximal convergence for stable optimization, which is efficiently performed via a proximal gradient descent scheme. Experimental results demonstrate that GARTSVM achieves superior performance, with significant accuracy improvements over conventional TWSVMs under high-noise and adversarial conditions, while preserving the inherent advantages of TWSVMs. This study explores the theoretical underpinnings and empirical performance of this new framework, with a focus on its core components: a generalized adaptive robust loss function and an efficient proximal gradient descent optimization. The code of GARTSVM can be publicly available at https://github.com/junma1990-max/GARTSVM-MATLAB-Code.git.}
}
@article{ZENG2026115475,
title = {A constrained multi-objective evolutionary algorithm with deep embedded domain knowledge for AGV scheduling in matrix manufacturing workshops},
journal = {Applied Soft Computing},
volume = {201},
pages = {115475},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115475},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009233},
author = {Junhai Zeng and Wei Xie},
keywords = {AGV scheduling, Multi-objective optimization, Matrix manufacturing workshop, Evolutionary algorithm, Constraint handling},
abstract = {This study addresses the complex challenges of automated guided vehicle (AGV) scheduling in matrix manufacturing workshops, where intricate material flow patterns and multi-AGV coordination hinder the simultaneous optimization of transportation costs, customer satisfaction, and energy consumption. To tackle these issues, this paper proposes a constrained multi-objective evolutionary algorithm with deep embedded domain knowledge (CMOEA-DEDK) to effectively solve scheduling problems characterized by complex constraints, including AGV movement dynamics, multi-compartment capacity limitations, and stringent time windows. The principal innovation of the algorithm resides in three interrelated components that are deeply integrated with domain-specific knowledge. First, a two-stage heuristic population initialization method is proposed, which combines distance-urgency and distance-load heuristics to generate high-quality initial solutions. Second, a multi-modal neighborhood search framework is developed, employing multiple operators with equal probability to achieve a balance between global exploration and local exploitation. Third, a load-balancing-based merging operation is introduced to proactively improve solution feasibility and quality through dynamic customer redistribution. Finally, the proposed method was evaluated on 100 real-world instances and compared with nine well-known algorithms. The experimental results show that CMOEA-DEDK achieves inverted generational distance IGD values from 0.037 to 0.123 and hypervolume HV values from 0.607 to 0.814 across all problem sizes. Compared with the second-best algorithm, the proposed method reduces IGD by 15.8% to 44.0% and improves HV by 6.6% to 16.5%. These results demonstrate the effectiveness of embedding domain knowledge into evolutionary optimization for highly constrained AGV scheduling.}
}
@article{FENG2026115527,
title = {Dual-domain transformer with flexible channel dependence strategy for time series anomaly detection},
journal = {Applied Soft Computing},
volume = {201},
pages = {115527},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115527},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009750},
author = {Quanxi Feng and Rui Zhou and Bin Lin and Gary G. Yen},
keywords = {Deep learning, Time series anomaly detection, Transformer, Self-supervised learning},
abstract = {Multivariate time series anomaly detection (MTSAD) aims to identify anomalous patterns to prevent system failures in real-world applications. However, this task faces two major challenges: first, existing methods often fail to model inter-channel correlations effectively, leading to cross-channel contamination—a phenomenon in which rigid channel interaction mechanisms propagate noise and anomalous signals, thereby degrading overall modeling performance. Second, most methods struggle to capture multi-scale temporal patterns, which hinders the detection of complex anomalies. To address these issues, we propose DDFormer, a Transformer-based model that performs detection across both channel and temporal dimensions. In the channel dimension, DDFormer adaptively fuses time- and frequency-domain information to quantify inter-channel correlations and selectively establishes channel interactions through a masked attention mechanism. This approach effectively leverages inter-channel information while mitigating cross-channel contamination. In the temporal dimension, DDFormer employs a multi-scale patching module and a Global-Local attention mechanism. This enables the model to capture dependencies from the perspectives of both temporal granularity and temporal span, achieving a comprehensive multi-scale representation. Extensive experiments on five publicly available real-world datasets demonstrate that DDFormer achieves an average improvement of 7.12% in F1-score compared to current state-of-the-art (SOTA) models. Furthermore, comprehensive robustness evaluations, including missing variable scenarios and noise injection experiments, verify the model’s exceptional stability under complex real-world conditions. The source code is publicly available at https://github.com/Jerry-a-rookie/DDFormer.}
}
@article{BHAT2026115499,
title = {Semi-supervised Shirorekha segmentation in handwritten Devanagari text using CycleGAN with dual attention},
journal = {Applied Soft Computing},
volume = {201},
pages = {115499},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115499},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009476},
author = {Mohammad Idrees Bhat and Mohammed Javed and Sharada B and Sk Md Obaidullah},
keywords = {Shirorekha Segmentation, Semi-supervised learning, Cycle-consistent generative adversarial networks, Dual attention, Document image analysis, Devanagari script, Noise robustness, Indic scripts},
abstract = {Accurate identification and segmentation of the Shirorekha is a critical pre-processing stage in almost all machine interpretation pipelines for handwritten Devanagari word documents. However, it faces extreme challenges with limited pixel-labeled annotations, diverse writing styles, varying stroke widths, and document distortions. Existing two-stage approaches predominantly rely on hand-engineered features and traditional image processing which limits them to learning only local transformations. Alternatively, once adequately trained deep learning approaches can better generalize to diverse styles, stroke widths, and distortions when sufficient supervision is available. For this reason, we leverage a semi-supervised cycle-consistent generative adversarial network (CycleGAN) framework for Shirorekha segmentation. We further enhance the model with a dual-attention mechanism that captures both spatial and channel information, improving feature representation and localization. This design enables effective learning from limited labeled and abundant unlabeled data. Extensive experiments on a curated multi-dataset (legal amounts, city names, personality identification, and script datasets) demonstrate that the proposed model achieves a mIoU of 0.91 using only 60% of the labeled data, thereby achieving 91% of fully supervised performance. The proposed method outperforms several recent semi-supervised approaches across four datasets by up to 10.7%, achieves 17.7–22.9% improvement over traditional image processing methods, and provides a 13% gain over recent deep learning-based line detectors. Furthermore, the model maintains stable performance under moderate degradations, including Gaussian noise (σ ≤ 0.12) and skew (±15°), while performance degrades under more severe distortions such as strong blur and resolution loss. Code and dataset are available at: https://github.com/idrees11/Semi-Supervised-Shirorekha-Segmentation-CycleGAN-Dual-Attention.git.}
}
@article{ZHANG2026115551,
title = {Credibility-driven sampling for random sample consensus-based outlier removal in visual SLAM},
journal = {Applied Soft Computing},
volume = {201},
pages = {115551},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115551},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009993},
author = {Shaojie Zhang and Yinghui Wang and Jiaxing Ma and Jinlong Yang and Wei Li and Jiaxing Shen},
keywords = {Grid-based motion statistics, Random sample consensus, Feature matching, Oriented FAST and rotated BRIEF-simultaneous localization and mapping},
abstract = {Standard RANSAC scales poorly as its computational cost grows rapidly with scene complexity, and GMS-RANSAC still suffers from redundant iterations without breaking the accuracy-efficiency trade-off. To address this, we propose Improved GMS-RANSAC, a novel credibility-driven outlier removal method that pioneers 3×3 grid neighborhood credibility quantification and halving-based grouping. It defines match credibility via 3×3 grid neighborhood matching counts, sorts matches by credibility, and adopts a halving-based grouping strategy to prioritize high-credibility samples for RANSAC, replacing blind random sampling to optimize RANSAC inlier probability and fundamentally cut redundant iterations. Experiments on KITTI, TUM desk, and TUM doll datasets demonstrate that our method achieves 77.02% precision on TUM desk, maintains accuracy comparable to original GMS-RANSAC on other datasets, and reduces average runtime by 34.20%. Furthermore, integrated into ORB-SLAM2, it reduces system runtime by 4.61%, decreases relative pose error by 11.7% and rotational error by 4.9% while preserving accuracy, providing a lightweight, efficient solution for real-time visual SLAM.}
}
@article{ZHANG2026115577,
title = {Multi-strategy improved partial reinforcement optimization algorithm for UAV path planning},
journal = {Applied Soft Computing},
volume = {201},
pages = {115577},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115577},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010252},
author = {Wei Zhang and Yuanbin Mo},
keywords = {Partial reinforcement optimization algorithm, Path planning, Unmanned aerial vehicle, Multi-strategy},
abstract = {To solve the path planning problem of Unmanned Aerial Vehicle (UAV) in multi-hazardous environments, a Behavioral Training Mechanism Based Partial Reinforcement Optimization Algorithm (BT-PRO) is proposed. In BT-PRO, an elite population strategy is proposed to optimize the initial population distribution and accelerate convergence speed. Then, a Gaussian perturbation-based global stimulation strategy is used during the stimulation phase to direct the learner population towards the optimal solution and augment the exploitation capacity of BT-PRO. Finally, a novel behavioral training mechanism is designed to enhance population communication, balance the exploitation and exploration of BT-PRO, and improve algorithmic search efficiency. After ablation experiments and verification using the CEC2022 benchmark test function, the experimental results indicate that BT-PRO exhibits superior optimization capability and robustness compared to other optimization algorithms. Furthermore, the UAV path planning problem is addressed through the BT-PRO algorithm. Experimental results show that BT-PRO can generate smooth and low-cost paths in both low-dimensional small-scale scenarios and high-dimensional large-scale scenarios. These findings substantiate the effectiveness of BT-PRO in resolving the challenges associated with UAV path planning.}
}
@article{ZHANG2026115483,
title = {A hybrid NSGA-III and Q-learning algorithm for multi-mode and multi-objective resource constrained project scheduling considering two-layered stochastic inputs},
journal = {Applied Soft Computing},
volume = {201},
pages = {115483},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115483},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009312},
author = {Huiping Zhang and Guangyuan Liu and Runqi Li and Bright Liu and Qingguang Huang and Siyong Zhang and Guizhen Liu and Hongtao Zhu and Dun Liu and Sai Ma},
keywords = {MMRCPSP, NSGA-III-Q, Tunnel boring machine schedule, Uncertainty, Equipment idle rate},
abstract = {The Multi-Objective and Multi-Mode Resource-Constrained Project Scheduling Problem (MMRCPSP) is characterized by diversity in objectives and modes, presenting significant challenges to intelligent algorithms. Full consideration of uncertainties during project execution is highly important. In this paper, a framework of MMRCPSP considering uncertain activity durations (UAD) and resource transfer time (RTT) is proposed. The objectives are total expected schedule deviation cost, project makespan, equipment idle rate and total energy consumption, henceforth referred to as cost, makespan, equipment idle rate, and energy, respectively. To solve the above model, an adaptive Non-dominated Sorting Genetic Algorithm III with Q-learning (NSGA-III-Q) is proposed. This algorithm integrates Q-learning, an adaptive reference point generation mechanism, and an adaptive mutation operation. The feasibility and superiority of NSGA-III-Q are validated through comparative experiments conducted with NSGA-II-Q, NSGA-III, MOEA/D, and SPEA2 using PSPLIB database. Results indicate that NSGA-III-Q consistently outperforms the second-best method across the j10, j20, and j30 datasets, achieving notable average reductions in makespan (22.3%, 14.9%, 8.1%), cost (10.0%, 8.4%, 0.4%), and equipment idle rate (8.2%, 9.3%, 11.3%). Additionally, scenarios and sensitivity analyses are provided. The model and algorithm are applied to a tunnel boring project.}
}
@article{GAETA2026115459,
title = {Real-time trust-weighted consensus and auditing of LLMs for secure propaganda detection},
journal = {Applied Soft Computing},
volume = {201},
pages = {115459},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115459},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009075},
author = {Angelo Gaeta and Hossein Hosseinalibeiki and Vincenzo Loia and Francesco Orciuoli},
keywords = {Large language models (LLMs), Trust-weighted consensus, Propaganda detection, Explainable AI (XAI), Reputation modeling, Decentralize propaganda detection},
abstract = {The rapid amplification of digital propaganda through algorithmically mediated platforms poses a serious threat to information integrity and public trust. Although Large Language Models (LLMs) demonstrate strong general reasoning capabilities, their deployment in security-sensitive tasks such as propaganda detection remains constrained by opaque decision-making, stochastic variability, and limited auditability. Existing solutions either rely on single-model pipelines, which create a single point of failure, or static ensemble schemes that lack inference-time governance. To address this gap, we propose POES, a real-time trust-weighted consensus and auditing framework that orchestrates multiple pre-trained LLM agents without task-specific retraining. The architecture integrates dynamic reputation modeling, quorum-based weighted voting, difficulty-aware updates, and rationale-level semantic auditing. A sentinel-based audit layer provides confidence-aware escalation signals for downstream human oversight. The framework is evaluated on the human-annotated HQP (High-Quality Propaganda) dataset (29,596 instances; 15% propaganda prevalence) under imbalanced and training-free conditions. POES achieves a macro-F1 score of 0.558 with statistically significant improvements over individual LLM baselines. Human validation further confirms that audit flags align with independent “needs review" judgments, demonstrating practical triage utility. By formalizing inference-time trust aggregation and exposing structured audit artifacts, POES advances secure and governance-aware LLM ensemble design for high-stakes NLP applications.}
}
@article{LIU2026115511,
title = {STAFormer: Towards unified spatial and temporal aggregation learning for video person re-identification},
journal = {Applied Soft Computing},
volume = {201},
pages = {115511},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115511},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009592},
author = {Xinlong Liu and Hanwen Zhou and Weihong Huang and Guangchao Wang and Yunfeng Ping and Zhangli Lan},
keywords = {Video person re-identification, Spatial-temporal cues, Aggregation learning, Transformer},
abstract = {Spatial and temporal cues are crucial for video-based person re-identification (ReID). However, existing methods often struggle to jointly capture these cues for learning discriminative video-level representations. To address this limitation, we propose STAFormer: a transformer-based framework that establishes a unified architecture for joint frame-level feature extraction and temporal cue aggregation through spatial and temporal aggregation learning. Specifically, the spatial aggregation module extracts frame-level representations by adaptively integrating local and global features through spatial attention, while the temporal aggregation module aggregates these frame-level features into discriminative video-level representations through temporal attention. Extensive experiments on four benchmark datasets demonstrate that STAFormer effectively combines spatial feature learning with temporal cue modeling, achieving performance competitive with or superior to existing methods in video person ReID.}
}
@article{XU2026115519,
title = {A fast deep spatial-temporal perception model based on tucker decomposition and multi-source factors for efficient nonlinear traffic flow forecasting},
journal = {Applied Soft Computing},
volume = {201},
pages = {115519},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115519},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009671},
author = {Zhihao Xu and Zhiqiang Lv and Benjia Chu and Jianbo Li},
keywords = {Nonlinear traffic flow, Multi-source factors, "Accuracy-efficiency" trade-off, Tucker decomposition},
abstract = {Traffic flow forecasting is a key technical component of Intelligent Transportation Systems (ITS). It overcomes the limitations of traditional passive traffic management and shifts the paradigm from "reactive response" to "proactive forecasting." Existing studies have primarily focused on modeling nonlinear traffic flow using models with massive parameters. However, long computing time is always a problem happened on these models. While maintaining high accuracy, ways to reduce computing time have rarely been explored in depth. Additionally, current research seldom leverages implicit nonlinear trends by proposing a framework to preprocess multi-source factors influencing traffic flow. The balance between accuracy and efficiency is critical to determining the practicality and reliability of ITS. The "accuracy-efficiency" trade-off in nonlinear traffic flow forecasting is addressed by proposing a Fast Deep Spatial-Temporal Perception (FDSTP) model, which integrates Tucker decomposition and multi-source factors for efficient forecasting. Experiments on four real-world datasets demonstrate that FDSTP reduces mean average error, root mean square error, combined accuracy, and computing time by approximately 35.68%, 29.88%, 31.99%, and 50.12%, respectively, compared to the baselines. Besides, FDSTP increases coefficient of determination (R2) by about 15.43%.}
}
@article{WANG2026115471,
title = {Embedding contrastive memory into variational autoencoder for anomaly detection in IIoT systems},
journal = {Applied Soft Computing},
volume = {201},
pages = {115471},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115471},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009191},
author = {Chunan Wang and Yongqun Zhang and Yafeng Wu and Lan Liu and Jichen Yang},
keywords = {Anomaly detection, IIoT systems, Variational Bayes, Contrastive memory},
abstract = {Industry 4.0 transforms manufacturing with AI, IoT, and Cyber-Physical Systems for efficiency, while Industry 5.0 prioritizes sustainability and human-centric values. Industrial Internet of Things systems, central to both, face cyber threats due to their dependence on wireless networks. Autoencoder-based anomaly detection excels in identifying anomalies, but it struggles with overfitting, especially when handling high-dimensional data in real-time IIoT systems. In this work, we propose an unsupervised anomaly detection method for IIoT systems by embedding contrastive memory into variational autoencoder, which we name CMVA for short. In this method, the variational autoencoder is based on Transformer and is used for latent representation generation while the contrastive memory is proposed by applying contrastive learning with memory and is used to capture normal data patterns. Two loss functions are incorporated to constrain the model: variational reconstruction loss for reconstructing hidden variables and inputs, and feature contrastive loss to diversify memory items and limit memory size. An estimation method based on the reconstruction error will identify anomalies in IIoT systems. Extensive experiments on two public datasets reveal that the proposed CMVA can detect anomaly significantly by reducing false detections and effectively identify high-dimensional IIoT system anomalies, compared with six baseline methods in terms of precision, F1-score, detection rate, false alarm rate, and latency.}
}
@article{JAIN2026115444,
title = {Sequential hybrid quantum transfer learning for robust and accurate accident detection},
journal = {Applied Soft Computing},
volume = {201},
pages = {115444},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115444},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008926},
author = {Swati Jain and Chhaya Gupta and Seema Nath Jain and Iti Batra and Giovanni Pau},
keywords = {Accident detection, Parameterized quantum circuit, Quantum convolutional neural network, Quantum deep learning, Quantum transfer learning},
abstract = {Detecting accidents is also a central aspect of intelligent transportation system since the increasing number of vehicles on the roads also increases the chances of road accidents. The most recent advances in deep learning and transfer learning have made it possible to analyze traffic surveillance image in an automated manner. At the same time, quantum-classical machine learning has emerged as a possible paradigm to implement quantum circuits in the standard neural networks. This paper outlines a series of hybrid quantum transfer-learning architecture of image-based accident detection, whereby the pre-trained convolutional neural network (MobileNet, ResNet50V2, or EfficientNetV2S) operates as a feature extractor, and the final dense classifier is replaced by a parameterised quantum circuit (PQC) layer. The three PQC designs that use different qubit entanglement architecture designs are considered to help clarify the effect of circuit topology on classification behavior in data-scarce conditions. A dataset of experimental experiments on the closed circuit television (CCTV) accident images was used, which contained 989 images and multiple backbone architectures and optimisers were used. The findings show that the hybrid achieves performance comparable to classical dense-layer baselines and it uses significantly fewer parameters of the training phase of the classification step. In repeated trials, PQC based classifier also exhibits more consistent training dynamics and less variability in performance. These results indicate that hybrid quantum -transfer learning can become a parameter-efficient substitute classifier in the transfer-learning pipelines, especially in data-limited scenarios. However, the experiments were limited to one data set and based on quantum simulation; thus, the findings cannot be perceived as a definitive representation of the parameter-efficient hybrid architectures but as an investigation of possible improvements in predictive ability.}
}
@article{LIU2026115533,
title = {Dual-phase transfer learning with swin transformer for automated vegetable disease detection in facility environments},
journal = {Applied Soft Computing},
volume = {201},
pages = {115533},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115533},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009816},
author = {Jun Liu and Xuewei Wang},
keywords = {Facility-grown vegetables, Disease detection, Lightweight model, Object detection, Smart agriculture, Swin Transformer},
abstract = {Rapid and accurate detection of vegetable diseases is critical for safeguarding agricultural productivity. While automated systems offer a viable alternative to labor-intensive manual inspection, their deployment in real-world facility environments is impeded by challenges such as complex background clutter, varying lesion scales, and target occlusion. To address these challenges, this study proposes SwinVegNet, a lightweight architecture tailored for multi-class vegetable disease detection. The proposed model integrates a Swin Transformer backbone with a novel Lightweight Adaptive Attention Mechanism (LAAM) in the neck structure. This synergy significantly enhances multi-scale feature representation and cross-channel information integration. Furthermore, a dual-phase transfer learning strategy is introduced to bridge the domain gap between generic object datasets and specific facility disease imagery, ensuring optimization stability. Extensive evaluations on a custom dataset comprising 30 disease types demonstrate that SwinVegNet achieves a mean Average Precision (mAP) of 94.62% with an inference time of only 23 ms per image. Outperforming representative baselines in both accuracy and efficiency, SwinVegNet offers a superior trade-off between performance and model size, validating its suitability for deployment in resource-constrained facility settings.}
}
@article{HUANG2026115517,
title = {Kernel self-representation residual analysis model for anomaly detection},
journal = {Applied Soft Computing},
volume = {201},
pages = {115517},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115517},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009658},
author = {Musheng Huang and Xiaoyun Chen and Lin Pan},
keywords = {Attributed graph, Anomaly detection, Residual analysis, Kernel tricks, Self-representation model},
abstract = {Attributed graph node anomaly detection aims to identify nodes that deviate significantly from the majority of nodes in a graph. Although existing residual analysis methods extract both attribute and structural features through self-representation models, these models are limited to capturing linear relationships between nodes and fail in reveal the complex nonlinear relationships embedded in node attributes. To fill this gap, this paper proposes a kernel self-representation residual analysis model for anomaly detection on attributed graphs (KRadar). The KRadar method projects the attribute matrix and residual matrix into a high-dimensional Hilbert space through nonlinear mapping, thereby making normal and abnormal nodes linearly separable in this high-dimensional space. The effectiveness of the KRadar method has been verified through experiments conducted on two real anomaly datasets and six synthetic anomaly datasets. Compared with the suboptimal method Radar, the average ROC-AUC value of KRadar has been increased by 10.2%, which fully demonstrates its superior performance.}
}
@article{ZHANG2026115525,
title = {Adaptive diversity-driven multi-strategy particle swarm optimization for global optimization and feature selection},
journal = {Applied Soft Computing},
volume = {201},
pages = {115525},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115525},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009737},
author = {Li Zhang},
keywords = {Particle swarm optimization, State-perception, Adaptive diversity-driven, Feature selection},
abstract = {The Particle Swarm Optimization (PSO) algorithm is frequently plagued by premature convergence and inefficient search capabilities when tackling complex, high-dimensional optimization problems. This paper proposes an Adaptive Diversity-driven Multi-strategy Particle Swarm Optimization (ADMPSO) algorithm. Its principal innovation lies in constructing a dual-dimensional diversity metric that synergistically integrates both solution space distribution and fitness distribution, enabling a precise and comprehensive quantification of population status. Building upon this metric, we introduce a multi-level parameter regulation mechanism driven by real-time diversity ratios and a stagnation penalty strategy, facilitating dynamic adaptive adjustments to the inertia weight and learning factors. Furthermore, a hierarchical particle update framework is designed, classifying particles into “special” and “non-special” categories based on instantaneous diversity feedback. Special particles are assigned enhanced exploration strategies, including guided perturbations and elite crossover. Non-special particles employ an adaptive hybrid search for focused exploitation, effectively achieving an optimal balance between global exploration and local exploitation. The algorithm is strengthened by an elite retention strategy and a multi-candidate solution local refinement mechanism to boost convergence precision and escape local optima. Extensive experiments on the CEC2017 and CEC2021 benchmark suites demonstrate that ADMPSO achieves significantly superior convergence accuracy, stability, and robustness across a vast majority of test functions compared to state-of-the-art PSO variants, including EAPSO, CEPSO, LDPSO, PSO-sono, and HCLPSO. The Wilcoxon rank-sum test rigorously confirms the statistical significance of these performance advantages, and the Friedman tests support these findings. Additionally, a successful application to high-dimensional feature selection problems on ten real-world datasets validates the algorithm’s outstanding generalisation capability and practical utility in solving complex engineering challenges.}
}
@article{FAIZ2026115440,
title = {Modeling and treatment of social media addiction using a fractional-order and deep neural network approach},
journal = {Applied Soft Computing},
volume = {201},
pages = {115440},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115440},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008884},
author = {Zeshan Faiz and  Waseem and Abu Safyan Ali and Adel Thaljaoui and Maria Altaib Badawi},
keywords = {Treatment of social media addiction, Neural network, Mathematical modeling, Artificial intelligence},
abstract = {Social media has become a part of modern life, making communication, sharing information, and entertainment easier. Nonetheless, overuse has raised issues about addictive behavior and the social and psychological implications of the same, including increased anxiety, depression, and a decline in face-to-face interactions. Effectively managing social media addiction requires structured intervention strategies, awareness, and the promotion of digital well-being. This work proposes a fractional-order (FO) mathematical model to examine the dynamics of social media addiction (TSA) treatment. The entire population is broken down into six compartments: susceptible (S), exposed (E), addicted (A), individuals under treatment (T), recovered (R), and quitters (Q). The model is examined with the help of the main epidemiological thresholds, such as the addiction-free equilibrium point (AFEP), the addiction-endemic equilibrium point (AEEP), and the basic reproduction number (R0). Basic properties like non-negativity and boundedness of solutions are proved. Sensitivity analysis is performed with the help of the normalized forward sensitivity index in order to determine the most significant parameters. To implement it numerically, the Adams-Bashforth-Moulton method is used to create reference data, which is then used to train a deep neural network (DNN) with a 70/15/15 training, testing and validation data split. The paper explores three different situations by changing the fractional-order derivative and rate of treatment of individuals addicted to determine their effects on addiction control. Regression coefficients, mean and variance measures, and mean square error are used to measure model performance and predictive capability of the DNN. Moreover, the DNN is more accurate; the absolute error is of the order of 10−09, which proves its efficiency in the approximation of the social media addiction dynamics and the control strategies based on treatment.}
}
@article{HE2026115436,
title = {Adaptive dual-threshold sparse residual attention for multivariate time series forecasting},
journal = {Applied Soft Computing},
volume = {201},
pages = {115436},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115436},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008847},
author = {Hengwei He and Chunhao Li and Xuyang Teng and Hong He and Meng Han and Zhaoyang Qiu and Huan Zhang},
keywords = {Time series prediction, Sparse residual attention, Adaptive dual thresholds, Structured sparsity},
abstract = {Attention-based deep networks have become prevalent in multivariate long-sequence time-series (LSTF) prediction, demonstrating capabilities to capture spatio-temporal correlations between target series and exogenous variables. Although transformers have shown effectiveness in LSTF tasks, existing approaches mainly focus on encoder–decoder modifications rather than optimizing attention mechanisms. To address this gap, we propose a Sparse Residual Attention (SRA) mechanism that restructures the scaled dot-product attention in Informer. The SRA module, located after the softmax layer, introduces adaptive dual thresholds dynamically computed from input attention weights. The similarity matrix is sparsified through a dual-channel process: values exceeding the thresholds are binarized to 1, while sub-threshold values are truncated to 0. This sparsity amplifies distinctive feature representations while suppressing noise. Additionally, a residual structure is incorporated to preserve the original information flow. To validate the decoupling capability, preliminary experiments were conducted on attention-based recurrent neural networks (RNNs) prior to implementation in Informer, iTransformer and PatchTST. Comprehensive evaluations demonstrate that our approach significantly outperforms state-of-the-art methods across multiple benchmarks.}
}
@article{GUNAY2026115485,
title = {ModuleCNN: A modular framework for unified CNN architecture and hyperparameter optimization via metaheuristics in image classification},
journal = {Applied Soft Computing},
volume = {201},
pages = {115485},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115485},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009336},
author = {Ilker Gunay and Ozkan Inik},
keywords = {Neural architecture search, Modular CNN design, Adaptive genome encoding, Metaheuristic optimization, Hyperparameter optimization},
abstract = {Designing convolutional neural networks (CNNs) and tuning their hyperparameters remain computationally demanding and highly expertise-driven tasks. Many Neural Architecture Search (NAS) methods rely on rigid templates or algorithm-specific encodings, limiting architectural flexibility and cross-optimizer compatibility. To address these limitations, we propose ModuleCNN, a metaheuristic optimization-based modular framework that unifies architecture search and hyperparameter optimization within a single adaptive representation. ModuleCNN formalizes structural design principles from established architectures (e.g., residual pathways and multi-branch aggregation) into standardized, reusable convolutional modules that are dynamically recombined during the search process. Candidate models are encoded using an Adaptive Genome Encoding scheme, where normalized continuous variables are mapped to discrete architectural and training configurations. This unified encoding enables seamless integration with evolutionary and swarm-based optimizers, including PSO, GA, and multi-objective NSGA-II. To ensure structural feasibility during automated composition, the framework incorporates a built-in Self-Healing mechanism that validates dimensional consistency, applies controlled parameter scaling, and prunes invalid connections when necessary. The search jointly optimizes structural attributes (depth, width, module type) and training hyperparameters (learning rate, batch size) under both single- and multi-objective formulations. Experimental evaluations on MNIST, Fashion-MNIST, and CIFAR-10 demonstrate that ModuleCNN consistently discovers compact and high-performing architectures, achieving accuracies of 99.57%, 96.03%, and 82.36%, respectively. These results indicate that modular encoding combined with automated validation enables efficient exploration of large discrete search spaces while maintaining architectural integrity and computational efficiency.}
}
@article{WANG2026115537,
title = {Enhancing daily runoff forecasting with a dual-domain deep learning model},
journal = {Applied Soft Computing},
volume = {201},
pages = {115537},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115537},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009853},
author = {Wen-chuan Wang and Can-can Shi and Hong-fei Zang and Dong-mei Xu},
keywords = {Daily runoff forecasting, NEMA, MKAN module, Dual-domain feature synergy, Multiple factors},
abstract = {Daily runoff forecasting is a fundamental basis for optimal water resources allocation, flood and drought early warning, and watershed risk management. However, runoff series usually exhibit pronounced non-stationarity, multi-scale periodicity, and complex nonlinear dynamic characteristics, making it difficult for conventional models to simultaneously capture long-term trends, local peak responses, and global periodic information. To address these issues, this study proposes a parallel hybrid forecasting model, termed NEMA-FITS-GRU-MKAN, which achieves high-accuracy prediction of complex runoff processes through the collaborative integration of input smoothing, time-domain modeling, and frequency-domain enhancement. Specifically, this study first constructs a normalized exponential moving average module (NEMA), which performs causal exponential smoothing in the normalized space to enhance long-term trend extraction and suppress high-frequency disturbances, thereby improving the stability of the input sequence. Subsequently, in the time-domain branch, the gated recurrent unit (GRU) is combined with the multi-order kernel attention network module (MKAN) to strengthen the model’s ability to capture high-order nonlinear relationships, local dynamic variations, and peak events. Meanwhile, a frequency-domain branch is constructed by introducing the Frequency Interpolation Time Series (FITS) model to extract the global dominant periodicity and low-frequency trend information of the sequence. This branch is then integrated in parallel with the GRU-MKAN time-domain branch, forming a joint modeling framework with complementary time-frequency characteristics. Randomized experiments were conducted on three markedly distinct datasets, namely Fish River, Salmon River, and McKenzie River. The results demonstrate that the proposed model achieved the best performance on the test sets at all three stations, with NSEC values of 0.969, 0.940, and 0.935, and KGE values of 0.967, 0.959, and 0.943, respectively. Compared with the benchmark models, NEMA-FITS-GRU-MKAN improved NSEC and KGE by up to 27.50% and 43.90%, respectively, across the three basins, while reducing RMSE, MAE, and RAE by up to 68.36%, 68.00%, and 68.09%, respectively. Further analysis indicates that the effect of NEMA is more pronounced in flood-peak event scenarios. The causal-non-causal comparison experiments verify that the improved causal NEMA can still preserve superior peak-structure representation while avoiding future information leakage. In addition, the interval peak experiments demonstrate that MKAN can effectively enhance the model’s capability to respond to local extreme events. Overall, the proposed NEMA-FITS-GRU-MKAN model can effectively enhance trend extraction, peak fitting, and overall forecasting accuracy for complex runoff series, thereby providing an effective new approach for high-accuracy daily runoff forecasting under hydrologically heterogeneous basin conditions.}
}
@article{ZHOU2026115509,
title = {An asymmetric Gaussian mixture model via anisotropic markov random field regularization for 3D-MRI brain tissue segmentation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115509},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115509},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009579},
author = {Zexun Zhou and Peitao Wang and Jianwen Feng and Cai Guo and Xiaochun Yu},
keywords = {Brain tissue segmentation, Asymmetric Gaussian mixture model, Anisotropic markov random field, Expectation-maximization},
abstract = {Accurate segmentation of intracranial tissues from Magnetic Resonance Imaging (MRI) is essential for quantitative neuroanalysis, yet it remains challenged by complex artifacts such as non-Gaussian intensity skewness and partial volume effects. Conventional statistical methods relying on standard Gaussian models and isotropic Markov Random Fields (MRFs) often compromise anatomical boundary definitions. To address these limitations, we propose an unsupervised probabilistic framework integrating a multivariate skew-normal mixture model with anisotropic MRF regularization. Specifically, we introduce a hybrid diffusion tensor-based spatial constraint that adaptively modulates regularization strength, effectively suppressing noise in homogeneous regions while preserving delicate anatomical structures. Within a unified variational inference formulation, our method models the bias field as an intrinsic latent variable, enabling joint optimization rather than relying on decoupled preprocessing. A topology-constrained post-processing step is additionally incorporated to mitigate partial volume effects. Evaluations on the BrainWeb, MRBrainS, and IBSR benchmarks demonstrate that the proposed approach achieves competitive segmentation accuracy and boundary delineation compared to state-of-the-art methods, offering a robust solution that bypasses the need for large-scale annotated datasets.}
}
@article{GORCUN2026115404,
title = {A neutrosophic MACONT-LOPCOW decision support model for emergency logistics center selection during humanitarian crises},
journal = {Applied Soft Computing},
volume = {201},
pages = {115404},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115404},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008525},
author = {Ömer Faruk Görçün and Sinan Çizmecioğlu and Vladimir Simic and Esra Boz and Ahmet Çalık},
keywords = {Disaster Management, Humanitarian Logistics, Emergency Logistics Centers, Type-2 Neutrosophic Fuzzy Sets, Mixed Aggregation by Comprehensive Normalization Technique},
abstract = {This paper examines disaster preparedness and response, focusing on challenges encountered during natural disasters such as earthquakes. Therefore, we aim to develop a new and powerful tool based on type-2 neutrosophic numbers (T2NNs) for the selection of emergency logistics centers (ELCs). In this context, mixed aggregation based on a comprehensive normalization technique (MACONT) and logarithmic percentage change-driven objective weighting (LOPCOW) are systematically integrated with expert-based subjective weighting under a type-2 neutrosophic environment to construct a coherent decision-making framework for the ELC selection problem. We extend the MACONT method, which handles multiple normalization techniques, to incorporate the benefits into the T2NN-based environment. We combine the objective weights obtained using the LOPCOW method with the subjective weights derived from the T2NNs' structural features to accurately and rationally determine the weights of the criteria affecting the selection of the ELC. The proposed model offers a systematic decision-making process that incorporates criteria weighting and alternative ranking steps, effectively managing ambiguity and inconsistency in expert judgments. Based on real field data and expert opinions from the Kahramanmaraş earthquake, the proposed approach was applied to 19 criteria across four main categories and five possible ELC alternatives. The findings show that the proposed T2NN-based integrated approach produces more consistent, decision-maker-oriented results than traditional methods. In this context, the study makes meaningful contributions to the disaster management literature and practice by providing a methodological reference for decision-making problems under uncertainty in emergency logistics.}
}
@article{LIU2026115493,
title = {DiffuPercom: A novel simplex-based diffusion framework for personalized comment generation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115493},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115493},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009415},
author = {Jiamiao Liu and Pengsen Cheng and Jinqiao Dai and Jiayong Liu},
keywords = {Simplex diffusion, Personalized comment generation, Personalized fusion attention, Self-conditioning},
abstract = {Diffusion models have recently shown promising results for language generation, yet extending them to multi-constraint sequence-to-sequence settings remains challenging. Personalized comment generation is a representative multi-constraint sequence-to-sequence task, where the model must condition on both user attributes and the source article to produce comments that are simultaneously relevant and personalized. To address this problem, a novel simplex-based diffusion model framework for personalized comments (named DiffuPercom) is proposed. Specifically, the denoising network adopts a Transformer encoder–decoder structure. By separately encoding personalized information and article content, the proposed PFA (Personalized Fusion Attention) module is used to integrate the two. The PFA module can effectively integrate personalized attribute information through weighting and masking mechanisms, thus enhancing the expression of personalized information. In addition, the current lack of publicly available datasets for personalized comment tasks hinders the progress of personalized comment generation tasks. Therefore, a personalized attribute comment dataset (named PersonalComment) is proposed, which assigns sentiment labels to each comment and can serve as a foundation for subsequent research. Finally, extensive experiments on the PersonalComment dataset have demonstrated that DiffuPercom achieves substantial improvements in diversity and attribute control, with increases of 8% and 1.7% respectively, outperforming current personalized models. In addition, in the manual evaluation, the controllability of DiffuPercom’s attributes as well as the p-value for the significant test compared to the baseline model are both less than 0.05. Furthermore, personalized comment with sentiment tendencies using classifier guidance is explored.}
}
@article{JIA2026115550,
title = {A self-adapting memetic algorithm with reinforcement learning for multi-objective aircraft recovery problems},
journal = {Applied Soft Computing},
volume = {201},
pages = {115550},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115550},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009981},
author = {Xiaoyi Jia and Tong Guo and Yi Mei and Mengjie Zhang and Fan Xiao and Xuechen Gu and Wenbo Du},
keywords = {Aircraft recovery, Multi-objective optimization, Airport slot constraints, Memetic algorithm, Reinforcement learning, Disruption management},
abstract = {Disruptions in airline operations often result in widespread delays and substantial economic losses, underscoring the importance of effective recovery strategies. Multi-objective aircraft recovery methods generate diverse feasible schedules that adhere to aircraft operational constraints, thereby supporting informed decisions for flight rescheduling. However, most existing works overlook airport-level capacity constraints, which are critical for ensuring operational feasibility in real-world scenarios. To fill this gap, we formulate a new multi-objective aircraft recovery problem. Our formulation jointly considers both aircraft- and airport-level operational constraints, aiming to optimize both economic performance and operational efficiency in a more operationally relevant setting. We tackle this challenging problem using a self-adapting memetic algorithm with reinforcement learning (SAMA-RL), which integrates problem-specific search strategies and repair mechanisms to address this issue. First, at the global search level, a problem-tailored genetic algorithm using an elite-preserving crossover (EPX) operator adaptively combines parent solutions based on their quality in both objectives, thereby retaining high-quality genetic segments. Then, at the local search level, five newly designed structure-driven improvement operators are guided by a reinforcement learning agent to exploit promising solutions while maintaining solution diversity and feasibility. At the constraint-handling level, global and local search are seamlessly integrated via a priority-tiered repair strategy that restores feasibility under both aircraft- and airport-level constraints with minimal loss of objective value. Extensive experiments on 28 ROADEF Challenge instances show that SAMA-RL consistently outperforms ten state-of-the-art algorithms in terms of hypervolume and inverted generational distance. Additional ablation studies further validate the individual and combined effectiveness of the proposed components, highlighting the potential of SAMA-RL for large-scale aircraft recovery scenarios.}
}
@article{XU2026115501,
title = {A one-stage model compression method based on teaching director},
journal = {Applied Soft Computing},
volume = {201},
pages = {115501},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115501},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600949X},
author = {Delong Xu and Xinyu Li},
keywords = {Knowledge distillation, Network pruning, Pest detection, Parameter sparsity},
abstract = {Deep learning-based pest detection is critical for precision agriculture, yet the huge model size hinders edge deployment. Although combining knowledge distillation (KD) and network pruning (NP) reduces model size, existing sequential integration suffers from low efficiency, high time overhead, and a teacher–student “learning generation gap”. To address this, we introduce a new role, the teaching director, to measure the performance of the student model through multiple dimensions in the process of knowledge transfer, accurately control the sparsity and distillation intensity, comprehensively consider the performance of the previous two epochs and the current epoch of the student model, dynamically switch the learning modes, and realize the one-stage model compression method combining pruning and knowledge distillation. At the same time, we propose a distillation barycenter transition strategy, which gradually shifts the learning focus of the student model from the teacher model to a student-friendly assistant model in the process of knowledge distillation, so as to alleviate the problem of the “learning generation gap” between teacher and student. Validated on a self-made pest dataset (28 categories, 5678 images) and PASCAL VOC across ResNet, VGG, and CSPDarknet, the method outperforms 11 state-of-the-art methods. On ResNet, the method achieves 87.64% mAP@0.5 and 77.72% mmAP, which are 0.86% and 0.84% higher than the baseline, reducing parameters by 85.92% and FLOPs by 84.53%, enabling edge deployment for the pest detection model.}
}
@article{WEI2026115506,
title = {Fine-grained multi-scale feature fusion for robust citrus detection under complex orchard conditions},
journal = {Applied Soft Computing},
volume = {201},
pages = {115506},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115506},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009543},
author = {Yuxuan Wei and Yunbo Wang and Jiazheng Wu and Fukai Zhang and Chao Zhang and Jianguang Li and Wu Liu and Qiang Lyu and Shan An},
keywords = {Small object detection, Spatial-frequency feature fusion, Wavelet transform downsampling, Occluded object detection},
abstract = {Accurate citrus fruit detection is essential for automated orchard management and yield estimation. However, widespread occlusion, dense planting patterns, and dynamic illumination in real-world scenarios mask critical textures, leading to severe feature degradation, especially for small-scale targets. To address these challenges, we propose FG-DETR, a fine-grained multi-scale feature fusion model configured to accurately distinguish citrus fruits from complex interfering backgrounds. Specifically, the core innovations of the proposed model include the Dynamic Feature Encoder (DFE) configured to filter background visual noise, the Frequency Domain and Spatial Domain Feature Enhancement (FSFE) module designed to integrate representation information from both dimensions, and the Wavelet Transform Downsampling (WTD) strategy employed to preserve critical high-frequency details with reduced computational overhead. Extensive experiments demonstrate that FG-DETR achieves significant performance gains. On the Citrus and VisDrone object detection datasets, the proposed method improves AP50 by 3.3% and 3.6%, and overall AP by 3.3% and 2.2%, respectively, compared with the baseline RT-DETR model.}
}
@article{LI2026115458,
title = {Agricultural robots task allocation via learning-enhanced memetic optimization},
journal = {Applied Soft Computing},
volume = {201},
pages = {115458},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115458},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009063},
author = {Biyue Li and Meilin Mao and Jiankun Yin and Fanjia Meng},
keywords = {Intelligent agriculture, Mobile robot task-allocation, Combinatorial optimization, Metaheuristics},
abstract = {With the increasing adoption of autonomous mobile robots in agriculture, Multi-Robot Task Allocation (MRTA) has emerged as a critical challenge for optimizing pesticide spraying, fertilization, and harvesting operations. While memetic optimization approaches combining global exploration and local refinement show promise for this NP-hard problem, existing methods struggle with the exponential solution space growth in large-scale agricultural environments and lack mechanisms to leverage historical optimization knowledge. This paper proposes LEMO (Learning-Enhanced Memetic Optimization), a novel framework that addresses these limitations through two key innovations: (1) A machine learning-guided decomposition strategy that automatically clusters thousands of crop nodes into robot depot-specific subproblems by capturing spatial-task dependencies, eliminating reliance on handcrafted heuristic rules; (2) A knowledge-transfer enhanced memetic algorithm featuring a merge-split order crossover-based global optimizer and seven specialized local search operators, augmented by a metaknowledge transfer mechanism that propagates successful crossover parameters and Variable Neighborhood Search sequences from high-performing to underperforming subproblems. Extensive experiments on both synthetic and realistic scenarios demonstrate LEMO’s superior performance compared to the state-of-the-art MRTA methods. Further analysis verifies the effectiveness of the proposed decomposition strategy and knowledge transfer scheme. These advancements establish LEMO as an effective solution for large-scale agricultural task allocation.}
}
@article{ZHAO2026115510,
title = {STD-Net: A novel source-target discrimination network for copy-move forgery detection using consistency strategy},
journal = {Applied Soft Computing},
volume = {201},
pages = {115510},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115510},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009580},
author = {Kaiqi Zhao and Jian Wu and Xu Chang and Yan Xiang and Jiahao Huang and Xiaochen Yuan},
keywords = {Copy-move forgery detection, Image manipulation, Consistency similarity, Source-target discrimination},
abstract = {Most current Copy-Move Forgery Detection (CMFD) methods concentrate on the copy-move areas’ localization. However, accurate discrimination between the source and target regions in copy-move areas still a critical bottleneck. Although existing disambiguation methods have advanced the development of CMFD, they commonly treat disambiguation as a simple classification task or fail to trace effective and stable feature cues. To address these limitations, we convert this challenging task into a consistency identification problem and propose STD-Net, a disambiguation method for source-target discrimination in copy-move regions. Specifically, we take the genuine area as the third-party reference object, aiming to leverage a Consistency Detection between it and the suspicious (copy-move) areas. STD-Net consists of Duplicate Patches Extraction, Genuine Patches Extraction, and Discrimination. Duplicate Patches Extraction extracts duplicated copy-move patches, while the Genuine Patches Extraction matches each copy-move patch with a genuine patch of strictly identical size, which eliminates errors caused by asynchronous scaling and provides a unified benchmark for consistency analysis. The Discrimination phase employs a dual-stream structure, RGB-based Discrimination and Noise-based Discrimination. RGB-based stream detects multi-level texture consistency, while Noise-based stream focuses on high-frequency noise consistency. Both streams are learned for consistency measurement rather than general forged trace detection. Then, the final discrimination output is obtained by fusing the consistency results from both streams using learnable weighting. STD-Net is trained on two synthesized datasets and evaluated on CASIA V2.0, CoMoFoD, and Coverage datasets. The experimental results demonstrate that our method achieves state-of-the-art performance in source-target discrimination for copy-move forgery detection.}
}
@article{CHEN2026115490,
title = {A two-stage multi-fidelity Bayesian optimization framework with landscape-aware initialization and dual-adaptive sampling},
journal = {Applied Soft Computing},
volume = {201},
pages = {115490},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115490},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009385},
author = {Hui Chen and Yupeng Sun and Yizhong Ma},
keywords = {Bayesian optimization, Multi-fidelity surrogate, Promising region identification, Dual-adaptive lower confidence bound, Expensive black-box optimization},
abstract = {This paper presents a two-stage multi-fidelity Bayesian optimization (TS-MFBO) framework for computationally expensive black-box problems. In the first stage, a landscape-aware initialization strategy is developed, where multiple high-potential regions are identified based on the ordinal ranking of an inexpensive low-fidelity (LF) model using a distance- and connectivity-based procedure. Initial high-fidelity (HF) samples are then preferentially allocated to these regions, yielding an informative initial multi-fidelity surrogate for subsequent optimization. In the second stage, a dual-adaptive lower confidence bound (DA-LCB) acquisition function is proposed, in which the exploration weight β is governed by two complementary mechanisms: a budget-driven cosine annealing schedule that gradually reduces global exploration over the remaining computational budget, and a fidelity-aware spatial term that locally increases exploration in regions where LF-to-HF correction uncertainty is dominant. This formulation enables a dynamic exploration–exploitation balance, improving robustness against premature convergence. The proposed framework is evaluated on eight benchmark functions and a real-world gas-pressure vessel design problem. Results demonstrate that it achieves superior convergence accuracy and robustness over state-of-the-art methods under limited computational budgets.}
}
@article{LUO2026115552,
title = {Visual-textual fusion for multi-attribute product ranking: A soft computing framework based on topic mining and regret modeling},
journal = {Applied Soft Computing},
volume = {201},
pages = {115552},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115552},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010008},
author = {Chaoguang Luo and Yong Qin},
keywords = {Multimodal data, User-generated photos, Multi-attribute decision-making, Affective distribution, Regret theory},
abstract = {In the digital age, user-generated content has emerged as a pivotal resource for consumers seeking product information and making informed decisions, especially in multi-attribute decision-making contexts. Existing studies have predominantly focused on textual reviews, while the complementary and expressive value of user-generated photos has often been overlooked. Visual data not only provide contextual cues but also convey rich affective and experiential information that textual content alone cannot fully capture. To address this gap, this study develops a visual-textual fusion framework for multi-attribute product ranking, functioning as a multimodal decision support system that leverages textual reviews and user-generated photos to provide a more comprehensive basis for product evaluation. Specifically, the bootstrapping language-image pre-training model is used to transform user-generated photos into textual descriptions, which are then combined with the original textual reviews to create augmented review texts. Subsequently, the Top2Vec model is applied to the augmented review texts for topic modeling to extract key product attributes. Additionally, a backpropagation neural network is employed to analyze the relative importance of reviews, and a bagging neural network model based on affective distribution computing is implemented to evaluate the weights of product attributes. Finally, incorporating these weights, a regret theory-based ranking model is constructed that accounts for consumer psychological factors in the decision-making framework. Empirical analysis using data from a well-known travel platform demonstrates the robustness and interpretability of the proposed framework through comparative experiments, parameter sensitivity analysis, and ablation studies. Benchmark comparisons with classical multi-attribute decision-making methods show that the integration of visual and textual information substantially enhances product ranking performance and provides deeper insights into consumer preferences. The code is available on GitHub.11https://github.com/domagic/Visual-Textual-Fusion-for-Multi-Attribute-Product-Ranking.}
}
@article{CSATO2026115535,
title = {Reducing the non-uniformity of the group draw in sports tournaments},
journal = {Applied Soft Computing},
volume = {201},
pages = {115535},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115535},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600983X},
author = {László Csató},
keywords = {Constrained assignment, Fairness, Group draw, Heuristics, Mechanism design},
abstract = {abstract
The group draw of a sports tournament requires assigning teams to groups of (almost) the same size. The most important criteria for a draw procedure are balance, randomness, and transparency, which cannot be satisfied simultaneously if draw constraints exist. Organisers usually use the so-called Skip mechanism, a method based on a random sequential draw of the teams from pots, in order to ensure balance and transparency. However, the Skip mechanism is non-uniformly distributed: the valid assignments are not necessarily equally likely. We quantify this distortion if a group can contain at most two teams from a given set S, which poses a serious challenge for the Skip mechanism. Our study provides exact results for an arbitrary number of teams when there are three pots and two pots contain only one team from the set S, as well as complete enumeration for small problems with three pots and at most five teams per pot. We also analyse three real-world case studies from basketball and football. It turns out that the optimal design considers the pots in decreasing order according to the number of teams in the set S. These results can be used to identify the least distorted transparent draw procedure, and decide whether the extent of non-uniformity calls for further actions.}
}
@article{NIU2026115330,
title = {Multi-sensor information fusion with dual-space aligned GAN for piston lever surface roughness prediction under imbalanced data},
journal = {Applied Soft Computing},
volume = {201},
pages = {115330},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115330},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007787},
author = {Mengmeng Niu and Kuo Liu and Jiadong Huang and Yongqing Wang},
keywords = {Surface roughness Prediction, Imbalance data, Generative adversarial network, Information fusion, Squeeze and excitation},
abstract = {Manual detection of surface roughness will reduce processing efficiency. To address this, deep learning models have been applied to predict surface roughness. However, due to the imbalance of surface roughness data and the intricate nature of turning processing mechanism, traditional surface roughness prediction methods are difficult to meet practical demands. Therefore, this paper presents a data augmentation method based on dual-space aligned GAN, and multi-sensor information fusion method for piston lever surface roughness prediction. First, a feature matching module is added on the basis of the traditional GAN structure to enhance the alignment of real samples and generated samples in the signal space and feature space. Temperature control is added to the latent vector z to improve the diversity of generated samples. Then, the information fusion is performed on the multi-source signal data. Convolutional neural networks (CNN) are used as the basic classification model. Squeeze and Excitation (SE) is introduced to strengthen the model's ability to model the importance of different channel features. Multi-scale feature aggregation (MFA) extracts key feature information of different scales and performs feature fusion to improve the richness of feature representation. Finally, the fused feature data is input into the classifier for classification. Two groups of experiments on turning bars demonstrate that the improved GAN and the multi-sensor information fusion model show superior generalization and effectiveness in both data enhancement and surface roughness prediction. Notably, the proposed methods reach prediction accuracies of 97.2% and 96.1%, outperforming multiple baseline models.}
}
@article{YIN2026115524,
title = {SSL-OTA: Unveiling backdoor threats in self-supervised learning for object detection},
journal = {Applied Soft Computing},
volume = {201},
pages = {115524},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115524},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009725},
author = {Changchun Yin and Qiannan Wang and Huiqin Yang and Liming Fang and Lu Zhou and Zhe Liu},
keywords = {Backdoor attack, Self-supervised learning, Object detection},
abstract = {The extensive adoption of Self-supervised learning (SSL) has led to an increased security threat from backdoor attacks. While existing research has mainly focused on backdoor attacks in image classification, there has been limited exploration of their implications for object detection. Object detection plays a critical role in security-sensitive applications, such as autonomous driving, where backdoor attacks seriously threaten human life and property. In this work, we propose the first backdoor attack designed for object detection tasks in SSL scenarios, called Object Transform Attack (SSL-OTA). SSL-OTA employs a trigger capable of altering predictions of the target object to the desired category, encompassing two attacks: Naive Attack (NA) and Dual-Source Blending Attack (DSBA). NA conducts data poisoning during downstream fine-tuning of the object detector, while DSBA innovatively poisons both the pre-trained encoder (via a shadow dataset) and a minimal subset of the downstream data. Notably, using Faster R-CNN on the PASCAL VOC2007 dataset, our NA achieved an Attack Success Rate (ASR) of 72.56%, while our DSBA reached an ASR of 86.55%. Both results were achieved at an extremely low poisoning rate of 0.5%, and the resulting performance impact on the benign mean Average Precision (mAP) was less than 1%. The results underscore the importance of considering backdoor threats in SSL-based object detection and contribute a novel perspective to the field.}
}
@article{CHEN2026115532,
title = {Entropy-informed deep residual network for nonlinear EEG dynamics in fine-grained driver state recognition},
journal = {Applied Soft Computing},
volume = {201},
pages = {115532},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115532},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009804},
author = {Jichi Chen and Shengkai Jin and Yuguo Cui and Chunfeng Wei and Kemal Polat and Fayadh Alenezi},
keywords = {Nonlinear EEG dynamics, Differential entropy, Attention residual network, Driver cognitive states, Complex systems analysis},
abstract = {Driver fatigue represents a nonlinear and nonstationary cognitive process that introduces significant instability into human–machine systems. Conventional binary detection approaches are unable to characterize transitional states such as drowsiness, which limits their ability to capture the full spectrum of driver alertness. To overcome this limitation, this study proposes an entropy-informed deep residual network for fine-grained driver state recognition based on electroencephalogram (EEG) dynamics. In this framework, EEG signals are first preprocessed through filtering and artifact removal to ensure data reliability. Differential entropy features are then extracted using a Gaussian-based method so that the temporal complexity of the EEG can be represented more effectively. A residual neural network with an embedded attention mechanism (ResNet-AM) is further designed, which enables the model to emphasize salient neural features that reflect nonlinear transitions among alert, drowsy, and fatigued states. Experimental validation on the SEED-VIG dataset, which includes EEG recordings from 23 participants, demonstrates that the proposed model achieves an average accuracy of 87.30%, precision of 87.78%, sensitivity of 87.95%, and F1-score of 87.87%. The model attains a peak accuracy of 88.89% and achieves a drowsy-state recognition rate of 91.19%, which indicates its effectiveness in capturing transitional fatigue states. These results indicate that entropy-informed and attention-augmented deep learning can provide an effective means to model nonlinear EEG dynamics and support real-time cognitive monitoring in intelligent transportation systems.}
}
@article{ZHANG2026115484,
title = {AI for crowd anomaly detection: A systematic review, challenges and future trend},
journal = {Applied Soft Computing},
volume = {201},
pages = {115484},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115484},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009324},
author = {Xuguang Zhang and Linen Liu and Hui Yu},
keywords = {Collective movement, Crowd anomaly detection, Video surveillance, Deep learning},
abstract = {Crowd anomaly behavior detection has emerged as a key research area within video surveillance. This paper explores strategies for analyzing crowd behavior through the lens of collective movement and examines how video surveillance technologies can be leveraged to address crowd safety challenges. Particular emphasis is placed on the role of deep learning in advancing anomaly detection. We review relevant literature published between 2019 and 2025, categorizing deep learning-based approaches into three main types: object detection, feature extraction, and data reconstruction/prediction. For object detection methods, we summarize network architectures, anomaly detection techniques, and Area Under the Curve (AUC) evaluation metrics across benchmark datasets. For feature extraction approaches, we detail the networks employed, the temporal and spatial features extracted, and their performance metrics. For reconstruction and prediction-based methods, we outline the data generators, generated objects, and associated discriminators. Finally, the paper offers a forward-looking perspective on the challenges and future directions in crowd anomaly detection research.}
}
@article{RAUTMARE2026115536,
title = {Artificial neural network-based estimation of shear strength parameters in silty sandy soils: A case study from Gujarat, India},
journal = {Applied Soft Computing},
volume = {201},
pages = {115536},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115536},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009841},
author = {S.B. Rautmare and R.S. Dalvi and G.S. Vyas},
keywords = {Angle of friction, Artificial neural network, Bland–Altman analysis, Cohesion, Shear strength parameters, Prediction model},
abstract = {This study presents the development and validation of an artificial neural network (ANN) model for estimating key geotechnical parameters, cohesion (c), and angle of internal friction (ϕ). A total of 453 soil samples were compiled from 73 locations across Gujarat, India. Two ANN algorithms, Levenberg-Marquardt and Scaled Conjugate Gradient, were trained using varying input combinations. These inputs were derived from index properties, specific gravity, densities, water content, grain size distribution, and Atterberg limits. The best-performing models achieved R² values up to 97.86% and 96.00%. To enhance field applicability, models were developed using three inputs (gravel, sand, and silt + clay fractions), which still yielded R² values exceeding 95% for both algorithms. After k-fold cross-validation was adopted for internal dataset verification, a model supporting maximum accuracy with minimum inputs was selected. An independent set of unseen (held-out) soil samples from previously published studies was used for external validation to assess the generalisation capacity of the selected model. Prediction accuracy on this data remained consistently high, with relative errors typically within ±5%. Further statistical agreement was examined using Bland–Altman analysis, which confirmed that the majority of prediction errors fall within acceptable limits of agreement. The findings highlight that a minimal yet critical set of soil properties is sufficient for reliable estimation of c and ϕ, making the proposed ANN framework a rapid, cost-effective, and globally relevant alternative to conventional laboratory testing, particularly in data-scarce or resource-constrained environments.}
}
@article{ZHANG2026115487,
title = {A unified generation framework for crack images and masks with edge-guided supervision},
journal = {Applied Soft Computing},
volume = {201},
pages = {115487},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115487},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600935X},
author = {Xun Zhang and Jianming Ding and Kaiyun Wang},
keywords = {Sleeper crack defect, GAN-based data augmentation, Mask generation, Annotation-free},
abstract = {To overcome the annotation-intensive bottleneck that hinders the scalability of crack image datasets, a novel edge-guided pseudo-supervised generative adversarial framework, termed AutoMask-GAN (AMGAN), is proposed. AMGAN enables end-to-end joint generation of crack images and corresponding masks without requiring any human-annotated data. It takes background images and random noise as inputs and incorporates a content-aware loss to preserve structural consistency in non-crack regions, while simultaneously enabling diverse crack synthesis. In the early training stages, edge-detected pseudomasks provide initial supervision, guiding the model to generate masks consistent with the crack patterns. A progressive pseudo-supervised learning strategy gradually shifts supervision from edge-based to model-generated pseudomasks, helping the network learn more refined and coherent crack masks. Experimental results based on the YOLOv11s-seg model demonstrate that AMGAN-generated samples outperform those produced by DCGAN and CycleGAN with pretrained pseudolabels, validating the effectiveness and scalability of the proposed framework for annotation-free crack dataset construction.}
}
@article{DA2026115508,
title = {Fisher score–based feature selection within weighted neighborhood rough sets},
journal = {Applied Soft Computing},
volume = {201},
pages = {115508},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115508},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009567},
author = {Zi He Da and Bo Wen Fang},
keywords = {Feature selection, Weighted neighborhood rough set, Fisher score, Discriminative overlap;},
abstract = {Fisher Score (FS) is widely used in supervised feature selection, but it evaluates each feature independently and therefore cannot characterize the discriminative ability of feature pairs. This raises an important question in FS-based feature selection: whether a subset composed of features with high individual FS values necessarily yields better classification performance. To address this issue, we propose a novel FS-based feature evaluation criterion that incorporates pairwise discriminative ability. In addition, conventional FS requires the number of selected features to be specified manually, which is often difficult to justify in a data-driven manner. To alleviate this limitation, we introduce the Neighborhood Rough Set (NRS) model to evaluate attribute significance during subset construction. Since standard NRS usually treats all attributes equally, we further propose an FS-based Weighted Neighborhood Rough Set model (FSW-NRS), which combines discriminative information from FS with NRS-based significance evaluation for more effective feature selection. In the proposed FSW-NRS model, FS is first used to compute normalized attribute weights and construct a Weighted Neighborhood Rough Set framework, in which dependency is used to evaluate attribute-subset significance. An FS-based discriminative-overlap coefficient is then incorporated as a soft penalization term to discourage excessively overlapping feature pairs. Based on these two components, a feature selection algorithm is developed to obtain feature subsets with high relevance and reduced discriminative overlap. Finally, experiments on 13 benchmark datasets under 10-NN and RBF-SVM show that FSW-NRS yields more effective feature subsets than conventional Fisher Score ranking and remains competitive with representative baseline methods. In particular, its empirical advantages are more pronounced under 10-NN, where it improves the mean accuracy over conventional Fisher Score ranking by 4.87 percentage points, whereas under RBF-SVM the gains are smaller although the method remains competitive.}
}
@article{HE2026115492,
title = {GMFNet: A gated multi-stage fusion network for efficient sewer defect detection based on inherent pipe joint feature},
journal = {Applied Soft Computing},
volume = {201},
pages = {115492},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115492},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009403},
author = {Jianghai He and Zegen Wang and Yaowen Ran and Xia Liu and Xinming Pu and Zehua Wang},
keywords = {Sewer pipe, Defect detection, Pipe joints, Feature-level fusion, Gated channel attention},
abstract = {Sewer defect detection is a very important technique to guarantee sewer pipe quality and prolong its service life. Surveillance videos captured by closed-circuit television (CCTV) often offer massive image data, which allows the development of convolutional neural network (CNN)-based methods. However, conventional approaches often overlook the intrinsic features inherent in the data and struggle to obtain effective detect performance. In this paper, we exploit the fact that pipe joints are intrinsic feature and propose a gated multi-stage fusion network (GMFNet) for sewer defect detection. After feature extraction of defect and pipe joint by a modified CNN, we design a simple and efficient feature fusion module with a gating mechanism named gated channel fusion module (GCFM). GCFM focuses on the general information of low-level features and the semantic information of high-level features, enabling adaptive delivery of distinct features. The GCFM is also able to purify interference and enrich semantics in the fusion process. To enable information communication between the two features, we propose an aggregated channel shuffle (ACS). After that, we develop a gated decoupled channel attention (GDCA) to unveil the behavior of the pipe joint mask. Experiment results demonstrate that the proposed model achieved a precision (P) of 0.678, a recall (R) of 0.356, and a mean average precision (mAP) of 0.503 on benchmark dataset, some of which are far superior to the baseline (P: 0.627, R: 0.357, mAP: 0.433) and other existing models. These results demonstrated the significant positive influence of pipe joint features on sewer defect detection.}
}
@article{ALSHAMRANI2026115464,
title = {An integrated gained and lost dominance score methodology for evaluating the performance of wearable health devices},
journal = {Applied Soft Computing},
volume = {201},
pages = {115464},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115464},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009129},
author = {Ahmad M. Alshamrani and Pratibha Rani and Arunodaya Raj Mishra and Dragan Stevan Pamucar and Adel Fahad Alrasheedi},
keywords = {Wearable health devices, Q-rung orthopair fuzzy sets, Score function, Distance measure, Symmetry point of criterion, Gained and lost dominance score},
abstract = {Wearable health devices have gained significant momentum in the daily life by providing continuous monitoring of human physical activities. This study aims to propose a hybrid decision support framework for evaluating and prioritizing the wearable health devices for community-dwelling adults. For this purpose, the steps of gained and lost dominance score (GLDS) method are incorporated with improved symmetry point of criterion (SPC) and stepwise weight assessment ratio analysis (SWARA) weighting methods under the context of q-rung orthopair fuzzy sets (q-ROFSs). The proposed framework is classified into four stages. First, the weights of experts are computed through a q-rung orthopair fuzzy score function-based procedure. To this end, we propose novel score formula for q-rung orthopair fuzzy numbers, followed by comparative analysis. Second, the opinions of experts are aggregated to get the collective assessment degree of each option against several criteria. Third, the criteria weights are determined through a collective weight-determining process involving q-rung orthopair fuzzy SPC and SWARA models. For this purpose, we propose a new distance measure for describing the degree of dissimilarity between q-ROFSs. Based on these stages, an integrated q-rung orthopair fuzzy GLDS method is presented to rank the wearable health devices for community-dwelling adults. To assess the effectiveness of the proposed method, we implemented it to a case study of wearable health device selection problem, wherein the information about the alternatives and criteria is given in terms of q-rung orthopair fuzzy numbers. The opinions of four experts are used to assess the wearable health devices. Numerical experiment indicates that the criterion “accuracy (0.173)”, “battery life (0.157)” and “data management (0.149)” are the three topmost significant criteria to wearable health device selection. In addition, the results show that an option “wrist-worn wearable device (B4)” has the maximum collective score, followed by the health tracking ring (B2), smart headbands (B1) and smart clothing (B3). The numeric values of these selected wearable health devices are B4 = 0.0648 > B2 = -0.0130 > B1 = -0.0178 > B3 = -0.0825. Further, sensitivity analysis with respect to criterion weighting parameter is conducted to verify the steadiness of attained results. Finally, the efficiency of introduced approach is tested based on the comparison with other ranking q-rung orthopair fuzzy decision-making approaches.}
}
@article{LEI2026115516,
title = {Drug-target activation/Inhibition effects prediction based on signed networks and protein language model},
journal = {Applied Soft Computing},
volume = {201},
pages = {115516},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115516},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009646},
author = {Xiujuan Lei and Mengdi Wang and Ming Chen and Ling Guo and Yi Pan},
keywords = {Drug action mechanisms, Drug-target activation/inhibition prediction, Signed graph neural networks, Protein language models},
abstract = {The prediction of drug action mechanisms is a core challenge in precision drug design. Existing research mainly focuses on binary classification tasks predicting the existence of drug-target interactions and regression tasks predicting affinity, while significant gaps remain in computational methods for revealing drug action mechanisms. Traditional methods rely on target 3D structures or manually designed feature encoding, while current computational methods overlook the synergistic modeling of molecular properties and network topology. To address this, SGCA-DTI is proposed in this article, which integrates attribute features and signed network topology features for activation/inhibition effect prediction. At the attribute feature level, it integrates drug dual-fingerprint encoding with structure-aware protein embeddings from ProtT5, leveraging its self-attention mechanism to capture evolutionary and physicochemical patterns. At the network modeling level, a bipartite network containing activation/inhibition signs is constructed, and signed bipartite graph contrastive learning is used to model the relationships and capture network topology features. Experimental results on benchmark datasets show that SGCA-DTI performs excellently, achieving an AUC of 0.9584 and an AUPR of 0.9279. Case studies on Midazolam for anxiolysis and Agomelatine and Maprotiline for antidepressant therapy show that SGCA-DTI accurately predicts drug-target activation/inhibition effects, demonstrating its capability in practical applications.}
}
@article{LI2026115400,
title = {An elastic graph coloring memetic algorithm for lifelong multi-agent task allocation problems},
journal = {Applied Soft Computing},
volume = {201},
pages = {115400},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115400},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008483},
author = {Ya-Jie Li and Ting Huang and Yue-Jiao Gong and Jing Liu},
keywords = {Graph coloring, Memetic algorithm, Lifelong multi-agent task allocation (LMATA), Scheduling conflict resolving},
abstract = {Multi-Agent Task Allocation (MATA) problems are critical in various fields, such as intelligent warehouses. Unlike traditional MATA, which is limited by its assumption of a fixed set of tasks in one-shot or episodic scenarios, this work addresses a more challenging variant: Lifelong MATA (LMATA) problems. LMATA refers to a multi-agent task allocation problem where tasks continuously arrive over a long-term process. LMATA involves allocating new tasks as they arrive and adjusting the allocation of previously assigned tasks based on evolving conditions. To solve this issue, our contributions are threefold. First, we transform LMATA as a graph coloring problem, where tasks correspond to nodes, scheduling conflicts to edges, and agents to colors. Next, we introduce an elastic graph coloring memetic algorithm, namely EGCMA, to solve the transformed LMATA problems. To be specific, we design three core strategies: a backbone-based crossover that inherits high-promising genes from parents for effective exploration and increases population diversity, a Kempe mutation to escape local optima, and a conflict-resolving local search strategy to improve the elite solutions to further reduce scheduling conflicts and task cycle time. Extensive experiments demonstrate that EGCMA achieves clear performance advantages over state-of-the-art algorithms across diverse instances. On average, it reduces task cycle time by 62.15% under different numbers of agents compared with all baselines.}
}
@article{ALHUDA2026115497,
title = {A global and local encoder fusion network for pavement crack segmentation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115497},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115497},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009452},
author = {Zaid Al-Huda and Bo Peng and Riyadh Nazar Ali Algburi and Mugahed A. Al-antari and Omar Al-maqtari and Donghai Zhai},
keywords = {Automatic crack detection, Semantic segmentation, Vision transformer (ViT), Convolutional neural networks (CNN), Refined module},
abstract = {Accurate crack segmentation is vital for structural health evaluation and monitoring. CNN-based crack segmentation methods are widely used, but their inherent focus on locality limits their ability to capture global crack features. While transformer-based methods capture global semantic information, they have strong data dependence and can easily lose local crack features. To address this issue, we propose a novel dual-encoder fusion network that combines a ViT-based global encoder with a CNN-based local encoder. The architecture incorporates Lightweight Feature Adaptation (LFA) modules to fuse multi-scale features from both encoders, a Dual Refinement Module (DRM) to enhance boundary accuracy, and a hybrid weighted segmentation loss function is developed to optimize the segmentation network and capture detailed crack information. Additionally, a crack dual refinement module is applied to purify segmented crack boundaries. Comprehensive experimental evaluations on four benchmark datasets (DeepCrack, Crack500, CFD, and CrackSC) demonstrate that GLEF-Net achieves state-of-the-art segmentation performance. The dual-encoder fusion significantly improves segmentation accuracy and robustness. This advancement is critical for automated infrastructure inspection and preventive maintenance. The framework opens new research directions for multi-scale feature fusion and hybrid architectures in infrastructure defect detection.}
}
@article{CHEN2026115521,
title = {Multi-objective evolutionary reinforcement learning for pareto-optimal interpretable policies},
journal = {Applied Soft Computing},
volume = {201},
pages = {115521},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115521},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009695},
author = {Shikun Chen and Yangguang Liu},
keywords = {Multi-objective reinforcement learning, Interpretable policies, Evolutionary algorithms, Pareto optimality, Decision trees},
abstract = {Reinforcement learning (RL) delivers strong task performance but provides limited transparency—a concern in safety-critical applications. Current methods treat interpretability as post-hoc explanation. This forces arbitrary trade-offs between performance and transparency. We address this by treating interpretability as an explicit objective in multi-objective RL (MORL). Our framework employs evolutionary algorithms (NSGA-III and MOEA/D) to evolve decision tree policies optimized for both performance and a composite interpretability proxy metric: tree depth, rule count, temporal coherence, and causal sufficiency. We prove convergence to the Pareto front with probability 1 and derive sample complexity bounds that characterize when interpretable policies match neural network performance. Experiments on multi-objective benchmarks and standard RL tasks demonstrate that the performance-interpretability trade-off varies with task complexity: simple control tasks achieve over 98% performance retention with 83% on the composite proxy metric, whereas complex locomotion tasks retain 87% performance with 69% on the proxy metric. Our method achieves higher hypervolume compared to weighted sum scalarization approaches. The framework enables deliberate navigation of the interpretability-performance space, where policies can be selected based on deployment constraints instead of choosing between black-box solutions or severely degraded alternatives.}
}
@article{ZHANG2026115505,
title = {A knowledge-driven collaborative discrete Jaya algorithm for energy-efficient multi-robot task allocation and scheduling problem},
journal = {Applied Soft Computing},
volume = {201},
pages = {115505},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115505},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009531},
author = {Hui Zhang and Quanke Pan and Wei Zhang and Zhonghua Miao and Bo Zhu},
keywords = {Energy-efficient scheduling, Multi-robot task allocation, Jaya algorithm, Knowledge-driven neighborhood operators},
abstract = {With the increasing deployment of intelligent and unmanned technologies in smart farming, energy-efficient multi-robot task allocation and scheduling has become a critical challenge. This paper investigates the energy-efficient multi-robot task allocation and scheduling problem (EE-MRTASP), aiming to simultaneously minimize task completion time and total energy consumption. A knowledge-driven collaborative discrete Jaya algorithm (KC-DJaya) is proposed, incorporating a collaborative initialization strategy for generating high-quality initial solutions, a discrete Jaya update mechanism, and five knowledge-driven neighborhood operators to enhance local refinement and global search balance. Extensive experiments are conducted on benchmark instances with task scales ranging from 30 to 100 and robot numbers ranging from 2 to 7. Compared with seven state-of-the-art optimization algorithms, KC-DJaya consistently achieves the lowest inverted generational distance (IGD) and the highest hypervolume (HV) across all tested scales. In large-scale cases, IGD is reduced by approximately 30%-50% relative to most comparison algorithms, while HV improves by approximately 10%-25%. Statistical tests indicate significant performance differences in favor of KC-DJaya. Ablation studies show that removing any single neighborhood operator results in up to 40% IGD degradation and 25% HV reduction, validating their complementary contributions. These results demonstrate the robustness and scalability of KC-DJaya for large-scale EE-MRTASP.}
}
@article{WANG2026115477,
title = {A diffusion-based framework with transformer blocks for anomaly detection},
journal = {Applied Soft Computing},
volume = {201},
pages = {115477},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115477},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009257},
author = {Zhen Wang and Xiyue Tan and Jun Tan},
keywords = {Diffusion model, Anomaly detection, Feature, Feature extraction},
abstract = {Traditional reconstruction-based methods for anomaly detection struggle to achieve competitive performance compared to recent diffusion-based methods, and they suffer from parameter redundancy that leads to unnecessary computational costs. In this paper, we propose a novel framework called Diffusion-based framework with Transformer blocks for industrial Anomaly Detection(DTAD), which integrates a Vision Transformer with a diffusion model. Our framework consists of a pixel-level autoencoder, a Feature-Guided Modulation module connected to a transformer-based UNet-like diffusion network, and a domain-adapted feature extractor. First, the Feature-Guided Modulation module is designed to preserve specific details, including semantic information. Then, we introduce a Multi-scale Feature Fusion block with a Dense Feature Fusion module to integrate features from different layers and improve reconstruction quality. Finally, we propose a source-free domain adaptation method to fine-tune a pre-trained Convolutional Neural Network (CNN) without accessing source domain data, enhancing the accuracy of anomaly localization. Experiments are conducted on public datasets MVTec-AD and ViSA. Despite using fewer parameters, the proposed method achieves excellent performance on both benchmark datasets: it attains AUROC scores of 95.8% (pixel-level) and 99.8% (image-level) on MVTec-AD, and 99.0% (pixel-level) and 97.3% (image-level) on ViSA respectively. The experimental results demonstrate significantly superior performance compared to recent state-of-the-art methods. DTAD proposes a Source-Free Domain Adaptation (SFDA) strategy designed to bridge the domain gap between ImageNet pre-trained models and industrial texture data, eliminating the need for raw source domain data. Striking an optimal balance between detection accuracy, model complexity, and inference speed, this approach exhibits strong adaptability in label-free learning scenarios, highlighting its significant practical value for industrial anomaly detection. The related code will be made publicly available at: https://github.com/kiliaw669/DTAD.}
}
@article{JING2026115416,
title = {Enhancing wind power point and interval prediction via multivariate feature fusion and anomaly data processing},
journal = {Applied Soft Computing},
volume = {201},
pages = {115416},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115416},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008641},
author = {Chenghao Jing and Xueni Wang and Jianzhou Wang},
keywords = {Wind power prediction, Bidirectional long short-term memory network, TimesNet, Fast Fourier transform, Deep learning},
abstract = {Accurate wind power forecasting is essential for secure power system operation, reserve scheduling, and efficient integration of renewable energy. However, wind power time series exhibit strong nonlinearity, non-stationarity, and multi-scale periodicity, while existing methods often fail to jointly capture long-term dependencies and dominant temporal patterns, limiting their robustness in practical applications. This study proposes a hybrid SI-TimesNet-BiLSTM framework that integrates frequency-aware decomposition with bidirectional temporal modeling for multivariate wind power forecasting. The proposed model combines the multi-scale representation capability of TimesNet with the sequence modeling strength of BiLSTM, while incorporating exogenous meteorological variables through feature fusion. Extensive experiments on two offshore wind farms include performance comparison, ablation analysis, feature contribution evaluation, mechanism validation, generalization testing, probabilistic forecasting, and robustness assessment. Results show that the proposed method achieves an MAE of 0.617, improving accuracy by 7.08% over TimesNet and 8.18% over Transformer-based models. Feature fusion reduces prediction error by 27.58%, while probabilistic forecasting decreases prediction interval width by 14.75%, corresponding to a reduction in spinning reserve from 12.2 MW to 10.4 MW for a 200 MW wind farm. Robustness analysis further demonstrates that performance degradation remains within 10% under perturbations and noise conditions. These results indicate that the proposed framework improves both predictive accuracy and operational reliability, providing practical value for reserve optimization and economic dispatch in modern power systems.}
}
@article{LIU2026115481,
title = {Multi-scale multi-objective evolutionary neural architecture search considering model generalization for SDN performance prediction},
journal = {Applied Soft Computing},
volume = {201},
pages = {115481},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115481},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009294},
author = {Kexin Liu and Hong Zhao and Yifan Li and Jing Liu},
keywords = {Neural architecture search, Model generalization, Attention mechanism, Software-defined network},
abstract = {Network modeling is an essential component of network optimization, providing key tools for evaluating specific network performance. Currently, deep learning has been extensively utilized in evaluating network performance. However, current studies focus on using a single type of neural network for network modeling tasks, whose ability to extract diverse features is limited. Furthermore, these studies frequently employ the same model for datasets with diverse distributions, ultimately limiting the generalization capability of the model. To solve these problems, the neural architecture search technique is used to automatically explore a deep neural network with high generalization performance in this work, called the multi-scale multi-objective evolutionary neural architecture search (MS-MO-ENAS) algorithm. Specifically, a multi-scale search space (MS3) is constructed to enable the exploration of parameters at different scales within neural networks. Next, considering the impact of dataset distribution on network modeling tasks, a multi-scale genetic (MSG) strategy is proposed to thoroughly explore the designed search space. Finally, a distance-based attention generalization (DAG) strategy is proposed to ensure the stable prediction results, regardless of the data distributions. MS-MO-ENAS is applied to the NSFNET, and GBN datasets, and the outcomes obtained are compared with six other neural network models. Extensive experimental results demonstrate that the neural network searched by MS-MO-ENAS outperforms other models by approximately 50%.}
}
@article{YU2026115489,
title = {GraphShield: Spatiotemporal fusion for risk propagation containment in financial networks},
journal = {Applied Soft Computing},
volume = {201},
pages = {115489},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115489},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009373},
author = {Guanyuan Yu and Yijun Chen and Zhixi Li and Jun Wang},
keywords = {Financial risk contagion, Spatiotemporal modeling, Risk quantification, Key risk players},
abstract = {The modern financial system has evolved into highly interconnected networks, where local risks can escalate into widespread risks through bidirectional interactions between topological contagion and temporal memory effects. Existing methods fail to model such bidirectional interactions due to their unidirectional graph learning→time-series learning framework. Besides, new financial innovations continuously introduce concealed risks. To address these challenges, we propose GraphShield, a novel risk recognition and quantification framework with three core innovations: (a) A multi-layer fusion unit hierarchically models bidirectional interactions between network topology and time-varying risk patterns. (b) A risk detector employs deep spatiotemporal clustering to autonomously identify hidden risks such as gray rhino threats by leveraging their aggregation patterns across spatial and temporal domains. (c) A risk quantifier reveals risk pathways and critical nodes by analyzing impact coefficients, enabling targeted mitigation of key propagation nodes. Extensive experiments on two real-world and two open-source datasets demonstrate the superiority of our GraphShield in risk containment. It achieves average AUC improvements of 9.36%, 9.07%, and 9.38% at risk ratios of 1%, 5%, and 10%, respectively, outperforming state-of-the-art baseline models. Furthermore, in risk regulation simulations, removing the top 1% of critical nodes reduced risk by over 30% and 25%, respectively, on two real-world datasets, demonstrating the effectiveness of our method in identifying critical risk nodes and its potential to enhance financial stability.}
}
@article{KUANG2026115541,
title = {DS-YOLO: An improved oriented object detection model for joint localization of mature daylily fruits and stems in unstructured environments},
journal = {Applied Soft Computing},
volume = {201},
pages = {115541},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115541},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009890},
author = {Minqiu Kuang and Fangping Xie and Xuejie Zou and Bei Wu and Dawei Liu and Xiangjun Zou and Xu Li},
keywords = {Daylily harvesting, Oriented object detection, DS-YOLO, Picking point localization, Unstructured environment},
abstract = {Mechanized harvesting constitutes a pivotal advancement for facilitating the scalability and intelligent evolution of the daylily industry. The core technological challenge lies in the rapid and precise recognition and spatial localization of mature daylily fruits and their connecting stems, which serve as the harvesting points. However, intelligent harvesting in unstructured field environments confronts severe challenges. Mature buds exhibit slender morphologies and random growth postures, resulting in significant inter-target occlusion. Simultaneously, the pedicel, acting as the critical operation point for the robotic end-effector, is minute in size, with texture features highly indistinguishable from the background stems and foliage. Traditional Horizontal Bounding Box (HBB) detection methods fail to accurately characterize the geometric posture of such slender targets and introduce excessive background redundancy, rendering them incapable of providing reliable guidance for precise robotic grasping and cutting. Although existing generic Oriented Bounding Box (OBB) models can generate directional detection boxes, they typically suffer from complex network architectures and high computational overhead, hindering real-time inference on resource-constrained field mobile platforms.To address these issues, this paper proposes a high-performance oriented object detection network named DS-YOLO (Daylily-Stem YOLO). Built upon the state-of-the-art YOLOv11-OBB baseline architecture, the model integrates three targeted optimization strategies. First, a P6 large-scale detection layer is added to the original feature pyramid to expand the effective receptive field of the network, thereby mitigating feature truncation issues for large targets in close-range imagery. Second, a Lightweight Shared Convolutional Decoupled (LSCD) head is designed. This module reconstructs the decoupled head structure using parameter sharing and depthwise separable grouped convolutions, significantly reducing computational costs while ensuring regression precision for mature buds and pedicels. Finally, a C2f-BiLevel Routing Attention (C2BRA) module is proposed to replace the original C2PSA module. Through a dual-level routing mechanism, it realizes dynamic contextual feature filtering, enhancing the sparse perception capabilities of the network regarding minute pedicel features and suppressing background noise. Experimental results on a self-constructed Daylily-OBB dataset demonstrate that, compared to the baseline YOLOv11n-OBB, DS-YOLO achieves improvements of 1.8, 1.4, 1.6, 1.1, and 0.6 %age points in Precision, Recall, F1 score, mAP50, and mAP50–95, respectively. Its comprehensive performance significantly outperforms RT-DETR and other mainstream YOLO algorithms. This study provides a robust technical foundation for high-precision and high-efficiency visual perception and localization in automated daylily harvesting equipment.}
}
@article{KUMAR2026115523,
title = {An optimized multi-view deep ensemble for identifying anti-viral and anti-corona peptides},
journal = {Applied Soft Computing},
volume = {201},
pages = {115523},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115523},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009713},
author = {Aditya Kumar and Deepak Singh},
keywords = {Antiviral peptides identification, Anti-corona peptides identification, Bayesian optimization, Deep ensemble model, Multiview learning},
abstract = {Viruses have been one of the most severe threats to human health since ancient times. Although new drug candidates are discovered and designed, continuous efforts are needed to discover new techniques to fight against viruses. Antiviral peptides are molecules with biological activity and a favorable toxicity profile, making them excellent alternatives for treating viral infections. Recently, different intelligent computational techniques have been implemented to predict antiviral activities. Despite advances, existing techniques have a vast scope for significant improvement. Therefore, this article proposes a novel optimized multi-view deep ensemble model to predict antiviral activity. Firstly, to achieve the multi-views, various amino acid feature encodings are used. Then, we systematically classify these encoding techniques into three groups based on their information source and information extraction methodologies, and each group is considered as a view. These views are formed from sequence composition, physicochemical properties with sequence encoding, and evolutionary features. Next, the proposed model is constructed using 51 branch classifiers from 9 CNNs. The Bayesian optimizer is employed to optimize the search space 251−1 formed by fifty-one branch CNNs and three views. The Bayesian optimizer is encoded with 0–1 bit-strings to determine the optimal ensemble. The proposed model with an optimal view-classifier pair improves antiviral classification performance. It surpasses the state-of-the-art techniques with a classification accuracy of 96.03%, an F1-measure of 94.38, and an AUC of 0.978 on the benchmark antiviral and anti-corona peptide dataset. Lastly, the performance of the proposed ensemble is considered as evidence of its effectiveness in predicting peptide antiviral activity.}
}
@article{RUAN2026115495,
title = {Fusion prediction and mechanism interpretation of fine-grained soil shear strength parameters based on CNN-BiLSTM-Attention},
journal = {Applied Soft Computing},
volume = {201},
pages = {115495},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115495},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009439},
author = {Bin Ruan and Xiaochi Zhang and Zhenglong Zhou and Xiaoxing Hong},
keywords = {Fine-grained soil, Cohesion, Internal friction angle, CNN-BiLSTM-Attention, Deep learning},
abstract = {Accurate prediction of soil shear strength parameters is crucial for stability analysis in geotechnical engineering. To address issues in traditional prediction methods such as single data sources, overlooked parameter coupling, and insufficient model generalization, this study proposes a multi-input-multi-output deep learning model integrating CNN, BiLSTM, and Attention mechanisms for the joint high-precision prediction of cohesion and internal friction angle. Utilizing 590 direct shear test datasets from the Nantong region (350 unconsolidated undrained and 240 consolidated undrained), the model is optimized using the Adam algorithm and a joint mean squared error loss. Five fold cross validation, dynamic learning rate decay, and early stopping ensure strict statistical robustness. The proposed architecture achieves exceptional joint predictive performance with an overall R2 of approximately 0.915 on validation sets, significantly outperforming traditional baselines and demonstrating strong generalization across varying consolidation conditions. Feature importance analysis and SHAP value interpretation reveal the nonlinear influence mechanisms of physical indicators such as plasticity index and liquid limit on shear strength parameters. The research outcomes provide a novel approach for predicting geotechnical engineering parameters and hold practical significance for engineering stability evaluation.}
}
@article{CHEN2026115507,
title = {LRIRNet: A lightweight and real-time infrared small target detection network based on multi-cue},
journal = {Applied Soft Computing},
volume = {201},
pages = {115507},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115507},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009555},
author = {Han Chen and Ziqiang Cao and Jinpeng Lu and Jun Tang and Fei Sun and Yangyang Guo},
keywords = {IRSTD, Multi-cue, Edge information, Global features, Drift training},
abstract = {Infrared small target detection (IRSTD) aims to localize dim and small targets from complex backgrounds, which plays an important role in various applications such as traffic management and marine rescue. However, infrared small targets are easily submerged in complex background interference due to their low signal-to-clutter ratio (SCR) and low contrast, making IRSTD a very challenging task. In this study, we model the target detection task as a process of extracting and fusing target multi-cues, including appearance cue, semantic cue and edge cue, and accordingly design a novel lightweight and real-time infrared small target detection network based on multi-cue (LRIRNet). Specifically, we design an edge network (Edge Net) and a semantic network (Semantic Net) to strengthen the edge cues and semantic cues of small targets in LRIRNet, respectively. With the aid of high-frequency extraction module (HFEM), Edge Net factorizes and aggregates features across different levels, while reducing low-frequency redundancy and refining the shapes of small targets through detailed edge information extraction. Semantic Net improves the localization performance of small target positions through information fusion across different backbone layers, thereby achieving balanced local and global feature extraction. Moreover, we introduce a smooth drift training strategy to mitigate the overfitting issue stemming from extreme imbalance between targets and backgrounds. This strategy enables the learning rate to smoothly oscillate in a periodic cosine pattern, leading to a gradual decrease in training loss. Extensive experiments on NUAA-SIRST, NUDT-SIRST and IRSTD-1k demonstrate that our method achieves state-of-the-art (SOTA) performance while having the advantage of competitive inference speed. Our code will be released publicly at https://github.com/ChenHan-AnHui/LRIRNet.}
}
@article{GAO2026115531,
title = {BODIO: A bit-oriented distance-iterated optimizer for key search with bitwise linear leakage},
journal = {Applied Soft Computing},
volume = {201},
pages = {115531},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115531},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009798},
author = {Ting Gao and Xuyang Chen and Yuanxing Liu and An Wang},
keywords = {Binary optimization problems, Swarm intelligence, Security, Side-channel analysis, Grey wolf optimizer, Differential evolution},
abstract = {Key search with bitwise linear leakage aims to identify the unique key that enables correct encryption in block ciphers whose hardware implementations exhibit bitwise linear leakage. This problem is challenging due to the discrete and large-scale search space, and the presence of substantial physical noise. Existing approaches typically combine correlation power analysis with heuristic algorithms to improve search efficiency, but they suffer from three main limitations: susceptibility to local optima due to noise-induced bias, misalignment with bit-level leakage characteristics, and high human and computational cost due to complex operator design and hyperparameter tuning. To address these challenges, the key search problem under bitwise linear leakage is reformulated as a binary optimization problem, and a bit-oriented optimization paradigm is introduced to explicitly align the search process with bit-level leakage characteristics. Based on this formulation, BODIO, a Bit-Oriented Distance-Iterated Optimizer inspired by the grey wolf optimizer, is proposed. BODIO mitigates noise-induced search bias through hierarchical guidance, preserves population diversity via an individual diversifier, and employs a one-bit-flip mechanism for precise refinement, thereby improving robustness and reducing the risk of premature convergence. Moreover, BODIO adopts a fully distance-iterated structure with fewer hyperparameters and improved structural extensibility. Simulation and Field-Programmable Gate Array (FPGA) experiments demonstrate that BODIO reduces the required number of power traces by 25.6% in simulation and 11.6% in FPGA experiments compared with the state-of-the-art method, while maintaining a 90% success rate and achieving competitive runtime performance, demonstrating its effectiveness and robustness.}
}
@article{ALTABRAWEE2026115434,
title = {ISTCLR: Improved sparse temporal contrastive learning for video representation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115434},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115434},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008823},
author = {Hussein Altabrawee and Mohd Halim {Mohd Noor}},
keywords = {STCLR, Self-supervised learning, Visual representation learning, Action recognition},
abstract = {Learning temporally distinctive visual representations is vital for video understanding. In our prior work, the STCLR framework was presented for enforcing temporal distinctiveness. The STCLR relies on the sparse local-local temporal contrastive loss and the Same Speed Localization (SSL) temporal pretext for learning temporal features. However, the STCLR employs a singular temporal pretext task. Optimizing multiple temporal pretexts is crucial because it enables capturing temporal features that represent video dynamics during the early phases of training and provides complementary gradient directions, which are important for avoiding poor local minima, stabilizing and speeding up contrastive optimization. Furthermore, it provides diverse and complementary supervisory signals that increase the difficulty and challenge of the self-supervised objectives, motivating the model to capture a wider range of temporal cues, leading to richer and more generalizable video representations. To address these limitations, we propose integrating the STCLR with our prior temporal pretext, Repeated Scene Localization (RSL), into a cohesive framework termed Improved STCLR (ISTCLR) for enforcing temporal distinctiveness. We found that RSL improves the performance of the STCLR on action recognition and video retrieval. The ISTCLR outperforms STCLR on action recognition by 1.07%, 1.37%, and 0.48% on UCF-101, HMDB-51, and Diving-48, respectively. On video retrieval, ISTCLR outperforms STCLR by 0.85%, 0.74%, 1.17%, and 1.59% on UCF-101 and by 1.18%, 0.53%, 1.05%, and 0.79% on HMDB-51. In multi-label action recognition on Charades, the ISTCLR outperforms other self-supervised approaches by 2.49%, which proves its effectiveness in long-range temporal modeling.}
}
@article{RAIHAN2026115463,
title = {CA-SMART: An active learning framework for accelerating materials discovery under resource constraints},
journal = {Applied Soft Computing},
volume = {201},
pages = {115463},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115463},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009117},
author = {Ahmed Shoyeb Raihan and Zhichao Liu and Tanveer Hossain Bhuiyan and Imtiaz Ahmed},
keywords = {Materials discovery, Active learning, Gaussian process, Bayesian optimization, Exploration-exploitation balance, Surprise-based acquisition},
abstract = {Accelerating the discovery and manufacturing of advanced materials remains a critical yet formidable challenge due to vast design spaces, costly experiments, and limited data. Traditional machine learning models are ill-equipped for this setting since they cannot decide which experiment to run next, preventing them from efficiently allocating scarce experimental resources. Active learning, when framed through the lens of Bayesian optimization, addresses this limitation by pairing a surrogate model with an acquisition rule that adaptively selects informative experiments under a fixed experimental budget. Classical acquisition functions have shown promise, but they struggle to balance exploration and exploitation in low-data, high-uncertainty regimes and are sensitive to hand-tuned hyperparameters. Within this context, the concept of surprise in active learning, which measures the divergence between expected and observed outcomes, offers strong potential for refining predictive models and prioritizing informative samples. However, existing surprise metrics often overlook model confidence, leading to inefficient exploration in uncertain areas. We address this by introducing the Confidence-Adjusted Surprise (CAS) metric, which incorporates predictive confidence to measure both the magnitude and reliability of observed surprises. CAS selectively emphasizes surprises in regions where the model is confident, while discounting those in highly uncertain areas. We embed CAS into a Bayesian active learning framework, CA-SMART (Confidence-Adjusted Surprise Measure for Active Resourceful Trials), which sequentially selects informative experiments under a limited budget by combining posterior-based surprise detection, local verification of surprising observations, and global Sobol–maximin exploration. We evaluate CA-SMART on synthetic benchmark functions, a real-world case study on fatigue strength prediction, and an additional end-milling surface roughness dataset. Across these tasks, CA-SMART consistently outperforms conventional Bayesian optimization rules, prior surprise-based methods, and standard machine learning baselines in terms of predictive accuracy, convergence speed, and sample efficiency. Noise and sensitivity analyses further show that CA-SMART maintains competitive performance across a range of training-label noise settings, kernel choices, and design budgets. CA-SMART provides a foundation for making experimental design more efficient in data-scarce settings, advancing the broader vision of autonomous and data-driven discovery in the era of Industry 5.0.}
}
@article{BOUKHLIFA2026115515,
title = {A lightweight CNN supported by partially skip-connected CAE for plant disease identification across multiple agricultural environments},
journal = {Applied Soft Computing},
volume = {201},
pages = {115515},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115515},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009634},
author = {Ghania Boukhlifa and Youcef Chibani},
keywords = {Agriculture environments, Plant disease identification, Convolutional neural networks, Convolutional autoencoder, Skip connection, Feature extraction, Lightweight architecture},
abstract = {The increasing global population calls for sustainable agricultural solutions, including automated plant disease identification. Presently, Convolutional Neural Networks (CNNs) require complex architectures and large labeled datasets, relying on transfer learning and data augmentation, particularly in uncontrolled field conditions. Moreover, models trained in controlled environments often surpass those trained in uncontrolled settings due to background variability. To address these challenges, a lightweight CNN architecture supported by the Convolutional Autoencoder (CAE) is proposed capable of operating in both controlled and uncontrolled environments. The CAE model, composed of the encoder and the decoder, optimizes feature extraction with fewer data samples and convolutional layers. The encoder serves as a feature extractor, while an external classification branch uses a fully connected layer with softmax activation to predict class labels. To enhance the reconstruction and feature extraction, a partially skip-connected architecture is added between the encoder and the decoder of the CAE. During training, a combined loss function is integrated to optimize both reconstruction and classification losses, simultaneously. During inference, only the encoder and classification branch are retained, reducing complexity. The system is evaluated across intra-domain, cross-domain, and mixed-domain settings using datasets from various environments. A high accuracy is achieved in controlled conditions (97.05% on PlantVillage, 98% on Citrus, 97.6% on PLD) and demonstrates adaptability in uncontrolled environments (95.14% on Bean, 29.14% on PlantDoc, 81.98% on FieldPlant) without dataset-specific tuning or transfer learning. The full architecture used during training contains approximately 0.72M parameters, while inference requires only 0.30M parameters, making it suitable for deployment on resource-constrained devices.}
}
@article{CARVAJAL2026115518,
title = {Sustainability and corporate valuation: A machine learning approach},
journal = {Applied Soft Computing},
volume = {201},
pages = {115518},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115518},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600966X},
author = {Valeria Carvajal and Werner Kristjanpoller and Marcel C. Minutolo},
keywords = {ESG (Environmental, social, and governance), Corporate valuation, Tobin’s Q, Financial performance, Machine learning, Convolutional neural networks (CNN), LIME (Local interpretable model-agnostic explanations), Sustainable finance, Predictive modeling, Deep learning, Firm segmentation, Market perception, Non-linear financial models, Stakeholder theory},
abstract = {The connection between environmental, social, and governance (ESG) factors and market valuation remains a subject of intense debate in the financial realm. This study tackles the complexity of this relationship by utilizing Convolutional Neural Networks (CNN) and the Local Interpretable Model-agnostic Explanations (LIME) method, merging the power of deep learning with interpretability for more accurate assessment. Through an analysis of S&P 500 companies from 2013 to 2023, patterns are identified that challenge traditional approaches, revealing how market capitalization and revenue influence the impact of ESG on corporate valuation. The findings herein suggest that the relationship between ESG and financial performance is not homogeneous, varying with respect to the size of the company. Furthermore, certain segments may benefit more from the adoption of these practices, while others face differentiated effects. By breaking away from the limitations of conventional models and integrating financial metrics into advanced models, dynamics previously unnoticed are captured, offering a more granular perspective on how the market responds to sustainability efforts. The combination of advanced machine learning techniques not only enhances the accuracy of the analysis but also opens new opportunities to understand the strategic value of ESG.}
}
@article{HOU2026115468,
title = {Multimodal multi-objective ant colony optimization based on ecological niche comprehensive evaluation indicators},
journal = {Applied Soft Computing},
volume = {201},
pages = {115468},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115468},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009166},
author = {Ying Hou and Jisu Wang and Honggui Han and Jingjing Wang},
keywords = {Multimodal multi-objective optimization, Ant colony optimization, Enhanced special crowding distance, Ecological niche comprehensive evaluation indicators},
abstract = {Multimodal multi-objective optimization aims to simultaneously find multiple feasible solutions for complex optimization problems. However, the number of feasible solutions obtained is limited, as multimodal multi-objective optimization methods place excessive emphasis on convergence. Therefore, it is necessary to preserve the solutions with good diversity while considering convergence, so as to provide more feasible solutions. A multimodal multi-objective ant colony optimization based on ecological niche comprehensive evaluation indicators (MMOAC_ENCEI) is designed to seek a greater number of feasible solutions. Firstly, an enhanced special crowding distance, considering the decision space and the objective space crowding distance, is designed. The decision space and objective space crowding distance are computed using local density information, reflecting the correlation between a solution and its surrounding solutions. Secondly, a corresponding pheromone update mechanism is set up for the ecological niche to achieve deep search and optimization, thereby improving the diversity of solutions. The ecological niche evaluation indicators of solutions are determined based on the Pareto rank and the enhanced special crowding distance of the solutions. Finally, a heuristic pheromone dynamic adjustment mechanism based on ecological niche comprehensive evaluation indicators is established. In the early stages, enhanced special crowding distance weights within the ecological niche comprehensive evaluation indicators are larger to explore globally. While in the later stages, Pareto rank weights within the ecological niche comprehensive evaluation indicators are larger to accelerate convergence. The experimental results show that the proposed algorithm can find more feasible solutions for complex optimization problems.}
}
@article{SUN2026115562,
title = {HPFA: A hybrid perception and feature attention framework for multimodal sentiment analysis with missing modalities},
journal = {Applied Soft Computing},
volume = {201},
pages = {115562},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115562},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010100},
author = {Yu Sun and Bin Gao and Linlin Li and Yutong Li and Shutian Liu and Zhengjun Liu},
keywords = {Multimodal sentiment analysis, Missing modalities, Cross-modal interactions, Transformer},
abstract = {Multimodal Sentiment Analysis (MSA) predominantly assumes the availability of complete multimodal data. However, in real-world scenarios, missing modalities are inevitable due to sensor errors or data corruption. Conventional methods relying on complete-data assumptions suffer from significant performance degradation and reduced robustness under these conditions. To address this challenge, we propose a Hybrid Perception and Feature Attention (HPFA) framework. Drawing inspiration from human cognitive mechanisms for handling incomplete information, this framework incorporates two primary modules. The first, DynaSynapse Fusion (DSF), adopts a modality-specific strategy that prioritizes interactions between the language modality and auxiliary (visual and audio) modalities, followed by unimodal enhancement to maximize the utility of available features. The second, the Cyclic Cross-Modal Recoverer (CCR), progressively reconstructs missing modalities via three cascaded reconstruction units. Each unit comprises a Transformer layer to capture global dependencies among multimodal features and a Spatial-Updating and Normalization (SUN) module to facilitate fine-grained cross-modal interactions, thereby enabling stepwise reconstruction of missing modality information. Extensive experiments on three public benchmarks demonstrate that HPFA consistently achieves superior performance and robustness across various missing data conditions, establishing it as an effective solution for MSA in realistic, incomplete-data scenarios.}
}
@article{ZHANG2026115476,
title = {Research on beamforming offloading resource allocation based on deep reinforcement learning and ISAC in autonomous vehicle scenarios},
journal = {Applied Soft Computing},
volume = {201},
pages = {115476},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115476},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009245},
author = {Han Zhang and Jianbin Xue and Qingda Yu},
keywords = {VEC, Mobile edge computing, Data offloading, Wireless communication, ISAC},
abstract = {Under the development of 5G-A/6G and intelligent transportation, jointly designing integrated sensing and communication (ISAC) and mobile edge computing (MEC) is important for efficient vehicular edge computing (VEC). Most existing works treat ISAC design and task offloading separately, which makes it difficult to balance sensing reliability and computation latency in dynamic vehicular scenarios. This paper considers a full-duplex ISAC–VEC system with uplink–downlink coupling and formulates a delay minimization problem under a sensing SNR constraint. The receive beamformers are derived using generalized Rayleigh quotient structures, and the remaining resource and offloading decisions are optimized via an RQ-assisted deep deterministic policy gradient (RQ-DDPG) algorithm to improve learning stability in our setting. Simulation results show that the proposed approach achieves lower task latency while maintaining the required sensing performance compared with the considered benchmark schemes.}
}
@article{DING2026115528,
title = {A novel method of fire prevention and control measures allocation for aircraft hot surface zone based on improved fuzzy TOPSIS and multi-objective optimization},
journal = {Applied Soft Computing},
volume = {201},
pages = {115528},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115528},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009762},
author = {Long Ding and Qianqian Cui and Jie Ji and Wenjie Xu and Jin Wang and Xin Li},
keywords = {Aircraft fuel leakage, Hot surface, Prevention and control measure allocation, Improved FTOPSIS, Multi-objective optimization model},
abstract = {In aircraft, fire risk resulting from fuel leakage onto hot surfaces is significant. Fire prevention and control measures play an important role in reducing the fire risk. However, currently, the allocation of fire prevention and control measures lacks scientific and quantitative guidance. This paper proposes a novel methodology to optimize the allocation of fire prevention and control measures in potential risk zones with hot surface fuel leakage. Firstly, a set of evaluation criteria is established based on literature research and the integration of expert opinions. Based on the evaluation criteria, an improved Fuzzy Technique for Order Preference by Similarity to Ideal Solution (FTOPSIS) is proposed to prioritize fire prevention and control measures. By combining Mahalanobis distance and grey relational analysis, the improved FTOPSIS can overcome the limitation of traditional TOPSIS which may lead to the same priority results. In addition, fuzzy mathematics is used to reduce cognitive uncertainty in decision-making. Subsequently, a multi-objective optimization model is developed based on the priority ranking of the measures. The model determines the optimal allocation strategy by maximizing the scores of prevention and control measures under the budget and required measures. Case studies are conducted for the wing, equipment cabin, and wheel well. For example, in the equipment cabin, isolation, separation, ventilation, and drainage will be given priority when the budget is 0.28 M$; flame retardant material and fire detection will be added at 0.56 M$; all measures can be equipped at 0.7 M$. This proposed methodology can serve as a decision-support tool for allocating fire prevention and control measures in the aircraft hot surface zones.}
}
@article{LU2026115500,
title = {Dynamic attention graph-guided and sensitivity-aware substitution for black-box adversarial text generation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115500},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115500},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009488},
author = {Yu Lu and Lei Shi and Lin Wei and Yucheng Shi and Yufei Gao},
keywords = {Adversarial attacks, Black-box attacks, Natural language processing, Textual adversarial examples},
abstract = {While deep learning models have achieved strong performance in text classification, their susceptibility to adversarial attacks in realistic black-box scenarios poses significant security risks. Generating adversarial texts that are effective yet linguistically coherent remains a critical challenge. To address this issue, we propose a two-stage framework for black-box adversarial text generation. In the first stage, we estimate token salience using a query-free structural signal derived from a dynamic attention graph, and then fuse it with a small number of target-model sensitivity queries to obtain a robust token ranking. This ranking prioritizes tokens that are both structurally salient in the sentence and influential in changing the target prediction. In the second stage, we employ word transformation methods, particularly substitution and insertion. A key innovation is the model-aware substitution strategy, which combines candidate words’ linguistic plausibility from Masked Language Models (MLM) with sensitivity estimates from querying the target classifier. On four benchmarks, our method attains competitive attack success across classifiers. On AG News, it also achieves the best semantic quality, with a USE similarity score of 0.93 and the lowest APPL value of 31.48, demonstrating a favorable trade-off between effectiveness, efficiency, and fluency.}
}
@article{TUNGA2026115439,
title = {Sustainable profit-maximized vehicle routing under capacity and time constraints: A multi-objective metaheuristic framework},
journal = {Applied Soft Computing},
volume = {201},
pages = {115439},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115439},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008872},
author = {Harinandan Tunga and Samarjit Kar and Monika Singh},
keywords = {Profit Maximization, Sustainable vehicle routing, Hybrid Metaheuristic, NSGA-II, Multi-objective Particle swarm optimization, Carbon emission reduction, Pareto front convergence, Operational sustainability},
abstract = {As urban logistics networks expand, there is a growing need for routing methods that are both cost-effective and environmentally sustainable. This study proposes the Sustainable Profit-Maximizing Vehicle Routing Problem (SPMVRP), a multi-objective model that aims to maximize operational profit while minimizing travel time. The model incorporates practical constraints such as vehicle capacity, service time, and carbon emissions. Unlike traditional routing models that focus on either cost or emissions, this framework integrates both economic and environmental objectives into a unified approach for sustainable logistics planning. To solve this intricate optimization problem, a hybrid metaheuristic algorithm is developed by combining Multi-Objective Particle Swarm Optimization (MOPSO) and Non-dominated Sorting Genetic Algorithm II (NSGA-II). This hybrid method balances exploration and exploitation by using the fast convergence of MOPSO and the diversity-preserving ability of NSGA-II. The model is implemented in Python and tested on benchmark instances with 20, 50, and 100 customers. A real-world inspired case study based on an urban distribution network in Kolkata, India, is also considered. Results show that the hybrid approach outperforms individual algorithms, achieving 5–8% shorter travel times and 4–6% higher average profits while maintaining competitive emission levels. Statistical tests (p < 0.05) confirm the significance of these improvements, demonstrating the effectiveness of the proposed SPMVRP framework for sustainable urban logistics.}
}
@article{PRADANA2026115431,
title = {Carbon trading strategy in the European market based on risk analysis using deep stochastic reinforcement learning},
journal = {Applied Soft Computing},
volume = {201},
pages = {115431},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115431},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008793},
author = {Yan Aditya Pradana and Mohammad Isa Irawan and Imam Mukhlash and Endah Rokhmati Merdika Putri},
keywords = {Deep reinforcement learning, Risk sensitive learning, Carbon trading, European market, Stochastic volatility modeling, Soft actor critic, Financial risk management},
abstract = {Carbon markets play a crucial role in reducing greenhouse gas emissions, but their high volatility, tail-risk exposure, and liquidity uncertainty represent major challenges for developing robust trading strategies. Most of the existing works are focused on stochastic price modeling, risk measurement, and reinforcement learning, respectively, which makes it difficult to create a unified and adaptive decision-making framework. In this work, we propose a Deep Stochastic Reinforcement Learning (DSRL) framework that integrates stochastic price modeling, deep temporal learning, and risk-sensitive optimization. The carbon prices are modeled by a geometric Brownian motion with LSTM-based volatility estimation, and trading decisions are optimized by a risk-sensitive soft actor-critic (RSAC) algorithm. The framework directly embeds the Value-at-Risk (VaR), Conditional Value-at-Risk (CVaR), and liquidity constraints in the reward function to optimize the return and downside risk. Empirical results on European carbon markets (GRN, CFI2Z, and KEUA) show that the proposed model consistently outperforms both classical and deep reinforcement learning baselines, achieving up to 16.893% ROI in high-volatility markets while maintaining superior risk-adjusted performance and lower drawdowns. The results also show that the combination of temporal learning with risk-sensitive optimization improves adaptability in non-stationary financial environments. This work presents a unified and scalable framework for risk-aware trading, providing practical insights for decision-making under uncertainty in complex carbon markets.}
}
@article{NISHANTH2026115496,
title = {A comparative study of optimization algorithms in physics-informed neural networks for singularly perturbed differential equations},
journal = {Applied Soft Computing},
volume = {201},
pages = {115496},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115496},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009440},
author = {J. Nishanth and Sekar Elango},
keywords = {Deep learning, Neural network, Activation function, Optimizer, Singularly perturbed differential equation},
abstract = {Differential Equations (DEs) are a versatile mathematical tool for tackling a myriad of real-world challenges. The resolution of such differential problems aids in the advancement of our human environment, prompting the exploration of various techniques and methods for solving these equations. This paper presents a new method employing deep learning principles to tackle differential equations, with a specific focus on real-world issues commonly modelled by Singularly Perturbed Differential Equations (SPDEs), such as those found in fluid mechanics and biosciences. Our approach involves solving these specific problems using neural networks, and employing feed-forward frameworks for their resolution. This paper not only focuses on solving the differential equations but also delves into the optimization process. In particular, we utilized the gradient descent algorithm as our optimizer, exploring five variants of this algorithm. Consequently, we investigate the considered SPDEs using a standard Physics-Informed Neural Network framework combined with five different gradient-based optimization algorithms and evaluated through five performance metrics. The numerical results demonstrate that certain optimization strategies exhibit superior accuracy, convergence behavior, and robustness in approximating the solutions of SPDEs. These findings suggest that the proposed comparative methodology provides useful guidance for selecting optimization algorithms and can be extended to a broad class of differential equations.}
}
@article{CHEN2026115553,
title = {Robust semi-supervised SAR ship detection under joint constraints of annotation scale and label quality},
journal = {Applied Soft Computing},
volume = {201},
pages = {115553},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115553},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601001X},
author = {Man Chen and Huaping Zhou and Kelei Sun and Antai Chen},
keywords = {Robust semi-supervised learning, Multiple instance learning, Label correction, Receptive field relaxation, Synthetic aperture radar},
abstract = {Synthetic aperture radar (SAR) ship detection is crucial in long-range ship positioning, port scheduling, and maritime search and rescue operations. However, existing SAR ship detection methods rely on large-scale, manually labeled samples for training and demand that these annotations be precise and high-quality, which may pose limitations in practical applications. This study focuses on the SAR ship detection task under constraints on both annotation scale and label quality, proposing a robust semi-supervised object detection framework with label correction and receptive field relaxation, called LCRR-Det. This framework primarily consists of a label correction unit and a semi-supervised learning unit, capable of effectively correcting data with imprecise annotations by multiple instance learning (MIL) while also achieving efficient semi-supervised learning using the corrected data along with a large amount of unlabeled data. Furthermore, we introduce two additional designs in the semi-supervised learning unit: SAR specificity enhancement and decoupled training, aimed at improving its adaptability to SAR data and its capability for bounding box localization. Finally, a receptive field relaxation (RFR) strategy is proposed to fully utilize broader contextual information within images to enhance the network’s perceptual performance, further improving adaptability to noise in supervision signals and background interference in SAR images. Experimental results demonstrate that the proposed framework successfully reduces dependence on large-scale annotations while maintaining strong robustness to label noise.}
}
@article{XI2026115480,
title = {A lightweight YOLO-based framework for tennis ball detection and recycling on an AI-based recycling platform},
journal = {Applied Soft Computing},
volume = {201},
pages = {115480},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115480},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009282},
author = {Bai Xi},
keywords = {AI technology, Attention mechanism, Lightweight tennis detection algorithm, Tennis ball recycling, Tennis detection},
abstract = {Frequent use of tennis balls inevitably leads to physical wear and performance degradation, which ultimately compromises usability and contributes to environmental waste if not managed effectively. To extend the service life of tennis balls, minimize waste, and promote sustainability within the sports industry, this study investigates the integration of Artificial Intelligence (AI) into tennis detection and recycling workflows. Specifically, a synergistic framework is developed by leveraging attention mechanisms, lightweight architectures, and multi-task learning (MTL). First, a lightweight tennis detection algorithm, Attention Mechanism-You Only Look Once (AM-YOLO), is proposed. This model optimizes detection accuracy and real-time performance by integrating Coordinate Attention (CA) with Ghost residual blocks. Furthermore, it enhances feature extraction by incorporating a Swin Transformer module to dynamically weight spatial regions. Experimental results demonstrate that AM-YOLO achieves an mAP@0.5 improvement of 8.7% over the baseline YOLOv5s, while reducing the model size by 30.23%. With an inference speed of 18 ms, the model significantly outperforms existing lightweight detection methods. Second, the study introduces MTL-AM-YOLO, an MTL-based architecture designed for simultaneous detection and state classification. The results indicate that this approach effectively identifies defective tennis balls while maintaining high detection precision. In indoor hardcourt environments, the implementation of this framework improves the expiry reuse rate by 18.5%, extends the average lifespan from 9.0 to 11.3 games, and reduces overall usage costs by 12.7%. By precisely identifying and classifying tennis balls based on their physical condition and flight trajectory requirements, this study provides a robust technological foundation for improving quality assessment, extending product lifecycles, and reducing the economic burden of tennis participation.}
}