@article{HADDAD2026115742,
title = {BERTidRAAF for AI-driven recruitment: Rare-aware adaptive fusion of BERT-based context and IDF-weighted keywords for CV classification},
journal = {Applied Soft Computing},
volume = {202},
pages = {115742},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115742},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011907},
author = {Omar Haddad and Mohamed Nazih Omri},
keywords = {Resume classification, Natural language processing, BERT, IDF weighting, Rare-aware fusion, Recruitment automation, FairCVdb, Reproducible benchmarking},
abstract = {Resume classification is a demanding long-document problem because the target label is often determined by a small number of highly informative professional expressions, certifications, tools, and domain-specific job titles embedded in heterogeneous career narratives. Contextual transformers capture semantic regularities, whereas inverse document frequency (IDF) preserves the salience of rare terms; however, the two sources of evidence are often combined either before contextualization or through weak late fusion. This paper presents BERTidRAAF, a rare-aware adaptive fusion framework that injects training-corpus IDF evidence after BERT contextualization. The model aligns IDF scores with WordPiece tokens, computes contextual and IDF-weighted summaries, learns a gate between global and rare-term representations, combines complementary prediction heads, and selects the final decision policy on a validation split before held-out testing. The evaluation uses a 24-class Resume dataset with 1785/199/497 train/validation/test instances and an external binary FairCVdb setting with 17,280/1920/4800 instances. On Resume, BERTidRAAF reaches 85.71% accuracy, 0.8038 macro-F1, and 0.9802 macro-AUC, improving over the strongest baseline, BERTLARGE, by 3.22 percentage points in accuracy and 0.0443 macro-F1. On FairCVdb, it obtains 96.17% accuracy and 0.9617 macro-F1, slightly higher than BERTLARGE under the same protocol. The study also reports confidence intervals, per-class behavior, error pairs, close BERT-IDF ablations, validation-selected fusion details, and efficiency indicators. The results support the usefulness of post-contextual rare-term weighting for fine-grained resume classification while showing that this accuracy-oriented design increases computational cost. The complete reproducibility material is made available through the companion GitHub repository reported in the Data and Code Availability statement. The extended rare-term recovery diagnostic reports recall@5 = 0.7463 for the IDF branch, compared with 0.7007 for uniform weighting and 0.7183 for attention-based ranking, supporting improved sensitivity to discriminative rare professional terms under the reported salience protocol.}
}
@article{ZHENGYE2026115726,
title = {MCLA: A self-supervised learning-powered lightweight multi-scale convolutional linear attention framework for unknown attack detection in maritime IoT intrusion detection systems},
journal = {Applied Soft Computing},
volume = {202},
pages = {115726},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115726},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011749},
author = {Li Zhengye and Duan Jinyu and Bai Yuge and Tong Jianheng},
keywords = {Maritime internet of things (MIoT), Intrusion detection systems (IDS), Self-supervised learning, Attention mechanism, Multi-scale information fusion},
abstract = {The in-depth application of Maritime Internet of Things (MIoT) in vital scenarios such as ship navigation, engine room monitoring, and port scheduling makes its security an important requirement for maritime safety. However, MIoT faces challenges including, scarce labeled data, frequent unknown attacks, and edge device resource constraints; additionally, high-frequency electromagnetic noise interferes with existing Intrusion Detection Systems (IDS), impeding their ability to balance real-time performance and detection accuracy. To tackle these challenges, we propose a lightweight self-supervised MIoT intrusion detection architecture, termed Multi-scale Convolutional Linear Attention (MCLA), for unknown-anomaly-oriented detection under maritime deployment constraints. First, leveraging the multivariate time-series property of MIoT traffic, we propose a lightweight Time-Frequency-Variable (TFV) Attention, which utilizes Fast Fourier Transform (FFT) to transform time-domain data into the frequency domain and jointly models temporal, spectral, and variable information via dilated convolution to improve feature extraction under noisy maritime environments. Second, Decay-based Linear Attention is introduced to linearize traditional self-attention, and establish models for long-term temporal dependencies via a recent-weighted, distant-weakened decay strategy, cutting computational complexity while boosting long-range information extraction. Finally, using self-supervised reconstruction, the method is trained exclusively on normal maritime traffic data, adapting to unlabeled scenarios. Experiments on the CIC-IoT 2023, CIC-UNSW-NB15, and CIC-IoV 2024 datasets show that MCLA achieves effective detection performance and efficiency for unknown attacks under a normal-only training protocol.}
}
@article{LU2026115750,
title = {A constrained reinforcement learning approach for strict constraint task planning on lunar rovers with uncertain time and resource consumption},
journal = {Applied Soft Computing},
volume = {202},
pages = {115750},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115750},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011981},
author = {Siyao Lu and Ai Gao and Jiamou Liu and Rui Xu and Libo Zhang and Zhaoyu Li and Bo Pan},
keywords = {Reinforcement learning, Task planning, Uncertainty, Lunar rover},
abstract = {The International Lunar Research Station will be established near the moon’s south pole through advanced unmanned rovers at the beginning. Given the region’s limited daylight and the inherent uncertainties in mobility and resource collection, traditional remote control methods prove inadequate. Moreover, assessing each rover’s time and resource consumption during operations is inappropriate due to the inherent uncertainties associated with mobility and material collection. This is compounded by the complexities involved in optimizing these activities. We have selected to solve the problem with reinforcement learning (RL) because it can tackle uncertainty and optimization. To ensure the safety of time and resources on the rovers, we propose a constrained reinforcement learning approach to generate safe actions while adhering to critical constraints to time and resources and applying optimizations on time consumption. To solve the task planning problem with time and resource constraints and uncertainty, we demonstrate a new Markov Decision Process (MDP) to illustrate the states, constraints, uncertainties, and the decision amount on actions. The novelty of our method lies in a three-level progressive constraint and uncertainty handling mechanism: the action mask for hard feasibility constraints, the Lagrangian method for redundancy, and rewards with penalties providing experience against uncertainty. These guarantee safety and peak reduction in consumption on rovers. Experiments show that the reinforcement learning planner can complete task planning, significantly outperforming baseline methods, even with an exceeded target without violating any constraints. Moreover, our planner can plan within seconds. In contrast, the Expressive Numeric Heuristic Search Planner cannot solve the original problem without uncertainty in 1h. Still, our approach can solve the simplified problem with 99.82% less time consumption than the planner above, whose plan also consumes twice the time and resources. This research enhances the efficiency and safety of rover task planning and contributes to developing autonomous lunar base construction and further exploration tasks.}
}
@article{CEN2026115795,
title = {Enhancing neural network explainability via event causal graphs for bottleneck prediction in production systems},
journal = {Applied Soft Computing},
volume = {202},
pages = {115795},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115795},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012433},
author = {Weihong Cen and Lie Yang and Chupeng Su and Gang Chen and Longhan Xie},
keywords = {Bottleneck prediction, Production system, Bottleneck spatio-temporal neural network with event causal graph, Graph neural network, Transformer},
abstract = {Bottleneck prediction is essential for improving throughput in production systems and is a key research focus. However, the dynamic nature of bottleneck locations, driven by complex and evolving production environments, presents significant challenges in this field. Existing methods often struggle to capture the intricate relationships among influencing factors, leading to limited interpretability and predictive accuracy. To address these issues, we propose an Event causal graph-based spatial-temporal neural network (ECGBSTNN) for bottleneck prediction. This approach represents machine operations and buffer states as event nodes, integrating expert knowledge to construct causal links, forming a dynamic, event-level causal graph. In addition, a weight matrix quantifies uncertain causal relationships, facilitating adaptive and interpretable causal weighting for bottleneck prediction. By integrating a Graph Neural Network (GNN) with a Transformer-based architecture, ECGBSTNN captures both causal and temporal dependencies among events to predict future blockage and starvation times which are leveraged to identify potential bottlenecks. Experiments on a production system demonstrate that ECGBSTNN outperforms state-of-the-art methods, for blockage prediction, while providing enhanced interpretability and practical applicability.}
}
@article{HE2026115790,
title = {A near-real-time adaptive framework for ground motion prediction using incremental gradient boosting},
journal = {Applied Soft Computing},
volume = {202},
pages = {115790},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115790},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601238X},
author = {Jianguang He and Liqiang Jiang and Lizhong Jiang and Tianxing Wen and Chang He},
keywords = {Ground motion prediction, Incremental learning, Machine learning, Seismic hazard, Rapid adaptation, Data drift},
abstract = {Accurate near-real-time ground motion prediction is critical for rapid post-earthquake impact assessment and emergency response, yet existing models face a trade-off between the event-specific fidelity of empirical equations and the timeliness of physics-based simulations. This study advances beyond static machine learning models by proposing a drift-aware adaptive framework for ground motion prediction models (GMPMs). This framework dynamically integrates new seismic data without requiring immediate full retraining. We develop two incremental learning strategies: leaf refinement for recalibrating site-response logic under mild concept drift (e.g., routine events), and tree augmentation for capturing out-of-distribution features (e.g., extreme magnitudes or near-source distances) through structural expansion. When evaluated across three realistic scenarios using residual analysis, spatial mapping, and interpretability tools, both strategies significantly outperformed static models and the full retraining baseline. Tree augmentation achieved up to a 64% reduction in mean squared error (MSE) and a 44% improvement in R2 in extreme-event scenarios, while leaf refinement yielded up to a 34% MSE reduction and a 52% R2 improvement under routine-event conditions. Both strategies significantly mitigated systematic prediction biases and exhibited predictable performance scaling (power-law for refinement; linear for augmentation) with increasing data volume. Crucially, the framework enables rapid generation of shaking maps that align with observational data while revealing richer, physically plausible spatial details. This near-real-time GMPM framework could support critical engineering decision-making and has the potential to enhance emergency response capabilities for protecting critical infrastructure.}
}
@article{THOTA2026115787,
title = {Hierarchical multi-type annotation fusion with uncertainty-aware cross-attention for chest X-ray classification},
journal = {Applied Soft Computing},
volume = {202},
pages = {115787},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115787},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012354},
author = {Sandeep Kumar Thota and Fayadh Alenezi and Kemal Polat and Adi Alhudhaif},
keywords = {Multi-source information fusion, Cross-attention, Uncertainty-aware gating, LLM-extracted annotations, Chest X-ray classification, Hierarchical fusion, Medical image analysis},
abstract = {Radiology reports contain rich diagnostic information beyond simple binary labels, including probability assessments, anatomical locations, and severity grades. Recent large language model annotation pipelines, such as MAPLEZ, automatically extract multiple annotation types, but current approaches integrate them via additive multi-task loss formulations that suffer from gradient interference and ignore the heterogeneous reliability of each annotation source. We address this gap by reframing multi-type clinical annotations as a multi-source information fusion problem and propose UFCA, a hierarchical fusion framework operating at three levels. At Level 1, multi-head cross-attention with uncertainty-aware gating fuses categorical labels, probability scores, location descriptions, and severity grades into a unified annotation embedding. At Level 2, spatial attention guided by anatomical priors and FiLM conditioning integrates this embedding with visual features. At Level 3, a pathology-adaptive weighting layer combines vision-only, annotation-conditioned, and annotation-only prediction branches. We evaluated UFCA on the NIH ChestX-ray14 dataset (112,120 images, 13 pathologies) using MAPLEZ annotations, with external validation on the Kermany pediatric pneumonia dataset and the IQ-OTH/NCCD lung CT dataset. UFCA achieved a macro-averaged AUROC of 0.838, an improvement of 2.3 %age points over MAPLEZ-MTL (p < 0.001, DeLong's test, Bonferroni-corrected). The largest gains are seen in rare pathologies, including fractures (+4.2 pp) and pneumonia (+3.9 pp). Severity annotations, previously reported as harmful under additive loss, contribute + 0.7 pp under the proposed fusion. The framework adds 11.7% parameters and 23% training time over the multi-task baseline.}
}
@article{ZHU2026115674,
title = {Adaptive transformer boosted by temporal distribution analysis for soft sensing of industrial processes},
journal = {Applied Soft Computing},
volume = {202},
pages = {115674},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115674},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011221},
author = {Feng Zhu and Yi Ding and Jianshe Feng and Lechang Yang and Lishuai Li and Min Xie},
keywords = {Adaptive soft sensor, Time series analysis, Virtual drift, Clustering, Transformer},
abstract = {Industrial soft sensors suffer from time-varying virtual drift, where the marginal distribution of process variables evolves over time while the input–output relationship remains approximately stable. Existing drift-robust methods are either reactive update schemes that ignore the cross-period distribution structure of historical data, or transfer-learning schemes that rely on observable target domains or predefined source domains, both of which are rarely available in evolving industrial processes. Motivated by domain generalization principles, this study proposes a two-stage temporal distribution analysis framework that advances prior work in both of its stages. It first uncovers latent temporal periods via Temporal Distribution Identification (TDI), and then learns period-invariant representations through an Adaptive Transformer trained via Temporal Distribution Matching (TDM). TDI formulates latent-domain discovery as a subset-selection clustering problem with an explicit temporal contiguity constraint, solved by an exact Dynamic Programming algorithm with a global-optimality guarantee in polynomial time. This simultaneously enforces within-period coherence, compactness, and temporal ordering, which classical change-point detection and conventional clustering do not jointly satisfy. Rather than introducing new architectural components, the Adaptive Transformer retains the standard Transformer backbone and realizes adaptation at the training-recipe level by operating on TDI-derived period-wise datasets and embedding a cross-period distribution-matching regularizer at encoder hidden states across layers and time steps, modulated by a boosting-based importance weighting mechanism that focuses alignment on the hardest-to-align temporal positions. Experiments on three chemical process datasets and the BSM1 wastewater-treatment benchmark show consistent improvements over strong baselines, highlighting its potential for practical process monitoring applications.}
}
@article{ZHANG2026115763,
title = {VeTraNet: Hydro-aware dual-branch transformer for vessel trajectory forecasting},
journal = {Applied Soft Computing},
volume = {202},
pages = {115763},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115763},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012111},
author = {Zewei Zhang and Peilan He and Longyue Cui and Yanwei Yu and Qian Sun and Junyu Dong and Guiyuan Jiang},
keywords = {Vessel trajectory prediction, Hydrological factors, Differential representation, Horizon-aware context encoding, Multi-horizon prediction},
abstract = {Accurate prediction of fishing vessel trajectories is essential for sustainable fisheries management and maritime safety. However, existing methods, which are primarily designed for commercial vessels, often struggle to model the irregular maneuvers, operational-state transitions, and dynamic oceanographic conditions inherent in fishing activities. To address these challenges, we propose VeTraNet, a novel dual-branch neural architecture for multi-horizon vessel trajectory prediction. One branch formulates forecasting as a binary-encoded differential task to improve numerical stability and reduce long-horizon error accumulation. The other branch encodes horizon-aware context by integrating vessel motion patterns, navigational intent, and hydrological factors such as sea surface temperature and ocean currents. A masked-Transformer-based decoder then fuses differential motion cues and environmental context to generate multi-horizon forecasts in a single forward pass. Extensive experiments on a large-scale Vessel Monitoring System (VMS) dataset from the East China Sea show that VeTraNet consistently outperforms nine competitive baselines across multiple prediction horizons. For 90-minute forecasts, VeTraNet achieves up to a 37.1% reduction in Mean Absolute Error (MAE) and a 3.4% reduction in Final Displacement Error (FDE), while maintaining robust performance under both navigation and fishing modes. Ablation and component-replacement studies confirm the critical contributions of differential encoding, hydrological fusion, and horizon-aware modeling.}
}
@article{LI2026115779,
title = {A multi-strategy enhanced whale optimization algorithm-based support vector machine for high-precision fault diagnosis of mine ventilator bearings},
journal = {Applied Soft Computing},
volume = {202},
pages = {115779},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115779},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012275},
author = {Ning Li and Haishan Zhao},
keywords = {Fault diagnosis, Mine ventilation fan, Support vector machine, Improved whale optimization algorithm, Feature extraction},
abstract = {Accurate fault diagnosis of mine ventilator bearings is crucial for safe underground production, but remains challenging due to noisy, non-stationary vibration signals that are hard to characterize using conventional methods. To improve early fault identification accuracy and model robustness, this paper proposes an end-to-end fault diagnosis framework integrating signal denoising, adaptive decomposition, feature extraction, and intelligent classifier optimization. First, wavelet threshold denoising combined with variational mode decomposition (VMD) suppresses noise and extracts informative intrinsic mode functions (IMFs) from bearing vibration signals. The energy entropy of each IMF is then calculated to construct fault features. Second, a multi-strategy improved whale optimization algorithm (IWOA) is developed by incorporating Tent chaotic mapping, reverse learning, a nonlinear convergence factor, dynamic inertia weighting, simulated annealing, and adaptive mutation perturbation, thus enhancing global search capability and convergence accuracy. Finally, IWOA is used to optimize the penalty factor and kernel parameter of a support vector machine (SVM), thereby establishing an IWOA-SVM fault diagnosis model for mine ventilator bearings. Experimental validation on two bearing datasets achieves average diagnostic accuracies of 97.69% and 99.63% respectively, and further validation on an additional rotating machinery dataset confirms good generalization performance. Therefore, the proposed framework provides an effective and practical solution for predictive maintenance of mine ventilator systems.}
}
@article{YAO2026115831,
title = {Dynamic multi-feature fusion with contrastive learning for Chinese relation extraction},
journal = {Applied Soft Computing},
volume = {202},
pages = {115831},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115831},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012792},
author = {Liguo Yao and Zhenbo Tang and Jun Yang and Yao Lu and Taihua Zhang},
keywords = {Relation Extraction, Multi-Feature Fusion, Contrastive Learning, Graph Attention Network},
abstract = {Relation extraction (RE) is a fundamental task in information extraction, aiming to identify semantic relationships between entities and represent them in a structured form. Although recent deep learning-based approaches, especially pretrained language models (PLMs), have achieved notable progress, many existing methods rely on single-feature representations or static fusion strategies, which limit their ability to capture complex semantic interactions and structural dependencies in Chinese texts. To address these limitations, this paper proposes a Dynamic Multi-Feature Fusion and Contrastive Learning framework (DMFF-CL) for Chinese RE. The proposed model jointly captures local relational patterns using a dynamic convolutional neural network (CNN), global contextual dependencies via a relation-aware self-attention mechanism, and syntactic structural information through a graph attention network (GAT). A gating-based dynamic fusion mechanism is further introduced to adaptively integrate heterogeneous features, while contrastive learning is incorporated as an auxiliary objective to enhance the discriminative capacity and generalization ability of relation representations. Experiments on three public Chinese RE datasets—FinRE, SanWen, and DuIE—show that the proposed DMFF-CL model achieves F1 scores of 53.58%, 74.73%, and 94.26%, respectively. Compared with the strongest baseline methods, the proposed approach achieves an average performance improvement of 0.70 %age points across the three datasets. Ablation studies and qualitative analyses further verify the contribution of each model component, particularly in handling complex and implicit relations. Overall, these results demonstrate the practical effectiveness of the proposed framework for Chinese RE and its potential for supporting domain knowledge understanding under complex semantic and structural conditions.}
}
@article{MORADI2026115771,
title = {A hybrid adaptive large neighborhood search with evolutionary operators for energy-efficient electric-vehicle routing},
journal = {Applied Soft Computing},
volume = {202},
pages = {115771},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115771},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012196},
author = {Nima Moradi and Niloufar {Mirzavand Boroujeni} and Saeed Jamalzadeh and Nasim {Mirzavand Boroujeni}},
keywords = {Electric vehicle routing, Heterogeneous fleet, Energy minimization, Time windows, Metaheuristic},
abstract = {The integration of Electric Vehicles (EVs) with on-time delivery is essential, as it simultaneously ensures customer satisfaction and advances the sustainability goals of urban logistics systems. This study addresses the Heterogeneous Electric Vehicle Routing Problem with Time Windows and Energy Minimization (HEVRP-TW-EM), a growing concern in sustainable urban logistics. We formulate a Mixed-Integer Linear Programming (MILP) model to minimize the overall energy consumption of a heterogeneous fleet of EVs while ensuring that customer demands are met within specified time windows. The model captures practical aspects of vehicle heterogeneity, including battery capacity with temperature-dependent usable capacity, energy use, and charging behavior with partial recharge. It employs a real-world linear energy law that accounts for steady cruise and payload effects, stop-go acceleration, road gradient, regenerative braking, and temperature-derated charge power. For large-scale instances, we introduce an Adaptive Large Neighborhood Search with Evolutionary Operators (ALNS-EO). Computational experiments over benchmark-based and case-study-inspired datasets show that our algorithm not only runs significantly faster than Gurobi on large instances but also provides competitive, high-quality solutions compared to existing metaheuristics. Additional analyses, including convergence behavior, sensitivity tests, and operator performance, highlight its robustness. Sensitivity experiments reveal the substantial impact of factors such as battery capacity, fleet size, recharging policies, payload sensitivity, time-window tightness, and traffic on energy consumption and vehicle deployment. These results provide actionable insights for logistics providers seeking to balance operational efficiency and environmental sustainability in EV-based delivery networks.}
}
@article{RONG2026115799,
title = {Uncertainty quantification for convolutional neural networks based on test time augmentation with multiobjective evolutionary algorithms},
journal = {Applied Soft Computing},
volume = {202},
pages = {115799},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115799},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012470},
author = {Yibiao Rong and Zehua Jiang and Zhemin Zhuang and Zhun Fan and Haoyu Chen},
keywords = {Uncertainty quantification, Convolutional neural networks, Regression, Multiobjective evolutionary algorithms},
abstract = {Deep convolutional neural networks (CNNs) serve as a powerful tool for regression tasks. However, they typically output predicted target values, making it challenging to evaluate the reliability of these predictions. Test time augmentation offers a promising approach to estimate uncertainty values for CNNs, allowing us to measure how much the decisions made by CNNs can be trusted. During test time augmentation process, it remains difficult to determine which transformed images capture more uncertainty and which capture less. In this paper, we propose a novel method for automatically determining the appropriate transformed images to use when generating the predictive distribution. Specifically, in the proposed method, the objectives of minimizing the difference between the average of the predictive distribution and the ground truth, and maximizing the correlation between the variance of the predictive distribution and the predictive error are taken as the two primary objectives. A multiobjective evolutionary algorithm is then employed to optimize the two objectives. Many experiments are conducted to verify the effectiveness of the proposed method. The experiments show that the proposed method possesses the ability to determine the appropriate transformed images to use when generating the predictive distribution.}
}
@article{LEE2026115749,
title = {Integrating large language model and graph neural network for knowledge graph-based multi-source recommender system},
journal = {Applied Soft Computing},
volume = {202},
pages = {115749},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115749},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601197X},
author = {Hau-Wei Lee and R.J. Kuo},
keywords = {Multimodal recommender system, Explainable artificial intelligence, Large language model, Knowledge graph, Graph neural network, CLIP, Psychology-based prompts, Cold-start problem},
abstract = {Single-modality recommenders often fail to capture the full spectrum of user preferences under item cold-start and data-sparsity conditions, leading to sub-optimal recommendation accuracy in e-commerce settings. This study proposes an interpretable multimodal recommendation framework which fuses user-item ratings, review texts, and product images. The key novelty is the explicit coupling of a Large Language Model (LLM)-driven review parsing pipeline, an item-centric knowledge graph with GraphSAGE-based textual representation learning, and CLIP-based visual encoding enriched with psychology-informed prompts. These modality-specific signals are integrated through cross-attention and a feedforward fusion head, while SHapley Additive exPlanations (SHAP) are used to quantify modality contribution, support local and global interpretation, and improve transparency. Across four Amazon datasets, the proposed model achieves the best overall performance and maintains robust cold-start behavior. Mann-Whitney U and Friedman tests confirm statistically significant gains over unimodal and multimodal alternatives at the 0.05 level. The results show that review-derived semantic features contribute the most, followed by image and rating representations, highlighting the complementary value of deep language understanding, graph-based structure, and visual psychology cues in trustworthy recommendation.}
}
@article{CHOI2026115746,
title = {Leveraging cross-domain knowledge alignment for AI transformation: A contrastive learning approach using problem-solution pairs from patents},
journal = {Applied Soft Computing},
volume = {202},
pages = {115746},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115746},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011944},
author = {Jaewoong Choi and Juram Kim and Changyong Lee},
keywords = {AI transformation, Contrastive learning, Cross-domain knowledge alignment, Industrial context–technical function landscape, Pre-trained language model},
abstract = {Although increasing attention has been paid to organizational factors that enable successful artificial intelligence (AI) transformation, limited guidance exists on how organizations can effectively explore AI knowledge relevant to problems in their specific domains. This process typically relies on intensive cross-domain collaboration among experts, which is time-consuming, labor-intensive, and susceptible to siloed thinking. As a remedy, we propose a systematic analytical framework for identifying AI transformation opportunities by aligning problem-solving knowledge across target and AI domains. First, we extract key problems and solutions from technical documents, enabling a structured representation of knowledge in each domain. Next, we use contrastive learning to model implicit associations between problems and solutions from different domains based on their industrial contexts and underlying technical functions, thereby constructing an industrial context–technical function landscape as a joint embedding space. Within this space, we identify AI-domain problems and solutions that are proximate to the target problem, where proximity reflects both contextual relatedness and technical feasibility. A case study using 24,214 business method patents and 35,241 AI patents confirms that the proposed approach effectively identifies technically relevant and novel AI solutions for target problems, significantly outperforming random retrieval and KorPatBERT, a state-of-the-art patent-domain language model baseline.}
}
@article{RAUF2026115762,
title = {AAST-Net: Activity adaptive spatio-temporal network for human activity recognition},
journal = {Applied Soft Computing},
volume = {202},
pages = {115762},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115762},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601210X},
author = {Muhammad Arslan Rauf and Asif Iqbal and Muhammad Ahmad Nawaz Ul Ghani and Mian Muhammad Yasir Khalil and Ihsan Elahi and Zhen Qin},
keywords = {Human activity recognition, ViT, GRU, Video understanding, Surveillance systems},
abstract = {Human Activity Recognition (HAR) has gained significant attention due to its wide-ranging applications in surveillance, healthcare, and smart devices. Despite advancements in deep learning, accurately capturing spatial and temporal dependencies in videos remains a challenging task, particularly in real-world scenarios with noisy backgrounds, varying viewpoints, and visual obstructions. This paper introduces the Activity Adaptive Spatio-Temporal Network (AAST-Net), a hybrid framework that combines a Vision Transformer (ViT) for spatial feature extraction with a multilayer Gated Recurrent Unit (GRU) model for modelling temporal dependencies across video frames. Unlike traditional approaches, AAST-Net processes frames independently and subsequently fuses temporal features, enabling effective learning of long-range temporal dependencies without relying on convolutional operations. The main contributions of this work are threefold: (1) the design of a ViT-based spatial feature extractor tailored for HAR, (2) a GRU-based temporal fusion strategy that captures long-term dependencies while maintaining computational efficiency, and (3) the integration of a deep classification head with a focal loss function to address class imbalance. Evaluated on benchmark datasets UCF50, YouTube Action, and HMDB51, the proposed AAST-Net model outperforms existing baseline methods, achieving accuracies of 98.36%, 95%, and 91.17%, respectively. These results demonstrate the model’s superior effectiveness in overcoming the limitations of previous approaches.}
}
@article{SHI2026115783,
title = {A constrained multiobjective optimization coevolutionary algorithm with Wilcoxon-Bayesian for synchronous optimal pulsewidth modulation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115783},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115783},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012317},
author = {Qian Shi and Heming Jia and Yongchao Li and Mahmoud Abdel-salam},
keywords = {Constrained multi-objective optimization, Resource allocation, Two-population optimization model},
abstract = {Constrained Multi-Objective Optimization Problems (CMOPs) pose significant challenges in balancing objective improvement with strict feasibility maintenance. While multi-population evolutionary algorithms have shown promise in addressing these challenges, they often suffer from static constraint-handling mechanisms and substantial computational overhead. To overcome these limitations, this paper proposes a novel coevolutionary algorithm (WBCMO) that integrates the Wilcoxon rank-sum test with a Bayesian resource allocation model. The framework utilizes the Wilcoxon test to dynamically infer the geometric relationship between unconstrained and constrained Pareto fronts, thereby applying adaptive constraint-handling strategies to guide the search effectively. Simultaneously, a Bayesian model leverages historical evolutionary data to dynamically optimize the distribution of computational resources between populations, maximizing search efficiency. The proposed approach is rigorously evaluated against six state-of-the-art algorithms on 47 synthetic benchmark functions and six real-world Synchronous Optimal Pulsewidth Modulation (SOPWM) engineering instances. Experimental results demonstrate that WBCMO achieves superior convergence and diversity. Notably, in the highly constrained SOPWM scenarios, the algorithm exhibits exceptional robustness by successfully identifying feasible solutions in disconnected regions where competing methods fail, confirming its potential for solving complex high-power converter control problems.}
}
@article{ZHAO2026115827,
title = {Consensus-guided multi-party multi-objective artificial bee colony for multi-party distance minimization problems},
journal = {Applied Soft Computing},
volume = {202},
pages = {115827},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115827},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012755},
author = {Zifan Zhao and Peilan Xu},
keywords = {Multi-objective artificial bee colony, Multi-party multi-objective optimization, Multi-party distance minimization problem},
abstract = {Multi-party distance minimization problems (MPDMPs) arise in decision-making scenarios where multiple decision makers (DMs) simultaneously minimize distances to their respective target locations. In practical settings, the intersection of individual Pareto sets is often empty, rendering purely self-interested optimization insufficient and necessitating reciprocal concessions to identify a mutually acceptable consensus region. To address this challenge, we propose a consensus-guided multi-objective artificial bee colony algorithm (CMOABC) tailored to MPDMPs. The method introduces a concession-adaptive multi-party non-dominated sorting scheme, in which DM-dependent weights derived from concession rates are used to aggregate individual dominance ranks into a unified consensus-guided hierarchy. In addition, a dual-elite-archive framework is developed to preserve both classical Pareto optimality and consensus feasibility by maintaining a Pareto Elite Archive and a Consensus Elite Archive concurrently. Based on these components, consensus-guided selection and search strategies are designed to adaptively guide the employed–onlooker–scout process toward mutually acceptable regions while retaining population diversity. Extensive experiments on a suite of MPDMP benchmarks under varying concession settings demonstrate that CMOABC achieves superior performance compared with representative multi-party evolutionary baselines, regardless of whether a common solution set exists, thereby validating the consensus-guided optimization framework.}
}
@article{ROY2026115730,
title = {A new type-2 Fermatean fuzzy based decision model for security analysis in financial market},
journal = {Applied Soft Computing},
volume = {202},
pages = {115730},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115730},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011786},
author = {Bikash Koli Roy and Samarjit Kar and Sanjib Biswas},
keywords = {Fermatean fuzzy set, Type-2 Fermatean fuzzy set, Score function, Multi-criteria decision making (MCDM), TOPSIS, Stock selection},
abstract = {The main purpose of the current study is to develop a novel uncertain decision-making model using Type-2 Fermatean Fuzzy Set (T2FFS). The proposed model is intended for application in analysing financial securities from an investment perspective. The present paper first defines the T2FFS and various operations. It provides two novel definitions of the score functions and distance measures. Then, it extends the classical Technique for Order of Preference by Similarity to the Ideal Solution (TOPSIS) method using T2FFS. The T2FFS-TOPSIS model is applied to compare a set of six stocks representing their respective sectors listed on NSE, India. The sample was formulated by considering six representative stocks taken from the sectors that hold a major part in the benchmark index, such as NIFTY 50. Six criteria are considered to compare the stocks. These criteria are selected based on three major factors such as growth, valuation and risk factor. The underlying intentions are to achieve a return which may outperform the return of the benchmark index, and risk is comparatively lower. From the analysis it is seen that our stock selection method provided a reliable and stable solution. The result shows Infosys as the best stock to invest in and Maruti as the worst stock to invest in for the future, and at the end of the investment horizon, it was found to be true. To our best knowledge, the present work is a first of its kind that proposes the concept of T2FFS and defines the fundamental set theoretic operations along with the novel score function. Further, the current work fills the gap in the extant literature on security analysis in the stock market by utilizing uncertain modelling based on T2FFS.}
}
@article{LIU2026115819,
title = {Mechanism-guided gated attention network with uncertainty quantification for robust soft sensing in complex industrial processes},
journal = {Applied Soft Computing},
volume = {202},
pages = {115819},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115819},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012676},
author = {Changwei Liu and Jiadong Lou and Guangwei Wen and Guoqiang Li and Bei Sun and Xiaojun Liang},
keywords = {Mechanism-guided attention, Explainability, Interpretability, Uncertainty quantification},
abstract = {The reliable monitoring of complex industrial processes is often hindered by sensor unreliability under harsh operating conditions and by the limited interpretability of data-driven models. To address these issues, a robust soft-sensing framework, termed Mechanism-Guided Gated Attention LSTM (MGGA-LSTM), is proposed. A Mechanism-as-Query paradigm is introduced, in which domain knowledge is used as the query in the attention network to retrieve process patterns relevant to the current physical state. The balance between mechanistic constraints and data-driven features is further regulated by a dynamic gated fusion unit according to operating conditions. Predictive uncertainty is quantified through an end-to-end probabilistic forecasting module. The framework was validated on a real-world zinc hydrometallurgy case study, where an R2 of 0.930±0.011 and a Prediction Interval Coverage Probability of 0.969±0.029 were obtained, outperforming data-driven baselines including Autoformer, which represents the state of the art on benchmarks. The consistency between feature attributions and physicochemical expectations was further supported by SHAP analysis and attention visualization. The proposed framework therefore provides an interpretable and uncertainty-aware solution for robust industrial soft sensing.}
}
@article{GAO2026115733,
title = {Autonomous software upgrade system for EV battery packs: A new multi-node collaborative model},
journal = {Applied Soft Computing},
volume = {202},
pages = {115733},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115733},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011816},
author = {Heng Gao and Shiqi Yi and Xiaoyu Zhang and Qiong Yan and Peng Zhang and Lu Zhang and Rui Du and Li Wang and Xuanyi Li and Lei Wang and Wenti Huang and Huilong Fan and Shangpeng Wang},
keywords = {Electric vehicle, Battery management system, Autonomous software upgrade, Variable neighborhood search, Physics-inspired models, Distributed systems},
abstract = {Multi-objective task scheduling in electric vehicle battery software updates provides a key technology for the efficient and intelligent management of the battery’s entire lifecycle in the era of software-defined vehicles. However, existing scheduling methods have the following main limitations: i) mainstream approaches treat task allocation and scheduling as separate processes, focusing only on local optimization during allocation and failing to prevent systemic bottlenecks globally; ii) most studies rely on simple weighted sums or single-objective optimization, which makes it difficult to effectively characterize and optimize the Pareto-optimal trade-off between updating efficiency and resource load balancing, thereby limiting the flexibility and quality of decision-making. To address these issues, this paper proposes a physical potential-assisted variable neighborhood search (CPA-VNS) framework tailored to this problem. The framework first introduces a physics-inspired connection potential model that quantifies multidimensional factors into system potential. By solving a mixed-integer programming model, an optimized initial task allocation scheme is generated, improving solution quality from the outset. Then, within a Pareto optimization framework, a variable neighborhood search algorithm with a customized neighborhood structure is designed. This algorithm efficiently explores the solution space under efficiency-fairness constraints, systematically mapping the entire Pareto front, and providing decision-makers with a set of high-quality non-dominated scheduling solutions. Comparative experiments against seven benchmark algorithms across six simulation scenarios of varying scale and complexity demonstrate that the proposed framework achieves the lowest makespan and load variance in nearly all scenarios. Furthermore, Pareto analysis proves that sacrificing approximately 3% in efficiency can yield an improvement of over 50% in fairness.}
}
@article{SHI2026115791,
title = {A multi-objective evolutionary algorithm with probability selection mechanism for solving constrained multi-objective optimization problems},
journal = {Applied Soft Computing},
volume = {202},
pages = {115791},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115791},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012391},
author = {Qian Shi and Heming Jia},
keywords = {Constrained multi-objective optimization problems, Evolutionary algorithm, Bayesian posterior, Semi-normal distribution},
abstract = {Large-scale infeasible regions pose difficulties for solving constrained multi-objective problems. To address this issue, this paper proposes a dual-population constrained multi-objective evolutionary algorithm based on Bayesian posterior probability selection and half-normal probability screening (BPSND). Unlike traditional methods that rely on fixed evolutionary strategies, BPSND establishes a rigorous statistical framework where the selection of evolutionary operators is guided by a Bayesian posterior Beta distribution derived from historical iteration data. This allows for a scientifically rigorous transition between exploration and exploitation. Furthermore, to effectively utilize infeasible information, an evaluation metric combining constraint violation and non-dominated ranking is designed. Infeasible solutions are then screened using a half-normal probability distribution, which ensures that high-quality infeasible individuals are prioritized to guide the population across infeasible barriers while maintaining diversity. Extensive experiments on four benchmark test suites demonstrate that the proposed method BPSND, significantly outperforms seven advanced constrained multi-objective evolutionary algorithms.}
}
@article{VALENZUELAALCARAZ2026115766,
title = {Impact of parameter tuning on GRASP performance for the capacitated arc routing problem},
journal = {Applied Soft Computing},
volume = {202},
pages = {115766},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115766},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012147},
author = {Victor M. Valenzuela-Alcaraz and M.A. Cosío-León and Anabel Martínez-Vargas and A. Danisa Romero-Ocaño},
keywords = {Tuning, Taguchi, Metaheuristic, GRASP, CARP},
abstract = {Metaheuristic algorithms are frequently treated as black-box solvers that generate approximate—rather than exact—solutions for complex optimization problems. A critical step before executing such algorithms is parameter tuning: the process of identifying an optimal configuration vector P∗ that significantly influences the efficiency and effectiveness of the algorithm. This study analyzes the impact of parameter tuning on the performance of the Greedy Randomized Adaptive Search Procedure (GRASP) when applied to the Capacitated Arc Routing Problem (CARP), an NP-hard problem relevant to real-world logistics such as waste collection and urban servicing. We compare two tuning strategies: empirical adjustment and a structured method based on the Taguchi Design of Experiments (DOE). The results show that the Taguchi method not only increased the number of instances with a solution gap (GAP) of 0% from 20 to 29 but also halved the number of instances with GAP > 10%, from 24 to 12. These findings underscore the importance of systematic tuning in improving both solution quality and algorithmic robustness for NP-hard routing problems.}
}
@article{WANG2026115794,
title = {Utilizing condition number to diagnose and mitigate the training failure of physics-informed neural network},
journal = {Applied Soft Computing},
volume = {202},
pages = {115794},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115794},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012421},
author = {Zhao-Peng Wang and Jia-Ying Chen and Lei-Lei Guo and Li-Sheng Zhang and Zhi-Yong Zhang},
keywords = {Condition number, Physics-informed neural networks, Adaptive activation function, Singular value decomposition},
abstract = {Physics-informed neural networks (PINNs) have significantly advanced the development of numerical methods for solving partial differential equations (PDEs) in the physical and engineering fields. Nonetheless, they often suffer from training difficulties and even failures whose underlying mechanisms remain poorly understood. In this paper, we introduce the network condition number to explore the intrinsic performance mechanism of PINNs in PDE solution learning. Specifically, we reveal that PINNs achieve stable and accurate training when the network condition number closely matches that of the true solution, whereas the performance degrades otherwise. In particular, we rigorously prove that the L2 relative error of predicted solution is bounded by the sum of condition number discrepancy between the neural network and the true solution and two unrelated constant terms. Then, motivated by these findings, we propose a condition number enhanced PINN (cnPINN) based on singular value decomposition of network weight matrices, which adaptively adjusts the network condition number to approximate that of the true solution without requiring any prior knowledge during training. Numerical experiments verify that the proposed cnPINN consistently outperforms vanilla PINN and several state-of-the-art PINN variants, and effectively resolves several challenging PDE problems where existing methods fail to converge.}
}
@article{XUE2026115758,
title = {An ensemble attribute reduction approach via group optimization fusion in quadratic-voting rough set},
journal = {Applied Soft Computing},
volume = {202},
pages = {115758},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115758},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012068},
author = {Feng Xue and Yifeng Zheng and Changzhe Lin and Baoya Wei and Weiqiang Liu and Wenjie Zhang and Guohe Li},
keywords = {Attribute reduction, Neighborhood rough set, Quadratic-voting rough set, Neighborhood equivalence relation, Group optimization fusion},
abstract = {Attribute reduction aims to eliminate redundant and irrelevant attributes to preserve the discriminative power of the original data. Existing attribute reduction methods often adopt a single-decision perspective, without considering the collective insights of group optimization. Consequently, the derived reduct set fails to accommodate the specific requirements of each decision class, thereby compromising the robustness and generalization performance of the classification model. This paper presents a quadratic-voting rough set based on neighborhood equivalence relations. On top of this, the present study designs an ensemble attribute reduction framework that incorporates a group optimization fusion strategy. First, for each decision class, the importance of each attribute is evaluated using a proposed approximation accuracy measure. The attributes are then ranked in descending order of importance to derive a preference order for each attribute within each decision class. Second, the Cook-Seiford group optimization fusion is employed to synthesize the preference orders from all decision classes, resulting in a consensus attribute preference order across the entire universe. Furthermore, a proposed average approximation accuracy measure is adopted to eliminate redundant attributes, yielding an approximately globally optimal attribute reduct. Finally, experiments evaluate the proposed method against five representative neighborhood rough set-based attribute reduction algorithms across eight typical datasets. The experimental results demonstrate that our proposal achieves higher classification accuracy and stronger robustness.}
}
@article{LIU2026115810,
title = {Adversarial UV patch attack from implicit 3D face representation via model inversion},
journal = {Applied Soft Computing},
volume = {202},
pages = {115810},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115810},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012585},
author = {Xiaoliang Liu and Furao Shen and Feng Han and Jian Zhao},
keywords = {Adversarial patch, Face recognition, UV texture space, Model inversion},
abstract = {Adversarial patch attacks pose a practical threat to face recognition systems. While most existing methods are formulated in the 2D image space, robust transfer across pose variation and different images of the same victim remains insufficiently addressed. We propose InvUVPatch, a 3D-aware adversarial patch framework that employs a two-stage inversion procedure on a neural-rendering-based 3D generative model to recover identity-consistent implicit facial representations of both the source and target identities. These inversion-derived geometric priors enable direct adversarial optimization in UV texture space. Combined with multi-view differentiable rendering, pose sampling, and similarity transformations, this design enables geometry-aligned optimization for improved target impersonation and cross-image transferability. Experiments on multiple face recognition models show that InvUVPatch achieves strong white-box and black-box performance, improving black-box attack success rates by up to 46.07 percentage points over the strongest baseline. Ablation studies further confirm the contribution of model inversion, UV-space refinement, and geometric augmentation to the effectiveness of the proposed method.}
}
@article{WEI2026115786,
title = {An LSTM-attention-deep & cross network hybrid approach for multi-attribute weight determination},
journal = {Applied Soft Computing},
volume = {202},
pages = {115786},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115786},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012342},
author = {Meng Wei and Jiaguo Liu},
keywords = {Multi-attribute decision making, Weight determination, Artificial intelligence, Deep learning, Data-driven},
abstract = {To address the limitations of traditional weight determination methods in Multi-Attribute Decision Making (MADM), which struggle to effectively model dynamics and complex nonlinear interactions, this paper proposes a three-stage unsupervised collaborative framework integrating Long Short-Term Memory Network (LSTM), Attention mechanism, and Deep & Cross Network (DCN) for data-driven dynamic attribute weight determination. Experiments show that the proposed model outperforms traditional baseline methods on Instability and Consistency metrics. Ablation studies validate the effectiveness of each module. Complexity analysis reveals that the model’s time complexity scales linearly with sample size and has low memory requirements. Scalability experiments confirm its stable weight generation performance across different data scales. Attention visualization and SHAP analysis enhance the model’s interpretability. A case application further demonstrates that the generated weights exhibit high robustness across different decision-making methods, and the evaluation results align closely with industry realities. This study provides an objective, robust, and interpretable intelligent weight determination solution for complex dynamic decision-making scenarios.}
}
@article{JIAO2026115778,
title = {Frequency-guided composite infrared-visible image fusion via progressive visual structure and detail learning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115778},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115778},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012263},
author = {Xikun Jiao and Bo Liu and Ling Guan and Chunzhu Dong and Hui Zeng},
keywords = {Infrared-visible image fusion, Dual-branch network, Two-stage composite fusion module, Pixel-gradient hybrid loss},
abstract = {Infrared and visible image fusion (IVF) focuses on merging the complementary cues offered by the two modalities to form a single representation with enhanced visual and semantic details. However, effective feature fusion for simultaneously modeling visual low-frequency structure and high-frequency details still remains challenging. To address this issue, we propose a frequency-guided feature composite fusion network for the IVF task. The network begins with a shared feature encoder to extract modality-irrelevant representations, and a dual-branch architecture is introduced to separately encode low-frequency structural features and high-frequency detail features. A Two-stage Composite Fusion Module (TCFM) is then elaborated to progressively fuse intra-frequency and inter-frequency features through a combination of intra-block connections and inter-block alignment connections, enabling more effective feature interaction across frequency domains. In addition, a Pixel-Gradient Hybrid Loss (PGHL) is introduced to jointly constrain pixel-level and gradient-level information in order to preserve structural features while enhancing visual details. Comprehensive evaluations on infrared-visible image benchmarks indicate that our approach delivers superior visual fidelity and quantitative metrics relative to current state-of-the-art fusion techniques, demonstrating the effectiveness of the proposed frequency-guided feature composite fusion network in progressively strengthening visual structure and detail learning.}
}
@article{KHALEEL2026115754,
title = {An artificial-bee-colony framework with gravity-guided search and merge–split coalitional game adaptation for multi-objective cloud–edge workflow offloading},
journal = {Applied Soft Computing},
volume = {202},
pages = {115754},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115754},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012020},
author = {Mustafa Ibrahim Khaleel},
keywords = {Multi-objective optimization, Cloud–edge computing, Artificial bee colony, Gravity-guided search, Merge–split coalitional game},
abstract = {Efficient workflow offloading in cloud–edge computing remains challenging because workflow applications involve heterogeneous resources, DAG precedence constraints, and conflicting objectives. This paper proposes ABCGSM, an artificial-bee-colony framework that integrates gravity-guided search and merge–split coalitional-game adaptation for multi-objective cloud–edge workflow scheduling. The problem is formulated as a Pareto-based optimization model that minimizes execution latency, energy consumption, and utilization inefficiency while maximizing reliability. ABCGSM extends canonical ABC by embedding gravity-guided intensification, crowding-distance diversity preservation, and merge–split coalition adaptation within the employed–onlooker–scout search cycle. Entropy–TOPSIS is applied after Pareto optimization to select a balanced compromise solution from the non-dominated archive. Simulation results on DAG-based workflow scenarios show that ABCGSM achieves improved trade-off performance compared with classical ABC, multi-objective ABC, gravitational-search-based, and coalitional baselines. Sensitivity analysis further shows that latency has the strongest influence on the coalition cost score, followed by reliability, energy, and utilization inefficiency. These results indicate that ABCGSM provides an effective cooperative and diversity-aware optimization framework for scalable cloud–edge workflow scheduling. Across 30 independent runs, ABCGSM obtained the highest post-Pareto entropy–TOPSIS score of 0.88, compared with 0.74 for the closest competing method, MSCGTO, corresponding to an approximate 18.9% improvement; Friedman ranking and Wilcoxon signed-rank tests indicated statistically significant performance differences against the compared baselines at p<0.05.}
}
@article{CHI2026115770,
title = {Electrical wiring diagram recognition via topology‑Aware graph learning based on CAD data parsing},
journal = {Applied Soft Computing},
volume = {202},
pages = {115770},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115770},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012184},
author = {Juntong Chi and Qianyun Song and Song Zheng and Zhezhuang Xu and Yuhang Zhu and Yulong Zhang},
keywords = {Wiring diagram recognition, Electrical element recognition, Complete assembly identification, Graph neural network, CAD diagram measurement},
abstract = {Intelligent recognition of substation building electrical wiring diagrams is a key step to ensure the correctness and safety of substation design and to improve the efficiency of engineering operations. However, existing methods struggle with severe text-graphic interference, extreme scale variations of symbols, and their inability to explicitly model complex, imbalanced topological connections. To solve these challenges, this paper proposes a novel framework for electrical wiring drawing recognition, formulated as a topology-aware graph learning problem. First, we propose a CAD-image fusion strategy that leverages deterministic vector topology to guide visual parsing, effectively suppressing text-graphic interference to extract high-fidelity physical wiring structures. Second, by formalizing heterogeneous devices and their physical connections into a formal graph data structure, we develop a GraphSAGE-based classifier capable of decoding the complex, multi-hop configurations of complete electrical assemblies. Last, to handle unique geometric variations and structural sparsity, domain-tailored optimizations are introduced, including Dynamic Snake Convolution (DSConv) for capturing elongated busbars and a Gated-Attention mechanism to regulate extreme topological imbalance during graph aggregation. Experimental results on real-world 110 kV substation diagrams demonstrate the effectiveness of our framework, achieving 96.4% mAP for element detection, 98.95% edge precision for topology extraction, and 95.47% accuracy for assembly classification.}
}
@article{LI2026115793,
title = {Generation on demand: Synthesis of steel surface defects with controllable location, morphology, and context},
journal = {Applied Soft Computing},
volume = {202},
pages = {115793},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115793},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601241X},
author = {Hongjie Li and Chuni Liu and Qian Sun and Xiangyu Cao and Ke Xu},
keywords = {Image Generation, Data augmentation, Denoising Diffusion Probabilistic Model (DDPM), Surface Defect Recognition, Imbalanced Data},
abstract = {Steel surface defect inspection is critical to manufacturing quality, yet deep learning-based detection systems are severely constrained by the scarcity of annotated defect samples in real production environments. A fundamental challenge lies not only in augmenting data volume, but in generating defect samples on demand. This necessitates simultaneous control over location, morphology, class, and background to effectively fill specific gaps in the training distribution. Existing generative approaches either lack precise morphological control or suffer from background drift that degrades synthesis quality. To address these challenges, we propose the Fine-grained Controllable Surface Defect Generation (FCSDG) framework, an image-guided diffusion paradigm that independently decouples defect morphology from texture through Structure map guidance (SMG), and eliminates background drift via SAM-guided boundary correction (SBC) applied during the denoising process. Together, these innovations enable the synthesis of photorealistic defects at any specified location with any desired morphology on any given background, using only a handful of real samples for adaptation. Extensive experiments on two real-world steel surface defect datasets demonstrate that FCSDG consistently outperforms existing generative baselines, and augmenting training sets with FCSDG-generated samples improves downstream defect recognition accuracy by 9.8% and 24.6% on the Casting billet and CR7-det datasets, respectively.}
}
@article{LU2026115745,
title = {CMB-SSPNet: A multimodal deep learning framework for predicting vegetable antiviral protein structures},
journal = {Applied Soft Computing},
volume = {202},
pages = {115745},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115745},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011932},
author = {Wenjuan Lu and Tianyu Wang and Yijie Zhao and Yazhi Yang and Yuanmeng Hu and Yanbo Song and Zhenyu Liu},
keywords = {Protein structure prediction, Vegetable antiviral proteins, Self-supervised learning, Bidirectional long short-term memory network, Mamba architectur},
abstract = {Vegetable viral diseases pose a serious threat to sustainable agriculture. Viral resistance proteins play a critical role in plant antiviral defense and coordinated immune responses, and accurate prediction of their structures is essential for disease control and sustainable crop production. In this study, we focus on two representative targets: tomato spotted wilt virus resistance protein and potato inhibitor I. Data augmentation is applied to construct training samples, and the SimCLR framework is introduced for self-supervised pre-training, enhancing feature representation and generalization under complex data conditions. By integrating the spatial feature extraction capability of CNN, the sequential modeling strength of Bi-LSTM, and the computational efficiency of Mamba, we propose CMB-SSPNet, a deep learning model for precise prediction of resistance protein structures. To rigorously evaluate its performance, we compare CMB-SSPNet against traditional models (CNN, Bi-LSTM, CNN + Bi-LSTM) and advanced methods (Transformer, SimCLR-pretrained). Experimental results show that CMB-SSPNet achieves >90% accuracy on both datasets, outperforming all competitors in key metrics (ACC, F1-score, MCC) while reducing the minimum MAE to 8.11%. Sensitivity analysis further confirms its robustness. Moreover, validation on the PREDICTED: cucumber peeling dataset demonstrates strong cross-species generalization, with stable and reliable performance across different plant families. Collectively, CMB-SSPNet provides an effective computational tool for vegetable resistance breeding and holds promise for reducing crop production losses.}
}
@article{ZHAO2026115717,
title = {Integrated optimization for factory activation and job scheduling with logistics service via a dual-learning-powered evolutionary algorithm},
journal = {Applied Soft Computing},
volume = {202},
pages = {115717},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115717},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011658},
author = {Shicun Zhao and Hong Zhou and Feng Chu and Da Wang},
keywords = {Integrated scheduling, Flexible job shop scheduling, Vehicle routing problem, Evolutionary algorithm, Reinforcement learning},
abstract = {With intensifying market competition and increasing customer demand for rapid fulfillment, the integrated scheduling between distributed production and logistics service has become increasingly important for improving supply chain operational efficiency. Meanwhile, manufacturing firms often operate multiple factories, making it necessary to determine which factories should be activated for order production according to delivery-time requirements and customer locations. This paper considers an integrated problem involving factory activation, job scheduling, and logistics service decisions, referred to as the IFAJSLSP. The problem involves three distinct but tightly coupled subproblems: factory activation, distributed flexible job shop scheduling, and the multi-depot vehicle routing problem. The considered problem aims to minimize total cost, including factory operating costs, earliness and tardiness penalties, as well as energy consumption. A mathematical model is formulated to formalize this challenging problem. Then, a dual-learning-powered evolutionary algorithm (DLEA) is proposed to solve it. In DLEA, a reinforcement learning-powered offspring breeding mechanism is developed, where Q-learning is used to identify promising partners for offspring generation. Meanwhile, a self-learning-driven local search strategy is introduced, with a self-learning mechanism employed to adaptively select local search operators. Extensive experiments are conducted to validate the performance of the DLEA. The results confirm the effectiveness of the proposed learning modules and show that DLEA outperforms several well-established multi-objective evolutionary algorithms.}
}
@article{HAO2026115806,
title = {A novel approach for overlapping community detection in complex networks with dual graph attention networks and modularity optimization},
journal = {Applied Soft Computing},
volume = {202},
pages = {115806},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115806},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012548},
author = {Yaojun Hao and Ru Ma and Peng Zhang and Jinbo Chao and Fuzhi Zhang},
keywords = {Complex networks, Overlapping community detection, Graph attention networks, Node-community membership matrix},
abstract = {Overlapping community detection in complex networks remains challenging due to the need to simultaneously capture long-range cross-community dependencies and fine-grained local topology while jointly optimizing community quality. This paper proposes DGAT-OCD, a novel end-to-end framework that addresses these challenges through three key innovations. First, we introduce a parameterized cosine similarity attention mechanism that computes global context via learnable scaling and ReLU-activated aggregation. This enables efficient capture of long-range node interactions without the computational overhead of standard transformer attention. Second, we design a dual graph attention architecture that synergistically combines this global context with multi-head local attention. This allows nodes to simultaneously integrate macro-level community affiliations and micro-level neighborhood structures, a capability essential for accurate overlapping node identification. Third, we formulate a differentiable joint loss function that unifies graph reconstruction with modularity optimization. This enables end-to-end learning of the node-community membership matrix via back-propagation while avoiding NP-hard combinatorial optimization. Extensive experiments on attributed and non-attributed networks demonstrate that DGAT-OCD substantially outperforms both classical and recent deep learning baselines, with ablation studies confirming the necessity of each proposed component.}
}
@article{WU2026115782,
title = {Multimedia teaching framework based on cyclic generative LLMs: Taking sustainability learning as an example},
journal = {Applied Soft Computing},
volume = {202},
pages = {115782},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115782},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012305},
author = {Yirui Wu and Xinfu Liu and Lixin Yuan and Wenxiao Zhang and Shivakumara Palaiahnakote},
keywords = {Sustainable development, Multimedia teaching framework, Cyclic generative LLMs, Knowledge graph},
abstract = {As a cornerstone of bottom-up sustainability initiatives, education for sustainable development cultivates ecological stewardship in younger generations by fostering harmony between humans and nature. Despite existing efforts in primary-level sustainability education, the inherent complexity of this multidimensional concept poses significant pedagogical challenges due to its interdisciplinary knowledge requirements. Recently, the rapid advancement of Large Language Models (LLMs) has driven transformative impacts across domains of Artificial Intelligence–Generated Content (AIGC). Leveraging the sustainability knowledge embedded in LLMs for education for sustainable development, we propose a three-phase workflow (interaction, generation, optimization) that transforms passive tools into an active pedagogical platform. Specifically, we introduce a cyclic generative LLM scheme that autonomously generates and optimizes multimedia content in a complementary manner without additional training. To ensure generation relevance and correctness, we further optimize sustainability-related content through hard constraints derived from knowledge graphs, where biased and ambiguous knowledge is mitigated by explicit vertex and edge restrictions. Finally, we design an LLM-centered interactive interface to realize interaction and feedback, enabling real-time responses and personalized learning pathways. Extensive experiments demonstrate that the proposed framework outperforms existing methods in generative capability, while also exhibiting strong performance in usability and learnability.}
}
@article{ZHU2026115709,
title = {A non-linear granger causality-driven dynamic graph neural network for marine buoy data imputation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115709},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115709},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011579},
author = {Qiguang Zhu and Xiang Li and Wenjing Qiao and Linsong Zhang and Hua Yuan and Jiazhen Han and Zheyu Shen and Ying Chen},
keywords = {Ocean buoy data, Missing value imputation, Graph neural network, Granger causality, Feature Representation Learning},
abstract = {Ocean buoy sensor networks serve as critical infrastructure for monitoring ecological disasters such as eutrophication and harmful algal blooms. However, the extreme complexity of the marine environment and limitations in sensor hardware often lead to observation data that are subject to dual challenges: complex missing patterns and strong nonlinear coupling, which severely undermine data usability. To address the limitations of existing statistical methods in characterizing nonlinear dependencies and the inability of static graph networks to adapt to time-varying correlation mechanisms, this paper proposes a Causal Non-linear Temporal Dynamics Imputation Network (CNTDINet). Driven by the enhancement of data imputation accuracy, the model strengthens its capability to characterize complex marine dynamic systems by mining implicit non-linear Granger causality among variables. Specifically, the Neural Non-linear Projection (NNP) module utilizes the non-linear mapping of a bottleneck structure to enhance feature extraction and representation of weak coupling signals among biochemical parameters. Simultaneously, an adaptive dynamic adjacency matrix explicitly captures the temporal constraints and topological shifts of marine environmental parameters evolving over time through an end-to-end learning mechanism. Furthermore, the model introduces a joint optimization objective for imputation accuracy and structure discovery, leveraging the inherent statistical structural constraints of the data to improve the robustness of the imputation results. Extensive experiments on real-world marine datasets demonstrate that CNTDINet significantly outperforms existing baseline models in reconstruction accuracy across various missing patterns, providing a technical solution for marine scientific research that balances imputation precision with statistical interpretability.}
}
@article{TIAN2026115798,
title = {A novel coarse-grained fuzzy model: Q-rung orthopair fuzzy granular-balls on three-way multi-attribute decision-making with regret theory for pre-diagnosis of depression},
journal = {Applied Soft Computing},
volume = {202},
pages = {115798},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115798},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012469},
author = {Xiaoli Tian and Siyue Lei and Hamido Fujita},
keywords = {Three-way multi-attribute decision-making, Q-rung orthopair fuzzy granular-balls, Conditional probabilities, Regret theory},
abstract = {Three-way multi-attribute decision-making (3W-MADM) in fuzzy environments provides an effective framework for handling uncertain information by introducing a boundary domain, which reduces misjudgment risks and enhances fault tolerance. However, existing 3W-MADM research is largely confined to fine-grained perspective and still faces shortcomings such as non-compliance with the computational principle of conditional probabilities, neglect of the decision-maker’s psychological factors, and low decision-making efficiency. Based on this, this paper proposes a multi-granular 3W-MADM method with regret theory based on q-rung orthopair fuzzy granular-balls (q-ROFGBs) from a coarse-grained perspective. First, the q-ROFGBs are developed by combining q-rung orthopair fuzzy sets with granular-balls and the generation algorithm is designed. Second, a computational method for conditional probabilities with proper semantic interpretation based on q-ROFGBs is introduced. Third, regret theory is incorporated to account for the influence of psychological factors in decision-making. Next, a new 3W-MADM method with regret theory based on q-ROFGBs is established. Finally, the effectiveness, practicality, and flexibility of the proposed method are demonstrated through experimental analysis on both small-scale synthetic datasets and a large-scale real-world depression dataset. Compared with existing 3W-MADM methods, the proposed method not only incorporates the impact of regret psychology but also achieves the shorter decision-making time.}
}
@article{ZHANG2026115729,
title = {Word sense disambiguation based on twin-tower graph neural networks and multi-window feature fusion},
journal = {Applied Soft Computing},
volume = {202},
pages = {115729},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115729},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011774},
author = {Chunxiang Zhang and Maoxing Jiang and Xueyao Gao and Yongzeng Xue},
keywords = {Graph neural networks, Multi-window feature fusion, Rényi entropy, Soft voting},
abstract = {Word sense disambiguation is a fundamental problem in natural language understanding. However, many existing approaches rely on fixed-size context windows, which restrict their capacity to model multi-scale semantic cues and limit the effective exploitation of diverse contextual evidence. In this work, we propose a framework based on graph neural networks for Chinese word sense disambiguation with multi-window feature fusion. Specifically, we construct context windows of varying sizes centered on the ambiguous word to capture multi-granularity linguistic information, including lexical tokens, part-of-speech tags, semantic categories, and sentence-level representations. These features are then embedded using Bidirectional Encoder Representations from Transformers and Global Vectors for Word Representation to form the node feature matrix. To model inter-feature dependencies, we build a disambiguation feature graph whose edge weights are derived from pointwise mutual information, cosine similarity, and term frequency-inverse document frequency statistics. The resulting graph is encoded by a twin-tower architecture comprising a graph convolutional network and a graph attention network to perform complementary feature aggregation, while Kolmogorov–Arnold Network modules are incorporated into each tower to enhance nonlinear representation learning. Furthermore, we obtain the predictive distribution for each window and estimate its discriminative reliability via Rényi entropy. Finally, an entropy-weighted soft voting strategy is employed to fuse window-level predictions, yielding the final semantic category for the ambiguous word. Experiments show that our model achieves 87.98% accuracy on Semantic Evaluation 2007 Task #5 and 97.08% on the Chinese Health Word Sense Disambiguation corpus, outperforming a strong baseline based on Bidirectional Encoder Representations from Transformers (85.68%/95.23%) by 2.30% and 1.85%, respectively.}
}
@article{ZHAO2026115774,
title = {Quantization-aware lightweight differentiable architecture search},
journal = {Applied Soft Computing},
volume = {202},
pages = {115774},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115774},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012226},
author = {Yu Zhao and Lin Wang and Yalong Liu and Quanrun Song and Changtong Ding},
keywords = {Neural architecture search, Model optimization, Quantization-aware training, Convolutional neural network},
abstract = {Neural architecture search automates the design of convolutional neural networks, significantly reducing the cost and professional expertise required for manual design. However, most existing neural architecture search methods primarily focus on improving model accuracy while overlooking the excessive structural complexity of the searched architectures, which limits their deployment on resource-constrained devices. To address this issue, we propose a Quantization-Aware Lightweight Differentiable Architecture Search (QA-LDARTS) framework that integrates lightweight architecture design with quantization-aware training (QAT) to jointly optimize accuracy and computational efficiency. Specifically, we design a dynamic convolution operation that adaptively adjusts the number of convolutional channels and layer depth according to channel feature importance, thereby reducing computational burden while preserving effective feature representations. Moreover, a performance feedback-based progressive search strategy is introduced to dynamically adjust the search space and candidate operations based on real-time model performance, effectively enhancing search efficiency and avoiding convergence to local optima. The QAT module is embedded into both the search and training stages, enabling the model to adapt to different quantization bit-width requirements and further reducing storage and computational costs without sacrificing accuracy. Extensive experiments on CIFAR-10, CIFAR-100, and ILSVRC2012 demonstrate the effectiveness of QA-LDARTS. Compared with DARTS on CIFAR-10, QA-LDARTS achieves a 6.12% improvement in accuracy, while reducing the number of parameters by 33.33% and the computational cost measured in floating-point operations (FLOPs) by 24.54%. These results indicate that QA-LDARTS can effectively balance accuracy, model complexity, and computational efficiency, making it well suited for practical deployment.}
}
@article{ZHANG2026115802,
title = {Data-driven interval type-2 evolutionary fuzzy logic control for manipulators with enhanced interpretability},
journal = {Applied Soft Computing},
volume = {202},
pages = {115802},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115802},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012500},
author = {Jian Zhang and Congbo Cui and Qinyin Su and Hainan Yang and Tao Zhao},
keywords = {Evolutionary fuzzy logic systems, Interpretability, Interval type-2 fuzzy logic control, Particle swarm optimization, Manipulators},
abstract = {With the increasing complexity of controlled systems and their operating environments, designing fuzzy logic controllers (FLCs) solely based on expert knowledge and prior experience has become progressively challenging. This paper proposes a data-driven interval type-2 evolutionary fuzzy logic controller (IT2-EFLC) construction strategy with enhanced interpretability. Firstly, the structure of the IT2-EFLC is incrementally built using input–output data, where the fuzzy rules and interval type-2 fuzzy sets (IT2-FSs) are generated through data clustering, eliminating the need for any expert heuristics or prior knowledge during the controller design process. Secondly, an improved social learning particle swarm optimization algorithm (ISLPSO) is developed to tune the parameters of the IT2-EFLC, achieving a balance between control performance and interpretability. Throughout the optimization process, a fuzzy set merging strategy based on distance-based similarity measures is employed to simplify the controller structure, further promoting interpretability. Finally, the proposed method is applied to the trajectory tracking control of a robotic manipulator. The simulation and experimental results demonstrate that the IT2-EFLC constructed by the proposed approach effectively improves tracking control performance and interpretability.}
}
@article{LIU2026115824,
title = {Multi objective mission planning algorithm based on PPO for multi-domain joint operations},
journal = {Applied Soft Computing},
volume = {202},
pages = {115824},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115824},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601272X},
author = {Haiying Liu and Ruohan Jia and Yong Heng and Longfei Zhang and Junzhang Li and Hao Zhang and Linlin Li},
keywords = {Multi domain joint action, Task Planning, Proximal policy optimization},
abstract = {With the increasing integration of machine learning and intelligent optimization techniques into multi-domain joint operations, traditional mission planning paradigms are becoming insufficient to cope with complex operational environments involving multiple constraints. In pre-deployment planning scenarios, mission planners must generate executable plans that balance mission completion time, resource consumption, and task dependencies at a global level. To address these challenges, this paper proposes a Multi-Objective Mission Planning Algorithm-Proximal Policy Optimization (MOMPA-PPO). The proposed approach formulates joint task assignment and unit scheduling as a reinforcement learning problem and optimizes multiple mission objectives within a unified framework. This study integrates geographic location data—frequently neglected in classical scheduling formulations—into the mission-scheduling process. The proposed approach explicitly formulates a multi-objective reward structure within the PPO framework, enabling the simultaneous optimization of mission performance and resource utilization under complex operational constraints. Extensive experiments across multi-scale operational scenarios demonstrate that the proposed algorithm consistently outperforms the selected representative baselines. Quantitative analysis reveals that in large-scale joint campaigns, the proposed method achieves a 20.1% reduction in Makespan and a 3.2% optimization in total path length compared to standard on-policy baselines. Furthermore, probabilistic performance profiles indicate that the proposed planner attains the best observed solution among the compared methods in approximately 83.3% of the test instances. By embedding operational trade-offs directly into the learning objective, the method provides a flexible decision-making mechanism for multi-domain joint operations.}
}
@article{LI2026115789,
title = {TFCG: A time-frequency enhanced deep learning model for temperature prediction in air-liquid cooled data centers},
journal = {Applied Soft Computing},
volume = {202},
pages = {115789},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115789},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012378},
author = {Yu Li and Weiwei Lin and Jianpeng Lin and Zhiyu Yan and Junxian Shen and Xiumin Wang},
keywords = {Data center, Thermal model, Temperature prediction, Air-liquid hybrid cooling, Deep learning},
abstract = {Data center temperature prediction is essential for real-time cooling control and energy efficiency optimization. However, the multi-scale nature of temperature-related features in data centers poses significant challenges for accurate prediction. Existing approaches primarily rely on time-domain deep learning and often neglect frequency-domain features, while also adopting fully coupled inputs for multi-channel temperature signals, which limits their ability to capture complex cooling dynamics. To address these challenges, we propose a time-frequency enhanced deep learning model (TFCG) for temperature prediction in air-liquid cooling data centers. TFCG integrates time-frequency feature enhancement and long-range temporal modeling to capture multi-scale dynamic characteristics effectively. Moreover, channel-independent modeling with embedding-based fusion is introduced to handle complex thermal interactions. Comprehensive experiments on the Marconi100 dataset demonstrate that TFCG consistently outperforms strong state-of-the-art baselines, reducing MAE, RMSE, and MAPE by approximately 33.72%, 30.91%, and 10.75%, respectively, while improving R2 by 3.05%. These results indicate significant improvements in both prediction accuracy and stability. These results provide important guidance for cooling optimization in hybrid data center environments.}
}
@article{SHEN2026115728,
title = {DR-WOA: A whale optimization algorithm enhanced by drift search and reinforcement learning for aircraft assembly scheduling},
journal = {Applied Soft Computing},
volume = {202},
pages = {115728},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115728},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011762},
author = {Jiaji Shen and Ning Jia and Xianhui Liu and Lingyun Hu and Weidong Zhao},
keywords = {Aircraft assembly, Reinforcement learning, Whale optimization algorithm},
abstract = {Assembly operations account for over 40% of total production time in large commercial aircraft manufacturing. The interplay of task dependencies, resource limitations, and equipment availability creates a highly constrained scheduling environment that is difficult to optimize effectively. To minimize total assembly duration, we formulate a high-dimensional scheduling model that explicitly captures resource, material, tooling, and hierarchical task constraints. To solve this problem, we propose a Drift Search and Reinforcement Learning based Whale Optimization Algorithm (DR-WOA). A stagnation-triggered drift mechanism employing Cauchy-Gaussian hybrid perturbation reconstructs low-diversity populations to enhance global exploration. A deep reinforcement learning module then dynamically adjusts key control parameters based on population diversity and convergence trends, guided by a composite reward signal. The algorithm is evaluated through a two-stage protocol: benchmark tests on the IEEE CEC2017 suite and a real-world aircraft assembly case with over 600 tasks and 2000 resource constraints. Compared with established metaheuristic algorithms, DR-WOA achieves faster convergence, greater resilience to local optima, and a meaningful reduction in total assembly time.}
}
@article{KINGER2026115765,
title = {Chaotic map-based encryption for IoT text data via evolutionary algorithm optimization},
journal = {Applied Soft Computing},
volume = {202},
pages = {115765},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115765},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012135},
author = {Manan Kinger and A. Anjali and Om Jee Pandey and Hong-Ning Dai},
keywords = {Chaotic map, Security, Encryption, Sensor data, Evolutionary algorithms, Internet of things (IoT)},
abstract = {In an era marked by rapid advancements in connectivity and information storage technologies, prioritizing the safeguarding of data transmission is crucial. This research addresses the critical need for robust encryption methods by leveraging the inherent properties of chaotic systems. A novel chaos-based encryption system is introduced, utilizing a hybrid configuration of two 1-D chaotic maps. These maps are optimized using various evolutionary algorithms—Genetic Algorithm (GA), Particle Swarm Optimization (PSO), Differential Evolution (DE), and Artificial Bee Colony (ABC)—to enhance the sensitivity, unpredictability, and security of the generated key sequences. The proposed method demonstrates high resistance to brute-force and statistical attacks, as confirmed by extensive simulations. Key findings include a large key space with 96.6-bit entropy, over 50% avalanche and key sensitivity rates, and 100% success in NIST randomness tests across all variants. ABC and DE emerge as the most effective optimizers in chaotic parameter tuning. Additionally, the system is shown to be computationally efficient and scalable for resource-constrained IoT environments, making it suitable for real-time secure data transmission in smart applications.}
}
@article{HE2026115817,
title = {Three rough set models based on hypergraph and their applications in decision-making},
journal = {Applied Soft Computing},
volume = {202},
pages = {115817},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115817},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012652},
author = {Wenqing He and Hua Mao and Ruiting Cheng and Baocang Du},
keywords = {Rough sets, Covering rough sets, Hypergraphs, Decision-making},
abstract = {Rough set theory is a mathematical tool for characterizing incompleteness and uncertainty. However, when dealing with complex multi-relational data, some existing rough set models either lack graphical representation or fail to consider multi-perspective approaches. Consequently, the generalization of the results obtained by these methods and the scope of their applications are limited. This paper attempts to address these issues. Within the framework of hypergraph theory, which naturally represents complex multi-relations and provides intuitive graphical descriptions, a covering approximation space is characterized by means of a hypergraph. Conversely, each hypergraph is interpreted within the framework of a covering approximation space. By exploiting this relationship between covering approximation spaces and hypergraphs, this paper constructs three hypergraph-based rough set models from element-based and set-based perspectives, thereby providing a multi-angle approach. Through comparisons with the classical Pawlak rough set model and some other representative rough set models, the proposed hypergraph-based rough set models are shown to have certain advantages. The relationships among the three models are further revealed in both set-theoretic and numerical forms, indicating the important role of numerical methods in analyzing these models. To apply the proposed models to decision-making, this paper combines numerical methods, hypergraph-theoretic ideas, and the proposed concept of accuracy measures associated with rough set models. A criterion for comparing the accuracy measures of the three hypergraph-based rough set models is developed to support the selection of optimal decision schemes. Algorithms are designed to obtain each of the three hypergraph-based rough set models and to implement the decision-making approach, namely the criterion for comparing accuracy measures. These algorithms are analyzed theoretically and validated experimentally. In addition, the proposed results are verified through practical cases. Since all results obtained in this paper can be expressed graphically, the proposed graphical representations can facilitate the wider application of these findings and enhance the capabilities of rough set models.}
}
@article{SAID2026115781,
title = {An attention-based joint neural model coupled with genetic algorithm for advanced optimization of CsGeI3 perovskite solar cell performance},
journal = {Applied Soft Computing},
volume = {202},
pages = {115781},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115781},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012299},
author = {Mohamed Said and Ilyas Chabri and Ed-Drissiya El-Allaly and Ali Oubelkacem},
keywords = {Perovskite solar cells, Optimization, Attention mechanism, Joint learning, Genetic algorithm, SCAPS1D},
abstract = {Perovskite solar cells (PSCs) have gained significant attention in solar cell research. Germanium-based halide perovskites (CsGeI3) provide promising absorber materials for environmentally friendly PSCs. However, they have lower power conversion efficiency (PCE) which is influenced by numerous factors, including the composition of the perovskite material and the device preparation process. Generally, the trial-and-error and simulations are the widely-used methods to identify the optimal set of factors needed to develop high-performance CsGeI3 PSCs. Unfortunately, these methods usually require repeated trials and complex experimental procedures. To deal with these issues, we present in this study an Attention-based Joint Neural Model coupled with Genetic Algorithm (AJNM-GA) to automatically determine the optimal material configuration of CsGeI3 PSCs. Firstly, we conduct simulations with SCAPS-1D to generate a new dataset of 43 740 data points that effectively depict the PSCs based on CsGeI3. Then we investigate our AJNM model for predicting photovoltaic parameters of PSCs, including PCE, fill factor (FF), open circuit voltage (VOC), and short circuit current (JSC). In order to capture intricate interactions among these parameters, our model uses a joint learning paradigm. More specifically, it adopts a shared representation across output parameters by combining a multilayer feedforward neural network and an attention mechanism to leverage greater feature representation. Finally, we improve the structure and performance of CsGeI3-based PSCs by combining our AJNM model with the genetic algorithm. The findings show that the PCE of our AJNM-GA model is optimized from 4.94% to 10.37%. This study highlights that the combination of AJNM and GA allows finding the optimal core configuration for CsGeI3 PSCs, especially to maximize their experimental performance. It further provides valuable insights to reduce computational costs, accelerate the optimization process, and serve as a support tool for future experimental and simulation studies.}
}
@article{DEPAULAFERREIRA2026115688,
title = {A review on deep learning applications for the simulation of medium- and large-scale structures},
journal = {Applied Soft Computing},
volume = {202},
pages = {115688},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115688},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011361},
author = {Mateus {de Paula Ferreira} and Elisa Dominguez Sotelino},
keywords = {Deep Learning, Medium- and large-scale structures, FEM surrogates, Computational Solid Mechanics},
abstract = {Deep Learning (DL) models have been increasingly adopted in Computational Solid Mechanics to reduce the computational cost of simulation tasks traditionally performed by the Finite Element Method (FEM) such as field prediction, nonlinear or dynamic analysis, and topology optimization. However, it remains unclear how they overcome high-dimensional input encoding and data demand while preserving physical consistency at real-world structural scale (thousands to millions of degrees of freedom). To address this gap, 50 peer-reviewed studies on medium- and large-scale structural simulation are analyzed. The review classifies first-generation DL architectures—Multilayer Perceptron, Convolutional Neural Networks, Generative Adversarial Networks, Recurrent Neural Networks, and Transformers—by input representation, physics integration, and scalability, together with emerging mechanics-oriented frameworks (Graph Neural Networks, Fourier Neural Operators, and Deep Operator Networks), and performs a cross-evaluation based on generalization capacity, data efficiency, and suitability for nonlinear regimes. Evidence shows that purely data-driven models exhibit limited cross-geometry generalization and strong dependence on fixed discretization and large datasets. Physics-informed and FEM-embedded hybrids improve stability and data efficiency, yet scalability often relies on reduced-order targets rather than full-field prediction. Mechanics-oriented frameworks introduce stronger inductive biases that mitigate grid dependence, although validation remains restricted to limited geometric variability. Finally, three priorities for large-scale deployment emerge: stronger cross-geometry transfer, improved reliability and interpretability, and systematic data-generation protocols.}
}
@article{AHMED2026115785,
title = {A stability-aware fuzzy generative adversarial network framework for robust time-series generation under extreme data scarcity},
journal = {Applied Soft Computing},
volume = {202},
pages = {115785},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115785},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012330},
author = {Muneef Abdulkareem Farea Ahmed and Ahmed Al-Shalabi},
keywords = {Generative adversarial networks, Time-series generation, Data scarcity, Fuzzy conditioning, Lyapunov-inspired regularization, Training stability},
abstract = {Generative Adversarial Networks (GANs) have demonstrated strong potential for modeling complex temporal phenomena; however, their training dynamics remain fragile, particularly in noisy, irregular, and data-scarce time-series settings such as epidemiological surveillance. Existing stabilization approaches are often heuristic or task-agnostic, offering limited insight into how stability-aware mechanisms can enhance adversarial learning under uncertainty. This paper proposes a stability-aware fuzzy Generative Adversarial Network framework for robust time-series generation under extreme data scarcity. The approach integrates (i) fuzzy membership signals to encode latent temporal regimes, (ii) a Lyapunov-inspired contraction regularization to discourage locally expansive generator behavior, and (iii) complementary temporal and distributional smoothing components. To provide interpretability, a two-time-scale frozen-critic perspective is adopted, where the regularization term acts as a practical stability control rather than a formal Lyapunov guarantee. Targeted diagnostics reveal reduced sensitivity to latent perturbations, controlled gradient dynamics, and improved training stability. Experiments on epidemiological surveillance data demonstrate that the proposed framework generates coherent synthetic trajectories while preserving key temporal structures. Statistical validation further confirms that the generated data closely match real distributions, supporting both distributional fidelity and temporal consistency. Overall, the proposed framework offers a practical and empirically grounded solution for improving the robustness and stability of adversarial time-series generation in data-scarce and uncertain environments.}
}
@article{XUE2026115777,
title = {Multi-label text classification with category-constrained prompting and reflection mechanisms},
journal = {Applied Soft Computing},
volume = {202},
pages = {115777},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115777},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012251},
author = {Wandong Xue and Weiyan Zhang and Jianjun Zeng and Tong Ruan},
keywords = {Multi-label text classification, LLMs, Reflection mechanisms, Chain-of-thought, Fine-tuning},
abstract = {Multi-label text classification (MLTC) is widely applied in domains such as law, healthcare, and news, serving as a key technique to support downstream tasks like information filtering, recommendation, and topic modeling. However, existing approaches often overlook the issue of class imbalance and lack effective mechanisms to guide large language models (LLMs) in controlling the number of labels, constraining the label space, and correcting prediction errors. To tackle these challenges, this paper proposes LLM-MLTC, a novel LLM-based framework for MLTC with category-constrained prompting and reflection mechanisms. Specifically, the framework integrates four components, including a category-constrained prompt with task-specific priors and chain-of-thought reasoning, an instruction-tuning module via dataset construction and LoRA-based fine-tuning, dynamic ICL example selection strategies based on semantic similarity and KNN with label diversity, and trigger-based reflection mechanisms guided by prediction consistency and neighbor comparison. Experimental results on the UKLEX and BIOASQ datasets, evaluated using ChatGLM3-6B, LLaMA3-8B, and GLM-4-9B, demonstrate that LLM-MLTC consistently outperforms representative baselines for MLTC, achieving improved stability and interpretability in label prediction under highly imbalanced and sparse label distributions.}
}
@article{SADIK2026115748,
title = {Feature dimensionality reduction with Kolmogorov-Arnold Networks for accurate event detection in distributed fiber optic acoustic sensors},
journal = {Applied Soft Computing},
volume = {202},
pages = {115748},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115748},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011968},
author = {Serif Ali Sadik},
keywords = {Fiber optic sensor, Feature dimensionality reduction, Kolmogorov-Arnold Networks, Support vector machine},
abstract = {Fiber optic sensor technology has become a vital tool for event detection across various applications due to its high sensitivity and reliability. However, challenges in processing sensor signals, such as the need for large volumes of raw data and significant time and cost for training deep networks, limit the widespread adoption of deep learning methods. These limitations highlight the advantages of alternative approaches: obtaining meaningful features from limited sensor data, transforming these features into a space that correlates strongly with events, and classifying the transformed data using fast and practical machine learning methods. In this study, we propose the use of Kolmogorov-Arnold Networks to reduce feature dimensionality, followed by the classification of the resulting embedding features with a support vector machine. The proposed method is compared against multilayer perceptron and autoencoder-based feature dimension reduction techniques, as well as results from the literature. Experimental results demonstrate a significant improvement in accuracy, achieving 98.8% with the Kolmogorov-Arnold Network approach, surpassing 97.7% with multilayer perceptron and 95.98% with autoencoder based methods. These findings emphasize the effectiveness of Kolmogorov-Arnold Networks in feature reduction and representation learning, offering a computationally efficient solution for classifying high-dimensional sensor data. The proposed approach enables practical and cost-effective event detection in fiber optic sensor systems, particularly in scenarios with limited data availability, where traditional deep learning methods face challenges.}
}
@article{ZHAO2026115813,
title = {A synthetic minority class oversampling technique based on fuzzy hypergraph},
journal = {Applied Soft Computing},
volume = {202},
pages = {115813},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115813},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012615},
author = {Kaina Zhao and Peiwen Wang and Zhiping Wang and Pengfei Sun},
keywords = {Class imbalance learning, Fuzzy hypergraph, Fuzzy hyperedge, Oversampling},
abstract = {Traditional oversampling methods, such as synthetic minority class oversampling techniques, often overlook the uncertainty of samples when addressing the class imbalance problem, resulting in low-quality synthetic samples. To address this issue, this paper introduces a synthetic minority class oversampling technique based on fuzzy hypergraph. First, fuzzy hypergraphs are constructed using fuzzy similarity and nearest neighbor rules to identify noisy and outlier samples. Second, local similarity and global connection strength are combined to assess the importance of the samples and determine the appropriate oversampling amount for minority class samples. Next, the synthetic locations are dynamically selected based on the nearest neighbor information of the minority class samples. Finally, experimental and statistical tests conducted on 36 imbalanced datasets demonstrate that the proposed method outperforms 14 other oversampling techniques.}
}
@article{LIMA2026115753,
title = {Combinatorial optimization model, approximation and heuristic algorithms for identifying specific structures in networks},
journal = {Applied Soft Computing},
volume = {202},
pages = {115753},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115753},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012019},
author = {Karla Roberta P.S. Lima and Igor de M. Sampaio and Johanne Cohen},
keywords = {Optimization combinatorial, Integer linear programming, Approximation algorithms, Graphs},
abstract = {The Maximum Tropical Path Problem (MTPP) is an NP-hard combinatorial optimization problem defined on vertex-colored graphs, whose objective is to identify paths maximizing the number of distinct colors used in the graph. This problem has applications in the analysis of biological networks, such as identifying diverse metabolic pathways. Although the MTPP shares structural similarities with classical path problems in graphs, the existing theoretical results are largely restricted to exact and fixed-parameter algorithms. In this paper, we make the following contributions: (i) we formulate the MTPP as an Integer Linear Programming (ILP) model; (ii) we design two polynomial-time 2-approximation algorithms for cactus graphs, one deterministic and one randomized, both with proven guarantees; (iii) we propose a polynomial-time heuristic for general graphs based on cactus extraction; and (iv) we introduce a randomized algorithm for general graphs. The proposed approaches—ILP, randomized and heuristic algorithms—are evaluated through extensive computational experiments on both synthetic and real-world graph instances. The results demonstrate the effectiveness of the proposed methods and highlight the trade-offs between solution quality and computational efficiency across different graph structures.}
}
@article{HONGJIN2026115805,
title = {Swarm-aware collaborative learning with an adaptive subpopulation genetic algorithm for multi-objective optimization},
journal = {Applied Soft Computing},
volume = {202},
pages = {115805},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115805},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012536},
author = {Zhang Hongjin and Wei Hui},
keywords = {Multi-objective optimization, Adaptive control, Subpopulation decomposition, Swarm-aware collaborative, Optimization efficiency},
abstract = {This paper proposes a decomposition-based genetic algorithm integrating control feedback and collaborative learning for high-dimensional multi-objective optimization. The contributions are: 1) Maintaining a large population with individuals classified as immature, mature, and Pareto-optimal, where only immature individuals are updated to reduce computational complexity, together with a swarm-aware collaborative learning mechanism to accelerate convergence; 2) Introducing aging and random disaster mechanisms in the elimination stage, along with an archive set to preserve eliminated Pareto-optimal solutions; 3) Employing a Pareto-distance-based subpopulation strategy, where each subpopulation focuses on a specific objective and the Pareto set participates in all genetic operations; 4) Applying an adaptive feedback control scheme that adjusts key evolutionary parameters based on the current population state. Experiments are conducted on the DTLZ1–7, IDTLZ1–2, SDTLZ1–2, and ZXH_CF1–10 benchmark problems. The results demonstrate that the proposed method reduces IGD by over 86.4% and improves HV by 0.116 compared with NSGA-II + ARSBX, MFO-SPEA2, MOEA-D-UR, IM-MOEA-D, IMTCMO-BS, and MCCMO, confirming its effectiveness.}
}
@article{WEI2026115700,
title = {Geometry-aware artificial bee colony optimization for interpretable Parkinson’s disease progression modeling using latent disease manifolds},
journal = {Applied Soft Computing},
volume = {202},
pages = {115700},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115700},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011488},
author = {Keshun Wei and Qi Shen and Gang Cheng},
keywords = {Parkinson progression, Geometry-aware, Artificial bee colony, Hyperparameter, Latent disease},
abstract = {Parkinson’s disease (PD) is a progressive condition from the prodromal stage to the clinical stage. The interpretable models of progression are essential for tracking disease progression. Existing embedding methods are often sensitive to architecture design and hyperparameter selection. Optimizing only predictive accuracy often produces unstable latent geometries and unreliable disease staging. A Geometry-Aware Artificial Bee Colony (GA-ABC) optimization framework for disease manifold learning is proposed in this research. The work formulates the disease embedding problem as a population-based optimisation problem, where each solution corresponds to a unique latent geometry defined by a set of essential hyperparameters such as encoder capacity, latent space size, stochastic temperature, learning rate, and strength of Kullback-Leibler regularisation. In contrast to traditional ABC, GA-ABC combines global best-driven exploration of the neighbourhood and adaptive scout methods to encourage convergence towards stable and discriminative latent manifolds. GA-ABC is used to optimize a Multivariate Disease Embedding Network (MV-DEN) on a well-balanced set of 520 subjects (260 prodromal and 260 PD), using baseline structural MRI subcortical volumetric measures and clinical data. The optimization procedure converges to a parsimonious latent structure (latent dimension = 3, temperature = 1.5, β = 0.137), with a validation AUC of 0.9811, 0.9038 accuracy, 0.8750 precision, 0.9423 recall, and an F1-score of 0.907, significantly outperforming all manually optimized baselines. Moreover, the learned latent geometry enables the definition of a global disease axis for continuous, population-relative disease severity estimation.}
}
@article{JIN2026115776,
title = {Memory-efficient and scalable k-means with individual fairness},
journal = {Applied Soft Computing},
volume = {202},
pages = {115776},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115776},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601224X},
author = {Xin Jin and Shengkun Zhu and Yuan Sun and Sheng Wang and Dingwen Wang},
keywords = {-means, Individual fairness, Efficiency},
abstract = {Traditional k-means minimizes the sum of squared errors (SSE) but often leads to unequal distances between data points and their assigned centroids, resulting in individual unfairness in resource allocation scenarios. Existing individually fair k-means algorithms typically rely on strict fairness constraints or computationally expensive optimization, which significantly degrades clustering quality or scalability. In this paper, we propose f-means, a memory-efficient and scalable k-means algorithm with individual fairness. The method consists of three key components: (1) a fairness-aware initialization strategy based on an η-balanced loss to reduce sensitivity to initial centroids, (2) a rank-aware weighting scheme that upweights unfairly treated points during refinement according to distance distribution, and (3) a memory-efficient accelerator that maintains O(k) centroid bounds for batch pruning. We provide convergence analysis and a formal investigation of the trade-off between clustering utility and fairness. Experiments on 8 real-world datasets demonstrate that our method is fairer than SOTA methods, while maintaining SSE comparable to Lloyd’s algorithm. It is up to 217.72 times faster than Lloyd’s algorithm and outperforms existing fair k-means algorithms by an average of at least 5.31 times in terms of speed.}
}
@article{LUCOTTE2026115797,
title = {Interception of adversarial drones in urban spaces using a modified deep reinforcement learning approach},
journal = {Applied Soft Computing},
volume = {202},
pages = {115797},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115797},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012457},
author = {Nicolas Lucotte and Adolfo Perrusquía and Antonios Tsourdos and Weisi Guo and Hyo-Sang Shin},
keywords = {Target interception, Twin-delayed deep deterministic policy gradient (TD3), Artificial potential field (APF), Collision avoidance, Urban environments, Drones},
abstract = {The proliferation of drone technologies in urban spaces has increased the threat space on potential attacks of key assets and people. The early disruption of adversarial drones is crucial to ensuring safety and the smooth operation of transportation services. Previous approaches use target interception algorithms for well-known trajectory profiles such that the interception problem is reduced to solving a geometric task. However, the unpredictable nature of the decision-making of drones poses significant challenges to traditional interception algorithms. To this end, this paper proposes a tactical and dynamic path planning approach that maximises the interception probability of adversarial drones in the presence of obstacles, whilst minimising the interception time. This is achieved by modifying a twin-delayed deep deterministic policy gradient (TD3) algorithm with an artificial potential field (APF) that increases the likelihood of success for the interception in a reduced time, whilst avoiding local minima issues. Extensive experiments are conducted to demonstrate the feasibility of the approach and future research directions.}
}
@article{FU2026115773,
title = {STAHSM: A spatio-temporal aware hybrid sequential model for traffic flow prediction},
journal = {Applied Soft Computing},
volume = {202},
pages = {115773},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115773},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012214},
author = {Tingting Fu and Qichen Xie and Peng Liu and Liang Zhao and Jing Chen},
keywords = {Traffic flow prediction, Spatio-temporal embedding, Graph structure learning, Spatio-temporal model},
abstract = {Spatio-temporal time series forecasting plays a crucial role in many real-world applications, particularly in traffic flow prediction. Numerous methods have been successfully deployed in traffic management systems and have achieved promising performance. However, most existing approaches focus primarily on modeling spatio-temporal dependencies, while overlooking intrinsic characteristics of traffic data, such as temporal periodicity and semantic similarities among different spatial regions. To address this limitation, we propose a novel Spatio-Temporal Aware Hybrid Sequence Model (STAHSM) based on an encoder–decoder framework. The proposed model learns spatio-temporal embedding vectors to represent inherent traffic properties and captures spatio-temporal information from three perspectives: enhancing latent representations via vector concatenation in the encoder, introducing a spatio-temporal feature-enhanced Graph Convolutional Recurrent Unit (GCRU) unit in the decoder, and learning a periodic graph to model dynamic interactions among spatial nodes. Extensive experiments conducted on four benchmark datasets demonstrate that STAHSM consistently achieves state-of-the-art performance.}
}
@article{LI2026115825,
title = {Orthogonal and adaptive attention for hierarchical transformers in person re-identification},
journal = {Applied Soft Computing},
volume = {202},
pages = {115825},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115825},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012731},
author = {Jin Li and Jian Lu and Jiahui Xing and Kaibing Zhang and Xiaogai Chen},
keywords = {Person re-identification, Convolutional neural network, Hierarchical transformer, Attention, Feature aggregation},
abstract = {In person re-identification (Re-ID), CNN-based methods often suffer from channel redundancy and limited global modeling, whereas pure Transformer-based methods may fail to preserve fine-grained local cues and exhibit feature degradation in deep layers. To address these issues, we propose Orthogonal and Adaptive Attention for Hierarchical Transformers (OAH), a hierarchical hybrid framework for complementary global and local feature extraction. Specifically, OAH incorporates an Orthogonal Channel Attention Module (OCAM) into the ResNet50 backbone to form a Multi-scale Orthogonal Feature Extractor (MOFE). By using orthogonal filters, MOFE promotes channel complementarity and mitigates frequency bias. OAH further introduces a Hierarchical Adaptive Guidance Module (HAGM), in which Hierarchical Class Embedding (HCE) organizes the Transformer encoder into two specialized stages: a Scale Transformer for local detail refinement and a Class Transformer for global semantic modeling. This decoupled design helps preserve local details and semantic cues across hierarchical feature levels. In addition, an Adaptive Learnable Matrix (ALM) is inserted after each Self-Attention (SA) and Feed-Forward Network (FFN) layer. Through learnable diagonal scaling factors, ALM dynamically modulates channel responses, emphasizes salient identity cues, and suppresses redundant activations. Extensive experiments on four widely used Re-ID benchmarks demonstrate the effectiveness of OAH. In particular, OAH achieves 90.6% mAP and 96.5% Rank-1 on Market1501, and 82.1% mAP and 91.0% Rank-1 on DukeMTMC-reID, while maintaining competitive performance on MSMT17 and CUHK03-NP under the corresponding evaluation protocols. Compared with the HAT baseline, OAH improves mAP and Rank-1 by up to 1.3% and 2.0%, respectively. The results on DukeMTMC-reID and CUHK03-NP further indicate that OAH remains effective under challenging benchmark conditions involving occlusion, background clutter, and detector-induced misalignment.}
}
@article{PEIQI2026115743,
title = {An Integrated machine learning model for predicting pipeline failure pressure with single-point corrosion defects},
journal = {Applied Soft Computing},
volume = {202},
pages = {115743},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115743},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011919},
author = {Tian Peiqi and Luo Zhengshan},
keywords = {Rough sets, Beluga whale optimization, Extreme learning machines, Corrosion, Pipe failure pressure},
abstract = {In order to improve the accuracy of predictions of the failure pressure of a pipeline with single-point corrosion defects, and to simplify the calculation process, a model was devised using rough sets and the beluga whale optimization algorithm and an extreme learning machine. It was used with previously-published experimental data to extract key factors affecting failure pressure through attribute reduction. Beluga whale optimization was used to select the input weights and hidden layer biases of the extreme learning machine. Five-fold nested cross-validation and L2 regularization techniques were used to ensure the stability of the performance of the combined model. The results showed a mean absolute percentage error of the model’s predictions of 0.078. The model delivered smaller absolute errors than the ASME B31G, DNV RP F101, PCORRC, and SHELL92 evaluation standards. The average absolute error of the model’s calculation results was 71.5% smaller than that using the SHELL92 standard. The goodness of fit R2 (0.911) of this combination model for the prediction results of the external test set is closest to 1, and its performance is better than ELM, PSO-ELM, GA-ELM, XGBoost, MLP, Random Forest, GBDT and LightGBM. The failure pressure prediction model developed converges quickly, gives stable performance, and produces accurate predictions.}
}
@article{CHEN2026115769,
title = {GNS-GAN: A novel GAN model based on gradient noise suppression},
journal = {Applied Soft Computing},
volume = {202},
pages = {115769},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115769},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012172},
author = {Hongyou Chen and Lingfeng Qu and Baodan Tian and Yutong He and Yong Fan and Hadi Amirpour and Christian Timmerer and Yao Xin},
keywords = {Generative adversarial network (GAN), Deep learning, Adversarial learning stability, Sample gradient noise, Stochastic differential equation (SDE)},
abstract = {Generative adversarial networks (GANs) are widely applicable generative models. However, ensuring stability in adversarial learning remains a significant challenge in current GAN training. Gradient noise, among other factors, significantly impacts the stability of adversarial learning in GAN training. To improve the stability of adversarial learning, a gradient noise suppression generative adversarial network model (GNS-GAN) is proposed. This novel GAN addresses gradient noise by establishing stochastic differential equations (SDEs) for gradient noise in both the discriminator and the generator. The factors affecting the stability of adversarial learning are then analyzed using the assumed gradient noise distribution. Subsequently, an adversarial learning method is designed for the discriminator and generator to suppress gradient noise, thereby completing the adversarial training of GNS-GAN. To verify the performance of GNS-GAN, the experimental results are compared and analyzed using CELEBA, BEDROOM, and CIFAR10 datasets. The FID (Fréchet Inception Distance) values are 23.04 for CELEBA, 18.04 for BEDROOM, and 26.59 for CIFAR10. The GNS-GAN model has stable training performance in the tested datasets. These results demonstrate that the novel GAN model enhances the stability of adversarial learning and the quality of the generated images.}
}
@article{GHARIBZADEH2026115761,
title = {Trends and gaps in machine learning based flight delay prediction in spatiotemporal and data-driven approaches: A systematic review},
journal = {Applied Soft Computing},
volume = {202},
pages = {115761},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115761},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012093},
author = {Sonia Gharibzadeh and Mir Mohsen Pedram and Maryam Khademi and Afshin Salajegheh},
keywords = {Airline delay prediction, Machine learning, Flight delay forecasting, Deep learning, Ensemble models, Real-time prediction},
abstract = {Airline delay prediction is the task of estimating whether a flight will experience a delay and to what extent, using historical and real-time features. In recent years, machine learning (ML) and artificial intelligence (AI) techniques have been increasingly adopted to develop predictive models capable of learning complex, non-linear delay patterns across temporal and operational dimensions. This study presents a systematic literature review (SLR) of research published between 2010 and 2025 that applies ML and AI approaches to airline delay prediction problems. We analyze 72 primary studies retrieved from seven major digital libraries, with 48 high-quality studies selected for in-depth comparative analysis based on a rigorous quality assessment framework. The comparative performance of various ML techniques—including traditional algorithms, ensemble methods, deep learning, and hybrid models—is assessed. Additionally, we explore the role of exogenous data (e.g., weather, congestion) and the degree to which models address uncertainty, interpretability, and real-time deployment. Our findings show that machine learning techniques significantly improve the accuracy of delay prediction compared to classical statistical baselines. Ensemble models (e.g., XGBoost, LightGBM) and deep learning architectures (e.g., LSTM, CNN) consistently deliver higher predictive performance, particularly when external features like weather or temporal trends are included. However, we also identify inconsistencies in problem definitions, performance metrics, and limited attention to uncertainty quantification and deployment feasibility. The systematic review confirms the potential of ML and AI techniques for improving airline delay prediction across various modeling paradigms. Nevertheless, challenges remain in terms of standardization, interpretability, and real-time integration. This work provides a comprehensive synthesis of current progress and offers practical guidelines for future research to address methodological gaps and promote more reliable and deployable delay prediction systems in aviation.}
}
@article{ZHANG2026115772,
title = {Sentence-level sentiment classification model based on echo spiking neural P systems},
journal = {Applied Soft Computing},
volume = {202},
pages = {115772},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115772},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012202},
author = {Lingyun Zhang and Hong Peng and Jun Wang},
keywords = {Sentiment classification, Echo spiking neural P systems, Nonlinear spiking neural P system, Attention mechanism},
abstract = {With the explosive growth of text data, sentiment analysis has become increasingly critical in the field of artificial intelligence. The development of deep learning brings new opportunities, and a variety of models and mechanisms have emerged continuously. However, sentiment classification still faces many challenges, such as cross-domain adaptability, noise interference, and semantic relevance modeling. The Echo Spiking Neural P (ESNP) model is a novel echo-like recurrent architecture that avoids the long-range dependency issue present in traditional recurrent neural networks (e.g., LSTM and GRU). To address these challenges, this study proposes a new sentence-level sentiment classification model named BiESNP-AGAF. This model integrates bidirectional ESNP (BiESNP) with an innovatively designed affective-guided attention fusion (AGAF) module. The BiESNP processes context bidirectionally to capture semantic features, while AGAF fuses features at different granularities to enhance sentiment judgment. A sentiment classification framework is constructed through the word embedding layer, BiESNP layer, AGAF layer, and output layer. In experiments, five datasets are selected, and accuracy is used as the evaluation metric to assess the proposed BiESNP-AGAF. Comparisons with 14 state-of-the-art or baseline methods demonstrate that BiESNP-AGAF is high-performing for sentiment classification tasks and exhibits strong generalization capabilities.}
}
@article{KUMAR2026115751,
title = {Addressing class collision and representation collapse in contrastive clustering via pseudo-supervised triplet and InfoNCE losses},
journal = {Applied Soft Computing},
volume = {202},
pages = {115751},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115751},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011993},
author = {Abhishek Kumar and Dong-Gyu Lee},
keywords = {Self-supervised learning, Contrastive learning, Pseudo-supervised, Class collision, Representation collapse},
abstract = {Clustering has garnered considerable attention as a fundamental aspect of machine learning in recent times, owing to advancements in deep learning. Within deep clustering, Contrastive Clustering (CC) models play a pivotal role by endeavoring to establish a feature space wherein positive pairs, both at the instance and cluster levels, are appropriately grouped. Nonetheless, CC models encounter challenges concerning both class collision and representation collapse, which significantly impede their efficacy. In this paper, we introduce a pioneering self-supervised learning framework named Pseudo-Supervised Contrastive Clustering (PSCC), designed to tackle these challenges concurrently. PSCC capitalizes on pseudo-supervised triplet and InfoNCE losses, generating positive and negative pairs predicated on pseudo-labels derived from k-means clustering. The pseudo-supervised triplet loss accentuates the relative distance between positive pairs and carefully selected negative pairs, thereby alleviating the excessive partitioning predicament. Moreover, we incorporate a supervised InfoNCE loss utilizing pseudo-labels instead of true labels to mitigate insufficient partitioning tendencies. Through end-to-end optimization of the proposed framework, we demonstrate its competitive performance across moderate-scale clustering benchmark datasets. Furthermore, extensive experimental results validate our approach, showcasing state-of-the-art outcomes on large-scale datasets, including six benchmark datasets: CIFAR-10, CIFAR-20, ImageNet-10, ImageNet-Dogs, TinyImageNet, and ImageNet-1K, with significant improvements over state-of-the-art methods, such as achieving an NMI of 0.897 on CIFAR-10, outperforming ProPos by 1.1%, and an AMI of 0.588 on ImageNet-1K, surpassing ProPos by 6.3%.}
}
@article{DU2026115788,
title = {A classification fusion method using dual-factor source weights and fuzzy multi-neighborhood rough sets},
journal = {Applied Soft Computing},
volume = {202},
pages = {115788},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115788},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012366},
author = {Wenjuan Du and Tao Yan},
keywords = {Classification fusion, Fuzzy multi-neighborhood rough sets, QPSO, Mutual information, QWRCF},
abstract = {The current multisource classification fusion methods are often limited by the potential interactions among features derived from different sensors, the divergent levels of relevance of various information sources to decision attributes, and the underexplored role of rough set theory in fusion frameworks. The existing fusion methods often neglect these factors, which may lead to suboptimal classification accuracy. To address these issues, a classification fusion method named QWRCF (Quantum particle swarm optimization, source Weights, and Rough set for Classification Fusion) is proposed. This method integrates dual-factor source weights with a fuzzy multi-neighborhood rough set model. First, feature subsets are formed through Pearson correlation and hierarchical clustering, after which fuzzy C-means (FCM) and quantum particle swarm optimization (QPSO) are employed to identify the optimal feature combinations as information sources. Second, dual-factor source weights are derived by combining optimization-based weights with entropy-based weights, while a fuzzy probabilistic decision table is constructed from the classifier outputs. Based on this table, a fuzzy multi-neighborhood rough set model is developed to compute the adaptive fuzzy multi-neighborhood mutual information between each source and the class labels. Finally, the output classification fusion result aggregates the dual-factor source weights, the adaptive fuzzy multi-neighborhood mutual information, and the classifier probabilities. Extensive experiments conducted on fourteen datasets, including ten UCI datasets and four Kaggle datasets, three of which are real-world datasets, demonstrate that QWRCF outperforms eight competitive methods in terms of the accuracy, precision, recall and F1-score metrics.}
}
@article{ZHU2026115764,
title = {Zero-shot industrial image anomaly detection via CLIP-driven multi-scale aggregation and SAM-based local refinement},
journal = {Applied Soft Computing},
volume = {202},
pages = {115764},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115764},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012123},
author = {Hegui Zhu and Meiling Liu and Yinghao Zhang and Libo Zhang},
keywords = {Zero-shot anomaly industrial detection, Zero-shot anomaly segmentation, Cascade feature refinement, Segmentation anything model, Contrastive language image pre-training model},
abstract = {Industrial anomaly detection is essential for applications such as automated industrial inspection and medical diagnosis. However, many existing methods struggle with complex zero-shot anomaly classification and segmentation tasks. To address this challenge, we build on recent foundation models, specifically the Contrastive Language-Image Pre-training (CLIP) model for global classification and the Segment Anything Model (SAM) for precise boundary delineation. We propose a collaborative framework, SAM-AD, which integrates a CLIP-Vision Transformer (ViT) with SAM to improve anomalous region segmentation. The framework comprises three key components: (1) the Multi-scale Aggregation (MSA) module, which applies multi-scale convolution and re-scoring to patch features extracted by the CLIP visual encoder to generate coarse anomaly feature maps; (2) the Local Refinement Segmentation (LRS) module, which transforms these coarse maps into input prompts for SAM, producing refined anomaly maps with accurate boundaries; and (3) the New Image Features (NIF) module, which further aggregates and re-scores image features from the visual encoder to improve classification accuracy and generate final anomaly scores. Extensive experiments on the MVTec-AD and VisA datasets demonstrate that SAM-AD achieves state-of-the-art performance in both classification and segmentation. On MVTec-AD, the framework attains an image-level AUROC of 96.6% and AP of 98.9%; on VisA, it achieves a pixel-level AUROC of 94.8% and AP of 82.7%. These results establish SAM-AD as an effective approach for zero-shot industrial anomaly detection.}
}
@article{ZHONG2026115759,
title = {DGEC: Duality-graph enhancement cognitive module for YOLO series},
journal = {Applied Soft Computing},
volume = {202},
pages = {115759},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115759},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601207X},
author = {Muge Zhong and Xinyu Zhou and Yu Peng and Bin Chen and Xinru Tang},
keywords = {Object detection, YOLO series, Plug-and-play, Human-like cognition, Lightweight structure},
abstract = {Edge computing is vital in industrial production, marine monitoring, IoT, etc. YOLO-series models dominate real-time detection in edge computing, but existing methods demand massive datasets and high operational costs, which are scarce in edge scenarios. To solve this problem, we propose the Duality-Graph Enhancement Cognitive (DGEC) module, a lightweight plug-and-play enhancement module specifically designed for edge computing scenarios. It enables comprehensive target representation via a dual-path feature decoupling architecture: the Feature Graph (FG) uses Adaptive Feature Selection (AFS) and Learned Feature Sampler (LFS) for essential target feature extraction through multi-scale fusion. AFS, inspired by biological vision, enhances local current-layer features; LFS employs a learnable upsampling operator for wide-scale feature fusion and global integration. The Relation Graph (RG), based on confidence enhancement, constructs contextual associations between targets and the environment. Integrating DGEC boosts detection performance and generalization of the original YOLO architecture with negligible computational overhead. Experiments on the MS COCO dataset demonstrate that the DGEC method exhibits substantial advantages across various data scales—achieving a relative improvement of 4%–10% in AP with only a marginal increase of 0.25M parameters and 0.2 GFLOPs computational cost, while simultaneously demonstrating superior model generalization performance. These results confirm that DGEC serves as an effective lightweight enhancement module for edge YOLO deployment, achieving significant accuracy gains with minimal overhead, making it highly suitable for resource-constrained edge applications such as autonomous driving and agricultural intelligent monitoring.}
}
@article{SERVOTTE2026115780,
title = {Bayesian optimal experiment design for enhanced mineral weathering with gradient boosted decision trees},
journal = {Applied Soft Computing},
volume = {202},
pages = {115780},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115780},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012287},
author = {Thomas Servotte and Iris Janssens and Jakob Raymaekers and Tim Verdonck},
keywords = {Carbon dioxide removal, Mineral weathering, Optimal experiment design, Machine learning, Climate change mitigation, Gradient boosted decision trees},
abstract = {This paper introduces two novel methodologies for Bayesian Optimization in a batch setting, tailored to high-dimensional, mixed-variable experimental design in environmental applications, specifically carbon dioxide removal through enhanced mineral weathering. The first employs eXtreme Gradient Boosting (XGBoost) regression with the Output Configuration score to measure uncertainty, while the second uses a Categorical Boosting (CatBoost) Ensemble, deriving uncertainty from prediction variance. These methods address the challenges of complex environmental experimental spaces, offering improved scalability and adaptability over traditional Gaussian Process-based approaches. Evaluations using mixed-variable simulations on the Ackley, Griewank, Levy, Rastrigin and Schwefel benchmarks demonstrate the CatBoost Ensemble’s superior performance in high-dimensional settings. Validation on a real-world case from the Bio-Accelerated Mineral Weathering project using the CatBoost Ensemble showcases the method’s ability to outperform expert-designed experiments, accelerating the discovery of optimal conditions for carbon sequestration while minimizing resource expenditure. Our findings underscore the potential of Gradient Boosted Decision Tree-based methods, and in particular of the proposed CatBoost-based variant, to advance sustainable environmental technologies through optimized experimental design.}
}
@article{HAN2026115756,
title = {A dynamic risk propagation model with online learning for project portfolio selection under feedback mechanisms},
journal = {Applied Soft Computing},
volume = {202},
pages = {115756},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115756},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012044},
author = {Ruyue Han and Zhenyu Zhao and Mark Goh},
keywords = {Project portfolio selection, Online learning, Risk propagation, Feedback mechanism, Rolling optimization},
abstract = {In the context of intensified global competition, static risk weights have become insufficient to capture the dynamic characteristics of instantaneous coupling among projects, making the dynamic modeling of project portfolio risk propagation a core challenge for enterprise strategic decision-making. To address this, this paper constructs a dynamic risk propagation model integrating positive and negative feedback mechanisms. It further incorporates an incremental stochastic gradient descent algorithm alongside semantic penalty terms to achieve adaptive perception and online learning of risk propagation weights between projects. Furthermore, a periodic rolling project portfolio optimization framework is proposed. Results demonstrate that, compared to fixed-weight comparison models, this approach effectively enhances project portfolio stability while satisfying resource constraints and strategic objectives, ensuring the sustained selection of core projects. The model exhibits significant adaptability, with environmental adaptability improved by 38.3% relative to fixed-weight models. Through the analysis of the evolution trajectories of 4 typical paths, it has been verified that the proposed online learning model can effectively distinguish the dynamic characteristics of different types of risk propagation, providing a quantitative decision-making basis for differentiated risk management in dynamic environments.}
}
@article{BASHIR2026115590,
title = {Explainable ensemble learning framework for anxiety and stress detection in pediatric sleep EEG},
journal = {Applied Soft Computing},
volume = {202},
pages = {115590},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115590},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010380},
author = {Maria Bashir and Shaker El-Sappagh and Waleed Nazih and Abolghasem Sadeghi-Niaraki and Tamer Abuhmed},
keywords = {Anxiety, Stress, Pediatric sleep EEG, Ensemble machine learning, Explainable AI},
abstract = {Anxiety and stress are common pediatric mental health conditions that often emerge during childhood and adolescence and can significantly affect long-term well-being. However, differentiating between these conditions remains challenging because their symptoms often overlap, and clinical assessment can be subjective. This study proposes an explainable ensemble learning framework to support the objective screening of pediatric anxiety and stress using sleep Electroencephalogram (EEG) signals. A clinically verified cohort of 532 children, including 247 with anxiety and 285 with stress, was selected from the Nationwide Children’s Hospital Sleep DataBank. Six scalp EEG channels, F3, F4, C3, C4, O1, and O2, were analyzed using a standardized two-hour sleep window after signal filtering, artifact rejection, and annotation alignment. Approximate Entropy and Standard Deviation features were extracted from 30s epochs and used to train classical classifiers, static ensemble models, and dynamic ensemble selection methods optimized through Bayesian search. The proposed models were evaluated using patient-level stratified cross-validation to prevent data leakage and were further assessed on an independent external cohort from the Boston Children’s Hospital Sleep Corpus to examine cross cohort generalizability. Explainability was integrated using SHAP, LIME, and NeuroXAI to provide global, local, and neurophysiologically informed interpretations of model behavior. Compared with prior EEG studies, which are often limited by small cohorts, adult participants, or short task-based recordings, the proposed framework provides a lightweight, interpretable, and clinically relevant approach based on routine pediatric sleep EEG data. This work highlights the potential of explainable sleep EEG-based machine learning to support scalable, noninvasive, and transparent screening assistance for pediatric anxiety and stress.}
}
@article{KUYU2026115800,
title = {An intelligent reinforcement learning framework for sequential decision-making},
journal = {Applied Soft Computing},
volume = {202},
pages = {115800},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115800},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012482},
author = {Yigit Cagatay Kuyu},
keywords = {Sequential decision-making, Deep reinforcement learning, Uncertainty, LSTM, Transformer},
abstract = {Reliable decision-making under uncertainty remains a core challenge in deep reinforcement learning. A unified evaluation framework is presented to probe decision-making under epistemic and aleatoric uncertainty across four observability regimes using a standardized protocol. Representative model-free algorithms (policy- and value-based) are assessed with long short-term memory (LSTM) and transformer function approximators to isolate how architecture and uncertainty type interact. An enhanced deep Q-learning variant is also proposed as a baseline. Across uncertain settings, LSTM backbones often match or exceed transformer performance; noisy inputs are typically easier than limited-feedback settings, while belief-state outcomes vary by task and backbone. These findings suggest that robustness depends jointly on the learning algorithm and function approximator; within this framework, the included E-DQL baseline attains top or tied success rates in a majority of settings, with environment- and backbone-specific exceptions. Moreover, the side-by-side treatment of uncertainties, together with the systematic comparison of LSTM and transformer backbones across these regimes, is provided as a resource expected to aid future studies.}
}
@article{WANG2026115747,
title = {EWT-GAN: An escape-aware wasserstein transformer GAN for highly stealthy adversarial malware image generation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115747},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115747},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011956},
author = {Pan Wang and Yuntao Zhao and Yutao Hu and Yanwei Du and Xin Li},
keywords = {Adversarial malware generation, Generative adversarial networks, Transformer-based GAN, Structure-aware loss, Cybersecurity},
abstract = {Deep learning-based malware detectors that classify visualized executable files as grayscale images have become mainstream, yet their vulnerability to adversarial evasion remains a critical open problem. Existing GAN-based attack methods struggle with the inherent conflict between high evasion rates and preservation of visual structural fidelity, often resulting in either ineffective attacks or unnaturally distorted samples. To address this limitation, we propose EWT-GAN, an Escape-aware Wasserstein Transformer GAN specifically designed for generating highly stealthy adversarial malware images. EWT-GAN achieves an average evasion rate of 84.06%, SSIM of 0.480, an extremely low MSE of 0.18 (normalized to [0,1]) and the best FID of 49.8 by employing a hybrid residual-Transformer generator, a structure-aware perceptual loss combining SSIM and MSE, an explicit escape loss that directly maximizes misclassification confidence on incorrect classes and an evasion rate-guided three-stage training curriculum. It significantly outperforms eight state-of-the-art baselines, including TransGAN and AdvGAN, across all four metrics. These results establish a new state-of-the-art in visual adversarial malware generation and expose severe vulnerabilities in current image-based detection systems, underscoring the urgent need for more robust defenses.}
}
@article{CHENG2026115792,
title = {MFAFormer: Multi-scale feature enhancement with axial transformer for medical image segmentation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115792},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115792},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012408},
author = {Dongxu Cheng and Jingwen Zhang and Qiwei Dong and Yan Yang and Yuhui Zheng},
keywords = {Axial Transformer, Macro-convolution, Cross-scale feature fusion, Attention-gated mechanism},
abstract = {Medical image segmentation is fundamental to biomedical analysis, supporting diagnosis, lesion localization, organ mapping, and treatment planning, yet challenges persist, such as boundary ambiguity, lesion shape/size variability, and imprecise target localization.The development of U-shaped architectures for segmentation is constrained by a key trade-off that CNNs are limited in their ability to capture long-range interactions, whereas Transformers achieve this at the expense of high computational complexity and a loss of fine-grained spatial information. To overcome these limitations, this paper introduces a novel multi-scale feature enhancement method with axial Transformer for medical image segmentation, termed MFAFormer, which effectively integrates the local detail with global contextual information. MFAFormer consists of three novel modules, i.e., the multi-level feature supplement module (MLFS), the cross-scale feature enhancement module (CFE), and the dual-directional decoder via axial Transformer (D2AFormer), which enhance the feature representation for better segmentation performance. Firstly, the MLFS module selectively supplements and fuses multi-scale features of encoders by an aggregated attention-gated mechanism. Secondly, the CFE module further integrates the multi-attention mechanism to enhance the feature transmission. Finally, the D2AFormer module adopts a cyclical complementary structure, which jointly employs dual-directional convolutions and axial Transformers to improve the comprehensive feature representation ability for local details and long-range contextual information. Comprehensive experiments on public datasets are conducted to evaluate the proposed MFAFormer. The experimental results reveal substantial improvements over state-of-the-art methods, validating its potential for accurate medical image segmentation.}
}
@article{SHU2026115784,
title = {Time series anomaly detection method inspired by nonlinear spiking neural P model with autapses},
journal = {Applied Soft Computing},
volume = {202},
pages = {115784},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115784},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012329},
author = {Zhihui Shu and Mingtao Jiang and Hong Peng and Nijing Yang and Jun Wang},
keywords = {Multivariate time series, Anomaly detection, NSNP-AU model, Feature transformer encoder layer, Variational autoencoder},
abstract = {Anomaly detection in multivariate time series focuses on recognizing unusual patterns or sequences that diverge from normal dynamics, benefiting fields such as social platforms, industrial systems, and financial markets. In practice, however, complex feature interrelationships and the scarcity of anomalous events make it challenging to capture both temporal dependencies and feature correlations. To address this challenge, an anomaly detection method based on nonlinear spiking neural P model with autapses (AD-NSNP-AU) for multivariate time series is introduced in this study. Building upon variational autoencoder (VAE) architecture, the model innovatively incorporates the nonlinear spiking neural P model with autapses (NSNP-AU model), offering a novel approach to addressing time series anomaly detection. In AD-NSNP-AU, the NSNP-AU model is integrated with the attention mechanism to capture temporal dependencies at the encoding step, while Transformer encoder layers extract feature correlations. The two feature types are then effectively integrated by a multi-head self-attention mechanism, which highlights and extracts the critical features. In the decoding phase, an NSNP-AU-based network reconstructs the time series. The performance of AD-NSNP-AU is shown to be superior in experiments across four public datasets, with the model securing the top rank in F1 scores against twelve baseline methods and achieving a recall close to 1 on the Mars Science Laboratory (MSL) dataset.}
}
@article{GURJWAR2026115812,
title = {Granular ball feedforward network for fake news detection},
journal = {Applied Soft Computing},
volume = {202},
pages = {115812},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115812},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012603},
author = {Rajiv Kumar Gurjwar and Alok Kumar and Udai Pratap Rao},
keywords = {Fake news detection, Granular ball clustering, Feedforward neural networks, ERNIE embeddings, Lightweight text classification, Misinformation detection},
abstract = {The increasing prevalence of fake news presents critical challenges for engineering systems that require accurate and scalable text classification. This paper introduces the Granular Ball Feedforward Neural Network (GB-FFN), a novel architecture that integrates granular ball clustering with a single-layer feedforward neural network for fake news detection. The proposed approach first compresses dense textual embeddings into high-purity semantic clusters, reducing noise and feature dimensionality. These cluster centroids then serve as inputs to the neural classifier, enhancing class separability while maintaining a lightweight model structure. Experimental results on four benchmark datasets, ISOT, GossipCop, WELFake and PolitiFact show that GB-FFN achieves high predictive performance, with F1-scores of 97.47%, 97.96%, 96.12% and 91.71% respectively. Compared to a variant without clustering, GB-FFN demonstrates improvements of up to 9.93% in F1-score. Further analysis indicates that the performance gains achieved by GB-FFN are dataset-dependent, with particularly strong improvements observed on large-scale and noisy datasets. These findings suggest that combining granular ball clustering with shallow neural networks can offer an effective and computationally efficient approach for fake news detection in suitable data regimes.}
}
@article{TSAI2026115828,
title = {True sine cosine algorithm for continuous optimization problems: Bias analysis, potential corrections, and fundamental improvements},
journal = {Applied Soft Computing},
volume = {202},
pages = {115828},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115828},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012767},
author = {Hsing-Chih Tsai and Jun-Yang Shi},
keywords = {Sine cosine algorithm, Continuous optimization, Metaheuristics, Biased performance, Evolutionary computation},
abstract = {This study examines search biases in the sine cosine algorithm (SCA), a popular optimization method, and proposes new variants to enhance performance. Two algorithmic corrections are suggested: removing the absolute value operator and the parameter r3 from the position update equation. The original SCA's bias favors functions with optima at the coordinate origin but performs poorly in shifted domains. A new variant, TSCA3, is proposed to integrate individual-wise updating and evolutionary processes. Numerical results on the CEC2005 and CEC2019 benchmark suites indicate that TSCA3 achieves lower mean function errors than the original SCA and attains near-complete dominance in pairwise statistical tests for both low- and high-dimensional cases. Compared to classical metaheuristics, TSCA3 exhibits competitive performance on high-dimensional and shifted problems. Analyses of population diversity and exploration–exploitation balance confirm that TSCA3 transitions from broad initial exploration to concentrated late-stage exploitation. This transition enables faster and more reliable convergence on continuous optimization tasks. TSCA3 offers fundamental improvements and integration potential, serving as a robust alternative to the original SCA. This research also highlights potential limitations in benchmark functions with global optima near the origin and emphasizes the need for diverse optimal points in continuous optimization assessments.}
}
@article{CHEBOXAROV2026115715,
title = {Interactive engineering education with simplified model of a wind power plant control},
journal = {Applied Soft Computing},
volume = {202},
pages = {115715},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115715},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011634},
author = {Victor V. Cheboxarov},
keywords = {Automatic control, Wind power plant, Simulation, Simulink, Methodology},
abstract = {This paper addresses the challenge of providing interactive practical education in the automatic control of renewable power plants. A lack of simple educational tools in this field was revealed during the state-of-the-art review. A nonlinear dynamic model, incorporating a power control circuit through pitch angle adjustment in a wind turbine for the “Automatic Control and Protection of Power Plants with Renewable Energy Sources” course is proposed and verified. Despite essential simplifications, dynamic processes resembling those observed in real wind power plants can be simulated with the model. While the course encompasses a mere 17 hrs of practical sessions, the described technique enables undergraduate students to go through all stages of developing an automatic system. The educational methodology comprising the model development in the process of practical sessions, and the design project implementation has been positively evaluated by 75% of students. It is discussed how a reasonable trade-off between group and individual tasks associated with the proposed model for students with different skill levels can be achieved. Future works may be summarized as a more realistic representation of aerodynamic and electromagnetic blocks, as well as an introduction to some advanced control techniques, while keeping the basic model structure intact.}
}
@article{GAO2026115752,
title = {Transformer UNet with super token attention for medical image segmentation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115752},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115752},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012007},
author = {Peng Gao and Ling-Xin Xia and Xiao Liu and Fei Wang and Ru-Yue Yuan},
keywords = {Medical image segmentation, Deep learning, Attention mechanism, Neural network},
abstract = {Accurate segmentation of medical images requires a careful balance between leveraging local features and addressing long-range dependencies. Transformers, through their self-attention mechanisms, effectively model global contexts and long-range dependencies, overcoming the spatial limitations of convolutional neural networks. However, a major drawback of Transformers is their quadratic computational complexity relative to the number of visual tokens, which creates significant challenges when processing high-fidelity medical image segmentation. In this study, we propose Super Token Attention UNet, a novel framework designed to address these issues. Our method introduces a super token space, where similar visual tokens are grouped, and each group is represented by a single super token that aggregates its information. This strategy allows efficient global context computation without sacrificing accuracy. However, the token aggregation process within the U-shaped encoder–decoder architecture may introduce semantic inconsistency between hierarchical features. To address this, we leverage semantic consistency regularization and internal feature distillation techniques to mitigate semantic loss and reduce feature redundancy, thereby ensuring stable and accurate feature representations across network layers. Experimental results across four medical imaging datasets demonstrate that our method achieves state-of-the-art segmentation performance while maintaining low model complexity, offering an efficient solution for high-fidelity medical image analysis.}
}
@article{TING2026115804,
title = {Shared energy storage capacity optimization and cost sharing in community coalitions based on master-slave game theory and improved shapley value model},
journal = {Applied Soft Computing},
volume = {202},
pages = {115804},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115804},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012524},
author = {Zhang Ting and Li Jianpan and Li Yifan and Meihui Wang and Runbo Tian and Ma Xiaoqian},
keywords = {Shared energy storage, Community coalition, Master-slave game, Improved shapley value, Cost allocation},
abstract = {With the continued growth in user-side distributed energy investment and the rise of the sharing economy, the demand for flexibility absorption has increased significantly. How to realize the efficient and scientific configuration and cost sharing of Shared Energy Storage (SES) on the user side has become the key to achieving energy consumption revolution and promoting low-carbon development. In view of this, this paper first proposes a bilevel SES capacity optimization model in community coalition considering the social hierarchical relations and dual discrepancy benefits of the SES operator and the users in the community coalition based on master-slave game theory. Secondly, an improved Shapley value allocation strategy is proposed considering both net output and environmental protection contribution, aiming to achieve a fair and reasonable cost allocation of daily electricity cost (DEC) within the community coalition of all participating entity. Empirical analysis has verified the effectiveness of this model in reducing the DECs of the community coalition by 14.13%, increasing the photovoltaic (PV) consumption rate by up to 100%, and alleviating the transmission pressure on the regional power distribution network during peak periods. Sensitivity analysis shows that the construction cost of energy storage equipment is the main barrier to current SES development. This research not only provides a new and practical planning path for the capacity optimization of SES in community coalitions, but also offers strong economic incentives for the sustainable development of community coalitions through the improvement of cost allocation strategies. Since the capacity optimization of SES and cost sharing in community coalition considering complex social hierarchical relations has not been deeply studied yet, this paper contributes to literature and expands knowledge.}
}
@article{RULLO2026115796,
title = {Detecting the invisible without knowledge: Unsupervised packet-based real-time detection of slow DoS attacks},
journal = {Applied Soft Computing},
volume = {202},
pages = {115796},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115796},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012445},
author = {Antonino Rullo and Enrico Cambiaso and Massimo Guarascio},
keywords = {Intrusion detection system, Slow DoS, Denial of service, Deep learning, Unsupervised learning},
abstract = {Slow DoS attacks are stealthy threats that operate at a much lower packet rate than flooding-based DoS attacks, allowing them to blend seamlessly with normal traffic and evade detection. While several solutions have been proposed in the literature, most rely on labeled attack data, which is often unavailable, or depend on flow-level features, which are resource-intensive and may not enable timely detection. To overcome these limitations, we define a machine learning-based intrusion detection system that requires no prior knowledge of malicious traffic and operates at the packet level, enabling real-time detection. Unlike flow-level approaches, packet-based analysis does not require maintaining long-lived per-flow state or reconstructing high-volume traffic aggregates, which can be computationally expensive in high-throughput environments. Our solution is based on a three-phase approach: First, the preprocessing phase normalizes incoming network traffic using a risk-aware strategy designed to highlight deviations that may indicate malicious behavior. Next, the anomaly-detection phase employs an unsupervised neural model to distinguish normal traffic from anomalous patterns. Finally, the postprocessing phase refines the model’s output and, whenever an attack is detected, identifies the attacker’s IP address. We evaluate the proposed IDS against three real-world datasets under various slow DoS attacks. Experimental results demonstrate detection performance comparable to that of supervised methods.}
}