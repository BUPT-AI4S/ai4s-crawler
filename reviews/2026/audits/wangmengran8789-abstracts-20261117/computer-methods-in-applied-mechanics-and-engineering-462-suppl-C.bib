@article{NIEHUSER2026119301,
title = {Smooth single-yield-surface formulations for rate-independent crystal plasticity – Theory and numerical implementation},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119301},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119301},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005748},
author = {Alexander Niehüser and Jörn Mosler},
keywords = {Crystal plasticity, Polycrystal, Smooth yield function, Rate-independent, Finite deformation},
abstract = {Crystal plasticity theory provides a framework for multiscale analysis of plastic deformation that explicitly incorporates crystallographic information into the constitutive model. However, the classic multi-surface yield criterion exhibits a yield surface with sharp corners, which causes numerical challenges in identifying active slip systems and computing the corresponding plastic slips. In this regard, single-yield-surface formulations offer a promising approach to alleviate these issues by replacing the original non-smooth yield surface with a smooth approximation. In this work, such single-yield-surface formulations are realized through effective yield functions based on the LogSumExp function and the p-norm. Compared with existing effective-yield-function approaches, the proposed formulations are embedded in a hyperelastic crystal plasticity framework and cast within the generalized standard materials (GSM) framework, thereby providing a thermodynamically consistent setting. A new parameter allows the effective yield functions to consistently under- or overestimate the original yield domain, thereby extending formulations that approximate the yield surface only from one side. An a priori estimate relates the LogSumExp and p-norm exponents such that both formulations achieve the same prescribed approximation quality relative to the classic multi-surface yield criterion, enabling an error-controlled parameter selection. Due to the common structure of the governing equations, both models are implemented in a unified fully implicit Newton scheme with a line search strategy and suitable slip-variable predictors. Several numerical examples demonstrate the robustness and efficiency of the proposed effective formulations, including representative volume simulations of a DP800 polycrystal subjected to a deformation path mimicking flat rolling. Compared with an augmented Lagrangian solution of the original multi-surface problem, the LogSumExp and p-norm formulations show comparable accuracy and robustness when their exponents are chosen according to the proposed estimate, while substantially reducing the number of Newton iterations and the computational effort.}
}
@article{VOTRUBA2026119277,
title = {Nonlinear GENERIC-Embedded Neural Networks (N-GENNs): Learning GENERIC dynamics with non-quadratic dissipation potentials},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119277},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119277},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005505},
author = {Vojtěch Votruba and Zequn He and Weilun Qiu and Celia Reina and Michal Pavelka},
keywords = {Structure-preserving machine learning, GENERIC, Non-equilibrium thermodynamics, Non-quadratic dissipation potential, Non-linear dynamics, Generalized gradient flows},
abstract = {We introduce Nonlinear GENERIC-Embedded Neural Networks (N-GENNs), a deep learning framework for discovering evolution equations of systems governed by the nonlinear GENERIC formalism (General Equation for Non-Equilibrium Reversible–Irreversible Coupling). Such systems exhibit coupled conservative and dissipative dynamics, and can be described via the superposition of a Hamiltonian flow and a generalized gradient flow. In contrast to existing approaches, our formulation incorporates generalized gradient flows via convex dissipation potentials, enabling the identification of a broader class of thermodynamically consistent dynamics, including systems with non-quadratic dissipation potentials. Thermodynamic structure is strongly enforced by construction through suitable reparameterizations of both the reversible operator and the dissipation potential, ensuring exact compliance with the first and second laws of thermodynamics. We validate the proposed approach on three representative examples: a harmonic oscillator coupled to a heat bath, an idealized chemical motor, and a one-dimensional viscoplastic model of Perzyna type. These results demonstrate the method’s ability to accurately infer thermodynamically consistent models from data for systems incorporating both conservative and nonlinear dissipative dynamics.}
}
@article{GORGI2026119293,
title = {The isogeometric Gap-Shifted Boundary Method},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119293},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119293},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005669},
author = {Andrea Gorgi and Nicolò Antonelli and Alejandro Cornejo and Guglielmo Scovazzi and Riccardo Rossi},
keywords = {Shifted Boundary Method (SBM), Gap-SBM, Isogeometric analysis (IGA), Unfitted boundary methods},
abstract = {High-order immersed methods offer significant advantages for the simulation of complex geometries, but their practical performance is often limited by a trade-off between accuracy, robustness, and numerical conditioning. In this work, we present a high-order isogeometric extension of the Gap–Shifted Boundary Method (Gap–SBM) for linear elasticity in two and three dimensions. The method explicitly reconstructs and integrates the geometric gap between the surrogate and true boundaries, while extending the active spline approximation into this region through complete high-order Taylor expansions. The gap cells are used exclusively for integration and introduce no additional degrees of freedom. In two dimensions, the gap is represented by curvilinear Coons patches, supplemented by hierarchical subdivision when the boundary geometry is under-resolved. In three dimensions, a robust pyramidal–tetrahedral decomposition is introduced, with curved geometric entities constructed consistently with the spline degree. Different strategies for prescribing boundary conditions on the reconstructed boundary are investigated, including direct imposition, interpolation, and enhanced SBM extrapolation. The latter substantially reduces the residual geometric error when the reconstructed and true boundaries do not coincide exactly, while direct imposition remains compatible with a symmetric Nitsche formulation. The numerical results demonstrate optimal convergence rates for immersed Dirichlet and Neumann boundary conditions in both two and three dimensions. The Gap–SBM retains the expected h−2 condition-number scaling, with a lower conditioning constant than the standard SBM, and remains accurate for geometries containing characteristic length scales substantially smaller than the background mesh size. Applications to exact CAD surfaces and complex STL-derived geometries illustrate the robustness and flexibility of the proposed workflow. These benefits are obtained without increasing the algebraic problem size, at the expense of additional geometric preprocessing and quadrature costs, which become more significant for high-order three-dimensional reconstructions.}
}
@article{TYAGI2026119317,
title = {Multiscale structural reliability analysis in high dimensions with tensor trains and physics-augmented neural networks},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119317},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119317},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005906},
author = {Aryan Tyagi and Alex {de Beer} and Tiangang Cui and Jan N. Fuhg},
keywords = {Reliability analysis, Tensor Train Decomposition, Voigt–Reuss Neural Networks, Fiber Reinforced Composite, Random fields},
abstract = {Structural reliability evaluation for composites constitutes a fundamentally high-dimensional multiscale problem, as microscale material uncertainties (e.g., fiber volume fraction and constituent moduli) must propagate to the macroscale and can be quantified as random fields. Conventional approaches are computationally intractable, as they rely on repeatedly solving tightly coupled partial differential equation systems across scales while contending with the exponential complexity inherent in uncertainty quantification. This work introduces a scalable and physically consistent framework that addresses both bottlenecks simultaneously in the case of separation of scales and (anisotropic) linear elasticity. In particular, we couple a physics-augmented Voigt–Reuss Neural Network (VRNN) with the Deep Inverse Rosenblatt Transport (DIRT) method to estimate the posterior probability of structural failure. The VRNN is used to resolve the computationally expensive FE2 scheme by providing a near-instantaneous evaluation of the homogenized stiffness tensor that is guaranteed to be symmetric, positive-definite, and strictly bounded within the Voigt–Reuss limits. The DIRT method constructs a sequence of functional tensor train approximations to efficiently store an approximation of the high-dimensional optimal importance sampling distribution for estimating the probability of failure under the VRNN surrogate. This mitigates the curse of dimensionality arising from the Karhunen–Loève (KL) expansion of the random fields. The framework is demonstrated on a three-dimensional heterogeneous benchmark problem, where the uncertainty in the microscale material properties is characterized by a Bayesian posterior distribution obtained from limited strain observations. Our results show that the DIRT-based estimator can provide low-variance estimates of failure probabilities in dimensions up to 150.}
}
@article{FAN2026119288,
title = {Physically interpretable representation learning with Gaussian Mixture Variational AutoEncoder (GM-VAE)},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119288},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119288},
url = {https://www.sciencedirect.com/science/article/pii/S004578252600561X},
author = {Tiffany Fan and Murray Cutforth and Marta D’Elia and Alexandre Cortiella and Alireza Doostan and Eric Darve},
keywords = {Interpretability, Representation learning, Dimension reduction, Scientific machine learning, Turbulent combustion},
abstract = {Extracting compact, physically interpretable representations from high-dimensional scientific data is a persistent challenge due to the complex, nonlinear structures inherent in physical systems. We propose a Gaussian Mixture Variational Autoencoder (GM-VAE) framework designed to address this by integrating an Expectation–Maximization (EM)-inspired training scheme with a novel spectral interpretability metric. Unlike conventional VAEs that jointly optimize reconstruction and clustering (often leading to training instability), our method utilizes a block-coordinate descent strategy, alternating between expectation and maximization steps. This approach stabilizes training and naturally aligns latent clusters with distinct physical regimes. To objectively evaluate the learned representations, we introduce a quantitative metric based on graph-Laplacian smoothness, which measures the coherence of physical quantities across the latent manifold. We demonstrate the efficacy of this framework on datasets of increasing complexity: surface reaction ODEs, Navier–Stokes wake flows, and experimental laser-induced combustion Schlieren images. The results show that our GM-VAE yields smooth, physically consistent manifolds and accurate regime clustering, offering a robust data-driven tool for interpreting turbulent and reactive flow systems.}
}
@article{DU2026119309,
title = {HUG-VAS: A hierarchical NURBS-based generative model for aortic geometry synthesis and controllable editing},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119309},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119309},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005827},
author = {Pan Du and Mingqi Xu and Xiaozhi Zhu and Jian-Xun Wang},
keywords = {Statistical shape modeling, NURBS, Generative AI, Semi-automatic segmentation},
abstract = {Accurate, patient-specific vascular geometry is pivotal for diagnosis, planning, and device design, yet existing statistical shape modeling (SSM) pipelines rely on linear priors and topology-specific preprocessing that limit realism, scalability, and interoperability. We present HUG-VAS, a Hierarchical NURBS Generative framework for Vascular models, that unifies NURBS-based 3D shape encoding with diffusion-based generative modeling to synthesize fine-grained, CFD-ready aortic anatomies. HUG-VAS factorizes shape into (i) vessel centerlines generated by a denoising diffusion model and (ii) cross-sectional radius profiles synthesized by a classifier-free guided diffusion model conditioned on the centerline, thereby decoupling and preserving stochastic variability across these two anatomical layers. Beyond unconditional synthesis, we enable training-free, zero-shot conditional generation via diffusion posterior sampling from image-derived prompts (e.g., sparse 3D points, slice contours, or partial surface patches), supporting interactive semi-automatic segmentation, editing and robust reconstruction under degraded imaging. Trained on 21 patient-specific MRA cases, HUG-VAS generates multi-branch aortas with supra-aortic vessels whose biomarker distributions closely match the source cohort, and whose watertight NURBS outputs directly integrate with downstream CFD solvers. To our knowledge, HUG-VAS is the first SSM frameworks to unify NURBS parameterization, hierarchical diffusion, and DPS-based zero-shot conditional generation, enabling reconstruction and completion of vascular geometry from sparse, partial geometric priors without retraining.}
}
@article{JABAREEN2026119246,
title = {Thermodynamic regularization based computational framework for strain-induced crystallization},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119246},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119246},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005190},
author = {Mahmood Jabareen and Vu Nguyen-Xuân and Mikhail Itskov and Jean-Benoît {Le Cam} and Vu Ngoc Khiêm},
keywords = {Thermodynamic regularization, Analytical inelasticity, Single potential formulation, Natural rubbers, Strain-induced crystallization, Loss of ellipticity},
abstract = {Strain-induced crystallization is a type of phase transition in natural rubbers triggered by deformation. The computation of this phenomenon necessitates proper numerical regularization due to the loss of ellipticity at the onset of strain-induced crystallization. This challenge is intensified by the absence of internal dissipation in such thermodynamic irreversible process, which precludes the use of dissipation potentials commonly employed in the literature. In this paper, we extend the recently developed thermodynamic regularization technique (i.e., regularization on the basis of thermodynamics of internal variables) to the case of natural rubbers, and formulate a novel computational framework for strain-induced crystallization which exhibits no internal dissipation. The computational framework coupling four fields (displacement, temperature and two nonlocal interactions) is then demonstrated through multiple numerical benchmarks and comparison with experimental data.}
}
@article{CHEN2026119331,
title = {Three-dimensional synergistic topology optimization of plate structures: Exploiting the through-thickness design space via the CUF approach},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119331},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119331},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526006043},
author = {Zhaojin Chen and Xueyan Hu and Bin Wu and Erasmo Carrera and Weiqiu Chen},
keywords = {Thin-walled structures, Topology optimization, Carrera Unified Formulation (CUF), Synergistic optimization, Through-thickness design},
abstract = {The lightweight design of thin-walled structures depends on the spatial distribution of materials in three dimensions. Conventional plate topology optimization based on plate or shell elements, however, is restricted to a two-dimensional (2D) design space on the reference surface and lacks design freedom in the thickness direction, whereas applying a fully three-dimensional (3D) solid formulation to plate design suffers from high computational cost, locking, and a tendency to generate non-manufacturable closed internal voids. To address these limitations, this paper proposes a CUF-based 3D synergistic topology optimization framework that extends plate topology optimization with design freedom in the thickness direction. Exploiting the section expansion capability of the CUF, an implicit geometric projection strategy is introduced to describe the 3D topology through two sets of 2D design variables, which reduces the size of the optimization problem and avoids closed internal voids, thereby improving manufacturability. Benchmark and representative numerical examples show that the proposed framework reproduces the transition from membrane-dominated to bending-dominated mechanical behavior. Compared with conventional 3D topology optimization, the present approach reduces the number of design degrees of freedom while preserving numerical accuracy in the thin-plate limit (locking-free), providing an explicit 3D geometric design paradigm for plate structures.}
}
@article{LOCKETT2026119294,
title = {A discontinuous Galerkin framework for the radiative transfer approximation of high-frequency wave problems},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119294},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119294},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005670},
author = {Robert J. Lockett and David J. Chappell},
keywords = {High frequency waves, Discontinuous galerkin, Radiative transfer equation, Ray-tracing},
abstract = {High-frequency wave energy transport is investigated in bounded domains with piecewise constant wave speed using a radiative transfer equation based model. We develop a powerful and efficient discontinuous Galerkin framework including both Fourier and discrete ordinate discretisations in the direction variable, which is widely applicable for wave problems arising within acoustics, elasticity and electromagnetics. Key features of the discontinuous Galerkin scheme implementation include fast exact quadrature for piecewise polynomial basis functions on general polygonal elements, together with an efficient parallel implementation. The scheme is benchmarked against both exact solutions and previous simulation results, demonstrating optimal convergence of the method with refinement of the grid as well as demonstrating convergence when increasing the spatial polynomial degree (alongside refinement of the directional discretisation) on a fixed coarse polygonal grid. As a final test, the scheme is applied to an example with more intricate geometric features requiring finer meshing and having millions of degrees of freedom. As well as producing converged results within competitive simulation times, the method was also used to investigate the inclusion of evanescent waves within the reflection and transmission laws for flexural plate motion between regions of different plate thickness. The expected trend was observed, with the inclusion of evanescent waves becoming less significant as the excitation frequency is increased.}
}
@article{WANG2026119286,
title = {A unified energy-dissipative framework for non-isothermal anisotropic dendritic growth via enthalpy reformulation},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119286},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119286},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005591},
author = {Yan Wang and Hong Zhang and Xu Qian},
keywords = {Non-isothermal phase field system, Anisotropic dendritic growth, Energy dissipation, Enthalpy reformulation, Double stabilization},
abstract = {A canonical model for describing anisotropic dendritic growth is the non-isothermal gradient flow system, which couples an Allen–Cahn-type phase-field equation with the evolution of temperature. This coupled system presents severe challenges for efficient numerical discretization: double time derivatives in the temperature equation, strong stiffness and nonlinearity induced by anisotropic interfacial energy, the double-well potential, and latent heat coupling, as well as the inherent difficulty of preserving the original energy dissipation law. To address these, we develop a unified energy-dissipative framework for both exponential-time-differencing Runge–Kutta and implicit–explicit Runge–Kutta integrators. The novelty lies in a structure-preserving enthalpy reformulation that eliminates time-derivative coupling and recovers a hidden mixed L2-H−1 variational structure, paired with a sharp double stabilization strategy enabling explicit discretization of nonlinearities. Using a compact matrix–vector formulation, we rigorously prove the unconditional energy dissipation of proposed schemes, with numerical experiments verifying up-to-fifth-order convergence and robust performance for dendritic growth simulation.}
}
@article{LI2026119282,
title = {The Gap-Shifted Boundary Method for solid mechanics problems: Linear elasticity, hyperelasticity and elastoplasticity},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119282},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119282},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005554},
author = {Kangan Li and Tushar Mittal and J. Haydel Collins and Guglielmo Scovazzi},
keywords = {Shifted Boundary Method, Embedded domains, Elasticity, Hyperelasticity, Elastoplasticity},
abstract = {Immersed finite element methods significantly alleviate the burden of body-fitted mesh generation for complex geometries, yet they frequently suffer from algorithmic complexities associated with cut-cell numerical integration and matrix ill-conditioning. The Shifted Boundary Method (SBM) circumvents these pathologies by shifting the imposition of true boundary conditions to a surrogate boundary composed of full edges/faces of the grid. Boundary conditions are modified by means of Taylor expansions across the surrogate-to-true distance vectors. However, the standard primal-SBM produces sub-optimal error convergence in the L2-norm on linear finite elements, when Neumann (traction) boundary conditions are present. To overcome this fundamental limitation and recover optimal accuracy, we develop the Gap-Shifted Boundary Method (Gap-SBM), which introduces approximate integration formulas to account for the virtual work contribution in the gap between the surrogate and true boundaries. These special quadratures avoid integration over cut cells. We comprehensively derive and implement the Gap-SBM for linear elasticity, finite-strain hyperelasticity, and path-dependent small-strain elastoplasticity. Numerical benchmarks on intricate topologies, including Triply Periodic Minimal Surfaces (TPMS) and rough fracture networks, demonstrate that Gap-SBM consistently delivers high-fidelity stress and yielding predictions, and facilitates the nonlinear Newton–Raphson convergence. The proposed framework establishes a robust, optimal, and geometrically flexible tool, bridging the gap between automated, unfitted meshing workflows and robust high-fidelity structural mechanics algorithms, providing foundations for extension to coupled Biot poromechanics, damage mechanics, and frictional-contact formulations on rough fracture surfaces.}
}
@article{ZHANG2026119327,
title = {A coupled thermo-chemo-mechanical framework for He-induced fracture under extreme thermal transients via crystal plasticity and phase-field methods},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119327},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119327},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526006006},
author = {Zhi-Yi Zhang and Shao-hua Yin and Lu-Wen Zhang},
keywords = {Phase-field fracture method, Multi-field coupling, Helium-induced damage, Intergranular cracking, Fracture energy degradation},
abstract = {Under extreme thermal transients, the nonlinear and strongly coupled evolution of mass diffusion and local damage in polycrystalline microstructures becomes particularly pronounced. To address the challenge that helium-induced intergranular cracking, driven by intense localized heat sources, poses to predictive computational mechanics, this work develops a fully coupled thermo-chemo-mechanical-damage crystal plasticity model within a thermodynamically consistent framework. Multi-field energetic self-consistency is ensured through a unified Helmholtz free energy functional. The formulation incorporates a thermally activated dislocation-density constitutive model with a helium diffusion equation co-driven by hydrostatic stress and thermal gradients. To bridge the coupled physics with the fracture response, a nonlinear toughness degradation law is dictated by helium concentration and thermal states, while monotonic crack irreversibility is enforced by reconstructing the history field variable. Following validation against standard benchmarks, the model is applied to simulate the polycrystalline fracture by incorporating in-situ measured underwater welding thermal histories as realistic boundary conditions. The results elucidate the damage mode transition from diffuse intragranular microcracks to dominant intergranular fracture with increasing initial helium concentration. A positive-feedback mechanism among grain-boundary plastic incompatibility, helium segregation, and damage evolution at the crystallographic level is revealed, and shows that high-angle grain boundaries exhibit markedly higher fracture susceptibility under multi-field coupling. This framework offers a robust basis for analyzing multiphysics fracture in advanced alloys under extreme service environments.}
}
@article{QIAN2026119326,
title = {Frobenius-theory-based scaled boundary finite element solution for variable-coefficient elliptic problems with corner singularities},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119326},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119326},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005992},
author = {Yixin Qian and Zhihao Ren and Yuji Miao and Minggang Tang},
keywords = {Elliptic partial differential equations, Corner singularities, Scaled boundary finite element method, Frobenius theory, Wave diffraction},
abstract = {Many engineering problems are described by elliptic partial differential equations (PDEs) with approximate boundary conditions. Sharp corners of boundary geometries may give rise to singularities in solutions. While mainstream finite and boundary element methods perform well for smooth solutions, the accuracy and convergence rate degrade near the corners. The scaled boundary finite element method (SBFEM) is capable of resolving corner singularities with no need for analytical singular functions. Nevertheless, existing SBFEM schemes cannot natively accommodate corner singularity behaviors alongside variable-coefficient effects. This work develops a generalized SBFEM framework for variable-coefficient elliptic PDEs. A Frobenius-theory-based algorithm is derived to build complete fundamental solution spaces and eliminate eigenvalue resonance. Theoretical derivation reveals that corner singularity characteristics are mainly controlled by the constant term of diffusion coefficients. Single-subdomain benchmark cases against the spectral element method (SEM) and extended finite element method (XFEM) verify the method’s accuracy, convergence, and stability for singular modeling. Additional multi-subdomain examples demonstrate its scalability and applicability to engineering problems.}
}
@article{FEDER2026119298,
title = {An agglomeration-based multigrid solver for the discontinuous Galerkin discretization of cardiac electrophysiology},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119298},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119298},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005712},
author = {Marco Feder and Pasquale Claudio Africa},
keywords = {Agglomeration, Preconditioning, Iterative solvers, Multilevel methods, Discontinuous Galerkin methods, Monodomain model, Cardiac electrophysiology},
abstract = {This work presents a novel agglomeration-based multilevel preconditioner designed to accelerate the convergence of iterative solvers for linear systems arising from the discontinuous Galerkin discretization of the monodomain model in cardiac electrophysiology. The proposed approach exploits general polytopic grids at coarser levels, obtained through the agglomeration of elements from an initial, potentially fine, mesh. By leveraging a robust and efficient agglomeration strategy, we construct a nested hierarchy of grids suitable for multilevel solver frameworks. The effectiveness and performance of the methodology are assessed through a series of numerical experiments on two- and three-dimensional domains, involving different ionic models and realistic unstructured geometries. The results demonstrate strong solver effectiveness and favorable scalability with respect to both the polynomial degree of the discretization and the number of levels selected in the multigrid preconditioner.}
}
@article{WANG2026119314,
title = {Bi-modulus material topology optimization with self-supporting constraints},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119314},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119314},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005876},
author = {Chao Wang and Mengsi Dong and Wenfeng Du and Zunyi Duan and Jianhua Rong and Bin Xu and Xiaodong Huang},
keywords = {Topology optimization, Design for additive manufacturing, Bi-modulus materials, Self-supporting constraints},
abstract = {Bi-modulus materials exhibiting distinct tensile and compressive moduli (e.g., concrete, fiber-reinforced composites, etc.) have been widely used in fields such as civil engineering and aerospace. However, due to the non-smoothness and strain state-dependency of the constitutive model and the design manufacturability, conventional linear elasticity-based topology optimization (TO) methods are difficult to apply to such problems. To this end, this work makes the first attempt to incorporate both bi-modulus material properties and self-supporting constraints into a unified TO framework for additive manufacturing. To overcome the above bi-modulus constitutive challenge, an improved smooth constitutive model retaining complete shear modulus information is established, and the exact tangent stiffness matrix for Newton–Raphson iterations is derived. To tackle the self-supporting design challenge, a density-gradient-based geometric self-supporting constraint is embedded into the bi-modulus TO framework and extended from 2D to 3D On this basis, a two-level solution strategy combining an outer TO loop with an inner nonlinear finite element analysis loop is established. Typical 2D and 3D numerical examples validate the effectiveness of the proposed method and reveal the influence of key parameters, such as the tension–compression modulus ratio and the overhang angle threshold, on the optimized designs.}
}
@article{BRACH2026119290,
title = {Z-mag: A two-chart stereographic formulation for finite-element micromagnetic simulations},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119290},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119290},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005633},
author = {Stella Brach and Federico Soldà and Kathrin Aebischer and Mark A. Lantz},
keywords = {FE micromagnetics, Unit-length constraint, Two-chart stereographic atlas, FEM/BEM magnetostatics, FEniCSx/DOLFINx/PETSc},
abstract = {Accurate enforcement of the unit-length constraint on magnetization is a central challenge in computational micromagnetics. Existing coordinate choices involve trade-offs: Cartesian formulations require explicit normalization or constraint stabilization; spherical coordinates have pole singularities at physically reachable states; and single-chart stereographic coordinates avoid finite-point singularities but become poorly scaled near the projection pole. In this work, we present Z-mag, an open-source finite-element solver based on a unified two-chart stereographic atlas that preserves the unit constraint by construction while maintaining robust conditioning across the full set of magnetization states. The method uses two stereographic charts with antipodal poles and a single sign-parameterized set of equations, avoiding separate chart-specific formulations. Around the equatorial band where both charts are valid and well-scaled, the solver blends their contributions with continuous atlas weights, avoiding hard chart switching during time evolution. Numerically, Z-mag couples the Landau–Lifshitz–Gilbert magnetization dynamics with open-boundary magnetostatics through an operator-split scheme that combines Newton–Krylov nonlinear solves with a finite-element/boundary-element magnetostatic solve. Adaptive time stepping with thermodynamic acceptance criteria controls nonphysical transients and improves robustness in stiff dynamical regimes. Implemented with FEniCSx/DOLFINx and PETSc, Z-mag is designed for reproducible, parallel micromagnetic simulation.}
}
@article{HE2026119306,
title = {Block-deformed discrete Ritz method for arbitrary 3D solids with complex geometries},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119306},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119306},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005797},
author = {Xian He and Lufei Li and Haichao Li and Fuzhen Pang and Ziang Ma},
keywords = {Block-deformed discrete Ritz method, Rayleigh-Ritz method, Modal analysis, Free vibration, Non-body-fitted discretization, Complex geometry},
abstract = {The discrete Ritz method (DRM) embeds an arbitrarily shaped three-dimensional solid into a bounding cuboidal domain and evaluates the energy functionals through cutout- or indicator-based treatment, enabling free-vibration analysis without necessarily requiring a body-fitted volumetric mesh. However, the accuracy and practical convergence of the single-domain DRM may deteriorate for geometrically complex and spatially sparse solids. Because the solid occupancy ratio depends on the selected enclosing cuboid, it is evaluated in this work under a fixed tight axis-aligned bounding-box (AABB) convention and is used only as a case-specific descriptor of background-domain sparsity. Under this convention, thin-walled, frame-like, perforated, and spatially sparse structures may contain a substantial inactive background, thereby increasing the approximation and integration demands of the global formulation. To improve robustness for such complex three-dimensional solids, this work proposes a block-deformed discrete Ritz method (BD-DRM). The bounding cuboid is partitioned into multiple blocks, within which the displacement field is approximated using tensor-product GLL–Lagrange nodal polynomials; the local order is p=2 in all BD-DRM numerical examples. A geometry-adaptive warping of the coarse block grid is then introduced to improve conformity to the actual solid boundary. The stiffness and mass matrices are then assembled over the true structural domain through geometry-aware integration, together with an algebraic reduction of discretely inactive background basis coefficients. Benchmarks against finite element solutions show that BD-DRM significantly reduces frequency errors and improves mode-shape agreement for structures covering a wide range of AABB-based solid occupancy ratios, while retaining the ability to handle arbitrary geometries. The numerical studies include both volumetric-mesh-assisted and CAD/STEP-driven realizations of the geometry-aware true-domain integration.}
}
@article{JIN2026119308,
title = {A robust GPU-accelerated kernel compensation solver with novel discretization for photonic crystals in anisotropic media},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119308},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119308},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005815},
author = {Chenhao Jin and Hehu Xie},
keywords = {Photonic crystals, Anisotropic media, Yee’s scheme, Kernel compensation method, Matrix-free operations, GPU acceleration},
abstract = {This paper develops a robust solver for the Maxwell eigenproblem in 3D photonic crystals with anisotropic media. The solver employs the kernel compensation technique under the framework of Yee’s scheme to eliminate null space and enable matrix-free, GPU-accelerated operations via 3D discrete Fourier transform. Furthermore, we propose a novel discretization for permittivity tensor containing off-diagonal entries and prove that the resulting matrix is Hermitian positive definite, which ensures the correctness of the kernel compensation technique. Numerical experiments on several benchmark examples are demonstrated to validate the robustness and accuracy of our scheme.}
}
@article{LONG2026119324,
title = {hp-version continuous Petrov–Galerkin time-stepping for the diffusive-viscous wave equation: Unconditional stability and optimal a priori error estimates},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119324},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119324},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005979},
author = {Jiahui Long and Zhe Li and Lijun Yi},
keywords = {-version, Diffusive-viscous wave equation, Time-stepping, Unconditional stability},
abstract = {In this paper, we develop and analyze an unconditionally stable fully discrete method for the diffusive-viscous wave equation, combining an hp-version continuous Petrov–Galerkin time discretization with an hp-conforming finite element method in space. We first reformulate the problem as a first-order system to facilitate the time-stepping construction; the combination of the hp-version temporal and spatial discretizations then yields simultaneous high-order accuracy in both time and space. Unconditional stability is established via an energy argument that employs a special linear weight function, and the discrete energy is proved to be monotonically non-increasing at the time nodes. A rigorous hp-version a priori error analysis yields optimal convergence rates in the L2(L2) and L2(H1) norms, with constants explicitly independent of the spatio-temporal discretization parameters. Extensive numerical experiments confirm the theoretical results, demonstrating optimal algebraic convergence under h-refinement and exponential convergence under p-refinement. Further numerical examples validate the method’s long-time stability, energy dissipation properties, and its ability to handle both homogeneous and heterogeneous media with discontinuous coefficients.}
}
@article{CORDEIRO2026119300,
title = {A shell-to-shell cohesive line element for efficient modeling of interfacial cracking in overmolded stiffened panels},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119300},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119300},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005736},
author = {Sérgio G.F. Cordeiro and Boyang Chen and Frans P. {van der Meer}},
keywords = {Structural cohesive elements, Debonding, Coarse meshes},
abstract = {The growing use of thermoplastics in lightweight structures requires efficient numerical methods to predict debonding in overmolded parts. In this work, a novel structural cohesive element is proposed as an efficient alternative to conventional cohesive elements for modeling debonding in thermoplastic composite panels with overmolded stiffeners. Three-node, higher-order, hybrid-mixed shell elements based on the Kirchhoff hypothesis are used to model thin panels and stiffeners. The novel kinematics allows to obtain the jump vector at any point over the cohesive surface from the shell displacement approximations evaluated at the element edges. The weakly enforced higher-order continuity in the displacement approximations enables skin-stiffener debonding analysis on coarse meshes. The framework can also accommodate non-constant damage distributions through the stiffener thickness. The model is verified for mode I, mode II and mixed-mode benchmark problems. A debonding problem is analyzed with both standard 3D cohesive elements and the proposed element. The results show that the element size in the proposed models can be much larger than that in the standard model, with more than 95% reduction in CPU time. The debonding analysis of a complex stiffened panel is also presented to demonstrate the intended use of the proposed element for simulating debonding in structural components.}
}
@article{ELYOUSSEF2026119337,
title = {A peridynamic differential operator (PDDO)-based model for compressible high-speed water droplet impact on a rigid wall},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119337},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119337},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526006109},
author = {Mostafa Elyoussef and Martin Pugh and Mamoun Medraj},
keywords = {Peridynamics, High-speed water droplet impact, Compressible flow, Peridynamic differential operator (PDDO), Riemann solver, Water droplet erosion},
abstract = {Water droplet erosion (WDE) compromises the structural integrity and efficiency of power-generation components, driving extensive research to elucidate its underlying mechanisms. Although finite element (FE) simulations provide insight into impact-induced stress and strain fields, modeling WDE onset and progression remains challenging because conventional FE formulations rely on classical continuum governing equations whose spatial derivatives become invalid at discontinuities. Peridynamics (PD), formulated without spatial derivatives, has proven effective for predicting complex damage patterns and offers a promising framework for investigating WDE mechanisms. Nevertheless, PD research has largely focused on solids, and existing PD-based fluid models mainly target incompressible and weakly compressible flows. Accordingly, this study develops and validates a two-dimensional Peridynamic Differential Operator (PDDO)-based formulation for compressible high-speed water droplet impact on a rigid wall. The PDDO-based formulation employs a horizon-based meshfree discretization of the classical Lagrangian Navier–Stokes equations and incorporates Roe's approximate Riemann solver with a dissipation limiter to improve numerical stability near sharp flow discontinuities. A GPU-accelerated MATLAB implementation incorporates free-surface treatment, a fictitious-layer wall boundary, particle regularization, and a boundary-collision correction. The model captures the key physical features of high-speed droplet impact and agrees well with semi-analytical predictions of maximum and spatially averaged wall pressure over impact velocities of 100–500 m/s, while demonstrating droplet-size independence, accurate early-stage contact-radius evolution, and good agreement of predicted lateral-jet velocities with experimental measurements. The present PDDO framework provides a foundation for future coupling with PD solid formulations, enabling a unified horizon-based computational framework for fluid–structure interaction simulations of WDE.}
}
@article{ZUCCO2026119319,
title = {A stabilisation-free hybrid virtual triangular element with drilling rotations for two-dimensional elasticity},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119319},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119319},
url = {https://www.sciencedirect.com/science/article/pii/S004578252600592X},
author = {Giovanni Zucco},
keywords = {Virtual Element Method, Hybrid formulation, Triangular elements, Stabilisation-free methods, Drilling rotations},
abstract = {A stabilisation-free hybrid virtual triangular element for the analysis of two-dimensional elasticity problems is presented. The formulation is developed within a hybrid framework in which the kinematic field is defined along the element boundary, while the stress field is independently approximated within the element domain through an energy-consistent projection procedure. The stress approximation employs a divergence-free, iso-stable polynomial basis, i.e., one in which the number of stress parameters matches the number of deformational kinematic modes. The basis isspecifically constructed to avoid spurious energy modes, thereby eliminating the need for additional stabilisation terms. The proposed element possesses nine degrees of freedom, namely two translational components and one drilling rotation at each vertex. The introduction of drilling rotations as independent kinematic variables within a hybrid virtual element framework constitutes a novel aspect of the formulation. The resulting element, denoted as HVT3-6, is assessed through standard benchmark problems in two-dimensional elasticity. The numerical results demonstrate optimal convergence rates of order h2 for displacement, stress, and complementary energy measures. Moreover, the proposed formulation yields improved accuracy compared to a displacement-based triangular finite element with the same number of degrees of freedom on both structured and unstructured meshes, including coarse discretisations. Finally, while the present formulation is developed for triangular elements, the proposed drilling-based hybrid framework constitutes a basis for future extensions of hybrid virtual elements with independent drilling rotations to general polygonal meshes.}
}
@article{LARSON2026119330,
title = {Error estimates for Nitsche’s method on approximate domains},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119330},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119330},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526006031},
author = {Mats G. Larson and Karl Larsson and Shantiram Mahata},
keywords = {Nitsche’s method, Geometric approximation errors, A priori error estimates, Cut finite element method},
abstract = {We derive a priori error estimates for Nitsche’s method applied to elliptic problems on approximate domains. Such approximations arise, for example, in unfitted finite element methods, data-driven simulations, and evolving domain problems, where the computational domain does not coincide exactly with the physical one. We quantify geometric errors in terms of boundary location and normal perturbations and carry out the analysis in an abstract CutFEM framework under standard stability assumptions. In the energy norm, we obtain an estimate exhibiting an h−1/2 amplification of the boundary location error. We then prove a refined H1-seminorm estimate that removes this amplification, yielding a sharper bound with additive contributions from boundary location and normal errors. Finally, we establish an optimal order L2-error estimate based on a refined duality argument, where the geometry contribution appears as a separate additive term, decoupled from the mesh size h. The results reveal a fundamental distinction between the norms: the energy norm amplifies boundary location errors while remaining insensitive to normal perturbations, the H1-seminorm separates location and normal errors, and the L2-norm is insensitive to normal perturbations. This provides a clear characterization of how geometric approximation affects convergence in Nitsche-based finite element methods, with particular relevance for unfitted discretizations.}
}
@article{GUO2026119265,
title = {A novel structure-preserving spectral scheme for the incompressible ideal MHD system},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119265},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119265},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005384},
author = {Shimin Guo and Yibao Li and Liquan Mei},
keywords = {Ideal MHD, Structure-preserving, Spectral approximation, Adaptive time-stepping, Implicit–explicit scheme},
abstract = {We propose an efficient implicit–explicit (IMEX) spectral scheme for the three-dimensional incompressible ideal magnetohydrodynamic (MHD) system that simultaneously preserves several fundamental physical invariants, including the energy, the magnetic Gauss’s law, the magnetic helicity, and the cross helicity. In the proposed scheme, energy conservation is achieved through a Lagrange multiplier formulation, while magnetic helicity and cross helicity are maintained via an error-compensation strategy involving two scalar auxiliary variables satisfying specially constructed ordinary differential equations. The proposed scheme provides the following advantages: (i) it achieves higher computational reliability by simultaneously preserving multiphysics structures at the fully discrete level; (ii) it is nearly linear in the sense that only linear algebraic systems and a single quadratic algebraic equation need to be solved at each time level; (iii) it is highly efficient when integrated with the adaptive time-stepping strategy. Finally, a series of three-dimensional numerical experiments is carried out to demonstrate the accuracy, efficiency, and structure-preserving capability of the proposed method for incompressible ideal MHD flows.}
}
@article{ANDALOUSSI2026119305,
title = {An MRI-informed poromechanical model for organ-scale prediction of glioma growth},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119305},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119305},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005785},
author = {M. Abbad Andaloussi and S. Urcun and D.A. {Hormuth II} and G. Lorenzo and G. Sciumè and C. Wu and T.E. Yankeelov and S.P.A. Bordas},
keywords = {Magnetic resonance imaging, Finite elements, Poromechanics, Cancer, Glioma, Computational oncology},
abstract = {Gliomas constitute one of the most aggressive and heterogeneous forms of brain tumors, posing major challenges for understanding their biology and developing effective treatments. Animal models enable the collection of rich longitudinal datasets describing tumor dynamics, which can be integrated within mathematical models to elucidate the biological mechanisms governing tumor growth. While most formulations rely on reaction–diffusion systems with limited insight on tissue deformation and fluid transport, we propose a magnetic resonance imaging (MRI)-informed, poroelastic model to describe C6 glioma growth in rats. We use data from animals (n=4) that were imaged five times after intracranial injection of cancer cells. Each MRI dataset includes (i) anatomical T1-weighted data for brain and tumor segmentation and to assign mechanical properties; (ii) diffusion-weighted MRI, which enables estimation of the fraction of each voxel that is tumor; and (iii) dynamic contrast-enhanced MRI, which informs permeability as well as vascular and liquid fraction maps. Using finite-element simulations, model calibration for each rat uses the Gauss–Newton method informed by the first three MRI datasets. Tumor forecasts are validated by assessing model-data agreement on the remaining two MRI datasets. Our results show relative tumor volume errors between 0.94% and 11.27% at calibration, and prediction errors between 4.73% and 36.03%. Additionally, Dice scores ranged from 0.80 to 0.93 during calibration, and from 0.75 to 0.93 during validation. Thus, our results suggest that our poromechanical model can describe C6 glioma growth. This study provides a first step towards a patient-specific, multiscale model of the spatiotemporal poromechanics underlying glioma progression and therapeutic response.}
}
@article{SCHNEIDER2026119281,
title = {Damage Transport with Redistribution},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119281},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119281},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005542},
author = {Matti Schneider},
keywords = {Entropy-regularized damage transport, Isotropic damage model, Adaptive time discretization, Well-posed model, Continuum damage mechanics},
abstract = {This work is concerned with Damage Transport (DT), a framework for continuum damage mechanics that provides softening damage models while ensuring mathematically well-posed boundary value problems. DT was constructed in a two-step process: First, the cross-convex envelope of the time-incremental potential was calculated analytically for a simple rate-limited scalar damage model. In a second step, an entropic regularization term was added to the dissipation to ensure uniqueness of solutions to the incremental problems. A key characteristic of DT is the natural emergence of damage distributions as internal variables, a consequence of the cross-convex relaxation. In particular, the space of internal variables of the model is inherently infinite-dimensional. If the evolution of the material starts from an undamaged state, it was shown that an implicit Euler discretization of DT in time leads to solutions which are finite sums of Dirac measures. Thus, only finitely many degrees of freedom are needed. However, the attained damage states depend on the time step size and on the number of time steps. Even more critically, previous constructions were based on a regular time discretization, and the number of time steps was required to be known a priori. In particular, an adaptive discretization in time, not uncommon for industrial finite element codes, is incompatible with the model developed so far. This work proposes a strategy to overcome this limitation: For a fixed number of attainable damage states, the damage values and the damage fractions are selected in an adaptive manner from one time step to the next. In particular, the number of internal variables is fixed a priori and adaptive time stepping is enabled. The proposed strategy is based on a simple postprocessing step, where newly created damage states are redistributed to neighboring damage states. This redistribution follows a greedy strategy and is selected to exactly preserve the (damaged) elastic stiffness. As the contribution is based on postprocessing, the efficient computational framework previously developed remains applicable. Also, we show that the redistributed damage transport model satisfies the Clausius-Duhem inequality, i.e., the model is thermomechanically consistent. We demonstrate the accuracy and versatility of the novel framework via computational examples.}
}
@article{ZHENG2026119273,
title = {Hierarchical active learning probabilistic integration for reliability analysis of first-order sequential series systems},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119273},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119273},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005463},
author = {Weiming Zheng and Chao Dang and Xiukai Yuan and Marcos A. Valdebenito and Matthias G.R. Faes},
keywords = {System reliability analysis, Sequential series system, Bayesian inference, Active learning, Gaussian process regression},
abstract = {Structural reliability analysis has been extensively studied at both the component and system levels, including series and parallel systems and combinations thereof. This work focuses on a particular configuration, termed sequential series systems, in which subsystems are connected in a cascade manner through linking variables, and system failure occurs if any stage violates its limit state. Such systems are common in staged engineering processes and sequential simulation workflows, but their coupled information flow and multiple stage-wise failure events pose challenges to traditional reliability analysis methods. This work proposes a Hierarchical Active Learning Probabilistic Integration (HALPI) framework for the reliability analysis of first-order sequential series systems. Each subsystem is emulated by an individual Gaussian Process (GP) model and a new measure of model accuracy is developed by combining the intrinsic prediction uncertainty of each GP model with the propagated prediction uncertainty from upstream GP predictions. A stopping criterion based on the measure of these two kinds of uncertainties is further derived to ensure reliable convergence of the failure probability estimate. We also propose a learning strategy that updates only emulators that materially influence the failure probability estimate, thereby reducing unnecessary model evaluations. It is shown through several numerical and engineering examples that the proposed method can accurately estimate both stage-wise and overall failure probabilities while significantly reducing the number of model evaluations, and achieves improved robustness compared to all-in-one approaches.}
}
@article{XIONG2026119325,
title = {A generalized framework of model-consistent multiphase lattice boltzmann flux solvers for incompressible interfacial flow system},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119325},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119325},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005980},
author = {Huajie Xiong and Xian Yi and Zhihong Zhou},
keywords = {Multiphase interfacial flow, Lattice boltzmann method, Multiphase lattice boltzmann flux solver, Large density ratios, High reynolds numbers},
abstract = {In multiphase interfacial flow simulations, the inconsistency between mass and momentum transport can undermine conservation properties and compromise physical reliability. To overcome this challenge, the Chapman–Enskog expansion procedures for both the incompressible and weakly-compressible LBM routes are analyzed, leading to the construction of two novel transport-consistent Multiphase Lattice Boltzmann Flux Solvers (MLBFSs). It is revealed that both routes share the general moment forms of the continuity and momentum equations, along with a unified force distribution function scheme. These insights form a generalized framework for MLBFSs that satisfies model consistency between the Lattice Boltzmann Equation (LBE) and the Navier-Stokes (NS) equations. This framework also yields two standard MLBFSs that recover the standard NS equations, each of which can be reduced from the corresponding transport-consistent MLBFS. Their performance is systematically compared, and the influence of transport inconsistency on multiphase interfacial flows is studied in detail. All four model-consistent MLBFSs exhibit superior numerical stability, allow larger time steps, and produce sharper interface resolution. The incompressible MLBFSs avoid pressure propagation lag, but neglecting the pressure time term can affect the evolution of the multiphase interface. The weakly-compressible MLBFSs perform better in terms of compressibility error and parameter range, and are compatible with the precise Block Data-Parallel Lower-Upper Relaxation (BDPLUR) algorithm, thereby enabling maximal time-step enlargement. Furthermore, the effects of transport inconsistency are amplified by larger density ratios, higher Reynolds numbers, and longer simulation durations. Maintaining transport consistency is indispensable under extreme simulation conditions. This framework provides a complete flow solver system, offering flexible options for different application scenarios.}
}
@article{ZOU2026119321,
title = {SP-PAT-IGA: Single-patch parameterization of multiply-connected planar domains for isogeometric analysis},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119321},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119321},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005943},
author = {Ruijie Zou and Maodong Pan and Falai Chen and Ye Zheng},
keywords = {Single-patch parameterization, Multiply-connected planar domains, Quasi-conformal mapping, Alternating optimization, Isogeometric analysis},
abstract = {The construction of analysis-suitable spline parameterizations for multiply-connected planar domains remains a challenging task in isogeometric analysis, particularly when a single-patch representation is desired for superior smoothness and analysis performance. Although prevalent multi-patch approaches address geometric complexity through domain decomposition, they inevitably introduce artificial interfaces, induce singularities at patch junctions and require additional continuity constraints that compromise smoothness and convergence. Moreover, the general applicability of existing decomposition techniques for multiply-connected planar domains remains unclear, and their extension to three-dimensional cases is even more challenging. This paper introduces a novel and coherent framework for generating high-quality single-patch parameterizations of multiply-connected planar domains. Given an input multiply-connected domain, our method first establishes a quasi-conformal map onto a punctured unit square—a canonical parametric domain containing several interior square holes. Both the quasi-conformal map and the geometric configuration (centers and side lengths) of these inner squares are treated as unknowns. We then develop an alternating optimization algorithm that concurrently determines the quasi-conformal map and the layout of the interior squares. The final parameterization in the physical space is obtained by approximating the inverse map using truncated hierarchical B-splines. Extensive numerical experiments, ranging from simple annular geometries to high-genus engineering components, confirm that our approach produces high-quality parameterization results and significantly outperforms the conventional multi-patch alternatives. However, we also acknowledge that the current framework does not explicitly enforce geometric symmetry in the generated parameterizations—a limitation that may compromise the accuracy and reliability of subsequent simulations. Potential remedies are discussed for future work.}
}
@article{MENG2026119334,
title = {A Mesoscale Multi-Phase Elasto-Plastic Phase-Field Framework for Fracture Modelling of Concrete},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119334},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119334},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526006079},
author = {Songsong Meng and Haiming Liu and Maurizio Guadagnini and Yufeng Lai and Yang Jiang and Xu Long and Kypros Pilakoutas},
keywords = {Concrete, Elasto-plastic phase-field model, Mesoscale modelling, Energy correction parameter, Multiple-phase-field},
abstract = {Concrete deterioration, driven by progressive micro-crack formations that naturally develop in concrete either due to mechanical stress or material degradation, poses critical challenges for structural safety and durability. Though capturing crack propagation in concrete elements is essential for determining damage fracture patterns and nonlinear failure mechanisms, it is complex to describe it accurately using conventional continuum mechanics approaches. This paper presents a mesoscale multi-phase phase-field framework for concrete that explicitly accounts for energy dissipation across its heterogeneous constituents. The model incorporates the Drucker-Prager yield criterion and spectral decomposition to capture plasticity and the asymmetric tensile-compressive response of cementitious materials. At the mesoscopic scale, realistic concrete geometries are generated using polygonal aggregates with a separating axis theorem-based overlap detection algorithm, enabling improved representation of aggregate shape and spatial distribution. To validate the proposed model, three sets of experiments from the literature, are utilized to explore the impact of the volume content on the properties of concrete composites. Results demonstrate that the numerical model agrees well with the experimental results from the perspectives of load-deflection curves and crack patterns, confirming its efficacy. This model offers a robust and flexible framework for predicting crack propagation in concrete with varying volume fractions of the constituents, which can efficiently incorporate the effects of multiple physical fields. This work provides an in-depth understanding of damage evolution and can be utilized to guide the development of more effective mitigation methods.}
}
@article{TAKHIROV2026119297,
title = {A curl–curl formulation with grad–div stabilized splitting for steady incompressible flows with pressure boundary conditions},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119297},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119297},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005700},
author = {Aziz Takhirov and Driss Yakoubi},
keywords = {Steady Navier–Stokes, Grad–div stabilization, Pressure boundary conditions, Splitting scheme},
abstract = {We present an efficient iterative strategy for the steady incompressible Stokes and Navier–Stokes equations with pressure boundary conditions on part of the boundary. The method relies on a velocity–pressure splitting scheme combined with a curl–curl formulation and a grad–div stabilization term, ensuring strong enforcement of incompressibility at the discrete level. Each iteration decouples the velocity and pressure updates: the velocity is computed from a linearized subproblem with frozen nonlinear terms, followed by an explicit pressure correction to reduce the divergence residual. We prove strong convergence of the iterative sequence under classical smallness assumptions on the data and establish well-posedness of the velocity subproblem. The method is validated through numerical experiments, including manufactured solutions, flows in branched channels, and 2D/3D cylinder benchmarks, demonstrating both optimal convergence and accurate prediction of integral quantities such as drag and pressure drop.}
}
@article{WAN2026119316,
title = {Robust topology optimization for thermal–fluid system under multi-source uncertainties using parametric level-set method and non-intrusive polynomial chaos expansion},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119316},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119316},
url = {https://www.sciencedirect.com/science/article/pii/S004578252600589X},
author = {Siyuan Wan and Shengli Xu and Mindi Jiang and Shangyou Du and Hong Liu and Huiying Zhang and Bo Wang},
keywords = {Robust topology optimization, Parametric level-set method, Multi-source uncertainties, Thermal–fluid system, Non-intrusive polynomial chaos expansion},
abstract = {To address the performance degradation of heat sinks under uncertain operating conditions, this paper proposes a Robust Topology Optimization (RTO) framework for thermal–fluid system that integrates the Parametric Level Set Method (PLSM) with Non-Intrusive Polynomial Chaos Expansion (NIPCE). By interpolating the level-set function with Gaussian radial basis functions, the method transforms the Hamilton–Jacobi equation into ordinary differential equations, preserving smooth channel boundaries without re-initialization and enabling automatic hole nucleation. NIPCE models random inputs and computes statistical moments, which are combined into a robust objective as a weighted sum of expectation and standard deviation, with gradients evaluated via the discrete adjoint method. The framework is validated through three numerical examples. First, PLSM-based RTO produces clear, grayscale-free topologies and reduces the standard deviation by over 16% compared with deterministic designs. Second, studies on non-Gaussian distributions — bimodal, uniform, and lognormal — demonstrate intrinsic adaptability beyond conventional Gaussian assumptions. Third, under multi-source uncertainties (heat source intensity and inlet velocity), the optimizer identifies the dominant source and reconfigures the solid–fluid interface accordingly, achieving a distinct trade-off between nominal performance and robustness. Monte Carlo validation with 10,000 samples confirms that NIPCE predicts both expectation and standard deviation with relative errors below 1%, meeting engineering accuracy. These results establish the PLSM–NIPCE framework as a versatile and efficient tool for robust thermal–fluid design under diverse and multi-source uncertainties.}
}
@article{YANG2026119313,
title = {ESIIO: An efficient explicit stable interval iteration optimizer for continuum topology optimization},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119313},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119313},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005864},
author = {Gang Yang and Peng Hao and Yuan Liang and Zeng Meng and Peng Zhang and Baoxin Hao},
keywords = {Topology optimization, Efficiency, Optimizer, MATLAB code},
abstract = {The gradient optimizer plays a crucial role in topology optimization for updating design variables. However, the existing optimizers have deficiencies in terms of efficiency and effectiveness. To address this, a novel optimizer called explicit stable interval iteration optimizer (ESIIO) is proposed, in which a new constraint interval transformation method is established to construct the density constraint. Subsequently, the interval iterative formulation is strictly elucidated based on the Karush-Kuhn-Tucker optimality conditions. The directional stability transformation method is used to promote the convergence, in which a new adaptive boundary-crossing update strategy is proposed to evaluate the chaos control factor. The effectiveness of ESIIO is verified by five different types of mechanical problems, i.e. compliance, stress, heat conduction, fluid-thermal coupling, and multi-frequency problems. It is found that ESIIO is effective and its efficiency is significantly higher than that of traditional methods. Moreover, a 33-line MATLAB code and relevant explanations of ESIIO are provided in Appendix B. The source code of ESIIO is publicly available at: https://github.com/TOESIIO/Explicit-Stable-Interval-Iteration-Optimizer.}
}
@article{JNINI2026119289,
title = {Curvature-aware optimization for high-accuracy physics-informed neural networks},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119289},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119289},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005621},
author = {Anas Jnini and Elham Kiyani and Khemraj Shukla and Jorge F. Urbán and Nazanin {Ahmadi Daryakenari} and Johannes Müller and Marius Zeinhofer and George {Em Karniadakis}},
keywords = {Physics-informed neural networks, Curvature-aware optimization, Second-order optimizer, Quasi-Newton methods, Self-scaling BFGS and Broyden, Natural gradient, Scientific machine learning, Partial differential equations, HLLC flux},
abstract = {Efficient and robust optimization is essential for neural networks, enabling scientific machine learning models to converge rapidly to very high accuracy—faithfully capturing complex physical behavior governed by differential equations. In this work, we present advanced optimization strategies to accelerate the convergence of physics-informed neural networks (PINNs) for challenging partial differential equations (PDEs) and ordinary differential equations (ODEs). In particular, this work focuses on curvature-aware methods, namely optimization methods that exploit second-order information, or practical approximations of it, to adapt the update direction to the local geometry of the loss landscape. Specifically, we provide efficient implementations of the Natural Gradient (NG) optimizer, Self-Scaling BFGS and Broyden optimizers, and demonstrate their performance on problems including the Helmholtz equation, Stokes flow, inviscid Burgers equation, Euler equations for high-speed flows, and stiff ODEs arising in pharmacokinetics and pharmacodynamics. Beyond optimizer development, we also propose new PINN-based methods for solving the inviscid Burgers and Euler equations, and compare the resulting solutions against high-order numerical methods to provide a rigorous and fair assessment. Finally, we address the challenge of scaling these quasi-Newton optimizers for batched training, enabling efficient and scalable solutions for large data-driven problems.}
}
@article{LIGUORI2026119307,
title = {A Hybrid Virtual Element for stabilization-free polytopal Mindlin–Reissner shells with an effective handling of drilling rotations},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119307},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119307},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005803},
author = {F.S. Liguori and A. Madeo and S. Marfia and E. Sacco},
keywords = {Hybrid Virtual Element Method, Polytopal shell, Mindlin–Reissner shell, Drilling rotations, Stabilization-free, Locking-free},
abstract = {This work introduces a novel polytopal flat shell formulation within the Hybrid Virtual Element Method (HVEM). The proposed element employs six degrees of freedom per vertex, including drilling rotations, and defines displacement and rotation fields exclusively along the element boundary through equilibrated stress resultants. Spurious modes associated with Allman’s kinematics are eliminated for arbitrary polygonal elements by means of a cubic interpolation of the normal component of the in-plane edge displacement, without requiring any approximation within the element interior. The adopted kinematics enables an exact evaluation of rigid-body rotations based solely on vertex degrees of freedom and allows constant stress states to be reproduced exactly. In particular, an analytical expression for the average element rotation is derived, relying only on boundary displacements. Moreover, an appropriate choice of the polynomial used for the self-equilibrated stress interpolation is numerically shown to yield a rank-sufficient element, eliminating the need for additional stabilization terms. Numerical results demonstrate the absence of spurious modes, assessed through a Monte Carlo-based optimization procedure, as well as the absence of locking, robustness with respect to mesh distortion, and high accuracy even on coarse meshes.}
}
@article{DONG2026119302,
title = {A novel method for enforcing exactly Dirichlet, Neumann and Robin conditions on general quadrilateral domains with curved boundaries for physics informed machine learning},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119302},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119302},
url = {https://www.sciencedirect.com/science/article/pii/S004578252600575X},
author = {Suchuan Dong and Yuchuan Zhang},
keywords = {Exact boundary condition enforcement, Physics informed machine learning, Scientific machine learning, Transfinite interpolation, Theory of functional connections, Complex geometry},
abstract = {We present a systematic method for exactly enforcing Dirichlet, Neumann, and Robin type conditions on general quadrilateral domains with arbitrary curved boundaries. Our method is built upon exact mappings between general quadrilateral domains and the standard domain, and employs a combination of TFC (theory of functional connections) constrained expressions and transfinite interpolations. When Neumann or Robin boundaries are present, especially when two Neumann (or Robin) boundaries meet at a vertex, it is critical to enforce exactly the induced compatibility constraints at the intersection, in order to enforce exactly the imposed conditions on the joining boundaries. We analyze in detail and present constructions for handling the imposed boundary conditions and the induced compatibility constraints for two types of situations: (i) when Neumann (or Robin) boundary only intersects with Dirichlet boundaries, and (ii) when two Neumann (or Robin) boundaries intersect with each other. We describe a four-step procedure to systematically formulate the general form of functions that exactly satisfy the imposed Dirichlet, Neumann, or Robin conditions on general quadrilateral domains. The method developed herein has been implemented together with the extreme learning machine (ELM) technique we have developed recently for scientific machine learning. Ample numerical experiments are presented with several linear/nonlinear stationary/dynamic problems on a variety of two-dimensional domains with complex boundary geometries. Simulation results demonstrate that the proposed method has enforced the Dirichlet, Neumann, and Robin conditions on curved domain boundaries exactly, with the numerical boundary-condition errors at the machine accuracy.}
}
@article{CHEN2026119323,
title = {Enhanced modeling and efficient fully discrete finite element scheme for a diffuse interface FHD model with different viscosities and densities},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119323},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119323},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005967},
author = {Xiaoyong Chen and Chunhao Chen and Rui Li and Jian Li and Xiaoming He and Yanping Lin},
keywords = {Two-phase ferrohydrodynamics, Different densities and viscosities, Stabilization, The artificial compressibility, The invariant energy quadratization method},
abstract = {This paper proposes, analyzes, and numerically solves an enhanced model for the two-phase ferro-fluid flows with different viscosities and densities. In addition to the variable parameters for the density and viscosity and a reformulation of the magnetostatic equation, a relative flux term related to the diffusion of the components is also incorporated into the model to ensure a physically consistent and mathematically rigorous system, inspired by Abels et al. (2012) and Shen and Yang (2015). The introduction of this relative flux term plays a pivotal role in the analysis of the energy law and the construction of the numerical scheme. To construct an efficient fully discrete finite element numerical scheme, we introduce an intermediate magnetization for the magnetization equation, add several key stabilization terms due to the explicit treatment of the nonlinear and coupling terms, apply the artificial compressibility approach for the Navier–Stokes equations, and utilize the invariant energy quadratization approach for the Cahn-Hilliard equations. It is proven to be uniquely solvable per time step and unconditionally stable. Meanwhile, the proposed scheme requires no artificial boundary conditions on the pressure. In addition, we employ an adaptive mesh strategy to better capture the diffuse interface in practical numerical simulations. We present several 2D and 3D numerical examples to demonstrate and validate the presented two-phase model and numerical scheme, including the accuracy test, the Spinodal decomposition, the deformation and migration of a ferrofluid droplet in an irregular domain, as well as the Rosensweig instability with large density ratios under the uniformly or nonuniformly applied magnetic field.}
}
@article{SELLMANN2026119299,
title = {Fast topology optimization of elastoplastic materials using a LATIN-based one-shot scheme},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119299},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119299},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005724},
author = {Christian Sellmann and David Néron and Philipp Junker},
keywords = {Topology optimization, Elasto-plasticity, One-shot, Large Time Increment (LATIN) method},
abstract = {Topology optimization of elastoplastic materials requires marching through time for both the primal and the adjoint problem at every optimization step, resulting in hundreds of linear systems to be solved. This requirement turns large-scale applications prohibitively expensive with regard to numerical costs. We address this cost on two fronts. First, we derive a decoupled formulation of the local adjoint equations that replaces the coupled system of equations traditionally solved at each material point with a sequence of explicit scalar and tensor updates. This formulation is independent of the global solution strategy and directly applicable to standard solvers. Second, we embed the LATIN (Large Time Increment) method into the optimization loop for both the primal and the adjoint problem. By choosing the elastic stiffness tensor as search direction, the global stiffness matrix remains constant across all time steps and iterations and is factored only once per optimization step when the density distribution has changed. The time steps become globally decoupled and can be solved in parallel. This enables a One-shot scheme, where a single LATIN iteration is performed per optimization step. While the density update in this work follows a Thermodynamic Topology Optimization approach with SIMP interpolation, the proposed solution strategies are independent of the optimization framework employed. The method is demonstrated on 2D and 3D benchmarks (MBB beams and cantilevers) with J2 plasticity featuring Voce isotropic and linear kinematic hardening under cyclic loading. By utilizing the One-shot LATIN scheme, we achieve speedups between one and two orders of magnitude compared to traditional Newton–Raphson iterations, without compromising the final optimized designs.}
}
@article{ZHAO2026119333,
title = {Interval-oriented multiscale topology optimization for ensuring reliability and manufacturability of aircraft lattice structures via overhang control},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119333},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119333},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526006067},
author = {Xingyu Zhao and Lei Wang and Zhenxian Luo},
keywords = {Reliability-based topology optimization, Double-scale topology optimization, Overhang control, Interval non-probabilistic reliability, Steady-state kinetics},
abstract = {This work proposes a reliability-based, double-scale dynamic topology optimization method that considers overhang control. The established topology optimization (TO) model targets double-scale structures filled with truss-like lattice cells, focusing on designing both the material layout within the macro design domain and the rod radii of the truss-like cells. A mesh projection method is developed to assist the Additive Manufacturing filter (AM filter), enabling overhang control for unstructured meshes and supporting customized print directions. To address reliability design issues involving defective cells, a ‘rob radii–performance boundary’ model for truss-like cells is established using sampling and fitting methods, significantly reducing the computational burden during the optimization process. The effectiveness and characteristics of the proposed method are discussed through several numerical examples.}
}
@article{PAVARINO2026119296,
title = {Adaptive overlapping Schwarz algorithms for isogeometric H1− problems},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119296},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119296},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005694},
author = {Luca Franco Pavarino and Simone Scacchi and Olof B. Widlund and Stefano Zampini},
keywords = {Domain decomposition, Overlapping Schwarz preconditioners, Adaptive coarse spaces, Isogeometric analysis, Nonuniform rational B-splines, Scalar elliptic problems, Compressible linear elasticity},
abstract = {Isogeometric analysis (IGA) is a computational technology which has shown considerable success as an alternative to finite elements in many applications. Based on B-splines and nonuniform rational B-splines, IGA uses basis functions which are not nodal and which give rise to fat interfaces between the subdomains introduced when developing domain decomposition algorithms and partitioning the underlying IGA patches. The Adaptive Generalized Dryja–Smith–Widlund (AGDSW) and the Reduced AGDSW (RAGDSW) algorithms, previously developed for finite element approximations of scalar elliptic problems and compressible linear elasticity, are extended here to isogeometric discretizations. A condition number bound, independent of the number of subdomains, the mesh size, and the coefficients of the elliptic operator, is proved for the case of generous overlap. Numerical experiments confirm the scalability and robustness of both methods with respect to the number of subdomains, the spline polynomial degree, and highly heterogeneous jumping coefficients.}
}
@article{BERRONE2026119322,
title = {A lowest-order Stabilization-free Virtual Element Method for 3D problems},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119322},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119322},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005955},
author = {Stefano Berrone and Andrea Borio and Francesca Marcon and Fabio Vicini},
keywords = {Virtual element methods, Stabilization-free, 3D problems, Elasticity},
abstract = {This work aims at presenting a novel Stabilization-free Virtual Element method for 3D problems. In particular, we focus on the discretization of the linear elastic equation, but the new projection operator introduced can be applied to derive a self-stabilized formulation also for general scalar elliptic equations. The method is introduced in its lowest order formulation and for the analysis we consider the class of polyhedra with triangular faces, typically called deltahedra. We provide a sufficient condition on the polynomial projection space that implies the well-posedness. Several numerical tests assess the robustness of the method and confirm the theoretical convergence rates. Furthermore, we test the proposed method on a nonlinear elasticity problem, to show the robustness of the proposed self-stabilized formulation for solving nonlinear problems.}
}
@article{URRUTIAVALDES2026119318,
title = {GeoPINONet: Sparse-supervised physics-informed operator learning for full-field prediction in variable 3D elastic domains},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119318},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119318},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005918},
author = {Vicente {Urrutia Valdés} and Iván {La Fé-Perdomo} and Angel {Rodríguez Soto}},
keywords = {Physics-informed neural operator, Geometry-conditioned surrogate, 3D linear elasticity, Multiscale Fourier features, Adaptive sparse supervision, Stress concentration},
abstract = {Finite element analysis remains standard for structural verification, but repeated full-field simulations are costly for geometry exploration and monitoring. This work introduces GeoPINONet, a geometry-conditioned physics-informed neural operator for three-dimensional linear elasticity under sparse finite-element (FEM) supervision. It combines a PointNet geometry encoder, multiscale Fourier features, a mixed displacement–stress decoder, and Active Critical Selective Validation (ActiveCSV), which reallocates supervised anchors toward mechanically critical and persistently difficult nodes. Training uses 64 Latin hypercube geometries per family on 3D lug and plate-with-hole benchmarks with moving stress concentrations. On dense FEM meshes for 16 unseen geometries, including interpolative and controlled near-boundary cases, GeoPINONet achieves mean Ru2=0.996–0.999 and p95σvM,ip<8% across both families and load modes. For a characterized target and fixed 50,000-point grid, prepared-operator deployment executes both learned output projections and reconstructs physical fields in 2.60 ms on average (2.89 ms at the 95th percentile). Including device-to-host transfer and visualization-field replacement requires 3.70 ms on average (4.14 ms at the 95th percentile). Relative to the reported 44s two-load finite-element solver boundary, the ratio is approximately 1.1×104; offline FEM generation, training, one-time invariant-feature preparation, and rendering are reported separately. Ablations show that stress reconstruction depends on spectral enrichment, adaptive supervision, and constitutive consistency: removing Fourier features reduces RσvM,ip2 from 0.90 to 0.16, while removing Hooke consistency increases the lateral-bending tensor Frobenius error from 9.8% to 133.4%.}
}
@article{OBRYAN2026119310,
title = {A generalized friction algorithm for polytopal finite volume methods via contact surface projection},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119310},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119310},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005839},
author = {Aidan O’Bryan and Samara Overvaag and Mack Kenamond and Samuel C. Lamont and Nitin P. Daphalapurkar},
keywords = {Contact mechanics, Friction, Finite volume, Polytopal meshes, Granular compaction, -d tree},
abstract = {We present a generalized friction assembly algorithm for polytopal Lagrangian finite volume methods in two and three spatial dimensions. The method was developed to support simulations with extensive evolving contact, such as weak shock compaction of granular materials, where hundreds or thousands of individual grains undergo frictional contact. Candidate contacting surface facets are identified efficiently using a k-d tree built over expanded facet bounding boxes. For each admissible facet pair, outward normal screening and a common normal construction are used to define a shared projection space in which half-facet overlap measures are computed robustly. These overlap measures provide the geometric weights needed to transfer intensive quantities, such as areal mass and areal momentum, into the extensive quantities required by point-based friction updates. The method supports multi-body contact on general polytopal meshes in both 2D and 3D. In 2D, overlap reduces to interval intersection; in 3D, projected triangular half-facets are intersected by convex clipping. We couple the resulting assembly to a Coulomb–Stribeck-viscous friction law and implement the method in the FLAG hydrodynamics code. Verification includes analytic overlap tests, rotated sliding-block tests, and consistency with the legacy 2D slideline formulation within its domain of applicability. Application to weak shock compaction of granular salt demonstrates frictional contact between hundreds of individual grains and shows that friction reduces particle velocity overprediction, alters wave propagation, and increases dissipation and pressure heterogeneity behind the compaction front. The proposed algorithm is broadly applicable to frictional contact on unstructured polytopal finite volume meshes.}
}
@article{WEITHOFF2026119295,
title = {Locking-free energy-based physics-informed neural networks for shear-deformable beams and plates},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119295},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119295},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005682},
author = {Till Weithoff and Lukas Striefler and Bastian Oesterle and Josef Kiendl},
keywords = {Physics-informed neural networks, Structural mechanics, Shear locking, Hierarchic formulations, Beams, Plates},
abstract = {Physics-informed neural networks (PINNs) embed governing equations into the training objective and provide a data-efficient machine-learning framework for problems governed by partial differential equations (PDEs). When applying the PINN framework to stiff PDEs, a deterioration of training speed and accuracy can be observed. From a mathematical perspective, the high ratio of coefficients in a stiff PDE is the source of locking effects, known from other discretization schemes. This work investigates transverse shear locking in PINNs for Timoshenko beams and Reissner–Mindlin plates and proposes effective mitigation strategies. We implement energy-based PINNs using different parametrizations of the kinematics: the standard parametrization and hierarchic parametrizations. Our results demonstrate that standard approaches exhibit severe locking behavior, with training speed deteriorating significantly as the slenderness increases. Based on an in-depth study of the training dynamics, we identify the causes of transverse shear locking in PINNs considered in this work. To address them, we adapt hierarchic formulations from structural mechanics to the PINN framework by: (1) using hierarchic formulations that directly parametrize the shear deformation, (2) employing separate neural networks for each primary variable to isolate the trainable parameters, and (3) introducing a slenderness-dependent scaling factor for the shear deformation variable to balance the gradients of the energy terms for training. The proposed method achieves fast, slenderness-independent training and convergence for both beam and plate problems for all variables of interest. The method is developed using energy-based forward-solving PINNs, and its transfer to related PDE-loss-based learning frameworks is illustrated with a parametric PINN.}
}
@article{MENG2026119344,
title = {A multi-phase hygro-mechanical phase-field model for drying shrinkage of concrete},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119344},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119344},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526006171},
author = {Songsong Meng and Haiming Liu and Maurizio Guadagnini and Yufeng Lai and Yang Jiang and Xu Long and Kypros Pilakoutas},
keywords = {Porous material, Multiscale modelling, Multi-physics framework, Voronoi tessellation, Phase-field model, Drying shrinkage},
abstract = {Drying shrinkage cracks induced by moisture loss can govern the durability and service life of concrete structures. However, capturing the coupled mechanisms of moisture transport, capillary stress development, and fracture within the heterogeneous microstructure of concrete remains challenging with conventional finite element method. This study presents a multi-scale hygro-mechanical phase-field framework for simulating drying-shrinkage-induced cracking at the mesoscale. The proposed framework couples moisture diffusion with an elasto-plastic phase-field formulation, in which shrinkage deformation is driven by capillary stress arising from moisture loss within the pore and interfacial transition zone phases. The heterogeneous structure of concrete, including aggregates, mortar, interfacial transition zone, and pore networks, is explicitly represented using Monte Carlo-based aggregate generation and Voronoi tessellation. This framework enables a fully coupled analysis of internal relative humidity evolution, shrinkage deformation, and damage propagation. The proposed model is validated against experimental measurements, showing good agreement in both relative humidity evolution and drying shrinkage development. Parametric investigations further demonstrate the ability of the framework to capture the influence of water/cement ratio, porosity, and environmental conditions on shrinkage and damage state. The proposed approach provides a robust tool for analysing hygro-mechanical interactions in cementitious materials and offers improved predictive capability for durability and long-term performance.}
}
@article{FENG2026119311,
title = {Multi-level adaptive mesh refinement with non-local energy correction for sharp-diffusive phase-field fracture models},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119311},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119311},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005840},
author = {Ye Feng and Yu-Dong Ren and Guang-Da Lu},
keywords = {Adaptive mesh refinement, Non-local energy correction, Phase-field fracture model, Cohesive zone model, Sharp-diffusive Ω-model},
abstract = {Recently, a new class of cohesive phase-field fracture models featuring emergent strong discontinuities has been developed. Theoretically, these models exhibit Dirac-type localization of damage and genuine displacement jumps within a diffuse, continuous phase-field description. Although beneficial for fracture representation, this sharp-diffusive nature introduces severe computational challenges due to the strong damage localization. The present work develops a model-aware adaptive computational framework tailored to this class of formulations. Using the Ω2-model as a representative example, we first conduct a 1D theoretical error analysis to investigate mesh-induced errors in the fracture energy and the traction–separation law. The analysis reveals two key insights: (i) the leading-order error is strictly governed by the element size inside the highly localized ω-damage zone, whereas the diffuse phase-field region contributes only higher-order errors; and (ii) the numerical traction–separation law preserves its functional shape: the mesh size affects the fracture energy (i.e., the area under the curve) but maintains the overall profile (e.g., linearity). This finding leads to an explicit, mesh-dependent correction of the fracture energy. Based on these results, we propose a multi-level adaptive mesh refinement strategy augmented with non-local energy correction. The finest elements are restricted to the sharp crack core identified by ω, intermediate refinement is assigned to the surrounding phase-field transition zone, and the fracture energy is corrected non-locally over a domain proportional to ℓ, following the analytical derivation. Numerical experiments covering tensile, shear, compression-driven multi-axial, mixed-mode, dynamic branching, quasi-brittle, and abrupt brittle fractures validate the proposed methodology. In a benchmark example, the proposed approach reduces the total element count by up to 95.3% and achieves a 63-fold computational speedup. Moreover, the predicted crack paths and global force–displacement responses agree excellently with uniformly refined baselines, demonstrating that the multi-level AMR strategy markedly enhances efficiency without sacrificing accuracy.}
}
@article{QI2026119328,
title = {Invariant-manifold-based model reduction for state transition equations of geometrically exact beam dynamics},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119328},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119328},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526006018},
author = {Yifan Qi and Shilei Han and Minghe Shan and Qiang Tian},
keywords = {Geometrically exact beam, Invariant manifold, Model reduction, Floating frame of reference formulation},
abstract = {This paper presents a computationally efficient invariant-manifold-based model reduction framework for the nonlinear dynamics of free beams and beam assemblies. Although geometrically exact formulations provide high fidelity, they become prohibitively expensive for high-dimensional problems. To address this issue, a “temporal discretization followed by reduction” procedure is proposed. This methodology represents a significant advancement over the “reduction followed by temporal discretization” sequence used in the authors’ previous research. By fundamentally restructuring the problem to eliminate the computational bottlenecks of repetitive time integration and Newton iterations, this approach provides a substantially more efficient and streamlined framework for reduced-order modeling. The full-order dynamics are first discretized by the discontinuous Galerkin scheme, which provides unconditional stability and suppresses high-frequency components of the response. Invariant-manifold-based reduction is then applied to the resulting state-transition equations, yielding a very low-dimensional reduced state-transition equation and thereby avoiding repetitive time integration and Newton iterations. Besides this primary innovation, the work provides several key advancements: (1) A reformulated state-space governing equation for geometrically exact beams within the floating frame of reference formulation, which eliminates the Lagrange multipliers and explicit frame motion equations required in previous studies. (2) An implicit construction of the state-transition relationship in the full-order equations, which preserves the sparse pattern of the large-scale matrices resulting from the temporal discretization and allows the cohomological equations to leverage this sparsity for enhanced performance. (3) A diagonal decomposition of the coefficient matrix of the reduced-order dynamics is introduced. This strategy uncouples column-wise higher-order cohomological equations into independent linear systems, leading to efficient computation for manifold construction. Numerical examples demonstrate that the proposed approach achieves the expected convergence rates with respect to the time-step size and the interpolation order of the test and trial functions. By leveraging an explicit state-transition mapping for time marching, the method achieves faster online computation, thereby enhancing its practical applicability for rapid simulation of free-flying beam structures.}
}
@article{MARTIN2026119315,
title = {Efficient reduced-order model based on n-point bounds for homogenization of elastic composites},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119315},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119315},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005888},
author = {A. Martin},
keywords = {Linear homogenization, n-point bounds, Fast Fourier transform, Reduced-order model},
abstract = {This paper aims at developing a reduced-order model for the homogenization of linear elastic composites with variable material properties. We particularly focus on periodic two-phase microstructures whose phases have a fixed geometry, and whose local behaviour is isotropic. To build our model, we use the n-point bounds that were derived by some authors with the minimum of the potential energy with particular trial fields. These trial fields arise naturally from the Neumann–Liouville expansion associated to the Lippmann–Schwinger equation. These fields naturally define a reduced modal basis for approximating the local solution. The advantage of this technique is (i) to consider few unknowns to estimate the solution, (ii) to generate the modal fields with few FFT-convolutions. Besides, the technique also provides rigorous bounds of the effective properties. The use of FFT to generate the trial fields also enables the treatment of composites with complex geometries beyond analytically tractable cases. In a second time, we show that a decomposition of the modal fields (and of the energies) can be used to construct a parametric model for the homogenization of composites with variable material properties. The decomposition decouples (partially) the geometry of the composite from the local material properties, in the spirit of the derivation of classical three-point and four-point bounds.}
}
@article{DAI2026119239,
title = {Efficient contact dynamics for deformable bodies via novel signed distance field reconstruction method},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {462},
pages = {119239},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119239},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526005128},
author = {Shukai Dai and Lijing Wang and Ping Zhou and Wei Fan and Zhuoran Tian and Hui Ren},
keywords = {Deformable body contact, Signed distance field, Complex geometry, Inverse mapping, First-order Taylor expansion},
abstract = {Efficient and accurate contact detection remains a major bottleneck in deformable-body contact dynamics, especially for problems involving complex geometries, large rigid-body motions, and finite deformations. To address this issue, this paper proposes a rapid signed distance field (SDF) reconstruction method for efficient contact detection of deformable bodies without frequent voxelization-based reconstruction. The method first employs axis-aligned bounding boxes (AABBs) in the broad-phase to identify potential contact pairs, and then uses SDFs in the narrow-phase when contact is imminent. To overcome the loss of validity of precomputed SDFs during deformation, a hybrid reconstruction strategy is developed: a first-order Taylor expansion is used for rapid reconstruction under small displacements and small deformations, whereas an inverse mapping method is adopted for large rigid-body motions and finite deformations. Based on the reconstructed SDF, the contact gap and contact normal can be directly evaluated through trilinear interpolation. The effectiveness of the proposed method is validated through representative examples by comparison with ABAQUS. The results show that the proposed method significantly improves computational efficiency while maintaining accuracy.}
}