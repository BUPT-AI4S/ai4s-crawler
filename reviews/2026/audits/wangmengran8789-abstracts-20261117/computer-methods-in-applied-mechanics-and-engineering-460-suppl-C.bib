@article{NORMAN2026119099,
title = {Learning gradient flow: Using equation discovery to accelerate engineering optimization},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119099},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119099},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003725},
author = {Grant Norman and Conor Rowan and Kurt Maute and Alireza Doostan},
keywords = {Equation discovery, Data-driven modeling, Gradient flow, Surrogate models, Optimization},
abstract = {In this work, we investigate the use of data-driven equation discovery for dynamical systems to model and forecast continuous-time dynamics of unconstrained optimization problems. To reduce expensive evaluations of the objective function and its gradient, we leverage trajectory data on the optimization variables to learn the continuous-time dynamics associated with gradient descent, Newton’s method, and ADAM optimization. The discovered gradient flows are then solved as a surrogate for the original optimization problem. To this end, we introduce the Learned Gradient Flow (LGF) optimizer, which is equipped to build surrogate models of variable polynomial order in full- or reduced-dimensional spaces at user-defined intervals in the optimization process. We demonstrate the efficacy of this approach on several standard problems from engineering mechanics and scientific machine learning, including inverse problems, structural topology optimization, and two numerical solutions of boundary value problems with different discretizations. Our results suggest that the learned gradient flows can significantly expedite convergence by capturing critical features of the optimization trajectory while reducing expensive evaluations of the objective and its gradient.}
}
@article{LABATUT2026119061,
title = {Parametric vector flows for registration fields in bounded domains with applications to nonlinear interpolation of shock-dominated flows},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119061},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119061},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003348},
author = {Jon Labatut and Angelo Iollo and Tommaso Taddei and Jean-Baptiste Chapelier},
keywords = {Model order reduction, Registration, Parametric CFD, Kolmogorov n-width},
abstract = {We present a registration procedure for parametric model order reduction (MOR) in two- and three-dimensional bounded domains. In the MOR framework, registration methods exploit solution snapshots to identify a parametric coordinate transformation that improves the approximation of the solution set through linear subspaces. For each training parameter, optimization-based (or variational) registration methods minimize a target function that measures the alignment of the coherent structures of interest (e.g., shocks, shear layers, cracks) for different parameter values, over a family of bijections of the computational domain Ω. We consider diffeomorphisms Φ that are vector flows of given velocity fields v with vanishing normal component on ∂Ω; we rely on a sensor to extract appropriate point clouds from the solution snapshots and we develop an expectation–maximization procedure to simultaneously solve the point cloud matching problem and to determine the velocity v (and thus the bijection Φ); finally, we combine our registration method with the nonlinear interpolation technique of Iollo and Taddei (2022) to perform accurate interpolations of fluid dynamic fields in the presence of shocks. Numerical results for a two-dimensional inviscid transonic flow past symmetric and asymmetric NACA airfoils and a three-dimensional viscous transonic flow past an ONERA M6 wing illustrate the many elements of the methodology and demonstrate the effectiveness of nonlinear interpolation for shock-dominated fields.}
}
@article{WU2026119113,
title = {Concurrent topology optimization of co-dimensional continuum structures within a unified level set field},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119113},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119113},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003865},
author = {Haoran Wu and Peng Wei and Dingkun Chen and Ben Cheng and Winston Wai Shing Ma and Michael Yu Wang},
keywords = {Topology optimization, Level set method, Level set field, Co-dimensional structures},
abstract = {The level set method (LSM), a representative topology optimization method, has gained considerable attention for its clear structural boundary representation. Typically, LSM requires constructing a level set function of one dimension higher than the structural boundary interface, implying that the level set function's dimensionality is inherently dependent on the structure's dimensionality. In addition, many engineering structures are composed of components with various dimensions (such as 1D beams, 2D shells, and 3D solids), which are referred to as co-dimensional structures. However, the inherent dimensional relationship in LSM poses a fundamental challenge for the topology optimization of such structures, because a single unified level set function cannot adequately represent them. To address this issue, this work develops a new scheme that constructs a unified high-dimensional level set field for concurrent topology optimization of co-dimensional continuum structures composed of 2D shells and 3D solids. This level set field, constructed utilizing 3D radial basis functions, enables concurrent and compatible optimization of co-dimensional structures. Furthermore, this work proposes a precise and independent local-volume-control strategy for individual components, overcoming the difficulty of locally regulating volume fractions in the LSM without introducing additional numerical complexity, thereby unlocking a larger design space. Numerical examples are presented to verify the effectiveness and robustness of the scheme, which employs a stereoscopic viewing technique to enhance the visualization of optimized structures. This study further refines the LSM, expands its applicability, and contributes new theoretical insights.}
}
@article{CARLINO2026119097,
title = {Analysis and applications of collocation-based model order reduction},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119097},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119097},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003701},
author = {Michele Giuliano Carlino and Alessia {Del Grosso} and Angelo Iollo and Denis Sipp},
keywords = {Model order reduction, Collocation-based ROM, Hyper-reduction, Stability and convergence},
abstract = {We consider a novel reduced-order modeling strategy, termed collocation Model Order Reduction (cMOR), as an alternative to classical projection-based Model Order Reduction (pMOR). Like pMOR, cMOR follows an offline–online paradigm, with an offline stage devoted to the construction of a reduced basis from solution snapshots. In contrast to pMOR, where the online phase computes the reduced solution by projecting the high-fidelity residual onto the reduced space, cMOR enforces the high-fidelity discretization of the governing equations only at a small set of mesh locations, referred to as collocation points. These points are selected using hyper-reduction techniques. Within this framework, we provide a theoretical analysis of the stability and convergence properties of cMOR and illustrate the method performance through numerical examples.}
}
@article{BURMAN2026119077,
title = {Solving inverse parametrized problems via finite elements and extreme learning networks},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119077},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119077},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003506},
author = {Erik Burman and Mats G. Larson and Karl Larsson and Jonatan Vallin},
keywords = {Parametric Elliptic PDEs, Interpolating surrogate model, Random Feature Methods, Extreme Learning Machines, Inverse problems},
abstract = {We develop an interpolation-based modeling framework for parameter-dependent partial differential equations arising in control, inverse problems, and uncertainty quantification. The solution is discretized in the physical domain using finite element methods, while the dependence on a finite-dimensional parameter is approximated separately. We establish existence, uniqueness, and regularity of the parametric solution and derive rigorous error estimates that explicitly quantify the interplay between spatial discretization and parameter approximation. In low-dimensional parameter spaces, classical interpolation schemes yield algebraic convergence rates based on Sobolev regularity in the parameter variable. In higher-dimensional parameter spaces, we replace classical interpolation by extreme learning machine (ELM) surrogates and obtain error bounds under explicit approximation and stability assumptions. The proposed framework is applied to inverse problems in quantitative photoacoustic tomography, where we derive potential and parameter reconstruction error estimates and demonstrate substantial computational savings compared to standard approaches, without sacrificing accuracy.}
}
@article{LU2026119123,
title = {Morephy-Net: An evolutionary multi-objective optimization for replica-exchange-based physics-informed neural operator learning networks},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119123},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119123},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003968},
author = {Binghang Lu and Changhong Mou and Guang Lin},
keywords = {Physics-informed operator learning, Evolutionary multi-objective optimization, Uncertainty quantification, Replica exchange stochastic gradient Langevin dynamics, Parametric PDEs, Inverse problem},
abstract = {We propose an evolutionary Multi-objective Optimization for Replica-Exchange-based Physics-informed operator-learning Networks (Morephy-Net) to solve parametric partial differential equations (PDEs) in noisy data regimes, for both forward prediction and inverse identification. Existing physics-informed neural networks and operator-learning models (e.g., DeepONets and Fourier neural operators) often face three coupled challenges: (i) balancing data/operator and physics residual losses, (ii) maintaining robustness under noisy or sparse observations, and (iii) providing reliable uncertainty quantification. Morephy-Net addresses these issues by integrating: (i) evolutionary multi-objective optimization that treats data/operator and physics residual terms as separate objectives and searches the Pareto front, thereby avoiding ad hoc loss weighting; (ii) replica-exchange stochastic gradient Langevin dynamics to enhance global exploration and stabilize training in non-convex landscapes; and (iii) Bayesian uncertainty quantification obtained from stochastic sampling. We validate Morephy-Net on representative forward and inverse problems, including the one-dimensional Burgers equation and the time-fractional mixed diffusion–wave equation. The results demonstrate consistent improvements in accuracy, noise robustness, and calibrated uncertainty estimates over standard operator-learning baselines.}
}
@article{LV2026119101,
title = {A unified energy framework combining nonlocal macro-meso-scale consistent damage and cohesive zone models for failure prediction of fiber-reinforced composites},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119101},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119101},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003749},
author = {Weifan Lv and Xiaoying Zhuang and Xiaozhou Xia and Xin Gu and Qing Zhang},
keywords = {Fracture of composites, Energy unification, Nonlocal–local compatibility, Nonlocal macro-meso-scale consistent damage, Cohesive zone model},
abstract = {In this study, we propose a unified numerical framework based on energy that couples the nonlocal macro-meso-scale consistent damage model (NMMD) for the bulk with the cohesive zone model (CZM) for material interfaces to simulate complex crack propagation in multi-constituent composite systems. The NMMD can accurately capture the crack initiation, growth, and coalescence within individual constituents, whereas the cohesive laws describe the interfacial separation and sliding well without overestimation of the interface thickness in nonlocal formulations. Moreover, variational coupling guarantees energy additivity and prevents double counting by mapping the cross-interface nonlocal contributions onto a zero-thickness cohesive surface; thus, the bulk and interface dissipations remain disjointed and consistent. Subsequently, numerical studies on different composite material structures solidly validate the approach, showing that the predicted crack paths and mechanical responses are sensitive to interfacial strength and correctly reflect mode transitions. The framework accurately reproduces the crack evolution in fiber-reinforced materials. Remarkably, the formulation establishes an energetically consistent connection between nonlocal bulk damage and local interface fracture, thereby providing new insight into the fracture behavior and toughening mechanisms in structured fiber-reinforced composites.}
}
@article{MORETTO2026119087,
title = {A stabilized mortar method for discontinuities in geological media with non-conforming grids},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119087},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119087},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003609},
author = {Daniele Moretto and Andrea Franceschini and Massimiliano Ferronato},
keywords = {Contact mechanics, Lagrange multipliers, Mortar method, Stabilization, Corner-point grid},
abstract = {Accurate numerical simulation of fault and fracture mechanics is critical for the performance and safety assessment of many subsurface systems. The discretized representation of discontinuity surfaces and the robust simulation of their frictional contact behavior still represent major challenges. In this work, we use the mortar method to enforce the contact constraints and allow for non-conformity around the discontinuity surface, with a set of Lagrange multipliers playing the role of interface tractions. The formulation combines piecewise linear displacements with piecewise constant multipliers defined on one side of the fault interface (the non-mortar side). This choice for the Lagrange multipliers has a number of advantages from practical and computational viewpoints, but violates the inf–sup stability constraint. In order to stabilize the proposed formulation, we develop a traction-jump stabilization term to be added to the constraint equations. We use a macro-element analysis to derive an algorithmic strategy that automatically evaluates the proper scaling of the stabilization, without requiring any additional user-selected parameter. Numerical experiments demonstrate that the proposed formulation not only restores the inf–sup stability condition, but also recovers stable traction profiles in the presence of finer non-mortar sides, where other inf–sup-stable formulations fail. The proposed method is finally used to simulate non-linear contact conditions in non-conforming corner-point grids typically used in industrial geological applications.}
}
@article{WU2026119135,
title = {Machine-learning driven differentiable concurrent multiscale topology optimization framework for truss structures},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119135},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119135},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004081},
author = {Yichen Wu and Lei Wang and Yaru Liu},
keywords = {Truss lattices, Multiscale topology optimization, Machine learning, Neural networks},
abstract = {Multiscale truss structures, composed of periodic or spatially varying truss lattices, have demonstrated significant potential due to their high load-bearing capacity with minimal material usage. However, conventional truss lattice design methods are largely empirical or heuristic, constrained by the vast and discretized nature of the design space, which limits their integration with efficient structural design approaches such as gradient-based multiscale topology optimization. In this work, we propose a gradient-based multiscale topology optimization framework tailored for multiscale truss structures, integrating machine learning methods. Within this framework, truss lattice geometries are represented as graph structures defined by nodes and connectivity features, and a candidate lattice topology database is generated through a novel self-evolving sampling strategy to mitigate computational costs. The discretized, high-dimensional topology space of the candidate lattices is then mapped into a low-dimensional continuous design space using a newly developed topology decoder neural network, meanwhile achieving direct control on the boundary connectivity patterns of the reconstructed lattice topologies, and a loss function is proposed to improve the quality of the design space via network training. Subsequently, a GCN-based neural network is employed as a differentiable predictor of the equivalent mechanical properties of the truss lattice geometries. Furthermore, the resulting differentiable and unified design space is incorporated into a gradient-based multi-material multiscale topology optimization framework, enabling concurrent optimization of both macroscopic topology layouts and spatially varying microscopic lattice structures. Numerical examples are presented to validate the effectiveness of the proposed framework in achieving efficient designs of lightweight multiscale truss structures with high load-bearing performance.}
}
@article{VIEVERING2026119086,
title = {On robustness of stochastic finite element analysis of damage and fracture of heterogeneous materials},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119086},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119086},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003592},
author = {Joshua Vievering and Joseph F. Labuz and Jia-Liang Le},
keywords = {Random fields, Stochastic finite elements, Localization, Damage, Fracture, Mesh objectivity},
abstract = {Stochastic finite element (SFE) analysis is anchored by the knowledge of spatial randomness of material properties, which are often represented by random fields. These fields are typically generated over sampling grids that are able to capture the spatial correlation of the random material properties. Since the grids of random fields rarely coincide with the FE mesh, a mapping procedure is required to transfer material properties from the sampling grids to the Gauss points of the FE mesh. The challenge becomes pronounced for heterogeneous materials, which often display complex failure processes such as damage localization, distributed damage, and transitions between them. These mechanisms could produce strongly inhomogeneous deformation within the finite elements, complicating the mapping of random fields. This study examines how different mapping strategies affect the robustness of SFE analysis for heterogeneous materials, using bending beam and cavity expansion tests on Dunnville sandstone specimens that exhibit diverse failure patterns. Three mapping methods, namely the local mapping method, the local averaging method, and the mechanism-based adaptive mapping method, are considered. The comparison between the experimental and simulation results shows the critical importance of linking the mapping algorithm to the evolving mechanical behavior of each finite element in order to ensure model robustness. The analysis further clarifies the influence of different length scales including the FE mesh size, correlation length of the random fields, and width of fracture process zone on the performance of the mapping method. The study offers new insights into the experimental calibration and validation of SFE models.}
}
@article{NGUYEN2026119096,
title = {Simultaneous optimization of material distribution and variable thickness for free vibration of FG-CNTRC shells using 3D isogeometric analysis and K-means optimizer},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119096},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119096},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003695},
author = {Khuong D. Nguyen and Binh Khanh Ngo and Thanh Cuong-Le},
keywords = {IGA, K-means optimizer, Carbon nanotube reinforced, Free vibration, Shell structures},
abstract = {This paper presents a novel framework for the simultaneous optimization of material distribution and structural geometry (variable thickness) of functionally graded carbon nanotube-reinforced composite (FG-CNTRC) shells. A three-dimensional Isogeometric Analysis (IGA) is employed to capture structural responses accurately with high-order continuity, overcoming the limitations of conventional shell theories. A clustering-based K-means Optimization (KO) algorithm is integrated to efficiently identify both the optimal nanotube distribution and the optimal thickness profile. By adopting a smooth functional representation, the method avoids material discontinuities and artificial stress concentrations. Numerical investigations on cylindrical, annular, and conical shells confirm the reliability of the proposed approach. The findings reveal that while surface-enriched nanotube distributions enhance stiffness, optimizing the thickness profile (e.g., thicker boundaries, thinner mid-span) leads to a dramatic performance leap. Specifically, the combined optimization yields a three-fold increase in natural frequency and significant mass savings (∼40 %) compared to uniform shells. The study establishes a robust strategy for designing lightweight, high-performance composite structures.}
}
@article{LI2026119102,
title = {A unified Direct FE2 variational phase-field framework for multiphysics modeling of hydrogen-assisted cracking},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119102},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119102},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003750},
author = {Wei Li and Minghua Chi and Han Zhao and Hongbo Huang and Dewei He and Yuhao Tan and Yunpeng Gao and Xiangguo Zeng and Vincent Beng Chye Tan},
keywords = {Phase-field fracture, Direct FE, Multiscale method, Hydrogen embrittlement, Reactor pressure vessel},
abstract = {Hydrogen-assisted cracking (HAC) poses a critical challenge for structural alloys, as it involves tightly coupled thermo–chemo–mechanical processes across scales that elude engineering-level prediction. We present a thermodynamically consistent, Direct FE2 variational phase-field framework that enables concurrent, energetically consistent, and computationally tractable HAC simulations. All underlying physical processes, including lattice diffusion with reversible trapping and thermodiffusion, thermo–chemo–elastoplasticity, and phase-field fracture with hydrogen-degraded toughness, are derived from a single free energy functional. Macro–micro interactions are enforced monolithically satisfying the Hill–Mandel condition, while an on-demand microdomain activation strategy resolves the full microphysics only within mechanically or environmentally critical corridors. Benchmarks demonstrate that the framework accurately and efficiently reproduces direct numerical simulation results for mechanical response, crack paths, and ultimate strength. Applied to a reactor pressure vessel substructure with internal pressure, temperature gradients, and long-term hydrogen ingress, the framework predicts the critical internal pressure, preferred crack path, and through-wall failure susceptibility. Parametric studies reveal thermal-gradient-assisted transport with persistent hydrogen trapping, shear-dominated coalescence guided by void ligaments, and microstructure-controlled thresholds for through-wall cracking. The inherently modular framework allows new physical mechanisms to be incorporated through additional field variables and free energy/kinetic terms at the microdomain, providing a practical and extensible framework for physics-based failure prediction and microstructure-informed design in a broad range of environmentally accelerated damage.}
}
@article{HE2026119116,
title = {An efficient mixed FEM for flexoelectricity based on condensation of Lagrange multipliers},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119116},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119116},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003890},
author = {Zhuangzhuang He and Xiangyu Li and Weisheng Zhang and Weiqiu Chen and Chunli Zhang},
keywords = {Flexoelectricity, Multi-field coupling, Mixed FEM, Lagrange multipliers, Static condensation, C continuity},
abstract = {Flexoelectric analysis involves strain gradients, which pose significant challenges for standard finite element discretization due to the C1 continuity requirements. While mixed finite element methods (FEMs) effectively relax this requirement to C0 by introducing auxiliary variables and Lagrange multipliers, they significantly increase the global degrees of freedom (DOFs) and lead to indefinite saddle-point matrices, thereby limiting computational efficiency and stability. To overcome this issue, we present an efficient mixed FEM by condensing the Lagrange multipliers. By introducing bubble functions into the independent strain field and implementing a two-step sequential static condensation strategy, we eliminate the local bubble DOFs and discontinuous Lagrange multipliers prior to global assembly. This approach transforms the indefinite saddle-point stiffness matrix into a highly compact and well-conditioned algebraic system. Performance evaluations show that, compared to typical mixed FEMs, the presented element avoids the massive fill-in issues caused by asymmetric direct solvers. Under the same mesh resolution, the computational DOFs and peak memory usage are significantly reduced, and the computation time is greatly shortened. Furthermore, since the condensed fields have no associated inertial terms, this static condensation strategy remains strictly exact in structural dynamics. Through a series of numerical benchmarks, including the reproduction of forced vibration experiments, patch tests, steady-state electromechanical responses, and wave dispersion characteristics of microplates, the proposed element demonstrates its excellent accuracy, robustness, and broad applicability in solving complex static, transient, and frequency-domain problems. The finite element model is constructed using MATLAB, and the implementation code is available as open source on GitHub.}
}
@article{ZOU2026119094,
title = {Modeling and design of curved thin-walled Voronoi lattice infill structures for stiffness robustness and buckling performance},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119094},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119094},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003671},
author = {Binze Zou and Rui Yang and Bin Niu},
keywords = {Thin-walled structures, Voronoi lattice, Topology optimization, Curved lattice structure},
abstract = {Curved thin-walled lattice structures have been increasingly explored for lightweight engineering applications. Voronoi lattice structures have been adopted for two-dimensional (2D) planar and three-dimensional (3D) spatial structures owing to their ability to preserve the mechanical performance under load uncertainty and structural defects. In addition, smooth density grading within the lattice structures can be achieved by adjusting the distribution of the Voronoi sites. In this work, a modeling and design method for the curved thin-walled Voronoi infilled lattice structures is proposed for the stiffness robustness and the buckling performance. First, an implicit Voronoi microstructure is obtained based on a Voronoi diagram constructed as the dual of a triangulation, and the equivalent elastic properties are calculated using the stiffness prediction method for the Voronoi lattices with in-plane periodicity. Second, the stiffness robustness and the buckling performance of the Voronoi lattice structures are analyzed. Then, a design optimization model for the stiffness robustness with a buckling constraint is established. Moreover, according to the optimization results, 3D curved thin-walled Voronoi lattice structures are constructed based on the conformal mapping method. The generated structure serves as a 3D discretized mesh model suitable for finite element analysis and additive manufacturing. Finally, the effectiveness of the proposed method for the stiffness robustness and the buckling performance design is verified through numerical examples. The stiffness robustness and the buckling performance are discussed for structures with random local defects, and the effects of the optimization parameters and the microstructure types on the mechanical performance are also investigated.}
}
@article{GROSS2026119088,
title = {Tensor network lattice Boltzmann method for data-compressed fluid simulations},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119088},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119088},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003610},
author = {Lukas Gross and Elie Mounzer and David M. Wawrzyniak and Josef M. Winter and Nikolaus A. Adams},
keywords = {Lattice Boltzmann method, Matrix product states, CFD},
abstract = {Resolving unsteady transport phenomena in geometrically complex domains is traditionally constrained by polynomial scaling of computational cost with spatial resolution. While methods based on tensor-network data representations or matrix-product states (MPS) data encodings have emerged as a technique to systematically reduce degrees of freedom, existing formulations do not extend to complex geometries and complex flow physics. Both capabilities are offered by lattice Boltzmann methods, for which we develop a generalized MPS formulation. This development marks a paradigm shift from classical methods that rely on explicit grid refinement for data reduction. Instead, our approach exploits non-local correlations in the MPS representation to systemically compress the global fluid state directly without modifying the underlying grid. We benchmark the proposed solver against classical LBM using three-dimensional flows through structured media and vascular geometries. The results confirm that the MPS formulation reproduces the reference solution with high fidelity while achieving compression ratios exceeding two orders of magnitude, positioning tensor networks or MPS encodings as a scalable paradigm for continuum mechanics on high-performance GPU hardware.}
}
@article{ABDOLAZIZI2026119080,
title = {Thermodynamically consistent viscoelastic constitutive artificial neural networks: Automating the pipeline from experimental data to finite element simulations},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119080},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119080},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003531},
author = {Kian P. Abdolazizi and Roland C. Aydin and Christian J. Cyron and Kevin Linka},
keywords = {Internal state variables, Fiber-reinforced materials, Abaqus user subroutine (UMAT), Scientific machine learning, Soft tissue biomechanics, Elastomer mechanics, Hyperelasticity},
abstract = {Viscoelastic constitutive artificial neural networks (vCANNs) leverage neural networks for data-driven modeling of the viscoelastic behavior of materials. Here, we propose a thermodynamically consistent extension of vCANNs that captures anisotropic, nonlinear, and time-dependent material behavior. A key strength of this approach is its ability to incorporate arbitrary auxiliary features—such as temperature, microstructural descriptors, or processing parameters—directly into neural constitutive laws. We propose an automated computational pipeline for the generation and implementation of such constitutive laws within the proposed framework into finite element (FE) simulations without manual model design. The proposed framework is validated across a broad range of representative material tests, including the nonlinear, thermo-viscoelastic response of soft polymers and arterial tissue with fiber dispersion. In addition, we demonstrate the accuracy and robustness in FE simulations using benchmark problems such as Cook’s membrane. The results underscore the flexibility, physical plausibility, and numerical stability of vCANNs as a powerful class of constitutive models for modern FE simulations enhanced by machine learning.}
}
@article{CHABIB2026119104,
title = {Conjugate gradient preconditioned by regularization with Ritz postprocessing for ill-posed problems},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119104},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119104},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003774},
author = {Ahmed Chabib and Jean-François Witz and Vincent Magnier and Pierre Gosselet},
keywords = {Regularization, Preconditioning, Conjugate gradient, Ritz values, L-curve, Picard plot},
abstract = {This paper proposes a conjugate gradient framework for Lavrentyev-regularized ill-posed problems in which the regularization operator is also used as the preconditioner. This choice provides meaningful norms for monitoring convergence and enables an efficient Ritz-based postprocessing of the iterates. In particular, approximate solutions associated with a whole range of regularization parameters can be obtained at negligible additional computational cost. The approach is assessed on a boundary data completion problem and on optical flow estimation, where it is used as the inner linear solver.}
}
@article{LUO2026119092,
title = {Cross-scale interval robust topology optimization (CIRTO) considering multi-source uncertainties via improved Taylor series expansion method},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119092},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119092},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003658},
author = {Zhenxian Luo and Honggang Liu and Yingke Zhang and Lei Wang},
keywords = {Cross-scale topology optimization, Interval robust optimization, Multi-source uncertainties, Improved taylor series-based method},
abstract = {Cross-scale topology optimization is a key technology for the structural design of advanced equipment, while the existence of multi-source uncertainties such as material properties and external loads significantly affects the robustness of the structural performance. To address this issue, a cross-scale interval robust topology optimization (CIRTO) considering multi-source uncertainties is proposed. The mechanical properties of materials, as well as the magnitude and direction of loads are defined as uncertain‑but-bounded parameters to establish an interval uncertain cross-scale topology optimization model. To tackle the non-monotonic relationship between structural responses and uncertain parameters, an improved Taylor series expansion method (ITEM) is proposed by utilizing gradient information to locate extreme points. ITEM enables efficient and accurate prediction of the interval bounds of structural responses, overcoming the limitation that the traditional Taylor series expansion method cannot handle non-monotonic problems. Furthermore, a robust index is constructed using the bounds of response intervals to conduct research on CIRTO, which balances solution accuracy and computational efficiency. Three numerical examples are given to verify the applicability and effectiveness of the proposed method, providing a new scheme for multiscale topology optimization considering multi-source uncertainties.}
}
@article{WANG2026119098,
title = {CausalPhysicsNet: Discovering effective coupling structure in multi-physics simulations via physics-informed temporal graph networks},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119098},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119098},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003713},
author = {Zhixue Wang and Xuefeng Ge and Ji Zhang and Hao Niu and Lei Wu},
keywords = {Multi-physics simulation, Graph neural networks, Causal discovery, Physics-informed learning, Surrogate modeling},
abstract = {Multi-physics simulations involving coupled partial differential equations present significant computational challenges in engineering applications. While graph neural networks have emerged as promising surrogate models for accelerating such simulations, existing approaches treat all physical interactions uniformly without distinguishing causal relationships between different physics domains. This limitation reduces interpretability and hampers generalization to unseen parameter regimes. We propose CausalPhysicsNet, a novel framework that simultaneously learns to predict multi-physics system evolution and to discover an effective, time-discretized causal dependency structure between coupled physics domains. The framework integrates three key components: a heterogeneous temporal graph neural network that respects physics-specific characteristics and supports overlapping physics domains sharing the same spatial region, a differentiable causal discovery module based on continuous optimization with acyclicity constraints, and a physics-informed contrastive learning mechanism that leverages discovered causal relationships. The heterogeneous architecture employs type-specific node encoders and relation-specific message passing with L=4 learnable temporal-delay layers, enabling the model to capture domain-specific representations and causal coupling mechanisms even when multiple physics are co-located on the same mesh. Extensive experiments on four benchmark problems including fluid–structure interaction and conjugate heat transfer demonstrate that CausalPhysicsNet achieves 23.4%±1.8% lower prediction error compared to state-of-the-art graph neural network surrogates while correctly identifying the discrete-time directional dependencies at the (small) physics-domain level with F1 scores exceeding 0.92. An empirical comparison on the Thermo-FSI benchmark against cyclic and acyclic-in-time alternatives confirms that the DAG formulation is statistically indistinguishable from the more general acyclic-in-time formulation, with paired t-test p-values of 0.42 (in-distribution) and 0.63 (out-of-distribution), while being ∼20% computationally lighter. The learned effective causal graphs provide interpretable insights into multi-physics coupling mechanisms and enable robust generalization under distribution shift, with performance degradation reduced by 67%±3.2% compared to baselines when extrapolating to unseen physical parameters. The framework scales to meshes with over 24,000 nodes and achieves speedups of up to 617× over numerical solvers.}
}
@article{DAR2026119090,
title = {Artificial Neural Network augmented hyper-reduced order model for transient flow optimization problems},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119090},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119090},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003634},
author = {Zulkeefal Dar and Joan Baiges and Ramon Codina},
keywords = {Reduced Order Modeling (ROM), Variational Multiscale Method (VMS), Discrete Empirical Interpolation Method (DEIM), Artificial Neural Network (ANN), Transient flow optimization},
abstract = {This paper introduces an Artificial Neural Network (ANN) augmented, Variational Multiscale (VMS) stabilized, hyper-reduced order model (HROM) for time-dependent fluid flow shape optimization applications. The method extends the authors VMS-based ROM with Discrete Empirical Interpolation Method (DEIM) hyper-reduction to achieve further computational efficiency. A fully discrete level nonlinear ANN correction term is applied to account for errors associated with both ROM projection and hyper-reduction that improves the stability, as well as the accuracy required for unsteady flows. The HROM approach we obtain here is implemented into a Sequential Least Squares Quadratic Programming (SLSQP) based gradient-based aerodynamic shape optimization problem. NACA airfoils at high angles of attack are chosen to get the transient effects like separation and vortex-shedding. The ANN correction is trained on snapshots from full-order simulations and used directly in the optimization loop at no additional cost. Numerical results show that the HROM with ANN-correction successfully captures the full order model accuracy for both transient prediction and optimization and achieves more than 95% reduction in computational cost. The results validate the effectiveness of the developed ANN-augmented HROM as an accurate and efficient counterpart for transient-CFD-based optimization problems.}
}
@article{GIVOLI2026119093,
title = {Full waveform inversion with an adjoint scheme for time-dependent inverse wave problems in nonlinear media},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119093},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119093},
url = {https://www.sciencedirect.com/science/article/pii/S004578252600366X},
author = {Dan Givoli and Daniel Rabinovich and Eli Turkel},
keywords = {Inverse problem, Identification, Full waveform inversion, Adjoint, Nonlinear medium, Waves, Time-dependent},
abstract = {The solution of time-dependent inverse wave problems in nonlinear media is considered, using Full Waveform Inversion (FWI). The goal is the identification of parameters related to the nonlinear material behavior. The adjoint method is employed for the efficient calculation of the functional gradient. A general formulation of the method at the semi-discrete level is presented. Two specific models are used to experiment with this formulation: a miniature model that lacks physical meaning, and a model of the deflection of a membrane made of a softening material. The method is specialized to these two models, and numerical experiments demonstrate its performance in each case. Computational aspects that are considered include assessing the success of the identification, and evaluating the performance of the method in the presence of measurement noise.}
}
@article{BAYAT2026119100,
title = {Density-based topology optimization for turbulent fluid flow using the standard k–ɛ RANS model with wall functions imposed through an implicit wall penalty formulation},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119100},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119100},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003737},
author = {Amirhossein Bayat and Hao Li and Joe Alexandersen},
keywords = {Density-based, Topology optimization, Implicit wall functions, RANS standard -ɛ model, High Reynolds-number flows, Boundary-layer modeling, Fluid dynamics},
abstract = {Turbulent flows have high requirements for very fine meshes near the boundary to ensure accuracy. In the context of topology optimization (TO), such fine meshes become unrealistic and common approaches are hampered by low accuracy and overestimation of boundary layer thickness. Wall functions are a natural way to ease the computational requirements, but they are not naturally imposed in density-based TO due to the diffuse design parametrization. We propose an implicit wall-function formulation for the Reynolds-Averaged Navier–Stokes (RANS) standard k–ɛ model, that extracts wall-normal information directly from the gradient of the design variable. It enables a penalty-based formulation for imposing wall functions to the RANS equations, eliminating the requirement for body-fitted meshes. This approach offers a robust pathway to high-Reynolds-number turbulent topology optimization, delivering boundary-layer accuracy comparable to explicit-wall body-fitted analyses, while retaining the flexibility of density-based TO. Furthermore, because wall effects are modeled using wall functions, accurate solutions are obtained on substantially coarser meshes, leading to significant reductions in computational cost. The approach is validated on three canonical benchmarks over Reynolds numbers up to Re=2×105: a pipe-bend; a U-bend; and a Tesla-valve. Across all cases, the proposed method accurately recovers near-wall velocity profiles, closely matching verification simulations on body-fitted meshes with explicit wall functions. In contrast, a conventional turbulent TO formulation, without the proposed wall-function treatment, mispredicts boundary-layer development and yields sub-optimal results.}
}
@article{PUNDIR2026119118,
title = {A versatile FEM framework with native GPU scalability via globally-applied AD},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119118},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119118},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003919},
author = {Mohit Pundir and Flavio Lorez and David S. Kammer},
keywords = {Finite-element analysis, Automatic differentiation, High-performance computing, Graph coloring, GPUs},
abstract = {Energy-based finite-element formulations provide a unified framework for describing complex physical systems in computational mechanics. In these energy-based methods, the governing equations can be obtained directly by considering the derivatives of a single global energy functional. While Automatic Differentiation (AD) can be used to automate the generation of these derivatives, current frameworks face a clear trade-off based primarily on the scale upon which the AD method is applied. Globally applied AD offers high expressivity but cannot currently be scaled to large problems. Locally applied AD scales well through traditional assembly methods, but the variety of physics and couplings that the framework can easily represent is more limited than the global approach. Here, we introduce an energy-centric framework (tatva) that defines the physics of a problem as a single global functional and applies AD globally to generate residual and tangent operators. By leveraging Jacobian-vector products for matrix-free solvers and coloring-based sparse differentiation for materializing sparse tangent stiffness matrices when needed, our flexible design scales linearly with the problem size on GPUs. We demonstrate that our framework can handle large problems (with millions of degrees of freedom) without memory exhaustion. Additionally, it offers a unified, fully differentiable methodology that can address a wide range of problems, including multi-point constraints, mixed-dimensional coupling, and the incorporation of neural networks, while maintaining high performance and scalability on modern GPU architectures.}
}
@article{BOVET2026119085,
title = {Full-scale crystal plasticity modeling and data-driven learning of microstructure effects in polycrystalline turbine blades},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119085},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119085},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003580},
author = {Christophe Bovet and Vincent Chiaruttini and Aurélien Vattré},
keywords = {Graph neural network, Mesh intersection, Adaptive finite element method, Heterogeneity, Dislocation density model, Crystal plasticity, High performance computing, FETI, Polycrystalline turbine blade},
abstract = {A computational framework is developed for full-scale crystal plasticity simulations of polycrystalline Ni-based superalloy turbine blades, explicitly accounting for microstructural heterogeneity. Realistic polycrystalline microstructures with prescribed grain size and orientation are embedded into complex geometries through a conformal meshing procedure, allowing the rapid generation of models with variable grain counts. The constitutive behavior is described by a dislocation-density-based crystal plasticity model incorporating geometrically necessary dislocations under finite deformations and non-isothermal loading conditions. The resulting high-fidelity nonlinear problems are solved using a grain-wise domain decomposition combined with an Adaptive Multipreconditioned FETI solver. The robustness and computational efficiency of the approach with respect to increasing microstructural resolution are demonstrated on a turbine blade geometry containing up to 40,000 grains under representative thermomechanical loading conditions. Finally, the generated simulation database is leveraged to train graph neural networks for predicting grain-averaged mechanical fields from morphological and crystallographic descriptors. The proposed methodology enables systematic investigation of microstructure-property relationships in components with realistic complexity.}
}
@article{WICHROWSKI2026119043,
title = {A geometric multigrid preconditioner for Shifted Boundary Method},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119043},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119043},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003166},
author = {Michał Wichrowski and Ajay Ajith},
keywords = {Immersed boundary methods, Finite element methods, Shifted Boundary Method, Multigrid, Patch smoothers},
abstract = {The Shifted Boundary Method (SBM) trades some part of the burden of body-fitted meshing for increased algebraic complexity. While the resulting linear systems retain the standard O(h−2) conditioning of second-order operators, the non-symmetry and non-local boundary coupling render them resistant to standard Algebraic Multigrid (AMG) and simple smoothers for high-order discretizations. We present a geometric multigrid preconditioner that effectively tames these systems. At its core lies the Full-Residual Shy Patch smoother: a subspace correction strategy that filters out some patches while capturing the full physics of the shifted boundary. Unlike previous cell-wise approaches that falter at high polynomial degrees, our method delivers convergence with low mesh dependence. We demonstrate performance for Continuous Galerkin approximations, maintaining low and stable iteration counts up to polynomial degree p=3 in 3D, proving that SBM can be both geometrically flexible and algebraically efficient.}
}
@article{BOTTI2026119095,
title = {A HHO formulation for variable density incompressible flows where the density is purely advected},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119095},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119095},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003683},
author = {Lorenzo Botti and Francesco Carlo Massa},
keywords = {Hybrid high-order, ESDIRK, Variable density, Incompressible Navier–Stokes, Pressure robustness, Pointwise divergence free},
abstract = {We propose a Hybrid High-Order (HHO) formulation of the incompressible Navier–Stokes equations with variable density that provides exact conservation of volume and, accordingly, pure advection of the density variable. The spatial discretization relies on hybrid velocity-density-pressure spaces and the temporal discretization is based on Explicit Singly Diagonal Implicit Runge–Kutta (ESDIRK) methods. The formulation possesses some attractive features that can be fruitfully exploited for the simulation of mixtures of immiscible incompressible fluids, namely: conservation of volume enforced cell-by-cell up to machine precision, pressure-robustness, ability to preserve density bounds at low-order, robustness in the convection dominated regime, weak imposition of boundary conditions, implicit high-order accurate time stepping, reduced memory footprint thanks to static condensation, possibility to exploit inherited p-multilevel solution strategies to improve the performance of iterative solvers. After addressing stability at the discrete level, numerical validation is performed showcasing spatial and temporal convergence rates. To conclude, we tackle the Rayleigh–Taylor instability at different Atwood and Reynolds numbers focusing on mesh independence capabilities.}
}
@article{MEI2026119089,
title = {Characterizing the spatial heterogeneity of pre-stressed soft solids},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119089},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119089},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003622},
author = {Yue Mei and Rongyao Kang and Yun Jin and Jianwei Deng and Zijie Ma and Sheng Mao},
keywords = {Pre-stress, Inverse problem, Heterogeneity, Nonlinear elasticity},
abstract = {Inverse characterization of pre-stressed soft solids with spatially heterogeneous elastic properties presents significant challenges in nonlinear elasticity, owing to the coupled nature of the unknown stress-free configuration and the spatial distribution of the material properties. In this work, we propose a sequential optimization framework for reconstructing the heterogeneous shear modulus of incompressible Neo-Hookean solids subjected to prestress. The method decomposes the inverse problem into two computationally tractable subproblems: the recovery of the initial (stress-free) configuration via an iterative inverse deformation procedure, and the identification of the spatially varying shear modulus using an adjoint-based gradient optimization scheme. The framework is implemented within a stabilized finite element formulation to mitigate volumetric locking and ensure numerical stability. The performance and robustness of the method are assessed through two- and three-dimensional numerical experiments,. Results demonstrate that neglecting prestress will lead to severe degradation in reconstruction quality, including underestimation of stiffness contrast and distorted recovery of the initial configuration, whereas the proposed approach yields accurate reconstructions even under moderate measurement noise. The presented formulation provides an efficient and extensible computational strategy for the quantitative identification of heterogeneous material parameters in pre-stressed solids, with potential applicability to large-scale biomechanical modeling and structural health monitoring.}
}
@article{VERHELST2026119103,
title = {Adaptive isogeometric analysis of high-order phase-field fracture based on THB-splines},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {460},
pages = {119103},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119103},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003762},
author = {H.M. Verhelst and L. Greco and A. Reali},
keywords = {Cross-talk, Isogeometric analysis, Phase-field fracture, THB-splines, Adaptive meshing},
abstract = {In recent decades, the study of fracture propagation in solids has increasingly relied on phase-field models. Several recent contributions have highlighted the potential of this approach in both static and dynamic frameworks. However, a major limitation remains the high computational cost. Two main strategies have been identified to mitigate this issue: the use of locally refined meshes and the adoption of higher-order models. In this work, leveraging Truncated Hierarchical B-splines (THB-splines), we introduce adaptive simulations of higher-order phase-field formulations (AT1 and AT2), focusing primarily on two-dimensional fracture problems.}
}