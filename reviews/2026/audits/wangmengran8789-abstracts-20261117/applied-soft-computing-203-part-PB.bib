@article{VERMA2026116164,
title = {Enhancing quantum classification with custom feature maps in variational quantum classifiers},
journal = {Applied Soft Computing},
volume = {203},
pages = {116164},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116164},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016121},
author = {Prashant Verma and Dinesh Kumar Vishwakarma},
keywords = {Quantum machine learning, Variational quantum classifier (VQC), Noisy intermediate-scale quantum (NISQ), Custom feature maps, Encoding design, Circuit complexity},
abstract = {This paper proposes a systematic study on the influence of quantum feature map design on the performance of Variational Quantum Classifiers (VQCs). While conventional encodings such as the ZZFeatureMap are widely adopted, they often overlook structural patterns in real-world data. To address this, three custom feature maps are introduced: Custom v2, Improved v3, and Correlation-aware v4, each designed to balance expressivity, trainability, and compatibility with noisy intermediate-scale quantum (NISQ) hardware. The proposed maps are benchmarked across ten binary classification datasets spanning various domains, using six key evaluation metrics: accuracy, training time, circuit depth, kernel alignment, gradient norm L2 and QNTK alignment. Experimental results indicate that Custom v2 offers a consistent trade-off between accuracy and resource efficiency, making it a suitable candidate for deployment on near-term quantum devices. In contrast, deeper maps like v3 and v4 exhibit stronger performance on datasets with pronounced feature correlations but require longer training and higher gate complexity. The study underscores that feature map design is a critical component in quantum model development, directly impacting learning outcomes and hardware feasibility.}
}
@article{WANG2026116029,
title = {Spatially robust and visually stealthy physical adversarial attacks on object detection systems},
journal = {Applied Soft Computing},
volume = {203},
pages = {116029},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116029},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014778},
author = {Zhaochen Wang and Gang Min Kim and Hyunjae Kang and Huy Kang Kim and Dan Dongseong Kim},
keywords = {Autonomous driving systems, Cybersecurity, Deep learning, Object detection, Physical adversarial examples},
abstract = {The vulnerability of object detection systems to physical adversarial examples poses an important safety concern for autonomous driving systems. Prior physical attacks built on Expectation Over Transformation (EOT) demonstrate feasibility but often generate conspicuous high-frequency perturbations that are easily perceptible to human observers, limiting their practical stealthiness. To address this, we propose the Spatially Robust Physical Adversarial Attack (SRPAA) framework, which jointly minimizes a detection-suppression loss with Total Variation and Laplacian-based smoothness regularizers, producing perturbations that traverse a controllable point on the visual stealth–physical effectiveness frontier: subtle enough for plausible physical deployment, yet structured enough to survive the print-and-recapture pipeline. We formalize the disappearance criterion into two failure modes (FM1: no surviving detection; FM2: surviving non-target detections) and evaluate SRPAA on a multi-camera, multi-detector benchmark with three smartphones and six detectors, including YOLOv5/v8/11, Faster R-CNN, Cascade R-CNN, and RetinaNet. SRPAA achieves Peak Signal-to-Noise Ratio (PSNR) of 25–32 dB and Learned Perceptual Image Patch Similarity (LPIPS) of 0.11–0.14, substantially better perceptual quality than ShapeShifter (≈6.5 dB and ≈0.55), while remaining robust across viewing angles, smartphone cameras, and ambient lighting. It retains cross-variant transferability within the YOLO family, reaching 88.89% Attack Success Rate (ASR) from a single optimization run. XAI analysis with Grad-CAM, LIME, and SHAP additionally reveals an asymmetric transferability pattern: perturbations optimized for the most robust detector (YOLO11) also fool the simpler YOLOv5, but not vice versa.}
}
@article{CHEN2026116102,
title = {Sunlight-tracking lunar polar rover path planning using deep reinforcement learning under Chang’E-7 mission constraints},
journal = {Applied Soft Computing},
volume = {203},
pages = {116102},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116102},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015504},
author = {Yang Chen and Guangfei Wei and Hao Zhang and Jianfeng Lu},
keywords = {Deep Reinforcement Learning, Online Inference Sunlight-Tracking Path Planning, Continuous Illumination Zones, Lunar Polar Region Exploration},
abstract = {This paper presents a simulation-based sunlight-tracking deep reinforcement learning (ST-DRL) framework for lunar polar rover path planning under Chang’E-7 mission constraints. The proposed framework integrates dynamic illumination maps, a Rover Navigation Control Model (RNCM) for reward shaping, and a DQN-based policy that learns to maintain continuous illumination exposure (≥ 72 h) while satisfying terrain slope constraints. Experiments were conducted in a 1.3 km × 1.3 km lunar south polar region using hourly solar visibility data. Results demonstrate effective outbound and return traversal performance while reducing prolonged dark-region exposure and maintaining computationally efficient online inference. Additional ablation and comparative experiments highlight the importance of the learning-based strategy and its competitive performance relative to heuristic spatiotemporal planning approaches. The proposed framework provides a proof-of-concept for energy-aware DRL path planning under extreme polar illumination condition.}
}
@article{TEWOLDE2026115900,
title = {Preservative pixel-to-joint regression network for 3D hand pose estimation},
journal = {Applied Soft Computing},
volume = {203},
pages = {115900},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115900},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013487},
author = {Tekie Tsegay Tewolde and Ali Asghar Manjotho and Zhendong Niu},
keywords = {3D hand pose estimation, Human-computer interaction, Multiscale vision transformer, Virtual reality},
abstract = {Detection-based hand pose estimation models often flatten heatmaps or apply non-adaptive post-processing operations to infer 3D hand joint locations. While the former dissolves the learned local spatial information, the latter introduces a gap between training and inference, which makes the model non-adaptive. Additionally, heatmaps are defined using a fixed Gaussian kernel, constraining the models from learning long-range spatial information. To address these challenges, we propose a fully trainable preservative pixel-to-joint regression network for 3D hand pose estimation, which adaptively learns pixel-to-joint offsets while preserving the spatial context. PPTJ-Net comprises a per-pixel weight estimation module, which enables per-pixel full network supervision while preserving spatial information, a spatial regression branch for estimating per-pixel spatial joint location, and a depth regression branch responsible for per-pixel depth locations regression. To improve generalization capacity, we introduce a synthetic hand image generator and generate large-scale synthetic images with various hand poses, shapes, sizes, and viewpoints. While our experimental results on the ICVL, NYU, and MSRA datasets show significant improvements in accuracy, the improved extrapolation performance on the HANDS19 Task1 dataset demonstrates the generalization capacity of the proposed method.}
}
@article{SONG2026116126,
title = {Hybrid data- and model-level enhancements for vision transformer-based object detection in remote sensing imagery},
journal = {Applied Soft Computing},
volume = {203},
pages = {116126},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116126},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015747},
author = {Huaxiang Song and Junping Xie and Liang Liang and Yunyang Wang},
keywords = {Object detection, Lightweight vision transformer, Remote sensing feature enhancement, Context-aware fusion, Deep learning in geoscience engineering},
abstract = {Accurate object detection in remote sensing images (RSIs) is crucial for a wide range of engineering applications, from environmental monitoring to disaster response, where high precision is necessary for reliable decision-making. Recent research in RSI object detection has increasingly leveraged Vision Transformer (ViT)-based backbones and feature fusion techniques to enhance global context extraction. However, these methods often struggle with the inherent challenges of RSIs, such as variable imaging conditions and high morphological diversity, leading to inconsistent performance compared to pure convolutional models while incurring high computational overhead. To overcome these limitations, we propose a Feature Enhancement and Structural Simplification Network (FESS-Net) that integrates hybrid data-, model-, and loss-level innovations into the Faster R-CNN architecture. At the data level, FESS-Net introduces two RSI-specific feature enhancement pipelines integrated with custom algorithms: Remote Sensing Optical Enhancement to simulate diverse imaging conditions and Remote Sensing Shape Enhancement to enrich object shape variability. At the model level, it introduces a Lightweight Hybrid ViT-based Backbone and a Lightweight Context-Aware Fusion Module for streamlined feature extraction and fusion, as well as a Center-Aware Loss to enhance spatial alignment during training. Extensive evaluations on three benchmarks—DIOR20, MAR20, and ShipRS50—yield outstanding mAP50 scores of 80.5%, 96.2%, and 76.1%, respectively, significantly outperforming foundational baselines (Faster R-CNN, YOLOv11, and RT-DETR) and 17 advanced variant detectors published in top-tier journals between 2024 and 2026. Furthermore, evaluations on the practical, real-world GLH-Bridge dataset demonstrate superior cross-scene generalizability compared to YOLOv11 and RT-DETR baselines. Although FESS-Net exhibits a higher latency of 20.4 ms (49 FPS) compared to YOLOv11-m, it still comfortably exceeds the standard real-time processing threshold of 30 FPS. Additionally, cross-architecture evaluations using YOLOv11 and RT-DETR substantiate the robust plug-and-play generality of our proposed feature enhancement modules. These results confirm that FESS-Net establishes an optimal trade-off between detection accuracy and efficiency for practical remote sensing applications.}
}
@article{CHEN2026115968,
title = {Semantic behaviour modelling for threat detection in maritime security},
journal = {Applied Soft Computing},
volume = {203},
pages = {115968},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115968},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601416X},
author = {Lulu Chen and Luis Patino and Jonathan Boyle and Thanet Markchom and James Ferryman},
keywords = {Behaviour recognition, Semantic modelling, Maritime security, Novel maritime datasets},
abstract = {This work presents a semantic behaviour analysis framework designed for real-time maritime surveillance applications. The system takes input from object detection and tracking generated by heterogeneous sensors, such as ground-based visual and thermal cameras, high- and low-altitude remote sensors and Automatic Identification System (AIS). A zone-based soft computing approach is employed to detect behaviour events which automatically analyses calculated low-level trajectory data to identify individual and pairwise interactions between objects. These behaviour events are then translated into human-readable semantic descriptions using a domain-informed rule-based model. The proposed framework supports a variety of operational environments across land, sea or combined surveillance areas, with a particular focus on threat event detection near the coastline, including interactions between vessels, people, and vehicles. Extensive evaluation was performed using a selection of datasets including both collected real-world data and generated simulated data that mimic real-world maritime security scenarios near the coast. The results demonstrate the system’s ability to robustly and consistently detect semantically meaningful events across diverse real-time operational deployments and input data sources.}
}
@article{CHEN2026116134,
title = {Distributed multi-sensor data fusion for multi-target tracking in rescue missions},
journal = {Applied Soft Computing},
volume = {203},
pages = {116134},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116134},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015826},
author = {Xiaoming Chen and Jiaji Liu and Dangsheng Ye},
keywords = {Distributed estimation, Data fusion, Multi-target tracking, Multi-sensor, Distributed unscented kalman filter, Rescue missions},
abstract = {This paper deals with the problem of data fusion for Unmanned Aerial Vehicles (UAVs) in rescue missions. Firstly, to deal with the discrepancy in sensor sampling frequencies, we have introduced the cubic spline interpolation method for data alignment. Then an improved DBSCAN clustering algorithm has been combined with the Global Nearest Neighbor (GNN) association algorithm. The temporal information of target observations has been introduced to the clustering algorithm, which mitigates false associations arising from spatial intersections without temporal overlap. The track initiation has been accomplished, the naming rules for target IDs have been unified, and association precision has been enhanced. Furthermore, an innovative Distributed Unscented Kalman Filter (DUKF) algorithm has been combined with the Savitzky-Golay algorithm for data fusion and smoothing. Simulation results show the remarkable performance of the proposed data fusion strategy in distributed estimation, it exhibits heightened tracking accuracy of UAVs in rescue missions.}
}
@article{HAMDI2026116142,
title = {Distributed optimization based on clustering and consensus protocols for large-scale economic dispatch over random network topologies},
journal = {Applied Soft Computing},
volume = {203},
pages = {116142},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116142},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015905},
author = {Mounira Hamdi},
keywords = {Smart Grid, Economic power dispatch, Large-scale optimization, Consensus protocol, Random network topology},
abstract = {This article proposes a new hierarchical distributed optimization framework for large-scale economic power dispatch (EPD) in smart grids, aimed at reducing communication and computational complexity. The global power network is decomposed into interconnected clusters, each coordinated by a cluster head. Within each cluster, a leader–follower consensus mechanism is used to compute generator incremental costs, while a higher-level gossip-based distributed protocol among cluster heads estimates inter-cluster power imbalance. The proposed scheme is validated on the IEEE 118 bus system. Simulation results show that the proposed method significantly improves computational efficiency, achieving reductions of 99.97% and 97.03% in mean computational time compared to fully distributed and partially distributed approaches, respectively, while preserving dispatch accuracy}
}
@article{PARK2026116098,
title = {Class-aware topology-guided graph attention for large-scale skeleton-based firefighter action recognition},
journal = {Applied Soft Computing},
volume = {203},
pages = {116098},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116098},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015462},
author = {Jeongwan Park and Yoonsuk Jang and Minseong Kim and Taeyoung Park and Seongil Jo and Doowon Choi and Jaeoh Kim},
keywords = {Firefighter action recognition, Spatio-temporal graph convolutional networks (ST-GCN), Skeleton-based action recognition, Firefighter training, AI in firefighting},
abstract = {State-of-the-art graph-based action recognition frameworks, such as Spatio-Temporal Graph Convolutional Networks (ST-GCN) and Two-Stream Adaptive Graph Convolutional Networks (2s-AGCN), have advanced skeleton-based spatio-temporal modeling by learning dynamic joint-wise dependencies across frames. Nevertheless, when applied to the high-variability firefighter behavior analysis—where complex tool-body interactions and subtle intent-driven motions coexist—these models often struggle with fine-grained separability across large action classes. To address this, we propose a Class-Aware Topology-Guided Graph Convolutional Network (CATS-GCN). The novelty of our approach lies in a principled framework that integrates (i) anatomical topology constraints, (ii) class-prototype guided attention, and (iii) multi-head sparsity-diversity regularization into a unified learning objective. We evaluated the proposed framework on a large-scale firefighter action dataset comprising 341 action classes and 13,981 samples. Across five runs with random initializations, CATS-GCN achieves a mean Top-1 accuracy of 93.49%, consistently outperforming all baselines. Owing to its modular structure and interpretable attention patterns, the framework offers practical utility for automated training systems by facilitating correct posture maintenance, reducing injury risk, and enhancing operational readiness.}
}
@article{AHMED2026116159,
title = {Robust multi-UAV route optimization via multi-strategy modified ABC},
journal = {Applied Soft Computing},
volume = {203},
pages = {116159},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116159},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016078},
author = {Gamil Ahmed and Tarek Sheltami and Mahmoud S. AbouOmar and Yunes Alqudsi},
keywords = {Unmanned aerial vehicles (UAVs), Path planning, Artificial bee colony (ABC), Heuristic optimization, Energy efficiency},
abstract = {Autonomous path planning is a critical component of unmanned aerial vehicle (UAV) navigation, particularly for last-mile delivery applications in smart cities. This paper presents a robust multi-UAV route optimization framework based on a Multi-strategy Modified Artificial Bee Colony (M2ABC) algorithm designed for complex, low-altitude 3D environments. The proposed M2ABC algorithm integrates an adaptive position update mechanism, noise-induced diversity enhancement, and a globally guided scout phase to overcome premature convergence and improve solution quality in dense obstacle fields. The proposed method ensures collision-free trajectories within constrained 3D operational spaces and achieves superior convergence behavior and path quality in cluttered environments. Simulation results demonstrate that the proposed M2ABC algorithm consistently outperforms conventional ABC, IPSO, ABCPSO, and GA in terms of convergence speed, path quality, energy efficiency, and planning stability. Compared with the conventional ABC algorithm, the proposed approach reduces the average normalized energy consumption by 4.83%, achieves up to 30% energy savings compared with GA, and attains 100% routing success in small-swarm scenarios while maintaining feasible collision-free routes as the swarm size and obstacle density increase. These results demonstrate the effectiveness, robustness, and scalability of the proposed framework for safe multi-UAV navigation in complex 3D environments.}
}
@article{ABDELSALAM2026116070,
title = {EHEVO-L: Enhanced human evolutionary algorithm for robust feature selection and superior comprehensive optimization},
journal = {Applied Soft Computing},
volume = {203},
pages = {116070},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116070},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015188},
author = {Mahmoud Abdel-Salam and Farhad Soleimanian Gharehchopogh and Gang Hu and Shubham Mahajan and Anand Nayyar},
keywords = {Human evolutionary algorithm, Feature selection, Elite opposite-based learning, Non-parametric test, Local escape operator, Classification accuracy},
abstract = {Metaheuristic optimization algorithms (MAs) have emerged as powerful tools for solving complex optimization problems across various domains due to their gradient-free nature and ability to avoid local optima. However, many existing algorithms, including the recently proposed Human Evolutionary Algorithm (HEVO), suffer from limitations such as premature convergence, exploration-exploitation imbalance, and suboptimal solution quality for multi-dimensional and non-convex problems. These limitations have motivated the development of enhanced algorithms that improve convergence speed, solution quality, and robustness. To address these challenges, this research paper introduces “EHEVO-L”, an enhanced version of HEVO that incorporates three key improvement strategies including Elite Opposite-Based Learning (EOBL), Local Escape Operator (LEO), and Target Identification strategies. These enhancements work synergistically to improve population diversity, prevent local optima entrapment, and achieve better exploration-exploitation balance. The motivation for EHEVO-L stems from the need to overcome the inherent shortcomings of traditional MAs in solving complex, high-dimensional problems efficiently. The proposed EHEVO-L algorithm is comprehensively evaluated on two fronts: global optimization using the CEC'17 and CEC'20 benchmark test suites, and practical application to feature selection (FS) using fifteen benchmark datasets. For global optimization, EHEVO-L demonstrates superior performance with Friedman ranks of 3.57 (CEC’17, 50D) and 1.88 (CEC’20, 20D), outperforming various state-of-the-art algorithms. When applied to FS problems using K-Nearest Neighbors (KNN) classification, EHEVO-L achieves classification accuracy ranging from 67.6 % to 96.5 % across all datasets while consistently selecting only a small subset of the available features in each dataset. Statistical analyses including Friedman rank and Wilcoxon tests validate the optimization superiority of EHEVO-L. Moreover, ablation studies confirm that the combination of all three enhancement strategies yields the best performance compared to individual implementations. The results demonstrate that EHEVO-L provides a robust solution for global optimization and feature selection, with enhanced convergence speed, solution quality, and optimization stability compared to traditional metaheuristic algorithms.}
}
@article{ZHANG2026116078,
title = {Rethinking the prior guided vision transformer for industrial anomaly class discovery},
journal = {Applied Soft Computing},
volume = {203},
pages = {116078},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116078},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015267},
author = {Wenchao Zhang and Li Wang and Weichen Li},
keywords = {Generalized category discovery, Anomaly class discovery, Deep clustering, Vision transformer, Dual-mask guided representation learning},
abstract = {Anomaly class discovery is critical for industrial quality inspection, as it supports quality grading, defect-type identification, and failure diagnosis. However, this task remains challenging because anomalous regions usually account for only a small proportion of the image and are therefore easily overwhelmed by normal background regions. Existing methods use anomaly probability maps as priors to constrain class-to-patch attention in Vision Transformer (ViT), encouraging the model to focus on anomalous regions. However, they overlook the fact that background noise can still propagate through patch-to-patch interactions and contaminate anomaly representations. To address this issue, we analyze token information propagation in ViT and reveal how background noise spreads through contextual interactions and corrupts foreground anomaly features. We develop a suppression strategy based on this analysis to mitigate harmful background propagation while preserving informative local context. We then propose PG-ACD, which comprises three modules. A robust anomaly localization module first identifies multiple anomalous regions, generates complete anomalous-region crops, and produces enhanced anomaly priors. These priors are then exploited by a dual-mask guided representation learning module to suppress harmful background propagation and learn discriminative anomaly representations. Based on the resulting region-level predictions, a multi-dimensional weighted image-level inference module aggregates region-level recognition results into a unified image-level identification. Experimental results on the MTD and MVTec AD datasets demonstrate that the proposed method achieves the best overall performance in most settings and metrics. In particular, when integrated with PatchCore, it achieves improvements of 7.6% in F1, 8.8% in NMI, and 7.1% in ARI on the MTD dataset.}
}
@article{ZHOU2026116130,
title = {Adaptive-sparsification federated unlearning with privacy-preserving},
journal = {Applied Soft Computing},
volume = {203},
pages = {116130},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116130},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015784},
author = {Yujie Zhou and Linfen Zhang and Tengfei Wang and Siguang Chen and Xue Li},
keywords = {Federated learning, Federated unlearning, Privacy-preserving, Compressive sensing, Sparsity},
abstract = {Federated unlearning (FU) enables the removal of specific client contributions from a trained federated model, thereby supporting the right to be forgotten in privacy-sensitive applications. However, in practical federated learning systems, FU faces three coupled challenges: gradient leakage during transmission and aggregation, performance degradation caused by severe data heterogeneity under non-independent and identically distributed (Non-IID) settings, and high communication overhead. To address these issues, we propose an adaptive-sparsification FU framework with privacy-preserving. Specifically, we design a privacy-oriented adaptive sparsification strategy that adjusts the retained gradient ratio according to the alignment between local update directions and the global optimization direction, thereby balancing utility preservation, unlearning effectiveness, and communication efficiency under heterogeneous data distributions. The sparsified gradients are further compressed via compressive sensing, which reduces transmission cost and acts as an encryption-like protection mechanism against gradient inversion attacks. In addition, we develop a dual-stage aggregation scheme across edge and cloud servers, which enhances privacy protection by enlarging the effective batch size and obscuring the origin of individual client updates. Extensive experiments on two datasets demonstrate that the proposed method effectively defends against gradient inversion attacks, preserves competitive model utility and unlearning performance under Non-IID settings, and reduces the theoretical client-to-edge communication payload by approximately 44.95% relative to dense transmission.}
}
@article{YANG2026116041,
title = {An efficient graph-driven information fusion approach using dominance rectangular-granular rough set for multi-source ordered decision information systems},
journal = {Applied Soft Computing},
volume = {203},
pages = {116041},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116041},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014894},
author = {Zishuo Yang and Guangming Xue and Weihua Xu},
keywords = {Graph-driven information fusion, Dominance-rectangular neighborhood, Rough set, Multi-source information systems},
abstract = {With the increasing size and complexity of data, information fusion has emerged as an effective approach to retain valid information in multi-source decision information systems. This study proposes a novel information fusion method for multi-source ordered decision information systems. The method significantly reduces the computational cost of rough sets through the use of rectangular rough sets. Compared with existing information fusion algorithms which focus on the traditional neighborhood rough set, this paper addresses the gap in how to represent distance relationships between samples without requiring large computational resources for distance calculation. The novelty of this method, mainly includes the following: i) This algorithm implicitly stores the distance relationships between samples by constructing a binary tree instead of using the traditional neighborhood rough set which requires calculating the distance between a sample and all other samples, thereby consuming substantial computational resources. ii) By using graph theory, the uncertainty of attributes can be stored, and this algorithm can represent the superiority relationship between attributes through the convergence of the infinite series of the graph matrix. Finally, the effectiveness and efficiency of the proposed method are validated through comparisons with seven other methods, including three common methods (Min, Mean, Max), on 12 datasets. The results demonstrate that the proposed method achieves substantial improvements in both effectiveness and efficiency.}
}
@article{ZHU2026116086,
title = {Spatial-channel feature fusion transformer for multimodal tumor delineation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116086},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116086},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015346},
author = {Ziwei Zhu and Yawen Huang and Yuexiang Li and Se-in Jang and Yefeng Zheng and Cheng Lu},
keywords = {Structure-aware, Spatial-channel, Feature fusion, Transformer, Multimodal tumor segmentation},
abstract = {Automated multimodal tumor delineation often yields false-positive regions and unstable boundaries, limiting trust for radiotherapy planning and longitudinal assessment. We propose Feature Fusion Transformer (F3ormer), a dual-branch 3D Transformer encoder–decoder that decouples spatial-wise context modeling from channel-wise modality/phase interaction and integrates them through structure-aware fusion. A spatial information fusion module (SIFM) injects local structural cues into channel-focused blocks to preserve boundary continuity and suppress unsupported foreground activations. We evaluate F3ormer under a unified nnU-Net training protocol on three fixed, never-seen test settings: autoPET 2022/2023 (1014 FDG-PET/CT exams; 800/214 train/test), BraTS 2021 (1251 multiparametric MRI cases; 1000/251 train/test), and a real-world GDPH head-and-neck dual-phase CT cohort (1309 cases; 1000/309 train/test). Case-level bootstrap confidence intervals and paired Wilcoxon signed-rank tests are added to quantify uncertainty. On autoPET, F3ormer achieves Dice of 79.89% (PET-only) and 81.86% (PET + CT), with markedly reduced false-positive volume in the PET + CT setting (0.3940 mL). On BraTS 2021, it improves Dice for NCR/ED/ET (78.84%/87.28%/86.22%) and lowers mean surface distance. On GDPH dual-phase CT, F3ormer achieves the best Dice (78.91%) and the lowest FPV/FNV among compared backbones. These results indicate that explicit spatial–channel decoupling with structure-aware fusion improves reproducible 3D tumor delineation across heterogeneous multimodal imaging settings.}
}
@article{NEZERKA2026116138,
title = {Fully automated AI-based bitumen adhesion assessment using U-Net model trained on synthetic data},
journal = {Applied Soft Computing},
volume = {203},
pages = {116138},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116138},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015863},
author = {Václav Nežerka and Jakub Houlík},
keywords = {Asphalt concrete, Segmentation, Rolling bottle test, Stripping, Deep learning, Synthetic data},
abstract = {Bitumen-aggregate adhesion is a primary determinant of the moisture resistance and durability of asphalt pavements, yet it is still quantified by subjective visual grading, which yields only coarse ordinal categories and varies with the operator. Supervised deep learning can replace it with a continuous, reproducible measurement, but has been constrained by the cost of pixel-level annotation, which requires minutes to hours per photograph. We eliminate this bottleneck by generating the training data synthetically: from 63 manually segmented quarry samples spanning diverse mineralogies, a controlled pipeline composes an effectively unlimited set of pixel-accurate labelled scenes. A U-Net with a ResNet-50 encoder is trained for three-class segmentation (background, bitumen-coated aggregate, stripped aggregate) on these scenes combined with a limited set of manually annotated real photographs. The model attains a mean IoU of 0.83 and a mean Dice of 0.90 on 700 synthetic hold-out images. Preliminary pixel-level validation on 9 previously unseen real photographs yields a mean IoU of 0.76 and a mean Dice of 0.83, with predicted cover on average 1.1 percentage points below manual annotation and estimated 95% limits of agreement from −5.1 to +3.0 points. A separate analysis of 250 synthetic and 147 unique unannotated real photographs returns a domain-classification AUC of 0.998, indicating a substantial residual distribution shift; matched-update ablations show, however, that this shift is dominated by recoverable low-level acquisition differences and that synthetic data support transfer and reduce cover error when combined with real images.}
}
@article{CAO2026116155,
title = {Online surface defect detection of steel rails using a multi-module optimized YOLO framework},
journal = {Applied Soft Computing},
volume = {203},
pages = {116155},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116155},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016030},
author = {Xiangyu Cao and Xin Yang and Shun Wang and Ke Xu and Hualing Zhu and Jianpeng Jiao},
keywords = {Surface defect, Steel rail, Object detection, Attention mechanism, Loss function optimization},
abstract = {Aiming at the industrial challenges in rail surface defect detection, such as online requirements, high missed detection rate of small targets, low distinguishability of defect features, and unbalanced sample distribution, this paper proposes a multi-module collaborative optimization real-time detection method based on the lightweight YOLOv11. Firstly, a C3k2-Sobel feature extraction module is designed, which integrates Sobel gradient prior information into convolution operations to effectively enhance the model's ability to perceive and extract defect edge features. Following this, a novel patch-level convolutional block attention mechanism is proposed innovatively to address the bottleneck of small target detection. By focusing on tiny defect regions through a block pooling strategy, it significantly suppresses background noise interference and thereby reduces the missed detection rate of small targets. In the final stage, to optimize the model training process, a dynamically weighted Focal Loss function is customized to specifically solve the dual imbalance problems of positive/negative samples and easy/hard samples in the dataset. Experimental validation was performed on a dataset comprising 1062 field-collected surface images of steel rails, capturing five representative defect categories under actual operational conditions. The proposed method demonstrates superior detection performance: it achieves a 13.3 %age-point improvement in mAP50 over the baseline YOLOv11 and obtains 57.3% Precision, 61.1% Recall, and 60.5% mAP50. Among the compared detectors, it achieves the highest Recall and mAP50 while maintaining a real-time inference speed of 38 FPS. In addition to offline testing, the proposed system was evaluated for six months on an actual steel rail production line before the rails were laid or put into service. The production-line results show an overall defect detection rate of 85.3% in terms of recall while maintaining real-time inference capability. These results demonstrate that the proposed framework provides an effective, real-time, and industrially applicable solution for online steel rail surface defect screening, with the potential to reduce missed detections and support manual re-inspection under production-line conditions.}
}
@article{SU2026116179,
title = {Virtual try-on algorithm integrating multi-view user perspectives with multi-level sampling warping module (M-LSWM)},
journal = {Applied Soft Computing},
volume = {203},
pages = {116179},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116179},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016273},
author = {Xueping Su and Hengyuan Zhang and Yunhong Li and Xiang Chen},
keywords = {Virtual try-on (VTON), Multi-view, Multi-level sampling warping module, BoTNet, Image alignment},
abstract = {Virtual try-on technology holds significant application value in e-commerce and the fashion industry. By achieving precise fitting through digital overlay, it can enhance the shopping experience and transform the way consumers interact. However, existing methods generally suffer from issues such as detail loss, texture distortion, and poor pose adaptability, resulting in generated effects that deviate from the real try-on experience. Therefore, this paper proposes a virtual try-on algorithm that integrates multi-view user inputs with M-LSWM. First, a multi-branch residual fusion network (MB-RFN) constructs a multi-view input model for users, enabling feature transformation and spatial alignment from single-view to multi-view. Next, a multi-level sampling warping module (M-LSWM) is designed to warp clothing images, achieving precise matching between clothing and user images while preserving important details such as fine textures and edges. Finally, a BoTNet network generator extracts local features like edges and textures, producing high-quality virtual try-on images. Experimental results on the DressCode, VITON-HD, and MVG datasets demonstrate that this algorithm outperforms other methods in terms of generated image quality and realism.}
}
@article{YUANYUAN2026116032,
title = {A spatiotemporal fusion deep learning framework for solving nonlinear partial differential equations coupled with puncture in flexible materials},
journal = {Applied Soft Computing},
volume = {203},
pages = {116032},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116032},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014808},
author = {Gao Yuanyuan and Li Duanling and Cai Jiahui and Chen Qiuxuan},
keywords = {Mechanical analysis, Graph neural networks, Hyperviscoelastic tissue, Finite element analysis, Neural tangent kernel},
abstract = {To address multiscale puncture mechanics in heterogeneous, hyperviscoelastic biological tissues, we construct a spatiotemporal (ST) decoupled graph network architecture-M2_STGPH based on physics-informed paradigm and variational principles. By imposing explicit constraints on Rademacher complexity of function spaces using Neural Tangent Kernel, we develop a nonlinear partial differential equation system that governs time-varying solutions of high-dimensional equations and robust coupling between flexible needles and mechanical responses of soft tissues. Firstly, in the reconstruction and prediction of physical constraint field of continuum mechanics, a local meshless model is constructed by combining the material constitutive law. Dual-region division balances virtual work, while tight-support radial kernel functions construct local shape functions. Subsequently, a probabilistic node aggregation algorithm is proposed to construct a dynamic topological structure consisting of a full family of parent–child clusters(FAS), thus updating information transmission pathways. Since parent nodes contain the physical information of adjacent child nodes, adjacent sampling is decoupled from shape function computation. The topological structure calculates the kernel weight of each child node relative to its parent node and uses the chain rule and quotient rule to perform analytical differentiation on the normalized formula after interpolation. Finally, we investigate error correction problem for the needle-tissue coupled inverse kinematics model with known initial configurations by introducing a momentum term and an adaptive learning rate mechanism to balance its first-order convergence properties. Physical constraints based on needle bending morphology and material constitutive behavior are embedded within configuration space. This approach enables Jacobian-free, high-precision (10−3mm) tissue puncture prediction with robust initialization.}
}
@article{BUNTERNGCHIT2026116141,
title = {Spatio-temporal feature fusion with cross-frequency coupling for interpretable Parkinson’s detection using EEG},
journal = {Applied Soft Computing},
volume = {203},
pages = {116141},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116141},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015899},
author = {Chayut Bunterngchit and Sidi Mohamed {Sid’El Moctar} and Laith H. Baniata and Saba Aslam and Abdur Rasool},
keywords = {Parkinson’s disease, EEG, Spatio-temporal feature fusion, Cross-frequency coupling, Graph neural network, Transformer, Interpretability},
abstract = {Parkinson’s disease (PD) is a progressive neurodegenerative disorder that presents significant diagnostic challenges, particularly in its early stages, due to symptom variability and overlap with other conditions. While deep learning (DL) approaches using electroencephalography (EEG) data have shown promise, many existing models lack biological interpretability and generalization, limiting their clinical utility. This study proposes a biologically informed neural fusion model (Bio-NFM) for PD detection, integrating multiple neurophysiological biomarkers into a DL framework. Key features include beta-band coherence, fractal dimension, phase-amplitude coupling, and entropy-based measures, which are biomarkers known to reflect disrupted connectivity, reduced complexity, and abnormal synchronization in PD-affected brain regions. These features are processed through a spatio-temporal feature fusion architecture combining graph neural networks for spatial modeling, transformers for temporal dynamics, reservoir computing for nonlinear variability, cross-frequency coupling for biomarker integration, and a custom loss function that regularizes biologically meaningful patterns. The model achieved an accuracy of 98.9% on the primary dataset and over 98% on two external EEG datasets. Leave-one-out validation confirmed robust generalization, while ablation studies highlighted the contribution of each module and biomarker. By integrating domain-relevant biomarkers into a high-performing and interpretable architecture, Bio-NFM offers a clinically viable solution for early-stage PD detection. Its design supports reproducibility, transparency, and real-time EEG deployment, enhancing its applicability in both clinical and resource-constrained settings.}
}
@article{AMADIAZ2026116162,
title = {Graph attention and temporal modeling for multi-level classification of Parkinson’s disease type and stage from longitudinal multimodal clinical and gait data},
journal = {Applied Soft Computing},
volume = {203},
pages = {116162},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116162},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016108},
author = {Youness Amadiaz and Lahcen Tamym and Edgar Alfonso-Lizarazo and Ahmed {Nait Sidi Moh}},
keywords = {Parkinson’s disease, Multimodal clinical data, Node2vec embeddings, Graph attention network, Bidirectional LSTM, Hoehn & Yahr staging},
abstract = {Parkinson’s disease (PD) is a heterogeneous neurodegenerative disorder in which clinical subtype and motor severity evolve jointly over time. Most existing machine learning (ML) models either perform binary diagnosis (PD vs. non-PD) or single-level severity staging, and rarely exploit the multimodal and longitudinal structure of clinical data. To address this gap, this study proposes a Hierarchical Graph Attention Network with Temporal Modeling (HGAT-TM) for joint prediction of patient type and Hoehn & Yahr (H&Y) stage from demographic, clinical and gait assessments. Variables are organized into four modalities (demographic, motor, non-motor, gait) and encoded with modality-specific neural encoders. A multimodal attention mechanism merges these embeddings into visit-wise patient representations. For each visit (BL/6m/12m/24m: Baseline/6/12/24month follow-ups), a visit-specific k-nearest-neighbor patient graph is constructed, learns Node2vec structural embeddings, and concatenates them with attribute features before processing with a Graph Attention Network (GAT). The sequence of GAT embeddings across available visits is then modeled with a bidirectional long short term memory (BiLSTM) to capture longitudinal trajectories. A hierarchical, label-aware head first classifies patient type (Healthy control, Patient with PD, SWEDD (Scans Without Evidence of Dopaminergic Deficit)) and then classifies the H&Y stage based on the inferred type. The HGAT-TM model outperforms classical ML baselines and alternative graph-based models at all visits: at baseline it achieves 81.67% accuracy and 57.51% F1-score for type classification, and 87.63% accuracy and 44.77% F1-score for stage prediction, while maintaining high specificity under class imbalance. Attention-based visualizations over modalities and patient-patient relations provide an interpretable framework for multi-level PD classification.}
}
@article{DING2026116125,
title = {Temperature prediction of lithium-ion batteries based on physics-informed neural network, gated recurrent unit and transformer},
journal = {Applied Soft Computing},
volume = {203},
pages = {116125},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116125},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015735},
author = {Xiaofeng Ding and Dongshi Xu and Fuqiang Zhao and Jian Guo and Qingxue Huang},
keywords = {Lithium-ion batteries, Temperature prediction, Physics-informed neural network, Gated recurrent unit, Transformer},
abstract = {As a core component of electric vehicles, the temperature state of lithium-ion batteries directly affects the driving range, safety, and economy of the vehicle. To accurately predict the temperature of lithium-ion batteries, a new model that combines the physics-informed neural network (PINN), gated recurrent unit (GRU), and transformer is proposed. First, a multi-factor dataset is constructed and preprocessed. The K-Means algorithm is then employed for seasonal division to enhance the adaptability of the model. Next, the lumped capacitance thermal model is embedded into the PINN. The characteristics of short-term temperature fluctuations are captured by the GRU, while the global dependencies of long sequences are handled by the transformer. This forms a multi-branch network architecture. Finally, key hyperparameters are optimized via the controlled variable method, and comparative experiments are conducted with traditional and hybrid models. The results indicate that the optimized PINN-GRU + Transformer model exhibits significant advantages in prediction accuracy and generalization ability, with its mean absolute error (MAE) reduced to 0.1045 ∘C. Moreover, it maintains stable predictive performance across different seasons, providing reliable theoretical and technical support for battery thermal management.}
}
@article{LI2026115996,
title = {A frequency and boundary-aware detection transformer for small object detection in UAV imagery},
journal = {Applied Soft Computing},
volume = {203},
pages = {115996},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115996},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014444},
author = {Honggang Li and Dalian Yang and Yang Zhang and Lisheng Xiang and Yongzheng Jiang},
keywords = {UAV object detection, Small object detection, Detection transformer, Frequency-domain modeling, Boundary awareness},
abstract = {To address the limited detection accuracy of existing methods in UAV-based aerial ground-object detection, this paper proposes the Frequency and Boundary-Aware Detection Transformer (FBAD-DETR), a small-object detection model based on frequency-domain modeling and boundary-aware feature representation. Built upon the RT-DETR framework, FBAD-DETR introduces three main improvements: (1) a Frequency-Dynamic Enhancement Backbone (FDEB) is constructed by integrating frequency-domain modeling with a channel sparsity mechanism to enhance fine-grained small-object feature extraction; (2) a Boundary-Semantic Recalibrated Feature Pyramid Network (BSRFPN) is designed to selectively reconstruct and fuse shallow boundary cues and deep semantic features, improving small-object perception; and (3) an Inner Matching-Point Distance Intersection over Union loss function (Inner-MPDIoU) is proposed by combining inner-region matching awareness with spatial corner constraints to improve multi-scale localization accuracy. Experimental results show that FBAD-DETR achieves 51.2% mAP@0.5 and 32.2% mAP@0.5:0.95 on the VisDrone2019-DET dataset, outperforming the RT-DETR-r18 baseline by 3.9% and 3.0%, respectively. APs and APm are also improved by 3.0% and 2.5%, while the number of parameters and model size are reduced by 36.7% and 36.1%, respectively. On the CODrone dataset, FBAD-DETR improves mAP@0.5 and APs by 4.1% and 1.5% over the baseline. Comprehensive experiments, including onboard deployment validation, indicate that FBAD-DETR achieves high detection accuracy and robustness in UAV aerial ground-object detection scenarios. The onboard deployment reaches 18.4 FPS, showing basic real-time capability.}
}
@article{CHI2026116149,
title = {SCIL-Net: Semi-supervised contrastive incremental learning for continuous industrial fault diagnosis},
journal = {Applied Soft Computing},
volume = {203},
pages = {116149},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116149},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015978},
author = {Xuezhi Chi and Ran Lu and Hehong Cui},
keywords = {Industrial fault diagnosis, SCIL-Net, Semi-supervised learning, Contrastive feature learning, Incremental learning},
abstract = {In practical applications, industrial fault diagnosis often faces challenges such as insufficient labeled data, dynamic increases in fault categories, and limited ability of models to retain historical knowledge. Current approaches frequently struggle in these scenarios, particularly regarding the propagation of errors when pseudo-labels are unreliable under environmental noise, and the persistent difficulty of balancing long-term knowledge retention with computational efficiency in incremental settings. To address these problems, this paper proposes a semi-supervised contrastive incremental learning network named SCIL-Net, which is designed to achieve high-precision fault recognition and continuous learning of new categories under low-label conditions. The model adopts ConvNeXt-V2 as the backbone for feature extraction, and enhances the utilization of unlabeled samples and the discriminability of feature representation by integrating an adaptive threshold pseudo-label strategy with the SimCSE contrastive learning mechanism. Furthermore, to overcome the limitations of conventional incremental strategies, it combines an adaptive category expansion method and a meta-memory replay mechanism to improve the model’s adaptability to new categories and alleviate catastrophic forgetting. Experimental results on two public datasets (CWRU and Paderborn University) show that SCIL-Net achieves an overall accuracy of 94.26% and 90.34% respectively, with macro-averaged F1-scores of 93.58% and 89.22%. These results outperform those of existing comparison methods. Further ablation analysis, tests under different label ratios, and noise resistance experiments verify the effectiveness of each component module, as well as the model’s robustness and generalization ability in scenarios with low label rates, complex working conditions, and dynamically evolving faults. The research results indicate that SCIL-Net can achieve a good balance between diagnostic accuracy, incremental learning capability, and practical application feasibility.}
}
@article{JIA2026116133,
title = {Long-term traffic flow forecasting model based on windowed attention mechanism},
journal = {Applied Soft Computing},
volume = {203},
pages = {116133},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116133},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015814},
author = {Chaolong Jia and Haodong Lv and Zheyi Kang and Fu Jiang and Zhengjun Zhou and Rong Wang and Yunpeng Xiao},
keywords = {Traffic flow forecasting, Long-term prediction, Attention module, Spatiotemporal correlation, Graph attention networks},
abstract = {Traffic flow forecasting is a fundamental task in intelligent transportation systems and supports efficient urban traffic management. To address long-term traffic flow forecasting, this study proposes LT-WAM, a long-term traffic flow forecasting model based on the Windowed Attention Mechanism. First, to tackle the challenge of long-term dependency modeling, the model employs a multi-resolution pyramidal attention mechanism to capture long-range temporal patterns. Using layer-wise convolutions and attention operations, the model captures short-term fluctuations and long-term trends simultaneously and represents nonlinear relationships across time steps at multiple scales. Second, to address spatial heterogeneity, the model leverages a Graph Attention Network (GAT) to perform deep feature fusion of local and global spatial relationships. This mechanism not only captures the direct influence of adjacent road segments but also models the global spatial dependencies across the traffic network. Finally, to account for dynamic variations in traffic states, the model employs a windowed attention mechanism to adaptively adjust the attention window. This mechanism captures dynamic spatiotemporal correlations, allowing the model to better reflect traffic variations and improve long-term forecasting accuracy. Experimental results demonstrate that the attention-based LT-WAM model effectively integrates temporal sequences and spatial structures. It outperforms baseline methods in long-term traffic flow prediction, achieving mean MAE, RMSE, and MAPE values of 220.42, 407.32, and 36.38% on PeMSD4, and 16.48, 26.43, and 11.21% on PeMSD8, respectively, showing high predictive accuracy and robustness.}
}
@article{LU2026116136,
title = {Cross-lingual speech emotion recognition via multi-ethnic wavelet-based data augmentation and feature decoupling},
journal = {Applied Soft Computing},
volume = {203},
pages = {116136},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116136},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601584X},
author = {Faming Lu and Yi Liu and Zedong Lin and YunXia Bao and Cong Liu},
keywords = {Speech emotion recognition, Decoupled representation learning, Cross-linguistic processing, Wavelet packet transform, Data augmentation},
abstract = {Cross-lingual Speech Emotion Recognition (SER) aims to enable models to recognize emotional expressions in speech across different languages. It is an important research direction for intelligent human-machine interaction. However, this task faces two major challenges: acoustic feature distribution shifts caused by linguistic and cultural differences, and the scarcity of labeled data in cross-lingual scenarios. These challenges severely restrict the model’s generalization ability. To address these issues, this paper proposes an innovative framework for cross-lingual speech emotion recognition. First, to mitigate the scarcity of labeled data and enhance the model’s robustness to different acoustic variations, a multi-ethnic wavelet packet transform data augmentation strategy is proposed. This strategy decomposes the speech signal from multiple perspectives using different wavelet basis functions. In addition to expanding the data, it significantly enhances the diversity and discriminative power of time-frequency features. Second, to effectively handle feature distribution shifts caused by language differences and decouple confounding acoustic information to extract language-invariant emotional representations, a unified framework combining feature decoupling and contrastive learning is designed. This framework uses a public-private encoder structure to decouple shared emotional features from language-specific private features. Mutual information loss functions are employed for explicit constraints, thus improving the model’s ability to capture stable emotions across languages. Experiments are conducted on IEMOCAP and DEMOS datasets, and systematic testing is performed on three independent language datasets: EmoDB, EMOVO, and SAVEE. On EmoDB, the proposed SPFD framework achieves a best accuracy of 78.76% and a macro F1 of 70.64%, representing absolute gains of over 23 and 29 percentage points over the non-SPFD baseline, with consistent double-digit improvements in UAR and macro F1 across all target languages and backbone architectures. These results validate the superior generalization performance of the method in cross-lingual scenarios.}
}
@article{ZHANG2026116121,
title = {High-dimensional data attribute reduction: A multi-granularity phased joint approach with a quantum-inspired genetic algorithm},
journal = {Applied Soft Computing},
volume = {203},
pages = {116121},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116121},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015693},
author = {Xiaoxia Zhang and Xi He and Jiangtao Zhang},
keywords = {Rough set theory, Joint binary relationship, Fast attribute reduction, Parallel computing, Quantum-inspired genetic algorithm},
abstract = {Granular computing, as an emerging method, simulates human cognitive processes to address complex problems and has gradually become a core theory for solving uncertainty issues. Its fundamental concept revolves around utilizing hierarchical structures, classification, and clustering techniques to process and manage uncertain information. However, the applicability of granular computing remains limited when faced with complex problems and high dimensional data. Different types of problems require different theoretical frameworks to enhance the adaptability of granular computing. To address this, we propose a multi-granularity phased attribute reduction approach using joint binary relations. Specifically, the method adaptively granulates the sample space according to individual feature characteristics, and uses conditional entropy to perform partitioning operations to filter redundant features. This efficiently forms a reduced feature set while ensuring high accuracy. Ultimately, a quantum-inspired genetic algorithm (QIGA) is employed to perform a rapid search, realizing feature-level joint optimization and dynamic alignment to pinpoint the optimal subset. The entire methodology is accelerated using a GPU-based parallel computing framework. Experiments on 18 datasets, compared with 6 state-of-the-art algorithms, fully validate the method’s effectiveness. This study provides a new perspective for integrating granular computing with adaptive swarm intelligence in high-dimensional data analysis.}
}
@article{LYU2026116053,
title = {A direction-consistent environmental selection strategy for many-objective optimization},
journal = {Applied Soft Computing},
volume = {203},
pages = {116053},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116053},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015012},
author = {Jingze Lyu and Wenhai Wang and Shanqing Wang and Peiyu Liu and Xiao-Yu Tang and Yinan Zhang},
keywords = {Many-objective optimization, Evolutionary algorithm, Environmental selection, Reference direction, Directional consistency},
abstract = {As objective dimensionality increases, reference-direction-based environmental selection becomes increasingly affected by ambiguous direction assignment, weakened direction-local discrimination, and imbalanced survivor allocation. These coupled difficulties reveal an association–ranking–allocation inconsistency that weakens selection pressure and disrupts the structure of the obtained solution set. To address this issue, this paper proposes Directional Adaptive Ranking and Matching (DARM), a direction-consistent environmental selection framework built on NSGA-III. Rather than refining one selection operator, DARM reorganizes environmental selection into a coordinated process that links compact directional screening, direction-local adaptive ranking, and rank-layered survivor allocation. Directional random-signature screening constructs angular candidate sets to improve association reliability, adaptive local ranking enhances discrimination within direction-consistent neighborhoods, and rank-layered allocation maintains cross-direction balance during selection. Experiments on DTLZ, IDTLZ, MaF, WFG, and real-world MaOPs demonstrate that NSGA-III-DARM achieves competitive performance in convergence quality, dominated-volume coverage, distribution uniformity, and search stability while maintaining near-baseline computational cost. Results under increasing objective dimensionality confirm its scalable behavior across structured and heterogeneous PF landscapes, while qualitative comparisons, parameter sensitivity, and component ablation verify the effectiveness and robustness of the coordinated selection design. These findings show DARM improves environmental selection by restoring consistency among association, ranking, and allocation under shared directional semantics, rather than by relying on isolated screening, ranking, or allocation.}
}
@article{ZHOU2026116166,
title = {The MI-Motion dataset and benchmark for 3D multi-person motion prediction},
journal = {Applied Soft Computing},
volume = {203},
pages = {116166},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116166},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016145},
author = {Xiao Zhou and Xiaogang Peng and Yikai Luo and Zizhao Wu and Xiaoling Gu and Ping Yang and Xuesong Yin},
keywords = {Multi-person motion prediction, Motion dataset, Social temporal GCN},
abstract = {3D multi-person motion prediction is a challenging task that requires modeling both individual dynamics and complex inter-person interactions. Despite recent progress, fair comparison among existing methods remains difficult due to the lack of standardized training protocols and benchmark datasets. In this paper, we introduce the Multi-Person Interaction Motion (MI-Motion) dataset, a mid-scale benchmark comprising multi-person skeletal motion sequences. The dataset is constructed from motion capture data and motion asset repositories, followed by a refinement and synthesis pipeline implemented in a game engine to ensure realism and diversity. MI-Motion contains 167k frames of interacting human poses across five diverse activity scenarios. To support systematic evaluation, we establish a comprehensive benchmark with three prediction settings: short-term, long-term, and ultra-long-term forecasting. Furthermore, we provide a simple yet effective baseline based on graph and temporal convolutional networks, which achieves competitive performance on multi-person motion prediction tasks. We expect that MI-Motion, along with the proposed benchmarks and baselines, will promote more consistent evaluation and advance research toward realistic modeling of multi-person interactions. The dataset and benchmark are publicly available at: https://mi-motion.github.io/.}
}
@article{LIU2026116077,
title = {MambaCNN: A hybrid Mamba-convolution vision backbone},
journal = {Applied Soft Computing},
volume = {203},
pages = {116077},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116077},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015255},
author = {Kunhua Liu and Tao Lu and Yuting Xie and Chenggang Dai and Chengjun Chen},
keywords = {Vision-based Environmental Perception, Image Classification, Object Detection, Semantic Segmentation},
abstract = {Deep learning methods based on Convolutional Neural Networks (CNNs) and Vision Transformers (ViTs) have made significant progress in computer vision and are widely used in robotics, autonomous driving, and smart-home systems. However, CNN-based approaches are constrained by local receptive fields, whereas ViT-based approaches incur high computational and memory costs, particularly at high resolutions. To address these limitations, we present MambaCNN, a hybrid vision backbone that combines convolution with a state-space model (Mamba) for efficient global–local modeling. The MambaCNN consists of two modules: a Conv2D module for low-level feature extraction, and a MambaConv module that adapts Mamba to 2D feature maps and fuses long-range dependencies with CNN features through a lightweight gated mixer. Furthermore, we provide Tiny, Small, and Base variants in a hierarchical layout to suit different compute budgets and accuracy targets. To validate the effectiveness of MambaCNN, we conducted extensive experiments on ImageNet-1K classification, MS COCO detection and instance segmentation, and ADE20K semantic segmentation. The experimental results show that MambaCNN improves accuracy under comparable or lower FLOPs and parameters with strong throughput, achieving state-of-the-art (SOTA) performance under comparable computational budgets across all evaluated tasks.}
}
@article{GARCIAORDAS2026116129,
title = {Explainable depression prediction using SHAP and large language models to extract features from text transcriptions},
journal = {Applied Soft Computing},
volume = {203},
pages = {116129},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116129},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015772},
author = {María Teresa García-Ordás and Sergio Rubio-Martín and Alicia Merayo and Arturo Crespo-Álvaro and Oscar García-Olalla and Isaías García-Rodríguez},
keywords = {Depression, Explainable AI, Large language models, SHAP, Feature extraction, Natural language processing, PHQ-8},
abstract = {Depression affects over 280 million people worldwide, yet early detection remains challenging due to limited access to mental health services and the subjective nature of traditional assessment methods. Automated systems that can accurately and transparently assess depression from natural language could significantly improve early intervention and treatment outcomes. However, existing approaches using traditional natural language processing techniques (e.g., TF-IDF, Word2Vec) produce opaque feature representations that lack clinical interpretability, limiting their adoption in healthcare settings. This paper introduces a novel two-stage framework for depression prediction that leverages large language models (LLMs) to automatically generate interpretable, clinically relevant features from interview transcripts. The framework first employs few-shot prompting to generate a set of clinically grounded questions aligned with PHQ-8 diagnostic criteria, then uses the same LLMs to extract numerical features by answering these questions for each transcript. We evaluated three state-of-the-art LLMs (GPT-4o-mini, Claude-3.5-haiku, Gemini-Flash-1.5-8B) and five regression models on the E-DAIC dataset. Our results demonstrate that the proposed LLM-based feature extraction significantly outperforms traditional methods, with GPT-4o-mini achieving the best performance: RMSE of 4.19, MAE of 3.20, and R2 of 0.50 when combined with Ridge regression, representing improvements of up to 30% over TF-IDF and Word2Vec baselines. Furthermore, SHAP (SHapley Additive exPlanations) analysis revealed that features related to guilt and suicidal ideation are the most predictive, aligning with established clinical knowledge and validating the clinical relevance of the extracted features. This work bridges the critical gap between predictive accuracy and interpretability in mental health assessment, providing a transparent, explainable system that clinicians can trust and understand, thereby laying the foundation for more reliable and clinically adoptable diagnostic tools.}
}
@article{JIA2026116190,
title = {Unified damage detection in heterogeneous bridges: A framework based on LSTM residuals and record-level aggregation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116190},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116190},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016388},
author = {Yuhan Jia and Zhaochao Li},
keywords = {Structural health monitoring, Bridge damage detection, LSTM autoencoder, Multi-scale feature extraction, Record-level aggregation, LightGBM},
abstract = {Bridge damage detection frameworks face major constraints under heterogeneous scenarios. This study proposes a unified framework for bridge damage detection, and the framework consists of three stages. First, a self-supervised long short-term memory (LSTM) autoencoder model is employed to generate damage-sensitive reconstruction errors (residuals) from raw vibration signals. Additionally, multi-scale and multi-domain feature enhancement is performed on the residual signals by wavelet transforms, frequency domain analysis, and statistical methods to generate window-level features. Variable-length window sequences are converted into fixed-length record-level feature vectors by calculating the mean and standard deviation of all window features in each monitoring record. Finally, a unified lightweight gradient boosting machine (LightGBM) classifier is employed for damage diagnosis. The framework is validated in two laboratory datasets (B1 and B2) and a real-world bridge dataset (The Old ADA bridge). The results demonstrate outstanding performance in all datasets (The F1 scores of B1, B2, and the Old ADA bridge are 0.963, 0.966, and 0.939, respectively). This study provides a robust and efficient solution to develop scalable and standardized data-driven bridge damage monitoring systems.}
}
@article{SHU2026116101,
title = {Automated evolution of swarm intelligence algorithms using multi-tree genetic programming},
journal = {Applied Soft Computing},
volume = {203},
pages = {116101},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116101},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015498},
author = {Ting Shu and Ziying Liang and Xuesong Yin},
keywords = {Swarm intelligence algorithms, Multi-tree genetic programming, Symbolic expression evolution, Algorithm evolution, Automated algorithm design},
abstract = {Swarm Intelligence Algorithms (SIAs), inspired by the collective behavior of natural systems, have demonstrated strong potential in addressing complex optimization problems. However, their design and improvement still heavily depend on manual, trial-and-error processes, limiting both adaptability and efficiency. This paper proposes a novel approach to automate the evolution of SIAs using Multi-Tree Genetic Programming (MTGP). The method enhances a given SIA by integrating update behaviors from multiple existing SIAs, which are decomposed into fundamental operators and operands. These components form a symbolic search space, where MTGP evolves new update rules. Exploration and exploitation behaviors, along with parameter update strategies, are jointly optimized as a combinatorial problem through MTGP. To further improve evolutionary efficiency, a diversity-guided learning acceleration mechanism is introduced to reduce fitness evaluation costs without sacrificing performance. Experimental results on QoS-aware Cloud Service Composition (QoS-CSC) problems demonstrate that the proposed method consistently outperforms the baseline classical and state-of-the-art SIAs considered in our study. It exhibits superior adaptability, robustness, and overall optimization performance across diverse problem scenarios.}
}
@article{LI2026116137,
title = {Structure-Aware Kolmogorov-Arnold Network with anatomical priors for cardiac segmentation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116137},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116137},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015851},
author = {Song Li and Shuaichao Du and Xiaofeng Li},
keywords = {Cardiac image segmentation, Knowledge-enhanced, Kolmogorov-Arnold Network, Multi-scale attention},
abstract = {Cardiac Magnetic Resonance imaging provides comprehensive morphological and functional information, making it the gold standard for cardiovascular diagnosis. However, the clinical deployment of deep learning models is hindered by challenges in handling data heterogeneity, balancing context aggregation with interpretability, and incorporating anatomical priors. To address these challenges, we propose the Structure-Aware Kolmogorov-Arnold Network, named SKANet. Specifically, a Dynamic Group Rational Kolmogorov-Arnold Network is integrated into skip connections to adaptively refine features against domain shifts. Furthermore, a Multi-scale Kolmogorov-Arnold Attention Module is devised to capture fine-grained contexts while improving model transparency. Additionally, we design an Entity Region Consistency Constraint Loss to explicitly incorporate anatomical priors for semantically consistent predictions. Extensive experiments are conducted on three diverse benchmark datasets (ACDC, MSCMRSeg, and M&Ms). On the ACDC dataset, SKANet achieves state-of-the-art performance, yielding a Dice score of 92.65% and an HD95 of 1.21 mm. Furthermore, zero-shot evaluations on the M&Ms dataset explicitly validate the framework's robust cross-domain generalization, while experiments on the MSCMRSeg dataset demonstrate its exceptional multi-sequence robustness and annotation-efficient capabilities. This paper indicates that SKANet provides a robust foundation for accurate cardiac segmentation across diverse pathologies and imaging protocols, which is crucial for standardized and reliable cardiovascular diagnosis.}
}
@article{YI2026116088,
title = {A graph-based Q-network with expert-rule enhancement for integrated scheduling and maintenance optimization},
journal = {Applied Soft Computing},
volume = {203},
pages = {116088},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116088},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601536X},
author = {Wenchao Yi and Peng Su and Gaoyan Shi and Yong Chen and Zhi Pei},
keywords = {Dynamic flexible job shop scheduling, Limited maintenance resources, Graph neural network, Deep reinforcement learning, Expert rule enhancement},
abstract = {This paper addresses the Dynamic Flexible Job Shop Scheduling Problem with Limited Maintenance Resources (DFJSP-LMR), which involves joint optimization of production scheduling and condition-based preventive maintenance under dynamic environments. To handle dynamic events such as new job arrivals, machine breakdowns, and maintenance triggers, we propose GQN-EREA (Graph-based Q-Network with Expert-Rule Enhancement Algorithm), a hybrid deep reinforcement learning approach. The method models job-machine-resource interactions via heterogeneous graph structures and employs a DQN to select from 15 composite actions, each combining a scheduling rule (SRPT, LRPT, MOR, LOR, or RR) with a maintenance action (No Maintenance, Minor Repair, or Major Repair). A composite action-reward mechanism balances makespan minimization with maintenance cost. Comparative experiments on instances up to 20 × 10 scale demonstrate that GQN-EREA achieves the lowest makespan in 14 out of 15 test cases, with relative deviations of 19–40% against genetic algorithms and 28–64% against heuristic rules. Moreover, GQN-EREA exhibits smaller standard deviations (e.g., 4.77 vs. 6.06 for GA in 6 × 6 cases), indicating superior stability and robustness in dynamic manufacturing environments. Furthermore, ablation studies confirm that the integrated expert rules effectively prevent redundant repairs. These findings imply that GQN-EREA offers a scalable, real-time decision-support tool to effectively manage degradation-induced downtime and balance production throughput with equipment reliability in real-world smart manufacturing.}
}
@article{BAISTHAKUR2026116182,
title = {Fatigue-consistent wind turbine load reconstruction via physics-guided differentiable spectral fatigue modelling},
journal = {Applied Soft Computing},
volume = {203},
pages = {116182},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116182},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016303},
author = {Shubham Baisthakur and Breiffni Fitzgerald},
keywords = {Fatigue damage, Wind turbine, Virtual sensing, Moment reconstruction, LSTM model, Scientific machine learning, Physics-guided ML},
abstract = {Accurate fatigue life estimation is essential for reliable operation and maintenance of wind turbines, but direct measurement of fatigue-critical loads is often challenging due to cost and durability constraints on strain-gauge instrumentation. Existing machine-learning-based load reconstruction methods are generally trained to optimise pointwise signal accuracy; however, fatigue damage accumulation is predominantly governed by cyclic and spectral characteristics rather than by instantaneous reconstruction fidelity alone. Moreover, standard fatigue measures derived from rainflow counting are fundamentally non-differentiable, which prevents their direct integration within gradient-based learning schemes. To overcome this drawback, this work develops an LSTM-based virtual sensing framework to reconstruct full time-resolved tower base fore-aft bending moment histories using SCADA-based parameters and nacelle acceleration signals. The core novelty lies in a composite optimisation objective that combines mean squared error with a differentiable spectral fatigue loss based on Dirlik’s method, thereby jointly enforcing local time-domain accuracy and global fatigue-relevant spectral consistency. Trained and validated on OpenFAST aeroelastic simulations of the IEA 15-MW reference turbine, the proposed model explains more than 99% of the variance in mean tower base loads and accurately reproduces downstream fatigue metrics. The propagation of signal reconstruction errors is quantified across the pipeline to establish explicit error bounds for damage-equivalent loads (DEL) and equivalent fatigue loads (EFL). A systematic noise robustness study, based on injecting controlled levels of Gaussian noise into individual input features, further reveals that the model is more sensitive to noise in blade pitch and generator speed, which directly define the aerodynamic operating state, but remains markedly more tolerant to measurement degradation in nacelle acceleration and wind speed inputs. These results link virtual sensor performance to realistic sensor signal-to-noise ratios and offer practical guidance on sensor quality and filtering requirements. Overall, the proposed framework provides a concise, physics-guided route to integrate fatigue specific constraints into virtual sensing frameworks, enabling condition-based maintenance and life extension strategies.}
}
@article{XU2026116093,
title = {Meta-reg: A meta-learning framework for generalizable intraoperative 2D/3D image registration},
journal = {Applied Soft Computing},
volume = {203},
pages = {116093},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116093},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015413},
author = {Linquan Xu and Qingquan Kong and Xi Wang and Zhang Yi and Lei Xu},
keywords = {Meta-learning, 2D/3D image registration, Digitally reconstructed radiograph, Meta-reg},
abstract = {In orthopedic minimally invasive surgery, accurate intraoperative 2D/3D image registration, which aligns intraoperative 2D X-ray images with preoperative 3D CT scans, is essential not only for intraoperative trajectory planning, but also for real-time navigation of surgical instruments and intraoperative image enhancement. However, current learning-based approaches typically require training separate models for individual patients, limiting generalizability and scalability in clinical practice. Furthermore, 2D/3D registration can be viewed as a structure-aware, sequential pose estimation problem, where image features progressively evolve toward the final pose in a highly nonlinear and interdependent manner. To address these challenges, we propose a novel meta-learning-based framework, Meta-Reg, that enables one-time training across diverse patient subjects, delivering a single, generalizable model for accurate registration. Our method employs the Residual neural memory Ordinary differential equations (R-nmODE), a state-space network that effectively characterizes the continuous evolution from image features to target pose through a neural dynamical system. To mitigate the inherent training instability arising from stochastic task selection in meta-learning, we propose the Gradient Self-Distillation (GSD) mechanism, designed to optimize optimization trajectories by exploiting historical gradient information. Additionally, we propose a meta iteration strategy during the test phase to further improve fine registration accuracy. Extensive experiments on two public datasets demonstrate the effectiveness of our approach. Specifically, under retrospective best-iteration evaluation, on the DeepFluoro dataset, our method outperforms the state-of-the-art baseline, DiffPose, by 4% in sub-millimeter success rate (SMSR) and achieves an exceptional mean Target Registration Error (mTRE) of 0.48 ± 1.17 mm (a reduction of 0.42 mm). Similarly, under the same evaluation setting, on the challenging Ljubljana dataset, it achieves an outstanding mTRE of 0.16 mm (a further 0.04 mm reduction across all views compared to DiffPose). These quantitative results demonstrate that the synergy of our proposed modules provides strong upper-bound registration performance across diverse benchmarks.}
}
@article{ULLAH2026116145,
title = {A physics-guided deep learning framework for multi-solution inverse design of micro-electromechanical system (MEMS) thermoelectric in-situ structures},
journal = {Applied Soft Computing},
volume = {203},
pages = {116145},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116145},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015930},
author = {Imran Ullah and Kalim Ullah and Lin-Feng Zhao and Zai-Fa Zhou},
keywords = {Multi-solution generation, Deep learning, Inverse design, Seebeck coefficient, Latent space optimization, Uncertainty quantification},
abstract = {Accurate inverse design of thermoelectric Seebeck coefficient in-situ test structures for micro-electro-mechanical systems (MEMS) is essential to meet specific performance requirements. Traditional approaches rely on expert knowledge and extensive finite-element simulations, which are time-consuming and yield single solutions. While deep learning (DL) methods address forward design efficiently, they neglect the practical need for multiple geometrically distinct valid designs simultaneously a challenge known as the one-to-many inverse mapping problem. To address this, we propose a physics-guided Conditional Variational Autoencoder and Generative Adversarial Network (CVAE-GAN) coupled with a Multi-Solution Generator (G-MS) for high-efficiency inverse design. G-MS employs a two-stage gradient-based latent space optimization that simultaneously enforces performance fidelity, physical feasibility, solution realism, and geometric diversity. Validated on a 5,000-sample MEMS in-situ Seebeck test structure dataset generated via finite-element analysis (COMSOL), our approach achieves a 100% success rate across six target Seebeck coefficients (225.0–227.5 µV/K), with mean error of 0.045 µV/K within the ±1.5 µV/K tolerance. Compared to four baselines (random search, tandem networks, and standard CVAE), G-MS achieves 10 × higher solution diversity with statistical significance (p < 0.001) across five random seeds. FEM validation of three designs confirms sub-0.23% surrogate accuracy, bridging the gap between data-driven inverse design and physical MEMS fabrication. Monte Carlo Dropout confirms mean predictive uncertainty of 0.46µV/K within tolerance providing a reliability metric for each design. This study provides a reliable, fabrication-aware tool for MEMS inverse design, accelerating thermoelectric sensor development and in-situ test structure design.}
}
@article{BIST2026116154,
title = {Spherical fuzzy combined compromise solution approach for decision-making based on similarity and score functions},
journal = {Applied Soft Computing},
volume = {203},
pages = {116154},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116154},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016029},
author = {Babita Bist and Satish Kumar},
keywords = {Spherical fuzzy set, Similarity measure, Score function, Decision-making, Combined compromise solution, Remote patient monitoring, Healthcare},
abstract = {The informed selection of remote patient monitoring (RPM) systems incorporating AI-enabled functionalities requires a decision-making (DM) method that can handle uncertainty in a clear and reliable manner. Spherical fuzzy sets (SFSs) help represent acceptance, rejection and hesitation together with associated residual uncertainty and offer a flexible way to model imprecise information. However existing methods for similarity assessment and ranking in SFSs often provide limited support for precise discrimination among alternatives, occasionally producing unresolved ties. This study introduces a similarity measure and a scoring function designed for spherical fuzzy (SF) information. These developments are incorporated into a revised CoCoSo model supported by objective weights obtained from best and worst ideal solution concept inspired by TOPSIS. The performance of the model is examined through comparison with existing methods. Sensitivity analysis is carried out under small changes in weights to study the stability of results. Spearman’s rank correlation is used to check agreement with other established SF techniques and with picture fuzzy and intuitionistic fuzzy ranking methods on two published real-world datasets. Applications in pattern identification, teaching model evaluation, RPM system selection, emergency-response planning and web-service selection illustrate the applicability of the proposed framework. The framework operates on a spherical fuzzy decision matrix derived from expert evaluations and supports the ranking and selection of alternatives, enabling its use as a structured decision-support approach in uncertain multi-criteria environments. The results indicate that the framework can provide clear and consistent rankings, particularly in scenarios requiring precise discrimination among alternatives.}
}
@article{ZHAO2026116170,
title = {Multi-source coordinated partitioned multi-objective frequency regulation network considering unit regulation characteristics and frequency deviation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116170},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116170},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016182},
author = {Zeyu Zhao and Xiyun Yang and Weijing Li and Ying Gao},
keywords = {Real-time frequency regulation, Multi-source system, Temporal neural network, Multi-objective scheduling},
abstract = {The high penetration of renewable energy generation poses significant challenges to the frequency regulation of power systems. Designing a multi-source coordinated frequency regulation strategy that synergizes the dynamic response characteristics of various power sources is crucial for enhancing the frequency response performance of the power grid. By enhancing the real-time allocation performance of automatic generation control (AGC) commands and coordinating the frequency regulation response characteristics of multi-source units, this paper proposes a partitioned multi-objective scheduling strategy for multi-source frequency regulation involving thermal power, renewable energy generation, and hybrid energy storage systems. This strategy first divides frequency regulation commands into a fine regulation zone, normal regulation zone, quick regulation zone, and alert regulation zone, where different combinations of frequency regulation power sources are deployed to match their dynamic response characteristics. Through this partitioned scheduling strategy, which utilizes multi-objective combinations based on command interval divisions to dispatch different types of frequency regulation resources, the optimization of regulation costs, dynamic reserves, and response times is achieved. Secondly, to address the contradiction between the time-consuming nature of multi-objective optimization and the requirements of real-time control, a real-time scheduling method based on lazy graph convolution and multivariate attention is proposed. Considering AGC commands, multi-source real-time states, and frequency regulation characteristics, an improved graph convolutional temporal decision-making network combined with a multivariate attention mechanism is constructed to output optimal decision variables for multi-source frequency regulation, ensuring the rapidity and stability of the scheduling strategy. Simulation results demonstrate that the proposed strategy improves the economic efficiency of multi-source frequency regulation scheduling and reduces both frequency deviation and response time.}
}
@article{ZHOU2026116186,
title = {A dependency-aware global spectral-entropy framework for structured neural network pruning},
journal = {Applied Soft Computing},
volume = {203},
pages = {116186},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116186},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016340},
author = {Guanghui Zhou and Donglin Zhang},
keywords = {Structured pruning, Model compression, Dependency-aware pruning, Global activation dependency structure, Signed marginal entropy-change score, Spectral entropy},
abstract = {Structured pruning is an effective way to reduce the computational and memory costs of deep neural networks while preserving hardware-friendly dense architectures. Most existing methods estimate the importance of channels, filters, or structural groups using local statistics, such as weight magnitude, activation responses, or gradient-based sensitivity. Although these criteria are efficient, they may overlook how different structures jointly contribute to the global representation, especially when redundancy is distributed across layers or constrained by architectural dependencies. This paper proposes a dependency-aware global pruning framework based on a signed marginal entropy-change score (MES). The method first defines executable pruning groups according to architectural dependencies, so that coupled channels or hidden dimensions are removed consistently. A calibration subset is then used to collect group-level activation responses from the fixed dense model. From these responses, a global activation-correlation matrix is constructed, and its rank-normalized spectral entropy is used to characterize the global activation dependency structure among pruning groups. MES measures the marginal change in this global entropy when each group is removed, enabling all dependency-aware groups to be ranked under a unified global criterion. Experiments on CIFAR-10, CIFAR-100, and ImageNet-1K with VGG-16, ResNet-56, ResNet-50, and DeiT-B show that the proposed method achieves competitive accuracy–compression trade-offs compared with representative structured pruning methods. On ResNet-50/ImageNet-1K, MES reduces FLOPs by 53.0% with only a 0.19% Top-1 accuracy drop. Ablation studies further confirm the effectiveness of the MES criterion, global ranking strategy, calibration-set size, and pruning-group granularity.}
}
@article{MAURYA2026116097,
title = {Multi-view twin random vector functional link for classification problems},
journal = {Applied Soft Computing},
volume = {203},
pages = {116097},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116097},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015450},
author = {Jyoti Maurya and Deepak Gupta},
keywords = {Multi-view learning, Twin random vector functional link, Randomized based algorithms},
abstract = {Machine learning applications in domains such as medical diagnosis, fault detection, and pattern recognition frequently involve data collected from multiple sources or feature representations, making multi-view learning (MVL) a practically significant paradigm. In MVL, a model learns from multiple distinct feature sets simultaneously, exploiting the complementary information across views to improve generalization. Twin Random Vector Functional Link (TRVFL) networks, a recently proposed technique combining the twin-learning framework with randomized neural networks, have demonstrated strong performance for binary classification tasks with low computational cost. However, existing TRVFL models are limited to single-view settings, leaving the complementary structure of multi-view data unexploited. To address this gap, we propose the Multi-view Twin Random Vector Functional Link (MvTRVFL) model, which integrates the MVL framework into the TRVFL architecture by constructing view-specific hyperplanes and incorporating a consensus-based regularization term across views. The combination of multi-view learning and the TRVFL framework enhances the generalization performance, robustness, and efficiency of our proposed model. Experiments conducted on benchmark datasets obtained from the UCI Machine Learning Repository, spanning application domains including biomedical classification and image recognition, demonstrate that MvTRVFL consistently outperforms competing methods, TRVFL, Support Vector Machine-2 View Learning (SVM-2K), and Multi-view Twin Support Vector Machine (MvTWSVM) in terms of accuracy, AUC, recall, precision, and F1-score. Statistical validation using the Friedman test followed by the Nemenyi post-hoc analysis confirms the superiority of the proposed model. Parameter sensitivity analysis further indicates that the model maintains stable and robust performance across a range of hyperparameter settings.}
}
@article{QIN2026116158,
title = {TSPeakNet: A dual-scale neural architecture for district-level crop pest and disease time-series forecasting and peak-event detection},
journal = {Applied Soft Computing},
volume = {203},
pages = {116158},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116158},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016066},
author = {Yuanze Qin and Zonghuan Han and Lingxian Zhang and Yiding Zhang},
keywords = {Plant electronic medical records, Time-series forecasting, Peak-event detection, Kolmogorov–Arnold networks, Crop pest and disease forecasting},
abstract = {Crop pests and diseases threaten food security through short-lived peaks superimposed on strong seasonality. Although large-scale Internet of Things (IoT)-based monitoring can improve spatial coverage, its deployment and maintenance are costly, and conventional time-series models often emphasize long-term trends while missing brief but operationally important peaks. To address this challenge, we develop an integrated forecasting and warning-support framework using district-level Plant Electronic Medical Records (PEMRs) from 2018 to 2021. TSPeakNet is a peak-aware dual-scale neural architecture that combines a short-window branch for local fluctuations with a long-window branch for broader temporal patterns. An adaptive mixer learns branch weights, a dual-period two-dimensional (2D) convolutional module captures multi-scale seasonality, and spline-based Kolmogorov–Arnold Network (KAN) layers represent threshold- and saturation-like nonlinearities. We introduce a unified event-level evaluation protocol that includes threshold-based event construction, peak matching, and signed timing-error assessment. In the ablation study on PEMR data from ten Beijing districts, TSPeakNet reduced RMSE and MAPE by 32% and 22%, respectively, and increased R² by 0.02 relative to the TimesNet baseline. Using thresholds derived only from the training data, TSPeakNet achieved competitive event-level peak detection across districts. External validation on the public aphids dataset provides additional evidence in a different crop-pest monitoring context. A regional warning-support platform integrates PEMR streams to generate risk maps, prescription-count forecasts, and peak-event indicators for city-scale decision support and district-level inspection scheduling. Code is available on GitHub.}
}
@article{GENC2026116144,
title = {A stable constraint-guided artificial bee colony algorithm (SCG-ABC) for turbulence grid shape optimization},
journal = {Applied Soft Computing},
volume = {203},
pages = {116144},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116144},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015929},
author = {Mustafa Serdar Genç and Ramazan Özkan and İlker Kayali},
keywords = {Artificial Bee Colony (ABC), Constraint-guided optimization, Turbulence grid, Shape optimization, Stability, Non-Dominated Sorting Genetic Algorithm II (NSGA-II)},
abstract = {This study presents a Stable Constraint-Guided Artificial Bee Colony (SCG-ABC) framework for turbulence grid shape optimization and demonstrates its applicability to constrained engineering design problems. Turbulence grids are widely used in wind tunnel experiments to generate controlled atmospheric turbulence, and their geometric design requires the simultaneous satisfaction of several geometric and flow-development constraints. The SCG-ABC framework was applied to the optimization of turbulence grid geometry defined by grid bar thickness and mesh size parameters. The optimization process considered porosity requirements and downstream flow-development constraints to identify feasible grid configurations. To evaluate its performance, the proposed approach was compared with the widely used Non-Dominated Sorting Genetic Algorithm II (NSGA-II) algorithm under identical computational conditions. Both algorithms were executed in 30 independent runs, and the results were assessed using statistical indicators including mean, standard deviation, minimum, median, and maximum values. The results showed that both algorithms successfully identified feasible turbulence grid configurations within the prescribed design space. However, SCG-ABC produced more concentrated and repeatable solutions with lower variability in design variables, indicating a more stable convergence behavior. Furthermore, the proposed framework achieved approximately 30% lower computational time than NSGA-II while maintaining consistent constraint satisfaction across repeated runs.}
}
@article{HAN2026116124,
title = {Data-driven single-objective optimization using a reference vector guided multi-objective infill criterion and Louvain-based local search},
journal = {Applied Soft Computing},
volume = {203},
pages = {116124},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116124},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015723},
author = {Xiao-Yao Han and Huachao Dong and Peng Wang and Xinjing Wang},
keywords = {Data-driven optimization, Surrogate model, Global optimization, Multi-objective infill criterion, Reference vector guided evolutionary optimization},
abstract = {Data-driven optimization methods offer a promising solution for expensive black-box problems by iteratively guiding sampling through surrogate models. To effectively balance exploration and exploitation while improving search focus, this paper proposes a data-driven single-objective optimization method using a reference vector guided multi-objective infill criterion and Louvain-based local search (DRVLS). The method features a three-phase sampling strategy: a reference vector guided multi-objective global sampling for balanced search across the entire design space; a Louvain-based multi-objective local sampling that identifies a promising subspace via community detection for focused sampling; and a local knowledge mining strategy for further refinement. The novelty of DRVLS lies in two aspects: a reference vector guided bi-objective infill criterion that adaptively balances exploitation and exploration, and the effective integration of this criterion with an adaptive space reduction mechanism based on the Louvain algorithm. Comprehensive experiments on benchmarks from 10 to 100 dimensions demonstrate that DRVLS outperforms several peer algorithms that also employ multi-objective infill criteria on small to medium-scale problems and remains competitive on 100D tasks. Its practical efficacy is further validated by a successful application to the computationally expensive hydrodynamic shape optimization of a blended-wing-body underwater glider.}
}
@article{WANG2026116148,
title = {3D reconstruction of spatial transcriptomics data with dual incremental deep reinforcement learning},
journal = {Applied Soft Computing},
volume = {203},
pages = {116148},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116148},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015966},
author = {Huaiji Wang and Chuangang Lu and Qingchen Zhang and Bocheng Ren},
keywords = {Incremental learning, Deep reinforcement learning, 3D reconstruction, Spatial Transcriptomics},
abstract = {Three dimensional (3D) reconstruction of spatial transcriptomics (ST) data makes it possible to analyze the spatial heterogeneity of tissues and organs and other downstream tasks such as intercellular communication in the three-dimensional space. Most recent methods treat slice alignment as discrete pairwise operations that ignore historical knowledge, reducing 3D reconstruction to isolated local operations with limited quality. This paper proposes a novel method based on dual incremental deep reinforcement learning for 3D reconstruction of ST datasets. Specifically, we formulate the 3D reconstruction task of ST datasets as a sequential decision-making problem and further solve it using a deep Q-network integrated with incremental learning, where the reward and action from the current step are explicitly encoded as part of the state for the next step, in contrast to the implicit memory of experience replay in standard DQN, thereby achieving internal incremental training. Unlike traditional methods, although we still align all target slices sequentially to a common reference slice, we perform incremental training based on the model from the previous slice-pair alignment, fully utilizing the network weights learned from previous slice-pair alignment, thereby achieving external incremental training. Various experiments are conducted on some public benchmark datasets to compare the proposed method with current popular algorithms such as PASTE and STAligner and the results clearly proves the effectiveness of the proposed method for 3D reconstruction of ST datasets.}
}
@article{JAVED2026116132,
title = {LocoTrackAI: Advanced convolutional neural network-based tool for monitoring locomotor activity in dengue-infected Aedes aegypti mosquitoes},
journal = {Applied Soft Computing},
volume = {203},
pages = {116132},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116132},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015802},
author = {Nouman Javed and Adam J. López-Denman and Prasad N. Paradkar and Asim Bhatti},
keywords = {Locomotor activity, Dengue-infected mosquitoes, Artificial intelligence, Spatial analysis, Virus transmission},
abstract = {Monitoring mosquito locomotor activity is essential to understanding behavior and disease transmission. Previous studies on dengue-infected mosquitoes have been limited by restricted movement in small tubes, discontinuous recordings, and a lack of open-source tools. We present LocoTrackAI, an artificial intelligence-based tool that combines convolutional neural networks and multi-object tracking to analyze the locomotor activity of Aedes aegypti mosquitoes from video recordings in standard laboratory cages. LocoTrackAI automatically tracks individual mosquitoes and quantifies both individual and group activity, including spatial distributions, movement patterns, heat maps, and activity ratios. It achieved 99.91 % accuracy with a small centroid detection error of 0.22 pixels across 36,020 positions, and a 93.23 % success rate in identity reassignment during 207 occlusion events. Using LocoTrackAI, we analyzed over 3.24 million recorded positions and found higher activity in dengue-infected than in noninfected mosquitoes under controlled laboratory conditions (batch-wise p = 0.0009), with 95,726 movements and a mean activity of 0.30 versus 42,173 movements and a mean activity of 0.13. Spatial analysis indicated broader exploration by infected mosquitoes, with entropy values of 3.38 versus 3.13. These proof-of-concept findings suggest an association between dengue infection and differences in locomotor activity and spatial exploration, which may influence host encounter opportunities.}
}
@article{WANG2026116015,
title = {TM-SGANet: Micro-expression recognition by integrating terrace feature extraction and spatiotemporal genetic attention},
journal = {Applied Soft Computing},
volume = {203},
pages = {116015},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116015},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014638},
author = {Ning Wang and Qi Hu and Jinshu Zhao and Shimin Kan and Jiajian Li and Mingxin Zhao},
keywords = {Micro-expression recognition, Residual networks, Bi-LSTM, Spatiotemporal genetic attention},
abstract = {Micro-expressions are key cues that reveal underlying emotions. However, their extremely brief and subtle nature poses significant challenges for automatic recognition. Although various handcrafted and deep learning-based feature engineering methods have been proposed for micro-expression recognition, existing approaches often struggle to precisely capture the subtle features of micro-expressions and the minute motion variations within sequences. To better perceive the regions where micro-expressions occur and their fine-grained changes, this paper proposes a novel micro-expression recognition method that integrates the Terrace Module for Multi-Level and Multi-Scale Feature Extraction (TMMFE) and Spatiotemporal Genetic Attention (SGA). During the feature extraction stage, TMMFE enables the network to effectively capture both primary and secondary regions of interest, thereby reducing the loss of subtle micro-expression features. The SGA module leverages spatial and temporal characteristics in the data to capture fine motion differences across video frames. The proposed method was extensively evaluated on the SAMM, CASME II, SMIC, and CAS(ME)³ datasets. Experimental results demonstrate that our method achieves significant improvements in performance compared with state-of-the-art micro-expression recognition approaches.}
}
@article{TAMJID2026116128,
title = {DAM-net: Dual attention multi-task framework for coronary artery segmentation and stenosis severity classification},
journal = {Applied Soft Computing},
volume = {203},
pages = {116128},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116128},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015760},
author = {Abdul Jalil Tamjid and Sadia Tasnim and Mohammad Motiur Rahman},
keywords = {Coronary artery disease, Segmentation, Attention mechanism, Stenosis severity},
abstract = {Coronary artery disease (CAD) remains one of the leading causes of mortality worldwide, underscoring the need for accurate and automated diagnostic tools. This study presents a comprehensive deep learning-based pipeline for coronary artery segmentation, stenosis detection, and lesion severity assessment from X-ray coronary angiogram images. We implement several state-of-the-art segmentation architectures and evaluate them, including U-Net, U-Net ++, DeepLabv3+, and PSPNet. We further enhanced each model with attention mechanisms such as Dual Attention (PAM + CAM), Convolutional Block Attention Module (CBAM), and Multi-Scale Attention. Among all configurations, U-Net combined with Dual Attention (DA-Net) achieved the best segmentation performance, with a Dice score of 0.86 and an Intersection over Union (IoU) of 0.75. For stenosis localization, we employed the YOLOv11 model, which demonstrates improved detection performance for challenging angiographic scenarios. In our experiments, the model achieved an F1 score of 0.52, mAP@50 of 0.48, and a precision of 0.59. While these results are moderate overall, YOLOv11 showed comparatively better robustness in complex bifurcation regions and overlapping vessel segments. We performed a severity assessment using clinically established grading systems, namely SYNTAX for segmental level analysis and CAD-RADS for global classification. We inferred coronary dominance using anatomical segment logic (segments 4 and 15). Extensive experiments on annotated angiographic datasets confirmed the effectiveness of the proposed approach in terms of segmentation and detection accuracy, clinical scoring consistency, and robustness across varying lesion types.}
}
@article{SHAO2026116100,
title = {Generative model-based evolutionary algorithm for solving large-scale sparse multi-objective optimization problems},
journal = {Applied Soft Computing},
volume = {203},
pages = {116100},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116100},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015486},
author = {Shuai Shao and Ye Tian and Xiaotong Liu and Langchun Si and Shangshang Yang},
keywords = {Multi-objective optimization, Sparse optimization, Evolutionary computation, Large-scale optimization, Dimensionality reduction},
abstract = {Large-scale sparse multi-objective optimization problems (LSMOPs) are a class of optimization problems widely encountered in engineering practice and scientific research, where the optimal solutions typically contain only a small number of nonzero decision variables. Existing large-scale sparse multi-objective evolutionary algorithms (LSMOEAs) mainly rely on heuristic sparsity operators and local recombination mechanisms to search for high-quality solutions, which are insufficient to characterize the complex nonlinear dependencies and potential coupling patterns among decision variables. To address this issue, this paper proposes a generative model–based evolutionary algorithm for large-scale sparse multi-objective optimization, which no longer relies solely on traditional crossover and mutation operators but instead performs distribution-level modeling of the current non-dominated solutions and directly samples and decodes candidate solutions in a low-dimensional latent space. Through this learning-driven direct sampling mechanism, the search process is elevated from local perturbations to distribution-level generation, enabling the algorithm to adaptively capture the distributional characteristics of Pareto optimal solutions. To evaluate the effectiveness of the proposed algorithm in solving LSMOPs with varying levels of complexity, comprehensive experiments are conducted on multiple benchmark suites and real-world problems. The results demonstrate that, in most cases, the proposed algorithm outperforms existing state-of-the-art LSMOEAs in terms of both convergence and diversity of the obtained solutions.}
}
@article{CHE2026116173,
title = {An intelligent feature-optimized dynamic weighted small-data ensemble framework for multi-step power load forecasting},
journal = {Applied Soft Computing},
volume = {203},
pages = {116173},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116173},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016212},
author = {Jinxing Che and Houqing Zhang and Qinghua Zhang and Dewen Deng and Simeng Zhang and Jingjing Dai and Yuan Zheng},
keywords = {Multi-step power load forecasting, MI-SHAP feature selection, JADE optimization, EWMA dynamic ensemble, Small-data forecasting},
abstract = {With the development of smart grids and renewable-energy integration, accurate multi-step power load forecasting is essential for power-related work. Daily peak-load series have multiple unfavorable characteristics, which leads prediction errors to grow with the forecasting horizon. This paper proposes an intelligent feature-optimized, dynamically weighted, small-data ensemble framework for multi-step power load forecasting, which integrates multi-level wavelet decomposition, a fused Mutual Information (MI)-SHAP feature-selection strategy, JADE-based coupled joint hyperparameter optimization, and an exponentially weighted moving average (EWMA) adaptive weighting mechanism to ensemble heterogeneous SVR and XGBoost learners. Distinct from existing hybrid SVR-XGBoost ensembles that tune hyperparameters independently via grid search or separate metaheuristic runs, this work formulates a coupled optimization objective and solves it in a single JADE execution, eliminating the performance loss caused by decoupled parameter calibration. Unlike conventional feature selection workflows that apply a single global feature subset across all prediction horizons, this study implements MI-SHAP fusion separately for each horizon, yielding horizon-specific optimal feature subsets with dimensions ranging from 2 to 6 across different horizons and years. Furthermore, this work innovatively couples the well-established EWMA mechanism with JADE-optimized heterogeneous learners under the small-sample regime, forming a dynamic adaptive weighting strategy tailored for scenarios with small-data training samples. The proposed framework is systematically evaluated on daily peak-load datasets from City A (2021–2023) and an independent City B 2019 dataset, with seven statistical, machine-learning, and deep-learning baselines included for comprehensive benchmarking. Across the one- and two-step horizons the proposed method attains the lowest RMSE among all eight compared models, and it remains highly competitive at the three-step horizon; for one-step forecasting it lowers the average RMSE by about 40% relative to the strongest deep-learning baseline. Ablation experiments confirm that wavelet decomposition and MI-SHAP feature selection provide the largest error reductions, while JADE and EWMA yield additional horizon-dependent improvements. Pairwise Wilcoxon and Friedman tests confirm that these improvements are statistically significant (p < 0.05 and p < 0.001, respectively), and repeated runs show that the proposed framework is far more stable than the deep-learning baselines, with coefficients of variation of 0.23–3.27% versus 4.6–24.0%. These results demonstrate an accurate, stable, interpretable, and computationally compact solution for multi-step load forecasting under small-data conditions.}
}
@article{ALAMMAR2026116011,
title = {Knowledge-grounded task-oriented conversational agents based on improved retrieval-augmented generation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116011},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116011},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014596},
author = {Mai Al-Ammar and Hend Al-Khalifa and Khalil {El Hindi}},
keywords = {Arabic natural language processing (NLP), Knowledge-grounded conversational agents, Integrating external knowledge, Retrieval-augmented generation (RAG), Large language models (LLMs), University chatbots},
abstract = {Knowledge-grounded conversational agents aim to generate informative and context-aware responses by integrating supporting evidence from external knowledge sources. However, such systems remain under-explored for the Arabic language, particularly in specialized domains such as higher education. This study presents an Arabic knowledge-grounded, task-oriented conversational agent designed for graduate students at King Saud University, built upon an improved Retrieval-Augmented Generation (RAG) framework. The proposed approach enhances Arabic RAG through optimized retrieval and embedding mechanisms, enabling more accurate and contextually relevant responses. Evaluated on the ARCD and KaifLematha Arabic datasets, the improved RAG framework achieved 91.84 and 90.92 RAGAS scores, with gains of 6 and 12 points, respectively, over a naïve RAG baseline, and delivered 95% accurate and informative answers in real-world testing. These results demonstrate that a properly adapted RAG architecture can substantially improve the reliability of Arabic conversational systems in academic and administrative settings, contributing a practical and reproducible foundation for future Arabic-language intelligent assistants.}
}
@article{LIU2026116092,
title = {Multi-association driven gene risk prediction based on graph convolutional network},
journal = {Applied Soft Computing},
volume = {203},
pages = {116092},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116092},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015401},
author = {Tianli Liu and Jie Lian and Xinlei Zuo and Futian Weng and Bo Pan and Yan Xu},
keywords = {MammaPrint 70 gene risk, Multiple graph convolutional network, Multi-association},
abstract = {While the MammaPrint 70-gene assay has proven valuable for identifying ultra-low-risk breast cancer, its widespread adoption-particularly in primary care settings-remains limited by high costs and technical requirements. In response, there is growing interest in developing simpler, more accessible tools for genetic risk assessment that can complement existing genomic tests. This study introduces a multi-association-driven graph convolutional network (GCN) framework designed to address the challenges of high-dimensional feature spaces and limited sample sizes inherent in 70-gene risk stratification modeling. The proposed approach mitigates these issues by constructing a neighborhood information propagation mechanism that enhances learning across samples. From a local feature subset perspective, a multi-weighted patient graph construction algorithm is developed to capture cross-instance relationships across different dimensions. This graph is then integrated into a GCN to enable multi-dimensional association modeling. Experimental results demonstrate that the proposed framework achieves a classification accuracy of 80.10% and an area under the curve (AUC) of 0.8311. These findings suggest that multi-association modeling and the integration of multi-dimensional sample relationships contribute meaningfully to prediction accuracy. Overall, this work offers a potential technical pathway toward reducing reliance on cost-prohibitive genomic assays and supporting the broader implementation of precision medicine within a tiered healthcare system.}
}
@article{BANERJEE2026116153,
title = {Mining-Gym: A configurable RL benchmarking environment for open-pit truck dispatch optimization},
journal = {Applied Soft Computing},
volume = {203},
pages = {116153},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116153},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016017},
author = {Chayan Banerjee and Kien Nguyen and Clinton Fookes},
keywords = {Reinforcement learning, Truck dispatching, Discrete event simulation, Gymnasium, Mining simulation, Benchmarking},
abstract = {Optimizing the mining process, particularly truck dispatch scheduling, is a key driver of efficiency in open-pit operations. However, the dynamic and stochastic nature of these environments, marked by uncertainties such as equipment failures, truck maintenance, and variable haul cycle times, poses significant challenges for traditional optimization. While Reinforcement Learning (RL) shows strong potential for adaptive decision-making in mining logistics, the lack of standardized benchmarks limits fair comparison, reproducibility, and real-world applicability. Most models rely on proprietary or custom simulators, preventing systematic community-wide evaluation. To bridge this gap, we present Mining-Gym: a configurable, open-source benchmarking environment for evaluating RL algorithms in mining process optimization. Mining-Gym is built on Salabim-based Discrete Event Simulation (DES) and integrates with Gymnasium, enabling direct adoption of state-of-the-art RL algorithms including those from libraries like Stable Baselines. The framework captures mining-specific uncertainties such as equipment failures, queue congestion, and stochastic behavior through an event-driven decision-point architecture. Mining-Gym provides a graphical user interface (GUI) for parameter configuration, data logging, and real-time visualization, supporting reproducible evaluation of diverse RL strategies and heuristic baselines. To validate benchmarking performance, we compare multiple RL and non-learning algorithms across six scenarios ranging from normal operation to severe disruptions to hauling and loading capacity. Notably, under a fixed training budget, none of the tested off-the-shelf RL algorithms decisively outperformed the strongest non-learning baseline, positioning Mining-Gym as a challenging open benchmark for adaptive dispatching research. Statistical significance tests and effect-size analysis confirm that Mining-Gym distinguishes not only RL from heuristics, but also RL algorithms from each other, establishing it as a rigorous, reproducible testbed for adaptive decision-making in real mining logistics.}
}
@article{LI2026116140,
title = {Multilevel sampling adaptation ensemble framework for imbalanced data stream binary classification},
journal = {Applied Soft Computing},
volume = {203},
pages = {116140},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116140},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015887},
author = {Shaofang Li and Tingting Ren},
keywords = {Data streams classification, Class imbalance, Concept drift, Sampling, Ensemble learning},
abstract = {Class imbalance and concept drift are two major challenges in data stream classification, and their coexistence significantly increases the difficulty of maintaining reliable predictive performance in non-stationary environments. To address these challenges, this paper proposes Multilevel Sampling Adaptation Ensemble (MSAE) framework for imbalanced data stream classification. MSAE integrates a Dynamic Drift Adaptation (DDA) mechanism to continuously quantify drift intensity through statistical fluctuations and an Intensity-Aware Data Augmentation (IADA) strategy which employs Mahalanobis-distance-based spatial reconstruction to select topologically consistent minority samples and construct an adaptively weighted augmented feature set. To simultaneously capture short-term adaptation and long-term distributional stability, the framework incorporates three complementary learners: a Global learner for preserving long-term distributional knowledge, an Expert learner for maintaining minority-class information in high-uncertainty decision regions, and the Local learner for rapid adaptation to recent changes. These learners are coordinated through an adaptive weighting mechanism that balances responsiveness and stability during online learning. Extensive experiments conducted on 32 data streams against 9 baselines demonstrate that MSAE consistently achieves great classification performance under varying imbalance ratios, noise levels, and drift scenarios. Statistical significance tests further confirm the effectiveness of the proposed framework. In addition, parameter sensitivity analysis, ablation studies, and computational efficiency evaluation validate the robustness, effectiveness, and practical applicability of MSAE for real-world imbalanced data stream environments.}
}
@article{TAN2026116157,
title = {SORLDN2: A brain-inspired navigation decision-making framework for Mobile robots},
journal = {Applied Soft Computing},
volume = {203},
pages = {116157},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116157},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016054},
author = {Yibo Tan and Dongshu Wang},
keywords = {Brain-inspired decision-making, Cerebellum, Basal ganglia, Hippocampus, Supervised learning, Reinforcement learning},
abstract = {Brain-inspired navigation has attracted increasing attention because biological learning systems exhibit remarkable adaptability and decision-making capabilities in complex environments. However, existing brain-inspired robot navigation models mainly focus on cerebellum inspired supervised learning and basal-ganglia-inspired reinforcement learning, while hippocampal memory mechanisms are rarely incorporated explicitly. To address this limitation, this paper proposes a novel brain-inspired behavioral decision-making framework, termed Self-Organizing Reinforcement Learning with Developmental Network-2 (SORLDN2), which integrates the learning systems of the cerebellum, basal ganglia, and hippocampus for mobile robot navigation. Unlike existing cerebellum–basal ganglia models, the proposed framework models hippocampal pattern separation and memory formation, enabling dynamic cooperation among supervised learning, reinforcement learning, and memory systems within a unified decision-making architecture. In the proposed framework, Developmental Network-2 (DN2) models cerebellar supervised learning, while Self-Organizing Reinforcement Learning (SORL) combines reinforcement learning with a self-organizing map to emulate the functions of the basal ganglia and hippocampus. A familiarity factor is introduced to dynamically coordinate the two learning systems, enabling adaptive action selection according to environmental familiarity. Simulation, comparative, and real-robot experiments demonstrate the effectiveness of the proposed framework. Compared with the baseline methods, SORLDN2 achieves faster learning, improved decision-making performance, and stronger robustness. In real-robot navigation tasks, SORLDN2 achieved a 100% success rate in simple environments and completed 26 of 30 navigation trials in complex environments, demonstrating strong robustness and adaptability under varying environmental conditions.}
}
@article{ZHANG2026116034,
title = {StockConv: A lightweight convolutional neural network model for stock prediction-based investment},
journal = {Applied Soft Computing},
volume = {203},
pages = {116034},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116034},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014821},
author = {Yanyi Zhang and Johannes {De Smedt}},
keywords = {Stock prediction, Convolutional neural networks, Dilated depthwise convolution, Group pointwise convolution},
abstract = {Stock price forecasting is a widely-studied problem in quantitative finance. Current work captures spatial patterns among stocks for joint stock price forecasting with typical pipelines including learning the temporal features of each stock so temporal representations can be used to model spatial patterns among stocks to forecast. With the emergence of Transformer- and MLP-based models in time series analysis, convolution-based models have been diverted to the background despite their high computational efficiency and the capability to capture local patterns. We propose a CNN-based stock price forecasting model, StockConv, consisting of two modules combining the strengths of convolutional neural networks. The first module performs feature level learning to create a deep representation of all features of each stock by using a multi-scale dilated depthwise convolution and a pointwise convolution to capture and compress temporal patterns of all stocks. The second module employs a group pointwise convolution to capture the spatial relationships among stocks and is followed by the depthwise convolution to capture the temporal patterns of all stocks. The extracted features are used to forecast all stock returns. According to empirical results, our proposed StockConv outperforms the state-of-the-art models on S&P 500 and the NASDAQ market dataset in terms of predictive performance efficiently with fewer parameters to train. What’s more, the proposed model is tested with different trading strategies and show the better financial performance compared with baseline models, with an increase of around 30% and 23% in terms of the Sharpe ratio on the S&P 500 and FTSE 100 markets, respectively.}
}
@article{LI2026116147,
title = {PhD-DETR: Physics-guided depth-aware transformer for monocular 3D object detection under adverse weather conditions},
journal = {Applied Soft Computing},
volume = {203},
pages = {116147},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116147},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015954},
author = {Haoyu Li and Bo Wang and Yueran Zhao and Zhishuai Huang and Chao Yue and Jiaru Zhong and Jianghao Leng and Chao Sun},
keywords = {Monocular 3D object detection, Physical priors, Physics-guided loss, Weather adaptation, Transformer},
abstract = {Robust monocular 3D object detection under adverse weather conditions remains a significant challenge due to monocular depth ambiguity and weather-induced visual degradation. In this paper, we propose PhD-DETR (Physics-guided Depth-aware Transformer), a physics-guided reliability-constrained framework for robust monocular 3D object detection. Instead of using physical priors as fixed replacements for learned visual features, PhD-DETR formulates environment and frequency priors as adaptive soft reliability cues within a depth-aware Transformer detector. Specifically, PhD-DETR introduces a Prior-knowledge Gated Fusion Module to adaptively integrate image features and aligned physical priors, a Physics-guided Adaptive Attention Mechanism to modulate deformable attention logits with query-specific prior responses, and a Physics-guided Attention Regularization loss to encourage object-related attention distributions to be consistent with physically meaningful cues. Experiments on KITTI, KITTI-C and V2X-Radar-V demonstrate that PhD-DETR improves robustness under both controlled synthetic corruptions and real-world adverse sensing conditions. Extensive ablation studies further show that the proposed physical priors provide complementary reliability cues rather than merely acting as generic spatial masks or redundant feature enhancements.}
}
@article{YOU2026116150,
title = {An extension of emergency level dynamic adjustment method with social network analysis and quantum-like Bayesian network},
journal = {Applied Soft Computing},
volume = {203},
pages = {116150},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116150},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601598X},
author = {Xinli You and Peide Liu},
keywords = {Emergency decision–making, Experts’ comprehensive weight, Quantum-like Bayesian network, Belief entropy, Dynamic adjustment},
abstract = {In addressing complex and dynamic emergency decision–making (EDM) problems, the traditional multi-criteria group decision–making (MCGDM) models usually assume that the multiple experts are independent, which cannot manage the mutual influence of individual opinions and the dynamic adjustment of emergency decision objects. This paper proposes a novel group decision–making framework based on a quantum like Bayesian network and sequential game to address the group interaction and dynamic emergency scenarios. The model initially characterizes expert weights from social network analysis (SNA) and employs extended Dempster-Shafer evidence theory (DSET) to integrate judgment information of individual experts from various criteria. On this basis, a quantum-like Bayesian network (QLBN) with belief entropy is constructed to capture the interference among experts’ opinions. Then, an emergency-level adjustment model based on sequential game and termination theory is developed to dynamically determine the emergency level of the current stage before the emergency termination time. Finally, a numerical study on an earthquake scenario is conducted to elucidate the proposed emergency decision–making model’s practicality and superiority. Furthermore, its effectiveness and advantages are demonstrated through sensitivity analysis and comparison of several decision models. Finally, managerial implications, limitations and future directions are provided to enhance the practical application capability of the proposed EDM model.}
}
@article{YAO2026116103,
title = {Instance–hardness–guided oversampling with a dual-level parallel structure for noisy imbalanced classification},
journal = {Applied Soft Computing},
volume = {203},
pages = {116103},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116103},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015516},
author = {Shimeng Yao and Liyun Zhang and Yingting Luo},
keywords = {Imbalanced classification, SMOTE, Data pre-processing, Over-sampling, Instance hardness},
abstract = {Class imbalance is a long-standing challenge in machine learning, particularly when minority samples are corrupted by noise or reside in highly overlapping regions. Standard oversampling methods such as SMOTE often produce low-quality synthetic samples under these conditions. In this paper, we propose SMOTE-IH, a two-stage extension of SMOTE that incorporates instance–hardness (IH)–based noise filtering. IH values across classifiers and folds provide a global assessment for samples, removing noisy or ambiguous samples before oversampling. Extensive experiments on synthetic, real, and noisy datasets demonstrate the effectiveness of SMOTE-IH. It consistently outperforms classical SMOTE variants and recent oversampling methods. For instance, across real imbalanced datasets with varying noise types, SMOTE-IH improves performance over standard SMOTE, with AUPRC gains ranging from 14% to 36% and G-mean gains ranging from 5% to 25%. The performance gains tend to increase as class overlap rises. To further address the computational demands of IH estimation, we implement an optional accelerated dual-level parallelization strategy. As the sample size and feature dimensionality increase, this scheme reduces the hardness-estimation time by more than 80% compared with its serial counterpart.}
}
@article{SHAMEEM2026116127,
title = {Taxonomy of challenges influencing secure code generation using LLMs: An integrated approach of systematic literature review and F-AHP},
journal = {Applied Soft Computing},
volume = {203},
pages = {116127},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116127},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015759},
author = {Mohammad Shameem and Sajid Anwer and Sajjad Mahmood and Shabbab Ali Algamdi and Mahmood Niazi and Mawal A. Mohammed},
keywords = {Secure code generation, Challenges, F-AHP, Software development, SLR},
abstract = {The growing adoption of Large Language Models (LLMs) in software development has introduced new opportunities for automation but also significant concerns regarding code security and reliability. Ensuring the generation of secure code through AI-assisted tools has therefore become an important research challenge. The aim of this study is to identify, validate, and prioritize the key challenges that compromise security in code generated using LLMs. Moreover, a taxonomy of the identified challenges and their categories has been developed based on their relative importance, evaluated through the Fuzzy Analytic Hierarchy Process (F-AHP). In the first stage, a Systematic Literature Review (SLR) was conducted to extract potential challenges from 22 primary studies. In the second stage, the identified challenges were empirically validated through a questionnaire survey involving software security and AI practitioners. In the third stage, the F-AHP method was applied to evaluate and prioritize the significance of these challenges. The study reports thirteen major challenges, including training dataset quality, poor prompt structure, data poisoning, vulnerable dependencies, and adversarial prompt attacks. The proposed taxonomy provides a structured framework that assists both researchers and industry professionals in understanding, assessing, and mitigating the security risks associated with LLM-based code generation.}
}
@article{DELGADO2026116022,
title = {Continual learning for adaptive IoT network intrusion detection via domain-incremental learning methods},
journal = {Applied Soft Computing},
volume = {203},
pages = {116022},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116022},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014705},
author = {Oliver Delgado and Hyunjae Kang and Ulysses Lam and Jung Taek Seo and Dan Dongseong Kim},
keywords = {Continual learning, Catastrophic forgetting, IoT security, Network intrusion detection},
abstract = {The proliferation of Internet of Things (IoT) devices increases exposure to network intrusions and motivates the development of Network Intrusion Detection Systems (NIDS) that can adapt to newly emerging attacks. However, models retrained on new threats often suffer from catastrophic forgetting, resulting in degraded performance on previously observed attacks. This paper evaluates continual learning (CL) strategies for neural-network-based NIDS on three IoT/network intrusion datasets (UQ-IoT-IDS-2021, Kitsune, and CIC-IDS-2017) under an incremental training protocol that sequentially introduces new attack types over nine stages while testing on a cumulative set of previously encountered attacks. We compare eight CL strategies spanning weight inheritance (WI), regularization (EWC, LwF, SI), replay (ER, A-GEM, DER++), and their WI-based combination (EWC + ER) across MLP, LSTM, and Transformer architectures, under both balanced and unbalanced protocols. Across the three datasets, replay-based strategies retain final-stage macro-F1 of 0.92–0.98 with average forgetting below 0.05, whereas regularization-only and naive sequential strategies suffer macro-F1 drops of 0.30–0.55 and forgetting rates above 0.32. Replay’s resource footprint is modest (peak CL state below 0.4 MB on MLP at a 100-sample-per-class buffer; training time within 1.5× of weight inheritance), and the same ranking holds across the three deep architectures and the unbalanced regime when measured by PR-AUC and false positive rate at high recall. A comparison against three unsupervised anomaly detectors (KitNET, Isolation Forest, and an autoencoder) further indicates that supervised continual learning is the more effective choice when labeled samples of new attack classes are available. The results confirm that memory-based mechanisms are central to sustaining detection performance in domain-incremental IoT NIDS scenarios.}
}
@article{XU2026116122,
title = {Simultaneous local and global clustering guided multi-view unsupervised feature selection},
journal = {Applied Soft Computing},
volume = {203},
pages = {116122},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116122},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601570X},
author = {Da Xu and Hanxiao Xu and Zhonggui Sun and Chuanyan Wu and Yusen Zhang and Lishan Qiao},
keywords = {Multi-view feature selection, Diversity of orthogonal basis, Consensus learning, Single-cell multi-omics, Marker genes},
abstract = {Multi-view unsupervised feature selection enhances model interpretability by extracting salient features from unlabeled, heterogeneous data. Existing algorithms heavily rely on local graph construction, which inherently suffers from a severe truncation effect. By forcing the similarities beyond local neighborhoods to zero, they inevitably discard valuable global structural information. Furthermore, the intrinsic diversity of cross-view data fundamentally stems from the diversity of their underlying bases—a critical aspect that remains largely overlooked in current literature. To address these issues, we propose a novel algorithm that simultaneously uses Local and Global clustering to guide Multi-view unsupervised Feature Selection (LGMFS). Specifically, within the projected space, we employ multi-view simultaneous orthogonal basis clustering to capture the diversity of the orthogonal bases while maintaining the consistency of the clustering indicator matrix. Then, LGMFS learns the global structure information by global subspace clustering and learns the optimal clustering structure by nonnegative structured graph learning to guide feature selection. An efficient alternating iterative algorithm is designed to solve the optimization problem, and we verified the convergence of the algorithm from theoretical analysis and experimental results. Systematic experimental results proved the effectiveness and advancement of LGMFS. We have successfully applied the unsupervised LGMFS to single-cell multi-omics and identified a large number of marker genes. It can effectively distinguish cell subpopulations and reveal the practical application value of LGMFS.}
}
@article{AMRUTHA2026116075,
title = {Quantized lite residual pyramidal convolutional network with skip connections for image forgery detection and edge AI hardware validation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116075},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116075},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015231},
author = {T. Amrutha and Rama Muni Reddy Yanamala and Archana Pallakonda and Rayappa {David Amar Raj}},
keywords = {Image forensics, Forgery detection, Deep learning, PyramidNet, Edge computing},
abstract = {The rapid advancement of image manipulation techniques has created an increasing demand for accurate and computationally efficient image forgery detection systems. This paper proposes a lightweight PyramidNet-based deep learning architecture with residual skip connections for binary image forgery detection. The proposed framework employs progressive pyramidal channel expansion and multi-stage hierarchical feature extraction to effectively capture both low-level and high-level tampering artifacts associated with splicing and copy-move manipulations. Extensive experiments were conducted on three benchmark datasets, namely CASIA v1, Columbia, and MICC-F2000. The proposed model achieved AUC scores of 0.99 on CASIA v1 and Columbia and 0.97 on MICC-F2000, with corresponding F1-scores of 0.98, 0.93, and 0.94, respectively. Furthermore, the model demonstrated high recall values across all datasets, indicating strong sensitivity to manipulated images. To evaluate practical deployment feasibility, the trained model was quantized and deployed on an Edge TPU-enabled Coral Dev Board. The quantized model achieved real-time inference with a latency of 6.4 ms per image and a deployment size of only 1.9 MB while maintaining competitive detection performance. The experimental results demonstrate that the proposed framework provides an effective, lightweight, and edge-compatible solution for image forgery detection in digital forensics and resource-constrained embedded systems.}
}
@article{YAO2026116099,
title = {A graph-based hybrid position error compensation method for serial industrial robots},
journal = {Applied Soft Computing},
volume = {203},
pages = {116099},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116099},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015474},
author = {Ming Yao and Paul Jacobi and Zhufeng Shao and Anna Kibireva},
keywords = {Kinematic calibration, Hybrid error compensation, Serial robot arms, Absolute positioning accuracy, Graph neural networks},
abstract = {With the advancement of industrial automation, industrial robots are increasingly deployed in manufacturing, assembly, and precision machining. Although they exhibit excellent repeatability, their absolute positioning accuracy often fails to meet the requirements of high-precision tasks, where even small deviations may cause performance degradation and operational instability. Improving absolute positioning accuracy has therefore become a critical challenge for intelligent manufacturing. This paper presents a hybrid position error compensation framework that combines a mechanism-based calibration approach with deep spatio-temporal graph learning. First, a Modified Denavit–Hartenberg (MDH) calibration method is employed to establish an accurate kinematic model and compensate for geometric errors. Then, a residual error graph informed by the robot’s kinematic topology is constructed, and an Attention-based Spatio-Temporal Graph Convolutional Network (ASTGCN) is applied to capture and predict non-geometric errors. Experiments were conducted on two robotic manipulators with different drive mechanisms and degrees of freedom: the 6-degree-of-freedom gear-driven manipulator and the 7-degree-of-freedom cable-driven manipulator. Using laser tracker measurements, the proposed method was benchmarked against uncalibrated performance, pure MDH calibration, and hybrid compensation baselines. Results show that the average positioning error of the UR5 was reduced from 2.566 mm to 0.155 mm, and that of the WAM from 17.766 mm to 2.918 mm, demonstrating both precision and robustness. The dataset used in this study is publicly released to facilitate reproducibility and further research. In summary, the novelty of this work lies in the integration of mechanism-based geometric calibration with kinematically-informed spatio-temporal graph residual learning, enabling effective compensation of both geometric and non-geometric positioning errors for serial industrial manipulators.}
}
@article{VARNA2026116151,
title = {In search of exploration and exploitation balance: E-AHPSO, a novel PSO-based ensemble algorithm},
journal = {Applied Soft Computing},
volume = {203},
pages = {116151},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116151},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015991},
author = {Fevzi Tugrul Varna and Phil Husbands},
keywords = {Swarm intelligence, Particle swarm optimisation, Ensemble algorithm, PSO-based ensemble algorithm, General-purpose optimisation algorithm},
abstract = {This paper proposes a novel PSO-based ensemble algorithm, E-AHPSO, utilising several previously published simpler off-the-shelf PSO variants collaborating with the recently published bio-inspired Altruistic Heterogeneous Particle Swarm Optimisation algorithm (AHPSO). The collaborating algorithms in the proposed method were selected from a pool of candidate algorithms after extensive preliminary experiments to determine the optimal combination and ordering of the constituent algorithms in the ensemble to best complement AHPSO. E-AHPSO incorporates the powerful exploration capabilities of AHPSO with the exploitation capabilities of the simpler PSO variants. As a result, the collaboration provides a highly effective general-purpose optimisation algorithm capable of tackling diverse problem types, complexities and sizes without parameter tuning. E-AHPSO was comprehensively tested using the CEC’13, CEC’14, CEC’17 and CEC’20 problem suites on dimensions 10, 30, 50, and 100 against 39 highly competitive comparator algorithms, consisting of 15 well-known PSO variants, 14 recent PSO variants (published after 2020), and 10 non-PSO variants including Differential Evolution variants (IEEE CEC competition winner L-SHADE, CoDE, and MTDE). The proposed algorithm ranked 1st on the 100-dimensional CEC’14 and CEC’17 problems against the 39 benchmarks. Moreover, E-AHPSO was ranked in the top 5 for all four test suites averaged across all dimensions. The novel algorithm performed consistently well across all problem types and dimensions. Analysis of E-AHPSO revealed that the convergence and population diversity patterns were comparable to or better than those of the top-performing comparator algorithms. Moreover, time complexity analysis showed that despite its effectiveness, E-AHPSO was more efficient than 64% of the benchmark algorithms on average (across all dimensions) and compared very favourably with the other high-performing algorithms.}
}
@article{MAHAJAN2026116055,
title = {Type-2 generalized spherical fuzzy-based decision support system and its application in photovoltaic module waste management strategy evaluation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116055},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116055},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015036},
author = {Rajdip Mahajan and Abhijit Baidya and Pinki Majumder and Muhammet Deveci and Uttam Kumar Bera and Seifedine Kadry},
keywords = {Type-2 generalized spherical fuzzy sets, Multi-criteria group decision-making, Distance measure, Entropy measure, Aggregation operator, Photovoltaic module waste management},
abstract = {This paper introduces a new variation of fuzzy set called the type-2 generalized spherical fuzzy set (T2GSFS), to better address uncertainties in multi-criteria group decision-making (MCGDM) problems. The proposed T2GSFS extends existing fuzzy environments by simultaneously incorporating primary and secondary membership, non-membership, and hesitancy functions through generalized spherical fuzzy numbers, thereby offering a richer representation of vague and imprecise expert assessments. To support decision analysis, several operational laws, distance and entropy measures, score and accuracy functions, and two weighted aggregation operators are developed. Based on these developments, a hybrid T2GSF-based MCGDM framework is proposed by integrating entropy-based expert weighting, a combined subjective-objective criterion-weighting mechanism, and a distance-based ranking model. The applicability of the proposed framework is demonstrated through a photovoltaic (PV) module waste-management problem, where five end-of-life strategies are evaluated over twelve sustainability criteria by four experts. The results identify “Advanced Full-Scale Recycling” as the best strategy with the minimum weighted distance value of 0.057, followed by “Selective Material Recycling” (0.063) and “Energy Recovery” (0.086), whereas “Conventional Landfill Disposal” is ranked last with a value of 0.124. Sensitivity analysis with respect to the weighting parameter μ and distance parameter λ confirms the stability of the ranking pattern. Comparative analysis with seven established MCDM methods under the same T2GSFS environment shows a high degree of consistency, which is further supported by Spearman’s rank correlation coefficients of 0.6 to 0.9 and Kendall’s tau coefficients of 0.4 to 0.8. Furthermore, the ablation study confirms that the importance of the proposed framework’s components across different fuzzy environments and criterion-removal settings. The findings demonstrate that the proposed T2GSFS-based framework is a robust decision-support tool for sustainable PV waste-management planning, while also providing a reliable mechanism to capture the confidence levels of experts through its secondary membership structure.}
}
@article{WANG2026116131,
title = {A novel extended power Muirhead mean operator under linguistic pq-rung ortho-pair fuzzy Z-number with application to health data supplier evaluation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116131},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116131},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015796},
author = {Jing Wang and Junxin Shen and Yuyan Guo},
keywords = {Lpq-ROFZN, Aggregation operators, Muirhead mean operators, Extended power average operators, Health data supplier},
abstract = {With the rapid advancement of healthcare digitalization and data-driven management, selecting high-quality health data suppliers (HDSs) has become a critical multi-attribute group decision-making (MAGDM) problem. However, HDS evaluation is often affected by linguistic uncertainty, dual-parameter fuzzy uncertainty, varying reliability of expert judgments, and distortions caused by extreme or biased assessments. To address these issues, this study proposes a novel MAGDM framework based on the linguistic pq-rung ortho-pair fuzzy Z-number (Lpq-ROFZN). The Lpq-ROFZN representation establishes a tripartite structure that integrates linguistic terms for preference expression, pq-rung ortho-pair sets (pq-ROFSs) for vagueness representation, and Z-numbers for reliability measurement. Building on this representation, a family of Lpq-ROFZN extended power Muirhead mean (Lpq-ROFZNEPMM) aggregation operators, including their weighted and dual forms, is developed. These operators capture attribute interrelationships while mitigating the influence of extreme or biased evaluations. Furthermore, a hybrid subjective-objective weighting mechanism is established by integrating expert opinion with an enhanced CRITIC method. Finally, a multi-stage MAGDM framework is applied to an HDS selection problem. Sensitivity and comparative analyses demonstrate the effectiveness, rationality, and robustness of the proposed framework in generating reliable supplier rankings under complex uncertain information.}
}
@article{PENG2026116152,
title = {An intrusion detection algorithm based on convolutional attention and hyperparameter optimized fusion neural network},
journal = {Applied Soft Computing},
volume = {203},
pages = {116152},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116152},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016005},
author = {Yunfeng Peng and Qi Xu and Jianpo Li and Xiaobei Xu},
keywords = {Intrusion detection, Multi-scale convolutional attention, Convolutional neural networks, Two-layer bidirectional long short-term memory networks, Hyperparameter optimization},
abstract = {Intrusion detection systems (IDS) are crucial in defending digital environments by spotting irregular activities within network traffic. However, existing IDS approaches often suffer from low detection accuracy and poor generalization when faced with high-dimensional, heterogeneous features and diverse attack categories. To address these challenges, this paper proposes a hybrid neural network-based intrusion detection algorithm that integrates convolutional attention mechanisms with hyperparameter optimization. First, a CNN-BiLSTM classifier is proposed by integrating convolutional neural networks (CNN) and two-layer bidirectional long short-term memory networks (BiLSTM) to extract spatial features, model bidirectional temporal dependencies through two BiLSTM layers, and capture long-term temporal patterns, respectively. Second, a multi-scale convolutional attention module is introduced to enhance local feature responsiveness and channel-wise selectivity during the feature extraction process, thereby improving the accuracy and sensitivity of intrusion behavior recognition. In addition, an improved particle swarm optimization (PSO) algorithm is introduced to globally optimize the key hyperparameters of the classifiers, which improves the robustness of the model as well as its adaptability under different data distributions. Finally, extensive experiments conducted on the NSL-KDD, CIC-IDS2017, and UNSW-NB15 datasets demonstrate the effectiveness and superiority of the proposed algorithm.}
}
@article{DING2026116063,
title = {TNPGL: Physics-guided temporal latent representation learning for multi-step lithium-ion battery degradation prediction},
journal = {Applied Soft Computing},
volume = {203},
pages = {116063},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116063},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015115},
author = {Yan Ding and Tongtong Su and Bin Liu and Jinqi Zhu and Ziping Zhao and Yang Liu and Björn W. Schuller and Chenyang Wang},
keywords = {State of health, Physics-guided learning, Multi-step prediction, Uncertainty estimation},
abstract = {Accurate State of Health (SOH) prediction is essential for the reliable operation of lithium-ion batteries. Although physics-guided learning methods have demonstrated improved generalization capability, existing approaches remain limited in modeling temporal dependencies, capturing long-term degradation dynamics, and performing robust multi-step forecasting without explicitly defined physical state variables. To address these limitations, we propose TNPGL (Temporal Neural Networks and Physics-Guided Learning), a temporal–physical synergy framework that integrates temporal representation learning with degradation-aware physical regularization. Unlike conventional physics-informed approaches that rely on predefined governing equations or explicitly observable physical variables, TNPGL does not assume that hidden states correspond to directly measurable physical quantities. Instead, latent degradation representations are extracted from battery health indicators and transformed into feature-space degradation dynamics through a chain-rule-based state-space mapping, enabling temporal latent features to participate in physics-guided regularization without requiring explicit electrochemical states. To improve physical consistency, two hierarchical constraints, Lf and LfX, are introduced. Lf regularizes state-level degradation evolution by aligning feature-space SOH derivatives with learned degradation dynamics, while LfX stabilizes the residual field through residual-gradient regularization, forming a progressive state-to-structure constraint mechanism. Experimental results show that TNPGL demonstrates superior overall performance compared with State-Of-The-Art (SOTA) methods, achieving high multi-step prediction accuracy on the NASA (MAE: 1.485%, RMSE: 2.099%) and CALCE (MAE: 1.479%, RMSE: 2.229%) datasets. Additional experiments on the Oxford dataset further support its cross-dataset generalization capability. An auxiliary post hoc uncertainty analysis based on MC Dropout further evaluates predictive confidence, with confidence levels exceeding 90% on NASA, CALCE, and Oxford.}
}
@article{GENCOGLU2026116176,
title = {An ontology-based model of artificial bee colony (ABC) algorithm and its future directions},
journal = {Applied Soft Computing},
volume = {203},
pages = {116176},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116176},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016248},
author = {Muharrem Tuncay Gençoğlu},
keywords = {Artificial Bee Colony, Swarm Intelligence, Internet of Minds (IoM), Justful Optimization, Ontology-Based Model},
abstract = {This article repositions the Artificial Bee Colony (ABC) algorithm beyond its conventional treatment as a metaheuristic optimization technique by framing it along a three-layer axis of conceptual and methodological maturity. At the first level, ABC is analyzed as an ontology-driven and cognitively inspired model rooted in its biological foundations, specifically the foraging and dance behaviors of honey bee colonies. Intra-colony interactions—such as decision-making, communication, and information sharing—are interpreted through the perspectives of swarm intelligence and preference-vector–based cognitive orientation, explaining the emergence of collective optimization behavior. At the second level, the algorithm gains mathematical rigor through the integration of time-dependent stochastic processes, Markov chains, transition probabilities, entropy, and diversity measures within an information theory based framework. From this standpoint, ABC is no longer viewed only as a search procedure ensuring convergence, but as a formal structure capable of modeling information flow, uncertainty reduction, and collective learning in the solution space. The third level extends the scope of ABC beyond classical engineering optimization problems. The algorithm is situated within a broader value-oriented framework that includes advanced distributed and cognitive systems such as quantum computing, blockchain-based security architectures, cyber defense ecosystems, secure artificial intelligence (AI), AI safety, and the Internet of Minds (IoM). Within this vision, ABC functions not only as a mathematical tool but also as a conceptual metaphor for fair optimization, distributed decision-making, and cognitive societies. By revisiting the algorithm’s twenty-year evolution, the study offers a conceptual contribution by redefining ABC as an ontology-based decision-making structure composed of roles, states, and relational dynamics. The proposed perspective suggests that the historical evolution of ABC reflects not only improvements in optimization performance but also a progressive expansion of the classes of problems that can be effectively addressed.}
}
@article{ZUO2026116123,
title = {Mixed fleet cold chain in a time-dependent traffic environment: Multi-population hyper-heuristic approach and bi-objective formulations},
journal = {Applied Soft Computing},
volume = {203},
pages = {116123},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116123},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015711},
author = {Qiang Zuo and Longlong Leng},
keywords = {Cold chain logistics, Mixed fleet, Multi-objective hyperheuristic, Multi-population optimization, Time-dependent traffic environment},
abstract = {Urban traffic congestion poses significant challenges to cold chain logistics (CCL) by simultaneously affecting economic, environmental, and social sustainability. This study investigates a low-carbon mixed-fleet location-routing problem for CCL under time-dependent traffic conditions, integrating four key decisions: facility assignment, vehicle routing, station selection, and refrigeration energy management. Two bi-objective models are formulated: the MEC model, which minimizes economic cost and environmental impact, and the MQD model, which minimizes economic cost and quality damage. To solve the problem, Q-learning-based hyper-heuristic frameworks are developed that combine multi-population optimization with adaptive heuristic selection. Computational results show that the proposed method outperforms benchmark algorithms, with average hypervolume improvements of 33.84%, 23.14%, 19.22%, and 83.55% for the MEC model, and 13.36%, 14.10%, 9.00%, and 15.49% for the MQD model, compared with IBEA, NSGA-II, SPEA2, and MOALNS, respectively. Further analyses reveal the effects of fleet composition and traffic congestion on CCL network design. These findings provide useful managerial insights for sustainable urban cold chain logistics planning.}
}
@article{OJEDARUIZ2026116163,
title = {Alternatives to the Laplacian for scalable spectral clustering with group fairness constraints},
journal = {Applied Soft Computing},
volume = {203},
pages = {116163},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116163},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601611X},
author = {Iván Ojeda-Ruiz and Young Ju Lee and Malcolm Dickens and Leonardo Cambisaca},
keywords = {Fairness, Volume constraints, Spectral clustering},
abstract = {Recent research has focused on mitigating algorithmic bias in clustering by incorporating fairness constraints into algorithmic design. Notions such as disparate impact, community cohesion, and cost per population have been implemented to enforce equitable outcomes. Among these, group fairness (balance) ensures that each protected group is proportionally represented within every cluster. However, incorporating balance as a metric of fairness into spectral clustering algorithms has led to computational times that could be improved. This study aims to enhance the efficiency of spectral clustering algorithms by reformulating the constrained optimization problem using a new formulation derived from the Lagrangian method and the Sherman-Morrison-Woodbury (SMW) identity, resulting in the Fair-SMW algorithm. Fair-SMW employs three alternatives to the Laplacian matrix with different eigenvalue ranges to generate multiple variations of Fair-SMW, achieving clustering solutions with comparable balance to existing algorithms while offering improved runtime performance. We present the results of Fair-SMW, evaluated using the Stochastic Block Model (SBM) to measure both runtime efficiency and balance across real-world network datasets, including LastFM, FacebookNet, Deezer, and German. We achieve an improvement in computation time that is twice as fast as the state-of-the-art, and it is also flexible enough to achieve comparable balance.}
}