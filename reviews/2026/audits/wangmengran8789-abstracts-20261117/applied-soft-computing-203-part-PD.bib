@article{LI2026116387,
title = {Online high-precision prediction method for injection molding product weight by integrating time-series/non-time-series mixed features and feature attention mechanism},
journal = {Applied Soft Computing},
volume = {203},
pages = {116387},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116387},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626018351},
author = {Maoyuan Li and Sihong Li and Guancheng Shen and Yun Zhang and Huamin Zhou},
keywords = {Injection molding, Product weight prediction, Online quality monitoring, Mixed features, Attention mechanism},
abstract = {Injection molding is a widely used, high-throughput manufacturing process for producing precise plastic products, yet ensuring consistent part quality remains challenging in fast-paced industrial environments. Small deviations in product weight can indicate unstable molding conditions and may lead to defects such as warpage, sink marks, or internal stress accumulation. To address these challenges, this study proposes a mixed feature attention-artificial neural network (MFA-ANN) model for high-precision online prediction of product weight. The model explicitly distinguishes between dynamic time-series features and non-time-series features, capturing the heterogeneous characteristics of injection molding data. The proposed model achieved an RMSE of 0.0281 g, corresponding to approximately 0.067% of the nominal product weight, demonstrating its capability to capture small weight fluctuations during stable production. Experimental validation under a stable industrial production condition demonstrates that the proposed approach can improve the online prediction accuracy of product weight for the tested machine-product-material combination, providing a useful basis for process monitoring in injection molding. The framework provides a practical solution for intelligent manufacturing and improved reliability in injection molding applications.}
}
@article{YE2026116160,
title = {EAF-Net: Fine-grained skin cancer image classification network with agent attention},
journal = {Applied Soft Computing},
volume = {203},
pages = {116160},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116160},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601608X},
author = {Wenqian Ye and Yi Sun},
keywords = {EAF-Net, Agent attention, Warm up-cosine annealing, Graph attention networks, Skin cancer identification},
abstract = {To address challenges in fine-grained skin cancer image classification—ambiguous lesion features, hair occlusion, and balancing computational cost with accuracy—this study proposes EAF-Net, a classification network integrating the Agent Attention mechanism. Using ResNet50 as its backbone, EAF-Net alleviates gradient vanishing via residual connections and adapts to scarce annotated medical data through ImageNet transfer learning. The Agent Attention mechanism enhances fine-grained lesion feature capture with linear complexity, while the “black hat operation + Telea algorithm” preprocessing removes hair occlusion—repaired images have 0.917 average SSIM, 0.958 average Dice coefficient, and 0.7% artifact rate. Experiments were conducted on the HAM10000 dataset, which contains 10,015 dermoscopic images covering 7 types of pigmented lesions and was split into three subsets: 80% for training, 10% for validation, and 10% for testing. Results show that EAF-Net outperforms mainstream models, achieving a classification accuracy of 0.83 for melanoma, 0.93 for melanocytic nevi (NV), and 0.88 for basal cell carcinoma. Its overall accuracy is 5.78% higher than VGG19 (87.03%) and 4.79% higher than MobileNetV2 (88.42%); it improves NV-malignant melanoma distinction from ResNet50’s 0.83 to 0.87, and cuts parameters by over 40% vs. Swin-B. This work supports dermatological clinical auxiliary diagnosis and offers a new approach for medical image fine-grained classification.}
}
@article{ZHANG2026116305,
title = {ConvLSTM-based modeling of magnetic domain evolution in electric motor core materials},
journal = {Applied Soft Computing},
volume = {203},
pages = {116305},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116305},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017539},
author = {Hao Zhang and Qingxin Yang and Yifan Chen and Yongjian Li and Changgeng Zhang},
keywords = {Magnetic Domain, Machine Learning, Magnetization process, Microstructure},
abstract = {Traditional modeling of energy loss in magnetic materials for electric machines primarily relies on empirical models based on macroscopic magnetic parameters. However, when subjected to transient excitations from modern control strategies, these models often fail to capture the dynamic magnetic response, since these models do not sufficiently represent the intrinsic, microstructure-dependent magnetization processes. The spatiotemporal evolution of magnetic domains serves as a crucial bridge linking microscopic magnetic mechanisms to macroscopic energy loss, playing a key role in understanding internal energy dissipation processes. In response to this challenge, this work presents a ConvLSTM-based predictive framework that combines convolutional feature extraction with temporal sequence modeling to predict the evolution of intrinsic magnetization states from historical magnetic domain patterns. The results show that the framework can predict magnetic domain motion patterns and magnetization processes under complex spatiotemporal conditions, and that incorporating magnetic domain boundary and grayscale texture features improves the prediction accuracy by up to 13.01%. This approach provides a robust tool for analyzing magnetic microstructures, offering valuable insights for optimizing magnetic material properties and enhancing the performance of electric motors.}
}
@article{KIM2026116333,
title = {Contrastive feature alignment in heterogeneous temporal modalities for time series classification},
journal = {Applied Soft Computing},
volume = {203},
pages = {116333},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116333},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017813},
author = {Yohan Kim and Younghoon Lee},
keywords = {Gramian angular difference field, Time series classification, Contrastive learning, Transformer},
abstract = {Time series data, characterized by complex temporal dependencies and diverse structural patterns, are widely encountered in real-world domains such as healthcare, manufacturing, and finance. Accurate time series classification (TSC) requires models capable of capturing both fine-grained local dynamics and long-range global relationships. While sequence-based models have been predominantly employed for TSC, they often struggle to effectively model global structural patterns. Conversely, image-based transformations such as the Gramian Angular Field (GAF) enable temporal signals to be represented spatially, allowing vision-based architectures to capture complementary structural information. However, approaches relying solely on either modality may fail to fully exploit complementary information, and existing multimodal methods frequently lack an explicit alignment mechanism between temporal and spatial representations. To address these limitations, we propose a hybrid framework that performs patch-level contrastive feature alignment between a Transformer-based temporal encoder and a Vision Transformer (ViT)-based spatial encoder. By converting time series into Gramian Angular Difference Field (GADF) images and explicitly aligning temporally corresponding Transformer tokens and image patches, the proposed model jointly captures temporal dynamics and spatial structural patterns. The patch-level contrastive objective encourages fine-grained cross-modal correspondence between the heterogeneous representations. Extensive experiments on 127 benchmark datasets from the UCR archive demonstrate the effectiveness of the proposed approach. Our method achieves an average classification accuracy of 0.8298 and the best average rank of 3.30 among state-of-the-art baselines. Controlled ablation studies further show that patch-level alignment improves performance over the same multimodal architecture without contrastive learning and substantially outperforms global contrastive alignment, highlighting the importance of alignment granularity. These results demonstrate the effectiveness of structured cross-modal feature alignment and provide a promising direction for multimodal time series classification.}
}
@article{AHMADI2026116394,
title = {Temporal fusion transformer and deep state-space model for hydrogen-integrated power systems},
journal = {Applied Soft Computing},
volume = {203},
pages = {116394},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116394},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626018429},
author = {Mehrnaz Ahmadi and Mehdi Khashei},
keywords = {Data decomposition approaches, Probabilistic residual modeling, Multi-resolution fusion, Hydrogen demand modeling, Temporal fusion transformer, Deep state-space model},
abstract = {Hydrogen is becoming a key element of modern power grids by enabling large-scale energy storage, renewable integration, sector coupling, and low-carbon operation. In hydrogen-integrated power networks, accurate hydrogen-demand modeling is essential for reliable scheduling, storage management, and system operation. To address this challenge, this study proposes a hybrid forecasting framework that combines energy-driven multistage decomposition, probabilistic residual modeling, and a learning head that selects either a Temporal Fusion Transformer (TFT) or a Deep State-Space Model (DSSM) for each component. The framework decomposes each series into intrinsic mode functions (IMFs) and a residual component, then iteratively refines the IMFs through feedback coupling and energy-guided updates to suppress noise while preserving dynamics. A Gaussian model enhanced by meta-learning over multiple kernels captures uncertainty, drift, and long-horizon structure. Hierarchical multi-resolution fusion integrates temporal and spectral cues, while the hybrid TFT-DSSM head generates calibrated quantile forecasts for each component and recombines them into final predictions. Empirical validation on two energy-related datasets confirmed the effectiveness of the proposed framework. On the hydrogen bus demand dataset, the model achieved an MAE of 2.11, an MSE of 35.80, an RMSE of 5.98, and a MAPE of 14.07%. On the Brent crude oil price dataset, the proposed model reduced test errors by 56.60% in MAE, 81.56% in MSE, 56.58% in MAPE, and 57.09% in RMSE relative to the baseline TFT-DSSM. Compared with EEMD-TFT-DSSM, it further improved forecasting accuracy, yielding reductions of 17.70% in MAE, 29.70% in MSE, 19.74% in MAPE, and 15.97% in RMSE.}
}
@article{WU2026116313,
title = {Robust fault diagnosis for nuclear reactors against adversarial attacks: A quadratic-residual spiking neural network approach},
journal = {Applied Soft Computing},
volume = {203},
pages = {116313},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116313},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017618},
author = {Xuezhi Wu and Zhongshu Chen and Yongqi Ding and Fu Wang and Enrico Zio and Lin Zuo and Yu Liu},
keywords = {Control rod drive mechanism, Fault diagnosis, Spiking neural network, Adversarial training, Nuclear safety},
abstract = {Control rod drive mechanism (CRDM) is the only routinely actuated component in nuclear reactor core and directly regulates reactor power through precise control rod position. Owing to the safety-critical requirements, CRDM fault diagnosis must satisfy robustness under adverse perturbations, not just achieve high accuracy under ideal laboratory conditions. Since CRDM vibration signals are transient-rich and event-driven, they can be strongly affected by startup transients, load-following operations, thermal-hydraulic fluctuations, and white-box adversarial perturbations. Although continuous models can achieve high accuracy on clean datasets, their high input-output sensitivity and continuous activation functions make them vulnerable to gradient-aligned adversarial perturbations. Such fragility conflicts with the robustness standards required for nuclear instrumentation. To address this issue, a white-box adversarial robust training and inference framework is put forth. The framework has three novel features. First, we design a spiking neural network (Adversarial-SNN) framework in which the classifier and attacker share a backbone, thereby eliminating the need for a separate adversarial discriminator. This design simplifies the adversarial training pipeline and reduces parameter redundancy. Second, the spiking backbone combines quadratic residual pathways with competitive weight sharing, which reduces empirical input-output sensitivity. Third, the quadratic residual attacker acts as the gradient-based perturbation branch to probe the classifier decision stability. Extensive experiments on both CRDM and public datasets show that Adversarial-SNN preserves competitive clean-data accuracy under severe perturbations.}
}
@article{LI2026116402,
title = {A spatial-temporal attention ConvNeXt autoencoder for intermittent fault detection and root cause tracing in industrial processes},
journal = {Applied Soft Computing},
volume = {203},
pages = {116402},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116402},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626018508},
author = {Jian Li and Xuefeng Yan},
keywords = {Process monitoring, Intermittent fault, ConvNeXt, Spatial-temporal attention mechanism, Root cause tracing},
abstract = {Intermittent faults in industrial processes present significant monitoring challenges due to their transient, stochastic, and highly concealed nature. These characteristics often obscure dynamic evolutions and spatial-temporal correlations, rendering traditional monitoring methods ineffective. To address these issues, this paper proposes a Spatial-Temporal Attention ConvNeXt Autoencoder (STAC-AE) for the detection and root cause tracing of intermittent faults. Within this framework, a ConvNeXt-based deep autoencoder is first constructed to extract robust features from high-dimensional data. A Spatial-Temporal Attention (STA) mechanism is then integrated to jointly model temporal dynamics and inter-variable dependencies, improving the model's sensitivity to early and weak fault signals. Furthermore, to overcome the signal masking effect, a Dynamic Variable Weighting (DVW) strategy is developed. By adaptively amplifying the statistical deviations of critical variables, this strategy enables precise root cause identification. Extensive evaluations across a numerical simulation, the Tennessee Eastman (TE) process, and the BSM1 benchmark validate the empirical superiority of STAC-AE. Notably, in the highly coupled TE process, it yields an average intermittent fault detection rate of 57.9% and a persistent detection rate of 92.1% with a strictly controlled false alarm rate (FAR) of 4.1%. Furthermore, it achieves a zero FAR alongside the fastest real-time response in the BSM1 process. Finally, the proposed framework provides physical interpretability by isolating fault propagation paths and root causes.}
}
@article{MARTINEZSANCHEZ2026116232,
title = {Finite-time neuro-modeling of complex reaction systems using robust exact differentiation: A data-driven application to non-ideal polymerization},
journal = {Applied Soft Computing},
volume = {203},
pages = {116232},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116232},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016807},
author = {Iririana {Martínez Sánchez} and Iván Salgado and Ricardo {Santillán Pérez} and Iliana {Fuentes Camargo} and Julia Liliana {Rodríguez Santillán}},
keywords = {2-vinylpyridine (2VP), 4-vinylpyridine (4VP), Kinetic modeling, Data-driven neural modeling, Robust exact differentiator, Finite-time differential neural network},
abstract = {This work presents a hybrid soft-computing framework for dynamic identification from sparse and noisy experimental measurements. The method combines a finite-time differential neural network (FTDNN) with a Uniform Robust Exact Differentiator (URED) to reconstruct conversion trajectories, estimate reaction rates, and identify compact kinetic models. The framework was first evaluated using experimental free-radical polymerization data for 2-vinylpyridine (2VP) and 4-vinylpyridine (4VP) at 55, 65, and 75 ∘C. A synthetic database derived from these experiments was then used to assess reconstruction accuracy, noise attenuation, derivative estimation, sensitivity to initial conditions, and kinetic-parameter recovery under clean and noisy conditions. The FTDNN achieved an overall R2 of 0.9990 and reduced the reconstruction RMSE by 41.6% relative to the noisy input, while STA and URED clearly outperformed Euler differentiation in the presence of noise. The complete FTDNN–URED method also preserved accurate recovery of the nonlinear kinetic parameters. External evaluation was performed with independent acrylic-acid polymerization datasets covering non-ionized, partially ionized, and fully ionized conditions. The proposed compact models reproduced these profiles with high accuracy and yielded a blind prediction with R2=0.9555 for an intermediate ionization condition excluded from parameter interpolation. These results indicate that the framework provides a consistent reconstruction and identification procedure within the noise levels, initial-condition perturbations, and polymerization systems evaluated in this study.}
}
@article{CHAKHRIT2026116285,
title = {Multi-criteria evaluation of low-carbon steelmaking technologies using an AHP–Fuzzy TOPSIS framework},
journal = {Applied Soft Computing},
volume = {203},
pages = {116285},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116285},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017333},
author = {Ammar Chakhrit and Nour {El Houda Benharkat} and Mohammed Chennoufi and Mohammed Wadi},
keywords = {Emission reduction, Steel industry, AHP, Fuzzy TOPSIS, CO emissions, Energy Consumption},
abstract = {In the context of global climate change and the urgent need for cleaner industrial systems, the iron and steel sector remains one of the largest contributors to global CO₂ emissions. Advancing cleaner production in this sector requires not only technological innovation but also robust decision-support tools capable of guiding sustainable industrial transformation. This study systematically reviews global low-carbon steelmaking technologies from a cleaner production perspective, emphasizing energy efficiency, emission prevention, and resource optimization. Furthermore, the article not only reviews these global technologies but also develops and applies comprehensive decision-making framework incorporating domain-specific evaluation criteria and a technology prioritization procedure, applying established AHP and Fuzzy TOPSIS methods. The aim is to provide a clear and transparent evaluation procedure for comparing different decarbonization strategies based on economic, environmental, and technical considerations. The findings highlight the most promising technologies for guiding industrial planning and supporting policymakers and industry stakeholders in building effective and sustainable decarbonization roadmaps for the steel sector. The results indicate that Hydrogen-based DRI stands out as the most impactful long-term solution with closeness scores of 0.018, while Scrap + EAF emerges as the most practical and immediately deployable pathway with closeness value of 0.013. Overall, the analysis demonstrates that a portfolio-based approach rather than reliance on a single technology is essential to achieving an effective and balanced transition toward low-carbon steelmaking. This research demonstrates the application of an integrated decision-making framework and evaluation procedure that can be extended to other hard-to-abate sectors, facilitating informed progress toward sustainable industrial transformation.}
}
@article{WANG2026116301,
title = {IncepKAN: InceptionTime model and Kolmogorov Arnold network for multi-people activities, locations, and identities recognition based on WiFi signals},
journal = {Applied Soft Computing},
volume = {203},
pages = {116301},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116301},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017497},
author = {Jindi Wang and Sike Ni and Mohammed A.A. Al-qaness},
keywords = {Deep learning, Human activity recognition, WiFi signals, Channel state information, Kolmogorov-Arnold network},
abstract = {Recently, Channel State Information (CSI) of WiFi signals has been used to track human movements and activities in indoor environments. This technology is expected to recognize human activities without the need for additional sensors or cameras, thereby addressing privacy concerns and reducing deployment costs. However, recent research has mainly focused on single-user activity recognition, which sometimes only applies to practical scenarios. Therefore, this paper proposes a new deep-learning model for multi-people activity recognition, identification (ID) recognition, and location tracking. This model integrates advanced technologies such as InceptionTime model and Kolmogorov Arnold Network (KAN). The InceptionTime model effectively captures both long-term and short-term patterns in WiFi signals through its multi-scale feature extraction capability. KAN uses learnable edge weight functions instead of traditional linear weights, exhibiting better performance compared to Multi-Layer Perceptrons (MLPs). The combination of these technologies enables our model to accurately identify identity, location, and activity in multi-user environments, significantly improving recognition accuracy and computational efficiency. We conducted extensive experiments on the public WiMANS dataset, where the proposed model showed competitive performance under different network conditions and environments. In a total of 18 scenarios, our proposed model performed better than the basic model in 13 scenarios. Especially in the 2.4 Gigahertz (GHz) frequency band, there was a significant improvement in identity recognition and location recognition, with an average increase of 4%-7% compared to the benchmark model.}
}
@article{ZHU2026116354,
title = {R2-L2 optimized physics-informed neural network for chloride diffusion in concrete with noise/sparse/incomplete experimental data},
journal = {Applied Soft Computing},
volume = {203},
pages = {116354},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116354},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626018028},
author = {Hao-Yu Zhu and Jia-Yue Wu and Cheng-Yang Zhang and Tian-Ren Chen and Si-Le Sun and Ming-Zhi Guo and Yan Zhang},
keywords = {Physics-informed neural networks, Chloride diffusion, Generative AI-assisted modeling, Sparse and noisy experimental data, R-L2 coupled training strategy, Open source, Smoothness Mismatch Index},
abstract = {Accurately predicting chloride diffusion is essential for assessing the durability of reinforced concrete structures. However, experimental detection methods are often subjected to operational complexity, limited spatial resolution, and potential measurement uncertainty. Such acquired raw data are often scarce and unreliable. Although PINNs are suitable for incorporating physical constraints into data-limited modelling, their direct application to real engineering data remains challenging. As shown in Fig 8(b), classical PINN trained with such “dirty” data, is prone to overfitting, which dramatically undermines the reliability of extrapolative predictions. To address the challenges associated with noisy/incomplete/sparse experimental datasets and also to overcome the overfitting limitation, this study proposed an optimized PINN framework with an R2-L2 coupled training strategy. The results showed that even under highly sparse conditions (6 time intervals with 15 spatial points each), incomplete datasets (excluding unreliable near-surface measurements within 0–4 mm), and experimental noise up to 10%, the optimized R2-L2 PINN can still achieve accurate prediction of concentration and time-varying diffusion coefficients. Its effectiveness and stability were repeatedly verified through ablation experiments, repeated random-seed tests, and external dataset validation. Furthermore, AI-assisted code development was investigated to facilitate cross-disciplinary application, proving the strength of DeepSeek in code generation and dataset-format handling. In conclusion, this study advanced the practical applicability of PINN-based modeling and realized the balance of predictive accuracy and model robustness under imperfect data conditions.}
}
@article{SUN2026116309,
title = {LCGNet: A lightweight context-aware global-local network for multi-step ship heave prediction},
journal = {Applied Soft Computing},
volume = {203},
pages = {116309},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116309},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017576},
author = {Yiheng Sun and Meng Chen and Haoyang Han and Xinyuan Wang and Shizhen Li and Wenzhuo Shi},
keywords = {Ship heave prediction, Lightweight model, Deep learning, Active heave compensation},
abstract = {Ship heave motion plays a critical role in the control performance of active heave compensation systems, and its accurate prediction is essential for reducing compensation errors and extending safe operational windows. However, heave signals driven by stochastic wave excitation exhibit pronounced multi-scale temporal characteristics and strong non-stationarity. Existing deep learning methods typically rely on large parameter scales and high computational complexity to model these properties, which limits their applicability for real-time deployment on shipborne or platform-level systems. To address this issue, this paper proposes a lightweight context-aware global-local network (LCGNet) for multi-step ship heave prediction. The model first introduces a context-aware patch embedding module that progressively compresses the temporal axis while aggregating cross-subsegment temporal dependencies, enabling efficient contextual representation. Subsequently, a dual-path multi-scale feature extraction module is designed to jointly capture global evolution trends through full-window statistical recalibration and short-term dynamic variations via local multi-scale morphological modeling. The resulting complementary features are then fused to generate predictive representations. Experimental results on simulated data show that, for a prediction horizon of 1.6 s, the proposed model achieves an RMSE of 0.0085 m, an MAE of 0.0058 m, an SMAPE of 4.9283%, and an R² of 0.9998, while requiring only 0.17 M FLOPs, 30,625 parameters, and a model size of 0.12 MB. On real shipborne data, the model achieves an average RMSE of 0.0111 ± 0.0003 m and an MAE of 0.0081 ± 0.0002 m over ten independent fine-tuning runs with different random seeds, indicating stable simulation-to-real adaptation on the investigated dataset. Furthermore, the quantized model occupies only 0.08 MB and achieves a single-sample inference time of 26.1 ± 0.8 μs on an RV1126 edge-computing platform, demonstrating the feasibility of real-time edge inference in shipborne or platform-level systems.}
}
@article{ZHU2026116317,
title = {DISCO: Component-wise update-period scheduling for medical image fine-tuning},
journal = {Applied Soft Computing},
volume = {203},
pages = {116317},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116317},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017655},
author = {Hanruo Zhu and Si-Yuan Lu and Ziquan Zhu},
keywords = {Medical image classification, Period-aware optimization, Computer-aided diagnosis},
abstract = {Fine-tuning pretrained vision models is widely used for medical image classification. In conventional full fine-tuning and parameter-efficient fine-tuning (PEFT) pipelines, parameters selected for adaptation are commonly optimized under a uniform per-step update schedule. We observe that update period critically affects fine-tuning behavior, and that per-step updates are not universally optimal across datasets and architectures. Motivated by this observation, we propose DIScrete COmponent updates (DISCO), a component-wise update-period scheduling framework for medical image fine-tuning. DISCO does not aim to serve as a general-purpose periodic optimizer; instead, it focuses on assigning heterogeneous update periods to functionally distinct lightweight adaptation components. Specifically, DISCO combines a slowly updated Coarse Adaptation Unit (CAU) for stable global adaptation with a faster Multi-period Support Unit (MPU) for fine-grained residual adaptation. These components are optimized through buffered periodic updates with component-specific update triggers, thereby separating the functional role of an adaptation module from its update period. Experiments on eight public medical imaging datasets across four modalities show that DISCO improves both full fine-tuning and PEFT baselines, suggesting that component-wise update-period scheduling is a useful and previously less emphasized design choice for medical image fine-tuning.}
}
@article{NGUYEN2026116328,
title = {Bridging the data gap: A genetic algorithm approach using inverse by python implementation of eye movement metrics & visualizations logic},
journal = {Applied Soft Computing},
volume = {203},
pages = {116328},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116328},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601776X},
author = {Thi Quynh Hoa Nguyen and Duy Hai Nguyen and Gia Loc Tran and Thanh Ha Le and Thi Duyen Ngo},
keywords = {Eye tracking, Synthetic data generation, Genetic algorithms, Inverse PeyeMMV, Biological validity},
abstract = {The advancement of resilient clinical eye tracking architectures is presently impeded by data paucity, stringent privacy regulations, and an inherent dichotomy between algorithmic conformity and biophysical fidelity. Conventional deterministic synthesis paradigms exhibit a fundamental deficit in physiological variance, whereas stochastic alternatives persistently breach the strict spatiotemporal parameters intrinsic to standard fixation filters. To reconcile these methodological constraints, this research conceptualizes gaze trajectory synthesis as an inverse problem. The study introduces an evolutionary computational framework that deploys a Genetic Algorithm to systematically optimize the structural configurations of a Fractional Brownian Motion generator. This mechanism adeptly navigates the discrete spatial tolerance boundaries characteristic of established classification algorithms such as PeyeMMV. Empirical appraisals utilizing the ETDD70 corpus substantiate that this evolutionary methodology successfully retains the fundamental spectral density inherent in fixational ocular dynamics. Furthermore, clinical corroboration executed through a synthetic training and empirical testing paradigm validates the preservation of critical nonlinear decision boundaries within the generated datasets. Across diverse machine learning configurations, the data synthesized via this evolutionary framework demonstrated superior predictive efficacy compared to both stochastic and deterministic baselines, showing exceptional proficiency with classifiers highly sensitive to marginal boundaries. By delivering a scalable and contextually specific data augmentation protocol, this approach establishes a rigorous methodology for training sophisticated behavioral models while maintaining absolute compliance with biometric confidentiality mandates.}
}
@article{NOH2026116349,
title = {Real-time physics-informed reconstruction of transient fields using sensor guidance and higher-order time differentiation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116349},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116349},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017977},
author = {Hong-Kyun Noh and Jeong-Hoon Park and Minseok Choi and Jae Hyuk Lim},
keywords = {Physics-Informed Neural Networks, Surrogate model, Higher-order time differentiation, Temporal consistency, Sparse sensor data},
abstract = {This study proposes a Fixed-Time-Increment Physics-Informed Neural Network-Based Surrogate Model (FTI-PBSM) for real-time reconstruction of transient solutions to time-dependent Partial Differential Equations (PDEs) from sparse sensor measurements. In many practical settings, sensor data are available as time-series measurements that inherently encode temporal information. Leveraging this property, ordered sensor histories sampled on a uniform temporal grid are used as an implicit surrogate for the time coordinate, enabling a time-free input representation. Consequently, the time coordinate is removed from the network input, and temporal derivatives are computed using fixed-time-increment numerical differentiation instead of automatic differentiation. Importantly, the fixed-time increment is used only to construct the physics residual during training. Once the sensor vector at an arbitrary target time is available, the trained model reconstructs the corresponding state in real time through a single forward pass. This formulation imposes increment-based temporal consistency, thereby simplifying the network architecture and reducing training cost by eliminating backpropagation through time. Four representative PDE benchmarks covering linear transport, diffusion–reaction dynamics, nonlinear dispersive waves, and phase-field evolution were examined through a series of studies on accuracy, identifiability, convergence behavior, and stability under various extrapolation conditions, including sensor noise and practical sensing perturbations such as calibration offsets, bias drift, and asynchronous delays. The results show accurate full-field reconstruction, reliable generalization in interpolation and moderately extrapolative parameter regimes, and millisecond-level inference on both GPU and CPU, while also identifying limitations in strongly nonlinear or sharp-interface regimes.}
}
@article{HSIEH2026116252,
title = {DeReFusion: A controlled comparison of soft computing fusion strategies for financial time series forecasting via a decomposition-residual architecture},
journal = {Applied Soft Computing},
volume = {203},
pages = {116252},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116252},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601700X},
author = {Chih-Chien Hsieh and Mu-Yen Chen},
keywords = {Financial time series forecasting, Fusion strategy comparison, Decomposition–residual architecture, Reversible instance normalization, Hybrid neural network, Soft computing},
abstract = {In financial forecasting, a hybrid system is only as good as the way its branches are combined, yet few studies compare fusion strategies under controlled conditions. This study addresses that gap through DeReFusion, a decomposition–residual framework that serves as a controlled testbed for comparing fusion strategies under a fixed architecture: a DLinear branch handles the linear component through seasonal-trend decomposition, an LSTM-Transformer residual branch handles the nonlinear dynamics, RevIN places the two on a common scale, and a parameter-free additive operator combines them. On 10 assets spanning individual stocks, indices, cryptocurrencies, and foreign exchange (2016–2025), this study compares three families of fusion operators against 10 benchmarks, with significance testing and trading backtests. Parameter-free addition beats parameterized gating. With only about 26k parameters, DeReFusion joins the statistically leading group and clearly outperforms heavyweight attention models, while longer look-back windows are associated with higher errors on the assets and settings studied, a pattern consistent with weak long-term memory. The economic results tell a different story: directional accuracy stays close to random, and once costs are included the model fails to beat buy-and-hold. The statistical edge therefore does not become economic value, in line with the efficient market hypothesis. What makes the model competitive is an inductive bias matched to the structure of the series, not added capacity, and statistical and economic value must be judged separately.}
}
@article{CHENG2026116273,
title = {Graph-based collaborative multi-agent deep reinforcement learning for reconfigurable job shop scheduling},
journal = {Applied Soft Computing},
volume = {203},
pages = {116273},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116273},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017217},
author = {Lixin Cheng and Shujun Yu},
keywords = {Reconfigurable job shop scheduling, Multi-agent deep reinforcement learning, Heterogeneous graph, Collaborative learning framework, Rule mining},
abstract = {Dynamically reconfiguring machines to accommodate more task types is critical for manufacturers adapting to personalized customization. Thus, this paper addresses the job shop scheduling problem with machine function reconfiguration, while accounting for constraints on limited auxiliary modules and limited extended processing functions. A mixed-integer linear programming model considering the supportability of processing functions and the availability of limited and shareable auxiliary modules is formulated. To solve this problem efficiently, a graph-based collaborative multi-agent deep reinforcement learning model (CG-DRL) is developed, in which two graph models are designed for job scheduling and machine function reconfiguration, respectively, and a collaborative duel agent learning framework considering prior decision knowledge learned from the opposite agent is proposed to guide state design. A rule-based initial replay buffer is created to reduce meaningless exploration by building structured experience data from the state-specific decision pattern knowledge hidden in gene expression programming-discovered problem-specific rules. Besides, a reward-based decision space reducer is designed to identify key decision genes and inherit good prior decision genes to cut computation and retrain poor ones for better performance. Experiments prove that both the proposed replay buffer creation and decision space reduction mechanisms are effective. By integrating these mechanisms, the proposed CG-DRL significantly outperforms other baselines.}
}