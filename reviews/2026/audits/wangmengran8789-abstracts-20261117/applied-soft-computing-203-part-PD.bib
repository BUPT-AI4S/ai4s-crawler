@article{MEEM2026116261,
title = {Authorship-aware fake news detection using hierarchical meta-learning with transformer-based text features},
journal = {Applied Soft Computing},
volume = {203},
pages = {116261},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116261},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017096},
author = {Subrina Jahan Meem and Md Samsuddoha and Salman Jahan Momo and Md Erfan and Md Manjur Ahmed},
keywords = {Fake news detection, AI-generated text detection, Hierarchical classification, Political misinformation, Feature fusion, Hybrid model},
abstract = {The spread of misinformation and the rapid evolution of AI-generated content pose an unprecedented dual threat to information integrity. The existing approaches to detecting fake news and AI-generated text treat these two as independent issues, which do not account for the fact that AI-generated text may be factual or deliberately misleading. This study introduces a four-way hierarchical classification framework that can simultaneously classify content authorship as human or AI and veracity as real or fake for political statements. The framework uses a two-stage architecture in which the first stage is used to detect authorship to route content and the second stage applies specialized veracity classifiers on each type of content. The method is primarily text-centric and requires no external knowledge sources, speaker credibility profiles, or social propagation context. The AI-generated versions of the statements produced by four language models including GPT-4o-mini, Gemini 1.5 Flash, DeepSeek-V3, and Claude-3-Haiku were used to construct a dataset of 20,276 political statements augmented to the LIAR benchmark. The classification model combines engineered linguistic features and fine-tuned transformer representations using DeBERTa-v3-base and RoBERTa-base through a meta-learning fusion method. Experimental analysis shows high performance on all the pipeline stages. Authorship detection has 91.72% accuracy, and classification of veracity shows notable asymmetry with 83.51% accuracy on AI-generated content and 70.34% on human-written content. The integrated pipeline achieves a four-way macro-F1 of 0.697 and exact accuracy of 70.36%, demonstrating the feasibility of unified authorship-veracity classification through linguistic analysis, and showing that human-generated false information is more difficult to detect than AI-generated falsehoods.}
}
@article{WANG2026116289,
title = {Adaptive gene interaction regularized elastic net and its application in cancer diagnosis},
journal = {Applied Soft Computing},
volume = {203},
pages = {116289},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116289},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017370},
author = {Yadi Wang and Yulin Xie and Jiaxin Zhang and Jiayong Wang and Hangjun Che and Xin Liao},
keywords = {Cancer diagnosis, Gene selection, Microarray classification, Grouping effect, Adaptive gene interaction},
abstract = {Sparse feature selection methods can select important feature genes from a large number of gene expression data, which are helpful in providing an important reference for cancer diagnosis, microarray classification, and clinical outcome prediction. However, because the number of samples of microarray data is far less than the number of features, the traditional classification method is prone to over-fitting or dimension disaster. In addition, only a few genes are related to tumor production, leading to many redundant and irrelevant noisy genes that may reduce the classification accuracy. This paper proposes an Adaptive Gene Interaction Regularized Elastic Net (AGIREN) model to solve the aforementioned issues. First, we measure the importance of each gene based on the Wilcoxon Rank Sum Test (WRST). Based on the gene importance, we construct adaptive weights and apply an adaptive L1 penalty to remove the noise genes from the model and identify the feature genes. Second, we integrate gene measurements and gene interaction information into the elastic net model to enhance the sparsity of the structure and use the grouping effect to select characteristic genes to reduce redundancy. Finally, the iterative gradient descent algorithm is used to solve the proposed AGIREN model. Experimental results on the real cancer data set obtained from The Cancer Genome Atlas indicate that the proposed model achieves superiority in cancer diagnosis accuracy and gene selection performance.}
}
@article{OUYANG2026116269,
title = {Transformer-based integrated prediction model for copper converter blowing endpoint and composition},
journal = {Applied Soft Computing},
volume = {203},
pages = {116269},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116269},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017175},
author = {Mengxin Ouyang and Yunhao Qiu and Mingzhou Li and Zhanghao Wan and Jindi Huang and Fuquan Zhang and Shixiong Yuan and Lihua Zhong},
keywords = {Copper converter blowing, Endpoint prediction, Swin-transformer, Deep multi-task learning},
abstract = {Copper converter blowing is a critical operation in the pyrometallurgical refining of blister copper, and accurate endpoint prediction is essential for improving copper yield, ensuring furnace stability, and extending converter service life. To address the limitations of traditional endpoint prediction techniques, an integrated model for simultaneous prediction of blowing endpoints and product composition based on an enhanced Transformer architecture is developed in the present study. By incorporating Reparameterized Vision Transformer (RepViT), Single-Head Vision Transformer (ShViT), and Lightweight Multi-Scale Linear Attention (LiteMLA) modules and embedding these components within a deep multi-task learning framework, the proposed model enables efficient joint prediction of both the composition of blowing products and the remaining time to endpoint. Experimental results show that the model achieves an average prediction error below 0.786% for product composition, an average error of 2.56 min for time-to-endpoint across different stages, and endpoint prediction accuracies of 93.67% and 96.17% for the late slag-forming stage (S2) and late copper-making stage (B2), respectively. These findings demonstrate that the proposed method offers high prediction accuracy and strong practical applicability for intelligent control of copper converter operations.}
}
@article{TUBISHAT2026116358,
title = {Sentiments towards ride-sharing, smart mobility, and delivery apps: An embedding-based analysis using swarm intelligence algorithms},
journal = {Applied Soft Computing},
volume = {203},
pages = {116358},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116358},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626018065},
author = {Mohammad Tubishat and Ahmed Shuhaiber and Ala’ M. Al-Zoubi and Katrina Sundus},
keywords = {Sentiment analysis, Dynamic feature weighting, Embeddings, HHO, Swarm intelligence algorithms},
abstract = {Customer ratings and written reviews provided to smart mobility and food delivery services offer a direct lens into user satisfaction and operational effectiveness. Nevertheless, the task of sentiment extraction from this textual data is non-trivial, hampered by linguistic nuances and the demand for powerful feature extraction and model tuning. In this paper, we develop a new framework called Dynamic-bounds Weighted Harris Hawks Optimization–Support Vector Machine (DW-HHO-SVM) that merges contextual semantic representations with an adaptive, bio-inspired optimization technique to achieve superior performance in classifying positive and negative feedback. The framework integrates Doc2Vec, Word2Vec, TF-IDF, and Hashing embeddings with a dynamically weighted version of Harris Hawks Optimization (HHO) to optimize both feature importance and SVM hyperparameters. The experiments were conducted in two parts: first, HHO was compared to different metaheuristics (GA, PSO, MVO, SSA, and GOA) on a variety of datasets; second, the proposed framework was tested on a number of sentiment analysis embeddings. The first part results showed that HHO always had better accuracy and stability. Dynamic weighting led to incremental improvements, and the best convergence occurred at around 30 iterations. The second part showed that Doc2Vec and DW-HHO together provided the best overall performance, with the highest accuracy and the lowest variance. This study makes four important contributions: (i) the creation of a hybrid sentiment classification framework that combines embeddings with adaptive optimization; (ii) a comparison that demonstrates that HHO outperforms the best metaheuristics; (iii) the introduction of new sentiment datasets created from user reviews of ride-hailing and delivery apps; and (iv) an analysis based on embeddings that highlights the strength of Doc2Vec with DW-HHO. These results show how embedding-driven optimization could be used to enhance sentiment analysis for smart mobility and delivery platforms enabling scalability and reliability.}
}
@article{DENG2026116329,
title = {A multi-objective hot rolling scheduling optimization based on K-modes clustering and surrogate-assisted NSGA-II},
journal = {Applied Soft Computing},
volume = {203},
pages = {116329},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116329},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017771},
author = {Wenchao Deng and Guodong Zhao and Yun Dong and Qingxin Guo},
keywords = {Hot rolling scheduling, Multi-objective optimization, NSGA-II, K-modes clustering, Surrogate-assisted local search},
abstract = {Hot rolling scheduling is a large-scale combinatorial optimization problem with strong coupling between production sequencing and logistics operations. In practical steel manufacturing, mismatches between continuous casting and hot rolling often lead to slab buffering, resulting in longer waiting times, higher changeover costs, and increased transportation costs. To address these issues, this study investigates a coordinated hot rolling scheduling problem incorporating a stacking table as a short-term buffer near the rolling mill. The stacking table temporarily stores slabs for no more than two hours, thereby reducing transportation distance and enhancing production–logistics coordination. An enhanced version of the non-dominated sorting genetic algorithm II (NSGA-II), termed NSGA-II-KS, is proposed, which integrates K-modes clustering with surrogate-assisted local search. Specifically, the K-modes clustering algorithm selects representative solutions to structure the local search, while surrogate models (SVR-based) pre-screen candidate solutions, thereby reducing the number of costly exact fitness evaluations. A dual-layer encoding scheme is designed to ensure solution feasibility under realistic production constraints. Computational experiments demonstrate that NSGA-II-KS consistently outperforms several state-of-the-art methods in convergence, diversity, and computational efficiency.}
}
@article{YE2026116253,
title = {Multilingual misinformation detection in social media: A structured survey of challenges and deep learning solutions},
journal = {Applied Soft Computing},
volume = {203},
pages = {116253},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116253},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017011},
author = {Yunfeng Ye and Wenxuan Chen and Huifang Liu and Zhihui Lun},
keywords = {Social media algorithms, Misinformation detection, Multilingual, Deep learning},
abstract = {The rapid expansion of social media has intensified the cross-border circulation of misinformation, making multilingual misinformation detection (MID) an important research problem. Deep learning (DL) methods offer representation learning and cross-lingual transfer capabilities, but their reliability varies across languages, datasets, and evaluation settings. This structured survey synthesizes DL-based multilingual MID studies published from 2017 through 2025. We organize the literature into CNN-based, recurrent neural network-based, Transformer-based, large language model-based, and hybrid approaches. We also compare multilingual datasets, task formulations, evaluation settings, and deployment constraints. Reported accuracy and F1 values across the surveyed studies range from 15.48% to 97.34% across heterogeneous tasks and datasets. These study-specific values are therefore not directly comparable and should not be interpreted as a universal model ranking. The survey identifies persistent challenges involving low-resource languages (LRLs), cultural and domain shift, data imbalance, multimodal evidence, computational cost, and reproducibility. It concludes with research priorities for language-aware evaluation, transparent reporting, multimodal modeling, and robust real-world deployment.}
}
@article{FU2026116242,
title = {Prediction of organic matter content in plateau red soil using a low-rank multimodal fusion model based on chaotic dynamics characteristics},
journal = {Applied Soft Computing},
volume = {203},
pages = {116242},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116242},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601690X},
author = {Chengbiao Fu and Ruizi Gao and Anhong Tian and Fan Chen},
keywords = {Hyperspectral remote sensing, Soil organic matter, Low-Rank Multimodal Fusion, Chaotic Characteristics, Vegetation Index},
abstract = {Soil organic matter is a key indicator of soil quality, but its high-precision prediction remains a significant challenge. Although hyperspectral remote sensing contains rich physicochemical information, existing methods often struggle to effectively characterize the complex nonlinear dynamic properties within spectral sequences and lack the ability to synergistically model multi-source heterogeneous features. To address this issue, this study proposes a Dual-Stream Low-Rank Interaction Network (DSLI-Net) for soil property inversion, using red soil in Dongchuan District, Yunnan Province, China as the research subject. This method integrates preprocessed hyperspectral data, nine chaotic dynamical features extracted via phase-space reconstruction—including the maximum Lyapunov exponent, correlation dimension, and sample entropy—and soil-sensitive vegetation indices into a unified end-to-end learning framework. DSLI-Net employs a dual-path architecture: two customized low-rank multimodal fusion (LMF) modules separately model the high-order nonlinear interactions between “spectral–chaos” and “spectral–vegetation indices.” Subsequently, the two fusion representations undergo feature concatenation, with a Kolmogorov–Arnold network (KAN) introduced as the regression head to enhance functional approximation capability and model interpretability. The experimental results show that DSLI-Net achieved an R2 of 0.784, an RPD of 2.150, an RPIQ of 3.015, and an RMSE of 9.620 g·kg⁻¹ in soil organic matter prediction, significantly outperforming various traditional machine learning methods—such as random forests and partial least squares regression—as well as several deep learning methods. Further comparative analysis indicates that introducing chaos features and vegetation indices significantly improves model performance. At the same time, the dual-stream fusion strategy employed demonstrated superior predictive accuracy compared to alternative approaches such as a single KAN regressor, a standalone LMF module, or additive fusion, thereby validating the effectiveness of multi-stage collaborative modeling. The ablation experiments further confirmed the contributions of each feature branch and fusion mechanism. This study not only achieved high-precision inversion of soil organic matter but also established a new paradigm for multi-source collaborative modeling and physically informed reinforcement learning of high-dimensional spectral data.}
}
@article{JIA2026116243,
title = {Agentic soft-computing design for axial vibration of time-varying-mass rods via element birth-death digital twins},
journal = {Applied Soft Computing},
volume = {203},
pages = {116243},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116243},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016911},
author = {Dejun Jia and Zaijin You and Ning Wang},
keywords = {Agentic AI, Soft computing, Element birth–death method, Adaptive sampling, Time-varying mass rod},
abstract = {Axial-vibration experiments on time-varying-mass rods are difficult to design because element activation or deactivation creates short transition intervals that fixed space-filling designs can miss. This study proposes Agentic Sampling with Adaptive Surrogate and Element Birth–Death digital twin (ASAS-EBD), a bounded agentic soft-computing method for allocating high-fidelity evaluations around these events. The method couples an element-birth–death finite element digital twin with a graph-temporal surrogate that returns an eight-dimensional Gaussian response distribution. A neuro-fuzzy critic converts predictive uncertainty, reconstructed-equilibrium residual, design-space diversity, transition risk, and evaluation cost into a state-dependent acquisition score. The planner selects one action from Latin-hypercube, Sobol, residual-biased, and transition-risk candidate pools, records the resulting response, updates the surrogate, and repeats until the accuracy-calibration stopping rule or evaluation budget is reached. Evidence comes from a completed in-house rod campaign and its synchronized digital-twin workflow. Three open vibration datasets define additional excitation, noise, modal-range, and mass-state regimes; they are used as regime sources rather than as direct rod-response labels. In the pooled comparison, ASAS-EBD attains 0.98% modal-frequency mean absolute error, 2.85% response normalized root-mean-square error (NRMSE), 0.038 expected calibration error, 0.936 empirical 95% coverage, and termination after 145 high-fidelity evaluations. Relative to the strongest recent physics-informed baseline, the corresponding reductions in NRMSE and evaluations are 22.9% and 23.7%. ASAS-EBD also gives the lowest NRMSE in each of four reported regimes; however, with only four regime-level pairs, the exact two-sided Wilcoxon test is not significant (p=0.125). The results therefore support sample-efficiency on the reported benchmark while leaving multi-fixture and direct external-response validation as necessary next steps.}
}
@article{LUO2026116283,
title = {Assessing interpretability in symbolic regression: A structured review and physics-aware model-selection framework},
journal = {Applied Soft Computing},
volume = {203},
pages = {116283},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116283},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601731X},
author = {Changtong Luo and Guilai Han},
keywords = {Symbolic regression, Soft computing, Interpretability, Physics-informed learning, Model selection, Sensitivity analysis},
abstract = {Symbolic regression (SR) yields explicit predictive expressions, yet algebraic transparency alone does not make a model interpretable for engineering use. This structured review synthesises quantitative approaches to assessing interpretability across evolutionary, sparse, neural-symbolic, and physics-informed SR within soft computing. We organise the assessment landscape into five complementary dimensions: structural and cognitive accessibility; variable attribution and interaction; physical and knowledge consistency; numerical and structural robustness; and human utility and auditability. We further distinguish these interpretability diagnostics from the decision layer, which comprises predictive performance, hard feasibility constraints, Pareto comparison, and preference uncertainty. Building on this distinction, we propose a physics-aware model-selection framework that defines the operating domain, filters candidates against justified non-negotiable constraints, reports disaggregated diagnostics, identifies the feasible Pareto set, and examines ranking sensitivity before expert review. A fully scripted synthetic aerodynamic example compares enumerative symbolic expressions with radial-basis, sparse, rule-based, and theory-constrained baselines using independent training, validation, and test sets. The physics-aware enumerative expression achieves the lowest test error and passes the declared boundary and monotonicity checks. Nevertheless, it is not a preference-invariant winner: varying defensible weights, normalisation scales, and feasibility thresholds changes the leading model. These findings show that predictive accuracy can inform deployment decisions but is neither evidence of interpretability nor a substitute for physical and human-centred assessment. The proposed workflow provides a reproducible and auditable basis for selecting symbolic models without equating brevity, explicitness, or accuracy with engineering trustworthiness.}
}
@article{FENG2026116304,
title = {Structural semantic-aware source-free unsupervised domain adaptation for arrhythmia classification},
journal = {Applied Soft Computing},
volume = {203},
pages = {116304},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116304},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017527},
author = {Panpan Feng and Shuaibo Zhang and Tianshun Wang and Yisheng Zhu and Jie Fu},
keywords = {Arrhythmia classification, Source-free unsupervised domain adaptation, Domain-invariant representation, Pseudo-labeling},
abstract = {Electrocardiogram (ECG) is routinely used by medical personnel to detect electrical cardiac events, especially for arrhythmias. Numerous deep learning-based attempts have been made for intelligent classification, achieving state-of-the-art performance. However, these efforts often face the challenge of domain shifts, which arise from significant variability in the characteristics of ECG signals. Furthermore, given the significant privacy concerns associated with ECG data, recent source-free unsupervised domain adaptation (SFUDA) methods have emerged—they leverage pre-trained source models instead of the source data and combine them with unlabeled target data to alleviate domain shifts. Inspired by the inherent characteristics of ECGs (i.e., despite individual differences in waveform characteristics, ECGs share common P-QRS-T components), this paper incorporates domain-invariant and local-global structural semantic-aware knowledge for source-free unsupervised arrhythmia classification. Specifically, to explore domain-invariant representations, a multi-expert voting and threshold filtering strategy is first exploited. Secondly, to extract reliable target-specific semantic information, we propose a target-oriented pseudo-labeling strategy that leverages local-global structural knowledge. Additionally, considering the class-imbalanced target distribution caused by varying incidence rates of cardiovascular diseases, this paper introduces an intra-inter structural regularization term for enhancing data diversity and improving model generalization. The effectiveness of the proposed method is validated based on numerical experiments, demonstrating that it consistently exceeds existing SFUDA methods and achieves highly competitive performance, closely approaching cutting-edge unsupervised domain adaptation methods for arrhythmia classification.}
}
@article{ASAWA2026116312,
title = {A coverage-aware neural framework for interpretable automated short answer grading},
journal = {Applied Soft Computing},
volume = {203},
pages = {116312},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116312},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017606},
author = {Krishna Asawa and Vartika Puri and Himanshu Agrawal},
keywords = {Automated short answer grading, Deep learning, SBERT, TF-IDF, Semantic similarity, Coverage-aware grading, Cross-attention, Interpretability, Educational NLP, Sentence embedding},
abstract = {Automated Short Answer Grading (ASAG) is essential for scalable, fair, and timely assessment of students’ short answers. Current ASAG techniques commonly employ semantic similarity models to measure the similarity between student responses and reference answers. However, academic grading depends not only on semantic similarity but also on the extent to which a student’s response covers the expected reference content and reveals missing content. Existing neural network-based approaches, including sentence attention methods and cross-encoder models, either fail to explicitly capture partial content coverage or incur high computational costs for large-scale deployment. To address these limitations, this paper proposes a coverage-aware neural grading framework that models ASAG as a directional evidence alignment problem between student responses and instructor reference answers. The framework combines efficient sentence-level encoding with directional cross-attention, in which student tokens act as queries while reference tokens provide keys and values. This asymmetric interaction selectively retrieves semantically relevant reference information for each student token, producing an interpretable token-level alignment map between the student response and the reference answer. The alignment information is further utilized to estimate the coverage of pedagogically relevant reference content and identify missing content, while complementary semantic similarity features support the final grading decision. Experiments conducted on benchmark and real-world ASAG datasets demonstrate that the proposed framework consistently outperforms similarity-based approaches and achieves competitive performance with computationally expensive cross-encoder models while providing interpretable alignment-based feedback. The proposed framework offers an efficient, scalable, and explainable neural solution for automated educational assessment systems.}
}
@article{FEI2026116247,
title = {DEMATEL-based analysis of user intentions to continue using mobile emergency safety learning platforms in heterogeneous information environments},
journal = {Applied Soft Computing},
volume = {203},
pages = {116247},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116247},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016959},
author = {Liguo Fei and Tao Li and Weiping Ding},
keywords = {DEMATEL, Heterogeneous linguistic information, Continuous intention, Emergency safety education, Mobile learning platform},
abstract = {In recent years, mobile emergency safety learning platforms (MESLPs) have increasingly been utilized in safety education, providing users with convenient and timely access to safety knowledge and skill training. This has significantly enhanced public safety awareness and self-rescue capabilities. However, in the context of a growing number of platforms and intensified market competition, maintaining users’ intention to continue using these platforms is crucial for their sustained development. It is, therefore, essential to delve into the motivations behind users’ continued utilization of these platforms. Employing the decision-making trial and evaluation laboratory (DEMATEL) method, integrated with heterogeneous linguistic expressions, enables a comprehensive and precise analysis of key factors influencing users’ sustained use of MESLPs. This approach not only overcomes the limitations of traditional analyses but also accurately reflects users’ actual needs and experiences, providing a scientific foundation for precise platform improvements. An in-depth investigation identified eleven core factors, including learning needs, user experience, and personalized learning. Applying the heterogeneous linguistic DEMATEL method further elucidates the centrality and interconnections among these factors. Findings highlight that user experience, learning effectiveness, practicality, and learning needs are pivotal in driving continued user engagement. Moreover, personalized learning, technical support and stability, and incentive mechanisms also play an integral role. The introduction of the DEMATEL method in heterogeneous linguistic environments offers valuable guidance for the design and optimization of MESLPs. Enhancing user experience and catering to personalized learning needs, among other measures, are likely to significantly boost user engagement and learning outcomes, thereby fostering continuous innovation and development of MESLPs.}
}
@article{WANG2026116256,
title = {Adaptive conformal prediction for spatio-temporal hypergraph neural networks},
journal = {Applied Soft Computing},
volume = {203},
pages = {116256},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116256},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017047},
author = {Yiyong Wang and Yuhao Ma},
keywords = {Conformal prediction, Hypergraphs, Spatiotemporal forecasting, Uncertainty quantification, Deep learning, Intelligent transportation},
abstract = {Reliable spatio-temporal forecasts require uncertainty estimates when they inform urban operations. Hypergraph neural networks can model high-order relational dependencies, but most produce deterministic forecasts without finite-sample uncertainty guarantees. Bayesian neural networks and deep ensembles provide uncertainty estimates at substantial computational cost, whereas their intervals do not generally have distribution-free finite-sample coverage. We propose Conformal Spatio-Temporal Hypergraph (CSTH), which combines adaptive conformal prediction with high-order relational modeling. Its topology-adaptive scale conditions prediction intervals on local hyperedge density and historical volatility. Under the exchangeability conditions stated in Proposition 1, the resulting intervals retain marginal conformal coverage. On METR-LA (207 sensors) and PEMS-BAY (325 sensors), CSTH attains empirical coverage close to the 90% target and narrower intervals than the evaluated conformal baselines. The complete online forward pass takes 22 ms per batch after a one-time offline calibration step. These intervals indicate when a traffic forecast is insufficiently precise for risk-aware use.}
}
@article{LIANG2026116308,
title = {Multimodal comfort assessment transformer for virtual reality comfort-state prediction using motion, touch interaction, and physiological signals},
journal = {Applied Soft Computing},
volume = {203},
pages = {116308},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116308},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017564},
author = {Yin Liang},
keywords = {Virtual reality, Motion tracking, Controller-based touch interaction, Physiological monitoring, Multimodal comfort-state prediction, Multimodal fusion, Transformer},
abstract = {Virtual Reality (VR) has transformed digital interaction by providing immersive experiences; however, user discomfort caused by cybersickness, motion instability, controller-based touch interaction, and physiological stress continues to limit its widespread adoption. To address these issues, in this work, a novel multimodal framework is proposed for Virtual Reality comfort-state prediction that includes motion tracking, controller-based touch interaction, and physiological signals. The proposed framework uses Motion Tracking Short-Time Fourier Transform (MT-STFT), Touch Interaction Profiling (TIP), and Dual Signal Analysis using Wavelet Packet Transform (DSA-WPT) to extract discriminative features from heterogeneous sensing modalities. These features are further analyzed using the proposed Multimodal Comfort Assessment Transformer that combines Cross-Attentive Low-Rank Factorization, Multi-Modal Cross Temporal Attention (MMCTA), and Cross-Modality Attention Fusion (CMAF) to learn cross-modal temporal dependencies and build a unique multimodal representation. The final comfort state prediction module determines the state of user comfort as Comfortable, Neutral, or Uncomfortable. The proposed framework has been tested using the publicly available VRWalking_dataset, demonstrating the superiority of proposed multimodal learning for comfort assessment in immersive VR. Experimental results have shown that the proposed model achieves 98.89% accuracy, 98.02% precision, 97.79% recall, and 97.90% F1-score, outperforming existing state-of-the-art approaches. The experimental results demonstrate the effectiveness of the proposed framework for multimodal VR comfort-state prediction and create the basis for future adaptive virtual reality systems.}
}
@article{SONG2026116284,
title = {Integrating time-series data image representation with efficient multi-scale feature extraction for human activity recognition},
journal = {Applied Soft Computing},
volume = {203},
pages = {116284},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116284},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017321},
author = {Kunfang Song and Jiaqing Wang and Shufen Ruan and Guowei Yan and Yanwen Wang},
keywords = {Human activity recognition, Imaging, Deep learning, Attention mechanism, Lightweight},
abstract = {Human activity recognition (HAR) based on wearable sensors has been widely applied in intelligent healthcare, and sports health due to its advantages in low power consumption, real-time performance, and privacy preservation. Recently, advanced approaches have focused on transforming time-series data into images and leveraging deep learning for recognition, which addresses the problem of one-sidedness of information and dependence on data quality in traditional one-dimensional processing. However, existing image representation methods for time-series data only capture single-dimensional features resulting in the loss of key information and complex operations. Moreover, the adopted deep learning architectures are still largely confined to conventional models, resulting in insufficient ability to capture multi-scale features. To address the above problems, this study proposes a human activity recognition framework that integrates time-series data image representation (TIR) with an efficient multi-scale feature extraction network (EMFENet). The framework first utilizes wavelet transform to efficiently encode time-series data into images. We then introduce a multi-branch wavelet transform convolution (MWTC) to achieve lightweight multi-scale feature extraction. We further employ a cross-space multi-scale attention mechanism (CSMA) to enhance critical information and design a multi-scale dilated convolution (MSDC) to capture long-range dependencies within the image, complete spatial context modeling, and provide more robust semantic information for subsequent classification. The effectiveness of the model is validated on 6 public HAR datasets (UCI-HAR, WISDM, PAMAP2, OPPORTUNITY, UniMiB-SHAR, USC-HAD). The experimental results demonstrate that TIR-EMFENet achieves competitive recognition performance while maintaining low model complexity.}
}
@article{ARJOMAND2026116316,
title = {TransfoRhythm: A transformer architecture conductive to blood pressure estimation through solo PPG signal capturing},
journal = {Applied Soft Computing},
volume = {203},
pages = {116316},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116316},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017643},
author = {Amir Arjomand and Amin Boudesh and Farnoush Bayatmakou and Georgiy Krylov and Kenneth B. Kent and Arash Mohammadi},
keywords = {Cuffless blood pressure estimation, Photoplethysmography, Standalone PPG, Single channel PPG, PPG morphology, Transformer neural network, Multi head attention, Physiological time series, Patient independent evaluation, MIMIC IV Waveform Database},
abstract = {Recent statistics indicate that approximately 1.3 billion individuals worldwide are affected by hypertension, a major contributor to premature mortality. Blood pressure (BP) is an important physiological indicator for hypertension assessment and management. Conventional cuff-based methods provide intermittent measurements and may be unsuitable for continuous monitoring. Recent advances in artificial intelligence (AI) and deep neural networks (DNNs) have therefore increased interest in data-driven cuff-less BP estimation. Existing studies frequently combine electrocardiography (ECG) and photoplethysmography (PPG), requiring multiple synchronized sensor types. PPG-only estimation offers a simpler acquisition setup but remains challenging because BP-related morphological information must be extracted in the presence of motion artifacts and high-frequency noise. This paper introduces TransfoRhythm, a Transformer-based DNN framework for PPG-only BP estimation using the MIMIC-IV Waveform Database. The framework uses multi-head attention to model temporal relationships among cycle-level PPG features. Evaluation was performed using patient-independent 5-fold cross-validation, with patient IDs used as the splitting unit and zero patient overlap between training and test folds. Within each fold, feature selection, collinearity filtering, data scaling, hyperparameter selection, and model fitting were performed using only the training patients. Under this protocol, TransfoRhythm achieved mean MAEs of 1.93 mmHg for systolic BP and 1.49 mmHg for diastolic BP, with corresponding RMSE values of 3.11 and 2.59 mmHg. The mean errors were −0.01 mmHg and −0.26 mmHg, while the mean R2 values were 0.888 and 0.891 for systolic and diastolic BP, respectively. These findings demonstrate consistent predictive performance across held-out patient groups within the evaluated MIMIC-IV cohort. External and prospective validation remains necessary to establish generalizability beyond this dataset.}
}
@article{LI2026116311,
title = {Multi-type cyberbullying user classification via multi-view feature construction},
journal = {Applied Soft Computing},
volume = {203},
pages = {116311},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116311},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601759X},
author = {Tingting Li and Yanlu Gong and Ting Chen and Jingjing Sun},
keywords = {Social media, Cyberbullying user classification, Multi-view features, XLNet, Heterogeneous network model},
abstract = {With the rapid growth of social media, cyberbullying has become a pressing social issue. Existing detection methods primarily focus on textual content, overlooking the complex behavioral patterns of perpetrators, which limits their effectiveness. To address this gap, this study proposes a multi-type cyberbullying user classification framework via multi-view feature construction. The framework integrates multi-source social media data to construct rich feature representations, specifically, semantic view features are extracted using XLNet, which captures long-range dependencies and contextual meaning through its Transformer-XL architecture and permutation-based language modeling; network view features are derived using a heterogeneous network model, which models the relationships among users, posts, sentiments, and topics to reveal cyberbullying users’ behavioral patterns; hybrid view features are generated by combining content, interaction, and profile features to further improve classification performance. Experimental results demonstrate that the proposed model, with optimal configuration, achieves an F1-score of 76.74% and an AUC of 91.27%, significantly outperforming all feature subsets. These consistent improvements in both F1-score and AUC across three types of cyberbullying users confirm the value of multi-view integration.}
}
@article{XIAO2026116353,
title = {Structural health monitoring of corrosion depth of buried pipelines by developing an interpretable stacking ensemble model CGEK-PipeCorr},
journal = {Applied Soft Computing},
volume = {203},
pages = {116353},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116353},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626018016},
author = {Linxuan Xiao and Rui Bu and Zhaochao Li},
keywords = {Buried pipelines, Corrosion depth, Ensemble learning, Interpretable machine learning, Soil plasticity index, K-Fold cross-validation, Structural health monitoring},
abstract = {This study proposes a new ensemble learning model, CGEK-PipeCorr, for predicting pipeline corrosion depth. The model replaces discrete soil classification with the continuous soil plasticity index to reduce feature redundancy. A double 5-fold cross-validation mechanism is employed to mitigate overfitting, and Gaussian process-based Bayesian optimization is used to tune the hyperparameters of the base learners. A meta-learner is used to combine the outputs of base models, and the SHAP (SHapley Additive exPlanations) method is integrated to analyze the decision mechanisms from both feature and model dimensions. Experiments show that the proposed method achieves competitive predictive performance among the evaluated models in terms of prediction accuracy of corrosion depth. On the test set, it achieves an MSE of 0.1990, MAE of 0.3023, R² of 0.8855, and RMSE of 0.4461, reducing the error metrics MSE, MAE, and RMSE by 21.14%, 14.29%, and 11.20%, compared to the single baseline model. The prediction accuracy metric R² increases by 3.59%. Thus, this study proposes a novel model to predict the corrosion depth of pipelines and provide practical recommendations for engineering decision-making. It is found that operators prioritize cathodic protection in high chloride-containing areas and shorten detection intervals in low-pH soils.}
}
@article{AMARA2026116272,
title = {Ghost Rate: A pre-training geometric quality diagnostic for synthetic oversampling in imbalanced text classification},
journal = {Applied Soft Computing},
volume = {203},
pages = {116272},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116272},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017205},
author = {Marwa Amara and Nadia Smairi},
keywords = {Imbalanced classification, Synthetic oversampling, SMOTE, -nearest neighbours diagnostic, Contrastive learning, Embedding-space quality, Text classification, Arabic NLP},
abstract = {Synthetic oversampling with SMOTE-family methods is the standard remedy for class imbalance in text classification, yet the geometric validity of the synthetic samples is rarely measured before training. We introduce Ghost Rate, a k-nearest-neighbour diagnostic that quantifies, before any classifier is trained, the fraction of synthetic minority samples whose local neighbourhood is dominated by the majority class. The metric generalises the noise criterion of Safe-Level SMOTE into a scalar pre-training quality gate, runs in O(|S|⋅k⋅logN) time, and requires no access to the downstream classifier. We analyse three properties: a probabilistic lower bound from local majority density, a qualified (conditional) behaviour in the neighbourhood size k, and an asymptotic connection to the Bayes-optimal boundary. Building on the diagnostic, we also explore two secondary tools: GhostRate-Select, a training-free screen that flags high-Ghost-Rate (futile) regimes (we test and reject its stronger use as a strategy selector), and ContraSMOTE, an exploratory contrastive-guided oversampler whose encoder preconditions neighbour selection while interpolation stays in the original feature space. We evaluate on six corpora across two languages: AJGT and LABR (Arabic sentiment), SMS-Spam, AG-News, and two further naturally-imbalanced English corpora (hate speech and emotion), all under a 25-run, Bonferroni-corrected protocol. The adaptive variant ADASYN consistently produces the highest Ghost Rate, whereas ContraSMOTE is statistically comparable to plain SMOTE on both Ghost Rate and macro-F1; ContraSMOTE is an exploratory demonstration of the diagnostic rather than a performance gain. Ghost Rate behaves as a futility signal: as it rises, an oversampler’s macro-F1 collapses toward the no-augmentation floor while a threshold-tuned algorithm-level baseline stays ahead at every Ghost Rate, so such a baseline should always be compared rather than assumed inferior to oversampling.}
}
@article{QIAO2026116251,
title = {Memristive-inspired approach based globally weighted variational graph auto-encoders for stacked floorplanning layout in industrial electronics},
journal = {Applied Soft Computing},
volume = {203},
pages = {116251},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116251},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016996},
author = {Kaikai Qiao and Ai Chen and Lidan Wang and Shukai Duan},
keywords = {Globally weighted variational graph auto-encoders, Memristive-inspired bottom-up left justified learning, Stacked floorplanning layout},
abstract = {With the growing complexity of industrial chip design, three-dimensional integrated circuits (3D-ICs) incorporating vertically-integrated device layers have become a promising solution for enhancing performance, power efficiency, and area (PPA). The layout optimization for such 3D stacked chips involves placing large functional macro-blocks and organizing interconnects across multiple strata—a process complicated by strong interdependencies between geometric arrangements and design constraints. Conventional deterministic optimizers often fail to traverse this multi-modal search space effectively. To address these challenges, we introduce a cluster-based floorplanning framework aimed at minimizing total wirelength. Our approach consists of two coordinated stages: a partitioning phase using a Global Weighted Variational Graph Auto-Encoder (GW-VGAE) to group macros into logically cohesive clusters, thereby reducing interconnect complexity, and a floorplanning phase employing a Memristive-inspired Bottom-up Left-Justified Learning (MBLJL) strategy, which mimics memristive dynamic learning to iteratively refine module placement with improved convergence and global alignment. Experimental evaluation on 28 macro floorplanning benchmarks shows that our method achieves superior optimization outcomes.}
}
@article{LI2026116288,
title = {A high robust image compression network for transmission line monitoring under various weather conditions},
journal = {Applied Soft Computing},
volume = {203},
pages = {116288},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116288},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017369},
author = {Pei Li and Liming Ji and Xinxin Cao and Hanbo Zheng and Yanshen Liang and Jinheng Li},
keywords = {Smart grids, Transmission corridors, Deep learning-based image compression, Multi-scale convolution},
abstract = {With the continuous development of smart grids, the mileage of power lines is increasing, accompanied by issues such as insufficient maintenance personnel and long maintenance cycles. To effectively maintain the safety of power lines, real-time monitoring of transmission corridors has emerged. According to our research, the monitoring of transmission corridors still relies on classical image compression methods, which result in images with significant redundancy, making them unsuitable for transmission and storage. Therefore, this paper investigates a deep learning-based image compression framework suitable for processing transmission corridor scene images. Transmission corridor scene images are generally large in size, typically 1080p or higher. To address this characteristic, we have developed the Multi-scale Kernel Image Compression Network (MKIC-Net), which consistently employs multi-scale convolution. Specifically, we propose new structures such as the Multi-scale Kernel Feature Fusion (MKFF) block, Multiple Large Kernel Convolution (MLKC) group, Multiple Small Kernel Convolution (MSKC) group, and the Mult-scale Kernel Hyperprior (MKH) to expand the effective receptive field of CNNs, making the network more suitable for learning features from large-sized images. Experiments demonstrate that MKIC-Net exhibits excellent overall performance, with the advantages of low parameter and high inference speed. Its rate-distortion performance surpasses that of the baseline Better Portable Graphics (BPG) and popular deep learning algorithms on the transmission line image dataset with various weather conditions. The experiment indicates that MKIC-Net is expected to replace the BPG and other image compression methods that are still being used for monitoring the transmission line corridors.}
}
@article{LUO2026116332,
title = {Agentic GAN-driven federated resource orchestration for music streaming in edge-cloud collaborative consumer electronics networks},
journal = {Applied Soft Computing},
volume = {203},
pages = {116332},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116332},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017801},
author = {Xuejiao Luo and Deokwoo Lee and Lu Zheng},
keywords = {Agentic intelligence, Generative adversarial network, Edge computing, Multi-agent learning, Streaming},
abstract = {Music streaming on consumer electronics requires real-time, personalized delivery across heterogeneous devices while meeting strict quality-of-experience requirements. Existing edge architectures find it difficult to balance playback latency against perceived audio quality under time-varying wireless channels, diverse device capabilities, and privacy constraints. To address these requirements, we propose AGILE-MARS, an agentic, GAN-assisted intelligent learning framework for adaptive resource scheduling in edge music. The word “agentic" carries a fixed operational sense: each edge node perceives its local workload, selects allocations within every scheduling slot without cloud instruction, adapts its policy from its own experience under explicit value uncertainty, and shares only a chosen subset of its learned knowledge during coordination. The framework models joint bandwidth and processing allocation as a decentralized partially observable Markov decision process across edge music streaming nodes. Each node maintains a local dueling double deep Q-network, enhanced with Wasserstein generative adversarial networks for distributional value learning, and uploads generator parameters for federated averaging while retaining discriminator parameters locally to protect listener data. Simulations driven by non-homogeneous Poisson arrivals derived from Alibaba Cluster Trace workloads and Million Song dataset characteristics show that AGILE-MARS reduces average playback latency by 32 percent and raises the quality satisfaction rate by 0.112, from 0.796 to 0.908, over federated multi-agent baselines. Ablation studies confirm complementary contributions from distributional learning and federated coordination; removing both costs 27.5 percent of performance.}
}
@article{ZHANG2026116348,
title = {Knowledge-informed neural network for reliable and explainable prediction of concrete strength},
journal = {Applied Soft Computing},
volume = {203},
pages = {116348},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116348},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017965},
author = {Tianjie Zhang and Hao Wang and Mathew P. Adams},
keywords = {Compressive strength, Knowledge-informed neural network, Concrete, Empirical equation, Machine learning},
abstract = {Predicting compressive strength of concrete is crucial for optimized mix design for engineering properties and performance. While machine learning models are used for prediction, their effectiveness is often limited by challenges related to generalizability and scalability. This study developed knowledge-informed neural network (KINN) to predict compressive strength of concrete by integrating the empirical equation of concrete strength growth into hybrid loss function based on a large dataset from field projects. The performance of KINN is compared with other models including artificial neural networks (ANN), support vector regression (SVR), k-nearest neighbors (KNN), random forest (RF), eXtreme Gradient Boosting (XGBoost) and the empirical equation. The results demonstrate that KINN achieves superior predictive stability and physical consistency compared to ANN having identical architecture, while offering competitive accuracy. Compared with tree-based ensemble methods (XGBoost, RF), KINN presents a trade-off: slightly lower mean R² but substantially reduced variability and physically consistent predictions aligned with domain knowledge. Furthermore, the SHapley Additive exPlanations (SHAP) analysis reveals that knowledge-informed models not only capture the underlying physical principles but are also more interpretable for the effect of water-binder ratio. Partial dependence plots and Accumulated Local Effects (ALE) are employed to investigate the effects of curing ages, water-to-binder ratio and percentage of supplemental cementitious materials (SCM) on compressive strength, providing valuable insights for engineering decision making. The integration of empirical knowledge into machine learning models, as demonstrated by KINN, enables engineers to incorporate prior domain expertise into predictions of concrete performance.}
}
@article{QIN2026116357,
title = {Uncertainty calibration for hallucination detection via token dependency and sequence divergence},
journal = {Applied Soft Computing},
volume = {203},
pages = {116357},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116357},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626018053},
author = {Shuai Qin and Lianke Zhou and Liu Sun and Nianbin Wang},
keywords = {Hallucination detection, Uncertainty quantification, Token dependency, Sequence divergence},
abstract = {Large Language Models (LLMs) have revolutionized natural language processing, yet their propensity to generate hallucinations presents critical challenges to model security and trustworthiness. Uncertainty quantification has emerged as a promising strategy to detect unreliable generations. However, existing methods typically treat all tokens and sequences equally, overlooking their contextual dependencies and sentence divergences. Thus, we propose leveraging the dependencies between generated tokens and the semantic discrepancy among output sequences to calibrate uncertainty. At the token level, we explore the influence of each token on subsequent tokens using the model’s inherent attention mechanism, assigning higher uncertainty weights to tokens with greater contextual significance. At the sequence level, we assess the semantic consistency across multiple generated outputs based on the hidden states of LLMs, assigning a higher uncertainty bias to sequences that exhibit greater semantic divergence from others. Extensive experiments across a wide range of benchmarks, spanning standard question answering (QA), text summarization, and domain-specific tasks, are conducted with several popular “off-the-shelf” LLMs. The experimental results reveal that our method achieves an absolute improvement of up to 14.0% in specialized domains such as virology, while markedly surpassing the competitive hybrid measure SAR by up to 4.1% on complex QA tasks. Furthermore, our approach maintains superior robustness across instruction-tuned models and broader NLP tasks, underscoring its overall efficacy and generalizability.}
}
@article{LIU2026116365,
title = {T-S fuzzy-based robust stability control for semi-trailer trucks by integrating tractor yaw moment and trailer active steering},
journal = {Applied Soft Computing},
volume = {203},
pages = {116365},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116365},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626018132},
author = {Yujie Liu and Ming Yue and Gengxin Qi and Yazhou Guo and Xudong Zhao},
keywords = {Semi-trailer truck, T-S fuzzy model, State observation, Stability control, Tractor yaw moment control, Trailer active steering},
abstract = {The stability control of autonomous semi-trailer trucks is one of the key issues in ensuring autonomous driving safety. However, the time-varying parameters, nonlinearity, and uncertainties of the vehicle may weaken the performance of stability control. To address this, this paper proposes a robust stability control method based on Takagi-Sugeno (T-S) fuzzy. First, a semi-trailer truck lateral–yaw–roll dynamics model, integrating tractor yaw moment control and trailer active steering, is established and transformed into a T-S fuzzy model that considers parameter variability, nonlinearity, and model uncertainties. Next, to improve the reliability of the vehicle stability control system, a robust fuzzy H∞ state observer is designed to estimate the unknown vehicle states in the system state vector. Then, considering the system’s time-varying, nonlinear, and uncertain characteristics, a robust fuzzy H∞ stability controller is proposed, which integrates tractor yaw moment control and trailer active steering to enhance the system’s robustness. Finally, hardware-in-the-loop (HIL) tests validate the effectiveness of the proposed method in improving vehicle stability.}
}
@article{ZHOU2026116268,
title = {DP-SMOTE: An oversampling algorithm based on density clustering and conditional probability for imbalanced data},
journal = {Applied Soft Computing},
volume = {203},
pages = {116268},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116268},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017163},
author = {Hongfang Zhou and Xinhao Zheng and Jiajia Du},
keywords = {Imbalanced data classification, Density-based unsupervised clustering, Conditional probability, Oversampling},
abstract = {Class imbalance poses a major challenge to machine learning models, especially in applications requiring reliable minority-class recognition. Existing oversampling methods often suffer from noise sensitivity and limited control over synthetic sample interpolation. To address these issues, this paper proposes DP-SMOTE, a density–Bayesian oversampling framework that enables noise-aware and controllable data augmentation. DP-SMOTE consists of three stages: adaptive density-based clustering to identify safe regions while suppressing outliers, Bayesian confidence estimation to evaluate candidate synthetic samples, and directionally constrained interpolation within verified subspaces. Experiments on 20 benchmark datasets from the Kaggle and KEEL repositories demonstrate that DP-SMOTE consistently outperforms SMOTE, SMOTE-ENN, and other comparative algorithms. Using 10-fold cross-validation, statistically significant improvements are achieved across precision, recall, F1-score, G-mean, and AUC-ROC. The proposed method provides an effective and robust solution for imbalanced learning, with strong potential for real-world applications such as medical diagnosis and financial fraud detection.}
}
@article{SONG2026116300,
title = {Multi-mode three-dimensional Gaussian world model for end-to-end autonomous driving},
journal = {Applied Soft Computing},
volume = {203},
pages = {116300},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116300},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017485},
author = {Ke Song and Yunhe Wu and Chunchit Siu and Huiyuan Xiong},
keywords = {End-to-end autonomous driving, 3D Gaussian world model, Multi-mode trajectory, Future scene prediction},
abstract = {End-to-end autonomous driving must reason about uncertain future scene evolution while generating feasible ego trajectories. We propose the Multi-Mode 3D Gaussian World Model (MGWM), which represents each future hypothesis as a coupled pair of an ego-trajectory candidate and a trajectory-conditioned 3D Gaussian scene representation. This formulation makes future-scene imagination and motion planning mutually conditioned, rather than treating them as two independent prediction branches. A Bidirectional Interactive World Model (BIWM) performs cross-stream refinement between trajectory-mode features and Gaussian scene tokens, while Diversity and Coverage losses encourage the generated hypotheses to remain both diverse and grounded in the feasible future trajectory space. From a soft-computing perspective, MGWM combines uncertainty-aware multi-mode prediction, differentiable scene representation, neural interaction modeling, and adaptive hypothesis selection for learning-based autonomous planning. Evaluated on the nuScenes dataset, the auxiliary-label-free variant uses multi-view camera images without additional human-annotated perception labels, such as HD maps, occupancy, 3D bounding boxes, or motion labels. Raw future camera frames are used only as self-supervised sensor observations for image reconstruction and are not treated as perception annotations. This variant achieves an average L2 error of 0.39 m and a collision rate of 0.16%. When map and motion annotations are introduced as auxiliary perception supervision, the perception-supervised variant further improves the average L2 error to 0.30 m and the collision rate to 0.13%. These results show that the proposed coupled Gaussian–trajectory formulation improves uncertainty-aware scene imagination and trajectory planning under the evaluated benchmarks.}
}
@article{LIU2026116373,
title = {Collaborative bidirectional enhanced contrastive learning for dual graphs in social recommendation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116373},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116373},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626018211},
author = {Yi Liu and Lang Qin and Xianwu Cao and Qimeng Tan and Caihong Mu},
keywords = {Graph Neural Networks, Social Recommendation, Task-level Assistance, Contrastive Learning},
abstract = {Graph-based social recommender systems typically use graph neural networks to model high-order relationships in observed social networks for capturing user preferences, which can alleviate the sparsity problem of user interaction data. However, existing methods still face challenges in obtaining social information that is beneficial to recommendation tasks. Specifically, the information in social graphs is inherently sparse and limited, making it difficult to learn high-quality user embeddings relying solely on this single social view. We propose to leverage the interaction information in user-item graphs to enhance and optimize user embeddings in social graphs. Therefore, we present a framework called Collaborative Bidirectional Enhanced Contrastive Learning for Dual Graphs (CBECL), where dual graphs refer to the user–item interaction graph and the user–user social graph. The framework consists of a cross-graph task-level assistance (CTA) module and a dual contrastive learning (DCL) module. Specifically, we construct a discriminative task in the social domain based on a triplet hinge loss, whose optimization is task-level assisted by the interaction-domain recommendation task and driven by user preference signals, thereby enabling cross-graph task collaborative optimization. In addition, the incorporated DCL mechanism further refines social-domain user representations and promotes semantic alignment of user embeddings between the interaction graph and the social graph. These components work collaboratively to form a bidirectional closed-loop cross-graph enhancement learning framework. Rather than a simple combination of existing modules, the design of CBECL is inspired by industrial multi-task collaboration paradigms (e.g., click-through rate prediction driving conversion rate prediction task), and achieves synergistic optimization through coordinated CTA and DCL. It achieves superior performance compared to existing state-of-the-art methods, yielding significant improvements over the second-best baseline across multiple benchmark datasets in most cases. The code of our work will be found at https://github.com/DualGraphsSR/CBECL.}
}
@article{HE2026116238,
title = {LCB-D2: Lightweight cross-boosted keypoint detection and description extraction},
journal = {Applied Soft Computing},
volume = {203},
pages = {116238},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116238},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016868},
author = {Yulin He and Jinrong Chen and Miao Xiang and Zhongyuan Guo and Guodong Zhao and Yiming Wang and Yi Xiang},
keywords = {Visual SLAM, Local features, Dilated attention sampling, Cross-attention booster},
abstract = {Achieving robust and lightweight local feature extraction for real-time visual SLAM under challenging geometric and photometric variations remains difficult, as existing methods either lose crucial details during downsampling or rely on computationally expensive architectures. To address this problem, we propose LCB-D2, an efficient framework for joint keypoint detection and descriptor learning tailored for SLAM applications. The model incorporates a Dilated Attention Sampling (DAS) module to enlarge the receptive field while preserving high-frequency information, and a Cross-Attention Booster that enhances descriptor discriminability using detection-guided cues, supported by an alignment loss for stable training. Trained with geometric self-supervision on the MS-COCO dataset, LCB-D2 learns highly repeatable keypoints and robust descriptors that can reliably support keypoint matching and pose estimation in visual SLAM systems. Comprehensive evaluations on HPatches, Aachen Day–Night v1.1, and InLoc demonstrate that our approach achieves competitive accuracy with a favorable accuracy-efficiency trade-off while maintaining a compact model size. This work provides an efficient lightweight design for high-performance visual front-ends and offers promising directions for future research in local feature learning and real-time SLAM applications. The code and models are available at https://github.com/hyulin472-dotcom/LCB-D2.}
}
@article{PAN2026116327,
title = {Blockchain-coordinated adaptive data placement for edge networks: A prediction-enhanced hybrid intelligence framework},
journal = {Applied Soft Computing},
volume = {203},
pages = {116327},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116327},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017758},
author = {Lin Pan and Jinhai Wang and Yunan Zhai and Liyuan Zhang and Jia Zhao and Yan Ding},
keywords = {Decentralized edge intelligence, Proactive data deployment, Blockchain-coordinated architecture, Hybrid intelligent optimization, Multimodal demand forecasting},
abstract = {The evolution of blockchain-enabled edge networks introduces a robust paradigm for decentralized infrastructure; however, orchestrating data proactively across these distributed nodes remains a critical challenge. Traditional reactive caching approaches struggle to effectively manage resources and guarantee scalability in such trustless environments. In response to these challenges, this paper proposes a blockchain-coordinated distributed edge storage (CBDS) framework for adaptive data placement in decentralized edge environments. Within this framework, we present the Optimized Data Deployment Strategy (ODDS), a prediction-enhanced hybrid intelligence approach that organizes candidate screening, demand prediction, and placement optimization into a coordinated decision process. Specifically, ODDS integrates a time-slice-based multimodal predictive neural network for forecasting user demand, coupled with a Pareto-based multi-objective placement optimizer to reduce transmission latency and balance load distribution among edge nodes. Beyond its empirical design, we provide a theoretical guarantee showing that the optimality loss introduced by prediction-based gating is bounded by a linear function of the predictor’s miss rate and is independent of the catalog size, which explains why aggressive candidate pruning does not destabilize end-to-end latency. Trace-driven emulations using YCSB benchmark workloads validate that ODDS reduces download latency by roughly 15% relative to the best-performing baseline under high load, with substantially smaller latency growth as load and object size increase, while maintaining stable cache hit ratios under high network stress. The results demonstrate that the proposed CBDS framework, driven by the ODDS approach, provides a practical and effective solution for addressing performance and scalability challenges in next-generation decentralized edge networks.}
}
@article{GUPTA2026116246,
title = {A multi-swarm PSO with linear group decay and continuous information reshuffling for constrained engineering design problems},
journal = {Applied Soft Computing},
volume = {203},
pages = {116246},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116246},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016947},
author = {Kshitij Gupta and Mayank Gautam and Chirag Koak and K.P.S. Rana and Vineet Kumar},
keywords = {Metaheuristic algorithms, Particle swarm optimization, Multi-swarm intelligence, Linear group decay, Continuous information exchange},
abstract = {Particle Swarm Optimization (PSO) has been one of the most investigated metaheuristic algorithms due to its simplicity and reliability. Like many classical algorithms, conventional PSO falls prey to premature convergence on highly multi-modal problems attributed to weak exploration. To counter this, multi-swarm PSO variants have been proposed. However, a persistent issue with these variants has been limited cooperation among groups. To address these shortcomings, this paper introduces Multi-Swarm PSO with Linear Group Decay and Continuous Information Reshuffling (MPSO-LGD-CIR) for optimizing Constrained Engineering Design Problems (CEDPs). With the incorporation of LGD, the proposed algorithm is able to maintain an adaptive balance between exploration and exploitation by reducing the number of sub-swarms, gradually shifting from a highly exploratory behavior to intensified exploitation. Further, CIR has offered enhanced cooperation by continuously reshuffling information amongst groups. Overall, the proposed algorithm fosters collaboration, preserves early-stage diversity, and enhances later-stage exploitation. The performance of MPSO-LGD-CIR is comprehensively validated through both theoretical benchmarking and application to CEDPs. On the CEC 2017 test suite across 10 and 30 dimensions, the algorithm outperformed state-of-the-art peers in terms of solution error and convergence. Crucially, when tasked with optimizing five CEDPs, MPSO-LGD-CIR demonstrated highly competitive performance, handling complex physical constraints. Therefore, based on the presented investigations, it is concluded that MPSO-LGD-CIR is a simple yet highly effective algorithm suitable for practical deployment.}
}
@article{ALAM2026116314,
title = {GANA-SkinAI: A multi-stage generative framework for explainable and interpretable skin cancer classification},
journal = {Applied Soft Computing},
volume = {203},
pages = {116314},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116314},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601762X},
author = {Touhid Alam and Sultanul A. Hamim and Md.Jakir Hossen and M.F. Mridha},
keywords = {Generative adversarial networks, Skin cancer classification, Data augmentation, Transfer learning, Explainable AI, Dermoscopy},
abstract = {Skin cancer remains a critical global health concern with rising incidence rates and significant mortality if undetected early. While Convolutional Neural Networks (CNNs) demonstrate substantial promise in automating diagnosis, their clinical utility is frequently hindered by data artifacts, severe class imbalance, and a lack of mathematical interpretability. To address these persistent limitations, this study proposes a multi-stage framework: Generative Adversarial Network Augmented-Skin Analysis Intelligence (GANA-SkinAI). Recognizing that individual preprocessing steps like GAN-based hair removal are established in the literature, our methodology focuses on the sequential, optimized integration of an inpainting GAN, deterministic contrast enhancement, and a conditional augmentation GAN. Crucially, to prevent data leakage, we implemented a strict patient-wise (lesion-specific) data splitting protocol prior to any augmentation. This coupled pipeline successfully reduced the HAM10,000 dataset imbalance ratio from approximately 34:1 to 3:1. When evaluated against state-of-the-art transfer learning models through rigorous ablation, the GANA-SkinAI framework enabled an EfficientNetV2-M classifier to achieve a validation accuracy of 99.75%, a marked improvement over the 90.26% achieved with the original dataset. Overall, across an extensive benchmark of fifteen evaluated architectures, we observed a universal model-agnostic performance uplift ranging from 8.49% to 19.31%. Crucially, to bridge the gap between high accuracy and clinical trust, we developed a quantitative Explainable AI (XAI) and feature-preservation validation loop. We utilized paired t-tests on Local Binary Patterns (LBP), Gray Level Co-occurrence Matrices (GLCM), and explicit morphological features to mathematically prove the preservation of clinical features. We also utilized estimated Intersection over Union (IoU), Dice coefficient, and Normalized Discounted Cumulative Gain (NDCG) of saliency maps against segmentation masks to validate XAI correctness. Furthermore, to prove structural robustness and address generalizability, the framework was externally validated via cross-domain evaluation on the out-of-distribution APTOS 2019 clinical holdout and independent holdouts of ISIC 2019, ISIC 2020, and PH2. Ultimately, the distinct advantage of the GANA-SkinAI framework is its ability to transform a highly skewed, artifact-ridden clinical repository into a standardized, morphologically rich feature space, yielding a highly trustworthy and interpretable diagnostic tool.}
}
@article{KHAN2026116331,
title = {Fractional-order compartmental model integrated with artificial neural networks for measles transmission dynamics: A case study of Australia},
journal = {Applied Soft Computing},
volume = {203},
pages = {116331},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116331},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017795},
author = {Usman khan and Cun Chen},
keywords = {Measles dynamics, Fractional modelling, Artificial Neural Networks, Numerical Simulation},
abstract = {Measles remains a highly contagious viral disease and a serious public health challenge. Despite the availability of an effective vaccine, waning immunity, incomplete vaccine coverage, and underreported infections continue to reduce control efforts. These issues highlight the need for an intelligent computational framework to support epidemiological decision-making and strengthen prevention strategies. This study proposes a fractional-order measles model integrated with an artificial neural network framework. The model is developed to more accurately capture the complex, nonlinear and memory effects that are inherent in the epidemiological process. This approach bridges analytical fractional modelling with neural network computation, and its performance is evaluated using MSE, RMSE, and MAE values. In addition, the key fundamental properties of the fractional model, including existence and uniqueness of solution, equilibrium analysis, basic reproduction number and Hyers-Ulam stability, are examined while the model parameter is estimated via least square technique using measles data from Australia spanning 1997–2022. The estimated reproduction number is 0.9096, indicating that disease transmission remains effectively controlled under the current conditions. The ANN not only enhance computational efficiency but also preserves the essential dynamics feature of fractional modelling. It is also observed that the small deviation from the integer order behaviour significantly influences measles dynamics, emphasizing the necessity of a fractional framework for accurate and reliable approximation of measles transmission dynamics.}
}
@article{QI2026116255,
title = {Pseudo-label semi-supervised feature selection based on adaptive peak hyper-interval granulation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116255},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116255},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017035},
author = {Zhaohui Qi and Xubin Lu},
keywords = {Partially labeled data, Semi-supervised feature selection, Adaptive peak hyper-interval granulation, Soft pseudo-label, Soft membership degrees},
abstract = {Feature selection is an effective technique for high-dimensional data reduction. In real-world data mining tasks, datasets often contain only a small number of labeled samples and many unlabeled samples due to the high cost of annotation. Semi-supervised feature selection provides a promising solution for such partially labeled data. However, existing local neighborhood rough set methods are often limited by fixed parameters, while inaccurate pseudo-labels may mislead discriminative feature selection. Moreover, directly integrating original labeled samples and pseudo-labeled samples may bias feature evaluation. To address these issues, this paper proposes a pseudo-label semi-supervised feature selection method based on adaptive peak hyper-interval granulation. Specifically, the Shannon entropy of the potential density distribution is introduced to adaptively determine the optimal scale for locating local potential density peaks and constructing hyper-interval granules. These granules are then used to generate soft pseudo-labels for unlabeled samples and construct class-wise soft membership degrees. A feature evaluation strategy is further designed for mixed data consisting of original labeled samples and soft pseudo-labeled samples. Experiments on multiple datasets indicate that the proposed method achieves competitive or improved performance on the considered datasets for partially labeled data.}
}
@article{YIN2026116307,
title = {Multi-modal dual-stream deep learning with cross-consistency constraints for low-loss jujube strip harvesting},
journal = {Applied Soft Computing},
volume = {203},
pages = {116307},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116307},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017552},
author = {Hang Yin and Longpeng Ding and Xiyang Li and Mingxia Liang and Keyi Jiang and Jianji Wang and Xingguo Wang and Xudong Lu and Lidan Shang and Hongfei Yang and Jingbin Li},
keywords = {Machine vision, Low loss harvest, Multimodal, Consistency constraint, Impurity detection},
abstract = {Accurate assessment of impurity content in jujube strips is critical for low-damage mechanical harvesting, yet existing systems mainly rely on RGB appearance alone and therefore fail to perceive occluded light impurities and the internal granular state of the strip. This study proposes JIED-Net, a multi-modal dual-stream network with cross-consistency constraints that jointly exploits jujube strip images and sample weight for six-level impurity grading and closed-loop regulation of negative-pressure fan power. In JIED-Net, the primary image-weight stream embeds the scalar weight cue into visual features through weight-guided feature modulation and stratified hybrid attention, while the auxiliary saliency stream provides cross-scale impurity maps and global context. Cross-consistency learning between the two streams suppresses spurious activations and mitigates over-reliance on weight cues. Experiments on 2824 jujube strip images annotated into six impurity grades, using a structured acquisition-block hold-out split into train/validation/test subsets, show that over 5 independent runs with different random seeds, JIED-Net achieves an accuracy of 94.9 ± 0.3% (95% CI: 94.5–95.3) and a Macro-F1 score of 95.7 ± 0.2% (95% CI: 95.4–96.0), outperforming Transformer-based and CNN-based baselines by approximately 3–8 %age points. Field tests on an edge-computing harvester prototype further show that the grade-to-fan-power closed loop updates within 125 ms, remains stable under abrupt grade transitions, and reduces fruit breakage to 6.01%. These results demonstrate a practically deployable “impurity perception–grade evaluation–power regulation–operation execution” route for autonomous low-loss jujube harvesting. The shareable data are available:https://github.com/Y1SHAI/JIED-Net}
}
@article{HUANG2026116368,
title = {A global-local deep decoupling and alignment framework for zero-shot industrial anomaly detection with vision-language models},
journal = {Applied Soft Computing},
volume = {203},
pages = {116368},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116368},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626018168},
author = {Zequan Huang and Erhu Zhang and Zhujun Zhang and Zhiqian He and Yunjing Liu and Yajun Chen},
keywords = {Industrial anomaly detection, Zero-shot anomaly detection, Vision-language models, Prompt learning, Parameter-efficient adaptation},
abstract = {Industrial anomaly detection is essential for intelligent quality control, yet existing methods often rely on domain-specific normality modeling and show limited generalization ability for unseen defect patterns and diverse manufacturing environments. Although recent Vision-Language Models (VLMs) have enabled zero-shot industrial inspection by transferring semantic knowledge from large-scale image-text pre-training, they often struggle to balance image-level semantic discrimination with pixel-level defect sensitivity, leading to suboptimal anomaly detection and localization under complex industrial conditions. To address this issue, we propose a global-local decoupling and alignment framework for zero-shot industrial anomaly detection. Particularly, the proposed method employs a dual-branch architecture with deep textual prompts and lightweight residual adapters to enhance domain adaptation while preserving the transferable priors of CLIP. Furthermore, a two-stage training strategy is presented to decouple global semantic anchoring from local defect-sensitive alignment, which can improve image-level detection and pixel-level localization in a coordinated manner. Extensive experiments on representative industrial benchmarks, including MVTec AD, VisA, BTAD, MPDD, and MVTec LOCO AD, demonstrate that the proposed framework achieves the best average image-level AUROC and pixel-level AUROC among representative zero-shot CLIP-based methods, while maintaining strong image-level discrimination and pixel-level localization performance across diverse industrial scenarios. These results indicate that decoupling global semantic learning from local anomaly alignment is a promising direction for zero-shot industrial anomaly detection.}
}
@article{YU2026116266,
title = {Mechanism-conditioned hierarchical decision modeling for fine-grained and resilient fault diagnosis of tunnel boring machine main bearings},
journal = {Applied Soft Computing},
volume = {203},
pages = {116266},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116266},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601714X},
author = {Chuanbo Yu and Xukai Miao and Mingyu Yue and Zhiyao Zhang and Peng Guo and Jianfeng Yang},
keywords = {TBM main bearings, Long-tailed fault diagnosis, Hierarchical reinforcement learning (HDQN), Decision support, Fault severity},
abstract = {For Tunnel Boring Machines (TBM) main bearings, practical fault diagnosis extends beyond coarse fault-type recognition to characterize both fault mechanisms and degradation severity for maintenance intervention and tunneling-parameter adjustment decisions. This fine-grained task is further complicated by three structural difficulties: severity assessment is physically meaningful only under a specific fault mechanism, the resulting mechanism–severity classes exhibit severe long-tailed imbalance, and hierarchical inference is susceptible to irreversible cascade errors. Conventional flat classifiers cannot adequately address these structural difficulties, as they treat fault type and severity as independent, parallel labels and offer no mechanism for revising intermediate errors. To address these limitations, this paper proposes a mechanism-conditioned hierarchical reinforcement learning framework, termed the Hierarchical Dueling Double Deep Q-Network (H-D3QN), which reformulates the diagnosis task as a goal-conditioned sequential decision process. A high-level Type Agent identifies the fault mechanism, and a low-level Severity Agent then infers the degradation level within the physically correct context. Three key designs support this framework: hierarchical decision decomposition for mechanism-conditioned severity inference, a frequency-aware reward design with a first-order analytical basis for approximately reducing class-frequency-induced optimization bias, and a mechanism-conditioned out-of-distribution (OOD) verification strategy that rejects physically inconsistent intermediate hypotheses and converts cascade errors into a revisable inference process. Experiments on a long-tailed TBM main bearing dataset show that H-D3QN achieves an overall accuracy of 88.11% while maintaining a balanced diagnostic profile across head, medium, and tail classes.}
}
@article{BI2026116287,
title = {STDFormer: A spatial-temporal decoupled transformer for joint 3D pose estimation and continuous action segmentation in athletics training videos},
journal = {Applied Soft Computing},
volume = {203},
pages = {116287},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116287},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017357},
author = {Ran Bi and Jicheng Yang and Bailin Yan and Hongrui Cao and Zihan Zhou},
keywords = {Motion Segmentation, 3D Human Pose Estimation, Transformer, Graph Attention Network},
abstract = {Existing sports video systems assess athlete performance through action understanding and 3D human pose estimation. However, sports action models often rely on clip-level or task-agnostic representations that limit dense framewise localization, while pose estimation pipelines do not always encode physiological range-of-motion constraints and may become unreliable under rapid motion and occlusion. Moreover, these tasks are commonly optimized independently or connected only through generic shared features, leaving their geometric and temporal complementarity underused. We present STDFormer, a unified soft-computing perception framework for joint 3D pose estimation and continuous action segmentation in athletics training videos. STDFormer integrates biomechanical structure directly into shared spatiotemporal representation learning. Its Biomechanics Prior-Guided Graph Attention Network encodes kinematic-chain, joint-angle, and bilateral-symmetry priors as trainable attention biases, providing soft guidance that balances visual evidence with physiological structure under occlusion. Spatial-Temporal Decoupled Attention models intra-frame skeletal relations and inter-frame joint trajectories in parallel, while adaptive element-wise gating integrates the two branches. The resulting representation is decoded by a lightweight MLP head for 3D joint coordinates and by the Hierarchical Continuous Action Segmentation decoder for framewise action labels and boundary confidence scores. Joint training enables both tasks to benefit from the shared representation within a single forward pass. Experiments on two video benchmarks show that STDFormer outperforms independently trained single-task baselines in both pose estimation and continuous action segmentation.}
}
@article{GAO2026116040,
title = {Robust nonlinear functional link minimum total error entropy adaptive filtering algorithm for nonlinear active noise control},
journal = {Applied Soft Computing},
volume = {203},
pages = {116040},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116040},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014882},
author = {Yuan Gao and Haiquan Zhao},
keywords = {Total least squares, Functional link artificial neural network, EIV model, Minimum error entropy, Nonlinear active noise control},
abstract = {Considering the distortions introduced in signal transmission channels under the Errors-in-Variables (EIV) model, the Total Least Squares (TLS) method has been widely adopted due to its ability to minimize the squared total error. However, TLS tends to underperform in non-Gaussian noise environments, as it fails to fully exploit the statistical characteristics of the noise. To address this limitation, a novel Minimum Total Error Entropy (MTEE) criterion is proposed by combining the strengths of the TLS and Minimum Error Entropy (MEE) frameworks, enabling more effective handling of the EIV model under non-Gaussian noise conditions. Building on the MTEE criterion, a Functional Link Artificial Neural Network (FLANN) structure is employed to model the nonlinear characteristics of the system, resulting in the development of the MTEE-FLANN algorithm. Furthermore, recognizing the high computational complexity typically associated with MEE-type algorithms, a quantized variant, referred to as the QMTEE-FLANN algorithm, is proposed to significantly reduce computational demands while maintaining performance. In addition, theoretical analyses regarding the convergence behavior, step-size stability range, and computational complexity of the proposed algorithms are presented to support their practical deployment. To validate the applicability and robustness of the developed methods, experiments are conducted under a nonlinear Active Noise Control (ANC) framework based on the EIV model. The results demonstrate the superior performance and strong robustness of the proposed algorithms compared to existing approaches.}
}
@article{TANG2026116263,
title = {A two-stage forecasting and location–routing optimization model for medical waste management under storage risk control},
journal = {Applied Soft Computing},
volume = {203},
pages = {116263},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116263},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017114},
author = {Chu Tang and Yifei Xu and Lizhen Qiu and Yizhi Fang and Mingke Xu and Qu Wei and Kang Li},
keywords = {Medical waste management, Medical waste forecasting, Adaptive large neighborhood search, Long short-term memory model, Storage risk control},
abstract = {The rapid growth of medical waste has raised serious concerns about public health and environmental safety, highlighting the need for efficient and sustainable waste management systems. To address these challenges, this study develops a two-stage framework that integrates medical waste generation forecasting with location-routing optimization. In the first stage, coefficient-based linear estimation model and an enhanced long short-term memory network are respectively applied to forecast waste generation for small-to-medium and large healthcare institutions. The second stage establishes a two-echelon location–routing model that incorporates forecasting uncertainty, periodic and time-dependent travel conditions, heterogeneous facility scales, storage risks, and service time windows. A hybrid clustering–optimization approach is developed, integrating an improved K-means algorithm within an adaptive large neighborhood search framework to jointly address depot selection and routing under complex operational constraints. Extensive computational experiments on benchmark datasets and real-world data from Chinese medical facilities demonstrate the framework’s effectiveness in improving solution quality, computational efficiency, and scalability for large-scale, real-world applications.}
}
@article{GHANI2026116315,
title = {SpatioLiverNet: A multi-scale spatial attention network with adaptive deformable convolutions for robust liver segmentation in ultrasound signals},
journal = {Applied Soft Computing},
volume = {203},
pages = {116315},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116315},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017631},
author = {Muhammad Ahmad Nawaz Ul Ghani and Muhammad Usman Saeed and Naila Latif and Amjad Hussain Zahid and Ghulam Ali and Weidong Wang and Qingxian Wang},
keywords = {Liver segmentation, Ultrasound signal processing, Multi scale spatial attention, Deformable convolutions, Deep learning, Medical image segmentation, Feature extraction},
abstract = {Accurate liver segmentation from ultrasound images is essential for diagnosing and monitoring liver diseases, including tumors and cirrhosis. However, ultrasound based segmentation remains challenging due to the inherent signal characteristics, including speckle noise, a low signal-to-noise ratio, motion artifacts, and the complex and irregular morphology of liver tissues. To address these challenges, we propose SpatioLiverNet, a deep learning architecture that integrates multi scale spatial attention mechanisms with adaptive deformable convolutional networks to enhance feature extraction and boundary delineation in noisy ultrasound signals. The architecture incorporates three key modules: Feature Attention with Convolutional Block Attention Module (FA-CBAM), Multi Scale Spatial Channel Attention (MSSCA), and Multi Scale Spatial Attention (MSSA). These modules enable selective feature enhancement by focusing on clinically relevant regions while overcoming noise and imaging artifacts. Adaptive deformable convolutions further improve the geometric flexibility of the model, allowing for the accurate segmentation of irregular liver boundaries and lesions. Training was optimized using a composite loss function that combined the Dice, focal, and boundary losses to balance the region overlap, hard sample learning, and contour precision. Evaluated on a dataset of 2500 annotated ultrasound images, SpatioLiverNet achieved state-of-the-art performance with a Dice Similarity Coefficient (DSC) of 97.43% and Intersection over Union (IoU) of 97.01%. Five-fold-cross-validation demonstrated robust generalization across diverse ultrasound acquisition conditions, confirming the clinical applicability of the model. The proposed architecture provides a reliable and automated solution for liver segmentation in ultrasound based diagnostic workflows. To support transparency, independent verification, and future extension of this work, the complete implementation of SpatioLiverNet, including the model architecture, preprocessing pipeline, training and evaluation scripts, and configuration files, is publicly available.}
}
@article{ALI2026116355,
title = {A complexity-driven resampling approach for imbalanced learning},
journal = {Applied Soft Computing},
volume = {203},
pages = {116355},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116355},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601803X},
author = {Muhammad Asim Ali and Jun Liu and Samuel Moore and Omar Nibouche},
keywords = {Machine learning, Data complexity, Imbalanced data, Instance-level complexity, Data balancing},
abstract = {Imbalanced datasets pose significant challenges for machine learning (ML) models, which often lead to biased decisions and poor predictions for the minority class. While existing resampling methods address class imbalance, they sometimes neglect data complexity, which can lead to suboptimal performance in complex distributions. To address this, we propose a complexity-driven resampling method using two-stage clustering. For the majority class, K-Means and hierarchical clustering identify and remove extremely hard-to-classify samples based on complexity measures. For the minority class, K-Means clustering is applied first, and then new samples are generated within each cluster based on cluster complexity. The aim of this approach is to balance the datasets while preserving their inherent distribution. By employing different clustering methods at various stages, the method effectively captures clusters of diverse shapes and sizes, thereby enhancing clustering performance on complex datasets. The proposed method is then evaluated using three popular ML models on 27 public datasets from KEEL and four additional datasets from Kaggle using a rigorous 5-fold cross-validation protocol. The results show that the method significantly improves ML classifiers’ performance for imbalanced datasets, achieving the best average F1-Scores and Recall, alongside highly competitive G-Mean and AUC scores, compared to traditional baselines and recent state-of-the-art resampling techniques. This study indicates that dataset complexity significantly affects the performance of most ML models, indicating that careful consideration should be given when choosing resampling strategies for ML models when the dataset becomes more complex. Ultimately, the proposed method provides a highly reliable framework for real-world scenarios characterized by severe class overlap and noisy feature spaces, ensuring that underlying data structures are preserved during the resampling process.}
}
@article{TANG2026116250,
title = {Shadow-aware 3D Gaussian splatting via Lambertian-guided neural masking},
journal = {Applied Soft Computing},
volume = {203},
pages = {116250},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116250},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016984},
author = {Shan Tang and Wenhua Qian and Peng Liu},
keywords = {3D Gaussian splatting, Novel view synthesis, Shadow removal, Lambertian reflectance, Robust rendering},
abstract = {Recently, 3D Gaussian Splatting (3DGS) has demonstrated impressive performance in novel view synthesis due to its efficient explicit scene representation and real-time rendering. However, its reconstruction quality significantly degrades when accidental shadows are present in the input images. We observe that 3DGS tends to misinterpret shadow regions as view-dependent reflectance, such as specular highlights or Fresnel effects, leading to artifacts in synthesized views. To address this issue, we propose a shadow-aware optimization framework that explicitly identifies and suppresses accidental shadows during training. Specifically, we first extract candidate shadow masks from shadow-free renderings to provide coarse shadow localization. A Residual-driven Neural Classifier (RNC) is then used to refine these masks by modeling photometric inconsistencies. Furthermore, a Lambertian Reflectance Loss (LR Loss) is applied within the detected shadow regions to regularize view-dependent components and prevent the misinterpretation of shadows as specular effects. Extensive experiments demonstrate that our method effectively eliminates shadow-induced artifacts while preserving geometric consistency and rendering quality. Compared with vanilla 3DGS, our approach achieves improved reconstruction quality across multiple datasets, while maintaining the high optimization efficiency of 3DGS. Our project is available at https://tang-shan.github.io/ShadowGS.}
}
@article{ZACARON2026116323,
title = {Unsupervised anomaly detection in software-defined networks via BiGAN-based traffic reconstruction and explainable artificial intelligence},
journal = {Applied Soft Computing},
volume = {203},
pages = {116323},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116323},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017710},
author = {Alexandro M. Zacaron and Mateus Komarchesqui and Daniel M. Brandão Lent and Vitor G. da Silva Ruffo and Luiz F. Carvalho and Mario Lemes {Proença Junior}},
keywords = {Anomaly detection, BiGAN, SHAP, XAI, Unsupervised learning},
abstract = {The increasing reliance on computer networks across various environments underscores the critical need for effective intrusion detection mechanisms. In this manner, this paper presents an unsupervised anomaly detection system for Software-Defined Networks (SDN) based on traffic reconstruction using Bidirectional Generative Adversarial Networks (BiGAN). The proposed system operates in three phases: data collection and preprocessing, anomaly detection through traffic reconstruction and thresholding, and mitigation by blocking malicious IP addresses via dynamic updates to trust and blocklist entries. The system was evaluated using two public datasets, achieving high accuracy and robustness, particularly when utilizing the most significant traffic feature identified via SHapley Additive exPlanations (SHAP) explainability technique. Results demonstrated our IDS’s capability to differentiate between normal and anomalous traffic. Additionally, the system’s effectiveness in mitigating attacks reached more than 93% of malicious flows, while ensuring minimal or no impact on legitimate traffic in both datasets. These findings highlight the system’s effectiveness in SDN environments, offering a consistent solution for proactive network anomaly detection and response.}
}
@article{LI2026116303,
title = {A ConvTransformer-based rapid measurement method for torsional stiffness of rotate vector reducers},
journal = {Applied Soft Computing},
volume = {203},
pages = {116303},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116303},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017515},
author = {Chaoyang Li and Hao Liu and Xianglong Kong and Keyin Jiang and Tenglong Jia and WeiKai Gu},
keywords = {RV reducer, Torsional stiffness measurement, Rapid measurement, Data processing, ConvTransformer},
abstract = {Rotate vector (RV) reducers, as core driving components of industrial robots, have torsional stiffness that directly affects the precision and stability of robotic systems. Conventional torsional stiffness measurement methods require cyclic loading to the rated torque, recording torque and angle values during loading and unloading, and processing these data to compute torsional stiffness. However, this traditional method exhibits drawbacks such as prolonged loading time, equipment complexity, and low efficiency, which have become significant bottlenecks in high-volume measurement of RV reducers. To address these limitations, based on an analysis of the RV reducer torsional stiffness theoretical model, a rapid measurement method is proposed using deep learning in this study. Firstly, small sample data within a range considerably lower than the rated torque is collected. Then, a novel ConvTransformer cooperative network is constructed, which integrates the local feature extraction capability of convolutional neural networks and the global temporal modeling advantage of Transformer networks, enabling the reconstruction of the full-range hysteresis curve from the collected low-torque data to accurately calculate the torsional stiffness. Comparative experiments are conducted on six brand new RV reducers. The results demonstrate that, when a torque-angle dataset is collected at 20% of the rated torque, the proposed rapid measurement method can estimate the torsional stiffness of the tested reducers with mean relative error maintained below 5%. Compared with the conventional cyclic loading test performed across the full rated torque range, the measurement efficiency is improved by more than fivefold, and the method can satisfy industrial demands for large-scale production, rapid, and precise RV reducer measurement.}
}
@article{JU2026116267,
title = {Graph neural network enhanced large language model for commonsense question answering},
journal = {Applied Soft Computing},
volume = {203},
pages = {116267},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116267},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017151},
author = {Shenggen Ju and Xingyue Li and Baoxing Jiang and Li Chen},
keywords = {Large language model, Commonsense question answering, Knowledge graph, Dynamic knowledge selection, Verification-based reasoning},
abstract = {To enhance the factual accuracy and reasoning reliability of Large Language Models (LLMs) in Commonsense Question–Answering (CSQA) tasks, incorporating external Knowledge Graphs (KGs) to enhance their factual accuracy has emerged as a prominent research direction. However, existing approaches often suffer from irrelevant or erroneous knowledge introduced by context-agnostic retrieval and fail to effectively utilize graph topological structures, leading to the loss of critical information required for reasoning. To address these challenges, we propose a Two-stage Graph Neural Network Enhanced LLM (TGEL) framework, which is driven by a knowledge selector and a knowledge-guided reasoner. In the question-aware knowledge extraction stage, we first obtain structure-aware node representations through our designed graph encoder, GAT-DG, which captures complex relations via dynamic edge features and gated bilinear interaction. These representations are then used to compute the semantic similarity between triples and the question context, enabling the selection of the most relevant knowledge. In the knowledge-guided answer reasoning stage, we introduce a verification-based reasoning framework that constructs independent choice prompts for each candidate answer. This guides the LLM to integrate external explicit knowledge with its internal implicit knowledge to assess the correctness of individual answers, ultimately selecting the one with the highest confidence. Experiments on benchmark datasets demonstrate that TGEL not only improves the accuracy of the Llama-3-8B base model by 5.57% but also outperforms various mainstream knowledge-enhanced methods. Our proposed architecture, which ranges from dynamic knowledge selection to verification-based answer reasoning, is an effective approach for improving the robustness and transparency of model reasoning.}
}
@article{BETKIER2026116271,
title = {Service-effort trade-offs in large-scale bike-sharing rebalancing: A hierarchical reinforcement learning framework with imitation-based warm-starting},
journal = {Applied Soft Computing},
volume = {203},
pages = {116271},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116271},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017199},
author = {Igor Betkier and Philipp Otto and Damian Wierzbicki and Kinga Karwowska},
keywords = {Bike-Sharing Systems, Rebalancing Problem, Reinforcement Learning, Convolutional Neural Networks, Urban Mobility},
abstract = {Large-scale Bike-Sharing Systems (BSS) exhibit spatiotemporal demand imbalances that challenge real-time control. Although Deep Reinforcement Learning (DRL) offers adaptivity, flat city-wide controllers face combinatorial action spaces and unstable training. We propose a bi-level framework separating local spatial encoding and potential intra-region stabilization from global inter-region coordination. Regional agents encode inventory, pressure, and weather through multi-channel heatmaps and Convolutional Neural Networks (CNNs), while a masked actor-critic policy allocates bicycles between regions. The global controller is initialized by Behavior Cloning (BC) from a heuristic teacher and refined by reinforcement learning (RL) using a cost-aware service–effort reward. The Warsaw Veturilo system (365 stations, May–November 2023) is a high-baseline setting: passive operation already achieves 89.21 ± 0.51% service rate. A five-seed ablation shows that tabula rasa RL is unstable, whereas BC-initialized variants remain stable in service rate and substantially reduce the incidence of extreme relocation regimes. BC-only achieved the highest mean city-wide service rate (89.47 ± 0.50%), while BC + RL achieved a comparable rate (89.36 ± 0.41%) with approximately 41% lower relocation volume than BC-only. A dedicated representation ablation further shows that the CNN-based hybrid encoder yields no statistically significant service-rate advantage over a vector-only baseline; its value lies in providing a fixed-size, spatially structured, and scalable state encoding rather than in measurable performance gains. Overall, the framework combines scalability, training stability, and lower relocation effort at comparable service quality.}
}
@article{LI2026116282,
title = {Replay-free lifelong visible-infrared person re-identification based on domain expert and privacy-preserved memory},
journal = {Applied Soft Computing},
volume = {203},
pages = {116282},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116282},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017308},
author = {Zhiyong Li and Haojie Liu and Jiayu Wang and Mingyu Wang and Wei Jiang},
keywords = {Lifelong learning, Visible-infrared person re-identification, Intelligent surveillance},
abstract = {Visible-Infrared Person Re-identification (VI-ReID) was proposed to address cross-modal image retrieval in 24-hour surveillance systems and has been extensively studied. However, current research primarily focuses on single-dataset training, with limited attention to domain shifts and continual learning challenges in real-world applications. This paper investigates Lifelong Visible-Infrared Person Re-identification (LVI-ReID), which requires simultaneously addressing cross-modal discrepancies and cross-domain learning while mitigating catastrophic forgetting. Current lifelong learning methods for VI-ReID primarily rely on storing replay samples. However, storing such data may expose source-domain pedestrian privacy, while repeated replay training may hinder adaptation to new domains. To this end, this paper proposes a Domain Expert with Privacy-Preserved Memory (DE-PPM) learning mechanism. We employ a continually updated Base Layer for shared representation learning and introduce a lightweight domain-specific Expert Layer for each incoming domain. We employ a contrastive loss based on both intra-modal centers and hybrid centers to simultaneously address intra-modal and cross-modal discrepancies. Additionally, a small number of domain style samples are generated and stored to train an Expert Selector for inference, which mitigates privacy risks while eliminating historical identity replay. Extensive experiments demonstrate that the proposed method outperforms state-of-the-art (SOTA) lifelong learning approaches as well as SOTA LVI-ReID methods.}
}
@article{LI2026116334,
title = {PR-Net: Pyramid refinement network for unsupervised industrial defect localization},
journal = {Applied Soft Computing},
volume = {203},
pages = {116334},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116334},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017825},
author = {Zijian Li and Wenhui Chen and Ze Luo},
keywords = {Industrial defect detection, Unsupervised anomaly localization, Normalizing flows, Attention mechanism, Heatmap refinement},
abstract = {Industrial anomaly localization remains challenging because defects may be subtle, anomaly scores are easily affected by background variations, and accurate boundary localization is required for practical inspection. Normalizing-flow-based methods provide high-resolution localization without relying on external pretrained backbones, but pyramid-flow frameworks may still exhibit limited latent feature discriminability, noise-sensitive anomaly responses, and over-smoothed heatmaps. In this paper, we propose the Pyramid Refinement Network (PR-Net), a PyramidFlow-based framework that refines three stages of the localization pipeline through the Multi-Layer Attention Module (MLAM), Score Residual Module (SRM), and Edge-Aware Refinement Module (EAR). MLAM enhances multi-scale latent representations through parallel channel and spatial reweighting. SRM calibrates anomaly scores using normal residual statistics and a Gaussian-inspired empirical gating strategy without assuming strict normality. EAR performs parameter-free Laplacian-guided refinement to enhance high-frequency boundary responses. Experiments on MVTec AD, BTAD, and VisA demonstrate that PR-Net consistently improves the PyramidFlow baseline. PR-Net achieves mean Pixel-AUROC/AUPRO scores of 97.7%/96.6% on MVTec AD, 98.1%/80.0% on BTAD, and 97.9%/94.5% on VisA. Ablation and qualitative results further show that the three components provide complementary benefits for latent feature enhancement, anomaly-score calibration, and boundary-aware heatmap refinement.}
}
@article{JEONG2026116245,
title = {PPIE-Net: Physics-inspired parametric input embedding for data-efficient surrogate modeling of parametric simulations},
journal = {Applied Soft Computing},
volume = {203},
pages = {116245},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116245},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016935},
author = {Yong Jin Jeong and Taesup Moon},
keywords = {Data-efficient learning, Differential equations, Input embedding, Neural operators, Surrogate modeling},
abstract = {Differential equations (DEs) are essential for modeling and simulating complex physical processes in engineering. While traditional numerical methods provide high-fidelity solutions, their prohibitive computational cost for repeated parametric studies hinders real-time engineering evaluation. Recently, deep learning-based models have emerged as efficient alternatives; however, their architectural complexity and heavy reliance on massive datasets often limit their practical tractability, leading to high solution costs in data-constrained engineering applications. To address these challenges, this research proposes a novel neuro-computing surrogate framework incorporating a Physics-inspired Parametric Input Embedding (PPIE) scheme. By explicitly encoding the multiplicative interactions between spatiotemporal coordinates and physical parameters, PPIE introduces a powerful architectural inductive bias that mirrors fundamental physical scaling laws, achieving enhanced robustness with minimal network scale. We demonstrate that the proposed PPIE-Net with a minimalist Multi-Layer Perceptron (MLP) architecture matches or outperforms state-of-the-art neural operators and physics-informed models, such as DeepONet, Fourier Neural Operators (FNO), Convolutional Neural Operators (CNO), and Parametric Physics-Informed Neural Networks (P-PINNs), particularly in extreme data-scarce scenarios (N≤20). Our results across five representative DE domains—including a complex 3D laser processing application—show that the proposed framework enables accurate predictions even in such data-constrained environments with significantly reduced computational overhead; this facilitates real-time system modeling, engineering analysis, and optimization. This work offers a highly efficient, robust, and scalable soft computing pathway for real-world multi-physics engineering problems.}
}
@article{LYUBKA2026116345,
title = {An extended agent-based Physarum polycephalum Model with repellent-driven behaviour},
journal = {Applied Soft Computing},
volume = {203},
pages = {116345},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116345},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601793X},
author = {Dmytro Lyubka},
keywords = {, Voronoi diagram, Euclidean Steiner tree, Optimisation, Unconventional computation},
abstract = {Physarum polycephalum is a remarkable single-celled amoeboid organism that exhibits unique computational capabilities during its plasmodium phase. Various algorithms have been developed to simulate its behaviour, including an agent-based model by Jones (2010) that effectively mimics the organism’s pattern-forming abilities and can approximate solutions to certain distance-based problems. However, the original algorithm lacks the mechanisms required to appropriately model responses to repellent stimuli, limiting its applicability to more complex environments. To address these limitations, we propose an enhanced version of the algorithm that incorporates a unified representation of attractants and repellents, along with a refined set of agent sensory and movement rules enabling active repulsion and dynamic speed adjustment. These enhancements significantly improve performance on problems the original algorithm could already solve, while also enabling it to solve problems it previously could not. This is demonstrated using the Euclidean Steiner tree problem and the Voronoi diagram problem. While the original algorithm can approximate solutions to the Euclidean Steiner tree problem, a high-population, non-mass-conserving variant of the extended algorithm achieves equally accurate approximations while converging up to 2.87 times faster. Moreover, the original algorithm fails to approximate Voronoi diagrams, whereas the extended algorithm successfully generates notably accurate approximations. Although the proposed modifications do not strictly adhere to the physical laws governing biological Physarum, these deliberate deviations significantly improve the algorithm’s effectiveness as a computational tool for solving Euclidean optimisation problems, potentially improving its applicability to problems such as spatial partitioning, network formation, and obstacle avoidance.}
}
@article{SURI2026116330,
title = {An adaptive lifelong incremental learning framework for power quality disturbance detection under concept drift},
journal = {Applied Soft Computing},
volume = {203},
pages = {116330},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116330},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017783},
author = {Vansh Suri and Neelu Nagpal and Ravi Sharma and Sunil Kumar and Pierluigi Siano and Hassan Haes Alhelou},
keywords = {Lifelong incremental learning, Power quality disturbance classification, Catastrophic forgetting, Concept drift},
abstract = {The expeditious rise in renewable penetration, inverter-based resources, electric vehicle charging infrastructure, and evolving load composition has driven significant concept drift and new power quality disturbance (PQD) patterns in modern power grids. As a result, contemporary static classifiers become progressively ineffective. To address this challenge, this paper proposes an adaptive lifelong incremental learning framework unified with drift detection and physics-based interpretability for PQD detection and classification under concept drift. Within a unified closed-loop classification architecture, four incremental learning strategies are systematically investigated: Fine-Tuning, Elastic Weight Consolidation (EWC)-Only, Replay-Only, Hybrid (with two additional configurations of Hybrid-Abrupt and Hybrid-Mixed). The Hybrid strategy combines EWC, herding-based coreset replay, knowledge distillation, prototype regularization, and dark experience replay (DER), together with a dynamically expandable classification head. These methods are evaluated on a testbed of 20 PQDs divided into four tasks. Among the four basic strategies, the Hybrid method achieves the maximum accuracy (96.80±0.35%) with a forgetting rate of just 1.46±0.57% and a Macro F1 of 0.81±0.01, validated across three seeds. A comparative analysis against continual learning baselines—iCaRL, GEM, DER++, ER-ACE, and Cumulative-Oracle—demonstrates the competitive performance of the Hybrid approach. For drift detection, a KNN-embedded technique is evaluated against the established ADaptive WINdowing (ADWIN) and Drift Detection Method (DDM) techniques and is found to consistently achieve superior performance under evolving disturbance conditions. The proposed models use a ResNet-MLP-based encoder backbone; to validate its strength, the Hybrid method is additionally examined using Plain-MLP, Deep-MLP, MLP-No-BN, Transformer-Encoder, CNN-1D, and CNN-LSTM encoders. Physics-aligned features—root-mean-square (RMS) voltage and total harmonic distortion (THD)—serve dual roles as interpretable monitoring metrics and drift attribution indicators. A detailed computational complexity analysis is conducted, covering time, space, computational (FLOPs), and sample/scalability complexity. The six frameworks are further assessed under 27 noise scenarios spanning 9 categories—Pink and Brownian noise, additive white Gaussian noise (AWGN), impulsive noise, load harmonics, non-stationary mixed noise, communication signal drop, environmental flicker, and measurement bias. For the first time in the PQD literature, a comprehensive bifurcation analysis identifies the regime boundaries governed by EWC weight λ and noise intensity σ, complemented by a parametric sensitivity analysis of the proposed models. All six models are further exposed to (i) grid topology and (ii) renewable and power-electronics disturbance scenarios for realistic, system-level examination. Finally, validation on the XPQRS benchmark dataset (four tasks) shows the Hybrid-Mixed model achieving the best accuracy of 85.75% with a forgetting rate of just 1.50%. The complete framework was further validated through Processor-in-the-Loop (PIL) testing on a Raspberry Pi 5, confirming functional correctness of the full inference pipeline under embedded execution with an inference latency of approximately 0.15 ms/sample and a memory footprint of only 0.40 MB. Altogether, the developed models offer an effective, interpretable, and computationally-efficient approach for PQD detection under evolving grid conditions, providing a standard of comparison for future approaches in PQD analysis.}
}
@article{WU2026116310,
title = {Integrated multi-objective optimization algorithm for energy aggregator and new energy vehicle market interaction scheduling},
journal = {Applied Soft Computing},
volume = {203},
pages = {116310},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116310},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017588},
author = {Bo Wu and Xiuli Wang and Xifan Wang and Baoguo Shan and Chengcheng Shao and Ziyang Su},
keywords = {Multi-objective optimization, Market interaction regulating, Energy aggregator, New energy vehicle, Pareto-based conflict adjudication},
abstract = {With the accelerating global shift toward carbon neutrality and the rapid adoption of new energy vehicles, developed regions are entering a phase of heightened energy demand. This evolution has introduced a competitive dynamic between energy aggregators and new energy vehicle owners, underscoring the need for effective regulatory oversight. This study models the trading relationship between energy aggregators and new energy vehicle owners as a constrained, nonlinear multi-objective optimization problem. The model accounts for both electricity and hydrogen transactions, incorporating contract and spot market interactions with upstream suppliers, along with the diverse charging schedules of new energy vehicles. To manage the model’s complexity, simplification strategies were applied, and an integrated algorithm, I-IMTCMO-BS, was proposed. Experimental results show that the algorithm generated 285 high-quality approximate Pareto solutions, outperforming 12 benchmark multi-objective optimization algorithms in feasibility and dominance. Furthermore, a market supervision mechanism based on Pareto classification is introduced to evaluate transaction outcomes providing positive, acceptable, or unacceptable as a basis for informed regulatory intervention. Overall, the research offers a full-process analytical framework and algorithmic toolkit for market regulators tasked with managing the emerging dynamics between energy aggregators and new energy vehicle owners—an issue poised to become increasingly relevant in the global clean energy transition.}
}
@article{ZOU2026116197,
title = {Content-guided influence maximization via multi-modal knowledge graphs and large language models},
journal = {Applied Soft Computing},
volume = {203},
pages = {116197},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116197},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016455},
author = {Yingqi Zou and Huicheng Jiang and Guanyu Li and Bo Ning and Jingmin An and Wenhao Li},
keywords = {Influence maximization, Social network, Large language model, Multi-modal knowledge graph},
abstract = {Influence Maximization (IM) aims to identify key users (seeds) to maximize information diffusion in social networks. However, existing approaches seldom explore how content semantics interact with user preferences to guide personalized diffusion. This work defines the Content-Guided Influence Maximization (CGIM) problem, which unifies structural influence estimation and semantic relevance optimization within a single framework. To address CGIM, we propose MIA, a retrieval-augmented influence analysis framework that integrates multi-modal structural modeling, influence estimation, and retrieval-augmented generation using large language models (LLMs). Specifically, MIA constructs a multi-modal knowledge graph to capture user-content relations, estimates content-aware susceptibility via contrastive learning, and optimizes propagation through a multi-layer influence maximization algorithm before executing retrieval-augmented content generation. Experiments on four datasets show that MIA effectively balances diffusion efficiency and semantic alignment, providing a unified and interpretable solution for CGIM in heterogeneous social networks.}
}
@article{DANG2026116249,
title = {An independence-cooperation-competition framework for constrained multi-objective optimization},
journal = {Applied Soft Computing},
volume = {203},
pages = {116249},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116249},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016972},
author = {Qianlong Dang and Haoming Zhang and Wenliang Wu and Shaowu Li and Ruihuan Luo and Xinyu Feng and Ruoxi Qin},
keywords = {Constrained multi-objective optimization, Independence-cooperation-competition framework, Dual-distance diversity mechanism, Operator competition strategy},
abstract = {Constrained multi-objective optimization problems necessitate the simultaneous optimization of multiple conflicting objectives under given constraints. The multitasking-inspired approach of employing auxiliary populations to assist the main population has gained prominence in constrained multi-objective evolutionary algorithms (CMOEAs). Nevertheless, current CMOEAs struggle to adaptively utilize information from auxiliary populations during the entire evolutionary process, resulting in the waste of function evaluations. To address this problem, this paper proposes an independence-cooperation-competition framework for constrained multi-objective optimization. In the independence stage, the three populations evolve to explore the objective space quickly. In the cooperation stage, populations are divided into sub-populations for sharing information, and a dual-distance diversity mechanism is designed, which can help populations escape from the local feasible regions while taking diversity into account. In the competition stage, two auxiliary populations compete and select the one that performs better to help the main population evolve. Moreover, the operator competition strategy is designed to automatically select the best operator based on the problem characteristics, thereby accelerating the convergence of the population while achieving minimal numbers of function evaluations. Comprehensive experiments are conducted on 33 test problems and 6 real-world problems. The results demonstrate that the proposed algorithm is more competitive than seven other state-of-the-art CMOEAs on 17 test problems and 6 real-world problems.}
}
@article{KUMARI2026116286,
title = {Hybrid permutation-coded genetic algorithms and parallel implementations for the drone safety-aware electric vehicle traveling salesman problem},
journal = {Applied Soft Computing},
volume = {203},
pages = {116286},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116286},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017345},
author = {Ritesh Kumari and Sakshi Goyal and Amrata Gill and Prem Prakash Vuppuluri and Patvardhan Chellapilla},
keywords = {EVTSP, No-hovering, Drone, Genetic algorithm, Last-mile delivery},
abstract = {Logistics companies are focusing more on integrating electric vehicles and drones in modern last-mile delivery systems. However, in multi-modal vehicle routing systems, synchronization between vehicles remains an important issue. In coordinated electric truck–drone operations, one vehicle often arrives earlier at a rendezvous point and must wait for the other. Current approaches focus on minimizing the waiting time however, drone hovering while waiting is still an issue. Drones are unable to hover for long without a safe landing facility due to battery limitations. In such scenarios, a drone might even crash because of energy depletion. Therefore, ensuring drone-safe synchronization between electric vehicles and drones is crucial. The paper addresses this synchronization challenge by proposing a Drone Safety-aware Electric Vehicle-Traveling Salesman Problem (DS-EVTSP) that aims to minimize total operational time. The proposed DS-EVTSP formulation ensures that the EV always arrives first, thereby ensuring that the drone never hovers in wait-mode. A hybrid Permutation-encoded Genetic Algorithm (PGA) and five hybrid variants are proposed for solving the DS-EVTSP. The variants employ different seeding approaches based on the nearest neighbor, nearest insertion, and Minimum Spanning Tree (MST) heuristics. Further, a MiniBatch clustering-based PGA is designed to solve DS-EVTSP and is further hybridized with the MST heuristic. The performance of the proposed algorithms is analysed on two datasets and compared with recent state-of-the-arts. The results demonstrate that PGA variants are effective in minimizing operational time. The adaptive island-model parallel implementation of the PGA effectively reduces the computational time while preserving the operational time. The experimental analysis shows that hybridized genetic models have a potential to provide efficient solutions for green transportation.}
}
@article{XIAN2026116274,
title = {Enhanced physics-informed network model for design of shape memory alloy variable friction pendulum bearings},
journal = {Applied Soft Computing},
volume = {203},
pages = {116274},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116274},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017229},
author = {Zhibin Xian and Ping Tan and Wenzhi Zheng and Kui Yang and Yuze Zheng and Jiajun Tan},
keywords = {Artificial neural network, Variable friction pendulum bearing, Shape memory alloy, Hyperparameter optimization, Enhanced physics-informed},
abstract = {To enhance the efficiency and reliability of seismically isolated bearings design, this study proposes a design method based on an enhanced physics-informed neural network (EPINN), aiming to expedite the design of seismic isolators. According to the mechanical model for shape memory alloy variable friction pendulum bearing (SMA-VFP), a systematic mechanical performance design method is developed. Subsequently, a hyperparameter optimization method for the neural network in seismically isolated design is presented grounded in Bayesian theory. A comprehensive dataset encompassing a wide range of characteristics of SMA-VFP bearings is generated using the proposed mechanical performance design method, serving as a case study to evaluate the effectiveness and reliability of the proposed model. The case study results demonstrate that the EPINN model outperforms both traditional physics-informed neural network models and standard artificial neural networks. Specifically, it achieves a maximum reduction of 35.1% in pure data loss, 78.9% in physics-informed loss, and 91.5% in physical constraint loss, with the reliability of the bearing design reaches up to 96.6%. By incorporating a design-oriented physics-constrained loss term, EPINN effectively reconciles physical principles with design objectives even when data-driven loss computation is unavailable, offering a distinct advantage over conventional ANN and PINN approaches that lack such constraints.}
}
@article{KUMAR2026116326,
title = {Unsupervised deep neural network for second-order multipoint boundary value systems: Theory and computation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116326},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116326},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017746},
author = {Rakesh Kumar and B.V. {Rathish Kumar} and Anil Rathi and Nazia Urus and Chitranjan Pandey and Dipak Kumar Sahoo},
keywords = {Multipoint boundary value problem, Physics-informed neural networks, Deep neural network, High order quadrature scheme, Convergence analysis},
abstract = {Physics-Informed Neural Networks (PINNs) provide a flexible framework for solving boundary value problems (BVPs) by embedding the governing equations into the loss function. In this study, we introduce a Deep Neural Network for solving the system of multipoint BVPs (DNN-SMPBVP) in an unsupervised framework by building an apt L2 loss function following the PINNs approach. For the convergence analysis of DNN-SMPBVP the error is decomposed into two fundamental contributions: the training error and the quadrature error. Under the assumption of well-posedness of SMPBVP, we show that the L2 norm of the DNN-SMPBVP solution error is bounded by a stability constant multiplied by the sum of the discrete interior and boundary losses and quadrature/sampling errors due to approximating residual norms at the finite collocation points of DNN-SMPBVP. For smooth residuals with deterministic composite rules (e.g., midpoint ), we derive classical rates, where the quadrature error decays as O(N−α/2) with α=2. For DNN-SMPBVP residuals with nonsmooth activations such as ReLU the effective convergence rate deteriorates to α=1, while for Monte Carlo sampling, the error decays in probability as O(N−1/2). This unified framework highlights the dual role of training accuracy and collocation density in controlling the overall DNN-SMPBVP approximation error, and explains why smoother activation functions and higher-order quadrature schemes often yield superior accuracy.}
}
@article{MA2026116302,
title = {Maximum information entropy loss: Concentrated on high-quality restoration of salient regions for single-image super-resolution},
journal = {Applied Soft Computing},
volume = {203},
pages = {116302},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116302},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017503},
author = {Congcong Ma and Xiangqing Liu and Jiaqi Mi},
keywords = {Single-image super-resolution, Salient regions, Maximum information entropy loss, Convolutional neural networks},
abstract = {In recent years, deep learning-based models have achieved remarkable progress in single-image super-resolution. However, existing methods tend to emphasize overall reconstruction quality while paying insufficient attention to fine detail recovery in salient regions, resulting in suboptimal performance in scenarios where such regions are critical. To address this limitation, this paper proposes a super-resolution method based on a maximum information entropy strategy, aiming to enhance the model’s capability to restore visually salient regions. Specifically, we first propose an adaptive saliency region identification method based on maximum information entropy to locate regions with the highest information density. Then, a maximum information entropy-driven loss function is constructed to guide the model toward high-quality reconstruction and detail preservation in these regions. Furthermore, the proposed strategy is modularized into a plug-and-play component, enabling seamless integration into existing models. Finally, an SPSNR metric is designed to more reasonably evaluate the restoration performance of the model. Extensive experiments are conducted on multiple public datasets, where the proposed component is applied to several representative models. Experimental results demonstrate that the proposed method consistently outperforms state-of-the-art approaches in terms of reconstruction quality, detail preservation, and visual consistency, validating its effectiveness and generalization capability.}
}
