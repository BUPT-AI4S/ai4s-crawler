@article{WANG2026116211,
title = {AFSCN: Adaptive fusion and separable convolution network for continual COPD diagnosis on EIT time series},
journal = {Applied Soft Computing},
volume = {203},
pages = {116211},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116211},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016595},
author = {Laichen Wang and Jian Yao and Pengjiang Qian and Chenglong Fu and Chuang Wang and Yang Wu and Weiwei Fu and Zhanjun Zhang},
keywords = {Chronic obstructive pulmonary disease, Electrical impedance tomography, Time-series classification, Transfer learning, Adaptive updating},
abstract = {Deploying AI for Chronic Obstructive Pulmonary Disease (COPD) screening in clinical practice requires not only high accuracy under static settings but also robust adaptation to EIT data streams affected by evolving cohorts, devices, and acquisition protocols. Electrical Impedance Tomography (EIT) is a radiation-free, real-time modality with strong potential for COPD assessment; however, learning representations that remain discriminative under noise and cross-domain shifts is still challenging. To address this issue, we propose the Adaptive Fusion and Separable Convolution Network (AFSCN), a lightweight architecture for EIT time-series classification that is designed for data-distribution adaptation. AFSCN integrates MASC and TFSC as the core temporal feature extractors and introduces Continual Adaptive Time Pooling (CATP) as an adaptation-aware temporal aggregation module that can be efficiently updated when new data become available. On a clinical COPD dataset, AFSCN achieves 99.02% balanced accuracy. On 10 University of East Anglia (UEA) benchmarks, AFSCN attains an average accuracy of 77.9%, indicating strong cross-domain transferability. AFSCN is also computationally efficient, requiring only 1.13M parameters and 0.15G FLOPs, which supports deployment in resource-constrained scenarios. Overall, these results demonstrate that AFSCN provides an effective and practical framework for adaptive COPD monitoring.}
}
@article{LIU2026116195,
title = {Fuzzy multi-granularity granular-balls approach to decision-theoretic rough sets: A three-way decision perspective and applications},
journal = {Applied Soft Computing},
volume = {203},
pages = {116195},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116195},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016431},
author = {Peide Liu and Abbas Ali and Nakhla Ahmad and Noor Rehman},
keywords = {Granular-ball, Three-way decision, Decision-theoretic rough set, Conditional probability},
abstract = {Granular-ball computing is a potent paradigm for managing uncertainty because it allows for both interpretability and flexibility in data processing. Granular-ball computing automatically removes noise and preserves local consistency while capturing data structures at multiple granularity levels, unlike traditional fuzzy rough set methodologies that only employ pairwise fuzzy connections. This study introduces a novel fuzzy multi-granularity granular-ball decision-theoretic rough set (FMG-GB-DTRS) framework to address noise, uncertainty, and adaptability challenges in three-way decision models. To ensure data integrity and local structural consistency, a granular-ball methodology is first constructed using a purity mechanism derived from fuzzy β-co-neighborhoods provided by experts. A granular-ball fuzzy neighborhood framework is created to improve neighborhood representation by giving samples from different granular-balls zero similarity, maintaining significant local connections while removing noise. Expanding upon these frameworks, we provide a thorough noise-handling system that functions cooperatively at three levels: multi-granularity decision approximations controlled by α and δ, purity-constrained granular structures, and expert-provided β-co-neighborhood similarity relations. By utilizing fuzzy sets, granular-ball adaptivity, and the DTRS optimization principle, we develop a strong three-way decision paradigm that can produce dependable, adaptable, and risk-aware decisions in intricate, noisy settings. Finally, experiments are executed out on nine data sets to verify the efficacy of the suggested method, and the outcomes are contrasted with seven existing techniques. Several assessment criteria, including Accuracy, Precision, Rand Index, Recall, and F1-Score, are used to assess the performance of the suggested approach. Additionally, robustness analysis is carried out at various noise ratios from 10% to 40%. The experimental findings show that for large-scale data decision-making challenges, the suggested approach delivers competitive and steady performance.}
}
@article{QIU2026116167,
title = {A novel multimodal cross-attention method for corporate financial risk prediction},
journal = {Applied Soft Computing},
volume = {203},
pages = {116167},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116167},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016157},
author = {Jing Qiu and Zhi Xiao and Wei Xu and Yan Pang},
keywords = {Financial risk, Multimodal data, Image market data, Cross-attention},
abstract = {The Stock trend charts encode fine-grained market dynamics and investor reactions, yet their potential remains largely underexplored in corporate financial risk prediction (FRP). Existing studies predominantly rely on numerical financial indicators and textual disclosures, such as annual reports, which may fail to fully capture complex and rapidly evolving risk signals. In this study, we propose a tri-modal FRP framework that jointly leverages numerical financial ratios, textual information, and stock trend chart images. To effectively integrate these heterogeneous data sources, we develop a novel multimodal cross-attention framework comprising three distinct fusion strategies that explicitly model inter-modal interactions and enable complementary information to be fully exploited. Extensive experiments demonstrate that the proposed approach consistently outperforms state-of-the-art methods, achieving accuracy improvements of 0.8%–3.9% and gains of 0.6%–3.8% in the area under the receiver operating characteristic curve (AUC). Moreover, interpretability analysis reveals that image-based market features exert a stronger influence on prediction outcomes than textual disclosures, highlighting the critical role of fine-grained market dynamics in financial risk assessment. These findings provide both theoretical and practical insights into FRP, demonstrating the value of image-based market data and advanced multimodal fusion for more accurate, transparent, and robust risk modeling within the examined market setting.}
}
@article{LI2026116219,
title = {Semi-supervised domain adaptive night scene semantic segmentation method based on data mixing},
journal = {Applied Soft Computing},
volume = {203},
pages = {116219},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116219},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016674},
author = {Canlin Li and Wenjiao Zhang and Xin Tan and Haowen Su and Lizhuang Ma},
keywords = {Night scene semantic segmentation, Semi-supervised domain adaptation, Data mixing},
abstract = {To tackle the major challenges of limited labeled data, significant domain gaps, and class imbalance in nighttime scene semantic segmentation, this paper proposes a semi-supervised domain adaptation approach based on data mixing. The method generates new training samples by mixing image data from labeled source domains (e.g., daytime images) and a small number of labeled target domains (e.g., nighttime images), and uses them for subsequent model training. Specifically, two data mixing strategies are designed in this paper: the first strategy is a random mixing strategy, which enhances the diversity of data by randomly selecting category pixels in the source domain to be mixed with the nighttime samples; the second strategy is the guided mixing strategy, which addresses class imbalance by selectively integrating underrepresented classes from the source domain (daytime images) into the target domain (nighttime images). Comprehensive experimental results demonstrate that the proposed method enhances the accuracy of nighttime scene semantic segmentation with reduced reliance on real nighttime labeled data, achieving superior performance on both the Night Driving-test and ACDC-night test sets. The code will be available at https://github.com/ssw219/Seg_Mix.}
}
@article{ZHOU2026116175,
title = {Multi-granularity context guided hierarchical association for UAV-platform multi-object tracking},
journal = {Applied Soft Computing},
volume = {203},
pages = {116175},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116175},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016236},
author = {Meng Zhou and Rui Li and Shuting Ning and Zhiyu Liu},
keywords = {Unmanned aerial vehicle, Multi-object tracking, Multi-granularity context, Hierarchical matching, Trajectory correction},
abstract = {Multi-object tracking (MOT) from unmanned aerial vehicle (UAV) platforms remains challenging due to small object scales, severe camera motion, and frequent occlusions. Existing methods mainly rely on appearance and motion cues, but ignore the static and motion contexts that are highly correlated and complementary to each other in UAV scenes, thereby limiting their tracking performance. Motivated by this, we propose a Multi-Granularity Context guided Hierarchical Association (MGCHA) framework that learns a unified representation of static and motion contexts and performs difficulty-aware hierarchical matching. Specifically, we introduce a multi-granularity context mining module that leverages diverse receptive fields and distance-adaptive pooling to capture both long- and short-range frame features, constructing a fused representation that enhances object representation by integrating static scene context and dynamic motion patterns. Moreover, the difficulty-aware hierarchical matching strategy enables progressive association from high-confidence to low-confidence detections, complemented by a proximity-based trajectory correction mechanism that recovers trajectories interrupted by motion prediction errors. This compensates for the limitations of traditional two-stage association methods in trajectory recovery and improves tracking robustness under complex occlusion conditions. Extensive experiments on the VisDrone and UAVDT benchmarks demonstrate that the proposed method achieves significant improvements in both tracking accuracy and trajectory integrity, validating its effectiveness in complex UAV tracking scenarios.}
}
@article{PENG2026116227,
title = {General interval-valued Mamdani fuzzy reasoning method and its application},
journal = {Applied Soft Computing},
volume = {203},
pages = {116227},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116227},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016753},
author = {Xiaoyu Peng and Yexing Dan and Siyu Xu and Xiaodong Pan},
keywords = {Mamdani fuzzy reasoning, General interval-valued overlap function, Interval-valued overlap index, Robustness, Financial time series forecasting},
abstract = {Fuzzy reasoning has proven effective in handling real-world uncertainty, yet classical interval-valued Mamdani methods often struggle with information loss and limited flexibility in complex decision scenarios. To address these limitations, we propose an enhanced fuzzy reasoning framework that incorporates general interval-valued overlap functions and interval-valued overlap indices, enabling more nuanced representation of uncertain information. Our key insight is twofold: general interval-valued overlap functions enable the reasoning system to better capture the interactions among fuzzy variables, while interval-valued overlap indices can more effectively measure the degree of consistency between fuzzy sets. Together, these enhancements directly improve the reliability of reasoning under uncertain conditions. We theoretically establish the reductivity and robustness properties of the proposed method, providing guarantees for its stable performance. To demonstrate practical value, we evaluate our method on five real-world financial time series forecasting tasks. Results show that our approach achieves significantly higher prediction accuracy than existing benchmarks, suggesting its potential for risk-sensitive applications such as investment decision-making and market volatility prediction.}
}
@article{ZHANG2026116183,
title = {PhysCISC: A process-credibility weighted self-consistency voting framework for physics reasoning with large language models},
journal = {Applied Soft Computing},
volume = {203},
pages = {116183},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116183},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016315},
author = {Tingyu Zhang and Yan Cen},
keywords = {Large language models, Physics reasoning, Chain-of-thought prompting, Weighted self-consistency voting, Process-credibility, Physics multiple-choice benchmark},
abstract = {Self-consistency (SC) improves chain-of-thought prompting by sampling multiple reasoning paths and voting, but it often requires many samples. Confidence-Informed Self-Consistency (CISC) reduces this cost by weighted voting using an outcome-confidence signal such as P(True); for physics, this signal can overweight confident but flawed derivations. We propose PhysCISC, a process-credibility weighted self-consistency framework for physics reasoning. PhysCISC retains the same inference-time aggregation structure as CISC while replacing outcome-confidence weights with a rubric-derived process-credibility score for the observable reasoning chain. We evaluate three open-source LLMs: Qwen2.5-7B-Instruct, Llama-3.2-3B-Instruct, and Mistral-7B-Instruct-v0.3. We also build a Chinese physics multiple-choice benchmark of 3848 questions (six domains; five reasoning types) curated from printed problem books. On this main set, PhysCISC is broadly comparable to CISC overall (48.98% vs. 48.81%), with model- and budget-dependent gains and losses. Signal-quality analyses show that process-credibility and P(True) are complementary rather than redundant: a same-pool two-signal diagnostic indicates non-overlap between the two signals, and difficulty/domain/type decompositions show distinct subsets where each signal is preferable. We further evaluate on three public physics benchmarks converted to the same four-option format: UGPhysics NV&EX (600), SciBench-Physics (267), and MMLU-Physics (488); public-benchmark transfer is mixed, indicating that process-credibility is a complementary process-oriented scoring signal rather than a universal replacement for the outcome-confidence signal. A limited manual reasoning-chain inspection and process-shape ablations further suggest that process-credibility is not reducible to answer length or step count. The dataset and reproducible code are released on Zenodo.}
}
@article{MADDALI2026116235,
title = {Short-term power load forecasting using convolutional and quantum long short-term memory networks with attention},
journal = {Applied Soft Computing},
volume = {203},
pages = {116235},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116235},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016832},
author = {Anil Kumar Maddali and Venkaiah Chintham},
keywords = {Short-term load forecasting, CNN, QLSTM, Attention mechanism, Smart grid, Hybrid deep learning, Time- series features},
abstract = {Accurate short-term load forecasting (STLF) is crucial for the efficient operation of power systems and intelligent smart grid management. In this work, a novel CNN–QLSTM–Attention framework is proposed, which combines convolutional neural networks for feature extraction, quantum-inspired long short-term memory (QLSTM) for temporal sequence modeling, and an attention mechanism for adaptive feature weighting. The proposed model is evaluated using real-world load demand data and compared with several benchmark deep learning models, including LSTM, GRU, BiLSTM, RNN, and 1DCNN. Experimental results demonstrate the superior forecasting capability of the proposed framework, achieving an RMSE of 35.327, MAE of 29.708, MAPE of 2.76%, and an R2 value of 0.967. Compared with conventional models, the proposed approach significantly reduces prediction errors while maintaining stable and consistent performance under varying load conditions. Furthermore, rolling window cross-validation and statistical analyses validate the robustness and generalization ability of the model. Overall, the results confirm that the proposed CNN–QLSTM–Attention framework provides an accurate, reliable, and effective solution for short-term load forecasting applications in modern smart grids.}
}
@article{CHEE2026116146,
title = {DAS-SK: An adaptive model integrating dual atrous separable and selective kernel CNN for agriculture semantic segmentation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116146},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116146},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015942},
author = {Mei Ling Chee and Thangarajah Akilan and Aparna Ravindra Phalke and Kanchan Keisham},
keywords = {Deep learning, Land cover analysis, Precision agriculture, Remote sensing, Semantic segmentation},
abstract = {Semantic segmentation in high-resolution agricultural imagery demands models that strike a careful balance between accuracy and computational efficiency to enable deployment in practical systems. In this work, we present DAS-SK, a lightweight semantic segmentation framework that integrates selective kernel (SK) attention into a dual atrous separable convolution (DAS-Conv) module to enhance adaptive multi-scale feature representation while maintaining low computational complexity. In addition, an enhanced atrous spatial pyramid pooling (ASPP) module is introduced to jointly capture fine-grained local structures and broader contextual information. Built upon a modified DeepLabV3 architecture with complementary MobileNetV3-Large and EfficientNet-B3 backbones, DAS-SK is designed to improve feature extraction and contextual reasoning without incurring substantial computational overhead. Extensive evaluations on three benchmark datasets, namely LandCover.ai, VDD, and PhenoBench, demonstrate that DAS-SK consistently achieves superior segmentation performance compared with representative convolutional neural networks (CNNs), transformer models, and hybrid approaches. Notably, DAS-SK attains up to 21× fewer parameters and 19× fewer GFLOPs than leading transformer architectures, while maintaining competitive or superior segmentation accuracy. Furthermore, the proposed model achieves a favorable accuracy-efficiency trade-off, making it well suited for real-time deployment on unmanned aerial vehicles (UAVs), agricultural robots, and edge-computing devices. These results demonstrate that DAS-SK provides a robust, scalable, and computationally efficient solution for agricultural monitoring, remote sensing analysis, and other high-resolution semantic segmentation applications.}
}
@article{PAN2026116171,
title = {An event-aware and physics-guided multimodal framework for short-term photovoltaic power forecasting},
journal = {Applied Soft Computing},
volume = {203},
pages = {116171},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116171},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016194},
author = {Weihua Pan and Minghao Yin and Yi Zhang and Xianao Wang and Yupeng Tian},
keywords = {Photovoltaic power forecasting, Short-term forecasting, Multimodal learning, Physics-guided proxy features, State-space models},
abstract = {Short-term photovoltaic (PV) power forecasting under rapidly evolving cloud conditions remains a critical challenge due to pronounced nonstationarity, the scarcity of extreme events, and limited event-level interpretive capability in purely data-driven models. To address these issues, this study proposes a Physics-guided Image-prior and Event-Conditioned Multimodal Mamba framework (PI-ECM-Mamba) for modeling short-term PV power dynamics through event-conditioned representation learning tailored to rapid cloud-transition processes. A physics-guided sky-image proxy encoder is designed to derive solar geometry, cloud attenuation indicators, and brightness-distribution features, while a time-frequency PV encoder combined with an event-aware finite-state machine captures ramping dynamics and labels Pre-Occlusion, Occlusion, Recovery, Stable, and Extreme segments. To alleviate data imbalance under rare disturbance scenarios, conditional diffusion is introduced as a training-stage rare-event augmentation strategy for both PV sequences and sky images. On this basis, an event-gated cross-modal Mamba backbone is developed to couple multimodal representations and event-state embeddings for joint PV power regression and auxiliary event-state classification. Extensive experiments on the SKIPP’D sky-image PV dataset demonstrate that PI-ECM-Mamba consistently outperforms representative Mamba-based, Transformer-based, convolutional, machine-learning, and state-space baselines across multiple error metrics, while maintaining robust performance over prediction horizons ranging from 5 to 60min. Event-wise evaluations, ablation analysis, efficiency assessment, and cross-site and cross-year validation further confirm the robustness and generalization capability of PI-ECM-Mamba. With fewer than one million parameters and millisecond-level inference latency, the proposed framework provides a physics-guided, event-aware, and deployment-efficient solution for short-term PV power forecasting.}
}
@article{DIAO2026116260,
title = {MFF-Diff: A multi-level feature fusion conditional diffusion model for PET/CT tumor segmentation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116260},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116260},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017084},
author = {Zhaoshuo Diao and Manyu Cui and Ye Yuan and Guoyu Tong and Yen-Wei Chen},
keywords = {Tumor segmentation, PET/CT, Diffusion model, Loss-guided cross-modal fusion},
abstract = {Recently, Denoising Diffusion Probabilistic Models (DDPMs) have shown strong potential for improving the accuracy of PET/CT tumor segmentation. However, existing methods often neglect modality-specific features and introduce conditional cues only through fixed fusion schemes, limiting their ability to fully exploit the complementary strengths of PET and CT throughout the diffusion process. To overcome these limitations, we propose MFF-Diff. Specifically, MFF-Diff introduces a modality-specific feature encoding module to enhance the representation of metabolic hotspots and anatomical boundary details. Building on this, it further employs a two-stage, task-aware conditional fusion strategy that adaptively adjusts cross-modal fusion weights guided by feedback from the primary segmentation loss. Furthermore, we design a global-structure fusion layer to enhance long-range dependency modeling and global structural awareness. Experiments on the HeadNeck and STS datasets demonstrate that MFF-Diff consistently outperforms state-of-the-art methods. Specifically, MFF-Diff achieves Dice scores of 68.05% and 80.31% on the HeadNeck and STS datasets, respectively, outperforming the best-performing competing method by 2.57 and 3.34 percentage points. The corresponding Sensitivity scores are 81.59% and 86.22%, and the Precision scores are 67.54% and 73.44%.}
}
@article{YUAN2026116231,
title = {Spatially directional dual-attention graph networks for fine-grained PM2.5 mapping},
journal = {Applied Soft Computing},
volume = {203},
pages = {116231},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116231},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016790},
author = {Da Yuan and Zheng Wang and Hao Huang and Zunwei Fu and Qingyan Wu and Seongtae Jhang and Witold Pedrycz},
keywords = {PM, Fine-grained mapping, Dual-graph learning, Directional edge embedding, Spatial consistency},
abstract = {Accurate fine-grained PM2.5 mapping from sparse monitoring networks remains challenging because station observations are irregularly distributed, pollutant dynamics are shaped by heterogeneous spatial dependencies, and local emission patterns may create sharp spatial gradients. Existing interpolation, sequence-learning, and graph-based models often rely on a single distance-based graph or direction-agnostic message passing, which can conflate geographical proximity with feature-level semantic similarity and may produce locally fragmented concentration fields. To address these limitations, this paper proposes a Spatially Directional Dual-Attention Graph Network (SDDAG-Net) for a unified one-hour-ahead forecasting and fine-grained mapping task. The model constructs a fixed geographical graph from station coordinates and a dynamic feature-similarity graph from historical GRU embeddings, thereby separating physical proximity from time-varying inter-station affinity. Directional edge attributes are introduced in both branches: bearing and normalized distance are used in the geographical branch, while projected embedding-space direction is used in the feature branch. The two directional attention branches are combined through an element-wise fusion gate, and a Laplacian smoothness term is incorporated as a soft spatial consistency constraint to suppress spurious high-frequency artifacts without enforcing rigid physical assumptions. Experiments on New York State and the Beijing–Tianjin–Hebei region, covering approximately 0.30 million station-hour records from 2022 to 2023, show that SDDAG-Net achieves the lowest prediction errors and the highest correlation among the compared methods under the standard evaluation setting. The model also provides a favorable accuracy-efficiency trade-off. Additional cross-model evaluations under feature missingness, station outage, extreme-pollution periods, and high spatial heterogeneity show that SDDAG-Net obtains the lowest average RMSE rank in both regions. Its condition-specific advantage is strongest under feature missingness and extreme pollution in New York and under extreme pollution and high spatial heterogeneity in BTH, whereas high spatial heterogeneity in New York and incomplete-observation conditions in BTH remain comparatively challenging. These results demonstrate strong forecasting performance under the standard evaluation setting, a favorable accuracy–efficiency trade-off, and consistently competitive robustness without implying uniform superiority under every operating condition.}
}
@article{ZHOU2026116187,
title = {Trend-seasonal error stochastic diffusion for probabilistic load forecasting in high-RES grids},
journal = {Applied Soft Computing},
volume = {203},
pages = {116187},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116187},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016352},
author = {Ying Zhou and Shaopeng Guan},
keywords = {Probabilistic load forecasting, Load uncertainty quantification, Diffusion model, Trend anchoring, Real-time power dispatch},
abstract = {The large-scale integration of renewable energy sources (RES) has shifted power system operation from load-following to net-load-following, in which the net load—defined as electricity demand minus renewable generation—exhibits substantially increased variability. Under this paradigm, deterministic load forecasting alone is insufficient, as it cannot adequately characterize the heteroscedastic uncertainty introduced by intermittent renewable generation and propagated through downstream grid operations. To address this challenge, we propose TS-ESDM, a lightweight diffusion-based probabilistic load forecasting framework designed to support RES-aware operational decision-making. Rather than forecasting renewable generation directly, the proposed framework focuses on load uncertainty, a fundamental yet often overlooked source of variability in net-load balancing. By combining deterministic trend anchoring with diffusion-based residual generation, TS-ESDM produces high-quality probabilistic forecasts while maintaining low-latency inference. On the Anchorage dataset with a forecasting horizon of H=96, TS-ESDM achieves an MSE of 0.1085±0.0027 across three independent runs using only 0.45M parameters. Compared with the autoregressive diffusion baseline TimeGrad, TS-ESDM reduces inference latency by more than one order of magnitude (up to 36×) while remaining robust under the evaluated sensor-noise perturbations, demonstrating its potential for deployment in resource-constrained grid-edge environments.}
}
@article{WANG2026116214,
title = {Takagi–Sugeno fuzzy inference with kernel virtual cluster nodes for graph-based medical image classification},
journal = {Applied Soft Computing},
volume = {203},
pages = {116214},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116214},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016625},
author = {Ning Wang and Qi Zhang and Hui Zhang and Heqin Wang and Ding Weiping},
keywords = {Takagi–sugeno fuzzy inference, Kernel virtual cluster nodes, Semantic–topology fusion, Graph fuzzy systems, Medical image classification},
abstract = {Graph-based node classification has become an important paradigm for medical image analysis, yet conventional graph neural networks (GNNs) remain limited weak interpretability and by reduced robustness on graphs with noisy or low-homophily relational structures. Existing graph fuzzy systems (GFSs) embed fuzzy rules into graph models, but they share one key limitation: their fuzzy antecedents are fixed—either hand-designed or trainable only over a predetermined set of descriptors—so they cannot adapt when the underlying data distribution changes. We introduce KVCN-FGN, a Takagi–Sugeno fuzzy inference framework whose central novelty is a data-adaptive kernel-based fuzzifier: instead of reasoning over fixed fuzzy sets, the model induces data-driven semantic prototypes whose memberships act as adaptive fuzzy antecedents. A residual multi-hop propagation module first produces topology-aware node features compatible with diverse GNN backbones; a kernel virtual cluster node (KVCN) layer then adaptively refines virtual cluster centers and computes Gaussian-kernel soft memberships; and a Takagi–Sugeno rule layer with an attention-based fusion gate performs node-specific affine reasoning over these adaptive memberships while balancing semantic and structural evidence. On six MedMNIST datasets with GCN, GAT, and GIN backbones, KVCN-FGN consistently improves accuracy, macro F1-score, ROC-AUC, and MCC over strong GNN and neuro-symbolic baselines (e.g., 94.44% accuracy on OrganAMNIST), and it remains accurate as graph homophily decreases: on the lowest-homophily dataset (DermaMNIST) it attains 80.69% accuracy where the strongest fuzzy baseline reaches only 38.22%. The induced prototypes and rules further provide intrinsic, human-inspectable explanations.}
}
@article{ZHU2026116222,
title = {A multi-resolution dual-path network with domain separated attention for medical image segmentation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116222},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116222},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016704},
author = {Shujin Zhu and Yue Li and Can Wang and Tianyi Mao and Xiubin Dai},
keywords = {Medical image segmentation, Attention mechanism, Dual-path network, Hybrid attention, Multi-scale feature fusion},
abstract = {Due to the variability of target scales and anatomical complexity in medical images, accurate automatic segmentation remains a challenging task. To address this challenge, we propose a novel contextual dual-path segmentation network with multi feature resolutions that effectively extracts high-resolution spatial details through the full-resolution path and rich global semantic information through the U-shaped encoder-decoder path. In the full-resolution path, a Domain-Separated Hybrid Attention Module is designed to achieve quadrant-aware contextual features at the original input resolution by adopting a spatial decomposition and recomposition strategy. In the multi-scale semantic path, a lightweight Channel Attention Enhancement Module is employed to learn discriminative channel-wise feature representations. To promote feature communication and aggregate cross-scale information between the two paths, an Adaptive Cross Interaction Module is proposed by introducing a hierarchical multi-branch framework with hybrid attention mechanisms. Comprehensive experiments conducted on three medical image datasets (brain MRI, colonoscopy polyp images, and breast ultrasound images) validate the superiority of the proposed method in both quantitative and qualitative evaluations. Ablation studies further confirm the effectiveness of each proposed module in improving overall segmentation performance and model robustness. The code is available at https://github.com/zsj0577/MRDPNet.}
}
@article{YANG2026116225,
title = {A label-perspective survey of representation learning: Supervised to unsupervised methods, advances, applications and future prospects},
journal = {Applied Soft Computing},
volume = {203},
pages = {116225},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116225},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601673X},
author = {Xiao Yang and Hai Yuan and Zaiyu Pan and Jun Wang},
keywords = {Representation learning, Supervised representation learning, Semi-supervised representation learning, Unsupervised representation learning, Applications, Future prospects},
abstract = {With the rapid advancement of deep learning, representation learning has achieved remarkable success in a wide range of applications, including biometric recognition, autonomous systems, and specialized environmental perception. This survey provides a comprehensive review of representation learning from the perspective of label availability and supervision granularity, aiming to establish a unified understanding of how different supervisory settings influence representation learning objectives, optimization strategies, and generalization capabilities. It first reviews the evolution of representation learning by comparing traditional machine learning and deep learning in terms of learning paradigms, model characteristics, and loss functions. It then systematically examines representation learning according to different supervision settings. For supervised representation learning, different annotation granularities, including sample-level, region-level, pixel-level, and structured annotations, are analyzed to reveal how explicit supervision shapes representation learning across diverse tasks. For semi-supervised representation learning, mainstream approaches, including co-training, self-training, semi-supervised support vector machines, and semi-supervised generative adversarial networks, are reviewed, highlighting how labeled and unlabeled data are jointly exploited to improve representation learning. For unsupervised representation learning, representative approaches including clustering, dimensionality reduction, generative learning, and self-supervised mechanisms are discussed, emphasizing how meaningful representations can be learned without manually annotated labels. Since loss functions play a critical role in shaping learned representations, representative loss functions and their reported effects across different learning paradigms are further analyzed based on existing literature. Finally, recent advances, current challenges, and future research directions in representation learning are discussed to provide insights for subsequent studies.}
}
@article{XU2026116218,
title = {DPD-DG: Dual-physics-driven domain generalization network for rotating machinery fault diagnosis under variable working conditions},
journal = {Applied Soft Computing},
volume = {203},
pages = {116218},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116218},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016662},
author = {Pengfei Xu and Jinyu Zhao and Jinping Liu and Yimei Yang and Haidong Shao},
keywords = {Semi-supervised domain generalization (SSDG), Hybrid soft computing, Fault diagnosis, Uncertainty calibration, Dual physics-driven, Physics attention mechanism, Manifold alignment, Interpretability},
abstract = {Fault diagnosis of rotating machinery under variable working conditions is often hindered by severe distribution shifts. While existing semi-supervised domain generalization (SSDG) methods primarily rely on purely data-driven statistical alignment, they frequently struggle with the high uncertainty and imprecision induced by fluctuating operations. By largely overlooking deterministic kinematic mechanisms, these approaches tend to yield unreliable decision boundaries in unseen domains and lack physical interpretability. To address these critical bottlenecks, this article proposes DPD-DG, a novel dual-physics-driven domain generalization network. Serving as a hybrid soft computing framework, DPD-DG seamlessly integrates deterministic physical mechanisms with deep representations through a closed-loop synergy of feature perception, explicit constraints, and implicit verification. First, a Multi-domain Physical Prior Extraction and Adaptive Perception module is constructed to comprehensively capture kinematic cues; herein, heterogeneous normalization and Global Shared Physics-Aware Attention (SPA) are employed to distill domain-insensitive priors. At the explicit drive level, a physics-guided dynamic weight modulation scheme leveraging low-rank matrix decomposition is introduced to map kinematic state variations into classifier parameters, thereby preventing decision boundaries from overfitting to environmental noise. At the implicit drive level, a physics-semantic dual verification strategy is formulated to systematically reject high-confidence noisy samples that violate physical consistency during self-training, which effectively mitigates confirmation bias. Furthermore, a multi-level manifold alignment objective—incorporating point-to-point semantic associations and global second-order statistics—is designed to compress inter-domain discrepancies. Extensive experiments across six public benchmarks demonstrate that DPD-DG not only significantly outperforms state-of-the-art methods in terms of accuracy, F1-score, and MCC, but also affords profound physical interpretability, as validated by comprehensive visualization analyses.}
}
@article{ZHOU2026116174,
title = {Uncertainty-aware electricity load forecasting with deep temporal networks and optimized quantile fusion},
journal = {Applied Soft Computing},
volume = {203},
pages = {116174},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116174},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016224},
author = {Xiaohong Zhou and Najmul Hasan and Yukun Bao and Yanmei Huang and Haijun Huang and Changrui Deng},
keywords = {Uncertainty quantification, Temporal convolutional network, Bidirectional long short-term memory network, Quantile regression, Sequential least squares quadratic programming fusion},
abstract = {Electricity load forecasting faces persistent methodological challenges, including nonlinear load amplification under extreme conditions, inadequate representation of multi-scale spatiotemporal dependencies via traditional methods, and insufficient handling of inherent uncertainty in point forecasting. To address this issue, this study proposes an integrated deep-learning framework that combines a Temporal Convolutional Network (TCN) with a Bidirectional Long Short-Term Memory (BiLSTM) network for the enhanced modelling of complex temporal dynamics. The TCN employs causal and dilated convolutions to extract temporal features across multiple scales, while the BiLSTM captures bidirectional dependencies, thereby enabling improved representation of both historical information and proximate temporal context. To facilitate probabilistic forecasting, the framework incorporates a quantile regression (QR) module to produce forecasts at multiple quantile predictions, which are subsequently consolidated into coherent predictive distributions through a Sequential Least Squares Quadratic Programming (SLSQP) optimization scheme. The resulting TCN-BiLSTM-QR-SLSQP framework delivers both highly accurate point forecasts and robust prediction intervals. The proposed framework outperforms mainstream benchmarks by 10%–27% in terms of MAE, MAPE, and RMSE. In probabilistic terms, the approach achieves a Prediction Interval Coverage Probability (PICP) of 93.6% with a Mean Prediction Interval Width Ratio (MPIWR) of 4.63%, resulting in a substantial reduction (>8%) in the Quantile Interval Loss Score (QILS). Ablation analysis further demonstrates the contributions of each component: removal of the TCN results in a 23.8% increase in MAE, exclusion of BiLSTM elevates MAPE substantially, and excluding the QR module degrades interval prediction quality. Additional performance gains are realized through SLSQP-based quantile fusion.}
}
@article{YUE2026116226,
title = {A robust group decision-making framework for assessing industrial information platforms under uncertainty},
journal = {Applied Soft Computing},
volume = {203},
pages = {116226},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116226},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016741},
author = {Chuan Yue},
keywords = {Industrial information platform, Quality with periodicity, Complex intuitionistic fuzzy number, Inversion number, Normalized projection measure},
abstract = {Evaluating periodically upgraded systems like Industrial Information Platforms (IIPs) requires robust methods to synthesize uncertain, multi-expert judgments. This study develops a novel group decision-making (GDM) framework within a complex intuitionistic fuzzy environment. Methodologically, a median-based data center is proposed for robust consensus anchoring, an inversion-based measure is introduced to objectively quantify expert data quality, and a normalized projection measure is developed for reliable alternative ranking. Experimental validation with real-world IIP data demonstrates the framework’s superiority: the median center improves expert weight discrimination by 28.2% and reduces the standard deviation of alternative scores by 12.1% compared to a mean-based benchmark, providing more statistically consistent ranking foundations. The inversion measure achieves an 11-fold improvement over an entropy-based method in expert weight allocation, and Monte Carlo simulation confirms the difference is highly significant. The normalized projection enhances ranking stability by 37.5% and offers superior interpretability through its bounded [0,1] range. Comprehensive sensitivity analysis confirms the framework’s robustness, with the optimal alternative A2 maintaining its top-ranked position across all 11 attribute weight perturbation scenarios. Systematic comparison with the classical TOPSIS method reveals superior robustness: the proposed method achieves a 25% improvement in minimum separation and maintains its optimal alternative as the top-ranked platform in four out of five perturbation scenarios, while TOPSIS fails to preserve its baseline optimal alternative in all but one scenario. Comparison with the VIKOR method shows consistency in identifying the same optimal alternative (A2), but VIKOR’s ranking results are sensitive to the compromise coefficient, whereas the proposed method contains no subjective parameters. A dynamic stability experiment confirms that the final alternative ranking A2≻A1≻A4≻A3 remains perfectly consistent across a wide range of input parameter variations. The proposed framework provides a mathematically rigorous and highly stable tool for comprehensive system evaluation under uncertainty, with broader implications for service system optimization and decision science.}
}
@article{WANG2026116177,
title = {Deep reinforcement learning for distributed hybrid flow shop scheduling with deterioration effects using composite heterogeneous graph attention networks},
journal = {Applied Soft Computing},
volume = {203},
pages = {116177},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116177},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601625X},
author = {Ran Wang and Junqing Li and Zhaosheng Du and Zhongzhi Yang and Yanan Wang and Li Wei},
keywords = {Distributed hybrid flow shop, Deterioration effects, Deep reinforcement learning, Graph neural network, Attention mechanism},
abstract = {Distributed hybrid flow shop scheduling with deterioration effects (DHFSP-DE) is challenging due to the tight coupling among factory assignment, machine selection, and operation sequencing under deterioration effects. An effective and scalable decision-making framework is therefore developed capable of jointly modeling these interdependent factors and generating high-quality schedules. The DHFSP-DE is formulated as a Markov Decision Process, and a deep reinforcement learning (DRL) framework is proposed by integrating a Heterogeneous Composite Graph Attention Network (HCGAN) with a Proximal Policy Optimization (PPO). Factories, machines, and operations are modeled as distinct node types within a composite heterogeneous graph, encoding technological precedence, machine eligibility, factory allocation constraints, and deterioration evolution. Three-stage attention mechanism is employed to extract high-order dependencies, while a deterioration-aware feature module dynamically adjusts operation priorities, and a structured operation–factory–machine action space ensures feasibility. Computational experiments on 36 benchmark instances demonstrate that HCGAN consistently outperforms classical dispatching rules, representative metaheuristics, and a comparative DRL approach. Specifically, average makespan is reduced by 12–22% relative to dispatching rules, improvements of 5–10% are achieved over metaheuristics, and makespan values remain 3–8% lower than the comparative DRL method across small-, medium-, and large-scale instances. Near-optimal solutions are obtained for small instances where exact methods remain tractable, while inference efficiency is preserved for larger instances. These results indicate that the composite heterogeneous graph representation and multi-stage attention mechanism employed by HCGAN more effectively capture inter-factory precedence relationships and deterioration-induced dynamics than existing DRL models, providing a robust and scalable solution for DHFSP-DE.}
}
@article{BESDOK2026116234,
title = {eBee: An elite-guided artificial bee colony algorithm with stochastic mask-driven exploration for numerical and engineering optimization},
journal = {Applied Soft Computing},
volume = {203},
pages = {116234},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116234},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016820},
author = {Erkan Besdok},
keywords = {The eBee optimization algorithm, Swarm intelligence, Elite-guided search, Wind power plant micro-siting, UAV coverage path planning},
abstract = {Swarm intelligence algorithms have become essential tools for solving non-differentiable optimization problems. The canonical Artificial Bee Colony (ABC) algorithm, however, often suffers from slow convergence and limited exploitation, owing to its single-dimension perturbation mechanism and its purely random scout activation. To overcome these limitations, this study proposes the Elite-Guided Artificial Bee Colony Algorithm (eBee), a structurally enriched reformulation of the canonical ABC framework that integrates stochastic multi-dimensional perturbation, adaptive heavy-tailed scale generation, and an elite-guided search strategy into a single cohesive design. eBee employs a stochastic binary mask to perturb subsets of variables simultaneously and thereby capture inter-variable dependencies, while a heavy-tailed step-size generator, obtained by applying a random power transformation to random variates, provides a self-adaptive balance between local refinement and global exploration without additional parameter tuning. The onlooker phase is further strengthened by a power-law selection mechanism that biases the search towards elite solutions and accelerates convergence in promising regions. The proposed method was evaluated on the IEEE CEC 2005 and CEC 2022 benchmark suites and compared with ten state-of-the-art algorithms, namely ABC, CLPSO, EJAYA, IMODE-TMS, JADE, jDE, PSO, SADE, TSA, and UMODEAsIV. Its practical value was then demonstrated on two structurally distinct engineering problems: an energy-aware UAV coverage planning task and a levelized-cost micro-siting problem for a wind power plant, the latter solved by combining the eBee search operators with Deb’s parameterless feasibility rules. The experimental results show that eBee is statistically significantly superior on most complex multimodal and hybrid landscapes while remaining computationally competitive. Statistical validation based on the Wilcoxon signed-rank test with multiple-comparison correction confirms the robustness and consistency of the observed improvements. These findings establish eBee as an efficient and precise optimization framework for challenging numerical and engineering problems.}
}
@article{DUAN2026116230,
title = {MLPRNet: A multi-level pixel reconstruction approach for green fruit object detection in complex orchard environments},
journal = {Applied Soft Computing},
volume = {203},
pages = {116230},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116230},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016789},
author = {Zongtao Duan and Xing Sheng and Junzhe Zhang and Zhen Wang},
keywords = {Object detection, Feature fusion, Feature enhancement, External attention},
abstract = {Fruit recognition is a critical stage in intelligent orchard management. However, challenges such as strict seasonality, high labor costs, and low picking efficiency severely constrain the global fruit industry’s development.However, orchards are complex environments with problems such as overlapping fruit, shading, and variable light. These factors pose a significant challenge in accurately detecting the location of fruits. Existing studies have struggled to strike the right balance between detection efficiency and effectiveness. To this end, this paper proposes a green fruit detection method, MLPRNet, based on the fusion of the Multi-Level Pixel Reconstruction Module (MLPRM) for orchard environments. Specifically, we first design a Feature Enhancement Module (FEM) that enhances features using multi-branch pooling. Then, we propose an improved Pyramid Pooling Module (PPM) that aggregates and integrates information across different levels (e.g., low-level background information, texture details, and high-level semantic information). Finally, we propose the Feature Aggregation Module (FAM), in which we introduce External Attention, which computes the global correlation between two layers of features via two external storage units and combines them in a complementary way, enabling fusion of different feature levels for pixel-level reconstruction. We conducted extensive experiments on two real-world benchmark datasets (one is our collected dataset, and the other is a public dataset). The experimental results show that green fruits are detected with an average accuracy of 53.6% on the peach dataset. The model has 40.1 M parameters and 2.5 G memory, a significant advantage in accuracy and complexity compared with the other nine state-of-the-art models.}
}
@article{LIU2026116259,
title = {Unmanned aerial vehicle multi-object tracking based on cross-task shared feature and trajectory state transition},
journal = {Applied Soft Computing},
volume = {203},
pages = {116259},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116259},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017072},
author = {Tianruo Liu and Fuzhen Zhu and Zhiyuan Liu and Bing Zhu},
keywords = {Multiple object tracking, Unmanned aerial vehicle, Remote sensing, Joint detection and embedding},
abstract = {Unmanned Aerial Vehicle (UAV)-based multi-object tracking (MOT) faces three inherent challenges: small and low-resolution targets, drastic scale and appearance variations, and unstable trajectory predictions. Existing Joint Detection and Embedding (JDE) paradigm is the mainstream MOT framework due to its efficient unified architecture for detection and re-identification (ReID). However, conventional JDE methods are designed for scenarios with stable viewpoints and large targets, making them unsuitable for UAV scenarios and leads to limited feature sharing, less discriminative identity features, and unstable cross-frame matching. To address these challenges, we propose a cross-task shared feature and trajectory state transition (CSF-TST) framework for multi-object tracking. Firstly, we propose a common feature sharing network (CFSNet), which is integrated into the neck network to enhance shared feature learning for small UAV targets, thereby alleviating the competition for limited discriminative features between the detection and ReID branches.Then, we propose a pixel scale-aware network (PSAN), which is embedded into the ReID head to improve identity discrimination under motion blur and rapid scale changes. Finally, we propose a trajectory state transition (TST) strategy, which combines the tentative-to-confirmed (T2C) mechanism with trajectory motion compensation (TMC) to improve trajectory stability under complex UAV camera motion. Extensive experiments on the Vision Meets Drone 2019 (VisDrone2019) and Unmanned Aerial Vehicle Detection and Tracking (UAVDT) datasets demonstrate that CSF-TST achieves Multiple Object Tracking Accuracy (MOTA) scores of 55.5% and 53.8%, and Identity F1 Score (IDF1) scores of 57.5% and 67.2%, respectively. These results validate the effectiveness and robustness of our framework in UAV-based MOT.}
}
@article{SHI2026116178,
title = {Weighted graph auto-encoders for cluster ensemble},
journal = {Applied Soft Computing},
volume = {203},
pages = {116178},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116178},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016261},
author = {Haotian Shi and Hongjun Wang and Luqing Wang and Wenhao Yuan and Xu li and Tianrui Li},
keywords = {Cluster ensemble, Graph auto-encoder, Self-supervised learning, Normalized mutual information},
abstract = {Cluster ensemble integrates multiple base clustering results to obtain a robust consensus partition. Nevertheless, conventional co-association based approaches mainly rely on low-order co-occurrence statistics and do not explicitly learn representations, which may hinder the capture of higher-order consensus structures. Motivated by the above limitations, this paper proposes a Weighted Graph Auto-Encoder for Cluster Ensemble (WGAE_CE) to bridge ensemble clustering and graph representation learning. Specifically, we first construct a sample–sample affinity matrix by computing normalized mutual information over base clustering label vectors, and treat it as a weighted adjacency matrix for a graph autoencoder. The autoencoder learns low-dimensional embeddings that preserve the affinity structure, while a self-clustering module further improves clustering separability through joint optimization of reconstruction and clustering objectives. Experiments on benchmark datasets show that WGAE_CE consistently outperforms representative clustering and ensemble clustering baselines in terms of accuracy, purity, and F1-score.}
}
@article{TANG2026116210,
title = {Lightweight starsift-splitstream graph convolution for rotating machinery fault diagnosis},
journal = {Applied Soft Computing},
volume = {203},
pages = {116210},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116210},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016583},
author = {Zhenyu Tang and Dalian Yang and Linrong Tan and Lei Huang},
keywords = {Rotating machinery, Fault diagnosis, Model lightweighting, Graph convolution, Robustness},
abstract = {To address the problem that existing (graph convolutional network) GCN-based diagnostic models have explored structural optimization and efficient propagation separately, but the alignment among sparse structure learning, channel-selective propagation, and deterministic inference execution remains insufficient, this study develops an integrated and deployable lightweight graph convolution framework, named Lightweight starsift-splitstream graph convolution (LSS-GCN), for rotating machinery fault diagnosis. The proposed model integrates node-level structural sparsification with channel-selective graph propagation under a train-inference decoupled framework. During inference, a sample-specific candidate kNN graph is constructed for each input, while the learned binary sparse mask and hard channel gates are frozen after training. Edge rescoring, relaxed sampling, mask updating, and optimization-stage Top-K selection are not repeated. In this way, redundant graph connections and unnecessary channel-wise computation are reduced without weakening fault-related structural representation. Experiments on a self-built bearing dataset, the OU-bearing dataset, and the XJTU-gearbox dataset achieve accuracies of 98.62%, 98.87%, and 99.98%, respectively. Compared with the baseline graph convolution model, LSS-GCN reduces the number of parameters from 0.26 M to 0.16 M and lowers the FLOPs across the three datasets. Evaluation on an NVIDIA Jetson Orin Nano 8 GB platform demonstrates edge-capable deployment on embedded hardware with moderate resources, with mean RAM usage of approximately 3.3 GB and mean board power of approximately 6.4 W. These results indicate that LSS-GCN provides a feasible route toward consistent lightweight graph convolution design from structural modeling to inference execution.}
}
@article{LI2026116185,
title = {Dynamic grouping evolutionary reinforcement learning algorithm for scheduling workflows in hybrid clouds},
journal = {Applied Soft Computing},
volume = {203},
pages = {116185},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116185},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016339},
author = {Huifang Li and Bing Chen and Shuangxi Huang and Boyuan Chen and Jianghang Huang and Yuanqing Xia},
keywords = {Deep reinforcement learning, Evolutionary algorithms, Workflows, Scheduling, Cloud computing},
abstract = {Although several Evolutionary Reinforcement Learning algorithms (ERLs) benefit from adopting Evolutionary Algorithms (EAs) into RL, most of them focus on either single-objective or linear combination-based multi-objective optimization, and have high computational cost. Due to their poor combination mechanisms, they still face sparse rewards, stability issues, and a lack of exploration. This work proposes a Dynamic Grouping Evolutionary Reinforcement Learning algorithm (D-ERL) for workflow scheduling by combining Particle Swarm Optimization (PSO) with Deep Deterministic Policy Gradient (DDPG), which maps a particle in the PSO swarm to an agent (i.e., actor or policy network) in the DDPG framework, and is structured as an iterative improvement cycle benefiting from the alternating evolution of PSO and DDPG. First, it uses two sub-populations to focus on makespan and cost, respectively such that specific regions can be extensively explored to avoid gradient confusion, and the gradient diversity can be enhanced by filling the replay buffer with diversified experiences, along with a dynamic group learning-based update strategy to reduce the time complexity. Second, a hybridized elite solution-guided evolutionary mechanism is developed by iteratively constructing a global shared elite policy set including both compromise and extreme policies, thus accelerating the entire system convergence and enabling DDPG’s cross-refinement. Third, we adopt an external objective-aware complementary heuristic into action selection to adjust the actor’s output probability, which enables finely grained objective balance and diversity maintenance to further reduce vanishing gradients and premature convergence.Extensive experiments are conducted to verify the effectiveness and superiority of D-ERL, and the results show that our D-ERL outperforms its four peers in diversity and policy quality, e.g., its resulting hyper-volume is at most 882.21% and at least 5.83% greater than its peers. D-ERL can enhance the generalization and robustness of the obtained Pareto optimal solution set, which can not only provide a novel intelligent solution paradigm, but also be readily applied in executing large-scale scientific applications to enable more efficient and effective cloud data centers.}
}
@article{WANG2026116237,
title = {Semantics-informed curriculum RL masking with geometry priors for monocular 3D human pose estimation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116237},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116237},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016856},
author = {Yushan Wang and Norio Tagawa},
keywords = {Curriculum reinforcement learning, Joint importance score, 2D-to-3D lifting, Monocular 3D human pose estimation},
abstract = {Monocular 3D human pose estimation is inherently ill-posed because multiple 3D poses can correspond to the same 2D projection, and this ambiguity is further amplified when fast motion or self-occlusion corrupts 2D keypoints. To address this problem, we propose CRLMask, a curriculum reinforcement learning-based masking framework for robust 2D-to-3D pose lifting. CRLMask defines action-wise joint importance using motion magnitude as a practical semantic proxy, and constructs a semantics-informed masking hierarchy for each action. Guided by this hierarchy, the CRLMask agent progressively masks joints from low to high semantic importance, enabling the lifting model to first preserve action semantics and then recover global spatio-temporal structure from incomplete observations. The framework can train models with heavily masked 2D inputs, up to 10 out of 17 joints, corresponding to approximately 59% missing joints. To alleviate scale-induced depth collapse, we introduce a lightweight geometry-based lower bound prior. It derives soft minimum 3D bone lengths from visible 2D bones and penalizes unrealistically shortened 3D bones. Extensive experiments on standard benchmarks demonstrate that CRLMask achieves competitive accuracy while improving robustness and temporal stability under challenging motions and incomplete 2D observations. In-depth analysis shows that CRLMask is especially beneficial for occlusion prone and fast moving joints, while the geometry-based lower bound prior reduces unrealistic depth compression. The proposed framework is architecture-agnostic and introduces no additional inference-time cost.}
}
@article{XU2026116096,
title = {DSM-Net: Diffusion-based stage-wise multimodal medical image segmentation network},
journal = {Applied Soft Computing},
volume = {203},
pages = {116096},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116096},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015449},
author = {Ke Xu and Min Li and Chen Chen and Feng Li and Mingrui Ma and Xiaoyi Lv and Cheng Chen},
keywords = {Multimodal medical image segmentation, Denoising diffusion probabilistic models, Feature inconsistency, Image noise processing},
abstract = {Multimodal medical image segmentation plays an important role in the fields of medical image diagnosis, biomedical engineering, and artificial intelligence-assisted analysis. However, the same lesion region not only exhibits different texture details and contour information in multimodal medical images, but is also affected by inter-modal noise. Under the superimposed influence of feature inconsistency and noise, the clear representation of feature information is disturbed, which in turn hinders the accurate recognition of segmented regions. In order to solve the above problems, this paper proposes a diffusion-based stage-wise multimodal medical image segmentation network (DSM-Net). Specifically, the model adopts a staged target generation method, which combines the denoising diffusion probabilistic model with the segmentation network to gradually alleviate feature inconsistencies and noise interference between different modalities. In addition, we design a Feature Transfer Module (FTM) to address the inter-modal feature inconsistency problem. This module ensures the effective transfer and integration of information between different modalities by learning the correlation between features. Similarly, we propose the Guided Denoising Module (GDM) to address the noise interference problem. It guides the model to extract cleaner feature representations by identifying and reconstructing noise interference in the image. Finally, the experimental results on the BraTs2019 and BraTs2020 datasets show that DSM-Net achieves a DICE coefficient of 87.49% and a Hausdorff distance 95% of 5.33 on the BraTs2019 dataset, and 88.25% and 4.98 on the BraTs2020 dataset, respectively. These results confirm that DSM-Net can effectively improve the segmentation performance of complex lesion regions.}
}
@article{LI2026116193,
title = {A novel multi-label stacked ensemble method based on triple regularization},
journal = {Applied Soft Computing},
volume = {203},
pages = {116193},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116193},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016418},
author = {Tao Li and Jing-Lin Zhou and Deng-Bo Hao},
keywords = {Machine learning, Multi-label classification, Stacked ensemble, Meta features, Local label correlations},
abstract = {Stacked ensemble methods have become an effective means for addressing multi-label classification problems. However, existing multi-label stacked ensemble approaches often suffer from two major limitations. On the one hand, potential discriminative information may be lost during the meta-feature pruning process. On the other hand, the learning of local manifold structures in the label space is usually insufficient, which ultimately degrades the classification performance of the meta-classifier. To address these issues, this paper proposes a multi-label stacked ensemble method based on triple regularization (MSTR). First, a meta feature selection method is introduced, which preserves the contributions of all features while suppressing the negative effects of non-informative features on meta-classifier training, thereby avoiding the loss of potentially discriminative information. Second, a meta feature diversity enhancement mechanism is designed to maximize the differences among the weight vectors of base classifiers across different labels, effectively reducing redundancy in the meta-feature space. Finally, a local label correlation strategy is proposed to incorporate local manifold structures of labels into the meta-classifier prediction process, further improving classification performance. Extensive experiments comparing MSTR with eight state-of-the-art methods demonstrate that MSTR achieves the best average performance in terms of Accuracy, F1, Ranking Loss, Macro-F1, and Micro-F1, thereby validating the effectiveness of the proposed approach.}
}
@article{ELMAS2026116233,
title = {Transformer-enhanced Artificial Bee Colony with self-attention-based relational selection},
journal = {Applied Soft Computing},
volume = {203},
pages = {116233},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116233},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016819},
author = {Yusuf Elmas and Salih Berkan Aydemir and Emre Yalcin},
keywords = {Swarm intelligence, Artificial Bee Colony, Self-attention mechanism, Relational modeling, Evolutionary optimization},
abstract = {Standard Artificial Bee Colony (ABC) and many fitness-driven ABC variants mainly rely on scalar fitness values, local perturbations, and trial-counter-based scout decisions, which may underutilize explicit population-wide relational information. This study introduces the Transformer-enhanced Artificial Bee Colony algorithm (T-ABC), a novel ABC variant that integrates multi-head self-attention mechanisms into the onlooker and scout phases to improve population-level search behavior. The method uses attention-derived relational scores for food-source selection, attention-guided scout reinitialization, adaptive stochastic perturbation of projection matrices, and single-dimension best-guided perturbation. T-ABC was evaluated on the CEC2022 benchmark suite at D=2, 10, and 20, frequency-constrained truss optimization problems, and the three-dimensional AB off-lattice protein-folding energy model. On CEC2022 at D=20, T-ABC achieved the best mean result on 7 of the 12 functions and yielded 123 wins, 5 ties, and 40 losses against 14 competing algorithms across 168 pairwise comparisons according to the Wilcoxon rank-sum test. In the engineering and bioinformatics experiments, T-ABC achieved the best mean performance on 3 of the 5 truss optimization problems and 8 of the 11 protein-folding instances, including high-dimensional cases in both frequency-constrained truss optimization and off-lattice protein folding. These results indicate that attention-derived relational scoring can improve ABC search behavior under the tested settings. Nevertheless, the additional computational cost introduced by the attention mechanism and the scalability of T-ABC to substantially larger populations remain important limitations. The source code is available at https://github.com/Yeness/T-ABC-Transformer-based-Artificial-Bee-Colony-Algorithm.git.}
}
@article{KAR2026116052,
title = {Directly learning stock trading strategies through profit guided loss functions},
journal = {Applied Soft Computing},
volume = {203},
pages = {116052},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116052},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015000},
author = {Devroop Kar and Sheeraja Rajakrishnan and Zimeng Lyu and Hao Zhang and Travis Desell and Alex Ororbia and Daniel Krutz},
keywords = {Transformers, Neural networks, Reinforcement learning, Stock trading, Portfolio management},
abstract = {Stock trading has always been a challenging task due to the highly volatile nature of the stock market. Making trading decisions to generate profit is particularly difficult under such conditions. To address this, we propose four novel loss functions to drive trading strategies for a portfolio of stocks. These loss functions account for the potential profits or losses associated with buying or shorting respective stocks, enabling potentially any artificial neural network to directly learn trading decisions. Despite the high volatility in stock market fluctuations over time, training time-series models such as transformers using these loss functions resulted in trading strategies that generated strong returns on a portfolio of 50 different S&P 500 company stocks compared to benchmark reinforcement learning techniques and a baseline buy and hold method. As an example, using 2021, 2022 and 2023 as three test periods, the Crossformer model adapted with our best loss function was most consistent, resulting in returns of 51.42%, 51.04% and 48.62% respectively. By comparison, leading reinforcement learning models such as PPO, DDPG, and deep RL portfolio management techniques achieved lower returns for the same periods. Our approach was also shown to generalize across portfolios, achieving favorable performance on two other distinct portfolios with 30 and 10 companies. These results suggest that profit-guided loss functions provide a promising approach for aligning model training with downstream trading objectives.}
}
@article{ADNYANA2026116165,
title = {Active learning for interactive prompt clarification in safety-critical programmable logic controller code generation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116165},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116165},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016133},
author = {Ketut Adnyana and Andreas Schwung},
keywords = {Active learning, Soft computing, Interactive prompt clarification, Industrial control systems, Uncertainty quantification, IEC 61131-3, Decision-making under imprecision},
abstract = {Large language models (LLMs) enable automated program synthesis, but their application in safety-critical Industrial Control Systems (ICSs) is constrained by specification imprecision and non-deterministic logic drift. This study addresses these challenges by integrating Active Learning (AL) as a decision-governance layer for Interactive Prompt Clarification (IPC) in Programmable Logic Controller (PLC) code generation. We treat requirements-to-code synthesis as a soft-computing problem involving reasoning under uncertainty, in which missing specifications are quantified as first-class uncertainty signals. The proposed methodology, IPC + AL, implements a policy-level controller that measures logical ambiguity using entropy derived from multi-validator disagreement. This approach transforms code synthesis into a budgeted value-of-information (VOI) policy that determines when to request clarification and when to terminate the synthesis loop deterministically. By embedding uncertainty quantification with fail-closed gating, IPC + AL blocks candidate-code emission unless the predefined safety and dialect gates pass. Controlled feasibility studies on Batch Mixing and Robot Pick-and-Place show improved gate pass rates and committee-assessed artifact scores relative to IPC and standard prompting baselines. Cohen’s κ and Krippendorff’s α are used as evaluator-agreement measures and are not interpreted as evidence of executability, physical-process safety, or certification readiness. The results position IPC + AL as an auditable pre-commissioning governance layer that requires downstream vendor compilation, simulation, hardware-in-the-loop validation, formal verification, and expert approval.}
}
@article{YAN2026116217,
title = {Self-optimization of fused magnesium furnaces under non-optimal operating conditions using enhanced generative adversarial imitation learning},
journal = {Applied Soft Computing},
volume = {203},
pages = {116217},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116217},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016650},
author = {Hao Yan and Mingtong Chi and Guangyu Zhu and Fuli Wang},
keywords = {Self-optimization, Fused magnesium furnace, Generative adversarial imitation learning, Dual-branch attention, Behavior cloning},
abstract = {During the operation of the fused magnesium furnace (FMF), failure to promptly correct non-optimal operating conditions can adversely affect production efficiency, product quality, energy consumption, and operational safety. To address this challenge, this paper proposes a dual-branch attention fusion augmented generative adversarial imitation learning with behavior cloning (DAF-GAIL-BC) method for the optimized adjustment of FMF operating variables. The proposed method is designed to address two key limitations of standard GAIL in complex industrial scenarios: insufficient feature discriminability under coupled multi-source variables and unstable adversarial training caused by random initialization. Specifically, a parallel dual-branch attention fusion structure is developed to enhance state representation quality, while a BC pre-training strategy is introduced to provide a stable initialization for subsequent adversarial optimization. Ablation and comparative experiments show that the proposed method outperforms the benchmark methods across multiple evaluation metrics. Furthermore, semi-physical validation based on historical industrial data indicates that the generated adjustment actions can improve the operating condition level in the offline evaluation environment. These results demonstrate the effectiveness and application potential of DAF-GAIL-BC for FMF self-optimization.}
}
@article{ZHANG2026116262,
title = {Multi-objective optimization of seawater-lubricated radial piston pumps via Kriging-assisted NSGA-II: Balancing pressure ripple and volumetric efficiency},
journal = {Applied Soft Computing},
volume = {203},
pages = {116262},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116262},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017102},
author = {Zhiming Zhang and Xi Zhang and Yangyang Han and Jian Zuo and Yifei Zhu and Bo Chen and Peiyao Ji},
keywords = {Seawater-lubricated radial piston pump, Flow distribution valve, Kriging model, NSGA-II, Pressure pulsation, Volumetric efficiency},
abstract = {The seawater-lubricated radial piston pump is a critical component in marine hydraulic systems, yet its pressure-flow stability is strongly affected by low-viscosity fluid leakage, spool dynamics, and multi-physics coupling, creating an inherent conflict between pressure ripple suppression and volumetric efficiency improvement. To address this challenge, this study proposes a multi-objective optimization framework that integrates a Kriging surrogate model with the NSGA-II algorithm, aiming to simultaneously minimize pressure ripple and maximize volumetric efficiency through the coordinated optimization of key structural parameters of the suction and discharge valves, including spool diameter, spring stiffness, preload force, and valve seat angle. A multi-physics Kriging surrogate model coupling fluid dynamics and structural constraints is constructed to accurately characterize the complex nonlinear relationships between design parameters and performance metrics. Furthermore, an adaptive sampling strategy driven by the Kriging prediction variance is introduced, effectively enhancing the exploration efficiency and convergence accuracy of the Pareto front. The Kriging model, trained on data from 100 Latin Hypercube Sampling (LHS) points, achieves coefficients of determination (R²) exceeding 0.9 for both pressure ripple and volumetric efficiency. The Pareto-optimal solutions obtained via the NSGA-II algorithm are validated using an AMESim model, demonstrating that, under operating conditions of 16 MPa and 1000 rpm, the optimized design reduces pressure ripple by 6.21% and improves volumetric efficiency by 2.61% compared to the baseline design. Bench tests further confirm that the optimized pump achieves a volumetric efficiency of 84.9% at 16 MPa, with the peak pressure fluctuation within the piston chamber controlled below 3.088 MPa, and the deviation between simulation and experiment is less than 2%. The framework accomplishes a global multi-objective search in an eight-dimensional design space at an extremely low computational cost (approximately 11 s), making it particularly suitable for engineering scenarios with limited simulation and experimental resources. It provides a replicable methodological reference for the digital design of low-viscosity, strongly nonlinear hydraulic components, and offers both theoretical and technical support for the long-term reliable operation of seawater hydraulic systems.}
}
@article{SHANG2026116189,
title = {A dimensional complementarity-based periodic game differential evolution for numerical optimization and real-world challenges},
journal = {Applied Soft Computing},
volume = {203},
pages = {116189},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116189},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016376},
author = {Pengpeng Shang and Sanyang Liu and Yiguang Bai and Yudong Gong and Chunfeng Wang},
keywords = {Differential evolution, Evolutionary game, Feature selection, Mechanical engineering problems, UAV path planning},
abstract = {Although differential evolution (DE) has demonstrated strong capability in handling numerical optimization and real world constrained problems, it still suffers from inherent limitations, including slow convergence and insufficient solution accuracy. To overcome these challenges, we propose a novel variant termed GDDE, which integrates principles from evolutionary game theory and feature selection into the traditional DE framework. Inspired by evolutionary game theory, the population is partitioned into two distinct sub-populations. A behavior driven payoff matrix is constructed to regulate strategic interactions between subpopulations, thereby adaptively guiding and stimulating evolutionary dynamics. Furthermore, drawing inspiration from feature selection, we introduce a dimensional complementarity crossover mechanism between the mutation vector and the target vector, replacing the conventional one. The performance of GDDE is comprehensively evaluated on CEC2017, CEC2022, eight large-scale optimization problems, nineteen constrained mechanical engineering problems, and a 3-dimensional UAV path planning task. The experimental results show that the proposed approach has significantly improved optimization performance compared to DE. Moreover, comparisons with fourteen state-of-the-art algorithms demonstrate the superior effectiveness, robustness, and practical applicability of GDDE, as evidenced by statistically significant improvements in mean error and standard deviation, with all results validated using non-parametric statistical tests (Wilcoxon signed rank, Holm-Bonferroni correction, Cliff’s delta and Friedman tests). The source code of GDDE is publicly available at https://github.com/Momo-pob/GDDE_code.git.}
}
@article{RISHU2026116241,
title = {A fuzzy multimodal fusion framework: Integrating background color, facial expressions, and text for emotion recognition in comic panels generated from videos},
journal = {Applied Soft Computing},
volume = {203},
pages = {116241},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116241},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016893},
author = { Rishu and Vinay Kukreja},
keywords = {Comic emotion recognition, Multimodal Fusion, Background Color Analysis, Fuzzy inference system, Text analysis},
abstract = {Context
Emotion recognition in comic videos is not easy, as emotional expressions are conveyed not through real facial expressions but through stylized art. The ambiguity is created through the use of background colors, exaggerated expressions, and non-literal dialogue. Thus, existing unimodal emotion recognition techniques cannot be used to interpret emotions in comic videos.
Objective
This study aims to develop a robust, explainable multimodal framework to infer emotion from comic videos (panels) by jointly analyzing background color, facial expression, and speech balloon dialogue.
Method
Background color, facial expression, and text are used to predict emotion in three parallel streams. The modality produces a probability vector, which is fuzzified and aggregated into Low/Medium/High levels of confidence, then fused with a 45-rule Mamdani fuzzy inference system and defuzzified using a centroid approach to yield the resultant emotion label.
Results
The CoMMA-Fuzz framework has been experimentally tested on a designed dataset of 1850 comic panels and shows better performance on the unseen test set (93.5% accuracy and 93.4% F1-score) than single modalities. The fusion mechanism increased F1 by 6.7% relative to the best single modality and preserved the real-time inference rate (26.6 ms per panel).
Conclusion
Multimodal fusion significantly improves emotion recognition in comic videos, which unimodal systems cannot achieve, and enables subsequent multimedia emotion recognition.}
}
@article{WANG2026116221,
title = {Motion-aware selective 4D Gaussian splatting for efficient dynamic scene reconstruction},
journal = {Applied Soft Computing},
volume = {203},
pages = {116221},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116221},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016698},
author = {Jun Wang and Shaochen Zhao and Qi Liu and Fanghui Zhang and Chunxiao Li and Shunzhou Wang},
keywords = {Dynamic scene reconstruction, 4D Gaussian splatting, Selective deformation, Motion sparsity, Real-time rendering},
abstract = {High-quality dynamic 3D scene reconstruction with real-time rendering capability remains a central challenge in computer vision. Most existing 4D Gaussian splatting approaches model dynamic scenes by applying spatiotemporal deformations indiscriminately to all Gaussian primitives. However, real-world scenes typically exhibit motion sparsity, where only a few regions move (e.g., pedestrians) and most areas remain nearly static (e.g., buildings). Consequently, this full-scene deformation causes substantial computational redundancy, severely hindering both efficiency and optimization stability. To address these limitations, we propose Motion-Aware Selective 4D Gaussian Splatting. To eliminate this redundancy, we introduce a low runtime overhead motion prediction network that generates per-Gaussian motion masks at each time step. By restricting deformation exclusively to dynamic primitives, we reduce the dominant deformation-branch cost from scaling with all N primitives to scaling with only the K dynamic ones. Second, to ensure stable convergence under selective deformation, we design a self-calibrating two-stage training strategy that mitigates error accumulation and periodically restores global gradient coverage. Finally, to handle topological evolution, we propose a motion-aware densification and pruning mechanism that strictly aligns geometric updates with motion semantics. Extensive experiments show that, compared to state-of-the-art methods, our approach significantly reduces computational cost and accelerates convergence, while achieving promising performance accuracy, especially for sparse-motion scenes common in real-world applications.}
}
@article{HAKKOMAZ2026116229,
title = {A reinforcement learning-guided artificial bee colony algorithm with adaptive operator selection for numerical optimization},
journal = {Applied Soft Computing},
volume = {203},
pages = {116229},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116229},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016777},
author = {Hüseyin Hakkomaz and Nurhan Karaboğa and Murat Emre Erkoç},
keywords = {Artificial bee colony, Reinforcement learning, Adaptive operator selection, Swarm intelligence, Global optimization, CEC 2017},
abstract = {Artificial Bee Colony (ABC) has established itself as a prominent swarm intelligence algorithm for global optimization. However, its conventional single-dimensional search equation frequently leads to premature convergence and stagnation when confronting highly complex, multimodal, and non-separable optimization landscapes. To address these limitations, this paper proposes a Reinforcement Learning-guided Artificial Bee Colony algorithm, named QLABC. The proposed method integrates a discrete 6-state Q-learning agent that continuously monitors population diversity and algorithmic stagnation to dynamically orchestrate the search process. Instead of relying on static probabilities, the intelligent agent adaptively switches between standard partial-dimensional exploration, best-guided partial-dimensional exploitation, and a highly disruptive Differential Evolution (DE)-based mutation strategy. Additionally, a phase-end delayed Q-table update mechanism is introduced to stabilize the reinforcement learning process against noisy environmental feedback. The proposed framework is extensively evaluated on the challenging CEC 2017 benchmark suite and validated on the real-world Tension/Compression Spring Design engineering problem. Experimental results and comprehensive ablation studies indicate that while QLABC performs competitively on simpler topographies, it provides improved robustness and reduces severe stagnation in non-separable hybrid environments. Non-parametric Friedman and Nemenyi statistical tests further support the competitiveness of QLABC as a self-adaptive framework for complex continuous optimization problems.}
}
@article{GUPTA2026116213,
title = {Gabor spectrogram-based deep learning framework for automated detection of diabetes mellitus},
journal = {Applied Soft Computing},
volume = {203},
pages = {116213},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116213},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016613},
author = {Kapil Gupta and Naresh Kumar and Pavan Chowdary Ravipati and Rahul Koshti and Jaideep Patel and Parbhat Gupta and Rovin Tiwari},
keywords = {R-R interval signals, Diabetes mellitus, Gabor transform, Smoothed pseudo-wigner ville distribution, Deep CNN},
abstract = {Diabetes Mellitus (DM) is a metabolic syndrome that leads to cardiovascular autonomic dysfunction and changes the pattern of heart rate variability observed in R-R interval signals. It causes a variety of cardiovascular problems that modify the R-R interval in electrocardiogram data, varying the width and height of the peaks. The goal of this work is to develop an automatic detection and continuous monitoring system for DM based on R-R interval signals using deep learning algorithms. The R-R intervals are both nonlinear and non-stationary; linear analysis methods are ineffective for this application. To address this, T-F spectrum images are extracted from the R-R intervals using the Gabor transform (GT) and smoothed pseudo-Wigner Ville distribution (SPWVD). Using a ten-fold cross-validation approach, these spectral images are fed into pre-trained models such as AlexNet, ResNet50, and our own developed lightweight CNN architecture for the automated diabetes detection. Using Gabor-generated T-F spectral images, the proposed model attained the highest classification accuracy of 96.50%, with a sensitivity of 95.77% and a specificity of 97.22%. The experimental results show the feasibility of the proposed framework in the context of diabetes screening applications that are non-invasive and computationally efficient. Furthermore, when combined with a cloud-based algorithm, it is suitable for designing wearable devices capable of automatically diagnosing the disease.}
}
@article{GAO2026116169,
title = {A lightweight deep learning network for accurate defect detection in photovoltaic cells},
journal = {Applied Soft Computing},
volume = {203},
pages = {116169},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116169},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016170},
author = {Yu Gao and Zhanying Li and Kangye Zhang and Yuhuan Jiang and Zhongyi Zhu},
keywords = {Photovoltaic cell defects, Lightweight network, You only look once, Deep learning, Neural architecture search},
abstract = {In response to the current practical demands of photovoltaic cell defect detection, this paper proposes a novel lightweight detection algorithm tailored for photovoltaic cell defects. Based on YOLOv10s, this paper presents a lightweight detection network termed RAG, which incorporates three key design elements—Receptive-field enhancement, Adaptive fusion, and Ghost convolution. First, a receptive field enhancement module is incorporated to improve the model’s feature extraction capability. Second, an adaptive feature fusion mechanism is designed to effectively integrate cross-layer features and highlight high-level semantic information. Additionally, GhostConv lightweight convolution is applied at both the input and output stages of the network, reducing computational redundancy while preserving feature representation capacity. Finally, neural architecture search is employed to automatically optimize network parameters, achieving a balance between accuracy and speed. Experimental results show that the proposed algorithm achieves a mean Average Precision (mAP@50) of 90.06%, which is 4.24 percentage points higher than the baseline model YOLOv10s, while reducing both parameter count and computational cost by 77% and doubling the FPS. Moreover, the detection capability of the improved model for the Vertical_dislocation defect has also increased from 62.5% to 93.8%. Through experimental validation, YOLO-RAG achieves competitive detection accuracy on the PVEL-AD dataset, and its potential for generalization to different imaging modalities is preliminarily verified on an infrared thermography dataset.}
}
@article{WANG2026116258,
title = {Hybrid synergistic spatial–frequency attention with adaptive fusion for pixel-level pavement crack segmentation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116258},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116258},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017060},
author = {Jiayu Wang and Gongquan Li},
keywords = {Deep learning, Pavement crack segmentation, Spatial–frequency attention, Adaptive fusion},
abstract = {Automated crack segmentation is crucial for cost-effective infrastructure inspection and preventive maintenance; however, real-world deployment remains challenging due to the slender morphology of cracks, low contrast, blurred boundaries, and strong texture interference under varying illumination conditions. To address these issues, this study proposes CrackMAN, a hybrid spatial–frequency attention network with adaptive fusion delivering robust pavement crack segmentation in complex scenes. CrackMAN comprises two key components. First, a Multi-Domain Feature Encoding (MDFE) module captures long-range topological information and leverages high-frequency spectral cues to enhance fine boundaries and disentangle cracks from texture-rich backgrounds, thereby improving boundary detection and discrimination from noisy textures. Second, a Crack-Aware Fusion (CAF) module constructs an edge-confidence map to dynamically reweight multi-branch features, enabling the model to adaptively emphasize defect regions and suppress texture-induced false alarms. Extensive experiments on three public datasets (DeepCrack, CFD, and Crack500) demonstrate consistent improvements over representative baselines. Notably, CrackMAN achieves a Pareto-favorable balance between segmentation fidelity and computational efficiency, delivering 86.21% mIoU and 84.90% F1 on DeepCrack at a real-time inference speed of 31 FPS, with strong performance also on CFD (73.85% mIoU) and Crack500 (77.58% mIoU). Ablation studies further show that the proposed multi-domain feature modeling, synergy, and adaptive fusion improve Recall by 6.98% compared with the baseline model, thereby substantially reducing missed detections of thin, discontinuous cracks. Overall, CrackMAN provides accurate, robust, and efficient automated inspection, enabling practical and reliable pavement management.}
}
@article{CHEN2026116254,
title = {Dual token mixing-based graph transformer for semi-supervised node classification in attributed networks},
journal = {Applied Soft Computing},
volume = {203},
pages = {116254},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116254},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017023},
author = {Jinsong Chen and Yue Li and Mingwen Tong and Duantengchuan Li},
keywords = {Graph transformer, Graph neural network, Semi-supervised node classification, Token mixing},
abstract = {Graph Transformers (GTs) have demonstrated remarkable efficacy in standard node classification tasks. However, empirical studies reveal a critical limitation: GTs underperform relative to graph neural networks (GNNs) when training data is scarce. This limitation restricts the applicability of graph Transformers to real-world scenarios, where acquiring large amounts of labeled data is often prohibitively expensive. To address this issue, we propose DTM-GT, a novel graph Transformer specifically designed to enhance node representation learning under data-scarce conditions. The core idea of DTM-GT is a dual token mixing mechanism that combines token sequences from different feature spaces as well as from different target nodes. This mechanism enables target nodes to explore a broader range of relevant nodes within the graph, thereby generating more informative and diverse token sequences. By associating each node with multiple token sequences, DTM-GT ensures effective model training even on sparse datasets. Furthermore, DTM-GT incorporates a Transformer-based backbone with a tailored readout function to learn node representations from these enriched token sequences for accurate label prediction. Extensive empirical results on a variety of graph datasets demonstrate that the proposed DTM-GT outperforms representative GNNs and GTs in semi-supervised node classification.}
}
@article{GALVEZ2026116181,
title = {Learning-aided metaheuristic framework using radial basis function modeling},
journal = {Applied Soft Computing},
volume = {203},
pages = {116181},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116181},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016297},
author = {Jorge Gálvez and Hector Escobar-Cuevas and Heriberto Zapata and Oscar Barba and Erik Cuevas},
keywords = {Radial-basis function, Metaheuristics, Extracting Knowledge, Non-linear optimization, Machine learning},
abstract = {Most Metaheuristic Algorithms (MAs) lack explicit learning capabilities. Although they generate a large number of candidate solutions during the iterative search, they typically rely only on the information contained in the current population to guide the search process. While this design simplifies implementation, the resulting decisions are largely driven by random strategies, preventing the algorithm from inferring the underlying topology of the search landscape. This blind behavior increases the risk of premature convergence, reduces population diversity, and often leads to the search for unpromising regions. Although several learning-enhanced and surrogate-assisted MAs have been proposed, these approaches generally focus on approximating the objective function alone. Consequently, they remain limited in their ability to identify directions that previously led to improvements, detect promising regions of the search space, and recognize poorly performing areas that should be avoided. This paper proposes a novel learning-aided method that reuses candidate solutions from previous iterations to guide the search strategy without approximating the objective function. The proposed approach extracts information using a Radial Basis Function (RBF) to distinguish promising and poor-quality search regions. To promote effective and diverse initial coverage, the population is initialized using the Metropolis-Hastings (MH) algorithm. In each generation, a subset of solutions is used to train the RBF. The learned model is then exploited to generate new candidate solutions in locally promising regions of the search space. The use of the RBF and MH mechanisms enhances the convergence to complex, high-dimensional, and multimodal search spaces, avoiding revisiting poor-quality regions. The performance of the proposed methodology is compared to several state-of-the-art MAs considering a set of well-known functions evaluated in low and high dimensional search spaces. The results demonstrate that the proposed learning-aided strategy achieves an effective balance between accuracy and computational efficiency over its counterparts.}
}
@article{FU2026116161,
title = {Domain knowledge-enhanced spatio-temporal adaptive fusion network for aeroengine remaining useful life prediction},
journal = {Applied Soft Computing},
volume = {203},
pages = {116161},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116161},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016091},
author = {Song Fu and Zong Wang and Lin Lin and Shisheng Zhong and Yue Wang and Kang Wu and Minghang Zhao and Yifan Lu},
keywords = {Aeroengine, Domain knowledge, Remaining useful life, Graph convolutional network, Spatial-temporal feature extraction},
abstract = {The integration of graph convolutional networks (GCNs) with time-series models has gained popularity in predicting aeroengine remaining useful life (RUL), as it allows for the capture of both spatial and temporal dependencies from multidimensional time-series (MST) monitoring data. However, existing methods encounter several limitations: (1) the physical essential correlations among sensor parameters are often overlooked, which hinders the precise extraction of actual spatial dependencies from MST data; (2) the mainstream sequential network architectures often lead to mutual interference between spatial and temporal dependencies, consequently causing degradation information loss. To address these challenges, a novel Domain Knowledge-Enhanced Spatio-Temporal Adaptive Fusion Network (DKESTAFN) is developed, which integrates aeroengine domain knowledge with parallel spatiotemporal feature extraction to significantly improve RUL prediction accuracy. First, MST monitoring data are transformed into both grid-structured and graph-structured formats. Meanwhile, the physical essential correlations among sensor parameters are revealed through an analysis of aeroengine working principles. These correlations are then leveraged to construct the graph-structured data, thereby more accurately representing spatial dependencies and enhancing spatial feature expression. Second, a novel dual-stream spatio-temporal feature extraction module is designed to simultaneously extract representative degradation features from both temporal and spatial streams via parallelly connected temporal and spatial branches, which effectively mitigates the mutual influence between spatial and temporal dependencies. Furthermore, a gated mechanism is designed to adaptively fuses the extracted spatial and temporal features, yielding more comprehensive and representative degradation features, ultimately boosting RUL prediction accuracy. Extensive comparative experiments demonstrate that DKESTAFN substantially outperforms ten state-of-the-art prognostic methods in prediction accuracy, thereby validating its effectiveness, robustness, and practical potential for aeroengine RUL prediction.}
}
@article{YANG2026116074,
title = {Edge AI-enabled ultra-lightweight convolutional neural network for tea leaf disease diagnosis},
journal = {Applied Soft Computing},
volume = {203},
pages = {116074},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116074},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601522X},
author = {Qing Yang and Ziyan Feng and Qingqing Xiang and Yingjuan Chen and Shukai Duan and Lidan Wang},
keywords = {Deep learning, Tea leaf disease, Lightweight, Edge AI device, Real-time recognition},
abstract = {Tea leaf diseases present a significant challenge to global tea production, underscoring the need for efficient and real-time diagnostic solutions. This study introduces CM2-Net, a novel ultra-lightweight Convolutional Neural Network (CNN) designed explicitly for diagnosing tea leaf diseases on edge AI devices. The network integrates innovative features such as Coordinate Attention (CA), the Meta-ACON-C activation function, and the RandAugment (RA) data augmentation strategy. These enhancements enable CM2-Net to achieve an accuracy of 94.76% while reducing the number of parameters by 86.22% compared to MobileNetV3-Large on the Tea Sickness Dataset (TSD). When deployed on Jetson Orin NX using TensorRT with 16-bit quantization, the model demonstrated real-time processing capabilities, achieving 43.40 Frames Per Second (FPS), a 97.36% improvement over the baseline. This approach facilitates fast, privacy-preserving disease diagnosis, reducing reliance on cloud computing and enhancing accessibility in resource-constrained settings. The release of open-source code further encourages research into edge AI applications https://github.com/JasonYangCode/CM2-Net.}
}
@article{MEI2026116239,
title = {Curriculum learning guided multi-view representation for incomplete multi-view clustering},
journal = {Applied Soft Computing},
volume = {203},
pages = {116239},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116239},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601687X},
author = {Sanlin Mei and Ao Li and Dehua Miao and Fengwei Gu and Tianyu Gao},
keywords = {Multi-view clustering, Representation learning, Curriculum learning, Pseudo-supervised},
abstract = {The rapid advancement of multi-view representation learning has spurred breakthroughs in incomplete multi-view clustering (IMC). Despite progress, prevailing methods typically adopt a uniform training strategy to capture both cross-view consistent and view-specific information, overlooking the inherent tendency of neural networks to prioritize encoding shared, low-complexity patterns before gradually memorizing fine-grained, view-specific details. This mismatch between model design and learning dynamics often leads to suboptimal representations under missing views. To overcome this, we propose ROSE, an efficient multi-view representation framework that leverages a dynamic curriculum learning strategy to first guide the model toward learning cross-view consistent representations and then progressively shift focus to view-specific features, aligning the learning process with the natural behavior of neural networks. Specifically, ROSE decomposes the latent space into a cross-view consistent representation, learned by a shared variational encoder (VAE) with explicit distribution alignment, and view-specific representations, each equipped with a flexible learnable prior that adapts to the optimal distribution of the corresponding view rather than being constrained by a fixed Gaussian prior used in conventional VAEs. Furthermore, we design an uncertainty-aware symmetric pseudo-supervised clustering module that reduces cross-view discrepancies while down-weighting uncertain pseudo-labels, thereby preserving discriminative view-specific characteristics and enabling end-to-end clustering. Extensive experiments on multiple benchmark datasets with various missing rates demonstrate that ROSE consistently outperforms baseline IMC methods across multiple evaluation metrics.}
}
@article{XIAO2026116192,
title = {Physical latent variable and loss jointly driven auxiliary classifier generative adversarial network for few-shot rotating machinery fault diagnosis},
journal = {Applied Soft Computing},
volume = {203},
pages = {116192},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116192},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016406},
author = {Zheng Xiao and Chi Zhang and Feibin Zhang and Yeliang Xia},
keywords = {Rotating machinery fault diagnosis, Few-shot learning, Generative adversarial network, Physical feature fusion, Physics-consistent constraints},
abstract = {In scenarios with limited sample sizes, achieving accurate and reliable fault diagnosis for rotating machinery is crucial for ensuring equipment safety and enhancing industrial system stability. However, existing hybrid-driven methods still exhibit shortcomings in integrating physics and data, particularly generative adversarial network-based hybrid-driven methods, which remain limited to local embedding of physical information and lack global integration of physics and data, thus requiring improvements in diagnostic accuracy. To address this issue, this paper proposes a physics-guided auxiliary classifier generative adversarial network, in which physical information is jointly embedded into latent variable construction and loss design: first, physically meaningful features such as spectral centroid and low-frequency energy are used to construct class-conditional latent variables, and a relatively stable latent representation is obtained through fixed random projection; based on this, a feature loss is designed to align the physical features of generated samples with real samples, and the pre-trained discriminator is further fine-tuned with a small amount of labeled data, enabling the model to achieve high-quality generation and superior diagnostic accuracy under small-sample conditions. Under the same-condition few-shot setting, where 25 labeled training samples per class are used and 100 samples per class are used for testing, the proposed method achieves classification accuracies of 99.86%±0.05% on the CWRU dataset and 99.87%±0.06% on the PU dataset over 10 repeated trials, outperforming the comparative methods in both accuracy and result stability. Under the cross-condition setting, the model is pre-trained on the source working condition and fine-tuned using 25 labeled real samples per class from the target condition, with 100 samples per class used for testing. The proposed method still obtains accuracies of 99.40% on CWRU and 96.00% on PU, further indicating its adaptability to condition variations. Ablation experiments verify the effectiveness of physical feature-guided latent variable modeling, physical consistency loss, and fine-tuning strategies in improving performance and show good stability across different sample sizes.}
}
@article{MU2026116244,
title = {Joint calibration: Label reasoning and feature refinement for unsupervised domain adaptive person re-identification},
journal = {Applied Soft Computing},
volume = {203},
pages = {116244},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116244},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016923},
author = {Huiyu Mu and Shubing Han and Yaliang Zhao and Yongjun He and Huixia Liu and Dingyi Liu and Yangke Ying and Yi Xie},
keywords = {Unsupervised domain adaptation, Person re-identification, Clustering, Pseudo-label, Feature representation},
abstract = {Unsupervised domain adaptation is a challenging task that transfers knowledge learned from a labeled source domain to an unlabeled target domain. Recent UDA Re-ID studies commonly generate pseudo-labels through offline clustering and then use them as supervisory signals for online feature learning. However, these methods overlook the adverse effects of substantial cross-camera style differences on pseudo-label prediction. Inaccurate pseudo-label prediction produces numerous noisy pseudo-labels during offline clustering and severely impedes discriminative feature learning in the online stage. To address this issue, we propose a Joint Calibration (JC) framework that refines pseudo-labels during offline clustering and optimizes feature representations during online training, thereby improving both the reliability of target-domain pseudo-labels and feature discriminability. Specifically, in the offline stage, we propose a new Hard Sample Reasoning (HSR) method that constructs and reasons over a relation graph of pseudo-label clusters to correct pseudo-labels for confusing samples in cross-camera scenarios. In the online stage, we design an Instant Memory Update Strategy (IMUS), which stores global sample features in an instant memory bank and immediately performs feature diffusion over the entire training set through memory diffusion. JC reduces the effects of noisy labels and progressively refines the learned features during training. Experiments on multiple public datasets demonstrate competitive performance. The overall results demonstrate competitive performance and favorable robustness across multiple cross-domain settings.}
}
@article{XU2026116216,
title = {Self-paced contrastive learning for multi-modal hashing with noisy labels},
journal = {Applied Soft Computing},
volume = {203},
pages = {116216},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116216},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016649},
author = {Huating Xu and Yun Liu and Mengxiao Yuan and Qiang Lu and Dawei Zhao and Zhenfang Zhu and Huaxiang Zhang},
keywords = {Noisy labels, Contrastive learning, Hashing, Self-paced learning, Multi-modal retrieval},
abstract = {Multimodal hashing fuses multimodal features to learn compact hash codes, offering fast retrieval and low storage, and is widely applied in large-scale multimodal retrieval. However, most existing methods rely on clean label assumptions, while manually annotated labels in real scenarios often contain noise that impairs model performance. To address this, we propose a novel Self-Paced Contrastive Learning method for Multi-modal Hashing with Noisy Labels (SPCL-NMH). It integrates triple components: adaptive semantic consistency learning, multi-modal collaborative learning, and hash code generation, providing unbiased supervised signals for hashing learning under noisy labels. Specifically, SPCL-NMH adopts attention enhancement to strengthen intra-modal key features and capture fine-grained cross-modal semantic consistency, and uses feature-centroid similarity to filter noisy labels. Subsequently, we incorporate self-paced learning to dynamically adjust sample weights by prioritizing reliable samples and downweighting highly noisy ones during training, to minimize noise impact. To generate stable, noise-robust hash codes, we produce multiple candidate codes via intra-modal augmentation and fuse them by sign voting. Extensive experiments on three benchmarks show SPCL-NMH significantly outperforms state-of-the-art baselines, validating its effectiveness and superiority.}
}
@article{ZHOU2026116224,
title = {An adaptive differential evolution with multi-stage restart mechanism and its application in uncrewed aerial vehicle path planning},
journal = {Applied Soft Computing},
volume = {203},
pages = {116224},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116224},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016728},
author = {Rongfeng Zhou and Jilin Zhang and Zhenyu Meng},
keywords = {Differential evolution, Restart mechanism, Parameter control},
abstract = {Differential evolution (DE) is one of the most powerful evolutionary algorithms, widely favored for its simplicity, robustness, and few control parameters. However, even the most recently proposed state-of-the-art DE variants tend to experience premature convergence and evolutionary stagnation. In this paper, an adaptive DE variant with a multi-stage restart mechanism is proposed and referred to as MRDE, which is designed to restart stagnant individuals. The main contributions of this work are as follows: First, a novel adaptive strategy for F and CR is developed, integrating both fitness and dimension improvement. Second, two different stagnation detection indicators are introduced to identify stagnant individuals at different stages of the evolutionary process. Finally, potential discarded individuals are leveraged to restart stagnant individuals in the early evolutionary stage, while Lévy walk is incorporated to restart stagnant ones in the later evolutionary stage. To assess the performance of MRDE, we conducted extensive evaluations using 100 real-parameter single-objective optimization benchmarks from the CEC2013, CEC2014, CEC2022, and CEC2025 test suites. The results demonstrate that our algorithm performs well compared to six state-of-the-art DE variants. In addition, we validated the effectiveness of the algorithm on real-world uncrewed aerial vehicle (UAV) path planning problems, and it performed exceptionally well.}
}
@article{KANCAGULSOY2026116135,
title = {SwinSR-Defense: Swin transformer with super-resolution capability for adversarial robustness},
journal = {Applied Soft Computing},
volume = {203},
pages = {116135},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116135},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015838},
author = {Elif {Kanca Gulsoy} and Tolgahan Gulsoy and Selen Ayas and Elif {Baykal Kablan}},
keywords = {Adversarial attacks, Adversarial defense, Explainable artificial intelligence, Super resolution, Swin transformer},
abstract = {Image classification systems have achieved high accuracy rates in many areas with the development of deep learning techniques in recent years. However, these systems have serious weaknesses against adversarial attacks, where minimal perturbations that are difficult to detect with the human eye can fool classification models and threaten system security. Existing defense mechanisms often struggle with maintaining clean image performance while effectively removing adversarial perturbations, and typically focus on either white-box or black-box attacks separately. In this context, there is a need for generalizable defenses that can effectively remove adversarial perturbations while preserving image quality and performing well against both attack types on clean and attacked data. Super-resolution based purification defenses have emerged as a promising approach for adversarial robustness and have been explored through various CNN-based implementations. However, these earlier approaches are limited by the representational capacity of convolutional architectures in capturing long-range dependencies crucial for effective perturbation removal. In this paper, we propose SwinSR-Defense, which modernizes the SR-defense pipeline by replacing earlier CNN-based purifiers with a transformer-based SwinIR module, yielding substantially improved robustness. Unlike existing defense methods that rely on adversarial training or input transformations, our approach combines super-resolution capabilities with the Swin Transformer architecture to effectively model both local and global context for perturbation removal. SwinSR-Defense reconstructs the semantic integrity of degraded images while maintaining the original image quality, preserving the correct decision-making capability of classification models. The proposed method is comprehensively evaluated on ResNet-50, DenseNet-121, and Swin Transformer models trained on the ILSVRC dataset against both white-box and black-box attacks. Through extensive ablation studies, we analyze the impact of different model components and parameters. For white-box attacks, our approach achieves 73.79% accuracy against FGSM, 44.47% against MI-FGSM, 64.85% against BIM, and 67.06% against C&W on ResNet-50; 67.16%, 21.98%, 51.70%, and 44.57% on DenseNet-121; and 79.31%, 41.26%, 60.44%, and 62.65% on Swin Transformer, respectively. Against black-box attacks, the method achieves 77.00% robust accuracy against Square and 71.68% against Pixle on ResNet-50, 76.80% and 69.17% on DenseNet-121, and 83.83% and 80.82% on Swin Transformer. The approach maintains 100% clean image accuracies on ResNet-50, DenseNet-121, and Swin Transformer. These results demonstrate that the transformer-based enhancement significantly outperforms state-of-the-art defense methods across all attack scenarios. Code is available at https://github.com/TolgahanGulsoy/SwinSR-Defense.}
}
@article{QI2026116143,
title = {Multi-scale self-knowledge distillation network for image forgery detection and localization},
journal = {Applied Soft Computing},
volume = {203},
pages = {116143},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116143},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015917},
author = {Bing Qi and Xipeng Pan and Chunyang Ye and Bingchao Zhao and Yuliang Ding},
keywords = {Tampering detection, Multi-scale self-distillation, Edge enhancement mechanism, Multi-scale feature fusion},
abstract = {In the era of artificial intelligence, deep learning–based image manipulation detection models have achieved strong performance in a wide range of detection tasks. However, existing methods still have limitations in effectively exploiting multi-scale features. To address this issue, we propose a Multi-Scale Self-Knowledge Distillation Network (MSSKD-Net) for efficient and accurate image forgery detection and localization. The proposed framework incorporates a multi-scale edge enhancement module that fuses curvature and gradient operators to strengthen the recognition of subtle and post-processing-resistant manipulation boundaries across scales. In addition, we design a multi-scale self-distillation module to explicitly align semantic representations across different resolutions in a self-supervised manner, thereby improving detection robustness. Extensive experiments on six benchmark datasets (e.g., CASIA, Coverage) demonstrate that our approach surpasses existing state-of-the-art methods, achieving gains of 0.3% in detection F1, 2.5% in detection AUC, 2.1%–14.5% in localization F1 and 1.0%–12.0% in localization AUC.}
}
@article{YANG2026116188,
title = {An adaptive differential evolution algorithm based on probability-driven multiple mutation strategies and dynamic seed restart},
journal = {Applied Soft Computing},
volume = {203},
pages = {116188},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116188},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016364},
author = {Chengao Yang and Huarong Xu and Weijun Li},
keywords = {Differential evolution, Multiple mutation strategies, Dynamic seed restart, Dual-path external archive},
abstract = {Differential evolution (DE) is a widely recognised efficient heuristic global optimization algorithm. However, its fixed mutation strategy often leads to an imbalance between early exploration and exploitation, making it prone to premature convergence due to sudden diversity decline and individual stagnation, thereby struggling to escape local optima. This paper proposes an Adaptive Differential Evolution Algorithm Based on Probability-Driven Multiple Mutation Strategies and Dynamic Seed Restart (PMDRDE). Firstly, we propose a probability-driven two-stage multi-mutation strategy fusion mechanism: during the early evolutionary phase, a three-strategy repository is constructed, with mutation operations executed via random probability selection of corresponding mutation formulas to enhance initial exploration capability and adaptive flexibility; in the later phase, the algorithm switches to success-guided directed mutation to balance global exploration and local exploitation. Secondly, a dual-path external archive coordination mechanism based on success–failure is designed, in which a success-oriented offspring archive and a failure-oriented parent archive are constructed with complementary functions. This dual-archive framework enhances landscape perception and effectively mitigates premature convergence. Thirdly, we propose a diversity-aware dynamic seed restart strategy. This dynamically adjusts the perturbation parameter α based on iteration progress and stagnation duration. New individuals are optimized through a composite perturbation scheme combining Gaussian-kernel-based local modulation and Cauchy-based global escape, thereby efficiently restoring population vitality and search capability. To validate the proposed algorithm’s performance, comparative experiments were conducted across 72 benchmark functions from the Congress on Evolutionary Computation (CEC) competitions, specifically the CEC2014, CEC2017, and CEC2022 benchmark test suites, alongside real-world application problems. PMDRDE was benchmarked against five state-of-the-art DE variants. Experimental results demonstrate that PMDRDE exhibits significant advantages in terms of optimization performance, convergence behavior, and population diversity.}
}
@article{AGHAYENGEJEH2026116240,
title = {Graph-to-cluster contrastive ratio variational graph autoencoder for deep graph clustering},
journal = {Applied Soft Computing},
volume = {203},
pages = {116240},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116240},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016881},
author = {Nazila Pourhaji Aghayengejeh and M.A. Balafar and Jafar Tanha and Aryaz Baradarani},
keywords = {Node clustering, Contrastive learning, Variational graph auto-encoder},
abstract = {Despite significant progress in unsupervised graph representation learning, Variational Graph Auto-Encoder (VGAE)-based clustering frameworks continue to suffer from the fundamental issue of latent representation degeneration arising from feature randomness, feature drift, posterior collapse, and inference–generation model mismatch. Noisy or unreliable cluster assignments frequently propagate through training, giving rise to feature randomness, while posterior collapse forces latent variables to conform too closely to the prior distribution. Furthermore, introducing the clustering inductive bias often disrupts the harmony between the inference and generative models, and a strong trade-off between reconstruction and clustering discrimination aggravates feature drift. In this paper, we propose a Graph-to-Cluster Contrastive Ratio for VGAEs (GCCR-VGAE), which is designed to explicitly balance global structural discrimination and clustering-oriented representation learning within a unified objective. Specifically, the numerator employs node-to-graph contrastive learning, which increases the divergence between positive-view node embeddings and the global graph representation derived from the negative view, thereby encouraging the learned representations to move away from structural patterns that do not fully reflect the desired clustering structure while maintaining awareness of global graph topology. The denominator incorporates node-to-cluster contrastive learning, which decreases the divergence between node embeddings and their corresponding cluster prototypes in the positive view, thereby enforcing intra-cluster compactness and inter-cluster separability. By incorporating this novel contrastive term, GCCR-VGAE clearly outperforms 34 recent state-of-the-art methods, achieving remarkable accuracy scores: 90.08% on ACM, 79.66% on Cora, 72.89% on Citeseer, 75.57% on Pubmed, 74.38% on DBLP, 60.00% on Wiki, 61.47% on WikiCS, and 60.59% on A-Computers.}
}
@article{YIN2026116172,
title = {FBBA: Feature-isolation-based full-target black-box backdoor attacks},
journal = {Applied Soft Computing},
volume = {203},
pages = {116172},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116172},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016200},
author = {Yangxu Yin and Honglong Chen and Huansheng Xue and Kai Lin and Peng Sun and Liantao Wu and Weifeng Liu},
keywords = {Deep learning, Multi-target backdoor attack, Black-box settings},
abstract = {Multi-target backdoor attacks present serious security risks to deep neural networks. During training, adversaries can implant backdoors targeting multiple classes into a model, allowing them to arbitrarily steer the classification of triggered samples to any desired target class during inference, rather than being confined to a single predefined class. However, in black-box scenarios, multi-target backdoor attacks face difficulties in simultaneously compromising all classes, with the core challenge being how to preserve the specificity of triggers under such constrained settings. To tackle this issue, we propose a feature-isolation-based Full-target Black-box Backdoor Attack (FBBA). Our approach ensures trigger specificity from both spatial and content perspectives. Specifically, we identify near-centroid features based on the latent feature distribution of each class and generate class-specific masks via spatial-domain feature visualization, thereby guaranteeing spatial specificity of triggers. We then design class-specific binary encodings derived from the edge feature distributions of near-centroid samples, which are used to embed triggers into specific locations of predefined channels, ensuring content-level specificity. During trigger injection, we first apply the fast fourier transform to the designated regions of samples, then perform singular value fusion within the amplitude spectrum to incorporate the trigger information. We evaluate FBBA across multiple datasets and model architectures. Experimental results demonstrate that FBBA achieves strong attack performance in black-box settings, preserves model accuracy on clean inputs, and effectively evades state-of-the-art backdoor defense mechanisms.}
}
@article{LI2026116191,
title = {One-class-supervised fault diagnosis using flow-encoded subspace clustering},
journal = {Applied Soft Computing},
volume = {203},
pages = {116191},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116191},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601639X},
author = {Chuan Li and Lijuan Yan and Qibing Yu and Ziqiang Pu and Shuai Yang},
keywords = {Fault diagnosis, Feature extraction, Flow-based model, One-class-supervised learning, Subspace clustering},
abstract = {Intelligent fault diagnosis is critical for ensuring the reliable operation of industrial systems. To fully utilize the labeled normal data, semi-supervised anomaly detection may be adopted to identify fault occurrences without discriminating between different fault patterns. While capable of capturing distinctions between different patterns, unsupervised fault clustering does not effectively utilize the known normal conditions. To bridge this gap, a novel one-class-supervised clustering-based fault diagnosis approach, termed flow-encoded subspace clustering (FESC), is proposed to distinguish multiple health-state patterns by leveraging known normal data. Specifically, a flow-based model is integrated with an autoencoder for feature representation. Subspace clustering is then employed for discriminating encoded features. During FESC training, the feature extraction stage is supervised solely by normal data. The subsequent fault clustering stage is pseudo-supervised by the self-expression property of the extracted features. The proposed FESC is evaluated on a benchmark bearing dataset, a benchmark gearbox dataset, and a beam chopper bearing setup. Experimental results show that FESC achieves superior performance compared with state-of-the-art methods. It demonstrates the effectiveness of discovering distinctions among different fault patterns via one-class-supervised learning.}
}
@article{HU2026116196,
title = {A density-based federated distillation learning model with meta-classifier for credit scoring},
journal = {Applied Soft Computing},
volume = {203},
pages = {116196},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116196},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016443},
author = {Zecheng Hu and Wenyu Zhang and Jiayu Guo},
keywords = {Credit scoring, Federated learning, Meta-classifier, Knowledge distillation},
abstract = {Credit scoring plays a crucial role in maintaining the stability of financial systems. However, existing credit scoring models still face problems that lead to limited performance, including data privacy leakage, difficulties in capturing complex logic, and constraints on communication overhead. To solve these problems, a novel density-based federated distillation learning model with meta-classifier (M-DFDL) is proposed in this study for credit scoring. Firstly, an improved meta-classifier based on meta-learning is proposed, which employs an extended triplet-like network as the feature extraction model to capture discriminative feature representations and utilizes a cross-sample relational model to learn the similarity between samples in different sets. Secondly, a new density-based federated distillation learning (DFDL) method is proposed, which applies a density clustering algorithm to select high-density regions to form teacher models and then uses knowledge distillation to transfer the knowledge from teacher models to student models. Finally, the proposed M-DFDL combines the meta-classifier and DFDL within a horizontal federated learning framework, offering the distinct advantage of robustly resolving extreme class imbalance and data heterogeneity while significantly enhancing the accuracy, generalization, and privacy preservation of local models. Extensive experiments on four real-world datasets validate that M-DFDL effectively addresses extreme class imbalance and data heterogeneity. Notably, compared to the optimal baselines, M-DFDL achieves an improvement of at least 0.16% in Recall and 0.32% in F1-Score across all four datasets.}
}
@article{CHANG2026116248,
title = {Direct extraction and encoding of holographic pixels for holographic stereograms utilizing neural graphics primitives},
journal = {Applied Soft Computing},
volume = {203},
pages = {116248},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116248},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016960},
author = {Hebin Chang and Yang Yu and Yanan Zhang and Weifeng Wang and Linling Yang and Xingpeng Yan},
keywords = {Instant neural graphics primitives, Holographic stereogram, Light field encoding},
abstract = {Holographic stereograms typically require acquiring numerous parallax images and performing complex pixelated recombination encoding, leading to significant sampling overhead and computational load. To address these challenges, this work extends the effective perspective image segmentation and mosaicking (EPISM) method by integrating instant neural graphics primitives (Instant-NGP) for holographic encoding and printing. By leveraging the principles of ray tracing, the proposed approach directly constructs the 3D light field implicitly using Instant-NGP, which significantly improves neural radiation field rendering efficiency through hash coding and hybrid representation, enabling the direct retrieval of specific holographic pixels. These pixels are then stacked directly to generate synthesized effective perspective images (SEPIs) to be exposed in the holographic element, thereby circumventing parallax image sampling and recombination encoding, which significantly streamlines the entire rendering pipeline. Experimental results show that this method achieves a generation speed of approximately 20 fps for SEPIs with a resolution of 1000×1000 pixels—over 15 times faster than conventional approaches—while also delivering superior 3D reconstruction quality.}
}
@article{ZHOU2026116168,
title = {NOMG: Nonlinear oversampling based on multi-granularity optimization},
journal = {Applied Soft Computing},
volume = {203},
pages = {116168},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116168},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016169},
author = {Hao Zhou and Min Li and Keke Zhang and Qun Liu and Huaqing Li and Ponnuthurai Nagaratnam Suganthan},
keywords = {Imbalanced regression, Nonlinear oversampling, Multi-granularity, Granular computation},
abstract = {Learning from imbalanced datasets is an important challenge in regression. Oversampling is a critical technique utilized in imbalanced regression, which simply and directly manipulates the quantity of samples to rebalance the data distribution. However, pertinent scholarly investigations have predominantly concentrated on classification rather than regression. Many current algorithms used for imbalanced regression directly apply the oversampling algorithms used for classification to the regression. Therefore, to fill the gap in imbalanced regression, an adaptive Nonlinear Oversampling mechanism within Multi-Granularity space (NOMG) is proposed. NOMG serves as a new direction for the sample generation mechanism, in contrast to the existing oversampling methods with the mainstream k-nearest neighbor linear sampling mechanism. By representing the data distribution and optimizing the granular sampling space adaptively and efficiently, NOMG converts the data-level sampling of the k-neighbor domain into a nonlinear sampling space with multiple levels and granularities. Moreover, informed nonlinear sampling is performed under the guidance of high-dimensional sparsity and mixed multivariate isotropic Gaussian distribution to introduce diverse information consistent with the data distribution. The problem definition and the proofs of the algorithm’s validity are provided from a mathematical perspective. Extensive experiments on 21 public real-world datasets demonstrate the effectiveness and superiority of the proposed NOMG.}
}
@article{DAWOOD2026116220,
title = {Hybrid entropy–fuzzy weighted decision matrix (HEF-WDM) for the optimal software architecture pattern selection},
journal = {Applied Soft Computing},
volume = {203},
pages = {116220},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116220},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016686},
author = {Kareem Abbas Dawood},
keywords = {Software architecture selection, Architecture pattern, Fuzzy VIKOR, Entropy method, Hybrid decision matrix, MCDM},
abstract = {In software development, the software architecture pattern has a direct impact on the number of system characteristics, including scalability, adaptability, and maintainability. Consequently, selecting an appropriate software architecture is a crucial decision. Such a decision is complex because of conflicting criteria and uncertainty in expert judgment. This study proposes a systematic, objective decision matrix for selecting optimal software architecture patterns by addressing uncertainty and bias in performance evaluation and criterion weighting. In this study, a Hybrid Entropy-Fuzzy Weighted Decision Matrix (HEF-WDM) is developed, in which entropy-based objective weights are integrated into the fuzzy decision process. This mechanism avoids early defuzzification, enforces data-driven objectivity, and maintains expert uncertainty. An academic portal case study that evaluates six software architecture patterns against eight criteria is used to validate the proposed decision matrix. Two benchmark methods, Fuzzy VIKOR with subjective weights and crisp Entropy-VIKOR, were applied to the same case study dataset. These results confirm that the proposed HEF-WDM provides a more methodologically consistent decision-support process that improves decision reliability, reduces subjective bias, and offers a rigorous, unbiased, and flexible method for selecting software architecture. The rank-agreement validation also confirmed that HEF-WDM was fully consistent with Crisp Entropy-VIKOR. The Spearman correlation, weighted Spearman correlation, and WS similarity coefficients were all equal to 1.0000. In comparison, HEF-WDM showed moderate agreement with Standard Fuzzy VIKOR, with corresponding values of 0.6571, 0.5592, and 0.5750. Beyond academic portals, the proposed decision matrix can be generalized to support the selection of suitable software architectures across different fields of system design.}
}
@article{CIFTCI2026116257,
title = {FALCON-ABC: Fully automated LSTM co-optimization via NAS and ABC for time series forecasting},
journal = {Applied Soft Computing},
volume = {203},
pages = {116257},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116257},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017059},
author = {Hasan Çağatay Çiftçi and Ümit Haluk Atasever},
keywords = {NAS, HPO, GPR, ABC, Time series forecasting},
abstract = {Accurate and computationally efficient forecasting of hydro-meteorological variables remains challenging due to the nonlinear, stochastic nature of climate data and the high computational cost associated with deep learning model design. In this study, a novel surrogate-assisted optimization framework, termed FALCON-ABC, is proposed by integrating Neural Architecture Search (NAS) and Hyperparameter Optimization (HPO) within an Artificial Bee Colony (ABC) optimization scheme enhanced by Gaussian Process Regression (GPR). The proposed framework automatically identifies optimal LSTM architectures and training hyperparameters, reducing the need for manual model design. Experiments were conducted using monthly temperature and rainfall data from the Kocasinan–Yamula meteorological station. The results show that FALCON-ABC substantially improves predictive performance over the baseline LSTM model, increasing the test-set NSE from 0.660 to 0.979 for temperature forecasting and from 0.685 to 0.953 for rainfall forecasting. Additional comparative experiments against Grid Search, Random Search, Particle Swarm Optimization, and Whale Optimization Algorithm further demonstrate that ABC provides the most favorable accuracy–efficiency trade-off within the proposed NAS–HPO framework. A controlled ablation analysis confirms the contribution of the GPR surrogate by reducing the optimization time while preserving high forecasting accuracy. Furthermore, backbone-level comparisons with Transformer Encoder and GAF-based Vision Transformer models empirically support the selection of LSTM as the core forecasting architecture for the present monthly hydro-meteorological dataset. To examine transferability beyond the original station, a supplementary experiment was also conducted on the independent Jena Climate benchmark dataset, where FALCON-ABC achieved reliable performance across several thermodynamic and humidity-related meteorological variables. Overall, the findings indicate that FALCON-ABC provides an effective, automated, and computationally efficient framework for deep learning-based time-series forecasting, with strong potential for broader meteorological forecasting applications.}
}
@article{YANG2026116228,
title = {A multi-metric optimal transport-based visual-tabular feature alignment network for multimodal classification},
journal = {Applied Soft Computing},
volume = {203},
pages = {116228},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116228},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016765},
author = {Lijun Yang and Hongying Zhang and Yong Zhang and Bin Wu and Jiao Wang and Julei Tang and Hongliang Zhang},
keywords = {Deep learning, Multimodal, Image-tabular representation learning, Image classification},
abstract = {Image-tabular multimodal learning is receiving increasing attention in visual classification tasks. However, heterogeneous tabular data suffers from semantic space incompatibility, and existing methods often struggle to achieve effective alignment for image-tabular cross-modal learning. To address these challenges, we propose a multi-metric optimal transport-based visual-tabular feature alignment network for multimodal classification. Firstly, to tackle the semantic incompatibility between categorical and continuous features in tabular data, a Transformer-based tabular encoder is designed; this module employs a self-attention mechanism to capture complex dependencies among features, providing accurate structured semantic features for cross-modal alignment. Subsequently, a multi-metric optimal transport alignment module is designed, which establishes a structured mapping relationship between image channels and tabular attributes through optimal transport theory, thereby achieving effective alignment for image-tabular cross-modal learning. Finally, a contrastive learning alignment module is designed, which leverages the global information from the feature extraction modules to enhance the consistency of cross-modal global features and learn modality-invariant feature representations. Experimental results demonstrate that our proposed method achieves performance improvements on both medical image and natural image datasets. The method achieves an Accuracy of 0.9884 on the Multi-brain dataset, and an Accuracy of 0.9726 and 0.9296 on the SUN and DVM datasets, respectively.}
}
@article{HARIHARAN2026116265,
title = {Physics-based and machine learning–integrated analysis of adjustable multi-pad journal bearings under load-between-pad configuration},
journal = {Applied Soft Computing},
volume = {203},
pages = {116265},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116265},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626017138},
author = {Girish Hariharan and Nitesh Kumar and Gowrishankar Mandya Chennegowda and Manjunath Shettar and Shiva Kumar and Subraya Krishna Bhat},
keywords = {Adjustable journal bearing, Hydrodynamic lubrication, GPR surrogate model, Bayesian optimization, Response surface analysis},
abstract = {Multi-pad adjustable/active journal bearings offer significant flexibility in controlling hydrodynamic performance through radial and tilt pad adjustments. However, their strongly nonlinear and coupled behaviour poses challenges for efficient performance prediction. In this study, a comprehensive physics-based and machine learning–integrated framework is developed to analyze and predict the steady-state characteristics of 3-pad and 4-pad adjustable journal bearings operating under load-between-pad (LBP) configuration. The hydrodynamic pressure field is obtained by solving the non-dimensional Reynolds equation using a finite difference method coupled with an iterative pressure–attitude angle convergence scheme. Static performance characteristics, including maximum pressure, load capacity, attitude angle, frictional force, friction variable, and flow rate, are evaluated over a wide range of eccentricity ratios, radial adjustments, tilt angles, and number of pads. The resulting comprehensive dataset is subsequently employed to train multi-output surrogate models using Artificial Neural Networks (ANN), Gaussian Process Regression (GPR), and Support Vector Regression (SVR). Bayesian hyperparameter optimization with cross-validation is adopted to ensure robust model generalization. The comparative analysis indicates that GPR provides the highest predictive accuracy, the lowest error dispersion, and the most consistent performance within the investigated operating domain. Parametric response surface analysis using GPR model shows that eccentricity ratio is the dominant factor governing load capacity, pressure, frictional behavior, and lubricant flow. Radial adjustment effectively controls clearance and leakage, with negative adjustment improving load support and frictional efficiency, while positive adjustment enhances flow and cooling at the expense of load capacity. Tilt adjustment was found to influence pressure asymmetry and attitude angle at low to moderate eccentricities, with reduced impact at higher loads. The proposed framework provides a computationally efficient approach for rapid prediction and design-space exploration of adjustable journal bearing performance.}
}
@article{QIAO2026116087,
title = {NSC-Mamba: A hybrid model with adaptive temporal attention and state space dynamics for financial time series forecasting},
journal = {Applied Soft Computing},
volume = {203},
pages = {116087},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116087},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015358},
author = {Xiaoyan Qiao and Dehe Liu and Hua Xing and Feng Zhao and Dapeng Cheng},
keywords = {Stock forecasting, Non-stationary Cross Mamba (NSC-Mamba), Adaptive temporal attention, CrossMamba, Gated parallel fusion of attention and state-space (GPFASS)},
abstract = {Accurate stock price prediction is crucial for capturing industry trends and understanding macroeconomic dynamics. However, the non-stationary and long-range dependent nature of stock prices often causes existing methods to produce overly smoothed forecasts with delayed responses. To address these challenges, the Non-stationary Cross Mamba (NSC-Mamba) is proposed in this paper. Specifically, we introduce an adaptive temporal attention mechanism that dynamically learns scaling and shifting factors to enhance the model’s adaptability to non-stationary trends and local structural variations. In addition, we design the CrossMamba module, which aggregates hidden states across layers to strengthen the model’s ability to capture long-range dependencies. Finally, we propose the Gated Parallel Fusion of Attention and State-Space (GPFASS) module to adaptively regulate the fusion ratio of input features, effectively mitigating over-smoothing and lagging issues in prediction. Experimental results demonstrate that NSC-Mamba outperforms baseline models in prediction accuracy and better captures the dynamics of non-stationary financial time series, exhibiting strong practicality and robustness.}
}
@article{BOWEI2026116139,
title = {Soft computing-driven infrared UAV image synthesis from visible light: Leveraging multi-scale adaptation and physical consistency for real-world anti-UAV applications},
journal = {Applied Soft Computing},
volume = {203},
pages = {116139},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116139},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015875},
author = {Xu Bowei and Zhong Jianlin and Zhuo Changfei and Ji Wenxuan and Yang Huaxin and Luo Xiang and Ding Zhixing},
keywords = {Visible-to-infrared UAV image generation, Hybrid cross-modal modeling, Physics-informed generative learning, Multi-scale adaptive modeling, Anti-UAV perception},
abstract = {This paper addresses three critical challenges in air-to-air infrared unmanned aerial vehicle (UAV) target detection: data scarcity, physical inconsistency, and limited multi-scale adaptability. Visible-to-infrared UAV image synthesis is inherently an uncertain cross-modal mapping task, as the relationship between visible appearance and infrared radiation is incomplete, scene-dependent, and difficult to characterize with a deterministic rule. To this end, we propose the Multi-Scale Physics-informed framework (MSPhys), a hybrid soft-computing framework that integrates deep generative learning, adaptive feature modulation, physically informed modeling, and multi-scale discrimination for high-fidelity visible-to-infrared image synthesis. Specifically, MSPhys incorporates: 1) a physics-aware adaptive normalization layer (Phys-AdaIN+) that embeds TeV temperature-emissivity decomposition into feature modulation; 2) a dual-path encoder with a Laplacian of Gaussian (LoG) filter to enhance multi-scale representations and reduce blur artifacts; 3) a deformable multi-scale sparse cross-attention module (DMSC) to improve cross-modal feature alignment and suppress interference; and 4) a deformable multi-scale discriminator (DMDisc) to enhance robustness in complex scenes and multi-scale UAV representation. Experiments on the Det-Fly and UAVE datasets show that MSPhys achieves consistently superior overall performance across image-quality and downstream detection evaluations compared with existing methods. These results demonstrate the effectiveness and practical value of MSPhys for infrared UAV data generation and anti-UAV perception.}
}
@article{LI2026116212,
title = {MHLPnet: Frequency-band image feature enhancement and adaptive noise suppression for adverse-weather object detection},
journal = {Applied Soft Computing},
volume = {203},
pages = {116212},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116212},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016601},
author = {Sen Li and Xiaohua Cao and Hua Zhou and SiYu Zhang},
keywords = {Adverse weather target detection, Feature denoising, Hybrid neural network, Laplacian pyramid transform, Spectral neural network},
abstract = {Robust object detection using RGB cameras remains a significant challenge for visual perception under adverse weather conditions. Existing detection frameworks encounter significant performance bottlenecks due to pronounced feature degradation and noise amplification, reducing accuracy and stability. To address these challenges, we propose a multi-model hybrid Laplacian pyramid network (MHLPnet) and integrate it into the detection pipeline to form the joint image enhancement detector. MHLPnet decomposes the image into low - and high-frequency components. For the low-frequency information, we propose a spectral neural network dense integration module with varying expansion rates to enhance multi-scale global features. For high-frequency information, we propose a multi-scale central difference convolution module to extract local features. To establish cross-domain feature association, we introduce the affine attention transformation module, using global features as prior information to guide the enhancement of local features. Moreover, we introduce the adaptive noise suppression learning method, which employs a Siamese backbone network. By minimizing the feature discrepancies between the Siamese backbone branches processing the original and noisy images, the noise immunity of the detector is strengthened. Extensive experiments on the ExDark, Rtts, and Cityscapes-Rain datasets show favorable performance of our method, achieving mAP scores of 29.1,44.1,32.2 on noise-corrupted test sets with an inference speed of 15.9 ms, thereby outperforming several state-of-the-art methods on both accuracy and speed.}
}
@article{GAO2026116184,
title = {A dynamic-static spatial information fusion spatiotemporal network for traffic crash prediction considering high-order and dynamic spatial correlations},
journal = {Applied Soft Computing},
volume = {203},
pages = {116184},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116184},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016327},
author = {Pengfei Gao and Rui Zhang and Qiang Zeng and Xiaofei Wang},
keywords = {Traffic crash prediction, Spatiotemporal prediction, Deep learning, Hypergraph learning, Multi-source risk factors},
abstract = {Existing spatiotemporal traffic crash prediction methods exhibit three shortcomings: limited modeling of high-order spatial correlations, neglect of dynamic spatial correlation, and inadequate integration of multi-source spatiotemporal information. To address these issues, this study proposes a Dynamic-Static Spatial Information Fusion Spatiotemporal Network (DSSIF-STNet), which comprises a static spatial information extraction module, a global dynamic spatial information extraction module, and a temporal information extraction module. The static spatial information extraction module uses a hypergraph convolutional network (HyperGCN) to capture high-order spatial correlations based on spatial adjacency and traffic function similarity. The global dynamic spatial information extraction module employs a Self-Attention mechanism to infer time-specific and input-adaptive spatial association weights from dynamic and static risk factors, thereby modeling dynamic spatial correlations as state-conditioned spatial dependencies among grids. A gating mechanism is also used in the module to balance and to fuse static and dynamic spatial information. In the temporal information extraction module, a scalar Long Short-Term Memory (sLSTM), which differs from standard LSTM by combining scalar memory cells with normalized and stabilized exponential gating and new memory mixing, is used to capture temporal dependencies. The Shenzhen case study shows that DSSIF-STNet achieves the best results across all six metrics, reducing RMSE, MAE, and Poisson deviance by 0.4%, 3.5%, and 0.5%, respectively, while improving Precision@30, R², and McFadden pseudo-R² by 1.0%, 3.1%, and 1.1%, with robust performance across temporal granularities. Boruta-inspired feature importance analysis highlights the dominant roles of historical crash distributions, government POI distribution, traffic flow, and road network density. Ablation results confirm that the static high-order spatial module, global dynamic spatial module, spatial encoding, adaptive gated fusion, and sLSTM make distinct and complementary contributions to prediction accuracy, high-risk grid identification, and sparse crash-count modeling. The learned gating values show an adaptive but slightly dynamic-favored fusion pattern. The computational efficiency analysis further shows that DSSIF-STNet achieves improved crash prediction performance with acceptable computational cost, requiring 0.8587 G FLOPs and remaining sufficient for hourly crash risk prediction. Additionally, the analysis of the Self-Attention shows that dynamic spatial correlation is dominated by fluctuation trends of crashes in high-risk areas and determined by the interaction of static and dynamic risk factors.}
}
@article{LAU2026116236,
title = {XRA-Diff: Guided diffusion as a refinement for backprojected coronary angiography X-ray images},
journal = {Applied Soft Computing},
volume = {203},
pages = {116236},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116236},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016844},
author = {Dominik Bernard Lau and Hubert Malinowski and Jerzy Szyjut and Tomasz Dziubich},
keywords = {Diffusion, X-ray coronary angiography, 3D reconstruction, Deep learning, Biomedical engineering},
abstract = {This paper presents a novel pipeline for 3D coronary artery reconstruction from two-view X-ray projections. The methodology consists of an initial backprojection to retrieve a 3D point cloud approximation, followed by a refinement stage using a classifier-free guidance (CFG) diffusion model. The model was trained on synthetic data from the ImageCAS dataset and evaluated on both synthetic and 100 clinical samples. A key contribution of this work is an extensive ablation study on model variants and a detailed examination environment sensitivity analysis. Contrary to initial design assumptions, results demonstrate that for the right coronary artery, a side-agnostic model (trained on both left and right arteries) outperforms side-specific alternatives, while for the left artery, omitting projection conditioning yields the best results. In the proposed synthetic data-based evaluation framework, the best variant achieved a DSC3D of 0.33 for the right side, 0.28 for the left side; O3D(1)=0.59 for the right side, 0.51 for the left side; O3D(2)=0.78 and 0.70 for the left side. A significant improvement in qualitative factors of the reconstruction on clinical data was observed. This work provides a generative alternative to traditional reconstruction methods, addressing their primary limitations, using a strong geometric prior as scaffolding and reaching current state-of-the-art.}
}