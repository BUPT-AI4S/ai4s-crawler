@article{KIM2026116156,
title = {Sports injury forecasting with transformer encoder using athlete self-report measures},
journal = {Applied Soft Computing},
volume = {203},
pages = {116156},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116156},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016042},
author = {Jeongbin Kim and Sanggi Lee and Sungzoon Cho},
keywords = {Athlete self-report measures, Lost time injury, Sports injury forecasting, Training load metrics, Transformer encoder},
abstract = {As advancements in sports technology accelerate, artificial intelligence (AI) is reshaping the player-management landscape. Monitoring players’ physical and psychological status is vital for the players, coaches, and teams. Among the monitored data, injury-related indicators are especially important, as they directly impact player availability and team performance. Academia has focused on lost time injury (LTI), which prevent players from participating in training or matches due to their poor status. However, to date, studies have often relied on data extracted using specific devices, which, despite their relevance, impose spatiotemporal constraints. Accordingly, this study examined app-based data as a lower-burden input source that reduces dependence on the devices. Consequently, the primary objective was to predict LTI by leveraging athlete self-report measures (ASRM). The proposed model includes a transformer architecture to effectively capture the temporal characteristics in ASRM. The model outputs the probability of LTI, which is examined as a potential decision-support indicator for player monitoring. Despite the severe class imbalance inherent in LTI prediction, the model achieved an F1-score of 0.6753 under a nested validation scheme, with a sensitivity of 0.8500 for injury classification. Leave-one-player-out evaluation yielded an F1-score of 0.7746, providing complementary internal evidence of predictive performance for held-out players. This study makes three contributions. First, it provides evidence that ASRM contain useful information for LTI forecasting. Second, our model employs a framework using app-based data that minimizes spatiotemporal constraints. Third, our predictive results support personalized and proactive player management by forecasting injury probability based on a player’s physical and psychological status.}
}
@article{KARKINLI2026116180,
title = {Expected runtime of the limit mechanism in artificial bee colony: Drift bounds, FES-based restarts, and an empirically calibrated limit-scaling rule},
journal = {Applied Soft Computing},
volume = {203},
pages = {116180},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116180},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016285},
author = {Ahmet Emin Karkınlı and Talha Taşkanat and Mustafa Hüsrevoğlu},
keywords = {Artificial bee colony, Expected runtime, Drift analysis, Limit-based abandonment, FES-based restart analysis, Function evaluation budget},
abstract = {The limit-based abandonment mechanism determines how long the Artificial Bee Colony (ABC) algorithm exploits a food source before scout reinitialization is triggered. Although this parameter is commonly set by static rules such as L=SN⋅D, such rules do not explicitly account for target tolerance, success probability, or the function-evaluation cost of stagnation. This paper analyses the limit mechanism from an Expected Runtime (ERT) perspective using local drift arguments and a restart-style cost-success model. To make the abandonment dynamics tractable, an onlooker-free auxiliary process (Aux ABC) is defined, and its relation to an evaluation-augmented comparison process is stated at a fixed cycle index under explicit coupling assumptions. This analysis motivates a scaling family L∗≈cDln⁡(SN/ϵ) that is used as an empirically calibrated rule rather than a theory-derived law: the drift coefficient is obtained as a fitted diagnostic on local error-decay segments, and c is calibrated for the landscape class rather than fixed across landscapes. New multi-landscape limit sweeps on Sphere, Rosenbrock, Rastrigin, Ackley, and a CEC 2017 representative support a cost-success interpretation of the limit parameter and yield a median calibrated constant near c=3 with an upper-quartile conservative value near c=4. A smaller sensitivity study over D, SN, and ϵ is consistent with the usefulness of the scaling direction while remaining landscape dependent. The original CEC 2017 stress-test results are preserved and interpreted under strict FES accounting: finite ERT is reported only when target hits occur, while zero-success regimes are analysed through final best-so-far error distributions. The results indicate that the limit parameter affects both success-attainable and failure-dominant behaviour, with an overall effect that is modest and landscape dependent rather than uniform. Where the onlooker phase is removed, ERT decreases only in a subset of finite-ERT cells, and these cells are concentrated on the smoother and more responsive landscapes; the observation is therefore reported as a conditional cost-accounting result and not as a general advantage over canonical ABC.}
}
@article{YU2026116194,
title = {Trend granulation-based time series long-term prediction under privacy protection},
journal = {Applied Soft Computing},
volume = {203},
pages = {116194},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116194},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601642X},
author = {Yating Yu and Hongyue Guo and Peng Jia and Lidong Wang and Witold Pedrycz},
keywords = {Long-term prediction, Federated learning, Trend-based granulation, Long short-term memory neural network},
abstract = {Time series forecasting based on multiple data sources under the requirement of privacy protection, especially for long-term prediction, presents a significant challenge. Federated learning provides an effective framework for privacy protection in the prediction process. In this study, we propose a trend granulation-based method for time series long-term prediction under the federated learning framework. On the client side, we first adhere to the principle of justifiable granularity to transform numerical time series into trend-based granular time series, capturing as many data features as possible with high accuracy. Then, the client constructs a granular long short-term memory neural network model using locally stored data to explore the relationships within the granular time series. To enable the central server to aggregate reliable client-side models, we propose a client filtering strategy based on the prediction errors. Finally, the global model is constructed to achieve prediction through client collaboration, ensuring the accuracy of the prediction results and the security of data privacy. Experiments on publicly available time series data demonstrate that the proposed model delivers strong prediction performance.}
}
@article{HONG2026116215,
title = {Fuzzy evaluation metrics for multi-class classification based on Top-k softmax confidences},
journal = {Applied Soft Computing},
volume = {203},
pages = {116215},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116215},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016637},
author = {Ji-Hoon Hong and Byung-Sun Won},
keywords = {Fuzzy sets, Deep learning, Classification, Evaluation metrics, Convolutional neural network},
abstract = {Classical evaluation metrics such as precision, recall, and F1 score rely on hard-label predictions obtained from the argmax of softmax outputs. This approach ignores the uncertainty, confidence sharing, and inter-class similarity encoded in the full probability vector. To address this limitation, we propose fuzzy evaluation metrics based on Top-k softmax confidences. By defining fuzzy label vectors and constructing a fuzzy confusion matrix, our method distributes prediction scores across multiple classes and proposes fuzzified counterparts of precision, recall, and F1 score. These fuzzy metrics reveal predictive uncertainty, confidence sharing, class overlaps, and near-correct predictions that are often overlooked by traditional hard-label evaluations. Furthermore, we evaluate our approach on five well-known datasets to compare fuzzy and classical confusion matrices and metrics. The fuzzy evaluation metrics uncover hidden uncertainty in tabular data (Iris), soft decision boundaries observed in vision tasks (MNIST, Fashion-MNIST, CIFAR-10), and nuanced behavior in ordinal settings (Wine Quality). Experimental results further show that fuzzy evaluation provides information complementary to both classical and calibration-based evaluation measures by revealing how confidence is distributed among competing classes.}
}
@article{FERAH2026116223,
title = {Beyond prediction: Interval neural networks for uncertainty-aware system identification},
journal = {Applied Soft Computing},
volume = {203},
pages = {116223},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116223},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626016716},
author = {Mehmet Ali Ferah and Tufan Kumbasar},
keywords = {Interval neural networks, System identification, Uncertainty quantification, Prediction intervals, Deep learning},
abstract = {System identification (SysID) is critical for modeling dynamical systems from experimental data, yet traditional approaches often fail to capture nonlinear behaviors while providing reliable confidence estimates. While Neural Networks (NNs) offer powerful tools for modeling such dynamics, incorporating uncertainty quantification is essential to ensure reliable predictions. This paper presents a systematic framework for constructing and training interval NN (INNs) for uncertainty-aware SysID. By extending crisp neural networks into interval counterparts, we develop Interval LSTM and Interval NODE models that propagate uncertainty through interval arithmetic without probabilistic assumptions. This design allows them to represent uncertainty and produce prediction intervals. For training, we propose two strategies: Cascade INN (C-INN), a two-stage approach converting a trained crisp NN into an INN, and Joint INN (J-INN), a one-stage framework jointly optimizing prediction accuracy and interval quality. Both strategies employ uncertainty-aware loss functions and parameterization techniques to ensure reliable learning. Comprehensive experiments on multiple SysID datasets and comparisons with well-established uncertainty-aware NN baselines demonstrate the effectiveness of both approaches. Specifically, C-INN achieves superior point prediction accuracy, whereas J-INN yields more accurate and better-calibrated prediction intervals. Among the proposed architectures, the INODE models consistently provide the best overall balance between predictive accuracy and uncertainty quantification. Furthermore, to reveal how uncertainty is represented across model parameters, the concept of channel-wise elasticity is introduced, which is used to identify distinct patterns across the two training strategies. The results of this study demonstrate that the proposed framework effectively integrates deep learning with reliable and interpretable uncertainty-aware modeling.}
}
@article{LUO2026116082,
title = {Edge-aware prompt-driven multi-task network for dense visual prediction},
journal = {Applied Soft Computing},
volume = {203},
pages = {116082},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116082},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015309},
author = {Huilan Luo and Minghao Yu},
keywords = {Multi-task learning, Dense prediction, Prompting, Vision transformer},
abstract = {Multi-task visual scene understanding aims to improve performance and efficiency by jointly learning multiple dense prediction tasks, but existing methods suffer from limited task interaction and insufficient separation of shared and task-specific representations. To address this issue, we propose a unified framework with a progressive interaction paradigm that explicitly organizes when and how task-shared and task-specific features interact. Unlike prior methods based on feature fusion, prompt injection, or routing, which entangle interaction in a single-stage process, our method decomposes multi-task learning into three stages: task-specific enhancement, prompt-guided cross-task interaction, and task-specific refinement. Specifically, we design an Edge-Enhanced Attention Block (EEAB), a Prompt-Guided Attention Module (PGAM), and a Task-Specific Enhancement Block (TSEB) to progressively strengthen structure-aware representations, enable prompt-driven cross-task collaboration, and restore task identity. Experiments on NYUD-v2 and PASCAL-Context demonstrate consistent improvements over state-of-the-art Transformer-based baselines.}
}
