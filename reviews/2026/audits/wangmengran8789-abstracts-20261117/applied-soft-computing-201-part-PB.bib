@article{TAO2026115534,
title = {Solving multi-objective production inventory control problems with reinforcement learning aided by differential evolution},
journal = {Applied Soft Computing},
volume = {201},
pages = {115534},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115534},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009828},
author = {Lue Tao and Gongshu Wang and Lijie Su and Yang Yang and Yun Dong},
keywords = {Silicon steel, Production inventory control, Linear quadratic tracking, Q-learning, Differential evolution},
abstract = {This study investigates the multi-objective production inventory control problem characterized by unknown parameters in silicon steel manufacturers. The considered multi-stage divergent production inventory system is composed of production units and warehouses, which need to uphold predetermined inventory levels to ensure production smoothness. In light of the characteristics of steel production, units are regarded as having unknown yield, and the demand for saleable products is considered stock-dependent demand with inherent uncertainties. The problem is defined as a Linear Quadratic Tracking (LQT) problem, focusing on minimizing inventory deviations and regulation quantities through decision-making on production and ordering. Traditional methods face applicability challenges due to the uncertainties of yield and demand rate. Therefore, a Reinforcement Learning (RL) method is employed for problem-solving. To further refine control process indicators and enhance the adaptability and feasibility of the policy, we propose a multi-objective Hybrid Mutation Differential Evolution (HMDE) algorithm, which incorporates various mutation operators, for optimizing multiple indicators by tuning the weight matrix in the LQT model. Furthermore, acknowledging the sensitivity of RL to hyperparameters, we use HMDE to concurrently optimize the key parameters of RL, ensuring the effectiveness of learning. The outstanding control performance of the proposed method is demonstrated through comparative analysis with the traditional inventory control method and the RL algorithm. Meanwhile, the proposed HMDE algorithm also outperforms other advanced multi-objective optimization algorithms in parameter optimization. Finally, the computation time and complexity of the proposed algorithm are discussed, and management insights are obtained through sensitivity analysis of model parameters.}
}
@article{TASAWWUR2026115514,
title = {Robust brain MRI segmentation using IEFCM_SNI: An intuitionistic fuzzy framework with regularized elastic distance and spatial constraint},
journal = {Applied Soft Computing},
volume = {201},
pages = {115514},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115514},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009622},
author = {Aashna Tasawwur and Dhirendra Kumar},
keywords = {Intuitionistic fuzzy sets, Regularized elastic distance, MRI image segmentation, Spatial neighborhood information, Clustering},
abstract = {Accurate segmentation of medical images, particularly brain MRI, is affected by noise, intensity inhomogeneity (INU), and partial volume effects. This paper introduces a Regularized Elastic Distance based Intuitionistic Fuzzy C-Means with Spatial Neighborhood Information (IEFCM_SNI), a novel framework whose core innovation is the regularized elastic distance. This distance metric replaces rigid thresholding with a continuous sigmoid function to enable smooth membership transitions in noisy and inhomogeneous data. Within this foundation, we integrate intuitionistic fuzzy sets (IFS) that model uncertainty through membership, non-membership, and hesitation degrees at ambiguous boundaries. Further, Spatial Neighborhood Information (SNI) term is incorporated with the regularized elastic distance, which adaptively preserves anatomical structures while suppressing noise. The adaptive properties of the proposed distance synergistically unify both components, IFS and SNI. Closed-form solutions for centroids and memberships eliminate computationally expensive alternating optimization used in prior elastic distance-based methods, achieving 33% faster convergence. Comprehensive evaluation on synthetic, BrainWeb, IBSR, and MRBrainS18 datasets with severe noise and INU demonstrates consistent advantages in Average Segmentation Accuracy (ASA) and Dice Score (DS). Statistical analysis (Friedman test with post-hoc Holm correction) confirms IEFCM_SNI (Friedman rank Rj=1.78) significantly outperforms state-of-the-art methods (p<0.05) and further reinforces its robustness, making it a reliable choice for medical image segmentation.}
}
@article{HASSAN2026115486,
title = {Hybrid ensemble learning framework integrating a time-varying decomposition method and optimization technique for accurate disease outbreak prediction},
journal = {Applied Soft Computing},
volume = {201},
pages = {115486},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115486},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009348},
author = {Geehan Sabah Hassan and Haydar Abdulameer Marhoon},
keywords = {Forecasting, Kernel Ridge Regression, Differential evolution, Particle swarm optimization, Decomposition},
abstract = {Accurate disease outbreak prediction is critical in the global effort to prevent and manage the COVID-19 pandemic. Accurately forecasting variations in COVID-19 outbreaks is a complicated and challenging task because to substantial fluctuations in the related data set. Previous research has been limited by relying only on specific forecasting approaches in epidemic modeling, excluding the use of several forecasting techniques. In this context, insufficient attention to detail might lead to inaccurate outcomes. Hence, this research develops a novel ensemble paradigm by combining three machine learning (ML) models including Kernel Ridge Regression (KRR), Ridge Regression, and Least Absolute Shrinkage and Selection Operator (LASSO) in a linear relationship to forecast the COVID-19 pandemic. To optimize the framework, a unique approach is used, which combines differential evolution and particle swarm optimization with a multi-strategy. In addition, the input variables are broken down using a specific decomposition approach called time-varying filter empirical mode decomposition (TVF-EMD). Furthermore, a highly effective feature selection method, referred to as extreme gradient boosting (XGBoost), is used to identify the most significant input variables. The experimental illustrations utilized in this study involve daily COVID-19 datasets from Iraq and Albania. The results of the study demonstrate that the model developed in this research is highly effective in predicting epidemics across different and complex scenarios. Statistically, the proposed modeling approach TVF-EMD-L-KRRL attained superior results for COVID-19 cases in Iraq (COV-Ir) and Albania (COV-Al) at seven days ahead (t + 7) with maximum correlation coefficient (R = 0.98 and 0.987), respectively. The proposed ensemble model outperforms all of the other models evaluated in this study in terms of accuracy and robustness.}
}
@article{WU2026115522,
title = {Pursuing sensitivity-aware probability reallocation in cross-level distillation for machine unlearning},
journal = {Applied Soft Computing},
volume = {201},
pages = {115522},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115522},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009701},
author = {Yirui Wu and Shijia Qiao and Jianzhou Wang and Lixin Yuan and Wenxiao Zhang and Tong Lu},
keywords = {Machine unlearning, Knowledge distillation, Data privacy, Contrastive learning},
abstract = {With increasing concerns about secure AI systems especially data privacy issues, Machine Unlearning(MU) has attracted growing attention, aiming to remove specific data from a trained model without retraining. Most current methods suffer from performance degradation in either remembering or forgetting categories, referred to as overly forgetting and incomplete forgetting respectively. To alleviate these issues, we propose Cross-level Distillation based Machine Unlearning(CD-MU) with contrastive enhanced knowledge. To mitigate overly unlearning, a cross-level distillation structure is first proposed to transfer both abstracted and discriminative knowledge from teacher to student. Built on student network, we further design contrastive feature enhancing module to strengthen the ambiguous knowledge about the forgetting categories, thus mitigating incomplete unlearning. Experiments on public datasets show that CD-MU maintains a gap (1.24%) that is at least as small as that of all compared methods. Tests in privacy-sensitive scenarios show its robustness against membership inference attacks.}
}
@article{LIN2026115609,
title = {Imperfect experience-guided reinforcement learning for coordinated optimization of the thickening-dewatering process},
journal = {Applied Soft Computing},
volume = {201},
pages = {115609},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115609},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010574},
author = {Ranmeng Lin and Runda Jia and Jun Zheng and Dakuo He and Kang Li and Fuli Wang},
keywords = {Reinforcement learning, Learning from demonstration, Imperfect experience, Coordinated optimization, Process control},
abstract = {Coordinated optimization of the thickening-dewatering process is crucial for reducing energy consumption in hydrometallurgy. Reinforcement Learning (RL) offers a promising solution to this complex sequential decision-making problem, but its high cost of online exploration limits its application in real-world industrial environments. A viable approach to enhance RL efficiency is to leverage existing historical operational data from the plant to guide the learning process. However, such data are often imperfect, exhibiting sub-optimality and sparsity. In this paper, we refer to this imperfect data as historical experience. To address this challenge, this paper proposes the experience-guided RL (EGRL) framework. EGRL effectively utilizes imperfect historical experience through two core components. The first is a value-regularized actor–critic architecture that balances leveraging sub-optimal experience with autonomous exploration through a regularized value function. The second is a non-parametric guidance algorithm based on nearest neighbors that smoothly generalizes sparse experiential knowledge to unseen states, thereby maintaining effective state-dependent guidance when the agent encounters operating conditions not covered by historical data. We validate our framework in a high-fidelity simulation environment. Experimental results demonstrate that, compared with mainstream RL baselines and the domain-specific state-of-the-art algorithm, EGRL improves learning efficiency and achieves lower total energy consumption, validating its effectiveness under imperfect historical experience. This demonstrates the potential of EGRL in handling the flawed data characteristic of real-world applications.}
}
@article{PHAN2026115621,
title = {GuidedDCNet: A diffusion-integrated framework with multi-scale conditional guidance for enhanced data classification},
journal = {Applied Soft Computing},
volume = {201},
pages = {115621},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115621},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010690},
author = {Minh Nhat Phan and Thi Hoang Phuong Nguyen and Van Hieu Nguyen},
keywords = {GuidedDCNet, Diffusion-based classification, Multi-scale conditional guidance, Noisy data robustness, Maximum mean discrepancy loss},
abstract = {Despite often achieving strong results, current classification methods tend to overuse the full features and lack flexibility due to specialized architectures. To address these challenges, this study proposes GuidedDCNet—a diffusion-integrated framework for robust classification in noisy data. Its key innovation, the Multi-scale Conditional Guidance Mechanism, enables parallel processing of global and local features, while the denoising diffusion process, implemented with conditional U-Net, is optimized via the Maximum Mean Discrepancy Loss Function to enhance generalization and stability. Comprehensive evaluations on 16 diverse datasets demonstrate that GuidedDCNet consistently outperforms existing approaches across multiple data modalities. Specifically, it achieves state-of-the-art results on one-dimensional data (99.58% and 98.78% on two NIR datasets), two-dimensional data (90.67% and 96.51% on two image datasets), and high-dimensional text data (where it surpasses ST5-XXL on 7 out of 12 datasets and significantly outperforms BERT-base, achieving an average accuracy of 71.70% vs. 61.66% on the MTEB benchmark), all while maintaining significantly lower parameter complexity. Furthermore, ablation studies validate the effectiveness of the proposed design, reinforcing its potential as a new paradigm for high-accuracy, multimodal classification tasks with enhanced robustness and practical applicability. Code is available at: https://github.com/PhanNhat02092003/GuidedDCNet}
}
@article{YANG2026115561,
title = {Fuzzy multi-rank supervised two-dimensional canonical correlation analysis and its applications to image matrix feature fusion},
journal = {Applied Soft Computing},
volume = {201},
pages = {115561},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115561},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010094},
author = {Jing Yang and Liya Fan and Quansen Sun},
keywords = {2DCCA, Feature fusion, Supervised information, Fuzzy membership degree},
abstract = {Two dimensional canonical correlation analysis (2DCCA) does not require vectorization of the image matrix, thus preserving the original structural information of the image and reducing the computation time. However, due to the lack of use of supervised information in the feature extraction process, it cannot achieve satisfactory recognition performance in pattern classification. In order to fully utilize the label information and fully consider the distribution information of the samples, based on fuzzy set theory, in this paper, we propose a new feature extraction method, i.e., fuzzy multi-rank supervised two-dimensional canonical correlation analysis (FMR2DCCs). FMR2DCCs first categorizes the samples into all the classes through the fuzzy membership degree function, and redefines the inter-class scatter matrix and intra-class scatter matrix according to the membership degree, based on these fuzzy scatter matrices, an optimization model for the FMR2DCCs is constructed, finally, it is solved in order to obtain two left-projected full rank matrices with rank d1 and two right-projected full rank matrices with rank d2. Experimental results on five popular datasets show that our proposed method combined with the membership function not only has better classification performance, but also has better robustness.}
}
@article{WANG2026115605,
title = {Keyword-speaker-extraction-generation (KSEG): A two-stage summarizing framework for Chinese online medical dialogue text},
journal = {Applied Soft Computing},
volume = {201},
pages = {115605},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115605},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010537},
author = {Qunbo Wang and Xuelin Yong and Yongxian Wang and Zhongyan Li and Xiaoying Wang and Jianwei Gao},
keywords = {Medical dialogue, Text summarization, Extractive-abstractive hybrid model},
abstract = {The exponential growth of online medical consultation platforms has generated millions of doctor-patient dialogues, yet automated summarization faces formidable challenges due to substantial conversational noise, sparse diagnostic information distribution, and critical terminological precision requirements. Existing approaches suffer from three fundamental limitations: coarse-grained processing that fails to filter non-informative segments within utterances, inadequate mechanisms for faithful reproduction of domain-specific medical entities, and prohibitive computational costs hindering clinical deployment. To address these challenges, we propose KSEG (Keyword-Speaker-Extraction-Generation), a two-stage neural framework synergistically integrating domain knowledge with deep learning architectures. In the extraction stage, we introduce fine-grained segment-level processing using punctuation delimiters for precise noise filtering, combined with medical term density weighting based on logarithmic functions and dynamic speaker role modeling. This design leverages Robustly Optimized Bidirectional Encoder Representation from Transformers Pretraining Approach (RoBERTa) encoding with Dilated Gated Convolutional Networks (DGCNN) to achieve 70% input sequence reduction while maintaining information integrity. In the generation stage, we construct a hybrid architecture combining Neural Contextualized Representation for Chinese Language Understanding (NEZHA) and Unified Language Model (UniLM), augmented with a structured tri-label copy mechanism, termed BIO-COPY (Begin/Inside/Outside-copy), grounded in longest common subsequence alignment. Unlike conventional Pointer-Generator networks, our mechanism employs structured tri-label control (generate/copy-start/copy-continue) to explicitly guide medical entity reproduction, ensuring terminological fidelity without complex attention computation. Comprehensive experiments on IMCS-21 demonstrate KSEG’s superiority: ROUGE-1/2/L scores of 61.37/47.33/57.66, surpassing strong baselines by 3–11 points and exceeding most large language models with only 200 million parameters. Entity recognition and negation detection evaluations verify its superior factual accuracy, with micro F1 scores of 0.9417 and 0.8763 respectively, significantly reducing hallucinations. Zero-shot transfer experiments on the MC dataset show its strong cross-specialty generalization ability. Further ablation studies reveal that removing the BIO-COPY module leads to a 7.59-point ROUGE-1 drop, confirming its critical role in ensuring medical entity fidelity. Sensitivity analysis identifies optimal hyperparameters for extraction threshold and loss balancing. Failure analysis uncovers three systematic limitations of BIO-COPY, including boundary conflicts, nested entities, and cross-turn fragmentation, providing clear directions for future improvement. Human evaluation further confirms its advantages in readability, integrality and authenticity, especially in clinical authenticity. This work establishes a new paradigm prioritizing domain-aware constraints over purely data-driven approaches, demonstrating that task-specific architectural innovations achieve competitive performance with substantially reduced computational resources, particularly suitable for resource-constrained clinical environments where safety and efficiency are paramount.}
}
@article{LEI2026115589,
title = {Image reconstruction method inspired by a multi-objective bilevel optimization framework for imaging in electrical capacitance tomography},
journal = {Applied Soft Computing},
volume = {201},
pages = {115589},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115589},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010379},
author = {Jing Lei and Qibin Liu},
keywords = {Imaging method, Multi-objective bilevel optimization, Machine learning, Learnable prior image, Electrical capacitance tomography},
abstract = {Low-fidelity images limit the application potential of electrical capacitance tomography in multiphase flow measurement. This study frames the imaging problem within a multi-objective bilevel optimization framework and introduces a new multi-objective bilevel extreme learning machine to infer prior information, which provides a comprehensive solution to improve reconstruction quality and robustness. The new model involves an upper-level optimization for parameter learning and a lower-level optimization for image reconstruction. The feedback mechanism arising from the interaction between the upper-level and lower-level optimization problems improves reconstruction efficiency and process automation. A new multi-objective bilevel extreme learning machine is proposed to infer prior information, achieving automatic model parameter selection and training. A new algorithm is introduced to solve the proposed multi-objective bilevel optimization imaging model, featuring the alternative solution of the upper and lower-level optimization problems. The evaluation results indicate that the proposed algorithm outperforms existing methods in comprehensive reconstruction metrics. Our methodology inspires new directions in imaging algorithm development.}
}
@article{LI2026115641,
title = {A constrained multi-objective co-evolutionary algorithm with dynamic game},
journal = {Applied Soft Computing},
volume = {201},
pages = {115641},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115641},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010896},
author = {Yongchao Li and Heming Jia and Xinyan Lin},
keywords = {Constrained multi-objective optimization, Dynamic game theory, Dynamic resource allocation, Dual-population co-evolution, Adversarial win-rate model, Spatial sensitivity evaluation, Evolutionary computation},
abstract = {Constrained multi-objective optimization problems (CMOPs) are of critical importance in many real-world applications. However, their inherent high dimensionality, complex constraint structures, and conflicting objectives pose significant challenges for optimization. In order to overcome these difficulties, this study proposes DGCMOEA, an innovative co-evolutionary algorithm designed within a dual-population framework. The innovation of DGCMOEA lies in three key components. First, it introduces a cooperative mechanism between a primary and an auxiliary population. The primary population focuses on local exploitation within the feasible region, while the auxiliary population explores infeasible areas under relaxed constraints. This design expands the search space and enhances global exploration capabilities. Second, the algorithm incorporates game-theoretic principles and spatial perturbation sensitivity to guide environmental selection. Specifically, it adopts a rank-based adversarial win-rate strategy that provides non-parametric robustness against extreme fitness outliers in the infeasible space, dynamically balancing selection pressure and population diversity. Third, a Cournot-inspired heuristic resource allocation strategy is developed to balance offspring generation between the two populations. This model adaptively distributes resources based on each population’s convergence cost and spatial diversity, mitigating the inefficiencies commonly observed in traditional static allocation methods. Experimental evaluations on 42 standard benchmark functions and three practical engineering problems reveal that DGCMOEA demonstrates highly competitive overall performance, showing superiority over seven leading constrained multi-objective evolutionary algorithms on a majority of the tested instances.}
}
@article{SHEN2026115625,
title = {Two-level hierarchical touch representation for behavioral biometrics based implicit authentication},
journal = {Applied Soft Computing},
volume = {201},
pages = {115625},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115625},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010732},
author = {Zhihao Shen and Chengmei Zhao and Cong Zou},
keywords = {Mobile security, Behavioral biometrics, Implicit authentication, Privacy protection},
abstract = {Implicit authentication allows smartphones to determine the legitimacy of a smartphone user’s identity transparently through behavioral biometrics of the user. As the most common interaction manner between the smartphone and user, touch behavioral biometrics has been proven unique and widely used for implicit authentication. Despite encouraging progress, existing studies on touch-based authentication remain limited by insufficient gesture representation capability. First, most prior work constructs touch gesture representations based on application programming interface(API)-supplied touchscreen data, which provides only coarse-grained position and timing information. Second, the existing gesture representations are largely gesture-isolated, overlooking the inherently sequential and temporally irregular nature of user interactions, and thus failing to capture identity-discriminative information embedded in inter-gesture time intervals. In this paper, we propose a novel two-level Hierarchical Representation method based implicit Authentication system HRAuth using fine-grained capacitive touchscreen signals. Specifically, HRAuth continuously processes real-time low-level capacitive touchscreen data and constructs a two-level hierarchical touch behavior representation. At the intra-gesture level, spatial–temporal features capture fine-grained fingertip contact and motion dynamics, while at the inter-gesture level, a touch-interval-aware long short-term memory (TIA-LSTM) models sequential dependencies by explicitly incorporating irregular inter-gesture time intervals, uncovering identity-discriminative information beyond isolated gestures. Extensive experiments have been conducted on a large-scale capacitive touchscreen dataset collected from a real-world environment. Results demonstrate the effectiveness of our proposed two-level hierarchical touch behavior representation method, and the superiority of HRAuth over state-of-the-art systems.}
}
@article{LI2026115686,
title = {Interpretable day-ahead photovoltaic power forecasting model integrating multi-scale trend perception and regional carbon emission assessment},
journal = {Applied Soft Computing},
volume = {201},
pages = {115686},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115686},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011348},
author = {Runze Li and Jianzhou Wang and Menggang Kou and Yamei Chen and Yuansheng Qian},
keywords = {Photovoltaic power forecasting, Time series decomposition, Multi-task learning encoder decoder, Causal inference, Regional carbon emission reduction},
abstract = {Accurate day-ahead photovoltaic power forecasting is important for the safe operation and dispatch of power systems. Existing models have two main problems. Traditional machine learning methods cannot fully capture the complex patterns in photovoltaic power data, and most models only work for ultra-short-term forecasting, so they do not meet day-ahead needs. To solve these problems, this study proposes an explainable multi-task learning encoder-decoder model for day-ahead photovoltaic forecasting. First, the raw data are cleaned with Isolation Forest and multivariate imputation by chained equations to detect outliers and fill in missing values. Then a fast online decomposition method is designed. It uses a fixed-window moving average to extract the trend and a periodic average to extract the seasonal pattern. All steps use only past data, so future information is not leaked. The trend, seasonal component, and weather variables are sent into a shared encoder, and the trend and the seasonal-weather features are then handled by two connected decoders. Their outputs are combined through a dynamic and static gating fusion module. A new loss function with dynamic weighting and physical constraints is added to balance the trend and seasonal tasks during training. The model is tested on real data from several photovoltaic stations in Hebei, China, and gives reliable day-ahead results under complex weather. An explainability analysis using Shapley additive explanations and causal forests reveals the main driving factors. With accurate day-ahead forecasts, the model reduces backup thermal power use and supports low-carbon, economical grid scheduling.}
}
@article{GUO2026115593,
title = {Identity-preserving, emotion-faithful face synthesis via multi-dimensional conditional fusion},
journal = {Applied Soft Computing},
volume = {201},
pages = {115593},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115593},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010410},
author = {Qi Guo and Kefan Li and Zhihui Wang},
keywords = {Synthetic face generation, Face recognition, Emotion recognition, Diffusion models},
abstract = {While diffusion-based synthetic face generation shows promise for privacy-preserving model training, existing methods fail to produce fine-grained facial details essential for robust recognition performance. Face recognition requires precise geometric structures, while emotion recognition demands subtle micro-expressions, limiting recognition accuracy of models trained on synthetic data. We propose Multi-Dimensional Conditional Fusion (MDCF), an enhanced diffusion framework generating high-quality synthetic faces optimized for both face and emotion recognition through unified architectural innovations. MDCF addresses identity consistency while preserving authentic emotional expressions via improved reference processing. We develop a Global-Local Fusion Reference Style Extraction Mechanism employing attention-based enhancement and hierarchical feature extraction to capture identity-preserving global characteristics and emotion-critical micro-expressions. We design a Multi-Dimensional Hybrid Condition Generator integrating spatial, channel, and semantic conditioning with domain adaptation layers for improved cross-task optimization. Through multi-level constraint optimization incorporating pixel-level reconstruction, identity consistency, perceptual authenticity, and statistical alignment, MDCF generates synthetic datasets with enhanced visual quality and task-specific characteristics. Extensive experiments demonstrate MDCF’s effectiveness: achieving 86.83% average accuracy on five face recognition benchmarks with only 9.17% gap from real data, and consistent improvements across four emotion recognition datasets with seven backbone architectures, showing robust cross-architecture generalization. We contribute two task-specific synthetic datasets and provide open-source implementations at https://github.com/IMUEEMM/MDCF, establishing foundations for advancing recognition research while addressing data scarcity and privacy concerns.}
}
@article{ZHANG2026115565,
title = {A missing multi-dimensional sequence data imputation method based on principal component reconstruction algorithm},
journal = {Applied Soft Computing},
volume = {201},
pages = {115565},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115565},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010136},
author = {Yan Zhang and Feng Tian and Zongbao Liu and Fang Liu and Xuancong Lang},
keywords = {Missing multi-dimensional sequence data, Data repair, Matrix factorization, Principal component reconstruction algorithm,  fast search},
abstract = {Multi-dimensional sequence data serves as an important basis for state perception, trend analysis, behavior prediction, and decision control. It exhibits characteristics such as strong business relevance, a large volume, high re-acquisition costs, and an "irretrievable" nature. Therefore, how to quickly and effectively impute its missing data has long been a research hotspot in the field of big data governance. To improve imputation performance, ensure adaptability to multi-dimensional and large-volume data scenarios, and avoid overly complex model training processes, we formulate a two-step principle: "first improving performance, then enhancing speed". First, based on the matrix factorization design principle, we incorporate a method for constructing a multidimensional sequence-trajectory matrix (MSTM) and design a principal component reconstruction algorithm (PCRA). This algorithm can not only select sensitive features but also preserve both the spatiotemporal dependencies of features and the business relevance among features, thereby maintaining satisfactory imputation performance in multi-dimensional sequential data environments. Then, to ensure that the combination of window length M and principal components number K maintains high speed even in a large search space while maintaining "approximate optimality", we design a fast search algorithm with boundary constraints and termination criteria (FSBC) for the PCRA. Meanwhile, to avoid reliance on manual intervention, we propose an automatic method for calculating the termination threshold for the FSBC algorithm. Finally, we conduct a series of experiments to verify the convergence of the PCRA algorithm, analyze its performance advantages under different data volumes, missing dimensions, and missing rates, discuss the influence of the M-K combination on the PCRA algorithm, and demonstrate that the PCRA algorithm has good generality in various application scenarios, such as meteorological observation and satellite ranging.}
}
@article{CHEN2026115617,
title = {Robust fairness under domain shifts: A triple-contrastive approach with learnable perturbation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115617},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115617},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010653},
author = {Jing Chen and Ayong Ye and Fu Liao and Qiuling Chen and Jianwei Chen},
keywords = {Triple-contrast fairness, Cross-domain, Distribution shift, Perturbation, Debiasing},
abstract = {As artificial intelligence becomes increasingly prevalent in areas such as social governance, financial credit, and medical diagnosis, the fairness of algorithmic decision-making has become a critical concern. In dynamic real-world environments, training data often differ from actual deployment scenarios. Models that rely on fixed training distributions struggle to adapt to changes in minority or sensitive group features, which can intensify inter-group disparities and lead to unfair decisions. Existing methods are limited by their reliance on static distribution assumptions and the neglect of sensitive attribute constraints in domain generalization, both of which can amplify biases during model transfer. Therefore, this study presents CDFair: a cross-domain fairness learning method based on semantic preservation and triple contrastive learning. The framework simulates domain shifts through a learnable perturbation module and incorporates a stereoscopic fairness-aware contrastive constraint that jointly optimizes along three dimensions. This design effectively suppresses spurious correlations between sensitive attributes and target labels, achieving a unified optimization of distributional robustness and fairness. In real-world task evaluations, CDFair achieves average accuracies of 92.83% on FairFace and 92.06% on YFCC100M-FDG, exceeding the previous best methods by 0.75 and 2.80 percentage points, respectively. At the same time, it reduces the demographic parity difference (ΔDP) to 0.029 and 0.043. These results demonstrate the effectiveness and practical value of our approach.}
}
@article{WANG2026115592,
title = {A neighbor-driven imbalanced Gaussian Naive Bayes algorithm fusing local parameters and prior correction},
journal = {Applied Soft Computing},
volume = {201},
pages = {115592},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115592},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010409},
author = {Wei Wang and Shuang Ouyang and Fen Liu and Yanxi Li},
keywords = {Gaussian Naive Bayes, Imbalanced data classification, Local parameter estimation, Neighbor-driven, Prior correction},
abstract = {Gaussian Naive Bayes (GNB) faces fundamental challenges in handling real-world data with both local heterogeneity and class imbalance. This paper proposes NLD-IGNB, a novel neighbor-driven improved model, whose core is a dual-module framework that can collaboratively optimize local parameter estimation and dynamic prior correction. Different from GNB and its variants that rely on global statistics, NLD-IGNB captures local patterns in heterogeneous data through intra-class KNN weighted local estimation, and adaptively adjusts to local class distributions via full-sample KNN-guided prior correction. The two components form a closed loop to enhance the context awareness of classification decisions. In extensive experiments covering 39 datasets with imbalance ratios ranging from 1.3 to 577.9, NLD-IGNB achieves a peak value of 0.6892 on the F1-measure, the core metric for imbalanced classification. Meanwhile, it ranks first in both the average ranking of the F1-measure and the comprehensive average ranking of five key indicators including AUC and G-mean, significantly outperforming 12 state-of-the-art methods such as cost-sensitive random forest and focal loss LightGBM. Statistical tests verify the significance of its superiority. The model shows particularly prominent advantages in scenarios with high local heterogeneity, discrete features, and ambiguous global class boundaries, especially with clear local clustering structures. This study not only provides an efficient and practical solution for imbalanced classification tasks in key fields such as financial risk control and industrial inspection, but more importantly, introduces a new data-driven, local-aware model adaptation paradigm for the Naive Bayes family, enabling it to better cope with distribution uncertainty in complex real-world data.}
}
@article{SINGH2026115644,
title = {An analysis of deepfake technology: A systematic review of creation, detection, and mitigation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115644},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115644},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010926},
author = {Archana Singh and Ankit Kumar Jaiswal},
keywords = {Deepfakes, Deep learning, Generative adversarial networks (GANs), AI-generated disinformation, Multimodal analysis, Ethical AI},
abstract = {The rapid development of artificial intelligence has contributed to the advent of deepfakes, highly realistic synthetic media that the majority of which is created through the deep learning techniques. These technologies are providing the benefit of being at the forefront of digital communication, education and entertainment but they are also threatening to cause serious risks to the trust, privacy and security of the people. This is a systematic literature review (SLR) that gives an in-depth analysis of the deepfake generation processes, detection and mitigation strategies, and more so, deep learning methods. With the help of the PRISMA protocol, a total of 90 or more relevant studies have been synthesized on the basis of scholarly publications released since 2018 in five large academic databases. The performance, robustness and real-world applicability of the state-of-the-art architectures such as CNNs, GAN-based models, transformer models and novel diffusion-based models are systematically compared and contrasted in the review. Through a strict comparative study, we establish key variables of deepfake realism in the form of quantitative standards, test detection mechanisms along the various dimensions of performance (accuracy, generalization, efficiency, robustness), and compile cross-disciplinary mitigation measures at the technical, legal, and social levels. The main conclusions are the importance of the emergent trends of multimodal detection systems, real-time forensics, explainable AI, and the necessity of diverse and high-quality datasets. In this way, this research exposes gaps in the current literature and offers future research directions, especially in enhancing generalization, scalability and adversarial robustness. To resolve these issues, the research paper suggests future research directions that put more focus on cross-dataset verification, the creation of various high-quality benchmarks, adversarial training models, and evaluation procedures that could enhance generalization and practice. The review adds a systematic, critical view of how deep learning is not only facilitating but fighting deepfakes thereby informing scholars, policymakers and technologists who seek to balance the dual aspects of this revolutionary technology.}
}
@article{SAMAD2026115636,
title = {Imputation-free learning of tabular data with missing values using incremental feature partitions in transformer},
journal = {Applied Soft Computing},
volume = {201},
pages = {115636},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115636},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010847},
author = {Manar D. Samad and Kazi F. Akhter and Shourav B. Rabbani and Ibna Kowsar},
keywords = {Missing values, Data quality, Attention, Incremental learning, Imputation, Deep learning},
abstract = {Tabular data sets with varying missing values are prepared for machine learning using an arbitrary imputation strategy. Synthetic values generated by imputation models often raise concerns regarding data quality and the reliability of data-driven outcomes. To address these concerns, this article proposes an imputation-free incremental attention learning (IFIAL) method for tabular data with missing values. A pair of attention masks is derived and retrofitted to a transformer to directly streamline tabular data without imputing or initializing missing values. The proposed method incrementally learns partitions of overlapping and fixed-size feature sets to enhance the performance of the transformer. The average classification performance rank order across 17 diverse tabular data sets highlights the superiority of IFIAL over 11 state-of-the-art learning methods with or without missing value imputations. Additional experiments corroborate the robustness of IFIAL to varying types and proportions of missing data, demonstrating its superiority over methods that rely on explicit imputations. A feature partition size equal to one-half the original feature space yields the best trade-off between computational efficiency and predictive performance. IFIAL is one of the first solutions that enable deep attention models to learn directly from tabular data, eliminating the need to impute missing values. The source code for this paper is available at https://anonymous.4open.science/r/ifial-435B}
}
@article{LORKIEWICZ2026115504,
title = {A hybrid intelligence approach for assessing packaging sustainability claims in e-commerce},
journal = {Applied Soft Computing},
volume = {201},
pages = {115504},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115504},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600952X},
author = {Wojciech Lorkiewicz and Adam Wasilewski},
keywords = {Circular economy, Large language models, Fuzzy logic, Environmental, Social, And governance analysis, E-commerce packaging, Hybrid intelligence},
abstract = {The growth of e-commerce in recent years has led to increased concerns about its implications for packaging waste. The pressure and legal regulations are pushing companies to disclose their efforts to reduce packaging waste and clearly present these efforts in their annual sustainability reports. While existing literature highlights the challenges of auditing these reports, current analytical methods often lack the scalability and objectivity needed to handle the ambiguity inherent in corporate disclosures. This study addresses the challenge of analyzing sustainability reports by developing and validating an innovative hybrid intelligence framework for automated assessment of corporate packaging management claims. The proposed approach uses a two-step methodology: an extraction step and fuzzy inference step. First, a large language model automatically extracts relevant statements from unstructured sustainability reports. Then, a fuzzy inference system assesses the credibility of the extracted claims, capturing subtleties that other methods may overlook. This process generates a quantitative, auditable score of a company’s commitment to packaging management, enabling transparent and reliable comparisons between companies and sectors. Applying the proposed approach to 11 leading e-commerce companies revealed significant differences in reporting strategies. For instance, between 2022 and 2023, Coupang increased its Packaging Circularity Commitment Score by 44.7% while reducing claim volume, whereas Alibaba’s score fell by 25.7% despite a 61.2% increase in claims. Validation of the extracting component against expert annotations showed high precision but low recall. The comparative analysis of leading models - including Google’s Gemini, OpenAI’s ChatGPT, xAI’s Grok, and Anthropic’s Sonnet - achieved a peak F1-Score of 0.593. This result highlights the need for a hybrid approach involving human supervision to ensure comprehensive data collection. The proposed methodology provides a transparent, scalable, and data-driven tool for stakeholders to audit the quality and credibility of corporate disclosures. It helps identify potential greenwashing and increases accountability in reporting, thereby encouraging companies to align their public claims with tangible progress in sustainable packaging.}
}
@article{WANG2026115513,
title = {MSTR-RiskNet: A multi-scale temporal relational framework for training-related injury risk prediction},
journal = {Applied Soft Computing},
volume = {201},
pages = {115513},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115513},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009610},
author = {Zhiyi Wang and Zhijun Guan and Zhen Wang and Hui Zhou},
keywords = {Injury risk prediction, Temporal modeling, Graph neural networks, Survival analysis, Sports analytics},
abstract = {Training-related injury risk prediction is important for athlete health management and training-load decision support, yet accurate forecasting remains difficult because injury outcomes depend on temporal workload accumulation, inter-individual variability, incomplete observations, and substantial class imbalance in real-world monitoring data. Existing approaches often emphasize either temporal modeling or statistical risk estimation, which limits their ability to jointly represent injury progression and shared contextual patterns. To address these challenges, we propose MSTR-RiskNet, a multi-scale temporal relational framework that combines hierarchical temporal encoding, dynamic relational graph learning, and discrete-time survival prediction. The model uses a multi-resolution temporal encoder to represent short-, mid-, and long-term workload dynamics, a dynamic relational graph module to exchange information among athletes with similar latent states, and a dual-head predictor to estimate both injury probability within a predefined horizon and time-to-event distributions. In addition, an imbalance-aware generative augmentation mechanism is used only during training to enrich high-risk windows, and a lightweight cross-athlete alignment regularizer is used to reduce representation shifts across athletes or teams. Experiments on sports injury datasets and a separately labeled clinical temporal-event stress test suggest that the proposed framework performs competitively against representative baselines. Importantly, the clinical dataset is not treated as a sports injury dataset; it is used only to examine whether the temporal-event modeling components remain stable under a non-sports domain. The results indicate that combining temporal and relational representation learning is a promising direction for injury risk forecasting, while deployment still requires prospective validation, privacy safeguards, fairness assessment, and human expert oversight.}
}
@article{LIU2026115608,
title = {A multi-domain feature enhancement network for hyperspectral image classification},
journal = {Applied Soft Computing},
volume = {201},
pages = {115608},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115608},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010562},
author = {Yi Liu and Shanjiao Jiang and Caihong Mu and Xinyu He and Haoran Wang and Rongrui Teng},
keywords = {Hyperspectral Image Classification, Graph Convolutional Fusion, Feature Enhancement, Graph Wavelet Convolution, Spectral Attention Mechanism},
abstract = {Hyperspectral image classification methods based on convolutional neural networks (CNNs) can achieve high classification accuracy, but relies on a large number of labeled samples. It is also difficult for CNNs to effectively capture global information, and too many convolutional layers will increase the computational complexity of the model. Besides, classification methods combined with traditional frequency-domain analysis remain insufficient attention to local details. To address these problems, this paper combines frequency-domain analysis with a graph convolutional network to fully explore the feature distribution and spatial topological relationships between samples. Meanwhile, a lightweight CNN is also considered to supplement detail features, thus integrating multiple features in the frequency-spatial domain and the superpixel-pixel level, as well as enhancing features in the spectral domain. A multi-domain feature enhancement network (MFEN) based on graph-structured frequency-domain filtering with spectral attention and lightweight spatial branch is proposed for hyperspectral image classification. MFEN makes full use of the spectral distribution and spatial similarity of hyperspectral images when constructing the graph structure, and uses a graph wavelet convolution to extract local frequency-domain features of different scales, which will be fused with global spatial features extracted by a fast dynamic graph convolution. On the CNN branch, a depthwise separable convolution and a deformable convolution constitute a lightweight spatial feature enhancement module, making the classification model more suitable for practical application scenarios. The experimental results demonstrate the superiority of the proposed method in classification performance and the effectiveness of composition modules, and this method achieves great classification accuracy even with limited labeled samples. The source code is available at https://github.com/111cheese/MFEN.}
}
@article{KIM2026115498,
title = {Soft-computing framework for 3D subsurface geospatial modeling using point-cloud-driven ensemble machine learning and deep learning},
journal = {Applied Soft Computing},
volume = {201},
pages = {115498},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115498},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009464},
author = {Han-Saem Kim},
keywords = {3D geospatial modeling, Underground visualization, 3D deep learning, Machine learning, Ensemble-based optimization},
abstract = {In modern geotechnical practice, high resolution 3D subsurface models are essential for understanding complex stratigraphy and supporting design of resilient infrastructure. We present a data-driven framework that converts sparse 2D borehole logs into detailed 3D voxel models via an ensemble learning approach. A large synthetic geotechnical dataset, generated by parametrically sampling layer thicknesses and lithologies from real borehole statistics, was used to assess model performance under varying borehole density and geological variability. Within this framework we compare machine learning (ML) models (ANN, RF, SVM, etc.) against 3D deep learning (DL) architectures (PointNet, VoxelNet, SECOND, PointPillars) for subsurface layer classification and property regression. Consistent with prior geotechnical ML studies, it was observed that among the ML models an artificial neural network achieved the highest accuracy. Among the 3D deep learners, a VoxelNet-style volumetric network was most effective particularly in cases of high spatial heterogeneity. These results highlight the value of volumetric deep learning; recent studies have suggested that deep-network approaches can complement, and in some settings outperform, classical geostatistical interpolation in 3D ground modeling. Finally, our high-fidelity 3D models have direct engineering relevance. Accurate voxelized stratigraphy aids site-specific analyses and hazard mapping—e.g. 3D depth-to-bedrock models inform tunnel and foundation design, risk assessment, and smart-city planning. Overall, this work demonstrates how integrating modern 3D DL into geospatial ground modeling can improve predictive accuracy relative to traditional ML, paving the way for advanced geotechnical decision support.}
}
@article{HOU2026115580,
title = {Reinforcement learning based multi-model predictive control for boiler-turbine coordinated system of USC unit under wide load conditions},
journal = {Applied Soft Computing},
volume = {201},
pages = {115580},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115580},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010288},
author = {Guolian Hou and Zeyu Liu and Xiangyu Du},
keywords = {Ultra-supercritical unit, Reinforcement learning, Multi-model predictive control, Sand cat swarm optimization, Fuzzy C-means clustering},
abstract = {With renewable energy being integrated into power grid on a large scale, the responsibility for load-frequency regulation increasingly falls upon coal-fired power unit, making their control optimization of growing critical importance. In this paper, a control framework driven by multi-model predictive control (MMPC) is developed to enhance the load regulation capability of ultra-supercritical (USC) unit, facilitating unit’s operation under varying conditions. In this framework, an improved fuzzy C-means (IFCM) clustering algorithm is used to construct the model set, and the enhanced sand cat swarm optimization (ESCSO) algorithm is proposed for the identification of model parameters. Subsequently, a reinforcement learning (RL) algorithm with self-learning capability is employed to dynamically weight and integrate the outputs of local controllers, thereby generating the final control command. This approach utilizes the continuous learning property of RL agent to adjust the control law in real time to match the load demand uncertainty and model mismatch, which effectively reduces the control variables fluctuation while enhancing the system stability. Simulation results show that compared with traditional independent MPC and MMPC methods, this method has significant advantages in disturbance suppression performance and load tracking capabilities. The RL-based MMPC provides fast and stable load tracking capability at a ramp rate of 4.48% Pe/min.}
}
@article{ZHANG2026115661,
title = {MTDL-BMG: Multi-task deep learning with branch-mutual guidance for unified butterfly natural image analysis},
journal = {Applied Soft Computing},
volume = {201},
pages = {115661},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115661},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011099},
author = {Kunkun Zhang and Ao Li and Jun Tang and Xin Chen and Bin Wang},
keywords = {Butterfly natural image, Image segmentation, Object recognition, Multi-task deep learning},
abstract = {Segmentation and classification of butterfly natural images are essential tasks in ecological research and biodiversity conservation. However, effectively leveraging the complementary information between these tasks within a unified model remains challenging. In this paper, we propose MTDL-BMG, a novel Multi-Task Deep Learning framework with Branch-Mutual Guidance to jointly perform segmentation and classification. The core of MTDL-BMG is a Branch-Mutual Guidance (BMG) block, designed to enhance inter-task interaction through two modules. The Semantic Guidance Module (SGM) uses semantic features from one task to guide feature selection and reorganization in the other, enabling mutual enhancement of latent representations. The Context Guidance Module (CGM) extracts high-level, multi-scale contextual features from the classification branch and integrates them into the segmentation branch to improve spatial understanding. Unlike prior multi-task models that treat branches independently, our approach encourages dynamic cross-branch learning. Extensive experiments on two public butterfly image datasets show that MTDL-BMG achieves superior classification performance and competitive segmentation performance, providing a favorable overall trade-off compared with representative single-task and multi-task baselines. These results validate the effectiveness of our unified architecture for butterfly image analysis and provide a promising direction for multi-task learning in ecological visual understanding.}
}
@article{ZHANG2026115576,
title = {Maximizing regenerative energy utilization of multi-train operation using an NSGA-II-based optimization framework},
journal = {Applied Soft Computing},
volume = {201},
pages = {115576},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115576},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010240},
author = {Zhenyu Zhang and Hui Zhao and Zongyi Xing and Xingdong Gui},
keywords = {Multi-train operation, Timetable optimization, Energy-efficient operation, Non-dominated sorting genetic algorithm II},
abstract = {Train operations account for approximately half of the total energy consumption in rail transit systems. Reducing traction energy consumption and enhancing the utilization efficiency of regenerative braking energy (RBE) are crucial for sustainable development. Multi-train timetable optimization offers an effective approach to maximize RBE utilization by increasing the overlap time between two trains within the same interval. Therefore, we propose the utilization of a non-dominated sorting genetic algorithm II (NSGA-II) to tackle the multi-train timetable optimization for energy-efficient operation. Initially, energy-saving optimization models for multi-train operations during different time periods are established to accommodate the distinct operating characteristics across various hours. Subsequently, the NSGA-II algorithm is employed to determine the optimal interval operation time and dwell time, thereby maximizing overlap time and enhancing RBE utilization efficiency. Finally, we apply this approach to Guangzhou Metro Line 7, demonstrating significant improvements in RBE utilization efficiency and overall energy consumption reduction. Additionally, compared to three other methods, our developed approach exhibits superior energy-saving performance.}
}
@article{GE2026115689,
title = {Optimization of heavy railway maintenance machinery tamping scheduling based on deep reinforcement learning},
journal = {Applied Soft Computing},
volume = {201},
pages = {115689},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115689},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011373},
author = {Hanzhang Ge and Jin Wang and Weidong Wang and Qasim Zaheer and Linyong Liao and Ying Sun and You Li and Shi Qiu},
keywords = {Ballasted track, Predictive maintenance, Tamping operation, Maintenance decision, Deep reinforcement learning},
abstract = {Efficient and cost-effective tamping scheduling is essential for condition-based maintenance of ballasted track. This study addresses the scheduling problem of heavy railway maintenance machinery (HRMM) under practical operational constraints. A constraint-aware deep reinforcement learning (DRL) framework is proposed to optimize tamping decisions by explicitly integrating track condition evolution and the spatiotemporal constraints of HRMM operations into a unified decision-making model. Specifically, the problem is formulated as a Markov decision process, where a single HRMM group is modeled as the agent and trained using the discrete Soft Actor-Critic (SAC) algorithm. A Gamma process is employed to characterize the deterioration of individual track units, and a state-dependent reward function is designed to jointly account for maintenance timeliness, operational effectiveness, and cost efficiency. The proposed method is validated through a case study on a real 50 km ballasted track section. The results show that the framework can generate feasible and efficient tamping schedules with favorable performance in terms of maintenance effectiveness, time cost, and economic cost. The proposed approach provides practical decision support for condition-based tamping scheduling of ballasted track.}
}
@article{ZENG2026115568,
title = {Momentum-constrained hybrid heuristic trajectory optimization framework with residual-enhanced DRL for visually impaired scenarios},
journal = {Applied Soft Computing},
volume = {201},
pages = {115568},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115568},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010161},
author = {Yuting Zeng and Zhiwen Zheng and Jingya Wang and You Zhou and JiaLing Xiao and Yongbin Yu and Manping Fan and Bo Gong and Liyong Ren},
keywords = {Momentum-constrained, Residual-enhanced network, Heuristic trajectory optimization, Deep reinforcement learning, Visually impaired},
abstract = {Safe and efficient assistive planning for visually impaired scenarios remains challenging, because existing deep reinforcement learning (DRL) methods often produce temporally inconsistent actions and oscillatory velocity or acceleration profiles, which undermine motion smoothness and user comfort. Specifically, current DRL methods exhibit limited temporal modeling capability, insufficient multi-objective balancing, and weak interpretability, making it difficult to generate smooth and user-centric trajectories. In response, this paper proposes a Momentum-Constrained Hybrid Heuristic Trajectory Optimization Framework (MHHTOF). To balance multiple objectives of comfort and safety, the framework designs a Heuristic Trajectory Sampling Cluster (HTSC) with a Momentum-Constrained Trajectory Optimization (MTO), which suppresses abrupt velocity and acceleration changes. In addition, a novel residual-enhanced DRL module refines candidate trajectories, advancing temporal modeling and policy generalization. Finally, a dual-stage cost modeling mechanism (DCMM) is introduced to regulate optimization, where costs in the Frenet space ensure consistency, and reward-driven adaptive weights in the Cartesian space integrate user preferences for interpretability and user-centric decision-making. Experimental results show statistically significant improvements in high-quality policy stability and trajectory smoothness, reflected by higher High-Quality Rate (HQR), Maximum Run Length (MRL) and reduced Jerk Cost (JC). In complex dynamic scenarios, MHHTOF further demonstrates stable velocity and acceleration curves with reduced risk, confirming its advantages in robustness, safety, and efficiency.}
}
@article{ZHU2026115628,
title = {Enhanced imbalanced fault diagnosis of rolling bearings via generative sample augmentation and multidomain feature fusion},
journal = {Applied Soft Computing},
volume = {201},
pages = {115628},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115628},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010768},
author = {Lin Zhu and Chuan Qian and Jin Wang and Lintong Liu and Min Chen},
keywords = {Class imbalance, Multi-domain feature fusion, Fault diagnosis, Sample generation, Rolling bearing},
abstract = {In the field of fault diagnosis, real-world data typically exhibit a long-tailed distribution, leading to severe class imbalance issues. Conventional approaches tend to rely heavily on majority classes (i.e., healthy samples) to construct decision boundaries, which significantly weakens the discriminative capability for minority fault classes. To address this challenge, this paper proposes a novel fault diagnosis framework that integrates sample generation and multi-domain feature fusion, specifically designed for imbalanced scenarios. First, a multi-domain feature set is constructed through feature quantification, incorporating time-domain, frequency-domain, and sparse-domain representations. Then, the distribution of minority class samples is reconstructed using the polar k-nearest neighbor (PKNN) algorithm and mega-trend diffusion (MTD), achieving data-level class balance. On this basis, a bidirectional dense feature fusion (BDFF) network is proposed, which combines the temporal modeling capability of BiLSTM with the hierarchical feature propagation mechanism of DenseNet, and further incorporates a channel attention module to enable deep interaction and fusion of multi-scale features, thereby significantly enhancing the discriminative power of feature representations. Experimental results demonstrate that, under severe class imbalance conditions, the proposed method achieves a 5.95% improvement in F1-score compared with conventional methods, exhibiting superior diagnostic performance. Statistical analyses further confirm the significance of these improvements. Moreover, experiments on an external bearing dataset verify the method’s effectiveness across different data sources. In addition, multi-condition and cross-condition experiments show that the proposed approach maintains stable diagnostic performance under distribution shifts, demonstrating strong generalization ability and robustness.}
}
@article{LV2026115620,
title = {Explicit transformation GAN: DWI synthesis from non-contrast CT for rapid diagnosis of acute ischemic stroke},
journal = {Applied Soft Computing},
volume = {201},
pages = {115620},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115620},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010689},
author = {Wenzhi Lv and Guiling Zhang and Jing Ding and Yan Fu and Bingfang Duan and Pengcheng Li and Wenzhen Zhu},
keywords = {Acute ischemic stroke, Non-contrast CT, Diffusion-weighted MRI, Cross-modality feature transformation},
abstract = {Non-contrast CT (NCCT) is the first-line imaging modality for evaluating acute ischemic stroke (AIS). Diffusion-weighted MRI (DWI) can reveal early ischemic changes that often remain subtle on NCCT within the treatment window. However, DWI suffers from longer scanning times, metal contraindications, and restricted availability, all of which may delay treatment. To bridge this gap, we propose an explicit transformation generative adversarial network (ETGAN) that synthesizes valuable DWI from NCCT scans. Our core innovation is an explicit semantic feature transformation that injects learned ischemic priors directly into the synthesis pipeline. Specifically, we introduce a Feature Transformation Module (FTM), pre-trained via cross-modal contrastive learning, to map NCCT features into an ischemia-aware pseudo-DWI feature space. By incorporating the pre-trained FTM, the generator explicitly transforms hierarchical NCCT features into pseudo-DWI features, which are aligned with real DWI through a dedicated feature loss. These prior-informed representations enable ETGAN to more accurately reconstruct early ischemic lesions in synthesized DWI. Additionally, an attention-enhanced discriminator focuses on ischemic regions and guides the generator to synthesize finer lesion details. Our proposed method was evaluated on public and in-house datasets, achieving high fidelity with SSIM scores of 0.946 and 0.905, respectively. Extensive experiments showed that ETGAN outperformed existing methods in both visual quality and quantitative metrics. Crucially, the synthesized DWI significantly improved neuroradiologists’ diagnostic accuracy in identifying AIS from NCCT alone (p<0.001). Our model offers a promising solution for rapid and accurate AIS assessment when MRI is inaccessible or delayed.}
}
@article{LU2026115604,
title = {Robust multi-view subspace clustering method for recognizing mixed urban functions from remote and social sensing data},
journal = {Applied Soft Computing},
volume = {201},
pages = {115604},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115604},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010525},
author = {Zexin Lu and Qiliang Liu and Meihua Chen and Yuqian Huang and Yueda Wu and Xiaoran Zhou and Min Deng and Zhengyang Zhou},
keywords = {Data fusion, Multi-view learning, Subspace clustering, Noise modeling, Signal-to-noise ratio, Remote and social sensing data, Mixed urban function},
abstract = {Multi-view subspace clustering is a powerful approach for leveraging complementary information from remote and social sensing data. It enables comprehensive identification of urban functional zones. However, data from different sources often contain noise and may introduce noise during fusion, which can significantly degrade the performance of multi-view subspace clustering. To address this issue, this study proposes a Robust Multi-view Subspace Clustering method (RMSC) to fuse multi-source remote and social sensing data. RMSC explicitly models two types of noise: (i) intra-view noise, representing aleatoric errors within a single view, and (ii) cross-view noise, reflecting inconsistencies among different views. To mitigate the impact of noise on multi-view subspace clustering, we design a noise-aware autoencoder network to obtain a robust and consistent subspace representation. First, the weight of each sample (i.e., block) is adaptively calculated based on the signal-to-noise ratio. Second, inconsistent information is removed during the self-representation process. Experimental results from the Beijing case study show that RMSC improves the L1, Chebyshev, and Cosine metrics by at least 8%, 4%, and 3%, respectively, compared with thirteen state-of-the-art baseline methods. The effectiveness of the noise-aware autoencoder network is further validated through ablation and noise-robustness experiments. The mixed urban functional zones identified by RMSC can support government agencies in making informed decisions and implementing urban planning strategies.}
}
@article{ABBASPOUR2026115624,
title = {A fusion-centric multi-stage ensemble approach for large-scale evaluation of renewable solar-powered water treatment system},
journal = {Applied Soft Computing},
volume = {201},
pages = {115624},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115624},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010720},
author = {Mohammadreza Abbaspour and Bilal Bahaa and Nahia Mourad and Sarah Qahtan and Aws Alaa Zaidan and Hassan A. Ibrahim and Ibrahim Alshakhatreh and Bassam Abu-Hijleh},
keywords = {Ensemble MCDM, Fusion-Based Decision Making, Generative AI (AHP-GenAI), TOPSIS Variants, Half-Quadratic Programming (HQP)},
abstract = {Solar still systems provide a sustainable solution for brine treatment; however, existing evaluation approaches remain limited by fragmented methodologies, reliance on single multi-criteria decision-making (MCDM) techniques, sensitivity to normalization and weighting strategies, and strong dependence on expert judgment. These limitations lead to ranking instability, reduced scalability, and inconsistent outcomes, particularly in large-scale evaluation contexts. To address these gaps, this study proposes a fusion-centric multi-stage ensemble approach for large-scale evaluation of renewable solar-powered water treatment systems. The methodology is structured as a two-tier hierarchical procedure. In Tier 1, entropy-based objective weighting is applied to generate multiple ranking outputs using diverse TOPSIS variants across different normalization schemes, distance measures, and threshold settings. These outputs are aggregated using a Half-Quadratic Programming (HQP) fusion model, followed by correlation-based filtering to retain consistent ranking models. In Tier 2, subjective preferences are incorporated through a Generative AI-assisted Analytic Hierarchy Process (AHP-GenAI), and the shortlisted models are fused via a two-level hierarchical HQP ensemble process to derive a final consensus ranking. The proposed approach is validated using 21 solar still configurations evaluated across six criteria. Results demonstrate high consistency and robustness, confirming the effectiveness of the methodology in mitigating bias, enhancing scalability, and improving decision reliability.}
}
@article{ALDAHMANI2026115564,
title = {A run length weighted mean difference approach for enhanced feature selection},
journal = {Applied Soft Computing},
volume = {201},
pages = {115564},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115564},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010124},
author = {Saeed Aldahmani and Amjad Ali and Zardad Khan},
keywords = {Biomedical classification, High-dimensionality, Feature selection, Filter method, Run length structure},
abstract = {High-dimensional biomedical datasets often contain many noisy and redundant features, which reduce classification accuracy and interpretability. This paper proposes a new filter based feature selection method called run length weighted mean difference (RLWMD). For each feature, samples are ordered by their values and the class labels in this order are decomposed into contiguous runs. Local means are computed within the runs and combined into run weighted class means, where long homogeneous runs have higher influence than short runs. A purity factor based on the number of class transitions/boundaries in the ordered sequence penalises features that produce unstable label patterns. The final RLWMD score favours features that show both strong and stable separation between classes. The method is evaluated on five benchmark gene expression datasets using random forest, k nearest neighbours and support vector machines over multiple subsets of top-ranked features and 500 repeated stratified train/test splits. In most configurations, RLWMD achieves lower classification error and higher Cohen’s kappa than Fisher score, signal-to-noise ratio, Wilcoxon ranking, proportional overlapping score, maximum relevance minimum redundancy and effective range-based feature selection algorithm, while remaining simple and computationally efficient.}
}
@article{QUAN2026115616,
title = {Wind power interval forecasting via a transfer learning-based two-stage method with multi-objective optimization},
journal = {Applied Soft Computing},
volume = {201},
pages = {115616},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115616},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010641},
author = {Hao Quan and Yuan Meng},
keywords = {Transfer learning, Two-stage optimization, Multi-objective optimization, Wind power interval prediction, Neural network},
abstract = {Currently, interval prediction models based on the lower and upper bound estimation (LUBE) method are widely used. However, the existing LUBE models face two main issues. First, they rely on heuristic algorithms for optimization, which incurs high computational costs, especially with complex neural network structures. Second, extensive loss function and hyperparameter tuning are needed under single-objective optimization conditions. This paper proposes a novel transfer learning-based LUBE (TL-LUBE) method to derive prediction intervals (PIs) within a multi-objective two-stage optimization framework. Unlike traditional LUBE models, TL-LUBE adopts the gradient descent (GD) approach for point prediction in the first stage. The trained parameters are then transferred to the interval prediction model. In the second stage, an improved multi-objective optimization algorithm is performed to optimize the final model, aiming to achieve high-quality PIs. The traditional multi-objective competitive swarm optimization (MOCSO) algorithm is enhanced by integrating the reference vector guided evolutionary algorithm (RVEA) strategy and shift-based density estimation (SDE), which together effectively balance swarm diversity and convergence. Experiments on wind power datasets from four seasons show that the proposed model achieves narrower PIs while maintaining similar coverage probability compared to existing models.}
}
@article{KALAMPAKAS2026115567,
title = {Quotient-based structural abstraction in fuzzy trust networks via strong path hyperoperations},
journal = {Applied Soft Computing},
volume = {201},
pages = {115567},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115567},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601015X},
author = {Antonios Kalampakas},
keywords = {Fuzzy graph, Hyperoperation, Strong path, Quotient network, Trust network, Structural abstraction},
abstract = {Directed fuzzy networks arise in trust-driven settings where interactions are asymmetric, uncertain, and weighted by graded evidence. Analyzing large fuzzy networks directly is challenging because trust propagation follows multi-step weighted paths and structural patterns often remain hidden at the vertex level. We develop a quotient-based abstraction framework that combines a strongest path fuzzy hyperoperation with a tunable equivalence relation, producing compressed representations that are consistent with directional fuzzy widest-path semantics without implying path-level equivalence. The induced quotient graph supports two interpretable role indices—reachability impact, capturing how far a class can propagate trust, and relay score, measuring how often it mediates trusted communication. Applying the framework to a Facebook-like message-exchange network uncovers influential initiators and structural mediators that standard centrality and community methods fail to detect. The approach enables trust-aware structure compression, macro-level role identification, and scalable analysis of large directed fuzzy networks.}
}
@article{CHEN2026115588,
title = {Physics-guided LSTM-KAN modelling for shield tunnelling parameter prediction and optimization},
journal = {Applied Soft Computing},
volume = {201},
pages = {115588},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115588},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010367},
author = {Yangyang Chen and Wen Liu and Zhihua Wang and Elton J. Chen and Demi Ai and Hongping Zhu and Yanliang Du},
keywords = {Physics-guided neural networks, Adaptive weight assignment strategy, LSTM-KAN, Shield construction parameters, Multi-objective optimisation},
abstract = {Recent data-driven approaches facilitate the intelligent and accurate prediction of shield construction parameters and tunnelling energy consumption under complex conditions when evaluating excavation efficiency and optimising shield machine operations. However, traditional data-driven models often lack physical interpretability, while physics-based models face challenges due to inaccurate physical representations. To address this problem, this study proposes a physics-guided neural networks (PGNNs) for constructing robust data-driven models with embedded physical information (PI), improving physical interpretability while controlling the adverse effects of inaccurate PI. The proposed framework integrates PI into a Long Short-Term Memory-Kolmogorov-Arnold Network architecture and incorporates an adaptive weight assignment strategy (AWAS) to balance the contributions of data and physics-based constraints. Two independent PGNNs are used to predict thrust force (TF) and cutterhead torque (CT), and AWAS adjusts the relative contributions of data and physics terms during training; an analytical method then calculates specific energy (SE) based on the TF and CT predictions. Validation tests using real-world monitoring data demonstrated that the proposed method achieves high prediction accuracy, with typical performance of TF (R² = 0.9690, RMSE = 3.27 ×10 ³ kN), CT (R² = 0.9480, RMSE = 0.76 ×10 ³ kN·m), and SE (R² = 0.9388, RMSE = 6.12 MJ/m³). A comparative analysis of nine models highlights the advantages of integrating PI and AWAS, demonstrating that accurate PI enhances predictions, while AWAS mitigates the impact of inaccurate PI. Furthermore, the proposed multi-objective optimisation framework improves operational decision-making by balancing energy consumption, efficiency, and environmental disturbance; after optimisation, SE is reduced by 51.95%, advance speed (AS) is increased by 15.99%, and ground settlement (GS) is reduced by 14.54%. Sensitivity analysis using the Polynomial Chaos Expansion-Sobol method identifies key controllable factors influencing SE, AS, and GS, revealing that their relative importance varies across geological conditions. These results demonstrate the potential of the proposed PGNNs to improve the accuracy, robustness, and efficiency of shield tunnelling predictions, offering a reliable tool for optimising operations and addressing challenges associated with complex geological environments.}
}
@article{LI2026115640,
title = {Wasserstein generative adversarial networks with knowledge self-distillation for rolling bearing fault diagnosis under imbalanced data},
journal = {Applied Soft Computing},
volume = {201},
pages = {115640},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115640},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010884},
author = {Jimeng Li and Huixin Zhang and Jie Gao and Qixian Huang and Zong Meng},
keywords = {Fault diagnosis of rolling bearings, Generative adversarial networks, Knowledge self-distillation, Imbalanced data},
abstract = {In actual industrial scenarios, rolling bearings are mainly operated for a long time in a healthy state, which leads to serious category imbalance phenomenon in collected vibration data. When faced with imbalanced data, generative adversarial networks (GANs), which can generate data and augment samples, offer valuable tools for intelligent fault diagnosis. However, most GAN-based methods tend to improve the model performance by designing relatively complex network structures. This paper integrates knowledge distillation into GANs and proposes a Wasserstein GAN model with knowledge self-distillation (KsD-WGAN) for detecting bearing faults with imbalanced data. First, a gating mechanism is introduced to optimize the generator network structure so that it can flexibly adjust the generated samples' global structure and local details according to input data. Second, a knowledge self-distillation learning strategy is designed to leverage the high-level features learned by the generator to guide and supervise shallow feature learning. A self-distillation loss function, consisting of a maximum mean discrepancy and a correlation metric, is constructed to strengthen the model's ability to learn and capture important features. Finally, a comprehensive loss function consisting of knowledge self-distillation loss and discrimination loss is designed to train the constructed model, boosting the stability of the model and the quality of the generated sample. The paper adopts two sets of rolling bearing datasets to analyze the presented method. The analysis results reveal that, compared to other current approaches, the presented method can attain higher diagnostic accuracy under varied imbalance ratios, demonstrating its usability and superiority.}
}
@article{LI2026115623,
title = {Deep reinforcement learning for capacitated vehicle routing with time windows: Leveraging multi-dimensional feature fusion and a gated selection mechanism},
journal = {Applied Soft Computing},
volume = {201},
pages = {115623},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115623},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010719},
author = {Yong Li and Linfeng Zhu and Shuaiyong Li and Hui Tian},
keywords = {Vehicle routing problem, Deep reinforcement learning, Multi-dimensional feature fusion, Gated selection mechanism},
abstract = {The capacitated vehicle routing problem with time windows is a central challenge in contemporary supply-chain operations. Because the problem is NP-hard, conventional heuristics and metaheuristics require substantial computation time, which precludes high-frequency, real-time decision-making. Although recent advances in deep reinforcement learning (DRL) are promising, existing DRL methods continue to struggle to balance solution quality and latency owing to challenges in modeling complex dependencies, adapting policies on-the-fly, and maintaining robustness to unforeseen disruptions. To bridge these gaps, we propose a novel DRL framework that integrates multi-dimensional feature fusion with a gated selection mechanism. A dedicated feature fusion network captures intricate dependencies among nodes and constraints. Subsequently, a gated decoder generates high-quality, context-aware states that facilitate adaptive decision-making. The policy-value network is trained jointly via proximal policy optimization; the policy network selects actions, whereas the value network evaluates global states to guide learning updates. We perform large-scale experiments on synthetic datasets, the public Solomon and LaDe benchmarks, and a real-world distribution scenario in Chongqing, China. The results indicate that our approach achieves inference in milliseconds and consistently yields higher-quality solutions than other state-of-the-art algorithms. It also remains stable under peak-hour congestion, order cancellations and additions, rush requests, and demand fluctuations, thereby demonstrating strong robustness and practical reliability.}
}
@article{SUN2026115646,
title = {A hybrid learning offer-generating strategy model in emotion-aware agent-based automated negotiation with deception},
journal = {Applied Soft Computing},
volume = {201},
pages = {115646},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115646},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601094X},
author = {Yi Sun and Jinghua Wu},
keywords = {Agent-based automated negotiation, Emotion modeling, Emotional deception, Reinforcement learning, Strategy optimization},
abstract = {Agent-based automated negotiation is increasingly attracting the attention of researchers in online transactions. However, achieving an agent with multiple anthropomorphic characteristics that can make dynamic collaborative negotiation and human-like decision-making remains challenging. This paper proposes a model that simulates essential elements of human-led negotiation: emotion, strategy, and learning, to achieve multi-attribute-multi-round bilateral negotiation. A two-dimensional emotion model based on valence and arousal is proposed to quantify emotional polarity and emotional intensity, and describe emotion generation and dynamics in automated negotiation. Then, emotion is used to drive strategy update and adjustment. An emotion-based hybrid learning offer-generating strategy mechanism is proposed by integrating emotion, deception, time-dependent strategy, Bayesian learning, and reinforcement learning to maximize negotiation utility. After that, a series of simulation experiments are conducted in coal supply chain procurement and sales negotiations to verify the advantages of the proposed model, including comparative experiments with four baseline models, ablation studies, sensitivity analyses, and statistical tests. The results imply that the proposed model can effectively improve negotiation performance, fairness, and welfare in widely used negotiation scenarios.}
}
@article{RANPARA2026115712,
title = {Dynamic hierarchical spiking neural networks for scalable anomaly detection in evolving network traffic},
journal = {Applied Soft Computing},
volume = {201},
pages = {115712},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115712},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011609},
author = {Ripal Ranpara and Abdullah Baz and Shobhit K. Patel},
keywords = {Spiking neural networks, Anomaly detection in networks, Dynamic traffic analysis, Scalable machine learning, Cybersecurity threats, Advanced persistent threats},
abstract = {Anomaly detection in traffic of networks is an essential aspect of the modern communication systems that enhances security, performance, and reliability of the systems. Alternatively, classical detection methods suffer from an issue related to scaling and adapting to the changing environment, especially with large-scale traffic and increasingly shifting attack patterns. This paper proposes a revolutionary dynamic hierarchical spiking neural networks framework that can efficiently support scalable anomaly detection on evolving network traffic streams in real-time. The DHSNN incorporates the temporal sensitivity and hierarchical processing of spiking neural networks with novel algorithms and mathematical formulations to detect a wide range of advanced threats, such as Advanced Persistent Threats (APTs), botnet-based DDoS attacks, zero-day exploits, and cloud-based attacks. The proposed framework demonstrated an improved accuracy of 28% in anomaly detection using the CICIDS 2021 dataset. The dataset has the more latest kinds of attack scenarios like IoT botnet, DNS amplification, ransomware, sophisticated malware, etc. using extensive experimentation with it. Also, the false positive rate was decreased by 32% and the computational complexity decreased by 40%, showing the fact that the framework can scale to handle large traffic. DHSNN framework showed tremendous flexibility in detecting zero-day exploits and hybrid attacks comprising a mix of vectors. The findings illustrated with the Numerical analysis reveal that the proposed DHSNN model is capable of an enhanced detection performance with robust scalability and adaptation to real-life dynamic network environments. This paper is a remarkable achievement in the area of anomaly detection as it provides a solution to the advanced cybersecurity threat which is growing rapidly in danger especially in teh IoT networks, cloud networks and new 5 g network traffic. Network traffic anomaly detection is an integral part of modern communication systems which improves the systems’ security, performance, and reliability. In contrast, classical detection methods present challenges related to scale and how changes are accommodated, especially when they have traffic in large quantities and the patterns of attack change often. A novel framework based on Dynamic Hierarchical Spiking Neural Networks is thus proposed, which overcomes the aforementioned shortcomings and enables scalable real-time anomaly detection for evolving network traffic streams. The DHSNN system actively incorporates algorithms and mathematics. The system combines the temporal and hierarchical features of SNNs. Moreover, the system can effectively detect Advanced Persistent Threats, botnet-based DDoS, zero-day exploits, and cloud-based attacks. The proposed framework showed a 28% improvement in anomaly detection accuracy over state-of-the-art models such as Random Forest and Deep Neural Networks (DNNs) through extensive experimentation using the CICIDS 2021 dataset with modern attack scenarios such as IoT botnets, DNS amplification, ransomware, and advanced malware. Moreover, the rate for false positives was decreased by 32% and computational complexity by 40% showing the scalability of the framework for large traffic volumes. The DHSNN framework was noteworthy for its ability to detect zero-day exploits and hybrid attacks. The experimental findings suggest that the proposed DHSNN model performs better in detection and exhibits significant scalability and adaptability in real-world scenarios. The researchers claim that their work is a major step forward in node anomaly detection that could help address the growing challenges of sophisticated cybersecurity threats, especially in IoT networks, cloud spaces and emerging 5 G network traffic.}
}
@article{HAN2026115643,
title = {Adaptive physics-informed dual-residual diffusion for all-weather visualized outdoor solid waste management},
journal = {Applied Soft Computing},
volume = {201},
pages = {115643},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115643},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010914},
author = {Honggui Han and Xing Wang and Lei Tong and Xiaolong Wu},
keywords = {Image restoration, Diffusion models, Solid waste images, All-weather degradation, Solid waste management},
abstract = {Effective management of solid waste is crucial for sustainable urban environmental governance. Computer vision has been extensively deployed throughout all stages of solid waste treatment. However, outdoor visual sensing systems are inevitably affected by various adverse weather conditions. Thus, developing all-weather restoration algorithms is essential for providing stable and high-quality data for downstream visual tasks. Nevertheless, existing restoration approaches often yield overly smooth material cues or hallucinate textures across different conditions, thereby weakening downstream recognition quality. To address these limitations, this paper proposes a novel Dual-Residual Diffusion-based all-weather image restoration algorithm (DuRDiff) for enhanced and reliable outdoor solid waste visual applications. First, a Physics-informed Decomposition Module (PDM) is designed to extract degradation priors by decomposing multiple weather effects into unified representations that couple high-frequency artifacts with low-frequency atmospheric components. Second, guided by these priors, a Physics-informed Degradation Diffusion (PDD) is proposed to direct the restoration process via parallel prediction of physical degradation residuals and stochastic noise residuals. Third, an Adaptive Timestep Aligner (ATA) is introduced to learn aligned conditioning timesteps for accelerated sampling, thereby reducing discretization error and preserving restoration fidelity under significantly reduced inference steps. Experiments on TacoRain, SWADsnow, and KITTI-fog show that DuRDiff achieves 22.360/0.7109, 25.600/0.7505, and 31.042/0.9692 in PSNR/SSIM, respectively. Additional experiments on Rainstreak and Raindrop further verify its robustness under different rain morphologies. Beyond restoration quality, DuRDiff also improves downstream perception performance, increasing mAP@0.5:0.95 from 29.84% to 43.74% on SWADsnow and from 36.70% to 63.55% on Rainstreak.}
}
@article{WANG2026115540,
title = {Enhanced labor division in artificial bee colony algorithm with application to esophageal cancer risk prediction},
journal = {Applied Soft Computing},
volume = {201},
pages = {115540},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115540},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009889},
author = {Yingcong Wang and Zhikang Hu and Bo Li and Yanfeng Wang},
keywords = {Artificial bee colony algorithm, Labor division, Exploration and exploitation, Esophageal cancer risk prediction},
abstract = {Artificial Bee Colony (ABC) algorithm is a swarm intelligence optimizer using three bee types to collaboratively find optimal solutions. However, the division of labor among bees in the optimization process is somewhat inefficient. Many studies enhance ABC’s performance by addressing the challenge of strong exploration and weak exploitation. To overcome this limitation, exploration and exploitation are treated as distinct tasks in this study, and a stimulus-response labor division mechanism from swarm intelligence is introduced to dynamically regulate the exploration-exploitation balance in ABC. Consequently, an improved ABC with enhanced labor division (ELDABC) is proposed. In ELDABC, solution search equations biased toward exploration and exploitation are crafted with the aid of multi-information guidance. Dimension entropy-based diversity is employed to assess the environmental stimulus of a search task, which reflects its urgency level. Search efficiency based on the rate of change in solutions is utilized to measure a bee’s response threshold, indicating its inclination toward the search task. Under the stimulus-response labor division mechanism, bees flexibly adjust the intensity of exploration and exploitation, thereby reaching a well-balanced state that enhances algorithm performance. The performance of ELDABC is rigorously evaluated on two benchmark suites (comprising 22 traditional functions and the CEC2013 testbed). Comparative studies against 16 state-of-the-art metaheuristics, including eight improved ABC variants, four PSO variants, and four DE variants, demonstrate its superior convergence accuracy and speed, with statistical tests further confirming these results. For practical validation, ELDABC is applied to optimize the parameters of a BP neural network for esophageal cancer risk prediction. Using a clinically curated dataset of 120 subjects, the ELDABC-optimized model achieves superior predictive performance in accuracy, sensitivity, specificity, and F1-score over competing methods.}
}
@article{LIU2026115560,
title = {Enhanced depth estimation for underwater monocular images via intrinsic scale invariance and skip expanded context fusion},
journal = {Applied Soft Computing},
volume = {201},
pages = {115560},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115560},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010082},
author = {Dingshuo Liu and Yiran Liu and Beibei Li and Qingling Duan},
keywords = {Underwater images, Underwater monocular depth estimation, Vision transformer, Self-attention mechanism},
abstract = {Depth information from underwater monocular images is vital for underwater computer vision tasks, driving remarkable advancements in underwater resource management and environmental perception technologies. Compared to terrestrial scenes, underwater monocular depth estimation faces unique challenges, such as difficulty in handling different scales due to refraction, reduced image contrast, and exposure or dim lighting issues. To address these challenges, this paper proposes a novel underwater monocular depth estimation method based on intrinsic scale invariance and skip expanded context fusion. First, the proposed method employs an encoder based on an improved Vision Transformer (ViT) with intrinsic scale invariance, enabling the model to handle objects of varying scales. Then, in the decoding phase, a local planar guidance layer is introduced to reconstruct local features, enhancing the model’s ability to handle local details under low contrast conditions. Finally, a skip multi-scale expanded self-attention mechanism is proposed, which adaptively adjusts the weights of different scale semantic information within the receptive field between the encoder and decoder. This facilitates the fusion of multi-scale context information and gradually restores features to full resolution, meeting the depth map generation requirements under various lighting conditions. Experiments conducted on the public underwater dataset FLSea show that the proposed method achieves an AbsRel of 0.092, outperforming methods such as BTS, Adabins, GLPDepth, and LapDepth by 28.1%, 52.6%, 70.1%, and 88.2% respectively. The results demonstrate that the proposed method effectively handles objects of different scales and addresses issues of low contrast, lighting variations in underwater environments, and generalization ability on the Sea-thru dataset, leading to more accurate depth estimation.}
}
@article{LIU2026115579,
title = {A novel cascade effect integrated graph convolutional network for reliable collaboration optimization of manufacturing service towards mass personalized PCB production},
journal = {Applied Soft Computing},
volume = {201},
pages = {115579},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115579},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010276},
author = {Zhengchao Liu and Zhihao Zeng and Hongtao Tang and Lei Wang and Chunrong Pan and Junjie Chen and Yongjun Cheng},
keywords = {Manufacturing service collaboration, Cascade effect, Graph convolutional network, Mass personalized production, Printed circuit board},
abstract = {In the increasingly fierce market competition, the demand for mass personalized production in the printed circuit board (PCB) manufacturing industry is rapidly increasing. To address these needs, enterprises integrate and package workshop manufacturing resources into manufacturing services, and carry out a series of operations, such as matching, optimization, combination, and scheduling, to complete related tasks. However, with the exponential growth of personalized customer orders, manufacturing services must undergo frequent restructuring to generate new solutions to complete the tasks. A lack of effective collaboration between services can lead to poor task-service alignment, ultimately compromising PCB quality and failing to meet customer expectations. Therefore, this article proposes a reliable collaborative optimization method for manufacturing services based on a cascade effect integrated graph convolutional network (CGCN), which considers the dynamic changes of PCB workshop resources and solves the problem of manufacturing service collaboration. Firstly, a manufacturing service collaboration network (MSC-Net) was constructed to characterize the physical properties of workshop production. Then, the graph data on MSC-Net are used to quantify the dynamic changes in service collaboration. Finally, the global embedding features of MSC-Net are processed through CGCN, and regression prediction is performed to optimize the service collaboration. The experimental results show that, taking the production process of PCB as an example, the performance of CGCN is superior to other typical algorithms.}
}
@article{SHEN2026115631,
title = {Spatio-temporal aware and context contrastive transformer for capacitive touch representation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115631},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115631},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010793},
author = {Zhihao Shen and Yinghao Ma and Cong Zou and Chengmei Zhao},
keywords = {Touchscreen, Behavioral biometrics, Mobile security},
abstract = {Accurately representing capacitive touch interactions is crucial for smartphone privacy protection. While existing approaches treat each touch gesture as a sequence of touch images and utilize 3D-CNNs for representation, they still face challenges such as limited spatial perception, insufficient dynamic modeling, and inadequate semantic adaptability. In this paper, we propose STTouchFormer, a spatio-temporal aware and context contrastive transformer for capacitive touch representation, designed to progressively extract multi-hierarchy features across spatial precision, temporal dynamics, and semantic context. Specifically, STTouchFormer first employs a spatio-temporal-aware Transformer, which encodes the appearance and absolute positions of fingertip contacts within each touch image, as well as the spatial intervals between consecutive touch images, thereby enhancing the model’s ability to represent the temporal evolution of touch interactions. To enhance its adaptability across different App contexts, STTouchFormer further integrates App context through a contrastive learning framework. To validate its effectiveness, we collect capacitive touchscreen data in real-world settings and demonstrate that STTouchFormer achieves 5.9% and 5.7% improvements in user identification accuracy and F1-score, respectively, and reduces authentication EER by 3.1% over baseline methods, establishing state-of-the-art performance in both user identification and authentication tasks.}
}
@article{BHANDARI2026115563,
title = {Simulation-based transient prediction and cost optimization in multi-server queueing systems using a hybrid autoregressive neural model},
journal = {Applied Soft Computing},
volume = {201},
pages = {115563},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115563},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010112},
author = {Sahil Singh Bhandari and T.G. Deepak},
keywords = {G(t)/G/c, Transient distribution prediction, Hybrid autoregressive model, Data-efficient learning, Cost optimization},
abstract = {This work presents a simulation-based comparative study of neural models for transient probability prediction in a time-dependent G(t)/G/c queue, motivated by hospital outpatient department (OPD) operations where reducing patient waiting time is critical. Four learning approaches are evaluated under identical conditions: the Moment-Based Recurrent Neural Network (MBRNN) of Sherzer et al., Long Short-Term Memory (LSTM), Temporal Convolutional Networks (TCN), and a proposed Hybrid Autoregressive model that explicitly conditions on the previous transient state distribution. The system is initialized in a non-empty state at t=0 to capture realistic early-morning congestion effects. Results show that while MBRNN, LSTM, and TCN exhibit performance degradation over long prediction horizons, the Hybrid Autoregressive model maintains stable distribution-level accuracy across multiple server configurations. In particular, it achieves consistently higher R2 values, lower probability errors, and improved accuracy in derived operational metrics such as expected queue length and overload probabilities. Importantly, the proposed model demonstrates strong performance even under limited training data, making it suitable for real-world settings where large datasets are not readily available. Using the transient distributions obtained from simulation, we further formulate pre- and post-closing cost optimization models and conduct sensitivity analyses that yield interpretable and robust staffing recommendations. Overall, the results demonstrate that explicit autoregressive modeling of transient dynamics provides a stable and data-efficient alternative to implicit sequence learning for time-varying multi-server queueing systems.}
}
@article{YUAN2026115529,
title = {Precise end-to-end segmentation of intracranial atherosclerotic plaques via detection guidance and parameter-efficient adaptation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115529},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115529},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009774},
author = {Jianye Yuan and Lingjun Mei and Yuxuan Sun and Yutong Guo and Bin Liu},
keywords = {Intracranial atherosclerosis, Medical image segmentation, Foundation model, End-to-end collaborative segmentation},
abstract = {Accurately identifying intracranial arteriosclerosis (ICAD) is vital for preventing ischemic stroke. Moreover, the increasing incidence of this disease in younger populations poses a significant threat to public health. Therefore, we propose CGF-ICADSNet, an end-to-end segmentation framework for ICAD plaques. The framework employs a multi-scale cascaded attention-driven detection module for accurate localization of small, low-contrast plaques, and a guided U-Net style, LoRA-adapted segmentation module to ensure high-fidelity reconstruction of irregular plaque boundaries. A geometry-aware composite loss function explicitly enhances the topological integrity and edge smoothness of the segmentation results. We trained and validated the network on a dataset containing 1015 precisely labeled black-blood MRI images for ICAD. Results show that CGF-ICADSNet achieves a Dice coefficient of 0.9520 and an IoU of 0.9132. It outperforms existing methods in both accuracy and robustness. This framework reduces the need for manual delineation by physicians and provides an efficient solution for the automated quantitative analysis of ICAD plaques. Furthermore, it demonstrates significant application potential in improving the reliability of stroke prevention strategies and prognostic monitoring. The code will be available at: https://github.com/snowdream12138/CGF-ICADSNet.}
}
@article{KONG2026115408,
title = {Machine learning driven robot control: A review},
journal = {Applied Soft Computing},
volume = {201},
pages = {115408},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115408},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008562},
author = {Junjun Kong and Xiaobo Zou and Xiaowei Huang and Xin Zhou and Xiangyu Hu and Zhihua Li},
keywords = {Robot control, AI, Reinforcement learning, Industry applications, Machine learning},
abstract = {In recent years, the integration of artificial intelligence (AI) into robot control has accelerated the transformation of traditional automation systems. This article comprehensively reviews the application of machine learning (ML) in the field of robot control from 2020 to 2025, with a focus on the relevant algorithms of the supervised learning (SL), unsupervised learning (UL) and reinforcement learning (RL) paradigms and their applications in four industries. Supervised learning, particularly via hybrid architectures, has enhanced tactile perception and obstacle avoidance. It has achieved sub-millimeter precision in medical surgery and 99% accuracy in industrial inspection. UL improves environment modeling through self-organizing networks, benefiting applications like agricultural drone-based pest detection (95% accuracy) and dynamic SLAM. Reinforcement learning, aided by hierarchical strategies, has optimized multi-robot collaboration (increasing task allocation efficiency by 28%) and complex motion control (success rates by 47.6%). Industry applications in healthcare, logistics, agriculture, and manufacturing demonstrate these algorithms’ effectiveness in closing the perception-decision-execution loop. However, challenges remain, including data dependency, limited generalization, and safety concerns. Future research should focus on self-supervised learning, neural-symbolic computing, and federated edge computing to create more adaptive, interpretable, and trustworthy robotic systems. Abstract text.}
}
@article{WANG2026115591,
title = {A dual-population knowledge transfer framework with adaptive operator selection for constrained multi-objective optimization},
journal = {Applied Soft Computing},
volume = {201},
pages = {115591},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115591},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010392},
author = {Qiuzhen Wang and Wei Yan and Kewen Wang and Yanhong Li and Juan Zou},
keywords = {Constrained multi-objective optimization, Dual-population, Dynamic knowledge transfer, Adaptive operator selection},
abstract = {Constrained multi-objective optimization problems (CMOPs) require evolutionary algorithms to balance convergence, diversity, and feasibility under complex constraints. To enhance adaptivity and cross-population knowledge utilization in dual-population optimization, this paper proposes a dual-population constrained multi-objective optimization framework, termed DPCMO. The proposed framework contains two coupled mechanisms: an adaptive operator selection strategy and a dynamic knowledge transfer strategy. The former switches between genetic algorithm (GA) and differential evolution (DE) operators based on the normalized Hausdorff distance (nhd) between the constrained and unconstrained populations, while the latter evaluates the relative effectiveness of parent and offspring solutions to determine the type and intensity of inter-population transfer. DPCMO maintains two interacting populations, one for the original CMOP and the other for its unconstrained counterpart. In the early stage, the two populations evolve independently while sharing offspring to enhance diversity. In the later stage, adaptive operator selection and dynamic knowledge transfer are jointly performed to coordinate exploration, exploitation, and inter-population cooperation. Extensive experiments on four benchmark suites, including LIRCMOP, C-DTLZ, CTP, and MW, as well as 20 real-world CMOPs, demonstrate the competitiveness of DPCMO. The proposed method achieves the best IGD/HV results on 9/9 MW problems, 10/10 LIRCMOP problems, and 6/5 CTP problems, confirming its advantages in convergence, diversity, and robustness on complex CMOPs.}
}
@article{LI2026115635,
title = {RIFL-Net: A Retinex-guided illumination-invariant feature learning network for nighttime pedestrian detection},
journal = {Applied Soft Computing},
volume = {201},
pages = {115635},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115635},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010835},
author = {Jun Li and Huajian Cai and Qiming Li},
keywords = {Nighttime pedestrian detection, Retinex theory, Feature fusion, Illumination-invariant, Pedestrian representation},
abstract = {Pedestrian detection plays a vital role in autonomous driving and intelligent surveillance systems. However, traditional pedestrian detection methods suffer from significant performance degradation in nighttime scenes due to challenging factors such as low illumination, poor contrast, and non-uniform lighting distributions. This paper presents an innovative nighttime pedestrian detection method by integrating traditional Retinex image enhancement theory with deep learning-based detection networks to achieve illumination-invariant pedestrian feature representation. Specifically, we design a Light Decomposition Module (LD-Module) that decomposes input nighttime images into reflectance and illumination components. By eliminating the illumination component, we extract intrinsic pedestrian features that remain robust against lighting variations, effectively mitigating the adverse impact of illumination on nighttime pedestrian detection. Additionally, we introduce a Context-aware Pedestrian-Background Attention (CPBA) mechanism featuring a novel triple-branch architecture that efficiently captures contextual information across both spatial and channel dimensions, while adaptively fusing illumination-invariant reflectance features with semantic features. This mechanism establishes comprehensive global relationships between pedestrians and their nighttime background, enhancing discriminative capability while suppressing background noise interference. Extensive experimental results demonstrate the effectiveness of our proposed RIFL-Net, which achieves a remarkable MR−2 of 6.10% on the NightOwls Reasonable subset, significantly outperforming state-of-the-art methods. The proposed network demonstrates strong robustness against diverse lighting variations, offering a highly reliable solution for pedestrian detection in complex low-light environments.}
}
@article{CHEN2026115603,
title = {Research on algorithm selection tasks based on multi-path retrieval-augmented generation in large language models},
journal = {Applied Soft Computing},
volume = {201},
pages = {115603},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115603},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010513},
author = {Liang Chen and Yang Xiao and Changhong Liu and Tongtong Wang},
keywords = {Algorithm selection, Intelligent manufacturing, Large language models, Retrieval-augmented generation},
abstract = {Algorithm selection is a critical problem in improving system performance and stability in complex application scenarios such as intelligent manufacturing. Although large language models (LLMs) have recently been introduced, limitations persist in multi-source information integration and reasoning organization, particularly under single-path retrieval, where insufficient information utilization can undermine decision consistency. To address this issue, this study proposes a Multi-path Retrieval-Augmented Generation (Multi-RAG) framework for algorithm selection from an engineering implementation perspective, unifying multi-source knowledge acquisition, context construction, and constrained reasoning. A base model is constructed via parameter-efficient fine-tuning using LoRA, upon which vector-based retrieval and keyword-based retrieval are integrated and fused through Reciprocal Rank Fusion (RRF), improving information coverage and consistency without additional parameter updates beyond the fine-tuning (FT) baseline. Dynamic context construction and task-oriented prompting further impose structured constraints on the reasoning process, enhancing decision stability and interpretability. Experimental results on the ASlib benchmark and simulated industrial data demonstrate consistent performance improvements across multiple scenarios, with improved information utilization efficiency and decision consistency. Overall, the Multi-RAG framework provides an effective, reproducible, and extensible engineering paradigm for complex algorithm selection tasks.}
}
@article{BERA2026115627,
title = {A heteroscedasticity-based extended long short term memory network for volatility forecasting and risk assessment},
journal = {Applied Soft Computing},
volume = {201},
pages = {115627},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115627},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010756},
author = {Koushik Bera and Aryan Bhambu and N. Selvaraju},
keywords = {Volatility forecasting, GARCH, Time series, LSTM, Value-at-risk, Deep learning, Transformer},
abstract = {Volatility forecasting is essential for risk management and financial decision-making as it provides insights into market uncertainty but remains challenging due to its complex and time-varying nature influenced by external factors. Motivated by the pronounced non-normality and heavy-tailed behavior of financial returns, Student-t innovations are adopted for volatility modeling and subsequent risk assessment. This paper introduces a heteroscedastic-based methodology that leverages Extended Long Short-Term Memory architecture for volatility forecasting and risk assessment. The approach integrates technical indicators and predictions from Generalized Autoregressive Conditional Heteroscedasticity (GARCH)-based models with the original input variables to improve forecasting accuracy. This method incorporates exponential gating with enhanced normalization and stabilization techniques and a restructured Long Short-Term Memory architecture designed to capture diverse volatility patterns effectively. The enhanced memory structures include xLSTMs-GARCH, which features heteroscedastic scalar memory updates and optimized mixing, and xLSTMm-GARCH, which supports full parallelization with matrix memory updates and covariance-aware transformations. These components are embedded into residual block backbones to form scalable xLSTMsm-GARCH architectures. Experimental evaluations conducted using four error metrics and two risk measures demonstrate that the proposed framework significantly enhances volatility forecasting accuracy and yields more reliable risk assessment, as validated by statistical backtesting, over compared baselines using seven diverse datasets. Among the proposed variants, the xLSTMs-GARCH model consistently delivers the best results. Specifically, on the S&P 500 index dataset, it achieves a 34.37% reduction in mean squared error (MSE) compared to the best-performing GARCH-based model and a 37.33% improvement over the best deep learning-based baseline.}
}
@article{ZHAN2026115647,
title = {Adaptive attention‑enhanced temporal convolutional network for highly accurate photovoltaic power forecasting in hyperdynamic scenarios},
journal = {Applied Soft Computing},
volume = {201},
pages = {115647},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115647},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010951},
author = {Guiren Zhan and Xufei Liao and Yuyang Zhang and Ling Bu},
keywords = {Temporal convolutional network, Adaptive loss function, Parallel self-attention mechanism, Extreme fluctuations, Drastic randomness},
abstract = {An improved forecasting method for photovoltaic (PV) power generation is proposed, addressing the challenges of extreme fluctuations and drastic randomness in PV power due to dynamic weather conditions. The model, adaptive attention enhanced temporal convolutional network (AAE-TCN), integrates TCN with parallel self-attention mechanism and adaptive loss function. The self-attention mechanism allows the model to dynamically focus on significant periods of drastic randomness, while the adaptive mean absolute error (AMAE) loss function amplifies large prediction errors, enabling the model to soundly handle extreme fluctuations. The model is tested under four different dynamic weather conditions, showing superior performance in prediction accuracy and robustness when compared to traditional machine learning (ML) models. The results indicate that AAE-TCN significantly outperforms other methods, with average values of mean absolute error (MAE), root mean square error (RMSE), and mean absolute percentage error (MAPE) being 0.008, 0.563, and 0.198%, respectively, and R² value close to 99.999%. These results demonstrate the model's effectiveness in improving PV power forecasting accuracy, especially in highly dynamic and unpredictable conditions.}
}
@article{GHOLINEJAD2026115619,
title = {Disentangling popularity and quality: An edge classification approach for fair recommendation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115619},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115619},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010677},
author = {Nemat Gholinejad and Mostafa {Haghir Chehreghani}},
keywords = {Recommendation systems, Graph neural networks (GNNs), Fairness, Item popularity, Item quality},
abstract = {Graph neural networks (GNNs) have proven to be an effective tool for enhancing the performance of recommender systems. However, these systems often suffer from popularity bias, leading to an unfair advantage for frequently interacted items, while overlooking high-quality but less popular items. In this paper, we propose a GNN-based recommendation model that disentangles popularity and quality to address this issue. Unlike existing methods that treat all long-tail items uniformly, our approach introduces an edge classification technique to differentiate between popularity bias and genuine quality disparities among items. Furthermore, it uses cost-sensitive learning to adjust the misclassification penalties, ensuring that underrepresented yet relevant items are not unfairly disregarded. Experimental results demonstrate improvements in fairness metrics by approximately 32% on average across different scenarios while maintaining competitive accuracy, with only minor variations compared to state-of-the-art methods.}
}
@article{WANG2026115639,
title = {Generative design of underground station pedestrian facilities: Evolutionary optimization with graph-based agent acceleration},
journal = {Applied Soft Computing},
volume = {201},
pages = {115639},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115639},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010872},
author = {Wenxuan Wang and Jacqueline T.Y. Lo},
keywords = {Generative design, Underground metro station, Building information modeling (BIM), Multi-objective optimization, Graph neural network},
abstract = {Underground metro stations are high-occupancy public infrastructure where pedestrian facilities (e.g., gates, escalators, and stairs) form the primary circulation system. Designing these systems involves mixed discrete–continuous decisions, multiple conflicting objectives, and strong spatial dependencies among facilities, which together make realistic performance evaluation expensive. As a result, early-stage pedestrian facility design often relies on limited manual iteration and yields configurations that are hard to compare across objectives. To address this problem, this paper proposes a surrogate-assisted multi-objective generative design approach for station-scale pedestrian facility systems. An enhanced evolutionary algorithm is used to generate Pareto-optimal designs that balance system complexity, facility waiting time, and walking distance. For the expensive-evaluation bottleneck, a physics-informed graph neural network surrogate whose architecture mirrors the underlying queueing network is introduced to predict facility-level waiting times and flow distributions on an abstracted facility graph, replacing slow simulations in the optimization loop. Benchmark tests show that this surrogate achieves an R2 above 0.99 on both objectives while reducing evaluation time from approximately 1800 s to 2.3 s per 100 candidates. A lightweight online correction mechanism then interleaves SimEvents re-evaluation and FEEC fine-tuning into the search to improve the surrogate’s performance in the regions explored by the optimizer. Experiments on two station scenarios and a Tai Koo Station case study across three peak-hour demand levels show that the framework enables efficient Pareto exploration across varying geometries and demand conditions and can reduce system complexity by 19–34% relative to the existing layout while keeping operational performance comparable.}
}
@article{SUN2026115642,
title = {G-M3CS: A gradient-based multi-metric multi-objective client selection algorithm for hierarchical federated learning},
journal = {Applied Soft Computing},
volume = {201},
pages = {115642},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115642},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010902},
author = {Qinming Sun and Wubin Ma and Rui Wang and Haohao Zhou and Yahui Wu and Chaofan Dai},
keywords = {Multi-objective optimization, Hierarchical federated learning, Client selection, NSGA-II algorithm},
abstract = {Addressing edge-level data heterogeneity in hierarchical federated learning remains a major research challenge, as it often induces global model bias, slower convergence, and client unfairness that are difficult to reconcile. In this paper, we propose G-M3CS, a gradient-based multi-metric multi-objective client selection algorithm, along with its enhanced version G-M3CS+. By integrating the NSGA-II algorithm, we formulate optimization objectives such as gradient diversity and gradient history consistency to identify high-value clients. Furthermore, we introduce a dynamic weighting mechanism that harmonizes the dual aggregation processes of cloud-edge and edge-client layers, enabling adaptive optimization for heterogeneous edge data distributions and achieving a better trade-off between performance and fairness. Extensive experiments conducted under diverse heterogeneous scenarios and datasets demonstrate that the proposed method improves global model accuracy by an average of 12.9% and fairness by 26.6% compared with existing algorithms. Particularly, under strong heterogeneity conditions such as the CIFAR-10 dataset, G-M3CS + achieves a 23.3% performance improvement over baseline methods, effectively mitigating the training challenges induced by edge-level data heterogeneity.}
}
@article{HOSSEINI2026115503,
title = {FQL_Puma: Integrating fuzzy reinforcement learning approach into PUMA optimization for adaptive search strategy and toward energy aware edge computing},
journal = {Applied Soft Computing},
volume = {201},
pages = {115503},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115503},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009518},
author = {Mohammad Hosseini and Jamal Zarepour-Ahmadabadi},
keywords = {Optimization, Fuzzy reinforcement learning, Meta-heuristic algorithm, Exploration and exploitation balancing, Energy aware application offloading, Resource allocation},
abstract = {Meta-heuristic algorithms need to balance exploration and exploitation to find good solutions. Most algorithms use fixed rules for this balance, which limits their performance. This paper presents FQL_Puma, an enhanced version of the Puma Optimizer that integrates fuzzy logic with Q-learning to adaptively select search strategies during the optimization process. To clearly assess the contribution of the fuzzy mechanism, a non-fuzzy Q-learning variant (QL_Puma) is also developed for comparison. This paper, also, evaluates both QL and FQL variants for the DIO algorithm. In addition to benchmark optimization, this study addresses sustainability in edge computing, where the rapid growth of connected devices and data processing has led to increased energy consumption. A system model is developed that jointly considers the energy consumption of both edge devices and edge servers in task offloading and resource allocation. The proposed methods are evaluated on standard benchmark functions and a realistic edge computing scenario. Experimental results show that the FQL-based strategy selection improves the original PUMA. Specifically, FQL_Puma improves PUMA’s performance on 14 to 18 out of 29 benchmark functions across different dimensions and achieves lower total energy consumption than PUMA in almost all evaluated edge computing scenarios.}
}
@article{GAIN2026115539,
title = {CCC++: Optimized color classified colorization with segment anything model (SAM) empowered object selective color harmonization},
journal = {Applied Soft Computing},
volume = {201},
pages = {115539},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115539},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009877},
author = {Mrityunjoy Gain and Avi Deb Raha and Rameswar Debnath},
keywords = {Colorization, Color class, Class weighted function, Imbalance features, Color harmonization},
abstract = {Automated colorization of grayscale images is challenging due to inter- and intra-object color variations, especially when large, dominant backgrounds surround small objects, which often biases models toward background features, causing object colors to blend incorrectly. To address this, we reframe regressive colorization as a heterogeneous classification task and apply a weighted function to balance class contributions. In this paper, we propose a set of formulas to convert color values to color classes and vice versa. Through experiments with varying bin sizes on numerous types of images, we determine that 532 distinct color classes are optimal. To address class imbalance, we introduce a dynamic class-weighted function that reduces the weights of dominant classes and boosts those of minor ones, ensuring fairer representation during training. We introduce a segment anything model (SAM) based post-processing module for color harmonization to improve object edge coherence. Additionally, we propose a color image evaluation metric, namely color class activation ratio (CCAR) to assess color component richness accurately. Extensive evaluations against 13 baseline and state-of-the-art methods across five diverse datasets, using both qualitative and quantitative analyses, demonstrate that our model outperforms existing approaches in the majority of metrics. On average, CCC++ achieves improvements of approximately 14.2% in reconstruction accuracy, 5.3% in structural similarity, 32.7% in perceptual and distributional quality, and 64.8% in color richness and task-aware fidelity across all benchmarks compared to baseline colorization methods.}
}
@article{MISTRY2026115520,
title = {Bias mitigation in machine learning models for recidivism using explainable AI},
journal = {Applied Soft Computing},
volume = {201},
pages = {115520},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115520},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009683},
author = {Aagnya Mistry and Jaiwin Mehta and Ankit Datta and Agam Kamdar and Neha Katre and Sweedle Machado},
keywords = {Artificial intelligence, Crime prediction, Explainable artificial intelligence, Machine learning, Recidivism},
abstract = {Criminal recidivism is a significant public safety issue, with offenders released from prison regularly re-offending. Its prediction is a critical machine learning task demanding a balance between accuracy and fairness. While various fairness interventions exist, a research gap remains in comprehensively evaluating hybrid pipelines that combine pre-, in-, and post-processing techniques across different models and datasets. This research compares six machine learning models (Logistic Regression (LR), Support Vector Classifier (SVC), Gradient Boosting Classifier (GBC), XGBoost (XGB), Random Forest Classifier (RFC), and Neural Network (NN)) on the COMPAS and NIJ datasets to identify optimal fairness-accuracy trade-offs. We tested pipelines combining pre-processing (Reweighing), in-processing (Adversarial Debiasing), and post-processing interventions (e.g., Equalized Odds). Experimental results show the Reweighing + Adversarial Debiasing + Equalized Odds pipeline offered the optimal trade-off for the NIJ dataset, maintaining accuracy above 0.70 with Disparate Impact (DI) between 0.9–1.02 and near-zero Equal Opportunity (EOD) and False Positive Rate (FPR) differences. As for the COMPAS dataset, the Adversarial Debiasing + Equalized Odds pipeline performed the best to give accuracies up to 0.66, as well as DI values ranging from 0.90 to 0.94, with EOD and FPR differences remaining close to zero. In the NIJ dataset, SVC, RFC, and NN were more consistent in stability, while XGB, LR, and GBC were more effective in COMPAS. These results also set out to show the promise of hybrid fairness interventions in drastically decreasing, yet not eliminating, recidivism prediction algorithmic discrimination, though the generalizability of these specific pipelines is bound by the datasets and fairness definitions employed.}
}
@article{JIAO2026115581,
title = {TimeScaleX: Multiscale decomposition and fusion learning for long-term time series forecasting},
journal = {Applied Soft Computing},
volume = {201},
pages = {115581},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115581},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601029X},
author = {Xianhao Jiao and Fan Zhang and Hua Wang},
keywords = {Long-term time series forecasting, Seasonal–trend decomposition, Gated multi-layer perceptron, Multi-scale modeling},
abstract = {Time series forecasting plays a critical role in practical applications such as weather prediction, power system scheduling, and traffic management. As real-world systems become increasingly complex, time series data often exhibit multiscale temporal characteristics, including long- and short-term dependencies, seasonal variations, and evolving time-frequency patterns, which jointly lead to strong non-stationarity and cross-variable interactions. These properties pose significant challenges to accurate long-term forecasting. To address these challenges, we propose a multiscale decomposition–fusion learning framework for modeling long-sequence time series. The proposed approach employs a pyramid-style downsampling strategy to construct multi-resolution temporal representations and integrates signal decomposition principles with neural modeling to disentangle trend, seasonal, and residual components. In addition, a gated multi-layer perceptron is introduced to adaptively fuse multiscale features by enhancing informative patterns while suppressing noise, and a channel-independent modeling mechanism is adopted to reduce computational complexity while preserving multivariate forecasting capability. Extensive experiments on multiple public benchmark datasets from weather, energy and traffic domains demonstrate that the proposed framework consistently outperforms state-of-the-art methods in terms of forecasting accuracy and generalization. These results indicate the effectiveness of multiscale decomposition–fusion learning as a soft computing paradigm for complex real-world time series forecasting tasks.}
}
@article{LEI2026115638,
title = {Dilated convolution and graph attention for joint relation extraction in Chinese medical text},
journal = {Applied Soft Computing},
volume = {201},
pages = {115638},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115638},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010860},
author = {Dajiang Lei and Yunqian Wang and Bin Luo and Liping Zhang and Weisheng Li},
keywords = {Hybrid neural model, Dilated convolution, Graph attention network, Chinese medical relation extraction, Knowledge graph},
abstract = {Relation extraction from unstructured Chinese medical texts plays a crucial role in constructing large-scale medical knowledge graphs. However, Chinese medical relation extraction remains challenging due to complex syntactic structures, lack of explicit word boundaries, and weak coupling between entities and relations. To address these challenges, we propose DCGAT-RE, a hybrid soft computing framework that integrates multi-scale dilated convolutional neural networks with graph attention reasoning to perform joint entity–relation extraction. The model embodies key soft computing principles—flexibility, adaptability, and approximate reasoning—by employing a multi-scale feature fusion mechanism, relation-aware graph attention, and a global correspondence alignment module for overlapping relation disambiguation. Built upon pre-trained language models, DCGAT-RE introduces an adaptive gating mechanism to fuse syntactic and semantic cues while jointly optimizing entity recognition and relation prediction. Experiments on multiple Chinese medical benchmarks (CMeIE, CMeIE-V2, and DiaKG) demonstrate that DCGAT-RE achieves superior performance with an F1-score of 77.1%, surpassing strong baselines such as ERNIE-Health by over 11%. These results highlight the model’s effectiveness as a soft computing-inspired hybrid neural reasoning system for robust relation extraction in complex biomedical domains.}
}
@article{WANG2026115554,
title = {MAFNet: Dynamic multiscale anti-aliasing fusion network for end-to-end explainable seizure prediction},
journal = {Applied Soft Computing},
volume = {201},
pages = {115554},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115554},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010021},
author = {Jie Wang and Yingchao Wang and Weiwei Nie and Qi Yuan},
keywords = {Seizure prediction, Anti-aliasing downsampling, Multiscale explainable framework, Frequency-domain feature selection, Stationarity correction},
abstract = {Epileptic seizure prediction models hold significant clinical potential for improving the quality of life of patients. However, existing models are critically challenged by patient heterogeneity and the non-stationary nature of electroencephalography (EEG) signals, leading to difficulties in feature decoupling and time-frequency dependency modeling. To address these issues, this study proposes a novel dynamic multiscale anti-aliasing fusion network (MAFNet), developed for end-to-end seizure prediction with clinical explainability. Specifically, MAFNet begins with a multiscale decomposition module using anti-aliasing downsampling, achieving differential modeling of EEG signals across multiple temporal granularities while effectively suppressing spectral aliasing. Subsequently, we integrate a frequency-domain feature selection mechanism with a local-global attention module to capture local-global dependencies across multiscale components. For stationarity correction, a joint constraint framework, combining frequency-domain cross-correlation analysis and hybrid similarity evaluation, is developed to align feature distributions before and after processing. Corrected features are fused hierarchically using a three-layer convolutional network with multiscale kernels. During model training, we optimize the parameter update process by introducing contrastive learning, and design a hybrid learning strategy that combines supervised and self-supervised learning strategies. Notably, two explainability methods, including joint feature visualization strategy and systematic feature ablation analysis, are collectively proposed to bridge the gap between the “black-box” nature of deep learning and clinical requirements. Experimental results on both intracranial and extracranial datasets demonstrate that the MAFNet achieves accuracy exceeding 90% and outperforms current state-of-the-art approaches.}
}
@article{KAUSHIK2026115578,
title = {SpectraGeni: A deep learning convolutional conditional variational autoencoder for synthetic hyperspectral data generation from highly imbalanced spectral measurements},
journal = {Applied Soft Computing},
volume = {201},
pages = {115578},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115578},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010264},
author = {Manoj Kaushik and Srinija Enimireddy and Rama Rao Nidamanuri},
keywords = {Synthetic hyperspectral data generation, Conditional Variational Autoencoder, Deep learning, Generative modelling, Data scarcity},
abstract = {The use of hyperspectral imaging spectroscopy data with classification algorithms is a key research area in remote sensing, and it requires reference data to evaluate algorithm performance. However, obtaining high-quality in-situ spectral signatures is slow, labour-intensive, and environmentally sensitive, leading to small, imbalanced datasets that limit thorough model generation and evaluation. These issues highlight the need for realistic synthetic spectral data generation to improve hyperspectral analysis. This study introduces SpectraGeni, a deep learning convolutional conditional variational autoencoder (CVAE) designed to generate realistic class-aware 1D synthetic spectral signatures that help overcome data constraints. The model captures the sequential nature of spectra and the subtle variations that distinguish different classes, generating samples that reflect the underlying structure of real observations rather than simple interpolations or memorized patterns. Integrating these generated spectra into training creates a more balanced and diverse dataset that supports stable learning, reduces overfitting, and improves model generalization in data-limited scenarios. Experiments comparing SpectraGeni with SMOTE, Borderline SMOTE, and CTGAN demonstrate its strong ability to generate physically plausible spectra. Generated data quality evaluation metrics consistently show that SpectraGeni produces quality signatures, better preserves intrinsic spectral relationships, and boosts downstream classification performance more effectively than competing approaches. Beyond improving performance, SpectraGeni offers a practical and computationally efficient solution for researchers facing limitations in sample size, instrument availability, or data diversity. Although validated on 1D spectral data, the framework enables future extensions toward spatial-spectral cube generation and multi-sensor adaptation, contributing a flexible generative method for hyperspectral workflows in data-scarce environments.}
}
@article{LI2026115488,
title = {Integrating exercise complexity and learner capability representation for knowledge tracing},
journal = {Applied Soft Computing},
volume = {201},
pages = {115488},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115488},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009361},
author = {Jiahao Li and Duantengchuan Li and Yue Li and Pan Liu and Jiangyi Zhang and Liangshan Dong and Jing Wang and Zhaoli Zhang and Huazhen Wang},
keywords = {Knowledge tracing, Personalized learning, Deep learning, Transformer},
abstract = {To accurately capture learners’ knowledge states, it is crucial to consider incorporating more feature information into knowledge tracing (KT) tasks. However, the current knowledge tracing models not only fail to fully meet the demand for relevant feature information to boost the forecast accuracy, but also ignore the practice and learner ability information. To solve the above problems, we introduce a knowledge tracing model named Integrating Exercise Complexity and Learner Capability Representation for Knowledge Tracing (ELKT). ELKT modularizes the construction of learner proficiency and knowledge representation for different feature information in knowledge tracing tasks. Additionally, we also introduce an interaction module to model the interaction between learners and items in real learning scenarios. We conducted experiments on 4 real-world knowledge tracing datasets and compared them with baseline models. The results show that on the Assistments2009 and Junyi datasets, compared with the second-best baseline models, ELKT improves the AUC metric by 1.23% - 2.09% and the ACC metric by 1.69% - 2.51%. Ablation experiments verify the effectiveness of key modules. Among them, the interaction features between exercise complexity and learner capability contribute 2% - 3% to the prediction accuracy, and the multi-channel convolution module plays an important role in matching learner capability with exercise difficulty. Our code is publicly available at https://github.com/dacilab/ELKT.}
}
@article{VASANTHI2026115606,
title = {A new intuitionistic fuzzy generator for low light image enhancement},
journal = {Applied Soft Computing},
volume = {201},
pages = {115606},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115606},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010549},
author = {I. Vasanthi and N. Padmaja and N. {Ramesh Babu}},
keywords = {Low contrast, Intuitionistic fuzzy generator, Fractal-fractional derivative, Local and global enhancement},
abstract = {Images taken in low light environments often exhibit low contrast, uneven illumination, blur, and noise, making enhancement particularly challenging. Existing enhancement methods, especially those that integrate fractal and fuzzy techniques through fusion strategies, often introduce structural inconsistencies and may lead to degraded performance. To address these challenges, we present a structure-preserving enhancement approach that simultaneously improves brightness and contrast while maintaining essential image details. The framework employs a sequential design that integrates local and global processing to reinforce structural information and minimize uncertainty in low light images. First, a new normalization function is introduced, followed by the design of a fractal–fractional mask to strengthen structural information. Next, a novel membership function is formulated to reduce uncertainty and further improve visual quality. Unlike fusion-based methods, the proposed approach ensures stable enhancement while delivering optimal brightness adjustment, superior contrast, and effective detail preservation. Experimental evaluations confirm that the method consistently outperforms state-of-the-art techniques, achieving significant improvements in both quantitative metrics and qualitative perception.}
}
@article{HOU2026115626,
title = {Benefit from reference: Retrieval-augmented cross-modal point cloud completion},
journal = {Applied Soft Computing},
volume = {201},
pages = {115626},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115626},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010744},
author = {Hongye Hou and Yang Yang and Zhan Liu and Fangyu Du},
keywords = {Point cloud completion, Generative model, 3D-retrieval},
abstract = {Completing the whole 3D structure based on an incomplete point cloud is a challenging task, particularly when the residual point cloud lacks typical structural characteristics. Recent methods based on cross-modal inputs attempt to introduce the 2D image to facilitate the learning of global and local features. However, the inherent differences between different modalities impact the effectiveness for unseen classes or varied structural patterns. In reality, similar objects can serve as important references for completing results. Therefore, we propose a novel retrieval-augmented point cloud completion framework. The core idea is to integrate cross-modal retrieval into the completion task, thereby acquiring prior information from similar 3D samples. Specifically, we design a Structural Shared Feature Encoder (SSFE) that jointly extracts cross-modal input features and obtains structural prior information from the reference point cloud. The final feature representation in the encoder benefits from a dual-channel control gate, which both enhances relevant structural features and reduces interference from irrelevant information. In addition, we propose a Progressive Retrieval-Augmented Generator (PRAG) that employs a hierarchical feature fusion mechanism to integrate reference prior information, generating complete point clouds from global to local levels. Through extensive evaluations on multiple datasets and real-world scenes, our method shows its effectiveness in generating fine-grained point clouds, as well as its generalization capability in handling sparse data and unseen categories. Without introducing any extra inputs, our approach outperforms the state-of-the-art by reducing the Chamfer Distance by 0.223 and improving the F1-score by 5.3% on the Shapenet-ViPC dataset.}
}
@article{KOUIDER2026115629,
title = {Exact and bound-guided metaheuristic approaches for dual-agent single-machine scheduling},
journal = {Applied Soft Computing},
volume = {201},
pages = {115629},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115629},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601077X},
author = {Ahmed Kouider and Abdelfetah Hentout and Adlane Baaziz},
keywords = {Dual-agent scheduling, Single machine scheduling, Non-tardy jobs, Upper bound, MILP, Hybrid simulated annealing, Industry 4.0},
abstract = {This paper investigates a dual-agent single-machine scheduling problem motivated by smart manufacturing systems, where two autonomous agents compete for access to a shared resource. Each agent controls a distinct set of jobs characterized by release dates, processing times, due dates, and weights. The objective is to maximize a weighted linear combination of the numbers of non-tardy jobs completed by the two agents, capturing their potentially conflicting priorities in shared-resource environments. To address this NP-hard problem, we propose an efficient solution framework centered on a hybrid simulated annealing (HSA) algorithm. The method integrates a novel upper bound (UB) derived from a structured relaxation and an EDD-based optimal reordering, which is exploited both to assess solution quality and to guide the search process. In addition, adaptive temperature control and neighborhood intensification mechanisms are incorporated to enhance robustness and convergence. Two enhanced MILP formulations are also developed and used as exact references for small and medium sized instances. Extensive computational experiments on 52 benchmark instances with up to 200 jobs show that the proposed HSA consistently produces high-quality solutions, with an average deviation below 4% from the upper bound, while maintaining low computational times. The exact MILP models are able to optimally solve all instances up to 35 jobs. These results highlight the scalability and effectiveness of the proposed approach in addressing dual-agent resource-sharing scheduling problems within Industry 4.0 environments, providing a solid reference for future studies on similar benchmarks and settings.}
}
@article{WATFA2026115566,
title = {Energy-constrained interpretable reinforcement learning using evolutionary symbolic policies for V2X traffic control},
journal = {Applied Soft Computing},
volume = {201},
pages = {115566},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115566},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010148},
author = {Mohamed K. Watfa},
keywords = {Interpretable reinforcement learning, Thermodynamic control, V2X networks, Robust decision-making, Evolutionary computation},
abstract = {Interpretable Reinforcement Learning (IRL) aims to reconcile decision transparency with performance and reliability in safety-critical domains, yet most existing approaches rely on post-hoc explanations of black-box policies and offer limited theoretical guarantees under distributional shift. This paper proposes an energy-bounded interpretable reinforcement learning framework for vehicular-to-everything (V2X) traffic control that integrates evolutionary symbolic policy synthesis with an energy-based acceptance mechanism to jointly enforce interpretability, robustness, and safety during learning. From a theoretical perspective, the paper establishes four complementary results: a free-energy duality showing that interpretability and robustness can be jointly optimal rather than heuristically balanced, a formal characterization of policy simplicity as a statistical regularizer improving generalization, a safety bound linking distributional mismatch to violation probability under sim-to-real shift, and a quantitative robustness guarantee bounding performance degradation by cumulative energy dissipation. Extensive simulations using a SUMO–Veins–OMNeT + + co-simulation framework show that the proposed approach reduces average travel time by 7–18%, lowers collision and near-miss rates by 22–27%, and decreases performance degradation under distributional shift by 28–42% compared to deep and rule-based baselines, while producing compact and auditable symbolic policies. These results demonstrate that energy-bounded evolutionary interpretable reinforcement learning provides a principled and deployable solution for robust V2X traffic control and other safety-critical cyber-physical systems.}
}
@article{LIANG2026115618,
title = {A synergistic multi-mechanism deep learning model for gasoline futures price forecasting},
journal = {Applied Soft Computing},
volume = {201},
pages = {115618},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115618},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010665},
author = {Fei Liang and Yu-Feng Yu and Ying-Chao Cheng and Yulin He},
keywords = {Energy market forecasting, Gasoline futures price prediction, Deep learning for time series, Wavelet decomposition, Attention mechanism with trend loss},
abstract = {The high volatility of gasoline futures prices challenges producers, investors, and policymakers, as inaccurate forecasts may cause substantial economic losses. Existing forecasting methods often struggle with non-stationarity, noise, and trend sensitivity, limiting accuracy and robustness. To address these issues, we propose a Synergistic Multi‑Mechanism Cooperative‑Driven (MMCD) forecasting framework. MMCD integrates rolling‑window segmentation, Daubechies 4 (Db4) wavelet decomposition, and QuantileTransformer normalization for multi‑scale denoising, combined with Bidirectional Gated Recurrent Units (BiGRU), dilated convolutions, and a self‑attention mechanism to capture temporal dependencies. A dual‑constrained trend loss jointly optimizes numerical precision and directional consistency. Experiments on West Texas Intermediate (WTI) crude oil and Reformulated Blendstock for Oxygenate Blending (RBOB) gasoline futures show that MMCD achieves RMSE values of 1.1970 and 0.0349 respectively, with R² exceeding 0.9890 on both series and directional accuracy (MDA > 0.833), surpassing benchmark models. Cross‑domain validation on the SPLV (S&P 500 Low Volatility) equity ETF further confirms generalizability, yielding an RMSE of 1.3842, R² of 0.9346, and a Calmar Ratio of 2.8462. Ablation studies verify each component's essential contribution. The proposed framework thus offers a robust forecasting tool for volatile energy markets, with evidence of broader applicability.}
}
@article{YING2026115602,
title = {Revisiting the evolution of genetic algorithms in scheduling},
journal = {Applied Soft Computing},
volume = {201},
pages = {115602},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115602},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010501},
author = {Kuo-Ching Ying and Pourya Pourhejazy and Kai-Yueh Chen},
keywords = {Scheduling, Optimization, Systematic review, Main path analysis, Evolutionary algorithm, Metaheuristics, SDG 9: industry, Innovation and infrastructure, Supply chain coordination},
abstract = {The Genetic Algorithm (GA) is among the most widely applied metaheuristics in the scheduling literature, yet a comprehensive review exploring its developments is lacking. This study employs Main Path Analysis (MPA) to explore the development trajectories of GA in the scheduling literature. The study also delves into the development patterns of GA across scheduling subfields, offering a thorough understanding of the evolution of applications and their influencing factors based on Cluster Analysis (CA). Further investigations based on keyword analysis are provided to explore the major development areas: Flexible Job Shop Scheduling, Flexible Flow Shop Scheduling, Parallel Machine Scheduling, Job Shop Scheduling, and Permutation Flow Shop Scheduling Problems. The review indicates that GA has made relatively greater progress in Job Shop and Flexible Job Shop Scheduling Problems. Applications of GA in Assembly Shop Scheduling and Open Shop Scheduling Problems remain underexplored. Moreover, the review found that the GA literature may benefit from computational developments based on clustering techniques for solving intractable scheduling problems with interacting features.}
}
@article{LI2026115663,
title = {A hierarchical hybrid control architecture combining B-spline planning and deep reinforcement learning for Mobile robot navigation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115663},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115663},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011117},
author = {Zhanlang Li and Mali Xing and Guanyu Lai and Hanzhen Xiao and C.L. Philip Chen},
keywords = {Mobile robot, Hierarchical hybrid control, Deep reinforcement learning, Navigation under uncertainty},
abstract = {In this work, a novel hierarchical hybrid control (HHC) framework is presented for mobile-robot navigation in complex and unknown environments. At the upper level, smooth global reference trajectories are generated via B-spline curves to provide directional consistency. At the lower level, a deep reinforcement learning-based local planner switches intelligently between efficient path tracking in safe zones and agile obstacle avoidance in cluttered regions. A key feature of the approach is a knowledge-guided reward-shaping mechanism based on artificial potential field principles, delivering dense, physically-intuitive feedback and dramatically accelerating learning convergence. The proposed HHC framework is validated via comprehensive simulation benchmarks across diverse environments and real-world deployment on a mobile robot. Results show that this method outperforms both conventional planning methods and standard learning-based approaches in terms of success rate, convergence speed, and robustness in practical navigation tasks.}
}
@article{JIE2026115683,
title = {NBQPSO: A novel approach of ambulance route smart planning based on genetic prospect theory learning framework},
journal = {Applied Soft Computing},
volume = {201},
pages = {115683},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115683},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011312},
author = {Zhang Jie and Li Jin-Ze and Zhang De-Gan and Zhang Ting and Sun Gui-Xiang and Du Rui-Hao},
keywords = {Path selection, Smart path planning, Vehicle routing, Minimum cost, Genetic prospect theory learning},
abstract = {With the increasing population density, the challenge of managing urban medical resources during large-scale disasters is intensifying. While the Internet of Things offers new opportunities for pre-hospital intelligent first aid, standard ambulance routing models often fail to account for the psychological factors of human commanders. To address this limitation, a novel approach of ambulance route smart planning named NBQPSO (Niche Genetic Strategy Based Quantum Particle Swarm Optimization Algorithm) based on a genetic prospect theory learning framework is proposed in this paper, which analyzes and addresses various problems encountered during actual ambulance rescue operations, based on observations and data from real-world scenarios.The ambulance path selection problem is an important part of the emergency response to large-scale disasters in cities, which is mainly studied in the case of emergencies, through the analysis of the number of casualties, the degree of injury, and the distribution of casualties for the ambulance to choose the optimal rescue pick-up and drop-off paths to increase the probability of survival of the affected casualties. When the ambulance leaves the emergency center and starts the rescue mission, the ambulance route planning needs to be considered. The basis of the path planning problem of emergency vehicles is the vehicle routing problem, which refers to arranging an efficient and reasonable driving path for the target vehicle through corresponding calculations, and finally making the vehicle complete all customer needs and tasks at the minimum cost. The core strength of our approach lies in bridging the gap between mathematical optimization and human psychology. By integrating the genetic prospect theory, the model realistically quantifies the decision-makers' risk-averse and risk-seeking behaviors under high-pressure scenarios. Furthermore, the proposed NBQPSO effectively overcomes the premature convergence issue typical of standard heuristic algorithms, demonstrating robust global search capabilities and superior performance in minimizing rescue time and resource overlapping.}
}
@article{CUI2026115594,
title = {Incremental feature selection using variable precision antinoise neighborhood rough sets},
journal = {Applied Soft Computing},
volume = {201},
pages = {115594},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115594},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010422},
author = {Shaoguo Cui and Xiaojun Chen and Binbin Sang and Lei Yang and Fanghong Zhang},
keywords = {Granular computing, Neighborhood rough sets, Incremental learning, Dynamic datasets, Feature selection},
abstract = {Incremental feature selection methods have attracted more and more attention because they can effectively deal with dynamic data and reduce the time cost of computation. However, there is a challenge in this method the new objects should be consistent with the distribution of similar objects in the universe. When new objects contain noisy or heterogeneous objects that lie close to the target class or within its densely populated regions, they can disrupt the rough set models underlying most existing incremental feature selection algorithms. This leads to a distorted attribute evaluation index and ultimately a significant degradation in classification efficacy. To overcome this drawback, this work designs a neighborhood density computation method that evaluates individual data objects based on their local density in relation to neighboring objects. Leveraging this concept, we introduce a Variable Precision Antinoise Neighborhood Rough Set (VPANRS) model. Based on this model, a robust Dependency Degree Metric (DDM) is formulated, and a Non-incremental Feature Selection algorithm (NIFS) is developed. Additionally, an adaptive updating mechanism for DDM is designed to handle both the addition and removal of data objects. This mechanism is combined with the algorithm NIFS to construct two incremental feature selection algorithms: one for object addition and another for object deletion. Comprehensive experiments conducted on 15 publicly available datasets confirm the robustness of the designed DDM and the effectiveness of the two incremental methods. The findings indicate that the new metric maintains robustness under noise, and the incremental algorithms efficiently adapt to dynamic data environments.}
}