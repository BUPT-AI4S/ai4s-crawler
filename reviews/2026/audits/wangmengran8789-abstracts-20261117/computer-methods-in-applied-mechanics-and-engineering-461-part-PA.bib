@article{LUKES2026119119,
title = {Reduced-order computational homogenization for hyperelastic media using gradient based sensitivity analysis of microstructures},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119119},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119119},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003920},
author = {Vladimír Lukeš and Eduard Rohan},
keywords = {Multiscale modeling, Model order reduction, Large deformation, Asymptotic homogenization, Sensitivity analysis, K-means clustering},
abstract = {We propose an algorithm for the computational homogenization of locally periodic hyperelastic structures undergoing large deformations due to external quasi-static loading. The algorithm performs clustering of macroscopic deformations into subsets called “centroids”, and, as a new ingredient, approximates the homogenized coefficients using sensitivity analysis of micro-configurations with respect to the macroscopic deformation. The novel “model-order reduction” approach significantly reduces the number of microscopic problems that must be solved in nonlinear simulations, thereby accelerating the overall computational process. The degree of reduction can be controlled by a user-defined error tolerance parameter. The algorithm is implemented in the finite element framework SfePy, and its effectiveness is demonstrated using two- and three-dimensional test examples. The results are compared with solutions obtained by the proper orthogonal decomposition method and full “FE-square” simulations. Extensions beyond the present implementations and the scope of tractable problems are discussed.}
}
@article{SILVA2026119091,
title = {Learning low-rank neutron transport dynamics on linear subspaces and nonlinear manifolds: A semi-intrusive operator-inferred approach},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119091},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119091},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003646},
author = {Francesco A.B. Silva and Jean C. Ragusa},
keywords = {Reduced-order modeling, Neutron transport, Reduced basis method, Operator inference, Nonlinear manifold learning, Data-driven modeling},
abstract = {We propose semi-intrusive low-rank model reduction strategies for time-dependent neutron transport problems. Starting from a full-order discretization of the transport equation in space and angle, we construct reduced models based on both linear subspaces and nonlinear manifold approaches. The nonlinear framework employs quadratic lifting maps (element-wise and tensorial) that embed low-dimensional latent variables into higher-dimensional lifted coordinates, thereby enhancing the expressive power of the reduced model. To avoid the prohibitive cost of forming and projecting advection operators, we introduce a data-driven operator inference strategy that directly estimates reduced advection operators from high-fidelity simulation data, while reaction operators are obtained cheaply by projection. Numerical experiments on a one-dimensional slab benchmark and on a two-dimensional clustered-inclusions benchmark generated with the OpenSn solver assess the proposed framework. In the one-dimensional case, where projected and inferred streaming operators can be compared directly, tensorial lifting delivers markedly improved accuracy compared to linear and element-wise quadratic reductions at comparable latent dimensions, while maintaining significant computational speed-ups. In the two-dimensional case, where the full streaming operator is not explicitly accessible, the semi-intrusive formulation remains applicable and tensorial manifold reduction provides the most accurate reduced solutions at small-to-moderate latent dimensions. These results highlight the potential of combining nonlinear manifold reduction with operator inference to obtain efficient and accurate surrogate models for neutron transport dynamics in large-scale, multi-dimensional settings.}
}
@article{ELBADRY2026119180,
title = {Immersed boundary-conformal isogeometric methods for magnetostatics},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119180},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119180},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004536},
author = {Yusuf T. Elbadry and Giuliano Guarino and Pablo Antolín and Oliver Weeger},
keywords = {Magnetostatics, Immersed boundary methods, Isogeometric analysis, Electric machines, Finite element method, Permanent magnet assembly},
abstract = {Isogeometric analysis was proposed to bridge the gap between computer-aided design and numerical discretization. However, standard multi-patch isogeometric analysis mandates conformal discretizations across patch interfaces, posing challenges for multi-material domain problems. In the context of electric machines, this requirement becomes evident in a large number of patches needed to represent machines consisting of several domains and materials. In this work, we adopt, extend, and evaluate three non-conformal discretization strategies for magnetostatic problems: a fully immersed approach, the union with non-conformal patches, and the union with conformal layers. In all three methods, boundary-conformal high-order quadrature rules are employed for integration over trimmed boundary and interface elements. In the two union approaches, material regions are, as far as possible, represented by independent non-conformal spline patches that are embedded within a background patch and coupled weakly through Nitsche’s method. In the latter framework, critical interfaces are additionally surrounded by conformal layers that enable the strong imposition of boundary conditions and improved resolution of interface behavior. The proposed approaches are assessed through several magnetostatic benchmark problems and an industrial application. The numerical results show that the union methods achieve highly accurate solutions, while the fully immersed approach struggles with discontinuities in field gradients across material interfaces. Nevertheless, these methods significantly reduce the geometric preprocessing effort compared to conventional, conformal multi-patch analysis and require substantially fewer patches. Overall, this demonstrates that our immersed boundary-conformal isogeometric framework possesses great potential for efficient simulation of complex electromagnetic devices.}
}
@article{SHEN2026119021,
title = {Alternating direction residual force reduction},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119021},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119021},
url = {https://www.sciencedirect.com/science/article/pii/S004578252600294X},
author = {Yuchi Shen and Yinan Xiao},
keywords = {Network structure, Initial equilibrium problem, Residual reduction, Stress state, Best-fit inverse form-finding},
abstract = {Form-finding of network structures aims to determine equilibrium configurations that comply with predefined geometry, boundary conditions, and geometric constraints. Existing numerical approaches often depend on pre-training or the solving of high-dimensional optimization problems, resulting in increased computational cost and reduced stability. This paper introduces a geometric–algebraic heuristic framework, termed Alternating Direction Residual Force Reduction (ADRFR), which approaches form finding as the solution of an Initial Equilibrium Problem (IEP). Inspired by principles from graphic statics, ADRFR employs nodal residual forces as the primary indicator of disequilibrium and reduces them through two alternating update steps: Harmonization, which adjusts internal force magnitudes while preserving force directions and form geometry; and Transformation, which modifies the form geometry by reorienting force directions under fixed force magnitudes. The two steps act on distinct but coupled variables and reduce the residual force field through alternating updates of force and geometry. This geometric update process achieves linear computational complexity and is inherently parallelizable. To address nonconvex or ill-conditioned cases and to expand the solution space, an algebraic extension is incorporated, which retains the alternating-step structure. Combined with this extension, ADRFR demonstrates superior performance in benchmark and design scenarios, particularly in constrained form-finding, internal force state exploration, and best-fit inverse form-finding tasks.}
}
@article{LITTLE2026119153,
title = {Submesh inner product for projection-based model order reduction with adaptive mesh refinement},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119153},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119153},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004263},
author = {Clayton Little and Jeremy Huang and Charbel Farhat},
keywords = {Projection-based model order reduction, Reduced-order modeling, Adaptive mesh refinement, Hyperreduction, Energy-conserving sampling and weighting, Submesh inner product, Nonlinear dynamics},
abstract = {Projection-based model order reduction (PMOR) remains challenging in the presence of adaptive mesh refinement (AMR), as the evolving discretization invalidates the fixed inner product structure assumed in standard formulations. This paper introduces a submesh inner product that enables consistent and computationally efficient PMOR and hyperreduction on adaptively refined meshes. In the proposed PMOR-AMR framework, snapshots are first clustered into local subspaces to enable the construction of compact, efficient local supermeshes and to mitigate the Kolmogorov n-width barrier for highly nonlinear problems. The submesh inner product facilitates this clustering, as well as online active subspace selection, by allowing distance evaluations without the prohibitive cost of global supermesh construction or pairwise snapshot interpolation. To ensure the robustness of basis identification and online switching, clustered snapshots are intentionally overlapped; this overlap is the primary mechanism that yields stable and reliable subspace selection despite the inner product approximation. The approach integrates snapshot centering, SVD-based compression, and energy-conserving sampling and weighting (ECSW) for hyperreduction. Applications to shock-dominated, laminar, and turbulent flows – culminating in a large-scale industrial simulation of the Ahmed body with over five million degrees of freedom – demonstrate that the framework preserves accuracy and stability while delivering substantial computational speedups for high-dimensional AMR-based simulations.}
}
@article{LIU2026119169,
title = {Neural operator-based damage sensing digital twin for piezocomposites with Parametrically Upscaled Coupled Constitutive Damage Model},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119169},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119169},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004421},
author = {Yangyuanchen Liu and Somnath Ghosh},
keywords = {Virtual damage sensor, Parametrically upscaled coupled constitutive damage model, Representative aggregated microstructural parameters (RAMPs), Fourier neural operator (FNO), GA sensor layout optimization},
abstract = {Early detection and tracking of damage for structural health monitoring (SHM) in challenging environments is critical for ensuring safety by preventing catastrophic failure and extending service life. This is particularly relevant as many techniques rely on sparse surface-mounted sensors, providing limited information on subsurface cracks that evolve to cause structural failure. Efficient in-situ reconstruction of temporally evolving deformation and damage fields in the bulk from sparse surface measurements can alleviate significant challenges faced by the SHM community. Coupling a machine learning-enabled multiscale multiphysics model, viz. the Parametrically Upscaled Coupled Constitutive Damage Model (PUCCDM) with Fourier neural operator (FNO) learning, this paper develops a Virtual Damage Sensing Digital Twin (VDS-DT) platform for piezoelectric composites. This platform interfaces with actual surface sensor measurements for efficient prediction of full-field temporally evolving deformation, electrical, and damage fields in the entire structure. A key feature of the framework is the incorporation of Representative Aggregated Microstructural Parameters (RAMPs), representing the characteristics of the underlying microstructure. These descriptors act as essential priors that regularize the inverse mapping and render the learned operator identifiable under sparse sensing. The mapping is learned using the FNO, trained on data generated by PUCCDM-based FE simulations, whose constitutive coefficients are explicitly represented as functions of the RAMPs. Furthermore, a genetic algorithm (GA) is employed to optimize sensor number and placement. Systematic studies demonstrate that the proposed VDS-DT platform achieves high-fidelity prediction of spatiotemporal damage evolution for both in-distribution and out-of-distribution testing cases, while revealing the complementary roles of sensor density and microstructure-informed priors (RAMPs). These results establish a unified paradigm for physics-informed, operator-based digital twins, providing a scalable pathway for real-time SHM with sparse sensing.}
}
@article{JIN2026119177,
title = {Optimal uncertainty quantification under general moment constraints on input subdomains},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119177},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119177},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004500},
author = {Rong Jin and Xingsheng Sun},
keywords = {Optimal uncertainty quantification, Epistemic and aleatory uncertainties, Safety certification, Inverse transform sampling, Rare events},
abstract = {We present an optimal uncertainty quantification (OUQ) framework for systems whose uncertain inputs are statistically independent and characterized by truncated moment constraints defined over subdomains. Given such partial uncertainty information, rigorous optimal upper and lower bounds on the probability of failure (PoF) can be derived over the admissible set of probability measures, providing a principled basis for system safety certification. We formulate the OUQ problem under general moment constraints on subdomains and develop a high-performance computational framework to compute the corresponding optimal bounds. The proposed approach transforms the original infinite-dimensional optimization problems, constrained by subdomain-based moment information, into finite-dimensional unconstrained optimization problems parameterized solely by free canonical moments. To address the prohibitive cost of PoF evaluation in high-dimensional settings, we further incorporate inverse transform sampling (ITS), which enables efficient and accurate estimation of the PoF within the OUQ optimization. We also examine a special case in which the uncertain inputs are constrained only by zeroth-order moments over subdomains, and demonstrate that the resulting OUQ formulation is equivalent to the evidence theory. The effectiveness and scalability of the framework are demonstrated through a set of numerical examples ranging from one-dimensional baselines to a ten-dimensional ballistic impact problem, involving varying numbers of subdomains and moment constraints. The results show that increasing either the number of subdomains or the order of moment constraints systematically decreases the upper bound and increases the lower bound with sufficient uncertainty information, thereby tightening the bound interval. For high-dimensional problems, the ITS strategy reduces the computational cost by up to two orders of magnitude while maintaining a relative error below 1%. For extreme rare-event settings, the main practical value lies in progressively tightening rigorous upper bounds, which can serve as conservative safety-design criteria. In addition, we identify regimes in which the optimal bounds are more sensitive to subdomain partitioning or to higher-order moment information. These findings provide practical guidance for prioritizing uncertainty reduction efforts when certifying system safety.}
}
@article{MENON2026119141,
title = {FEKAN: Feature-Enriched Kolmogorov–Arnold Networks},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119141},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119141},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004147},
author = {Sidharth S. Menon and Ameya D. Jagtap},
keywords = {Kolmogorov–Arnold networks, Physics-informed neural networks, Feature enrichment, Feature-enriched Kolmogorov–Arnold networks},
abstract = {Kolmogorov–Arnold Networks (KANs) have recently emerged as a compelling alternative to multilayer perceptrons, offering enhanced interpretability via functional decomposition. However, existing KAN architectures, including spline-, wavelet-, radial-basis variants, etc., suffer from high computational cost and slow convergence, limiting scalability and practical applicability. Here, we introduce Feature-Enriched Kolmogorov–Arnold Networks (FEKAN), a simple yet effective extension that preserves all the advantages of KAN while improving computational efficiency and predictive accuracy through feature enrichment, without increasing the number of trainable parameters. By incorporating these additional features, FEKAN accelerates convergence, increases representation capacity, and substantially mitigates the computational overhead characteristic of state-of-the-art KAN architectures. We investigate FEKAN across a comprehensive set of benchmarks, including function-approximation tasks, physics-informed formulations for diverse partial differential equations (PDEs), and neural operator settings that map between input and output function spaces. For function approximation, we systematically compare FEKAN against a broad family of KAN variants, FastKAN (RBFKAN), WavKAN, ReLUKAN, HRKAN, ChebyshevKAN, RBFKAN, and the original SplineKAN. Across all tasks, FEKAN demonstrates substantially faster convergence and consistently higher approximation accuracy than the underlying baseline architectures. Building on this foundation, we introduce a physics-informed extension, PI-FEKAN, and evaluate it on multiple PDE systems. PI-FEKAN outperforms existing physics-informed KAN formulations, achieving higher solution fidelity while simultaneously reducing training cost. To this end, in neural operator settings, FEKAN exhibits a pronounced advantage in learning high-frequency mappings, accurately capturing fine-scale structures that challenge existing operator-learning approaches. We also establish the theoretical foundations for FEKAN, showing its superior representation capacity compared to KAN, which contributes to improved accuracy and efficiency. These findings highlight feature enrichment as a powerful and general principle for improving the efficiency of KAN-based models, extending their applicability beyond core machine learning to scientific machine learning and computational physics, where interpretability and computational tractability are critical. The FEKAN code is available at https://github.com/ParamIntelligence/Feature-Enriched-KAN.}
}
@article{ROMERO2026119122,
title = {Identification of optimal history variables and corresponding hereditary laws in linear viscoelasticity},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119122},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119122},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003956},
author = {Ignacio Romero and Michael Ortiz},
keywords = {Hereditary constitutive laws, Internal variables, Compact operators, Kolmogorov -width, Reduced-order modelling},
abstract = {We develop an operator-theoretic formulation of linear hereditary constitutive models and characterize optimal finite-rank internal-variable approximations in the sense of Kolmogorov N-widths. The history operator is shown to be compact under natural assumptions on the relaxation kernel, thereby admitting optimal low-rank approximations. The resulting reduced models inherit thermodynamic consistency, stability, and provable approximation bounds. An analysis clarifies the structural relation between hereditary representations and internal-variable theories and provides a rigorous basis for reduced-order modelling in computational mechanics. Selected numerical examples showcase optimal convergence of approximations with respect to rank and sampling.}
}
@article{LI2026119159,
title = {Topology optimization of biodegradable structures with phase-field corrosion modeling},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119159},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119159},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004329},
author = {Chao Li and Minghui Zhang and Jinchen Ji and Xiaoxue Xu and Zhen Luo},
keywords = {Topology optimization, Phase-field model, Corrosion, Degradation, Time-dependent},
abstract = {Biodegradable alloys exhibit nonlinear degradation of mechanical properties, which poses challenges in designing implants with stable mechanical support throughout osseointegration. This study develops a topology optimization framework for designing biodegradable structures, in which the post-corrosion stiffness is controlled by imposing bounds on the structural compliance after degradation in the optimization problem. Within this framework, a systematic procedure is established to link the design variables to the post-corrosion compliance, and a corresponding time-dependent adjoint formulation is derived to efficiently compute design sensitivities, which form the core of the approach. To accurately predict the evolution of geometry and mechanical response over the intended service life of a structure, a phase-field-based corrosion model is integrated into the optimization loop. At each iteration, the density field obtained from filtered and projected design variables is mapped to the initial phase-field state. The subsequent corrosion process is simulated, and a new phase-field-based material interpolation scheme is proposed, which is applied to the final phase-field state to evaluate the degraded mechanical performance. Sensitivities then guide the evolution of topologies. The proposed framework provides a computational tool for designing biodegradable structures with tailored post-corrosion stiffness over the healing period by coupling physics-based phase-field corrosion simulation with structural optimization.}
}
@article{BIAN2026119203,
title = {Multi-phase boundary models based on wetting model for SPH simulation},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119203},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119203},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004767},
author = {Xiongheng Bian and Ma Feng and Xinlong Zhang and Xiaoyan Shen},
keywords = {Heterogeneous friction, Wetting phenomena, Implicit algorithm, Tangential force},
abstract = {Multiphase fluid simulation is important in applications ranging from computer animation to industrial and surface-related processes. Existing SPH-based wetting models mainly focus on normal interfacial interactions, whereas the treatment of roughness-influenced tangential resistance at solid-liquid boundaries remains limited. In particular, static roughness effects related to contact angle hysteresis and dynamic roughness effects associated with boundary-influenced thin-film behavior are not always represented in a unified manner. To address this issue, we propose a Heterogeneous Friction (HF) model from a microscopic wetting perspective. The model consists of Heterogeneous Static Friction (HSF), which characterizes static roughness and contact-line pinning, and Heterogeneous Dynamic Friction (HDF), which characterizes dynamic roughness through boundary-related tangential resistance during fluid motion. The formulation is incorporated into the SPH framework, and the HDF term is treated implicitly to enable coupling with the multiphase solver. The model is examined in representative wetting scenarios, including droplet sliding on inclined surfaces, sphere adhesion, liquid emission, and droplet tweezing. The results show that the proposed model can represent both static pinning behavior and dynamic sliding-to-rolling transitions associated with rough solid-liquid boundaries. In addition to microscopic wetting behavior, the model is also applied to macroscopic examples, including ebb-like coastal flow and vortex generation. These results suggest that the proposed approach may provide a useful framework for simulating multiphase fluid dynamics across microscopic and macroscopic scales in computer animation.}
}
@article{WEI2026119167,
title = {A novel peridynamic framework for fatigue modeling of quasi-brittle materials subjected to cyclic loadings},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119167},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119167},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004408},
author = {Pengju Wei and Jin Zhang and Tao Ni and Shu Zhu and Jianfu Shao},
keywords = {Cyclic fatigue, Convolutional law, Peridynamic model, Quasi-brittle materials, Energy equivalence strategy},
abstract = {In this work, a novel peridynamic model based on a history-dependent damage process is proposed to simulate the cyclic fatigue behavior of quasi-brittle materials, effectively circumventing the high computational costs of traditional step-by-step methods. Fatigue damage evolution is driven by the applied stress amplitude and the number of cycles through the coupling with the accumulated plastic stretch of the bonds. A rigorous energy equivalence strategy is introduced to calibrate the nonlinear parameters under static loading, which significantly enhances the model’s capability to simulate the pre-peak hardening and post-peak softening stages. To capture the progressive nature of fatigue, the damage accumulation of bonds at each cycle step is explicitly evaluated using a convolutional law, thereby creating a unified framework that spans from static failure to long-term cyclic degradation. Finally, by accurately capturing stress–strain accumulation, damage evolution, and failure patterns in implicit simulations of three-point bending concrete beams and pre-flawed sandstone, the proposed approach is thoroughly validated.}
}
@article{JIANG2026119136,
title = {Linear CIP-FEM for nonlinear Helmholtz systems at high wavenumbers},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119136},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119136},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004093},
author = {Run Jiang and Peijun Li},
keywords = {Nonlinear Helmholtz equations, Second harmonic generation, Third harmonic generation, Perfectly matched layer, Newton’s method, Finite element method, Preasymptotic error estimates},
abstract = {We study nonlinear Helmholtz systems (NLHS) in the high wavenumber regime subject to the Sommerfeld radiation condition. The perfectly matched layer (PML) technique is used to truncate the unbounded domain, and the resulting problem is discretized by the linear continuous interior penalty finite element method (CIP-FEM). Three iterative schemes, the frozen-nonlinearity iteration, Newton’s method, and a modified Newton’s method, are proposed for solving the nonlinear PML problem. For the truncated PML problem, we derive wavenumber-explicit stability estimates and prove exponential convergence as the PML truncation parameter increases. Preasymptotic error estimates are also derived for the CIP-FEM. Numerical examples are presented to illustrate the accuracy of the CIP-FEM and its ability to reduce pollution errors with appropriately chosen penalty parameters. Further numerical experiments on second- and third-harmonic generation illustrate harmonic conversion efficiencies, the quadratic convergence of Newton’s method, and the robustness of the modified Newton’s method with respect to initial guesses.}
}
@article{ZHAN2026119176,
title = {A volumetric–deviatoric phase-field formulation incorporating deviatoric dissipation for rock fracture in TL-SPH},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119176},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119176},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004494},
author = {Liangtong Zhan and Xiong Song and Linbo Wu and Yunmin Chen and Duanyang Zhuang and Yinghao Yuan and Junyuan Zhang and Zizhuang Yan},
keywords = {Brittle rock fracture, Pfm, Tl-sph, Crack evolution, Deviatoric strain energy dissipation},
abstract = {Reliable characterization of rock fracture is essential in rock engineering. Rock fracture involves strong discontinuities and evolving crack topology. These characteristics challenge conventional mesh-based methods due to mesh distortion, remeshing requirements, and limited resolution of evolving mesoscale fracture processes. To address these issues, this study presents a meshfree framework that couples Total-Lagrangian Smoothed Particle Hydrodynamics (TL-SPH) with the phase-field method (PFM). Using a volumetric–deviatoric energy decomposition, a crack-driving formulation incorporating deviatoric dissipation is proposed to suppress nonphysical crack growth under compression-dominated states. Three representative brittle fracture benchmarks are used for validation, and the results capture key features of crack initiation, propagation, and coalescence, as well as crack paths and fracture topology. The proposed TL-SPH–PFM framework provides a meshfree approach for simulating brittle fracture processes in rock and rock-like materials.}
}
@article{XU2026119152,
title = {A two-stage topology optimization framework for designing multi-scale elastic metamaterials with cross-scale dual bandgaps},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119152},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119152},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004251},
author = {Xinlin Xu and Koji Nishiguchi and Junji Kato},
keywords = {Topology optimization, Phononic crystal, Metamaterial, Multiscale design},
abstract = {Elastic metamaterials exhibit exceptional capabilities in controlling vibration and wave propagation. However, designing a single metamaterial architecture that possesses complete bandgaps at frequency scales separated by orders of magnitude remains a formidable challenge. To address this issue, this paper proposes a systematic two-stage topology optimization framework. In the first stage, a bi-material microstructural unit cell is optimized to generate a complete Bragg-scattering bandgap at a targeted high frequency range. The optimized microstructure is then characterized by numerical homogenization and utilized as an equivalent homogeneous material. In the second stage, the macroscale distribution of this equivalent material within a base matrix is optimized to create a distinct complete bandgap at a targeted low frequency range. A key contribution of this work is the introduction of a novel Quadratic Exclusion Aggregation (QEA) constraint, which is formulated from a series of individual quadratic exclusion (QE) constraints. Compared with conventional ipsilateral frequency (IF) constraint formulations, the proposed QEA constraint is designed to improve robustness and computational stability by reducing scale-dependent parameter tuning across different optimization stages and by employing a Kreisselmeier–Steinhauser (KS) function for effective aggregation. Numerical examples demonstrate the effectiveness of the proposed framework, successfully yielding a hierarchical metamaterial exhibiting two distinct complete bandgaps at frequencies separated by several orders of magnitude. The proposed framework, together with the improved constraint formulation, provides a systematic methodology for the on-demand design of advanced metamaterials with multiscale wave-manipulation functionalities.}
}
@article{JUEL2026119140,
title = {A stabilized fractional-step MPM with pressure gradient projection for coupled hydromechanical extreme deformations},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119140},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119140},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004135},
author = {Mikkel Metzsch Juel and Hervé Vicari and Yidong Zhao and Lars Blatny and Chenfanfu Jiang and Johan Gaume},
keywords = {Material point method, Two-phase, Double-point, Incremental fractional step, Pressure gradient projection, TPIC pressure mapping},
abstract = {We present a novel stabilized fractional-step two-phase double-point Material Point Method (MPM) for robust and computationally efficient simulations of extreme-deformation hydromechanical problems. Existing fractional-step models employ either a non-incremental pressure discretization, which is suitable for large deformations but inaccurate under low permeability conditions, or an incremental formulation that improves accuracy yet relies on stabilization methods that are currently inadequate for large deformations. To overcome these limitations, we present the first adaptation of the Stabilized Pressure by Gradient Projection (SPGP) method to the MPM framework and propose a Taylor Particle-in-Cell (TPIC) pressure mapping for improved free-surface treatment. A generalized temporal discretization for pressure and drag is developed, providing new insights into the numerical behavior of non-incremental and incremental fractional-step schemes. In particular, we demonstrate that the non-incremental formulation remains inherently sensitive to permeability, whereas the incremental formulation achieves superior accuracy with permeability-independent timesteps, eliminating the need for complex drag discretizations. The proposed method is implemented in the high-performance Taichi programming language, leveraging GPU acceleration and sparse grid capabilities, combined with a matrix-free conjugate gradient algorithm to efficiently solve the pressure-Poisson system. Our model is validated against a series of benchmark problems covering large deformations and phase separation phenomena, demonstrating high accuracy and robustness without case-specific tuning of stabilization parameters. This advancement establishes a unified and robust foundation for simulating coupled hydromechanical processes, such as water-rich geophysical mass flows.}
}
@article{FENG2026119192,
title = {Data-driven joint representation and prediction of nonlinear dynamical systems from unlabeled trajectories},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119192},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119192},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004652},
author = {Jing Feng and Xiaolong Wang and Qi Liu and Jinzhong Ma and Xiaole Yue and Siyang Leng and Jürgen Kurths and Yong Xu},
keywords = {Unsupervised learning, Nonlinear dynamical systems, Deep learning, Representation learning, State prediction},
abstract = {The task of jointly forecasting dynamical systems from unlabeled, trajectory-varying measurements is confronted by a fundamental circular dependency: identifying system parameters requires known equations, while modeling equations presupposes estimated parameters. A dual-network Joint Representation And Prediction (JoRAP) framework is proposed to resolve this interdependence, simultaneously distinguishing all trajectories and approximating their vector fields. JoRAP integrates a trajectory representation neural network (TRNN) that encodes individual trajectories into vectorial embeddings, and a vector field neural network (VFNN) that infers the derivatives at any states from each embedding. This co-design enables a fully autonomous learning, simultaneously identifying diverse trajectories and capturing the characteristics of dynamical behaviors. Evaluated on unlabeled trajectories of nonlinear dynamical systems with partial observability, JoRAP achieves accurate long-horizon predictions and learns representations that distinguish dynamical regimes such as periodic, chaotic, and multistable behaviors. Our framework establishes a data-driven paradigm that requires neither predefined equations nor known parameters, enabling joint analysis and forecast of diverse complex systems from observations alone.}
}
@article{KHODAKARAMI2026119156,
title = {Spectral bias in physics-informed and operator learning: Analysis and mitigation guidelines},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119156},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119156},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004299},
author = {Siavash Khodakarami and Vivek Oommen and Nazanin Ahmadi Daryakenari and Maxim Beekenkamp and George Em Karniadakis},
keywords = {Spectral bias, PINN, PIKAN, Neural operator, Second-order optimization},
abstract = {Solving partial differential equations (PDEs) by neural networks as well as Kolmogorov-Arnold Networks (KANs), including physics-informed neural networks (PINNs), physics-informed KANs (PIKANs), and neural operators, is known to exhibit spectral bias, whereby low-frequency components of the solution are learned significantly faster than high-frequency modes. While spectral bias is often treated as an intrinsic representational limitation of neural architectures, its interaction with optimization dynamics and physics-based loss formulations remains poorly understood. In this work, we provide a systematic investigation of spectral bias in physics-informed and operator learning frameworks, with emphasis on the coupled roles of network architecture, activation functions, loss design, and optimization strategy. We quantify spectral bias through frequency-resolved error metrics, Barron-norm diagnostics, and higher-order statistical moments, enabling a unified analysis across elliptic, hyperbolic, and dispersive PDEs. Through diverse benchmark problems, including the Korteweg–de Vries, wave and steady-state diffusion-reaction equations, turbulent flow reconstruction, and earthquake dynamics, we demonstrate that spectral bias is not only representational but also fundamentally dynamical. In particular, second-order optimization methods substantially alter the spectral learning order, enabling earlier and more accurate recovery of high-frequency modes for all PDE types. For neural operators, we further show that spectral bias is dependent on the neural operator architecture and can also be effectively mitigated through spectral-aware loss formulations without increasing the inference cost.}
}
@article{ENAKOUTSA2026119184,
title = {Bayesian inference of PDE solution operators: Projection-based learning, error decomposition, and posterior contraction},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119184},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119184},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004573},
author = {Koffi Enakoutsa},
keywords = {Function space learning, Statistical inverse problems, Gaussian priors, Model uncertainty, Data-driven PDEs},
abstract = {We study the recovery of solution operators of partial differential equations (PDEs) from finitely many noisy, discretized input–output observations. Our aim is not to introduce a new competitive operator-learning architecture, but to give an analytical synthesis that organizes operator learning, Bayesian inverse problems, projected regularization, and error decomposition within a single framework. We make explicit that, when data are finite, discretized and noisy, operator learning is naturally read as a regularized linear inverse problem—a viewpoint that is classical in Bayesian inversion and regularization theory. The computational scheme studied here is a regularized projected linear–Gaussian estimator on a finite-dimensional feature space, not a novel neural operator. Its maximum a posteriori (MAP) estimate coincides with a Tikhonov-regularized least-squares problem, and the associated Gaussian posterior describes the epistemic uncertainty induced by finite noisy data under the assumed projected statistical model. We organize the reconstruction error into discretization, approximation, and statistical components, and prove – under a corrected finite-dimensional observation model – posterior well-posedness, stability, a non-asymptotic statistical bound, and posterior contraction. Numerical experiments on advection, viscous Burgers, Darcy, and Helmholtz benchmarks illustrate how the dominant error component shifts with the analytical properties of the operator. We emphasize the limits of the present model: the learned operator is deterministic, the posterior variance is coefficient-driven and largely global rather than spatially adaptive, and the framework does not model intrinsic physical randomness, stochastic-PDE variability, parameter or model-form uncertainty, or fully localized discretization uncertainty.}
}
@article{ZOU2026119160,
title = {A probabilistic framework for learning solution operators of deterministic high-frequency Helmholtz equations},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119160},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119160},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004330},
author = {Yicheng Zou and Samuel Lanthaler and Hossein Salahshoor},
keywords = {Helmholtz equation, Diffusion models, Probabilistic neural operators, High-frequency wave propagation, Uncertainty quantification},
abstract = {Deterministic neural operators perform well on many PDEs but can struggle with the approximation of high-frequency wave phenomena, where strong input-to-output sensitivity makes operator learning challenging, and spectral bias blurs oscillations. We argue for adopting a probabilistic approach for approximating waves in high-frequency regime, and develop our probabilistic framework using a score-based conditional diffusion operator. After demonstrating a stability analysis of the Helmholtz operator, we present our numerical experiments across a wide range of frequencies, benchmarked against other popular data-driven and machine learning approaches for waves. We show that our probabilistic neural operator consistently produces robust predictions with the lowest errors in L2, H1, spectral power, and energy norms. Moreover, unlike all the other tested deterministic approaches, our framework remarkably captures uncertainties in the input sound speed map propagated to the solution field. We envision that our results position probabilistic operator learning as a principled and effective approach for solving complex PDEs such as Helmholtz in the challenging high-frequency regime.}
}
@article{MISHRA2026119172,
title = {A unified null space projected Physics-Informed Extreme Learning machine framework for static bending of Kirchhoff–Love and Reissner–Mindlin plates},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119172},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119172},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004457},
author = {Rishi Mishra and Anuj Said and Smriti Smriti and Ganapathy Krishnamurthi and Balaji Srinivasan and Sundararajan Natarajan},
keywords = {Physics-informed extreme learning machines, Kirchhoff–Love plates, Reissner–Mindlin plates, Null-space projection, Shear locking, Exact boundary enforcement},
abstract = {In this paper, we propose a unified null-space projected Physics-Informed Extreme Learning machine (NP-PIELM) framework that establishes a single non-iterative computational approach for the static bending analysis of plates governed by both Kirchhoff–Love and Reissner–Mindlin plate theory. The proposed formulation enforces: (a) the governing equations in strong form at collocation points and (b) boundary conditions exactly through algebraic null-space projection in coefficient space, guaranteeing strict constraint satisfaction without penalty parameters, Lagrange multipliers or hyperparameter tuning. The framework is intrinsically locking free in case of Reissner–Mindlin formulation. The accuracy and robustness of the NP-PIELM framework is demonstrated through numerical examples. The influence of plate aspect ratio, plate thickness, boundary conditions and geometric skewness is numerically studied. The results confirm that NP-PIELM provides a computationally efficient, geometrically flexible and a unifying framework for analyzing moderately thick to thin plates.}
}
@article{SCHORSCH2026119164,
title = {Extension of Nitsche’s method for the unilateral contact of beams: A pinch-enhanced model},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119164},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119164},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004378},
author = {M. Schorsch and D. Dureisseix and T. Elguedj and C. Pozzolini and Y. Renard},
keywords = {Unilateral contact, Nitsche’s method, Finite element method, Enhanced beam models},
abstract = {This work addresses a static frictionless contact problem between a beam and a rigid obstacle governed by Signorini’s non-penetration conditions. The objective is to investigate the applicability of Nitsche’s method to thin structures in this setting. A Nitsche formulation is first examined for the Timoshenko beam model. However, the kinematics of standard Timoshenko beam theory is not sufficiently rich to yield a Nitsche-based formulation for contact. An enriched beam model is therefore developed, with an enhanced kinematics accounting for pinching effects. The resulting model is consistent, as shown in particular by patch-test validation, and leads to a Nitsche-based formulation for frictionless contact. Numerical results are then presented to evaluate the accuracy of the proposed enriched beam model by comparison with the three-dimensional elastic model.}
}
@article{BANSAL2026119121,
title = {Nitsche’s method for the stationary Boussinesq system under mixed and nonlinear boundary conditions},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119121},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119121},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003944},
author = {A. Bansal and N.A. Barnafi and G. Sperone and D.N. Pandey},
keywords = {Boussinesq system, Navier boundary conditions, Nitsche’s method, A priori/a posteriori analysis},
abstract = {In this paper we analyze Nitsche’s method for the stationary Boussinesq system with Navier’s slip and a nonlinear boundary condition. Our analysis of the formulation establishes the robustness of a finite elements scheme in arbitrarily complex boundaries. The well-posedness of the discrete problem is established using fixed-point theorems under a standard smallness assumption on the data. We also provide optimal convergence rates for the approximation error. Furthermore, the efficiency and reliability of residual-based a posteriori error estimators are established. We validate our theory through several numerical tests.}
}
@article{BRODBECK2026119124,
title = {Model qualification for auxetic lattice structures: Combining goal-oriented adaptive FEM and experimental validation},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119124},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119124},
url = {https://www.sciencedirect.com/science/article/pii/S004578252600397X},
author = {Maximilian Brodbeck and Nicolas Grünfelder and Berta Pi Savall and Fleurianne Bertrand and Seyed Morteza Seyedpour and Tim Ricken},
keywords = {Auxetic structures, Adaptive finite element method, Goal orientated error estimation, Stress equilibration, FEniCSx, Experimental validation},
abstract = {Accurate simulations of lattice-based metamaterials is often limited less by constitutive modelling than by discretisation errors caused by singular stress fields. These localised errors can substantially affect relevant quantities of interest, including stresses, displacements, and reaction forces. This paper presents applicable goal-oriented adaptive finite element methods for the computationally efficient simulation of lattice structures in the framework of linear elasticity, implemented on top of the open-source software FEniCSx. The novelty of the contribution lies in three main aspects: first, the formulation of guaranteed goal-oriented error estimates based on equilibrated, H(div) conforming stresses without strong symmetry; second, the comparison of equilibration based error estimators forming either a guaranteed upper bound or are just asymptotically exact; and third a comparative study of adaptive finite elements methods and the underlying error estimates, specifically for lattice structures. Therefore, three estimators are derived, analysed, and implemented. Their performance is assessed through a series of representative benchmarks and by comparing uniform and adaptive mesh refinement strategies for lattice structures of increasing complexity, ranging from a small patch of unit cells to a meso-structured aircraft wing rib. In addition, the predictive capability of the proposed framework is validated against experimentally determined force–displacement data for two different auxetic lattice structures. The results demonstrate that the proposed adaptive schemes provide improved computational efficiency over uniform refinement while maintaining high accuracy, thereby supporting reliable numerical prediction and simulation-based design of architected structures in structural engineering.}
}
@article{DAI2026119137,
title = {A recursive multilevel hierarchical domain decomposition approach for efficient spectral stochastic finite element analysis},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119137},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119137},
url = {https://www.sciencedirect.com/science/article/pii/S004578252600410X},
author = {Hongzhe Dai and Bowen Luo and Pol D. Spanos},
keywords = {Spectral stochastic finite element, Domain decomposition, Kronecker product, Hierarchical approach, Multilevel},
abstract = {Spectral stochastic finite element methods (SSFEM) have emerged powerful tools for uncertainty quantification in engineering. Although domain decomposition methods (DDM) have been integrated into SSFEM to enhance computational efficiency, the global extended Schur complement (e-SC) system expands rapidly with increasing stochastic dimensions and polynomial chaos orders, leading to prohibitively large interface systems. Further, Gaussian elimination may become computationally expensive under refined stochastic discretizations. These issues severely limit the applicability of conventional DD-based SSFEM for large-scale engineering systems. In this paper, a recursive multilevel hierarchical domain decomposition method for efficient SSFE analysis is developed. The method firstly reformulates the conventional e-SC system into a global Kronecker e-SC system via tensor-product factorization. The resulting system is then partitioned as a multilevel block form by exploiting its hierarchical structure. Based on this multilevel representation, a recursive multilevel hierarchical strategy is developed to solve the resulting Kronecker system. In the developed method, since the constructed Kronecker system can be assembled from low-dimensional Kronecker factors, Gaussian elimination can be performed through inversion of a set of small-scale matrices, and the prohibitive large-matrix operations inherent in conventional DDM are thus bypassed. Furthermore, since the multilevel partition enables the global system to be converted to a set of small-scale subsystems with block diagonal dominance, the computational complexity for solving large-scale global Kronecker e-SC system can be substantially reduced. In addition, the recursive refinement strategy iteratively mitigates the hierarchy-induced approximation errors, ensuring robust convergence even under high stochastic variability. The stochastic analysis of a practical large-scale gravity dam demonstrates the effectiveness of the developed method. The results show that the method provides an accurate and highly efficient framework for large-scale spectral stochastic finite element analysis, demonstrating its potential for complex engineering applications.}
}
@article{CHEN2026119158,
title = {GPU-accelerated Riemann-SPH-RKPM method for fluid-structure interaction simulation of underwater explosions},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119158},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119158},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004317},
author = {Hao Chen and Fu-Ren Ming and Yu Tian and Dong-Fang Liang and A-Man Zhang},
keywords = {Fluid-structure interaction, Underwater explosions, GPU-acceleration, SPH-RKPM, Ship structural damage},
abstract = {Transient fluid-structure interaction (FSI) processes often involve strong impact loads and pronounced nonlinear responses. A typical example arises in near-field underwater explosions, which involve highly transient and nonlinear phenomena, including shock waves with strong discontinuities, pulsating bubbles undergoing drastic volume changes, and severe tearing and damage to ship structures. These processes entail complex FSI, placing stringent demands on both the accuracy and computational efficiency of numerical methods. To address the bottleneck in high-resolution, large-scale simulations, this study develops a fully meshless Riemann-smoothed particle hydrodynamics (SPH) and reproducing kernel particle method (RKPM) coupling method with GPU-acceleration for FSI analysis in underwater explosions. Within a unified GPU computing framework, the solutions of fluid dynamics, structural dynamics, and FSI are all organized using “particles” or “stress points” as fundamental parallel units. A unified data structure and a parallel optimization strategy based on a shared linked list are introduced, effectively reducing the overhead associated with neighbor searching and data access. The accuracy and computational efficiency of the proposed method are demonstrated through underwater explosion simulations involving a free-field shock wave, a double-layer cylindrical shell, and a full-scale submarine. Under the same spatial resolution, present single-precision implementation and computational configuration adopted in this study, the GPU-based parallel framework achieves an overall runtime reduction ratio of at least 31 times compared with the CPU-based parallel implementation in typical fluid-structure interaction scenarios. Moreover, it enables efficient large-scale, high-resolution simulations while substantially reducing total computational time.}
}
@article{YANG2026119198,
title = {A two-pass projection-based augmented Lagrangian IGA-BEM contact algorithm for non-conforming meshes},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119198},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119198},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004718},
author = {Yitao Yang and Qiangqiang Zhao and Dewen Yu and Xiaohu Li and Jun Hong},
keywords = {Isogeometric analysis, Boundary element method, Non-conforming meshes, Augmented Lagrangian method, Two-pass projection, NURBS},
abstract = {This paper develops a three-dimensional contact algorithm within the isogeometric boundary element method (IGA-BEM) framework, employing Non-Uniform Rational B-Splines (NURBS) basis functions to represent the geometry exactly and interpolate the physical fields simultaneously. Their inherent Cp−1 inter-element continuity furnishes a smooth normal vector field across the contact interface, suppressing the contact force oscillations that plague conventional C0 discretizations. A Uzawa-type augmented Lagrangian formulation is adopted to treat non-conforming mesh contact problems systematically: the augmented Lagrangian constitutive equation expresses the contact traction as an explicit function of the gap and the Lagrange multiplier, and because the multiplier is updated through an outer Uzawa iteration rather than appended as an extra system unknown, the original variable format and size of the boundary element method (BEM) system are retained. A symmetric two-pass projection strategy is proposed in which the two contact surfaces alternately serve as the master surface for closest-point projection and the resulting contact contributions are assembled into each body’s governing equations independently, eliminating the arbitrariness of master–slave assignment while preserving interface force balance. Three benchmark examples, including a Hertzian contact test, a 45°-rotated non-conforming mesh test, and an interference fit problem, confirm good agreement with analytical solutions and finite element results, demonstrating the accuracy and robustness of the proposed algorithm.}
}
@article{MARGENBERG2026119190,
title = {Anisotropic hp space–time adaptivity and goal-oriented error control for convection-dominated problems},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119190},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119190},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004639},
author = {Nils Margenberg and Bernhard Endtmayer and Marius Paul Bruchhäuser},
keywords = {Anisotropic -adaptivity, Goal-oriented error control, Dual-weighted residual method, Space–time finite elements},
abstract = {We present an anisotropic goal-oriented error estimator based on the Dual Weighted Residual (DWR) method for time-dependent convection-dominated problems. Using elementwise p-anisotropic finite element spaces, the estimator is elementwise separated with respect to the single directions in space and time. This naturally leads to adaptive, anisotropic hp-refinement (h-anisotropic refinement and elementwise anisotropic p-enrichment). We employ discontinuous elements in space and time, which are well suited for problems with high Péclet numbers. Efficiency and robustness of the underlying algorithm are demonstrated for different goal functionals. The directional error indicators quantify anisotropy of the solution with respect to the goal, and produce hp-refinements that efficiently capture sharp layers. We establish error representation, reliability, and efficiency results and numerical examples in up to three spatial dimensions demonstrate the superior performance of the proposed method compared to isotropic h and hp adaptive refinement using established benchmarks for convection-dominated transport.}
}
@article{LU2026119143,
title = {An SPH-based framework for fluid–shell interaction with enhanced constitutive generality and explicit interface reconstruction},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119143},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119143},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004160},
author = {Yao Lu and Wenhao Shen and Chaoyang Guo and Chi Zhu and Wenkui Shi and Jianqiang Chen and Mengyuan Wang and Zhangtao Zhou and Moubin Liu},
keywords = {Smoothed particle hydrodynamics (SPH), Fluid–shell interaction, Solid-shell, Interface reconstruction, Aortic valve},
abstract = {Fluid–shell interactions are ubiquitous in engineering and biomechanical applications, where large deformation of slender structures, evolving flow domains, and strongly coupled interfaces pose significant numerical challenges. Although numerous fluid–shell interaction frameworks based on reduced shell formulations have been developed, the kinematic constraints imposed by classical shell theories inherently restrict their constitutive generality. Moreover, insufficiently resolved interfaces in conventional treatments can introduce numerical artifacts, such as artificial geometric offsets, nonphysical fluid intrusion, and spurious force imbalance. To address these limitations, this study presents a smoothed particle hydrodynamics (SPH)-based framework for fluid–shell interaction built upon two key advancements. First, the shell is modeled using a recently developed solid-shell SPH formulation that explicitly resolves the through-thickness field, thereby preserving full 3D kinematics. This formulation accommodates a broad class of nonlinear constitutive laws, significantly enhancing constitutive generality and applicability. Second, an explicit interface reconstruction method is proposed to directly identify the physical fluid–shell interaction and contact interfaces, rather than approximating them through adjacent particle layers. This method eliminates the artificial geometric offsets inherent in conventional methods, enhancing geometric fidelity and coupling accuracy across a broad range of shell thicknesses. The framework is validated through benchmark tests and representative applications involving large deformation, moderate-to-high Reynolds numbers, and transient contact. The results demonstrate that the framework significantly improves interface fidelity and mechanical accuracy, providing a robust and versatile approach for complex fluid–shell interactions.}
}
@article{SUN2026119163,
title = {Multi-material multi-physics topology optimization with physics-informed Gaussian process priors},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119163},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119163},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004366},
author = {Xiangyu Sun and Shirin Hosseinmardi and Amin Yousefpour and Ramin Bostanabad},
keywords = {Topology optimization, Multi-physics, Multi-material, Neural networks, Gaussian process priors},
abstract = {Machine learning (ML) has been increasingly used for topology optimization (TO). However, most existing ML-based approaches focus on simplified benchmark problems due to their high computational cost, spectral bias, and difficulty in handling complex physics. These limitations become more pronounced in multi-material, multi-physics problems whose objective or constraint functions are not self-adjoint. To address these challenges, we propose a framework based on physics-informed Gaussian processes (PIGPs) priors. In our approach, the primary, adjoint, and design variables are represented by independent GP priors whose mean functions are parametrized via neural networks whose architectures are particularly beneficial for surrogate modeling of PDE solutions. We estimate all parameters of our model simultaneously by minimizing a loss that is based on the objective function, multi-physics potential energy functionals, and design-constraints. We demonstrate the capability of the proposed framework on benchmark TO problems such as compliance minimization, heat conduction optimization, and compliant mechanism design under single- and multi-material settings. Additionally, we leverage thermo-mechanical TO with single- and multi-material options as a representative multi-physics problem. We also introduce differentiation and integration schemes that dramatically accelerate the training process. Our results demonstrate that the proposed PIGP framework can effectively solve coupled multi-physics and design problems simultaneously–generating super-resolution topologies with sharp interfaces and physically interpretable material distributions. We validate these results using open-source codes and the commercial software package COMSOL.}
}
@article{LIANG2026119139,
title = {Topology optimization for hierarchical structures with uniform/non-uniform thickness consecutive shells through B-DGTO method},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119139},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119139},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004123},
author = {Kaixian Liang and Jikai Liu},
keywords = {B-DGTO, Shell-infill hierarchical structure, Non-uniform thickness shell, Concurrent topology optimization, Microstructures with dynamic connectivity},
abstract = {Existing topology optimization methods face challenges in extracting and optimizing structures with multiple layers of uniform/non-uniform shells, due to the curvature-related thickness errors and the involved complex filtering-projection operations. Therefore, in this study, the B-DGTO (Boundary-fitting Derivable Geodesics-coupled Topology Optimization) framework is further developed to realize the flexible optimization of hierarchical structures with uniform/non-uniform thickness consecutive shells. Subject to the B-DGTO framework, a boundary-based derivable geodesic field (i.e. a signed distance function) can be developed from the topological density field, and therefore, multiple shells with pre-assigned thicknesses can be extracted for filling with distinct solid/lattice structures. More importantly, the full sensitivity analysis is performed on the shell-related performance indexes, owing to the PDE-based derivation of the geodesic field. Compared with traditional density-based methods, the proposed approach enables improved precision in shell extraction through curvature-based thickness compensation, which addresses the long-standing limitation of fierce thickness deviation at large-curvature regions. Furthermore, variable thicknesses of the shells can be achieved by interpolating the parameter matrix of the Poisson equation for deriving the geodesic field, thus realizing the variable thickness optimization of consecutive shells. To ensure the manufacturability of hierarchical structures, minimum thickness control is applied to each material layer at the macroscale. At the microscale, an inverse homogenization method considering dynamic connectivity is employed, which guarantees connectivity among different types of microstructures while satisfying customized property requirements. Several numerical examples demonstrate that hierarchical structures with non-uniform thickness layers exhibit superior mechanical performance than the uniform thickness cases. The optimized full-scale structures can be directly fabricated by additive manufacturing, fully validating the effectiveness and robustness of the proposed B-DGTO framework.}
}
@article{HUANG2026119134,
title = {A new divergence-free virtual element method for 3D Navier–Stokes problems},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119134},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119134},
url = {https://www.sciencedirect.com/science/article/pii/S004578252600407X},
author = {Jianguo Huang and Wenxuan Wang},
keywords = {Navier–Stokes equation, Virtual element methods, Divergence-free, Error estimates},
abstract = {This paper presents a new divergence-free conforming virtual element method of order k≥1 for the 3D Navier–Stokes problem. For a polyhedron K, we introduce on each face an auxiliary triangulation formed by connecting an interior point to every vertex of that face. The proposed method combines ideas from virtual element construction and finite element methods based on this reconstructed mesh. The numerical velocity is explicitly known on all faces of polyhedrons, which facilitates efficient and parallel computation of divergence-free numerical solutions over each K while preserving global conformity. Under reasonable mesh assumptions, we establish norm equivalence, error estimates for the interpolation operator, and an inverse inequality for the underlying virtual element space. Optimal error estimates are derived for the velocity in the H1-norm and for the pressure in the L2-norm. Finally, a series of numerical experiments on different mesh types are provided to demonstrate the performance of the proposed method.}
}
@article{ASHKPOUR2026119155,
title = {Hyper-reduction of nonlinear hardening plasticity models using Petrov–Galerkin projection and gappy POD},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119155},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119155},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004287},
author = {Alireza Ashkpour and Ahmad R. Najafi},
keywords = {Reduced Order Model (ROM), Proper Orthogonal Decomposition (POD), Petrov–Galerkin projection, Nonlinear hardening plasticity, Gappy POD},
abstract = {We present a projection-based reduced-order modeling (ROM) framework for nonlinear plasticity that combines a Least-Squares Petrov–Galerkin (LSPG) formulation with hyper-reduction via the Gauss–Newton with Approximated Tensors (GNAT) method. The framework addresses both associative von Mises and non-associative Drucker–Prager formulations with nonlinear isotropic hardening. At each integration point, a local Newton–Raphson method updates the stress state and plastic multiplier using history-dependent internal variables. Dimensional reduction is achieved with Proper Orthogonal Decomposition (POD), while gappy POD, combined with a greedy sampling strategy enables reconstruction of nonlinear residuals and Jacobian actions from a subset of sampled nodes, significantly reducing online evaluations. The ROM is trained over a parameter space encompassing variations in load magnitude and six elasto-plastic material parameters. We evaluated the method on two- and three-dimensional benchmark problems, demonstrating computational speedups of up to ∼200× relative to full-order models, despite the limitations imposed by the Kolmogorov barrier. Finally, we assess the robustness of the LSPG formulation in the presence of non-symmetric, non-positive definite Jacobians arising from non-associative plasticity, showing that the proposed ROM maintains convergence under these challenging conditions.}
}
@article{LIU2026119127,
title = {Thermomechanically coupled visco–hyperelastic–plastic model with self-heating for thermoplastics},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119127},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119127},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004007},
author = {Tiansheng Liu and Junhe Cui and Anna Kantert and Majd Tabib and Nadir Kopic and Michele Valsecchi and Sanat K. Kumar and Jacob Fish and Jaan-Willem Simon},
keywords = {Thermomechanical coupling, Semi-crystalline thermoplastics, Finite-strain constitutive modeling, Visco–hyperelastic–plasticity, Self-heating, Two-potential formulation},
abstract = {Thermoplastic polymers exhibit strongly coupled finite-strain behavior involving rate dependence, crystallinity-dependent mechanical resistance, thermal softening, and mechanically induced self-heating. This work presents a rotation-free finite-strain computational formulation for thermomechanically coupled visco–hyperelastic–plastic semi-crystalline thermoplastics. The formulation is built in a corotational intermediate configuration, where plastic, hardening, and viscoelastic updates are expressed through symmetric stretch variables. This casts the time-discrete local constitutive update as a rotation-free finite-dimensional nonlinear residual at each Gauss point, compatible with automatic differentiation of consistent stress and heat-source tangent blocks without branch-specific objective-rate linearizations. Processing-informed crystallinity is prescribed as a field that modulates stiffness, yield resistance, and hardening, while a reversible/irreversible heat-source decomposition separates thermoelastic, plastic, and viscous thermal contributions. The local map is batchable over integration points and is evaluated with JAX/XLA for GPU-vectorized Gauss-point computations within a monolithic finite element setting. Comparisons with PA6 tensile experiments show that the formulation reproduces the pre-peak mechanical response and the measured temperature evolution, including the transition from initial thermoelastic cooling to dissipative self-heating without empirical cooling terms. The post-peak localization regime is retained only as a structural demonstration of the local coupled formulation and is explicitly scoped as non-mesh-objective without additional regularization.}
}
@article{CARDOSOCOELHO2026119126,
title = {A scalable composite Bayesian optimisation framework for material calibration using full-field measurements},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119126},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119126},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003993},
author = {R.P. {Cardoso Coelho} and A. Francisca {Carvalho Alves} and F.M. {Andrade Pires}},
keywords = {Inverse problems, Derivative-free optimisation, Bayesian optimisation, Full-field measurements, Finite Element Method, Parameter identification},
abstract = {Full-field measurements provide rich spatial information on heterogeneous deformation processes and have become a central ingredient in modern material parameter identification. This work develops a scalable composite Bayesian optimisation framework for response-based calibration of parametric material models using high-dimensional full-field data and expensive forward solvers. The main contribution is the extension of composite Bayesian optimisation to full-field response data, where the latent response space may contain thousands of spatial and temporal observations. To make this setting computationally tractable, the framework combines a reduced latent-space representation with efficient interpolation and data-reduction strategies, including thread-safe caching of Delaunay triangulations, localised interpolation schemes, and simplex-based decimation of reference responses. The approach is assessed on numerical and experimental calibration problems involving global and full-field response quantities, including linear elastic, elasto-plastic and nonlinear visco-elastic/visco-plastic examples. In the deterministic benchmarks considered, the composite formulation generally improves convergence behaviour and reduces parameter dispersion relative to standard Bayesian optimisation under the same evaluation budget. These results indicate that composite Bayesian optimisation provides an efficient and flexible route for exploiting high-dimensional full-field measurements in non-intrusive material calibration workflows involving computationally expensive constitutive simulations.}
}
@article{TAC2026119171,
title = {Generative AI for material design: A mechanics perspective from burgers to matter},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119171},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119171},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004445},
author = {Vahidullah Tac and Ellen Kuhl},
keywords = {Generative artificial intelligence, Diffusion models, Discrete diffusion, Continuous diffusion, Machine learning},
abstract = {Generative artificial intelligence offers a new paradigm to design matter in high-dimensional spaces. However, its underlying mechanisms remain difficult to interpret and limit adoption in computational mechanics. This gap is striking because its core tools – diffusion, stochastic differential equations, and inverse problems – are fundamental to the mechanics of materials. Here we show that diffusion-based generative AI and computational mechanics are rooted in the same principles. We illustrate this connection using a three-ingredient burger as a minimal benchmark for material design in a low-dimensional space, where both forward and reverse diffusion admit analytical solutions: Markov chains with Bayesian inversion in the discrete case and the Ornstein–Uhlenbeck process with score-based reversal in the continuous case. In both cases, forward diffusion adds noise to degrade structure, while reverse diffusion recovers structure from noise. We extend this framework to a high-dimensional design space with 146 ingredients and 8.9×1043 possible configurations, where analytical solutions become intractable. We therefore learn the discrete and continuous reverse processes using neural network models that infer inverse dynamics from data. We train the models on only 2260 recipes and generate one million samples that capture the statistical structure of the data, including ingredient prevalence and quantitative composition. We further generate five new burgers and validate them in a blinded restaurant-based sensory study with n = 101 participants, where three of the AI-designed burgers outperform the classical BigMac in overall liking, flavor, and texture. These results establish diffusion-based generative modeling as a physically grounded approach to design in high-dimensional spaces. They position generative AI as a natural extension of computational mechanics, with applications from burgers to matter, and establish a path towards data-driven, physics-informed generative design. Our source code, data, and examples are available at https://github.com/LivingMatterLab/AI4Food.}
}
@article{MEDDAHI2026119168,
title = {Hybridizable discontinuous Galerkin method for the dynamic poroelasto-acoustic problem},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119168},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119168},
url = {https://www.sciencedirect.com/science/article/pii/S004578252600441X},
author = {Salim Meddahi},
keywords = {Poroelasto-acoustic coupling, Hybridizable discontinuous Galerkin,  error estimates},
abstract = {This study introduces a hybridizable discontinuous Galerkin (HDG) method for simulating low-frequency wave propagation in coupled poroelasto-acoustic media. We present a novel variational formulation for the coupled problem and establish its well-posedness and energy stability. Optimal hp-error estimates in the energy norm are proved for the semi-discrete HDG scheme. Numerical experiments validate the theoretical convergence rates and demonstrate the effectiveness of the method in accurately capturing poroelasto-acoustic dynamics.}
}
@article{JI2026119189,
title = {Stress-based structural optimization for wrinkle suppression of membrane structures via ANCF-SRM},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119189},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119189},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004627},
author = {Yuan Ji and Jialiang Sun and Dongping Jin},
keywords = {Membrane structures, Wrinkle suppression, Structural optimization, Absolute nodal coordinate formulation, Stiffness reduction model},
abstract = {Flexible membrane structures are highly valued in aerospace applications for their lightweight properties and reliable deployment capabilities. However, their low bending stiffness renders them susceptible to wrinkling, especially under dynamic loading conditions, which undermines performance and safety. Existing design methods are often insufficient for closed inflatable systems, and direct dynamic optimization remains computationally prohibitive. To address these challenges, this study proposes an integrated design approach that originates from dynamic conditions, employs static equivalence for efficient optimization, and returns to dynamic simulation for validation. A coupled mechanical model based on the Absolute Nodal Coordinate Formulation (ANCF) and the Stiffness Reduction Model (SRM) is employed to accurately simulate nonlinear behaviors. Thicknesses are incorporated as design variables within the constitutive relations and the corresponding analytically derivable sensitivities are presented. The unified description of ANCF enables a seamless transition between this static optimization and subsequent dynamic validation analysis. The structural optimization aims to minimize compressive principal stresses while adhering to constraints on both material volume and structural compliance. Quantitative numerical results confirm that the proposed approach suppresses wrinkling while maintaining structural lightness and stiffness. The approach is applicable to both tensioned membrane structures and closed inflatable systems, providing a practical design methodology for high-performance aerospace structures with wrinkle suppression capabilities.}
}
@article{ARF2026119181,
title = {A geometrically nonlinear Reissner–Mindlin shell formulation with load-step-driven mesh adaption},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119181},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119181},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004548},
author = {Jeremias Arf and Mathias Reichle and Sven Klinkel and Bernd Simeon},
keywords = {Adaptive mesh refinement, Geometrically nonlinear Reissner–Mindlin shell formulation, Truncated hierarchical B-splines, Finite rotations},
abstract = {Beyond the analysis-suitability of a shell formulation, meaning its applicability to a wide range of scenarios, such as shells with kinks, stiffeners, or thin and moderately thick structures, there is a second aspect that is crucial for practical use: adaptive mesh refinement, allowing a significant efficiency gain. To address all these requirements, we build upon a Reissner–Mindlin shell enriched with an additional drilling degree of freedom leading to geometrically nonlinear formulation requiring only C0-regularity, an important advantage for usability. In addition, we employ a vector-like parametrization of finite rotations. This approach enables us to express all relevant quantities as functions parametrized consistently over the entire shell surface, while supporting an additive update of both, displacements and rotations. Consequently, mesh-refinement steps can be performed seamlessly as at new quadrature points required strain measures can be computed directly. The discretization follows the isogeometric analysis paradigm together with truncated hierarchical B-splines, enabling us to combine exact geometric representation with fully local mesh refinement possibilities. We propose performing load-step–driven refinement by adding new mesh elements in regions with large strain magnitudes, following a maximum mark strategy. Through a range of numerical examples, including smooth surfaces and shells with kinks, we demonstrate the suitability of the approach for integrating adaptive multi-patch isogeometric analysis with geometrically nonlinear shell formulations.}
}
@article{KATZ2026119120,
title = {LDDMM stochastic interpolants: An application to domain uncertainty quantification in hemodynamics},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119120},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119120},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003932},
author = {S. Katz and F. Romor and J.-J. Zhu and A. Caiazzo},
keywords = {Generative modeling, Blood flow modeling, Shape registration, Uncertainty quantification, Finite element method},
abstract = {We introduce a novel conditional stochastic interpolant framework for generative modeling of three-dimensional shapes. The method builds on a recent LDDMM-based registration approach to learn the conditional drift between geometries. By leveraging the resulting pull-back and push-forward operators, we extend this formulation beyond standard Cartesian grids to complex shapes and random variables defined on distinct domains. We present an application in the context of cardiovascular simulations, where aortic shapes are generated from an initial cohort of patients. The conditioning variable is a latent geometric representation defined by a set of centerline points and the radii of the corresponding inscribed spheres. This methodology facilitates both data augmentation for three-dimensional biomedical shapes, and the generation of random perturbations of controlled magnitude for a given shape. These capabilities are essential for quantifying the impact of domain uncertainties arising from medical image segmentation on the estimation of relevant biomarkers.}
}
@article{KENJO2026119157,
title = {Multi-Phase-field modeling of coupled corrosion-fatigue degradation in metallic materials},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119157},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119157},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004305},
author = {Ghandi Kenjo and Abedulgader Baktheer and Alexandros Tragoudas and Elyas Ghafoori and Fadi Aldakheel},
keywords = {Corrosion, Fatigue, Multi-phase-field, Multiphysics, Material degradation, Metals},
abstract = {Stress corrosion cracking (SCC) and fatigue are key threats to metallic structures, and their coupling accelerates damage by promoting crack initiation and growth under cyclic loading in corrosive environments, often causing premature failures. This is critical in high-safety, high-cost systems, such as offshore turbines, nuclear piping, prestressed bridges, and aerospace components. Predictive tools for combined SCC and fatigue remain limited, as conventional approaches treat them independently, leading to conservative or unsafe performance estimates. In this work, a multi-phase-field chemo-mechanical framework is proposed to model the coupled interaction between corrosion and fatigue. Specifically, two phase-fields are employed: one for corrosion front evolution, including pitting and SCC, and another for fatigue crack initiation and growth, including the pit-to-crack transition. Mechanical straining acts as an electrochemical driving force, accelerating corrosion under cyclic loading. The formulation is implemented using the finite element method with implicit time integration, with displacements, phase-fields, and ionic concentration as primary variables. A series of numerical studies demonstrates the bidirectional coupling between corrosion and fatigue. Pre-existing corrosion is shown to reduce mechanical stiffness, lower fracture strength, eliminate the fatigue crack initiation phase, and significantly shorten fatigue lifetime. Conversely, fatigue-induced cracks act as preferential pathways for corrosive species, accelerating corrosion front advancement and redirecting corrosion propagation along crack paths. High-cycle fatigue simulations further reveal a corrosion-induced downward shift of S-N curves, in qualitative agreement with experimental observations reported in the literature. Overall, the proposed framework captures key qualitative mechanisms governing corrosion–fatigue interaction across different loading regimes, providing a physics-based tool for predicting damage evolution, identifying regions prone to premature failure, and supporting durability assessment and maintenance planning of metallic structures exposed to aggressive environments. The corresponding source code in this study is openly available at https://doi.org/10.25835/2czo4jvl to support further research.}
}
@article{YANG2026119166,
title = {Generalizable latent-temporal learning for path-dependent nonlinear mechanical responses across heterogeneous microstructures},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119166},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119166},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004391},
author = {Yu-Sen Yang and Ling Guo and Xiaodan Ren},
keywords = {Microstructure-aware modeling, Path-dependent nonlinear response, Latent-temporal framework, Surrogate modeling},
abstract = {Mechanical responses of heterogeneous materials are intrinsically governed by their underlying microstructures. However, the high-dimensional and morphologically diverse nature of these microstructures poses significant challenges for accurate prediction of nonlinear, path-dependent behavior. To address this issue, we propose a generalizable latent-temporal surrogate framework for end-to-end modeling of nonlinear mechanical responses of two-phase microstructures under complex loading paths. The framework integrates a microstructure-aware latent representation module with a temporal prediction module that encodes strain-path history, enabling unified learning of microstructural and loading-history effects without relying on handcrafted descriptors. High-fidelity numerical simulations are used to construct a comprehensive dataset spanning diverse microstructures and loading conditions. Extensive evaluations demonstrate high predictive accuracy for in-distribution samples and robust generalization to unseen microstructures and loading paths. The proposed framework provides a computationally efficient paradigm for microstructure-aware modeling of path-dependent nonlinear mechanical responses in heterogeneous materials.}
}
@article{LIU2026119165,
title = {The aggregated unfitted finite element method for fully coupled poroelasticity},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119165},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119165},
url = {https://www.sciencedirect.com/science/article/pii/S004578252600438X},
author = {Zhijun Liu and Fanke Wu and Quan Jiang and Guanhua Sun and Hong Zheng and Fanyu Zhang},
keywords = {Aggregated unfitted finite element method, Aggregation/agglomeration, Extrapolation, Poroelasticity, Conditioning, Preconditioning},
abstract = {Real-world poromechanics problems often involve complex geometries with intricate features such as boundaries, interfaces, and fractures, posing significant challenges for conventional mesh-based methods like the finite element method (FEM) due to their reliance on body-fitted meshes. To alleviate the burden of generating such meshes, we propose an aggregated unfitted FEM (AUFEM) for two-field fully coupled poroelasticity. AUFEM employs a cell aggregation scheme to eliminate ill-posed basis functions by constraining unknowns through extrapolation from well-posed elements. Consequently, the approximation spaces are stable, and the Nitsche-type weak form can be formulated without additional stabilization terms, thereby avoiding the need for complex parameter tuning. We systematically derive the AUFEM formulation and propose two algorithms to construct the sub-matrices based on the matrix form of the unstabilized unfitted FEM. Additionally, three tailored block preconditioners are developed to address the ill-conditioning typically encountered in fully coupled poroelasticity. Benchmark tests demonstrate that AUFEM achieves optimal spatial and temporal convergence, remains stable even under severe mesh cutting, and produces well-conditioned linear algebraic equations due to the combined effects of AUFEM and preconditioning. The proposed AUFEM represents a significant advancement in the stability and efficiency of hydro-mechanical analyses, making it particularly suited for complex geotechnical and geological problems.}
}
@article{PANDA2026119125,
title = {Discrete elastic ribbons: A unified discrete differential geometry framework for one-dimensional energy models},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119125},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119125},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526003981},
author = {Shivam K. Panda and M. Khalid Jawed},
keywords = {Discrete elastic rods, Ribbons, Implicit integration, Bifurcation analysis, Reduced order model},
abstract = {Elastic ribbons, slender structures whose length (L), width (W), and thickness (b) satisfy L≫W≫b, exhibit mechanical behaviors intermediate between one-dimensional rods (L≫W,b) and two-dimensional plates (L,W≫b). In quadratic Kirchhoff-type rod-based frameworks, such as Discrete Elastic Rods (DER), the governing equilibrium equations are independent of width, and therefore these models cannot capture width-dependent mechanical effects. Reduced centerline-based ribbon models attempt to capture width dependence via coupled bending–twisting energies. However, their relative accuracy remains unclear due to the absence of a unified simulation framework. In this work, we formulate a framework grounded in discrete differential geometry where the energy is expressed as functions of coupled bending–twisting strain measures along the centerline, rather than a linear sum of quadratic bending and twisting energies in DER. We derive analytical gradients and Hessians of the energy that enable implicit time integration. Within this unified setting, we compare five ribbon models: Kirchhoff, Sadowsky, Wunderlich, Sano, and Audoly. As a benchmark, a straight ribbon is longitudinally constrained into a pre-buckled arch and subjected to transverse displacement, inducing a supercritical pitchfork bifurcation. Predicted bifurcation thresholds are compared against shell-based finite element simulations, with the Sano model providing the closest agreement in capturing width-dependent shifts. Our high-performance JAX-based implementation achieves O(N) per-iteration cost and also confirms that Sano model introduces negligible per-iteration overhead relative to standard DER.}
}
@article{HOANG2026119162,
title = {Multiscale structural optimization using MMBs on a truss-based ground structure},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119162},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119162},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004354},
author = {Van-Nam Hoang and H. Nguyen-Xuan},
keywords = {Multiscale design, Multiscale structural optimization, Lattice design, Truss optimization, Moving morphable bars, Topology optimization},
abstract = {This paper proposes a structural optimization approach for heterogeneous structures that combines macro-scale topology optimization with lattice-scale size optimization. The idea is to merge moving morphable bars (MMBs) with truss-based ground structures. Being different from homogenization or asymptotic global criteria methods, our approach directly maps material distributions onto discrete truss structures. As a result, computational complexity is greatly decreased, from millions of degrees of freedom (DOFs) in continuum-based formulations to only thousands of DOFs using a truss-based scheme. The key contribution of this work is a rigorous and consistent treatment of material overlap at connection nodes between heterogeneous elements. To ensure accurate material redistribution and maintain computational efficiency, the volume constraints are analytically computed with explicit consideration of material overlap. The present method optimizes both structural topology and element cross-sectional sizes simultaneously without imposing explicit local constraints. As a result, the underlying algorithm naturally filters optimal material distribution patterns across the entire structure. The high reliability of the present approach is demonstrated through several benchmark problems. The results show consistent performance improvements exceeding 30% in structural compliance compared to uniform design solutions. In addition, the method naturally accommodates high-porosity structural designs. Therefore, it is particularly suitable for additive manufacturing and biomimetic applications where hierarchical material distributions are desired. Overall, integrating the MMB model with truss-based topology optimization (TO) provides a computationally efficient framework for the design of complex heterogeneous structures across multiple scales.}
}
@article{DIJKSTRA2026119138,
title = {Structure-preserving Variational Multiscale Stabilization of the incompressible Navier–Stokes equations},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119138},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119138},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004111},
author = {Kevin Dijkstra and Deepesh Toshniwal},
keywords = {Incompressible Navier–Stokes equations, Vorticity–velocity–pressure formulation, Variational multiscale analysis, The de Rham complex, Finite element exterior calculus, Divergence-conforming discretizations},
abstract = {This paper introduces a Variational Multiscale Stabilization (VMS) formulation of the incompressible Navier–Stokes equations that utilizes the Finite Element Exterior Calculus (FEEC) framework. The FEEC framework preserves the geometric and topological structure of continuous spaces and PDEs in the discrete spaces and model, and helps build stable and convergent discretizations. For the Navier–Stokes equations, this structure is encoded in the de Rham complex. In this work, we consider the vorticity–velocity–pressure formulation discretized within the FEEC framework. We model the effect of the unresolved scales on the finite-dimensional solution by introducing appropriate fine-scale governing equations, which we also discretize using the FEEC approach. This preserves the structure of the continuous problem in both the coarse- and fine-scale solutions; for instance, both the coarse- and fine-scale velocities are pointwise incompressible. We demonstrate that the resulting formulation is residual-based, energetically stable, and optimally convergent. Moreover, our fine-scale model allows for an efficient computational approach — by decoupling fine-scale problems on one element from another, it is possible to solve them in parallel. In fact, the fine-scale equations can be entirely eliminated during matrix assembly, thereby leading to a VMS formulation where the problem size is governed by the coarse-scale discretization only. Finally, the proposed formulation applies to both the lowest regularity discretizations of the de Rham complex and high-regularity isogeometric discretizations. We validate our theoretical results through numerical experiments, simulating steady-, unsteady-, viscous-, and inviscid-flow problems, and empirically demonstrating Reynolds robustness of the formulation. These tests show that the stabilized solutions are qualitatively better than the unstabilized ones, converge at optimal rates, and, as the mesh is refined, the stabilization is asymptotically turned off.}
}
@article{ANSARI2026119154,
title = {Bridging hydrodynamics and granulation kinetics: An efficient 2D CFD-coupled compartmental PBM approach for fluidised bed granulation},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119154},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119154},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004275},
author = {Zeeshan Ansari and Mainendra Kumar Dewangan and Ashok Das and Stefan Heinrich and Rohit Ramachandran and Mehakpreet Singh},
keywords = {Wet sprayed fluidised granulation, Computational fluid dynamics, Population balance model, Coupled modelling, Particle size distribution, Finite volume scheme},
abstract = {Spray fluidised bed granulation (SFBG) is a widely used technology in the pharmaceutical, agricultural, and chemical industries to produce granules with controlled particle-size distributions (PSD) and enhanced functional properties. The present study develops an efficient coupled computational fluid dynamics (CFD)-population balance model (PBM) to optimise the SFBG process. A compartmental modelling strategy is employed to capture the evolution of PSD resulting from aggregation and breakage mechanisms in the wetting and drying compartments, respectively. The CFD model adopts an Eulerian–Eulerian formulation in a two-dimensional (2D) computational domain to estimate particle exchange rates between compartments. The two-compartment PBM is solved using a two-moment-preserving finite-volume scheme. The predictions of the present study are compared against available experimental results and previously reported computational studies. The 2D CFD model reproduces the expected pressure-drop behaviour and shows bed-expansion behaviour comparable to the reported 3D CFD results, while reducing computational cost. Within the PBM framework, several aggregation kernels are evaluated to optimise the PSD. Sensitivity analysis indicates that the size-dependent generalised shear aggregation kernel provides superior predictive performance compared with the Kapur, Brownian and other kernels. Overall, the proposed 2D coupled CFD–PBM modelling offers an accurate and computationally efficient approach for modelling and optimisation of the SFBG process compared with the existing model.}
}
@article{SU2026119178,
title = {Adaptive mesh SBFE approach for Multi-Materials Topology Optimization with different tensile and compressive properties},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119178},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119178},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004512},
author = {Rut Su and Arnut Sutha and Chongmin Song and Sawekchai Tangaramvong},
keywords = {Multi-material topology optimization, Scaled boundary finite element method, Bi-directional evolutionary structural optimization, Adaptive mesh, Composite structures},
abstract = {Conventional multi-material topology optimization (MMTO) typically distributes multiple materials within the design domain, yet explicit consideration of their strength properties remains limited. This paper presents an extended MMTO framework that integrates an image-based Scaled Boundary Finite Element Method (SBFEM) with the Multi-Materials Bi-directional Evolutionary Structural Optimization (MMBESO) algorithm. A key advantage of SBFEM is its ability to effectively address hanging-node issues. By incorporating image-processing techniques, an adaptive hierarchical-tree mesh is automatically generated to accurately capture transition regions without the need for error estimators. The proposed approach targets composite structures composed of multiple materials, each exhibiting distinct mechanical properties under tension and compression. The structure is partitioned into tensile and compressive regions using the first invariant of the stress tensor, calculated as the sum of the principal (diagonal) stresses. Materials best suited to each stress state are then selectively assigned to their respective regions. Benchmark engineering structures are used to demonstrate the method’s effectiveness. Results show that the proposed approach enables the exploration of configurations beyond single-material systems, allowing combinations of multiple materials. This leads to enhanced structural performance, improved material utilization, and reduced overall material volume, contributing to greater cost efficiency.}
}
@article{CHEN2026119142,
title = {Isogeometric boundary element methods for sensitivity analysis of polarized electromagnetic scattering from axisymmetric perfect electric conductors},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119142},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119142},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004159},
author = {Leilei Chen and Wenxiang Gu and Haojie Lian and Elena Atroshchenko},
keywords = {Electromagnetic scattering, Isogeometric boundary element method, Sensitivity analysis, NURBS, Polarization, Radar cross section (RCS)},
abstract = {This paper presents a sensitivity analysis framework based on the isogeometric boundary element method (IGABEM) for electromagnetic scattering from perfect electric conductors (PECs) under ϕˆi-polarized incidence. Non-uniform rational B-splines (NURBS) are adopted to provide an exact and unified representation of both the target geometry and the electromagnetic field variables, thereby enabling seamless integration between computer-aided design (CAD) and numerical analysis. Analytical expressions for the sensitivities of the radar cross section (RCS) with respect to shape parameters and incident wave directions are rigorously derived, and the corresponding discretized system equations are formulated within the IGABEM framework. Numerical results for a canonical conducting sphere and a geometrically complex rocket model demonstrate that the proposed method achieves accurate and efficient evaluations of both RCS and its sensitivities across a wide frequency range, exhibiting excellent numerical stability and computational efficiency.}
}
@article{RIMOLI2026119170,
title = {A finite element formulation for incompressible viscous flow based on the principle of minimum pressure gradient},
journal = {Computer Methods in Applied Mechanics and Engineering},
volume = {461},
pages = {119170},
year = {2026},
issn = {0045-7825},
doi = {https://doi.org/10.1016/j.cma.2026.119170},
url = {https://www.sciencedirect.com/science/article/pii/S0045782526004433},
author = {Julian J. Rimoli},
keywords = {Finite elements, Incompressible viscous flow, Principle of minimum pressure gradient, Rayleigh–Ritz method, Velocity-only formulation, Error estimation},
abstract = {We present a finite element formulation for incompressible viscous flow based on the principle of minimum pressure gradient (PMPG). This variational principle, recently established by Taha etal. (2023), states that the Navier–Stokes equations are equivalent to determining the rate of change ∂tv at each instant by minimizing the L2 norm of the implied pressure gradient, subject to incompressibility and boundary conditions. We discretize the PMPG functional directly using Q9 biquadratic finite elements and minimize over the nodal velocity rates (Rayleigh–Ritz). No pressure degrees of freedom appear; incompressibility and boundary conditions are enforced as linear equality constraints through a monolithic saddle-point system, whose Lagrange multipliers provide wall forces without pressure reconstruction. We verify the formulation against exact Poiseuille flow (machine-precision recovery) and the Kovasznay solution (convergence rate ∼3.3), and validate it against published benchmarks for the lid-driven cavity, the backward-facing step, and flow past a circular cylinder. The formulation produces smooth, oscillation-free solutions on coarse meshes in the convection-dominated regime without stabilization. We further show that the element-wise PMPG functional density serves as a built-in error indicator for adaptive mesh refinement, and that the stationarity condition can be read backwards to estimate the kinematic viscosity directly from velocity field measurements.}
}