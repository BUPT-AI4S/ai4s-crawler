@article{XIANG2026115632,
title = {UniNet: A real-time edge subdivision network for enhancing industrial products surface defect detection performance},
journal = {Applied Soft Computing},
volume = {201},
pages = {115632},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115632},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601080X},
author = {Zhong Xiang and Yayong Wang and Zhengkui Chen and Yatong Yu and Qiang Wu and Weitao Wu},
keywords = {Edge subdivision, Frequency analysis, Multi-scale detection, Industrial surface defect, Self-diagnosis},
abstract = {Automatic surface defect detection is crucial for ensuring industrial products’ process quality and efficiency. However, given the complex background, blurred boundaries, and wide range of geometric dimensions associated with surface defects, existing advanced inspection algorithms still face challenges such as high rates of false positive and false negative. Aim at these, a strategy that combines edge subdivision with multi-scale fusion is proposed to achieve highly accurate surface defect detection, where an Adaptive Edge Enhancement module (AEE) based on edge filters was developed at first to enhance defects’ saliency relative to their backgrounds. The AEE module incorporates: (a) a Laplacian of Gaussian (LoG) filter to enhance critical edge details often lost in blurred objects, and (b) an information filtering mechanism to suppress feature responses generated by false edges. Secondly, a Spatial-Frequency Dual Domain Downsampling (SFD3) module was designed to maintain defect feature integrity by using coupled modeling in both the frequency and spatial domains. Furthermore, an Efficient Multi-scale Layer Aggregation (EMLA) module was developed to enhance fine-grained local multi-scale representation through heterogeneous convolution kernels and gradient-path optimization, thereby improving feature reuse and inter-layer information flow, In addition, a Progressive Spatial Dilatation Pyramid (PSDP) was introduced to progressively enlarge the receptive field of deep features and aggregate multi-scale contextual semantics, thereby enabling semantic fusion from local to global regions. The experimental results demonstrate that the proposed UniNet model achieves exceptional detection performance on the FD9832, TianChi, NEU-DET, PKU-Market-PCB, and MT datasets, and its real-time performance has been validated on edge devices. These results fully validate its practical applicability in surface defect detection.}
}
@article{LI2026115734,
title = {Architecting spatial resilience: a dual-layer cognitive filtering framework for proactive edge protection in geographically exposed networks},
journal = {Applied Soft Computing},
volume = {201},
pages = {115734},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115734},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011828},
author = {Peng Li and Mingkun Jiang and Wei Wei and Tao Ma},
keywords = {Regional failures, Connectivity, Edge protection, Pruning tree, Prime frame},
abstract = {In the face of the persistent network threat posed by random geographical failures, traditional defense mechanisms often struggle to balance efficiency and effectiveness. In this paper, we propose a dual-layer filtering edge protection algorithm (DLFP) based on an optimal pruning tree and a prime frame for random regional network failures. The algorithm identifies and protects critical edges through two key mechanisms: an optimal pruning tree that dynamically marks candidate core cut edges and a prime frame that enables lightweight optimization on a compressed graph containing only core edges. Experimental results demonstrate: (1) 100% robustness in dense graphs with millions of nodes; (2) processing time of 55 s (reduced to under 10 s with parallel optimization); (3) defense cost of only 20% of total cost. Comparative analysis reveals: (1) a defense success rate of 99.8% under ten consecutive attacks versus only 0.6% for traditional heuristic methods; (2) computation speed one million times faster than mixed-integer linear programming (MILP) methods on small-scale graphs. These results fully demonstrate the algorithm’s significant potential in complex network protection.}
}
@article{QIAO2026115645,
title = {A reference vector-guided many-objective evolutionary algorithm based on an adaptive adjustment strategy},
journal = {Applied Soft Computing},
volume = {201},
pages = {115645},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115645},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010938},
author = {Baihao Qiao and Rongrong Bai and Ziru Feng and Boyang Qu and Li Yan and Hejuan Hu},
keywords = {Many-objective optimization, Diversity maintenance, Convergence promotion, Adaptive adjustment},
abstract = {In recent years, numerous many-objective evolutionary algorithms (MaOEAs) have been developed to solve objective conflicts. However, as the number of objectives scales, effectively managing the inherent trade-off between diversity preservation and convergence efficiency in MaOEAs remains a persistent challenge. Therefore, we propose a reference vector-guided many-objective evolutionary algorithm based on an adaptive adjustment strategy (RVEAADS) to dynamically regulate exploration and exploitation trade-offs. In RVEAADS, the population is divided into two subpopulations, and a predefined proportion of individuals that are superior in performance are archived to ensure that the solution set converges to the Pareto optimal frontier. Subsequently, the inferior individuals use the reference vector to guide the selection of elite individuals, and implement an adaptive adjustment combining the diversity maintenance strategy and the convergence promotion strategy for the population after the guided selection, avoiding the problem of insufficient solutions and further balancing the convergence and diversity of the population. In addition, the diversity maintenance strategy can retrieve excellent solutions in the partial space twice to fill the insufficient number of solutions, and the convergence promotion strategy can avoid the loss of solutions with significant convergence performance. Finally, the proposed RVEAADS is compared with state-of-the-art algorithms on 25 test problems, and the experimental results indicate the competitiveness of the proposed algorithm.}
}
@article{ZHAO2026115637,
title = {Residual attention network for audio-based speech emotion recognition},
journal = {Applied Soft Computing},
volume = {201},
pages = {115637},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115637},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010859},
author = {Puyang Zhao and Huiyun Zhang and Zhiyi Yue and Zongjin Li and Nan Mi and Xinhui Liu},
keywords = {Speech emotion recognition, Deep learning, Residual attention network, Nonlinear feature extraction, Audio signal analysis},
abstract = {Speech emotion recognition (SER) remains challenging because emotional speech contains nonlinear acoustic patterns, temporal dependencies, and substantial variability across speakers and corpora. To address these challenges, we propose a Convolutional Long Short-Term Memory Multi-Head Attention Residual (CLMR) network for SER. CLMR integrates a customized Gaussian Error Linear Unit (Custom GELU), LSTM-based temporal modeling, multi-head attention, and residual convolutional learning to capture nonlinear, sequential, contextual, and hierarchical emotional cues. In addition, a 121-dimensional feature representation combining conventional acoustic descriptors and nonlinear measurements is constructed to enrich the characterization of emotional speech. The proposed method was evaluated on four benchmark datasets with different languages and recording conditions, namely EMODB, SAVEE, CASIA, and BodEMODB. Across ten runs, CLMR achieved average accuracies of 96.11% on EMODB, 75.62% on SAVEE, 89.58% on CASIA, and 90.87% on BodEMODB. Ablation studies further show that the Information Coding module, LSTM, multi-head attention, residual connections, and Custom GELU each contribute to the overall recognition performance. Compared with peer models reported on the same benchmark datasets, CLMR achieved competitive or improved accuracy, particularly on EMODB and BodEMODB. These findings suggest that the performance gains arise from the complementary integration of nonlinear feature representation, temporal-attentional modeling, and residual convolutional learning. Overall, the proposed framework provides a practical and extensible approach for benchmark SER tasks.}
}
@article{ZIA2026115679,
title = {Two-level violence incitation detection in urdu using explainable hybrid deep learning model},
journal = {Applied Soft Computing},
volume = {201},
pages = {115679},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115679},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011270},
author = {Rameesha Zia and Muhammad Shahid Iqbal Malik},
keywords = {Violence incitation, Urdu, Multi-level, Explainable AI, Bi-LSTM, Attention mechanism},
abstract = {Social media platforms have become major spaces for public expression, but they are also increasingly misused to spread harmful content, including violence-inciting messages. Research on detecting such content remains very limited, especially for low-resource languages like Urdu. To address this gap, we propose an explainable deep learning framework for two-level violence-incitation detection in Urdu tweets. The framework integrates Multi-lingual Robustly Optimized BERT (XLM-RoBERTa) embeddings, a Bidirectional Long Short-Term Memory (BiLSTM) network, an attention mechanism, and the Local Interpretable Model-Agnostic Explanations (LIME) method to improve both classification performance and interpretability. We also construct a new manually annotated Urdu tweet dataset for hierarchical classification. At the first level, the model distinguishes between violence-inciting and non-violence content, while at the second level, violence-inciting tweets are further categorized into six subtypes. The proposed approach achieves benchmark performance, with macro F1-scores of 95.86% and 90.49% for the first and second levels, respectively, consistently outperforming state-of-the-art baselines. The integration of LIME provides meaningful word- and phrase-level explanations, enhancing transparency and trust in the model’s predictions. These findings demonstrate that the proposed framework is both effective and interpretable, offering a practical solution for automated content moderation and early risk detection in low-resource language settings.}
}
@article{RONG2026115768,
title = {Decentralized federated learning with credit-driven incentive mechanism for wind power prediction},
journal = {Applied Soft Computing},
volume = {201},
pages = {115768},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115768},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012160},
author = {Jieqi Rong and Yijun Cheng and Heng Li and Fu Jiang and Yingze Yang},
keywords = {Microgrid, Blockchain, Wind power prediction, Incentive mechanism, Decentralized federated learning},
abstract = {The wind power prediction using federated learning suffers from low participation of microgrids and the single point of failure of the aggregator. To mitigate these two challenges, a decentralized federated learning framework with a credit-driven incentive mechanism for wind power prediction is proposed. Firstly, the computational ability, data quality, and reputation are normalized into a credit score using a multi-weight trust model to measure the reliability of microgrids. A microgrid selection method based on credit is deployed on the blockchain to incentivize high-quality microgrids to participate in federated learning. Secondly, to solve the single point of failure problem, a decentralized federated learning architecture that replaces the central aggregator with blockchain is proposed. A believability-aware PBFT consensus deployment (BPBFT) is introduced, where the consensus committee is dynamically formed based on computational capability and reputation. Finally, the proposed method is validated on the GEFCom wind-power dataset. Experimental results show that the proposed method outperforms the state-of-the-art baseline, achieving average reductions in MAE and RMSE of approximately 3.82% and 3.29% across three datasets, respectively. Moreover, simulations confirm that the BPBFT consensus mechanism enhances both efficiency and robustness, achieving a high consensus success rate and reduced consensus time compared to traditional PBFT.}
}
@article{YU2026115760,
title = {PA-FedVL: A privacy-enhanced federated virtual learning framework based on label differential privacy distillation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115760},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115760},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012081},
author = {Yuanxi YU and Ying Wang and Bo Gong},
keywords = {Privacy-Augmented Federated Virtual Learning, Federated Learning, Dataset Distillation, Adaptive Privacy Allocation, Backdoor Robustness},
abstract = {Federated learning under Non-IID heterogeneity faces coupled challenges of utility degradation and privacy/security leakage, where privacy noise may further destabilize representation alignment. We propose PA-FedVL, a privacy-augmented federated virtual learning framework that unifies local–global dataset distillation with two co-designed components: Adaptive Label Differential Privacy Optimization (ALDPO) and a Global Virtual Anchor (GVA). ALDPO provides an ε label-local differential privacy guarantee for the supervision channel via randomized label perturbation, and adaptively schedules the perturbation strength using an on-device heterogeneity proxy derived from mini-batch MMD, prioritizing stable alignment for highly heterogeneous clients to prevent early-stage feature collapse. GVA is optimized on the server as a shared virtual anchor to align client representations while reducing variance induced by label noise. On 57 clients with Dirichlet partition across DIGITS, CIFAR-10-C, and RETINA, PA-FedVL achieves 87.1% accuracy on Non-IID DIGITS and maintains 83.8% utility under a strict privacy regime (ε = 1.0), outperforming gradient-based DP baselines by > 8.5%. Security evaluations show up to 6.4 × higher reconstruction error against gradient inversion, near-random membership inference AUC (0.46), and an average 38.8% reduction in backdoor attack success rate. We further discuss computation/communication trade-offs and scalability for resource-limited edge deployments.}
}
@article{CHEN2026115698,
title = {A lightweight spatial-temporal network with frequency-range fusion for edge-enabled FMCW radar human activity recognition},
journal = {Applied Soft Computing},
volume = {201},
pages = {115698},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115698},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011464},
author = {Kaiyu Chen and Xiafeng Zhang and Hao Zhang},
keywords = {Edge computing, Human activity recognition, FMCW radar, Lightweight transformer, Embedded sensing},
abstract = {In internet of things (IoT) applications, contactless human activity recognition (HAR) is crucial in scenarios such as smart healthcare, elderly monitoring, and intelligent security. However, existing deep learning methods for FMCW radar-based HAR generally have high computational complexity and memory usage, making them difficult to deploy on resource-constrained IoT edge devices, and they lack robustness in handling cross-scenario and noisy environments. This paper proposes lightweight frequency-range map based spatio-temporal network (LFRST) to address these limitations. Specifically, our approach involves: (1) Time-frequency analysis is applied to convert non-stationary radar echoes into structured range-Doppler spectrograms, effectively capturing motion signatures across frequency, range, and temporal domains; (2) designing a 16 × 16 large-stride patch embedding layer to not only reduce token count but also expand receptive fields for enhanced feature representation; and (3) introducing an efficient single-head self-attention (SHSA) mechanism, rather than multi-head self-attention in standard Transformers, to reduce structural complexity and memory access overhead. LFRST achieves 99.3% accuracy on six human activities in a complex office scenario and is further validated on the mmDoppler and DIAT-μRadHAR datasets through cross-domain experiments. Additionally, extensive evaluations demonstrate that LFRST outperforms state-of-the-art methods in terms of accuracy-speed trade-off. Importantly, LFRST successfully deploys on Raspberry Pi 4B achieving 46 FPS at 2.6 W, as well as on Jetson Nano and STM32H7 MCU, showcasing its versatility across different IoT hardware environments.}
}
@article{ZHA2026115682,
title = {Active preference learning for spatially dependent multi-attribute decision-making: An uncertainty–balance based preference elicitation approach},
journal = {Applied Soft Computing},
volume = {201},
pages = {115682},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115682},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011300},
author = {Quanbo Zha and Yueying Ren and Jianping Gu},
keywords = {Spatial multi-attribute decision making, Spatial dependence, Preference learning, Active learning, Incremental preference elicitation},
abstract = {Existing spatial multi-attribute decision-making (SMADM) methods for regional sorting often suffer from low accuracy and efficiency. This is mainly due to the neglect of spatial dependence and cognitively demanding batch preference elicitation. To address these issues, this study proposes a novel SMADM model termed Dynamic Spatial Preference Learning for Sorting (DSPL-S). The model integrates explicit spatial-dependence modeling with active-learning based incremental preference elicitation for regional sorting. Specifically, the method explicitly quantifies spatial dependence among regions via a double-squared-kernel based spatial weight matrix. To mitigate elicitation inefficiency, a KL-divergence based dynamic switching mechanism is introduced. It integrates uncertainty-based sampling and category-balance principles, and switches between the two strategies during learning according to category imbalance severity. This ensures balanced category coverage and efficient learning. Computational experiments on simulated datasets show that the proposed DSPL-S improves sorting accuracy compared with uncertainty-based sampling alone. Sensitivity analyses further examine the effects of key parameters and termination criteria, guiding real-world applications. Overall, the proposed framework provides a unified solution for regional sorting applications.}
}
@article{ABBU2026115701,
title = {Ego-centric congestion understanding from multi-camera traffic scenes: A benchmark dataset and graph reasoning approach for autonomous vehicles},
journal = {Applied Soft Computing},
volume = {201},
pages = {115701},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115701},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601149X},
author = {Soumya Abbu and Naveen Kumar Kummari and Sobhan Babu and Linga Reddy Cenkeramaddi and Krishna Mohan Chalavadi},
keywords = {Autonomous vehicles, Traffic congestion states, Multi-camera fusion, Spatio-temporal features, Congestion classification},
abstract = {The rapid advancements in autonomous vehicles (AVs) highlight the need for robust perception and planning systems to navigate complex traffic scenarios. AVs rely on congestion state estimation to assess real-time traffic, optimize routes, and navigate safely in dynamic environments. Accurate congestion estimation faces challenges like dynamic conditions and scaling to process large urban traffic data. Existing methods use spatio-temporal graph models with LiDAR or cameras. While LiDAR offers high accuracy, its cost makes camera-based systems a viable alternative. Single-camera setups are limited by narrow fields of view and incomplete coverage, highlighting the need for multi-camera approaches that enhance coverage and scalability. In this work, an ego-centric perspective on traffic scene understanding is adopted, where congestion is defined relative to the autonomous vehicle’s immediate surroundings rather than global traffic flow. Grounded in this perspective, an end-to-end Autonomous Vehicle Congestion State Classification Network (AVCSCNet) is proposed using the past-and-future reasoning for tracking (PF-Track) backbone to generate bird’s-eye view (BEV) visualizations of multi-camera inputs. BEV data is transformed into 2D spatio-temporal graphs, with the ego vehicle and surrounding agents as nodes and edges representing relationships. Further, GNNs are employed for spatial feature extraction, followed by LSTMs for traffic state classification into: Congested, Neutral, and Free-flow. In addition, we introduce the Autonomous Vehicles Congestion 3 (AVCong3) dataset, featuring manually annotated spatio-temporal graphs generated using multi-camera data and three traffic classes. Extensive experiments on AVCong3 and PREVENTION datasets demonstrate the effectiveness and scalability of the AVCSCNet framework. In particular, AVCSCNet achieves 86.6% congestion classification accuracy using six cameras, significantly improving from 68.3% with a single camera setup, while also demonstrating promising generalization on the PREVENTION dataset with 78.05% accuracy.}
}
@article{CHEN2026115690,
title = {Solving order fluctuations for dynamic scheduling of distributed hybrid flow shop by deep reinforcement learning},
journal = {Applied Soft Computing},
volume = {201},
pages = {115690},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115690},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011385},
author = {Xin Chen and Yibing Li and Lei Wang and Kaipu Wang and Jun Guo and Zao Liu},
keywords = {Mass personalized manufacturing, Dynamic distributed hybrid flow shop, Order fluctuations, Deep reinforcement learning},
abstract = {With the improvement of economic levels, consumers have a stronger demand for personalized products, and mass personalized manufacturing (MPM) has emerged. However, customer orders’ dynamic fluctuations would reduce the production efficiency, and dramatically increase the difficulties of scheduling in MPM. In the real manufacturing environment, once the customer’s order quantity is adjusted or temporarily canceled, the original scheme should be rescheduled in a timely manner. Thus, this paper solves order fluctuations for the dynamic scheduling of the distributed hybrid flow shop problem (DDHFSP-OF) and employs deep reinforcement learning to optimize the total tardiness time. First, the matching model of the DDHFSP-OF is formally established, and an order modularization equal-size sublot method is proposed. Then, the training and execution procedures of DQN, DDQN, and PPO algorithms are introduced in detail. In addition, the architecture of DDQN-based DDHFSP-OF is designed to contain eight state features, six dispatching rules, and a novel reward function. Furthermore, three efficient DRLs are used to train the scheduling agent, and 20 improvement instances with different production configurations and an enterprise case toward MPM are compared. The results show that our architecture of DDQN can obtain better superiority and generality than the other comparison algorithms. Thus, it’s a new technique to address dynamic scheduling problems, especially for DDHFSP-OF in the context of MPM.}
}
@article{NUNES2026115666,
title = {Application of ARIMA-ANFIS hybrid models in electrical energy demand forecasting: a systematic review},
journal = {Applied Soft Computing},
volume = {201},
pages = {115666},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115666},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011142},
author = {Gerson dos Santos Nunes and Tiago da Cruz Asmus and Viviane Leite Dias {de Mattos} and Graçaliz Pereira Dimuro},
keywords = {Time series, Energy consumption forecast, Statistical models, Machine learning models, Adaptive neuro-fuzzy systems, Hybrid models, ARIMA–ANFIS},
abstract = {One of the most important sectors for a country’s economic development is the electricity sector, especially the ability to forecast demand. In this sense, some modeling techniques have been highlighted, such as those based on statistical techniques and Machine Learning, which can be used individually or in combination. Then, any research proposing new (hybrid) models must first rely on previous knowledge about the subject to find out in which cases it is possible to use hybrid models (e.g., Autoregressive Integrated Moving Average (ARIMA) used jointly with Adaptive Neuro-Fuzzy Inference System (ANFIS)) to forecast electricity demand, what benefits those methods can bring to this problem, and how to carry out this hybridization. Additionally, it is important to explore the data to be used and to determine what the most common adjustment and evaluation metrics are. The objective of this paper is to present a systematic review of the subject, considering the databases “Scopus”, “EBSCO”, “Dimensions”, and “Web of Science”, performing a bibliometric and qualitative content analysis of the selected articles while making comments on each one of them. Based on the literature review, it was concluded that hybrid models, particularly ARIMA-ANFIS models, are not only recommended for forecasting electricity demand, but they also usually improve the performance of the adjustment and prediction of such forecasting models, benefiting from the ability to model both the linear and nonlinear components of the time series.}
}
@article{JIN2026115710,
title = {Chance constraint-based dependent task offloading for multi-access edge computing under uncertainty},
journal = {Applied Soft Computing},
volume = {201},
pages = {115710},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115710},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011580},
author = {Xiaomin Jin and Jingbo Wang and Zhongmin Wang and Yanping Chen},
keywords = {Multi-access edge computing, Cloud-edge-end collaboration, Task offloading, Task dependency, Uncertainty},
abstract = {As a novel computing paradigm, multi-access edge computing (MEC) empowers resource-constrained mobile terminals with robust and versatile computational capabilities. However, the development of precise offloading strategies, which determine the execution location for tasks, remains a prominent and unresolved challenge for MEC. The real-life MEC environment is characterized by its non-ideal and uncertain nature. In progressively sophisticated applications, intricate dependency relationships among their tasks continuously intensify. These factors significantly amplify the challenges associated with developing efficient offloading strategies. In this paper, we study the dependent task offloading problem for MEC under uncertainty with joint consideration of concurrent multi-path transmission, task caching, and privacy protection. Firstly, we employ stochastic numbers to effectively characterize uncertainties and formulate the task offloading problem as a constrained stochastic joint optimization model. We establish an uncertain joint optimization model to formulate the problem of dependent task offloading in MEC under uncertainty and prove its NP-hardness. The established model focuses on optimizing the joint strategy to achieve the objectives of reducing latency, decreasing energy consumption, and enhancing task utility. Secondly, we decompose the model into two chance-constrained sub-problems and propose a hybrid two-layer offloading algorithm that combines an improved genetic algorithm, Monte Carlo simulation, and artificial neural networks to solve the joint strategy. The proposed algorithm leverages the collaborative synergy between inner and outer layers to solve the joint strategy. The experimental results demonstrate that the established model exhibits significant effectiveness in reducing the objective value, achieving a 34.53% decrease in the objective value compared to local execution. Our offloading algorithm surpasses existing algorithms and attains an average reduction of at least 20.34% in the objective value.}
}
@article{DANG2026115702,
title = {DeepCosineMNet: Few-shot learning with deep supervision based on KAN-mixer and sobel-guided feature ensembling and cosine similarity metric for bearing fault diagnosis},
journal = {Applied Soft Computing},
volume = {201},
pages = {115702},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115702},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011506},
author = {Hong-Anh Dang and Quoc-Anh Pham and Thi Hue Nguyen and Thi-Thao Tran and Van-Truong Pham},
keywords = {Bearing fault diagnosis, Few-shot learning, KAN, Edge detector, Cosine similarity metric, Covariance metric neural network},
abstract = {Bearings are important components in rotating machinery, under harsh and continuous working environments, it is very susceptible to failure, leading to losses in maintenance costs as well as deterioration in machine performance. Bearing fault diagnosis has been applied using machine learning and deep learning through converting the signal to spectral maps, but these methods still require large amounts of data for effective diagnosis. Moreover, most of the current methods rely only on the last layer of learnable feature extraction modules to handle the diagnosis, raising the question of whether they are missing any major details. To solve this problem, we propose a new end-to-end Few-Shot learning framework, DeepCosineMNet for effective bearing fault diagnosis even under limited data conditions. The recommendation framework is built on a deep supervision architecture combined with attention mechanisms and incorporates information with Sobel-guided and Kolmogorov-Arnold Network (KAN)-mixer to effectively extract features of the spectral maps, thus enhancing model performance. Moreover, we propose a novel classification module, namely Cosine Similarity Quadratic Form Metric that measures the correlation between queries and support based on the cosine similarity. Extensive experiments on Paderborn University (PU), Case Western Reserve University (CWRU), and Sensing Lab Bearing Fault Diagnosis (SURF) datasets, evaluated by averages across experiments such as Accuracy, Recall, and values that fluctuate around the mean demonstrate that the proposed DeepCosineMNet is more effective than existing Few-Shot learning methods for bearing fault diagnosis.}
}
@article{ZHANG2026115633,
title = {Toward resilient Chinese cyberbullying detection: A pinyin and adversarial learning framework},
journal = {Applied Soft Computing},
volume = {201},
pages = {115633},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115633},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010811},
author = {Wenjing Zhang and Zhibin Sun and Yuhan Li and Longyu Dai and Hazrat Bilal and Sarra Ayouni and Thippa Reddy Gadekallu},
keywords = {Adversarial machine learning, Cyberbullying detection, Chinese text processing, Deep neural networks, Pinyin vectorization, Phonetic normalization, Robust natural language understanding},
abstract = {Cyberbullying detection in Chinese social media presents unique linguistic and computational challenges due to the widespread use of homophones, tonal variations, and adversarial text perturbations that obscure abusive intent. Conventional character- or semantic-based models often struggle to identify such phonetic disguises, limiting robustness in real-world applications. To address this issue, this paper proposes a Pinyin-based adversarial learning framework that encodes Chinese characters into structured phonetic vector representations, explicitly preserving pronunciation features. A phonetic dictionary optimization strategy consolidates homophonous entries using a Minkowski-distance threshold, reducing lexical redundancy by 33% while maintaining discriminative capacity. A similarity-driven perturbation correction mechanism further mitigates homophone-based adversarial manipulation through threshold-controlled normalization. The phonetic representations are integrated with semantic embeddings and evaluated across RNN, CNN, and BERT architectures to ensure architecture-independent validation. Experimental results on the Weibo_Senti_100K dataset demonstrate that the BERT + Pinyin model achieves strong classification performance (Accuracy 0.98, F1 0.98, AUC 0.98) and maintains high robustness under adversarial perturbations, outperforming semantic-only transformer baselines. These findings indicate that incorporating structured phonetic modeling enhances resilience against pronunciation-preserving obfuscation and provides a practical solution for robust Chinese cyberbullying detection.}
}
@article{ZHU2026115673,
title = {A surrogate-assisted evolutionary algorithm based on problem reconstruction and feature extraction for high-dimensional expensive multi-objective optimization problems},
journal = {Applied Soft Computing},
volume = {201},
pages = {115673},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115673},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601121X},
author = {Xiangyang Zhu and Yu Xue and Lanlan Ping and Ali Wagdy Mohamed and Romany F. Mansour},
keywords = {Expensive optimization, Surrogate-assisted optimization, Problem reconstruction, Feature extraction},
abstract = {Expensive multi-objective optimization problems (EMOPs) are prevalent in the field of engineering design, where a single function evaluation consumes substantial computational resources or incurs significant costs. Although numerous surrogate-assisted evolutionary algorithms (SAEAs) have been proposed to solve these problems, existing SAEAs struggle to balance convergence, diversity, and computational efficiency when dealing with high-dimensional EMOPs. Therefore, we propose a two-stage SAEA, namely PRSALEs. The first stage primarily performs problem reconstruction in the decision subspaces obtained through variable grouping, transforming the multi-objective optimization problem with high-dimensional decision variables into a single-objective optimization problem with low-dimensional weight variables. It aims to quickly find solutions near the Pareto front (PF). The second stage designs a SAEA based on problem decomposition and feature extraction, where uniformly distributed weight vectors can enhance population diversity, and feature extraction can preserve the prediction accuracy of the surrogate model. Ultimately, the population can be evenly distributed around the PF. The proposed algorithm is compared with five state-of-the-art SAEAs on benchmark test suites and real-world problems. Experimental results demonstrate that the proposed algorithm can obtain solutions with good convergence and diversity.}
}
@article{TANG2026115694,
title = {Spatio-temporal distinguishability modeling for traffic flow prediction},
journal = {Applied Soft Computing},
volume = {201},
pages = {115694},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115694},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011427},
author = {Jiawei Tang and Ruiqin Wang and Qing Shen and Xuxiang Huang and Jungang Lou},
keywords = {Traffic flow prediction, Spatio-temporal indistinguishability, Graph convolutional network, Pre-training model},
abstract = {As a key technology in intelligent transportation systems, traffic flow prediction supports a system’s intelligent operation and management. However, accurate traffic flow prediction is highly challenging due to the indistinguishability of traffic time series in the spatio-temporal dimension. Existing works often design complex spatio-temporal network structures but overlook the granularity of parameter space sharing. In this paper, we argue that learning node-specific patterns is crucial for traffic flow prediction and that it is necessary to introduce domain knowledge to enhance model learning capabilities. Based on these ideas, we develop a Distinguishable Spatio-Temporal Network(DISTNet) for accurate traffic flow prediction. Specifically, in the temporal dimension we introduce a multidimensional temporal embedding to enhance the learning of temporal attention mechanism, and in the spatial dimension we combine the advantages of a graph convolution with those of having node-specific parameters. We conduct extensive and diverse experiments on six real-world datasets, and we find that the proposed model outperforms existing models. Moreover, through a series of qualitative evaluations, we demonstrate that our proposed model strikes a balance between efficiency and performance.}
}
@article{HOSSAIN2026115662,
title = {SAIC: A spatially aware image captioning framework integrating visual and geometric features},
journal = {Applied Soft Computing},
volume = {201},
pages = {115662},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115662},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011105},
author = {Mohammad Alamgir Hossain and Md. Bipul Hossen and ZhongFu Ye and Md. Atiqur Rahman and Md. Shohidul Islam and Md. Ibrahim Abdullah},
keywords = {Image captioning, ResNet-101 global features, Faster R-CNN region features, Object-level geometric cues},
abstract = {Image captioning aims to generate accurate and contextually rich natural-language descriptions from visual content. In this work, we propose Spatially Aware Image Captioning (SAIC), an LSTM-based captioning framework that integrates pre-extracted Faster R-CNN region features, ResNet-101 global visual features, and projected geometric cues derived from individual bounding boxes. The geometric branch encodes object-level position and shape information for multimodal fusion, but it does not construct explicit pairwise geometric relations such as inter-object distances or angles. To combine these modalities, SAIC uses a Geometric Attention Mechanism, Dot-Product Attention with Memory Enhancement, and a Low-Rank Attention with Spatial-Channel Refinement module before LSTM decoding. The low-rank block is included as an architectural design choice inside SAIC; however, no matched full-rank-versus-low-rank timing or FLOPs comparison was conducted, and we therefore do not claim an overall efficiency advantage over transformer-based captioning models. We additionally report the hyperparameter tuning procedure, hardware settings, wall-clock training time, model parameter count, and end-to-end evaluation runtime to improve reproducibility and computational transparency. We evaluate SAIC on the MS COCO 2014 dataset, where the CIDEr-optimized version achieves a BLEU-4 score of 40.1 together with strong METEOR, CIDEr, and SPICE scores. We further perform paired bootstrap resampling to assess the gain from cross-entropy training to CIDEr optimization, and we summarize three independent runs of the full SAIC model through mean ± standard deviation over the primary captioning metrics. These results position SAIC as a competitive and methodologically informative framework for studying structured multimodal fusion in supervised image captioning, while comparisons against external baselines are interpreted conservatively as point-estimate comparisons unless statistical significance is explicitly reported. The code for SAIC is publicly available at https://github.com/alamgirustc/SAIC.}
}
@article{SAKTHIVEL2026115714,
title = {Disturbance observer-based proportional retarded sampled-data control for T-S fuzzy cyber-physical systems subject to random cyber-attacks},
journal = {Applied Soft Computing},
volume = {201},
pages = {115714},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115714},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011622},
author = {N. Sakthivel and S. Keerthna},
keywords = {T-S fuzzy cyber-physical systems, Time-varying delay, Proportional retarded sampled-data control, Disturbance observer, Random cyber-attacks},
abstract = {This article addresses the problem of disturbance observer-based control for T-S fuzzy cyber-physical systems (TSFCPSs) with time-varying delay and external disturbance. In contrast to the conventional sampled-data method, a proportional retarded sampled-data control incorporates time-varying delay during data transmission which is unique to tackle the stability analysis of closed-loop TSFCPSs. Using Lyapunov-Krasovskii functional, some sufficient criteria are acquired in terms of linear matrix inequalities (LMIs). Additionally, the stability of TSFCPSs could be affected when attackers inject misleading signals into the controller. To address this issue, a secure control strategy is designed to mitigate the effects of deception attacks and its probability of occurrence is assessed by Bernoulli random variable. Meanwhile, the efficacy of designed disturbance observer-based proportional retarded sampled-data control technique with random cyber-attacks for TSFCPSs is demonstrated through illustrative examples including mass-spring damper system.}
}
@article{SHI2026115738,
title = {Robust optimization for two-echelon truck and drone collaborative delivery in emergency relief: Mathematical formulation and heuristic algorithm},
journal = {Applied Soft Computing},
volume = {201},
pages = {115738},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115738},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011865},
author = {Yong Shi and Qin Guo and Peng Pan and Miao Chen and Yang Wu and Haixiang Guo},
keywords = {Emergency supplies dispatch, Trucks and drones, Multi-objective evolutionary algorithms, Robust optimization},
abstract = {Emergency supplies dispatch is crucial for post-disaster recovery. This study proposes a novel two-echelon truck-drone collaborative delivery model for emergency supplies dispatch. The system consists of a trunk network where large trucks handle consolidation and resupply, and a last-mile network where small trucks and drones collaboratively deliver to affected sites. Distinct from the majority of truck–drone collaborative delivery studies that emphasize single-echelon and deterministic scenarios, this study simultaneously considers demand fluctuations and road disruption risks. A robust optimization framework based on uncertainty sets is further developed, leading to a mixed-integer programming model that jointly minimizes time and cost. Given the NP-hard nature of the proposed model, this study designs a hybrid multi-objective evolutionary algorithm integrating Tabu Search (TS) and Non-Dominated Sorting Genetic Algorithm (NSGA-II), incorporating local search operators tailored to the problem characteristics. Comparative analysis of the proposed algorithm against the Gurobi solver across 21 small-scale instances validated the effectiveness of both the model and algorithm. Furthermore, 20 medium-to-large-scale instances demonstrated that the Tabu Search algorithm and local search operators enhance the performance metrics of the NSGA-II. Additionally, 20 medium-to-large-scale test instances evaluated the difference in solution robustness between the deterministic model and the robust model. Results indicate that the robust model achieves a 44.67% higher average solution feasibility rate than the deterministic model. Finally, the model and algorithm were applied to solve an emergency material dispatch case study during the earthquake disaster that occurred in Sichuan in China, demonstrating their strong adaptability and practical value.}
}
@article{LI2026115654,
title = {Enhancing causal structure learning with adaptive local-to-global skeleton construction},
journal = {Applied Soft Computing},
volume = {201},
pages = {115654},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115654},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011026},
author = {Tianci Li and Debo Cheng and Zhangling Duan and Zhaolong Ling},
keywords = {Bayesian networks, Graphical models, Causal structure learning},
abstract = {Local-to-global causal graph structure learning is an important problem in causal discovery. However, current state-of-the-art local-to-global learning algorithms require strong path assumptions for adaptive causal skeleton construction, which limits their ability to handle collider structures and consequently affects their generalization and accuracy. To address this issue, we theoretically analyze the local score relationship between a target node and its causal and non-causal nodes under the separation set and propose an adaptive local-to-global causal structure learning algorithm, Adapt-CSL. Specifically, Adapt-CSL employs a score-based approach to adaptively select between the AND-rule and OR-rule for causal structure learning without requiring path assumptions. Moreover, Adapt-CSL can better handle collider structures, thereby improving its generalization and accuracy. We evaluate Adapt-CSL on benchmark Bayesian network datasets and compare it with eight state-of-the-art competitors. The results show that Adapt-CSL outperforms existing local-to-global and global causal structure learning algorithms.}
}
@article{MAHANTA2026115706,
title = {A parameterized distance with application in pattern classification and medical waste management technique selection in Pythagorean fuzzy domain},
journal = {Applied Soft Computing},
volume = {201},
pages = {115706},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115706},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011543},
author = {Juthika Mahanta and Subhasis Panda},
keywords = {Pythagorean fuzzy set, Parameterized distance, Medical waste treatment technique, Multi-criteria decision-making, Pattern recognition, TOPSIS, Entropy measure},
abstract = {This article introduces a parameterized distance function and an associated entropy measure for Pythagorean fuzzy sets (PFSs). Axiomatic definitions for both measures are formally established. The key advantages of the proposed metric are: (i) it effectively differentiates highly hesitant PFSs in comparison to classic ones, and (ii) it accurately differentiates other PFSs as well. The superiority of the measure is established via geometrical representation and numerical examples. A comprehensive sensitivity analysis with respect to the parameter involved in the metric demonstrates the robustness and reliability of the proposed definition. Finally, the introduced distance measure is applied to pattern classification and a hybrid multi-criteria decision-making problem with real data. The outcome remains invariant with respect to variation in the parameter in both cases. In the case of pattern recognition, our measure outperforms others with the highest degree of confidence. In the context of the decision-making process, the introduced entropy measure is employed to calculate the criteria weights. Subsequently, the distance function is utilized in the Technique for Order of Preference by Similarity to Ideal Solution (TOPSIS) method to rank the alternatives for medical waste treatment techniques. The comparative analysis establishes that the best alternative, namely steam sterilization, identified through our method, aligns with the outcomes of existing ones, supported by higher values of Spearman’s and Kendall’s rank correlation coefficients. Additionally, our proposed algorithm successfully passes the rank reversal test consisting of replacement, transitivity & decomposition criteria, and hence the resulting ranking is reliable. The proposed metric and the entropy measure are also applied to various other multi-criteria decision-making algorithms to confirm the veracity of the optimal solution.}
}
@article{AMBEKAR2026115678,
title = {TL-FFA: An explainable malware image classification using data augmentation and optimized transfer learning feature fusion approach},
journal = {Applied Soft Computing},
volume = {201},
pages = {115678},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115678},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011269},
author = {Namrata Govind Ambekar and Surmila Thokchom},
keywords = {Explainability, Malware classification, Malware image, Feature fusion, Transfer learning},
abstract = {Smart technologies are advancing rapidly and malware threats are becoming increasingly complex, posing significant challenges to cybersecurity. Currently, the technical bottleneck in malware detection systems is the limited availability and imbalance of labeled data, which adversely impacts the results by causing overfitting and limiting the generalization capabilities of deep learning models. Moreover, traditional models are typically represented as “black boxes” due to the absence of transparency in their decision-making process, which restricts their reliability and adoption in sensitive operational environments. Motivated by these challenges, this paper introduces an explainable multiclass malware image classification model that incorporates three core elements: (i) a Deep Convolutional Generative Adversarial Network (DCGAN) for synthetic data generation, thereby enhancing dataset variety and reducing overfitting; (ii) a Transfer Learning-based Feature Fusion Approach (TL-FFA) that leverages pretrained DenseNet-BC-201 and MobileNetV2 architectures to enhance feature extraction from malware image representations; and (iii) Gradient-weighted Class Activation Mapping (Grad-CAM) to provide interpretable visual explanations of the model’s predictions. While explainability is primarily intended to assist humans in comprehending the model’s decision-making process, it can also be used to identify patterns or areas that focus on irrelevant or misleading features, which could indicate overfitting or data bias. This information can be used to enhance the model and reduce overfitting. The experimental findings indicate that the proposed approach achieves a testing accuracy of 0.982 on the MaleVis dataset and achieves a testing accuracy of 0.975 on the MalIMG dataset. These results underscore the model’s proficiency in interpretability, resilience and generalization, signifying a considerable advancement in the direction of intelligent malware detection systems.}
}
@article{MA2026115705,
title = {A privacy-preserving distributed credible evidence fusion algorithm for collective decision-making},
journal = {Applied Soft Computing},
volume = {201},
pages = {115705},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115705},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011531},
author = {Chaoxiong MA and Yan LIANG and Xinyu YANG and Han WU and Huixia ZHANG},
keywords = {Credibility calculation, Distributed fusion, Evidence reasoning, Network consensus, Privacy-preserving, Collective decision-making},
abstract = {By the fact that credible evidence fusion (CEF) does not satisfy data privacy and fusion consistency and hence cannot be extended to the distributed decision-making, a privacy-preserving credible evidence fusion (PCEF) algorithm with three-level consensus is proposed. In evidence difference measure (EDM) neighbor consensus, an evidence-free equivalent expression of EDM among neighboring agents is derived with the shared dot product protocol for pignistic probability and the identical judgment of two events with maximal subjective probabilities, so that evidence privacy is guaranteed due to such irreversible evidence transformation. In EDM network consensus, the neighbored EDMs reach uniformity via interaction between linear average consensus (LAC) while the EDMs between non-neighboring agents are inferred via low-rank matrix completion with rank adaptation to guarantee EDM consensus convergence and no solution for inferring raw evidence in numerical iteration style. In fusion network consensus, a privacy-preserving LAC with a self-cancelling random perturbation is proposed, where each agent adds its randomness to the sharing content and step-by-step cancels such randomness in consensus iterations. Furthermore, the sufficient condition for the convergence to the CCEF is explored, and it is proven that raw evidence cannot be uniquely reconstructed in such an iterative consensus. The comparison simulations show that PCEF is nearly approximate to CCEF both in credibility and fusion.}
}
@article{DEDETURK2026115697,
title = {A combinatorial ABC algorithm for AoI minimization with reliable data collection in UAV-assisted clustered IoT networks},
journal = {Applied Soft Computing},
volume = {201},
pages = {115697},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115697},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011452},
author = {Bilge Kagan Dedeturk},
keywords = {Unmanned aerial vehicles (UAVs), Internet of things (IoT), Age of information (AoI), Reliable data collection, Error control (ARQ, FEC), Artificial bee colony (ABC)},
abstract = {Unmanned aerial vehicles (UAVs) are increasingly employed for data collection in Internet of Things (IoT) networks, where fixed infrastructure is unavailable or costly to deploy. Their mobility allows them to serve areas that fixed systems cannot reach across applications such as environmental monitoring, industrial automation, and emergency response. In such applications, outdated data can directly degrade system performance, and the Age of Information (AoI) has become the standard metric for measuring data freshness. However, communication reliability methods introduce additional delay and energy overhead which creates a trade-off with AoI minimization. This study formulates a mixed-integer programming (MIP) model to minimize the average AoI while accounting for the overheads of error control methods such as Automatic Repeat Request (ARQ) and Forward Error Correction (FEC). Since the resulting problem is NP-hard, a K-means clustering-based framework and a modified Artificial Bee Colony (ABC) algorithm are used to find near-optimal solutions efficiently. The effects of these error control methods on AoI and packet success rate are evaluated across UAV heights from 65 to 80 m. Simulation results show that at 80 m, FEC maintains above 97% packet success rate with negligible AoI overhead, while the no error control case drops below 3% and ARQ achieves only 6%.}
}
@article{LI2026115665,
title = {A multi-expert adaptive hybrid belief rule base for stock price trend prediction},
journal = {Applied Soft Computing},
volume = {201},
pages = {115665},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115665},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011130},
author = {Jiaxing Li and Haoyang Li and Wenkai Zhou and Tianhao Zhang and Xiping Duan and Ning Ma and Yuhe Wang},
keywords = {Stock price trend prediction, Belief rule base, Evidential reasoning, Expert knowledge, Adaptive hybrid mechanism},
abstract = {Stock price trend prediction is of great significance for financial decision-making, risk management, and algorithmic trading. However, accurate prediction remains challenging due to the non-linear and uncertain nature of the financial market. Individual expert systems are prone to subjective biases, and static fusion strategies cannot adapt to constantly changing market conditions. To address these issues, this paper proposes a multi-expert adaptive hybrid belief rule base (MAH-BRB) model. In this model, multiple experts independently construct belief rule bases and generate expert-level belief distributions under the same input conditions. Information entropy is introduced to quantify the real-time certainty of each expert, and the effective expert weights are dynamically determined by combining entropy-based certainty and previous expert credibility. Then, through an adaptive mixing mechanism, the three complementary fusion strategies are coordinated based on the consistency of experts, enabling the model to switch between consensus enhancement and uncertainty-aware aggregation. Additionally, an optimization strategy based on P-CMA-ES is designed to generate distinguishable belief structures for adaptive fusion. Case studies on four publicly available datasets demonstrate the effectiveness of the proposed MAH-BRB model in terms of prediction accuracy, stability, and cross-dataset robustness, particularly under conditions of high market uncertainty.}
}
@article{DIAO2026115741,
title = {Multi-head self-attention based personalized exercise recommendation with time demand},
journal = {Applied Soft Computing},
volume = {201},
pages = {115741},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115741},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011890},
author = {Xiuli Diao and Xingsheng Wang and Qingtian Zeng and Zhengguo Song},
keywords = {Smart Education, Personalized exercise recommendation, Time demand, Self-attention},
abstract = {Personalized exercise recommendation can accurately match learners’ individual needs, significantly enhancing their motivation and learning efficiency. However, existing exercise recommendation methods mainly focus on knowledge matching while neglecting the time factor. Learning time, as a core dimension for measuring learning efficiency, is equally important in personalized exercise recommendation. In this paper, we propose a novel model named Multi-Head Self-Attention based Personalized Exercise Recommendation with Time Demand (MSATD). Given a learner’s current behaviour sequence, MSATD predicts the next exercise along with an appropriate attempting time. Specifically, we firstly construct a learning behaviour sequence modeling module that integrates learning time. Based on the exercise-time interaction sequence, MSATD uses an LSTM enhanced by multi-head self-attention to capture the dynamic correlations between learning behaviour and attempting time. Then, we construct a learner global representation module that leverages graph neural networks (GNNs) to extract structural relations and behavioural similarity features among learners in the overall learning network. Finally, MSATD integrates the learner’s behaviour sequence representation, global representation, and exercise difficulty features to achieve more accurate personalized exercise recommendations. To validate the effectiveness and comparative advantages of MSATD against state-of-the-art baselines, we conduct comprehensive experiments on two real-world datasets using multiple evaluation metrics. A case study is also conducted to further demonstrate its effectiveness in recommending suitable exercises at appropriate times.}
}
@article{NGO2026115657,
title = {Hierarchical multimodal cross-interactive learning for school violence detection},
journal = {Applied Soft Computing},
volume = {201},
pages = {115657},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115657},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011051},
author = {Khanh Ngo and Phi Ta and Nha Tran and Hien D. Nguyen and Hung Nguyen},
keywords = {School violence detection, Hierarchical multimodal learning, Cross-interactive learning},
abstract = {School violence poses a serious threat to students’ psychological and physical well-being. However, existing approaches predominantly rely on coarse-grained motion patterns, which limit their ability to distinguish ambiguous or confusing interactions. To address this challenge, we propose a hierarchical multimodal cross-interactive learning framework, instantiated as the Hierarchical Multi-modal Cross-Interactive Network (HMCI-Net), which jointly models visual context, body dynamics, and affective cues to capture complementary aspects of human behavior. Unlike conventional fusion methods, HMCI-Net introduces two specialized interaction modules to refine feature representations. Specifically, we propose the Pose Interaction Block (PIB), which adaptively fuses skeletal dynamics with visual features to model complex inter-person relationships and salient motion patterns. Concurrently, we design the Facial Interaction Block (FIB) to inject critical affective cues into the visual stream, enabling the network to interpret the psychological intent behind physical acts. Extensive experiments conducted on multiple benchmarks, including the proposed RSVD as well as public datasets such as AirtLab, Movies, and Hockey Fight, demonstrate the effectiveness and robustness of HMCI-Net. The results consistently show that the proposed framework is capable of distinguishing subtle and ambiguous violent interactions across diverse scenarios, ranging from staged actions and occluded faces to severe visual degradation, thereby confirming the generalization ability of the proposed cross-interactive learning strategy.}
}
@article{XU2026115681,
title = {Bayesian farthest-nearest neighbor for class-imbalanced classification},
journal = {Applied Soft Computing},
volume = {201},
pages = {115681},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115681},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011294},
author = {Jian Xu and Liangxiao Jiang and Wenjun Zhang and Yong Yang},
keywords = {Class-imbalanced classification, K-nearest-neighbor, Farthest-nearest neighbor, K-free optimization, Naive Bayes},
abstract = {K-Nearest-Neighbor (KNN) predicts the label of each inferred instance through simple majority voting from a fixed number of nearest neighbors, achieving impressive classification performance. However, when classification tasks are class-imbalanced, KNN’s predictions tend to exhibit bias toward majority classes due to the greater influence of majority instances on voting. To address this issue, we propose a novel algorithm called Bayesian Farthest-Nearest Neighbor (BFNN). First, we propose an updated version of farthest-nearest neighbor query strategy, which queries farthest and nearest neighbors for each inferred instance and uses the farthest neighbors to weaken the influence of majority classes. Then, we develop a K-free optimization method to automatically determine the optimal numbers of farthest and nearest neighbors for each inferred instance. Finally, we design a locally weighted naive Bayes to obtain more accurate class probability estimation to predict the label of each inferred instance. The experimental results on 28 imbalanced datasets show that BFNN significantly outperforms all the other competitors used for comparison.}
}
@article{IWAMOTO2026115704,
title = {Fuzzy set-based re-ranking for inductive knowledge graph completion},
journal = {Applied Soft Computing},
volume = {201},
pages = {115704},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115704},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601152X},
author = {Yuki Iwamoto and Ken Kaneiwa},
keywords = {Knowledge graph, Inductive knowledge graph completion, Rule-induction, Re-ranking, Fuzzy set},
abstract = {Knowledge graphs (KGs) are structured representations of entities and their relations but are often incomplete. Link prediction aims to address this problem by inferring missing facts. Early studies predominantly focused on the transductive setting, where all entities are known during training. While effective in controlled scenarios, this assumption does not reflect dynamic KGs, where new entities are continually introduced. The inductive setting addresses this limitation by requiring models to predict links among entirely unseen entities. This enables entity-independent reasoning and makes inductive methods more suitable for real-world KGs. Rule-induction models have demonstrated strong performance in this setting. They capture general logical dependencies that apply across entities and generalize by exploiting structural patterns in the graph, rather than memorizing specific instances. Beyond predictive power, these rules also provide interpretable insights, which are valuable for tasks such as literature-based discovery. To examine how rules affect predictions, we analyzed outputs under varying rule sets and found that the same inputs often yield different results. By focusing on this observation, we propose a fuzzy set-based re-ranking model called ReDistLP (Re-ranking with a Distinct Model for Link Prediction). This model improves re-ranking effectiveness by leveraging differences between the initial retriever and the re-ranker. ReDistLP achieves Hits@1 values 3.2 percentage points (pp) higher on FB15k-237 and 1.7 pp higher on NELL-995, but 3.9 pp lower on WN18RR. We further analyze re-ranking under an ideal setting, demonstrating that fuzzy set operations provide robustness in practice, whereas optimized cutoffs reveal the performance upper bound.}
}
@article{LIU2026115725,
title = {Cross-modal dynamic fusion and grouped wavelet feature aggregation for multimodal emotion recognition in conversation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115725},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115725},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011737},
author = {Ping Liu and Yuan Zheng and Huadong Zhang and Shufeng Hao and Hui Song and Li Tang},
keywords = {Multimodal emotion recognition in conversation, Modality representation, Dynamic fusion, Discrete-wavelet transform},
abstract = {Multimodal emotion recognition in conversation aims to classify the emotion category of each sentence in a continuous dialogue. Multi-modal information fusion in the task remains a challenge, especially in terms of dynamic feature correlation and complementarity between modalities. To address these limitations, we propose a novel multimodal emotion recognition model integrating cross-modal dynamic fusion and grouped wavelet feature aggregation. The model first employs an external attention mechanism and a bidirectional Mamba network guided by the text modality to learn comprehensive modality representations. Subsequently, cross-modal dynamic fusion is used to complement and calibrate cross-modal representations by integrating text-centered information. Meanwhile, a grouped wavelet feature aggregation module is designed to capture the identical emotional expression structure of audio and video. The module iteratively decomposes the audio and video modalities through sliding grouping and pooling operations, and then employs discrete wavelet transformation to obtain high and low frequency features that contain instantaneous changing signals. Extensive experimental results on the IEMOCAP and MELD datasets have demonstrated that the proposed method achieves better performance than baseline methods. In addition, an ablation study and category distribution visualization are conducted to verify the effectiveness of the proposed method.}
}
@article{ALBAHRI2026115693,
title = {Trust prediction models: A novel FWZIC-MEREC-ARAS evaluation framework based on m-polar fuzzy sets},
journal = {Applied Soft Computing},
volume = {201},
pages = {115693},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115693},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011415},
author = {Osamah Albahri and Kareem Abbas Dawood and Mohamed Alsalem and Rawia Mohammed and Moamin A. Mahmoud and Ahmed Albahri and Abdullah Alamoodi and Ghada A. Alsawah and Iman Mohamad Sharaf},
keywords = {Additive ratio assessment method (ARAS), Fuzzy-weighted zero-inconsistency method (FWZIC), Method based on removal effects of criteria (MEREC), m-polar fuzzy sets, Multicriteria decision-making (MCDM), Trust prediction models},
abstract = {Trust prediction models play crucial roles in various domains where trust is a fundamental factor in decision-making processes. Current subjective evaluations of these models have multiple disadvantages, which make their outcomes unreliable and inconsistent on certain occasions. Moreover, past efforts have not considered multiple criteria, their significance, or the conflicts among them in the evaluation process. Therefore, this paper introduces a novel model for evaluating trust prediction models. A decision matrix within the context of online social networks is proposed, including criteria such as coverage, accuracy, attack resistance, scalability, subjectivity, fuzziness, recency, and event sensitivity. Since there is no consensus among various methods on the weights of the criteria, subjective and objective weights are combined. This is accomplished via two techniques, namely, the fuzzy weighted zero inconsistency method and the Method based on the Removal Effects of Criteria. These double-source weights are integrated through m polar fuzzy sets to form the fuzzy weight indicator. In this work, m-polar fuzzy sets are applied in a dual form: a similar polarity form (multipolar information) when expressing the weights of the criteria and a different polarity form (positive and negative membership grades) when expressing degrees of preference. A novel score function for m-polar fuzzy sets of different polarities and a multiplication rule for m-polar fuzzy sets of different dimensions are proposed to implement the evaluation framework. An additive ratio assessment method is applied to rank the trust prediction models. Finally, systematic ranking and sensitivity analysis are employed to validate the robustness of the proposed model.}
}
@article{ZHANG2026115685,
title = {Collapse risk assessment of metro tunnels using an enhanced convolutional neural network with shapley additive explanations},
journal = {Applied Soft Computing},
volume = {201},
pages = {115685},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115685},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011336},
author = {Weiguo Zhang and Bin Gong and Zhengzhao Liang and Yongjun Zhang and Fei Liu},
keywords = {Tunnel collapse, Risk assessment, Index system, Deep learning, Attention mechanism, SHapley additive exPlanations},
abstract = {Currently, advanced machine learning models are becoming indispensable tools for the prevention of collapse risks in urban metro tunnels. However, the weak interpretability of conventional models obstructs the tracing of critical contributing factors to collapse, limiting their effectiveness in optimizing resource allocation for risk mitigation. To overcome this limitation, this study proposes an interpretable risk assessment model based on the enhanced Convolutional Neural Network (CNN) and the SHapley Additive exPlanations (SHAP). Meanwhile, to support risk assessment, this work proposes a comprehensive and transferable index system that includes 12 key factors derived from the analysis of 46 historical cases. The model is trained on a dataset collected from metro projects in Qingdao, China. Comparative analysis demonstrates the excellent predictive performance of the proposed model over the baseline models, with the best accuracy and mean squared error of 88.2% and 0.006, respectively. The SHAP analysis visualizes the factor contributions and shows that the most influential factors are soft-hard rock ratio, proportion of saturated sandy layers and tunnel depth, with their individual contributions being 16.6%, 12.1% and 11.9%, respectively. Finally, the proposed model is applied in the Qingdao Metro project, offering valuable insights into its causes and prevention.}
}
@article{SHAO2026115737,
title = {A three-way decision-enhanced Louvain framework for overlapping community-aware manipulation management},
journal = {Applied Soft Computing},
volume = {201},
pages = {115737},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115737},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011853},
author = {Xin Shao and Xueling Ma and Muhammet Deveci and Jianming Zhan},
keywords = {Three-way decision, Overlapping community, Manipulative behavior, Large-scale group decision-making},
abstract = {In the era of pervasive social computing, large-scale group decision-making (LSGDM) platforms must fuse granular uncertainty modeling with computationally light learning to preserve collective rationality while deterring adversarial distortions. Existing soft-computing models either treat communities as disjoint, ignore strategic manipulation, or require costly iterative consensus, so they fail when the same decision-maker simultaneously belongs to multiple overlapping subgroups and covertly distorts outcomes. This paper embeds three-way decision (TWD) theory inside a Louvain-style modularity optimizer to create CDM-Louvain, the first overlapping-aware framework that (i) partitions social networks into interpretable core-fringe-trivial communities, (ii) spots high-risk manipulators through a Gaussian-mixture model fed by in-degree centrality and consensus deviation, and (iii) re-balances the network by inexpensive, fairness-oriented opinion updates. A two-stage minimum-cost consensus engine first calibrates overlapping agents and then propagates their reconciled view to independent communities, guaranteeing the global consensus level reaches any user-defined threshold in one shot. Comparisons and simulation experiments demonstrate that the proposed framework exhibits significant advantages in overlapping community detection quality, manipulation identification precision, consensus reaching efficiency and adjustment cost control. In summary, the proposed TWD-enhanced Louvain pipeline offers a ready-to-use, computationally light tool for trustworthy, manipulation-resilient LSGDM in real-world social networks.}
}
@article{XIANG2026115656,
title = {An active region preference learning model for fuzzy class assignments in multi-criteria sorting},
journal = {Applied Soft Computing},
volume = {201},
pages = {115656},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115656},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601104X},
author = {Xinxin Xiang and Lin Wang and Quanbo Zha},
keywords = {Multiple criteria sorting, Fuzzy preference, Active learning, Heuristic strategy, Interactive methods},
abstract = {The limited rationality of a decision-maker (DM) has received significant attention in multi-criteria sorting (MCS) problems. Faced with complex information, the DM often tends to provide fuzzy class assignments. To address this issue, this paper introduces an active region preference learning model that interactively infers the DM's preferences using a set of additive region value functions, which explicitly capture hesitation on specific criteria. The learning process employs function-fitting-oriented interactive heuristic strategies to elicit informative responses, and then updates the function parameters iteratively. Meanwhile, a feedback loop is introduced in the process to enable the DM to correct the previously provided class assignments. Extensive experiments on artificial and real datasets show that the proposed region preference model captures individualized fuzziness across criteria, and that the proposed strategies can achieve different trade-offs among interaction burden, computation time and classification accuracy to meet different decision-making requirements. Furthermore, experiments under varying preference fuzziness, inconsistency, problem sizes, and stopping conditions are carried out to validate the effectiveness of the proposed strategies.}
}
@article{LU2026115677,
title = {Multi-channel hypergraph convolutional network guided by hybrid random walks for web API recommendation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115677},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115677},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011257},
author = {Jiawei Lu and Jiahuan Fei and Jiacheng Shi and Zhongcheng Xiao and Junfeng Song and Gang Xiao},
keywords = {Hypergraph convolutional network, Motif, Random walk, Service recommendation},
abstract = {Mashup uses web APIs to create products. The complex relationship between them which existing methods fail to address poses challenges for service recommendation. Thus, in this study, we propose the multi-channel hypergraph convolutional network guided by hybrid random walks (MCHCN) method. In this method, we use motifs to extract the hypergraph structure from services and study the complex relationships between service data, thereby effectively solving the problem of data sparsity. However, convolving directly on raw hypergraphs would introduce noise. To reduce noise, we use a convolution weight matrix guided by a mixture of random walks in hypergraph convolution. Furthermore, we adjust the weights of channels using a channel error attention mechanism to effectively capture the relationships and importance to the final API recommendation effect of different channels, and introduce contrastive learning to compensate for the loss caused by complex models. Finally, the experimental results on a real-world service dataset demonstrated that, compared with the optimal baseline, the MCHCN method improves the NDCG@5 and HR@5 on the sparse and dense datasets by 6.52%, 5.85%, 3.85%, and 2.69% respectively.}
}
@article{ZHAO2026115713,
title = {Transferable adversarial attacks against face recognition via region-focused distillation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115713},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115713},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011610},
author = {Luman Zhao and Ruizhong Du and Mingyue Li and Jinjia Peng and Chunfu Jia},
keywords = {Face recognition, Adversarial examples, Deep neural networks, Knowledge distillation, Black-box transferability},
abstract = {Face recognition (FR) systems based on deep neural networks (DNNs) are widely used in identity verification and security, but they are vulnerable to adversarial attacks, posing serious security threats in real-world applications. Exploring these attacks is crucial for identifying model vulnerabilities and enhancing their robustness. Existing semantic attacks enhance stealthiness but suffer from limited adaptability and weak black-box transferability due to their reliance on explicit external semantic guidance (e.g., attribute texts or makeup references) and simplistic global feature alignment optimization. To overcome these limitations, we propose Adaptive Distillation for Improved Transferability (ADIT), a novel framework that leverages an adaptive distillation strategy to generate stealthy and transferable adversarial faces without requiring such semantic guidance. Specifically, the designed Adaptive Region-Focused Adversarial Distillation (ARFAD) module leverages a synergistic form of distillation guided by a dynamically constructed focus discrepancy mask to adaptively concentrate perturbations on identity-critical regions, enabling a more precise and directional optimization thereby substantially enhancing attack transferability. Meanwhile, our Visual Fidelity Module (VFM) imposes dual structural and perceptual constraints to preserve the semantic structure and fine-grained visual details of the generated image, ensuring high visual realism and thereby improving the attack’s stealthiness. Extensive experiments demonstrate the superiority of ADIT, achieving an absolute improvement of 6.11% in average Attack Success Rate (ASR) over the state-of-the-art semantic method, GIFT, in face verification tasks. Furthermore, successful evaluations on commercial FR APIs, Face++ and Aliyun, validate its real-world effectiveness.}
}
@article{DACHEPALLI2026115512,
title = {Privacy preserved federated deep learning for disease classification of patients medical images},
journal = {Applied Soft Computing},
volume = {201},
pages = {115512},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115512},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009609},
author = {Veeresh Dachepalli and Gavini Sreelatha},
keywords = {Fast local laplacian filter, Mish activation, Feature mapping module, Residual convolutional, Feature filtering distillation technique},
abstract = {Federated Learning (FL) is appropriate for sensitive fields such as medical image analysis since it allows collaborative deep learning across several universities while maintaining data privacy. However, non-independent and identically distributed (non-IID) data frequently causes problems for current FL models, which results in poor severity categorization and decreased segmentation accuracy. To address these challenges, this work proposes a privacy-preserving federated deep learning framework that integrates Cascaded Laplacian Bilateral Filtering (CasLB) for advanced noise reduction. Region Graph-based Residual Convolutional Distillation Network (ReG-CDN) for accurate tumor segmentation, and a Hybrid Cox Layer-assisted Dilated Dense Convolutional Network (Hy-COXdCN) for clinically relevant severity classification. To ensure security and privacy issues in the proposed framework, using a dual personalization (DP) mechanism is used in the local models before aggregation. Each component, such as CasLB for reducing input variability, ReG-CDN for robust segmentation across heterogeneous data and Hy-COXdCN for severity identification, helps to mitigate the impact of non-IID distribution. Experimental results demonstrate accuracy rates of 98.50% for KITS and 98.34% for CCSC, significantly outperforming baseline FL models. Those results support the idea that the proposed framework successfully copes with the problem of data heterogeneity, privacy preservation, and clinical relevance in medical image analysis.}
}
@article{ZHANG2026115732,
title = {Remaining useful life prediction of lithium-ion batteries by physics-interpretable enhanced electrochemical features and adaptive spline modeling based on TCN-KAN},
journal = {Applied Soft Computing},
volume = {201},
pages = {115732},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115732},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011804},
author = {Xiaoli Zhang and Jie Lv and Junzhe Xie and Haopeng Han and Xudong Zhang and Qiwu Zhao},
keywords = {Lithium-ion batteries, Electrochemical impedance spectroscopy, Equivalent circuit model, Temporal convolutional network, Kolmogorov-Arnold Network},
abstract = {In most lithium-ion battery prediction methods, externally measured capacity values are used; however, intrinsic electrochemical aging processes are insufficiently represented, and prediction reliability is reduced. In mainstream deep learning approaches, MLP architectures are commonly adopted, and physical interpretability is limited. To address these limitations, a physics-informed hybrid TCN–KAN framework is proposed, in which temporal convolutional networks (TCN) and Kolmogorov–Arnold networks (KAN) are integrated into a unified architecture to couple electrochemical mechanisms with nonlinear degradation modeling. An equivalent circuit model is employed to fit electrochemical impedance spectroscopy (EIS) data, and a physics-guided feature-screening process is established based on Spearman rank correlation analysis. In this framework, conventional capacity testing is replaced with an EIS-derived feature extraction strategy, and an electrochemically relevant feature set is generated so that energy dissipation and aging behavior can be characterized. Long-term degradation dynamics are captured by the TCN module through dilated causal convolutions, while black-box MLP layers are replaced by the KAN module with learnable B-spline basis functions, enhancing nonlinear mapping interpretability. Interpretable deep modeling of degradation patterns is enabled by this integration, and a mechanism-consistent, structurally transparent architecture is provided for battery lifespan prediction. Experiments are conducted on the publicly available Cambridge battery dataset. A minimum prediction RMSE of 0.00421 is achieved by the proposed method, and remaining useful life prediction errors ranging from 1.7% to 2.6% are obtained. Both baseline models and recent advanced models are outperformed in terms of accuracy and interpretability.}
}
@article{FU2026115735,
title = {Wave-CompNet: A hybrid wavelet network with an asymmetric architecture for long-term multivariate time series forecasting},
journal = {Applied Soft Computing},
volume = {201},
pages = {115735},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115735},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601183X},
author = {Jiapeng Fu and Bo Liu and Shengsheng Lin and Shaomin Tang and Weiwei Lin and Li Zhang},
keywords = {Long-term multivariate time series forecasting, Wavelet decomposition, Asymmetric architecture, Component-specific modeling},
abstract = {Long-term time series forecasting (LTSF) is a critical yet challenging task across numerous domains. Recently, decomposition-based methods have shown significant potential by separating time series into trend and detail components. However, existing works commonly adopt a homogeneous strategy, applying the same processing architecture to both trend and detail components, which possess disparate characteristics. This architectural mismatch limits performance by failing to provide optimal inductive biases for each component. To address this issue, we introduce Wave-CompNet, an efficient dual-branch network that serves as a novel architectural instantiation of asymmetric, component-specific processing. This model equips different components with specialized modules: the trend branch utilizes a Residual Interactive Convolution Block (RICB) to model multi-scale dynamics, while the detail branch introduces a Complex Multilayer Perceptron (MLP) to explicitly capture the magnitude and phase of high-frequency signals in the complex domain. Extensive experiments on several public benchmarks demonstrate that our model significantly outperforms prominent baselines. In terms of Mean Squared Error (MSE), it surpasses the decomposition-based WPMixer, the MLP-based TimeMixer, and the Transformer-based iTransformer by 4.0%, 8.1%, and 10.1%, respectively, offering an effective solution to the LTSF problem.}
}
@article{KHAN2026115676,
title = {Accelerating model convergence in federated learning with layer-wise adaptive weight aggregation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115676},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115676},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011245},
author = {Anam Nawaz Khan and Atif Rizwan and Rashid Ahmad and Qazi Waqas Khan and Xueping Li and DoHyeun Kim},
keywords = {Federated machine learning, Model optimization, Client contribution},
abstract = {Statistical heterogeneity arising from non-IID data distributions fundamentally undermines federated learning by inducing layer-specific gradient misalignment between local node models and the global objective, resulting in degraded convergence rates and suboptimal generalization performance. We present Fed-LAA (Federated Layer-wise Adaptive Aggregation), a novel aggregation framework that addresses this challenge through principled layer-wise gradient alignment optimization. Fed-LAA computes layer-specific aggregation weights for each node-layer pair by measuring gradient angular similarity between local updates and the global descent direction, enabling independent per-layer weight assignment that selectively amplifies well-aligned contributions while suppressing misaligned updates even within individual nodes. This fine-grained approach is theoretically justified through convergence analysis demonstrating that layer-wise gradient alignment maximization achieves provably tighter loss reduction bounds than conventional data-proportional aggregation. To ensure statistical fairness, we incorporate data volume weighting that balances representativeness with optimization quality, preventing domination by small nodes while maintaining adaptive precision. Extensive experiments on CIFAR-10, Fashion-MNIST, MNIST and tabular datasets under varying heterogeneity levels demonstrate that Fed-LAA achieves improved performance over state-of-the-art baselines in severely non-IID settings, while achieving faster convergence. Our theoretical and empirical results establish layer-wise gradient alignment as a fundamental principle for robust federated optimization under statistical heterogeneity.}
}
@article{QI2026115696,
title = {FedPRADA: Federated learning with personalization, regularization and adaptively decomposed aggregation for heterogeneous classification with two shipment data case studies},
journal = {Applied Soft Computing},
volume = {201},
pages = {115696},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115696},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011440},
author = {Hang Qi and Qiyue Li and Yuxuan Chen and Jieping Luo and Jingjin Wu},
keywords = {Federated learning, Non-IID data, Adaptive aggregation, Heterogeneous classification, Intelligent decision-making},
abstract = {Federated Learning (FL) has emerged as a promising paradigm for privacy-preserving collaborative learning across decentralized clients, particularly in real-world applications where sensitive data cannot be shared or centrally aggregated. However, performance degradation under heterogeneous (non-IID) data distributions remains a major challenge that limits its practical effectiveness. In this paper, we propose FedPRADA (Federated Learning with Personalization, Regularization and Adaptively Decomposed Aggregation), an adaptive FL framework designed to improve robustness and aggregation stability under data heterogeneity. FedPRADA integrates divergence-aware reweighting, stability-based reliability assessment, and sample-size-aware aggregation to dynamically modulate client contributions during training. Extensive experiments on two real-world logistics datasets demonstrate that FedPRADA consistently outperforms conventional federated baselines, including FedAvg, FedProx, and FedAWA, across varying degrees of client heterogeneity. In particular, FedPRADA achieves more robust performance under non-IID settings while maintaining stable convergence behavior across different client distributions and datasets. These results highlight the effectiveness of FedPRADA as a robust and practical solution for heterogeneity-aware federated learning in real-world intelligent decision-making systems.}
}
@article{KUMARI2026115607,
title = {A systematic review of image enhancement and object detection in low-light scenarios with benchmark experiments},
journal = {Applied Soft Computing},
volume = {201},
pages = {115607},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115607},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010550},
author = {Rakhee Kumari and Sharanya Singh and Praneet Saurabh},
keywords = {Object detection, Image enhancement, Low-light, Deep learning, Datasets},
abstract = {Object detection under low-light conditions remains a critical challenge due to reduced visibility, noise, and illumination-dependent feature degradation. While significant progress has been made in image enhancement and deep learning–based object detection, their effectiveness and limitations in low-light environments are not yet fully understood. This paper presents a comprehensive review of traditional and deep learning–based image enhancement techniques alongside modern object detection methods, with a focus on their applicability to low-light scenarios. Four state-of-the-art YOLO detectors (YOLOv8-YOLOv11) are compared experimentally with three low-light datasets (ExDark, DarkFace, and LLVIP) to establish a reference baseline. Our findings indicate that architectural improvements result in only a marginal improvement, the performance of detection is heavily influenced by dataset characteristics and illumination severity. The synthesis of these results emphasizes obstacles and trade-offs between accuracy and efficiency as well as the significance of illumination-aware and integrated enhancement–based detection approaches toward reliable deployment in the real world.}
}
@article{NIKOO2026115720,
title = {Bridging data scarcity in coastal risk forecasting through physics-informed transfer learning and fuzzy decision support},
journal = {Applied Soft Computing},
volume = {201},
pages = {115720},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115720},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011683},
author = {Mohammad Reza Nikoo and Mohamad Hosein Seyed-Djawadi and Talal Etri and Ghazi Al-Rawas and Khalifa Al-Jabri},
keywords = {Physics informed neural network, Transfer learning, Fuzzy TOPSIS, Multicriteria decision making, Coastal risk assessment},
abstract = {Reliable coastal risk forecasts remain difficult in data-poor areas, where data-driven models often lack the capacity to model rare events. In our work, we propose a novel Physics-Informed Transfer Learning (PITL) framework, coupled with Fuzzy TOPSIS, for reliable risk prediction and decision support. In particular, by directly incorporating wave dispersion and wind stress equations into the loss function, the PITL framework enables reliable knowledge transfer from NOAA buoys to commercial ports, where such information is scarce. Stringent validation analyses confirm that our PITL framework can achieve an RMSE of 0.048, providing 24% and 15% relative improvements over LSTMs and Random Forest models, respectively. Moreover, our PITL solution is strongly significant compared to LSTMs and Random Forest models through Wilcoxon tests at P<10−93. In practical terms, uncertainty estimation and Monte Carlo Dropout analyses have provided confident estimates above 93% for critical events. Subsequently, using Fuzzy TOPSIS decision support modules, our solution effectively provides critical orders based on probabilistic outputs. Across our sensitivity analyses, our decision support system demonstrates robustness to weight uncertainty, with a Spearman ρ value of 0.995. Finally, our solution can help minimize potential losses to around 25 million, significantly assisting in providing a physics-consistent decision-support system for coastal zone management.}
}
@article{XU2026115757,
title = {DFAB-Net: A dynamically fused attentional biomarker network for EEG-based attention level classification},
journal = {Applied Soft Computing},
volume = {201},
pages = {115757},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115757},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012056},
author = {Jin Xu and Wenjun Guan and Yao Yao and Xu Zhaojun and Wenbin Hu and Adnane Cabani},
keywords = {Convolution neural networks, EEG classification, Attention level recognition, Classification},
abstract = {Current deep learning approaches for EEG-based attention classification face limitations in capturing the selective sensitivity of distinct EEG rhythms to attentional states and the dynamic spatiotemporal interactions underlying cognitive processes, leading to suboptimal generalization across individuals and tasks. To address this, we propose DFAB-Net (Dynamically Fused Attentional Biomarker Network), a dual-branch architecture that disentangles temporal dynamics and spectral biomarkers through dedicated feature extractors, integrated via an attention-based fusion module that dynamically weights discriminative features using learnable coefficients. Extensive experiments show that DFAB-Net outperforms the included baselines under the present subject-independent evaluation setting, achieving higher mean accuracy and F1-score, and showing promise under non-stationary EEG conditions rather than establishing universal robustness. Ablation studies confirm both the dual-branch design and attentional fusion are indispensable—removing either component substantially degrades performance. Critically, interpretability analysis reveals that the network prioritizes temporal features during high-attention states and spectral features during low-attention states, aligning with established neurophysiological mechanisms. This work provides an interpretable framework for EEG-based attention assessment and may support future development of adaptive brain-computer interfaces and intelligent tutoring systems.}
}
@article{ZHAO2026115680,
title = {scCCCT: Single-cell RNA-seq data contrastive clustering network with hierarchical cell transformer},
journal = {Applied Soft Computing},
volume = {201},
pages = {115680},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115680},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011282},
author = {Shangshang Zhao and Zhongyang Zhou and Bin Tang and Nanjun Yu and Feng Liu and Feiyu Chen},
keywords = {scRNA-seq, Contrastive learning, Graph neural network, Transformer, Deep clustering},
abstract = {Single-cell RNA sequencing provides researchers with powerful tools to investigate cellular heterogeneity and disease mechanisms at single-cell resolution. In downstream analysis, unsupervised clustering is a critical step for identifying cell populations with similar expression profiles. However, clustering scRNA-seq data remains challenging due to noise, high dimensionality, and widespread dropout events. Although deep learning methods have advanced the field, they often fail to fully exploit multi-scale information across network layers and encounter difficulties in handling high-dimensional sparsity, which may limit clustering performance and biological interpretability. To address these issues, we propose a deep clustering framework, named scCCCT, which integrates representation learning with clustering optimization. The Hierarchical Cell Transformer serves as an attention-based layer-wise feature aggregation module, using standard self-attention to integrate GAE embeddings from different encoder depths, followed by learnable adaptive weighting. In addition, we propose a topology-constrained contrastive objective to preserve neighborhood dependencies and semantic consistency, and incorporate a distribution-guided clustering loss that leverages dynamic prototypes to align sample distributions, thereby improving representation consistency and enhancing cluster compactness and separability. Experiments on ten real scRNA-seq datasets indicate that scCCCT generally achieves more favorable results than thirteen existing baseline methods across multiple clustering metrics. Notably, on the QX_Limb_Muscle dataset, it yields a 5.61% improvement in Adjusted Rand Index compared to the scSCCNIA model. In summary, scCCCT serves as a practical tool for single-cell clustering, contributing to improved performance in downstream biological analyses such as GO enrichment and gene expression interpretation.}
}
@article{ACAMPORA2026115664,
title = {Evolutionary tailoring of quantum kernels for cyber-physical anomaly detection: A case study on the SWaT testbed},
journal = {Applied Soft Computing},
volume = {201},
pages = {115664},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115664},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011129},
author = {Giovanni Acampora and Edoardo Giusto and Andrea Senese and Nicola Mazzocca},
keywords = {Anomaly detection, Cyber-physical systems, Evolutionary optimization, Quantum machine learning, Quantum kernels},
abstract = {Quantum computing represents a promising frontier for machine learning, offering new tools to tackle complex problems by leveraging high-dimensional feature spaces and the unique properties of quantum systems. In this context, quantum kernels have emerged as a particularly compelling technique, capable of revealing structures in data that are difficult to detect using classical methods (Schuld and Killoran, 2019 [5]). However, their practical impact on real-world applications remains largely unexplored. This work proposes a hybrid quantum-classical architecture for anomaly detection in industrial cyber-physical systems, using the SWaT testbed as a case study. In complex environments like SWaT, sophisticated cyber-attacks can mimic normal system behavior, making them difficult to identify (Goh et al., 2016 [1]). Quantum kernels may help distinguish such anomalies by enabling more expressive data representations. Experimental results demonstrate the viability of hybrid quantum approaches, providing promising indications for future developments in quantum-supported industrial system security.}
}
@article{BENGARAALI2026115716,
title = {Alz-Fed-XAI: A dynamic federated transformer for multimodal Alzheimer’s classification, fuzzy explainable reasoning and smart decision support},
journal = {Applied Soft Computing},
volume = {201},
pages = {115716},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115716},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011646},
author = {Marwa {Ben Gara Ali} and Abir Smiti},
keywords = {Federated learning, Alzheimer’s disease classification, Multimodal fusion, Vision transformers, Missing modality robustness, Explainable AI},
abstract = {Real-world deployment of federated AI for Alzheimer’s disease (AD) staging demands more than privacy preservation and diagnostic accuracy, it requires robustness to incomplete multimodal inputs, resilience to client data quality degradation, and interpretability that is consistent across heterogeneous clinical sites. Existing federated frameworks fail to address these requirements in combination, typically assuming complete modality availability and uniform data quality across participating institutions. We present Alz-Fed-XAI, a federated multimodal transformer framework for five-stage AD classification integrating three-dimensional Magnetic Resonance Imaging (3D MRI), Image Biomarker Standardisation Initiative (IBSI)-compliant radiomics, Montreal Cognitive Assessment (MoCA) cognitive assessments, and Food and Drug Administration (FDA)-cleared plasma biomarkers. Three architectural contributions address the identified deployment gaps: (i) a Shifted Window U-Net (Swin-UNet) backbone with rank-4 Low-Rank Adaptation (LoRA) adapters and L0-regularised token gating that reduces per-round communication to 140 KB, a 99% reduction over standard federated averaging, while retaining diagnostic accuracy within 1.1% of the centralised upper bound; (ii) a Mask-Conditioned Adaptive Fusion mechanism that re-normalises attention exclusively over available modalities and encodes missingness patterns through learned embeddings, limiting balanced accuracy degradation to less than 5% under Missing Completely At Random (MCAR), Missing At Random (MAR), and Missing Not At Random (MNAR) missingness scenarios without imputation or generative reconstruction; and (iii) a fuzzy-rough hybrid explainability pipeline that aggregates Gradient-weighted Class Activation Mapping (Grad-CAM) and SHapley Additive exPlanations (SHAP) attributions across clients via set-theoretic lower approximation, providing 3.5× better resilience to client data quality degradation and 47% improved calibration (Expected Calibration Error (ECE): 0.037 vs 0.072) compared to standard federated averaging. Evaluated across 1438 subjects from three independent cohorts, Alzheimer’s Disease Neuroimaging Initiative (ADNI), Open Access Series of Imaging Studies-3 (OASIS-3), and Australian Imaging, Biomarker and Lifestyle (AIBL), spanning heterogeneous scanner vendors and geographic populations, Alz-Fed-XAI achieves 80.7% balanced accuracy with 112 ms inference latency and a cross-client saliency Dice score of 0.84 with anatomically validated overlap in hippocampal and entorhinal regions. Zero-shot transfer to external cohorts yields a generalization gap of less than 5%, confirming scanner-agnostic deployability across diverse clinical environments.}
}
@article{GUO2026115740,
title = {SEGCA-Net: Structure-exposure guided cross attention network for low-light image enhancement},
journal = {Applied Soft Computing},
volume = {201},
pages = {115740},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115740},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011889},
author = {Dong Guo and Yi Han and Jiaqi Liu},
keywords = {Low-light enhancement, Dual-path, Structure-guided attention, Exposure planning},
abstract = {Although significant progress has been made in low light image enhancement using existing deep learning methods, there are still two key issues: firstly, insufficient explicit separation and collaborative modeling of structural information and texture details, leading to structural distortion or texture blur in the enhancement results; secondly, the modeling of exposure distribution is not explicit enough, making it difficult to strike a balance between global brightness restoration and local detail preservation. Therefore, this paper proposes a structure-exposure guided cross attention network (SEGCA-Net), which achieves deep collaborative enhancement of spatial domain information through structure texture dual stream modeling and explicit exposure planning. SEGCA-Net consists of three core modules: structural branches extract multi-scale structural information in low resolution space; the multi-scale exposure planning decoder utilizes multi-scale structural information to explicitly model the illuminance distribution, providing prior guidance for the enhancement process; texture branches enhance detail textures in the original resolution space and achieve complementary enhancement of structure, texture, and exposure through a cross attention mechanism guided by structure and exposure. In addition, a joint loss function is designed to constrain the reconstruction quality, residual regularization, and exposure image consistency, ensuring that the enhanced results achieve optimal brightness, structure, and color. A large number of experiments were conducted on the three mainstream datasets of LOLv1, LOLv2_real, and LOLv2_synthetic, and the results showed that SEGCA-Net achieved excellent results in PSNR and SSIM metrics, verifying the effectiveness and efficiency of the method. The ablation study further confirmed the critical role of each core module at the network structure. The code is available in https://github.com/lijiyidong/SEGCA-Net.}
}
@article{WEI2026115595,
title = {Multiple feature fusion in nonlinear canonical correlation analysis for semi-supervised land cover segmentation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115595},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115595},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010434},
author = {Hong Wei and James Xiao and Xia Hong},
keywords = {Multiple feature fusion, Semi-supervised land cover segmentation, t-SNE embedding, Canonical correlation analysis},
abstract = {Segmenting complex multi-spectral remote sensing images, such as urban areas, with limited training data is a challenging task in computer vision research. To address this challenge, this study introduces a novel semi-supervised clustering framework using multiple feature fusion and dimensionality reduction designed for effective segmentation. We propose a pipeline that first constructs a high-dimensional feature space by concatenating textural and spatial features at the pixel level, followed by dimensionality reduction using t-distributed Stochastic Neighbour Embedding (t-SNE). A core contribution of this study is the introduction of RBF-CCA, a modified Canonical Correlation Analysis (CCA) algorithm that leverages Radial Basis Functions (RBF) centred on limited labelled data to learn an optimal projection matrix. By projecting the RBF of the full image data using this learned canonical space, a robust partitioning via k-means clustering of canonical variables with a desired number of clusters is employed to segment the given image. Experimental results on several multi-spectral remote sensing benchmark images demonstrate that the proposed approach effectively captures spectral and textural similarities from highly sparse labelled data and significantly improves land cover segmentation accuracy compared to traditional schemes. It offers a novel solution for semi-supervised segmentation of high-dimensional imagery, specifically optimised for land cover data with limited labelling efforts.}
}
@article{YU2026115687,
title = {Multiple populations for multiple objectives framework with one-vote veto selection for many-objective optimization},
journal = {Applied Soft Computing},
volume = {201},
pages = {115687},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115687},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601135X},
author = {Xiaobing Yu and Zhengpeng Hu and Gary G. Yen and Junhua Zhu},
keywords = {Evolutionary many-objective optimization, Coevolution, Multiple populations for multiple objectives (MPMO), One-vote veto (OVV)},
abstract = {Many-objective evolutionary algorithms (MaOEAs) fundamentally struggle to balance convergence and diversity within traditional single-population frameworks, often resulting in diversity loss and neglected objectives. To address these limitations, this paper proposes MPMO-OVV, integrating the multiple populations for multiple objectives (MPMO) framework with a novel one-vote veto (OVV) mechanism. Specifically, a customized reproduction strategy is first applied to the sub-populations, followed by an OVV-based environmental selection. This mechanism evaluates individuals by treating the convergence of the corresponding primary objective and the combined status of all remaining objectives as independent, veto-wielding criteria. Additionally, the archive component incorporates a customized reproduction strategy to prevent local optima entrapment and bridge spatial gaps between individuals. To further enhance search efficiency and information exchange, a two-round selection mechanism based on convergence and diversity metrics is implemented alongside a dedicated allocation strategy. Extensive experiments on 5- to 15-objective benchmarks and six real-world UAV emergency path planning problems validate the highly competitive and robust performance of MPMO-OVV against eight state-of-the-art MaOEAs.}
}
@article{ZUBAIR2026115708,
title = {Evaluating AI reasoning and prompt engineering in automated test case generation: A comparative study of GPT-4o, O1 models, and human QA},
journal = {Applied Soft Computing},
volume = {201},
pages = {115708},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115708},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011567},
author = {Muhammad Azlaan Zubair and Wided Bouchelligua and Sufyan Danish and Shabir Ahmad and Amel Ksibi},
keywords = {Generative AI, Automated TC generation, Software testing, Prompt engineering, Quality assurance, Large language models},
abstract = {The increased use of AI in SQA requires a strict analysis of AI models in TC generation. This paper examines the factuality of the advanced reasoning of Open AI (O1 series) being the distinguishing factor between Open AI and non reasoning models GPT 4o and human Quality Assurance (QA) engineers. To address this, we evaluated the performance of 12 experimental groups: human testers, eight variants of GPT 4o which used a variety of prompt engineering techniques (e.g., chain of thought, few shot, self consistency), and three variants of the O1 model in the generation of TCs on 11 software applications. The 3682 TCs were tested with the mixtral-8x7B-32768 model according to four criteria: Coverage, Clarity, ENC and NFC. The descriptive statistics indicated that there was consistently high coverage and high clarity among the groups but there was a significant difference in the capture of edge, negative and non-functional scenarios. Statistical analyses using both parametric and non parametric methods identified significant differences across several TC quality metrics depending on prompting strategy and underlying model architecture. Interestingly, AI models not only produced more TCs but also had a better QTQ ratio than human engineers under the conditions of receiving little contextual information. Finally, reasoning models have more structured outputs but may not yield significant performance improvement given the increased computational costs. Enhanced prompt engineering enables non-reasoning models to offer an efficient and effective alternative for TC generation, thereby underscoring the potential for AI integration in optimizing software testing processes. To facilitate replication and further research, an extensive dataset and fully documented codebase are available at the GitHub repository provided in the Contributions section.}
}
@article{HAN2026115692,
title = {TSCAD: Temporality-spectrum collective transformer for multivariate time series anomaly detection},
journal = {Applied Soft Computing},
volume = {201},
pages = {115692},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115692},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011403},
author = {Songwei Han and Jiangtao Cui and Luming Sun and Yingfan Liu and Ming Li and Youfang Leng},
keywords = {Multivariate time series, Anomaly detection, Transformer, Feature combination, Cross-dimensional correlations},
abstract = {Multivariate time series (MTS) anomaly detection (MTSAD) plays a vital role in Industrial Internet of Things (IIoT) systems, where edge devices must detect anomalies in streaming sensor data promptly and accurately under constrained computational resources. Recent transformer-based approaches have achieved SOTA performance in MTSAD by effectively capturing sequential dependencies. However, they still suffer from (1) insufficient modeling of MTS characteristics due to limited consideration of periodic patterns, frequency distributions and cross-dimensional correlations; and (2) high computational overhead due to multi-layered or multi-model architectures, resulting in a poor trade-off between accuracy and efficiency. To address these challenges, we propose TSCAD, a novel single-layer transformer architecture that jointly models temporal, spectral and cross-dimensional characteristics in a lightweight structure. Specifically, the Feature Alignment module enhances positional encoding with periodic and frequency-domain cues, while the Anomaly Detection module introduces a dual-stage collective attention mechanism to capture both intra-variable and inter-variable dependencies. This lightweight design enables TSCAD to capture rich MTS structures while maintaining high efficiency, eliminating the need for deep stacks or multiple sub-models. In addition, TSCAD adopts a modular, plug-and-play architecture, making it compatible with other transformer-based frameworks. Extensive evaluations on seven public datasets show that TSCAD outperforms SOTA methods in best F1-score and AVG R-PR by up to 16.29% and 6.38%, respectively, and accelerates training and inference by up to 9.4× and 9×.}
}
@article{GAZIOGLU2026115744,
title = {Variable neighborhood search enhancement for resource-constrained project scheduling with alternative subgraphs},
journal = {Applied Soft Computing},
volume = {201},
pages = {115744},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115744},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011920},
author = {Emrullah Gazioğlu},
keywords = {Project scheduling, Alternative subgraphs, Variable neighborhood search, Genetic algorithm},
abstract = {In this study, an improved Variable Neighborhood Search approach has been proposed for project scheduling problems containing alternative subgraphs. The mentioned problem type requires choosing among multiple execution paths for project components while optimizing activity sequences under resource constraints. In the study, five different neighborhood structures designed to systematically explore various regions of the solution space are introduced. These structures have been integrated with an existing Dynamic Genetic Algorithm framework. Neighborhood strategies focus on different aspects: optimizing activity sequencing, adjusting priority assignments, selecting alternative execution paths, organizing activity groups, and improving critical path strategies. Experimental validation on 6300 benchmark instances demonstrates 10.7% improvement over the Dynamic GA baseline, outperforming Tabu Search (10.6%) and CONH-2 (11.5%). Ablation study confirms complementary contributions from all neighborhoods. Statistical tests validate significance across all comparisons (p<0.001), with the approach achieving rank-1 position in 62.2% of instances.}
}
@article{CERDAFLORES2026115587,
title = {Sustainable design of biomethane and biohydrogen supply chains by implementing a hybrid AI-GA-based framework},
journal = {Applied Soft Computing},
volume = {201},
pages = {115587},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115587},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010355},
author = {Sandra Cecilia Cerda-Flores and Rogelio Ochoa-Barragán and José María Ponce-Ortega and Fabricio Nápoles-Rivera and Catherine Azzaro-Pantel},
keywords = {Waste-to-Energy, Biohydrogen, Supply Chain, Hybrid Models, Machine Learning},
abstract = {Net-zero is one of the most ambitious pathways to limit anthropogenic emissions and keep global warming levels below 2ºC. Biomethane and biohydrogen are two energy vectors considered key for the decarbonization of hard-to-abate sectors. This study evaluates the techno-economic performance of a waste-to-energy system producing biomethane and processing a portion of it into biohydrogen. Surrogate models trained on ASPEN simulations of the steam methane reforming (SMR) process are incorporated into the deterministic mathematical model, creating a hybrid model that implements genetic algorithms to optimise the supply chain design, with profit maximisation and water minimisation in the SMR process as the objective functions. The methodology was applied to the western region of Mexico as a case study, characterized by high biomass availability and industrial activity. A price sensitivity analysis identifies the price points at which the supply chain becomes economically viable, showing that the supply chain becomes profitable with biomethane and biohydrogen selling prices of 2.5 €/m3 and 5 €/kg, respectively. An optimal scenario balancing profits and end-user affordability was identified at a biomethane selling price of 3 €/m3 and a hydrogen selling price of 6 €/kg, yielding profits of 57.1 M€/year while minimising water consumption in the SMR process at 53,582 m3/month, achieved through the GA optimisation. A key finding of this analysis is the higher cost structure and lower hydrogen yield predicted by the surrogate models, which can capture inefficiencies that might otherwise be overlooked.}
}
@article{LAWRENCE2026115684,
title = {An enhanced multi-objective framework of artificial bee colony algorithm for sustainable power flow optimization in smart grids},
journal = {Applied Soft Computing},
volume = {201},
pages = {115684},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115684},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011324},
author = {Beena S. Lawrence and Philomina Simon},
keywords = {Multi-objective optimization, Artificial bee colony algorithm, Adaptive -dominance, Optimal power flow, Renewable energy integration, Smart grids},
abstract = {Renewable energy integration into the global power systems has introduced new challenges in its operational planning and decision-making. Apart from reshaping the modern power system, this trend has made the Optimal Power Flow(OPF) increasingly complex and inherently multi-objective in nature, demanding simultaneous optimization of cost, emissions, voltage stability, and renewable penetration. However, most of the existing metaheuristic methods for multi-objective optimization rely on scalarized formulations and lack efficient mechanisms for dominance management, diversity preservation, and external archiving, which restrict their ability to generate high-quality Pareto fronts. To address this gap, this study proposes Adaptive ϵ MOABC, an enhanced Multi-Objective Artificial Bee Colony framework that incorporates adaptive ϵ dominance, archived non-dominated sorting, and grid-based pruning to improve convergence and the quality of the Pareto front. The method is evaluated on standard benchmark test suites and applied to multi-objective OPF on IEEE 14-bus, 30-bus, and 57-bus systems incorporating renewable generation. Experimental results, when compared with state-of-the-art methods, demonstrate that the proposed method achieves significant performance improvements, with approximately 65–70% reduction in Generational Distance (GD) and 50–55% improvement in Inverted Generational Distance (IGD), indicating superior convergence and Pareto front coverage. The method also maintains controlled computational growth and consistent performance across different system sizes, confirming its robustness and scalability for large-scale multi-objective optimization in modern power systems.}
}
@article{YU2026115736,
title = {Reconstructing 3D reality in tunnels with unlit or low light using composite Gaussian filtering},
journal = {Applied Soft Computing},
volume = {201},
pages = {115736},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115736},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011841},
author = {Yongqiang Yu and Cong Guo and Lidan Fan and Jiyun Zhang and Liwei Yu and Peitao Li},
keywords = {Unlit tunnel, 3D reconstruction, Gaussian splatting, Composite filtering},
abstract = {Currently, tunnel visualization systems cannot provide convenient, immersive, realistic, and rapid visualization in low-light or unlit environments, making it difficult to meet the risk management and emergency response needs of large, water-rich, deeply buried tunnels. The paper proposes 3D reconstruction methods based on composite Gaussian filtering to address this issue. The method uses a mobile light source for supplemental illumination. Through Depth Filtration, Mask Filtration, and Post-Processing Filtration, artifacts resulting from inconsistent lighting are reduced by 9.18%, 11.76%, and 97.09%, respectively. Concurrently, Depth Filtration improves the average PSNR, SSIM, and LPIPS of tunnel 3D reconstruction by 1.89%, 1.32%, and 1.60%, respectively. Mask Filtration and Post-Processing Filtration ensure that 3D tunnel models retain rich details. In comprehensive comparative experiments, the proposed method achieved better 3D reconstruction results than other models. All of these indicate that composite Gaussian filtering can adapt to unlit or low-light environments in 3D tunnel reconstruction, demonstrating the effectiveness and necessity of Depth Filtration, Mask Filtration, and Post-Processing Filtration.}
}
@article{RAFI2026115622,
title = {Path planning and trajectory tracking using type-2/type-3 fuzzy control and bio-inspired optimization for autonomous mobile robots},
journal = {Applied Soft Computing},
volume = {201},
pages = {115622},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115622},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010707},
author = {A.R. Rafi and F. Baghbani and Ardashir Mohammadzadeh},
keywords = {Robotic, Fuzzy control, Fuzzy logic, Trajectory Tracking, Four-wheeled mobile robot, Dragonfly algorithm, Reptile search algorithm},
abstract = {This paper presents an applied soft-computing framework that integrates an intelligent path planning scheme with a fuzzy tracking controller. A bio-inspired path planning is developed based on Dragonfly-Algorithm (DA) to generate smooth and collision free reference trajectories. In the suggested approach, there is no need for line-following sensors. For trajectory tracking, a Type-3 fuzzy logic system (FLS) is developed, and a novel online learning mechanism based on the Reptile Search Algorithm (RSA) is introduced for adaptive tuning. A comprehensive comparative study is conducted against classical PID, fractional-order PID (FOPID), IT2-FLS, fuzzy-PID, and fuzzy-FOPID controllers. All controllers are implemented on a four-wheel, two-motor differential-drive robot model. The proposed controllers are evaluated across two environments containing static obstacles and nine dynamically moving obstacles. Performance is examined using position-tracking error metrics, path-length deviation, heading and speed errors, and computational cost. The results demonstrate that the introduced framework improves tracking accuracy and robustness while maintaining competitive computational efficiency.}
}
@article{AKELLA2026115703,
title = {Dynamic self-attention: A lightweight and interpretable attention module for plant disease classification},
journal = {Applied Soft Computing},
volume = {201},
pages = {115703},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115703},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011518},
author = {Gopi Krishna Akella and Santoso Wibowo and Srimannarayana Grandhi and Fariza Sabrina and Sameera Mubarak},
keywords = {Deep learning, Dynamic attention maps, Convolutional neural networks, Self-attention mechanism, Plant disease classification, Interpretability},
abstract = {Accurate and interpretable plant disease classification remains a key challenge in precision agriculture, where subtle visual symptoms and complex backgrounds complicate reliable detection. While deep learning has advanced performance in this domain, most existing models lack adaptability and offer limited transparency in their decision-making processes. This study proposes Dynamic Self-Attention (DSA) mechanism – a lightweight, input-adaptive module that dynamically emphasizes disease-relevant features such as lesions, edge deformations, and discolorations, while suppressing irrelevant background information. Designed for modular integration, DSA plugs seamlessly into standard convolutional backbones without requiring changes to the underlying architecture. Evaluated on a large-scale, multi-class grape leaf disease dataset comprising 9027 images, the DSA model achieved a state-of-the-art test accuracy of 99.34%, outperforming leading architectures including VGG16, DenseNet121, ResNet50, MobileNetV2, ConvNeXt, and Vision Transformers. Beyond quantitative gains, interpretability analysis using Grad-CAM and DSA attention maps revealed sharply localized focus on pathological regions, validating the model’s diagnostic reliability. These results position DSA as a robust and explainable plug-and-play attention mechanism, well-suited for deployment in real-world agricultural settings, especially in environments with limited computational resources.}
}
@article{CHEN2026115675,
title = {Bridging the visible-infrared gap: Unsupervised person Re-ID via adaptive counterfactual learning and dual-modality data augmentation},
journal = {Applied Soft Computing},
volume = {201},
pages = {115675},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115675},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011233},
author = {Feng Chen and Guo Li and Wei Huo and Yang Liu},
keywords = {Person re-identification, Unsupervised learning, Data augmentation, Counterfactual reasoning, Cross-modal matching},
abstract = {Visible-infrared cross-modal person re-identification (VI-ReID) faces significant challenges introduced by the inherent cross-modal disparities across different cameras. To address this issue, this paper proposes a novel VI-ReID framework based on Dual-modality Data Augmentation (DDA) and Adaptive Counterfactual Intervention (ACI). Specifically, in the DDA module, we inject the hue and saturation information of the visible images into the infrared samples in HSV color space. Then, the data augmentation in two modalities can be implemented via adjusting the hue, saturation, and brightness. Furthermore, we present an adaptive counterfactual reasoning strategy to construct counterfactual terms by adaptively weighted fusion of noisy and hard negative features, which effectively optimizes the cross-modal correspondence between visible and infrared features. Extensive experimental results on three popular VI-ReID datasets demonstrate the effectiveness and superiority of the proposed method.}
}
@article{LI2026115727,
title = {Spatiotemporal density peaks clustering algorithm based on local covariance and shared spatiotemporal nearest neighbors},
journal = {Applied Soft Computing},
volume = {201},
pages = {115727},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115727},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011750},
author = {Fan Li and Weitao Zhu and Jeng-Shyang Pan and Ivan Lee},
keywords = {Spatiotemporal clustering, Density peaks clustering, Local covariance, Shared spatiotemporal nearest neighbors},
abstract = {In spatiotemporal scenarios, the density peaks clustering algorithm typically relies on Euclidean distance without distinguishing spatial and temporal attributes, leading to insufficient representation of spatiotemporal relationships. The algorithm’s local density ignores temporal features, hindering the identification of cluster centers. Additionally, the one-step assignment strategy amplifies errors without a correction mechanism, causing unreasonable cluster assignments. To address these issues, this paper proposes a spatiotemporal density peaks clustering algorithm based on local covariance and shared spatiotemporal nearest neighbors. Local covariance is employed to construct Mahalanobis distance to replace Euclidean distance, so that the weights of temporal and spatial dimensions can be automatically adjusted. The temporal attribute is incorporated into local density calculation through a similarity matrix integrating shared spatiotemporal nearest neighbors and local-covariance-based Mahalanobis distance. Based on this matrix, a shared spatiotemporal nearest neighbor local density is further defined to ensure reliable cluster center selection. Moreover, a two-step assignment strategy combining maximum similarity assignment and nearest higher density assignment, along with local outlier factor, enhances boundary sample assignment accuracy by detecting anomalous samples. Experiments on synthetic and earthquake datasets demonstrate that the proposed algorithm achieves favorable clustering accuracy and stability across diverse data distributions and complex spatiotemporal patterns.}
}
@article{AKBULUT2026115699,
title = {Artificial bee colony with momentum-guided search and starfish exploration for complex and multimodal problems},
journal = {Applied Soft Computing},
volume = {201},
pages = {115699},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115699},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011476},
author = {Harun Akbulut},
keywords = {Artificial Bee Colony, Starfish-Inspired Optimization, Hybrid Metaheuristic Optimization, Complex and Multimodal Optimization, Hyperparameter Optimization},
abstract = {The Artificial Bee Colony (ABC) algorithm is a widely used swarm intelligence method due to its simple structure and strong exploitation capability. However, it may experience performance loss in complex and multi-modal optimization problems due to its limited exploration capability and tendency toward early convergence. In this study, an optimization algorithm called Momentum-Guided Search and Starfish Exploration-based Artificial Bee Colony (MSE-ABC) is proposed to overcome these limitations. The proposed method preserves the observer and scout bee phases employed in the classical ABC algorithm while enhancing its global search capability with trigonometric exploration operators inspired by starfish optimization algorithm (SFOA). Furthermore, a momentum-based steering mechanism and dynamic exponential step size control are integrated to accelerate convergence during the search process and adaptively maintain the exploration-exploitation balance. The performance of the MSE-ABC algorithm was comprehensively evaluated through CEC 2022 benchmark tests, a five different real-world engineering design optimization problems, and deep learning hyperparameter optimization experiments conducted on the CIFAR-10 datasets. Experimental results demonstrate that the proposed method achieves superior or competitive performance when compared with eight state-of-the-art metaheuristic algorithms. The statistical significance of the obtained results was verified using the Wilcoxon signed-rank test and the Friedman test. The findings reveal that the MSE-ABC algorithm offers an effective and reliable optimization approach for complex and multi-modal optimization problems.}
}
@article{SONG2026115719,
title = {A tri-archive coordinated artificial bee colony algorithm for multi-objective optimization},
journal = {Applied Soft Computing},
volume = {201},
pages = {115719},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115719},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011671},
author = {Chunlin Song and Lanlan Dong and Yingjie Song},
keywords = {Multi-objective optimization, Artificial bee colony algorithm, Tri-archive coordinated optimization, Unmanned aerial vehicle path planning},
abstract = {Multi-objective optimization plays a critical role in complex engineering applications. Although the artificial bee colony algorithm has demonstrated promising performance in single-objective optimization, its direct extension to multi-objective scenarios often suffers from insufficient coordination among search phases and an imbalance between convergence and diversity. To address these limitations, this paper proposes a Tri-Archive Coordinated Multi-objective Artificial Bee Colony Algorithm (TA-ABC). The method introduces a tri-archive cooperative evolutionary mechanism, consisting of a forward exploration archive, a diversity archive, and an elite archive, which respectively guide the employed, onlooker, and scout bee phases. By explicitly modeling the functional roles and interactions among different search phases, TA-ABC achieves a more effective balance between exploration and exploitation. In addition, an environmental selection strategy based on elite archive mapping and clustering is developed. By projecting solutions onto a reference hyperplane constructed from the elite archive and performing clustering-based selection, the proposed method effectively captures the structural relationships in the objective space, thereby improving both convergence quality and distribution uniformity. Extensive experiments on benchmark multi-objective problems demonstrate that TA-ABC consistently outperforms several state-of-the-art algorithms in terms of convergence and solution distribution. Furthermore, its application to a constrained unmanned aerial vehicle path planning problem shows that the proposed method can generate feasible, smooth, and risk-aware paths in complex three-dimensional environments.}
}
@article{ZHANG2026115630,
title = {Integrating linguistic distribution assessment into the graph model with application to the conflicts on contemporary urban renewal},
journal = {Applied Soft Computing},
volume = {201},
pages = {115630},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115630},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010781},
author = {Feng Zhang and Zhimin Zhang and Ying Li},
keywords = {The graph model for conflict resolution (GMCR), Linguistic distribution assessment (LDA), PROMRTHEE Ⅱ method, The cumulative dynamic prospect theory, Contemporary urban renewal},
abstract = {The graph model for conflict resolution (GMCR) is a widely used tool for addressing complex decision-making conflicts. However, in fuzzy and uncertain environments, traditional GMCR struggles with incomplete preference information, the bounded rationality of decision-makers (DMs), and a lack of theoretical grounding in preference ranking methods. To address these gaps, this paper proposes an improved GMCR approach based on linguistic distribution assessment (LDA). Firstly, to capture the complete preference information of DMs, LDA is introduced into GMCR. Next, a combined ranking method integrating cumulative dynamic prospect theory with PROMETHEE II method is developed, which not only quantifies risk attitudes but also strengthens the theoretical foundation of ranking while aligning with DMs' bounded rationality. Subsequently, five new stability definitions under the LDA environment are proposed to enrich the application scenarios of GMCR. Finally, the proposed model is applied to a contemporary urban renewal conflict for comprehensive modeling and analysis. The results indicate that: (1) the global equilibrium solution of the conflict is that the government fully implements the urban renewal plan, and developers and residents choose to actively participate and support it; (2) attribute weights and risk attitudes exert a significantly greater influence on residents' rankings than on developers', with residents showing the highest sensitivity to the financial compensation attribute and the degree of risk pessimism; and (3) the optimal solution identified by the proposed model is consistent with multiple methods, and it demonstrates superior discrimination in multiple dimensions.}
}
@article{GUO2026115691,
title = {CEBP-HG: Hypergraph-regularized multi-subspace ensemble learning for robust unsupervised feature selection},
journal = {Applied Soft Computing},
volume = {201},
pages = {115691},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115691},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011397},
author = {Cong Guo and Zilong Li and Changqin Huang and Xiaodi Huang},
keywords = {Feature selection, Unsupervised learning, Multi-subspace clustering, Ensemble learning, Hypergraph learning},
abstract = {Unsupervised feature selection (UFS) is crucial for identifying discriminative features in high dimensional unlabeled data, but existing methods remain limited by noise-prone pseudo-labels and the weak expressiveness of pairwise graph structures. To address these challenges, this paper proposes CEBP-HG, a novel unsupervised feature selection method that combines multi-subspace cluster ensembling with hypergraph regularization. Specifically, CEBP-HG first partitions the original feature space into multiple random subspace sets and performs independent clustering within each subspace. By ensembling these diverse clustering results, the method generates more stable and robust binary pseudo-labels that better approximate real-world label distributions. Furthermore, hypergraph regularization is employed to explore higher-order local instance relationships, enabling the capture of complex structural patterns beyond pairwise connections. Experimental evaluations on 13 datasets demonstrate that our algorithm consistently outperforms 15 state-of-the-art methods across 2 evaluation metrics. Moreover, our method achieves the highest overall performance ranking and exceeds the second-best approach by at least 2.71 ranks for each evaluation metric.}
}
@article{LI2026115711,
title = {Mean-teacher-based semi-supervised learning framework for scalable indoor localization using Wi-Fi RSSI fingerprinting},
journal = {Applied Soft Computing},
volume = {201},
pages = {115711},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115711},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011592},
author = {Sihao Li and Zhe Tang and Kyeong Soo Kim and Jeremy S. Smith},
keywords = {Multi-building multi-floor indoor localization, Wi-fi RSSI fingerprinting, Semi-supervised learning, Mean teacher, Dynamic training, Static training},
abstract = {Conventional large-scale indoor localization based on Wi-Fi RSSI fingerprinting faces the three main issues of concern: Time-consuming and labor-intensive labeled data collection, limited generalization of a model trained under a supervised learning (SL) framework due to its inability to leverage unlabeled data, and model performance degradation in dynamic scenarios with environmental variations. To address these challenging issues, we propose a comprehensive semi-supervised learning (SSL) framework for a deep neural network (DNN) localization model based on the Mean Teacher, which incorporates access point selection, model pre-training/cloning, and batch-level noise injection. The proposed SSL framework can not only efficiently use hybrid labeled/unlabeled databases for static training of a model during the offline phase, but also exploit unlabeled fingerprints from users of the indoor localization system deployed in the field for continuous retraining of the model during the online phase. We base the proposed SSL framework on the Mean Teacher because it can generate more stable target labels through an exponential moving average of model weights without incurring the high computational complexity of the Pi-Model and with better scalability for online learning than Temporal Ensembling, making it an optimal choice that strikes the right balance between performance and computational complexity in large-scale indoor localization. With the UJIIndoorLoc database, the proposed SSL framework reduces the mean 3D errors of the CNNLoc and SIMO-DNN models by 7.40% and 7.75%, respectively, compared with those under the conventional SL framework; with the XJTLU dynamic database, the maximum reduction in mean 2D error reaches up to 49.23% under a dynamic training scenario, demonstrating the substantial performance improvement achieved by the proposed SSL framework.}
}
@article{MA2026115634,
title = {Courier satisfaction assessment on crowdsourcing platforms: A data-driven framework integrating text mining and large-scale group decision-making},
journal = {Applied Soft Computing},
volume = {201},
pages = {115634},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115634},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010823},
author = {Yu Ma and Meiguang Zhu},
keywords = {Crowdsourcing platforms, Courier satisfaction, Large-scale group decision-making, Text mining, Sentiment analysis},
abstract = {The rapid growth of the crowdsourcing economy has made courier satisfaction crucial to platform sustainability and labor governance. However, its measurement remains challenging, as surveys are vulnerable to subjective bias and heterogeneous preferences, while online reviews require effective methods to convert unstructured feedback into usable evaluation evidence. To address these issues, this study proposes a hybrid evaluation framework that integrates text mining and large-scale group decision-making (LSGDM) for theme-level courier satisfaction assessment. In the text-mining stage, BERTopic is used to identify satisfaction themes from online reviews, providing a data-driven basis for questionnaire design. Qwen3-4B is then applied to estimate sentiment tendencies under each theme, and these tendencies serve as important references for the final satisfaction evaluation. In the decision-modeling stage, the label propagation algorithm (LPA) is used to cluster the distributed linguistic trust function (DLTF) evaluations provided by 105 couriers. A consensus-reaching mechanism based on positive and negative ideal solutions is then introduced under each satisfaction theme to obtain theme-level satisfaction scores at the decision stage. This mechanism can identify subgroups with divergent opinions and provide targeted feedback for preference adjustment. Comparative experiments and sensitivity analysis show that the proposed model reaches consensus with fewer iterations and faster convergence, while maintaining an adjustment cost broadly comparable to that of the minimum cost consensus model (MCCM). Within the same thematic space, the comparison between the two types of scores shows that couriers express relatively positive evaluations of delivery volume and work flexibility, but form a clear negative consensus on income. Further analysis indicates that income dissatisfaction mainly stems from perceived unfairness in income distribution caused by algorithmic dispatching. These findings offer practical implications for promoting human-centered algorithmic governance on crowdsourcing platforms.}
}
@article{ZHONG2026115695,
title = {A fast incremental Kriging-assisted algorithm for online optimization},
journal = {Applied Soft Computing},
volume = {201},
pages = {115695},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115695},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011439},
author = {Weipeng Zhong and Zaixian Chen and Changle Peng and Cheng Chen},
keywords = {Incremental Kriging, Online optimization, Time-varying system, Recursive system, Model updating},
abstract = {The Kriging model is a popular surrogate for black-box function optimization due to its ability to provide uncertainty estimates. However, its high training cost has traditionally limited its use in online optimization. In this study, we present a fast incremental Kriging-assisted online optimization algorithm, specifically designed to address this limitation. Different hyperparameter computation strategies are formulated and tailored for real-time and non-real-time applications. The update formulas of the Cholesky decomposition of correlation matrix are derived for the correlation matrix updating, enabling efficient incremental model construction with computational complexity of O((N-1)2) when adding and removing samples. The samples farthest from the current step will be removed. The expected improvement (EI) criterion guides the selection of new samples, while the correlation matrix and the optimal sample from the previous step are transferred to the current step. An optimal Latin hypercube design (OLHD) ensures the uniform candidate sampling and consistent computational cost for EI calculation. The effectiveness of the proposed algorithm has been demonstrated through four numerical experiments. The results show that it can efficiently perform online optimization and parameter identification in both time-varying and recursive systems, exhibiting clear advantages over some existing algorithms. Moreover, the method maintains robust performance even under variations in initial values, noise, and model errors.}
}
@article{MADHAVU2026115718,
title = {Gradient histogram pattern matched deep convolutive neural learning based reversible data hiding for secure communication of medical data in images},
journal = {Applied Soft Computing},
volume = {201},
pages = {115718},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115718},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601166X},
author = {Minu Lalitha Madhavu and KS Anil Kumar},
keywords = {Secure communication, Brain MRI image, Deep convolution neural network, Reversible Data Hiding, Gaussian distributive anisotropic texture filter, Gradient regulated histogram predictor, Least weighted pattern matching revisited embedding, Extraction process},
abstract = {Data security plays a vital role in data sharing in telemedicine and e-health systems applications. The digitalization of data has increased the efficiency, speed, and the data vulnerable to cyber-attacks. However, to ensure the overall security of medical data (images), security measures have to be taken at each step, from the beginning, during and after the transmission of medical images. An efficient model is needed to ensure the security and integrity of the patient’s diagnostic data transmitted and received through the network. A novel GRadient HIstogram Pattern Matched Deep Convolutive Neural Learning based REversible Data Hiding (GRIDEH) is developed to improve the security of communication in the healthcare system. The proposed GRIDEH method includes three different processes namely preprocessing, Data embedding, and data extraction that are implemented into deep convolutive neural learning. The deep convolutive neural learning consists of the input layer, an output layer, three hidden layers such as convolutional layer, a max pooling layer, and a fully connected layer for performing the reversible data hiding process. First, the number of brain MRI images and secret patient data are given to the input layer. The input is transferred into the convolutional layer where the preprocessing is carried out to improve image quality using a Gaussian distributive anisotropic texture filter and gradient regulated histogram predictor is applied to find the current pixel intensity for embedding. After that, the data embedding process is performed in the max polling layer by using the least weighted pattern matching revisited embedding method. With the embedding process, the stego image is obtained and sent to the receiver. Finally, the extraction process is performed at a fully connected layer to retrieve the original secret data and cover MRI brain image at the output layer. In this way, secure communication between sender and receiver is performed. Experimental evaluation is carried out using an MRI brain image dataset on factors such as run time, computational overhead, peak signal-to-noise ratio, SSIM, embedding rate and bit error rate with respect to thesizes of images. The quantitatively analyzed results demonstrate the better performance of our proposed technique when compared with the existing methods.}
}
@article{HUANG2026115739,
title = {Edge embedding with global and local information fusion for community detection in complex networks},
journal = {Applied Soft Computing},
volume = {201},
pages = {115739},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115739},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011877},
author = {Yanchao Huang and Jian Wang and Mingyue Wang and Ruili Wang and Yanmei Hu and Biao Cai},
keywords = {Community detection, Edge-level feature fusion, Multimodal edge representations, Modularity optimization},
abstract = {Community detection plays a crucial role in analyzing complex networks, including social and biological networks. However, current approaches often do not fully capture edge-level structural characteristics or effectively integrate multimodal information, resulting in unstable performance in networks with ambiguous boundaries and complex structures. We address these issues by proposing EdgeFusionNet, a novel edge-centric community detection framework comprising three core components. First, a parameter-free graph convolutional encoder extracts global node semantics from the network structure. Second, a multimodal edge representation module fuses local edge patterns with these global node semantics, generating discriminative edge embeddings. Third, a modularity-driven community aggregation algorithm iteratively refines community partitions through local node movement and community merging governed by a linearly decaying threshold, ultimately yielding globally optimized community structures. While recent research has begun to explore edge-centric formulations, EdgeFusionNet advances this paradigm by systematically addressing the key limitations of existing methods. Experimental results show that, compared with prevailing mainstream approaches across multiple real-world complex network datasets, the proposed method performs competitively or better while exhibiting consistent generalization capabilities and robustness.}
}
@article{XU2026115731,
title = {Medical image captioning with Swin Transformer and ClinicalBERT via gated multimodal fusion},
journal = {Applied Soft Computing},
volume = {201},
pages = {115731},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115731},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011798},
author = {Xiang Xu and Xiuwen Wu and Hongwei Zhang and Kai Ma},
keywords = {Medical Image Report Generation, Multimodal Learning, Swin Transformer, ClinicalBERT, Gating Mechanism},
abstract = {Automatic medical image report generation requires both accurate visual recognition and professional medical language expression. However, existing approaches often suffer from insufficient image-text semantic alignment or a lack of domain-specific language modeling. To address these limitations, we propose SGIC, a multimodal image captioning model that integrates Swin Transformer, ClinicalBERT, and a gated decoder. The model leverages the hierarchical shifted-window attention mechanism of Swin Transformer to extract fine-grained visual representations, incorporates ClinicalBERT for medical semantic modeling, and employs a gating mechanism to dynamically regulate the fusion of visual and linguistic information, thereby achieving more effective cross-modal alignment and more medically accurate text generation. Experiments on the ROCO dataset demonstrate the effectiveness of SGIC, showing significant improvements over several competitive baselines in BLEU-4, ROUGE-L, METEOR, and CIDEr, with BLEU-4 reaching 0.242 and ROUGE-L 0.401. The results demonstrate that SGIC not only improves automatic medical image captioning performance and shows potential in generating more coherent and medically relevant descriptions, but also validates the potential of Swin Transformer for medical image captioning, offering new insights into cross-modal fusion and the development of medically oriented automated reporting systems.}
}
@article{SIVIERO2026115610,
title = {A multi-objective Gaussian mixture-based estimation of distribution algorithm for structural design optimization},
journal = {Applied Soft Computing},
volume = {201},
pages = {115610},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115610},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626010586},
author = {Mattia Siviero and Jonathan Melchiorre and Marco M. Rosso and Giansalvo Cirrincione and Giuseppe C. Marano},
keywords = {Structural optimization, Multi-objective optimization, Estimation of distribution algorithm (EDA), Gaussian mixture model (GMM), Metaheuristic algorithms, Evolutionary computation},
abstract = {Structural design optimization in the Architecture–Engineering–Construction (AEC) domain often involves complex, constrained and computationally intensive tasks. These problems are typically formulated as constrained multi-objective optimization tasks, where conflicting objectives, such as cost, sustainability, and constructability, must be balanced subject to structural performance requirements. In this context, population-based metaheuristics are effective for navigating black-box and non-convex design spaces. Among these, Estimation of Distribution Algorithms (EDAs) are well suited for this purpose, as they guide search through learned probability distributions over high-performing regions. This study introduces MOEDA-GMM, a multi-objective EDA that models the selected population using a Gaussian Mixture Model fitted via Expectation-Maximization. A power-law covariance decay schedule governs the transition from exploration to exploitation. The algorithm is evaluated on four constrained structural benchmarks and three analytical test functions, and compared against NSGA-II, SMS-EMOA, and RVEA under equal evaluation budgets. A factorial sensitivity analysis of the three hyperparameters and non-parametric statistical tests support the comparison. MOEDA-GMM shows rapid early-stage convergence and significantly outperforms NSGA-II on two structural problems, while established algorithms retain a final-convergence advantage on the analytical suite. The sensitivity analysis identifies a compact region of robust settings across problems, confirming the viability of mixture-model EDAs for constrained structural optimization under limited evaluation budgets.}
}
@article{LENG2026115655,
title = {Causal risk diagnosis of building-integrated photovoltaics: A hybrid BERT-DEMATEL framework with uncertainty quantification},
journal = {Applied Soft Computing},
volume = {201},
pages = {115655},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115655},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011038},
author = {Jie Leng and Caiyun Lu and Mingyang Guo},
keywords = {Building-Integrated Photovoltaics (BIPV), Causal risk diagnosis, BERT, DEMATEL, Uncertainty quantification},
abstract = {Building-Integrated Photovoltaics (BIPV) is pivotal for Net-Zero Energy Buildings (NZEB), yet its systemic risks challenge conventional, fragmented management approaches. This study proposes a hybrid causal diagnosis framework that integrates bidirectional encoder representations from Transformers (BERT) with the Decision Making Trial and Evaluation Laboratory (DEMATEL) method. Addressing the deterministic limitations of prior causal models, the framework embeds a Monte Carlo simulation protocol for explicit uncertainty quantification, yielding probabilistic confidence bounds for risk identification and causal influence strength.Synthesizing evidence from 12,300 heterogeneous documents—including industry reports, incident narratives, and practitioner discourse—alongside stratified expert insights, we construct a robust causal risk network. The results identify Ambiguous Responsibility and Cost-First Decision Culture as the primary organizational root causes that govern technical failures. A critical finding reveals a risk entrenchment mechanism within the inferred causal structure, where technical failures (e.g., Electrical Faults) retroactively amplify systemic vulnerabilities, forming a non-linear reinforcing feedback pattern. Robustness is confirmed via sensitivity analysis of fusion parameters and comparative benchmarking against expert-only and purely data-driven baselines. Theoretically advancing the theory of organizational accidents for complex building systems, the proposed framework provides stakeholders with a scalable, evidence-based tool for proactive risk mitigation.}
}
@article{OKUWOBI2026115707,
title = {Neuro-symbolic evolutionary networks: Bridging logic and learning for smarter AI},
journal = {Applied Soft Computing},
volume = {201},
pages = {115707},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115707},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011555},
author = {Idowu Paul Okuwobi and Jingyuan Liu and Olayinka Susan Raji and Funsho Olusola Abiodun},
keywords = {Neuro-symbolic AI, Evolutionary optimization, Modular neural networks, Memory-augmented learning, Meta-learning},
abstract = {Artificial intelligence has made significant strides with deep learning, yet critical challenges remain in generalization, adaptability, and interpretability. To address these limitations, we propose Neuro-Symbolic Evolutionary Networks (NSEN), a novel hybrid framework that integrates modular neural architectures, symbolic reasoning, and evolutionary optimization into a unified system. NSEN leverages modular neural components for specialized task execution, symbolic knowledge representation for structured reasoning, and evolutionary algorithms for dynamic optimization of both parameters and network structure. A memory-augmented subsystem, comprising episodic, semantic, and procedural memory, enables efficient knowledge storage and retrieval, while meta-learning mechanisms facilitate continuous self-improvement. This architecture allows NSEN to achieve better generalization, computational efficiency, and adaptability across diverse tasks. Unlike traditional deep learning models, NSEN dynamically reconfigures its structure in response to new environments, ensuring scalability and robustness. Furthermore, the integration of symbolic reasoning enhances logical consistency and decision-making transparency, addressing the "black-box" nature of conventional neural networks. We evaluate NSEN on a range of benchmarks, including image recognition, reinforcement learning, and commonsense reasoning, demonstrating state-of-the-art ability in accuracy, resource utilization, and cross-domain generalization. Experimental results highlight NSEN’s potential in real-world applications such as autonomous systems, healthcare, and scientific discovery. By combining the strengths of neural computation, symbolic AI, and evolutionary optimization, NSEN represents a transformative step toward next-generation artificial intelligence. The proposed framework not only addresses key shortcomings of current methods but also opens new direction in creative problem-solving and lifelong learning.}
}