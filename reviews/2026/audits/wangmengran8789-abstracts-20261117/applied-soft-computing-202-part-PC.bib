@article{HE2026115823,
title = {DSP-YOLO11n: An efficient enhancement for real-time benthos detection},
journal = {Applied Soft Computing},
volume = {202},
pages = {115823},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115823},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012718},
author = {Jianbo He and Qi Chen},
keywords = {Underwater object detection, YOLO11, Deep learning, Unmanned underwater vehicles, Benthic organisms},
abstract = {Unmanned underwater vehicles (UUVs) have emerged as an important tool for monitoring and detecting aquatic organisms, particularly benthic species such as sea urchins and sea cucumbers. However, the embedded processors used in UUVs suffer from limited computational power due to energy supply and space constraints, making them unable to run most existing deep learning algorithms. To address this challenge, this paper proposes DSP-YOLO11n, a real-time object detector that achieves a favorable balance between accuracy and inference speed for underwater benthic organism detection on UUVs. First, the dynamic upsampler DySample is adopted and tuned to enhance feature alignment while preserving fine boundary details with minimal overhead. Second, the SDI module, originally proposed for medical image segmentation, is applied for the first time to underwater benthos detection to recalibrate spatial and channel responses, suppress seabed background interference, and enhance small-target cues. Third, an extended P2 (stride-4) detection head is designed to integrate the tuned DySample and SDI into an additional top-down stage, enabling denser high-resolution predictions and improving the localization accuracy and recall for benthic organisms. On the URPC (2019-2020) dataset, DSP-YOLO11n achieves 85.14% mAP@0.5 and 50.55% mAP@0.5:0.95, improving over the baseline by 3.86% and 3.40%, while running at 152 FPS on a desktop GPU and 36 FPS on the Jetson Xavier NX with 3.90 M parameters. Compared with mainstream detectors, DSP-YOLO11n offers a more favorable accuracy-speed trade-off, making it well-suited for deployment on resource-constrained UUVs for real-time underwater benthos detection.}
}
@article{BAI2026115912,
title = {A systematic analysis of LLM backdoor-integrated cyberattacks: Feasibility, impact factors, and realistic case studies in agent systems},
journal = {Applied Soft Computing},
volume = {202},
pages = {115912},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115912},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013608},
author = {Yang Bai and Gaojie Xing and Heli Zheng and Zihao Wang and Zhihong Rao and Li Du and Zhan Qin and Yiming Li and Chuan Ma and Yimin Zhou and Kui Ren},
keywords = {Cyberattack, Backdoor attack, Cybersecurity, AI security},
abstract = {The rapid advancement of artificial intelligence (AI), especially large language models (LLMs) and LLM-based agents, has enabled a wide range of practical applications, while also introducing increasingly complex security risks. In particular, backdoor vulnerabilities in LLMs may propagate into agent-based systems, raising concerns about how such vulnerabilities behave within broader cyberattack settings across different system components. However, existing studies mainly focus on backdoor insertion during training or fine-tuning, with limited understanding of their interactions with downstream agent behaviors and their effects across diverse cyberattack types, model architectures, and key impact factors. To address this gap, this paper proposes a LLM backdoor-integrated cyberattack framework. We design a five-stage attack flow, characterizing the progression from poisoned data construction to final attack execution. We conduct in-depth analysis of the evolution of the attack surface, highlighting distinctions from previous attacks. Extensive empirical evaluations cover 5 representative LLM-based agent configurations and 4 realistic scenarios including simulation verification, flight control, database interaction, and remote healthcare. In each scenario, we evaluate feasibility and effectiveness, achieving success rates approaching or reaching 100%, while preserving agent functionality in benign conditions. Case studies under 3 cyberattacks cover the 4 aforementioned scenarios. Systematic analysis of impact factors reveals the influence of poisoning ratio, model scale, trigger design, fine-tuning method, data volume, and epoch on success and stealth of the proposed attack. These findings establish a strong empirical foundation for future defense strategies and offer critical insights into the evolving threat landscape of AI systems.}
}
@article{ZHANG2026115970,
title = {One subspace to fool them all: A unified black-box attack on perception models in embodied intelligence},
journal = {Applied Soft Computing},
volume = {202},
pages = {115970},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115970},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014183},
author = {Ximin Zhang and Jinyin Chen and Zhuo Zhao and Haibin Zheng},
keywords = {Embodied intelligence security, Black-box physical adversarial attack, Adversarial subspace, LVLMs},
abstract = {Embodied intelligence (EI) integrates Deep Neural Networks (DNNs) and Large Vision-Language Models (LVLMs) into their perception stacks, combining low-level visual recognition with high-level semantic reasoning. This hybrid design, however, demands rigorous adversarial evaluation to uncover joint vulnerabilities and guide effective defenses. Existing attacks typically target either DNNs or LVLMs in isolation, failing to generalize across the full perception stack, thereby limiting their applicability in security scenarios. This paper presents UniSub, a unified subspace-based black-box adversarial attack designed to simultaneously attack DNNs and LVLMs in EI perception models. UniSub distinguishes itself by: (1) transferability - aligning adversarial subspaces across diverse surrogate models to capture universally exploitable gradients, significantly improving attack success rates on unseen models; (2) efficiency - restricting perturbation optimization to a PCA-derived low-dimensional subspace for faster convergence without sacrificing performance; (3) reproducibility - integrating a differentiable renderer and causal prompt generator to fuse perturbations with semantically valid backgrounds, ensuring persistent adversarial effects across physical realizations. Extensive experiments show that UniSub significantly improves transferability (with higher ASR ∼×1.37 in digital) and reproducibility (with higher ASR ∼×2.14 in physical). This work exposes emerging vulnerabilities in EIs’ perception models and offers a practical framework for unified adversarial testing.}
}
@article{FENGJUN2026115908,
title = {A graph convolution spatial transformer network based on temporal velocity cross-attention for two-dimensional to three-dimensional human pose estimation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115908},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115908},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013566},
author = {Shang Fengjun and Gong Hanchao},
keywords = {Human Pose Estimation, Transformer, Graph Attention, Cross Attention},
abstract = {With the development of computer vision and machine learning, three-dimensional (3D) human pose estimation has become a highly scrutinized research direction. Accurately capturing and understanding human poses holds significant importance for numerous applications in the real world, such as computer animation, human-computer interaction, and motion analysis. Particularly, the estimation of three-dimensional human poses based on monocular RGB videos holds immense potential in the future. Recently, Transformer-based solutions have achieved significant success in three-dimensional human pose estimation. However, relying solely on Transformers may not accurately capture the local dependencies among various joints of the human body. This paper innovates upon the basic Transformer network's multi-head self-attention mechanism and proposes the following the network for three-dimensional human pose estimation, that is, the temporal-velocity cross-attention based Graph Spatial Transformer (TVC-GSFormer), which includes spatial transformer module, Graph Convolutional Network Transformer (GCNFormer) and Temporal Velocity Cross-attention Transformer(TVCFormer). Similarly, this network employs the method of elevating two-dimensional (2D) keypoints to three-dimensional space. In recent years, the average joint velocity error in three-dimensional human pose estimation has garnered attention from some researchers. This network mitigates the average joint velocity error in predicted results while enhancing the network's learning capacity for temporal dynamics of human poses by designing a velocity cross-attention module fused with temporal self-attention. Additionally, the network integrates another common mechanism of graph neural networks, graph convolution, with spatial self-attention to improve the learning capacity for local information. Ultimately, this network achieves Mean Per Joint Position Error(MPJPE) and Mean Per Joint Velocity Error(MPJVE) of 38.8 mm and 1.8 mm, respectively, on the Human3.6 M dataset.}
}
@article{SALAHUDEEN2026115936,
title = {Fuzzy uncertainty-aware semantic embedding for deep clustering},
journal = {Applied Soft Computing},
volume = {202},
pages = {115936},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115936},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013840},
author = {Ridwan Salahudeen and Shengwu Xiong and Armand Florentin Donfack-Kana and Mohammed Abdullahi and Aliyu Garba and Wasilah Sada},
keywords = {Deep clustering, Uncertainty decomposition, Fuzzy pseudo-labeling, Contrastive learning, Curriculum learning},
abstract = {Unsupervised deep clustering has emerged as a powerful paradigm for discovering semantic structures in unlabeled data. However, its reliance on pseudo-labels introduces a critical vulnerability: the propagation of noisy or misleading supervision. Existing methods attempt to mitigate this issue through heuristic estimations of pseudo-label confidence, typically via neighbor consensus or proximity to cluster centers, but these proxies conflate two distinct sources of uncertainty: aleatoric (inherent data ambiguity) and epistemic (model ignorance). This conflation fosters confirmation bias, where high-confidence errors masquerade as reliable signals, thereby undermining clustering fidelity. In this work, we propose a computationally efficient framework for uncertainty-aware pseudo-labeling that explicitly decomposes predictive uncertainty into aleatoric and epistemic components using entropy-based and distance-based metrics, respectively. We introduce fuzzy pseudo-labels that integrate soft assignments with uncertainty weights, and formulate a novel Fuzzy Soft Contrastive Loss (FSCL) that adaptively emphasizes reliable supervision while downweighting uncertain samples. Additionally, we devise a cluster-aware curriculum learning strategy that progressively incorporates samples based on uncertainty profiles, ensuring balanced learning across all clusters and mitigating initialization sensitivity in two-stage clustering pipelines. Extensive experiments across six benchmarks demonstrate state-of-the-art clustering performance (e.g., 96.8% and 65.9% accuracy on CIFAR-10 and CIFAR-100, respectively) and robustness (85.0% mean accuracy on CIFAR-10-C), while offering convergence guarantees and uncertainty-calibrated out-of-distribution (OOD) detection. Our findings establish uncertainty decomposition as a foundational principle for reliable unsupervised clustering.}
}
@article{LI2026115928,
title = {Federated continual learning with joint diffusion-based generative replay},
journal = {Applied Soft Computing},
volume = {202},
pages = {115928},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115928},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013761},
author = {Youhuizi Li and Yu Chen and Yiran Ma and Yuyu Yin and Shuyuan Hu},
keywords = {Federated learning, Continual learning, Diffusion model, Image classification},
abstract = {Catastrophic forgetting is a major challenge in the federated continual learning field, which supports multi-party joint learning scenarios with new tasks arriving. Existing generative replay-based methods assist classifiers in retaining knowledge of previous tasks but often overlook the degradation of the generator’s ability to produce high-quality historical data. To address this, we propose FedJoin, a federated continual learning framework based on the joint diffusion model, to efficiently achieve image generation and classification by sharing model parameters. FedJoin designs a dual-state replay mechanism to generate diverse long-term and short-term samples, optimizing model training for imbalanced data distributions. In addition, the feature consistency constraint based on the model’s intermediate layer mitigates the angle difference between new features and the embeddings of previous classes to further strengthen the prior knowledge. Experimental results show that FedJoin outperforms existing generative replay-based methods, reducing the average forgetting value by at least 7.78%.}
}
@article{SUN2026115989,
title = {Sparse projection self-representation-based unsupervised feature selection via adaptive dual-graph learning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115989},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115989},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014377},
author = {Lin Sun and Yulin Yang and Baoli Wang and Jiucheng Xu},
keywords = {Unsupervised feature selection, Sparse self-representation, Sparse projection, Adaptive dual-graph, Loss function},
abstract = {Existing projection-matrix-based unsupervised feature selection (UFS) methodologies suffer from weak sparsity constraints, which limit capturing complex feature correlations and jointly optimizing the sample and feature space structures. To address these issues, we develop SUFSD, a UFS method using sparse-projection and self-representation through adaptive dual-graph learning. The central idea of SUFSD is to jointly learn feature self-representation, a sparse projection, and adaptive dual-graph, so that feature dependencies, the discriminative projection information, and structural relationships can reinforce each other during optimization. Accordingly, three complementary components of SUFSD are detailed as follows: A sparse-projection self-representation scheme is first introduced to couple feature dependency with the projection learning, thereby enhancing feature discriminability and suppressing redundant information. Adaptive dual-graph learning then dynamically reconstructs the sample graph and feature graph according to the evolving representation, thereby enabling sample manifold structures and feature correlations to provide structural guidance for optimization. An optimization scheme integrates the representation learning and the graph learning into an iterative process, where the updated representation guides graph reconstruction and the reconstructed graphs feed structural constraints back into the subsequent representation learning and the projection-matrix update. To embed feature selection into this progressive learning process, SUFSD jointly suppresses redundant features, preserves structural consistency, and enhances feature discriminative capability. Finally, feature importance scores are computed from the learned projection matrix for selecting the top-ranked features. Furthermore, an effective convergence scheme is designed through alternating updates to optimize SUFSD. Experiments on 13 benchmark datasets demonstrate that SUFSD remains competitive results with state-of-the-art competitors across two metrics.}
}
@article{ARSHAD2026115965,
title = {Metric-based granular computing in networks},
journal = {Applied Soft Computing},
volume = {202},
pages = {115965},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115965},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014134},
author = {Hibba Arshad and Imran Javaid},
keywords = {Granular computing, Network, Rough set, Reduct, Resolving set},
abstract = {Complex networks consist of numerous interacting components whose structural complexity makes monitoring, control, and knowledge extraction challenging. Granular computing provides a principled framework for managing such complexity by decomposing systems into information granules. This study introduces a metric-based granular computing framework in networks, in which the metric structure of a graph generates granules through distance-based indiscernibility. Given a connected graph G=(V,E), the network is modeled as an information system where each vertex represents an object and each selected landmark vertex induces an attribute defined by shortest-path distance. For a landmark set S⊆V, vertices are considered indiscernible if they share identical distance signatures with respect to S, producing equivalence classes that form multi-level granular structures on the network. This construction enables systematic analysis of discernibility, observability, and structural resolution within complex networks. A formal equivalence between minimal resolving sets (metric bases) in graph theory and reducts in rough set theory under the induced distance-information system is established. Furthermore, the classical discernibility matrix provides a complete characterization of all minimal resolving sets, offering an algebraic mechanism for their computation. This hybrid soft computing and graph-theoretic approach unifies metric dimension theory with granular computing and provides a structured methodology for addressing uncertainty, imprecision, and structural complexity in real-world networks. The proposed framework extends naturally to weighted, dynamic, and uncertain graphs, with applications in sensor placement, distributed monitoring, explainable feature selection, financial network analysis, and intelligent decision systems. By grounding granularity in network geometry, this work advances a topology-driven paradigm for understanding minimal discernibility and observability in complex systems.}
}
@article{B2026115755,
title = {Implementation of multi-scale trans- YOLOv5 for object detection and improved heuristic-aided weighted dilated deep learning for traffic and transportation planning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115755},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115755},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626012032},
author = {Kannadasan B and Yogeswari K},
keywords = {Traffic and Transportation Planning, Object Detection, Multi-Scale Trans-YOLOv5, Weighted Dilated Recurrent Neural Network with Attention Mechanism, Fitness Revised Single Candidate Optimizer},
abstract = {Abstract-
In modern years, the growing population has faced transportation and sustainability challenges, and mobility plays an important role in that it links people, distributes distinct cultures, and highly promotes development. The traffic estimation is significant for developing data-driven smart transportation models. Thus, this paperwork aims to introduce a novel framework for traffic and transportation planning. Initially, the required video sources are acquired from benchmark datasets and fed into the Multi-scale Trans-YOLOv5 (MTYOLOv5) model for estimating the vehicles and pedestrians counts. Then, the novel intelligent model named Weighted Dilated Recurrent Neural Network with Attention mechanism (WDRNN-AM) is deployed for traffic planning. Here, the weight optimization is performed using the Fitness Revised Single Candidate Optimizer (FRSCO) algorithm. This system effectively predicts traffic patterns for efficient transportation. Experimental evaluation is performed using evaluation metrics, and the system delivers impressive results in traffic planning and management compared to traditional approaches.}
}
@article{XU2026115957,
title = {Data augmentation with entity-object consistency for low-resource grounded multimodal named entity recognition},
journal = {Applied Soft Computing},
volume = {202},
pages = {115957},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115957},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014055},
author = {Mingying Xu and Fei Hou and Jie Liu and Li Xiong and Guizhong Xu and Feifei Kou and Lei Shi and Linqi Song and Yinqiao Li and Muhammet Deveci},
keywords = {Multimodal named entity recognition, Grounded multimodal named entity recognition, Multimodal data augmentation, Diffusion model},
abstract = {Grounded Multimodal Named Entity Recognition (GMNER) extends traditional Multimodal Named Entity Recognition (MNER) by aiming to extract named entities, their types, and the bounding boxes of their corresponding visual objects from text-image pairs, thereby supporting the construction of Multimodal Knowledge Graphs (MKGs). The performance of GMNER heavily relies on manual annotations of textual entities and their associated visual regions, which are both time-consuming and costly to obtain. To address these limitations, especially in low-resource settings, existing studies have introduced data augmentation techniques to enrich annotated text-image pairs. However, current approaches still face two major limitations. First, text-based generation methods often produce incorrect entity types due to inadequate constraints on entity typing. Second, image-based generation methods fail to maintain entity–object consistency, frequently generating images that do not preserve the visual regions corresponding to the mentioned entities. To address these issues, we propose a generative multimodal data augmentation framework with entity–object consistency generation (EOCG). The framework automatically produces high-quality text-image pairs that preserve entity–object alignment, along with their corresponding entity annotations and bounding boxes. It comprises two stages: In the multimodal text generation stage, to generate entities with type constraints, we introduce an entity-aware text generation method that retains key entities to enhance control over entity types during generation. In the multimodal image generation stage, to improve the alignment between text entities and target objects, we generate images consistent with textual semantics while preserving the visual regions corresponding to entities. This design allows the bounding boxes in the original image to be effectively reused as annotations for entity grounding, as we can use the original annotation information. Experimental results demonstrate that EOCG significantly boosts GMNER performance on multiple benchmark datasets under low-resource settings, thereby validating the effectiveness of the proposed framework in both synthesis quality and entity recognition.}
}
@article{XIE2026115904,
title = {Semantic-driven dynamic graph learning for wind turbine gearbox anomaly detection},
journal = {Applied Soft Computing},
volume = {202},
pages = {115904},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115904},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013529},
author = {Ying Xie and Jixiang Wang and Rongbin Xu and Lijie Wen and Zhiqiang Xu and Junnan Shen and Yun Yang},
keywords = {Wind turbine, Anomaly detection, Graph contrastive learning},
abstract = {Supervisory control and data acquisition systems enable data-driven condition monitoring of wind turbine gearboxes. The high-dimensional and noisy data lead to inefficient feature selection, which weakens prediction accuracy and undermines the reliability of downstream anomaly detection. To address these challenges, we present a novel Semantic-Driven Dynamic Graph Learning (SDDGL) framework that infuses domain semantics into graph-based spatial-temporal modeling. It begins by transforming variables into semantic vector representations to detect meaningful clusters and filter out irrelevant noise. These features are embedded into a dynamic autoencoder that captures temporal and spatial dynamics. It tracks evolving behaviors through graph learning with hybrid temporal modeling. To enhance detection robustness under complex operational dynamics, SDDGL promotes consistency in learned representations and leverages error analysis. Experimental results in two wind farms demonstrate that SDDGL outperforms baseline models, achieving a Receiver Operating Characteristic-Area Under the Curve of 0.902 and 0.909. These results highlight the robust and efficient performance in gearbox anomaly detection. The source code is publicly available at https://github.com/YingXie/SDDGL to facilitate reproducibility and further research.}
}
@article{DAGISTANLI2026115932,
title = {A stochastic weapon–target assignment framework for air defense systems using artificial bee colony algorithm},
journal = {Applied Soft Computing},
volume = {202},
pages = {115932},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115932},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013803},
author = {Hakan Ayhan Dağıstanlı and Büşra Bişkin Dursun and Kemal Gürol Kurtay and Muhammet Deveci and Seifedine Kadry},
keywords = {Stochastic weapon-target assignment problem, Air defense systems, ABC algorithm, Genetic algorithm, Multi-criteria decision making, Centroidous-ALWAS},
abstract = {Countries face potential threats due to their geopolitical location, relations with neighboring countries, and trade route networks. The modern warfare environment shows that the vast majority of these probabilistic threats arrive via airspace. Today's air threat landscape consists of helicopters, unmanned aerial vehicles (UAVs), kamikaze drones, cruise missiles, and ballistic missiles. Effective planning against swarms or groups of incoming threats with a limited amount of air defense munitions is operationally quite challenging. Risk-based assessments necessitate more advanced air and missile defense systems than ever before to counter various threats. Dealing with these threats is at the very heart of modern Air Defense (AD) planning. In this study, the probability of Target Engagement Success (TES) of conventional AD systems in today's asymmetric Air Warfare (AW) environments is calculated, primarily with a novel integration known as Centroidous and Aczel-Alsina Weighted Assessment (ALWAS) based on Multi-Criteria Decision Making (MCDM). The aim of this research is to evaluate the effectiveness of AD systems based on five (5) criteria for area protection and then to use these effectiveness probabilities to allocate weapon and firing strategies against different types of air threats. The military's decision process is often very time-sensitive, thus an Artificial Bee Colony (ABC), Genetic Algorithm (GA) and Particle Swarm Optimization (PSO) metaheuristic are utilized to resolve the decision using a representative generic scenario. Stochastic operational conditions were taken into account through the use of a Monte Carlo simulation. The provided results show that over 90% of target engagement success can be realized through the use of this framework. This success was accomplished by destroying 26 out of 28 threats from 5 different attack groups, using 42 out of 46 missiles fired from 5 AD systems. Three metaheuristic methods produced successful results; However, the ABC was superior to the GA and PSO as it produced similar levels of successful results using less ammunition and with greater efficiency, producing high-quality solutions in an average time of 6.71 s. Therefore, the study demonstrates that swarm-intelligence-based optimization methods are suitable for real-time air defense decision-support systems.}
}
@article{WANG2026115993,
title = {Dual-cooperation of spatial and local cues enhances point-supervised spinal structure segmentation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115993},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115993},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014419},
author = {Pei Wang and Jiansong Fan and Xiang Pan and Wei Chu},
keywords = {Spinal structure segmentation, Point supervision, Weakly supervised learning, Spatial-local dual cooperation},
abstract = {Semantic segmentation of spinal structures holds significant value in clinical diagnosis and surgical planning. However, existing methods predominantly rely on fully supervised learning, which requires labor-intensive and time-consuming pixel-wise annotations. Achieving high-quality segmentation of spinal structures under weakly supervised conditions with only point annotations has emerged as a promising research direction. To this end, we propose SLPSNet, a Point-supervised Spinal Structure Segmentation Network based on a dual-cooperation paradigm of Spatial and Local cues. Specifically, we design the Local Structure-Aware Module (LSAM) to capture fine-grained structural differences between foreground and background regions within the image plane, thereby enhancing the representational capacity of sparse point annotations. In addition, we introduce the Spatial Affinity Propagation Module (SPAM) to model the continuity of spinal structures along the vertical axis, enabling spatial consistency across hierarchical layers. Furthermore, the Reverse Point Suppression Supervision Loss (RPSSL) is proposed, which treats unlabeled regions as candidate background areas to effectively suppress over-activation in non-annotated regions, improving both segmentation accuracy and robustness. Extensive experiments on three public spinal image datasets demonstrate that SLPSNet achieves performance comparable to fully supervised methods, validating its effectiveness in weakly supervised spinal structure segmentation tasks.}
}
@article{YANG2026115927,
title = {FedNP: Novelty preference driven momentum correction for federated long-tailed learning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115927},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115927},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601375X},
author = {Chengjun Yang and Haiying Xia and Shuxiang Song and Lingyu Wu and Jiansheng Peng},
keywords = {Federated learning, Long-tailed datasets, Non-IID data, Novelty preference},
abstract = {Federated Learning (FL), as a distributed machine learning paradigm, enables collaborative training across multiple clients while preserving data privacy. However, FL in practice simultaneously faces the dual challenges of non-independent and identically distributed (Non-IID) data and long-tailed distributions. Existing methods either focus on addressing data heterogeneity across clients or optimizing for long-tailed distributions, but struggle to tackle both issues under privacy constraints. This paper proposes FedNP (Federated Novelty Preference), a novelty-preference-driven momentum correction method for federated long-tailed learning. The method first analyzes the bias mechanism where head-class samples dominate the gradient direction during momentum accumulation, then designs a Coverage-Gini Index (CGI)-based long-tail scoring mechanism that quantifies the class imbalance degree of each training batch. Building upon this, we propose the Curiosity-SGDM optimizer, which dynamically adjusts the fusion weights between the current gradient and historical momentum, thereby implicitly balancing the contributions of each class to model updates. FedNP is plug-and-play, with the entire computation performed locally on clients without uploading any class distribution information, fully satisfying the privacy constraints of FL. Experiments on CIFAR-10-LT, CIFAR-100-LT, and ImageNet-LT datasets demonstrate that FedNP significantly improves tail-class recognition performance under both centralized and decentralized FL settings, with the most pronounced gains on frameworks that lack a built-in long-tail correction.}
}
@article{MEN2026115948,
title = {A finite-element graph neural network–based method for real-time simulation and evolution analysis of metro bogies},
journal = {Applied Soft Computing},
volume = {202},
pages = {115948},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115948},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013967},
author = {Zhihui Men and Dao Gong and Xin Deng and Junyi Lan and Xiaoguang Ma and Kai Zhou and Jinsong Zhou},
keywords = {Real-time simulation, Graph neural network, Finite element analysis, Digital twin, Bogie frame},
abstract = {Real-time prediction of full-field stress and strain responses is essential for digital twin applications in metro bogie structures. However, existing data-driven approaches face two key challenges: handling extremely high-dimensional finite element outputs with strong spatial correlations, and achieving reliable real-time inference while preserving physical interpretability and uncertainty awareness. To address these challenges, this study proposes a physics-informed deep learning framework for fast and reliable full-field stress/strain prediction under operational conditions. The framework integrates a convolutional neural network (CNN) with a finite element–based graph neural network (FEMGNN). The CNN extracts compact latent features from multi-channel vibration signals, while the FEMGNN represents finite element nodes as graph vertices and incorporates element stiffness into edge weights to capture structural topology and physical coupling. By embedding physical and topological information into the learning process, the proposed model enables end-to-end mapping from vibration measurements to node-level stress/strain fields, eliminating the need for independent node-wise modeling and improving both accuracy and computational efficiency. The method can predict full-field responses at more than 18,000 nodes in a single forward pass, with an average inference time of approximately 2.38 ms on a workstation GPU, demonstrating real-time inference potential for digital-twin-based structural monitoring. Furthermore, Monte Carlo Dropout is employed to estimate both predictive means and associated uncertainties, enabling spatial uncertainty visualization and confidence interval analysis. Numerical results under normal operating conditions and multiple crack scenarios demonstrate that the proposed CNN–FEMGNN achieves overall competitive and stable full-field prediction performance compared with CNN-based, CNN–GNN-based, and other surrogate models in terms of accuracy, stability, and uncertainty consistency.}
}
@article{XIE2026115872,
title = {A discrete Hopfield neural network solves 3-SAT by optimizing weights based on clause-derived energy functions},
journal = {Applied Soft Computing},
volume = {202},
pages = {115872},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115872},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013207},
author = {Xiaojun Xie and Saratha Sathasivam},
keywords = {Discrete Hopfield neural network, Boolean satisfiability, Synaptic weights, 3-SAT problem},
abstract = {The Boolean 3-Satisfiability (3-SAT) problem is widely recognized as a canonical NP-complete problem with broad applications in artificial intelligence, circuit design, and cryptography. Discrete Hopfield Neural Networks (DHNNs) have demonstrated potential for addressing this challenge due to their associative memory properties and parallel dynamics. However, classical DHNN-based 3-SAT models typically rely on complex higher-order synaptic weight computations, which severely limit scalability and computational efficiency in large-scale instances. To overcome these limitations, this study proposes a more scalable and computationally efficient DHNN-based framework for solving the 3-SAT problem. Specifically, the proposed framework introduces a simplified method based on a reformulated cost function that enables the direct encoding of clause-level logical structures while avoiding explicit high-dimensional tensor operations. As a result, both computational overhead and memory requirements are significantly reduced. Experimental results demonstrate improved learning and retrieval times, reduced memory consumption, and consistently high retrieval accuracy across both small-scale and large-scale 3-SAT instances. These improvements enhance the practical applicability of DHNN-based models in logic programming and combinatorial optimization, particularly for large and structurally complex problem settings.}
}
@article{KAYTAN2026115924,
title = {Adaptive and interpretable reinforcement learning-enhanced unscented Kalman filtering for autonomous driving state estimation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115924},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115924},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013724},
author = {Duygu Kaytan},
keywords = {State estimation, Reinforcement learning, Unscented Kalman filter, Autonomous driving, Interpretable reinforcement learning, Adaptive noise covariance estimation},
abstract = {Accurate state estimation under noisy sensor measurements is a fundamental requirement for autonomous driving systems. This paper proposes an interpretable reinforcement learning (RL)-enhanced Unscented Kalman Filter (UKF) framework that improves estimation accuracy while preserving the structure of classical model-based filtering. By maintaining physically meaningful covariance adaptation, the proposed approach ensures transparency and interpretability in the estimation process. The framework introduces a structured interaction mechanism in which an RL agent adaptively adjusts the process and measurement noise covariance matrices in real time based on measured velocity information and its temporal variation. This enables dynamic and explainable uncertainty adaptation under varying motion and noise conditions without compromising the stability of the underlying filter. The proposed method is evaluated in a Python-based simulation environment using a kinematic vehicle model across multiple motion scenarios. Experimental results demonstrate that the RL-UKF consistently outperforms classical and fixed-parameter filtering approaches, achieving approximately 13.2% improvement in RMSE and 4.6% improvement in mean absolute error. Statistical significance is validated using the Wilcoxon signed-rank test, yielding p-values significantly below conventional thresholds (p≪0.001), confirming that the observed improvements are robust and not due to random variation. Overall, the results demonstrate that reinforcement learning can effectively complement model-based estimation by enabling adaptive, interpretable, and statistically reliable performance improvements for autonomous driving applications.}
}
@article{ZHOU2026115940,
title = {A digital twin modeling for complex systems with multi-scale fault behaviors using active knowledge transposed distillation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115940},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115940},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013888},
author = {Jinhan Zhou and Jinsong Yu and Diyin Tang and Pengcheng Zhang and Chunzhou Zhao},
keywords = {Digital Twin, Fault Behavior Modeling, Knowledge Distillation, Complex Systems, Physics-informed},
abstract = {Fault behavior modeling critically determines digital twin efficacy in complex systems, governing downstream tasks such as design, control, and health monitoring. However, multi-scale fault behavior modeling faces a fundamental knowledge-data dilemma: empirical models are readily available but have insufficient fidelity for digital twin applications, while purely data-driven modeling can achieve high fidelity with sufficient experimental data yet prohibitive experiment costs inevitably lead to data starvation. Existing methods attempt to leverage empirical knowledge to overcome this dilemma, but the low fidelity of available empirical knowledge renders their superficial knowledge transfer strategies ineffective. Therefore, this paper proposes an Active Knowledge Transposed Distillation (AKTD) framework, a paradigm that achieves high-fidelity modeling by shifting from parameter-, output- or feature-level to distribution-view transfer. AKTD first distills multi-scale latent feature distributions from empirical models via twin learning, then leverages these distributions to actively prioritize experiments in regions of weakest model comprehension to maximize the modeling benefit of each costly sample, and to supervise digital twin modeling by preserving structural feature consistency rather than enforcing potentially misleading output fidelity. Experiments based on Permanent Magnet Synchronous Motor (PMSM) and Beam cases demonstrate the state-of-the-arts performance of the proposed AKTD method on digital twin modeling with multi-scale fault behaviors under industrial circumstances.}
}
@article{EKINCI2026115892,
title = {Non-Newtonian mean-based logarithmic activation functions for deep learning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115892},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115892},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013402},
author = {Alper Ekinci and Abdullah Elen and Selcuk Bas},
keywords = {Activation functions, Non-Newtonian calculus, -arithmetic mean, Deep learning},
abstract = {In this study, we present a new family of hybrid activation functions within the framework of Non-Newtonian calculus. Specifically, by combining logarithmic calculus with the weighted β-arithmetic mean, we obtain smooth and adaptive nonlinear functions. Selecting the logarithmic function as the generator enables the construction of hybrid activations through the weighted logarithmic mean of widely used activation functions, resulting in new forms such as Log-Tanh-ReLU, Log-Tanh-LeakyReLU, and Log-Identity-LeakyReLU. These activations effectively integrate the structural properties of their components while maintaining gradient continuity and training stability. Experiments conducted on four benchmark datasets demonstrate that the proposed functions achieve competitive performance compared to classical activation functions in terms of accuracy, stability, and generalization. The findings indicate that logarithmic calculus and β-arithmetic provide powerful and flexible tools for designing next-generation activation mechanisms in deep neural networks.}
}
@article{PRABHA2026115953,
title = {Performance analysis of quantum-enhanced medical X-ray image processing using hybrid quantum algorithms},
journal = {Applied Soft Computing},
volume = {202},
pages = {115953},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115953},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014018},
author = {B. Vishnu Prabha and K. Manikanda Kumaran},
keywords = {Quantum computing, Medical image enhancement, Quantum Fourier transform, Variational quantum circuits, Hybrid algorithms, X-ray imaging, NISQ devices, Qiskit, Wilcoxon test, Friedman test},
abstract = {Medical image enhancement is critical for accurate disease diagnosis and effective treatment planning, yet classical techniques face fundamental limitations in simultaneously managing complex noise patterns, heterogeneous tissue structures, and fine anatomical detail preservation. This paper addresses this research gap by implementing and rigorously evaluating quantum circuit-based enhancement algorithms for medical X-ray imaging using quantum hardware simulators. The primary novelty lies in the systematic comparative analysis of three distinct paradigms-Quantum Fourier Transform (QFT) processing, Variational Quantum Circuits (VQC), and a novel hybrid classical-quantum framework-implemented on real quantum hardware simulators and evaluated against state-of-the-art baselines using clinically meaningful metrics. Experimental evaluation on 20 chest X-ray images demonstrates: classical baseline 5.21 ± 0.17 dB PSNR; quantum-inspired 3.90 ± 0.60 dB PSNR; hybrid pipeline 2.97 ± 0.70 dB PSNR (consistency score 0.588). Convergence analysis demonstrates stable VQC optimization across five independent runs (mean 111.4 ± 5.8 iterations, CV = 4.6%). Non-parametric Wilcoxon signed-rank and Friedman tests confirm statistically significant performance differences between all method pairs (p < 0.05, Bonferroni-corrected). Full reproducibility specifications (Qiskit 0.45.0, Python 3.10.12, seed = 42) are provided to enable exact experimental replication.}
}
@article{ALSHAMRANI2026115943,
title = {Assessment of sustainable electronic waste management strategies: q-rung orthopair fuzzy decision-making method},
journal = {Applied Soft Computing},
volume = {202},
pages = {115943},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115943},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013918},
author = {Ahmad M. Alshamrani and Pratibha Rani and Arunodaya Raj Mishra and Adel Fahad Alrasheedi and Yuan Rong and Erfan Babaee Tirkolaee},
keywords = {E-waste management, Sustainability, Q-rung orthopair fuzzy set, Score function, Divergence measure, Alternative ranking order method accounting for two-step normalization},
abstract = {Inappropriate treatment of electronic waste (e-waste) poses substantial risks to the environment and ultimately leads to negative consequences on human health. Selecting an appropriate strategy for electronic waste management (EWM) is crucial before treating e-waste. This research aims to propose an innovative model for evaluating and prioritizing sustainable EWM strategies based on the most influential criteria. This model combines the relative closeness coefficient-based tool, the step-wise weight assessment ratio analysis tool, and the alternative ranking order method accounting for two-step normalization (AROMAN) within the setting of q-rung orthopair fuzzy sets (q-ROFSs). Based on the proposed score function, the weights of decision experts (DEs) are derived, while the weights of criteria are estimated using an integrated objective-subjective weighting approach. For the relative closeness coefficient-based objective weighting tool, a novel divergence measure on q-ROFSs is developed, which describes the discrimination between them. By combining these steps, an integrated AROMAN is presented to critically assess EWM strategies, demonstrating its practicality and efficacy through a case study of the EWM strategy selection problem. The findings of the integrated weighting model indicate that the criterion “quality management systems” is the most important for EWM strategies’ prioritization. Based on the ranking results, it is revealed that “Organizing the informal recycling sector” has the maximum preference among the others with respect to the 21 criteria considered. Sensitivity analysis is further conducted with respect to varying values of the used parameters, which reveals that the strategy “Organizing the informal recycling sector” constantly obtains its top ranking despite how the parameters’ values vary. Moreover, this study compares the proposed method with q-ROFS-based decision-making methods to evaluate its effectiveness. The outcomes of this work aim to encourage a more proactive attitude towards EWM.}
}
@article{SARWAR2026115888,
title = {Healthcare technology assessment: An intelligent 2-tuple linguistic cloud rough multi-objective optimization approach},
journal = {Applied Soft Computing},
volume = {202},
pages = {115888},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115888},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013360},
author = {Musavarah Sarwar and Asifa Azeem and Fariha Zafar and Muhammet Deveci},
keywords = {Multigranular information, 2-tuple linguistic cloud rough numbers, Multiple objective data envelopment analysis, Multi-criteria decision analysis, Medical tools selection},
abstract = {Group decision-making deals with complex decision problems in real-world phenomena and holds an important research status in the wide domain of decision analysis. This paper proposes a new integrated framework by implementing multi-granularity, cloud model theory and rough approximations with multi-objective optimization and multi-criteria decision-making approaches. This framework introduces a novel 2-tuple linguistic cloud rough decision analysis approach. The concept of 2-tuple linguistic cloud rough numbers is introduced by combining the merits of 2-tuple linguistic information, cloud model theory and rough approximations to address multi-granularity in cloud rough numbers, randomness in criteria assessments and intrapersonal ambiguity in handling inconsistent consensus. To eliminate flaws in the current operations of 2-tuple linguistic variables and cloud rough numbers, new modified algebraic operations are introduced. The multigranular cloud rough data envelopment analysis technique is introduced to compute optimized weights of attributes by dynamically weighting different alternatives with respect to attributes, based on the decision information’s gray relational degree. The ideal decision information is derived by solving an optimization model of a weighted square least. The optimized weights of attributes review the beneficial term of every alternative based only on the optimization model, neglecting the influence relationship between attributes. Therefore a new 2-tuple linguistic cloud rough multi-criteria ranking approach is studied and used to determine the comprehensive attribute weights. These comprehensive attribute weights are then employed to determine the evaluation values and ranking of alternatives. The significance of the proposed method is demonstrated by a practical application in the cautious selection of health-care technology. A sensitivity analysis of various technique parameters is used to analyze the outperformance and rationality of the proposed approach.}
}
@article{JIAO2026115969,
title = {Firefly-Pareto clustering-based frontier exploration (FPCFE) for multi-Mobile robot systems},
journal = {Applied Soft Computing},
volume = {202},
pages = {115969},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115969},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014171},
author = {Yucheng Jiao and Guoliang Wang},
keywords = {Multi-mobile robot, Cooperative exploration, Multi-robot SLAM, Pareto optimization, Path planning},
abstract = {Efficient and scalable multi-robot cooperative exploration is essential for applications such as autonomous mapping, disaster response, and environmental monitoring. However, existing approaches often suffer from redundant coverage, path conflicts, and high computational costs. To address these issues, a Firefly–Pareto Cooperative Frontier Exploration (FPCFE) framework is proposed to explicitly decouple multi-robot exploration into local frontier refinement and global cooperative allocation. By integrating lightweight frontier redundancy reduction with Pareto-optimal task coordination, FPCFE improves exploration efficiency, reduces redundant coverage, and enhances resource scalability in complex unknown environments. Experiments using the TurtleBot3 simulation platform demonstrate that the proposed FPCFE method performs robustly in complex maze, bookstore, and large maze environments. Compared with the average performance of RRT, DRL, ACO, FA, and PSO across the three environments, FPCFE reduces path length by 14.6%, mapping time by 10.2%, CPU utilization by 20.2%, RAM usage by 21.1%, and communication payload by 18.9%. Moreover, FPCFE improves the average map coverage from 93.1% to 96.3%, corresponding to an increase of 3.2 percentage points. These results verify that FPCFE achieves superior path optimization, computational efficiency, and exploration scalability, providing an effective and resource-efficient solution for multi-robot cooperative exploration in complex unknown environments.}
}
@article{WANG2026115961,
title = {Grouping method based on entropy recursive differential and general separability for large-scale global optimization},
journal = {Applied Soft Computing},
volume = {202},
pages = {115961},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115961},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014092},
author = {Huimin Wang and Yuelin Gao and Yifan Lang and Ying Sun},
keywords = {Grouping method, Separability, Cooperative coevolution, Large-scale global optimization, Intelligent optimization algorithm},
abstract = {Grouping methods effectively reduce problem complexity and enhance optimization efficiency by decomposing numerous decision variables into multiple low-dimensional subproblems, forming a crucial component of Cooperative Coevolution (CC) algorithms. Based on this method, CC algorithms demonstrate significant advantages for large-scale global optimization problems (LSGOPs). The latest grouping method General Separability Grouping (GSG) method, identifies separability based on the minimum points shift principle, exhibiting high generality and decomposition accuracy. However, the high computational expense of GSG limits its practical application. The proposed grouping method based on Entropy Recursive Differential and General Separability (ERDGSG) integrates differential information obtained from Recursive Differential Grouping (RDG) and measures the diversity of decision variables through entropy, significantly reducing computational resource consumption while maintaining grouping accuracy. This paper theoretically investigates variable separability, combining differential thought, the minimum point shift principle, and entropy characteristics to significantly reduce computational resource consumption while maintaining high accuracy in handling different types of separability problems. Furthermore, due to the lack of nonseparable functions in existing nonadditive separability benchmark test suites, this paper designs the Extended Benchmark based on Nonadditive Separability (ENS) test suite, which includes three new benchmark functions for LSGOPs. Comparative experiments on the CEC2010, CEC2013, BNS and ENS test suites demonstrate that ERDGSG outperforms the state-of-the-art grouping methods in both grouping accuracy and resource consumption. By further coupling with resource allocation strategies and suboptimizers, the resulting comprehensive CC algorithm achieves effective improvements in solution quality and convergence velocity during optimization experiments.}
}
@article{LIU2026115910,
title = {Transformer-enhanced feature extraction with adaptive thresholding for domain generalization fault diagnosis under open-set scenarios},
journal = {Applied Soft Computing},
volume = {202},
pages = {115910},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115910},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601358X},
author = {Junhao Liu and Qiang Li and Xiaoyong Gao},
keywords = {Fault diagnosis, Open-set domain generalization, Transformer-enhanced embedding, Sample-wise adaptive thresholding},
abstract = {Ensuring the operational safety and reliability of industrial machinery is heavily dependent on effective fault diagnosis. However, in practical applications, domain and label shifts induced by varying operating conditions and unseen fault modes pose significant challenges, collectively framed as open-set domain generalization (OSDG). Despite recent progress, existing OSDG methods are often constrained by limited long-range feature extraction, prototype-centered learning that does not explicitly bound known-class regions, and coarse class-wise thresholds that ignore intra-class variability. Motivated by these limitations, we introduce TFEAT, a framework that integrates transformer-enhanced feature extraction with adaptive thresholding. TFEAT employs a transformer-enhanced embedding network to extract global fault representations across domains. In addition, it introduces a magnitude-orientation decoupled joint optimization strategy that enforces a bounded hyperspherical manifold via hyperspherical loss, while refining inter-class separability and intra-class compactness through an angular triplet loss. Furthermore, TFEAT adopts a sample-wise adaptive thresholding mechanism that assigns a personalized threshold to each sample, effectively accounting for intra-class sample diversity. Experiments on three public bearing datasets demonstrate that TFEAT outperforms current methods and achieves an overall H-score of 94.74%.}
}
@article{LIU2026115907,
title = {LE-DATN: A lightweight-enhanced dual-attention temporal network for remaining useful life prediction},
journal = {Applied Soft Computing},
volume = {202},
pages = {115907},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115907},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013554},
author = {Aihua Liu and Yisheng Lian and Wenran Han and Yifeng Hou and Hanhua Zhu},
keywords = {Attention mechanism, Gated recurrent unit, Lightweight model, Remaining useful life prediction},
abstract = {Accurate Remaining Useful Life (RUL) prediction during equipment degradation is crucial for preventive maintenance. Current attention-based methods face two key limitations: poor time-series continuity handling and high computational complexity which compromise timeliness. To address these issues, this study proposes a lightweight approach for remaining useful life prediction, which utilizes a lightweight-enhanced dual-attention temporal network (LE-DATN). The model employs GRU networks combined with an attention mechanism to capture temporal degradation patterns while overcoming traditional attention limitations. Exponential smoothing enables lightweight training. Feature processing uses dual paths: encoder-generated h1 (combining improved attention and GRU) and sparse attention-derived h2 (preserving raw data). The decoder GRU fuses these features via weighted averaging for RUL prediction. Experimental evaluations on the C-MAPSS benchmark dataset demonstrate that the proposed model exhibits clear advantages in both prediction accuracy and computational performance, reducing parameters by 84.89% and FLOPs by 11.35% compared to the state-of-the-art (SOTA) models.}
}
@article{CHU2026115999,
title = {Multi-scale position-aware contextual attention for image inpainting},
journal = {Applied Soft Computing},
volume = {202},
pages = {115999},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115999},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601447X},
author = {Xiaomei Chu and Lihua Cao and Hanyun Li and Yao Wang and Yi Li},
keywords = {Image inpainting, Two-stage inpainting framework, Gated region-aware fusion, Contextual attention with positional encoding, Multi-scale attention fusion},
abstract = {Image inpainting remains a challenging problem in computer vision, requiring the synthesis of semantically coherent content while preserving local texture details in missing regions. Existing deep learning methods may have difficulty balancing global structural consistency and local texture fidelity, particularly for large missing regions and irregular mask shapes. To address these challenges, this paper presents a two-stage image inpainting framework. First, a Dual-Stream Coarse Network (DSCNet) with a Gated Region-Aware Fusion (GRAF) module is introduced to adaptively combine encoder–decoder features and support structurally coherent coarse predictions. Second, a Detail Refinement Network (DRNet) incorporating Multi-Scale Attention Fusion (MSAF) is developed. It applies Contextual Attention with Positional Encoding (CAPE) at three hierarchical feature levels to integrate contextual information across different scales. In addition, a Texture-Guided Gating Mechanism (TGGM) provides supplementary texture cues for local detail refinement. Experiments on Paris StreetView, CelebA-HQ, Places2, and MS COCO show that the proposed method achieves competitive results compared with representative baselines. On CelebA-HQ under a 50%–60% mask ratio, the proposed method achieves a PSNR of 23.65 dB and an SSIM of 0.846.}
}
@article{SULTANA2026115883,
title = {Fuzzy graph structure model based on plithogenic set theory with applications to the traveling salesman problem (TSP)},
journal = {Applied Soft Computing},
volume = {202},
pages = {115883},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115883},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013311},
author = {Fazeelat Sultana and Muhammad Gulistan and Mumtaz Ali and Mohammed M. Al-Shamiri},
keywords = {Plithogenic set, Plithogenic fuzzy graph structure, Traveling salesman problem (TSP), Plithogenic fuzzy nearest-neighbour heuristic, Fuzzy nearest-neighbour, Heuristic optimization, Combinatorial optimization, Route optimization, Uncertainty modeling},
abstract = {The Traveling Salesman Problem (TSP) is a fundamental combinatorial optimization problem with broad applications in logistics, transportation, service management, and route planning. This paper introduces a novel mathematical framework, called the Plithogenic Fuzzy Graph Structure (PFGS), which integrates plithogenic set theory with fuzzy graph structures to model uncertainty, contradiction, and attribute-dependent decision behavior. Within this framework, key graph operations including union, join, Cartesian product, and composition are formally defined and analyzed. A systematic methodology is further developed to apply PFGSs to combinatorial optimization problems under uncertain and multi-attribute environments, leading to the proposed Plithogenic Fuzzy Nearest-Neighbor (PFNN) heuristic for solving the TSP. To evaluate performance, the PFNN method is compared with the classical Nearest-Neighbor (NN) and Fuzzy Nearest-Neighbor (FNN) heuristics using the same TSP dataset and identical distance matrices. The comparison is conducted using multiple performance indicators including route distance, median distance, best-count, win rate, runtime, deviation from the best-achieved route, pairwise dominance, distance saving, and scalability across problem sizes. Experimental results demonstrate the superiority of the proposed PFNN method, achieving the lowest mean route distance (669.4818), the lowest median distance (680.4159), the highest best-count (2544 out of 2783 instances), and the highest win rate (91.4121%). The results confirm that incorporating plithogenic fuzzy edge desirability, contradiction control, adaptive parameter settings, and appurtenance values significantly improves route construction quality while maintaining practical computational efficiency. Therefore, the proposed framework provides an effective and robust approach for solving TSP and related optimization problems under uncertainty.}
}
@article{YANG2026115899,
title = {HPG-Diff: Hierarchical physics-guided diffusion with differentiable connectivity constraints for topology optimization},
journal = {Applied Soft Computing},
volume = {202},
pages = {115899},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115899},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013475},
author = {Jinbo Yang and Mingyue Yuan and Boyuan Zhang and Yoshifumi Kitamura and Shikai Jing},
keywords = {Topology optimization, Diffusion models, Physics-guided generation, Connectivity constraints, Generative design},
abstract = {Deep generative models offer a promising paradigm for topology optimization, enabling rapid design exploration. However, these approaches lack intrinsic physics guidance, often leading to poor generalizability across unseen boundary conditions and the formation of floating material artifacts. To address these limitations, we propose Hierarchical Physics-Guided Diffusion (HPG-Diff), a novel diffusion framework that enforces physics consistency through two synergistic mechanisms. First, we introduce a hierarchical physics-guided strategy that aligns different precomputed physics features with the denoising process, guiding material distribution toward optimal load paths to enhance generalizability. Second, we propose a floating material suppression loss as a differentiable connectivity constraint inspired by thermal conduction to improve topological connectivity. By simulating a virtual heat propagation process from load positions, this mechanism explicitly penalizes floating material during training. Quantitative evaluations demonstrate that HPG-Diff achieves average compliance errors of 0.87% (in-distribution) and 5.29% (out-of-distribution), while reducing floating material ratios to 2.90% and 2.44%, respectively. Furthermore, case studies on a 3:1 rectangular domain, including cantilever and bridge benchmarks, provide preliminary evidence that lightweight LoRA fine-tuning with a small dataset can support the adaptation of HPG-Diff to rectangular non-square domains. Code is available at https://github.com/JinboYang94/HPG-Diff.}
}
@article{SUN2026115972,
title = {MS2DE: Multi-stage multi-strategy differential evolution for enhanced performance on complex landscapes},
journal = {Applied Soft Computing},
volume = {202},
pages = {115972},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115972},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014201},
author = {Yongjun Sun and Chao Zhang and Zujun Liu},
keywords = {Differential Evolution, Multi-stage evolution, Multi-strategy, Adaptive selection, Local search},
abstract = {Differential Evolution (DE) is a widely recognized algorithm for single-objective real-parameter optimization. However, conventional DE variants often exhibit reduced stability and low solution accuracy when applied to complex landscapes, such as those transformed by shift, bias, and rotation. These transformations significantly increase the difficulty of the optimization process. A primary limitation lies in the inherent inability of any single mutation strategy to perform optimally across all problem types and optimization stages. To overcome this, we propose Multi-Stage Multi-Strategy Differential Evolution (MS2DE) for enhanced performance on complex landscapes. MS2DE dynamically switches between distinct mutation strategies at different optimization stages, guided by metrics including the population's average fitness improvement rate and historical strategy success records. This adaptive selection leverages the strengths of each mutation strategy during its most effective stage. Furthermore, MS2DE integrates two specialized mechanisms to enhance late-stage optimization: (1) a Gaussian random walk to escape local optima and increase diversity, and (2) Sequential quadratic programming for intensified local exploitation. The performance of MS2DE is rigorously evaluated against 11 state-of-the-art algorithms using the CEC2021 benchmark suite. Comprising 80 challenging functions with shift, bias, and rotation transformations, this suite is designed to evaluate algorithmic robustness and optimization capability. Comprehensive results confirm MS2DE's superior performance in terms of solution accuracy and stability. Its practical utility is further demonstrated by outperforming competitors on three real-world engineering optimization problems. All results are statistically significant, highlighting MS2DE as a highly effective and reliable optimizer for complex landscapes.}
}
@article{ZHAO2026115891,
title = {HKD: Hybrid knowledge distillation for zero-shot anomaly detection},
journal = {Applied Soft Computing},
volume = {202},
pages = {115891},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115891},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013396},
author = {Yuqing Zhao and Min Meng and Jigang Wu},
keywords = {Anomaly detection, Vision-language model, Zero-shot learning, Prompt learning},
abstract = {Zero-shot anomaly detection (ZSAD) aims to identify anomalies without using any training samples from the target domain, which is particularly important in scenarios where data collection is restricted by privacy or security concerns. In practice, ZSAD is often realized under a cross-dataset setting, where models are trained on auxiliary datasets while the target domain remains unseen. Despite recent advances in vision–language models (VLMs), existing ZSAD approaches still suffer from weak generalization and domain bias, leading to significant performance degradation when applied to unseen domains with diverse objects, textures, and anomaly patterns. To address these limitations, we present HKD, a generalized vision–language framework tailored for zero-shot settings to enhance semantic robustness and cross-domain adaptability. First, a knowledge distillation mechanism transfers semantic relevance and coexistent information from frozen CLIP features, allowing the student model to capture intrinsic normal–abnormal relations without relying on real samples. Second, an Intensity-Adaptive Diffusion Anomaly Generation (IDAG) strategy synthesizes realistic and diverse pseudo-anomalies consistent with natural image distributions, thereby enriching the representation space and improving discrimination capability. Third, an object-agnostic textual prompt encodes generic notions of normality and abnormality independent of specific object semantics, effectively mitigating domain bias in textual representations. Extensive experiments conducted across 17 real-world anomaly detection datasets from industrial and medical domains indicate that HKD outperforms other ZSAD methods and can generalize better to different categories and even domains. Code is available at https://github.com/hanli6688/HKD.}
}
@article{KONG2026115964,
title = {A novel interval-valued Fermatean fuzzy sets based three-way decision-making method for mechanical products design generation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115964},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115964},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014122},
author = {Chao Kong and Kai Ren and Zhaozhe Huang and Hongsheng Fu and Yuanping Xu and Jin Jin and Zongzheng Zhang and Yanlong Cao},
keywords = {Mechanical design, Interval-valued fermatean fuzzy sets, Similarity matching, Missing data, Three-way decision-making},
abstract = {The mechanical products design presents significant challenges to engineers, considering the form, dimensions, function and precision requirements, etc. The design of mechanical products refers to historical data. Existing related methods only consider data reuse under conditions of sufficient information. When the information is missing, it is hard to select a suitable reference case. Moreover, most methods retrieve historical cases with the highest similarity, while ignoring the advantages of those with lower similarity. Therefore, this paper presents a novel three-way decision-making (3WDM) approach based on interval-valued Fermatean fuzzy sets (IVFFSs) theory. First, this method utilizes IVFFSs to calculate the total similarity between the target case and historical cases, and a robust missing data processing model is constructed. Subsequently, a 3WDM based method is built to realize classification. While conventional methods are limited to case ranking, the proposed method supports multi-attribute retrieval and ranking of historical cases, and classifies them into positive, boundary and negative regions. The historical cases in the positive region can complement each other based on the similarity of each attribute. Lastly, the mechanical product design experiment is conducted under both complete and incomplete data systems, and the rationality and stability of the proposed method are demonstrated via a comparative study.}
}
@article{SHAABANI2026115956,
title = {Recent advancements in quantum machine learning applications: A review from smart grid viewpoint},
journal = {Applied Soft Computing},
volume = {202},
pages = {115956},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115956},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014043},
author = {Mohammad Hossein Shaabani and Seyed Pouria Miri and Seyed Reza Moghadasi and Zahra {Dehghani Arani} and Mohammad Hossein {Alizadeh Roknabadi} and Gevork B. Gharehpetian},
keywords = {Smart grid, Machine learning, Quantum algorithms, Quantum computing, Quantum machine learning},
abstract = {Machine Learning (ML) techniques, encompassing supervised, unsupervised, and reinforcement learning, have already demonstrated substantial success in applications such as load forecasting, grid stability prediction, fault detection, cybersecurity improvement, consumer behavior modeling, and renewable energy resources integration. However, the exponential growth of data and the demand for real-time analytics in Smart Grids (SGs) call for more powerful paradigms to manage the complexity, variability, and uncertainty. Quantum Computing (QC), with its inherent capability to solve high-dimensional problems efficiently, offers a transformative pathway. Foundational algorithms such as Shor’s and Grover’s, variational approaches like Quantum Approximate Optimization Algorithm and Variational Quantum Eigensolver, and linear algebraic techniques such as Harrow-Hassidim-Lloyd and Quantum Principal Component Analysis have laid the groundwork for energy-oriented solutions. Integrating these principles, Quantum Machine Learning (QML) extends classical ML by leveraging quantum advantages for forecasting, anomaly detection, cyberattack localization, energy management, and intelligent control in SGs and microgrids. Using a structured keyword-based search of the Web of Science and a bibliometric analysis of publication trends, keyword co-occurrence, and citation growth, this review confirms the scarcity of studies focused specifically on QML in SGs. The analysis identifies several critical gaps in current research: an over-reliance on small-scale test systems without real-world operational constraints, insufficient integration of domain-specific physical knowledge into QML models, limited exploration of adversarial robustness and model explainability, and the absence of standardized quantum-power system co-simulation environments. These gaps are structured into near-term and long-term directions, providing a roadmap for future work. By bridging ML and QC, QML presents a promising frontier for achieving resilient, secure, and efficient realization of SGs.}
}
@article{WANG2026116008,
title = {Efficiently identifying anomalies in noisy artificial intelligence of things multivariate time series: a self-supervised contrastive learning framework},
journal = {Applied Soft Computing},
volume = {202},
pages = {116008},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116008},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014560},
author = {Chenglin Wang and Xi Li and Peng Chen and Ning Lu and Ang Bian and Can Du},
keywords = {Artificial intelligence of things, Time series anomaly detection, Self-supervised learning, Contrastive learning, Sparse attention, Transformer},
abstract = {Anomaly detection in time series within an Artificial Intelligence of Things (AIoT) environment aims to promptly identify faults or abnormal behaviors in monitored objects. However, AIoT time series data exhibit complex multi-scale spatio-temporal dependencies, strict real-time processing constraints, and noisy environmental interference, all of which substantially increase the difficulty of robust anomaly detection. To address these issues, this paper proposes the Dynamic gated dilated convolution and Adaptive-threshold sparse attention enhanced Contrastive Learning (DA-CL) model, a novel self-supervised contrastive learning framework for multivariate time series anomaly detection. Specifically, DA-CL incorporates Dynamic Gated Dilated Convolutions for adaptive multi-scale feature extraction, an Adaptive-threshold Sparse Attention Mechanism for efficient long-sequence dependency modeling, and a collaborative self-supervised anomaly amplification mechanism to enhance subtle anomaly sensitivity and noise robustness. Extensive experiments on five public benchmark datasets in comparison to nine baselines demonstrate the state-of-the-art detection performance, computational efficiency and noise robustness of DA-CL across diverse AIoT anomaly detection scenarios.}
}
@article{DJERBI2026115903,
title = {Synaptic style weaver: A closed-loop multi-agent neuro-symbolic system for secure and hardware-agnostic academic text humanization},
journal = {Applied Soft Computing},
volume = {202},
pages = {115903},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115903},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013517},
author = {Rachid Djerbi},
keywords = {Text humanization, Closed-loop PID control, Neuro-symbolic AI, Multi-agent systems, Reinforcement meta-learning, Latent style manifold},
abstract = {The widespread adoption of large language models (LLMs) has transformed academic writing, yet their outputs routinely suffer from machine-like monotony. Existing humanization techniques, ranging from static prompting to retrieval-augmented generation, treat writing style as an intangible attribute, lacking the iterative correction required to capture a specific author’s voice. We introduce Synaptic Style Weaver (S2W), a backend-agnostic, multi-agent neuro-symbolic system that reframes text humanization as a closed-loop control problem targeting three pillars of natural writing: active voice, structural burstiness, and vocabulary richness. S2W is driven by a discrete-time PID controller operating within a latent style manifold (Z⊂Sd−1) and integrates: (i) an orthogonalized triplet-loss style space; (ii) a reinforcement-learning meta-learner with FAISS-indexed episodic memory that dynamically tunes PID gains, improving convergence by 37% over fixed-gain baselines; and (iii) a five-agent pipeline (Decomposer, Humanizer, PID Controller, Validator, Discriminator). A neuro-symbolic SAT validator achieves a factual consistency score of 0.94, surpassing expert human revisers (0.91). Evaluated on 47 peer-reviewed articles, S2W achieves state-of-the-art stylistic alignment (MMD: 0.153). Turing-style detectors misclassify S2W outputs as human-written 58.8% of the time (p=0.12). The framework is fully deployable on local CPU environments, ensuring strict data confidentiality for unpublished research.}
}
@article{PHAM2026115895,
title = {A hybrid stacked regression model for actual construction cost: Incorporating MPNet sentence embeddings, meta-learning, and Bayesian hyperparameters optimization},
journal = {Applied Soft Computing},
volume = {202},
pages = {115895},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115895},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013438},
author = {Duy Hoang Pham and Ho Anh Thu Nguyen and Sanghyo Lee and Yonghan Ahn and Joosung Lee},
keywords = {Construction cost, Machine learning, MPNet, Meta learning, Contextual embeddings},
abstract = {Accurate prediction of actual construction costs remains a critical challenge in the construction industry, as most existing machine learning approaches rely primarily on structured numerical and categorical inputs while neglecting the rich contextual information embedded in unstructured project descriptions. This study proposes a hybrid stacked regression framework that integrates MPNet-based sentence embeddings with structured features for construction cost prediction. Specifically, the all-mpnet-base-v2 model is employed to extract contextual representations from free-text project descriptions, which are then concatenated with numerical and categorical inputs and used within a stacking ensemble of regression models. The model was developed on a dataset of 472 Korean government housing projects and benchmarked against different models using TF-IDF and Word2Vec representations, as well as a structured-only baseline. The results demonstrate that the proposed model achieves an R2 of 0.9251 and an RMSE of approximately $5.24 million, corresponding to a 38% reduction in RMSE compared to the baseline. Post-hoc SHAP analysis further reveals that MPNet embedding dimensions contribute substantially to predictions, capturing latent cost drivers such as subsurface uncertainties and administrative delays that are not explicitly represented in structured data. These findings demonstrate that contextual sentence embeddings can serve as effective inputs for regression models, enabling more accurate and interpretable construction cost estimation.}
}
@article{LONG2026115947,
title = {Memristive Hopfield neural network and its application to secure remote sensing images},
journal = {Applied Soft Computing},
volume = {202},
pages = {115947},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115947},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013955},
author = {Guoqiang Long and Zeric Tabekoueng Njitacke and Jiangtao Guo and Donghua Jiang and Shucun Fu and Yuchen Hu and Muhammad Attique Khan},
keywords = {Remote sensing image, Data encryption, Memristive hopfield neural network, -type fractal sorting matrix, Compressive sensing},
abstract = {Existing methods for remote sensing image transmission and storage often lack adequate data security, leaving them vulnerable to potential attacks. To mitigate this issue, this paper introduces a secure image compression-encryption algorithm tailored to remote sensing image protection. First, a novel memristive Hopfield neural network (mHNN) model incorporating voltage-controlled universal memristors is developed as a pseudorandom number generator for the encryption algorithm. Numerical analysis confirms that this mHNN model exhibits rich and stable dynamical behavior, including high-entropy chaotic dynamics and low-entropy regular behaviors. Second, a simple yet efficient construction method for the δ-type fractal sorting matrix is introduced to effectively accomplish pixel scrambling. Specifically, driven by key-dependent chaotic sequences, the original remote sensing images undergo compressive sampling, δ-type fractal sorting scrambling, and bidirectional diffusion to generate cipher images devoid of visual semantic information. Simulation and performance analyses demonstrate that the proposed algorithm offers high security and reconstruction quality, thereby achieving a favorable balance between compression and robustness. Notably, it also exhibits strong generalization across multiple datasets, with cipher images attaining information entropy above 7.999 and correlation coefficients approaching zero.}
}
@article{LIO2026115887,
title = {Logistic regression with uncertain disturbance and its application in risk forecast for postoperative complications of renal cell carcinoma with tumor thrombus},
journal = {Applied Soft Computing},
volume = {202},
pages = {115887},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115887},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013359},
author = {Waichon Lio and Xun Zhao and Zhuo Liu and Xiaojun Tian and Lei Liu and Guoliang Wang and Shudong Zhang and Lulin Ma and Rui Kang and Yunxia Chen and Hongxian Zhang},
keywords = {Postoperative complications, Renal cell carcinoma, Uncertainty theory, Uncertain statistics, Regression analysis},
abstract = {Forecasting postoperative complications in patients with renal cell carcinoma and tumor thrombus is clinically important but mathematically challenging, because the available data are limited, temporally unstable, and strongly affected by epistemic uncertainty. To address this problem, this paper proposes an uncertain logistic regression model with an uncertain disturbance term. The model parameters are estimated by uncertain maximum likelihood, and the residual is further analyzed through uncertain Bayesian rule and uncertain hypothesis testing. A retrospective cohort of 491 patients is used for the case study, including 418 patients from 2023 and earlier as the training set and 73 patients from 2024 as the temporal test set. Seven clinically meaningful risk factors are identified, including age, body mass index, tumor thrombus grade, venous-wall adherence, tumor diameter, lymph-node status, and metastasis status. Compared with the probabilistic logistic regression benchmark, the proposed method reduces the maximum forecast deviation from 0.1537 to 0.1350 and decreases the misjudgment ratio from 0.1644 to 0.1507. For the 90% uncertain interval, the empirical coverage obtained by uncertainty theory is 87%, whereas the corresponding probabilistic interval covers only 25% of the residuals. These results suggest that the proposed model is useful for conservative retrospective risk analysis under epistemic uncertainty, but they should not be interpreted as evidence of confirmed clinical decision support value. Further external and prospective validation is still required before any clinical deployment.}
}
@article{ZHANG2026115939,
title = {Beyond frequency: The role of redundancy in large language model memorization},
journal = {Applied Soft Computing},
volume = {202},
pages = {115939},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115939},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013876},
author = {Jie Zhang and Qinghua Zhao and Chi-ho Lin and Zhongfeng Kang and Lei Li},
keywords = {Large language models, Memorization, Redundancy, Prefix perturbations},
abstract = {Memorization in large language models poses critical risks for privacy and fairness as these systems scale to billions of parameters. While previous studies established correlations between memorization and factors like token frequency and repetition patterns, we reveal distinct response patterns: frequency increases minimally impact memorized samples (e.g., 0.09) while substantially affecting non-memorized samples (e.g., 0.25), with consistency observed across model scales. Through counterfactual analysis by perturbing sample prefixes and quantifying perturbation strength through token positional changes, we demonstrate that redundancy correlates with memorization patterns. Our findings establish that: ∼79% of memorized samples are low-redundancy, these low-redundancy samples exhibit 2-fold higher vulnerability than high-redundancy ones, and consequently memorized samples drop by 0.6 under perturbation while non-memorized samples drop by only 0.01, indicating that less redundant content becomes both more memorable and more fragile. These findings suggest potential redundancy-guided approaches for data preprocessing, thereby reducing privacy risks and mitigating bias to ensure fairness in model deployments.}
}
@article{TAHIR2026115942,
title = {A multi-level five-way decision framework using spherical fuzzy rough sets for complex choices in digital circular supply networks},
journal = {Applied Soft Computing},
volume = {202},
pages = {115942},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115942},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013906},
author = {Muhammad Tahir and Muhammad Kamran and Sami Ullah Khan and Qingyu Zhang and Tofigh Allahviranloo},
keywords = {Circular supply chain, Digital transition, Spherical fuzzy sets, Five-way decision, Decision-theoretic fuzzy rough sets},
abstract = {Circular supply networks represent a broad and well researched field, with significant study dedicated to the challenges of their establishment. However, research on the impacts within government managed circular supply chains remains limited. Consequently, there is still a lack of understanding regarding how digital technologies can help overcome these specific challenges in the public sector’s transition to circularity. In this work, we develop a multi level decision model based on five distinct pathways to handle complex decision-making scenarios with high accuracy. We employ spherical fuzzy sets (SpFS), which offer greater tolerance and adaptability in capturing vague information compared to intuitionistic and Pythagorean fuzzy sets. Within the SpFS framework, the three-dimensional membership functions enable decision-makers to improve judgment under uncertainty. Digital circular supply chain decision systems particularly in transportation can be structured using the five-way decision (5WD) concept with spherical fuzzy (SpF) information. The proposed model classifies criteria across multiple levels and evaluates their positions using decision-theoretic fuzzy rough sets (DTRFS) and the spherical weighted arithmetic mean (SpWAM). This study advocates the use of SpF data alongside stable ranking and structured classification algorithms to support decision-making in complex, ambiguous situations. A numerical example is provided to illustrate the applicability of the algorithm, tested across five distinct decision scenarios to validate the model’s accuracy. Statistical assessments confirm the strong performance of the proposed framework.}
}
@article{LI2026115911,
title = {A memetic algorithm with large language model for multi-objective flexible job shop scheduling with variable speed},
journal = {Applied Soft Computing},
volume = {202},
pages = {115911},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115911},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013591},
author = {Tianen Li and Kai Chen and Xiaojun Shi},
keywords = {Multi-objective flexible job shop scheduling, Variable speed, Memetic algorithm, LLM-assisted evolution of heuristics},
abstract = {This paper studies the multi-objective flexible job shop scheduling problem with variable speed (MFJSP-S), where each operation selects a machine and a speed that jointly determine processing time and energy. The goal is to minimize makespan and total energy consumption (TEC), including processing and idle energy. We first present a MILP model and validate the formulation and evaluation pipeline via exact solving on small instances. For larger instances, we propose LLMMA, an LLM-assisted memetic algorithm based on non-dominated sorting. LLMMA integrates hybrid initialization with problem-tailored neighborhoods across operation sequencing, machine assignment, and speed adjustment. A budgeted intensification scheme selects local-search candidates using Pareto-layer priority and a KNN-based diversity score, balancing convergence and distribution. Following the Evolution of Heuristics (EoH) paradigm, we use an LLM to generate executable local-search strategy code, which is injected online into the memetic loop and iteratively refined using HV-based feedback on benchmark instances. Experiments on MK and DP benchmarks using HV, IGD, and Spread, together with Friedman tests, show that LLMMA generally delivers better trade-off fronts than several state-of-the-art algorithms under equal time budgets.}
}
@article{HU2026115960,
title = {Coordinate descent surrogate-assisted evolutionary algorithm for expensive optimization problems},
journal = {Applied Soft Computing},
volume = {202},
pages = {115960},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115960},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014080},
author = {Hanyu Hu and Jian Wang and Xiaodong Huang and Chanjuan Liu and Sergey V. Ablameyko and Nikhil R. Pal and Qing Zhu},
keywords = {Evolutionary algorithm, Expensive optimization, Coordinate descent, Surrogate},
abstract = {Surrogate-assisted evolutionary algorithms (SAEAs) are effective for expensive optimization problems (EOPs). However, they encounter significant challenges in high-dimensional spaces because the simultaneous sampling strategy tends to disperse the limited computational budget. To address this limitation, this paper proposes a novel SAEA tailored for EOPs, named the Coordinate Descent Surrogate-Assisted Evolutionary Algorithm (CD-SAEA). The algorithm incorporates two novel coordinate-wise sampling strategies to refine the search granularity. During the early stage, a Sparse Region Sampling (SRS) strategy is employed to identify under-explored intervals based on fitness rankings, ensuring broad exploration. As optimization progresses, the algorithm transitions to an Elite Region Sampling (ERS) strategy, which focuses on intervals containing elite solutions to enhance exploitation. Additionally, CD-SAEA integrates a Surrogate-based Local Search (SLS) to accelerate convergence, a Full Crossover Strategy (FCS) to facilitate the utilization of elite information, and an adaptive training sample selection strategy to progressively narrow the search scope. Comprehensive ablation and sensitivity analyses validate the effectiveness of the proposed components. Comparative experiments against six state-of-the-art SAEAs, including GL-SADE, MHS-QPSO, SAMFEO, SAMSO, ESA and LSEO-S3, on high-dimensional benchmark functions (30D–200D) and the CEC2014 EOP test suite. Statistical results demonstrate that CD-SAEA achieves superior solution accuracy and convergence speed, securing the best overall rankings of 1.68 and 1.88 on the two test suites, respectively. Furthermore, its application to a real-world geothermal production optimization problem, where it achieved a Net Present Value of 1.23E + 08 USD, confirms its practical utility in solving complex engineering challenges.}
}
@article{DUAN2026115954,
title = {Fault diagnosis method for planetary gearboxes based on multi-domain adaptive network},
journal = {Applied Soft Computing},
volume = {202},
pages = {115954},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115954},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601402X},
author = {Jiandong Duan and Zhenhao Su and He Yu and Wankai Shi},
keywords = {Fault diagnosis, Unbalanced learning, Multimodal fusion, Domain adaptation, Attention mechanism},
abstract = {Intelligent fault diagnosis underpins the reliability and safety of modern manufacturing systems, yet its real-world deployment continues to face persistent obstacles arising from scarce labeled data, severe class imbalance, and the inevitable gap between simulated and real operating domains. To overcome these limitations, this study proposes a Deep Simulation-guided Multimodal Adaptation Network (DSMA-Net) that unifies simulation-guided learning, cross-modal interaction, and imbalance-aware optimization within a single framework. DSMA-Net introduces three interconnected innovations: A subdomain-aware dynamic alignment mechanism that performs fine-grained adaptation between simulation and real data distributions to suppress negative transfer; A cross-modal dynamic fusion module that establishes bidirectional attention-driven communication between vibration and current signals, unlocking their latent complementary diagnostic knowledge; and A margin-aware regularized objective that jointly optimizes feature alignment, multimodal consistency, and geometric discriminability to ensure stability under extreme imbalance. Extensive experiments on both public and self-developed gearbox datasets reveal that DSMA-Net consistently surpasses advanced domain adaptation and fusion baselines in diagnostic accuracy, robustness, and generalization. The results highlight DSMA-Net as a promising route toward bridging the simulation–real divide and advancing intelligent machinery diagnosis toward interpretable, efficient, and trustworthy industrial applications.}
}
@article{XIAO2026115878,
title = {Dynamic coverage optimization in wireless sensor networks via hybrid Q-learning swarm intelligence},
journal = {Applied Soft Computing},
volume = {202},
pages = {115878},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115878},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013268},
author = {Xuefeng Xiao and Ying Liu and Wei Shi and Hua Sun},
keywords = {Wireless sensor network, Coverage optimization, Artificial bee colony algorithm, Reinforcement learning, Dynamic strategy selection},
abstract = {Wireless Sensor Networks (WSN), as a core technology of the Internet of Things, have been widely applied in fields such as environmental monitoring and smart agriculture. However, constrained by limited node resources, dynamic environmental changes, and the singularity of traditional algorithmic strategies, the Coverage Optimization Problem (COP) still faces challenges including local optimal convergence and imbalance between exploration and exploitation. To address these issues, this paper proposes a Q-learning Enhanced Artificial Bee Colony algorithm (QLABC), which improves coverage optimization efficiency and robustness in complex scenarios by integrating reinforcement learning with swarm intelligence mechanisms. QLABC designs a differentiated dual-Q-table-driven mechanism, establishing independent strategy pools for employed bees and onlooker bees to achieve dynamic coordination between global search and local optimization. QLABC employs fitness improvement as rewards and incorporates an epsilon-greedy strategy to balance population diversity and convergence speed, effectively enhancing the capability to escape local optima. Additionally, to overcome the limitations of traditional random scout bee reset, a history experience-guided stagnation reset method is proposed. This method leverages local feature preservation, global elite guidance, and neighborhood differential perturbation to utilize historical search information, thereby avoiding search information loss. Simulation experiments demonstrate that QLABC achieves average coverage rates of 94.47% and 98.61% in 50m × 50m and 100m × 100m monitoring scenarios, respectively, achieving the best performance among the compared baselines and exceeding QVEGE by 1.4% and 1.35%, while accelerating convergence speed by 23%.}
}
@article{WANG2026115906,
title = {Partial multi-label learning with feature selection by dual guidance},
journal = {Applied Soft Computing},
volume = {202},
pages = {115906},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115906},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013542},
author = {Bingqing Wang and Yu Chen and Xiao Zheng and Jun Huang and Zixia Liu},
keywords = {Multi-label learning, Feature selection, Noisy labels, Label correlation},
abstract = {Partial multi-label learning (PML) focuses on removing noisy labels from a candidate label set, which includes both relevant and irrelevant labels. The goal is to improve multi-label classification performance by using the most relevant labels. Feature selection is a common method to reduce data redundancy. However, it often faces challenges in identifying the best subset of features, especially when the labels contain noise. To address this problem, a PML method based on dual-guided feature selection (PML-DFS) is proposed to effectively solve noisy label problems in the PML. Specifically, we first perform orthogonal rotation on the candidate label set as a way to reconstruct the distribution of valid labels and noisy labels in the label space, which makes both of them more distinguishable in the transformed space and thus improves the reliability of the subsequent feature selection. Second, a dual guidance method with instance-level information and label-level information is utilized for feature selection to determine the optimal subset of features. In addition, manifold regularization is employed to maintain instance similarity. The effectiveness of the method is validated on real and synthetic PML datasets.}
}
@article{JU2026115898,
title = {FedDualFix: Hierarchical federated learning for adaptive multi-agent program repair via dual-modality modeling},
journal = {Applied Soft Computing},
volume = {202},
pages = {115898},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115898},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013463},
author = {Xiaolin Ju and Qingyun Liu and Chang Li and Haochen Wang and Heling Cao and Xiang Chen},
keywords = {Automated program repair, Federated learning, Hierarchical multi-agent repair, Large language models, Dual-modality modeling},
abstract = {Recent advances in large language models (LLMs) have enhanced automated program repair (APR) by interpreting failures, generating context-aware patches, and iteratively refining fixes, thereby improving repair accuracy and coverage. However, existing methods still face three key limitations: they often rely on centralized training on sensitive codebases; their pipelines are rigid, one-pass processes that cannot adapt to the complexity of a defect; and they do not fully exploit auxiliary semantic signals, such as bug reports or documentation. To address these challenges, we propose FedDualFix, a federated multi-agent repair framework that improves repair accuracy, efficiency, and semantic coherence in heterogeneous and data-locality-constrained environments. FedDualFix decomposes the repair process into specialized agents for (i) context modeling, (ii) semantic slicing, (iii) fault localization, (iv) patch generation, and (v) cross-modal alignment. A hierarchical controller with confidence-guided scheduling enables early exits for simple defects and triggers deeper, structure-aware reasoning for complex or ambiguous cases. Dual-modality alignment further associates code-level edits with natural-language descriptions to enhance semantic plausibility. Experiments on Defects4J using several LLMs, including GPT-4o, show that FedDualFix produces 58 correct repairs and achieves 52.1% Top-1 precision, outperforming representative APR baselines and a same-backend GPT-4o Direct baseline. The adaptive scheduling mechanism reduces inference time by more than 25%, and ablation studies demonstrate the contribution of hierarchical control, multi-agent design, and dual-modality integration. These results highlight the potential of combining federated coordination with adaptive multi-agent reasoning to support accurate and scalable APR in real-world software maintenance settings.}
}
@article{QIU2026115959,
title = {Contrastive diffusion adaptation network with rs-fMRI for domain adaptation classification of autism spectrum disorder},
journal = {Applied Soft Computing},
volume = {202},
pages = {115959},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115959},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014079},
author = {Zifeng Qiu and Yuna Chen and Sijing Su and Shijun Qiu and Lujie Liu and Jie An},
keywords = {Autism spectrum disorder, Domain adaptation, Contrastive learning, Diffusion model, BrainNode attention},
abstract = {Autism spectrum disorder (ASD) imposes a substantial non-fatal health burden on youth, making early detection essential. Resting-state functional MRI (rs-fMRI) captures low-frequency BOLD connectivity biomarkers, enabling personalized diagnosis when combined with deep learning models. However, models trained at one site often fail to generalize to others due to distribution shifts caused by differences in scanner hardware, acquisition protocols, and patient populations. Existing domain adaptation (DA) techniques alleviate this issue but frequently overlook higher-order semantic features or fail to enhance both intra- (maximizing class separability within each site) and inter-domain (aligning same-class distributions across sites while preserving class margins) discriminability jointly. To address these challenges, we propose the Contrastive Diffusion Adaptation Network (CoDA-Net) for cross-site ASD diagnosis. First, a contrastive variational graph Transformer encoder (CVGTE) aligns the rs-fMRI features of the source and target through supervised contrastive loss. Next, GraphDDPMAugmentor, equipped with TripleGraphTransformerLayers and Frequency-Aware Learning, generates synthetic samples that blend source-domain statistics with target-specific details. Finally, BrainNode-Attention GNN (BNA-GNN) is trained on real and augmented data to achieve accurate diagnoses on unseen sites. Experiments on the ABIDE dataset demonstrate that CoDA-Net significantly outperforms existing DA methods in domain adaptation.}
}
@article{ZHANG2026115987,
title = {A Bayesian‑optimized XGBoost model for reliable and interpretable strip crown prediction in hot rolling},
journal = {Applied Soft Computing},
volume = {202},
pages = {115987},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115987},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014353},
author = {Shun Hu Zhang and Zi Qi Yin and Jia Yi Huang and Kai Yan and Xian Long Luo and Wei Jian Chen},
keywords = {Strip crown prediction, Ensemble learning algorithm, Bayesian optimization, SHAP value analysis},
abstract = {The precise forecasting of complex industrial processes remains a significant challenge for data-driven modeling due to inherent nonlinearity, strong parameter coupling, and dynamic noise. This study presents an interpretable ensemble learning framework integrating RF, GBDT, XGBoost and LightGBM with Bayesian hyperparameter optimization to address these challenges. The framework is validated through high‑accuracy strip crown prediction in hot rolling. Using industrial data from a seven‑stand tandem mill, the optimal predictor achieves a coefficient of determination (R²) of 0.9536, surpassing conventional single‑model benchmarks. Beyond prediction, the framework incorporates SHAP‑based interpretability to quantify key parameter influences, such as the roll gap at the first stand and rolling force at intermediate stands. Moreover, the SHAP analysis reveals interaction mechanisms, including thermo‑mechanical coupling and multi‑stand process inheritance. The proposed methodology improves predictive accuracy and robustness in complex industrial environments while providing a transparent, mechanism‑aware decision‑support tool, demonstrating the value of interpretable hybrid AI for real‑world engineering systems.}
}
@article{QIU2026115963,
title = {Self-supervised art style classification via attention, distillation, and learnable style encoding},
journal = {Applied Soft Computing},
volume = {202},
pages = {115963},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115963},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014110},
author = {Jinjin Qiu and Li Liu and Xiangwei Liu and Ching Y. Suen},
keywords = {Art style classification, Self-attention, Multi-scale representation, Multi-layer self-distillation, Similarity-aware contrastive learning, Learnable gram matrix},
abstract = {Art style classification is a fundamental task in computational aesthetics, yet most existing methods rely heavily on supervised learning, which requires costly manual annotations. To address this issue, we propose a novel self-supervised learning framework for art style classification that leverages unlabeled data to learn discriminative and style-aware representations. Built upon contrastive learning, our framework incorporates four key components: (1) an attention-guided fusion module that adaptively integrates multi-scale representations using self-attention; (2) a multi-layer self-distillation mechanism, where the teacher’s final output guides the student’s intermediate features; (3) a similarity-aware contrastive learning strategy that replaces rigid positive-negative sampling with soft semantic similarity weighting; and (4) a learnable Gram matrix module for dynamic modeling of channel-wise correlations to enhance style encoding. Extensive experiments on three public datasets—AVA, Flickr and Pandora18k—demonstrate that our method achieves accuracies of 57.55%, 64.62%, and 74.46%, respectively, surpassing state-of-the-art approaches in self-supervised art style classification. Code is available at: https://github.com/QJJ415/self-supervised-art-style.}
}
@article{LIU2026115913,
title = {A semi-supervised fraud detection model based on fuzzy graph neural networks},
journal = {Applied Soft Computing},
volume = {202},
pages = {115913},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115913},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601361X},
author = {Zhengyang Liu and Hang Yu and Xiangfeng Luo},
keywords = {Fuzzy logic, Fuzzy representation, Fraud detection, Heterogeneity, Consistency regularization, Semi-supervised learning},
abstract = {In recent years, graph-based fraud detection has gained increasing attention and achieved some success. Traditional detection methods often deal with precise attributes of nodes and edges, overlooking the value of fuzzy information. For instance, in a product review network, the strength of the connection between two reviews may be ambiguous due to differences in topics and ratings. In a transaction network, the high cost of labeling makes expert rules derived from a small number of samples inherently fuzzy, and a slight deviation from the expert-set threshold does not necessarily indicate whether an account is abnormal or normal. In other words, we may improve the detection capability of the model by fuzzifying explicit information in the graph. This paper proposes a Semi-Supervised Fraud Detection Model based on Fuzzy Graph Neural Networks (FGNN-FD) to address the issues of fraudster disguises and sparse samples labeled in fraud detection. The approach mainly consists of two parts: 1) By assigning pseudo-labels to unlabeled samples and endowing edges with membership degrees, our model employs GNN encoders designed from both heterogeneous and homogeneous perspectives to tackle fraudster disguises. 2) Building upon supervised training with a small number of labeled samples, our model fuzzifies node features and utilizes a semi-supervised learning method based on consistency regularization, incorporating part of the unlabeled samples for assistance in training. On five public datasets (Amazon, Yelp, Elliptic, T-Finance, and T-Social) our model demonstrates superior detection capabilities compared to baseline models based on evaluation metrics such as AUC-ROC, AUC-PR, and Macro-F1.}
}
@article{KE2026115934,
title = {ADFCoder: Evolutionary requirements comprehension based on flowchart image with complex logic structure and domain-specific requirements},
journal = {Applied Soft Computing},
volume = {202},
pages = {115934},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115934},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013827},
author = {Qiao Ke and Ming Zhao and Yunwei Dong and Marcin Woźniak and Tiantian Zhang and Shengjie Tian},
keywords = {Code generation, Flowchart understanding, Control logic reasoning, Domain knowledge retrieval},
abstract = {Code generation with query texts and code snippets has significantly improved the effectiveness and capabilities for building code retrieval models based on large language models. However, the specific domain application poses significant challenges in generating the complete code instead of code snippets with a substantial amount of logical structures. To address these challenges, we propose a deep framework ADFCoder for generating code from flowcharts that incorporate explicit requirement texts and intricate logical relationships for a specific domain functionalities. ADFCoder is composed of three modules operating in sequence, a flowchart recognizer, a logic reasoner, and a code generator. Therein, a flowchart recognizer supports automatic parallel processing of graphical elements and requirement text in the flowchart image. Additionally, a logic reasoner for flowchart is developed to build a tree of program structure based on the recognized elements to accurately express the logical structure in the requirements. Then, the code generator can collaboratively integrate and analyze the flowchart program structure tree and requirement texts in one flowchart without syntactical errors, while requirement texts within elements are processed with large language model and our domain knowledge repository. Furthermore, the first dataset, F2C-3B, is established for code generation tasks in the form of flowcharts as requirements descriptions with classical mathematical algorithms and the specialized knowledge of aerospace domain algorithms. The recognizer in ADFCoder achieves an average recognition accuracy of 99% on F2C-3B. In addition, the performance of code generation has been significantly improved with domain-specific vector processing by large-scale models and retrieval-augmented generation in some series of specific domain problems.}
}
@article{BRUNI2026115926,
title = {Stock market movement prediction with CNN-based classification of space-filling curves},
journal = {Applied Soft Computing},
volume = {202},
pages = {115926},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115926},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013748},
author = {V. Bruni and S. Marconi and B. Vantaggi and D. Vitulano},
keywords = {Stock market movement prediction, Convolutional neural network, Hilbert space-filling curve},
abstract = {Forecasting stock market movements is a challenging task due to the non-linear, noisy, and non-stationary nature of financial time series. Traditional statistical approaches often struggle to capture such complexity, whereas machine learning and deep learning approaches have demonstrated superior capabilities in uncovering hidden temporal dependencies. This study presents a CNN-based framework that transforms financial time series intervals into grayscale images using the Hilbert space-filling curve, preserving temporal and spatial locality without manual feature engineering. Gaussian smoothing is applied to suppress high-frequency noise, and rightmost edge effects are mitigated through a linear extrapolation based on the smoothed signal’s acceleration. A robust labeling strategy based on the average future price variation provides a more reliable directional indicator than single-point prediction. A custom CNN is optimized for compact image inputs, ensuring efficient and fast training. Experiments on the S&P 500, Gold, Crude Oil and two Chinese stocks’ time series demonstrate the effectiveness of the proposed approach in predicting market movements. A simplified trading simulation further assesses the potential utility of the predicted signals for decision-making in financial applications.}
}
@article{SUN2026115902,
title = {Joint spatial–spectral dimensionality reduction for hyperspectral imagery via bilevel graph-regularized sparse representation: Application to mineral composition prediction},
journal = {Applied Soft Computing},
volume = {202},
pages = {115902},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115902},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013505},
author = {Yan Sun and Can Zhou},
keywords = {Hyperspectral imagery, Spatial–spectral dimensionality reduction, Bilevel optimization, Sparse representation, Mineral composition prediction},
abstract = {Accurate mineral composition quantification is essential for resource exploration and ore processing. Hyperspectral imaging (HSI) provides a non-destructive and high-throughput solution by jointly capturing spatial and spectral signatures. However, dense spectral sampling and homogeneous spatial observations often introduce strong inter-band correlation, repeated local information, and noise-sensitive representations. Although unsupervised band selection can reduce the spectral dimension while preserving wavelength interpretability, most existing methods still retain the original spatial resolution and therefore leave abundant pixel-level repetition unaddressed. To bridge this gap, this paper proposes a bilevel graph-regularized sparse self-representation framework for joint spatial-spectral dimensionality reduction. The method learns coupled pixel-wise and band-wise dependencies through a reconstruction-driven objective with structured sparsity. Spatial and spectral graphs are further introduced to impose mutual exclusion among highly similar pixels and bands, which helps suppress trivial solutions and improve the stability of the learned representation. To reduce the computational burden of the resulting large-scale non-convex problem, we develop an efficient optimization method. It combines superpixel-based block decomposition, CCCP-inspired local linearization, and projected generalized-gradient updates with simplex projection. The learned representation weights are subsequently leveraged to execute ranking-based band selection and graph-diffusion-based spatial aggregation over a compact grid. Comprehensive evaluations are conducted on two public clay-powder datasets, CUX20P and Senops HSC2, and a real-world zinc concentrate dataset. The results show that the proposed framework achieves competitive or superior mineral composition prediction performance across different sensor configurations and regression backbones, while substantially reducing both spectral and spatial redundancy.}
}
@article{CATTARINICH2026115946,
title = {An adaptive fuzzy-penalty swarm metaheuristic for the multi-demand multidimensional Knapsack problem},
journal = {Applied Soft Computing},
volume = {202},
pages = {115946},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115946},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013943},
author = {Ivo Cattarinich and Jorge Rojas-Vivanco and Vinicius Minatogawa and Jose Gornall and Jose Garcia},
keywords = {Multi-demand multidimensional Knapsack, Adaptive fuzzy penalty, Metaheuristic optimization, Local search, Swarm intelligence, Combinatorial optimization},
abstract = {The multidemand multidimensional knapsack problem (MDMKP) extends the classical multidimensional knapsack problem by combining capacity constraints to be respected with demand constraints to be satisfied, and by allowing negative profit coefficients. These features generate a tightly constrained search landscape in which feasible regions are narrow and surrounded by many infeasible configurations. This paper proposes an adaptive fuzzy binary cuckoo search algorithm that integrates Binary Cuckoo Search with a clustering-based binarization mechanism and a self-tuning fuzzy exchange local search. In the local stage, constraint violations are evaluated through normalized ratios mapped by sigmoidal membership functions, while the penalty intensity is increased during stagnation and the membership function is relaxed after a no-improvement threshold. This mechanism regulates the balance between feasibility pressure and controlled diversification near the feasibility boundary. The approach is evaluated on an extensive set of standard benchmark instances with sizes ranging from 100 to 1000 items under a controlled comparison against a Fixed-Penalty baseline, and it is further assessed through a benchmark comparison against published MDMKP algorithms. Over 30 independent runs per instance, the adaptive fuzzy variant consistently improves average solution quality and reduces run-to-run variability, with the strongest gains observed on larger and more constrained instances. On the 500-item set, statistically significant improvements are obtained in both best-of-run and average metrics (Wilcoxon p=2.0×10−6), although at a higher computational cost. Compared with published references across multiple instance scales, new best-known solutions are obtained. Overall, the proposed adaptive fuzzy penalization provides a robust and competitive mechanism for the MDMKP, particularly when solution quality and stability are prioritized over minimal runtime.}
}
@article{KUMAR2026115941,
title = {Integrating AHP and machine learning for enhanced Water Quality Index (WQI) prediction: A step towards sustainable water management in urban development},
journal = {Applied Soft Computing},
volume = {202},
pages = {115941},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115941},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601389X},
author = {Vijendra Kumar and S. Hariprasad Reddy and Saleh Alsulamy and Arpan Deshmukh and Naresh Kedam},
keywords = {Water Quality Index (WQI), Categorical Boosting (CatBoost), Light Gradient Boosting Machine (LGBM), Machine learning, MLP},
abstract = {Monitoring and predicting river water quality remains challenging due to highly dynamic hydrological conditions and the limited use of hybrid systems that combine expert-driven parameter weighting with machine learning (ML) and temporal information. This study develops a hybrid Analytic Hierarchy Process–Machine Learning (AHP–ML) framework to predict the Water Quality Index (WQI) for the Colorado River Basin. Daily water quality data from multiple USGS monitoring stations (2017–2023) covering specific conductance, temperature, and total dissolved solids were used. Expert-derived AHP weights were embedded into the modeling pipeline, and 5-day lagged WQI values were engineered to capture short-term hydrological memory. Following data cleaning, Z-score outlier removal, and feature standardization, the dataset was partitioned into training, validation, and test subsets using a fixed random seed (random_state=42). Five ML algorithms Categorical Boosting (CatBoost), Light Gradient Boosting Machine (LGBM), Multi-Layer Perceptron (MLP), K-Nearest Neighbors (KNN), and ElasticNet were systematically evaluated. The MLP achieved the strongest predictive performance on unseen data (test R² = 0.95, RMSE = 2.66), closely followed by CatBoost (test R² = 0.94) and LGBM (test R² = 0.92). Model reliability was further validated via 5-fold cross-validation and frequency-domain signal diagnostics (power spectral density, residual whiteness, and lag-1 autocorrelation), confirming that MLP and CatBoost reproduce the natural temporal signature of WQI dynamics. The findings demonstrate that integrating AHP-based expert weighting with lag-enhanced ML models improves prediction accuracy and operational interpretability for snowmelt-driven semi-arid river systems. The proposed framework offers a transparent, reproducible decision-support tool for proactive water quality monitoring and sustainable resource management in the Colorado River Basin.}
}
@article{QIAN2026115865,
title = {Granular-ball fuzzy rough set-based semi-supervised feature selection for label distribution learning},
journal = {Applied Soft Computing},
volume = {202},
pages = {115865},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115865},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601313X},
author = {Wenbin Qian and Zhichao Xu and Lujie Cheng and Weiping Ding and Jiayang Wang},
keywords = {Feature selection, Fuzzy rough sets, Label distribution data, Granular-ball computing, Semi-supervised learning},
abstract = {Label Distribution Learning (LDL) uses numerical representations to quantify the importance of each label for a given sample. As an efficient data preprocessing technique, feature selection can reduce data dimensionality and improve the performance of classifiers. However, label distribution data in practical applications often suffers from incomplete annotations. This renders feature selection methods under supervised learning inapplicable. To address this challenge, a semi-supervised feature selection method based on granular-ball computing (GSFS) is proposed for incomplete label distribution data. Specifically, the fuzzy rough sets method is first employed to calculate the fuzzy similarity between samples in feature space. Subsequently, granular-ball computing is used to capture the distributional structure of large-scale samples. Missing labels are recovered by combining supervised information of complete samples in granular-balls and local consistency constraints. Finally, to explore similarity relationships between granular-balls and samples, a feature importance measure is presented based on the fuzzy similarity between samples within granules. Experiments conducted on twelve publicly available label distribution datasets demonstrate the superiority of the proposed method over six state-of-the-art approaches. Specifically, GSFS achieves the best average ranking of 1.67 across six widely used evaluation metrics and outperforms all comparison methods in 55 out of 72 cases across all datasets and evaluation metrics.}
}
@article{YU2026115938,
title = {Deep reinforcement learning based multitasking coevolutionary algorithm for constrained multi-objective optimization problems},
journal = {Applied Soft Computing},
volume = {202},
pages = {115938},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115938},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013864},
author = {Xiaobing Yu and Xinyu Xiao and Jiawei Tang and Tianyi Wang and Lin Qu},
keywords = {CMOPs, Multitasking, Coevolutionary, Deep reinforcement learning},
abstract = {When tackling constrained multi-objective optimization problems (CMOPs) by evolutionary algorithms, objectives and constraints have to be satisfied and optimized, concurrently. During the process, operators and constraint handling techniques (CHT) are very crucial. In this article, we develop a deep reinforcement learning based multitasking coevolutionary algorithm, DRLMCA, to solve CMOPs. In the DRLMCA, solving CMOPs is transformed into a main task and a subtask. The main task is to optimize the original CMOPs, and the subtask is to help the main task. The operator of two tasks and the CHT of the subtask are deemed as the coevolutionary strategy, which is determined by deep reinforcement learning (DRL). Through DRL, the features of the main task are denoted as the state, the alternative coevolutionary strategies are actions, and the enhancement of the main task is the reward. The algorithm can adaptively select the most appropriate coevolutionary strategy according to the state of the main task and DRL. The DRLMCA is tested on three suites and twelve real CMOPs, the results are competitive when compared with ten algorithms.}
}
@article{LI2026115944,
title = {Multi-criteria group decision-making in circular intuitionistic fuzzy environment via a geometric linguistic transformation mechanism},
journal = {Applied Soft Computing},
volume = {202},
pages = {115944},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115944},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601392X},
author = {Xiaonan Li and Yuhua Qin},
keywords = {Multiple criteria group decision-making, Circular intuitionistic fuzzy sets, Consensus, Linguistic terms, Three-way decision},
abstract = {Circular Intuitionistic Fuzzy Sets (C-IFSs) provide a robust geometric framework for capturing uncertainty in Multi-Criteria Group Decision-Making (MCGDM). Nevertheless, current approaches often suffer from information loss during the linguistic term transformation and lack effective mechanisms to handle outlier opinions in the consensus process. To overcome these limitations, this paper proposes a novel consensus-driven MCGDM framework based on geometrically interpretable mappings. First, distinct from rigid static tables, we construct a parametric transformation mechanism using geometric curves within the Intuitionistic Fuzzy Interpretation Triangle (IFIT). This approach flexibly encodes experts’ risk attitudes while maintaining monotonic semantic consistency. Second, we redefine the radius of C-IFVs as a consensus measure to develop a dynamic outlier detection algorithm. By iteratively filtering extreme deviations, this method prevents the erroneous expansion of uncertainty regions and ensures the aggregation result reflects the true majority preference. Third, an improved defuzzification function is introduced to align with the proposed aggregation logic, enhancing the distinguishability of ranking results. Finally, a supplier selection case study validates that our framework significantly improves decision stability and effectively preserves semantic integrity in complex environments.}
}
@article{WAKJIRA2026115955,
title = {Physics-informed transformer with token classification for hysteretic response prediction and uncertainty quantification of reinforced concrete columns},
journal = {Applied Soft Computing},
volume = {202},
pages = {115955},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115955},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014031},
author = {Tadesse G. Wakjira and Hana L. Goshu},
keywords = {Transformer, Token classification, Uncertainty quantification, Physics-informed machine learning, Seismic performance},
abstract = {Accurate prediction of the hysteretic response of reinforced concrete (RC) columns under seismic loading is essential for performance-based design and assessment. However, existing data-driven surrogates typically provide only point estimates of the response without any measure of predictive uncertainty. Therefore, this paper proposes a tokenized bidirectional transformer that reformulates hysteresis prediction as a sequence-to-sequence token classification task in which the continuous shear force at each timestep is discretized into a probability distribution over a fixed vocabulary of shear bins, which allows the model to produce per-timestep uncertainty estimates. In addition, four physics-informed loss components, namely stiffness consistency, curvature smoothness, energy dissipation, and continuous-value accuracy, are optimized jointly with the cross-entropy classification objective. A per-specimen normalization strategy is adopted to convert the response of each specimen to the full token vocabulary. Each transformer layer is further conditioned on column-specific metadata through Feature-wise Linear Modulation (FiLM). The model’s evaluation on the test set showed a median normalized root mean square error (NRMSE) of 0.063 and a median Pearson correlation of 0.978, with a median cumulative energy dissipation capacity error of 10.5%. Five-fold cross-validation at the specimen level yields a mean median NRMSE of 0.064±0.005, which confirms the stability and generalizability of the reported performance across independent data partitions. A quantitative calibration analysis further confirms that, after a lightweight temperature recalibration, the predicted credible intervals are statistically reliable, with an expected calibration error of 0.9%. Finally, attention map analysis reveals that the first transformer layer captures local temporal dependencies within neighboring timesteps, whereas the second layer attends to timesteps with similar drift amplitudes across different cycles.}
}
@article{WANG2026115991,
title = {A deep learning model for runoff prediction via Adaptive Reinforced Feature Mining},
journal = {Applied Soft Computing},
volume = {202},
pages = {115991},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115991},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014390},
author = {Wen-chuan Wang and Hong-zhen Ren and Wei-can Tian and Xu-tong Zhang and Qi-qi Zeng},
keywords = {Daily runoff forecasting, Deep learning model, “Encoder” architecture, Global and local features, Wavelet convolution, Sliding decomposition, Mixture-of-experts},
abstract = {Artificial intelligence has introduced novel modeling approaches for runoff forecasting. However, existing models often struggle to simultaneously capture long-term trends and short-term fluctuations in runoff series and exhibit limited performance in predicting extreme events. To address these issues, in this study, we propose A Deep Learning Model for Runoff Prediction via Adaptive Reinforced Feature Mining (DRRA), which enables the adaptive extraction of both global and local features from daily runoff series. The model incorporates a sliding decomposition block within an encoder architecture to progressively separate the runoff series into a long-term trend component and a short-term seasonal component, thereby reducing interference between different trend features. For the seasonal component, wavelet convolution was introduced to extract features across different frequency bands, improving the ability of the model to capture extreme disturbances. At the output stage, a mixture-of-experts mechanism was employed to adaptively combine multiple prediction branches, thereby enhancing the overall predictive performance. Three river basins with distinct climatic and hydrological conditions were used to evaluate the models. The results show that the DRRA significantly reduces prediction errors and improves fitting performance. The Kling–Gupta efficiency reached 0.9868, 0.9698, and 0.9343 for the three basins, respectively. Compared with the long short-term memory model, the DRRA reduced the peak flow prediction error by approximately 25.4% on average. In addition, ablation experiments demonstrated that the sliding decomposition, wavelet convolution, and mixture-of-experts modules all contributed to the performance improvement. Overall, the DRRA improved both the overall prediction accuracy and peak flow prediction, providing reliable support for flood forecasting and water resource management.}
}
@article{LI2026115974,
title = {Global and local feature fusion network for few-shot image generation with space generation},
journal = {Applied Soft Computing},
volume = {202},
pages = {115974},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115974},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014225},
author = {Zhan Li and Yuning Wang and Shijie Shi and Yang Liu and Jiabao Shi},
keywords = {Few-shot image generation, Global and local, Space generation, Self-attention, Ancient WaDang},
abstract = {Convolutional Neural Network (CNN) has strong local modeling capability, but its inherently local receptive field makes it difficult to efficiently capture global dependencies while preserving fine-grained local details. Therefore, previous CNN-based few-shot image generation methods often suffer from structurally inconsistent layouts and blurred fine details in the generated images. To address this issue, we propose a method named Global and Local Feature Fusion Network for few-shot image generation with Space Generation (GLNet), which has strong local modeling and long-dependency global modeling capabilities provided by the Mixer block. We design a Base and Reference image Fusion (BRF) module to fuse the local and global features extracted by convolution and self-attention, which is further processed by Feature Space Analysis (FSA) block to generate a feature space with stronger expressive ability. Experimental results on three public datasets: Flowers, Animal Face, and Human Face show that GLNet outperforms state-of-the-art methods both quantitatively and qualitatively. Furthermore, we have also conducted experiments on our constructed cultural relic dataset WaDangCN, which is the first work to apply few-shot image generation to cultural relic generation, and also the first to be effectively applied to the cross-domain few-shot image generation. Our code is available at https://github.com/nwuAI/GLNet.}
}
@article{HOCAOGLU2026115929,
title = {Application of fuzzy AHP and ranking methods in machinery selection problems},
journal = {Applied Soft Computing},
volume = {202},
pages = {115929},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115929},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013773},
author = {M.Fatih Hocaoğlu and Emre Abay},
keywords = {Fuzzy AHP, Multi-criteria decision making, Ranking methods, Sensitivity of ranking methods, Tempering machine selection},
abstract = {This study investigates the sensitivity and robustness of the Fuzzy Analytical Hierarchy Process (Fuzzy AHP) by comparatively applying four distinct fuzzy ranking methods—Chang’s Extended Method, the Mean Method, the Square Mean Method, and the Kwong-Bai Method—to a real-world multi-criteria decision-making (MCDM) problem concerning the procurement of a tempering machine for a glass manufacturing company. While standard MCDM applications focus primarily on final outcomes, the novelty of this research lies in its methodological exploration of how the width of triangular fuzzy membership functions (TFNs) influences the discriminative power of these ranking techniques. The evaluation models expert assessments across seven criteria: cost, flexibility, safety, after-sales service, operational convenience, machine dimensions, and productivity, using both narrow and wide fuzzy importance scales. Quantitative analysis reveals that under the narrow scale, Chang’s Method exhibits the highest discrimination with a dispersion value of 0.2414 (compared to approximately 0.154 for the other three methods) and assigns a dominant weight of 0.521 to the top alternative (T3), versus 0.452 with the Mean Method. Conversely, the wide fuzzy scale leads to more convergent results, reducing Chang’s dispersion by up to 44%, thereby demonstrating its high sensitivity to increased fuzziness, whereas mean-based methods maintain high stability. Despite these methodological score disparities and variations in dispersion, all techniques consistently converged on the same optimal alternative (T3). This paper bridges theoretical sensitivity with practical industrial application, contributing to the Fuzzy MCDM literature by providing a robust framework to match specific ranking methods to the uncertainty level of the decision context.}
}
@article{HE2026115990,
title = {Overfitting identification in machine learning models with the person-fit indicator},
journal = {Applied Soft Computing},
volume = {202},
pages = {115990},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115990},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014389},
author = {Ruihang He and Yongze Xu},
keywords = {Item response theory, Machine learning, Item preknowledge, Person-fit indicator, Overfitting},
abstract = {Machine learning models’ generalizability is frequently compromised by overfitting, a persistent challenge lacking robust, sample-aware identification standards. Traditional overfitting detection methods rely on aggregate performance discrepancies between training and test sets, ignoring inherent heterogeneity in sample difficulty and discriminative power, leading to unstable and misleading assessments. Drawing on psychometric item response theory (IRT), we establish a theoretical analogy between model overfitting and item preknowledge in ability assessment, adapt the well-validated TW person-fit indicator for multi-model overfitting detection, and further develop the Process TW Difference (PTWD) indicator to enable dynamic overfitting assessment for single models during training. Simulation experiments show the TW indicator consistently outperforms traditional performance difference metrics and perturbation-based methods across diverse feature distributions and train-test split ratios. Empirical studies on image classification, medical diagnosis, and financial credit scoring datasets validate the PTWD indicator’s robustness, especially in class-imbalanced scenarios where traditional metrics lose discriminative power. This work provides a theoretically grounded, computationally efficient framework for reliable overfitting identification in machine learning.}
}
@article{LI2026115905,
title = {HDENet: A hierarchical decomposition-ensemble neural network for prediction of multi-periodic water quality in wastewater treatment process},
journal = {Applied Soft Computing},
volume = {202},
pages = {115905},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115905},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013530},
author = {Wenjing Li and Zhi Liang and Ruoqing Qiu and Junfei Qiao},
keywords = {Gated recurrent unit, Hierarchical decomposition, Hierarchical ensemble, Multi-periodicity, Wastewater treatment process},
abstract = {The accurate prediction of water quality is of critical importance for the effective management of wastewater treatment plants (WWTPs). However, water quality variables exhibit high multi-periodicity, making accurate prediction of water quality more challenging. To address this issue, this study proposes a hierarchical decomposition-ensemble neural network (HDENet) for multi-periodic water quality prediction. HDENet employs a hierarchical decomposition-ensemble framework. Specifically, a two-level hierarchical decomposition algorithm is first proposed: the first level adopts the seasonal-trend decomposition using loess (STL) to decompose the wastewater series into trend, seasonalities, and remainder; the second level employs the complete ensemble empirical mode decomposition with adaptive noise (CEEMDAN) to further separate the seasonal component into distinct intrinsic mode functions (IMFs) representing multiple seasonalities. Then, an ensembled attention-gated recurrent unit (EA-GRU) predictor is designed to predict the multiple seasonalities, with the training efficiency improved by removing redundant components and the prediction accuracy enhanced by weighting for effective components. Experimental results using a real dataset from a WWTP show that HDENet achieves better prediction performance for the multi-periodic water quality, improved by an average of 13.1%, 14.4% and 7.8% for RMSE, MAE and R2 than other comparative models, and offers a more favorable balance between computational complexity and prediction accuracy. The improvement has been demonstrated to be attributed to the decomposition of multi-periodic components by hierarchical decomposition as well as the prediction for the seasonalities with EA-GRU.}
}
@article{LIU2026115966,
title = {Multi-scale temporal transformer for long-term airspace traffic forecasting},
journal = {Applied Soft Computing},
volume = {202},
pages = {115966},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115966},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014146},
author = {Bo Liu and Weizhen Tang and Zhousheng Huang and Jie Dai},
keywords = {Transformer, Unet, Dynamic embedding layer, Multidimensional temporal feature Decomposition and reconstruction, Enhanced positional awareness, Airspace traffic forecasting},
abstract = {Airspace traffic forecasting plays a crucial role in enhancing airport operational efficiency. Despite progress in short-term traffic prediction, long-term forecasting remains challenging. This difficulty arises due to the reduced capacity of prediction models to capture temporal features as the granularity of time series increases. Additionally, the loss or blurring of spatial information over long sequences further diminishes predictive accuracy. To address these issues, we propose a Transformer-based model in this paper. By incorporating Unet as a dynamic embedding layer within the Transformer architecture, we enable the decomposition and reconstruction of multidimensional temporal features, compensating for the Transformer’s limitations in capturing local features. The learnable positional encoding is further refined by leveraging Unet’s convolutional properties, allowing the model to more effectively capture positional information in the time series. To validate the effectiveness of the proposed model, we evaluate its performance on four real-world datasets, considering both coarse- and fine-grained levels. Comparisons with eighteen baseline models, including widely used airspace traffic prediction models and other time series forecasting models, demonstrate that our approach achieves superior predictive performance at both granularities.}
}
@article{YU2026115994,
title = {Constrained multi-objective optimization: A multiple population cooperative evolution framework based on lightweight adaptive operator selection},
journal = {Applied Soft Computing},
volume = {202},
pages = {115994},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115994},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014420},
author = {Xiaobing Yu and Yifei Li},
keywords = {Evolutionary algorithms, Cooperative evolution, Evolutionary operator selection, Constrained multi-objective optimization},
abstract = {Constrained multi-objective optimization problems (CMOPs) are challenging because they need to simultaneously deal with objective conflicts, constraint limitations, and high-dimensional complexity. Especially on CMOPs with small feasible regions, existing algorithms lack sufficient convergence and diversity. As a crucial element of constrained multi-objective evolutionary algorithms, operator selection significantly influences the convergence, diversity and feasibility of the algorithms. To solve this issue, we propose a multi-population cooperative evolutionary framework based on lightweight adaptive operator selection (MPCE-AOS) for solving CMOPs. The framework contains a lightweight adaptive operator selection model that gradually self-adapts the operator selection strategy by learning from the experience of solutions generated by previous operators. Thus, more suitable operators can be adaptively determined to match different stages of evolution. Through extensive experimental studies and comparisons with eleven state-of-the-art Constrained Multi-Objective Evolutionary Algorithms (CMOEAs) on three benchmark suites and five real-world problems, the results indicate that the proposed methodology provides better convergence and diversity capabilities and is computationally faster than comparable methods.}
}
@article{ZHU2026115897,
title = {A hybrid semantic and reconstruction learning framework for efficient low-bitrate screen content image compression},
journal = {Applied Soft Computing},
volume = {202},
pages = {115897},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115897},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013451},
author = {Zhiyuan Zhu and Min Li and Jiawei Qi and Tong Tang and Xinqi Lin and Dapeng Wu and Ruyan Wang},
keywords = {Screen content image, Image compression, Textual content, Low-bitrate},
abstract = {Screen content images (SCIs), characterized by a mixture of discrete textual elements and continuous natural content, pose significant challenges for high-quality compression at low bitrates. To address this, we propose a novel joint framework that synergistically combines textual semantic representation and super-resolution (SR) techniques for efficient low-bitrate SCI compression. Our approach introduces a hybrid compression pipeline: textual content is extracted and encoded based on its semantic attributes, while the non-textual background undergoes pixel-wise removal and is compressed using a dedicated super-resolution strategy tailored for screen content. A key innovation is the pixel-wise textual content removal scheme, which leverages the Segment Anything Model (SAM) for precise text segmentation and the advanced LaMa inpainting model to seamlessly reconstruct the background, thereby preserving critical texture details. Furthermore, we design a specialized super-resolution network for the decompressed background, which effectively restores sharp edges and mitigates compression artifacts through global feature fusion and a tailored loss function. Extensive experiments on public SCID and SIQAD datasets demonstrate that our method achieves an average Bjontegaard-Delta (BD) rate reduction of 44.10% compared to the state-of-the-art semantic-based method TSA-SCC [1], with a maximum reduction reaching of 70.57%, significantly enhancing visual quality at low bitrates.}
}
@article{ZUO2026115958,
title = {Deeper spatiotemporal learning memory unit for video frame prediction},
journal = {Applied Soft Computing},
volume = {202},
pages = {115958},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115958},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014067},
author = {Tian-Yu Zuo and Ping Mei and Changzheng Liu},
keywords = {Video prediction, Spatiotemporal receptive field, Recurrent neural network, Spatiotemporal sequence learning},
abstract = {Video (frame) prediction is a spatiotemporal learning problem that aims to predict future sequences based on historical observations. Recursive prediction paradigms have been widely adopted, where spatiotemporal features propagate through time and are generated frame by frame through a terminal decoder. Building on prior work, we find that complex spatiotemporal state transition functions effectively expand the spatiotemporal receptive field and enhance the model’s spatiotemporal learning capability. To demonstrate this finding, we design a deeper spatiotemporal learning unit, called the Deep-ST unit, which consists of multiple carefully designed independent spatiotemporal modules in a cascade to model complex spatiotemporal state transition processes. By stacking several Deep-ST units, we improve the model’s efficiency in spatial feature extraction and temporal correlation modeling. Furthermore, we propose a Horizontal-Vertical memory decoupling mechanism that enforces the learning of independent features in the memory state. Deep-ST achieves competitive performance across seven benchmarks within the convolution-based RNN paradigm. Ablation studies confirm that each cascaded module contributes to the overall performance. Moreover, experiments show that predicted frames remain usable by off-the-shelf pose-estimation, object-detection, and segmentation models.}
}
@article{WU2026115889,
title = {Multi-objective parameter optimization of a fuzzy fractional-order PID controller for dual-axis solar tracking systems using a distance-guided NSGAIII (DGM-NSGAIII)},
journal = {Applied Soft Computing},
volume = {202},
pages = {115889},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115889},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013372},
author = {Dafei Wu and Ying Zhang and Yi Hou},
keywords = {Fuzzy fractional-order PID, Dual-axis solar tracking, Multi-objective optimization, NSGAIII, Parameter tuning},
abstract = {High-precision attitude control is critical for maximizing energy harvesting in dual-axis solar tracking systems, which exhibit nonlinear dynamics and are susceptible to external disturbances. Conventional controllers, including standard PID and fractional-order PID (FOPID), often fail to meet the stringent performance demands under such conditions. To address this gap, this paper proposes an optimal fractional-order PID controller with a fuzzy proportional gain (OFFOPID). The proposed controller enhances the conventional FOPID structure by integrating a fuzzy logic module into the proportional channel and placing a fractional-order operator at its input, thereby improving tracking error sensitivity and accelerating dynamic response. For multi-objective parameter optimization, an enhanced NSGA-III algorithm, termed DGM-NSGAIII, is developed, incorporating a distance-guided crossover strategy to maximize population diversity and global search capability. The optimization minimizes three objectives: steady-state error (SSE), integral squared error (ISE), and overshoot percentage (OP). Simulation and hardware-in-the-loop experiments show that, compared to the best competing controller, the proposed OFFOPID achieves an average reduction of 90.6% in ISE, 66.7% in SSE, and 46.2% in OP across five test scenarios. Furthermore, the steady-state tracking error under real solar trajectories remains within ±1∘ throughout the day, with noon-period errors below 0.3∘, thus satisfying the high-precision requirements of photovoltaic power generation.}
}
@article{BEHERA2026115933,
title = {A review of generative autoencoder frameworks and their latent modeling strategies},
journal = {Applied Soft Computing},
volume = {202},
pages = {115933},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115933},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013815},
author = {Mousumi Behera and Prasenjit Dey},
keywords = {Adversarial autoencoders, Variational autoencoders, Generative autoencoders, Diffusion-based autoencoders, Latent space modeling},
abstract = {Autoencoder (AE)-based models represent a diverse family of architectures designed for unsupervised learning, structured representation compression, controllable data synthesis, etc. Although they are widely applied across image, text, and speech modalities, their latent behavior and generative dynamics remain under-characterized in existing reviews. This survey organizes AE variants according to the way they regulate latent structure, incorporate prior assumptions, and balance reconstruction accuracy with generative diversity. We examine deterministic, probabilistic, adversarial, and diffusion-based AEs through representative architectures, including Sparse, Denoising, and Convolutional Autoencoders; Variational Autoencoder (VAE) derivatives, e.g., β-VAE, Conditional VAE, Vector Quantized VAE, Wasserstein AE; adversarial frameworks, e.g., Adversarial AE, Introspective VAE, and Adversarial Generator–Encoder Network, VAE-Generative Adversarial Network (VAE-GAN), Bidirectional GAN; and diffusion-based frameworks employing latent autoencoding, e.g., Latent Diffusion Model and Diffusion Autoencoders. For each, we analyze latent constraints, architectural trade-offs, and recurring issues such as posterior collapse, mode imbalance, and codebook degradation. We also discuss hybrid architectures that combine latent inference with iterative or adversarial generation strategies. Further, case studies in image inpainting, speech denoising, and topic modeling illustrate how latent mechanisms affect learning behavior and application outcomes. Overall, this review consolidates recent advances through a unified latent-space-centered taxonomy and comparative analysis, providing a comprehensive perspective on AE-based generative frameworks across diverse application domains.}
}
@article{ALI2026115949,
title = {MAMFF: Multiscale adaptive modulated feature fusion for semi-supervised HSI classification with disjoint sampling},
journal = {Applied Soft Computing},
volume = {202},
pages = {115949},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115949},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013979},
author = {Aamir Ali and Caihong Mu and Yi Liu and Mosa Haidarh},
keywords = {Hyperspectral image classification, Disjoint sampling, Semi-supervised learning, Transformer-based architecture},
abstract = {Hyperspectral image (HSI) classification has achieved remarkable progress, with many models achieving nearly perfect accuracy on widely used datasets. However, these performances are often inflated by the use of random sampling strategies, which introduce spatial overlap and redundancy between training and testing samples. To address these challenges, an enhanced Dynamic Spatial Region-aware Disjoint (DyReg-Disjoint) sampling strategy is proposed. Unlike existing disjoint methods relying on superpixel segmentation or rigid grids, or methods overly similar to random sampling, DyReg-Disjoint employs clustering-based spatial region partitioning with adaptive seed selection, ensuring strict spatial non-overlap while adaptively preserving class balance and spatial region diversity across the labeled, unlabeled, and test samples, thereby minimizing patch-level and spatial leakage. Furthermore, a Multiscale Adaptive Modulated Feature Fusion Network (MAMFF) is proposed for HSI classification with spatially disjoint sampling. The proposed architecture integrates Residual Dense Convolutional (RDC) blocks and a Local Context-aware Hybrid Transformer (LCHT). The RDC blocks enhance local features through residual learning and dense connectivity, ensuring efficient feature reuse. Additionally, the LCHT fuses convolutional embeddings with attention blocks to jointly model local feature continuity and global spectral-spatial representations. An Adaptive Modulated Feature Fusion (AMFF) module further selectively balances multi-scale features from multiple hierarchies, enhancing the representation of discriminative features. To leverage unlabeled data, an enhanced semi-supervised learning framework is proposed, where a confidence-aware pseudo-labeling strategy with an epoch-wise adaptive threshold is employed, combining confidence filtering and consistency regularization using Kullback-Leibler divergence, improving robustness when labeled samples are scarce. Extensive experiments demonstrate that the proposed approach delivers superior classification performance and achieves overall accuracies surpassing the second-best model by up to 4.15 %age points. These consistent gains highlight the effectiveness of the proposed modules in advancing reliable and generalizable HSI classification, while also indicating the feasibility of the DyReg-Disjoint sampling strategy.}
}
@article{BENITO2026115925,
title = {A dynamic explainability method for fuzzy cognitive maps based on causal and temporal evolution analysis},
journal = {Applied Soft Computing},
volume = {202},
pages = {115925},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115925},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013736},
author = {Diego Benito and Jose Aguilar and Juan {Marcos Ramírez} and Marçal {Mora Cantallops} and Antonio {Fernández Anta}},
keywords = {Explainability methods, Fuzzy cognitive maps, Machine learning, Causality approaches, Classification models},
abstract = {In recent years, explainability methods in machine learning have gained importance with the rise of complex models that lack interpretability, such as deep neural networks, limiting confidence and adoption. Existing methods (LIME, SHAP) are often misleading in dynamic contexts, highlighting the need for new explainability approaches that capture temporal and causal reasoning. This work presents a novel dynamic and local explainability method applied to Fuzzy Cognitive Maps (FCMs) in classification tasks, based on the analysis of causal relationships and the temporal evolution of concepts throughout the reasoning process. The method was evaluated on four datasets, and its performance was compared with classical explainability methods, including SHAP and Feature Permutation (FP), as well as graph-theoretic centrality measures. Furthermore, the quality of the generated explanations was analyzed using the ROAR (RemOve And Retrain) method. Finally, it was verified whether the method satisfies the desirable properties expected from explainability approaches reported in the literature. The results demonstrate that the explanations are consistent with the dynamics of the FCMs and surpass those produced by SHAP and FP in quality. The proposed method significantly improves the understanding of classification models using FCMs, providing an accurate and detailed interpretation of the model’s behavior, which positions it as a valuable tool in sensitive contexts where explainability is essential.}
}
@article{ZHANG2026115962,
title = {A hybrid evolutionary framework for procedural dungeon generation using GAN-based spatial priors},
journal = {Applied Soft Computing},
volume = {202},
pages = {115962},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115962},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014109},
author = {Shunan Zhang and Yi Xiao and Yan Zheng},
keywords = {Search-based procedural content generation, Generative adversarial networks, Spatial priors, Artificial potential fields, Continuous constrained optimization},
abstract = {Search-based procedural content generation (SBPCG) can generate diverse dungeon layouts, but evolutionary search over high-dimensional spatial representations often spends many evaluations on infeasible candidates and converges slowly. Meanwhile, generators based on Generative Adversarial Networks (GANs) can capture global structural regularities from example maps, but direct sampling provides limited control over feasibility, connectivity, and progression constraints. We propose a GAN-Guided Evolutionary Algorithm (GGEA) that integrates learned spatial priors with a Feasible-Infeasible Two-Population (FI-2Pop) optimization framework. The output of a GAN trained on dungeon layouts is transformed into a continuous artificial potential field, which serves as a soft geometric prior for guiding initialization and variation toward structurally plausible regions. Guided by this prior, we introduce a skeleton-based parametric encoding that anchors critical rooms along the main traversal path while preserving local geometric flexibility. To handle geometric constraints while promoting diverse designs, we employ an FI-2Pop scheme integrated with a single-objective genetic algorithm: an infeasible population minimizes constraint violations to recover valid layouts, while a feasible population maximizes a scalar composite fitness integrating potential-field alignment, coverage fidelity, geometric symmetry, and experience novelty. Experiments show that GGEA achieves higher external evaluation scores than the evaluated GAN-LVE and Cartesian EA baselines under the same experimental protocol. Compared with traditional Cartesian-based evolutionary search, the framework exhibits significantly faster convergence. Expressive range analysis further indicates that GGEA generates diverse dungeon layouts and covers a broader region of the design space.}
}
@article{SHI2026115896,
title = {MGSTN: A multi-granularity spatio-temporal network for citywide traffic forecasting},
journal = {Applied Soft Computing},
volume = {202},
pages = {115896},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115896},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601344X},
author = {Xiaoying Shi and Guoyi Li and Bowen He and Haitao Xu and Jing Chen and Liming Tu and Yongping Zhang},
keywords = {Traffic forecasting, Transportation management, Spatiotemporal data, Graph convolutional network, Transformer},
abstract = {Urban traffic forecasting is crucial for promoting sustainable transportation and optimizing mobility management. However, accurately predicting citywide traffic remains challenging due to the spatiotemporal complexity and non-stationary nature of human mobility. Existing methods typically model spatial or temporal dependencies at a single granularity, overlooking the multi-scale characteristics inherent in urban traffic flows. To address these issues, we propose a Multi-Granularity Spatio-Temporal Network (MGSTN) for citywide traffic prediction, which jointly captures spatial, temporal, and attribute features. A distance graph and a semantic graph are constructed to model multi-granular spatial dependencies, while three temporal tensors are organized to capture patterns at different temporal granularities. Spatial features are extracted from the distance and semantic graphs using graph and relational graph convolutional networks, while a non-stationary Transformer is applied to model the inherent non-stationarity of traffic flows. Experiments conducted on New York City’s taxi and bike-sharing datasets show that MGSTN outperforms state-of-the-art methods, achieving average improvements of 3.44% in MAE and 4.08% in RMSE. These results demonstrate its potential to deliver accurate and efficient crowd flow forecasts.}
}
@article{KUMAR2026115893,
title = {LumiShadDiffusion: Overcoming shadowing challenges in diffusion models},
journal = {Applied Soft Computing},
volume = {202},
pages = {115893},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115893},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013414},
author = {Prashant Kumar and Preetish Kakkar and Aakansha Mishra and Pravendra Singh},
keywords = {Diffusion models, Shadow generation, Text-to-image, Image synthesis, Blender},
abstract = {Diffusion models have shown remarkable success in generating high-quality and diverse images, benefiting from their strong generative capabilities guided by user prompts. However, they often struggle with the realistic synthesis of shadows, leading to inconsistencies and poor alignment with the lighting conditions of the scene. This limitation restricts the application of diffusion models when accurate shadow representation is essential. To this end, in this work a novel approach, LumiShadDiffusion is introduced that improves shadow generation by integrating explicit lighting direction information into the diffusion process, addressing the inconsistencies found in standard diffusion models. Proposed approach incorporates shadow maps during training, allowing the model to better capture shadow behavior and improve shadow placement consistency. LumiShadDiffusion leverages a carefully constructed synthetic dataset generated in Blender, where each image is paired with corresponding shadow maps under diverse directional (sun-type) lighting, providing pixel-accurate hard-shadow supervision. Our approach introduces cross-attention alignment (CAA) loss and light-parameter conditioning to improve shadow placement consistency, leading to more realistic shadow synthesis. LumiShadDiffusion method combines diffusion models with enhanced shadow generation, enabling the model to create realistic and accurately positioned shadows in generated images. The model’s inherent capability to generate high-quality images from textual prompts remains fully preserved. Extensive experiments and ablation analysis with synthetic and real-world data show that LumiShadDiffusion outperforms conventional approaches in terms of visual quality and controllability.}
}
@article{WANG2026115945,
title = {RGB-thermal-depth decision-level fusion network for crowd counting},
journal = {Applied Soft Computing},
volume = {202},
pages = {115945},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115945},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013931},
author = {Yuxuan Wang and Liangang Tong and Xinyu Liu and Weihang Kong and He Li},
keywords = {Crowd counting, Multimodal interaction, Decision-level fusion, Illumination-aware depth weighting},
abstract = {To address the challenges of crowd counting under complex illumination conditions and severe occlusion, this paper proposes an innovative RGB-Thermal-Depth (RGB-T-D) decision-level fusion crowd counting network. Existing dual-branch methods predominantly struggle in complex real-world scenarios: visible light degrades drastically in low-light conditions, thermal imaging lacks fine structural details, and depth estimation is highly susceptible to environmental noise. Ultimately, these limitations within dual-branch frameworks lead to severe localization errors and degraded counting accuracy. To overcome these bottlenecks, we introduce a novel tri-modal framework to fully exploit cross-modal complementarity. First, to align the estimated depth maps more closely with real-world scenarios, we present an illumination-aware depth weighting mechanism. Second, to effectively harness the complementary strengths of the three modalities, we design a tri-modal feature interaction module. Guided by illumination priors extracted from RGB images, this module dynamically modulates cross-modal interaction, effectively mitigating modal discrepancies and suppressing environmental noise. Finally, to facilitate optimal multi-modal integration, we propose a weighted decision-level fusion module equipped with a lightweight gating network. This module adaptively learns and extracts fusion weights to dynamically control the blending ratio among RGB, T, and D predictions. Our model achieves a GAME(0) of 10.25 and an RMSE of 18.22 on the surveillance-view RGBT-CC dataset, alongside a GAME(0) of 6.10 and an RMSE of 10.13 on the drone-view DroneRGBT dataset, demonstrating the superiority of the proposed method.}
}
@article{HSU2026116006,
title = {A fair benchmark of deep models for non-stationary stock price forecasting: RevTransLSTM-AR as a complexity probe},
journal = {Applied Soft Computing},
volume = {202},
pages = {116006},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116006},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014547},
author = {Feng-Jui Hsu and Chih-Chien Hsieh and Shih-Chieh Lin and Chen-En Lan and Mu-Yen Chen},
keywords = {Stock price forecasting, Non-stationary time series, Reversible instance normalization, Fair benchmark, Complexity probe, Parameter efficiency, Transformer, LSTM},
abstract = {For non-stationary stock prices, it remains unclear whether a more complex forecasting architecture actually delivers higher accuracy. This study takes up that question by building RevTransLSTM-AR, a hybrid model that deliberately combines the mechanisms usually credited with helping—Reversible Instance Normalization (RevIN), a Transformer encoder, an LSTM decoder, and closed-loop autoregressive latent feedback. It then asks whether all that machinery pays off. The comparison is deliberately even-handed: every baseline, simple or complex, is given the same RevIN, the same data, and the same training and evaluation protocol. The evaluation spans eight assets and four horizons (T∈{1,5,10,20}, 32 settings), repeats each run over five random seeds, and checks the differences with three statistical tests, a component ablation, and a look-back sensitivity analysis. The picture that emerges is consistent: once normalization is shared, accuracy is driven mostly by instance-level distribution alignment rather than by architectural complexity. The simple recurrent and linear models lead. RevTransLSTM-AR, though it carries the fewest parameters of any nonlinear model, only keeps pace with attention-based baselines many times its size and trails the lightweight recurrent and linear ones. The look-back analysis points the same way: these series carry little persistent structure, so a short window is enough. The study is therefore offered less as a new state of the art than as evidence about where limited model capacity is, and is not, worth spending.}
}