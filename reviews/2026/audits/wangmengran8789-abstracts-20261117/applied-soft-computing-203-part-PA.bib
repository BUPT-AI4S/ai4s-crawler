@article{YAO2026116091,
title = {Conflict elimination based on improved hierarchical clustering and social trust network in group decision making},
journal = {Applied Soft Computing},
volume = {203},
pages = {116091},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116091},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015395},
author = {Yushan Yao and Huangjian Yi and Zhanhao Liu and Jiajia Wang and Xiaonan Li},
keywords = {Group decision making, Social trust network, Expert influence, Improved hierarchical clustering, Opinion adjustment mechanism},
abstract = {In group decision making, conflicts inevitably appear among experts due to their different preferences. The presence of conflicts thus hinders the acquisition of valid decision outcomes. To reduce the degree of conflicts among experts and reach a consensus, this paper develops a method to eliminate conflicts in group decision making, which determines the weights of experts and promotes the consensus of experts under an intuitionistic fuzzy context. Most existing expert weight determination methods for group decision-making depend merely on a single fixed factor. To derive rational expert weights, this work simultaneously takes experts’ preference difference degrees and social trust degrees into consideration. We define the relative preference degree of experts over alternative pairs to quantify pairwise preference discrepancies among experts, and estimate path reliability degrees to screen valid trust propagation paths. Traditional consensus adjustment models fail to target experts with high conflicts and ignore the balance between local and overall group conflicts. In the consensus reaching stage, an improved hierarchical clustering is presented to group the experts with large conflicts together. A clustering-based expert opinion adjustment mechanism is proposed, which can achieve a balance between the local and overall conflicts of the experts. A complete numerical example is conducted to illustrate the feasibility of this method. Comparative analyses with other existing methods are carried out to further validate its effectiveness, and a parameter sensitivity analysis is performed to examine its robustness.}
}
@article{WANG2026115881,
title = {Robust object recognition in complex scenes with fuzzy embeddings and Siamese networks},
journal = {Applied Soft Computing},
volume = {203},
pages = {115881},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115881},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013293},
author = {Weiye Wang and Ting Lei},
keywords = {Siamese Network, Object Recognition, Spatial Pyramid Pooling (SPP), Fuzzy Embedding, Contrastive Loss, Computer Vision, Spatial Attention Mechanism},
abstract = {This paper presents a strong object recognition architecture for cluttered and complex environments through the combination of a Multi-Scale Spatial Attention and Pyramid Pooling (MS-SAPP) module with a Fuzzy Adaptive Siamese Network (FASNet). MS-SAPP extracts multi-scale local and contextual features through spatial attention and pyramid pooling to enable object recognition of different sizes. FASNet increases noise and ambiguity robustness with fuzzy embeddings from the use of Gaussian membership functions. Contrastive loss enhances discriminative feature matching and precise object discrimination for Siamese architecture. The method proposed is tested on several datasets, such as Common Objects in Context (COCO) 2017, ImageNet 10 K, and Pascal Visual Object Classes (VOC) 2012. It outperformed other state-of-the-art models several times with Separate Feature Refinement (SFRNet), Faster Region-Convolutional Neural Network (Faster R-CNN), and You Only Look Once version 4 (YOLOv4), with an Intersection over Union (IoU) of 0.93, Precision of 97.2%, Recall of 95.1%, F1-Score of 96.1%, mean Average Precision@0.5 (mAP@0.5) of 97.7%, and mAP@0.95 of 89.9%. Studies on ablation confirm the critical contributions of each module. The approach puts forward a scalable and reliable solution appropriate to applications such as autonomous driving, intelligent surveillance, and image retrieval.}
}
@article{ALKHULAIDI2026115997,
title = {Emotion-based reinforcement learning for passivity-based control of redundant manipulators in challenging environments},
journal = {Applied Soft Computing},
volume = {203},
pages = {115997},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115997},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014456},
author = {Rami Al-Khulaidi and Tien-Fu Lu and Steven Grainger and Rini Akmeliawati},
keywords = {Reinforcement Learning, Bio-Inspired Control, Emotion-Based Learning, Passivity-Based Control, Redundant Manipulator, Finite-State Machine},
abstract = {Controlling redundant manipulators in unstructured environments like agricultural settings is challenging due to high nonlinearities and the need for both precision and stability. This paper presents a novel intelligent control architecture that integrates a stable-by-design Passivity-Based Control (PBC) law with a bio-inspired reinforcement learning tuner. The core novelty lies in our Human Learning Behaviour (HLB) model, which, unlike conventional reward shaping, employs a finite-state machine to dynamically modulate the exploration strategy of a Deep Deterministic Policy Gradient (DDPG) agent. This state machine transitions between discrete states, framed as artificial emotions (e.g., Joy, Fear), based on real-time performance indicators. Each state directly adjusts the agent's exploration noise, enabling it to learn more efficiently by exploring aggressively when performance is poor and exploiting known good policies when performance is high. This adaptive tuner intelligently adjusts the proportional (Kp) and differential (KD) gains of the PBC law, which is derived from a Port-Controlled Hamiltonian (PCH) model to ensure the underlying manipulator dynamics remain stable for any positive-definite gains selected by the learning agent. Validated on an 8-DOF manipulator in simulated, obstacle-rich agricultural scenarios, the HLB-driven controller demonstrated a 77–80% improvement in trajectory tracking and a 30.7% reduction in energy consumption compared to fixed-gain and standard DDPG baselines, while maintaining a final tracking error of approximately 10⁻⁴ radians. The results confirm that our FSM-based adaptive exploration strategy yields a highly precise, energy-efficient, and robust intelligent control system suitable for complex robotic applications.}
}
@article{RAVBER2026115973,
title = {Measuring successful, failed and deceptive exploration of evolutionary algorithms based on attraction basins},
journal = {Applied Soft Computing},
volume = {203},
pages = {115973},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115973},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014213},
author = {Miha Ravber and Jernej Jerebic and Matej Črepinšek and Luka Mernik and Stephen Chen and Marjan Mernik},
keywords = {Evolutionary algorithm, Exploration and exploitation, Attraction basin, Successful, Failed, Deceptive exploration, Successful rejection},
abstract = {This paper introduces a novel direct measure of exploration and exploitation in Evolutionary Algorithms, based on attraction basins—regions of the search space with an attractor toward which neighboring solutions tend to evolve. Each solution can be associated with a particular attraction basin. If a new solution belongs to the same attraction basin as its parent, then the search process is identified as exploitation; otherwise, it is identified as exploration. Four different exploration type definitions were used: successful, failed, deceptive, and successful rejection. These are measured directly at the individual level (without precomputing basins) on six single-objective continuous benchmark problems and a real-world problem using DE/rand/1/bin, JADE, LSHADE, ABC, and TLBO. The results revealed that EAs differentiate themselves in how they handle different types of exploration. The approach outperformed prior basin-based measures in efficiency, and exposed the limitations of diversity-based methods, enabling explicit quantification and control of the balance between exploration and exploitation.}
}
@article{FAN2026116013,
title = {YOLO-CTBE: A multi-module enhanced network for fine-grained detection of pepper leaf diseases},
journal = {Applied Soft Computing},
volume = {203},
pages = {116013},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116013},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014614},
author = {Yukang Fan and Yong Zeng and Yulong Nan},
keywords = {Deep learning, Pepper, Disease identification, YOLO, Precision agriculture},
abstract = {Pepper is an important economic vegetable in China, and its leaf diseases often lead to yield reduction in large-scale cultivation. To address the shortcomings of existing methods in complex backgrounds, small target recognition, and robustness, this paper proposes an improved YOLO-CTBE model. In feature extraction, the model adopts the proposed EMSC and C3EM modules to enhance the modeling capability for lesion textures and multi-scale features. The backbone incorporates the Triplet Attention mechanism to improve the feature discriminability in both channel and spatial dimensions. For feature fusion, an enhanced BiFPN (E-BiFPN) structure is employed to optimize cross-scale interaction. Finally, the EMASlideLoss weight loss function is designed to enhance the model’s learning effect on high-quality samples through dynamic IoU weights. Experimental results show that the YOLO-CTBE model achieves 83.4% mAP@50 and 53.6% mAP@50:95 on the green pepper disease dataset, which are 1.7% and 2.6% higher than those of the baseline, respectively. It realizes a better balance between accuracy and complexity, providing an efficient solution for the intelligent monitoring of plant diseases.}
}
@article{RAMIREZBAUTISTA2026116016,
title = {DengueCare: A generative artificial intelligence and fuzzy reasoning approach to improving hospitalization predictions in dengue patients},
journal = {Applied Soft Computing},
volume = {203},
pages = {116016},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116016},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601464X},
author = {Julian Andres Ramirez-Bautista and Silvia L. Chaparro-Cárdenas and Juan Terven and Diana-Margarita Córdova-Esparza and Graciela Olarte-Rueda and Rosa Villarreal-Pérez},
keywords = {Data augmentation, Dengue disease, Fuzzy Cognitive Maps, Machine learning, Soft voting ensemble, And Electronic medical data},
abstract = {According to the World Health Organization (WHO), tropical and subtropical regions face a significant challenge with dengue, a viral infection transmitted by the Aedes aegypti mosquito. This disease places considerable pressure on healthcare systems due to the severe complications it can develop. In response to the increasing demand for hospital beds due to dengue cases, various strategies have been developed to optimize available healthcare resources. This optimization is especially critical in resource-constrained or remote clinical environments where rapid, accurate triage and predictive resource allocation are necessary. In this context, an advanced classification system is presented that integrates fuzzy reasoning (Fuzzy Cognitive Maps) with traditional machine learning techniques. The system incorporates various ensemble strategies, including weighted voting, stacking, and probability calibration, which provide interpretability by modeling causal relationships, significantly enhancing the robustness and accuracy of predictions. A key aspect has been overcoming the limitations of access to real clinical data by generating a synthetic database derived from variational autoencoder (VAE). The results are promising, as the model developed achieves 88% accuracy in predicting cases requiring hospitalization and an F1 score of 0.87. This implementation establishes a solid foundation for applying FCM to medical classification problems, combining interpretability with the predictive power of advanced machine learning techniques.}
}
@article{FAN2026116037,
title = {Dual-frequency-guided self-conditioned diffusion model for small-sample fault diagnosis with long-tailed distributions},
journal = {Applied Soft Computing},
volume = {203},
pages = {116037},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116037},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014857},
author = {Caizi Fan and Hui Ma and Yongchao Zhang and Chao Zhao and Tianyu Zhao and Zhijun Li},
keywords = {Intelligent fault diagnosis, Frequency information fusion, Conditioned diffusion model, Limited samples, Imbalanced scenarios},
abstract = {Reliable fault diagnosis is essential for ensuring industrial system safety, but in practical applications fault samples are often extremely scarce and exhibit long-tailed distributions. Existing data augmentation methods suffer from mode collapse under limited data and fail to fully exploit frequency-domain characteristics of vibration signals. To address this issue, this paper proposes a self-conditioned diffusion-based fault diagnosis framework that integrates low- and high-frequency feature fusion for high-quality fault signal generation. Specifically, low-frequency components are exploited to preserve the global signal trend, while high-frequency components are utilized to recover fine-grained fault details. By effectively integrating cross-band information, the proposed model enhances multi-scale feature representation. In addition, a self-conditioned mechanism is introduced to iteratively reuse intermediate predictions during the denoising process, thereby improving sample utilization efficiency and generation stability. Furthermore, an efficient feedforward network is incorporated to refine feature representations and strengthen the extraction of discriminative fault characteristics. Experimental results on gearbox and bearing datasets demonstrate that the signals generated by the proposed method are of higher quality and outperform other models in most evaluation metrics. Based on the generated signals, the average fault diagnosis accuracies reach 96.33% and 97.06%, respectively.}
}
@article{KIM2026116045,
title = {Audio source identification using machine learning: An empirical study of voice messages generated by 12 instant messaging applications},
journal = {Applied Soft Computing},
volume = {203},
pages = {116045},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116045},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014936},
author = {Junho Kim and Minji Kim and Jihun Joun and Jungheum Park},
keywords = {Digital forensics, Multimedia forensics, Source identification, Voice message, ISOBMFF, AAC},
abstract = {Smartphones and instant messaging applications (IMAs) have made voice messages a fast and intuitive alternative to text-based communication. In criminal cases such as threats, cyber-stalking, and property disputes, these messages can serve as key digital evidence. In forensic examinations, source identification can support the assessment of questioned voice messages by indicating which OS and application environment is consistent with their creation. Earlier studies on audio source identification have focused on built-in recorders, VoIP calls, or dedicated audio devices, but have given little attention to voice messages created in real IMA environments. This paper presents a method to identify the OS-specific IMA source class of a voice message. In this study, a source class is an OS-specific IMA label, such as Android Slack or iOS Slack, rather than the application name alone. The method builds a single feature vector by combining statistical features from three layers: the structure of the ISOBMFF container, stream properties of the AAC codec, and compressed-data statistics. A dataset of 2304 voice messages was generated using 12 popular IMAs under diverse recording conditions on Android and iOS devices. Because each selected IMA was evaluated on Android and iOS, the task consists of 24 source classes. Under leave-one-device-out validation, LR achieved the highest accuracy of 97.917%, while the released soft voting configuration achieved 97.830%. Feature importance and ablation analyses show that encoding-level features are the main contributors to performance. The main contribution is a feature framework for IMA voice messages that joins container structure and AAC syntax traces, supported by a released dataset and tool.}
}
@article{ZHANG2026116009,
title = {A semi-supervised framework for class-imbalanced network intrusion detection},
journal = {Applied Soft Computing},
volume = {203},
pages = {116009},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116009},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014572},
author = {Suzhen Zhang and Binbin Yu and Zhicheng Wei and Bo Sun},
keywords = {Intrusion detection system (IDS), Semi-supervised learning, Class imbalance, Attention mechanism},
abstract = {Network intrusion detection faces the dual challenges of diminished detection performance due to data imbalance and the underutilisation of vast amounts of unlabelled data. To address these challenges, this paper proposes a semi-supervised class-aware spatio-temporal graph attention framework. This framework employs a graph attention mechanism to model the spatial interaction topology between hosts and, during the attention computation in the temporal encoder, incorporates temporal masking constraints along with a class-aware modulation mechanism driven by predicted probability distributions. This enhances the temporal saliency of minority class behaviors and mitigates the attention bias caused by data imbalance. Furthermore, during training, an Exponential Moving Average (EMA) teacher network generates stable soft pseudo-labels, which, combined with a teacher–student consistency learning strategy, guide the learning of imbalance-aware representations, effectively uncovering latent structural patterns within unlabelled traffic. Experimental results on four imbalanced intrusion detection datasets, including UNSW-NB15, CTU-13, BoT-IoT, and CICIDS2018, demonstrate that CA-STGAT delivers consistently strong and balanced detection performance in terms of Macro Recall, Macro F1, false negative rate, and false positive rate.}
}
@article{JIA2026116054,
title = {NeuronSig: A general adversarial attack detector based on neuron signature of deep neural network},
journal = {Applied Soft Computing},
volume = {203},
pages = {116054},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116054},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015024},
author = {Chengyu Jia and Jinyin Chen and Xiaohao Li and Haibin Zheng and Luxin Zhang},
keywords = {Deep neural network, Adversarial attack, Adversarial detection, Neuron signature, Software security},
abstract = {With the widespread application of deep neural networks (DNNs) and the increasing deployment of large language models (LLMs) and vision-language models (VLMs) in security-sensitive domains, adversarial robustness has become a critical concern. Adversarial examples are inputs specifically crafted by adding imperceptible perturbations to a legitimate example, which can easily mislead a model into producing incorrect predictions. Existing detection methods often rely on extracting features from all layers, leading to high computational costs and limited scalability. To address this, we propose NeuronSig, a lightweight adversarial example detection framework based on single-layer neuron activation patterns. We introduce the concept of a neuron signature, which combines the activation magnitudes and their binary activation properties to capture the distinguishing patterns of adversarial inputs. This enables efficient and generalizable detection without modifying the target model. NeuronSig is evaluated across five datasets and nine adversarial attack types, consistently achieving an AUC of around 0.95 and maintaining robustness against adaptive attacks. We further discuss the potential applicability of NeuronSig to Transformer-based architectures, including LLMs and VLMs, through preliminary exploratory observations. While the current study focuses on CNN-based models, these observations suggest that neuron activation signatures may provide a useful direction for future adversarial detection research in modern foundation models.}
}
@article{GONG2026116017,
title = {One-class deep feature extraction of nonlinear independent components for gearbox anomaly detection},
journal = {Applied Soft Computing},
volume = {203},
pages = {116017},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116017},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014651},
author = {Xiaoyun Gong and Mengxuan Hao and Chuan Li and Wenliao Du and Ziqiang Pu},
keywords = {Anomaly detection, Deep feature extraction, Gearbox, Nonlinear independent components, Condition monitoring},
abstract = {For newly commissioned gearboxes or those that have not yet experienced degradation after extended operation, only health condition data are available. Anomaly detection based solely on health condition data presents a challenging one-class recognition problem. The critical aspect of this approach lies in the extraction of features that maximally distinguish between normal and abnormal conditions. To tackle this issue, a one-class deep feature extraction (OCDFE) method is put forward for gearbox condition monitoring using only health condition data. Specifically, nonlinear independent components are first estimated from normal vibration data. The estimated components are then encoded using deep convolutional autoencoder. Through the proposed method, the distribution boundaries of normal vibration signals can be effectively expressed in the feature space. Abnormal conditions can be promptly recognized upon the detection of anomalies, while normal conditions can be identified through the presence of normal signals. The proposed OCDFE is evaluated on two benchmark gearboxes and a gearbox fault diagnosis setup, achieving the best mean anomaly detection accuracy of 99.89%, 99.92% and 99.82%, respectively. Results show that the present method can effectively extract the anomaly features for different anomaly detectors. It can potentially differentiate the normal and abnormal features for gearbox anomaly detection.}
}
@article{CHEN2026116025,
title = {High-order adaptive context association and domain-aware convolution for oriented ship detection in synthetic aperture radar images},
journal = {Applied Soft Computing},
volume = {203},
pages = {116025},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116025},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014730},
author = {Hui Chen and Jian Guan and Haoyang Zhang},
keywords = {Synthetic aperture radar (SAR), Oriented ship detection, HybridPConv, High-order adaptive context association},
abstract = {Synthetic aperture radar (SAR) ship detection is important for maritime surveillance, but it remains challenging because ship targets are often affected by multiplicative speckle noise, large scale variation, arbitrary orientation, and complex coastal clutter. To address these challenges, this paper proposes YOLO-SARX, an efficient single-stage oriented detector designed for SAR ship imagery. Instead of simply applying a general-purpose detector to SAR images, the proposed framework enhances feature extraction, multi-scale representation, and clutter-aware feature fusion according to SAR imaging characteristics and ship geometry. Experiments on SSDD and HRSID with public oriented bounding-box annotations show that YOLO-SARX achieves 98.9% mAP50 on SSDD and 92.5% mAP50 on HRSID under the adopted experimental setting. The results indicate that the proposed SAR-oriented design improves detection reliability, especially in cluttered near-shore scenes.}
}
@article{HAN2026116049,
title = {Graph convolutional network-based multi-threaded mixing Mamba transformer for traffic forecasting},
journal = {Applied Soft Computing},
volume = {203},
pages = {116049},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116049},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014973},
author = {Xingyu Han and Miao Jing and Yalan Hao},
keywords = {Selective state spaces model, Cross-attention mechanism, Graph convolutional network, Traffic forecasting},
abstract = {Traffic forecasting plays an essential role in commute time prediction, road traffic management, and route planning. Graph neural networks (GNNs) have become the predominant approach in this domain due to their capacity to capture spatial dependencies. However, existing GNN-based methods still face two key limitations: insufficient spatiotemporal dependency learning and limited reasoning capability under complex traffic conditions. To address these issues, this paper proposes the parallel multi-threaded Mixing Mamba Transformer, termed MixMambaFormer. The proposed model introduces several novel designs to enhance both feature extraction and inference ability. First, a spatiotemporal embedding module transforms raw traffic data into high-dimensional representations, revealing latent spatiotemporal structures. Second, a dynamic adaptive graph convolution network is developed to extract dynamic spatial features, capturing both shared patterns across the network and node-specific characteristics simultaneously. Third, we develop a mixing spatiotemporal transformer module that employs parallel multi-threaded learning to extract spatiotemporal features at multiple scales. Within this module, spatial cross-attention mechanisms are integrated with selective state space models (Mamba), enabling efficient feedback learning and endowing the model with robust inferential capabilities in complex traffic scenarios. Owing to its adaptive inference performance in complex scenarios and its powerful spatiotemporal feature extraction, MixMambaFormer achieves superior overall performance. Extensive experiments conducted on eight real-world datasets verify the effectiveness of the proposed approach.}
}
@article{ATIK2026116005,
title = {Integrating natural language processing and social network analysis for risk-based auditing in public banks: A case study from Türkiye},
journal = {Applied Soft Computing},
volume = {203},
pages = {116005},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116005},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014535},
author = {Murat Atik and Fatih Saglam},
keywords = {Natural Language Processing (NLP), Social Network Analysis (SNA), NLP-SNA decision support systems, Risk-based auditing, Risk prioritization},
abstract = {Effective risk assessment is a critical component of internal auditing in public banks, where conventional methods often struggle to prioritize audit areas from large volumes of unstructured data. This study introduces a multi-stage Natural Language Processing (NLP) and Social Network Analysis (SNA) integrated Decision Support System (DSS) framework to enhance the targeting of audit planning. By reconceptualizing unstructured stakeholder narratives as active control inputs, the proposed framework formalizes the construct of dynamic control documents to capture structural risk patterns that traditional sampling might overlook. Applied to unstructured complaint data from three major public banks in Türkiye, findings reveal that while primary complaint themes vary across institutions—ranging from credit-related issues to card grievances—network-based analysis identifies common systemic interconnections, particularly regarding refund processes. By revealing potential risk indicators and their interconnections, this DSS framework serves as a robust risk-prioritization tool that assists auditors in identifying high-risk scoping areas. The study contributes to the information systems and auditing literature by establishing a theory-grounded mechanism for text-based risk topology mapping in public sector governance. For practitioners, the framework functions as a decision-support mechanism that may assist in audit prioritization and risk scoping through data-informed oversight. Overall, the findings demonstrate that transitioning from descriptive observations to structural risk mapping enables internal audit functions to be more proactive and strategic in an evolving risk landscape.}
}
@article{VAGHEI2026116021,
title = {Hyper-cylinder based oversampling to address unknown regions in imbalanced datasets},
journal = {Applied Soft Computing},
volume = {203},
pages = {116021},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116021},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014699},
author = {Alireza Vaghei and Alireza Basiri},
keywords = {Imbalanced data classification, Internal unknown region, External unknown region, Data mining, Oversampling in unknown regions},
abstract = {Imbalanced datasets are characterized by having far fewer samples in the positive (minority) class than in the negative (majority) class. This imbalance often results in positive test samples appearing in regions of the feature space that were not observed during training. Consequently, positive test samples may occur in regions of the feature space that were inadequately represented or completely absent during the training process, a situation that typically arises due to the limited number of positive samples. To address these challenges, an enhanced version of the recently developed oversampling method “Self-adaptive Oversampling Method Based on the Complexity of Minority Data in Imbalanced Dataset Classification” (SADCO) is proposed.The core idea of the proposed method is based on constructing “hyper-cylinders” between clusters extracted by the SADCO algorithm. These hyper-cylinders cover unknown regions and generate synthetic positive samples within them, thereby enhancing classifier recall for the minority class when detecting novel and unseen positive instances. To control synthetic sample generation, the radius of each hyper-cylinder is determined by its distance from the nearest negative sample, ensuring no negative samples lie inside the hyper-cylinder. The proposed approach was evaluated on 34 datasets, mostly from KEEL, several from UCI and one from Kaggle. Empirical results indicate that using hyper-cylinders to identify unknown regions and generate synthetic samples improves the detection of positive instances, particularly in terms of recall.}
}
@article{AFOLAYAN2026116094,
title = {A deep learning framework for monotonic and physics-compliant CO2 trapping index forecasting},
journal = {Applied Soft Computing},
volume = {203},
pages = {116094},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116094},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015425},
author = {Blessing Ayotomiwa Afolayan and Paschal Ogechukwu Amaechi and Ewunetu Tazebew and Mimonitu Opuwari},
keywords = {Geological carbon storage, Physics-incorporated DeepONet, Deep learning, Physics-based loss function, Regularisation techniques},
abstract = {The permanence and security of geological CO2 storage, a critical climate change mitigation strategy, hinges on a thorough understanding of subsurface trapping mechanisms. Predicting trapping efficiency traditionally relies on computationally-intensive numerical simulations, especially for complex, heterogeneous reservoirs. While data-driven deep learning models offer accelerated computation, they often act as "black boxes" with poor interpretability and no inherent adherence to physical laws. To address this, we present a physics-incorporated Deep Operator Network (DeepONet) for predicting two key density-driven trapping indexes: the Residual Trapping Index (RTI) and Solubility Trapping Index (STI). Our architecture enforces physical realism by encoding the laws of mass conservation and temporal monotonicity directly into a composite loss function and through architecturally guaranteed constraints, supported by advanced regularisation techniques. The model was trained and tested on a comprehensive dataset of over 11,000 samples compiled from global studies. Results demonstrated high predictive precision, with mean absolute errors of 0.0042 (RTI) and 0.0022 (STI), and R2 scores of 0.994 and 0.982, respectively. Crucially, the model maintained a 0% violation rate of the fundamental physical constraint (RTI+STI≤1) and preserved the expected monotonic behaviour of trapping over time. The close clustering of predicted and actual values, along with residuals centred around zero, confirms the model’s robustness, reliability, and strong generalisation capability for predicting CO2 trapping across diverse geological conditions.}
}
@article{ZHANG2026116090,
title = {A randomized decision-making approach for cross-domain product conceptual design integrating large language model and unbalanced trapezoidal cloud model},
journal = {Applied Soft Computing},
volume = {203},
pages = {116090},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116090},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015383},
author = {Haoyu Zhang and Liting Jing and Zijie You and Yubo Dou and  {Di Feng} and Shaofei Jiang},
keywords = {Conceptual design decision-making, Large language model, Evaluation text, Unbalanced trapezoidal cloud model, Vlsekriterijumska Optimizacija I Kompromisno Resenje model},
abstract = {Conceptual design decision-making, a critical phase in new product development, requires comparing conceptual schemes (CSs) against evaluation criteria to select the optimal one. Advances in artificial intelligence have enabled the generation of cross-domain CSs (CD-CSs) by integrating multi-source knowledge. These CD-CSs are typically accompanied by unstructured evaluation texts that support comparison and ranking. While prior research has emphasized linguistic terms and their fuzzy modeling, domain-specific differences and the inherent randomness in evaluation texts remain largely unaddressed, complicating quantification and compromising decision reliability. To fill this gap, a randomized decision-making approach for CD-CSs integrating a large language model (LLM) and the unbalanced trapezoidal cloud (UTC) model is proposed. First, prompt templates drive the LLM to extract satisfaction and uncertain beliefs from unstructured evaluation texts through comparative analysis. Secondly, a transformation based on the 3En rule converts these fluctuating evaluations into UTC models. A UTC generator is developed to produce random numbers as evaluation values, and the Vlsekriterijumska Optimizacija I Kompromisno Resenje (VIKOR) model, combined with Monte Carlo simulation, determines the optimal CS. Finally, proposed approach is validated through a case study on conceptual design decision-making for bionic peristaltic pipeline inspection robot (BP-PIR). Sensitivity analysis and comparison of results demonstrate that incorporating the LLM for evaluation semantics interpretation and capturing randomness in semantic expressions enhance the efficiency and robustness of CD-CS decision-making.}
}
@article{WANG2026116001,
title = {From limited historical conditions to unseen working conditions: A diffusion-guided distribution and semantic collaborative alignment network},
journal = {Applied Soft Computing},
volume = {203},
pages = {116001},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116001},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014493},
author = {Longde Wang and Hui Cao and Zeren Ai and Henglong Shen and Tianjian Wang and Yingjian Wang and Lixiang Meng},
keywords = {Marine machinery, Fault diagnosis, Class imbalance, Multi-source domain adaptation},
abstract = {To address fault sample scarcity, multi-working-condition distribution drift, and uneven class coverage among source domains in practical marine machinery fault diagnosis, this paper proposes a Diffusion-guided Distribution and Semantic Collaborative Alignment Network (D2SCAN) for multi-source imbalanced cross-working-condition fault diagnosis. First, D2SCAN adopts a CDDPM-based conditional diffusion augmentation module, where fault categories and working-condition information are used as joint generative conditions to produce minority fault samples and alleviate diagnostic bias caused by class imbalance at the data level. Then, a distribution–semantic collaborative alignment strategy is constructed to enhance cross-working-condition transfer. Within this strategy, the mixed-source risk is used to maintain source-domain discriminative capability, the Pearson–χ2 divergence reduces the global distribution discrepancy between the mixed source domain and the unlabeled target domain in the joint space, and the class-prototype semantic regularization preserves the semantic consistency of shared fault categories. Meanwhile, an adaptive source-domain weight updating mechanism dynamically adjusts the contribution of each source domain according to its transfer value during training. Experimental results on two marine machinery datasets show that D2SCAN achieves the best overall average performance and shows stronger robustness in challenging incomplete-label and imbalanced multi-source scenarios, confirming its effectiveness in multi-source imbalanced cross-working-condition diagnosis scenarios.}
}
@article{SELCUKLU2026115931,
title = {Endogenous regime switching in day-ahead electricity price forecasting: An economic physics-guided residual regime network approach},
journal = {Applied Soft Computing},
volume = {203},
pages = {115931},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115931},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013797},
author = {Saltuk Buğra Selçuklu},
keywords = {Electricity Price Forecasting, Deep Learning, Physics-Informed Neural Networks, Regime Switching, Renewable Integration},
abstract = {Day-ahead electricity price forecasting is increasingly challenged by the structural volatility introduced by renewable energy sources. Existing literature largely relies on a bifurcation strategy, treating price spikes as statistical outliers to be filtered or handled by separate ensemble modules. We argue this approach creates a bifurcation fallacy, severing the causal link between the physics of the economy and price formation. To address this, we propose the Physics-Guided Residual Regime Network (PGRRN). Unlike static architectures, PGRRN utilizes a soft regime-switching mechanism that decomposes the prediction pathway into a linear base-load component and a non-linear congestion component. A physics-guided gating unit, conditioned on exogenous load and temporal forecasts, dynamically weights these components, allowing the model to endogenously adapt to market regimes. Experimental results on five major market datasets (Belgium, Germany, France, Nord Pool, and PJM) demonstrate that PGRRN significantly outperforms robust XGBoost, DNN, and LEAR models. For instance, in the Nord Pool market, PGRRN achieves a Mean Absolute Error (MAE) of 0.92 compared to 1.68 for the best of the DNN ensembles. While the method incurs a higher computational cost than LEAR ensembles, it is significantly lower than that of DNN ensembles. The significant improvement in capturing structural volatility confirms the efficacy of embedding economic physics into deep learning architectures.}
}
@article{SAHA2026116004,
title = {A T-spherical fuzzy Dombi-Frank double normalization-based multiple aggregation approach for selection of manufacturing outsourcing vendors},
journal = {Applied Soft Computing},
volume = {203},
pages = {116004},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116004},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014523},
author = {Abhijit Saha and Prasenjit Chatterjee and Jurgita Antucheviciene and Edmundas Kazimieras Zavadskas},
keywords = {Manufacturing outsourcing vendor selection, Supply chain, -Spherical fuzzy sets, Consensus-reaching, Dombi-Frank operators, Double normalization-based multiple aggregation},
abstract = {Increasing environmental concerns and regulatory requirements have intensified the importance of sustainability in organizational operations and supply chains. Addressing uncertainties and maintaining a competitive edge requires organizations to integrate lean, agile, resilient, green, and sustainable practices throughout their supply chain and manufacturing activities. In this context, selection of the appropriate manufacturing outsourcing vendors plays a crucial role, as it directly affects organizational efficiency, environmental performances, and adaptability to disruptions. Conventional fuzzy multi-criteria decision-making (MCDM) models deal only with belongingness and non-belongingness, neglecting uncertainty that often arises from incomplete information, conflicting priorities in expert judgment. This limitation is particularly relevant in manufacturing outsourcing vendor selection, where decision-makers encounter ambiguity due to complex trade-offs among lean, agile, green, resilient, and sustainability related criteria. Ignoring uncertainties may lead to biased or inconsistent vendor evaluations, declining supply chain performance. To address these challenges, this study adopts T-spherical fuzzy (T-SF) sets, which simultaneously capture belongingness, non-belongingness, and abstinence, allowing experts to express their judgments in a more flexible and realistic manner. The proposed framework addresses a significant research gap in existing MCDM approaches, which rarely consider agility, lean, green, resilience, and sustainability concurrently in manufacturing outsourcing vendor selection. The framework integrates T-SF set with Dombi-Frank weighted averaging and geometric operators, computes criteria weights via a cross-entropy-based linear programming model, and derives ranking order of vendors using double normalization-based multiple aggregation (DNMA) method. A case study of an Indian commercial vehicle producer demonstrates practical applicability. The results indicate that ‘environmental management system’, and ‘capability for unexpected disruption’ are the top two criteria with weights of 0.175, and 0.15, respectively. Among the four vendors (X1-X4) under consideration, X1 emerges as the best alternative with a utility of 0.40472. Comparative analysis with other fuzzy MCDM models validates the robustness and effectiveness of the proposed model in handling ambiguity and providing reliable decisions.}
}
@article{LIU2026116028,
title = {Cross-modal offset-guided dynamic alignment and fusion for weakly aligned UAV object detection},
journal = {Applied Soft Computing},
volume = {203},
pages = {116028},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116028},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014766},
author = {Zongzhen Liu and Hui Luo and Zhixing Wang and Xiaoming Peng and Haorui Zuo and Jianlin Zhang},
keywords = {Multimodal object detection, Cross-modal alignment, Visible-infrared feature fusion, Environmental monitoring},
abstract = {Unmanned aerial vehicle (UAV) object detection plays an important role in applications such as environmental monitoring and urban security. To enhance system robustness under complex conditions, infrared-visible object detection integrates information from multiple sensors to achieve more comprehensive perception. However, due to platform jitter caused by high-speed UAV motion and asynchronous imaging between infrared and visible sensors, spatial misalignment often occurs between modalities. This introduces two major challenges that significantly degrade detection performance: semantic inconsistency at corresponding spatial locations and modality conflict during feature fusion. Existing methods often address these issues in isolation, limiting their effectiveness. In this paper, we propose Cross-modal Offset-guided Dynamic Alignment and Fusion (CoDAF), a unified framework that jointly tackles both challenges in weakly aligned UAV-based object detection. CoDAF comprises two novel modules: the Offset-guided Semantic Alignment (OSA), which utilizes infrared-guided attention to estimate spatial offsets and uses deformable convolution guided by a shared semantic space to align features more precisely, and the Dynamic Attention-guided Fusion Module (DAFM), which adaptively balances modality contributions through gating and refines fused features via spatial–channel dual attention. By integrating alignment and fusion in a unified design, CoDAF enables robust UAV object detection. Experiments on standard benchmarks validate the effectiveness of our approach, with CoDAF achieving an mAP of 78.6% on the DroneVehicle dataset.}
}
@article{RUDNICKA2026116012,
title = {Accuracy-efficiency trade-offs in spiking neural networks: A Lempel-Ziv complexity perspective on learning rules},
journal = {Applied Soft Computing},
volume = {203},
pages = {116012},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116012},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014602},
author = {Zofia Rudnicka and Janusz Szczepanski and Agnieszka Pregowska},
keywords = {Spiking neural networks, Learning rules, Spike trains, Temporal classification, Lempel–ziv complexity, Computational efficiency},
abstract = {Training spiking neural networks (SNNs) remains challenging due to temporal dynamics, non-differentiability of spike events, and sparse event-driven activations. This paper studies how the choice of learning paradigm (unsupervised, supervised, and hybrid) affects classification performance and computational cost in temporal pattern recognition. Building on our earlier study Rudnicka et al. (2026) [1], we use Lempel-Ziv complexity (LZC) as a compact, analysis-oriented descriptor of spike-train temporal organization to quantify how different learning rules reshape class-conditional temporal structure. The pipeline combines a leaky integrate-and-fire (LIF) SNN with an LZC-based temporal representation analysis stage. We evaluate learning rules on synthetic sources with controlled temporal statistics (Bernoulli, two-state Markov, and Poisson spike processes) and on two-class subsets of MNIST and N-MNIST. Across datasets, gradient-based learning generally yielded the highest observed accuracy values, although several pairwise differences were not statistically significant, while simultaneously incurring substantially higher computational cost. These results highlight that selecting a learning rule should be guided by application constraints and the desired balance between separability and computational overhead.}
}
@article{BAI2026116073,
title = {A multi-scale spatio-temporal learning framework for wind power forecasting},
journal = {Applied Soft Computing},
volume = {203},
pages = {116073},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116073},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015218},
author = {Kang Bai and Weibo Zhong and Yang Gu and Guoyu Mao},
keywords = {Wind power forecasting, Spatiotemporal modeling, Sliding-window mutual information, Multi-head residual GCN, Sub-band energy weighted fusion},
abstract = {Accurate wind power forecasting is critical for grid stability and renewable energy integration, yet remains challenging due to the inherent intermittency and multi-scale volatility of wind resources. This study proposes DWT-SWMI-iLSTM—a spatiotemporal hybrid framework that integrates discrete wavelet transform (DWT), sliding-window mutual information (SWMI) for dynamic graph construction, and an improved long short-term memory (iLSTM) network. The model employs DWT for multi-scale decomposition, captures evolving spatial dependencies via SWMI-based graphs, and fuses sub-bands through an energy-aware weighting strategy. Extensive experiments on three offshore wind farms for 15-minute ahead ultra-short-term forecasting demonstrate consistent superiority over competitive baselines, achieving a best coefficient of determination (R2) of 0.9752. On the most challenging site, the proposed method improves R2 from 0.900 to 0.949 and reduces MAPE from 16.83% to 13.13%. The framework also exhibits strong generalization to an independent inland wind farm (MAPE = 11.94%) and maintains robust performance under adversarial perturbations and multi-step horizons up to 6 hours. Statistical significance testing (p<0.01) confirms the non-random nature of these improvements. Together with its data-driven hyperparameter optimization and manageable computational cost, the proposed model offers a practically viable solution for real-world wind power forecasting.}
}
@article{ZHANG2026116036,
title = {Seafood target detection network with hierarchical perception capability},
journal = {Applied Soft Computing},
volume = {203},
pages = {116036},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116036},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014845},
author = {Kangye Zhang and Zhanying Li and Yu Gao and Dezhi Li and Zhongyi Zhu},
keywords = {Underwater biota target detection, Neural network, Deep learning, Fishery aquaculture},
abstract = {To address issues in underwater seafood target detection, such as image blurring, low contrast, significant variations in target scale, and interference from complex backgrounds, this paper proposes a seafood target detection network with hierarchical perception capability, termed HPW-YOLO. Based on YOLOv10s, the proposed method first strengthens shallow edge details and multi-scale feature representation through a hierarchical feature perception enhancement framework, thereby improving the model’s perception of blurred boundaries and small targets. Second, a parallel perception enhancement module is constructed by combining multi-head self-attention with convolutional gated linear units, enabling collaborative modeling of global contextual semantics and local texture details. Finally, a wavelet-domain fusion module is introduced into the neck, where Haar wavelet decomposition and reconstruction are employed to alleviate semantic misalignment, structural damage, and detail loss in cross-scale feature fusion. Experimental results show that HPW-YOLO achieves an mAP50 of 86.2% on the URPC dataset, outperforming YOLOv12s by 2.2%, with a 1.4% improvement in recall. Meanwhile, it also demonstrates good generalization ability and robustness on the RUOD dataset, verifying the effectiveness and superiority of the proposed method for seafood target detection in complex underwater environments.}
}
@article{JI2026115988,
title = {Physics-informed interval-valued intuitionistic fuzzy threat assessment with space-based infrared information},
journal = {Applied Soft Computing},
volume = {203},
pages = {115988},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115988},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014365},
author = {Chenbei Ji and Panlong Wu and Shan He and Xin Long and Yu Xiao and Mengchu Tian},
keywords = {Threat assessment, Interval-valued intuitionistic fuzzy set, Multi-criteria decision-making, Space-based infrared tracking, Uncertainty modeling},
abstract = {Threat assessment with space-based observation information is strongly affected by uncertainty arising from target observation, state estimation, and impact point prediction. Existing methods generally rely on deterministic indicator values or empirically prescribed interval forms, making it difficult to express the influence of target state uncertainty propagation on threat assessment results. To address this issue, a physics-informed interval-valued intuitionistic fuzzy set (PI-IVIFS) method is proposed for target threat assessment with space-based observation information. Within a dual-satellite cooperative observation framework, objective uncertainty information is obtained from the tracking process, including state covariance, impact point error, and observation interruption duration. To incorporate this uncertainty information into threat assessment in a consistent way, comprehensive uncertainty rates are defined for different indicators. Based on the quantified indicator values and the corresponding comprehensive uncertainty rates, interval-valued intuitionistic fuzzy numbers (IVIFNs) are constructed to characterize both indicator threat levels and evaluation credibility. The quantified indicator values determine the interval centers, and the corresponding comprehensive uncertainty rates determine the widths of the membership and non-membership intervals. The interval boundaries are therefore determined by physically derived uncertainty. Furthermore, combined weighting and the interval technique for order preference by similarity to ideal solution (TOPSIS) are employed to obtain the final threat ranking. Simulation results show that the proposed method achieves better ranking consistency during tracking updates and provides clearer interpretation of weakly separated target pairs. Improved robustness under covariance-informed disturbances and online assessment feasibility are also demonstrated at the considered space-based observation scale.}
}
@article{ADEYI2026116044,
title = {Cross-domain uncertainty-aware attention for trustworthy cardiomegaly detection in chest radiographs},
journal = {Applied Soft Computing},
volume = {203},
pages = {116044},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116044},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014924},
author = {Odeh Victor Adeyi and Zhang Xiaoling and Clement Agaba},
keywords = {Uncertainty-Aware Attention, Cardiomegaly, Medical AI, Rib suppression},
abstract = {Cardiomegaly detection from chest radiographs remains challenging due to anatomical confounders such as ribs, which can dominate deep network activations and degrade reliability. Existing approaches treat accuracy, interpretability, and uncertainty as separate objectives, without linking feature selection to model confidence. We propose a Cross-Domain Uncertainty-Aware Attention (CUAA) framework that integrates epistemic uncertainty directly into representation learning. Specifically, latent variance (σ²) from a variational bottleneck is propagated through the attention pathway and used as an in-training feature-selection signal, jointly governing spatial saliency and semantic latent-space attention. Unlike prior methods that estimate uncertainty post hoc, CUAA suppresses unreliable features before they influence classification decisions. A lightweight differentiable rib suppression module (0.32 M parameters) is embedded within the encoder and optimized jointly with the classification objective, enabling anatomy-aware feature pruning without preprocessing overhead. Two new interpretability metrics grounded in radiological reasoning, the Bias Suppression Score (BSS) and Uncertainty-Stratified Performance are introduced to evaluate anatomical focus and prediction reliability. A dual-branch generative–discriminative design further promotes structured, uncertainty-calibrated latent representations. On the MIMIC-CXR dataset (4218 patients), CUAA achieves F1 = 0.87, specificity = 0.91, and AUC = 0.93, and generalizes to an external CheXpert cohort (1485 patients) with F1 = 0.84, outperforming CNN and attention-based baselines by up to 15% in F1. High-certainty predictions (σ² < 0.1) achieve AUC = 0.97 versus 0.85 for low-certainty cases, reducing false positives by 32%. Latent clustering metrics (Silhouette +40.6%, Calinski–Harabasz +91.0%) confirm improved representation quality. These results suggest that uncertainty can act as an actionable signal for feature selection, enabling reliable and interpretable cardiomegaly detection under domain shift.}
}
@article{JIN2026116047,
title = {Hierarchical fractional-order particle swarm optimization with application in the path planning of UAV traversing electric field},
journal = {Applied Soft Computing},
volume = {203},
pages = {116047},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116047},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601495X},
author = {Ting Jin and Rui Xu and Haochen Ding and Yu Xue and Guowei Dai},
keywords = {Particle swarm optimization, Fractional order, Collaboration update mechanism, Global best solution, Unmanned aerial vehicle},
abstract = {Since its proposal in 1995, the PSO algorithm has achieved remarkable progress in performance improvement. However, traditional PSO only relies on the current state when updating particle positions, with insufficient memory and utilization of previous search results. Hence, we propose a Hierarchical Fractional-Order PSO (HFOPSO) algorithm based on fractional-order operators. Firstly, a novel particle collaborative work mechanism is designed, classifying the particle swarm into leader particles, explorer particles, and follower particles according to their fitness. Leader particles adopt an internal communication mechanism for local refined search; explorer particles use the fractional-order update mechanism, leveraging the memory characteristic of fractional calculus to enhance particle inertia and improve the ability to explore the solution space; follower particles correct their direction by tracking the positions of leader particles to deeply utilize excellent regions. Secondly, an optimization framework is constructed, including a local fine search phase and a particle reset phase. The framework guides the algorithm to jump out of local optima and improves the utilization of computing resources. To solve the high-risk problem of UAVs traversing complex electric field environments, this paper simulates real electric field scenarios, abandons the design idea of traditional building collision scenarios, introduces an electromagnetic interference penalty function, and applies the HFOPSO algorithm to UAV path planning for traversing electric fields. It successfully generates safer and more efficient obstacle-avoidance paths, significantly improving the convergence stability of path planning and the reliability of solutions.}
}
@article{ZHANG2026116024,
title = {CM-SATNet: A cross-modal semantic-augmented temporal network for solar irradiance prediction},
journal = {Applied Soft Computing},
volume = {203},
pages = {116024},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116024},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014729},
author = {Han Zhang and Jiarong Shi and Wenli Qian},
keywords = {Solar irradiance forecasting, Large language models, Attention mechanism, Temporal convolutional network, Successive variational mode decomposition},
abstract = {Solar irradiance sequences exhibit significant randomness and nonlinear characteristics, posing challenges for conventional forecasting methods in effectively capturing their intrinsic dynamics. To address this issue, this study proposes a novel forecasting framework: Cross-Modal Semantic-Augmented Temporal Network (CM-SATNet). First, feature extraction is performed by decomposing the original solar irradiance sequences using Successive Variational Mode Decomposition (SVMD). Then, a collaborative mechanism is established by integrating two Large Language Models (LLMs). Specifically, a generative LLM converts numerical meteorological variables into semantically rich textual summaries, while a frozen-weight LLM within the semantic enhancement module extracts contextual semantic embeddings from these summaries. The extracted embeddings are further projected into key-value pairs for integration into the attention mechanism. Next, the proposed framework employs temporal queries and a multi-head attention mechanism to achieve cross-modal alignment between semantic and numerical features. Finally, the cross-modal representations are fed into a temporal convolutional network (TCN), which utilizes causal convolution and residual connections to generate the forecasting results. Extensive comparative experiments against mainstream forecasting models demonstrate that the proposed framework significantly reduces prediction errors on two datasets while achieving the best goodness-of-fit. These findings indicate that the semantic enhancement strategy effectively compensates for the limitations of traditional models in capturing nonlinear meteorological dynamics, thereby enhancing the robustness of solar irradiance forecasting under complex conditions.}
}
@article{KONE2026116069,
title = {Attentive data mixing in fine-grained visual categorization with class activation maps},
journal = {Applied Soft Computing},
volume = {203},
pages = {116069},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116069},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015176},
author = {Mohamed Meyer Kana Kone and Meng Pang and Nanrun Zhou},
keywords = {Deep learning, Data augmentation, Fine-grained visual categorization, Attentive data mixing},
abstract = {Deep learning (DL) models can learn intricate patterns and representations from training data and withstand unforeseen datasets. However, large models may quickly overfit with a limited training dataset. Since the size of fine-grained data is always limited, overfitting is a crucial issue that needs to be addressed. Recently, data mixing augmentation techniques have been proposed to overcome this problem. However, in seeking to solve the overfitting issue, they may introduce label noise into the augmented data when a meaningless or meaningful region of an image is cut and pasted to obscure the entire meaningful region of another image. Consequently, this paper proposes a simple and efficient data mixing augmentation technique that exploits class activation maps to mix fine-grained data. In each training iteration, the algorithm utilizes the class activation maps of two randomly selected images to obtain their object, meaningful, and meaningless regions to perform data mixing augmentation. Next, the labels are mixed according to the composition of the mixed image since the augmented image may contain the meaningful regions of the two images or the meaningless region of one image and the meaningful region of another image. The results from the experiment demonstrate that the proposed approach outperforms existing data augmentation techniques on the top three fine-grained datasets: CUB-200-2011, FGVC Aircraft, and Stanford Cars.}
}
@article{DECARVALHO2026115992,
title = {Integrating heuristics and large language models for multi-objective carbon-aware cloud workflow scheduling},
journal = {Applied Soft Computing},
volume = {203},
pages = {115992},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115992},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014407},
author = {Vinicius Renan {de Carvalho} and Jaime Simão Sichman},
keywords = {Cloud scheduling, Large language models, Carbon reduction, Multi-objective optimization},
abstract = {Workflow scheduling in cloud environments involves challenging trade-offs between execution time, monetary cost, and environmental impact. Traditional heuristics (such as HEFT and PEFT), as well as metaheuristic approaches, have been applied to find solutions for this problem. However, little work has applied Large Language Models (LLMs) to this context. In this work, we propose LLMCS (Large Language Model Cloud Scheduler), a two-stage framework that integrates LLMs, specialist heuristics, and a Mixed-Integer Linear Programming (MILP) into the pipeline. In the first stage, a group of heterogeneous virtual machines is defined either through MILP or by an LLM. In the second stage, workflows are scheduled on the selected machines using either expert heuristics or an LLM-based scheduler. Experiments were performed on five real-world scientific workflows, considering information on computing power and cost from AWS and carbon footprint data from Teads. Results showed that combining LLMs with heuristics leads to improvement in general. Moreover, our findings highlight the potential of LLMs as flexible optimizers and decision-makers in cloud workflow scheduling.}
}
@article{WANG2026116085,
title = {Efficient and generalized scheduling for flow shops via contention-aware graph meta-reinforcement learning},
journal = {Applied Soft Computing},
volume = {203},
pages = {116085},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116085},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015334},
author = {Siyuan Wang and Qihao Liu and Liang Gao and Xinyu Li},
keywords = {Deep reinforcement learning, Meta learning, Hybrid flow shop scheduling, Graph neural network, Curriculum learning},
abstract = {The hybrid flow shop scheduling problem (HFSP) is widely encountered in discrete manufacturing systems, where operation sequencing and parallel-machine assignment must be jointly optimized across multiple production stages. When instance scales and resource configurations change, scheduling policies are expected to maintain both high solution quality and strong adaptability. However, existing deep reinforcement learning (DRL) based scheduling methods still insufficiently characterize the complex operation–machine relationships and dynamic scheduling histories, making it difficult for the learned policies to maintain stable decision performance across different instance scenarios. To address this challenge, this paper proposes an end-to-end meta-reinforcement-learning scheduling framework to learn a high-performance scheduling policy that can be reused across different instance scenarios. First, HFSP is formulated as a unified Markov decision process based on a heterogeneous operation–machine disjunctive graph. Second, a contention-aware graph neural network is proposed to explicitly characterize competition and dependency relationships among nodes through meta-paths and attention aggregation, thereby obtaining fine-grained real-time state embeddings. Third, an RL2-style recurrent scheduling context encoder is introduced to compress the interaction history between the policy and the environment into an online-updated context vector, enabling adaptive decision-making without retraining for the target scale. Finally, the policy is trained with a curriculum learning strategy. Extensive numerical experiments demonstrate that the proposed method achieves superior performance compared with five dispatching rules and three popular DRL methods, while exhibiting stable adaptability across different instance scenarios. Moreover, the proposed method reaches the optimal solution on 17 benchmark instances, which is not achieved by the other baselines.}
}
@article{LIU2026116048,
title = {Adversarial defense mechanisms for secure deep reinforcement learning-based electric vehicle charging recommendation systems},
journal = {Applied Soft Computing},
volume = {203},
pages = {116048},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116048},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014961},
author = {Xiao Liu and Yi Su and Zhuocen Dai},
keywords = {Adversarial defense, Secure deep reinforcement learning, Electric vehicle charging, Customer contentment},
abstract = {Electric vehicle charging recommendation systems (EV-CRSs) based on deep reinforcement learning (DRL) are vulnerable to adversarial perturbations, which can significantly degrade decision quality. This paper proposes the CHArging Recommendation Misleading Attack (CHARMAT), a novel attack that exploits the sensitivity of DRL policies to induce misleading charging recommendations, resulting in increased travel distance, waiting time, and cost. To counter these threats, we propose the Self-Adversarial Noise Denoising Autoencoder (SANDA), a defense framework enhancing model robustness against attacks without altering the core decision-making process. Experimental results demonstrate that CHARMAT effectively disrupts recommendation performance, while SANDA mitigates multiple attack types, including noise and FGSM, and consistently improves system reliability across different EV penetration levels. The proposed framework provides a robust and practical solution for securing DRL-based EV-CRSs against adversarial threats.}
}
@article{XIE2026116020,
title = {A granular-ball intuitionistic fuzzy classification algorithm for large-scale data},
journal = {Applied Soft Computing},
volume = {203},
pages = {116020},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116020},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014687},
author = {Jialiang Xie and Dajiang Chen and Jianxiang Qiu and Honghui Wang},
keywords = {Granular-ball computing, Granular computing, Classifier, Intuitionistic fuzzy set, J-S divergence, Fuzzy measurement, Multi-granularity representation, K-nearest neighbor},
abstract = {The multi-granularity granular-ball computing method enhances data processing efficiency by representing data through granular-ball abstraction, thereby improving the computational efficiency of models. However, existing methods struggle to balance granular-ball quality, computational efficiency, and classification performance, especially when dealing with large-scale data. To address these challenges, this paper proposes the Class-Mapping Granular-Ball Intuitionistic Fuzzy Set Classifier (CMGBIFSC) that integrates the advantages of granular-ball computing and intuitionistic fuzzy set theory to enable efficient large-scale data classification. First, a class-mapping granular-ball generation method (CMGB) is introduced. By incorporating logarithmic scaling and power-based allocation strategies, the number of granular-balls for each class is adaptively determined, effectively avoiding redundant partitions and significantly improving generation efficiency and quality. Second, an intuitionistic fuzzy set–based granular-ball representation and classification mechanism is developed. The internal uncertainty of each granular-ball is characterized by an intuitionistic fuzzy triplet of membership, non-membership, and hesitation degrees. The similarity between samples and granular-balls is then measured using an intuitionistic fuzzy distance based on the J–S divergence, improving the discriminative representation capability of granular-balls. Extensive experiments on multiple large-scale real-world datasets demonstrate that the proposed CMGBIFSC and CMGBKNN (CMGB-based K-nearest neighbor algorithms) achieve higher classification accuracy and faster granular-ball generation than existing granular-ball KNN variants and the classical KNN, confirming their superior effectiveness and scalability.}
}
@article{TONG2026116081,
title = {Discriminative feature network for small object detection},
journal = {Applied Soft Computing},
volume = {203},
pages = {116081},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116081},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015292},
author = {Kang Tong and Yiquan Wu},
keywords = {Discriminative feature network, Small object detection, Deep learning},
abstract = {To address the inherent limitations of current detection methods, namely weak feature representation for small objects, insufficient mining of critical details, and poor anti-interference performance, we propose a discriminative feature network for small object detection. The introduced discriminative feature perception, selection, and enhancement modules enable in-depth perception, effective filtering, and targeted enhancement of edge details and semantic information pertaining to small objects, thereby significantly strengthening the model's feature representation capability. Extensive experimental results demonstrate that the proposed method outperforms other comparative algorithms on three authoritative benchmarks: AI-TOD, AI-TODv2 and VisDrone2019. Furthermore, in the context of a ship water gauge reading intelligent recognition project, we establish a novel Small-Character dataset comprising 5051 images and 60878 instances, where our approach achieves robust detection performance in practical real-world scenarios.}
}
@article{ZHANG2026116089,
title = {From recommendation to allocation: A novel paradigm for doctor-patient matching in online healthcare platforms},
journal = {Applied Soft Computing},
volume = {203},
pages = {116089},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116089},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015371},
author = {Chao Zhang and Wanyue Li and Guoxin Wang and Lei Meng and Shan He and Guoqi Zhang and Baohua Du and Yuesong Zhang and Chenxi Huang and Shan An},
keywords = {Doctor recommendation, Healthcare allocation, Intelligent triage, Large language models, Knowledge graph, Globally optimization},
abstract = {Online healthcare platforms are a solution to mitigate geographical disparities in medical resource allocation, yet their efficiency depends on the effectiveness of doctor–patient matching. Existing approaches frame this task as doctor recommendation via traditional recommendation paradigms, suffering from three key limitations: (1) overlooking doctors’ subjective experience, (2) inefficient utilization of scarce expert resources, and (3) inadequate triage accuracy for patients’ colloquial chief complaints. To address these limitations, we redefine this task as a resource-constrained bipartite graph matching problem and propose a Globally-optimized Healthcare Allocation Framework (GHAF), featuring three principal innovations: First, to the best of our knowledge, it represents the first paradigm shift for doctor–patient matching, transitioning from single-aspect patient-centric recommendation to dual-aspect doctor–patient constrained bipartite graph matching. Second, we develop a knowledge-enhanced triage engine (KETE) that integrates LLMs and our knowledge graph. Finally, we propose a global bipartite graph optimization (GBGO) method that alleviates medical structural resource misallocation to some extent. Results on JD Health demonstrate GHAF’s efficacy, showing significant improvements in three key metrics: patient-initiated positive feedback rate (+0.3 pp.), consultation acceptance rate (+11.4 pp.) and prescription acceptance rate (+5.3 pp.). Additionally, KETE achieves 98.4% F1-score in department classification. This work establishes a novel paradigm in problem formulation, simultaneously optimizing platform efficiency, doctor experience and patient experience.}
}
@article{AKBER2026116000,
title = {StyleNeRF-Med: A hybrid neural framework for robust 3D image reconstruction from sparse 2D views},
journal = {Applied Soft Computing},
volume = {203},
pages = {116000},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116000},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014481},
author = {Syed Muhammad Abrar Akber and Sadia Nishat Kazmi and Ali Muqtadir},
keywords = {Deep learning, Image reconstruction, NeRF, StyleGAN},
abstract = {Reconstructing high-quality 3D images from fewer input images is a fundamental challenge in computer vision and medical imaging, which has significant implications for data-efficient artificial intelligence. Traditional methods such as computed tomography and magnetic resonance imaging typically require multiple images for accurate image reconstruction, making them costly and data-intensive. Recent advances in the field of neural radiance fields (NeRF) have shown strong performance in the development of novel views. However, such methods are highly dependent on precise camera settings and scene-specific optimization, which limits their generalizability and usefulness. To overcome these limitations, we leverage advanced AI techniques, such as Generative Adversarial Networks (GANs) for generating realistic images. We propose StyleNeRF-Med, a hybrid framework that innovatively integrates StyleGAN2 and NeRF to generate high-quality 3D reconstructions from fewer input images. StyleGAN2 encodes rich image features to synthesize detailed views, while NeRF processes 3D spatial coordinates and camera positions to compute accurate pixel colors and intensities. A synthetically generated dataset of digitally reconstructed radiographs (DRR) is used to validate the model. StyleNeRF-Med demonstrates superior performance in reconstructing high-quality 3D medical images from limited 2D input. On the chest dataset, it achieves the lowest FID score of 101.24 and KID score of 0.072, outperforming GRAF and PixelNeRF. Similarly, on the knee dataset, StyleNeRF-Med again shows better image quality with the lowest FID score of 132.64 and the KID score of 0.098. These results indicate improved alignment with real data distributions and improved reconstruction quality over existing methods.}
}
@article{LI2026115914,
title = {Orthogonal Learning and Collaborative Subspace Mutation enhanced Whale Optimization Algorithm for high-dimensional gene feature selection},
journal = {Applied Soft Computing},
volume = {203},
pages = {115914},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115914},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013621},
author = {Xinru Li and Maofa Wang and Huiling Chen and Jing Yuan and Lu Zhang and Pingping Hu and Jun Jiang and Jiajun He and Shuai Tan and Xiao Lou},
keywords = {Global optimization, Whale Optimization Algorithm, Orthogonal Learning, Feature selection, Swarm intelligence, High-dimensional genomic data},
abstract = {The rapid growth of high-dimensional genomic data, driven by advances in genomics and precision medicine, has exposed traditional analytical methods to the curse of dimensionality. Feature selection, a critical means of reducing dimensionality and improving classification, is inherently a multi-objective combinatorial optimization problem. This study proposes an improved Whale Optimization Algorithm, OCMWOA, which integrates an Orthogonal Learning (OL) mechanism and a Collaborative Subspace Mutation (CSM) mechanism. The OL mechanism strengthens local exploitation through guiding vectors constructed via orthogonal experimental design. The CSM mechanism employs cosine-similarity-based attention weights for subspace selection and a Thompson sampling selector to adaptively switch between rotational and linear mutation strategies, combined with crossover and a reward–penalty mechanism, thereby enhancing global search performance. The algorithm is comprehensively evaluated on the CEC 2017 benchmark and 12 high-dimensional medical datasets from UCI and SBCB, with statistical significance assessed using the Wilcoxon signed-rank test, Holm–Bonferroni correction, and Friedman test. A binary variant, bOCMWOA, is further developed with a K-Nearest Neighbors classifier for discrete feature selection tasks. Experimental results demonstrate that the proposed algorithm achieves higher classification accuracy while substantially reducing the number of selected features, outperforming multiple mainstream optimization algorithms and exhibiting strong feature compression capability and promising practical potential. The source code is publicly available at https://github.com/cloudlii-star/OCMWOA.}
}
@article{ZHANG2026115975,
title = {Industrial large model-driven online early fault warning: A novel incremental anomaly detection framework with wavelet scattering contrastive transformer},
journal = {Applied Soft Computing},
volume = {203},
pages = {115975},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115975},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014237},
author = {Ziyi Zhang and Yanna Zhang and Wentao Mao and Hui Ma and Jiayi Wang and Shubin Du},
keywords = {Industrial large model, Early fault detection, Anomaly detection, Transformer, Time-frequency analysis},
abstract = {Despite substantial potential of industrial large models (ILMs), there are still some challenges in deploying ILMs in specific industry scenarios: (1) Current ILMs generally adopt a learning mode with large-scale parameters, which tends to cause over-fitting on limited data in real-world engineering and fails to generalize to various working conditions; (2) Current ILMs usually employ static deployment based on fine-tuning techniques, which makes it difficult to establish a dynamic downstream task with sequentially-collected monitoring data. To address these challenges, this paper selects the early fault detection (EFD) of rotating machinery as an example, and designs an ILM-driven incremental anomaly detection framework that includes a pre-training model and a downstream task. In the pre-training stage, a new wavelet scattering contrastive Transformer (WaveCT) is proposed by introducing wavelet scattering transform to expand a physically-meaningful time-frequency feature set from limited data. By exploring the contextual dependency among normal state data, WaveCT effectively extracts the representation of common one-class detection rules under complex working conditions such as being interfered with by irregular noise. In the downstream task, an online EFD network is designed based on fine-tuning the sequential data, while an incremental fault alarm indicator is built based on the support vector data description (SVDD) generalization error upper bound. Then the statistical distribution shift caused by weak state changes is perceived to achieve early fault warning. Experiments on the vibration signals from our bearing cage testbed and the actual finishing mill bearing of a steel enterprise in China validate the effectiveness of the proposed framework.}
}
@article{MA2026116030,
title = {Interpretable rock joint shear strength prediction via gene expression programming with data augmentation},
journal = {Applied Soft Computing},
volume = {203},
pages = {116030},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116030},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601478X},
author = {Chengjin Ma and Hadi Fathipour-Azar},
keywords = {Interpretable prediction, Rock joint shear strength, Gene expression programming, Empirical-driven machine learning, Data augmentation},
abstract = {Accurate prediction of rock joint shear strength is critical for underground and geological engineering, yet data scarcity often limits the performance of data-driven models. This study presents an interpretable and high-accuracy framework that integrates gene expression programming (GEP), empirical-driven machine learning, and advanced data augmentation techniques. Initially, a GEP model is trained on experimental data with eight input features. Results show that the developed GEP model demonstrates superior predictive performance (e.g., R2> 0.96) compared with six widely used empirical formulas. To mitigate data scarcity, five generative models, including generative adversarial network (GAN), variational autoencoder, statistical sampling, smart bootstrap sampling (SBS), and Markov chain bootstrap, are employed to augment the dataset. Comparative analysis of statistical distributions, kernel density estimations, and physical consistency reveals that SBS and GAN generate more physically coherent and statistically representative synthetic datasets. Results show that the GEP models trained on these augmented datasets exhibit enhanced predictive performance, with the SBS formula achieving the highest testing accuracy (i.e., R2 = 0.9836, RMSE = 0.2154, and MAE = 0.1821) and interpretability. The results demonstrate that the proposed framework can generate interpretable, accurate, and generalizable predictive models for rock joint shear strength, and offers practical guidance for engineering applications where data are limited.}
}
@article{ZHANG2026116051,
title = {Multi-sensor information fusion model based on adaptive belief divergence and weighted credibility factor},
journal = {Applied Soft Computing},
volume = {203},
pages = {116051},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116051},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014997},
author = {Chenyingshuai Zhang and Liucheng Huang and Junshuang Liu and Xiaojian Ma},
keywords = {Multi-sensor information fusion, Adaptive belief divergence, Weighted credibility factor, Dempster-shafer evidence theory, Conflicting evidence processing},
abstract = {In multi-sensor information fusion (MSIF), adaptively managing uncertain information in distinct conflict states via Dempster-Shafer evidence theory still remains a significant challenge. To address this issue, a rule-based adaptive MSIF model is innovatively constructed, which makes two breakthroughs. On one hand, a rule-based Adaptive Belief Jensen-Shannon (ABJS) divergence is proposed to quantify the discrepancy among evidences. It introduces the adaptation parameters and an enhancement function, forming a family of various belief divergence. A valid rule is provided for generating the adaptation parameters and the enhancement function. It enables the ABJS divergence to flexibly accommodate the evidences in different conflict states, demonstrating the adaptability of the ABJS divergence. On the other hand, considering that the credibility of a single evidence may have an impact on the decision-making, a weighted credibility factor (WCF) is given. It enhances the MSIF model’s ability to focus on favorable evidences. The ABJS divergence and the WCF also enable the model to manage conflicting evidences more efficiently. Subsequently, the proposed MSIF model is applied to real-data decision-making tasks. The results illustrate that the model not only supports the correct decision with the highest belief values in Iris classification, but also can effectively handle evidences under distinct conflict states across five larger-scale datasets, exhibiting superior accuracy and stability in information fusion.}
}
@article{BADEM2026116072,
title = {Adaptive CNN ensemble weighting via ABC optimization for maternal health risk prediction},
journal = {Applied Soft Computing},
volume = {203},
pages = {116072},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116072},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015206},
author = {Aysun Badem and Zeynel Abidin Çil and Abdullah Caliskan},
keywords = {Deep learning, Ensemble learning, Transfer learning, Maternal risk prediction, Artificial Bee Colony algorithm},
abstract = {Deep learning models are highly sensitive to data scarcity, a limitation that becomes more pronounced when convolutional neural networks (CNNs) are applied to small tabular datasets through image-based representations. In such settings, limiting the number of fine-tuning epochs is commonly required to prevent overfitting; however, it also introduces substantial run-to-run variability, leading to unstable CNN predictions. In addition, exhaustive hyperparameter tuning is often impractical under limited data and computational constraints. Rather than aiming to maximize peak performance, this study focuses on stabilizing CNN behavior under small-data and limited-epoch training conditions. Using the Maternal Health Risk Assessment Dataset with 1187 samples and eleven clinical features, we construct an ensemble of six lightweight CNN architectures, including pretrained backbones fine-tuned via transfer learning and a compact custom model trained from scratch as a baseline. In maternal health research, risk prediction models may support studies on more consistent assessment of high-risk pregnancies, but clinical use requires further validation. An Artificial Bee Colony (ABC) algorithm is employed to learn adaptive ensemble weights, suppressing high-variance or weak models while emphasizing more consistent predictors. Experiments over 30 independent runs show that the ABC-weighted ensemble consistently improves Accuracy and Macro F1 compared to individual CNNs under the current benchmark protocol, while reducing performance variability.}
}
@article{ZHU2026115930,
title = {Decoding vocabulary like humans in abstractive summarization},
journal = {Applied Soft Computing},
volume = {203},
pages = {115930},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115930},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626013785},
author = {Yingqi Zhu and Dingxin Hu and Shuo Zhang and Natalia Vanetik and Marina Litvak and Lei Li},
keywords = {Abstractive summarization, Generation process, External hallucination, Factual error, Interpretability},
abstract = {Abstractive summarization tasks often suffer from external hallucinations and factual errors. Most current studies detect these issues using external knowledge and infer their causes from model structures. However, they fail to clearly explain the generation processes causing these issues and to preemptively identify them fundamentally. Therefore, we fully leverage information from the decoding process to identify patterns and factors that may lead to external hallucinations and factual errors, advancing the moment of their detection to enable early intervention and correction. Inspired by Willem Levelt’s theory of human language production in cognitive neuroscience, we innovatively propose that the generation process of the decoder follows a Conceptual Preparation and Lexical Selection stage (CP&LS). We discover that external hallucinations are formed during the Conceptual Preparation stage, while factual errors depend on the Lexical Selection stage. We then construct an external hallucination detector and introduce a new factual metric that can evaluate external hallucinations and factual errors based solely on the decoder’s information. Unlike this metric, other factual metrics require the original document or reference summary. Finally, we validate these methods on two high-performing Transformer-based encoder–decoder models, BART (Bidirectional and Auto-Regressive Transformers) and PEGASUS (Pre-training with Extracted Gap-sentences for Abstractive Summarization). The results show that our hallucination detector achieves 1.43% and 13.69% higher hallucination classification accuracy on the XENT and DeFacto datasets, respectively, compared to baseline models. Our factual metrics rank 3rd and 1st among nine evaluated metrics on the two datasets.}
}
@article{LI2026116003,
title = {Conditional generation-augmented multi-source domain generalization for rolling bearing RUL prediction via manifold learning-based health indicator construction and adaptive ensemble learning},
journal = {Applied Soft Computing},
volume = {203},
pages = {116003},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116003},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014511},
author = {Jimeng Li and Haobo Zhang and Hongliang Sun and Jinfeng Zhang},
keywords = {Rolling bearings, Remaining useful life prediction, Domain generalization, Health indicator, Diffusion model, Ensemble learning},
abstract = {Predictive maintenance of equipment relies on the accurate prediction of remaining useful life (RUL); however, fluctuating operating conditions in industrial scenarios often cause significant distribution shifts between training and testing data. Domain generalization (DG) can mitigate such domain shifts without requiring access to target domain test data. However, negative transfer caused by multi-source domain knowledge conflicts and inappropriate knowledge fusion has long been a key factor restricting the generalization and prediction accuracy of the model. To address these challenges, this paper proposes a novel DG framework for RUL prediction based on conditional generation-based augmentation. First, a robust health indicator is constructed via manifold learning, and a piecewise function based on degradation rate is designed to encode RUL labels. Second, a conditioned diffusion model incorporating hybrid source domain constraints is developed to generate task-relevant synthetic degradation-feature samples using source domain information, thereby enriching the training distribution and improving robustness to unseen operating-condition shifts. Third, a TimeSerFormer network integrating temporal convolutional networks and Transformer architectures within a main-auxiliary task design is proposed to capture multi-scale degradation features. Additionally, dual-distribution alignment and adaptive ensemble learning are employed to mitigate negative transfer across source domains. Experimental results on the IEEE PHM 2012 and XJTU-SY bearing datasets demonstrate that the proposed method achieves mean RMSE and mean MAE of 0.1248 and 0.0964, respectively, which outperforms several state-of-the-art DG methods and provides a promising solution for reliable cross-condition RUL prediction of rolling bearings.}
}
@article{WANG2026116035,
title = {Missing population mobility graph imputation for spatio-temporal GNN infectious disease prediction},
journal = {Applied Soft Computing},
volume = {203},
pages = {116035},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116035},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014833},
author = {Yulong Wang and Liting Gao},
keywords = {Infectious disease prediction, Population mobility graph, Spatio-temporal GNN, Missing graph imputation, Deep learning},
abstract = {Accurate infectious disease forecasting is of great practical importance for public health intervention and policy making. Recently, spatio-temporal graph neural networks (STGNNs) have achieved promising performance in infectious disease prediction by jointly modeling temporal dynamics and spatial dependencies. However, existing studies have largely ignored a practical problem in real-world applications: When population mobility graph data is missing for certain dates within a time period, how can we impute missing population mobility graphs and how does such imputation affect forecasting performance? This paper systematically investigates missing population mobility graph imputation for STGNN-based infectious disease prediction. A hybrid STGNN framework with a replaceable graph generation module is designed, and 12 graph imputation methods, including mathematical, machine learning, and deep learning approaches, are comprehensively evaluated on a real-world COVID-19 dataset. The goal is to examine which imputation strategies can best preserve the predictive performance of the forecasting model under incomplete mobility graph conditions. The experiments reveal two counter-intuitive phenomena: (1) imputing missing graphs with simple mathematical methods surprisingly yielded higher prediction accuracy than using the original complete graph data; (2) in the graph imputation task, simple mathematical or traditional machine learning methods outperformed complex deep learning models in terms of prediction accuracy. This suggests that future STGNN designs should prioritize simple and lightweight graph imputation strategies. Our study provides new evidence and practical guidance for STGNN-based infectious disease prediction with incomplete mobility data.}
}
@article{ZHANG2026115967,
title = {A lightweight multiscale network and segmentation collaborative method for detecting illegal parking on tactile paving},
journal = {Applied Soft Computing},
volume = {203},
pages = {115967},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115967},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014158},
author = {Haiyan Zhang and Ao Zhang and Chao Tian and Yilin Liu and Jibin Wang and Zhiwen Zhuang and Guxue Gao and Yuanyuan Wang},
keywords = {Blind pathway illegal parking, Multiscale feature fusion, YOLOv11n, Attention mechanism},
abstract = {To address the challenges encountered during urban tactile paving scenarios, where the detection of illegally parked vehicles is hindered by variable vehicle sizes and occlusion, resulting in missed or false detections, this study proposes combining the BS-YOLO detection algorithm with the GRFB-Unet segmentation model to address illegal parking on a blind road and proposes various illegal parking determination methods. The algorithm not only improves detection accuracy and model robustness but also reduces the number of model parameters. First, to mitigate insufficient multiscale feature extraction of vehicles, which causes missed detections of illegally parked vehicles in occluded groups (e.g., groups of bicycles or motorcycles), an adaptive multiscale convolutional feature aggregation module (AMFA) is proposed. This module addresses the inadequacy of multiscale feature representation and improves the feature fusion capability of the network at a relatively low computational cost. Second, to precisely identify vehicle targets in complex backgrounds, an adaptive enhanced local attention module (AELA) is used to improve the neck network, enabling effective fusion of features across different levels. Last, a dynamic hierarchical adaptive fusion with shift (DHAF-AS) module is proposed to improve the C3k2 module, improving the feature extraction capability of the network while maintaining low computational overhead. The experimental results indicate that compared with the original model, the improved YOLOv11n algorithm reduces the number of model parameters by approximately 7.50%, improves the mAP50 by 3.56%, and improves the precision by 6.00%. The proposed algorithm performs robustly in complex background environments, effectively facilitating the compliant use of tactile paving resources and increasing the efficiency of urban accessibility facilities. https://github.com/feiyeha/BS-YOLO.}
}
@article{SI2026115995,
title = {One unified image restoration network for deblurring, deraining, desnowing, and low-light enhancement},
journal = {Applied Soft Computing},
volume = {203},
pages = {115995},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115995},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014432},
author = {Jongwook Si and Sungyoung Kim},
keywords = {Image Restoration, Deblurring, Deraining, Desnowing, Low-Light Enhancement"},
abstract = {This paper proposes an integrated two-stage image restoration model with a unified architecture designed to handle diverse degradation types such as deblurring, deraining, desnowing, and low-light enhancement. The network is based on an encoder–decoder structure and consists of two main stages. In the first stage, patch-wise multi-scale feature extraction is performed to capture hierarchical information across multiple resolutions, enabling the network to learn both local and global degradation patterns. In the second stage, full-resolution contextual feature aggregation and restoration are carried out, which integrate contextual information at the original resolution to reconstruct fine details with high fidelity. To further enhance representation ability, the model incorporates Residual Dense Blocks, Squeeze-and-Excitation, and Multi-Head Self-Attention modules, allowing effective fusion of global and local features. A hybrid loss function combining pixel-wise L2 loss with FFT-, Hessian-, and Laplacian-based constraints is designed to guide the network toward accurate recovery of structural and frequency details. Experimental evaluations on benchmark datasets demonstrate the superiority of the proposed 2-stage model, achieving PSNR/SSIM of 32.98/0.963 on GoPro, 32.34/0.953 on HIDE, 37.00/0.979 on Rain100L, 32.41/0.944 on Snow100K, and 29.26/0.927 on LOL. These results highlight significant improvements in sharpness, brightness, and texture restoration compared to state-of-the-art methods, suggesting strong potential for practical deployment in real-world applications.}
}
@article{ZHU2026116043,
title = {FedHDFF: Personalized federated learning based on hyper-dimensional feature fusion},
journal = {Applied Soft Computing},
volume = {203},
pages = {116043},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116043},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014912},
author = {Suxia Zhu and Wenjie Yao and Libao Zhang and Guanglu Sun and Yue Liu and Xuedong He and Xinzhong Zhu and Ruidong Wang},
keywords = {Federated learning, Deep learning, Hyper-dimensional computing, Data heterogeneity},
abstract = {Personalized Federated Learning (PFL) aims to balance model generalization with heterogeneous client data distributions. Traditional methods often achieve personalization by fine-tuning the last layer of the feature extractor or introducing regularization constraints. However, these approaches usually address data imbalance through sample-size relationships while overlooking discrepancies in feature distributions. This work uncovers a strong correlation between hyper-dimensional feature representations and heterogeneous sample distributions. Based on this insight, we propose FedHDFF, a Hyper-Dimensional Feature Fusion framework that enhances personalization by aligning global feature distributions in a unified hyper-dimensional space, while improving global generalization through low-dimensional constraints. Specifically, we design a dual-constraint orthogonal projection module that enforces uniform semantic distributions in a low-dimensional space. By constraining feature orthogonality, our method reduces representation drift caused by data heterogeneity and increases feature consistency across clients, leading to stronger global performance. In addition, we introduce a hybrid hyper-dimensional classifier that performs hierarchical feature fusion to strengthen local distribution modeling. This design improves local personalization while minimizing interference with the global model. Extensive experiments on three benchmark datasets demonstrate the effectiveness of FedHDFF, achieving up to 5.54% improvement in global generalization and 2.05% gain in local personalization over state-of-the-art baselines.}
}
@article{ZHOU2026116023,
title = {Road-adaptive reinforcement learning for safe active suspension control},
journal = {Applied Soft Computing},
volume = {203},
pages = {116023},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116023},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014717},
author = {Sizai zhou and Wei Han and Lu Xiong},
keywords = {Active suspension, Deep reinforcement learning, Twin delayed deep deterministic policy gradient, Road-type adaptation, Forced intervention, Safe reinforcement learning, Ride comfort, ISO 8608},
abstract = {In the cross-development process of intelligent transportation systems and vehicle dynamics control, active suspension systems, as a core technology to improve vehicle ride comfort, handling stability, and safety, have always been a research hotspot in academia and engineering. Traditional control algorithms, when faced with complex and variable road conditions, often struggle to dynamically perceive road characteristics and adaptively adjust, resulting in a single control strategy that is difficult to meet both comfort and robustness requirements. Deep reinforcement learning (DRL), with its powerful self-learning and decision-making capabilities, has brought breakthrough directions for active suspension control. However, existing DRL-based methods still have problems such as control quantity fluctuations caused by Q-value overestimation, a lack of road-type adaptation mechanisms, and insufficient safety constraints. To address these challenges, this paper investigates intelligent active suspension control and proposes two algorithms based on Twin Delayed Deep Deterministic Policy Gradient (TD3). First, the Road-Type Adaptive TD3 (RTA-TD3) algorithm expands the state space and integrates known road-type information into policy learning, enabling the agent to perceive road characteristics and adjust its control strategy. Second, the Forced-Intervention TD3 (FI-TD3) algorithm introduces a safety constraint mechanism. When suspension dynamic deflection exceeds its predefined safe range, state rollback and policy correction are triggered to prevent unsafe transitions. The use of TD3 also mitigates the control-force fluctuations associated with Q-value overestimation in Deep Deterministic Policy Gradient (DDPG). The methods reduce the Root Mean Square (RMS) body acceleration by 67%, 34%, 60%, and 35% relative to passive suspension, LQR, Skyhook, and TD3, respectively; maintain suspension dynamic deflection within the predefined allowable range in the reported tests; and reduce the peak-to-peak control force by 44%–69% relative to DDPG.}
}
@article{BOONMEE2026115724,
title = {Adaptive and sustainable post-disaster waste management under uncertainty: A multi-objective fuzzy two-stage stochastic optimization framework},
journal = {Applied Soft Computing},
volume = {203},
pages = {115724},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115724},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626011725},
author = {Chawis Boonmee and Mikiharu Arimura},
keywords = {Disaster debris management, Hybrid fuzzy–stochastic optimization, Two-stage decision framework, Resilient recovery planning, Multi-criteria decision modeling},
abstract = {This study proposes an adaptive and sustainable decision-support framework for post-disaster waste management (PDWM) using a multi-objective fuzzy two-stage stochastic optimization model. Unlike conventional deterministic approaches, the proposed framework simultaneously captures probabilistic uncertainty (disaster scenarios) and epistemic uncertainty (imprecise waste volumes and operational parameters) through the integration of stochastic programming and fuzzy modeling. The model adopts a two-stage structure in which strategic decisions—facility activation and technology selection—are determined in the first stage, while operational decisions—waste allocation, routing, and processing flows—are optimized in the second stage after scenario realization. Five conflicting objectives are optimized simultaneously: minimizing operational time, total cost, and environmental emissions, while maximizing resource utilization and job opportunities, thereby embedding economic, environmental, and social sustainability within the PDWM system. A weighted-sum-based fuzzy solution methodology is developed to ensure computational tractability. The framework endogenously determines the optimal separation configuration (on-site, off-site, or mixed) under varying disaster conditions and decision-maker preferences. A real-world case study in Northern Thailand, demonstrates the effectiveness of the model. Comparative analysis shows that the optimized strategy achieves a 25.78% reduction in emissions while improving cost–time trade-offs and structural flexibility. The findings highlight the model’s capability to support resilient, sustainability-oriented PDWM planning under uncertainty.}
}
@article{ZHU2026116031,
title = {RMTSFMC: A reverse multi-scale time series forecasting method with Mamba and 1D-CNN},
journal = {Applied Soft Computing},
volume = {203},
pages = {116031},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116031},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014791},
author = {Yongdong Zhu and Lei Zou and Weibo Liu and Yan Song},
keywords = {Time series forecasting, Mamba, 1D-CNN, Feature extractor},
abstract = {Time series forecasting is crucial in many real-world fields. Most state-of-the-art forecasting models now use the Transformer architecture, which has succeeded by effectively modeling long-range dependencies. However, its quadratic computational complexity hinders practical deployment, especially for long-sequence tasks, limiting its use in resource-constrained real-world scenarios. Both the state space model (Mamba) and 1D Convolutional Neural Networks (1D-CNN) achieve linear computational complexity. Mamba excels at capturing global dependencies, while 1D-CNN effectively captures local patterns, and their complementary strengths enable efficient modeling across different temporal scales. In this paper, we propose a novel model, A Reverse Multi-Scale Time Series Forecasting Method with Mamba and 1D-CNN (RMTSFMC). First, a reverse encoding mechanism is introduced to process multi-scale time series data, and then an effective feature extractor is designed. Within this extractor, the 1D-CNN layer supplements local information from large to small scales, and the multi-scale residual Mamba layer extracts global information. The two complement each other and efficiently capture time series features. The constructed future prediction module fuses and outputs multi-scale features to realize the effective integration of information at different scales. In the experiments, we evaluate our proposed method on seven common benchmark datasets. Compared with the baseline model TimeMixer, the Mean Squared Error (MSE) and Mean Absolute Error (MAE) on the Traffic, ETTh1 and ETTh2 datasets are improved by 4.21%, 4.57%, and 4.40% (for MSE) and 3.39%, 2.24%, and 2.44% (for MAE) respectively, and comparable performance is achieved on other datasets. This indicates that the model achieves good generalization performance and improved prediction accuracy. While maintaining performance, it improves efficiency and reduces memory usage with linear computational complexity.}
}
@article{GAO2026116071,
title = {A multi-objective evolutionary optimization framework with an embedded time-distance rule simulation for vibroseis survey route planning},
journal = {Applied Soft Computing},
volume = {203},
pages = {116071},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116071},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601519X},
author = {Shangyi Gao and Chunxia Zhang and Li Long and Yan Wang and Long Wu},
keywords = {Petroleum exploration, Multiple traveling salesman problem, Time-distance rule, Multi-objective optimization, Route planning},
abstract = {Petroleum exploration increasingly employs multi-vehicle vibroseis operations, where route planning plays a critical role in improving acquisition efficiency and reducing cost. The process is further complicated by the dynamic Time–Distance (TD) rule, which couples spatial and temporal coordination among vehicles. Existing approaches have not systematically incorporated the TD rule into route planning and still rely heavily on manual calibration and expert heuristics. In this study, vibroseis route planning is formulated as a variant of the Multiple Traveling Salesman Problem (MTSP), and a multi-objective optimization framework is proposed to minimize total travel distance and TD-constrained operation time. A TD-constrained vibroseis dispatch simulation model is developed to capture the operational impact of the TD rule, and a tailored evolutionary algorithm is designed to improve computational efficiency and scalability by integrating grouping genetic operators into the Nondominated Sorting Genetic Algorithm II (NSGA-II) framework. Experiments on synthetic and field survey areas of different scales demonstrate that the proposed framework consistently improves both route distance and construction time under TD constraints compared with actual routes, representative multi-objective evolutionary algorithms, and MTSP solvers. In field areas with strong TD constraints, the proposed method achieves saving rates of 4.85%–16.96% in route distance and 6.58%–24.18% in construction time, confirming its robustness under intensified spatiotemporal interactions. Additional Pareto front assessment further supports the quality of the obtained non-dominated solution sets. Together, these improvements in objective performance and Pareto front quality indicate the effectiveness and practical applicability of the proposed framework for vibroseis operations.}
}
@article{RAJAGOPAL2026116002,
title = {A hybrid Lorentzian graph neural diffusion framework for predicting traffic flow in intelligent transportation systems},
journal = {Applied Soft Computing},
volume = {203},
pages = {116002},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116002},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601450X},
author = {Manikandan Rajagopal and Ramkumar Sivasakthivel and G. Anitha and K. Loganathan and K. Srinivas Rao and Mohamed Abbas and Shaeen Kalathil},
keywords = {Intelligent transportation system, Traffic flow prediction, LGIN, MAML, NCDE, GNDN, SZ-taxi, And Los-Loop dataset},
abstract = {Accurate traffic flow prediction is a crucial component of any intelligent transportation system (ITS). It helps in managing congestion, optimizing traffic signals, planning efficient routes, and utilizing resources most effectively. It leads to less delay, safer and smoother urban travel, lower pollution, and better-organized traffic signals that can be optimized based on the prediction to ease congestion at junctions and thereby further reduce vehicle queuing and travel time. This study introduces a new method called Meta-Lorentzian Isomorphic Neural Flow–Graph Neural Diffusion Network (M-LINF-GNDN), created to better understand and predict complex changes in traffic over time and across locations. In this method, LGIN (Lorentzian Graph Isomorphic Networks) keeps the shape and structure of the road network, NCDE (Neural Controlled Differential Equations) captures continuous and uneven changes in traffic over time, MAML (Model-Agnostic Meta-Learning) adjusts quickly to new traffic situations with minimal extra training, and GNDN (Graph Neural Diffusion Network) improves predictions by modelling how traffic conditions spread through the network. The approach was tested on the SZ-Taxi and Los-Loop datasets for prediction times of up to 60 min. Results showed that M-LINF-GNDN reached an RMSE of 3.879, MAE of 2.639, MAPE of 0.733, R² of 0.849, and Variance of 0.848 for SZ-Taxi, and an RMSE of 5.256, MAE of 3.291, MAPE of 0.857, R² of 0.807, and Variance of 0.806 for Los-Loop. The method consistently performed better than other approaches, demonstrating more accurate, dependable, and steady performance in predicting complex traffic patterns.}
}
@article{ZHANG2026116076,
title = {Personalized federated learning with aggregation weight optimization for accurate and privacy-preserving wind power forecasting},
journal = {Applied Soft Computing},
volume = {203},
pages = {116076},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116076},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015243},
author = {Shuhui Zhang and Jingyu He and Lianhai Wang and Lu Wang and Shujiang Xu and Wei Shao and Qizheng Wang},
keywords = {Federated Learning, Personalized transfer learning, Multi-weight Aggregation, Wind Power Forecasting, PSO},
abstract = {Federated Learning (FL) has demonstrated considerable promise for wind power forecasting through data-driven approaches, yet it faces critical challenges including data scarcity, spatiotemporal heterogeneity, and privacy vulnerabilities inherent in centralized training. Conventional FL methods often neglect variability in client contributions, resulting in compromised forecasting accuracy. To overcome these limitations, this paper introduces a novel multi-weight aggregation federated learning framework that innovatively employs Particle Swarm Optimization (PSO) to dynamically determine aggregation weights. At the client level, a hybrid CNN-BiLSTM-ATT model is deployed as the core local architecture to effectively capture complex spatiotemporal dependencies for each individual wind turbine. The core of our approach, the federated multi-weight aggregation (FedMWA) mechanism, leverages PSO to optimize aggregation weights based on multi-factor contributions from heterogeneous clients, enabling more effective integration of distributed knowledge while preserving data privacy. This PSO-driven aggregation strategy represents a significant departure from traditional static weighting schemes, substantially enhancing the global model’s representational capability. Experimental results demonstrate significant performance gains, with average reductions of 4.45% in NMAE and 3.66% in NRMSE compared to baseline methods. The framework maintains robust performance across diverse power outputs and fluctuation scenarios while ensuring data privacy through localized learning.}
}
@article{NOURANI2026116039,
title = {System dynamics and Z-number based uncertainty assessment of water resource carrying capacity under different environment change scenarios},
journal = {Applied Soft Computing},
volume = {203},
pages = {116039},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116039},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014870},
author = {Vahid Nourani and Shahin Fathi and Amirreza Tabataba Vakili and Sameh Ahmad Kantoush and Jinhui Jeanne Huang},
keywords = {System Dynamics, Integrated Water Resource Management, Fuzzy Based Z-Number, Similarity to Ideal Solution, Qaranqu Watershed},
abstract = {A decision support system and multi-attribute decision-making framework was developed to evaluate water resource carrying capacity (WRCC) by explicitly incorporating both uncertainty and reliability. The framework comprised two integrated modules applied to the Qaranqu watershed in northwest Iran. First, a system dynamics model simulated the eco-environmental, economic, and social subsystems influencing WRCC, aligning with integrated water resources management and sustainable development goals. Twenty two key indicators were identified for the 1986–2020 period, and a hybrid grey theory-entropy approach was used to weight them under uncertainty. Seven future scenarios were constructed, including continuation of current trends, climate change, cessation of agricultural development, cropping pattern reform, population growth, rapid economic growth, and simultaneous rapid economic and population growth. The second module employed a Z-number extension of the Technique for Order of Preference by Similarity to the Ideal Solution (Z-TOPSIS) to rank scenarios, addressing the limitations of conventional methods in handling ambiguous and imprecise information. Results indicated that scenarios involving the cessation of agricultural development and population growth were most favorable for enhancing WRCC. Although terminating agricultural development reduced runoff by 167 million cubic meters over 25 years, it enabled a 3.5% increase in gross domestic product through economic diversification. The population growth scenario projected a 28.5% population increase by 2045. This integrated approach provides a robust tool for water resources planning under uncertainty.}
}
@article{ALNOOR2026116084,
title = {Evaluating the environmental performance of oil companies using an interval-valued neutrosophic fuzzy decision model},
journal = {Applied Soft Computing},
volume = {203},
pages = {116084},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116084},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015322},
author = {Alhamzah Alnoor and Yousif Raad Muhsen and Dragan Pamucar and Sammar Abbas and Mohammed Salah Alazzawi and XinYing Chew and Vladimir Simic},
keywords = {Barriers to environmental adaptation, Environmental performance, Hybrid strategy, Readiness for change, MCDM},
abstract = {Research on environmental performance has been emerging as an important field of inquiry. Businesses are increasingly becoming aware of their corporate social responsibility practices. Adherence to the United Nations’ agenda for sustainable development goals has become central to companies’ strategic policies. Climate action is one of the 13th Sustainable Development Goals and thus requires immediate consideration by practitioners and researchers. This paper examines the determinants of environmental performance levels among Iraqi oil firms. The methodology is divided into two phases. Firstly, data were gathered through a structured questionnaire completed by 483 managers across eleven oil firms and analysed using partial least squares structural equation modelling (PLS-SEM). Secondly, interval-valued neutrosophic with fuzzy-weighted zero-inconsistency (IVN-FWZIC) and IVN with fuzzy-decision-by-opinion-score-method (IVN-FDOSM). The results indicated numerous inhibitors of environmental adaptation, including the costs associated with technology, emphasis on other external priorities, inadequate industry regulation, lack of access to equipment and information, and insufficient organizational, strategic, and financial abilities, all of which greatly affect environmental performance. The results also reflect the mediating relationship of the hybrid strategy between the result and predictors, and the mediating relationship of readiness for change between the hybrid strategy and the environmental performance. Additionally, the results of IVN-FWZIC indicate that an Inadequate Industry. Regulation is the most significant criterion (0.131). The IVN-FDOSM ranked the best and worst oil companies in terms of environmental performance. The results could assist businesses and other policymakers in coming up with corrective strategies aimed at improving environmental performance.}
}
@article{ZHANG2026116007,
title = {Multi-scale adaptive smoothing and neural memory attention for opportunistic bone mineral density estimation from routine CT volumes},
journal = {Applied Soft Computing},
volume = {203},
pages = {116007},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116007},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014559},
author = {Yuyan Zhang and Yang Jiang and Xi Wang and Yi Zhang and Yi Yang and Lei Xu},
keywords = {Bone mineral density, 3D CNN, Neural ordinary differential equation, nmODE, Imbalanced data, Opportunistic screening, Computed tomography},
abstract = {Routine CT offers an opportunity for opportunistic osteoporosis screening, but estimating DXA-equivalent areal bone mineral density (BMD) from uncalibrated 3D scans remains difficult because prior approaches either rely on limited 2D views or struggle with skewed clinical BMD distributions. We propose BMDNeXt, a 3D convolutional neural network (CNN) framework that predicts DXA-equivalent areal BMD (g/cm2) from routine CT volumes by combining volumetric trabecular feature learning with Neural Memory Attention (nmA). Guided by the stable attractors of Neural Memory Ordinary Differential Equation (nmODE), nmA generates bounded spatial and channel reweighting that helps the network focus on informative trabecular patterns throughout the full volume of interest. To reduce bias from imbalanced continuous targets, BMDNeXt further introduces Multi-Scale Adaptive Label Distribution Smoothing (MS-ALDS) and Multi-Scale Adaptive Feature Distribution Smoothing (MS-AFDS), which adapt label reweighting and feature calibration to local sample density. On a single-center clinical dataset, BMDNeXt achieves an MAE of 0.0803 ± 0.0050 g/cm2, a Pearson correlation of 0.8578 ± 0.0203 with ground-truth BMD, and a recall of 91.2% for severe osteoporosis screening, supporting its value as a CT-based triage tool while motivating further multi-center validation.}
}
@article{LI2026116019,
title = {Physics-guided surrogate-assisted constraint optimization for water hammer protection in long-distance water transfer systems},
journal = {Applied Soft Computing},
volume = {203},
pages = {116019},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116019},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014675},
author = {Pengyu Li and Xiaodong Yu and Lin Shi and Wenlong Zhao and Zhijun Fan and Jianzhong Chen},
keywords = {Water hammer, Air vessel, Surrogate-assisted optimization, Physics-guided design space, Constraint treatment},
abstract = {Water hammer protection design in long-distance water transfer systems is often hindered by the high computational cost of transient hydraulic simulations and the limited samples available for surrogate modelling. To balance hydraulic safety and economic efficiency, this study presents a physics-guided, sample-efficient, surrogate-assisted optimization framework for air vessels. A physics-guided design-space construction and sampling procedure is adopted, in which an approximate analytical expression and water hammer response mechanisms are used to define a targeted parameter search space, thereby improving the efficiency of surrogate model construction within a limited simulation budget. Subsequently, representative surrogate models are compared to identify a suitable accuracy-efficiency trade-off for predicting key hydraulic response indicators. An error-aware constraint treatment based on prediction errors is introduced to mitigate the risk of misjudging safety boundaries due to surrogate-model errors. Finally, an adaptive DE-based boundary search strategy incorporating self-adaptive parameter tuning and dual-strategy cooperative search is used to improve feasible-solution search under complex constraints. An engineering case study demonstrates that the proposed framework reduces the air-vessel volume from 146.69 m3 to 126.93 m3 while satisfying the considered hydraulic constraints as verified by numerical simulations, providing a practical route for sample-efficient surrogate-assisted water hammer protection design.}
}
@article{GOMEZFLORES2026116027,
title = {Constructing GLCM-based texture feature expressions using genetic programming for breast tumor classification},
journal = {Applied Soft Computing},
volume = {203},
pages = {116027},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116027},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014754},
author = {Wilfrido Gómez-Flores},
keywords = {Genetic programming, Feature construction, Gray-level co-occurrence matrix, Texture feature expressions, Breast tumor classification},
abstract = {Gray-level co-occurrence matrix (GLCM)-based features are commonly utilized in image analysis to extract quantitative textural information. Second-order statistical measures, known as Haralick features, are frequently employed in breast imaging to differentiate between benign and malignant tumors. Due to their general-purpose nature, it is common to calculate many of these features, assuming that some will be relevant to the classification task. However, the broad applicability of these texture features can limit the effectiveness of describing texture patterns unique to breast images. In this paper, GLCM-based texture features are revisited by introducing a genetic programming (GP)-based method to automatically construct more specialized features for breast tumor classification on ultrasound images. This method generates GLCM-based texture feature expressions that lead to low-dimensional feature spaces while maintaining high generalization capability. Compared with 11 reference methods, including feature selection techniques, GP-based feature engineering methods, and convolutional neural networks, the proposed approach demonstrates significantly improved performance across most comparisons. The experimental results demonstrate that generating specific texture features improves classification performance and reduces the dimensionality of the feature space, enabling the proposed method to be potentially applied to other medical imaging classification tasks.}
}
@article{HE2026116080,
title = {A pyramid content-aware multi-scale refinement generative adversarial network for system matrix calibration in magnetic particle imaging},
journal = {Applied Soft Computing},
volume = {203},
pages = {116080},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116080},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015280},
author = {Xiaowei He and Lizhi Zhang and Jintao Li and Jiarong Du and Shuangchen Li and Lin Yin and Hongbo Guo},
keywords = {Magnetic particle imaging, Deep learning, Spatial resolution, System matrix recovery, Generative adversarial network},
abstract = {Magnetic Particle Imaging (MPI) reconstructs the spatial distribution of magnetic nanoparticles through a calibrated system matrix (SM). In practice, SM calibration is time-consuming and must be repeated whenever scanning settings, nanoparticle properties, or experimental conditions change, which limits the engineering deployment of MPI. This work presents an artificial-intelligence approach for SM recovery, formulated as learning to restore a high-quality SM from sparsely measured SM data. The proposed method is a pyramid content-aware multi-scale refinement generative adversarial network, which introduces three coupled learning mechanisms: (i) hierarchical multi-scale refinement to capture both global structure and fine details, (ii) content-aware feature modulation to adapt the recovery behavior to local SM patterns, and (iii) an adversarial learning objective combined with reconstruction constraints to suppress noise while preserving physically meaningful responses. For the engineering application, the recovered SM can be directly used in SM-based MPI reconstruction, reducing the calibration burden and improving robustness under changing acquisition conditions. Experiments on a public MPI system-matrix dataset (OpenMPI) show that the proposed approach produces sharper, less noisy, and more consistent SM estimates than representative single-scale recovery baselines.}
}
@article{UGLICKICH2026116033,
title = {A categorical modeling framework with built-in feature selection: Application to traffic injury data},
journal = {Applied Soft Computing},
volume = {203},
pages = {116033},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116033},
url = {https://www.sciencedirect.com/science/article/pii/S156849462601481X},
author = {Evženie Uglickich and Tetiana Reznychenko and Ivan Nagy and Michal Matowicki},
keywords = {Categorical model, Feature selection, Genetic algorithms, Traffic injuries, Accident reports},
abstract = {In this paper, we propose a categorical model estimation framework with built-in feature selection, applied to traffic injury data from accident reports in France’s overseas territories. We address the problem of analyzing accident reports using categorical models, with the key challenge of identifying the most influential explanatory variables, thereby reducing model dimensionality. To overcome this challenge, we propose a methodology that integrates categorical model estimation with genetic algorithms (GA). The key elements of the proposed approach are: (i) estimating a categorical model on bootstrapped subsets of explanatory variable combinations; (ii) evaluating each subset’s model performance; (iii) selecting the top-performing subsets for GA-based optimization, using Goodman and Kruskal’s lambda as the optimality criterion, adjusted crossover strategies, and criterion stabilization as the termination condition; and (iv) predicting the target variable using the estimated optimal model configuration. Results show that our approach effectively isolates critical variables explaining traffic injury severity and provides a competitive, efficient, and interpretable statistical alternative to machine learning and deep learning models. The main findings of the presented framework relate to enhancing the automated assessment of traffic accident reports through a database-tailored categorical model. This offers a cost-effective solution that reduces manual evaluation efforts and improves consistency in injury severity classification.}
}
@article{SZKATULA2026115971,
title = {On directional quantitative assessment of information uncertainty conveyed by interval-valued intuitionistic fuzzy sets},
journal = {Applied Soft Computing},
volume = {203},
pages = {115971},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115971},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014195},
author = {Grażyna Szkatuła and Maciej Krawczak},
keywords = {Directional evaluation function, Interval-valued intuitionistic fuzzy set, Ranking of sets, Information uncertainty area, Uncertainty quantification},
abstract = {This study presents a novel theoretical and conceptual evaluation framework for interval-valued intuitionistic fuzzy sets consisting of both global and directional components. This enables a more comprehensive analysis of information uncertainty by explicitly considering its structure and variability, treated here as inherent property of fuzzy data. The entire information uncertainty area includes all possible hypothetical changes in the degrees of membership and non-membership under a fixed hesitation parameter. The entire area is divided into three analytically distinct subregions related to changes in (i) the degree of non-membership, (ii) the degree of membership, and (iii) their simultaneous variation. Such decomposition allows for a multi-faceted analysis of the dynamics of information uncertainty, reflecting natural changes perceived from a human perspective. Based on this geometric interpretation, a global quantitative function for assessing information uncertainty and a family of directional assessment functions is developed. These functions assume values within a normalized range and serve as non-probabilistic indicators of both overall and directional information uncertainty. We also propose a ranking procedure based on information certainty. The developed methodology offers a conceptually transparent tool for quantifying information uncertainty, but its broad practical validity still requires confirmation and extensive computational experiments.}
}
@article{ZHANG2026115998,
title = {Hybrid meta-heuristic-based optimization model for sustainable urban delivery with occasional drivers},
journal = {Applied Soft Computing},
volume = {203},
pages = {115998},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115998},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014468},
author = {Ruisan Zhang and Qu Wei and Guido Perboli and Zhaoxia Guo and Kang Li},
keywords = {Urban logistics, Last-mile delivery, Multi-tier, Occasional driver, Adaptive large neighborhood search, Hungarian algorithm},
abstract = {This study addresses last-mile delivery optimization in urban logistics by integrating occasional drivers (ODs) with preplanned itineraries and carbon emission considerations into a multi-tier distribution framework. A mixed-integer linear programming model is proposed to jointly optimize task assignment, routing, and scheduling while explicitly accounting for carbon-emission costs and flexible demand splitting at local distribution hubs. To solve the problem efficiently, we develop a hybrid heuristic that combines OD matching and adaptive large neighborhood search, enhanced by tabu-based memory, dual-informed operators, and a Great Deluge acceptance rule. Computational experiments first validate the OD assignment and pickup–delivery component on VRPTWOD-type benchmark instances, and then evaluate the complete framework on 54 benchmark instances. Under a 3600-second time limit, Gurobi obtained feasible incumbent solutions for 28 benchmark instances, whereas the proposed method consistently provides high-quality solutions across all benchmark groups; in repeated-run experiments on a prespecified 21-instance subset, the full GDALNS/TD variant achieves the best mean relative gap of 0.39%. A practical Chengdu case study further shows total cost reductions of 14.8% and 35.3% on two real-world instances, demonstrating the method’s effectiveness and scalability for sustainable last-mile planning.}
}
@article{ZHANG2026116095,
title = {An efficiency-first high-resolution paradigm for tiny object detection in UAV imagery},
journal = {Applied Soft Computing},
volume = {203},
pages = {116095},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116095},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015437},
author = {Jiaqi Zhang and Jiong Yu and Xuejian Gong},
keywords = {Tiny object detection, UAV Imagery, State Space Models (SSMs), Wavelet Transform, Scale-Space Reallocation, Efficiency-First Paradigm},
abstract = {Tiny-object detection in UAV-based wide-area surveillance is plagued by extreme scale variations and severe background entanglement. Conventional detectors predominantly rely on P3−P5 scale-space architectures; however, this design creates a fundamental structural mismatch for tiny targets, where deep low-resolution representations not only progressively weaken structurally discriminative tiny-object details but also introduce semantic misalignment and noise amplification. To address these systemic limitations, this paper proposes an Efficiency-First High-Resolution Paradigm for UAV tiny-object detection and develops a unified framework termed STW-YOLO under this paradigm (Scale-restructured, Texture-aware, and Wavelet-enhanced). Departing from traditional designs, we strategically restructure the scale space into a P2−P4 hierarchy, explicitly excising redundant deep layers to reallocate computational resources toward high-resolution representation. To ensure robust modeling under this resource-constrained paradigm, a collaborative compensatory framework is further developed: (1) A Global Context Compensation Module (GCCM) based on Structured State Space Models (SSMs) is introduced to reconstruct the global receptive field with linear computational complexity (O(N)), providing lightweight global semantic compensation while alleviating excessive background response propagation. (2) A Frequency-Aware Alignment System is devised to guide semantic injection using high-frequency priors, bridging the semantic gap between shallow details and deep semantics. (3) A Coupled Wavelet Denoising Module (CWDM) is developed to exploit the time-frequency localization property of wavelets, suppressing disordered high-frequency interference while preserving structurally meaningful edge representations. Extensive experiments on VisDrone2019, TinyPerson, and DOTA benchmarks demonstrate that STW-YOLO achieves a superior trade-off between detection accuracy and inference efficiency, demonstrating favorable suitability for real-time UAV edge deployment.}
}
@article{WANG2026116042,
title = {IG-GAT for fault tracing: A fault propagation intensity-guided graph attention network model},
journal = {Applied Soft Computing},
volume = {203},
pages = {116042},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116042},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014900},
author = {Yongqi Wang and Congbin Yang and Honglie Ma and Peng Xu and Zhifeng Liu},
keywords = {Fault propagation, Fault tracing, Effective transfer entropy, Graph attention network, Computer numerical control machine tools},
abstract = {Fault propagation analysis is pivotal for fault tracing and candidate root cause identification in CNC machine tools. However, existing research methods often overlook the challenges of insufficient observability of subsystems and the rigid integration of propagation mechanisms with state data. To address these challenges, this paper proposes a fault propagation intensity-guided graph attention network (IG-GAT) for fault tracing. First, a hierarchical topological digraph model is constructed to quantify the static fault propagation intensity (FPI) based on physical connections. To overcome the issue of missing sensor data in unobservable subsystems, a dual-channel feature extraction framework is developed. This framework utilizes uncertainty quantification theory to transform qualitative expert priors into quantitative distributions, aligning them with the causal features of observable nodes in a unified high-dimensional space. Subsequently, the FPI is embedded into the GAT network through a learnable mechanism-fusion strategy. Unlike static hybrid models, the proposed IG-GAT incorporates an adaptive factor that dynamically adjusts the attention weights based on signal complexity. It prioritizes data-driven correlations to capture the specific causal distinctness of incipient faults. Under severe and chaotic fault conditions characterized by high data uncertainty, the model integrates the static FPI into the attention coefficients via a weighted adjacency matrix, dynamically scaled by the adaptive factor. This mathematical constraint restricts the data-driven attention weights, counteracting noise and ensuring physically plausible tracking paths. Case study results show that the proposed method outperforms existing methods in both accuracy and convergence speed. Furthermore, it provides transparent and interpretable candidate tracing paths for maintenance decisions.}
}
@article{REN2026116014,
title = {A K-means-based cluster-driven optimization algorithm for solving global and engineering problems},
journal = {Applied Soft Computing},
volume = {203},
pages = {116014},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116014},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014626},
author = {Huhong Ren and Zhanjiang Wang},
keywords = {K-means Clustering optimization, Metaheuristic algorithm, Local exploitation, Global exploration, Real-world optimization problems},
abstract = {Inspired by a clustering process similar to K-means, a new metaheuristic algorithm, termed K-means-based Cluster-Driven Optimization Algorithm (KCOA), is presented in this paper. The core novelty of KCOA lies in the integration of a dynamic clustering mechanism during the iterative process, utilizing cluster centroid information to guide the evolutionary direction. At the start of each iteration, the population is partitioned into two sub-clusters, and distinct search strategies are applied to each to enhance overall optimization performance. Specifically, individuals in the first sub-cluster move toward the current global best solution to intensify local exploitation, while those in the second sub-cluster are attracted to randomly selected individuals, thereby promoting global exploration. The two sub-clusters are then merged and used to update the overall population state. Two reputable benchmark sets from standard classic test functions (CEC2017, CEC2022) and 19 mechanical engineering problems selected from CEC2020 real-world constrained optimization problems are used to gauge KCOA’s performance. A thorough comparison between KCOA and eleven recently proposed high-performance algorithms is carried out. In addition, for the purpose of conducting further statistical analysis, mean rank analysis and non-parametric tests, such as the Wilcoxon rank-sum test and Friedman ranking, were conducted. The results demonstrate that KCOA not only achieves superior convergence in low-dimensional tasks but also exhibits remarkable stability and accuracy in high-dimensional landscapes and complex engineering problems. These findings underscore its effectiveness in handling sophisticated optimization problems, confirming that KCOA is a robust, efficient, and adaptable optimization technique.}
}
@article{WU2026116038,
title = {Automated detection of tomato ripeness in natural environment using a coupled deep learning model of Sequencer and MLP},
journal = {Applied Soft Computing},
volume = {203},
pages = {116038},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116038},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014869},
author = {Faying Wu and Mingxuan Li and Changda Zhou and Feifan Zhang},
keywords = {Tomato Ripeness Detection, Automated Harvesting, Deep Learning, Computer Vision},
abstract = {Accurate tomato ripeness detection is crucial for automated harvesting, yet remains challenging under complex field conditions such as uneven illumination, occlusion, and background clutter. This paper proposes a lightweight coupled framework, Sequencer + MLP, where the attention modules are replaced by 2D BiLSTM-based Sequencer blocks to efficiently capture spatial dependencies, and a compact MLP head performs final classification. Experiments were conducted on a greenhouse dataset collected under diverse lighting and occlusion scenarios. The proposed method achieved 96.8% precision, 94.8% recall, and 98.9% classification mAP, while maintaining an inference latency of 0.6135 s with a model size of 2.4 MB, indicating potential for practical deployment after further edge-device validation. Additional evaluations under illumination and shelter subsets further verified robustness, with mAP above 95%. These results demonstrate that the coupled Sequencer + MLP design provides an effective and efficient solution for tomato ripeness detection in natural agricultural environments. The MLP classifier achieved the best classification performance among the tested heads, indicating stable behavior across repeated trials.}
}
@article{HUANG2026116046,
title = {Adaptive spatio-temporal feature fusion and feature gated Kolmogorov-Arnold networks for intrusion detection},
journal = {Applied Soft Computing},
volume = {203},
pages = {116046},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116046},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014948},
author = {Tinghui Huang and Yu Wang and Wenshuai Zhang and Yuming Qin},
keywords = {Network intrusion detection, Spatio-temporal feature fusion, Feature gating, Kolmogorov-Arnold network, Nonlinear classification},
abstract = {In complex network environments, existing network intrusion detection methods often face two critical limitations: (1) they predominantly rely on rigid feature fusion which limits the deep interaction between spatio-temporal features and lacks the flexibility to adapt to varied attack patterns, and (2) traditional classifiers, bound by fixed activation functions, fail to accurately model the intricate and highly non-linear decision boundaries separating benign traffic from attacks. To address these problems, this paper proposes a network intrusion detection method consisting of an adaptive spatio-temporal feature fusion (ASTFF) module and a feature gated Kolmogorov-Arnold network (FG-KAN) module. The ASTFF comprises three components: fusion-level gating, feature interaction, and adaptive fusion weighting. It enables adaptive adjustment of fusion weights among features according to the characteristics of the input data, thereby realizing the transition from rigid feature fusion to adaptive feature fusion. The FG-KAN comprises two components: decision-level gating and the Kolmogorov-Arnold network (KAN). By integrating the advanced nonlinear classification capabilities of the KAN with the gated mechanism, it allows the classifier to learn and adapt its decision function based on the specific features of various attack types, enabling precise and flexible modeling of complex decision boundaries. To verify the effectiveness of the proposed method, experiments were conducted on the publicly available datasets CICIDS2017 and CSE-CICIDS2018, which are widely used for network intrusion detection research, as well as the recent CICIoV2024 dataset to evaluate cross-domain generalization on Internet of Vehicles (IoV) traffic. The experimental results show that the proposed method achieved accuracy rates of 99.86%, 99.97% and 99.65%, and F1 scores of 94.57%, 99.97% and 97.43%, respectively, demonstrating that the proposed method significantly improves network attack detection performance and cross-domain generalization capability compared to existing state-of-the-art approaches.}
}
@article{ZHANG2026116010,
title = {A GNN-based fraud detection approach against heterophily inconsistencies},
journal = {Applied Soft Computing},
volume = {203},
pages = {116010},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116010},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014584},
author = {Wenxin Zhang and Rong Fu and Xi Xuan and Renda Han and Zonghao Ying and Guangzhen Yao and Simon Fong and Lingfei Ren and Cuicui Luo},
keywords = {Fraud detection, Graph neural networks, Deep learning, Heterophily},
abstract = {Graph-based fraud detection garners extensive attention from academics and industry. However, existing methods fail to exploit the inconsistent information in heterophilic connections, overlooking important semantic information. In this paper, we propose a novel fraud detection approach against heterophily inconsistencies (HIGNN), which distinguishes malicious and unconscious connections in a heterophilic network. HIGNN utilizes the generated pseudo-label preference as guidance to exploit the latent semantic inconsistencies between malicious and unconscious connections, enhancing representative fraudulent characteristics. Rigorous experiments are conducted on four real-world datasets to verify the effectiveness of HIGNN. Compared to thirteen state-of-the-art baselines, the results show average performance improvements of 0.5% in AUC and 1.36% in F1 on four datasets, and the maximum performance improvement in F1 on the Elliptic dataset is 2.06%, demonstrating the effectiveness and superiority of the proposed HIGNN.}
}
@article{HUANG2026116083,
title = {Large language models for aspect-based sentiment analysis in e-commerce: A review},
journal = {Applied Soft Computing},
volume = {203},
pages = {116083},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116083},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015310},
author = {Huang Huang and Yu Li and Qiyuan Dong and Adeleh Asemi and Mumtaz Begum Mustafa and Asefeh Asemi},
keywords = {Large language models, Aspect-based sentiment analysis, E-commerce, Sentiment analysis, Deep learning},
abstract = {Aspect-Based Sentiment Analysis (ABSA) provides a fine-grained framework for understanding customer opinions by identifying sentiment toward specific attributes within reviews. This paper presents a comprehensive review of Large Language Models (LLMs) for ABSA in the e-commerce domain. Traditional neural ABSA approaches rely on static, context-independent embeddings, limiting their ability to capture nuanced, context-dependent sentiment expressions. In contrast, LLMs leverage transformer-based architectures to generate rich, context-sensitive representations that significantly enhance performance on ABSA tasks. Models such as BERT, GPT, and LLaMA are pretrained on large and diverse corpora, enabling strong generalization and adaptability to downstream applications. This study systematically examines encoder-only, decoder-only, and encoder–decoder LLMs in ABSA, focusing on learning paradigms including fine-tuning, few-shot learning, and retrieval-augmented generation (RAG), and reviews widely used e-commerce-related datasets and application settings across B2B, B2C, and C2C contexts. This domain-aware perspective enables the review to compare how LLM-based ABSA behaves in consumer-review-rich B2C scenarios, terminology-intensive B2B settings, and noisy, multilingual C2C environments. More importantly, this review argues that LLM-based ABSA in e-commerce should not be viewed merely as a competition among model architectures, but rather as a task-, data-, and deployment-dependent problem, where model design, dataset quality, adaptation strategy, and commercial constraints jointly determine real-world effectiveness. Our analysis shows that encoder-only models are strong in contextual representation but limited in generative flexibility; decoder-only models provide powerful generation capabilities but face challenges in efficiency, hallucination, and factual grounding; and encoder–decoder models offer a balance between structured generation and robustness to noisy inputs. Despite recent progress, key challenges remain, including domain adaptation, multilingual understanding, implicit sentiment detection, and interpretability. To address these issues, we identify several key future research directions, including e-commerce-specific data augmentation and benchmark construction for long-tail, multilingual, and implicit aspect expressions, retrieval-grounded and self-verifying ABSA for improved factual consistency, multimodal ABSA integrating text, images, videos, and metadata, interpretable and sparse-expert LLMs for scalable and transparent reasoning, scalable deployment-oriented architectures for long-context and large-scale review processing, adaptive model editing and machine unlearning for continuously evolving e-commerce environments, and agentic ABSA systems that integrate reasoning, tool use, and workflow automation for real-time decision support, ultimately moving ABSA beyond static sentiment classification toward trustworthy, adaptive, and evidence-grounded intelligent systems capable of reasoning over aspects and supporting real-world e-commerce decision-making.}
}
@article{KUMAR2026116018,
title = {An adaptive residual informed LSTM-based cybersecurity framework for resilient DC microgrid operation under false data injection attacks},
journal = {Applied Soft Computing},
volume = {203},
pages = {116018},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116018},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014663},
author = {Ashish Kumar and K. Raghavendra Naik and Simanta {Kumar Samal} and Arvind {Kumar Nirala}},
keywords = {Cybersecurity, DC microgrid, Cyber attacks, Hierarchical control, Cyber-physical electrical systems, False data injection attack detection, Data driven model, Model based approach},
abstract = {The hierarchical control structure has significantly improved the sustainable operation of DC microgrids through coordinated energy management of renewable energy sources and energy storage units. The communication networks embedded within the hierarchical control layers enhance microgrid reliability by enabling coordinated power flow control among distributed power sources. However, these communication networks are highly vulnerable to cyberattacks, which can severely degrade the reliability and stability of DC microgrids. Among such threats, false data injection attacks (FDIAs) are particularly critical, as they embed malicious control actions within the converter control layers, leading to destabilized microgrid operation. Considering the significant impact of FDIAs for DC microgrid stability, this paper proposes a long short-term memory (LSTM)-based cyberattack detection and mitigation framework. The proposed multivariable LSTM identifies FDIAs in real time using residual-based voltage anomaly thresholding, and the estimated attack component is compensated online to restore the voltage signal, thereby ensuring resilient secondary control under diverse attack and disturbance conditions. The effectiveness of the proposed framework is evaluated under multiple FDIA scenarios and dynamic load conditions, and the results demonstrate that the proposed LSTM-based detection and mitigation framework achieves a detection accuracy of 99.52%, with an ultra-low false positive rate of 0.156%, a fast detection time of 0.0146 sec, a rapid mitigation time of 0.1463 sec, a stable transient response, and a minimal estimation error with an MSE of 0.00232. Furthermore, the performance of the proposed data-driven approach is validated using the OP4510 real-time simulator, and the obtained results confirm its effectiveness.}
}
@article{TURCO2026116079,
title = {Evaluating tensor-related metrics for early fault detection in CNNs},
journal = {Applied Soft Computing},
volume = {203},
pages = {116079},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116079},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626015279},
author = {Vittorio Turco and Annachiara Ruospo and Ernesto Sanchez and Matteo {Sonza Reorda}},
keywords = {Deep learning, AI reliability, AI safety, Software fault injection, Metrics for reliability},
abstract = {Today’s electronic devices are increasingly powered by deep learning algorithms to perform various tasks, from pedestrian recognition in self-driving cars to detecting health problems in low-cost, low-power wearable devices. However, despite the claimed built-in redundancy of deep learning models, the literature shows that they are susceptible to random-hardware faults: even a single corrupted bit can lead to catastrophic failures. Therefore, it is crucial to discover novel, smart, and low-cost fault detection solutions that can be used in the field to stop the propagation of critical faults. This study explores the fault-detection capabilities of mathematical metrics typically used in domains such as image processing, audio analysis, and regression. These metrics, applied to intermediate output tensors of convolutional layers, effectively detect early failures and stop their propagation, saving computational time, costs, and power. Fault injection campaigns are performed on three Convolutional Neural Networks (CNNs) to test the fault detection capability of 15 metrics. The outcomes show their effectiveness in detecting permanent faults with a very high true positive rate. Among the different metrics, the experimental analysis highlighted three metrics that demonstrated notable performance based on their Receiver Operating Characteristic (ROC) curves and corresponding confusion matrices: Minkowski distance, Mean Squared Error (MSE), and the TSum metric. By introducing trade-offs between sensitivity (true positive rate) and specificity (false positive rate), it is possible to identify between 88.63% and 97.13% of critical faults while sacrificing only between 0.27% and 0.31% of total inferences which are unnecessarily re-executed.}
}
@article{OZ2026116026,
title = {AR-ABC: An adaptive reflection-based artificial bee colony algorithm for photovoltaic parameter extraction},
journal = {Applied Soft Computing},
volume = {203},
pages = {116026},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116026},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014742},
author = {Kadriye Öz and Kürşat Mustafa Karaoğlan and Selim Öncü},
keywords = {Artificial bee colony, Hybridization, Metaheuristic algorithm, Photovoltaic parameter extraction, Opposition-based learning},
abstract = {Accurate modeling of photovoltaic (PV) systems is essential for improving their energy conversion efficiencies. Determining the unknown parameters of equivalent circuit models is a challenging optimization problem because of its nonlinear and multimodal nature. Existing deterministic methods restrict the solution process due to their initial-point dependency, while metaheuristic approaches are constrained by their reliance on measurement data. To address these limitations by exclusively utilizing manufacturer-provided information, this study proposes an adaptive reflection-based artificial bee colony (AR-ABC) algorithm. The AR-ABC, which employs an adaptive dimensional search and is supported by opposition-based learning techniques, was validated on the CEC 2020 and CEC 2022 benchmark functions. In tests conducted on equivalent circuit models, the AR-ABC outperformed current methods in the literature, achieving very low root mean square error (RMSE) values, such as 8.2715E-04 for the RTC Single-Diode Model and 8.2322E-04 for the Double-Diode Model. Consequently, it was determined that the proposed AR-ABC provides high accuracy in PV parameter estimation, eliminates measurement data dependency, and is an applicable method for predicting the performance of solar energy systems.}
}
@article{LI2026116050,
title = {A diffusion reinforcement learning framework for air traffic conflict detection and resolution},
journal = {Applied Soft Computing},
volume = {203},
pages = {116050},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116050},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626014985},
author = {Tonghe Li and Jixin Liu and Weili Zeng and Hao Jiang},
keywords = {Air traffic management, Conflict detection and resolution, Diffusion probabilistic policy, Deep reinforcement learning, Multimodal decision-making under uncertainty},
abstract = {Rising air traffic demand requires safer and more flexible conflict detection and resolution (CD&R) in en-route airspace. Existing CD&R solutions—including rule-based optimizers and unimodal deep reinforcement learning (DRL) policies—struggle to represent multiple, equally safe maneuver modes and to scale under dense traffic and strict aircraft-envelope constraints. We propose Diffusion-Actor-Critic (Diffusion-AC), a diffusion-probabilistic DRL framework that represents the policy as a denoising process over a joint categorical action space of heading, speed, and flight-level changes (27 classes). Dual Q-critics provide conservative value guidance, while a density-progressive safety curriculum trains the agent from sparse to dense traffic without relaxing envelope limits. A state-dependent feasibility mask enforces aircraft performance and procedural constraints at all diffusion stages. In fast-time simulations, Diffusion-AC consistently outperforms strong DRL baselines across traffic densities; at peak density it achieves a 94.1% conflict-resolution success rate and reduces Near Mid-Air Collisions by about 59% compared with the next-best method. Single-step policy inference remains below 10 ms on the tested GPU platform, indicating that the proposed framework is computationally manageable within the implemented simulation pipeline. These results suggest that diffusion policies provide a promising multimodal control representation for simulation-based CD&R, while validation on operational traffic data and certified ATM systems remains future work.}
}