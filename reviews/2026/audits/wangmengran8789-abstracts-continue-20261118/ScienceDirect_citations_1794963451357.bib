@article{SAHU2026136689,
title = {Improving hydrologic prediction and interpretability through physics-informed dual-output LSTM with water and energy balance constraints},
journal = {Journal of Hydrology},
volume = {681},
pages = {136689},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136689},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017865},
author = {Gopeshwar Sahu and Ashutosh Sharma},
keywords = {MC-LSTM, PIDuaL, Water-balance, Energy-balance, Human-influenced},
abstract = {Long Short-Term Memory (LSTM) has demonstrated strong predictive skill in hydrological modelling, but often lacks physical consistency and interpretability. The Mass-conserving LSTM (MC-LSTM) overcomes this limitation by enforcing water balance, yet the existing formulations remain restricted to single-variable prediction and simplified representation of hydrological fluxes. This study proposes a Physics-Informed Dual-Output LSTM (PIDuaL) that simultaneously predicts streamflow and evapotranspiration (ET) through a modified mass-balance structure. Three constrained variants are further developed by enforcing water balance, energy balance, and combined water and energy balance within the PIDuaL framework. For fair benchmark comparison, a purely data-driven Dual-LSTM is also implemented. Across 149 human-influenced watersheds in India, LSTM and Dual-LSTM show lower streamflow skill, with a median Nash-Sutcliffe efficiency (NSE) of 0.58, whereas MC-LSTM and PIDuaL improve performance to a median NSE of 0.67. Performance gains are most pronounced in hydrologically challenging conditions, including semi-arid and highly human-influenced watersheds, where purely data-driven models struggle. PIDuaL substantially reduces bias, and its constrained variants exhibit the largest improvement in low-flow simulation, accompanied by stronger correlation with baseflow-governing attributes, indicating physically meaningful recession dynamics. Although ET performance is slightly reduced relative to the purely data-driven Dual-LSTM, all physics-informed models maintain satisfactory skill, with median NSE values of at least 0.69 and correlation coefficients of 0.89 or higher. Importantly, PIDuaL internal states exhibit strong correspondence with independent soil moisture and GRACE-based storage anomalies, demonstrating enhanced interpretability. Overall, the results demonstrate that the proposed physics-informed dual-output framework improves predictive accuracy under hydrologically challenging conditions while enhancing physical consistency and model interpretability.}
}
@article{CHEN2026136673,
title = {Hydraulically constrained event-scale dynamic catchment delineation using multi-temporal backward tracking under design rainfall scenarios: a case study of urban underpass roads in Beijing},
journal = {Journal of Hydrology},
volume = {681},
pages = {136673},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136673},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017701},
author = {Qianting Chen and Yongwei Gong and Junru Zhang and Xin Dang and Honghong Shi},
keywords = {Underpass road, Dynamic catchment delineation, Rainfall characteristics, Backward tracking, Spatial pattern analysis},
abstract = {Urban underpass roads are typical low-lying hotspots prone to pluvial flooding; however, existing studies mostly rely on static catchment delineation and do not capture the temporal evolution of event-specific effective contributing areas during rainfall events. This study investigates three representative urban underpass roads within a 657.78 ha study area in Beijing. To address this limitation, this study proposes a multi-temporal backward-tracking algorithm integrating InfoWorks ICM simulation results with topographic data to delineate event-specific effective contributing areas under varying rainfall intensity, duration, and peak coefficient conditions. The framework was evaluated under 30 design rainfall scenarios with varying return periods, durations, and peak rainfall coefficients. Complementing conventional static delineation methods, the proposed framework reconstructs event-specific effective contributing areas using time-varying hydraulic states and prescribed backward-tracking criteria, enabling quantitative characterization of their variability across rainfall scenarios. Results reveal scenario-dependent spatial variability, while catchment boundaries exhibit outward expansion and increasing spatial reorganization under higher return period events. At the system scale, under the baseline delineation configuration, the total event-scale catchment area increased by 462.94 % from the 10- to 20-year return periods, showing a pronounced expansion across this interval. Rainfall intensity showed the strongest influence among the investigated rainfall characteristics on nonlinear contributing-area expansion, whereas longer rainfall duration and delayed peak timing primarily enhanced runoff contributions from distal upstream areas. This study develops an automated framework for reconstructing event-specific effective contributing areas and quantitatively characterizing their spatial evolution under different rainfall conditions, providing a methodological basis for potential runoff-contributing-area identification and event-specific flood-risk assessment in urban underpass roads.}
}
@article{BONACINA2026136713,
title = {Marked thermal heterogeneity within a small mountain stream network and its response to climate warming},
journal = {Journal of Hydrology},
volume = {681},
pages = {136713},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136713},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601810X},
author = {Luca Bonacina and Valeria Mezzanotte and Riccardo Fornaroli},
keywords = {Water temperature, River thermal regime, Reservoirs, Hydropower production, Orobic Alps (Italy), Thermal ecology, Climate refugia},
abstract = {Water temperature is a key driver of aquatic ecosystems, yet thermal heterogeneity across river networks at fine spatiotemporal scales remains poorly understood. This study investigates the thermal regime of five mid-altitude streams (500–1400 m a.s.l.) in the Serio River catchment (Orobic Alps, Northern Italy), influenced by contrasting water sources (snowmelt/stormwater vs. groundwater) and hydrological modifications (reservoirs), and evaluates how thermal patterns may change under future climate warming scenarios. Sub-daily temperature monitoring at 16 sites over 2017–2022 enabled the characterization of multiple aspects of the stream thermal regime: magnitude, variability, range, frequency, timing, and duration of thermal events, and catchment-scale thermal heterogeneity in relation to environmental drivers. Watercourses exhibited distinct thermal responses associated with lithology, hydrology, and reservoirs: siliceous, unregulated streams were thermally reactive, closely tracking air temperature, whereas groundwater-fed and reservoir-regulated streams were thermally buffered and less sensitive to warming. Catchment-scale thermal heterogeneity was pronounced (3.6 °C in annual means and up to 8.7 °C across maxima), comparable to that of alpine systems influenced by glaciers, and is projected to change under climate warming. The fine-scale variability of thermal habitats within a small area highlighted the importance of understanding thermal dynamics for interpreting ecological patterns and guiding conservation strategies.}
}
@article{ZHANG2026136697,
title = {Diffusion-Inversion-Net (DIN): an end-to-end direct probabilistic framework for characterizing hydraulic conductivities and quantifying uncertainty},
journal = {Journal of Hydrology},
volume = {681},
pages = {136697},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136697},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017944},
author = {Xun Zhang and Weijie Yang and Jiangjiang Zhang and Simin Jiang},
keywords = {Groundwater flow and transport, Diffusion model, Inverse problem, Hydraulic conductivity, Non-Gaussian},
abstract = {We propose the Diffusion-Inversion-Net (DIN) framework for inverse modeling of groundwater flow and solute transport processes. DIN utilizes an offline-trained Denoising Diffusion Probabilistic Model (DDPM) as a prior learner, which flexibly incorporates sparse, multi-source observational data, including hydraulic head, solute concentration, and hard conductivity data, through conditional injection mechanisms. These conditioning inputs subsequently guide the generative inversion process during sampling. After offline training, DIN leverages its probabilistic generative mechanism to directly produce ensembles of posterior parameter fields through repeated stochastic reverse denoising, without requiring online iterative data assimilation or repeated forward simulations for each inversion. Two representative synthetic prior settings, Gaussian and non-Gaussian, are investigated. The results demonstrate that DIN can produce multiple constraint-satisfying realizations under identical observational conditions, accurately estimate hydraulic-conductivity fields, and provide uncertainty diagnostics for the learned conditional ensemble. Additional comparisons with CUNet, CGAN, and ESMDA show that DIN achieves ensemble-mean RMSE values of 0.2500 and 2.385 and SSIM values of 0.9420 and 0.8810 in the representative Gaussian and non-Gaussian cases, respectively, while retaining its conditional sampling capability. The framework further provides an efficient end-to-end probabilistic inversion approach under the synthetic Gaussian and non-Gaussian settings considered in this study, as the major computational cost is amortized to the offline training stage and posterior hydraulic-conductivity samples can be generated without online iterative data assimilation. These results support the feasibility of end-to-end probabilistic groundwater inversion within the fixed synthetic configurations investigated here, with computational costs amortized through offline training. Generalization to different observation geometries, boundary and source conditions, noise models, or geological priors remains untested.}
}
@article{TZIRITIS2026136700,
title = {Hydrogeological controls on seasonal groundwater level dynamics across Greece: A national-scale assessment integrating monitoring data, earth observation, and interpretable machine learning (2013–2022)},
journal = {Journal of Hydrology},
volume = {681},
pages = {136700},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136700},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601797X},
author = {Evangelos Tziritis and Miltiadis Iatrou and Christos Drougas and Spyridon Tasoglou and George Arampatzis},
keywords = {Groundwater level dynamics, Seasonal fluctuation, Aquifer type, Recharge mechanism, Irrigation return flow, SHAP, XGBoost, Water framework directive, Greece, Mediterranean},
abstract = {Groundwater monitoring networks typically provide broad spatial coverage but sparse and irregular temporal observations, which limit their direct use for operational groundwater status assessment. Mediterranean groundwater systems are subject to strong seasonal contrasts between winter recharge and summer abstraction, yet national-scale assessments resolving how aquifer type modulates this signal remain scarce. We analyzed 22,281 quality-controlled groundwater level records from 2,477 monitoring wells across the 14 River Basin Districts of Greece (2013 to 2022), drawn from the WISE database of the European Environment Agency, combining stratified non-parametric statistics with an interpretable XGBoost classification framework for screening of deeper-than-normal groundwater conditions. Seasonal dynamics differed systematically by aquifer type (Kruskal-Wallis H = 32.37, p = 9.34 × 10−8). Porous aquifers showed the smallest seasonal amplitude (σ = 5.36 m) and the strongest coupling with root-zone soil moisture (Spearman ρ = +0.228), consistent with diffuse vertical Darcian recharge. Karstic aquifers exhibited intermediate amplitude (σ = 6.42 m) with a marked elevation gradient in dry-season drawdown, from + 0.79 m at low elevation to + 2.83 m above 300 m, reflecting dual-porosity behaviour in upland carbonate massifs. Fractured-rock aquifers displayed the largest amplitude (σ = 6.83 m) and effectively no soil-moisture coupling (ρ = +0.020), consistent with preferential recharge bypassing the soil column. The divergence in soil-moisture sensitivity between porous and fractured systems is the clearest statistical contrast in the dataset and is consistent with a difference in dominant recharge pathway, although the observational design does not allow that mechanism to be established directly. Within porous aquifers, sites combining high cropland cover and high vegetation vigour showed net summer recovery (Δh = − 0.42 m, Mann-Whitney p = 2.79 × 10−3), a signal consistent with irrigation return flow that was statistically absent in karstic and fractured systems (p > 0.3). Among wells with continuous records over 2018 to 2022, 61.7% showed net decline and 100 wells (6.8%) showed persistent drawdown above 2 m per measurement interval, concentrated in Thessaly and the Messara plain; with only five annual values and irregular observation intervals, these are reported as short-period changes among repeatedly monitored wells rather than as national depletion trends. A station-standardized XGBoost classifier achieved ROC AUC = 0.695 on an independent 2021 to 2022 test set, with SHAP attribution identifying seasonal phase, antecedent soil moisture, annual precipitation, and potential evapotranspiration as the leading physically coherent predictors. The findings support consideration of aquifer-type-stratified reference conditions within the Water Framework Directive and provide a quantitative basis for prioritising monitoring investments in karstic and fractured-rock systems.}
}
@article{CHENG2026136677,
title = {Infiltration dynamics of vegetated soils controlled by drought-induced root-soil interface evolution},
journal = {Journal of Hydrology},
volume = {681},
pages = {136677},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136677},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017749},
author = {Qing Cheng and Ling-Xin Cui and Qi Zhang and Zhan-Ming Yang and Chao-Sheng Tang and Viroon Kamchoom and Bin Shi},
keywords = {Drought, Vegetated soil, Root-soil interface, Infiltration dynamics},
abstract = {Climate change has intensified the frequency and severity of drought events, which can substantially modify soil infiltration by altering root morphology and soil pore structure in vegetated soils. However, how drought-induced root-soil interface evolution regulates infiltration dynamics remains insufficiently quantified. In this study, compacted soil specimens with different planting densities of ryegrass, i.e., 0, 24, and 48 g/m2, were subjected to progressive drying to target gravimetric water contents of 24%, 20%, 16%, 12%, and 8%. Infiltration tests were combined with photogrammetric volume measurements and root morphological analyses to quantify root diameter, root volume, root length density, and root freshness. The results show that the infiltration capacity of bare soil increased continuously as water content decreased. In contrast, vegetated soils showed a two-stage response, in which infiltration capacity and steady infiltration rate first increased and then decreased during drying. This response was controlled by the evolving root–soil interface. In the early drying stage, root shrinkage exceeded soil pore shrinkage, weakening root–soil contact and enhancing preferential flow along the root–soil interface. With further drying, root shrinkage became less pronounced than soil pore shrinkage, leading to closer root–soil contact and reduced hydraulic efficiency of the interface. Root decay and pore clogging further weakened the contribution of the root–soil interface to water flow. A simplified infiltration equation incorporating root diameter was then developed to estimate infiltration rates in vegetated soils under different drying conditions. Model validation showed good agreement between predicted and measured infiltration rates. These findings reveal that drought can reorganize root–soil hydraulic interactions and induce transient changes in infiltration, providing a mechanistic basis for improving predictions of soil–water redistribution and hydrological responses in drought-prone vegetated landscapes.}
}
@article{MAHDAVI2026136685,
title = {Groundwater flow in vertically heterogeneous unconfined aquifers with spatially varying boundary heads: A Girinskii–Lambert analytical framework},
journal = {Journal of Hydrology},
volume = {681},
pages = {136685},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136685},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017828},
author = {Ali Mahdavi},
keywords = {Analytical solution, nonlinear PDE, Exponentially depth-decaying hydraulic conductivity, Strip-shaped aquifer, Non-uniform boundary heads},
abstract = {Aquifers commonly exhibit depth-decaying hydraulic conductivity distributions, reflecting the effects of sediment compaction, cementation, and associated reductions in pore structure with depth. Analytical solutions for groundwater flow in such heterogeneous aquifers are often limited by the nonlinear dependence of transmissivity on hydraulic head. This study develops a novel analytical framework for groundwater flow in an unconfined strip-shaped aquifer with exponentially depth-varying hydraulic conductivity and non-uniform hydraulic heads prescribed along parallel stream boundaries. By introducing the Girinskii discharge potential, the governing nonlinear flow equation is transformed into a linear Poisson equation, enabling application of the superposition principle and Green’s function methodology. A closed-form solution is derived for the discharge potential by combining the well-induced response with the contributions of the stream boundaries, and hydraulic head is subsequently recovered through an explicit inverse transformation involving the Lambert W function. The analytical framework provides a direct representation of flow fields, stream functions, stagnation points, and capture-zone geometries under the combined effects of vertical heterogeneity, pumping, and spatially varying boundary conditions. The proposed formulation encompasses a number of previous analytical solutions as subsets. The steady analytical solution is verified against finite-element simulations, showing close agreement in the predicted hydraulic-head distributions. The formulation is further extended to transient groundwater flow driven by pumping, areal recharge and localized recharge from a circular basin, with close agreement obtained between the predicted temporal evolution of the resulting recharge mound and numerical results. Temporal evolution of stream depletion rates is analyzed under varying degrees of aquifer heterogeneity. The joint effects of the boundary-head slope ratio and hydraulic-conductivity decay exponent are shown to control the size, position, and asymmetry of the well capture zone. A first-order variance-propagation analysis quantifies the contribution of uncertain parameters to hydraulic-head uncertainty, revealing that the dominant uncertainty source changes from reference conductivity under weak heterogeneity to the conductivity-decay parameter under stronger heterogeneity. A parameter estimation procedure is further developed to estimate the vertical decay exponents from perturbed hydraulic-head observations and assess its sensitivity to observational uncertainty. The proposed analytical framework provides a general tool for investigating steady and transient flow, capture-zone delineation, and uncertainty propagation in vertically heterogeneous unconfined aquifer systems.}
}
@article{XIE2026136782,
title = {Internal phosphorus loading control in eutrophic lakes: A meta-analysis comparing remediation strategies across technology categories},
journal = {Journal of Hydrology},
volume = {681},
pages = {136782},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136782},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018792},
author = {Ruili Xie and Manqi Chang and Qiushi Shen and Yanjin Gao and Yunpeng Zhao and Yasong Chen},
keywords = {Internal phosphorus loading, Eutrophic lake restoration, Meta-analysis, Sediment remediation, Chemical phosphorus inactivation, Submerged macrophyte restoration},
abstract = {Internal phosphorus loading from lake sediments sustains eutrophication for decades after external nutrient inputs are reduced. While numerous control technologies have been developed, their relative effectiveness has not been systematically quantified across technology categories. This study conducted a systematic review and meta-analysis of six major internal phosphorus loading control strategies, integrating 613 effect sizes from 120 peer-reviewed studies (155 eligible). Effect sizes were pooled using a random-effects model, and heterogeneity was explored through subgroup analyses and meta-regression. The overall pooled log response ratio (lnRR) was − 1.25, corresponding to a mean phosphorus reduction of approximately 71%. In-situ capping achieved the highest mean effect size (lnRR = − 1.81), yet this estimate was based on only 2 studies. Chemical inactivation, supported by the largest body of evidence (226 effect sizes), achieved a mean lnRR of − 1.35 (∼74% reduction), followed by aeration and oxygenation (−1.29; ∼72%), combined measures (−1.11; ∼67%), submerged macrophyte restoration (−0.83; ∼57%), and dredging (−0.62; ∼46%). Among combined strategies, chemical inactivation paired with macrophyte restoration was the most extensively studied and achieved peak flux reductions exceeding 99% under optimized conditions. Treatment effectiveness varied 1.4-fold across measurement metrics, with overlying water soluble reactive phosphorus showing the strongest response. Meta-regression identified pH, dissolved oxygen, water depth, and sediment Al:P stoichiometry as significant moderators. Laboratory studies overestimated field performance by approximately 13 percentage points. High heterogeneity (I2 = 89.2%) reflected the diversity of technologies and environmental settings, and funnel plot analysis indicated minor publication bias. These findings provide the first cross-category quantitative comparison of internal phosphorus loading control technologies and support a two-phase staged remediation framework integrating chemical stabilization with ecological restoration.}
}
@article{ZHENG2026136714,
title = {Socioeconomic-driven spatiotemporal dynamics of urban flood resilience at the agglomeration scale under shared socioeconomic pathways},
journal = {Journal of Hydrology},
volume = {681},
pages = {136714},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136714},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018111},
author = {Jiaxuan Zheng and Xiaoying Zhao and Guoru Huang},
keywords = {Urban flood resilience (UFR), Spatiotemporal dynamics, Socioeconomic development, Shared socioeconomic pathways, Pearl River Delta},
abstract = {Investigating the spatiotemporal evolution of urban flood resilience (UFR) serves as a theoretical foundation to enhance future UFR amid evolving flood challenges. However, current discussions on this topic remain insufficient, especially in terms of isolating the impacts of socioeconomic development on UFR. These hinder a faster and clearer translation of actionable, policy-relevant insights into practical enhancement strategies. This study aims to clarify the socioeconomic-driven spatiotemporal evolution of UFR in the Pearl River Delta. Comparisons were conducted between the current and future periods regarding the patterns and values of UFR across the study area, as well as the spatial directionality and heterogeneity of low-UFR regions. Suggestions for future resilience-based flood risk management were proposed. The findings suggest that the coverage of low-UFR areas increases in future periods. Future socioeconomic development does not substantially change the overall spatial pattern of UFR. The effects of socioeconomic development on the spatial distribution of UFR are nonlinear and stage-dependent. Highly urbanized areas play a dominant role in shaping low-resilience spatial patterns. Enhancing UFR should prioritize improvements in the highly urbanized areas, with Dongguan City as the principal target. Resilience planning should consider the dominant expansion axis of low-resilience areas in each urban region, which is predominantly east–west in the Pearl River Delta. Implementation of UFR measures is more likely to yield tangible results by the end of the mid-future.}
}
@article{ORTIZELORZA2026136738,
title = {Warming, snow loss and drought intensification in Mediterranean water towers: The Ebro River basin and the Spanish Pyrenees},
journal = {Journal of Hydrology},
volume = {681},
pages = {136738},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136738},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018354},
author = {Arantxa Ortiz-Elorza and Carmelo Juez},
abstract = {Mountains provide essential water resources for dry lowlands, and in the semi-arid Mediterranean, seasonal snow and high-elevation rainfall sustain downstream urban and agricultural areas. As these regions are highly vulnerable to climate change, reliable regionalized CMIP6 projections are critical. This study focuses on the Ebro River Basin and the Spanish Pyrenees, producing regionalized temperature and precipitation datasets for four Shared Socioeconomic Pathways (SSP1-2.6, SSP2-4.5, SSP3-7.0, and SSP5-8.5), modelling future snow cover, and calculating the Standardized Precipitation Evapotranspiration Index (SPEI) to assess drought conditions. This is the first basin-scale CMIP6-based analysis for the Ebro River Basin that combines temperature, precipitation, Snow Water Equivalent (SWE) balance, and drought severity metrics (SPEI). Multi-model mean temperatures are projected to rise across the basin, with maximum temperature increases ranging from 0.58 °C to 4.53 °C and minimum temperature from 0.32 °C to 3.31 °C depending on the scenario. Multi-model mean precipitation shows no significant decline under SSP1–2.6, but local decreases of up to − 410 mm, accumulated over the study period, emerge under SSP5–8.5 in the northern Pyrenean headwaters. Our snow modelling reveals widespread cover loss under all scenarios, while SPEI results show droughts intensifying in severity and in frequency under all scenarios except SSP1-2.6, where a slight decrease is observed. These projections provide a basis for anticipating combined risks and supporting adaptation strategies. The integrated use of regionalized climate projections, snow modelling, and drought assessment provides a spatially explicit framework for identifying these interacting hydroclimatic changes and their potential implications for water-resource management and climate adaptation in the Ebro River Basin and the Spanish Pyrenees.}
}
@article{ZHANG2026136701,
title = {Soil moisture sensor networks for advancing understanding of hillslope and catchment hydrology: a review},
journal = {Journal of Hydrology},
volume = {681},
pages = {136701},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136701},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017981},
author = {Yangkai Zhang and Erqing Wang and Yuhan Guo and Hu Liu and Jie Tian and Ying Zhao and Carlos R. Mello and Yan Liu and Li Guo},
keywords = {Hydropedology, Hydrological connectivity, Preferential flow, Ecohydrological coupling, Data assimilation, Soil moisture dynamics},
abstract = {Soil moisture sensor networks (SMSNs) provide continuous, depth-resolved observations that help elucidate hydropedological processes: coupled soil–water interactions through which soil properties influence water storage, flow pathways, and redistribution across hillslopes and catchments. Because these processes vary across space, time, and depth, isolated measurements are often insufficient for mechanistic interpretation and model evaluation. This review synthesizes SMSN deployment strategies and applications across five domains: (1) soil water storage patterns; (2) soil water fluxes and runoff generation; (3) ecohydrological coupling; (4) land–atmosphere water and heat exchange; and (5) multi-source data fusion, assimilation, and validation. We compare four representative case groups: the Heihe Watershed Allied Telemetry Experimental Research (HiWATER) middle-reach oasis area in northwestern China; the Pailugou watershed in China’s Qilian Mountains; Terrestrial Environmental Observatories (TERENO) catchments and related sites in Germany and Italy; and the Shale Hills Critical Zone Observatory in the United States. These cases illustrate how environmental settings and network configurations shape process observability, cross-scale integration, and model evaluation. We examine limitations arising from sensor stability, installation disturbance, spatial representativeness, long-term operation, data quality, uncertainty, and the indirect nature of process inference. The synthesis links network design to observable process signatures and identifies priorities for integrating complementary observations. It provides guidance for designing SMSNs that support reliable interpretation of hillslope and catchment hydropedological processes.}
}
@article{BADRZADEH2026136741,
title = {A data-space inversion framework for uncertainty-informed monitoring network design in a regional coupled SWAT–MODFLOW model},
journal = {Journal of Hydrology},
volume = {681},
pages = {136741},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136741},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601838X},
author = {Nasrin Badrzadeh and Patrick Ray and Mohamad Reza Soltanian},
keywords = {Data-space inversion, Data worth, Groundwater monitoring, Predictive uncertainty, SWAT–MODFLOW, Buried-valley aquifer},
abstract = {Groundwater head is a key indicator of aquifer storage and surface water–groundwater interactions in managed watersheds. However, its prediction remains uncertain because hydraulic properties are spatially heterogeneous, hydrogeologic data are limited, and groundwater responses reflect coupled processes. Reducing this uncertainty requires identifying the most informative observations; however, streamflow and groundwater-head observations constrain different aspects of coupled systems, and their relative worth is less commonly quantified in regional models. Data-worth (DW) analysis provides this quantification, but its application to computationally demanding coupled models remains limited. Accordingly, this study asks which existing and prospective observations most effectively reduce groundwater-head predictive uncertainty in a heterogeneous river–aquifer system, and which parameter uncertainties control the remaining predictive uncertainty. We apply a data-space inversion (DSI)-based DW framework using an ensemble of coupled SWAT–MODFLOW simulations for the Great Miami River Watershed. Regional hydrogeologic information informed the conceptualization of aquifer geometry and lateral hydraulic-property contrasts, which were implemented in a single convertible groundwater model layer. Topographic, soil, land-use, climate, and groundwater-withdrawal data supported construction of the coupled model. DSI uses ensemble-derived observation–prediction relationships, allowing monitoring scenarios to be evaluated without rerunning or reconditioning the coupled model. Results show that streamflow provides the dominant watershed-scale constraint by integrating information on recharge, baseflow, and surface water–groundwater exchange, whereas groundwater-head observations provide complementary local constraints in transmissive buried-valley corridors. Prospective analysis identifies candidate wells in areas of elevated residual uncertainty as most informative, while linear analysis indicates that residual uncertainty is controlled primarily by specific yield and hydraulic conductivity. These results support targeted, uncertainty-informed groundwater-monitoring decisions in heterogeneous watershed-scale systems.}
}
@article{XIAO2026136746,
title = {N2O production pathways along a subtropical river headwater to confluence continuum: synergistic regulation by NH4+ supply and redox conditions},
journal = {Journal of Hydrology},
volume = {681},
pages = {136746},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136746},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018433},
author = {Yuesheng Xiao and Bin Ma and Zhiping Yuan and Yizhen Wang and Wenchang Wei and Hong Niu},
keywords = {River continuum, Riverine nitrogen substrate supply, Nitrous oxide (NO), Nitrogen and oxygen isotopes (δN-NO, δO-NO, δN-NH), NO isotopomers},
abstract = {Rivers are an important source of atmospheric N2O. However, the synergistic regulation of N2O production pathways along the river continuum by nitrogen supply, redox conditions, and hydrological characteristics remains poorly understood. Surface water samples were collected in summer (n = 27) and winter (n = 33) along a subtropical river continuum from headwaters to its confluence with the Yangtze River, with an elevation difference > 1500 m. Water chemistry, stable water isotopes (δ2H, δ18O), nitrate nitrogen and oxygen isotopes (δ15N-NO3−, δ18O-NO3−), ammonium nitrogen isotopes (δ15N-NH4+), and N2O isotopomers (δ18O-N2O, SP) were analyzed. Results showed that N2O concentrations were higher in summer than in winter and higher in the downstream agricultural plain than in mountainous and transitional reaches. Low NO3− supply limited the overall intensity of NO3−-based denitrification in river water. NH4+ source type and supply, together with DOC-DO-regulated redox microenvironments, jointly controlled N2O production in river water. In summer, higher exogenous NH4+ and DOC inputs and lower DO in the plain area promoted N2O production and accumulation. An SP-δ18O-N2O mixing model indicated that nitrification dominated basin-wide N2O production, contributing 55.34%–69.74% after correction for N2O reduction, while the denitrification contribution increased progressively from the mountainous headwaters to the downstream plain. These findings reveal that longitudinal shifts in nitrogen substrate supply and DOC-DO redox conditions from the headwaters to the confluence jointly shaped a N2O production pattern dominated by nitrification but with increasing denitrification downstream, providing new insights for N2O assessment in subtropical agricultural rivers.}
}
@article{YANG2026136718,
title = {Preference-conditioned feature selection for interpretable multi-objective water-system operating policies},
journal = {Journal of Hydrology},
volume = {681},
pages = {136718},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136718},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018159},
author = {Guang Yang and Matteo Giuliani and Zengchuan Dong and Pan Liu and Bin Xu and Andrea Castelletti},
abstract = {The operation of water resources is inherently complex, necessitating the reconciliation of competing objectives, the coordination of interconnected infrastructures, and adherence to various regulations and stakeholder perspectives. Multi-objective optimization methods have emerged as powerful tools for addressing these complexities by enabling decision-makers to balance conflicting goals. The effectiveness of these methods is contingent upon the input variables utilized in water resource operation models. However, decision-makers often find it challenging to understand how different input variables impact optimization performance regarding different objectives, thereby reducing the interpretability of these models and impeding their practical application in real-world contexts. In this regard, the careful selection of input variables can enhance both the efficacy and interpretability of multi-objective water resource operations. This paper assesses the significance of various input variables in water system operation models under differing decision-making preferences and extracts the most relevant information to alleviate conflicts among competing objectives. The approach is demonstrated on the GERD-Merowe-HAD reservoir system within the Nile River Basin, where the primary functions are hydropower generation and irrigation water supply at a strategic monthly planning scale. The framework is designed to support strategic policy design and input-variable screening, rather than to generate real-time gate-release schedules. A systematic feature selection framework that integrates Recursive Feature Elimination with Evolutionary Multi-Objective Direct Policy Search is employed to analyze the importance of various input variables in multi-reservoir operation. By linking input variable importance evaluations with multi-objective reservoir operation performance, we identify compact input formulations for operational policies tailored to specific decision-making preferences. The findings indicate that using selected input variables can mitigate conflicts between hydropower generation and irrigation water supply in the Nile River Basin, particularly when a lower irrigation deficit is desired. Furthermore, customizing reservoir operation policies with input variables chosen based on decision-making preferences can enhance the performance of the relevant objectives. The selected reduced-input policies also improve the trade-off performance relative to conventional input formulations, indicating that compact input sets can reduce policy complexity without sacrificing system performance. This proposed framework holds promise for improving the interpretability of machine-learning-based operational policies for water resource systems and fostering a stronger connection between these complex systems and their human operators. The transferable contribution is the feature-selection workflow itself; the specific selected variables should be re-evaluated for each reservoir system according to local objectives, constraints, available information, and decision scale.}
}
@article{ZHOU2026136681,
title = {Future exposure to dry and moist heat extremes linked to soil moisture regulation},
journal = {Journal of Hydrology},
volume = {681},
pages = {136681},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136681},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017786},
author = {Jingwei Zhou and Dragan Milošević and Adriaan J. Teuling},
keywords = {Heatwave, Soil moisture, Population exposure, Land-atmosphere interactions, Climate model},
abstract = {Extreme heatwaves pose escalating threats to ecosystems and human populations worldwide, yet comparative analyses of soil moisture impacts on both dry and moist heatwave types remain limited. Here, using multi-model climate simulations globally, we quantify how land–atmosphere interactions modulate dry versus moist heatwave intensification and consequent population exposure patterns. Unprecedented increases of both dry and moist heatwave magnitude are found across mid-latitude regions, with most regions already surpassing the 2 °C Paris Agreement threshold and certain regions exceeding 6 °C, relative to pre-industrial conditions. Dry heatwaves consistently exhibit greater intensification and trends than moist heatwaves. Soil moisture dynamics generally induce more changes in dry heatwaves relative to moist heatwaves. It is suggested that, northern parts of South America, Arabian Peninsula, and South Asia, are exposed to more severe dry and moist heatwaves in the future period (2040–2070) compared with other regions. Most places are experiencing increasing population exposure to heatwaves, with 30% more population in African regions exposed to severe moist heatwaves. Soil moisture amplifies population exposure in most places except in Arabian Peninsula. These findings demonstrate how region-specific land–atmosphere feedbacks modulate dry versus moist heatwave intensification, underscoring the necessity of incorporating such feedbacks to accurately quantify risks of two types of heatwaves and inform targeted adaptation strategies.}
}
@article{GUO2026136754,
title = {Hydrological implications of satellite-based water budget in the source area of China’s South-to-North water transfer middle route project},
journal = {Journal of Hydrology},
volume = {681},
pages = {136754},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136754},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018512},
author = {Yuchen Guo and Chong Zhang and Yun Pan and Qingquan Zhang and Lei Xu and Huixiang Li and Jiawen Yang and Ran Tang},
keywords = {Basin-scale water budget, Water storage change, South-to-North water transfer, Hanjiang River Basin},
abstract = {The South-to-North Water Transfer Middle Route Project (MRP) has diverted water from the Danjiangkou Reservoir in the Hanjiang River Basin (HRB) to water-scarce northern China since December 2014. Understanding MRP-induced hydrological impacts on the HRB is critical for sustainable water diversion. This study integrates satellite gravimetry and in-situ observations to analyze the evolution of terrestrial water storage and water budget in the HRB during 2003–2023. A comparison of pre-MRP (2003–2014) and post-MRP (2015–2023) hydrological regimes reveals how water diversion has reshaped the water cycle across the HRB. Results show that the terrestrial water storage in the HRB experienced no depletion under MRP operation, with its annual trend reversing from −1.9 ± 1.0 mm/yr (2003–2014) to 3.8 ± 2.1 mm/yr (2015–2023). This reversal was mainly attributed to increased storage in the dam-heightened Danjiangkou Reservoir, whose storage anomaly shifted from −0.3 ± 0.5 mm/yr to 4.2 ± 1.1 mm/yr, alongside a rise in mean annual precipitation from 859.1 ± 10.5 mm to 914.8 ± 12.4 mm. MRP operation reduced runoff by 10.6% and delayed the runoff response to precipitation by one month. Consequently, the runoff’s contribution to terrestrial water storage variability fell from 43.3% to 25.8%, while precipitation’s rose from 43.0% to 59.5%. Although the HRB’s hydrological cycle remained relatively stable in the post-MRP period, this stability relied on reservoir regulation and a wet climate, leaving the basin vulnerable to prolonged droughts. Adaptive reservoir operation and supplementary water sources are expected to enhance hydrological resilience and ensure the long-term sustainability of MRP operation.}
}
@article{ARZENOSOLTERO2026136726,
title = {Langmuir circulation facilitates episodic reoxygenation in a hypoxic shallow lake},
journal = {Journal of Hydrology},
volume = {681},
pages = {136726},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136726},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018238},
author = {Isabella B. Arzeno-Soltero and Kennedy Campanella and Mara A. Freilich and Diego Centeno and Alejandra G. Lopez and Glenn H. Mathews and Bethany O’Shea and Michael Adams and Cruz Marquez and Ryan G. Sinclair and Francisco {Orozco Rocha} and Aydee Rodriguez},
keywords = {Hypoxia, Langmuir circulation, Mixing, Lakes, Oxygen, Turbulence},
abstract = {Hypoxia is widespread in aquatic systems. Although turbulence can enhance air-water gas exchange and ventilate hypoxic waters, the role of Langmuir circulation in dissolved oxygen dynamics remains unclear. We address this gap in the Salton Sea, a large, shallow, hypereutrophic lake in Southern California, using six to nine months of continuous observations of dissolved oxygen, temperature, pressure, conductivity, and meteorological variables. Our records indicate that hypoxia is pervasive in the Salton Sea: oxygen concentrations fell below the hypoxia threshold (3.5 mg L−1) for 35% of the record in shallow near-shore regions, compared with 68–99% of the record at the lake center, depending on depth. Hypoxia was not confined to summer: in November, the entire water column at the lake center was hypoxic 83% of the time, and shallow near-shore sites were hypoxic 33% of the time. To determine what controls bottom-water oxygenation in shallow regions, we classify oxygen observations using a nondimensional framework based on the turbulent Langmuir number and a stability parameter, thus distinguishing Langmuir circulation, wind-driven shear turbulence, and convective instability. Bottom-water oxygen concentrations were, on average, 0.5–0.7 mg L−1 higher under Langmuir circulation than under wind-driven shear turbulence. These findings suggest that Langmuir circulation is an important mechanism regulating oxygen dynamics in large, shallow lakes. We hypothesize that continued shrinkage of endorheic lakes, such as the Salton Sea, will reduce fetch and suppress Langmuir circulation, potentially weakening bottom-water ventilation.}
}
@article{REN2026136742,
title = {A structure-constrained inverse distance weighting framework for stochastic simulation of multi-lithofacies sedimentary aquifer architecture},
journal = {Journal of Hydrology},
volume = {681},
pages = {136742},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136742},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018391},
author = {Wanli Ren and Yue Fan and Heng Dai and Mohamad Reza Soltanian and Ming Ye and Zhenxue Dai},
keywords = {Heterogeneous aquifer architecture, Categorical stochastic simulation, Inverse distance weighting, Borehole conditioning, Termination frequency correction},
abstract = {Characterizing multi-lithofacies aquifer architecture from sparse borehole data is essential for groundwater flow and solute transport modeling, yet remains challenging because categorical lithofacies fields must honor hard conditioning data while representing realistic proportions, anisotropic continuity, and connectivity. Conventional inverse distance weighting (IDW) is transparent and computationally efficient but primarily produces a single deterministic estimate and does not provide stochastic categorical realizations or categorical uncertainty. This study develops a bias-corrected inverse distance weighting (BIDW) framework for conditional stochastic simulation of heterogeneous aquifer architecture. At each unsimulated cell, anisotropic IDW support is used to construct a local categorical sampling distribution, from which lithofacies are sampled sequentially to generate borehole-conditioned stochastic skeletons. Subsequent structural organization and refinement uses lithofacies proportions and directional mean lengths as soft constraints, with tunable structural-reinforcement settings. Based on a three-lithofacies 3D synthetic aquifer benchmark, the staged workflow progressively improved grid scale agreement, with mean overall accuracy increasing from 0.668 to 0.716. The high-proportion background lithofacies was reproduced with a largest connected component fraction of 0.999 and directional mean lengths close to those of the reference model. For the low-proportion lithofacies, the number of connected components decreased from 423.4 to 18.4, close to the reference value of 16, while the largest connected component fraction increased from 0.401 to 0.747. These results demonstrate that BIDW effectively extends IDW from deterministic interpolation to stochastic structural simulation, providing a transparent, data-efficient, and geologically constrained alternative for borehole-based aquifer architecture modeling.}
}
@article{WU2026136722,
title = {Spatiotemporal prediction and response-pattern zonation of soil moisture in Shanxi Province using PC-AtlasSM and Self-Organizing Maps},
journal = {Journal of Hydrology},
volume = {681},
pages = {136722},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136722},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018196},
author = {Wenjie Wu and Xiao Liu and Lijuan Huo and Yun Zhang and Lei Song and Shuai Li and Yuxiang Liu and Gaiqiang Yang},
keywords = {Soil moisture, Complex terrain, Spatiotemporal prediction, PC-AtlasSM, Self-Organizing Maps, Response-pattern zonation},
abstract = {Soil moisture dynamics in complex terrain are jointly controlled by rainfall inputs, evaporative losses, and topographically mediated redistribution. Existing methods often struggle to simultaneously achieve high short-term predictive accuracy and process interpretability at the regional scale. This study develops an operational framework for 1-h soil moisture prediction at 20 monitoring stations, exploratory response-pattern analysis; inverse distance weighting maps are visualization outputs, not fixed-resolution products. PC-AtlasSM integrates established antecedent-state, rainfall, evaporation, inertia, and bounded-update concepts in an explicit and auditable sequence rather than introducing a new learning principle or process equation. Taking Shanxi Province as a case study, we used soil moisture observations, meteorological variables, and topographic information to investigate regional spatiotemporal prediction and response-pattern zonation of soil moisture. Results show that PC-AtlasSM achieved the best performance for 1-h forecasting, with the lowest RMSE (13.385%) and MAE (4.026%), and the highest R2 (0.713). Relative to the persistence benchmark, the skill score reached approximately 27%. The sample-wise comparison with ExtraTrees supported an error reduction, although temporal dependence among hourly errors limits interpretation of the extremely small p value as evidence of an equally strong practical or generalizable improvement. The component audit identified temporal inertia as the only empirical stabilizer with a measurable aggregate effect; the wetting, drying, and dynamic caps did not alter aggregate test metrics and are retained only as precautionary safeguards. SOM summarized four exploratory statistical response-pattern classes. These classes describe associations in a feature space that includes soil moisture change; they do not independently establish causal controls or verified hydrological regimes. Together, the results support PC-AtlasSM as a transparent operational integration for short-term station-supported forecasting and exploratory response-pattern analysis, rather than as a new standalone algorithm. The framework may support soil moisture monitoring, drought–flood risk identification, and regional water-resources and hydro-meteorological risk assessment.}
}
@article{LIU2026136706,
title = {Scale-dependent phosphorus export across rainfall gradients: Hydrological dynamics and storm-event responses},
journal = {Journal of Hydrology},
volume = {681},
pages = {136706},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136706},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018032},
author = {Xinyu Liu and Quan Liu and Tao Wang and Minghua Zhou and Bo Zhu},
keywords = {Phosphorus speciation, Catchment scale, Critical rainfall threshold, Non-point source pollution, Transport mechanisms, Purple soil},
abstract = {Effective control of watershed non-point source phosphorus (P) pollution is often hindered by a lack of understanding of episodic, high-magnitude export events. Specifically, the critical rainfall thresholds triggering these events and their modulation by catchment scale remain unclear. Here, this study investigated P export dynamics across four nested catchments (3.2–1236.4 ha) in the Sichuan Basin of China, employing high-frequency automated sampling across a rainfall gradient. Results identified a critical rainfall threshold of approximately 30 mm. Below this threshold, TP export remained low, with a higher relative contribution of dissolved total P (DTP) during moderate events. Above the threshold, P loads increased sharply and PP was the dominant exported fraction. At Wan’an (WA), the largest catchment, four monitored events contributed 51.1 % and 59.2 % of annual composite TP and PP loads, respectively. PP accounted for 95.6 % of TP at WA during the largest event. This threshold response was strongly scale-dependent, with small headwater catchments exhibiting source-limited, flashy responses (first flush), whereas larger catchments showed buffered hydrographs attributed to network attenuation. Furthermore, PO4-P/DTP ratios were higher in the larger catchments than in SR, indicating scale-dependent differences in dissolved P speciation. These findings suggest a paradigm shift in management strategies away from static annual load reduction towards targeted controls in critical source areas during high-risk storm events identified by specific rainfall thresholds.}
}
@article{MARSHALL2026136599,
title = {Relative roles of spatial resolution and temporal coverage in basin-average SMAP soil moisture assimilation over the Mekong River basin},
journal = {Journal of Hydrology},
volume = {681},
pages = {136599},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136599},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426016963},
author = {Sebastian R.O. Marshall and Duc Tran and Binh Quang Nguyen and Manh-Hung Le and Bin Fang and Hesham Elhaddad and John Eylander and Sameh A. Kantoush and John D. Bolten and Venkataraman Lakshmi},
keywords = {Data assimilation, SMAP, Soil and water assessment tool, Ensemble Kalman filter, Mekong river basin, Soil moisture},
abstract = {Satellite soil moisture offers a basin-wide constraint on the water state of large monsoon basins, where ground networks are sparse and cloud interrupts optical and thermal observation. Downscaled Soil Moisture Active Passive (SMAP) products add spatial detail but inherit that cloud dependence, raising the question of how resolution and temporal coverage each contribute to assimilation. This study examined it over the Mekong River Basin using 9 km, 1 km, and 400 m products from 2015 to 2024. A 200-member ensemble Kalman filter assimilated each product as a basin-average composite, isolating temporal sampling, while a separate coupled experiment updated soil storage in the Soil and Water Assessment Tool (SWAT) and evaluated discharge at five gauges against a matched control. Assimilation reduced discrepancies with each assimilated input by 58.9–60.6%, the 9 km product retaining the smallest residual under common error settings. Imposing the finer products’ schedules on the 9 km record left shared-day scores within sampling uncertainty but raised full-calendar error by 0.0036 and 0.0048 m3/m3, because the omitted 8.3% and 11.7% of days contributed 35.8% and 44.3% of squared error. Product-specific error calibration reversed the ranking, showing that coverage alone did not determine it. Within SWAT, 1 km assimilation produced the largest discharge gains, resolved at the two downstream gauges, raising Nash–Sutcliffe efficiency at Kratié from 0.621 to 0.706 as monsoon storage bounds converted proposed water additions into a net removal that reduced surface runoff and groundwater flow. Agreement with assimilated observations and hydrological benefit therefore ranked the products differently.}
}
@article{ZONG2026136660,
title = {Riparian freshwater lenses adjacent to curved rivers: morphology and controls},
journal = {Journal of Hydrology},
volume = {681},
pages = {136660},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136660},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017579},
author = {Hongrong Zong and Huiqiang Wu and Wenyu Xu and Kai Lu and Jiaxin Chen and Chunhui Lu},
keywords = {Meandering river, Numerical modeling, Riparian freshwater lens, River planform geometry, Saline floodplain aquifer},
abstract = {Freshwater lenses can persist in saline floodplain aquifers adjacent to gaining rivers, yet existing research has largely examined them in cross section and has not systematically addressed the role of river planform geometry. This study provides the first systematic assessment of how river planform geometry modifies riparian freshwater lens morphology under gaining river conditions. Riverbank traces are represented using sine-generated curves with varying deflection angles. Three-dimensional variable-density groundwater flow and solute transport simulations are then conducted to examine freshwater–saltwater distributions in these idealized planforms. The results show that freshwater lenses extend farther inland near convex banks than near concave banks. Riverbank curvature redirects upper freshwater toward convex sectors, whereas deeper mixed and saline groundwater flows toward concave sectors. This redistribution contributes to the greater lens extent near convex banks. When valley wavelength is fixed, increasing sinuosity enlarges the lens, with freshwater storage increasing by a factor of 7.65 as the deflection angle increases from 0° to 105°. However, when channel length is fixed, freshwater storage initially rises and then declines as sinuosity increases. Stronger saline groundwater discharge compresses the lens toward the river, where its morphology is more constrained by local bank curvature. These findings highlight the need to consider river planform geometry when assessing freshwater storage in saline riparian aquifers, as spatial variability in freshwater availability may otherwise be underestimated.}
}
@article{ZHANG2026136696,
title = {Molecular compositions and hydrological features govern dissolved organic phosphorus transport and transformation in rivers across different climate zones},
journal = {Journal of Hydrology},
volume = {681},
pages = {136696},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136696},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017932},
author = {Peipei Zhang and Qibiao Yu and Fenfang Wang and Jianing Wang and Dongsheng Wang and Weijin Yan and Dingjiang Chen},
keywords = {Dissolved organic phosphorus, Molecular composition, Hydrological feature, Uptake velocity, Turnover rate},
abstract = {Dissolved organic phosphorus (DOP) is a potentially bioavailable component of riverine phosphorus export, yet the molecular controls on its uptake and their coupling with hydrological transport remain poorly constrained. Here, we integrated Fourier-transform ion cyclotron resonance mass spectrometry, incubations, and nutrient-spiraling metrics across heterogeneous rivers and estuaries spanning five river basins of eastern China. DOP accounted for 5.79–86.6% (mean: 31.6% ± 13.2%) of total phosphorus, with concentrations and molecular composition varying with river size and land use. DOP concentrations decreased from headwater streams to mainstems and rose with agricultural and urban land proportions; forest rivers were relatively enriched in highly unsaturated compounds, whereas agricultural and urban rivers were enriched in labile peptides and CHOP-class compounds. We developed a molecular lability index (LI-DOP) integrating H/C, O/C, and molecular mass. LI-DOP explained 60% of the observed variation in uptake velocity (Vf, 0.19–0.79 m d-1) and was retained in the optimal model of riverine turnover rate (k, 0.02–0.28 d-1) together with discharge and DOP concentration. These quantitative relationships indicate that DOP processing reflects molecular composition in conjunction with hydrological and chemical conditions and cannot be adequately characterized by DOP concentration alone. Moreover, DOP conversion potentially contributed 9.61–40.2% (20.9 ± 8.26%) of dissolved inorganic phosphorus at river scales. These estimates suggest in-river DOP conversion may constitute an important internal source of bioavailable phosphorus, while DOP escaping conversion may be exported downstream and support phosphorus availability in estuaries. These findings support incorporating DOP molecular composition and transformation into river-estuary phosphorus assessments.}
}
@article{KHANAL2026136676,
title = {Climate change induced hydrological regime shifts in the transboundary Zarafshon River Basin in Central Asia},
journal = {Journal of Hydrology},
volume = {681},
pages = {136676},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136676},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017737},
author = {Sonu Khanal and Philip Kraaijenbrink and Faezeh Nick and Joel Fiddes and Arthur Lutz and Evan Miles and Esteban {Boj Garcia} and Brecht D'Haeyer and Johannes Hunink and Walter Immerzeel},
keywords = {Hydrological shifts, Climate change impacts, Central Asia, Snowmelt, Glacier melt, Transboundary River},
abstract = {Mountain river basins in Central Asia are highly sensitive to climate-driven changes in snow and glacier melt, yet the magnitude and timing of the resulting hydrological regime shifts remain poorly quantified. To address this gap, we assess present and future hydrological shifts in the transboundary Zarafshon River Basin with the SPHY glacio-hydrological model. We improved the representation of snowmelt and snow infiltration, which redistributes water to delayed baseflow and improves winter and spring discharge. We calibrated the improved model against discharge observations, satellite-derived snow cover and glacier mass balance data through Monte Carlo optimization. Over 1991–2020, snowmelt dominates runoff (52.4%), followed by baseflow (23.3%) and rainfall-runoff (21.1%), whereas glacier melt contributes 3.2% but sustains late-summer low flows. Snow and glacier melt dominate the upstream hydrology, whereas rainfall-runoff and baseflow sustain the flow in the lower basin. Using downscaled ISIMIP3b climate scenarios, we project glacier volume to decline by ∼ 40% under SSP126 and ∼ 80% under SSP585 by 2100. Annual total runoff declines by less than 7% in all scenarios, because gains in rainfall-runoff and baseflow almost offset the melt loss. Peak total runoff declines by 22.6% under SSP585, and the annual peak discharge shifts earlier by 22–38 days. The hydrological regime shift from snowmelt to rainfall-runoff is more pronounced in the Fondarya than in the Matcha River system. These results indicate a shift from a snowmelt to a rainfall-runoff dominated hydrological regime. Such a shift would reduce summer water availability and increase irrigation stress, highlighting the need for adaptive management.}
}
@article{TUO2026136684,
title = {Interpretable soil moisture drought forecasting using graph attention networks},
journal = {Journal of Hydrology},
volume = {681},
pages = {136684},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136684},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017816},
author = {Ye Tuo and Moritz Wirthensohn and Hongliang Ma and Francesco Avanzi},
keywords = {Explainable AI, Deep learning, Alpine catchment, Attention weights, Ensemble learning},
abstract = {Accurate and interpretable soil moisture drought forecasting supports hydrological management. Capturing spatial and seasonal drought variability while interpreting learned dependencies remains challenging for data-driven models. This study assesses a domain-informed Graph Attention Network (GAT) to forecast soil moisture drought one-week-ahead by representing hydrological response units (HRUs) as a graph. A retrospective ensemble-based benchmark using 200 independently trained models evaluates predictive performance, spatiotemporal drought-pattern reproduction, and interpretability through feature importance and attention analyses. GAT achieves high F1 scores and a modest but spatially coherent improvement over an LSTM baseline, with the largest gains at lower elevations and reduced performance for both models in high-elevation headwaters. In full-record diagnostics, GAT better reproduces observed drought patterns, particularly in summer, with closer agreement in basin-wide drought frequency and reduced bias. Permutation-based feature importance identifies evaporative-demand variables and topographic features as important predictors with distinct spatial and temporal roles. Attention analyses show that HRU-graph connectivity shapes the dominant spatial attention pattern, while attention weights locally and seasonally reweight connected-source contributions in ways consistent with elevation-dependent input dynamics. A complementary assessment combines chronological train-validation-test separation with different soil moisture input configurations. GAT achieves highest F1 scores among the learned models, and soil moisture benefits the graph models more strongly than LSTM. However, none exceeds persistence in basin-level F1 during the withheld test period. These findings support GAT’s diagnostic value for examining reproducible spatiotemporal patterns in model behavior alongside predictive performance, while operational application requires further development and evaluation against persistence.}
}
@article{JIANG2026136692,
title = {High and variable nitrous oxide emissions from human-impacted lentic freshwaters},
journal = {Journal of Hydrology},
volume = {681},
pages = {136692},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136692},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017890},
author = {Mingliang Jiang and Qitao Xiao and Lei Hong and Yuhang Liu and Xingyu Jiang and Cheng Hu and Ligang Xu},
keywords = {NO emissions, Inland waters, Lakes and reservoir, Dynamic variability, Anthropogenic disturbances},
abstract = {Inland waters are important but poorly constrained sources of atmospheric nitrous oxide (N2O). Lentic freshwaters including lakes and reservoirs represent key components of inland waters and serve as critical hotspots for nitrogen cycle, yet how anthropogenic disturbances drive their N2O dynamic variability remains unclear. To address this knowledge gap, systematic field measurements in three lakes and one reservoir in China’s eastern plain with intensive anthropogenic activity were conducted to characterize the dynamic variability of N2O emissions and disentangle the key environmental drivers. Results found dissolved N2O concentrations showed uniform vertical distribution but distinct seasonal and spatial variability. These water bodies acted as significant and variable N2O emissions sources, with the emissions flux ranging from 0.25 to 69.27 µmol m−2 d-1 (mean value 7.98 ± 9.12 µmol m−2 d-1). The N2O emissions exhibited strong seasonality, peaking (hot moments) in warm seasons (spring and summer), and N2O emissions of warm seasons were 3.8 times those in cold seasons (autumn and winter). Hot moments of N2O emissions were likely linked to temperature and precipitation-derived hydrological regimes. Inflow-affected zones were hot spots of N2O emissions, with emissions about twice those of pelagic zones (12.47 versus 5.76 µmol m−2 d-1). While regulating factors differed among water bodies and zones, anthropogenic-derived nutrient loadings and associated environment change substantially promoted N2O production and emissions, particularly in inflow-affected zones. Our findings likely deepen insights into N2O biogeochemistry in lentic freshwaters under anthropogenic disturbances and underscore the need to account for waterbody heterogeneity in aquatic N2O emissions estimate.}
}
@article{REN2026136737,
title = {Cross-scale characterization and controlling mechanisms of fluid migration in structurally heterogeneous rough fractures},
journal = {Journal of Hydrology},
volume = {681},
pages = {136737},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136737},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018342},
author = {Xu Ren and Sida Jia and Quan Gan and Funing Ma and Junjun Chen and Zhenxue Dai},
keywords = {Rough fracture, Hydraulic aperture, Hybrid residual network, Cross-scale modeling, Plume migration},
abstract = {Fractures govern hydraulic connectivity and fluid migration in deep aquifers and reservoirs. Reservoir models often simplify rough fractures as parallel plates or assign empirical equivalent permeability. These assumptions obscure the effects of local aperture variation on preferential flow pathways. We develop a framework linking rough fracture flow across grid, core, and field scales. At the grid scale, fracture surfaces are represented as local plane cutting units. Upper surface, lower surface, and double surface cutting capture aperture variation and yield 12,000 local flow samples. A hybrid residual network (Hybrid ResNet) maps these geometries to equivalent porosity and permeability. At the core scale, lateral offset between conjugate rough surfaces creates a single fracture. A permeability relation is developed and tested using 416 numerical cases covering aperture scale, relative roughness, and surface offset. Independent validation gives an R2 of 0.80 and an RMSE of 0.035. The relation is incorporated into a coupled thermal, hydraulic, mechanical, and chemical (THMC) model for reservoir flow simulations. At the core scale, relative roughness reduces connected flow space. Surface offset changes wall matching and redirects the main channels. Sobol analysis of the fitted empirical relation ranks aperture scale highest within the analyzed ranges. Its total-effect index for hydraulic correction is 0.42. At the field scale, rough fractures redistribute interwell flow and delay CO2 breakthrough from 4.20 to 4.71–4.93 years. Rearranging the same hydraulic correction values among reservoir cells also changes breakthrough timing. The framework links local fracture geometry to plume migration. It supports breakthrough risk assessment in fractured aquifers and reservoirs.}
}
@article{JIN2026136709,
title = {Accuracy comparison of classic bedload transport formulas in the Yangtze River},
journal = {Journal of Hydrology},
volume = {681},
pages = {136709},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136709},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018068},
author = {Zhongwu Jin and Ke Hu and Wenqi Li and Jinyou Lu and Lixia Sun and Qianting Liang and Yihui Xiao},
keywords = {Bedload, Formula comparison, Bedload transport formula, Fluvial morphology, Yangtze River},
abstract = {Most classic bedload transport formulas were calibrated using flume experiments or field data collected from small- and medium-sized rivers, leaving their applicability to large rivers uncertain. This study compared ten widely used formulas using 1,618 field measurements from seven hydrological stations along the Yangtze River mainstem during 1973–2023. A qualitative–quantitative framework combined distributional diagnosis of transport-rate frequency patterns with three log-scale metrics: interval compliance rate, systematic log-bias, and log-scale root mean square error. These metrics were integrated using an entropy-weighted composite accuracy index. Hydro-sedimentary conditions varied markedly: the upper Yangtze had confined channels with narrow, deep cross-sections, higher velocities despite lower discharges, and coarser, more heterogeneous bedload, whereas the Zhicheng–Hankou reach was dominated by uniform sand bedload. The recommended formulas were Schoklitsch for Cuntan, Recking for Fengjie, Meyer-Peter and Müller for Yichang and Zhicheng, Bagnold for Shashi, and Wong and Parker for Jianli and Hankou. These results indicate that different formulas are suited to different ranges of hydro-sedimentary conditions along the Yangtze River. Across fluvial geomorphic settings, recommendations varied most among mountainous rivers because of flow–sediment variability and the limited suitability of classic formulas under heterogeneous conditions, whereas formulas performing well in transitional and alluvial reaches showed more consistent performance and greater transferability. Structural analysis indicated that fixed coefficients and exponents and deterministic incipient-motion thresholds constrain formula adaptability. Formula selection in large rivers should therefore jointly consider hydro-sedimentary characteristics, fluvial geomorphic setting, and intrinsic formula structure.}
}
@article{WU2026136745,
title = {Characteristics and stabilization mechanisms of colloidal phosphorus in river-reservoir ecosystems: A case study of Xiangxi River},
journal = {Journal of Hydrology},
volume = {681},
pages = {136745},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136745},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018421},
author = {Fengxue Wu and Danhao Li and Jingfu Wang and Jingan Chen and Peng Shi and Wen Guo and Feiqin Nie},
keywords = {River-reservoir composite ecosystems, Colloidal phosphorus, The Three Gorges Dam},
abstract = {Worldwide reservoir impoundment creates integrated river-reservoir composite ecosystems that have substantially altered the hydrological processes and biogeochemical cycling pathways of natural rivers. Phosphorus acts as a critical factor impacting aquatic primary productivity, and excessive phosphorus enrichment in water bodies can readily trigger environmental problems such as harmful algal blooms. Among all phosphorus fractions, colloidal phosphorus (CP) exhibits unique migration and transformation behaviors in phosphorus biogeochemical cycles due to its tiny particle size and large specific surface area. Nevertheless, few existing studies have focused on the characteristics and stabilization mechanisms of CP within river-reservoir ecosystems. The present study selected the typical river-reservoir composite ecosystems of the Xiangxi River and the Three Gorges Dam as the research object; by integrating in-situ field monitoring and laboratory simulation experiments, it systematically elucidated phosphorus speciation and spatial distribution patterns across multiple media, and identified the dominant factors governing the stability of CP in the water column. The results show that the total phosphorus (TP) concentration in the water of the study area is 0.045 ± 0.015 mg L−1, and its spatial distribution follows two consistent patterns: “tributary > main stream” and “overlying water > surface layer > middle and bottom layers.”. CP represents a major phosphorus fraction, accounting for 4.3% − 58.3% of water-column TP with an average proportion of 25.31%. Both its particle size and the absolute value of zeta potential decrease with increasing water depth, revealing that size-selective sedimentation, i.e. the preferential settling of the larger and less stable colloids, constitutes the core mechanism restricting the vertical transport of CP to deep water. The ion composition of water bodies is an important influencing factor in regulating the distribution of phosphorus fractions in the water environment. The single-ion controlled incubation experiments show that the influence of ion concentration (especially Ca2+ and Mg2+) on the transformation of colloidal phosphorus is more significant than that of ion properties, but the results of these single-ion experiments cannot fully reflect the real response of the complex in-situ environment of the reservoir. In this study (pH = 8.04 ± 0.13) and the incubation experiment with pH = 6.0–8.0, the influence of pH fluctuations on the distribution characteristics of colloidal phosphorus was negligible. This study systematically clarifies the occurrence characteristics and migration and fate mechanism of colloidal phosphorus in the river-reservoir transition system, which can provide theoretical support for water environment management and phosphorus pollution control in the reservoir area.}
}
@article{XIE2026136717,
title = {Quantifying multidimensional drought risks under climate change: A deep learning-based downscaling and DDF curves approach},
journal = {Journal of Hydrology},
volume = {681},
pages = {136717},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136717},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018147},
author = {Xuan Xie and Guohe Huang and Yuke Li and Shuguang Wang and Yurui Fan},
keywords = {Climate change, Drought, ECA-CNN, Downscaling, Duration-Deficit-Frequency curves, Uncertainty analysis},
abstract = {Reliable estimates of future drought characteristics and associated risks are essential for regional water resource planning under climate change. Traditional large-scale precipitation datasets and the derived drought indices, such as the Standardized Precipitation Index (SPI), suffer from limitations in spatial resolution and cannot directly represent actual precipitation deficits or associated water shortages. Moreover, separate analyses of drought duration, severity, and frequency often fail to capture the interdependence among these characteristics. To address these limitations, this study develops an integrated analytical framework that combines multi-criteria GCM selection, deep learning-based ensemble downscaling, and drought Duration-Deficit-Frequency (DDF) analysis. Future precipitation projections at the analyzed stations in the Upper Yangtze River Basin are first generated under four SSP scenarios through the proposed downscaling framework. The downscaled series are then used to construct DDF curves based on the best-fit probability distribution, jointly quantifying drought durations, cumulative precipitation deficits, and return periods. The results indicate that the occurrence of extreme droughts generally exceeds historical levels under future climate scenarios, although the magnitude of change varies substantially among the analyzed stations and across SSP scenarios. DDF analysis further reveals increased cumulative precipitation deficits, particularly for longer-duration drought events. Bootstrap analysis indicates that uncertainty in the DDF curves increases with drought duration and return period, while multilevel factorial analysis (MFA) identifies GCM ensemble configuration and downscaling methodology as the dominant sources of uncertainty. By linking drought-index-based event identification with physical precipitation-deficit quantification, the proposed framework provides a physically interpretable and uncertainty-aware approach for assessing station-specific drought characteristics and associated risks under alternative SSP scenarios.}
}
@article{YANG2026136680,
title = {Multi-section, multi-time reconstruction of water-level and bed-level evolution under oblique-flow bend conditions via multi-stream deep learning},
journal = {Journal of Hydrology},
volume = {681},
pages = {136680},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136680},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017774},
author = {Song-Yue Yang and Sze-Teng Liong and Shih-Chao Wei and Chiun-Chau Su and Y.S. Gan and Cheng-Jia Li},
keywords = {Local scour, Bend scour, Oblique flow, River-bend hydraulics, Flume experiments, Deep learning, SHAP},
abstract = {Oblique flows at river bends can induce levee-toe scour and threaten flood-protection structures. This study develops a multi-stream deep-learning framework for reconstructing water level (WL) and bed level (BL) conditioned on a known event hydrograph. The laboratory dataset contains 110 hydraulic events, including 80 steady-flow and 30 unsteady-flow tests, with observations at 12 cross-sections and 12 sampling times per event. The model maps time, discharge, and cumulative inflow volume descriptors, together with five static variables, to 288 joint WL/BL outputs. In the implemented Multi-stream CNN–BiLSTM, the sampled event histories occupy the feature dimension and the BiLSTM receives a sequence of length one; its results therefore do not demonstrate recurrent learning across the 12 sampling times. Under the common 76/17/17 event-level split, the Multi-stream model obtained MAE = 0.0233 m, RMSE = 0.0328 m, and R2=0.8046, compared with 0.0244 m, 0.0349 m, and 0.7738 for the Single-stream model. Paired event-level bootstrap intervals support lower BL errors on this test split but do not establish a clear WL advantage. Separate WL and BL SHAP beeswarm plots describe attribution to the mean predicted response over the sampled sections and times. These attributions are statistical associations and do not establish physical causality. The framework provides a laboratory-scale event emulator; causal forecasting, explicit spatial adjacency, transfer to field conditions, and engineering accuracy for maximum scour remain unvalidated.}
}
@article{LIU2026136725,
title = {Layered heterogeneity with subsurface dams controls nitrate fate and denitrification in tidally-influenced coastal aquifers},
journal = {Journal of Hydrology},
volume = {681},
pages = {136725},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136725},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018226},
author = {Maochun Liu and Jina Yin and Chunhui Lu and Frank T.-C. Tsai},
keywords = {Layered heterogeneity, Nitratefate, Denitrification, Subsurface dam, Coastal aquifer},
abstract = {Stratified heterogeneity is known to substantially alter groundwater flow and saltwater-freshwater mixing in coastal aquifers, but its effects on nitrate (NO3-) fate and denitrification under tidal forcing remain poorly understood, particularly when subsurface dams add hydrogeological complexity. Elucidating these effects is critical for evaluating nitrate attenuation prior to submarine discharge, yet their function as biogeochemical reactors has received little attention. The study combines laboratory experiments with numerical models coupling variable-density flow and reactive transport to investigate how a low-permeability layer (LPL) modulates flow patterns, mixing, nitrate transformation, and solute exchange across the aquifer-ocean interface. Results reveal that the permeability contrasts between the LPL and adjacent sediments induce irregular saltwater advancement and markedly delay upstream saltwater retreat. Due to suppressed seawater circulation downstream of the dam, particle travel time is nearly twofold longer. Denitrification hotspots are found near the margin of the upper saline plume (USP) and its adjacent LPL, where oxygen depletion allows residual dissolved organic carbon (DOC) to mix with NO3- entering the aquifer, forming NO3--depleted and N2-enriched zones. Compared to homogeneous settings, the LPL expands denitrification zones and promotes nitrate removal, reducing maximum absolute nitrate flux by approximately 50% and nearly doubling maximum absolute N2 flux, demonstrating that physical retention and biogeochemical transformation are coupled. Sensitivity analyses identify three distinct but interacting controls on nitrate attenuation: residence time, reactant mixing, and DOC decomposition kinetics. These findings provide a new conceptual framework that reframes the LPL as a key control on biogeochemical processes in heterogeneous coastal aquifers.}
}
@article{YANG2026136721,
title = {Short-term predictability of groundwater electrical conductivity and water level in a coastal aquifer considering antecedent states and external forcing},
journal = {Journal of Hydrology},
volume = {681},
pages = {136721},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136721},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018184},
author = {Fuwei Yang and Fan Yang and Xiaonong Hu and Chuanshun Zhi and Guangwei Wu and Wenwen Bi and Yulong Dong},
keywords = {Coastal aquifer, Groundwater-state persistence, Lagged response, Hydroclimatic forcing, Persistence benchmark, Data-driven modelling},
abstract = {Groundwater electrical conductivity (EC) and groundwater level (GWL) in coastal aquifers respond to both antecedent groundwater conditions and external forcing, but their short-term predictability and the contribution of these information sources remain uncertain. Using automated monitoring records from the southern coast of Laizhou Bay, we developed a daily prediction framework combining data quality control, time-lagged correlation analysis, five data-driven models, a persistence benchmark, and grouped-input ablation. Rainfall- and tide-related responses showed weak but spatially heterogeneous lagged associations; the 24-h mean tidal level showed the clearest associations with GWL at several wells, whereas EC responses were more variable. The persistence benchmark produced lower eight-well mean errors than all five data-driven models, with mean RMSE values of 0.460 mS/cm for EC and 0.081 m for GWL, showing that antecedent groundwater states account for a large part of one-day-ahead predictability. Among the data-driven models, SVR gave the strongest integrated EC performance, while GWL performance depended on the evaluation metric. Ablation experiments showed that antecedent target states contained substantial predictive information, whereas the added value of rainfall and tidal inputs varied with prediction target and model architecture. Short-term predictability in this coastal aquifer depended strongly on groundwater-state persistence, while the added information from external forcing varied among locations and model architectures.}
}
@article{NAVEED2026136705,
title = {Flow velocity drives divergent functional and structural responses in a rheophilic Yangtze fish: implications for aquatic ecosystem management},
journal = {Journal of Hydrology},
volume = {681},
pages = {136705},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136705},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018020},
author = {Waleed Afzal Naveed and Mian Adnan Kakakhel and Xiaotao Shi and Jiang Zewen},
keywords = {, Hydrodynamic stress, Environmental flow, Flow regime alterations, Aquatic ecosystem response},
abstract = {Altered flow regimes caused by dams and hydropower operations can modify hydraulic conditions experienced by riverine fishes, yet the biological consequences of graded water velocity across multiple levels of organisation remain poorly understood. This study investigated the responses of juvenile Coreius guichenoti to four water velocity regimes (control, low, medium, and high) during repeated exposure over seven days. Swimming performance, behaviour, oxidative status, innate immune responses, inflammatory cytokines, and white muscle histopathology were evaluated, and machine-learning models were used to assess integrated response patterns. Medium velocity increased critical swimming speed, antioxidant enzyme activities, lysozyme activity, and serum immunoglobulin M, whereas high velocity reduced swimming capacity and increased cortisol, lipid peroxidation, pro-inflammatory cytokine expression, and refuge-seeking behaviour. In contrast to these non-monotonic physiological responses, muscle pathology increased progressively with velocity. A random forest classifier achieved 90% cross-validated accuracy in distinguishing velocity treatments, while physiological biomarkers explained 36% of the variation in individual swimming performance. These findings demonstrate that altered hydraulic conditions can elicit divergent functional and structural responses in rheophilic fish, highlighting the need to incorporate biological response thresholds and hydraulic refugia into environmental flow assessment and management.}
}
@article{XU2026136729,
title = {A hydrological comparability framework for hydropower potential assessment: evidence from China},
journal = {Journal of Hydrology},
volume = {681},
pages = {136729},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136729},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018263},
author = {Ning Xu and Peifang Leng and Qiuying Zhang and Zhipin Ai and Gang Chen and Fadong Li},
keywords = {Hydropower potential assessment, Comparability, Climate change, Reservoir operation, Ecological constraints, China},
abstract = {Hydropower outputs depend on water availability, hydraulic head, conversion assumptions and the operating rules or constraints applied. Meaningful comparison of reported values requires identifying the specific quantity being assessed and the methodological, spatial, temporal, and operational conditions under which each value was derived. This structured critical review examines 100 China-focused, benchmark, and conceptual studies, linking 362 terminology records and 358 quantitative-output records from 73 papers. Differences in assessment objects, hydrological baselines, spatial aggregation, and operation and feasibility constraints explain why similar terms or units can describe distinct quantities. Source studies illustrate how runoff timing, storage, turbine releases, and ecological requirements enter resource, generation, and risk assessments. The framework connects author terminology, assessment objects, conditioning layers, and metric families to a question-specific comparison procedure. Users align the required quantities and reference conditions, distinguish deliberately varied conditions, and identify the permitted interpretation. Numerical comparison requires compatible quantities and reference bases. Design differences may constrain interpretation, whereas incompatible quantities or missing essential information may preclude meaningful numerical comparison. Contextual values retain their background role and attribution. A conditional reporting table and five-item checklist specify the information needed to apply the procedure in hydrological assessment, basin and cascade planning, and reservoir management.}
}
@article{YANG2026136663,
title = {A recursive conditional generative adversarial network for multiphase flow prediction in anisotropic porous media under dynamic constraints},
journal = {Journal of Hydrology},
volume = {681},
pages = {136663},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136663},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017609},
author = {Tianyu Yang and Xiang Rao and Kang Wang and Shuhui Xu and Wentao Zhan and Zhong Chen},
keywords = {Reservoir performance prediction, Recurrent conditional generative adversarial network, Permeability anisotropy, Time-varying well controls, Continuous-time state reconstruction},
abstract = {Permeability anisotropy and time-varying well controls govern oil-saturation evolution during waterflooding, but repeated high-fidelity simulation is computationally expensive. We propose a recurrent conditional generative adversarial network (R-CGAN) for rapid spatiotemporal prediction of oil-saturation fields under anisotropic permeability and dynamic injection-production controls. A permeability-guided feature-adaptation mechanism captures directional flow behavior, while spatial encodings of well locations, types, and time-varying rates drive recurrent state transitions together with the current reservoir state. Conditional temporal discrimination improves the spatial plausibility and temporal consistency of multistep predictions. A continuous-time refinement module combining continuous-time encoding with feature-wise linear modulation reconstructs intermediate states within each control period. Under an identical recurrent protocol, R-CGAN outperformed four baseline architectures, including the Fourier neural operator (FNO). Relative to FNO, the strongest baseline, it reduced mean absolute error and root mean square error by 9.5% and 9.1%, respectively. Over a 240-day recurrent forecast, structural similarity declined only from 0.9821 to 0.9781. At unsupervised within-period times, continuous-time refinement reduced mean absolute error and root mean square error by 31.8% and 35.4%, respectively, compared with linear interpolation. The model remained accurate for unseen anisotropy strengths, well configurations, well counts, and forecast horizons, and achieved an approximately 223.4-fold online inference speedup relative to finite-volume simulation. These results demonstrate an accurate and efficient surrogate for continuous-time reservoir-state prediction, supporting repeated-evaluation tasks such as history matching and production optimization.}
}
@article{WANG2026136695,
title = {Decoupled ammonia nitrogen and total nitrogen exports under hydroclimatic variability in an alpine headwater catchment of the central Qinghai-Tibet Plateau},
journal = {Journal of Hydrology},
volume = {681},
pages = {136695},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136695},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017920},
author = {Xueping Wang and Xiaolin Shui and Yujie Zhang and Xiaohong Zhao and Zhoufeng Wang and Bo Hu and Haixia Zhu},
keywords = {Nitrogen dynamics, Hydroclimatic factors, Sediment co-transport, Environmental effects, Qinghai-Tibet Plateau},
abstract = {As the “Asian Water Tower” with a fragile alpine ecosystem, nitrogen loading in the Qinghai-Tibet Plateau (QTP) is critical to the water security of the downstream Yangtze River. This study elucidated the spatiotemporal dynamics and potential factors of nitrogen export in the Tongtian River through long-term monitoring (2015–2024) and seasonal sampling, coupled with Optimal Parameters-based Geographical Detector (OPGD) analysis. The results revealed a distinct temporal decoupling between ammonia nitrogen (NH3-N) and total nitrogen (TN). TN concentration and flux exhibited a persistent upward trend (p < 0.001) over the decade·NH3-N concentration showed no significant trend (p > 0.05), whereas its flux exhibited a significant upward trend (p < 0.01), a signal captured only after controlling for intra-annual variability. TN concentrations were highest in the spring campaign (1.71 mg/L), while the NH3-N campaign mean was highest in summer (0.26 mg/L) and close to the autumn and winter means. OPGD identified cropland as the factor with the highest explanatory power for NH3-N concentration (q = 0.54) and pH as the primary explanatory factor for TN concentration (q = 0.53). Suspended sediment concentration had the highest explanatory power for NH3-N flux (q = 0.56), whereas TN flux was predominantly associated with pH and suspended sediment concentration (q = 0.74 and 0.71, p < 0.001). Interaction analysis further indicated joint associations of land-use, hydro-meteorological, and suspended sediment variables with temporal variability in nitrogen export. The contrasting nitrogen patterns may reflect differences in catchment inputs, hydrological transport, and temperature-dependent transformations. Therefore, management strategies must shift from passive concentration monitoring to actively decoupling anthropogenic practice from peak hydro-sedimentary windows.}
}
@article{XIE2026136704,
title = {Morphology-intensity relationships and long-term evolution of extreme precipitation over China based on an adaptive sector scanning algorithm},
journal = {Journal of Hydrology},
volume = {681},
pages = {136704},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136704},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018019},
author = {Zhangrui Xie and Jiejun Huang and Ximing Chen and Yaqi Sun and Han Zhou},
keywords = {Extreme precipitation, Spatial precipitation extent, Anisotropy ratio, Precipitation intensity, China},
abstract = {Understanding the spatial morphology of extreme precipitation is crucial for assessing hydrometeorological hazards. We developed an adaptive sector scanning algorithm within a semivariogram framework to characterize extreme precipitation across China using ERA5 daily precipitation data from 1950 to 2024. Extreme precipitation was identified using grid-specific 95th-percentile thresholds. Spatial Precipitation Extent (SPE) was defined as the area enclosed by eight corrected directional effective ranges, while the Anisotropy Ratio (AR) was defined as the ratio of the major to minor axes of a fitted ellipse. We examined the relationships among SPE, AR, precipitation intensity, and their long-term evolution. Results show that both SPE and mean precipitation intensity exhibit a pronounced southeast-to-northwest decreasing gradient across China. High AR values are primarily distributed along major mountain ranges, indicating a close spatial association between topography and the directional anisotropy of annual extreme precipitation. Mean precipitation intensity increases with SPE following a power-law relationship (R2 = 0.948, p < 0.05) but decreases with AR according to a power-law decay (R2 = 0.896, p < 0.05). From 1950 to 2024, SPE declined overall, while precipitation intensity decreased from the 1960 s to the early 1990 s and subsequently recovered in recent decades. Since the early 2000 s, the statistical dependence of precipitation intensity on SPE and AR has weakened. These findings advance understanding of the long-term evolution and spatial concentration of extreme precipitation and support the incorporation of spatial morphology into meteorological early warning and disaster risk reduction.}
}
@article{PAN2026136667,
title = {Enhancing lake dissolved oxygen retrieval by integrating process-based model with machine learning: maximizing the utility of multi-source monitoring data},
journal = {Journal of Hydrology},
volume = {681},
pages = {136667},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136667},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017646},
author = {Xuemei Pan and Qixin Lin and Gang Li and Xinfa Xu and Zhangjun Liu and Jingqiao Mao},
keywords = {Dissolved oxygen retrieval, Process-Based model, Machine learning, Data fusion, Poyang Lake},
abstract = {Dissolved oxygen (DO) is critical for lake ecosystem health. Although satellite remote sensing (RS) coupled with machine learning (ML) has emerged as an effective approach for DO monitoring, the stringent requirement for temporal synchronization between in-situ measurements and satellite overpasses often limits the availability of viable training samples. This scarcity significantly constrains both the retrieval accuracy and the generalizability of ML models. To address this issue, this study proposes a novel framework integrating a Process-Based (PB) model with ML algorithms for lake DO retrieval. Within this framework, the PB model assimilates multi-source data of diverse types and varying frequencies to generate high-frequency simulated DO. These simulations serve as substitutes for in-situ measurements to augment “DO–surface reflectance” training pairs, thereby promoting the utilization of ground monitoring data and RS imagery to enhance ML model training. Taking Poyang Lake as a case study, we constructed ML training datasets by pairing RS surface reflectance with three distinct DO data configurations: in-situ measurements only, PB-simulated DO data only, and a hybrid of both. The retrieval performance of six ML algorithms was evaluated across these configurations using rigorous spatial and temporal cross-validation comprising 72 independent scenarios. Results indicate that the PB model achieves high-frequency DO simulations with satisfactory accuracy, with R2 ranging from 0.63 to 0.92 across seven stations. Furthermore, augmenting training samples with PB-simulated data significantly improved the retrieval performance across all ML models. Under the hybrid training sets configuration, the six ML models achieving a mean R2 of 0.40 across 21 spatial cross-validation scenarios and 0.52 across 3 temporal cross-validation scenarios, significantly outperforming traditional methods relying solely on limited in-situ measurements (mean R2 of 0.26 and 0.17, respectively). The proposed framework effectively fuses multi-source heterogeneous monitoring data and maximizes historical RS imagery usage, providing a novel technical pathway for high-precision water quality retrieval in inland lakes, especially under data-scarce conditions.}
}
@article{PU2026136691,
title = {From pollution-driven to process-regulated: A decade of ecological restoration reshapes CO2 fluxes in a heavily polluted urban stream},
journal = {Journal of Hydrology},
volume = {681},
pages = {136691},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136691},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017889},
author = {Yingxue Pu and Xiaofeng Wang and Yuewei Zhang and Yixin He and Tingting Liu and Shuangshuang Liu and Jilong Wang and Honglin Chen and Yuan Zeng and Zuolin Xiao},
keywords = {CO fluxes, Urban stream, Ecological restoration, Decade-long investigation, Water-quality improvement, Stage-dependent},
abstract = {Heavily polluted rivers are significant hotspots of CO2 emissions, yet how long-term ecological restoration alters these emissions and their biogeochemical drivers remain poorly understood. Here, we conducted a decade-long field investigation of CO2 concentrations and fluxes in a heavily polluted urban stream in Chongqing, China, spanning successive restoration periods: baseline polluted stage (2014), point-source wastewater interception stage (2018) and ecological restoration stage (2023). Integrating hydrochemical monitoring, machine-learning modeling, and a normalized mitigation-efficiency framework, we evaluated CO2 flux dynamics and underlying control mechanism shifts throughout long-term eco-restoration. Over the ten-year restoration period, dissolved CO2 concentrations and fluxes decreased by 76.0% and 72.4%, respectively, demonstrating substantial climate co-benefits alongside water-quality restoration. This reduction was primarily driven by substantial decreases in organic carbon and nutrient loads alongside improved dissolved oxygen and pH. Crucially, CO2 fluxes in this urban stream shifted from being driven by excessive organic carbon supply (carbon-overloaded regime in 2014) to pH and nitrogen constraints after wastewater interception (2018), and ultimately to phosphorus limitation and oxygen regulation following ecological restoration (2023). This result highlights that controlling mechanisms of urban stream CO2 emissions exhibit clear stage-dependent and shift from carbon-saturated, heterotrophic regime to nutrient-limited internal metabolism. Normalized mitigation-efficiency analyses further revealed that reductions in organic carbon and nitrogen yielded higher CO2 mitigation benefits per unit pollutant removed than phosphorus reduction. Although residual CO2 emissions remain higher than those in less disturbed rivers due to legacy effects from historical pollution, these findings demonstrate that restoration not only suppresses urban river CO2 emissions but also fundamentally restructures their biogeochemical controls from substrate-driven to process-regulated systems, providing a scientific basis for optimizing co-benefits of water quality and climate mitigation.}
}
@article{FAN2026136699,
title = {Seasonal and long-term aquifer deformation reveal groundwater stress and incomplete annual recovery in an arid oasis},
journal = {Journal of Hydrology},
volume = {681},
pages = {136699},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136699},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017968},
author = {Binbin Fan and Liang Zhan and Boris Gojenko and Xiaofei Ma and Guirong Li and Jie Bai and Xiuliang Yuan and Geping Luo},
keywords = {Time-series InSAR, Aquifer-system deformation, Groundwater stress, Land subsidence, Recovery-depletion imbalance, Arid piedmont oasis},
abstract = {Groundwater overexploitation in arid oasis basins commonly induces land subsidence and aquifer degradation, yet how seasonal and long-term aquifer deformation jointly reflect groundwater stress and incomplete annual recovery remains poorly constrained. Here, we integrate Sentinel-1 time-series Interferometric Synthetic Aperture Radar (InSAR) observations from 2017 to 2023 with Global Navigation Satellite System measurements and groundwater-level records to characterize aquifer deformation, assess coupling between groundwater fluctuations and deformation, and quantify deformation-defined annual imbalance in the Sangong River Watershed, Northwest China. Long-term subsidence is concentrated in the alluvial plain oasis, where cropland exhibits a mean subsidence rate of 27.3 mm/yr and local maxima of 114.4 mm/yr. Seasonal deformation is concentrated within a 164.85 km2 central deformation core, where the relative seasonal contribution decreases toward the funnel center as secular subsidence becomes dominant. Among the five observation wells, WL3 shows the clearest coupling between groundwater fluctuations and deformation, with a deformation rate of − 52.46 mm/yr, a seasonal deformation amplitude of 28.33 mm, and a cross-correlation peak at one Sentinel-1 acquisition step, indicating no lag resolvable beyond the sampling interval. At the funnel scale, deformation-defined annual cycles show persistent positive equivalent imbalance: equivalent recovery ranges from 3.14 to 6.14 million cubic meters (MCM), equivalent depletion from 9.93 to 13.76 MCM, and annual equivalent imbalance from 5.24 to 9.13 MCM, with a mean depletion-to-recovery ratio of 2.53. These results demonstrate the value of time-series InSAR for identifying mechanically consequential groundwater stress and diagnosing persistent annual imbalance in data-scarce arid piedmont oasis basins.}
}
@article{CAO2026136683,
title = {Adaptive symmetric projection lemmings algorithm for cascade reservoir power scheduling},
journal = {Journal of Hydrology},
volume = {681},
pages = {136683},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136683},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017804},
author = {Qingru Cao and Yonggang Wu and Yongqiang Wang and Xutong Sun and Li Sun},
keywords = {Cascade reservoir system, Power generation, Artificial lemmings algorithm, Symmetric projection optimizer, Constraint handle},
abstract = {Cascade reservoir scheduling problems are characterized by multiple constraints, high dimensionality, nonlinearity, and non-convexity. To improve solution efficiency while ensuring optimization quality, this study proposes an Adaptive Symmetric Projection Lemmings Algorithm (ASPLA). This algorithm improves upon the Artificial Lemmings Algorithm framework by introducing three key mechanisms. First, an adaptive operator selection strategy is incorporated to dynamically adjust the probability of selecting different search strategies throughout the optimization process. Second, a symmetric projection mechanism is used to enhance particle recognition of potentially feasible regions. Third, a feasibility repair strategy guided by Lagrangian gradient information is developed, which significantly strengthens the algorithm’s ability to satisfy critical reservoir operation constraints such as initial and terminal storage limits. The performance of ASPLA was systematically evaluated using the CEC2022 test suite and two classical cascade reservoir scheduling cases. Statistical analysis confirms the high efficiency and robustness of the ASPLA. And ASPLA is applied to the hydropower-oriented operation of four cascade reservoirs in the lower reaches of the Jinsha River. The results show that ASPLA achieves the highest average hydropower generation and lowest standard deviation among the comparison algorithms across all three scenarios. Further analysis of reservoir water levels, hydraulic heads, turbine discharges, spillage, and power outputs provides a physical interpretation of the optimized reservoir operation processes. Together with the comparative optimization results, these findings indicate that the proposed ASPLA can obtain physically reasonable and relatively high scheduling solutions for cascade reservoir systems under different hydrological conditions.}
}
@article{LIU2026136686,
title = {Hydrological forcing reshapes nitrogen partitioning under microplastic amendment in hyporheic zones},
journal = {Journal of Hydrology},
volume = {681},
pages = {136686},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136686},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601783X},
author = {Shiqi Liu and Zhenhua Yan and Tao Zhang and Xi Chen and Lan Ma and Yuqiong Yang and Ping Lu and Saiyu Yuan and Guanghua Lu},
keywords = {Hyporheic zone, Microplastics, Nitrogen partitioning, Drying-rewetting alternation, Hydraulic retention time, Nitrate reduction},
abstract = {Microplastics (MPs) are increasingly recognized as potential modifiers of nitrogen (N) cycling in aquatic sediments. Hyporheic zones (HZs), hotspots for riverine N transformation and important sinks for MPs, are exposed to dynamic hydrological forcing. However, how hydrological forcing structures N transformation responses in MP-amended HZs remains poorly understood. Here, we used field-collected sediments to simulate HZs and examined N transformation responses in sediments amended with conventional polyvinyl chloride (PVC) and biodegradable polylactic acid (PLA) MPs under contrasting drying-rewetting alternation (DWA) regimes and hydraulic retention time (HRT) levels. DWA enhanced sediment reoxygenation, weakened dissolved oxygen (DO) stratification, and altered putative nitrification-related taxa, enzyme-associated protein responses, and selected N-cycling functional genes in a polymer-specific manner. In PVC-amended HZs, DWA strengthened the coupling between nitrification-related responses and apparent nitrate reduction, whereas in PLA-amended HZs it promoted oxidative N transformation indicators but reduced apparent nitrate reduction, NO2− accumulation, and NH4+ accumulation. Longer HRT reduced DO availability and generally increased apparent NO3− reduction. In PVC-amended HZs, this was accompanied by greater NO2− and NH4+ accumulation. In PLA-amended HZs, higher dissolved organic carbon (DOC) availability and sustained low-DO conditions coincided with greater apparent NO3− reduction and stronger NO2− and NH4+ accumulation. Multivariate analyses identified DO-centered associations under DWA and PVC-HRT, whereas DOC-centered associations emerged under PLA-HRT. These findings show that hydrological regime and polymer identity jointly structure N transformation responses in MP-amended HZs, with distinct patterns associated with oxygen availability, carbon availability, and nitrate-derived N partitioning.}
}
@article{PRADHAN2026136708,
title = {Performance evaluation of urban stormwater drainage system using node-concentrated mesh in a coupled surface-drainage flow model},
journal = {Journal of Hydrology},
volume = {681},
pages = {136708},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136708},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018056},
author = {Pravas Ranjan Pradhan and N. {Nithila Devi} and B. Sridharan and Balaji Narasimhan and Jürgen Stamm and Soumendra Nath Kuiry},
keywords = {Urban flooding, Stormwater Drainage (SWD), 1D-2D coupled modelling, Surface-drainage interaction, Node-concentrated mesh, Integrated drainage efficiency index (IDEI)},
abstract = {Effective flood mitigation in urban areas requires efficient modelling tools to evaluate surface-drainage flow dynamics under various rainfall scenarios. Coupled one-dimensional-two-dimensional (1D-2D) models are increasingly used for Stormwater Drainage (SWD) design and performance evaluation. However, their city-scale application is constrained by high computational demands arising from fine-mesh requirements, ground elevation inconsistencies across models, and numerical instability, especially near flow interaction junctions. To address these challenges, the study introduces a structured framework to generate a node-concentrated mesh that explicitly uses the SWD network topology by selectively constraining and refining the mesh around drainage junctions where flow exchanges occur, rather than relying on conventional geometry-based refinement. This method provides two key advantages: (i) improves ground elevation consistency between surface terrain and drainage nodes at junctions while minimizing model coupling discrepancies, and (ii) optimizes the trade-off between computational cost and accuracy. The proposed approach is validated within a SWMM-MIKE + coupled 1D-2D modelling framework for historical flood events in a 27.8 km2 urban catchment in Chennai, India. Synthetic 2-, 5-, and 10-year design storms are then simulated to assess SWD performance. An Integrated Drainage Efficiency Index (IDEI) is introduced, based on spatially distributed reductions in simulated flood extent, area-weighted flood depth, and area-weighted duration, providing an interpretable index that evaluates the overall effectiveness of the SWD system in mitigating urban flooding under different rainfall conditions. Overall, the mesh-generating method and the modelling framework offer a practical tool for analysing large-scale urban floods, supporting more informed and resilient drainage planning in rapidly growing cities.}
}
@article{ZHANG2026136671,
title = {Biogeochemical controls on N2O emission factors across a river-estuary continuum: nonlinear nitrate dependence and an underrecognized role of phosphorus},
journal = {Journal of Hydrology},
volume = {681},
pages = {136671},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136671},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017683},
author = {Sibo Zhang and Lei Gu and Xinxiao Wu and Xiaokang Li and Chunming Li and Jie Zhang and Zhihao Xu and William H. McDowell and Xinghui Xia},
keywords = {Greenhouse gas, Nitrogen cycle, Microorganisms, Phosphorus, Land to ocean},
abstract = {The IPCC framework assigns the same default emission factor of 0.26% to the riverine and estuarine components of indirect N2O emissions, despite substantial biogeochemical variability within these aquatic systems. We examined EF5 along the Pearl River-estuary continuum during three seasonal sampling campaigns and evaluated its environmental predictors using machine learning, supplemented by winter N2O isotopocule and metagenomic analyses. Winter isotopocule-based estimates indicated that denitrification-related processes accounted for > 89% of N2O production. EF5, defined as the dissolved N2O-N:NO3–-N concentration ratio, ranged from 0.02% to 0.38% (median 0.06%), and nitrate emerged as its leading predictor. EF5 declined sharply with increasing nitrate at low concentrations but more gradually at higher concentrations. At higher nitrate concentrations, increasing N2O concentration evidently weakened the EF5 decline expected from denominator coupling alone. This concentration dependence helps explain the greater predictive contribution of nitrate in estuarine waters, where nitrate concentrations were lower. TP and TN:TP were also important EF5 predictors, with the TN:TP ratio exceeding the Redfield molar ratio of 16:1 in 99.1% of observations. Higher TP was associated with lower predicted EF5 and positively correlated with the relative abundances of genes involved not only in denitrification but also in nitrate assimilation and DNRA, suggesting greater potential for nitrate utilization through pathways that do not directly produce N2O. The positive TN:TP-EF5 relationship in riverine waters may partly reflect wastewater-related N:P imbalance and dissolved N2O inputs. A global compilation comprising 3,560 riverine and 254 estuarine observations revealed broadly comparable median EF5 values (0.08% and 0.11%, respectively) between these two systems, both below the IPCC default, but river-estuary contrasts varied with latitude. These findings support EF5 parameterizations incorporating nitrate concentration dependence and phosphorus-related nutrient conditions.}
}
@article{SUN2026136716,
title = {Decoupling extreme rainfall from isotopic depletion: Mechanistic controls on precipitation δ18O during Typhoon Haikui’s record-breaking event in southeastern China},
journal = {Journal of Hydrology},
volume = {681},
pages = {136716},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136716},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018135},
author = {Hezi Sun and Yunyue Yang and Xiuyang Jiang and Yi Wang and Yuehong Lin and Shuijing Zhai},
keywords = {δO, Typhoon Haikui, Moisture source, Amount effect, Weather system, Paleoclimate reconstruction},
abstract = {Precipitation stable isotopes (i.e., δ2H and δ18O) serve as powerful tracers for reconstructing historical typhoon activity, yet their interpretation requires a comprehensive mechanistic understanding of typhoon-induced isotopic fractionation processes. This study investigated the isotopic dynamics during Typhoon Haikui (2023) in Fuzhou, Southeast China, based on high-resolution sampling (1–3-hour intervals) and synoptic-scale meteorological analyses. Typhoon Haikui’s synergistic interaction with the western North Pacific subtropical high (WNPSH) established a persistent convergence zone of cold and warm-moist air within the outer spiral rainbands. This mesoscale system, further amplified by orographic funneling effects, produced an extreme precipitation event (389.2 mm cumulative, 80 mm h−1 peak). Stable isotope analyses identified a distinct two-stage evolution of δ18O: (1) A progressive decrease from − 1.60‰ to − 9.55‰ during the intensification stage, documenting increasing rainout effects in peripheral convective systems; (2) A sharp isotopic increase to − 5.19‰ concurrent with the typhoon dissipation and WNPSH breakdown, indicating moisture source transitions. Comparisons with 10 historical typhoons affecting Fuzhou (2013–2021) highlight Haikui’s anomalous isotopic signature, characterized by significantly higher values (weighted mean δ18O = − 7.3‰ versus − 13.2‰ to − 7.4‰ in historical records) despite record-breaking rainfall, deviating from the classical “amount effect”. This isotopic-rainfall decoupling originated from the unique outer rainband dynamics (>300 km from the center), which lacked prolonged cumulative convection, presenting a fundamental contrast to the low δ18O typically observed in typhoon spiral rainbands. Our results underscore the complexity of typhoon-related isotopic signals and emphasize the need to account for storm-relative position and synoptic-scale interactions in paleotempestological reconstructions.}
}
@article{CHEN2026136679,
title = {Phosphorus composition in urban estuarine sediments: similar spatial patterns, distinct seasonal drivers, transformation pathways and risks},
journal = {Journal of Hydrology},
volume = {681},
pages = {136679},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136679},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017762},
author = {Zhaoying Chen and Zhaokui Ni and Shuaishuai Zhou and Taotao Sun and Yue Wu and Yu Ma and Jixin Yang and Shuai Liu and Andrea Critto and Shengrui Wang},
keywords = {Estuarine sediments, Phosphorus composition, Influencing factor, Transformation pathway, Environmental risk},
abstract = {Estuaries are global biogeochemical hotspots threatened by phosphorus (P)-driven eutrophication. Although sediments serve as major P reservoirs, its molecular composition, influencing factors, transformation pathways, and environmental risks remain poorly understood. This study analyzed these aspects in the Shenzhen Estuary using 31P NMR, UV–Vis spectroscopy, EEM fluorescence, and microbial high-throughput sequencing. Results showed a consistent river-to-bay gradient, with the content of total P (TP), inorganic P (IP), Ortho–P, Mono–P (myo–IHP, scyllo–IHP, α–Gly, RNA–nmp), and Di–P (DNA–P) decreasing seaward, while the proportion of organic P (OP, 17.6 ± 7.3%) increased in both dry and wet periods. Despite similar spatial patterns, influencing factors, transformation pathways, and environmental risks differed markedly between seasons. Dry-period P components were primarily associated with microbial communities and organic matter (OM) properties, whereas wet-period patterns were closely related to OM properties and sources, as well as to microbial α-diversity. Spatially P transformation pathways were identified: river sediments favored OP mineralization (Mono–P/Di–P → Ortho–P), while bay sediments showed net assimilation (Ortho–P → Mono–P/Di–P) in the dry period; Ortho–P was converted to OP via biological uptake in the wet period. We developed a novel Phosphorus Environmental Risk Index (PERI) integrating P components and biotic/abiotic influencing factors. PERI values were significantly higher in river zones than bay regardless of season, and consistently higher in the wet period. These findings establish a framework for understanding sediment P dynamics and provide a risk–assessment tool for P management in estuaries.}
}
@article{LI2026136740,
title = {Hydrodynamic evolution and erosion dynamics in dispersive soil slopes under repeated rainfall},
journal = {Journal of Hydrology},
volume = {681},
pages = {136740},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136740},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018378},
author = {Xingyao Li and Henghui Fan and Jinghao Xu and Haoran Zhang},
keywords = {Dispersive soil, Repeated rainfall, Hydrodynamic response, Erosion modeling},
abstract = {The complicated coupling between soil dispersivity and erosion dynamics remains a blind spot in understanding slope erosion processes, particularly under cumulative rainfall events. This study investigated hydrodynamic behaviors and soil erosion rate responses of slopes with varying dispersivity under five consecutive rainfall events. Indoor simulated rainfall experiments were conducted in a soil flume (2.0 m × 1.0 m × 0.4 m) under a constant rainfall intensity of 60 mm·h−1, with five consecutive 40-min rainfall events separated by 48-h intervals, using Na2CO3-amended loess with Na2CO3 contents ranging from 0% to 0.20% under controlled laboratory conditions to regulate soil dispersivity levels from non-dispersive to dispersive. Results showed that soil dispersivity fundamentally altered the hydrodynamic characteristics. Flow velocity (V), Reynolds number (Re), Froude number (Fr), and stream power (ω) measured during the initial rainfall increased significantly with higher dispersivity, while the Darcy–Weisbach friction factor (f) decreased. Higher soil dispersivity promoted the evolution of flow conditions toward a supercritical regime. Soil dispersivity profoundly altered erosion patterns. Dispersive soils exhibited a slope-wide, early-onset erosion pattern, with soil erosion peaking during R1-R2. In contrast, non-dispersive soils displayed a toe-localized, delayed-onset erosion pattern, with major erosion occurring during R4-R5. The empirical Horton model (R2 = 0.80) and the non-linear erosion model (R2 = 0.88), both incorporating soil dispersivity, were developed. ANOVA confirmed that soil dispersivity was the primary factor controlling runoff (66.60%) and soil erosion (64.83%) variations. Early slope-wide modification is proposed for dispersive slopes, while terminal energy dissipation at the toe is recommended for non-dispersive slopes.}
}
@article{LI2026136724,
title = {Cropland and population exposure to extreme precipitation events in Central Asia under future climate change},
journal = {Journal of Hydrology},
volume = {681},
pages = {136724},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136724},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018214},
author = {Tao Li and Fengjiao Song and Andrée De Cock and Jiayu Bao and Philippe De Maeyer and Ting Wang and Diwen Dong and Ye Yuan and Xiaoran Huang and Tao Yu and Naibi Sulei and Anming Bao and Peter Goethals},
keywords = {Extreme precipitation events, Cropland andpopulationexposure, Central Asia, ISIMIP3b},
abstract = {Central Asia (CA) is experiencing rapid warming and an intensifying hydrological cycle, with important implications for extreme precipitation events (EPEs). However, future changes in cropland and population exposure to EPEs remain insufficiently quantified in this climate-sensitive dryland region. Here, we projected changes in EPE characteristics and associated cropland and population exposure across CA using daily precipitation simulations from five bias-adjusted ISIMIP3b global climate models under SSP1-2.6, SSP3-7.0, and SSP5-8.5. The historical period 1995–2014 was used as the reference, and future changes were assessed for 2021–2040, 2041–2060, 2061–2080, and 2081–2100. The results show increasing extreme precipitation amount, frequency, intensity, and spatial extent toward the end of the century, particularly under SSP5-8.5 and in high-mountain regions. Under SSP5-8.5, cropland exposure increases by 46.4% from 2021 to 2040 to 2081–2100, with cumulative exposure of approximately 190.7 ± 73.7 million km2-days during 2021–2100. Under SSP3-7.0, population exposure increases by 97.2% between the first and last future periods, with cumulative exposure reaching approximately 47.12 ± 18.8 billion person-days during 2021–2100. Exposure hotspots are mainly located in northern Kazakhstan and the tri-border region of Tajikistan, Kyrgyzstan, and Uzbekistan. Signed decomposition shows that climatic changes dominate most increases in cropland exposure, particularly under SSP3-7.0 and SSP5-8.5, whereas the drivers of population exposure vary strongly among socioeconomic pathways, with demographic changes either reinforcing or offsetting climate-driven exposure changes. These findings highlight increasing exposure of Central Asian populations and croplands to future extreme precipitation and suggest the importance of strengthened flood management, agricultural drainage, early-warning systems, and climate-resilient land-use planning.}
}
@article{GRAHAM2026136635,
title = {Effects of droughts and warm months on phosphorus and nitrogen concentrations in surface waters globally},
journal = {Journal of Hydrology},
volume = {681},
pages = {136635},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136635},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017324},
author = {Duncan J. Graham and Arthur H.W. Beusen and Marc F.P. Bierkens and Michelle T.H. {van Vliet}},
keywords = {Drought, Phosphorus, Nitrogen, Surface water},
abstract = {Phosphorus (P) and nitrogen (N) concentrations in surface waters are substantially affected by droughts and warm months. However, previous studies of phosphorus and nitrogen concentrations under these hydro-climatic extremes are limited to a small number of regions, mainly in parts of North America, Europe and Australia. Here we perform the first global-scale analysis of phosphorus and nitrogen concentrations in surface waters under droughts, warm months and compound drought-warm months for the period 1980–2010. To achieve this, we developed an approach to downscale existing simulation data of total phosphorus (TP) and total nitrogen (TN) concentrations from annual to monthly level with machine learning at 0.5 × 0.5 degree resolution. The results indicate generally mixed responses in phosphorus and nitrogen concentrations under drought, with some regions showing increases in the concentrations of phosphorus and nitrogen due to drought and others showing decreases. Additionally, the results show more consistent increases in phosphorus (P) concentrations during warm months (average change: +21%) and compound drought-warm months (average change: +10%), which was mainly attributed to less dilution during periods of low flow and high temperature. Furthermore, there is a general decrease in the N:P ratio observed globally during warm months (average change: −11%). The results from this study provide a broader understanding of the effects of droughts and warm months on phosphorus and nitrogen in surface waters compared to previous local-scale studies. Furthermore, the results highlight the significant changes in phosphorus and nitrogen ratios during droughts and warm months, which may significantly influence freshwater ecosystem health worldwide.}
}
@article{YUAN2026136687,
title = {INFO-LAX: an interpretable and uncertainty-aware framework for monthly rainfall erosivity estimation},
journal = {Journal of Hydrology},
volume = {681},
pages = {136687},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136687},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017841},
author = {Jinhui Yuan and Yuefeng Lu and Zhengqi Song and Liguo Dong and Miao Lu and Weijun Zhao and Zhixiang Lu and Kun Liu},
keywords = {Rainfall erosivity, Monthly estimation, Hybrid machine learning, Extreme events, Prediction uncertainty},
abstract = {Rainfall erosivity (R factor) is a dynamic climatic driver of soil erosion, yet monthly estimation is complicated by nonlinear daily rainfall aggregation, strong upper tail behavior, and the limited interpretability and uncertainty characterization of many data driven models. We developed INFO-LAX as an integrated application framework combining two LSTM-Attention encoders, a low weight XGBoost correction branch, and the Weighted Mean of Vectors optimizer. Daily NOAA/NCEI observations from 25 stations across five climate geomorphic regions of China were converted to monthly predictors and daily data derived R factors. Only observed records were used and were partitioned chronologically into training (1975–2008), validation (2009–2014), testing (2015–2020), and temporal holdout (2021–2024) periods. On the independent test set, INFO-LAX achieved R2 = 0.8842, MAE = 95.837, and RMSE = 251.728 MJ·mm·ha−1·h−1, ranking first among RF, GPR, GAM, TFT, and TCN. End-to-end grouped Shapley analysis attributed 55.8% of model contribution to precipitation, followed by dew point (20.5%) and temperature (20.4%). The 95% prediction interval achieved PICP values of 0.952 and 0.978 on the test and temporal holdout sets, respectively. For test Q95 events, Tail MAE was 529.466 MJ·mm·ha−1·h−1 and recall was 0.843, although the peak magnitude ratio of 0.763 indicated conservative estimation of the largest events. INFO-LAX advances monthly R-factor estimation by integrating nonlinear daily-to-monthly representation, model-wide attribution, upper-tail evaluation, and calibrated uncertainty, supporting reconstruction, gap filling, risk assessment, near-real-time updating, and meteorological forcing for future soil erosion digital twins.}
}
@article{CHEN2026136727,
title = {A regime-specialized mixture-of-experts framework with event-driven case memory for daily multi-step streamflow forecasting},
journal = {Journal of Hydrology},
volume = {681},
pages = {136727},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136727},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601824X},
author = {Jiamu Chen and Jiahua Wei and Minglei Hou and Zhiming Zhang and Jinghao Zhang and Yanqing Shen},
keywords = {Streamflow forecasting, Mixture-of-Experts (MoE), Regime specialization, Case memory, CAMELS-US, Yellow River},
abstract = {Accurate daily streamflow forecasting is crucial for flood risk monitoring and water resources operation, yet remains challenging due to regime nonstationarity and the scarcity of extreme-high-flow samples. A regime-specialized mixture-of-experts framework (RS-MoE) is proposed, integrating quantile-based regime partitioning, regime-specific experts, and a sparse gating router for streamflow forecasting. An optional event-driven case-memory module (RS-MoE-Mem) is further introduced as a post-routing residual-amplitude correction layer for tail-regime robustness. The framework is first evaluated on four representative stations in the Upper Yellow River for configuration selection and mechanism validation, and is subsequently transferred to 576 CAMELS-US basins for cross-region transferability validation. In the Upper Yellow River, RS-MoE and RS-MoE-Mem improve cross-station mean NSE from 0.860 to 0.863-0.867, raise high-flow NSE from 0.500 to 0.559-0.588 (+11.8% to +17.6%), and reduce high-flow RMSE from 0.064 to 0.059-0.057 (7.8%-10.9%). Lead-time decay is also alleviated, with day-7 NSE increasing from 0.780 to 0.787-0.791. Across 1,728 basin–family pairs, RS–MoE and RS–MoE-Mem achieve statistically significant gains (p ≤ 0.002), raising overall NSE from 0.044 to 0.285–0.295 and high–flow NSE from −0.226 to 0.024–0.070. Relative to RS–MoE, RS–MoE–Mem further improves high–flow NSE by 0.046, reduces high–flow RMSE by ∼0.002, and increases high–flow KGE by 0.039 (all paired differences p < 0.001). Across the three expert families, memory enhancement also reduces peak absolute bias by 0.67–1.21 percentage points and event-volume absolute bias by 1.05–2.10 percentage points. These results extend prior hydrological MoE applications. Attribution analysis and gating-frequency heatmaps reveal that RS-MoE gains tend to be larger in basins with strong streamflow variability, pronounced event-pulse behavior, and sufficient room for improvement, while the routing pattern remains stable and regime-consistent. These results support the transferability and configuration robustness of RS-MoE across regions and expert families.}
}
@article{VALIMAKI2026136748,
title = {Bedload dynamics under river ice: Eulerian bedload flux from image-derived particle mass and large-scale particle image velocimetry},
journal = {Journal of Hydrology},
volume = {681},
pages = {136748},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136748},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018457},
author = {Juha-Matti Välimäki and Tuure Takala and Eliisa Lotsari},
keywords = {Bedload transport rate, Image velocimetry, Subarctic river, Sediment transport, ADCP},
abstract = {Bedload transport rate describes the amount of sediment moving within the active layer of a riverbed over time. Traditional mechanical sampling methods are labor-intensive, provide limited spatial and temporal resolution, and may introduce substantial uncertainty by disturbing local hydraulic conditions. Although computer vision-based image velocimetry methods have shown promise for quantifying bedload transport from video data, their use in ice-covered field conditions remains largely unexplored. This study aimed to (i) quantify bedload transport rate and the particle size distribution of the moving sediment and (ii) characterize the pulsating behavior and spatial variability of bedload transport under ice-covered conditions. Bedload velocity was estimated using a background subtraction algorithm combined with Large-Scale Particle Image Velocimetry (LSPIV) applied to videos recorded with an action camera (GoPro HERO10 Black) during a midwinter 2024 field campaign in a subarctic river. Reference bedload transport was measured using a Helley-Smith pressure-difference sampler, while reference velocity data were collected with an Acoustic Doppler Current Profiler (ADCP) and an Acoustic Doppler Velocimeter (ADV). The uncertainty of the measurements was estimated using Monte Carlo simulation. The results indicate that image-based measurements are a promising tool for providing temporally and spatially high-resolution insights into sediment transport processes in challenging field conditions in ice-covered rivers. Compared with pressure-difference samplers and an ADCP, the method yielded consistent estimates of both bedload transport rate and bedload velocity.}
}
@article{WANG2026136712,
title = {HydroFlow: A robust and lightweight network for river surface velocimetry on edge devices via semi-supervised learning},
journal = {Journal of Hydrology},
volume = {681},
pages = {136712},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136712},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018093},
author = {Jicheng Wang and Hongliang Wang and Xiaoting Guo and Yayu Liang and Yuxuan Liao},
keywords = {River surface velocity, HydroFlow, Optical flow, Semi-supervised learning},
abstract = {Unmanned Aerial Vehicle (UAV)-based image velocimetry is a key advancement in hydrological monitoring, offering non-contact measurement and high spatiotemporal resolution. However, deploying existing deep learning optical flow algorithms in real-world field conditions faces two main challenges: the trade-off between accuracy and efficiency, and the “synthetic-to-real” domain shift. High-precision models like RAFT are computationally intensive, hindering real-time performance on resource-constrained edge devices, and are vulnerable to environmental disturbances such as glare and shadows. To address these challenges, this paper proposes HydroFlow, a lightweight, interference-robust optical flow network tailored for edge computing. Based on the NeuFlow V2 architecture, HydroFlow integrates enhancement modules: Efficient Channel Attention (ECA) and Convolutional Block Attention Module (CBAM) to prioritize water motion features, while the Texture-Gated Correlation (TGC) module and Confidence-aware Residual Update (CRU) mechanism reduce outliers caused by noise. Additionally, a RealFlow-EM-based semi-supervised strategy is used to generate confidence-filtered pseudo-labels for unlabeled real-river imagery, thereby supporting synthetic-to-real adaptation without requiring dense optical-flow annotations. Experimental results show that HydroFlow achieves a model-only inference speed of 34 FPS on the NVIDIA Jetson AGX Orin, with MAPE values of 8.32% and 8.40% under challenging shadow and glare conditions, respectively, outperforming the comparison methods. This work provides an efficient and robust candidate network for future real-time edge deployment in river-velocity monitoring under complex environmental conditions.}
}
@article{WANG2026136720,
title = {Incorporating physical guidance into deep learning through hard constraints for water transport modeling in unsaturated zone},
journal = {Journal of Hydrology},
volume = {681},
pages = {136720},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136720},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018172},
author = {Yi Wang and Zhitong Ma and Wenke Wang},
keywords = {Unsaturated zone, Hydrological modeling, Seepage, Deep learning, Physics-informed neural networks},
abstract = {Water transport in the unsaturated zone is a key component of the hydrological cycle, and its accurate modeling is essential for water resources assessment and regulation. Physics-driven models require accurate soil hydraulic properties and fine discretization, whereas data-driven models may lack physical consistency and reliable extrapolation capability. Physics-informed neural networks (PINNs) incorporate governing equation residuals into the loss function, but soft constraints may inadequately enforce initial and boundary conditions and complicate optimization through competing loss terms. This study proposes a hard-constrained physics-informed neural network (HPINN) to address these limitations. The Richards equation is retained as a residual constraint, while transformation functions embed initial and boundary conditions directly into the network output, ensuring that these conditions are satisfied by construction. Numerical experiments spanning soil types, boundary conditions, and layered heterogeneous profiles evaluated predictions of matric potential, soil water content, hydraulic properties, and water fluxes. HPINN outperformed a standard deep neural network and PINN in predictive accuracy and physical consistency. Field validation under the investigated lysimeter conditions showed improved performance at unobserved times and depths, during heavy rainfall events, and under sparse observations. Reconstructed field-scale water fluxes characterized water transport processes and provided insights into the underlying hydrological mechanisms. By embedding physical knowledge as hard constraints, this study integrates data-driven and physics-driven modeling, providing a framework for simulating unsaturated zone water transport and advancing hybrid hydrological modeling.}
}
@article{LI2026136728,
title = {Unsupervised transfer learning for cross-condition pipe burst localization in long-distance water conveyance systems},
journal = {Journal of Hydrology},
volume = {681},
pages = {136728},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136728},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018251},
author = {Pengyu Li and Xiaodong Yu and Xingping Jiao and Jie Zhang},
keywords = {Long-distance water conveyance system, Pipe burst localization, Unsupervised transfer learning, Domain adaptation, 1D-CNN},
abstract = {Concealed small-orifice pipe bursts in buried long-distance water conveyance pipelines are difficult to localize accurately and promptly and can cause sustained water losses and increased risks to water-supply security. Labeled records of real bursts are scarce, and variations in operating conditions can alter the propagation and statistical characteristics of water-hammer transient responses, causing source-domain localization models to degrade when applied to unlabeled target conditions. This study develops an unsupervised domain adaptation framework for cross-condition pipe burst localization. Source- and target-domain multi-channel water-hammer transient datasets are generated using the Method of Characteristics, and localization is formulated as a multi-task problem involving segment classification, within-segment offset regression, and leakage-ratio prediction. A one-dimensional convolutional neural network (1D-CNN) is first trained as the source-domain backbone and then adapted to the target domain by combining domain-specific batch normalization, adversarial feature alignment, and segment-level pseudo-label constraints. These components address shallow statistical shifts, high-level feature-distribution discrepancies, and weak target-domain segment discrimination, respectively. The framework is evaluated using a long-distance water conveyance project in Xinjiang, China. Without using ground-truth target-domain labels during training, it reduces the target-domain global localization mean absolute error from 1013.77 m under direct transfer to 128.51 m. The results indicate that the proposed method improves pipe burst localization under unlabeled cross-condition scenarios, with potential benefits for rapid field inspection, water-loss reduction, and reliable operation of long-distance water conveyance systems.}
}
@article{ARAVENA2026136752,
title = {Groundwater-lake interactions in a high-altitude terminal lake: uncertainty, hydrogeological constraint and climate change},
journal = {Journal of Hydrology},
volume = {681},
pages = {136752},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136752},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018494},
author = {Joaquín Aravena and Francisca Aguirre-Correa and Alberto {de la Fuente} and Carolina V. Giraldo and Amanda Peña-Echeverría and Pedro Bonacic-Vera and Sarah Leray and Francisco Suárez},
keywords = {Groundwater-surface water interaction, Water balance, Uncertainty analysis, Quantile Regression Forest (QRF), Climate change, Chilean Andean Plateau},
abstract = {In endorheic basins of the Andean Plateau, shallow lakes are influenced by groundwater-surface water exchange, which regulates water availability in these fragile terminal wetland ecosystems. However, quantifying lakebed exchange (Qlb) remains challenging because of difficult access, limited data availability and uncertainty in the dominant water-balance terms. Here, we evaluate groundwater-lake interactions in the terminal lake of the pristine Salar del Huasco basin by reconstructing the long-term monthly lake water balance for 1987–2019 using multiple data sources for precipitation, evaporation, spring inflow, lake area, and bathymetry. This approach generated 600 plausible realizations of Qlb, which was inferred as the residual required to close the monthly water balance. After applying a hydrogeological consistency constraint based on piezometric observations, 222 realizations were selected and the median Qlb ensemble was 21 l/s, indicating a tendency toward groundwater inflow to the lake. Sensitivity analyses across alternative piezometric-classification and the hydrogeological consistency filter thresholds retained a positive ensemble median, while the estimated magnitude remained threshold-dependent. Across the ensemble, evaporation and spring inflow were the dominant sources of uncertainty, whereas precipitation, lake-area detection, and bathymetry played secondary roles. The hydrogeologically plausible subset was then used to train a probabilistic Quantile Regression Forest model forced with bias-corrected CMIP6 projections. Future simulations under SSP2-4.5 and SSP5-8.5 indicate progressive weakening of net groundwater inflow and a transition toward near-neutral or intermittently lake-to-aquifer exchange under SSP5-8.5, and a reduction in lake area by 20–40% at the end of the century. Sensitivity experiments further show that projected lake persistence is strongly conditional on spring-flow persistence and on whether future predictor states remain within the historical QRF training domain. Overall, this study provides a framework for evaluating groundwater-lake interactions and the hydrological vulnerability of remote high-altitude wetlands while explicitly accounting for uncertainty.}
}
@article{ZHANG2026136694,
title = {Irrigation water abstraction as a hidden amplifier of river pollution: observation-based empirical evidence from a dual-river system in central China},
journal = {Journal of Hydrology},
volume = {681},
pages = {136694},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136694},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017919},
author = {Guoshuai Zhang and Peng Zhang and Min Xu and Yanxue Xu and Yue Zhao},
keywords = {Irrigation water abstraction, Dilution capacity, Amplification factor, Observation-based framework, Concentration–discharge relationships, Yiluo River Basin},
abstract = {Irrigation abstraction reduces dilution capacity for loads entering below an offtake. In China’s Yiluo River Basin, we quantified this loss using the Amplification Factor (AF), the ratio of no-diversion to residual discharge, computed from measured river and diversion discharges without hydrological modeling. AF equals a concentration ratio only for a fixed load entering below the offtake and not removed by diversion; it does not by itself estimate actual concentration change. Irrigation-season AF averaged 2.33 (Yi River) and 2.53 (Luo River), with single-day maxima of 12.6 and 11.9. Concentration responses were assessed using evidence not algebraically derived from AF. On irrigation-season dry days, the NH3-N coefficient was positive under all seven seasonal specifications (temperature-adjusted primary model: β = +0.115 per unit log(Qdiv + 1), p = 0.016) but weakened under calendar-based controls (p = 0.06–0.21), so we regard it as supportive rather than confirmatory evidence; residual seasonal confounding cannot be excluded. Absolute specific conductance was positively associated with abstraction (p = 0.0024–0.0042), whereas the downstream/upstream ratio was not significant (p = 0.119); these results are consistent with dilution-capacity loss but do not independently validate the mechanism. The Yi River, with concentrated abstraction, is least affected by known return-flow pathways; the Luo River is a composite multi-diversion system. Assumed gauging errors yielded AF uncertainty of ±11–12%, excluding structural and scenario uncertainty. Lagging diversion discharge by 1–3 days changed irrigation-season mean AF by less than 3%, whereas daily AF differed by more than 10% on 12–39% of days.}
}
@article{MENG2026136690,
title = {Long-horizon cascade reservoir scheduling with a multiscale constraint-consistent hybrid transformer},
journal = {Journal of Hydrology},
volume = {681},
pages = {136690},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136690},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017877},
author = {Changqing Meng and Chunzhe Wang and Yanke Zhang and Yuankun Wang and Chao Wang and Guoyong Zhang and Yongqiang Wang},
keywords = {Cascade reservoir scheduling, Constraint embedding, Physical constraint integration, Long-horizon scheduling, Deep learning, Hydropower scheduling},
abstract = {Long-horizon cascade reservoir scheduling is challenging because annual release trajectories must satisfy hydraulic consistency and operating constraints across strongly coupled reservoirs, while repeated deterministic optimization is computationally expensive. This study develops a Multiscale Constraint-Consistent Hybrid Transformer (MCC-HT), in which hydraulic consistency is embedded during trajectory generation and reservoir-level operating requirements are further reconciled through an Iterative Cumulative Rebalancing (ICR) mechanism. The framework was evaluated for the lower Jinsha River–Three Gorges six-reservoir cascade using a 64-year ten-day inflow record (1959–2022) under a deterministic hindcast setting, with comparisons against the Progressive Optimality Algorithm (POA), Particle Swarm Optimization, and two ablation variants. Over the 2015–2022 test period, MCC-HT generated annual schedules that remained consistent with the prescribed operating requirements, while reducing the average runtime for full annual schedule generation from 664.55 s for POA to 2.79 s. Under this substantial computational reduction, MCC-HT approximated the annual generation achieved by POA, with a mean difference of +0.12% that varied with hydrological conditions across individual years. Ablation results further indicate that embedded constraint handling contributes more consistently across hydrological conditions, whereas the benefit of multiscale inflow representation is more condition-dependent. These results show that structural embedding of physical constraints can support efficient and physically admissible long-horizon cascade scheduling, providing a practical basis for repeated annual scenario evaluation in strongly coupled hydro-systems.}
}
@article{DONG2026136743,
title = {A process-based hydrological connectivity index for human-altered river networks},
journal = {Journal of Hydrology},
volume = {681},
pages = {136743},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136743},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018408},
author = {Yue-yang Dong and Yuan-yuan Liu and Zu-lin Hua and Peng Wang and Xiang Zhu and Shengnan Zhu and Shou Wang and Na Liu},
keywords = {Functional hydrological connectivity, River network structure, Human disturbance, Random Forest},
abstract = {Hydrological connectivity is essential for watershed functioning and water management, yet conventional metrics often emphasize static structure and fail to represent functional connectivity under dynamic hydrological processes and human disturbance. To address this limitation, this study developed a process-based Hydrological Connectivity Index (HCI) that integrates runoff generation potential and transport resistance to quantify functional hydrological connectivity in human-altered river networks. Using the Qinhuai River Basin in eastern China as a case study, HCI was evaluated across five historical scenarios, and its dominant controls were identified using random forest and SHAP analyses. HCI effectively reflected hydrological responses and revealed a divergence between functional and structural connectivity under long-term river network change. Connectivity exhibited clear temporal-stage and spatial shifts, with river network structure as the dominant control, followed by land use and rainfall-related conditions, while channel width was identified as a key individual factor. Spatial heterogeneity in driver effects further differentiated topology-driven, morphology-driven, and externally driven zones. Overall, HCI provides a process-responsive framework for assessing hydrological connectivity and supporting river restoration and adaptive water resources management in disturbed basins.}
}
