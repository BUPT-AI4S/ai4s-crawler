@article{ZHANG2026136710,
title = {Human proximity to rivers in China},
journal = {Journal of Hydrology},
volume = {681},
pages = {136710},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136710},
url = {https://www.sciencedirect.com/science/article/pii/S002216942601807X},
author = {Xuejing Zhang and Wenfang Cao and Dandan Zhao and Yanlong Guan and Pengfei Wang and Jeffrey J. McDonnell and Junguo Liu},
keywords = {Human–river proximity, Proximity to Rivers Index, Population distribution, Random Forest, Urbanization, China},
abstract = {River proximity shapes human settlement patterns and water resource dependence, yet the long-term changes of human–river proximity and their drivers remain poorly understood. Using high-resolution population data for ten reference years, we developed a Proximity to Rivers Index (PRI) to quantify changes in population-density gradients relative to major rivers across China from 1953 to 2020. Random Forest models and counterfactual scenarios were used to examine socio-economic and natural associations with PRI. Although China's population more than doubled, the median population–river distance remained close to 10 km. However, PRI became progressively more negative from 1953 to 2020, indicating strengthening population concentration near rivers without a substantial shift in the median population location. Basin-scale trajectories were heterogeneous: human–river proximity generally strengthened in northern basins, whereas several southern basins exhibited weakening or more complex trends. Socio-economic variables were more strongly associated with the long-term PRI change, particularly in northern basins, while natural variability was more closely related to fluctuations among reference years in several southern basins. Urbanization rate and GDP had the highest relative importance nationally. Urban settlements were consistently closer to rivers than rural settlements, whereas the relationship between per-capita GDP and river proximity varied among Eastern, Central, and Western China. These findings highlight the need for basin-specific management that coordinates urban development, river-corridor protection, water-resource allocation, and climate adaptation.}
}
@article{FRANCISCO2026136642,
title = {Streamflow prediction in natural ungauged catchments using Temporal Fusion Transformers},
journal = {Journal of Hydrology},
volume = {681},
pages = {136642},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136642},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017397},
author = {Rafael Francisco and José Pedro Matos},
keywords = {Streamflow prediction, Deep learning, Temporal Fusion Transformer (TFT), Ungauged catchments, Regionalization, Transfer learning},
abstract = {Streamflow prediction is essential for water resources management. Classical hydrological models struggle with predictive accuracy and probabilistic representation in ungauged catchments. Recent advances in deep learning have demonstrated notable improvements in reproducing complex time series, such as streamflow, with the Temporal Fusion Transformer (TFT) emerging as a promising model. This study explores the potential of TFTs to predict daily streamflow in natural ungauged catchments in Portugal. Streamflow data from 53 catchments were collected from the national database, while meteorological inputs (precipitation and temperature) were derived from the ERA5-Land reanalysis dataset. Geomorphological descriptors for each catchment were also included. Results are reported on 46 catchments after screening from the initial set based on objective hydrometric and natural-flow criteria and show strong predictive performance and spatial generalization under ungauged conditions. In the test subsets, TFT models in ungauged conditions outperformed the individually calibrated hydrological model Hydrologiska Byråns Vattenbalansavdelning (HBV), securing an advantage in terms of median NSE (increased from 0.46 to 0.50), median KGE (increased from 0.44 to 0.48) and median CRPS (decreased, which is desired, from 5.51 to 3.70 Ls−1km−2). Model specialization substantially improved performance, reaching a median NSE = 0.62, a median KGE = 0.65, and the median CRPS decreased to 3.20 Ls−1km−2, in selected test portions for this second task. Long Short-Term Memory (LSTM) models were also evaluated as a data-driven benchmark, with TFTs achieving competitive performance under ungauged conditions. Additionally, retraining experiments highlight the model’s adaptability, showing that local data, even if limited in number, can be instrumental in further improving predictions. These findings support the application of deep learning in operational settings, such as flood and drought risk management, and water allocation strategies in catchments without comprehensive measurements.}
}
@article{MA2026136715,
title = {Variations in energy and water vapor exchange in response to episodic droughts over a composite grain-grass ecosystem in the Loess Plateau, China},
journal = {Journal of Hydrology},
volume = {681},
pages = {136715},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136715},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018123},
author = {Jingyong Ma and Jingui Zhang and Qian Yang and Muhammad Hayat and Xianzhi Wang and Xingfa Lai and Yan Zhang and Yuying Shen},
keywords = {Energyexchange, Episodic drought, Composite grain-grass ecosystem, Loess Plateau, Eddy covariance},
abstract = {Drought is anticipated to be more extreme and frequent in the future, profoundly affecting terrestrial ecosystems’ energy and water vapor exchange. Therefore, investigating the dynamics of energy and water vapor exchange with drought is crucial for predicting the future carbon and water cycle dynamics in these ecosystems. This study examined the seasonal and interannual variations in energy and water vapor exchange of a typical rainfed composite grain-grass ecosystem using eddy-covariance measurements made over a two-year period (2020–2021). The measurement period covers episodic drought events (i.e., spring and summer). Results showed that the partitioning of net radiation (Rn) between latent (LE) and sensible heat (H) fluxes had a major impact on the climate and hydrology. LE was the predominant consumer of Rn during the growing season, with H surpassing LE during the non-growing season when precipitation was scarce. The energy exchange was characterized by low Bowen ratios (β=H/LE; 0.83 and 0.90 for the two years), low H/Rn (0.20 and 0.18), and high LE/Rn (0.39 and 0.41), with mean values of 0.87, 0.19, and 0.40, respectively, over the study period. Drought in various periods can influence energy partitioning in ecosystems in diverse ways; for example, a spring drought reduced LE/Rn while boosting H/Rn. Summer drought raised H/Rn but had no discernible effect on LE/Rn. Seasonal variations in evaporative fraction (EF) were strongly correlated with soil volumetric water content at 10-cm depth (VWC_10), water vapor pressure deficit (VPD), normalized difference vegetation index (NDVI), and bulk surface conductance (gs). High VPD directly increased EF, although this was buffered by a concomitant suppression of gs. Overall, NDVI exerted the greatest total effect on EF, while gs​ showed the strongest direct effect. These findings demonstrate the importance of drought timing and physiological regulation in influencing ecosystem energy and water vapor exchange, and suggest that an escalation in summer drought under future climate change scenarios with invariable or even enhanced EF may reduce groundwater replenishment and lead to a warmer and drier summer climate shortly on the Loess Plateau.}
}
@article{ZHOU2026136626,
title = {Fate and retention mechanisms of nitrate across the vadose–saturated continuum in a typical agricultural irrigation area of the North China Plain: evidence from hydrogeochemistry and microbiome analyses},
journal = {Journal of Hydrology},
volume = {681},
pages = {136626},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136626},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017233},
author = {Gongyu Zhou and Kehan Yuan and Chengyi Zu and Ruihua Shang and Xiaoyang Liu and Liuzhu Chen and Lili Liang and Teng Ma},
keywords = {Nitratepersistence, Vadose–saturated continuum, Deep nitrate storage, Nitrogen-cycling functional potential, Irrigated agricultural region},
abstract = {Thick vadose zones are widely regarded as buffers against agricultural nitrate leaching, yet nitrate-enriched groundwater remains common beneath intensively irrigated regions. Sediment retention can delay nitrate migration, whereas effective attenuation largely depends on microbially mediated transformation and the electron-donor conditions required to sustain it. How these coupled processes govern nitrate fate across the vadose–saturated continuum remains poorly understood. We integrated groundwater hydrochemistry, multi-borehole sediment profiles, 16S rRNA and metagenomic analyses, and a laboratory sediment incubation experiment at a representative site in the North China Plain. Groundwater nitrate enrichment co-occurred with strongly heterogeneous sediment nitrate pools, with generally higher KCl-extractable than water-extractable concentrations, showing that deep storage did not provide uniform protection of the aquifer. Microbial community composition varied among samples, while the LC02 metagenomic gene catalog contained nitrate-reduction and DNRA-related genes together with components spanning all four denitrification steps at all four sampled depths. The summed abundance of non-overlapping nitrogen-cycle categories reached 8.70% of total metagenomic gene abundance at 50.1 m, where nirK, nirS, norB, norC, and nosZ reached their highest abundances among the four sampled depths. Laboratory sediment incubations showed carbon-source-dependent nitrate removal and nitrite accumulation, consistent with differences in the balance between nitrate reduction and subsequent nitrite consumption. Together, these findings suggest that nitrate persistence across the thick vadose–saturated continuum reflects the coupling of heterogeneous deep storage, hydrological transport, and spatially distributed microbial transformation potential. This integrated mechanism helps explain the coexistence of persistent nitrate enrichment and a substantial nitrogen-cycling gene reservoir and provides scientific evidence for groundwater vulnerability assessment in intensively irrigated agricultural regions.}
}
@article{LI2026136739,
title = {Tidal-creek topography regulates storm-driven sediment redistribution and geomorphic change on a macrotidal flat},
journal = {Journal of Hydrology},
volume = {681},
pages = {136739},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136739},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018366},
author = {Renzhi Li and Haifei Yang and Chao Gao and Bixuan Tang and Jingdong Chen and Ya Ping Wang},
keywords = {Tidal flat, Suspended sediment transport, Topographic control, Wind-wave forcing},
abstract = {Tidal creeks route water and sediment across intertidal flats, yet how their topography organizes sediment redistribution during strong winds remains poorly understood. This study combined month-long measurements of waves, near-bed currents, and suspended sediment concentration (SSC) at a creek margin and an adjacent open flat with repeated topographic surveys on a macrotidal mudflat in Jiangsu, China. Strong-wind tidal cycles exhibited stronger wave forcing, higher SSC, and a weaker negative SSC–drag relationship than non-event cycles of comparable tidal range. Under strong-wind forcing, distinct along-creek and cross-creek responses emerged once sediment was mobilized. At the RD1 station along the creek margin, cross-creek ebb velocity remained lower during the below-bank stage, while elevated ebb-phase SSC enhanced the along-creek transport index despite comparable along-creek velocities between conditions. Over the 12-h integration windows, these responses yielded stronger ebb-directed along-creek and net landward cross-creek tendencies in the near-bed transport indices. Repeated profile measurements provided complementary evidence of spatially uneven bed adjustment, including concentrated creek-margin reworking and patchy inner-flat elevation gains, while surface samples collected between strong wind events showed localized coarsening and improved sorting. Together, these findings suggest that creek topography and changing water levels shape the pathways of wave-mobilized sediment during strong winds, helping explain spatially uneven geomorphic adjustment within tidal flat-creek systems.}
}
@article{HAGHGOU2026136702,
title = {A probabilistic framework for modeling compound flooding hazard in coastal-inland transition zones},
journal = {Journal of Hydrology},
volume = {681},
pages = {136702},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136702},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017993},
author = {Hossein Haghgou and Dingbao Wang and Norberto C. Nadal-Caraballo and Zhen Hu and Guirong Yan},
keywords = {Compound flooding, Flood hazard curves, Copula functions, Dependency, Monte Carlo simulations, Surrogate model, St. Johns River},
abstract = {Compound flooding arises from the simultaneous or successive occurrence of multiple flood drivers, such as heavy rainfall, extreme river discharge, sea-level rise, high tides, storm surge, and wave action. While flood hazard curves (FHCs) in distinct coastal and inland zones are typically well defined, with specific flood drivers dominating each zone, the FHCs in coastal-inland transition or compound flood zones are more complex due to the combined effects of multiple drivers. The dependency between coastal and inland flood drivers complicates the development of FHCs for compound flood zones. The objective of this study is to develop a probabilistic framework for constructing reliable coastal-inland flood hazard curves (CIFHCs) for compound flood-prone areas, even under sparse data conditions, by explicitly modeling the statistical dependency between coastal and inland drivers using bivariate copula functions. A compound zone along the St. Johns River in eastern Florida is examined to illustrate and demonstrate the proposed probabilistic framework. The resulting CIFHCs closely match those derived from observations, with an average deviation of approximately 10%, which reflects the consistency of the framework. This coupled framework is further applied to investigate how potential changes in the probability distributions of coastal and inland flood drivers, and their statistical dependency, influence hazards in compound flood zones. This type of analysis is essential for low-lying coastal communities, as it supports flood risk-reduction decision-making that accounts for the nonstationarity of climate and compound flooding hazard.}
}
@article{LIANG2026136723,
title = {Effects of a shallow landslide on headwater storage and drainage functions: a comparison of subsurface saturation before and after a 2016 landslide in northeastern Taiwan},
journal = {Journal of Hydrology},
volume = {681},
pages = {136723},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136723},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018202},
author = {Wei-Li Liang},
keywords = {Landslide hydrology, Pore water pressure, Saturation frequency, Soil–bedrock interface},
abstract = {Shallow landslides reshape the surfaces of headwater catchments, yet their hydrological effects are generally interpreted based on observations of shallow soil layers rather than the soil–bedrock interface. To our knowledge, no continuous record at this interface has spanned a complete natural shallow landslide event at the same site. This study compared subsurface saturation before and after a typhoon-induced shallow landslide in a steep forested headwater catchment in northeastern Taiwan. Pore water pressure (ψ) at the soil–bedrock interface was monitored at 60 points at 10-min resolution for > 2-year periods before and after the landslide. Saturation frequency classification, join count statistics, event-based saturation analysis, and recession-rate analysis were conducted. After the landslide, the number of perennially saturated points increased from 18 to 23, and the saturated zone expanded within the landslide area. Saturated points were spatially clustered in both periods, and the clustering extended to a larger spatial scale after the landslide. However, the mean ψ of the most frequently saturated group decreased from 27.0 to 18.5 cmH2O, and in perennially saturated groups the maximum saturation amount per point decreased. Median recession rates increased by 0.68 and 0.93 cmH2O/day in the intermediate- and high-pressure zones, respectively. Site-scale relationships between rainfall and saturation appeared unchanged, because opposing changes inside and outside the landslide boundary offset each other. These changes plausibly reflected subsurface loosening and fissuring, as inferred from changes in soil depths and surface displacement. Thus, the saturated zone expanded but weakened. Both the storage and regulation functions at the soil–bedrock interface declined, whereas lower and shorter-lived pore water pressures suggest hydrologic conditions that were less favorable for renewed failure.}
}
@article{SBARBATI2026136747,
title = {Investigating subirrigation, seasonal variability and hydrogeological control in a salinized shallow aquifer-aquitard system},
journal = {Journal of Hydrology},
volume = {681},
pages = {136747},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136747},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018445},
author = {Chiara Sbarbati and Mattia Gaiolini and Abram Ofori and Micòl Mastrocicco and Massimo Marchesi and Vincenzo Piscopo and Nicolò Colombani},
keywords = {Groundwater salinization, Subirrigation, Hydrogeochemistry, Peat-rich sediments, Stable isotopes},
abstract = {This study investigates the seasonal hydrogeochemical evolution and persistent hydrogeological controls in a salinized shallow aquifer-aquitard system located in a reclaimed coastal lowland. The study focuses on two adjacent agricultural field plots with contrasting hydrostratigraphic settings. Major ions, stable isotopes, and redox-sensitive species were integrated to identify the processes controlling groundwater composition and their seasonal evolution. The key findings include: (i) groundwater salinization primarily reflects inherited paleo-marine salinity preserved within low-permeability Holocene sediments; (ii) subirrigation produces a temporary and spatially variable dilution of groundwater, without substantially altering the composition of the saline groundwater end member or causing systematic mobilization of dissolved trace elements, indicating that the effects of subirrigation are largely transient; (iii) the deep saline groundwater component is controlled by processes operating over timescales much longer than the seasonal recharge cycle. Persistent reducing conditions within the peat-rich groundwater domain promote ammonium accumulation, while sulphur isotope compositions suggest differences in sulphur cycling between the two groundwater domains, reflecting differences in groundwater evolution under reducing conditions. Methane isotope data are consistent with microbially produced methane in the deeper peat-rich sequence. The results show that the hydrogeochemistry of the aquifer-aquitard system is governed by the interaction between inherited salinity, peat-rich sediments and redox-driven biogeochemical processes. These processes must be considered, for example, when attempting to mitigate the salinization of this aquifer-aquitard system through subirrigation practices; moreover, the findings here identified can be transferred to similar alluvial deltaic environments around the world.}
}
@article{AUBRYWAKE2026136606,
title = {Climate-driven shift from glacial to pluvial groundwater contributions in a central Nepal Himalayan catchment},
journal = {Journal of Hydrology},
volume = {681},
pages = {136606},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136606},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017038},
author = {Caroline Aubry-Wake and Philip Kraaijenbrink and Walter Immerzeel},
abstract = {Mountain river systems integrate water from rainfall, seasonal snowmelt, and glacier melt, yet most hydrological models mix these sources with flow pathways, limiting the ability to diagnose how climate-driven changes propagate through surface and subsurface stores. Here we extend the SPHY model with a source-explicit groundwater framework that preserves the climatic origin of water through subsurface storage, allowing groundwater recharge and discharge to be attributed to rainfall, seasonal snowmelt, and glacier melt. The model is evaluated against observations from 2014 to 2024 in the glacierized Langshisha Basin in the Nepal Himalaya and subsequently forced with bias-corrected ISIMIP3b climate projections under three SSP scenarios through 2099. Across all scenarios, annual discharge changes modestly (−10 to − 24% by 2099), but its composition shifts almost completely. Glacier melt, which currently supplies ∼ 41% of streamflow, declines to 13–16% by late century, and glacier-derived groundwater falls from ∼ 18% to 6–7%. Rainfall becomes the dominant water source, increasing from ∼ 31% today to 65–74% in 2090–2099. Despite this major shift in water sources, total groundwater discharge remains comparatively stable because declining glacier-derived recharge is increasingly replaced by rainfall-derived recharge. Under strong warming (SSP5-8.5), the basin shifts from a melt-supported July peak to an autumn, rainfall-dominated regime. By preserving source identity through subsurface storage and discharge, the framework reveals a transition from glacier-supported to rainfall-supported groundwater that is obscured when groundwater is represented solely as baseflow, providing a clearer diagnosis of how mountain water supplies respond to climate change.}
}
@article{ZHANG2026136682,
title = {Constraint-driven generation of virtual urban drainage networks for refined urban inundation simulation},
journal = {Journal of Hydrology},
volume = {681},
pages = {136682},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136682},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017798},
author = {Zihao Zhang and Yan Gao and Quan Yuan and Xiaohan Li and Yuchao Jiang and Le Sun},
keywords = {Urban inundation, Virtual drainage network, Constraint-driven, 1D–2D coupled hydrodynamic model, Edge betweenness centrality, Flood simulation},
abstract = {Detailed drainage-network data are often unavailable in data-scarce cities, limiting refined urban inundation modeling. This study proposes a constraint-driven method for generating virtual urban drainage networks for one-dimensional and two-dimensional (1D–2D) coupled hydrodynamic simulation. The method extracts an equal-density network skeleton from urban roads, routes pipe elevations under minimum-cover and maximum-excavation-depth constraints, and assigns hierarchical pipe diameters using empirical quantiles of edge betweenness centrality. The framework was evaluated on Xiaohengqin Island, China, using SWMM–LISFLOOD-FP and an extreme rainfall event induced by Typhoon Yangliu in 2025. The generated network achieved a spatial topological matching F1 score of 0.8812 against the surveyed drainage network, and 87.41% of matched pipe segments had relative diameter errors within 50%. The proposed model also reproduced the distribution of 13 recorded inundation locations. Using the surveyed-network simulation as an independent hydrodynamic reference, the virtual-network simulation achieved a critical success index of 0.670 and an F1 score of 0.803 for inundation extent across 120,976 valid road-corridor cells. The RMSE and MAE of maximum water depth were 0.073 and 0.046 m, respectively, with a squared Pearson correlation coefficient (R2) of 0.811. At six locations with observed maximum depths, the RMSE was 2.15 cm and Pearson’s r was 0.981 (R2 = 0.962). Overall, the method provides an engineering-constrained drainage-network representation suitable for event-scale urban inundation modeling where detailed network data are unavailable.}
}
@article{REITZ2026136711,
title = {Quantifying and interpreting annual and daily slopes between actual and potential evapotranspiration by land cover type},
journal = {Journal of Hydrology},
volume = {681},
pages = {136711},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136711},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018081},
author = {Meredith Reitz},
keywords = {Evapotranspiration, Potential evapotranspiration, Reference evapotranspiration, Transpiration, Plant physiology, Complementary theory},
abstract = {In the water cycle, the lion’s share of precipitation transforms into evapotranspiration (ET), which is the water converted to water vapor through evaporation and plant transpiration. Potential evapotranspiration (PET) characterizes the atmospheric demand for water. Both ET and PET are driven to first order by radiative forcing, but the manner and extent to which ET and PET affect each other is unclear. Many hydrologic models assume that a rise in PET induces a rise in ET, whereas in complementary theory a rise in PET is caused by a decrease in ET. Here we use data from the conterminous U.S. to test the competing conceptual frameworks for the relationship between ET and PET by partially controlling for the influence of radiative forcing. We observe negative correlations between annual ET and PET, consistent with the feedback described by complementary theory. At the daily timescale, we observe the sign and magnitude of the slope between ET and PET to vary with time of year and landscape type, with values that are not well explained by either theory. The varying slopes are consistent with observed differences in vegetation response to atmospheric demand, and may indicate that plants have adapted to their typical water availability conditions with varying transpiration responses to PET. The results indicate an opportunity to improve the accuracy of current methods of estimating ET from PET by including these dynamics.}
}
@article{WEI2026136719,
title = {Hydrologic transition pathways shape microbial nitrogen cycling and N2O emissions under saltwater intrusion in coastal riparian soils},
journal = {Journal of Hydrology},
volume = {681},
pages = {136719},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136719},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426018160},
author = {Qi Wei and Qi Wei and Junzeng Xu and Zhiheng Huang and Xue Zhou and Peng Chen and Yilina Wu and Jinran Wu and Ziwei Li and Zhiming Qi},
keywords = {Hydrologic transition pathways, Microbial nitrogen cycling, NO emissions, Saltwater intrusion, Coastal critical zone},
abstract = {Hydrologic transitions in coastal riparian zones alter soil moisture and solute redistribution, thereby coupling water dynamics with nitrogen cycling. However, how transition direction interacts with saltwater intrusion to regulate N2O emissions remains unclear. This study examined the response of soil N2O emissions, microbial nitrogen-cycling functional genes, and functional microbial communities to the interactive effects of water level changes and salinity. To this end, an indoor soil-column experiment was established with two water-level transition regimes―a regime of non-flooding transitioning through intermittent flooding to continuous flooding (WD), and the reverse regime (WF)―and five salinity levels (0, 2, 5, 10, and 20 g L−1). N2O emissions showed clear differences in peak timing, peak intensity, and cumulative emissions between the two regimes. Under WD, emission peaks occurred during the early non-flooding stage, and low-to-moderate salinity enhanced N2O emissions, reaching 74.6 μg m-2h−1 under treatment with 5 g L−1 on day 1, whereas high salinity (20 g L−1) suppressed emissions. Under WF, emission peaks were delayed until drainage and drying ensued, and were lower in intensity. Water-level transitions shaped the succession of nitrogen-cycling functional genes in soil microbiota: WD favoured the enrichment of denitrification-related nirK and nosZ, whereas WF maintained higher AOB-amoA abundance. Salinity selectively suppressed AOB-amoA and nirK communities, whereas nirS and nosZ communities showed stronger halotolerance. Changes in functional microbial community composition, particularly those involving Pseudomonas, Halomonas, and Paracoccus, may be associated with N2O emission responses to water-level transitions and salinity changes. Structural equation modeling identified significant direct associations between the abundances of nitrogen cycling functional genes and N2O fluxes under WF, whereas the corresponding paths under WD were not significant. These results identify hydrologic transition trajectories as a key control on the timing and microbial pathways of nitrogen cycling under salinization, advancing understanding of coupled hydrological-biogeochemical processes in coastal critical zones.}
}
@article{LIU2026136693,
title = {Sedimentary reorganization under sediment starvation and morphological restructuring in a human-modified mega-estuary},
journal = {Journal of Hydrology},
volume = {681},
pages = {136693},
year = {2026},
issn = {0022-1694},
doi = {https://doi.org/10.1016/j.jhydrol.2026.136693},
url = {https://www.sciencedirect.com/science/article/pii/S0022169426017907},
author = {Dezheng Liu and Ziyun Xu and Ruiqi Chen and Sihao Mo and Liangwen Jia and Eunji Byun and Yan Miao and Haotian Wu},
keywords = {Sediment starvation, Tdial range, Combine effect, Anthropogenic activities, Lingdingyang Bay, Mega-estuary},
abstract = {Estuaries worldwide are experiencing unprecedented anthropogenic pressures. However, the compound effects of sediment starvation and local morphological alterations on estuarine systems remain incompletely understood. The Lingdingyang Bay (LDB) of the Pearl River Estuary as a case study, this research integrates sedimentary records, long-term hydrological observations, and bathymetric data to reveal the estuarine response to multiple human stressors. Our findings indicate an abrupt and systemic shift in the estuarine hydrodynamic and sedimentary regime during the mid-1990 s. This shift was primarily driven by two concurrent factors: a ∼ 39% reduction in fluvial sediment supply due to upstream damming, which deprived the estuary of its natural sedimentary compensation, and high-intensity localized engineering (e.g., channel dredging and land reclamation). These morphological modifications leading to a persistent increase in the tidal range by over 30%. Driven by these combined impacts, the LDB underwent a source-sink reorganization, transitioning from a naturally efficient sediment sink to a human-regulated state characterized by internal erosion and localized deposition. The sustained increase in coarse-grained fractions and high-energy geochemical indicators in sedimentary records further reflects enhanced sediment reworking and bed-material winnowing. This study provides a observational framework for understanding how the coupled impacts of sediment starvation and localized morphological changes drive persistent shifts in highly modified mega-estuaries.}
}