@article{DUTTA2026115094,
title = {A deck of cards-based co-constructive approach for modeling higher-order uncertainty in fuzzy decision-making},
journal = {Applied Soft Computing},
volume = {196},
pages = {115094},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115094},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005429},
author = {Bapi Dutta and Diego García-Zamora and José {Rui Figueira} and Luis Martínez},
keywords = {Multiple criteria analysis, Fuzzy set, Interval type-2 fuzzy set, Co-constructive process, Decision-making, Deck of cards},
abstract = {Since its inception, fuzzy set theory has been widely used to model uncertainty and imprecision in decision-making. However, conventional fuzzy sets, often referred to as type-1 fuzzy sets (T1FSs), have limitations in capturing higher levels of uncertainty, particularly when decision-makers (DMs) express hesitation or ambiguity in membership degrees. To address this, interval type-2 fuzzy sets (IT2FSs) have been introduced by incorporating uncertainty in membership degree allocation, enhancing flexibility in modeling subjective judgments. Despite their advantages, existing IT2FS construction methods often lack active involvement from DMs, which limits the interpretability and effectiveness of decision models. This study proposes a novel socio-technical co-constructive approach for developing IT2FS models of linguistic terms by facilitating the active involvement of DMs in preference elicitation and applies it to multicriteria decision-making (MCDM) problems. Our method is structured in two phases. The first phase involves an interactive process between the DM and the analyst, in which a modified version of the deck of cards (DoC) method is proposed to construct T1FS membership functions on a ratio scale. We then extend this method to incorporate ambiguity in subjective judgments, resulting in an IT2FS model that better captures uncertainty in DMs’ linguistic assessments. The second phase formalizes the constructed IT2FS model for application in MCDM by defining a mathematical formalization of the fuzzy information, including aggregation rules and an admissible ordering principle. The proposed framework enhances both the reliability and effectiveness of fuzzy decision-making by capturing the personalized semantics of linguistic information. A numerical example and a practical case illustrate its real-world applicability.}
}
@article{SAEIDI2026115122,
title = {Unfolding graph convolutional networks: Architectures, use cases, and trends},
journal = {Applied Soft Computing},
volume = {196},
pages = {115122},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115122},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005703},
author = {Nematollah Saeidi and Vahid Hajipour and Siavash Hekmat and Bijan Shoushtarian},
keywords = {Graph neural network, Graph convolutional network, Deep learning, Relation modeling, Spectral GCNs, Spatial GCNs},
abstract = {This survey provides an in-depth, focused review of Graph Convolutional Networks (GCNs), addressing the current gap in literature for a comprehensive analysis of the latest GCN techniques. A key novelty of this work is the presentation of GCN integration across eight advanced deep learning paradigms: recurrent, attention-based, generative, wavelet, capsule, dynamic, self-supervised learning, and reinforcement learning networks. We systematically structure our analysis to first compare the fundamental spectral and spatial GCN methods, followed by a critical examination of architectural optimizations such as normalization and pooling. Our key insights from four aspects and 11 practical application domains, confirm a decisive shift from the computationally constrained spectral GCNs toward scalable and inductive spatial GCNs as the dominant approach. Furthermore, through the examination of nine challenging directions, the analysis highlights that future research is driven by a focus on enhancing model interpretability and tackling core challenges, including the over-smoothing problem in deep GCNs and the critical need for efficient dynamic GCNs. This work concludes by outlining promising future directions and practical applications, providing a clear roadmap for the next generation of graph-driven research in diverse domains such as communication networks, adversarial attacks, and medical image analysis.}
}
@article{ZELENYANSZKI2026115102,
title = {A graph neural network approach to cluster user behaviours in decentralized finance},
journal = {Applied Soft Computing},
volume = {196},
pages = {115102},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115102},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005508},
author = {Dorottya Zelenyanszki and Zhé Hóu and Kamanashis Biswas and Vallipuram Muthukkumarasamy},
keywords = {Blockchain, User behaviour, DeFi, Transaction analysis, Clustering, GNN},
abstract = {Decentralized Finance (DeFi) applications involve a large volume of funds and exhibit diverse user behaviours, including malicious activities such as smart contract exploits and financial scams. Existing approaches struggle to capture complex behaviours. To address this gap, we propose a general Blockchain User Behaviour Analysis (BUBA) pipeline for DeFi security. The pipeline presents an automated action formation process that takes blockchain transactions as inputs and outputs user actions. In addition, BUBA introduces a dual Graph Neural Network (GNN) model that jointly captures user action features, contract and token interactions, and heterogeneous graph structure information to produce rich behavioural embeddings, enabling effective clustering of semantically meaningful user behaviours. We evaluate the proposed pipeline on Uniswap V3, where it outperforms baseline methods in identifying and differentiating suspicious behaviours. A further case study on Sushiswap V2 demonstrates the generalisability of the pipeline across DeFi applications.}
}
@article{RAHIMI2026114953,
title = {Application of graph autoencoder in outlier detection},
journal = {Applied Soft Computing},
volume = {196},
pages = {114953},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114953},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004011},
author = {Niloofar Rahimi and Ramin Javadi},
keywords = {Autoencoder, Graph autoencoder, Outlier detection},
abstract = {Outlier detection is critical for improving data quality, model accuracy, and revealing rare or hidden patterns in various domains such as fraud detection and medical diagnostics. In this work, we propose a novel unsupervised outlier detection framework based on Graph Autoencoder (GAE) that captures both structural and relational aspects of data. Unlike traditional autoencoders, our method introduces a distance-based edge weighting matrix and a new outlier scoring formula, which significantly improve the identification of outliers embedded within dense clusters. We apply the OPTICS clustering algorithm to estimate local densities and distances, allowing the identification of initial probable outliers. The cleaned dataset is then fed into the GAE, where the matrix is propagated through a selected number of network layers to prevent excessive similarity with neighbors. Additionally, we optimize the bottleneck layer dimension and utilize the encoder’s output for enhanced detection beyond reconstruction error alone. Experimental results on ten benchmark datasets demonstrate that our approach outperforms classical and deep learning-based methods, achieving the highest AUC while maintaining reasonable execution time. Analyses reveal that clustering quality, loss function design, and bottleneck dimension critically affect performance. These findings highlight the framework’s effectiveness in detecting hard-to-identify anomalies and its potential impact across real-world applications. The method is evaluated on ten datasets from various domains, demonstrating superior performance compared to some classical and recent state-of-the-art methods, with notable improvements in recall and precision.}
}
@article{RAHMAT2026115098,
title = {Concatenated feature pyramid network for robust object detection in urban driving scenarios: A case study in Yogyakarta, Indonesia},
journal = {Applied Soft Computing},
volume = {196},
pages = {115098},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115098},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005466},
author = {Hanif Rahmat and  Suprapto and Moh Edi Wibowo},
keywords = {Object detection, Transformer, Feature pyramid network, Feature concatenation, Driving scenarios, Autonomous driving},
abstract = {Accurate object detection is crucial for intelligent transportation systems such as autonomous driving and advanced driver-assistance systems. This study aims to improve the detection performance of the Transformer-based object detector SAM-DETR to detect traffic-related objects in real-world driving scenarios in Yogyakarta. The improvement is achieved by incorporating multi-level features from Feature Pyramid Network (FPN), combining all levels of FPN outputs by spatially resizing them to the same size as the final level and then concatenating them along the channel dimension. The concatenated feature map is then transformed into a set of features, which serve as the input to the encoder layer. We refer to this feature concatenation method as Concatenated FPN (CatFPN). The experiments show that the proposed SAM-DETR CatFPN outperforms the original SAM-DETR on custom dataset, achieving improvements of 3.7% mAP, 4.7% mAP0.5, and 3.2% mAP0.75. Furthermore, the performance of the proposed method surpasses that of other DETR-like methods on COCO 2017 dataset, reaching the highest mAP of 34%. On small objects, the performance of the proposed method is comparable to that of Deformable DETR, with mAPS scores of 14.8% and 15%, respectively.}
}
@article{PAULBAL2026114891,
title = {D33D-Net: A robust dynamic deformable dual-pathway 3D deep neural network with embedded handcrafted features for liver tumor segmentation in CT images},
journal = {Applied Soft Computing},
volume = {196},
pages = {114891},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114891},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600339X},
author = {Nilima {Paul Bal} and Abhishek Bal and Anup Kumar Kolya and Siddhartha Bhattacharyya and Asif Ekbal and Punit Sharma},
keywords = {Liver tumor segmentation, Deep convolution neural network, Handcrafted features, Dual-pathway 3D CNN, Dynamic deformable, CT},
abstract = {This study presents a robust 3D liver tumor segmentation model that addresses the limitations of current approaches through advanced deep learning, overcoming challenges such as annotation imbalance, heterogeneous tumor morphology, and small lesion segmentation to enhance automation, accuracy, and clinical applicability. The proposed dynamic deformable dual-pathway 3D deep neural network (D33D-Net) integrates both deep feature representations and predefined handcrafted features to achieve improved performance. The constituent deformable convolutional layers adapt receptive fields to diverse tumor boundaries, enabling accurate delineation of irregular and complex shapes. The dual-pathway design processes local fine-grained features alongside global volumetric context from 3D patches, ensuring precise tumor localization even under low-contrast conditions. By unifying learned and handcrafted features, the proposed model enhances interpretability and generalization across heterogeneous datasets. Several benchmark datasets are thoroughly validated using clinically relevant measures such as volume overlap error (VOE), sensitivity, dice similarity coefficient (DSC), and relative volume difference (RVD). Parametric analyses, such as paired t-tests, variance analysis, confidence interval estimation, and one-way ANOVA with Tukey’s HSD, and non-parametric analyses, such as the Wilcoxon signed-rank test, Friedman test with Nemenyi correction, and bootstrap resampling, are conducted. These analyses demonstrate significant improvements over state-of-the-art models and confirm the robustness of the proposed model. The framework also demonstrates real-time efficiency in inference speed, latency, and memory usage. Case studies further validate its robustness in challenging clinical settings, underscoring its potential for diagnosis, treatment planning, and outcome monitoring. The Matlab code of the present work is publicly available at: https://github.com/abhi3550/Liver-Tumor-Segmentation.}
}
@article{ROY2026115090,
title = {Chaos-based noise mechanisms for enhanced differential privacy in deep learning},
journal = {Applied Soft Computing},
volume = {196},
pages = {115090},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115090},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005387},
author = {Animesh Roy and Lipi B. Mahanta},
keywords = {Differential privacy, Chaotic systems, Deep learning, Rényi differential privacy, Privacy-utility tradeoff, Membership inference attacks},
abstract = {Differential Privacy (DP) has become a keystone for safeguarding sensitive data during deep neural network training, yet conventional Gaussian noise often degrades utility and model performance. We propose a chaos-based DP training approach that combines Chaos-Gaussian noise injection and chaotic gradient descent to overcome this restriction. Within the Rényi Differential Privacy (RDP) framework, we derive a moment generating function (MGF) bound that confirms theoretical rigor and yields optimized chaotic parameters, reducing cumulative privacy loss by 75.3% compared to worst case settings. Extensive experiments on ImageNet-21k, CIFAR-10, CIFAR-100, and COVID-19 datasets demonstrate superior performance over standard DP-SGD and its recent variants. Our method achieves peak accuracies of 93.05% on ImageNet-21k (ϵ≥8), 89.21% on CIFAR-100, and 87.33% on COVID-19, consistently outperforming baselines across privacy budgets. We further provide a systematic threat analysis using Membership Inference Attack (MIA) curves for Logistic Regression and Random Forest classifiers, benchmarked against random guessing. Feature inversion-based attacks show that Structural Similarity Index Measure (SSIM) scores drop to 0.26 at ϵ=0.5, confirming strong resistance to memorization, while partial structural leakage persists at higher ϵ. Chaotic DP training achieves a robust balance between privacy and utility, making it particularly suitable for high stakes domains such as autonomous systems and healthcare.}
}
@article{WANG2026115130,
title = {Application of hybrid fuzzy graph neural network based on topology data analysis in node classification},
journal = {Applied Soft Computing},
volume = {196},
pages = {115130},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115130},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005788},
author = {Junkang Wang and Chunfeng Suo},
keywords = {Distance correlation coefficient, Hybrid fuzzy system, Topological data analysis, Hybrid fuzzy graph neural network},
abstract = {Graph neural networks (GNNs) have become a crucial paradigm for graph feature learning. However, GNNs still lack representational capability and interpretability. Thus, this study proposes a novel hybrid fuzzy graph neural network (HF-GNN), integrating hybrid fuzzy systems with GNNs effectively. Additionally, we incorporate a dynamic clustering method based on the distance correlation coefficient to process node data, thereby improving the efficiency of node data handling. Secondly, we provide a Gaussian mixture kernel for node-level feature fuzzification and establish a new type of fuzzy rule to address the redundant fuzzy rules in high-dimensional input data. Then, we design a mechanism for removing redundant fuzzy rules based on topological data analysis, which achieves the elimination of redundant and similar rules by quantifying the topological correlations between rules. Finally, we conduct node classification experiments on multiple datasets. The results demonstrate that HF-GNN outperforms existing GNNs in graph node classification tasks. Meanwhile, we also perform ablation experiments and parameter sensitivity analysis, which not only verify that each component of HF-GNN exhibits excellent robustness and universality, but also clarify the optimal adjustment range of key parameters in the model.}
}
@article{KAMAL2026114948,
title = {Neutrosophic fuzzy goal programming for optimizing shipment frequency and costs in supply chains},
journal = {Applied Soft Computing},
volume = {196},
pages = {114948},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114948},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003960},
author = {Murshid Kamal and Srikant Gupta and Syed Aqib Jalil and Aquil Ahmed},
keywords = {Supply chain, Multi-objective programming, Neutrosophic fuzzy set, Fuzzy goal programming},
abstract = {Supply Chain design and optimization are critical components of strategic planning for manufacturing entities. Effective supply chain configurations enable companies to navigate challenges arising from material management, goods transportation, and product distribution, which are influential in optimizing costs, maximizing resource utilization, and managing uncertainties. Our study delves deep into the logistics intricacies by analyzing the correlation between shipment frequencies and associated costs. Notably, we discovered a direct relationship between shipping costs and the frequency of shipments. Conversely, inventory costs decreased with an increase in shipment frequency but only up to a threshold of eight shipments, after which a marked rise was observed. One hypothesis is that smaller, more frequent shipments may optimize resource allocation, thereby curtailing inventory management costs. However, the benefits of this diminish after a certain frequency, likely due to complexities arising from handling a larger number of shipments. We introduce a novel solution methodology, the four-valued neutrosophic fuzzy goal programming technique (FVNFGPT), which exhibits a robust ability to balance both shipping and inventory costs. This methodology not only enhances the understanding of optimal supply chain design but also emphasizes the practical implications of effective decision-making in real-world scenarios. Additionally, our proposed technique, when contrasted with other methods like goal programming and fuzzy programming, demonstrated superior performance in balancing both shipping and inventory costs, highlighting its potential practical applications. The sensitivity analysis further emphasized the influence of demand changes on overall supply chain costs, underlining the imperative of accurate demand forecasting. As supply chain disruptions, even minor ones, can have a domino effect on overall functionality, the insights from this study provide invaluable guidance to industries, aiding them in making more informed decisions.}
}
@article{CHEN2026115041,
title = {SBGE-A: A self-boundary modeling and gene evolution-based anomaly detection approach for IIoT},
journal = {Applied Soft Computing},
volume = {196},
pages = {115041},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115041},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004898},
author = {Qiyu Chen and Yong Liu and Tao Yang and Hongli Deng and Dongmei Li and Jiangjin Gao},
keywords = {Industrial internet of things (IIoT), Anomaly detection, Artificial immune system (AIS), Gene evolution},
abstract = {With the development of the Industrial Internet of Things (IIoT), accurate anomaly detection is crucial for system security and stability. However, the massive high-dimensional discrete data generated by numerous IIoT devices challenges precise boundary delineation between normal and abnormal data. Traditional methods, with poor generalization and boundary characterization, struggle to construct precise sample contours in sparse spaces. This leads to models inadequately fitting the sample space distribution, creating numerous detection blind spots where abnormal samples cannot be effectively identified, resulting in severe underreporting. To address these issues, inspired by biological immune mechanisms, this paper proposes a novel IIoT anomaly immune detection method based on self-boundary modeling and gene evolution, termed SBGE-A. First, an immune antigen presentation method is proposed, which reconstructs the representation of original antigen samples (IIoT data) to present confounded self (normal behavior) and non-self (abnormal behavior) data in a new immune space (feature space). Then, an immune detector generation method based on self-boundary modeling is designed. This method delineates the self-boundary by clustering prior self-antigens, guiding immune detector generation. Finally, an evolutionary mechanism for immune detectors is designed, evaluating the detectors’ immune operating domain (detection scope), and extracting optimal detector genes (features) for cloning and mutation. This process optimizes the detector population for broader immune space coverage. Extensive experiments on datasets validate the effectiveness of SBGE-A. Notably, on real-world IIoT datasets (WADI, SWaT), SBGE-A achieves detection rates of 94.45% and 98.29% respectively, which improves detection rates by approximately 44.44% and 9.77% compared to advanced methods.}
}
@article{WANG2026115082,
title = {LumiCRS: Asymmetric contrastive prototype learning for long-tail conversational recommender systems},
journal = {Applied Soft Computing},
volume = {196},
pages = {115082},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115082},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005302},
author = {Jinzhi Wang and Bin Li and Qingke Peng and Haozhou Li and Zeyuan Zeng and Ruimeng Li and Kaixuan Yang and Jiangbo Zhang and Biyi Zhou and Yaoying Wang},
keywords = {Conversational recommender systems (CRS), Long-tail recommendation, Adaptive comprehensive focal loss (ACFL), Prototype learning, Mitigation of popularity bias},
abstract = {Conversational recommender systems (CRSs) often suffer from an extremely long-tail distribution of dialogue data, causing a strong bias toward head-frequency blockbusters that sacrifices diversity and exacerbates the cold-start problem. An empirical analysis of DCRS and statistics on the ReDial corpus shows that only 10% of head movies account for nearly half of all mentions, whereas about 70% of tail movies receive merely 26% of the attention. This imbalance gives rise to three critical challenges: head over-fitting, body representation drift, and tail sparsity. To address these issues, we propose LumiCRS, an end-to-end framework that mitigates long-tail imbalance through three mutually reinforcing layers: (i) an Adaptive Comprehensive Focal Loss (ACFL) that dynamically adjusts class weights and focusing factors to curb head over-fitting and reduce popularity bias; (ii) Prototype Learning for Long-Tail Recommendation, which selects semantic, affective, and contextual prototypes to guide clustering and stabilize body and tail representations; and (iii) a GPT-4o-driven prototype-guided dialogue augmentation module that automatically generates diverse long-tail conversational snippets to alleviate tail sparsity and distribution shift. Together, these strategies enable LumiCRS to markedly improve recommendation accuracy, diversity, and fairness: on the ReDial and INSPIRED benchmarks, LumiCRS boosts Recall@10 and Tail-Recall@10 by 7–15% over fifteen strong baselines, while human evaluations confirm superior fluency, informativeness, and long-tail relevance. These results demonstrate the effectiveness of multi-layer collaboration in building an efficient and fair long-tail conversational recommender.}
}
@article{ZHUANG2026115106,
title = {Dual-stage learning framework fusing semantics and physical knowledge for molecular property prediction},
journal = {Applied Soft Computing},
volume = {196},
pages = {115106},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115106},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005545},
author = {Luhe Zhuang and Yanshen Sun and Jun Zhao and Hong Wang},
keywords = {Molecular property prediction, Semantics and physical knowledge fusion, Retrieval-augmented generation, Multi-level contrastive learning, Dual-stage},
abstract = {Artificial intelligence-based molecular property prediction plays a crucial role in designing bioactive molecules and functional materials. However, current methods struggle with challenges such as insufficient semantic information, lack of physical knowledge integration, and a focus on single-level modeling that ignores the multi-level (atom, bond, substructure and molecule) characteristics of molecules. To address these issues, this study proposes MolFSPK, a Dual-Stage Learning Framework Fusing Semantic and Physical Knowledge for Molecular Property Prediction. It is distinguished by the three features. MolFSPK first employs the Retrieval-Augmented Generation (RAG) technique to ensure the precision and completeness of molecular semantic information, enhancing Large Language Models (LLMs) and mitigating issues such as hallucinations and outdated knowledge. MolFSPK introduces PhyCoder, a multi-level physics-inspired method for learning molecular representations. It integrates physical knowledge with multi-level information to enhance the understanding of molecular structures. Moreover, MolFSPK employs a multi-level contrastive learning framework to effectively capture hierarchical features of molecules, enhancing the model’s ability to learn more comprehensive molecular representations. Extensive experiments demonstrate that MolFSPK significantly outperforms current state-of-the-art methods in molecular property prediction, excelling in both classification and regression tasks.}
}
@article{YE2026115071,
title = {MVHGF: A multi-view hypergraph fusion framework for detecting phishing scams on Ethereum},
journal = {Applied Soft Computing},
volume = {196},
pages = {115071},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115071},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005193},
author = {Mingshun Ye and Dezhi Han and Mingdong Tang and Weili Chen and Kuan-Ching Li and Arcangelo Castiglione},
keywords = {Ethereum, Phishing scam, Hypergraph learning, Multi-view information fusion, Cryptocurrency security},
abstract = {The innovative smart contract mechanism underlying Ethereum has accelerated the growth of its ecosystem. However, the financial transaction characteristics of Ethereum have also facilitated illegal activities, such as phishing scams. These scams pose a serious threat to the security of the ecosystem. Current phishing scam detection methods on Ethereum rely on transaction network graph structures that struggle to capture the complex behavioral patterns of accounts, resulting in low detection efficiency. To address this challenge, this paper proposes a multi-view hypergraph fusion (MVHGF) framework designed to model the distinctive characteristics of Ethereum transaction networks. We design four hypergraph generation strategies from both local (account transaction behavior and transaction motif substructures) and global (transaction network topology and account attributes) perspectives, thereby modeling complex behavioral patterns. Subsequently, hypergraph convolutional neural networks are employed to learn a representation vector for each hypergraph. An adaptive integration mechanism is then used to fuse the multi-view representations, thereby integrating key features from different perspectives. Experimental results show that MVHGF significantly outperforms the single-view graph learning baseline TSGN, improving the AUC from 92.36% to 96.42% and the F1-score from 91.12% to 96.23%, demonstrating excellent detection accuracy and robustness. This work provides a novel approach to detecting phishing scam accounts on Ethereum by effectively fusing multi-view information.}
}
@article{WANG2026115087,
title = {Managing inconsistent assignments in linguistic multi-attribute decision making: A dynamic adaptive active learning approach},
journal = {Applied Soft Computing},
volume = {196},
pages = {115087},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115087},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005351},
author = {Yi Wang and Linyu Jin and Quanbo Zha},
keywords = {Personalized individual semantics, Active learning, Multi-attribute decision making},
abstract = {Existing data-driven preference learning methods primarily focus on consistent decision scenarios and typically require substantial training data. However, in linguistic multi-attribute decision making, decision makers often provide inconsistent assignments due to bounded rationality. To address this, we propose an active learning model for threshold-based linguistic ordinal classification capable of managing inconsistent feedback. Specifically, we integrate a dynamic adaptive weighting mechanism into the personalized individual semantics preference model. By tracking the consecutive classification errors of alternatives across iterations, this mechanism automatically adjusts the weights of assignment examples, progressively down-weighting conflicting data to extract the dominant preference structure from the consistent information subset. Additionally, four dynamic heuristic strategies are developed to guide the question selection process. These strategies utilize the updated preference parameters to quantify the classification uncertainty of unassigned alternatives, thereby efficiently refining the model with minimal inquiries. We conduct a case study using a car evaluation dataset to introduce the application of our model, and conduct some experiments to test the performance of our model in different situations.}
}
@article{WANG2026115059,
title = {Conformity interest-aware weighted HyperGraph neural network for session-based recommendation},
journal = {Applied Soft Computing},
volume = {196},
pages = {115059},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115059},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005077},
author = {Dongjing Wang and Zhanyang Hong and Yi Zhu and Xin Zhang and Na Li and Wenxiu Wang},
keywords = {Session-based recommendation, Hypergraph, Graph neural network, Conformity interest, Self-supervised learning, Attention mechanism},
abstract = {Understanding the complex motivations underlying user interactions is critical for session-based recommendation. Most existing studies mainly focus on mining user’s personalized interests and motivations from interaction sequences, often overlooking user’s conformity interests. It remains an important but challenging task to extract these interests from unlabeled data and capture behavioral motivations to improve interpretability. Therefore, we propose a novel approach, Conformity Interest-aware Weighted Hypergraph Neural Network (CWHNN), which jointly learns users’ personalized and conformity interests in a unified and adaptive manner for recommendation. Specifically, we first design Weighted Hypergraph Convolution Network (WHCN) that leverages the frequency distribution of items and the corresponding categories within session sequence to explore the latent motivation behind user interaction, thereby capturing both personalized and conformity interests. Next, we devise the Conformity Interest aware Feature Fusion Network (CIFN) to enhance the modeling of users’ long-term, short-term, and conformity interests, and to adaptively fuse these interests for recommendation. Furthermore, we incorporate a dual self-supervised learning (DSSL) module to further improve the representation learning of items and categories. Extensive experiments on four real-world datasets demonstrate that CWHNN consistently outperforms various state-of-the-art methods across different evaluation settings.}
}
@article{BI2026115111,
title = {A hybrid method based on linear regression and genetic programming-based symbolic regression for short-term load forecasting},
journal = {Applied Soft Computing},
volume = {196},
pages = {115111},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115111},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005594},
author = {Ying Bi and Mengying Guo and Quan Sui and Jing Liang and Kai Zhang and Ke Chen},
keywords = {Genetic programming, Symbolic regression, Linear regression, Short-term load forecasting, Hybrid method},
abstract = {Accurate short-term load forecasting (STLF) is critical for optimizing energy scheduling and ensuring grid stability, particularly in increasingly complex and volatile operational conditions. Existing methods often face challenges in interpretability, feature engineering and generalization. Traditional models lack transparency and fail to uncover the underlying drivers of load variation, while complex nonlinear models rely on numerous parameters, increasing overfitting risk and limiting practical applicability. To address these challenges, this paper presents a hybrid framework, LR-GPSR, which integrates linear regression (LR) with genetic programming-based symbolic regression (GPSR). This method first employs LR to generate initial load predictions and compute residuals, then applies GP to model these residuals, effectively capturing nonlinear patterns. In this study, LR-GPSR extends the basic arithmetic operators (addition, subtraction, and multiplication) used in SGP-1 by incorporating a logarithmic function, addressing the limited expressive capacity of the original set and providing sufficient representation for modeling residuals. Experimental results on multiple real-world datasets show that the logarithmic function improves the quality of individuals generated during population initialization, enhancing the overall initial population. Comparative experiments further demonstrate that LR-GPSR outperforms traditional methods under high-load conditions with pronounced nonlinear characteristics, validating its effectiveness and robustness, and highlighting its potential to improve STLF reliability and support intelligent grid management.}
}
@article{KOPPANATI2026115079,
title = {Defending AI/ML models against adversarial attacks with significant contextual features for better security},
journal = {Applied Soft Computing},
volume = {196},
pages = {115079},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115079},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005272},
author = {Rama Krishna Koppanati and Monika Santra and Sateesh Kumar Peddoju},
keywords = {Advanced static malware analysis, Adversarial attacks, Control flow graph, Deep neural network, Machine learning},
abstract = {Artificial Intelligence (AI) and Machine Learning (ML) models have become integral to modern malware detection systems due to their ability to identify complex patterns and detect previously unseen malware. However, these models are vulnerable to adversarial attacks, where malware developers reverse engineer benign binaries and inject malicious code into them, knowing that most detection models focus on the entire binary to extract features rather than on the regions of potential maliciousness. This obfuscation technique circumvents the malware detection models by deceiving the AI/ML classifiers due to the prevalence of benign features compared to malicious features. However, extracting the features from the potentially malicious regions avoids the adversarial attacks on AI/ML models. Hence, we propose a novel model that extracts features from the potentially malicious regions. It determines the potentially malicious nodes in the partially preprocessed Control Flow Graph (CFG) using the malicious strings provided by StringSifter. Then, it extracts contextual and significant features of the identified regions alongside the features from the completely preprocessed CFG. The experiments reveal that the proposed model requires fewer entries to save the features than the model focusing on the entire binary, reducing memory overhead, enabling faster computation, and lowering storage requirements. These features result in an 8.13% increase in SHapley Additive exPlanations (SHAP) Absolute Mean and a 1.44% increase in SHAP Beeswarm value compared to those extracted from the entire binary. Furthermore, these features outperform the features extracted from the entire binary by achieving more than 99% accuracy, precision, recall, AUC, F1-score, and a 0.064% FPR.}
}
@article{HE2026115048,
title = {Federated learning enhanced spatial and temporal attention mechanism for multivariate time series anomaly detection},
journal = {Applied Soft Computing},
volume = {196},
pages = {115048},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115048},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004965},
author = {Yue He and Weicheng Wang and Xiaoliang Chen and Duoqian Miao and Hongyun Zhang and Xiaolin Qin and Baiyang Chen and Peng Lu},
keywords = {Time series, Anomaly detection, Federated learning, Graph attention mechanism, Transformer},
abstract = {Industrial Internet of Things (IIoT) deployments generate high-dimensional multivariate time series (MTS) in which anomalies are rare yet safety-critical; however, privacy and governance constraints often restrict centralizing raw sensor streams, motivating decentralized anomaly detection for multivariate time series (ADMTS). We propose FL-STAM, a federated learning (FL) framework that detects anomalies by learning and contrasting spatial (cross-sensor) and temporal (within-window) association patterns while keeping data local. FL-STAM adopts a factorized design with two parallel complete graphs—a sensor-wise (serial-oriented) graph and a time-wise graph—and applies graph attention to capture global inter-sensor coupling and window-level temporal dynamics. The resulting representations are processed by a dual-branch Transformer that produces content-based spatial attention and a Gaussian-kernel temporal association (with a learnable bandwidth), enabling explicit association modeling under a temporal locality prior. Their discrepancy is quantified via a layer-aggregated symmetric Wasserstein distance and stabilized by an alternating minimize/maximize training schedule with stop-gradient to prevent degenerate solutions. Under Federated Averaging (FedAvg), clients exchange only model updates, so raw measurements remain on-device for privacy-aware deployment. Experiments on five public IIoT benchmarks against eight representative baselines, evaluated using Precision, Recall, and F1, show consistent improvements; FL-STAM attains a mean F1 of 96.82 across datasets.}
}
@article{SONG2026115072,
title = {Short-term traffic flow prediction with a dendritic neural network-enhanced time series decomposition framework},
journal = {Applied Soft Computing},
volume = {196},
pages = {115072},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115072},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600520X},
author = {Zhenyu Song and Shuangbao Song and Yajiao Tang and Shuangyu Song and Lixing Tan and Cheng Tang},
keywords = {Traffic flow, Dendritic neural network, Time series decomposition, Short-term prediction},
abstract = {Traffic flow prediction plays a critical role in intelligent transportation systems, helping alleviate congestion, increase efficiency, reduce environmental pollution, and decrease the incidence of traffic accidents. It is essential for urban management and planning scenarios. However, the traditional statistical methods and the existing machine learning models often neglect data preprocessing and computational efficiency. To address these challenges, we propose a novel traffic flow prediction framework, the TSDDNN, which integrates seasonal trend decomposition using locally weighted polynomial regression (STDL) with a dendritic neural network. The STDL method effectively decomposes time series data into seasonal, trend, and residual components. The TSDDNN framework provides a comprehensive scheme for predicting each of these components. Extensive experimental results, which are obtained based on four evaluation metrics, demonstrate that the proposed framework significantly outperforms the existing models in terms of prediction accuracy. Furthermore, nonparametric statistical tests confirm the robustness and effectiveness of the TSDDNN for traffic flow prediction tasks. This framework offers a promising and competitive approach, with potential applicability to other fields as well.}
}
@article{BALTES2026115093,
title = {A dual-actor proximal policy optimization algorithm for humanoid robot navigation control},
journal = {Applied Soft Computing},
volume = {196},
pages = {115093},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115093},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005417},
author = {Jacky Baltes and Ilham Akbar and Saeed Saeedvand},
keywords = {Deep reinforcement learning, Proximal policy optimization, Humanoid robotics, Dual-actor PPO},
abstract = {The complexity of humanoid robots necessitates the development of robust algorithms. This paper introduces a Dual-Actor Proximal Policy Optimization (DA-PPO) algorithm, a novel reinforcement learning approach designed to enhance humanoid robot navigation and movement capabilities in complex environments. By implementing a dual-actor system, DA-PPO shows a significant improvement in walking over obstacles and navigation tasks compared to state-of-the-art reinforcement learning algorithms such as Proximal Policy Optimization (PPO), Deep Deterministic Policy Gradient (DDPG), Soft Actor Critic (SAC), and Twin Delayed DDPG (TD3). Our experimental results, conducted in the Isaac Gym environment, demonstrate that our proposed DA-PPO excels in both flat and challenging terrain navigation in different walking scenarios. DA-PPO maintains an improvement of 77% over PPO on average and more than doubles the reward achieved by DDPG, TD3, and SAC. This research demonstrates the potential of DA-PPO in robotic applications, utilizing a popular existing humanoid robot platform, and highlights its adaptability and efficiency in controlling the complex walking of humanoid robots.}
}
@article{ZHAI2026115036,
title = {HaloSeg: Halo transformer embedding U-Net for local-global feature induced semantic segmentation of high-resolution remote sensing images},
journal = {Applied Soft Computing},
volume = {196},
pages = {115036},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115036},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004849},
author = {Han Zhai and Chengyu Zhang and Jun Yu},
keywords = {Semantic segmentation, Dual encoder, Multiscale halo transformer, Dual attention fusion module, Adaptive spatial structure mining module},
abstract = {Semantic segmentation of high-resolution remote sensing (HRRS) images has become a hot topic but with large difficulties owing to variable target scales, similar object interference, and partial occlusion. The remarkable successes of hybrid models of convolutional neural network and transformer indicate the necessity of integrating local contexts and global dependencies. However, insufficient mining and fusion of local and global features remain the main defects for current models. To address these issues, this study proposes a novel halo transformer embedding U-Net semantic segmentation model (HaloSeg). It constitutes a parallel dual-encoder architecture by coupling halo transform with residual network for global and local expression learning separately to avoid mutual interference in hierarchical feature extraction, with a shared decoder constructed for semantic prediction based on the fused features. First, an innovative halo transformer is constructed based on an improved multiscale halo self-attention to fully exploit distant dependencies within different enlarged receptive fields and adaptively fuse them to produce expressive global features. Second, a dual attention fusion (DAF) module is developed to further enhance global and local expressions and precisely fuse their complementarity to generate informative features for each layer, thus improving model discriminability. Third, an adaptive spatial structure mining (SSM) module is designed to learn multiscale and deformable expressions from primary convolutional feature to mitigate detail loss of high-level semantic features to promote more accurate semantic prediction. The experimental results on three public HRRS datasets demonstrate that HaloSeg significantly outperforms the other state-of-the-art models and is a promising tool for semantic segmentation.}
}
@article{LIU2026115097,
title = {A reinforcement learning-based approach for offline and online multi-line bus scheduling problem},
journal = {Applied Soft Computing},
volume = {196},
pages = {115097},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115097},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005454},
author = {Yingzhuo Liu and Weijun Luo and Shuodi Liu and Liuyu Xiang and Xiaotian Zhuang and Guobin Wu and Zhaofeng He},
keywords = {Multi-line bus scheduling, Offline scheduling, Online scheduling, Deep reinforcement learning},
abstract = {The Multiple Line Bus Scheduling Problem (MLBSP) plays a crucial role in reducing operational costs for bus companies while ensuring high-quality passenger service. Existing approaches typically generate a bus scheduling scheme offline and then schedule buses accordingly. However, in practice, uncertain events such as traffic congestion frequently occur, making pre-determined scheduling schemes infeasible. In this paper, we model the MLBSP as a Markov Decision Process (MDP) and propose a Reinforcement Learning-based Multi-line Bus Scheduling Approach (RL-MSA) for both offline and online scheduling. In the offline phase, deadhead decisions are integrated with the bus selection decisions to simplify the learning process. In the online phase, deadhead decisions are determined using a time window mechanism based on the offline-learned bus selection policy. We introduce several novel and informative state features for control points, bus lines, and buses. Additionally, we design a bus priority screening mechanism to construct bus-related features. To balance the interests of bus companies and passengers, we develop a reward function that combines final and step-wise rewards. Experimental results show that RL-MSA reduces the number of buses used in the offline phase compared with traditional optimization approaches. In the online phase, RL-MSA effectively handles uncertain events in most cases without a significant increase in the number of buses or with only a slight increase in deadhead time.}
}
@article{ADDAI2026115100,
title = {Content-adaptive multi-scale graph attention with lesion-focused pooling for multi-class brain tumor diagnosis},
journal = {Applied Soft Computing},
volume = {196},
pages = {115100},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115100},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600548X},
author = {Gyarteng E.S. Addai and Zhang XiaoLing and Chiagoziem C. Ukwuoma},
keywords = {Attention Mechanism, Brain tumor, Deep Learning, Multi-Scale Learning, Explainable Artificial Intelligence},
abstract = {Accurate MRI-based brain tumor classification remains challenging due to large inter-patient variability in tumor size and morphology, dilution of discriminative lesion cues by conventional global pooling, and evaluation unreliability from near-duplicate leakage and split sensitivity. This study aims to develop an interpretable and leakage-aware framework that improves multi-class brain tumor diagnosis under heterogeneous data conditions. We propose a content-adaptive multi-scale framework that combines a ResNet–FPN hierarchical encoder with Multi-Scale Contextual Attention (MSCA) refinement at each pyramid level, Scale-Graph Attention Fusion (SGAF) for explicit cross-scale interaction at each spatial location, and lesion-focused Top-K pooling to preserve the most discriminative tumor evidence. To ensure rigorous assessment, we adopt a leakage-aware protocol using MD5 and perceptual hashing (pHash) to prevent cross-split contamination. Experiments on three multi-source benchmark datasets (BT1–BT3) achieve accuracies of 99.15%, 98.70%, and 99.13%, respectively, and stratified 5-fold cross-validation indicates stable performance across folds. External evaluation on the independent BRISC benchmark yields 97.24% accuracy when trained on pooled data. Robustness analysis further shows non-catastrophic degradation under inference-time perturbations, with a maximum drop of about 4.31% points under severe noise. Computational profiling indicates practical feasibility for real-time inference, while multi-level explanations using attention visualization, embedding analysis, Grad-CAM, and LIME provide transparent decision support. These results indicate that the proposed framework offers accurate, robust, and interpretable brain tumor classification under a more reliability-oriented evaluation setting.}
}
@article{CUI2026115121,
title = {UAMF: A lightweight and powerful infrared small target detection model},
journal = {Applied Soft Computing},
volume = {196},
pages = {115121},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115121},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005697},
author = {Yibo Cui and Shangsheng Li and Xin Yang and Gang Wang and Yizheng Wang},
keywords = {Infrared small moving target detection, Adaptive memory fusion, Multiframe transformer, Lightweight model},
abstract = {Infrared small target detection remains a long-standing challenge in computer vision because of the extremely small size of targets, complex background noise, and the lack of distinctive texture features. In single-frame infrared imagery, small targets typically exhibit low energy and a poor signal-to-noise ratio (SNR), which further increases detection difficulty. To address these issues, we propose UAMF, an infrared small target detection model that incorporates an adaptive memory fusion mechanism. This design enhances the SNR of small targets by aggregating effective information across multiple consecutive frames. The proposed method achieves state-of-the-art performance while maintaining an exceptionally compact model size and the lowest computational complexity among comparable approaches. Experimental results on public datasets show that our method surpasses existing state-of-the-art techniques by 17.6% and 29.8% in IoU and nIoU on the IRDST dataset, and by 68.5% and 58.54% on the TSIRMT dataset, respectively. Notably, the model contains only 0.55M parameters, and its computational complexity is reduced by two orders of magnitude compared with previous SOTA models. Owing to its strong performance and lightweight architecture, UAMF demonstrates significant potential for deployment in embedded infrared systems and real-time infrared small target detection applications. The code will be publicly available at https://github.com/keacifer/UAMF.}
}
@article{QU2026115008,
title = {Spectral meta graph conventional recurrent network for traffic forecasting: Approach to alleviate graph distortions caused by delay propagation},
journal = {Applied Soft Computing},
volume = {196},
pages = {115008},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115008},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004564},
author = {Yuanhai Qu and Xingli Jia and Zhonghao Wang and Junheng Guo and Zhan Xiao},
keywords = {, , , },
abstract = {Traffic prediction is a critical component in the development of Intelligent Transportation Systems. Accurate forecasting of traffic conditions can significantly assist management authorities in formulating proactive strategies. Although contemporary spatio-temporal graph convolutional neural networks have achieved considerable success in traffic prediction tasks, existing approaches often assume instantaneous propagation of traffic flow or rely on delay compensation parameters to define node similarity. To address these limitations, this study first employs the Lighthill-Whitham-Richards model in conjunction with the Greenberg model to theoretically estimate the traffic delay parameter within a discrete state framework, thereby demonstrating the impracticality of predefined delay parameters. Subsequently, theoretical analysis reveals the delay mitigation properties inherent in the Fourier transform. Building on these insights, this paper introduces the SMGCRN model, which constructs temporal and spatial embeddings and formulates a spatial graph based on the spatial embedding. A compact meta-parameter pool is used to derive temporal and spatial meta-parameters. By integrating spatio-temporal information within the frequency domain, the model generates spatio-temporal meta-parameters and corresponding spatio-temporal graphs. Both the spatial and spatio-temporal graphs are then input into a GCRU for training. To facilitate model training, a curriculum learning strategy is adopted. Comparative experiments conducted on four benchmark datasets demonstrate that the proposed SMGCRN model achieves sota performance, thereby validating its effectiveness and superiority in traffic prediction tasks.}
}
@article{MANEVICH2026115089,
title = {Benchmarking the triple correction method and wavelet transforms in time series forecasting: Panacea or standard?},
journal = {Applied Soft Computing},
volume = {196},
pages = {115089},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115089},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005375},
author = {Vyacheslav Manevich and Dmitry I. Ignatov},
keywords = {Triple correction method, Wavelets, Time series forecasting, Exchange-traded assets, Cryptocurrencies},
abstract = {Accurate forecasting of financial time series across diverse asset classes remains a central challenge in quantitative finance. We benchmarked 200,000+ model configurations across 89 financial assets (including their realized volatility) using classical, machine learning, and neural network approaches, alongside our proposed TCM/CTCM methods. The key idea of the Triple Correction Method (TCM) is to use not only the minimization of the ordinary error terms per sample, but also to take into account past step deviation as well as changes between the consecutive forecast differences and the original value differences; the weights of these three components are dynamically updated when new samples come. The Corrected TCM (CTCM) relies on the multiplicative forecast correction based on the Mean Percentage Error (MPE). The impact of wavelet preprocessing was evaluated using Mean Absolute Percentage Error (MAPE), Mean Absolute Error (MAE), and Concordance metrics. For aggregating the performance quality of the models and building their leaderboard across the assets, wavelet types, and quality metrics, we applied a majority relation rule similar to the Copeland ranked-choice voting system from Social Choice theory. After extensive experimentation, validation (including statistical significance tests) and comparison, the results indicate that wavelet preprocessing improved models’ accuracy in 65+% of scenarios, while TCM/CTCM demonstrated remarkable stability and competitive performance across asset classes. Wavelets enhance advanced forecasting methods, but are not a universal panacea. Empirical results indicate that TCM/CTCM exhibit competitive accuracy with reduced computational overhead: 1) due to the absence of expensive hyperparameter optimization, and 2) as the experimental comparison confirms, TCM is effective even without L2-regularization prevalent in Statistical Learning.}
}
@article{CHEN2026115141,
title = {FREM-Net: A lightweight model for ship detection in complex backgrounds on ultra high resolution imagery via spectral awareness},
journal = {Applied Soft Computing},
volume = {196},
pages = {115141},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115141},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005892},
author = {Yantong Chen and Guanming Cheng and Na Lin and Ming Qu and Chengyong Shi and Mingchen Ge},
keywords = {Remote sensing, Ship detection, Frequency-domain enhancement, Lightweight network, Ultra high resolution},
abstract = {Ship detection in remote sensing imagery is vital for maritime traffic monitoring and ocean security. However, traditional high-resolution images have limited spatial resolution, where smaller vessels occupy few pixels or blend into the background, causing indistinct features and inaccurate detection. Ultra High Resolution (UHR) images improve target details and recognition, but their large pixel volume, dense ship distribution, and complex backgrounds still hinder accurate edge and detail extraction. Moreover, deploying high-performance detectors on resource-limited satellites remains challenging. To address this, we propose a lightweight ship-detection network that redefines the super-resolution module as a “frequency-domain enhancer” to reinforce ship edges and suppress background noise. A two-stage pruning strategy removes redundant residual blocks and sensitive channels while preserving key bands. In addition, a bandpass resonant filter bank on multi-scale wavelet sub-bands amplifies ship signatures and reduces interference. This improves recall and efficiency, particularly in cases with blurred edges. Experimental evaluations on three remote sensing ship datasets—Ship-UR, Aerial Vessels Detection Dataset, and HRSC2016—show that the proposed network achieves superior performance over state-of-the-art methods in addressing complex textures and frequency-domain aliasing. The results confirm the method’s effectiveness and robustness in resource-limited satellite environments.}
}
@article{SUN2026115085,
title = {Disentangling multi-modal fusion for financial distress prediction with multi-level attention mechanisms},
journal = {Applied Soft Computing},
volume = {196},
pages = {115085},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115085},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005338},
author = {Xusheng Sun and Li Zhou and Gang Wang and Xuan Zhang and Jingling Ma and Shanlin Yang},
keywords = {Financial distress prediction, Multi-modal fusion, Attention, Deep learning, Interpretability},
abstract = {Due to the instability of the world economy, financial distress prediction (FDP) remains a major concern for companies. Previous research has fused multi-modal data, including both financial data and textual disclosures, to predict financial distress. However, the multi-data in FDP is redundant: considerable features in the individual modality are irrelevant to FDP, and overlapping features between multi-modalities cause over-learning, obscuring financial distress patterns in the multi-modal fusion and rendering the predictive methods less effective. In view of this, we propose FTMA (Financial-level attention, Textual-level attention, and Modal-level Attention) to disentangle the multi-modal fusion into two stages, i.e., intra-modal and inter-modal fusion. In the intra-modal fusion stage, FTMA employs financial-level and textual-level attention to extract the relevant features from the individual modality. In the inter-modal fusion stage, FTMA further disentangles differences and commonalities from the obtained multi-modal features, to mitigate the effect of overlapping features. To test the superiority of the proposed FTMA, an empirical study is conducted on a real-world dataset, demonstrating that FTMA performs better than the benchmark methods. Our findings suggest that FTMA improves the accuracy and robustness of FDP and offers interpretable justifications for the stakeholders.}
}
@article{ABBASI2026115137,
title = {FAS-XAI-ZDA: Explainable deep neural networks for zero-day attack detection leveraging feature attention scores},
journal = {Applied Soft Computing},
volume = {196},
pages = {115137},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115137},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005855},
author = {Asima Akber Abbasi and Aneela Zameer and Muhammad Asif Zahoor Raja},
keywords = {Zero-day attack, Deep neural networks, Bidirectional LSTM, Explainable AI, Intrusion detection},
abstract = {Zero-day attacks pose a significant challenge to cybersecurity systems due to their unpredictable nature, absence of predefined signatures, and ability to bypass traditional detection mechanisms. Deep neural networks (DNN) can process diverse and complex network data to identify novel or zero-day attacks (ZDA) that existing methods often overlook. In this research work, an advanced intrusion detection system (IDS) has been proposed based on an explainable artificial intelligence (XAI) framework. Feature attention score (FAS) guides dimensionality reduction by highlighting the most significant network attributes, ensuring the classifier focuses on related patterns. The optimal features, as identified by transition-aware FAS analysis, are selected for classification training to distinguish between normal and malicious traffic employing the benchmark NSL-KDD dataset. Experimental results demonstrate that the proposed model not only reduces feature dimensionality but also improves detection accuracy, particularly in identifying ZDA attacks. Additionally, we incorporated XAI principles by visualizing prediction confidence through a histogram of predicted probabilities and assessing reliability using a calibration plot. These visual diagnostics help interpret how the model attains its decisions, making the framework more transparent and trustworthy. The proposed model's generalizability is also verified on the benchmark CIC-IDS2017 dataset, which reveals that the proposed model is capable of identifying a diverse range of network intrusions. The generalized model is also interpretable, providing trust to humans in the decision-making process.}
}
@article{VO2026115105,
title = {Explainability of machine learning models under missing data},
journal = {Applied Soft Computing},
volume = {196},
pages = {115105},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115105},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005533},
author = {Tuan L. Vo and Thu Nguyen and Luis M. Lopez-Ramos and Hugo L. Hammer and Michael A. Riegler and Pål Halvorsen},
keywords = {Missing data, Imputation, Model explainability},
abstract = {Missing data is a prevalent issue that can significantly impair model performance and explainability. This paper briefly summarizes the development of the field of missing data with respect to Explainable Artificial Intelligence and experimentally investigates the effects of various imputation methods on SHapley Additive exPlanations (SHAP), a popular technique for explaining the output of complex machine learning models. Using benchmark datasets from the UCI Machine Learning Repository and the MNIST dataset with missing rates ranging from 20% to 80%, we compare different imputation strategies and assess their impact on feature importance and interaction as determined by Shapley values. Moreover, we also theoretically analyze the effects of missing values on Shapley values. Importantly, our findings reveal that the choice of imputation method can introduce biases that could lead to changes in the Shapley values, thereby affecting the explainability of the model. Additionally, we also show that a lower test prediction Mean Squared Error (MSE) does not necessarily imply a lower MSE in Shapley values and vice versa. Furthermore, while eXtreme Gradient Boosting (XGBoost) can directly handle missing data, it can substantially degrade explainability compared to imputing data beforehand. Overall, this study provides a comprehensive evaluation of imputation methods in the context of model explanations, offering practical guidance for selecting appropriate techniques based on dataset characteristics and analysis objectives.}
}
@article{YANG2026114988,
title = {Highly goal-oriented learning path recommendation with the forgetting curve},
journal = {Applied Soft Computing},
volume = {196},
pages = {114988},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114988},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004369},
author = {Xiaonan Yang and Senlin Luo and Jinjie Zhou and Limin Pan},
keywords = {Learning path recommendation, Hierarchical reinforcement learning, Personalized learning},
abstract = {Learning path recommendation aims to organize learning items in an appropriate order to help learners achieve their learning goals. Reasonable planning of the concept learning sequence and dynamic matching of suitable learning resources are critical for boosting recommendation performance. Existing reinforcement learning-based methods usually select all prerequisites of a target concept as recommendation candidates without screening, leading to redundant or excessively long learning paths. Moreover, exercise recommendation based on knowledge states assessed by knowledge tracing suffers from training instability due to shifting response data distributions across epochs, resulting in a mismatch between the difficulty of recommended exercises and the learner’s concept mastery level. To address these issues, this paper proposes a highly goal-oriented method named IFLPR. We design a selection strategy based on the forgetting curve and centrality-based algorithm to filter prerequisite concepts, retaining only those with high contributions to mastering the target concept as candidates. The difference between the initial knowledge state assessed by cognitive diagnosis and knowledge tracing model is introduced as a loss to stabilize model training, ensuring better exercise difficulty-concept mastery level matching. Compared with the SOTA methods, experimental results show that IFLPR improves the goal promotion by 33.24% under a 20-step constraint, while reducing the required recommendation steps to achieve the learning goal by up to 41.45%, highlighting its superior efficiency.}
}
@article{SUN2026115077,
title = {BioDiff-CAF: An integrated bio-inspired diffusion model with cellular automata framework for drones collaborative control},
journal = {Applied Soft Computing},
volume = {196},
pages = {115077},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115077},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005259},
author = {Yongzhi Sun and Fengyuan Jia and Lu Shen and Hongli Zhu and Fengwei Jia},
keywords = {Drone, Bio-inspired control, Random noise, CA, DDPM},
abstract = {In bio-inspired control for drones, traditional methods often neglect inherent random noise and inter-individual behavioral differences in fish schools, resulting in homogenized trajectories that cannot fully capture the movement characteristics of fish schools. This study proposes BioDiff-CAF, an integrated bio-inspired diffusion model with cellular automata (CA) framework for drones collaborative control. By collaboratively optimizing a bio-inspired diffusion model and deterministic local rules, the framework generates diverse trajectories that conform to the statistical properties of real fish schools and satisfy the physical constraints of drone systems. To address the challenge of characterizing random noise and individual variability, a trajectory generation method based on the Denoising Diffusion Probabilistic Model (DDPM) is employed. The proposed method adopts a Markovian forward diffusion process regulated by a cosine-based scheduling strategy. Reverse denoising is implemented using a hybrid neural architecture that integrates PSO-LSTM and attention mechanisms. The framework explicitly models random noise in fish-school motion through a probabilistic generative process, while enforcing safety-distance and boundary constraints via a soft-constraint loss function. The resulting diverse candidate trajectories conform to the statistical features of real fish schools. Secondly, to enhance the physical constraints of the generated trajectories, the CA is introduced to transform the fish’s “near-repulsion–far-attraction” interaction rule into a deterministic evolution process within the drone’s kinematic domain. This approach further facilitates obstacle avoidance and formation maintenance through a null-space task allocation framework. The experimental results show that the generated trajectories effectively preserve the fundamental fish movement characteristics while satisfying drone physical constraints, offering new insights into bio-inspired control for drones.}
}
@article{QIAN2026115129,
title = {Application of whale optimization algorithm and capacity prediction network for optimal allocation of distributed generation in distribution networks},
journal = {Applied Soft Computing},
volume = {196},
pages = {115129},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115129},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005776},
author = {Jie Qian and Min Wei and Weisheng He and Ping Wang and Jun Liu},
keywords = {Optimal location and capacity allocation, Data-driven capacity prediction, Distributed generation, Low-carbon power system, Whale optimization algorithm},
abstract = {The optimal location and capacity allocation (OLCA) of distributed generations (DGs) and shunt capacitors (SCs) is critical for enhancing the flexibility and reliability of radial distribution networks (RDNs). To identify high-quality DG/SC allocation schemes, this paper introduces an improved single-objective whale optimization algorithm (ISWOA) and a multi-objective version (IMWOA), incorporating multiple enhancements specifically tailored for OLCA problems. Benchmark tests validate their superior performance in solving high-dimensional and non-convex optimization tasks like OLCA. Specifically, ISWOA achieves significant power loss reductions of 94.08 %, 98.11 %, and 59.61 % in 33-node, 69-node, and 119-node RDNs, respectively, demonstrating its effectiveness in improving the economic and energy efficiency of RDNs. Meanwhile, IMWOA demonstrates strong suitability for tackling complex multi-objective OLCA problems by providing DG/SC allocation schemes that effectively balance active and reactive power losses and voltage deviation. By addressing diverse grid requirements, IMWOA facilitates comprehensive enhancements in the economic efficiency and environmental sustainability of RDNs. Additionally, leveraging the optimal DG/SC locations identified by IMWOA, a novel data-driven capacity prediction network efficiently generates multiple superior allocation schemes for DG/SC capacities with low computational cost. In the 69-node RDN study, the prediction network achieves high accuracy in predicting power losses and voltage deviations, confirming its practical utility in solving OLCA problems. Together, the proposed IMWOA and the novel capacity prediction network provide robust and practical technologies for OLCA challenges, advancing the development of resource-efficient and low-carbon power systems.}
}
@article{LI2026115078,
title = {Solving the time-dependent agile earth observation satellite scheduling problem using adaptive large neighborhood search with reinforcement learning controller},
journal = {Applied Soft Computing},
volume = {196},
pages = {115078},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115078},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005260},
author = {Bohua Li and Ming Chen and Luona Wei and Yuning Chen and Yingwu Chen},
keywords = {Agile earth observation satellite scheduling, Reinforcement learning, Adaptive large neighborhood search, Time-dependent transition time},
abstract = {The Agile Earth Observation Satellite Scheduling Problem (AEOSSP) entails the selection and scheduling of observation tasks from a candidate list to maximize profits. While Adaptive Large Neighborhood Search (ALNS) is a prominent method for addressing this problem, its reliance on hand-crafted selectors for neighborhood transformation operators often results in inefficient weight updates, thereby limiting its overall performance. To address this issue, we propose a Reinforcement Learning Enhanced ALNS (RL-ALNS) for efficient AEOSSP resolution. RL-ALNS is a lightweight yet effective framework that dynamically prioritizes operators by considering scenario-specific demands and real-time performance during the search process. It integrates a Reinforcement Learning (RL)-enhanced controller to optimize operator selection and incorporates multiple problem-specific position operators (POs) into the ALNS framework to enable efficient task insertion. Experimental results demonstrate the superiority of RL-ALNS over the state-of-the-art Tabu-based ALNS Algorithm (ALNS/TPF). Specifically, RL-ALNS achieves a 2.3% higher profit rate on average and consistently outperforms ALNS/TPF in the early stages of the search process. Further experiments reveal that the RL-enhanced controller significantly improves operator selection efficiency, while the POs ensure stable and high-quality task insertion. These findings highlight the superior performance of RL-ALNS in tackling the AEOSSP, establishing it as a significant advancement over conventional methodologies in satellite scheduling optimization, while also demonstrating its potential for addressing complex, real-world scheduling challenges across diverse domains.}
}
@article{JAVED2026114981,
title = {EffiMalNetv3: A lightweight framework for malware detection using contrastive learning and attention-guided deep learning approach},
journal = {Applied Soft Computing},
volume = {196},
pages = {114981},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114981},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004291},
author = {Sidra Javed and Guowei Wu and Hamza Javed},
keywords = {Malware detection, Deep learning, Lightweight models, Self-supervised},
abstract = {Malware detection is critical in cybersecurity, requiring models that are not only accurate but also efficient. Traditional deep learning-based approaches, such as CNNs and LSTMs, suffer from high computational costs, limited generalization across different malware families, and inefficiencies in real-time applications. To address these challenges, we propose EffiMalNetv3, a lightweight and high-performance malware detection framework that integrates MobileNetv3, Enhanced CBAM (Convolutional Block Attention Module), a novel ByteVigil Transformer, Contrastive Learning, and AASP (Adaptive Attention Guided Structured Pruning) for enhanced feature extraction and classification. EffiMalNetv3 reduces computational complexity using structured pruning techniques, maintaining high detection performance while making the model suitable for real-time malware detection in resource-constrained environments. The model addresses the issue of limited generalization by leveraging contrastive learning, which enables robust self-supervised feature learning, improving the model’s ability to detect unseen and zero-day malware. Experimental results show that EffiMalNetv3 achieves 99.18% accuracy, outperforming existing models and ensuring low computational overhead, thereby providing a scalable, efficient, and reliable solution for modern malware detection. This addresses key issues of accuracy, generalization, and efficiency in real-time applications.}
}
@article{GHORBANI2026115070,
title = {Scalable structurally-guided consensus for distributed learning-based fault isolation in networked dynamical systems},
journal = {Applied Soft Computing},
volume = {196},
pages = {115070},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115070},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005181},
author = {Mohammadreza Ghorbani and Ladan Khoshnevisan and Mohammad Pirani and Amir Khajepour},
keywords = {Consensus-based inference, Fault detection and isolation, Networked dynamical systems, Graph-based learning, Neural networks, Structural analysis, Vehicle state estimation},
abstract = {Effective fault detection and isolation (FDI) in networked dynamical systems (NDSs) is inherently challenging due to their scale and complex interdependencies. Nonetheless, it is essential for ensuring safe and reliable operation, as faults can propagate and trigger cascading failures. This paper presents a hybrid, distributed FDI framework that integrates structural system knowledge with learning-based local detectors through a novel consensus-based decision-making algorithm. Structural dependencies within a modular vehicle estimation architecture are captured using a Bipartite Fault Signature Graph (BFSG), from which a Fault Interaction Graph (FIG) is constructed via one-mode projection to encode interdependencies among fault sources. It also guides the deployment of local fault detectors—supervised classifiers for labeled nodes and unsupervised autoencoders for unlabeled ones. A novel consensus mechanism aggregates local predictions across the graph, enabling accurate and robust fault localization under partial supervision. The proposed framework further supports isolation of multiple concurrent faults when they are not directly connected in the FIG. This structurally guided approach reduces retraining overhead, supports modular scalability, and improves interpretability through graph-theoretic tools such as coverage ratio, dominating sets, and independent sets. Validation on a high-fidelity CarSim–Simulink vehicle simulation with numerous fault sources demonstrates accurate fault localization with significantly fewer trainable parameters than centralized models. These results highlight the practical utility of structure-aware, consensus-driven learning for scalable fault diagnosis in complex networked dynamical systems.}
}
@article{LI2026115058,
title = {When fast fourier transform meets Mamba: A general object detection framework for UAV aerial images},
journal = {Applied Soft Computing},
volume = {196},
pages = {115058},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115058},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005065},
author = {Xun Li and Yuzhen Zhao and Yang Zhao and Zhun Guo and Jianjing Gao and Ruijuan Yao and Baoxi Yuan},
keywords = {Mamba, Fast Fourier Transform, UAV, Object detection, Gaussian filter, Edge information enhancement},
abstract = {To address the challenges in UAV aerial imagery, such as significant variations in object scales, high feature similarity, and inconsistencies between classification and regression predictions, we propose the Guided Edge-Aggregation Mamba Network (GEA-MambaNet), an effective object detection framework that shows stable performance across diverse UAV datasets. Although state-of-the-art detectors have achieved remarkable progress in natural scene benchmarks, they often suffer from substantial performance degradation in real-world low-altitude aerial scenarios. GEA-MambaNet introduces a systematic design across three critical stages: feature extraction, feature fusion, and task-specific prediction. In the feature extraction stage, we propose the Sobel-Gaussian Fusion Stem (SGFStem) to guide the shallow network in capturing boundary and texture features more effectively, thereby enhancing fine-grained representation. During feature fusion, we design the Bidirectional Multiscale Aggregation Feature Pyramid Network (BiMAFPN) and integrate it with the Frequency-Spatial Aggregation Mamba (FSAMamba) to improve semantic consistency and spatial alignment across scales via bidirectional semantic flows and contextual interactions. In the prediction stage, we construct the Decoupled Edge-Enhanced Network (DEENet), which adopts task-specific classification and regression branches, jointly guided by edge information and a consistency supervision strategy, ultimately enhancing prediction accuracy and stability. Extensive experiments on several challenging object detection benchmarks demonstrate that GEA-MambaNet achieves notable improvements in detection accuracy, inference efficiency, and model compactness. The framework exhibits strong adaptability for deployment and robust generalization across diverse scenarios, making it highly suitable for various UAV-based visual tasks such as power line inspection, intelligent transportation, photovoltaic monitoring, and urban management.}
}
@article{DU2026115110,
title = {Generalizable zero-shot home energy management via representation learning and behavioral cloning},
journal = {Applied Soft Computing},
volume = {196},
pages = {115110},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115110},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005582},
author = {Xiao Du and Fengji Luo and Juntao Hu and Wei Zhou and Junhao Wen},
keywords = {Home energy management, Representation learning, Zero-shot, Behavioral cloning, Deep reinforcement learning},
abstract = {Deep reinforcement learning (DRL) is widely used in home energy management for its ability to handle nonlinearity and uncertainty. However, its reliance on trial-and-error interaction makes early unsafe and inefficient behaviors impractical in real households. To address this, we propose RB-ZeroHEM, a zero-shot knowledge transfer framework based on representation learning and behavioral cloning. RB-ZeroHEM employs contrastive learning to extract stable, physics-aligned representations of household energy dynamics from historical control trajectories, enabling clustering-based similarity measurement without hand-crafted features. For a new household, it identifies the most similar source cases and clones a deployable policy requiring zero target-environment interactions. Experiments on 12 simulated households driven by real-world energy data (San Diego smart meter and weather records spanning four seasons) demonstrate that when transferring to physically similar environments, RB-ZeroHEM reduces discomfort ratio by 33% (from 12.34% to 8.24%) and electricity costs by 15% (from $228 to $193) compared to rule-based control, while achieving 81% of the grid energy savings of the best online DRL method, soft actor-critic (SAC), with zero interactions versus SAC’s 24,192-step exploration budget. The learned representations exhibit strong physics alignment and remain robust across seasonal shifts and deployment noise. With minimal fine-tuning (576 interactions, 2.4% of SAC’s budget), performance matches or surpasses online DRL baselines. When source–target physical dynamics are mismatched, zero-shot performance degrades gracefully, indicating that similarity-based retrieval reliability is critical. These results establish RB-ZeroHEM as a practical, low-risk solution for deploying intelligent energy management in real households, enabling rapid scaling without the safety and economic penalties of online exploration.}
}
@article{LU2026115021,
title = {Learning with guidance: Auxiliary supervision and feature enhancement for sound event localization and detection},
journal = {Applied Soft Computing},
volume = {196},
pages = {115021},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115021},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004692},
author = {Yufei Lu and Jianguo Wei and Wenhuan Lu and Ruiteng Zhang and Dongwen Ying and Masashi Unoki},
keywords = {Sound event localization and detection, Sound event detection, Auxiliary learning, Attention, Pooling},
abstract = {Sound event localization and detection (SELD) involves two subtasks: sound event detection (SED) and sound source localization (SSL). In real-world domestic environments, many sound events tend to occur at specific spatial locations, making accurate event detection crucial for precise localization. Existing methods process the two types of features simultaneously, which fail to effectively highlight the dominant role of the event semantics, especially under challenging conditions such as transient noise and frame-level fluctuations. To address this, we propose AL-SELD, an auxiliary learning-based SELD framework that more effectively utilizes sound event semantics. The architecture consists of two parallel branches: a backbone branch, which learns a unified objective for joint SELD, and an auxiliary branch focusing on fine-grained SED supervision, assisting the backbone with more precise event semantics. To address frame-level noise and reduce insertion errors, we propose a Temporal Smoothing Pooling (TSP) mechanism which applies a temporal average over predicted SED logits to reduce frame-level fluctuations. Additionally, to capture rich spatiotemporal patterns, we further propose the Batch-Spectral-Temporal attention mechanism (BST-AM) and integrate a Differential Transformer (DIFFformer) into the model. Together, these two components enhance the model’s ability to attend to salient features across time, frequency, and space. We evaluate AL-SELD on multiple datasets. Experimental results show consistent improvements in both event detection and localization, confirming the effectiveness and generalizability of our approach. Ablation studies further validate the contributions of each component.}
}
@article{HUANG2026115103,
title = {Lithium-ion battery capacity estimation from random charging data using depthwise and pointwise convolutions},
journal = {Applied Soft Computing},
volume = {196},
pages = {115103},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115103},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600551X},
author = {Haichi Huang and Chong Bian and Mengdan Wu and Dong An and Shunkun Yang},
keywords = {State of health, Bidirectional long short-term memory, Convolutional neural network},
abstract = {Accurate and reliable capacity estimation is a critical factor in ensuring the safe and stable operation of lithium-ion batteries. However, most data-driven battery capacity estimation methods rely on data collected either during a complete charging process or within specific voltage ranges, which limits their applicability in real-world scenarios. Hence, this paper proposes a novel framework that utilizes only randomly sampled continuous fragments of charging data as input, without relying on specific data ranges. The framework comprises a multi-convolutional neural network (CNN) block, an attention-enhanced long short-term memory network, and a fully connected layer. The multi-CNN block consists of multiple depthwise and pointwise convolution layers, combined via gating mechanisms. By separately processing information extraction and feature learning for different variable types, the model can comprehensively capture both inter-variable temporal relationships and intra-variable temporal dependencies. In addition, the framework processes voltage data to obtain the rate of voltage change over time. The derived rate is then used as an input parameter, thereby enriching the representation of the input features. Experiments on the CALCE dataset demonstrate that the proposed framework achieves the greatest improvement on the best-performing battery cells, with the mean absolute error reduced by 6.3% and the root mean square error reduced by 4.8%. Overall, MCLA can effectively adapt to charging data in practical scenarios that are incomplete or irregular, thereby achieving accurate and reliable capacity estimation.}
}
@article{ZHENG2026115092,
title = {Spectral filtering and multi-view graph representation learning for multimodal recommendation},
journal = {Applied Soft Computing},
volume = {196},
pages = {115092},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115092},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005405},
author = {Yuhao Zheng and Chao Zhao and Weidong Kong},
keywords = {Multi-modal recommendation, Multi-modality fusion, Graph neural network},
abstract = {Graph Neural Network (GNN)-based multi-modal recommendation systems have become an active research area. A key challenge is that existing methods typically fuse multi-modal information directly, overlooking the inherent noise within each modality, which risks amplifying cross-modal noise. Moreover, conventional GNNs often focus on global co-occurrence patterns, potentially neglecting local structures necessary for personalization. This leads to the homogenization of user preference models, which may fail to capture unique user interests. To address these limitations, SMG-Rec is presented, leveraging Spectral Filtering and Multi-View Graph Representation Learning. The proposed approach aims to suppress multi-modal noise while mining personalized preferences. To mitigate modal noise, spectral filtering is employed to project features into the frequency domain, using a learnable adaptive filter to attenuate noise and obtain refined item representations. To counteract homogenization, a multi-view graph representation learning strategy is developed to learn personalized preferences from latent structures while mitigating over-smoothing, and to capture item associations from various item-item semantic graphs. Lastly, a socially-enhanced, modality-aware preference module is designed to alleviate data sparsity. By constructing an implicit social network, it explicitly models user homogeneity to enrich preference representations learned from individual behaviors. Experiments on three real-world datasets validate the effectiveness of the proposed model. The implementation code is available at https://github.com/Zyh0815/SMG_Rec.}
}
@article{WANG2026115132,
title = {CBM3D-DCC 2D histogram and dual-learning gravitational search algorithm with the interval type-2 fuzzy logic for multilevel threshold color image segmentation},
journal = {Applied Soft Computing},
volume = {196},
pages = {115132},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115132},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005806},
author = {Yirui Wang and Anjing Guo and Lijun Guo and Rong Zhang and Guoqing Li and Shangce Gao},
keywords = {Gravitational search algorithm, Dual-learning mechanism, Multilevel threshold color image segmentation, Interval type-2 fuzzy logic system},
abstract = {Multilevel threshold color image segmentation is a complex optimization problem. This paper proposes a novel color block matching and 3D collaborative filtering with dominant color component 2D histogram to tackle color images. A dual-learning gravitational search algorithm with an interval type-2 fuzzy logic system is designed to optimize the optimal threshold of image segmentation. Two learning subpopulations are constructed to improve the population’s evolutionary direction. An interval type-2 fuzzy logic system based on individuals’ evolutionary states is used to adaptively adjust individuals’ updated step size. The proposed algorithm effectively enhances the search performance. Experiments are carried out on 30 color images with four kinds of thresholds. The proposed algorithm is compared with five state-of-the-art gravitational search algorithms, five novel metaheuristic algorithms, and four advanced differential evolution and particle swarm optimization variants. In addition, it also compares with six most advanced algorithms in CEC2017 benchmark functions and image threshold segmentation. Results demonstrate the superiority and potential of the proposed algorithm in multilevel threshold color image segmentation.}
}
@article{GUO2026115120,
title = {Diffusion model for efficient federated learning considering non-IID data in industrial scenarios},
journal = {Applied Soft Computing},
volume = {196},
pages = {115120},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115120},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005685},
author = {Wei Guo and Hongqiang Sang and Ying Liu and Qingzong Li and Kai Cai},
keywords = {Diffusion Model, Efficient Federated Learning, Non-IID data, NSGA-II, Surface defect detection},
abstract = {Federated Learning (FL) faces challenges due to non-independent and identically distributed (non-IID) data, global model initialization (cold-start), and inefficient model training, especially for industrial FL (IFL). This paper proposes an efficient FL framework incorporating a Conditional Diffusion Model (CDM) and a Non-dominated Sorting Genetic Algorithm II (NSGA-II) to address non-IID data issues and optimize IFL training efficiency. First, clients generate synthetic data using CDM based on a data generation plan provided by the server, ensuring data privacy while improving data distribution and volume. The generated data is utilised for global model initialization and local dataset enhancement for clients. Then, NSGA-II is applied to optimize the volume of training data and the number of local training epochs, balancing computational cost and model accuracy for efficient IFL training. A case study on steel plate surface defect detection validates the proposed method. Results show that global model initialization using CDM significantly improves initial model accuracy compared to traditional methods. The optimized training strategy, implemented via NSGA-II, enhances IFL efficiency by reducing training time while maintaining high model performance. After only 4 global training rounds, the proposed method achieves an accuracy of 0.956, whereas random initialization requires about 20 rounds to reach comparable performance (0.949), corresponding to an 80% reduction in communication rounds. It also improves accuracy over cGAN/cVAE by + 5–10 %age points (e.g., Acc@R0: 0.81 vs 0.76/0.71; Acc@R3: 0.95 vs 0.90/0.86). Holm-corrected paired tests confirm statistical significance (e.g., p = 0.0002 at R0), indicating robust and practically meaningful gains for IFL.}
}
@article{EBRAHIMIWARKIANI2026115051,
title = {A systematic review of multimodal large language models for medical decision support: Architectures, fusion methods, and real-world applications},
journal = {Applied Soft Computing},
volume = {196},
pages = {115051},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115051},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004990},
author = {Mahshid {Ebrahimi Warkiani} and Bita Safari and Mohammad Hossein Moattar and Mehdi Hosseinzadeh},
keywords = {Large Language Models, Medical Diagnosis and Prognosis, Multimodal Data Analysis, Transformers},
abstract = {Artificial intelligence and its applications have already been transformed by large language models (LLMs). This rapidly emerging field also holds immense potential to revolutionize the medical industry. This review discusses the technological frameworks, applications, challenges, and possible future directions of multimodal LLMs in healthcare diagnosis and prognosis. We emphasize how these algorithms analyze text, pictures, genetic data, and sensor inputs to enhance diagnostics, predictive analytics, and customized medicine. Transformer-based architectures, when combined with fusion methods such as joint embeddings and cross-modal attention, enable sophisticated reasoning across modalities. This feature improves the accuracy of real-time patient monitoring, cancer detection, and rare disease diagnosis. The Scopus and Google Scholar databases were used to choose the studies for this evaluation because of their extensive coverage, excellent indexed research quality, citation analysis capabilities, and sophisticated search features. Data heterogeneity, interpretability, computational cost, and ethical issues continue to be the key obstacles. The advantages of multimodal LLMs over traditional methods are illustrated through case studies. Future advancements will depend on the integration of innovative modalities such as wearable technology, IoT-based systems, and collaborative AI frameworks, along with efforts to address scalability and regulatory challenges. In order to fully realize the promise of multimodal LLMs in revolutionizing medical research and therapy, this analysis emphasizes the necessity of strong data standards, multidisciplinary collaboration, and ethical frameworks.}
}
@article{ALWAJIH2026115104,
title = {PHOG-Net: An interpretable and efficient hybrid CNN framework for medical image classification using gradient histogram integration},
journal = {Applied Soft Computing},
volume = {196},
pages = {115104},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115104},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005521},
author = {Ebrahim Al-Wajih and Muhammad Usman and Junaid Qadir},
keywords = {PHOG-Net, Pyramid histogram of oriented gradients with Convolutional neural networks, Convolutional neural networks, Medical image recognition, Deep learning, Image classification},
abstract = {Convolutional Neural Networks (CNNs) have proven effective in medical image classification, but they often struggle to capture fine textures and directional patterns that are important for accurate diagnosis. To address this challenge, PHOG-Net was developed by integrating Pyramid Histogram of Oriented Gradients (PHOG) into the network. Instead of adding handcrafted features after feature extraction, the model embeds gradient-based descriptors within the CNN, which improves interpretability and sensitivity to diagnostic texture cues. The architecture uses a dual-path stem layer and a sequence of PHOG Processing Blocks to extract spatial representations together with gradient-based texture features. These blocks combine 2D and 1D convolutional layers with fixed PHOG descriptors, which allows the model to capture multi-scale information. Although the feature capacity is expanded, the overall design remains lightweight, requiring far fewer parameters than DenseNet121, VGG16, and ResNet-18. Performance was assessed across 12 MedMNIST datasets and compared against standard CNNs, Vision Transformers, and AutoML-generated architectures. PHOG-Net showed strong performance across these tasks. Accuracy scores of 82.80% and 92.4% were achieved on OCTMNIST and PathMNIST, respectively, while AUC values of 0.998 and 0.995 were recorded for OrganAMNIST and OrganCMNIST. Across 12 MedMNIST benchmarks, PHOG-Net achieves up to 0.87% higher classification accuracy than leading state-of-the-art models, while using less than half the learnable parameters of ResNet-18. SmoothGrad saliency maps further confirmed that the model focuses on clinically relevant regions. PHOG-Net offers an efficient and texture-sensitive alternative to conventional CNNs and transformer-based models. By incorporating PHOG-based gradient information within the CNN architecture, several limitations of standard convolutional representations are reduced. The source code supporting this study is publicly available at: https://github.com/EbrahimAlwajih/phognet.}
}
@article{MA2026115060,
title = {Out-of-distribution detection by feature-constrained contrastive learning},
journal = {Applied Soft Computing},
volume = {196},
pages = {115060},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115060},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005089},
author = {Yangling Ma and Yixin Luo and Zhouwang Yang},
keywords = {Out-of-distribution detection, Contrastive learning, Reliable models, Unsupervised learning},
abstract = {Detecting samples that differ from the training set is a crucial procedure to ensure the safety of applications utilizing deep learning models. Self-supervised learning, which minimizes the unsupervised contrastive loss, captures the intrinsic characteristics of in-distribution samples. However, this loss may fail in out-of-distribution (OOD) detection tasks due to the uniformity of the distribution of learned features. In this study, we propose a novel training scheme based on contrastive learning that constrains the learned features of in-distribution samples within a designated region of the feature space. Additionally, we introduce a corresponding metric to assess the normality of test samples. Extensive experiments conducted on CIFAR-10 and SVHN datasets validate the effectiveness of our proposed method and demonstrate its state-of-the-art performance. Moreover, we conduct an additional experiment to evaluate the proposed method’s ability to detect adversarially-attacked samples.}
}
@article{YE2026115096,
title = {Category-aware dual graph disentanglement with multi-task learning for session-based recommendation},
journal = {Applied Soft Computing},
volume = {196},
pages = {115096},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115096},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005442},
author = {Hongxia Ye and Chaoqun Li and Liangxiao Jiang},
keywords = {Session-based recommendation, Dual-graph disentanglement, Category-aware contrastive learning, Adaptive preference modeling, Multi-task learning},
abstract = {Session-based recommendation aims to predict users’ next interactive items through anonymous sessions. However, most existing methods relying solely on item IDs suffer from severe data sparsity and lack of semantic information. Although some studies incorporate item categories, they typically model item-category heterogeneous graphs while ignoring their granularity differences, causing information entanglement. Furthermore, these methods often fail to explicitly capture semantic similarities among items from the same category and tend to overemphasize the last interaction as a proxy for recent user preference, lacking adaptability to sessions of varying lengths. To address these limitations, this paper proposes a novel session-based recommendation algorithm called Category-aware Dual-graph Disentanglement with Multi-task learning (CDDM). CDDM constructs disentangled item-wise and category-wise graphs to disentangle cross-granularity features. A category-aware contrastive learning mechanism sharpens item embeddings by pulling semantically similar ones closer. Additionally, a session-length adaptive weighting mechanism dynamically quantifies the impact of the last item based on session length to better capture recent user preferences. Finally, a multi-task learning framework jointly optimizes the primary next-item prediction task with auxiliary category prediction and contrastive learning tasks, improving generalization and robustness. Experimental results on three public datasets demonstrate that CDDM outperforms state-of-the-art methods across multiple metrics while maintaining lower computational complexity, validating its effectiveness, efficiency, and superiority. Building on this foundation, we further explore an enhanced algorithm CDDM++. Experiments show that CDDM++ achieves a further reduction in computational complexity while retaining competitive recommendation performance. Our implementation of CDDM and its improved version is publicly available at: https://github.com/ChaoqunLiGroup/CDDM.}
}
@article{JAMEEL2026115039,
title = {A circular intuitionistic fuzzy decision-making model for evaluating web 4.0-based pharmaceutical delivery solutions in rural areas},
journal = {Applied Soft Computing},
volume = {196},
pages = {115039},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115039},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004874},
author = {Toqeer Jameel and Vladimir Simic and Svetlana Dabic-Miletic and Hafiz Muhammad Athar Farid and Dragan Pamucar and Muhammad Riaz},
keywords = {Web 40 solutions, Drug delivery, Sustainable customer service, Circular intuitionistic fuzzy sets, Best-worst method},
abstract = {Web 4.0 technologies play an important role in revolutionising logistics and supply chains in a variety of industries, including healthcare. This paper aims to analyze the benefits, limitations, and challenges of implementing Web 4.0 transportation technologies for sustainable drug delivery in rural areas. While the implementation of Web 4.0-based pharmaceutical delivery solutions is on the rise, current decision-making models frequently inadequately address the ambiguity and hesitancy linked to expert evaluations in uncertain environments. This underscores a significant research gap; i.e., the absence of comprehensive, uncertainty-aware frameworks that incorporate both subjective and objective viewpoints. We propose a novel hybrid decision support model that utilises circular intuitionistic fuzzy (CIF) sets to effectively represent expert uncertainty, addressing the existing gap. The framework integrates the method based on the removal effects of criteria (MEREC) for establishing objective criteria weights with the best-worst method (BWM) to incorporate expert preferences, thereby facilitating a comprehensive evaluation of alternatives. The CIF interactive and multi-criteria decision-making method (TODIM) is introduced for the robust ranking of the defined Web 4.0-based pharmaceutical delivery solutions based on the conflicting criteria. A sensitivity analysis evaluates the model’s robustness under varying conditions, while a comparative analysis benchmarks its performance against existing decision-making approaches. The proposed CIF MEREC-BWM-TODIM framework addresses methodological limitations in existing literature and offers practical insights for pharmaceutical managers and pharmaceutical supply chain coordinators. The findings of this study indicate that companies can reduce costs and strengthen the resilience of pharmaceutical supply chains, ensuring a faster response to the crisis.}
}
@article{YANG2026115084,
title = {Leveraging a novel intuitionistic fuzzy three-way decision model for label correlation in multi-label classification},
journal = {Applied Soft Computing},
volume = {196},
pages = {115084},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115084},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005326},
author = {Ji-Xue Yang and Xiao-Ya Che and Tao Feng and Hui-Yong Wang},
keywords = {Multi-label classification, Three-way decision theory, Intuitionistic fuzzy clustering, Intuitionistic fuzzy sets},
abstract = {The core task of multi-label learning is to assign an appropriate subset of labels to each instance, accurately characterizing its multiple semantic meanings. However, existing methods have overlooked the uncertainty in feature information arising from individual cognitive differences. Intuitionistic fuzzy sets provide an effective theoretical framework for modeling uncertainties in datasets. Based on intuitionistic fuzzy rough set theory, we propose a multi-label learning model that captures uncertain label correlations, namely ML-IF3WD, which offers a framework for handling data uncertainty and improving classification accuracy. Firstly, a novel kernel function based on the membership degree and hesitation degree is introduced to compute the importance distribution of each feature across different labels, thereby revealing latent correlations between the feature space and label space. Then, an improved intuitionistic fuzzy clustering algorithm is proposed to perform fine-grained instance partitioning, in which instances with uncertain memberships are dynamically assigned to a boundary region. This enables a more principled characterization of fuzzy membership and boundary behavior in multi-label scenarios. Furthermore, an intuitionistic fuzzy three-way decision-based model is developed to capture instance-level local label correlation under cognitive uncertainty. By integrating local correlation patterns with global label semantic structures, the framework enables a more refined characterization of predictive behavior. This work proposes a multi-label classification model specifically designed to handle three distinct types of uncertainty arising from human cognitive processes: hesitation, non-commitment, and fuzziness. To evaluate its effectiveness in addressing such cognitive uncertainties, extensive experiments are conducted on multiple benchmark datasets, demonstrating that the proposed method achieves superior performance in handling uncertain features.}
}
@article{HOU2026115108,
title = {SRAF: A structure-aware relation-guided model for fraud detection on heterogeneous graphs},
journal = {Applied Soft Computing},
volume = {196},
pages = {115108},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115108},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005569},
author = {Xinlong Hou and Yong Liu and Qinru Li and Tao Yang and Long Chen and Jiangjin Gao},
keywords = {Fraud detection, Heterogeneous graph, Graph neural network, Relational dynamic attention, Graph autoencoder, Deep learning},
abstract = {On e-commerce platforms and social media, fraudsters spread false information by forging interactive relationships and manipulating public opinion, seriously misleading consumer decisions and damaging the reputation of merchants. Currently, fraud detection faces two major challenges: On the one hand, traditional GNN methods mostly rely on global structures for node representation learning, which makes it difficult to recognize the fraudulent node's camouflage features in the local structure, resulting in a reduced detection rate; On the other hand, existing methods generally adopt the equal aggregation strategy of relations, ignoring the semantic differences of multi-type relations in heterogeneous graphs, making it difficult to capture the implicit collaboration chains hidden in multi-hop paths, thus limiting the model performance. To address the above issues, this paper proposes a structure-aware and relationship-guided fraud detection model (SRAF). First, this paper proposes a category-aware structure enhancement module (CASE). By designing and constructing a structure-aware enhancement graph to model the local neighborhood of a node, the differences in high-density interaction features within the neighborhood are calculated, thereby effectively identifying camouflage patterns in the local structure and enhancing the model's recognition accuracy and discrimination ability for fraudulent nodes. Secondly, this paper designs a relation-aware dynamic attention mechanism (ReDA), which adaptively assigns semantic weights to different relation types and combines cross-layer information aggregation to effectively model implicit collaboration chains in cross-relationship multi-hop paths, thereby overcoming the limitations brought by equal aggregation of relations and improving the model's perception of complex fraudulent behaviors and semantic generalization capabilities. Finally, this paper proposes the Structure-Aware Embedding Oversampling Module (SAEO), which alleviates the category imbalance problem by generating synthetic samples based on positive class embedding and neighbor interpolation during the training phase, and improves the model's expressiveness and detection robustness for minority class nodes. Extensive experiments on two real-world datasets, YelpChi and Amazon, demonstrate that SRAF significantly outperforms existing state-of-the-art (SOTA) methods across key metrics such as AUC, F1-macro, and GMean. Furthermore, SRAF exhibits remarkable superiority in resisting structural camouflage within heterogeneous graphs and maintaining robust detection accuracy under severe class imbalance, validating its immense effectiveness in complex fraud detection scenarios.}
}
@article{ZHAI2026115076,
title = {Fine-grained vehicle damage classification based on applicability network},
journal = {Applied Soft Computing},
volume = {196},
pages = {115076},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115076},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005247},
author = {Yongjie Zhai and Zhenqi Zhang and Xunqi Zhou and Zixuan Wang and Qianming Wang},
keywords = {Vehicle intelligent damage assessment, Damage defect classification, Fine-grained learning, Backbone, Regularization correction},
abstract = {Vehicle damage classification is a critical component of intelligent damage assessment systems, presenting challenges due to complex damage morphology, high inter-class similarity, and significant intra-class variance. To address these issues, this paper proposes a Fine-grained Defect Applicable Network (FGDANet) that enhances classification accuracy through a multi-level fine-grained feature perception mechanism. Specifically, FGDANet alternately introduces the In-depth & Refined Layer (IR Layer) and the Regional Learning Block (RL Block) to perform independent down-sampling and fine-grained feature attention, thereby reducing information loss and strengthening the perception of critical regions. Furthermore, a Global Feature Search Module (GFS Module) is designed to adaptively search and aggregate global self-similar information within shallow networks, improving inter-class discrimination. Additionally, a Generalized Feature Correction Loss (GFC Loss) is proposed to regularize the backbone network through reverse feature fusion and label smoothing, enhancing feature generalization. On an 8-class vehicle damage dataset, FGDANet achieves a 4.32% improvement in Top-1 classification accuracy over the baseline model, outperforming several advanced classification networks. The method also demonstrates strong generalization on a public steel plate surface defect dataset. Experimental results indicate that FGDANet effectively addresses the challenges of damage defect classification and is suitable for real-world intelligent damage assessment and industrial quality inspection scenarios.}
}
@article{ZHANG2026115128,
title = {Fine-grained attention CLIP for zero-shot composed image retrieval},
journal = {Applied Soft Computing},
volume = {196},
pages = {115128},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115128},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005764},
author = {Lixia Zhang and Zhuoguan Ao},
keywords = {Composed image retrieval, Multimodal retrieval, Zero-shot learning},
abstract = {Zero-shot Composed Image Retrieval (ZS-CIR) allows users to retrieve images that meet their requirements by using a multimodal query combining a reference image and modification text. Current ZS-CIR methods are based on Contrastive Language-Image Pre-training (CLIP). These methods project the reference image completely into the text space through a fine-grained text inversion network, and then combine it with the modification text for image-text retrieval. Although these studies have achieved remarkable progress in fine-grained projection of the reference image, they ignore the issue that the global features of candidate images extracted by the CLIP model cannot effectively capture local objects and attributes within the images. To solve this problem, a training-free method named Fine-grained Attention CLIP (FGA-CLIP) is proposed in this paper, which aims to effectively capture local objects and attributes in candidate images. FGA-CLIP consists of two main parts: obtaining fine-grained image features and aggregating local features. The first part utilizes the global and local fine-grained features preserved in the intermediate layers of the Transformer. The second part aggregates local patch features through attention and similarity mechanisms to capture important local objects in the image. Extensive experiments on three public datasets show that FGA-CLIP significantly improves the retrieval performance of existing ZS-CIR models, fully validating the effectiveness of the proposed method.}
}
@article{AGHAEIFAR2026115101,
title = {Survival analysis using a graph-augmented graph convolution neural network (GA-GCNN) for breast cancer relapse prediction},
journal = {Applied Soft Computing},
volume = {196},
pages = {115101},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115101},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005491},
author = {Roya Aghaeifar and Mohammad T. Khasawneh},
keywords = {Breast cancer, Gene expression data, Graph neural network, Survival analysis, Age-at-diagnosis},
abstract = {Breast cancer is the most frequently diagnosed cancer among women worldwide. While gene expression profiling enables simultaneous measurement of thousands of genes, analyzing such high-dimensional data with limited samples remains a major challenge. Existing methods often reduce dimensionality by removing correlated features or combining datasets, potentially discarding valuable biological information. To address this limitation, we propose a Graph-Augmented Graph Convolutional Neural Network (GA-GCNN) that preserves feature complexity by integrating principles from network science and survival analysis. Our model incorporates age-at-diagnosis-based stratification to enhance training and introduces a custom loss function tailored to censored survival data. Evaluated on BRCA, GSE2034, and GSE2990 datasets, the GA-GCNN achieved an F1 score of 0.76.72, 71.02, and 68.41 outperforming the standard GCNs (F1: 70.92, 58.79, and 60.08). Results show that designing a loss function tailored to the characteristics of censored survival data enhances model performance. Stratifying by age at diagnosis improves model training and generalization. Incorporating unlabeled data enhances network connectivity and prediction accuracy. This approach demonstrates that leveraging graph structures with survival-aware learning significantly improves relapse risk prediction in breast cancer.}
}
@article{MUSA2026115081,
title = {q-Rung orthopair fuzzy N-bipolar soft sets for multi-criteria decision-making in telemedicine platform selection and healthcare evaluation},
journal = {Applied Soft Computing},
volume = {196},
pages = {115081},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115081},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005296},
author = {Sagvan Y. Musa and Baravan A. Asaad and Wafa Alagal and Zanyar A. Ameen},
keywords = {q-Rung orthopair fuzzy N-bipolar soft sets, N-bipolar soft sets, q-Rung orthopair fuzzy sets, MCDM, Telemedicine platform selection, Healthcare evaluation},
abstract = {Healthcare decision-making (DM) often requires evaluating multiple interdependent criteria under uncertainty, balancing desirable and undesirable outcomes. To address the limitations of traditional methods, we propose the q-rung orthopair fuzzy N-bipolar soft set (q-ROFNBSS) framework, a unified model that integrates multilevel evaluation, bipolar information, and higher-order fuzzy membership. The framework defines key operations—including null and whole sets, complement, subset, equality, union, and intersection—along with their algebraic properties, providing a rigorous foundation for systematic analysis. A step-by-step procedure is introduced to compute aggregated positive and negative scores for alternatives. We apply the model to a telemedicine platform selection case study, evaluating five hypothetical platforms across four positive and four negative criteria. The computed net scores, combining positive and negative impacts, are: z1=0.5954, z2=0.6572, z3=0.7745, z4=−0.8369, and z5=−1.0852, identifying the mobile-first teleconsultation platform (ϰ3) as the most suitable choice. Comparative and sensitivity analyses illustrate the framework’s superiority relative to existing models and its flexibility to variations in grading intervals and parameter settings. The proposed framework outperforms existing q-rung orthopair fuzzy set (q-ROFS) and N-bipolar soft set (NBSS) models by providing more balanced, trade-off-aware rankings. Overall, this framework offers a versatile and robust tool for complex DM scenarios in healthcare and other domains.}
}
@article{GUO2026115020,
title = {Cropper: An explainable lightweight attention-guided ensemble for robust plant disease diagnosis in data-scarce conditions},
journal = {Applied Soft Computing},
volume = {196},
pages = {115020},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115020},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004680},
author = {Mingyang Guo and Alejandro Guerra-Manzanares},
keywords = {Machine learning, Ensemble deep learning, Plant disease detection, Crop disease detection, Leaf disease detection, Precision agriculture, Agricultural AI},
abstract = {Plant disease detection using Artificial Intelligence (AI) has become a critical area of research due to its potential to improve crop yields, reduce losses and support sustainable agriculture. Despite significant progress, existing approaches often lack a unified framework that balances accuracy, efficiency and interpretability. Complex models such as Vision Transformers (ViTs) and multimodal systems demand high computational resources, while lightweight networks struggle with robustness under data scarcity and domain shift. Addressing these open challenges, we propose Cropper, an ensemble-based framework for agricultural leaf disease classification that integrates structural model diversity, attention-based refinement and interpretability within a computationally efficient architecture. We evaluate Cropper on seven publicly available leaf image datasets, covering both binary and multiclass classification tasks and compare its performance against five state-of-the-art baseline methods, including ViTs. The experimental results demonstrate that Cropper consistently outperforms all baselines across all datasets, achieving statistically significant improvements in five different performance metrics, while substantially reducing computational overhead compared to existing ensemble and large single-backbone architectures. Cropper also demonstrates enhanced robustness under data-scarce conditions and provides interpretable outputs that enhance trustworthiness in decision-making. By addressing the trade-offs between accuracy, efficiency and interpretability, Cropper offers a practical and scalable solution for real-world agricultural AI systems, supporting deployment in resource-constrained environments and advancing the adoption of trustworthy AI in farming practices.}
}
@article{LI2026115109,
title = {Gated recurrent unit network with conformable difference operator for enhancing estimation accuracy of state of charge in lithium-ion batteries},
journal = {Applied Soft Computing},
volume = {196},
pages = {115109},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115109},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005570},
author = {Jiadan Li and Zhe Gao and Xue Gao and Yuhang Wang},
keywords = {Gated recurrent unit, Conformable operator, Fractional-order difference, Lithium-ion batteries, State of charge},
abstract = {Accurate estimation of the State of Charge (SOC) of lithium-ion batteries (LIBs) constitutes a critical component of the battery management system. To overcome the limitation that the standard Gated Recurrent Unit (GRU) cannot adaptively regulate the ratio between memory and update in long sequence modeling, this paper draws inspiration from the fractal Conformable operator (T-operator) and proposes a discrete Conformable difference operator. Based on this operator, we propose a time-series adaptive gated recurrent unit, denoted T-GRU. The T-GRU network incorporates a time scaling factor into the hidden state update process via an order parameter α that possesses a clear physical interpretation, realizing adaptive regulation of the trade-off between memory retention and update dynamics. Statistical results from 30 independent experiments demonstrate that the T-GRU network reduces the Root Mean Square Error (RMSE) and Mean Absolute Error (MAE) of SOC estimation by 22.3% and 25% on average, respectively, with the improvement being highly statistically significant (p<0.001) compared with benchmark networks. Furthermore, the T-GRU network demonstrates a smoother loss descent trajectory and more stable output performance during training, demonstrating its robustness.}
}
@article{LIU2026115123,
title = {Continual learning classification method with antigen-presenting cell region walking based on the artificial immune system},
journal = {Applied Soft Computing},
volume = {196},
pages = {115123},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115123},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005715},
author = {Jia Liu and Zhinong Li and Dong Li and Zhe Li and Changzheng Chen and Xingwei Sun},
keywords = {Artificial immune system, Continual learning, Classification, Antigen-presenting cell, Human-in-the-loop, Local outlier factor},
abstract = {Traditional continual learning methods based on the artificial immune system primarily rely on the distance between antigens and memory cells for classification decisions. These methods suffer from issues such as low-quality memory cell searches and excessive dependence on expert experience when learning new data types. To address these challenges, this paper proposes a continual learning classification method with antigen-presenting cell (APC) region walking based on the artificial immune system (APC-CLCM). In the proposed method, antigen-presenting cells localize antigens by walking in the state space and activate high-quality memory cells, thereby improving the model's classification performance. Additionally, the local outlier factor (LOF) is introduced to guide human-in-the-loop adaptation, enabling APC-CLCM to simultaneously process new data and retain old knowledge. Ablation experiments confirm that the APC mechanism and LOF-guided interaction are crucial for enhancing the model's classification ability and achieving continual learning with new data. Experiments conducted on benchmark datasets demonstrate that APC-CLCM not only exhibits superior classification performance when trained on complete datasets but also effectively learns new tasks without catastrophic forgetting. The results show statistically significant differences compared to existing methods.}
}
@article{ZHOU2026115063,
title = {Soft computing-based crude oil price forecasting through signal decomposition and deep learning integration},
journal = {Applied Soft Computing},
volume = {196},
pages = {115063},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115063},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005119},
author = {Xiaohong Zhou and Najmul Hasan and Yukun Bao and Yanmei Huang and Haijun Huang and Changrui Deng},
keywords = {Crude oil price, Modal decomposition, Hierarchical clustering, Transformer deep learning model},
abstract = {Crude oil prices exhibit nonlinear dynamics driven by geopolitical events and economic cycles, making accurate forecasting crucial yet challenging. This study proposes a novel hybrid deep learning framework that integrates Variational Mode Decomposition (VMD), Agglomerative Nesting (AGNES), Convolutional Neural Networks (CNN), and Transformer architectures. VMD decomposes price series into Intrinsic Mode Functions (IMFs) and a residual. Components are categorized by central frequency, with high-frequency elements clustered and denoised via AGNES to preserve salient fluctuations while suppressing noise. The decomposed signals are fed into a joint CNN-Transformer model, leveraging CNN for local spatial features and Transformers for long-range temporal dependencies to enhance prediction performance. The approach offers: (i) coordinated optimization of decomposition and clustering to retain essential dynamics; (ii) targeted denoising of high-frequency content to improve signal quality; and (iii) integrated spatiotemporal feature learning that improves generalization beyond single-model approaches. Empirical evaluation on Brent and WTI datasets demonstrates that the proposed VMD AGNES CNN Transformer model achieves MAE of 1.7839 and 2.54, MAPE of 2.73% and 3.44%, and RMSE of 2.406 and 3.02, respectively, outperforming ARIMA SSM, CNN TCN, and TCN BiLSTM MLP. These results validate the model’s feasibility and efficacy, providing more reliable decision support for energy market participants.}
}
@article{ANEES2026115091,
title = {Explainable and secure wind power forecasting: SHAP-enhanced framework with feature stability, anomaly detection, and adversarial robustness},
journal = {Applied Soft Computing},
volume = {196},
pages = {115091},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115091},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005399},
author = {V.V. Muhammed Anees and K.P. Abdul Nazar and R. Sridharan and Shijin Maniyath},
keywords = {Wind power forecasting, Machine Learning, Random Forest, Explainable Artificial Intelligence (XAI), SHAP (SHapley Additive exPlanations), Anomaly detection, Adversarial robustness, Feature stability analysis},
abstract = {Machine Learning (ML) has significantly enhanced the forecasting accuraacy of wind energy systems. However, the black-box character of ML models raises questions about transparency, reliability, and security which are the essential elements in maintaining stakeholder confidence in AI-driven renewable energy systems. This research establishes an interpretable wind power forecasting framework that combines Random Forest predictions with SHAP-based explainability and security-oriented validation to effectively address these challenges. Utilizing SCADA data from a 1.5 MW onshore wind turbine (Sinovel SL1500/90, Yalova, Turkey), the framework demonstrates exceptional forecasting accuracy (R²=0.9233, RMSE=344.89 kW, MAE=167.07 kW) surpassing AdaBoost, SVR, KNN, and LASSO by 0.41–10.87% across comprehensive expanding window cross-validation. SHAP analysis identifies wind speed as the main predictor with minimal variability (CV=5.2%, SRCC=1.0). In contrast wind direction exhibits greater fluctuations (CV=37.3%) despite a stable ranking, thus guiding sensor maintenance prioritization. Three components designed to enhance security reinforce operational deployment: (i) feature stability analysis that quantifies predictor consistency across temporal partitions; (ii) SHAP-enhanced iForest achieving the lowest FPR (4.93%) among five anomaly detection methods, thereby reducing unnecessary dispatches by 21% and providing interpretable fault diagnostics; and (iii) adversarial robustness validation confirming a performance retention of 95.76% (R²=0.8842) under realistic sensor noise conditions (±0.75 m/s, ±10.8°), with SHAP attribution stability (ASS=120.44 kW) ensuring consistent interpretability. A comprehensive ablation study confirms the contribution of each component, while a practical use case illustrates a 75% reduction in diagnostic time for yaw misalignment detection. The framework converts black-box predictions into transparent, actionable decision-support, facilitating more efficient defect diagnosis, predictive maintenance planning, and energy loss mitigation achieving a higher benefit-cost ratio with quantifiable operational benefits for wind farm stakeholders.}
}
@article{LU2026115095,
title = {Zero persistent-memory template optimization for UAV tracking},
journal = {Applied Soft Computing},
volume = {196},
pages = {115095},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115095},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005430},
author = {Qian Lu and Guixi Liu and Hanlin Huang and Ruke Xiong and Zhiyu Wu and Yi Zhang},
keywords = {Object tracking, Unmanned aerial vehicle, Small target, Weight optimization, Frequency channel attention},
abstract = {Siamese-based trackers have achieved remarkable success in UAV tracking. However, most existing methods rely on template update strategies that consume substantial memory and are susceptible to noise interference. To address these limitations, we propose a Zero Persistent-Memory Template Optimization framework (ZMOTO). The core innovation of ZMOTO lies in completely eliminating the dependency on historical templates, instead empowering the model with an innovative online adaptive mechanism that enables robust, frame-wise independent decision-making. Within this framework, an Adaptive Initial Template Robust Region Update mechanism performs confidence-guided heuristic refinement of critical template regions, enabling robust online adaptation without cross-frame memory. Simultaneously, a lightweight frequency-domain attention module performs task-driven soft filtering on features, enhancing anti-interference capability at the source. Furthermore, the Boundary-Sensitive Loss ensures precise localization of small targets by adaptively weighting boundary uncertainties. Extensive experiments show that ZMOTO achieves a success score of 0.652 and a precision of 0.854 on the UAVDT dataset, while ablation studies further indicate that it maintains robust performance across various challenging scenarios.}
}
@article{ZENG2026115067,
title = {A novel large-scale multi-objective particle swarm optimization based on distribution direction of pareto set},
journal = {Applied Soft Computing},
volume = {196},
pages = {115067},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115067},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005156},
author = {Ji-Xiang Zeng and Min-Rong Chen and Guo-Qiang Zeng and Ze-Yan Zhang and Zi-Hua Guo and Song-Xiang Zhong},
keywords = {Large-scale multi-objective optimization, Particle swarm optimization, Pareto set},
abstract = {In recent years, particle swarm optimization (PSO)-based multi-objective evolutionary algorithms have been increasingly utilized to address large-scale multi-objective problems (LSMOPs). Nevertheless, these methods exhibit two critical limitations when applied to LSMOPs: (1) Inadequate convergence pressure that compromises solution quality. (2) Insufficient population diversity leading to local convergence. To address these problems, this paper proposes a novel large-scale multi-objective particle swarm optimization algorithm based on the distribution direction of the Pareto set (PS). The algorithm is primarily composed of two components: (1) In order to seek the promising region and improve the efficiency of convergence, at the beginning of each generation, the distribution directions of PS are detected in the decision space. (2) An improved PSO strategy with a promising region-specific searches mechanism is proposed to avoid blind search within the current population, which helps maintain the diversity of the population at the same time. Our algorithm is compared with six state-of-the-art MOEAs, and the results show that our algorithm is highly competitive on large-scale multi-objective optimization benchmark problems with 1000 to 5000 decision variables.}
}
@article{FAN2026115010,
title = {An asynchronous parallel symbolic regression approach based on multiobjective genetic programming with GPU acceleration},
journal = {Applied Soft Computing},
volume = {196},
pages = {115010},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115010},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004588},
author = {Lei Fan and Zhaobing Su and Xiyang Liu},
keywords = {Symbolic regression, Problem decomposition, Global and local regression, Asynchronous parallelism, Multiobjective genetic programming, GPU acceleration},
abstract = {Symbolic regression is an explainable machine learning approach to data analysis, which aims to distill analytical data-driven models that are represented as mathematical expressions by optimizing both the parameters and structure. Commonly used genetic programming based symbolic regression algorithms often suffer from low efficiency and the effects of blind search, model bloat and diversity loss when dealing with massive data. This paper improves the performance of genetic programming based symbolic regression algorithms via handling these effects, task parallelism and hardware acceleration. We propose an asynchronous parallel framework based on multiobjective genetic programming algorithms, in which problem decomposition and elite sharing strategies are used to quickly produce various high-quality models and crosswise evolve elite models among different subtasks. In this way, such cross-evolution of elite models among subtasks can improve the model generalization, evolving efficiency and population diversity. Moreover, a tailor-made hybrid CPU-GPU acceleration strategy based on the compute unified device architecture is designed for the proposed algorithm by offloading model evaluations and, reducing the memory usage pressure and the communications between the CPU and GPUs. Ablation and comparison experiments are conducted to evaluate the proposed framework. The results demonstrate the positivity and effectiveness in data depiction, bloat-control and time-efficiency of the proposed framework. The proposed algorithm framework achieves 6.5-12.4× speedup for ground-truth problems and 5.1-13.4× for black-box problems with CPU implementations respectively and, accordingly 6.1-365.5× and 4.4-188.4× speedup with CPU-GPU implementations against the standard multiobjective genetic programming based symbolic regression algorithm in terms of average model exploration rate. Accelerated by two GPUs, it achieves 2.6-28.2× and 2.6-15.2× speedup for the proposed asynchronous parallel approach on the ground-truth and black-box benchmarks with large datasets respectively.}
}
@article{LI2026115086,
title = {Structural displacement prediction for concrete dams via interpretable sequence-to-sequence modeling with simplified gating structure},
journal = {Applied Soft Computing},
volume = {196},
pages = {115086},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115086},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600534X},
author = {Mingchao Li and Shun Qin and Qiubing Ren and Jin Yuan and Shun Dong and Dawen Tan},
keywords = {Dam displacement prediction, Sequence-to-sequence, Improved recurrent unit, Attention mechanism, Model interpretability},
abstract = {Reliable displacement prediction is crucial for dam safety monitoring and early-warning. Longer monitoring sequences are usually more informative for modeling the behavioral dynamics of dam structure. Most existing data-driven models, however, struggle with handling extremely long sequences, as they mainly prioritize the latest data information. For dam operators, the interpretability deficit of such black-box methods further undermines their operational credibility in real-world applications. In this paper, we propose an interpretable deep learning model, termed Bahdanau attention-based sequence-to-sequence single-gate recurrent unit (abbreviated as BAS2S-SgRU), which aims to address the long-term displacement prediction problem. BAS2S-SgRU consists of three main components, namely SgRU, S2S encoder-decoder module, and attention mechanism. Specifically, the designed SgRU features only one gate, which is a simplified gating structure to simulate dynamic displacement behavior by incorporating the temporal dependency in both environmental factors and structural responses. The S2S architecture, composed of an encoder and a decoder, excels in modeling sequential monitoring data with varying lengths, and BA further endows it with the ability to capture implicit long-term dependencies, alleviating the error propagation in multi-step prediction. Moreover, the attention mechanism enhances the physical interpretability of BAS2S-SgRU via attention weights, explicitly linking modeling results with context information. The effectiveness of the proposed model is verified using the monitoring data from a real concrete dam project, with a set of comparisons made among our model and other advanced methods. The results show that BAS2S-SgRU achieves the impressive RMSE, MAE, and R2 values of 0.104 mm, 0.082 mm, and 98.22% on the dataset while training for only 3.14 s/epoch, consistently outperforming all baseline models in displacement prediction. The approach developed in this work holds significant potential for structural health monitoring of concrete dams.}
}
@article{RIZKI2026115107,
title = {Hybrid artificial bee colony-fuzzy logic framework with advanced sliding mode control for adaptive maximum power point tracking in standalone photovoltaic systems},
journal = {Applied Soft Computing},
volume = {196},
pages = {115107},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115107},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005557},
author = {Habiba Rizki and Jawhar Aiboudi and El-Mahjoub Boufounas and Aumeur {El Amrani} and Lahcen Bejjit},
keywords = {Photovoltaic systems, Backstepping sliding mode control, Power reaching law, Artificial bee colony algorithm, Fuzzy logic controller, Maximum power point tracking},
abstract = {This paper proposes a hybrid control framework for standalone photovoltaic (PV) systems by integrating Backstepping Sliding Mode Control with Power Reaching Law (BSMC-PRL), Artificial Bee Colony (ABC) optimization, and Fuzzy Logic Controller (FLC) adaptation. The control architecture consists of two coordinated stages: Maximum Power Point Tracking (MPPT) in the DC-DC converter and power quality regulation in the DC-AC inverter. The ABC algorithm enables global optimization of control parameters, while the FLC ensures real-time adaptability, forming an autonomous tuning mechanism. This combination of bio-inspired optimization and adaptive fuzzy logic addresses key challenges in nonlinear and time-varying power systems. The proposed strategy is validated through MATLAB simulations under standard test conditions, dynamic environmental variations, changing load profiles, and real climatic data from Errachidia, Morocco. Progressive integration of control techniques demonstrates clear improvements: conventional Sliding Mode Control (SMC) achieves a response time of 0.358 s, chattering amplitude of 0.27 V, efficiency of 99.10%, and Total Harmonic Distortion (THD) of 0.12%. The ABC-optimized BSMC-PRL improves performance with a 0.270 s response time, 0.18 V chattering, and 99.45% efficiency. The fuzzy-adaptive BSMC-PRL achieves the best results, with a response time of 0.148 s, chattering of 0.15 V, 99.70% efficiency, and ultra-low THD of 0.01%. These findings confirm the robustness and effectiveness of the proposed approach for enhanced energy harvesting and power regulation in standalone PV systems.}
}
@article{CHEN2026114986,
title = {Feature selection based on fuzzy dominance neighborhood and promotional condition entropy in interval-valued ordered decision systems},
journal = {Applied Soft Computing},
volume = {196},
pages = {114986},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114986},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004345},
author = {Benwei Chen and Xianyong Zhang and Xia Liu and Zhiying Lv},
keywords = {Feature selection, Interval-valued ordered decision system, Neighborhood fuzzy dominance degree, Conditional entropy, Granulation non-monotonicity},
abstract = {Feature selections (FSs) facilitate classification learning for various data environments, and they usually rely on knowledge granulations and information measurements. For interval-valued ordered decision systems and their related FSs, the enhancement of information integrity and the improvement of anti-noise ability have become important research directions. However, the current neighborhood fuzzy dominance degree (N-FDD) has characterization defects and thus its granulation cannot effectively identify noise impacts, while the existing credibility-based condition entropy (CE) lacks complete class information. These two reasons motivate corresponding improvement space. In this paper, both an improved N-FDD and a promotional CE are proposed, and they induce a two-dimensional framework for uncertainty measurements and FSs; thus, 2×2 CEs and FSs are systematically acquired by two-dimensional combination, and FSs contain a recent algorithm and three improved algorithms. Firstly, improved N-FDD is defined by introducing the logistic sigmoid function and a single noise parameter, and its optimal characterization induces the high-quality neighborhood granulation. Then, credibility-based CE is promoted to coverage-credibility-based CE, 2×2-systematic CEs emerge based on N-FDD improvement and CE promotion, and they acquire size relationships and granulation non-monotonicity. The CE, information entropy, joint entropy and mutual information are systematically constructed, and they obtain system equations and calculation algorithms. Furthermore, FSs are researched by N-FDDs-based CEs and their granulation non-monotonicity, and 2×2=4 heuristic algorithms are established by feature significances. Finally, N-FDDs, CEs, and FSs are experimentally validated, and new FS algorithms offer better classification performances over contrastive algorithms.}
}
@article{BEIGZADEH2026115038,
title = {HMT-KD: Lightweight deep learning model for ECG analysis using hierarchical multi-teacher knowledge distillation framework},
journal = {Applied Soft Computing},
volume = {196},
pages = {115038},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115038},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004862},
author = {Nasim Beigzadeh and Abdolhossein Fathi},
keywords = {Deep learning, Electrocardiogram, Lightweight model, Multi-teacher model, Hierarchical knowledge distillation},
abstract = {With the rapid expansion of intelligent healthcare systems, the demand for accurate yet lightweight deep learning models capable of real-time electrocardiogram (ECG) analysis has grown substantially. While traditional deep models achieved high diagnostic accuracy, their high computational resource requirement hinder integration into clinical decision support and wearable health-monitoring systems. To overcome this challenge, this study introduces a Hierarchical Multi-Teacher Knowledge Distillation (HMT-KD) framework, where three deep neural networks with different structure and model size collaboratively try to enhance and train a lightweight student model. At first, transfer learning technique along with fine tuning is employed for two high-capacity teacher networks, ResNet-18 with SENet and MobileNetV2, to act as advanced feature extractors. Then, a Teacher Assistant (TA) network, as an effective intermediary model, is trained using the Knowledge Distillation (KD) method based on the responses by both teachers. Finaly the lightweight student, which has similar architecture to the TA is trained under the joint supervision of the two teachers and the TA through two parallel learning pathways: 1) response-based KD from both primary teachers and the TA, and 2) feature-based KD from the intermediate layers of the TA. Experimental results on PTB-XL and Chapman datasets show that the student model reduces parameter count by over 100 times compared to the ResNet-18 +SENet teacher while maintaining high diagnostic performance 85.45% accuracy and 96.53% AUROC on PTB-XL and 94.42% accuracy and 98.86% AUROC on Chapman. These findings demonstrate the proposed framework’s effectiveness in creating lightweight, accurate, and real-time ECG-based diagnostic models.}
}
@article{AMOR2026115143,
title = {Generative Adversarial Network-based machine learning framework for mapping and predicting nanostructures distribution in nanoparticulate composites},
journal = {Applied Soft Computing},
volume = {196},
pages = {115143},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115143},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005910},
author = {Nesrine Amor and Muhammad Tayyab Noman and Michal Petru},
keywords = {Machine learning, CT-GAN, Copula-GAN, SHAP, ANN},
abstract = {Accurately predicting nanoparticles size and understanding their distribution mechanism in nanoparticulate composites remain major challenges due to their complex and nonlinear nature. While advanced Machine Learning (ML) algorithms show promise in addressing these issues, their adoption is often hindered by limited interpretability and lack of robust analytical frameworks. This study proposes an interpretable ML framework for predicting nanoparticles size and their distribution in nanoparticulate composites. A Generative Adversarial Network (GAN) was implemented, along with its enhanced variants, i.e., Conditional Tabular-GAN (CT-GAN) and Copula-GAN, to improve data synthesis and prediction accuracy. The models were trained on an experimental (real/original) dataset of 150 samples, acquired from controlled experiments, and an augmented set of 1650 records after GAN-based synthetic generation (150 real + 1500 synthetic). The results reveal that Copula-GAN exhibited superior performance in enhancing dataset diversity and model accuracy. Several ML models, including artificial neural networks, extreme gradient boosting, random forest, linear regression, k-nearest neighbors, adaptive boosting, and decision trees, were employed for performance comparison. Using a real dataset augmented with CT-GAN/Copula-GAN, Extreme Gradient Boosting with Bayesian (XGBB) optimization achieved R2 = 0.95, Root Mean Squared Error (RMSE) = 0.12, and Mean Absolute Error (MAE) = 0.09 when validated against independent experimental measurements. Model interpretability was achieved using Shapley Additive Explanations (SHAP) analysis, highlighting most influential parameter for both outputs. The proposed framework was validated against experimental data, confirming its high reliability and robustness in predicting the behavior of nanoparticulate composites.}
}
@article{PEI2026115099,
title = {A cognitive load assessment method for digital museum interactive interfaces based on multi-criteria decision-making},
journal = {Applied Soft Computing},
volume = {196},
pages = {115099},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115099},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005478},
author = {Huining Pei and Yanjun Zhang and Hao Gong and Yuxin Cao and Mingzhe Yang and Zhonghang Bai and Man Ding},
keywords = {Cognitive load assessment, Interactive interface, Digital museum, Multi-criteria decision making, Eye-tracking technology, Weighting method, TODIM method},
abstract = {The interactive interface of a digital museum serves as the primary medium between users and digital cultural heritage resources. Effective management of cognitive load is essential for enhancing users’ access to cultural information and improving their visiting experience. To objectively and accurately quantify the relationship between the interface design and cognitive load, this study proposes a cognitive load assessment model that integrates subjective and objective weighting methods with an improved The Tomada de Decisão Interativa Multicritério (TODIM) method. First, a multi-criteria decision-making (MCDM) framework was established, combining the Full Consistency Method (FUCOM) for subjective weights, the LOgarithmic Percentage Change-driven Objective Weighting (LOPCOW) method for objective weights, and a Staircase -weighted Discretized Borda Counting (DBC)–optimized TODIM method for alternatives ranking. Second, an evaluation index system incorporating multiple eye-movement metrics and subjective assessment indicators was constructed. A 3 × 3 × 3 mixed-factor eye-tracking experiment is conducted to obtain cognitive load data. Third, the proposed model is used to evaluate the cognitive load associated with 27 digital museum interfaces. Finally, validation results indicate robust and stable performance. Sensitivity analysis yields correlation coefficients K > 0.9770 and S > 0.9970 across all θ values (θ = 1–10), consistently ranking P7 as optimal (rank 1) and P21 as least favorable (rank 27). Comparisons with SEWM-TODIM, zBWM-TODIM, and IT2Fs-TODIM produce highly consistent ranking outcomes, showing that the proposed method generates weight configurations that balance accuracy and interpretability. Moreover, the approach effectively reconciles decision uncertainty and efficiency while maintaining a lightweight structure, thereby ensuring good operability and robust performance in fuzzy and complex decision-making scenarios.}
}
@article{TOULAOUI2026115151,
title = {Efficient vision transformers via patch selective soft-masked attention and knowledge distillation},
journal = {Applied Soft Computing},
volume = {196},
pages = {115151},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115151},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005995},
author = {Abdelfattah Toulaoui and Hamza Khalfi and Imad Hafidi},
keywords = {Vision transformer, Patch selection, Soft masking, Efficient inference},
abstract = {Vision transformers (ViTs) have emerged as powerful tools, achieving state-of-the-art performance across a variety of tasks, thanks to their versatile self-attention mechanism. However, the quadratic computational complexity of self-attention poses significant challenges, particularly when processing high-resolution images. To address this limitation, we introduce a novel framework for vision transformers that enables patch-selective attention, allowing the model to focus on the most salient image regions while efficiently disregarding less critical areas. This selective approach reduces the computational cost, achieving a substantial reduction in FLOPs without sacrificing accuracy. Additionally, we leverage knowledge distillation to enhance the performance of lightweight and efficient transformer models, further advancing their practicality for resource-constrained applications. Extensive experiments demonstrate that our method consistently matches or outperforms existing state-of-the-art approaches in both accuracy and efficiency, highlighting the effectiveness of our design.}
}
@article{YU2026115135,
title = {PoetRAT: A poetry retrieval augmented thoughts framework for Chinese classical poetry generation},
journal = {Applied Soft Computing},
volume = {196},
pages = {115135},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115135},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005831},
author = {Zheping Yu and Yuqi Ren and Tongxuan Zhang and Guiyun Zhang},
keywords = {Chinese classical poetry generation, Retrieval-augmented generation, Large language models},
abstract = {Chinese classical poetry, a treasure of Chinese culture, embodies the artistic wisdom and profound thoughts of ancient scholars. Traditional methods and LLMs often struggle to capture the complexity and artistic depth required for its automatic generation, particularly in adhering to strict prosody rules, integrating writing techniques, and achieving thematic depth. To address these issues, we propose the PoetRAT, a Poetry Retrieval Augmented Thoughts framework, which combines Chain of Thought (CoT) prompting with partial inspiration from the Retrieval Augmented Generation (RAG) paradigm. The framework simulates the human creative process by retrieving prosody rules and writing techniques and constructing a Chain of Thought on thematic depth. To facilitate retrieval, we built a Prosody Knowledge Base (ProsodyKB) and a Poetry Techniques Knowledge Graph (PoetTechKG), which are retrieved to provide structured guidance on prosody and writing techniques, enhancing the prompt and improving the overall quality of poetry generation. Experimental results demonstrate that without model retraining, the framework achieves near-perfect format accuracy, with an average improvement of over 95% in format accuracy and 20–30% gains in rhyme accuracy without retraining. Crucially, human evaluations validate that this structured planning significantly elevates artistic quality, achieving superior ratings in thematic meaning and aesthetic value. Furthermore, our efficiency analysis highlights that PoetRAT effectively eliminates the preparation debt of fine-tuning, offering a robust solution for instant deployment.}
}
@article{CHEN2026115088,
title = {Enhancing adversarial example detection in DNNs: A joint CAE-TextCNN approach},
journal = {Applied Soft Computing},
volume = {196},
pages = {115088},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115088},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005363},
author = {Zigang Chen and Deyang Xie and Yingrong Liu and Zhangqi Wang and Haihua Zhu and Xiangzhong Wang},
keywords = {Adversarial example, Deep neural networks, Adversarial detection, Convolutional autoencoder},
abstract = {Deep Neural Networks (DNNs) have demonstrated remarkable success across various domains, including image classification. However, the vulnerability of DNNs to adversarial examples, which are subtly perturbed inputs designed to mislead model predictions, poses significant security risks. Traditional adversarial defense methods, such as adversarial training and input reconstruction, often compromise model accuracy or struggle with complex datasets. This paper introduces a novel adversarial example detection method that integrates a Convolutional Autoencoder (CAE) for feature extraction and TextCNN for classification. Unlike conventional approaches, our method transforms high-dimensional image features into one-dimensional sequences and proposes a Feature Alignment Module (FAM) to align feature dimensions, enabling effective detection without relying on the target model’s internal structure. Experimental results on CIFAR10, CIFAR100, and SVHN datasets demonstrate superior performance, with AUC scores exceeding 0.99 against various adversarial attacks, including FGSM, JSMA, and C&W. Our method also exhibits exceptional performance on the higher-resolution IMAGENETTE dataset. It not only excels in complex datasets but also offers a model-agnostic defense framework, providing a robust solution for enhancing DNNs’ security.}
}
@article{YAO2026115080,
title = {Self-calibrated dual contrasting for annotation-efficient bacteria Raman spectroscopy clustering and classification},
journal = {Applied Soft Computing},
volume = {196},
pages = {115080},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115080},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005284},
author = {Haiming Yao and Wei Luo and Tao Zhou and Ang Gao and Xue Wang},
keywords = {Raman spectroscopy, Bacterial identification, Annotation-efficient learning, Contrastive representation, Self-calibration},
abstract = {Raman scattering is based on molecular vibration spectroscopy and provides a powerful technology for pathogenic bacteria diagnosis using the unique molecular fingerprint information of a substance. The integration of deep learning technology has significantly improved the efficiency and accuracy of intelligent Raman spectroscopy (RS) recognition. However, the current RS recognition methods based on deep neural networks still require the annotation of a large amount of spectral data, which is labor-intensive. This paper presents a novel annotation-efficient Self-Calibrated Dual Contrasting (SCDC) method for RS recognition that operates effectively with few or no annotations. Our core motivation is to represent the spectrum from two different perspectives in two distinct subspaces: embedding and category. The embedding perspective captures instance-level information, while the category perspective reflects category-level information. Accordingly, we have implemented spectral augmentation and performed a dual contrastive learning approach from embedding and category perspectives to obtain discriminative representations, which are applicable for Raman spectroscopy recognition under both unsupervised and semi-supervised learning conditions. Furthermore, a self-calibration mechanism is proposed to enhance robustness. Validation of the identification task on three large-scale bacterial Raman spectroscopy datasets— Bacterial ID, Bacterial Stains, and Marine Pathogen Bacteria—demonstrates that our SCDC method achieves robust recognition performance under annotation-free or few-annotation (5% or 10%) settings, with average recognition accuracy gains of +4.9% and +0.9% over the best existing methods, respectively. This highlights the potential of the proposed method for biospectral identification in annotation-efficient clinical scenarios.}
}