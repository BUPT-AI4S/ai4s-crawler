@article{JIA2026114936,
title = {ECTDSC-FPNet: An efficient contextual transformer and depthwise separable convolutional feature pyramid network combining multi-strategy loss optimization for apple leaf and disease segmentation},
journal = {Applied Soft Computing},
volume = {194},
pages = {114936},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114936},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003844},
author = {Junhao Jia and Jianlong Wang and Zhaozhao Xu and Shan Li and Yake Zhang and Wenfeng Feng},
keywords = {Disease spot segmentation, Cross-entropy loss, Contextual transformer, Depthwise separable convolutions, Triplet attention mechanism},
abstract = {How to rapidly and precisely segment apple leaves and diseases in complex environments is a critical challenge. Existing high-precision models suffer from high computational complexity and fail to efficiently segment small diseases. Therefore, combining different strategies of loss, a feature pyramid network with efficient contextual transformer and depthwise separable convolution is proposed, which is named ECTDSC-FPNet. For feature extraction of dense small diseases in complex backgrounds, the encoder employs contextual transformer with triplet attention. Further addressing model lightweighting requirements, the decoder adopts depthwise separable convolution to progressively restore features through encoder skip connections. Considering pixel imbalance, false positive and negative trade-offs, and boundary ambiguity, the loss function integrates cross-entropy with error functional modulation, Tversky loss, and online hard example mining, respectively. Experimental results demonstrate that ECTDSC-FPNet achieves 97.66% and 84.17% IoU for leaf and disease segmentation, respectively, outperforming lightweight CGNet by 15.77% and high-precision UNet by 1.03% in disease IoU. The proposed network also exhibits superior performance in inference speed and FLOPs compared to mainstream segmentation networks, providing an efficient end-to-end solution for leaf and disease segmentation.}
}
@article{YE2026114839,
title = {Multi-attribute decision-making model using trigonometric Einstein aggregation operators of intuitionistic fuzzy credibility values and its application in the selection of industrial robots},
journal = {Applied Soft Computing},
volume = {194},
pages = {114839},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114839},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002875},
author = {Jun Ye and Rui Yong and Shigui Du},
keywords = {Decision making, Intuitionistic fuzzy credibility set, Intuitionistic fuzzy credibility value, Trigonometric Einstein operation, Trigonometric Einstein aggregation operator},
abstract = {It is well known that Einstein operations are typical algebraic operations. Then the various existing Einstein operations of intuitionistic fuzzy values (IFVs) cannot include the periodic operation capability. Therefore, they are not appropriate for tackling some periodic/multitemporal information operations and decision-making (DM) problems in real-world scenarios. Then, an intuitionistic fuzzy credibility value (IFCV) can better represent the mixed information of the true and false membership values and the credibility levels to guarantee the credibility levels of the true and false membership values. However, some periodic/multitemporal aggregation algorithms for IFCVs are needed to solve the periodic DM problem more adequately. To reach this target, our study first offers trigonometric Einstein operations and operation laws of IFCVs by integrating the sine and arcsine functions into Einstein operations and gives the score and accuracy formulas of IFCVs and their sorting rules for IFCVs. Then, we present the IFCV sine and arcsine trigonometric Einstein weighted averaging (IFCVSATEWA) and geometric (IFCVSATEWG) operators and their features. Next, we develop a multi-attribute DM model based on the IFCVSATEWA and IFCVSATEWG operators to solve multitemporal/periodic DM problems in an intuitionistic fuzzy credibility environment. Finally, the developed model is applied to an actual example of the industrial robot choice and then the sensitivity and comparison analyses are presented to validate the validity and rationality of the developed model.}
}
@article{GARCIAPEDRAJAS2026114912,
title = {False flag: An evolutionary false labeling approach for multilabel classification},
journal = {Applied Soft Computing},
volume = {194},
pages = {114912},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114912},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003601},
author = {Nicolás E. García-Pedrajas and José M. Cuevas-Muñoz and Manuel Mendoza-Hurtado and Javier Pérez-Rodríguez and Aida {de Haro-García}},
keywords = {Multilabel problems, False labels, Missing labels, Evolutionary computation},
abstract = {Multilabel classification tackles scenarios where each sample concurrently belongs to multiple binary classes, referred to as labels. The task of learning multilabel datasets is harder than single-label classification. In addition to its inherent complexity, low-density label datasets, noisy labels, and complex relationships between labels make this problem extremely difficult. In this paper, we present a new approach, false flag labeling, which is based on modifying the labels of the instances in the training set to obtain a new training set that can improve the classification model’s performance. We assume that adding new relevant labels to the training set or removing relevant labels from it may improve the results of the learning algorithm, making the search for separation surfaces easier. We do not assume that the added labels correspond to the actual labels of the instances that were missed in the dataset labeling process, nor do we assume that the removed labels correspond to erroneously labeled instances. We use an evolutionary algorithm to approach the false labeling process as an optimization process. An extensive comparison using 50 datasets and seven classification models demonstrates the advantageous performance of our approach.}
}
@article{CHEN2026114952,
title = {Hierarchical and asynchronous dynamic hypergraph network for stock trend prediction},
journal = {Applied Soft Computing},
volume = {194},
pages = {114952},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114952},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600400X},
author = {Xi Chen and Zhi Zhang and Zhijie He and Dui Liu and Liwei Guan},
keywords = {Dynamic hypergraph neural network, Hierarchical sampling, Asynchronous aggregation, Channel attention, Stock trend prediction},
abstract = {Reliable prediction of stock dynamics requires capturing dependencies among stocks and their temporal evolution. However, traditional graph neural networks constrained by static structures struggle to model the complex high-order dependencies in financial markets. To address this challenge, a hierarchical and asynchronous dynamic hypergraph neural network (HA-DHN) is proposed to model evolving high-order relations and integrate heterogeneous features across stocks. HA-DHN constructs a sequence of hypergraphs that combine static market structures with price-driven dynamic relations, incorporating a temporal decay factor to emphasize recent market movements. Technical indicator sequences are transformed into image feature maps using the graph-in-node representation, from which a convolutional neural network extracts technical vectors. In parallel, sentiment dynamics are captured through a Transformer encoder. A hypergraph neural network with hierarchical sampling and multi-scale aggregation is employed based on node importance and hyperedge connectivity to enhance representation efficiency. Finally, dual-channel asynchronous aggregation combined with channel attention aligns and fuses embeddings from different domains. Experiments across multiple markets show that HA-DHN generally outperforms baselines and the buy-and-hold strategy in both classification and financial evaluations, demonstrating its potential for practical investment applications.}
}
@article{ZHOU2026114973,
title = {Fully interpretable rectal cancer staging prediction by TSK fuzzy classifier with its small sample learning on MR images},
journal = {Applied Soft Computing},
volume = {194},
pages = {114973},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114973},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004217},
author = {Erhao Zhou and Jin Zhang and Yichen Sun and Shitong Wang},
keywords = {Rectal cancer staging prediction, Magnetic resonance imaging (MRI), Takagi-Sugeno-kang (TSK) fuzzy system, Small sample learning (SSL)},
abstract = {Existing magnetic resonance imaging (MRI) of rectal cancer for staging prediction task encounters serious dilemmas including both insufficient image data caused by the patient’s privacy and security concerns, and no interpretability caused by black-box prediction behaviors of the adopted classifiers like deep neural networks. To alleviate the above dilemmas, this study develops a fully interpretable rectal cancer staging prediction method called RCSP-FIMG-TSK by improving fully interpretable Takagi-Sugeno-Kang (TSK) fuzzy system FIMG-TSK. Except for sharing the advantages like full interpretability and output stability of FIMG-TSK, RCSP-FIMG-TSK has the following characteristics: (1) Comprehensible feature extraction is performed on MR images for guaranteeing that all fuzzy rules are rooted at each of salient yet comprehensible feature; (2) To realize small sample learning (SSL) on MR images, the proposed method trains FIMG-TSK through the consideration of two additional regularization terms in the learning objective, which aims at providing more generalization of the corresponding Gaussian Mixture Model (GMM) on small data; (3) The learning objective of RCSP-FIMG-TSK can be optimized in an analytical yet optimal solution to the weight of each rule. Experimental results on small rectal cancer datasets demonstrate the effectiveness of RCSP-FIMG-TSK in terms of testing performance, computational complexity and full interpretability.}
}
@article{FAN2026114944,
title = {TSCM: Enhancing multivariate time series forecasting with dual-stream temporal-spatial correlation modeling},
journal = {Applied Soft Computing},
volume = {194},
pages = {114944},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114944},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003923},
author = {Shiming Fan and Hua Wang and Fan Zhang},
keywords = {Time series forecasting, Channel relationship, Spatial and temporal correlation, Patch-based modeling, Attention mechanisms, Non-stationarity},
abstract = {Multivariate time series forecasting (MTSF) requires modeling time-varying cross-variable dependencies; however, such dependencies are easily distorted by noise and non-stationarity, leading to spurious correlations and unstable interactions. To address this challenge, we propose TSCM, a dual-stream spatiotemporal correlation modeling framework that explicitly factorizes correlation learning into (i) an inter-sequence stream for cross-variable dependency modeling and (ii) an intra-sequence stream for within-variable temporal regularities. Specifically, TSCM introduces a cross-channel query constructed by aggregating spatial sub-block tokens to inject globally informed cross-channel context, and adopts cycle-aware querying with autoregressive offsets to improve the robustness of periodic modeling. A lightweight spatial mixer then fuses the two streams into a unified spatiotemporal representation for prediction. Across ten real-world benchmarks, TSCM achieves consistently strong performance. Moreover, a paired Wilcoxon signed-rank test against CycleNet yields p-values of 9.77×10−3 (MSE) and 4.88×10−2 (MAE), indicating that the improvements are statistically significant.}
}
@article{MOHAMED2026115005,
title = {Wearable interface for real-time gait phase recognition using sensor networks},
journal = {Applied Soft Computing},
volume = {194},
pages = {115005},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115005},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004539},
author = {Samer A. Mohamed and Uriel Martinez-Hernandez},
keywords = {Wearables, Bayesian methods, Robot operating system (ROS), Real-time, Artificial neural networks, Gait, Machine learning},
abstract = {Robust gait phase recognition is essential for gait analysis, biomechanical monitoring, and human-centered robotics. A significant gap persists between computational methods and field deployment spanning generalizability, computational budget, hardware optimization, and integration with robotic frameworks. This study presents a reproducible wearable system that bridges this gap by combining robust, real-time recognition with minimal modalities. The proposed probabilistic heuristic recognition algorithm for sequential events (PHRASE) leverages statistical modeling and artificial neural networks (ANNs) to achieve robust low-latency detection. The system integrates two inertial measurement units (IMUs) and a portable microcomputer within a Robot Operating System (ROS) framework, enabling seamless integration with external systems. The method was validated against benchmarks on 31 participants with diverse biometrics, sensor models, and physical conditions during multi-scenario level-ground walking, outperforming 5 state-of-the-art deep learning benchmarks. PHRASE demonstrates strong generalization, achieving an accuracy of 95.00±3.78% specifically across diverse unseen subjects, conditions, and experimental setups combined. The accuracy improvement over the best-performing benchmark has a 95% confidence interval of [1.90%,6.51%]. The wearable interface maintains a stable average inference latency of 11.6 ms. Overall, the proposed interface addresses key limitations in terms of resilience to unseen subjects, unseen sensor configurations, varying walking speeds, and latency. The source code and implementation details are available at: https://github.com/SamMans/PHRASE/tree/main.}
}
@article{ZHANG2026114847,
title = {MSMF-DBNet: Dual-branch model for pulmonary disease recognition with multi-scale feature enhancement and multichannel fusion},
journal = {Applied Soft Computing},
volume = {194},
pages = {114847},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114847},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002954},
author = {Bochao Zhang and Yuwei Gu and Diyang Fu and Linfu Zhou and Xiaojun Wang and Liquan Guo and Jiping Wang},
keywords = {Pulmonary disease recognition, Multi-channel information, Multi-scale features, Attention mechanism, Tunable Q-factor Wavelet Transform(TQWT), Kolmogorov-Arnold Network(KAN)},
abstract = {Respiratory diseases are major global health concerns, and AI-powered auscultation offers promising advancements in diagnosis. However, existing methods rely on fixed-window time-frequency representations, overlooking the dynamic nature of lung sounds and inter-frequency correlations. Additionally, current models depend on time-step annotations, overlooking global information from multi-channel auscultation. To address these issues, this study proposes MSMF-DBNet, a dual-branch pulmonary disease recognition model integrating multi-scale feature enhancement and multi-channel information fusion. The time branch integrates an improved iTransformer, designed to fuse multi-channel information, while the frequency branch extracts multi-scale features using Tunable Q-factor Wavelet Transform (TQWT), coupled with an attention mechanism and channel shuffling to enhance inter-frequency interactions. Extracted features are fused, and a Kolmogorov–Arnold Network (KAN) replaces the traditional MLP layer to improve nonlinear representation and interpretability, enhancing classification accuracy. To objectively evaluate the proposed method, we conducted comprehensive experiments on publicly available datasets, structured into multi-level tasks, and compared its performance with state-of-the-art approaches. The proposed method demonstrated superior performance compared to state-of-the-art approaches across various datasets and tasks, achieving significant improvements while maintaining interpretability. This approach holds promise for optimizing medical resource allocation, enabling more efficient and accessible diagnostic services, and paving the way for more precise and automated digital auscultation technologies in clinical settings.}
}
@article{XU2026114939,
title = {TLDA: A lightweight and adaptive deep learning framework for accurate monthly runoff forecasting},
journal = {Applied Soft Computing},
volume = {194},
pages = {114939},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114939},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600387X},
author = {Dong-mei Xu and Qi-qi Zeng and Wen-chuan Wang and Qiang Ma},
keywords = {Runoff prediction, Multi-scale features, Lightweight, Dynamic adaptability, Hybrid attention mechanism},
abstract = {To address the limitations of traditional single-strategy models in handling hydrological time series prediction, especially in capturing long-range dependencies, local patterns, and dynamic features, this study proposes a novel model for monthly runoff forecasting, TLDA (Temporal Learning and Dynamic Adjustment). TLDA is designed to tackle the stochasticity and nonlinearity of runoff data by integrating several advanced components. These include the TCN-GLU layer with causal dilated convolution for long-term dependencies, the lightweight bidirectional LightLSTM for long-term memory, the DyT layer for dynamic feature modulation, the Hybrid attention mechanism merging local and global attention for multi-scale features, and a feature distillation layer for optimized feature representation. Through these integrated components, TLDA effectively captures both local trends and prolonged runoff information dependencies. Experiments conducted across three hydrometric stations demonstrate that TLDA significantly improves prediction accuracy. Compared to the Transformer, TLDA reduces MAE by 31.2% and RMSE by 35.7% at Fenglehe Station, and achieves an NSE of 0.9498 and a KGE of 0.9516 at Hongshanhe Station, representing improvements of approximately 10.5% in NSE and 12.8% in KGE compared to the standard Transformer model. Furthermore, visualization of learned temporal weights in the DyT layer demonstrates its hydrological interpretability, showing dynamic adaptation to flood peaks and base flows. These results highlight TLDA's superiority as an efficient new approach for monthly runoff prediction, with significant practical and theoretical implications.}
}
@article{LI2026114916,
title = {Future fund holding prediction based on dynamic time-differential fund-asset networks},
journal = {Applied Soft Computing},
volume = {194},
pages = {114916},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114916},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003649},
author = {Shangzhe Li and Yingke Liu and Xueyuan Chen and Xin Jiang and Junran Wu and Ke Xu},
keywords = {Fund-asset network, Graph neural network, Holding prediction},
abstract = {Accurate prediction of future fund holdings, based on historical holding sequences, is critical for risk management and profit maximization. Unlike stock price or movement prediction, fund holding prediction faces unique challenges due to its complexity and sparsity of available data. Existing methods often rely on strict assumptions about fund composition and asset returns, which limit their applicability and accuracy. To address these limitations, we propose a novel fund holding prediction framework, which abandons traditional return-based data and instead leverages the time differences in fund disclosure to capture dynamic fund-asset relationships, enabling the prediction of holdings across all types of funds. Specifically, we construct a dynamic fund-asset network to capture historical and latest holding relationships, employ an attention mechanism to model temporal dependencies between funds and assets, and integrate information through a gated update module to enhance prediction accuracy. Using real-world portfolio data of 10,134 funds, our method significantly outperforms existing baselines, demonstrating its capability to predict holdings across diverse fund types. This method not only contributes to more accurate fund holding prediction but also offers practical implications for investors, fund managers, and regulators by improving risk management, decision-making, and market transparency. Furthermore, the framework can be applied to other financial contexts where temporal dependencies and network structures play a significant role.}
}
@article{PRZEWOZNICZEK2026114924,
title = {On discovering and analyzing variable dependencies to construct an effective and efficient optimizer dedicated to solving the new real-world multi-objective resource-allocation problem},
journal = {Applied Soft Computing},
volume = {194},
pages = {114924},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114924},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003728},
author = {Michal Witold Przewozniczek and Pawel Borys Myszkowski and Witold Kościukiewicz and Mateusz Wójcik and Adam Gonczarek and Adam Korkus},
keywords = {Multi-objective genetic algorithms, Parameter-less population pyramid, Multi-objective human resource allocation problem, Real-world optimization problem},
abstract = {Frequently, various problem-dedicated optimizers are proposed when a real-life problem is identified. Usually, the problem-dedicated mechanisms are based on the problem features that directly arise from the problem definition. In this work, we identify the real-world multi-objective problem considering the allocation of human resources, but we follow a different approach to propose an effective optimizer. First, we analyze the nature of variable inter-dependencies in the obtained problem instances. Then, using the results of the above analysis, we choose the population management framework and the appropriate operators. We consider the recent advances in the Evolutionary Optimization of discrete problems and the older, well-known propositions that have been shown to be effective in solving real-world problems using real and artificial instances. The obtained optimizer is a parameter-less hybrid that significantly outperforms all other state-of-the-art optimizers.}
}
@article{WANG2026114864,
title = {GraphSiamese: Novel spatial-temporal slow feature fusion network for industrial process quality prediction},
journal = {Applied Soft Computing},
volume = {194},
pages = {114864},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114864},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003121},
author = {Jiayu Wang and Weili Xiong and Le Yao and Xiaoyu Jiang and Xiaohui Cui and Wei Yu and Brent Young},
keywords = {Quality prediction, Spatial-temporal slow feature, Siamese network, Graph convolutional network, Industrial process},
abstract = {Complex nonlinearities and slow dynamics are common characteristics that should be considered in industrial process modeling. However, the intrinsic physical relationships among process variables, especially the spatial and temporal correlations, have received less attention. To leverage these relationships, a novel Graph Siamese network (GraphSiamese) is proposed to extract the spatial-temporal slow features of process data based on an encoder–decoder structure of graph convolutional networks (GCNs). In GraphSiamese, the process graph is learned by canonical correlation analysis of intricate interactions between the process variables. Then, the GCN is substituted for the autoencoder of a traditional Siamese network, focusing on capturing slow features of industrial processes with a graph structure. The network is trained in an end-to-end manner to simultaneously reconstruct the original inputs and the adjacency matrix, capture slow features, and predict quality variables. By visualizing the graph-structured slow features across both spatial-temporal fusion aspects, the proposed method enhances interpretability of a soft sensing model, moving beyond traditional black-box models. The effectiveness of the GraphSiamese method is validated through a public sulfur recovery unit benchmark and a real CO2 absorption column case, demonstrating its robustness and accuracy in industrial process quality prediction modeling.}
}
@article{ZHANG2026114977,
title = {Two-stage multi-object tracking via low confidence dynamic adaptive matching enhancement for autonomous driving},
journal = {Applied Soft Computing},
volume = {194},
pages = {114977},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114977},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004254},
author = {Fan Zhang and Yue Hu and Zheming Li and Dinghui Luo},
keywords = {Autonomous driving, Detection confidence, Multiple object tracking},
abstract = {Multi-object tracking is a key technology in autonomous driving perception. In complex scenarios such as target occlusion, small targets, and insufficient light, the detector generates a large number of low-confidence detections, and irrational processing of low-confidence detections can easily lead to tracking failures or trajectory breaks. To address the issue, we propose a two-stage multi-object tracking model (LMETrack) based on low confidence dynamic adaptive matching enhancement. Our model introduces a dynamic adaptive matching strategy that balances the reliance on visual appearance versus motion consistency, adapting to the quality of each detection in real-time. Unlike traditional frameworks that rely on fixed thresholds and static matching strategies, LMETrack introduces a dynamic adaptive mechanism based on detection confidence, which can significantly improve the robustness and accuracy of data association under target occlusion and low-confidence conditions. It also employs optical flow motion compensation technology for motion correction of images. Additionally, we employ a two-step recovery strategy that prioritizes clear targets while actively salvaging potential objects from low-confidence noise using motion cues, ensuring continuous tracking even under occlusion, effectively reducing the probability of missed detections and enhancing trajectory continuity. Experiments on the MOT17 and MOT20 datasets demonstrate that our model achieves MOTA performance metrics of 78.9% and 78.4%, respectively. This performance improvement strongly demonstrates that LMETrack effectively solves the problems of trajectory breakage and identity switching caused by low-confidence detections in complex scenarios. Furthermore, the model was deployed in actual vehicles, confirming its generalizability and robustness in standard scenarios, mining environments, and severe weather conditions.}
}
@article{SUN2026114940,
title = {Physics-informed gated network for solving nonlinear partial differential equations},
journal = {Applied Soft Computing},
volume = {194},
pages = {114940},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114940},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003881},
author = {Yanhua Sun and Huanhe Dong and Jiuyun Sun and Yong Fang and Yuan Kong},
keywords = {Partial differential equations, Physics-informed neural networks, Gated recurrent units, Physics-informed gated networks, Regional weight optimization},
abstract = {Partial differential equations (PDEs) are extensively utilized to describe physical phenomena across diverse fields and play an essential role in scientific research. Recently, Physics-Informed Neural Networks (PINNs) have exhibited considerable potential in providing highly accurate numerical solutions to PDEs. Motivated by PINNs, this paper proposes Physics-Informed Gated Networks (PIGNs) for solving PDEs. PIGNs replace the conventional network architecture of PINNs with Gated Recurrent Units (GRUs). This modification enables PIGNs to capture and retain temporal dependencies more effectively. Additionally, a Regional Weight Optimization (RWO) strategy is introduced to PIGNs to optimize the weights assigned to different regions. The RWO strategy consists of a stepwise-weighting mechanism and a modified learning rate annealing algorithm. The stepwise-weighting mechanism generates local multipliers that assign greater weights to information-intensive intermediate regions and challenging termination moment regions during the optimization process. The modified learning rate annealing algorithm generates global multipliers for balancing different loss terms. Finally, the performance of PIGNs and the RWO strategy is evaluated by learning solutions of the convection–diffusion equation, the Korteweg-de Vries equation, the Nonlinear Schrödinger equation and the Chen-Lee-Liu equation. The experimental results show that PIGNs provide more accurate predictions than PINNs. Furthermore, the RWO strategy enhances the accuracy of PIGNs.}
}
@article{KUMAR2026114980,
title = {Transformer with multi-head attention mechanism for bearing fault detection},
journal = {Applied Soft Computing},
volume = {194},
pages = {114980},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114980},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600428X},
author = {Prashant Kumar and Izaz Raouf and Muhammad Muzammil Azad and Heung Soo Kim},
keywords = {Bearing fault, Transformer, Multi-head attention, Vibration},
abstract = {Timely fault detection of bearings is vital to ensure the uninterrupted functioning of rotating machinery in industry. Research on fault detection strategy for bearings has accelerated due to developments in artificial intelligence and computation, although managing large amounts of intricate sensor data remains complex. The traditional approaches rely on handcrafted features and shallow learning models, which in high-dimensional sensor data, may struggle to capture complex fault patterns. Using the transformer model with a multi-head attention mechanism, this work designs an innovative bearing fault detection method. Transformer architecture, renowned for its efficacy in natural language processing applications, is tailored to handle sequential sensor input efficiently, without requiring identifiable features. The multi-head attention mechanism enables the model to capture both local and global dependencies that are essential for fault recognition, which aids in the model’s focus on various input sequence segments. The model was evaluated on a two real-world benchmark bearing dataset namely, Case Western Reserve University (CWRU) bearing dataset and Society for Machinery Failure Prevention Technology (MFPT) bearing dataset and compared with the deep learning baselines. This work also eliminated the need for extensive data processing and achieved superior fault detection accuracy. The results reveal the efficacy of the transformer model with multi-head attention in accurately detecting bearing faults, showcasing its potential for real-time condition monitoring in industrial scenarios. These findings demonstrate transformers’ contribution to predictive maintenance advancement, guiding the industry toward scalable, real-time monitoring that reduces downtime and increases sustainability. The future work could integrate the edge computing for on-device use and adapt to multi-fault scenarios.}
}
@article{RIHAO2026114920,
title = {A fault diagnosis approach for unbalanced SCADA data of wind turbines based on uniform contrastive learning},
journal = {Applied Soft Computing},
volume = {194},
pages = {114920},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114920},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003686},
author = {Huang Rihao and Ma Liangyu and Gao Haitian and Yang Xiyun},
keywords = {Wind turbines, Unbalanced SCADA data, Fault diagnosis, Contrastive learning, Multi-task learning},
abstract = {The long-term operation of wind turbines in complex environments leads to a wide variety of fault types and imbalanced data distributions, which significantly limit the diagnostic capabilities of traditional deep learning methods for such datasets. To address this issue, this paper proposes a fault diagnosis method based on the Uniform Contrastive Learning (UCL) framework. This method integrates multi-task learning with contrastive learning and introduces three strategies: hard sample mining, class balance weighting, and adaptive class center guidance, optimizing the intra-class compactness and inter-class separability in the feature space. Validated on real SCADA datasets from multiple regions, our UCL framework significantly outperforms existing mainstream methods in terms of macro F1-score and G-mean. It demonstrates particular excellence in recognizing minority-class faults and improving overall diagnostic accuracy. This approach not only provides an efficient and stable solution for wind turbine fault diagnosis but also offers valuable insights for other imbalanced data classification tasks.}
}
@article{HAN2026114993,
title = {LANR-GNN: Label-aware neighborhood resampling graph neural network for credit bond default prediction},
journal = {Applied Soft Computing},
volume = {194},
pages = {114993},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114993},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004412},
author = {Che Han and Aihua Li and Yuxue Chi and Qinyan Wei and Yong Shi},
keywords = {Credit bond default, Graph neural networks, Class imbalance, Relational modeling, Default prediction},
abstract = {Credit bonds play a vital role in financing economic development but also threaten financial stability through default risks. Current research primarily focuses on bond characteristics while overlooking structured knowledge of inter-bond relationships. Although GNN demonstrates advantages in modelling relational knowledge, their performance is substantially constrained by class imbalance in credit default prediction. To address these challenges, we have constructed a new knowledge-infused credit bond network dataset, which explicitly encodes real-world bond correlation information derived from market data. Building upon this dataset, we propose LANR-GNN, a novel graph neural network that differs from prior GNN-based approaches by integrating feature evaluation, label-aware neighborhood resampling, feature concatenation, and a minority-class weighted loss to better capture relational dependencies under imbalance. Empirical results demonstrate that LANR-GNN effectively exploits bond relationship knowledge and outperforms baselines in handling imbalanced relational data. Additionally, the model exhibits generalization capability on public datasets. Our work provides financial regulators with a novel model for systemic risk monitoring and offers methodological insights for imbalanced graph learning.}
}
@article{ZHANG2026114896,
title = {Localization of myocardial infarction based on omnidirectional vision feature aggregation driven by 3D point-clouds},
journal = {Applied Soft Computing},
volume = {194},
pages = {114896},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114896},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003443},
author = {Xianbin Zhang and Gui-bin Bian and Xiaoyun Zhang and Daniel S. {da Silva} and Richard Millham and Jianyu Huang and Victor Hugo C. {de Albuquerque} and Lin Xu and Wanqing Wu},
keywords = {Myocardial infarction localization, Vectorcardiogram, 3D point-cloud, Omnidirectional vision, Feature aggregation},
abstract = {Accurate localization of myocardial infarction (MI) is essential for timely intervention and limiting irreversible damage. Conventional ECG-based approaches often rely on handcrafted features or one- or two-dimensional projections, which underuse the three-dimensional dynamics of cardiac electrical activity. In this work, we propose a three-layer point-cloud-based framework for MI localization and detection, integrating geometric representation, spatiotemporal modeling, and safety-oriented deployment strategies. In the representation and modeling layers, Frank-lead vectorcardiogram (VCG) signals are reinterpreted as three-dimensional geometric trajectories and encoded as point-cloud representations. A PointNet++-based multi-scale residual encoder extracts local geometric features, while a temporal Transformer aggregates sub-segments to capture long-range spatiotemporal dependencies without relying on beat-level segmentation. An auxiliary sub-segment supervision branch further stabilizes optimization and enhances territory discrimination. For safety and deployment, Monte Carlo dropout is used to estimate predictive uncertainty, and SHAP-based explanations provide physiologically interpretable saliency patterns. A lightweight triage strategy automatically accepts high-confidence predictions, requests additional short segments for borderline cases, and routes low-confidence samples to clinician review. Inter-patient experiments on PTB and PTB-XL show that the proposed method achieves MI localization accuracies of 71.7% and 87.8%, and MI detection accuracies of 97.4% and 92.1%, respectively. With the uncertainty-guided triage strategy, overall localization accuracy on PTB is further improved from 71.7% to 77.3%, and macro-F1 increases from 69.1% to 74.9%. Robustness tests under nine types of noise perturbations confirm stable detection performance and improved localization accuracy with noise-aware training. Overall, the proposed three-dimensional point-cloud framework provides a geometry-aware, interpretable, and deployment-oriented solution for MI localization and broader cardiovascular signal analysis.}
}
@article{ZHANG2026115009,
title = {Least Squares Support Vector Regression with probabilistic linguistic information},
journal = {Applied Soft Computing},
volume = {194},
pages = {115009},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115009},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004576},
author = {Chonghui Zhang and Yingxin Chen and Jingfang Xu},
keywords = {LS-SVR, Probabilistic linguistic term set, Distribution assessment, Kernel function, Temperature scaling},
abstract = {Least Squares Support Vector Regression (LS-SVR) is widely employed in machine learning for its computational efficiency in transforming convex quadratic programming problems into linear systems. However, when handling semantic information characterised by Probabilistic Linguistic Term Sets (PLTSs), existing approaches often convert linguistic terms into crisp or fuzzy numbers for regression analysis, potentially resulting in information loss and diminished predictive performance. To address this issue, this paper proposes the PLTS input and PLTS output LS-SVR (PIPO-LS-SVR) model. For linear scenarios, a parameter-interpretable Linear PIPO-LS-SVR model was constructed by incorporating the weighted averaging operator for distribution assessments and the distribution bias term. For non-linear cases, a two-stage Non-linear PIPO-LS-SVR model was further developed by employing kernel functions to capture the intrinsic non-linear mappings between PLTS variables and integrating temperature scaling to address the probabilistic calibration problem. Finally, empirical analyses using online hotel reviews and air quality assessment data demonstrate that the proposed method significantly outperforms existing benchmarks, reducing prediction error by at least 19%. Ablation studies further confirm that the temperature scaling mechanism significantly rectifies probability distribution biases in non-linear models, empowering the model with the capability to adaptively regulate semantic hesitation.}
}
@article{YUE2026114815,
title = {Toward wafer defect detection: An incremental industrial large model with prompt-aware memory replay},
journal = {Applied Soft Computing},
volume = {194},
pages = {114815},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114815},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002632},
author = {Ke Yue and Jipu Li and Shuhan Deng and Zhuyun Chen and Chee Keong KWOH and Weihua Li},
keywords = {Industrial large models, Wafer defect detection, Incremental learning, Large language models, Memory replay},
abstract = {Semiconductor manufacturing introduces evolving defect patterns that challenge conventional wafer defect detection systems, which rely on static models and fully labeled data. Existing methods often fail to offer both incremental adaptability and semantic interpretability. To bridge these gaps, we propose IncILM, a novel incremental industrial large model for wafer defect detection that integrates both visual and language modalities to support interpretable and lifelong wafer defect detection. The proposed IncILM leverages class-level template descriptions to encode domain-expert knowledge as stable semantic representations using a pretrained large language model. To mitigate catastrophic forgetting across learning stages, we further introduce a prompt-aware memory replay mechanism that preserves representative exemplars and soft prompts. Furthermore, IncILM adopts a multi-objective optimization strategy to jointly preserve prior knowledge and adapt to newly emerging defect patterns. Extensive experiments on the WM-811K and MixedWM38 datasets demonstrate that IncILM not only surpasses state-of-the-art baselines in accuracy and knowledge retention, but also provides fine-grained, language-aligned defect interpretations. Our findings highlight the potential of industrial-scale language models in enabling scalable, interpretable, and incrementally extensible wafer defect detection.}
}
@article{ZHANG2026114928,
title = {An exergy-related unsupervised domain adaptation broad learning system framework for fault diagnosis in multimode batch manufacturing processes},
journal = {Applied Soft Computing},
volume = {194},
pages = {114928},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114928},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003765},
author = {Chuanfang Zhang and Zhibin Huang and Hanwen Zhang and Wenxiao Yin and Kaixiang Peng},
keywords = {Unsupervised domain adaptation, Broad learning system, Kernel canonical variable analysis, Manifold regularization, Local domain alignment, Fault diagnosis},
abstract = {Fault diagnosis in multimode batch manufacturing processes faces several challenges, including high data acquisition costs, limited model adaptability to dynamic environments, and restricted generalization across domains. To overcome these issues, this paper proposes a novel exergy-related unsupervised domain adaptation broad learning system (EUDABLS) framework. The framework integrates the broad learning system (BLS) with manifold regularization (MR) and local domain alignment (LDA) to enhance cross-domain feature alignment and diagnostic accuracy under domain shift conditions. It utilizes kernel canonical correlation analysis (KCCA) to extract physically interpretable exergy-related features, which offer physical interpretability by quantifying the transformation between energy quality and quantity, thus reducing the dimensionality of the input data. Additionally, EUDABLS incorporates an incremental learning strategy to dynamically integrate new fault data without retraining the entire model. Experimental validation on a real hot rolling process (HRP) demonstrates the superiority of EUDABLS over state-of-the-art methods, achieving an average accuracy of 94.10% across 12 cross-domain scenarios, which is a 2% improvement over the best baseline, while also enabling incremental learning for the integration of dynamic faults.}
}
@article{WANG2026114831,
title = {TSDP: Diverse task sampling for robust multi-agent reinforcement learning in perturbed environments},
journal = {Applied Soft Computing},
volume = {194},
pages = {114831},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114831},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002796},
author = {Xiao Wang and Yuying Han and Fei Zhang and Dechao Ran and Mingjiang Ji},
keywords = {Multi-agent reinforcement learning, Tasks sampling, Determinantal point processes, Multi-task learning},
abstract = {Multi-Agent Reinforcement Learning (MARL) often exhibits poor generalization when facing unseen or stochastic environmental perturbations due to its limited generalization capabilities. Although Multi-Task Learning improves generalization in single-agent settings, it still relies on extensive task interaction and coverage, which becomes prohibitively costly in the Multi-Task MARL (MT-MARL) setting. To address this, we propose TSDP, a novel training task sampling algorithm based on the Determinantal Point Process, which—as the first non-interactive task sampling algorithm tailored for MT-MARL—constructs a maximally diverse subset of training tasks. TSDP formulates each perturbation-rich environment as a task, decouples test tasks into shared and perturbation-distinct features to build informative task representations, and employs Determinantal Point Processes (DPP) to select representative training tasks. When integrated into a general MT-MARL framework, TSDP significantly enhances cross-task robustness. Extensive experiments on multi-agent benchmarks show that TSDP achieves up to 122.03% performance gain, substantially outperforming existing approaches. To the best of our knowledge, this work is the first to enable non-interactive construction of a high-quality training task set that explicitly suppresses harmful task interactions, while still achieving strong generalization in MT-MARL. Our code is available at https://github.com/Anonymous-MTMAPPO/TSDP.git.}
}
@article{KAUSHIK2026114965,
title = {QEFS: Quantum evolutionary feature selector for a real quantum computer},
journal = {Applied Soft Computing},
volume = {194},
pages = {114965},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114965},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004138},
author = {Bhomic Kaushik and Ankit Rajpal and Naveen Kumar},
keywords = {Quantum evolutionary feature selector (QEFS), Quantum gates (Hadamard Ry CNOT), IBM quantum experience, UCI machine learning repository, Quantum machine learning (QML)},
abstract = {Feature selection is a key problem in many machine learning applications. Wrapper-based feature selection algorithms help select a feature subset that optimally enhances the performance of a specific learning algorithm. However, these algorithms are highly resource-intensive, as considering all subsets of n features would require examining 2n combinations, which is a computationally infeasible task using classical computation. In contrast, quantum computing offers a more efficient representation: the entire space of feature subsets, of size |P|=2n, can be encoded using only log2⁡|P| qubits, enabling compact probabilistic representation and implicit exploration of the search space, compared to the |P| classical bits required by classical methods. Motivated by the expressive power of quantum computing, in this paper, we propose a quantum evolutionary feature selector (QEFS) and evaluate its performance on ibm_brisbane, which has been made available to the scientific community under the IBM Quantum Experience initiative. Rigorous experimentation shows that the proposed QEFS achieves accuracy comparable to that of state-of-the-art evolutionary algorithms. We demonstrate that QEFS employs a constant-depth quantum circuit, representing a significant advancement over classical feature selection approaches. Furthermore, QEFS exhibits strong robustness on real quantum hardware through effective error mitigation, achieving stable performance across multiple runs, minimal probability drift between simulator and QPU executions, and consistent behavior under varying parameter settings, as corroborated by the sensitivity analysis. The implementation of the proposed QEFS is publicly available at: https://github.com/Bhomic-OGJ/QEFS.}
}
@article{SAUBER2026114901,
title = {SPK2VEC: Advanced speaker embeddings transformer model using hybrid supervised and self-supervised contrastive learning},
journal = {Applied Soft Computing},
volume = {194},
pages = {114901},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114901},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003492},
author = {Amr M. Sauber and Mohammed M. Nabil and Mohammed M. Nasef},
keywords = {Speaker embeddings, Supervised, Self-supervised, Contrastive learning, Speech, Transformers, Raw waveform},
abstract = {Speaker embeddings play a vital role in various speech processing tasks, providing a compact and discriminative representation of a speaker's identity. However, speaker embeddings face challenges with multilingual data, underperforming on less-represented languages and struggling with accents. Moreover, balancing accuracy and computational efficiency remains a key challenge for real-time applications. To address these challenges, this paper introduces SPK2VEC, a lightweight transformer-based speaker embedding model designed for robust multilingual speaker representation learning. The proposed model utilizes learnable features from raw speech through a dual-objective joint optimization approach, integrating triplet loss and cross-entropy loss. The proposed model was trained using VoxCeleb1, VoxCeleb2, and the QASR dataset, incorporating Arabic speakers for multilingual training. Despite its compact design, comprising only 2.5 million parameters and a total size of 47 MB, SPK2VEC achieves strong performance across both monolingual and cross-lingual evaluations. Experimental results show that the hybrid learning strategy substantially improves performance for lightweight models, yielding an 86% reduction in EER compared to using either loss independently. Furthermore, the proposed model SPK2VEC attains an EER of 1.22% on VoxCeleb1 test pairs, while maintaining an extremely low real-time factor of 0.0002, making it well suited for real-time, resource-constrained speaker recognition applications.}
}
@article{NEELAMEGAM2026114932,
title = {Hybrid data-driven optimization framework for sustainable concrete incorporating micro ground granulated blast furnace slag, treated construction and demolition waste, and recycled plastic fibres},
journal = {Applied Soft Computing},
volume = {194},
pages = {114932},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114932},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003807},
author = {Prakhash Neelamegam and S. Kanchidurai and Belin Jude Alphonse and Vigneshkannan Suresh},
keywords = {Micro GGBS, Treated construction and demolition waste, SHAP interpretability, Hybrid data-driven optimization, Plastic fibre},
abstract = {The research introduces a new hybrid-based data driven optimization method of sustainable high-performance concrete utilizing micro ground granulated blast furnace slag (GGBS), treated construction and demolition waste (CDW) and recycled plastic fibres. In contrast to previous articles that involved empirical testing, individual machine learning models, the current study brings together random forest (RF) prediction, Gradient-based bounded optimization (L-BFGS-B), SHapley additive explanations (SHAP) to interpretability, and response surface methodology (RSM) for validation as one unified platform. The compressive strength of thirty-six experimental mixtures of M40 concrete with different percentage restrictions of GGBS (0%–30%), CDW aggregates (50%–100%), and PET fibres (0.3%–1.2%). The RF model demonstrated good predictive accuracy (R2 = 0.994), whereas the (L-BFGS-B) found the best mixtures that included 100% CDW and moderate levels of plastic components, and predicted strengths of 49 MPa. SHAP analysis presented clear information about the influence of each variable, which is important because GGBS and CDW interactions are significant, and RSM proved the presence of nonlinear interaction patterns. The experimentally verified mixtures of L-BFGS-B-optimized exhibited comparable compressive strengths to the experiment maximum, and significant environmental benefits. In this study, a reproducible, interpretable, and sustainability-based optimization approach is provided, and the scientific knowledge and practice of data-driven green concrete mix design are promoted.}
}
@article{BAEK2026114907,
title = {Scene graph optimization using hyperedge-based relationship extraction},
journal = {Applied Soft Computing},
volume = {194},
pages = {114907},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114907},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003558},
author = {Ji-Won Baek and Kyungyong Chung},
keywords = {Image captioning, Scene graph optimization, Relation mining, Hypergraph partitioning, Association-rule mining, Graph simplification},
abstract = {Scene graphs offer a structured representation of objects and their relationships within an image and are widely used to improve image captioning by capturing semantic context. However, redundant or irrelevant relations in scene graphs can lead to increased computational complexity and reduced captioning performance. To address these problems, this paper proposes a relation-mining-based scene graph optimization method to enhance both the efficiency and quality of image captioning. Association-rule mining and hypergraph partitioning are used to filter low-significance relationships while emphasizing meaningful object interactions. The optimized scene graph is then inputted into Transformer-based captioning models, including BERT and GPT variants. Experiments conducted on the COCO and Visual Genome datasets demonstrate that the proposed method reduces graph complexity while achieving improvements in BLEU and ROUGE scores over baseline models. Moreover, the proposed method outperforms traditional captioning pipelines in both qualitative and quantitative evaluations. These results confirm the effectiveness of relation mining in enhancing semantic expressiveness and computational efficiency in image-captioning tasks.}
}
@article{TENG2026114935,
title = {An adaptive high-order knowledge guided multi-objective evolutionary algorithm for dynamic community detection},
journal = {Applied Soft Computing},
volume = {194},
pages = {114935},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114935},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003832},
author = {Xiangyi Teng and Chenjie Gao and Jing Liu},
keywords = {Dynamic community detection, Evolutionary algorithms, Multi-objective optimization, Transfer learning},
abstract = {Dynamic community detection is a challenging task due to the continuously evolving structure of real-world networks. Most existing methods divide the network into snapshots and rely on fixed historical information, which limits their adaptability to structural changes. To address this issue, we first introduce the concept of high-order knowledge, which selectively integrates key information fragments from historical snapshots to provide adaptive guidance during detection. Building on this concept, we propose AHKG-MOEA, a multi-objective evolutionary algorithm with an adaptive weighting mechanism that automatically selects and assigns weights to historical snapshots based on their temporal influence. We further design an encoding strategy that incorporates high-order knowledge and a biased mutation operator to enhance knowledge transfer and search efficiency. Extensive experiments on three synthetic datasets and two real-world datasets show that AHKG-MOEA outperforms state-of-the-art methods in both accuracy and robustness.}
}
@article{ZHANG2026114894,
title = {Gaussian mixture probability density function-assisted estimation of distribution algorithm for real-world steelmaking-refining-continuous casting scheduling problems},
journal = {Applied Soft Computing},
volume = {194},
pages = {114894},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114894},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600342X},
author = {Long Zhang and XiaoMing Wu},
keywords = {Steelmaking-refining-continuous casting, Scheduling, Estimation of distribution algorithm, Gaussian mixture probability density function},
abstract = {The steelmaking-refining-continuous casting (SCC) process serves as the core production chain in modern steel manufacturing, where optimal scheduling plays a pivotal role in determining operational efficiency, energy conservation, and product quality metrics. However, the SCC scheduling problem presents significant challenges due to its combinatorial complexity and stringent process constraints. To address this challenging optimization problem, this paper proposes a Gaussian mixture probability density function-assisted Estimation of Distribution Algorithm (GMEDA). The key contributions include: (1) a novel Gaussian mixture probability density function-based probability model that effectively captures the distribution characteristics of elite solutions; (2) a hybrid initialization strategy to enhance population diversity and solution quality; (3) an improved decoding scheme to reduce the average sojourn time for energy conservation; (4) a recombination operator based on the PBX crossover mechanism to enhance global exploration capability; and (5) a problem-specific swap operator designed according to the unique characteristics of the continuous casting constraint. Extensive computational experiments on real‑world production data confirm the superior performance of GMEDA. After 40,000 decoding iterations, GMEDA achieves average improvements of 9.5% in AVG, 6.2% in MIN, and 10.9% in MAX, while maintaining comparable computational time to state-of-the-art scheduling methods. Although its standard deviation (STD) is numerically close to that of the best competitor (IABC), GMEDA achieves "high‑quality stability", whereas IABC exhibits "low‑quality stability". Similar conclusions hold even when the decoding budget is increased. GMEDA also outperforms the DQN‑based scheduler and extends effectively to multi‑objective optimization, outperforming conventional multi‑objective algorithms. These comprehensive results validate GMEDA's practical effectiveness for industrial implementation.}
}
@article{JIAO2026114915,
title = {TIH: Transformer in hyperbolic space for 3D point cloud semantic segmentation},
journal = {Applied Soft Computing},
volume = {194},
pages = {114915},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114915},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003637},
author = {Sihua Jiao and Jian Lu and Kaibing Zhang and Xiaogai Chen},
keywords = {Feature refusion, Hyperbolic space, Semantic segmentation, Transformer},
abstract = {In recent years, point cloud semantic segmentation task based on Transformer model has made a major breakthrough. However, the point pairs projected into the Euclidean space are limited by the differences in location information caused by uneven density. In the projection process, there are widespread problems such as unfair local grouping and blurred boundary features. Due to the issues of dislocation or coverage caused by projection to Euclidean space, points with different semantic labels are incorrectly grouped. Therefore, the grouping methods of most Transformer models are unfair, and this phenomenon is particularly obvious in the local boundary region. In order to solve this problem, we propose a Transformer in Hyperbolic space and name it TIH. TIH first maps the points to the special hyperbolic model of the Poincaré disk, and calculates the relative positional relationship of the points using hyperbolic metrics. At the same time, the multi-level feature refusion module is proposed and applied to the Hyperbolic space, which is used to fuse the shallow features that provide boundary information and the deep features that provide semantic information to improve the segmentation effect in the boundary region. The mIoU value of TIH reaches 73.3%, 77.0% and 71.4% respectively by verifying the results on the datasets of S3DIS, ScanNet and SemanticKITTI. Combined with the visual results, it is proven that this paper effectively solves the problems caused by uneven density.}
}
@article{YANG2026114943,
title = {FinePE: Fine-grained personality editing of large language model via mixture of LoRA experts},
journal = {Applied Soft Computing},
volume = {194},
pages = {114943},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114943},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003911},
author = {Haoran Yang and Yuqi Ren and Tongxuan Zhang and Guiyun Zhang},
keywords = {Large language models, Personality traits, Mixture of experts},
abstract = {Controlling large language models (LLMs) with human-like personality traits is an innovative yet challenging task in advanced dialogue systems. However, existing approaches face a “granularity gap”: prompt engineering often lacks robustness and leads to conflicting trait expression, while standard Supervised Fine-Tuning (SFT) tends to suffer from parameter interference across diverse traits, resulting in averaged personality profiles that fail to manifest distinct or opposing characteristics effectively. To address this, we propose Fine-grained Personality Editor (FinePE), a modular framework that manipulates personality traits via a Mixture of Low-Rank Adaptation (LoRA) Experts. Our approach assigns distinct LoRA modules to specific Big Five subtraits, learning optimal combination weights through a gating mechanism to achieve precise, disentangled personality control. To support this, we construct a high-quality Personality Subtrait Dataset (PSD) comprising 120,000 diverse Q&A pairs across 60 subtraits. In our comparative evaluation, we benchmark FinePE against three categories of baselines: prompt-based methods (e.g., In-Context Learning (ICL), P2), parameter-efficient fine-tuning (S-LoRA, C-LoRA), and latent space editing (ControlLM, NPTI). Experimental results on the AI-adapted Big Five Inventory (BFI) demonstrate that FinePE achieves average induced scores of 4.91 (high-level) and 1.61 (low-level), outperforming the second-best method by 29%. Furthermore, comprehensive analyses validate the framework’s effectiveness from internal representation to external behavior: FinePE not only enhances interpretability through expert-weight visualization and latent space disentanglement but also demonstrates superior robustness and cross-theoretical generalization in open-domain scenarios.}
}
@article{CHEN2026114923,
title = {Metadata matters: Mamba-based cross-modal fusion for medical image classification with metadata},
journal = {Applied Soft Computing},
volume = {194},
pages = {114923},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114923},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003716},
author = {Xu Chen and Xuesong Yin and Guodao Zhang and Jianhao Ding and Ting Shu and Xinjun Miao},
keywords = {Medical image classification, State space model, Cross-modal fusion, Medical metadata, Deep learning},
abstract = {Neural network-based medical image classification assists clinicians in identifying disease types and serves as a core technology for diagnostic support. Due to the high similarity between visual features and the limited labeled data in medical images, the performance of methods relying solely on visual feature extraction continues to be constrained. While preliminary research has investigated the incorporation of medical metadata to alleviate these problems, two critical issues persist: (1) ineffective modeling of the fine-grained semantic relationships between image and text, and (2) the computational overhead of efficient medical text encoding. To address these issues, we propose the Mamba-based Medical Metadata Net (TriMNet), a cross-modal fusion model grounded in State Space Models (SSM). We design a metadata encoder based on SSM, leveraging Mamba’s linear computational complexity and implicit state space modeling capabilities to enhance inference speed. Additionally, TriMNet incorporates a Cross-modal Gated Fusion Module (CGFM) to adaptively capture semantic associations between image regions and textual metadata. Furthermore, we introduce a modality-aware loss weighting strategy to improve the performance on rare disease types and enhance generalization across heterogeneous datasets. Experiments conducted on MedIMeta and PAD-UFES-20 demonstrate that TriMNet outperforms both single-modal and baseline models in classification accuracy. Notably, on PAD-UFES-20, our approach achieves a 1.4% improvement over the state-of-the-art.}
}
@article{LIU2026114895,
title = {Detecting atrial fibrillation from heart sounds using dual-branch feature fusion and Kolmogorov–Arnold networks},
journal = {Applied Soft Computing},
volume = {194},
pages = {114895},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114895},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003431},
author = {Jing Liu and Feng Zhao and Hongbo Yang and Yan Chen and Weilian Wang},
keywords = {Atrial fibrillation detection, Heart sound analysis, Feature fusion, Kolmogorov–arnold networks, Deep learning},
abstract = {Atrial fibrillation (AF) is a prevalent cardiac arrhythmia associated with severe complications such as stroke and heart failure. Although electrocardiography (ECG) is the clinical gold standard, it is often impractical for large-scale or primary-care screening. This study proposes a non-invasive heart sound–based AF detection framework that integrates dual-branch feature extraction, attention-based fusion, and interpretable nonlinear modeling. Specifically, mel-frequency cepstral coefficients (MFCCs) and bispectrum features are extracted to characterize complementary perceptual and higher-order nonlinear properties of heart sounds. Two parallel DenseNet branches are employed to learn discriminative representations, which are adaptively fused using a channel-attention mechanism. The fused features are then classified by a Kolmogorov–Arnold Network (KAN), enabling flexible nonlinear modeling through learnable spline functions. Experiments conducted on a clinically collected dataset of 4065 heart sound recordings demonstrate that the proposed method achieves an accuracy of 94.33%, recall of 92.57%, and an AUC of 0.9640, outperforming several mainstream deep learning baselines. Ablation studies confirm the effectiveness of both the attention-based fusion strategy and the KAN classifier. Furthermore, external validation on a public dataset yields a macro-F1 score of 0.9589, indicating good generalization capability. These results suggest that combining complementary acoustic features with adaptive fusion and interpretable nonlinear learning provides an effective and practical solution for low-cost, scalable AF screening based on heart sounds.}
}
@article{SUNDAR2026114657,
title = {Optimal planning of microgrids with uncertain generation and stochastic EV charging/discharging: Hybrid approach},
journal = {Applied Soft Computing},
volume = {194},
pages = {114657},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114657},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001055},
author = {R. Sundar and P. Rajesh and Manikandan {Chidambara Sekar} and B. Trinadha},
keywords = {Electric vehicle, Renewable energy sources, Charging stations, Micro grid, Jellyfish search optimization, Hierarchical deep learning neural network},
abstract = {The increasing reliance on Renewable Energy Sources (RES) and the growing adoption of Electric Vehicles (EVs) are transforming the landscape of energy management within micro grids. However, this transition presents several challenges, including voltage instability, unpredictable load variations, and the integration of diverse energy sources. This manuscript develops a novel hybrid approach, combining the joint performance of the jellyfish search optimization (JSO), and the hierarchical deep learning neural network (HDLNN), usually known as the JSO-HDLNN method. Here, the maximum use of RESs and the minimized voltage deviations (VD) and tie-line (TL) are considered the main objectives of the work. Additionally, the JSO method is used to optimize the control parameters of the DC–DC converter, while the HDLNN approach predicts operational parameters of the micro grid. The proposed approach decreases the error in both measured and predicted voltages while effectively determining the parameter. The proposed method is excluded on the MATLAB software and analysed with existing algorithms like Recall-Enhanced Recurrent Neural Network with sand cat swarm optimisation (RERNN-SCSO), Gannet Optimization Algorithm with Tree Hierarchical Deep Convolutional Neural Network (GOA-THDCNN) and Artificial Neural Network with Particle Swarm Optimization (ANN- PSO). Quantitative results examine the efficacy of the proposed technique: it achieves the lowest CO₂ emissions among tested techniques at 140 kg CO₂ per MWh, indicating enhanced environmental sustainability. Additionally, the JSO-HDLNN method achieves superior accuracy with an error rate of 0.012% lower than GOA – THDCNN at 0.021% and ANN-PSO at 0.026%. In terms of voltage stability, it reduces deviation to 1.24 per unit, showcasing its effectiveness in enhancing micro grid reliability. These findings suggest that the proposed JSO-HDLNN technique is a robust, efficient solution for modern micro grid applications.}
}
@article{HENNA2026114911,
title = {Fast-gradient-guided generative adversarial learning for explainable cyber threat intelligence},
journal = {Applied Soft Computing},
volume = {194},
pages = {114911},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114911},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003595},
author = {Shagufta Henna and Upaka Rathnayake},
keywords = {Explainable AI, Adversarial machine learning, Domain generation algorithms, Generative adversarial networks, Fast gradient method, Cyber threat intelligence, Model transparency},
abstract = {The rapid evolution of Domain Generation Algorithm (DGA)-driven attacks and obfuscated DNS traffic exposes fundamental weaknesses in conventional machine learning-based threat detection systems, particularly under adversarial manipulation. This study introduces FGM-GAN, a hybrid adversarial learning framework that synergistically combines gradient-based Fast Gradient Method (FGM) perturbations with adaptive Generative Adversarial Network (GAN)-based perturbations to improve both robustness and interpretability of deep neural networks for DNS threat classification. Unlike existing adversarial defenses that rely on model-specific perturbations, FGM-GAN explicitly learns class-conditional adversarial distributions for benign, phishing, and malware domains. This design enables the generation of realistic, feature-aligned perturbations that exhibit strong cross-model transferability. Experiments were conducted on the 32-feature CIC-BELL-DNS-2021 dataset (approximately 7000 labeled samples) using 5-fold cross-validation, hybrid perturbations with α=0.5 and ε≤0.1, and evaluated against baseline DNN, SVM, Random Forest, KNN, and Decision Tree classifiers using accuracy and robustness metrics. Comprehensive evaluation demonstrates that FGM-GAN consistently improves robustness across diverse adversarial attacks (FGM, PGD, MIM, C&W) while maintaining stable performance across folds. Ablation studies and reduced-capacity variants confirm that gains arise from the hybrid adversarial mechanism rather than over-parameterization or hyperparameter tuning, and statistical significance tests verify the reproducibility of results. To enhance transparency and operational trust, the framework integrates multi-level explainable AI analyses spanning feature, neuron, and layer representations. These analyses consistently identify a compact set of high-impact DNS features and reveal structured adversarial propagation patterns, showing that robustness emerges from semantically meaningful representation learning. Collectively, these findings position FGM-GAN as a scalable and interpretable adversarial learning solution that jointly addresses robustness, transferability, and explainability in real-world DNS-based cybersecurity environments.}
}
@article{HALIKE2026114754,
title = {FSA-net: Frequency-based spatial-temporal attention network for robust liver CT classification},
journal = {Applied Soft Computing},
volume = {194},
pages = {114754},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114754},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002024},
author = {Ayiguli Halike and Mo Sha and Lianghui Xu and Gan Sen and Zhihao Zhang},
keywords = {Spatial-temporal attention, High-noise, Spiking neural network, Medical image classification},
abstract = {The accurate classification of CT images of the liver is essential for the early diagnosis and treatment of liver diseases. However, high-noise environments pose significant challenges to existing methods, often resulting in reduced classification accuracy and reliability. To address this issue, this study proposes a novel Frequency-based Spatial-temporal Attention Network (FSA-Net) to improve feature extraction and classification performance in high-noise settings. The core module of FSA-Net is the Frequency-based Spatial Temporal Attention (FSTA) module, which effectively addresses the challenges of feature extraction in high-noise environments by leveraging frequency information to separate liver tissue characteristics from noise and integrating Spatial-Temporal features to significantly boost the network’s feature extraction capabilities. As one of the core components of FSA-Net, the Spiking Neural Network (SNN) module enhances adaptability to high-noise environments by optimizing the aggregation of spatial-temporal features. Experimental results in three vertebral-level datasets demonstrate that FSA-Net consistently outperforms state-of-the-art methods, achieving a peak accuracy of 86.47%, an F1 score of 86.80% and an AUC of 89.61%. These results validate FSA-Net as an effective and robust solution for liver CT classification in high-noise environments. This study highlights the potential of our method to improve diagnostic reliability under challenging clinical imaging conditions and contributes a novel framework to the field of medical image analysis.}
}
@article{ZHANG2026114964,
title = {A noise-robust feature selection using KNN and weighted fuzzy rough sets for imbalanced multi-scale data},
journal = {Applied Soft Computing},
volume = {194},
pages = {114964},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114964},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004126},
author = {Xiaoyan Zhang and Jingwen Wang},
keywords = {Weighted KNN fuzzy neighborhood rough set, Generalized multi-scale decision table, Scale-based tree, Dynamic feature selection},
abstract = {Feature selection methods that are robust to noise and capable of handling imbalanced data are essential for improving classification accuracy. Although various noise-resistant methods have been developed, few address the combined challenges of noise and class imbalance within a unified framework. The KNN fuzzy neighborhood rough set (KNN-FNRS) model integrates fuzzy set theory with rough set approximations and is effective for feature selection in uncertain environments. However, it remains vulnerable to noisy samples and often performs poorly on highly imbalanced class distributions. To address these limitations, we propose a weighted KNN fuzzy neighborhood rough set (WKNN-FNRS) model. Sample quality evaluation metrics are introduced to quantify instance reliability and assign adaptive neighbor weights that down-weight noisy or low-quality examples. This enhances noise tolerance and improves performance on imbalanced datasets. The WKNN-FNRS model is further embedded in a multi-scale decision framework, and a scale-based tree reduction algorithm is developed. This algorithm constructs and prunes hierarchical scale trees to transform multi-scale data into a single-scale representation. This process preserves both coarse and fine-grained information, improving feature evaluation accuracy. A dynamic feature selection algorithm is then designed to incrementally refine the feature subset based on weighted rough set approximations, avoiding costly retraining when samples or attributes change. For evaluation, we inject class-specific Gaussian perturbations into up to 50% of samples and test on twelve benchmark datasets that span a wide range of imbalance ratios. All experiments follow a stratified nested cross-validation protocol (outer 10-fold, inner 5-fold); feature selection and hyperparameter tuning are performed strictly inside the outer training folds to avoid information leakage. We compare against multiple baselines using KNN, SVM and NB classifiers, report mean ± std over outer folds, and validate significance with appropriate statistical tests. Ablation studies (No Weight, No Fuzzy, Single Scale) and targeted parameter-sensitivity analyses confirm the contribution of each module and the stability of the method. Results show that WKNN-FNRS with scale reduction and DFS consistently outperforms competing methods in classification accuracy, noise resilience and computational efficiency.}
}
@article{MA2026115016,
title = {Progressive curriculum learning with adaptive graph attention networks for flexible job shop scheduling problem},
journal = {Applied Soft Computing},
volume = {194},
pages = {115016},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115016},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004643},
author = {Nanfeng Ma and Xifan Yao and Kun Hu},
keywords = {Flexible job shop scheduling problem, Deep reinforcement learning, Graph attention networks, Dynamic graph learning, Curriculum learning, Production scheduling},
abstract = {The flexible job shop scheduling problem (FJSSP) is a critical combinatorial optimization challenge in modern manufacturing systems, requiring simultaneous decisions for both machine assignment and operation sequencing. Traditional approaches often fail to capture the complex interdependencies between jobs and machines, especially in large-scale instances with diverse operational constraints. To address these limitations, this paper proposes a novel deep reinforcement learning (DRL) framework that integrates graph attention networks (GATs) with dynamic graph learning and curriculum learning methodologies (GAT-DGL-CL). The framework incorporates a curriculum learning strategy that systematically transitions from simplified problem instances to full complexity during training, enabling stable convergence and robust policy development. We introduce an adaptive GAT architecture with dynamic structure learning capabilities that autonomously discovers optimal connectivity patterns between scheduling entities, eliminating the dependency on predefined graph topologies. The dynamic graph learning module employs relationship type-aware multi-head attention mechanisms to capture heterogeneous scheduling relationships while maintaining computational efficiency through sparsity regularization. The complete framework operates within a proximal policy optimization (PPO) architecture enhanced with generalized advantage estimation (GAE) for stable policy updates. Comprehensive experimental evaluation on six benchmark datasets demonstrates superior performance, achieving relative percentage deviations (RPD) of 15.69% on Barnes, 12.13% on Brandimarte, 11.65% on Dauzère-Pérès, and 16.14%, 12.35%, and 5.29% on Hurink edata, rdata, and vdata datasets, respectively—consistently ranking first or second among DRL approaches. The learned graph structures exhibit interpretable scheduling patterns and demonstrate strong generalization capabilities across varying problem scales.}
}
@article{DONG2026114867,
title = {Data-driven multi-task global optimization with two-stage knowledge transfer for blended-wing-body underwater gliders design},
journal = {Applied Soft Computing},
volume = {194},
pages = {114867},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114867},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003157},
author = {Huachao Dong and Jing Wang and Wenxin Wang and Jiangtao Shen},
keywords = {Multi-task optimization, Global optimization, Two-stage knowledge transfer, Expensive constrained multi-objective optimization},
abstract = {In engineering design, many problems rely on costly and complex computational simulations, known as Expensive Constrained Multi-objective Optimization Problems (ECMOPs). This article proposes a Data-Driven Multi-Task Global Optimization Algorithm (DMTOA), leveraging Evolutionary Multi-task Optimization (EMTO) and data-driven methods to efficiently solve ECMOPs under limited computational resources.The algorithm incorporates a parallel multi-task sampling strategy, where the main task subjects to strict constraints, whereas the auxiliary task operates under relaxed constraints. This integrative approach not only accelerates population convergence but also enhances the feasibility and diversity of the solutions. Additionally, the algorithm employs a two-stage knowledge transfer strategy to facilitate inter-task information exchange, thereby accelerating early-stage convergence and enhancing the diversity and feasibility of solutions in the later stages. Experimental results indicate that DMTOA exhibits superior performance when compared with five state-of-the-art algorithms, achieving the best results in 59.3% out of the 54 tests. Furthermore, DMTOA is applied to the multidisciplinary design optimization (MDO) of a Blended-Wing-Body Underwater Glider (BWBUG), the results further substantiate the efficacy of the proposed algorithm.}
}
@article{WANG2026114919,
title = {A novel multi-agent reinforcement learning approach based on state adaptive weighting and exploration path sampling},
journal = {Applied Soft Computing},
volume = {194},
pages = {114919},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114919},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003674},
author = {Yichen Wang and Shuai Zheng and Ze Yang and Xin Zhou},
keywords = {Reinforcement learning, Multi-agent, State adaptive weighting, Exploration path sampling},
abstract = {In Multi-Agent Reinforcement Learning (MARL), the relationship between the current state and the reward is crucial to the model’s performance. A good weight adaptation leads to a more reasonable reward, boosting the spatial exploration efficiency and stable control of all agents. This paper proposes State Adaptive Weighting (SAW) and Exploration Path Sampling (EPS), a powerful design to achieve state weight adaptation. SAW employs a dynamic state weighting network to prioritize informative and decision-critical states during training. It allows agents to focus on task-relevant regions of the state space and improves overall sample efficiency. EPS introduces a multi-faceted exploration strategy composed of three parts: a curiosity-driven module that uses prediction errors to generate intrinsic rewards, a path diversity tracker that encourages visits to novel states through visitation-based bonuses, and an adaptive noise mechanism that modulates exploration intensity based on environmental novelty. This paper conducts a series of experiments to demonstrate the improvements in learning speed and exploration quality. Our work offers a useful solution to address both effectiveness and stability in multi-agent systems. Abstract text.}
}
@article{YANG2026114927,
title = {Vibration smart language model: A study on intelligent operation and maintenance and decision support system based on multimodal data fusion},
journal = {Applied Soft Computing},
volume = {194},
pages = {114927},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114927},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003753},
author = {Yuxuan Yang and Jiarui Jing and Guangsheng Ran and Tianyang Wang and Guangyao Zhang and Yuchen Zhang and Jiancheng Zhao and Yifan Ma and Xueyi Li},
keywords = {Large Language Model, Intelligent Operation and Maintenance, Intelligent Fault Diagnosis, Maintenance Decision-Making},
abstract = {In the field of intelligent operation and maintenance, vibration analysis heavily relies on experienced analysts. However, this expert-driven approach not only makes the diagnostic process time-consuming but is also susceptible to subjective biases, increasing the risk of errors. To address these challenges, this paper proposes an innovative Vibration Smart Language Model (VSLM), designed to tackle core issues in intelligent operation and maintenance. The model integrates four key modules: Professional Large Language Model (PLLM), VibroText Converter (VTC), DeepVibro Diagnostic Synthesizer (DVDS), and Autonomous Knowledge Navigator (AKN). This paper fine-tunes the LLaMA3–8B model to construct the PLLM module, significantly enhancing the model's performance in fault diagnosis and decision support. The system offers two approaches for processing vibration signals: one converts vibration signals into mathematical features and generates textual descriptions through the VTC module, while the other directly generates diagnostic results using the DVDS module and inputs them into the PLLM module in the form of prompts, enabling intelligent processing of multimodal signals. To enhance the system's real-time capability and reliability, the AKN module is introduced to support the instant retrieval and integration of domain-specific knowledge, ensuring that the system can adapt to the dynamic demands of the industry. Experimental results demonstrate that the system outperforms an ISO level 3 vibration analyst, in vibration signal processing, fault diagnosis, and operational decision-making accuracy, showcasing broad application prospects and significantly advancing intelligent operation and maintenance technologies.}
}
@article{ZHANG2026114969,
title = {Agile grasping representation and rapid convergence neural network for high-accuracy grasp detection},
journal = {Applied Soft Computing},
volume = {194},
pages = {114969},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114969},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004175},
author = {Xuejiao Zhang and Yang Jiang},
keywords = {Agile grasping representation strategy, Robot grasping detection, Attention mechanism, Rapid convergence network},
abstract = {In the area of robotic grasping, traditional two-dimensional detection methods can identify object types but struggle to accurately capture their size, posture, and geometric shape. To address this limitation, this paper proposes a grasping detection method based on agile grasping representation and rapidly convergent neural network. First, an innovative agile grasping representation strategy is proposed to facilitate the representation of grasping objects, thereby enhancing the applicability with various grippers. Subsequently, the symmetric and the circular grasping models are established under different grasping strategies. These models effectively expand the application range of the attitude representation model and can almost represent all the objects to be grasped. Second, a rapid convergence neural network is proposed. By integrating triplet attention and spatial attention mechanisms, the network achieves improved performance and robustness. Third, a novel multi-target grasping dataset is constructed. The network presented in this paper achieves detection accuracy of 99.99%, 99.62%, and 99.64% on the public Cornell, Clutter, and multi-target grasping datasets, respectively. Across 2400 experiments using two different manipulators, our approach achieve an average success rate of 99.6% in single target scene and 97.1% in complex scene. Furthermore, our method performs grasp detection task within 11 ms, demonstrating its suitability for real-time engineering applications.}
}
@article{ZENG2026114942,
title = {Cross-domain bearing fault diagnosis using multi-loss deep adaptation with pseudo-label refinement and maximum mean discrepancy-based alignment},
journal = {Applied Soft Computing},
volume = {194},
pages = {114942},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114942},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600390X},
author = {Wei Zeng and Jumin Wu and Yang Chen and Jinkai Lan and Junwen Lu and Xiaogang Li and Tianwen Guo and Peikai Zhang and Shaoyi Du},
keywords = {Cross-domain fault diagnosis, Domain adaptation, Pseudo-label learning, Maximum mean discrepancy, Deep representation learning, Transfer learning},
abstract = {Accurate and robust fault diagnosis of rolling bearings under varying operational conditions is critical to ensuring the reliability and safety of industrial systems. However, domain shifts caused by changes in load, rotational speed, sensor configurations, and data acquisition platforms often lead to significant degradation in diagnostic performance. To address this challenge, we propose a novel cross-domain bearing fault diagnosis framework that integrates a multi-loss deep adaptation strategy with confidence-aware pseudo-label refinement and Maximum Mean Discrepancy (MMD)-based distribution alignment. From an artificial intelligence perspective, the architecture comprises three key components: (1) a shared Wide Deep Convolutional Neural Network enhanced with a Bidirectional Gated Recurrent Unit (BiGRU) module for temporal-spatial feature extraction across domains; (2) MMD-based domain alignment minimizing feature distribution discrepancies; and (3) confidence-aware pseudo-labeling selectively incorporating high-confidence target predictions. These are jointly optimized using a unified loss integrating supervised classification, unsupervised MMD alignment, and self-supervised pseudo-label refinement. Extensive experiments on Paderborn University and Jawaharlal Nehru University datasets demonstrate superior performance across multiple transfer scenarios. The method achieves 94.85% and 99.47% cross-domain accuracy respectively, significantly outperforming baselines. Ablation studies validate the complementary roles of the MMD and BiGRU modules. The lightweight design (0.0976M parameters, 2.02M Floating Point Operations Per Second) enables real-time inference (0.927ms/sample), outperforming Residual Neural Network-based methods by 95% in computational cost while maintaining reliability. From an engineering application standpoint, this framework addresses critical industrial challenges in bearing fault diagnosis under varying conditions, providing computationally efficient solutions for real-time deployment in manufacturing and energy systems where labeled target data are unavailable.}
}
@article{SHAPIRA2026114930,
title = {FRAME: Comprehensive risk assessment framework for adversarial machine learning threats},
journal = {Applied Soft Computing},
volume = {194},
pages = {114930},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114930},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003789},
author = {Avishag Shapira and Simon Shigol and Asaf Shabtai},
keywords = {Machine learning, Risk assessment, Adversarial learning},
abstract = {The widespread adoption of machine learning (ML) systems has intensified concerns about their security and the rise of adversarial machine learning (AML) techniques that exploit inherent model vulnerabilities. This highlights the need for comprehensive risk-assessment methods specifically tailored to ML-based systems. Traditional cybersecurity frameworks are not equipped to address the distinctive challenges of adversarial threats, while existing AML evaluations focus mainly on technical robustness and often overlook real-world factors such as deployment environments, system dependencies, and attack feasibility. Previous efforts toward comprehensive AML risk assessment have remained domain-specific, limiting their applicability across diverse systems. To address these gaps, we present FRAME, a comprehensive framework for assessing AML risks in ML systems. FRAME quantifies adversarial risk across three dimensions: the target system’s deployment environment, the characteristics of AML techniques, and empirical findings from prior research. It integrates a structured dataset of AML attacks, enabling context-aware and reproducible evaluation, and includes a semi-automated scoring process with LLM-assisted customization for system-specific assessments. Validated across six real-world use cases, including e-commerce feedback scoring and email malware detection, FRAME achieved an average overall accuracy of 9/10, with expert assessments indicating high attack-specific accuracy (9.2/10) and relevance (8.9/10), demonstrating strong alignment with expert analyses. By enabling organizations to identify and prioritize adversarial risks, FRAME provides a practical and scalable foundation for secure and informed deployment of ML systems.}
}
@article{ZHAO2026114906,
title = {Dynamic feature selection with distributional Markov chain error correction for financial time series forecasting},
journal = {Applied Soft Computing},
volume = {194},
pages = {114906},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114906},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003546},
author = {Yuan Zhao and Xiufeng Liu and Rui Cheng},
keywords = {Dynamic feature selection, Markov chain, Distributional modeling, Time series forecasting, Error correction, Uncertainty quantification},
abstract = {Financial time series forecasting presents fundamental challenges requiring adaptive methodologies that can handle uncertainty, high-dimensional feature spaces, and regime-dependent market dynamics. This paper introduces a novel adaptive framework that integrates dynamic threshold-based feature selection with distributional Markov chain error correction for enhanced financial forecasting performance. The proposed approach combines Adaptive Threshold-based Feature Selection with theoretically-grounded bounds that dynamically adjust to evolving market characteristics, and Markov Chain with Sample Distribution that captures both regime transitions and intra-state uncertainty through distributional modeling. Empirical validation on S&P 500 data demonstrates consistent improvements over traditional econometric and machine learning baselines, with statistically significant gains across multiple evaluation criteria. Robustness analysis across different market regimes confirms the method’s stability and effectiveness for financial forecasting. The framework’s principles of adaptability, uncertainty handling, and hybrid modeling make it particularly suitable for financial markets requiring intelligent prediction under uncertainty.}
}
@article{GUO2026114938,
title = {QConvCDFA: A cross-domain fault detection model based on quadratic CNN and contrast-driven feature aggregation},
journal = {Applied Soft Computing},
volume = {194},
pages = {114938},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114938},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003868},
author = {Yiming Guo and Yanxue Wang and Xinming Li and Meng Li and Chengming Wang},
keywords = {Rotating machinery, QCNN, Feature learning, Multi-level features, Intelligent fault diagnosis},
abstract = {Current fault diagnosis methods face challenges such as noise interference in multi-source signals and inadequate feature fusion. Existing single-channel deep learning models struggle to process heterogeneous signals directly, while traditional data fusion strategies often lead to the loss of time-frequency domain features during integration. To address these challenges, this paper proposes a fault diagnosis model based on a quadratic convolutional neural network (QCNN) that incorporates adaptive noise reduction and dynamic cross-domain feature fusion. First, the Fast Fourier Transform (FFT) is applied to convert time-domain signals into the frequency domain. The time- and frequency-domain signals are then independently fed into the QCNN layer, where adaptive noise suppression and feature extraction are performed. Subsequently, a Transformer encoder with positional encoding is used to model long-range dependencies among fault-related features. The encoded time- and frequency-domain features are then fed into the contrast-driven feature aggregation (CDFA) module. In this module, cross-domain features are dynamically weighted and aggregated using a sliding window mechanism, and the resulting representations are then passed to a deep learning classifier for final fault diagnosis. Finally, the performance of the proposed model is validated through four experiments conducted on four bearing datasets. These results demonstrate that the QConvCDFA model can effectively capture key features from both time and frequency domains. Furthermore, the model shows superior diagnostic accuracy and robustness compared to benchmark methods.}
}
@article{JALALI2026114914,
title = {SOCIAL: Social network optimization algorithm via centrality and influence-aware learning},
journal = {Applied Soft Computing},
volume = {194},
pages = {114914},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114914},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003625},
author = {Mehrdad Jalali and Binh Vu and Swati Chandna and Mohammad H. Nadimi-Shahraki},
keywords = {Metaheuristic optimization, Social network algorithms, Centrality, Influence propagation, Graph-based search, Exploration–exploitation, Adaptive learning, Benchmark functions, Materials science, Cheminformatics, Materials informatics, MOF discovery, Engineering optimization},
abstract = {We present SOCIAL (Social Network Optimization Algorithm via Centrality and Influence-based Learning), a structure-aware metaheuristic that reframes black-box engineering optimization as social-network analysis on a small-world graph of candidate solutions. Each solution is a node, and edges specify local neighbor interactions; information flow is governed by an influence-diffusion score that combines structural centrality (betweenness/bridge potential) with relative fitness, enabling agents to preferentially learn from solutions that are both well-positioned in the network and high-quality in the search space. A time-scheduled learning policy shifts from network-driven exploration toward elite-guided exploitation, with adaptive mutation and periodic population synchronization to prevent stagnation while preserving diversity. This networked view yields interpretable search dynamics—identifying leaders, followers, and critical bridges—together with scalable communication over sparse graphs. We assess SOCIAL on 23 benchmark functions and six constrained engineering design problems (gear train, pressure vessel, welded beam, speed reducer, composite laminate, and FGM beam), demonstrating robust performance and competitive ranking-based evaluation against contemporary optimizers. SOCIAL achieves particularly strong results on multimodal, discontinuous, and constraint-dominated problems, while maintaining stability and feasibility rates. The algorithm’s network-based architecture makes it particularly well-suited for materials science and cheminformatics applications, where candidate structures can be modeled as nodes in similarity graphs, enabling optimization of graph-model hyperparameters, sampling policies, and candidate exploration strategies in materials design. The key novelty is using the social-network structure itself as the learning mechanism, providing a general and explainable optimizer for engineering problems where gradients are unavailable, objectives are nonconvex or noisy, and variables are mixed discrete–continuous.}
}
@article{LU2026114925,
title = {Index tracking models considering interval fuzzy preference relations of decision makers for portfolio optimization},
journal = {Applied Soft Computing},
volume = {194},
pages = {114925},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114925},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600373X},
author = {Xinyi Lu and Liu Yang and Weiwei Guo and Zhongming Wu},
keywords = {Portfolio selection, Index tracking model, Interval fuzzy preference relation, Additive consistency, Uncertainty},
abstract = {The index tracking strategy is widely adopted by investors for its ability to capture stable market-average returns while effectively mitigating non-systematic risks. However, the inherent vagueness and unpredictability of individual investor preferences often complicate the decision-making process, thereby exerting a tangible impact on portfolio selection. In this study, we integrate interval fuzzy preference relations (IFPRs) with the index tracking model to examine the portfolio selection problem faced by investors. A new method is developed to convert IFPR into a fuzzy preference relation through the average degree, to enhance the judgment of element relations and priority vectors. On this basis, we propose portfolio models that fully or partially incorporate the original IFPR information of investors into the index tracking model. Through empirical analysis, our research demonstrates the superior performance of the proposed model in parameter configuration. These results highlight the importance of incorporating investors’ personalized preferences in investment decisions and provide new perspectives and tools for investors to make investment decisions in an uncertain environment.}
}
@article{XIE2026114946,
title = {Entity alignment based on multi-modal representation learning and constrained weakly-supervised clustering},
journal = {Applied Soft Computing},
volume = {194},
pages = {114946},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114946},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003947},
author = {Ruifeng Xie and Lina Zhang and Runtao Yang},
keywords = {Knowledge graph, Entity alignment, Multi-modal embedding, Relational path encoding, Weakly-supervised clustering},
abstract = {Entity alignment is crucial for integrating heterogeneous knowledge graphs, yet existing methods are challenged by structural heterogeneity, scarcity of labeled data and aligning information-sparse long-tail entities. This paper proposes a novel weakly-supervised framework for entity alignment, combining multi-modal representation learning with an adversarial debiasing mechanism. Our approach integrates structural, attribute, and semantic embeddings through a multi-head attention module enhanced by an adversarial debiasing process. This process operates adversarially to eliminate structural biases (e.g., entity degree) inherent in knowledge graph data. To address the lack of labeled training data, we propose a weakly-supervised pipeline. Unlike fully supervised methods, our approach does not rely on manual seed alignments for gradient training. Instead, we introduce a weak supervision signal derived from heuristic linguistic constraints (e.g., shared English labels) to guide the clustering process. We employ a limited validation set solely for hyperparameter tuning, and integrate Canopy pre-clustering, constrained DBSCAN, and the Hungarian algorithm to ensure reliable one-to-one mappings. Experiments on the comprehensive DBP15K benchmark (including ZH-EN, JA-EN, and FR-EN subsets) show our method consistently achieves state-of-the-art results, with Hits@1 scores of 75.1%, 70.2%, and 83.5% respectively. It outperforms existing baselines by up to 4.1 (ZH-EN) and 1.9 (FR-EN) percentage points in Hits@1, and achieves a second-best performance on JA-EN. Heterogeneity and long-tail analysis confirm the model’s robustness, particularly demonstrating the effectiveness of our LLM enhancement and debiasing strategies in handling information-sparse entities. The model’s practical applicability is validated through parameter sensitivity analysis and a detailed case study.}
}
@article{KIM2026114922,
title = {A review on artificial intelligence-based medical image enhancement and generation},
journal = {Applied Soft Computing},
volume = {194},
pages = {114922},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114922},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003704},
author = {Dong Seop Kim and Jung Soo Kim and Seong In Jeong and Kang Ryoung Park},
keywords = {Artificial intelligence, Medical image enhancement and generation, Chest X-ray, Computed tomography, Magnetic resonance imaging},
abstract = {Artificial intelligence is playing an increasingly important role in medical image generation, contributing to improved image quality and data diversity. These advances are helping to solve key problems in the clinical setting, such as low-quality scans and data sparsity. Initially, convolutional neural networks (CNNs) and generative adversarial networks (GANs) were mainly utilized, but in recent years, transformer-based models and diffusion models have emerged, leading to technological advances. These latest techniques are being actively researched for their potential for real-world clinical applications. In this paper, AI-based medical image generation techniques are comprehensively investigated, focusing on three major modalities: chest X-ray (CXR), computed tomography (CT), and magnetic resonance imaging (MRI). To organize the research, it is divided into two pillars: image enhancement and image synthesis. Image enhancement focuses on directly improving the diagnostic quality of images, including noise removal, blur correction, resolution enhancement, and restoration of incomplete data. Image synthesis, on the other hand, involves techniques that generate new data or improve clinical visibility by augmenting data, restoring anatomical structures, removing occlusions, etc. This paper analyzes the evolution of the model architecture of each approach, as well as the accessibility of the datasets used, code disclosure, quantitative metrics, and clinical evaluation cases involving radiologists. It also diagnoses the current state of medical image generation technologies and discusses future research directions, focusing on key challenges that need to be addressed in the future, such as domain generalization, establishing qualitative evaluation schemes, and integration into clinical workflows.}
}
@article{LUO2026114902,
title = {Robustness enhancement of grey prediction models in energy consumption based on adversarial training},
journal = {Applied Soft Computing},
volume = {194},
pages = {114902},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114902},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003509},
author = {Xilin Luo and Huiming Duan and Yuhang Tian and Jin Xiao},
keywords = {Energy prediction, Grey prediction model, Robustness, Adversarial training, Adversarial attack},
abstract = {Energy-consumption forecasting underpins energy-security planning and decarbonisation policy, where predictive stability under plausible data perturbations is as essential as point accuracy. Yet the robustness of widely used grey prediction models can be undermined by sensitivity to small input changes. To address this limitation, this paper introduces, for the first time, an adversarial-training framework for grey prediction models that optimises an adversarial objective with an evolutionary optimization algorithm, generates bounded adversarial examples via perturbation attacks on three classical grey models, and defines a robustness evaluation metric. Empirical analysis using historical Chinese energy consumption data demonstrates that, under bounded perturbations, the proposed framework enhances the robustness of the three models by over 60.00% and reduces forecasting error by approximately 70.00%. These gains indicate practical value for strategy design and optimization of the national energy structure, offering more dependable forecasts for policy and planning.}
}
@article{LIU2026114971,
title = {Window-xLSTMUnet: A medical image segmentation network fusing improved xLSTM with multi-scale receptive fields},
journal = {Applied Soft Computing},
volume = {194},
pages = {114971},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114971},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004199},
author = {Shangwang Liu and Yusen Wang and Guoqi Liu and Hualei Shen},
keywords = {Medical image segmentation, Window-xLSTM msRFB, DPRF, xLSTM},
abstract = {Medical image segmentation plays a crucial role in clinical diagnosis, yet it still faces challenges such as blurry tissue boundaries and diverse lesion morphologies. The application of xLSTM in image processing provides a solution to these problems, but its computational overhead remains non-negligible when dealing with high-resolution image inputs. To address the aforementioned challenges and reduce the computational cost of xLSTM, we propose Window-xLSTMUnet. The core of its architecture is the Window-xLSTM module, in which we adopt the improved xLSTM as the backbone for contextual information extraction. We replace traditional upsampling and downsampling operations with pixel shuffle; add the DPRF module to skip connections to enhance the global feature distribution and local salient edge information; and incorporate the msRFB module into the encoder for multi-scale local information extraction. Experimental results on the BUSI, ISIC2017 and ISIC2018 datasets demonstrate that the proposed model achieves superior segmentation performance against other state-of-the-art methods, with favorable IoU scores across all test benchmarks.}
}
@article{XIA2026114918,
title = {Bearing fault diagnosis method based on IMSE-CNN-Transformer and immune genetic algorithm optimization},
journal = {Applied Soft Computing},
volume = {194},
pages = {114918},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114918},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003662},
author = {Lei Xia and Dongmei Wang and Chen Chen and Chengwang Xie and Jianfeng Deng},
keywords = {Parameter optimization, End effects, CNN-transformer, Immune-genetic, Bearing fault diagnosis, Support vector regression},
abstract = {Ensuring bearing reliability is critical for the safe operation of rotating machinery, yet accurate fault diagnosis remains challenging due to non-stationary vibration signals, endpoint effects in empirical mode decomposition (EMD), and the lack of coordinated optimization between signal preprocessing and deep learning models. Existing studies typically address these issues in isolation, which limits robustness under noisy and variable operating conditions. To overcome these limitations, this paper proposes a novel end-to-end integrated framework that jointly optimizes signal enhancement and model learning. Specifically, an Improved Multi-Objective Coati Optimization Algorithm (IMOCOA) is employed to adaptively tune Support Vector Regression (SVR) for EMD boundary extension, effectively suppressing endpoint artifacts, while an Immune Genetic Algorithm (IGA) is used to optimize a hybrid CNN–Transformer architecture for robust extraction of local and global temporal features. The key novelty lies in the unified, dual-stage optimization of both signal decomposition and model hyperparameters within a single diagnostic pipeline. Experimental results on the CWRU and MFPT bearing datasets demonstrate average accuracies of 99.55% and 99.38%, respectively, and the proposed method maintains 98.44% accuracy under −5 dB noise. Compared with state-of-the-art methods, the proposed framework achieves superior diagnostic accuracy, noise robustness, and generalization capability, highlighting its effectiveness for practical bearing fault diagnosis in complex industrial environments.}
}
@article{CHANG2026114926,
title = {An iterative search algorithm based on solution space clustering for assignment problems},
journal = {Applied Soft Computing},
volume = {194},
pages = {114926},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114926},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003741},
author = {Xuening Chang and Chao Chen and Zhihao Luo and Jianmai Shi},
keywords = {Distance metric, Heuristic, Assignment problem, Solution space clustering, Acceleration strategy},
abstract = {Iterative search algorithms are widely recognized for their effectiveness in solving Combinatorial Optimization Problems, but they face significant limitations when applied to time-sensitive problems, such as Weapon Target Assignment (WTA) in military contexts. These limitations arise from redundant exploration of the solution space and the computational inefficiency inherent in traditional methods such as Iterated Local Search and Variable Neighborhood Search. To address these challenges, we propose a novel Iterative Local Search Algorithm Based on Solution Space Clustering (ILS-SSC), which incorporates a mathematically validated distance metric and hierarchical clustering techniques. This clustering approach redefines the exploration of the solution space, enabling the algorithm to identify and eliminate redundant searches efficiently. Extensive benchmarking shows that ILS-SSC achieves faster convergence than existing methods. Compared to the best reference method, ILS-SSC attains an 8-fold average speedup with only a 2% average reduction in solution optimality. By systematically addressing solution space exploration, ILS-SSC advances the theoretical foundations and practical deployment of time-critical optimization systems.}
}
@article{JIANG2026114966,
title = {Siamese transformer networks for few-shot image classification},
journal = {Applied Soft Computing},
volume = {194},
pages = {114966},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114966},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600414X},
author = {Weihao Jiang and Shuoxi Zhang and Kun He},
keywords = {Siamese network, Vision transformer, Global feature, Local feature, Information fusion},
abstract = {Humans exhibit remarkable proficiency in visual classification tasks, accurately recognizing and classifying new images with minimal examples. This ability is attributed to their capacity to focus on details and identify common features between previously seen and new images. In contrast, existing few-shot image classification methods often emphasize either global features or local features, with few studies considering the integration of both. To address this limitation, we propose a novel approach based on the Siamese Transformer Network (STN). Our method employs a dual-branch network architecture, utilizing a pre-trained Vision Transformer (ViT) backbone to extract global and local features, respectively. Specifically, the global features derived from the ViT encoder are processed by a global metric branch, wherein a dedicated Global Feature Enhancement Module (GFEM) refines these representations through cross-image context aggregation. Simultaneously, local features captured by the shared ViT encoder are routed to a local metric branch, where the Local Feature Enhancement Module (LFEM) performs spatial detail enhancement via spatial-aware attention mechanisms. For similarity measurement, Euclidean distance is used for global features and Kullback-Leibler (KL) divergence for local features, combined via L2-normalized weighted summation. This design exploits complementary feature strengths while maintaining mutual reinforcement. During training, we adopt a meta-learning strategy to fine-tune specific feature extractor layers, GFEM and LFEM. Our approach maximizes global-local feature synergy in few-shot learning, reducing single-feature bias and enhancing generalization. Experiments on four benchmarks show state-of-the-art performance under both 5-shot and 1-shot settings, validating the framework’s simplicity and effectiveness.}
}
@article{ZHANG2026114963,
title = {UIOCNet: Underwater indiscernible object counting network based on the fusion of CNN and transformer},
journal = {Applied Soft Computing},
volume = {194},
pages = {114963},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114963},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004114},
author = {Hanyu Zhang and Zhenbo Li and Wenxu Wang and Yuhuai Lin},
keywords = {Indiscernible object counting, Underwater environment, Background suppression, Parallel interaction, Feature fusion},
abstract = {Indiscernible Object Counting (IOC) is a novel and challenging task due to the inherent similarities between the indiscernible objects and their surrounding environments, which make them easily concealed within the background. In particular, underwater objects (mainly fish) are often obscured by coral reefs, seaweed beds, and seabed sands. Therefore, we propose UIOCNet: Underwater Indiscernible Object Counting Network based on the fusion of CNN and Transformer. To mitigate the challenge of discerning objects that are similar to the background, we devise a plug-and-play background suppression module. This module jointly captures channel and positional information and employs element-wise operations to enhance foreground representations while suppressing background interference. Furthermore, to overcome the limitation of existing IOC methods ignoring local features that are helpful for identifying objects, we design a parallel interaction architecture that enables complementary learning between CNN and Transformer. This facilitates the extraction of both global and local features, ensuring a more comprehensive feature representation and improved object discernment. Additionally, we design a feature fusion module to achieve high-precision density map estimation, optimizing the counting results. Experimental results demonstrate that UIOCNet achieves state-of-the-art performance on the IOCfish5K dataset, reducing the Mean Absolute Error (MAE) and Root Mean Square Error (RMSE) by 1.08 and 4.19, respectively, compared to IOCFormer, with values of 14.83 and 29.89. Additionally, it achieves an inference speed of 50 FPS with a per-image latency of only 20 ms, which is promising for practical applications. Furthermore, UIOCNet exhibits superior performance across both sparse and dense counting tasks, showcasing excellent generalization.}
}
@article{JIN2026114934,
title = {DCIN: A dual-channel interactive network with progressive fusion for aspect-based sentiment analysis},
journal = {Applied Soft Computing},
volume = {194},
pages = {114934},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114934},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003820},
author = {Song Jin and Nisuo Du and Qing He and Xiyin Wu and Wenjing Lei},
keywords = {Aspect-based sentiment analysis, Natural language processing, Graph neural networks, Feature interaction, Feature fusion},
abstract = {Aspect-based sentiment analysis aims to identify the sentiment polarity of specific aspects within a sentence. Recent studies have demonstrated the advantages of integrating syntactic dependency structures with graph convolutional networks (GCN). However, existing approaches often overlook the deep interplay between semantic and syntactic information, leading to insufficient capture of sentiment expressions. To address this, we proposed a method for aspect-based sentiment analysis based on dual-channel interactive network with progressive fusion (DCIN), designed to thoroughly explore the dependencies between semantic and syntactic features. The proposed model achieves deep interaction of structural information from heterogeneous graphs by introducing a cooperative learning mechanism between the semantic and syntactic channels. To enable cross-channel interaction, we design a cross-attention-guided feature interaction module (CAFI) to dynamically capture explicit dependencies between semantic and syntactic representations, thereby enhancing cross-channel information flow. In parallel, to effectively integrate multi-layer representations within the graph convolutional network, we proposed a learning-driven fusion module (LFM), which gradually merges lower-level features with higher-level ones through interaction-aware optimization, ultimately generating a comprehensive representation tailored for sentiment polarity classification. Experimental results demonstrate that DCIN achieves state-of-the-art performance on six benchmark datasets, verifying its effectiveness in aspect-based sentiment analysis tasks.}
}
@article{SINHA2026114898,
title = {Petrographic thin section image classification using traditional and deep learning techniques − A comparative evaluation},
journal = {Applied Soft Computing},
volume = {194},
pages = {114898},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114898},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003467},
author = {Pranav Prabhat Sinha and Manikandan Ramu and Vinoth Srinivasan},
keywords = {Rock identification, Thin-section images, Traditional machine learning, Deep learning, Transfer learning},
abstract = {The emergence of various machine learning approaches for image analysis has shed light on the automatic classification of rock thin-section images with precision and accuracy. This study presents a comprehensive comparison of traditional machine learning, deep learning, and transfer learning models for classifying nine diverse rock types. The classifiers were trained on images of plane-polarized light. A total of 26 textural features were extracted, with Histogram of Oriented Gradient for traditional machine learning, while deep learning models employed convolutional and max pooling layers. Traditional classifiers demonstrated moderate performance, with the Support Vector Machine achieving a classification accuracy of 90%. In contrast, ensembled models such as Random Forrest and XGBoost showed inferior performance, indicating limited effectiveness for image-based rock classification. Deep learning models significantly improved classification accuracy. The deep convolutional neural network achieved 96% accuracy, outperforming a shallow convolutional neural network, and demonstrated the advantage of a deeper architecture. The best performance was obtained using transfer learning approaches. Among all, InceptionV3 achieved 100% accuracy, precision, recall, and F1 Score, with zero validation loss, indicating excellent generalization capability. VGG16 also produced strong results but exhibited signs of overfitting, while ResNet50 performed comparatively poorly, suggesting that not all pre-trained models generalize equally well for rock image datasets. Confusion matrix analysis showed that InceptionV3 and DCNN classified most rock types with minimal misclassification. Training and validation performance curves further revealed rapid convergence and stable learning behaviour for InceptionV3, whereas other models displayed overfitting during training. Overall, the results demonstrated the superiority of deep learning models, particularly transfer learning models, for automated rock classification. Ultimately, this study highlights the importance of model selection, network architecture, and training strategy in achieving high classification accuracy. These findings have significant implications for geological analysis and mineral exploration, enabling the efficient and accurate identification of rocks.}
}
@article{LIU2026114931,
title = {Focus more, compute less: Lightweight fruit and vegetable recognition with focus token vision transformer},
journal = {Applied Soft Computing},
volume = {194},
pages = {114931},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114931},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003790},
author = {Chengxu Liu and Bingqian Lv and Shangzihan Wang and Haowen Meng and Guorui Sheng},
keywords = {Fruit recognition, Vegetable recognition, Lightweight, Focus token, Vision transformer},
abstract = {Fruit and vegetable recognition is a core technology in intelligent agricultural sorting systems. Unlike general object recognition tasks, it faces unique challenges such as the wide variety of crop categories, highly variable and irregular shapes, subtle fine-grained feature differences, and significant background interference. These characteristics impose stringent demands on both the accuracy and efficiency of recognition models. Although Vision Transformers have achieved remarkable performance across a range of computer vision tasks, their high computational complexity in global context modeling limits their applicability in resource-constrained environments, such as edge devices. To address the challenges of fruit and vegetable recognition, including small object sizes, subtle inter-class variations, and complex backgrounds, we propose a novel lightweight vision Transformer architecture, termed Super Focus Attention Vision Transformer (FocalViT). FocalViT introduces a focus token mechanism that compresses high-resolution agricultural images into semantically meaningful visual embeddings, significantly reducing the number of tokens involved in self-attention computation while maintaining strong global modeling capability. Moreover, FocalViT incorporates a latent spatial-channel attention interaction mechanism, which decomposes global attention into two stages: sparse correlation mapping and low-dimensional attention computation. This design enables the model to more effectively extract key visual features from fruit and vegetable images, such as texture details, color distribution, and shape boundaries. We further develop a scalable family of lightweight network variants based on FocalViT to accommodate a wide range of agricultural vision tasks. Experimental results on the Fru92 dataset demonstrate that FocalViT achieves an average Top-1 accuracy of 79.20% with only 2.48G FLOPs, outperforming state-of-the-art(SOTA) lightweight methods and achieving a superior trade-off between recognition accuracy and computational efficiency. The proposed FocalViT also exhibits real-time inference capabilities on embedded platforms, providing an efficient and deployable solution for intelligent fruit and vegetable sorting systems and confirming its technical feasibility for practical applications in agricultural industrialization.}
}
@article{GUO2026114813,
title = {An adaptive dynamic multi-swarm PSO algorithm based on topological structure for solving complex constrained optimization problems and its applications on UAV path planning},
journal = {Applied Soft Computing},
volume = {194},
pages = {114813},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114813},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002619},
author = {Eryang Guo and Yuelin Gao and Chenyang Hu},
keywords = {Particle swarm optimization, Multi-population, Constrained optimization problem, Unmanned aerial vehicle path planning, Self-adaptive mechanism},
abstract = {Particle Swarm Optimization (PSO) is a simple yet highly effective swarm intelligence algorithm extensively applied in engineering and scientific domains. However, when solving constrained optimization problems, PSO often suffers from premature convergence and an insufficient balance between global and local search, thereby limiting its global optimization efficiency. To enhance algorithmic performance, multi-subpopulation strategies have emerged as a key direction for improvement. Nevertheless, challenges persist in subpopulation partitioning methods, adaptive subpopulation size control, and inter-subpopulation information exchange. Addressing these issues, this paper proposes a Topology-Based Adaptive Dynamic Multi-Population Particle Swarm Optimization (T-ADMPSO) algorithm. First, a topology-based unsupervised clustering strategy is introduced to adaptively partition particles into structurally coherent subpopulations. Second, an adaptive subpopulation size control mechanism based on factor decomposition is designed to achieve a dynamic balance between exploration and exploitation during evolution. Third, a probability-driven cross-subpopulation information exchange model is constructed to enhance information sharing capabilities among subpopulations and reduce the risk of getting stuck in local optima. Additionally, improved feasibility rules are integrated into individual and global update processes to enhance constraint handling capabilities and search efficiency. Finally, the proposed T-ADMPSO algorithm was applied to solve multi-dimensional constrained optimization problems from CEC2017 (The IEEE Congress on Evolutionary Computation 2017 benchmark) and complex unmanned aerial vehicle(UAV) path planning tasks. Comparative experiments against several competitive algorithms demonstrated that T-ADMPSO exhibits strong competitiveness in both optimization performance and robustness.}
}
@article{YEOH2026114913,
title = {Variational autoencoders for anatomy-specific insights in medical imaging: A systematic review},
journal = {Applied Soft Computing},
volume = {194},
pages = {114913},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114913},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003613},
author = {Pauline Shan Qing Yeoh and Yongting Zhang and Khairunnisa Hasikin and Xiang Wu and Khin Wee Lai},
keywords = {Deep learning, Generative AI, Healthcare, Medical imaging analysis, Variational autoencoders},
abstract = {Variational Autoencoders (VAEs) have emerged as powerful generative models in medical imaging due to their ability to learn compact latent representations and model data distributions under limited supervision. Despite their growing applications, a systematic understanding of how VAEs are used to capture anatomy-specific structural characteristics, such as organ morphology, pathological variations and structural anomalies remains underexplored. This systematic review aims to analyze and summarize the role of VAEs in structural medical imaging, providing insights into their effectiveness for tasks such as segmentation, classification, anomaly detection, and image synthesis across various anatomical areas. The primary agenda is to provide a comprehensive taxonomy of how VAEs are engineered to address the unique morphological constraints of different organs. Following PRISMA guidelines, we conducted a systematic synthesis of 118 studies identified via the Web of Science. The reviewed works are categorized by anatomical domains, including neuroimaging, cardiac imaging, ophthalmic imaging, and lung imaging, with emphasis on imaging modalities and downstream tasks. VAEs are most extensively applied in neuroimaging, particularly for MRI-based synthesis and anomaly detection. Other domains exhibit distinct modelling priorities driven by temporal dynamics, intensity-based patterns, or fine-scale structural variability. Key challenges include limited generalizability, training specifications, heterogeneous evaluation practices, and privacy-related constraints. VAEs are powerful frameworks for anatomy-aware representation learning, but their clinical translation requires standardized benchmarking and multimodal integration. The review highlights the potential of VAEs to advance precision medicine by improving computer-aided tasks and enabling efficient model training from limited data.}
}
@article{RAZAQ2026114908,
title = {How can the integration of AI large language models and knowledge graph enhance fault diagnosis? A systematic literature review},
journal = {Applied Soft Computing},
volume = {194},
pages = {114908},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114908},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600356X},
author = {Wan Barmawi Muhammad Razaq and Hao Chen and Marcos R. Machado and João Luiz Rebelo Moreira},
keywords = {Fault diagnosis, Large language models, Knowledge graph, GraphRAG, Entity and relation extraction},
abstract = {The integration of Large Language Models (LLMs) and Knowledge Graphs (KGs) represents an emerging approach to improving fault diagnosis in industrial settings. Traditional fault diagnosis methods—including model-based, signal-based, and rule-based approaches—face persistent challenges in managing complex data, adapting to new failures, and ensuring reasoning accuracy. This systematic literature review evaluates 37 relevant studies to examine how the synergy between LLMs and KGs can mitigate these limitations. The review identifies two primary paradigms: LLM-augmented KGs, which automate the extraction of entities and relationships from unstructured industrial text, and KG-enhanced LLMs (GraphRAG), which ground model reasoning in structured causal paths to reduce hallucinations. While the integrated use of these technologies is a growing research trend, particularly with a peak of 11 papers published in 2025, the field remains in its early stages. Current research is heavily concentrated on rotating machinery, steel manufacturing, and computer numerical control (CNC) equipment, with significant gaps in industry coverage, multilingual support (beyond English and Chinese), and advanced evaluation metrics. Furthermore, many existing systems lack the explainability required for engineers to interpret reasoning routes in high-stakes environments. This study suggests that future research should focus on expanding diagnostic frameworks to specialized industries, improving domain-specific adaptations, and enhancing interpretability through interactive visualization and structured reasoning.}
}
@article{BARAJASMONTIEL2026114929,
title = {Multimodal granular adaptive fuzzy inference system for biosignal classification},
journal = {Applied Soft Computing},
volume = {194},
pages = {114929},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114929},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003777},
author = {Sandra-Eugenia Barajas-Montiel and Carlos-Alberto Reyes-García and Luis Villaseñor-Pineda},
keywords = {Biosignals, Multimodal, Fuzzy granulation, Electroencephalography, Electrodermal activity, Interpretability},
abstract = {One of the major challenges in analyzing and classifying biosignals is the extraction of relevant features that allow us to differentiate physiological and pathological states. Effective classification methods are key to translating data into useful information. We propose a novel interpretable machine learning method that combines fuzzy granulation for feature extraction with an adaptive neural fuzzy inference system and information fusion for biosignals classification. The result is an interpretable machine learning model that outputs if-then rules, promoting a more transparent and understandable decision-making process. Our main objective is to offer an alternative to overcome the challenges posed by the analysis of biosignals through a method that allows efficient classification of multimodal biosignals. We classified electroencephalographic and electrodermal activity signals collected through a stress-inducing protocol that we have designed to identify stress patterns and to observe music influence in stress perception. Our method completes the tasks for classifying biosignal samples, from feature engineering to rule extraction and sample labeling. Fuzzy granules are extracted as features from biosignals, and subsequently processed to form premises, normalize firing strengths, and compute rules consequents, followed by late fusion to obtain the final output as an interpretable set of rules. Our method achieves reliable biosignal classification results with an F1 score up to 98.3%, effectively differentiating between No-Stress and Stress classes.}
}
@article{LIU2026115002,
title = {Dynamic risk assessment of abnormal driving behaviors under varying traffic complexities},
journal = {Applied Soft Computing},
volume = {194},
pages = {115002},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115002},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004503},
author = {Zhuofan Liu and Li Wan and Jinmao Zhang and Dong Wei},
keywords = {Abnormal driving behaviors, Scenario complexity, Risk level assessment, Score-based mechanism, Deep learning},
abstract = {Abnormal driving behaviors (ADBs) pose significant threats to road safety, yet existing studies rarely account for how the associated risk evolves jointly with scenario complexity and behavioral duration. To address this gap, this study proposes a unified framework that dynamically evaluates ADB risk by integrating in-car behavior features, out-car traffic complexity, and temporal accumulation. The framework consists of three components. First, a hybrid contrastive learning–based ADB Identification Module (ADB-IM) is developed to extract fine-grained behavioral attributes, enhancing robustness under diverse driving conditions. Second, a Traffic Scenario Complexity Evaluation Module (TCEM) quantifies environmental complexity using an enhanced YOLO-V8 detector with weighted modeling of object categories and spatial distributions. Third, a time-buffer-based cumulative scoring mechanism fuses ADB duration with scenario complexity to generate frame-level risk estimations in a dynamic and interpretable manner. The framework is validated on a re-annotated AIDE dataset. Experimental results show that jointly modeling scenario complexity and temporal dynamics significantly improves classification performance, achieving an overall accuracy of 92.8% and markedly reducing false alarms in high-risk scenarios. Qualitative visualization further demonstrates that the scoring mechanism effectively captures the interactive evolution of behavior duration and traffic complexity. Overall, the proposed framework provides an effective and extensible solution for dynamic driving-risk assessment and offers insights for the development of future intelligent driving assistance systems.}
}
@article{XU2026114885,
title = {DSSF-MOT: Image sensor-based multi-object tracking algorithm via dual-stream semantic fusion},
journal = {Applied Soft Computing},
volume = {194},
pages = {114885},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114885},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003339},
author = {Huizhi Xu and Yongshuai Ge and Yue Tian},
keywords = {Image sensor, Multi-object tracking, Object detection, RAFT optical flow estimation, Dual-stream semantic fusion},
abstract = {In complex scenarios, multi-object tracking (MOT) tasks are subject to external disturbances like intermittent occlusions, which lead to failures in object association across consecutive. There is an urgent need to enhance the generalization and robustness of tracking algorithms. Based on DeepSORT algorithm, this paper proposes a dual-stream semantic fusion multi-object tracking algorithm (DSSF-MOT) by incorporating the RAFT optical flow algorithm to extract object optical flow information and optimizing the re-identification (ReID) module. The algorithm obtains appearance information via an object detector and fuses it with optical flow information to achieve robust association and matching. The model is trained on the CrowdHuman dataset and evaluated on MOT16 and MOT17 datasets, respectively. Experimental results demonstrate that the proposed fusion strategy enhances cascaded matching across consecutive frames, resulting in an improvement in overall tracking accuracy. Specifically, the highest improvements on the MOT16 dataset are 2.9% in HOTA, 3.7% in MOTA, and 3.5% in MOTP.}
}
@article{CHEN2026114937,
title = {Propagating features throughout the entire image: Implicit features warps for image alignment and homography estimation},
journal = {Applied Soft Computing},
volume = {194},
pages = {114937},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114937},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003856},
author = {Yinqi Chen and Yangting Zheng and Shuo Kang and Chao Liu and Shuo Zhang and Nan Zhang},
keywords = {Image alignment, Uncertain regions, Homography estimation, Local planarity, Homography consistency},
abstract = {Currently, modeling of image alignment and homography estimation in uncertain regions——areas where it is difficult to extract matching features in the real world——remains a major challenge. For uncertain regions, indirect approaches, such as extracting a variety of additional matching features to reduce uncertain regions, have been extensively adopted. However, their applicability is limited across diverse scenarios due to the existence of various features in the real world. In reality, features, whether lines, edges, or planes, share a commonality in seeking point sets that correspond to the same homography. This is rooted in the homography consistency that the spatial position of a rigid object remains invariant across different viewpoints. Capitalizing on this insight, this paper presents a generalized perspective on various features and introduces a more universal feature concept: implicit features. These implicit features, which are not extracted based on specific criteria, envelop each pixel and preserve the same homography based on the local planarity. Through the neighborhood interconnection relationship of implicit features, the homography consistency is formed. Moreover, by integrating constraints on implicit features and a weighted design for transition regions, we accurately model all pixels within the image by implicit features, achieving the effect of plane segmentation in uncertain regions. Compared to existing image alignment and homography estimation methods, the proposed approach surpasses them across all metrics and exhibits exceptional performance.}
}
@article{LI2026114812,
title = {Lightweight detection of small-target swarm using multiple scale feature fusion and dynamic task alignment},
journal = {Applied Soft Computing},
volume = {194},
pages = {114812},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114812},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002607},
author = {Yiming Li and Yuming Yao and Tongshan Liu and Guiqiu Song},
keywords = {Small target detection, Lightweight network, Feature fusion, UAV swarm, Counter-UAV},
abstract = {The widespread use of small-target unmanned aerial vehicle (UAV) swarms in military reconnaissance and tactical strikes poses significant challenges to traditional monitoring systems: small UAVs feature low pixel occupancy, ambiguous edges, and sparse textures; complex backgrounds easily confuse target features with noise; and resource-constrained scenarios demand a balance between detection accuracy and lightweight performance. These issues make precise and efficient detection of small-target UAV swarms an urgent problem in military defense and low-altitude airspace supervision. To address these challenges, this study proposes a lightweight detection network with four synergistic core modules: 1) the Small Object Attention Scale Sequence Feature Fusion (SASF) structure, which enhances perception of multi-scale and local detail features of small targets by expanding shallow feature processing and integrating attention mechanisms; 2) the Spatial Pyramid Pooling Fast with Large Separable Kernel Attention (SPPF-LSKA) module, which enlarges the receptive field and captures long-range dependency information to strengthen feature modeling in complex backgrounds; 3) the Context-guided Cross-stage Partial Weighted Fusion (CGC2f) module, which efficiently integrates global, contextual, and local information to reduce redundant computations while maintaining detection accuracy; and 4) the Dynamic Task Alignment Head (DTAH), which optimizes bounding box geometric alignment by dynamically adjusting sampling point positions and weight distribution, while keeping the head compact and parameter-efficient. Experimental results on the UAVSwarm dataset demonstrate that, compared with baseline models, the proposed network improves Precision by 2.11%, Recall by 6.81%, mAP50 by 4.26%, and mAP50–95 by 7.54%, while reducing the number of parameters by 50.67%, GFLOPs by 13.6%, and model size by 46.2%. Furthermore, cross-dataset evaluations on the DUT Anti-UAV and Det-Fly datasets are conducted to assess generalization capability, and the results confirm that the proposed method generalizes well across different data distributions. Overall, this work provides an efficient and reliable lightweight solution for small-target UAV swarm detection in complex and resource-limited environments.}
}
@article{KONG2026114954,
title = {Synergistic graph structure enhancement and beta modulated propagation for debiased recommendation},
journal = {Applied Soft Computing},
volume = {194},
pages = {114954},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114954},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004023},
author = {Fanrong Kong and Shaopeng Guan},
keywords = {Recommender systems, Graph convolutional networks, Random walk, Popularity bias, Beta distribution},
abstract = {Graph Convolutional Networks (GCNs) for collaborative filtering often suffer from uniform neighbor aggregation, which ignores differences in node importance and fails to capture indirect user-item relationships. To address these limitations, this paper proposes a framework that integrates two complementary mechanisms. A random walk-enhanced propagation module uncovers latent multi-hop association paths, revealing connections that are particularly useful for long-tail items. A Beta distribution-based popularity modulation strategy adjusts neighbor contributions according to interaction frequency, enabling personalized and non-linear weight allocation. Experiments on three benchmark datasets demonstrate that the proposed framework consistently outperforms state-of-the-art methods including SGL, GDE, and DAP, achieving average improvements of 6.52%, 6.71%, and 5.29% in NDCG, Recall, and Precision, respectively. The framework mitigates popularity bias while maintaining computational efficiency and is applicable to real-world recommendation scenarios.}
}
@article{ZHAO2026115006,
title = {E2Object: Frequency domain enhanced and center multifusion object detection},
journal = {Applied Soft Computing},
volume = {194},
pages = {115006},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115006},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004540},
author = {Yi Zhao and Qunpo Liu and Zhiwei Lu and Xuhui Bu and Changli Zhang},
keywords = {Object detection, Fast fourier transform, Frequency domain enhancement, Quadrilateral points, Center point},
abstract = {In visual object detection tasks, achieving a balance between computational efficiency, global context modeling, and precise geometric localization remains a major challenge. This paper proposes an object detection framework based on feature map frequency-domain enhancement and a Four-rectangle Central Convergence Fusion Module (FCCFM). The framework integrates joint modeling of frequency-domain and spatial-domain features to enhance feature representation capability and geometric consistency. First, a Frequency-Domain Interaction Attention (FDIA) module is designed to compress and concatenate frequency components across channels, generating multi-scale attention maps. After calibration, these maps are fused and concatenated in both serial and parallel manners to obtain more accurate attention vectors, thereby improving the network’s ability to represent and extract salient features. Second, an Adaptive High-Frequency Enhancement Network (AHFEN) is introduced to expand the receptive field and achieve deeper feature fusion. Finally, the proposed FCCFM encodes the diagonal half-length and the angle between the diagonal and the sides of the bounding box, enabling more accurate localization of object boundaries and enhancing model stability. The experimental results show that E2Object achieves 47.3% AP on the MS COCO 2017 dataset and 87.5% mAP on the PASCAL VOC2012 dataset. It outperforms a range of mainstream detection algorithms in terms of detection accuracy, thereby supporting the effectiveness of the proposed method under the evaluated settings. The code will be available at https://github.com/yi-z305/E2Object/tree/main.}
}
@article{MUSTAFA2026114909,
title = {Spectral noninvasive blood glucose detection using deep neural networks guided by a component–interference modeling strategy},
journal = {Applied Soft Computing},
volume = {194},
pages = {114909},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114909},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003571},
author = {Sonia Mustafa and Gang Li and Kang Wang and Guiming Fu and Faheem Anwar and Ghazala Arshad and Ling Lin},
keywords = {Non-invasive glucose monitoring, Glucose level, Photoplethysmography, Feature selection, Bat Optimization Algorithm, 1D-CNN, LSTM, Spectral analysis, M+N theory},
abstract = {Regular blood glucose monitoring is essential for effective diabetes management and the prevention of severe complications. However, traditional glucose measurement methods are invasive and often cause discomfort, emphasizing the demand for accurate, non-invasive solutions. In this work, we developed a novel, non-invasive approach for estimating blood glucose levels using Photoplethysmography (PPG) signals and deep learning models. Our proposed system employed a hybrid deep neural network architecture that combined One-dimensional Convolutional Neural Networks (1D-CNN) and Long Short-Term Memory (LSTM) layers to effectively extract spatial and temporal information from PPG signals. The Bat Optimization Algorithm (BAT) was used for feature selection, reducing computational demands and enhancing prediction accuracy. Additionally, a component–interference modeling strategy was incorporated to reduce physiological noise and improve signal quality during preprocessing. Simulation results showed notable improvements in prediction accuracy, achieving a root mean square error (RMSE) of 1.48 mmol/L, an MAE of 0.75 mmol/L, and an R² score of 0.92, along with a reduction in mean square error (MSE), confirming the system's potential as an effective, scalable solution for non-invasive glucose monitoring in healthcare settings.}
}
@article{SOLEIMANI2026114889,
title = {Artificial intelligence in agricultural machinery & robotics: A systematic review and future outlook},
journal = {Applied Soft Computing},
volume = {194},
pages = {114889},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114889},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003376},
author = {Afsaneh Soleimani and Mohammad Hossein Abbaspour-Fard and Ranjan Sapkota and Alireza Sanaeifar},
keywords = {IRFMs, PRISMA, Machine learning (ML), AI techniques, Agricultural robots, Sustainable agriculture},
abstract = {Conventional agricultural methods face serious pressures. A growing global population and rising food demand must be met using shrinking agricultural areas and constrained resources, while many traditional farming tasks remain tedious and dangerous. To address this, the intelligent management of essential inputs such as seeds, plants, water, soil, and energy has become critically important. Therefore, it is needed to focus on strategic agricultural decisions to enhance efficiency of agricultural production, while conserving soil and protecting the environment. This requires Intelligent Robots and Farming Machines (IRFMs) that can autonomously detect, navigate, decide, and operate across all terrains. The adoption of artificial intelligence (AI) within automated farm machinery and robotics is accelerating the evolution of agricultural equipment, processes, and management systems, driving the shift toward more efficient and sustainable farming practices. The existing research gap is that neither the operational efficacy nor the structural/optimization aspects of AI-enabled IRFMs have been thoroughly investigated. To address this, following PRISMA guidelines, this study conducted a systematic review, supported by a bibliometric analysis based on keywords derived from prior publications in the domain. The review examines key trends, applications, and recent developments in AI-enabled drones and IRFMs across agricultural tasks from planting to harvesting, covering studies published between 2012 and 2025 and identifying 218 articles that met the inclusion criteria. The analysis explores how AI and machine learning (ML) enhance IRFMs through automation, particularly in detection, navigation, decision-making, and structural design optimization, while time-series analysis is used to forecast future trends in AI’s role in improving IRFMs structure and performance. Existing challenges in adopting AI techniques for both the structural and practical aspects of IRFMs in sustainable agriculture are also assessed, and potential solutions are proposed. Overall, the findings highlight priority areas for agricultural automation and reveal innovation opportunities and unresolved challenges that can guide future research and support the development of the next generation of AI-enabled farm machinery and robotics.}
}
@article{CHITTIMADHA2026114962,
title = {Artificial bee colony and adaptive large neighborhood search based approaches for the star-ring network design problem},
journal = {Applied Soft Computing},
volume = {194},
pages = {114962},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114962},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004102},
author = {Sudhakar Chittimadha and Venkatesh Pandiri},
keywords = {Star-ring network design problem, Swarm intelligence, Artificial bee colony algorithm, Adaptive large neighborhood search, Combinatorial optimization},
abstract = {In this paper, we introduce a new variant of the network design problem, namely the star-ring network design problem (SRNDP). It is a two-level network design problem, in which the first level is to connect the central hub to other hubs through a star topology, and the second level is to connect every hub to non-hubs through a ring topology, resulting in multiple disjoint rings. The objective of SRNDP is to minimize the total cost (i.e., sum of all edge costs) required for the mentioned two-level structure. This problem arises across several applications in telecommunications, transportation, and logistics. For solving the SRNDP, we have proposed two metaheuristic approaches, in which the first one is a swarm intelligence based approach, namely the artificial bee colony (ABC) algorithm, whereas the second one is based on the adaptive large neighborhood search (ALNS) algorithm. As part of our proposed ABC approach, four problem-specific local searches based on swap, relocate, exchange, and 2-opt moves have been developed. Also, in the proposed ALNS approach, three destroy and two repair operators have been developed based on the problem-specific information. The performance of both the proposed approaches is examined using standard TSPLIB instances. Computational results, supported by a detailed analysis, highlight the effectiveness of the proposed approaches. In particular, ALNS consistently outperforms ABC in terms of solution quality and computational time, achieving a reduction in average cost of approximately 14.46% across all benchmark instances. Statistical validation using the Wilcoxon signed-rank test further confirms that the improvements obtained by ALNS are statistically significant.}
}
@article{DONG2026114917,
title = {Global vision in lightness: A novel approach to lightweight image super-resolution using global feature distillation},
journal = {Applied Soft Computing},
volume = {194},
pages = {114917},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114917},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003650},
author = {Jianhua Dong and Shengrong Zhao and Wenyi Zhang and Hu Liang},
keywords = {Super-resolution, Lightweight, FFC, Attention mechanism},
abstract = {In resource-constrained environments, image super-resolution reconstruction presents a significant challenge. Recently, substantial progress has been made in lightweight super-resolution, largely driven by the development of powerful information distillation mechanisms that enhance model representation. However, most existing distillation methods rely on spatial convolutions, inherently limiting their potential by neglecting global context extraction. In this paper, we propose a novel lightweight super-resolution framework called the Global Feature Distillation Network (GFDN), which combines fine-grained detail recovery principles with an efficient computational design. The key component of this model is the Global Feature Distillation Block (GFDB), which employs a parameter-free attention mechanism to enhance feature learning without adding extra computational burden. This design enables the model to achieve an optimal balance between reconstruction quality and efficiency. Additionally, to extend the receptive field, we introduce the Global Feature Extraction Module (GFEM), which captures global information by transforming and processing image features in the frequency domain, enabling effective extraction of essential frequency components. Experimental results demonstrate that our proposed model surpasses state-of-the-art methods while maintaining a lightweight architecture, making it well-suited for real-world deployment.}
}
@article{CHEN2026114949,
title = {Lightweight quantum recurrent neural networks for time-series and dynamical systems},
journal = {Applied Soft Computing},
volume = {194},
pages = {114949},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114949},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003972},
author = {Yuan Chen and Abdul Khaliq},
keywords = {Quantum computing, Minimal recurrent neural networks, Quantum long short-term memory, Quantum gated recurrent unit, Ordinary differential equations},
abstract = {We propose two minimal quantum-enhanced recurrent architectures, which are Minimal Quantum Long Short-Term Memory and Minimal Quantum Gated Recurrent Unit that significantly reduce the circuit depth and parameter count of existing Quantum Long Short-Term Memory and Quantum Gated Recurrent Unit models while preserving expressive power. By retaining only the essential variational quantum gates (two per cell) and offloading all remaining operations to lightweight classical layers, our streamlined designs cut runtime by 60% to 75%. We evaluate these four architectures across five ordinary differential equation benchmarks of increasing difficulty: zero-order Bessel-function forecasting, classical Lotka–Volterra predator–prey dynamics, fractional-order Lotka–Volterra, inverse parameter estimation for a damped oscillator, and the stiff Robertson chemical-kinetics system (with a multi-head attention layer). In each experiment, Minimal models match the accuracy of their full-circuit counterparts while training significantly faster. These results demonstrate that judicious pruning of variational circuits yields lightweight quantum-classical hybrids that are both practical for near-term hardware and highly effective on complex time-series and dynamical-system problems.}
}
@article{CAVALCANTE2026114905,
title = {Exponential family-based residuals for beta and unit gamma regressions: A bias–variance perspective},
journal = {Applied Soft Computing},
volume = {194},
pages = {114905},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114905},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003534},
author = {Jaime P.L. Cavalcante and Patrícia L. Espinheira},
keywords = {Residual, Exponential family, Bias–variance, Beta regression, Unit gamma regression},
abstract = {Residual analysis is a fundamental tool for assessing the adequacy of a model. However, for beta and unit gamma regressions—two critical supervised learning models for responses on the unit interval—conventional residuals depend on the computationally expensive leverage (hat) matrix of observations. This dependence makes them impractical for large datasets, motivating the search for diagnostics that retain strong power while remaining computationally efficient. In this study, we propose six new residuals (three for the beta model and three for the unit gamma model) derived from the sufficient and complete statistics of their respective regular exponential families. These residuals, termed bias, EF-variance, and bias–variance, are theoretically standardized to have zero mean and unit variance, thereby avoiding dependence on the leverage matrix. Their performance was evaluated through simulation studies and real-data applications, benchmarking them against traditional Fisher’s residuals. The results show that the proposed exponential family residuals, particularly the bias–variance type, demonstrate superior performance in detecting outliers, contaminated observations, and model misspecification, while offering significantly lower computational cost. The proposed framework provides a theoretically grounded, scalable diagnostic alternative for regression models with responses restricted to the unit interval, thereby contributing to more robust model assessment in statistical and data analysis contexts.}
}
@article{XIE2026115018,
title = {SPSC-Net: A multi-structured pancreas segmentation network integrating sparse pruned transformers and multi-scale spatial channel recalibration},
journal = {Applied Soft Computing},
volume = {194},
pages = {115018},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115018},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004667},
author = {Bin Xie and Ziyang Shi and Lin Li and Linan Hu and Congcong Fang and Hao Zhou},
keywords = {Deep learning, Pancreatic ductal adenocarcinoma, Sparse-pruned transformer, Multi-scale spatial-channel recalibration module},
abstract = {Accurate multi-structure segmentation of the pancreas, tumor, and peripancreatic anatomy is crucial for the preoperative staging and surgical planning of pancreatic ductal adenocarcinoma (PDAC). However, achieving high-precision automatic segmentation remains extremely challenging due to: (1) the complexity of joint modeling caused by intertwined anatomical structures; (2) the significant scale heterogeneity of lesions, which requires high-capacity adaptive feature representations; and (3) the structural trade-off between global semantic modeling and fine detail preservation. To address these bottlenecks, we propose SPSC-Net, a hybrid CNN-Transformer architecture for multi-structure segmentation. Specifically, we introduce a multi-scale spatial channel recalibration (MSCR) module, which serves as an implicit integration mechanism to model graph dependencies between features, thereby improving the extraction of blurred tumor boundaries and fine structures. Furthermore, a sparse pruning transformer (SPTrans) is integrated at the network bottleneck. SPTrans utilizes a windowed grid sparse attention pattern and a learnable threshold splicing mechanism to capture long-range dependencies while dynamically eliminating redundant computational overhead. Experimental results on a private dataset and the public MSD dataset demonstrate that SPSC-Net achieves state-of-the-art performance, with average Dice coefficients of 75.90% and 76.13%, respectively. On the Synapse multi-organ dataset, SPSC-Net yields an average Dice coefficient of 83.8%, which is comparable to complex 3D models. Additionally, this method exhibits significant efficiency advantages, with a model parameter count of only 5.74 M. Our code and models are available at: https://github.com/xdwork47/SPSC-Net}
}
@article{SHAN2026114921,
title = {Distributed fuzzy attribute reduction for partially labeled big data},
journal = {Applied Soft Computing},
volume = {194},
pages = {114921},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114921},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003698},
author = {Tingting Shan and Hengrong Ju and Lijiao Qiao and Weiping Ding and Keyu Liu and Jiashuang Huang and Xibei Yang},
keywords = {Semi-supervised attribution reduction, Fuzzy decision, Label training and learning, Apache spark},
abstract = {In general, it is difficult to completely avoid the incorrect labeling of unlabeled samples in partially labeled data. Consequently, the application of these mislabeled samples for attribute evaluation may misdirect attribute reduction methods, resulting in the selection of irrelevant or incorrect attributes. Furthermore, current semi-supervised attribute reduction methods predominantly depend on serial computation, which struggles to manage large-scale data under the conditions of limited resources. Based on the above findings, a new semi-supervised attribute reduction with approximate fuzzy decision in a distributed environment was proposed in this paper. First, the dataset was divided into different subsets based on the in-memory computing technology of Apache Spark, and the method was performed within the parallel computing framework of Apache Spark. Subsequently, fuzzy decisions were induced for labeled and unlabeled samples based on the fuzzy similarity relations and class membership degrees obtained from tree structure-based methods, which enabled the fuzzy decisions to express the uncertainty of sample labeling. Second, we queried the membership degrees assigned to each class of the samples, alongside the definition of an attribute evaluation measure with approximate fuzzy decision. Then, we followed this by designing a semi-supervised attribute reduction method based on the minimization of the approximate fuzzy decision. Finally, the reduction of each sub-node was submitted to the master-node to obtain the final reduction result. The efficacy of the proposed method is rigorously validated through experiments on fifteen public datasets. The results demonstrate that the proposed method achieves superior classification accuracy compared to several state-of-the-art semi-supervised feature selection methods, while significantly reducing computational time through effective distributed parallelization.}
}