@article{COJOCARU2026115437,
title = {Leveraging classic and bio-inspired multi-objective metaheuristics for energy communities’ optimal sizing},
journal = {Applied Soft Computing},
volume = {200},
pages = {115437},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115437},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008859},
author = {Maria Ruxandra Cojocaru and Luis Gonzaga {Baca Ruiz} and David {Criado Ramón} and María del Carmen {Pegalajar Jiménez}},
keywords = {Metaheuristics, Multi-objective optimization, Bio-inspired algorithms, Energy communities, Renewable energy, Sustainable design},
abstract = {Energy communities offer a sustainable response to the climate crisis by promoting green technologies. However, the intelligent sizing of such communities is a challenging task that involves conflicting objectives such as costs, self-consumption and self-sufficiency. This paper applies several metaheuristic algorithms that were meticulously adapted for assessing the initial design of residential energy communities made up of 3, 10 and 30 participants, testing both classical and modern bio-inspired approaches to determine which algorithms perform best, including two previously validated metaheuristics. Despite their modernity, the bio-inspired algorithms fail to consistently obtain good results across all metrics, while, on the contrary, the traditional NSGA2, MOEO, SPEA2, and MOPSO achieve the best performance, proving their reliability on different sized datasets and across various scenarios. Consequently, resources such as solar panels, batteries, and wind turbines are optimally assigned to each participant while considering four scenarios regarding the contractual distribution of energy within the community, helping designers decide not only on the configuration but also on the internal energy flow regulation of the community. Our study confirms that the most collaborative scenario enables a community of 3 participants to reduce emissions the most, by up to 35.81%, while also achieving the lowest levelized cost of 0.0725 $/kWh, 100% self-consumption and a self-sufficiency rate of 95.08%. For 30 participants, the reduction in emissions can reach 42.31%.}
}
@article{LI2026115432,
title = {A reproducible framework and enhanced strategy for multi-objective hybrid flow shop scheduling},
journal = {Applied Soft Computing},
volume = {200},
pages = {115432},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115432},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600880X},
author = {Taiji Li and Jiali Tang and Junda Qiu and Jie Zhang and Qi Liu and Yongjie Guo and Xiqi Li},
keywords = {Multi-objective optimization, Hyper-heuristic, Hybrid flow shop scheduling, Energy efficiency, Panel furniture manufacturing},
abstract = {In panel furniture manufacturing, energy-efficient hybrid flow shop scheduling requires the simultaneous optimization of job sequencing, machine assignment, and processing speed selection under machine heterogeneity across stages, setup times, and inter-stage transfer delays. Existing hybrid metaheuristics usually combine multiple search operators in an ad hoc manner, making it difficult to maintain a proper balance among convergence, diversity preservation, and local exploitation in multi-objective optimization. To address this issue, we propose NMVS, a reproducible four-tier hybrid hyper-heuristic framework that integrates NSGA-II, MOEA/D, selective variable neighborhood search (VNS)-based intensification, and simulated annealing (SA)-based diversification. The NMVS framework generates a diversified initial population, monitors population-level search indicators, and adaptively switches among MOEA/D, NSGA-II, VNS, and SA during evolution. VNS is applied to the first non-dominated front in the current population, whereas SA is used on a selected subset of candidate solutions when additional diversification is required. A bi-objective hybrid flow shop scheduling model is formulated to minimize makespan and total energy consumption while explicitly accounting for processing, setup, idle, transportation, and auxiliary energy consumption. Experimental results on 11 benchmark instances derived from a real-world panel furniture manufacturing scenario, with 30 independent runs per algorithm, show that NMVS achieves the best or near-best average IGD, HV, and GD values across most instances. These results demonstrate that NMVS offers an effective and reproducible hybrid hyper-heuristic framework for energy-efficient hybrid flow shop scheduling.}
}
@article{NAEIMI2026115449,
title = {PBiLoss: Popularity-aware regularization to improve fairness in graph-based recommender systems},
journal = {Applied Soft Computing},
volume = {200},
pages = {115449},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115449},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008975},
author = {Mohammad Naeimi and Mostafa {Haghir Chehreghani}},
keywords = {Graph neural networks (GNNs), Recommender systems, Fairness, Popularity bias},
abstract = {Recommender systems based on graph neural networks (GNNs) have been proven to perform well on user-item interactions. However, they commonly suffer from popularity bias—the tendency to over-recommend popular items—resulting in less personalization, unfair exposure and lower recommendation diversity. Current solutions address popularity bias through different stages of the recommendation pipeline, including pre-processing methods that may distort data distributions, in-processing approaches which can complicate optimization, and post-processing techniques that are limited in correcting bias already embedded in the learned representations. To address these limitations, we propose PBiLoss, a novel regularization-based loss function designed to explicitly counteract popularity bias in graph-based recommenders. PBiLoss augments traditional training objectives by penalizing the model’s inclination toward popular items, thereby encouraging the recommendation of less popular but potentially more personalized content. We introduce two sampling strategies—Popular Positive (PopPos) and Popular Negative (PopNeg)—and explore two methods to distinguish popular items—one based on a fixed popularity threshold and another without any threshold—making the approach flexible and adaptive. Our proposed method is model-agnostic and can be seamlessly integrated into state-of-the-art graph-based frameworks such as LightGCN and its variants. Extensive experiments carried out on datasets including Epinions, iFashion, and MovieLens highlight the advantages of the PBiLoss for enhancing fairness in recommendations, decreasing PRU and PRI by up to 10%, compared to other baseline models, while maintaining accuracy and other standard metrics intact in the process.}
}
@article{SUN2026115473,
title = {Improved adaptive optimization algorithm for training physics-informed neural networks},
journal = {Applied Soft Computing},
volume = {200},
pages = {115473},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115473},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600921X},
author = {Jie Sun and Jiali Yu and Yuying Yang and Chunxiao Wang and Yong Liao and Zhang Yi and Qing Gao},
keywords = {Adaptive optimization, Long-term memory, Online convex optimization, Physics-informed neural networks},
abstract = {Adaptive optimization methods are widely used for training deep neural networks, but their performance can deteriorate when the second-moment estimate is poorly scaled, often leading to unstable updates in stiff and ill-conditioned Physics-Informed Neural Networks (PINNs). To alleviate this issue, we develop AdaLB, an Adam-type optimizer that combines belief-based scaling with long-term gradient memory to stabilize adaptive updates. In AdaLB, the conventional second-moment estimate of squared gradients is replaced by an exponential moving average of gradient prediction errors, while a power-series-based accumulator is introduced to produce a time-varying decay factor for the second moment. Under the online convex optimization framework, we further establish an O(T) regret bound under standard assumptions. Experiments on synthetic objectives and PINN benchmarks, including the Burgers equation, Poisson equation, and a high-order differential equation, show that AdaLB is effective on the Burgers and Poisson problems and can also provide a stronger first-stage optimizer when combined with L-BFGS. The results also suggest that the role of long-term memory depends on the problem setting and on the choice of γ.}
}
@article{MITRA2026115373,
title = {Mask-guided rationales meet LLMs: Hybrid encoder–LLM question answering framework for grounded, faithfulness-regularized explainable hate speech detection},
journal = {Applied Soft Computing},
volume = {200},
pages = {115373},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115373},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008215},
author = {Abhijit Mitra and Souvik Mondal and Anubhav Bhattacharya and Jayanta Paul and Jaya Sil},
keywords = {Hate speech detection, Explainable NLP, Rationale extraction, Mask-guided rationale extraction (MGRE), QA-style span extraction, Multi-label text classification, Faithfulness evaluation, Sufficiency, Comprehensiveness, Social media moderation, Natural language processing, Interpretability (XAI), HateXplain, CAVES, Ex-HateQA},
abstract = {Effective hate speech moderation must address explainability and bias alongside raw classification accuracy. We argue that model decisions should be accompanied by human-readable rationales—short spans of the input text that justify the assigned label—ensuring that predictions are auditable and robust. In this paper, we present Ex-HateQA, an Explainable Hate Speech Detection framework featuring Question Answering-style rationale span generation. Ex-HateQA is a parameter-efficient hybrid encoder–LLM architecture that predicts (label, rationale) tuples by formulating explanation generation as an extractive question answering (QA) task. Ex-HateQA follows the principle of parameter-efficient adaptation strategy rather than the absolute size of the underlying 7B LLM backbone. The LLM remains frozen and is updated exclusively through low-rank adapters (LoRA/QLoRA), yielding a minimal trainable parameter budget (approximately <1% of the backbone) while preserving high generation quality for extractive, copy-only rationales. The encoder pathway performs Mask-Guided Rationale Extraction (MGRE) and multi-label prediction, while the LLM pathway generates rationale spans under a strict copy-only constraint, ensuring that the output is either a verbatim substring of the post or <unknown>. It is worth mentioning that here rather than claiming an absolute theorem of causal faithfulness, Ex-HateQA is designed to encourage decision–evidence consistency: sufficiency and comprehensiveness losses regularize the encoder toward counterfactually informative rationales, and an optional alignment objective encourages agreement between MGRE token salience and the LLM’s extractive spans. We further introduce LLM-aware probes—masked prompting for counterfactual sensitivity analysis and optional rationale-tagged prompting—and optimize the model using contrastive (negative) questions to mitigate reliance on spurious triggers. Across two rigorous benchmarks, HateXplain (single-label) and CAVES (multi-label), Ex-HateQA advances the state of the art while preserving a low-latency label-screening path and a selectively invoked rationale-generation path. On HateXplain, Ex-HateQA achieves an F1 score of 0.7445 (a 7.2% improvement over the best encoder baseline) and leads span generation with a ROUGE-2 score of 0.4235 and a BLEU score of 0.5169. Furthermore, it attains the highest subgroup robustness on GMB-Sub. and GMB-BNSP, indicating a significant reduction in bias toward target communities. On CAVES, the framework reaches an F1 score of ≈0.55 (an approximate 16.8% improvement over the strongest encoder baseline) and establishes new state-of-the-art results for ROUGE-1/2/L (e.g., ROUGE-L =0.4243), while matching the highest BLEU scores. Explainability analyses corroborate these empirical gains: plausibility substantially improves (e.g., Token F1 ≈50.3, AUPRC ≈70.3), while external evaluation under an independent classifier and human judgment shows more modest but directionally consistent gains in decision–evidence consistency. We therefore interpret these results as conservative evidence of improved rationale quality rather than as a standalone proof of strong causal faithfulness. Ablation studies validate the efficacy of MGRE pre-finetuning, contrastive QA prompting, and copy-only constraints, while demonstrating robust performance in low-resource and non-English settings. Operationally, we interpret the measured label+evidence latency as an on-demand explanation budget within a cascaded human-in-the-loop moderation pipeline, rather than as the cost of synchronous explanation generation for every incoming post at ingestion scale. We therefore position Ex-HateQA as a framework with deterministic extractive grounding, empirically supported faithfulness-oriented behavior, and a deployment scope centered on cascaded moderation workflows rather than universal firehose-scale full-explanation serving. Warning: This paper contains samples that may be upsetting.}
}
@article{ABBASI2026115425,
title = {Dynamic ensemble selection via optimization of competence regions},
journal = {Applied Soft Computing},
volume = {200},
pages = {115425},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115425},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008732},
author = {Behzad Abbasi and Vahid Majidnezhad and Bagher Zarei and Saeid {Taghavi Afshord}},
keywords = {Multiple classifier systems (MCS), Dynamic ensemble selection (DES), Region of competence (RoC), Meta-heuristic algorithm (MHA), Binary advanced differential evolution (bADE), High-accuracy classification},
abstract = {Dynamic Ensemble Selection (DES) improves classification performance by selecting the most competent classifiers from an ensemble for each query instance. A key challenge in DES is the definition of an effective Region of Competence (RoC), as most existing approaches rely on heuristic strategies such as fixed K-nearest neighbors or clustering, which may not accurately capture the local competence of classifiers. This paper proposes DES-bADE, a novel DES framework that formulates RoC construction as a binary optimization problem and employs a Binary Advanced Differential Evolution (bADE) algorithm to dynamically select an optimal subset of neighbors for each test instance. The proposed approach introduces a multi-criteria fitness function that integrates neighbor proximity, classifier confidence similarity, output profile similarity, and diversity, enabling a balanced and adaptive characterization of local competence. By evolving instance-specific competence regions rather than relying on static heuristics, DES-bADE improves the reliability of classifier selection in heterogeneous decision spaces. Extensive experiments conducted on 30 benchmark datasets show that the proposed method achieves competitive performance and obtains the best results on several datasets compared with state-of-the-art DES techniques. The statistical significance of the improvements is validated using Friedman, Wilcoxon signed-rank, and Bonferroni–Dunn post-hoc tests. The results indicate that metaheuristic-driven optimization of competence regions provides a promising optimization-based alternative to traditional heuristic-based DES strategies.}
}
@article{BORN2026115441,
title = {Elite-based cross-entropy method for solving transmission expansion planning},
journal = {Applied Soft Computing},
volume = {200},
pages = {115441},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115441},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008896},
author = {Josiane L. Born and André Milhorance and Fernando. A. Assis and Armando M. {Leite da Silva}},
keywords = {Cross-entropy method, Metaheuristic optimization, “N-1” criterion, Transmission expansion planning},
abstract = {Transmission expansion planning (TEP) determines the location, timing, and number of new circuits required to reinforce the power grid. By strategically selecting reinforcements, TEP prepares the network to accommodate demand growth, integrate new generation sources, and adopt emerging technologies in the electric power sector. However, the growing scale of modern power systems increases the complexity of problem formulation and its solution, motivating the development of computationally efficient optimization approaches. This paper proposes a cross-entropy (CE) algorithm with an elite-based strategy for solving the TEP optimization problem. The planning model considers static, long-term TEP with DC power flow, accounts for ohmic losses, and enforces the “N-1” security criterion. The methodology is validated on three systems: an academic benchmark and two large-scale real-world networks. In all cases, the CE method explores the solution space effectively and yields high-quality plans, positioning it as a compelling and relevant approach for TEP.}
}
@article{TIAN2026115417,
title = {Dynamic vehicle-cargo matching optimization approach based on kernel principal component analysis and Bayesian residual neural network},
journal = {Applied Soft Computing},
volume = {200},
pages = {115417},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115417},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008653},
author = {Ran Tian and Jian Yang and Jiarui Wu and Zhihui Sun and Xin Lu and Jinshi Wang},
keywords = {Vehicle-cargo matching, Kernel principal component analysis, Bayesian residual neural network, Matching utility value},
abstract = {Vehicle-cargo matching is pivotal in road freight logistics, yet existing methods exhibit significant limitations that impede optimization. Traditional algorithms frequently rely on subjective weighting schemes to calculate matching degrees, introducing bias and inadequately modeling complex non-linear attribute interactions. Furthermore, static or oversimplified average decision thresholds fail to adapt to the dynamic and uncertain nature of logistics environments, compromising matching quality and efficiency. To address these shortcomings, this study proposes an optimized approach integrating Kernel Principal Component Analysis and Bayesian Residual Neural Networks. The former constructs an objective, data-driven matching degree model that captures non-linear relationships, eliminating subjective bias. Simultaneously, the latter predicts adaptive matching thresholds, enhancing decision robustness under uncertainty compared to conventional static methods. The proposed algorithm embeds these components within a dynamic matching framework. Extensive experiments across three datasets demonstrate the method’s superiority over baseline techniques (including dynamic Bayesian networks, Ant Colony Optimization, Genetic Algorithms, Particle Swarm Optimization, Linear Programming, and the Hungarian Algorithm) in both matching success rate and utility. Ablation studies confirm the individual contributions of this algorithm. This framework offers a novel and effective solution for rational logistics resource allocation.}
}
@article{TAN2026115413,
title = {A parallel MOEA/D-MRA algorithm for solving multi-objective optimal power flow problems},
journal = {Applied Soft Computing},
volume = {200},
pages = {115413},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115413},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008616},
author = {Jiawei Tan and Xiaoqing Zhu and Jingrui Zhang},
keywords = {Optimal power flow, MPI, Many-objective optimization, MOEA/D, Parallel algorithm, PMOEA/D-MRA},
abstract = {Addressing the core challenges of high computational difficulty and low efficiency in solving many-objective optimal power flow problems for power system operation optimization, this paper proposes a parallel MOEA/D with many-stage dynamical resource allocation strategy (PMOEA/D-MRA) based on the Message Passing Interface (MPI). Firstly, a partitioned parallel evolution strategy for the global population is designed, where a complete initial population is generated within each process and subsets are evolved independently, effectively distributing the computational load. Secondly, a population migration mechanism based on a Master-Slave communication model is introduced. This mechanism gathers subpopulations from worker processes to the master process for cooperative evolution utilizing neighborhood relationships, thereby promoting information exchange and enhancing solution quality. Experiments on the IEEE 30, 57, and 118 bus systems demonstrate the significant advantages of the proposed algorithm in solution quality. For the compromise solution obtained on the IEEE 30 bus system, key indicators including total fuel cost (823.07 $/h), total emissions (0.2105 ton/h), and active power loss (4.3768 MW), outperform those of comparative algorithms. In terms of stability, it achieves the highest average Purity value and the lowest average Inverted Generational Distance and Generational Distance values, indicating excellent reliability. Regarding computational efficiency, it demonstrates outstanding parallel acceleration. With 10 processes, the speedup ratio reaches 8.453, the parallel efficiency is 0.845, and the solution time is reduced to merely 11.05% of the original serial algorithm's duration. This method provides an effective tool for efficiently solving many-objective power flow optimization problems in large-scale power systems.}
}
@article{LIANG2026115478,
title = {DSCL-ReID: Person re-identification with dynamic prompts and contrastive learning},
journal = {Applied Soft Computing},
volume = {200},
pages = {115478},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115478},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009269},
author = {Zhida Liang and Jifeng Guo and Jingmin Liu and Jingtan Guo and Xindan Gao},
keywords = {Person re-identification, Vision-language models, Prompt learning, Contrastive learning, Deep metric learning},
abstract = {Person re-identification (ReID) is a computer vision task aiming to automatically recognize and match the same individual across different camera viewpoints, with wide applications in intelligent surveillance, pedestrian tracking, and public safety. However, conventional ReID methods, often limited to visual feature extraction, struggle to leverage rich semantic information, constraining their performance in complex scenarios. The advent of large-scale vision-language models like CLIP has invigorated the ReID field by enabling the learning of more robust representations through image–text alignment. Nevertheless, existing CLIP-based ReID approaches face two primary challenges: (1) on the text side, prevalent static learnable prompts fail to generate personalized and adaptive textual descriptions for diverse pedestrian IDs; and (2) on the visual side, the reliance on in-batch supervision provides a limited, local perspective, hindering the discriminative power of the learned features. To address these issues, we propose a collaborative optimization framework named DSCL-ReID. First, we design a Dynamic-Static Prompt Learning (DSPL) strategy that enriches textual representations by combining a static base for ID-common features with a dynamically generated, personalized offset. Second, we devise a task-specific visual-textual contrastive loss to ensure tight alignment between text and image embeddings. Finally, we incorporate a Memory-Augmented Contrastive Learning (MACL) mechanism, which constructs a global prototype memory bank to provide stronger supervision for the visual encoder, effectively enhancing intra-class compactness and inter-class separability. Extensive experiments on mainstream ReID benchmarks, including Market-1501, CUHK03, and MSMT17, demonstrate that the proposed DSCL-ReID framework achieves superior performance, fully validating its effectiveness and superiority.}
}
@article{LI2026115462,
title = {Proxy reconstruction pre-training for ramp flow prediction at highway interchanges},
journal = {Applied Soft Computing},
volume = {200},
pages = {115462},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115462},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009105},
author = {Yongchao Li and Jun Chen and Zhuoxuan Li and Chao Gao and Yang Li and Chu Zhang and Changyin Dong},
keywords = {Traffic flow prediction, Highway interchange, Spatial-temporal autoencoder, Pre-training, ETC data},
abstract = {Interchanges are junctions where traffic merges, diverges and weaves between highways. Accurate prediction of ramp traffic flow at highway interchanges is essential for proactive traffic management involving flow control and ramp management. In practice, real-time mainline flow can be obtained through Electronic Toll Collection (ETC) systems and ramp flow can be inferred from license plate matching. However, data privacy restrictions and matching latency prevent real-time access to ramp data, leading to a “real-time blind spot”. This discrepancy dictates that while the model can utilize both mainline and ramp flow data during the training phase, the input is strictly limited to the real-time observable mainline flow during actual deployment. To address this challenge, this paper proposes a novel two-stage framework, including pre-training and prediction. In the pre-training stage, the Spatio-Temporal Decoupled Autoencoder (STDAE) leverages a proxy reconstruction task to mitigate missing ramp data issues. STDAE learns to reconstruct historical ramp flows exclusively from mainline traffic data, thereby compelling the model to capture the intrinsic spatio-temporal relationship between the mainline and ramp traffic flows. The unique decoupled architecture of STDAE, consisting of parallel spatial (SAE) and temporal (TAE) autoencoders, efficiently extracts the temporal and spatial dependency features of traffic flow. In the downstream prediction stage, the learned representations are integrated with specific forecasting models such as GWNet to enhance prediction accuracy. Comprehensive experiments conducted on three real-world interchange datasets (QiLin, DanYangXinQu, and XueBu) across multiple sampling intervals (3, 5, and 10 minutes) demonstrate that our proposed combined model, STDAEGWNET, consistently outperforms thirteen state-of-the-art baselines. Specifically, STDAEGWNET achieves the best overall average ranks of 1.00, 2.11, and 1.44 across the three respective datasets evaluated by multiple metrics. At the 3-minute sampling interval, the model attains the lowest Mean Absolute Errors (MAE) of 4.89, 5.61, and 4.58. Furthermore, the model demonstrates strong robustness against missing mainline data scenarios, achieving an average MAE reduction of approximately 2.23% compared to baseline models without the STDAE module. Importantly, the architecture-agnostic nature enables STDAE to serve as a plug-and-play enhancement module to improve diverse forecasting pipelines. The code and datasets used in this study are publicly available at: https://github.com/ChaochaoSeu/RPaI-STDAE.}
}
@article{LI2026115384,
title = {An efficient multi-fidelity ant colony system for multi-crane scheduling optimization},
journal = {Applied Soft Computing},
volume = {200},
pages = {115384},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115384},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600832X},
author = {Wenqiang Li and Jinghui Zhong and Zhitong Ma and Hu Jin},
keywords = {Yard crane scheduling problem, Ant colony system, Tandem scheduling, Multi-crane system, Ship block assembly},
abstract = {The yard crane scheduling problem (YCSP) of the shipbuilding industry aims to schedule blocks from the stack yard to the dock yard effectively, which is a key optimization problem in the shipbuilding process and is widely encountered in actual scenarios. This paper formulates a mathematical model for the yard crane scheduling problem with extended tandem scheduling (YCSP-T), a crucial and common process but often overlooked in the existing literature. To solve the YCSP-T, we propose an efficient Multi-Fidelity Ant Colony System (MF-ACS) algorithm. The algorithm fuses low-fidelity and high-fidelity modules using a priority partition strategy to enhance search efficiency and reduce the computationally expensive burden. In addition, a specialized synchronous tandem block control strategy is designed to handle the constraints in YCSP-T. The experimental results on real-world scenarios demonstrate that the proposed MF-ACS algorithm outperforms several well-performing existing algorithms, including the work-balanced genetic algorithm and the multiobjective analytical evolutionary algorithm, achieving a 7%-13% reduction in travel distance. Moreover, it also exhibits a significant advantage in computational efficiency, achieving an acceleration rate of 2–5 times.}
}
@article{LEI2026115405,
title = {A heuristic algorithm for the multi-UAV Stackelberg game in linear infrastructure protection},
journal = {Applied Soft Computing},
volume = {200},
pages = {115405},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115405},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008537},
author = {Xing Lei and Zhijian Zhang and Weihua Gan and Chunzhi Li},
keywords = {Heuristic algorithm, Stackelberg game, Unmanned Aerial Vehicles, Patrol strategy, Linear infrastructure},
abstract = {This paper proposes an effective approach, named the heuristic algorithm based on strategy abstraction (HASA), with the aim of addressing the high computational complexity inherent in solving multiple Unmanned Aerial Vehicles (UAVs) patrol Stackelberg game. The algorithm first addresses the issue of combinatorial strategy complexity through strategy compact, whereby the original game model is represented as a compact linear programming problem. Subsequently, strategy abstraction is applied to further reduce the strategy space. Finally, in terms of strategy mapping, a minimum coverage concept is introduced, and heuristic construction rules are designed based on this concept to derive high-quality patrol strategies. To evaluate the performance of the algorithm, extensive numerical experiments were conducted. These experiments compared the HASA algorithm with existing heuristic methods and exact algorithms. Numerical results demonstrate that the proposed method achieves significant advantages in both computational efficiency and solution quality, while yielding a robust solution.}
}
@article{CHENG2026115354,
title = {Label enhancement-based feature selection for multi-label learning via adaptive neighborhood rough set},
journal = {Applied Soft Computing},
volume = {200},
pages = {115354},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115354},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008021},
author = {Hao Cheng and Wenbin Qian and Xingxing Cai and Jintao Huang and Weiping Ding},
keywords = {Feature selection, Neighborhood rough set, Multi-label learning, Label enhancement, Granular computing},
abstract = {Feature selection effectively reduces dimensionality in multi-label datasets and boosts classifier performance, rendering it widely used in cutting-edge domains such as artificial intelligence. Nevertheless, due to the problem of label ambiguity, most existing multi-label feature selection algorithms cannot extract fine-grained label semantics from imprecise logical annotations. In an effort to circumvent this drawback, this paper proposes a novel multi-label feature selection framework that combines label enhancement and adaptive neighborhood rough sets. Specifically, a cascade evidential k-nearest neighbor label enhancement algorithm is developed, which decouples the enhancement process into evidence collection and fusion phases. In the first phase, the reliability of neighbors is quantified through a distance-based weighting metric. Secondly, multi-source evidence is hierarchically fused using Dempster-Shafer theory to reconstruct fine-grained label distributions. Furthermore, to leverage this enriched label information, an adaptive neighborhood rough set model is established from a three-way decision perspective. It adaptively determines the neighborhood radius for each sample based on the local density distribution of the data, thereby eliminating the dependency on a static radius. This neighborhood granulation method enables a more precise capture of label-feature correlations and improves the effectiveness of feature selection. Benchmark evaluations conducted on fourteen authentic multi-label datasets indicate that our proposed method achieves significant improvements compared to seven leading-edge feature selection methods.}
}
@article{LIU2026115470,
title = {A graph-integrated latent ensemble random vector functional link without direct links framework for drift-resilient online multi-step fine particulate matter forecasting},
journal = {Applied Soft Computing},
volume = {200},
pages = {115470},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115470},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600918X},
author = {Yujie Liu and Fadratul Hafinaz Hassan and Kun Zhou},
keywords = {Online learning, Concept drift, Spatiotemporal modeling, Air quality, Real-time forecasting},
abstract = {Online forecasting of fine particulate matter with an aerodynamic diameter of 2.5 μm or less (PM2.5) is essential for air-quality warning and environmental management, yet it remains difficult because monitoring data streams are heterogeneous, spatially coupled, and non-stationary. Many existing online learning methods are computationally efficient, but they often treat multi-source inputs as flat features, inadequately capture evolving inter-station interactions, and rely on static or heuristic ensemble aggregation. To address these limitations, we propose the Adaptive Graph-Integrated Latent Ensemble Random Vector Functional Link without Direct Links framework (AGILE-RVFLwoDL) for drift-resilient multi-step PM2.5 forecasting. The key idea is to couple adaptive multi-source latent representation, lightweight time-varying interaction learning, and residual-guided sequential ensemble adaptation within a strict predict-then-update mechanism. The framework improves adaptability while preserving bounded per-step computation and memory cost. We evaluate AGILE-RVFLwoDL using six years of hourly air-quality and meteorological observations from stations in Beijing, Chengdu, and Changchun for 1 h, 3 h, 6 h, and 12 h forecasting. Experimental results show that AGILE-RVFLwoDL achieves the best performance across four forecasting horizons when compared with naive, statistical, tree-based, deep sequence, graph spatiotemporal, periodically retrained deep, and online learning baselines under a unified evaluation protocol. On the Beijing dataset, it reduces the 12 h-ahead root mean squared error from 12.88 to 8.40 and improves the coefficient of determination from 0.828 to 0.926 relative to the strongest competing baseline. These results demonstrate that AGILE-RVFLwoDL provides an accurate, adaptive, and computationally practical solution for real-time multi-station PM2.5 forecasting under evolving environments.}
}
@article{MENG2026115370,
title = {Two fast algorithms for solving a class of time-varying tridiagonal linear systems using zeroing neural dynamic models},
journal = {Applied Soft Computing},
volume = {200},
pages = {115370},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115370},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008185},
author = {Dexin Meng and Xiaoyu Jiang and Yanpeng Zheng and Zhaolin Jiang},
keywords = {Zeroing neural dynamic, Fast algorithm, PNNT toeplitz linear equation},
abstract = {Time-varying tridiagonal linear systems play a pivotal role in numerous scientific and engineering applications, including differential equations, signal processing, and quantum mechanics. This paper proposes two fast algorithms based on zeroing neural dynamics (ZND) and improved recurrent neural networks (IMRNN) for solving a class of perturbed Neumann-Neumann tridiagonal (PNNT) Toeplitz linear systems. The study first establishes necessary and sufficient conditions for the solvability of this system, followed by an in-depth analysis of the structural properties of PNNT Toeplitz matrices. Leveraging discrete cosine transform (DCT) and diagonalization techniques, we develop efficient algorithms that reduce the computational complexity of matrix-vector operations from O(n3) to O(nlog⁡n). Our results demonstrate that the proposed algorithms substantially enhance computational efficiency for large-scale problems. By integrating these fast algorithms into the ZND and IMRNN frameworks, the study ensures computational accuracy and improves real-time performance.}
}
@article{DIAO2026115410,
title = {A multi-population serial search framework for enhanced convergence and diversity in multi-objective optimization},
journal = {Applied Soft Computing},
volume = {200},
pages = {115410},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115410},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008586},
author = {Pengfei Diao},
keywords = {Multi-objective Optimization, Decomposition, Gravitational Search Algorithm, Multi-population Serial Search Strategy},
abstract = {Decomposition-based multi-objective evolutionary algorithms (MOEAs) are fundamental tools for approximating Pareto fronts, yet their performance often degrades under constrained evaluation budgets due to synchronous parallel evolution, uniform resource allocation, and limited reuse of cross-subproblem information. To address these limitations, we propose a Multi-Population Serial Search framework for decomposition-based multi-objective optimization (MOEA/D-MPSS). The framework integrates (i) difficulty-aware resource scheduling through multi-population serial search, (ii) structured knowledge transfer across neighboring regions, and (iii) density-guided expansion of subproblems to enhance exploration in sparse Pareto-front segments. Extensive experiments on 19 widely used benchmark problems demonstrate that MOEA/D-MPSS achieves competitive or superior performance. In particular, it obtains the best inverted generational distance (IGD) values on approximately 75% of the test instances. For Hypervolume (HV), the proposed method consistently ranks first on a majority of benchmarks against state-of-the-art algorithms. Statistical tests further confirm that MOEA/D-MPSS yields significant improvements on most instances. Ablation studies validate the individual contributions of the serial-search mechanism, the knowledge-transfer strategy, and the density-driven region expansion. Overall, these results show that MOEA/D-MPSS provides a robust and efficient solution for budget-constrained multi-objective optimization.}
}
@article{LIU2026115386,
title = {A constrained multi-objective evolutionary algorithm based on constraint-diversity dominance sorting},
journal = {Applied Soft Computing},
volume = {200},
pages = {115386},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115386},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008343},
author = {Zhe Liu and Chundong Hu and Yahong Xie and Jichao Wang and Yang Liu and Jing Jiang},
keywords = {Constrained multiobjective optimization, Evolutionary algorithm, Dominance sorting, Polynomial mutation},
abstract = {In recent years, the coevolutionary framework has become a dominant approach for solving constrained multi-objective optimization problems. However, promising infeasible solutions are often prematurely discarded during constraint-handling optimization, making the design of effective sorting mechanisms that preserve high-potential candidates a critical challenge. Moreover, mutation strategies for evolutionary operators across both constraint-handling and constraint-free subpopulations have not been adequately developed, which restricts adaptive exploration and undermines decision-space diversity. To address these issues, we propose a novel constrained multi-objective evolutionary algorithm based on constraint-diversity dominance sorting, which ranks solutions by jointly evaluating feasibility, convergence, and diversity. Furthermore, a randomized polynomial mutation distribution coefficient strategy is introduced for the constraint-free subpopulation to enhance global exploration. Empirical results on 37 benchmark functions and a real-world engineering design problem demonstrate that the proposed algorithm significantly outperforms seven state-of-the-art constrained multi-objective evolutionary algorithms.}
}
@article{WANG2026115438,
title = {CECF-Net: Imputation of missing values in carbon flux time series via context enhancement and cross-scale fusion},
journal = {Applied Soft Computing},
volume = {200},
pages = {115438},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115438},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008860},
author = {Guoying Wang and Lingjie Zhu and Lufeng Mo and Xiaomei Yi and Peng Wu},
keywords = {Deep learning, Missing value imputation, Carbon flux, Time series, Attention mechanism},
abstract = {Carbon flux time series are crucial for quantifying terrestrial carbon dynamics, but they often contain missing values due to sensor failures and environmental disturbances. Existing imputation methods commonly rely on heuristic preprocessing (e.g., zero filling), which distorts intrinsic temporal structures and limits multivariate modeling. Furthermore, the coexistence of stationary and non-stationary time series within carbon flux datasets presents a fundamental challenge to imputation robustness. To address these challenges, we propose CECF-Net, a novel deep learning framework for missing value imputation in carbon flux time series. The model incorporates a Learnable Context Enhancement module that explicitly models local structural information around missing values, eliminating the need for static pre-filling and improving adaptability to phase shifts and amplitude variations. Additionally, a Probabilistic Cross-scale Fusion module replaces fixed downsampling with adaptive probabilistic resampling to learn multi-scale distributions, which are fused via cross-scale attention to model multi-resolution dependencies. A temporal attention encoder further captures complex dependencies and cross-variable interactions. The model’s performance was rigorously evaluated on multiple carbon flux datasets, with experimental results demonstrating that CECF-Net outperforms the best baseline methods, yielding average improvements of 33.68% and 15.63% in Mean Absolute Error (MAE) and Root Mean Squared Error (RMSE), respectively.}
}
@article{WIDZISZ2026115341,
title = {Comparison of algorithms for unsupervised clustering of binary data},
journal = {Applied Soft Computing},
volume = {200},
pages = {115341},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115341},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007891},
author = {Karolina Widzisz and Mateusz Kania and Joanna Zyla and Andrzej Polański},
keywords = {Bernoulli trial, Multivariate, Expectation–maximization, Binary data, Clustering},
abstract = {We have performed a comprehensive study dedicated to the analysis and comparative review of various unsupervised clustering algorithms for binary data analysis across a variety of datasets. We have compared the implementation of binary, model-based clustering algorithms corresponding to a multivariate Bernoulli Mixture Model with seven widely used reference algorithms based on distances between data vectors and aggregation/averaging operations. In our comparisons, we used both simulated and real datasets. The objective of the study was to draw conclusions that could inform the practical design of binary data analysis tools, particularly regarding the choice of algorithm, its initialization, and the influence of data binarization on the performance of the clustering procedure.}
}
@article{LIN2026115362,
title = {A patch-grouped topological fusion approach for enhanced multivariate numeric time-series modeling},
journal = {Applied Soft Computing},
volume = {200},
pages = {115362},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115362},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008100},
author = {Zixin Lin and Nur Fariha Syaqina Zulkepli and Mohd Shareduwan {Mohd Kasihmuddin} and R.U. Gobithaasan},
keywords = {Numeric time-series modeling, Autocorrelation, Topological data analysis, Patch-based representation, Grouped query attention},
abstract = {Time-series forecasting is fundamental to numerous real-world applications, including financial market prediction, environmental monitoring, healthcare, and energy management. Recent advancements in deep learning studies have improved forecast precision by leveraging trend decomposition, exogenous covariates, and frequency-domain features. However, topological representation approaches that capture intrinsic geometric structures of time-series data remain largely underutilized due to computational complexity and integration challenges. To address these limitations, this study proposes a Patch-Grouped Topological Fusion (PGTF) approach for enhanced multivariate time-series forecasting. The method introduces a scalable patch-based mechanism for extracting Local Topological Representations (LTR), reducing the computational burden of persistent homology. Furthermore, it enriches topological representations by combining static and evolution-based filtrations, capturing both global and dynamic structural patterns. A dual-stage integration architecture aligns topological and temporal features via Grouped Query Attention and self-attention, preserving variate heterogeneity and long-range dependencies. A hybrid loss function incorporating topological consistency further ensures structurally coherent and numerically accurate forecasts. Extensive experiments across oceanographic, air-pollution, and benchmark datasets demonstrate that PGTF achieves approximately 5–10% average reduction in mean squared error (MSE) across datasets compared with state-of-the-art forecasting methods.}
}
@article{WANG2026115430,
title = {DSFNet: A dual-stream feature fusion network based on strip convolution and transformer for building extraction},
journal = {Applied Soft Computing},
volume = {200},
pages = {115430},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115430},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008781},
author = {Peng Wang and Xiuqiao Xiang and Jianga Shang and Yishi Zhao},
keywords = {Building extraction, Remote sensing, Strip convolution, Inception, Transformer},
abstract = {Accurate building extraction from remote sensing imagery is crucial for applications such as urban planning and disaster management, yet accurate delineation remains challenging due to diverse building scales and complex backgrounds. Convolutional Neural Networks (CNNs) excel at capturing fine-grained local details while Transformers effectively model global context, existing hybrid approaches often struggle to synergistically leverage these strengths, potentially compromising edge precision for contextual understanding or incurring high computational costs. To address these issues, this paper proposes DSFNet, a novel Dual-Stream Feature Fusion Network. DSFNet effectively integrates an Inception-inspired spatial information stream, which utilizes orthogonal strip convolutions (1x7/7x1, 1x9/9x1) for enhanced multi-scale local feature extraction and precise edge delineation, with a Transformer-based global information stream capturing long-range contextual dependencies. Specifically, a Cross-dimensional (channel-spatial) Interaction Multi-Scale Attention (CIMA) mechanism is designed to refine features by modeling channel-spatial interactions with directional awareness, and an Adaptive Feature Fusion Module (AFFM) is introduced for the effective hierarchical integration of the dual-stream features. Extensive experiments on three challenging benchmark datasets (WHU, Massachusetts, and Inria) demonstrate state-of-the-art performance and the superiority of DSFNet, which achieves 91.25% IoU and 95.47% F1-score on the WHU dataset, while maintaining competitive computational efficiency (48.18M parameters, 112.02G FLOPs).}
}
@article{ZHANG2026115479,
title = {LGS-DPC: Density peak clustering integrating local granular ball information and spherical geodesic distance},
journal = {Applied Soft Computing},
volume = {200},
pages = {115479},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115479},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009270},
author = {Xingguo Zhang and Li Xu and Weikuan Jia},
keywords = {Granular ball computation, Density peaks clustering, K-nearest neighbors, Spherical geodesic distance},
abstract = {Granular ball (GB) density peaks clustering (GB-DP) is a fast-clustering method that applies the concept of coarse-granular GB computation to density peaks clustering (DPC), effectively addressing the slow running efficiency of DPC. However, studies have shown that GB-DP fails to accurately identify cluster centers when dealing with data that have uneven density distributions and cannot effectively handle manifold data. To address these issues, this paper proposes a new Density Peaks Clustering method that integrates local granular ball information and spherical geodesic distances (LGS-DPC). By redesigning the GB generation method, as well as the density and distance calculation approaches, the algorithm is better adapted to handle uneven density distributions and manifold data. First, a simplified adaptive neighbor search algorithm is used to achieve adaptive generation of GBs. Then, by combining the local density information of the GBs themselves and their nearest neighbors, a new density calculation formula is proposed to improve the handling of uneven density distributions and manifold data. Finally, spherical geodesic distances are introduced to replace traditional Euclidean distance calculations, allowing for more precise capture of the geometric features of manifold data. Experiments on synthetic and real datasets against eight advanced baselines show that LGS-DPC achieves a strong accuracy-efficiency trade-off. Compared with the strongest baseline, the average ACC/NMI gains are 5.5%/11.7% on synthetic datasets and 3.1%/1.6% on real datasets. Code: https://github.com/SunnyZCode/LGS-DPC.}
}
@article{WANG2026115390,
title = {ADSESC: An enhanced escape algorithm based on adaptive decentralized search strategy for low-altitude UAV path planning in complex environments},
journal = {Applied Soft Computing},
volume = {200},
pages = {115390},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115390},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008380},
author = {Mingbin Wang and Chengcheng Chen and Jiatong Liu and Xianchang Wang and Helong Yu and Jiehong Wu and Hua Yang and Jiajia Li and Ali Asghar Heidari and Huiling Chen},
keywords = {Low-altitude, Unmanned aerial vehicle, Path planning, Escape algorithm, Adaptive decentralized search strategy},
abstract = {In low-altitude freight logistics scenarios, Unmanned Aerial Vehicle (UAV) path planning plays a critical role in ensuring operational efficiency and collision-free navigation. The Escape algorithm (ESC) represents a promising metaheuristic approach for addressing UAV path planning challenges. However, due to its core limitations of a static fixed-ratio population partitioning strategy and a single search scheme during the late iteration phase, the search behavior of individuals within the population lacks clear guidance and falls into blind exploration. This limits ESC to achieving ideal optimization results only in simple scenarios; when applied to complex UAV navigation environments, its drawback of inadequate solution accuracy will be thoroughly exposed. To mitigate these drawbacks, this study presents an adaptive decentralized search strategy designed to effectively mitigate ESC’s shortcomings. Specifically, the strategy dynamically partitions the population during iterations. Using the average fitness value as a threshold, it divides the population into the elite group and the general group, and assigns differentiated search strategies to each for co-evolution. By integrating this strategy, we develop a novel algorithm referred to as ADSESC. ADSESC is evaluated against other state-of-the-art algorithms on 29 IEEE CEC 2017 benchmark functions and the UAV path planning models based on four constraints. The results demonstrate that ADSESC not only excels in performance across the 29 benchmark functions but also generates smoother and shorter paths compared to the other algorithms evaluated.}
}
@article{NAGI2026115307,
title = {Adaptive fuzzy secondary load frequency control with photovoltaic and battery energy storage system},
journal = {Applied Soft Computing},
volume = {200},
pages = {115307},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115307},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007556},
author = {Farrukh Nagi and Khairul Salleh and Navinesshani Permal and Muhamad Mansor and Miszaina Osman},
keywords = {Load frequency control, Adaptive fuzzy control, Takagi-Sugeno Inference, Battery energy storage system, Maximum power point tracking, Incremental conductance},
abstract = {Battery Energy Storage Systems (BESS) are increasingly used in Load Frequency Control (LFC) due to their fast response to frequency deviations. However, maintaining the battery’s State of Charge (SOC) is a significant challenge, especially when solar photovoltaic (PV) output fluctuates due to variable irradiation. This study presents an Adaptive Fuzzy Load Frequency Control (AF-LFC) strategy integrated with a PV-BESS system. The proposed approach dynamically adjusts control signals in response to changes in power load, solar irradiation, and temperature. The proposed system is simulated with solar irradiation and temperature profile. An adaptive Area Control Error (ACE) participation factor is used to coordinate power sharing between BESS and thermal generators. A major focus is placed on ensuring that the BESS restores its initial SOC after 24 h of operation, enabling continuous daily cycling. Simulation results confirm that the AF-LFC-BESS offers superior frequency regulation compared to conventional proportional-integral (PI) and traditional fuzzy control methods. It also supports reliable battery operation over time. These findings suggest the proposed method is well-suited for enhancing stability in power systems with high levels of renewable energy penetration.}
}
@article{HWANG2026115420,
title = {Multi-modality based future predictive representation learning for video anticipation captioning},
journal = {Applied Soft Computing},
volume = {200},
pages = {115420},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115420},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008689},
author = {Jiyeon Hwang and Suyoung Kim and Ho-Young Jung},
keywords = {Video anticipation captioning, Multimodal learning, Representation learning, Cross-modality representation learning},
abstract = {Anticipating future video content is crucial for developing intelligent systems that can understand and respond to upcoming events. Humans naturally anticipate the future by integrating both visual and linguistic cues, which suggests the importance of jointly modeling multimodal and temporal continuity. Despite recent progress in future captioning, most approaches capture only limited correlations between past and future representations, reflecting insufficient integration of multiple modalities compared to how humans perceive upcoming events. To address this challenge, we propose multimodal-future predictive representation learning (M-FPRL), an end-to-end framework that anticipates future captions by learning both intra-modal and inter-modal correlations between past and future events. Furthermore, M-FPRL introduces a mean-squared-error-based contrastive learning objective (MseCon) to enhance the coherence of visual representations across time. Experiments on the ActivityNet-Captions and ViTT datasets demonstrate that our method achieves state-of-the-art performance, surpassing previous approaches by up to +18.31 CIDEr points.}
}
@article{ZHANG2026115448,
title = {Multi-agent deep reinforcement learning: Resource allocation for RIS-UAV-assisted post-disaster networks under imperfect CSI and malicious jammer},
journal = {Applied Soft Computing},
volume = {200},
pages = {115448},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115448},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008963},
author = {Tianyue Zhang and Yuchao Dang and Xuefen Chi},
keywords = {Reconfigurable intelligent surface (RIS), Energy harvesting (EH), Multi-agent deep reinforcement learning (MADRL), Post-disaster environment, Imperfect channel state information (CSI)},
abstract = {Reconfigurable intelligent surfaces (RISs)-unmanned aerial vehicles (UAVs)-assisted post-disaster networks (PDNs) have emerged as a promising solution for rapidly restoring communications in damaged areas. However, existing studies largely overlook the joint impacts of imperfect channel state information (CSI), malicious adaptive jamming, constrained backhaul capacity, and UAV energy sustainability, which severely limit communication reliability in realistic PDNs. To address these coupled challenges, this paper formulates a network throughput (NT) maximization problem that jointly optimizes backhaul allocation, beamforming, bandwidth assignment, RIS phase shifts, and energy harvesting (EH) time. To solve this highly dynamic and non-convex problem, we propose a heuristic exploration–exploitation trade-off multi-agent proximal policy optimization (HEET-MAPPO) algorithm. It employs two complementary metrics: cooperative entropy influence (CEI) promotes comprehensive exploration of complex mappings and variable relationships under dynamics, while entropy reward sensitivity (ERS) refines exploitation in near-optimal regions to ensure stable convergence. A dynamic attenuation parameter, adjusted via real-time monitoring of the state space of user equipment (UE) access rates, balances these metrics, enhancing stability and avoiding manual hyperparameter tuning. Furthermore, a global reward function that integrates Jain’s fairness index with adaptive penalties is designed to ensure equitable services and training stability. Simulation results demonstrate that HEET-MAPPO outperforms benchmark methods, exhibiting higher NT values, lower convergence variance, excellent scalability, and efficient responses.}
}
@article{XU2026115424,
title = {Data-centric process monitoring based on green development of deep latent variable model},
journal = {Applied Soft Computing},
volume = {200},
pages = {115424},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115424},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008720},
author = {Ouguan Xu and Songsong Wang and Zeyu Yang and Zhiqiang Ge},
keywords = {Data-centric engineering, Industrial process monitoring, Deep latent variable model, Green AI, Data-centric AI, Self-training},
abstract = {While deep learning has advanced industrial process monitoring, prevailing methods remain model-centric and often overlook the critical importance of original data quality. Shifting from low-quality large volume data to high-quality small volume data is essential for developing trustworthy and resource-efficient industrial AI. To address this, we propose a data-centric systems framework that strategically integrates a deep latent variable model, data quality evaluation, and self-training. To minimize manual annotation expense, the framework initializes with a strictly limited set of verified training samples. It then autonomously evaluates and incorporates unevaluated data for self-training, prioritizing samples with high reliability. Crucially, a Critical Reliability Index (CRI) is formulated within the deep model’s latent space to act as a strict risk-control mechanism, explicitly excluding low-quality or ambiguous data to maintain model robustness. Both the feasibility and effectiveness of this architecture are confirmed through a detailed case study on the TE benchmark industrial process. Furthermore, quantitative evaluations demonstrate measurable reductions in annotation effort and computational overhead, validating the framework as a highly efficient, sustainable Green AI solution for process monitoring.}
}
@article{ALMOBIN2026115415,
title = {A sieve-driven genetic algorithm for RSA cryptosystem: Exploiting digit distribution and algebraic regularities},
journal = {Applied Soft Computing},
volume = {200},
pages = {115415},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115415},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600863X},
author = {Mahadee {Al Mobin}},
keywords = {Artificial intelligence, Genetic algorithms, Cryptanalysis, Integer factorization, Public-key cryptography},
abstract = {Prime factorization has long stood as a fundamental challenge in number theory, with direct implications for modern cryptography. Specifically, the security of the Rivest-Shamir-Adleman (RSA) scheme relies on the intractability of factoring large semiprimes. This study explores a novel approach to cryptanalysis by embedding structural properties of prime numbers such as digit distribution patterns and length-based constraints, into the design of genetic algorithms. We propose a conjecture, based on extensive simulations of numbers up to 100 billion, that the digits of large primes exhibit asymptotically uniform distribution, and we leverage this observation to substantially narrow the factorization search space. Our method achieves a 98.15% reduction in candidate space relative to existing heuristics, significantly improving computational efficiency. Building on these insights, we introduce an optimized genetic algorithm, termed the Sieve Method, which exploits algebraic regularities inherent in primes. Empirical validation on semiprimes up to 23 digits demonstrates an 84% success rate. Relative to benchmark approaches, the sieve framework delivers a 320.35% improvement in success rate and reduces convergence generations by 64.06%, with statistical significance confirmed via the Wilcoxon signed-rank test. These findings highlight the value of theory-informed heuristics in advancing cryptanalytic techniques and point toward promising future directions in computational number theory.}
}
@article{MU2026115428,
title = {LST-CDPM: A lightweight spatio-temporal conditional denoising diffusion probabilistic model for invasive alien species distribution prediction},
journal = {Applied Soft Computing},
volume = {200},
pages = {115428},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115428},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008768},
author = {Liping Mu and Xiaoyu Zhang and Zhibo Chen and Guangyu Huo and Rui Zhang and Wenda Luo},
keywords = {Invasive alien species distribution, Spatio-temporal modeling, Multi-source environmental conditioned generation, Diffusion model, Deep learning},
abstract = {The impact of invasive alien species on ecosystems and economies is increasingly severe, making accurate predictions of their distribution crucial for effective management strategies. However, traditional species distribution models struggle to capture complex spatio-temporal dependencies, deep learning methods remain limited in their ability to model environmental conditions, and the denoising networks used in existing diffusion models are not well suited for handling multi-source environmental condition information. To address these issues, this study introduces a Lightweight Spatio-Temporal Conditional Denoising Diffusion Probabilistic Model (LST-CDPM) designed for predicting the distribution of invasive alien species. The model first incorporates a Spatio-Temporal Adaptive Feature Module to capture the spatio-temporal dependencies of species distributions. Second, by introducing a diffusion model framework that continuously injects multi-source environmental conditions at each denoising step, it effectively alleviates the problem of condition-information decay commonly seen in traditional approaches. Finally, an attention mechanism is integrated into the denoising network to enhance selective focus on key features. Together, these designs enable the model to more effectively integrate historical observations, ecological priors, and multi-source environmental conditions, thereby substantially improving prediction accuracy and generalization performance. To support model training and evaluation, two high-quality multi-temporal datasets are constructed. The experimental results demonstrate that the proposed method significantly outperforms existing baseline models across multiple evaluation metrics. This approach not only significantly enhances the accuracy and stability of invasive alien species distribution predictions but also serves as an ecological management tool, providing managers and policymakers with predictive outcomes and decision support. It thereby aids in monitoring, risk assessment, and the formulation of management strategies for invasive alien species, fully demonstrating its clear ecological value and practical applicability.}
}
@article{LUO2026115377,
title = {Evolutionary multi-task optimization with adaptive similarity crossover and linear mapping},
journal = {Applied Soft Computing},
volume = {200},
pages = {115377},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115377},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008252},
author = {Guoxing Luo and Xiaoliang Ma},
keywords = {Evolutionary multi-task optimization, Multi-task optimization, Cosine similarity, Fibonacci sequence},
abstract = {Evolutionary multi-task optimization (EMTO) is an advanced optimization paradigm aimed at simultaneously optimizing multiple tasks, which has received widespread attention in recent years. Although existing EMTO algorithms have made some progress in knowledge transfer between tasks, there are still two main challenges: firstly, how to accurately evaluate the similarity between tasks in the knowledge transfer process to ensure effective transfer of knowledge between related tasks; secondly, how to maintain the diversity of the population and avoid the algorithm falling into local optima during the knowledge transfer process. In response to these two challenges, this paper proposes two novel strategies: adaptive similarity crossover and an offspring generation strategy based on linear mapping. These strategies collectively form the core of the MFEA-SCLM algorithm, aimed at addressing key challenges in EMTO. In the proposed adaptive similarity crossover, cosine similarity is used to evaluate the similarity between tasks, and a single-point crossover operation is performed based on the similarity to achieve more efficient knowledge transfer. In addition, the proposed offspring generation strategy based on linear mapping divides the search space into three sub-areas using the Fibonacci sequence, and randomly maps the offspring after single-point crossover operation to one of these three areas through linear mapping to explore new and promising solutions. This strategy not only helps maintain the diversity of the population, but also guides the algorithm to find the global optimal solution in a broader search space. The experimental results show that the MFEA-SCLM algorithm has significant advantages in handling multi-task optimization (MTO) problems, providing new solutions and ideas for the field of MTO.}
}
@article{RASHEED2026115474,
title = {Heuristic approaches for solving the k-weighted dominating set problem},
journal = {Applied Soft Computing},
volume = {200},
pages = {115474},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115474},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009221},
author = {Mohd Danish Rasheed and Alok Singh},
keywords = {Dominating set, -weighted dominating set, Discrete optimization, Genetic algorithm},
abstract = {In this paper, we present a problem-specific heuristic and a genetic algorithm for the k-weighted dominating set problem (k-WDSP). Given an undirected, edge-weighted graph G=(V,E,w), where w:E→R+ is a positive weight function on the edges, the objective of k-WDSP is to find a dominating set D⊆V of minimum cardinality such that for every vertex v∈V∖D, the total weight of the edges connecting v to the vertices in D is at least k. The k-WDSP is a recently introduced NP-hard problem with applications in social networks, wireless sensor networks, biological networks etc. The variation operators in the proposed genetic algorithm are specifically designed to capture the structural properties of the k-WDSP. To evaluate the performance of our approaches, we conducted experiments on k-WDSP benchmark instances available in the literature, as well as on 30 real-world graphs. Computational results show the effectiveness of our approaches.}
}
@article{KUMARI2026115369,
title = {ProDiSE: A proximity and distance scoring based pruning technique for large-scale supervised learning},
journal = {Applied Soft Computing},
volume = {200},
pages = {115369},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115369},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008173},
author = {Anuradha Kumari and M. Tanveer},
keywords = {Supervised learning, Least squares support vector machine, Proximity and distance scoring ensemble for universal representation, Local distance score, Global compactness score, Large-scale},
abstract = {In the current era of data-driven computing, efficiently handling large-scale datasets has become a fundamental necessity. However, most existing supervised learning models struggle to scale effectively due to their high computational demands. While existing models achieve good performance, their scalability is often limited, motivating the need for efficient data reduction strategies. In this work, we propose a non-iterative pruning framework, termed proximity and distance scoring ensemble (ProDiSE), with the goal of selecting a compact yet representative subset of training samples for scalable supervised learning. ProDiSE evaluates sample representativeness using two complementary geometric measures computed over random subsamples: a local distance score (LDS), which captures neighborhood density, and a global compactness score (GCS), which reflects proximity to class centroids. These scores are adaptively combined using a variance-based weighting scheme, allowing the informative samples to dominate for each class. To improve robustness against randomness, the scoring process is repeated across multiple ensemble runs, and final representativeness is determined via a 75th percentile aggregation strategy. The proposed ProDiSE framework is integrated with the least squares support vector machine (LSSVM), yielding ProDiSE-LSSVM, a sparse and computationally efficient classifier. The resulting model exhibits linear time and memory complexity with respect to the training set size. Extensive experiments on a wide range of real-world datasets demonstrate that ProDiSE-LSSVM consistently achieves higher classification accuracy than competing models while substantially reducing training cost. Overall, the proposed approach provides an effective and scalable solution for large-scale classification, offering a favorable balance between performance and computational efficiency.}
}
@article{JIANG2026115421,
title = {HoGCNs: High-order gated convolutional networks for enhanced 3D object detection via LiDAR-camera fusion},
journal = {Applied Soft Computing},
volume = {200},
pages = {115421},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115421},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008690},
author = {Haiyang Jiang and Bingbing Li and Guoxing Shang},
keywords = {3D object detection, Multi-sensor fusion, Autonomous driving, Deep learning, Image processing},
abstract = {3D object detection is a core task in autonomous driving, crucial for path planning, motion prediction, and decision control. In recent years, transformer-based methods have shown remarkable performance in 3D object detection for LiDAR-camera fusion. However, existing methods have primarily focused on the design of second-order dot-product self-attention fusion networks and have only used camera guidance for query initialization. They have not explored the correlation of high-order features and geometric information about objects, which is crucial for accurately identifying distant target objects. To address this, we propose High-order Gated Convolutional Networks (HoGCNs) based on geometric constraints and adaptive feature interaction. It achieves higher-order spatial interaction by iteratively applying gated convolutional units. Additionally, we design a query initialization strategy guided by both LiDAR and camera data to ensure that the initialized queries have more accurate positional and geometric information. Experimental results on the nuScenes dataset show that our HoGCNs improve the mean Average Precision (mAP) by 1.2% compared to HAMFNs.}
}
@article{LIU2026115482,
title = {A multi-pheromone ant colony optimization for large-scale traveling salesman problems},
journal = {Applied Soft Computing},
volume = {200},
pages = {115482},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115482},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009300},
author = {Qunfeng Liu and Qingnan Liu and Kanghua Zhu and Jiarui Zhang},
keywords = {Ant colony optimization, Traveling salesman problem, Multiple pheromone systems, Metaheuristics, Combinatorial optimization},
abstract = {The Traveling Salesman Problem (TSP) remains a fundamental benchmark in combinatorial optimization, where mature solvers like Concorde and LKH have achieved remarkable success for small to medium-scale instances. However, efficiently solving large-scale TSP instances continues to present significant challenges, warranting further algorithmic innovations. This paper presents the design and evaluation of MPACO, an efficient ant colony optimization (ACO) variant tailored for solving large-scale TSP instances. The primary innovations of MPACO include: (1) the extraction of inherent geometric information from TSP instances, which is formulated as a static pheromone capturing the relative importance of each edge, and (2) the development of a cooperative optimization mechanism that integrates this static pheromone with traditional dynamic pheromones to guide the search process more effectively. Extensive numerical experiments demonstrate that MPACO significantly outperforms state-of-the-art ACO variants on large-scale ArtTSP benchmark instances. Remarkably, MPACO achieves superior tour quality compared to the powerful LKH solver on several challenging Tnm TSP instances, establishing it as a highly competitive approach for large-scale combinatorial optimization.}
}
@article{LUO2026115171,
title = {Unsupervised anomaly localization network for automated fiber placement defect detection under data scarcity},
journal = {Applied Soft Computing},
volume = {200},
pages = {115171},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115171},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006198},
author = {Weiheng Luo and Fei Liu and Baoning Chang and Junfan Shang and Jiarui Zhang and Yingdan Zhu and Wuxiang Zhang and Xilun Ding},
keywords = {Automated fiber placement, Layup defects, Anomaly localization, Defect detection, Unsupervised learning},
abstract = {The advancement of defect detection systems for automated fiber placement processes has been greatly accelerated by modern sensing technologies and intelligent inspection algorithms, resulting in enhanced manufacturing efficiency and product quality. Nevertheless, most existing detection algorithms depend on supervised learning frameworks, which are limited by the need for labor-intensive annotation and the scarcity of labeled data. To address these limitations, a novel feature-embedding based unsupervised anomaly localization model, named DenseFlow, has been introduced. This model leverages a pretrained feature extractor and a densely connected multiscale normalizing flow module, enabling robust and efficient anomaly localization by evaluating pixel-wise log-likelihood distributions. To evaluate the proposed method's effectiveness, an anomaly localization dataset, referred to as AFP-AL, was created using a robotic inspection system equipped with a laser profilometer. The dataset construction involved multiphase preprocessing strategies, including the transformation of point clouds into grayscale depth images, sliding window partitioning, and image synthesis operations. Experimental results show that DenseFlow outperforms competing methods adapted to the AFP-AL task, reaching 98.17%, 92.02%, and 69.50% in the threshold-agnostic metrics AU-ROC, AU-PRO, and AU-IoU, respectively. Furthermore, the localization results highlight its resilience to errors introduced by human annotation, which are inherent in supervised learning approaches. Additionally, the proposed methodology is highly adaptable, requiring only minor modifications to process images from various sensors. Its seamless integration into AFP systems enables real-time defect detection, underscoring its potential to advance more efficient and autonomous monitoring systems in AFP manufacturing.}
}
@article{ZHANG2026115393,
title = {A Light-Guided Q-learning algorithm with backward reward propagation for path planning in cruise ship environments},
journal = {Applied Soft Computing},
volume = {200},
pages = {115393},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115393},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008410},
author = {Wanying Zhang and Huajun Zhang},
keywords = {, , , , },
abstract = {The increasing structural complexity of modern cruise ships, including constrained corridors, non-convex layouts, and densely distributed obstacles, poses significant challenges for reliable and efficient path planning. To address these issues, this study proposes a Light-Guided Q-learning Algorithm with Backward Reward Propagation (LGB-QL), designed to improve both convergence efficiency and trajectory quality in high-complexity cruise ship environments. Specifically, LGB-QL incorporates three synergistic innovations. First, a Q-table initialization strategy inspired by the physical principle of light intensity attenuation is introduced, embedding spatial priors to guide early-stage exploration more efficiently. Second, a reward propagation mechanism that combines backward updates with Monte Carlo (MC) correction is developed to enhance the accuracy of Q-value estimation and accelerate convergence, while mitigating bootstrapping bias. Finally, an adaptive exploration adjustment strategy based on policy stability is employed to dynamically balance exploration and exploitation, thereby improving learning robustness. Extensive evaluations on both simulated and real-world cruise ship layouts demonstrate that LGB-QL consistently outperforms other baseline methods in terms of path length, smoothness, and computational efficiency. These results validate the algorithm’s effectiveness in generating reliable and high-quality evacuation routes under complex spatial constraints, underscoring its strong applicability to real-world navigation tasks.}
}
@article{CHEN2026115409,
title = {A dual-channel contrastive framework for sequential recommendation based on variational autoencoder},
journal = {Applied Soft Computing},
volume = {200},
pages = {115409},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115409},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008574},
author = {Rui Chen and Zonglin Wang and Wanwei Huang and Jianwei Zhang and Jian Wang and Huawei Tu},
keywords = {Sequential recommendation, Variational autoencoder, Contrastive learning, Recommender systems},
abstract = {Sequential recommendations play a crucial role on various platforms by predicting user-preferred items based on historical interaction sequences. However, existing recommendation methods still face challenges such as data sparsity, noise interference, and rapidly evolving user interests. Although contrastive learning can partially alleviate these problems, it cannot capture the uncertainty that arises when the sequential dependence assumptions of user behavior are disrupted by unobserved factors in real-world scenarios. To address these issues, we propose a Dual-Channel Contrastive Variational Autoencoder (DCCVAE) for sequential recommendation, which integrates uncertainty modeling, denoising, and contrastive representation learning into a unified framework. Specifically, DCCVAE first constructs a contrastive variational autoencoder to mitigate data sparsity while modeling uncertainty in user behavior. Then, to further enhance the quality of input data, we introduce a time-frequency domain denoising technique to remove noise from raw sequences. Finally, to improve the effectiveness of contrastive learning and promote more robust sequence representations, we design two general sequential data augmentation strategies to generate diverse differential samples. Extensive experiments on five real-world datasets demonstrate that DCCVAE consistently outperforms state-of-the-art baselines across various common evaluation metrics.}
}
@article{LLAMOSASMAYCA2026115288,
title = {Environmental challenges of deep underwater infrastructures: elliptic curves in the evolutionary service design of submerged arch-type structures},
journal = {Applied Soft Computing},
volume = {200},
pages = {115288},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115288},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007362},
author = {Waldemar H. Llamosas-Mayca and Alejandro M. Hernández-Díaz and Jorge Pérez-Aracil and Manuel D. García-Román and Francisco Pellicer-Martínez and Sancho Salcedo-Sanz},
keywords = {Underwater infrastructures, Elliptic curves, Arch shape-optimization, Evolutionary computation},
abstract = {The development of undersea infrastructures is critical for future cities, yet their design faces significant challenges in minimizing environmental impact while ensuring structural optimization. Traditional design methods for submerged arches, often based on funicular geometry, are insufficient for achieving optimal solutions that balance structural resilience, economic efficiency, and serviceability. The negative impacts of these systems on the marine environment must be minimized in order to align with the international sustainability goals. To overcome this issue, the design of optimal structures can reduce the stress level while the installation functionality is improved. This work proposes the novel application of the elliptic curves to the shape-optimization of undersea installations supported on arch-type structures. Such optimization is approached beyond the traditional minimization of the bending stress (or funicular design), and other design parameters regarding the enclosed space and the second order structural behavior of the arch are considered in order to obtain a more resistant and functional infrastructure. To this aim, a hybrid strategy based on the geometrically nonlinear finite element analysis of the arch structure, and its optimization using a multi-method ensemble for optimization (CRO-SL), is implemented. Unlike previous methods based on the conic-shape parameterization of the arch’s centerline in polar coordinates, elliptic curves represent a comprehensive set of algebraic curves in Cartesian coordinates whose discriminant allows exploring a larger space of solutions, highlighting the benefits of considering alternative geometries distinct of the funicular solution. The optimal solution obtained with the multi-method ensemble is validated through a comparative analysis. The results obtained demonstrated the high effectiveness of the elliptic curves combined with the CRO-SL algorithm in finding optimal structural solutions, thereby achieving a more efficient use of the involved materials and resulting in a significant improvement in the service design of the submerged installation.}
}
@article{AHMAD2026115423,
title = {Bridging black box and explainability: A complete post-hoc grey-box XAI framework},
journal = {Applied Soft Computing},
volume = {200},
pages = {115423},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115423},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008719},
author = {Aleena Ahmad and Kashif Zafar},
keywords = {Explainable artificial intelligence (XAI), Artificial neural networks, Feature relevance, Trepan algorithm, Surrogate models},
abstract = {The growing complexity of Artificial Neural Networks (ANNs) has increased the need for faithful explanations that accurately reflect the model’s reasoning without reducing predictive accuracy. This study introduces a unified post-hoc grey-box explainability framework that operates along two complementary paths. First, we propose a novel feature relevance algorithm, Global Relevance Accumulation via Sequential Propagation (GRASP). Building on this, we extend the Trepan algorithm into three new variants: Integrated Gradients–integrated Trepan (IG-iT), Layer-wise Relevance Propagation–integrated Trepan (LRP-iT) and GRASP-iT. These embed relevance directly into the splitting criterion, producing more compact and informative surrogate (mimicking complex model behavior) decision trees. Second, relevance extracted from IG, LRP, or GRASP, along with expert relevance (domain expert knowledge), is fed back into the ANN to guide the learning process toward more meaningful and human-aligned feature representations. The framework thus delivers dual benefits: relevance-informed surrogate trees that improve interpretability, and a refined ANN that leverages explanation feedback for improved learning. Importantly, this feedback mechanism enables the integration of expert knowledge into the learning process, allowing the model to focus on features that are meaningful from a human perspective. Experiments on benchmark datasets demonstrate consistent improvements in both accuracy and explainability, outperforming standard Trepan, Cluster Trepan, and LIME baseline explanation methods. The results show that feature relevance can simultaneously advance interpretability and predictive power, moving toward more transparent, reliable, and human-centered AI systems.}
}
@article{HU2026115446,
title = {Edge-aware and context-guided multiscale feature integration network for steel surface defect detection},
journal = {Applied Soft Computing},
volume = {200},
pages = {115446},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115446},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600894X},
author = {Zhentao Hu and Jing Yan and Fei Niu and Wei Hou},
keywords = {Steel defect detection, Deep learning, Edge feature enhancement, Context guided downsampling},
abstract = {Steel surface defect detection faces three main challenges: inaccurate boundary localization due to blurred defect edges, multi-scale detection difficulties caused by significant scale differences, and feature interference from complex textured backgrounds. To address these issues, this study proposes an efficient, high-precision, and real-time industrial defect detection model. The proposed model introduces three key modules. First, the Edge Feature Enhancement Convolution (EFEConv) combines Sobel edge detection with efficient convolution to enhance sensitivity to edges and fine textures via adaptive feature fusion. Second, the Context Guided Downsampling (CGDown) uses a local-global dual-branch mechanism in the downsampling stage to capture both fine details and contextual information, solving the scale difference problem through multi-scale feature fusion. Finally, the Group Convolution Efficient Detection Head (GCEDet) utilizes a group convolution mechanism to reduce feature channel coupling, suppress background interference, and achieve accurate localization with reduced computational overhead. Experimental results on the NEU-DET and GC10-DET datasets demonstrate that the proposed ECG-YOLO achieves superior detection accuracy, with mAP@0.5 reaching 79.6% on NEU-DET, a 2.6% improvement, and 67.8% on GC10-DET, a 6.1% improvement, particularly demonstrating effectiveness in detecting small defects. Cross-dataset validation confirms the robustness and adaptability of the model across varying steel surface conditions, while ablation studies demonstrate the importance of each module in enhancing performance.}
}
@article{ZHANG2026115443,
title = {Multidimensional data fusion and explainable modeling for electricity demand forecasting},
journal = {Applied Soft Computing},
volume = {200},
pages = {115443},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115443},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008914},
author = {Weiwei Zhang and Xueni Wang and Jianzhou Wang},
keywords = {Electricity Demand Forecasting, Interpretable Model, Multidimensional Data},
abstract = {The "black box" model in time series forecasting has long been plagued by inherent limitations in critical engineering scenarios such as electricity demand forecasting, primarily stemming from its lack of inherent interpretability. However, the accuracy and stability of electricity demand forecasting hold core strategic significance: they not only directly dictate the scientificity and rationality of energy supply-side dispatching and regulation decisions, thereby avoiding inefficient resource allocation caused by redundant power generation capacity and energy shortages arising from insufficient generation capacity, but also indirectly influence the safe and stable operation of the energy system and the steady development of the macroeconomy through a transmission effect. To address these issues, this paper proposes a highly stable electricity demand forecasting framework based on an interpretable model, establishing a progressive data preprocessing system encompassing "feature screening – multi-scale decomposition – anomaly enhancement". It systematically optimizes the quality of input data by precisely screening core influencing features, deconstructing multi-scale temporal evolution patterns, and enhancing adaptability to abnormal data disturbances. Subsequently, the preprocessed high-quality multidimensional data is fed into the Temporal Fusion Transformer (TFT) model endowed with strong interpretability for predictive modeling. Experimental results demonstrate that this framework not only retains the good interpretability of the model to clearly trace the generation logic of prediction results, but also provides high-quality inputs through progressive data processing, which significantly enhances the stability of multi-step prediction; its MAPE values for 48-step to 168-step predictions across four U.S. states range from 4.11% to 11.21%, effectively meeting the practical application requirements of electric load demand forecasting.}
}
@article{ZHAO2026115398,
title = {KLDA-TICNet: Transposition interaction convolutional network for ship trajectory prediction using kullback-leibler divergence attention mechanism},
journal = {Applied Soft Computing},
volume = {200},
pages = {115398},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115398},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600846X},
author = {Licheng Zhao and Yi Zuo},
keywords = {Trajectory prediction, Transposition feature, Interactive convolutional network, Attention mechanism, Kullback-Leibler divergence},
abstract = {Intelligent shipping systems advance deep learning applications in ship trajectory prediction, enhancing maritime security risk identification. However, existing models struggle to capture multi-ship interactions in high-density areas due to the significant influence of neighboring vessels. To address this, we propose a trajectory prediction method integrating Kullback-Leibler divergence attention (KLDA) and a dual-stream parallel architecture. First, a transposition interactive convolutional network (TICNet) employs a dual-layer convolution structure to model dynamic interactions between target and adjacent ships. Second, KLDA mitigates amplitude interference by mapping feature vectors to probability distributions, decoupling similarity computation from input amplitude to suppress dominant local outliers in attention maps. Third, the time-feature dual-stream strategy separately models temporal dependencies via time-embedding sequences and encodes heterogeneous features as tokens using sample transposition, with self-attention explicitly capturing feature correlations. Finally, a cascaded transformer decoder (CTD) iteratively refines outputs through recursive optimization. Experimental results on three real-world scenarios demonstrate average displacement error reductions of 16.75%, 33.48%, and 45.63% compared to the best baseline, validating the method’s effectiveness in complex, high-density navigation environments.}
}
@article{ZHAO2026115419,
title = {Adaptive product family formation: A medoid-based fuzzy clustering method for mixed product assembly in the shared human–robot collaborative system},
journal = {Applied Soft Computing},
volume = {200},
pages = {115419},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115419},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008677},
author = {Ruihan Zhao and Sichen Tao and Zhou Yangzheng and Xinyang Zhang and Pengzhong Li},
keywords = {Mixed product assembly, Human–robot collaboration, Product family, Fuzzy clustering},
abstract = {Sustainable mass customization requires assembly systems to rapidly adapt to personalized products while maintaining efficiency. Human–robot collaboration (HRC) offers a promising solution to this advanced manufacturing paradigm by combining robotic execution efficiency with human operational flexibility. Although collaborative technologies have gradually advanced, strategies for reusing HRC systems remain underexplored. Frequent product switching forces HRC systems to restructure processes repeatedly, which significantly undermines resource utilization and execution efficiency, and even leads to system shutdowns. In this study, a fuzzy-logic-enabled human–robot collaboration product family (HRC-PF) strategy is proposed to organize mixed products,which represents heterogeneous information with triangular fuzzy numbers and enables soft membership clustering for interpretable decision support under uncertainty. Specifically, a fuzzy triangular number-based mixed product differential evaluation system (FMPD) is designed, which fuses task-resource-system information to quantify the feasibility of assembling heterogeneous products in the same HRC system. Based on this evaluation and the assembly efficiency pursuit, the HRC-PF formation problem (HRC-PFFP) is further modeled. To tackle the challenges of task complexity and product diversity in HRC-PFFP, an interpretable product-medoid fuzzy clustering algorithm (MFCA) is proposed to adaptively generate assembly sequences, determine family numbers, and identify the optimal family members. Experiments are conducted on 15 instances, combining three product scales and five operation complexities. Statistical tests indicate that the MFCA-enabled HRC-PF maintains high clustering efficiency and scalability across various task conditions. Compared with three widely applied advanced clustering algorithms, MFCA achieves better intra-family compactness and inter-family separation. Against three state-of-the-art product family formation methods, the proposed HRC-PF shows superior performance in modeling product differences and detecting reusable resources. Furthermore, the proposed method is deployed to support mixed Li-ion power battery pack assembly in a shared HRC system, which effectively enhances resource utilization and overall system efficiency, thereby demonstrating its adaptability in industrial applications.}
}
@article{ZHUO2026115472,
title = {Hypergraph-based multi-relational attention network for aspect-based multimodal sentiment analysis},
journal = {Applied Soft Computing},
volume = {200},
pages = {115472},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115472},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009208},
author = {Yaqi Zhuo and Lisong Ou and Zhixin Li},
keywords = {Multi-modal aspect-based sentiment analysis, Multi-modal aspect term extraction, Multi-modal aspect-level sentiment classification, Hypergraph representation},
abstract = {Multi-modal aspect-based sentiment analysis (MABSA) has emerged as a key research direction in artificial intelligence, encompassing two core tasks: multimodal aspect term extraction (MATE) and multimodal aspect-level sentiment classification (MASC). While existing methods primarily rely on strict target-aspect alignment, this approach suffers from three critical limitations: (i) neglect of contextual semantic information essential for sentiment understanding, (ii) inability to model higher-order interactions in multimodal data, and (iii) underutilization of syntactic structures in text. To overcome these limitations, we propose a Hypergraph-based Multi-relational Attention Network (HyMAN), an innovative framework that pushes the boundaries of current research through two key technical contributions. First, we develop a novel dynamic hypergraph framework to model complex many-to-many multimodal relationships. Second, we propose a novel dual-stream cross-excitation mechanism that employs parallel attention pathways to separately yet synergistically process syntactic dependency structures and aspect-specific features, while implementing dynamic feature recalibration to exchange and amplify complementary information between streams. Comprehensive experiments demonstrate that HyMAN consistently outperforms current state-of-the-art methods across multiple benchmarks.}
}
@article{REVATHI2026115447,
title = {PromptSAMNet: A memory-enhanced adaptive prompting and clustering-augmented SAM 2.0 framework for multi-leaf plant disease diagnosis},
journal = {Applied Soft Computing},
volume = {200},
pages = {115447},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115447},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008951},
author = {A.R. Revathi and Preethi {Sambandam Raju}},
keywords = {PromptSAMNet, Multi-leaf Disease Detection, Prompt-based Segmentation, SAM 2.0},
abstract = {Efficient detection of multiple co-existing leaf diseases is critical for precision agriculture, enabling early intervention and reducing crop loss. However, existing vision-based systems face challenges in fine-grained lesion localization, background noise, and real-time scalability under diverse agricultural conditions. This work introduces a memory-guided adaptive prompting paradigm that transforms the Segment Anything Model (SAM 2.0) from generic segmentation into domain-aware reasoning for multi-leaf plant disease detection. Based on this paradigm, PromptSAMNet integrates background suppression to eliminate irrelevant regions, adaptive prompt generation to focus on lesion-specific areas, prompt clustering to ensure segmentation consistency, and a memory module for context-aware classification. These components collectively enhance feature representation and improve robustness under complex field conditions. Experimental evaluation on Field Plant, Plant Doc, and CCMT datasets demonstrates that PromptSAMNet achieves 95.2% accuracy, 87.5% IoU, 89.9% mAP, 93.6% F1-score, 0.905 MCC, and 84.3% Jaccard Index, outperforming existing CNN- and R-CNN-based approaches. The framework also maintains real-time performance, achieving approximately 40 FPS, making it suitable for practical agricultural deployment.}
}
@article{KARAKULLUKCU2026115411,
title = {A meta-possibilistic fuzzy framework for robust bivariate correlation estimation},
journal = {Applied Soft Computing},
volume = {200},
pages = {115411},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115411},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008598},
author = {Erdinc Karakullukcu},
keywords = {Robust estimation, Outlier, Meta fuzzy functions, Bivariate correlation, Ensemble learning},
abstract = {Traditional correlation measures, such as Pearson’s coefficient, are widely used for assessing bivariate associations; however, their reliability may deteriorate under non-normal distributions, nonlinear dependencies, and the presence of outliers. Although several robust estimators have been proposed, selecting a single estimator that performs consistently well across different data conditions remains challenging. To address this limitation, this study proposes an ensemble-based dependency estimation framework called the Meta Possibilistic Fuzzy Correlation Function (MPFCF). MPFCF integrates multiple correlation estimators and dynamically weights their contributions using Possibilistic Fuzzy c-Means clustering, supported by a novel cluster validity measure, the Penalized Fuzzy Validity Index. The framework was evaluated through extensive simulation experiments and real-world benchmark datasets, including the Hawkins–Bradu–Kass synthetic dataset. The results show that MPFCF consistently produces lower symmetric mean absolute percentage error (SMAPE) values and more stable estimates compared to individual estimators. An ablation study confirmed the structural robustness of the framework, with the mean rank of MPFCF remaining within a narrow range (1.167–1.667) despite substantial changes in the estimator pool. Furthermore, the generalizability of the framework was validated by extending the estimator pool to include modern [0,1] dependency measures such as Chatterjee’s ξ, Robust Distance Correlation, Baak’s ∅K, and HSIC, where MPFCF maintained its superior global rank of 1.717. Statistical validation using the Friedman test and Nemenyi post-hoc analysis confirmed that these improvements are statistically significant. The proposed MPFCF provides a robust, adaptive solution for dependency estimation in complex real-world data analysis tasks involving nonlinear relationships and outliers.}
}
@article{GOSWAMI2026115435,
title = {Adaptive physics-informed machine learning for bus travel time prediction: Solving the peak prediction problem},
journal = {Applied Soft Computing},
volume = {200},
pages = {115435},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115435},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008835},
author = {Atmadip Goswami and Chayan Banerjee and Dhivya Bharathi and Lelitha Vanajakshi},
keywords = {Traffic flow modeling, Intelligent transport systems, Bus travel time prediction, Physics-informed neural networks, Outlier modeling},
abstract = {Accurate bus travel time prediction (BTTP) is critical for reliable transit operations, yet remains challenging due to complex, heterogeneous traffic dynamics. Conventional approaches are limited: statistical methods struggle with non-linear patterns, while purely data-driven deep learning models often lack interpretability and physical consistency, hindering their deployment. This study addresses these limitations by first evaluating a hybrid Physics-Informed Machine Learning (PIML) framework, integrating Aw-Rascle traffic flow theory with deep learning architectures. We compare Physics-Informed Neural Networks (PINNs) and Physics-Informed Long Short-Term Memory (Phy-LSTM) networks against traditional Artificial Neural Networks (ANN), LSTMs, and a numerical Godunov scheme using real-world bus GPS data. Results confirm that PIML models, particularly Phy-LSTM, significantly outperform pure data-driven and pure physics-based models in general predictive accuracy, demonstrating the benefit of embedding physical constraints. However, this analysis also reveals a critical, shared failure: all baseline models, including Phy-LSTM, consistently underfit rare, high-magnitude peak travel times due to their sparse representation (<1.8%) in the training data. To solve this, we introduce a novel, two-stage adaptive “Generalist-Specialist” framework. This framework leverages the Phy-LSTM as a high-performing “generalist” but, based on a data-driven insight into peak persistence, adaptively invokes a specialized XGBoost “specialist” model when an observed peak in the preceding trip is detected. Rigorous evaluation demonstrates that this adaptive framework not only maintains the high accuracy of PIML for general traffic conditions but is also the first to successfully and accurately capture the travel times that all standalone models miss. This provides a more robust and complete solution for BTTP in challenging urban environments.}
}
@article{GUO2026115427,
title = {Predicting crowd distribution using mobile signaling data: An enhanced spatiotemporal neural network combining environmental dependencies},
journal = {Applied Soft Computing},
volume = {200},
pages = {115427},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115427},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008756},
author = {Yuqi Guo and Yuquan Xu and Jiahui Feng and Yuewen Liu},
keywords = {Crowd distribution prediction, mobile signaling records, Spatiotemporal neural network, Built environment factors},
abstract = {Crowd distribution prediction has broad applications in smart cities, such as preventing crowd crushes during public events and supporting fine-grained urban management. While prior research has focused mainly on crowd flow prediction, crowd distribution encompasses both the dynamic movement of people across regions and their static presence in specific locations—an essential aspect often overlooked. Existing methods struggle to capture this duality effectively. To address this, we propose PAC-ResNet, a novel spatiotemporal neural network tailored for crowd distribution prediction. PAC-ResNet introduces a partial autocorrelation-based (PAC) mechanism that computes grid-wise temporal dependencies and then aggregates them into a globally shared set of key time steps, balancing spatial adaptivity with estimation robustness. Then it employs a self-learning residual unit to model both static and dynamic spatial patterns. It further incorporates built and natural environmental features to capture external dependencies. Experiments on a real-world dataset comprising 2.1 trillion mobile signaling records from Xi’an demonstrate that PAC-ResNet achieves 6.99% lower RMSE and 21.17% lower MAE compared to baselines, while maintaining stable performance across diverse temporal conditions. These results highlight the model’s superior predictive accuracy and intra-city cross-scale robustness in complex urban scenarios.}
}
@article{LIU2026115469,
title = {Heterogeneous multi-attribute group decision-making using Choquet integral and grey relational bidirectional projection for data element assetization value assessment},
journal = {Applied Soft Computing},
volume = {200},
pages = {115469},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115469},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009178},
author = {Pingqing Liu},
keywords = {Heterogeneous multi-attribute group decision-making (HMAGDM), Jensen-Shannon (JS) divergence measure, Choquet integral, Grey relational bidirectional projection (GRBP), Data element assetization value assessment (DEAVA)},
abstract = {The rapid growth of data factor value has posed significant challenges for data asset management and allocation, particularly in multisource heterogeneous environments characterized by inconsistent evaluation criteria and complex attribute interactions. However, existing multi-attribute group decision-making (MAGDM) methods often fail to simultaneously address information heterogeneity and nonlinear attribute interactions, limiting their effectiveness in practical applications. To address these challenges, this study proposes a novel heterogeneous MAGDM (HMAGDM) framework that integrates Jensen–Shannon (JS) divergence, the Choquet integral, and grey relational bidirectional projection (GRBP). The proposed framework enables the unified processing of heterogeneous evaluation information while capturing nonlinear and synergistic relationships among attributes. Specifically, JS divergence is employed to identify key attribute differences in a data-driven manner, enhancing evaluation objectivity, while the Choquet integral models non-additive attribute interactions. A real-world data element assetization value assessment (DEAVA) case, together with comprehensive analyses, demonstrates that the proposed method yields stable, reliable, and interpretable ranking results under varying conditions. The results further indicate strong robustness to uncertainty and incomplete information, while maintaining computational efficiency. Overall, the proposed framework provides a generalizable and effective solution for HMAGDM problems, with potential applications in data asset valuation, supply chain management, and risk assessment.}
}
@article{VALENCIARIVERA2026115364,
title = {Optimizing microgrid controllers for enhanced power quality using metaheuristic approaches},
journal = {Applied Soft Computing},
volume = {200},
pages = {115364},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115364},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008124},
author = {Gerardo Humberto Valencia-Rivera and Juan Gabriel Avina-Cervantes and José Carlos Ortiz-Bayliss and Ivan Amaya},
keywords = {Microgrids, Power quality, Full-state feedback, Proportional-resonant, Proportional-integral, Linear quadratic regulator, Metaheuristics, Exploration–exploitation analysis},
abstract = {Microgrids (MGs) are emerging as a prominent, sustainable, and efficient alternative to conventional power systems. However, the design of their controllers remains challenging, especially when addressing Power Quality (PQ) disturbances. This study proposes using full-state feedback, specifically via a Linear Quadratic Regulator, to enhance the robustness and stability of Proportional-Integral and Proportional-Resonant controllers. The controller parameters are optimized by minimizing key performance indices, including settling time, overshoot, and steady-state error, using three widely adopted metaheuristic algorithms: Particle Swarm Optimization (PSO), Genetic Algorithm (GA), and Grey Wolf Optimizer (GWO). The relative effectiveness of these algorithms is rigorously assessed through convergence behavior and exploration–exploitation analysis to identify the most suitable solver for MG controller tuning. Furthermore, the study demonstrates how individually optimized control actions can be integrated into a unified cooperative strategy, enabling coordinated operation among controllers. Both individual and cooperative control schemes are evaluated across 15 realistic PQ scenarios, which include current imbalance, harmonic distortion, and their combination. Results indicate that GWO achieves superior tuning precision and that the proposed cooperative controllers consistently outperform their standalone counterparts in PQ indices. These findings highlight the relevance of metaheuristic optimization for controller design, demonstrating improved disturbance rejection and practical feasibility for modern MG applications.}
}
@article{YUE2026115380,
title = {A dual-stage differential evolution algorithm based on diversity quality for multimodal multiobjective optimization},
journal = {Applied Soft Computing},
volume = {200},
pages = {115380},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115380},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008288},
author = {Caitong Yue and Wenhao Ye and Weifeng Guo and Mengmeng Li and Hongyu Lin},
keywords = {Multimodal multiobjective problems, Evolutionary algorithms, Dual-stage reproduction, External archive, Diversity preservation},
abstract = {In practical applications, multiple solutions in the decision space may correspond to the same objective value, defining multimodal multiobjective problems (MMOPs). Despite progress in multimodal multiobjective evolutionary algorithms (MMEAs), balancing convergence and diversity in both decision and objective spaces remains a major challenge. Some algorithms achieve good convergence but lead to uneven Pareto front (PF) distributions, while others perform well in the objective space but struggle with incomplete Pareto sets (PSs) in the decision space. Maintaining convergence in the objective space and diversity in the decision space simultaneously proves to be particularly difficult. This paper introduces a novel MMEA, TNLIDE, to address the above challenges. TNLIDE incorporates a dual-stage differential vector generation technique that broadens the decision space search, enabling the identification of more Pareto optimal solutions (PSs). A new environmental selection approach, based on the diversity of each solution, is also proposed. In addition, a dynamic preference deletion operation, along with an external archive, enhances the distribution of solutions in both spaces. Experimental results show that TNLIDE outperforms six other advanced algorithms on both the CEC 2019 benchmark problems and a real-world map-based problem.}
}
@article{WU2026115461,
title = {MetaAN: A meta-learned aligned network for cross-subject emotion recognition based on electroencephalogram signals},
journal = {Applied Soft Computing},
volume = {200},
pages = {115461},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115461},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009099},
author = {Jinke Wu and Jinduo Liu},
keywords = {Emotion recognition, Electroencephalography, Cross-subject, Aligned network, Meta-learning},
abstract = {Emotion recognition using electroencephalography (EEG) has advanced significantly, providing valuable insights into human emotions. However, physiological differences between subjects create substantial distribution gaps in EEG data, posing major challenges for cross-subject emotion recognition. Existing solutions typically rely on domain adaptation (DA), which requires target subject data for calibration, or standard domain generalization (DG), which often struggles to disentangle emotion-relevant patterns from subject-specific noise. In this paper, we propose a novel framework designed to achieve zero-calibration emotion recognition by explicitly learning to generalize across unseen subjects (named MetaAN). MetaAN addresses the root cause of domain shift via an aligned network, which employs an encoder–decoder architecture with attention-based masking to identify and purge subject-idiosyncratic physiological features while preserving emotion-invariant semantics. To ensure robust adaptation to new users without fine-tuning, we integrate this alignment mechanism into an episodic meta-learning paradigm. By simulating domain shifts during training through carefully constructed meta-tasks, the model optimizes its masking policy to handle unseen distributions effectively. Extensive experiments on two public benchmarks demonstrate that MetaAN achieves state-of-the-art accuracy of 94.08% and 86.78%, respectively, verifying its capability to generate robust, subject-agnostic EEG representations for real-world deployment.}
}
@article{LIU2026115457,
title = {SARF-enhanced CNN-transformer stacking ensemble for hot-metal ladle temperature drop prediction},
journal = {Applied Soft Computing},
volume = {200},
pages = {115457},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115457},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009051},
author = {Haoyuan Liu and Zhenchen Sun and Youzhi Zhao and Zhenzhong Shen and Weigang Han},
keywords = {SARF, CNN, Transformer, Stacking ensemble, SHAP},
abstract = {Accurate prediction of hot-metal temperature drop during ladle transportation is important for transfer scheduling, energy management, and stable steelmaking operations. This study proposes a hybrid framework that combines a multi-scale CNN–Transformer encoder with a stacking ensemble for hot-metal temperature-drop prediction. The multi-scale CNN captures local variation patterns, the Transformer models long-range temporal dependencies, and a Scale-Adaptive Residual Fusion (SARF) module is introduced to fuse the two types of representations. Based on the extracted deep features, LightGBM, CatBoost, and Random Forest are integrated through a fixed XGBoost meta-learner. Hyperparameters are configured using a stage-wise Whale Optimization Algorithm (WOA) strategy. Under a chronological 80/20 train-test split, the proposed framework achieves R² = 0.924, RMSE = 7.017 °C, and hit rates of 85.754% and 95.531% within ±10 °C and ±15 °C, respectively. In addition, a 5-fold rolling-origin validation conducted within the training set yields mean R² = 0.8811 ± 0.0089 and mean RMSE = 9.0882 ± 0.2719 °C, indicating stable performance across temporally distinct validation segments. To provide process insight, SHAP feature-attribution analysis is performed as a post-hoc explanation to identify dominant factors and support practical process optimization.}
}
@article{PRADORODRIGUEZ2026115422,
title = {Parallel ACO-VNS for the solution of binary combinatorial optimization problems in computational systems biology},
journal = {Applied Soft Computing},
volume = {200},
pages = {115422},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115422},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008707},
author = {Roberto Prado-Rodríguez and Patricia González and Julio R. Banga and Ramón Doallo},
keywords = {Binary combinatorial optimization, Metaheuristic, Ant colony optimization, Variable neighborhood search, Parallelization},
abstract = {In this work, a parallel hybrid framework that combines Ant Colony Optimization (ACO) with Variable Neighborhood Search (VNS) to enhance both exploration and intensification is proposed. The method integrates a multicolony architecture with a self-adaptive cooperation mechanism that dynamically regulates information exchange among colonies during runtime. This design aims to overcome the limitations of standalone ACO while maintaining scalability on high-performance computing platforms. The proposed approach is evaluated on a set of challenging large-scale binary optimization benchmarks derived from cell signaling network modeling. Experimental results show that the ACO–VNS hybrid consistently outperforms standalone ACO. The results demonstrate the effectiveness and general applicability of the proposed framework for complex binary combinatorial optimization problems.}
}
@article{CHLOPOWIEC2026115414,
title = {Local lesion generation is effective for capsule endoscopy image data augmentation in a limited data setting},
journal = {Applied Soft Computing},
volume = {200},
pages = {115414},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115414},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008628},
author = {Adrian B. Chłopowiec and Adam R. Chłopowiec and Krzysztof Galus and Wojciech Cebula and Martin Tabakov},
keywords = {Data augmentation, Image inpainting, Classification, Deep learning, Capsule endoscopy, Limited dataset, Class imbalance},
abstract = {Limited medical imaging datasets increase the risk of overfitting and training divergence in deep learning models, particularly when generative models are employed for de novo data augmentation in data-constrained environments. Existing generative data augmentation (GDA) methods that synthesize entire images de novo struggle with data copying. To address these challenges, we introduce two novel local lesion generation methods: Poisson Blending Data Augmentation (PBDA) and Image Inpainting Data Augmentation (IIDA). PBDA utilizes a classical gradient-domain image composition technique to seamlessly clone existing pathologies onto diverse backgrounds, while IIDA repurposes a fine-tuned Image Inpainting Generative Adversarial Network (GAN) to synthesize—rather than to remove—realistic lesions conditioned on surrounding healthy tissue. We evaluated these methods on the highly imbalanced Kvasir Capsule Dataset using an official patient-level split to ensure clinical relevance. Our hybrid approach achieves a state-of-the-art macro F1-score of 33.07%, surpassing the previous best result by 7.84 percentage points. Our local generation methods substantially outperformed modern generative models (NVAE, LDM), demonstrating that context-aware, region-specific synthesis advances beyond de novo generation for limited medical imaging datasets.}
}
@article{YANG2026115374,
title = {MTVformer: Multi-scale temporal-variable interaction network for long-term multivariate time series forecasting},
journal = {Applied Soft Computing},
volume = {200},
pages = {115374},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115374},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008227},
author = {Xiaoman Yang and Chang Wu and Yulin Xia and Xinyi Du and Wenchuan Zhang},
keywords = {Long-term time series forecasting, Multi-scale, Embedding technique, Attention mechanism},
abstract = {Time series exhibit multi-scale temporal dynamics and complex cross-variable dependencies when multivariate features are involved. Effectively modeling these intricate patterns remains a pivotal challenge in achieving precise long-term forecasting. Although Transformer and its variants have emerged as prominent tools for addressing this challenge, their performance continues to be hindered by single-scale designs and isolated feature processing techniques. To address these issues, a multi-scale encoder-only model called MTVformer is proposed based on attention mechanisms. MTVformer is designed as a multi-scale framework that captures temporal patterns from fine to coarse resolutions. Adjacent scales are coupled via inter-scale message passing, and a lightweight Multi-Scale Linear Prediction (MSLP) fusion head aggregates multi-scale outputs for prediction. This framework comprises two essential components. First, we devise a Time-Variable Mixing Embedding (TVME) mechanism that segments and encodes sequences at predefined multi-scale temporal resolutions while embedding each time series as variable tokens, thereby enhancing the model’s feature representation. Second, we propose an encoder structure that combines channel attention and patch attention to comprehensively model both cross-variable relationships and multi-scale temporal patterns, overcoming the limitations of single-attention designs. Evaluation results on eight benchmark datasets demonstrate that MTVformer achieves strong and consistent forecasting performance, comparing favorably with recent state-of-the-art methods.}
}
@article{ZENG2026115426,
title = {An auto-parallel training method for deep learning models with extracting model structural features},
journal = {Applied Soft Computing},
volume = {200},
pages = {115426},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115426},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008744},
author = {Yan Zeng and Lei Xu and Xiaofei Lu and Yuyu Yin and Xianggan Li and Jilin Zhang and Honghao Gao},
keywords = {Deep learning models, Automatic model parallelism, Reinforcement learning, Evolutionary strategy},
abstract = {With the proliferation of large-scale deep learning models (e.g., GPT-3, ChatGPT), distributed training across devices has become essential due to single-device resource limitations. Efficiently training such models poses a challenge: the number of model parallel strategies grows exponentially with layers/operators, while existing reinforcement learning (RL)-based auto-parallel methods often assume static execution environments. This leads to two critical limitations: (1) insufficient global optimal strategy exploration, as they tend to converge to local optima by favoring iterative updates of existing policy experience; (2) poor adaptability to dynamic resource fluctuations. To address these issues, this paper proposes ESRL (Evolution Strategies with Reinforcement Learning), an auto-parallel training method for deep learning models with extracting model structural features. ESRL is based on the synergy of Evolution Strategies (ES) and Reinforcement Learning (RL). It uses the graph embedding coding technique to deeply explore the structural features of the model; then, it searches for a model parallel strategy automatically with the global optimization and dynamic environment adaptability of the evolutionary algorithm and self-learning ability of reinforcement learning. Experiments show that this method is significantly better than the Placeto method in search time and execution time of the model parallel strategy. The code for ESRL is available at https://github.com/WhatBrain/ESRL.git.}
}
@article{GAO2026115402,
title = {Robust multispectral detection for low-light coal mine safety monitoring by global-spatial adaptive guidance},
journal = {Applied Soft Computing},
volume = {200},
pages = {115402},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115402},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008501},
author = {Tianyu Gao and Mengnan Shi and Hongtao Li and Qiang Yao and Qiang Miao},
keywords = {Coal mine, Low light, Multispectral fusion, Object detection, Safety management},
abstract = {Safety is of paramount importance in underground coal mine scenarios. However, the complex underground environment and weak lighting conditions severely limit the feasibility of vision-based object detection methods for safety management. This paper proposes an object detection method based on infrared-visible dual-mode fusion. By combining improved adaptive illumination compensation algorithm, backbone-based global information blending guidance, and a spatial-gating cross transformer fusion module, the detection accuracy in low-light and complex environments is significantly improved. The experiments are based on a self-collected infrared-visible multispectral coal mine object detection dataset, which includes workers, shearers, safety helmets, equipment, hydraulic columns, and other targets, verifying the effectiveness of the proposed method. The results show that the proposed method achieves a mAP of 0.80 under low light conditions, an improvement of 11.5% over the single-modal visible light baseline and demonstrates strong interpretability. In addition, the developed video analysis system further verifies the feasibility of the model for real-time underground coal mine monitoring. Overall, this work offers a robust and practical solution for next-generation vision-based coal mine safety management.}
}
@article{SHEN2026115366,
title = {Temporal interaction aggregated dynamic graph convolutional network for traffic flow prediction},
journal = {Applied Soft Computing},
volume = {200},
pages = {115366},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115366},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008148},
author = {Qinqin Shen and Yu Liu and Wenxiao Zheng and Weiping Ding and Quan Shi and Yinxin Bao},
keywords = {Traffic flow prediction, Memory bank, Dynamic graph construction, Spatial indistinguishability, Graph convolutional network},
abstract = {Traffic flow prediction is one of the core topics of Intelligent Transportation System (ITS), and its key challenge lies in accurately mining the dynamic dependencies in both the spatial and temporal dimensions. Existing models based on Temporal Convolutional Networks (TCN) are limited by shared convolution kernels, making it difficult to capture both short-term fluctuations and long-term trends simultaneously. Dynamic graph construction methods usually rely on local time windows, which restricts the model’s ability to utilize long-range historical patterns. To address these challenges, this paper proposes a Temporal Interaction Aggregated Dynamic Graph Convolutional Network (TIADGCN), which integrates three specialized modules to collaboratively capture temporal dynamics and spatial dependencies. First, the temporal interaction convolution and aggregation module enables precise modeling of both short-term fluctuations and long-term trends through differentiated convolution kernels. Second, the memory-enhanced dynamic graph convolution module leverages a historical memory bank to overcome the limitations of local windows and model long-range spatial correlations. Finally, the memory-enhanced gated linear unit adaptively selects and fuses feature information through a gating mechanism, while also querying the memory bank to mitigate confusion in node-level predictions. Extensive experiments on three public datasets, PEMS03, PEMS04, and PEMS08, demonstrate that the TIADGCN model consistently outperforms state-of-the-art models in prediction accuracy.}
}
@article{YU2026115418,
title = {Goal-set-conditioned dynamic multi-objective reinforcement learning algorithm for learning time-varying pareto optimal policies},
journal = {Applied Soft Computing},
volume = {200},
pages = {115418},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115418},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008665},
author = {Haofang Yu and Hongchuan Yang and Yanyan Huang},
keywords = {Multi-objective reinforcement learning, Dynamic environment, Highlight sampling strategy, Dynamic multi-objective reinforcement learning},
abstract = {Many real-world multi-objective sequential decision-making problems naturally involve randomly changing reward functions due to environmental changes, leading to the dynamically changing Pareto Optimal Set (POS) or Pareto Optimal Front (POF). The performance of traditional MORL algorithm will be poor in such scenarios, as the training will be negatively affected by the bias introduced by experience from other environments. One way to deal with this problem is to train a separate network for each environment, which consumes a large amount of storage and computing resources. As an attempt to address the above problems, we consider a specific type of Dynamic Multi-Objective Markov Decision Processes (DMOMDPs), where the time-varying reward function can be identified by a goal set. Then, we propose a goal-set-conditioned dynamic MORL (GSC-DMORL) algorithm to train a single network to learn the POS/POFs of different environments. Specifically, a goal-set-conditioned hindsight sampling strategy is proposed to reuse experience from different environments to effectively and simultaneously update the Q-values conditioned on different goal sets and weights. More importantly, the rewards of the experiences are adjusted according to the goal set to avoid the experience bias. Experimental results show that our algorithm can simultaneously learn the POS/POFs of different environments, and effectively adapt to new environments.}
}
@article{LAKTIONOV2026115394,
title = {An end-to-end ML and XAI-based framework for crop yield prediction under agroclimatic variability},
journal = {Applied Soft Computing},
volume = {200},
pages = {115394},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115394},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008422},
author = {Ivan Laktionov and Sergii Semenov and Grygorii Diachenko and Leszek Rutkowski},
keywords = {Yield, Prediction, Explainable Artificial Intelligence, Machine Learning, Feature Selection, Agriculture},
abstract = {The problem of improving the efficiency of agrotechnical practices for crop cultivation under variable agroclimatic conditions is currently considered highly relevant in terms of applied research. One of the most promising ways of addressing this problem lies in developing and applying software and algorithms to comprehensively and intelligently transform agromonitoring data for crop yield prediction. This takes into account heterogeneous soil and climatic conditions, crop types and agronomic practices throughout the full cultivation cycle in open-field environments. This study involved developing and evaluating the effectiveness of a software and algorithmic framework for the end-to-end transformation of agromonitoring data. The framework incorporates the following stages: preprocessing, intelligent analytics, interpretation and explanation of predictions. Multifactorial data analysis was performed, including grouping by crop and region, assessing the correlation between agronomic and climatic indicators, and creating histograms, scatter plots and time series. The following nine regression algorithms were analysed: Linear Regression, Random Forest, Multilayer Perceptron, Gradient Boosting, Support Vector Machines, XGBoost, Decision Tree, K-Nearest Neighbors, and Bagging Regressor. Several feature selection strategies were investigated, including filter methods, sequential selection, recursive feature elimination, and metaheuristic algorithms. Both global and local explainable artificial intelligence techniques were applied. It has been demonstrated that the proposed framework achieved high effectiveness in solving the crop yield prediction problem. The use of ensemble models with feature selection and explainable artificial intelligence yielded high predictive performance (R2 ranging from 0.95 to 0.99 across the applied data-splitting and cross-validation approaches) and enhanced interpretability. This is of fundamental importance for practical applications in agromonitoring and decision-support systems.}
}
@article{CHEN2026115317,
title = {SBC-Net: A symmetric bidirectional cross-modal network for robust diagnosis of Parkinson’s disease from heterogeneous EEG–EMG data},
journal = {Applied Soft Computing},
volume = {200},
pages = {115317},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115317},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007659},
author = {Xiaoling Chen and Mingyu Li and Peng Wang and Dong Zhang and Ping Xie and Yuanyuan Zhang and Haohao Zhang},
keywords = {Parkinson’s disease, deep learning, cross-modal fusion, attention mechanism, electroencephalogram, electromyography, computational biomarker, interpretability},
abstract = {Accurate and objective diagnosis of Parkinson’s disease (PD) is crucial for guiding clinical treatment in real-world clinical settings. Existing PD diagnostic studies predominantly rely on neuroimaging, electroencephalography (EEG), or electromyography (EMG) signals, but rarely consider the brain–muscle system from a holistic perspective. Moreover, conventional deep learning approaches suffer from low cross-modal fusion efficiency and poor cross-subject generalization, making it difficult to effectively exploit heterogeneous multimodal data for PD diagnosis. To address these limitations, we introduce Resting-state Adaptive Normalization (Rest-AdaptNorm), a resting-state adaptive normalization method that performs individualized calibration to reduce inter-subject and inter-session baseline variability, thereby enhancing model robustness. Building on this, we propose a neurophysiology-inspired Symmetric Bidirectional Cross-modal Network (SBC-Net) for EEG–EMG-based PD recognition. SBC-Net employs a bidirectional cross-attention mechanism to dynamically capture cortico-muscular coupling and directional information flow between EEG and EMG signals, enabling cross-modal fusion that reflects the bidirectional nature of neural circuits. We evaluated the proposed framework on a dataset of 23 participants performing seven motor tasks using a leave-one-subject-out cross-validation scheme. The combined Rest-AdaptNorm and SBC-Net approach achieved an F1-score of 89.69% and an accuracy of 90.21%, outperforming baseline models. Interpretability analyses further revealed disrupted directional cortico-muscular communication patterns in PD patients. Overall, these findings suggest that directional cortico-muscular impairments may serve as potential neurophysiological signatures of PD. The proposed Rest-AdaptNorm-integrated SBC-Net framework improves diagnostic performance, enhances cross-task generalization, and provides new insights into the cortico-muscular circuit-level dysfunction underlying motor deficits in PD.}
}
@article{YANG2026115442,
title = {OALDNet: An orientation-aware lightweight detection network for precision pineapple harvesting},
journal = {Applied Soft Computing},
volume = {200},
pages = {115442},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115442},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008902},
author = {Ziming Yang and Zhe Shan and Xiaying Hao and Cong Lin and Zhong Xue},
keywords = {Agricultural automation, Oriented object detection, Pineapple posture perception, Lightweight network, Edge devices},
abstract = {Mechanized harvesting is fundamental to reducing labor costs and improving efficiency in pineapple production. Accurate orientation estimation is essential for robotic arms to achieve precise grasping, making oriented object detection a key technology for agricultural automation. However, current automated pineapple harvesting systems rely on horizontal vision detection, which hinders accurate localization of grasping and cutting points and increases the risk of fruit damage. Moreover, existing oriented detection algorithms are often computationally intensive and structurally complex, limiting their practical deployment on resource-constrained edge devices. To address these challenges, we propose OALDNet, an orientation-aware lightweight detection network designed for real-time pineapple localization and orientation estimation in natural field conditions. OALDNet integrates a compact backbone optimized for efficient inference on edge devices with a quantized multi-scale feature fusion module that enhances the recognition of occluded and arbitrarily oriented pineapples while reducing computational costs. To fill the gap in training resources, we also develop a large-scale dataset of pineapples annotated with orientation information, covering diverse orchard conditions such as dense foliage, irregular fruit distribution, and variable lighting. Extensive quantitative and qualitative evaluations demonstrate that OALDNet achieves a favorable trade-off between detection accuracy and computational efficiency. Specifically, the proposed model attains AP50=0.941 and AP0.5−0.95=0.745, with an average orientation error of 4.92∘. On the Jetson Orin Nano, OALDNet achieves real-time deployment at 113.32 FPS under TensorRT FP16 with 640×640 input, while maintaining only 0.8M parameters. Field experiments confirm its robustness and practical applicability, establishing a strong foundation for intelligent robotic harvesting systems and other precision agriculture applications.}
}
@article{DOROUDI2026115406,
title = {QT3-FIS: A Quantum Type-3 fuzzy inference system for nonlinear, industrial, and structural applications},
journal = {Applied Soft Computing},
volume = {200},
pages = {115406},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115406},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008549},
author = {Rouzbeh Doroudi and Siyamak Doroudi},
keywords = {Quantum Type-3 Fuzzy Inference System, Higher-Order Fuzzy Systems, Oracle-Based Rule Evaluation, Nonlinear Control Systems, Vibration Control},
abstract = {Classical Type-3 fuzzy inference can become computationally demanding because α-level slicing and multi-stage type-reduction must be repeated to handle deep, multilevel uncertainty. This paper proposes a Quantum Type-3 Fuzzy Inference System (QT3-FIS) that reformulates Type-3 fuzzy modeling within a gate-based quantum-circuit representation. In QT3-FIS, primary/secondary membership grades are mapped to quantum states via parameterized rotation gates and the fuzzy rule base is evaluated using oracle-style circuits that exploit quantum superposition for parallel rule evaluation within a fixed α-level. α-level slicing is performed sequentially (i.e., the circuit is executed and measured per α-cut), and the crisp output is obtained via probability-based aggregation followed by weighted α-level fusion consistent with Type-3 type-reduction. QT3-FIS is evaluated on four benchmark control problems: inverted pendulum stabilization, particle-accelerator beam steering, Cart–Pole balancing, and vibration control of an eleven-story shear building. Under the same simulation settings, QT3-FIS generally attains lower error indices than the compared classical Type-1/Type-2/Type-3 fuzzy controllers and also improves upon the corresponding quantum Type-1/Type-2 implementations. Relative to the classical Type-3 baseline, QT3-FIS reduces the error criteria across the three non-structural benchmarks by 0.15–12.05% (RMSE), 0.10–11.65% (MAE), 0.29–11.65% (IAE), and 0.14–12.28% (ITAE). In the structural benchmark, performance indices J₁, J₃, and J₄ decrease by 0.21–8.29% relative to the Type-3 controller, while J₂ shows a small change (+1.32%). All experiments are conducted on a classical quantum simulator. To the best of our knowledge, this study presents an early gate-level pathway for integrating Type-3 fuzzy inference with circuit-based quantum computation, supporting future implementations on quantum processing units.}
}
@article{HAN2026115224,
title = {A predict-then-optimize framework for multi-stage agricultural production and distribution planning},
journal = {Applied Soft Computing},
volume = {200},
pages = {115224},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115224},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006721},
author = {Jiliang Han and Yuanwei Sun and Na Lin and Xinxin Liu and Junhu Ruan},
keywords = {Production and distribution planning, Mixed cropping, Flexible harvesting, Multi-channel distribution, Predict-then-optimize},
abstract = {The high uncertainty of crop prices poses significant challenges for decision-making in agricultural production. Farmers often rely on empirical knowledge without access to future market conditions, which can lead to considerable decision-making errors and financial losses. This study introduces a predict-then-optimize (PO) framework that leverages data-driven methods to support farmers in making reliable and accurate production and distribution decisions. A support vector machine algorithm is employed to predict crop prices. The prediction results are then integrated into a multi-stage planning model that focuses on multi-crop cultivation, flexible harvesting, and multi-channel distribution. The model optimizes decisions regarding crop types, planting schedules, cultivation areas, harvest timings, quantities, and distribution channels. Unlike conventional scenario-based methods limited by discrete stages and simplified price uncertainty representations, the proposed framework enables continuous decision-making adaptations across the entire agricultural production and distribution lifecycle. By comparing the efficiency of the PO method with traditional experiential methods, this study demonstrates the advantages of data-driven approaches in enhancing farm profitability. The findings reveal that, regardless of farmers’ psychological price expectations, the PO method consistently leads to higher profits.}
}
@article{WANG2026115382,
title = {Adaptive temporal graph neural networks for robust ECG-based authentication in resource-constrained wearable sensors},
journal = {Applied Soft Computing},
volume = {200},
pages = {115382},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115382},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008306},
author = {Yu Wang and Qihuan Yao and Jianhua Sun and Yuanyuan Zhang and Liuliu Feng},
keywords = {ECG biometrics, Wearable sensors, Adaptive authentication, Real-time authentication, IoT security},
abstract = {Electrocardiogram (ECG)-based biometric authentication has emerged as a promising solution for secure access control in wearable sensors and Internet of Things (IoT) devices. However, existing approaches suffer from performance degradation due to physiological variations and high computational requirements that limit their deployment on resource-constrained devices. This paper presents a novel Adaptive Temporal Graph Neural Network (ATGNN) framework that addresses these challenges through three key innovations: (1) an input-adaptive temporal graph representation that models both intra-beat morphology and inter-beat relationships, with topology reconstructed for each authentication window based on the current signal characteristics, enabling robust authentication under varying physiological conditions; (2) a dual-level attention mechanism that adaptively adjusts feature importance based on signal quality and physiological context; and (3) a hierarchical pruning strategy that reduces computational complexity by up to 75% while maintaining authentication accuracy. We evaluate ATGNN on multiple ECG databases, including long-term recordings from 115 subjects over 6 months, demonstrating superior performance compared to state-of-the-art methods. Our approach achieves an average authentication accuracy of 98.7% with an equal error rate (EER) of 1.2%. The framework also exhibits remarkable robustness to common ECG variations, maintaining over 95% accuracy under physical activity and emotional stress conditions. Furthermore, ATGNN supports incremental learning for adaptation to long-term physiological changes without full model retraining. These results establish ATGNN as a practical solution for continuous biometric authentication in next-generation wearable sensors, offering an optimal balance between security, accuracy, and energy efficiency for real-world deployment.}
}
@article{XIE2026115429,
title = {A convolution-augmented swin transformer for robust fire detection with enhanced anti-interference capability},
journal = {Applied Soft Computing},
volume = {200},
pages = {115429},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115429},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600877X},
author = {KaiCheng Xie and Hao He and JiaZhe Zhu and DongMei Huang and QiXing Zhang and ShiXi You},
keywords = {Fire detection, Deep learning, Anti-interference, Attention mechanism, Swin transformer},
abstract = {Image-based fire detection is crucial for public safety; however, existing models often suffer from high false alarm and missed detection rates in complex interference scenarios (e.g., mist, fog) due to limited feature discrimination and robustness. To address these challenges and fully explore the underutilized potential of CNN-Transformer hybrid architectures in this domain, this paper proposes a novel Convolution-Augmented Swin Transformer (CA-Swin) model. The core idea is to integrate the strong local inductive bias of convolutions with the powerful global contextual modeling capability of the Transformer within the Swin Transformer Block. Specifically, CA-Swin introduces an adaptive channel-filtering mechanism during feature downsampling to suppress noise and embeds a channel-attention module within the Swin block to enhance fire-related features selectively. Furthermore, the standard MLP is replaced with an efficient ConvMLP. By optimizing key operations, including eliminating intermediate channel expansion, the proposed design reduces the number of parameters by 39.3% while improving accuracy by 2.46%. To rigorously evaluate the model, we also constructed a large-scale dataset containing diverse, challenging negative-interference samples. Experimental results demonstrate that CA-Swin achieves a favorable balance between performance and computational efficiency. On the DQFF, DeepFire, and Foggia datasets, it consistently outperforms state-of-the-art methods, achieving accuracy rates of 98.0%, 99.0%, and 99.84%, respectively. In cross-dataset generalization tests, CA-Swin reduces the average false-negative rate by 8.73 %age points and improves the average F1 score by 4.23 %age points. Moreover, it achieves real-time inference at 18.3 FPS on CPUs, with a 38.9% reduction in inference memory usage. These results suggest that CA-Swin has promising potential for deployment in practical fire monitoring systems, especially in scenarios with limited computational and memory resources.}
}
@article{ASAMOAH2026115450,
title = {Analyzing user satisfaction in e-learning platforms: A text mining and explainable machine learning approach using unstructured data},
journal = {Applied Soft Computing},
volume = {200},
pages = {115450},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115450},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008987},
author = {Kwame Omono Asamoah and Michael Adjeisah and Peter Darko Adjei and Patrick Kwabena Mensah and Kwame Opuni-Boachie {Obour Agyekum} and Seth {Larweh Kodjiku} and Esther Stacy E.B. Aggrey},
keywords = {E-learning applications, User online reviews, Mobile learning, User satisfaction, Online learning},
abstract = {In the dynamic landscape of digital education, e-learning platforms have become essential tools for revolutionizing the learning experience and improving accessibility. This research focuses on the crucial aspect of user satisfaction within e-learning systems, a vital metric in the competitive educational technology sector. Using Bidirectional Encoder Representations from Transformers (BERT), the study performs topic modeling and sentiment analysis on a dataset comprising user reviews of e-learning platforms. Specifically, the BERTopic model is employed to identify key factors influencing user satisfaction in the e-learning environment. Additionally, a BERT-based multilingual sentiment model is utilized to analyze user sentiments, distinguishing between factors driving satisfaction and those causing dissatisfaction. While topic modeling identifies latent satisfaction dimensions and sentiment analysis captures their evaluative orientation, the extracted factors are subsequently transformed into structured features, with user ratings treated as the target variable in a supervised learning framework to quantify their predictive influence on overall satisfaction. Based on this supervised formulation, seven machine learning (ML) models were evaluated to compare their predictive performance in estimating user satisfaction. Among these, the Decision Tree model demonstrates superior performance, making it the most reliable predictor in this context. Using Shapley Additive exPlanations (SHAP), an explainable Artificial Intelligence (AI) framework, combined with cross-validation, the study visualizes the Decision Tree model’s outputs. SHAP values reveal that the top six factors affecting user satisfaction with e-learning platforms are Teaching Quality and Educational Content (TQEC), Course Variety and Flexibility (CVF), Community and Support (CAS), Personalized Learning and Platform Usability (PLPU), Career Development Opportunities (CDO), and User Ratings and Feedback (URF). To validate and affirm the influence of these identified factors, an Analysis of Variance (ANOVA) test was conducted using the Statsmodels library in Python. The ANOVA results confirmed that all factors significantly impact user satisfaction, with p-values consistently below 0.001, thus providing robust statistical evidence for the importance of these factors. This dual analysis approach—using SHAP for model-specific insights and ANOVA for statistical validation— enhances the reliability and comprehensiveness of the findings. This comprehensive analysis provides actionable insights into user experiences, aiding developers, educational institutions, and other stakeholders in enhancing e-learning platforms. By identifying and predicting the factors that shape user satisfaction, the study contributes to the improvement of e-learning services and supports better educational outcomes.}
}
@article{LIU2026115371,
title = {RAKL: A framework for ethnomedicine relation extraction via integrated retrieval augmentation and knowledge-informed learning},
journal = {Applied Soft Computing},
volume = {200},
pages = {115371},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115371},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008197},
author = {Xiaoyu Liu and Shiqi Li and Hao Zhang and Xueqian Su and Kai Xie and Wen Xue and Weijia Zhang and Yufeng Diao},
keywords = {Ethnomedicine, Relation extraction, Retrieval augmentation, Knowledge-informed constraint, Contrastive learning, Large language model},
abstract = {Ethnomedicine Relation Extraction faces substantial challenges due to the non-local distribution of knowledge, information heterogeneity, and intrinsic logical constraints embedded within heterogeneous literature. To overcome these limitations, we introduce RAKL, a novel framework that integrates Retrieval Augmentation and Knowledge-informed Learning. RAKL incorporates three key innovations: To mitigate knowledge fragmentation, we employ a decoupled “retrieve-then-train” paradigm. By constructing a semantic vector index on a specialized ethnomedical corpus, the model aggregates cross-textual evidence, shifting inference from local context reliance to global evidence synthesis. To resolve information heterogeneity, we design a Gated Heterogeneous Fusion Module. Unlike simple projection, this module employs a non-linear gating mechanism to dynamically control the interaction between textual semantics and Knowledge Graph embeddings, ensuring adaptive feature integration. Crucially, to enforce logical consistency, we propose a knowledge-constrained contrastive learning mechanism. Utilizing a Large Language Model, we automate the discovery of domain rules (e.g., symmetry and mutual exclusivity) and inject them as soft constraints during optimization. Experiments on a proprietary ethnomedicine dataset demonstrate that RAKL outperforms state-of-the-art baselines, validating the effectiveness and robustness of our proposed framework in handling complex ethnomedical literature.}
}
@article{KESHAVARZI2026115399,
title = {DMGNet: Dynamic Multi-Graph Neural Network for road traffic prediction using multi-modal fusion and contrastive learning},
journal = {Applied Soft Computing},
volume = {200},
pages = {115399},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115399},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008471},
author = {Samaneh Keshavarzi and Peyman Adibi and Fakhroddin Noorbehbahani},
keywords = {Traffic prediction, Dynamic Graph Neural Networks, Multi-modal fusion, Pearson and Spearman correlations},
abstract = {Accurate traffic prediction remains challenging because traffic data are heterogeneous, multi-modal, and governed by evolving spatial dependencies. Existing graph-based models often rely on static relations or simple feature fusion, which limits their ability to capture modality-specific interactions and direction-sensitive traffic influence. We propose DMGNet, a Dynamic Multi-Graph Neural Network that constructs and fuses diverse traffic modalities via dynamic graphs. DMGNet converts underutilized qualitative modalities into Spearman correlation matrices and refines quantitative ones using Pearson correlations, while Haversine distance matrices serve as an additional modality. Each modality is represented as a directed graph through a learnable weight matrix updated multiple times per forward pass, transforming symmetric correlations into asymmetric, direction-aware dependencies. Adaptive weighting fuses learned relations, emphasizing critical edges and suppressing weak ones. Node embeddings are iteratively refined to dynamically integrate neighbor information. DMGNet optimizes multi-modal integration by adjusting each modality’s contribution and learning spatial-temporal features through temporal convolution, Chebyshev spectral graph convolution, and a gating mechanism. A contrastive learning–based late fusion strategy unifies multi-modal features. Experiments on PeMS03, PeMS04, and PeMS08 demonstrate consistent improvements over state-of-the-art methods, achieving MAE, MAPE, and RMSE gains of 11.31%, 11.98%, and 3.22% on PeMS03; 11.85%, 7.99%, and 7.74% on PeMS04; and 14.60%, 12.14%, and 11.30% on PeMS08.}
}
@article{LV2026115387,
title = {Constrained multi-objective wolf pack algorithm based on diversity guidance and feasibility enhancement},
journal = {Applied Soft Computing},
volume = {200},
pages = {115387},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115387},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008355},
author = {Li Lv and Lijuan Wu and Renbin Xiao and Zhihua Cui and Jeng-Shyang Pan and Hui Wang and Ivan Lee},
keywords = {Multi-objective wolf pack algorithm, Constrained optimization problem, Uniform mutation, Genetic operators, Constraint dominance rule},
abstract = {In complex engineering and computing systems, resource scheduling and optimization often need to handle multiple conflicting objectives while being constrained by factors such as latency and energy consumption, which makes the problem highly challenging to solve. The multi-objective wolf pack algorithm demonstrates strong search capability in addressing such problems, however, it still suffers from drawbacks, including limited diversity within the population and a lack of equilibrium between constraint-satisfying and constraint-violating solutions. To address this, a constrained multi-objective wolf pack algorithm based on diversity guidance and feasibility enhancement (CMOWPA-DGFE) is proposed. The optimization process is separated into two main stages. The first focuses on diversity guidance, while the second emphasizes feasibility enhancement. During the diversity guidance phase, a uniform mutation mechanism is employed to increase the variety of individuals within the population. During the feasibility enhancement phase, genetic operators are employed to achieve refined search. In terms of constraint handling, the former combines the penalty function with non-dominated sorting to guide infeasible solutions to gradually approach the feasible solution space, while the latter applies the constraint dominance rule to further improve the quality of feasible solutions. Comparative experiments on MW and DTLZ benchmark test functions as well as on constrained multi-objective computing network optimization models show that CMOWPA-DGFE significantly enhances the acquisition capability of feasible solutions while maintaining solution diversity.}
}
@article{LIAN2026115363,
title = {Competitive cluster elimination (CCE) for large-scale swarm optimization},
journal = {Applied Soft Computing},
volume = {200},
pages = {115363},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115363},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008112},
author = {Junbo Jacob Lian and Kaichen Ouyang and Yujun Zhang and Rui Zhong and Haoran Chen and Zikun Zheng and Yujun Sun and Huiling Chen},
keywords = {Swarm optimization, Large-scale optimization, Competitive cluster elimination (CCE), K-means clustering, Particle swarm optimization (PSO), Differential evolution (DE)},
abstract = {In large-scale black-box optimization, swarms often stall in low-yield basins under strict evaluation budgets. We therefore propose Competitive Cluster Elimination (CCE), a k-means–guided, evaluation-neutral plug-in for large-scale swarm optimization that augments Particle Swarm Optimization (PSO), Differential Evolution (DE), and related methods, without modifying native update rules or increasing objective evaluations. We introduce three innovations: (i) an evaluation-neutral plug-in that requires no additional objective calls, (ii) a targeted diversity mechanism that resets only the worst-scoring cluster while explicitly safeguarding the elite cluster containing the global best, and (iii) a calibrate-once-transfer protocol that tunes parameters on PSO and applies them unchanged to DE, SHADE, and JADE. At scheduled intervals, CCE partitions the population via k-means, scores clusters by fitness, partially resets only the worst-scoring cluster, and explicitly safeguards the elite cluster containing the global best. On the CEC-2017 suite at D=100, CCEPSO improves median fitness on 24 of 29 functions with gains up to 68%; transferring the same parameters unchanged to JADE yields a 69% win rate (20/29). On seven 0/1 knapsack instances, CCE variants consistently improve mean profit and reduce variance; on six TSPLIB instances, CCEDE, CCESHADE, and CCEJADE each achieve 6/6 wins over their baselines. All improvements are obtained with negligible wall-clock overhead and without additional objective evaluations. Code and data are available at https://github.com/junbolian/Competitive-Cluster-Elimination.}
}
@article{GAO2026115460,
title = {Dual-channel dynamic event-triggered fuzzy control for uncertain nonlinear systems with unknown measurement sensitivity},
journal = {Applied Soft Computing},
volume = {200},
pages = {115460},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115460},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626009087},
author = {Miaomiao Gao and Haiyu Wang and Yongchao Liu},
keywords = {Measurement sensitivity, State observer, Dynamic event-triggered, Nonlinear systems},
abstract = {We propose the design of dynamic event-triggered controller (DETC) for uncertain nonlinear systems (UNS) with unknown measurement sensitivity. To address measurement errors derived from limited sensor measurement technology, a fuzzy state observer is constructed such that the output feedback control strategy can be implemented by applying estimated states. Moreover, the dynamic event-triggered mechanism (DETM) is installed within the sensor-controller channel and controller-actuator channel, thereby forming dual-channel event-triggered framework. Different from conventional event-triggered controllers with static ETM, the formulated DETC can dynamically update threshold parameter of triggering mechanism, which has superiorities in economizing communication resources and alleviating detrimental influence caused by measurement errors. The ultimate boundedness of the considered UNS is guaranteed by employing Lyapunov synthesis. Finally, the efficacy of theoretical finding is exhibited through a manipulator system simulation.}
}
@article{ZHANG2026115407,
title = {ResGRU-SC: Hybrid residual gated recurrent units and spectral clustering model for high-accuracy photovoltaic power forecasting},
journal = {Applied Soft Computing},
volume = {200},
pages = {115407},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115407},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008550},
author = {Cheng Zhang and Jinglin Huang and Yongsheng Gui and Enqing Chen and Maomao Zhang and Fangxin Lu and Zhangqian Bi},
keywords = {Photovoltaic power plant, Generation forecasting, Gated Recurrent Unit, Residual learning, Spectral clustering},
abstract = {The inherent stochastic fluctuations in the temporal distribution of solar radiation complicate its practical deployment in modern power systems. Accurate forecasting of solar power output emerges as a critical prerequisite for efficient energy management and stable grid integration. With recent advancements in deep learning, numerous efforts have been made to apply these techniques to solar energy prediction, demonstrating promising results. However, current methodologies exhibit inconsistent performance across varying weather conditions, particularly when handling stochastic meteorological patterns such as rainy or cloudy episodes. This limitation stems from the requirement for sophisticated analysis of historical numerical weather parameters, particularly their temporal variations and dynamic interactions. To solve this problem, this paper proposes a novel hybrid forecasting model that effectively integrates gated recurrent units (GRU) with residual learning mechanisms and spectral clustering (SC) techniques. Specifically, our contributions are threefold: (1) We develop a ResGRU architecture where the GRU captures temporal dependencies and meteorological correlations, while the residual connections learn variations from historical data. (2) We introduce an SC-based classification strategy that categorises meteorological conditions to improve the model’s accuracy under fluctuating weather conditions. (3) We conduct extensive experimental validation using half-hourly data from a rooftop PV system. The results demonstrate that our proposed model markedly outperforms benchmark models, reducing the mean absolute error (MAE) by 21.3% and the root mean square error (RMSE) by 22.2% compared to the standard long short-term memory (LSTM) model. It consistently maintains a mean absolute percentage error (MAPE) below 8.53% under clear skies and achieves an R² value above 0.97 across all weather types, confirming its superior generalization capability and practical application value.}
}