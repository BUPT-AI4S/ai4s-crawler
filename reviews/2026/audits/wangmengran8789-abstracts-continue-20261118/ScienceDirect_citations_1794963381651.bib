@article{RADOJCIC2026114179,
title = {A two-layer TinyML approach aided by metaheuristics optimization for leveraging agriculture 4.0 and plant disease classification},
journal = {Applied Soft Computing},
volume = {186},
pages = {114179},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114179},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014929},
author = {Vesna Radojcic and Nebojsa Bacanin and Luka Jovanovic and Milos Dobrojevic and Vladimir Simic and Dragan Pamucar and Miodrag Zivkovic and Jelena Kaljevic},
keywords = {Precision agriculture, Plant disease detection, Optimization metaheuristics, Agriculture 4.0},
abstract = {The global rise in food demand results from a complex interplay of factors, including population growth and evolving dietary preferences, which impact agricultural practices and supply chains. While technological advancements such as precision farming improve productivity, they also raise sustainability concerns. Agriculture faces significant challenges from external factors like weather disruptions, pests, and diseases, leading to considerable economic losses. Addressing these challenges requires precise plant diagnostics, achievable through artificial intelligence (AI) within the framework of precision agriculture. The presented study proposes a modified optimizer modeled after the particle swarm optimization (PSO) algorithm, tailored to optimize classification models for plant disease detection in Agriculture 4.0 using TinyML Internet of Things devices. The introduced two-layer approach leverages convolutional neural networks (CNNs) for extracting the features and boosting models (AdaBoost and CatBoost) for disease detection and identification from leaf images. Simulations on publicly available datasets demonstrate promising results. Additionally, an advanced interpretation method using Shapley additive explanations (SHAP) is proposed to interpret hybrid CNN-booster models, providing insights into the leaf features that influence classification decisions. Key contributions include enhanced accuracy and efficiency through the modified optimizer, a robust AI-based system for precise plant disease detection, a two-layer hybrid model framework, and an approach to feature impact interpretation in advanced hybrid models.}
}
@article{SURESHKUMAR2026114205,
title = {IoT-based heart disease prediction in healthcare monitoring system using optimal feature integration and deep dilated network},
journal = {Applied Soft Computing},
volume = {186},
pages = {114205},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114205},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015182},
author = {M. SureshKumar and P. Vasanthan and Adiline {Macriga G}},
keywords = {Heart disease prediction, Internet of Things, Healthcare monitoring system, Modified Gazelle Optimization Algorithm, Hybrid Dilated Residual Long Short Term Memory with Deep Capsule Network},
abstract = {The effective heart disorder prediction is significant for accurately curing the cardiac victim before a heart attack happens. But, these models cannot manage the high-dimensional data sources because of poor smart models. In this presented work, an intelligent IoT-based heart disorder estimation framework is provided to rectify the above complexities. In the beginning, the required data is garnered using the IoT devices, and this data is downloaded for the next process. From the downloaded data, the signal is considered to get the set of features like spectral and wave features. Further, the spectral features from the signal are extracted as the initial feature set and the wave features obtained from the signal are extracted as the second set of features. Moreover, the other data downloaded from the IoT is treated as a third feature set. These three sets of features are concatenated together and preceded by the optimal weighted features selection stage. Here, the required weight for the feature selection process is optimized by the Modified Gazelle Optimization Algorithm (MGOA). Further, the weighted feature is transferred to the Hybrid Dilated Residual Long Short Term Memory (LSTM) with Deep Capsule Network (HDRLDCN) for the heart disease prediction process. Finally, the experimental verification is employed to confirm the efficacy of the developed approach concerning numerous indices. Overall performance of the developed model is achieved as 94.1 % and 94.0 % for accuracy and sensitivity, in contrast with existing models. Thus, the result analysis shows better performance by comparing over with existing conventional techniques.}
}
@article{LU2026114294,
title = {Distributed multi-objective fast convergent heuristic algorithm for novel power systems dispatch},
journal = {Applied Soft Computing},
volume = {186},
pages = {114294},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114294},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016072},
author = {Quan Lu and Haozheng Zeng and Linfei Yin},
keywords = {Dynamic Levy flight adjusting parameter strategy, distributed multi-objective mantis search algorithm, distributed novel power systems},
abstract = {To simulate large-scale renewable energy grid integration and to solve the poor optimization of heuristic algorithms caused by improper parameter setting, this study proposes a distributed novel power systems (DNPSs) model and a distributed multi-objective mantis search algorithm based on dynamic Levy flight adjusting parameters strategy (DFLDMOMSA). The DNPSs orchestrate the cooperative operation of 6 renewable energy sources. The DLFDMOMSA introduces dynamic Levy Flght adjusting parameter strategy based on distributed multi-objective mantis search algorithm to avoid premature convergence by allowing heuristic algorithms with no fixed values for the initial parameter. Simulation results demonstrate that DLFDMOMSA is compared to seven comparison algorithms: (1) in 118-bus novel PS, carbon dioxide emissions are decreased by 3.92 %, 2.43 %, 0.042 %, 3.82 %, 1.94 %, 1.77 %, and 18.89 %, respectively, and generator costs are decreased by 0.74 %, 0.43 %, 0.038 %, 0.21 %, 1.85 %, 0.92 %, and 0.32 %, respectively; (2) in 1375-bus novel PS, carbon dioxide emissions are decreased by 5.76 %, 6.43 %, 9.32 %, 4.64 %, 3.96 %, 4.49 %, and 16.24 %, respectively, and generator costs are decreased by 3.11 %, 3.88 %, 4.07 %, 1.92 %, 4.12 %, 3.24 %, and 7.51 %, respectively; (3) the proposed algorithm can find smaller Pareto curves.}
}
@article{DAI2026114193,
title = {Byzantine-resistant model verification for decentralized federated learning in intelligent transportation systems},
journal = {Applied Soft Computing},
volume = {186},
pages = {114193},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114193},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015066},
author = {Jiao Dai and He Huang and Yufei Wang and Li Duan and Fuqiang Hu and Dantong Yan and Zhichen Liu and Wei Wang},
keywords = {Blockchain, Federated learning, Zero-knowledge proof, Reputation mechanism, Model integrity, Adversarial training defense},
abstract = {Blockchain-enabled Federated Learning (FL) has been widely adopted in intelligent transportation systems to facilitate collaborative model training while preserving data privacy. Key devices, such as traffic signals and obstacle detection cameras, generate large volumes of image data, but privacy constraints hinder direct data sharing. FL inherently addresses the issue of sensitive data sharing by enabling collaborative training without the need to share raw data. Blockchain’s decentralization and immutability provide auditability and secure data usage in FL settings. However, current blockchain-FL frameworks face three major challenges: (1) Malicious participants may upload poisoned models, deliberately disrupting the training of the global model; (2) Lazy participants may submit outdated or reused parameters, leading to degraded overall performance; (3) Existing reputation mechanisms fail to distinguish malicious intent from low-quality contributions, resulting in unfair rewards and poor model robustness. To enhance trust and accountability, blockchain is further integrated to provide verifiability and safeguard against malicious or lazy behavior. To address these issues, this work proposes a robust model verification method that integrates zero-knowledge proofs with a reputation mechanism. A dual-metric scheme combining accuracy and cosine similarity is used to detect malicious updates. Zero-knowledge proofs and hash storage allow verification of training without revealing private data, effectively identifying lazy participants. This method ensures that only legitimate model updates, derived from actual local training, are accepted. Based on verification outcomes, a blockchain-based reputation scheme penalizes dishonest behavior. Experiments on MNIST, Fashion-MNIST, and CIFAR-10 demonstrate that the proposed approach maintains model performance under attack and outperforms existing defenses.}
}
@article{BASIRI2026114213,
title = {RACE-RANK: A hybrid rule-based classifier using PageRank algorithm},
journal = {Applied Soft Computing},
volume = {186},
pages = {114213},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114213},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015261},
author = {Alireza Basiri and Nasrin Pournajar},
keywords = {Data mining, Data classification, Rule-based classifier, RuleAggregation ClassifiER (RACER), PageRank},
abstract = {Data mining has become a crucial tool in domains such as healthcare, finance, and cybersecurity, where extracting meaningful patterns from datasets supports critical decision-making. While various methods exist to represent knowledge across different applications, decision trees and rule-based classifiers are often favored for their effectiveness and human comprehensibility. One notable example is the Rule Aggregation ClassifiER (RACER), which is recognized for its exceptional performance. However, RACER faces challenges in rule ordering, potentially affecting classification accuracy. In this paper, we present RACE-RANK, an enhanced approach to effectively organize initial rules by leveraging a graph-based PageRank algorithm. Additionally, RACER tackles the issue of excessive rule merging, which can affect classification accuracy. To address this issue, our proposed method also applies a controlled stopping strategy that halts the merging of rules after the first iteration, contributing to improved overall classification performance. We evaluate RACE-RANK on 29 benchmark datasets from UCI and OpenML, comparing its performance against RACER and 14 other machine learning classifiers. We also compare alternative rule ranking strategies based on Betweenness Centrality and Eigenvector Centrality. Experimental results show that RACE-RANK achieves an average accuracy improvement of 1.84% and an average F1 score of 0.829, demonstrating its effectiveness in enhancing rule-based classification.}
}
@article{BANSAL2026114208,
title = {Application of physics informed neural networks to partial integro-differential equations in financial modeling and decision making},
journal = {Applied Soft Computing},
volume = {186},
pages = {114208},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114208},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015212},
author = {Saurabh Bansal and Pradanya Boro and Natesan Srinivasan},
keywords = {Option pricing, Physics-informed neural network, Numerical solution, Jump-diffusion model, Greeks},
abstract = {In this article, we propose a physics-informed neural network (PINN) for solving the single-asset Black-Scholes jump-diffusion models, specifically the Merton and Kou models. PINNs are a scientific machine learning method designed to tackle partial differential equation (PDE) related problems. The partial integro-differential equation is converted into a PDE using integral discretization in order to apply the PINN technique. The training data points are randomly selected from the domain, and the transformed PDE, as well as the initial and boundary conditions, are utilized to construct the loss function. We utilize the hyperbolic tangent function (tanh) as the activation function for the neurons in the hidden layer. The network’s connection weights are optimized using the L-BFGS algorithm. The proposed PINN technique effectively computes the option price and calculates several of its essential Greeks, including Gamma, Theta, and Delta, with no additional overhead. Lastly, we will conduct numerical tests to show the effectiveness of the proposed approach. We will compare it with the conventional numerical method and demonstrate that our technique serves as an effective alternative to competing pricing methods for the Black-Scholes jump-diffusion model.}
}
@article{DING2026114232,
title = {Compensation-based state and fault estimation for IT2 polynomial fuzzy systems under both actuator and sensor faults},
journal = {Applied Soft Computing},
volume = {186},
pages = {114232},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114232},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015455},
author = {Jingyu Ding and Zhihong Zhao and Jinyong Yu and Jun Cheng and Michael Basin},
keywords = {Fault estimation observer, Interval type-2 fuzzy system, Membership-function-dependent method, Polynomial fuzzy system, Sum-of-squares (SOS), Unmeasurable premise variables},
abstract = {This paper presents a novel fault estimation method for interval type-2 (IT2) polynomial fuzzy systems (PFS) suffering from both sensor faults (SFs) and actuator faults (AFs) with unmeasurable premise variables (PVs). A compensation vector is proposed to compensate for the effects of the unmeasurable PVs, eliminating the restrictions of existing methods which require system stability or assume unmeasurable PVs to satisfy strict linear growth conditions. The designed observer eliminates singularity in AF estimation, while allowing unmatched membership functions (MFs) and different fuzzy rule numbers compared with the original system, thereby significantly enhancing the method’s applicability and design flexibility. Furthermore, to reduce conservativeness, membership-function-dependent (MFD) conditions are introduced using information on the MFs, and an extended dissipative index is explored to establish a unified framework to address H∞, passive, dissipative, and indices. In addition, a one-step solution approach is proposed to simplify the computational process for finding coupling parameters. Finally, comparative analyses with existing methods are presented, followed by simulations including a numerical example and a case study of a single-link rigid robot arm, to demonstrate effectiveness and advantages of the proposed method.}
}
@article{LI2026114200,
title = {Twin trigger generative networks for backdoor attacks against real-time object detection},
journal = {Applied Soft Computing},
volume = {186},
pages = {114200},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114200},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015133},
author = {Zhiying Li and Zhi Liu and Guanggang Geng and Shreyank N Gowda and Shuyuan Lin and Jian Weng and Xiao-Bo Jin},
keywords = {Backdoor attack, Real-time object detection, Visible trigger, Invisible trigger},
abstract = {Real-time object detectors, which are widely used in real-world applications, are vulnerable to backdoor attacks. This vulnerability arises because many users rely on datasets or pre-trained models provided by third parties due to constraints on data and resources. However, most research on backdoor attacks has focused on image classification, with limited investigation into real-time object detection. Furthermore, the triggers for most existing backdoor attacks on real-time object detection are manually generated, requiring prior knowledge and consistent patterns between the training and inference stages. This approach makes the attacks either easy to detect or difficult to adapt to various scenarios. To address these limitations, we propose novel twin trigger generative networks in the frequency domain to generate invisible triggers for implanting stealthy backdoors into models during training, and visible triggers for steady activation during inference, making the attack process difficult to trace. Specifically, for the invisible trigger generative network, we deploy a Gaussian smoothing layer and a high-frequency artifact classifier to enhance the stealthiness of backdoor implantation in object detectors. For the visible trigger generative network, we design a novel alignment loss to optimize the visible triggers so that they differ from the original patterns but still align with the malicious activation behavior of the invisible triggers. Extensive experimental results and analyses prove the possibility of using different triggers in the training stage and the inference stage, and demonstrate the attack effectiveness of our proposed visible trigger and invisible trigger generative networks, significantly reducing the mAP0.5 of the object detectors by 70.0 % and 84.5 %, including two real-time object detectors with different settings, respectively.}
}
@article{SONG2026114252,
title = {A dual-branch noise-resistant sparse convolution method for multi-modal 3D object detection in autonomous driving},
journal = {Applied Soft Computing},
volume = {186},
pages = {114252},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114252},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015650},
author = {Xiaogang Song and Yifan Yang and Zhenhua Zhou and Jichen Chen and Qin Zhao and Xinhong Hei},
keywords = {3D object detection, Deep learning, Sparse convolution, Multimodal, Attention mechanism},
abstract = {Multimodal three-dimensional object detection plays a crucial role in autonomous driving by integrating data from multiple sensors to improve detection accuracy. However, when fusing data from different sources, challenges such as image noise and information loss often arise, leading to an inability to fully exploit the correlation between multimodal data, thereby affecting the optimization of detection performance. To address such issues, this paper proposes a multimodal three-dimensional object detection method based on dual-branch strong feature representation and noise-resistant sparse convolution. This method constructs a dual-branch backbone network for collaborative processing of multimodal data. The 3D sparse convolution backbone with strong feature representation and noise-resistant sparse convolution based on scene importance prediction are employed to respectively learn the feature representation of point cloud and pseudo-point cloud data. Additionally, a spatial channel dual-unit cross-fusion module is designed to extract low-level spatial features and high-level abstract semantic features separately through dual channels, avoiding spatial information loss while obtaining more advanced abstract semantic information. Furthermore, this paper designs dynamic self-attention fusion feature refinement blocks to refine features multiple times and merge refined RoI results from different refinement stages, thereby improving detection accuracy. The effectiveness of the proposed components is validated through quantitative evaluation, ablation experiments, and qualitative comparisons on the popular KITTI dataset.}
}
@article{KUMAR2026114243,
title = {DEJRNN: A novel fusion recurrent neural network-based complex dynamical system modeling and the convergence analysis},
journal = {Applied Soft Computing},
volume = {186},
pages = {114243},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114243},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501556X},
author = {Rajesh Kumar},
keywords = {Elman recurrent neural network, Diagonal recurrent neural network, Jordan recurrent neural network, Adaptive learning rate, Lyapunov-stability analysis},
abstract = {Modeling nonlinear dynamical systems is challenging due to their highly complex, time-varying, and nonlinear behaviors, which conventional modeling approaches often fail to represent accurately. Artificial Neural Networks (ANNs) offer a data-driven alternative, yet selecting suitable architectures, capturing temporal dependencies, and ensuring convergence stability remain key challenges. This study introduces a novel Diagonal Elman Jordan Recurrent Neural Network (DEJRNN) that synergistically integrates Elman-type hidden feedback, Jordan-type output feedback, and diagonal recurrences within a unified recurrent framework. The model is trained using gradient-descent-based back-propagation, and a Lyapunov-theory-derived adaptive learning rate ensures convergence, stability, and robustness. Performance evaluation across four complex nonlinear dynamical systems reveals that, during training, DEJRNN achieves up to 72% and 47% reductions in average mean-squared and mean-absolute errors, respectively, compared to standard RNNs (ERNN, JRNN, DRNN). In testing, these reductions reach 41% and 29%, confirming excellent generalization capability under unseen, noisy, and time-varying inputs. The Lyapunov-based adaptive learning mechanism not only guarantees stable convergence but also alleviates gradient vanishing and enhances dynamic tracking accuracy. Overall, the DEJRNN framework provides a compact, interpretable, and computationally efficient solution for nonlinear system modeling, combining the structural simplicity of traditional RNNs with analytical convergence assurance. The proposed model establishes a strong foundation for developing future stability-driven neural architectures for real-time modeling and control applications.}
}
@article{LI2026114248,
title = {A spatially enhanced multiscale polarity sensing framework for UAV small target detection},
journal = {Applied Soft Computing},
volume = {186},
pages = {114248},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114248},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015613},
author = {Hanrui Li and Hui Liu},
keywords = {UAV aerial imagery, Edge information enhancement, Small target detection, Multi-scale adaptive loss, DETR},
abstract = {Identifying small objects within aerial photographs remains a persistent obstacle for computer vision researchers due to factors like multi-scale nature of the targets, limited capabilities for feature representation, interference from intricate backgrounds, and class imbalance. Despite substantial progress in object detection methods, current algorithms perform poorly in aerial environments, with even the best models achieve an Average Precision (AP) of less than 40 % on datasets like VisDrone. To tackle these challenges, we proposed a novel framework for small target detection, termed SE-MSPA-DETR, which incorporates four key advancements. Firstly, the architecture incorporates a backbone framework (MS-DDEA) that employs a Cross Stage Partial Network (CSP) edge detection module. This component works by amplifying edge information through multi-scale sampling techniques combined with a selection mechanism operating across dual domains. Secondly, a small target feature fusion enhancement architecture (STFFE) is devised to effectively mitigate background interference while preserving high-resolution features. Thirdly, an extreme-aware transformer encoding layer (PA-TEL) is introduced to amplify weak target signals by distinguishing between positive and negative feature components. Finally, a multi-scale adaptive loss function (MALoss) is used to dynamically adjust sample weights to address class imbalance. Comprehensive experiments conducted on two prominent drone aerial datasets, VisDrone and UAVDT, reveal that the SE-MSPA-DETR framework significantly outperforms existing methods, achieving 49.4 % AP50 and 30 % AP50–95 on the VisDrone. These results indicate improvements of 5.1 % and 3.6 % over the baseline model, respectively, and 3.1 % enhancement in small target detection, confirming the effectiveness and practicality of the proposed method in real-world drone scenes.}
}
@article{CRESPICASTANER2026114175,
title = {Pruning dense neural networks for efficient edge deployment in internet of things applications},
journal = {Applied Soft Computing},
volume = {186},
pages = {114175},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114175},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014887},
author = {Lluc Crespí-Castañer and Joan Font-Rosselló and Murti Bär and Alejandro Morán and Christian F. Frasser and Vincent Canals and Miquel Roca and Josep L. Rosselló},
keywords = {Optimization of artificial neural networks, Low power devices and circuits, Sensors and devices for the internet of things},
abstract = {This study presents an innovative approach to optimizing Multi-Layer Perceptrons (MLPs) for resource-constrained edge computing applications, particularly Internet of Things (IoT) devices. The proposed strategy leverages auxiliary dense Morphological Neural Networks (MNNs) to generate pruning masks for the dense hidden layers of the neural network. MNNs have proven to be highly effective in eliminating redundant weights and connections, resulting in minimal accuracy loss. The efficacy of this pruning method was tested and validated using two benchmark datasets: handwritten MNIST and fashion MNIST. Subsequently, the performance of the pruned neural networks was assessed on an IoT hardware platform. Experimental results demonstrated that pruned models outperformed other contemporary pruning techniques in terms of power efficiency and processing speed, without compromising accuracy or weight reduction. Additionally, a custom software tool was developed to enhance the inference capabilities of these pruned networks on IoT edge devices. These findings have significant implications for the development of efficient and scalable deep learning models tailored to the demands of edge computing applications.}
}
@article{ZHANG2026114256,
title = {FastTWE: Making TWE-based time-series similarity search faster via random convolutional kernels},
journal = {Applied Soft Computing},
volume = {186},
pages = {114256},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114256},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015698},
author = {Haowen Zhang and Xiaoyu He and Jing Li and Juan Li and Qing Yao},
keywords = {Time Warping Edit, Time-series, Random convolutional kernels, Approximate method},
abstract = {Time-series similarity search is a core task in time-series data mining, essential to a wide range of downstream applications. The effectiveness of time-series similarity search depends on the choice of distance measure. Among various alternatives, the Time Warping Edit (TWE) distance has recently gained significant attention for its strong performance across diverse tasks. However, its high computational cost and the lack of specialized acceleration techniques hinder its scalability. To address this, we propose FastTWE, an efficient method for accelerating TWE-based similarity search. FastTWE adopts an Approximate-then-Exact framework: in the approximate phase, time-series are transformed into low-dimensional vectors via random convolutional kernels and PCA, enabling efficient candidate filtering; in the exact phase, TWE distances are computed only for the candidate set. A TWE-specific lower bound is further employed to reduce redundant distance computations. We compare the performance of FastTWE with relevant competitors across 58 datasets, evaluating various aspects including preprocessing time, retrieval accuracy, and online search time. The experimental results demonstrate both the effectiveness and superiority of FastTWE. Code is available on GitHub: https://github.com/pcjdhhhh/FastTWE.}
}
@article{LIU2026114183,
title = {A lightweight weed detection algorithm designed based on YOLOv9},
journal = {Applied Soft Computing},
volume = {186},
pages = {114183},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114183},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014966},
author = {Lizhao Liu and Minghao Zhang and Xiaodan Zhou and Runxuan Zhai and Dahan Wang and Shunzhi Zhu},
keywords = {Weeds and crops, Lightweight model, YOLOv9},
abstract = {Accurate weed detection is a critical step in crop management and weed control. With the advancement of deep learning, object detection models have continuously evolved, achieving higher accuracy but often at the cost of increased parameter count and computational resource consumption, which hinders their deployment in real-world applications. To address this challenge, we propose an improved lightweight weed detection model. Firstly, anchor boxes optimized using the K-Means algorithm are applied to enhance the accuracy and performance of object localization and classification tasks. Secondly, we design and integrate the Spatial Pyramid Pooling Enhanced Local Aggregation with Efficient Channel Attention module(SPPELAN-ECA), which strengthens the model’s feature extraction capability without increasing its parameter count. Lastly, we propose and introduce the Average Group Shuffle Convolution module(AGSConv), which reduces the model’s parameters and computational resources while improving its expressiveness and generalization ability. We comprehensively evaluated the performance of the proposed algorithm and compared it with state-of-the-art (SOTA) models. The results show a significant improvement in detection accuracy, with a mean average precision (mAP) of 81.7 %. Furthermore, the proposed algorithm outperforms the baseline YOLOv9s model, achieving a reduction of 1.2 GFLOPS, a decrease of approximately 0.53 M parameters, and a reduction of 0.9 MB in model size. The study demonstrates that the proposed algorithm exhibits clear advantages in terms of accuracy, efficiency, and lightweight performance, making it well-suited for practical applications in weed detection and providing a viable solution for agricultural automation.}
}
@article{LI2026114228,
title = {Dominance-based feature selection approach to interval-valued ordered intuitionistic fuzzy data},
journal = {Applied Soft Computing},
volume = {186},
pages = {114228},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114228},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015418},
author = {Wentao Li and Chaojun Deng and Witold Pedrycz and Weiping Ding and Xingchen Hu and Chao Zhang and Tao Zhan},
keywords = {Feature selection, Interval-valued intuitionistic fuzzy system, Ordered decision system, Rough sets},
abstract = {This paper presents a novel feature selection approach based on dominance principle, specifically designed for interval-valued ordered intuitionistic fuzzy systems (IV-OIFS), aiming to enhance performance through dimensionality reduction and elimination of irrelevant attributes. The dominance principle is employed to identify relevant features, while introducing the interval dominance index (IDI) and interval coverage index (ICI) to better capture dominance relationship within interval-valued ordered intuitionistic fuzzy data. Using these two measurements, a dominance-based rough set model, named IVIF-DRSA, is established for IV-OIFS. It is shown how the IVIF-DRSA extends traditional rough set theory by improving interpretability, computational efficiency, and classification accuracy. Furthermore, an efficient greedy feature selection algorithm based on IVIF-DRSA is proposed for IV-OIFS. To validate the efficacy and excellence of the proposed algorithm, comprehensive experiments on twelve UCI datasets and ten handwritten digit images demonstrate the superior performance compared to existing methods, providing valuable insights into feature selection for interval-valued ordered intuitionistic fuzzy data.}
}
@article{SWAPNA2026114272,
title = {Optimizing Dual-Task Q-Learning with latency and attention-aware schemes in edge computing},
journal = {Applied Soft Computing},
volume = {186},
pages = {114272},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114272},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015856},
author = {B. Swapna and V. Murali Mohan},
keywords = {IoT, MEC, Resource allocation, Task offloading, Deep reinforcement learning, Attention mechanism},
abstract = {Computation offloading on Internet of Things (IoT) mobile Edge Nodes (ENs) simplifies resource-intensive operations but increases computational complexity due to convex optimization, leading to excessive resource consumption, inadequate load balancing, security vulnerabilities, and latency. To address these issues, a novel Adaptive Dual-Task Q-Learning with an Attention-Aware Mechanism is proposed for efficient task offloading and resource allocation in Mobile Edge Computing (MEC) systems, which are increasingly vital because of the rise of computation- and delay-intensive mobile apps. This approach leverages attention-aware features to prioritize critical information, reducing task timeouts and ensuring effective load balancing and resource utilization. Traditional chronological resource allocation methods are suboptimal for tasks with varying urgencies; hence, an Attention-Aware Resource Allocation mechanism is introduced, employing a three-buffer system to manage high, medium, and low-priority tasks. The Dual-Task Q-Learning Model, incorporating actor, critic, and communication networks, learn optimal offloading strategies by considering both local and global states, thus enhancing stability, reducing computational complexity, and ensuring efficient resource allocation. As a result, it can complete more tasks, reducing average delay from 0.093 s to 0.111 s and average energy consumption from 18.08 J to 17.48 J for tasks reaching from 10 to 40 while maintaining its superiority, achieving a completion ratio of 0.892 with 60 tasks, respectively. Additionally, the system demonstrates energy efficiency, consuming 14.08 J for 20 tasks and 14.52 J for 30 tasks, further highlighting its optimization capabilities. The proposed framework demonstrates significant improvements in delay, time consumption, and resource utilization, effectively addressing the limitations of conventional MEC systems.}
}
@article{YANG2026114147,
title = {Integrating semi-supervised learning with density tree structures for scalable clustering},
journal = {Applied Soft Computing},
volume = {186},
pages = {114147},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114147},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014607},
author = {Haifeng Yang and Yanchao Feng and Jianghui Cai and Jie Wang and Yating Li and Xujun Zhao and Yaling Xun},
keywords = {Semi-supervised clustering, Density-based clustering, Density tree, Constraint information},
abstract = {Semi-supervised density clustering integrates semi-supervised learning with density-based clustering, leveraging prior knowledge to refine clustering and boost performance. However, the neglect of the traditional algorithms in taking into account the variation of sample density among clusters with uneven densities restricts their capacity to detect clusters in sparsely populated data regions. Therefore, a scalable clustering method integrating semi-supervised learning and density tree structure (SDT) is proposed in this paper. In this method, a new concept of density tree formation on inverse k−NN graph is proposed for the first time. Based on this notion, we first utilize the node density information and its K-nearest neighbor data to guarantee the purity of the density tree. Subsequently, the local density centers of the dataset are captured via the density tree, a process that is not influenced by the uniformity or diversity of the data distribution. Secondly, the clustering process is refined by propagating label information on the density tree to more accurately assign the remaining nodes to the corresponding density tree. The results across 15 datasets indicate that the mean ACC, ARI, and NMI of SDT are 0.976, 0.957 and 0.943, respectively, demonstrating significantly superior performance compared to the benchmark methods.}
}
@article{KILIC2026114268,
title = {Fine-to-coarse self-attention graph convolutional network for skeleton-based action recognition},
journal = {Applied Soft Computing},
volume = {186},
pages = {114268},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114268},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015819},
author = {Ugur Kilic and Ozge {Oztimur Karadag} and Gulsah {Tumuklu Ozyer}},
keywords = {Fine-to-coarse approach, Graph convolutional networks, Multi-scale, Skeleton-based action recognition, Skeletal data, Temporal self-attention},
abstract = {Skeleton data has become an important modality in action recognition due to its robustness to environmental changes, computational efficiency, compact structure, and privacy-oriented nature. With the rise of deep learning, many methods for action recognition using skeleton data have been developed. Among these methods, spatial-temporal graph convolutional networks (ST-GCNs) have seen growing popularity due to the suitability of skeleton data for graph-based modeling. However, ST-GCN models use fixed graph topologies and fixed-size spatial-temporal convolution kernels. This limits their ability to model coordinated movements of joints in different body regions and long-term spatial-temporal dependencies. To address these limitations, we propose a fine-to-coarse self-attention graph convolutional network (FCSA-GCN). Our approach employs a fine-to-coarse scaling strategy for multi-scale feature extraction. This strategy effectively models both local and global spatial-temporal relationships and better represents the interactions among joint groups in different body regions. By integrating a temporal self-attention mechanism (TSA) into the multi-scale feature extraction process, we enhance the model’s ability to capture long-term temporal dependencies effectively. Additionally, during training, we employ the dynamic weight averaging (DWA) approach to ensure balanced optimization across the multi-scale feature extraction stages. Comprehensive experiments conducted on the NTU-60, NTU-120, and NW-UCLA datasets demonstrate that FCSA-GCN outperforms state-of-the-art methods. These results highlight that the proposed approach effectively addresses the current challenges in skeleton-based action recognition (SBAR).}
}
@article{LI2026114295,
title = {MSA-GCN: A multi-modal spatiotemporal attention graph convolutional network for robust bearing fault diagnosis in noisy environments},
journal = {Applied Soft Computing},
volume = {186},
pages = {114295},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114295},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016084},
author = {Ying Li and Xiaoping Liu and Pengfei Liang and Bin Wang and Xiaoming Yuan and Lijie Zhang},
keywords = {Bearing fault diagnosis, Multi-sensor data fusion, Graph attention network, Spatiotemporal fully connected graph},
abstract = {During the monitoring of rolling bearings, environmental noise interference can obscure crucial fault information, thereby reducing the accuracy of conventional diagnostic methods that depend on a single sensor. While collaborative monitoring through multiple sensors can significantly ameliorate this issue, current data-driven multi-sensor fault diagnosis models fail to adequately exploit the spatiotemporal relationships between sensors. Furthermore, these models typically extract temporal and spatial features in a phase-wise manner, overlooking the continuous and unified interaction between spatiotemporal relationships in the real world, an approach that does not align with actual spatiotemporal dependencies. In response to these challenges, this paper proposes a novel multi-modal spatiotemporal attention–graph convolutional neural network (MSA–GCN) for bearing fault diagnosis. The framework integrates vibration, sound, and electric current signals into a unified spatiotemporal fully connected graph, replacing traditional similarity-based connections. To address data heterogeneity, a feature mapping module applies local and global transformations, projecting data into a common feature space. The proposed MSA-GCN model then computes global attention weights between nodes, effectively fusing spatiotemporal features. Experiments on three multi-sensor bearing datasets show its superiority over advanced models.}
}
@article{LU2026114222,
title = {A benchmark dataset and lightweight model for multi-distance gesture recognition in UAV control},
journal = {Applied Soft Computing},
volume = {186},
pages = {114222},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114222},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015352},
author = {Yu Lu and Zhenpeng Xu and Meng Li and Xianghua Fu and Kai Leung Yung and Wai Hung Ip},
keywords = {Deep learning, Unmanned aerial vehicles (UAVs), Gesture recognition, Multi-distance interaction, Benchmark dataset},
abstract = {Unmanned Aerial Vehicle (UAV) gesture recognition is an emerging form of human-computer interaction that enables intuitive UAV control across diverse and dynamic environments. However, progress in AI-based UAV gesture recognition has been hindered by the lack of large-scale, well-annotated datasets. To address this limitation, we present MD-UHGRD, a static gesture dataset containing 2280 annotated images collected from multiple individuals under varied environmental conditions and distances. This dataset supports the development of accurate and generalizable gesture recognition models. Building upon this foundation, we propose SA-YOLO, a lightweight and modular recognition framework that combines gesture detection with face and pedestrian tracking to enhance UAV responsiveness in real-world scenarios. SA-YOLO integrates Spatial Asymptotic Feature Pyramid Network (SAFPN), Scale Pyramid Pooling with Cross Stage Partial Convolution (SPPCSPC), and Space-to-Depth Convolution (SPD-Conv) to improve spatial feature extraction and computational efficiency. Experiments on the MD-UHGRD dataset, conducted under standardized training and testing conditions, show that SA-YOLO achieves 93.2 % ±0.2 mAP with only 10.3 M parameters and 48 ±1 FPS. These results demonstrate not only high accuracy and efficiency but also stable and reproducible performance, positioning SA-YOLO as a benchmark in UAV gesture recognition with a strong balance between accuracy, speed, and model compactness.}
}
@article{LONG2026114190,
title = {A state of charge feature selection method for electric buses via fuzzy information measures},
journal = {Applied Soft Computing},
volume = {186},
pages = {114190},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114190},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015030},
author = {Can Long and Bin Li and Jianghui Wen},
keywords = {State of charge, Feature selection, Strong approximation of Markov blanket, Fuzzy information measure, Dynamic maximum relevancy change minimum redundancy change},
abstract = {State of charge (SOC) feature selection (FS) can significantly reduce model complexity and guarantee SOC estimation accuracy. However, there are limited FS methods since the electric bus driving dataset is a regression dataset with numerous continuous features. To tackle this issue, this paper proposes a novel FS method called dynamic maximum relevancy change and minimum redundancy change (DMRCmRC). Firstly, the modified strong approximation Markov blanket is constructed to obtain the feature groups and the count of strong relevant features in the regression dataset. Secondly, taking into account the interaction between the features in the dataset, three-dimensional fuzzy information measures are deduced to define the continuous candidate features’ dynamic relevancy change and redundancy change. Then, a novel feature evaluation function is designed to select the most critical features from each feature group, which employs a weighting scheme to combine feature relevance, redundancy, dynamic relevancy change and redundancy change. Furthermore, DMRCmRC has been tested on the STP, DEE, and BAS datasets. The tests show that DMRCmRC successfully improves the regression performance of feature subsets while reducing the feature dimension. Finally, DMRCmRC is applied to an electric bus driving dataset in Beijing, the statistical tests confirmed that DMRCmRC has significant statistical differences.}
}
@article{ZHAO2026114214,
title = {Stacking-based heterogeneous genetic programming for interpretable credit risk evaluation},
journal = {Applied Soft Computing},
volume = {186},
pages = {114214},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114214},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015273},
author = {Zixue Zhao and Qiao Lin and Yiran Li and Yue Li and Tianxiang Cui},
keywords = {Credit risk prediction, Heterogeneous stacking, Genetic programming, Shapley additive explanations, Natural gradient boosting},
abstract = {The development of advanced ensemble models to handle complex and large-scale datasets has become a central focus in credit risk prediction. Although ensemble methods offer strong predictive performance, stacking lacks a standardized construction pipeline and its complex structure often reduces transparency and robustness. To address these challenges, this study proposes a stacking based heterogeneous genetic programming classifier (SH-GPC), an end to end pipeline in which genetic programming serves as the meta-classifier to enhance interpretability and generalization. Through experiments on a large-scale credit risk dataset comprising millions of records, SH-GPC is shown to significantly outperform conventional homogeneous ensemble methods and several emerging models, including XGBoost, LightGBM, NGBoost, and TabNet, in terms of AUC. Compared to stacking frameworks with logistic regression or XGBoost as the meta-classifier, SH-GPC achieves better predictive accuracy while relying on a smaller number of base classifiers, thereby improving simplicity and interpretability. Transparency is further enhanced by representing the GP meta-classifier as evolved symbolic expressions and syntax trees. Additionally, the incorporation of the Shapley additive explanations (SHAP) technique enables visualization and attribution of each base classifier’s contribution, offering insights into the model’s internal decision logic. This study demonstrates the applicability of evolutionary algorithms in ensemble learning and introduces a new framework for credit risk modeling that achieves a balance between accuracy, stability, and interpretability.}
}
@article{DU2026114266,
title = {An integrated robust BWM and ExpTODIM method for investment decision-making in new energy vehicle charging infrastructure construction},
journal = {Applied Soft Computing},
volume = {186},
pages = {114266},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114266},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015790},
author = {Yun Du and Xiaoya Zhan},
keywords = {BWM, ExpTODIM, New energy vehicles, Charging infrastructure, Investment decision-making},
abstract = {New energy vehicles (NEVs) can effectively address environmental issues and energy crises, making them the primary development direction for future automobiles. However, range anxiety limits their development. This study constructs an integrated robust BWM and ExpTODIM method to assist decision-makers (DMs) in making investment decisions for NEV charging infrastructure construction, thereby addressing range anxiety and promoting the development of NEVs. To preprocess group decision information, this study constructs a 2-tuple fuzzy linguistic consensus model that incorporates decision makers’(DMs) trust network relationships. A robust BWM is then proposed to improve the reliability of decision criterion weight determination. Finally, the ExpTODIM method is extended to a 2-tuple fuzzy linguistic environment for decision-making on NEV charging infrastructure construction investment schemes. The method's validity is assessed through a case study of new energy vehicle charging infrastructure investment decisions and subsequent comparative analysis with alternative approaches. The results demonstrate that the proposed robust BWM achieves a 50 % improvement in robustness compared to the conventional BWM. Comparative analysis against established methods, including BWM, ROCOSD, CSOGRMILP, CRITIC, and EWM, reveals that the proposed framework exhibits the highest consistency index. Furthermore, the integration of a consensus-building process in the decision information preprocessing stage significantly enhances both the consensus level among DMs and the overall quality of decision results.}
}
@article{ALHABIB2026114225,
title = {Semi-supervised few-shot learning via ensemble-based adaptive clustering-aware pseudo-labeling},
journal = {Applied Soft Computing},
volume = {186},
pages = {114225},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114225},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015388},
author = {Mohammed Al-Habib and Zuping Zhang and Abdulrahman Noman and Majjed Al-Qatf and Mounir Abdelaziz},
keywords = {Few-shot learning, Computer vision, Semi-supervised learning, Object classification, Ensemble clustering, Pseudo-labeling, Cross-domain},
abstract = {Semi-supervised Few-shot Learning (SSFSL) faces a significant challenge in training a classifier that can effectively adapt to new tasks using a limited number of labeled data and a set amount of unlabeled data. SSFSL problems stem from the lack of annotated datasets and the persistent problem of model overfitting. Recent SSFSL methods expand the support set by generating pseudo-labels for unlabeled samples. However, most of these approaches do not fully exploit the relationships between labeled and unlabeled data, often producing inaccurate labels that negatively affect the model’s ability to learn and generalize. In this paper, we propose a novel ensemble-based Adaptive Clustering-aware Pseudo-Labeling Few-shot Learning (ACPL-FSL) to tackle these challenges in semi-supervised few-shot image classification. On one hand, we introduce an Adaptive Clustering-aware Pseudo-Labeling (ACPL) module that alternates among multiple clustering algorithms to capture complementary views of the data, while a Self-Adaptive Pseudo-Labeling Strategy (SAPS) assigns per-cluster weights, derived from silhouette and discrepancy scores, to adaptively refine hard and soft pseudo-labels. On the other hand, we incorporate an Ensemble-Based Sample Selection (EBSS) module that applies strict majority-vote filtering across the clusterers, discarding low-confidence labels and retaining only the most reliable pseudo-labels for subsequent learning. We leverage the generated pseudo-labels for the unlabeled samples to extend the support set and obtain more accurate distribution information. Extensive experiments demonstrate the effectiveness of the proposed ACPL-FSL in both the 1-shot and 5-shot settings across standard single-domain and cross-domain few-shot benchmarks, especially improving the state-of-the-art recognition accuracy in the 5-way 1-shot setting by 1.08 % and 1.05 % on the miniImageNet and tieredImageNet datasets, respectively.}
}
@article{LIU2026114261,
title = {Assessing sustainable energy systems using interval-valued Fermatean fuzzy sets-based decision-making model},
journal = {Applied Soft Computing},
volume = {186},
pages = {114261},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114261},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015741},
author = {Zhe Liu and Zeliang Weng and Sukumar Letchmunan and Muhammet Deveci and Yulong Huang and Dragan Pamucar and Patrick Siarry},
keywords = {Sustainable energy systems, Decision-making, IVFFS, Hellinger-type distance, MAIRCA},
abstract = {The increasing global demand for renewable energy, coupled with a strong emphasis on environmental protection and sustainable resource management, has made the assessment of sustainable energy systems (SESs) a critical multi-criteria decision-making (MCDM) challenge. Traditional energy production methods are rapidly depleting natural resources and causing long-term environmental damage, necessitating the exploration of green, cost-effective alternatives. This paper develops a novel interval-valued Fermatean fuzzy sets (IVFFSs)-based MCDM model for assessing SESs. First, this paper presents a new generalized Hellinger-type distance measure (GHDM) to quantify the difference between IVFFSs and discusses its properties. A hybrid weighting system is then designed based on the GHDM and the Analytic Hierarchy Process (AHP) to optimally balance objective data-driven weights with subjective expert judgments. Finally, an enhanced Multi-Attributive Ideal-Real Comparative Analysis (MAIRCA) method under an interval-valued Fermatean fuzzy (IVFF) environment is suggested, where the GHDM is employed to quantify the deviation between alternatives and the ideal solutions. The proposed model effectively handles uncertainty and ambiguity in decision-making by incorporating IVFF setting, and it offers a reliable way for assessing and ranking SESs based on various criteria. A case study demonstrates the applicability and robustness of the proposed model in selecting the best energy system, supporting strategic decision-making for sustainable energy planning.}
}
@article{SUN2026114201,
title = {Adaptive fuzzy PID search algorithm for global optimization with application to 3D UAV path planning},
journal = {Applied Soft Computing},
volume = {186},
pages = {114201},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114201},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015145},
author = {Lijun Sun and Mingyang Gu and Tianfei Chen and Xiaoping Liu and Huanqi Zheng},
keywords = {Metaheuristics, PID search algorithm, Fuzzy logic system, Adaptive strategy, 3D UAV path planning},
abstract = {Metaheuristic algorithms play a vital role in addressing complex, high-dimensional, and multi-modal engineering optimization problems, as their search efficiency and robustness critically determine their practical applicability. The PID Search Algorithm (PSA), a recently proposed optimization method, has gained attention due to its simple structure and high computational efficiency. However, PSA still encounters challenges, including a tendency to stagnate in local optima and inadequate global exploration, especially in high-dimensional and complex environments susceptible to premature convergence. To address these limitations, this paper proposes an Adaptive Fuzzy PID Search Algorithm (AF-PSA), which incorporates a fuzzy logic system to adaptively regulate the proportional (Kp), integral (Ki), and derivative (Kd) coefficients, thereby improving the algorithms adaptability and stability. Furthermore, a fuzzy dynamic Levy flight mechanism is employed to enhance global exploration, and an escape strategy is developed to avoid premature convergence. To evaluate its performance, AF-PSA is compared with 13 advanced algorithms on the CEC2017 (Dim=50 and 100) and CEC2022 (Dim=10 and 20) benchmark suites. Pairwise comparisons using the Wilcoxon rank-sum test reveal that AF-PSA significantly outperforms most competing algorithms across the benchmark functions. Moreover, the Friedman test results show that AF-PSA achieves average rankings of 1.53, 1.40, 1.08, and 1.13 on the CEC2017 (Dim = 50 and 100) and CEC2022 (Dim = 10 and 20) benchmarks, respectively, confirming its superior overall performance and robustness. In a practical application, AF-PSA is applied to a three-dimensional UAV path-planning problem to verify its effectiveness. Experimental results show that the flight paths generated by AF-PSA exhibit higher safety, smoother trajectories, greater convergence accuracy, and stronger robustness compared with those produced by other algorithms. These findings confirm that AF-PSA achieves a sound balance between theoretical innovation and engineering practicality, offering an efficient and reliable optimization framework for addressing complex real-world problems.}
}
@article{HONG2026114253,
title = {Large language model driven adaptive deep reinforcement learning with dynamic definition refinement for flexible job shop scheduling problem},
journal = {Applied Soft Computing},
volume = {186},
pages = {114253},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114253},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015662},
author = {Tzu-Yen Hong and Kuan-Han Li},
keywords = {Flexible Job Shop Scheduling Problem, Deep Reinforcement Learning, Large Language Model, Asynchronous Advantage Actor-Critic, Adaptive Learning},
abstract = {The flexible job shop scheduling problem (FJSP) remains a critical challenge in the transition to smart manufacturing due to its high complexity and the uncertainty of dynamic production environments. While reinforcement learning (RL) has emerged as a widely adopted approach for addressing FJSP, the definition of state representations and reward functions for RL remains a significant obstacle under changing system conditions. This study presents LLM4A3C, a Large Language Model for Reinforcement Learning (LLM4RL) framework that integrates a Large Language Model (LLM) with the Asynchronous Advantage Actor-Critic (A3C) algorithm to solve the FJSP. The proposed framework incorporates an LLM module to semantically adjust state representations and generate potential-based reward functions. A closed-loop feedback mechanism is designed to iteratively generate adaptive learning elements based on training results, enabling the DRL agent to dynamically respond to changes in the environment. Experimental results show that LLM4A3C significantly outperforms the baseline A3C in reducing makespan and total tardiness, while also improving sample efficiency and convergence speed. Furthermore, ablation and sensitivity analysis indicate the advantage of the proposed method and limitations of static feature and manual reward tuning. Indeed, the state signals also exhibit stronger alignment with actual return trends based on correlation analysis. The results validate that integrating LLMs into DRL architectures facilitates adaptive learning behavior in complex scheduling environments.}
}
@article{TAN2026114189,
title = {A direction-sensitive graph learning to explore supply chain network for financial risk detection},
journal = {Applied Soft Computing},
volume = {186},
pages = {114189},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114189},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015029},
author = {Jinghua Tan and Junxiao Chen and Shanshan Feng and Huang Li and Jun Wang and Yang Zhang and Minghui Kang},
keywords = {Graph learning, Supply chain, Risk detection},
abstract = {The detection of abnormal fluctuations can provide listed companies with an early warning of potential risks, which is critical to ensuring the stability and sustainable operation of companies. Previous studies, however, tended to consider only the inherent risks of a firm, ignoring the contagion risk and macro state to which the firm is exposed. This study is the first work to incorporate spillover effects and global information in the supply chain into enterprise risk detection. Specifically, we first propose a direction-sensitive messaging method to simulate the contagion effects in supply chain networks. This is achieved by adopting a heterogeneous mapping mechanism to distinguish spillovers generated and suffered by firms in different business flows. Then, we design a self-supervised representation learning module to dynamically adjust the representation of firm nodes based on the situation of both the firm and the supply chain it belongs. Finally, an end-to-end framework is employed to simultaneously capture inherent risk, contagion risk, and global risk. This study paves the way for addressing supply chain information in enterprise risk detection. Experiments on the real-world dataset demonstrate the advantages of the proposed framework over four classic and three state-of-the-art algorithms.}
}
@article{QIU2026114265,
title = {Continual learning with a predictive coding based classifier},
journal = {Applied Soft Computing},
volume = {186},
pages = {114265},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114265},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015789},
author = {Senhui Qiu and Saugat Bhattacharyya and Damien Coyle and Shirin Dora},
keywords = {Predictive coding, Continual learning, Replay, Generative model, Local learning},
abstract = {Continual Learning (CL) is the problem of learning multiple tasks sequentially. Several effective CL algorithms using Deep Neural Networks (DNNs) have been developed. However, the problem of reducing the computational requirements of the CL algorithms has not received enough attention. Computationally efficient training methods are important for CL because these models potentially undergo training throughout their lifetime. There is a need to build efficient CL methods that can be used on a broad range of devices. Predictive Coding (PC) is a hypothesis about information processing in the brain. The underlying principle is that the PC model predicts the activity of adjacent layers and updates the model in parallel using local errors between predicted and actual neuron activities, potentially improving the efficiency of CL. This paper proposes a new Continual Learning method using a Predictive Coding based Classifier (CLPC2). CLPC2 trains a PC-based classifier with replay samples generated using a Variational Autoencoder (VAE) or Diffusion (Dif). The performance of CLPC2 is evaluated in three CL scenarios: Class Incremental Learning (Class-IL), Domain Incremental Learning (Domain-IL) and Task Incremental Learning (Task-IL) using the split MNIST, CIFAR-10, and CIFAR-100 datasets. Compared with existing CL methods, CLPC2 achieves higher average classification accuracy in Class-IL and Domain-IL scenarios on MNIST and CIFAR-10 datasets, while obtaining comparable performance on the more challenging CIFAR-100 dataset. The key advantage of the proposed method is the ability to perform training in the classifier using locally computed errors.}
}
@article{BAE2026114233,
title = {Two-stage deep learning model for nuclear power plant parameter trend prediction with epistemic uncertainty quantification},
journal = {Applied Soft Computing},
volume = {186},
pages = {114233},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114233},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015467},
author = {Junyong Bae and Kyeong Seo Kim and Seung Jun Lee},
keywords = {Nuclear power plant, Parameter Trend Prediction, Epistemic uncertainty, Monte Carlo dropout, Latent imagination},
abstract = {Physics-based nuclear power plant (NPP) simulations including thermal-hydraulic system codes require significant computational resources, limiting their applications for real-time prediction during accidents or more exhaustive safety assessments. While data-driven surrogates have been developed to address this challenge, two critical limitations persist: restricted time horizons (typically less than several hundred steps) and lack of predictive uncertainty quantification. This study proposes a novel two-stage deep learning model inspired by latent imagination techniques from reinforcement learning and incorporating Monte Carlo dropout for uncertainty estimation. The model was validated using simulation records of critical safety parameters—peak cladding temperature and reactor pressure vessel water levels—during NPP accident scenarios. Training data were deliberately limited in number to assess the model's ability to estimate prediction intervals representing uncertainty. Results on test data demonstrate that the model can predict parameter trends for both variables with average mean absolute errors (MAE) of 22 K and 0.53 m over more than 1700 time steps while appropriately quantifying uncertainty, achieving prediction interval coverage probabilities (PICP) of 98.76 % and 93.35 %, respectively. In addition, we validated that the quantified uncertainty properly correlated with training data abundance and trend variability. This research contributes to developing advanced surrogate models for safer and more economic operation of NPPs, including small modular reactors.}
}
@article{MA2026114269,
title = {Toward personalized risk-sensitive decision-making: A novel risk preference adaptive distributional reinforcement learning algorithm for stock trading},
journal = {Applied Soft Computing},
volume = {186},
pages = {114269},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114269},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015820},
author = {Cong Ma and Fei Gao and Lizhen Ji and Chunxia Zhang and Li Long and Jiangshe Zhang},
keywords = {Algorithmic trading, Distributional reinforcement learning, Risk preference adaptive, Probability distortion, Stock trading},
abstract = {Due to the high uncertainty inherent in financial markets, returns (or rewards) in trading are fundamentally random variables. Traditional deep reinforcement learning (DRL) algorithms typically aim to maximize the expected return, while neglecting the full distribution of returns. This limitation hinders their ability to effectively manage tail risks and results in inadequate risk control. Moreover, investors’ varying risk preferences significantly influence portfolio selection and decision-making. To address these challenges, this paper adopts a distributional reinforcement learning (DiRL) framework for stock trading, which models and optimizes the entire return distribution rather than focusing solely on its expectation. This provides a more comprehensive representation of market risk characteristics. Building upon this foundation, we incorporate risk-sensitive decision theory via a probability distortion function to account for individual risk preferences. Based on this, we propose a novel algorithm—Risk Preference Adaptive Distributional Reinforcement Learning (RPADiRL)—which enhances both the robustness and practical applicability of trading strategies under uncertainty. Extensive experiments on eight representative stocks across various risk preferences demonstrate the effectiveness and superiority of the proposed approach compared to state-of-the-art baselines.}
}
@article{WANG2026114260,
title = {Fuzzy twin support vector machine based on fuzzy membership assignment strategy: A survey},
journal = {Applied Soft Computing},
volume = {186},
pages = {114260},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114260},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501573X},
author = {Xia Wang and Guosheng Hao and Gaohao Wu and Xingze Lu},
keywords = {Twin support vector machine, Fuzzy twin support vector machine, Fuzzy membership assignment strategy, Geometric distance, Information entropy, Data distribution},
abstract = {Fuzzy twin support vector machine (FTSVM) is a significant extension of the twin support vector machine (TWSVM) that uniquely combines fuzzy theory with the advantages of TWSVM. While maintaining the computational efficiency of TWSVM, FTSVM leverages the flexibility of fuzzy theory, demonstrating considerable potential for enhancing the robustness and performance of classification tasks, particularly in the presence of noisy or uncertain data. Despite its theoretical importance and wide-ranging practical applications, a notable gap exists in the literature: the absence of a comprehensive and focused review specifically addressing FTSVM technology and its applications. This study aims to bridge this gap. By conducting an in-depth and systematic review of the research advancements in FTSVM, it emphasizes the fuzzy membership degree assignment strategy. This paper thoroughly examines the historical evolution and current developments of FTSVM, introducing multiple FTSVM models based on three assignment strategies: geometric distance, information entropy, and data distribution. Additionally, it presents implementation details, limitations, and various applications of FTSVM. Our objective is to establish a clear and common reference point for prospective studies related to FTSVM.}
}
@article{JERIBI2026114281,
title = {Dynamic scene understanding of surgical medical images for accurate disease diagnosis using deep learning based motion segmentation},
journal = {Applied Soft Computing},
volume = {186},
pages = {114281},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114281},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015947},
author = {Fathe Jeribi},
keywords = {Dynamic scene understanding, Surgical medical images, Motion segmentation, Deep learning, Stochastic model},
abstract = {Accurate analysis of surgical clinical features is essential for early diagnosis and treatment planning. Understanding the nature of dynamic factors in the surgical environment is a significant challenge. Understanding and analyzing movements in the field of surgery is important because they are constantly changing due to surgeon actions and biological tissue responses. A robust visual perspective is critical for interpreting changes in the field of surgery over time, with a strong emphasis on understanding movement mechanisms that promote surgical progression and tissue survival. To address this challenge, a deep learning-based model for segmentation in dynamic scenes is presented. It allows more accurate and predictable identification of moving organs rather than intra-operatively damaged tissue. The research begins with the development of an optimal method for organ dynamics analysis in cross-sectional image processing using the enhanced orca predation optimization (EOPO) algorithm. A hybrid model is proposed that combines different trained models with stochastic differential equation (SDE) to deal with the nonlinear behavior inherent in SDEs. It helps to identify unusual changes and changing motion patterns, providing more accurate traffic distribution. In addition, a prediction model using deep graph neural network (DGNN) is used to predict future movements of organs, which contributes to the direction of improvement identified using CholecSeg8K data. The proposed DGNN models show the mean accuracy of 99.125 % and mean IoU of 98.808 % which is 1.538 % and 1.121 % efficient than the existing models. Motion segmentation optimization and tissue behaviour prediction during surgery will improve surgical results, lower the risk of complications, allow targeted therapy, and ultimately improve patient outcomes.}
}
@article{MARINO2026114197,
title = {Local manipulations of the fitness landscape mitigate stall in particle swarm optimization},
journal = {Applied Soft Computing},
volume = {186},
pages = {114197},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114197},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015108},
author = {Mario Marino and Daniele M. Papetti and Daniela Besozzi and Marco S. Nobile},
keywords = {Global optimization, Local bubble dilation functions, Particle swarm optimization, Stall mitigation, FST-PSO, PSALM},
abstract = {Real-world optimization problems often exhibit multimodality, non-convexity, and stochasticity, which limit the effectiveness of classical algorithms. Gradient-free bio-inspired metaheuristics evolve a population of candidate solutions to address such challenges and find the global optimum. Particle Swarm Optimization (PSO) leverages a swarm of particles (i.e., candidate solutions) that move in the search space attracted by their personal best and the global best solutions. However, similar to other metaheuristics, PSO is prone to stalling, whereby particles fail to escape local minima and reach more promising basins of attraction. We address this issue through Local Bubble Dilation Functions (LBDFs), which locally reshape the landscape around any particle that might have lost its exploration capability. A velocity-based criterion first identifies the stalling particles, distinguishing them from the exploratory ones; then, an LBDF compresses the region around a stalling particle, pushing it away from the bubble center. We integrate this stall remedy—Particle Stall Avoidance through Landscape Manipulation (PSALM)—into Fuzzy Self-Tuning PSO (FST-PSO). We evaluate its effectiveness on the Rastrigin function and on the suite of benchmark functions CEC2017, showing that PSALM improves the search capabilities of FST-PSO by escaping overexploited—and possibly unpromising—areas of the search space, with statistically significant improvements in the best solutions found.}
}
@article{TCHOKPONHOUE2026114249,
title = {On the value of uncertainty quantification in deep learning based breast cancer molecular subtype classification},
journal = {Applied Soft Computing},
volume = {186},
pages = {114249},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114249},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015625},
author = {Gbègninougbo Aurel Davy Tchokponhoue and Ali Idri},
keywords = {Uncertainty quantification, Deep Learning, Breast cancer, Molecular subtype, Robustness},
abstract = {Cancer is still a major global health issue and one of the leading causes of death globally. Despite significant progress in the field of machine learning (ML) and deep learning (DL) in the medical field and especially in cancer research, uncertainty quantification has been largely under-investigated, resulting in the development of decision systems with questionable reliability and confidence, which are essential for effective integration and adoption in a clinical context. In this study, we evaluate and discuss five uncertainty quantification (UQ) methods: Single Deterministic, Monte Carlo Dropout (MCD), Bayesian Neural Network based on Variational Inference (BNN), Deep Ensemble (DE), and Bootstrap Ensemble (BG) for the identification of breast cancer molecular subtype using a deep neural network (DNN). These empirical evaluations were based, in addition to the classical classification performance criteria such as accuracy, recall, precision and f1 score, on other advanced criteria related to sensibility, interpretability, robustness, and out-of-distribution (OOD) detection. Moreover, we introduce and evaluate new algorithms for synthetic OOD data generation, crucial for assessing the reliability of quantified uncertainties. Results indicated that Ensemble-based UQ methods generally provided more robust uncertainty estimates and performed best in terms of sensitivity. Stochastic methods, on the other hand, achieved superior calibration, with Bayesian Neural Networks in particular demonstrating strong robustness to adversarial attacks, an attribute that may enhance the generalization capacity of classifiers. Overall, we found that uncertainty estimates not only provide reliable confidence measures but also enhance the transparency of model predictions, supporting safer clinical deployment.}
}
@article{XU2026114184,
title = {Understanding the profit-driven credit scoring: New insights on loss functions and measures},
journal = {Applied Soft Computing},
volume = {186},
pages = {114184},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114184},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014978},
author = {Yong Xu and Daji Ergu},
keywords = {Machine learning, Credit scoring, Financial decision-making, Profit-oriented modeling, Performance measures},
abstract = {Credit scoring is a crucial area of research in financial risk management, and it is typically treated as a binary classification problem. While the Binary Cross-Entropy (BCE) loss function is widely used for this task, recent advancements indicate that integrating profit-sensitive loss functions can greatly improve model profitability. Nonetheless, the overall efficacy of these profit-sensitive loss functions remains not yet fully understood. In this work, we reveal that profit-based loss functions, particularly the Average Expected Cost (AEC) loss, are misaligned with proper scoring rules, which can lead to overconfident predictions and biased profit assessments. To alleviate these challenges, we introduce a novel Profit-sensitive Cross-Entropy (PCE) loss that is compatible with widely used classification algorithms. Additionally, we develop a tailored expected profit measure to evaluate model performance in credit scoring applications. To validate our approach, we implement two classifiers, namely multi-layer perceptrons and gradient boosting trees, that directly optimize the proposed PCE loss during training. The experimental results, statistical tests, and sensitivity analyses generally demonstrate that our proposed framework outperforms traditional methods, including profit-driven approaches, in optimizing model profitability.}
}
@article{DAI2026114235,
title = {N-BEATS-GAN: A risk-aware financial time series forecasting with generative adversarial networks},
journal = {Applied Soft Computing},
volume = {186},
pages = {114235},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114235},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015480},
author = {Manna Dai and Mao Yu Seow and Ricardo Shirota Filho and Alex Sclip and Kavilash Chawla and Rick {Siow Mong Goh} and Joyjit Chattoraj},
keywords = {Financial time series forecasting, Multi-series, Multi-step, Generative adversarial networks (GANs), N-BEATS, Risk quantification},
abstract = {Time series forecasting is essential for informed decision-making in financial markets, but it poses challenges due to the stochastic nature of financial data. Existing forecasting methods, including classical statistical models and machine learning approaches, often struggle with the complexities of multi-series, multi-output predictions. This paper introduces a deep learning framework, N-BEATS-GAN, which combines the strengths of Generative Adversarial Networks (GANs) for risk modelling with the efficient trend predictive capabilities of the deep learning model N-BEATS. The method integrates GAN loss with the Transformation Invariant Loss function with Distance EQuilibrium (TILDE-Q) loss to address amplitude and phase distortions in time series forecasting and accelerate model convergence. A dataset derived from MSCI (Morgan Stanley Capital International) Country Index data across ten countries is used for validation. Predictive accuracy is assessed using Mean Absolute Error, Mean Squared Error, Continuous Ranked Probability Score, and a risk quantification method is proposed to evaluate the capacity to capture financial risk. Experimental results demonstrate that N-BEATS-GAN significantly outperforms StockMixer, N-BEATS, DLinear, and PAGAN in both prediction accuracy and risk quantification. N-BEATS-GAN overcomes the limitations of existing models, enabling effective multi-series, multi-output forecasting while accounting for inherent risk in financial time series, highlighting its potential to enhance forecasting and risk assessment in financial markets.}
}
@article{LEE2026114215,
title = {Memory bank-guided diffusion model for lightweight anomaly detection},
journal = {Applied Soft Computing},
volume = {186},
pages = {114215},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114215},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015285},
author = {Woojun Lee and Pilsung Kang},
keywords = {Image anomaly detection, Diffusion models, Memory-bank},
abstract = {Reconstruction-based image anomaly detection models that utilize diffusion models have shown superior performance in recent studies. However, these models suffer from substantial computational overhead and inference latency, limiting their deployment in practical applications. To overcome these limitations, we introduce LAMBDA, a lightweight diffusion-based framework that leverages memory bank-guided denoising for efficient anomaly detection. Our approach introduces two key components: (1) Memory Bank-guided denoising that leverages pre-stored normal latent representations to achieve both computational efficiency and superior reconstruction fidelity, leading to more accurate anomaly localization and (2) Guidance Scale Map, which dynamically adjusts guidance intensity based on dataset distributions. Experimental results show that LAMBDA achieves an 80.8 % reduction in GPU memory consumption during training and 53.2 % during inference, while achieving 2.3× and 3.5× speedup in training and inference times, respectively, compared to the baseline. Despite these efficiency gains, LAMBDA maintains competitive performance, achieving accuracy on par with state-of-the-art models. These results demonstrate the potential of our approach for real-world industrial applications, offering a resource-efficient solution for diffusion-based image anomaly detection.}
}
@article{WANG2026114199,
title = {GCN-KAN: A model to extract autocorrelation graph features and fuse Kolmogorov-Arnold networks for stock price trend prediction},
journal = {Applied Soft Computing},
volume = {186},
pages = {114199},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114199},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015121},
author = {Ting Wang and Xudong Liu and Yi Liu and Xingjia Li and Xing Fan},
keywords = {Stock trend prediction, Kolmogorov–Arnold network, Graph convolutional network, Time series graph embedding, Structural feature extraction},
abstract = {As a core component of economic infrastructure, stocks reflect valuation fluctuations and respond to historical economic cycles. Their behavior, influenced by market sentiment and investor expectations, directly affects financial returns, making price forecasting a vital research topic. This study proposes a novel prediction model, GCN-KAN, which integrates the Autocorrelation Function (ACF) into graph construction to capture temporal correlations. These graphs are processed by a Graph Convolutional Network (GCN) to extract structural features. For prediction, the Kolmogorov–Arnold Network (KAN) is introduced as a replacement for traditional classifiers to determine next-day stock trends. Experiments on 100 randomly selected stocks from China’s A-share market show that GCN-KAN outperforms baseline models in both accuracy and F1-measure, achieving an average accuracy of 58.26 % across multiple trading days. Statistical tests, including ANOVA and significance analysis, confirm the model’s superior stability and robustness. Ablation studies further reveal that each module contributes to overall performance, with the combined architecture showing strong synergy. These results suggest that integrating ACF-based graph embedding with KAN significantly enhances predictive accuracy across different time scales and individual stocks. The proposed model thus offers both theoretical innovation and practical utility for stock price trend forecasting.}
}
@article{BAO2026114191,
title = {A third-generation prospect theory-based three-way decision method for coalbed methane development favorable area selection},
journal = {Applied Soft Computing},
volume = {186},
pages = {114191},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114191},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015042},
author = {Yanling Bao and Shumin Cheng and Haichao Wang},
keywords = {Three-way decision, Third-generation prospect theory, Coalbed methane, Interval-valued fuzzy environment},
abstract = {Three-way decision method has significant application value in solving interval-valued fuzzy multi-attribute decision-making problems. However, existing methods generally follow minimum risk principle, but neglect the profound impact of decision makers’ (DMs) psychological behaviors on decision results. To address this limitation, this study innovatively integrates third-generation prospect theory with interval-valued fuzzy three-way decision method, aiming to handle data uncertainty and describe DMs’ psychological behaviors. The proposed method has two main core elements. One is to calculate the dominance degree-based relative outcomes of objects, and further combine it with third generation prospect theory to obtain the relative values of objects. The other is to design an objective conditional probability based on dominance degree, which can accurately reflect the possibility degree of an object being close to the optimal state compared to other objects. Furthermore, we apply the proposed method to select the favorable areas for coalbed methane development in Fukang to verify its effectiveness and practicality. Additionally, we conduct comparative and experimental analyses to further demonstrate the superiority and reliability of our method.}
}
@article{CHEN2026114230,
title = {EGCF: Entropy-guided dynamic competition framework for semi-supervised medical image segmentation},
journal = {Applied Soft Computing},
volume = {186},
pages = {114230},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114230},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015431},
author = {Zhengshi Chen and Juanjuan He and Xiaoming Liu and Jinshan Tang},
keywords = {Semi-supervised medical image segmentation, Mutual competition, Uncertainty, Contrastive learning},
abstract = {Recently, co-training methods that combine pseudo-labeling with consistency regularization have gained significant attention in semi-supervised medical image segmentation. However, the performance of such methods heavily depends on the quality of the pseudo-labels, as incorrect or inaccurate pseudo-labels can significantly impair the effectiveness of consistency loss and limit overall segmentation performance. To address this issue, we propose an Entropy-Guided Dynamic Competition Framework (EGCF), which generates more reliable and stable pseudo-labels by leveraging entropy information and mutual guidance between sub-networks. Specifically, this framework incorporates a Pixel-level Entropy-guided Module (PLEG), which facilitates pixel-level guidance from the more reliable sub-network to the less reliable one for generating higher-quality pseudo-labels. In addition, to improve performance in high-entropy regions such as small organs and anatomical boundaries, we propose an Entropy-guided Patch-wise Contrastive Learning (EGPCL) module that enhances pseudo-label consistency in these challenging regions. Furthermore, to dynamically assess sub-network reliability and facilitate mutual refinement throughout training, we introduce a dynamic competition module and a competitive loss, which leverage entropy and prediction accuracy to enable adaptive competition and mutual guidance between sub-networks. We evaluate our method on three widely used datasets (ACDC, LA, and MMWHS), covering both 2D and 3D medical images. Experimental results demonstrate that the proposed approach consistently outperforms state-of-the-art semi-supervised learning (SSL) methods across all datasets. The code will be released at: https://github.com/lycoris9029/EGCF.}
}
@article{GHOSH2026114291,
title = {Enhanced Generative Adversarial Network with Leaked Information (E-LeakGAN): A deep learning framework for synthesizing computational creativity in scientific domain},
journal = {Applied Soft Computing},
volume = {186},
pages = {114291},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114291},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016047},
author = {Sayantani Ghosh and Amit Konar},
keywords = {Computational creativity, Generative adversarial network, Convolutional neural network, Trigonometric identities, Scientific domain},
abstract = {The present study introduces a novel method for synthesizing computational creativity in scientific domain, demonstrated through the automatic generation of diverse trigonometric identity problems. Prior approaches, including search-based algorithms, template-driven generation, and fine-tuned Large Language Models (LLMs), have often produced problems that closely resemble standard textbook examples due to limited transformation rules, rigid templates, or the absence of explicit mechanisms to promote diversity. To address these limitations, an Enhanced Generative Adversarial Network with Leaked Information (E-LeakGAN) is proposed, in which the convolutional neural network (CNN)-based discriminator transfers abstracted features from the input data to the generator, thereby guiding it to generate diverse identity problems. The novelty within the CNN module includes: a) utilization of Trish activation function to enhance the discriminator’s expressive capacity; b) introduction of a unique dual attention mechanism, that uses channel attention to highlight “which” semantic information is relevant and spatial attention to identify “where” the crucial semantic information is syntactically located; and c) development of an eigenvector guided pooling (EGP) technique that directs the attention-induced convolved features toward the highest semantic-syntactic content. Experiments conducted using three categories of evaluation metrics (BiLingual Evaluation Understudy (BLEU), Mean Normalized Cosine Similarity (MNCS), and Mean Normalized Diversity (MND)) underscore the superior performance of E-LeakGAN compared to traditional techniques. The approach also yields consistent results across other mathematical domains such as algebra and calculus, making it an effective tool for generating chapter-end exercises. Additionally, it supports the development of diverse worksheets and exam questions, assisting educators in designing comprehensive assessment materials.}
}
@article{CAI2026114218,
title = {Knowledge graph-guided and dependency distance enhanced multi-graph networks for aspect-based sentiment analysis},
journal = {Applied Soft Computing},
volume = {186},
pages = {114218},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114218},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015315},
author = {Tao Cai and Mingwei Tang and Haowen Xu and Jie Hu and Qi Tang and Jianqiao Xiong and Shixuan Lv and Mingfeng Zhao},
keywords = {Aspect-based sentiment analysis, Graph neural network, Dependency distance, Knowledge graph},
abstract = {Aspect-based sentiment analysis (ABSA) is a key task in fine-grained sentiment analysis, aiming at identifying the sentiment polarity of specific aspects in a sentence. Although graph neural networks perform well on dependency trees, they still face some urgent problems in ABSA tasks. These models cannot fully utilize the syntactic and semantic information in the dependency tree, which greatly affects the performance of the algorithm. To address these issues, we propose a Knowledge Graph-guided and Dependency Distance Enhanced Multi-Graph Network for Aspect-based Sentiment Analysis (KDE-MGN). First, we propose an aspect-enhanced multi-head attention module (AE). It combines aspect-aware attention with self-attention to capture richer aspect-related and global semantic feature information. Second, we design a distance-enhanced semantic graph module (DESeG) to learn a more comprehensive semantic representation, covering both local key features and global cross-feature information. Moreover, in order to fully utilize the syntactic tree structure, a distance-enhanced grammatical graph module (DESyG) is constructed to enhance important syntactic feature information. In addition, a knowledge graph enhancement module is adopted to guide KDE-MGN to extract key sentiment clue features from the context. Finally, extensive experiments on four benchmark datasets demonstrate that the proposed KDE-MGN model achieves state-of-the-art performance.}
}
@article{QIN2026114270,
title = {Strategic coordination of drones via short-term distributed optimization and long-term reinforcement learning},
journal = {Applied Soft Computing},
volume = {186},
pages = {114270},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114270},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015832},
author = {Chuhao Qin and Evangelos Pournaras},
keywords = {Deep reinforcement learning, Distributed optimization, Drones, Spatio-temporal sensing, Unmanned aerial vehicles},
abstract = {This paper addresses the problem of autonomous task allocation by a swarm of autonomous, interactive drones in large-scale, dynamic spatio-temporal environments. When each drone independently determines navigation, sensing, and recharging options to choose from such that system-wide sensing requirements are met, the collective decision-making becomes an NP-hard decentralized combinatorial optimization problem. Existing solutions face significant limitations: distributed optimization methods such as collective learning often lack long-term adaptability, while centralized deep reinforcement learning (DRL) suffers from high computational complexity, scalability and privacy concerns. To overcome these challenges, we propose a novel hybrid optimization approach that combines long-term DRL with short-term collective learning. In this approach, each drone uses DRL methods to proactively determine high-level strategies, such as flight direction and recharging behavior, while leveraging collective learning to coordinate short-term sensing and navigation tasks with other drones in a decentralized manner. Extensive experiments using datasets derived from realistic urban mobility demonstrate that the proposed solution outperforms standalone state-of-the-art collective learning and DRL approaches by 27.83% and 23.17% respectively. Our findings highlight the complementary strengths of short-term and long-term decision-making, enabling energy-efficient, accurate, and sustainable traffic monitoring through swarms of drones.}
}
@article{GUO2026114210,
title = {Unsupervised learning for 2-additive capacity identification based on rank correlation},
journal = {Applied Soft Computing},
volume = {186},
pages = {114210},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114210},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015236},
author = {Kaihong Guo and Xueting Guan},
keywords = {Unsupervised learning, Rank correlation, Monotonicity constraint, 2-additive capacity, Capacity identification},
abstract = {We develop in this paper a novel unsupervised identification method for 2-additive capacities by introducing some new theoretical findings, with the aim of boosting the identification efficiency further. Firstly, some interesting new theoretical findings are provided, including the normalization of the Shapley interaction index in the 2-additive case, and the complexity analysis of huge amounts of summands in each of the monotonicity constraints on capacities in different cases. Secondly, the idea of rank correlation is borrowed from statistics to interpret different interactions between decision attributes. A rank correlation based computational model is then proposed for the Shapley interaction index of each pair of criteria by unsupervised learning. Thereafter, a maximum entropy model is set up, using our normalized Shapley interaction indices as the inputs of the model, to determine the optimal Shapley value of each criterion, where only a linear number of constraints need to be considered. Finally, a desired monotone 2-additive capacity is uniquely identified by using these two kinds of indices. Unlike existing conventional 2-additive capacity identification methods, where the Shapley values are always obtained before the Shapley interaction indices, we reverse this solution sequence by introducing our normalization of the Shapley interaction index in combination with an efficient form of monotonicity constraints. By this means, we essentially reduce the complexity of constraints from exponential to linear in the number of attributes. As attested by a real-world case of financial performance assessment with our method, the number of constraints can be greatly reduced from the initial 192 down to 6, thus achieving remarkable identification efficiency. A series of performance tests and a comparative analysis of similar sorts of identification methods, show the strong robustness and high efficiency of the developed technique.}
}
@article{KONG2026114262,
title = {MFFMN: Multi-feature fusion Mamba enhancement network for LiDAR-based 3D object detection},
journal = {Applied Soft Computing},
volume = {186},
pages = {114262},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114262},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015753},
author = {Weiwei Kong and Yusheng Du},
keywords = {3D object detection, Small object detection, Attention mechanism, Mamba},
abstract = {While Transformer architectures have demonstrated remarkable effectiveness in 3D object detection, their quadratic computational complexity in modeling long-range relationships fundamentally limits their potential for real-time deployment. To address this critical constraint, we present Multi-Feature Fusion Mamba-enhanced Network (MFFMN), a novel LiDAR-based 3D detection framework that achieves efficient long-range dependency modeling through linear-complexity state space models. Building upon the SECOND baseline, our architecture introduces three pivotal innovations: (1) A Mamba-based 3D backbone that replaces conventional Transformer blocks with state space models, reducing computational complexity of spatial interactions from O(N2) to O(N); (2) A dynamic Bird’s Eye View (BEV) backbone incorporating learnable deformable convolution for adaptive geometric feature extraction while maintaining model compactness; (3) A hierarchical multi-feature fusion head (MFH) incorporating frequency-aware mechanisms and Cross-Scale Attention. Extensive experiments on the KITTI dataset demonstrate state-of-the-art performance, achieving detection accuracies of 81.38 %, 61.45 %, and 70.85 % for Car, Pedestrian, and Cyclist categories under moderate difficulty settings. This represents significant performance gains of +3.52 % (Car), +9.11 % (Pedestrian), and +3.52 % (Cyclist) over the SECOND baseline. Through BEV backbone replacement and lightweight design optimization, our framework successfully reduces total model parameters from 7.80 M to 6.86 M (13.7 % reduction), achieving an optimal balance between computational efficiency and detection accuracy. Our code is available at https://github.com/helloyayads/MFFMN.}
}
@article{HE2026114286,
title = {Crafting imperceptible on-manifold adversarial attacks for tabular data},
journal = {Applied Soft Computing},
volume = {186},
pages = {114286},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114286},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015996},
author = {Zhipeng He and Alexander Stevens and Chun Ouyang and Johannes {De Smedt} and Alistair Barros and Catarina Moreira},
keywords = {Adversarial attack, Variational autoencoder, Tabular data, Robustness},
abstract = {Adversarial attacks on tabular data present unique challenges due to the heterogeneous nature of mixed categorical and numerical features. Unlike images where pixel perturbations maintain visual similarity, tabular data lacks intuitive similarity metrics, making it difficult to define imperceptible modifications. Additionally, traditional gradient-based methods prioritise ℓp-norm constraints, often producing adversarial examples that deviate from the original data distributions, making them detectable. To address this, we propose a latent-space perturbation framework using a mixed-input Variational Autoencoder (VAE) to generate statistically consistent adversarial examples. The proposed VAE integrates categorical embeddings and numerical features into a unified latent manifold, enabling perturbations that preserve statistical consistency. We introduce In-Distribution Success Rate (IDSR) to jointly evaluate attack effectiveness and distributional alignment. Evaluation across six publicly available datasets and three model architectures demonstrates that our method achieves substantially lower outlier rates and more consistent performance compared to traditional input-space attacks and other VAE-based methods adapted from image domain approaches, achieving substantially lower outlier rates and higher IDSR across six datasets and three model architectures. Our comprehensive analyses of hyperparameter sensitivity, sparsity control, and generative architecture demonstrate that the effectiveness of VAE-based attacks depends strongly on reconstruction quality and the availability of sufficient training data. When these conditions are met, the proposed framework achieves superior practical utility and stability compared with input-space methods. This work underscores the importance of maintaining on-manifold perturbations for generating realistic and robust adversarial examples in tabular domains.}
}
@article{YANG2026114258,
title = {LADNet: A wheat scab detection network based on lightweight architecture and logic-driven channel perception distillation},
journal = {Applied Soft Computing},
volume = {186},
pages = {114258},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114258},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015716},
author = {Zihao Yang and Wenxia Bao and Maomao Qin and Xianjun Yang and Linsheng Huang},
keywords = {Wheat scab, Deep learning, Object detection, Lightweight, Knowledge distillation},
abstract = {Wheat scab is a fungal disease caused by Fusarium species, severely affecting wheat yield and quality. Timely and accurate detection of wheat scab facilitates precise disease forecasting and the implementation of measures to improve yield. Using RGB images captured by drones can effectively improve the efficiency of wheat scab detection. However, the small size of scab regions and the complexity of field backgrounds present challenges for high-precision detection. Additionally, existing models have high computational requirements, making efficient deployment on embedded devices difficult. Therefore, this study proposes a Lightweight and Accurate Detection Network for wheat scab (LADNet). First, MobileNetv4s is designed to enhance feature extraction from lesion areas, reducing false detections caused by complex field backgrounds. Additionally, its efficient convolutional architecture is combined with the designed Convolutional Additive Self-Attention Encoder (CASE) to improve feature extraction and interaction efficiency, thereby increasing detection speed. Next, Real-time DETR (RT-DETR) is used as the teacher model, with LADNet serving as the student model, and the Logic-Driven Channel Perception Distillation (LCPD) is designed to further improve detection performance. Finally, extensive experiments conducted on both server and embedded platform demonstrate that LADNet strikes a good balance between accuracy and efficiency. While maintaining real-time performance, the detection results achieved a mAP value of 84.1, which is higher than other lightweight detection networks.}
}
@article{ZHANG2026114278,
title = {Advancing brain tumor segmentation in smart healthcare via T1-generated virtual multimodal MRI fusion},
journal = {Applied Soft Computing},
volume = {186},
pages = {114278},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114278},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015911},
author = {Youjian Zhang and Jie Wang and Xinquan Yang and Xinyuan Zhang and Abudoukeyoumujiang Abulizi and Hong Jiang and Guanqun Zhou and Haiming Liao and Gang Yu and Zhicheng Zhang},
keywords = {Brain tumor segmentation, Virtual multimodal, Generative AI, Diffusion models, Magnetic resonance},
abstract = {Precision segmentation of brain tumors is crucial for diagnosis, treatment, and prognosis in smart healthcare. While traditional single-modality methods have performance limitations, multimodal segmentation, though more accurate, increases patient scanning time and strains medical resources. This paper introduces a novel approach using a denoising diffusion probabilistic models to generate virtual T2, T1CE, and FLAIR images from single-modality T1, enhancing segmentation without additional scans. By concurrently training the generation and segmentation networks, we achieve realistic multimodal images and precise tumor segmentation. Experiments show our method significantly outperforms single-modality techniques and rivals real multimodal segmentation, reducing the need for multimodal images, optimizing resource use, and offering an alternative for patients unable to receive contrast enhancers.}
}
@article{DING2026114229,
title = {Effective improvement of large network robustness through insecure graph-based link protection: Erdos-renyi, scale-free and real-world networks},
journal = {Applied Soft Computing},
volume = {186},
pages = {114229},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114229},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501542X},
author = {Wei Ding and Zhengdan Wang},
keywords = {Robustness, Partitioning link, Insecure graph, Spanning tree, Traversal tree},
abstract = {The robustness of network can be enhanced by link protection, especially when topology adjustment is not feasible. However, due to the inherent difficulty, approximation algorithms introduce a significant number of additionally protected links. To address this issue, we introduce the concept of S-cut partitioning. We then prove that it can help reduce insecure graph connectivity to just S, thereby protecting fewer links. The insecure graph is extracted by the proposed algorithm, and a better solution is found by constructing trees. Subsequently, it is validated against existing methods in graphs of different scales. Compared to the optimal baseline which is only feasible in small Erdos-Renyi and scale-free graphs, the algorithm can protect exactly 100 % of node pairs, can run 105 times faster and requires only 3 % more cost. Compared to approximate methods in large-scale Erdos-Renyi, scale-free and real-world graphs, the algorithm can save nearly 60 % of the protection cost while maintaining stable and high protection accuracy.}
}
@article{NIU2026114250,
title = {Self-organized phase-locked component pair learning in motor imagery classification},
journal = {Applied Soft Computing},
volume = {186},
pages = {114250},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114250},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015637},
author = {Xu Niu and Na Lu and Huan Luo and Ruofan Yan},
keywords = {EEG, Motor imagery, Phase synchronization, Deep learning, End-to-end network},
abstract = {Phase synchronization measurements among electroencephalogram (EEG) channels and single-channel power spectrum characterize brain activities during motor imagery (MI) from different angles. Recently, end-to-end deep learning (DL) networks have achieved remarkable success by simultaneously optimizing preprocessing, power spectrum feature extraction, and classification procedures. However, no end-to-end network has utilized both phase synchrony measurement and power spectrum, which mutually contribute valuable and complementary information for MI classification. Extracting interpretable phase synchrony-based features such as phase locking value (PLV) through DL architecture is challenging due to the computational complexity. To tackle this challenge, we propose a transplantable convolution module called phase-to-amplitude transcoder to transform phase differences between pairs of signals into specialized amplitude representations, whose data distribution is sensitive to MI types. Preprocessing and pairing modules are designed to provide high-SNR signal pairs for this transcoder. Another convolution module is used for classification based on the data distribution. By integrating these modules, we constructed the first end-to-end classification network based on phase-locking information. Extensive experiments have demonstrated that our network outperforms state-of-the-art methods in classifying 1s-long MI samples. Signal pairs learned by the trained network exhibit high PLVs, confirming the transcoder’s effectiveness and the network’s capability to self-organize phase-locked component pairs (PLP). Notably, a certain signal pair extracted from the tongue MI samples of a subject is significantly phase-locked, with half of them exhibiting PLVs over 0.937. This high level of phase-locking has not been found in existing literature. Using DL to explore PLPs to investigate phase synchronization represents a promising research direction.}
}
@article{HE2026114177,
title = {A special point-guided surrogate-assisted multi-objective evolutionary algorithm for complex pareto fronts},
journal = {Applied Soft Computing},
volume = {186},
pages = {114177},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114177},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014905},
author = {Chunlin He and Yong Zhang and Dunwei Gong and Xianyan Sun and Hongfeng Wang},
keywords = {Expensive optimization, Multi-objective, Evolutionary algorithm, Surrogate model, Special point},
abstract = {Expensive multi-objective optimization problems (EMOPs) with complex Pareto fronts are widespread in engineering design applications. Existing surrogate-assisted evolutionary algorithms often neglect the decisive role of special points in shaping complex fronts, leading to relatively poor performance. To address this limitation, this paper proposes a special point-guided surrogate-assisted evolutionary algorithm. First, we develop an adaptive integrated method of global surrogate model based on non-dominance ranking to improve its prediction accuracy in key search regions. Second, we introduce two novel search strategies, i.e., the knee point-driven exploitation strategy using confidence intervals, and the discontinuous-point-driven exploration strategy with interval optimization, to effectively balance the global and local search capabilities of the algorithm, especially the search capability for the most discontinuous PF. Moreover, a new adaptive setting method of reference vector is designed to improve the utilization efficiency of individuals. Compared with nine existing state-of-the-art algorithms on 20 benchmark problems and two real-world applications, experimental results demonstrate that the proposed algorithm can obtain highly-competitive Pareto optimal solutions with less computational cost.}
}
@article{CHE2026114204,
title = {Chain-of-thought driven dynamic prompting and computation method},
journal = {Applied Soft Computing},
volume = {186},
pages = {114204},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114204},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015170},
author = {Xun Che and Mingao Chu and Yadang Chen and Huanhuan Gu and Qianmu Li},
keywords = {NLP, Chain-of-thought, Prompting optimization, Multi-step reasoning},
abstract = {With the continuous development of large language models (LLMs), their performance in multi-step reasoning tasks has become a focal point of research. Although Chain-of-Thought (CoT) methods have shown promise in enhancing the reasoning abilities of LLMs, they often rely on manually crafted prompts, limiting their scalability. Recent advances such as zero-shot CoT and automated CoT paradigms have alleviated some of these issues, but they still face limitations when dealing with complex computations, particularly tasks requiring multi-step and high-precision calculations. To address the existing issues, we propose the Chain-of-Thought Driven Dynamic Prompting and Computation Method (DPC-CoT), which adaptively integrates external computation modules (e.g., Python interpreters) to assist in the reasoning process of LLMs. Specifically, DPC-CoT clusters problems based on complexity and semantic similarity, selects representative problems for reasoning chain generation, and dynamically adjusts prompting strategies to guide the model in handling complex computational tasks. Experimental results demonstrate that DPC-CoT outperforms existing CoT methods across multiple publicly available datasets, achieving a 1 %-5 % improvement in accuracy. This method not only reduces errors in multi-step computations but also enhances the overall performance of LLMs in complex reasoning tasks, resulting in a promising solution for improving reasoning capabilities in natural language processing applications.}
}
@article{PRESANNAKUMAR2026114192,
title = {Enhancing environmental sound classification with weighted attention-based spectrogram fusion and overlapping pre-patching},
journal = {Applied Soft Computing},
volume = {186},
pages = {114192},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114192},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015054},
author = {Krishna Presannakumar and Anuj Mohamed},
keywords = {Signal processing, Environmental sound classification, Audio sound signal, Feature representation, Transformers, Deep learning},
abstract = {Environmental Sound Classification (ESC) remains challenging due to the diverse and overlapping acoustic characteristics of real-world environments. Traditional models relying on single-feature representations such as Mel spectrograms often fail to capture the full range of spectral and temporal details. This paper introduces a novel algorithm Weighted Attention-based Spectrogram Fusion (WASF) that adaptively integrates Mel spectrograms, Cochleograms, and Correlograms using a hierarchical attention mechanism across channel, temporal, and frequency dimensions. Compared to traditional fusion techniques, WASF uses a learnable attention mechanism to dynamically weight each feature’s importance over time and frequency, improving the model’s capacity to focus on important acoustic cues. In addition, an overlapping pre-patching strategy is proposed to preserve local temporal continuity, enhancing transformer-based modeling. Proposed model demonstrates superior performance with 95.71 % accuracy on UrbanSound8K, 93.97 % on ESC-50, and 94.91 % on ESC-10 datasets. Extensive ablation studies and interpretability analysis validate the effectiveness of each component, demonstrating robustness across diverse acoustic environments and noise conditions. The computational efficiency and interpretable attention patterns make our approach suitable for real-time deployment in smart city applications, surveillance systems, and assistive technologies.}
}
@article{GARCIAMORENO2026114195,
title = {Modelling time-series data generation with diffusion models for triaxial data},
journal = {Applied Soft Computing},
volume = {186},
pages = {114195},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114195},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501508X},
author = {Francisco M. Garcia-Moreno and Maria Jose Rodriguez-Fortiz and Payam Barnaghi and Maria Bermudez-Edo},
keywords = {Diffusion models, Time series, Synthetic data, Data generation, Time series generation},
abstract = {Recent advancements in diffusion models have demonstrated their capacity to generate high-quality synthetic images. However, their application to time-series data generation remains under-explored. We propose Diff-TSD, a novel method that leverages diffusion models and Modified Recurrence Plots to generate synthetic triaxial time-series data. By transforming raw signals into RGB image representations, we enable the application of image-based generative models for time-series data generation. In this framework, raw triaxial time-series data, such as accelerometer readings, are first transformed into trivariate recurrence plots that preserve the temporal correlation of the signals. These plots are treated as images, where each variate corresponds to an RGB channel, enabling the use of diffusion models traditionally designed for image synthesis. To evaluate the effectiveness of Diff-TSD, we conducted experiments using the WISDM benchmark dataset for human activity classification based on triaxial accelerometer data. The model, trained over 10,000 diffusion epochs, achieved an accuracy of 76.92±1 %, an F1-Score of 77.28±1 %, and exhibited stable performance from 5000 epochs onward. While the accuracy shows a 7.59 % difference compared to real data performance (84.51 %), Diff-TSD proves valuable for augmenting training datasets, particularly under conditions of data scarcity. Additionally, the optimal trade-off between computational cost and performance was identified at 5000 diffusion epochs, where the Xception classifier demonstrated the most consistent results. The proposed method contributes to the field of soft computing by leveraging diffusion models for synthetic time-series data generation, offering a robust solution for enhancing machine learning tasks in scenarios with limited data availability.}
}
@article{KRISHANKUMAR2026114216,
title = {Evaluating zero-carbon measures through a probabilistic hesitant fuzzy LOPCOW and WISP approach},
journal = {Applied Soft Computing},
volume = {186},
pages = {114216},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114216},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015297},
author = {Raghunathan Krishankumar and Fatih Ecer and Selçuk Korucuk and Ahmet Aytekin and Abhishek Yadav},
keywords = {Zero-carbon measure, Decarbonization, Climate change, Probabilistic hesitant fuzzy sets, Net-zero-carbon emissions, SDG13},
abstract = {Climate change is a pressing issue globally, and countries are implementing zero-carbon measures (ZCMs) to combat it. The ranking of such measures is essential, as it facilitates policymakers in preparing action plans for sustainability. As a variant of the hesitant fuzzy set (HFS), the probabilistic hesitant fuzzy set (PHFS) is utilized, which considers both hesitancy during rating and the associated confidence level for each value. Logarithmic percentage change-driven objective weighting (LOPCOW) and simple weighted sum product (WISP) are cutting-edge weighting and ranking methods for multi-criteria decision-making (MCDM), respectively. This study aims to rank ZCMs to achieve SDG13 via a novel integrated LOPCOW–WISP multi-criteria method with PHFSs. So far, there has been no work on developing LOPCOW and WISP methods under PHFSs, and no PHFS-driven research has evaluated ZCMs. Regarding the findings, "sustainable agriculture" is the foremost measure, followed by "research and innovation" and "decarbonizing industry." Sensitivity and comparison analyses are further conducted to realize the method's robustness. The findings can also help to shape the practical and future end-use vision for energy resources, allowing for significant advantages while incurring zero-carbon emissions costs. Policymakers can readily use this framework in logical decision-making processes. Furthermore, the study proposes an ideal measurement method that prioritizes technological, agricultural, and research and development factors, along with concerns like energy efficiency, to achieve the goal of zero-carbon emissions.}
}
@article{HWANG2026114186,
title = {Class-imbalanced gas thermal image detection in manufacturing using thermal region masking and density-based reweighting},
journal = {Applied Soft Computing},
volume = {186},
pages = {114186},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114186},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014991},
author = {Gahyun Hwang and Juhyun Kim and Jihyeok Choi and Geonhee Han and Gyeongho Kim and Sunghoon Lim},
keywords = {Class imbalance, Contrastive learning, Gas detection, Reweighting technique, Thermal image},
abstract = {Recently, research on data-driven gas detection has been actively conducted to ensure the safety of manufacturing processes efficiently. Still, there remain challenges in real-world gas detection applications due to a lack of labeled data and class imbalance. While a few works have addressed these challenges through sampling or cost-sensitive methods, the characteristics of gas thermal image data, such as high noise and low resolution, hinder the application of existing data-driven methods. Therefore, this work proposes a practical gas detection method suitable for thermal image data to overcome existing limitations. First, contrastive learning (CL) is applied to learn informative latent representations using unlabeled data, which are easily collected in automated manufacturing execution systems. Second, a novel data augmentation module suitable for CL with thermal images is proposed, which generates effective views by removing uninformative backgrounds. Third, a reweighting technique is proposed to address class imbalance, utilizing a density estimation module that leverages latent representations obtained through CL. The effectiveness of the proposed method is validated on both the gas thermal image and the GasVid datasets. Compared to baseline ResNet models, the proposed method improves accuracy by 7.1 % and 6.4 % on the respective datasets. In addition, the proposed method outperforms SimCLR by 3.5 % and 3.3 %. The proposed method’s ability to operate without extensive labeling and adaptability to variable input conditions makes it suitable for real-world deployment. In particular, the proposed method shows potential for scalable integration into industrial systems, enabling timely detection of gas leaks and equipment damage, thereby ensuring workers’ safety.}
}
@article{WANG2026114231,
title = {Three-way group consensus based on fuzzy social networks under probabilistic linguistic preference relations},
journal = {Applied Soft Computing},
volume = {186},
pages = {114231},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114231},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015443},
author = {Yu Wang and Jianming Zhan and Zeshui Xu and José Carlos R. Alcantud},
keywords = {Three-way decision, Consensus reaching process, Fuzzy preference relation, Fuzzy social network},
abstract = {The advancement of technology and the rapid developments in the field of artificial intelligence have led to a surge in the research on decision-making in uncertain environments. Furthermore, individual decision-making is too simplistic to solve the complex decision-making problems posed by these challenges, leading to study group decision-making (GDM). Particularly, fuzzy social networks (FSNs) and fuzzy preference relations (FPRs) have important applications in GDM. In addition, probabilistic linguistic term sets (PLTSs) have succeeded as a bridge among natural language, fuzzy reasoning, and probability theory. However, the existing research on GDM under PLTSs faces three key challenges: flaws in PLTSs distance measurement, lack of FSN modeling, and the over-simplified feedback mechanism. These challenges severely impede the effectiveness and reliability of consensus reaching process (CRP) in complex decision-making scenarios. Motivated by these facts, this paper designs a three-way group consensus method based on FSNs under probabilistic linguistic preference relations (PLPRs), namely, the TWD-FSN-PLPR method. This method consists of three successive parts. The first part is the design of an improved consistency method based on the properties of PLTSs. Its main purpose is to ensure that the information on evaluations provided by the decision makers (DMs) maintains internal consistency, paving the way for subsequent GDM. The goal of the second part is to compute the DMs’ weights. Their own familiarity with the PLTS’s cross-entropy and self-confidence are used to construct a directed weighted FSN and then produce the weights from a metric based on social influence. The third part is the consensus reaching process, whose efficiency is improved by a combination of three-way decision and minimum cost, and implementing a penalty mechanism for non-cooperative DMs. In addition, the optimal alternative is selected using regret theory. The methodology is applied to a real case and compared with multiple methods to illustrate its rationality and superiority.}
}
@article{ZHANG2026114283,
title = {State of charge prediction for lithium-ion batteries in electric aircraft based on self-supervised informer},
journal = {Applied Soft Computing},
volume = {186},
pages = {114283},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114283},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015960},
author = {Wei Zhang and Hongshen Hao and Yewei Zhang and Huixin Yang and Xiang Li},
keywords = {Lithium-ion battery, State of charge, Deep learning, Informer neural network, Self-supervised learning},
abstract = {Lithium-ion batteries, as critical energy storage devices, play a vital role in electric aircraft, which represent a promising and low-carbon mode of transportation for the future. Accurate prediction of the state of charge of lithium-ion batteries is crucial for reducing the probability of accidents and ensuring flight safety. This paper proposes a novel intelligent method for state of charge prediction with a self-supervised Informer network. The method first reconstructs the data using interpolation fitting. In this way, features are extracted to mitigate noise generated during the battery data acquisition process. Negative samples are created by shuffling the time order of normal samples. Then, the self-supervised Informer network is employed. That explores state of charge data of electric aircraft batteries with both positive and negative samples. This approach enables accurate classification of positive and negative samples and precise state of charge prediction. Experiments are conducted using real-world flight data from new energy electric aircraft. Results show that the proposed method achieves low prediction errors and high accuracy under various conditions. That indicates the proposed method is well suited for industrial applications.}
}
@article{RANI2026114292,
title = {A multi-scale and multi-transform-based lightweight U-Net model for Brain Tumor Segmentation with enhanced spatial information},
journal = {Applied Soft Computing},
volume = {186},
pages = {114292},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114292},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016059},
author = {Rama Rani and Chandan Singh and Sukhjeet Kaur Ranade},
keywords = {Brain tumor segmentation, Spectral domain, Discrete Cosine Transform, Discrete Wavelet Transform, Guided decoder, Deep convolutional neural networks},
abstract = {Malignant brain tumors require fast, accurate segmentation for effective diagnosis and treatment planning. While CNN-based methods show promise, they struggle with tumor heterogeneity, low contrast, class imbalance, and loss of spatial and boundary information. We propose MMLU-Net, a multi-scale and multi-transform-based lightweight model to enhance spatial and contextual information. MMLU-Net employs an encoder-decoder architecture that integrates both spatial and frequency transform domains for robust multi-resolution analysis. Specifically, we fuse spatial-domain features with discrete cosine transform (DCT)-based representations, improving the model’s ability to capture global contextual cues while enhancing saliency across scales. To further refine boundary detection, we introduce a discrete wavelet-guided channel attention block (DWGCAB) into skip connections. This module brings spatial-spectral guidance that sharpens edge representation and improves boundary segmentation. Additionally, a learnable weighted global average pooling (LW-GAP) module is incorporated to dynamically recalibrate channel importance, allowing the model to better focus on relevant tumor regions. To strengthen deep feature learning and generalization, we apply a spatio-frequency-guided decoder with deep supervision. Finally, weighted loss functions are employed to address class imbalance, ensuring the model achieves high accuracy across all tumor sub-regions while maintaining computational efficiency. The proposed MMLU-Net is evaluated on three publicly available datasets, BraTS2018, BraTS2019, and BraTS2020. The experimental results demonstrate that the proposed network outperforms the existing state-of-the-art methods in terms of DSC, IoU, senstivity, precision, and HD95 performance metrics. The proposed network demonstrates the effectiveness of a spatio-frequency mechanism for improving tumor sub-region detection by fusing spectral and spatial features while minimizing time and space complexity.}
}
@article{WANG2026114203,
title = {BGSemi-flow: Adaptive Bayesian GMM-based semi-supervised learning framework for airfoil flow field prediction},
journal = {Applied Soft Computing},
volume = {186},
pages = {114203},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114203},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015169},
author = {Xiao Wang and Delanyo Kwame Bensah Kulevome and Guanxiong Li and Na Li and Dongfeng Yuan},
keywords = {Semi-supervised learning, Airfoil flow field prediction, Bayesian Gaussian mixture model, Data driven},
abstract = {Deep learning has gained significant attention in aircraft design for airfoil flow field prediction. However, high-dimensional flow field data with complex correlations pose challenges, especially with limited labeled data. This paper introduces BGSemi-Flow, a Bayesian Gaussian mixture model for airfoil flow field prediction. BGSemi-Flow leverages a Dirichlet process prior. The proposed method autonomously identifies different clusters in pseudo-labeled data. It distinguishes between easy and hard samples based on loss values without predefined thresholds. This adaptively mitigates noise interference during semi-supervised training. BGSemi-Flow combines data loss with auxiliary physical supervision to ensure results adhere to physical properties and data constraints. In the data partition process, easy samples shared by both models are selected as supplementary training data. It avoids the impact of noisy samples on training. Several rounds of warm-up training are conducted on labeled samples during the training process. Afterward, filtered easy samples are gradually added to complete training. Validation results show that BGSemi-Flow outperforms models from related works, reducing data acquisition time by nearly 60 %. The effectiveness of BGSemi-Flow is validated through qualitative results and ablation studies. This method provides a promising solution for flow field prediction, minimizing the need for extensive labeled data.}
}
@article{ZHIHUI2026114255,
title = {A sustainable urban optimization framework driven by a large language model based on multi-party trusted collaboration},
journal = {Applied Soft Computing},
volume = {186},
pages = {114255},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114255},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015686},
author = {Wu Zhihui and Chu Jinzhao and Xiao Yang and Sachin Kumar and Feng Jie and Jimmy {Ming-Tai Wu} and Pei Qingqi},
keywords = {Sustainable cities, Large language models, Multi-party trusted collaboration, Verifiable computing, Multi-party homomorphic encryption},
abstract = {Multi-party data fusion and cross-institutional collaboration can empower large language models (LLMs) to unlock their full potential in sustainable urban data analytics. However, this approach faces critical challenges, including data privacy concerns and a lack of trust among stakeholders. While homomorphic encryption addresses privacy preservation by enabling computations on encrypted data, its inherent cryptographic properties hinder public verification of both the computation process and results, thereby exacerbating trust deficits between collaborating parties and data consumers. To tackle these issues, this paper proposes a large language model-driven urban optimization framework based on multi-party trusted collaboration, which enhances trust in weakly trusted environments and improves LLM performance in urban decision-making. Our framework introduces a publicly verifiable computation protocol based on multi-party homomorphic encryption, which can verify the correctness of ciphertext-based computations while protecting data privacy. This protocol ensures transparent validation of both computational workflows and outputs, establishing trust in multi-party interactions without exposing sensitive information. After completing the joint computation, the encrypted parameter set is decrypted and converted into structured descriptive text using predefined templates, which serves as input to LLMs for urban scenario analysis. Judging from the experimental results, compared to a single data source, the RMSE of this scheme is reduced by 66.25%, indicating that this scheme can effectively improve the prediction accuracy of LLMs. In addition, this scheme can realize efficient and reliable verification of the process and results of multi-party homomorphic encryption calculations under weak trust environment, solving the problem of security verification of multi-party collaboration in a weak trust environment.}
}
@article{CAO2026114223,
title = {Graph variational autoencoder with affinity propagation for community-aware anomaly detection in attributed networks},
journal = {Applied Soft Computing},
volume = {186},
pages = {114223},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114223},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015364},
author = {Zhijie Cao and Chengkun Yang and Xiaoqing Fan and Lingjie Li and Qiuzhen Lin and Jianqiang Li and Lijia Ma},
keywords = {Anomaly detection, Attributed network, Community detection, Graph variational autoencoder, Affinity propagation},
abstract = {Anomaly detection in attributed networks (ADAN) aims to identify abnormal nodes that exhibit unexpected link structures and attributes compared to the others. The existing works primarily utilize the node representations learned from the low-level attributes and link structures of nodes to detect abnormal nodes, which overlook the impact of high-level community structures on ADAN. To address this issue, this paper proposes a novel framework called Graph Variational Autoencoder with Affinity Propagation (GVE-AP) for community-aware ADAN. GVE-AP first employs a graph convolutional variational autoencoder to learn node embeddings from attributed networks. Then, it integrates an affinity propagation algorithm for community division, which jointly considers both node attributes and link structures. Subsequently, it introduces a novel community-aware anomaly score to detect abnormal nodes by measuring dissimilarity with their communities based on robust features extracted via principal component analysis. Experimental results on eight real-world datasets demonstrate that GVE-AP outperforms the state-of-the-art methods for anomaly detection in attributed networks in terms of AUC and robustness.}
}
@article{CAO2026114207,
title = {High-resolution subspace neural network approach for solving the singular perturbed boundary layer problem},
journal = {Applied Soft Computing},
volume = {186},
pages = {114207},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114207},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015200},
author = {Fujun Cao and Yucheng Yue and Fanghua Pei and Baorui Yuan and Yongbin Ge and Zhiqiang Sheng},
keywords = {Singular perturbed problems, Physics-informed neural networks, Basis functions, Subspace neural network},
abstract = {Deep learning has created new possibilities for solving PDEs, leading to significant advancements. Nevertheless, accuracy is still a substantial challenge, especially when dealing with boundary layer problems that exhibit steep gradients. Thus, this study presents the parameter asymptotic subspace neural network method (PASNN). By integrating deep learning with traditional approaches, PASNN effectively addresses the challenging problem of singularly perturbed equations with boundary layers substantially enhancing solution accuracy without requiring prior information about the boundary layers. Specifically, the basis function is trained by optimizing the loss function of the PINN. A parametric asymptotic transfer learning strategy is employed to enhance the approximation capabilities of the subspace to the space of the solution. Then, the numerical solutions are obtained by constraining them to satisfy the governing equations and boundary conditions. Numerical examples demonstrate that the proposed PASNN method effectively addresses the singular perturbed problem with large gradients, achieving errors below 10−6, significantly outperforming both the PINN and SNN methods in terms of accuracy.}
}
@article{CHOI2026114226,
title = {GCNs meet long-tail: Embedding norm bias in GCN-based recommendations},
journal = {Applied Soft Computing},
volume = {186},
pages = {114226},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114226},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501539X},
author = {Yeo Jun Choi and Woo-Seong Yun and Chanwoo Jeong and Yoon-Sik Cho},
keywords = {Recommender systems, Collaborative filtering, Graph convolutional networks, Long-tail distribution},
abstract = {Graph Convolutional Networks (GCNs) have substantially advanced recommender systems by effectively modeling high-order user-item interactions. However, GCNs exhibit critical limitations when applied to recommendation datasets with typical long-tail distributions, where they tend to amplify existing popularity bias through message-passing mechanisms. To address this challenge, we propose Debiasing with Norm Adjustment (DNA), a simple yet effective method designed to mitigate degree-based embedding disparities in GCN-based models. DNA normalizes only item embeddings to suppress popularity-induced magnitude differences while preserving valuable user-specific information. Furthermore, DNA introduces a learnable item-specific bias term to restore debiased popularity signals. Notably, the bias term is trained independently of the GCN framework, enabling the model to learn debiased representations without inheriting message-passing artifacts. Our extensive experiments show that DNA improves both the recommendation frequency and performance for low-degree items, as well as overall recommendation quality. In addition, DNA can be integrated into existing graph convolution architectures in a plug-and-play manner, without requiring structural modifications to the underlying models. The code for DNA is available at https://github.com/Chanwoo-Jeong-2000/DNA.}
}
@article{LUO2026114247,
title = {A multi-threaded federated learning framework for reducing communication epochs},
journal = {Applied Soft Computing},
volume = {186},
pages = {114247},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114247},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015601},
author = {Chang-Yin Luo and Shuo Tian and Feng-Jun Li and Xue-Bin Chen and Qi Dai and Jian-Qiang Liu},
keywords = {Federated learning, Model soup, Partial sharing, Weight alignment, Euclidean distance},
abstract = {Federated Learning (FL) is a distributed architecture where multiple clients collaborate to solve machine learning problems under the coordination of a central aggregator. Traditional federated learning algorithms are severely affected by the problem of non-independent and identically distributed (non-IID) data, such as data heterogeneity. When the data distribution of a client differs from that of other clients, each client tends to converge on a locally sharp optimal solution. This leads the server to obtain a suboptimal result when aggregating these local models. Consequently, the federated learning algorithm requires a longer training cycle to converge when training a general global model, creating a conflict between training costs and benefits, and reducing other clients’ willingness to participate in the training process. Inspired by the concept of a flat solution space, we propose a multi-threaded federated generalization model soup algorithm (FedGMS), which aims to improve communication efficiency. This algorithm adopts a shared training trajectory approach to help local models achieve a flat solution space, thereby effectively enhancing the linear connectivity of local models during aggregation. Additionally, it employs a weight alignment method to align the fully connected layers of thread models, increasing the probability that clients’ solutions fall into the same loss basin. Simulation results show that when the local model achieves a flat solution, compared with the traditional single-threaded optimized communication efficiency baseline algorithm and multi-threaded baseline algorithm, the global model’s accuracy increases by 0.98–14.99 % under various non-iid environments (the accuracy improvement of the model obtained by optimizing different hyperparameters varies), and at the same time, its communication efficiency is improved by 2.35–6.17 times.}
}
@article{FAN2026114219,
title = {An adaptive ant colony algorithm for urban-rural collaborative electric vehicle routing problem},
journal = {Applied Soft Computing},
volume = {186},
pages = {114219},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114219},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015327},
author = {Lijun Fan and Changshi Liu and Bo Dai and Junyu Li and Yuxuan Zhang and Ruiyou Zhang},
keywords = {Urban-rural logistics collaboration, Electric vehicle routing problem, Microgrid renewable energy charging station, Sustainable transport, Adaptive ant colony algorithm},
abstract = {In a landscape where China’s rural e-commerce thrives, the freight flows between urban and rural areas increasingly intensify. Addressing the current “urban-strong, rural-weak” logistics dilemma and achieving synergistic development of urban-rural logistics has become a pivotal challenge for the nation’s logistics industry. This study proposes a novel urban-rural collaborative electric vehicle routing problem considering differences in charging carbon emissions to minimize both economic costs and environmental impacts of the transport fleet. A mixed-integer programming model is constructed, integrating rural and urban customer interconnections, Microgrid Renewable Energy Charging Stations (MRECSs), a multi-depot semi-open service mode, and metrics for Electric Vehicle (EV) energy consumption and carbon emissions. An adaptive ant colony algorithm is designed to elevate model-solving efficacy. Numerical experiments validate the model’s superiority, showing that joint urban-rural EV distribution is sustainable and cost-effective. The proposed direct urban delivery model significantly outperforms centralized redistribution, improving average economic and environmental benefits by 15.11 % and 31.32 %, respectively. The findings emphasize strategic deployment of MRECS locations and quantities and close cooperation among depots, contributing to bridging the urban-rural logistics gap.}
}
@article{CHAUHAN2026114271,
title = {A multi-learning-based artificial electric field optimization algorithm with two mutations and 2D histogram for multi-level image segmentation},
journal = {Applied Soft Computing},
volume = {186},
pages = {114271},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114271},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015844},
author = {Dikshit Chauhan},
keywords = {Meta-heuristic algorithms, Optimization, Multiple learning, Mutation, Image processing},
abstract = {Multilevel thresholding is a fundamental technique in image segmentation, yet traditional entropy-based methods such as Otsu’s, Rényi’s, and Kapur’s become computationally intensive as the number of thresholds increases. To address this challenge, we propose a physics-inspired optimization algorithm that integrates heterogeneous learning strategies to improve search efficiency and segmentation accuracy. The population is divided into two groups: one employing a hybrid of dynamic multi-swarm and dynamic learning strategies with non-uniform mutation and adaptive parameter control to promote exploration, and the other using a modified comprehensive learning mechanism to enhance exploitation. Group-specific interaction rules are designed to balance global and local search dynamics. Additionally, a thorough component-wise ablation and parameter sensitivity analysis is performed to evaluate the individual contributions of each strategy and hyperparameter setting. The proposed algorithm is evaluated on the CEC 2017 benchmark functions at 30, 50, and 100 dimensions and the Berkeley Segmentation Dataset (BSDS300) using Otsu, Kapur, and Rényi entropy-based segmentation. Quantitative and qualitative comparisons are conducted using twelve performance metrics and 2D histogram-based techniques such as non-local means. Experimental results show that the proposed approach consistently outperforms state-of-the-art algorithms in both segmentation quality and computational efficiency, demonstrating its robustness and effectiveness for complex multilevel image segmentation tasks. The source code of TL-AEFA will be available at https://github.com/ChauhanDikshit.}
}
@article{DING2026114158,
title = {A cascade clustering-based two-stage evolutionary algorithm for large-scale multimodal multi-objective optimisation},
journal = {Applied Soft Computing},
volume = {186},
pages = {114158},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114158},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014711},
author = {Zhuanlian Ding and Xi Hu and Dengdi Sun and Xingyi Zhang},
keywords = {Multimodal multi-objective optimisation, Large-scale optimisation, Sparse Pareto optimal solutions, Cascade clustering, Two-stage optimisation},
abstract = {Multimodal multi-objective evolutionary algorithms (MMEAs) tailored for multimodal multi-objective optimisation problems (MMOPs) have achieved considerable advancements in recent years. However, the adaptation of MMEAs to large-scale MMOPs with sparse Pareto optimal solutions and the attainment of all equivalent Pareto optimal solution sets (PSs) remain challenging mainly due to the obstacles of the dimensionality curse, the unknown multimodality and the unknown sparsity. Therefore, this study proposes a cascade clustering-based two-stage evolutionary algorithm to address these issues. In particular, this study employs a cascade clustering technique to distinguish distinct PSs accurately from current subpopulations. Simultaneously, a two-stage optimisation approach determined by cascade clustering is adopted to meticulously uphold multimodality detection and ensure accurate unimodal evolution. Moreover, a balanced evolution strategy is incorporated into the two-stage evolutionary process to promote the independent accurate evolution of each modality and achieve the evolutionary balance among different modalities. Furthermore, the scores of the decision variables updated by local guidance vectors are used to guide the generation of subpopulations for facilitating convergence in their respective search directions. Compared with six state-of-the-art multimodal algorithms, the proposed method achieves the first rank across all SMMOP test suites in terms of IGDX, while significantly outperforming competitors on the majority of SMMOP test suites in both IGD and HV indicators.}
}
@article{XIA2026114187,
title = {Fuzzy granule distance-guided monotonic sequential three-way approximations for multi-label fuzzy concepts},
journal = {Applied Soft Computing},
volume = {186},
pages = {114187},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114187},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015005},
author = {Deyou Xia and Guoyin Wang and Qinghua Zhang and Man Gao and Zhixuan Deng and Shuai Li},
keywords = {Three-way approximations, Multi-label fuzzy concepts, Monotonic, Sequential, Fuzzy granule distance, Feature selection},
abstract = {Three-way approximations are capable of segmenting samples into three distinct regions (positive, boundary, and negative regions) with minimum uncertainty loss. However, they are unable to measure the uncertainty of multi-label fuzzy concepts, nor is the monotonicity of the three regions often considered in sequential fuzzy multi-granularity spaces. Motivated by this, Monotonic Sequential Three-Way Approximations (MSTWA) model via fuzzy granule distance is conceived to measure the uncertainty of multi-label fuzzy concepts. First, a parameterized fuzzy granule distance is proposed to evaluate the inconsistency caused by the interaction between features and multi-label fuzziness. Subsequently, the MSTWA model via the proposed fuzzy granule distance is constructed to represent the variation of the three regions in sequential fuzzy multi-granularity spaces. It is theoretically proven that the number of samples in the three regions changes monotonically with the subdivision of fuzzy granules. To demonstrate the practical utility of MSTWA model, an evaluation function composed of the positive region is implemented for feature selection via feature multi-correlations. Finally, nine real-world label distribution datasets selected from biological field to validate the monotonicity of the three regions and the effectiveness of our proposed algorithm. Statistical analysis reveals no significant difference between the proposed method and representative feature selection algorithms using fuzzy rough sets, while consistently enhancing raw data performance in different evaluation indicators.}
}
@article{ZHU2026114211,
title = {Cross-age crash risk analysis with high-dimensional small-sample data: An approach integrating feature augmentation and two-layer stacking},
journal = {Applied Soft Computing},
volume = {186},
pages = {114211},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114211},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015248},
author = {Leipeng Zhu and Zhiqing Zhang and Jingyang Yu and Hongjia Wang},
keywords = {Driver age, Crash prediction, High-dimensional small-sample, Feature augmentation, Two-layer stacking},
abstract = {Investigating the coupling mechanisms of crash-contributing factors across different driver age groups and predicting the associated risks are crucial for enhancing road safety. However, the high-dimensional small-sample characteristics of crash data complicate the analysis of these mechanisms and lead to substantial variations in the predictive accuracy of existing crash models across age groups. We developed a feature augmentation algorithm specifically designed for crash data, which integrates feature interpretation and fusion strategies to address its high-dimensional small-sample characteristics. Furthermore, incorporating this feature augmentation, we optimized a two-layer stacking algorithm to elucidate the coupling differences among contributing factors while achieving better predictive performance. Model estimation results demonstrate that: a) The temporal distribution of crashes differs significantly across age groups, whereas the spatial agglomeration pattern remains largely consistent. b) The same crash-contributing factor affects drivers of different ages in distinct ways, and the coupling mechanisms of these factors differ across age groups. c) The optimized two-layer stacking algorithm, which ensembles heterogeneous learners, effectively mitigates the low prediction accuracy of fatal crashes observed in existing models and delivers stable performance across age groups (Precisionoverall, Recalloverall = 0.81). d) By constructing a feature augmentation algorithm that integrates strongly coupled contributing factors, we achieved satisfactory and consistent predictive accuracy using a two-layer stacking algorithm on crashes involving drivers of different age groups (Precisionoverall, Recalloverall = 0.90; area under the receiver operating characteristic curve (AUC)overall = 0.97). These findings offer methodological guidance for analyzing high-dimensional small-sample crash data and enhancing the reliability and accuracy of crash risk prediction across different age groups.}
}
@article{FAN2026114263,
title = {Addressing environmental challenges in blasting: A dual-method data generation framework for peak particle velocity prediction},
journal = {Applied Soft Computing},
volume = {186},
pages = {114263},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114263},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015765},
author = {Haiping Fan and Jian Xu and Danial Jahed Armaghani},
keywords = {Tunnel rock excavation, Blasting vibration, PPV, Empirical formula, Deep generative model},
abstract = {The monitoring of peak particle velocity (PPV) during tunneling addresses the pressing environmental challenge of blast-induced ground vibrations, a significant concern for project managers and stakeholders as excessive PPV can jeopardize structural stability. Accurate PPV prediction is therefore central to sustainable engineering practices and responsible resource management. Soft computing methodologies, particularly machine learning, are now regarded as an effective method to predict and control PPV. However, these models are data-hungry and perform poorly when data availability is limited. This study tackles this challenge by proposing a dual-method data generation framework to augment the original PPV data. The first strategy is empirically generated data, which leverages the United States Bureau of Mines (USBM) formula to produce synthetic PPV values based on sampled distributions of key blasting parameters. The second, a core soft computing strategy, uses a deep learning-based model, the Tabular Variational Autoencoder (TVAE), to learn complex patterns and relationships within the original dataset to generate realistic synthetic PPV data. By integrating these two strategies, robust and diverse augmented datasets are acquired to develop and enhance soft computing PPV prediction models. The findings show that the augmented datasets significantly improve the predictive performance of various machine learning models compared to models trained solely on raw data. Applying augmented datasets not only combines the physical insights of empirical models but also the flexibility of deep learning techniques. This study highlights the potential of combining empirical and generative techniques to address data scarcity challenges in blasting vibration prediction and provides a robust framework that enhances multi-criteria decision-making for engineers.}
}
@article{GUPTA2026114185,
title = {Integrating clustering with LSTM diffusion for video anomaly detection},
journal = {Applied Soft Computing},
volume = {186},
pages = {114185},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114185},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501498X},
author = {Anil Kumar Gupta and Rupak Sharma and Rudra Pratap Ojha},
keywords = {Deep Learning, Long Short-Term Memory, Support Value, Fuzzy C-Means Clustering, Deep Neural Network},
abstract = {Automatic anomaly detection is very important in smart video surveillance because it helps identify unusual events or actions that do not match normal behavior. This study presents a new approach called Color Histo-Sigmoid Fuzzy C-Means (CHSFCM) as the main idea to improve the accuracy of object separation and background modeling. The method has three steps: first, it uses CHSFCM for pre-processing and segmentation to better understand the background. Second, it uses a Deep Neural Network (DNN) to extract features. Third, it uses a Support-based Long Short-Term Memory (SLSTM) network to tell the difference between normal and unusual events. By combining the strong ability to separate different parts of data from CHSFCM with the time-learning power of SLSTM, the system performs very well, achieving an accuracy of 96.25 %, which is better than other methods. This approach gives a reliable and strong way to spot unusual events in real-time video monitoring.}
}
@article{YU2026114251,
title = {Optimizing islanded microgrid scheduling with reinforcement learning enhanced multi-strategy cuckoo search algorithm},
journal = {Applied Soft Computing},
volume = {186},
pages = {114251},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114251},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015649},
author = {Xiaobing Yu and Pingping Xu and Xuming Wang and Wen Zhang},
keywords = {Microgrid, Scheduling, Reinforcement learning, Cuckoo search algorithm},
abstract = {A microgrid is a small power generation and distribution system, consisting of distributed generators (DGs), energy storage, loads, monitoring and protection devices. The microgrid scheduling optimization problem must first be conducted under the prerequisites of satisfying supply-demand balance, equipment operational constraints, and system stability requirements. Secondly, by rationally scheduling the operating states of DGs, energy storage systems, and loads, it aims to achieve the lowest total cost and the highest energy utilization efficiency. However, these systems face significant challenges from the uncertainty and volatility of power supply and demand, making their optimal scheduling a critical issue. Traditional optimization methods often struggle to effectively address these challenges. To solve this problem, this study proposes a multi-strategy cuckoo search algorithm combined with reinforcement learning (RLMCS), designed to optimize microgrid scheduling. The proposed method integrates the self-learning and adaptive capabilities of reinforcement learning (RL) with a multi-strategy mechanism. Specifically, RL technology dynamically adjusts the search strategies and key parameters of the cuckoo search (CS) algorithm based on the real-time operating state of the microgrid. This adjustment significantly enhances the algorithm's global optimization capability and convergence efficiency in complex dynamic environments. Therefore, this synergistic mechanism enables RLMCS to more effectively explore the solution space, thereby quickly identifying and determining the optimal scheduling plan for complex and variable microgrids. RLMCS is experimentally applied to a 15-minute and a 24-hour scheduling problem and compared with several optimization algorithms. The results demonstrate that RLMCS achieves the lowest total generation cost, outperforming the best comparison algorithm by 0.78 % and 0.93 % for the two scheduling problems, respectively. This highlights its superior optimization efficiency and more cost-effective scheduling performance across different time scales.}
}
@article{KHOSRAVI2026114274,
title = {A telemedicine-oriented framework for scenario-based disaster management: Integrating machine learning and multi-criteria decision making},
journal = {Applied Soft Computing},
volume = {186},
pages = {114274},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114274},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501587X},
author = {Reyhane Khosravi and Masoud Rabbani},
keywords = {Telemedicine, Disaster management, Emergency medical response, Machine learning, Multi-criteria decision-making, Humanitarian logistics, Mathematical optimization},
abstract = {Natural disasters such as earthquakes pose significant challenges to emergency response systems, particularly in regions with limited infrastructure and time-critical medical needs. This study introduces an intelligent and integrated approach to disaster management that combines Machine Learning (ML), Multi-Criteria Decision-Making (MCDM), mathematical optimization, and telemedicine to enhance medical response during crises. The proposed framework predicts the severity and priority of injuries using ML algorithms, prioritizes affected regions via MCDM techniques, and deploys healthcare resources—including field hospitals and telemedicine operators—through a cost-effective mathematical model. To validate the effectiveness of the proposed framework, a real-world case study was conducted based on a 5.9-magnitude earthquake that struck northwestern Iran in November 2019, causing extensive damage and numerous injuries. The developed system successfully analyzed the affected regions, prioritized urgent needs, and strategically allocated medical resources, demonstrating its practical applicability in real disaster scenarios. This study offers a flexible and scalable solution for humanitarian logistics and emergency medicine, leveraging Artificial Intelligence (AI)-driven tools to support rapid, informed decision-making. The proposed system provides critical insights for policymakers and practitioners aiming to build more resilient and adaptive disaster response strategies in both developing and developed contexts.}
}
@article{LIN2026114267,
title = {A machine learning-based algorithm for estimating river surface water velocity},
journal = {Applied Soft Computing},
volume = {186},
pages = {114267},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114267},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015807},
author = {Feng Lin and Changhao Song and Shiwu Wang and Aiju You and Ziming Wang},
keywords = {Water velocity measurement, Machine vision, Deep learning, YOLO, Ray-casting Algorithm},
abstract = {Surface water flow velocity measurement in rivers is crucial for flood prediction and sustainable development. Traditional contact measurement methods are susceptible to issues like water aeration and sensor placement. This study presents a non-contact intelligent machine vision algorithm for estimating water flow velocity by monitoring floating objects on the river's surface. The algorithm integrates video stream processing, floating objects detection, and water flow velocity estimation. Video stream processing involves reference object segmentation, effective speed measurement zone selection, and width calculation using the YOLOv10n network. Floating objects detection employs an improved ST-YOLO network, ensuring precise detection of small targets, achieving superior detection accuracy with mAP50 at 89.5 % and mAP50–95 at 65.7 %. Water flow velocity estimation utilizes the Ray-casting Algorithm to identify floating objects within any shaped effective zone and employs multi-objective tracking and weighted calculation for accurate velocity determination. Comparative experiments with contact measurement methods confirm the high accuracy of this approach. By eliminating the necessity for specialized flow measurement equipment in direct contact with river water and relying solely on a general camera for quantitative surface water velocity estimation, this cost-effective method could emerge as a convenient and reliable alternative. Furthermore, the algorithm incorporates multi-point weighting within the effective video range to counteract biases from single-point measurements, showcasing significant advantages in applicability and accuracy, making it particularly valuable for water velocity analysis.}
}
@article{HUANG2026114178,
title = {Rime algorithm with partial reinforcement and edge strategies for lupus nephritis image segmentation},
journal = {Applied Soft Computing},
volume = {186},
pages = {114178},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114178},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014917},
author = {Jinpeng Huang and Ali Asghar Heidari and Lei Liu and Qike Shao and Huiling Chen and Xiaowei Chen},
keywords = {Rime optimization algorithm, Metaheuristic algorithm, Multi-threshold image segmentation, Lupus nephritis},
abstract = {Lupus nephritis (LN) is a serious complication of systemic lupus erythematosus characterized by inflammation and damage to the kidneys, potentially leading to kidney failure. To augment the diagnosis process of LN, innovative minds in the field have intertwined LN imaging with metaheuristic algorithms, thereby effectuating multi-threshold image segmentation (MTIS), and subsequently facilitating a more precise classification of LN. The rime optimization algorithm (RIME) is a physical phenomenon based metaheuristic algorithm. In this work, to enhance RIME's efficiency in MTIS on LN images, the key processes from the partial reinforcement optimizer (PRO) have been integrated into RIME. This integration markedly enhances RIME's convergence precision and speed. In addition, the edge information utilization strategy (EIU) was proposed to improve the diversity of the population. The enhanced RIME (HRIME) has been compared with a series of state-of-the-art algorithms in the IEEE CEC 2017 benchmark functions, demonstrating superior performance. Further testing on three realistic engineering design optimization problems demonstrated the potential of HRIME to address practical challenges. Moreover, the Berkeley segmentation dataset 500 was used to evaluate the efficacy of HRIME for MTIS, and the segmentation method adopted a segmentation technique combining non-local means 2D histogram with Renyi’s entropy. Finally, HRIME was applied to LN image segmentation and the experimental outcomes confirmed that HRIME effectively improved the performance of RIME in LN image MTIS.}
}