@article{GUO2026115146,
title = {Label-aspect-conditioned diffusion model for SAR image generation and imbalanced target recognition},
journal = {Applied Soft Computing},
volume = {197},
pages = {115146},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115146},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005946},
author = {Shuai Guo and Ting Chen and Penghui Wang and Hongwei Liu and Wenchao Chen and Junkun Yan},
keywords = {SAR image generation, Conditional controlled transformer encoder, Label-aspect-conditioned diffusion model, Imbalanced dataset, SAR automatic target recognition},
abstract = {Synthetic aperture radar (SAR) is an active detection system integral to automatic target recognition (ATR). The unique scattering and geometric features of SAR images are highly sensitive to target aspect angles. Traditional SAR ATR methods generally assume that the dataset is balanced, meaning that the various types of targets have full target aspect coverage. However, when the aspect angles are incomplete, the recognition performance significantly deteriorates. Given this issue, in this paper, we propose a SAR image generation method based on label-aspect-conditioned diffusion model (SAR-LADM). Its principle and structure are tailored specifically to SAR target characteristics for SAR image generation and imbalanced recognition tasks. Specifically, we first introduce the diffusion model to generate SAR images. The robustness of its training process enhances the reliability of the generated samples. Subsequently, the conditionally controlled Transformer encoder (CCTE) is designed to facilitate controllable SAR image generation. This is achieved by intelligently integrating and utilizing the category label and aspect of targets in the Transformer encoder. Finally, the SAR-LADM is applied to the imbalanced SAR ATR, and addresses the issue of imbalance by generating target samples with missing aspects. Experiments on the moving and stationary target acquisition and recognition (MSTAR) and aircraft datasets, involving generation and imbalanced recognition tasks, demonstrate that the proposed method maintains stable generation quality and significantly enhances SAR ATR performance in imbalanced scenarios.}
}
@article{HOU2026115183,
title = {RFD-ML: Robust federated defense via meta-learning},
journal = {Applied Soft Computing},
volume = {197},
pages = {115183},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115183},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006319},
author = {Hongming Hou and Jing Zhang and Meirun Zhang and Zhenhan Huang and Xiucai Ye},
keywords = {AI security, Robust intelligence, Adversarial attacks, Federated learning, Meta-learning},
abstract = {Federated learning (FL) promises privacy-preserving collaboration, yet in practice suffers from challenges such as malicious gradient manipulations, significant non-independent and identically distributed data heterogeneity, and unstable convergence behavior. To address these challenges, we propose Robust Federated Defense via Meta-Learning (RFD-ML), a comprehensive framework integrating three synergistic modules. Firstly, the Bayesian Residual Meta-Learning Model (BRMLM) is a probabilistic trust inference engine. It uses dropout-based Bayesian inference to dynamically calibrate trust weights, distinguishing malicious intent from benign statistical divergence to attenuate adversarial impacts. Secondly, the Two Stage Huber M-Estimation Model (TSHMEM) is a statistical regularizer. It uses a two-stage process of trust-weighted aggregation and Huber-thresholded norm clipping, which regularizes extreme gradients while preserving data heterogeneity. Thirdly, the Meta-Stackelberg Defense Aggregation Model (MSDAM) provides a proactive, strategic defense. It models the server-adversary interaction as a repeated Stackelberg game, allowing the server to anticipate and adapt to evolving threats. Empirical evaluations demonstrate that our RFD-ML framework consistently outperforms existing robust federated learning methods under varying levels of adversarial attacks. Compared to baselines, RFD-ML reduces MAE by 67.7% and MSE by 59.6% on average, and improves R2 by 0.413 absolute.}
}
@article{CHEN2026115187,
title = {Multi-knowledge-oriented nighttime haze imaging enhancer for vision-driven intelligent systems},
journal = {Applied Soft Computing},
volume = {197},
pages = {115187},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115187},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006356},
author = {Ai Chen and Yuxu Lu and Dong Yang and Junlin Zhou and Yan Fu and Duanbing Chen},
keywords = {Adverse weather, Multi-knowledge learning, Nighttime haze, Image restoration, Intelligent imaging},
abstract = {Salient object detection (SOD) plays a critical role in Intelligent Imaging, facilitating the detection and segmentation of key visual elements in an image. However, adverse imaging conditions such as haze during the day, low light, and haze at night severely degrade image quality and hinder reliable object detection in real-world scenarios. To address these challenges, we propose a multi-knowledge-oriented nighttime haze imaging enhancer (MKoIE), which integrates three tasks: daytime dehazing, low-light enhancement, and nighttime dehazing. The MKoIE incorporates a task-oriented node learning mechanism with physically guided multi-knowledge encoding to jointly handle three degradation types. Three task-specific nodes are built on a shared encoder, and the nighttime haze node reuses features from daytime and low-light nodes through a self-attention-guided fusion strategy. In addition, multi-receptive field enhancement module efficiently extracts multi-scale features through three parallel depthwise separable convolution branches with different dilation rates, capturing comprehensive spatial information with minimal computational overhead to meet the requirements of real-time imaging deployment. Furthermore, MKoIE adopts a hybrid loss to jointly optimize reconstruction quality and perceptual characteristics. Extensive experiments on different types of weather and imaging conditions illustrate that MKoIE surpasses existing methods, enhancing the reliability, accuracy, and operational efficiency of intelligent imaging.}
}
@article{LIN2026115150,
title = {Enhancing real-time cross-subject EEG decoding via pseudo-label tuning and adaptation},
journal = {Applied Soft Computing},
volume = {197},
pages = {115150},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115150},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005983},
author = {Zhanhui Lin and Yonglin Wu and Chenyun Dai and Yao Guo},
keywords = {Brain computer interface (BCI), Electroencephalogram (EEG), Motor imagery (MI), Privacy protection, Test time adaptation (TTA)},
abstract = {Brain-computer interface (BCI) has shown great promise in restoring motor function for individuals with physical disabilities. Among them, Electroencephalogram (EEG) based BCI systems for motor imagery (MI) decoding have gained significant attention due to their non-invasiveness and great accessibility. However, these systems typically require extensive, subject-specific calibration, which poses significant challenges for large-scale deployment and increases operational costs. To address this issue, domain adaptation (DA) techniques have been widely explored in cross-subject MI decoding. However, most existing DA methods rely either on source domain data, which is often inaccessible due to privacy constraints, or assume full access to target domain data in advance, limiting their applicability in real-time settings. To overcome these limitations, we propose a novel source-free test time adaptation (TTA) framework, Pseudo Label Tuning and Adaptation (PLTA), for unsupervised cross-subject MI decoding. PLTA tackles the problem in two key phases. First, during inference, it constructs a feature bank to represent the target domain distribution and leverages this information to refine low-confidence predictions. Second, during adaptation, it employs a confidence-weighted hybrid loss that integrates information maximization and perturbation invariance to calibrate the original source model. The proposed framework enables real-time inference and continuously adapts to incoming target data streams while maintaining robustness against adversarial samples. Comprehensive experiments on three widely adopted BCI benchmark datasets demonstrate that PLTA surpasses ten state-of-the-art TTA algorithms under both standard cross-subject and adversarial domain shift conditions.}
}
@article{KHAN2026115211,
title = {TR-MEPS: Entropic spectral projection for trust-aware robust federated aggregation},
journal = {Applied Soft Computing},
volume = {197},
pages = {115211},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115211},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006599},
author = {Koffka Khan and Winston Elibox and Shanta Ramnath},
keywords = {Distributed machine learning, Client heterogeneity, Non-IID data, Byzantine resilience, Model poisoning defense, Adaptive client weighting},
abstract = {Federated learning under non-i.i.d. data and unreliable or adversarial client behavior remains vulnerable to unstable and biased aggregation, while many robust alternatives rely on heuristic filtering or direct reweighting that can suppress informative but atypical updates. We propose TR-MEPS (Trust–Relevance Mean-Preserving Entropic Spectral Projection), a server-side federated aggregation operator that computes client weights by KL-projecting a trust–relevance prior onto a spectrally constrained feasible set. The projection exactly preserves trusted spectral moments while explicitly bounding exposure to discordant spectral directions through a tunable budget, τ(t), yielding a unique convex-program solution with an efficient low-dimensional dual form. We further provide a convergence analysis aligned with the TR-MEPS projection mechanism under the stated assumptions, together with an explicit calibration of τ(t) under Byzantine/noise models. Across the evaluated heterogeneous benchmarks, TR-MEPS consistently improves over FedAvg and remains competitive with the selected robust/personalized baselines under matched training budgets: EMNIST accuracy increases from 85.0% to 87.5%, CIFAR-100 from 49.8% to 52.4%, and AG News from 78.0% to 82.5%; on IEEE-CIS fraud detection, ROC–AUC improves from 0.748 to 0.790 and PR–AUC from 0.312 to 0.368. These gains are achieved with essentially unchanged communication cost and limited additional server-side runtime in the evaluated setups (e.g., 1.2 s to 1.3 s per EMNIST round in our setup). Additional diagnostics further show that the descent certificate remains well behaved in standard heterogeneous regimes, with repair or fallback concentrated in the strongest stress settings.}
}
@article{NOH2026115158,
title = {GlaucoFormer: A transformer-based model for glaucoma detection and segmentation},
journal = {Applied Soft Computing},
volume = {197},
pages = {115158},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115158},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600606X},
author = {Dae-Il Noh and Thien-Thanh Dao and Kyeong-Min Park and Seon-Geun Jeong and Won-Joo Hwang},
keywords = {Glaucoma classification, OC OD segmentation, Transformer, Attention},
abstract = {Glaucoma is a major cause of irreversible blindness worldwide, primarily due to optic nerve damage caused by elevated intraocular pressure. Early detection is vital to prevent vision loss, emphasizing the need for accurate and efficient diagnostic methods. The proposed model enhances optic disc (OD) and optic cup (OC) segmentation, as well as glaucoma classification, by integrating transformer-based attention and the convolutional block attention module (CBAM) into a UNet architecture. To improve segmentation precision, we employ multiscale losses at different decoding stages, allowing the network to progressively refine predictions across multiple resolution levels. By accurately segmenting OD and OC, we extract critical features for glaucoma risk assessment, combining these metrics with encoder features to enhance classification performance. The experimental results show that our approach significantly surpasses the existing methods in terms of both segmentation accuracy and glaucoma prediction, offering a reliable tool for early glaucoma diagnosis. For glaucoma classification, our method outperformed traditional approaches on the RIM-ONE, REFUGE, and DRISHTI-GS1 datasets, with accuracies of 95.8%, 96%, and 92%, respectively, and was comparable to that of the CUHKMED team, the leading team in the REFUGE challenge, achieving an accuracy of 95.59% on the REFUGE dataset. This advancement in automated glaucoma detection through deep learning can enable timely intervention, ultimately helping preserve the vision of patients.}
}
@article{RAJA2026115163,
title = {Smart ensemble modeling for multiclass lateral‑spreading prediction},
journal = {Applied Soft Computing},
volume = {197},
pages = {115163},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115163},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006113},
author = {Muhammad Nouman Amjad Raja and Tarek Abdoun and Waleed El-Sekelly},
keywords = {Multiclass classification, Lateral spreading, Ensemble modelling, TabNet attention mechanisms, Explainable AI (XAI)},
abstract = {Liquefaction-induced lateral spreading is a major geohazard that poses serious risks to infrastructure in seismically active regions, and although machine learning techniques have been increasingly applied to this problem, existing studies have predominantly formulated it using regression or binary classification frameworks. This paper introduces a novel explainable Hybrid Ensemble Network for Lateral Spreading (HEN-LS) for the multiclass prediction of liquefaction-induced lateral spreading. Leveraging a dataset of more than 6000 seismic sites labeled across four displacement classes (very low, low, medium, and high), Optuna-tuned LightGBM, XGBoost, and TabNet base learners were developed. The probabilistic outputs of these learners were fused using a deep neural network meta-learner to construct the HEN-LS model. Model evaluation using confusion matrices and performance metrics demonstrated an overall accuracy of 92.1%, precision of 85.8%, recall of 89.3%, F1-score of 87.3%, Matthews correlation coefficient of 0.864, and a Brier score of 0.158. Permutation testing, Cochran’s Q test, and Bowker’s symmetry test (all p < 0.001) confirmed statistically significant improvements over individual base models. Explainability analyses using SHAP values and TabNet attention masks identified peak ground acceleration, river proximity, elevation, and groundwater depth as the dominant predictors, with class-specific attention patterns reflecting their varying influence across displacement categories. Confusion-matrix inspection further showed that misclassification rates for each class were consistently lower than those of individual models, highlighting the balanced performance of HEN-LS across all risk levels. Overall, HEN-LS combines high predictive accuracy with transparent decision-making at modest computational cost, offering a scalable tool for geotechnical hazard evaluation.}
}
@article{NITTI2026115252,
title = {Uncertainty-aware semi-supervised learning for neurosurgical navigation},
journal = {Applied Soft Computing},
volume = {197},
pages = {115252},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115252},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007003},
author = {Francesco Nitti and Silvia Seoni and Alberto Morello and Lorenzo Dolci and Amedeo Piazza and Vincenzo Esposito and Luigi Rosito and Diego Garbossa and Fabio Cofano and Abdulkadir Sengur and Massimo Salvi},
keywords = {Semi-supervised learning, Uncertainty quantification, Neurosurgical navigation, Pseudo-labeling, Monte Carlo Dropout},
abstract = {Background/Objective
Accurate, real-time segmentation of anatomical structures during neurosurgical procedures can support intraoperative orientation. One of the most significant challenges in this domain is developing robust segmentation models with limited annotated data while maintaining clinical reliability. This work addresses how semi-supervised learning can leverage both labeled and unlabeled data, while ensuring the dependability crucial for clinical applications where even small segmentation errors can have significant consequences. Methods: We present a novel uncertainty-aware semi-supervised framework for neurosurgical scene segmentation. Our approach introduces Semantic Spatial Uncertainty (SSU), a metric that quantifies prediction reliability by analyzing spatial consistency across multiple stochastic forward passes using Monte Carlo Dropout. The framework employs class-specific calibration with adaptive thresholds that continuously refine through iterative pseudo-labeling, effectively counteracting dataset imbalance. Results: Our method achieves significant improvements for clinically critical classes, with relative gains in Dice Similarity Coefficient of + 40% for tumors, + 15% for middle cerebral artery and + 14% for aneurysm. Unlike traditional uncertainty measures, SSU captures uncertainty even for structures with high perimeter-to-area ratios, demonstrating strong correlation with segmentation quality (Pearson coefficient −0.85) without requiring ground truth. Our approach also outperforms intensive data augmentation (even at 200% synthetic samples) and maintains effectiveness across multiple architectures, demonstrating its architecture-agnostic advantages. Conclusion: By reframing annotation scarcity as an uncertainty quantification problem, our approach provides a practical solution for medical image segmentation in data-constrained environments. This segmentation framework offers potential applications beyond neurosurgery to other computer vision segmentation tasks with limited labeled data. Code is available at https://github.com/nittifra/ua-ssl-neuro}
}
@article{WANG2026115195,
title = {Detection and estimation of missing maize seedlings via UAV imagery and maize-YOLO},
journal = {Applied Soft Computing},
volume = {197},
pages = {115195},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115195},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006435},
author = {Lijun Wang and Yanyu Zhang and Zhanfeng Sun and Yunpeng Gao and Yu Wang},
keywords = {Missing seedling inference, UAV, DBSCAN, Maize-YOLO},
abstract = {Abstract：
To enhance the efficiency of missing seedling rate estimation and address the limitations of manual counting, this study proposes a detection method based on deep learning and UAV imagery. A custom UAV image dataset was built using nested annotations for “maize seedlings” and “maize stalks.” A nested annotation strategy was adopted to fully leverage the complementary advantages of two detection classes: maize seedling boxes provide high identification accuracy, while maize stalk boxes offer more precise localization. Building upon YOLOv8, this study further integrates the Coordinate Attention (CA) mechanism and the focal-EIoU loss function, and redesigns the detection head to better capture small objects. The resulting Maize-YOLO model achieves a 4.9% improvement in mAP50 compared to YOLOv8n.The model achieved high detection performance, with a mAP50 of 98.9% for maize seedling and 90.9% for maize stalk. A PP-DBSCAN clustering method was proposed to group seedlings by crop row. Kernel Density Estimation was used to estimate the distribution of inter-seedling distances, defining the dominant cluster as the baseline spacing. Deviations from this baseline were then used to identify missing seedlings. Field experiments demonstrated that the proposed system achieved a seedling detection precision of 98.86% and a recall of 99.57%. For missing seedling estimation, the system achieved a precision of 93.07% and a recall of 99.16%. This system presents an automated solution for monitoring missing maize seedlings in field conditions.}
}
@article{LONG2026115168,
title = {Algorithmic trading by reinforcement learning in a collaborative manner},
journal = {Applied Soft Computing},
volume = {197},
pages = {115168},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115168},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006162},
author = {Li Long and Chunxia Zhang and Cong Ma and Hongtao Wang and Lizhen Ji and Fei Gao and Jiangshe Zhang and Kaiwen Qiu},
keywords = {Algorithmic trading, Reinforcement learning, Distributed learning, Imitation learning},
abstract = {In recent years, reinforcement learning has emerged as a prominent approach in algorithmic trading, with most studies concentrating on time series processing and neural network architecture optimization within single-agent frameworks. Some research has confirmed that multi-agent or ensemble learning can enhance performance, but conventional methods often train ensemble neural networks or diverse reinforcement learning algorithms on the entire time series data. These practices not only lead to high computational costs but also hinder the efficient recognition of market fluctuations. To address these challenges, this paper introduces a novel Collaborative Self-Imitation Double Deep Q Network (CSI-DDQN) framework. The proposed approach partitions long-term time series data into shorter segments and employs a distributed learning-inspired collaborative training strategy across multiple clients. A self-imitation strategy enhances cooperation among clients, while a hybrid multi-loss function integrates the strengths of reinforcement learning and imitation learning. Experimental results using a multi-layer perceptron (MLP) architecture on U.S. stock data demonstrate that the proposed method significantly outperforms several baselines, achieving the highest average cumulative return of 56.85%, the highest Sharpe ratio of 1.42, and the lowest maximum drawdown of 17.14%. In comparison, DQN-Vanilla attains an average cumulative return of 3.95% while a Sharpe ratio of 0.25, and the DRL-Ensemble method yields a cumulative return of 19.53% and a Sharpe ratio of 0.54. Furthermore, to demonstrate the flexibility and adaptability of the proposed framework, additional experiments were conducted by substituting various network architectures and reinforcement learning algorithms within the framework. The results further validate the effectiveness of the developed CSI-DDQN framework. The related code is available at https://github.com/ll-1/CSI-DDQN.}
}
@article{YANG2026115160,
title = {Event-triggered model-free control for uncertain robotic systems with brain-inspired interactive monitoring},
journal = {Applied Soft Computing},
volume = {197},
pages = {115160},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115160},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006083},
author = {Yaoyu Yang and Jinzhu Peng and Yaqiang Liu and Penghui Fan and Nan Zhao and Lu Sun},
keywords = {Event-triggered model-free control, Adaptive brain-inspired interactive monitoring, Uncertain robotic systems, State-attracted function, Human-robot interaction},
abstract = {In this article, a state-attracted function-based event-triggered model-free control (SAF-ETMFC) approach with adaptive brain-inspired interactive monitoring (ABIIM) is proposed for uncertain robotic systems. Firstly, by using a spiking neural network, the ABIIM framework is designed to switch adaptively between human–robot interaction and obstacle avoidance modes, ensuring safe and compliant interaction. Secondly, a state-attracted function is developed based on a globally convergent vector field (GCVF), so that the tracking error evolves along the direction prescribed by the GCVF, thereby effectively mitigating disturbance-induced deviations in the state trajectory. Thirdly, the SAF-ETMFC approach is developed by integrating ABIIM with an event-triggered mechanism to ensure low communication and computation costs while improving robustness. Finally, we prove the stability of the closed-loop system using Lyapunov analysis and verify the proposed method using simulations and experiments.}
}
@article{GAO2026115200,
title = {Underwater image enhancement via multi-scale and dual attention mechanism},
journal = {Applied Soft Computing},
volume = {197},
pages = {115200},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115200},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006484},
author = {Guohong Gao and Haofan Bai and Jianping Wang and Yan Wang and Fengshuo Tian and Weidong Zhang and Zhiyu Li},
keywords = {Underwater image enhancement, Multi-scale feature fusion, Variance-guided spatial attention, Image enhancement, Deep learning},
abstract = {Underwater image enhancement is a challenging task due to the complex interplay of light attenuation, scattering, and color distortion. This paper presents MDANet, a novel deep learning framework that combines Multi-Scale Feature Fusion (MSFF) with a Variance-guided Spatial Attention (VSA) mechanism. Unlike conventional attention modules, VSA integrates variance pooling with max and average pooling, enabling more effective capture of subtle intensity fluctuations and texture variations in underwater scenes. In addition, an interactive spatial-channel attention module is incorporated to emphasize informative features while suppressing irrelevant ones adaptively. To achieve perceptually and structurally superior results, a composite loss function-consisting of edge loss, Charbonnier loss, and perceptual loss-is employed to jointly optimize pixel accuracy, edge sharpness, and semantic consistency. A gradient accumulation strategy is further employed to reduce GPU memory usage, thereby improving adaptability in memory-constrained environments. Extensive experiments on multiple benchmark underwater datasets demonstrate that MDANet consistently outperforms state-of-the-art methods in both qualitative and quantitative evaluations, offering a promising solution for underwater image enhancement. The model and associated training pipelines are available at https://github.com/bhf123/Underwater-Image-Enhancement-via-Multi-scale-and-Dual-Attention-Mechanism.}
}
@article{QUAN2026115184,
title = {An explainable feature selection method through statistical reinforcement learning},
journal = {Applied Soft Computing},
volume = {197},
pages = {115184},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115184},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006320},
author = {Haodi Quan and Yun Zhang and Qiaoqin Li and Yongguo Liu},
keywords = {Feature selection, Statistical learning, Reinforcement learning, Evolutionary computing},
abstract = {The rapid growth of data has led to increasingly high-dimensional feature spaces, making feature selection critical for efficient learning. Traditional filter and embedded methods rely on fixed patterns, limiting their adaptability to specific learning algorithms. Greedy-based wrapper methods may overlook features that are only useful in combination, whereas heuristic-based ones are prone to local optima. Reinforcement learning-based methods have been introduced to address these issues, yet most of them operate as black boxes with limited explainability, a crucial aspect in feature selection tasks for uncovering relationships among features. Moreover, they often fail to sufficiently leverage historical information, resulting in unstable feature subsets. To overcome these limitations, we propose an explainable statistical reinforcement learning method, Experience Accumulation (EA). EA updates feature importance using historical statistics and employs a partial mutation strategy to balance exploration and exploitation. Moreover, EA exhibits a linear evolution property in feature importance, naturally distinguishing relevant, redundant, while irrelevant features and enhancing explainability. Experiments on ten benchmark datasets show that EA achieves higher stability, accuracy, and explainability than existing reinforcement learning and wrapper methods.}
}
@article{TAYARANINAJARAN2026114998,
title = {A deep learning feature mapping algorithm for emotion detection via facial and audio signals},
journal = {Applied Soft Computing},
volume = {197},
pages = {114998},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114998},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004461},
author = {Mohammad Hassan {Tayarani Najaran} and Shamim Ibne Shahid and Frank Foerster and Volker Steuber},
keywords = {Emotion detection, Deep learning, Signal processing, Affective computing},
abstract = {Automatic emotion recognition plays a critical role in areas such as mental-health monitoring, human–robot interaction, and personalised learning systems, yet current multimodal approaches often struggle with high intra-class variability and the limited discriminative power of raw audio–visual features. Existing methods typically rely on direct classification of audio or facial data, which does not explicitly enforce a structured joint embedding in which emotional categories become separable. This paper addresses this limitation by proposing a supervised contrastive feature-mapping algorithm that transforms temporal audio and video features into a representation that minimises intra-class distances while maximising inter-class distances. In contrast to prior work, which usually focuses on handcrafted feature engineering or end-to-end classifiers, our approach explicitly learns a discriminative metric space that enhances the geometry of the feature distribution. The method is evaluated on the RAVDESS and CREMA-D benchmark datasets. Experimental results show that the proposed mapping yields consistent accuracy improvements over strong machine-learning baselines, with gains of up to approximately 6%, achieving 96.07% accuracy on RAVDESS and competitive performance on CREMA-D, while outperforming or matching recent state-of-the-art multimodal emotion-recognition pipelines. Statistical tests (Kruskal–Wallis and paired t-tests) confirm that the learned representation significantly increases class separability (p<10−5). While the method assumes the availability of paired audio–visual inputs without requiring explicit temporal alignment, the learned feature space is compact, discriminative, and well suited to downstream tasks such as affect-aware dialogue systems, rehabilitation monitoring, and adaptive educational interfaces. These results demonstrate that contrastive feature mapping provides a robust and generalisable framework for multimodal emotion analysis.}
}
@article{NDIKURIYO2026115176,
title = {A multi-objective robust optimization based on evolutionary algorithm for container routing problem under risks and uncertainties},
journal = {Applied Soft Computing},
volume = {197},
pages = {115176},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115176},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006241},
author = {Yves Ndikuriyo and Yinggui Zhang and Dung Davou Fom},
keywords = {Multi-objective optimization, Evolutionary algorithms, Container routing, Robust optimization, Uncertainty, Logistics},
abstract = {This study proposes an Enhanced Multi-Objective Evolutionary Algorithm based on Decomposition (En-MOEA/D) for the Container Routing Problem under uncertainty. The framework integrates three innovations: adaptive decomposition dynamically switching between Penalty Boundary Intersection and Chebyshev scalarization; Monte Carlo simulation for probabilistic scenario analysis; and a mean-variance risk control strategy. Extensive benchmarking on ZDT, DTLZ, and WFG problems demonstrates En-MOEA/D’s superiority over state-of-the-art variants. Parameter sensitivity analysis reveals that the variance penalty parameter β is most critically influential, with adjustment from 0.3 to 0.9 yielding a 45.2% hypervolume improvement. Ablation studies confirm that balanced weighting (ω=0.9) outperforms extremes by 20.2%, while the variance weight γ=0.2 provides optimal stability with low-to-moderate sensitivity (9.43%). The convergence window τ exhibits remarkable robustness (1.48% sensitivity), and increasing Monte Carlo scenarios from 50 to 100 yields a 12.0% improvement. A real-world East African case study confirms practical efficacy, with En-MOEA/D achieving 1.8% cost reductions and 4.1–4.5% faster delivery times compared to baseline MOEA/D. The algorithm demonstrated superior resilience under disruption, limiting cost increases to 13.0–13.7% under 20% perturbations—substantially outperforming baseline MOEA/D (13.5–16.8%). The analysis identified a 2.6% cost advantage and a 4.6% improvement in reliability for the Central Corridor, providing strategic insights for infrastructure planning. While incurring moderate computational overhead, the performance gains justify this trade-off in dynamic environments. This study advances robust multi-objective optimization, offering a scalable tool for resilient routing decisions in global supply chains.}
}
@article{XIE2026115142,
title = {SEMPRA: Secure medical privacy-reversible adversarial framework},
journal = {Applied Soft Computing},
volume = {197},
pages = {115142},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115142},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005909},
author = {Xiaozhu Xie and Chao Ouyang and Xia Du and Jizhe Zhou and Chi-Man Pun and Ching-Chun Chang and Chin-Chen Chang},
keywords = {Adversarial robust attacks, Ensemble attack, Computer vision, Reversible data hiding},
abstract = {Facilitating telemedicine and cross-institutional data sharing requires protecting patient imagery from unauthorized AI analysis without hindering clinical diagnosis. However, current anonymization techniques typically fail to balance these needs, either permanently degrading diagnostic utility or proving ineffective against heterogeneous deep learning architectures. To bridge this gap, we introduce SEMPRA, a dual-purpose framework that renders medical images unrecognizable to malicious AI models while ensuring they remain mathematically reversible for authorized clinicians. Unlike global noise methods, our approach employs a lesion-specific strategy that concentrates protective perturbations solely on diagnostic regions to minimize artifacts. We further introduce an ensemble optimization technique—integrating Gradient Sensitivity Weighting (GSW) and Cross-Model Gradient Alignment (CMGA)—that aligns attack directions to simultaneously disrupt both CNNs and Vision Transformers. Crucially, a Reversible Data Hiding (RDH) mechanism embeds restoration data directly into the pixels, guaranteeing high-fidelity recovery. Comprehensive evaluations on melanoma, OCT, and Chest X-ray datasets demonstrate that SEMPRA achieves a > 99% attack success rate in misleading unauthorized AI, while restoring images with pixel-level fidelity (PSNR > 40 dB) identical to the original scans. This solution effectively secures remote diagnostic workflows against privacy breaches without compromising medical accuracy.}
}
@article{SUN2026115148,
title = {Towards superior graph representation: A multi-level cross-view approach integrating information bottleneck and contrastive learning},
journal = {Applied Soft Computing},
volume = {197},
pages = {115148},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115148},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600596X},
author = {Ruishuang Sun and Enguang Zuo and Xiaoyi Lv and Ziwei Yan and Chen Chen and Cheng Chen},
keywords = {Graph representation learning, Contrastive learning, Information bottleneck, Mutual information},
abstract = {Graph representation learning attracts attention for efficiently capturing structural and semantic information in low-dimensional spaces. Although existing research has enhanced the quality of graph representation through contrastive learning, it often tends to deal with feature representation within a single view or feature alignment between views, without sufficiently considering the synergistic relationship between different views and ‘global structure vs. local details’ within the same view, and it lacks effective control of information. Therefore, we propose a new framework (SR-CLIB) that combines multi-level cross-view contrastive learning with the principle of information bottleneck. It achieves better graph representation by comparing Mutual Information between different views and within ‘global vs. local’ views, and by exploring the correlation features between views and at different levels within the same view. Generate two augmented views of the original graph and sample subgraphs from one view, pulling together the views from the same instance while pushing apart those from different instances. By maximizing the Mutual Information between the two augmented views, the global view and its local subgraphs, and minimizing the difference in information between the subgraphs and the non-sampled views, we achieve an accurate grasp of the graph structure and feature information. We have conducted extensive experiments based on 12 datasets and verified that SR-CLIB has significant performance advantages over existing methods.}
}
@article{XIE2026115182,
title = {Stability-aware robust deep graph matching with outliers},
journal = {Applied Soft Computing},
volume = {197},
pages = {115182},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115182},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006307},
author = {Yu Xie and Yuan Li and Zhiqiang Wang and Hangyuan Du and Ming Li},
keywords = {Graph matching, Unsupervised learning, Outlier, Combinatorial optimization},
abstract = {Graph matching, which aims to establish node correspondences across graphs, faces a critical challenge from outliers that disrupt consistency and stability, leading to substantial performance degradation. Existing methods typically assume clean data and thus struggle in real-world settings with noise. To address this, this paper proposes a stability-aware robust deep graph matching framework (SRGM) that first learns expressive node representations to construct the affinity matrix and obtain initial correspondences, then employs a stability-based scoring mechanism to distinguish inliers from outliers. The affinity matrix is recalibrated by adjusting columns corresponding to low-stability nodes with learnable vectors and the recalibrated affinity matrix is fed into a differentiable graph matching solver to obtain the final node correspondence. SRGM can be seamlessly integrated into supervised methods and is further extended to the unsupervised setting through a stability-aware loss based on confidence divergence, reducing mismatches without annotations. Experiments on three benchmarks demonstrate significant improvements with the number of outliers ranging from 1 to 5 (e.g., an improvement of 1.5% on PASCAL VOC), validating the effectiveness and robustness of the proposed framework.}
}
@article{CHOI2026115234,
title = {LLM-structured expert feedback for knowledge calibration of deep learning model to detect phishing URL},
journal = {Applied Soft Computing},
volume = {197},
pages = {115234},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115234},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006824},
author = {Seok-Hun Choi and Seok-Jun Buu and Sung-Bae Cho},
keywords = {Cybersecurity, Phishing URL detection, Neuro-symbolic integration, Large language models, In-context learning, Deep learning model},
abstract = {Phishing attacks increasingly exhibit structural variability and intent obfuscation, challenging detection systems that rely on static features or limited data distributions. Deep neural models provide strong representation learning capabilities, yet often misclassify novel URLs that differ from the training distribution. In contrast, human decision-making incorporates external knowledge and structured reasoning beyond observed data. To reduce this gap, we propose a knowledge calibration method that incorporates symbolic expert knowledge from large language model into phishing detectors. An LLM translates expert feedback expressed in natural language into formal first-order logic rules. This translation is guided by five in-context learning strategies, enabling the structured incorporation of symbolic knowledge into the detection framework. These rules are used to generate phishing scores, which are then combined with neural outputs through a discrepancy-aware calibration objective. A triplet-based Transformer encoder is used to learn discriminative URL representations, and the joint loss function aligns neural predictions with symbolic expectations. Extensive experiments across four benchmark datasets show that our method achieves up to 98.85% accuracy and 97.42% recall, significantly outperforming baselines and ensemble models. Moreover, temporal drift evaluations under chronologically split zero-day settings show that the proposed model maintains an accuracy of 0.8153 even under the most severe drift scenario, outperforming the strongest baseline by over 9%p, demonstrating robust generalization of symbolic knowledge to unseen phishing attacks.}
}
@article{REZAEE2026115145,
title = {Efficient multi-agent deep reinforcement learning algorithm for multi UAV collision avoidance},
journal = {Applied Soft Computing},
volume = {197},
pages = {115145},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115145},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005934},
author = {Mohammad Reza Rezaee and Nor Asilah Wati {Abdul Hamid} and Masnida Hussin and Zuriati {Ahmad Zukarnain}},
keywords = {Unmanned aerial vehicle, Collision avoidance, Multi-agent learning, Deep reinforcement learning, Graph attention network},
abstract = {The rapid expansion of unmanned aerial vehicles (UAVs) across industries has led to increased airspace congestion. The increasing use of drones across many fields and locations has caused serious problems, especially in avoiding collisions. In the rapidly developing field of drone technology, ensuring UAV flight safety and reducing the risk of UAV collisions have therefore become urgent concerns. There are many artificial intelligence (AI) algorithms designed to solve this problem, but most work only in situations with a single agent. Multi-agent reinforcement learning is a promising way to solve these problems. It enables drones to operate with greater intelligence and flexibility, even in challenging situations, alongside other agents. This work presents a Multi-Agent Deep Reinforcement Learning algorithm based on efficient graph attention network for collision avoidance in a dense, complex multi UAV environment. We propose both curriculum learning and transfer learning by adding more agents over time and subsequently employing learning models. This makes the system more scalable and more coordinated. The training process is significantly enhanced by the suggested method, which outperforms the current baselines in continuous settings. Our findings indicate that the proposed approach achieves 17% higher cumulative reward, up to 10% fewer loss-of-separation time steps, and about 44% fewer active interaction edges than the benchmark. Furthermore, the proposed method reduces action-selection bias, improving decision-making stability in dense multi-UAV settings.}
}
@article{YAO2026115133,
title = {Boosting feature distillation for link prediction via graph neural architecture search},
journal = {Applied Soft Computing},
volume = {197},
pages = {115133},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115133},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005818},
author = {Yabing Yao and Rong Ye and Zhiheng Mao and Yang Liu and Zhenzhen Cao and Wei Zhou and Jianxin Tang and Fuzhong Nian},
keywords = {Complex networks, Link prediction, Knowledge distillation, Graph neural networks, Graph neural architecture search, Feature-based distillation, Adaptive teacher},
abstract = {Link prediction is crucial for understanding complex network structures and evolutionary mechanisms. In recent years, feature-based knowledge distillation (KD) has shown strong potential for improving link prediction performance. However, its reliance on a fixed GNN teacher model limits its adaptability across different networks. Moreover, direct feature matching may cause the student model to overfit. To address these issues, we propose KDBoost, a framework that enhances feature-based KD to Boost the performance of link prediction. KDBoost leverages Graph Neural Architecture Search (GNAS) to automatically select the optimal teacher model for each network. In addition, it introduces a Projector module to transform student features, thereby alleviating overfitting and improving generalization. Experiments on eight benchmark networks demonstrate that KDBoost achieves average improvements of 7.6%, 7.4%, and 10.5% in AUC, AUPR, and F1-score, respectively, over traditional feature distillation methods. Compared with recent GNN distillation methods, KDBoost further improves these metrics by 3.4%, 3.1%, and 4.9%, indicating its effectiveness for accurate and generalizable link prediction. Our code is available at https://github.com/yabingyao/KDBoost4LinkPrediction.git.}
}
@article{XUE2026115149,
title = {TactileFormer: A feature-fused CNN-Transformer model for few-shot tactile perception},
journal = {Applied Soft Computing},
volume = {197},
pages = {115149},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115149},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005971},
author = {Tianci Xue and Kaiyan Xie and Dongli Liu and Yankai Zheng and Liguo Qin and Wentao Xia and Luxin Hao},
keywords = {Tactile perception, Neural network, Transfer learning, Signal processing, Few-shot learning},
abstract = {Along with the rapid advancement of robotics, tactile perception has attracted significant attention. Compared with traditional techniques, machine learning and deep learning stand out due to their strong capability for feature extraction. In this study, we propose TactileFormer, a feature-fused CNN-Transformer architecture designed for tactile perception of surfaces, solids, and liquids. The model comprises two submodules that separately process time-domain and frequency-domain signals, followed by feature fusion. Datasets were collected from nine surface textures under seven experimental conditions. These conditions cover both clean surfaces and surfaces mixed with impurities, enabling an evaluation of the model’s generalization under realistic environmental disturbances. Leveraging transfer learning, TactileFormer was first trained on a large-sample dataset under clean conditions and then fine-tuned with limited data under impurity conditions. The model achieved an accuracy exceeding 95% in few-shot learning tasks, demonstrating strong performance despite the small amount of impurity data. Furthermore, Multidimensional Scaling (MDS) analysis revealed feature patterns consistent with the learned network weights, thereby improving interpretability.}
}
@article{SHARAFI2026115210,
title = {Two-level breast tumor classification with multi-view imaging and pathology-aware large language models: A fuzzy KNN and ensemble learning framework},
journal = {Applied Soft Computing},
volume = {197},
pages = {115210},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115210},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006587},
author = {Yousef Sharafi and Mohammad Teshnehlab and Nahid Sadighi},
keywords = {Ensemble Learning, Fuzzy k-NN, Large Language Models, Breast Tumor Classification, Multi-View Learning, Texture and Deep Features},
abstract = {Breast cancer is one of the most prevalent cancers among women, and its accurate and timely diagnosis requires the use of intelligent decision-making algorithms. In the present study, a two-level framework based on mammography images and pathological textual data is proposed, with the purpose of enhancing the accuracy of classifying benign and malignant tumors. At the first level, the framework generates three independent representations, namely the HSV color space, heatmap, and thermal color map, from the original mammography images to provide a multi-view representation of the target tissue. For each modality independently, the framework extracts classical texture features such as LBP, GLCM, and HOG, along with deep features derived from pre-trained neural networks. The framework subsequently applies principal component analysis (PCA) separately to each image view to reduce dimensionality and eliminate statistical noise. The proposed framework subsequently feeds the reduced outputs into a Fuzzy k-nearest neighbor’s algorithm, which classifies the samples into healthy or suspicious categories based on their imaging features. At the second level, the framework analyzes only the samples identified as suspicious in the first level using textual data. In this stage, the pathology reports corresponding to each sample, after undergoing linguistic preprocessing including cleaning and normalization, are provided to an aggregation-based approach employing large language models, and the process of feature extraction is carried out. The semantic vectors extracted from the large language models undergo PCA-based dimensionality reduction before being fed into a Fuzzy k-NN classifier for final tumor classification (benign/malignant). Experimental results demonstrate that the proposed method achieves high accuracy, shows robustness against noisy data, and effectively manages borderline cases. These findings highlight its potential as a reliable clinical decision-support system for breast cancer diagnosis.}
}
@article{ZHENG2026115255,
title = {Learning-based adaptive offspring generation for multi-objective optimization problems with variable linkages},
journal = {Applied Soft Computing},
volume = {197},
pages = {115255},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115255},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007039},
author = {Wei Zheng and Jianyong Sun and Nike Zhang and Lizhi Zhang and Yu Xie and Haotian Zhang},
keywords = {Variable linkages, Adaptive offspring generation, Multi-objective optimization, Learning},
abstract = {Multi-objective optimization problems (MOPs) with decision variable linkages present significant challenges due to intricate variable interdependencies, which often render conventional variable-wise operators ineffective and invalidate global linear assumptions. In this paper, a novel learning-based evolutionary algorithm, termed EAVL, is proposed to handle MOPs with variable linkages by exploiting the topological structure of the population. Unlike traditional methods that rely on global modeling, EAVL integrates unsupervised clustering to capture the nonlinear geometrical structure of the Pareto set in a piecewise manner. Specifically, K-means and hierarchical clustering are employed to extract local neighborhood information, which guides a learning-based selection mechanism to prevent inbreeding and maintain topological diversity simultaneously. Furthermore, an adaptive offspring generation strategy is designed to navigate the complex mapping between decision and objective spaces by dynamically balancing exploration and exploitation. Extensive experiments on a wide range of MOPs with both linear and nonlinear variable linkages, as well as varying decision dimensions, demonstrate that EAVL achieves competitive or superior performance compared to several state-of-the-art algorithms. Finally, the effectiveness of EAVL is extended to real-world applications, demonstrated by its superior performance in solving challenging community detection problems.}
}
@article{FAN2026115194,
title = {Triple-verifiable aggregation with parameter encoding for privacy-enhanced cross-device federated learning},
journal = {Applied Soft Computing},
volume = {197},
pages = {115194},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115194},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006423},
author = {Chenxu Fan and Yuwen Chen and Qin Jiang and Ziwen Tang and Haiyang Yu and Zhen Yang},
keywords = {Federated learning, Deep learning, Data privacy, Distributed learning, Gradient inversion attack},
abstract = {Verifiable aggregation schemes can safeguard data privacy and enable users to verify the correctness of aggregation. However, maintaining the integrity of aggregation results remains a critical challenge, particularly in cross-device federated learning, where user dropouts are common, and Shamir’s secret sharing is often used for recovery. Malicious participants may exploit this process by submitting fake key shares or tampering with the Shamir reconstruction procedure, compromising the correctness of aggregation. To address these challenges, we design a triple-verifiable architectural framework that strengthens the integrity of secret sharing, the key recovery process, and the final aggregation. To mitigate vulnerabilities in secret sharing, this architecture incorporates verifiable secret sharing (VSS) using a robust verification algorithm and commitment mechanism. In addition, we integrate a verification process into the Shamir reconstruction procedure to prevent tampering. Our scheme further enables users to efficiently validate aggregated results, restricting malicious servers from altering them to compromise privacy while introducing less than 1% additional computation and communication overhead. To improve practical deployment efficiency, we introduce a system-level parameter encoding method for ciphertext packing, which reduces approximately 25% of computation cost and about 40% of communication cost on average. Furthermore, our empirical analysis demonstrates that this encoding method enhances the framework’s resistance to gradient inversion attacks, providing an additional layer of data privacy. Experimental results indicate that our proposed optimizations improve communication and computational efficiency compared to baseline methods, offering a practical and verifiable aggregation architecture for cross-device federated learning.}
}
@article{FAN2026115162,
title = {A novel lightweight industrial surface defect detection network integrating multi-branch enhanced structures and innovative attention mechanisms},
journal = {Applied Soft Computing},
volume = {197},
pages = {115162},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115162},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006101},
author = {Xiangsuo Fan and Can Yang and Yong Mei and Jinlong Fan},
keywords = {Industrial defect detection, Small objects, Lightweight, Deep learning},
abstract = {Industrial surface defect detection serves as a critical means for factories to control product quality. In recent years, with the advancement of deep learning, industrial surface defect detection technology has made significant progress. However, the small size of defect targets, complex backgrounds, and irregular shapes remain major challenges in industrial defect detection. To address these issues, this paper proposes a novel lightweight industrial surface defect detection network, termed LE-ISDTNet, which integrates a multi-branch enhanced structure with an innovative attention mechanism. First, the SCADown subsampling module is designed. It employs a multi-branch structure and integrates an innovative attention mechanism, SEAM, to significantly reduce computational redundancy and memory consumption while enhancing information flow and improving feature representation capabilities. Additionally, the feature enhancement module MKCA is developed. It constructs an efficient multi-scale receptive field through parallel multi-core separable convolutions, effectively addressing the issues of single receptive fields or feature dispersion in traditional methods while reducing computational complexity. To overcome feature dilution and fixed receptive field limitations in conventional FPN, we propose the Context-Aware Feature Recirculation Network (CAFR-Net). Finally, we introduced a lightweight head architecture named SC-Head. Through parameter sharing and an improved normalization layer, it enhances detection head localization and classification performance while reducing parameters and computational overhead. We validated the proposed network’s effectiveness using three public datasets. Experimental results demonstrate that the network achieves 97.1% mAP50 on the PKU-Market-PCB dataset, 83.3% mAP50 on the NEU-DET dataset and 98.8% mAP50 on the DeepPCB dataset. With only 1.59 million parameters and computational complexity of 4.8 GFLOPs, it outperforms popular object detection networks. These results highlight the detection capabilities of the LE-ISDTNet architecture, offering a powerful and effective new approach for industrial surface defect detection.}
}
@article{CHEN2026115186,
title = {OSEAF: A robust one-shot environment-aware framework for malware detection evasion},
journal = {Applied Soft Computing},
volume = {197},
pages = {115186},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115186},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006344},
author = {Haoting Chen and Jiaxuan Geng and Di Wu and Wenhan Ge and Xiaobo Bai and Junfeng Wang and Zhiyang Fang},
keywords = {Adversarial example, Malware detection, Hybrid analysis, Machine learning, Evasion attacks},
abstract = {The escalating arms race in malware detection has revealed significant limitations in existing evasion techniques, which often suffer from inefficient iterative generation and limited stealth against hybrid analysis systems. To address these challenges, this paper proposes OSEAF, a robust One-Shot Environment-Aware Framework for generating adversarial malware examples. This framework employs multi-layer encryption, dynamic loading, and environment-aware mechanisms to effectively bypass both static and dynamic detection systems. By exploiting inherent structural properties of malware, it enables single-compilation adversarial generation, markedly enhancing efficiency while minimizing modification traces to improve stealth and practicality. Experimental evaluations show that the proposed method effectively evades 6 commercial antivirus engines and 4 machine learning-based detection models, achieving an average evasion rate of 98.8% against the MalConv model. Additionally, adversarial examples evaded an average of 45 detection engines on VirusTotal and successfully bypassed sandbox-based dynamic analysis, demonstrating strong resilience in complex detection scenarios.}
}
@article{BOUAZIZ2026115238,
title = {SESAUnet: A deep attention-based segmentation model for early detection of green aphids in smart greenhouse environments},
journal = {Applied Soft Computing},
volume = {197},
pages = {115238},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115238},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006861},
author = {Mohamed Chahine Bouaziz and Mourad {El Koundi} and Ali {Ben Abbes} and Imed Riadh Farah},
keywords = {Precision agriculture, Early pest detection, Semantic segmentation, Deep learning, Transformers},
abstract = {In the paradigm of Agriculture 4.0, early pest detection is essential for sustainable crop protection. Green aphids (Aphis gossypii) reproduce rapidly, and late detection can lead to crop losses of 20–40%. Early-stage detection is challenging due to their small size, scattered distribution, and low contrast against foliage. In this study, we propose SESAUnet, a U-Net–based segmentation network integrating Squeeze-and-Excitation (SE) blocks in the encoder and a Spatial-Attention (SA) module at the decoder output to enhance channel recalibration and spatial focus for small-object localization. A high-resolution dataset was collected in a commercial greenhouse during early infestation. Initially, 250 4 K images were captured and cropped into 919 annotated samples (512 ×512). Through structured offline augmentation, the training dataset was expanded to 1838 image–mask pairs, complemented by online augmentation during training to improve robustness. SESAUnet achieves an IoU of 0.836 ± 0.013, precision of 0.921 ± 0.011, and recall of 0.847 ± 0.017. The model was evaluated against CNN-based segmentation models, attention-enhanced architectures, transformer-based networks, and recent lightweight segmentation models, demonstrating a strong balance between accuracy and computational efficiency. An ablation study validated the agricultural-specific contribution of the SE and SA integration. Code and implementation details are publicly available to ensure reproducibility (Link here).}
}
@article{LI2026115174,
title = {FPGA implementation of autoregressive model-based empirical mode decomposition and convolutional neural networks for edge fault diagnosis},
journal = {Applied Soft Computing},
volume = {197},
pages = {115174},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115174},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006228},
author = {Jiaxin Li and Yongbo Wei and Maosong Cheng and Zhimin Dai},
keywords = {FPGA, Empirical mode decomposition, AI-driven fault diagnosis, Edge computing, Autoregressive modeling},
abstract = {Timely intelligent fault diagnosis is essential for ensuring equipment reliability and preventing catastrophic failures. Edge-side diagnosis enables low-latency decision-making near the signal source, yet artificial intelligence methods are often difficult to deploy on edge devices due to their large model sizes and high resource requirements. To overcome these challenges, an edge fault diagnosis framework integrating Autoregressive Model-Based Empirical Mode Decomposition (AR-EMD) with a lightweight Convolutional Neural Network (CNN) is proposed. The novelty of this study lies in pioneering the use of an autoregressive model to dynamically predict signal envelopes, which completely eliminates the offline batch-processing bottleneck associated with traditional cubic spline interpolation. The AR-EMD employs predictive envelope generation to achieve real-time decomposition of vibration signals into multiple Intrinsic Mode Functions (IMFs), from which features are extracted at fixed intervals and classified by the CNN. The proposed framework is successfully implemented on a Field-Programmable Gate Array (FPGA), achieving 99.42% diagnostic accuracy in online experiments. It performs real-time signal decomposition with AR-EMD, and the CNN processing requires only 0.01476 ms per input. These results demonstrate that the proposed approach provides accurate, low-latency fault diagnosis on edge devices and can be readily deployed on compact and portable systems for real-time industrial monitoring.}
}
@article{GU2026115166,
title = {From local to global: Hypergraph neural networks with holistic message passing},
journal = {Applied Soft Computing},
volume = {197},
pages = {115166},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115166},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006149},
author = {Yongchun Gu and Yi Wang and Xinxiang Wang and Jiayi Mao and Haodi Li and Ming Li},
keywords = {Hypergraph neural networks, Message passing, Hypergraph learning, Self-attention},
abstract = {Most existing hypergraph neural networks (HNNs) follow a local message-passing paradigm, which inherently limits their receptive field and hampers their ability to capture long-range dependencies. This constraint is particularly severe in heterophilic scenarios, where we empirically observe that informative signals often reside in distant neighborhoods rather than immediate ones. To bridge this gap, we propose HyperHMP, a novel framework that shifts the focus from local aggregation to holistic message passing. By leveraging a structure-aware self-attention mechanism, HyperHMP enables direct, one-hop global information propagation across nodes and hyperedges. Specifically, we first integrate learnable positional encodings via an augmented incidence matrix to inject multi-level topological awareness. To facilitate efficient global fusion, we employ a virtual-node-assisted attention mechanism that simultaneously models node-node, node-hyperedge, and hyperedge-hyperedge interactions, effectively circumventing the information dilution typically caused by deep layer stacking. Furthermore, a hypergraph structural regularization scheme is introduced to ground the global attention within the intrinsic topology. Extensive experiments on both homophilic and heterophilic benchmarks demonstrate that HyperHMP consistently achieves state-of-the-art performance. For example, HyperHMP attains classification accuracies of 80.75% on Cora, 74.74% on Citeseer, 68.17% on Senate, and 75.17% on House, outperforming strong baselines such as HyperGT and ED-HNN by noticeable margins. These results confirm that capturing holistic structural relationships is essential for robust hypergraph representation learning.}
}
@article{AYYILDIZ2026115202,
title = {Toward resilient and adaptive warehousing with fuzzy-based selection of automated storage systems for industry 5.0},
journal = {Applied Soft Computing},
volume = {197},
pages = {115202},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115202},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006502},
author = {Ertugrul Ayyildiz and Busra Kesici and Melike Erdogan},
keywords = {Industry 5.0, Warehousing systems, Multi criteria, Fuzzy},
abstract = {The advent of Industry 5.0 (I5.0) marks a new era for manufacturing and warehousing, emphasizing the synergy between advanced automation and human-centric values. This evolution has brought renewed attention to the integration of human-robot collaboration within automated storage systems, a critical component of modern manufacturing logistics. This study presents a comprehensive multi-criteria decision-making (MCDM) framework for selecting automated storage systems, aligned with the principles of I5.0 and intelligent manufacturing. Relevant evaluation criteria were identified through a literature review and validated by expert insights from the fields of industrial engineering, automation, and supply chain management. The importance of these criteria was determined using the Picture Fuzzy Analytic Hierarchy Process (PiF-AHP) method, which effectively captures uncertainty in expert judgments. Subsequently, alternative automated storage solutions were ranked using the Picture Fuzzy Combinative Distance-based Assessment (PiF-CODAS) approach. This work advances the literature by introducing a novel fuzzy MCDM methodology tailored to the challenges of intelligent and human-centered warehouse design. A real-world case study is presented to demonstrate how manufacturers can leverage I5.0 concepts, such as human-machine integration, digital transformation, and sustainability, in their selection of automated storage systems. The findings highlight key priorities for future-ready, resilient, and adaptive storage solutions in computer-integrated manufacturing environments.}
}
@article{GAO2026115167,
title = {Combining sparse evolutionary operators and deep reinforcement learning for large-scale sparse multiobjective optimization problems},
journal = {Applied Soft Computing},
volume = {197},
pages = {115167},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115167},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006150},
author = {Mengqi Gao and Xiang Feng and Bowen Sun and Jiahui Wang},
keywords = {Large-scale multiobjective optimization, Sparse Pareto-optimal solutions, Deep reinforcement learning, Evolutionary algorithm},
abstract = {Large-scale sparse multiobjective optimization problems widely exist in the real world and are characterized by large-scale decision variables and sparse Pareto-optimal solutions. Existing evolutionary algorithms encounter significant challenges when dealing with these problems, primarily due to the curse of dimensionality and the inherent difficulty in fully optimizing nonzero variables. In response to these challenges, this paper proposes an algorithm that combines evolutionary techniques and deep reinforcement learning to reduce the search space and efficiently solve large-scale sparse multiobjective optimization problems. Specifically, we propose a sparse evolutionary optimizer that includes a binary operator for searching sparse variables. Subsequently, we introduce a deep reinforcement learning optimizer to fully optimize the nonzero decision variables. The solutions generated by combining the sparse evolutionary optimizer and the deep reinforcement learning optimizer exhibit the stable performance and effective exploration capabilities of evolutionary algorithms, along with the learning ability of reinforcement learning. Experimental results on eight benchmark problems and two real-world problems demonstrate that our algorithm outperforms existing algorithms in terms of convergence speed and computational efficiency.}
}
@article{YU2026115191,
title = {A Q-learning-based multi-strategy intelligent algorithm for power system scheduling with flexible loads},
journal = {Applied Soft Computing},
volume = {197},
pages = {115191},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115191},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006393},
author = {Xiaobing Yu and Pingping Xu},
keywords = {Q-learning, Multi-strategy, Reinforcement learning, Intelligent algorithm, Power system scheduling, Flexible load},
abstract = {With the increasing integration of renewable energy sources, flexible loads have become essential for improving power system scheduling. This study develops an integrated scheduling model that considers flexible load dynamics, distributed renewable generation, battery storage, and market trading. To solve the complex and nonlinear optimization problem, we propose a Q-learning-based Multi-Strategy Intelligent Algorithm (QMSIA), which combines stochastic directional search (SDS) for global exploration and neighborhood guided refinement (NGR) for local exploitation. The Q-learning mechanism dynamically selects strategies based on past performance, enhancing convergence and solution quality. Simulation results show that the model effectively coordinates flexible loads and renewable energy, reducing operational costs and carbon emissions. The proposed algorithm outperforms traditional methods in cost reduction, convergence stability, and feasibility across two scenarios, demonstrating its effectiveness in addressing modern power system scheduling challenges.}
}
@article{HU2026115159,
title = {Few-shot classification via mix-pooling module and class-wise relationship graph similarity preserving},
journal = {Applied Soft Computing},
volume = {197},
pages = {115159},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115159},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006071},
author = {Bin Hu and Sai Yang and Xiaoxin Wu and Fan Liu and Weiping Ding},
keywords = {Few-shot classification, Pooling, Mix-pooling module, Knowledge distillation, Class-wise relationship graph similarity preserving},
abstract = {Few-Shot Classification (FSC) is committed to recognize unseen classes when presented with limited samples per class. This task has been greatly advanced by building a good embedding upon the Convolutional Neural Networks (CNNs) with the auxiliary base dataset. Our work aims to enhance the embedding for FSC from the aspects of model architecture and training algorithm simultaneously. For the former, we propose the Mix-Pooling Module (MPM) to get complete description for approaching a good embedding. MPM uses Box-Cox transformation to calibrate the followed distribution of the tensor vectors to be Gaussian-like in form and then calculates and concatenates the mean and covariance of the tensor features. Meantime, an auto-encoder is exploited to mine the correlation of the concatenated feature for the final compact representation. For the learning algorithm, we employ the Knowledge Distillation (KD) method to obtain generalization representation for unseen novel classes. Accordingly, we propose a new KD method named as Class-wise Relationship Graph Similarity Preserving (CRGSP) for the output accompanied by the similarity-based loss. CRGSP builds a new graph for the student and teacher network,where each element represents the class-wise relationship between the samples. And then we employ graph kernel to keep the similarity between the student’s and teacher’s graphs. Compared with current state-of-the-art methods, our method can make the strengths of MPM and CRGSP to obtain complete description and generalization representation, which are critical factors for FSC task. Extensive experiments have validated the effectiveness of each component in MPM and CRGSP and establish the new state-of-the-art performance on popular FSC benchmark datasets.}
}
@article{BHOJWANI2026114900,
title = {Behavior-aware deep learning framework for risk activity detection using the RBD24 dataset},
journal = {Applied Soft Computing},
volume = {197},
pages = {114900},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114900},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003480},
author = {Dipti Bhojwani and Subhash Chandra Patel},
keywords = {Cybersecurity, Deep learning, Intrusion detection system, CNN, BiLSTM, Attention mechanism, RBD24 dataset, Behavioral intrusion detection},
abstract = {This paper presents a hybrid deep learning model that integrates Convolutional Neural Networks (CNN), Bidirectional Long Short Term Memory (BiLSTM) networks, and an attention mechanism for behavioral threat detection. It is measured using the RBD24 dataset, which includes diverse cyberattack cases such as phishing, cryptojacking, and ransomware across desktop and smartphone environments. Motivation for this study lies in resolving the gap in current IDS research, where behavior based risk detection across multiple device environments remains hidden and is unsatisfactorily handled by existing models. Experimental results show that our integrated model significantly outperforms traditional machine learning baselines, achieving an F1-score of 0.9935 and a ROC-AUC of 0.98, while maintaining strong performance across device types. In addition, the analysis of high risk user behaviors offers valuable insights into modern threat vectors, supporting the development of more strong and interpretable intrusion detection systems.}
}
@article{SHENG2026115199,
title = {Multimodal assessment of upper limb rehabilitation in stroke patients based on cross-attention mechanism},
journal = {Applied Soft Computing},
volume = {197},
pages = {115199},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115199},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006472},
author = {Bo Sheng and Shuyang Li and Xiaohui Chen and Sheng Quan Xie and Aiqin Liu and Chao Wang and Qiurong Xie},
keywords = {Stroke, Multimodal data fusion, Rehabilitation assessment, Upper limb, Cross-attention mechanism},
abstract = {Stroke, characterized by high incidence, disability, and mortality rates, often causes brain damage and upper limb impairment, making objective, efficient, and personalized rehabilitation assessment crucial. This study developed a multimodal system for assessing upper limb motor function in stroke patients. First, a markerless motion capture system using the Azure Kinect DK was developed and validated against a gold standard NOKOV Motion Capture, achieving high accuracy (joint angle MAE < 6°). Second, a multi-modal feature set integrating kinematics and electromyography (EMG) data was constructed based on a customized Short-FMA test protocol. Third, an improved Res-Transformer model was proposed, demonstrating superior efficiency (40% faster training) and higher accuracy (avg. 0.807–0.811 for single modalities) compared to Transformer, LSTM, and TCN. Finally, a multimodal fusion model (ReT-CA), integrating Res-Transformer with a cross-attention mechanism, achieved a high classification accuracy (average 0.892). This model formed the core of a digital assessment system, featuring clinical score prediction, visualization, and report generation. The system offers a low-cost, accurate solution for objective stroke rehabilitation assessment, with the potential to be widely adopted in communities, hospitals, and other use scenarios.}
}
@article{CHEN2026115192,
title = {Adversarial fraud sample generation with reinforcement learning: A joint optimization framework for financial statement fraud detection},
journal = {Applied Soft Computing},
volume = {197},
pages = {115192},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115192},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600640X},
author = {Zhensong Chen and Hao Chen and Aihua Li and Yinhong Yao and Yong Shi},
keywords = {Financial statement fraud detection, Class imbalance, Reinforcement learning, Generative adversarial network, Interpretability analysis},
abstract = {Financial statement fraud detection (FSFD) is crucial for sustaining capital market stability, protecting investor confidence, and reducing systemic risks. Conventional approaches often rely on resampling or minority class sample synthesis techniques to mitigate class imbalance in FSFD. However, these methods face challenges due to poor interpretability of synthetic samples and inadequately capturing distributional shifts between fraudulent and normal samples while decoupling data balancing from classifier training. To overcome these limitations, a joint optimization framework for FSFD is proposed. Firstly, this framework constructs the GAN generator as a reinforcement learning-based “Counterfeiter” to transform the normal samples into fraudulent ones. Then, the generator is trained using a multi-objective reward function that simultaneously enhances sample fidelity and domain consistency. Finally, a closed-loop feedback mechanism dynamically evaluates synthetic samples and integrates them into classifier learning process, thereby achieving end-to-end training. Experimental studies on real financial data from the Chinese stock market demonstrate the superior performance of both the co-optimized classifier and the generated samples compared to baseline methods, with an improvement of 4.40% in F1-score, 4.44% in MCC, and 0.37% in AUC. Ablation studies further validate the necessity of each key module. Moreover, we introduce a novel interpretability analysis method that statistically characterizes perturbation magnitudes during state transitions, revealing potential risk indicators for financial manipulation.}
}
@article{YANG2026115213,
title = {Kolmogorov–Arnold networks-based GRU and LSTM for loan default early prediction},
journal = {Applied Soft Computing},
volume = {197},
pages = {115213},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115213},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006617},
author = {Yue Yang and Zihan Su and Ying Zhang and Chang Chuan Goh and Yuxiang Lin and Anthony Graham Bellotti and Boon Giin Lee},
keywords = {Time series anomaly detection, Credit risk, Machine learning, Loan default prediction},
abstract = {This study addresses a key challenge in time series anomaly detection: the prediction of loan defaults several months in advance. Using real-world monthly repayment data, the study aims to provide financial institutions with a reliable basis for proactive intervention. Existing studies often neglect early prediction capabilities and rely on out-of-sample rather than out-of-time testing, limiting the evaluation of model adaptability to evolving financial conditions and constraining the effective use of historical data. To bridge this gap, this study introduces Kolmogorov–Arnold Network (KAN)-enhanced Gated Recurrent Unit (GRU) and Long Short-Term Memory (LSTM) models, denoted as GRU-KAN and LSTM-KAN, along with a “blank interval” concept to simulate early prediction scenarios. Evaluations compare these models against baseline methods, including LSTM, GRU, LSTM-Attention, and LSTM-Transformer, across varied resampling strategies, feature window lengths, blank interval durations, sample sizes, and multi-year and cross-quarter test sets. Ablation studies isolate the individual contributions of each model component. The results of the experiments indicate that the proposed models consistently outperform the baselines, with random undersampling and feature windows of 12 to 18 months producing better performance. GRU-KAN achieves optimal results for blank intervals of 1 to 8 months, while LSTM-KAN excels for intervals of 9 to 12 months.}
}
@article{OU2026115144,
title = {Multi-objective optimization for airships aerodynamic-energy coupling based on deep reinforcement learning},
journal = {Applied Soft Computing},
volume = {197},
pages = {115144},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115144},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005922},
author = {Zhou Ou and Guanxiong Li and Yuntao Wang and Shuyuan Liu and Li Xiao and Shijing Huang},
keywords = {Multi-objective optimization, Deep reinforcement learning, Aircraft design, Surrogate model, Aerodynamic-energy coupling},
abstract = {In the optimal design of near-space airships, achieving multi-objective optimization (MOO) for the aerodynamic-energy coupling is essential for enhancing the overall performance of the airship. However, in the problem of airship aerodynamic-energy coupling optimization, as limitations of traditional methods are the follows: a large number of computational fluid dynamics (CFD) simulations are required, leading to low computational efficiency; optimization algorithms represented by genetic algorithm (GA) tend to converge to local optima and lack generalization ability; inadequate accuracy of surrogate models undermines the validity of optimization schemes. These limitations make it difficult for traditional methods to efficiently explore the optimal solutions for aerodynamics and energy under complex operating conditions. To address these challenges and improve optimization efficiency, this study proposes a Deep Reinforcement Learning (DRL)-based framework for the MOO problem. Deep Learning (DL) is first employed to construct high-fidelity surrogate models for aerodynamic drag and solar array output, enabling rapid and accurate performance prediction. The MOO of airship aerodynamic-energy coupling is accomplished using the Soft Actor-Critic (SAC) algorithm. Compared with the baseline scheme, the optimized design achieves a 20.8% reduction in drag coefficient and a 29% decrease in solar array area. Finally, comparison experiments between the DRL method and traditional optimization algorithms, along with generalization tests of the DRL method, are conducted. The results show that the DRL method demonstrates superior computational efficiency and generalization ability compared to traditional optimization methods.}
}
@article{ZHANG2026115193,
title = {FedHAP: Federated hierarchical adaptive prompt learning for cross-domain generalization},
journal = {Applied Soft Computing},
volume = {197},
pages = {115193},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115193},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006411},
author = {Chen Zhang and Jinsheng Zhang and Yu Xie and Wenjie Mao and Xinlei Wang and Bo Zhou and Bin Yu},
keywords = {Federated learning, Federated domain generalization, Prompt learning},
abstract = {Federated Learning (FL) constitutes a decentralized collaborative training framework which permits heterogeneous clients to perform local model training without directly exposing local data, enabling both privacy preservation and collaborative optimization. Large-scale pre-trained Vision-Language Models (VLMs) exhibit remarkable representational power and cross-modal generalization, offering substantial advantages across diverse downstream tasks. Nevertheless, in image-based tasks, pronounced disparities in visual distributions across clients and insufficient pixel-level representations exacerbate the inherent heterogeneity of FL. Moreover, limitations in computational capacity and communication bandwidth further constrain the integration of large-scale models within federated settings. To mitigate the aforementioned challenges, here we propose a novel framework, Hierarchical Adaptive Prompt Learning (FedHAP), which adaptively adjusts the model’s parameters using prompts to accommodate VLMs in federated cross-domain scenarios and utilizes locally learned prompts as a secure conduit for client-side knowledge sharing. FedHAP embeds prompts into both deep and shallow layers of the vision encoder and projects into the text encoder. Furthermore, the framework integrates two optimization stages: local adaptive prompt decoupling and global adaptive prompt aggregation. Initially, local adaptive prompt decoupling is performed at the client to compress high-dimensional text and visual features to low-dimensional representations, effectively mitigating individual heterogeneity. Subsequently, the server conducts attention-based global aggregation to enhance cross-domain generalization. Extensive experiments on diverse heterogeneous benchmark datasets demonstrate that FedHAP outperforms leading adaptive federated learning methods, achieving better personalization, efficient communication, and strong cross-domain generalization.}
}
@article{DU2026115052,
title = {ReVu-DEMATEL for fragile systems},
journal = {Applied Soft Computing},
volume = {197},
pages = {115052},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115052},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005004},
author = {Yuan-Wei Du and Jian-Hang Hu},
keywords = {DEMATEL, ReVu-DEMATEL, Resilience, Vulnerability, Fragile system},
abstract = {As a type of complex systems, fragile systems are prone to functional degradation or collapse due to internal failures or external disturbances. Their stable operation directly impacts socio-economic sustainability and public safety. The essential characteristic of the fragile system is that the highly interconnected components are prone to failure. Identifying the critical factors (those with strong anti-interference capability and significant impact on the system) is the basis for optimizing the system design. The original DEMATEL methodology and its extended methods identify critical factors by constructing a total-relation matrix, but they assume that the factors' functions remain normal, neglecting scenarios of factor failure, which results in identification outcomes being disconnected from actual failure conditions. To address this, the study proposes the ReVu-DEMATEL method, which comprises three key components: dynamic relationship modeling to construct a total-relation variation matrix, dual-index evaluation (resilience and vulnerability indicators), and integrated dual-index analysis to identify critical factors. Finally, the method is verified by an emergency management case, in which the critical factors of "the involvement and support of army" and "the security of relief aids during distribution and transportation" are identified, which is in sharp contrast with the results of the traditional method, and demonstrates the scientific decision-making of the more fragile system under the failure of the consideration factors. This method resolves the decision-making disconnect in original DEMATEL for fragile systems by integrating factor failure scenarios and dynamic system relationships, providing a quantifiable tool for stability optimization in critical sectors like energy and transportation.}
}
@article{DIAO2026115165,
title = {A Deep Q-Network-based Memetic Algorithm for integrated yard management with bidirectional demand response in container terminals},
journal = {Applied Soft Computing},
volume = {197},
pages = {115165},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115165},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006137},
author = {Cuijie Diao and Ying Huang and Siqi Duan and Zhihong Jin},
keywords = {Truck appointment information, Container terminal, Yard management, Workload balancing, Deep Q-Network-based Memetic Algorithm},
abstract = {The truck appointment system is widely adopted in container terminals to alleviate congestion and enhance operational predictability. This paper proposes a bidirectional demand response yard management mode, which simultaneously optimizes yard crane deployment, yard block allocation, and container task allocation by integrating vessel operation plans with truck appointment information. A mixed-integer programming model is formulated to balance the total workload among time periods and the external truck workload among blocks. Due to the complexity of the model, a novel Deep Q-Network-based Memetic Algorithm (DQNMA) is developed. Computational experiments show that DQNMA outperforms four benchmark algorithms in both solution quality and computational stability. Compared with the unidirectional demand response mode, the proposed bidirectional demand response mode achieves an average improvement of 44.35% in workload balancing. A sensitivity analysis further provides practical insights into the effects of key parameters, including the number of yard cranes and workload balancing coefficients. This study offers terminal operators a rigorous and actionable decision-support tool for improving yard operations within integrated information environments.}
}
@article{DANGELO2026115185,
title = {Inter-layer autoencoder for mitigating evasion attacks against network intrusion detection systems},
journal = {Applied Soft Computing},
volume = {197},
pages = {115185},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115185},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006332},
author = {Gianni D’Angelo and Massimo Ficco and Francesco Palmieri},
keywords = {Adversarial attacks, Adversarial defense, Robustness, Deep neural networks, Deep learning, Autoencoder, Network intrusion detection systems},
abstract = {Adversarial attacks are a growing threat to the security of network management and control applications making use of artificial intelligence and deep learning techniques. In recent years there has been an increase in the use of adversarial attacks to deceive network traffic classifiers and anomaly detection systems, which are used to identify and classify the traffic flows traversing a network and recognize among them the occurrence of malicious or anomalous behaviors. The goal of such attacks is to appropriately perturb the network traffic in a way that evades the system detection capabilities by preventing the proper identification and classification of the involved flows. In this paper, we propose a novel defense solution, named Inter-Layer Autoencoder-based architecture, for fighting evasion attacks targeting Network Intrusion Detection Systems based on Deep Learning. The proposed method can be integrated with any neural classifier and anomaly detector without any need for re-training procedures. Moreover, the suggested approach is universally applicable as it doesn’t necessitate prior knowledge of the specific attack, making it effective against a broad spectrum of attack types. The results from experiments, conducted by training a target model on the UNSW-NB15 dataset and deriving from it functionality-preserving adversarial attacks demonstrate that the suggested mechanism exhibits strong resilience. Indeed, under the considered threat model and functionality constraints, all adversarial samples derived from the UNSW-NB15 dataset were recognized, outperforming the foremost defense methods currently present in the state-of-the-art.}
}
@article{LEI2026115157,
title = {A lightweight 3D object tracking method in complex scenes},
journal = {Applied Soft Computing},
volume = {197},
pages = {115157},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115157},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006058},
author = {Xiaomei Lei and Wenhuan Lu and Jiu Yong and Chuanfang Zang and Jianguo Wei},
keywords = {3D target tracking, Complex scenes, Lightweight network, Deformable convolution, Attention mechanism},
abstract = {Real-time and stable 6-DoF tracking of 3D target objects in complex scenes is a core and challenging task in fields such as augmented reality and autonomous driving. However, 3D object tracking in complex scenes faces dual challenges of limited computing resources and dynamic environmental interference. Moreover, the complex model structures and substantial computational demands of existing mainstream deep learning-based methods limit their deployment and application on mobile devices. Therefore, this article proposes a lightweight 3D object tracking method for complex scenes. The initial contour is obtained and cropped by projecting the target object model onto image plane using the initial pose. Then, a lightweight contour feature extraction module with attention mechanism is designed to perform multi-scale feature extraction, focusing on key feature regions and reducing model parameters and computational complexity. Subsequently, a contour movement prediction network incorporating foreground and boundary statistical information as well as deformable convolution is constructed to ensure the accuracy of 3D object tracking. Finally, the reprojection error between the projected contour and the object contour is optimized to update the pose, obtaining per-frame target object pose information, which is iteratively refined to achieve real-time 3D object pose tracking. The experimental results on the RBOT and BCOT datasets show that under complex challenges such as illumination changes, noise interference, target occlusion, and limited computing resources, our method effectively reduces accuracy loss and improves real-time performance, striking balancing the accuracy and real-time performance of 3D object tracking.}
}
@article{ZHANG2026115136,
title = {Context-aware and structure-enhanced graph contrastive learning for third-party library recommendation in mobile app development},
journal = {Applied Soft Computing},
volume = {197},
pages = {115136},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115136},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005843},
author = {Zilong Zhang and Duantengchuan Li and Tongyue Zhu and Jian Wang and Bing Li},
keywords = {Recommendation system, Third-party library recommendation, Graph contrastive learning, Knowledge graph},
abstract = {With the rapid growth of mobile applications, third-party libraries (TPLs) have become indispensable for efficient app development. However, selecting suitable TPLs from a vast TPL pool remains challenging and time-consuming. Existing recommendation methods mainly rely on App-TPL interactions or use coarse-grained knowledge graphs, failing to fully exploit multi-dimensional semantic information and thus limiting recommendation effectiveness. To overcome these limitations, we construct a fine-grained, semantically enriched knowledge graph (KG) for TPLs, capturing multi-dimensional invocation relationships such as functional types, contexts, and input–output characteristics. This complements traditional interaction graphs with richer semantics. Building on this, we propose CSRec, a context-aware and structure-enhanced dual-view contrastive-learning model for TPL recommendation. CSRec jointly models App-TPL interaction and knowledge graphs from both structural and semantic perspectives, employing graph spectral encoding and a Transformer encoder for structure-aware representations, and introducing a context-aware mechanism for capturing invocation semantics. Dual-view contrastive learning further aligns structural and semantic representations, significantly improving recommendation performance and robustness, especially in sparse data scenarios. Extensive experiments on real-world datasets show that CSRec consistently outperforms state-of-the-art baselines in both recommendation accuracy and generalization. Our code is publicly available at https://github.com/dacilab/CSRec.}
}
@article{LI2026115197,
title = {Multiset-driven attribute reduction for partially labeled hybrid data using fuzzy evidence theory and Gaussian kernel},
journal = {Applied Soft Computing},
volume = {197},
pages = {115197},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115197},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006459},
author = {Zhaowen Li and Jingyi Sun and Guangming Xue and Yonghua Lin and Ning Lin},
keywords = {Attribute reduction, Partially labeled hybrid data, Fuzzy evidence theory, Gaussian kernel, Multiset, Semi-supervised learning, Hybrid decision systems},
abstract = {As a generalization of traditional sets, a multiset can be used to represent object data, allowing certain data to appear multiple times. Capturing their frequencies can more accurately describe and analyze these data. This study proposes a multiset-driven approach for attribute reduction in partially labeled hybrid data using fuzzy evidence theory and Gaussian kernel. In a multiset decision information system label frequencies are used to represent known decisions and unlabeled objects are modeled as probability distributions over classes. Hellinger distance is employed to compute distances between objects and construct the fuzzy Tcos-equivalence relation via Gaussian kernel. Fuzzy evidence theory defines fuzzy belief and plausibility maps based on fuzzy lower and upper approximations and designs two heuristic reduction algorithms. Experimental results on 15 datasets demonstrate that these algorithms outperform five existing methods in classification tasks and accuracy, highlighting the effectiveness of the multiset-driven framework in handling partially labeled hybrid data.}
}
@article{XUE2026115112,
title = {A mechanism-guided multimodal industrial copilot with incremental learning for natural products manufacturing},
journal = {Applied Soft Computing},
volume = {197},
pages = {115112},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115112},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005600},
author = {Qilong Xue and Yang Yu and Yequan Yan and Jingxuan Zhang and Zheng Li},
keywords = {Mechanism-guided large language model, Multimodal industrial copilot, Modal alignment, Natural products manufacturing},
abstract = {Natural products manufacturing processes are characterized by nonlinearity and time-varying dynamics, making it difficult for traditional methods to provide stable decision support under shifting operating conditions. This work proposes a knowledge-centric multimodal industrial copilot that addresses these challenges through three core innovations. First, an event-triggered acquisition and indexing pipeline is built to synchronize video and time-series signals into a searchable decision knowledge base, enabling the capture of expert tacit knowledge. Second, intent-conditioned cross-modal alignment is learned for joint operating state recognition and parameter adjustment, and mechanistic feasibility is injected directly into training via a physics-consistency objective derived from energy balance and heat transfer equations. Third, to enable long-term reliability and on-site deployment, the copilot further adopts continual incremental learning to counter distribution shift and knowledge distillation for resource-constrained edge inference. The dataset is collected from a real industrial unit covering four representative operating conditions. Experiments show 97.7% recognition accuracy and 2.415 mean absolute error for parameter adjustment. Mechanistic constraints reduce control error by about 80%, and incremental learning maintains recognition accuracy above 90% across seasons, outperforming strong baselines in robustness. The proposed framework provides practical, physically safe, and continually adaptive decision support for process industries.}
}
@article{WANG2026115131,
title = {Anomaly detection of UAV flight data based on spatiotemporal feature fusion},
journal = {Applied Soft Computing},
volume = {197},
pages = {115131},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115131},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600579X},
author = {Jialiang Wang and Qixing Liao and Zhaojun Gu and Liuyang Nie},
keywords = {Unmanned aerial vehicle, Spatiotemporal feature fusion, Maximal information coefficient, Graph attention network, Cross-attention},
abstract = {Unmanned Aerial Vehicle (UAV) systems are complex, with flight parameters exhibiting highly coupled spatiotemporal dependencies. Existing anomaly detection methods often lack effective feature selection mechanisms and struggle to capture dynamic spatiotemporal correlations among variables adequately. To address these challenges, this paper proposes a spatiotemporal feature fusion model for detecting anomalies in flight data. Initially, the Maximal Information Coefficient (MIC) is used to select a parameter subset that is highly correlated with the target variables. Subsequently, the TimesBlock models temporal dependencies, while the GatBlock captures complex spatial correlations among variables. Following feature extraction, a cross-attention mechanism fuses these features to generate a robust spatiotemporal representation. Finally, the fused features are fed into a reconstruction layer to generate reconstructed outputs. Experimental results on the publicly available UAV flight datasets, Thor Flight 104 and ALFA, demonstrate that the proposed method achieves average F1-scores of 96.27%, 95.98%, and 95.52% across three common anomaly types. Compared to baseline models such as the Deep Autoencoding Gaussian Mixture Model (DAGMM) and Graph Deviation Network (GDN), our approach yields improvements ranging from 10.67% to 36.76%, with an average gain of 22.76%.}
}
@article{SUN2026115173,
title = {Reinforcement learning for tax policy optimization: A multi-agent game theoretic approach in simulated economies},
journal = {Applied Soft Computing},
volume = {197},
pages = {115173},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115173},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006216},
author = {Yuxiang Sun and Tingshuai Wang and Xuhua Zhao and Xinming Zhang and Xianzhong Zhou},
keywords = {Economic policy, Social welfare, Intelligent games, Reinforcement learning, Multi-agent},
abstract = {Traditionally, economic models have often been based on fixed assumptions and analyzed within static scenarios. Despite the introduction of numerous rationality assumptions to enhance model accuracy, economists have long sought a more flexible and dynamically adaptive model to capture the patterns of evolving economic and social dynamics, thereby finding more precise models to represent socio-economic laws. In this study, we built an economic engine grounded in multi-agent intelligent game simulations and employed reinforcement learning techniques to simulate economic activities. By establishing diverse agent behaviors across three industries and implementing taxation adjustment policies, we simulated and deduced socio-economic activities. Our simulation experiments confirmed that multi-agent intelligent game simulations, underpinned by reinforcement learning, can to some extent capture valuable economic operational patterns. The AI tax table, derived from the intelligent game engine, proves to be more realistic; it can boost overall societal production while ensuring maximal social fairness, thus finding a valuable local Nash equilibrium.}
}
@article{LIN2026115154,
title = {An integrated data envelopment analysis-machine learning framework for evaluating pension fund management efficiency},
journal = {Applied Soft Computing},
volume = {197},
pages = {115154},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115154},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006022},
author = {Sheng-Wei Lin and Wen-Min Lu},
keywords = {OR in government, Data envelopment analysis, Machine learning integration, Pension fund management, Resource allocation},
abstract = {This paper develops an integrated framework that combines Directional Distance Function Shared Dynamic Network Data Envelopment Analysis (DDF-SDNDEA) with machine learning to address limitations of traditional efficiency evaluation. The framework leverages DEA's theoretically grounded frontier measurement, incorporating shared resources and network structures, and employs a comprehensive machine learning comparison framework encompassing 11 models (including SVR, tree-based methods, and ensemble strategies) to capture non-linear operational relationships, thereby enabling predictive efficiency forecasting. Using data from 34 Investment Trust Companies managing Taiwan's pension funds (2016–2023), we demonstrate substantial analytical enhancements over conventional approaches. Results reveal significant efficiency heterogeneity across ownership structures and divisions: operating divisions achieve a mean efficiency of 0.651, compared to 0.479 for bond fund divisions. Financial holding ITCs excel in operating divisions (0.722) and bond fund management (0.604). Foreign-owned ITCs demonstrate advantages in equity fund operations (0.518). Temporal analysis uncovers divergent post-2019 trajectories, with bond fund operations improving while equity fund efficiency declines. The weighted ensemble model achieves an R² of 0.402, representing a 571.7% improvement over the naive mean baseline, with a bootstrap 95% CI [0.195, 0.562]. Feature importance analysis identifies lag efficiency, departmental balance, and relative performance positioning as dominant predictors. The multidimensional efficiency-based decision matrix provides public administrators with an evidence-based methodology for selecting discretionary investment partners. This research advances operations research by demonstrating how methodological integration transcends the limitations of individual techniques, thereby enhancing decision support for financial institution evaluation and pension fund optimization.}
}
@article{XIAO2026115178,
title = {FMLNet: A lightweight camouflage object detection network via frequency-RGB multi-domain feature mutual learning},
journal = {Applied Soft Computing},
volume = {197},
pages = {115178},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115178},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006265},
author = {He Xiao and Liping Deng and Xue Chen and Haiyang Zou},
keywords = {Camouflaged object detection, Frequency domain, Wavelet transform, Feature mutual learning},
abstract = {Camouflaged Object Detection (COD) remains challenging due to ambiguous boundaries, background-like textures, and scale variations. Most existing methods rely on either RGB-domain representations or frequency-domain cues in isolation, limiting their ability to exploit complementary information, while high accuracy often comes at the cost of heavy model complexity. To address these issues, we propose FMLNet, a lightweight COD framework based on frequency-RGB multi-domain feature mutual learning, in which a bi-directional wavelet interaction mechanism is introduced to enable effective information exchange between the frequency and RGB domains. Specifically, the bi-directional wavelet interaction module (BWIM) enhances frequency-domain representations via discrete wavelet transform, further reinforced by a multi-scale frequency-domain attention interaction module (IMSFA). The wavelet interaction and reconstruction module (WIRM) then projects frequency-domain features back to the RGB domain to ensure accurate cross-domain alignment. In addition, a mutual learning-based fusion module (MLFM) integrates cross-convolution, boundary-aware guidance, and attention mechanisms for deep frequency-RGB feature fusion. Extensive experiments demonstrate that, with only 2.77M parameters, FMLNet outperforms existing lightweight COD methods and achieves competitive performance compared with computationally intensive architectures, making it suitable for resource-constrained deployment.}
}
@article{NEZHADSHAHMOHAMMAD2026115170,
title = {Deep feature learning and structure-aware clustering for scalable optimization in block-cave production scheduling},
journal = {Applied Soft Computing},
volume = {197},
pages = {115170},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115170},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006186},
author = {Farshad Nezhadshahmohammad and Naeimeh Akbari-gharalari and Yashar Pourrahimian},
keywords = {Deep unsupervised feature learning, Block-cave production scheduling, Structure-aware clustering, Data-driven resource optimization, Mixed-integer linear programming (MILP)},
abstract = {Contemporary engineering increasingly requires methods that transform large-scale, heterogeneous datasets into structured knowledge for reliable decision support. In block-cave mining, long-term scheduling has extended over decades and coordinates hundreds of drawpoints and millions of tonnes of ore. Conventional optimization approaches struggle because decision variables and constraints grow rapidly, solution times can extend to days, and simplifying assumptions, such as neglecting grade variability or geotechnical constraints, undermine model reliability. To address this challenge, we propose a scalable framework that integrates a deep stacked sparse autoencoder (DSSAE) with density-based spatial clustering of applications with noise (DBSCAN) to generate compact, geologically informed aggregates, which are then optimized within an MILP model. The DSSAE learns latent representations that preserve grade and spatial heterogeneity, whereas DBSCAN adaptively groups drawpoints without requiring a predefined number of clusters. When applied to an industrial-scale case (941 drawpoints; 299 Mt), the framework reduced the model size by more than an order of magnitude while retaining economic fidelity. At an 11% optimality gap relative to a detailed MILP, the cluster-based model achieved 92.1% net present value (NPV) and 94.4% tonnage under one minute, whereas the detailed model achieved 41.3 h. At a 0.1% gap, it reproduced the detailed model’s NPV within 10 min and extracted 96% of the tonnage, whereas the detailed model did not converge within a feasible runtime. Overall, integrating deep learning with structure-aware clustering achieves a practical balance between computational tractability and economic fidelity, with applicability to other engineering domains characterized by large-scale, heterogeneous, and spatially correlated data.}
}
@article{LI2026115147,
title = {Natural granular-ball anomaly detection},
journal = {Applied Soft Computing},
volume = {197},
pages = {115147},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115147},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005958},
author = {Qilin Li and Yizhi Liu and Baiyang Chen and Zhong Yuan and Dezhong Peng and Shihao Wang},
keywords = {Anomaly detection, Granular-ball computing, Natural outlier factor, Multi-granularity, Parameter-free},
abstract = {Unsupervised anomaly detection is a crucial task in intelligent data analysis, widely used in fields such as fraud detection, process monitoring, and sensor networks. Multi-granularity modeling is an effective strategy for capturing both global and local data characteristics, enabling a more comprehensive understanding of complex data distributions. However, few existing studies fully explore the potential of multi-granularity representation in building anomaly detection models, especially under a parameter-free framework. To this end, this paper proposes a novel anomaly detection method called natural granular-ball anomaly detection, which integrates granular-ball computing with the concept of natural outlier factor. In this method, relationship of natural neighbors is first constructed to model local proximity without requiring manually defined parameters. Then, granular-balls are formed adaptively based on the data and perform coverage on the data. Based on this multi-granularity structure, the anomaly score of each instance is calculated by jointly considering local density and global topological context. Finally, a granular-ball-based anomaly detection algorithm is developed to detect abnormal instances. Experimental results on multiple benchmark datasets demonstrate that the proposed method not only avoids parameter sensitivity but also achieves superior performance compared with existing algorithms. The source codes are publicly available at https://github.com/Caspar-lab/NGBAD.}
}
@article{LIU2026115139,
title = {RUL prediction of engine turbine blades based on physical information fusion and federated ensemble learning},
journal = {Applied Soft Computing},
volume = {197},
pages = {115139},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115139},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005879},
author = {Junqiang Liu},
keywords = {Turbine blade, Physical information fusion, Federated ensemble learning, Degradation characteristics, Interpretability analysis},
abstract = {Current remaining useful life (RUL) prediction methods of turbine blade rarely consider physical information fusion and interpretability analysis together. Moreover, these methods lack effective physical explanation and dynamic learning ability. Therefore, this paper proposes a new RUL prediction approach based on physical information fusion and federated ensemble learning. A new health index based on sensor monitoring data, physical degradation data and imperfect maintenance data is constructed for high-pressure turbine blade. The theorem of convergence is proved. A novel base learner selection with weight optimization algorithm based on two-level selective strategy is developed. An effective meta learning algorithm based on gradient-guided adaptation is presented. Furthermore, a novel global aggregation algorithm based on federated ensemble learning and sharing prototype is presented. Experimental results show that: 1) Developed federated ensemble learner has better performance than state-of-the-arts methods in complex degradation situations; 2) Meta learning, two-level selective strategy and physical information fusion have important roles in prediction performance; 3) Proposed method has excellent results of interpretability analysis and phase division.}
}
@article{JOHNY2026115212,
title = {Bridging physics and machine learning: AI-enhanced WRF ensemble approach to extreme rainfall prediction},
journal = {Applied Soft Computing},
volume = {197},
pages = {115212},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115212},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006605},
author = {Kavya Johny and M.G. Manoj and Fathima C Rasla and Ashish Shaji and Omveer Sharma},
keywords = {Artificial intelligence, Weather research forecasting, Modelling, Data assimilation, Long short-term memory},
abstract = {Extreme weather remains poorly predicted globally due to the rarity, rapid intensification, and inadequate representation in numerical models, thereby limiting forecast skill. With the frequency of extremes rising, reliable forecasts with sufficient lead-time are essential for disaster mitigation. Here, we evaluate rainfall forecasts by integrating AI with Weather Research and Forecasting (WRF) model ensembles during the catastrophic Kerala flood of 14–16 August 2018. Optimized WRF parameterization enhances baseline skill, while En3DVar data assimilation further improves spatial correlation against IMD daily observations from 0.09 to 0.30 (Domain 2, Δ = +0.21) and from 0.10 to 0.69 (Domain 1, Δ = +0.59) for the peak flood day (16 August). We introduce a hybrid WRFDA–Long Short-Term Memory (LSTM) framework that integrates En3DVar-corrected WRF outputs with deep learning post-processing for regional extreme rainfall forecasting, an approach that, to our knowledge, has not been previously demonstrated for convection-permitting ensemble rainfall prediction over complex orographic terrain, which achieves final spatial correlations of 0.69 (Domain 1) and 0.66 (Domain 2) against IMD daily observations, representing total improvements of Δ = +0.59 and Δ = +0.57 respectively over the WRF standalone baseline, with additional LSTM contributions of Δ = +0.00 (Domain 1) and Δ = +0.36 (Domain 2) over WRFDA alone. The LSTM further reduces mean absolute error to 37.90 mm day⁻¹ (Domain 1) and 42.73 mm day⁻¹ (Domain 2) against IMD, compared to 63.85 and 66.81 mm day⁻¹ for the WRF standalone, reductions of 41% and 36% respectively. Nash–Sutcliffe Efficiency improves from −0.88 to 0.44 (Domain 1) and from −1.01 to 0.40 (Domain 2), confirming forecast skill beyond a simple mean reference. Both spatial correlations are statistically significant at the 5% level (p < 0.05; p = 2.52 ×10⁻⁵ and 3.85 ×10⁻⁵ respectively) after accounting for spatial autocorrelation. This fusion of physics-based modelling and deep learning significantly advances extreme rainfall forecasting, offering operationally feasible applicability in tropical regions experiencing rapid climate shifts.}
}
@article{LU2026115223,
title = {Brightness improvement and detail refinement network for image enhancement of table grape under auxiliary illumination},
journal = {Applied Soft Computing},
volume = {197},
pages = {115223},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115223},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600671X},
author = {Wenjing Lu and Shouguo Zheng and Shuan Yu and Shizhuang Weng and Mengqing Qiu and Chunchen Qian and Gongqin Zhu},
keywords = {Table grape, Illumination adaptation, Structure sharpening, Noise correction},
abstract = {Table grapes are commonly picked early in the morning with the aid of auxiliary lighting. However, complex illumination environments create considerable difficulties for reliable vision-based robotic harvesting. Existing image enhancement methods still suffer from uneven brightness and poor texture clarity. To address these issues, we propose a Brightness Improvement and Detail Refinement Network (BIDRN) to enhance grape images captured under auxiliary lighting. BIDRN consists of an Illumination Adaptation Block (IAB), a Structure Sharpening Block (SSB), and a Noise Correction Block (NCB), which jointly balance illumination normalization, detail preservation, and noise suppression. In addition, we propose a new metric, structural integrity and visual clarity (SIVC), to jointly evaluate noise removal and texture retention. On our grape dataset, BIDRN achieves 21.108 in PSNR, 0.697 in SSIM, and 0.763 in SIVC. Moreover, the enhanced images further improve downstream grape-and-stem detection performance. Overall, BIDRN provides luminance-balanced, detail-preserved, and noise-robust enhancement for grape images captured under auxiliary lighting, offering a reliable visual foundation for robotic localization and harvesting.}
}
@article{JIA2026115134,
title = {Multi-objective projection pursuit approach for environmental quality evaluation of storage cabinets in a museum},
journal = {Applied Soft Computing},
volume = {197},
pages = {115134},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115134},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600582X},
author = {Wentao Jia and Siyuan Ren and Jing Lei},
keywords = {Comprehensive evaluation method, Environmental quality assessment, Multi-objective projection pursuit, Data-driven model, Heritage conservation environment},
abstract = {The environmental quality evaluation of storage cabinets in a museum is crucial for the preventive conservation of cultural relics and early warning of environmental risks. To enhance the reliability of environmental quality assessment, this study introduces a comprehensive evaluation framework that integrates multi-source monitoring data and systematically addresses the synergistic interactions between multimodal environmental parameters. A novel multi-objective projection pursuit evaluation model is proposed, which simultaneously achieves model training and adaptive model parameter adjustment, improving adaptive performance. A novel solver is proposed to optimize the multi-objective projection pursuit model by designing an innovative optimization framework to integrate single- and multi-objective evolutionary algorithms. Through the introduction of an auxiliary optimization problem, the single-objective optimizer rapidly converges to high-quality solutions for the population initialization of the subsequent multi-objective optimization process, while the multi-objective optimizer handles multiple conflicting objectives and comprehensively explores solution space. This integration through phased computation and information transfer improves solution quality. Experimental results demonstrate that, compared to popular evaluation methods, the proposed method can identify subtle environmental fluctuations and provide more reliable evaluation results. Moreover, this novel approach has good robustness, and the evaluation results do not exhibit significant fluctuations with changes in noise. This approach offers a new perspective for monitoring and risk management of environmental quality in storage cabinets, contributing to more effective preventive conservation strategies.}
}
@article{ZHU2026115164,
title = {Network spatio-temporal propagation of low-carbon behavior and carbon emission path identification prediction based on statistical analysis and intelligent algorithm},
journal = {Applied Soft Computing},
volume = {197},
pages = {115164},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115164},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006125},
author = {Linhe Zhu and Li Miao and Shuling Shen},
keywords = {Green behavior, Multiplex network, Reaction–diffusion system, Parameter identification, Neural network},
abstract = {Promoting green low-carbon national action and cultivating public awareness of green life is an important way to help the country achieve the goal of carbon peak and carbon neutrality. The popularization process of residents’ green behavior is inevitably accompanied by dynamic processes such as information transmission and consciousness transformation. In this paper, by introducing the propaganda power of individual residents and the policy virtual layer that has dual effects on behavior and consciousness, a multiplex network model about information diffusion and green behavior spreading is considered. The state transition equations are given based on the interrelationship between the network layers and within the network layer. Moreover, the threshold analysis of the group with green behavior state is carried out. Furthermore, a reaction–diffusion system with self-diffusion term is established to characterize the spatial distribution of low-carbon behavior according to the action mechanism of green behavior spreading layer. The existence conditions of equilibrium points and the necessary conditions for system stability and diffusion-induced Turing instability are analyzed. Meanwhile, based on the optimal control theory, we derive the parameter identification technique of the reaction–diffusion system in continuous space and network space respectively. In addition, parameter recognition based on statistical features and convolutional neural networks is applied and compared with optimization algorithm. Optimization algorithm has certain advantages in model evolution and practical application. Finally, in a wide range of numerical simulation and empirical analysis results, we focus on the important influence of various system parameters and network structures on the propagation evolution process and spatial distribution dynamics of green behavior groups, and introduce the concept of “Normalized Green-behavior High-Distribution Area (NGHDA)”. We also study the performance of parameter identification technology under different model structures, and compare the performance of four different algorithms. We have applied the parameter identification technology in practice, put forward the carbon emission path prediction, and discussed the carbon peak prediction results in Beijing, Jiangsu, Guangdong and Shanxi provinces by using BP neural network method. The results above verify the reliability and practical significance of our method, and provide a new way to study and discuss the prevalence of residents’ green behavior.}
}
@article{LI2026115075,
title = {MPH-YOLO: An underwater object detection framework with multi-scale fast selective fusion, parallel heterogeneous residual, and hybrid image enhancement},
journal = {Applied Soft Computing},
volume = {197},
pages = {115075},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115075},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005235},
author = {Pinrui Li and Moufa Hu and Dan Xu},
keywords = {Underwater object detection, Multi-scale, Residual, Image enhancement},
abstract = {Underwater object detection is crucial for marine exploration but is often hindered by background interference and limited feature extraction in traditional algorithms. To address these difficulties, this study proposes MPH-YOLO. First, the study introduces a Multi-scale Fast Selective Fusion Module (MFSFM) and integrates it into the neck networks. This module reduces redundant computation and memory access while adaptively adjusting its receptive field size, thereby enhancing the model’s feature extraction capability and improving its ability to recognize underwater objects in complex environments. Second, a Parallel Heterogeneous Residual Module (PHRM) is proposed. Through parallel heterogeneous fusing of multi-scale features in parallel, the model’s feature fusion capability for underwater objects is further enhanced. Finally, a Hybrid Image Enhancement (HIE) method is adopted for training set preprocessing, further improving the quality of the training set. Experimental results show that the MPH-YOLO algorithm outperforms existing underwater object detection methods across various model scales. On the RUOD dataset, MPH-YOLO-N improved mAP50 and mAP50−95 by 2.7 % and 3.9 %, respectively, and on the DUO dataset, MPH-YOLO-N improved mAP50 and mAP50−95 by 2.5 % and 3.6 %, respectively, highlighting its superior performance in complex underwater object detection scenarios.}
}
@article{KEIKHA2026115127,
title = {CF-X: A multi-view chaotic-fuzzy network representation learning framework for heterophilic graphs},
journal = {Applied Soft Computing},
volume = {197},
pages = {115127},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115127},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005752},
author = {Mohammad Mehdi Keikha and Hassan Rezaei},
keywords = {Network representation learning, Heterophilic graphs, Universal framework, Chaotic dynamics, Fuzzy logic, Random walk, GNNs},
abstract = {Graph Neural Networks (GNNs) are a prevalent approach for Network Representation Learning, but their reliance on the homophily assumption limits their efficacy on heterophilic graphs, where connected nodes exhibit dissimilar features and labels. In such disassortative settings, standard message-passing mechanisms often aggregate features from dissimilar neighbors, leading to the over-smoothing of distinguishable node representations. To overcome this limitation, we propose CF-X, a flexible, model-agnostic framework designed to improve the robustness of various backbone models against heterophilic noise. CF-X operates by decoupling feature enrichment from the message-passing stage through the integration of three complementary views. Specifically, the framework incorporates Chaotic Dynamics, utilizing deterministic ergodicity to inject non-linear diversity and prevent representation collapse; Fuzzy Logic, to robustly model the uncertainty inherent in boundary nodes; and Random Walk (RW) structural features, capturing global topological context beyond immediate neighbors. We validate CF-X through rigorous experimentation on key heterophilic benchmarks. By instantiating CF-X with a diverse range of backbones, we demonstrate that our framework not only significantly improves accuracy but also reduces performance variance, acting as a stabilizer for learning on small, noisy graphs. Furthermore, it improves the performance of traditional models (e.g., GCN, GAT) that typically underperform in heterophilic settings, while providing complementary gains to specialized SOTA architectures.}
}
@article{INDURAINIBERO2026115188,
title = {RIOWA: Restricted induced ordered weighted averaging operators, applied to missing data imputation},
journal = {Applied Soft Computing},
volume = {197},
pages = {115188},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115188},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006368},
author = {Alfonso Indurain-Ibero and Benjamín Bedregal and Mikel Ferrero-Jaurrieta and Javier Fernandez and Humberto Bustince},
keywords = {Data fusion, OWA operator, Induced OWA operator, Data imputation},
abstract = {Ordered Weighted Averaging (OWA) operators and their extensions, such as Induced OWA (IOWA) operators, are widely used in the field of data fusion, as they enable the assignment of importance to each piece of data. This property is achieved by combining a set of weights with the sorting of the operator’s inputs, which is particularly valuable in applications such as missing data imputation. However, when duplicated data are present, classical ordered weighted operators cannot distinguish whether duplicates are real or a consequence of data quality problems. This may lead to undesired weights that have a bias towards repeated values rather than actual data distributions. To remove this potential bias and better adapt to dataset distributions, we introduce in this paper a new family of operators, called Restricted IOWA (RIOWA), that only operates with unique inputs. We study the fundamental properties of these operators, and we apply them to tackle the problem of missing data imputation and compare their performance against that of the original OWA and IOWA operators.}
}
@article{LI2026115240,
title = {Dynamic trust evaluation based on heterogeneous graph convolution network and lightweight attention},
journal = {Applied Soft Computing},
volume = {197},
pages = {115240},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115240},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006885},
author = {Pengyong Li and Meng Wu and Jiaqi Xia and Siguang Chen and Wei Shi},
keywords = {Dynamic trust evaluation, Heterogeneous graph convolutional networks, Lightweight attention mechanisms, Industrial internet of things, Edge computing},
abstract = {Edge-enabled Industrial IoT serves as a critical enabler for smart manufacturing systems, yet it encounters significant challenges in dynamic trust evaluation due to inherent node heterogeneity, stringent resource constraints, and the spatiotemporal evolution of cyber threats. To address these issues, this article proposes a novel dynamic trust evaluation method that integrates heterogeneous graph convolutional networks and lightweight multi-head attention mechanisms. The heterogeneous graph convolution component effectively models multidimensional heterogeneity through meta-path-guided feature aggregation, capturing complex node relationships. Concurrently, the lightweight attention mechanism facilitates resource-efficient adaptive inference, ensuring low-latency responsiveness on edge devices. Experiments on widely-adopted public benchmark datasets for trust evaluation demonstrate that the proposed method achieves superior performance, with a peak MCC improvement of 32.7% at a critical dynamic time slot, and excels in overall temporal dynamic modeling and robustness against collusion attacks, outperforming baseline methods such as GATrust and TrustGuard. This work offers a scalable, interpretable, and secure trust management solution for industrial edge deployments.}
}
@article{SU2026115156,
title = {Adaptive graph convolution neural networks with spatial and frequency domain attention mechanism for traffic flow forecasting},
journal = {Applied Soft Computing},
volume = {197},
pages = {115156},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115156},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006046},
author = {Liyun Su and Jingchao Huang and Fenglan Li},
keywords = {Traffic flow forecasting, Adaptive graph convolution, Spatial attention, Frequency domain attention},
abstract = {Traffic flow prediction plays a crucial role in alleviating traffic congestion and low carbon emission. The inherent complexity and dynamic nature of traffic flow prediction pose challenges to accurate traffic flow prediction. Recent Recurrent Neural Networks (RNNs), their variant Long Short-Term Memory (LSTM) networks, and Graph Convolutional Networks (GCNs) have demonstrated effectiveness in modeling complicated spatial-temporal dependencies and achieved promising result. However, existing approaches relying on static node adjacency relationships and often struggle to leverage sophisticated spatial-temporal architecture design, which constrained the prediction precision. To address these challenges, this paper proposes a simple traffic flow prediction framework that integrates three innovative components: 1) a spatial attention mechanism to characterize global spatial dependencies, 2) dynamically adaptive graph convolutional node embedding where attention-derived node similarities serve as dynamic adjacency matrices, and 3) a frequency-domain attention mechanism for efficient temporal feature processing. Comprehensive experiments conducted on three real-world datasets demonstrate the superiority of our model: (1) For 15-min short-term prediction, MAE/RMSE metrics show better results compared with baseline optimal performance; (2) 30-min mid-term prediction achieves significant MAE/RMSE improvement; (3) While 60-min long-term prediction exhibits a slight RMSE increase; (4) Considering integrated short/mid/long-term performance, the proposed model achieves obvious overall MAE/RMSE reduction on test sets. These results validate the effectiveness of our approach in balancing prediction accuracy across multiple temporal horizons.}
}
@article{ZHAO2026115253,
title = {Feature selection for label distribution learning via conditional discrimination index and informational weighted neighborhood rough set model},
journal = {Applied Soft Computing},
volume = {197},
pages = {115253},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115253},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007015},
author = {Zhengwei Zhao and Mengyang Duan and Yonghua Lin and Zhaowen Li},
keywords = {Label distribution learning, Informational weighted neighborhood rough set model, Dependence, Conditional discrimination index, Feature selection},
abstract = {Due to potential correlations between labels and multiple attributes, label distribution learning (LDL) often faces the disaster of dimensionality in high-dimensional feature spaces. Feature selection, as a commonly used dimensionality reduction approach, removes redundant features while preserving key information, thereby alleviating this issue. Weighted neighborhood rough set (WNRS) can combine local neighborhood structure with attribute importance, and is therefore widely applied in feature selection. However, most existing algorithms rely on label information or heuristic strategies and lack a unified information-theoretic framework to systematically evaluate the contribution of attributes to overall data uncertainty, and they pay little attention to the application of WNRS in LDL. To address the above situation, this paper proposes Informational Weighted Neighborhood Rough Set (IWNRS) and considers its application to feature selection in LDL. It first defines informational weight based on information entropy and constructs an informational weighted distance function to calculate the informational weighted distance between two instances. Based on this, it proposes an IWNRS model by defining informational weighted neighborhood relations and corresponding informational weighted upper and lower approximations, integrating attribute significance with local structure to enhance feature selection. Finally, this paper designs two feature selection algorithms, namely IWDLFS and IWCLFS, using dependence and conditional discrimination index as evaluation criteria. Comparative experiments on 11 multi-label datasets show that the proposed algorithms outperform five existing advanced algorithms in classification performance and robustness. The codes are publicly available online at https://github.com/dmyuser/algorithm-code.}
}
@article{WASIM2026115180,
title = {Symmetrical behaviors based on order relations in advanced fuzzy soft sets for optimization and collaborative solutions},
journal = {Applied Soft Computing},
volume = {197},
pages = {115180},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115180},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006289},
author = {Amna Wasim and Muhammad Saeed and Muhammad Haris Saeed and Muhammet Deveci and Mazin Abed Mohammed and Hana Tomášková},
keywords = {Fuzzy set, Soft set, Relations, Order isomorphism, Optimization},
abstract = {Symmetries play an integral role in several areas, reflecting stability, order, and magnificence, simplifying complex problems, and allowing for more streamlined analysis and solutions by leveraging the intrinsic consistency of shapes and structures. To analyze symmetrical behaviors between two structures, the concept of order serves as a pivotal mathematical tool that ensures the uniform and balanced formation of patterns at each phase, ultimately leading to improved functionality, attractiveness, and clarity with a variety of applications in rating, ranking, sorting, lattice modeling, and optimization. In this paper symmetries have been discussed based on order relations in fuzzy soft set-like structures FˇŠLs such as fuzzy soft sets FˇŠ, intuitionistic fuzzy soft sets ǏFˇŠ, neutrosophic soft sets ŇŠ, fuzzy hypersoft sets FˇȞŠ, intuitionistic fuzzy hypersoft sets ǏFˇȞŠ and neutrosophic hypersoft sets ŇȞŠ by introducing elements and members in their respective domains. This innovative approach aims to correspond the concepts of ordering and symmetrical behaviors in FˇŠLs with those of classical set theory. Fundamental properties of relations such as reflexivity, symmetry, anti-symmetry, and transitivity are introduced with elements and members, the extreme members of partially ordered FˇŠLs and order isomorphism are accompanied by illustrative numerical examples. It has been investigated how to associate symmetrical behaviors of two FˇŠLs by providing a comprehensive description to assist the collaboration of two teams in launching a product for a company to obtain the optimal solutions. Moreover, a structured way is presented for the feasible collaborations of active pharmaceutical ingredients and excipients for the preparation of different dosage forms of a drug, by ensuring the contribution of all parameters holistically, along with their combined levels of effectiveness.}
}
@article{DENG2026115232,
title = {A dynamic multi-dimensional globally aware graph convolutional network for traffic prediction},
journal = {Applied Soft Computing},
volume = {197},
pages = {115232},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115232},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006800},
author = {Xiang Deng and Chuanming Chen and Jian Zhang and Cunmin Li and Qingying Yu and Xiaoyao Zheng},
keywords = {Traffic forecasting, Intelligent transportation systems, Spatio-temporal graph neural networks, Dynamic graph convolution, Meta-parameter learning, Trend-alignment attention, Spatio-temporal heterogeneity},
abstract = {Traffic forecasting is critical for intelligent transportation systems. However, existing spatio-temporal graph neural networks (STGNNs) have difficulty adapting to heterogeneous traffic patterns and often rely on autoregressive decoding, which can accumulate errors in multi-step prediction. To address this limitation, we propose a Dynamic Multi-dimensional Global-aware Graph Convolutional Network (DMGGCN). The proposed model introduces a spatio-temporal meta-parameter generation mechanism to adapt model parameters according to temporal and spatial contexts. It further employs a dynamic multi-dimensional graph convolution encoder to capture heterogeneous dependencies and a dual-stream gated fusion module to integrate spatial and temporal features. In addition, a trend-alignment parallel decoder is designed to directly link historical representations with future targets, avoiding iterative decoding. The model is evaluated on eight real-world datasets covering traffic flow, traffic speed, and urban travel demand. Experimental results show that DMGGCN outperforms several recent baselines on major traffic-flow benchmarks and achieves competitive performance across different tasks and forecasting horizons in terms of MAE, RMSE, and MAPE. The model also demonstrates stable performance under noisy conditions. The source code is available at: https://github.com/Dx3281101/TrafficFlow-DMGGCN-main.}
}
@article{LI2026115152,
title = {An adaptive large neighborhood search algorithm with customized search operators for solving home healthcare scheduling and routing problems with skill matching and periodic visits},
journal = {Applied Soft Computing},
volume = {197},
pages = {115152},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115152},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006009},
author = {Benjie Li and Jingmei Pan and Qu Wei},
keywords = {Home healthcare, Adaptive large neighborhood search, Scheduling and routing, Periodic visits, Skill matching},
abstract = {Home healthcare services are increasingly recognized as an effective solution to challenges such as population aging, medical resource shortages, and growing service demands. This study addresses the scheduling of home healthcare services, with a focus on minimizing operational costs and maximizing the efficient utilization of healthcare providers while ensuring effective provider-patient matching. By incorporating practical constraints such as skill matching, work time limits, and periodic scheduling, a comprehensive optimization model is developed. To solve the problem effectively, an adaptive large neighborhood search algorithm with customized search operators is proposed and rigorously tested using randomly generated data and a real case study. Comparative experiments show that the algorithm consistently outperforms the commercial solver Gurobi and conventional metaheuristic approaches, achieving higher solution quality and computational efficiency, particularly in large-scale instances. A case study using real-world data from West China Hospital further demonstrates the algorithm’s practical applicability, highlighting its potential to reduce operational and provider-related costs while optimizing healthcare service delivery. These findings provide valuable insights for healthcare managers, enabling them to improve service quality, reduce expenses, and better meet the rising demand for home healthcare services.}
}
@article{JIANG2026115172,
title = {Spatiotemporal interactive neighborhood convolutional graph neural network based on semantic clustering for traffic forecasting},
journal = {Applied Soft Computing},
volume = {197},
pages = {115172},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115172},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006204},
author = {Wentao Jiang and Ming Zhao and Hongbo Li and Hongyan Qiao},
keywords = {Traffic flow forecasting, Spatiotemporal interaction, Transformer model, Semantic feature extraction, Real-time prediction},
abstract = {Accurate traffic flow prediction plays a pivotal role in the development of Intelligent Transportation Systems (ITS), contributing to congestion alleviation, route optimization, and road safety enhancement. However, existing traffic prediction models often struggle to effectively capture the complex spatiotemporal dependencies and nonlinear characteristics inherent in dynamic traffic environments, resulting in limited prediction accuracy. Moreover, traditional methods tend to overlook the semantic features of traffic networks and the intricate interactions between nodes, restricting their applicability and generalizability in large-scale traffic networks. To address these challenges, this paper introduces a novel deep learning framework, Spatiotemporal Interactive Neighborhood Convolutional Graph Neural Network Based on Semantic Clustering (SINCGNNBSC), which integrates several innovative components to better capture the complex spatiotemporal patterns in traffic flow. First, the model incorporates a Dynamic Neighborhood Convolutional Graph Neural Network (NCGNN), which effectively models multi-hop neighborhood dependencies and eliminates the computational bottleneck commonly found in traditional graph-based methods. Second, a channel mixing module based on semantic clustering is proposed, strengthening the correlation between high-sequence similarity variables while mitigating the influence of irrelevant variables. Additionally, the framework employs a dynamic periodic segmentation strategy that enhances local semantic representation, particularly improving the model’s performance during peak traffic periods. By integrating these innovations, SINCGNNBSC significantly improves both prediction accuracy and computational efficiency, with exceptional scalability in large-scale urban traffic networks. Experimental results demonstrate that SINCGNNBSC outperforms state-of-the-art models in terms of accuracy and computational performance, offering a robust solution for real-time traffic flow forecasting.}
}
@article{YANG2026115046,
title = {A Soft Constraint Optimization Approach for Clustering in Large-Scale Group Decision Making Based on Probabilistic Hesitant Fuzzy Information},
journal = {Applied Soft Computing},
volume = {197},
pages = {115046},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115046},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004941},
author = {Shanshan Yang and Wenqi Jiang and Witold Pedrycz and Jiali Wang and Tianqi Xu},
keywords = {P-HFS, Large-scale group decision-making, Scoring function, Reachability constrained, SCO-FCM},
abstract = {In a complex and uncertain decision-making environment, large-scale group decision making (LSGDM) offers an effective approach to engage numerous decision makers (DMs) comprehensively. In LSGDM, probabilistic hesitancy fuzzy sets (P-HFS) are significant for their ability to capture fuzziness and hesitancy in decision information. This study proposes a clustering-based approach to address LSGDM with P-HFS, introducing a novel scoring function that accurately distinguishes the expression confidence intervals of probabilistic hesitant fuzzy elements (P-HFE). This scoring function enhances sensitivity to P-HFE differences, ensuring better decision accuracy. A reachability-constrained clustering algorithm based on knowledge associations is also introduced. This algorithm employs an initial centroid selection mechanism that integrates distance and reachability, along with a Fuzzy C-Means clustering model with soft constraint optimization. This optimization approach mitigates sensitivity issues in initial centroid selection, reduces consensus coordination costs, and improves decision-making flexibility. Moreover, an improved silhouette coefficient incorporating reachability constraints evaluates clustering results, allowing for the accurate identification of the optimal number of clusters from candidate solutions, thereby reinforcing the scientific basis of the decision process. A case study demonstrates the effectiveness and flexibility of the proposed methodologies.}
}
@article{KUMAR2026115083,
title = {H-Net: A transformer based multistage fusion convolutional neural network for underwater object detection in complex environments},
journal = {Applied Soft Computing},
volume = {197},
pages = {115083},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115083},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005314},
author = {Ashish Kumar and Shikha Bhalla},
keywords = {Underwater object detection (UOD), Dynamic convolution, Feature extraction, Transformer, Multi-stage Fusion, Attention mechanism, Convolutional neural network (CNN)},
abstract = {Underwater Object Detection (UOD) has gained significant attention in recent years due to its critical role in applications such as oceanographic research, marine resource management, and underwater surveillance. However, UOD remains challenging because of complex underwater conditions, including light scattering, low visibility, and object occlusion. These factors degrade image quality and make it difficult to accurately detect and classify objects across varying depths and environmental conditions. To tackle this issue, this paper presents the Transformer based Multi-Stage Fusion Convolutional Neural Network (TransMSFCNNet) named H-Net model where the symbol ‘H’ is used to refer to its hierarchical architecture which incorporates convolutional and transformer-based multistage fusion to achieve powerful UOD in challenging settings. The main modules that have been used in H-Net model are the Dynamic Convolutional Feature Extraction Module (DCFEM) which extracts key features and the Attention-Guided Fusion Module (AGFM) which focuses on the most pertinent features by utilizing attention mechanisms that integrate both spatial and depth related information. Multistage Pooling Module (MSPM) minimizes the spatial dimensions, yet retained important information to represent long-range interactions and avoid overfitting. Transformer-Based Multistage Fusion Module (TMFM) aims at taking extra attention to fine-grained local correlations and feature interactions on various levels, enhancing the capability of more accurately detecting underwater objects. Meanwhile, Depth-Adaptive Object Detection Module (DAODM) dynamically scales the process of object detection according to the depth of objects, further boosting the object detection in low-contrast and high-occlusion parts of underwater scenes. Multistage Loss Function (MSL) optimizes classification and localization and deals with the imbalance between classes to achieve robust classification. The benefits of the H-Net model are associated with weaker impact of environmental interference, better analysis of intricate underwater scenes, and enhanced recognition of small or partially obscured objects. The proposed H-Net model is evaluated on four standard underwater benchmark datasets i.e., RUOD, URPC2023, UTDAC2020, and S-UODAC2020 which achieves mAP@[.5:.95] of 0.942, 0.940, 0.938, and 0.946, and F1-scores of 96.1%, 95.8%, 95.7%, and 95.9%, respectively.}
}
@article{YOUNES2026115175,
title = {Hybrid deep learning framework with ensemble feature selection and engineering for network intrusion detection},
journal = {Applied Soft Computing},
volume = {197},
pages = {115175},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115175},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600623X},
author = {Osama S. Younes},
keywords = {Intrusion detection system, Feature engineering and selection, Deep learning, CNN and BLSTM, Attention mechanism, Hybrid CNN–Random Forest Model},
abstract = {Effective Intrusion Detection Systems (IDS) are critical for securing modern network infrastructures against evolving cyber threats. Traditional signature- or rule-based approaches inherently lack the adaptability to detect zero-day and polymorphic attacks, while many stand-alone machine learning (ML) techniques exhibit sensitivity to high-dimensional and noisy data, resulting in limited generalization. Although deep learning (DL) has demonstrated superior capability in hierarchical feature extraction and complex pattern recognition, its deployment in real-world environments remains constrained by feature redundancy, inadequate data representations, and high computational overhead. To overcome these limitations, this study introduces a comprehensive intrusion detection framework that integrates ensemble-based feature selection (EFS), statistical feature engineering (SFE), and optimized deep neural network architectures. The EFS module aggregates feature rankings derived from multiple statistical and information-theoretic criteria to construct a compact and discriminative feature subset that minimizes redundancy and noise. Subsequently, the SFE component applies statistical transformations to capture temporal dependencies and distributional dynamics within network traffic. The architectural layer evaluates several advanced DL models, including CNN, GRU, BLSTM, and GRU with attention, as well as XGBoost as a classical ML baseline, and also proposes a novel hybrid CNN–Random Forest architecture that combines CNN’s hierarchical representation learning with the ensemble decision reliability of Random Forests. Extensive experiments conducted on four benchmark datasets, CIC-IDS2017, UNSW-NB15, NSL-KDD, and FLNET2023, validate the effectiveness of the proposed framework. The results demonstrate consistent improvements in detection accuracy, substantial reductions in false positive rates, and lower inference latency across both binary and multi-class intrusion detection tasks. Overall, the findings indicate that integrating ensemble-based feature selection, statistical feature engineering, and hybrid deep learning architectures improves detection performance and reduces inference cost, supporting practical IDS deployment.}
}
@article{LUZ2026115196,
title = {Deep learning approaches for drought forecasting, monitoring and impact assessment: A comprehensive systematic review},
journal = {Applied Soft Computing},
volume = {197},
pages = {115196},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115196},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006447},
author = {Andréa Eliza de Oliveira Luz and Rogério Galante Negri and Leonardo Bacelar Lima Santos},
keywords = {Systematic review, Drought, Deep learning, Remote sensing},
abstract = {Drought is a recurrent hazard with major impacts on ecosystems, economies, and societies, whose complex nature demands integrative approaches across climatic, hydrological, and biophysical dimensions. This study presents a systematic review of Deep Learning (DL) methods combined with Remote Sensing (RS) data for drought monitoring, prediction, and impact assessment. The review draws on peer-reviewed articles indexed in Scopus and Web of Science between January 2015 and July 2025, resulting in a final sample of 87 studies. It synthesizes trends related to regional distribution, data sources, input variables, modeling strategies, network architectures, and evaluation metrics. The results highlight the dominance of Convolutional Neural Networks (CNNs) in image-based applications, the increasing use of recurrent models for sequential data, and the emerging adoption of attention-based and hybrid architectures. Persistent challenges include the geographic concentration of studies in Asia and North America, limited data fusion across sources, and inconsistent reporting of model configurations and computational settings. Overall, this review provides a consolidated overview of recent advances and limitations, emphasizing the need for broader geographic coverage, improved data integration, and more standardized evaluation practices to support robust and transferable drought-related solutions.}
}
@article{HU2026115161,
title = {A failure mode identification model for UHPC-strengthened damaged flexural RC beams based on generative adversarial networks and machine learning},
journal = {Applied Soft Computing},
volume = {197},
pages = {115161},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115161},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006095},
author = {Tianyu Hu and Hong Zhang and Junli Qiu and Jiewei Qiu and Jianting Zhou},
keywords = {Ultrahigh performance concrete, Reinforced concrete beams, Failure modes, Tabular generating adversarial networks, Shapley additive explanations},
abstract = {Although ultrahigh-performance concrete (UHPC) has shown exceptional promise for strengthening engineering structures, critical gaps remain in understanding the failure behavior of UHPC-strengthened flexural reinforced concrete (RC) beams. Existing approaches lack the precision required to reliably distinguish between ductile and brittle failure modes, which represents a key barrier to safe and efficient design. To address this gap, this study introduces a novel data-driven framework that integrates advanced machine learning with feature engineering to develop a highly accurate and interpretable model for identifying failure modes. First, the experimental data of 163 sets of strengthened beams with brittle and ductile failure modes were collected, followed by data augmentation using Tabular Generating Adversarial Networks (TGAN). Subsequently, classification models were constructed using six machine learning models. Finally, the Shapley Additive Explanation provides clear insights into the optimal machine learning model. Findings indicate that TGAN can improve the performance of machine learning models. Random forests exhibit the most balanced performance. The thickness (hu) and tensile strength (ft) of UHPC had the greatest influence on the failure modes, with an increase in hu leading to ductile failure and an increase in ft leading to brittle failure. The conclusions of this study can serve as a reference for the design of damaged RC beams strengthened by UHPC.}
}
@article{TIAN2026115177,
title = {Probabilistic prediction of taxi origin–destination demand via multi-perspective graph neural networks and quantile regression},
journal = {Applied Soft Computing},
volume = {197},
pages = {115177},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115177},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006253},
author = {Jingjing Tian and Ao Lv},
keywords = {OD demand probabilistic prediction, Quantile regression, Multi-perspective graph neural network, Two-stage training strategy, Prediction interval},
abstract = {Taxi origin-destination (OD) demand prediction aims to forecast the passenger flow between different region pairs in a future time interval. Although deep learning models have been demonstrated to be effective in spatial-temporal demand modeling, previous studies mainly focused on deterministic demand analysis, ignoring the stochasticity and fluctuation caused by the complex exogenous factors. To this end, this paper proposes a model coupling quantile regression (QR) with deep learning for jointly yielding conditional quantiles together with prediction intervals to provide a more complete 'picture' of taxi OD demand. In particular, we adopt a feature extraction module based on an enhanced multi-perspective graph neural network (EMPGCN) to exploit spatial-temporal nonlinear features and an approximation module based on QR to generate conditional quantiles to capture stochastic OD demand. A two-stage training strategy is developed to address the non-differentiable loss function and embarrassing quantile crossing problems in training the combined model to improve the accuracy of probabilistic prediction. In the first stage, we extend the EMPGCN module as a point prediction model to train the network parameters and generate latent nonlinear features. In the second stage, the features will be input into the QR module, and the loss function will be transformed into a dual linear programming model to solve. In the end, we assess the performance of our model and training strategy using the testing dataset, showcasing its effectiveness in OD demand probabilistic prediction and its capability to yield accurate prediction intervals with specific confidence levels.}
}
@article{R2026115140,
title = {Barriers to micro/small/medium enterprises solar energy adoption: An integrated hyperbolic fuzzy decision system for prioritization},
journal = {Applied Soft Computing},
volume = {197},
pages = {115140},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115140},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005880},
author = {Krishan Kumar R and Samyukta Balaji and Mark Goh and Kattur Soundarapandian Ravichandran and Samant Saurabh},
keywords = {Solar energy, Sustainability, Clean energy, DEMATEL, MSME},
abstract = {Solar energy, a form of clean energy, is gaining popularity among the micro, small, and medium enterprises (MSMEs), despite the challenges. This paper seeks to understand the challenges of adoption and to rank these challenges for better planning and implementation by modelling solar energy adoption uncertainty flexibly and establishing the causal relationships among the entities. The data is interpreted as Hyperbolic Fuzzy Values (HyFVs). Cronbach’s α and DEMATEL are extended to the HyFVs to reliably obtain the weights of the experts and to prioritize the challenges arising from the causal relationships of the entity attributes. A case example of MSME solar energy adoption is presented to exemplify the practical use of the proposed HyFV-Cronbach’s α-DEMATEL solution framework. The results suggest that the lack of a skilled workforce (4.345), high capital costs (4.046), and a lack of political commitment (4.034) are the top three barriers that impede MSME adoption of solar energy.}
}
@article{PENEDO2026115201,
title = {A scalable GRASP algorithm for the targeted misinformation blocking problem},
journal = {Applied Soft Computing},
volume = {197},
pages = {115201},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115201},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006496},
author = {Iván Penedo and Isaac Lozano-Osorio and Jesús Sánchez-Oro},
keywords = {Social networks, Influence minimization, Blocking set, Combinatorial optimization, Metaheuristics},
abstract = {The research on Social Network Analysis has exponentially grown in the last decades due to the relevance of social networks in the society. Although most of the works have focused on the maximization of influence, the spread of misinformation and its impact on relevant aspects of the society such as politics or economy, among others, have attracted the attention of both practitioners and the scientific community. This work is focused on the Targeted Misinformation Blocking Problem (TMB), whose aim is to minimize the number of nodes required to reduce the spread of misinformation through a social network. It is considered that if the information is spread under a certain target, then it would not have an effect on the network. Therefore, the objective is to find a subset of blocking nodes that guarantees that the spread of information is below that target. However, existing state-of-the-art approaches face significant scalability limitations, often failing to generate feasible solutions for large-scale networks due to the high computational cost of influence estimation. To that end, a Scalable Greedy Randomized Adaptive Search Procedure (GRASP) algorithm is proposed, being able to deal with medium and large scale networks in reasonable computing time. The results obtained are compared with the best method found in the literature, Scalable TMB, which generates a set of trees to simulate the influence spread and identify the most promising nodes. Experimental results show that the proposed algorithm is able to outperform the state of the art when considering two of the most extended diffusion models. Additionally, the scalability of the proposal is proven, being able to provide high-quality solutions even in those instances in which previous algorithms are not able to generate a feasible one. Those results, supported by non-parametric statistical tests, indicate that the proposed algorithm is a competitive method for solving the TMB.}
}
@article{ZHAI2026115169,
title = {Cooperative 4D trajectory planning for multi aerial vehicles combining receding horizon optimization and differential evolution algorithm in dynamic battlefield environment},
journal = {Applied Soft Computing},
volume = {197},
pages = {115169},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115169},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006174},
author = {Shaobo Zhai and Guangwen Li and Guo Wu and Kaizhong Nan and Haizheng Zhang and Mingshan Hou},
keywords = {Cooperative four-dimensional trajectory planning, Receding horizon optimization, Differential evolution algorithm, Population diversity, Flight speed adjustment strategy, required time of arrival},
abstract = {Aiming to the problem of cooperative trajectory planning for multi aerial vehicles in dynamic battlefield environment, this article develops a cooperative four-dimensional trajectory planning method combining receding horizon optimization (RHO) and differential evolution algorithm, and the main contributions are threefold: (1) An effective framework for multi aerial vehicles cooperative trajectory planning in dynamic environment is introduced. Therein, RHO serves as the outer layer, while the DE algorithm is employed in the inner loop to implement local trajectory planning. (2) A population diversity-based adaptive DE algorithm, named PDADE, is proposed to tackle the issues of slow convergence speed and low convergence accuracy in the classical DE algorithm. (3) A flight speed adjustment strategy based on the required time of arrival is presented to ensure synchronization of arrival times. Eventually, some numerical simulations are conducted, and the performance of the proposed PDADE algorithm is compared with other seven state-of-the-art swarm optimization algorithms. The results demonstrate that PDADE achieves optimal convergence accuracy and convergence speed.}
}
@article{GOMEZORELLANA2026115153,
title = {Ordinal evolutionary artificial neural networks for predicting diabetic nephropathy progression},
journal = {Applied Soft Computing},
volume = {197},
pages = {115153},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115153},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006010},
author = {Antonio Manuel Gómez-Orellana and Michele Bernardini and Rafael Ayllón-Gavilán and Víctor Manuel Vargas and Pedro Antonio Gutiérrez and César Hervás-Martínez and Luca Romeo},
keywords = {Diabetic nephropathy, Type 2 diabetes, Ordinal classification, Evolutionary artificial neural networks, Electronic health records},
abstract = {Diabetic Nephropathy (DN) is a complex, multi-factorial condition that often coexists with other diabetes-related comorbidities. Although DN progresses through a series of ordered stages, i.e., from mild to advanced, studies have primarily focused on classifying its presence or absence, i.e., a static risk prediction, rather than its progression. This gap underscores the need for advanced methodologies to predict DN progression, which could improve patient outcomes and optimise healthcare interventions. This study proposes a novel ordinal perspective to predicting DN progression using clinical Electronic Health Records (EHR) data. This approach is based on Ordinal Evolutionary Artificial Neural Networks (OEANNs), which integrate a Cumulative Link Model to perform ordinal predictions, and leverage Evolutionary Algorithms to optimise OEANNs architecture and weights by dynamically adapting to the sparsity of EHR data. The proposed ordinal perspective involves discretising the disease risk into four ordinal severity classes, each representing a different stage of disease progression. In addition, the temporal variability of DN progression is modelled by considering a feature engineering stage that constructs variables capturing early indicators of DN. Experimental results on a clinical EHR dataset demonstrate that OEANNs outperform state-of-the-art nominal and ordinal models, achieving significant improvements in ordinal metrics such as Mean Absolute Error and Quadratic Weighted Kappa. Furthermore, unlike traditional static risk prediction, OEANNs minimise misclassification errors between distant severity stages, enabling more accurate predictions of disease severity. Therefore, the proposed innovative ordinal approach bridges a critical gap in DN management, offering robust, clinically relevant predictions to inform personalised treatment planning.}
}
@article{NIKOLIC2026115181,
title = {Human-like AI algorithm for playing Iterated Prisoner’s Dilemma},
journal = {Applied Soft Computing},
volume = {197},
pages = {115181},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115181},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006290},
author = {Ognjen Nikolić and Marija Kuzmanović and Dragan Pamučar},
keywords = {Iterated Prisoner’s Dilemma, Algorithm, Fuzzy inference systems, Cooperation, Game theory},
abstract = {The Iterated Prisoner’s Dilemma (IPD), following Axelrod’s tournaments, has become one of the most extensively studied models in game theory. Many political, economic, and social interactions can be represented as Prisoner’s Dilemma situations, where cooperation is socially optimal but individually irrational. Identifying mechanisms that sustain cooperation in such environments remains a central research challenge. Over time, numerous IPD algorithms have been proposed, differing in cooperation levels, adaptivity, and computational foundations. Recent AI-based strategies have achieved strong performance, often at the cost of interpretability. This paper introduces a Fuzzy Algorithm (FA), an AI-based strategy built on a Mamdani-type fuzzy inference system. The algorithm integrates four opponent characteristics: cooperation rate, adaptivity, forgiveness, and stochasticity, into a compact rule-based decision framework that models graded reasoning under uncertainty. FA is evaluated in classical Axelrod and Stewart-Plotkin tournaments, as well as in large-scale competitions involving over 200 benchmark strategies. Robustness is further tested under 10% implementation noise and varying payoff structures, and evolutionary performance is examined through ecological model and Moran processes. Results indicate that FA consistently ranks among top-performing strategies and demonstrates competitive evolutionary stability, suggesting that interpretable fuzzy inference systems can provide effective decision mechanisms in repeated strategic environments.}
}