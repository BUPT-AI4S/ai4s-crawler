@article{LIAN2026114888,
title = {Multichannel adapted Vision Transformer with acoustic-vibration fusion for condition transfer fault diagnosis},
journal = {Applied Soft Computing},
volume = {193},
pages = {114888},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114888},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003364},
author = {Yan Lian and Jinrui Wang and Jiehan Zhou and Huadong Du and Yufeng Xu and Yihao Wang and Kaihao Jian},
keywords = {Vision Transformer, Fault diagnosis, Multichannel adaption, Signal feature},
abstract = {Fault diagnosis in mechanical systems is limited to single-modality measurements, which may lead to incomplete feature representation. Vibration and acoustic signals contain substantial redundant and complementary information, yet the effective extraction and utilization of these multi-dimensional features remain challenging. To address these limitations and obtain a more complete and representative feature set, a Multichannel Adaption guided Vision Transformer (MAViT) with acoustic-vibration signal feature fusion is proposed, which employs acoustic-vibration signal feature fusion technology to achieve more comprehensive and robust feature extraction. Meanwhile, the MAViT incorporates the FReLU activation function, which considers the contextual information of activation features, thereby enhancing the description of vibro-acoustic signals. Additionally, the fusion mechanism integrates multi-channel features, enabling the model to capture multi-dimensional attributes without losing important information, thus improving the accuracy and stability of diagnosis. A series of 12 different cross-condition transfer diagnosis tasks were designed to validate the effectiveness of the MAViT. Experimental results demonstrate that the MAViT can not only effectively identify various types of fault samples but also exhibit the highest stability in multiple tests compared with other methods. The diagnostic accuracy of this method can reach over 98 %.}
}
@article{LI2026114868,
title = {A competitive mechanism driven optimization algorithm with application to industrial lens dust shield design},
journal = {Applied Soft Computing},
volume = {193},
pages = {114868},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114868},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003169},
author = {Yitian Li and Dong Pan and Zhaohui Jiang and Haoyang Yu and Yalin Wang and Weihua Gui},
keywords = {Optimization algorithm, Competition mechanism, Engineering design, Lens dust shield design},
abstract = {Metaheuristic algorithms are pivotal for solving complex optimization problems but still face dual challenges: phase balance and efficient update strategies. This study proposes a novel Competitive Mechanism-driven Optimization (CMO) algorithm. It establishes a competitive framework that divides the population into interacting subpopulations, introducing three core innovations. First, a competitive pressure-driven dynamic phase transition mechanism enables subpopulations to autonomously switch between exploration and exploitation. Second, hierarchical collaborative update strategies are designed, integrating information from the global best, subpopulation best, and individual best solutions to enhance optimization efficiency and adaptability. Third, a role-based strategy assignment mechanism adaptively guides individuals to appropriate update strategies, thereby improving resource utilization throughout the search process. Furthermore, this paper addresses dust prevention challenges for optical instruments in harsh industrial environments. By considering functional and safety requirements, we define the optimization variables, objective function, and constraints for a novel conical lens dust shield design. The proposed CMO algorithm is rigorously evaluated against 18 state-of-the-art algorithms on the CEC2017 and CEC2022 benchmark suites and is further validated through five real-world engineering applications, including the lens dust shield design. Results demonstrate its superior effectiveness in addressing complex optimization challenges across both theoretical and practical domains.}
}
@article{TENG2026114807,
title = {TIPSST: Transformer-based hyperspectral object tracking with illumination prompts and spatial-spectral-temporal context},
journal = {Applied Soft Computing},
volume = {193},
pages = {114807},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114807},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002553},
author = {Xiang Teng and Wenhao Jiang and Pei Xiang and Dong Zhao and Shuxia Qi and Jiangluqi Song and Huixin Zhou},
keywords = {Hyperspectral video, Transformer network, Object tracking, Spatial-spectral-temporal context, Illumination prompts},
abstract = {Hyperspectral images (HSIs) offer superior object tracking performance over traditional RGB videos due to their rich spectral information. However, current methods fail to fully exploit spatial–spectral cues and are vulnerable to illumination variation (IV), where changes in illumination intensity and color temperature cause significant appearance shifts, making tracking more difficult. Moreover, insufficient temporal feature interaction further limits HSI tracking performance. To address the above problems, we proposed a transformer-based hyperspectral object tracker with illumination prompts and spatial-spectral-temporal context (TIPSST) to improve the HSI tracking performance. First, a spatial–spectral dimensionality reduction (SSDR) mechanism is introduced to compress redundant features across spatial and spectral domains, thereby improving feature compactness and discriminative power. Second, a spatial–spectral–temporal context transfer (SSTCT) module is developed to enable multi-scale and multi-modal feature interaction and fusion along the temporal axis, ensuring coherent scene information propagation across frames and enhancing tracking stability. Third, a multi-illumination scale prompt generation (MISPG) strategy dynamically adjusts scene brightness and generates diverse illumination prompts to guide the network toward robustness under varying lighting conditions. Experimental results show that compared with the state-of-the-art (SOTA) algorithms, the proposed tracker demonstrates significant improvements in robustness and outperforms SOTA methods on benchmark datasets.}
}
@article{GUO2026114852,
title = {ScOrGBC: A novel classifier of granular balls with stable centers and optimal radii},
journal = {Applied Soft Computing},
volume = {193},
pages = {114852},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114852},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003005},
author = {Yongqiang Guo and Xiao Zhang and Jinhai Li and Yanyan Yang},
keywords = {Granular ball generation, Granular ball computing, Granular computing, Classification},
abstract = {Granular ball computing can be used to represent structural information of data, and has been successfully applied to classification tasks. However, it still suffers from several challenges such as the large numbers of generated granular balls, the instability of centers, the difficulty of determining optimal radii, etc. Therefore, in this paper, we propose a generation method of granular balls with stable centers and optimal radii (ScOrGBG). Specifically, a strategy is first proposed to specify the number of granular balls. The K-means algorithm with K-means++ mechanism is employed to obtain the stable centers of granular balls. Then, the initial radius of each granular ball is determined by the farthest distance between the granular ball center and the instances in the granular ball. An iterative mechanism of overlap elimination is put forward to resolve the boundary conflicts of granular balls with different labels. Furthermore, the justifiable granularity principle is further employed to optimize the radii of granular balls, which ensures that the ultimately generated granular balls can give attention to both coverage and specificity. Lastly, a granular ball classifier ScOrGBC is designed for classification. Experimental results show that, on the 20 given public datasets, ScOrGBC achieves significantly fewer and stable granular balls at the 20% and 40% noise levels. Compared with four kinds of state-of-the-art granular ball classification algorithms, ScOrGBC obtains an average accuracy improvement of 1.48%, 5.36% and 13.85% at 0%, 20% and 40% noise levels, respectively. Therefore, ScOrGBC possesses stable and powerful classification ability especially for high noise environments.}
}
@article{ZHOU2026114904,
title = {Generating diverse data based on FA-LoRA fine-tuning of diffusion models to enhance UAV forest fire detection performance},
journal = {Applied Soft Computing},
volume = {193},
pages = {114904},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114904},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003522},
author = {Wentao Zhou and Deqiang He and Zhenzhen Jin and Zexian Wei and Haimeng Sun and Jinxin Wu and Yuan Zhuang and Baofu Qin and Qinzhan Wu},
keywords = {Forest fire smoke detection, Drone monitoring, Computer vision, Diffusion model, Data generation},
abstract = {Forest fires are among the most destructive natural disasters, with their frequency and intensity rising due to climate change and human activities, threatening ecosystems and social stability. Unmanned Aerial Vehicles (UAVs) offer flexible, real-time monitoring for early fire detection. However, existing UAV-based forest fire smoke datasets remain limited in volume, diversity, and quality, constraining detection performance. To address this, we propose a Frequency-Aware Low-Rank Adaptation (FA-LoRA) method for fine-tuning a pre-trained Stable Diffusion model in the frequency domain, enabling the generation of more realistic fire and smoke details from a UAV perspective. Using FA-LoRA, we construct the Diffusion Model-Based Forest Fire Smoke Dataset (DMFFSD) via a text-to-image strategy, featuring complex environmental conditions and varied scenes to improve detection robustness. Experiments with mainstream object detection models show that training with DMFFSD yields up to 36 % higher detection accuracy under complex scenarios compared to conventional datasets. Meanwhile, the YOLOv11 model, trained with the dataset we built, achieved a real-time detection accuracy of 68 % on our real drone detection platform, outperforming models trained with other publicly available datasets. This work alleviates data scarcity and quality issues, enhancing UAV-based forest fire monitoring.}
}
@article{XU2026114861,
title = {Synergistic hierarchical and graph attention networks for robust leptomeningeal metastasis detection in brain MRI},
journal = {Applied Soft Computing},
volume = {193},
pages = {114861},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114861},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003091},
author = {Haipeng Xu and Jing Sun and Qian Miao and Yaping Hong and Qing Xu and Chenxin Li and Huihua Hu and Gen Lin and Yunjian Huang},
keywords = {Non-small lung cancer, Leptomeningeal metastasis, Deep learning-driven diagnosis, Visual attention, Multi-center validation},
abstract = {Leptomeningeal metastasis (LM) is a severe complication of advanced malignancies, marked by the spread of malignant cells into the subarachnoid space. The prognosis for LM remains extremely poor, with untreated patients often surviving only a few weeks. Early and accurate detection is therefore critical for improving patient outcomes. In this work, we present a novel automated diagnostic framework for LM that leverages a hierarchical attention mechanism to process volumetric MR data, explicitly modeling both intra-slice spatial features and inter-slice contextual relationships. This architecture is further enhanced by a graph-based visual reasoning module, which enables the interpretation of complex feature interactions relevant to LM diagnosis. Comprehensive evaluations on a dedicated clinical dataset demonstrate that our method achieves superior diagnostic performance compared to existing approaches, yielding an accuracy of 98.52%, a sensitivity of 97.60%, a specificity of 98.92%, and an AUC of 97.84%. These findings highlight the potential of our framework to facilitate earlier and more precise identification of leptomeningeal metastasis, supporting more effective clinical decision-making, especially for patients with non-small cell lung cancer. Furthermore, multi-center external validation on two independent institutions with different MRI vendors confirms the generalizability of the proposed approach, achieving a combined external accuracy of 93.67%.}
}
@article{CHEN2026114869,
title = {Leveraging hierarchical attention and dynamic fusion mechanisms for multi-modal speech emotion recognition},
journal = {Applied Soft Computing},
volume = {193},
pages = {114869},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114869},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003170},
author = {Zengzhao Chen and Chuanxu Zhao and Zhifeng Wang and Chuan Liu and Qiuyu Zheng and Jianwen Sun},
keywords = {Speech emotion recognition, Multimodal learning, Feature fusion, Transformer, Pre-trained language models},
abstract = {Emotion Recognition (ER) is increasingly vital in sectors like education and healthcare. Traditional ER methods often fall short due to simplistic multimodal fusion techniques and poor integration of complex data like voice and text. To address these limitations, we propose a novel Multi-Modal Speech Emotion Recognition (MSER) model that generates accurate and robust emotion predictions through multi-scale feature extraction and dynamic cross-modal fusion. The proposed model incorporates three primary innovations. First, it utilizes a multi-scale hierarchical attention mechanism for speech feature extraction, configured with 2-2-16 attention heads, enabling bottom-up modeling of emotion-relevant information from local acoustic cues to phoneme-level representations and ultimately to global emotional context. Second, it employs a pre-trained ALBERT model for text feature extraction, optimized via systematic pooling strategies, to generate contextually rich embeddings that serve as a complementary modality supporting speech-based emotion recognition. Third, the framework implements a dynamic weighted fusion mechanism operating at both the feature and decision levels, allowing adaptive, context-aware integration of audio and text modalities to enhance multimodal interactions. Evaluated on the IEMOCAP dataset comprising 10,039 utterances from 10 speakers, our model achieves notable improvements with an Unweighted Accuracy (UA) of 83.92 ± 1.39% and a Weighted Accuracy (WA) of 80.78 ± 1.91%, demonstrating substantial performance enhancements over existing approaches. Our findings not only validate the MSER model’s effectiveness but also mark a significant advancement in ER technology, offering profound implications for real-world applications.}
}
@article{SDANTAS2026114746,
title = {Fair age prediction through ILP-based multi-attribute training subset selection},
journal = {Applied Soft Computing},
volume = {193},
pages = {114746},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114746},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001948},
author = {Ana Paula {S. Dantas} and Gabriel B. {de Oliveira} and Helio Pedrini and Cid C. {de Souza} and Zanoni Dias},
keywords = {Algorithmic fairness, Fair coverage, Integer Linear Programming},
abstract = {As algorithms play an increasingly prominent role in decision-making, concerns have grown over their disproportionate impact on minority groups. This has led to a surge of interest in algorithmic fairness, a field dedicated to embedding fairness principles into algorithm development. Motivated by these challenges, we extend a fair coverage problem, termed Multi-Attribute Fairer Cover, which aims to identify a maximally fair subset for training purposes. In this study, we conduct new experiments using an Integer Linear Programming (ilp) model to create fair training instances for an age regression task. We compare these fair instances with randomly selected samples from the UTKFace dataset, evaluating the performance with classical convolutional neural network, state-of-the-art convolutional model, and attention-based regressors. Results show a significant error reduction in the regression model when using fair selection compared to random selection, both in general scenarios and when filtered by gender and race, including minority groups.}
}
@article{GUO2026114843,
title = {Spatial multiple attention-driven intelligent tuning of shape-performance coupling devices},
journal = {Applied Soft Computing},
volume = {193},
pages = {114843},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114843},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002917},
author = {Linwei Guo and Weihua Cao and Wenkai Hu and Min Wu},
keywords = {Attention mechanism, Intelligent optimization, Performance tuning, Shape-performance coupling, Microwave filter},
abstract = {Tuning of shape–performance coupling devices in many fields is essential but challenging due to their complex characteristics. Manual tuning is inefficient and costly, and automatic tuning is urgently needed due to the growing demand. Although intelligent optimization-based tuning is effective, it faces two challenges: 1) high computational cost due to the large design space, and 2) significant complexity arising from the multi-solution and multi-modality characteristics. These challenges can be mitigated by focusing on a local yet effective design space. However, identifying such space is difficult. To tackle this, a novel optimization tuning approach driven by spatial multiple attentions (SMAs) is proposed. First, a data-driven space attention generation method is presented to select the space with a high likelihood of containing feasible solutions. Second, an SMAs decomposition strategy is devised to divide the whole space into several sub-spaces for reducing the optimization burden. Third, an SMAs-particle swarm optimization (SMAs-PSO) algorithm is designed to efficiently search for feasible solutions in all spaces determined by SMAs. Simulation results demonstrate that the proposed method achieved a high tuning success rate while reducing the average iteration number by 53.4% compared to conventional PSO. Unlike existing intelligent optimization or hybrid methods that rely on global search, the proposed method identifies effective local spaces within the global space, thereby simultaneously enhancing accuracy and efficiency.}
}
@article{LIU2026114810,
title = {MCADFNet: Multi-scale cross-modal attention dynamic decision fusion network for Parkinson’s quantitative grading},
journal = {Applied Soft Computing},
volume = {193},
pages = {114810},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114810},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002589},
author = {Yinghao Liu and Chao Lian and Jian Li and Zhikun Zhan and Yu Fu and Yuliang Zhao},
keywords = {Parkinson’s disease, Cross-modal attention, Dynamic decision fusion, Signal processing, Information fusion},
abstract = {Gait abnormalities are a key biomarker for the early diagnosis and quantitative assessment of Parkinson’s disease. However, existing studies are limited by insufficient modeling of multimodal features and inadequate integration of bilateral data, which restricts diagnostic accuracy. To address this, a Multi-scale Cross-modal Attention Dynamic Decision Fusion Network is proposed based on ankle IMU signals. The network includes a first-level feature extraction and two stages of feature fusion. First, the multi-scale feature extraction module captures gait patterns and rhythm variations across temporal scales, overcoming the limitations of fixed-window extraction and enhancing the perception of complex gait dynamics. Second, a dual-stream Transformer adaptively allocates attention weights to uncover nonlinear correlations between acceleration and angular velocity on the same side, achieving cross-modal fusion. Third, the dynamic decision fusion mechanism models temporal associations and coordination differences between the left and right limbs, leveraging gait asymmetry to improve diagnostic accuracy. Finally, a noise-resilient branch mitigates disturbances from individual gait differences and sensor placement, enhancing robustness. On a clinical dataset of forty Parkinson’s patients and fourteen healthy controls, the network achieved 99.85% accuracy for early diagnosis and 98.61% for quantitative grading. Right ankle signals outperformed the left by about 1.12%, highlighting the importance of gait asymmetry. This study offers novel approaches and technical pathways for the application of wearable sensing systems in the intelligent diagnosis of movement disorders.}
}
@article{DING2026114846,
title = {Feature-space augmented transfer learning for sample-efficient prediction of vibration-induced droplet dynamics in constricted microtubes},
journal = {Applied Soft Computing},
volume = {193},
pages = {114846},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114846},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002942},
author = {Heying Ding and Wen Deng and Fuquan Song},
keywords = {Transfer learning, Feature-space augmentation, Droplet dynamic, Multiscale flow modelling, Vibrational excitation},
abstract = {Seismic and acoustic vibrations can mobilize trapped non-wetting droplets, but predicting the coupled capillary-inertial response in complex pore geometries is a major challenge in large-scale simulations. Previous machine learning methods often fail to fully consider all relevant features, particularly microchannel geometries, flow conditions, and fluid properties. To address this issue, we compiled a comprehensive dataset containing over 40,000 numerical simulation data points, covering different fluid dynamic states and two types of pore geometries. We then developed a Convolutional Neural Network - Long Short-Term Memory based transfer learning (TL) model, implementing both homogeneous and feature-space augmentation TL, achieving superior prediction accuracy (R² > 0.98, RMSE < 0.0055, MAE < 0.024). These models effectively reduce the reliance on extensive experiments and expertise, while maintaining high prediction accuracy even with a one-order-of-magnitude reduction in target domain samples. Furthermore, further analysis shows that feature-space augmentation TL enables high-precision predictions with fewer samples and significantly saves training time and computational costs. Within an engineering-acceptable accuracy range, using approximately 50 % of the samples required by the homogeneous TL achieves similar performance. The feature-space augmentation TL methods highlight the advantages of combining data-driven and physics-based modeling and provide strong support for engineering applications in microfluidics, hydrology, and other fields.}
}
@article{HE2026114802,
title = {Rule learning with causal intervention for knowledge graph reasoning},
journal = {Applied Soft Computing},
volume = {193},
pages = {114802},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114802},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002504},
author = {Yuefeng He and Xu Zheng and Jinchuan Zhang and Ling Tian and Yinong Shi},
keywords = {Knowledge graph, Knowledge graph completion, Rule learning, Causal intervention},
abstract = {The indispensability of logical rules stems from their ability to facilitate credible and interpretable reasoning within knowledge graphs. Recent methods substantiate the effectiveness of rule learning methods in extracting superior quality rules, using their embedding into latent spaces to explore implicit relationships between rule heads and rule bodies and to enhance computational resources and efficiency. However, existing methods also encounter confounders that reflect the background information or implicit attributes beyond the essential attributes of the rules. This compromises the reliable interpretability of rules and misdirects existing rule learning frameworks, thereby impeding their capacity to discern causal attributes intrinsic to the rules themselves and resulting in suboptimal reasoning outcomes. In this paper, we propose a novel causal learning paradigm and a corresponding rule learning framework called CausalRL to handle the confounders issue in knowledge reasoning. CausalRL introduces a controlled randomized confounder and differentiation module to simulate confusing information introduced by different variables, and achieves causal intervention by simulating the process of coupling and causal reasoning. This design enables the model to decouple causality and confounders. Meanwhile, by attaining the optimal causality, CasualRL can utilize essential properties of relations to guide the entire rule learning process, and more accurately utilize the semantic consistency between rule bodies and rule heads. Through an extensive series of comparative and ablation experiments, we demonstrate the effectiveness of our causal learning paradigm and its ability to derive high-quality rules based on causality. Moreover, we show that CausalRL yields state-of-the-art results for knowledge graph completion across five publicly available datasets. https://github.com/burning5112/CausalRL}
}
@article{XU2026114805,
title = {LESFuse: A lightweight dual-domain collaborative framework for high-fidelity visible-infrared image fusion},
journal = {Applied Soft Computing},
volume = {193},
pages = {114805},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114805},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600253X},
author = {Haohao Xu and Guangsheng Ran and Yueri Cai and Yi Wang and Shusheng Bi},
keywords = {Image fusion, Infrared and visible image, Frequency domain, Lightweight network, Real-time image fusion},
abstract = {Visible-infrared image fusion is crucial for robust perception in challenging environments, yet the inherent modality gap often leads to structural distortion and detail loss. To address this, we propose LESFuse, a novel lightweight fusion paradigm that establishes a dual-domain collaborative mechanism. Our approach introduces an intensity-structure interaction model to enforce spatial consistency and a learning-based frequency decomposition strategy to disentangle and enhance multi-scale features. Extensive experiments on three public datasets (MSRS, RoadScene, and TNO) against seven state-of-the-art methods demonstrate that LESFuse achieves superior performance. Quantitatively, our method attains the highest scores across multiple metrics, achieving a Mutual Information (MI) score of 3.71 on the MSRS dataset, significantly outperforming the second-best method. In downstream object detection tasks, LESFuse yields the highest mean Average Precision (mAP@0.5) of 83.16%. Furthermore, the framework maintains exceptionally low computational costs, requiring only 0.03M parameters and 1.85 GFLOPs, with an average inference time of 0.11 s on a CPU. These results confirm LESFuse’s effectiveness and real-time capability for deployment on resource-constrained platforms.}
}
@article{LI2026114745,
title = {Distribution and expression aware retrospective learning for single-cell long-tailed class-incremental annotation},
journal = {Applied Soft Computing},
volume = {193},
pages = {114745},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114745},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001936},
author = {Tianhao Li and Zixuan Wang and Chenpeng Wu and Zhengxiao Huang and Yixin Xiang and Yuhang Liu and Quan Zou and Naifeng Wen and Yongqing Zhang},
keywords = {Single-cell, Class-incremental annotation, Long-tailed, Distribution aware, Expression aware},
abstract = {Single-cell annotation, which identifies specific cell types in biological tissues, is a cornerstone of targeted therapy in precision medicine. However, the lack of incremental annotation capabilities in existing methods limits their adaptability to dynamic immune environment changes and broader applications. Additionally, the high-dimensional sparsity and long-tail distribution of single-cell data hinder practical long-tail incremental annotation. This paper introduces a single-cell incremental annotation framework that combines a distribution-aware diffusion model with an expression-aware knowledge distillation architecture to address these challenges. The distribution-aware module retrospects and replays historical data distributions, enabling precise generation of previously annotated cell types and mitigating catastrophic forgetting. The expression-aware module aligns gene representations through a multi-perspective attention mechanism, enhancing sensitivity to novel cell types while retaining knowledge of dominant categories. A fuzzy incremental guidance mechanism with uncertainty constraints further reduces the adverse effects of long-tail distributions, ensuring more robust annotation performance. Experimental results validate the effectiveness of this framework, demonstrating significant improvements in multi-session incremental annotation accuracy. In addition, this framework enhances the biological and clinical relevance of incremental annotation, enabling continuous integration of new datasets for improved discovery of rare cell types and disease progression analysis. This approach offers a scalable and generalizable solution to the challenges of long-tail incremental annotation in single-cell data.}
}
@article{CAO2026114834,
title = {UCL-Blocker: Unsupervised contrastive learning with multi-granularity dynamic fusion for entity blocking},
journal = {Applied Soft Computing},
volume = {193},
pages = {114834},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114834},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002826},
author = {Yupeng Cao and Niannian Shi and Yaxin Wei and Shumei Liu and Chenchen Sun and Bin Yang and Yisheng An},
keywords = {Unsupervised entity blocking, Contrastive learning, Dynamic fusion, Data augmentation},
abstract = {Entity Resolution (ER) aims to identify and merge records that refer to the same entity across diverse data sources. Entity blocking is a key step in entity resolution, as it reduces computational complexity by efficiently generating candidate pairs to minimize redundant comparisons. Recent deep learning-based blocking methods show promise but often require large amounts of labeled data and struggle to capture fine-grained semantics. To address these challenges, we propose an unsupervised entity blocking framework based on contrastive learning with multi-granularity dynamic fusion. The framework consists of two stages: the embedding stage and the block generation stage. In the embedding stage, positive samples are created via data augmentation, with other instances in the batch serving as negatives. To enhance fine-grained semantics, the stage enables interactions among instance vectors and integrates global context through a multi-level similarity fusion mechanism. The fused representations are then used to fine-tune a pre-trained language model via contrastive learning. In the block generation stage, the fine-tuned model produces record embeddings, which are aggregated via average pooling. These aggregated embeddings are then used for efficient similarity computation and candidate ranking, ultimately generating high-quality candidate pairs. This framework effectively balances global semantics and local details, enabling accurate and efficient entity blocking without any labeled data. Experiments on real-world datasets demonstrate that the proposed UCL-Blocker consistently outperforms existing approaches, achieving a 3.92% higher Fα score than the current best blocking method Sudowoodo, verifying the effectiveness of the proposed framework.}
}
@article{ZHU2026114887,
title = {A dual-process neuro-symbolic framework for cognition-driven language understanding},
journal = {Applied Soft Computing},
volume = {193},
pages = {114887},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114887},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003352},
author = {Dongmei Zhu},
keywords = {Deep neural network, Cognitive linguistics, Reasoning methods, Natural language processing},
abstract = {In the field of cognitive linguistics, effectively utilizing a deep neural network (DNN) for language understanding and reasoning remains a challenge. This work aims to explore a cognitive linguistics framework and reasoning method integrated with DNN to enhance the ability to understand language at a deeper level. First, a multi-layer deep learning architecture is designed. This architecture consists of an input layer, multiple hidden layers, and an output layer, and is specifically optimized for text data. Then, a large-scale corpus from various linguistic resources is used for training and testing to ensure the model's effectiveness across different language environments. Additionally, a set of reasoning algorithms is developed to evaluate the model’s performance in processing complex linguistic phenomena such as metaphors and grammatical structures. Experimental results show that, compared to traditional language processing models, the DNN-based cognitive linguistics framework improves recognition accuracy by approximately 20 %. It particularly excels in handling complex sentence structures and semantic relationships. This demonstrates that DNN can serve as a powerful tool in cognitive linguistics research. It not only enhances language understanding precision but also strengthens the model’s reasoning capability. This work offers new perspectives and technical means for further exploring language cognition mechanisms while also identifying possibilities for optimizing model performance and expanding application areas.}
}
@article{NGUYEN2026114709,
title = {Multi-task learning fact checking with supervised reading comprehension-based evidence extraction},
journal = {Applied Soft Computing},
volume = {193},
pages = {114709},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114709},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001572},
author = {Manh Trong Nguyen and Tri Thien Nguyen and Kiet Van Nguyen},
keywords = {Fact-checking, Supervised reading comprehension, Multi-task learning, Low-resource NLP},
abstract = {In the current digital era, fact-checking has become increasingly critical due to the widespread dissemination of fake news and inaccurate information. A major challenge in this task is the ability to provide relevant evidence to verify claims effectively. Existing approaches to evidence selection often rely on unsupervised methods like semantic similarity, which use cosine similarity to find relevant evidence. However, these fail to accurately capture the nuanced contextual relevance necessary to distinguish between supportive and refuting evidence. These limitations can result in less reliable fact-checking outcomes. Our study proposes a supervised reading comprehension (SRC) model for evidence extraction (EE) tasks to address this issue. By leveraging supervised learning, our model aims to extract and assess evidence more accurately, addressing the challenges posed by unsupervised semantic similarity methods. The experimental results demonstrate the superior performance of the SRC model, particularly when utilizing the XLM-R and InfoXLM models, on the ViWikiFC and ISE-DSC01 datasets. Furthermore, we propose the SRC-FC model, which jointly applies multi-task learning (MTL) to train evidence extraction and verdict prediction tasks. The SRC-FC model delivered outstanding performance with 93.59% (F1) on the ViWikiFC dataset and 92.24% (F1) on the ISE-DSC01 dataset, when using the pre-trained XLM-R model as the embedding model. Our results demonstrate the advantages of integrating SRC and MTL approaches for more reliable and accurate fact-checking, especially in challenging linguistic environments.}
}
@article{JIANG2026114770,
title = {Feature-aware multi-head self-attention hashing for Chinese ancient document image retrieval},
journal = {Applied Soft Computing},
volume = {193},
pages = {114770},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114770},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002188},
author = {Huan Jiang and Yuwei Peng and Rongrong Li and Zhiyong Peng},
keywords = {Multi-head self-attention, Keyword-based retrieval, Deep hashing, Chinese ancient document, Representation learning},
abstract = {Deep hashing based on deep neural networks has shown great potential for document image retrieval in Chinese ancient texts. However, existing deep hashing methods for image retrieval are not tailored to the characteristics of ancient Chinese documents, which present several challenges. First, a deep hashing network must capture the complex visual features of a large variety of Chinese characters. Second, each bit of the generated hash code should independently reflect distinctive character features. In addition, due to the large number and diverse types of characters in ancient documents, a deep hashing model needs to reduce manual annotation through unsupervised learning. Finally, an end-to-end architecture is required to improve the efficiency of hash code generation. In this work, we propose an end-to-end deep hashing model named FMAH, designed to efficiently locate document images containing query characters within massive collections of Chinese ancient documents. The model first uses a series of CNN layers to extract stroke-level features, which are then fed into a multi-head self-attention module to capture semantic relationships among strokes. Each attention head is independently mapped to a single bit of the hash code, ensuring that every bit carries distinct semantic information. We introduce group metric learning and group contrastive learning to optimize the model. Based on the generated hash codes, we construct a threaded inverted hash index over the document collection and perform approximate searches using Hamming distance. Extensive experiments demonstrate that the proposed FMAH model achieves state-of-the-art performance in Chinese ancient document retrieval.}
}
@article{YOON2026114859,
title = {Transferring domain-invariant and adversarially robust feature learning for unsupervised domain adaptation},
journal = {Applied Soft Computing},
volume = {193},
pages = {114859},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114859},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003078},
author = {Hyunsoo Yoon and Jihu Lee and Dongyoon Yang},
keywords = {Adversarial attacks/Defenses, Adversarial robustness, Unsupervised domain adaptation, Domain invariant Robust features},
abstract = {Adversarial robustness has become a critical research area in trustworthy AI. Recent studies have expanded beyond supervised learning to include semi-supervised, unsupervised, and even transfer learning domains such as domain adaptation and generalization. While some recent works have proposed algorithms for adversarial robustness in domain adaptation, theoretical approaches to these methods remain underexplored. In this paper, we derive an upper bound on the robust risk in the target domain for robust domain adaptation algorithms utilizing pseudo-labels. This upper bound not only serves as the foundation for our novel algorithm but also provides insights into existing robust domain adaptation algorithms. Inspired by this derived bound, we propose a new robust domain adaptation algorithm named TRoL. Furthermore, we conduct evaluations using different perturbation budgets from existing literature. Our results reveal the vulnerability of existing methods under a rigorous evaluation methodology, demonstrating the need for a more reliable evaluation protocol for adversarially robust unsupervised domain adaptation. Our proposed method significantly outperforms existing algorithms under the new evaluation framework.}
}
@article{ZULQARNAIN2026114830,
title = {A data-driven technique for risk allocation in the micromobility sector using q-rung orthopair fuzzy rough numbers},
journal = {Applied Soft Computing},
volume = {193},
pages = {114830},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114830},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002784},
author = {Rana Muhammad Zulqarnain and Radko Mesiar and Witold Pedrycz and Imtiaz Tariq and Imran Siddique and Sohaib Abdal and Tapan Senapati},
keywords = {Micromobility, Risk allocation, Q-rung orthopair fuzzy rough numbers, CRITIC-REGIME method, MAGDM},
abstract = {Risk allocation in the micromobility sector is challenged by multi-stakeholder participation, interdependent criteria, and high uncertainty in expert judgments, which limits the effectiveness of conventional multi-attribute group decision-making (MAGDM) approaches. This study proposes a data-driven technique for evaluating risk-prevention alternatives in the micromobility sector using a q-rung orthopair fuzzy rough number (q-ROFRN). The primary objective of this research is to develop an integrated CRITIC-REGIME model by combining the Criteria Importance Through Intercriteria Correlation (CRITIC) method and the Rangements Et Gestion Intégrée des MElanges (REGIME) technique to address MAGDM problems. The proposed approach is applied to a real-world micromobility case study involving multiple governance and operational alternatives evaluated across several dimensions and 18 sub-criteria. The results indicate that state-private sector partnerships represent the most effective strategy for managing risks in micromobility systems. The findings further demonstrate that the proposed framework improves decision-making accuracy by effectively integrating multiple influential factors and accounting for uncertainty in expert assessments. Comparative and sensitivity analyses confirm that the integrated q-ROFRN-based CRITIC-REGIME model outperforms existing decision-making approaches in terms of precision, robustness, and adaptability under uncertain conditions.}
}
@article{ANAS2026114903,
title = {MAGNet: A modality-aware gating network for multimodal depression detection and severity prediction},
journal = {Applied Soft Computing},
volume = {193},
pages = {114903},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114903},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003510},
author = {Mohd Anas and Mumtaz Ahmed},
keywords = {Depression Detection, Multimodal AI, Modality-Aware Gating Network (MAGNet), Emotion Guided Attention, Cross-Modal Learning, Personalized Modality Fusion, Hierarchical Attention, Contrastive Learning, GAN based Augmentation, Affective Computing},
abstract = {Depression remains one of the most underdiagnosed mental health disorders globally, largely due to social stigma and the inherent limitations of subjective self-reporting. Although AI-driven multimodal analysis of speech and text provides a promising direction toward more objective assessment, existing models often struggle with rigid fusion strategies, limited emotion representation, and weak generalization under class imbalance. To address these challenges, we propose MAGNet (Modality-Aware Gating Network), a novel architecture that introduces a unified gating mechanism to dynamically prioritize text and speech streams at the sample level, conditioned on emotion-aware embeddings. Unlike prior approaches that rely on stacking multiple attention mechanisms, MAGNet computes a single interpretable gating coefficient derived from emotion-aware representations of both modalities, allowing the dominant modality to emerge naturally for each sample rather than being fixed a priori. This design choice reflects how emotional salience varies across individuals and interaction contexts, aligning the fusion process with principles of emotional relevance and information bottleneck theory. In addition, by integrating contrastive learning with GAN-based augmentation, MAGNet improves feature separation while mitigating data imbalance. Evaluated on two benchmark datasets, DAIC-WOZ (English) and EATD-Corpus (Chinese), MAGNet demonstrates consistent improvements, achieving F1-score and recall gains of 5–7 % over competitive baselines. These results highlight the reliability, cross-dataset generalizability, and clinical potential of MAGNet for emotion-aware, personalized depression detection, supporting its suitability for real-world mental health monitoring systems.}
}
@article{HASHEMI2026114838,
title = {Initializing K-means clustering algorithm based on frequent patterns},
journal = {Applied Soft Computing},
volume = {193},
pages = {114838},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114838},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002863},
author = {Zahra Hashemi and Maryam Amiri and Muhammad Naderi},
keywords = {Clustering, K-means, Cluster centroids, Pattern mining, Frequent patterns},
abstract = {Clustering is one of the most important topics in the field of data mining and machine learning. The purpose of clustering is to cluster the data in such a way that the data in one cluster have the most similarity with each other and the least similarity with the members of the other ones. Due to its simple implementation and excellent local performance, K-means is one of the most popular clustering algorithms. In the first step, K-means selects K data points as the initial set of centroids randomly. If the centroids are not selected correctly, the algorithm will get stuck in the local optimum. Thus, the main challenge of K-means is to select the cluster centroids optimally. Many approaches have been proposed for choosing the initial centroids of clusters. They can be divided into six categories: methods based on random points, furthest point heuristic, sorting heuristic, methods based on density, methods based on projection and methods based on splitting technique. In this paper, for the first time, a new method for initializing cluster centroids based on frequent patterns called ANTENNA (A ceNtroid initializaTion mEthod for K-means based on frequeNt pAttern) is presented. ANTENNA is a density-based method, which uses frequent patterns to discover high-density areas. In ANTENNA, using the Davies–Bouldin (DB) index, the most significant features are selected first. Then, using the frequent patterns extracted by the Apriori algorithm, high-density areas are identified and the initial centroids are determined. Finally, the K-means algorithm is run on the data to obtain the final clusters. In addition to the basic algorithms such as K-means and K-means++, ANTENNA is compared with four new and prominent methods, BDD, MMKD, MKKM and SimpleMKKM on 17 datasets. Our results show ANTENNA could outperform the other methods.}
}
@article{SHEN2026114899,
title = {Transformer-based multi-agent reinforcement learning for flexible job shop scheduling with AGVs},
journal = {Applied Soft Computing},
volume = {193},
pages = {114899},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114899},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003479},
author = {Yuxiang Shen and Xutang Zhang and Tianguo Jin},
keywords = {Transformer, Deep reinforcement learning, Automated guided vehicle (AGV), Multi-agent reinforcement learning, Flexible job shop scheduling problem},
abstract = {Integrated scheduling in flexible job shops with AGV transportation constraints presents a complex optimization challenge due to the tight coupling between operation sequencing and material handling. Existing reinforcement learning methods, typically relying on recurrent or fully connected architectures, often struggle to capture global spatio-temporal dependencies and suffer from sequential computational bottlenecks. To address these limitations, this study proposes MA-Trans, a hierarchical deep reinforcement learning framework based on Proximal Policy Optimization and Transformer encoders. By designing a cooperative dual-agent architecture, the model jointly optimizes job scheduling and AGV dispatching, employing self-attention mechanisms to efficiently encode long-range interactions among manufacturing resources. Experimental results demonstrate that MA-Trans significantly outperforms state-of-the-art baselines, including ResGAT and LSTM-Ptr, in both makespan minimization and AGV load balancing. Beyond solution quality, the proposed Transformer-based architecture reduces training time by approximately 23.8% compared to recurrent baselines while maintaining low-latency inference of around 2.75 ms. Moreover, the model exhibits robust zero-shot generalization capabilities, adapting to varying problem scales and AGV configurations without retraining, thereby highlighting its potential for real-time smart manufacturing applications.}
}
@article{LU2026114814,
title = {Tackling value estimation bias in successor features by distributional reinforcement learning},
journal = {Applied Soft Computing},
volume = {193},
pages = {114814},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114814},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002620},
author = {Mengxiao Lu and Yirui Zhou and Shaorong Xie and Yaxin Peng and Xiaofeng Zhang and Yangchun Zhang},
keywords = {Successor features, Generalized policy improvement, Distributional reinforcement learning, Value estimation bias},
abstract = {The framework of successor features (SFs) and generalized policy improvement (GPI) offers the potential to achieve zero-shot transfer in reinforcement learning (RL) across different tasks. This paper investigates the value estimation bias in SF&GPI. To shed light on this issue, we attribute the value estimation bias to the underestimation in theory. Next, we introduce the concepts of distributional RL into SF&GPI, and establish the distributional successor features (DSFs) and distributional generalized policy improvement (DGPI), alleviating the value estimation bias. On this basis, we finally examine the behavior of DSF&DGPI under the framework of multi-objective reinforcement learning (MORL). Similar to single-objective RL, it also mitigates the expected gap (value estimation bias). Experimental results demonstrate that DSF&DGPI reduces the value estimation bias inherent in SF&GPI and yields higher returns across both single-objective and multi-objective RL tasks.}
}
@article{CHEN2026114811,
title = {Multi-objective decision-making control of cutter suction dredger based on multi-scale graph representation with Bayesian optimization},
journal = {Applied Soft Computing},
volume = {193},
pages = {114811},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114811},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002590},
author = {Yong Chen and Qiubing Ren and Mingchao Li and Bolong Gao and Yonghuang Xiang and Zhongzhi Fu},
keywords = {Cutter suction dredger, Decision-making control, Operational parameters, Multi-objective optimization, Construction productivity, Energy efficiency},
abstract = {The operational parameters of cutter suction dredger (CSD) are frequently set based on empirical experience, leading to low productivity and high energy consumption. To address this issue, the present study proposes a Bayesian multi-objective optimization (MOO) framework integrating a multi-scale adaptive graph convolutional network (MAGCN) model and a multi-objective tree-structured Parzen estimator (MOTPE) algorithm. This framework aims to predict and optimize construction productivity and energy consumption performance while providing well-informed support for intelligent decision-making control. First, a hybrid feature selection method combining maximum information coefficient and Pearson correlation coefficient is applied to identify 6 key control parameters from 256 operational parameters. Second, an MAGCN model with multi-scale graph representation is proposed to establish the nonlinear mapping among geological conditions, operational parameters, construction productivity, and energy consumption. Third, the MOO framework with its mathematical formulation is constructed, and the Pareto optimal front for productivity and energy consumption is derived using the MOTPE-based Bayesian optimization algorithm. The optimal trade-off solution and corresponding operational parameters are determined by a weighted sum method. The proposed MOO framework is validated using operational data from the Tian Jing Hao CSD in the Pinglu Canal dredging project in China. The results show that the MAGCN model achieves high prediction accuracy for real-time productivity and energy consumption, with R2 values of 0.942 and 0.979, respectively. The MOTPE-driven optimization reduces standard deviations of operational parameters by 21.24 % - 97.90 %, enhancing operational stability. The framework improves productivity by 3.79 % and reduces energy consumption by 3.53 %. This work provides real-time decision-making support for optimizing CSD operations.}
}
@article{CHOWDARY2026114856,
title = {Enhanced hybrid quantum classical neural networks with novel encoding techniques for image recognition},
journal = {Applied Soft Computing},
volume = {193},
pages = {114856},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114856},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003042},
author = {Kandula Aditya Sri Krishna Raghav Chowdary and T. Janani},
keywords = {Quantum machine learning, Quantum encoding, Image classification, Hybrid neural networks, Quantum filter},
abstract = {Quantum computing offers the potential to redefine classical machine learning techniques, yet its practical integration into classical models remains underexplored. This paper proposes a Hybrid Quantum Classical Convolutional Neural Network (HQCCNN) architecture that uses a quantum filter for primary feature extraction from images, followed by a classical Convolutional Neural Network (CNN) for model training and classification. The quantum filter architecture consists of an encoding layer, random layers, and a decoding layer with Pauli-Z gates with three distinct encoding schemes, Angle, Amplitude and Basis analyzed for their performance. Two architectural configurations, with single and dual quantum filters, are also compared to evaluate their influence on the model’s performance. Among all configurations tested, the single filter Angle encoding showed better results when combined with the optimized end-to-end hybrid pipeline. Experimental evaluations which were conducted on the four benchmark datasets Overhead-MNIST, PatternNet, RSI-CB256, and NaSC-TG2 demonstrate that the proposed HQCCNN achieves the highest accuracy, surpassing both classical CNNs with varying kernel designs and existing hybrid quantum classical models. This highlights the importance of quantum encoding in quantum feature extraction and the HQCCNN’s superior capability in image classification. All quantum experiments were performed using classical simulation of quantum circuits, and the results are intended to provide comparative insights into hybrid architectures and different encoding techniques, while emphasizing their feasibility and potential scalability under real quantum execution.}
}
@article{ABID2026114842,
title = {A robust technique for detection of hybrid adversarial attack in multi-modal medical imaging},
journal = {Applied Soft Computing},
volume = {193},
pages = {114842},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114842},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002905},
author = {Muhammad Haris Abid and Rehan Ashraf and Toqeer Mahmood and CM Nadeem Faisal},
keywords = {Adversarial attack, Adversarial robustness, Hybrid attack, Multi-modal medical image},
abstract = {According to recent research, medical images remain targeted by adversarial attacks. Although lesion characteristics within medical images become more complicated in terms of resolution, this makes it challenging to secure imaging systems for medical use against adverse instances. Consequently, an efficient and straightforward approach to addressing these difficulties is required to increase the resilience of medical images. We discovered the fact the attackers provide adversarial perturbations according to the pathological features of various medical image records, which can cause the model's concentration to move to other locations. In this paper, we designed a hybrid attack to overcome maximum perturbations in multi-modal medical images. The hybrid adversarial example was designed using three methods, which are Projected Gradient Descent (PGD), Fast Gradient Sign Method (FGSM), and Basic Iterative Method (BIM). A robust model using Gaussian noise is proposed to encounter hybrid attacks. Numerous experiments using multi-modal medical datasets demonstrated that the proposed approach greatly surpasses existing adversarial defense strategies in terms of improving the resilience of medical diagnostic models across several kinds of effective attacks. During the hybrid attack, the robust accuracy is 96.87 % for 0.1 perturbation, 93.75 % for 0.3 perturbation, and 90.62 % for 0.5 perturbation.}
}
@article{SURMA2026114817,
title = {Fuzzy-logic-based model predictive control: A paradigm integrating optimal and common-sense decision making},
journal = {Applied Soft Computing},
volume = {193},
pages = {114817},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114817},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002656},
author = {Filip Surma and Anahita Jamshidnejad},
keywords = {Model predictive control, Fuzzy logic, Search and rescue robotics, Autonomous multi-robot systems},
abstract = {Exploring unknown environments and locating multiple targets with multi-robot teams remains challenging due to uncertainty about such environments and the high computational cost of existing planning methods. Model Predictive Control (MPC) is a widely used and effective approach for planning under constraints; however, traditional MPC relies on Bayesian representations and stochastic cost functions, which limit scalability and decision-making horizons in complex search scenarios. This paper introduces fuzzy-logic-based model predictive control (FLMPC), integrated with dynamic fuzzy maps of the environment, to emulate human-like reasoning and to simplify optimization, while preserving and leveraging the predictive structure of MPC and its systematic handling of constraints within the decision-making loop. Building on this foundation, we present a multi-robot exploration framework based on FLMPC for efficient target search in unknown environments. Instead of optimizing stochastic cost functions, FLMPC uses fuzzy abstractions of environmental attributes, such as passability and certainty, derived from probability distributions and local observations. This approach enables longer-horizon planning and efficient handling of multiple objectives. To enhance coordination among robots, FLMPC is extended into a bi-level parent–child architecture, where a high-level parent controller guides global exploration while local child controllers handle short-term planning. This structure not only improves coordination, but also increases robustness to environmental uncertainty thanks to combining long-term strategic decisions with reactive local adjustments that allow handling unexpected changes and environmental uncertainties more effectively. Extensive simulations in unknown 2D environments with randomly placed obstacles and human targets evaluate the proposed FLMPC framework embedded within a parent-child architecture against conventional MPC with stochastic cost functions. Results demonstrate up to 50× faster optimization and significantly improved search performance under environmental uncertainty, positioning FLMPC as a scalable and efficient planning method for large-scale search-and-rescue missions that require coordinated multi-robot exploration.}
}
@article{SHARMA2026114845,
title = {SAGE-ET: Scalable and adaptive generalized estimation of ET0},
journal = {Applied Soft Computing},
volume = {193},
pages = {114845},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114845},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002930},
author = {Gitika Sharma and Aayush Tripathi and Atharva I.P. Agrawal and Himanshu Sharma and Laxmi Kant Sharma},
keywords = {Reference evapotranspiration, Limited climate data, Federated learning, FedProx, Generalized model},
abstract = {The estimation of reference evapotranspiration (ET0) remains a challenging task, particularly in heterogeneously distributed data environments. Traditional physics-based models rely on localized climatic data, which limits their effectiveness in data-scarce regions. Similarly, centralized artificial intelligence models often face privacy risks and lack generalization when applied to heterogeneous environments and evolving environmental conditions. To address these challenges, we introduce SAGE-ET—a Scalable and Adaptive framework for the Generalized Estimation of ET0. This model integrates an innovative federated learning architecture that combines ConvLSTM networks with a customized FedProx optimization strategy, termed FedET0-Prox, resulting in a robust, privacy-aware, and scalable ET0 forecasting framework applicable across diverse climatic zones. The proposed SAGE-ET framework is evaluated on climate datasets representing four distinct climatic regions—arid, semi-arid, tropical wet-dry, and humid subtropical—using two subsets of meteorological features. Experimental results confirm the superior performance of SAGE-ET compared to traditional centralized ConvLSTM models, demonstrating greater resilience to data distribution shifts, reduced root mean square error (RMSE), ranging from 0.0508 to 0.0310 mm/day, and an improved coefficient of determination (R2), ranging from 0.9377 to 0.9744. This framework represents the next generation of distributed AI systems for environmental intelligence, highlighting the potential of federated learning to balance data privacy, collaborative intelligence, and scalability in complex, heterogeneous, and distributed contexts. SAGE-ET outperforms prior hybrid DL models (CNN-LSTM and TCN-BiLSTM) in RMSE and R2 via federated generalization.}
}
@article{SARVARYKARIZAKY2026114854,
title = {Dynamic cooperative genetic programming for synergistic feature construction in classification problems},
journal = {Applied Soft Computing},
volume = {193},
pages = {114854},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114854},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003029},
author = {Hamide {Sarvary Karizaky} and Mohammad Mehdi Ebadzadeh},
keywords = {Genetic programming, Cooperative co-evolution, Feature construction, Feature selection, Dynamic clustering, Multi-class classification},
abstract = {This paper introduces Dynamic Cooperative Genetic Programming (DCGP), a novel method designed to enhance pattern classification accuracy by constructing and selecting high-quality features. DCGP employs a problem decomposition strategy that divides the feature construction task into smaller subcomponents, each represented by a subpopulation. These subpopulations are formed dynamically through clustering, which enables efficient search-space exploration and promotes feature diversity. Feature evaluation is based on two main criteria: the synergy criterion, which captures interactions among features, and mutual information, which measures each feature’s relevance to the target class. A random crossover operator further enhances diversity and prevents premature convergence. DCGP is evaluated on 17 benchmark datasets, encompassing both binary and multi-class tasks. It achieves competitive or superior accuracy compared to 20 state-of-the-art methods, including classical classifiers, multi-tree GP variants, Random Forests, and deep learning models for tabular data. On average, DCGP reduces the number of selected features by over 13% while improving accuracy by 11%. Moreover, the evolved features are explicit and interpretable, offering deeper insights into the underlying data relationships.}
}
@article{ACAMPORA2026114841,
title = {Timed fuzzy quantum-inspired anomaly detection in industrial scenarios},
journal = {Applied Soft Computing},
volume = {193},
pages = {114841},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114841},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002899},
author = {Giovanni Acampora and Andrea Senese},
keywords = {Quantum-inspired computing, Anomaly detection, Timed automata, Fuzzy clustering, Industrial monitoring, Computational intelligence},
abstract = {Industrial systems generate large volumes of multivariate time series data that are complex, dynamic, and affected by noise, where early anomaly detection is critical to ensure operational safety and reliability of the system. Conventional machine learning methods often struggle with the non-linear behaviors, temporal dependencies, and subtle or latent faults that characterize real-world industrial environments. This paper proposes a hybrid anomaly detection framework that integrates Timed Automata to model the dynamic evolution of system behaviors with a Quantum Fidelity-based Fuzzy C-Means clustering algorithm to identify anomalous patterns. The proposed approach is validated on the Skoltech Anomaly Benchmark (SKAB), which simulates realistic industrial scenarios by injecting temporally localized anomalies that are sometimes masked by normal process fluctuations, making them particularly challenging to detect. The experiments provide a comparative analysis with state-of-the-art classical methods. The results highlight the potential of combining symbolic temporal modeling with quantum-inspired clustering to enhance anomaly detection, as demonstrated in an example of a complex, dynamic, and noisy industrial environment.}
}
@article{QU2026114862,
title = {Single domain generalization crowd counting via hybrid space fusion and contrastive disentanglement learning},
journal = {Applied Soft Computing},
volume = {193},
pages = {114862},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114862},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003108},
author = {Yang Qu and Tianyi Liao and Zhiruo Qiu and Liran Yang and Ping Zhong and Yingyi Chen and Zhencai Shen},
keywords = {Single domain generalization, Crowd counting, Spatial and frequency space, Domain-invariant and domain-specific information},
abstract = {In this paper, we address a practical yet challenging problem: generalizing a model trained solely on a single source domain to multiple unseen target domains to enhance its adaptability across diverse data distributions. Existing crowd counting methods often suffer from diminished accuracy when encountering domain shifts, primarily due to their insufficient robustness. To overcome this limitation, we propose a novel single domain generalization network named HSFCDL, which integrates hybrid space fusion and contrastive disentanglement learning. The methodology is built upon two key observations: (1) Diverse domain-specific features and high-quality domain-invariant features can effectively enhance the model’s learning capacity, thereby improving domain generalization performance. (2) The hidden features with the same semantic information across different domains exhibit inherent consistency, and leveraging this discovery can effectively mitigate the domain shift. Specifically, we design a novel hybrid space fusion method, which maps image features into the spatial and frequency spaces, to generate diversified and high-quality data by integrating information from them. Then, we are the first to design a domain generalization salient loss to help the model focus on the domain-invariant information learning. Finally, we propose a contrastive disentanglement learning to align the attention distribution of image pairs to disentangle domain-invariant and domain-specific features. Compared with the advanced approaches, the proposed HSFCDL achieves superior performance on five challenging benchmarks, with a 49% significant reduction in counting errors on the SN→FH task. Notably, it even surpasses some popular domain adaptation methods under the single domain generalization task.}
}
@article{YANG2026114833,
title = {SSTIGNet: A convolutional neural network for speckle style transfer image generation in digital image correlation},
journal = {Applied Soft Computing},
volume = {193},
pages = {114833},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114833},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002814},
author = {Cheng Yang and Xuhui Jiang and Zitong Xiang and Linliang Wei and Wei Wei and Liming Lei and Yingchun Xie and Yu Long},
keywords = {Deep learning, Image style transfer, Deformation-aware learning, Digital image correlation, Image synthesis},
abstract = {Speckle image preparation—essential yet labor-intensive in digital image correlation (DIC)—has long been a bottleneck that limits measurement efficiency and hinders the wider adoption of DIC. This work introduces SSTIGNet, a Speckle Style-Transfer Image Generation Network that efficiently produces paired reference and deformed speckle images from arbitrary input image pairs, guided by a single reference speckle image. The framework comprises two complementary modules: a style-transfer module, which integrates speckle characteristics from a target speckle image into a reference image while preserving the reference’s key textural attributes; and a difference-extraction module (a frozen, CSFlow-like component) that quantitatively analyzes deformation between an input reference and its deformed counterpart, then warps the style-transformed reference using the estimated displacement field to obtain the final deformed speckle image. Comprehensive experiments demonstrate the approach’s strong performance and practical suitability in engineering measurement systems. Under a unified, measurement-centric protocol across seven speckle styles and seven content images, SSTIGNet achieves the lowest AIG and GIE errors (AAE = 1.820 and 0.072), yielding an average improvement of 43.6% in AIG and 23.3% in GIE over the best learning-based baselines. In addition, it reduces the AIG error by 93.5–97.1% compared with calibrated procedural anchors (Perlin noise and Manual DIC). At 512 × 512 resolution, SSTIGNet uses 3.22M parameters and runs at 113 ms per image (batch = 1, same GPU). We further present SSTIGNet as a DIC-oriented speckle style-transfer CNN that generates measurement-ready speckle fields—pseudo-random, high-contrast, and free of periodic artifacts. Our contributions are: (i) a task-specific objective that emphasizes speckle statistics and structural randomness; (ii) a measurement-aligned evaluation protocol that couples speckle-quality metrics with downstream DIC matching; and (iii) extensive ablation and sensitivity analyses that validate each design choice. To the best of our knowledge, this is the first experimentally validated deep-learning framework for speckle image preparation, establishing a new paradigm for the field and opening avenues for advanced DIC applications.}
}
@article{WEN2026114849,
title = {Earthquake intensity mapping model and decision-making mechanism by using explainable machine learning based on multi-source data fusion},
journal = {Applied Soft Computing},
volume = {193},
pages = {114849},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114849},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002978},
author = {Haijia Wen and Yingqi Zeng and Mingrui Di},
keywords = {Earthquake Intensity, Machine Learning, Multi-source Data, Stacking model},
abstract = {Earthquakes pose significant hazards to human society. Scientifically and accurately predicting seismic intensity is crucial for mitigating the impacts of earthquake disasters. Traditional seismic intensity prediction methods, constrained by limitations in data acquisition and processing approaches, often fail to comprehensively account for factors influencing seismic intensity, leading to inaccurate prediction results. To address this, this study proposes an interpretable machine learning model based on multi-source data fusion for macro-seismic intensity prediction. We constructed a comprehensive multi-source seismic intensity prediction database incorporating four dimensions: ground motion, topography, geology, and site characteristics. After removing highly correlated features through Spearman correlation analysis, recursive feature elimination was employed to ultimately identify 13 critical features with significant impacts on seismic intensity. Additionally, we developed a multi-strategy fusion optimization algorithm to enhance model performance. Results demonstrate that the Stacking model integrating Random Forest and Backpropagation Neural Network achieves the highest prediction accuracy compared to other methods, with R²= 0.968 and RMSE= 0.08. Furthermore, the Shapley Additive Explanations (SHAP) interpretability method was applied to analyze the model, revealing feature importance rankings across the study area and interactive relationships between specific features and prediction outcomes. This research provides valuable insights for post-disaster secondary hazard prevention and emergency response deployment.}
}
@article{DANG2026114836,
title = {Deep reinforcement learning-based two-stage coevolutionary framework for multimodal multi-objective optimization},
journal = {Applied Soft Computing},
volume = {193},
pages = {114836},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114836},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600284X},
author = {Qianlong Dang and Xiaochuan Gao and Shuwei Hou and Zhengxin Huang and Guanghui Zhang and Junhu Ruan},
keywords = {Multimodal multi-objective optimization, Evolutionary operator, Deep reinforcement learning, Adaptive operator selection, Deep Q network},
abstract = {In multimodal multi-objective optimization, different evolutionary operators with different characteristics are essential for reproducing offspring and searching for Pareto optimal solution sets. However, many existing multimodal multi-objective evolutionary algorithms (MMOEAs) are designed with a single evolutionary operator for reproduction, leading to their insufficient adaptability in solving different types of multimodal multi-objective optimization problems. To address the above problems, this paper proposes a deep reinforcement learning (DRL) based two-stage coevolutionary framework for MMOEA (MMOEA-DRL). Specifically, a DRL-based adaptive operator selection strategy is proposed, in which genetic algorithms and differential evolutionary operators are used as candidate evolutionary operators. Moreover, an offline strategy is employed to train a deep Q network (DQN) model, which determines the potential future payoffs of different evolutionary operators based on the current state of the population and the environment, and selects the more promising evolutionary operators. In addition, the proposed adaptive operator selection strategy is integrated into a two-stage coevolutionary framework. The DQN provides adaptive evolutionary operators to guide population evolution, and the large amount of diversified data generated by the population during the search process feeds back into the training of the DQN, which in turn enhances its strategy learning capability and decision accuracy. Experimental comparisons with MO_Ring_PSO_SCD, MMODE_CSCD, MMODE_ICD, MOEA/D-SS, and CMMO on CEC2019 and IDMP show that MMOEA-DRL obtains an optimal value of 64.71% and outperforms the nearest-performing algorithm by 55.74% for the performance indicator in the decision space. Furthermore, MMOEA-DRL still has the best distribution results on a real-world map-based distance minimization problem.}
}
@article{THINGOCANH2026114858,
title = {Probabilistic electric load forecasting via adaptive online learning and multi-objective optimization: A NA-TP forecasting approach},
journal = {Applied Soft Computing},
volume = {193},
pages = {114858},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114858},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003066},
author = {Nguyen {Thi Ngoc Anh} and Nguyen {The Phong}},
keywords = {Load forecasting, Granger causality, Transformer, Online learning, Multi-objective optimization},
abstract = {Forecasting electric load in real time remains a challenging task due to data volatility, external disturbances, and increased uncertainty arising from renewable energy integration. Existing methods often fall short in jointly achieving high accuracy, reliable uncertainty quantification, and adaptability to distributional shifts. To address this, we propose NA-TP Forecasting (Neural Adaptive Time-series Predictor), a unified framework for a novel dynamically adaptive function of online probabilistic forecasting. It combines Transformer-based sequence modeling, Granger causality for feature selection, dynamic regret-aware online learning, and multi-objective optimization. Three complementary objectives are jointly optimized: QR-AEP (Quantile Regression with Asymmetric Error Penalty) for asymmetric quantile accuracy, Q-Risk for probabilistic calibration, and Prediction Interval Width (PIW) for forecast sharpness, forming a explicit tri-objective optimization framework. Extensive evaluations on multiple real-world benchmark electricity load datasets demonstrate that NA-TP Forecaster consistently outperforms strong baselines spanning classical statistical models, online recurrent neural forecasting methods, and state-of-the-art transformer-based probabilistic forecasting architectures, offering robust, adaptive, and well-calibrated high-sharpness forecasts suitable for modern power system operations.}
}
@article{TASDELEN2026114910,
title = {Explainable machine learning framework for predicting heat transfer coefficients in water-cooled minichannels},
journal = {Applied Soft Computing},
volume = {193},
pages = {114910},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114910},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003583},
author = {Fatih Taşdelen and Mehmet Emin Tabar},
keywords = {Explainable machine learning, Particle swarm optimization (PSO), Average heat transfer coefficient (AHTC), Mini-channel, CatBoost},
abstract = {Accurate prediction of heat transfer in compact thermal systems is essential for many engineering applications, yet conventional CFD, experimental, and empirical methods are often costly or limited in complex flows. This study proposes an explainable machine learning framework to estimate surface-averaged heat transfer coefficients (AHTCs) in water-cooled minichannels with three variable-height bulges (bulge 1, bulge 2, and bulge 3). High-fidelity CFD simulations using the SST k–ω turbulence model generated a reliable dataset (N = 537). Four PSO-enhanced gradient boosting models (PSO-GB, PSO-XGBoost, PSO-CatBoost, and PSO-ETR) were developed, with PSO-CatBoost identified as the optimal model. PSO-CatBoost achieved high R² values of 0.997 and 0.993 for bulge 1 and bulge 2, while bulge 3 showed similar performance with PSO-XGBoost (R² ≈ 0.99); these R² values are reported on the held-out test set, while PSO hyperparameter tuning was conducted using 5-fold cross-validation. SHapley Additive exPlanations (SHAP) evaluated overall parameter contributions, and Individual Conditional Expectation (ICE) analysis provided detailed, instance-level interpretability, clarifying the model’s decision process. The results demonstrate that the framework offers accurate, robust, and interpretable predictions, making it a reliable alternative to traditional methods for advanced cooling and microchannel-based thermal systems.}
}
@article{LIU2026114797,
title = {An enhanced multi-criteria decision making framework for evaluating LLM-integrated smart product-service systems using spherical fuzzy rough numbers},
journal = {Applied Soft Computing},
volume = {193},
pages = {114797},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114797},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002450},
author = {Zhongkui Liu and Danhui Zhang and Qinghua Liu},
keywords = {Spherical fuzzy rough numbers, Multi-criteria decision making, LOPCOW, RAFSI, Smart product-service systems, Large language model, Uncertainty modeling},
abstract = {Integrating Large Language Model (LLM) into Smart Product-Service Systems (SPSS) introduces challenges in design evaluation due to inherent uncertainties and complex decision criteria. To address these challenges, we propose SFRN-LOPCOW-RAFSI, a novel multi-criteria decision making (MCDM) framework that combines spherical fuzzy rough numbers (SFRN), logarithmic percentage change-driven objective weighting (LOPCOW), and ranking of alternatives through functional mapping of criterion sub-intervals into a single interval (RAFSI). This study applies the proposed framework to a conceptual design evaluation case for a refrigerator service system, where four LLM-integrated service solutions are assessed based on 15 evaluation criteria. The methodology consists of three stages: (1) defining the problem structure, (2) computing the weight coefficients of the criteria using the SFRN-based LOPCOW method, and (3) ranking the design alternatives through the SFRN-based RAFSI approach. SFRN can represent a more extensive range of uncertainty and effectively handle uncertainty within the decision-making group, enhancing the reliability of the evaluation process. Sensitivity analysis and comparative analysis were conducted to validate the proposed method, confirming its robustness and effectiveness. This study's findings provide valuable insights for DMs in optimizing the integration of LLMs into SPSS design processes.}
}
@article{YAN2026114886,
title = {A zero-shot segmentation framework with detection prompts for automated rock quality designation (RQD) estimation from core box images},
journal = {Applied Soft Computing},
volume = {193},
pages = {114886},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114886},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003340},
author = {Jianhua Yan and Zhihai Li and Yongqiang Liu and Pinghong Gao and Hua Li and Xiansen Xing and Zhipeng Li},
keywords = {RQD, Core box image, Zero-shot learning, Promptable segmentation, Object detection},
abstract = {Rock Quality Designation (RQD) serves as a crucial index in rock mass classification. Recent advances in computer vision have enabled surveyors to reduce tedious length measurement tasks in core boxes, but a robust model is still urgently required for reliable RQD estimation. In this study, a cascaded framework that integrating YOLO11 with SAM was developed for automated RQD estimation. The main workflow involves core detection and bounding boxes extraction using YOLO11, followed by box prompt-based core segmentation via SAM. The YOLO11 was trained on a compiled rectified core box image dataset containing 30,104 intact core samples, whereas SAM worked in a zero-shot manner without further training. Hyperparameter and data augmentation ablation experiments were first designed to optimize the YOLO11, raising the validation metric mAP@50–95 to 92.4%. Error analyses of target length and RQD were then conducted on a PVC tube dataset and a core box dataset. Predictions showed excellent agreement with ground truth: the mean absolute error and root mean squared error across 1491 RQD observations were 0.54 and 1.36, respectively. Using diverse testing scenarios, YOLO11-SAM was compared against SAM with different prompts, YOLO11-seg and existing approaches (e.g., Mask R-CNN). It exhibited superior performance in separating adjacent cores with narrow gaps. The YOLO11 filters out non-target objects and localizes cores, which then leverages the zero-shot capability of SAM for predicting non-overlapping masks without requiring morphological postprocessing. This decoupled design addresses the frequently mentioned issue of incomplete segmentation associated with an end-to-end architecture in existing approaches.}
}
@article{ZHAO2026114866,
title = {A novel federated adaptive hybrid sampling framework for imbalanced data classification},
journal = {Applied Soft Computing},
volume = {193},
pages = {114866},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114866},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003145},
author = {Zhuo Zhao and Ming Zheng and Fanhao Ma and Tong Li},
keywords = {Federated learning, Imbalanced, Adaptive, Sampling},
abstract = {Federated Learning (FL) enables collaborative model training without direct data sharing, but its performance is severely degraded by class imbalance and non-independent and identically distributed(Non-IID) data distributions commonly observed in real-world scenarios. Although significant research efforts have been devoted to enhancing FL performance under Non-IID conditions, the imbalance problem remains insufficiently addressed. To tackle this challenge, a federated adaptive hybrid sampling framework (FedAHS) is proposed. FedAHS integrates parallel hybrid sampling with a differential evolution algorithm to dynamically optimize client-level sampling rates, thereby approximating optimal local data distributions. In addition, a sampling-rate dynamic weighted aggregation strategy is introduced to mitigate the effects of data heterogeneity and training variability across clients. Extensive experiments conducted on multiple real-world datasets demonstrate that FedAHS consistently outperforms state-of-the-art federated learning methods. The source code is available at https://github.com/Zuo-spe/FedAHS.}
}
@article{MA2026114890,
title = {TL-CycleNet: A transformer-LSTM framework for IMU-based bicycle riding behavior perception to enhance cyclist safety},
journal = {Applied Soft Computing},
volume = {193},
pages = {114890},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114890},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003388},
author = {Jinyu Ma and Yuanyuan Ren and Xueting Liang and Yujie Hao and Haoran Wu and Zhongjie Zhang and Ruiqi Xu and Qingqing Yuan and Han Li},
keywords = {Cycling safety, Transformer-LSTM, IMU, Riding behavior perception, Cycling warning},
abstract = {With the promotion of sustainable transportation worldwide, bicycles have become the cornerstone of urban transportation. However, as a vulnerable group among road users (VRU), the number of cyclist deaths has continued to increase in recent years, and it is urgent to propose measures to strengthen cycling safety. This study proposes the TL-CycleNet framework, grounded in a Transformer-LSTM model, that uses data from inertial measurement units (IMUs) to perceive cyclist behavior in low latency. The framework’s efficacy is validated and implemented through an embedded experimental platform. The TL-CycleNet framework commences with forward modeling of IMU mounted positions, optimizing their adaptation to road condition stability. This process enhances both the sensitivity and precision of capturing cycling behaviors. Subsequently, the framework integrates the global attention mechanism inherent to Transformers with the local temporal modeling capabilities of Long Short-Term Memory (LSTM) networks, enabling comprehensive time-series modeling. This hybrid approach addresses a limitation of existing models, which tend to capture local features while neglecting global dependencies in IMU time-series data. The TL-CycleNet framework is proposed to improve long-term and short-term temporal feature extraction. In perception evaluations of four key cycling behaviors, namely proceeding straight, turning left, turning right, and decelerating, the framework achieves a classification accuracy of 96.03% and an F1-Score exceeding 0.95. To further substantiate its practical utility, a cycling behavior perception and warning validation system was developed to evaluate the framework under real-world cycling conditions. The framework performed well in real-world road tests and passed rigorous testing in complex urban environments.}
}
@article{GAO2026114785,
title = {MT-dyna: A framework for evaluating multi-turn capabilities of LLMs},
journal = {Applied Soft Computing},
volume = {193},
pages = {114785},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114785},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002334},
author = {Jun Gao and Junlin Cui and Anwen Yang and Yiqi Tong and Huijia Wu and Xiangzheng Zhang and Yaodong Yang and Zhaofeng He},
keywords = {LM, Dialogue, Multi-turn, Dynamic evaluation},
abstract = {Complex tasks increasingly require multi-turn dialogues with Large Language Models (LLMs). However, existing multi-turn benchmarks primarily focus on evaluating LLMs’ human imitation ability, neglecting their intent following capacity. They also use a set of pre-defined questions to evaluate LLMs, which is prone to bias and data contamination. To address these limitations, we propose a novel multi-turn evaluation framework MT-dyna, which focuses on evaluating LLMs’ intent following capacity and establishes intent sets for diverse tasks. Different from previous static evaluation strategies, MT-dyna establishes a dynamic evaluation framework capable of assessing varied dialogue tasks, such as task-oriented and chit-chat dialogues. To automatically generate high-quality and diverse follow-up questions, we design a score-based question generator capable of producing questions of moderate difficulty and significant diversity. Evaluations on the MultiWOZ, MuTual, and our generated dataset demonstrate superior discriminability compared to static approaches, showing that dynamic multi-turn evaluation can change models’ scores by up to 15% compared to static evaluation. We note that intent following is more distinctly differentiated in dynamic evaluations and the number of consecutive relevant turns is a key factor influencing performance.}
}
@article{GOSWAMI2026114788,
title = {Adaptive type-3 fuzzy logic system for modeling wear loss and coefficient of friction in composite materials},
journal = {Applied Soft Computing},
volume = {193},
pages = {114788},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114788},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600236X},
author = {Shriya Goswami and Dipak Kumar Jana},
keywords = {Adaptive type-3 fuzzy logic system (T3FLS), Sugeno fuzzy model, Uncertainty modeling, Tribological prediction, Bronze–TiB composites, Global–local adaptation},
abstract = {Accurate prediction of wear loss (WL) and coefficient of friction (COF) in composite materials remains challenging due to nonlinear behavior, experimental uncertainty, and limited sample availability. To address these issues, this work proposes an Adaptive Type-3 Fuzzy Logic System (Adaptive T3FLS) with a data-dependent membership function scaling mechanism that adjusts model smoothness according to the local variance characteristics of the input space. The proposed framework is evaluated against conventional Type-2 fuzzy systems and the Adaptive Neuro-Fuzzy Inference System (ANFIS) using standard performance metrics including MAE, RMSE, MAPE, and AIC. To explicitly assess robustness under small-sample conditions, a rigorous Leave-One-Out Cross-Validation (LOOCV) analysis is conducted across all available experimental samples. Results show that Adaptive T3FLS achieves consistent reductions in prediction error for both WL and COF compared to baseline models. The LOOCV results demonstrate that the proposed model outperforms ANFIS in the majority of validation folds, indicating stable generalization behavior rather than isolated performance gains. While ANFIS remains competitive in certain high-variability regimes, the adaptive Type-3 framework exhibits improved robustness and reduced fold-to-fold variability. Overall, these findings suggest that Adaptive T3FLS provides a reliable and data-efficient modeling approach for tribological prediction problems where experimental data are inherently limited.}
}
@article{YANG2026114809,
title = {Robust photovoltaic power forecasting via noise-suppressive structured global convolution and bidirectional mamba modeling},
journal = {Applied Soft Computing},
volume = {193},
pages = {114809},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114809},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002577},
author = {Mengji Yang and Haiqing Zhang and Xi Yu and Aicha Sekhari Seklouli and Yuanping Xu and Yacine Ouzrout},
keywords = {Photovoltaic power forecasting, Long-term forecast, Noise robustness, Mamba, Structured global convolution},
abstract = {Photovoltaic power generation exhibits inherent variability and stochasticity caused by multiple meteorological variables, equipment measurement errors, and high-frequency noise interference. These disturbances obscure latent temporal correlations in raw data while posing critical challenges for long-term dependencies modeling. Transformer-based architectures face two main limitations when handling long sequences: the quadratic complexity of self-attention mechanisms causes inefficiency, and their focus on local temporal patterns overlooks broader global trends. Furthermore, the dynamic allocation of self-attention weights frequently misinterprets high-frequency noise as valid signals, substantially compromising prediction reliability. To overcome these challenges, we introduce a hybrid architecture combining Structured Global Convolution and bidirectional Mamba, achieving performance breakthroughs. The Mamba utilizes a selective scanning mechanism to filter out irrelevant information. This enables it to capture the intrinsic temporal correlations and alleviate the negative impacts of local noise. Simultaneously, a Structured Global Convolution leverages multi-scale global convolution to extract long-term dependencies, and its inherent low-pass filtering properties help smooth out local noise during feature extraction. The architectural design achieves an equilibrium between predictive fidelity and computational tractability, while simultaneously ensuring robust stability under high-noise regimes through dual noise suppression pathways. Empirical evaluations on Hebei photovoltaic power datasets and cross-domain benchmark datasets validate that the novel hybrid architecture statistically outperforms state-of-the-art baselines across comprehensive quantitative metrics. Additionally, it demonstrates excellent fault tolerance in noisy environments, ensuring it remains a dependable tool for photovoltaic power management and dispatch.}
}
@article{THIND2026114837,
title = {SECURENet: Secure encoder-decoder based multiple watermarking for the protection of digital images},
journal = {Applied Soft Computing},
volume = {193},
pages = {114837},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114837},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002851},
author = {Roopkamal K. Thind and Ashima Anand and Anamika Sharma},
keywords = {Digital watermarking, Deep learning, Encryption, Encoder-decoder architecture, Multiple watermarking, Robustness, Security, Signal processing attacks},
abstract = {In the digital age, the exponential growth of visual data exchange has led to concerns regarding the authenticity, security, and integrity of images, particularly due to advancements in deepfake technology and digital media manipulation. To address these challenges, this paper presents a novel deep learning-based multiple watermarking framework, SECURENet, that integrates chaotic encryption techniques for secure, robust, and high-capacity watermarking. SECURENet employs a deep learning-based encoder-decoder architecture to embed multiple secret images into a single cover image, ensuring high embedding capacity while maintaining imperceptibility and fidelity. Chaotic encryption, based on sensitive initial conditions, is utilized to scramble and secure watermarked images, making unauthorized reversals computationally infeasible without the encryption key. Experimental evaluations on benchmark datasets, including Tiny ImageNet, COCO, CIFAR-10, and CIFAR-100, validate the efficacy of the model. The proposed framework achieves a maximum PSNR of 71.87 dB and an SSIM of 1.000, indicating superior visual quality and imperceptibility. Over 800 training epochs, PSNR progressively improves, reflecting the model’s scalability. Robustness is demonstrated against various signal processing attacks, with NCC values exceeding 0.995 under various noise and distortion conditions. Compared to state-of-the-art methods, the framework achieves a 66.45% improvement in PSNR and a 3.83% improvement in NCC, highlighting its advanced imperceptibility and resilience. By integrating chaotic encryption with a deep learning-based architecture, this work establishes a transformative solution for secure, high-capacity watermarking, addressing modern multimedia challenges, and ensuring the integrity of visual content.}
}
@article{XIE2026114871,
title = {An innovative feature selection approach with two-stage fusion using fuzzy neighborhood strategies},
journal = {Applied Soft Computing},
volume = {193},
pages = {114871},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114871},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003194},
author = {Tian Xie and Weiping Ding and Hengrong Ju and Jiashuang Huang and Yuepeng Chen},
keywords = {Feature selection, Fuzzy neighborhood differential evolution, Fuzzy neighborhood mutual information decision tree, Two-stage fusion},
abstract = {In machine learning and data mining, feature selection is essential for identifying relevant features that enhance model accuracy and interpretability. This study introduces a two-stage fusion feature selection method called fuzzy neighborhood differential evolution and decision tree (FNDEDT). The first stage employs the fuzzy neighborhood differential evolution (FNDE) algorithm, which uses fuzzy logic to improve tolerance to data uncertainty and effectively finds optimal feature combinations in high-dimensional spaces. The second stage utilizes the fuzzy neighborhood mutual information decision tree (FNMIDT) to assess feature importance. This approach calculates the mutual information of features with respect to the target variable, refining the most informative features from those identified in the first stage. Experimental results reveal that FNDEDT significantly enhances classification accuracy, as well as F1 score and AUC metrics, with improvements exceeding 3% compared to leading methods. This approach consistently outperforms other techniques across various datasets. Ablation studies indicate that the integrated FNDEDT method surpasses the performance of its individual components, thus providing a powerful tool for boosting classification capabilities in complex, high-dimensional datasets. When applied to the schizophrenia dataset, FNDEDT improves classification accuracy by roughly 5% and can localize disease-related brain regions, highlighting both its practical value and its ability to reveal clinically meaningful patterns.}
}
@article{ZHOU2026114758,
title = {Multi-scale contrastive learning with cluster-aware hard sample mining for attributed graph clustering},
journal = {Applied Soft Computing},
volume = {193},
pages = {114758},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114758},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002061},
author = {Lijuan Zhou and Mengqi Wu and Xinhang Xu and Xinran Li and Changyong Niu and Bin Wu},
keywords = {Hard sample mining, Graph contrastive learning, Attributed graph clustering, Multi-scale contrastive learning, Cluster-aware representation learning},
abstract = {Attributed graph clustering has attracted increasing attention for its ability to reveal latent community structures. It aims to learn a rich node representation, whose quality is closely related to the clustering performance. Recent contrastive learning approaches have shown promise by aligning similar nodes and separating dissimilar ones. However, they generally suffer from two limitations: (1) They fail to mine hard samples from a clustering perspective by viewing all samples equally. (2) They focus solely on contrast between local node-level representations, leading the model to concentrate on single-scale information while ignoring global semantics of the graph. To address these issues, we propose Multi-scale Contrastive learning with Cluster-aware Hard sample mining (MSCH) for attributed graph clustering. MSCH is beneficial for learning discriminative node representations by mining cluster-aware hard samples, and capturing both local and global information through multi-scale contrastive learning, thereby better capturing complex topological structures. Specifically, MSCH leverages high-confidence cluster pseudo-labels to guide the selection of positive and negative samples, aligning node representation learning with cluster structure. Hard samples are then identified based on cluster difficulty through a weight regulation function. Meanwhile, a multi-scale contrastive learning is proposed to combine graph-to-node and node-to-node level contrasts, which learns complementary information between local node and global graph representations. The proposed MSCH method has been evaluated through extensive experiments on six datasets. The results demonstrate the superiority of MSCH for clustering nodes that lie on ambiguous boundaries, with an average ACC gain of 1.2% over the best existing method.}
}
@article{SINGH2026114766,
title = {Downscaling SMAP soil moisture using a hybrid machine-learning algorithm},
journal = {Applied Soft Computing},
volume = {193},
pages = {114766},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114766},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002140},
author = {Abhilash Singh and M. Niranjannaik and Kumar Gaurav},
keywords = {Soil moisture, Downscaling, SMAP, Nature-inspired algorithm, Scorpion hunting strategy, Fuzzy inference system},
abstract = {This study introduces an innovative approach for downscaling Soil Moisture Active Passive (SMAP) satellite soil moisture data from a coarse spatial resolution of 9 km to a refined resolution of 1 km. The proposed method uniquely integrates the Scorpion Hunting Strategy Algorithm, a novel nature-inspired optimisation technique, with a fuzzy inference system. Validation was performed using field measurements obtained from two climatically distinct and data-scarce regions: Bhopal (semi-arid) and the Kosi Fan (humid sub-tropical). The resulting high-resolution soil moisture maps demonstrated a strong correlations with the in-situ observations (correlation coefficients (R) of 0.79 and 0.76, and root mean square errors (RMSE) of 0.053 m3/m3 and 0.043 m3/m3 for Bhopal and Kosi Fan, respectively). These findings point to the robustness and versatility of the proposed approach in capturing intricate spatial variations of soil moisture across diverse climatic regimes. Performance of the algorithm was further verified by testing with publicly available data from other fields, enhancing its broader applicability. Overall, this novel approach contributes a significant advancement in soil moisture downscaling techniques, offering valuable insights and practical benefits for application in agriculture, hydrological forecasting, and environmental monitoring.}
}
@article{LI2026114855,
title = {MGGL: A multi-grained graph learning model for EEG emotion recognition},
journal = {Applied Soft Computing},
volume = {193},
pages = {114855},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114855},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003030},
author = {Mingjie Li and Heming Huang},
keywords = {Electroencephalogram (EEG) emotion recognition, Inter-subject variability, Self-supervised learning, Multi-grained graph learning},
abstract = {Previous electroencephalogram (EEG) emotion recognition methods rely heavily on fixed emotion labels, ignoring the inherently unstable emotional responses due to high inter-subject variability. Inspired by the success of K-core graph convolutional networks in unsupervised graph dynamics modeling, a multi-grained graph learning model, abbreviated as MGGL, is proposed to learn subtle EEG representations for cross-subject EEG emotion recognition tasks. The proposed MGGL model consists of a pretraining stage and a fine-tuning stage. In the pretraining stage, a dual-stream graph representation (DSGR) module and a multi-grained subgraph learning (MGSL) module are proposed. The DSGR module is used to extract and enhance the EEG graph representations through dual-stream learnable brain connectivity modeling, which facilitates comprehensive characterization of data distributions. The MGSL module preserves both key local connections and global structures based on input signals while simultaneously capturing dynamic properties of EEG subgraphs. In the fine-tuning stage, the pretrained network is fine-tuned for the emotion classification task using labeled EEG data, thereby improving the performance of emotion recognition in low-resource scenarios. In subject-independent, subject-dependent, and cross-domain experiments, the proposed MGGL model has shown remarkable advantages in learning more discriminative features for EEG emotion recognition.}
}
@article{WANG2026114578,
title = {A multi-strategy population-free particle swarm optimization algorithm under gamma distribution in a fixed sample domain and its comprehensive analysis},
journal = {Applied Soft Computing},
volume = {193},
pages = {114578},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114578},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000268},
author = {Ru-Yu Wang and Jeng-Shyang Pan and Shu-Chuan Chu and Bor-Shyh Lin and Ning Zhong},
keywords = {Particle swarm optimization, Gamma distribution, Small-sample probability model, Vector operator, Levy flight},
abstract = {The capacity availability of hardware is often a great concern when solving realistic optimization problems, particularly for some devices with low computing power. The multi-particle advantage of swarm intelligence algorithm aggravates the burden of limited memory. Based on this, this study designs a multi-strategy population‐free particle swarm optimization (mpfPSO) algorithm under the gamma distribution in a fixed sample domain. The small-sample probability model is used to replace the sample population. It no longer uses the whole particle swarm and does not need to store the position and velocity of each particle. This greatly saves memory. Compared with the traditional normal distribution, the gamma distribution in a fixed sample domain has a heavier tail, that is, it has a greater chance to converge to the global optimal solution. The development of this distribution also provides a new sampling way for population-free algorithms. Furthermore, dynamic weight and vector operator are introduced to better carry out multidirectional global exploration. The addition of the Levy flight strategy provides a guarantee for preventing the algorithm from falling into local extremum. Quantitative memory occupation and time complexity analyses provide a more intuitive presentation. Ten groups of simulation experiments fully demonstrated the superiority of the new algorithm from different dimensions, test sets and comparison objects. Therefore, mpfPSO is a successful compensation scheme with limited memory. The six practical engineering problems of three-bar truss design, tension/compression spring design, pressure vessel design, gear train design, welded beam design and speed reducer design have further proved it.}
}
@article{CHEN2026114764,
title = {Frequency-adaptive decomposition with KAN for medium-to-long-term wind power forecasting},
journal = {Applied Soft Computing},
volume = {193},
pages = {114764},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114764},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002127},
author = {Yan Chen and Wendong Wang and Hong Wu},
keywords = {Wind power forecasting, FAD-KAN, Frequency-adaptive decomposition, Kolmogorov–Arnold Network (KAN);},
abstract = {Accurate mid- to long-term wind power forecasting remains challenging due to the inherent non-stationarity of wind generation time series. This paper proposes a novel prediction framework that, for the first time, integrates Frequency-Adaptive Decomposition (FAD) with Kolmogorov–Arnold Networks (KAN) to effectively handle non-stationary wind power sequences. The method first applies Fourier transform to identify dominant non-stationary frequencies and maps the signal into stationary and non-stationary components via frequency–time domain decomposition. These components are then modeled independently using a customized KAN module, which adopts a dual-channel representation learning architecture to capture high-order dependencies along both temporal and feature dimensions. Dot-product fusion and residual mechanisms are further introduced to enhance model stability and generalization. The final prediction is obtained by aggregating the outputs of both branches. Experimental evaluations on two real-world wind farm datasets from Guangxi, China—across forecasting horizons of 96, 192, 336, and 720 steps—demonstrate that the proposed model outperforms state-of-the-art baselines. It achieves average reductions of 5–6% in MAE, 17–20% in MSE, and 9–10% in RSE. Moreover, models incorporating FAD show consistent performance gains over their non-decomposed counterparts, confirming the effectiveness of FAD in mitigating non-stationarity and the overall novelty of the proposed framework.}
}
@article{OZTAS2026114840,
title = {A decision-making methodology based on Bayesian BWM and Picture Fuzzy COPRAS for airline company selection},
journal = {Applied Soft Computing},
volume = {193},
pages = {114840},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114840},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002887},
author = {Tayfun Öztaş and Abdullah Özçi̇l and Esra {Aytaç Adalı} and Ayşegül Tuş and Gülin Zeynep Öztaş},
keywords = {Performance Measurement, Bayesian BWM, Picture Fuzzy Number, COPRAS, Logistics, Uncertainty},
abstract = {Through the globalization of the world, the phenomenon of time and space is becoming increasingly blurred. Therefore, the transportation sector is essential in today's business world. Logistics activities play a crucial role in delivering and transporting individuals' needs to destinations. Air transport has a critical share of the transportation sector. Although there are various studies in the field of airline, most of them have not addressed the uncertainty and subjectivity in the decision-making process of passengers. To fill this gap, this study proposes a methodology integrating Bayesian BWM and Picture Fuzzy COPRAS to select the most suitable airline company as a multi-criteria decision-making problem. Through this study, consumer preferences of airline companies operating in the transportation sector are examined. It aims to specify the factors affecting the airline company selection problem and calculate their importance levels. Furthermore, through the weighted criteria, the performances of airline companies are compared. The findings show that price/value, punctuality, and reliability are the most influential criteria in determining passenger preferences. In addition, among the alternatives, the airline company (A1) achieves the highest performance, followed by A2 and A5. Furthermore, comprehensive sensitivity and comparative analyses are conducted to verify the results obtained by the proposed method under varying conditions. Through the sensitivity analysis, the robustness of the findings is confirmed, and comparative analysis demonstrates that Bayesian BWM & Picture Fuzzy COPRAS are compatible with the other approaches. In light of the findings, managerial and practical implications are suggested for decision makers across various domains, emphasizing how the proposed method can assist in data-driven decision-making under uncertainty.}
}
@article{LIU2026114816,
title = {A novel real-time 6-DoF pose estimation and 3D grasping method based on RGB-d images},
journal = {Applied Soft Computing},
volume = {193},
pages = {114816},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114816},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002644},
author = {Zongmin Liu and Lei Qin and Lei Liu and Liang Xu and Wengang Ao and Kai Ren},
keywords = {Service robots, 6-DoF pose estimation, 3D grasping, Lightweight model},
abstract = {With the increasing severity of global population aging, indoor service robots with life-assisting functions are expected to play a crucial role in the future elderly care industry. However, due to the complexity and unpredictability of indoor environments, existing methods based on instance segmentation for planar grasping face significant challenges in effectively handling scenarios involving changes in distance and angle. To address this issue, this study proposes a real-time 6-DoF pose estimation and 3D grasping model based on RGB-D images. The research leverages the Gen6D model as the foundational framework and introduces a Context-Aware Feature Module (CAFM), replacing traditional 3D convolutions with lightweight Depthwise Separable Convolutions (DSC). Additionally, the pose information output by the improved Gen6D model is utilized for 3D grasping. The model is trained and optimized using the LINEMOD and GenMOP datasets, demonstrating its effectiveness. Finally, the model’s superiority is validated through the ADD-0.1 and PREJ-5 evaluation metrics, and its output pose information is applied to real-world robotic arm grasping tasks. Experimental results show that the improved model enhances both detection accuracy and speed while strengthening the robotic arm’s grasping capability.}
}
@article{LIU2026114730,
title = {GloLoFA-FinGuarMo: A dual-perspective feature augmentation framework-based financing guarantee assessment model},
journal = {Applied Soft Computing},
volume = {193},
pages = {114730},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114730},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600178X},
author = {Jiaming Liu and Fenghao Cui and Chengzhang Li and Shucheng Gong},
keywords = {Financing guarantee assessment, SMEs, Feature augmentation, Global-local information, Machine learning},
abstract = {Small and medium-sized enterprises (SMEs) are credit-rationed because traditional scoring suffers from sparse data and subjective judgment. We propose GloLoFA-FinGuarMo, a dual-perspective feature-augmentation framework that fuses (i) global signals extracted from K-fold model probabilities and (ii) local explanations generated by LIME. The enriched representation is fed to an XGBoost/LightGBM/SVM classifiers. On real guarantee files from Shenzhen and Shantou, the framework achieves AUCs of 0.903 and 0.979, outperforming baselines and delivering interpretable, scalable credit decisions. GloLoFA-FinGuarMo offers financial institutions and regulators a scalable, data-driven tool to make faster, fairer and explainable SME guarantee decisions.}
}
@article{GAO2026114848,
title = {Adaptive multi-view subspace clustering with dynamic prior update},
journal = {Applied Soft Computing},
volume = {193},
pages = {114848},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114848},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002966},
author = {Wenbin Gao and Hua Meng and Zhengchun Zhou and Ming Li and Ruibin Ren},
keywords = {Multi-view subspace clustering, Dynamic prior update, Structure-guided learning, Graph regularization, Structural information fusion},
abstract = {Multi-view subspace clustering (MVSC) integrates high-dimensional data from multiple views to learn a consistent low-dimensional representation for enhanced clustering performance. While existing methods typically extract static structural information from the original space as regularization, such prior information remains insufficiently refined due to high dimensionality and noise. More critically, as subspace learning progresses through iterations, finer-grained structural patterns gradually emerge yet current approaches fail to both capture these evolving relationships and update the initial coarse priors. To address these issues, this paper proposes a method named Adaptive Multi-view Subspace Clustering with Dynamic Prior Update (AMVSC-DPU). AMVSC-DPU introduces mechanisms to extract two types of prior structural information from the original feature space and the learned subspace respectively, and further incorporates a dynamic prior fusion feedback mechanism. This enables dynamic integration of structural priors from both spaces, allowing the model to progressively refine subspace representations through iterative updates. Experiments on multiple real-world multi-view datasets show that AMVSC-DPU achieves an average improvement of over 9.75% compared to the second-best method across various metrics.}
}
@article{LI2026114735,
title = {Deep incomplete multi-view representation learning with doubly relation transfer},
journal = {Applied Soft Computing},
volume = {193},
pages = {114735},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114735},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001833},
author = {Dan Li and Lijie Guo and Jiahao Li and Lin Ding},
keywords = {Incomplete multi-view, Deep autoencoder, Similarity relationship, Graph neural networks, Representation learning},
abstract = {Incomplete multi-view learning is a crucial research challenge due to the wide-spread occurrence of missing instances in multi-view datasets across real-world applications. Although several methods have been proposed to address incomplete multi-view issues, they suffer from the following drawbacks: 1) most methods heavily rely on limited complete paired data but lack sufficient information mining for incomplete instances; 2) they focus mainly on the feature level imputation, and are less processed at the original model input level; 3) they handle partially incomplete scenarios well but struggle to perform effectively in fully incomplete ones. In this paper, we propose a novel method for incomplete multi-view representation learning via doubly cross-view relation transfer, which effectively handles both partially and fully incomplete scenarios. Overall, the proposed method involves primary and further cross-view relation transfer processes, respectively. Firstly, based on the consistency between views, we transfer the known relationships of available view instances to the missing instances in another view and make primary inferences. This attempts to mitigate the impact of missing information at the original model input level. Then, in the further relation transfer process, we use the adjusted view instances and similarity relationships to construct a multi-view graph network that simultaneously learns the intra-view representations of both missing and complete instances, as well as the final multi-view representation, thereby mitigating the impact of missing information at the representation level. It is important to note that both relation transfer processes do not rely on any complete paired data information, except for the final multi-view representation acquisition. Comprehensive experiments on various real-world datasets demonstrate the effectiveness of the proposed method in handling both partially and fully incomplete scenarios.}
}
@article{GAO2026114796,
title = {Weighted multi-output randomized neural networks with a feature memory pool for electroencephalogram signal classification},
journal = {Applied Soft Computing},
volume = {193},
pages = {114796},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114796},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002449},
author = {Ruobin Gao and Rongqing Han and Heng Dong and Ponnuthurai Nagaratnam Suganthan and Yang Yu},
keywords = {Multiple output layers, Randomized neural networks, Deep neural networks, Time series analysis},
abstract = {Neural networks with a single output often suffer from limited robustness and consistency in decoding EEG signals across various subjects. In contrast, deep neural networks with multiple outputs—preserving hierarchical feature structures and promoting diversity in predictions—offer a promising alternative. To this end, this article proposes a novel multi-output randomized neural network (MORNN) for cross-subject motor imagery electroencephalogram (MI-EEG) classification. When an equal-contribution scheme is adopted, a few poor-performing output layers may dominate the final prediction and degrade overall performance. To address this issue, we introduce a dynamic weighting mechanism that suppresses inferior outputs by evaluating the compatibility of each sample with different output layers. In addition, a feature memory pool is employed to retain high-quality features from all hidden layers, thereby enriching the representational capacity of direct links. By incorporating these enhancements, we propose a weighted MORNN with feature memory (WMORNN-FM) for cross-subject EEG classification. Furthermore, a dual-projection domain adaptation method is applied to align feature distributions and mitigate inter-subject variability, thereby enhancing the decoding capability of WMORNN-FM. Experimental results demonstrate that WMORNN-FM surpasses state-of-the-art algorithms by 6%, providing a reliable solution for cross-subject MI-EEG decoding.}
}
@article{YANG2026114804,
title = {Dethate-LLM: Large language model for unified implicit hate detection and explanation},
journal = {Applied Soft Computing},
volume = {193},
pages = {114804},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114804},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002528},
author = {Liang Yang and Shiyi Li and Yingxu Li and Jingjie Zeng and Yuanyuan Sun and Tiejun Xing and Hongfei Lin},
keywords = {Implicit hate, Large language model, Mixture of experts},
abstract = {The spread of hate speech is becoming increasingly rampant on social media, causing serious harm to both society and individuals. Most existing studies focus on detection techniques or explanation tasks, and there are few studies on unified detection and explanation models. In addition, existing large language models perform poorly on implicit hate speech. Therefore, we propose a unified detection and explanation model: Dethate-LLM. Through the LoRA fine-tuning technology, the LLaMA3-8B models were fine-tuned for hate detection, explanation, and minority target group detection tasks. Subsequently, these fine-tuned expert models are integrated with the original LLaMA3-8B into a comprehensive model, and a routing mechanism is designed to enable the model to automatically select and comprehensively utilize the most suitable expert modules. Experimental results demonstrate that Dethate-LLM outperforms state-of-the-art models in detecting implicit hate speech and excels in generating accurate explanations. On the IHC dataset, compared with the ToXCL baseline, Dethate-LLM increased the F1 score of the detection task by 0.05 points and the BERTScore of the interpretation task by 2.31 points. On the SBIC dataset, Dethate-LLM increased the F1 score of the detection task by 0.96 points, the ROUGE-L score of the interpretation task by 2.48 points, and the BERTScore by 0.26 points. These results mark a substantial advancement in the capabilities of large language models in this field.}
}
@article{POURKHOSHGOFTAR2026114832,
title = {MvL-GCN: A multi-view learning graph convolutional network for enhancing credit default risk prediction},
journal = {Applied Soft Computing},
volume = {193},
pages = {114832},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114832},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002802},
author = {Sogand Pourkhoshgoftar and Asadollah Shahbahrami and Nima Esmi},
keywords = {Multi-view, Graph neural network, Credit risk assessment, Loan default prediction, Decision support system},
abstract = {Credit default prediction plays a crucial role for lenders in mitigating risk and supporting informed decision-making by accurately evaluating borrowers’ repayment capacity. This is compounded by the high demand for loans, limited resources, and the diverse characteristics of borrowers, as well as the complexities of large, heterogeneous feature sets and imbalanced data. Despite the importance of borrower relationships, they have received limited attention, leading to the development of graph-based approaches for credit assessment. In this paper, we propose a Multi-view Learning Graph Convolutional Network (MvL-GCN), in which each borrower is represented as a node within a graph constructed from multiple views, such as contextual, historical, and loan-related information. Setting itself apart from existing multi-view approaches, MvL-GCN employs a structured contribution analysis across views and features, quantitatively assessing their individual impact on model outcomes to enhance interpretability in credit risk assessment. By integrating distinct borrower attributes into a unified multi-view framework, MvL-GCN leverages specialized GCN layers to process each view, capturing complex relationships among borrowers, including higher-order and non-linear interactions, alongside mitigating class imbalance through multiple strategies. Experimental results on three real-world datasets, especially Lending Club, with several ablation studies, demonstrate that MvL-GCN outperforms several baselines and state-of-the-art methods. It achieves an area under the receiver operating characteristic curve above 96% and F1-score around 90% on dual views, particularly loan and historical, which outperform both single-view and triple-view settings, underscoring the effectiveness of focused, interpretable view integration and its significant contribution to credit default risk prediction for financial stakeholders.}
}
@article{YUSUF2026114893,
title = {Adaptive GWO-based controller for a 3-DOF lower limb rehabilitation exoskeleton with an innovative length adjustment mechanism},
journal = {Applied Soft Computing},
volume = {193},
pages = {114893},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114893},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003418},
author = {Muhammad Adel Yusuf and Sami El-Ferik and Ali Nasir and Abdul-Wahid A. Saif},
keywords = {Adaptive controller, Adjustable mechanism, MRAC, GWO, LAREX, Lower limb exoskeleton},
abstract = {Neurological disorders such as stroke and spinal cord injury often impair lower-limb motor function and limit daily activities. Lower-limb rehabilitation exoskeletons can support repetitive therapy, yet their practical effectiveness is constrained by (i) joint-axis misalignment caused by inter-subject anthropometric variability and (ii) control performance degradation under nonlinear dynamics, parameter uncertainty, and interaction disturbances. This paper presents LAREX, a 3-DOF lower-limb adjustable rehabilitation exoskeleton incorporating a lead-screw-based length adjustment mechanism that enables continuous, high-resolution limb-length tuning to improve kinematic alignment and wearer fit. It supports initial customization and ongoing adaptation to rehabilitation-related physiological changes (e.g., swelling, altered tone), sustaining comfort and safety without recalibration. In order to address the control challenges, we propose a Grey Wolf Optimization–initialized model-reference adaptive PID controller (GWOiMRAC–PID) with stability-certified gain constraints. The controller adapts online to patient-specific parameters, therapy-stage needs, intra-patient changes (fatigue, recovery), and disturbances. First, Routh–Hurwitz conditions are derived for a joint-level closed-loop characteristic polynomial, and Monte Carlo sampling with convex-hull construction is used to identify a stability-admissible gain region for each joint. Second, GWO is executed once offline to select an initialization within this certified region, reducing initialization-sensitive transients. Third, an online projection step bounds adaptive gain updates to remain within the certified stable set. Clinicians can specify therapeutic intent by tuning the reference-model dynamics—from overdamped to faster profiles—without modifying the adaptation law. Simulation results on the LAREX model demonstrate improved tracking relative to a conventional MRAC–PID baseline, including reduced early-cycle tracking error, while maintaining robustness under anthropometric parameter variations and external joint torque disturbances.}
}
@article{LEE2026114860,
title = {Knowledge distillation for super-resolution reconstruction and segmentation in forward-facing camera images},
journal = {Applied Soft Computing},
volume = {193},
pages = {114860},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114860},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600308X},
author = {Yong Ho Lee and Kyung Bong Ryu and Min Su Jeong and Seong In Jeong and Hyun Woo Song and Kang Ryoung Park},
keywords = {Super-resolution reconstruction, Semantic segmentation, Knowledge distillation, Spatial boundary-aware network, Forward-facing camera images},
abstract = {Semantic segmentation in vehicular vision faces a critical multi-objective challenge: maintaining high accuracy, especially for distant and small objects, while meeting the stringent low computational cost requirements of on-vehicle systems. We focused on improving perception accuracy in simulated adverse conditions where low-resolution (LR) images lead to poor recognition of small or far-distance objects. To address this, we propose knowledge distillation for super-resolution reconstruction and semantic segmentation (KD4SRSS), a novel end-to-end framework combining super-resolution reconstruction (SR) and semantic segmentation. KD4SRSS utilizes the proposed lightweight spatial boundary-aware network (SBANet), which requires only 147,312 parameters, and introduces the boundary-aware knowledge distillation (BAKD) method. BAKD efficiently transfers semantic and crucial boundary knowledge from a robust Teacher network to the Student SBANet, enabling boundary-centric SR at minimal computational expense. Experiments on the Cambridge-driving labeled video database (CamVid) and mini-database of the Cityscapes (MiniCity) datasets confirm KD4SRSS's superior performance: it achieved mean intersection over union (mIoU) scores of 64.42 % and 35.79 % respectively, representing a significant improvement of 3.02 % (CamVid) and 4.74 % (MiniCity) over the state-of-the-art (SOTA) baseline. This performance validates KD4SRSS as an optimal, robust solution for real-time applications in resource-constrained intelligent vehicle systems.}
}
@article{ZHOU2026114768,
title = {Knowledge-guided course recommendation in MOOCs with cross-graph and forgetting-aware cross-attention},
journal = {Applied Soft Computing},
volume = {193},
pages = {114768},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114768},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002164},
author = {Yangtao Zhou and Qingshan Li and Ruoyu Li and Hua Chu and Jianan Li and Feifei Zhu and Xiangming Li and Chengyu Feng and Wanqiang Yang},
keywords = {Course recommendation, Hierarchical knowledge forgetting, Cross-graph encoding, Cross-attention encoding, Knowledge tracing},
abstract = {Course recommendation (CR) plays a pivotal role in the e-learning field, aiming at tailoring course suggestions to learners based on their historical interaction behaviors. Existing CR methods predominantly utilize generic recommendation techniques to infer learners’ preferences from historical interactions. In course learning scenarios, learners’ interaction behaviors are not only preference-driven but also significantly influenced by their knowledge states. However, how to effectively capture the learners’ knowledge states in the CR task remains unexplored, and presents significant challenges due to two critical reasons. First, the knowledge states are intertwined with learners’ preferences, exhibiting mutual collaborative influences. Second, the knowledge states of learners dynamically decay over time due to natural forgetting processes. In this paper, we propose a novel knowledge-guided course recommendation method, named KnowCR, to capture the dynamic knowledge states of learners for enhancing course recommendations. Specifically, we propose a cross-graph collaborative encoding module that integrates the representations of learners’ preferences and knowledge states to exploit their collaborative influences. This module constructs two distinct graphs based on learner-course and learner-exercise interactions, and facilitates information integration via a cross-graph propagation mechanism. Moreover, we devise a forgetting-aware cross-attention encoding module that simulates the decay of short-term and long-term memories to capture the knowledge forgetting properties of learners. This module extracts the dynamic representations of learners by performing sequential encoding with a hierarchical knowledge forgetting mechanism on time-aligned interaction sequences. Extensive experiments on a real-world MOOC dataset demonstrate that our method significantly outperforms the state-of-the-art methods. The implementation codes and datasets are available at https://github.com/KasISET/KnowCR.}
}
@article{ZHANG2026114857,
title = {A method for constructing digital twins of production lines based on an object-oriented distributed model-free adaptive algorithm},
journal = {Applied Soft Computing},
volume = {193},
pages = {114857},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114857},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003054},
author = {Xiaoyu Zhang and Qiang Cheng and Zhiwen Lin and Yueze Zhang and Jun Yan and Tao Zhang and Zhifeng Liu},
keywords = {Intelligent manufacturing, Digital twins, Adaptive information interaction, Digital twin production line system, Distributed model-free adaptive algorithm},
abstract = {With the widespread application of automated production lines in factories, the number and types of production line equipment are numerous, and the operation logic among the equipment is also highly complex. Studying how to accurately construct a digital twin model for automated production lines is of great significance. Currently, most popular digital twin modeling methods are based on sensors and physical models. However, they cannot accurately establish a digital twin model that can describe the production line and the high - quality mapping between the digital twin and the physical model. To solve the above problems, this paper proposes a distributed model - independent adaptive algorithm based on object - oriented thinking. This algorithm improves the accuracy of digital twin modeling and realizes the adaptive interaction of physical - virtual data connection and data dynamic update. Based on the object - oriented concept, digital twins are constructed for each production unit of the automated production line. Using multi-sensor collection and fusion technology, multiple-source manufacturing information of the production line is collected as the attributes of each digital twin. On this basis, the problem of consensus tracking control based on data in a multi-agent system with unknown nonlinear dynamic characteristics is further discussed. By applying dynamic linearization technology to each digital twin in the pseudo - partial derivative framework, a distributed model - independent adaptive control algorithm is proposed. This ensures that all digital twins can accurately follow the desired trajectory, thereby achieving real - time intelligent interaction and data synchronization between the digital twins and the physical model. Finally, the effectiveness and feasibility of this method are verified through a typical forging process. In a typical automated forging production line, under interference conditions, the proposed framework achieves a 44% lower tracking error and a 28% faster response speed than the benchmark scheme based on PID/sensors. Meanwhile, it maintains a stability index of up to 0.98 and reduces the fault condition error rate to 4.8%. The scalability experiment shows that the newly added forging machine can converge to the production rhythm within one production cycle and hardly causes any interference. This indicates strong robustness, scalability, and industrial applicability.}
}
@article{AHEMAD2026114771,
title = {A comprehensive approach employing interval-valued q-rung orthopair fuzzy data for multi-attribute group decision-making},
journal = {Applied Soft Computing},
volume = {193},
pages = {114771},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114771},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600219X},
author = {Faizan Ahemad and Pankaj Gupta and Mukesh Kumar Mehlawat and Raghunathan Krishankumar and Witold Pedrycz},
keywords = {Interval-valued -rung orthopair fuzzy number, Linear programming, Multi-attribute group decision-making, Correlation coefficient, Statistical measures},
abstract = {This study presents a novel hybrid methodology for multi-attribute group decision-making (MAGDM) under uncertainty using interval-valued q-rung orthopair fuzzy sets (IVq-ROFSs). Each alternative is evaluated in terms of interval-valued membership and non-membership degrees with respect to multiple attributes, allowing a richer representation of expert assessments and inherent hesitation. To objectively determine the influence of decision-makers, correlation coefficients are computed based on deviations from upper and lower outlier assessments. A key feature of the approach is an individualized linear programming (LP) model solved separately for each alternative. This enables the optimization of attribute-wise membership and non-membership values to derive the best achievable score for each alternative under its most favorable attribute weighting, an approach analogous to efficiency estimation in data envelopment analysis. To validate the rankings and integrate attribute importance, an enhanced CRITIC-TOPSIS method is employed. CRITIC captures contrast intensity and inter-criteria correlation to derive objective attribute weights, while TOPSIS ranks alternatives based on proximity to ideal solutions. The applicability and robustness of the proposed method are demonstrated through a sustainable supplier selection problem considering economic, environmental, and social dimensions. Sensitivity analysis, comparative evaluation, and Copeland rank fusion further confirm the consistency and reliability of the decision outcomes.}
}
@article{LI2026114865,
title = {Physics informed neural network for inertia effect estimation in tunnel boring machine considering time delay},
journal = {Applied Soft Computing},
volume = {193},
pages = {114865},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114865},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003133},
author = {Yongsheng Li and Jiliang Wang and Limao Zhang and Xin Zhao},
keywords = {Inertia effects, Tunnel boring machine, Physics informed neural network, Electric, hydraulic, and mechanical system},
abstract = {To quantify the inertia effects in Tunnel Boring Machines (TBMs) and mitigate the associated time delay and violent disturbances, this study proposes an inertia estimation method based on the time scale. The theoretical expression of the inertial response time in the Electric-Hydraulic-Mechanical (EHM) systems of a dual-mode TBM is analyzed. A Physics-Informed Neural Network (PINN) that integrates an encoder-decoder architecture with physical laws is utilized to measure the inertial response time. Based on the estimated inertial response time, a Generative Adversarial Imputation Network (GAIN) detection algorithm is designed to assist operators in diagnosing extreme response scenarios. The effectiveness of the proposed approach is validated through the 1471 samples (training/test:1041/400) from a tunnel excavation experiment, covering various geological conditions such as soft and hard rocks. The results demonstrate that: (1) The proposed PINN model accurately predicts the inertial response time, achieving an R² value of 0.988 under steady-state conditions and 0.980 under unsteady-state conditions. (2) The proposed extreme response detection algorithm reliably diagnoses extreme scenarios, achieving an accuracy of 0.9714, a precision of 0.9042, a recall of 0.9255, and an F1-score of 0.9147. A key contribution of this study is the novel estimation approach for inertia effects in EHM systems, which provides theoretical support for the precise and safe control of TBMs.}
}
@article{SHARMA2026114897,
title = {Data-centric single teacher guided knowledge distillation for alleviating sub-optimal supervision in image classification},
journal = {Applied Soft Computing},
volume = {193},
pages = {114897},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114897},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003455},
author = {Karthick Sharma and Bhagya Nathali Silva},
keywords = {Knowledge distillation, Model compression, Confident learning},
abstract = {In recent years, larger, deeper, and more complex deep learning models have emerged as a result of advancements in deep learning techniques. Nevertheless, the computational costs have also increased with the growing model size. Thus, Knowledge Distillation has evolved into a cornerstone in contemporary machine learning, facilitating the transfer of knowledge from cumbersome teacher models to more compact student models. However, student learning is persistently challenged by sub-optimal supervision caused by erroneous and ambiguous teacher predictions. Moreover, the learning process is further deteriorated by the complications introduced through frequently encountered noisy labels in real-world datasets. Existing methods often resort to the ensemble of teachers, introducing additional complexity. We propose a novel, simple, and efficient learning method, Corrective Knowledge Distillation (CKD), to alleviate these drawbacks while relying solely on a single-teacher model. The proposed work employs a two-phase learning paradigm. In the initial phase, the teacher selectively teaches extremely confident knowledge to the student, and in the subsequent phase, the student leverages its own past learning experiences, conditioning its knowledge acquisition on the guidance of the teacher. The proposed method consistently exhibits superior performance in addressing sub-optimal supervision, as evidenced by comprehensive experiments on benchmark datasets such as CIFAR-100, CIFAR-100N-Fine, and ImageNet-1K. Notably, CKD surpasses established baselines, achieving substantial accuracy gains of up to 3.53% in real-world scenarios. Furthermore, CKD exhibits exceptional robustness in highly noisy environments, outperforming ensemble techniques by a significant margin of up to 5.18%. Our code is available at https://github.com/Karthick47v2/ckd.}
}
@article{YUAN2026114784,
title = {Towards explainable image composition assessment: a dataset and a model},
journal = {Applied Soft Computing},
volume = {193},
pages = {114784},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114784},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002322},
author = {Quan Yuan and Yipo Huang and Pengfei Chen and Leida Li},
keywords = {Image composition assessment, Interpretability, Multimodal learning, Aesthetic quality assessment},
abstract = {Explainable Image Composition Assessment (Explainable ICA) provides quantitative scores and qualitative explanations. While recent research on ICA has demonstrated remarkable performance in regressing a scalar score for the overall composition perception, we still need a better understanding of how the image compositions, especially their influencing factors, relate to high-level semantics. However, the requirement for a high-quality explainable ICA dataset limits the broad real-world applications like intelligent photography and content recommendation. This deficiency is primarily because the manual annotation is costly, time-consuming, and struggles to capture the inherent aesthetic subjectivity of composition which heavily relies on expert knowledge. In this work, we take a step toward addressing this challenge through the use of multimodal large language models, and construct a large-scale composition description dataset based on the well-designed prompts in a Chain-of-Thought pattern, named CADB Comments. During its development, we ensured diversity across scenes, composition elements, and levels. This dataset comprises 9497 structured textual annotations. Leveraging this dataset, we propose Multimodal Image Composition Assessment (MICA) to bridge quantitative scoring and qualitative explanation, enabling simultaneous output of scores and descriptions. MICA generates descriptions, embeds composition knowledge into visual encoder, and extracts composition representation using the knowledge-enhanced encoder. A composition level contrastive alignment module strengthens correlation between representation and scores via contrastive learning. Extensive experiments on three datasets demonstrate MICA’s competitive performance in explanation, scoring, and classification. The dataset and code are available at https://github.com/dylanqyuan/MICA.}
}
@article{ZHANG2026114808,
title = {Learning the personalized individual semantics space to support the graph model for conflict resolution: A deck of cards method},
journal = {Applied Soft Computing},
volume = {193},
pages = {114808},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114808},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002565},
author = {Hengjie Zhang and Yifan Ju and Wenwen Zhang and Rong Zhang and Xin Chen},
keywords = {Group decisions and negotiations, Graph model for conflict resolution, Personalized individual semantics, Deck of cards method, Learning},
abstract = {While linguistic information is commonly used to model preferences in the graph model for conflict resolution (GMCR), it is inherently affected by the personalized individual semantics (PIS) issue, which means that the same linguistic information may be interpreted differently by distinct individuals. This paper proposes the concept of Personalized Individual Semantics Space (PISS) to address the PIS issue and enhance the robustness of preference information within the GMCR. The PISS integrates two core components: personalized numerical scales (PNSs) quantifying individual semantics and constraints governing PNS relationships. Firstly, a deck of cards-based method is employed to learn the conflicting party’s PISS, which ask the party to insert cards between adjacent linguistic terms to delineate their semantic differences. Subsequently, a PISS-based decision-making approach is employed to sample PNSs from the PISS. These PNSs are then used to transform the party’s linguistic preferences into an additive preference relation (APR). Through repeated sampling, multiple APRs are generated and subsequently aggregated into a collective APR. Applying the methodology to all conflicting parties yields their respective collective APRs, enabling stability analysis under the Nash, GMR, SMR, and SEQ concepts. Finally, the effectiveness of the proposal is demonstrated through a case study on a water ecological protection conflict in the Huangshui River.}
}
@article{SHAO2026114853,
title = {An adaptive resource management based evolutionary algorithm for large-scale multi-modal multi-objective optimization},
journal = {Applied Soft Computing},
volume = {193},
pages = {114853},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114853},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003017},
author = {Shuai Shao and Ye Tian and Yajie Zhang},
keywords = {Multi-objective optimization, Multi-modal optimization, Evolutionary computation, Large-scale optimization, Dynamic resource allocation},
abstract = {Large-scale multi-modal multi-objective optimization problems (large-scale MMOPs) refer to scenarios where multiple significantly different Pareto optimal solutions exist in a high-dimensional decision space, exhibiting identical or similar performance in the objective space. Existing multi-modal multi-objective evolutionary algorithms (MMEAs) usually employ multiple subpopulations to approximate different Pareto optimal solutions when solving large-scale MMOPs. However, these MMEAs often fail to consider the optimization performance of each subpopulation when allocating computational resources, instead distributing resources equally among all subpopulations. This approach struggles to simultaneously approximate multiple equivalent Pareto optimal solutions in high-dimensional decision spaces, thereby limiting the efficiency and effectiveness of these algorithms. Building on the general idea of computational resource management, this paper develops a resource allocation approach based MMEA that dynamically allocates computational resources to each subpopulation based on its optimization performance. Additionally, the proposed algorithm can determine whether to merge subpopulations to reduce resource wastage or create new subpopulations to explore potential equivalent Pareto optimal solutions, based on the distribution characteristics of all subpopulations. Experimental results demonstrate that the proposed algorithm outperforms state-of-the-art MMEAs in terms of both solutions’ optimality in the objective space and diversity in the decision space.}
}
@article{TANG2026114870,
title = {Lifelong updating of digital twin models for degraded systems using autoencoder and LSTM},
journal = {Applied Soft Computing},
volume = {193},
pages = {114870},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114870},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003182},
author = {Yifan Tang and Mostafa {Rahmani Dehaghani} and G. Gary Wang},
keywords = {Digital twin, System degradation, Lifelong update, Battery degradation, Flight engine degradation},
abstract = {Digital twin (DT) has been applied for monitoring, control, and decision-making of real-world engineering systems, but how to keep a DT valid as the physical system degrades over the lifecycle remains rarely explored. Instead of identifying degradation parameters from expensive aging experiments, this paper proposes a lifelong update method to capture degradation effects directly from system responses via continuously tuning DT models. The core idea is to represent the system degradation as temporal changes of DT model configurations through degradation stages. During the lifelong update process, an autoencoder compresses DT model parameters into latent features, and an LSTM learns the temporal trend of those features to predict latent features for future degradation stages. Based on the predicted latent features, the DT model configuration is reconstructed to predict the system responses affected by degradation. The proposed lifelong update method is evaluated with two real-world engineering datasets, e.g., the battery degradation dataset from Oxford University and the flight engine degradation dataset from NASA. Results demonstrate that the proposed update method successfully captures the degradation effects on system responses during the lifecycle. The one-tailed t-tests confirm that the proposed method statistically outperforms the conventional fine-tuning method in prediction accuracy and robustness at future unseen stages.}
}
@article{HUANG2026114789,
title = {Ethical concerns of generative AI and mitigation strategies: A systematic mapping study},
journal = {Applied Soft Computing},
volume = {193},
pages = {114789},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114789},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002371},
author = {Yutan Huang and Chetan Arora and Wen Cheng Huong and Tanjila Kanij and Anuradha Madugalla and John Grundy},
keywords = {Generative AI, AI ethics, Large language models (LLMs), Systematic mapping study},
abstract = {Generative AI technologies, particularly Large Language Models (LLMs), have transformed numerous domains by enhancing convenience and efficiency in information retrieval, content generation, and decision-making processes. However, deploying LLMs also presents diverse ethical challenges, and their mitigation strategies remain complex and domain-dependent. This paper aims to identify and categorise the key ethical concerns associated with using LLMs, examine existing mitigation strategies, and assess the outstanding challenges in implementing these strategies across various domains. We conducted a systematic mapping study, reviewing 39 studies that discuss ethical concerns and mitigation strategies related to LLMs. We analysed these ethical concerns using five ethical dimensions we extracted from various existing guidelines and frameworks, along with an analysis of mitigation strategies and implementation challenges. Our findings reveal that ethical concerns in LLMs are multi-dimensional and context-dependent. While proposed mitigation strategies address some of these concerns, significant challenges still remain. Our results highlight that ethical issues often hinder the practical implementation of mitigation strategies, particularly in high-stakes areas such as healthcare and public governance. Existing frameworks are often inflexible, failing to accommodate evolving societal expectations and diverse contexts.}
}
@article{YILMAZ2026114844,
title = {Neural circuit policy and hybrid deep learning models for enhanced meteorological drought forecasting performance},
journal = {Applied Soft Computing},
volume = {193},
pages = {114844},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114844},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002929},
author = {Mustafa Utku Yilmaz and Talha Burak Alakus},
keywords = {Deep learning, Drought forecasting, Hybrid models, Machine learning, Neural circuit policy},
abstract = {Drought poses significant risks to communities, agriculture, and water systems, making accurate forecasting critical for sustainable water management. The Standardized Precipitation Index (SPI) is widely recognized as a key indicator of meteorological drought, yet its forecasting remains challenging due to the inherent complexities of drought. Recent advancements in artificial intelligence, particularly Machine Learning (ML) and Deep Learning (DL) techniques, have shown promise in improving drought forecasting. This study introduces the Neural Circuit Policy (NCP), a novel DL model for forecasting SPI at 3-, 6-, 9-, and 12-month time scales. Evaluated through a case study in a drought-prone basin in Türkiye, the NCP model is compared with Random Forest (RF) and eXtreme Gradient Boosting (XGB) as ML models, Long Short-Term Memory (LSTM) as a DL model, and a hybrid model of a Convolutional Neural Network (CNN) and LSTM. The study also investigates the potential for improving drought forecasting accuracy through hybrid models that integrate NCP with RF, XGB, CNN, and LSTM. In addition, the models’ accuracy in classifying drought categories is analyzed as a complementary measure of performance. The results demonstrate that NCP achieves high forecasting performance across all SPI time scales (KGE > 0.92, NSE > 0.93, RMSE < 0.23, MAE < 0.15, R2 > 0.94). The Borda Count confirms that NCP consistently ranks higher than individual models. Moreover, NCP-based hybrids, particularly LSTM-NCP, achieve superior drought category classification (weighted F1 > 0.89). These findings highlight the strong capability of NCP and its hybrid models for enhanced SPI-based meteorological drought forecasting.}
}