@article{GAO2026114884,
title = {Attentive view fusion and adversarial geometric training for 3D model classification},
journal = {Applied Soft Computing},
volume = {193},
pages = {114884},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114884},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003327},
author = {Xueyao Gao and Yali Shao and Chunxiang Zhang and Yongzeng Xue},
keywords = {3D model classification, Multi-view learning, Geometric feature fusion, Adversarial robustness, Selective attention mechanism},
abstract = {As a crucial task in artificial intelligence, 3D model classification often suffers from an over-reliance on visual features that neglect intrinsic geometric information and creates vulnerability to adversarial perturbations. To address these challenges, this paper proposes the Selective Attention and Geometric Adversarial Network (SAGA-Net). Firstly, the method generates a set of 2D views using multi-view projections. Secondly, a dual-branch architecture is employed to extract view features using a Swin Transformer and model the shape descriptor sequence using a long short-term memory (LSTM) network to capture geometric information. Thirdly, a two-stage selective attention mechanism is used to select and fuse discriminative views, and the fused view features are multimodally integrated with global geometric features. Fourthly, an adversarial training strategy on geometric features is incorporated to enhance model robustness. Experimental results on the ModelNet10 dataset demonstrate that SAGA-Net achieves 96.37% accuracy and significantly outperforms baseline methods under adversarial attacks, which verifies its effectiveness in multimodal feature fusion and robust modeling.}
}
@article{GUO2026114850,
title = {Cross-view graph representation learning model with variational information bottleneck for the association prediction of micro RNA-diseases},
journal = {Applied Soft Computing},
volume = {193},
pages = {114850},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114850},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600298X},
author = {Yanbu Guo and Yiyang Xin and Xiaoyu Duan and Dongming Zhou and Jinde Cao},
keywords = {Complex networks, Multiscale information fusion, Representation learning, Neural networks},
abstract = {The accurate association mining between micro ribonucleic acids (micro RNA) and diseases could help understand the complex mechanism of diseases. However, the computational algorithms fail to sufficiently extract discriminative patterns from complex biological networks. In this work, we devised a cross-view graph representation learning model based on graph convolution and hierarchical attention with a variational information bottleneck strategy for the potential association prediction of micro RNA-disease pairs. The proposed model not only captures different view-specific similarities, but also discards the noise attribute and superfluous information of nodes. Specifically, our model first built a heterogeneous biological graph by the micro RNA and disease similarity and known associations. Then, the special graph convolutional module is devised to extract the multi-view local interaction features, and the hierarchical attention layer combines the multi-view representation of nodes to capture higher-order discriminative representations. Moreover, the variational information bottleneck retains relevant information while minimizing the redundant features of micro RNA and diseases to obtain discriminative representations. Finally, the adaptive loss function is designed to optimize the performance. Extensive experimental results demonstrate the superior performance of our model in comparison to state-of-the-art models, and indicate that it is a reliable representation learning and prediction model for the micro RNA-disease associations.}
}
@article{RAMLI2026114892,
title = {Adaptive hybrid PSO-ORB maximum power point tracking for tidal energy conversion systems},
journal = {Applied Soft Computing},
volume = {193},
pages = {114892},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114892},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003406},
author = {Noor Lina Ramli and Mohd Rusllim Mohamed and Wan Ismail Ibrahim and Puiki Leung},
keywords = {Tidal energy conversion system (TECS), Maximum power point tracking (MPPT), Modified optimum relation based (M-ORB), Particle swarm optimization (PSO), Hybrid optimization algorithm},
abstract = {Tidal energy conversion systems (TECS) provide a predictable and sustainable renewable energy source, yet nonlinear turbine characteristics and rapidly varying flow conditions pose significant challenges for effective maximum power point tracking (MPPT). Conventional MPPT techniques often face a trade-off between fast dynamic response and steady-state stability, limiting energy capture and operational reliability. To address this challenge, this study proposes an adaptive hybrid MPPT strategy that integrates Particle Swarm Optimization (PSO) with an Optimum Relation-Based (ORB) method for tidal energy applications. The proposed PSO-ORB MPPT algorithm employs a bidirectional switching mechanism, where PSO is selectively activated during transient conditions for global search, while ORB provides deterministic local refinement under steady-state operation. The approach is evaluated using MATLAB/Simulink-based simulations of a TECS model under dynamic tidal velocity profiles. Key performance metrics, including response time, steady-state oscillation, overshoot, and tracking efficiency, are quantitatively analysed and compared with standalone PSO and modified ORB (M-ORB) methods. Simulation results show that the hybrid PSO-ORB strategy reduces response time by up to 36.81 %, suppresses steady-state oscillations by more than 51 %, and lowers transient overshoot by 16.5 % compared to conventional approaches, while maintaining tracking efficiencies above 99 %. These improvements reduce power fluctuations and component stress, thereby enhancing operational reliability and supporting more efficient and sustainable long-term deployment of TECS.}
}
@article{ZHAO2026114803,
title = {A key node detection method assisted by multi-layer surrogate model and multi-dimensional network features in complex networks},
journal = {Applied Soft Computing},
volume = {193},
pages = {114803},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114803},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002516},
author = {Hong Zhao and Ling Tang and Jia-Rui Li and Zong-Gan Chen},
keywords = {Complex networks, Key node detection, Multi-layer Surrogate Model, Multi-dimensional network features, Multimodal optimization},
abstract = {Identifying key nodes in complex networks is a critical task, as these nodes significantly shape network structure and functionality. Despite the progress of existing methods, two major challenges remain: high computational complexity in large-scale networks and the insufficient adaptability of evaluation models to diverse network structures. To address these challenges, we propose a key node detection method assisted by multi-layer surrogate model and multi-dimensional network features (KND-MSMNF). Our method introduces a multi-layer surrogate model-assisted network performance evaluation (MSNE) strategy, which integrates a Kriging model and the K-nearest neighbors (KNN) model within a differential evolutionary (DE) algorithm. By dynamically employing different surrogate models at various stages of population evolution, MSNE approximates the objective function, thereby circumventing computationally expensive evaluations and significantly improving the efficiency of network assessment and optimization. Furthermore, an adaptive multi-dimensional network feature search (AMNFS) strategy is proposed to evaluate node importance. This AMNFS strategy dynamically adjusts attribute weights and metrics based on network characteristics, leveraging a comprehensive set of features to avoid bias of single evaluation criteria and enhance adaptability. Additionally, a multimodal optimization-driven key node selection (MKNS) strategy assesses node impact from a global perspective by considering both network cost and overall connectivity. By identifying multiple global optima, MKNS improves the robustness of the solution set and provides flexible alternatives for decision-makers. Extensive experiments on diverse network datasets demonstrate that KND-MSMNF significantly outperforms existing methods in terms of key node detection accuracy (i.e., exceeds 96 %) while maintaining strong practicality and adaptability. Moreover, our method can simultaneously identify multiple combinations of key nodes. This enables the rapid localization of corresponding alternative key nodes in the event of a key node failure, thereby effectively mitigating the risk of network functional impairment caused by the failure of a single node.}
}
@article{LI2026114835,
title = {TE-STGCN: Topology enhanced spatio-temporal graph convolutional network for skeleton-based action recognition},
journal = {Applied Soft Computing},
volume = {193},
pages = {114835},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114835},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002838},
author = {Chenshuang Li and Changji Wen and Patrick Sun and Yue Cui and Rundong Hong and Zhuozhen Niu and Leyao Zhang and Yaqi Shi and Shengsheng Wang and Hongbing Chen and Mingqi Li and Hengqiang Su},
keywords = {Human action recognition, Skeleton-based representation, Graph convolutional network, Spatio-temporal feature learning, Topology encoding},
abstract = {Modeling the complex, dynamic relationships in skeleton-based action recognition remains a key challenge. Current Graph Convolutional Networks often face a difficult choice: either use a fixed graph that misses important non-local joint interactions, or learn the graph adaptively and risk losing the skeleton’s essential structure. Our work, TE-STGCN, introduces a framework designed to resolve this fundamental trade-off. We propose three complementary components. First, Dual Dimensional Topology Encoding (DDTE) for preserving both static and dynamic skeletal relationships. Second, a Multi-Range Attention Aggregation (MRA) learns to focus on joint relationships across different spatial distances, capturing both local and long-range dependencies. Finally, our Temporal Dynamic Sequence Pooling (TDSP) moves beyond simple averaging to identify and aggregate the most discriminative moments in an action sequence. On three large-scale benchmarks, TE-STGCN sets a new state of the art, achieving 92.3% on NTU-60 (X-Sub), 88.3% on NTU-120 (X-Sub), and 96.8% on NW-UCLA. The code is available at https://github.com/jlauwcj/TE-STGCN.}
}
@article{SHI2026114851,
title = {Self-adaptive resource allocation based on reinforcement learning for multi-concept multi-objective optimization},
journal = {Applied Soft Computing},
volume = {193},
pages = {114851},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114851},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002991},
author = {Jihui Shi and Lei Wang and Qiaoyong Jiang},
keywords = {MOPs, MCMOP, Reinforcement learning, Advantageous concepts, Environmental selection, MCMOP suite},
abstract = {In practice, many applications involve optimizing multiple conflicting objectives simultaneously, referred to as multi-objective optimization problems (MOPs). In actual optimization design, there may be multiple candidate concepts that can solve the multi-objective optimization problem, which is called the multi-concept multi-objective optimization problem (MCMOP). Although such problems often occur in fields such as engineering and finance, MCMOP is rarely given attention, resulting in a lack of efficient algorithms to solve such problems. Traditional MCMOP algorithms often rely on simplistic resource allocation and environmental selection strategies, which constrain their convergence speed and solution precision. To overcome these limitations, we propose a Self-Adaptive Resource Allocation based on Reinforcement Learning for Multi-Concept Multi-Objective Optimization. It integrates three key strategies: advantageous concept discovery, which guides the exploration of advantageous concepts by balancing the trade-offs between accuracy and evolutionary potential; adaptive evolutionary resource allocation, which dynamically distributes computational resources to advantageous concepts by using RL; and dynamic environmental selection, which leverages RL to retain a higher proportion of individuals representing advantageous concepts. This approach enhances both convergence speed and accuracy, offering a more effective framework for addressing complex MCMOP problems. Evaluation on the MCMOP suite demonstrates that the proposed algorithm significantly outperforms traditional methods on 18 out of 28 problems. Its most notable achievement is a median performance improvement of approximately 70% in optimal cases. This pronounced efficacy is most evident in Type-I and Type-II problems, which are characterized by the presence of dominant concepts, underscoring the algorithm’s advantage in dynamic resource allocation.}
}
