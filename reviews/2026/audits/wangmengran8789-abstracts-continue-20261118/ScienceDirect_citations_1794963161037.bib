@article{IMTIAZ2026115348,
title = {Enhanced TD3 multi-agent reinforcement learning approach for distributed energy resources coordination in active distribution network},
journal = {Applied Soft Computing},
volume = {199},
pages = {115348},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115348},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007969},
author = {Saqif Imtiaz and Lijun Yang and Muhammad Naveed Naz and Hafiz Mudassir Munir and Muhammad Waseem Altaf and Mohammed Saad {Abdelazim Mohammed}},
keywords = {Distributed energy sources (DERs), Active distribution networks (ADNs) enhanced twin delayed deep deterministic policy gradient multi-agent reinforcement learning (MTD3-MARL), State of charge (SOC) management, Power management, Stationary battery energy storage systems (SBESS)},
abstract = {The increasing integration of distributed energy resources (DERs) in active distribution networks (ADNs) presents significant operational challenges, such as voltage regulation, inefficient power management, and insufficient interaction between charging stations and photovoltaic (PV) systems under variable loads. Standard centralized systems and multi-agent reinforcement learning (MARL) approaches like twin delayed deep deterministic policy gradient (TD3-MARL) struggle with agent interdependencies, high-dimensional exploration, and dynamic training problems. This limitation restricts multi-objective tuning in renewable-rich grids, increasing energy loss, battery deterioration, and operational non-compliance. This research enhanced multi-agent framework to strengthen inter-agent coordination, refine exploration techniques, and incorporate progressive learning, thereby improving voltage stability, power management, battery longevity in ADNs. The modified TD3-MARL (MTD3-MARL) uses attention based critic networks for dynamic state feature weighting, adaptive Gaussian noise with episode-decaying exploration, and progressive load complexity for curriculum learning. The framework was tested under seven load scenarios on a modified IEEE 33-bus system with five stationary battery energy storage systems (SBESS) at buses 10, 15, 20, 25, and 30 and three photovoltaic (PV) systems at buses 15, 20, and 30. MTD3-MARL outperforms DDPG, MPC, and standard TD3-MARL, achieving 22.1% mean voltage deviation reduction, 19.2% RMSE voltage decrease, 75.6% battery degradation reduction, 10.1% resilience score improvement, and no constraint violations despite 10.7% increase in average power losses due to multi-objective trade-offs. Ablation studies show synergistic effects: attention mechanism reduces voltage variation by 34.3%, curriculum learning reduces power losses by 35.7%, and adaptive noise partially improves resilience. This research improves power management and voltage control for modern distribution networks.}
}
@article{ZULQARNAIN2026115235,
title = {A novel approach using interval-valued q-rung orthopair fuzzy soft sets and Aczél-Alsina operators: Application in evaluation of artificial intelligence-based computing techniques},
journal = {Applied Soft Computing},
volume = {199},
pages = {115235},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115235},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006836},
author = {Rana Muhammad Zulqarnain and Romualdas Bausys and Hamza Naveed and Imran Siddique and Sohaib Abdal and Tapan Senapati},
keywords = {Interval-valued q-rung orthopair fuzzy soft set, Aczél-Alsina aggregation operators, Multi-attribute group decision-making, AI-based computing techniques},
abstract = {Artificial intelligence (AI)-based computing techniques have significantly advanced technology, fostering economic development, increased productivity, and informed decision-making. These techniques are applied in several fields to increase employment, reduce the need for human involvement, and resolve complex analytical disputes with expert expertise. This research proposes an integrated structure using interval-valued q-rung orthopair fuzzy soft sets (IVq-ROFSS) to adequately address the uncertainty and imprecision that characterize real-life decision-making applications. This structure presents a significantly realistic and evolving approach to displaying unreliable information, accommodating both membership and non-membership levels. To improve the decision-making process, we formulate aggregation operators using Aczél-Alsina t-norms and t-conorms, which involve the formulation of two distinctive operators: the interval-valued q-rung orthopair fuzzy soft Aczél-Alsina weighted average (IVq-ROFSAAWA) and the interval-valued q-rung orthopair fuzzy soft Aczél-Alsina weighted geometric (IVq-ROFSAAWG) operators. Moreover, a novel Aczél-Alsina aggregation-based multi-attribute group decision-making (MAGDM) technique is developed to address the challenging conditions. The numerical results shows that machine learning (0.1160; 0.0867) achieves the highest evaluation score among the considered alternatives, followed by expert systems (0.0589; 0.0820), artificial neural networks (0.0290; 0.0683), reinforcement learning (0.0084; 0.0521), and evolutionary computation (-0.0739; 0.0323), where the first score value is obtained using the IVq-ROFSAAWA operator and the second value corresponds to the IVq-ROFSAAWG operator. The comparisons determine how the algorithm is more precise, beneficial, and productive than existing strategies.}
}
@article{PAMUCAR2026115343,
title = {Sustainable environmental management of post-consumer textile waste flows using a fuzzy trigonometric COBRAC-Frank soft RAFSI model},
journal = {Applied Soft Computing},
volume = {199},
pages = {115343},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115343},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600791X},
author = {Dragan Pamucar and Svetlana Dabic-Miletic and Vladimir Simic and Nebojsa Bacanin and Bandar Almohsen},
keywords = {Sustainability, Fuzzy sets, Textile waste, Waste management, RAFSI},
abstract = {Post-consumer textile waste (PCTW) refers to textile products that owners decide not to use and mainly carelessly abandon. The growing volume of these waste flows, connected with insufficient recycling infrastructure, has made PCTW a critical issue for environmental sustainability, as it significantly contributes to resource depletion, energy consumption, and pollution. This research aims to provide a decision model for categorizing the PCTW flow treatment solutions. The formulated multi-criteria framework improves traditional models, such as ranking of alternatives through functional mapping of criterion sub-intervals into a single interval (RAFSI) and comparisons between ranked criteria (COBRAC). The presented trigonometric COBRAC nonlinear model enables efficient processing of uncertainty in expert preferences and allows consistent definition of the relationships between criteria, regardless of the structure and dimensions of the problem. The integration of fuzzy Frank soft functions into the RAFSI methodology further enables the simulation of different scenarios and risk assessment in a dynamic environment. Additionally, fuzzy Frank's soft function provides flexible nonlinear processing of information and allows observation of mutual relationships between criteria. The application of a nonlinear function for aggregation contributes to a more objective evaluation, especially in situations where the relationships between variables are complex or unequal, ultimately enabling rational decision-making and a better understanding of the problem being solved. The feasibility of the introduced fuzzy trigonometric COBRAC-Frank soft RAFSI model is supported by the real-world case study application in the context of managing PCTW flows. It is concluded that the alternatives "recycling" and "material recovery" represent dominant and stable management strategies. The robustness of fuzzy trigonometric COBRAC-Frank soft RAFSI and the findings are supported by extensive sensitivity analyses. Managerial implications are elaborated on to improve the textile industry's sustainability.}
}
@article{XU2026115336,
title = {Secrecy performance and intelligent prediction for mobile vehicular networks},
journal = {Applied Soft Computing},
volume = {199},
pages = {115336},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115336},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007842},
author = {Lingwei Xu and Zhe Chen and Shubo Cao and T. Aaron Gulliver},
keywords = {Mobile vehicular networks, Secrecy performance analysis, Feature fusion, Intelligent prediction},
abstract = {The development of Internet of Vehicles (IoV) networks has created significant demands on vehicular communications. The complexity of mobile IoV networks makes physical layer security for vehicular communications difficult. Thus, mobile IoV networks urgently need real-time secrecy performance prediction. To achieve this goal, deep learning is employed here for secrecy performance analysis and prediction. The end-to-end link signal-to-noise ratio (SNR) is employed to analyze the secrecy performance from a mathematical perspective and obtain mathematical expressions. These are employed to generate communication datasets for use in secrecy performance prediction. The proposed model integrates an Attention mechanism, BasicBlock residual module, Bottleneck residual module, InvertedBottleneck residual module, and convolutional neural network (CNN) for real-time secrecy performance prediction. According to the characteristics of the model structure, the proposed model is abbreviated as ABBI-CNN. The BasicBlock module enhances fundamental feature learning capability through residual connections, effectively mitigating gradient vanishing issues. The Bottleneck module employs lightweight convolutions to compress feature dimensions, which can significantly reduce computational complexity. The InvertedBottleneck module integrates depthwise separable convolution to enhance the representational capacity for small-scale interference features while maintaining computational efficiency. The ABBI-CNN model can focus on important features in the spatial dimension, which can improve feature expression ability. Employing the ABBI model, the intelligent prediction algorithm can provide better prediction performance than the existing approaches. In particular, the mean squared error (MSE) of the proposed algorithm is 40% better than that of Transformer.}
}
@article{LI2026115397,
title = {Short-term wind power point-interval prediction method based on secondary decomposition ensemble and novel hybrid deep learning network},
journal = {Applied Soft Computing},
volume = {199},
pages = {115397},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115397},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008458},
author = {Xuehan Li and Wei Wang and Lingling Ye and Yihuan Li},
keywords = {Short-term wind power point-interval forecasting, Secondary decomposition ensemble, Permutation entropy, Patch time series Transformer, Improved polar lights optimization algorithm},
abstract = {Accurate wind power forecasting is crucial for power planning, dispatching, and economic benefits. Due to its significant uncertainty and volatility, forecasting remains quite challenging. To this end, this study proposes an innovative approach to wind power prediction that aims to improve the accuracy and robustness of the prediction. Firstly, a quadratic decomposition and reconstruction strategy combining the maximum overlapping discrete wavelet transform, variational mode decomposition, and permutation entropy is proposed to reduce the complexity of the signal. Secondly, a hybrid deep learning network integrating bidirectional gated recurrent unit, temporal convolutional network and patch time series Transformer is developed. This network possesses the bidirectional time-dependent feature extraction ability, the local pattern capture ability, and the global feature modeling ability, thereby enabling the comprehensive extraction of features from wind power data from multiple perspectives. Thirdly, an improved polar lights optimization algorithm is designed to optimize the key hyperparameters of the hybrid network. Finally, the method is evaluated on four seasonal datasets, showing strong performance in point-interval prediction tasks and ablation study, demonstrating its effectiveness and reliability for wind power forecasting.}
}
@article{XU2026115300,
title = {MCF-LLM: MultiModal cross-fusion large language model for traffic flow prediction},
journal = {Applied Soft Computing},
volume = {199},
pages = {115300},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115300},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007489},
author = {Yiwu Xu and Mengchi Liu},
keywords = {Traffic flow prediction, Textual prompts, LLM, Bidirectional cross-attention},
abstract = {Traffic flow prediction is a core component of intelligent transportation systems, with broad practical applications. Recently, multimodal large language models (LLMs) that integrate traffic data and textual prompts have achieved significant progress in this field. However, existing LLM-based multimodal fusion methods mainly employ simple feature concatenation, falling short in modeling the interactions between the two modalities. To address this issue, we propose a novel multimodal cross-fusion large language model framework (MCF-LLM), which consists of a dual-modal encoding module, a cross-fusion module, and a spatio-temporal predictor. Specifically, the dual-modal encoding module extracts fundamental spatio-temporal embeddings from historical traffic data and learns semantically rich prompt embeddings from textual prompts. In the cross-fusion module, we introduce a bidirectional cross-attention mechanism, enabling traffic data and text prompts to serve as queries and key-value pairs for each other, thus achieving true bidirectional information interaction. Furthermore, we introduce a convolutional layer to integrate these interactions and obtain unified cross-modal representations. Subsequently, a feed-forward module with residual connections further fuses spatio-temporal embeddings with cross-modal representations to enhance feature expressiveness. Finally, the spatio-temporal predictor decodes the fused representations using a pre-trained LLM and generates the final traffic flow predictions through a linear projection module. Extensive experimental results demonstrate that MCF-LLM outperforms current state-of-the-art baselines across multiple metrics, validating its effectiveness and superiority.}
}
@article{HUANG2026115389,
title = {DAO: Delay adversarial optimization gains domain-invariant feature of neural networks for automatic sleep staging},
journal = {Applied Soft Computing},
volume = {199},
pages = {115389},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115389},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008379},
author = {Zhan ao Huang and Shaofei Ying and Jiaxin Xie and Xiaojie Li and Xi Wu},
keywords = {Automatic sleep staging, Neural network, Adversarial minority sample, domain-invariant feature, Imbalance learning},
abstract = {Sleep staging is a crucial link between brain function monitoring and regulation. Current deep learning-based methods have unlocked a new paradigm for feature learning in automatic sleep staging modeling. However, most deep learning models still lack robustness to the domain-invariant features of sleep signals. Making them unable to effectively address individual differences and data imbalance in the automatic sleep staging task. In this paper, we propose a delayed adversarial optimization neural network approach that can improve the learning of domain-invariant features in the automatic sleep staging task. Specifically, we introduce the simplex equiangular tight frame (ETF) of neural collapse to depict the domain-invariant features of sleep signals. Constraining the imbalanced staging features to align with the ETF of balanced data learning. Then, to simulate the data property of individual differences among different subjects, we generate adversarial minority samples by perturbing the loss of the staging model. In addition, an ETF joint optimization strategy is established to fine-tune the staging model, achieving the domain-invariant feature gain. We validated the proposed method on MASS and Sleep_EDF datasets under a cross-subject test experiment. The test results showed that our method has significant advantages in addressing the problem of individual differences.}
}
@article{LI2026115304,
title = {SentiNet: Enhancing time-series classification with sensitive attention and dynamic sentinel},
journal = {Applied Soft Computing},
volume = {199},
pages = {115304},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115304},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007520},
author = {Senlin Li and Bo Tang and Xiaowu Deng},
keywords = {Sensitive attention, Sentinel-guided, Spatiotemporal feature},
abstract = {Time-series classification is the cornerstone of safety-critical diagnostics, yet existing deep models often “misjudge” fleeting discriminative patterns under noise and cannot tell users “how reliable this moment is.” To this end, we propose SentiNet, an end-to-end framework that couples “seeing accurately” with “daring to doubt” within a single attention pipeline: (i) a locally-variance–modulated sensitive attention that amplifies statistical anomalies rather than amplitude peaks, letting feeble transients stand out; (ii) multi-scale smoothing that suppresses high-frequency disturbances while preserving temporal consistency; and (iii) a dynamic-sentinel gate that self-calibrates without external supervision—fully trusting current observations when signals are reliable and falling back to internal priors when noise dominates. Experiments show that SentiNet achieves significant accuracy gains over strong baselines; ablation studies verify the synergistic contribution of each component; and interpretability evaluations reveal that attention weights are causally related to synthetically injected anomalous regions. The framework simultaneously improves accuracy, robustness, and reliability, offering a ready-to-deploy solution for high-risk real-time decisions such as industrial fault diagnosis and ECG monitoring.}
}
@article{YESUDHAS2026115365,
title = {Offshore wind speed forecasting using a novel hybrid variational mode decomposition–shifted window long short-term memory model with multivariate atmospheric inputs},
journal = {Applied Soft Computing},
volume = {199},
pages = {115365},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115365},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008136},
author = {Anto Anbarasu Yesudhas and Jae Hoon Jeong and Ju Hyeon Seong},
keywords = {Offshore wind speed forecasting, Variational mode decomposition, Shifted window transformer, Long short-term memory, Transformer-based forecasting},
abstract = {Accurate wind speed forecasting is crucial for increasing wind energy production and maintaining the stability of modern power grids. Offshore wind energy has emerged as a key contributor to global renewable energy sources due to its abundance, relatively low turbulence, and suitability for large-scale deployment. However, offshore wind speed data are highly variable and nonlinear, which complicates forecasting using traditional methods. To overcome these limitations, a novel hybrid deep learning architecture called variational mode decomposition (VMD)-Shifted Window (Swin) Transformer -long short term memory (LSTM) is proposed in this study. To achieve this, VMD was first utilized to decompose the raw wind speed signal into multiple intrinsic mode functions (IMFs), capturing multi-scale temporal patterns. Along with the IMFs, meteorological and oceanographic parameters were used as input features to enhance forecasting accuracy. Subsequently, a Swin Transformer block was employed to learn the local attention patterns and dependencies among the features. The LSTM component then captured temporal correlations across time steps. This combined architecture enabled the model to simultaneously learn the spatial feature relevance and temporal dynamics, thereby enhancing the precision of wind speed predictions. In addition, publicly available offshore wind speed data from Korea were utilized in this study. Finally, the experimental results demonstrate that the proposed VMD–Swin–LSTM model outperforms conventional offshore wind speed forecasting models. This integrated framework enhances accuracy and robustness, providing a comprehensive solution to the inherent challenges of wind-speed forecasting.}
}
@article{WAQAS2026115295,
title = {Machine learning and deep learning in river-basin modeling: A comprehensive review},
journal = {Applied Soft Computing},
volume = {199},
pages = {115295},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115295},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600743X},
author = {Muhammad Waqas and Mohsin Nawaz},
keywords = {Artificial Intelligence, River Basin Management, Physics-Informed Machine Learning, Hydrological Modeling},
abstract = {This study highlights a key question about the capacity of Machine Learning (ML) and Deep Learning (DL) models as standalone, futuristic approaches for river basin modeling. To answer the main research question, a PRISMA-based systematic review framework was used. This study evaluates 133 peer-reviewed studies that used standalone ML/DL models or compared them with conventional hydrological and process-based models to predict various hydrological variables and basin dynamics. Findings synthesis indicates that even though the ML/DL models are better in terms of pattern recognition, data integration, and predictive capacity, especially in non-stationary and non-heterogeneous hydroclimatic conditions, their application alone is not yet as physiologically interpretable and generalized across basins. Overall, the reviewed studies show that hybrid and physics-informed ML/DL models are more effective than traditional empirical models and data-driven models. Nevertheless, there are still difficulties, such as the lack of data, the inequality of computations in different regions, and the uneven assessment of extreme and low-flow states. This study highlights the necessity of hybrid modeling approaches, explainable and physics-guided AI, open data ecosystems, and standardized benchmarking frameworks to enable reliable, transparent, and fair river basin management in changing climatic conditions.}
}
@article{ELKHATIB2026115316,
title = {Multi-step Deep Q-Network with discrete control reformulation for adaptive cruise control in electric vehicles},
journal = {Applied Soft Computing},
volume = {199},
pages = {115316},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115316},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007647},
author = {Mohamed Fawzy El-Khatib and Assem Meghawer and Yasser El-Shaer and Mohamed I. {Abu El-Sebah}},
keywords = {Adaptive Cruise Control, Electric Vehicles, Reinforcement Learning, Deep Q-Network, Double Deep Q-Network, Multi-Scenario Testing},
abstract = {Adaptive Cruise Control (ACC) is a core functionality in intelligent electric vehicles, requiring control strategies that ensure safety, passenger comfort, and robustness under dynamic and uncertain traffic conditions. Conventional ACC methods often struggle to cope with rapidly changing environments, while existing reinforcement learning (RL)–based approaches are frequently limited by slow convergence, training instability, and weak generalization across diverse driving scenarios, hindering their practical deployment. To address these challenges, this paper proposes a reinforcement learning–based ACC framework built upon a unified discrete throttle–brake action representation and an enhanced Double Deep Q-Network with Multi-Step Returns (Double-MS DQN). By reformulating longitudinal control into a single scalar action, the proposed abstraction simplifies actuation, reduces control oscillations, and enables smooth, human-like driving behavior while retaining compatibility with lightweight and stable DQN-based algorithms. The incorporation of multi-step returns further improves temporal credit assignment, accelerates convergence, and enhances policy stability. In addition, a stochastic lead-vehicle scenario generation mechanism is developed to expose the learning agent to highly diverse and unpredictable traffic behaviors, thereby strengthening robustness and generalization. Extensive simulation results in CARLA demonstrate that the proposed method achieves 73.65%, 71.71%, and 60.75% faster convergence, while reducing training headway errors by 40.62%, 59.43%, and 55.17% compared with standard DQN, Dueling DQN, and Double DQN, respectively. These results confirm that reformulating the RL control structure enables high-performance learning using lightweight and scalable algorithms, leading to safer and smoother adaptive cruise control in practical applications.}
}
@article{MBASSO2026115344,
title = {EABIF for exploration-aware metaheuristic benchmarking and behavior-triggered control (CEC-2025)},
journal = {Applied Soft Computing},
volume = {199},
pages = {115344},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115344},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007921},
author = {Wulfran Fendzi Mbasso and Ambe Harrison and Idriss Dagal and Pradeep Jangir and Zhe Liu and Muhammad Suhail Shaikh and Mohamed Metwally Mahmoud and Saad F. Al-Gahtani and Z.M.S. Elbarbary and Pierre Tiako},
keywords = {Metaheuristic Optimization, Exploration Behavior, Swarm Intelligence, Behavioral Metrics, CEC 2025 Benchmarking, Interpretable Algorithms},
abstract = {Metaheuristics are great at hard optimization, but the exploratory dynamics that make them work well are still not well understood. This paper presents the Exploration-Aware Behavioral Insight Framework (EABIF) for quantifying and analyzing exploration in search processes. EABIF establishes four synergistic metrics—swarm entropy, exploration–exploitation ratio, velocity dispersion, and landscape coverage—and integrates them with visual analytics and a uniform benchmarking process. We test five algorithms (PSO, CPSO, CLPSO, SaDE, and GWO) on CEC-2025 real-parameter functions in a number of separate trials. The results show that there are always connections between early and mid-phase exploration and the quality of the final solution. Algorithms that maintain higher entropy and wider coverage are more robust on multimodal and composition functions. Controlled ablations substantiate the causal function of exploratory processes, whereas non-parametric testing affirm statistical significance. EABIF not only evaluates, but also gives practical advice on how to regulate parameters and combine them in a way that takes behavior into account. The approach enhances interpretable, exploration-optimized metaheuristic design and institutes reporting methods that extend beyond terminal fitness.
Executive summary
Metaheuristic algorithms are currently necessary for solving tough optimization problems in engineering, AI, and applied sciences. There is still a gap in our understanding and measurement of exploration behavior, even if they work well most of the time. This is a major reason why an algorithm might not be able to identify effective answers, especially in search settings that are multimodal or misleading. This study introduces the inaugural Exploration-Aware Behavioral Insight Framework (EABIF), designed to evaluate, illustrate, and contrast the exploratory behavior of metaheuristic algorithms during the optimization process. EABIF is distinct from other evaluation measures because it does not just look at how quickly things come together or how fit they are in the end. It does not do that. Instead, it uses a set of well-defined measures to give behavioral diagnostics, like SE, exploration–exploitation ratio (EER), velocity dispersion index, and LCI. We can learn more about how algorithms search, diversify, and come together by looking at these indications. We tested five distinct algorithms on the CEC 2025 benchmark set of real-parameter optimization problems. These were Standard PSO, Chaotic PSO (CPSO), Comprehensive Learning PSO (CLPSO), Self-Adaptive Differential Evolution (SaDE), and Grey Wolf Optimizer (GWO). The findings indicate significant behavioral discrepancies. For instance, at the beginning stages, CLPSO and SaDE always have higher entropy and exploration indices. This is because they are more robust and better at identifying global optima in complex functions. This study offers not just quantitative confirmation but also:•A new way to look at and improve metaheuristic designs •A framework that can be used with any type of algorithm•A big step toward optimization strategies that are explainable and based on behavior. This approach not only makes metaheuristic processes more transparent; however, it also gives us useful information for creating the next generation of optimization methods that balance exploration and exploitation with accuracy by looking at performance through behavioral indicators.}
}
@article{ZHOU2026115308,
title = {A group-based mean-field deep reinforcement learning for inventory control with supplier selection in decentralized supply chain networks},
journal = {Applied Soft Computing},
volume = {199},
pages = {115308},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115308},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007568},
author = {Qiang Zhou and Yefei Yang and Yu Wang and Jiasheng Li},
keywords = {Supply chain network, Inventory control, Supplier selection, Multi-agent reinforcement learning, Decentralized control},
abstract = {Stochastic inventory management is increasingly recognized as a critical component of modern supply chain networks. However, existing studies predominantly focus on centralized optimization, often overlooking restricted information exchange and incompatible objectives among stakeholders. To address this gap, we investigate a dynamic supplier selection and inventory control problem in multi-product supply chain networks under a non-cooperative and decentralized decision-making paradigm. Each nodal enterprise operates with a fixed lead time and limited capacity, while demand distributions are unknown a priori. We formulate the problem as a group-based mean-field game and propose a novel Group-based Mean-Field Deep Q-Network (GMF-DQN) algorithm. The basic idea is to approximate the average effect of other agents within the same group, thereby facilitating coordination among intra-group agents without eliminating competition across different groups. Experimental results on one synthetic dataset and two real-world datasets show that GMF-DQN achieves superior effectiveness compared with state-of-the-art multi-agent deep reinforcement learning (MADRL) methods and classical base-stock policies, and exhibits enhanced resilience to supply disruptions relative to MADRL. In addition, a 100% deviation from the optimal hyperparameter configurations leads to a reduction of only 29% in average profits, suggesting that reasonable deviations from hyperparameter settings have a limited impact on algorithm performance. Furthermore, sensitivity analysis reveals that capacity constraints play a pivotal role in static supplier selection scenarios and can benefit nodal enterprises across different layers of the supply chain.}
}
@article{KAVALCIYILMAZ2026115297,
title = {BiKAN-ViT: Enhancing vision transformers via spline-based patch embedding and nonlinear token mixing},
journal = {Applied Soft Computing},
volume = {199},
pages = {115297},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115297},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007453},
author = {Esra {Kavalcı Yılmaz} and Kemal Adem and Metin Zontul},
keywords = {Kolmogorov–arnold networks, Vision transformer, Patch embedding, Learnable splines, Nonlinear token mixing, Explainable AI},
abstract = {Visual Transformers (ViTs) effectively capture global contextual relationships through a self-attention mechanism. However, linear patch embedding and MLP-based feedforward networks can limit nonlinear modeling capabilities and increase computational costs. To address these limitations, this work introduces BiKAN-ViT (Bi-level KAN integration: Patch + MLP), a Visual Transformer that integrates Kolmogorov-Arnold Networks (KANs) into both the patch embedding phase and feedforward blocks. By replacing linear projections and fixed activations with learnable spline-based univariate functions, the proposed architecture enables more expressive, locally adaptable, and interpretable feature transformations. Experimental results show that BiKAN-ViT outperforms basic ViTs in terms of classification performance, achieving lower FLOPs and faster training times. Ablation analyses highlight the critical contribution of KAN-based patch embedding. Overall, BiKAN-ViT offers an efficient and explainable alternative to traditional Visual Transformer architectures.}
}
@article{VRBA2026115349,
title = {Feature scaling induced data leakage quantification in machine learning-based voice pathology detection},
journal = {Applied Soft Computing},
volume = {199},
pages = {115349},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115349},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007970},
author = {Jan Vrba and Jakub Steinbach and Tomáš Jirsa and Noriyasu Homma},
keywords = {Data leakage, Voice pathology detection, Voice disorder detection, Machine learning, Feature scaling, Feature preprocessing},
abstract = {Feature scaling is an essential component of machine learning pipelines, yet its improper application can introduce data leakage and lead to biased or irreproducible model evaluation. This study systematically quantifies the impact of scaling-induced data leakage in voice pathology detection. Using two publicly available datasets—VOice ICar fEDerico II (VOICED) and Saarbrücken Voice Database (SVD)—we compare performance obtained under correct preprocessing—where scaling transformation parameters are computed only on the training data—against an incorrect procedure in which scaling is applied to the entire dataset prior to splitting. We evaluate five scaling transformations, nine commonly used machine learning models, two validation strategies—train-test split and nested cross-validation (CV)—and both random and stratified data partitioning. Results from 1000 repetitions per configuration show that leakage can either inflate or degrade performance—ranging from −0.14% to 0.14% (p.p.) for SVD, and from −8.3% to 7.8% (p.p.) for VOICED—with model sensitivity varying across datasets, scaling methods, algorithms, and validation designs. The k-nearest neighbors (KNN) classifier with MinMax scaling on VOICED exhibits the largest mean positive shift in performance by 0.9% (p.p.) on average, while nested CV shows reduced but still non-negligible susceptibility to leakage. These findings demonstrate that even subtle preprocessing errors can meaningfully distort empirical conclusions in voice pathology research and underscore the need for transparent, leakage-free preprocessing pipelines.}
}
@article{JIANG2026115358,
title = {A graph contrastive learning framework with multi-view adaptation for robust collaborative filtering},
journal = {Applied Soft Computing},
volume = {199},
pages = {115358},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115358},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008069},
author = {Dongyu Jiang and Miao Liu and Wenbin Chen and Ligang Zheng},
keywords = {Collaborative filtering, Contrastive learning, Multi-view representation, Robust recommendation},
abstract = {Collaborative filtering is a core technique in recommender systems but suffers from sparse user-item interactions and noisy implicit feedback. We propose MAGCL, a Multi-view Adaptive Graph Contrastive Learning framework. It learns robust and informative user and item representations under sparse and noise-prone conditions. MAGCL constructs two complementary graph views: (i) a high-order collaborative graph that models user–user and item–item relations, and (ii) a trust-score-based denoised augmented graph that downweights unreliable interactions. An adaptive fusion strategy integrates information from multiple graph views. In addition, a joint objective combines multi-view contrastive loss, cross-layer contrastive loss, uniformity regularization, and Bayesian Personalized Ranking (BPR). This design improves both alignment and robustness. We evaluate MAGCL on two public datasets: MovieLens-1M, which is relatively dense and reliable, and Alibaba-iFashion, which is highly sparse and noisy. To ensure fair comparison, we adopt the same benchmarks and metrics as those used by nine representative baselines, including (1) matrix factorization or neural collaborative filtering methods (BPRMF, NeuMF), (2) graph collaborative filtering models (NGCF, LightGCN, MultiGCCF), and (3) contrastive or self-supervised recommenders (SGL, SimGCL, AdaMCL, ProtoAU). Under a unified evaluation protocol, MAGCL achieves the best overall performance on the Alibaba-iFashion dataset and competitive results on MovieLens-1M, where the strongest model ProtoAU performs slightly better because it leverages the denser user–item interactions. Specifically, compared with ProtoAU, MAGCL improves Recall@50 by 2.12%, NDCG@50 by 1.72%, and Recall@10 by 1.58% on the highly sparse Alibaba-iFashion dataset. These results demonstrate the particular effectiveness of MAGCL in recommendation scenarios characterized by sparse and noisy implicit feedback.}
}
@article{BEHERA2026115381,
title = {A q-rung orthopair fuzzy Gaussian aggregation-based decision-making framework for sustainable solid waste management},
journal = {Applied Soft Computing},
volume = {199},
pages = {115381},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115381},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600829X},
author = {Madhumita Behera and Amaresh Chandra Panda},
keywords = {-rung orthopair fuzzy sets, Gaussian aggregation operators, Solid waste management, Multi-criteria decision–making, Score function},
abstract = {The evaluation of solid waste management (SWM) alternatives is a complex decision–making problem involving multiple conflicting criteria and significant uncertainty due to hesitant and imprecise expert judgments. Existing fuzzy decision–making approaches often fail to adequately capture nonlinear information interactions and hesitation effects. To address these limitations, this study proposes a novel multi-attribute decision-making framework based on a q-rung orthopair fuzzy Gaussian aggregation approach. The key novelty of the proposed method lies in embedding Gaussian information modeling into the q-rung orthopair fuzzy environment, enabling smooth, nonlinear, and adaptive aggregation of expert opinions. Two new aggregation operators, namely the q-rung orthopair fuzzy Gaussian weighted average (q-ROFGWA) and weighted geometric (q-ROFGWG) operators, are developed and their essential mathematical properties are rigorously established. Additionally, a new q-rung orthopair fuzzy score function is introduced to effectively incorporate hesitation and nonlinearity, providing enhanced discrimination among alternatives. A numerical case study involving ten SWM alternatives demonstrates the practical applicability of the proposed framework, where alternative R1 achieves the highest score (0.8104), indicating the best overall performance, while R10 obtains the lowest score (0.6830). Comparative, sensitivity, and statistical analyses further confirm that the proposed framework offers superior ranking stability, robustness, and decision accuracy compared with existing methods. Overall, the proposed q-rung orthopair fuzzy Gaussian approach provides an effective and reliable decision-support tool for sustainable SWM evaluation under uncertainty.}
}
@article{VILLARREALCERVANTES2026115378,
title = {Unsupervised learning in the bio-inspired online optimization for robust tuning of brushless motor control under dynamic constraints},
journal = {Applied Soft Computing},
volume = {199},
pages = {115378},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115378},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008264},
author = {Miguel Gabriel Villarreal-Cervantes and Alam Gabriel Rojas-López and Alejandro Rodríguez-Molina and Omar Serrano-Pérez and Ramón Silva-Ortigoza and Roberto Castro-Medina},
keywords = {Adaptive tuning, Brushless motor, Differential evolution, Bio-inspired optimization, Meta-heuristics},
abstract = {Adapting the system’s controller parameters using computational intelligence is increasingly common in applications with uncertainties and disturbances. Specifically, bio-inspired optimization has demonstrated significant progress and proven efficacy in auto-tuning controllers for Brushless Direct Current (BLDC) motors. However, the stochastic nature of bio-inspired algorithms in dynamic and uncertain environments often leads to solutions in different regions of the search space, resulting in large variations in controller gains and altering closed-loop system performance. To address the multi-modality of the dynamic optimization problem in controller auto-tuning, this paper proposes incorporating an unsupervised-learning-based convergence-enhancement mechanism into the differential evolution’s variation operator and dynamic constraints. This approach synergistically improves exploration and exploitation in promising regions of the search space, yielding more efficient and reliable solutions for controller tuning and improved closed-loop performance. The proposed method, called the Adaptive Method for Controller Tuning based on Promising Regions (AMCT-PR), is applied to the Proportional-Integral (PI) controller of the BLDC motor. AMCT-PR also includes a way to handle load perturbations by incorporating robust terms into the optimization problem without requiring knowledge of the probability distribution of such perturbations. Comparative statistical results against three state-of-the-art tuning approaches reveal the superiority of the proposed method, achieving improvements of up to 17.33% in closed-loop performance while reducing controller gain variation by up to 37.50%.}
}
@article{REIS2026115392,
title = {Multi-scale deep fusion architecture for brain tumor detection via local-contextual feature integration},
journal = {Applied Soft Computing},
volume = {199},
pages = {115392},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115392},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008409},
author = {Hatice Catal Reis and Veysel Turk},
keywords = {Attention mechanisms, Brain tumor classification, Convolutional neural networks, Medical image analysis, Neuroimaging, Recurrent neural networks},
abstract = {Early detection of brain tumors is crucial for enhancing treatment strategies and improving clinical prognosis. However, current conventional methods limit diagnostic accuracy and slow down diagnostic processes due to subjective interpretations and dependence on experts. Deep learning-based approaches have the potential to enhance diagnostic accuracy and facilitate early diagnosis by mitigating current limitations in automatic learning techniques for feature extraction and modeling processes. In this study, an advanced deep learning model, Multi-Scale Local-Context Fusion Network (MSLCFNet), is proposed for automatic diagnosis of brain tumors within the scope of oncological diseases. The proposed model evaluates local spatial features, global patterns, and long-range contextual relationships holistically through multi-layered representations, enabling effective identification of complex structures of tumor morphology. This architecture has the potential to increase diagnostic consistency and minimize the risk of misdiagnosis by reducing inter-observer variability, especially in cases where limited contrast and unclear boundaries lead to diagnostic uncertainty. The proposed model achieved accuracy rates of 96.51% and 98.17% on two different MRI brain tumor datasets, respectively. Additionally, a hybrid model based on MSLCFNet+ResNet50 was proposed in the study to obtain high-level feature representations for brain tumor diagnosis. The model offers a significant improvement in the diagnosis process by reducing misdiagnosis rates to 98.86% and 99.50% accuracy. The proposed methods make a significant contribution to enhancing diagnostic accuracy in clinical decision support systems, as they enable the efficient processing of complex morphological structures.}
}
@article{WANG2026115347,
title = {YOLO-ADD: A high-precision detection model for small low-altitude drones in complex scenarios},
journal = {Applied Soft Computing},
volume = {199},
pages = {115347},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115347},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007957},
author = {Rijun Wang and Chunhui Yang and Xianglong Teng and Yesheng Chen and Guanghao Zhang and Xiangwei Mou},
keywords = {Low-altitude drone detection, Small object detection, YOLO, DualConv Module, Adaptive Spatial Feature Fusion},
abstract = {The widespread deployment of low-altitude small drones has raised serious concerns regarding airspace security and public safety, making accurate detection in complex scenarios essential. This paper proposes YOLO-ADD, a novel and robust detection model based on YOLO11n. To enhance the precision of drone detection under cluttered and challenging backgrounds, the proposed model integrates three key enhancements: a dual-branch feature extraction module (C3k2-Dual) is designed to expand the receptive field and improve multi-scale feature modeling, a learnable dynamic upsampling module (DySample) for precise feature reconstruction, and an Adaptive Spatial Feature Fusion (ASFF) mechanism in the detection head for consistent multi-scale fusion. Comprehensive experiments on the Det-Fly dataset show that YOLO-ADD significantly outperforms the baseline, with improvements of 3.0% in precision, 12.5% in recall, 11.5% in mAP@0.5, and 8.6% in mAP@0.5:0.95. Furthermore, cross-dataset validation on LRDDv2 and DUT Anti-UAV benchmarks, along with qualitative assessment under extreme conditions (e.g., night, fog, occlusion), confirms its strong generalization capability and practical robustness. YOLO-ADD provides an effective and reliable solution for drone detection in complex low-altitude scenarios.}
}
@article{LIU2026115335,
title = {Active suspension control for ambulance stability and ride comfort using evolutionary strategy and deterministic experience tracing},
journal = {Applied Soft Computing},
volume = {199},
pages = {115335},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115335},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007830},
author = {Jia Liu and Ying Meng and Huan Lin and Xiuting He},
keywords = {Deep reinforcement learning, Active suspension control, Secondary injury prevention, Evolution strategy, Ambulance transport},
abstract = {Road-induced vibration and unstable vehicle dynamics during ambulance transport are recognized as key contributing factors to secondary injuries such as elevated intracranial pressure and aggravated trauma in critically ill patients, representing an important challenge in pre-hospital emergency care. To address the limitation of conventional deep reinforcement learning control methods in balancing global exploration and temporal exploitation under complex and uncertain transport scenarios, this study proposes a novel hybrid active suspension control framework ESDET, which integrates Evolution Strategy (ES) and Deterministic Experience Tracing (DET) through a bidirectional coupled optimization architecture that synergizes the population-based global search capability of ES and the multi-step temporal information mining advantage of DET. The algorithm design is oriented to the clinical requirements of emergency medical transport, with the reward function, state space, and action space proactively customized around vibration suppression as the primary control objective. Systematic validation is carried out based on the ISO 8608 standard stochastic road model and a 2-degree-of-freedom ambulance quarter-vehicle dynamics model, supplemented by a 7-DOF full-vehicle validation and targeted non-standard road disturbance simulations. Under Class C Road conditions, ESDET achieves 87.92% and 86.56% reductions in the root mean square and ISO 2631 weighted root mean square of vertical body acceleration relative to the passive suspension system. Compared with Deep Deterministic Policy Gradient (DDPG), Twin Delayed Deep Deterministic Policy Gradient (TD3), Linear Quadratic Regulator (LQR), Model Predictive Control (MPC), and vanilla DET, the algorithm reduces the ISO 2631-weighted acceleration by 60.5%, 39.2%, 62.7%, 63.4%, and 32.7%, respectively. Robustness verification across full-range road grades, speed and load variations, sensor noise interference (including up to 10% data loss probability), stiffness perturbations, and comparisons with mainstream ES-DRL fusion algorithms further demonstrate consistent and stable vibration suppression performance. Preliminary hardware tests indicate compatibility with real-time control requirements of vehicle-mounted embedded platforms. These simulation-based results suggest that ESDET has the potential to reduce transport-induced vibration exposure, with real-vehicle validation identified as the necessary next step towards practical deployment.}
}
@article{LIU2026115396,
title = {A new bi-parametric divergence measure for belief functions with application in smart manufacturing quality inspection},
journal = {Applied Soft Computing},
volume = {199},
pages = {115396},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115396},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008446},
author = {Zhe Liu and Juan Liao and Wulfran Fendzi Mbasso and Laith Abualigah and Mehdi Hosseinzadeh},
keywords = {Multi-source information fusion, Bi-parametric divergence measure, Belief functions theory, Quality inspection},
abstract = {Effectively handling uncertainty is key to reliable decision-making in belief functions theory (BFT). While BFT is a powerful framework to reason with uncertain and imprecise information, the divergence measures within it play a crucial role to comparing the evidences, but often lead in counterintuitive results. In this paper, we propose a new bi-parametric divergence (NBPD) measure for mass functions (MFs), which overcomes the aforementioned issues. The NBPD is rigorously defined in the BFT framework and its basic properties, i.e., non-negativity, non-degeneracy and symmetry are formally proved. The theoretical innovation of the NBPD is that it offers a unified framework, which can degenerate into several belief-based divergence measures, such as the symmetric Tsallis divergence, symmetric Rényi divergence, Kullback-Leibler divergence and Hellinger distance, according to some suitable values of its two parameters. Numerically, we prove that the NBPD can better describe the fine-grained differences between MFs with respect to classical divergence measures. Moreover, we propose a new information fusion method by combining the NBPD with belief entropy, which dynamically weights the evidences according to their credibility and information volume. The validation on a multi-sensor quality inspection system for smart manufacturing demonstrates that the proposed method achieves higher classification confidence and superior decision performance compared with several representative state-of-the-art methods in resolving the conflict information.}
}
@article{LIU2026115351,
title = {Reinforcement learning for strategy-proof reliability-aware redundancy task offloading in UAV-enabled mobile edge computing network},
journal = {Applied Soft Computing},
volume = {199},
pages = {115351},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115351},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007994},
author = {Xi Liu and Jun Liu and Chunyan Zhu},
keywords = {Mobile edge computing, Unmanned aerial vehicles, Reinforcement learning, Reliability-aware, Redundancy},
abstract = {Mobile edge computing offers low-cost and powerful computing services; however, flexible sensing services cannot be provided. Unmanned aerial vehicles (UAVs) offer flexible, multi-directional services, but due to battery limitations, their service costs are relatively high, and service time is short. Therefore, we focus on UAV-enabled mobile edge computing, in which ESs and UAVs jointly provide services to users. Since hardware failures may occur when ESs and UAVs provide services to users, we develop a new redundancy task offloading model. In our model, a task can be offloaded to multiple ESs or UAVs to meet its reliability requirements. We consider a dynamic pricing mechanism based on auctions to provide scalable services. Our objective is to maximize the group efficiency, which is the difference between the value and the cost. We propose a mechanism based on the clock auction to solve the reliability-aware redundancy task offloading problem. To achieve high-quality solutions, we propose a method that combines reinforcement learning with a greedy strategy. We show that the proposed mechanism achieves individual rationality, consumer sovereignty, strategy-proofness, and group strategy-proofness. Furthermore, the approximation ratio of the proposed mechanism is analyzed. The results demonstrate that the proposed mechanism can bring higher group efficiency.}
}
@article{LIU2026115372,
title = {An adaptive embedding personalized speech information model based on contrastive learning for depression level assessment},
journal = {Applied Soft Computing},
volume = {199},
pages = {115372},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115372},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008203},
author = {Zhenyu Liu and Jiaqian Yuan and Yang Wu and Bailin Chen and Luyue Yang and Hanshu Cai and Jiahui Deng and Lin Liu and Yimiao Zhao and Huan Mei and Yanping Bao and Bin Hu},
keywords = {Speech, Personalized information, Depression information, Contrastive learning, Attention mechanism},
abstract = {Speech-based depression detection has become a hot research topic. Personalized information such as personality and speaking style may cause overlap of speech features among individuals with varying depression levels, raising the risk of model misclassification. A potential strategy is to specifically account for the effect of personalized information during modeling to leverage its intrinsic depression cues. Accordingly, we proposed the Adaptive Embedding Personalized Information Model (AEPIM), which comprises three modules: the Personalized Information Extraction Module (PIEM), the Depression Information Extraction Module (DIEM), and the Self-Adaptive Fusion Module (SAFM). PIEM employs contrastive learning to extract personalized information from longitudinal data. DIEM and SAFM are then trained jointly to learn more discriminative depression representations. To validate AEPIM’s effectiveness, we constructed a longitudinal dataset containing two rounds of data, which is rare in this field. Such data are crucial for analyzing personalized information, supporting the establishment of accurate relationships between speech features and depression levels, thereby assisting in individualized depression diagnosis. Experimental results demonstrate that AEPIM outperforms existing methods, reducing RMSE and MAE by at least 13.8% and 13.0% in Round 1, and by 7.5% and 5.2% in Round 2, respectively. Out-of-domain generalization was assessed on two cross-sectional datasets, indicating its effectiveness on external data. These improvements suggest that AEPIM holds significant potential for practical applications, such as long-term monitoring of depression. The code is available at https://github.com/yuanjq2023-stack/AEPIM.}
}
@article{FENG2026115367,
title = {Nucleus-centric joint segmentation and classification via adaptive convolution and cross-stage attention for cervical cytology},
journal = {Applied Soft Computing},
volume = {199},
pages = {115367},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115367},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600815X},
author = {Jianxiong Feng and Huiyan Jiang and Yu Wang and Yizhou Chen and Zhimin Liu},
keywords = {Artificial intelligence, Self-adaptive convolution, Feature enhancement, Multitask learning, Cervical cells},
abstract = {Cervical cancer remains a major cause of morbidity and mortality, particularly in low- and middle-income countries. A major challenge in automated cytology screening is to substantial variation in nuclear appearance without allowing segmentation errors accommodating compromise classification performance. To address this issue, we propose NFCC-Net, a nucleus-centric framework that jointly performs nucleus segmentation and cell classification. NFCC-Net is built upon three key components. The first is a Nucleus Self-Adaptive Convolution (NSAC) module that aggregates multi-path convolutions with different effective receptive fields to capture nuclear variability across scales. The second is a Spatial- and Channel-attention Feature Enhancement (SCFE) block that selectively gates cross-stage information to transfer nucleus localization cues from the segmentation decoder to the classifier while suppressing segmentation-specific noise. The third is a principled multi-task objective that combines homoscedastic uncertainty weighting to adaptively balance task losses with a detached size-guided regularizer to encode a nucleus-centric inductive bias and mitigate negative transfer. Evaluated under a unified protocol on the public DSCC dataset and our in-house HJPD dataset, NFCC-Net achieves state-of-the-art performance, attaining 92.44% accuracy and 98.57% AUC on DSCC while outperforming strong CNN and transformer baselines, and reaching 80.19% accuracy and 96.73% AUC on HJPD, which exhibits greater morphological heterogeneity and finer-grained labels. Ablation studies further confirm the complementary contributions of the three components: NSAC improves scale adaptivity for nucleus-discriminative features, SCFE selectively fuses multi-scale cues while preserving classification as the primary task, and the objective adaptively balances task losses while introducing a weak, detached prior on nucleus size. These results demonstrate that explicitly leveraging nucleus-centric priors within a joint segmentation-classification paradigm yields robust gains for automated cervical cytology screening and offers a practical path toward reliable computer-aided diagnosis.}
}
@article{JI2026115388,
title = {Aquaculture fish counting via joint training of density estimation and multi-scale detection},
journal = {Applied Soft Computing},
volume = {199},
pages = {115388},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115388},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008367},
author = {Ziliang Ji and Cong Lin and Fomekong Fomekong {Rachel Merveille} and Mingxin Hou and Mingxin Liu},
keywords = {Fish counting, Aquaculture, Scale variation, Density map, Multi-scale receptive field},
abstract = {Accurate fish counting is essential for precision aquaculture. However, in fence-based marine ranching, complex open-water backgrounds, body occlusion, and scale variation make this task particularly challenging. In this paper, we propose a joint-training-based multi-scale perception and counting framework (JMPCNet) tailored to aquaculture applications. JMPCNet couples a scale-aware density regressor with an auxiliary detector in a mutually reinforcing manner. The density branch employs a multi-scale receptive field fusion module (MRFFM) to fuse multi-stage backbone features and produce density maps that encode global spatial distribution and scale cues. These density maps are then injected as spatial priors into the SAM-DETR++ encoder to modulate multi-scale features learning, improving discrimination under cluttered backgrounds and heavy occlusion. Meanwhile, instance-level detection supervision regularizes the shared representation, alleviating the ambiguity of density regression when foreground and background are visually similar. Through joint optimization of distribution-level and instance-level objectives, JMPCNet achieves improved counting performance in dense aquaculture environments. Experiments on the IOCfish5K and YoutubeFish-35 datasets demonstrate consistent performance gains across multiple evaluation metrics. On YoutubeFish-35, JMPCNet reduces the mean absolute error (MAE), mean squared error (MSE), and normalized absolute error (NAE) from 44.61, 79.81, and 2.52 to 40.25, 71.56, and 2.36, respectively. On the more challenging IOCfish5K test set, it further decreases these metrics from 17.12, 41.25, and 0.38 to 16.97, 38.71, and 0.36, respectively. Additional experiments on the Fish4Knowledge dataset verify its effectiveness under degraded underwater imaging conditions, while further generalization studies on two high-density crowd-counting datasets suggest its broader applicability to dense counting tasks.}
}
@article{CHEN2026115226,
title = {Surrogate-assisted backtracking search optimization for two-stage hybrid flow shop scheduling},
journal = {Applied Soft Computing},
volume = {199},
pages = {115226},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115226},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006745},
author = {LiangChao Chen and Yan Qiao and KaiZhou Gao and Mohammadhossein Ghahramani and SiWei Zhang and NaiQi Wu},
keywords = {Backtracking search optimization, Scheduling, Surrogate model, Two-stage hybrid flow shop, Extreme gradient boosting},
abstract = {Two-stage scheduling problems frequently arise in practical domains such as manufacturing, logistics, and service systems, where inter-stage coordination is crucial to overall performance. This work investigates a two-stage hybrid flow shop problem (TSHFSP) with non-identical parallel machines at each stage. Each machine’s processing capacity is determined by the number of processing environments it can provide, and each job requires two no-wait operations. Moreover, a sequence-dependent machine setup is needed when switching between different processing environments. The addressed TSHFSP is formulated as a lexicographic optimization model, where the primary objective is to minimize the makespan using a mixed-integer linear programming model, and the secondary objective is to minimize the total job waiting time using a linear programming model. By sequentially solving these two models using CPLEX, an optimal solution can be obtained for small-sized problems. For larger-sized problems, a designed backtracking search optimization algorithm (DBSA) is employed, which is a population-based metaheuristic. However, DBSA requires a large number of evaluations, making it computationally expensive when facing complex problems. To address this issue, a pairwise comparison-based surrogate model using extreme gradient boosting (XGBoost) is proposed, resulting in the development of an online XGBoost-assisted DBSA (OXGB-DBSA). The experimental results demonstrate that DBSA consistently achieves superior performance compared with the competing metaheuristics across all problem scales. Additionally, the OXGB-DBSA preserves solution quality while substantially reducing computational time, achieving approximately 46%–57% time savings on large-scale instances.}
}
@article{SONI2026115323,
title = {Dynamic adaptive large neighborhood search approach for the uncertain multi-objective green vehicle routing problem},
journal = {Applied Soft Computing},
volume = {199},
pages = {115323},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115323},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007714},
author = {Km Soni and Pitam Singh and Shubhankar Kumar},
keywords = {Biomedical waste, Probabilistic Fermatean neutrosophic hesitant set, Multi-objective green vehicle routing problem, Dynamic adaptive large neighborhood search algorithm},
abstract = {This study highlights the importance of effective biomedical waste (BMW) collection in protecting the environment and public health from adverse impacts. It proposes a mathematical model to address the multi-objective green vehicle routing problem (MOGVRP), aiming to optimize the BMW collection process by minimizing travel distance (TD) and fuel consumption (FC). Effectively addressing the MOGVRP model, we have proposed a Dynamic Adaptive Large Neighborhood Search (DALNS) algorithm that dynamically selects and adapts different removal and insertion operators. The proposed DALNS framework utilizes adaptive weighting mechanisms to enhance solution quality iteratively, demonstrating its efficacy through computational experiments executed using Python. Furthermore, this paper presents the probabilistic fermatean neutrosophic hesitant set (PFNHS), an extension of the classic neutrosophic hesitant set, and better represents uncertainty and impurity within a unified framework. In this work, the triangular probabilistic fermatean neutrosophic hesitant number (Tr-PFNHN) represents the per-day BMW availability of each hospital in a case study of Prayagraj. The proposed algorithm has been implemented on both the real-life case study and large-scale datasets, including four benchmark instances from Set M and eighteen instances from Set P. The results demonstrate that the proposed algorithm performs well on both small and large instances, with significantly improved performance on large-scale instances, particularly when the number of nodes exceeds 100.}
}
@article{ZHANG2026115339,
title = {HMTNet: A hierarchical multi-task network for super-resolution image quality assessment},
journal = {Applied Soft Computing},
volume = {199},
pages = {115339},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115339},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007878},
author = {Hui Zhang and Kaibing Zhang and Xing Quan and Xiaoyan Li and Dandan Fan},
keywords = {Contrastive learning, Multi-task learning, Quality-aware feature, Super-resolution image quality assessment (SR-IQA)},
abstract = {Super-resolution (SR) image quality assessment (SR-IQA) plays a crucial role in evaluating the performance and optimizing model parameters of SR algorithms. However, most existing SR-IQA methods typically quantify the degradation of SR images through a single-task regression framework to map visual perceptual features to quality scores. Although effective, these methods exhibit bias when evaluating certain SR images. In this paper, we propose a novel hierarchical multi-task framework, called HMTNet, for no-reference super-resolution image quality assessment (NR-SRIQA), to measure the quality of SR images in a coarse-to-fine manner. The newly proposed HMTNet first employs a Quality Grading Network which integrates a U-Net and contrastive learning, to divide image quality into five grades coarsely, as the quality grading prior knowledge to conduct qualitative evaluation of SR image quality. Then a triple-perspective Shared Feature Extractor Network (SFEN) that integrates texture details, gradient and saliency features, is developed to build a fine mapping from visual perception features to quantitative quality scores guided by the learned quality grading prior knowledge. Under the coarse-to-fine SR-IQA framework, the proposed HMTNet can quantify the degradation of SR images more accurately and comprehensively. Thorough experiments on both QADS and MA datasets indicate that our HMTNet achieves better human visual consistency compared to other state-of-the-art SR-IQA methods.}
}
@article{ALFREDRAJU2026115412,
title = {Metaheuristic algorithms for solving the Italian domination problem in graphs},
journal = {Applied Soft Computing},
volume = {199},
pages = {115412},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115412},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008604},
author = {M {Alfred Raju} and P.Venkata Subba Reddy and Ismael G. Yero},
keywords = {Dominating set, Roman domination number, Italian dominating function, Meta-heuristic algorithm, NP-hard},
abstract = {Protecting territorial properties has been a key duty of nations throughout history, inspiring various defense strategies since ancient times. Modern graph-based defense strategies, such as the Italian domination theory, use nodes as nations and edges as borders to complete the task. For a graph G=(V,E), a function f:V(G)→{0,1,2} is an Italian dominating function (IDF), if for every vertex v∈V(G) with f(v)=0, there exists a neighbor u of v with f(u)=2 or at least two neighbors u1 and u2 such that f(u1)=f(u2)=1. The weight of an IDF is Σu∈V(G)f(u) and the weight of an IDF of the smallest weight is the Italian domination number of G, denoted γI(G). Finding the Italian domination number of G is known as the minimum Italian domination problem (MIDP) which is well known to be an NP-hard problem, and no polynomial-time algorithm is known for solving it. Therefore, we propose five different metaheuristic algorithm-based solutions for the MIDP, which guarantee a near-optimal solution. The proposed algorithms are evaluated on special graphs with known Italian domination numbers, along with random graphs and the Harwell-Boeing graph dataset. Experimental results demonstrate that the proposed algorithms yield near-optimal solutions for the graphs considered. Comparative analysis reveals that all proposed methods outperform the existing genetic algorithm-based solutions, highlighting the efficacy of the newly introduced approaches.}
}
@article{LI2026115331,
title = {MCMH-Net: A multi-scale CNN-Mamba2 hybrid network for low-dose CT denoising},
journal = {Applied Soft Computing},
volume = {199},
pages = {115331},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115331},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007799},
author = {Ye Li and Wei Zhang},
keywords = {Medical image denoising, Mamba2, State-space model, Low-dose CT},
abstract = {Low-Dose Computed Tomography (LDCT) effectively reduces radiation exposure but inevitably introduces noise and artifacts. Current CNN-based denoising methods face limitations in long-range modeling, while Transformer-based methods suffer from high computational complexity. To address these issues, we propose the Multi-Scale CNN-Mamba2 Hybrid Network (MCMH-Net), a novel encoder-decoder architecture that synergistically integrates the local feature prowess of CNNs with the long-range modeling capabilities of Mamba2. Specifically, it utilizes a Content-Aware Fusion Attention (CAFA) module to dynamically integrate a dual-branch gradient-guided encoder, coupled with a Dynamic Cross-scale Serpentine Mamba2 module to capture global dependencies. Extensive experiments were conducted on both in-domain and cross-domain clinical datasets, utilizing comprehensive ablation studies and multi-dimensional physical and visual verifications to rigorously evaluate the model’s robustness from interpretability to structural fidelity. The results demonstrate that MCMH-Net achieves superior performance in noise reduction and texture optimization, specifically excelling in preserving sharp anatomical edges and resisting noise interference compared to state-of-the-art methods. By offering high-fidelity reconstruction with exceptional structural integrity, this study provides a robust and reliable solution for precise clinical diagnosis in low-dose CT imaging.}
}
@article{HIDAYAT2026115352,
title = {Artificial neural networks in neurodevelopmental disorder research: a scientometric and topic modeling review of imaging and biosignal studies},
journal = {Applied Soft Computing},
volume = {199},
pages = {115352},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115352},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008008},
author = {Erwin Yudi Hidayat and Fahri Firdausillah and Ika Novita Dewi and Erika Devi Udayanti and Adhitya Nugraha and Ardytha Luthfiarta and Novianto Nur Hidayat and Aisyatul Karima and Azah Kamilah Muda},
keywords = {Artificial neural networks, Neurodevelopmental disorders, Scientometrics, Topic modeling, BERTopic},
abstract = {Artificial neural networks (ANNs) have gained increasing attention in neuroscience and behavioral computing for modeling complex brain and signal patterns underlying neurodevelopmental disorders (NDDs). This growth has produced a rapidly expanding body of literature across multiple modalities, including MRI, fMRI, EEG, eye-tracking, and gait analysis. Therefore, this review focuses on ANN studies using neuroimaging and biosignal modalities in NDD research. This study presents a scientometric and transformer-based topic modeling (BERTopic) review to quantitatively map and interpret two decades of ANN-NDD research (2004–2024). Using data retrieved from the Web of Science, 658 peer-reviewed publications were analyzed. Scientometric indicators were applied to assess publication and collaboration patterns, citation impact, and source influence, while the topic modeling uncovered latent research themes and their temporal evolution. Seven major topics were identified. MRI- and fMRI-based autism studies dominate the field in terms of volume and citation impact, followed by smaller clusters on ADHD classification, emotion and action recognition, and eye-tracking analysis. EEG- and gait-based approaches have emerged recently and remain less standardized. Overall, the findings indicate exponential growth after 2018, strengthened international collaboration, and a methodological shift from convolutional to graph and attention-based architectures. This study highlights the need for harmonized multimodal datasets, reproducible benchmarks, and interpretable models to enable reliable and transparent deployment of ANN-based systems in neurodevelopmental research and applications.}
}
@article{YOUSAF2026115268,
title = {Agentic MobileViT: A stage-wise progressive transfer learning framework with knowledge stabilization for multi-dataset skin lesion classification},
journal = {Applied Soft Computing},
volume = {199},
pages = {115268},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115268},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007167},
author = {Nazish Yousaf and Javaria Amin and Wasi Haider Butt},
abstract = {Skin cancer has always been a global health concern where early detection and intervention is crucial for active treatment. Skin lesion classification is a foundation of modern dermatology where robust models developed across heterogeneous clinical datasets which still possess challenges in knowledge retention and cross-domain generalization. This paper introduces a novel stage-wise progressive training protocol across heterogeneous datasets rather than strict task-incremental continual learning framework. Our approach uses an innovative MobileViT based hybrid CNN-ViT backbone which symbiotically integrates the local feature extraction with global self-attention to capture both fine-grained and broader contextual cues. The framework improves the state-of-the-art through four key contributions: (i) stage-wise progressive transfer framework that sequentially adapts model parameters across various dermatological datasets; (ii) an agentic memory replay mechanism that adjusts the optimizer dynamically in case of validation stagnation; (iii) the addition of knowledge distillation with transfer learning regularized by replay to achieve representation stabilization via distillation across the training stages; and (iv) computational efficiency analysis representing minimal overhead introduced by the distillation and replay components. The novel feature in the proposed work is its agentic memory replay mechanism which strategically stores a class-balanced subset of samples from prior datasets which ensures that the model retains prior knowledge across training stages while remaining adaptive to new classes. To further enhance the training stability, we introduced a dynamic optimizer switching strategy which wisely adjusts the optimization algorithms and transitions between AdamW and SGD in case of learning stagnation. We rigorously evaluated our model on five heterogeneous skin lesion classification datasets including PH2, HAM10000, ISIC 2019, ISIC 2020, and MILK10k. The model was able to achieve an impressive F1-score of 98.11% and 94.49% on HAM10000 and ISIC 2019 datasets respectively, outperforming existing methods. On clinically focused and challenging ISIC 2020 dataset, the model achieved a high F1-scroe of 99.24% and AUC of 99.99%. This work is the first to provide a comprehensive performance report on newly published MILK10k dataset, demonstrating that AgenticViT is a powerful adaptive and computationally efficient technique for dermatological image analysis through replay-regularized transfer learning and stag-wise knowledge transfer in real world clinical settings.}
}
@article{NASEEM2026115320,
title = {Taking away training data by confidences},
journal = {Applied Soft Computing},
volume = {199},
pages = {115320},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115320},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007684},
author = {Muhammad Luqman Naseem and Chongkai Li and Bang Zhang and Wenjian Luo},
keywords = {Backdoor attack, Data leakage attack, Machine learning, Gray-box attack},
abstract = {As machine learning (ML) becomes increasingly prevalent, data holders often rely on model providers to develop ML models, exposing them to potential security risks where adversaries may leverage malicious training codes to steal private data. Existing attacks can be categorized into white-box attacks which modify model parameters to efficiently steal private data but require extensive access, and black-box attacks which launch attacks with only the input-output pairs of models but suffer from limited effectiveness. To bridge this gap, for the first time, we propose Confidence Memory Attack (CMA), a novel gray-box attack that steals private data without accessing model parameters by encoding private data with the model’s output confidences during training. We evaluate CMA on three datasets, demonstrating its ability to steal grayscale and color images effectively while maintaining model performance. Most importantly, comparison study reveals that CMA maintains attack effectiveness on par with white-box method while possessing superior stealthiness. Our results show that CMA offers a practical balance between attack effectiveness and stealthiness in gray-box scenarios.}
}
@article{SAVELONAS2026115357,
title = {Guiding symbolic regression with fuzzy cognitive maps: a hybrid framework for discovering interpretable, theory-consistent analytical expressions},
journal = {Applied Soft Computing},
volume = {199},
pages = {115357},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115357},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008057},
author = {Michalis A. Savelonas},
keywords = {Symbolic regression, Fuzzy cognitive maps, Interpretability},
abstract = {The interpretability of machine learning predictive models remains a critical factor influencing their adoption in high-stakes domains such as ecology, biomedicine, and economics. As an alternative to ‘black-box’ methods, symbolic regression (SR) offers a ‘glass-box’ approach by discovering explicit analytical expressions. However, when the evolutionary tree search of SR is unguided, it is prone to finding spurious, theoretically inconsistent correlations, particularly in noisy or data-scarce settings. Motivated by this, we introduce a hybrid framework that guides SR with high-level causal domain knowledge, using fuzzy cognitive maps (FCMs). We propose two fusion variants: a post-hoc filtering method and a deep fusion method that integrates FCM guidance directly into the evolutionary tree search by means of a custom fitness function. The latter measures theoretical consistency by comparing the signs of partial derivatives of each candidate expression with the signs of the corresponding causal FCM weights. The efficacy of the proposed FCM-guided SR framework is demonstrated on standard predator-prey dynamics, biomedicine, as well as on macroeconomics. The results obtained show that FCM-guided SR successfully penalizes theoretically inconsistent analytical expressions, whereas in noisy and limited data settings, the deep fusion method outperforms other guided SR methods.}
}
@article{GUDER2026115260,
title = {Attention-enhanced and optimized InceptionV4 architecture for accurate and interpretable diagnosis of eye diseases},
journal = {Applied Soft Computing},
volume = {199},
pages = {115260},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115260},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007088},
author = {Okan Guder and Yasemin Cetin-Kaya and Mahir Kaya},
keywords = {Eye disease, Hyper-parameter optimization, Attention mechanisms, Classification},
abstract = {The manual diagnosis of eye diseases is both a time-consuming and error-prone process. Therefore, deep learning models designed for use in clinical devices equipped with integrated cameras must not only offer high diagnostic accuracy but also feature a computationally efficient architecture. However, medical imaging datasets typically present challenges such as a limited number of labeled examples, high intra-class similarity, and noise; this makes it difficult to learn robust and discriminative features. In this study, we propose an Inception-v4-based model optimized using metaheuristic algorithms. Furthermore, a hybrid attention module was integrated between network blocks to enrich feature representation and enhance learning capacity. Experimental results demonstrate that the proposed model exhibits superior performance compared to both the baseline model and transfer learning-based comparison models. The baseline Inception-v4 model achieved 81.36% accuracy and recall, 81.88% precision, and an F1 score of 81.24% on the multi-class eye dataset, while on the binary classification dataset, it reached 90.91% accuracy. In contrast, the proposed model achieved 96.14% accuracy and recall, 96.16% precision, and an F1 score of 96.11% on the multi-class dataset; on the binary dataset, it achieved 97.27% accuracy. Overall, our approach yielded 14.78 and 6.36 percentage-point improvements, respectively. Furthermore, Grad-CAM visualizations support the interpretability of predictions by demonstrating that the model focuses on clinically meaningful regions. The findings indicate that the proposed approach offers both robust predictive performance and a computationally feasible solution for resource-constrained healthcare applications.}
}
@article{DING2026115385,
title = {A hybrid evolutionary algorithm based on integrated molecular-gradient search for large-scale many-objective optimization},
journal = {Applied Soft Computing},
volume = {199},
pages = {115385},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115385},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008331},
author = {Weichao Ding and Tianyu Zhang and Chunhua Gu and Fei Luo and Wenbo Dong},
keywords = {Conjugate gradient, Molecular collision operator, Evolutionary computation, Large-scale many-objective optimization},
abstract = {Large-scale many-objective optimization problems (LSMOPs) are widely used in practical applications, which need to simultaneously optimize multiple conflicting objectives under hundreds or thousands of decision variables. Existing many-objective evolutionary algorithms (MOEAs) typically address the dimensional curse of LSMOPs by employing techniques such as collaborative evolution, decision variable analysis, search space reduction and operator improvement to decompose large-scale problems, so as to improve algorithm efficiency and performance. However, these approaches often suffer from low computational efficiency due to excessive function evaluations and struggle with intensifying conflicts between convergence and diversity as the number of objectives grows. To tackle the aforementioned challenges, this paper introduces a hybrid large-scale multi-objective evolutionary algorithm that integrates conjugate gradient method with the molecular collisions, with the objective of efficiently solving LSMOPs while preserving the high quality of the solution set. The algorithm adopts a dual-population coevolutionary framework and realizes independent and directed optimization of convergence and diversity through the organic combination of conjugate gradients and molecular collisions. In order to realize complementary advantages between populations, this algorithm employs a restricted mating selection strategy to generate mating parents and utilizes an independent archive to retain promising solutions during the iteration process. Meanwhile, convergence and diversity enhancement strategies are adopted to maintain the archive. Experimental results on a variety of benchmark test problems show that the proposed algorithm is highly competitive in comparison with existing state-of-the-art MOEAs for LSMOPs.}
}
@article{DENG2026115401,
title = {LGNet: Explicit local-global feature modeling for cloud removal},
journal = {Applied Soft Computing},
volume = {199},
pages = {115401},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115401},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008495},
author = {Ye Deng and Zhihao Li and Peng Wang and Weiping Ding and Long Chen and Hangjun Ye and Weilong Wang and Xiaoshuai Hao},
keywords = {Cloud removal, Frequency-domain modeling, Global-local feature fusion, Dual gated convolution, Deep learning},
abstract = {Designing neural network architectures that can effectively extract feature information from images is crucial for achieving high-quality cloud removal. Our primary hypothesis is that successful restoration requires explicitly balancing local details (e.g., textures, edges) and global structures (e.g., land-cover consistency). While existing methods adeptly capture local features using convolutions or window attention, they often struggle to model long-range dependencies efficiently, leading to structural artifacts and inconsistent restorations, especially under large cloud cover. To address this challenge, we first introduce Dual Gated Convolution (DGC), a novel operator that achieves efficient, non-local feature interaction by leveraging Fourier transforms. Unlike static filters, DGC incorporates a dynamic dual-gating mechanism, enabling it to adaptively model global dependencies in both the frequency and spatial domains based on input content. We then design the Local-Global Block (LGBlock), which synergistically combines the local modeling strength of window attention with the global reach of our DGC. This explicit fusion allows our model to simultaneously preserve fine-grained textures while ensuring large-scale structural coherence, effectively resolving the critical trade-off between restoration quality and computational cost. These blocks are integrated into Local-Global Network (LGNet), a hierarchical U-Net-style framework designed to comprehensively model features across multiple scales. Extensive experiments on four public benchmark datasets validate our approach. The results demonstrate that LGNet significantly outperforms existing state-of-the-art methods, achieving a PSNR improvement of up to 0.73 dB on the RICE2 dataset. Notably, LGNet achieves these superior restorations while maintaining high efficiency, utilizing only 5.83 M parameters and 67.0 G FLOPs, which represent less than a quarter of the parameters and half the computational cost of recent leading models.}
}
@article{GUO2026115361,
title = {DuKAN: A dual kolmogorov-arnold network with transformer for ultra-short-term wind power forecasting},
journal = {Applied Soft Computing},
volume = {199},
pages = {115361},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115361},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008094},
author = {Xiaojie Guo and Pingliang Zeng and Xiong Xiong},
keywords = {KAN, DuKAN, Transformer, Time-series forecasting, Wind power forecasting},
abstract = {Accurate ultra-short-term wind power forecasting is crucial for maintaining grid stability and facilitating the integration of renewable energy. This study introduces DuKAN (Dual Kolmogorov-Arnold Network), a novel neural architecture that integrates Kolmogorov-Arnold Networks with transformer mechanisms for wind power prediction. DuKAN presents three key methodological contributions. First, a dual KAN layer is proposed by integrating TaylorKAN for local feature extraction and WaveKAN for multi-scale frequency analysis, enabling effective modeling of nonlinear temporal dependencies. Second, a dual-branch architecture is designed that leverages VMD-decomposed signals at different reconstruction levels: one branch processes smoother representations to capture primary trends, while the other processes detail-rich representations to preserve rapid fluctuations, thereby enhancing robustness against noise from complementary perspectives. Third, the designed dual KAN layer is incorporated into the transformer’s encoder-decoder framework, facilitating long-term dependency modeling through transformer mechanisms. Comprehensive experiments conducted across six real-world wind farms, representing diverse geographical conditions, demonstrate DuKAN’s superior performance. The method consistently outperforms state-of-the-art methods across all evaluation metrics, achieving improvements of up to 15.2% in offshore scenarios based on weighted average MAE compared to TFT. DuKAN maintains high stability across varying input lengths and prediction horizons, making it a robust solution for practical renewable energy forecasting applications.}
}
@article{WANG2026115302,
title = {MSTRFormer: A multi-factor daily runoff forecasting model integrating adaptive graph convolution and linear attention},
journal = {Applied Soft Computing},
volume = {199},
pages = {115302},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115302},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007507},
author = {Wen-chuan Wang and Can-can Shi and Yi-yang Wang and Miao Gu and Zong Li},
keywords = {Daily runoff forecasting, MSTRFormer, STDFB module, Adaptive graph-structure modeling, Multi-factor forcing},
abstract = {To address the challenges of insufficient characterization of cross-variable association structures and the still difficult joint modeling of short- and long-term temporal information in daily runoff prediction driven by multisource hydro-meteorological factors, this study proposes a multifactor daily runoff prediction model, termed MSTRFormer, based on a Spatiotemporal Dynamic Feature Integration Block (STDFB). In this model, a front-end STDFB is introduced as the key feature integration module, in which a Graph Block, an Attention Block, and an MLLA Block are sequentially integrated into a unified structure. Specifically, the Graph Block adopts a single-scale adaptive graph convolution structure to model the associations among hydro-meteorological factors; the Attention Block is used to capture the short-term temporal dependencies of the runoff process; and the MLLA Block enhances the representation of long-term runoff evolution features. Subsequently, the STDFB works collaboratively with the Transformer encoder to jointly model local fluctuations and overall variation trends in runoff sequences. Using the energy-dominated snowmelt mountainous basins of Crystal River and Johnson Creek as study areas, and taking multisource hydro-meteorological factors as inputs, MSTRFormer was systematically compared with LSTM, Transformer, TimesNet, MLLA, MSGNet, HydroGAT, STGormer, and STGTN. The experimental results show that, under the datasets and experimental settings adopted in this study, MSTRFormer achieved relatively favorable overall performance in both basins, with NSEC values of 0.953 and 0.960, respectively, and the lowest RMSE in both basins. Compared with the baseline models, the maximum reduction in RMSE reached 55.29%. Improvements were also observed in KGE and MAE, with the maximum increase in KGE reaching 39.67% and the maximum reduction in MAE reaching 62.13%, indicating that the model exhibited good predictive accuracy and result stability under the current experimental conditions. In addition, marginal kernel density smoothing analysis showed that the validation and test predictions of MSTRFormer were in good agreement with the observed runoff distributions. SHAP post-hoc contribution analysis indicated that sunshine duration exhibited relatively high contributions in both basins, while the contribution rankings of factors such as vapor pressure and snow water equivalent were generally consistent with the existing hydrological understanding under the snowmelt-dominated background of the study areas. These results indicate that, in the current research context, MSTRFormer can effectively characterize nonstationary runoff processes driven by snowmelt lag and multifactor coupling, and provides a spatiotemporally integrated adaptive graph-based modeling approach that performs relatively well for multifactor daily runoff prediction under snowmelt-dominated conditions in the current experimental setting.}
}
@article{AKMAN2026115342,
title = {An integrated machine learning and MCDM approach to evaluating eco-innovation capabilities of manufacturing companies},
journal = {Applied Soft Computing},
volume = {199},
pages = {115342},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115342},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007908},
author = {Gülşen Akman and Ali İhsan Boyacı and Barış Aksu},
keywords = {Eco-innovation capability, Unsupervised learning, Machine learning, MCDM, Manufacturing industry},
abstract = {This study presents a multi criteria decision making (MCDM)-integrated machine learning approach for accurate and reliable clustering of manufacturing firms according to their eco-innovation capabilities. The approach consists of four main phases: data obtaining and preparation, clustering, calculation of performance indices, and performance evaluation of clustering algorithms via MCDM techniques. The required data were collected from manufacturing companies operating in Türkiye using a questionnaire through e-mail and face-to-face interviews. The questionnaire includes 16 measurement variables under three dimensions of eco-innovation capability: product capability, process capability, and organizational capability. For classification of the companies, six clustering algorithms were utilized; K-Means from partitioning-based methods, FCM from fuzzy-based methods, AGNES, SPECTRAL, and BIRCH from hierarchical-based methods, and Gaussian Mixture from distribution-based methods. Subsequently, eight performance indices were calculated to measure the performance of the clustering algorithms. In the last phase of the methodology, three MCDM methods, WASPAS, VIKOR, and TOPSIS, were exploited to determine the best clustering algorithm in a reliable and robust manner according to eight performance indices. At the end of the study, AGNES was revealed as the best clustering algorithm according to all of the MCDM methods, and manufacturing companies were divided into five classes according to their eco-innovation capabilities. The findings of this study provide empirical support for understanding the eco-innovation capabilities of manufacturing firms in Türkiye and form a basis for comparison with companies in other regions. The results also demonstrate the effectiveness of the proposed MCDM-integrated procedure.}
}
@article{SHOKOUHIFAR2026115309,
title = {Real-time metaheuristic-driven machine learning model for UAV-assisted wireless rechargeable sensor networks in smart agriculture},
journal = {Applied Soft Computing},
volume = {199},
pages = {115309},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115309},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600757X},
author = {Mohammad Shokouhifar and Samira Khoshvaght and Seyedali Mirjalili and Aseel Smerat and Abdulaziz {S. Almazyad} and Ali {Wagdy Mohamed}},
keywords = {Smart Agriculture, Wireless Rechargeable Sensor Networks (WRSNs), Unmanned Aerial Vehicle (UAV), Wireless Power Transfer, Grey Wolf Optimizer (GWO), Support Vector Regression (SVR)},
abstract = {Wireless sensor networks enable remote agricultural monitoring by providing real-time decision-making based on the collected data on various environmental parameters. Due to the limited battery life of sensors, ensuring energy-efficient communication is a challenging problem. Despite advancements in energy-efficient data management protocols, they often fail to achieve high-performance solutions while maintaining real-time responsiveness. To address these limitations, this paper introduces two Metaheuristic-driven Machine Learning models for Data Clustering (i.e., MetaML-DC) and UAV Routing (i.e., MetaML-UR), designed for UAV-assisted Wireless Rechargeable Sensor Networks (WRSNs) in smart agriculture. The proposed methodology is divided into offline and online phases. In the offline phase, a metaheuristic algorithm is used to generate a dataset across multiple farms with varying fitness metrics. This dataset is then utilized to train and test the machine-learning models for clustering and routing. In the online phase, the pre-trained models are deployed as adaptive protocols to deliver real-time clustering and routing solutions in new farm scenarios. While the proposed methodology involves offline optimization overhead across diverse farm scenarios, it can provide generalized, highly efficient, and real-time solutions for any new unseen farm environment. The results demonstrate the superior performance of the proposed methodology across various farm conditions, achieving a residual energy rate of 47.92%, a stability rate of 72.38%, and a survival rate of 71.99%, on average for 20 test farms. These findings underscore the effectiveness of the MetaML-DC and MetaML-UR models as robust tools for enhancing real-time agricultural monitoring and management in UAV-WRSN environments.}
}
@article{RAO2026115403,
title = {LLMAGEO: Large language model-assisted generation of evolutionary operators for constrained multiobjective optimization problems},
journal = {Applied Soft Computing},
volume = {199},
pages = {115403},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115403},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008513},
author = {Honghua Rao and Heming Jia},
keywords = {Constrained multiobjective optimization problem, Large language model, Evolutionary operator, Prompt engineering, Pareto front},
abstract = {Traditional evolutionary algorithms often face challenges in adapting to complex constrained multiobjective optimization problems (CMOPs) due to the rigidity of fixed evolutionary operators. To address this limitation, this paper proposes a large language model-assisted generation of evolutionary operators (LLMAGEO). By utilizing feedback from Pareto front updates, the framework guides the large language model (LLM) to generate evolutionary operators that effectively ensure solution feasibility while balancing convergence and diversity. To guarantee generation quality, a systematic six-layer prompt engineering strategy is designed to translate domain knowledge into LLM-comprehensible instructions. Additionally, an operator generation judgment mechanism based on Pareto front variations is constructed to avoid expensive inference for every new solution, significantly reducing computational overhead. Experimental results on the LIRCMOP problem set and the RWMOP real-world problem set demonstrate that LLMAGEO generally achieves lower IGD and higher HV than seven mainstream state-of-the-art algorithms on the tested problems, indicating favorable convergence and solution diversity. Furthermore, the integration of this mechanism into other evolutionary algorithms consistently yields performance improvements, verifying the framework’s universality. Comparative experiments with different LLMs further confirm the effectiveness of the proposed method in complex constrained environments.}
}
@article{KHAN2026115306,
title = {Population versus point-based optimization algorithms for hierarchical convergence to multiple solutions},
journal = {Applied Soft Computing},
volume = {199},
pages = {115306},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115306},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007544},
author = {Ahmer Khan and Kalyanmoy Deb},
keywords = {EMO, IP-BCGA, Point-based, Hierarchical convergence, Gradual path},
abstract = {A population-based optimization algorithm employs a set of points to coordinate its search for better solutions in every iteration, while a point-based algorithm uses a single point for the same purpose. In tasks for finding multiple optimal solutions, such as, in multi-modal optimization problems or in multi-objective optimization problems, point-based algorithms need to be applied many times from different initial points or using different hyperparameter settings to find multiple optima. However, population-based evolutionary algorithms (EAs) exploit their implicit parallel processing characteristic to find and maintain multiple diverse promising solutions in their evolving populations. However, these algorithms are not expected to find multiple solutions in any specific predefined order. Recently, an optimization task – called innovation path (IP) problem – has been brought to attention, in which a hierarchical convergence to a sequence of multiple solutions in a specific order is needed. Only when one optimal solution is found, does the next optimal solution gets defined. Apparently, these problems are most suited to be solved by point-based algorithms, which can be parameterized to focus on finding one optimal solution at a time in a sequential manner. This paper proposes such a point-based approach for solving the IP problem and compares its performance with an updated version of a previously proposed IP-seeking EA. Despite the apparent suitability of the point-based approach, the study, when attempting to solve a number of challenging single-, multi-, and many-criterion IP problems, including engineering design problems, discovers a number of issues with the point-based approach, illustrating an edge of the EA-based IP-seeking algorithm requiring a hierarchical convergence over the point-based approach.}
}
@article{LI2026115395,
title = {Enhancing long-range contextual interactions via frequency-aware directional shifts for medical image segmentation},
journal = {Applied Soft Computing},
volume = {199},
pages = {115395},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115395},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008434},
author = {Guangju Li and Qinghua Huang and Xiao Feng Dong},
keywords = {Adaptive directional shift, Frequency-aware feature decomposition, Shifted multi-layer perceptrons, Medical image segmentation},
abstract = {Transformer-based models provide strong global context modeling for medical image segmentation, but their high computational cost and slow inference limit practical clinical deployment. Convolutional Neural Networks (CNNs) are more efficient, yet their locality restricts the modeling of long-range spatial dependencies that are important for complex anatomical structures. Recently, shift-based Multi-Layer Perceptrons (MLPs) have emerged as efficient alternatives for global feature interaction without self-attention, but most existing methods rely on fixed shift patterns and lack adaptability to spatial and frequency variations commonly observed in medical images, especially around edges and textured regions. To address these limitations, we propose a frequency-aware architectural refinement framework that combines frequency-guided feature decomposition with a soft, adaptive, and data-driven directional shift mechanism within a UNet-style backbone. Instead of using rigid shift rules, the method dynamically adjusts spatial displacements based on the frequency content of features, enabling more flexible interactions that enhance structural consistency and boundary sensitivity. Extensive experiments on four benchmark medical image segmentation datasets show that the proposed framework achieves consistently strong performance compared with representative CNN-, Transformer-, MLP-, and Mamba-based models, while maintaining favorable computational efficiency. Code is available at https://github.com/guangguangLi/FMLP.}
}
@article{ZHAO2026115298,
title = {OHL-CoGNet: a collaborative generation with online hyper-parameter learning for motor imagery EEG augmentation},
journal = {Applied Soft Computing},
volume = {199},
pages = {115298},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115298},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007465},
author = {Zhenxi Zhao and Yingyu Cao and Hongbin Yu and Huixian Yu and Junfen Huang},
keywords = {Brain-computer interface (BCI), Motor imagery (MI), Electroencephalogram augmentation, Online hyper-parameter learning, Asynchronous mask},
abstract = {Motor imagery (MI)-based brain–computer interfaces (BCIs) provide an effective approach to human–machine interaction. The accuracy and stability of BCIs largely depend on the quantity and quality of electroencephalogram (EEG) samples, which has motivated the widespread adoption of data augmentation methods. However, existing EEG augmentation techniques often suffer from insufficient sample detail, limited diversity, and suboptimal compatibility with MI classification models. To address these issues, we propose OHL-CoGNet, a novel framework that integrates two complementary generative techniques specifically designed for the characteristics and limitations of EEG signals: collaborative generation (CoGen) and online hyper-parameter learning-based pseudo-EEG construction (OHL-PC). The CoGen component integrates variational autoencoders (VAEs) and generative adversarial networks (GANs) through uncertainty-weighted fusion, mitigating the detail loss of VAEs and the limited diversity of GANs to generate high-quality pseudo-EEG samples. The OHL-PC component is built on the principle of online hyper-parameter learning. It employs an asynchronous masking strategy to increase the diversity of generated pseudo-EEG samples, while simultaneously optimizing the variable weights of these pseudo-samples and the parameters of the MI classification model, thereby producing customized pseudo-samples for different MI classifiers and ultimately enhancing classification performance. We evaluated OHL-CoGNet on three datasets (BCI Competition IV dataset 2a, BCI Competition IV dataset 2b, and a self-collected MI-GS dataset) using four MI classification models (Shallow ConvNet, Deep ConvNet, MT-MBCNN, and Attention-Inception LSTM). Across all datasets and models, OHL-CoGNet consistently outperformed existing augmentation methods.}
}
@article{ZHANG2026115350,
title = {A double deep Q-network-based memetic algorithm for distributed flexible job shop scheduling integrating after-sales distribution and maintenance},
journal = {Applied Soft Computing},
volume = {199},
pages = {115350},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115350},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007982},
author = {Jingxing Zhang and Kaidan Deng and Shuocheng Gao and Qianwang Deng and Yong Lei and Juan Zhou},
keywords = {Distributed flexible job shop, Distribution, Maintenance, Double deep Q-network, Memetic algorithm},
abstract = {In the context of customized production and the Internet of Things, research on distributed flexible job shop scheduling problems (DFJSP) has been expanded for various industries significantly. Scholars have integrated the three core decisions of factory assignment, machine selection, and operation sequencing with other manufacturing factors or after-sales distribution. However, they completely overlook the equipment maintenance requirement on the customer side. In practical engineering projects, the customer equipment requires parts to be ordered from the manufacturer, delivered using different methods, and maintained by maintenance workers. Inspired by this real-world scenario, this study investigates a DFJSP variant integrating after-sales distribution and maintenance (DFJSP-DM), and formulates a mixed-integer linear programming model to minimize the total manufacturer's cost and the total customers' cost. Additionally, a double deep Q-network (DDQN)-based memetic algorithm (DDQN-MA) is designed to solve DFJSP-DM with a well-tailored five-layer chromosome encoding and an idle-time insertion decoding strategy. To accelerate convergence, six critical-path-based local search operators are developed in DDQN-MA. Furthermore, DDQN adopts the offline training and online selection strategy to efficiently guide the operator choice. Extensive experiments on the newly constructed 40 instances demonstrate superiority of the proposed approach in solving the DFJSP-DM.}
}
@article{USTUN2026115346,
title = {An application of ABC algorithm for 2D ZST map parameter optimization and S-box design in image encryption},
journal = {Applied Soft Computing},
volume = {199},
pages = {115346},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115346},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007945},
author = {Deniz Ustun and Serap Sahinkaya},
keywords = {Artificial bee colony, 2D chaotic map, - design, Image encryption},
abstract = {Designing cryptographically robust substitution boxes (S-boxes) for image encryption requires chaotic maps with superior dynamical complexity, a challenge that remains insufficiently addressed by existing heuristic hybrid systems. To overcome this limitation, we propose a two-dimensional ZST chaotic map, constructed through an asymmetric and ABC-optimized fusion of the Zettle and Styblinski–Tang maps. Building on this framework, the optimized chaotic map is leveraged, in conjunction with the ABC algorithm, to enhance the S-box design. The resulting optimized components are then seamlessly integrated into a unified and robust image encryption scheme, termed 2DZST-IE. Comprehensive dynamical analysis confirms the exceptional chaotic behavior of the optimized 2D ZST map, as evidenced by high Lyapunov exponents exceeding 16 and successful validation using the NIST statistical test suite. The designed S-box exhibits excellent cryptographic performance, achieving high nonlinearity, a near-ideal strict avalanche criterion, and complete elimination of fixed points. Furthermore, the proposed encryption scheme demonstrates strong practical security, attaining NPCR and UACI values close to their theoretical optima, along with high robustness against cropping and noise-based attacks. Overall, this work moves beyond conventional parameter tuning and heuristic coupling, introducing an ABC-driven structural discovery of an asymmetric chaotic architecture. This approach fundamentally improves cryptographic performance and provides a verifiable advance in chaos-based cipher design.}
}
@article{DE2026115233,
title = {A hybrid neighbourhood-based fuzzy NSGA-II–MOPSO algorithm for solving multi-objective optimization problems under uncertainty},
journal = {Applied Soft Computing},
volume = {199},
pages = {115233},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115233},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006812},
author = {Satyajit De},
keywords = {MOOP, MOEA, RRAP, TFN, Fuzzy optimization, NSGA-II, MOPSO},
abstract = {A novel hybrid multi-objective evolutionary algorithm, termed the Hybrid Neighborhood-Based Fuzzy NSGA-II–MOPSO (HNFN-M), is proposed for solving multi-objective optimization problems under uncertainty. The key novelty of the proposed approach lies in the integration of neighborhood-based learning, mutation-based elitism, and TOPSIS-guided membership evaluation within a fuzzy NSGA-II–MOPSO hybrid framework, which jointly enhances convergence stability, diversity preservation, and decision-making quality. Uncertainty in problem parameters is modeled using triangular fuzzy numbers, enabling robust optimization in the presence of imprecise information. The performance of HNFN-M is evaluated on fuzzy multi-objective reliability redundancy allocation problems (MORRAPs) across twenty-one high-dimensional benchmark models, and compared with NSGA-II, MOPSO, MOEA/D, and two recent hybrid algorithms, HN-MC and HN-MP. Performance is assessed using average membership values, hypervolume, inverted generational distance, and mean ideal distance over fifty independent runs. The proposed framework simultaneously maximizes system reliability while minimizing system cost, repair cost, and volume under redundancy and weight constraints. Experimental results demonstrate that HNFN-M consistently achieves faster convergence, improved diversity, and more stable Pareto-optimal solutions than competing methods, confirming its effectiveness as a general multi-objective optimization framework under uncertainty.}
}
@article{CHEN2026115322,
title = {ADSA-Net+: Atopic dermatitis severity assessment from smartphone images based on spatial contextual attention and hard sample oriented contrastive learning},
journal = {Applied Soft Computing},
volume = {199},
pages = {115322},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115322},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007702},
author = {Xurong Chen and Hong Yu and Hui Cui and Changming Sun and Leyi Wei and Ran Su and Xiaoqing Zhao and Xikang Feng and Qiangguo Jin},
keywords = {Atopic dermatitis diagnosis, Spatial contextual attention, Contrastive learning, Automated assessment, Smartphone images},
abstract = {Atopic dermatitis (AD) is a chronic inflammatory skin condition characterized by recurrent itching, erythema, dryness, and eczematous lesions. Automated assessment of AD from smartphone images is critical for cost-effective clinical decision-making but remains challenging due to subtle contrast variations in dermatological features and the wide range of lesion sizes across patients and disease stages. To address these challenges, we propose ADSA-Net+, an advanced model specifically designed for AD analysis using smartphone images. ADSA-Net+ incorporates two types of spatial contextual attention modules: an asymmetric contextual attention (ACA) module and a spatial dimensional attention (SDA) module. The ACA module enhances local texture extraction by combining asymmetric convolutions with self-attention, enabling the model to capture fine-grained details in low-quality images. The SDA module captures global spatial information, allowing the model to adapt to irregular lesion sizes. Additionally, we introduce a hard sample oriented intra- and inter-class contrastive learning (HSCL) mechanism, which focuses on hard samples and outliers, guiding the model to enhance its discriminative ability. Furthermore, we constructed a private dataset of 604 smartphone images of AD patients. Comprehensive experiments on our private dataset demonstrate that ADSA-Net+ achieves state-of-the-art performance in AD severity assessment. Validation on the HAM10000 dataset confirms its strong generalization, outperforming existing methods in both accuracy and clinical applicability.}
}
@article{GONG2026115383,
title = {Learning a generalized belief rule base for compact and interpretable modeling},
journal = {Applied Soft Computing},
volume = {199},
pages = {115383},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115383},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008318},
author = {Aosen Gong and Wei He and Zhichao Feng and Xiaobo Lv and You Cao},
keywords = {Belief rule base, Interpretability, Expert systems, Optimization},
abstract = {Belief Rule Base (BRB) is widely used in fault diagnosis and risk assessment owing to its interpretability. However, BRB often suffers from combinatorial rule explosion when applied to complex systems, which restricts its scalability. To address this issue, this paper proposes a Generalized Belief Rule Base (GRBRB) framework. GRBRB introduces generalized rules that extend antecedent attributes to cover multiple input scenarios with fewer rules, thereby reducing the size of the rule base while preserving interpretability. In addition, a data-driven construction strategy based on the Classification and Regression Tree (CART) is adopted to automatically generate generalized rules without relying on expert knowledge. Finally, an interpretable optimization algorithm is introduced to learn model parameters under explicit interpretability constraints, ensuring both accuracy and transparency. Experimental results on multiple benchmark datasets and engineering applications demonstrate that GRBRB achieves competitive predictive performance with improved scalability and interpretability.}
}
@article{LIU2026115338,
title = {An enhanced weighted averaging algorithm with multi-strategy for global optimization and feature selection},
journal = {Applied Soft Computing},
volume = {199},
pages = {115338},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115338},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007866},
author = {Tianbao Liu and Lingling Yang},
keywords = {Weighted average algorithm, Information-weighted ensemble individual mechanism, Padé approximation, Logarithmic spiral opposition-based learning, Feature selection},
abstract = {Feature selection (FS), as an important data preprocessing technique, aims to reduce data dimensionality while retaining critical information. The Weighted Average Algorithm (WAA) has shown promising potential in solving feature selection and complex optimization problems, but still suffers from limitations such as insufficient solution accuracy and a tendency to fall into local optima. To address these issues, this paper proposes an enhanced Weighted Average Algorithm (MWAA) that integrates three key strategies. First, an Information-weighted ensemble individual mechanism (IEIM) based on the distance and fitness information of multiple individuals is introduced to provide more valuable search directions and enhance population diversity. Second, the Padé approximation strategy (PA) is introduced to fit the local variation trend of the objective function using rational functions, thereby improving population quality and solution accuracy. Finally, an Improved Logarithmic Spiral Opposition-Based Learning strategy (ILsOBL) is designed, which incorporates chaotic mapping and population evolution trend information to help maintain population diversity and increase the probability of escaping local optima. For feature selection tasks, a binary version of the proposed algorithm (BMWAA) is further developed. Experimental results on the CEC2017 benchmark functions and engineering optimization problems demonstrate that MWAA outperforms the compared algorithms in overall performance. In feature selection experiments on 14 UCI datasets, BMWAA achieves the best performance overall, ranking first on average in terms of both accuracy and F1-score. The experimental results validate the strong competitiveness of the proposed algorithm in both global optimization and feature selection tasks.}
}
@article{YANG2026115314,
title = {A survey on unsupervised domain adaptation in medical imaging: Methods, datasets, and future outlook},
journal = {Applied Soft Computing},
volume = {199},
pages = {115314},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115314},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007623},
author = {Hancun Yang and Hengjun Guo and Guanlin Liu and Linkuan Zhou and Junlin Xu and Leyi Wei and Ran Su and Qiangguo Jin},
keywords = {Unsupervised domain adaptation, Medical image analysis, Dataset, Survey},
abstract = {To address the challenge of utilizing data effectively across diverse medical environments, Unsupervised Domain Adaptation (UDA) has emerged as a critical technique for mitigating distributional discrepancies between datasets from different sources or conditions. UDA facilitates the transfer of knowledge learned from a labeled source domain to an unlabeled target domain, thereby improving performance in downstream medical tasks such as disease diagnosis and treatment planning. In recent years, substantial progress has been achieved in medical UDA, leading to the development of various methods, including contrastive learning, generative adversarial networks (GANs), style transfer, pseudo-label filtering, and others. In this survey, we systematically categorize existing medical UDA techniques according to diverse adaptation strategies, and further refine them into detailed subcategories. We examine the specific challenges associated with each category, highlighting their respective strengths and limitations. In addition, we review the datasets commonly used to evaluate domain shift, discussing their characteristics and relevance to specific medical imaging tasks. Finally, we explore open challenges and promising future research directions. By consolidating recent advances and current limitations, this survey aims to provide researchers and practitioners with a comprehensive overview of UDA in medical imaging and to support the development of more robust and generalizable adaptation techniques.}
}
@article{LI2026115375,
title = {A hybrid spherical fuzzy multi-criteria framework for evaluating educational innovations},
journal = {Applied Soft Computing},
volume = {199},
pages = {115375},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115375},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008239},
author = {Quanze Li and Yike Wang},
keywords = {Rural education, Underserved communities, Decision-making, Uncertainty management, Spherical fuzzy sets, Educational innovations},
abstract = {Rural and underserved communities face persistent challenges in expanding access to quality education due to limited resources, infrastructural constraints, and diverse socio-economic conditions. Traditional decision-making approaches often rely solely on subjective judgment or purely quantitative analysis, neglecting uncertainty and multi-dimensional complexity. To address these limitations, this study proposes a hybrid MCDM framework that integrates subjective expertise with objective data for balanced and transparent evaluation. The rank order centroid (ROC) method is employed to capture expert-driven subjective preferences, while the logarithmic percentage change-driven objective weighting (LOPCOW) technique provides data-oriented, unbiased criterion weights. These combined weights are processed using the alternative ranking order method accounting for two-step normalization (AROMAN), a robust approach designed to enhance the accuracy and stability of decision outcomes. This study focuses on combining hybrid weighting and spherical fuzzy modeling to improve robustness, stability, and reliability of decision outcomes under uncertainty. To assess structural robustness, extensive Monte Carlo simulation (10,000 iterations) and sensitivity analyses are conducted. The results demonstrate that classical MCDM methods exhibit moderate dominance stability (approximately 0.57–0.79), whereas the proposed ROC–LOPCOW based AROMAN framework achieves a dominance degree of 0.9950 with 99.50% top-rank consistency. Moreover, the enhanced robustness is obtained without increasing computational burden. A real-world rural education case study demonstrates that the proposed framework delivers more reliable and transparent decision support than traditional models, facilitating improved policy formulation and resource allocation.}
}
@article{CLAVERO2026115376,
title = {CCPPO: Reinforcement learning enhancing confidence for object detection in industrial environments},
journal = {Applied Soft Computing},
volume = {199},
pages = {115376},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115376},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008240},
author = {Carlos Clavero and Miguel A. Patricio and Jesús García and José M. Molina},
keywords = {Warehousing, Object detection, Reinforcement learning, Context information},
abstract = {The proliferation of autonomous systems in industrial and warehousing environments necessitates highly reliable object detection, yet these settings present significant challenges, including severe occlusions, variable illumination, and the prevalence of extremely small objects. Standard deep learning detectors struggle in these high-variance scenes, as their inherent confidence scores are often unreliable, which is unacceptable for safety-critical applications like obstacle avoidance. Furthermore, any viable solution must explicitly satisfy near real-time inference latency constraints. Addressing this gap, this paper introduces Context Confidence Proximal Policy Optimization (CCPPO), a novel reinforcement learning (RL)–based algorithm designed to enhance detector robustness. CCPPO exploits contextual and domain-specific information—reasoning often absent from contemporary neural approaches—to evaluate and refine model predictions. Operating either as a complement to or a replacement for the conventional confidence function, CCPPO leverages RL, analogous to its use in refining Large Language Model outputs, to provide a more assured measure of certainty. We demonstrate the benefits of this approach on the challenging LOCO dataset, showing that CCPPO improves mAP by 3% to 60% across varying confidence thresholds. Crucially, it maintains consistent precision and recall with an inference latency of approximately 15 ms per image on GPU, meeting the stringent real-time requirements of industrial applications.}
}
@article{YE2026115368,
title = {A transferable adversarial attack method guided by dual-domain feature sensitivity},
journal = {Applied Soft Computing},
volume = {199},
pages = {115368},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115368},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008161},
author = {Chuan Ye and Xiaoqing Yang and Yunhan Li and Benlin Lai},
keywords = {Adversarial attack, Feature sensitivity, Multi-scale spectrum, Neighborhood sampling, Momentum update},
abstract = {Deep neural networks are vulnerable to adversarial attacks, where adversarial examples deceive models by adding imperceptible perturbations. To address the limitations of existing attack methods, this paper proposes a transferable adversarial attack method guided by dual-domain feature sensitivity. First, we employ a feature sensitivity analysis mechanism to construct precise spatial domain sensitivity maps, effectively identifying critical regions that influence model decision-making. Next, to comprehensively capture model vulnerabilities, we design a multi-scale spectral guidance strategy that dynamically analyzes model vulnerabilities across different frequency scales, and adaptively adjusts frequency weights according to the attack progress, thereby enhancing gradient contributions in the corresponding frequency domains. Finally, by combining sensitivity-guided neighborhood sampling with an adaptive fusion mechanism, and optimizing gradient direction through Nesterov accelerated momentum, we achieve efficient decision boundary exploration and a balance between local and global search. Extensive experimental results on the ImageNet dataset demonstrate that adversarial examples generated by our method exhibit stronger transferability and higher attack success rates, significantly outperforming existing advanced methods.}
}
@article{C2026115319,
title = {Optimized lightweight CNN for speech recognition with multi-feature spectrograms},
journal = {Applied Soft Computing},
volume = {199},
pages = {115319},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115319},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007672},
author = {Sridhar C. and Aniruddha Kanhe},
keywords = {Convolutional neural networks, LSTM, GRU, Bi-LSTM, Lightweight, Optimization, Speech recognition},
abstract = {Speech-driven automation enabled by deep learning models plays a key role in modern human–computer interaction by improving reliability, efficiency, and accessibility. However, conventional deep learning models for speech recognition are computationally expensive, which limits their deployment in real-time and resource-constrained applications.To address this limitation, this article presents a lightweight convolutional neural network (CNN) optimized for speech recognition through an entropy-informed filter scaling strategy. The proposed architecture employs uniform 3×3 kernels across all layers for structural regularity, with filter counts derived from spectral entropy analysis rather than heuristic expansion. This data-driven approach allocates representational capacity proportional to the information complexity of the input features, thereby reducing computational cost while preserving recognition accuracy.The performance of the proposed model is evaluated on three widely used datasets—Free Spoken Digit Dataset (FSDD), Google Speech Commands, and AudioMNIST—covering variations in sampling rates, speakers, and recording conditions. The evaluation considers multiple performance metrics, including recognition accuracy, model size, parameter count, floating-point operations (FLOPs), and inference time. Compared with lightweight CNN architectures such as ShuffleNetV2, the proposed model achieves 10× fewer parameters, 26.08% lower FLOPs, and 98.5% recognition accuracy on the FSDD dataset across MFCC, ERB, and Bark feature representations.All experiments were conducted under identical conditions on an Intel i7-12700 CPU to ensure fair comparison. The results demonstrate that the proposed architecture achieves competitive accuracy with reduced computational complexity compared with RNN-based, conventional CNN, and hybrid architectures, highlighting its suitability for real-time speech recognition in resource-constrained environments.}
}
@article{JISAN2026115356,
title = {Rice leaf disease classification using resource-efficient deep learning models via response-based knowledge distillation},
journal = {Applied Soft Computing},
volume = {199},
pages = {115356},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115356},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008045},
author = {Maimunul Karim Jisan and Kazi Ekramul Hoque and Tanvir Azhar and M.A.Hakim Newton},
keywords = {Rice leaf disease, Image classification, Deep learning, Convolutional neural network, Knowledge distillation, Response-based knowledge distillation},
abstract = {Rice is one of the principal harvested crops in the Asia-Pacific region which ensures food security for nearly half of humanity. Failure to detect rice leaf disease at early stage, can cause significant reduction in crop productivity. In early diagnosis of rice leaf disease, deep learning models have proven to be useful but they rely on millions or even billions of parameters. Consequently, they are often not suitable for deployment in resource-constrained IoT devices due to the huge size and memory requirements of these models. To mitigate this problem, we propose a novel lightweight CNN model with h5 size of 112KB termed as LiteCNN4Rice to acquire knowledge using Response-Based Knowledge Distillation (RKD) from VGG16 as teacher model. This RKD technique transfers the teacher’s soft probabilistic decision boundaries to the lightweight student model through loss function. Our experimental results on the RLDC dataset illustrate that our proposed model performs about 20.33% better in accuracy when trained as a student using RKD. A significant reduction in misclassifications of each class is observed after optimising categorical cross-entropy loss in RKD, leading to the foundation of the proposed model. Notably, LiteCNN4Rice model achieves an accuracy of 98.15% while having only about 0.2% of the network size of the teacher model. Furthermore, it achieves a remarkably low peak activation footprint memory of 4.92 MB with only 151.4 MFLOPS. As a result, it is highly suitable for deployment on resource-constrained IoT devices in the agricultural sector.}
}
@article{MA2026115360,
title = {Occlusion-aware multi-camera 3D multi-object tracking with dual-appearance dynamic association},
journal = {Applied Soft Computing},
volume = {199},
pages = {115360},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115360},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008082},
author = {Jiaqi Ma and Jinfu Yang and Fuji Fu and Dechen Hao and Runshi Wang},
keywords = {3D multi-object tracking, Dual-appearance modeling, Dynamic threshold filter, Object visibility prediction},
abstract = {Multi-camera 3D Multi-Object Tracking (MOT) has attracted significant attention due to the lower cost of cameras. However, existing algorithms struggle to handle object appearance changes and confidence score degradation caused by occlusion in real-world scenarios. To address these issues, we propose an occlusion-aware multi-camera 3D MOT framework based on Dual-Appearance Dynamic Association, called DADA-Track, which focuses on optimizing the data association and track update in the tracking process. DADA-Track consists of two core components: a Dual-Appearance Association Module (DAAM) and a Track Dynamic Update Module (TDUM). (1) DAAM includes a Visibility Prediction Block (VPB) and a Query Cross-Fusion Block (QCFB). VPB aims to predict the visibility of objects, thereby inferring the occlusion level of the scene. QCFB provides dual-appearance representation for trajectories: normal appearance template and chaotic appearance template, enabling robust matching between trajectories and detections based on the object visibility. Based on these, (2) TDUM contains an Adaptive Discontinuous Update Strategy (ADUS) and a Dynamic Threshold Filter (DTF). ADUS selectively updates the dual-appearance of the trajectory based on the detection visibility, while DTF adaptively adjusts the trajectory initialization threshold according to the scene occlusion level. Detailed experiments are conducted on the nuScenes dataset, demonstrating the effectiveness and superiority of the proposed framework.}
}
@article{LI2026115312,
title = {Weighted multi-view sparse discriminant analysis},
journal = {Applied Soft Computing},
volume = {199},
pages = {115312},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115312},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600760X},
author = {Yuyu Li and Zhihui Lai and Israr Hussain and Xu Wu and Heng Kong and Duoqian Miao},
keywords = {Feature selection, Weighted multi-view learning, Sparse learning, },
abstract = {Multi-view learning and sparse feature extraction are two significant research topics in the field of machine learning. However, most existing multi-view learning approaches focus on learning view-specific transformations for each view, overlooking the varying contributions of different views, which ultimately limits the feature selection capability. In this paper, we propose a novel Weighted Multi-view Sparse Discriminant Analysis (WMSDA) method to optimally combine multi-view features for sparse projection learning within a joint learning framework. Unlike existing approaches that rely on view-specific transformations, the proposed method linearly combines features from different views to obtain a single discriminant subspace for the combined features. An L2,0-norm constraint is imposed on the objective function to enforce strict row sparsity in the projection matrix for effective feature selection. An alternating iterative strategy is designed to jointly learn the optimal linear combination weights for different views and the optimal sparse subspace for feature extraction. Theoretical analyses of WMSDA, including convergence, computational complexity, and its relationship with other methods, are also presented. Experimental results demonstrate that WMSDA achieves superior performance compared to other existing methods.}
}
@article{RAHMANI2026115228,
title = {Sustainable agricultural supply chain: An intuitionistic fuzzy-game network data envelopment analysis},
journal = {Applied Soft Computing},
volume = {199},
pages = {115228},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115228},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006769},
author = {Mahsa Rahmani and Alireza Alinezhad and Zohreh Moghaddas},
keywords = {Closed-loop agriculture supply chain, Network data envelopment analysis, Game theory, Intuitionistic fuzzy sets},
abstract = {The assessment of efficiency within agricultural supply chains has gained attention in recent years; however, the examination of closed-loop supply chains (CLSCs) has been relatively overlooked, primarily due to the complexity of modeling. Therefore, this research offers a new configuration for the CLSC of date fruits, wherein a novel slack-based measure (SBM) network data envelopment analysis (NDEA) model is proposed to determine its efficiency with respect to sustainability and undesirable outputs. The proposed model is unique compared to other models in the literature that utilize two- or multi-stage architectures, as it employs a mixed structure, which is the most thorough form among the various structural possibilities. Also, the proposed SBM-NDEA model employs the egalitarian bargaining game model (EBGM) to assess decision-making unit (DMU) efficiencies in an aggregated manner. In addition, in light of the cognitive uncertainties associated with estimating the parameters of the presented model, the intuitionistic fuzzy set (IFS) theory is employed to address this issue. Ultimately, a case study is examined to verify the correctness of the proposed model and uncertainty approach. The results obtained demonstrated that the proposed EBGM-SBM-NDEA model effectively assessed the efficiency of each participant in the CLSC of date fruits, in addition to evaluating the overall efficiency of the entire chain. In addition, the IFS enabled decision-makers to analyze the efficiency of this system amidst uncertainty, reflecting on three unique states: optimistic, indifferent, and pessimistic.}
}
@article{DAKHLI2026115313,
title = {CFIA-KD: Confidence and feature importance aware knowledge distillation for effective skin lesion diagnosis from dermoscopic images},
journal = {Applied Soft Computing},
volume = {199},
pages = {115313},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115313},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007611},
author = {Rym Dakhli and Walid Barhoumi},
keywords = {XAI, Uncertainty quantification, Confidence-based fusion, Knowledge distillation, Feature importance, Dempster–shafer theory},
abstract = {Ensemble models are widely used for skin lesion diagnosis to improve performance, yet effectively handling uncertainty and providing interpretable decision-level explanations remain challenging. This study presents a knowledge distillation framework that builds a robust ensemble teacher by fusing class probabilities and feature-importance scores via Dempster-Shafer evidence with a Bayesian update for high-conflict cases, then distills both decisions and explanations into a lightweight student. Experimental validation confirms that the proposed teacher model not only manages predictive uncertainty more effectively than conventional ensemble methods, but also exceeds them in accuracy by 2%, achieving an accuracy result of 95%. Furthermore, it successfully distills its knowledge into a lightweight student model that attains 92% accuracy, which is a competitive performance with the teacher while significantly reducing computational complexity. Our source code is publicly accessible at: https://github.com/Dr-ym/CFIA-KD.git.}
}
@article{HAO2026115353,
title = {Knowledge-enhanced cross-modal fusion network for sustainable asphalt pavement maintenance decision-making},
journal = {Applied Soft Computing},
volume = {199},
pages = {115353},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115353},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600801X},
author = {Jun Hao and Lili Pei and Zhenzhen Xing and Yuxuan Shen},
keywords = {Pavement maintenance decision-making, Multi-index prediction, Knowledge-enhanced, Cross-modal feature fusion},
abstract = {Policy regulations, news reports, and public opinion can indirectly influence asphalt pavement performance by shaping traffic patterns and allocating maintenance resources. However, most prediction models rely primarily on structured numerical data, seldom exploiting latent information from unstructured textual sources. To address this gap, this study constructs a specialized semantic corpus aggregating multi-source textual data. A Knowledge-Enhanced Cross-Modal Fusion (KE-CMF) framework is then developed. It employs a dual-channel architecture with a knowledge injection mechanism to align high-level semantic representations with numerical spatial deterioration features. These multimodal inputs are adaptively fused within a bidirectional long short-term memory (Bi-LSTM)-based framework. This architecture independently predicts the Pavement Condition Index (PCI), Rutting Depth Index (RDI), and Riding Quality Index (RQI), thereby mitigating single-task bias. Experimental results demonstrate that textual knowledge integration yields an absolute average increase of 0.18 in the coefficient of determination (R²) compared to numeric-only baselines. Furthermore, the model translates predictions into actionable, threshold-based maintenance strategies aligned with standard specifications (JTG 5421–2018), recommending preventive micro-surfacing for 95 km of boundary segments and structural repairs for 39 km of deteriorated sections. By facilitating timely interventions, this data-knowledge-driven method reduces reliance on resource-intensive rehabilitation, supporting sustainable infrastructure management.}
}
@article{KINA2026115277,
title = {Novel hybrid deep-long short-term memory and machine learning algorithms for the crack-healing estimation of eco-friendly engineered cementitious composites},
journal = {Applied Soft Computing},
volume = {199},
pages = {115277},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115277},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007258},
author = {Ceren Kina and Harun Tanyildizi},
keywords = {Engineering Cementitious Composites, Hybrid prediction model for crack healing, Long Short-Term Memory, Least-Squares Boosting, Gaussian Process Regression},
abstract = {Self-healing concrete addresses cracks caused by environmental factors and tensile strain, helping to extend its lifespan. While Engineered Cementitious Composite (ECC) is particularly important for self-healing, developing a mix that includes supplementary materials instead of relying solely on cement can help reduce environmental impacts. Therefore, accurately predicting its self-healing capacity is crucial. The goal of this study is to develop two new hybrid models that combine Long Short-Term Memory (LSTM) with Gaussian Process Regression (GPR) and Least-Squares Boosting (LSBoost) models, respectively, as well as their individual algorithms to predict the crack-healing ability of eco-friendly ECC. The fly ash, silica fume, limestone powder dosages, and crack width before self-healing (CW-B) were used as input to predict the crack width of ECC after self-healing (CW-A). The ANOVA analysis revealed that CW-B had the most significant impact on CW-A, accounting for 91.84% of the variation. The individual models—LSTM, GPR, and LSBoost—estimated the CW-B with accuracies of 94.6%, 75.4%, and 64.4%, respectively. However, the performance of GPR and LSBoost improved with their hybrid usage alongside LSTM, achieving accuracies of 95.7% and 90.9%, respectively. The LSTM-GPR hybrid model outperformed all others, as evidenced by its narrow range of point-by-point residuals and Taylor plot. Additionally, the LSTM-LSBoost model, despite being slightly less accurate, still demonstrated acceptable predictive capability. These findings indicate that the novel hybrid LSTM-GPR model is the most effective for the self-healing ability prediction of eco-friendly ECC, achieving higher accuracy and lower error rates compared to actual outcomes.}
}
@article{CAI2026115305,
title = {Improving local connectivity of transformer for more accurate leaf vein segmentation},
journal = {Applied Soft Computing},
volume = {199},
pages = {115305},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115305},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007532},
author = {Wanqiang Cai and Yan Zhang and Yifan Xue and Yingyao Ma and Jiasong Wu and Bin Wang and Zongyuan Ge},
keywords = {Leaf vein segmentation, Transformer, Local connectivity modeling, Topological alignment},
abstract = {Segmenting vein networks from leaf images provides unique insights for plant variety classification and phenotypic analysis. However, the complex leaf vein patterns pose a significant challenge. While Transformer-based methods effectively alleviate the conflict between the limited receptive fields of CNNs and the elongated veins, their weak local inductive bias often leads to fragmented results, especially for fine-grained veins. To address this, we propose a Local-Connectivity Enhanced Transformer (LCET) framework that fully leverages the rich connectivity features within the leaf vein networks for performance boosting. Specifically, we design a Local Connectivity Enhancement (LCE) module to improve the capability of Transformer for local connectivity modeling, which transforms the features into local connectivity masks and enforces cross-layer topological alignment. In addition, we propose an Adaptive Balanced Topo-Pixel Loss (ABTP-Loss) to dynamically coordinate the optimization between pixel-level classification accuracy and local structural connectivity. Extensive experiments on two public datasets demonstrate that LCET achieves the state-of-the-art (SOTA) performance with fewer parameters in both accuracy and connectivity.}
}
@article{ZHANG2026115321,
title = {Automatic design of federated PolSAR image classification network via evolutionary neural architecture search},
journal = {Applied Soft Computing},
volume = {199},
pages = {115321},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115321},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007696},
author = {Mengxuan Zhang and Xiaobo Zhang and Jingyuan Shi and Long Liu and Xilu Wang and Licheng Jiao},
keywords = {Federated learning, Neural architecture search, Multi-objective evolutionary algorithm, PolSAR image classification},
abstract = {Although deep learning-based approaches have shown impressive performances in polarimetric synthetic aperture radar (PolSAR) image classification, most of them typically design the networks by considering only one PolSAR image from a specific scene. Moreover, with the wide applications of remote sensing image processing and interpretation in recent years, many institutions have own PolSAR images with different scenes, different land cover compositions, and different acquisition conditions. It is essential to construct the classification networks with considering the joint uses of PolSAR data from different scenes. Regarding this issue, an automatic design of federated PolSAR image classification network via evolutionary neural architecture search is proposed in this study. While protecting the privacy of data in all the participants, it fully utilizes the data of each participant to jointly design a general global model via the evolutionary optimization of both the classification accuracy and the network complexity simultaneously. A lightweight private personalized module is added to the local model of each client to fine-tune the global model for different scene data. It reduces the impacts of heterogeneities of different scene data on model accuracy effectively and makes the model adaptable to complex and changeable data environments. Compared with the popular approaches, it can design the high-precision and low-complexity PolSAR image classification networks automatically with the federated learning of different scene data. Specifically, it achieves a favorable accuracy-complexity trade-off on the joint experiment on the PolSAR data collected in Flevoland, San Francisco, Oberpfaffenhofen and Xi’an. The classification metrics of overall accuracy, average accuracy, Kappa are 96.43%, 97.29%, 95.55%, while the complexity metrics of network parameter number and floating-point operation number are 0.43 M and 18.39 M, respectively.}
}
@article{YIN2026115293,
title = {Adaptive multi-factory production-transportation scheduling optimization for rapid prefabricated steel construction using genetic programming},
journal = {Applied Soft Computing},
volume = {199},
pages = {115293},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115293},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007416},
author = {Jing Yin and Jiayu Chen and Chaoxuan Dong and Haokai Sun and Ran Huang and Shunyao Cai},
keywords = {Rapid construction, Prefabricated steel components, Coordinated scheduling, Production and transportation, Genetic programming},
abstract = {Rapid emergency construction requires precise synchronization between distributed off-site manufacturing and on-site assembly, presenting a complex NP-hard optimization challenge where static heuristics often fail. This study proposes a novel dual-layer hyper-heuristic framework to automate the design of adaptive scheduling logic for the multi-factory production-transportation scheduling problem. Unlike traditional black-box metaheuristics, we employ a synchronous Genetic Programming (GP) evolution strategy to co-evolve interpretable order allocation and production-transportation scheduling rules that explicitly account for strict on-site lifting sequence constraints. Crucially, the framework yields two distinct operational approaches: a pure GP approach where the evolved rules directly dictate the final schedule, and a hybrid GP-GA approach where these rules serve as high-quality seeds for a Genetic Algorithm (GA) to refine global synchronization. Validated against real-world data from a COVID-19 vaccine plant project and compared against an empirical heuristic-based GA benchmark (EHGA), the results reveal a distinct practical trade-off. The pure GP-evolved rules autonomously minimize on-site inventory accumulation, offering optimal solutions for space-constrained sites, while the hybrid GP-GA approach significantly outperforms the EHGA benchmark by over 10% in reducing total flow time. This research demonstrates the efficacy of evolutionary hyper-heuristics in solving high-dimensional, coupled production-logistics problems with dynamic precedence constraints.}
}
@article{POLAT2026115345,
title = {A dynamic randomized domain decomposition strategy in multi-swarm artificial bee colony for solving differential equations},
journal = {Applied Soft Computing},
volume = {199},
pages = {115345},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115345},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007933},
author = {Refet Polat and Begüm Tanyıldız and Korhan Günel},
keywords = {Domain decomposition, Randomized algorithm, Swarm intelligence, Multi-swarm optimization, Differential equation, PDE},
abstract = {In this paper, we present a method for optimizing the training process of artificial neural networks through a dynamic and stochastic domain decomposition approach for solving differential equations. Inspired by domain decomposition methods used for solving Partial Differential Equations (PDEs), we utilize the Artificial Bee Colony (ABC) algorithm within a multi-swarm framework, incorporating our proposed Dynamic Randomized Domain Decomposition (DRDD) strategy. This approach allows us to divide the search space into non-overlapping sub-regions, improving the exploration of optimal neural network parameters without the need for gradient calculations. We validate our method through experiments on two distinct problems: a non-homogeneous Sturm-Liouville problem and the Black-Scholes option pricing model. The multi-swarm ABC algorithm with DRDD demonstrates enhanced training performance by effectively estimating network weights and minimizing errors. While our study shows promising results, it also acknowledges limitations, such as the adjusting the topology of the machine learning model, exclusive focus on differential equations, and the lack of comparison with other multi-swarm optimization methods. Future research should explore the applicability of the DRDD strategy to solve other real-world optimization problems, and refine the domain decomposition process by finding nearly optimal domain decompositions to improve algorithm performance.}
}
@article{ASLAM2026115337,
title = {A novel Morlet Wavelet-Tanh Neural Network based approach for the solution of a plant disease mathematical model},
journal = {Applied Soft Computing},
volume = {199},
pages = {115337},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115337},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007854},
author = {Muhammad Naeem Aslam and Javed Hussain and Muhammad Haris Mateen and Amna Khan},
keywords = {Plant disease model, Physics informed neural networks, Wavelet-tanh neural networks, Intelligent model, Dynamical system},
abstract = {This article presents a plant disease diagnosis framework that combines a mathematical model with machine learning tools. Accuracy in disease detection is improved by solving nonlinear differential equations. These equations are solved using the Morlet Wavelet–Tanh Neural Networks (MTNNs) approach, and the hyperparameters of MTNNs are optimized by combining the Artificial Bee Colony (ABC) and Neural Network Algorithm (NNA) into a hybrid MTNNs–ABC–NNA framework. The approach models the dynamics of plant disease transmission using wavelet-based activation functions for improved generalization. The method is validated against physics-informed neural networks (PINNs) trained with the Adam optimizer. The model is tested under different plant disease scenarios to evaluate precision, reliability, and efficiency. Convergence and performance of the hybrid MTNNs-ABC-NNA approach are confirmed through statistical tests and comparative evaluation. Performance measures, including absolute error (AE) and mean square error (MSE), together with graphical analysis, confirm the reliability and accuracy of the method. Three approaches are also compared across different scenarios: tanh-based ANNs, Morlet wavelet-based ANNs, and Morlet wavelet–tanh-based ANNs.}
}
@article{ZHANG2026115391,
title = {Multi-scale feature reconstruction and gated dual-attention network for driver attention prediction},
journal = {Applied Soft Computing},
volume = {199},
pages = {115391},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115391},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008392},
author = {Yuekui Zhang and Yunzuo Zhang and Yaoxing Kang and Yaoge Xiao and Tong Wang},
keywords = {Driver attention prediction, Multi-scale feature reconstruction, Contextual feature enhancement, Gated dual-attention mechanism},
abstract = {Driver attention prediction plays a vital role in intelligent driving and safety-assistance systems. Most existing prediction methods still suffer from insufficient multi-scale feature interaction and limited spatiotemporal saliency modeling capability, which restricts their performance in complex and dynamic driving scenarios. To address these challenges, we propose a novel multi-scale feature reconstruction and gated dual-attention network (MRGD-Net) for driver attention prediction. First, we introduce a multi-scale feature reconstruction (MFR) module, which injects rich high-level semantic information enhanced by a contextual feature enhancement (CFE) sub-module into lower-level features through layer-by-layer propagation and cross-layer guidance. This design enables effective integration of global context and local details, thereby improving the model’s ability to capture global attention patterns and fine-grained saliency cues. Then, a gated dual-attention (GDA) mechanism is designed to refine the reconstructed features via joint channel and spatial attention mechanisms. This module allows the network to adaptively emphasize salient regions while suppressing redundant or irrelevant information, leading to more discriminative feature representations. Finally, features from different branches are decoded to generate intermediate saliency maps, which are fused to produce the final prediction. Extensive experiments on the DADA-2000 and TDV datasets demonstrate that the proposed MRGD-Net achieves state-of-the-art performance across multiple evaluation metrics, yielding superior results in driver attention prediction.}
}
@article{GAO2026115318,
title = {Progressive cross-modal attention network for brain-computer interface decoding using EEG and fNIRS},
journal = {Applied Soft Computing},
volume = {199},
pages = {115318},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115318},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007660},
author = {Yunyuan Gao and Xiaoqi Luo and Zhengnan Zhang and Xu Shao and Yanhua Qin},
keywords = {Hybrid brain-computer interface, EEG-fNIRS fusion, Cross-modal attention, Progressive alignment, Multimodal deep learning},
abstract = {Electroencephalography (EEG) offers millisecond-level temporal resolution but limited spatial localization, whereas functional near-infrared spectroscopy (fNIRS) provides better spatial resolution but shows a hemodynamic delay of several seconds. A hybrid EEG-fNIRS brain–computer interface fuses the complementary strengths of both modalities but faces challenges from intrinsic spatiotemporal heterogeneity between electrophysiological and hemodynamic signals. To address this, this study proposes a Progressive Cross-Modal Attention Network (PCMAN), which achieves deep EEG-fNIRS fusion and alignment through a three-layer progressive mechanism. The first layer, physical alignment, employs a Spatiotemporal Dynamic Fusion (SDF) framework with sliding windows to capture hemodynamic delay and uses fNIRS-driven spatial attention to enhance EEG features. The second layer, semantic alignment, builds on physical alignment and applies a Multi-Dimensional Feature Enhancement Attention network (MDFEA) to learn deep cross-modal representations while retaining low-level cues. The third layer, task alignment, employs a Cross-modal Adaptive Decoding Network (CADN) for context-aware fusion, adaptively adjusting strategies based on previous layers. On three cognitive tasks—mental arithmetic (MA), word generation (WG), and motor imagery (MI)—PCMAN achieved accuracies of 88.18%, 81.93%, and 72.94%, outperforming state-of-the-art hybrid BCI methods. Interpretability analysis shows that PCMAN aligns temporal and spatial attention with canonical hemodynamic responses, improving accuracy, robustness, and inter-session transferability under subject-dependent hybrid BCI settings.}
}
@article{WANG2026115379,
title = {Adaptive heuristic for routing problems via integrated self-attention and convolution in deep reinforcement learning},
journal = {Applied Soft Computing},
volume = {199},
pages = {115379},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115379},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008276},
author = {Chao Wang and Hua Zhang and Min Zeng},
keywords = {Routing problems, Deep reinforcement learning, Learning adaptive heuristics, Self-attention, Convolution},
abstract = {Recently, the utilization of deep reinforcement learning (DRL) for solving combinatorial optimization problems, specifically in improving heuristic algorithms for routing problems, has garnered significant attention. However, most methods often depend on a single operator to perform local search, which limits their solving ability across various types of problems. This paper introduces a novel adaptive heuristic for solving routing problems by leveraging DRL, where a policy network is designed to facilitate decision-making on both the selection of the operator and the node position. Firstly, a self-attentive mechanism is employed to extract sequence features, thereby facilitating the identification of the specific position for the search operator. Secondly, a convolutional layer is used to transform a single output into multiple outputs, thus enabling adaptive operator selection. By integrating self-attention and convolution within the same policy network, this approach can simultaneously output the appropriate search operator and the corresponding node pair required to modify the solution. Furthermore, a simple fine-tuning strategy is introduced for model training. Experimental results from both randomly generated and real-world datasets demonstrate that the proposed method outperforms learning methods based on a single operator in terms of solution quality, especially in traveling salesman problem (TSP) instances and small-to-medium-scale capacitated vehicle routing problem (CVRP) instances. This method also has strong generalization ability and is applicable to various problem distributions and scales.}
}
@article{ZHANG2026115355,
title = {GP-M3Net: A group-wise prompt enhanced multimodal 3D network for Alzheimer’s disease classification},
journal = {Applied Soft Computing},
volume = {199},
pages = {115355},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115355},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008033},
author = {Xin Zhang and Jun Wu and Tao Chen and Bo Chen and Binyu Zhu and Wenxiu Wang and Dongjing Wang and Sijie Niu and Yichan Ye and Yuyu Yin and Ruyue Huang},
keywords = {Multimodal fusion, Prompt learning, Alzheimer’s disease classification},
abstract = {Early and accurate diagnosis of Alzheimer’s disease is crucial for timely clinical intervention and effective treatment planning. However, existing multimodal approaches often face two key challenges: (1) inadequate modeling of the complex spatial characteristics inherent in three-dimensional magnetic resonance imaging data, and (2) suboptimal alignment between neuroimaging and cognitive assessment data, as manually designed prompts may fail to capture the complex semantic dependencies. To address these challenges, this paper proposes GP-M3Net, a group-wise prompt enhanced multimodal three-dimensional network for Alzheimer’s disease classification. First, a three-dimensional residual network is employed to extract fine-grained volumetric features from magnetic resonance imaging scans, enabling comprehensive spatial representation learning. Second, a group-wise learnable prompt construction strategy is introduced, which constructs group-specific and shared prompt vectors to dynamically bridge the semantic gap between cognitive text and imaging representations. This design effectively aligns multimodal features and enhances cross-modal understanding. Experimental results on two real-world datasets, namely the Alzheimer’s Disease Neuroimaging Initiative dataset and the Open Access Series of Imaging Studies dataset, demonstrate that the proposed GP-M3Net achieves state-of-the-art performance, with superior performance across multiple evaluation metrics compared to unimodal and conventional fusion baselines. The code is available at https://github.com/Emy-cv/GP-M3Net.}
}
@article{FOUAD2026115359,
title = {ARG-Net: Adaptive Relational Graph Network for occluded person Re-identification},
journal = {Applied Soft Computing},
volume = {199},
pages = {115359},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115359},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626008070},
author = {Mohammed Abusarie Fouad and Hanaa M. Hamza and Khalid M. Hosny},
keywords = {Person Re-Identification, Occlusion, Adaptive Relational Graph Network, ViT, Brightness-Matched Occlusion},
abstract = {Person Re-identification (ReID) has achieved remarkable success; however, its performance degrades significantly when subjects are partially occluded, which is a common challenge in real-world scenarios. Many traditional part-based methods rely on rigidly structured models, such as fixed horizontal stripes, that fail to adapt to occlusion variability, resulting in feature representations corrupted by uninformative visual cues. In this study, we propose an Adaptive Relational Graph Network (ARG-Net), a novel framework that explicitly learns to navigate occlusions by operating on patch-based image representations extracted from a Vision Transformer (ViT) backbone. At its core, ARG-Net dynamically constructs a relational graph between the image patch features for each input. A self-attention mechanism learns to down-weight connections to occluded patches and reroutes information through visible regions. To ensure that the learned graph is structurally meaningful, we introduce a Graph Regularization Loss that jointly encourages sparsity and feature smoothness, guiding the model to form connections only between contextually relevant patches. To train our network, we also leveraged Brightness-Matched Occlusion (BMO), a data augmentation strategy that generates diverse occlusions with brightness-matched colors that mimic the local luminance of the image region, forcing the model to learn robust features. Extensive experiments demonstrated that ARG-Net achieved state-of-the-art performance, reaching 91.3% mAP on Market-1501, 84.6% mAP on DukeMTMC-reID, and a new benchmark of 66.8% mAP on the challenging Occluded-DukeMTMC dataset, thereby proving its effectiveness in navigating real-world occlusions.}
}