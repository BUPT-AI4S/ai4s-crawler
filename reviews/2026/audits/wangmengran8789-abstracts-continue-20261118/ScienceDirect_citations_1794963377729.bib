@article{YOUSEFIJORDEHI2026114431,
title = {Margin-based angular losses for lightweight text classification: Lessons from face recognition},
journal = {Applied Soft Computing},
volume = {188},
pages = {114431},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114431},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017442},
author = {Arash {Yousefi Jordehi} and Seyed Abolghasem Mirroshandel},
keywords = {Modified softmax, Margin-based loss functions, Representation learning, Contrastive learning, Deep learning, Text classification},
abstract = {Text classification is a fundamental task in Natural Language Processing (NLP) with widespread applications in both academia and industry. While transformer-based models with hundreds of millions of parameters dominate recent benchmarks, they incur heavy computational costs and reduced interpretability. In contrast, we argue for algorithmic innovation over parameter scaling. Inspired by margin-based angular losses such as CosFace, ArcFace, and SphereFace in face recognition, we propose a lightweight framework that redefines text classification as a prototype alignment problem in angular space. Class labels are treated as dynamic prototypes, and text embeddings are optimized to form compact intra-class clusters while maintaining large angular margins between classes. To evaluate this framework, we conduct large-scale experiments on 11 benchmark datasets. Our approach achieves consistent and statistically significant improvements over Softmax, particularly in high-cardinality classification tasks (e.g., R52: 95.1 % vs. 94.3 %, 20NG: 83.6 % vs. 78.9 %, GoEmotions: 56.6 % vs. 55.5 %). On average, margin-based losses improve accuracy by +1.2 percentage points across all datasets. Despite using only ∼550 K parameters, our method rivals or surpasses transformer-based baselines that are over 100× larger. The contributions of this work are threefold: (i) adapting angular margin-based losses from face recognition to NLP classification, (ii) introducing a single-stage, interpretable prototype-alignment framework, and (iii) demonstrating that algorithmic loss design, rather than parameter growth, can deliver state-of-the-art text classification performance.}
}
@article{TIAN2026114492,
title = {Small-sample modelling of early-stage operation of high concrete dams in cold regions based on deep transfer learning},
journal = {Applied Soft Computing},
volume = {188},
pages = {114492},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114492},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018058},
author = {Jichen Tian and Xiutao Wang and Yanling Li and Liang Pei and Xiang Lu and Tianci Chen},
keywords = {Structural health monitoring, High concrete dam, Cold regions, Deep transfer learning, Small-sample modelling},
abstract = {Structural Health Monitoring (SHM) of high concrete dams in cold regions faces significant challenges due to small-sample monitoring data and complex time-varying operational loads. This study proposes a deep transfer learning-based SHM model that integrates high-fidelity numerical simulations with Long Short-Term Memory (LSTM) networks to address these challenges. The source domain is constructed by simulating dam deformation under actual operational and environmental conditions, including temperature variations and reservoir water levels, generating high-quality data for knowledge transfer. A small-sample learning framework is then established to transfer the embedded mechanistic knowledge from the source domain to sparse-sample target domains, enabling accurate early-stage deformation prediction. The model is validated on high concrete dams in both cold and conventional regions through systematic comparative and ablation experiments. Results indicate that the proposed approach outperforms traditional SHM models across multiple evaluation metrics, particularly under limited monitoring data conditions, while also demonstrating strong generalization capabilities. Furthermore, analyses reveal that the similarity between source and target domains and the target-domain sample size critically affect prediction performance. This study provides a novel and practical methodology for monitoring high concrete dams during early operation in cold regions, with broad engineering applicability.}
}
@article{ZHANG2026114395,
title = {Designing a reverse logistics system for multi-source medical waste clean-up in the aftermath of disaster under uncertain environment},
journal = {Applied Soft Computing},
volume = {188},
pages = {114395},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114395},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017089},
author = {Fanshun Zhang and Lu Liu and Xinyu Zhuo and Cejun Cao and Ming Wan},
keywords = {Major public health emergencies, Multi-source disaster medical waste, Reverse logistics system optimization, Mixed-integer linear programming model, Uncertain environment},
abstract = {The sudden onset of major public health emergencies has imposed substantial negative consequences globally, particularly affecting the global economy, natural environment, and psychological well-being of residents. In this context, establishing a safe reverse logistics system for disaster medical waste can effectively mitigate these challenges and foster sustainable development. This paper proposes a tri-objective mixed-integer linear programming model to optimize allocation and disposal strategies for multi-source disaster medical waste, so as to minimize economic costs, psychological impacts, and infection risks simultaneously. To address the inherent uncertainty in disaster medical waste quantities and traffic conditions, triangular fuzzy numbers are employed for estimation. A case study based on the COVID-19 pandemic in Shanghai is conducted, and the CPLEX solver is utilized to calculate the results. Results reveal the following: (i). Decision-makers should prioritize objectives according to varying disaster scenarios, enabling the formulation of adaptive waste management plans that align with the characteristics of different stages of disaster development. (ii). During the outbreak period, prioritizing psychological impact can better enhance the overall operational efficiency of the system, but this effect is not obvious during the peak and mitigation periods. (iii). Increasing the financial budget improves the performance of the reverse logistics system, while such improvements exhibit diminishing returns within a specific range.}
}
@article{SALMAN2026114520,
title = {Automated selection of regression algorithms with soft computing techniques},
journal = {Applied Soft Computing},
volume = {188},
pages = {114520},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114520},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018332},
author = {Osamah Salman and Bekir Aksoy},
keywords = {Machine learning, Regression algorithms selection, Expert systems},
abstract = {This study introduces an innovative framework and expert system designed to enhance the automation of selection and ranking processes for machine learning regression algorithms. Algorithm selection within machine learning applications constitutes a complex task. intrinsically linked to the dataset characteristics and the specific nature of the problem at hand. Accurate algorithm selection not only optimizes model performance but also contributes to significant savings in time and computational resources. Accordingly, this research endeavors to streamline the algorithm selection process by offering a systematic, accurate, and user-friendly approach. The study leveraged 281 regression datasets sourced from reputable open-access platforms. These datasets underwent rigorous preprocessing, encompassing missing data imputation, transformation of categorical variables into numerical representations, extraction of statistical features, and overall enhancement of data quality. Key statistical features included the correlation structures of datasets, the number of input features, and the number of output variables. Following this preprocessing phase, 15 machine learning algorithms were employed to train the datasets. Their performance was systematically evaluated based on metrics such as R², training time, and testing time. The analysis revealed that Random Forest and Extra Trees consistently demonstrated superior accuracy and reliability, whereas the k-Nearest Neighbors algorithm exhibited relatively low accuracy and high variability in performance. Building upon these findings, a Random Forest (RF) classifier-based expert system was developed to rank algorithms according to the statistical attributes of the datasets and provide recommendations for the most suitable algorithms. The expert system’s efficacy was assessed using the N-step tolerance framework. Under zero-step tolerance, corresponding to perfect alignment with true rankings, the system achieved R² and training time accuracies of 59 % and 84 %. respectively. At one-step tolerance, these accuracies improved to 76 % and 94 %. while under two-step tolerance, the R² and training time accuracies reached 84 % and 98 %. respectively. These results underscore the effectiveness of the proposed system in automating and enhancing algorithm selection processes for regression tasks.}
}
@article{YU2026114423,
title = {Intuitionistic fuzzy strength preference in the graph model considering internal and external consensus},
journal = {Applied Soft Computing},
volume = {188},
pages = {114423},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114423},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017363},
author = {Jing Yu and Yi Huang and Ziming Zhu},
keywords = {Graph model for conflict resolution, Intuitionistic fuzzy strength preference, Composite decision makers, Internal and external consensus, Nuclear wastewater discharge conflict},
abstract = {Twelve years after the Fukushima nuclear accident, the Fukushima Daiichi Nuclear Power Plant (FDNPP) officially began discharging nuclear wastewater into the ocean on August 24, 2023. As the wastewater contains radioactive substances, its discharge is expected to damage both local and global marine ecosystems, triggering strong opposition from the public and neighboring countries. With rising global uncertainty, the nuclear wastewater discharge, as a conflict under complex environmental conditions, requires preference structures that account for two essential characteristics of human decision-making-intuitionism and strength differentiation. Based on this, a new preference structure, the intuitionistic fuzzy strength preference (IFSP), is constructed within the graph model for conflict resolution (GMCR) framework. Considering that the effective resolution of conflict events often depends not only on individual preferences but also on the degree of coordination within decision-making groups and consensus among different groups (two essentially different but coexisting forms of consensus), this study proposes the concepts of internal consensus and external consensus, along with corresponding consensus computation methods. On this basis, a new set of stability definitions is introduced in the GMCR framework based on the IFSP and internal-external consensus, in order to derive feasible solutions to the conflict. The developed model is then applied to the Fukushima nuclear wastewater discharge conflict. The stability analysis reveals four equilibria, among which s7 is identified as the most stable and likely outcome. In s7, Japan discharges the wastewater without technological improvement, while neighboring countries impose sanctions and international organizations exercise supervision and condemnation. This equilibrium underscores the effectiveness of a combined pressure mechanism. The analysis further elucidates why alternative states are less sustainable: for instance, the absence of international oversight (s5) or sanctions (s10) fails to exert sufficient pressure on Japan, whereas an overly confrontational approach (s11) risks escalating the conflict.}
}
@article{MA2026114399,
title = {Enhancing evolutionary algorithms with solution prediction for influence maximization in social networks},
journal = {Applied Soft Computing},
volume = {188},
pages = {114399},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114399},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017120},
author = {Kaicong Ma and Haipeng Yang and Hangxing Ma and Xinxiang Xu and Qiang He and Lei Zhang},
keywords = {Influence maximization, Evolutionary algorithm, Solution prediction, Social networks},
abstract = {Influence Maximization (IM) aims to select a subset of users from a social network to maximize the influence spread. Due to the NP-hardness of the IM problem, most existing IM methods either suffer from high computational complexity or compromise solution accuracy. To address this challenge, we propose a Classification-assisted Evolutionary Algorithm (CEA), which leverages the information from solution prediction to boost the Evolutionary Algorithm (EA) to efficiently and effectively address the IM problem. In the first place, we train a classification model using a group of small IM problem instances with given optimal solutions. Subsequently, the offline-trained classification model is utilized to predict whether a node belongs to the optimal solution or not, and further predicts the probability that it is part of the optimal solution. In the second place, the information from solution prediction is integrated into the key components of EA to facilitate the search for high-quality solutions, including search space partition, initialization, and evolutionary operators. Extensive experiments conducted on 12 real-world social networks demonstrate that our CEA algorithm achieves an average of 99 % of the influence spread achieved by cost-effective lazy forward (CELF), while reducing running time by at least two orders of magnitude in most cases. Consequently, CEA strikes a better balance between effectiveness and efficiency.}
}
@article{JIANG2026114418,
title = {Long-short term time-delay reservoir for nonlinear time series forecasting task},
journal = {Applied Soft Computing},
volume = {188},
pages = {114418},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114418},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017314},
author = {Dongchen Jiang and Yi Zeng and Meiming You and Guoqiang Wang},
keywords = {Nonlinear time series prediction, Time-delay reservoir, Short-term memory, Multi-scale features, Wide-layered architecture},
abstract = {Reservoir computing (RC) such as Time-Delay Reservoir (TDR) has gained attention due to its good hardware scalability structure and low training complexity. However, most existing TDR variants follow shallow architectures, limiting their short-term memory (STM) and multi-scale modelling capabilities. To address these limitations, this paper proposes a novel wide-layered TDR framework and two multi-scale deep TDR models: Long-delay Time-Delay Reservoir (LD-TDR) and Long-short Term Time-Delay Reservoir (LS-TDR). LD-TDR integrates two independently operated DTDR modules, with skip connections and a cross-coupling mechanism to enhance long-term memory retention. LS-TDR extends LD-TDR by introducing a short-term reservoir, improving the model’s ability to capture local and short-term dynamics. Experiments are conducted on both chaotic and real-world datasets, including Mackey-Glass, Lorenz, Sunspot, ETT and network traffic datasets, under open-loop and closed-loop prediction settings. Results show that the proposed models consistently outperform the TDR variants (TDR, DDR, DTDR and DATDR) and Echo State Networks (Deep-ESN, ADRC, LS-ESN and LS-CrossESN) in both single-step and multi-step forecasting tasks. The LD-TDR and LS-TDR exhibit significantly enhanced STM and improved multi-scale temporal representation, demonstrating predictive accuracy across diverse datasets.}
}
@article{SOBOT2026114434,
title = {Hybrid machine teaching with human oversight for classification of seismograms},
journal = {Applied Soft Computing},
volume = {188},
pages = {114434},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114434},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017478},
author = {Tamara Sobot and David Murray and Vladimir Stankovic and Lina Stankovic},
keywords = {Machine teaching, Machine learning, Deep learning, Seismic event classification},
abstract = {While Artificial Intelligence (AI) is gaining popularity, two main problems limit its adoption by geoscientists for analysing and classifying large volumes of seismic recordings to monitor seismic activity associated with landslides and natural disasters. Firstly, AI often operates as a black box, whose inner workings, geoscientists do not understand and therefore are reluctant to trust its outcomes. Secondly, classification relies on learning from large labelled datasets, which are not available in practice because of the sheer volume of seismograms needing labels and the limited confidence of geoscientists in labelling low magnitude seismograms amidst anthropogenic noise. To reduce the workload on geoscientists, and accommodate the need for human agency and oversight as one of the main trustworthy AI principles, a hybrid machine teaching framework is proposed where the human teacher (domain expert) provides a few representative labels for each class based on which the machine teacher (a Siamese deep learning network) selects and labels training examples for the learner (a deep learning-based multi-classifier). The training is performed in stages, incrementally expanding training set based on provided labelled samples at each stage, resembling the way humans learn, starting with more obvious examples and progressing towards more complex ones. Leveraging the publicly available Résif Seismological Data Portal of the Super-Sauze Landslide in the Southern French Alps, characterised by low-amplitude signals, generally highly attenuated at short distances, we show that the proposed hybrid machine teaching framework effectively classifies low-magnitude earthquakes, quakes, rockfall and anthropogenic noise with F1 scores of 0.86, 0.61, 0.87 and 0.70, respectively.}
}
@article{MA2026114486,
title = {XAI driven analysis of multidimensional sustainability factors: Evidence from TFP of Chinese listed companies},
journal = {Applied Soft Computing},
volume = {188},
pages = {114486},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114486},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017995},
author = {Yuanyuan Ma and Yiwen Shi and Menghan Gao and Yiqing Yan},
keywords = {Explainable Artificial Intelligence, Machine Learning, Environmental, Social, and Governance, Carbon Emissions, Total Factor Productivity, Corporate Sustainability},
abstract = {Abstracts
Against the global backdrop of emissions reduction, Chinese listed companies, as key entities in achieving the "dual carbon" goals, have often been studied for sustainable development in ways that overlook nonlinear relationships between factors. Even the few studies employing machine learning methods lack discussions on model interpretability. This paper introduces Explainable Artificial Intelligence (XAI) and integrates multi-source data to systematically analyze how core factors—financial performance, carbon emission intensity, Environmental, Social, and Governance (ESG) ratings, management and market sentiment, proportion of highly educated talent, and corporate credit risk—collectively influence Total Factor Productivity (TFP) through "synergistic enhancement" or "mutual constraints," from multiple dimensions including global interpretation, local attribution, interaction effects, and sample paths. In this study, the sample consists of China's A-share listed companies from 2019 to 2023, with valid annual observations from 281 companies. The research employs seven machine learning algorithms and, through feature combination experiments, identifies Explainable Boosting Machine (EBM, R2=0.7299) and Extreme Gradient Boosting (XGBoost, R2=0.8007) as the models with the best predictive performance in self-interpretation and post-hoc interpretation, respectively. Based on interpretability analysis of the optimal models, the importance ranking is as follows: financial performance > proportion of highly educated talent > investor sentiment > corporate carbon emissions > ESG rating.}
}
@article{BAE2026114410,
title = {Accuracy-informed label smoothing and logit scaling for deep neural network calibration},
journal = {Applied Soft Computing},
volume = {188},
pages = {114410},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114410},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017235},
author = {Jinsoo Bae and Seoung Bum Kim},
keywords = {Overconfidence, Calibration, Accuracy-informed, Confidence, Alignment},
abstract = {Addressing miscalibration in deep learning models is crucial for reliable confidence in safety-critical applications. Existing calibration methods often rely on smoothing-based techniques (e.g., label smoothing, Mixup, and their variants). However, they typically overlook the model’s current accuracy and offer no principled way to determine the proper degree of smoothing. Thus, they often require costly hyperparameter searches or additional post-hoc retraining. We propose an accuracy-informed label smoothing and logit scaling (ALiS), which uses an accuracy-informed aligned confidence distribution to adaptively determine smoothing levels and stabilizes training via a single learnable logit-scaling parameter. Experimental results on the CIFAR-10, CIFAR-100, SVHN, and Tiny-ImageNet datasets demonstrate the effectiveness of the proposed method. Additionally, ALiS outperforms conventional calibration methods by integrating diverse data augmentations when faced with data distribution shifts.}
}
@article{XU2026114426,
title = {Memory-based iterated local search with multiple perturbation operators for personalized learning path planning},
journal = {Applied Soft Computing},
volume = {188},
pages = {114426},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114426},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017399},
author = {Junliang Xu and Xicheng Peng and Mao Chen},
keywords = {Learning path planning, Iterated local search, Memory mechanism, Perturbation operator},
abstract = {The learning path planning problem aims to create a personalized sequence of knowledge units selected from a vast pool of learning resources tailored to each learner’s individual needs. This challenge is classified as NP-hard. To address it, this paper introduces an iterated local search algorithm incorporating a memory mechanism and five perturbation operators. Specifically, to enhance search efficiency during the exchange-based local search phase, low-contribution learning materials are temporarily stored in a memory array, excluding them from subsequent searches unless they are replaced by materials that contribute even less effectively. When the search becomes trapped in local optima, five distinct perturbation operators are applied to adjust the learning paths, which then serve as new starting points for further local searches. To evaluate the proposed algorithm, computational experiments were performed on 14 widely used benchmark datasets, and the results were compared with two advanced methods. The results show that our algorithm outperforms other heuristic algorithms and achieves varying degrees of improvement across the 14 datasets, thus providing learners with more appropriate learning paths. In addition, further experiments were conducted to analyze the influence of various parameters and the contribution of different algorithm components.}
}
@article{FOOLAD2026114499,
title = {Multi-choice machine reading comprehension benchmark datasets: A survey},
journal = {Applied Soft Computing},
volume = {188},
pages = {114499},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114499},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018125},
author = {Shima Foolad and Kourosh Kiani and Razieh Rastgoo},
keywords = {Natural language processing (NLP), Machine reading comprehension (MRC), Multi-choice MRC, Cloze-style MRC, Benchmark datasets, Dataset classification},
abstract = {Machine Reading Comprehension (MRC) has emerged as a critical area in Natural Language Processing (NLP), especially within the realm of multi-choice and cloze-style tasks that assess a model's ability to understand and reason over text. This paper offers a comprehensive examination of recent developments in multi-choice MRC by analyzing the existing cloze-style and multiple-choice benchmark datasets, many of which have been underexplored in the research community. We introduce a refined classification method based on attributes such as corpus style, domain, complexity, context style, question style, and answer style. This nuanced classification enhances our understanding of each dataset's diverse characteristics and facilitates their categorization based on complexity. Beyond dataset analysis, we discuss implications for MRC model design and future research, review recent advances in MRC methodologies, and examine prompt-based and instruction-following models. We also provide insights into performance trends, common pitfalls, and practical as well as theoretical implications for the development and evaluation of MRC systems. Our survey aims to provide researchers with a thorough overview of the current MRC landscape, aiding in the selection of appropriate datasets and highlighting opportunities for future research.}
}
@article{GAO2026114398,
title = {Attention distillation for low-cost driver behavior recognition},
journal = {Applied Soft Computing},
volume = {188},
pages = {114398},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114398},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017119},
author = {Hang Gao and Mengting Hu and Kaiye Yu and Han Xing},
keywords = {Driver Behavior Recognition, Attention Distillation, Low-cost Models},
abstract = {Deploying artificial intelligence (AI) models for driver behavior recognition has become increasingly popular for improving driving safety. However, as vehicle intelligence advances, the rising number of AI models imposes heavy demands on onboard hardware. This study aims to develop low-cost driver behavior recognition models to alleviate such burdens, where “low-cost” refers to smaller model size and faster inference speed. To this end, we construct shallower convolutional neural networks (CNNs) by removing deeper convolutional layers and propose an innovative Attention Distillation (AD) mechanism to enhance their performance. Compared to previous distillation mechanisms, attention distillation provides more detailed knowledge transfer: it leverages the category-specific attention of deeper CNNs as the teacher to guide the attention of shallower CNNs. Experimental results show that MobileNetV2-11AD, which retains only 11 residual bottlenecks and is trained with AD, achieves higher accuracy than the original MobileNetV2 on the State Farm and AUC V2 datasets, while reducing parameters by 89.29 % and boosting the frame rate on CPU and GPU by 57.52 % and 72.65 %, respectively. Consistent gains are observed on the diverse 100-Driver dataset. These results confirm that the proposed AD mechanism provides a promising solution for low-cost driver behavior recognition. The code is available at https://github.com/gaohangcodes/AD4DBR.}
}
@article{YAN2026114381,
title = {A probability-based linguistic decision-making approach to a reliable Kano model for classifying quality attributes},
journal = {Applied Soft Computing},
volume = {188},
pages = {114381},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114381},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016941},
author = {Hong-Bin Yan and Lianzhuang Qu and Van-Nam Huynh},
keywords = {Customer satisfaction, Kano model, Reliability, Uncertainty modelling, Linguistic decision},
abstract = {Due to its ability to reflect the asymmetric and nonlinear relationship between quality and customer satisfaction, the Kano model has been widely practiced in marketing and product/service design for classifying quality attributes. Despite the methodological revisions and extensions of the Kano model in the literature, its effective utilization is still critically challenged by the following reliability issues: uncertainties underlying both evaluation rules and the Kano survey as well as lack of a suitable reliability measure for the Kano survey. To address these three issues simultaneously, this paper seeks to propose a probability-based linguistic decision-making approach to a reliable Kano model (PKM). To do so, a Bayesian ensemble model is first proposed to infer uncertain evaluation rules, the reliabilities of which are well validated and justified. Second, our PKM couples the inferred uncertain rules with Kano survey data in terms of precise assessments, fuzzy assessments, and hesitant fuzzy linguistic term sets, into the aggregation and choice functions. Third, a probability-based reliability measure is proposed for the special characteristics as well as precise and uncertain expressions of the Kano survey. Two comparative application studies reveal that our PKM excels in handling uncertainties of evaluation rules, providing a richer way to reliable expressions in the Kano survey, measuring the reliability indices of the Kano survey, as well as avoiding the information loss in aggregating Kano survey data. As such, this paper provides researchers and managers a “soft” reliable Kano model for classifying quality attributes as well as sheds new light on applications of fuzzy linguistic approaches.}
}
@article{YE2026114353,
title = {CMAT: A cross-model adversarial texture for scanned document privacy protection},
journal = {Applied Soft Computing},
volume = {188},
pages = {114353},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114353},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016667},
author = {Xiaoyu Ye and Jingjing Yu and Jungang Li and Yiwen Zhao},
keywords = {Document active privacy protection, Adversarial texture, Cross-model texture},
abstract = {With the development of deep learning-based text detection and recognition, extracting text from smartphone-captured or scanned images has become effortless. However, this convenience gives rise to privacy concerns, especially for individuals and organizations unwilling to let their documents be automatically read and analyzed by deep learning-based models. To address this problem, we propose a novel solution for scanned document privacy protection in this paper. First, we propose a cross-model universal adversarial texture that mimics natural paper textures to safeguard scanned document images against multiple text detection models. Second, we construct a comprehensive dataset of scanned financial documents, including line-level and character-level text annotations for both English and Chinese documents, thereby providing diverse data for evaluating our protection method. Experimental results indicate a significant reduction in H-mean scores of various text detection models, demonstrating the efficacy of our cross-model universal adversarial texture in preserving document privacy.}
}
@article{WANG2026114421,
title = {Lightweight and robust multi-source domain generalization for classifying internet of things malware},
journal = {Applied Soft Computing},
volume = {188},
pages = {114421},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114421},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501734X},
author = {Fangwei Wang and Yanyan Li and Haibin Ma and Qingru Li and Changguang Wang and Yan Liu},
keywords = {Internet of things malware, Malware classification, Multi-source domain generalization, Evolving malware, Tag-aware selector},
abstract = {Malware detection and classification in the Internet of Things (IoT) face significant challenges, including high memory and computational demands, uneven sample distributions, and limited model generalization. To address these problems, we propose a lightweight IoT malware classification model that combines multi-source domain generalization (DG) with Mamba, termed MSDGM. MSDGM employs a multi-source DG strategy to improve adaptability to domain shifts and enhance generalization in IoT malware detection. To further increase efficiency, an optimized MobileNet is utilized for software feature extraction, which reduces computational overhead and maintains faster performance. Moreover, the model integrates a Mamba-based Tag Aware Selector (MTAS) that identifies and mitigates adverse factors, thus improving classification accuracy and robustness. Building upon the above results, MSDGM dynamically adjusts parameters according to sample variations without manual intervention. Experimental results indicate that MSDGM achieves accuracies of 97.05 %, 99.46 %, and 89.13 % on the BIG2015, Malimg, and BenchMFC datasets, respectively, outperforming existing methods and showing superior generalization for evolving malware. We anticipate that MSDGM will serve as an effective countermeasure for detecting and classifying IoT malware, thereby safeguarding critical IoT applications.}
}
@article{LIU2026114469,
title = {RAMSF: A relation-aware multi-scale feature learning framework for predicting metabolite-disease associations},
journal = {Applied Soft Computing},
volume = {188},
pages = {114469},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114469},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501782X},
author = {Shiyu Liu and Bo Wang and Xue Yang},
keywords = {Metabolites, Diseases, Association Prediction, Relation-Aware, Mamba},
abstract = {Predicting metabolite–disease associations is crucial for uncovering biomarkers and therapeutic targets in disease research and drug development. Traditional experimental methods are time-consuming and labor-intensive, while computational methods can improve experimental efficiency. However, existing deep learning methods struggle to fully extract semantic features from multiple relationship types within heterogeneous graphs, resulting in inadequate capture of both local neighborhood patterns and global network structure. To address this, we propose a relation-aware multi-scale feature learning framework (RAMSF). Specifically, multi-source associations among metabolites, diseases, genes, and drugs are fused to construct a multi-relational heterogeneous graph, and initial heterogeneous node embeddings are obtained using metapath2vec based on metapaths. Subsequently, a multi-hop aggregation method incorporating the attention mechanism is proposed to perceive the local higher-order structural information under different relation types. Next, GCNs are employed to reinforce local representations, preserving structural consistency, after which node sequences with deterministic degree ordering are constructed to encode global structural priors. Then, the Mamba model captures long-range dependencies, yielding representations that integrate local and global semantics. Finally, the extracted features are fed into the CNN module to complete the prediction of potential associations between metabolites and diseases. A large number of experimental validations on public datasets show that RAMSF significantly outperforms the existing seven mainstream methods in terms of AUC and AUPR, and exhibits strong prediction performance and good generalization ability, which can effectively support the association prediction task in complex biological networks.}
}
@article{YANG2026114385,
title = {Semi-supervised semantic segmentation via multi-level and multi-view perturbation consistency},
journal = {Applied Soft Computing},
volume = {188},
pages = {114385},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114385},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016989},
author = {Jiacheng Yang and Hui Fang and Jing Dong and Rui Liu and Pengfei Yi and Jiajun Yin and Qiang Zhang},
keywords = {Semi-supervised semantic segmentation, Perturbation consistency, Augmentation, Semi-supervised learning},
abstract = {Semi-supervised semantic segmentation (SSS) aims to achieve fine-grained pixel-level image annotations by using a small set of labeled training data and a large amount of unlabeled data. Typical SSS methods exploit various types of augmentations to introduce weak-to-strong perturbation consistency on the unlabeled data to improve their model performance. However, in most of these methods, only a limited number of perturbation types are used to enforce the regularisation. To this end, we propose an intuitive multi-level and multi-view perturbation consistency (MMPC) framework to enhance feature representations by integrating the consistency constraints at image-level, latent-space-level and network-level. Specifically, at the image level, a multi-perturbation pool is presented to diversify our perturbation strategies, thus consequently improving our model reliability. At the latent-space level, a novel cluster-based perturbation strategy is proposed to enhance the representations by exploiting feature variations of semantic objects and their contexts. Additionally, a teacher-student network structure provides guidance from a pseudo-label perspective to further improve the model performance. Our MMPC has convincingly outperformed state-of-the-art SSS methods on both the Pascal VOC 2012 and the Cityscapes datasets.}
}
@article{MA2026114317,
title = {A comparative study of boundary-based rough set models and their feature selection mechanisms},
journal = {Applied Soft Computing},
volume = {188},
pages = {114317},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114317},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016308},
author = {Zhouming Ma and Jusheng Mi and Guoping Lin and Weizhi Wu},
keywords = {Boundary rough sets, Boundary operators, Approximation operators, Axiomatization, Feature selection, Classification learning},
abstract = {Rough set theory represents a crucial methodology in the field of soft computation. Its boundary operator’s axiomatic properties mainly rely on the axiomatic framework of the approximation operator. However, the axiom system for the boundary operator has yet to be directly established. To explicitly characterize the axiomatic properties of boundary operators and further explore the effectiveness of boundary methods in feature selection, we first conduct a systematic comparison of relevant rough set models through the boundary region. The axiomatic system for boundary operators is presented directly. Secondly, we establish the equivalence between two rough set models based on binary relations and two models grounded in coverings. The approximation operators corresponding to B1 and B2-types are equivalent to those generated by a tolerance and preorder relation, respectively. Thirdly, to evaluate the effectiveness of the proposed boundary method, we designed forward and backward feature selection algorithms based on this approach. Finally, we compared the performance of various boundary operators, including fuzzy rough sets and whale optimization algorithms. Numerical experiments indicate that among the algorithms above, the B2-type boundary rough set model demonstrates significant advantages in terms of computational speed while maintaining a certain level of classification accuracy.}
}
@article{LIN2026114380,
title = {Evolutionary reinforcement learning for explainable recommendation on knowledge graph},
journal = {Applied Soft Computing},
volume = {188},
pages = {114380},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114380},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501693X},
author = {Yuanguo Lin and Hong Chen and Xiuze Zhou and Wei Zhang and Huanyu You and Fan Lin and Pengcheng Wu},
keywords = {Recommender systems, Evolutionary reinforcement learning, Explainable recommendations, Knowledge graph reasoning, Policy optimization},
abstract = {In recent years, Knowledge Graphs (KGs) with Reinforcement Learning (RL) have emerged as powerful tools for the path reasoning in recommendation systems. However, explaining the reasoning behind recommendations remains a challenge, i.e., how to efficiently infer an effective path from the available options in large action spaces. To this end, we propose a novel framework, namely Evolutionary Reinforcement Learning for Explainable Recommendation (ERLER), that leverages KGs to deliver transparent and personalized recommendations. By combining evolutionary strategies with RL, the proposed framework dynamically optimizes recommendation policies in the path reasoning. Furthermore, we refine the critic network with an adaptive mechanism. This strengthens the framework’s capacity for adjustment, thereby accelerating convergence and improving stability. Experimental results on benchmark datasets demonstrate that our ERLER not only achieves higher recommendation accuracy (e.g., improving Precision@10 by 2.28 % and HR@10 by 2.02 % over the state-of-the-art on the Amazon Clothing dataset) in most cases but also enhances the performance of path reasoning.}
}
@article{CHEN2026114396,
title = {SRMamba: Mamba for super-resolution of LiDAR point clouds},
journal = {Applied Soft Computing},
volume = {188},
pages = {114396},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114396},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017090},
author = {Chuang Chen and Xiaolin Qin and Jing Hu and Xia Yuan and Wenyi Ge},
keywords = {Range image, LiDAR point cloud, Super-resolution, Visual state space},
abstract = {In recent years, range-view-based LiDAR point cloud super-resolution techniques have attracted increasing attention as cost-effective approaches for generating denser point clouds. However, the truncation error inherent in traditional projection methods leads to significant void artifacts. Furthermore, the reconstruction results of super-resolution point clouds often exhibit coordinate deviations in novel views. We propose a novel super-resolution method for LiDAR point clouds in sparse scenes, namely SRMamba, aiming to address the key challenges of the existence of void regions and coordinate deviations. Specifically, we implement a projection technique based on Hough Voting and Depth Inpainting strategy to eliminate horizontally linear voids, which are observed as horizontally aligned missing bands in the range image. To improve the establishment of long-distance dependencies and to focus on potential geometric features in vertical 3D space, we employ a Visual State Space model and Multi-Directional Scanning mechanism to mitigate the loss of 3D spatial structural information due to the range image. Additionally, an asymmetric U-Net network adapts to the input characteristics of LiDARs with different beam counts, enabling super-resolution reconstruction for multi-beam point clouds. We conduct extensive experiments on two challenging public LiDAR datasets, KITTI-360 and nuScenes. On KITTI-360, SRMamba improves IoU by 9.5% while reducing CD and MAE by 24.3% and 5.8%, respectively. On nuScenes, it achieves an IoU gain of 14.2% with CD and MAE reductions of 8.4% and 4.4%. Moreover, SRMamba is suitable for deployment on embedded platforms. The code is available at https://github.com/wtxjbl-tp/SRMamba.}
}
@article{HAN2026114392,
title = {ET-Fake: A multi-modal fake news detection model augmented with external knowledge and two-stage feature fusion},
journal = {Applied Soft Computing},
volume = {188},
pages = {114392},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114392},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017053},
author = {Mingxing Han and Jiaxuan Li and Shiyan Ou and Liwei Xu and Lingling Tao},
keywords = {Fake News Detection, Multi-modal, Feature Fusion, Contrastive Learning},
abstract = {In recent research, multi-modal fake news detection has attracted significant attention due to the ease with which textual and image information can be posted, spread, and proliferated on social networks. However, current research cannot effectively handle AI-tampered text and images, nor can it effectively identify real news with image-text semantic inconsistencies. Therefore, we propose a Multi-modal Fake News Detection Model Augmented with External Knowledge and Two-stage Feature Fusion (ET-Fake). We extract multi-modal features from news, including text, images, and external knowledge. These features are trained through multi-view contrastive learning and integrated through two-stage feature fusion to recognize the authenticity of the news. Experimental results on the Twitter and Weibo datasets demonstrate the superiority of our model, achieving accuracy improvements of approximately 0.012 and 0.019 over existing state-of-the-art models. Our research provides new solutions for managing fake news on social networks, effectively addressing the problem of rampant fake news propagation on social networks.}
}
@article{XIE2026114444,
title = {High-order multi-view unsupervised feature selection based on inter-view and intra-view},
journal = {Applied Soft Computing},
volume = {188},
pages = {114444},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114444},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017570},
author = {Xijiong Xie and Jiangnan Xu and Shengke Xu and Yiwan Xu and Yujie Xiong},
keywords = {Unsupervised feature selection, Multi-view learning, Low-rank tensor learning, High-order information},
abstract = {Graph structure learning is fundamental to multi-view unsupervised feature selection, as it facilitates the modeling of complex relationships among data instances across diverse views. Existing methodologies for graph construction are typically categorized into global and local structure learning paradigms. Although both paradigms effectively capture pairwise relationships, they often fail to exploit high-order interactions and neighborhood dependencies inherent within and between views. To overcome this limitation, we introduce a novel approach—High-order Multi-view Unsupervised Feature Selection based on Inter-view and Intra-view Information (HMvUFS)—which explicitly incorporates high-order neighborhood information into the graph learning framework to enhance feature selection quality. Our method leverages a weighted tensor nuclear norm minimization strategy to capture underlying high-order correlations across multiple views, thereby improving the robustness and discriminative power of the learned graph structures. Additionally, we propose an efficient optimization algorithm to solve the associated objective function. Extensive experimental results on several benchmark datasets demonstrate that the proposed HMvUFS method consistently outperforms state-of-the-art techniques in multi-view unsupervised feature selection, which validates its effectiveness and general applicability.}
}
@article{YU2026114436,
title = {ERL-ER-FedHG: Evolutionary reinforcement learning with experience replay for federated heterogeneous graphs},
journal = {Applied Soft Computing},
volume = {188},
pages = {114436},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114436},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017491},
author = {Jin Yu and Junping Du and Zhe Xue and Meiyu Liang},
keywords = {Federated graph learning, Deep reinforcement learning, Evolutionary learning, Heterogeneous graphs, Experience replay, Graph sampling},
abstract = {Complex real-world problems in computer science can often be abstracted into heterogeneous graph data models. When combined with the distributed architecture and privacy preservation of federated learning, such models enable collaborative training across multiple heterogeneous datasets without exposing raw data. However, traditional methods struggle with the exponential growth of computational complexity and memory consumption as the number of nodes and edges increases. These challenges are further amplified in federated settings, where distributed training across multiple clients introduces substantial training dynamics and model instability. To address these issues, this paper proposes ERL-ER-FedHG (Evolutionary Reinforcement Learning with Experience Replay for Federated Heterogeneous Graphs). The approach applies subgraph sampling to local graphs and formulates the sampling parameters of each client as a continuous Markov decision process within each communication epoch, enabling reinforcement learning agents to adjust sampling strategies dynamically. To stabilize the temporal behavior of the controller, an experience replay mechanism is incorporated to revisit and reuse historical decisions without increasing communication costs. Furthermore, an evolutionary learning module is integrated to enhance the exploration capability of the controller by generating diverse policy candidates through mutation and crossover. Experiments on four heterogeneous graph datasets show that ERL-ER-FedHG achieves stable training behavior and favorable performance compared with existing federated graph neural network methods, demonstrating its applicability to federated heterogeneous graph learning.}
}
@article{DING2026114408,
title = {Stepwise sampling coevolutionary framework for expensive constrained multiobjective optimization problems},
journal = {Applied Soft Computing},
volume = {188},
pages = {114408},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114408},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017211},
author = {Anai Ding and Hongshuang Li and Yuanzhuo Ma and Wei Li},
keywords = {Expensive constrained multiobjective optimization, Coevolutionary framework, Kriging, Stepwise sampling strategy},
abstract = {Expensive constrained multiobjective optimization problems (CMOPs) frequently arise in practical engineering, posing significant challenges in determining acceptable solutions with a reasonable computational cost. This paper proposes a stepwise sampling coevolutionary framework (SSCF), integrating a fuzzy clustering-based Kriging modeling (FuzzyCM) method with the coevolutionary framework to form an optimizer to address this issue. The FuzzyCM method uses the information from all training samples to build the Kriging model while reducing computational costs. During the optimization process of this optimizer, all accessed solutions are recorded. SSCF adopts a stepwise sampling strategy, which selects new samples from both the solutions output by the optimizer and the solutions recorded during the optimization process to update the Kriging models. This manner aims to enhance the prediction accuracy of the Kriging model regarding solution feasibility while ensuring the convergence of the algorithm. To evaluate the performance of SSCF, it was compared with constrained multiobjective evolutionary algorithms, one-time modeling surrogate-assisted evolutionary algorithms (SAEAs), and sequential SAEAs on 31 benchmark problems. Additionally, a comprehensive parameter study was conducted to investigate the impact of specific parameters on the performance of SSCF, providing appropriate recommendations for parameter settings. Finally, the proposed algorithm was applied to a spring design problem, demonstrating its feasibility and effectiveness in practical applications.}
}
@article{AKDAMAR2026114424,
title = {Entropy-based borda extended weighted expert FMEA approach: Comparison with classical and fuzzy FMEA on a ship system},
journal = {Applied Soft Computing},
volume = {188},
pages = {114424},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114424},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017375},
author = {Emrah Akdamar and Gizem Elidolu and Maruf Gögebakan and Bulut Ozan Ceylan},
keywords = {FMEA, Risk assessment, Maritime engineering safety, Entropy weighting, Borda count aggregation, Multi-expert decision modeling, System-level risk prioritization},
abstract = {In high-risk and safety-critical domains such as maritime engineering, accurate identification and prioritization of failure modes are essential for ensuring system reliability. While classical Failure Modes and Effects Analysis (FMEA) is widely applied, its reliance on averaging expert scores often leads to information loss. Fuzzy FMEA addresses uncertainty but still aggregates data, resulting in similar limitations and added complexity through subjective membership functions and rule structures. This study presents an integrated expert-based risk assessment framework that combines entropy weighting and Borda count aggregation to enhance transparency and preserve expert diversity within the FMEA process. Applied to a marine compressor system comprising 33 failure modes and evaluated by multiple experts, the model individually processes O, S, and D scores, calculates entropy-based criterion weights, and generates consensus Rankings through Borda-based synthesis. Key findings reveal a significant reordering of critical risks with continuously operating compressor, low intercooler pressure, and high intercooler pressure emerging as top priorities. Correlation analysis reveals strong consistency with traditional models (r = 0.973 with FMEA and r = 0.883 with fuzzy FMEA), while providing enhanced diagnostic granularity and operational relevance. The integrated WE-RANK framework provides a transparent, objective, and computationally efficient structure adapted to maritime applications, demonstrating the value of combining established decision tools for expert-based risk evaluation.}
}
@article{LIN2026114476,
title = {Improving imbalanced data classification via nonlinear synthetic sample generation with dual autoencoder},
journal = {Applied Soft Computing},
volume = {188},
pages = {114476},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114476},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017892},
author = {Liang-Sian Lin},
keywords = {Imbalanced datasets, Dual autoencoder, Siamese network, Synthetic samples, Membership function},
abstract = {Imbalanced datasets pose a series of formidable challenges in academic and actual applications. Many researchers have developed sample-level algorithms to address this challenge using different sampling techniques. In this paper, we introduce a hybrid sampling algorithm termed Dual-AE-SN method, containing under-sampling, over-sampling, and sample selection modules, to solve imbalanced dataset problems. On under-sampling module, we develop an α-cut triangular membership function (MF) technique to eliminate noise from majority samples. On over-sampling module, we present a non-linear interpolation method with deep dual-autoencoder (Dual-AE) to generate non-linear synthetic samples in the minority class. Furthermore, a novel MF-based Siamese network (MF-SN) is constructed to identify the most representative synthetic minority samples. Based on twelve benchmark datasets, extensive experiments are conducted to demonstrate that the proposed method can successfully promote predictive performance on imbalanced datasets. The random forest (RF) and k-nearest neighbors (KNN) predictive models are deployed to compare the proposed Dual-AE-SN method to six state-of-the-art sampling techniques on classification performance in terms of G-mean, F1, and AUC indicators. Overall, the Dual-AE-SN method provides effectively superior classification performance compared to the six sampling methods in addressing imbalanced datasets.}
}
@article{LI2026114497,
title = {A novel cross domain deep network for unsupervised fault diagnosis of rotating machinery},
journal = {Applied Soft Computing},
volume = {188},
pages = {114497},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114497},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018101},
author = {Yiting Li and Qingsong Fan and Muhammet Deveci and Haisong Huang and Kaiyang Zhong and Amer Al-Hinai},
keywords = {Unsupervised, Fault diagnosis, 1D residual convolution, Global features, Adaptive noise reduction, Suppressed feature loss, Domain transfer},
abstract = {Deep learning-based industrial fault diagnosis usually necessitates the training of predictive models on a large volume of labeled data to achieve high performance. However, the signals obtained when a machine runs under various working conditions have different distributions, and labels cannot be provided for data under all working conditions in actual production. Therefore, we designed an unsupervised deep-learning fault-detection model. First, building on a one-dimensional residual convolutional network, the model's performance is enhanced by focusing on the global feature receptive field, adaptive noise reduction for signals, and mitigating the loss of long-range feature information, all of which contribute to improved feature engineering; second, the model optimization integrates the classification loss from the source domain with the domain transfer loss from the target domain, facilitating continuous enhancement of accuracy in the unsupervised transfer learning process. The ablation and comparison experiments were conducted to evaluate the performance of the proposed model. The proposed model achieved a maximum accuracy improvement of 37.20 % over the original ResNet structure and the highest improvement effect of 43.02 % compared to other comparative models. Across various experimental scenarios, it exhibited remarkable advantages and superior overall performance, thereby furnishing a practical unsupervised deep-learning approach for industrial applications.}
}
@article{LI2026114355,
title = {QoS-aware fuzzy decision-based data forwarding in edge-centric vehicular networks},
journal = {Applied Soft Computing},
volume = {188},
pages = {114355},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114355},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016680},
author = {Yinglong Li and Tinghao Chen and Jiahui Li and Weiru Liu and Tieming Chen},
keywords = {QoS-aware data forwarding, Vehicular ad hoc networks (VANETs), Fuzzy decision-making, Uncertainty modeling, Edge intelligence},
abstract = {Efficient and reliable data transmission is vital for ensuring Quality of Service (QoS) in edge vehicular networks, especially during emergencies requiring low-latency communication. However, high mobility and unpredictable road conditions make it difficult to maintain stable routes, limiting the effectiveness of conventional routing protocols. This paper proposes FuzzyForward, a novel fuzzy logic-based data forwarding framework tailored to the dynamic and uncertain nature of edge VANETs. Unlike traditional methods, FuzzyForward uses fuzzy reasoning to evaluate imprecise traffic metrics, such as connection quality and turning fitness, for accurate selection of road segments and relay vehicles. Another key contribution is its two-phase fuzzy optimisation process, supported by a relay candidate reduction strategy to minimise overhead and improve responsiveness. Simulation results demonstrate that FuzzyForward significantly enhances packet delivery, reduces end-to-end delay, and lowers communication overhead.}
}
@article{KUANG2026114400,
title = {A refined YOLOv5n-based method for detecting pepper flower objects integrating transfer learning},
journal = {Applied Soft Computing},
volume = {188},
pages = {114400},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114400},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017132},
author = {Minqiu Kuang and Fangping Xie and Dawei Liu and Bei Wu and Shang Chen and Yang Xiang and Feng Liu and Yanhua Wu and Xu Li},
keywords = {Pepper flower, Pollination, Object detection, YOLOv5n, Transfer learning},
abstract = {To address the low detection accuracy of small pepper flower targets in complex field environments and the need for extensive annotated datasets, a refined object detection model, YOLOv5n_Pepper Flower, based on an improved YOLOv5n architecture and transfer learning, is proposed in this study. First, to enhance detection accuracy and reduce the parameter count, the conventional convolution unit within the Neck layer of the YOLOv5n model was replaced with the simplified Grouped and Shuffled Convolution (GSConv). Second, the lightweight upsampling mechanism Content Aware Feature ReAssembly (CARAFE) was integrated into the Neck layer, significantly improving accuracy with minimal additional parameters. Third, the original PANet was replaced by the Bidirectional Feature Pyramid Network (BiFPN) structure, enhancing the fusion of multi-scale features through feature weighting. Lastly, the introduction of the attention mechanism BiFormer (Vision Transformer with Bi-Level Routing Attention) into the Neck layer improved the detection capability for small pepper flower targets, consequently boosting overall model performance. Experimental results showed that the refined YOLOv5n_Pepper Flower achieved a mean average precision (mAP) of 97 %, surpassing YOLOv5n, YOLOv5s, YOLOv7tiny, YOLOv8s, and YOLOv8n by margins of 0.9 %, 0.7 %, 5.9 %, 1.3 %, and 1.7 % respectively. Additionally, the comparison between the refined YOLOv5n_Pepper Flower and YOLOv9 indicated similar detection accuracies. However, the YOLOv5n-based model exhibits superiority in terms of computation, the number of parameters, and model size, and its lightweight model was superior regarding computational efficiency, parameter count, and model size. Its lightweight characteristics are more suitable for mobile terminal deployment. Furthermore, training the refined YOLOv5n model with transfer learning increased the mAP to 97.1 %, accelerated model convergence, and improved detection performance. The findings of this study provide a solid foundation for developing methods for pepper flower posture estimation and mechanical pollination.}
}
@article{SILVEIRA2026114447,
title = {Multi-agent systems for clinical decision support: A systematic review},
journal = {Applied Soft Computing},
volume = {188},
pages = {114447},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114447},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017600},
author = {Andre Lehdermann Silveira and Rodrigo {da Rosa Righi} and Cristiano {André da Costa}},
keywords = {Clinical decision support, Hierarchical multi-agent reinforcement learning, Knowledge representation, Generative AI},
abstract = {Multi-agent reinforcement learning (MARL), ontology-based medical knowledge representation, and generative AI–particularly large language models (LLMs) are increasingly applied in clinical decision support systems (CDSSs). Despite rapid advances, no systematic review has comprehensively examined these issues from a combined perspective, leaving gaps in the understanding of hierarchical architectures, bidirectional knowledge flow, and explainable AI mechanisms. To address this, we reviewed 42 studies published between 2016 and 2025, identifying key challenges and proposing a structured taxonomy that organizes the field across learning paradigms, knowledge representation, and generative AI, while also addressing cross-cutting concerns such as explainability and adaptability. Our findings suggest that the convergence of hierarchical MARL, ontology-grounded knowledge representation, and LLM-enhanced explainability may provide a foundation for next-generation CDSSs that are adaptive, semantically robust, and clinically actionable.}
}
@article{CHEN2026114374,
title = {Building automated negotiating agent with offline-to-online deep reinforcement learning},
journal = {Applied Soft Computing},
volume = {188},
pages = {114374},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114374},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016874},
author = {Siqi Chen and Gerhard Weiss and Jie Geng and Jianing Zhao},
keywords = {Automated negotiation, Deep learning, E-commerce, Offline reinforcement learning, Empirical game theory},
abstract = {Background
Reinforcement learning (RL) has achieved substantial success in automated negotiation. However, training RL-based agents typically requires costly online interaction, which can be unsafe in real-world settings. Furthermore, these agents often struggle when opponents change their strategies or preferences unexpectedly.
Method
To address these challenges, we introduce ANAgent, a novel Automated Negotiating Agent. Our approach is two-fold: first, it pre-trains a general negotiation strategy on offline datasets collected by a variety of unknown strategies. Second, it employs a safe and efficient offline-to-online fine-tuning mechanism, allowing the pre-trained strategy to quickly adapt to new opponents’ preferences and strategies during deployment.
Results
We evaluate ANAgent’s performance through extensive experiments against a wide range of state-of-the-art negotiating agents. The results demonstrate that ANAgent successfully learns high-performing strategies from offline data that surpass the performance of the strategies that generated the data. Furthermore, it robustly fine-tunes its strategy online in response to changes in opponent behavior. Beyond traditional average score metrics, a comprehensive empirical game-theoretic analysis confirms the robustness and strategic strength of our agent.
Conclusion
This work presents a viable pathway for developing negotiation agents that can safely learn from historical data and adapt efficiently in real-time interactions, moving closer to robust and deployable automated negotiation systems.}
}
@article{ZHANG2026114390,
title = {SDNet: A two-stage segmentation-diffusion network for camouflaged object detection},
journal = {Applied Soft Computing},
volume = {188},
pages = {114390},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114390},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501703X},
author = {Hongliang Zhang and Sanxin Jiang},
keywords = {Camouflaged object detection, Semantic segmentation, Diffusion model, Deep neural network},
abstract = {Inspired by the human visual mechanism for detecting camouflaged objects —first identifying their approximate location and then refining their details—we propose SDNet, a two-stage segmentation-diffusion network. In the first stage, a diffusion model is employed to mitigate the uncertainty of confident point estimation, providing a more robust initial prediction. In the second stage, semantic segmentation is applied to extract local features, followed by contextual information aggregation to refine and optimize feature representations, thereby enhancing detection accuracy. Extensive experiments demonstrate that SDNet consistently outperforms 15 state-of-the-art segmentation and diffusion-based methods across three challenging datasets, underscoring its effectiveness and superior performance.}
}
@article{ZHANG2026114411,
title = {MLGNet: An integrative multi-scale network combining local and global features for knee osteoarthritis classification},
journal = {Applied Soft Computing},
volume = {188},
pages = {114411},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114411},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017247},
author = {Guokai Zhang and Jie Yu and Yiqun Lin and Yanran Wang and Menglong Geng},
keywords = {Knee osteoarthritis, Multi-scale enhancement, Salient local features, Contextual global aggregation},
abstract = {Knee osteoarthritis (KOA) presents a significant public health challenge, particularly for older adults. Traditional classification methods often fall short when it comes to effectively capturing multi-scale information and establishing meaningful relationships between local and global features. To address these limitations, this paper introduces a novel Multi-Scale Local and Global Network (MLGNet), which comprises three innovative components. First, a novel approach enhances multi-scale features by extracting and fusing residual block features using dimensional alignment, spatial adjustment, and weighted channel-wise aggregation. Second, a salient local feature encoding method is proposed aimed at improving representation by analyzing channel activation strengths and applying adaptive coefficients. Finally, the approach includes a contextual global histogram aggregation mechanism that captures interdependencies among features while preserving their statistical independence. Experimental results on two KOA datasets show statistically significant improvements (p<0.05) over state-of-the-art methods, with accuracies of 85.78 % and 84.05 %, sensitivities of 85.15 % and 80.23 %, and specificities of 86.41 % and 87.86 %. F1-scores of 85.57 % and 83.40 % indicate balanced precision and recall, while AUC values of 0.936 and 0.922 further confirm superior overall classification performance.}
}
@article{ZHANG2026114342,
title = {A multi-orthogonal prototype contrastive learning framework with feature compression for imbalanced skin lesion classification},
journal = {Applied Soft Computing},
volume = {188},
pages = {114342},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114342},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016552},
author = {Yujiao Zhang and Ke Li and Jianping Shi and Hong Zhang},
keywords = {Computer-aided diagnosis, Skin lesion, Contrastive learning, Feature compression, Multi-orthogonal prototypes},
abstract = {Skin lesion morphology is critical for diagnosing dermatological diseases. While deep neural networks (DNNs) have advanced in automatically extracting lesion features, they still face challenges due to inter-class imbalance and intra-class variability in skin image datasets, which hinder classification performance. Contrastive learning has recently gained attention for its ability to improve inter-class discriminability and reduce the dominance of majority classes. Inspired by this, we propose a novel multi-orthogonal prototype contrastive learning framework that enhances minority class representations by amplifying their gradient contributions. The framework comprises two parallel branches sharing a common encoder and a prototype generation module. The cross-entropy (CE) classification branch uses standard CE loss to accelerate convergence and optimize classifier weights. The prototype generation module introduces an orthogonal matrix mechanism to produce multiple orthogonal class centers based on classifier weights, serving as anchors for the contrastive branch. This addresses limitations of single-center representations and mitigates feature collapse. The contrastive learning branch applies class-specific compression rates to encourage tighter clusters for minority classes in the embedding space, improving boundary separability and classification accuracy. Extensive experiments on the public ISIC 2018 and private Derm-SD8 datasets show that our method achieves state-of-the-art (SOTA) performance across various metrics, significantly outperforming traditional CE-based approaches. Additionally, the framework is plug-and-play and model-agnostic, demonstrating strong generalizability and adaptability across deep learning architectures.}
}
@article{MAJUMDAR2026114439,
title = {Investment decisions in blockchain and big data information services for mitigating greenwashing in closed-loop supply chains: a tripartite evolutionary game model},
journal = {Applied Soft Computing},
volume = {188},
pages = {114439},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114439},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017521},
author = {Pritam Majumdar and Bibhas C. Giri},
keywords = {Evolutionary game theory, Big data, Blockchain, Investment decisions, Greenwashing},
abstract = {As environmental concerns intensify, sustainable supply chains are becoming vital for the global economy. However, green innovation, eco-friendly technologies, emission reduction, and remanufacturing often require substantial financial investments that deter manufacturers. This underscores the need for government intervention, though it may also increase the risk of greenwashing. Despite the widespread use of big data and blockchain in sectors like e-commerce, their application in supply chain management is under-explored. This research focuses on optimizing the adoption of Information Service Blockchain and Big Data Providers (ISBD) to mitigate greenwashing in sustainable supply chains. Using a tripartite evolutionary game model, the study analyzes replicator dynamics for a sustainable supply chain to identify equilibrium points and derive Evolutionary Stable Strategies (ESS) under various parameter configurations. The numerical analysis demonstrates the impact of various parameters, including the greenwashing level, on the evolution of strategies. Sensitivity analysis further highlights the influence of these parameters on system dynamics. Our findings indicate that increased penalties and taxes significantly influence greenwashing, while a higher prevalence of greenwashing undermines government oversight. Furthermore, raising subsidies does not effectively promote green innovation but ISBD intervention proves essential, with its success depending on the degree of greenwashing and the relationship between payment and intervention costs.}
}
@article{ZHANG2026114366,
title = {Overcoming scalability challenges in multi-objective flexible jobshop scheduling algorithms by automatic configuration},
journal = {Applied Soft Computing},
volume = {188},
pages = {114366},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114366},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016795},
author = {Xuwei Zhang and Shixin Liu and Ziyan Zhao and Jianhai Song and Shengxiang Yang},
keywords = {Automatic configuration, Multi-objective evolutionary algorithm, Iterated dual-frequency racing, Flexible job shop scheduling},
abstract = {Evolutionary algorithms excel in Multi-Objective Flexible Jobshop Scheduling Problems (MFJSPs). However, these algorithms are typically tailored to specific problems, and this specificity poses significant scalability challenges, limiting broader applicability and demanding substantial design and configuration efforts. This work addresses these scalability challenges by leveraging the complementary strengths of various algorithmic components and configuring them flexibly for target problems. To achieve this, we introduce an automatic configuration framework designed to adaptively select and integrate optimal solving algorithms for MFJSPs. Within this framework, we incorporate a multi-objective evolutionary algorithm template to provide an execution logic that facilitates the creation of sequences, branches, and loops within the algorithm. Additionally, we propose a tool called ‘Iterated Dual-Frequency Racing’, which enhances the efficient selection of suitable components from an extensive library. Together, the aforementioned template and tool enable our automatic configuration framework to seamlessly select and adjust components. We designed a series of experiments to verify the scalability of the proposed framework, and the results indicate that our framework exhibits both good generalization capabilities and problem-solving performance.}
}
@article{LEI2026114403,
title = {HFL-YOLOv8: a hyperbolic feature-enhanced lightweight network for object detection in ground penetrating radar images},
journal = {Applied Soft Computing},
volume = {188},
pages = {114403},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114403},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017168},
author = {Wentai Lei and Shixuan Yu and Tao Zhang},
keywords = {Ground penetrating radar, Radar signal processing, Deep learning, Object detection, Lightweight},
abstract = {Deep learning-based soft computing object detection algorithms for Ground Penetrating Radar (GPR) B-Scan images face two significant challenges: Existing methods struggle to account for the unique geometric characteristics of hyperbolas. This limitation hampers the extraction of correlation information, particularly when detecting smaller objects; The high resource consumption of these algorithms increases hardware requirements, making them less efficient for practical deployment. To address these issues, this paper proposes HFL-YOLOv8, a hyperbolic feature-enhanced lightweight object detection network based on YOLOv8. The key contributions of HFL-YOLOv8 include: Three convolution layers with varying dilation rates are employed to capture feature information across different scales, improving the network’s ability to handle diverse object sizes. A dynamic upsampling operator and a channel-position attention module are incorporated to refine the detection of hyperbolic features, addressing the limitations in geometric representation. A detection head with shared parameter convolution is used to reduce computational overhead. Additionally, enhanced Sobel convolution and group normalization convolution compensate for accuracy loss, ensuring robust detection. HFL-YOLOv8 achieves an F1-score of 79.7 % and mAP50 of 81.8 %, representing significant performance improvements. Moreover, the proposed network reduces the number of parameters by 14.8 % and computational costs by 13.6 %, offering enhanced accuracy and resource efficiency for detecting small object bisectors in GPR B-Scan images.}
}
@article{NASER2026114427,
title = {Philosophy-informed machine learning},
journal = {Applied Soft Computing},
volume = {188},
pages = {114427},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114427},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017405},
author = {M.Z. Naser},
keywords = {Engineering, Artificial intelligence, Philosophy},
abstract = {Philosophy-informed machine learning (PhIML) directly infuses core ideas from analytic philosophy into ML model architectures, objectives, and evaluation protocols. Therefore, PhIML promises new capabilities through models that respect philosophical concepts and values by design. From this lens, this paper reviews conceptual foundations to demonstrate philosophical gains and alignment. In addition, we present case studies on how ML users/designers can adopt PhIML as an agnostic post-hoc tool or intrinsically build it into ML model architectures. Across all three case studies, PhIML delivered consistent gains with logical and counterfactual violations drastically reduced with minimal accuracy trade-offs (−0.6 to +1.7 %age points (pp)). In one specific fairness setting, worst-off hiring rates rose by more than 23 % and equity gaps reversed, while overall selection increased by + 10.8 pp and ≥ 90 % of baseline accuracy was retained. Finally, this paper sheds light on open technical barriers alongside philosophical, practical, and governance challenges and outlines a research roadmap toward safe, philosophy-aware, and ethically responsible PhIML.}
}
@article{FENG2026114443,
title = {Fuzzy comprehensive three-level evaluation for deep learning classification targeting high-dimensional data},
journal = {Applied Soft Computing},
volume = {188},
pages = {114443},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114443},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017569},
author = {Sheng Feng and Liping Zhao and Changtian Ying and Shigen Shen and Weixing Wang and Xiao-Zhi Gao and Saied Pirasteh},
keywords = {High-dimensional data (HDD), Deep learning (DL), TOPSIS, Intuitionistic fuzzy sets (IFS), Fuzzy comprehensive evaluations (FCE)},
abstract = {High-dimensional data (HDD) are high-dimensional, sparse, and complex, which results in the inherent limitations of model-driven methods. When faced with HDD, it is difficult for most existing methods to establish accurate evaluation models on the basis of prior knowledge, especially for the mining of uncertain and probabilistic data. Therefore, to increase the evaluation accuracy and robustness of HDD analyses with multicriteria decision-making, we propose a novel framework that combines deep learning (DL) classification with fuzzy comprehensive three-level evaluations (FCTEs). This framework preserves expert knowledge and improves evaluation accuracy by addressing the complexity, instability, and difficulty in assessing the advantages and disadvantages of efficiency and impact. To effectively address dimensionality reduction, we use first-level FCE to calculate the evaluation criteria according to low-dimensional hierarchical structures. Moreover, we combine a DL classifier with intuitionistic fuzzy entropy (IFE) in second-level FCE to guarantee that the classification results are as consistent as possible with expert opinions. Furthermore, we introduce an IFE-based technique for order preference via the similarity to an ideal solution (TOPSIS) approach in third-level FCE to accurately reflect the advantages, disadvantages and gaps in various data scenarios. The results illustrate that the proposed framework can mine deeper meanings in the Shaoxing University datasets, the MIT-BIH arrhythmia database and the Student Stress dataset, providing more objective and fair evaluations. Because our framework fully considers the impact of the membership degree, the nonmembership degree, and the degree of hesitation on the evaluation results to reduce bias. Moreover, our classifier has better stability in terms of classification ability and clustering effect to improve the consistency with expert judgments. Furthermore, our framework has demonstrated good robustness in experiments across datasets. In addition, the reliability of sensor measurement data is much greater than that of expert scores, resulting in higher satisfaction scores. Finally, through the closed-loop mechanism of autonomous classification, comprehensive evaluation, and performance analysis, the interpretability of the inference results is increased.}
}
@article{ABOSSEDGH2026114382,
title = {Machine learning-driven feature selection and anomaly detection for Bitcoin price analysis},
journal = {Applied Soft Computing},
volume = {188},
pages = {114382},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114382},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016953},
author = {Sara Abossedgh and Ali Yeganeh and Arne Johannssen},
keywords = {Feature selection, Machine learning algorithms, Multivariate control chart, On-chain analytics, Price fluctuation},
abstract = {Crypto analysts have to deal with a variety of challenges, with the most important area being the price volatility of cryptocurrencies. Due to uncertain market trends, many studies have been conducted on forecasting techniques, and some of these techniques have beenintegrated with advanced analytical tools, including machine learning (ML) techniques. Making reliable predictions of the speculative behavior of financial assets, especially in non-stationary and highly volatile environments such as the cryptocurrency market, is a challenging task. In this study, ML techniques are used to identify influential features that affect the prices of cryptocurrencies, especially for Bitcoins. In addition, multivariate control charts are utilized for signal detection, allowing for a structured approach to develop trading strategies for seasonal market conditions. Unlike other studies that do not take seasonality into serious consideration when analyzing market fluctuations, the proposed approach explicitly accounts for it. The developed strategy is tested across various market conditions, including the final days of each year from 2019 to 2024, and demonstrates strong and consistent performance in all cases. By systematically identifying key on-chain features and analyzing them by means of control charts, this study develops a structured approach to anomaly-based trading strategies in Bitcoins. These discoveries address an extensive discussion on automated trading systems, demonstrating that feature selection, technical indicators, market seasonality, and halving impacts are important components in hinting at successful cryptocurrency exchange strategies.}
}
@article{WANG2026114349,
title = {A Q-learning based multi-objective memetic algorithm for dual-resource-constrained energy-saving distributed flexible job shop scheduling with applications in aerospace manufacturing},
journal = {Applied Soft Computing},
volume = {188},
pages = {114349},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114349},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501662X},
author = {Wentao Wang and Jing Zhao},
keywords = {Energy-saving distributed flexible job shop scheduling, Machine restart-aware, Worker arrangement, Multi-objective memetic algorithm, Reinforcement learning},
abstract = {Against the backdrop of Industry 5.0, manufacturing systems increasingly emphasize the coordinated development of human-centricity and environmental sustainability. To address the dual challenges of efficiently allocating resources (both machines and workers) and achieving energy savings in distributed flexible job shop scheduling (DFJSP), this paper proposes a worker-machine dual-resource-constrained energy-saving DFJSP model that integrates machine restart-aware and worker assignment (DRC-EDFJSP-WMR). The model aims to minimize the makespan, total system carbon emissions, and maximum workload among workers, thereby achieving the collaborative optimization of energy-saving machine operation decisions and flexible human resource assignment in distributed environments. To address the DRC-EDFJSP-WMR problem, this paper proposes a Q-learning based multi-objective memetic algorithm (QMOMA) with an energy feedback-based adaptive restart-aware strategy that balances machine energy consumption and equipment longevity. The QMOMA employs an enhanced reference point-based NSGA-III for global search, while Q-learning adaptively selects multiple variable neighborhood search operators to further improve performance. Finally, the effectiveness of the model is verified using the CPLEX solver, and the performance of QMOMA is systematically evaluated by constructing fifty benchmark instances and applying it to eight real-world scheduling instances in manufacturing workshops for aviation composite materials, achieving an average improvement of 26.4 % and 22.8 %, respectively, which confirms its effectiveness and practicality.}
}
@article{MANICKAM2026114438,
title = {Leveraging latent space representations for accurate wind power prediction},
journal = {Applied Soft Computing},
volume = {188},
pages = {114438},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114438},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501751X},
author = {S. Manickam and D. Kesavaraja},
keywords = {FA-PLS-MANN, Feature Selection, Memory Augmented Neural Network, Probabilistic Latent Space Model, Wind power prediction},
abstract = {The increasing reliance on renewable energy sources like wind power necessitates accurate prediction capabilities for efficient grid integration. This research proposes a novel deep learning approach that combines probabilistic latent space model and memory augmented neural networks for improved wind power prediction. The proposed Feature-Augmented Probabilistic Latent Space and Memory Augmented Neural Network (FA-PLS-MANN) model implements a probabilistic latent space model to perform dimensionality reduction on the high-dimensional wind speed and direction time series data, thereby deriving a low-dimensional, semantically meaningful latent representation. These latent space captures the most significant features influencing wind power generation which are subsequently fed into a memory augmented neural network, capitalizing on its strengths in time series forecasting. The Spatial Dynamic Wind Power Forecasting (SDWPF) dataset, obtained from the Baidu KDD CUP 2022 challenge and released by Longyuan Power Group is used for experimental analysis. Experimental results demonstrate that FA-PLS-MANN achieves an RMSE of 0.026, MAE of 0.024, and an R² score of 0.986, significantly outperforming models like VAE-ConvLSTM and Bayesian BiLSTM-VAE. Additionally, FA-PLS-MANN reduces training time by 15 % due to its feature selection and latent space compression techniques. These advancements improve forecasting accuracy, computational efficiency, and generalizability, making the model highly suitable for real-time wind farm management, grid stability, and energy market operations.}
}
@article{ZHANG2026114405,
title = {Unraveling incomplete multiview data: An information-theoretic framework},
journal = {Applied Soft Computing},
volume = {188},
pages = {114405},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114405},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017181},
author = {Qi Zhang and Mingfei Lu and Jingmin Xin and Badong Chen},
keywords = {Incomplete multiview learning, Information bottleneck, Matrix-based rényi’s -order entropy functional},
abstract = {Multiview learning can exploit complementary information from multiple sources, but its effectiveness is often limited by missing views. A central challenge is to distinguish shared information across views from view-specific variations, since treating them as a single representation introduces noise and weakens generalization. To tackle this problem, we propose an information-theoretic framework that explicitly separates consistent and view-specific components. The shared representation captures essential cross-view dependencies, while unique information is retained for each view. An information bottleneck strategy further compresses both components to keep the most relevant features and reduce redundancy. For estimation, we employ a matrix-based Rényi’s α-order entropy functional, which allows direct optimization without variational approximations. Extensive experiments on eight real-world datasets demonstrate that our method consistently outperforms state-of-the-art baselines, with the advantage becoming more pronounced as the missing rate increases. Moreover, ablation studies confirm that each component—shared information, view-specific information, and the information bottleneck—is indispensable, and removing any of them results in a performance drop. In conclusion, explicitly modeling both shared and view-specific information within an information-theoretic framework provides a principled, robust, and generalizable solution for incomplete multiview learning. Code is available at https://github.com/archy666/UIMD.}
}
@article{ONYEKWENA2026114494,
title = {Hybrid data-driven cement-stabilized soil design: An integration of machine learning, multi-objective optimization, and life cycle assessment},
journal = {Applied Soft Computing},
volume = {188},
pages = {114494},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114494},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018071},
author = {Chikezie Chimere Onyekwena and Yunli Li and Ikenna J. Okeke and Ubani Obinna Uzodimma and Monday U. Okoronkwo and Wenping Wu},
keywords = {Soil stabilization, Machine learning, Multi-objective optimization, Unconfined compressive strength, Life cycle assessment},
abstract = {Soil stabilization is crucial in geotechnical engineering, yet conventional methods are often time-consuming, resource-intensive, and environmentally unsustainable. Despite growing interest in Machine Learning (ML) and optimization tools for mix design, few studies integrate these methods with decision-making techniques and environmental assessment to support practical implementation. This study proposes a hybrid data-driven framework for predicting strength, optimizing mix compositions, and evaluating environmental impacts via life cycle assessment of cement-stabilized soft soils. Six ML models were evaluated, and the top-performing eXtreme Gradient Boosting (XGB) model was further improved using the Grey Wolf Optimizer (GWO). The optimized XGB-GWO model, integrated with a polynomial cost function, served as the objective function in a multi-objective optimization problem solved via the Non-Dominated Sorting Genetic Algorithm II (NSGA-II), with final mix selection guided by the entropy-weighted TOPSIS method. Validation through a case study produced mix designs offering superior strength-cost trade-offs, with the optimal mix achieving 2243.2 kPa unconfined compressive strength and a 16.07 % reduction in carbon emissions compared to the highest-cost design. This study offers a sustainable, scalable approach to soil stabilization and supports informed decision-making in construction.}
}
@article{XU2026114404,
title = {Real-time location technology of hydrogen energy storage and transportation leakage based on self-attention mechanism group},
journal = {Applied Soft Computing},
volume = {188},
pages = {114404},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114404},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501717X},
author = {BIAN Xu and HUANG Xin-jing and LIU Tong and LIU Hai-bin},
keywords = {Hydrogen energy, Leakage, Location, Storage and transportation, Self-attention},
abstract = {In order to meet the requirement of real-time leakage location during hydrogen energy storage and transportation, the theoretical model of guided wave field induced by hydrogen leakage in the device wall is studied and discussed. According to the characteristics of data time domain, multi-head self-attention group (MSAG) is constructed by using multi-head self-attention model to fully explore the multi-time scale dependency in the data. Then the Convolutional Neural Network (CNN) model is used to mine the spatial distribution information of the wave field, and the high-precision location of the leakage source is successfully realized. Distinguished from other methods, this method does not depend on the hydrogen diffusion model. Besides, it is capable of detecting and precisely locating hydrogen leakage at any period, even at the initial stage of leakage formation, with higher monitoring sensitivity and accuracy. The experimental results show that the absolute distance error is less than 0.0266 m and the absolute angle error is less than 0.0348 rad on the 1 m2 test plate completely covered by the stiffening plate, which is about 3 and 4 times higher than the existing method, respectively.}
}
@article{MAHMUD2026114498,
title = {A comprehensive review on multi robot task assignment and path planning: Operational constraints, challenges, and potentials of deep reinforcement learning},
journal = {Applied Soft Computing},
volume = {188},
pages = {114498},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114498},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018113},
author = {Suaib Al Mahmud and Azhar Mohd Ibrahim and Mazbahur Rahman Khan},
keywords = {Multi Robot Systems, Task Assignment, Path Planning, Constraints, Challenges, Deep Reinforcement Learning},
abstract = {Task allocation and path planning are two highly focused areas in the arena of Multi Robot Systems (MRS) due to their versatile applications. Whether they are treated separately or in conjunction, the operational constraints play a critical role on their performance. This paper presents a comprehensive review on task assignment and path planning of MRS by dedicating a specific focus on operational constraints, and explores the potentials of Deep Reinforcement Learning (DRL) to address them. A detailed insight into formulation and scheme characterization of Multi Robot Task Allocation (MRTA) problems is presented with an extensive review on the solution techniques of task allocation and path planning, among which the learning-based approaches (particularly DRL) were found to be providing notable advantages over traditional ones. The operational constraints are systematically categorized and challenges appearing alongside them are identified. Furthermore, the paper pinpoints existing research gaps in this regard, and ventures into discovering ways to bridge them using state-of-the-art DRL training algorithms, techniques, frameworks, and concepts, which also expose significant potential and research avenues for MRS. Additionally, the computational resources and accelerators for DRL are discussed to appreciate the real-world deployment of DRL-based MRS. Thus, the paper establishes a benchmark for advancing the swift autonomy of MRS.}
}
@article{YAN2026114364,
title = {Chinese medicine prescription optimization using evolutionary algorithms},
journal = {Applied Soft Computing},
volume = {188},
pages = {114364},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114364},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016771},
author = {Jia-Yu Yan and Peng-Wei Zhang and Mumtaz Karatas and Jun-Xun Gao and Li Li and Yu-Jun Zheng},
keywords = {Chinese medicine (CM), Herbal prescription, Therapeutic evaluation, Combinatorial optimization, Evolutionary algorithms (EAs)},
abstract = {Formulating a prescription consisting of functionally synergistic or complementary herbal medicines to treat the syndromes of a given patient is a core therapeutic method in Chinese medicine (CM). However, the process largely depends on the subjective experiences and preferences of CM physicians, and hence can be improved through optimization. In this paper, we formulate the problem of Chinese medicine prescription optimization as a combinatorial optimization problem based on a novel prescription evaluation model, which incorporates CM expert knowledge to comprehensively and quantitatively evaluate herb-syndrome effects, herb-herb interactions, prescription-syndrome effects, and prescription-patient effects. We adapt a collection of popular evolutionary algorithms (EAs) to solve this optimization problem. Our numerical results on a wide set of real-world patient records demonstrate that the EAs can produce personalized prescriptions that have better effects than those created according to the common formulation process of CM physicians.}
}
@article{XIE2026114401,
title = {A hybrid three-way recommendation with demographic data based on intuitionistic neighborhood},
journal = {Applied Soft Computing},
volume = {188},
pages = {114401},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114401},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017144},
author = {Yu Xie and Jilin Yang and Jian Wang and Xianyong Zhang},
keywords = {Hybrid recommendation, Atanassov intuitionistic fuzzy sets, Three-way decision, Intuitionistic neighborhood, Personalized rules},
abstract = {Hybrid recommender systems leverage various types of data sources to improve performance. However, when dealing with heterogeneous data, the existing methods often fail to accurately depict the uncertainties in user similarity and provide insufficient personalized recommendations, thereby affecting the effectiveness of recommendations. To address these challenges, we propose a Hybrid Three-way Recommender system with Demographic information (DHTR) based on intuitionistic neighborhood to formulate personalized three-way rules. Specifically, the demographic and rating data are first integrated to construct a hybrid information table. Then, Atanassov intuitionistic fuzzy sets are introduced to establish the intuitionistic neighborhood of user similarity, thereby characterizing the uncertainty in neighborhood selection that cannot be captured by the “one-size-fits-all“ approach. Next, the dual and single evaluations are employed to define positive, negative, and possible similar users, with preferences obtained through granular computing. Finally, a three-way decision model incorporating user variability is presented to generate personalized rules, accurately capturing the cost-sensitive nature of recommendations. Experiments on three public datasets demonstrate the superior performance and flexibility of the proposed DHTR, which effectively handles datasets with varying degrees of sparsity.}
}
@article{SHIRALI2026114490,
title = {Fractional-order fuzzy reinforcement learning-based load frequency controller},
journal = {Applied Soft Computing},
volume = {188},
pages = {114490},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114490},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018034},
author = {Siavash Shirali and Hadi Delavari},
keywords = {Micro-grid, Load frequency control, Proportional-Integral-Derivative, Fuzzy, Fractional order, Reinforcement learning},
abstract = {A new intelligent fractional-order controller based on a fractional-order fuzzy reinforcement learning algorithm is introduced in this paper for a micro-grid experiencing load and generation variations, especially when the system exhibits nonlinear generation behaviors. Energy systems are continuously evolving, and the integration of intermittent power sources improves network performance. These intermittent sources, however, create disturbances in tie-line power and frequency balance. Optimizing fractional-order proportional-integral-derivative parameters enhances controller efficiency. In this study, a reinforcement learning algorithm is used for dynamic and adaptive optimization of FOPID parameters, while fractional-order fuzzy logic is employed to define the reward function. This approach increases the controller’s degrees of freedom, long-term memory, and robustness against noise and environmental disturbances without requiring an accurate system model, providing a more precise and flexible system response compared to classical reward methods. Moreover, the fuzzy reward system has been optimized using the PSO algorithm. This intelligent controller is evaluated against other AI techniques, including Particle Swarm Optimization, Genetic Algorithm, and the TD3 reinforcement learning method, to assess their effectiveness in mitigating frequency and power disturbances in the interconnection line. Simulation results for different scenarios show that the intelligent approach outperforms existing methods in handling load and generation variations, particularly under nonlinear generation conditions. Furthermore, in scenario 2, it improves the Integral Time Square Error by 30.2 % over PID_TD3 and by 63.2 % and 57.5 % over PID_PSO and PID_GA, respectively.}
}
@article{KHOKHAR2026114393,
title = {UIStore: A secure encryption framework for underwater images based on hybrid chaotic dynamics and metaheuristic optimization},
journal = {Applied Soft Computing},
volume = {188},
pages = {114393},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114393},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017065},
author = {Prateek Khokhar and Jatin Bedi and Shalini Batra},
keywords = {Acoustic communication, Chaotic encryption, Particle swarm optimization, Underwater image security, Visual data confidentiality},
abstract = {The proliferation of underwater imaging technologies has resulted in extensive visual datasets that demand secure storage and reliable transmission under stringent resource constraints. Preserving data integrity and operational efficiency in submerged environments is challenging, and existing approaches fail to provide an integrated solution for robust protection and optimized localized storage. To address this gap, we devised UIStore, a dual-stream architecture designed for secure encryption and efficient marine image storage. The method employs Contrast-Limited Adaptive Histogram Equalization (CLAHE) to improve local contrast and visibility, followed by Nonsubsampled Shearlet Transform (NSST) decomposition to retain multiscale and multidirectional structural features essential for encryption. A dynamic cryptographic key is generated through the Henon chaotic map, while encryption utilizes Lorenz chaotic dynamics. Control parameters for both key generation and encryption are optimized via meta-heuristic optimization to expand the key space, enhance computational performance, improve storage efficiency and strengthen cryptographic resilience. Extensive experimental evaluation confirms that UIStore exhibits strong resistance to statistical inference, image distortions and differential attacks while preserving visual fidelity. Overall, UIStore constitutes a scalable, resource-efficient and resilient solution tailored to the operational constraints typical of underwater imaging platforms, advancing secure processing and reliable transmission of submerged visual data.}
}
@article{WANG2026114445,
title = {CARR: Camera-aware reciprocal refinement for unsupervised visible-infrared person re-identification},
journal = {Applied Soft Computing},
volume = {188},
pages = {114445},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114445},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017582},
author = {Jin Wang and Hongyang Fu and Liyun Dou},
keywords = {Visible-infrared, Person re-identification, Unsupervised learning},
abstract = {Unsupervised visible-infrared person re-identification (US-VI-ReID) aims to achieve cross-modal identity matching without manual annotations. Existing methods often overlook camera domain variations within the same modality, where images of the same person exhibit differences in lighting, background, and viewpoint. Treating these as equivalent intra-class samples hinders the generation of high-quality pseudo-labels. Moreover, current cross-modal clustering methods primarily rely on fixed similarity thresholds or one-time matching, lacking bidirectional iterative optimization. Such static matching strategies fail to fully exploit complementary information across modalities and are prone to incomplete mappings and error accumulation, limiting the effectiveness of cross-modal feature learning. To address these issues, we propose a Camera-Aware Reciprocal Refinement (CARR) framework that addresses camera and modality discrepancies through two key modules. The Camera-Aware Neighborhood Purification (CANP) module handles camera domain shifts and improves clustering quality using differentiated intra-camera and inter-camera neighbor search strategies. The Reciprocal Centroid Refinement (RCR) module replaces static matching with bidirectional iterative centroid optimization, reducing inaccuracies in cross-modal correspondences. Extensive experiments on standard datasets demonstrate that CARR achieves significant performance improvements over state-of-the-art methods.}
}
@article{NOORI2026114506,
title = {Contrastive learning with transformers for meta-path-free heterogeneous graph embedding},
journal = {Applied Soft Computing},
volume = {188},
pages = {114506},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114506},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018198},
author = {Azad Noori and Mohammad Ali Balafar and Asgarali Bouyer and Khosro Salmani},
keywords = {Heterogeneous graph embedding, Self-supervised learning, Multipartite graphs, Transformers, Multi-head attention},
abstract = {Heterogeneous graph embedding aims to convert complex, real-world networks into simplified, low-dimensional vector representations, while preserving their rich structural and semantic relationships. Traditional methods often rely on predefined meta-paths to represent node connections. However, these meta-paths can be numerous, demand significant domain expertise, and frequently struggle to capture complex, multi-faceted relationships such as multiple actors collaborating on a single movie or authors jointly co-writing a paper. This paper introduces Contrastive Heterogeneous Graph Embedding with GNNs and Transformers (CHEGT), a novel contrastive learning framework specifically designed for heterogeneous graphs. CHEGT effectively captures both local and global structural features by combining the strengths of Graph Neural Networks (GNNs) and Transformers. It achieves this through a multi-head attention mechanism and a direct transformation of the heterogeneous graph into a multipartite graph. By eliminating the need for predefined meta-paths, our model can automatically discover intricate relationships within the graph. Furthermore, a unique sampling strategy, which leverages both structural and feature information, generates high-quality positive and negative pairs for contrastive learning. This comprehensive approach leads to a deeper understanding of both local and global patterns within complex graph data. Extensive experiments demonstrate that CHEGT significantly outperforms existing methods across various node classification and clustering benchmarks. This robust approach offers a promising direction for analyzing large-scale heterogeneous graphs and improving the accuracy of downstream tasks.}
}
@article{MAZLOOM2026114412,
title = {BARL: Batch active regression learning via query-by-committee with application to slope factor of safety prediction},
journal = {Applied Soft Computing},
volume = {188},
pages = {114412},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114412},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017259},
author = {Shayan Mazloom and Abdollah Shafieezadeh and Jieun Hur and Jae-Wook Jung and Jeong-Gon Ha and Daegi Hahm},
keywords = {Slope stability, Factor of safety (FoS), Batch-based active learning for regression (BARL), Query by committee (QBC), Machine learning, Surrogate model},
abstract = {Slope failure threatens critical infrastructure, requiring accurate yet efficient stability analysis for real-time monitoring and probabilistic decision-making. However, high-fidelity numerical simulations are computationally prohibitive for many-query applications, e.g., reliability analysis. While surrogate models offer an efficient alternative, they often lack accuracy and generalization across diverse geotechnical conditions. This paper introduces three key contributions to address these limitations. First, we propose Batch-Based Active Regression Learning (BARL), a novel active learning framework that extends the Query-by-Committee concept to regression tasks through a variance- and range-aware disagreement score. This new formulation quantifies predictive uncertainty and identifies the most informative samples for labeling. Second, to improve physical fidelity and generalization, our surrogate model incorporates often-overlooked parameters, namely soil saturation and porosity, and expands the input parameter space to cover a much broader range of slope geometries, initial conditions, and soil properties than those considered in prior studies. Third, we establish a new benchmark dataset derived from a high-fidelity computational model validated against a real-world landslide. This dataset is designed for regression, enabling direct prediction of continuous Factor of Safety (FoS) rather than classification. A committee of machine learning models trained with BARL demonstrated superior performance, achieving a 75 % reduction in test MSE, a 60 % reduction in test MAE, and a final test R2 of over 0.97. SHAP analysis confirmed physically consistent behaviors, establishing BARL as a robust, uncertainty-aware framework for developing accurate and efficient surrogate models for large-scale geotechnical risk assessment.}
}
@article{QU2026114388,
title = {Unsupervised anomaly detection for medical image classification using masked denoising autoencoder},
journal = {Applied Soft Computing},
volume = {188},
pages = {114388},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114388},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017016},
author = {Guangcan Qu and Haotian Pan and Chen Yang and Yezhi Lin},
keywords = {Anomaly detection, Medical image classification, Autoencoder, Masking technique},
abstract = {The application of artificial intelligence in medical image analysis is frequently hindered by the substantial cost of annotations. For diseases with low incidence rates, the imbalance between the number of cases and normal instances also presents a significant challenge to the efficacy of traditional algorithms. Unsupervised anomaly detection (UAD), which eliminates the need for labels or abnormal data during training, offers a promising solution to these issues. Consequently, we propose an advanced anomaly detection algorithm based on reconstruction techniques, termed the Masked Denoising AutoEncoder (Md-AE), for medical image classification. This approach leverages an autoencoder architecture with noise-augmentation techniques. We then introduce a masked convolution with a hybrid self-attention module, which amalgamates a channel-spatial self-attention mechanism to apply pixel-level weighting on feature maps, thereby enhancing the model’s learning capacity. Empirical results from two public datasets and one private dataset confirm that our method achieves superior classification performance. The outcomes on the private dataset underscore that UAD can be effectively employed for data that are indistinguishable by non-experts.}
}
@article{LUO2026114440,
title = {Style transfer image steganography based on GANs with frequency domain attention and autoencoder networks},
journal = {Applied Soft Computing},
volume = {188},
pages = {114440},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114440},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017533},
author = {Yuling Luo and Zhaohui Chen and Baoshan Lu and Yiting Huang and Qiang Fu and Sheng Qin and Junxiu Liu},
keywords = {Image steganography, Style transfer, Generative adversarial network, Frequency domain attention, Autoencoder},
abstract = {The rise of style transfer images on social media has created new opportunities for image steganography. However, existing methods often suffer from information leakage and low recovery accuracy. This paper proposes STIS-GAN, a style transfer-based image steganography framework that embeds secret information into stable mid- and low-frequency components through a Frequency-Domain Attention Module (FDAM). An autoencoder-based de-stylization network achieves high-fidelity recovery of hidden information by leveraging shallow texture and deep semantic features. Furthermore, a multi-loss training strategy is introduced to balance embedding fidelity, stylization quality, and recovery accuracy. Experiments conducted on LFW, ImageNet, and Pascal VOC datasets demonstrate that STIS-GAN outperforms state-of-the-art methods in both image quality and security. Against advanced steganalyzers such as SRNet and ZhuNet, the detection rates are 49.23 % and 53.22 %, respectively. These results indicate that STIS-GAN significantly enhances robustness against style-induced distortion and steganalysis, providing a practical solution for secure visual communication.}
}
@article{XIONG2026114435,
title = {A graph convolutional network for social user geolocation based on topics and social relationships},
journal = {Applied Soft Computing},
volume = {188},
pages = {114435},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114435},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501748X},
author = {Wei Xiong and Xue Ouyang and Jiayuan Gao},
keywords = {Social network, Text topic, Isolated user, Graph neural network, Home location, Topic similarity, Geolocation prediction},
abstract = {Geolocation inference is a critical issue for location-based applications, including natural disaster monitoring, flu trend prediction, and targeted advertising. However, social networks often provide sparse and unreliable location information, posing significant challenges for existing location inference methods. To address these limitations, we introduce a novel home location inference model, the Social Relationship-based Graph Convolutional Network (SRGCN), which integrates textual topics and graph neural networks (GNNs) to effectively capture social relationships. SRGCN first extracts hybrid features from text using TF-IDF to generate textual feature vectors and constructs an initial social relationship graph based on user mentions. Then, a topic model is employed to establish connections among isolated users, thereby enhancing the graph structure. Finally, we leverage graph convolutional neural networks to process the SRG and jointly model textual features and network structure for accurate geolocation prediction. Using the GeoText dataset, we assess the impact of topic similarity thresholds on performance and graph size. Results show that SRGCN aggregates same-class user nodes, increases the number of locatable users, and preserves association diversity. It outperforms existing methods like MENET and GCN4Geo in error metrics and accuracy, achieving a 1.0 % accuracy improvement and a 2.9 % average error reduction over GCN4Geo. By linking isolated users through topic similarity, SRGCN enriches the social relationship graph and significantly improves location inference accuracy.}
}
@article{WANG2026114432,
title = {Novel computing method for uncertainty-aware fault diagnosis of rotating machinery based on image processing and interval theory},
journal = {Applied Soft Computing},
volume = {188},
pages = {114432},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114432},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017454},
author = {Chen Wang and Xin Qiang and Chong Wang},
keywords = {Rotating machinery, Image-processing fault diagnosis, Interval theory, Euclidean distance-based pattern matching, Feature weighting optimization},
abstract = {Traditional image processing-based fault diagnosis methods for rotating machinery often exhibit limited accuracy in the presence of uncertainty factors such as sensor errors. To address this limitation, this study proposes a novel interval theory-based fault diagnosis method integrating a weighting distribution strategy. Based on high-dimensional images transformed from vibration signals, a time-frequency imaging-based feature extraction method integrating histogram of oriented gradients (HOG) and principal component analysis (PCA) is developed to extract representative features. To characterize the dispersion in fault features induced by uncertainty factors, an interval-formed feature is further established and a Euclidean distance-based pattern matching strategy is proposed to quantitatively measure the severity of unknown modes. Considering the indeterminate classification outcomes caused by inaccurate features, an interval Fisher feature weight distribution (IFFWD) method is developed to prioritize discriminative features by optimizing between-class scatter against within-class scatter. Three case studies have validated the competitive diagnostic performance and robustness of the proposed methods in dispersion-intensive environments compared to conventional methods.}
}
@article{CHEN2026114383,
title = {A duality-preserving fuzzy maximum flow framework using linear ranking: A scalable soft computing approach},
journal = {Applied Soft Computing},
volume = {188},
pages = {114383},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114383},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016965},
author = {Shih-Pin Chen and Mei-Chun Ho},
keywords = {Duality, Fuzzy set, Maximum flow, Network optimization, Subjective uncertainty},
abstract = {This paper presents a duality-preserving and practically oriented framework for solving fuzzy maximum flow problems under subjective uncertainty, which is essential in fields such as the Internet of Things (IoT) and intelligent transportation systems. Rather than merely defuzzifying fuzzy arc capacities and solving a crisp approximation, or using α-cut decomposition, the proposed method is grounded in ranking theory and linear programming (LP) duality. We reformulate the fuzzy maximum flow problem such that uncertain arc capacities—originally embedded in the right-hand side of constraints—are transferred to the objective function coefficients in the dual model. This transformation enables the use of linear fuzzy ranking functions to select the most preferred solution from a set of fuzzy-valued flow totals. To preserve LP solvability, we restrict our ranking function to those satisfying additivity and positive homogeneity. Among these, Yager’s linear ranking index is adopted for its interpretability, theoretical soundness, and independence from membership function specification. The resulting crisp LP is solved using standard optimization tools. Numerical experiments show that the proposed model achieves a Yager ranking index that outperforms previous fuzzy approaches while preserving the consistency of the max–flow/min–cut theorem. In the real-world Jet Airways case, the proposed model provides the most likely value and the entire possible range of the maximum number of flights, confirming the accuracy and transparency of the model without the need for explicit membership functions. The framework offers a principled and scalable alternative for fuzzy optimization under subjective and linguistic uncertainty.}
}
@article{SAKPOONSUP2026114407,
title = {Real-time gesture recognition using Wi-Fi CSI: A CNN approach for multi-environment deployment},
journal = {Applied Soft Computing},
volume = {188},
pages = {114407},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114407},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501720X},
author = {Tanund Sakpoonsup and Attaphongse Taparugssanagorn},
keywords = {Non-Intrusive sensing, Gesture detection, Wireless signals, Channel state information, Machine learning},
abstract = {The rise of Internet of Things (IoT) devices has intensified the demand for seamless and privacy-preserving Human-Computer Interaction (HCI). Existing gesture detection approaches, while effective, are often constrained by privacy concerns, reliance on wearable devices or cameras, and sensitivity to environmental conditions. This study addresses these limitations by developing a robust, real-time hand gesture recognition system based on Wi-Fi Channel State Information (CSI). The proposed system applies comprehensive preprocessing, including subcarrier filtering, normalization, and noise reduction, to CSI data captured via low-cost Raspberry Pi hardware using the Nexmon tool. A Convolutional Neural Network (CNN) with transfer learning and regularization techniques is trained and evaluated on datasets from both Line-of-Sight (LoS) and Non-Line-of-Sight (NLoS) environments, enabling adaptability across diverse scenarios. Key amplitude and phase features are extracted to enhance classification performance. Experimental results show that the model achieves accuracy rates of 97 % in LoS and 93.3 % in NLoS conditions. The combined dataset yields a lower accuracy of 87.9 %, primarily due to the increased variability from merging LoS and NLoS data. The system demonstrates low latency, confirming its suitability for real-time applications. These findings highlight the feasibility of Wi-Fi CSI-based gesture recognition for deployment in domains such as smart homes, healthcare, and virtual reality. Future work will investigate transformer-based architectures and multi-modal data fusion (e.g., CSI with audio) to further improve robustness and generalization.}
}
@article{XUE2026114428,
title = {A process-oriented hesitant fuzzy linguistic decision field theory: Application to the selection of new energy vehicles},
journal = {Applied Soft Computing},
volume = {188},
pages = {114428},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114428},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017417},
author = {Wenting Xue and Senke Yao and Wuhui Lu and Zeshui Xu and Chonghui Zhang},
keywords = {Hesitant fuzzy linguistic term sets, Decision field theory, BoD method, New energy vehicle assessment},
abstract = {The new energy vehicle industry is thriving with high energy efficiency and environmentally friendly characteristics and how to select them is a significant comprehensive assessment problem. In the new energy vehicle assessment, decision-makers often encounter some qualitative evaluations which contain several adjacent linguistic terms; that is the hesitant fuzzy linguistic term set, to express their evaluations. The existing hesitant fuzzy linguistic decision-making methods are mainly result-oriented, which neglect the dynamic process of information processing. Therefore, we propose a process-oriented hesitant fuzzy linguistic decision field theory combining decision-makers' preference evolution processes. First, we introduce the benefit of the doubt (BoD) method which highlights the advantage indicator and maximizes the comprehensive score of each alternative to endow weights. Next, the decision field theory is extended to the hesitant fuzzy linguistic environment by incorporating normalized carbon emissions. The carbon emission-based preference and time constraint are integrated into the decision-making framework. Finally, the process-oriented decision-making method is applied to select the optimal new energy vehicle type. The effectiveness and robustness of the proposed method are validated through sensitivity analysis and comparative analysis.}
}
@article{FU2026114480,
title = {Deep learning-enabled fault diagnosis with vision transformers and domain-informed data augmentation for advanced quality control in semiconductor manufacturing},
journal = {Applied Soft Computing},
volume = {188},
pages = {114480},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114480},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017934},
author = {Wenhan Fu and Yuchun He and Xiaojun Liu and Chunyi Zuo},
keywords = {Semiconductor manufacturing, Fault diagnosis, Vision transformer, Deep learning, Data augmentation},
abstract = {As fabrication technologies continue to evolve toward finer nodes, the complexity of semiconductor manufacturing processes increases significantly, along with a heightened susceptibility to in-line defects and equipment failures. Addressing these challenges requires a systematic framework that integrates diagnostic intelligence with manufacturing domain knowledge to enhance fault identification and quality control. Despite recent developments in fault detection methodologies, practical limitations persist due to the insufficient integration of domain-specific characteristics and the limited availability of fault data in real-world scenarios. To bridge these gaps, this study proposes an intelligent fault diagnosis approach following the UNISON decision framework, leveraging vision transformer (ViT) for advanced quality control in semiconductor manufacturing. To mitigate the risks of model overfitting caused by imbalanced and sparse data, generative adversarial network (GAN) is employed to augment fault data by embedding domain-relevant process features. Additionally, a heterogeneous data transformation mechanism is proposed to convert one-dimensional data into two-dimensional image representations, thereby enriching feature diversity and enabling effective visual learning. These synthesized image data are then input into a ViT-based deep learning model for process output classification. An empirical study has been conducted on industrial semiconductor manufacturing datasets for validation. The results demonstrate that the proposed model achieves 99 % classification accuracy, highlighting its practical viability for intelligent fault identification and advanced quality control in semiconductor manufacturing.}
}
@article{QIAN2026114375,
title = {A deep generative framework for joint households and individuals population synthesis},
journal = {Applied Soft Computing},
volume = {188},
pages = {114375},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114375},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016886},
author = {Xiao Qian and Utkarsh Gangwal and Shangjia Dong and Rachel Davidson},
keywords = {Variational autoencoder (VAE), Transfer learning under distribution shift, Synthetic population, Joint individual-household inventory},
abstract = {Household- and individual-level sociodemographic data are critical for analyzing human and infrastructure interactions and informing policy. Yet, available data sources are limited: the American Community Survey microdata provides only samples at the public use microdata area, while census tract data contains only marginal distributions without dependencies. To bridge this gap, we develop a deep generative framework, transfer learning with variational autoencoder (TL-VAE), that produces synthetic populations with realistic household–individual and individual–individual relationships while matching tract-level distributions. The methodological contributions include (1) a new data structure for capturing household-individual and individual-individual relationships, (2) a transfer learning process with pre-training and fine-tuning steps to generate households and individuals whose aggregated distributions align with the census tract marginal distributions, and (3) a decoupled binary cross-entropy (D-BCE) loss function enabling distribution shift and out-of-sample records generation. Model results for an application in Delaware, USA, demonstrate the ability to ensure the realism of generated household-individual records and accurately describe population statistics at the census tract level compared to existing methods. Furthermore, testing in North Carolina, USA, yielded promising results, supporting the transferability of our method.}
}
@article{SHI2026114420,
title = {A memetic-branch-and-price algorithm with conflict-minimizing selection strategy for bus scheduling problem},
journal = {Applied Soft Computing},
volume = {188},
pages = {114420},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114420},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017338},
author = {Hongyi Shi and Xingquan Zuo and Gang Chen and Xinchao Zhao and Senyan Yang},
keywords = {Bus scheduling, Public transportation, Vehicle scheduling},
abstract = {The Bus Scheduling Problem (BSP) is a critical challenge in public transit systems. While many metaheuristic approaches offer high computational efficiency for large-scale problem instances, they often sacrifice solution quality, particularly in terms of bus utilization, by favoring speed over solution quality. In this paper, we propose a Memetic-Branch-and-Price (MBP) algorithm to address BSP in real-world scenarios, aiming to enhance bus utilization while maintaining computational tractability. First, a Memetic Algorithm (MA) is used to generate a high-quality initial scheduling solution that covers all trips, leveraging its ability to explore large solution spaces and avoid premature convergence. Next, we introduce a Conflict-Minimizing Selection Strategy to identify a subset of trips within this solution that holds high potential for further optimization. Finally, an exact Branch-and-Price (B&P) method is applied to refine this subset, significantly improving the overall schedule quality. MBP is evaluated on real-world data from the Qingdao bus company. Experimental results indicate that MBP produces schedules with improved bus utilization and cost efficiency, while outperforming standalone MA and B&P methods in both solution quality and runtime.}
}
@article{JALLOW2026114448,
title = {Multi-user quantum key distribution with deep Q networks for secure routing},
journal = {Applied Soft Computing},
volume = {188},
pages = {114448},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114448},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017612},
author = {Lamarana Jallow and Majid Iqbal Khan},
keywords = {Deep q networks, Multi-user QKD, Quantum conference key distribution, Quantum routing algorithms, Quantum secure communication},
abstract = {The fundamental challenge in scalable multi-user quantum key distribution (QKD) networks lies in maintaining unconditional security while efficiently managing key requests across a large scale with the presence of untrusted nodes. Traditional quantum key distribution protocols like BB84 work well with point to point communication. Existing multi-user approaches such as quantum conference key distributions rely on static path selection and often overlook quantum-specific constraints like fidelity and lack trust aware resource allocation. We propose QKQ-DQN, an architectural framework that utilizes Deep Q Networks using neural networks to approximate the action-value function, which helps it handle complex environments. Our solution integrates adaptive path selection in the routing capability with a routing scheme for path selection that advances from the static nature of quantum conference key distribution while considering the resource constraints of quantum networks. The DQN-driven method enhances the path selection and qubit allocations even with the existence of untrusted nodes and variable network conditions. In comparison to existing routing methods, we found an overall improvement of 18.2 % in successfully routed queries. In addition, even when network loads were increased, the model maintained end to end fidelity above 0.8. We also observed a reduction in qubit error rates of about 1.4 %, which is significant in producing enhanced security performance.}
}
@article{KUMAR2026114379,
title = {A deep Kolmogorov–Arnold Network framework for solving time–fractional partial differential equations},
journal = {Applied Soft Computing},
volume = {188},
pages = {114379},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114379},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016928},
author = {Yatin Kumar and Ramesh {Kumar Vats}},
keywords = {Deep learning, Artificial neural network, Kolmogorov–Arnold Network, Fractional calculus, Numerical analysis},
abstract = {Deep learning has emerged as a promising approach for the numerical solution of fractional partial differential equations, offering flexibility in approximating complex solution spaces. Conventional methods, such as feedforward neural networks (FNNs) or multilayer perceptrons, have been applied to such problems but often require numerous parameters and exhibit limited accuracy when handling fractional-order operators. To address these challenges, we adopt a novel deep learning framework, the Kolmogorov–Arnold Network (KAN), which serves as an alternative to traditional FNNs for solving fractional partial differential equations. The design of KAN is inspired by the Kolmogorov–Arnold representation theorem, enabling efficient functional representation through the composition of univariate transformations. The study explores two configurations of KAN, one employing B-splines and the other using Chebyshev polynomials. Preliminary numerical experiments on one-dimensional fractional problems demonstrate that both variants achieve improved accuracy compared to standard FNNs. The proposed framework’s performance is demonstrated using three numerical experiments, along with visual comparisons and summarized tables.}
}
@article{LI2026114468,
title = {An adaptive multi-head attention dynamic integration system for interval-valued wind speed prediction based on joint feature extraction and optimal model selection},
journal = {Applied Soft Computing},
volume = {188},
pages = {114468},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114468},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017818},
author = {Yaning Li and Jiawen Chen and Yanan Pan},
keywords = {Interval-valued wind speed prediction, Interpretable feature extraction, Reinforcement learning, Dynamic integration},
abstract = {Accurate wind speed prediction is crucial for integrating wind power into the grid and optimizing power dispatch to support the low-carbon transformation of energy systems. The non-stationary and stochastic nature of wind speed makes it difficult for traditional point and interval prediction methods to effectively quantify its uncertainty, whereas interval-valued prediction can provide richer information to characterize this uncertainty. To address the limitations of existing methods in terms of interpretability, model matching, and fixed integration weights, this paper proposes a novel interval-valued wind speed prediction system. The system comprises three modules: interpretable interval-valued collaborative feature extraction, intelligent model selection, and multi-head attention-based adaptive integration. First, an improved singular spectrum analysis (SSA) is applied for collaborative feature extraction, and feature expressions with clear physical meanings are constructed to achieve interpretable optimal feature extraction. Second, reinforcement learning is employed to adaptively select the best forecasting model, addressing the feature-model mismatch issue. Finally, a multi-head attention mechanism is introduced to learn correlations among components and achieve dynamic integration, overcoming the limitation of fixed weights in traditional ensemble methods. To verify the system performance, the experiment utilized data from three wind speed stations in Canada with a geographical span of over 3500 kilometers and distinct climatic characteristics, totaling 7671 data points for testing. The results show that the system reduces the mean square error (MSE) by approximately 27.25 % on average compared with the baseline model using complete ensemble empirical mode decomposition with adaptive noise - convolutional neural network - long-short term memory neural network (CEEMDAN-CNN-LSTM), significantly improving the prediction performance. This research provides an effective tool for uncertainty prediction under complex wind conditions and has technical support value for the operation scheduling of wind farms and the optimization of sustainable energy systems.}
}
@article{TAN2026114406,
title = {A discrete Keplerian optimization algorithm with Q-learning for human-robot collaborative partial disassembly line balancing problem},
journal = {Applied Soft Computing},
volume = {188},
pages = {114406},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114406},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017193},
author = {Zenan Tan and Shunsheng Guo and Jun Guo and Baigang Du and Kaipu Wang},
keywords = {Partial disassembly line balancing, Human-robot collaborative, Discrete Kepler optimization algorithm, Q-Learning},
abstract = {Driven by advancements in human–machine collaboration technology, waste recycling enterprises are increasingly pursuing innovative production methodologies. Nevertheless, in practical human–machine collaborative partial disassembly tasks, task variability, process uncertainty, and multi-objective conflicts persist, rendering existing approaches inadequate for balancing efficiency, economic performance, and energy consumption. To address these challenges, this paper introduces a discrete Kepler optimization algorithm integrated with Q-learning (QLS-KOA) to resolve the human–machine collaborative disassembly line balancing problem (HRC-PDLBP), with the objective of simultaneously optimizing load distribution, disassembly profit, and energy consumption. At first, a two-dimensional coding scheme is designed to transform the continuous Kepler optimization algorithm into a discrete form, thereby generating high-quality initial solutions well-suited to the problem’s characteristics. Then, a Q-learning based local search framework is proposed to dynamically adjust the proportion of four HRC-PDLBP-specific local search operators in response to variations in the solution state. Considering that the solution space of HRC-PDLBP can dynamically change with task attributes and constraints, a Q-learning local search framework is introduced to make the intelligent agents efficiently capture optimization directions, discover global optimal solutions, and avoid local optima in dynamic environments. Finally, comparative experiments on multiple benchmark instances indicate that QLS-KOA achieves higher solution accuracy, faster convergence, and better solution diversity than state-of-the-art algorithms, while simultaneously reducing energy consumption and improving disassembly profit. Furthermore, a real case study on Tesla Model S battery module confirms that QLS-KOA generates practical and efficient disassembly schemes, and demonstrates significant advantages in terms of overall performance, sustainability, and industrial applicability.}
}
@article{ZHAO2026114402,
title = {Multi-semantic fusion of heterogeneous graph neural network},
journal = {Applied Soft Computing},
volume = {188},
pages = {114402},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114402},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017156},
author = {Yufei Zhao and Shengen Xue and Xiaotong Li and Hua Duan},
keywords = {Heterogeneous graph neural network, Graph embedding, Graph representation learning, Semantic fusion},
abstract = {One of the key issues in the study of Heterogeneous Graph Neural Networks (HGNN) is how to handle the various types of nodes and edge relations contained within Heterogeneous Information Networks (HIN). Existing methods often segment HIN into multiple subgraphs with isolated semantics using meta-paths and aggregate them through specific enhancement methods. Under this approach, although different semantics are ultimately fused, the deficiencies of isolated semantics in the intermediate stages can lead to suboptimal final outcomes. To address this problem, we propose a novel heterogeneous graph neural network model named Multi-semantic Fusion Heterogeneous Graph Neural Network (MF-HGNN). MF-HGNN initially generates target node representations with diverse attributes through attribute reconstruction techniques. To avoid the issue of noise caused by redundant aggregation of attribute information between attribute nodes and target nodes in the original HIN, MF-HGNN introduces an “Attribute-Semantic Graph Generation Strategy” (ASGG), which transforms the original heterogeneous graph into a specific attribute-semantic graph (ASG) based on selected attribute nodes. It then learns the representation of the specific attribute-semantic graph through both attribute feature aggregation modules and semantic aggregation modules with attributes. Finally, a graph-level aggregation strategy is employed to fuse multiple ASGs to generate the final embedding. A large number of experiments have shown that MF-HGNN achieves better semi-supervised classification performance compared to the baseline models.}
}
@article{LIU2026114430,
title = {A novel gradient learning algorithm based on zero-order Takagi-Sugeno fuzzy model: the caputo fractional-order gradient descent},
journal = {Applied Soft Computing},
volume = {188},
pages = {114430},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114430},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017430},
author = {Yan Liu and Qiang Shao and Yuanquan Liu and Rui Wang},
keywords = {Fractional-order gradient algorithm, Caputo fractional-order derivative, Zero-order Takagi-Sugeno fuzzy model, Convergence analysis},
abstract = {Zero-order Takagi-Sugeno (TS0) fuzzy models are known for their robust interpretability and generalization capabilities, because they feature human-readable IF-THEN rules, semantically clear fuzzy sets, and inherent tolerance of fuzzy logic to uncertainty and imprecision. The TS0 model, based on traditional integer-order gradient descent methods, often struggles to capture the dynamic characteristics of complex nonlinear systems. Therefore, a novel Caputo fractional-order gradient descent method (FGDM) is presented for TS0 fuzzy models, aiming to accelerate convergence and enhance classification accuracy. This paper rigorously validates both the weak and strong convergence of the proposed method through theoretical analysis. The proposed FGDM demonstrates considerable improvements in both training and testing performance across a variety of tasks, including approximation, classification, and regression. These findings illustrate the potential of FGDM to enable broader and more effective applications in fuzzy systems.}
}
@article{PARAMESH2026114422,
title = {Obstacle detection and autonomous ground vehicle navigation using Intelligent Deep Learning-based Swarm (IDLS) model},
journal = {Applied Soft Computing},
volume = {188},
pages = {114422},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114422},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017351},
author = {G. Paramesh and G. Arulkumaran},
keywords = {Autonomous ground vehicle, Obstacle detection, Navigation, Deep learning, Angular velocity},
abstract = {The task of developing an autonomous vehicle that can be safely navigated in open situations is very high. It requires automatic on-road obstacle recognition, categorization, and ranging. Due to issues with object overlap, dynamic obstacles and accurate depth estimate, traditional approaches (YOLOv4 + EfficientDet, DeepSort, Vision Transformers) make it difficult to provide a reliable solution for autonomous ground vehicle navigation. Through a variety of sensors and vehicle-to-vehicle (V2V) technologies, autonomous cars may gather data on their leading vehicles and forecast their future behaviour, enhancing road safety and mobility. The most important and challenging tasks for an limitations when the modality of data gathering changes and are quite computationally costly. A primary obstacle in autonomous vehicle navigation (AVN) is enabling a vehicle to determine its course while travelling with less computational complexity. autonomous ground vehicle monitoring system are vehicle detection and classification. Conventional approaches have To overcome this challenge, an Intelligent Deep Learning-based Swarm framework is suggested to develop Autonomous Ground Vehicle Navigation with Obstacle detection. Here, the Convolutional Neural Network (CNN), Improved Artificial Fish Swarm Algorithm (IAFSA), and Extreme Gradient Boosting (XGBOOST) algorithm are used for obstacle detection, predicting the performance of vehicle trajectory in an autonomous environment, preventing overfitting, predicting optimal path, solves navigation problem. The Adaptive Neuro-Fuzzy Inference technique with an Intelligent Deep Learning Swarm (IDLS) model is a potential approach to reduce uncertainty, boost adaptability, and create safer and more dependable autonomous driving systems for obstacle detection in autonomous vehicle development. This method also improves navigation efficiency, enhances recognition accuracy, and reduces computational costs. The Python Simulink software package has been utilized to conduct the simulation trials. Based on simulation results, the suggested approach has identified lanes with 97.93 % accuracy and a processing time of 0.0020 s. In contrast to conventional methods like, YOLOv4 + EfficientDet, DeepSort, Vision Transformers, the suggested method for obstacle detection has an accuracy of 81.91 % and requires 0.021 s to process.}
}
@article{SRUTHI2026114441,
title = {A novel framework for phishing attack detection using domain-adapted GloVe embeddings and attention-enhanced neural sequence model},
journal = {Applied Soft Computing},
volume = {188},
pages = {114441},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114441},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017545},
author = {K. Sruthi and S. {Manohar Naik}},
keywords = {Cyber security, Deep learning, Phishing attack, GloVe Embeddings, Attention-Based BiLSTM},
abstract = {Phishing attacks have evolved into sophisticated cyber threats, causing catastrophic financial and reputational damage. Malicious URLs, often disguised as legitimate ones, are the primary vectors for these attacks. Current phishing detection systems suffer from two fundamental limitations: reliance on handcrafted features limits adaptability to evolving phishing techniques, while deep learning approaches exhibit inadequate semantic understanding of URL structures and produce sparse feature representations that degrade detection performance. This paper presents a novel phishing URL detection framework that integrates domain-adapted Global Vectors (GloVe) embeddings with attention-enhanced bidirectional sequence modeling. The framework contributes two key innovations: a cybersecurity-specific GloVe embedding model trained on specialized URL corpora to address sparse feature representations in malicious URL detection, and an attention-enhanced bidirectional LSTM architecture that dynamically identifies discriminative sequential patterns in URL structures. Comprehensive evaluation demonstrates superior performance, achieving 99.82 % accuracy and 99.84 % F1-score, significantly outperforming state-of-the-art methods. The K-fold cross-validation further demonstrates the consistent performance of the proposed model. This research establishes a new performance benchmark in automated phishing detection and advances natural language processing applications in cybersecurity.}
}
@article{LIU2026114315,
title = {Multi-scale implicit diffusion model with high-frequency uncertainty guidance and global structure consistency},
journal = {Applied Soft Computing},
volume = {188},
pages = {114315},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114315},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501628X},
author = {Yuanfeng Liu and Shibai Yin and Ivan V. Bajić},
keywords = {Super-resolution, Diffusion model, High-frequency feature, Uncertainty map, Regularization},
abstract = {Single image super-resolution (SISR) plays a critical role in enhancing visual quality for applications such as facial recognition and scene reconstruction. Existing SISR methods have achieved remarkable performance, but they often struggle to recover fine image details. In contrast, diffusion models (DMs) offer a probabilistic generative framework that progressively restores high-frequency details through iterative refinement while naturally modeling the uncertainty inherent in the SISR process. This characteristic inspires our exploration of applying DMs to SISR, yet their direct use remains challenging due to inherent limitations. Specifically, traditional DMs rely on simple low-resolution (LR) inputs that lack effective degradation-aware priors, preventing the model from being properly guided toward believable solutions under complex real-world degradations. In addition, SISR is inherently uncertain, as single LR images may correspond to multiple plausible high-resolution (HR) reconstructions, and the stochastic reverse denoising process in DMs further amplifies this solution diversity, often producing unstable outputs. To address these limitations, we propose the MSIDM-HFUGS, a Multi-Scale Implicit Diffusion Model with High-Frequency Uncertainty guidance and Global Structure consistency for SISR. Specifically, we design a frequency-aware deep feature representation (FDFR) network to generate diverse degradation-aware priors from simple LR inputs, providing robust guidance to the diffusion process and enabling convergence toward plausible HR reconstructions under complex real-world degradations. We further design a frequency-domain consistency module (FDCM) that aligns the degradation-aware priors with the HR images in the frequency domain, ensuring that they remain consistent and within a reliable range. We then design a high-frequency uncertainty structure (HFUS) that generates high-frequency uncertainty maps highlighting ambiguous regions such as edges and details. Acting as adaptive weights during reverse denoising, high-frequency uncertainty maps drive the model to focus on challenging areas, which effectively narrows the range of plausible reconstructions and thereby constrains the solution space. We further propose a global structure-aware regularization (GSAR) that aligns intermediate features with the HR images at the patch-cluster level, reinforcing global structural fidelity and thereby mitigating the overfitting risk introduced by HFUS’s emphasis on local challenging areas. Extensive experiments on benchmark datasets demonstrate that our method surpasses state-of-the-art approaches and achieves superior visual fidelity, while also exhibiting enhanced generalization to diverse degradation scenarios.}
}
@article{ZHENG2026114409,
title = {Enhancing adversarial transferability by resolving gradient conflicts in multi-input transformations},
journal = {Applied Soft Computing},
volume = {188},
pages = {114409},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114409},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017223},
author = {Desheng Zheng and Ye Tian and Yong Zhou and Yaoxin Duan and Fan Min and Wuping Ke},
keywords = {Adversarial examples, Transfer-based attacks, Input transformations, Gradient consistency, Two-phase framework},
abstract = {Adversarial examples mislead deep neural networks via imperceptible image perturbations. Their transferability enables successful attacks on unseen models, providing an attack-based view of robustness. Transformation-based input attacks enhance transferability by applying semantics-preserving transformations to generate multiple transformed copies and updating the perturbation under them, iteratively yielding more generalizable examples. Recent work composes multiple semantics-preserving transformations in parallel per iteration to enlarge the diversity of gradient directions by viewing the input under different transformations and surrogate models. However, fusing branch gradients often causes conflicts that attenuate the dominant direction, misdirect updates, and overfit the surrogate, degrading transfer. Although composite transformations preserve efficacy across views and scales, such conflicts remain a central bottleneck. To retain diversity while resolving conflicts, we propose a two-phase framework: Phase I aggregates gradients from transformed copies to build a composite momentum aligned with cross-model sensitive directions; Phase II restarts from the clean input, inheriting this momentum and reinforcing the dominant direction to iteratively refine the perturbation for higher cross-model success. Experiments demonstrate consistent gains over strong baselines on ImageNet across CNN and transformer architectures, sustained effectiveness against representative defenses, successful cross-dataset evaluation on CIFAR-10 without retuning, and strong generalization to real-world multimodal platforms.}
}
@article{FISZEDER2026114384,
title = {Identification of Bitcoin volatility drivers using statistical and machine learning methods},
journal = {Applied Soft Computing},
volume = {188},
pages = {114384},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114384},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016977},
author = {Piotr Fiszeder and Witold Orzeszko and Radosław Pietrzyk and Grzegorz Dudek},
keywords = {Cryptocurrency volatility, Market and policy uncertainty, Random forest, LASSO, Bayesian model averaging, HAR, Google trends attention, Trading volume},
abstract = {This study advances the understanding of Bitcoin volatility forecasting by analysing an extensive set of 62 explanatory variables, including cryptocurrency market behaviour, Google search trends, financial indices, and economic indicators. We employ Bayesian Model Averaging (BMA), Least Absolute Shrinkage and Selection Operator (LASSO), and Random Forest (RF) methods to assess variable importance and forecast accuracy. Our research demonstrates that LASSO and RF models incorporating exogenous variables significantly improve both daily and weekly Bitcoin variance forecasts compared to models using only lagged Bitcoin volatilities. Key factors influencing Bitcoin volatility include lagged realised variances, trading volume, and Google search intensity. The study reveals that the impact of these variables on Bitcoin volatility is time-varying, reflecting its evolving relationship with broader economic indicators and market sentiment. Our findings contribute to the literature by providing a comprehensive analysis of Bitcoin volatility drivers, evaluating the effectiveness of variable transformations, and comparing the performance of advanced forecasting methods in handling the cryptocurrency's extreme volatility. These insights are valuable for researchers, investors, portfolio managers, and policymakers navigating the dynamic cryptocurrency market.}
}
@article{FAN2026114033,
title = {Convergence analysis of recurrent neural networks based on sparse mechanism and its application to time series and multiple classification problems},
journal = {Applied Soft Computing},
volume = {188},
pages = {114033},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114033},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625013468},
author = {Qinwei Fan and Lin Li},
keywords = {Recurrent neural networks, Gradient methods,  regularization, Smoothing approximations, Convergence},
abstract = {Recurrent Neural Networks (RNNs) are widely used for tasks involving sequential data due to their inherent temporal characteristics. This paper introduces an improved RNN model that employs L1/2 regularization to enhance the sparsity of the network and reduce overfitting. Unlike traditional L1 or L2 regularizers, the L1/2 regularization term provides a gradual weight compression, which simplifies the network structure. However, the non-convex and non-smooth nature of the L1/2 regularization term leads to numerical oscillations in numerical experiments. At the same time, this poses challenges for the theoretical analysis of the algorithm. To solve this problem, a smoothing approximation technique was applied to ensure stability during training. The convergence of the obtained algorithm was rigorously analyzed, proving weak and strong convergence of the network parameters. A large number of numerical experiments on benchmark datasets for time series prediction and multi-class classification demonstrated that the proposed model SL1/2-RNN outperformed traditional RNNs and their variants, achieving higher accuracy and a more compact network structure.}
}
@article{SANCHEZGOMEZ2026114352,
title = {Comment-based summarization using a multi-objective cuckoo search optimization approach},
journal = {Applied Soft Computing},
volume = {188},
pages = {114352},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114352},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016655},
author = {Jesus M. Sanchez-Gomez and Miguel A. Vega-Rodríguez and Sergio Santander-Jiménez},
keywords = {Multi-objective optimization, Swarm-intelligence algorithm, Cuckoo search, Comment-based summarization, Reader-aware summarization},
abstract = {In the digital era, user-generated content in the form of comments and discussions on online platforms has grown exponentially. This proliferation underscores the increasing significance of effective automatic methods for comment-based summarization. The goal of these methods is to generate a summary that covers the most important information from both source documents and user-generated content. In this work, the Comment-based Summarization problem has been addressed with a Multi-Objective Cuckoo Search algorithm (CSMOCS). The criteria of content coverage, comment relevance, and redundancy reduction have been formulated as the objective functions to be optimized. New problem-aware evolutionary operators have been proposed. Experiments have been conducted using the Reader-Aware Multi-Document Summarization (RA-MDS) dataset, and model performance has been evaluated with standard Recall-Oriented Understudy for Gisting Evaluation (ROUGE) metrics. In comparison to eighteen other methods from the literature, the proposed CSMOCS approach reports average percentage improvements of 25.08 % for ROUGE-1, 33.21 % for ROUGE-2, 20.75 % for ROUGE-L, and 29.03 % for ROUGE-SU4 scores. These results denote the ability of the proposal to automatically generate high-quality summaries taking into account user comments.}
}
@article{GUO2026114397,
title = {Model cooperation learning for multi-source domain generalization in medical image segmentation},
journal = {Applied Soft Computing},
volume = {188},
pages = {114397},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114397},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017107},
author = {Song Guo},
keywords = {Domain generalization, Medical image segmentation, Ensemble learning, Knowledge transfer, Style randomization},
abstract = {Multi-source domain generalization (MSDG) aims to build models capable of handling distribution shifts, a frequent challenge in medical imaging, by ensuring strong performance on previously unseen domains. Most existing methods focus on learning domain-invariant representations for decision-making, often overlooking domain-specific information that can also play a critical role. To leverage this, we introduce a model cooperation learning (MCL) framework that utilizes complementary domain-specific information for decision-making. Specifically, each segmentation model in MCL is trained on its corresponding source domain to capture domain-specific features. In addition, knowledge is transferred across models to enrich their understanding and enhance generalization capability. Finally, the output of MCL is obtained by aggregating outputs from all models, thus utilizing diverse domain-specific insights. Moreover, to further alleviate the domain gap, we introduce a style mixture and randomization (SMR) module, which can be integrated into the segmentation model, alongside the MCL. We evaluate our method on four representative medical image segmentation benchmarks: the optic cup (OC), the optic disc (OD), the retinal vessel, and the prostate. Experiments reveal that MCL consistently outperforms competing baselines, indicating its effectiveness. In particular, our method achieves improvements of 7.37 %, 7.90 %, 1.85 %, and 4.12 % in terms of average Dice score over empirical risk minimization (ERM) on the OC, OD, retinal vessel, and prostate segmentation tasks, respectively.}
}
@article{HUANG2026114376,
title = {GCDTA: Graph-attention-assisted contrastive learning for drug-target affinity prediction},
journal = {Applied Soft Computing},
volume = {188},
pages = {114376},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114376},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016898},
author = {Anqi Huang and Xiaoliang Zhou and Yupeng Wang and Ning Yu},
keywords = {Drug-target interaction, Interactive information extraction, Data fusion, Deep learning, Drug discovery},
abstract = {Accurately quantifying Drug–Target Affinity (DTA) remains a fundamental yet unresolved problem in computational pharmacology. Most existing approaches process drug and protein sequences independently and subsequently concatenate their embeddings in a rudimentary fashion, thereby neglecting both the atom-level topology of molecules and richer cross-modality feature interactions. To address these limitations, we propose a novel method called Graph-Attention-Assisted Contrastive Learning for Drug-Target Affinity Prediction (GCDTA). The key idea behind GCDTA is the integration of graph-based structural representations and contrastive learning, enhancing the expressiveness and discriminative capability of learned features. Specifically, GCDTA jointly leverages both structural and sequential information. Molecular graphs of drugs are encoded using Graph Attention Networks (GAT), effectively capturing atom-level topology and local chemical environments. Protein sequences are processed using dilated convolutional layers to capture long-range dependencies and extract essential sequential features. An interactive fusion module is then employed to systematically integrate information from both modalities, enabling more effective and fine-grained cross-modal interactions. Additionally, a tailored contrastive learning objective aligns structurally analogous drug-target pairs, enhancing the discriminative power and robustness of the unified embeddings. Extensive experiments on multiple public benchmark datasets demonstrate that GCDTA consistently surpasses current state-of-the-art models, establishing new performance baselines for DTA prediction.}
}
@article{KIRTI2026114348,
title = {Commentary on “Type-2 intuitionistic fuzzy matrix games based on a new distance measure: Application to Biogas-plant implementation problem” [Applied Soft Computing 106 (2021) 107357]},
journal = {Applied Soft Computing},
volume = {188},
pages = {114348},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114348},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625016618},
author = { Kirti and Tina Verma and Amit Kumar},
keywords = {T2IF sets, Distance measure, Similarity measure, Matrix games},
abstract = {Karmakar et al. (Appl. Soft Comput. 106 (2021) 107357) proposed a distance measure to evaluate the distance between type-2 intuitionistic fuzzy (T2IF) sets. For proving the validity of proposed distance measure; Karmakar et al. proved that their proposed distance measure satisfies the four necessary properties (bounded, reflexive, symmetric and transitive). Karmakar et al. also proposed a similarity measure, based upon the proposed distance measure, to measure the degree of similarity between two T2IF sets. Furthermore, based upon the proposed similarity measure, Karmakar et al. proposed a method to solve matrix games with T2IF payoffs. Finally, Karmakar et al. solved a real-life Biogas plant implementation problem in West Bengal, India by their proposed method. In this paper, it is pointed out that Karmakar et al. have used a mathematically incorrect result to prove the bounded property. In actual case, the bounded property is not satisfying for Karmakar et al.’s distance measure. Therefore, the distance measure, proposed by Karmakar et al., is not valid. Moreover, it is pointed out that T2IF sets corresponding to linguistic terms (Very high, High, Medium, Low, Very low), considered to solve real-life Biogas plant implementation problem in West Bengal, India, are not correct. Hence, the result of the real-life Biogas plant implementation problem, obtained by Karmakar et al., is not correct. Finally, for resolving the invalidity of Karmakar et al.’s distance measure, the required modification is suggested.}
}
@article{LI2026114437,
title = {Few-shot transformers for image classification using masked self-distillation and optimal tokens based global-local feature interactions},
journal = {Applied Soft Computing},
volume = {188},
pages = {114437},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114437},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017508},
author = {Binquan Li and Xin Guo and Lishuang Gong},
keywords = {Few-shot learning, Vision transformers, Self-supervised learning, Feature interaction},
abstract = {The advent of Vision Transformers (ViTs) has revolutionized the landscape of computer vision, achieving remarkable success across various tasks. However, their performance exhibits vulnerabilities in few-shot learning (FSL) contexts, where limited data availability can lead to overfitting and hindered efficacy. This challenge is further complicated by the class token’s tendency to prioritize global context, often at the expense of capturing critical local details. Moreover, the current approach of treating all tokens uniformly neglects the unique, discriminative power of individual tokens, subsequently causing a loss of vital information that is paramount for distinguishing between subtle features, particularly in fine-grained recognition tasks. To address these pressing issues, we introduce MSGL, a few-shot Transformer framework that employs masked self-distillation and a strategy for optimal token selection from different layers, filling gap between self-supervised and supervised Transformers in few-shot settings. This approach not only facilitates robust interactions between local and global features but also ensures that the most informative tokens are prioritized, thereby enriching the representation of multi-level information. Our method enhances the performance of few-shot Transformers by adeptly balancing global insights with local intricacies, allowing for superior differentiation among closely related sub-categories. It demonstrates improved performance across standard benchmarks and fine-grained datasets, with an increased capability to excel in one-shot learning scenarios.}
}
@article{UZUN2026114477,
title = {fiXAIt: A novel feature importance-based XAI tool for enhanced explainability, self-consistency, and computational efficiency},
journal = {Applied Soft Computing},
volume = {188},
pages = {114477},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114477},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017909},
author = {Selman Uzun and Gungor Yildirim},
keywords = {Explainable Artificial Intelligence (XAI), Feature-importance explainability, Dual-perspective attribution (FEI/FVI), Self-consistency metric, Auditing and risk-sensitive applications},
abstract = {This paper proposes fiXAIt, a post-hoc, model-agnostic framework for feature-importance explanation, designed with practical applications in mind, including healthcare, finance and risk management. The main idea is to separate effects that come from the presence of a feature from those that come from its actual value. For this purpose, we define two measures, Feature Existence Impact (FEI) and Feature Value Impact (FVI), and we add an internal Self-Consistency (SC) metric so that the explanations stay in line with the model’s behavior. In our experiments, SC was strongly associated with model stability (SC vs. CV-F1 Std r = −0.63). To ensure scalability, fiXAIt combines CBSFSA for targeted feature selection and ECFC for pruning redundant feature combinations. The framework was evaluated on five heterogeneous datasets and various classifier families, and models retrained on features selected by fiXAIt yielded test accuracies close to the corresponding full models. This shows that fiXAIt’s feature selection fidelity is aligned with model performance. In addition, fiXAIt performs significantly faster than SHAP. In tests, fiXAIt decreased the average explanation time from roughly 33.6 s to 18.6 s, which is about a 45 % improvement. These gains make it much easier to perform repeated analyses or to work with large-scale datasets. By delivering dual-perspective attribution, an internal reliability indicator and lower computational cost, fiXAIt provides a practical and reproducible XAI solution for risk-sensitive applications.}
}