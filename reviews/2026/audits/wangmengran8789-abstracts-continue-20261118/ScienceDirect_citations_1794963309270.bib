@article{YERLIKAYA2026114863,
title = {A novel framework for multi-objective optimization integrating persistent homology and graph-based learning: TAGON},
journal = {Applied Soft Computing},
volume = {195},
pages = {114863},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114863},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600311X},
author = {Mehmet Akif Yerlikaya and Hüseyin Beytüt and Osman Yiğid and Ömer Karabey and Kerim Özbeyaz},
keywords = {Multi-objective optimization, Bayesian optimization, Persistent homology, Graph neural networks, Knee-point detection, Topological data analysis},
abstract = {Multi-objective optimization in data-scarce engineering settings requires algorithms that can balance efficiency, structural awareness, and interpretability. This study introduces TAGON (Topology-Aware Graph-based Optimization Network), a novel framework that integrates persistent homology (PH), graph neural networks (GNNs), and Gaussian process regression (GPR) into a unified surrogate-assisted optimization strategy. Unlike conventional methods that rely on scalarization or hypervolume heuristics, TAGON explicitly extracts structural motifs from Pareto fronts using PH, identifies knee regions as decision-relevant trade-offs, and encodes this information through a motif-aware GNN. The resulting acquisition function is not an ad hoc weighted sum but a principled convex combination of scale-normalized terms knee proximity, motif saliency, and predictive variance with multi-knee aggregation via log-sum-exp. This design ensures both theoretical guarantees, including stability of PH-based knee localization and bounded convergence of acquisition maximization, and practical robustness. To evaluate its effectiveness, TAGON was validated in two complementary domains. On the synthetic benchmark KNO2, which contains multiple knee regions, TAGON achieved superior Pareto coverage and IGD+ compared to established baselines such as ParEGO and TSEMO. In an engineering case study on the geometric optimization of a Vortex Equal-Channel Angular Pressing (Vo-CAP) die, TAGON required only 69 finite element simulations to outperform NSGA-II and Taguchi-GRA, delivering 11% higher effective strain, 4% lower press load, and a normalized hypervolume of 1.07. These results confirm TAGON’s dual strength: robustness in knee-sensitive synthetic problems and efficiency in computationally expensive real-world applications. The framework thus represents a promising contribution to soft computing for multi-objective design and optimization.}
}
@article{WU2026115028,
title = {A two-stage three-way dynamic consensus approach for large-scale group decision-making in social networks with incomplete information and adjustment willingness},
journal = {Applied Soft Computing},
volume = {195},
pages = {115028},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115028},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600476X},
author = {Ting Wu and Xueling Ma and Dragan Pamucar and Jianming Zhan},
keywords = {Three-way decision, Social network, Incomplete information, Clustering method, Large-scale group decision-making},
abstract = {This study, grounded in computational intelligence, tackles critical challenges in large-scale group decision-making (LSGDM) by virtue of social networks under conditions of incomplete information and diverse willingness to adjust. Existing methods rarely achieve the synergistic optimization of local subgroup consensus and global group consensus, and often overlook the adaptability of adjustment willingness between individuals and subgroups, ultimately leading to decision outcomes that deviate from decision-makers’ (DMs) genuine preferences. To address these limitations, this study designs a two-stage three-way dynamic consensus framework that combines missing value completion and dynamic balanced consensus. Firstly, to address the deviation of traditional imputation methods from real decision-making scenario relevance, we integrate the evaluation tendencies and trust relationships among DMs for missing value imputation. Additionally, an adaptive DBSCAN approach for clustering without predefined parameters is proposed to eliminate the interference of subjective parameters. Based on this, this paper proposes a two-stage feedback mechanism guided by the three-way decision (TWD) theory, which dynamically balances the adjustment intentions of individuals and subgroups to achieve a low-cost and high-quality decision-making process. Finally, the results of case analysis and experimental verification show that the missing value completion method exhibits robust performance in various missing data scenarios. The overall framework can provide effective support for efficient and democratic consensus reaching in complex LSGDM scenarios.}
}
@article{SINGH2026115049,
title = {A robust decomposition-denoising deep learning framework with dynamic intraperiod ramping for cost-effective balancing market operation},
journal = {Applied Soft Computing},
volume = {195},
pages = {115049},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115049},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004977},
author = {Chandransh Singh and Sreenu Sreekumar and Dileep. G. and Vishnu Suresh and Rahul Satheesh},
keywords = {Balancing market, Decomposition, Denoising, Imbalance volume forecasting, Reserve optimization},
abstract = {This paper proposes a novel imbalance volume forecasting and subsequent balancing market operation framework that integrates decomposition, denoising, deep learning, and dynamic intraperiod ramping to improve forecasting accuracy and achieve cost-effective and reliable balancing market operation. A Robust Spectral-aware Trend–Seasonal Filtering (RSTSF) method is developed to jointly estimate trend, seasonal, and residual components under abrupt trend shifts and irregular seasonal patterns using robust likelihood modeling, structural coupling, and entropy-guided seasonal selection. To mitigate noise within the residuals, an Empirical Wavelet Transform combined with Piecewise Linear Approximation (EWT-PLA) is used for denoising. It effectively removes irrelevant noise while preserving the structural integrity of residual components. The Bidirectional Gated Recurrent Units (BiGRU) are used to forecast the trend and denoised-residual components due to their capability for bidirectional sequence learning. The Seasonal Attention BiGRU (SA-BiGRU) is proposed for seasonal components forecasting to capture periodic patterns. The parameters/hyperparameters of the proposed forecasting framework are optimized using a newly developed Newton–Raphson-Based Optimizer with Space Transformation Search (NRBO-STS), which reduces the risk of premature convergence and balances the exploration and exploitation capability. Furthermore, dynamic intraperiod ramping is incorporated into balancing market operation to ensure that Balancing Reserves (BRs) are practically deliverable in real-time, thereby improving market reliability and preventing BR shortfalls. A seasonal analysis conducted on the Belgian and Austrian power markets shows that the proposed framework achieves the lowest balancing costs, yielding savings of 23.31% and 25.58% compared to the second-best model in Belgium and Austria, respectively.}
}
@article{LIU2026115025,
title = {Multi-scale feature fusion graph neural network based on dynamic spatio-temporal evolution for system remaining useful life prediction},
journal = {Applied Soft Computing},
volume = {195},
pages = {115025},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115025},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004734},
author = {Shaoyang Liu and Guofa Li and Jialong He and Baodong Zhang and Liang Wang and Liyao Yu},
keywords = {Graph neural network, Multi-scale feature extraction, Feature fusion, Remaining useful life prediction, Dynamic spatio-temporal evolution graph},
abstract = {Reliable prediction of the remaining useful life (RUL) is an important guarantee for preventing major system accidents and formulating reasonable maintenance strategies. Multivariate time series (MTS) data provide richer insights into the degradation process of mechanical systems. However, the complexity of mechanical systems and the interference of invalid data limit the degradation model from fully characterizing the degradation process in MTS data, resulting in a decrease in the accuracy of its RUL prediction. To this end, this paper proposes a multi-scale spatio-temporal feature fusion network (MSTFFN) for RUL prediction of mechanical systems. First, a dynamic spatio-temporal evolution graph based on a gated attention mechanism is proposed to represent MTS data with complex coupling relationships. It not only integrates global and local temporal information, but also dynamically adjusts during training to avoid incorporating negative feedback into the feature aggregation process. Subsequently, to capture the spatio-temporal dependencies of degradation features at multiple scales, a multi-scale feature aggregation graph neural network (MSFAGNN) is proposed, which represents and models implicit information at multiple scales, providing a broader perspective for modeling degradation information. Finally, a spatio-temporal feature fusion method based on parallel cross-attention mechanism (PCAM) is proposed to adaptively integrate sensitive features from various dimensions, thereby achieving RUL advance prediction. The effectiveness and applicability of the proposed method are verified through two RUL prediction cases: one at the multi-sensor level and the other at the multi-feature level. Numerical analysis results show that the proposed method exhibits high RUL prediction accuracy in both scenarios.}
}
@article{ZHANG2026115033,
title = {Automated path planning method for urban street-corner parks based on multi-agent deep reinforcement learning},
journal = {Applied Soft Computing},
volume = {195},
pages = {115033},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115033},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004813},
author = {Zihuan Zhang and Zao Li and Taoyuan Zhang and Min Wang},
keywords = {Automated path planning, Urban street-corner parks, Multi-agent system, MADDPG, CNN-MLP hybrid network},
abstract = {Urban street-corner parks, as essential components of urban ecosystems and landscapes, play a key role in improving user experience through automated path planning. In response to the growing challenge of achieving efficient and intelligent path design within complex urban contexts, this study explores the use of multi-agent deep reinforcement learning for automated path planning under defined site conditions. A reinforcement learning platform is developed based on the Multi-Agent Deep Deterministic Policy Gradient (MADDPG) algorithm, and training is conducted, totaling 32,462,344 steps. To strengthen feature extraction and decision-making, a hybrid network model integrating Convolutional Neural Networks (CNN) and Multilayer Perceptrons (MLP) is constructed to process diverse observation data such as terrain elevation, points of interest, and location information. A custom ParkEnv environment simulates the terrain complexity and multi-agent interactions specific to urban street-corner parks, while a reward function guides learning through objectives including path optimization, obstacle avoidance, and POI accessibility. After training, the resulting path schemes are visualized and refined through adjustments in Grasshopper. Experimental results demonstrate that the multi-agent model achieves significant cumulative reward gains after approximately 32.5 million steps, effectively completing tasks by generating terrain-respecting, multi-route plans that reduce earthwork demands. The study also discusses model generalization, training efficiency, and the collaborative benefits of multi-agent systems in complex settings. Through case studies, the proposed method is shown to enhance design efficiency and improve user experience, offering a methodological foundation for intelligent decision-support systems in future urban street-corner park design and renewal.}
}
@article{MALEKI2026115029,
title = {Pi-transformer: A prior-informed dual-attention model for multivariate time-series anomaly detection},
journal = {Applied Soft Computing},
volume = {195},
pages = {115029},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115029},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004771},
author = {Sepehr Maleki and Negar Pourmoazemi},
keywords = {Transformer-based anomaly detection, Multivariate time-series anomaly detection, Prior-informed transformer, Dual-attention, Phase synchrony},
abstract = {Anomalies in multivariate time series often arise from temporal context and cross-channel coordination rather than isolated outliers. We present Pi-Transformer (Prior-Informed Transformer), a transformer with two attention pathways: data-driven series attention and a smoothly evolving prior attention that encodes temporal invariants such as scale-related self-similarity and phase synchrony. The prior provides an amplitude-insensitive temporal reference that calibrates reconstruction error. During training, we pair a reconstruction objective with a divergence term that encourages agreement between the two attentions while keeping them meaningfully distinct. The prior is regularised to evolve smoothly and is lightly distilled towards dataset-level statistics. At inference, the model combines an alignment-weighted reconstruction signal (Energy) with a mismatch signal that highlights timing and phase disruptions, and fuses them into a single score for detection. Across five benchmarks (SMD, MSL, SMAP, SWaT, and PSM), Pi-Transformer achieves state-of-the-art or highly competitive F1, with particular strength on timing and phase-breaking anomalies. Case analyses show complementary behaviour of the two streams and interpretable detections around regime changes. Embedding prior attention into transformer scoring yields a calibrated and robust approach to anomaly detection in complex multivariate systems.}
}
@article{LI2026115074,
title = {Mamba-enhanced multi-view stereo: Geometry-aware feature fusion and 3D cost volume regularization},
journal = {Applied Soft Computing},
volume = {195},
pages = {115074},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115074},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005223},
author = {Liangliang Li and Guihua Liu and Feng Xu and Wenjin Liao and Wenjie Zhao},
keywords = {Multi-view stereo, Mamba, Depth estimation, Surface normal},
abstract = {Feature extraction and cost volume regularization constitute two critical steps in learning-based Multi-View Stereo (MVS) methods. Previous works often overlook the geometric information degradation in image features and lack global perception of scene topology. In this paper, we propose MambaMVSNet, which achieves more accurate depth estimation through explicit geometric enhancement of image features and global-aware 3D cost volume regularization. Specifically, to address geometric degradation, we develop a Mamba-based Dynamic Enhancement Network for 2D Features (MDENet) that establishes feedback links between 2D feature space and 3D space by explicitly incorporating scene depth, surface normals, and geometric features. Concurrently, we propose a Mamba-based 3D Cost Volume Regularization Network (MReNet) to capture global topological relationships for precise depth hypothesis probability prediction, where orthogonal-unfolded 2D cost volumes are modeled as conditional probabilities of 3D cost volumes to extend Mamba’s global perception. Extensive experiments on DTU and Tanks & Temples benchmarks demonstrate that MambaMVSNet achieves comparable performance to state-of-the-art methods, while setting new records on DTU’s completeness metric and challenging scenarios of Tanks & Temples.}
}
@article{ALLAM2026114985,
title = {A scalable and efficient patient monitoring framework},
journal = {Applied Soft Computing},
volume = {195},
pages = {114985},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114985},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004333},
author = {Aya H. Allam and Ibrahim Gomaa and Hala H. Zayed and Mohamed Taha},
keywords = {Internet of Things, Healthcare, Fog computing, Directed Acyclic Graph, Security, Artificial Intelligence},
abstract = {Scalable and secure patient monitoring is critical for modern healthcare systems, particularly in resource-constrained environments. This paper presents the Scalable and Efficient Patient Monitoring Framework (SEPMF), a novel IoT-driven system that integrates fog computing, the InterPlanetary File System (IPFS), and the IOTA Tangle to enable real-time, decentralized, and secure data processing. The system is implemented using ESP8266 and Raspberry Pi to monitor vital signs such as pulse rate and oxygen saturation. A key feature of SEPMF is the integration of an Artificial Intelligence (AI) module within the fog layer, which enables intelligent, context-aware analysis of patient data. The module uses a Support Vector Machine (SVM) model trained on real-world COVID-19 datasets to predict infection status with 99% accuracy. This allows real-time disease prediction and timely alerts without reliance on centralized cloud infrastructure, improving responsiveness and clinical decision-making. The system employs Elliptic Curve Cryptography (ECC) and Transport Layer Security (TLS)-secured Message Queuing Telemetry Transport (MQTT) protocol to ensure data privacy and integrity during transmission. IPFS provides secure storage, while IOTA records tamper-proof transactions, reinforcing security and trust. Experimental evaluation demonstrates high scalability, with throughput stabilizing at 550 Transactions Per Second (TPS), CPU usage remaining below 50%, and latency decreasing from 0.0033 s to 0.002 s as nodes increase. SEPMF outperforms traditional IoT-based systems in scalability, responsiveness, and security. By combining decentralized architecture, embedded intelligence, and real-time processing, the framework offers a robust, efficient, and secure solution for next-generation patient monitoring in both clinical and remote healthcare environments.}
}
@article{DENG2026115037,
title = {Enhancing the prediction accuracy of concrete properties with knowledge constrained data augmentation and tabular foundation model},
journal = {Applied Soft Computing},
volume = {195},
pages = {115037},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115037},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004850},
author = {Lin Deng and Linghui Xie and Sijia Zhu and Zhi Li and Fangzhou Lin},
keywords = {Concrete property prediction, Domain knowledge, Data augmentation, Tabular foundation model},
abstract = {Unconstrained data augmentation for small material data can produce abnormal synthetic data (SD) that contradicts established material science principles. This study proposes a knowledge constrained data augmentation (KCDA) strategy to produce high-fidelity synthetic data based on domain knowledge derived from real data and utilize a tabular foundation model called the Tabular Prior-data Fitted Network (TabPFN) to enhance the prediction accuracy of concrete properties based on a total of 15 concrete datasets with varied sample sizes and prediction targets. Four data augmentation methods are used to produce synthetic training data, which is further processed by three anomaly detection methods to detect and remove the abnormal samples in the synthetic training data to formulate the constrained synthetic training data. Five training scenarios are formulated to validate the effectiveness of the KCDA strategy by constructing different training data sets. Results show that: (1) TabPFN is highly competitive in achieving superior model performance with less training time; (2) Combining real and synthetic training data significantly enhances model performance over using synthetic data alone; (3) The constrained synthetic training data enhances model performance over using unconstrained one. (4) The KCDA strategy significantly enhances model performance compared with performance without using data augmentation, especially when the real training data is integrated.}
}
@article{ARAGONJURADO2026115066,
title = {Two-level automatic software optimization using cooperative co-evolutionary algorithms},
journal = {Applied Soft Computing},
volume = {195},
pages = {115066},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115066},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005144},
author = {José Miguel Aragón-Jurado and Juan Carlos {de la Torre} and Yusuke Nojima and Patricia Ruiz and Bernabé Dorronsoro},
keywords = {Source code transformation, Cooperative coevolution, Runtime, LLVM, Software performance, Genetic algorithms},
abstract = {The rapid expansion of specialized hardware architectures has significantly increased the complexity of software optimization. Modern computing systems now incorporate diverse processors, co-processors, and heterogeneous execution environments. Each type of hardware requires specific optimization strategies to fully exploit its computational potential. Therefore, generic compiler optimizations often fail to account for intricate software–hardware interactions, leading to inefficiencies or performance degradation. Moreover, evolving compilation frameworks like LLVM continually introduce new optimizations and modify their optimization managers. This constant evolution makes it challenging to establish standardized optimization strategies. In this work, we first analyze the impact of the two existing pass managers in LLVM on automatic software optimization. Then, we define a novel two-level combinatorial optimization problem that leverages both pass managers for improved runtime performance. We solve this problem using a cooperative co-evolutionary cellular genetic algorithm and conduct extensive experiments to evaluate the impact of the different pass managers on software runtime. Specifically, we assess three optimization strategies, considering the legacy and new pass managers. Results demonstrate that the proposed methodology significantly enhances the runtime efficiency of the considered software, achieving up to 99.41% runtime improvement over the non-optimized program and 98.88% over the best existing optimization approaches.}
}
@article{WANG2026115001,
title = {Adaptive teacher modality selection for knowledge distillation: Boosting multimodal model performance},
journal = {Applied Soft Computing},
volume = {195},
pages = {115001},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115001},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004497},
author = {Mengxuan Wang and Hongjie Jiang},
keywords = {Multimodal learning, Imbalanced modality, Knowledge distillation, Multimodal importance},
abstract = {Multimodal learning faces challenges during optimization, which drives models to prefer a certain modality, leading to modality imbalance. Distillation-based methods frequently manually predefine a strong modality to compensate for the performance shortfall of weak modalities. However, such a heuristic is unreliable and cumbersome when modality salience is unknown. Meanwhile, the manually pre-specified teacher modality has failed to provide a reasonable quantitative criterion and generalizes poorly across datasets. To address this, we model teacher modality selection as a modality-importance ranking problem, enabling adaptive teacher selection. We introduce a feature-based criterion to quantify the utility of different modalities in the late-fusion neural network architecture, in which each modality feature is extracted by a specific feature encoder independently. Specifically, we propose a modality ranking approach based on Marginal Contribution Importance (MCI), enabling the model to efficiently select the highest-scoring modality as the teacher and explicitly distill knowledge to enhance weak modalities. When the teacher modality is chosen, the teacher modality is first “warmed up” through supervised training to isolate interference from the weak modalities. Subsequently, knowledge is distilled from the teacher to the student modalities, encouraging weak modalities to align with the richer knowledge of the teacher and thereby enhancing their performance. Extensive experiments on five public benchmark datasets demonstrate that TCKD consistently outperforms or matches state-of-the-art methods, achieving an average performance gain of approximately 2.1% in fusion accuracy and showing superior robustness with significantly higher worst-case accuracies.}
}
@article{LIAO2026115069,
title = {Consistency regularization for complementary clothing recommendations},
journal = {Applied Soft Computing},
volume = {195},
pages = {115069},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115069},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600517X},
author = {Shuiying Liao and P.Y. Mok and Li Li},
keywords = {User preferences, Clothing matching, Consistency, Regularization, Fashion recommendations, Multi-modal},
abstract = {This paper reports on the development of a Consistency Regularized BRP model, overcoming the shortcomings of existing complementary clothing recommendation methods, namely limited consistency and biased learning caused by diverse feature scales of multi-modal data. Compared to other product types, fashion preferences are inherently subjective and more personal, and fashion is often presented not by individual clothing items but with other complementary products in well-coordinated fashion outfits. Current complementary-product recommendation studies primarily focus on user preference and product matching; this study further emphasizes the consistency observed in user-product as well as product-product interactions, in the specific context of clothing matching. To address the identified research gaps, the CR-BPR model integrates collaborative filtering techniques to incorporate both user preference and product matching modeling, with a unique focus on consistency regularization for each aspect. Additionally, the incorporation of a feature scaling process further addresses the imbalances caused by different feature scales, ensuring that the model can effectively handle multi-modal data without being skewed by any particular type of feature. The effectiveness of the CR-BPR model was validated through detailed analysis involving two well-known clothing-matching recommendation benchmark datasets demonstrating that CR-BPR outperforms current state-of-the-art models in terms of prediction accuracy. The code and data are available at: https://github.com/asaander719/CR-BPR.}
}
@article{ANASTASIOU2026115062,
title = {Time-aware and lightweight hyperparameter optimization for internet of things via genetic algorithms and dynamic data thinning},
journal = {Applied Soft Computing},
volume = {195},
pages = {115062},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115062},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005107},
author = {Konstantinos Anastasiou and Sotiris Skaperas and Lefteris Mamatas},
keywords = {Machine learning, Internet of things (IoT), Genetic algorithms, Data thinning, LSTM, Hyperparameter optimization},
abstract = {The rapid growth and adoption of the Internet of Things (IoT) have led to ecosystems comprising interconnected devices that can generate and exchange vast amounts of data. However, as promising as the intelligent applications enabled by these devices are, they pose significant challenges, particularly in terms of limited computational resources and the need for timely and accurate decision-making. In this context, we propose a Genetic Algorithm (GA)-based optimization algorithm for hyperparameter tuning of Machine Learning (ML) models aligned with the resource constraints and rapid decision-making demands of IoT. The introduced Time-Sensitive Genetic Algorithm (TSGA) jointly optimizes both the predictive accuracy and the execution time of the ML model. Furthermore, we introduce a novel Data Thinning (DT) component, which achieves a considerable reduction in the input data volume without compromising the model’s accuracy. The component is built upon the Largest-Triangle-Three-Buckets LTTB algorithm and an adaptive offline cumulative sum (CUSUM)-based test. We validated TSGA and DT on real IoT data traces, and the results demonstrate that TSGA can determine hyperparameter settings that strategically balance the accuracy metrics of interest with execution time while reducing the data volume burden. Our approach generally outperforms baseline methods in both predictive performance and runtime responsiveness, with only a few exceptions where a slight decrease in accuracy yields substantial gains in execution time, proving its value for resource-constrained, real-world applications.}
}
@article{ZHU2026115017,
title = {Attention-based and context-aware knowledge distillation for enhancing crop disease detection},
journal = {Applied Soft Computing},
volume = {195},
pages = {115017},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115017},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004655},
author = {Xiangyuan Zhu and Taotao Mao and Jianguo Chen and Feifan Peng and Keqin Li},
keywords = {Crop disease detection, Deep learning, Knowledge distillation, Pixel-wise attention},
abstract = {Effective crop disease detection is essential for maintaining agricultural productivity, safeguarding food security, and ensuring the prosperity of farmers. However, the high computational demands of current deep neural network models often make them unsuitable for resource-constrained agricultural applications. Hence, there is a pressing demand for lightweight model designs for crop disease detection. To address this, we propose an attention-based and context-aware knowledge distillation (ACKD) approach that precisely evaluates pixel-wise contributions. Initially, a fine-grained pixel-wise attention mechanism identifies salient diseased pixels by emphasizing their gradients relative to the training loss. Secondly, spatial and channel-wise attention mechanisms capture broader spatial correlations and semantic details among pixels. Finally, contextual distillation extracts global contextual relationships, enabling the model to focus on informative pixels. By integrating these mechanisms, the ACKD approach transfers knowledge based on pixel-wise salience, thereby enhancing crop disease detection accuracy. Extensive experiments on the Strawberry Diseases, Tomato-Village, Tomato Leaf Diseases, and Bean Plant Pathologies datasets demonstrate that the ACKD achieves average precision (P) of 80.2%, recall (R) of 76.4%, F1 score of 78.1%, and mean average precision (mAP) of 80.4%. These results highlight the ACKD’s strong generalization across diverse crop datasets and its robust potential for agricultural applications. To our knowledge, this is the first application of pixel-wise attention for knowledge distillation in agricultural scenarios.}
}
@article{YANG2026115054,
title = {Fine-grained turbomachinery fault diagnosis using temporal evolution and statistical features fusion},
journal = {Applied Soft Computing},
volume = {195},
pages = {115054},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115054},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005028},
author = {Haibin Yang and Xiaomo Jiang and Huaiyu Hui and Jigang Meng and Xueyu Cheng},
keywords = {Turbomachinery, Fault diagnostics, Multivariate feature time series, Efficient GRU, Data augmentation},
abstract = {Existing turbomachinery fault diagnosis methods can identify coarse fault categories but fail to achieve fine-grained diagnosis, thereby preventing field engineers from performing targeted maintenance. This limitation mainly arises from their reliance on time-domain, frequency-domain, and shaft-orbit features while ignoring their temporal evolution. To address this limitation, we propose a fine-grained fault diagnosis method based on multivariate feature time series. First, a dual-branch neural network architecture is developed to integrate temporal evolution features from multivariate feature time series with complementary statistical features. Second, an efficient gated recurrent unit (EGRU) is designed to capture global dependencies in time series. Third, a data augmentation strategy is proposed, which combines segmentation-concatenation for time series and class distribution-based sampling for statistical features. Finally, an automated framework facilitates industrial fault diagnosis and deployment. A comparative study validates the method on a real-world dataset with seven fault types. By incorporating EGRU and data augmentation, the proposed method improves the average test accuracy by 1.22% and 2.4%, respectively, achieving a total improvement of 6.44% and surpassing comparable methods. Numerical results demonstrate that the proposed method provides a promising direction for fine-grained fault diagnosis of turbomachinery.}
}
@article{ZHAN2026114990,
title = {Methanol green ships propulsion system reliability evaluation based on comprehensive regret-theory and three-way decision method},
journal = {Applied Soft Computing},
volume = {195},
pages = {114990},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114990},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004382},
author = {Qiuyan Zhan and Zeshui Xu and Krzysztof Woloszyk and Luis Martínez},
keywords = {Interval-valued hesitant fuzzy sets, Regret theory, Three-way decision theory, Subtraction operation over IVHFSs, Methanol green ships propulsion system reliability},
abstract = {Methanol green ships are becoming increasingly important in the shipping industry because of their low carbon emissions, cost effectiveness, and reliable technology. However, failures in their propulsion systems can result in serious accidents, environmental pollution, and major financial losses. Therefore, there is an urgent need for intelligent reliability assessment techniques. To tackle this problem, this study proposes a new three-way decision method based on regret theory for interval-valued hesitant fuzzy sets environments. The main contributions include the introduction of a novel subtraction operation for interval-valued hesitant fuzzy sets and the development of a comprehensive regret-rejoice function that captures decision-makers’ psychological behavior. Using these tools, we construct an enhanced three-way decision model and provide a practical decision-making algorithm based on regret theory. A case study on the reliability of a methanol green ship propulsion system is conducted to illustrate the effectiveness of the proposed approach. Sensitivity and comparative analyses show that our model is more robust and achieves better ranking and decision accuracy than existing methods.}
}
@article{ZHAO2026115032,
title = {ChannelFormer: A transformer-based model for fNIRS missing channel reconstruction},
journal = {Applied Soft Computing},
volume = {195},
pages = {115032},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115032},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004801},
author = {Yaou Zhao and Kaiyun Li and Yi Cao and Yuehui Chen},
keywords = {fNIRS signals reconstruction, Transformer based model, Generative model, Autism spectrum disorder (ASD), Functional near-infrared spectroscopy (fNIRS)},
abstract = {Functional near-infrared spectroscopy (fNIRS) is a valuable non-invasive neuroimaging tool for pediatric studies. However, it is often affected by motion-induced channel loss, which limits its reliability in real-world applications. To address this challenge, we propose ChannelFormer, a Transformer-based model for reconstructing missing fNIRS channels. Unlike conventional approaches, ChannelFormer treats channels as tokens and temporal data as features, leveraging multi-head attention to capture inter-channel dependencies. The model incorporates a binary channel mask mechanism to flexibly handle three types of channel loss: single-channel, multi-channel, and light source-induced loss. Additionally, a slice-based computational strategy is adopted to reduce model complexity while maintaining accuracy. A hybrid loss function combining mean absolute error (MAE) and correlation coefficient (CC) is designed to balance numerical precision and trend preservation. We evaluated ChannelFormer on pediatric fNIRS datasets consisting of typically developing (TD) children and children with autism spectrum disorder (ASD). In single-channel reconstruction, the model achieved mean CC values of 0.8226 ± 0.0032 for TD and 0.7024 ± 0.0025 for ASD. Under the more challenging 12-channel loss scenario, performance remained high at 0.8022 ± 0.0018 for TD and 0.6719 ± 0.0026 for ASD. In the clinically relevant light source-induced loss condition, the model attained 0.7953 ± 0.0804 for TD and 0.6689 ± 0.0849 for ASD. These results demonstrate that ChannelFormer can effectively reconstruct missing fNIRS signals across multiple challenging scenarios, exhibiting strong generalizability to both TD and ASD populations.}
}
@article{LIANG2026114996,
title = {NightMamba: Integrating physical degradation models in enhanced state-space networks for nighttime image dehazing},
journal = {Applied Soft Computing},
volume = {195},
pages = {114996},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114996},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004448},
author = {Yun Liang and Xinjie Xiao and Jianquan Zhao and Zihan Zhou and Yu Luo},
keywords = {Nighttime image dehazing, Deep learning, State space model, Heuristic priors, Frequency analysis},
abstract = {Nighttime image dehazing is challenging due to compounded degradations from low ambient illumination and interference from artificial lighting. Current data-driven deep learning methods, such as convolutional neural networks and Transformers, often suffer from limited receptive fields or high computational costs, constraining their effectiveness and generalization for lightweight applications. Moreover, the absence of explicit nighttime imaging modeling and limited adaptation to distorted images hinder their effectiveness in real-world cases. To overcome these challenges, we present NightMamba, a novel framework that leverages three key advancements. First, we introduce Mamba and enhance the linear-complexity modeling of the Mamba architecture with a new adaptive interactive visual state space block which integrates convolutional features, to achieve a balanced global-local representation for nighttime scenes. Second, we incorporate heuristic physical priors in state-space networks through a physics-guided block that leverages intrinsic decomposition and transmission information, integrated with Mamba, to better model the physics of nighttime degradation and guide effective restoration adaptively. Third, we introduce a Fast Fourier Transform-based branch to enhance amplitude and phase components, effectively restoring color bias and isolating haze artifacts while preserving critical structural details. By combining spatial and frequency-domain features, NightMamba achieves robust and efficient dehazing. Extensive experiments on both synthetic and authentic datasets demonstrate the state-of-the-art performance of the proposed NightMamba for nighttime image dehazing.}
}
@article{REINAJIMENEZ2026114983,
title = {Tree-based vs. deep learning in time series: A prescriptive framework for performance-driven model selection},
journal = {Applied Soft Computing},
volume = {195},
pages = {114983},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114983},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600431X},
author = {Pablo Reina-Jiménez and María Martínez-Ballesteros and José C. Riquelme},
keywords = {Time series forecasting, Prescriptive analytics, Model selection, Interpretable artificial intelligence, Tree-based models, Deep learning, Meta-learning},
abstract = {A primary criticism of modern artificial intelligence models is the significant energy consumption required for their training. This issue is particularly relevant in time series forecasting, where a wide variety of models is available, yet the prevailing trend often favors maximizing predictive accuracy at the expense of substantially higher computational cost and environmental impact. This work poses a fundamental question: to what extent is this trade-off worthwhile? It seeks to quantify the marginal gain in accuracy relative to the increase in model complexity. Specifically, the study investigates whether it is possible to determine the characteristics that make a time series suitable for simpler, tree-based methods to yield sufficiently accurate forecasts, thereby rendering more resource-intensive deep neural networks unnecessary. To address this question, Regression Tree, M5P, Random Forest, XGBoost, Long Short-Term Memory networks, Convolutional Neural Networks, N-BEATS, Transformer and iTransformer are systematically compared across over 50,000 diverse real-world time series, divided into 31 different forecasting problems. The evaluation jointly considers predictive accuracy, computational efficiency, and sustainability-related aspects including energy consumption and CO2 emissions. For each dataset, a comprehensive set of descriptive characteristics is computed and used as input to a decision-tree meta-learner. The proposed framework not only predicts the forecasting algorithm most likely to minimize error for a given dataset but also generates interpretable rules that clarify why one model is preferable over another. The results identify the specific conditions under which tree-based or deep learning approaches are more effective and demonstrate the potential of the framework to provide actionable, transparent, and generalizable guidance for model selection across diverse forecasting scenarios.}
}
@article{WANG2026115004,
title = {A Rényi divergence-oriented multi-attributive border approximation area comparison method within a circular intuitionistic fuzzy framework for enhanced decision analytics},
journal = {Applied Soft Computing},
volume = {195},
pages = {115004},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115004},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004527},
author = {Jih-Chang Wang and Ting-Yu Chen},
keywords = {Rényi divergence, Circular Intuitionistic fuzzy (CIF) setting, Multi-attributive border approximation area comparison (MABAC), Divergence-informed indices, AI-based clinical decision support system},
abstract = {This study develops a Rényi divergence-oriented decision-analysis framework within a Circular Intuitionistic Fuzzy (CIF) setting to address the absence of information-theoretic divergence measures capable of simultaneously modeling central assessments and uncertainty radii. A family of CIF-adapted Rényi divergence measures is formally established, comprising a center-based divergence for analytical tractability and a radius-aware divergence that explicitly captures uncertainty dispersion. The proposed divergences are regulated by four complementary parameters—the Rényi order, a smoothing constant, a radius-penalty coefficient, and a sensitivity exponent—thereby ensuring numerical stability, flexibility, and controlled responsiveness to uncertainty variation. Based on these measures, a Rényi divergence-oriented CIF Multi-Attributive Border Approximation area Comparison (MABAC) method is constructed. Divergence information is systematically incorporated into benchmark formation, criterion weight derivation, and alternative performance assessment. Superior and inferior CIF benchmarks are defined, and divergence-informed indices are introduced to simultaneously evaluate closeness to ideal references and remoteness from anti-ideal references. These indices are further embedded into the MABAC procedure to generate divergence-aware decision matrices, a Rényi divergence-oriented border approximation area, and total separation values for ranking alternatives. To demonstrate practical applicability, the method is applied to the selection of an AI-based clinical decision support system provider for a medical center in Taiwan. In addition, intra-model sensitivity experiments and inter-model comparative analyses are performed to evaluate parameter robustness and ranking stability. The results confirm that the proposed approach exhibits stable ranking behavior, strong discrimination capability, and competitive performance relative to existing CIF-based decision methods. Overall, this study establishes a unified divergence-driven CIF decision paradigm that advances theoretical rigor while strengthening the operational effectiveness of decision analytics under complex uncertainty.}
}
@article{DUAN2026115044,
title = {Interval scanning Mamba for efficient hyperspectral image classification},
journal = {Applied Soft Computing},
volume = {195},
pages = {115044},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115044},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004928},
author = {Zhan Duan and ZiXi Ren and Zhentao Zhou and Xuyang An and Tiezhu Liu and Jia Zhang},
keywords = {Hyperspectral image classification, Mamba, State-space model, Spatial-spectral},
abstract = {Hyperspectral image (HSI) classification is important for remote sensing and fine-grained material identification, but it remains challenging due to high dimensionality, strong spectral redundancy, and the mismatch between spectral and spatial resolutions. Deep neural networks have improved spectral–spatial feature learning, yet many methods are still computationally heavy and hard to deploy on limited hardware. Herein, we propose PLLG-MAMBA, a lightweight Mamba/state-space model (SSM) framework for cross-dimensional spectral–spatial modeling. PLLG-MAMBA uses lightweight spatial and spectral SSM blocks to capture long-range dependencies efficiently. It also introduces a redundancy-aware scanning scheme that combines serpentine spatial interval scanning and bidirectional spectral interval scanning. This design keeps structural continuity and cross-band context while reducing redundant interactions. We further use an adaptive gated fusion module to balance and merge spatial and spectral cues across different scenes, instead of relying on a fixed fusion rule. In addition, we adopt an RFF-NLPCA-based dimensionality reduction stage to obtain a compact spectral representation and improve efficiency. Experiments on Indian Pines, Pavia University, and Salinas show competitive performance and consistent improvements in many cases under identical settings against representative CNN-, Transformer-, and Mamba-based baselines. PLLG-MAMBA also achieves strong accuracy with fewer parameters and lower computation, which makes it suitable for resource-constrained HSI deployment.}
}
@article{TORABI2026114947,
title = {A hybrid MADM-Causal modeling – Possibilistic programming framework for productivity improvement project selection: Insights from the mining industry},
journal = {Applied Soft Computing},
volume = {195},
pages = {114947},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114947},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003959},
author = {S. Ali Torabi and Kasra Fathollahzadeh and Narges Hajloo},
keywords = {Productivity improvement projects, Causal modeling, MADM, Possibilistic programming, Mining industry},
abstract = {Improving productivity is essential for organizations seeking to achieve strategic objectives and sustain continual improvement. This study proposes a hybrid decision-making framework for selecting Productivity Improvement Projects (PIPs) under resource constraints while accounting for the causal relationships among key Productivity Challenges (PCs). The framework integrates DEMATEL, MMDE, ISM, and MICMAC to identify, analyze, and prioritize PCs based on their influence and interdependencies. A pure zero–one possibilistic optimization model is then tailored to support limited resource allocation and project selection under epistemic uncertainty. The applicability of the proposed framework is demonstrated through a real-world case study in the mining industry. The results provide clear managerial insights by enabling decision-makers to focus on the most influential PCs and select PIPs aligned with organizational priorities and available resources. Overall, the framework offers a structured and practical tool for supporting PIP selection decisions in complex industrial environments.}
}
@article{KOBILICA2026115000,
title = {Investigating different learning strategies for low-resource sequence labeling},
journal = {Applied Soft Computing},
volume = {195},
pages = {115000},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115000},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004485},
author = {Armin Kobilica and Irfan Ahmad and Sajjad Mahmood},
keywords = {Active learning, Weak supervision, Self-training, Semi-supervised learning, Fine-tuning, PLM},
abstract = {Pre-trained language models (PLMs) have significantly advanced state-of-the-art performance in various NLP tasks, yet they still demand substantial amounts of high-quality annotated data—particularly challenging in low-resource, domain-specific settings. In this paper, we systematically investigate hybrid strategies that combine Active Learning (AL), Weak Supervision (WS), and Semi-Supervised Learning (SSL) for efficiently fine-tuning PLMs on a real-time, low-resource sequence labeling task. We focus on user feedback in the antivirus domain, where subject-matter experts defined eight custom entities (e.g., SUBSCRIPTION, PAYMENT) from a curated dataset of 877 app reviews. To rigorously validate our methods, we track real-time annotation costs (including time per token and entity) and evaluate performance via F1 score under multiple criteria: effectiveness, label efficiency, and a cost-based optimum. Our experimental results show that a carefully tuned hybrid approach can achieve an F1 score of up to 0.88 for the SUBSCRIPTION entity while reducing human annotation to fewer than 50 reviews. This represents a 25% decrease in labeled samples compared to standard AL alone, without sacrificing accuracy. We also examine waiting time and optimal stopping criteria, finding that summation-based least-confidence ranking consistently outperforms random or mean-based selection for sequence labeling. These detailed quantitative results—including F1 score curves, labeling cost analyses, and ablation studies on sampling strategies—demonstrate the robustness and cost-effectiveness of our approach, making a strong case for combining AL, WS, and SSL in real-time, low-resource NLP tasks.}
}
@article{LIU2026114976,
title = {Cloud-f-divergence based probabilistic hesitant fuzzy multi-criteria sorting method: An application to medical insurance fraud},
journal = {Applied Soft Computing},
volume = {195},
pages = {114976},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114976},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004242},
author = {Xiaodi Liu and Chenlu Zhu and Weiping Ding and Muhammet Deveci and Shitao Zhang},
keywords = {Cloud model, Multi-criteria sorting, F-divergence, Probabilistic interval-valued hesitant fuzzy set, Water filling theory},
abstract = {Medical insurance is designed to reimburse employees for monetary losses brought on by illness risks. However, the increasing costs of medical insurance make people tend to commit fraud. Medical insurance fraud (MIF) leads to losses for individuals, businesses, and governments, while also threatening the global sustainability of medical insurance systems. For the sake of classifying the severity of MIF, this study investigates a unique sorting method by integrating cloud model with technique for order preference by similarity to ideal solution (TOPSIS), i.e., Cloud-TOPSIS-Sort, to tackle multi-criteria sorting (MCS) problem. Firstly, given uncertainty in MCS, this study will adopt probabilistic interval-valued hesitant fuzzy set (PIVHFS) for handling uncertainty and propose a technique for objectively ascertaining the probability information in PIVHFS. Secondly, a method of transforming PIVHFS into cloud model is proposed for aggregating probabilistic interval-valued hesitant fuzzy elements (PIVHFEs). Thirdly, considering the important role of divergence in uncertainty theory, f-divergence is extended for cloud model to realize the effective processing of uncertain information. Then, a Cloud-TOPSIS-Sort method is raised, and a case study concerning MIF is used for illustrating the application of the suggested technique.}
}
@article{GUO2026114984,
title = {Homeostatically-regulated liquid state machines for robust and efficient arrhythmia classification: A neuromorphic approach},
journal = {Applied Soft Computing},
volume = {195},
pages = {114984},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114984},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004321},
author = {Xiang Guo and Shule Xu and Jun Jiao and Xinxiang Zhao and Yang Liu},
keywords = {Liquid state machine, Arrhythmia classification, Neuromorphic computing},
abstract = {Continuous arrhythmia monitoring with wearable ECG devices is constrained by the dual challenges of on-chip computational cost and the need for robust, real-time analysis. To address these limitations, this paper presents a neuromorphic computing framework based on a homeostatically-regulated Liquid State Machine (LSM) for robust and efficient arrhythmia classification. The proposed framework integrates three key architectural features: a direct continuous-valued signal processing pipeline that bypasses spike encoding to preserve waveform fidelity; a novel Learnable Homeostatic Self-Feedback (LHSF) Mask that dynamically mitigates network saturation to enhance stability and dynamic range; and a Temporal Integration Readout (TIR) strategy that leverages complete temporal dynamics for improved accuracy. Evaluated on the MIT-BIH arrhythmia benchmark, the framework achieves state-of-the-art classification accuracy. This high performance is substantiated by the model’s verified robustness, demonstrated through extensive hyperparameter analysis, which confirms a superior balance between accuracy and computational efficiency. These findings facilitate the development of low-power, real-time ECG monitoring devices suitable for deployment on resource-constrained neuromorphic hardware.}
}
@article{YANG2026115073,
title = {Contrastive representation learning for multivariate time series classification based on temporal-frequency consistency},
journal = {Applied Soft Computing},
volume = {195},
pages = {115073},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115073},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005211},
author = {Chao Yang and Yakun Chen and Zihao Li and Zhongwen Guo},
keywords = {Time series representation learning, Multivariate time series classification, Contrastive learning, Deep learning},
abstract = {Contrastive representation learning has gained prominence in multivariate time series classification (MTSC) due to its ability to leverage unlabeled data. Existing methods commonly propose consistency assumptions that focus solely on temporal or contextual features, which are inadequate for capturing the complex patterns and shifts found in real-world time-series data across diverse domains. In this paper, we present a novel contrastive learning approach for MTSC that introduces an innovative strategy for positive sample generation, leveraging the temporal-frequency consistency that naturally exists in diverse time-series data. Unlike existing methods that rely on heuristic temporal augmentations, which can inadvertently distort the underlying semantics of non-stationary signals, our approach leverages inherent structural and rhythmic properties of the original data. Specifically, we apply the Discrete Wavelet Transform (DWT) to extract wavelet coefficients, which represent time-frequency information and serve as positive samples. To improve negative sample selection, we develop a distance-based time series bank to minimize the risk of selecting similar samples from the same class as negative pairs. Furthermore, we introduce hierarchical-connected convolutional filter-based encoders to map samples and their wavelet coefficients into a joint time-frequency space, enabling hierarchical contrastive learning based on multi-scale temporal-frequency consistency. Extensive evaluations on 30 UEA datasets and 6 industrial sensing datasets show that our method achieves a state-of-the-art average accuracy of 0.777 and a top rank of 1.367, outperforming several competitive baselines. These results, supported by rigorous statistical analysis, confirm the effectiveness of our framework for MTSC.}
}
@article{GAO2026114992,
title = {Class-aware reconstruction and triple-scale consistency constraint promote federated weakly-supervised segmentation of colorectal cancer pathology images},
journal = {Applied Soft Computing},
volume = {195},
pages = {114992},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114992},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004400},
author = {Qizhong Gao and Weifeng Han and Jiansong Fan and Yicheng Di and Jiayu Bao and Rui Zhang and Xiang Gao},
keywords = {Weakly supervised semantic segmentation, Class activation maps, Federated learning, Selective state space model, Pathology image segmentation},
abstract = {Colorectal cancer is a prevalent and lethal malignancy, with histopathological examination serving as the diagnostic gold standard. Recent advances in deep learning have enabled the automated segmentation of medical histopathology images. However, pixel-level annotation of pathological images remains labor-intensive and time-consuming, which motivates the use of weakly supervised semantic segmentation (WSSS) as an alternative. Existing WSSS methods, however, often suffer from under-activation and over-activation due to the limited discriminative cues provided by categorical labels. As a result, they frequently fail to generate complete and high-quality Class Activation Maps (CAMs) suitable as pseudo-labels. Additionally, privacy concerns and barriers to inter-institutional data sharing hinder conventional centralized training approaches. To address these challenges, we propose FedCRT, a federated weakly supervised framework designed to comprehensively activate target regions while capturing fine-grained morphological features at tumor boundaries for high-precision segmentation. Specifically, we introduce a Class-Aware Spatial Reconstruction Module (CASRM), which guides the classification network to preserve spatial structures in input images and focus on non-discriminative regions, resulting in more complete target activation. We further develop a Triple-scale Consistency Constraint (TCC) that enforces feature consistency across global, neighborhood, and micro levels, enhancing boundary segmentation accuracy. Finally, we design a Bidirectional Trust Clustering (BTC) mechanism that uses cross-domain distance metrics, including Manhattan Distance and KL Divergence, to identify and eliminate Byzantine clients in decentralized federated training, thereby improving system stability and robustness. Experimental results on the CRAG, EBHI-seg, GLAS, and NDTH-CRC datasets demonstrate that FedCRT achieves the best overall performance, surpassing existing methods in both segmentation accuracy and robustness. Notably, FedCRT improves the Dice score by more than one percentage point over state-of-the-art models across all four datasets.}
}
@article{WU2026115011,
title = {An evolutionary hyperparameter optimization framework for YOLO-based military aircraft detection},
journal = {Applied Soft Computing},
volume = {195},
pages = {115011},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115011},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600459X},
author = {Tsung-Hua Wu and Chyh-Ming Lai and Wei-Chang Yeh and Yi-Xiang Liu},
keywords = {YOLO, Hyperparameter optimization, Military aircraft detection, Evolutionary algorithm, Genetic algorithm, Artificial bee colony, Simplified swarm optimization},
abstract = {Accurate object detection is essential for military surveillance, yet standard evolutionary hyperparameter optimization (EHPO) for models such as You Only Look Once (YOLO) often suffers from computational inefficiency and evaluation bias, primarily due to its memoryless design and reliance on single data splits. To address these limitations, this study proposes Greedy and Dynamic Evolutionary Hyperparameter Optimization (GD-EHPO), a general-purpose framework that integrates Greedy K-fold Evaluation (GKE) for robust fitness estimation and Dynamic Weight Inheritance (DWI) to enable continuous knowledge transfer across generations. Validated on the Military Aircraft Detection Dataset using YOLOv11s, GD-EHPO consistently outperforms conventional EHPO frameworks across multiple evolutionary algorithms. In particular, when combined with Simplified Swarm Optimization (SSO), GD-EHPO achieves a 4.81% improvement in mAP@0.5 over the default baseline and a 2.59% gain over standard EHPO, while demonstrating faster convergence and stronger cross-version generalization. These findings indicate that GD-EHPO provides an effective and scalable solution for optimizing real-time object detection models under resource-constrained deployment conditions.}
}
@article{SU2026114951,
title = {HM-Net: An improved few-shot learning model for the detection of traffic signs},
journal = {Applied Soft Computing},
volume = {195},
pages = {114951},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114951},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003996},
author = {Zhiwen Su and Haibin Ouyang and Steven Li and Zhi-Hui Zhan and Weiping Ding},
keywords = {Few-shot learning, Hyperbolic embedding, Feature degradation, Image classification},
abstract = {Due to lighting intensity, shooting angle, and motion blur, many traffic sign images exhibit significant feature degradation, which greatly reduces the domain adaptation ability of deep learning models in practical scenarios. This phenomenon is more prominent in Few Shot Learning (FSL) with extremely limited data. To address this issue, this study proposes an improved FSL model. First, this study introduces hyperbolic space theory and designs a Hyperbolic Hierarchical Constraint (HHC) algorithm to acquire domain knowledge by leveraging neighborhood constraints in hyperbolic space. Then, a Hyperbolic Relationship Metric (HRM) mechanism based on the HHC algorithm is proposed to improve the model’s generalization ability across data samples. Finally, based on the HRM mechanism, an FSL model named Hyperbolic Measurement Network (HM-Net) is constructed for feature-degraded traffic sign images. For FSL tasks, HM-Net’s performance on the benchmark dataset exceeds that of existing models. For FSL-based traffic sign detection tasks, HM-Net achieves higher performance than existing models. In cross-domain experiments, HM-Net demonstrates stronger domain adaptation capability than existing models.}
}
@article{LI2026114972,
title = {Multi-level contrastive clustering with neighborhood topology preservation},
journal = {Applied Soft Computing},
volume = {195},
pages = {114972},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114972},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004205},
author = {Yating Li and Jianghui Cai and Haifeng Yang and Jie Wang and Kai Ye},
keywords = {Contrastive learning, Neighborhood relationship contrast, Instance-level contrast, Cluster-level contrast, Clustering},
abstract = {Contrastive clustering, which leverages contrastive learning to enhance clustering performance, has made significant progress in recent years. However, existing contrastive clustering methods primarily focus on maintaining augmentation consistency across samples but neglect neighborhood topological relationship consistency. This limitation makes them struggle to cope with semantic deviations caused by excessive data augmentation. Therefore, a multi-level contrastive clustering method with neighborhood topology preservation is proposed. Firstly, the neighborhood relationship preservation mechanism is proposed to maintain cross-view neighborhood topology consistency. By preserving relative distance invariance among samples across augmented views, a stable neighborhood relationship is obtained, which effectively alleviates the phenomenon of semantic deviation caused by excessive sample augmentation. Secondly, a multi-level feature learning model is designed, which integrates neighborhood relationships, instance-level and cluster-level contrasts to enhance both instance representation discriminability and cross-view neighborhood topological stability. Finally, the experimental results on commonly used benchmark datasets highlight the superiority of our method. Especially on the CIFAR-100, Imagenet-dogs and Tinyimagenet datasets, the ACC, NMI, and ARI metrics are respectively improved by 16.9%, 11.37%, 24.77%; 17.14%,11.39%,21.25%; and 6.27%, 5.31%, 9.31% compared with the optimal contrastive clustering algorithm.}
}
@article{QIAO2026115053,
title = {A novel grey three-way decision model and its application},
journal = {Applied Soft Computing},
volume = {195},
pages = {115053},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115053},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005016},
author = {Yu Qiao and Yingjie Yang and Lirong Jian and Yiyu Yao},
keywords = {Grey system theory, Three-way decision, Grey set, Characteristic function, Degree of greyness},
abstract = {Decision problems in the real world often face challenges arising from incomplete information and the resulting decision risk. To address these issues, this paper develops a novel grey three-way decision model by leveraging grey system theory, which manages incomplete information, with three-way decision theory, which minimizes the decision risk. First, within the context of grey sets, the study defines the fundamental concepts of grey kernel, grey support, and grey boundary by considering both the characteristic function value and the degree of greyness. These concepts establish the theoretical foundation for constructing a unified framework that progresses from qualitative to quantitative modelling. Subsequently, a qualitative grey three-way decision model is proposed. This model employs the newly introduced concepts to achieve a highly reliable partition of the most definite components of the information; however, its partitioning rules remain overly rigid. To overcome this limitation, a more refined quantitative grey three-way decision model is further developed. Its core innovation lies in introducing a grey transformation function and the concept of grey three-way approximation, which convert grey information into a clear three-valued representation. Moreover, by incorporating adjustable threshold parameters and the principle of minimum cost, the proposed model enables a more flexible and adaptive decision-making process for grey information. Theoretical analysis shows that the qualitative model is a special case of the quantitative model, ensuring internal consistency within the theoretical system. Finally, a case study on enterprise green performance evaluation in an eco-industrial park is conducted. Multi-perspective analyzes demonstrate the effectiveness, robustness, and advantages of the proposed model in complex and uncertain decision environments.}
}
@article{JI2026115040,
title = {DAGF: A dual GCN and auxiliary graph fusion based model for aspect-based sentiment analysis},
journal = {Applied Soft Computing},
volume = {195},
pages = {115040},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115040},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004886},
author = {Jie Ji and Wenlong Zhu and Chengle Hou and Qiaoyan Song and YuKun Ma and Youruo Wang},
keywords = {Aspect-based sentiment analysis, Graph convolutional network, Relation-aware self-attention, Abstract meaning representation, Auxiliary graph fusion},
abstract = {Aspect-based Sentiment Analysis (ABSA) is a fine-grained sentiment analysis task that aims to distinguish the sentiment polarity corresponding to different aspects in a sentence. Traditional solutions have utilized syntactic and semantic information but face two core challenges: First, how to establish robust dependencies between aspect words and their corresponding contexts in syntactic analysis. Second, how to better capture deep semantic relations between aspect words and opinion words. To address these challenges, we propose the Dual Graph Convolutional Network and Auxiliary Graph Fusion (DAGF) model. The model constructs a syntactic Graph Convolutional Network (GCN) and a semantic GCN to improve syntactic and semantic analyses. An auxiliary graph fusion module is designed to capture the complex connections between syntactic and semantic structures. In particular, our approach strengthens dependency modeling in the syntactic GCN through the fusion of an external knowledge base with dependency trees and the introduction of a relation-aware self-attention mechanism. For deeper semantic capture, we implement Abstract Meaning Representation (AMR) within the semantic GCN, replacing traditional semantic representations. We also develop an auxiliary graph fusion module that integrates the syntactic and semantic GCNs, facilitating collaborative learning across both representation types. Experiments on three public datasets show that DAGF achieves the highest F1 scores, improving by 1.92, 1.54 and 0.15, respectively. It also attains the best accuracy on the first two datasets and second-best on the third, with accuracy gains of 1.61, 1.25 and –0.59 over the strongest baselines.}
}
@article{RAO2026114989,
title = {Lightweight pavement crack segmentation: An improved ULite model with efficient attention mechanisms},
journal = {Applied Soft Computing},
volume = {195},
pages = {114989},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114989},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004370},
author = {Quwei Rao and Zhiwei Shi},
keywords = {Image segmentation, Deep learning, Crack segmentation, Lightweight attention},
abstract = {Pavement crack detection is critical for road safety and infrastructure maintenance, yet achieving high segmentation accuracy with low computational cost remains challenging, especially for resource-constrained applications. This paper proposes a lightweight semantic segmentation model based on ULite, enhanced with two novel attention modules: AxialDualLite and an improved Ultra-Lightweight Subspace Attention Module (ULSAM). AxialDualLite incorporates Axial Depthwise Convolution (AxialDW) to jointly capture directional spatial features and local channel dependencies, and employs a broadcast-based fusion mechanism to adaptively integrate vertical and horizontal attention maps, significantly improving the model’s sensitivity to structural patterns and boundary details. Meanwhile, the improved ULSAM enhances spatial detail preservation by combining max and average pooling to generate more informative attention responses. Extensive experiments conducted on the Crack500, DeepCrack, and GAPs384 datasets— All collected from real-world pavement scenarios—demonstrate that our model achieves a 1–2% mIoU improvement over the base model with negligible increase in parameters and FLOPs. These results validate the effectiveness and robustness of our approach, highlighting its strong potential for intelligent pavement assessment in resource-constrained environments.}
}
@article{LIU2026115003,
title = {Understanding human-LLM interaction patterns in urban planning: A review and framework},
journal = {Applied Soft Computing},
volume = {195},
pages = {115003},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115003},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004515},
author = {Ke Liu and Tan Yigitcanlar and Will Browne and Tracy Washington},
keywords = {Large language models, Human-computer interaction, Urban planning, Smart cities, Generative artificial intelligence, Collaborative decision-making},
abstract = {Large language models (LLMs) are increasingly recognised for their transformative potential in urban planning, particularly in enhancing data processing and enabling collaborative decision-making. Yet, existing research often overlooks the structured, multi-phase interaction between users and LLM-enabled systems. This interaction includes task specification, system mediation, iterative negotiation, and feedback processes, all of which shape collaborative planning workflows. This study addresses this gap by systematically analysing 52 scholarly works using the PRISMA approach to clarify and model user–LLM interaction patterns in urban planning contexts. The findings reveal distinct preferences in LLM interaction: (a) professional users prioritise systems that support complex task decomposition and advanced analytical capabilities, while (b) non-professional users value accessibility and intuitive feedback mechanisms. Despite the potential of LLMs to bridge professional expertise with public participation, challenges remain in input interpretation, consistency across multi-round interactions, and system transparency. Hence, this study proposes a novel interaction framework incorporating user requirements, task processing and LLM capabilities to systematically support urban planning endeavours. This theoretically grounded and practically implementable framework establishes a balanced mechanism where technical automation enhances rather than replaces human expertise.}
}
@article{ALAWI2026115019,
title = {Residual hybrid deep learning for high-accuracy wind forecasting in coastal and tropical climates},
journal = {Applied Soft Computing},
volume = {195},
pages = {115019},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115019},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004679},
author = {Omer A. Alawi and Haslinda Mohamed Kamar and Ahmed Adil Nafea and M.M. AlAni and Ali Alsuwaiyan and Golden Odey and Zaher Mundher Yaseen},
keywords = {Wind speed forecasting, Residual hybrid model, Tropical climate, Deep learning, Meteorological prediction},
abstract = {Accurate wind speed forecasting is essential for optimizing renewable energy systems, managing urban microclimates, and improving meteorological preparedness. This study assesses the prediction accuracy of four advanced deep learning (DL) models—Convolutional Neural Network (CNN) + Bidirectional Long Short-Term Memory (BiLSTM) + Attention, BiLSTM, CNN-Long Short-Term Memory (LSTM), and a Residual Hybrid framework—for forecasting the 10-meter wind speed range (WS10M_RANGE) across eight climatically diverse regions in Malaysia over 24 years (2001–2024). A comprehensive set of meteorological inputs was used, including solar irradiance, temperature data, humidity, pressure, wind direction, and time indicators. The Residual Hybrid model consistently outperformed CNN + BiLSTM + Attention, BiLSTM, and CNN–LSTM architectures, achieving about 57–60% reductions in root-mean-square error (RMSE) and lowering mean absolute percentage error (MAPE) from approximately 31–35% to as low as 10.6%. Taylor diagram analysis further confirmed its superior alignment with observed variability and temporal consistency, with correlation coefficients (R) over 0.97 and standard deviations closely matching. These results show the Residual Hybrid model’s improved ability to learn both the main diurnal cycles and transient atmospheric variations, providing a strong, physically consistent tool for wind forecasting in tropical and coastal regions.}
}
@article{BOZYIGIT2026115027,
title = {Morphological classification and taxonomic differentiation of Verbascum species using spherical fuzzy C-means clustering},
journal = {Applied Soft Computing},
volume = {195},
pages = {115027},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115027},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004758},
author = {Mahmut Can Bozyiğit and Seher Karaman and Gül {Olgun Karacan} and Mehmet Ünver},
keywords = {, Spherical fuzzy sets, Fuzzy -means clustering},
abstract = {This study examines live specimens of Verbascum speciosum, V. vulcanicum, and V. lasianthum during the vegetation periods, measuring 75 individuals per species for stamen length (mm), number of flowers (count), flower length (mm), calyx (mm), and capsule (mm). The collected specimens are identified and preserved as herbarium materials in the Aksaray University Herbarium (AKSU). To analyze and classify the morphological data under uncertainty arising from natural intraspecific variation and morphological overlap among closely related species, a Spherical Fuzzy C-Means (SFCM) clustering algorithm is developed. Unlike classical fuzzy and intuitionistic fuzzy approaches, spherical fuzzy sets provide a more comprehensive representation by independently defining degrees of membership, non-membership, and neutrality in the central unit sphere. By utilizing this extended fuzzy framework, the proposed SFCM algorithm improves both the reliability and interpretability of clustering outcomes, offering a robust and accurate tool for morphological differentiation and taxonomic classification of plant species. The results are evaluated using clustering validity indices, including partition coefficient, modified partitional coefficient, partition entropy, clustering accuracy, Rand index, adjusted Rand index, and clustering purity. The SFCM algorithm successfully differentiated three morphologically similar Verbascum taxa based primarily on subtle variations in capsule and calyx dimensions according to partition coefficient, modified partitional coefficient, and partition entropy. The diagnostic importance of these reproductive structures is consistent with features repeatedly emphasized in classical taxonomic studies, thereby aligning statistical outcomes with natural biological distinctiveness.}
}
@article{ZHUANG2026115014,
title = {MSAnet: Mask-shared attention network for multi-view vehicle ReID in aerial surveillance},
journal = {Applied Soft Computing},
volume = {195},
pages = {115014},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115014},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600462X},
author = {Junbin Zhuang and Wenying Chen and Junyu Chen and Yunyi Yan},
keywords = {ReID, Shared attention, Mask information, Multi-scale features, Smooth average precision},
abstract = {Human-made artificial vehicle re-identification (ReID) poses a significant challenge in surveillance and military applications. Due to varying angles of view and different perspectives, cameras may capture images of identical targets that exhibit substantial differences. Conversely, drones equipped with cameras can obtain nearly identical images from similar yet distinct targets. In this study, we introduce the VeRi-military dataset, which focuses on artificial vehicle targets. This dataset consists of 1023 image groups covering four common categories of entities. We propose a Mask with Shared Attention Network (MSAnet) model that integrates local and global features. The global feature branch is constructed as a multi-scale feature fusion network based on SE-Net, while the local feature branch incorporates mask information through a mask generation network; weights are assigned via a shared attention mechanism. Additionally, to enhance the smoothness of the relative ranking relationship between positive and negative samples, we designed a smooth Average Precision (AP) loss function. Extensive experiments conducted on the dataset demonstrate that our method achieves a mean Average Precision (mAP) of 82.09% and Rank-1 accuracy of 96.87%, significantly outperforming other state-of-the-art methods.}
}
@article{BHOSALE2026115035,
title = {VSA_Net: Detection of very small aerial objects using loss function optimized network with novel feature aggregation},
journal = {Applied Soft Computing},
volume = {195},
pages = {115035},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115035},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004837},
author = {Aditi Bhosale and Shubham Phapale and Zaid Ali and Gajanan Sapsod and Gaurav Mishra and Manish Kurhekar and Anshul Agarwal},
keywords = {YOLO, CNN, GELAN, Small object detection, Loss function},
abstract = {Detecting very small airborne objects (as small as 6×6 in an image) in sky-focused surveillance imagery is a challenging task due to their minuscule size, low resolution, and the vast, texture-less sky background. Building upon the YOLO architecture, we introduce key modifications to improve small object detection performance. Our architecture introduces four major enhancements: (1) an additional high-resolution detection layer that focuses on extracting finer details from shallow layers, allowing the model to better preserve spatial information crucial for identifying small objects; (2) a dynamic, scale-aware loss function that adjusts the weight given to hard-to-detect objects during training. This mechanism ensures that small objects receive greater attention during the optimization process; (3) the standard C3 module in YOLOv5’s backbone was replaced with the Generalized Efficient Layer Aggregation Network (GELAN), which enhances feature extraction capabilities through dense aggregation and efficient gradient flow; and (4) anchor box optimization by analyzing dataset object size distributions and adjusting anchor scales and aspect ratios. The proposed model illustrates an improvement in accuracy of 7.4% over the base model and significantly improves the reliability in the detection of small airborne targets.}
}
@article{WANG2026115043,
title = {Instance-level mutual contrast network for semi-supervised domain generalization fault diagnosis},
journal = {Applied Soft Computing},
volume = {195},
pages = {115043},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115043},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004916},
author = {Zhaiwen Wang and Chenxian He and Dongnian Jiang and Dezhi Xu},
keywords = {Semi-supervised domain generalization, Fault diagnosis, Sensors, Contrast learning, Instance weighting},
abstract = {Domain generalization has attracted significant attention in the industrial sector in recent years due to its effectiveness in addressing domain shift problems. However, the annotation of industrial sensor data is often time-consuming and challenging, and most existing studies rely on fully labeled source domains. To tackle the problem of domain generalization in fault diagnosis with partially labeled source domains, this paper proposes an instance-level mutual contrastive network (IMCNet) for semi-supervised domain generalization. IMCNet leverages knowledge sharing between source domains to provide reliable pseudo-labels. The network comprises two main branches: an instance branch, which extracts sample features using an instance weighting mechanism, and a generalization branch, which provides generalized samples. A mutual contrastive learning module is designed between these branches to achieve compact feature aggregation through a two-stage contrastive strategy, which extracts classification information. Finally, a confidence score-based filtering mechanism is introduced to refine noisy pseudo-labels, and the filtered labels are fed to the generalized branch with the labeled samples to explore domain-invariant features. The effectiveness and superiority of IMCNet are demonstrated using real sensor data from a nickel flash smelting system.}
}
@article{IVANOVIC2026115068,
title = {Vertical industrial IoT framework powered by transformer models and two-layer fuzzy decision-making},
journal = {Applied Soft Computing},
volume = {195},
pages = {115068},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115068},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005168},
author = {Luka Ivanović and Saša D. Milić and Aleksandar Rakić},
keywords = {Edge–fog–cloud computing, Fuzzy logic controller, Small hydropower plant, Transformer model, Vertical industrial IoT},
abstract = {This paper presents a vertically composed Industrial Internet of Things (IIoT) framework with three hierarchical edge, fog, and cloud levels that integrates real-time data acquisition, multivariate time series forecasting, and fuzzy decision-making. This framework combines state-of-the-art transformer models, Patch Time-Series Transformer (PatchTST) and Temporal Fusion Transformer (TFT), for 24-hour active power and inflow forecasting at the fog level. The cloud, as the highest decision-making level, employs a two-layer fuzzy logic controller for adaptive optimization and decision support. The proposed IIoT framework is validated using real industrial operational data from a small hydroelectric power plant, noting that the methodology is general and scalable can be applied to various industrial environments where forecasting, optimization, and hierarchical decision-making are required. The paper’s contribution is twofold. The first represents the simultaneous application of novel transformer models at the fog-computing level. The second relates to fuzzy controllers for cloud decision-making. The results highlight a presented hands-on framework for data-driven control and fuzzy optimization in future smart industrial and energy systems.}
}
@article{CHEN2026114999,
title = {Deep plug-and-play prior for enhanced electrical impedance tomography},
journal = {Applied Soft Computing},
volume = {195},
pages = {114999},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114999},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004473},
author = {Zekun Chen and Xuefei Chen and Luhao Zhang and Haihua Li and Shili Liang},
keywords = {Untrained neural network prior, Deep plug-and-play prior, Transferability, Real-time image enhancement, EIT hardware system},
abstract = {The untrained neural network prior (UNNP) provides a novel inverse problem-solving approach for electrical impedance tomography (EIT). Leveraging this, we propose an unsupervised deep plug-and-play prior (DPnPP) framework to enhance electrical impedance image reconstruction. This method employs a plug-and-play (PnP) prior algorithm, integrates normalization steps into the UNNP architecture and optimizes this hybrid prior using the alternating direction method of multipliers (ADMM). This framework effectively reduces the ill-posedness of the inversion problem and improves the stability of the reconstruction results. To verify the effectiveness of the proposed algorithm, we utilize numerical simulation, experimental data, and real lung data for reconstruction experiments. The experimental results show that, compared with traditional regularization algorithms, the proposed DPnPP method achieves notable enhancements in the spatial resolution and quality of the reconstructed images, and demonstrates strong robustness to noise. Additionally, we construct an unsupervised real-time EIT image enhancement system by combining the DPnPP framework with an EIT hardware system. We validate the transferability of the single-frame reconstruction parameter. Under the same system conditions, the proposed model effectively suppresses background artifacts in images reconstructed by traditional algorithms, thereby enhancing practical applicability. The code is available at Github.}
}
@article{HA2026114979,
title = {TiVaT: A transformer with a single unified mechanism for capturing asynchronous dependencies in multivariate time series forecasting},
journal = {Applied Soft Computing},
volume = {195},
pages = {114979},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114979},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004278},
author = {Junwoo Ha and Sungsoo Kim and Kisu Lee and Seungjae Park and Hyukjae Kwon and Ha Young Kim},
keywords = {Multivariate time series forecasting, Asynchronous dependencies, Time series explainability, Attention mechanism, Transformer},
abstract = {Multivariate time series (MTS) forecasting is vital across various domains but remains challenging due to the need to simultaneously model temporal and inter-variate dependencies. Existing channel-dependent models, where Transformer-based models dominate, process these dependencies separately, limiting their capacity to capture complex interactions such as lead-lag dynamics. To address this issue, we propose TiVaT (Time-Variate Transformer), a novel architecture incorporating a single unified module, a Joint-Axis (JA) attention module, that concurrently processes temporal and variate modeling. The JA attention module dynamically selects relevant features to particularly capture asynchronous interactions. In addition, we introduce distance-aware time-variate sampling in the JA attention, a novel mechanism that extracts significant patterns through a learned 2D embedding space while reducing noise. Extensive experiments demonstrate TiVaT’s overall performance across diverse datasets, particularly excelling in scenarios with intricate asynchronous dependencies. Furthermore, our visualization results demonstrate the explainability based on the learned dependencies, highlighting TiVaT’s utility in real-world applications.}
}
@article{ZHU2026115031,
title = {A triple-stream synergistic architecture for robust aspect sentiment analysis},
journal = {Applied Soft Computing},
volume = {195},
pages = {115031},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115031},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004795},
author = {Chao Zhu and Laigan Luo},
keywords = {Aspect-based sentiment analysis, Aspect–cause relationship, Natural language processing, Aspect-internal semantic, Boundary-aware contextual},
abstract = {Aspect-based sentiment analysis continues to face significant challenges due to the limitations of conventional single-stream architectures, which often fail to capture nuanced sentiment cues. To address the persistent challenges in aspect-based sentiment analysis, this paper proposes a novel Triple-Stream Synergistic (TSS) framework that systematically models the intricate relationships between aspect terms and their contextual environments. The framework incorporates three dedicated modules: an internal stream that captures intra-aspect semantic structures through self-attention mechanisms, an external stream that introduces boundary-aware attention using aspect start/end positions as anchors to filter relevant context, and a causal stream that explicitly models aspect-sentiment causation via aspect–guided attention. A synergistic gating mechanism dynamically integrates these complementary representations, enabling adaptive weighting of different information sources. The extensive experiments on benchmark datasets demonstrate that our framework achieves state-of-the-art performance on the Restaurant dataset and competitive results on the Twitter and Laptop datasets, by effectively integrating local granularity with global contextual awareness. These results collectively validate the advancement and effectiveness of our proposed method. Main code: https://github.com/ZCMR/TSS}
}
@article{KOU2026115007,
title = {A robust framework for long-term photovoltaic power prediction through dual-mode modeling with transfer learning},
journal = {Applied Soft Computing},
volume = {195},
pages = {115007},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115007},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004552},
author = {Menggang Kou and Jianzhou Wang and Yilin Zhou and Runze Li and Zhiwu Li},
keywords = {Long-term prediction, Sequence-to-sequence, Transfer learning, Deep learning, Energy sustainability},
abstract = {The large-scale integration of photovoltaic (PV) generation requires advanced digital technologies to enhance prediction accuracy, thereby mitigating weather-induced output fluctuations and ensuring grid stability. Existing methods often ignore the differentiated impacts of weather conditions, especially under non-ideal scenarios, with performance degradation. This issue is more obvious in newly operational stations, where data scarcity hinders reliable predictions across diverse weather conditions. Therefore, an end-to-end prediction system based on “weather pattern clustering, pattern-specific prediction, and pattern-matched transfer” is proposed to support long-sequence PV prediction for 1–4 days ahead. The system first reduces the dimensionality of time series through a deep temporal clustering module to accurately differentiate weather patterns. Subsequently, specialized prediction modules are deployed: a linear reasoning module is employed for stable clear-sky conditions, while a dual-encoder module enhanced by Fast Fourier Transform is developed for volatile non-clear-sky conditions to collaboratively optimize trend and fluctuation components. Furthermore, a geospatial knowledge transfer strategy is designed to evaluate the multi-dimensional similarity between source and target stations, enabling robust model transfer even under capacity mismatches. Experiments on real-world PV datasets show that the proposed framework achieves an average error reduction of 26.01% compared to the state-of-the-art iTransformer method. The system features a lightweight architecture with rapid inference, rendering it well-suited for edge deployment in practical PV stations.}
}
@article{DWIVEDI2026114987,
title = {FreqGAN-GWO: Frequency-domain generative adversarial network with grey wolf optimizer for robust single-image dehazing},
journal = {Applied Soft Computing},
volume = {195},
pages = {114987},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114987},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004357},
author = {Pulkit Dwivedi and Prince Solanki},
keywords = {Image dehazing, Frequency domain processing, Spectral representation learning, Grey wolf optimizer (GWO), Generative adversarial networks (GANs)},
abstract = {Image dehazing is a crucial problem in computer vision, as images captured in outdoor and adverse weather environments often suffer from reduced visibility, loss of contrast, and color distortion due to atmospheric scattering caused by haze, fog, or smoke. Such degradation not only impacts human perception but also significantly lowers the performance of automated vision systems in downstream tasks. In this work, we introduce FreqGAN-GWO, a novel method designed to address single-image dehazing by leveraging channel-wise modeling in the frequency domain, paired with automated hyperparameter optimization. FreqGAN-GWO independently estimates transmission maps for each RGB color channel, capturing the unique wavelength-dependent attenuation effects of haze. After converting each channel’s transmission map into the frequency domain, the method employs a dedicated generative adversarial framework to restore clean spectral representations. These refined frequency-domain outputs are then mapped back to the spatial domain and fused via channel-wise averaging, ensuring color consistency and improved restoration fidelity. A key innovation of our approach is the use of Grey Wolf Optimization for tuning all critical hyperparameters, including the weights of multiple loss components and the learning rate, in an automated and adaptive fashion. This eliminates the need for manual parameter selection and guarantees balanced optimization across various loss objectives. Extensive experiments on both synthetic and real-world datasets show that FreqGAN-GWO surpasses existing dehazing methods on standard full-reference (PSNR, SSIM) and no-reference (NIQE, BRISQUE, SSEQ, FADE) metrics. Key ablation results further demonstrate the importance of channel-wise frequency modeling and GWO-tuned loss aggregation in achieving state-of-the-art visual quality and generalization.}
}
@article{THOMAS2026115015,
title = {Self-supervised domain adaptation with hypernetworks for compressive sensing MRI reconstruction},
journal = {Applied Soft Computing},
volume = {195},
pages = {115015},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115015},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004631},
author = {Libya Thomas and Joseph Zacharias},
keywords = {Compressed sensing, Magnetic resonance imaging (MRI), Hypernets, Modified neural networks, Tradeoff},
abstract = {Background
Accelerated Magnetic Resonance Imaging (MRI) reconstruction is crucial for reducing scan times and enhancing patient comfort. While traditional reconstruction techniques have been widely employed, they often fall short of meeting the growing demands of modern MRI applications. Deep learning-based approaches have emerged as promising alternatives, but they frequently face challenges due to distribution shifts between training and test datasets, resulting in performance degradation on unseen data.
Purpose
This study aims to develop a novel domain adaptation framework for accelerated MRI reconstruction that addresses the limitations posed by distribution shifts. The goal is to ensure robust and consistent image quality across diverse anatomical regions and data distributions.
Method
We propose a domain adaptation method integrated with a hypernetwork-based approach for MRI reconstruction. The framework incorporates self-supervised training and test-time training during inference to adapt the network’s parameters dynamically. This adaptation minimizes the disparity between training and test data distributions, enhancing reconstruction robustness. The method’s performance was evaluated using standard metrics such as Peak Signal-to-Noise Ratio (PSNR) and Structural Similarity Index (SSIM). Additionally, comparative analyses were conducted against three state-of-the-art reconstruction approaches.
Result
Our proposed method demonstrated superior performance in reconstruction quality and accuracy. Quantitative evaluation revealed significant improvements in PSNR and SSIM scores compared to existing methods. Moreover, the framework exhibited consistent performance across various anatomical regions, including challenging scenarios, by effectively mitigating distribution shifts. Variability analysis further highlighted its capability to maintain high-quality reconstructions under diverse conditions.
Conclusion
The proposed domain adaptation and hypernetwork-based approach addresses key challenges in deep learning-based MRI reconstruction, ensuring robust performance across varying data distributions. The method’s ability to adapt dynamically to unseen data highlights its potential for clinical applications, where variability in acquisition protocols and anatomical structures is prevalent. These findings pave the way for more reliable and patient-centric accelerated MRI solutions.}
}
@article{SCHIAVO2026114995,
title = {Optimizing field service operations with NLP and deep learning-based spare parts prediction},
journal = {Applied Soft Computing},
volume = {195},
pages = {114995},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114995},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004436},
author = {Alessio Schiavo and Alessandro Renda and Pietro Ducange and Francesco Marcelloni},
keywords = {Field service optimization, Natural language processing, Spare parts prediction, Deep learning},
abstract = {Field service technicians typically rely on their experience and fault descriptions to identify and select the appropriate spare parts for repairing an appliance. However, missing parts often lead to multiple service visits, increasing operational costs and reducing customer satisfaction. To address this issue, we propose DL-SPP.sbert, a Deep Learning-based Spare Part Prediction system that leverages NLP and structured data to accurately predict the spare parts needed for repairs. DL-SPP.sbert processes historical repair data, appliance metadata, and fault descriptions by leveraging SBERT sentence embeddings to capture the semantic meaning of textual inputs. Unlike retrieval-based methods, our system directly learns the relationships between input features and spare parts usage through a multi-label classification model. DL-SPP.sbert was evaluated on two real-world case studies, where it achieved up to a 64 % reduction in multiple-visit interventions, surpassing the performance of state-of-the-art baselines. A detailed explainability study highlights the key role of fault descriptions and appliance metadata in prediction accuracy, confirming DL-SPP.sbert as an effective tool for optimizing spare parts provisioning. Finally, experimental results indicate that updating the model with newly collected data is fundamental to preserving predictive performance over time in continuously evolving real-world industrial settings.}
}
@article{YANG2026115047,
title = {Large language models enhance reinforcement learning for public health resource allocation},
journal = {Applied Soft Computing},
volume = {195},
pages = {115047},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115047},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004953},
author = {Hao Yang and Chijun Zhang and Feiyang Yang and Melissa Zeynep Ertem and Xinwei Zhang and Qi Wang and Wenze Guan and Haoyang Wang},
keywords = {Large language models, Reinforcement learning, Multi-objective optimization, Intelligent decision support},
abstract = {Efficient resource allocation is crucial to prevent healthcare overload during public health emergencies. However, existing methods are limited by static single-period models, manual preprocessing of heterogeneous data, and suboptimal solvers. To address these, we propose a multi-period dynamic framework that incorporates regional prioritization and adapts to evolving epidemic severity, while achieving end-to-end automation through a hybrid agent integrating an enhanced Q-learning variant (QL-DA) with large language models (LLMs): QL-DA enables stable multi-objective optimization via dynamic exploration and adaptive normalization, while LLMs with retrieval-augmented generation (RAG) automate dynamic ingestion and normalization of multi-source data. Validated on Hong Kong COVID-19 datasets, our approach achieves lower operational costs and improved equity, providing a deployable decision-support system for emergency response.}
}
@article{ZHU2026115055,
title = {PDOS: A comprehensive phishing detection model combining object detection and similarity computation on web logos},
journal = {Applied Soft Computing},
volume = {195},
pages = {115055},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115055},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600503X},
author = {Erzhou Zhu and Wenlong Li and Conglin Ye},
keywords = {Phishing detection, Object detection, Visual similarity checking, Deep learning},
abstract = {In recent years, the approach of identifying brand logos from webpages and applying them to detect phishing attacks (referred to as “logo-based phishing detection") has become a state-of-the-art solution. A number of logo-based phishing detection models have been proposed, with the aim of enhancing performance metrics including accuracy, precision, recall, F1-score, and time efficiency. However, the scalability of detection models to adapt to new brand logos and their robustness against subtle adversarial perturbations in logo images are critical considerations for logo-based phishing detection. This study proposes the PDOS (Phishing Detection with Object detection and Similarity computation), a comprehensive phishing detection model that combines object detection and similarity computation on web logos. In PDOS, the Squeeze and Excitation (SE) attention mechanism is embedded into the YOLOv5s network to accurately capture brand logos on webpages. To generate an interpretable phishing detection report, two steps are performed sequentially: (1) Computing the visual similarity between the logos to be tested and those of legal websites; (2) Checking whether the target URL domain name is consistent with that of legal websites. Four new datasets containing samples with shape rotation, scale variations, and noise addition are constructed for comprehensively evaluating the phishing detection performance of the proposed model. Experimental results show that the PDOS model outperforms other related and representative schemes in terms of conventional metrics. The performance analysis also demonstrates that PDOS is scalable for new brand logos and robust against subtle adversarial perturbations in logo images.}
}
@article{HE2026114950,
title = {An exploratory competitive swarm optimizer assisted by convergence sampling for large-scale multiobjective optimization},
journal = {Applied Soft Computing},
volume = {195},
pages = {114950},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114950},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003984},
author = {Zhao He and Xinwei Lv and Hui Liu},
keywords = {Convergence sampling, Exploratory competitive swarm optimizer, Large-scale multiobjective optimization, Evolutionary algorithm},
abstract = {The search space of large-scale multiobjective optimization problems exponentially expands with the increase in decision variables, which makes it difficult for multiobjective evolutionary algorithms to balance convergence and diversity. To solve this problem, this study proposes an exploratory competitive swarm optimizer assisted by convergence sampling, termed ECSOCS. In the proposed algorithm, we first develop an efficient population initialization method that employs the idea of convergence sampling. Specifically, the population is quickly localized to an optimal region through convergence sampling. During the iterative process, an exploratory competitive swarm optimizer is developed where loser individuals are updated simultaneously in different directions to enhance diversity. Convergence sampling and the exploratory competitive swarm optimizer work together to balance the convergence and diversity. ECSOCS is verified with eight state-of-the-art large-scale multiobjective evolutionary algorithms on the LSMOP, ZDT, and DTLZ benchmark test suites with up to 5000 decision variables. Performance evaluation metrics include IGD, HV, GD, and Spread. The experimental results demonstrate the effectiveness of the proposed algorithm across all metrics. In addition, ECSOCS shows satisfactory results on nine real-world engineering problems.}
}
@article{BI2026115065,
title = {Optimized deployment–monitoring synchronized array method for passive sonobuoys based on an improved NSGA-II algorithm},
journal = {Applied Soft Computing},
volume = {195},
pages = {115065},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115065},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005132},
author = {Wenhao Bi and Yuxuan Wu and Yang Xu and An Zhang},
keywords = {The lost UUV, NSGA-II, Optimization, Detection efficiency, Sonobuoy},
abstract = {Unmanned Underwater Vehicles (UUVs) equipped with multiple sensors play an important role in ocean operations; however, navigation failures and communication disruptions may lead to vehicle loss. Passive sonobuoys are widely used for search and recovery of the lost UUV, where the deployment of sonobuoy arrays directly affect detection efficiency and deployment cost. Optimizing passive sonobuoy arrays for deployment–monitoring synchronized searches therefore constitutes a challenging multi-objective optimization problem. To address the premature convergence, limited operator adaptability, and weak population diversity maintenance of the conventional Non-dominated Sorting Genetic Algorithm II (NSGA-II), which hinder its performance in complex multi-objective scenarios, an INSGA-II–based optimization model for deployment–monitoring synchronized searches with passive sonobuoys is constructed. The three-dimensional spatial dispersion characteristics of the lost UUV are first analyzed, and a detection efficiency evaluation model for passive sonobuoy arrays is established. On this basis, a multi-objective optimization framework is constructed to simultaneously maximize detection efficiency while minimizing deployment route length and the number of deployed sonobuoys. The proposed INSGA-II integrates a Logistic map, an adaptive crossover operator, and dynamic crossover and mutation probabilities based on crowding distance to enhance global search capability. Experimental results demonstrate that the proposed method is both feasible and effective. Under a limited sonobuoy deployment constraint, the maximum detection efficiency reaches 0.9088, achieving up to a 13.9% improvement over benchmark algorithms. Moreover, three-dimensional deployment significantly outperforms conventional two-dimensional strategies, with maximum and average improvements of 15.19% and 12.53% in detection efficiency, respectively.}
}
@article{TAN2026114968,
title = {Non-intrusive three-phase load monitoring based on deep feature fusion and recursive interpretable screening},
journal = {Applied Soft Computing},
volume = {195},
pages = {114968},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114968},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004163},
author = {Mao Tan and Qiyang Li and Zibin Li and Xinwei Lv and Jinling Chen and Wei Liu},
keywords = {Non-intrusive load monitoring, Industrial buildings, Electrical measurements, Recursive interpretable selection},
abstract = {Non-intrusive load monitoring is important for managing three-phase industrial power systems. However, existing methods often overlook the inherent electrical characteristics that distinguish between the two types of loads, which leads to inter-class confusion in hybrid scenarios. Moreover, they still struggle to effectively distinguish similar loads under complex wiring configurations and dynamic operating conditions. This study analyzes the unique feature dependencies required for identifying single-phase and three-phase loads, and constructs a multi-stream feature fusion network to effectively integrate multimodal sequential and image data. To reduce redundancy and parameter overload during fusion, we propose a SHAP-based multimodal feature selection approach. Experimental results demonstrate that the proposed method significantly outperforms existing approaches in mixed load identification, achieving improvements of 5.05% in Matthews correlation coefficient and 4.40% in the macro-averaged F-score, while substantially enhancing model transparency and fusion efficiency.}
}
@article{BAI2026115057,
title = {A fuzzy information fusion method with fuzzy neighborhood granular for anomaly detection},
journal = {Applied Soft Computing},
volume = {195},
pages = {115057},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115057},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005053},
author = {Jiapeng Bai and Qian Hu and Meishe Liang and Jusheng Mi},
keywords = {Anomaly detection, Fuzzy neighborhood granules, Information fusion, Attribute importance},
abstract = {Anomaly detection, as an important branch of data mining, aims to recognize data objects deviating from typical patterns and is widely applied in various domains such as financial fraud, cybersecurity, and medical diagnosis. Fuzzy rough anomaly detection and its extended models have been widely investigated by many researchers, achieving promising performance. In conventional fuzzy rough anomaly detection, fuzzy relations are typically combined via disjunction or conjunction operations. This approach overlooks fuzzy relations under certain attributes, leading to information loss. Based on this, this paper proposes a method for fusing fuzzy relations based on fuzzy neighborhood granular weighting. By further incorporating attribute importance, we design an information fusion-based fuzzy neighborhood granular anomaly detection model. First, the ratio of an object’s fuzzy neighborhood granular to the overall fuzzy neighborhood granular under a single attribute is used as the attribute weight for fuzzy relation fusion. Then, the degree of object overlap is defined based on the degree of intersection between fused fuzzy neighborhood granulars, and attribute importance is defined. Moreover, the anomaly detection model is constructed by combining object overlap and attribute importance, and the relevant algorithm is formulated. Experimental results obtained from publicly accessible datasets provide final evidence supporting the algorithm’s effectiveness and efficiency.}
}
@article{FAYAZ2026115061,
title = {Real-time weather-adaptive water flow and leakage forecasting using an explainable unified deep neural network},
journal = {Applied Soft Computing},
volume = {195},
pages = {115061},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115061},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005090},
author = {Jawad Fayaz and Lauren McMillan and Vivian Cardenas and Liz Varga},
keywords = {Class-specific attention, Deep learning, Water flow forecasting, Leakage prediction, Adaptive Huber loss, Explainable artificial intelligence},
abstract = {Leakage in water distribution systems worldwide has an estimated annual cost of $7 billion and threatens water security amid growing climate pressures. Traditional leakage management approaches are reactive in their approach, wasting time and resources. This study introduces FLOWAID (flow and leakage forecasting using weather-adaptive neural network for intelligent decision-making), a deep learning framework that unifies water flow forecasting and proactive leak detection to enable continuous, time-agnostic monitoring of distribution networks. FLOWAID advances existing approaches through three key innovations: (1) a hybrid architecture combining convolutional residual networks for spatial weather-flow dependency extraction, bidirectional long short-term memory cells for temporal modelling, and multi-task multi-layer perceptrons for simultaneous predictions; (2) a class-specific attention mechanism that amplifies critical leakage-related features in underrepresented leakage class, improving the model’s sensitivity and leak detection performance; and (3) adaptive novel loss functions (adaptive Huber loss and weighted binary cross-entropy) paired with Shapley additive explanations to ensure robustness and transparency. The model processes five days of historical water flow and weather data from over 2000 district metered areas to predict water demand (i.e., flow rate) and leakage probability for the subsequent 12 h. Six weather variables of ten analysed, are identified as key predictors - temperature, specific and relative humidity, solar radiation, evaporation, and precipitation - which collectively account for over 90% of environmental influence on flow behavior. FLOWAID achieves a good predictive performance with average index of agreement ∼0.7 for flow forecasting and true positive rate of 88.2% and true negative rate of 99.2% in leak detection across imbalanced datasets. The model maintains consistent accuracy across diverse weather conditions, seasonal variations, and times of day, enabling leak detection at any hour rather than only during nighttime periods. By integrating interpretable machine learning with weather-adaptive forecasting, FLOWAID provides water utilities with actionable tools to reduce annual water losses, prioritize repairs in high-risk zones, and adapt infrastructure management strategies to climate-driven weather extremes.}
}
@article{ZHANG2026114974,
title = {A prediction method for complex medium fields based on a multi-scale Physics-Informed Neural Network integrated with adversarial training},
journal = {Applied Soft Computing},
volume = {195},
pages = {114974},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114974},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004229},
author = {Yue Zhang and Lei Zhao},
keywords = {AM-PINN, Parallel Hybrid Multi-scale Convolutional Aggregator (PHMCA), Dynamic Field-Aware Pyramid Pooling Module (DFAPP), Adversarial Training},
abstract = {In fields closely related to national strategic needs, such as energy development, environmental protection, and geological engineering, the accurate prediction of the physical response field from complex medium fields is a core scientific issue for achieving key engineering tasks. Although Physics-Informed Neural Networks (PINN) provide a new paradigm by embedding physical constraints, they struggle to effectively decouple the differences in medium parameter heterogeneity across multiple orders of magnitude. Moreover, they lack robustness when facing input perturbations such as sensor noise. To address these issues, this paper proposes a Multi-scale Physics-Informed Neural Network with Adversarial Training (AM-PINN). This approach is based on a Dense Convolutional Encoder-Decoder Network, integrating the U-Net architecture, the Parallel Hybrid Multi-scale Convolutional Aggregator (PHMCA), and the Dynamic Field-Aware Pyramid Pooling Module (DFAPP), and adopts an adversarial training strategy based on the joint gradient of physical constraint residuals and boundary conditions. During the learning process. The results show that AM-PINN significantly improves the prediction accuracy of the pressure field and flux field in the case of small samples (512, 1024, 2048, 4096). Meanwhile, the model's excellent performance on the high-resolution test set demonstrates its superior generalization ability. In addition, by introducing adversarial training, the model's robustness against measurement noise has also been enhanced.}
}
@article{ZHANG2026115026,
title = {Stable and efficient rescheduling for flight task testing with multi-objective consideration},
journal = {Applied Soft Computing},
volume = {195},
pages = {115026},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115026},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004746},
author = {Chao Zhang and Qiu Fang and Yi Mi and Hong Lu and Huiyou Zhu and Hao Song and Yaonan Wang},
keywords = {Flight test, Task scheduling, Dynamic events, Rescheduling, Multi-objective optimization},
abstract = {Flight testing represents a pivotal phase in the development of civil aircraft, during which extensive evaluations must be conducted to ensure compliance with airworthiness standards prior to commercial deployment. This process is often challenged by dynamic uncertainties that can disrupt planned schedules, leading to delays and inefficient resource utilization during rescheduling. In this study, we formulate the dynamic flight test rescheduling problem as a mathematical model that jointly optimizes efficiency and stability, aiming to minimize overall completion time while reducing changes in task assignments and execution sequences. To address this problem, we propose a Rolling Multi-Area Joint Local Rescheduling (RMAJ-LR) method to improve scheduling stability and efficiency by applying joint rolling local area adjustments. Moreover, we develop a Multi-Objective Evolutionary Algorithm with Multi-Stage Optimization Strategies (MOEA-MSOS) to generate high-quality Pareto-optimal solutions, employing staged search operators to accelerate convergence. Experimental results demonstrate that RMAJ-LR enhances scheduling performance to lower computational overhead compared with Complete Rescheduling, and that MOEA-MSOS achieves faster convergence and superior solution quality relative to standard multi-objective evolutionary algorithms, including NSGA-II, NSGA-III, and MODE.}
}
@article{CHEN2026114982,
title = {FedUnit: A Robust and Fair Federated Learning Framework for Malicious Client Detection and Free-Rider Contribution Evaluation},
journal = {Applied Soft Computing},
volume = {195},
pages = {114982},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114982},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004308},
author = {Leiming Chen and Hina Batool and Xingjie Zeng and Dehai Zhao and Yongsheng Du and Chee Wei Tan},
keywords = {Federated learning, Shapley value, Malicious model identification, Contribution evaluation, Reward distribution},
abstract = {Federated learning enables multi-party collaborative computing while preserving data security and privacy. Federated learning (FL) enables multi-party collaborative computing while preserving data security and privacy. However, conventional algorithms assume that all participants are fully trustworthy. This assumption often fails in real-world settings, creating two critical challenges: (i) malicious participants might compromise system security via backdoor attacks and data poisoning and (ii) free riders might exploit the system by obtaining rewards while providing minimal computational or data contributions. Existing solutions typically address these issues in isolation, lacking an integrated defence strategy. Furthermore, current Shapley value–based methods struggle to deliver fair contribution assessment in environments susceptible to free-riding behaviour. To address these limitations, we propose FedUnit, a framework that simultaneously ensures robustness and fairness in FL. The framework comprises three key components: (i) we develop a minimum cost–based client identification method that effectively detects and filters malicious models to aggregate robust global models, (ii) we design a constrained rule–based, dual-metric evaluation mechanism to achieve equitable contribution assessment in free-riding scenarios, and (iii) we implement a reward allocation method based on the principle of diminishing marginal utility to ensure equitable distribution. Extensive experiments on two public benchmarks and one real-world dataset demonstrate that FedUnit achieves approximately a 3% improvement in performance compared to baseline methods. Furthermore, it yields significantly fairer reward allocations. These results remarkably improve security and fairness, facilitating a highly reliable deployment of FL in trustless environments.}
}
@article{DANG2026115034,
title = {TRSADepth: Self-supervised monocular depth estimation with texture-robust sparse attention in natural environments},
journal = {Applied Soft Computing},
volume = {195},
pages = {115034},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115034},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004825},
author = {Lanxue Dang and Aobin Liu and Huiyu Mu and Yi Xie},
keywords = {Self-supervised depth estimation, Multi-space collaborative modeling, Texture-robust sparse attention, UAV visual perception},
abstract = {Achieving stable and high-quality monocular depth estimation in natural scenes is a fundamental prerequisite for environmental perception and three-dimensional mapping in low-altitude unmanned aerial systems. However, natural environments are often characterized by weak-texture regions, drastic scale variations, and complex structural distributions, which cause existing self-supervised methods that rely primarily on photometric consistency to suffer from severe degradation in structural continuity and detail recovery. To address these challenges, this paper proposes a natural-scene monocular depth estimation method based on Texture-Robust Sparse Attention (TRSA), termed TRSADepth, and designs a collaborative modeling framework across multiple spatial distributions to enhance structural perception and detail restoration in weak-texture regions. First, during the encoding stage, a global attention module with a sparse activation mechanism is introduced to strengthen global perception in weak-texture regions. Second, to accurately delineate object boundaries in natural scenes, a Multi-Scale Structure-Aware Module (MS-SAM) is embedded into the skip connections, enhancing sensitivity to complex boundaries and improving multi-scale representation capability. Finally, to alleviate texture degradation and detail loss during upsampling, a novel Spatial Rearrangement Upsampling (SRU) strategy combined with hierarchical feature refinement is proposed, enabling progressive recovery of high-resolution fine-grained information. Extensive experiments on KITTI, UAVid, UAV_ula, Make3D, and self-collected real-world aerial datasets demonstrate that TRSADepth achieves more stable depth estimation performance in weak-texture regions and scenes with drastic scale variations, significantly outperforming existing methods across multiple evaluation metrics. Further quantitative and qualitative analyses validate the effectiveness of the proposed method in natural-scene structural modeling and fine-grained detail restoration.}
}
@article{MANGA2026115050,
title = {Handling small and imbalanced datasets in government social media: A comparative study of machine learning and deep learning models},
journal = {Applied Soft Computing},
volume = {195},
pages = {115050},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115050},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004989},
author = {Eirini Manga and Catherine Marinagi and Christos Skourlas and Nikitas Karanikolas and Dimitrios Markopoulos},
keywords = {Machine learning, Deep learning, Sentiment analysis, Public administration},
abstract = {Analysis of social media content allows governments to identify and explore citizens’ emotional responses to policies or services. Citizens’ emotions, expressed in reviews and comments, provide valuable insights for more responsive and effective public administration. Using a real-world dataset of 148 citizen reviews collected from the U.S. Department of Transportation’s Facebook page, and explicitly addressing the constraints of very small and imbalanced datasets, this study undertook a comparative evaluation of a wide range of classification models. The analysis included traditional machine learning algorithms, J4.8, Random Forest, Naive Bayes, BayesNet, Multilayer Perceptron, Logistic Regression, ZeroR, OneR and Nearest Neighbor, as well as more advanced models such as Gradient Boosted Decision Trees and the transformer-based BERT model. Model performance was assessed across multiple metrics, including Speed, Accuracy, macro and weighted F1-scores, Matthews Correlation Coefficient, and ROC AUC, to provide a descriptive comparison under low-resource conditions. The study’s results indicate that greater model complexity does not necessarily translate into improved performance in this study. While the transformer-based BERT model underperformed, a result attributable to the limited size and imbalance of the dataset rather than to model inadequacy, the Gradient Boosted Decision Trees model achieved the highest observed performance, correctly classifying 93.9% of the 148 instances, with a true positive rate of 0.939 and a weighted F1-score of 0.933, suggesting strong effectiveness in low-resource, imbalanced classification scenarios. Traditional machine learning models such as BayesNet and Logistic Regression also demonstrated reliable performance, with 128 and 126 correctly classified instances respectively, offering a balance between predictive power and computational efficiency. These findings provide empirically grounded guidance for governments seeking effective and resource-efficient tools for analyzing public sentiment from social media data, particularly in settings characterized by limited data availability and class imbalance, thereby supporting more informed decision-making and responsive policy development.}
}
@article{ZEPEDA2026115042,
title = {Deep transformer Q-learning based reinforcement learning for portfolio optimization of cryptocurrencies},
journal = {Applied Soft Computing},
volume = {195},
pages = {115042},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115042},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004904},
author = {Matias Zepeda and Werner Kristjanpoller and Marcel C. Minutolo},
keywords = {Double deep transformer Q-learning, Reinforcement learning, Portfolio optimization, Cryptocurrency market, Markov decision process},
abstract = {Portfolio optimization remains a central theme in financial research, with recent advances in machine learning (ML) and computational power enabling more sophisticated forecasting models. Cryptocurrencies, characterized by extreme volatility and rapidly changing dynamics, pose particular challenges for portfolio allocation. This study proposes a novel Double Deep Transformer Q-Learning (DDTQL) framework for optimizing a portfolio of 15 leading cryptocurrencies. To the best of our knowledge, this is the first work to apply a Double Transformer-based reinforcement learning model specifically to cryptocurrency portfolio optimization, moving beyond prior studies that have combined Transformers and RL in unrelated domains. The framework leverages Reinforcement Learning (RL) within a Markov Decision Process (MDP) to derive optimal allocation strategies from historical price data, including periods of economic crisis. Empirical findings show that DDTQL consistently outperforms Long Short-Term Memory (LSTM), Multi-Output Artificial Neural Network (ANN) models, Proximal Policy Optimization (PPO), Markowitz portfolio optimization and a market benchmark in terms of the Sharpe Ratio. The Transformer’s attention mechanism and encoder–decoder design enable the effective modeling of long-term dependencies without requiring a recurrent structure, leading to superior predictive and decision-making performance. These results highlight the effectiveness of integrating Transformers within an RL framework for financial decision-making and portfolio allocation in cryptocurrency markets. Future research could refine Transformer architectures and incorporate additional financial and macroeconomic signals to further strengthen predictive robustness and practical applicability.}
}
@article{BU2026114945,
title = {M-PIN: Multilingual prompt-based implicit sentiment analysis network},
journal = {Applied Soft Computing},
volume = {195},
pages = {114945},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114945},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003935},
author = {Kun Bu and Yuanchao Liu and Wenbo Wang and Ziyi Cao},
keywords = {Natural language processing, Implicit sentiment analysis, Prompt learning, Pre-trained language model},
abstract = {Sentiment Analysis (SA) is a classic task in Natural Language Processing (NLP). Compared to Explicit Sentiment Analysis (ESA), Implicit Sentiment Analysis (ISA) is more challenging but does not achieve enough attention. As a knowledge intensive task, ISA needs more information than ESA, but existing models prefer introducing external knowledge bases with additional computational resources, ignore the prior knowledge in Pre-trained Language Model (PLM). So we propose a Multilingual Prompt-based Implicit sentiment analysis Network (dubbed M-PIN), where the prior knowledge guidance module and context information module are introduced, the guidance is embedded in trainable template, which can effectively activate PLM knowledge with the context information. Experiments on five public datasets demonstrate the M-PIN effectiveness, M-PIN has better performance than general Large Language Model (LLM). In addition, ablation experiment results show that combined with the context information and on the premise of indicating the evaluation direction for PLM, even a simple prompt template can effectively improve the ISA performance.}
}
@article{ZHANG2026115045,
title = {CEFG-Net: Context-enhanced features guided network for infrared and visible UAV image stitching},
journal = {Applied Soft Computing},
volume = {195},
pages = {115045},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115045},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600493X},
author = {Yuanlu Zhang and Shi Yi and Huiqi Wu and Xue Bai and Qingxuan Li},
keywords = {Infrared and visible UAV image stitching, Context-enhanced features, CNN-based composition strategy, Image registration, Dual-spectrum UAV dataset},
abstract = {Image stitching on infrared (IR) and visible (VIS) unmanned aerial vehicle (UAV) images is essential in the field of earth observation. However, most existing image stitching methods are designed for VIS images, and thus fail to achieve satisfactory performance when applied to IR images. Due to the lack of textural details and low resolution, IR image stitching task has higher requirements for image stitching network. Moreover, the dual-spectrum (IR and VIS) UAV platform has a flexible perspective, and the images captured by UAVs have high texture repetition, which causes matching point errors. Hence, to address the above issues, this study proposed a context-enhanced features guided network (CEFG-Net), which is devised for infrared and visible UAV image stitching, especially demonstrating excellent performance in infrared UAV images. The network is divided into two stages: the image registration stage and the image composition stage. Firstly, to improve the accuracy of the image matching points, we introduced context-enhanced feature module which combines self-attention mechanism with cross-attention mechanism in the image registration stage. Meanwhile, a VIS-guided mechanism is introduced and applied during the IR image matching stage to achieve higher matching accuracy. Subsequently, in order to understand the structural information of the images and avoid ghosting in the stitched images, we proposed an image composition strategy based on CNN, which can effectively learn the structural information of IR and VIS UAV images. Moreover, we constructed a large-scale dataset dedicated to IR and VIS UAV image stitching. This dataset was utilized to train and test our proposed network. Based on our own dataset and other general datasets, we conducted extensive ablation studies and comparative experiments. The ablation experiment results proved that the proposed context-enhanced feature module and CNN-based image composition strategy significantly improved the stitching performance of our proposed network. The results of comparative experiments further verified that our CEFG-Net outperformed existing SoTA image stitching methods for the IR and VIS UAV image stitching task.}
}
@article{ABOLPOUR2026114970,
title = {Design and optimization of minimization algorithms for IT-2 general fuzzy automata},
journal = {Applied Soft Computing},
volume = {195},
pages = {114970},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114970},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004187},
author = {Kh. Abolpour and M. Shamsizadeh},
keywords = {Interval type-2 general fuzzy automata, State minimization, Metaheuristic optimization, Robustness},
abstract = {Interval Type-2 General Fuzzy Automata (IT2-GFA) offer a powerful formalism for modeling uncertainty in computational systems. This paper presents a hybrid minimization framework that integrates exact partition-refinement with metaheuristic optimization methods, including Genetic Algorithm (GA), Particle Swarm Optimization (PSO), and Simulated Annealing (SA). To guide state reduction, we propose a novel similarity-based equivalence relation defined on interval-valued transitions and outputs. Theoretical analysis establishes the existence, uniqueness, and robustness of the minimized automata under interval perturbations and threshold variations. Experimental results show 25%–50% state reduction with accuracy loss below 0.5%, together with up to 50% decrease in inference time and over 40% memory savings. Case studies in natural language processing and medical decision-making demonstrate the practical benefits, while extensions to IoT and industrial control highlight broader applicability.}
}
@article{PR2026114941,
title = {A weighted domination with inverse centrality based graph neural networks for node classification},
journal = {Applied Soft Computing},
volume = {195},
pages = {114941},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114941},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003893},
author = {Geethika P.R. and Dhanasekar S.},
keywords = {Graph neural networks, Graph convolutional networks, Graph attention networks, Node classification, Training node selection, Weighted domination, Centrality},
abstract = {Graph Neural Networks (GNNs) have emerged as an effective architecture for graph based classification tasks, consistently outperforming traditional machine learning methods and motivating ongoing research on enhancing model expressiveness. This work addresses the problem of node classification in graphs by proposing a training node selection methodology to improve model performance. A weighted domination with inverse centrality based weighting is employed as a preprocessing mechanism for training set selection in GNN models. Unlike conventional GNN models that rely on random selection of training nodes, the proposed approach selects minimum weighted dominating set constrained by closeness centrality for training node selection. Two novel frameworks namely, Weighted Domination with Closeness centrality based Graph Convolutional Network (WDC_GCN) and Weighted Domination with Closeness centrality based Graph Attention Networks (WDC_GAT) are proposed, employing the new dataset selection strategy. The experimental evaluation demonstrates consistent improvements across benchmark datasets across multiple node classification metrics. By leveraging weighted domination with inverse centrality, the proposed models achieve improved accuracy and F1-score compared to competitive models. The proposed work provides a methodological advancement in classification performance through its training set selection strategy using inverse centrality weighting based domination which favors dominators that are globally well positioned. The results substantiate the inference that integrating structural graph theoretical properties positively influences performance levels, thereby enhancing model efficiency.}
}
@article{GUO2026114978,
title = {Single domain generalized fundus image segmentation via random style transformation},
journal = {Applied Soft Computing},
volume = {195},
pages = {114978},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114978},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004266},
author = {Song Guo},
keywords = {Fundus image segmentation, Domain generalization, Style transformation, Image reconstruction},
abstract = {Accurate segmentation of fundus structures plays a vital role in the diagnosis of ophthalmic diseases. Recently, deep learning methods have achieved promising results in fundus image segmentation. However, they suffer from the domain shift problem, i.e., the segmentation performance drops significantly when the test images are sampled from a distribution distinct from that of the training images. To overcome this challenge, this paper focuses on the challenging single-source domain generalization, where we aim to train a deep learning model on only one source training domain and expect it to perform well on other unseen target domains. Our contributions are threefold. First, we propose Random Style Transformation (RST), a novel approach for single-source domain generalized fundus image segmentation. Second, RST enhances image diversity by leveraging a reconstruction network and applying style transformation to its intermediate features, generating images with varied colors and styles. Third, we comprehensively evaluate the effectiveness of our method on four fundus image segmentation tasks under both single- and multi-domain generalization settings, demonstrating that RST consistently outperforms several state-of-the-art comparison methods.}
}
@article{UCALSARI2026115030,
title = {A multi-expert Fermatean fuzzy approach to improve the critical path method under uncertainty},
journal = {Applied Soft Computing},
volume = {195},
pages = {115030},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115030},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004783},
author = {Irem {Ucal Sari} and Tusan Derya and Kumru Didem Atalay},
keywords = {Fuzzy critical path method, Fermatean fuzzy sets, Project duration, Expert knowledge, Operations management},
abstract = {Uncertainty in project scheduling remains a central challenge, as real-world activity durations frequently involve ambiguity that traditional methods cannot fully capture. Project scheduling often struggles to manage uncertainty effectively, as traditional methods such as the Critical Path Method (CPM) and the Program Evaluation and Review Technique (PERT) rely on either rigid deterministic estimates or predefined probability distributions. These approaches frequently fall short in capturing the inherent ambiguity and variability present in real-world projects. Existing studies generally suffer from (i) restrictive uncertainty representations, (ii) limited ability to incorporate diverse expert judgments, and (iii) insufficient flexibility when activity information is imprecise. To address these limitations, this study introduces an innovative interval-valued Fermatean fuzzy CPM framework, offering a more expressive and resilient approach to modeling uncertainty in project timelines. The proposed framework integrates multi-expert assessments through interval-valued Fermatean fuzzy sets, capturing both the range of possible activity durations and the associated degrees of confidence. An aggregation approach is employed to combine expert opinions, allowing uncertainty information to be reasonably reflected in the critical path analysis and improving the interpretability of the results. These components collectively overcome the limitations of existing CPM- and PERT-based approaches by enabling richer uncertainty modeling and more transparent integration of expert assessments. An illustrative example is presented to demonstrate the applicability and comparative strengths of the proposed method, highlighting its ability to generate more realistic and risk-sensitive scheduling insights compared to traditional approaches. The results show that the proposed Fermatean CPM method provides an approximately 16% improvement in capturing project risk and uncertainty (calculated as the difference between the PERT probability of completing the project within the baseline duration and the fully covered interval provided by Fermatean CPM) compared to baseline CPM and PERT models, offering a more reliable and realistic project schedule. This research offers a new perspective on uncertainty modeling in project scheduling by applying interval-valued Fermatean fuzzy sets for the first time in this context. It contributes a mathematically grounded and practically useful aggregation approach and provides empirical evidence that conventional techniques may significantly underestimate project risks. Ultimately, the proposed framework empowers project managers to make more informed and resilient scheduling decisions under uncertainty.}
}
@article{LIU2026114997,
title = {uMK-HEFL: Unconstrained multi-key homomorphic encryption for privacy-preserving federated learning},
journal = {Applied Soft Computing},
volume = {195},
pages = {114997},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114997},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600445X},
author = {Wenhao Liu and Xu An Wang and Wei Zhao and Lingling Wu and Haibo Lei and Weiwei Jiang},
keywords = {Federated learning, Multi-key homomorphic encryption, Locality sensitive hashing, Privacy protection, Information security},
abstract = {Facing the challenge of data silos, federated learning (FL) enables collaborative modeling through its distributed training paradigm, while homomorphic encryption (HE) is widely adopted to protect data privacy. However, deploying FL in practice still faces privacy and efficiency challenges. Although multi-key homomorphic encryption (MKHE) has been introduced into FL, existing MKHE-based schemes impose strong constraints on encryption parameters and ciphertext structure, incurring significant communication and computational costs and limiting their deployment in large-scale environments. To overcome these limitations, we propose a privacy-preserving FL scheme based on unconstrained multi-key homomorphic encryption (uMK-HEFL). The scheme uses multi-key CKKS homomorphic encryption algorithm to achieve independent key generation and encryption at clients and automatic decryption aggregation at the server, which can resist collusion attacks from up to k<K−1 colluding clients and the server. By not imposing constraints on the variables generated during each party’s encryption process, the scheme effectively enhances flexibility. Moreover, it combines an improved SIMPLE Locality Sensitive Hashing (SIMPLE-LSH) technique for client clustering and selection, significantly improving efficiency. Experimental results on four benchmark datasets demonstrate that the proposed scheme achieves model accuracy, while the client clustering and selection mechanism reduces the overall communication cost by about 15%. Compared with schemes based on BFV or Paillier, our scheme also reduces both communication and computational costs.}
}
@article{YANG2026114994,
title = {Enhancing shale gas production forecasting via decline-informed temporal graph network},
journal = {Applied Soft Computing},
volume = {195},
pages = {114994},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114994},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004424},
author = {Junwen Yang and Dapeng Zhang and Lunwen Wu and Jian Xiong},
keywords = {Graph neural network, Decline curve analysis, Physics-informed neural network, Gas production forecasting, Deep learning},
abstract = {Accurate shale gas production forecasting is critical for energy resource management and development planning. Gas wells with similar geological characteristics and spatial proximity often exhibit comparable production trends, while their decline patterns are also influenced by the physical properties of reservoirs. Therefore, capturing the inter-well dependencies under the physical constraints governing production decline is essential for reliable forecasting. However, existing graph neural network (GNN)-based methods typically rely on static distance-based metrics to construct well networks, failing to capture the evolving inter-well dependencies across production stages. Furthermore, these methods rarely incorporate domain knowledge of production decline behavior, leading to predictions that violate physically realistic patterns. To address these limitations, we propose a dual temporal graph network with an empirical decline-informed module (DTG-EDI) for shale gas production forecasting. Our approach constructs well networks through both static graphs based on geological similarity and dynamic graphs that are inferred from temporal production patterns, with information fusion via gating mechanisms at both node and graph levels. A temporal graph aggregation module then aggregates information from neighboring wells via weighted message passing and captures dynamic dependencies through a gated recurrent architecture. Additionally, an empirical decline-informed module incorporates ensemble decline curve analysis (DCA) to enforce physical consistency in predictions. Experiments on real-world datasets from Region L22Region L represents a proprietary dataset from China, withheld due to confidentiality and privacy constraints. in China demonstrate that DTG-EDI significantly outperforms state-of-the-art methods across four production periods, with ablation studies validating the contribution of each component.}
}
@article{SU2026114967,
title = {UFFH-Net: An unsupervised fine-grained feature fusion hashing network for cross-modal retrieval},
journal = {Applied Soft Computing},
volume = {195},
pages = {114967},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114967},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004151},
author = {Liangliang Su and Yubin Liu and Pu Yan and Xiao Wei and Yalong Yang},
keywords = {Cross-modal retrieval, Unsupervised hashing, Semantic alignment, Attention mechanism},
abstract = {Unsupervised cross-modal hashing provides an efficient solution for large-scale retrieval tasks by enabling compact representation learning across modalities. However, existing methods remain fundamentally constrained by two critical issues stemming from the inherent lack of labeled data: inadequate modeling of cross-modal correlations and inaccurate semantic similarity estimation. To overcome these limitations, we propose a novel Unsupervised Fine-grained Feature Fusion Hashing Network (UFFH-Net) to enhance retrieval performance based on Hierarchical Cross-Modal Similarity Matrix (H-CMSM) and an Improved Spatial-Channel Attention Mechanism (I-SCAM). Specifically, the H-CMSM, constructed by fusing multi-order similarity relationships within and between modalities, obtains robust intra-modal feature representations and promotes inter-modal features alignment through Graph Convolutional Networks (GCNs). Furthermore, the I-SCAM, which integrates spatial and channel attention mechanisms, performs dual adaptive weighting operations across spatial positions and feature channels both before and after GCNs processing to facilitate features preserving critical visual details. Finally, we elaborate on two loss functions for hash code learning and hash function learning. By alternately optimizing these components, the enhanced features can be transformed into compact and discriminative hash codes. Extensive experimental results on two public datasets demonstrate that the proposed method achieves statistically significant improvement over other state-of-the-art methods in terms of both mean Average Precision (mAP) and Precision–Recall metrics.}
}
@article{OLGAC2026115064,
title = {Neural network based fuzzy cognitive reliability and error analysis method for risk assessment of hydrogen valley design under uncertain data},
journal = {Applied Soft Computing},
volume = {195},
pages = {115064},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115064},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005120},
author = {Elifnaz Olgaç and Ali Karaşan and İhsan Kaya},
keywords = {Hydrogen valley, Risk assessment, CREAM, Artificial intelligence, Fuzzy logic},
abstract = {Hydrogen Valleys are sustainable ecosystems that combine hydrogen that is a cost-effective, efficient, and environmentally friendly clean energy alternative for production, storage, and distribution operations. Safe and sustainable operations of these ecosystems require proactive risk assessment. This paper aims to develop a standardized risk assessment methodology that provides an expert-validated decision-support tool for the design phase of Hydrogen Valleys by proposing an integrated methodology that incorporates Artificial Intelligence (AI), the Cognitive Reliability and Error Analysis Method (CREAM), and the fuzzy set theory (FST). The structural model is designed with FST based DEMATEL integrated with fuzzy Cognitive Mapping (FCM). The weights derived from expert insight are then embedded as initial weights in a multilayer-perceptron based on the structural model. Then, Artificial Neural Networks (ANNs) are used for risk classification probabilities based on the CREAM’s common performance condition (CPC) concept. Finally, the ANN probabilistic outputs are converted into fuzzy membership grades for the fuzzy-inference system (FIS) to obtain overall risk index. The proposed methodology is applied for the case of Türkiye, an emerging hydrogen economy with proximity to energy demand points in both Europe and Asia. As result, inflation & interest-rate changes, failure to plan procurement processes, and uncertainties in policy and legal regulations are determined as the most crucial risk related to design of hydrogen valleys. The sensitivity and comparative analyses are also carried out to validation and verify the results. Based on the results and analyses, this paper contributes to applying knowledge and experiences from current operational and engineering fields to the hydrogen energy environment, to streamline its assessment process, and accelerate hydrogen energy development by applying machine-learning based fuzzy CREAM risk assessment methodology.}
}
@article{MINH2026114975,
title = {An integrated B-spline curves optimization framework with gradient learning capability for high-rise structural design and deep learning models},
journal = {Applied Soft Computing},
volume = {195},
pages = {114975},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114975},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004230},
author = {Hoang-Le Minh and Thanh Cuong-Le},
keywords = {Optimization algorithm, B-spline curves optimizer (BSO), Design optimization, Weight optimization, CEC2005, CEC2017, CEC2020, Engineering problems, B-spline curves},
abstract = {This research proposes a new optimization method based on the mathematical characteristics of B-spline curves, named the B-Spline Curves Optimizer (BSO). BSO introduces a fundamental improvement in mathematical formulation compared to conventional optimization algorithms. The key concept of BSO is to construct linear combinations of B-spline basis functions that describe the diversity of curves connecting the worst and best positions in each iteration. Through these curves, BSO clearly defines search spaces near the best and worst positions using an open knot vector, allowing the algorithm to flexibly design strategies that exploit promising regions or explore new ones to maintain balance between exploration and exploitation. By implementing the basis functions of B-spline curves, BSO establishes a mapping from the parametric space to the physical space, operating entirely within the parametric domain—where all parameters are normalized between zero and one—thus providing computational efficiency and stability. Moreover, the predefined combinations of basis functions allow BSO to compute derivatives of the curves, enabling gradient-like updates through a learning-rate parameter. Randomly generated control parameters introduce diversity to the search process, enhancing the algorithm’s robustness and global search capability. The performance of BSO is first validated through 23 standard benchmark functions, including CEC2005, CEC2017, and CEC2020, where it consistently outperforms other metaheuristic algorithms in accuracy and stability. To further evaluate its real-world applicability, BSO is applied to the optimization of a 50-story reinforced concrete building with a total height of 180 m, demonstrating its ability to solve large-scale, practical engineering problems with multiple design variables and stringent performance constraints. The results confirm that BSO is a powerful, efficient, and mathematically rigorous optimization algorithm with strong potential for application across various scientific and engineering domains. Source codes of BSO is publicly available at https://ceats.ou.edu.vn/us/-b-spline-curves-optimizer-bso-.html and https://ch.mathworks.com/matlabcentral/fileexchange/183397-b-spline-curves-optimizer-bso}
}
@article{CHEN2026115056,
title = {A population diffusion algorithm for energy-efficient distributed flexible job shop scheduling problem},
journal = {Applied Soft Computing},
volume = {195},
pages = {115056},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115056},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005041},
author = {Lexing Chen and Cheng Yang and Donglin Zhu and Taiyong Li},
keywords = {Flexible job shop scheduling, Hybrid algorithm, Energy-efficient, Population diffusion, Dynamical allocation of computational resources},
abstract = {Due to the different characteristics of heuristic and metaheuristic methods, an increasing number of hybrid algorithms have been designed to solve the flexible job shop scheduling problems (FJSPs). However, most existing hybrid algorithms employ metaheuristic methods that impose high standards on both convergence and diversity, which may lead to a waste of computational effort due to potential overlap with heuristics that primarily emphasize convergence. To achieve a more efficient cooperation between heuristics and metaheuristics—where the former focuses on convergence and the latter emphasizes diversity—this study proposes a population diffusion algorithm (PDA) for solving energy-efficient distributed flexible job shop scheduling problems (EDFJSPs). During population evolution, the convergence pressure is moderately relaxed to enrich the diversity of solutions, while a rough local search is applied to ensure the basic convergence of new solutions. Subsequently, a refined local search is performed on the elite archive to further enhance the quality of elite individuals. In addition, computational resources are dynamically allocated between heuristics and metaheuristics to improve overall efficiency. Experimental results on a series of problem instances demonstrate that the proposed PDA is promising for EDFJSPs.}
}
@article{SEO2026114991,
title = {Improving training efficiency for length-imbalanced translation data using optimal packing point},
journal = {Applied Soft Computing},
volume = {195},
pages = {114991},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114991},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626004394},
author = {Jeong Woo Seo and Ho-Young Jung},
keywords = {Machine translation, Data imbalance, Training efficiency, Optimization problems, Language modeling},
abstract = {Many translation datasets in the real world show an imbalanced sequence length distribution with a long tail. This imbalanced distribution causes an increase in the padding area since randomly sampled sequences consist of each batch. To utilize the padding area, we propose an approach to search for an optimal packing point and add a corresponding mask to the dot-product tensor derived from parallel source and target batches. Based on the characteristics of the imbalanced distribution, we design a searching algorithm that identifies the optimal point under the convexity condition per batch for packing and masking. The masking can obscure attention between different sequences within the same matrix while minimizing additional computational costs. This approach effectively reduces the number of batches and the training time for each epoch. We show 3.31 times speed-up for training time to reach the same translation performance compared to the traditional approach on imbalanced translation datasets.}
}
@article{ADIPRABOWO2026114933,
title = {Achieving a sustainable biodiesel implementation for performance prediction of marine diesel engine through interpretable machine learning and optimisation with bayesian framework},
journal = {Applied Soft Computing},
volume = {195},
pages = {114933},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114933},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626003819},
author = {Arya Bhaskara Adiprabowo and Fitra Hidiyanto and Rizqon Fajar and Nilam Sari Octaviani and Raditya Hendra Pratama and Sigit Tri Atmaja and Kurnia Fajar Adhi Sukra and Ardani Cesario Zuhri and Dhani Avianto Sugeng and Tata Sutardi},
keywords = {Biodiesel, Diesel engine performance, Machine learning, Bayesian optimisation, XAI},
abstract = {Several other countries, for example, Indonesia, plan to increase the mandated biodiesel percentage (BP) ratio to B40. This shift presents challenges in achieving optimal performance metrics, such as specific fuel consumption (SFC), thermal efficiency (TE), and torque, due to the variation of fuel properties and engine operating conditions. Therefore, we propose an integrated machine learning (ML)-based optimisation framework using Bayesian Optimisation (BO) for predicting and optimising the BP. Three decision tree-based models were optimised by BO, like Extreme Gradient Boost (XGB), Random Forest Regression (RFR), and Gradient Boosting Regressor (GBR), and compared against a fine-tuned Artificial Neural Networks (FT-ANN). Models were evaluated through R², mean absolute error (MAE), and mean absolute percentage error (MAPE). BO-XGB model demonstrated the highest accuracy for the SFC and TE predictions, achieving R² values of 0.992 and 0.965, MAE of 15.06 and 0.63, and MAPE of 2.7% and 4.7% respectively, while FT-ANN slightly outperformed BO-XGB with R², MAE and MAPE values of 0.987, 0.22 and 3.7% for the torque case. Multi-objective optimisation (MOO) was performed by using BO, Grey Wolf Optimisation (GWO) and Particle Swarm Optimisation (PSO) to identify the optimum engine performance parameters (OEPP) for maximising torque and TE while minimising SFC. The optimal settings, 1200 rpm engine speed, 4000 Watts load, 38–40% BP, and 60 °C BT, resulted in a torque of 16.79 Nm, SFC of 411.57 g/kWh and TE of 21.55%. The use of Shapley Additive Explanation (SHAP), incorporating SHAP interaction value (SIV), provides a comprehensive visualisation of the models by highlighting both synergistic and antagonistic effects. The proposed framework presents a scalable and interpretable solution for optimising biodiesel-fueled engine systems, supporting increased biodiesel penetration in maritime sectors.}
}