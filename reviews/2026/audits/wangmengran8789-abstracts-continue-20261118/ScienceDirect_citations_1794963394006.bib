@article{WU2026114146,
title = {Federated progressive evolutionary neural architecture search with three-phase acceleration for privacy-preserving medical image segmentation},
journal = {Applied Soft Computing},
volume = {186},
pages = {114146},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114146},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014590},
author = {Yu Wu and Hailong Fan and Zekun Zhou and Weiqin Ying and Zhenfeng Wu and Jinhuai Zhao and Fahong Yu},
keywords = {Medical image segmentation, Neural architecture search, Federated learning, Evolutionary algorithms, Privacy protection},
abstract = {Deep neural networks (DNNs) for medical image segmentation often require private data from multiple medical institutions, but privacy concerns limit data sharing. Federated learning (FL) offers a viable alternative to train networks across distributed private data. However, predefined network architectures for FL are often not optimal and require extensive manual tuning. Traditional neural architecture search (NAS) methods are unsuitable for FL due to the risk of privacy disclosure and high communication and evaluation costs. This paper proposes a federated progressive evolutionary NAS (FP-ENAS) method with three-phase acceleration to automatically generate neural architectures for privacy-preserving medical image segmentation. FP-ENAS constructs a tailored supernet and search space by enhancing U-Net++ with depthwise separable convolutions and adaptable skip connections. Then, FP-ENAS leverages a multi-objective evolutionary algorithm to search for its subnets with higher segmentation accuracy and fewer parameters. FP-ENAS adopts a three-phase hierarchical progressive acceleration mechanism to significantly reduce communication and evaluation costs of federated NAS. Specifically, the mechanism employs a federated weight sharing strategy, federated low-fidelity evaluation strategy, and federated online surrogate prediction strategy in the early, middle, and advanced phases, respectively, to balance the efficiency and accuracy of evaluations. This method accelerates the search process while maintaining high performance and ensuring privacy protection. Experimental results on the retinal vessel, brain tumor and skin lesion segmentation datasets show that FP-ENAS automatically and efficiently generates multiple excellent architectures with different sizes. They outperform several popular hand-crafted networks in terms of segmentation accuracy and model size for privacy-preserving medical image segmentation. Compared with the standard U-Net, the architectures generated by FP-ENAS yield the improvements of up to 2.27 and 1.94 % points respectively in the DICE score on the retinal vessel and brain tumor datasets, while requiring 31.1 % and 17.7 % fewer parameters.}
}
@article{ZHANG2026114194,
title = {MultiDampGen: A self-constraint latent diffusion framework for multiscale energy-dissipating microstructure generation},
journal = {Applied Soft Computing},
volume = {186},
pages = {114194},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114194},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015078},
author = {Tianyang Zhang and Weizhi Xu and Shuguang Wang and Dongsheng Du},
keywords = {Deep learning, Latent Diffusion, Multiscale, Inverse design, Damping microstructures},
abstract = {This study proposes MultiDampGen, a physics‑informed latent diffusion framework that generates multiscale, shear‑dominated damping microstructures aimed at seismic energy dissipation. The framework integrates a topology transformer (TopoFormer) for attention-enhanced latent compression, a residual-based self-constraint validator (RSV) for direct hysteresis prediction, and a latent diffusion physics mapper (LDPM) for conditional synthesis. A dataset comprising 50,000 finite‑element–computed hysteresis curves under cyclic shear loading was constructed as the foundation of the proposed framework. Experimental results show that TopoFormer achieves a structural similarity index (SSIM) of 0.998 while reducing generative complexity by over 90 %, and RSV predicts complete hysteretic responses with an R² exceeding 0.98. MultiDampGen can generate microstructures meeting specified mechanical performance and scale requirements with deviations within 10 %, even under conflicting constraints such as a large scale combined with low load‑bearing capacity. The framework enables efficient exploration of non-intuitive yet physically consistent designs, advances the application of generative artificial intelligence in earthquake engineering, and offers new insights for the development of next-generation energy dissipation systems.}
}
@article{CHENG2026114135,
title = {An expensive multi-objective evolutionary algorithm based on grid and relation learning},
journal = {Applied Soft Computing},
volume = {186},
pages = {114135},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114135},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014486},
author = {Yan Cheng and Jiaqi Wang and Gongcheng Yu and Yuxiao Yao and Yanyin Chen and Guowei Li},
keywords = {Evolutionary algorithms, Expensive multi-objective optimization, Surrogate-assisted optimization, Relation learning, Grid},
abstract = {In many real-world applications, there is often a need to optimize multiple objectives, which are frequently and simultaneously conflicting. The evaluation process consumes computational resources or funds, making it difficult to provide adequate function evaluations for converging evolutionary algorithms. Surrogate models have become an effective solution for obtaining more virtual evaluations, particularly when computational resources are limited. Most existing surrogate models are either regression-based or classification-based, and their performance heavily depends on the quality of training data. Imbalanced datasets may significantly impact the quality of surrogate models. To address this, a relationship-based surrogate-assisted evolutionary algorithm is proposed in this paper. This algorithm utilizes the surrogate model to compare candidate solutions rather than directly predicting the fitness values of solutions. This can better balance positive and negative samples. Considering the characteristics of data generated during optimization, a grid-based data partitioning method is used to discretize the objective space into grids. A balanced training dataset is created based on the grid positions, and a classifier is built to learn relationships from the training dataset. A reference point selection mechanism is introduced to choose reference points using reference vectors, thereby filtering out promising solutions. The proposed method was validated using the Wilcoxon rank-sum test (α=0.05) on 88 benchmark test instances and one real-world engineering optimization problem. Experimental results demonstrate that the proposed method achieves statistically significant optimal results (p<0.05) in 62 instances compared to state-of-the-art surrogate-assisted evolutionary algorithms.}
}
@article{BABIC2026114143,
title = {A multivariate methodology combining recurrent neural networks with the modified variable neighborhood search algorithm for unemployment forecasting},
journal = {Applied Soft Computing},
volume = {186},
pages = {114143},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114143},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014565},
author = {Lepa Babic and Luka Jovanovic and Jelena Cadjenovic and Mahmoud Mohamed Elsayed and Mohamed Hammad and Miodrag Zivkovic and Vladimir Simic and Nebojsa Bacanin},
keywords = {Multivariate forecasting, Recurrent neural networks, Metaheuristic optimization, Swarm intelligence, Variable neighborhood search},
abstract = {Tracking unemployment trends is a vital task as it serves as a critical indicator of economic health, influencing decisions on job creation, monetary policies, and workforce development. Beyond economic implications, unemployment fluctuations affect social well-being, public health, and social stability. Predicting unemployment rates allows governments, economists, and businesses to forecast labor market dynamics and make informed strategic decisions. While traditional forecasting methods like time series analysis have been widely used, they often struggle with capturing complex, nonlinear patterns in data, leading to reduced predictive accuracy. Machine learning models, particularly recurrent neural networks (RNNs) and their advanced variants, such as gated recurrent units (GRUs), offer promising alternatives by handling large datasets, uncovering hidden patterns, and adapting to dynamic economic conditions. However, challenges such as data quality, interpretability, and the need for customized hyperparameter optimization persist. This study proposes a hybrid RNN and GRU-based approach for unemployment forecasting, employing a modified variable neighborhood search algorithm for hyperparameter tuning. Furthermore, Shapley additive explanations (SHAP) analysis is conducted to amplify interpretability by elucidating model behavior and feature importance. The experimental findings reveal the potential of this hybrid methodology for improving forecast accuracy and decision-making reliability with simulations carried out on real-world data that yield a mean squared error of just 0.005567 for the best-performing model.}
}
@article{LI2026114149,
title = {Hybrid learning with multi-scale graphs for enhanced garment deformation approximation},
journal = {Applied Soft Computing},
volume = {186},
pages = {114149},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114149},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014620},
author = {Tianxing Li and Rui Shi and Qing Zhu and Takashi Kanai},
keywords = {Clothing deformation, Hybrid learning, Graph pooling, Attribution analysis},
abstract = {Due to the complex behavior of clothing, modeling fine-scale garment deformation on arbitrary meshes within a unified network presents a considerable challenge. Current methods often fail to learn generalized patterns that adhere to physical laws in a controllable manner, compromising efficiency and realism in practical applications. To overcome these limitations, we introduce a novel hybrid learning approach that accurately simulates garment dynamics and intricate details. The core of our method is a progressive learning scheme that integrates the accuracy of supervised learning with the physical awareness derived from unsupervised learning. Additionally, after analyzing the nature of the garment self-collision problem, we introduce vertex repulsion-based constraints that effectively prevent conspicuous intersections within the mesh while preserving fine details. Finally, to ensure effective propagation of node information across the mesh, we propose a multi-scale graph processing technique for the garment deformation task, featuring structure-preserving pooling and unpooling strategies that significantly enhance result quality. The experimental results demonstrate that our method outperforms the state-of-the-art under multiple metric evaluations.}
}
@article{YU2026114181,
title = {A sophisticated computational approach for flexural strength prediction and mix proportion optimization of steel fiber-reinforced concrete},
journal = {Applied Soft Computing},
volume = {186},
pages = {114181},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114181},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014942},
author = {Yong Yu and Jie Su and Bo Wu},
keywords = {Steel fiber reinforced concrete, Flexural strength, Bayesian model updating, Life-cycle assessment, Mix proportion optimization},
abstract = {Accurately predicting the load-bearing performance of steel fiber-reinforced concrete (SFRC) and improving its sustainability remains a critical challenge in civil engineering. This study addresses these challenges via a soft computing framework that integrates Bayesian model updating, lifecycle evaluation and multi-objective optimization at the material scale. Based on 195 flexural peak strength tests, Bayesian updating produced predictive formulations incorporating key internal mix parameters. Subsequently, life cycle assessment coupled with a non-dominated sorting evolutionary method was employed to evaluate sustainability indicators and optimize mix designs, balancing mechanical performance, cost and carbon emissions. Principal observations are as follows: (i) The five identified variables strongly affect SFRC’s flexural strength. Maximum gravel size and aggregate-to-cement ratio negatively influence strength, whereas cement content, sand ratio and fiber reinforcement coefficient exert positive effects. (ii) Bayesian model updating, with or without prior regression models, outperforms multiple linear regression, improving flexural strength prediction accuracy by 6.2 %. (iii) Increasing aggregate to cement and sand ratios reduces production costs and carbon emissions without compromising strength, while maximum aggregate size has minimal impact. Higher fiber content, however, substantially raises both cost and emissions, necessitating careful mix design. (iv) Optimized mix proportions meet target strength while cutting carbon emissions and costs by 30 %–50 %. Back-calculation indicates steel fibers are unnecessary below 6.0 MPa, with optimal dosages of 1 % for 10 MPa and 2 % for 12 MPa. Overall, the proposed soft computing framework effectively guides SFRC mix design and promotes material sustainability.}
}
@article{XUE2026114145,
title = {Evolutionary neural architecture search based on pre-trained surrogate model},
journal = {Applied Soft Computing},
volume = {186},
pages = {114145},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114145},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014589},
author = {Yu Xue and Lilian Yuan and Weilin Fang and Mohammad Kamrul Hasan and Khursheed Aurangzeb},
keywords = {Surrogate model, Evolutionary neural architecture search, Zero-cost evaluation},
abstract = {Evolutionary neural architecture search (ENAS) has been widely applied in the automated design of neural network architectures due to its high parallelism and robustness. However, the ENAS method usually relies on surrogate models to accelerate the evaluation of candidate architectures. Existing surrogate models face cold start problems such as sample scarcity and insufficient training in the early stages of the search, resulting in low search efficiency and inaccurate performance evaluation, which limits the effectiveness of ENAS in practical scenarios. In response to the above issues, this paper proposes an evolutionary neural architecture search method based on pre-trained surrogate model (PTENAS). This method introduces the Sample-score mechanism to evaluate a large number of unknown architectures. By constructing a large number of high-quality simulation samples, it performs zero-cost pre-training of surrogate models in the offline stage, significantly improving their initial prediction capabilities. Sample-score is also used to filter for potentially high-quality individuals, optimize the initial population of the evolutionary algorithm, improve search efficiency, and accelerate convergence. In addition, we propose a surrogate model update pattern that can efficiently screen candidate architectures throughout the entire evolution process of ENAS. Experimental results demonstrate that PTENAS achieves 94.20 % average test accuracy on NAS-Bench-101 with only 400 queries, and can identify the optimal architecture on NAS-Bench-201 with just 200 queries. Ablation experiments verify the effectiveness of PTENAS in solving the cold start problem of surrogate models and improving the efficiency of ENAS.}
}
@article{LI2026114188,
title = {Disentangling consistent, complementary and modality-private information via twin information bottleneck for multi-modal clustering},
journal = {Applied Soft Computing},
volume = {186},
pages = {114188},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114188},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015017},
author = {Mingyuan Li and Dongqing Liu and Chao Wang and Qianqian Ma and Yadong Dong},
keywords = {Deep clustering, Multi-modal clustering, Information bottleneck, Mutual information, Complementary information},
abstract = {Multi-modal clustering seeks to uncover latent data patterns by leveraging inter-modal consistency (e.g., text, image, video, audio). While existing methods demonstrate promising results, they often fail to address the proliferation of modality-private information, which can obstruct consistent inter-modal information extraction. Moreover, by categorizing all inconsistent information as modality-private information, these approaches inadvertently disregard the critical complementarity inherent to multi-modal data. To address these limitations, we propose the Twin Information Bottleneck (TIB), a novel framework for multi-modal clustering that systematically disentangles consistent, complementary, and modality-private information of multiple modalities. Our approach comprises three key innovations: (1) Theoretical Formalization: We establish an information-theoretic framework to rigorously define and quantify consistency, complementarity, and modality-private information. (2) Compression-Driven Optimization: TIB reframes multi-modal clustering as a selective compression task, maximally preserving the most consistent and complementary information while discarding modality-private information. (3) Unified Objective Function: A joint optimization strategy simultaneously maximizes consistent, complementary information preservation and modality-private information elimination. To our knowledge, this is the first work to theoretically delineate these three information types in multi-modal clustering. Experiments on six benchmarks demonstrate TIB’s superiority over 20 state-of-the-art baselines, experimentally confirming its efficacy.}
}
@article{MACHADOPACHECO2026114139,
title = {Graph neural networks for the offline nanosatellite task scheduling problem},
journal = {Applied Soft Computing},
volume = {186},
pages = {114139},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114139},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014528},
author = {Bruno {Machado Pacheco} and Laio Oriel Seman and Cezar Antonio Rigo and Eduardo Camponogara and Eduardo Augusto Bezerra and Leandro {dos Santos Coelho}},
keywords = {Scheduling, Graph neural network, Combinatorial optimization, Nanosatellite, Deep learning},
abstract = {This study investigates how to schedule nanosatellite tasks more efficiently using Graph Neural Networks (GNNs). In the Offline Nanosatellite Task Scheduling (ONTS) problem, the goal is to find the optimal schedule for tasks to be carried out in orbit while taking into account Quality-of-Service (QoS) considerations such as priority, minimum and maximum activation events, execution time-frames, periods, and execution windows, as well as constraints on the satellite’s power resources and the complexity of energy harvesting and management. This study explores the use of Graph Neural Networks (GNNs) as primal heuristics for the ONTS problem, as this class of deep learning models has been effectively applied to optimization problems such as the traveling salesman, scheduling, and facility placement. We investigate whether GNNs can learn the complex structure of the ONTS problem with respect to feasibility and optimality of candidate solutions. Furthermore, we evaluate using GNN-based heuristic solutions to provide better solutions (w.r.t. the objective value) to the ONTS problem and reduce the optimization cost. Our experiments show that GNNs are not only able to learn feasibility and optimality for instances of the ONTS problem, but they can generalize to harder instances than those seen during training, addressing the data acquisition cost of training deep learning models on optimization problems. On top of that, the GNN-based heuristics improved the expected objective value of the best solution found under the time limit by 45 %, and reduced the expected time to find a feasible solution by 35 %, when compared to the SCIP (Solving Constraint Integer Programs) solver in its off-the-shelf configuration.}
}
@article{LIU2026114140,
title = {Intelligent generation and reasoning method for aviation assembly knowledge graph based on joint knowledge embedding learning},
journal = {Applied Soft Computing},
volume = {186},
pages = {114140},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114140},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501453X},
author = {Peifeng Liu and Yuhao Zhang and Yisheng Yang and Xingwei Zhao and Bo Tao},
keywords = {Knowledge graph, Large language model, Knowledge embedding learning, Aviation assembly, Intelligent manufacturing},
abstract = {The field of aviation assembly is characterized by high system complexity and nontrivial operations. Currently, the knowledge assistance in this field is mainly based on assembly technical manuals, and the document format is mostly unstructured, lacking structured descriptive information. Therefore, knowledge-assisted technology faces challenges such as insufficient accuracy in structured knowledge construction and limited interpretability of reasoning. To address the above problems, this paper proposes a knowledge graph intelligent generation and reasoning framework based on joint knowledge embedding learning. Traditional keyword-based semantic retrieval knowledge assistance is insufficient for global knowledge and context reasoning. In the proposed framework, the prior domain knowledge is embedded in a large language model through knowledge embedding learning for intelligent generation of structured knowledge graphs. Then, the generated knowledge graph will be vectorized in a low-dimensional space in the form of subgraph sets by knowledge embedding learning, facilitating knowledge reasoning in the given domain. Verification experiments of aviation assembly knowledge graph construction and auxiliary decision-making are conducted. The results show that the accuracy of proposed knowledge graph generation reaches 91.33 %, and the accuracy of knowledge reasoning is 96.55 %. This method provides an efficient technical solution for knowledge management and application in the field of aviation assembly.}
}
@article{ZHONG2026113939,
title = {PowerGPT: A multimodal foundation model for power inspection},
journal = {Applied Soft Computing},
volume = {186},
pages = {113939},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.113939},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625012529},
author = {Yangyang Zhong and Pengxin Luo and Yunfeng Yan and Tong Jia and Donglian Qi},
keywords = {Intelligent power inspection, Domain-specific multimodal dataset, Vision-language model, PowerGPT, PowerBENCH},
abstract = {The scarcity of domain-specific data and models in power inspection has severely impeded progress toward intelligent inspection systems. To address this challenge, we propose a unified data–algorithm framework for the power domain. First, we construct the Power Safety Instruction Dataset (PSID), a large-scale multimodal instruction dataset containing approximately 200,000 power images and 800,000 instruction–answer pairs for training models in power safety supervision. Second, we introduce PowerBENCH, a comprehensive evaluation benchmark covering 70 power safety scenarios and five standardized supervision tasks—Grounded Caption (GC), Referring Expression Comprehension (REC), Referring Expression Generation (REG), Counting, and Knowledge (KNO). Building upon these resources, we develop PowerGPT, a large-scale multimodal model with visual understanding and semantic reasoning capabilities tailored to the power domain. On PowerBENCH, PowerGPT achieves absolute score gains over the previous baseline LLaVa of +2.8, +2.6, +0.7, +2.6, and +1.8 (maximum score = 10) in GC, REC, REG, Counting, and KNO, respectively. Even compared to a strong recent general-purpose model, InternVL2.5, PowerGPT delivers gains of +0.9, +0.6, +0.6, +0.4, and +1.5 on these tasks. These results demonstrate that our unified framework provides robust algorithmic and data support for advancing intelligent power inspection.}
}
@article{WU2026114196,
title = {A three-state three-way decision model integrating intuitionistic fuzzy sets and improved D-S evidence theory for complex decision-making},
journal = {Applied Soft Computing},
volume = {186},
pages = {114196},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114196},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015091},
author = {Meiqin Wu and Jin Fu and Jianping Fan},
keywords = {Three-way decision, D-S evidence theory, Intuitionistic fuzzy sets, Conflicting evidence, Loss function},
abstract = {Complex decision-making is often fraught with challenges related to fuzziness and evidential conflict, which pose significant difficulties for traditional two-state Three-Way Decision (TWD) models. These models, due to their lack of a mechanism to describe an uncertain state, often fail to fully capture the complexity of real-world decisions. Furthermore, the commonly used Dempster’s combination rule may yield counter-intuitive results when fusing highly conflicting evidence. To address these issues, this paper proposes a novel Three-State Three-Way Decision (TSTWD) model that integrates Intuitionistic Fuzzy Sets (IFS) and an improved D-S Evidence Theory (DST). Specifically, the model first introduces a new uncertain state, constructing a three-state decision framework that provides a more comprehensive description of decision states. A mapping mechanism is established to convert IFS evaluations into Basic Probability Assignments (BPA), replacing traditional conditional probability. Secondly, to tackle the problem of evidence conflict, a dynamic discounting method based on evidence credibility and belief entropy is proposed. This method preprocesses the evidence, effectively enhancing the robustness of the fusion process. Finally, to validate the effectiveness of the proposed model, it is applied to a smart bracelet selection case study. Comparative experiments with various Multi-Attribute Decision-Making (MADM) and TWD methods are conducted. The results demonstrate that the proposed model exhibits high consistency with other methods in alternative ranking and shows superior accuracy in TWD region division. This study provides an effective tool for decision-making under complex and uncertain environments.}
}
@article{REN2026114206,
title = {Sustainability-oriented product conceptual innovation design method based on evolution potential prediction},
journal = {Applied Soft Computing},
volume = {186},
pages = {114206},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114206},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015194},
author = {Zeyuan Ren and Peng Zhang and Yuexuan Hou and Zifan Ma and Hongxiang Wang},
keywords = {Sustainability, Conceptual design, Laws of technological system evolution, Neural architecture search, Dust removal device for photovoltaic system},
abstract = {Sustainable development is crucial for resolving the environment-economy conflict. Increasingly tight coupling between systems and environments raises the risk of system failure due to environmental disturbances. Traditional conceptual design focuses on function-structure mapping but often neglects the dynamic influence of environmental factors, leading to poor environmental adaptability and shortened lifecycles. This study proposes a sustainable product conceptual design method based on evolution potential prediction to address this gap. Firstly, the affected functions are identified by analyzing the ultimate conflict area, followed by constructing a network of physical parameter relationships represented by parameter groups. Subsequently, historical sample data is utilized to train a prediction model of laws of technological system evolution using the neural architecture search. Finally, by comparing the current product state with the recommended technological system evolution law, the potential evolution state of the product system is identified, inspiring designers to generate innovative concepts. The validity of the method is substantiated by the prototype design and experimental research of the dust removal device for the photovoltaic system. Results demonstrate that analyzing environmental impacts through physical parameters and predicting system evolution potential can generate solutions with enhanced environmental adaptability, showing promising prospects for sustainable product innovation.}
}
