@article{SONG2026114209,
title = {Dual-student co-training network using Mamba and unreliable sample learning with class-adaptation for hyperspectral image classification},
journal = {Applied Soft Computing},
volume = {186},
pages = {114209},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114209},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015224},
author = {Xiqun Song and Feng Zhao and Junjie Zhang and Hanqiang Liu and Liuwei Xu},
keywords = {Hyperspectral image classification, Dual-student co-training network, Unreliable sample learning, Mamba},
abstract = {Current supervised learning-based hyperspectral image (HSI) classification methods usually require abundant labeled data, which demands significant computational costs. Although semi-supervised learning-based methods can utilize slight labeled data and abundant unlabeled data to achieve HSI classification, the sparsity of labeled data tends to cause the model to reach a performance bottleneck in hyperspectral scenes with the complex land-cover distribution. Aiming at the above challenge, a dual-student co-training network using Mamba and unreliable sample learning with class-adaptation (DCN-MUSL) is proposed for semi-supervised HSI classification in this paper. Firstly, an uncertainty-guided teacher-student collaborative framework (UTCF) is designed, consisting of two student networks and one teacher network, to encourage the two student networks to maintain diversity during collaborative training and enhance the learning ability for pseudo-labels. Secondly, to learn the classification difficulty of different categories and utilize unreliable samples effectively, an unreliable sample learning with class-adaptation (USLCA) strategy is designed, which can dynamically assign thresholds for categories with different classification difficulties, and learn the category samples below the threshold through pseudo-negative labels. Finally, a novel dual-branch hybrid network with Mamba and convolutional neural network (MCDHN) is proposed as the teacher-student network to capture long-range dependencies and local characteristics with high computational and memory efficiency. Overall accuracies of DCN-MUSL on University of Pavia, Salinas Valley, and Houston 2013 datasets are 97.60 %, 98.24 %, and 95.87 %, respectively. The classification results confirm the effectiveness of DCN-MUSL compared with state-of-the-art methods.}
}
@article{BHAMBU2026114136,
title = {Deep random vector functional link transformer network with multiple output layers for significant wave height forecasting},
journal = {Applied Soft Computing},
volume = {186},
pages = {114136},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114136},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014498},
author = {Aryan Bhambu and Ruobin Gao and Ponnuthurai Nagaratnam Suganthan and Natarajan Selvaraju},
keywords = {Forecasting, Transformer, Multiple output layers, Time series, Deep ensemble random vector functional vector link, Deep neural networks, Ensemble learning, Randomized neural networks},
abstract = {Accurate control of wave energy devices relies heavily on precise forecasts of wave heights, yet the dynamic and fluctuating nature of historical wave data presents significant challenges to achieving this precision. Neural networks help address this issue by extracting meaningful patterns from past observations to improve wave height predictions. This paper introduces a novel random vector functional link transformer (RFT) and ensemble deep random vector functional link transformer (edRFT) networks to capture the dynamic characteristics of significant wave heights. The model employs hidden blocks based on transformer encoders to effectively capture complex sequential dependencies in the data. The proposed model incorporates randomly initialized and fixed weights for the hidden layers to ensure stability during training. Stacked hidden layers are incorporated to facilitate deep representation learning, allowing the extraction of complex patterns from the data. Forecasts are generated by integrating the outputs of each layer using an ensemble approach. The computational results demonstrate the superiority of the proposed models through a comparative analysis against state-of-the-art approaches across fifteen significant wave height time series, validated by three error metrics and a statistical test.}
}
@article{TERESAMINAMIBORGES2026114123,
title = {A directed genetic algorithm for economic dispatch and network-constrained economic dispatch: Convergence proof},
journal = {Applied Soft Computing},
volume = {186},
pages = {114123},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114123},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501436X},
author = {Lívia {Teresa Minami Borges} and Fabiano {Borges da Silva} and Edilaine {Martins Soler} and Leonardo Nepomuceno},
keywords = {Optimization, Metaheuristic, Economic dispatch, Valve-point loading effect, Prohibited operating zones, Markov chain, Average convergence rate},
abstract = {This work proposes the Directed Genetic Algorithm (DGA) and demonstrates its global convergence through tools from the theory of stochastic dynamic systems. The DGA is primarily designed to solve the Economic Dispatch Problem with Valve-point loading and Prohibited Zones (EDPVPZ) representation, and the proposed Network-Constrained EDPVPZ (NC-EDPVPZ), which are multimodal, non-convex, non-differentiable, and discontinuous optimization problems in the field of power systems. Both problems are concerned with the calculation of the optimal generation dispatch, while taking into account physical and operational constraints related to the generation and transmission systems. Since these problems often have solutions concentrated at singular points of their objective functions, we introduce the innovative concept of a “pivot individual”, which aims to explore these singular points and improves the algorithm’s convergence rate and enables the discovery of optimal solutions by directing the search towards problem singularities. We also provide a formal proof that the cost associated with the best individual in the DGA population converges almost surely to the global minimum cost. We derive a computationally efficient linear model for the transmission network for the NC-EDPVPZ, where both losses and power flow limits are enforced for all individuals in the population. The fast computational feature of the proposed network model suggests its suitability for use within other metaheuristic approaches. We solve the NC-EDPVPZ for systems with up to 300 buses. To assess the performance of the DGA, we calculate the average convergence rate metric and conduct comparative analyses with the classical real-coded Genetic Algorithm (GA), Collaborative Optimization Differential Evolution (CODE), Particle Swarm Optimization (PSO), Covariance Matrix Adaptation Evolution Strategy (CMA-ES), Chaotic Adaptive Differential Evolution with Optional External Archive (CJADE), and Hybrid Sampling Evolution Strategy (HSES). Furthermore, the introduction of new genetic operators significantly improves the quality of optimal solutions compared to those obtained by traditional methods. The performance of the DGA is also compared using non-parametric statistical tests, involving the Wilcox signed-rank test, the Friedman test and the Nemenyi test. These results reveal that the DGA is competitive with the state-of-the-art methods for solving the EDPVPZ.}
}
@article{ZHU2026114150,
title = {A hyper-heuristic algorithm based on genetic and greedy strategy for university course scheduling problem},
journal = {Applied Soft Computing},
volume = {186},
pages = {114150},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114150},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014632},
author = {Zizhuang Zhu and Yongquan Zhou and Qifang Luo},
keywords = {University course scheduling optimization, Multi-dimensional soft constraints, Hyper-heuristic algorithm, Genetic algorithm, Greedy strategy},
abstract = {The University Course Scheduling Problem (UCSP) is a typical NP-hard problem that requires efficient allocation of resources such as classrooms, teachers, and timeslots while satisfying hard and soft constraints. Most universities still rely on manual scheduling, which is time-consuming and often leads to unreasonable resource allocation. This study proposes a novel UCSP model that comprehensively incorporates multi-dimensional soft constraints for classes, teachers, courses, and classrooms, aiming to reduce teachers' workload, alleviate students' learning burden, and optimize classroom resource utilization. To solve this model, a hyper-heuristic algorithm integrating genetic and greedy strategies (GA_RG_HH) is proposed. In this algorithm, the genetic algorithm (GA) serves as the high-level heuristic, while the low-level heuristics consist of 4 random operators (R), 5 greedy operators (G), and 1 invalid operator (I). The algorithm balances exploration and exploitation by dynamically adjusting the length of the operator sequence and ensures constraint satisfaction through a pre-check strategy. Experimental results on real-world small-scale and large-scale instances demonstrate that GA_RG_HH outperforms traditional metaheuristic algorithms such as Tabu Search, Particle Swarm Optimization, Simulated Annealing and recent improved algorithms in minimizing soft constraint violations, verifying its effectiveness and superiority in practical course scheduling scenarios.}
}
@article{GRIMSTAD2026114198,
title = {A deep latent variable model for semi-supervised multi-unit soft sensing in industrial processes},
journal = {Applied Soft Computing},
volume = {186},
pages = {114198},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114198},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501511X},
author = {Bjarne Grimstad and Kristian Løvland and Lars Struen Imsland and Vidar Gunnerud},
keywords = {Soft sensor, Semi-supervised learning, Deep latent variable model, Variational inference, Neural network},
abstract = {Scarcity of labeled data limits the development of data-driven soft sensors for many industrial processes. However, there are often opportunities to learn stronger models by exploiting process knowledge and being more data-efficient. Two opportunities, which frequently occur in industrial data, are learning unsupervised from unlabeled data and learning supervised across similar process units. Motivated by the lack of existing methods that jointly address these opportunities, we introduce a deep latent variable model for semi-supervised multi-unit soft sensing. The hierarchical, generative model describes a data-generating process for multiple similar process units and facilitates learning from unlabeled data. An empirical study of multi-unit soft sensing is conducted using three datasets: a benchmark dataset from a simulated sulfur recovery unit, a synthetic dataset of single-phase fluid flow, and a large, real dataset of multi-phase flow in oil and gas wells. We show that by combining semi-supervised and multi-task learning across multiple process units, the proposed method achieves superior results when unlabeled data is available. In the real well data case, it outperforms a leading method for supervised multi-unit soft sensing, lowering the average test error by approximately 9 %. We also show that a trained model may be fine-tuned to previously unseen units using only a handful of data points. Interestingly, the soft sensor performance for a new unit is slightly improved by fine-tuning to unlabeled data only. This demonstrates that some unit properties that are predictive to the soft sensor task can be learned unsupervised.}
}
@article{ZHAO2026114212,
title = {Quantum-inspired multi-step trust region policy optimization for integrated rotor angle stability control of time-varying renewable energy sources},
journal = {Applied Soft Computing},
volume = {186},
pages = {114212},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114212},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501525X},
author = {Lulin Zhao and Linfei Yin},
keywords = {Trust region policy optimization, Quantum technology, Static stability, Transient stability, Dynamic stability, Renewable energy sources},
abstract = {The rapid expansion of renewable energy sources increasingly challenges the rotor angle stability control of renewable source systems. Rotor angle fluctuations in renewable systems are inherently integrated, encompassing static, transient, and dynamic modes. This work proposes a quantum-inspired multi-step trust region policy optimization for the integrated rotor angle stability of time-varying renewable sources systems. The proposed approach combines multi-step reinforcement learning and quantum-inspired technology to provide real-time accurate and robust actions with the capability of updating control strategy online in long-term optimization. This study designs four cases with three rotor angle stability disturbances and time-varying systemic parameters to test the proposed approach for complex situations. The numeric results show that the proposed method with more robust characteristics obtains at least 9.02 % smaller rotor angle error fluctuation than proportional-integral-derivative, fuzzy logic control, Q learning, Q(λ) learning, and trust region policy optimization when the system suffers comprehensive disturbances.}
}
@article{HE2026114174,
title = {Modelling and simulation of distributed target allocation based on improved NSGA-II in multi-UUV collaborative attack},
journal = {Applied Soft Computing},
volume = {186},
pages = {114174},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114174},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014875},
author = {Guoyuan He and Anqi Chen and Liwei Xuan and Xiaoying Li and Honglong Chang and Guangmin Yuan and Jianfeng Bai and Yun Niu and Mingyong Liu},
keywords = {Distributed target allocation, Multi-UUV collaborative attack, Improved NSGA-II, Modelling and simulation},
abstract = {In multi-UUV collaborative attack, a reasonable weapon-target allocation scheme is very important to improve the attack efficiency. The quality and computation time of the solution are the key indices to evaluate the performance of the weapon-target algorithm. At present, the swarm intelligence optimization algorithm represented by genetic algorithm is often used to solve the weapon-target allocation problem, but this method usually adopts the centralized programming solution. Although it can achieve better solution quality, the solution process has disadvantages such as large computation and long time, which limits its application in practice. To solve these problems, this paper proposes a distributed improved non-dominated sorting genetic algorithm-II (DINSGA-II), which includes adaptive crossover and mutation strategies and distributed elite interaction strategies. In addition, we have developed a multi-UUV coordinated attack simulation platform based on XSimStudio using component-based modelling techniques. Finally, the proposed distributed target allocation algorithm is compared with the traditional centralized NSGA-II algorithm on the developed simulation platform. The results show that both algorithms can find a reasonable allocation scheme, but in terms of computational speed, the running time of the DINSGA-II algorithm is about 12 times faster than that of the traditional centralized NSGA-II algorithm with the same problem size.}
}
@article{CAITITE2026114180,
title = {Random projection large margin algorithm for binary classification problems},
journal = {Applied Soft Computing},
volume = {186},
pages = {114180},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114180},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014930},
author = {Vítor Gabriel Reis Caitité and Raul Fonseca Neto and Frederico Coelho and Antønio Pádua Braga},
keywords = {Random projection, Large margin classifiers, Pruning of neurons, Binary classification},
abstract = {In this work, important properties of large-margin classifiers for tabular data were studied, encompassing their ability to generalize, their robustness to noisy data, their overall performance and capacity to control overfitting. To address these concepts, a large margin learning algorithm was proposed for single hidden layer feedforward networks (SLFNs) with random projections. This algorithm was named RP-IMA, and its core idea involves randomly assigning weights to the hidden layer and subsequently utilizing an incremental margin algorithm (IMA) to compute the output layer weights of the SLFN for binary classification tasks. The IMA approach involves iteratively determining solutions to classification problems while progressively increasing the margin values, thus yielding a substantial margin outcome for the output layer. The effectiveness of this method was evaluated with experiments conducted on synthetic and benchmark datasets. The results of the hard margin measurements demonstrated that these models were capable of achieving notably higher margins in comparison to the Extreme Learning Machine (ELM). Across a range of metrics including accuracy, precision, recall, and F1-score, RP-IMA outperformed ELM in the majority of scenarios. Specifically, RP-IMA achieved an average accuracy of approximately 88.4% (calculated as the average of the accuracies obtained for each of the 17 benchmark datasets), significantly outperforming the standard ELM configuration with the same large network architecture (≈72.3%) and proving highly competitive with Support Vector Machine with a radial basis function kernel (≈89.4%) and Large Margin Nearest Neighbor (≈87.5%). Additionally, RP-IMA generated separation margins in the feature space that were orders of magnitude larger than those achieved by ELM on synthetic datasets. Lastly, a strategy for neuron pruning was proposed for the L∞ formulation of RP-IMA (RP-IMA∞), involving the removal of hidden neurons associated with low-magnitude output weights. Experimental outcomes illustrated that this pruning approach significantly reduced the neural network architecture by up to 90% (e.g., from 150 to 12 nodes for the Iris dataset at σ=10%) while maintaining performance levels. This strategy facilitated the creation of more streamlined and efficient models without compromising classification performance.}
}
@article{SRIPRATEEP2026114176,
title = {Reinforcement learning-driven adaptive intelligence for phytochemical optimization in cannabis cultivation using precision agriculture},
journal = {Applied Soft Computing},
volume = {186},
pages = {114176},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114176},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014899},
author = {Keartisak Sriprateep and Rapeepan Pitakaso and Surajet Khonjun and Sarayut Gonwirat and Peerawat Luesak and Thanatkij Srichok and Sarinya Sala-Ngam and Yottha Srithep and Rungwasun Kraiklang},
keywords = {Cannabis, Reinforcement Learning, Phytochemical Optimization, Precision Agriculture, Soft Computing},
abstract = {Optimizing cannabis cultivation to enhance phytochemical production requires navigating complex, non-linear interactions among environmental factors including soil composition, nutrient management, planting density, and harvest timing. Traditional single-factor optimization approaches fail to address multi-objective trade-offs inherent in maximizing competing phytochemicals—tetrahydrocannabinol (THC), cannabidiol (CBD), tetrahydrocannabivarin (THCV), cannabinol (CBN), and terpenes—simultaneously. This study develops and validates an integrated framework combining D-optimal (determinant-optimal) experimental design, regression modeling, and Reinforcement Learning-driven Adaptive Multiple Intelligence System (RL-AMIS) for multi-objective cannabis cultivation optimization. Using "Hang Kra Rog Phu Phan," a Thai landrace cultivar, we conducted 73 strategically designed treatments under controlled greenhouse conditions to develop predictive models quantifying cultivation-phytochemistry relationships. RL-AMIS, benchmarked against standard metaheuristics (Artificial Bee Colony, Whale Optimization Algorithm, Differential Evolution, Particle Swarm Optimization, Genetic Algorithm, and original Adaptive Multiple Intelligence System), achieved superior computational performance with Hypervolume of 0.67 and Average Pareto Points of 1.6, compared to 0.36–0.40 for conventional approaches. Critically, field validation of one optimal parameter set across five replicate trials demonstrated that computationally optimized parameters achieved predicted phytochemical profiles with less than 0.3 % deviation, providing proof-of-concept that the framework bridges the theory-practice gap prevalent in agricultural optimization research. We position this as applied research emphasizing systematic integration and empirical validation rather than algorithmic novelty. While regression coefficients are cultivar-specific to "Hang Kra Rog Phu Phan," the optimization framework methodology is applicable to other cultivars requiring similar multi-objective phytochemical optimization, though each requires cultivar-specific parameterization. This work provides a validated, resource-efficient methodology (73 vs. 8748 full factorial runs) for evidence-based cultivation decisions and demonstrates the value of integrating computational optimization with precision agriculture for medical cannabis production under controlled conditions.}
}
@article{LIU2026114182,
title = {Terrain-aware morphology searching algorithm for self-reconfigurable modular robot in dynamic environment},
journal = {Applied Soft Computing},
volume = {186},
pages = {114182},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114182},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014954},
author = {Zekun Liu and Qiang Lu and Jake Luo and Zhiguang Wang},
keywords = {Self-reconfigurable modular robot, Dynamic environment, Morphology search},
abstract = {Self-reconfigurable modular robots (SRMRs) are engineered to adapt their morphology and behaviour to varying terrains. Despite their potential, most SRMRs face challenges in searching through a discrete space and interacting with various environments. We introduce an advanced Terrain-Aware Morphology Search (TAMS) algorithm to overcome these limitations. This innovative approach begins by establishing a set of module joint rules, enabling the random generation of feasible morphologies. It then employs a refined Grammar Variational Auto-encoder (GVAE) to transition these discrete morphologies into a continuous latent space. The core of TAMS lies in its unique hybrid morphology search method, which integrates Differential Evolution (DE) and Neural Network (NN). This combination is pivotal in identifying the most terrain-suited morphology within the continuous latent space. Additionally, TAMS leverages Model Predictive Path Integral (MPPI) control to swiftly derive appropriate behaviours for these optimized morphologies. The algorithm further enhances its efficiency by updating the DE population and NN weights based on the rewards obtained from environmental feedback. Comparative experimental results reveal that TAMS outperforms three benchmark algorithms – Grammar-guided Latent Space Optimization, Genetic Programming, and a Two-Stage Reconfiguration Algorithm. In terms of the best fitness and search speed, TAMS is positioned in the first echelon of the Pareto front in all tested terrains. In some complex terrains, the best morphology fitness and search speed achieved by TAMS far exceed those of other benchmark algorithms. Moreover, the morphologies obtained by the TAMS algorithm can achieve the fastest moving speed when traversing the terrain, and the output of its actuators is much smaller than that of the GP and GLSO algorithms.}
}
@article{KITAMURA2026114138,
title = {Is selection all you need in differential evolution?},
journal = {Applied Soft Computing},
volume = {186},
pages = {114138},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114138},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625014516},
author = {Tomofumi Kitamura and Alex Fukunaga},
keywords = {Differential evolution, Single objective black-box optimization, Population size control, Adaptive parameter control},
abstract = {Differential Evolution (DE) is a widely used evolutionary algorithm for black-box optimization problems. However, in modern DE implementations, a major challenge lies in the limited population diversity caused by the fixed population size enforced by the generational replacement. Population size is a critical control parameter that significantly affects DE performance. Larger populations inherently contain a more diverse set of individuals, thereby facilitating broader exploration of the search space. Conversely, when the maximum evaluation budget is constrained, smaller populations exploiting a limited number of promising candidates may be more suitable. Many state-of-the-art DE variants incorporate an archive mechanism, in which a subset of discarded individuals is preserved in an archive during generation replacement and reused in mutation operations. However, maintaining what is essentially a secondary population via an archive introduces additional design considerations, such as policies for insertion, deletion, and appropriate sizing. To address these limitations, we propose a novel DE framework called Unbounded Differential Evolution (UDE), which adds all generated candidates to the population without discarding any individual based on fitness. Unlike conventional DE, which removes inferior individuals during generational replacement, UDE eliminates replacement altogether, along with the associated complexities of archive management and dynamic population sizing. UDE represents a fundamentally new approach to DE, relying solely on selection mechanisms and enabling a more straightforward yet powerful search algorithm.}
}
@article{CHEN2026114157,
title = {Uncertainty-aware cloud resource management via fuzzy-adaptive hierarchical reinforcement learning},
journal = {Applied Soft Computing},
volume = {186},
pages = {114157},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114157},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501470X},
author = {Liwen Chen and Chunmao Jiang and Yanxiao Huang and Wei Wu},
keywords = {Soft computing, Fuzzy adaptive systems, Hierarchical reinforcement learning, Cloud resource optimization, Uncertainty modeling, Intelligent decision-making},
abstract = {Cloud resource management faces significant challenges owing to workload and dynamic demands. To address these issues, we propose a fuzzy adaptive hierarchical reinforcement learning (FA-HRL) framework that optimizes resource utilization, task completion time, and Quality of Service (QoS). FA-HRL integrates fuzzy logic with hierarchical reinforcement learning through three components: a fuzzy workload clustering and prediction module, a context-aware fuzzy adaptive reward mechanism, and a fuzzy rule-based policy generation system for multilevel decision coordination. Experiments on Google’s cluster traces show that FA-HRL achieves approximately 13 % higher resource utilization, approximately 10 % lower task completion time, and 30 % improved QoS metrics compared to state-of-the-art methods, while maintaining robust performance during workload spikes. These results demonstrate the effectiveness of FA-HRL as a scalable solution for uncertainty-aware cloud resource management, with significant potential in large-scale cloud environments.}
}