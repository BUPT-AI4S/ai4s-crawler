@article{WAQAR2026114585,
title = {Natural language processing for construction engineering: Artificial intelligence-driven text analysis techniques},
journal = {Applied Soft Computing},
volume = {190},
pages = {114585},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114585},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000335},
author = {Ahsan Waqar},
keywords = {Artificial intelligence-based text analysis, Natural Language Processing, Potential implications, Automated document classification, Sentiment analysis, Explainable artificial intelligence},
abstract = {The construction engineering sector has witnessed significant advancements through the integration of Natural Language Processing (NLP), driven by artificial intelligence-based text analysis methods. As construction projects generate vast volumes of unstructured textual data ranging from contracts and specifications to stakeholder communications extracting actionable insights from this data has emerged as a critical challenge. This study presents a comprehensive review of scholarly literature from 2001 to 2025, systematically analyzing trends, methodologies, and applications of NLP in construction engineering. The findings reveal a sharp increase in research activity, with growing emphasis on advanced AI techniques such as deep learning models, transformers, multimodal analysis, and explainable AI. These approaches have enabled enhanced document management, improved risk assessment, real-time decision-making, and more effective stakeholder engagement. Moreover, the study identifies key challenges, including limited access to domain-specific datasets, model interpretability, data interoperability, and the scalability of NLP applications. Furthermore, the study highlights the emerging need to evaluate large language models (LLMs) using domain-specific benchmarks to ensure their reliability and practical applicability in construction NLP tasks. By addressing these limitations and highlighting future research directions, this review underscores the transformative potential of NLP in reshaping construction engineering practices and supports the development of intelligent, data-driven solutions tailored to the unique complexities of the construction domain.}
}
@article{ZHENG2026114637,
title = {Attention-enhanced Kolmogorov–Arnold networks for accurate wind power prediction},
journal = {Applied Soft Computing},
volume = {190},
pages = {114637},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114637},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000852},
author = {Xin Zheng and Shaopeng Guan and Ying Zhou},
keywords = {Kolmogorov-Arnold network, Time-frequency analysis, Multi-head attention, Wind power, Ultra-short-term forecasting},
abstract = {Ultra-short-term wind power forecasting (UWPF) is essential for ensuring grid stability; however, it faces fundamental challenges stemming from multi-scale non-stationarity and the limitations of fixed activation functions in conventional deep learning models. Existing decomposition methods frequently suffer from mode mixing, while standard neural networks struggle to adaptively model the varying nonlinearity of wind power curves without incurring excessive complexity. To address these challenges, this paper proposes KAMAN, a novel framework integrating Kolmogorov-Arnold Networks (KAN) with multi-head attention and frequency-domain decomposition. Specifically, the proposed approach employs a Fast Fourier Transform (FFT)-based masking mechanism to effectively decouple complex signals into physically interpretable trends and fluctuations, thereby mitigating the mode mixing artifacts prevalent in Empirical Mode Decomposition (EMD)-based approaches. Furthermore, by replacing fixed activations with learnable B-spline basis functions, KAN can adaptively capture the irregular nonlinear cut-in and saturation characteristics of wind turbines. To compensate for KAN’s inherent locality in function fitting, a multi-head self-attention mechanism is integrated to capture global temporal dependencies across frequency bands. Extensive experimental evaluations on two real-world datasets demonstrate the superiority of the proposed method, achieving coefficient of determination (R2) values of 0.9370 and 0.9362 for one-hour-ahead forecasting. These results correspond to relative improvements of 2.16 % and 2.42 % over the second-best baseline, respectively. The enhanced forecasting accuracy and reduced reserve requirements offered by this approach provide robust computational intelligence support for the economic and stable operation of power systems.}
}
@article{RONG2026114609,
title = {Infrared-based real-time leakage detection in earth–rock dams using an enhanced YOLO algorithm integrated with a biomimetic quadruped robot},
journal = {Applied Soft Computing},
volume = {190},
pages = {114609},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114609},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000578},
author = {Zhongdi Rong and Shengyi Cong and Liang Tang and Shuang Tian and Siang Huat Goh and Lei Sheng and Yizhe Nie},
keywords = {Infrared thermography, Biomimetic quadruped robot, Leakage detection, Earth–rock dams, Deep learning},
abstract = {Dam leakage poses a critical challenge to the stability and safety of earth–rock dams. However, traditional manual inspection methods are inefficient, limited in scope, and can often fail in complex environments due to subjectivity, time consumption, and human errors. To address these limitations, this study integrates for the first time an optimized You Only Look Once Leakage Enhanced (YOLO-LE) algorithm with infrared thermography and a biomimetic quadruped robot to enable real-time, autonomous leakage detection. The proposed YOLO-LE framework incorporates squeeze-and-excitation attention mechanisms, adaptive spatial feature fusion, and transfer learning to improve detection precision, robustness against environmental interference (e.g., humidity and vegetation), and recognition of small-scale leakage points. The proposed framework is verified by indoor and field experiments using an FLIR A50 infrared camera mounted on a quadruped robot, selected for its terrain adaptability. A custom dataset of 1000 thermal images, augmented with rotation and noise injection, is used for training and evaluation. The results show that the proposed YOLO-LE framework achieves an average precision (AP) of 0.873 and an F1-score of 0.865, outperforming the YOLOv5, single-shot multi-box detector, and faster region-convolutional network models in AP by 7.2 %, 6.9 %, and 1.4 %, respectively. In addition, comparative experiments under different environmental disturbances demonstrate the superior resilience of the proposed framework, with an inference speed of 51 frames per second, ensuring real-time monitoring capability. Finally, the results validate the feasibility of combining deep learning with robotic systems for dam safety, providing a scalable, accurate, and automated solution for monitoring critical infrastructure.}
}
@article{YANG2026114593,
title = {3W-GBSVM++: Three-way granular-ball SVM based on granularity optimization mechanism},
journal = {Applied Soft Computing},
volume = {190},
pages = {114593},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114593},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000414},
author = {Jie Yang and Rong Huang and Guoyin Wang and Qinghua Zhang and Shuyin Xia and Di Wu},
keywords = {Granular-ball generation, Justifiable granularity, SVM, Three-way classifier, 3W-GBSVM++},
abstract = {The granular-ball (GB)-based classifier exhibits adaptability in creating coarse-grained information granules as input, thereby enhancing its generality and flexibility. Nevertheless, current GB-based classifiers rigidly assign a specific class label to each data instance and lack the necessary strategies to address uncertain instances. Such certain classification approaches to uncertain instances may suffer considerable risks. To solve this problem, we construct a robust three-way granular-ball SVM based on justifiable granularity for uncertain data instances. First, we propose an enhanced GB generation method with the principle of justifiable granularity. Subsequently, based on the proposed GB generation, we present an improved granular-ball SVM (GBSVM++). Furthermore, we construct a three-way granular-ball SVM, denoted by 3W-GBSVM++, which categorizes data instances into certain classes and uncertain cases. Finally, extensive comparative experiments are conducted with 8 state-of-the-art GB-based classifiers on 16 public benchmark datasets. The results show that our model demonstrates robustness in managing uncertain data and effectively mitigates classification risks. Furthermore, our model almost always outperforms the other comparative methods in both effectiveness and efficiency.}
}
@article{SONG2026114573,
title = {An interactive evolutionary multitask optimization algorithm for variables group-level knowledge transfer},
journal = {Applied Soft Computing},
volume = {190},
pages = {114573},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114573},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000219},
author = {Yingjie Song and Chunlin Song},
keywords = {Evolutionary multitask optimization (EMTO), Interactive optimization, User knowledge, Variables group-level knowledge transfer, Asynchronous evolutionary},
abstract = {Aiming to address the limitations of existing evolutionary multitask optimization algorithms in user knowledge utilization, knowledge transfer mechanisms, and evolutionary approaches, this paper proposes an Interactive Evolutionary Multitask Optimization Algorithm for Variables Group-Level Knowledge Transfer (EMTO-IVG). The algorithm introduces a knowledge transfer mechanism between variable groups, dynamically adjusts the knowledge transfer strategy through user interaction, significantly enhancing the optimization performance of the algorithm. The EMTO-IVG algorithm consists of three main components: (1) Adaptive Asynchronous Multitask Evolution Strategy (ASME), which dynamically adjusts the task optimization sequence based on changes in population objective function values to ensure efficient utilization of computational resources; (2) User Knowledge-Guided Variables Group-Level Knowledge Transfer Strategy (VGUK-KT), which uses inter-task user knowledge to guide variable grouping and enables knowledge transfer between non-aligned similar variables; and (3) Rule Knowledge-Based Interactive Individual Repair Strategy (RKIR), which corrects individuals using rule knowledge provided by users to further enhance the quality of solutions and the convergence speed of tasks. In the 38 benchmark tasks, the average significant advantage rate in the Wilcoxon rank sum test of the EMTO-IVG algorithm reaches 88.8%. Applying EMTO-IVG to a real-world reservoir power generation optimization problem further validates the algorithm’s effectiveness and practicality in solving complex real-world problems.}
}
@article{SHANG2026114581,
title = {Intelligent diagnosis of hot-rolled strip steel convexity faults based on hierarchical attention cycle graph networks and causal inference},
journal = {Applied Soft Computing},
volume = {190},
pages = {114581},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114581},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000293},
author = {Fei Shang and Huilin Chen and Bo Sun and Ruilin Miao and Xuegang Zhou and Chunwei Xing and Pengpeng Zhang},
keywords = {Hot-rolled strip steel, Convexity fault diagnosis, Layered attention recurrent neural network, Causal inference, Cost-sensitive learning, Explainable artificial intelligence, Smart manufacturing},
abstract = {To address the challenges in diagnosing convexity defects in hot-rolled strip steel, such as the complexity of dynamic evolution characteristics, strong multi-factor coupling effects, and insufficient interpretability of diagnostic results, we propose a new intelligent diagnostic method that combines a hierarchical attention mechanism-based recurrent graph neural network (HARGNN) with causal inference. This method utilizes a graph attention network to capture the complex interactive relationships among process parameters within a stand, employs gated recurrent units to model dynamic cumulative effects across stands, and introduces a dual-layer attention mechanism at both the parameter level and stand level to adaptively identify key influencing factors. To address the inherent class imbalance in industrial data, a cost-sensitive learning strategy is employed to optimize model training. By combining the HARGNN model output with a constraint-based causal discovery algorithm, causal relationship networks tailored to different fault modes are constructed, achieving a breakthrough from correlation analysis to causal analysis. Experimental results based on a dataset of 52,847 actual samples from a 2250 mm hot-rolling production line at a steel company demonstrate that the HARGNN model achieves an accuracy rate of 91.23 % and a macro-average F1 score of 0.7612, significantly outperforming existing methods; the causal inference module successfully identifies 138 significant causal relationships and precisely quantifies the causal effects of key factors; This study achieved a leap from “black box” diagnosis to “transparent” decision-making and from correlation analysis to causality, providing new methodological support for intelligent diagnosis and in-depth interpretation of complex industrial processes.}
}
@article{YI2026114589,
title = {Dynamic graph-enhanced multi-scale attention network for FW-UAV fault diagnosis under small sample},
journal = {Applied Soft Computing},
volume = {190},
pages = {114589},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114589},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000372},
author = {Rong Yi and Jianguang Lu and Xianghong Tang},
keywords = {FW-UAV, Fault diagnosis, Dynamic graph enhancement, Multi-scale attention, Feature aggregation},
abstract = {Deep learning-based fault diagnosis has achieved significant success in intelligent industrial monitoring. However, diagnosing faults in fixed-wing unmanned aerial vehicles (FW-UAVs) under limited data conditions remains challenging because of scarce fault data, complex spatiotemporal dynamics of flight signals, and difficulty in simultaneously capturing global dependencies and local topology evolution patterns. To address these challenges, we propose a novel dynamic graph-enhanced multi-scale attention network (DGMANet) for robust fault diagnosis of FW-UAVs under small-sample conditions. Specifically, DGMANet integrates a dynamic graph enhancement mechanism that models localized topological dependencies and adaptive inter-feature correlations, thereby enabling effective structural feature learning even with limited data. A multi-scale attention module is incorporated to extract hierarchical global dependencies, which permits the model to concentrate on salient temporal patterns across multiple resolutions. Furthermore, an adaptive feature aggregation strategy is introduced to fuse local and global representations, enhancing feature complementarity while suppressing noise and redundancy. Extensive experiments on four real-world flight datasets demonstrate that DGMANet consistently outperforms existing baselines in small-sample scenarios, validating its effectiveness and generalization capability in resource-constrained UAV monitoring scenarios.}
}
@article{CAI2026114597,
title = {Constrained multi-objective evolutionary algorithm with an infeasibility-aided strategy for the vehicle routing problem with time windows},
journal = {Applied Soft Computing},
volume = {190},
pages = {114597},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114597},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000451},
author = {Yiqiao Cai and Huihui Zheng and Biao Liang and Ying Zhou and Hui Tian},
keywords = {Multi-objective vehicle routing problem with time windows (MOVRPTW), Multi-objective optimization, Constraint handling techniques, Infeasibility-aided strategy},
abstract = {The vehicle routing problem with time windows (VRPTW) is a fundamental combinatorial optimization problem, challenging and of significant practical relevance in supply chain and logistics management. Addressing real-world VRPTW instances requires optimizing multiple conflicting objectives while satisfying complex constraints, which complicates the balance between objective tradeoffs and constraint satisfaction. This study proposes a novel constrained multi-objective evolutionary algorithm with an infeasibility-aided strategy (CMOEA-IAS), tailored for the multi-objective VRPTW (MOVRPTW). Distinct from existing multi-objective evolutionary algorithms (MOEAs) that primarily emphasize feasible solutions, CMOEA-IAS leverages infeasible solutions as a critical guide to enhance the search process in highly constrained environments. Its core strategy, the infeasibility-aided strategy (IAS), combines a search information filtering operator (SIFO) that selects promising feasible and infeasible solutions for population construction, and a dynamic infeasibility management operator (DIMO) that dynamically balances exploration between the infeasible and feasible search spaces. By leveraging information from both feasible and infeasible regions, CMOEA-IAS achieves well-balanced convergence, diversity, and feasibility. Experiments on real-world benchmark instances demonstrate that CMOEA-IAS consistently outperforms several state-of-the-art MOEAs, achieving superior performance in solving complex MOVRPTWs and highlighting the effectiveness of incorporating infeasible solutions in constrained multi-objective optimization.}
}
@article{LI2026114658,
title = {BGFF-UNet: A lightweight network based on boundary-guided feature fusion mechanism for skin lesion segmentation},
journal = {Applied Soft Computing},
volume = {190},
pages = {114658},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114658},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001067},
author = {Jian Li and Hengxu Guan and Jiawei Wang and Jiawei Zhao and Xinglei Lin and Junrui Kang and Jie Luo and Huiling Chen},
keywords = {Medical Image Segmentation, Lightweight Networks, Skin Lesion Segmentation, Boundary-Guided},
abstract = {Accurate segmentation of skin lesion areas is crucial for the early detection of melanoma. However, there is still a significant gap in the effective application of existing models within computationally constrained environments. To this end, the Lightweight Boundary-Guided Feature Fusion Network (BGFF-UNet) is proposed. This model is designed to significantly reduce computational load and parameter count while ensuring competitive segmentation accuracy. BGFF-UNet's core contribution lies in its integration of boundary refinement and a lightweight architecture. Specifically, it employs a Curvature-Driven Adaptive Polygon Fitting with Keypoint Detection (CDAP-KD) to facilitate a unique boundary refinement mechanism for precise boundary prompt generation, as well as a novel Boundary-Guided Feature Fusion (BGFF) module. To ensure efficiency, the model also incorporates Grouped Multi-Axial Hadamard Product Attention (GHPA), Depthwise Separable Convolutions (DWSC) and Efficient Channel Attention (ECA) mechanisms. Extensive evaluations on the ISIC 2017 and ISIC 2018 datasets demonstrate that the accuracy of BGFF-UNet is competitive with that of the advanced lightweight model, LB-UNet. Notably, its parameter count is reduced by 37.75 % to 23.96 K, and its computational load is reduced by 40.97 % to 57.85 M FLOPs compared to LB-UNet. This research offers a promising solution for high-efficiency, high-accuracy melanoma segmentation in settings with limited resources.}
}
@article{LUO2026114553,
title = {A large language model-based method using weighted double-well potential support vector regression for foreign exchange rate robust forecasting},
journal = {Applied Soft Computing},
volume = {190},
pages = {114553},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114553},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000013},
author = {Rui Luo and Jinpei Liu and Zheming Gao and Shu-Cherng Fang},
keywords = {Robust forecasting, FOREX rates, Support vector regression, Double well potential function, Large language model},
abstract = {Text-driven foreign exchange (FOREX) rate forecasting is an emerging research topic that crucially impacts the stability of financial markets and cross-border transactions. However, extant models face the challenges of effectively capturing the high nonlinearity and strong volatility nature of the FOREX rate. The predictive accuracy is further compromised by the considerable noise and the existence of outliers in the text-driven input variables. To address these challenges, we propose a novel kernel-free induced ordered weighted averaging-based double-well potential support vector regression (IOWA-DWPSVR) model, which utilizes sentiment polarity quantified by large language models as an input variable. By generating a quartic fitting curve based on the identified support vectors, DWPSVR model is capable of effectively extracting the highly nonlinear characteristics of the FOREX rate series while mitigating the impact of noise. In addition, the model incorporates an IOWA operator to estimate the relative significance of each input value to reduce the adverse impact of outliers on the regression process. We conduct extensive computational experiments on the FOREX rate forecasting to verify the prediction performance of the proposed model. The empirical results confirm that the proposed model outperforms benchmark models in terms of both predictive accuracy and robustness, with improvements ranging from 10.59% to 84.09%.}
}
@article{CHEN2026114577,
title = {SPEGS-OE: A multi-stage high-fidelity 3D reconstruction method for small power equipment in outdoor environments from sparse views},
journal = {Applied Soft Computing},
volume = {190},
pages = {114577},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114577},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000256},
author = {Wenkang Chen and Ying Peng and Xuejun Zhang and Shenglian Lu},
keywords = {Three-dimensional reconstruction, Small power equipment, Multi-level Gaussian geometric distillation, Image enhancement},
abstract = {The digital transformation of power grids requires automated high-fidelity 3D reconstruction of critical assets (e.g., insulators and connectors). To overcome the problem of insufficient fidelity in sparse views and 3D reconstruction of small power equipment in complex scenes, this paper proposes SPEGS-OE. This integrated framework combines image enhancement and 3D reconstruction. The framework employs:(1) Intelligent Image Enhancement: A wavelet-diffusion network decomposes images via discrete wavelet transform, leveraging novel frequency prompt and interaction modules for cross-band feature fusion and diffusion-based stochastic refinement to resolve occlusions and lighting distortions. (2) Geometry-Driven Reconstruction: The SPERE pipeline first constructs object primitives through segmentation-pose joint optimization, then performs multi-level Gaussian geometric distillation to select reliable priors, enabling precise 3D Gaussian Splatting modeling. Extensive experiments show SPEGS-OE outperforms SOTA methods, improving PSNR, SSIM, and LPIPS by 1.1 %, 2.7 %, and 3.6 %, respectively. Field tests confirm that reconstructed 3D models closely align with actual equipment. This end-to-end system delivers actionable digital twins for grid condition assessment, offering significant value for infrastructure management.}
}
@article{TAN2026114629,
title = {Text-guided and Edge-guided fusion network for enhancing medical image segmentation},
journal = {Applied Soft Computing},
volume = {190},
pages = {114629},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114629},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000773},
author = {Zhiyong Tan and Ruifen Cao and Pijing Wei and Chao Zhou and Yansen Su and Chunhou Zheng},
keywords = {Medical image segmentation, Multimodal learning, Visual language models},
abstract = {Medical image segmentation is crucial for disease diagnosis and treatment, especially in oncology. However, current image-based unimodal methods are limited by data acquisition challenges, making it difficult to improve segmentation performance. The medical text annotation generated together with images provides rich semantic information at low cost, and the utilization of textual data presents a complementary approach to enhance analytical capabilities of image-based unimodal methods. However, medical image segmentation still encounters challenges, including complex background distributions, variable lesion shapes and sizes, and ambiguous boundaries. Accurate capture of edge information between the foreground (lesion or region of interest) and background (surrounding tissue) significantly influences segmentation outcomes. To address these challenges, we propose the Text-guided and Edge-guided Fusion Network (TEFNet), which integrates medical text knowledge and edge information to enhance segmentation performance. The text-guided strategy enriches the model's understanding of image content by leveraging semantic information from textual reports associated with medical images, enabling more accurate segmentation judgements. Edge-guided attention enhances the model's ability to identify anatomical structures and tissue boundaries by leveraging high-frequency edge information, enabling more reliable boundary delineation. Additionally, we introduce the Segmentation Anything Model (SAM), specifically tailored for the biomedical domain, to further enhance medical feature representation. Comprehensive evaluations across three established medical image segmentation benchmarks demonstrate that TEFNet, through a synergistic fusion of visual and textual features, achieves superior segmentation accuracy compared with current leading methods, validating the effectiveness of joint visual-text feature learning in medical image segmentation.}
}
@article{WANG2026114551,
title = {An improved density-adaptive model based on motif matrix for myocardial infarction detection},
journal = {Applied Soft Computing},
volume = {190},
pages = {114551},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114551},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018642},
author = {Jibin Wang},
keywords = {Electrocardiogram, Motif matrix, Interaction information},
abstract = {Myocardial infarction (MI) remains a prevalent and life-threatening cardiovascular pathology worldwide. Current clinical diagnostic protocols predominantly rely on manual visual interpretation of electrocardiogram (ECG) by physicians, which is labor-intensive, time-consuming and inherently susceptible to diagnostic variability. We therefore develop an improved Density-Adaptive Model based on Motif Matrix (IDAMM) that incorporates both an Adaptive Spatial Interaction block and an Adaptive Temporal Interaction block for automated MI detection. Specifically, a multi-scale feature fusion approach is exploited to adaptively select the optimal scope of neighbors participating in information interaction in spatial dimension and an atrous pyramidal pooling mechanism is leveraged to generate the interaction probability for each agent in temporal dimension. The effectiveness of IDAMM is evaluated across the Physikalisch-Technische Bundesanstalt database. These results demonstrate better performance improvements over existing methods and offer a trade-off between performance and complexity from the aspect of empirical experiments. Theoretical convergence proof ensures the stability and reliability of optimization process from the aspect of mathematical theory. The attribute of information interaction is fully considered in IDAMM thus exhibiting interpretability and application potential.}
}
@article{ROY2026114450,
title = {Contrastive learning strategies for better image classification with imbalanced datasets},
journal = {Applied Soft Computing},
volume = {190},
pages = {114450},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114450},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017636},
author = {Sudipta Roy and Rohit Jadhav and Tanushree Meena},
keywords = {Self-supervision, Generative and predictive models, Contrastive models, Medical imaging},
abstract = {Imbalanced and long-tailed datasets remain a major challenge in image analysis, particularly in high-impact domains such as natural vision and biomedical imaging. Despite numerous advances, identifying imbalance-aware frameworks that can effectively address data bias continues to be an open problem. This paper presents a comprehensive review of contrastive and self-supervised learning (SSL) techniques for imbalanced datasets, highlighting their principles, comparative performance, and practical implications. In addition to synthesizing existing literature, we provide a structured taxonomy of SSL methods including contrastive, noncontrastive, generative, and hybrid approaches, and analyze their strengths and limitations in different imbalance scenarios. We also discuss key research directions involving dynamic sampling, hard negative mining, and normalization strategies, which have shown promise in improving minority class recognition and generalization. Finally, the review examines the real-world challenges of deploying SSL models, including issues of ethics, interpretability, and data bias. By consolidating current findings and outlining future research needs, this work aims to serve as a reference framework for researchers developing imbalance-aware SSL approaches for real-world applications.}
}
@article{BAYHUN2026114539,
title = {Evaluating sustainable disaster management in shipyard operations using an integrated fuzzy LMAW and spherical fuzzy WASPAS approach: A case study in Istanbul},
journal = {Applied Soft Computing},
volume = {190},
pages = {114539},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114539},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018526},
author = {Semra Bayhun and Nihan Çetin Demirel},
keywords = {Disaster management, Multi-criteria decision making, Fuzzy LMAW, Spherical fuzzy WASPAS, Shipyard},
abstract = {Effective emergency management in the shipyard industry necessitates a systematic approach to evaluating and prioritizing emergency response plans. This is critical for the appropriate selection of alternatives to correctly manage emergencies during and after disaster processes, as well as the timely implementation of aid interventions. This study proposes a comprehensive model for evaluating the sustainability of disaster management practices in the shipyard industry. The proposed Sustainability Disaster Management model integrates multiple criteria decision-making techniques to assess the environmental, economic, and social dimensions of disaster management strategies. This study proposes an integrated approach to prioritize the criteria for disaster management and aggregate the preference decision matrix. The method involves constructing an effective emergency response system task network utilizing fuzzy Logarithm Methodology of Contribution Weights (LMAW). This computational approach assesses the sustainability of disaster management practices across workplace divisions and derives importance weightings based on this assessment. It then integrates these weightings into the Weighted Aggregate Sum Product Assessment (WASPAS) method extended with spherical fuzzy sets to rank alternative workplace segments disaster management strategies. The analysis results indicate that A1, corresponding to Shipyard Dock G1, emerges as the highest-priority operational zone, achieving a score of 0.883. Following closely, Areas A2 and A3, representing Shipyard Dock G2 and Shipyard Dock T1 respectively, constitute the second and third most significant operational zones, with scores of 0.881 and 0.858.}
}
@article{CHEN2026114584,
title = {Zero-knowledge clustering and selective federated distillation for decentralized federated learning},
journal = {Applied Soft Computing},
volume = {190},
pages = {114584},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114584},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000323},
author = {Siguang Chen and Shujia Pan and Xue Li},
keywords = {Federated learning, Zero-knowledge, Federated distillation, Decentralized network},
abstract = {Decentralized federated learning (FL) has emerged as a promising alternative to traditional centralized FL, particularly for networks without a centralized server but with complex topologies. However, the challenges in the decentralized scenario such as data heterogeneity, scalability, and privacy preservation remain critical barriers to its effective implementation. To address these issues, we propose a zero-knowledge clustering and selective federated distillation (ZKCS-FD) algorithm. By developing a gradient-based masking method to identify critical parameters and reflect client similarity characteristics, combined with secure multi-party computation enabled hierarchical mask distance computation, ZKCS-FD achieves zero-knowledge clustering for optimal aggregation targets while mitigating the impact of data heterogeneity. Furthermore, ZKCS-FD decomposes complex topology into 2-hop clusters, where selective knowledge distillation extracts high-quality knowledge and enables knowledge propagation through iterative 2-hop coverage, significantly enhancing both model performance and system scalability. Experiments across diverse data distributions demonstrate ZKCS-FD’s superior accuracy, and additional experiments validate the effectiveness of selective federated distillation and zero-knowledge clustering algorithms. These findings validate the algorithm’s significant improvements in handling data heterogeneity and facilitating efficient collaboration in decentralized networks, advancing scalable and privacy-aware FL.}
}
@article{SUN2026114608,
title = {A contextual feature refinement framework for industrial anomaly detection on textured surfaces with limited anomaly samples},
journal = {Applied Soft Computing},
volume = {190},
pages = {114608},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114608},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000566},
author = {Qian Sun and Ke Xu and Hongjie Li and Chuni Liu and Lei Jin and Pengju Xu and Delong Zhao},
keywords = {Defect detection, Anomaly detection, Unsupervised learning, Few-shot learning, Knowledge distillation},
abstract = {Automating visual inspection is critical for quality control and predictive maintenance in modern industrial settings, replacing manual inspections that are slow, costly, and subjective. While automation offers a scalable solution, its adoption is hindered by the difficulty of reliably detecting defects on textured surfaces common across various industrial domains. A primary challenge is data imbalance, for which unsupervised anomaly methods are popular. However, these methods neglect valuable prior knowledge from the limited defect samples typically available, an oversight that makes them ill-suited for detecting challenging anomalies like faint textures or diverse morphologies—a critical capability for any trustworthy industrial automation system. To address this challenge, we propose DATA, a novel framework for industrial anomaly detection that effectively utilizes the few available defect samples to enhance precision. Its twin-branch architecture decouples the learning of ’seen’ and ’unseen’ anomalies, ensuring high accuracy for known defects while maintaining a robust open-set capability for novel ones. The framework’s core is a contextual feature refinement mechanism integrating a shallow module for local details with a deep module for global context. This process is enhanced by a Feature-Difference Attention (FDA) mechanism for context-dependent defects and a Spatio-Featural Refinement (SFR) module for coherent localization. Furthermore, dual memory pools improve decision robustness against noisy backgrounds. Validated on five diverse public datasets, DATA achieves state-of-the-art performance in both Image and Pixel AUROC. These results establish our method as a robust solution for automated quality control and intelligent inspection in demanding industrial environments.}
}
@article{TAK2026114592,
title = {Meta fuzzy feature-selection-based regression functions},
journal = {Applied Soft Computing},
volume = {190},
pages = {114592},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114592},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000402},
author = {Nihat Tak and Aylin Uçan},
keywords = {Regression, Meta fuzzy functions, Feature engineering, Combination, Ensemble learning},
abstract = {Selecting a single regression model can be unreliable when data contain complex structures or correlated features. Although model combination is often proposed as a remedy, it remains unclear when this approach is most effective and how different models should be combined. This study addresses these issues and introduces Meta Fuzzy Regression Functions (MFRFs) as a refined model combination framework. MFRFs integrate predictions from multiple regression models through fuzzy membership based weighting. Models produced after feature selection procedures are included in this process, and when features are correlated or redundant, these models tend to perform more stably. The fuzzy weighting mechanism naturally assigns higher weights to such models, allowing the meta function to adaptively emphasize the most informative predictors. Experiments on six simulated and four real-world datasets show that MFRFs mostly outperform individual models. The approach reduces test prediction errors and achieves meaningful improvements in Mean Absolute Percentage Error (MAPE). These findings demonstrate that MFRFs offer an effective and interpretable solution to model selection uncertainty and enhance regression performance across diverse data settings. The results on several datasets show that the proposed method improves the average MAPE by approximately 25% compared to individual models and by 41% compared to the second-best ensemble learning method.}
}
@article{ZHANG2026114640,
title = {Minimizing predictive class confusion: A unified framework for cross-domain fault diagnosis under different label and domain configurations},
journal = {Applied Soft Computing},
volume = {190},
pages = {114640},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114640},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000888},
author = {Yuteng Zhang and Leijun Shi and Qinkai Han and Xueping Xu and Hui Liu and Fulei Chu and Yun Kong},
keywords = {Industrial intelligence, Cross-domain fault diagnosis, Unified diagnosis framework, Unsupervised transfer learning, Multiple cross-domain scenarios},
abstract = {Reliable fault diagnosis is essential for maintaining the safety and operational efficiency of advanced industrial equipment. Diagnostic methods based on transfer learning techniques such as unsupervised domain adaptation have demonstrated considerable potential for engineering applications. However, existing methods rely on the predefined specific assumptions regarding inter-domain label relationships and domain configurations, which severely restrict their practical applications. To address these issues, this study proposes a unified cross-domain fault diagnosis framework for transfer diagnostic tasks under different label and domain configurations, including closed-set, partial-set, open-set, multi-source domain, and multi-target domain transfer diagnostics. The presented unified framework leverages a predictive class confusion bias shared across multiple scenarios to guide cross-domain knowledge transfer, thus enabling effective domain adaptation to various transfer diagnostic scenarios. To measure the tendency of class confusion accurately, a prototype similarity-based fault discrimination method is developed, which enhances classification robustness and provides reliable prediction distributions for predictive class confusion estimation. Then, a label smoothing-based probability calibration mechanism is designed for probability regularization, mitigating erroneous class confusion estimation caused by prediction bias. Additionally, an open-set cross-domain diagnosis method with an adaptive threshold is provided to handle potential unseen faults, which has a straightforward design and can be implemented easily within the unified cross-domain diagnosis framework. Extensive experiments on two transmission system datasets verify the general applicability of the proposed unified framework across five cross-domain diagnosis settings, and its performance is competitive with advanced scenario-specific transfer diagnosis methods, providing an effective tool for intelligent diagnosis in industrial scenarios.}
}
@article{MONTALBO2026114624,
title = {MHADFormer: A cost-efficient multiscale hybrid transformer mixer model for automating Alzheimer’s disease diagnosis from MRI scans},
journal = {Applied Soft Computing},
volume = {190},
pages = {114624},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114624},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000724},
author = {Francis Jesmar P. Montalbo},
keywords = {Alzheimer’s disease, Cognitive impairment, Magnetic resonance imaging, Deep learning, Hybrid transformer models},
abstract = {Accurate and early diagnosis of Alzheimer’s disease (AD) from magnetic resonance imaging (MRI) remains a critical challenge in clinical neuroscience. Deep learning and vision transformers have advanced automated classification, yet their high computational burden limits deployment in practice. Here, a hybrid architecture, Mixer Hybrid AD Transformer (MHADFormer), is introduced to reconcile accuracy with efficiency through four lightweight modules: the Cost-efficient Feature Extractor (CeFE), Enhanced Mobile Vision Transformer (EMViT), Fused Attention with Cost-efficient Separable Convolutions (FACeS), and Feature Aggregated Spectral Transformer (FAST), integrated with a tailored MLP-Mixer. MHADFormer achieved 99.69 % accuracy on the OASIS dataset and 99.96 % on ADNI, averaging 99.83 %, while requiring only 1.11 M parameters and 0.27 GFLOPs. In addition, the model achieved 81.28 % accuracy in distinguishing between progressive and stable mild cognitive impairment, surpassing state-of-the-art baselines. These results establish MHADFormer as a scalable, interpretable, and resource-aware solution, bridging the gap between deep learning performance and clinical applicability for MRI-based AD diagnosis.}
}
@article{ZHOU2026114632,
title = {Transformer optimization algorithm for selecting tokens based on genetic algorithm},
journal = {Applied Soft Computing},
volume = {190},
pages = {114632},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114632},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000803},
author = {Tao Zhou and Yuxia Niu and Huiling Lu and Yujie Guo and Long Liu and Huiyu Zhou},
keywords = {Deep learning, Transformer, Token selection, Genetic algorithm, Fitness function, Gene selection, Gene crossover},
abstract = {In recent years, Transformer are widely recognized in the field of artificial intelligence for its excellent performance. However, the tokens number is increased exponentially in Transformer, "How to select token?" and "How to evaluate the importance of each token ?" are key focus areas in current research. To solve the above problems, this paper proposes a global token selection model GAFormer based on Genetic Algorithm. Firstly, Aiming to "How to select token?", binary encoding strategy, whole-part coupled fitness function, elitism strategy-roulette selection, two-point crossover, and one-point mutation are used to realize genetic evolution; Secondly, Aiming to "How to evaluate the token importance?", a whole-part coupled fitness function is constructed, using whole gene selection to obtain "probability vector", using part gene selection to obtain "selection result vector", and using the scoring strategy of whole-part coupled to obtain the fitness value of each chromosome; Finally, the model is verified on 2 public lung X-ray datasets. On dataset 1, its accuracy, precision, recall, F1, and specificity are reached 96.17 %, 92.33 %, 92.35 %, 92.50 %, and 97.45 % respectively, on dataset 2, the corresponding results are 95.84 %, 93.23 %, 93.41 %, 93.26 %, and 96.30 % respectively. This model provides a new idea for token selection in Transformer, which has positive significance for the further development of the large medical model based on Transformer.}
}
@article{XIAO2026114576,
title = {MMUEChange: A generalized LLM agent framework for intelligent multi-modal urban environment change analysis},
journal = {Applied Soft Computing},
volume = {190},
pages = {114576},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114576},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000244},
author = {Zixuan Xiao and Jun Ma and Siwei Zhang},
keywords = {Change analysis, Large language model (LLM), Multi-modal agent, Urban environment},
abstract = {Understanding urban environment change is essential for sustainable development. However, current approaches, particularly remote sensing change detection, often rely on rigid, single-modal analysis. To overcome these limitations, we propose MMUEChange, a multi-modal agent framework that flexibly integrates heterogeneous urban data via a modular toolkit and a core module, Modality Controller for cross- and intra-modal alignment, enabling robust analysis of complex urban change scenarios. Case studies include: a shift toward small, community-focused parks in New York, reflecting local green space efforts; the spread of concentrated water pollution across districts in Hong Kong, pointing to coordinated water management; and a notable decline in open dumpsites in Shenzhen, with contrasting links between nighttime economic activity and waste types, indicating differing urban pressures behind domestic and construction waste. Compared to the best-performing baseline, the MMUEChange agent achieves a 46.7 % improvement in task success rate and effectively mitigates hallucination, demonstrating its capacity to support complex urban change analysis tasks with real-world policy implications.}
}
@article{GU2026114579,
title = {Self-organising explainable multi-view representation learning for remote sensing scene classification},
journal = {Applied Soft Computing},
volume = {190},
pages = {114579},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114579},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600027X},
author = {Xiaowei Gu and Abdulrahman Kerim and Jinghao Zhang and Jungong Han and Qiang Shen and Peter M. Atkinson and Ce Zhang},
keywords = {Fuzzy neural encoder, Remote sensing scene classification, Multi-view learning, Supervised and self-supervised representation learning},
abstract = {Remote sensing scene classification is widely considered to be a challenging task due to high intraclass variability and interclass similarity in remotely sensed imagery. While existing deep neural networks achieve promising performance, they often lack transparency and generalisation capability. To enhance interpretability without sacrificing accuracy, a novel self-organising transparent multi-view representation learning framework based on evolving fuzzy neural encoders for remote sensing scene classification is introduced in this paper. The framework leverages multiple pre-trained convolutional neural network backbones with different architectures to extract image embeddings from multiple views. The multi-view image embeddings are projected into a lower-dimensional feature space using multilayer evolving fuzzy neural networks trained in a supervised or self-supervised fashion as encoders and subsequently fused for scene classification. Extensive experiments on six benchmark datasets (Optimal-31, WHU-RS, UCMerced, AID, RSI-CB256, and PatternNet) demonstrate the framework’s superior performance, achieving average accuracies of 99.81 %, 98.83 %, 97.86 %, 98.37 %, 99.84 %, and 98.83 %, respectively, without fine-tuning to the specific context. Ablation studies confirm the complementary contributions of the multi-view, supervised, and self-supervised components in the proposed framework. The proposed framework provides an effective solution for remote sensing scene classification, achieving high accuracy with enhanced transparency and interpretability.}
}
@article{WANG2026114600,
title = {A novel multi-sensor fusion method for diagnosing insulation defects in gas-insulated substations guided by adaptive-attention and contrastive-based few-shot learning},
journal = {Applied Soft Computing},
volume = {190},
pages = {114600},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114600},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000487},
author = {Yanxin Wang and Jing Yan and Zhengrun Zhang and Jianhua Wang and Zhiyuan Liu and Yingsan Geng and Dipti Srinivasan},
keywords = {Multi-sensor fusion, Deep fusion network, Contrastive learning-based few-shot learning, Insulation defect diagnosis, GIS},
abstract = {Deep learning based multi-source fusion has shown significant potential in diagnosing insulation defects in gas-insulated switchgear (GIS). However, its applicability in real engineering scenarios remains limited. Existing fusion frameworks struggle to model the heterogeneous sensing characteristics of optical and electrical channels, often relying on rigid or shallow interaction schemes that fail to capture modality complementarity. In addition, field data are typically scarce and distribution-shifted, making it difficult for conventional models to learn discriminative and generalizable features under small-sample conditions. To address these challenges, we propose a novel multi-sensor fusion few-shot learning network (MSFFLN) for GIS insulation defect diagnosis. First, a deep fusion network is developed to construct comprehensive representations of insulation defects. Specifically, a feature weighting fusion module is employed to improve robustness, while an adaptive attention-based fusion block suppresses redundant and aliased information, emphasizing the most discriminative features. Second, a contrastive learning-based few-shot strategy is introduced. By computing global and local contrastive losses and using contrastive learning as an auxiliary task, the model learns more accurate and generalizable feature representations. In addition, salient region mixing across samples is applied to decouple class-level and instance-level feature correlations. Finally, field experiments validate the effectiveness of the MSFFLN. Results show that the MSFFLN achieves a diagnostic accuracy of 95.06% with only 10 support samples, significantly outperforming baseline and ablation models in small-sample GIS insulation defect diagnosis.}
}
@article{WANG2026114552,
title = {Deep multi-view clustering algorithm with integrated auto-encoder and non-negative matrix factorization},
journal = {Applied Soft Computing},
volume = {190},
pages = {114552},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114552},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018654},
author = {Dexian Wang and Sha Yang and Ping Deng and Zheng Yu and Qiaofeng Wu and Wei Huang and Pengfei Zhang and Weiping Ding},
keywords = {Multi-view fusion, Multi-view clustering, Auto-encoder, Deep learning, Non-negative matrix factorization},
abstract = {Multi-view clustering algorithms combining auto-encoder and non-negative matrix factorization (NMF) are usually realized by using multiple factorizations of low-dimensional matrices. These algorithms suffer from the following issues leading to poor algorithm performance: 1) lack of nonlinear feature learning strategies, and 2) lack of learning rates to guide algorithm updates. To address these issues, we propose a deep multi-view clustering algorithm with integrated auto-encoder and NMF (DMCAN). Specifically, we first integrate NMF and auto-encoder into a unified framework, and the operation object of the algorithm is transformed from matrix to element level. Then, the objective function is constructed and the SGD with learning rate guidance is used to learn the corresponding gradient values of the elements. Next, it is transformed into weight values to construct the DMCAN deep network. DMCAN network learning can minimize the objective function. Finally, we conducted extensive experiments on eight public datasets, and the DMCAN algorithm outperforms peer algorithms on several metrics, including ACC. The improved performance of the algorithm is attributed to the introduction of the learning rate and the construction of the element-based deep learning network to optimize the objective function. These enable better parameter seeking and nonlinear feature learning.}
}
@article{BARA2026114455,
title = {An extensible framework for energy community embedding business models and AI-generated code snippets},
journal = {Applied Soft Computing},
volume = {190},
pages = {114455},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114455},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017685},
author = {Adela Bâra and Simona-Vasilica Oprea and Gabriela Dobrița},
keywords = {Business models framework, Energy communities, Local energy markets, Template-driven code generation, Large language models},
abstract = {This paper presents a modular and extensible framework for simulating the operation of Energy Communities (ECs) and their participation in Local Energy Markets (LEMs). The framework integrates agent-based modelling, weather-driven asset simulation and flexible market-clearing mechanisms to support high-resolution techno-economic analysis. It introduces three main contributions: (i) a heuristic, data-driven algorithm for estimating household consumption under partial observability, (ii) the Dynamically Adjusted Uniform Price (DAUP), a new pricing mechanism that increases traded volumes through iterative bid adjustment and (iii) GenECodes, a generative module powered by Large Language Models that automatically produces simulation-ready asset and market models using a three-layer architecture. Simulations based on a Romanian EC show high accuracy of the asset models, significant improvements in traded energy and self-consumption using DAUP, and seamless integration of new assets such as heat pumps and electric vehicles via GenECodes. The framework enables rapid prototyping of emerging business models and supports the digital transition of decentralized energy systems.}
}
@article{FU2026114540,
title = {Adaptive multi-scale self-supervised soil pore segmentation based on sequence similarity},
journal = {Applied Soft Computing},
volume = {190},
pages = {114540},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114540},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018538},
author = {Yinkai Fu and Yue Zhao and Benye Xi and Yandong Zhao and Meihui Song and Qiaoling Han},
keywords = {Soil pore, Sequence similarity, Contrastive self-supervised learning, Computed tomography, Adaptive multi-scale fusion},
abstract = {Deep learning methods typically rely on large amounts of manually annotated data for training. Annotating long sequences of soil CT images is extremely labor-intensive, while training with sparse labels leads to significant accuracy degradation and over-fitting. To address this challenge, this study proposes a novel adaptive multi-scale self-supervised segmentation method (AMSS). This method incorporates an innovative Sequence Comparison Self-Supervision (SeCo) module, which extracts pore information at different scales through adaptive multi-scale fusion. It also leverages CT image sequence similarity to achieve more efficient self-learning. A novel evaluation metric BSM is introduced to evaluate the label utilization efficiency and segmentation performance of the methods. Results demonstrate that AMSS exhibits outstanding segmentation performance: under fully labeled training, AMSS achieves a recall rate of 94.3 %, surpassing the second-best supervised method ConvNeXt by 6.6 %age points (87.7 %). When utilizing only 2.5 % of the labels (50 out of 1960 total), AMSS reaches 94.6 % of the full-label segmentation performance. Its F1-score (83.9 %) and BSM (90.7 %) surpassed the second-best self-supervised method DINOv2 by 3.8 %age points and 1.9 %age points, respectively, while also exceeding the weakly supervised method WSSPS by 5.1 %age points (78.8 %) and 2.6 %age points (88.1 %). To further demonstrate the method's generalizability, experimental tests were conducted on the other two types of soil. The results show that AMSS still achieves the highest F1-scores (74.3 % and 70.3 %) and BMS (85.9 % and 83.9 %), demonstrating strong cross-soil-type adaptability. This research provides more efficient and precise image processing technology support for advancing modern soil research.}
}
@article{OZCALICI2026114557,
title = {A robust hybrid MCDM framework with emphasis on decision stability intervals: Performance evaluation of global insurance brokers using fuzzy LBWA and modified ARTASI},
journal = {Applied Soft Computing},
volume = {190},
pages = {114557},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114557},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000050},
author = {Mehmet Özçalici and Dragan Pamucar and Hasan Emin Gurler and Nazan Güngör Karyağdi and Ahmet Kaya},
keywords = {Insurance brokerage, Multi-criteria decision-making, Fuzzy LBWA, ARTASI method, Performance evaluation, Decision stability interval, Monte carlo simulation},
abstract = {Evaluating the performance of insurance brokerage firms involves multiple, often conflicting criteria influenced by uncertainty and data ambiguity. Conventional multi-criteria decision-making (MCDM) approaches often fail to capture both preference fuzziness and the robustness of ranking outcomes. This study aims to develop a hybrid MCDM framework that ensures transparent, stable, and interpretable performance evaluation of leading global insurance brokers. The proposed framework integrates Fuzzy LBWA for deriving criteria weights with a modified ARTASI method for ranking alternatives. A dataset of 30 financial and operational indicators from 2021 to 2024 is analyzed for five major brokerage firms. Additionally, Decision Stability Intervals (DSI) and Monte Carlo simulations are introduced to test robustness and identify rank-sensitive indicators. The results reveal a consistent performance hierarchy—MMC maintains the leading position, BRO demonstrates improvement, and WTW shows notable volatility. Quantitatively, the DSI analysis revealed that liquidity ratios such as Current Assets / Total Assets and Cash Ratio have the widest stability ranges (up to +0.34 and +0.30, respectively), whereas profitability indicators exhibit the narrowest tolerance bands (approximately ±0.006–0.008), confirming their critical influence on ranking stability. Profitability and leverage indicators have the narrowest tolerance ranges, underscoring their strategic role in performance differentiation. The study contributes a novel robustness analysis tool (DSI) and demonstrates the model’s adaptability across industries such as banking, energy, and logistics. It enhances managerial decision-making by identifying stability-critical metrics and offers a foundation for future research integrating behavioral and ESG-oriented factors.}
}
@article{ZHANG2026114604,
title = {A heuristic payload configuration method for UAV swarm based on hybrid genetic algorithm and variable neighborhood search},
journal = {Applied Soft Computing},
volume = {190},
pages = {114604},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114604},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000529},
author = {Zitang Zhang and Qian Sun and Yujie Huang and Yibing Li},
keywords = {UAV swarm, Payload configuration, Genetic algorithm, Variable neighborhood search},
abstract = {With the advancement of unmanned systems technology, unmanned aerial vehicle (UAV) swarms composed of miniaturized, heterogeneous, and intelligent platforms have emerged as a new operational paradigm in military operations. However, efficient heterogeneous UAV swarm payload configuration (HUPC) remains a significant challenge due to limited single-platform capabilities, which is further exacerbated by the increasing number of platforms, strong coupling among diverse resource types, and heterogeneous mission requirements. To address this issue, this paper proposes a payload configuration algorithm tailored to the operational characteristics of UAV swarms. The HUPC problem is formulated as a bi-variable integer nonlinear programming model, with the objective of minimizing overall configuration cost while satisfying multiple operational constraints. To solve the above model, a heuristic initialization strategy is developed based on multi-attribute encoding and task-driven prioritization, combined with a parallel evolutionary and variable neighborhood search (VNS) approach under the genetic algorithm’s (GA) framework. The algorithm leverages accumulated historical experience during the optimization process to efficiently derive payload configuration schemes that meet mission requirements. Simulation results demonstrate that, compared with existing approaches, the proposed method reduces the average configuration cost by approximately 10% in small-scale scenarios and about 7% in medium- and large-scale scenarios, while maintaining stable performance under multiple operational constraints. This demonstrates that the proposed method ensures the feasibility and rationality of payload configuration schemes across tasks of varying scales.}
}
@article{PANG2026114612,
title = {Effective multi-scale super-resolution of significant wave height using deep learning},
journal = {Applied Soft Computing},
volume = {190},
pages = {114612},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114612},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000608},
author = {Junheng Pang and Sheng Dong},
keywords = {Wave downscaling, Super-resolution, Deep learning},
abstract = {High-resolution significant wave height (Hs) data is crucial for wave energy development and offshore engineering applications. However, directly simulating fine-grained grid wave fields through numerical models is computationally expensive. Recently, super-resolution (SR) methods based on deep learning have shown great potential in reconstructing high-resolution wave data from low-resolution inputs. Practical engineering often requires reconstructing high-resolution Hs data at multiple scaling factors, rather than being restricted to a single fixed scale. To address this challenge, this study proposes a novel deep learning model for multi-scale super-resolution of Hs. The model enhances SR performance through the integration of the dense feature connection block, optimized downsampling/upsampling modules, and an effective dual attention mechanism. Five sea areas, encompassing both nearshore and open-ocean regions, were selected for the SR experiments. Wave data from authoritative reanalysis sources with varying spatial resolutions were used to construct datasets at multiple scaling factors. Two traditional interpolation methods and six advanced deep learning models were employed for comparison. The experimental results demonstrate that the proposed model effectively reconstructs wave height features and shows high consistency with the ground-truth high-resolution fields. Quantitative evaluation confirms that the proposed model achieves the best SR performance in all scenarios, with structural similarity index values consistently exceeding 0.95. An ablation study further validated the individual contributions of the model’s key components to its overall performance.}
}
@article{ZHANG2026114548,
title = {Advanced metaheuristic optimization with enhanced dung beetle algorithm for automated crack detection in civil infrastructure},
journal = {Applied Soft Computing},
volume = {190},
pages = {114548},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114548},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018617},
author = {Xudong Zhang and Bin Chen and Jinyong Xiao and Jie Yang},
keywords = {Structural health monitoring, Hyperparameter optimization, Crack detection, Mathematical modeling},
abstract = {Infrastructure surface crack detection is a critical component of structural health monitoring systems, essential for ensuring the safety and serviceability of civil engineering structures. While deep learning-based approaches have demonstrated superior performance in crack detection tasks, they frequently encounter challenges related to hyperparameter optimization, local optima entrapment, and suboptimal feature extraction, which significantly impact detection accuracy and reliability. This study presents a novel framework that integrates the Multi-Strategy Enhanced Dung Beetle Optimizer (MSEDBO) with deep learning models for enhanced infrastructure surface crack detection. The proposed approach leverages MSEDBO’s advanced optimization capabilities, including Latin Hypercube Sampling with elite population initialization, improved sigmoid-based nonlinear control factor, sine-cosine algorithm integration, and multi-population mutation strategies, to systematically optimize critical parameters in the crack detection pipeline. Experimental validation was conducted on multiple benchmark crack datasets including CrackTree200, CFD, GAPs, and SDNET2018, covering diverse infrastructure materials such as concrete pavements, asphalt roads, and bridge surfaces. Results demonstrate that the MSEDBO-optimized detection framework achieves superior performance compared to conventional optimization algorithms and baseline deep learning models, with improvements of 8.7% in detection accuracy, 12.3% in precision, and a 15.6% reduction in false positive rates. The proposed methodology effectively balances global exploration and local exploitation capabilities, successfully avoiding local optima while maintaining computational efficiency. This research contributes to the advancement of intelligent infrastructure monitoring systems and provides a robust optimization framework for enhancing the reliability of automated crack detection in civil engineering applications.}
}
@article{WANG2026114555,
title = {Information flow redistribution for diabetic retinopathy multi-lesion segmentation},
journal = {Applied Soft Computing},
volume = {190},
pages = {114555},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114555},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000037},
author = {Jiale Wang and Hui Ma},
keywords = {Eye analysis, Lesion segmentation, Feature allocation, Information flow},
abstract = {Common retinal lesion segmentation methods often rely on multi-stage networks, which cause spatial information to diminish in deeper layers while channel information increases, leading to feature imbalance. To address this, we propose a novel and effective method that introduces a top-down Cross Spatial Information Flow (CSIF) and a bottom-up Cross Channel Information Flow (CCIF). CSIF gradually propagates fine spatial details from shallow to deep layers, while CCIF delivers precise channel information from deep to shallow layers. Specifically, we extract fine spatial cues and accurate channel features via autocorrelation-based affinity operations in spatial and channel dimensions, respectively. These are then redistributed using cross-correlation mechanisms to compensate for insufficient spatial or channel information at various depths, while irrelevant features are compressed to maintain computational efficiency. We apply this method to the engineering task of retinal lesion segmentation, and experimental results on two widely used public datasets demonstrate that our method achieves competitive performance and strong generalization capabilities across different data domains.}
}
@article{ZHAO2026114607,
title = {Open set recognition based on fuzzy rule classifier and probabilistic distribution analysis with application to spectral material classification},
journal = {Applied Soft Computing},
volume = {190},
pages = {114607},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114607},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000554},
author = {Peng Zhao and Zhen-Yu Li},
keywords = {Open set recognition, Spectral material classification, Fuzzy rule classifier, Spectral analysis},
abstract = {Open set recognition aims to classify known classes and reject unknown classes simultaneously. This study is often performed based on machine learning and deep learning. In machine learning based schemes, the classification boundary of known classes must be contracted and refined accurately, which is sometimes hard to solve in practice. In deep learning based schemes, a large dataset is required to train deep neural networks. These networks can only process images whose size should be sufficiently large. The spectral curve dataset cannot be processed by these networks usually. In this article, a novel open set recognition scheme is proposed based on a revised fuzzy rule classifier with application to spectral curve classification. A small spectral dataset is required to train this fuzzy rule classifier. After fuzzy rule training, the used fuzzy rules can be used to classify known classes, whereas the unused rules to reject unknown classes. Therefore, the contraction and refinement of classification boundary for known classes are not required. When a sample is sent into this revised fuzzy classifier, we get some fuzzy rules and their corresponding nonzero scores. The probabilistic distribution is then evaluated by the Entropy or Gini index. If this probabilistic distribution is certain, one class corresponding to the maximal score is final output class. Otherwise, this sample is rejected as unknown class. The comparison experimental results on mango, melamine and wood datasets demonstrate that our proposed scheme achieves approximately mean 42.30 % improvement in terms of overall recognition accuracy compared to baseline models.}
}
@article{TRUONG2026114610,
title = {Advanced generative artificial intelligence and deep learning for long-term container throughput forecasting under stochastic disruptions},
journal = {Applied Soft Computing},
volume = {190},
pages = {114610},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114610},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600058X},
author = {Ngoc Cuong Truong and Duy Anh Nguyen},
keywords = {Container throughput forecasting, Advanced generative artificial intelligence, Advanced predictive analytics, Long-term time series forecasting, Hybrid deep learning models},
abstract = {In the face of interruptions that can majorly impact global supply chains, strategic planning and operational efficiency depend on accurate long-term forecasting of container throughput. This paper presents an advanced forecasting system that incorporates nonlinear wavelet decomposition to break down complicated time series data into easier-to-understand parts. These components are then predicted through the use of a hybrid model that blends deep learning methods, particularly the Stacked Long Short-Term Memory (Stacked LSTM) network, with the Wasserstein Generative Adversarial Network with Gradient Penalty (Wasserstein GAN-GP). Using this hybrid technique, the model can better forecast disruption-induced changes in container throughput and capture nonlinear patterns. A case study is conducted at Busan Port, one of the world’s busiest container ports, comprising five major container terminals. The proposed hybrid model achieves forecasting accuracy of 91.09 % for the most complex 40FT container dataset, compared to less than 85 % for traditional methods. For 20FT and 10FT datasets, the model maintains accuracy above 90 %, consistently outperforming baseline approaches. The proposed model is evaluated against conventional forecasting methods using the Long Short-Term Memory (LSTM), Stacked Long Short-Term Memory (Stacked LSTM), and other hybrid models as benchmarks. Across all datasets, the hybrid approach consistently records the lowest MAE, MSE, and RMSE values, validating its robustness under growing data complexity and stochastic disruptions. The study's practical ramifications demonstrate how the suggested approach could assist port officials, terminal operators, and logistics stakeholders make data-driven choices amidst volatile global trade conditions.}
}
@article{HAMDOUCH2026114652,
title = {Hopfield network-based algorithm for combinatorial optimization},
journal = {Applied Soft Computing},
volume = {190},
pages = {114652},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114652},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001006},
author = {Houssam Hamdouch and Safae Rbihou and Kaoutar Senhaji and Khalid Haddouch},
keywords = {Recurrent neural networks, Hopfield networks, Hyperparameter optimization, Arithmetic optimization algorithm, Combinatorial optimization, Metaheuristics},
abstract = {Combinatorial optimization problems (COPs) present significant computational challenges due to their discrete nature, increasing complexity, and NP-hard characteristics. Identifying an effective solver is particularly difficult given the large variety of existing techniques, including exact algorithms, metaheuristics, and neural-network-based approaches such as Hopfield networks (HNs). Although HNs have shown strong potential for solving complex COPs through an energy-minimization framework, their performance is highly sensitive to the choice of hyperparameters and the initialization strategy, both of which require careful tuning. This paper introduces a new method that enhances the effectiveness of HNs for COPs by jointly optimizing their hyperparameters and starting point using the Arithmetic Optimization Algorithm (AOA). The goal is to develop a recurrent-neural-network-based approach that leverages systematic hyperparameter tuning and optimal initialization to improve solution quality and convergence behavior. Experimental results demonstrate that the proposed method achieves optimal solutions on 20 instances of the task assignment problem (TAP) and provides high-quality solutions for the graph coloring problem (GCP) and the traveling salesman problem (TSP) within reasonable computational times. Compared to a genetic algorithm (GA) and traditional HNs with random hyperparameter selection, the proposed approach achieves performance improvements of 52.83% for TAP, 28.97% for GCP, and 9.32% for TSP.}
}
@article{WANG2026114615,
title = {Dynamic ensemble point-interval wind speed prediction system for data drift: Adaptive real-time feature decoupling and multi-level information fusion quantile regression},
journal = {Applied Soft Computing},
volume = {190},
pages = {114615},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114615},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000633},
author = {Jujie Wang and Xiawei Wu and Minghong Chen},
keywords = {Wind speed forecasting, Adaptive real-time feature decoupling, Model selection, Dynamic integration, Interval forecasting},
abstract = {Wind speed forecasting is essential for integrating renewable energy systems and advancing carbon neutrality objectives. As a key technology for wind power grid integration, accurate wind speed prediction enhances the grid’s capacity to absorb renewable energy, thereby reducing reliance on fossil fuels and mitigating environmental impacts from greenhouse gas emissions. However, wind speed’s dynamic evolutionary characteristics and the inherent data drift problem pose significant challenges to precise forecasting. This research develops an integrated wind speed prediction model incorporating adaptive real-time feature decoupling and a multi-head attention ensemble algorithm to address data drift. The enhanced successive variational mode decomposition, combined with a sliding window, is first used for adaptive real-time feature decoupling of original wind speed data, which dynamically tracks drift-induced variations by decoupling data into adaptive subsequences. A multi-dimensional quantitative optimal model matching strategy is adopted to achieve precise matching between each subsequence and the model. Multi-head attention adjusts integration weights to mitigate the impact of drift. Quantile regression with multi-level information fusion is utilized to additionally assess the uncertainty in wind speed variations and derive the ultimate forecasting outcomes. Experimental findings indicate that in one-step forecasting, the prosed model attained PICP values of 0.9645 and 0.9602, along with PINAW values of 0.2155 and 0.2296, at the two wind farms. While ensuring high coverage, it effectively controlled interval width, fully validating the system’s superior performance.}
}
@article{PANG2026114587,
title = {Multi-relational graph reinforcement learning for dynamic flexible job-shop scheduling under machine breakdowns},
journal = {Applied Soft Computing},
volume = {190},
pages = {114587},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114587},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000359},
author = {Zhi Pang and Xinyu Li and Liang Gao and Xuxia Zhang and Jun Wu},
keywords = {Machine breakdowns, Dynamic flexible job-shop scheduling, Deep reinforcement learning, Heterogeneous graph},
abstract = {In complex manufacturing environments where machine breakdowns may occur frequently, scheduling strategies need to rapidly adapt to topological changes to maintain robust decision-making. Under such unstable manufacturing resource conditions, the dynamic flexible job-shop scheduling problem presents a significant challenge due to the constantly changing multi-dimensional relationship structure between operations and machines. However, existing studies based on deep reinforcement learning (DRL) has significant deficiencies in capturing such complex structures, failing to explicitly model the evolving complex multi-relational patterns between operations and machines and their competitiveness in dynamic scenarios, which may limit both the performance and generalization capability of the learned policies. To this end, a Multi-Relational Graph Reinforcement Learning (MRGRL) that comprehensively considers its complex relationship dependencies is proposed in this paper, explicitly modeling multi-type dependencies and competition patterns through different meta-paths. The scheduling problem is formulated as a Markov Decision Process (MDP), where each decision step is represented by an evolving heterogeneous graph structure. And to effectively capture both local and global relational patterns, a two-level heterogeneous attention mechanism guided by meta-paths is introduced to learn fine-grained state embeddings, which in turn support the downstream decision-making network in making high-quality action selections. Experimental results show that the proposed method outperforms six well-established priority dispatching rules and two state-of-the-art DRL-based scheduling methods across 800 synthetic instances. Furthermore, it consistently achieves superior performance over all baselines on three larger-scale synthetic instance sets, four synthetic instance sets with higher disturbance intensities, and four expanded public benchmark instance sets, demonstrating its strong generalization ability.}
}
@article{LEITE2026114639,
title = {Evolving granular fuzzy control: Overview, case study on the chaotic Hénon map, and research outlook},
journal = {Applied Soft Computing},
volume = {190},
pages = {114639},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114639},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000876},
author = {Daniel Leite and Reinaldo Palhares and Igor Škrjanc and Fernando Gomide},
keywords = {Optimal fuzzy systems, Adaptive control, Evolving AI, Incremental learning, Rule-based learning},
abstract = {This paper highlights the relevance of evolving granular fuzzy systems in adaptive control and fuzzy modeling, particularly for learning in dynamic, nonstationary environments. These systems incrementally construct rule-based models—such as predictors and controllers operating in open- or closed-loop configurations—by adapting both structure and parameters from data streams. This provides a flexible and autonomous alternative to traditional parametric-adaptive approaches. We consolidate foundational concepts in fuzzy and adaptive control, positioning evolving systems as data-driven extensions of classical schemes. Key challenges are discussed, including safety-aware adaptation to drift, memory mechanisms, interpretability, and principled structural evolution. Building on these foundations, we develop a more mature formulation of the state-space evolving granular modeling and control framework (SS-EGM/SS-EGC), introducing a decay-rate–oriented treatment that advances the methodology beyond mere LMI feasibility toward online optimality. A compact case study on the chaotic Hénon map illustrates the approach: an online SS-EGM learned from data streams supports SS-EGC synthesis that stabilizes the map under bounded inputs. One-step prediction accuracy and decay-rate estimates confirm real-time viability. The framework provides a flexible basis that can be further extended in multiple directions to address the identified challenges.}
}
@article{WANG2026114623,
title = {An interpretable asymmetric direct interval model for carbon price forecasting based on optimal multi-granularity modes extraction and high-dimensional causal discovery},
journal = {Applied Soft Computing},
volume = {190},
pages = {114623},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114623},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000712},
author = {Yingqi Wang and Yaning Li and Yuxuan Lu},
keywords = {Asymmetric direct interval prediction, Multi-granularity modes extraction, High-dimensional causal discovery, Multi-objective optimization},
abstract = {Accurate carbon price range forecasting is crucial for addressing environmental problems and optimizing climate policy. Many studies rely on accurate point estimation and are symmetrical. However, in reality, carbon price data often exhibit skewness or heavy-tailed characteristics, and the symmetry interval is inconsistent with the actual situation. To overcome this limitation, we develop an interpretable interval forecasting framework based on soft computing methods that combines three key components: optimal multi-granularity modes extraction, high-dimensional causal feature discovery, and multi-objective asymmetric direct interval prediction. Initially, optimal multi-granularity modes extraction is employed to extract multi-scale price fluctuation features from non-stationary carbon price series. Subsequently, a high-dimensional causal discovery method is applied to systematically uncover nonlinear causal relationships between price patterns and external factors. Finally, asymmetric prediction intervals are directly constructed by establishing the lower and upper bound estimation framework. To verify our model, experiments were implemented using carbon price data from China’s Guangdong, Hubei, and the European Union emissions trading system. The model achieves prediction interval coverage rates of 0.99, 0.94, and 0.98, while reducing interval widths by 27.91 % on average compared to benchmark methods, significantly enhancing both accuracy and interpretability of carbon price forecasting.}
}
@article{DONG2026114647,
title = {PhysDiffWind: A physics-constrained retrieval-augmented diffusion framework for offshore wind speed forecasting},
journal = {Applied Soft Computing},
volume = {190},
pages = {114647},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114647},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000955},
author = {Wei Dong and Jinxing Che and Yan Mei and Lei Zhou and Yuhua Zhang},
keywords = {Diffusion probabilistic models, Retrieval augmentation, Multivariate time series, Offshore wind speed forecasting},
abstract = {Offshore wind speed forecasting remains challenging due to strong variability, nonlinear dynamics, and the limited use of physical constraints. Existing models rarely incorporate key physical factors such as the pressure gradient and wind speed relationship, the effects of temperature and humidity on air density, and historical wind patterns, while underutilizing relevant past meteorological scenarios. To address these limitations, we propose PhysDiffWind, a physics-constrained retrieval-augmented diffusion framework for accurate probabilistic offshore wind forecasting. The framework integrates a multi-module cooperative architecture. Specifically, the retrieval-augmented module employs a multi-head temporal convolutional network to encode historical multivariate sequences and dynamically retrieves representative historical patterns from a database via similarity-based embedding matching. Meanwhile, the physics-and-context-aware side information module incorporates temporal features with environmental variables such as pressure gradient and air density to provide structured guidance for the diffusion process. Furthermore, the diffusion module adopts a transformer-based conditional architecture to implement a two-stage modeling approach: forward perturbation and reverse denoising, and generates physically consistent and probabilistically expressive wind speed distributions under the modulation of retrieval samples and physical side information. Extensive experiments on real-world offshore wind datasets show that PhysDiffWind reduces the mean squared error (MSE) by up to 55.1 % and the continuous ranked probability score (CRPS) by 49.3 % compared with state-of-the-art baselines. These results confirm the framework’s effectiveness in capturing nonlinear atmospheric dynamics and improving forecasting reliability for wind farm operations.}
}
@article{MERINOV2026114582,
title = {Positive-sum impact of multistakeholder recommendations for urban tourism},
journal = {Applied Soft Computing},
volume = {190},
pages = {114582},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114582},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600030X},
author = {Pavel Merinov and Francesco Ricci},
keywords = {Multistakeholder recommender systems, Simulations, Pareto frontier, Tourism promotion management, Decision making, Limited catalogue awareness, Urban tourism, Urban sustainability},
abstract = {Multistakeholder Recommender Systems (MRSs) mediate possibly contrasting goals of the parties involved in the recommendation process. For example, in the tourism domain an MRS could be designed to balance the sustainable goal of a destination to reduce the overcrowding of popular points of interest, while still satisfying the preferences of tourists who would like to visit popular places. The conflicting nature of these goals raises the question of whether, by means of recommendations, it is possible to achieve better outcomes for both stakeholders, i.e., the tourists and the destination. To answer this question, we simulate the impact of an MRS on tourists’ choices. We focus on a class of MRSs that linearly balance tourists and destination objectives. This is the prevalent balancing approach to date. We assume a realistic scenario where tourists have limited knowledge of the points of interest catalogue and the MRS has little information about tourists’ preferences. Simulations of tourist-system interactions in crowded cities show that this MRS can guide tourists to choose more appropriate places to visit, benefiting both them and the destination. We refer to this as a positive-sum impact. However, a proper balance is crucial: putting under- or over-emphasis on sustainable points of interest in the recommendation lists can be detrimental to both destination sustainability and tourists’ satisfaction. Moreover, with simulations, we show that even non-personalised popularity-driven recommendations, when combined with sustainable recommendations, can have a (less pronounced) positive impact. This suggests that even a simple non-personalised MRS may be useful in urban tourism, if properly used.}
}
@article{KIM2026114611,
title = {Stochastic subsampling with average pooling},
journal = {Applied Soft Computing},
volume = {190},
pages = {114611},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114611},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000591},
author = {Bum Jun Kim and Sang Woo Kim},
keywords = {Deep neural networks, Dropout, Global average pooling, Regularization, Computer vision},
abstract = {Regularization is essential for improving the generalization of deep neural networks while mitigating overfitting. Although the popular method of Dropout provides a regularization effect, it causes inconsistent properties in the output, which may degrade the performance of deep neural networks. In this study, we propose a new module called stochastic average pooling, which incorporates Dropout-like stochasticity into pooling. We describe the properties of stochastic subsampling and average pooling and leverage them to design a module without any inconsistency problems. The stochastic average pooling achieves a regularization effect without any potential performance degradation due to the inconsistency issue and can be easily plugged into existing deep neural network architectures. Experiments demonstrate that replacing existing average pooling with stochastic average pooling yields consistent improvements across a variety of tasks, datasets, and models.}
}
@article{WANG2026114567,
title = {BiSGR-Att: A sequence recommendation model based on bidirectional simplified gated recurrent network with linear attention},
journal = {Applied Soft Computing},
volume = {190},
pages = {114567},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114567},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000153},
author = {Ruiqin Wang and Chi Fang and Xinyi Sui and Yubin Ren and Xiongtao Zhang},
keywords = {Sequential Recommendation, Gating Mechanism, Long Short-term Interest, Linear Attention},
abstract = {With the continuous evolution of recommendation systems, capturing the dynamic changes of user preferences and complex behavior patterns has become a key challenge in improving recommendation quality. To address the above issues, this paper proposes a novel sequence recommendation model — Bidirectional Simplified Gated Recurrent network with linear Attention (BiSGR-Att). BiSGR-Att consists of three key modules: Bidirectional Simplified Gated Recurrent Network (Bidirectional SGRN), linear Attention, and Mixture of Experts (MoE). The Bidirectional SGRN effectively models user’s short-term dynamic preferences by simultaneously capturing forward and backward dependencies in their behavior sequence. The linear attention mechanism reduces the computational overhead of attention mechanism to a linear level, enabling efficient modeling of long-term user preferences. The MoE module dynamically selects appropriate experts based on the diversity of input features, enhancing the model's ability to capture complex user behavior patterns. Extensive experiments over five datasets demonstrated the BiSGR-Att achieved an average improvement of 3.06 % on HR@10, 3.04 % on NDCG@10 and 3.98 % on MRR@10 compared to the baselines, especially in complex scenarios with sparse user behavior and rapidly changing preferences.}
}
@article{AKSOY2026114619,
title = {AI-driven energy storage optimization in microgrids: Integrating deep reinforcement learning with BiLSTM and LightGBM models},
journal = {Applied Soft Computing},
volume = {190},
pages = {114619},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114619},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000670},
author = {Necati Aksoy and Istemihan Genc},
keywords = {Deep reinforcement learning, Soft actor-critic, Proximal policy optimization, LightGBM, BiLSTM, Energy storage systems},
abstract = {The integration of intermittent renewable energy sources and dynamic pricing mechanisms into modern microgrids necessitates intelligent energy management systems (EMS) to ensure economic viability and grid stability. This paper proposes a novel framework that synergizes advanced forecasting models with Deep Reinforcement Learning (DRL) to optimize the operation of an Energy Storage System (ESS). We develop high-fidelity prediction models using LightGBM for solar and wind power forecasting and a Bidirectional Long Short-Term Memory (BiLSTM) network for load demand and electricity price forecasting. These predictions inform two distinct DRL environments: a 7-action discrete model and a more complex continuous-action model that holistically manages the entire microgrid. Four DRL agents-Deep Q Network(DQN), Double DQN (DDQN), Proximal Policy Optimization (PPO), and Soft Actor-Critic (SAC)-are trained and evaluated. The results demonstrate the framework’s efficacy, with all agents learning profitable control policies. The SAC agent consistently yielded superior performance, achieving cost savings as high as 53.89% in the discrete environment with Austrian data and 54.91% with Finnish data. In the more complex continuous-action environment, the SAC agent also demonstrated the most robust and profitable strategy, validating the proposed system’s potential for significantly enhancing microgrid operational efficiency and profitability.}
}
@article{AO2026114550,
title = {Design and analysis of a spectral clustering equilibrium differential evolution algorithm for linkage dimensional synthesis},
journal = {Applied Soft Computing},
volume = {190},
pages = {114550},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114550},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018630},
author = {Meng Ao and Gaohong Yu and Lei Wang and Liang Sun and Bingliang Ye},
keywords = {Differential evolution, Linkage dimensional synthesis, Population dynamic, Spectral clustering},
abstract = {Dimensional synthesis of linkage mechanisms is a core challenge in mechanism design, characterized by high dimensionality, strict constraints, and multimodal optimization landscapes that hinder global convergence. The absence of systematic methods for analyzing population dynamics during evolution has been a critical obstacle to algorithm design. This study introduces a novel analytical framework that integrates t-distributed stochastic neighbor embedding (t-SNE) visualization with spectral clustering, enabling multi-perspective evaluation of key search properties such as the balance between exploration and exploitation, population diversity, and the distribution of high-quality solutions. Building upon this framework, we further propose the Spectral Clustering Equilibrium Differential Evolution (SCEDE) algorithm tailored for linkage dimensional synthesis. By leveraging spectral clustering-guided population restructuring and a multi-strategy collaborative mechanism, SCEDE enhances global search capability under complex constraints. Experimental results on four representative linkage synthesis cases indicate that SCEDE often achieves better convergence accuracy and stability compared with fourteen advanced algorithms, suggesting its potential to provide reliable optimization solutions for practical linkage design. This research offers a new analyzable and guidance-oriented pathway for algorithm design in linkage dimensional synthesis problems.}
}
@article{GUO2026114591,
title = {A dual-population based uniform search framework for solving large-scale multi-objective optimization problems},
journal = {Applied Soft Computing},
volume = {190},
pages = {114591},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114591},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000396},
author = {Fengyu Guo and Hecheng Li},
keywords = {Large-scale multi-objective optimization, Evolutionary computation, Dual-population algorithm, Enhanced sampling, Clustering},
abstract = {Large-scale multi-objective optimization problems (LSMOPs), characterized by thousands of decision variables, are prevalent in real-world engineering applications. The increasingly complex decision space poses significant challenges for existing multi-objective evolutionary algorithms (MOEAs), many of which struggle to balance convergence and diversity due to limited search capability in such scenarios. To address this challenge, we propose a dual-population uniform search framework. Firstly, a restricted mating strategy in the decision space enhances the generation of high-quality solutions. Secondly, a pre-defined metric guides adaptive resource allocation across subpopulations in the objective space, promoting uniform exploration of high-potential regions. Finally, a balance between convergence and diversity in high-dimensional search spaces is achieved through the weak synergistic interaction of two functionally complementary populations. The proposed algorithm is evaluated on well-established benchmark suites with 1000 to 5000 decision variables and 2 to 5 objectives. Across 108 test instances, our method outperforms six state-of-the-art competitors in 80 cases, demonstrating significant improvements in convergence and diversity compared with state-of-the-art methods.}
}
@article{PENG2026114575,
title = {Bio-YOLO: A bio-inspired lightweight small object detection network for aerial images},
journal = {Applied Soft Computing},
volume = {190},
pages = {114575},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114575},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000232},
author = {Jiansheng Peng and Sihan Huang and Chuan Lin and Xintao Pang},
keywords = {Small object detection, Bio-inspired, Lightweight networks, Deep learning, Aerial images},
abstract = {In aerial image object detection, detecting a large number of small objects becomes a major challenge due to the significant differences in object sizes and the complexity of background information. Biological organisms, through their efficient visual nervous systems, are able to accurately identify tiny objects in their field of view. Inspired by the biological visual information processing mechanism, this study designs a three-part architecture consisting of a Pre-Network, Feature Extraction Network, and Feature Fusion Network. Furthermore, we propose an efficient and lightweight one-stage small object detection network—Bio-YOLO. By simulating the parallel pathways from the Retina/LGN-V1 and their receptive field characteristics, we construct a Pre-network with a dual-branch structure, significantly improving the detection capability for objects of different sizes. A new Feature Extraction Network is built by simulating the “ventral” visual pathway and its receptive field characteristics, which effectively enhances the detection of small objects while remaining lightweight. Inspired by the descending modulation mechanism of visual information, we design a Feedback Attention Fusion Module (FAFM) and build a new Feature Fusion Network that further strengthens the network’s ability to distinguish between objects and background. Experimental results show that Bio-YOLO achieves an mAP50 of 53.9 and an mAP50−95 of 23.7 on the AI-TOD dataset with only 1.8M parameters, demonstrating outstanding performance on the Visdrone dataset as well. This research not only advances the development of aerial image object detection technology but also provides new insights for the integration of biological vision and computer vision.}
}
@article{ZHONG2026114583,
title = {SewerMan: A vision–language collaborative framework with domain prior for robust multi-label sewer defect classification},
journal = {Applied Soft Computing},
volume = {190},
pages = {114583},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114583},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000311},
author = {Xuke Zhong and Yuzhong Zhong and Quan Xiao and Hu Qiang and Xingxing You and Songyi Dian},
keywords = {Sewer inspection, Visual-language collaboration, Material-sensitive, Semantic relationships, Domain prior},
abstract = {Vision-based automated sewer inspection plays a pivotal role in modern urban management, with recent advances leveraging data-driven methods to classify sewer defects. However, mainstream approaches often treat sewer defect classification as a generic multi-label task, neglecting two critical domain-specific factors: the material-conditioned variability of sewer defect features and the structured semantic relationships among sewer defect labels. This oversight leads to suboptimal feature representations, particularly for material-sensitive defects. In addition, the inherent label noise in human labeling poses a fundamental challenge to large-scale multi-label datasets. To address these limitations, we propose SewerMan, a novel vision–language collaborative framework that synergizes a visual-language image classification model with advanced data pre-processing through four key innovations: an Optimal Transport-based Images Purification (OTIP) module to filter label-noisy samples using optimal transport theory; a Text-Guided Feature Extraction Network (TGFENet) that refines defect features by incorporating sewer material information; a Hierarchical Visual-Semantic Alignment (HVSA) module that bridges modality gaps by aligning hierarchical visual features with semantic embeddings of defect labels; and a Semantics-Guided Greedy Feature Selection (SGFS) module that selects key regions from visual features via multi-stage differentiable search guided by semantic relevance. Evaluated on the Sewer-ML dataset (spanning 17 defect classes across 8 material types), SewerMan achieves 67.00% F2CIW score on the validation set, a 3% absolute improvement over the previous State-of-the-Art (SOTA), demonstrating its effectiveness in integrating domain prior with cross-modal interactions to establish a new benchmark for automated sewer inspection systems. The code and pre-trained models are available at: https://github.com/zkkzxk/SewerMan.}
}
@article{LU2026114464,
title = {Advancing multi-source domain adaptation via generalized divergence measures},
journal = {Applied Soft Computing},
volume = {190},
pages = {114464},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114464},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017776},
author = {Mingfei Lu and Jun Lei and Badong Chen},
keywords = {Multi-source domain adaptation, Generalized divergence, Sample-based estimation},
abstract = {As a significant topic in the field of transfer learning, multi-source domain adaptation (MSDA) aims to align feature embedding distributions among multiple source domains and a target domain, thereby facilitating robust learning in the presence of domain shift. Traditional methodologies primarily focus on minimizing the average pairwise discrepancy or dissimilarity between these distributions. However, such approaches are inherently limited, as they only quantify local differences between pairs of distributions, failing to capture complex high-order interactions and global variations that may arise among three or more groups of distributions. Moreover, these methods often rely on traversal algorithms with double-nested loops, leading to significant computational inefficiencies and high resource demands. To address these limitations, we propose a novel framework leveraging generalized divergence measures, such as the Generalized Jensen–Shannon Divergence (GJSD) and the Generalized Jensen–Rényi Divergence (GJRD), to quantify divergence across all domains simultaneously. Unlike pairwise comparisons, these measures are designed to quantify divergence across multiple distributions simultaneously, enabling a more holistic alignment of feature distributions. Using kernel learning, we derive closed-form, non-parametric estimators for GJSD and GJRD, integrating them into an enhanced moment-matching framework for MSDA. Our approach reduces computational complexity while ensuring robust alignment of heterogeneous distributions. Extensive experiments on benchmark datasets, including DigitsFive, Office-31, and Office-Home, demonstrate that our method outperforms state-of-the-art approaches, achieving higher accuracy, as well as improved adaptiveness and robustness. This framework sets a new standard for MSDA by enabling efficient, comprehensive distribution alignment.}
}
@article{XI2026114524,
title = {Real-time detection of insulator and self-explosion defect based on the lightweight MEGB-YOLOv5s model},
journal = {Applied Soft Computing},
volume = {190},
pages = {114524},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114524},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501837X},
author = {Yanhui Xi and Zheng Wu and Chunmei Yao and Hongming Yang and Feng Zhou},
keywords = {Light weight, Insulator and defect detection, Synthetic fog data augmentation, Aerial image},
abstract = {Timely and accurate identification of insulators with self-explosion defects is crucial to the safe operation of the power system. To obtain good accuracy, the existing methods sacrifice model size, which is not convenient for edge-end deployment. Thus, this paper proposes an insulator and defect detection method based on lightweight MEGB-YOLOv5s+SIoU (mobilenetv3 efficient-channel- attention ghostconv bidirectional-feature-pyramid- network YOLOv5s with splicing intersection over union) model, which can achieve a good balance between the lightweight and accuracy. The lightweight MNtV3-ECA (mobileNetV3 efficient channel attention) structure is introduced in the backbone of YOLOv5s, and GhostConv (ghost convolution) and C3G (C3 ghost) networks are added in the neck to reduce model size. To obtain high detection accuracy, the BiFPN (bidirectional feature pyramid network) is used in the neck to achieve multi-scale feature fusion, and the angle vector loss function SIoU is employed to optimize the model. Also, synthetic fog data augmentation based on dark channel prior is proposed to expand defect samples. The experimental results show that the proposed lightweight MEGB-YOLOv5s+SIoU model has only 1.74 M parameters, 3.5 G FLOPs, and 3.9 MB model size, while it can achieve a detection speed of 47.33 FPS. The size of the proposed model is smaller than YOLOv5s by 72.92 %, which facilitates deployment in UAVs. The mP, mAP@0.5, and mR of the proposed model reach 92.9 %, 93.1 %, 91 %, respectively, and the FPS is higher by 43.16 % in comparison with YOLOv5s. More importantly, the UAV-deployed detection algorithm is capable of efficiently detecting real-world insulators and self-explosion defects under clear-weather conditions.}
}
@article{LIU2026114580,
title = {Structural health performance assessment using hysteretic-driven neural network with physical self-correction mechanism and its experimental study},
journal = {Applied Soft Computing},
volume = {190},
pages = {114580},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114580},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000281},
author = {Chen Liu and Huiyong Guo and Jin Di and Kaixuan Zheng},
keywords = {Neural network, Structural health assessment, Quantitative method, Hysteresis model, Quasi-static tests},
abstract = {The quantification of structural health has emerged as a core challenge in structural health monitoring. This paper proposes a hysteresis-driven neural network with a self-correction mechanism for evaluating structural health by integrating multiple performance indexes. Initially, we establish a hysteresis-driven neural network embedded with the Bond-SP01 model (HDNN-BSP), using the physical model’s relationship as the law to enable the network to have a self-correction mechanism. Subsequently, stiffness and energy dissipation performance indicators are derived from the hysteresis model, and weights are judiciously assigned based on the shapes of performance degradation to achieve structural health quantification. To validate the proposed methodology, conventional quasi-static tests on beam and column components and two sets of quasi-static tests on steel frames with varying complexities were conducted. The results indicate that the method can accurately depict the deterioration of structural health, providing a new approach to quantify structural health assessment.}
}
@article{LEI2026114549,
title = {Dynamic scheduling for distributed flexible job shop using deep reinforcement learning},
journal = {Applied Soft Computing},
volume = {190},
pages = {114549},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114549},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018629},
author = {Yong Lei and Qianwang Deng and Shuocheng Gao and Kaidan Deng and Mengqi Liao and Qiang Luo},
keywords = {Dynamic scheduling, Distributed flexible job shop, Stochastic job arrivals, Machine breakdowns, Deep reinforcement learning},
abstract = {Dynamic events would seriously affect the realization of intelligent manufacturing with flexibility, agility, and personalized customization in distributed flexible job shops. Thus, this paper investigates a dynamic distributed flexible job shop scheduling problem (DDFJSP) considering stochastic job arrivals and machine breakdowns. A deep reinforcement learning algorithm (DRL)-based scheduling method is proposed to minimize the mean weighted tardiness of all jobs. First, we model the DDFJSP as a Markov decision process (MDP) with a continuous state space and a discrete action space. Subsequently, 12 representative state features of the dynamic distributed flexible job shop are elaborately extracted from operations, jobs, machines, and factories. Then, seven problem-oriented composite rules are built as actions of the DRL for intelligently ranking uncompleted jobs by specific indicators and distributing the selected job to a proper machine for processing. Meanwhile, an effective reward function serving the target is employed to enable the DRL to converge rapidly. Moreover, the value-based algorithm, namely dueling double deep Q-network (D3QN), is utilized to tackle the proposed model. Finally, numerical comparison experiments are implemented for comparing the performance of our D3QN-based scheduling method with that of each composite rule, each classic priority dispatching rule (PDR), other DRL-based methods, and metaheuristics under 81 production configurations of the DDFJSP. The results have credibly verified and confirmed the generalization and effectiveness of our D3QN-based method for the proposed DDFJSP.}
}
@article{CHEN2026114635,
title = {PMNet: A progressive MLP-based framework for time series forecasting with long-short term dependency synergy},
journal = {Applied Soft Computing},
volume = {190},
pages = {114635},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114635},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000839},
author = {Shijun Chen and Hua Wang and Fan Zhang},
keywords = {Time series forecasting, Progressive MLP framework, Long-short dependency synergy, The mixture of experts system},
abstract = {Time series forecasting has wide-ranging applications across various domains. In recent years, MLP-based forecasting models have attracted increasing attention. However, their ability to capture complex temporal patterns remains limited. To address this, we propose PMNet—a progressive sequence modeling framework based on MLPs—from the perspective of collaborative modeling of short-term and long-term dependencies. In time series, short-term dependencies carry crucial fluctuation signals and instantaneous variations, while long-term dependencies reflect broader trend evolutions. The organic integration of both plays a vital role in improving predictive accuracy. To this end, we introduce the Multi-source Progressive Coupling Block (MPC), which progressively enhances the model’s ability to capture short-term dependencies and local dynamics through block-wise multi-source feature fusion and information propagation. Meanwhile, we employ the Adaptive Structural Perception Block (ASP) to introduce a dual-domain guidance mechanism equipped with stochastic selectivity and differentiation, enabling structural enhancement of global temporal patterns. Working in synergy, these two modules unify fine-grained short-term modeling with long-range global structure representation, significantly improving the model’s capacity for deep temporal pattern understanding. Extensive experiments validate the effectiveness of the proposed approach.}
}
@article{YI2026114630,
title = {Persistent homology spatial pyramid bag-of-words for topological feature learning},
journal = {Applied Soft Computing},
volume = {190},
pages = {114630},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114630},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000785},
author = {Lisha Yi and Ningning Peng},
keywords = {Persistent homology, Bag of words, Spatial pyramid matching, Machine learning},
abstract = {This paper proposes a novel algorithm called Persistent Homology Spatial Pyramid Bag-of-Words (PH-SPBoW), which effectively integrates persistent homology, spatial pyramid partitioning, and the bag-of-words model. This method resolves the incompatibility of variable-sized PDs with standard machine learning models by converting persistence diagrams into fixed-length vectors. The PH-SPBoW algorithm first extracts one-dimensional topological information from the data using Vietoris-Rips (VR) complexes to generate persistence diagrams. Subsequently, it employs spatial pyramid decomposition to partition the PDs for detailed feature extraction and utilizes the bag-of-words model for vector conversion. Addressing the shortcomings of the PH-SPBoW algorithm, this paper introduces three improved algorithms: PH-SPwBoW, PH-SPsBoW and PH-SPVLAD. We theoretically analyze the stability of PH-SPBoW and its three improved algorithms under the 1-Wasserstein distance metric defined in PD space. Experimental evaluations on eight datasets combined with support vector machines demonstrate that the proposed methods significantly outperform traditional kernel methods and vector algorithms in terms of effectiveness and efficiency.}
}
@article{LIU2026114614,
title = {A hierarchical adaptive navigation planner for UAVs in 3D complex environments based on deep reinforcement learning},
journal = {Applied Soft Computing},
volume = {190},
pages = {114614},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114614},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000621},
author = {Shuyuan Liu and Yu Zhang and Guanxiong Li and Hao Chen and Xiaogang Deng},
keywords = {Deep reinforcement learning, Unmanned aerial vehicle, Autonomous navigation, Hierarchical adaptive planner},
abstract = {Deep reinforcement learning (DRL) offers significant advantages for the autonomous navigation of unmanned aerial vehicles (UAVs), including being map-free, robust in uncertain environments, and having low requirements for sensor accuracy. Current DRL navigation methods primarily fall into two categories: reactive methods similar to local path planning, which lack long-term vision and suffer from local optima and path oscillation; and planning methods, which face challenges due to high-dimensional action spaces and unreliable path tracking. Based on the above problems, we propose a novel DRL-based Hierarchical Adaptive Navigation Planner (HAP), which enables the UAV to have both long-term vision and adaptive replanning capabilities. Specifically, our method involves two modules, namely Planner and Replanning Trigger. The former uses 3D Bézier control points to reduce the complexity of the path planning action space, while the latter adaptively triggers Planner for replanning. Furthermore, we design targeted dense reward functions for each module to ensure convergence, and use the latest Distributional Soft Actor-Critic (DSAC) algorithm to improve the Planner’s performance ceiling. In the experimental part, we design challenging simulation environments of different complexities for UAV autonomous navigation tasks to verify the effectiveness of HAP and its advantages over other methods. Experimental results in various scenarios show that under the same input, the comprehensive performance of HAP is better than other DRL-based reactive navigation methods, and it can achieve an adaptive balance between real-time obstacle avoidance and long-term planning.}
}
@article{HAN2026114654,
title = {MSMT-Net: Multi-scale multi-task network for capsular edge recognition and instrument segmentation of cataract surgery},
journal = {Applied Soft Computing},
volume = {190},
pages = {114654},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114654},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600102X},
author = {Shaofeng Han and Mingfeng Lu and Yurun Liu and Yajing Pei and Ke Ma},
keywords = {Continuous curvilinear capsulorhexis, MSMT-Net, Capsular edge detection, Instrument segmentation, Capsulorhexis trajectory},
abstract = {The continuous curvilinear capsulorhexis (CCC) is one of the most critical steps in cataract surgery, as its quality critically determines intraocular lens implantation success and final visual acuity. However, automatic recognition of the capsular edge poses three challenges: high capsule transparency, intraoperative eyeball motion, and visual artifacts. To address these, we propose MSMT-Net, a Multi-Scale, Multi-Task Network for simultaneous capsular edge detection and surgical instrument segmentation. The core architecture is a dual-branch encoder (CNN and Transformer) that jointly captures local textures for transparent edge resolution and global dependencies for motion robustness. A Hybrid Feature Fusion Block (HFFB) ensures robust cross-branch complementarity. To further refine the multi-task performance, the architecture employs several multi-scale contextual modules: the multi-layer context fusion block (MCFB), multi-receptive field fusion block (MRFB), and channel transformer block (CTB) handle segmentation, while the layer transformer block (LTB) is dedicated to ensuring high-continuity edge detection. Crucially, a novel compensation block is integrated for precise eye center estimation and robust reconstruction of the capsulorhexis trajectory, enabling quantitative quality assessment and robot guidance. Experiments on the self-established CapsDet dataset show that MSMT-Net outperforms state-of-the-art methods, particularly in transparent edge detection, achieving 78.24 % mean IoU and 86.40 % mean Dice for capsular edge and pupil recognition, and 92.83 % IoU and 94.09 % Dice for instrument segmentation. These results demonstrate the network’s robustness across tasks and its potential as a reliable foundation for quantitative evaluation of capsulorhexis quality and robot-assisted surgical guidance. The code is available at https://github.com/hanshaofeng8/MSMT-Net.}
}
@article{ZHOU2026114565,
title = {Oversampling classification method based on neighborhood analysis on imbalanced data},
journal = {Applied Soft Computing},
volume = {190},
pages = {114565},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114565},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600013X},
author = {Hongfang Zhou and Jiajia Du and Xinhao Zheng},
keywords = {Imbalanced data classification, Denoising, Neighborhood analysis, Oversampling},
abstract = {Most traditional methods for imbalanced data classification tend to overlook the impact of noise interference, leading to unsatisfactory classification performance. To address this limitation, we propose ADKEN (Adaptive Density and local complexity-based K-Nearest neighbor), an oversampling algorithm specifically designed for imbalanced datasets. The proposed method comprises two key components. First, an adaptive denoising mechanism is employed to reduce the influence of noisy instances. Second, a weighted oversampling strategy is applied to generate more representative minority-class samples. To validate its effectiveness, extensive experiments were conducted on 20 benchmark datasets using three classifiers (SVM, RF, and C4.5). ADKEN achieved the best results in 75.0 %–90.0 % of the cases, with statistically significant average improvements in Accuracy (+7.2 %), AUC (+8.5 %), and F1-score (+10.3 %). These results confirm ADKEN’s robustness in handling class imbalance and noisy data while ensuring superior discriminative performance.}
}
@article{WANG2026114586,
title = {An enhanced privacy-preserving federated few-shot learning framework for respiratory disease diagnosis},
journal = {Applied Soft Computing},
volume = {190},
pages = {114586},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114586},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000347},
author = {Ming Wang and Zhaoyang Duan and Dong Xue and Fangzhou Liu and Zhongheng Zhang},
keywords = {Federated learning, Few-shot learning, Differential privacy, Respiratory disease diagnosis},
abstract = {The labor-intensive nature of medical data annotation presents a significant challenge for respiratory disease diagnosis, resulting in a scarcity of high-quality labeled datasets in resource-constrained settings. Moreover, patient privacy concerns complicate the direct sharing of local medical data across institutions, and existing centralized data-driven approaches, which rely on the amount of available data, often compromise data privacy. This study proposes a federated few-shot learning framework with privacy-preserving mechanisms to address the issues of limited labeled data and privacy protection in diagnosing respiratory diseases. In particular, a meta-stochastic gradient descent algorithm is proposed to mitigate the overfitting problem that arises from insufficient data when employing traditional gradient descent methods for neural network training. Furthermore, to ensure data privacy against gradient leakage, differential privacy noise from a standard Gaussian distribution is integrated into the gradients during the training of private models with local data, thereby preventing the reconstruction of medical images. Given the impracticality of centralizing respiratory disease data dispersed across various medical institutions, a weighted average algorithm, called the Federated Averaging Algorithm (FedAvg), is employed to aggregate local diagnostic models from different clients, enhancing the adaptability of a model across diverse scenarios. Experimental results show that the proposed method yields compelling results with the implementation of differential privacy, while effectively diagnosing respiratory diseases using data from different structures, categories, and distributions.}
}
@article{GE2026114594,
title = {Lightweight radiation feature extraction with enhanced spatial dependencies: A model for cross-seasonal solar irradiance forecasting},
journal = {Applied Soft Computing},
volume = {190},
pages = {114594},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114594},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000426},
author = {Xingtong Ge and Yi Yang and Zhaobo Li and Ling Peng and Jiahui Chen},
keywords = {Solar irradiance forecasting, Improved complete ensemble empirical mode decomposition with adaptive noise, Enhanced spatial dependence, Logistic adaptive grey wolf optimization},
abstract = {Accurate solar irradiance forecasting is crucial for ensuring the reliable operation of power systems with high photovoltaic integration. However, existing methods face three key challenges in cross-seasonal forecasting. First, they struggle with the seasonal dynamic evolution of spatial dependencies. Second, they cannot efficiently extract multi-scale temporal features. Third, they lack collaborative optimization of temporal-spatial feature extraction mechanisms. To address these challenges, this paper proposes the GELG model, which integrates three innovations: a dynamic spatial dependency modeling mechanism, a Lightweight Radiation Feature Extraction Unit (LRFEU), and a Logistic Adaptive Grey Wolf Optimization (LAGWO) algorithm. Experiments on four seasonal datasets from Taian City, Shandong Province, China demonstrate that the GELG model significantly outperforms baseline methods. The model achieves MAE values of 13.059, 16.438, 5.929, and 8.460 W/m2 for spring, summer, autumn, and winter respectively, with R2 exceeding 0.98 in all seasons, demonstrating excellent seasonal adaptability.}
}
@article{YUAN2026114618,
title = {Reliable reasoning: Learning and inference based on the ability of large language models},
journal = {Applied Soft Computing},
volume = {190},
pages = {114618},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114618},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000669},
author = {Changsen Yuan and Rui Lin and Cunhan Guo},
keywords = {Large language models, Knowledge graphs, Reliable reasoning, Reasoning path},
abstract = {Large language models (LLMs) demonstrate strong reasoning abilities in complex tasks, but they are limited by their inability to access up-to-date information and are prone to generating plausible, known as hallucinations. Knowledge graphs (KGs), which are structured and dynamically updated collections of facts, offer a solution by providing LLMs with verified, current information. This enhances the models’ reasoning accuracy and reduces the risk of hallucinations. However, existing methods focus more on the inferability and structure of KGs, while overlooking the varying levels of difficulty that LLMs encounter when learning and understanding different reasoning paths between two nodes in the KGs. In this paper, we propose a novel method called Reliable Reasoning (R2) that selects appropriate inference paths from KGs for LLMs to learn and understand more easily. Specifically, we present a reliable reasoning path search framework in which R2 first extracts appropriate candidate reasoning paths based on KGs. The candidate reasoning paths are then filtered, selecting the ones preferred by the LLM for further learning. Comprehensive experiments conducted on two benchmark KGQA datasets indicate that R2 attains good performance in KGQA tasks, producing accurate and interpretable reasoning outcomes.}
}
@article{GHOSH2026114602,
title = {Semantic-augmented vision transformer with cross-modal fusion for waste classification},
journal = {Applied Soft Computing},
volume = {190},
pages = {114602},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114602},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000505},
author = {Debojyoti Ghosh and Adrijit Goswami},
keywords = {Vision transformer, Semantic attribute embedding, Multi-modal fusion, Waste classification, Cross-modal transformer, Deep learning},
abstract = {Efficient waste classification stands as a cornerstone of modern sustainable waste management and environmental conservation efforts. In this study, we introduce a robust deep learning framework that seamlessly integrates a Vision Transformer backbone with Semantic Attribute Embeddings to deliver highly accurate predictions. Unlike traditional models that rely solely on visual cues, our approach leverages rich semantic attributes such as hazard levels, recycling categories, and material properties to create a comprehensive representation of each waste item. This dual-stream strategy captures intricate relationships between visual patterns and contextual knowledge, thereby enhancing the model’s discriminative power. The architecture employs a cross modal transformer module that intelligently fuses image features and semantic embeddings, enabling the system to learn nuanced distinctions among diverse waste classes. Extensive experiments conducted on a challenging dataset of ten garbage categories demonstrate the effectiveness of our method. The proposed model attains a test accuracy of 98.27%, significantly exceeding current baselines and establishing a new benchmark for automated garbage categorization. These findings underscore the significant potential of integrating powerful vision transformers with supplementary semantic information to enhance sustainable and intelligent garbage sorting systems. This research facilitates practical applications in intelligent recycling and environmental monitoring systems.}
}
@article{ZHOU2026114626,
title = {Local-to-global multi-modal domain adversarial learning framework for multi-source domain mechanical fault diagnosis},
journal = {Applied Soft Computing},
volume = {190},
pages = {114626},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114626},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000748},
author = {Yuan Zhou and Xiaofeng Yue},
keywords = {Multi-source domain fault diagnosis, Domain adversarial learning, Multi-modal learning, Time-frequency features, Cross-domain knowledge transfer},
abstract = {Integrating rich information from diverse source domains significantly enhances cross-domain knowledge transfer capabilities in mechanical fault diagnosis, which is critical for addressing fault diagnosis demands under complex and varying operating conditions. However, existing methods typically perform domain alignment at the global feature level while neglecting the local domain shift accumulation effects in time-frequency features, resulting in inadequate suppression of multi-level domain discrepancies. To address the aforementioned issues, a local-to-global multi-modal domain adversarial learning framework for multi-source domain mechanical fault diagnosis is proposed in this paper. First, a multi-scale time-frequency feature learning network is designed to achieve effective learning from multi-modal local features to unified global representations through parallel heterogeneous feature encoding and adaptive feature aggregation. To fundamentally eliminate multi-level domain bias, a hierarchical local-to-global domain adversarial learning strategy is further proposed. Through constructing a multi-level progressive domain discrimination system to achieve cross-domain collaborative adversarial training. On this basis, a globally-guided local neighborhood consistency learning mechanism is constructed, which generates high-quality pseudo-labels through joint adaptive cross-domain semantic association modeling and multi-level entropy-weighted confidence evaluation, effectively achieving cross-domain knowledge transfer. Extensive experiments on three datasets demonstrate that the proposed method achieves an average diagnostic accuracy of 93.46 %, outperforming the best baseline by 5.34 % across all 10 cross-domain transfer scenarios.}
}
@article{XU2026114566,
title = {Fusion of feature selection, feature extraction, and deep learning for displacement prediction of arch dams with cracks},
journal = {Applied Soft Computing},
volume = {190},
pages = {114566},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114566},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000141},
author = {Bo Xu and Hu Zhang and Huaizhi Su and Zeyuan Chen},
keywords = {Structural health monitoring, Arch dam with cracks, Dam displacement prediction, Feature engineering, Deep learning},
abstract = {Existing methods for predicting displacement of arch dams often overlook the influence of cracks on dam displacement, neglecting the particularity of displacement monitoring for arch dams with cracks. Based on this, this paper proposes a novel method for predicting the displacement of arch dams with cracks that integrates feature engineering and deep learning, with the aim of enhancing the accuracy and reliability of dam displacement prediction. Initially, a combination of maximum information coefficient (MIC) and elastic net (ElaNet) is employed for feature selection of factors such as cracks, hydrostatic pressure, temperature, and aging to eliminate irrelevant variables. Subsequently, kernel principal component analysis (KPCA) is utilized for feature extraction to achieve dimensionality reduction of crack factors and eliminate multicollinearity. Furthermore, a new feature synthesis evaluation (FSE) method is proposed, combining the coefficient of variation (CV) and distance correlation coefficient (DCC), to quantitatively assess the impact of crack, hydrostatic pressure, temperature, and aging factors on displacement. Then, a prediction model for displacement of crack-bearing arch dams based on deep stacked residual networks (DSRN) is established by stacking residual blocks and densifying shortcut connections between residual blocks. Finally, the proposed method is validated using a specific crack-bearing arch dam. The results indicate that cracks are a significant factor affecting displacement variation of crack-bearing arch dams. The proposed method and model effectively handle complex relationships in data modeling and prediction, yielding satisfactory prediction accuracy. This study provides new technical means and solution ideas for safety monitoring and operation management of crack-bearing arch dams, possessing high reference value in the research of safety monitoring of crack-bearing hydraulic structures.}
}
@article{ALMAHMUD2026114590,
title = {Optimizing cut order planning in apparel manufacturing: A particle swarm optimization and genetic algorithm approach},
journal = {Applied Soft Computing},
volume = {190},
pages = {114590},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114590},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000384},
author = {Sharif Al-Mahmud and Radwan Ahmed Rahat and Emiro Antonio Campo and Jose Alejandro Cano and Stephan Weyers},
keywords = {Cut order planning, Fabric spreading, Cutting problem, Particle swarm optimization, Genetic algorithm, Garment manufacturing},
abstract = {This study introduces novel solution approaches for the cut order planning (COP) problem in garment manufacturing by integrating a cost-minimizing mathematical model with tailored metaheuristic algorithms. A mathematical formulation is developed that considers fabric, marking, cutting, shortage, and overproduction costs. Two algorithms, genetic algorithms (GA) and particle swarm optimization (PSO), are adapted with custom initialization and parameter tuning strategies. Their performance is evaluated on 32 real-world COP cases from the Bangladeshi apparel industry and benchmarked against existing methods and industrial practices. PSO achieved average cost savings of 1.25% and GA 0.94%, with PSO reducing computation time by up to 98.6%. These results validate the proposed methods as scalable and efficient alternatives for COP and establish a benchmark using real manufacturing data.}
}
@article{ALZAMAN2026114515,
title = {Product selection in drop-shipping: Reinforcement learning stacked on multiple machine learning algorithms},
journal = {Applied Soft Computing},
volume = {190},
pages = {114515},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114515},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018289},
author = {Chaher Alzaman},
keywords = {Drop-shipping, Machine, Commerce, Reinforcement learning},
abstract = {Drop-shipping, a prevalent e-commerce model, poses the critical challenge of selecting the right products to offer in e-marketplaces, as this decision greatly influences business success. This study aims to equip drop-shippers with an interactive predictive model to aid in product selection from a vast pool of options. The work presents an approach that integrates genetic search with ranking tree-based and deep learning-based algorithms, incorporating unique feature engineering criteria to enhance the model's effectiveness. Using a moving window within a 180-day duration, the model predicts product performance, providing important insights. Through a thorough comparison of three distinct machine learning algorithms, the paper highlights their respective strengths and weaknesses. Additionally, the work introduces a novel reinforcement learning technique to boost algorithm performance. Unlike traditional ensemble methods, this approach selects the best-performing algorithm for specific product selection scenarios, achieving a notable 15 % improvement over the top-performing individual technique. This research provides a practical and valuable framework for addressing the unique challenges of product selection in drop-shipping and e-marketplaces. By leveraging these innovative techniques, businesses can make data-driven decisions to optimize their product offerings, ultimately increasing their chances of success in the competitive e-commerce landscape.}
}
@article{ZHAO2026114574,
title = {CDA-MVSNet: Enhancing asteroid 3D reconstruction with channel attention and dynamic aggregation},
journal = {Applied Soft Computing},
volume = {190},
pages = {114574},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114574},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000220},
author = {Chenhao Zhao and Qingjie Zhao and Xingchen Lv and Lei Wang and Wangwang Liu},
keywords = {Data visualisation, 3D reconstruction visualisation, Computer vision 3D modeling, Multi-view 3D reconstruction, Channel attention mechanism, Adaptive loss function, Cascade dynamic cost aggregation},
abstract = {Due to the lack of prior knowledge and clear surface textures, it is difficult to accurately reconstruct the three-dimensional model of an asteroid, and there are few scholars engaged in research in this area. In this paper, we propose an Enhancing Asteroid 3D Reconstruction Framework with Channel Attention and Dynamic Aggregation (CDA-MVSNet) to reconstruct the three-dimensional model of an asteroid with monotonic or indistinct textures. This framework enhances feature expressiveness via the channel attention Adaptive Selective Channel Focus (ASCF) module and employs a Depth-Aware Adaptive Loss Function (DALOSS) that dynamically adjusts during iterations to guide the depth estimation finely. The cost aggregation Dynamic Weighting Synthesis Network module (DWSN) we propose further refines the cost aggregation progressively, substantially improving reconstruction precision and robustness. Visualization evaluation conducted on Sample Consensus Initial Alignment Iterative Closest Point (SAC-IA-ICP), Chamfer Distance metrics, and the DTU dataset visually substantiated the superiority of our approach. CDA-MVSNet achieves significant advancements in asteroid 3D reconstruction accuracy and computational efficiency compared to existing methods. Our framework achieves new SOTA performance on reconstruction completeness, a critical metric for our target application. Our method demonstrates strong overall performance on asteroid datasets, validating its effectiveness for this challenging domain.}
}
@article{BAI2026114598,
title = {Temporal knowledge graph reasoning based on time layering and fuzzy logic rules},
journal = {Applied Soft Computing},
volume = {190},
pages = {114598},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114598},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000463},
author = {Luyi Bai and Qianwen Xiao and Tongji Liu and Kejie Guo},
keywords = {Fuzzy representation, Logic rules, Reasoning, Temporal knowledge graphs},
abstract = {Temporal knowledge graph (TKG) reasoning aims to address the incompleteness of temporal knowledge graphs by inferring unknown facts from known ones. However, existing methods either overlook fuzzy semantics or apply rigid temporal constraints—creating a critical gap in handling real-world ambiguity and event causality. This paper proposes a time hierarchy and fuzzy logic rule-based multi-hop path reasoning model TiFuLa to tackle these challenges, a multi-hop path reasoning model that computes fuzzy membership of relations via frequency, duration, recency, and stability, categorizes relations into strong/weak temporal correlation using Relation-Time Correlation (RTC) and learns rule axioms aligned with each category. Finally, by applying these rules, the quadruples are inferred from the selected case rules and ranked by integrating scores from fuzzy membership and temporal differences. Experimental results on four benchmark datasets show this method enhances the logic rule-based multi-hop path reasoning in temporal knowledge graphs through the calculation of fuzzy membership degrees for relational predicates and time hierarchical processing. On the ICEWS18 dataset, TiFuLa’s performance improved by an average of nearly 17 percentage points. On the ICEWS0515 dataset, the improvement of TiFuLa is more significant, with an average increase of 24 percentage points in MRR and Hits @ (1/3/10) indicators.}
}
@article{ROCHA2026114606,
title = {Wildfire spots analysis and forecasting: Evaluation of univariate and multivariate based on variational mode decomposition models},
journal = {Applied Soft Computing},
volume = {190},
pages = {114606},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114606},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000542},
author = {Vinicius Lovatel Rocha and Ramon Gomes {da Silva} and Gilson Adamczuk Oliveira and Matheus Henrique Dal Molin Ribeiro},
keywords = {Time series forecasting, Signal decomposition, Fire outbreak prediction, Forest fires},
abstract = {Every year, forest fires affect large areas of Santa Catarina State in Brazil, causing significant environmental, economic, and property damage. This study aims to predict fire outbreaks in Lages and Xanxerê, municipalities with high incidence rates, using data from the Santa Catarina Military Fire Department (CBMSC). The goal is to support more efficient resource management and personnel allocation during high-risk periods. The time series comprises 70 monthly observations, covering February 2019 to December 2024. The methodology combines univariate and multivariate models with Variational Mode Decomposition (VMD) to generate short-term forecasts for one-, two-, and three-month horizons, applying a rolling-window cross-validation protocol. The data were tested in their original form and with logarithmic and square root transformations to enhance predictive performance. Evaluation measures included RMSE, MAE, sMAPE, and error standard deviation. In Lages, the best result was achieved using square-root transformed data and the VMD–LASSO model (RMSE = 1.2074; sMAPE = 58.90). In Xanxerê, the best performance was achieved by applying the same model to the original data (RMSE = 1.5248; sMAPE = 67.79). These findings provide a decision–support tool for CBMSC, enabling more accurate planning and resource mobilization during critical periods and strengthening wildfire prevention and response strategies.}
}
@article{CHENG2026114433,
title = {An integrated interval BWM-Markov group decision-making method for third-party reverse logistics providers},
journal = {Applied Soft Computing},
volume = {190},
pages = {114433},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114433},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017466},
author = {Xianjuan Cheng and Yuhui Cao and Dan Zhou and Changxiong Chen and Zehui Chen},
keywords = {Group decision-making method, Consistency analyses, Interval best-worst method (BWM), Reverse logistics (RL)},
abstract = {This paper introduces a novel group best-worst decision-making method that combines interval preference information with Markov model. Firstly, a novel consistency definition for the interval best–worst method (BWM) is introduced and an input-oriented consistency ratio (CR) is proposed in this paper. To improve the input-based CR of interval BWM preference information, an iterative algorithm is built to improve the consistency degree of the original interval preference values. Then, an acceptable consistent interval BWM preference information is defined from the perspective of input-output information. Subsequently, this paper presents a novel approach for obtaining an optimal normalized interval weight vector (NIWV) and develops an interval BWM-based individual decision-making model. By defining a new cosine similarity degree between two interval vectors, a linear system of equations is formulated to compute the weights of experts by Markov model. As a result, an integrated interval BWM-Markov group decision making (GDM) method is put forward. Lastly, a real-life case of third-party reverse logistics providers (3PRLPs) and some comparisons is used to exemplify the applicability and effectiveness of the presented integrated interval BWM-Markov GDM method.}
}
@article{LIN2026114546,
title = {Memetic covariance matrix adaptation evolution strategy for bilinear matrix inequality problems in control system design},
journal = {Applied Soft Computing},
volume = {190},
pages = {114546},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114546},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018599},
author = {Syue-Cian Lin and Wei-Yu Chiu and Chien-Feng Wu},
keywords = {Memetic covariance matrix adaptation evolution strategy (memetic CMA-ES), Output feedback control, Bilinear matrix inequality (BMI),  optimization, Spectral abscissa optimization},
abstract = {Bilinear matrix inequalities (BMIs) are fundamental to control system design but are notoriously difficult to solve due to their nonconvexity. This study addresses BMI-based control optimization problems by adapting and integrating advanced evolutionary strategies. Specifically, a memetic covariance matrix adaptation evolution strategy (memetic CMA-ES) is proposed, which incorporates a local refinement phase via a (1+1)-CMA-ES within the global search process. While these algorithmic components are established in evolutionary computing, their tailored integration and specific tuning for control design tasks represent a novel application in this context. Experimental evaluations on H∞ controller synthesis and spectral abscissa optimization demonstrate that the proposed method achieves superior performance compared to existing BMI solvers in terms of both solution quality and robustness. This work bridges the gap between evolutionary computation and control theory, providing a practical and effective approach to tackling challenging BMI-constrained problems.}
}
@article{XU2026114541,
title = {A triple rewards framework for multi-agent reinforcement learning},
journal = {Applied Soft Computing},
volume = {190},
pages = {114541},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114541},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501854X},
author = {Jiayi Xu and Fei Yuan and Wei Weng and Junjiang Zhong and Yanan Li and Libing Chen and Baihua Chen},
keywords = {Multi-agent reinforcement learning, Grouping algorithm, StarCraft multi-agent challenge},
abstract = {Grouping is a popular method for improving collaboration efficiency in multi-agent reinforcement learning (MARL). However, existing grouping algorithms typically face two critical issues: First, agents within a group tend to adopt similar policies, making it difficult to learn individual optimal actions and complex collaborative policies. Second, in sparse reward environments with low win rates, “lazy” agents inevitably emerge by learning escape strategies, severely degrading teamwork efficiency and even leading to task failure. To address these problems, this paper proposes a novel triple rewards framework, which integrates three complementary reward mechanisms to balance individual performance, group coordination, and team-level optimization. Specifically, the individual reward maximizes each agent’s causal impact on external states to suppress lazy behaviors; the team reward optimizes the collective influence of joint actions; the group reward applies dynamic grouping module to generate adaptive collaboration structures without prior domain knowledge. These three rewards are weighted and fused to form the final reward function, guiding agents to learn both individual expertise and efficient teamwork. Compared with representative algorithms on the benchmark StarCraft multi-agent challenge, the proposed method achieves a maximum win rate improvement of 20 % and a convergence speed increase of more than 15 % on super-hard maps such as 6h_vs_8z and Corridor, which fully verifies the effectiveness of this method. This work provides a new paradigm for solving the individual-group coordination conflict in MARL grouping algorithms.}
}
@article{CHEN2026114613,
title = {W-StrataFormer: A temporal action localization model based on wavelet transform and strata feature enhancement},
journal = {Applied Soft Computing},
volume = {190},
pages = {114613},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114613},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600061X},
author = {Yuang Chen and Yong Li and Xiaolong Cui and Fang Lin and Shuhan Lv},
keywords = {Temporal action localization, Wavelet transform, Temporal shift module, Multi-scale feature extraction},
abstract = {This paper proposes a lightweight model named W-StrataFormer, which aims to solve the problem of single-stage anchor-free temporal action localization. By integrating a discrete wavelet transform module, an improved Dual Cascade Temporal Shift-Feature Fusion Module, and Strata feature enhancement operations, W-StrataFormer significantly enhances the model’s ability to learn the relationships between temporal sequence features in videos. On one hand, the model employs frequency-domain processing techniques to remove high-frequency noise and enhance low-frequency features, thereby improving the temporal boundary clarity of the input features, which is beneficial for action interval localization. On the other hand, the combination of the Dual Cascade Temporal Shift-Feature Fusion Module and Strata feature enhancement operations not only replaces the traditional Feature Pyramid Network, reducing computational complexity, but also further promotes information exchange between channels, greatly improving the overall performance of the model. Experimental results show that W-StrataFormer performs excellently on the THUMOS14 and ActivityNet datasets, especially achieving the highest Average mAP on the ActivityNet dataset when using features extracted by I3D as input. Additionally, this paper analyzes and discusses the accuracy of W-StrataFormer’s action localization capabilities and its existing limitations through the visualization of confidence scores. In summary, W-StrataFormer not only outperforms many existing models in terms of performance but also considers computational efficiency and resource constraints in practical applications, demonstrating broad application prospects.}
}
@article{EDA2026114429,
title = {Artificial intelligence in healthcare: A comprehensive survey on AI-driven diagnosis and patient monitoring},
journal = {Applied Soft Computing},
volume = {190},
pages = {114429},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114429},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017429},
author = {Jerina Eda and Tamador Mohaidat and Samiul Islam Niloy and Zhiqi Niu and Md rahat Kader Khan and Kasem Khalil},
keywords = {Artificial intelligence, Machine learning, Supervised learning, Unsupervised learning, Internet of medical things (IoMT), Feature selection, Medical image analysis, AI-powered patient monitoring, Medical data processing, Internet of things},
abstract = {Artificial Intelligence (AI) is reshaping modern healthcare, driven by interconnected medical devices and scalable computing resources such as cloud-based Tensor Processing Units (TPUs). This survey provides a comprehensive overview of AI applications across major healthcare domains, with a focus on disease diagnosis, patient monitoring, medical image analysis, and clinical decision support. We examine four prevalent conditions(selected as they are leading NCDs per WHO, causing 75% of global deaths, allowing in-depth analysis on high-impact areas with ample data), chronic kidney disease, diabetes mellitus, cardiovascular disease, and cancer, and analyze how supervised and unsupervised learning algorithms have been adapted to heterogeneous medical data, including Electronic Health Records (EHRs), Magnetic Resonance Imaging (MRI) scans, laboratory tests, and IoMT signals. A comparative assessment of methods highlights the strengths of ensemble and deep learning approaches, which consistently outperform traditional techniques, with several models achieving predictive accuracies above 95%. The review also summarizes preprocessing strategies, feature selection methods, and evaluation metrics used to validate performance. Key trends include the adoption of multimodal data fusion and the growing emphasis on explainability for clinical acceptance. Despite these advances, challenges remain in addressing data privacy, algorithmic bias, and seamless integration with clinical workflows. We conclude by identifying open challenges such as data privacy, bias, and workflow integration, and emphasize AI’s potential to advance diagnostic precision, personalized treatment, and real-time patient care. By consolidating findings across diverse medical domains, this study provides both a roadmap for researchers and a benchmark for advancing AI integration into clinical practice.}
}