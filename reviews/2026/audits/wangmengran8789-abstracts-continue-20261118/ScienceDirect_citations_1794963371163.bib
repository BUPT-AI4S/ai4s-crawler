@article{LIU2026114516,
title = {Group maintenance based on deep hierarchical reinforcement learning and multi-stage degradation analysis},
journal = {Applied Soft Computing},
volume = {189},
pages = {114516},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114516},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018290},
author = {Junqiang Liu},
keywords = {Group maintenance, Hierarchical planning, Reinforcement learning, Reliability function, Imperfect maintenance},
abstract = {Current group maintenance methods rarely consider multi-stage degradation characteristics of system. Moreover, it also lacks excellent performance for group maintenance applications. Therefore, this paper proposes a new dynamic maintenance model based on group strategy and deep hierarchical reinforcement learning with actor-critic architecture. Upper level planning gets optimal operation time and lower level planning obtains optimal maintenance cost. Theorems of proposed approach are proved. An improved pretrained algorithm is developed. A new multi-stage maintenance algorithm based on improved deep hierarchical reinforcement learning is studied. Experimental results from three datasets show that: 1) proposed pretrained algorithm has better convergence; 2) when there are 4 maintenance groups, 3 inspection intervals, it has optimal average maintenance cost rate result of multiple stages; moreover, proposed method reduces total maintenance cost by 8.25 %-25 % than traditional methods; 3) reliability dependency, imperfect maintenance, and inspection interval have important effects on maintenance cost; 4) compared with state-of-the-arts algorithms, developed algorithm achieves better tradeoff between performance and runtime.}
}
@article{CHEN2026114488,
title = {Robust visual object tracking via synergistic perceiving state changes and regulated communication},
journal = {Applied Soft Computing},
volume = {189},
pages = {114488},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114488},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018010},
author = {Xirui Chen and Xuedong Wu},
keywords = {Visual object tracking, Transformer tracking, One-stream tracking, Vision transformer},
abstract = {Visual object tracking remains a fundamental yet challenging problem in computer vision due to the need to adapt to target state variations while ensuring effective and low-interference interaction between the template and search region. Existing Transformer-based trackers typically employ either unconstrained bidirectional attention, which propagates noise globally, or unidirectional attention, which obstructs spatiotemporal feedback and leads to template degradation. To address these limitations, a Synergistic Perceiving State Changes and Regulated Communication Tracker (SPRTrack) is proposed. The core design integrates two synergistic mechanisms within a unified encoder architecture to jointly enhance temporal adaptability and regulate information interaction: (1) A Perceiving State Changes Component (PSCC) is introduced to endogenously model and propagate visual cues across frames and layers through dynamic internal variables, enabling the model to perceive target temporal evolution without relying on explicit template updates or historical motion cue; (2) A Regulated Unnecessary Communication Attention Module (RUCAM) is developed to maintain the semantic purity of the template while constructing a template-state-search composite flow that enables controlled bidirectional interaction between the template and the search region, thereby suppressing noise propagation; (3) A theoretical analysis of Transformer-based target tracking is presented, focusing on attention interactions between the template and search region, with upper bounds on perturbation effects and insights into model robustness. Comprehensive experiments demonstrate that SPRTrack achieves competitive performance across multiple benchmarks, attaining 73.2 % AO on GOT-10k without template updates, while maintaining real-time efficiency at 90 FPS on a single NVIDIA RTX 3090 GPU.}
}
@article{HE2026114504,
title = {Intra-group collaborative updating and inter-group mutual learning for federated model fusion across heterogeneous clients},
journal = {Applied Soft Computing},
volume = {189},
pages = {114504},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114504},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018174},
author = {Qianqian He and Cheng Guo and Xinyu Tang and Yingmo Jie},
keywords = {Federated learning, Heterogeneous data, Model fusion, Deep mutual learning (DML), Generative learning algorithms (GLA)},
abstract = {Model personalization is proposed to satisfy the widespread requirement for heterogeneous models caused by intellectual property rights and the heterogeneity among clients in federated learning (FL). However, during the model personalization process, the model is optimized solely on a single client with limited data, which is prone to catastrophic forgetting of the global data distribution, resulting in model bias and overfitting. Hence, in this paper, we propose a general FL framework named FedML tailored specifically for fusing models from heterogeneous clients to cope with the challenge. By introducing model fusion and inter-group distillation techniques, this framework significantly enhances the personalization capabilities and training efficiency for heterogeneous clients. Specifically, clients naturally form multiple groups and perform intra-group collaborative updating to achieve personalization beyond a single client. Additionally, we implement inter-group mutual distillation by synthesizing pseudo-samples with generative learning algorithms (GLA) and exchanging softened predictions via deep mutual learning (DML), all without requiring any additional datasets. Finally, we evaluated the framework FedML on the CIFAR10, CIFAR100, and SVHN datasets and considered six different model architectures. These experiments show that the test accuracy of models from heterogeneous clients outperforms all compared state-of-the-art baselines, achieving test accuracy improvements of up to 7.10 % over the highest-performing baseline, while requiring only approximately 0.17 times the runtime of the best baseline.}
}
@article{HOU2026114496,
title = {Navigating the unseen: System-enhanced real-time perception and decision-making for negative obstacle avoidance in autonomous vehicles},
journal = {Applied Soft Computing},
volume = {189},
pages = {114496},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114496},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018095},
author = {Junxu Hou and Hong Wang and Tan Li and Eryi Dong and Tao Wang and Fengkai Kang},
keywords = {Negative obstacle, Visual perception, Autonomous vehicle control, Vehicle engineering, Obstacle avoidance strategy},
abstract = {Negative obstacles, such as road potholes and sunken areas, are depressions in the road plane that pose hidden dangers to autonomous vehicles. Their concealment and unpredictability make reliable detection and avoidance especially challenging, thus requiring advanced perception and control strategies. In this study, we propose an integrated approach for real-time negative obstacle detection and avoidance, combining an improved YOLOv8-based visual perception module with a novel avoidance strategy grounded in relative motion and a “Step-Unity” concept. The perception module achieves efficient and accurate obstacle identification by leveraging a partial convolution (PConv) enhanced YOLO architecture, while the decision module optimizes intervention timing and reduces control delays through algorithmic improvements. This integrated perception–decision framework effectively balances speed and accuracy, reducing computational latency and enhancing vehicle stability. Experimental results demonstrate that the proposed method achieves high detection accuracy (AP50 91.38 %) and real-time performance (22.3 FPS), satisfying autonomous navigation requirements. Compared with representative state-of-the-art approaches, it improves AP50 by up to 3.2 % while maintaining competitive speed. Furthermore, in dynamic avoidance tests, the system reduces average travel time by 9.11 % and travel distance by 6.83 % relative to a baseline, with cumulative vehicle sway angles in travel and vertical directions reduced by over 50 %. These improvements significantly enhance vehicle stability and ride comfort in negative obstacle scenarios. The proposed solution provides a practical advancement for autonomous driving in complex environments and can be extended with multi-sensor fusion, offering potential for even greater reliability under adverse conditions.}
}
@article{HU2026114544,
title = {Cognitive-inspired knowledge graph fusion for gradient-aligned multimodal sentiment analysis},
journal = {Applied Soft Computing},
volume = {189},
pages = {114544},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114544},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018575},
author = {Yuxuan Hu and Minghui Zhu and Zuhe Li and Chaolong Zhang and Sichao Song and Yuanping Xu and Zhijie Xu and Yushan Pan},
keywords = {Affective knowledge graph, Cognitive fusion, Gradient alignment, Sequence compression, Multimodal representation learning},
abstract = {The rapid growth of multimodal data, primarily textual, acoustic, and visual signals, has amplified the demand for accurate and robust Multimodal Sentiment Analysis (MSA), which surpasses traditional single-modality approaches by capturing complementary emotional cues unavailable in isolated streams. However, existing methods face three persistent challenges: (i) modality heterogeneity, where variable-length and structurally diverse inputs hinder balanced fusion; (ii) gradient conflicts during joint optimization, which disrupt stable multimodal learning; and (iii) limited use of structured affective knowledge, leading to underutilization of domain priors. To address these issues, we propose KGCF-GA, a unified framework integrating knowledge-enhanced representation learning, cognitive fusion, and gradient-aligned optimization. Specifically, an Affective Knowledge-enhanced Cognition (AKC) module combines SenticNet and ConceptNet with task - specific affective relations to inject structured emotional priors. A Modular Sequence-Compression (MSC) scheme normalizes heterogeneous sequences into fixed-length representations, ensuring modality alignment. A Cognitive Fusion (CF) layer, based on lightweight self-attention with positional encoding, dynamically recalibrates modality weights. Finally, the Gradient-Alignment Weighting (GAW) module computes cosine similarity between modality-specific and global gradients, adaptively adjusting loss weights to mitigate optimization conflicts. Experiments on MOSI, MOSEI, and CH-SIMS demonstrate that KGCF-GA consistently outperforms existing approaches. For instance, it achieves Acc-2 of 88.48% and F1 of 88.91% on MOSI, Acc-2 of 87.95% on MOSEI, and Acc-5 of 51.37% on CH-SIMS. Notably, on MOSI, KGCF-GA improves Acc-5 by 4.4 points and F1 by 2.01 points over the best existing methods, highlighting the substantial advantage brought by our design. These results verify the effectiveness and robustness of the proposed framework across both coarse- and fine-grained sentiment tasks.}
}
@article{FANG2026114475,
title = {Spatiotemporal charging demand forecasting for EV stations via cross-attention fusion},
journal = {Applied Soft Computing},
volume = {189},
pages = {114475},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114475},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017880},
author = {Weidong Fang and Xibin Lin and Ji Zhang and Jiacheng Hu and Linrun Huang and Guangqian Yuan},
keywords = {Charging demand forecasting, Economics-informed neural networks, Spatiotemporal feature fusion, Cross-attention mechanism},
abstract = {With the rapid growth of electric vehicles (EVs), accurately predicting charging demand has become crucial for intelligent transportation and energy management. Existing deep learning methods usually neglect the integration of economic principles with complex spatiotemporal dependencies. To this end, this paper proposes a novel framework, the Bi-CAPNet model, which integrates a bidirectional temporal convolutional network (BiTCN), a bidirectional gated recurrent unit (BiGRU), a crisscross attention mechanism, an economics-informed neural network (EINN), and a sparrow search algorithm (SSA). This architecture captures multi-scale temporal features, models sequential dependencies, integrates spatiotemporal data, and incorporates price–demand elasticity to characterize the response of charging demand to dynamic pricing, thereby improving economic interpretability. Utilizing extensive real-world data collected from Shenzhen, the empirical evaluation confirms that the proposed approach substantially outperforms representative baseline models in terms of both predictive accuracy and economic interpretability, indicating its strong potential for urban EV charging demand forecasting.}
}
@article{LI2026114536,
title = {Topology-aware road crack semantic segmentation via multiscale stripe pyramid and cross-layer directional attention},
journal = {Applied Soft Computing},
volume = {189},
pages = {114536},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114536},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018496},
author = {Gang Li and Yuchen Niu and Xiaokui Guo and Ruixiang Hou and Ling Zhang and Jingkun Cao},
keywords = {Crack segmentation, Direction attention, Feature re-organization, Strip-wise convolution, Multi-scale feature output, Semantic association, Encoder-decoder network},
abstract = {Realizing accurate road disease detection is important for maintaining road quality and ensuring traffic safety. Existing road crack detection algorithms have two major problems: (1) the characterization of small cracks under complex background is not obvious, and it is easy to be confused with noise. (2) The topological integrity of the segmentation results is insufficient and the edge details are blurred. To address these challenges, we present a multi-scale cross-layer attention fusion network. First, the encoder stage uses a multi-scale strip pyramid module to suppress background noise interference and reduce semantic loss of tiny cracks in deep features. Second, the cross-layer directional attention module is used at the jump junction to mitigate the semantic bias between the encoder and decoder, to achieve efficient contextual feature excitation, and to guide the model to focus on the overall topology of the cracks. Finally, in the multiscale feature output phase, the residual features between the learned labels and the multilayer feature map are used to refine the crack boundary. The performance of the proposed method is evaluated on several benchmark datasets. Experimental results show that on the EdmCrack600 dataset, the method attains Intersection over Union and F1 scores of 55.28 % and 65.90 %, respectively, representing improvements of 13.85 % and 7.78 % over U-Net; on the CFD dataset, our method reaches IoU and F1 scores of 73.13 % and 78.45 %, outperforming Crackformer by 8.25 % and 8.64 %, respectively.}
}
@article{MOVAHEDIANMOGHADDAM2026114512,
title = {Symbolic solution of fractional Volterra population models via physics-informed neural networks and distributed particle swarm optimization},
journal = {Applied Soft Computing},
volume = {189},
pages = {114512},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114512},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018253},
author = {Mahdi {Movahedian Moghaddam} and Hassan {Dana Mazraeh} and Kourosh Parand},
keywords = {Fractional Volterra equation, Symbolic regression, Distributed optimization, Particle swarm optimization (PSO), Grammar-guided search, Physics-informed neural networks, Population dynamics},
abstract = {We propose a distributed hybrid framework for discovering closed-form approximate symbolic (analytical) solutions to fractional Volterra population models, combining grammar-guided Particle Swarm Optimization (PSO) with physics-informed neural networks (PINNs). The PSO explores a structured symbolic space to construct candidate expressions, while a PINN architecture is used to optimize the internal coefficients of each candidate by minimizing the residual of the governing fractional equation. By distributing fitness evaluation across MPI processes, the swarm achieves greater structural diversity and improved convergence reliability. Extensive experiments across a range of fractional orders (α∈{0.1,0.5,0.9,1.0}) reveal that physically meaningful and accurate symbolic solutions were obtained exclusively via distributed (multi-process) optimization. In all cases, serial (single-process) runs failed to yield any convergent or interpretable expressions, underscoring the necessity of parallel diversity for successful symbolic discovery in these challenging regimes. The discovered expressions are not only accurate but also structurally expressive and interpretable. These results demonstrate that distributed symbolic regression, coupled with physics-informed learning, provides a robust and generalizable approach to symbolic discovery in fractional dynamical systems.}
}
@article{LIN2026114470,
title = {A hybrid trajectory optimization solution applied to UAVs based on point cloud information and bio-inspired evolutionary algorithm},
journal = {Applied Soft Computing},
volume = {189},
pages = {114470},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114470},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017831},
author = {Jie Lin and Chentong Shi and Jie Jin and Shuai Li and Dechao Chen},
keywords = {Gradient generation, Trajectory optimization, Point cloud information, Bio-inspired evolutionary algorithm, Unmanned aerial vehicles (UAVs)},
abstract = {This paper addresses the challenges of trajectory optimization and flight safety for unmanned aerial vehicles (UAVs) in unknown environments caused by the limited computational power of edge devices and restricted perception range. A trajectory optimization solution based on point cloud information and bio-inspired evolutionary optimization methods is proposed. The approach constructs a mathematical model through time parameterization and constraint modeling, then solves the trajectory using evolutionary optimization to enhance the safety and reliability of autonomous navigation. Furthermore, we develop an autonomous navigation system specifically designed for quadrotor UAVs to handle flight challenges in complex environments. Focusing on three key issues in UAV trajectory optimization for unknown environments, i.e., high computational cost of gradient information acquisition, elevated risks beyond perception ranges, and insufficient performance in complex scenarios, this work presents several innovative solutions. First, by integrating with the Ego-Planner framework, we design a gradient generation algorithm based on point cloud maps, which reduces replanning iterations by 33 % while improving the success rate by 2.27 % and decreasing time consumption by 3.24 %. Second, we develop a bio-inspired trajectory optimization method by incorporating sensor perception range constraints and an improved beetle antennae search algorithm, significantly enhancing navigation safety in dense obstacle environments. Finally, we integrate these technologies to create a high-performance, lightweight autonomous navigation platform, whose feasibility and robustness are verified through multi-environment experiments.}
}
@article{HASHEMITABATABAEI2026114510,
title = {Interval-valued Fermatean fuzzy Z-LMAW for sustailient cold chain supplier evaluation},
journal = {Applied Soft Computing},
volume = {189},
pages = {114510},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114510},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501823X},
author = {Mohammad Hashemi-Tabatabaei and Maghsoud Amiri and Mehdi Keshavarz-Ghorabaee},
keywords = {Sustailient supplier evaluation, Fermatean fuzzy sets, Z-numbers, Interval-valued Fermatean fuzzy Z-numbers, LMAW, Hybrid uncertainty, Cold supply chain},
abstract = {The issue of supplier evaluation and selection (SES) is considered a critical decision at the strategic level of an organization, as it directly influences the efficiency and effectiveness of supply chain management (SCM) by introducing new members into the supply chain, particularly as the first link. This process becomes even more significant in cold supply chains (CSC), where suppliers are not only required to adhere to traditional business principles but also to provide specialized services such as controlling the temperature from the initial point to the final destination. Simultaneous adherence by suppliers to the sustainable and resilient (sustailient) principles can significantly address concerns regarding their sustainability responsibilities and their ability to respond to unforeseen crises and disruptions. As SES is a multi-criteria decision-making (MCDM) problem, this research proposes the logarithmic methodology of additive weights (LMAW), a relatively new and effective MCDM approach, in the context of interval-valued Fermatean fuzzy Z-numbers (IVFFZNs) to address the issue of sustailient SES in CSC. This approach, termed IVFFZ-LMAW, can effectively handle high levels of hybrid uncertainty in the decision-making environment while simultaneously performing integrated multi-expert processes for weighting criteria and prioritizing suppliers. To assess the feasibility and effectiveness of the proposed approach, a real-life case study was conducted in the CSC of a protein product manufacturing company, and the results were analyzed. Furthermore, sensitivity analysis and comparative analysis were performed to validate the proposed approach. The results demonstrated that the IVFFZ-LMAW approach effectively addresses the SES problem in CSC and provides robust results.}
}
@article{HSIANG2026114531,
title = {Breaking biological camouflage: DFNet for unified detection across species leveraging depth and multimodal fusion},
journal = {Applied Soft Computing},
volume = {189},
pages = {114531},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114531},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018447},
author = {Han-Cheng Hsiang and HuiZi Zhang},
keywords = {Applied soft computing, Camouflaged object detection (COD), Cross-species detection, Multimodal fusion, Monocular depth estimation, Precision agriculture, Biodiversity monitoring},
abstract = {Detecting camouflaged objects in complex natural environments poses a major challenge for applied soft computing, characterized by high visual ambiguity and uncertainty that hinder intelligent applications such as ecological monitoring and precision agriculture. Existing algorithms often lack 3D geometric cues, exhibit poor cross-species generalization, and incur high deployment costs due to specialized hardware. To overcome these limitations, this study proposes DFNet, a unified intelligent system for robust detection of both animal camouflage (COD) and plant concealment (CCD). Serving as a cost-efficient perception module, DFNet employs a monocular depth estimation model (Depth Anything V2) to generate high-quality pseudo-depth maps that are fused with RGB features to enhance geometric perception and eliminate the reliance on depth sensors. Its architecture integrates two key components: a Collaborative Unified Pyramid (CUP) for adaptive cross-species multi-scale representation, and a Synergistic Multimodal Adaptive Refinement (SMAR) module for fine-grained texture and contour modeling. Comprehensive experiments on the newly constructed COD10KM and public datasets (CAMO, ACOD-12K, NC4K) demonstrate DFNet’s superior performance and strong generalization. In animal camouflage tasks, DFNet improves the Structure measure (Sα) by 3.7 % over the Transformer-based FSPNet, while in plant concealment tasks, it raises the weighted F-measure (Fβω) by 1.8 % compared with RISNet. DFNet thus offers a powerful and transferable solution for practical applications such as smart agriculture, biodiversity monitoring, and UAV-based perception.}
}
@article{ZHANG2026114507,
title = {Evolutionary neural architecture search with dual contrastive learning},
journal = {Applied Soft Computing},
volume = {189},
pages = {114507},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114507},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018204},
author = {Xian-Rong Zhang and Yue-Jiao Gong and Wei-Neng Chen and Jun Zhang},
keywords = {Evolutionary neural architecture search, Predictor-assisted evolutionary algorithm, Self-supervised learning, Contrastive learning},
abstract = {Evolutionary Neural Architecture Search (ENAS) has gained attention for automatically designing neural network architectures. Recent studies use a neural predictor to guide the process, but the high computational costs of gathering training data—since each label requires fully training an architecture—make achieving a high-precision predictor with limited compute budget (i.e., a capped number of fully trained architecture–label pairs) crucial for ENAS success. This paper introduces ENAS with Dual Contrastive Learning (DCL-ENAS), a novel method that employs two stages of contrastive learning to train the neural predictor. In the first stage, contrastive self-supervised learning is used to learn meaningful representations from neural architectures without requiring labels. In the second stage, fine-tuning with contrastive learning is performed to accurately predict the relative performance of different architectures rather than their absolute performance, which is sufficient to guide the evolutionary search. Across NASBench-101 and NASBench-201, DCL-ENAS achieves the highest validation accuracy, surpassing the strongest published baselines by 0.05 % (ImageNet16-120) to 0.39 % (NASBench-101). On a real-world ECG arrhythmia classification task, DCL-ENAS improves performance by approximately 2.5 percentage points over a manually designed, non-NAS model obtained via random search, while requiring only 7.7 GPU-days.}
}
@article{HE2026114462,
title = {Fractional-order mutation based self-adaptive spherical search algorithm for global optimization},
journal = {Applied Soft Computing},
volume = {189},
pages = {114462},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114462},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017752},
author = {Chen He and He Huang},
keywords = {Spherical search, Exploration and exploitation, Fractional-order mutation, Selective pressure, Dendritic neuron model},
abstract = {Due to the unique hyperspherical search pattern, spherical search (SS) algorithms have a larger search space than traditional metaheuristic algorithms with hypercubic search pattern, such that it is of higher probability to find global optimal solution. Although SS and its variants have demonstrated strong competitiveness for global optimization, they frequently encounter stagnation and fall into local minima, highlighting the urgent need to achieve a balance between exploration and exploitation. To resolve this issue, a fractional-order mutation based self-adaptive SS (FOMSASS) algorithm is proposed in this paper. Basically, a fractional-order mutation strategy is presented to increase the population diversity and enhance the exploration capability. Furthermore, a selective pressure strategy is introduced to obtain appropriate search direction for the construction of projection spherical surface with improved exploitation capability. Experimental results on 29 benchmark functions in the IEEE Congress on Evolutionary Computation (CEC) 2017 competition show that FOMSASS is significantly superior to some state-of-the-art metaheuristic algorithms. On the other hand, FOMSASS is applied to the optimization of 79 real-world problems in the CEC 2011 and 2020 competitions and the training of dendritic neuron models to further validate the effectiveness of the proposed algorithm.}
}
@article{XU2026114523,
title = {Degradation-aware deep unfolding network with multi-loss optimization for underwater image enhancement},
journal = {Applied Soft Computing},
volume = {189},
pages = {114523},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114523},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018368},
author = {Chaolong Xu and Zhibin Xie and Peiyu Yan and Xin Shu and Changbin Shao},
keywords = {Deep unfolding, Feature fusion, GAN, Prior information, Underwater image enhancement},
abstract = {To address the issues of blurring, color distortion, and low contrast in underwater images, caused by medium scattering and noise interference, a degradation-aware deep unfolding network is proposed for underwater image enhancement. Inspired by unfolding methodologies, the unfolding enhancement module is designed, which maps images into feature space to achieve iterative enhancement. Additionally, step sizes and momentum terms within the module are parameterized via a learnable attention mechanism, optimizing iterative convergence speed. Within each unfolding enhancement module, a degradation-aware regularizer module is constructed to explicitly embed physical degradation characteristics and suppress scattering noise in the deep feature space. Furthermore, combined with a downsampling feature fusion strategy, this framework facilitates the joint learning of high-resolution texture details and low-resolution semantic information, mitigating the adverse effects of complex underwater conditions. A multi-loss function joint optimization strategy is employed during training to accommodate network requirements at different stages. Experimental results on the UFO-120 dataset demonstrate that the proposed network achieves a PSNR of 26.51 dB, an SSIM of 0.7885, and an FSIM of 0.9192. Additional experiments on other public datasets further validate the superiority of the network in underwater image enhancement tasks.}
}
@article{ZHANG2026114474,
title = {Physics-based generative adversarial networks for the compressive arch action in RC frame structures against progressive collapse},
journal = {Applied Soft Computing},
volume = {189},
pages = {114474},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114474},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017879},
author = {Qiang Zhang and Shi Chen Lei and Bo Yu},
keywords = {Compressive arch action, Physical mechanism, Empirical design rule, Progressive collapse, Analytical model},
abstract = {Reinforced concrete frame structures are commonly used in the construction industry. If subjected to unexpected loads, compressive arch action can remarkably increase structural resistance to resist progressive collapse. This study develops a physics-rule-based generative adversarial network (GAN) that can form the design parameters and the compressive arch action (CAA) resistance of frame structures. Five different machine learning methods were used and assessed to determine the best computation model. The dataset with and without augmented data were compared. The results displayed that the root mean squared error of the simulation for the test set by the XGBoost and random forest models is 14.063 and 16.648, respectively. Comparison studies have proven the reliability of the proposed model, where the calculation results can effectively meet the design requirements. Finally, sensitivity analysis is employed. Shapley Additive Explanation (SHAP) is used to explain the simulation model. The results show that the beam span, beam sectional height, and the yield strength of structural rebar are the main influencing parameters governing the CAA capacity of frame structures.}
}
@article{ZHANG2026114547,
title = {A surrogate-assisted differential evolution for expensive optimization with equality constraints},
journal = {Applied Soft Computing},
volume = {189},
pages = {114547},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114547},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018605},
author = {Jinxin Zhang and Jing-Yu Ji and Sam Kwong},
keywords = {Equality constraint, Expensive constrained optimization, Gradient descent, Multilayer perceptron, Surrogate-assisted differential evolution},
abstract = {Surrogate-assisted evolutionary algorithms have achieved notable success in expensive optimization. While significant attention has been given to expensive optimization scenarios without constraints or only with inequality constraints, equality constraints also commonly emerge in constrained optimization problems. Thus, there is a pressing need for surrogate-assisted evolutionary algorithms tailored for expensive optimization problems with equality constraints. This study integrates a multilayer perceptron as a surrogate with gradient descent-based local search in differential evolution to tackle the challenges caused by equalities in expensive constrained optimization. Our contributions encompass: 1) deploying a multilayer perceptron-based cheap surrogate that simultaneously fits the expensive objective function and equality constraints, 2) an enhanced gradient descent local search to manage challenging equality constraints, and 3) an individual update strategy aiming to strike a balance between objective optimization and constraint satisfaction. The proposed multilayer perceptron-based surrogate, along with the gradient descent-based local search, collaboratively navigates toward the feasible regions. The evolutionary search leveraging the surrogate broadly explores potential feasible regions, while the local search refines promising infeasible solutions into feasible ones. Experimental results highlight the capability and effectiveness of our proposed surrogate-assisted methodology for expensive optimization with equality constraints.}
}
@article{TAVAKOLSADRABADI2026114478,
title = {Stochastic near-surface wind field estimation from sparse aerial swarm measurements to support wildfire behaviour predictions},
journal = {Applied Soft Computing},
volume = {189},
pages = {114478},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114478},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017910},
author = {Mohammad {Tavakol Sadrabadi} and Mauro Sebastián Innocente},
keywords = {Wind downscaling, Fire-induced wind, Fire dynamics simulator (FDS), Physics-constrained neural networks, Convolutional neural networks (CNNs), Fluid flow reconstruction, Unmanned aerial vehicle (UAV)},
abstract = {Wildfire behaviour is influenced by weather, fuel, and topography. Detailed physics-based simulations are computationally expensive, particularly if accounting for fire–wind interactions. To address this, simplified models are developed that disregard certain physical laws and are often decoupled from the atmosphere. Efforts to improve model reliability by feeding it with near-surface wind fields using statistical and dynamical downscaling methods have two drawbacks: neglect of fire–wind interaction, and high computational demand. This study proposes combining sparse wind and temperature measurements taken by a drone swarm with convolutional neural networks to estimate near-surface fire-induced wind fields thereby capturing fire–wind interactions without solving the Navier-Stokes equations. The two-step process includes (i) super-resolution reconstruction of high-altitude wind field from sparse measurements, and (ii) high-resolution mapping from high-altitude to near-surface winds. Synthetic data are generated using Large-Eddy Simulations of grassland fires under varied wind speeds, terrain slopes, and vegetation conditions. Model performance is evaluated across different swarm sizes, spatial configurations, and measurement noise levels. The main contributions are: (1) a synthetic computational fluid dynamics dataset for fire-induced flows, (2) a two-stage deep learning framework for stochastic wind field estimation, and (3) uncertainty quantification for different swarm and noise conditions. Results show accurate near-surface wind estimation even with moderate swarm sizes, achieving an average mean absolute error and root mean square error (MAE/RMSE) of 0.849/1.323 for u, 0.672/1.022 for v, and 0.551/1.010 for w, where the (u,v,w) tuple defines the wind velocity.}
}
@article{ZHANG2026114487,
title = {Fault diagnosis in rotating machinery with discretized signal representation leveraging large language models},
journal = {Applied Soft Computing},
volume = {189},
pages = {114487},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114487},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018009},
author = {Chunming Zhang and Yilin Wang and Xinge You},
keywords = {Fault diagnosis, Rotating machinery, Large language model, Signal discretization, Tokenizer, Domain generalization},
abstract = {Fault diagnosis in rotating machinery is essential for maintaining operational safety and minimizing unplanned downtime, yet harsh and dynamic operating conditions limit the scalability and generalization of conventional models. Industrial Large Models, especially Large Language Models (LLMs), offer promising reasoning and abstraction capabilities, but their application to vibration signals is hampered by the gap between continuous waveforms and discrete token inputs. We propose Rotating Machinery Discrete Diagnosis with Large Language Models (RMD-LLM), a unified framework that bridges this gap through a Neural Frequency Tokenizer (NFT) that discretizes vibration data into symbolic sequences suitable for LLMs, a self-supervised pretraining strategy that learns domain-invariant frequency representations, and a lightweight Neural Frequency Adapter (NFA) featuring Learnable Instruction Tokens (LIT) and Fault Prototype Tokens (FPT) for parameter-efficient adaptation. Extensive experiments on six public datasets show that RMD-LLM delivers an average diagnostic accuracy above 98 % and robust generalization to unseen devices. By integrating discrete signal representation, self-supervised learning, and modular adaptation within an LLM-centric architecture, RMD-LLM offers a scalable and efficient solution for real-world fault diagnosis in heterogeneous industrial environments.}
}
@article{MA2026114442,
title = {Bearing fault diagnosis with class-aware re-weighting based multi-source domain adaptation under imperfect samples},
journal = {Applied Soft Computing},
volume = {189},
pages = {114442},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114442},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017557},
author = {Wengang Ma and Wenhui Zhao and Junjiang He and Ao Liu and Wenbo Fang and Jiangchuan Chen},
keywords = {Bearing fault diagnosis, Dynamic multi-graph convolutional network, Multi-source domain adaptation, Class-aware re-weighting, Imperfect samples},
abstract = {Real-time monitoring of high-speed train bearing status and detection of faults in critical components are crucial for train safety. However, the limited availability of fault data under specific conditions often leads to imperfect fault samples, with some fault categories exhibiting cross-domain characteristics. Multi-source domain adaptation (MSDA) models address this, yet face challenges from distribution differences and sampling randomness. This results in domain-specific conditional distribution shifts, which degrade fault diagnosis performance with imperfect samples. In this study, we propose a bearing fault diagnosis method with class-aware re-weighting based multi-source domain adaptation (MSDA-CASR) under imperfect samples. First, we develop a dynamic multi-graph convolutional network (DMGCN) for fault feature extraction, which learns fault features from global and local perspectives, capturing local and global spatial fault correlations. Then, we propose a MSDA-CASR model, establishing a joint transmission mechanism between multiple source and target domains and adaptively selecting samples relevant to the target domain. Additionally, we design a prototype-based cyclic domain triplet loss function for fine-grained alignment. Experimental results show that our model outperforms state-of-the-art models in diagnosing faults with imperfect samples, achieving the highest accuracy. It also demonstrates strong robustness and efficiency, maintaining performance even in noisy environments, with fast convergence and excellent transferability across domains.}
}
@article{HAN2026114482,
title = {Source-driven enhanced semantic style transfer for addressing BCI illiteracy in subject-independent EEG-based motor imagery classification},
journal = {Applied Soft Computing},
volume = {189},
pages = {114482},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114482},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017958},
author = {Ji-Wung Han and Dong-Hee Shin and Chang-Hoon Ji and Deok-Joong Lee and Jun-Mo Kim and WooHyeok Choi and Ji-Hye Oh and Sanghyeon Cho and Young-Han Son and Tae-Eui Kam},
keywords = {Brain-computer interface, Electroencephalography, Motor-imagery, Style transfer, BCI illiteracy},
abstract = {Motor-imagery brain-computer interface (MI-BCI) provides a direct connection between the brain and external devices by decoding user intentions. Despite its potential, the integration of MI-BCI systems into real-world applications faces challenges due to the prevalence of BCI illiteracy, where users encounter difficulties in device operation and maintaining focus during training sessions. Although one-to-one style transfer methods have been explored to mitigate BCI illiteracy, they have not been successfully extended to a subject-independent setting that involves unseen users. However, in practical BCI applications, this subject-independent setting is essential because subject-specific information is typically unavailable before BCI system implementation. To overcome these limitations, we propose a novel style transfer framework adept at tackling the BCI illiteracy problem within a subject-independent setting. Specifically, to improve style transfer performance, we enhance the framework through a source-driven selection mechanism that identifies and utilizes the most class-representative sample. Furthermore, we leverage the domain generalization technique to mix styles from multiple BCI illiterate users in the target domain, enabling robust performance on previously unseen users. This approach ensures that the model captures a diverse range of class-relevant features across users, enhancing its ability to generalize to new, unseen users. We demonstrate the effectiveness of our proposed approach through a leave-one-subject-out evaluation, which shows clear performance improvements across unseen subjects.}
}
@article{HU2026114458,
title = {Dual-domain extraction and fusion framework for underwater image enhancement},
journal = {Applied Soft Computing},
volume = {189},
pages = {114458},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114458},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017715},
author = {Zhenyu Hu and Qi Chen},
keywords = {Underwater image enhancement, Dual-domain encoder–decoder network, Dual-domain fusion module, Dual-domain restoration module, Mixed attention mechanism},
abstract = {Underwater images suffer from severe degradation, including color distortion, low contrast, and blurred details, due to light absorption and scattering in aquatic environments. Existing underwater image enhancement (UIE) methods often struggle to comprehensively address these issues, as they ignore the spatial and frequency domain information. To overcome these limitations, this paper proposes a dual-domain extraction and fusion framework (DDEFF) for UIE. This framework comprises a dual-domain encoder–decoder network (DDEDN) and a dual-domain fusion module (DDFM). The DDEDN utilizes dual-domain detail blocks (DDDBs) to extract and enhance detailed features and structural textures in both spatial and frequency domains, emphasizing fine image details. Then, the DDFM utilizes a dual-domain restoration module (DDRM) and a mixed attention mechanism (MAM) to fuse restored image features. The DDRM restores global contrast in the spatial domain and corrects color and luminance in the frequency domain, while the subsequent MAM integrates three attention mechanisms to adequately fuse the output features from the DDRM and DDEDN, producing a high-quality enhanced image. Extensive experiments on multiple datasets show that DDEFF outperforms state-of-the-art methods in terms of both qualitative and quantitative evaluations. Furthermore, this framework is highly efficient, with a runtime of 0.3045 s, 6.64 M parameters, and 11.18 G FLOPs, while also demonstrating strong generalization in challenging low-light and haze scenarios.}
}
@article{GU2026114556,
title = {Enhancing exchange rate forecasting with contextual sentiment indices: A fine-tuned FinBERT approach},
journal = {Applied Soft Computing},
volume = {189},
pages = {114556},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114556},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000049},
author = {Guoqin Gu and Yuping Song},
keywords = {Foreign exchange forecasting, Sentiment analysis, FinBERT, Fine-tuned language models, Sentiment Index},
abstract = {The incorporation of sentiment as a predictor of exchange rate movements has long been of interest to the academic community. This paper argues that, due to the relative and interdependent nature of currency fluctuations, the sentiment contained in foreign exchange news cannot be effectively captured through current sentiment analysis tools. Instead, it requires models specifically adapted to the characteristics of each currency pair. To address this gap, we take EUR/USD pair as an example, construct a manually annotated news dataset and fine-tune the FinBERT model on an annual rolling basis to produce a series of specialized sentiment classifiers. Based on these models, we develop contextual sentiment indices and incorporate them as predictors of exchange rate changes. Our empirical findings offer several key insights. (1) The fine-tuned FinBERT models exhibit strong capability in identifying forex-specific sentiment, achieving an out-of-sample accuracy of 84.33 %, and outperforming traditional sentiment tools as well as four state-of-the-art large language models. (2) Using a doubly debiased machine learning framework, we show that the developed sentiment indices exert a statistically significant influence on exchange rate movements. (3) Compared with benchmark predictors—including technical indicators and macroeconomic variables—the inclusion of sentiment indices consistently enhances the forecasting performance of LSTM models, their variants, and a range of machine learning methods. Overall, this study contributes to both sentiment analysis and exchange rate forecasting by providing a currency-pair-specific modeling framework and demonstrating that fine-tuned language models can materially improve predictive accuracy in financial applications.}
}
@article{ZHOU2026114505,
title = {Groundwater multi-pollution source tracing method based on encoder decoder residual convolutional neural networks},
journal = {Applied Soft Computing},
volume = {189},
pages = {114505},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114505},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018186},
author = {Zhengchen Zhou and Xuesong Yan and Chengyu Hu},
keywords = {Groundwater pollution sources identification, Image-to-image regression, Encoder-decoder residual convolutional neural networks, Convolutional neural networks},
abstract = {Groundwater pollution has become a major threat to the global environment and public health, making the rapid and accurate identification and tracing of pollution sources through scientific methods an urgent necessity. This is critical for formulating effective water management strategies and safeguarding water security, thereby establishing groundwater pollution source identification (GPSI) as an important research field. In this study, we reframe the GPSI challenge as an image-to-image regression task, which can more intuitively capture and map the complex relationships between post-event pollutant concentration distributions and their original sources, thereby improving the accuracy and efficiency of source tracking. We propose an encoder-decoder residual convolutional neural network (EDRCNN) model that integrates residual units and encoder-decoder structures to infer both the location and concentration of pollutants. Comparative experiments demonstrate that the proposed EDRCNN model outperforms other methods, such as artificial neural networks (ANN), convolutional neural networks (CNN), and encoder-decoder convolutional neural networks (EDCNN). Specifically, across different scenarios, the mean absolute percentage error (MAPE) achieved by EDRCNN is significantly lower than that of the best-performing ANN model in comparative tests. Furthermore, EDRCNN predictions yield a lower mean absolute error (MAE) compared to general ANN predictions, and also exhibit superior performance in terms of root mean square error (RMSE), underscoring the superiority of our proposed model in addressing GPSI challenges.}
}
@article{HUANG2026114533,
title = {Robot arm control based on online resolution of nonlinear equation systems using novel matrix-pseudoinverse-free neurodynamics},
journal = {Applied Soft Computing},
volume = {189},
pages = {114533},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114533},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018460},
author = {Meichun Huang and Yunong Zhang and Shuai Li},
keywords = {Robot arm control, Temporal-variant nonlinear equation systems, Zhang neurodynamics, Matrix-pseudoinverse-free, Acceleration-layer},
abstract = {Robot arm control plays a pivotal role in modern industrial automation. Designing a controller without matrix-pseudoinverse computation for robot arms from the acceleration-layer control perspective is a challenging topic. In this article, based on the temporal-variant nonlinear equation system (TVNES) problem, we propose a novel acceleration-layer TVNES (AL-TVNES) problem. By constructing an output function and an energy function, and applying twice Zhang neurodynamics (ZN) design formula, a new matrix-pseudoinverse-free acceleration-layer ZN (MPF-ALZN) controller is proposed. The controller effectively avoids the complicated computation of the temporal-variant matrix pseudoinverse, thereby reducing computational complexity. In addition, theoretical analyses and numerical experiments show the convergence and robustness of the MPF-ALZN controller. Finally, the proposed MPF-ALZN controller is successfully applied to the control of the Kinova Jaco2, Franka Emika Panda, and Kinova Gen3 robot arms, with the tracking errors between the desired paths and the actual trajectories being below 0.01 mm, which validates the efficiency of the proposed controller. Through various experiments in MATLAB, CoppeliaSim, and physical platforms, the high tracking accuracy and robustness of the MPF-ALZN controller are confirmed, indicating its practicality.}
}
@article{ZHENG2026114525,
title = {DROP: Dynamics-aware representation learning for offline reinforcement learning},
journal = {Applied Soft Computing},
volume = {189},
pages = {114525},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114525},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018381},
author = {Jun Zheng and Runda Jia and Shaoning Liu and Ranmeng Lin and Dakuo He and Fuli Wang},
keywords = {Behavior cloning, Data-driven, Offline reinforcement learning, Representation learning},
abstract = {Offline reinforcement learning (RL) enables deriving optimal policies from static datasets, promising safe and efficient control in real-world applications where online interaction is costly or risky. However, a pervasive challenge in offline RL is the overestimation of Q-values for out-of-distribution (OOD) actions. Existing methods typically mitigate this via policy constraints or conservative regularization that force the policy to adhere to the dataset’s support. Such approaches, however, heavily rely on accurately estimating the behavior policy and often overlook the potential of rich representations in capturing underlying environmental dynamics. In this study, we propose the Dynamics-Aware Representation Offline Policy Optimization (DROP) algorithm, which addresses these limitations through two synergistic mechanisms. First, DROP constructs a dynamics-aware latent space by jointly predicting rewards and next-state representations, thereby extracting structural features crucial for decision-making. Second, it integrates a behavior cloning regularization directly into the value function learning objective. This effectively penalizes OOD actions without the need for explicit behavior policy modeling. Empirical evaluations on the D4RL benchmarks, including Locomotion and AntMaze tasks, demonstrate that DROP achieves superior performance over state-of-the-art algorithms, achieving a 4.9 % and 4.2 % improvement in total scores, respectively.}
}
@article{VERMA2026114521,
title = {Dynamic context learning using multiple visual scanpaths for action classification in still images},
journal = {Applied Soft Computing},
volume = {189},
pages = {114521},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114521},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018344},
author = {Ashish Verma and Dishant Satuley and Debashis Sen},
keywords = {Image action recognition, Visual scanpaths, LSTM-based prediction},
abstract = {Humans consistently recognize actions in images through visual observation by adeptly attending to the entities involved and identifying their contextual relationships. Drawing inspiration from this phenomenon, we propose a network that utilizes visual scanpaths to perform action classification in images. Specifically, the network consists of a novel dynamic context module (DCM) that implements human-like understanding by employing a scanpath-driven long short-term memory (LSTM) for enriched modeling of the dynamic interactions among visual entities involved in actions. The scanpaths on an image are generated using a human visual scanpath predictor, and our approach also includes the detection of object instances in an image and the extraction of their features. These features are subsequently enhanced by the DCM and then employed to perform the action classification. Extensive experiments demonstrate that integrating visual scanpaths improves action classification accuracy, achieving state-of-the-art results across different datasets. This reflects the effectiveness of our dynamic context learning strategy to perform human-like assessment for action classification in still images. This is corroborated by a thorough ablation study, which also establishes the contributions of the other model components.}
}
@article{LI2026114513,
title = {Efficient dual-branch high-resolution transformer design for crack segmentation},
journal = {Applied Soft Computing},
volume = {189},
pages = {114513},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114513},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018265},
author = {Yongshang Li and Zihan Ma and Ronggui Ma},
keywords = {Crack segmentation, Transformer, Efficient self-attention, High-resolution dense prediction, Dual-branch network},
abstract = {Recent studies show that Transformer-based crack segmentation models deliver impressive results. However, due to the quadratic complexity of the self-attention mechanism, the computational cost becomes prohibitive when handling high-resolution dense prediction tasks. This paper presents an efficient Transformer-based network for crack segmentation, utilizing several specially optimized self-attention modules. The proposed model incorporates a dual-branch structure, consisting of a high-resolution branch that maintains high resolution throughout and a low-resolution branch that progressively reduces resolution. A multi-scale spatial-reduction attention is introduced to the high-resolution branch to capture fine details, while an enhanced ReLU-based linear attention in the low-resolution branch learns global features. A bidirectional cross-resolution feature enhancement module connects the two branches, facilitating comprehensive information fusion. On the combined dataset CrackSeg9k and the scenario-specific datasets Asphalt3k and Concrete3k, the proposed method obtains mIoU of 81.85 %, 81.29 %, and 86.36 %, respectively, which outperforms the comparative state-of-the-art models and also achieves the best trade-off between efficiency and performance. Additionally, a robustness benchmark on common corruptions shows the proposed model degrades less than comparable lightweight baselines.}
}
@article{TOFIGH2026114489,
title = {A parallel Seq2Seq neural architecture for long-horizon performance forecasting and online condition monitoring of fuel cells},
journal = {Applied Soft Computing},
volume = {189},
pages = {114489},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114489},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018022},
author = {Mohamadali Tofigh and Daniel J. Smith and Amir R. Hanifi and Mahdi Shahbakhti},
keywords = {Sequence-to-sequence model, Neural forecasting, Fuel cell, Condition monitoring},
abstract = {Solid Oxide Fuel Cells (SOFCs) are efficient and environmentally friendly power generation technologies that have seen increasing applications in recent years. However, their material instability at high operating temperatures makes them susceptible to degradation and unexpected failures. This demands developing robust monitoring algorithms to predict the onset of degradation, thereby facilitating maintenance strategies to extend SOFC longevity. SOFCs suffer from complex, non-stationary degradation processes such as nickel (Ni) reoxidation, where both externally and internally driven dynamics interact over long horizons. Accurately forecasting these dynamics is challenging because existing sequence-to-sequence models either overlook the coupling of internal and external factors or incur prohibitive computational costs that hinder real-time deployment. To address these challenges, this paper introduces an innovative deep neural forecasting network that integrates parallel computing layers, including one-dimensional dilated convolutions and multilayer perceptrons (MLPs), within an interpretable encoder–decoder framework. The design effectively captures redox-induced dynamics while offering efficient memory usage and parallelism. The effectiveness of the architecture is demonstrated through long-horizon forecasting of SOFC performance under Ni reoxidation degradation, benchmarked against transformer-, recurrent-, and MLP-based architectures. Extensive experiments on SOFC degradation datasets, collected from multiple lab-scale fuel cells, demonstrate that the proposed model consistently outperforms state-of-the-art models, achieving a 16 % improvement in Root Mean Squared Error, 20 % in symmetric Mean Absolute Percentage Error, and 23 % in Weighted Absolute Percentage Error metrics. More importantly, our model requires 21 % less Graphics Processing Unit (GPU) resources than its counterparts while offering a 36 % faster latency during inference–key advantages for real-time deployment in early-stage degradation detection systems in fuel cell technology.}
}
@article{LIU2026114466,
title = {sEMG-based real-time speech synthesis with feature distillation and dynamic chunk convolution},
journal = {Applied Soft Computing},
volume = {189},
pages = {114466},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114466},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501779X},
author = {Yang Liu and Chen Lv and Yi Li and Huayu Chen and Yan Chen and Longhan Xie},
keywords = {Silent speech interface, Surface electromyography, Streaming inference, Feature distillation, Dynamic chunk training},
abstract = {Silent Speech Interface (SSI) systems typically rely on non-streaming inference, where entire utterances must be processed at once, leading to substantial latency, high memory usage, and limited suitability for real-time interaction or edge deployment. To address this limitation, we propose DualSSI, a dual-mode sEMG-based SSI that supports both streaming and non-streaming inference within a single unified architecture. DualSSI integrates three key techniques: (1) adaptation of dynamic chunk convolution and attention, originally proposed in streaming automatic speech recognition, to exploit limited future context during streaming sEMG-to-speech synthesis; (2) feature distillation from a non-streaming teacher model to improve streaming accuracy; and (3) a Conformer-based encoder–decoder for robust local–global feature extraction under chunk-wise processing. Experiments on Mandarin and English datasets show that DualSSI consistently improves over a strong streaming SSI baseline in both objective metrics and subjective listening tests, while approaching the performance of non-streaming models. Moreover, DualSSI achieves an end-to-end latency of 10.71 ms for 11.6 ms chunks on an Ascend 310B NPU, indicating strong potential for real-time and wearable SSI applications.}
}
@article{ZHAO2026114508,
title = {A few-shot fine-grained fault diagnosis framework based on pseudo-supervised task representation},
journal = {Applied Soft Computing},
volume = {189},
pages = {114508},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114508},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018216},
author = {Zhiqian Zhao and Yinghou Jiao and Yeyin Xu and Enrico Zio and Zhaobo Chen and Runchao Zhao},
keywords = {Fault diagnosis, Contrastive learning, Pseudo-label method, Meta-learning, Sample filtering},
abstract = {Traditional fault diagnosis methods are typically coarse-grained, with clear distinctions between faults. These methods necessitate extensive labeled data for effective training and lack the capability to diagnose at more fine-grained granularity with limited data. Furthermore, labeling data is labor-intensive and, in fact, the data is usually unlabeled in many complex engineering systems. To tackle these challenges, we propose a novel few-shot fine-grained fault diagnosis framework based on pseudo-supervised task representation, PSTR, which aims to generate pseudo-labels and assign them to the original samples, then samples with high information entropy are selected to construct meta-tasks. Firstly, feature representations are crafted by a network utilizing contrastive learning, thereby enhancing class separation. To construct pseudo-supervised tasks, clustering is applied to the feature representations, leading to the generation of pseudo-labels for the original samples. Subsequently, a perturbation strategy is introduced to effectively cope with the weak diversity of the task, obtaining meta-representations enriched with the fine-grained features provided by the large clusters and with the variability given by the small clusters to complete fault diagnosis. Furthermore, during the meta-training process, clusters containing high information are selected by entropy and low-scoring samples are filtered out using an evaluation model. It achieves an average accuracy of 83.37 % on both public datasets in diagnosing unseen fine-grained faults, outperforming popular methods.}
}
@article{TAHMASEBI2026114463,
title = {Detail-rich pore-scale reconstruction with conditional latent diffusion},
journal = {Applied Soft Computing},
volume = {189},
pages = {114463},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114463},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017764},
author = {Pejman Tahmasebi},
keywords = {Porous media reconstruction, Generative modeling, Pore-scale imaging, Conditional diffusion},
abstract = {Accurate characterization of pore-scale structures is essential for modeling flow and transport in porous media, yet high-resolution imaging is often limited by acquisition cost and resolution constraints. In this paper, we propose a generative framework that leverages a Variational Autoencoder (VAE) and a Latent Diffusion Model (LDM) to reconstruct fine-scale porous media images from their coarse counterparts. The VAE is trained to encode high-resolution porous structures into a compact latent space, enabling efficient and physically meaningful representations. A conditional diffusion model is then trained in this latent space to iteratively denoise coarse-resolution inputs and generate realistic structures consistent with the encoded statistics of the training data. This two-stage architecture decouples image complexity from generative sampling and allows for computationally efficient learning of multiscale features. We demonstrate the effectiveness of this approach on a dataset of porous media images, both qualitatively and quantitatively, and show that the generated samples preserve key structural and statistical properties such as pore connectivity and phase distribution compared to the original high-resolution version.}
}
@article{DEOLIVEIRA2026114500,
title = {An analysis of facial recognition in banking disputes through data scraping from São Paulo court of appeal decisions},
journal = {Applied Soft Computing},
volume = {189},
pages = {114500},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114500},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018137},
author = {Cristina Godoy B. {de Oliveira} and Otávio de P. Albuquerque and Emily L. Belotti and Isabella F. Lopes and Rodrigo Brandão de A. Silva and Glauco Arbix},
keywords = {Facial recognition systems, Artificial intelligence, Jurisprudence, Legal cases, Law},
abstract = {Context: The increasing adoption of Artificial Intelligence (AI) systems in financial services has led to a growing number of legal disputes concerning the use of facial recognition technology (FRT) in Brazil. This study examines how the São Paulo Court of Appeal has addressed consumer claims related to contracting payroll loans using FRT-based authentication. To achieve this, we employed web scraping techniques to collect 186 judicial decisions referencing AI-related terms and 10,745 decisions specifically mentioning “facial biometrics” from the Court’s online portal between 2012 and 2024. The data was processed and filtered using data mining techniques to isolate cases directly involving banking disputes over facial recognition in credit contracts. A qualitative analysis focused on 41 decisions under the AI term search and 418 under the facial biometrics search. The findings reveal a consistent judicial tendency to validate contracts based on FRT authentication, often shifting the burden of proof to consumers, even in cases involving vulnerable individuals such as the elderly. Moreover, courts frequently accept minimal technical evidence from banks regarding the reliability and error rates of their facial recognition systems. These judicial decisions raise concerns about consumer rights protection, informed consent, and judicial reliance on technology perceived as infallible. The paper highlights the need for regulatory oversight by the Brazilian Central Bank and the National Council of Justice to establish technical standards and procedural safeguards when financial institutions use FRT in consumer credit contracts. These findings contribute to ongoing discussions on AI accountability and the ethical deployment of biometric technologies in the financial sector.}
}
@article{MA2026114528,
title = {MCellPSO-PD: A multi-subgroup cellular PSO method for packing density measurement in gas-solid-phase flow},
journal = {Applied Soft Computing},
volume = {189},
pages = {114528},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114528},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018411},
author = {Qihang Ma and Gaoliang Peng and Wei Zhang and Benqi Zhao and Zhao Chen and Kang Jin},
keywords = {Multi-subgroup PSO, Cellular activation, Gas-solid-phase flow, Packing density measurement, Multi-objective optimization},
abstract = {Accurate yet timely packing density measurement is critical for controlling gas-solid two-phase flow. We propose MCellPSO-PD, a particle-swarm method that fuses multi-subgroup collaboration, cellular activation, and an adaptive inertia schedule to sharpen the exploration–exploitation balance and boost diversity. This innovation enables synchronous multi-directional search, local optima activation, and deeper optimization performance. The method integrates non-dominated sorting with crowding-entropy-based elitism to obtain well-distributed Pareto fronts. We evaluate the approach using ablation studies, multi-condition experiments, and comparisons with representative scalar and multiobjective baselines. Across challenging regimes, MCellPSO-PD maintains robust performance, delivering diverse, stable Pareto solutions and surpassing traditional approaches in precision and efficiency, achieving a mean error as low as 0.12 % with a processing time of 16.05 s. These results show that the framework enables accurate, cost-efficient packing density optimization and offers clear guidance for practical industrial applications.R6}
}
@article{ZHANG2026114451,
title = {WIOC-RVFL: Eliminating objective biases by weighted integrated optimization method},
journal = {Applied Soft Computing},
volume = {189},
pages = {114451},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114451},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017648},
author = {Siyuan Zhang},
keywords = {Random vector functional link, Constructive neural network, Integrated optimization metrics, Mean squared error},
abstract = {As a Constructive Algorithm (CA), the incremental Random Vector Functional Link (RVFL) network provides a mechanism for adaptively building its architecture during training by incrementally adding hidden neurons until a satisfactory solution is reached. This construction process unfolds in two stages: initially, the search for the added hidden layer weights; and subsequently, the update of the optimal solution of the output weights based on Mean Square Error (MSE). In classification tasks, two biases arise in this construction process. The first bias stems from the inadequacy of MSE in precisely characterizing classification error. The secondary bias pertains to the lack of assurance in simultaneous optimization when searching for hidden layer weights alongside optimizing the output layer. To address these biases, this paper introduces a novel random-based constructive classification algorithm, termed Weighted Integrated Optimized Constructive Random-Vector Functional Link (WIOC-RVFL), which incorporates dynamic learning of cost-sensitive coefficients into the construction process. The proposed algorithm mitigates objective function bias by adding penalty terms to the loss function based on classification errors. Moreover, the selection of newly added hidden neurons is guided by integrated optimization metrics to achieve simultaneous configuration with optimal output weights under dynamic cost-sensitive coefficients. Simulation results demonstrate that our approach outperforms other random-based learner models. The code for implementation is available at https://github.com/UHIF/WIOC-RVFL.}
}
@article{LI2026114479,
title = {Music representation learning by decoupling sentiment from melody for affect transfer},
journal = {Applied Soft Computing},
volume = {189},
pages = {114479},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114479},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017922},
author = {Jin Li and Zhaoqi Wang and Longjiang Guo and Meirui Ren},
keywords = {Melodic variation generation, Representation learning, Music decoupling, Music sentiment},
abstract = {The same melody played with different rhythms can express different sentiments, generally referred to as melodic variation. Generating variations of music with different sentiments holds significant value for music composition, education, therapy, and entertainment. However, directly altering the rhythm of music requires professional knowledge and is typically performed manually by musicians. Therefore, AI-based generation of variations is challenging, and currently, no mature methods are available. Existing music generation methods are also unsuitable for this task. This paper challenges the conventional approach of modifying rhythm to generate variations and proposes a novel method of music representation and generation named Sentiment Decoupling for Melodic Variation Generation (SD-MVG). SD-MVG decouples sentiment from the melody to generate new variations by replacing the original sentiment with new ones. This data-driven approach is suitable for the intelligent and automated generation of melodic variations. Specifically, the input music is encoded by a sentiment encoder and a melody encoder to obtain two kinds of representations, respectively. Then, a pre-trained sentiment classifier is utilized to identify the labels of these representations. The sentiment representation is expected to be classified into its sentiment label, meanwhile, the prediction of the melody representation is required to be uniform. Furthermore, melodic variation generation with different sentiments is deeply discussed, where the melody representation and different sentiment representations are composited by a Vector Quantization-based Generative Adversarial Network (VQ-GAN). Experimental results show that the proposed SD-MVG can decouple sentiment from melody and generate melodic variations for the input music.}
}
@article{LI2026114419,
title = {Meta-auxiliary learning for micro-expression recognition},
journal = {Applied Soft Computing},
volume = {189},
pages = {114419},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114419},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017326},
author = {Yufei Li and Yuxuan Yang and Jingyao Wang and Wenwen Qiang},
keywords = {Micro-expression recognition, Meta-auxiliary learning, Sentiment analysis},
abstract = {Micro-expressions (MEs) are involuntary movements revealing people’s hidden feelings, which has attracted significant interests for their objectivity in emotion detection. However, despite their wide applications in various scenarios, micro-expression recognition (MER) remains a challenging problem in real life due to three reasons, including (i) data-level: lack of data and imbalanced classes, (ii) feature-level: subtle, rapidly changing, and complex features of MEs, and (iii) decision-making-level: the impact of individual differences. To address these issues, we propose a dual-branch meta-auxiliary learning method, called LightmanNet, for fast and robust micro-expression recognition. Specifically, LightmanNet learns general MER knowledge from limited data through a dual-branch bi-level optimization process: (i) In the first level, it obtains task-specific MER knowledge by learning in two branches, where the first branch is for learning MER features via primary MER tasks, while the other branch is for guiding the model to obtain discriminative features via auxiliary tasks, i.e., image alignment between micro-expressions and macro-expressions due to their resemblance in both spatial and temporal behavioral patterns. The two branches of learning jointly constrain the model to learn meaningful task-specific MER knowledge while avoiding learning noise or superficial connections between MEs and emotions that may damage its generalization ability. (ii) In the second level, LightmanNet further refines the learned task-specific knowledge, improving model generalization and efficiency. Extensive experiments on various benchmark datasets demonstrate the superior robustness and efficiency of LightmanNet.}
}
@article{LIAN2026114471,
title = {Enhanced all-sky Aurora image classification using pyramid vision transformer and contrastive background contextual transforms},
journal = {Applied Soft Computing},
volume = {189},
pages = {114471},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114471},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017843},
author = {Jian Lian and Weiguang Wang},
keywords = {Auroral image classification, Machine vision, Deep learning, Pyramid vision transformer, Contrastive background contextual transforms},
abstract = {Aurora research and space-weather forecasting are of growing importance; however, accurately classifying auroral sub-phenomena remains challenging. Existing machine-learning methods that rely on hand-crafted features lack sufficient descriptive power, while deep-learning approaches struggle to correlate global information in complex-semantic aurora images. Moreover, background variations—light pollution, cloud cover, and atmospheric scattering—hamper accurate classification. This study integrates the Pyramid Vision Transformer (PVT) with the Contrastive Background Contextual Transform (CBCT) for all-sky aurora-image classification. PVT’s hierarchical architecture and self-attention mechanism capture both local and global features, whereas CBCT mitigates background variations by computing background-context features and enhances feature discriminability via contrastive operations. Evaluated on the OATH dataset (5824 images from the THEMIS all-sky imager network), the proposed model significantly outperforms state-of-the-art architectures: in binary classification (aurora vs. no-aurora) it achieves 99.5 % sensitivity, 97.7 % specificity, and 99.2 % accuracy; in six-class classification (arc, diffuse, discrete, cloudy, moon, no-aurora) it attains 96.9 % sensitivity, 97.8 % specificity, and 97.6 % accuracy. These results validate the effectiveness and reliability of the proposed model for aurora-image classification.}
}
@article{TANG2026114532,
title = {Wind power forecasting: A multi-task learning framework based on hybrid model and knowledge sharing},
journal = {Applied Soft Computing},
volume = {189},
pages = {114532},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114532},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018459},
author = {Yugui Tang and Yongcun Guo and Gang Shen and Zhen Zhang},
keywords = {Wind power forecasting, Placeholder-enhanced structure, Multi-task learning, Knowledge sharing},
abstract = {Accurate wind power forecasting is crucial for maintaining grid stability amid increasing wind energy integration. However, a primary obstacle to this goal, especially for newly commissioned wind farms, is insufficient training data. This paper aims to address this challenge by two aspects: first, a novel forecasting model architecture featuring dimension-segment embedding, a placeholder-enhanced structure, and cross-attention blocks is proposed to capture complex spatiotemporal dependencies. Second, a multi-task learning framework and bias-weighted joint optimization are designed for mitigating reliance on training data. The multi-task learning framework is composed of task-shared modules and task-specific modules. The task-shared modules integrate shared knowledge across multiple turbines to compensate for data shortage, while the task-specific modules adapt the shared knowledge to individual target wind turbines. Experimental results demonstrate the proposed model is superior to benchmark models in forecasting accuracy and stability. Furthermore, compared to traditional training framework, multi-task learning framework yields accuracy improvements of up to 23.35 % in cases with insufficient training data. The knowledge-sharing paradigm proves the spatiotemporal coupling within turbine clusters and offers a promising direction for knowledge generalization of power forecasting.}
}
@article{AVRAMELOU2026114467,
title = {Neuromorphic photonic neural networks for on-chip gas spectra classification},
journal = {Applied Soft Computing},
volume = {189},
pages = {114467},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114467},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017806},
author = {Loukia Avramelou and Manos Kirtas and Odysseas Asimopoulos and Theodoros Moschos and Antonios Prapas and Georgios Tsamis and Apostolos Tsakyridis and Miltiadis Moralis-Pegios and Aitor {V. Velasco} and Irene Olivares and Carlos {Alonso Ramos} and Sara {Toxqui Rodríguez} and Nikolaos Passalis and Nikolaos Pleros and Anastasios Tefas},
keywords = {Photonic spectrometers, Neuromorphic photonics, Deep learning},
abstract = {The growing concern about air pollution, especially in recent years, has increased the interest in developing systems that perform air monitoring, track air quality, and detect air pollutant gases, such as carbon dioxide and methane. Advanced gas detection technologies, including miniaturized silicon photonic spectrometers, are essential for identifying unhealthy living conditions, especially in urban environments, and enable us to monitor air effectively, reduce harmful emissions, and enhance overall environmental quality. These cost-effective and small-sized devices detect specific absorption features of different gases in the atmosphere and have great potential for use in sensor devices. However, these spectrometers are highly sensitive to fabrication errors and environmental conditions, which can affect their accuracy. Deep learning models have shown promising results in classifying spectra, as they can work with noisy data. Still, their complexity and high resource demands make them impractical for deployment in edge-based environmental monitoring systems. At the same time, photonic neural networks enable high-speed operations with low power consumption and promise several benefits for analyzing gas absorption spectra and detecting the corresponding gas, taking advantage of neuromorphic photonic hardware accelerators. However, training a neuromorphic photonic neural network is not trivial and presents additional training challenges. To this end, in this work, we propose a pipeline for implementing photonic neural networks to classify gas absorption spectra and detect different gases in the environment, considering the limitations of the neuromorphic photonic hardware and spectrometer imperfections. The experimental results indicate the effectiveness of the proposed method, as the real-hardware-integrated model achieves results comparable to those of the software model.}
}
@article{ZOU2026114459,
title = {AdaSwitch: Adapting switch from Adam to SGDM by exponential function},
journal = {Applied Soft Computing},
volume = {189},
pages = {114459},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114459},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017727},
author = {Weidong Zou and Yuanqing Xia and Bineng Zhong and Weipeng Cao},
keywords = {Deep learning, Optimizers, Fast convergence, Robust generalization},
abstract = {Optimizers play a critical role in the training of deep neural networks (DNNs). Adam is known for its fast convergence, while Stochastic Gradient Descent with Momentum (SGDM) is valued for its strong generalization capability. However, both exhibit limitations: SGDM often suffers from slow convergence initially, whereas Adam tends to generalize poorly in later stages. To address these issues, we propose AdaSwitch, an optimizer that combines the strengths of both methods, achieving rapid convergence early in training and robust generalization later on. AdaSwitch employs a linear combination based on an exponential function to smoothly transition from Adam to SGDM by adjusting the DNN parameters. We also provide a theoretical convergence guarantee for non-convex settings. The core idea is to express the network parameters θt as θt=β3tθtAdam+(1−β3t)θtSGDM, where (β3∈(0,1)) is the base of the adaptive exponential function. Extensive experiments on various architectures and tasks demonstrate that AdaSwitch outperforms existing methods in image classification, image generation, node classification, and few-shot visual classification, delivering both fast convergence and strong generalization.}
}
@article{JI2026114527,
title = {Uncertain spatiotemporal knowledge graph construction with fuzzy spatiotemporal XML data},
journal = {Applied Soft Computing},
volume = {189},
pages = {114527},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114527},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501840X},
author = {Hao Ji and Li Yan and Zongmin Ma},
keywords = {Spatiotemporal data, Fuzzy spatiotemporal XML, Spatiotemporal RDF, Construction},
abstract = {The dynamic uncertainty of metadata has rendered the crisp and static Resource Description Framework (RDF) inadequate to meet practical needs. Consequently, the utilization of RDF models to characterize fuzzy spatiotemporal data has emerged as a crucial research area. In the context of the web community, a substantial volume of fuzzy spatiotemporal data is represented using the complex fuzzy spatiotemporal eXtensible Markup Language (XML) models. The task of constructing a flexible and simplified fuzzy spatiotemporal RDF knowledge base from fuzzy spatiotemporal XML data has become a prominent challenge in the era of big data intelligence. In this paper, we are devoted to addressing the problem of constructing fuzzy spatiotemporal RDF from fuzzy spatiotemporal XML. To accomplish this, we introduce a novel fuzzy spatiotemporal RDF model as our foundation. Building upon this, we propose a set of mapping rules designed to transform the fuzzy spatiotemporal XML model into the corresponding fuzzy spatiotemporal RDF model. Note that these mapping rules and algorithms operate at the model level, covering element, attribute, text value, and datatype. This approach is highly beneficial for users seeking to gain a deep understanding of the underlying structure of fuzzy spatiotemporal data and construct a complete fuzzy spatiotemporal RDF Knowledge Graph (KG). Finally, we conducted an experimental evaluation to verify the effectiveness of the proposed construction method. Results show that our construction method can facilitate the information interaction from XML to RDF in fuzzy spatiotemporal data.}
}
@article{QIAO2026114534,
title = {A genetic algorithm (GA) with graph reconstruction and Boolean_OR Crossover for minimum 2-edge connected m-dominating set problem},
journal = {Applied Soft Computing},
volume = {189},
pages = {114534},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114534},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018472},
author = {Yixin Qiao and Rongjie Song and Siyu Li and Zenglin Chi and Zhiming Lv and Dangdang Niu},
keywords = {Combinatorial optimization, Genetic algorithm, 2-edge connected m-dominating set},
abstract = {The minimum 2-edge connected m-dominating set problem (M (2, m) ECDSP) is a variant of the classical minimum dominating set problem. The objective of this problem is to find a 2-edge connected subgraph that can m-dominate the remaining vertices in a given connected graph, denoted as G=(V,E). Due to the strong correlation between the vertices in the solution of this problem, the existing heuristic search methods find it difficult to obtain excellent solutions for slightly larger graphs. This paper proposes a genetic algorithm (GA) to efficiently solve M (2, m) ECDSP, specifically for m=1 and m=2. Firstly, a greedy random adaptive framework and a pheromone self-updating method are introduced to enhance the selectivity of vertices during the construction of initial candidate solutions. Secondly, a genetic algorithm with a special strategy called Boolean_OR Crossover is employed to iteratively improve the solution. Additionally, a novel strategy called graph reconstruction is proposed for M (2, m) ECDSP, which efficiently deletes redundant vertices in each solution (chromosome) during the construction of initial candidate solutions and genetic iterations. The performance of the algorithm is evaluated on 40 common benchmark instances and 20 larger instances in this paper. The experimental results demonstrate the superiority of our proposed GA algorithm over state-of-the-art GRASP, LLZ20, and the CMECDS algorithm, especially for the 20 large graphs.}
}
@article{RODRIGUEZBEJARANO2026114526,
title = {Multi-objective genetic algorithm with maximum-entropy classification and domain-specific evolutionary operators for microorganism selection on microbiomes},
journal = {Applied Soft Computing},
volume = {189},
pages = {114526},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114526},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018393},
author = {Fernando M. Rodríguez-Bejarano and Sergio Santander-Jiménez and Miguel A. Vega-Rodríguez},
keywords = {Multi-objective evolutionary algorithm, NSGA-III, Stochastic gradient descent, Microorganism selection, Microbiome},
abstract = {The field of microbiome research has experienced exponential growth in recent years, driven by advancements in next-generation sequencing technologies. A particular topic of interest in this field lies in studying the influence of the microbiome on the host organism’s state, with the aim of boosting the potential use of microorganisms as indicators of phenotypic conditions. However, microorganism selection is a hard-to-tackle problem involving multiple optimality criteria. This work introduces MADMISM, a Multi-objective Approach based on Dominance for MIcroorganism Selection on Microbiomes. Based on the Non-dominated Sorting Genetic Algorithm III, the proposed approach includes maximum-entropy classification with stochastic gradient descent learning and domain-specific operators through all evolutionary stages. Hence, MADMISM combines the search power of evolutionary algorithms with the enhanced guidance provided by the domain-specific operators. The evaluation of results on eight real microbiome datasets showcases MADMISM’s superiority in providing solutions with a minimal set of Operational Taxonomic Units (OTUs) while achieving high classification performance, with statistically significant improvements over state-of-the-art methods in most scenarios. Specifically, MADMISM accomplishes an average OTU reduction of 46.35 % and a classification improvement of 12.05 % compared to state-of-the-art methods, while also showcasing remarkable scalability. Furthermore, MADMISM exhibited superior multi-objective performance with an average hypervolume of 90.06 %, and presented statistically significant improvements over well-established multi-objective algorithms. Therefore, MADMISM represents an effective approach for identifying microbial markers. This is evidenced by the quality of its results and the biological relevance of the selected microorganisms. Materials for this work can be found at https://github.com/frodbej/madmism.}
}
@article{TIWARI2026114502,
title = {Spatial multicriteria sorting with intuitionistic fuzzy entropy for the hospitality sector},
journal = {Applied Soft Computing},
volume = {189},
pages = {114502},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114502},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018150},
author = {Ashutosh Tiwari and Anuma Garg and Q.M.Danish Lohani},
keywords = {Intuitionistic fuzzy set (IFS), Distance measure, MCS, TOPSIS, GRA, Hospitality sector},
abstract = {Developing strategies for the hospitality sector during periods of disruption presents significant challenges, particularly due to the uncertainties involved. This study adopts an intuitionistic fuzzy set-based framework to address such uncertainties effectively. Two multiple criteria sorting methods are introduced: Spatial Intuitionistic Fuzzy Grey Relational Analysis (SIF-GRA) sorting and Intuitionistic Fuzzy-Entropy based Hybrid-TOPSISGRA sorting (IFE-TORA). A novel multivalued distance measure, termed the spatial distance measure (SDM), which leverages the divided difference operator of double sequences, is proposed and applied to develop the SIF-GRA method as a multivalued decision-making approach. The IFE-TORA method integrates GRA and TOPSIS with the proposed entropy measure within an intuitionistic fuzzy environment to enhance decision-making capabilities. The experimental analysis highlights the strengths of these methods, particularly in the context of partitioning outcomes for effective sorting in multiple criteria decision-making. The SIF-GRA method and IFE-TORA method emphasize partitioning the outcomes for effective sorting in a multiple criteria decision-making context. A case study from the restaurant industry in Central Philippines during the COVID-19 pandemic demonstrates the practical application of these methods. The results show that the SIF-GRA and IFE-TORA methods offer reliable partitioning solutions. The case study further validates the practical utility of the methods, particularly in aiding hospitality and public health stakeholders in strategically planning, designing, and executing recovery measures, and provides a comprehensive framework for decision-making in uncertain environments. Additionally, the work includes a comparative analysis of different distance based MCS methods, utilizing with the help of a similarity ratio metric as a part of sensitivity analysis to highlight the impact of the proposed sorting methods on decision outcomes and reinforcing their robustness.}
}
@article{HU2026114425,
title = {Constrained reinforcement learning framework for investor preference analysis with online convex optimization},
journal = {Applied Soft Computing},
volume = {189},
pages = {114425},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114425},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017387},
author = {Xiao Hu and Siqin Kang and Long Ren and Jingshen Zhao and Shaokeng Zhu},
keywords = {Recommender systems, Explainable recommendations, Constrained bandits, Preference analysis, Decision support, Robo-advisors, Fintech},
abstract = {Robo-advisors have gained prominence in wealth management, yet often struggle to deliver sufficiently personalized, transparent, and well-diversified recommendations aligned with investors’ risk preferences. This paper introduces a novel reinforcement learning framework integrated with online convex optimization and decision analysis to generate adaptive and tailored investment advice. By formulating investor–advisor interactions as a contextual multi-armed bandit problem, our approach dynamically adapts to evolving investor preferences. It uniquely handles concave objective functions reflecting risk preferences under convex constraints that enforce diversification and compliance. Compared to existing constrained recommendation algorithms, our method offers enhanced flexibility in constraint design and improves explainability. Empirical evaluation using real-world datasets demonstrates that the proposed framework outperforms state-of-the-art methods in both efficiency and effectiveness.}
}
@article{FAN2026114453,
title = {TRED: Exponential feature decomposition three-channel networks for multivariate time series forecasting},
journal = {Applied Soft Computing},
volume = {189},
pages = {114453},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114453},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017661},
author = {Shiming Fan and Hua Wang and Fan Zhang},
keywords = {Time series feature decomposition, Multivariate time series forecasting(MTSF), Channel-dependent methods},
abstract = {Time series forecasting has a wide range of applications in energy, transportation, finance and other fields. However, achieving high-precision forecasting still faces many challenges, which are mainly due to the following two aspects: firstly, real-world time series usually exhibit heterogeneous temporal patterns, leading to dynamic changes in data distribution over time; secondly, the correlations between channels are complex and highly interwoven, making it difficult to accurately model the interactions between variables. Traditional methods rely on positional coding to preserve temporal information, but this often results in the loss of temporal patterns. In addition, models based on the point-by-point self-attention mechanism do not perform well in capturing the complex cross-correlations among variables. To this end, we propose a generalized time series forecasting model, TRED, in which we design a three-channel architecture to model trends, inter-sequence and intra-sequence features, and all the channels are based on multilayer perceptrons, which effectively avoids the quadratic time complexity brought by the attention mechanism. Second, inspired by the exponential smoothing method, we propose a module different from the original decomposition, namely, the exponential feature decomposition (EFD) module, which can decompose the basic components of a time series more clearly by decomposing the embedding vectors, and significantly improve the model’s ability to capture complex temporal patterns. We conduct extensive experiments on nine publicly available datasets, and the results show that TRED outperforms existing models in prediction under linear time complexity.}
}
@article{WU2026114493,
title = {Fixed-time adaptive composite fuzzy control via dynamic regressor extension and mixing},
journal = {Applied Soft Computing},
volume = {189},
pages = {114493},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114493},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501806X},
author = {Zhonghua Wu and Yahui Wang and Xiangwei Bu and Kuncheng Ma},
keywords = {Adaptive fuzzy control, Fuzzy logic systems, Dynamic regressor extension and mixing, Dynamic surface control, Composite learning},
abstract = {This paper addresses the problem of adaptive fuzzy fixed-time control for a class of uncertain nonlinear strict-feedback systems. Firstly, by utilizing the dynamic regressor extension and mixing (DREM) process along with the composite learning (CL) method, a novel weight estimation algorithm is proposed for approximating unknown functions in uncertain systems, which ensures that the elements in the weight vector can converge independently without requiring a strict persistent excitation (PE) condition. Moreover, an adaptive practical fixed-time control approach is proposed by incorporating a new segmented continuous filter and fixed-time stability theory. Note that the information of the weight error and a tracking error term is included in the weight update law, which directly improves the estimation performance and indirectly enhances the control accuracy. Theoretical analysis substantiates that the proposed control method guarantees the boundedness of all signals in the closed-loop system while ensuring that the tracking error approaches a compact neighborhood surrounding the origin within fixed-time. Finally, simulation results are presented to demonstrate both feasibility and effectiveness of the proposed method.}
}
@article{GAO2026114514,
title = {Secure information hiding: A scheme combining chaotic secret sharing and GAN-based encoding},
journal = {Applied Soft Computing},
volume = {189},
pages = {114514},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114514},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018277},
author = {Chang Gao and Chunlei Fan and Yuyao Luo},
keywords = {Secret information hiding, Generative adversarial network, Secret sharing scheme, Complex hyperchaotic system, Steganalysis},
abstract = {We propose a novel information hiding algorithm based on a secret sharing scheme and a generative adversarial network to overcome vulnerabilities in steganographic analysis during transmission. Chaotic sequences are generated by a constructed 2-dimensional complex hyperchaotic system. Chaotic sequence scrambling and Reed-Solomon coding are applied to enhance the robustness of the secret sharing scheme. Experiments demonstrate that the scheme has better robustness. Also, our approach makes the secret sharing scheme exhibit no pixel expansion and display a progressive recovery effect. Besides, the encoder-decoder network is comprised of a densely connected interlayer structure and SE-ResNet blocks. Perceptual loss is also incorporated into the loss function. Adversarial training between the encoder-decoder network and the discriminator is utilised to embed and extract secret information, and to generate stego images. The experimental results indicate that the proposed encoder-decoder network generates stego images with a PSNR of 40.79 dB and an extraction accuracy rate of up to 99.7 %. The network also achieves high security under StegExpose, SRNet, YeNet and ZhuNet steganalysis detection. Finally, the performance evaluation of the proposed information hiding algorithm shows that the algorithm generates stego images with a PSNR greater than 40 dB and can recover the secret image with BER=0.}
}
@article{GAO2026114542,
title = {A hybrid three-way decision-making framework for maritime vessel risk assessment using interval 2-tuple linguistic variables},
journal = {Applied Soft Computing},
volume = {189},
pages = {114542},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114542},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018551},
author = {Fei Gao},
keywords = {Vessel risk assessment, Decision-making, Three-way decision, Interval 2-tuple linguistic variables, TOPSIS method},
abstract = {In the domain of ocean engineering, the management of maritime traffic risk is a paramount challenge, characterized by high uncertainty and a reliance on subjective expert assessments. This study proposes a novel multi-criteria vessel risk assessment method that integrates interval 2-tuple linguistic variables with a three-way decision model. First, the conditional risk probability of each vessel is estimated using the interval 2-tuple TOPSIS method. Then, vessel-specific decision thresholds are derived from risk-based loss functions and a risk-avoidance coefficient. Finally, the estimated risk probabilities are compared with these thresholds to assign each vessel to one of three operational regions: inspection priority, standard processing, or deferred judgment. A practical case study is conducted to demonstrate the applicability of the proposed framework. The results show that the method effectively transforms imprecise expert evaluations into transparent and operationally meaningful decisions, while explicitly representing ambiguity through a boundary region. The proposed approach provides a flexible and context-sensitive tool for vessel risk classification in decision-critical maritime environments, offering a more rational and justifiable basis for allocating limited inspection resources.}
}
@article{LI2026114537,
title = {Multi-level reinforcement learning with agent-based simulation for dynamic concrete scheduling in high-speed railway construction},
journal = {Applied Soft Computing},
volume = {189},
pages = {114537},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114537},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018502},
author = {Huailong Li and Zhaojun Zhong and Ting Deng and Hao Li and Shusheng Yang and Yanjun Wang and Qing He},
keywords = {Agent-based modeling, Dynamic scheduling, Hierarchical reinforcement learning, Double Deep Q-Networks, Construction logistics},
abstract = {Efficient and adaptive scheduling of concrete production and transportation is vital for maintaining construction continuity in large-scale high-speed railway projects. However, fluctuating demands, constrained roads, and stochastic traffic conditions often cause delivery delays and cost escalation. This study proposes a hierarchical reinforcement learning framework integrating Agent-Based Modeling (ABM) with a dual-level Double Deep Q-Network (DDQN) for dynamic concrete scheduling. The high-level DDQN allocates resources between plants and sites, while the low-level DDQN optimizes real-time vehicle dispatching under ABM-simulated microscopic traffic conditions. The ABM reproduces realistic driving behaviors (acceleration, deceleration, overtaking, and head-on conflicts) providing high-fidelity environmental feedback. A hybrid initialization strategy accelerates convergence, a dynamic rescheduling mechanism enables online policy adaptation, and a two-layer feature extractor improves convergence stability and scalability under high-dimensional inputs. Experiments on a real high-speed railway project in Southwest China show that the proposed method reduces transportation costs by 22.5%, decreases average time deviation from 25.6% to 5.5%, and outperforms heuristic, evolutionary, and single-layer RL baselines in robustness and adaptability. Additional simulations under different plant-site configurations confirm its scalability and consistent performance. The main contributions are: (1) a scalable ABM-DDQN framework establishing closed-loop integration of simulation and decision optimization; (2) a dual-level RL structure improving interpretability and stability; (3) combined hybrid initialization and dynamic rescheduling enhancing adaptability; and (4) a feature extractor strengthening scalability and training stability. The method provides a practical and extensible solution for intelligent scheduling in dynamic, resource-constrained construction environments.}
}
@article{SOUZA2026114501,
title = {Tackling low-resource NER: Exploring model soup, domain adaptation, few-shot and zero-shot strategies},
journal = {Applied Soft Computing},
volume = {189},
pages = {114501},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114501},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018149},
author = {Maynara Souza and Monique Monteiro and Cleber Zanchettin},
keywords = {Named entity recognition (NER), Low-resource languages, Few-shot learning, Model soups},
abstract = {This work explores strategies to improve Named Entity Recognition (NER) in low-resource settings, focusing on the Portuguese language. We investigate domain adaptation and model soup techniques, showing that both can enhance NER performance, especially in specialized domains. We also assess the behavior of large language models (LLMs) in few-shot and zero-shot scenarios, finding that zero-shot setups often yield better results due to reduced overfitting. Additionally, we propose a novel method called Blinded Named Entity Recognition (Blinded-NER), which operates without predefined labels and maintains high precision in flexible settings. Our findings highlight the importance of model diversity, domain-awareness, and prompt calibration to advance robust NER solutions for underrepresented languages.}
}
@article{WANG2026114456,
title = {Multi-modal semantic representation learning for zero-shot indoor scene recognition},
journal = {Applied Soft Computing},
volume = {189},
pages = {114456},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114456},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017697},
author = {Chen Wang and Man Wang and Guohua Peng and Bernard {De Baets} and Xiong Pan},
keywords = {Multi-modal learning, Semantic representation learning, Zero-shot learning, Indoor scene recognition},
abstract = {Zero-shot indoor scene recognition has the ability to recognize new indoor images from an unseen scene class, which plays an important role in robot navigation and localization. However, different from traditional zero-shot object classification, expert-annotated semantic information is scarce for indoor scene images, which is crucial for zero-shot indoor scene recognition. For this reason, we propose a multi-modal semantic representation learning method (MMSRL). Specifically, benefiting from the powerful ability of the pre-trained BERT model, the word vector of an indoor scene class is first extracted as one modal semantic representation. Then, taking advantage of visual prototype learning, a visual-guided semantic feature learning method is proposed to extract another modal semantic representation. Subsequently, based on the self-attention mechanism, a shared-and-specific modality attention method is proposed to fuse the above two modal features, which helps to generate an effective multi-modal semantic representation. Finally, two encoder reconstruction loss functions are formulated to build the relation between the visual and the semantic features. In particular, considering the lack of label information in the testing phase, a revised visual-guided semantic feature learning method is devised to promote the zero-shot recognition performance. Comprehensive experimental results on three public indoor scene datasets demonstrate the effectiveness of the proposed method, achieving recognition accuracies of 61.91 %, 73.65 %, and 57.87 % on the MIT-67, SUN-300, and Scene-15 datasets, respectively.}
}
@article{SU2026114529,
title = {Individual parameterized transformer-based deep Q-network for efficient industrial 2d exact guillotine cutting scheduling},
journal = {Applied Soft Computing},
volume = {189},
pages = {114529},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114529},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018423},
author = {Jie-Ying Su and Yi-Feng Hung and Jia-Lin Kang and Shi-Shang Jang},
keywords = {Deep Reinforcement Learning, Transformer-Based Decision Making, Industrial Scheduling, 2D Guillotine Cutting Optimization, Dynamic Action Space},
abstract = {The Individual Parameterized Transformer-based Deep Q-Network (IP-TDQN) was proposed as a Reinforcement Learning (RL) framework for solving the industrial-scale two-dimensional exact guillotine Cutting Stock Problem (2D-CSP) instead of Mixed-Integer Linear Programming (MILP), have provided theoretically optimal solutions but suffer from inefficiencies in large-scale applications. To address these challenges, the IP-TDQN integrated individual parameterized action selection with Transformer-based feature extraction. This enables flexible handling of discrete-continuous hybrid action spaces while enhancing decision-making efficiency and adaptability. Pre-processing strategies, including pattern generation and legal pattern filtering, have reduced computational complexity, making large-scale implementation feasible. As a case study, IP-TDQN was applied to an industrial plant involving 23 slitting machines processing 250–300 stock bins per day. Results have shown that pre-training with Behavior Cloning (BC) accelerated convergence and improved model stability, optimizing resource utilization. The proposed IP-TDQN achieved a utilization rate of 0.886, successfully scheduling 110.9 bins within 29.1 s with zero unscheduled days. In comparison, the baseline MILP model achieved a utilization rate of 0.884, requiring approximately 1798 seconds (≈2 h) to schedule only 61.2 bins and resulting in 29 unscheduled days. The MILP-OPT solution, obtained after running for more than seven days with minimal further improvement, reached a slightly higher utilization rate (0.894) but at an impractical computational cost. These findings demonstrate that IP-TDQN achieves near-optimal performance with over two orders of magnitude faster computation, highlighting its practicality for real-time industrial scheduling. Furthermore, this study validated the generalization capability of IP-TDQN. Through 1000 simulation tests, the model maintained stable performance on unseen data distributions without requiring retraining, ensuring efficient scheduling. This breakthrough overcomes the extrapolation failures of traditional RL models, ensuring long-term adaptability across diverse industrial production scenarios. In summary, by integrating RL with Transformer architectures, IP-TDQN improves material utilization, boosts production efficiency, and lowers computational costs. It was a practical solution for complex industrial scheduling.}
}
@article{CHEN2026114484,
title = {A smart multi-objective differential evolution algorithm for energy-efficient scheduling in parallel batch processing machines},
journal = {Applied Soft Computing},
volume = {189},
pages = {114484},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114484},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017971},
author = {Yarong Chen and Hansen Su and Mudassar Rauf and Xue Zhao and Chen Wang},
keywords = {Batch processing, Parallel machines, Differential evolution, Multi-objective optimization, Energy efficiency, Scheduling},
abstract = {In the context of the pressing need for sustainable engineering practices and addressing environmental challenges, integrated energy-efficient production technologies have become essential for achieving carbon neutrality. This study leverages soft computing to investigate the parallel batch processing machine scheduling problem (PBPMSP) under complex constraints, encompassing heterogeneous job attributes (such as processing times, due dates, sizes, and arrival times) and limited machine capabilities. To effectively handle the multi-criteria decision-making inherent in this problem, we propose a smart multi-objective differential evolution algorithm based on decomposition (SMODE/D). This algorithm incorporates three improvements: (1) an adaptive smart learning-based strategy is designed to dynamically optimizes control parameters and mutation operators within the differential evolution framework, (2) hybrid heuristics that integrate domain knowledge to effectively coordinate batch formation and scheduling, (3) a tri-objective optimization framework based on decomposition to minimize three objectives concurrently: makespan, total earliness and tardiness, and overall energy consumption. The comparative experiments show that SMODE/D surpasses four leading algorithms (NSGA-II, NSGA-III, MODE/D, and MOABC) regarding its convergence, diversity, and robustness, achieving average improvements of 79.2 % in the diversity (inverted generational distance), 87.3 % in (non-dominated Rate), and 50.4 % in convergence (c-matrix). These findings provide valuable insights for balancing operational efficiency and energy savings, ultimately contributing to carbon footprint reduction in industrial manufacturing.}
}
@article{ZHOU2026114545,
title = {TDAFDNet: A trustworthy data-augmented network for few shot fault diagnosis and noise interference},
journal = {Applied Soft Computing},
volume = {189},
pages = {114545},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114545},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018587},
author = {Hanting Zhou and Wenhe Chen and Xinggang Luo and Min Xia},
keywords = {Trustworthy intelligent fault diagnosis, Uncertainty quantification, Few-shot learning, Data augmentation, Noise interference},
abstract = {The practical deployment of deep neural networks for intelligent fault diagnosis in industrial systems is often hindered by the scarcity of labeled fault data and distributional discrepancies between training and operational environments, especially under noisy conditions. To address these issues, this study proposes a trustworthy data-augmented fault diagnosis network (TDAFDNet) specifically designed for few-shot and noise-robust fault diagnosis. The framework integrates a multi-attention conditional variational autoencoder (MACVAE) to augment limited fault data, thereby enriching feature diversity and enhancing model generalization. A lightweight multi-channel depthwise separable residual network (MDS-ResNet) is introduced to achieve efficient and robust feature extraction. Furthermore, an adaptive attention-based risk-aware evidential loss function enables uncertainty-aware and risk-sensitive classification. To further improve interpretability and support risk-informed decision-making, a control chart-inspired uncertainty-based early warning mechanism is incorporated. Extensive experiments on benchmark rolling bearing datasets demonstrate that TDAFDNet outperforms existing state-of-the-art methods in diagnostic accuracy, noise robustness, and uncertainty estimation under data-scarce and noisy scenarios. These findings underscore the potential of the proposed approach for reliable and interpretable fault diagnosis in safety-critical engineering applications with limited and noisy labeled data.}
}
@article{TAM2026114234,
title = {Evolving routing and sequencing policies for dynamic vehicle routing problem with time windows},
journal = {Applied Soft Computing},
volume = {189},
pages = {114234},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114234},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625015479},
author = {Nguyen Thi Tam and Ngo Duy Anh and Dao Van Tung and Binh {Huynh Thi Thanh} and Le Trong Vinh},
keywords = {Genetic programming, Dynamic vehicle routing problem with time window},
abstract = {The Dynamic Vehicle Routing Problem with Time Windows (DVRPTW) is a complex extension of the Vehicle Routing Problem. It involves optimizing the routing and scheduling of vehicles to service customer demands that arrive dynamically over time rather than being known in advance. Each customer has a specific time window during which they must be serviced, adding a layer of complexity. The challenge is to assign routes and sequences for the fleet of vehicles while considering constraints such as vehicle capacity, service time, and dynamically changing requests. In this paper, we consider DVRPTW with two objectives: minimizing the total cost and maximizing the number of accepted requests. We propose the genetic programming algorithm to solve DVRPTW. Genetic programming hyper-heuristic algorithm (GPHH) involves routing and sequencing policies over successive generations, automatically discovering rules and heuristics that can efficiently handle the dynamic nature of DVRPTW. Our proposed algorithm adaptively develops these solutions, making them particularly well-suited for problems where real-time changes in demand occur. The experiments conducted on many instances proved the effectiveness of our proposed algorithm compared with the existing heuristic algorithms.}
}
@article{ELASRI2026114509,
title = {Sketch-to-tile translation using cGAN and U-Net with transformer bottleneck},
journal = {Applied Soft Computing},
volume = {189},
pages = {114509},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114509},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018228},
author = {Mohamed Elasri and Omar Elharrouss and Hamid Tairi and Somaya Al-Maadeed},
keywords = {Convolutional neural network, Image generation, Sketch2Tile dataset, Image-to-image translation, Transformers},
abstract = {The intricate geometric motifs of Moroccan zellij tiles require models that capture strict structural constraints, yet domain-specific datasets are scarce. We introduce Sketch2Tile, a paired dataset of >400 high-resolution (1024×1024) tile images and corresponding hand-drawn sketches, and S2TRGAN, a conditional GAN that couples a ResNet-Vision Transformer encoder with a U-Net decoder. S2TRGAN balances local detail and global coherence, improving sketch-to-tile translation in terms of FID and SSIM compared to Pix2Pix and Contextual-GAN on the Sketch2Tile benchmark. Cross-domain experiments on facial sketch datasets (FS2K, CUHK) demonstrate transferability, while the model’s measured complexity (33.4 GMac) supports rapid prototyping. Together, the dataset and baseline provide a resource and methodological foundation for structured generative modeling and AI-assisted preservation of cultural tile art. The dataset is made publicly available and can be downloaded using the following link: https://www.kaggle.com/datasets/zelligproject/moroccan-zellige}
}
@article{GONG2026114460,
title = {Joint position and appearance feature modeling for accurate visual tracking},
journal = {Applied Soft Computing},
volume = {189},
pages = {114460},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114460},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017739},
author = {Xiaomei Gong and Yi Zhang and Guanyu Xing and Yanli Liu},
keywords = {Object tracking, Historical cues modeling, Spatio-temporal features, Feature dropout strategy, Positional and appearance cues},
abstract = {In visual object tracking (VOT), accurate localization of the target objects relies largely on the exploration of temporal cues across frames. However, most existing methods focus on either the historical position or the appearance feature, ignoring their possible complementary integration. This limitation may lead to tracking drift under challenging conditions (e.g. similar objects or appearance variations). To address this issue, we propose a novel tracking framework (called DHCTrack) with a dual historical cues modeling scheme, which jointly encodes and integrates the historical position and appearance features of the target. To be specific, the position information is presented in the form of a binary mask, while the appearance features are encoded as a customized token. By embedding the positional and appearance cues into a shared feature space, DHCTrack learns their combined features via an attention-based feature interaction, and assigns higher weights to the more reliable cues. Extensive experiments on five public datasets demonstrate that the proposed DHCTrack achieves state-of-the-art performance, especially in scenarios with significant appearance changes and interferences.}
}
@article{CARVAJAL2026114483,
title = {Fractional fuzzy transform: Integrating fuzzy approximation and fractional calculus},
journal = {Applied Soft Computing},
volume = {189},
pages = {114483},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114483},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501796X},
author = {Cristian Carvajal and Ronald Manríquez},
keywords = {Fractional calculus, Fuzzy transforms, Time series forecasting, Nonlocal operators, Functional approximation},
abstract = {This paper introduces the Fractional Fuzzy Transform (FαF-Transform), an extension of the classical fuzzy transform that incorporates a fractional parameter α>0. This generalization enables the modeling of memory effects in complex systems by combining fuzzy logic’s capability to handle uncertainty with the nonlocal properties of fractional calculus. The continuous and discrete formulations of the FαF-Transform are formally developed, emphasizing properties such as linearity, boundedness, and error minimization. The parameter α introduces an adaptive weighting that amplifies or attenuates the influence of values near the boundaries of the interval, depending on its magnitude. The performance of the FαF-Transform is evaluated in the prediction of the chaotic Mackey–Glass time series. Numerical results show that this transform outperforms traditional methods, such as the Levenberg–Marquardt algorithm and neuro-fuzzy models, by achieving a lower mean squared error. The FαF-Transform emerges as a versatile tool for analyzing data with temporal dependencies, with potential applications in signal processing, dynamic system modeling, and data-driven forecasting.}
}
@article{AMMAR2026114495,
title = {Classical, Bayesian, and machine learning approaches for traffic intensity estimation in M/M/1 queues with balking},
journal = {Applied Soft Computing},
volume = {189},
pages = {114495},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114495},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018083},
author = {Sherif I. Ammar and Dhruba Das and Yousef F. {Al Harbi}},
keywords = {M/M/1 queue, Balking, Traffic intensity, Maximum likelihood estimation, Bayesian estimation, Machine learning, Robustness analysis},
abstract = {This article investigates the estimation of traffic intensity in a single-server Markovian queueing system with balking, employing classical, Bayesian, and machine learning approaches. The system assumes Poisson arrivals and exponentially distributed service times (M/M/1), where customers may balk based on queue length. Classical inference is performed using Maximum Likelihood Estimation (MLE), while Bayesian inference incorporates prior knowledge through suitable prior distributions to obtain posterior estimates. Additionally, machine learning algorithms such as linear regression, decision trees, random forests, and neural networks are employed to capture complex, non-linear relationships in the data. A comparative analysis of classical, Bayesian, and machine learning results highlights the strengths and limitations of each approach, particularly under varying levels of customer balking. Simulation experiments are conducted to assess the accuracy and reliability of the estimates under different parameter settings. The results demonstrate that both Bayesian inference and machine learning offer more reliable estimates compared to classical inference, with machine learning excelling in scenarios involving noisy data and complex queueing dynamics. A detailed comparison shows that Random Forest outperforms Bayesian methods in predictive accuracy and computational efficiency, while Bayesian methods provide advantages when incorporating prior knowledge. These findings provide actionable insights for optimizing service systems under uncertain conditions and highlight the potential of hybrid approaches combining Bayesian inference and machine learning.}
}
@article{LIN2026114511,
title = {Evolutionary multitasking for multi-objective feature selection in fish chemical analysis},
journal = {Applied Soft Computing},
volume = {189},
pages = {114511},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114511},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018241},
author = {Jiabin Lin and Qi Chen and Bing Xue and Jeremy S. Rooney and Mengjie Zhang and Kirill Lagutin and Andrew MacKenzie and Keith C. Gordon and Daniel P. Killeen},
keywords = {Cyber marine, Spectroscopy, Feature selection, Evolutionary computation, Multi-objective optimisation, Evolutionary multitasking},
abstract = {Rapidly determining the chemical composition of marine resources is essential for their optimal utilization. Spectroscopy data analysis combined with regression modelling provides an efficient way for estimating chemical properties. Feature selection enhances these models by identifying spectroscopic features relevant to chemical composition. However, most of the existing feature selection methods address the tasks for different chemical components independently, despite shared patterns among related tasks. The paper proposes a novel evolutionary multitasking-based feature selection method to simultaneously address multiple related feature selection tasks. The method integrates a task clustering method to group related tasks, a design method to find an effective uniform preprocessing pipeline for the related tasks, and a multi-objective EMT algorithm to optimize feature subsets jointly. Experiments on feature selection for a fish dataset consisting of 21 regression tasks show that the proposed framework significantly improves the regression performance by sharing knowledge across tasks.}
}
@article{JIANG2026114503,
title = {Transferable self-attention recurrent network for pedestrian trajectory prediction},
journal = {Applied Soft Computing},
volume = {189},
pages = {114503},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114503},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018162},
author = {Yi-Bo Jiang and Ke Zhou and Wei-Jie Chen},
keywords = {Pedestrian trajectory prediction, Domain adaptation, Attention mechanism, Feature alignment},
abstract = {Pedestrian trajectory prediction is a crucial task in intelligent transportation systems and autonomous driving, where accurate forecasting of future pedestrian movement directly impacts safety and decision-making. However, existing approaches often assume homogeneous pedestrian behavior across varied environments, thereby neglecting spatial and temporal heterogeneity as well as individual behavioral differences. To address these limitations, we propose a Transferable Self-Attentive Recurrent Network (TSARN) to enhance prediction accuracy in heterogeneous and cross-domain scenarios. TSARN integrates two main modules: the Domain Adaptive Feature Alignment Module (DAFAM) and the Temporal Recurrent Backbone (TRB). DAFAM leverages a social attention mechanism to dynamically capture pedestrian interactions and employs trajectory alignment to mitigate inconsistencies arising from domain shifts. Building upon these aligned features, the TRB utilizes a self-attentive recurrent neural network to model temporal dependencies, supporting the representation of long-term dynamics and complex motion patterns. The proposed framework enables TSARN to effectively capture the intricate relationships between local interactions and global spatio-temporal behaviors. Extensive experiments on the ETH, UCY, and SDD datasets demonstrate that TSARN achieves superior performance compared to baseline methods, validating its effectiveness in cross-domain pedestrian trajectory prediction.}
}
@article{XIE2026114454,
title = {MoBLS: A broad learning system with multi-objective optimization},
journal = {Applied Soft Computing},
volume = {189},
pages = {114454},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114454},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017673},
author = {Xuetao Xie and Jian Wang and Jiamin Li and Bin Yuan and Witold Pedrycz and Jacek Mańdziuk},
keywords = {Broad learning system, Multi-objective optimization, Strongly convex sparse, Population competition, Robust},
abstract = {Broad learning system (BLS) attracts extensive attention as an effective alternative to deep neural networks. However, the performance of BLS strongly depends on the proper weight selection. More importantly, the number of neurons has a significant impact on its performance. To address these issues, this paper proposes a broad learning system based on multi-objective optimization (MoBLS). In MoBLS, the optimization objectives include the approximation degree of the model and the sparsity of the weights. Thanks to the strongly convex sparse operator, the weights of the model are effectively sparsified. In addition, the application of a population competition algorithm that combines the global and winner information leads to powerful approximation capabilities. When encountering different numbers of neurons, the experimental results show that the generalization performance of the MoBLS model statistically outperforms the classic BLS model and its state-of-the-art variants.}
}
@article{ZHOU2026114491,
title = {Bug report severity prediction based on text embedding via graph transformer},
journal = {Applied Soft Computing},
volume = {189},
pages = {114491},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114491},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018046},
author = {Ao Zhou and Guangliang Liu and Jinjin Mei},
keywords = {Bug report severity prediction, Graph transformation, Text embedding, Software maintenance, Natural language processing},
abstract = {In software maintenance processes, bugs are an inevitable part of the process, and bug report severity classification is critical for optimizing repair prioritization. However, traditional manual classification methods suffer from inefficiency and subjectivity. While existing automated approaches based on machine learning have made progress, they still face challenges such as heavy reliance on feature engineering and difficulty in effectively integrating global semantic features with topological relationships. To tackle these constraints, we propose a novel method of bug severity prediction by using text embedding and graph transformer (BSPTEGT), which combines textual semantic understanding and graph structure modeling capabilities to provide a comprehensive analysis of bug reports. First, we preprocess collected bug reports using natural language processing techniques and generate high-dimensional embeddings for bug report summaries and descriptions via pre-trained text embedding models. Subsequently, a semantic correlation graph is constructed among bug reports based on their similarity measures. Finally, a graph transformer model architecture is designed to aggregate node features through multi-head attention mechanisms. Experiments conducted on datasets from six open-source projects demonstrate that our method significantly outperforms baseline models in metrics including F1-score, demonstrating its effectiveness in capturing high-dimensional textual representations and modeling graph structures. This research provides a novel solution for bug severity classification, effectively supporting development teams in resource allocation and decision optimization.}
}
@article{HUANG2026114543,
title = {Explainable reinforcement learning with adaptive feature selection for stock trading},
journal = {Applied Soft Computing},
volume = {189},
pages = {114543},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114543},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018563},
author = {Yuling Huang and Jin Yan and Xiaoping Lu and Liang Zhao},
keywords = {Explainable reinforcement learning, Adaptive TwinTRPO, Feature selection, Stock trading, Chinese A-share market},
abstract = {Despite the increasing use of deep reinforcement learning (DRL) in algorithmic trading, achieving robust and explainable performance in the non-stationary Chinese A-share market remains challenging. Traditional DRL models often rely on fixed policy update mechanisms, which struggle to adapt to fluctuating market volatility. This rigidity leads to poor convergence, generalization, and unstable performance, limiting their practical use in dynamic financial environments. Additionally, trading strategies should be more transparent for regulatory compliance and user trust, motivating a reinforcement learning framework with explicit, model-based explanations of feature contributions. To address these challenges, we propose a novel explainable reinforcement learning framework, termed Adaptive Twin Trust Region Policy Optimization (Adaptive TwinTRPO). The key innovation is a volatility-aware policy optimization mechanism integrated into the TwinTRPO algorithm, dynamically adjusting trust region constraints based on market volatility. This ensures stable learning and adaptability during market fluctuations. To enhance transparency and performance, we incorporate an explainable feature selection pipeline. This dual-channel approach uses Random Forest for global feature importance and SHapley Additive exPlanations (SHAP)-based XGBoost for local contributions, providing a compact and interpretable state representation that directly links the agent’s decisions to financially meaningful drivers. We also design a reward function based on the Sortino ratio to align the agent’s goals with the market’s downside risk. Extensive experiments on A-share stocks show that our framework significantly outperforms rule-based and DRL benchmarks. Notably, for stock 000063, our method achieves a cumulative return (CR) of 88.80%, surpassing the DQN-Vanilla baseline by 20.76%. Our work demonstrates that combining adaptive policy optimization with explainable feature engineering yields an explainable reinforcement learning framework for stock trading that delivers highly profitable, robust, and regulatory-compliant trading strategies. Code is available at: https://github.com/ttys0001/Adaptive-TwinTRPO.}
}
@article{ZHU2026114394,
title = {Tensor-based multigraph fusion for Alzheimer’s disease diagnosis},
journal = {Applied Soft Computing},
volume = {189},
pages = {114394},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114394},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017077},
author = {Yi Zhu and Dong Li and Sen Wang and Lu Xu and Chao Xi},
keywords = {Alzheimer’s disease, Tensor methods, Mild cognitive impairment, Hidden feature learning},
abstract = {Multi-modal neuroimaging data provide essential complementary insights for Alzheimer’s disease (AD) diagnosis. Current approaches frequently utilize nonorthogonal projections to map features into a hidden space, which can be compromised by redundancy. Moreover, traditional techniques rely on similarity graphs built from original features, which unfortunately may not retain sufficient discriminative information critical for accurate diagnosis. In response to these limitations, our study introduces a Tensor-based Multigraph Fusion (TMGF) model for AD diagnosis, which advances the integration of multi-modal neuroimaging data. We adopt an innovative approach that employs tensor Schatten p-norm to construct a consistency diagram, thereby capturing and leveraging the supplementary and high-order information from different modalities more effectively. Furthermore, our model adopts low-rank constraints to ensure robustness and improve diagnostic accuracy. We introduce an adaptive high-order similarity graph regularization for fusing multi-modal data. This approach enhances the representation of interactions between different modalities. Additionally, we employ an efficient iterative algorithm to solve the optimization problem. This ensures robustness and improves diagnostic accuracy in our model. A comprehensive set of experimental results confirms the efficacy of the proposed method, highlighting its potential over existing techniques in terms of both performance and reliability.}
}
@article{WANG2026114446,
title = {Fault location of distribution network with distributed generation based on the quantum ant colony algorithm},
journal = {Applied Soft Computing},
volume = {189},
pages = {114446},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114446},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017594},
author = {Baonan Wang and Xiaowan Yu and Zhongqin Bi and Weina Zhang and Zhe Liu and Dan Zhang},
keywords = {Distribution network fault location, Distributed generation, Quantum ant colony algorithm, Information self-correction method, Hierarchical positioning model},
abstract = {With the continuous expansion of the distribution network and the increasing integration of distributed generation (DG), fault location in such networks has become more complex and challenging. This paper aims to develop a fast, accurate, and robust fault location method suitable for DG-integrated distribution networks. For this purpose, we apply the quantum ant colony algorithm (QACA) for the first time and propose several key innovations. Firstly, a mathematical model is established to describe the fault location problem. To mitigate the adverse effects of information loss or distortion, an information self-correction method is introduced. Secondly, a hierarchical positioning model with verification is proposed to reduce solution space and improve convergence speed. Furthermore, the quantum ant algorithm is enhanced by introducing an improved quantum rotation gate, dynamic adjustment of rotation angles, and a mutation mechanism to increase population diversity and avoid local optima. Simulation results on distribution networks of different scales demonstrate that the proposed Improved Quantum Ant Colony Algorithm (IQACA) achieves 100 % accuracy and fault tolerance, and reduces fault localization time by 56.21 % compared to traditional models. These findings confirm that the proposed approach offers superior effectiveness and robustness for distribution network fault location.}
}
@article{AAMANA2026114519,
title = {Reparameterized and regularized prompt learning based on feature attention for explainable recommendation system},
journal = {Applied Soft Computing},
volume = {189},
pages = {114519},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114519},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018320},
author = { Aamana and Naima Iltaf and Usman Zia and Zafran Khan},
keywords = {Explanation recommendation, Pre-trained transformer model, Prompt-tuning, Fine-tuning},
abstract = {Explanations for recommendations can help consumers understand the products offered, simplify the decision-making process, and build user trust. Natural language processing is a common method to achieve this; however, previous works have mostly used fine-tuning or discrete prompts to achieve their goals, leaving the potentially more effective and parameter-efficient soft prompt tuning of pre-trained transformer models underutilized. With regard to the recommendation system, the user/item identifier is inherently in an entirely distinct contextual domain from the words that were used to train pre-trained models. Consequently, it becomes critical to efficiently integrate IDs into such models. Moreover, current research either uses word embeddings to represent reviews or captures complex interactions between users and items through low-dimensional feature representations; however, these approaches fail to identify fine-grained interactions, resulting in generic, repetitive, and universal explanations that lack clarity. To address these issues, we propose a novel model, Reparameterized and Regularized Prompt Learning based on Enhanced Feature Attention (RRPLEF). The proposed model generates randomly initialized ID vectors of users and items through reparameterized residual prompt learning and also regularizes the explanation generation by the rating prediction task. By incorporating inner and outer feature attention enhancement into movie recommendation tasks, the proposed model generates corresponding latent vector representations while capturing the intrinsic attention among user reviews of items. This process contributes to generating explanations that exhibit greater precision and convey more informative insights. Extensive experiments are conducted, which involve fine-tuning and prompt-tuning the pre-trained model. The experimental outcomes demonstrate that the implementation of RRPLEF exhibits superior performance compared to robust foundational methods during the fine-tuning process. It achieves comparable performance as fine-tuning with a reduction of 87.3 % parameters. In addition to improving explanation quality, RRPLEF achieves substantial computational efficiency through parameter-efficient prompt tuning, leading to faster training and lower runtime overhead compared to fine-tuning baselines.}
}
@article{LIU2026114535,
title = {Volatility prediction of high-frequency data based on deep feature extraction and fusion: An interpretable deep learning architecture},
journal = {Applied Soft Computing},
volume = {189},
pages = {114535},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114535},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018484},
author = {Shixiu Liu and Mengrui Zhu and Minggang Wang and Lixin Tian},
keywords = {Volatility forecasting, Econometric volatility modeling, Network topology features, Dynamic gating feature fusion, Chinese crude oil futures market},
abstract = {Using a cross-domain technology integration strategy, a hybrid prediction architecture is developed for predicting high-frequency data volatility, with an emphasis on deep feature extraction and fusion. The architecture integrates front-end and back-end fusion. The front-end fusion breaks through the limitations of traditional single-category features, innovatively integrating econometric volatility prediction features with economic theory and network topology features reflecting market structure. Unlike fixed-weight fusion methods, the back-end design introduces a dynamic gating module that adjusts fusion weights according to the real-time importance of input features, improving adaptability to multi-source information. A dual-branch structure further enhances representation learning by unifying LSTM’s global temporal modeling with TSMixer’s local pattern extraction. Furthermore, the predictive outputs are linked with semi-parametric extreme value theory for risk measurement, and Shapley values are employed to assess feature contributions across forecast horizons. Focusing on high-frequency data from China’s crude oil futures market, the target model demonstrates substantial improvements in volatility forecasting and risk measurement. Relative to GARCH, HMSE decreases by 80.935 %, 80.645 %, and 80.568 % for 1-, 2-, and 5-step forecasts, and asymmetric loss (ALF) for risk measures declines by 38.819 %, 40.042 %, and 39.143 %. Compared to a standalone LSTM, the reductions in volatility forecasting are 18.462 %, 5.785 %, and 31.937 %, while the reductions in risk measurement are 4.561 %, 0.668 %, and 8.977 %. Interpretation results highlight the primary role of econometric predictors and the important contribution of network topology features, particularly for 5-step-ahead forecasts.}
}
@article{HE2026114554,
title = {Fourier augmented domain adaptation with soft pseudo-labelling for classifying time series},
journal = {Applied Soft Computing},
volume = {189},
pages = {114554},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114554},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626000025},
author = {Qi-Qiao He and Xueyuan Gong and Yain-Whar Si},
keywords = {Fourier, Domain adaptation, Soft pseudo-labeling, Time series data},
abstract = {Unsupervised Domain Adaptation (UDA) addresses the critical challenge of transferring knowledge from labeled source domains to unlabeled target domains, yet its application to time series data remains underexplored. Most existing time series UDA methods focus primarily on marginal distribution alignment, overlooking both low-level statistical discrepancies and conditional distribution shifts, which significantly degrade model performance on target domains. To bridge this gap, we propose Fourier Augmented Domain Adaptation with Soft Pseudo-Labeling (FADA-SPL), a novel framework that achieves comprehensive domain alignment through three synergistic components: (1) Fourier-based data augmentation that swaps high-frequency amplitude spectra between domains to align low-level statistics; (2) adversarial training with gradient reversal to learn domain-invariant features for marginal distribution alignment; and (3) parameter-free soft pseudo-labeling that generates probabilistic labels for target samples to minimize conditional distribution discrepancies. Extensive experiments on five public time series datasets demonstrate that FADA-SPL consistently outperforms eight state-of-the-art UDA methods, achieving significant improvements in F1-score of approximately 2%, 1%, 9%, 6%, and 9% over the strongest baselines, respectively. Code is available at https://github.com/sammulhe/FADA-SPL.}
}
@article{LONG2026114530,
title = {Multiple equipment scheduling and routing for container terminals using quantum-inspired deep learning},
journal = {Applied Soft Computing},
volume = {189},
pages = {114530},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114530},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018435},
author = {Le Ngoc Bao Long and Sam-Sang You and Hwan-Seong Kim and Truong Ngoc Cuong and Duy Anh Nguyen and Nguyen Duy Tan},
keywords = {Container terminals, Quay crane scheduling, Vehicle routing, Quantum optimization, Deep reinforcement learning},
abstract = {Quay cranes (QCs) and port vehicles, such as straddle carriers and yard trucks (YTs), are essential equipment for container handling at automated container terminals, and their scheduling issues strongly impact port efficiency and productivity. Optimization problems typically include QC assignment problems, QC scheduling problems, and vehicle routing problems. This study aimed to define an optimal sequence for the QCs to handle the containers from a vessel and then determine the shortest routing plan for the YTs to move those containers to the depots. A deep-learning-enhanced quantum optimization algorithm was proposed to optimize QC scheduling, whereas the shortest routes for YTs were determined using deep reinforcement learning. A hybrid metaheuristic filter was employed to explore quantum-approximated optimization. We implemented a deep learning algorithm to accelerate the development of quantum computing algorithms for solving complex optimization problems. The performance and robustness of the proposed method were demonstrated via numerical simulations of real-world scenarios. The results were validated using a real dataset from South Korea's Busan New Port (KRBNP), including specifications for real equipment (ship size, bay size, gantry speed, hoisting speed, etc.) and the layout configuration for 20-foot and 40-foot shipping containers. The number of tasks in the simulation is chosen as a scaled version of the actual handling of COSCO vessels (43 bays in total). The final results were statistically significant compared with a real dataset from UNCTAD and the World Bank Group, yielding improvements of 5.267 % and 2.588 % in QC productivity and utilization, respectively. This highlighted the practicality of different algorithms in managerial scenarios and underscored the approach to implementing highly promising variational quantum algorithms to solve optimal scheduling and routing problems for port equipment.}
}
@article{ZHANG2026114485,
title = {Continual relation extraction model based on memory sample selection and historical feature refinement},
journal = {Applied Soft Computing},
volume = {189},
pages = {114485},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114485},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017983},
author = {Zhanjun Zhang and Qian Wan and Shan Zhao and Mingrui Hao and Sijing Chen and Luona Wei},
keywords = {Relation extraction, Continual learning, Memory mechanism, Information extraction, Natural language processing},
abstract = {Traditional relation extraction model needs to integrate all historical data to train from scratch when dealing with unseen relation types. This approach is not only inefficient, but also comes with high storage and computing costs. Continual relation extraction reduces the dependence on historical training data and requires the model to retain the ability to recognize existing relations while constantly learning new ones. Previous works mitigate the catastrophic forgetting in continual relation extraction by establishing memory mechanisms, but most of it focuses on the independent modeling of relation prototypes, which fails to achieve an effective combination with the context and lacks the ability to select and learn from memory samples. This paper proposes a continual relation extraction model based on memory sample selection and historical feature refinement (CREMH). This model designs a backbone network based on graph topology. Benefiting from fine-grained data feature extraction and aggregation, the sample learning ability is improved. We propose a typical sample selection algorithm to filter isolated sample clusters and discrete sample points through iterative clustering. This algorithm improves the quality of the samples while reducing memory space. Furthermore, a historical feature refinement module based on a self-attention mechanism is designed to construct effective historical data representation, which effectively combines historical features with the current text. Experimental results demonstrate that the proposed method improves accuracy by 0.3 %–1.1 % over the optimal baseline on two public datasets, and significantly outperforms baselines in single-class performance.}
}
@article{CHOI2026114461,
title = {Machine learning-based detection method for malicious PDF files: A temporal classification approach},
journal = {Applied Soft Computing},
volume = {189},
pages = {114461},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114461},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017740},
author = {Doo-Seop Choi and Taeguen Kim and BooJoong Kang and Eul Gyu Im},
keywords = {PDF malware, Non-executable malware, Malware detection, Machine learning, Analysis of temporal feature evolution},
abstract = {Cybercriminals increasingly exploit non-executable files that can bypass antivirus software detection and are often opened by users without suspicion. In particular, PDF files have become a primary attack vector for adversaries due to their platform-independent nature and ability to preserve document components across different systems. Malicious PDF files continuously evolve to avoid detection, and traditional detection methods, which rely primarily on static features from older PDF datasets, show limitations in identifying evolving malicious PDF files. This paper identifies temporal evolution in feature distributions and proposes a novel framework to detect malicious PDF files by introducing temporal classification and addressing the evolved characteristics of recent threats. Through in-depth statistical analysis, we revealed that recent malicious PDF files closely mimic the structural characteristics of legitimate files, exhibiting an 11-fold increase in graphic components and a 21-fold increase in hyperlinks compared to older samples. This finding indicates a significant shift in attack methodologies from traditional script injection to social engineering techniques. To address this challenge, we enhanced the basic feature set, comprising 31 structural and metadata-based features initially defined in the CIC-Evasive-PDFMal2022 dataset, by integrating 12 newly identified features, resulting in an enhanced set of 43 features. Experimental results demonstrate that our framework with the enhanced feature set achieves 97.80 % detection accuracy using the random forest algorithm, representing a 4.12 % improvement over the basic feature set. The framework maintains balanced performance across all metrics with a recall of 0.96, a precision of 0.98, an F1-score of 0.97, and an AUC of 0.99. Additionally, the framework reduced the false positive rate (FPR) from 2.84 % to 1.12 %, a 1.72 percentage points reduction, which is critical for practical deployment in real-world security environments. The proposed enhanced feature set provides an effective approach for strengthening real-world detection systems, including email attachment scanners and antivirus engines, against evolving PDF-based attacks.}
}
@article{ABDOLLAHI2026114522,
title = {Evaluation of sustainable strategies for implementing blockchain technology in the solar energy supply chain under fuzzy ZE-numbers},
journal = {Applied Soft Computing},
volume = {189},
pages = {114522},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114522},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018356},
author = {Sana Abdollahi and Saeid Jafarzadeh Ghoushchi and Gholamreza Haseli},
keywords = {Renewable Energy, Solar Energy, Blockchain, Sustainability Supply Chain, Decision Support Model, Reliability, Fuzzy ZE-numbers},
abstract = {The accelerating transition toward renewable energy highlights the need for decision-support frameworks that can address uncertainty, heterogeneity, and governance challenges. This study introduces a hybrid methodology that integrates fuzzy ZE-numbers into the Basic Criteria Method (BCM) and applies the Double Normalization Multiple Aggregation (DNMA) model. The proposed ZE-BCM-DNMA framework captures expert subjectivity while ensuring robust and transparent evaluation of blockchain adoption strategies in Turkey’s solar energy sector. Empirical evidence was gathered through structured linguistic assessments from three national experts, modeled via fuzzy ZE logic. The analysis identifies Strategy A6, emphasizing government-led initiatives and collaboration with private actors, and Strategy A4, focused on adaptive energy management platforms, as the most effective solutions in terms of scalability, sustainability, and technical feasibility. Sensitivity analysis demonstrates ranking stability under diverse weighting scenarios, while comparative benchmarking confirms ZE-DNMA’s superiority over fuzzy TOPSIS and VIKOR. The framework advances theory by extending ZE-number applications in multi-criteria energy decision-making and practice by offering a transferable model for emerging economies. Policy implications highlight the importance of integrating blockchain-enabled transparency, cybersecurity, and environmental accountability into national renewable strategies. The study’s unique contribution lies in bridging methodological innovation with actionable insights, positioning blockchain as a viable enabler of decentralized, resilient, and sustainable solar energy ecosystems. Future research may expand the model to other renewable domains and incorporate dynamic weighting to reflect evolving technological and regulatory contexts.}
}
@article{EHSANI2026114457,
title = {Metaheuristic-optimized hybrid machine learning framework for rutting prediction in flexible pavements considering M&R activities},
journal = {Applied Soft Computing},
volume = {189},
pages = {114457},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114457},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017703},
author = {Mehrdad Ehsani and Fereidoon {Moghadas Nejad} and Pouria Hajikarimi},
keywords = {Rutting distress, Flexible pavements, Machine learning, Feature selection, Hybrid models},
abstract = {This study introduces a hybrid machine learning framework that integrates metaheuristic optimization and XGBoost for feature selection and hyperparameter tuning to predict rutting distress in flexible pavements. It also incorporates maintenance and rehabilitation (M&R) activities, an aspect often neglected in previous studies. To achieve this, data from the GPS-1 section of the Long-Term Pavement Performance (LTPP) program was utilized. A total of 120 input variables were considered, covering categories such as pavement age, M&R activities, traffic characteristics, climate conditions, and pavement structure. Two feature selection methods based on XGBoost were developed: one combined with NSGA II and the other with MOEA/D. These methods optimized XGBoost hyperparameters with Optuna while simultaneously identifying the most important features. Between them, XGBoost-NSGA II performed better by identifying 15 key input variables. Based on the selected features, three hybrid predictive models were developed, namely XGBoost-GA, XGBoost-WO, and XGBoost-GW. In addition, a baseline XGBoost model without hyperparameter tuning was created for comparison. The results indicated that the hybrid models outperformed the baseline model, with the XGBoost-GW model achieving the best performance, reaching R² values of 0.94 and 0.93 for the test and external validation datasets, respectively. The XGBoost–GW model achieves a 9 % improvement in R² compared to existing state-of-the-art models. SHAP analysis was conducted on the best-performing model, showing that the variables Age, Asphalt Concrete Overlay, and Mill Off AC and Overlay with AC had the greatest impact on the formation and progression of rutting distress.}
}
@article{ZHAO2026114518,
title = {A dual-population evolutionary algorithm with variable constraint guidance for constrained multi-objective optimization problems},
journal = {Applied Soft Computing},
volume = {189},
pages = {114518},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114518},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018319},
author = {Dongliang Zhao and Yiming Fang and Le Liu and Zhendong Liu},
keywords = {Constrained multi-objective optimization, Infeasible solutions, Variable constraint guidance, Stage switching},
abstract = {In solving constrained multi-objective optimization problems (CMOPs), the effective use of infeasible solutions is beneficial for improving the convergence and diversity of the algorithm. To improve the utilization of information on infeasible solutions, a dual-population evolutionary algorithm with variable constraint guidance (VCGDPEA) is proposed. There are two populations in VCGDPEA, where the first population (Pop1) mainly searches for the constrained Pareto front (CPF), and the second population (Pop2) guides the search direction of Pop1 using the information on infeasible solutions. Then, an adaptive stage switching strategy is designed based on the guidance situation of Pop2, and the constraint strength of Pop2 is adaptively adjusted according to different stages. Moreover, corresponding evolutionary strategies are designed based on various populations in different search tasks to improve the performance of exploration and exploitation. Finally, the comprehensive test results and analyses on 47 benchmark problems and 4 real-world CMOPs demonstrate that VCGDPEA exhibits better or more competitive performance, especially when the CMOPs have large infeasible solution regions.}
}
@article{FENG2026114452,
title = {A hybrid transformer network with residual-like connections for medical image segmentation},
journal = {Applied Soft Computing},
volume = {189},
pages = {114452},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114452},
url = {https://www.sciencedirect.com/science/article/pii/S156849462501765X},
author = {Yuncong Feng and Bo Sun and Xiaoli Zhang and Xiaotang Zhou and Guishen Wang and Huimin Lu},
keywords = {Medical image segmentation, U-shaped architecture, Mix-attention transformer, Residual-like connections},
abstract = {Medical image segmentation requires models to capture both long-range dependencies and fine spatial details. Convolutional neural networks (CNNs) often struggle with global context modeling, while Transformer-based models can incur high computational costs and may miss low-level features. To address these issues, we propose MAT-Unet, a novel U-shaped architecture that introduces two key components: 1) a Mix-Attention Transformer (MAT) module that jointly models local and global dependencies through a Local-Global Self-Attention mechanism and Multi-Head Self-Attention, enhancing contextual understanding while maintaining efficiency; 2) a Residual-like connections (ResPath) to strengthen semantic continuity and long-range information flow between encoder and decoder stages. Experiments on four public datasets demonstrate that MAT-Unet outperforms state-of-the-art CNN and Transformer models in segmentation accuracy. Our code is publicly available at https://github.com/CCUTBo/MAT-Unet.}
}
@article{JAROS2026114473,
title = {Automated recognition of worker activity using machine learning and multi-sensor fusion},
journal = {Applied Soft Computing},
volume = {189},
pages = {114473},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114473},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017867},
author = {Rene Jaros and Ojan {Majidzadeh Gorjani} and Katerina Barnova and Martin Lajdolf and Radek Martinek and Petr Bilik and Lukas Danys},
keywords = {Activity recognition, Artificial neural network, Classification, Industry 4.0, Machine learning, Wearable sensors},
abstract = {Activity recognition and worker safety are critical parts of future industrial environments. Consecutive transitions to massive automatization and reductions in workforce could lead to more focused monitoring of the remaining workers. Effective recognition often relies on a number of sensors, such as electromyography leads, accelerometers, magnetometers, or gyroscopes, with each method potentially impacting system cost. This study focuses on automatic worker activity recognition using multilayer perceptron and multi-sensor fusion. We present a testing methodology and analyze the influence of individual sensors on system accuracy. The experiment therefore aims to systematically quantify the trade-off between the type and number of sensors used and the resulting accuracy, with the goal of providing a quantified basis for designing future systems with an optimal price/performance ratio. The presented results demonstrate that different sensor fusion strategies lead to vastly different accuracies, ranging from 71 % to over 99 %. These early findings highlight the crucial role of optimal sensor selection in the design of cost-effective worker monitoring systems. The study demonstrated that using a combination of the accelerometer, magnetometer, gyroscope, and electromyography resulted in the highest test accuracy of 98.04 %. Among these, the gyroscope and electromyography contributed less significantly. When only the accelerometer, magnetometer, and gyroscope were used, the accuracy dropped by approximately 6 %.}
}
@article{HUANG2026114449,
title = {A dendrite net learning multi-objective artificial bee colony algorithm for UAV},
journal = {Applied Soft Computing},
volume = {189},
pages = {114449},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114449},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017624},
author = {Chen Huang and Yingjie Peng and Wu Deng},
keywords = {Multi-objective, Path Planning, Artificial Bee Colony, Dendrite Net, Differential Evolution},
abstract = {Aiming at the problems that the traditional artificial bee colony algorithm (ABC) is prone to fall into local optimum and has insufficient robustness in the trajectory planning of unmanned aerial vehicle(UAV), a novel ABC algorithm, DDMOABC, is proposed to solve the path planning problem of UAV. By comprehensively considering UAV performance and mission requirements, the UAV path planning is regarded as a multi-objective optimization problem satisfying the constraints. In this approach, firstly, the path planning problem is constructed as a multi-objective optimization problem with path length, path height, path security and path smoothness. And then, the dendrite logic network (DD) model is introduced to serve as a guiding mechanism to better search the complex search space. Based on the integration of dendrite logic network, DDMOABC not only enhances the exploration and development capability of traditional ABC algorithm, but also provides a more adaptive and efficient evolutionary mechanism. Meanwhile, an improved search strategy inspired by DE/rand/1 is incorporated into the search process. Finally, in order to verify the practicability of the DDMOABC algorithm, nine scenarios are given to test the DDMOABC method. The experimental results show that, compared with the corresponding experimental results of the multi-objective artificial bee colony algorithm (MOABC), the DDMOABC algorithm has a lower average cost. The average HV achieved by DDMOABC is approximately 39.1 % higher than that of MOABC. This indicates that DDMOABC demonstrates superior performance in trajectory planning and can plan more reasonable trajectories for UAV.}
}
@article{CHEN2026114465,
title = {Decomposition methods for linear dynamic systems: data decomposition and parameter vector decomposition},
journal = {Applied Soft Computing},
volume = {189},
pages = {114465},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114465},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017788},
author = {Jing Chen and Peng Xie and Guangyu Zhu and Yang Yi and Quanmin Zhu},
keywords = {Parameter estimation, Least squares, Data decomposition method, Parameter vector, Decomposition method, Elapsed time},
abstract = {For large-scale systems, the traditional least squares algorithm usually requires heavy computational effort. In this paper, two kinds of decomposition methods are developed that can efficiently identify larger-scale systems: one is a data decomposition method, and the other is a parameter vector decomposition method. The data decomposition method decomposes the collected data into several sets, and then estimates the parameters based on those sets of data; and the parameter vector decomposition method decomposes the high-order parameter vector into several low-order sub-vectors, and then updates those sub-vectors one by one. These two decomposition methods offer several advantages over the traditional algorithms: (1) the data decomposition method has shorter elapsed times than the LS algorithm; (2) the parameter vector decomposition method avoids high-order matrix inversion; (3) for systems with numerous collected data, the data decomposition algorithm yields smaller upper bounds on the estimation error variance. The effectiveness of the proposed algorithms is further substantiated through convergence analysis and simulation examples.}
}
@article{HONG2026114538,
title = {Three-way decision model based on population competition analysis},
journal = {Applied Soft Computing},
volume = {189},
pages = {114538},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114538},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625018514},
author = {Chengxin Hong and Qinghua Zhang and Nanfang Luo and Linji Yang and Fan Zhao and Man Gao and Longjun Yin},
keywords = {Three-way decision, Probabilistic rough sets, Population competition analysis, Competitive relationships},
abstract = {Probabilistic rough sets partition the universe into three disjoint regions: the positive, boundary, and negative regions, by introducing a threshold pair (α,β), and the rational setting of these thresholds is an important research topic, as (α,β) directly determines the error tolerance of the model. However, most existing thresholds setting methods often directly obtain the thresholds by relying on predefined parameters. Moreover, the current thresholds determination methods usually overlook object distribution characteristics and the correlations among the three regions, resulting in subjectivity of the model’s output. To this end, drawing on the concept of the population competition model to explore the competitive relationships among the three regions, a three-way decision model based on population competition analysis is proposed to effectively address the critical issue that threshold setting is disconnected from data characteristics in traditional methods. First, based on the thresholds of α=1 and β=0 in the probabilistic rough set, the natural growth model (Logistic growth model) is introduced, the processes of α gradually decreasing and β gradually increasing are regarded as the regional natural growth processes, and a natural growth model is constructed for the positive and negative regions. Second, a competitive rough set (CRS) model is proposed, the thresholds solving process is transformed into a regional competition process, and thus through the dynamic competitive evolution of the three regions, the (α,β) is identified. Third, the impact of key parameters in the CRS model on the final equilibrium state is analyzed. Finally, many experiments are conducted on the UCI and KEEL datasets to illustrate the effectiveness of the CRS model. This study provides a new perspective for three-way decision theory.}
}
@article{QIAN2026114481,
title = {Alzheimer’s disease recognition with a multi-scale feature fusion network based on embedding attention maps},
journal = {Applied Soft Computing},
volume = {189},
pages = {114481},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2025.114481},
url = {https://www.sciencedirect.com/science/article/pii/S1568494625017946},
author = {Qian Qian and Wenze Cao and Miao Song and Yong Feng and Yingna Li and Jiawen Pan},
keywords = {Attention mechanism, Deep learning, 3D CNN, Transformer, Multi-scale feature module, Alzheimer’s disease},
abstract = {In recent years, deep learning has been extensively used in the early diagnosis of Alzheimer’s disease (AD) due to its powerful capabilities in automatic feature extraction and feature representation. However, predominant methods typically rely on traditional convolutional neural networks (CNNs), which are limited by the local receptive fields of convolutional operations and struggle to preserve fine-grained pathological features during network propagation. To address these limitations, we propose a multi-scale feature fusion network (MFF-Net) based on embedded attention maps to aid in the diagnosis of AD. Firstly, a multi-scale fine-grained feature extraction block (MSEBlock) is proposed to enhance the model’s feature extraction capability by integrating local features at different spatial scales and fusing them with channel-level global information. Then, a novel feature pyramid network (FPN-EAM) is proposed based on the embedded attention maps to retain and fully utilize fine-grained pathological features, improving the fusion and utilization efficiency by emphasizing the correlation between features and focusing on more informative regions. Finally, a hybrid feature fusion classifier (HFFC) is proposed to generate prediction results using a multi-classifier approach. To validate the effectiveness of MFF-Net, it was evaluated on 3D structured magnetic resonance imaging (sMRI) samples from the ADNI and OASIS databases. The competitive results from standard experiments demonstrate the effectiveness of the proposed MFF-Net in AD-related classification tasks.}
}