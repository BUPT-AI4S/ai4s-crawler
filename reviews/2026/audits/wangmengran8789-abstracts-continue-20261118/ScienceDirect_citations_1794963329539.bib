@article{GUAN2026114787,
title = {Achelous++: Power-oriented multi-task panoptic waterway perception framework based on vision-radar fusion},
journal = {Applied Soft Computing},
volume = {192},
pages = {114787},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114787},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002358},
author = {Runwei Guan and Haocheng Zhao and Shanliang Yao and Limin Yu and Xiaohui Zhu and Ryan Wen Liu and Eng Gee Lim and Weiping Ding and Yutao Yue and Hui Xiong},
keywords = {Water-surface perception, Multi-task perception framework, Low-power model, Vision-radar fusion},
abstract = {Multi-task panoptic perception leveraging multi-sensor fusion is crucial for comprehensively understanding waterway environments, which enhances the robust monitoring and autonomous navigation of unmanned surface vessels. However, the fragmented design inherent in multi-modal and multi-task neural networks inevitably leads to decreased inference speed and increased energy consumption. Therefore, we focus on developing a low-power, lightweight multi-task panoptic perception framework with high liberty for development. In this paper, we propose an end-to-end framework named Achelous++, capable of executing five perception tasks concurrently with high speed and low power consumption, which include object detection, semantic segmentation, drivable-area segmentation, waterline segmentation, and radar point cloud semantic segmentation. Notably, we design an efficient vision-radar fusion module, termed Gating Adaptive Fusion (GAF), to enhance fusion-based perception tasks cost-effectively within a shared computational space. Moreover, we design a dynamic feature routing module called Edge-Context Weighting (ECW) for feature selection in multi-segmentation tasks. Building on this, we also design a series of metrics to evaluate the energy consumption of multi-task perception. Overall, our Achelous++ framework achieves state-of-the-art performance on WaterScenes benchmark. Specifically, the optimal model of Achelous++ framework outperforms other models by approximately 5% mAP and 7% mIoU in object detection and multiple semantic segmentation tasks, while maintaining over 20 FPS and power consumption under 20W on Orin. To the best of our knowledge, Achelous++ is the pioneering fusion-based framework for panoptic perception that integrates five perception tasks.}
}
@article{SHU2026114750,
title = {Symmetrization weighted binary cross-entropy: Modeling perceptual asymmetry for human-consistent neural edge detection},
journal = {Applied Soft Computing},
volume = {192},
pages = {114750},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114750},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001985},
author = {Hao Shu},
keywords = {Edge detection, Perceptual asymmetry, Symmetrization weighted binary cross-entropy (SWBCE), Loss function design, Neural vision systems},
abstract = {Edge detection (ED) is a fundamental perceptual process in computer vision, forming the structural basis for high-level reasoning tasks such as segmentation, recognition, and scene understanding. Despite substantial progress achieved by deep neural networks, most ED models attain high numerical accuracy but fail to produce visually sharp and perceptually consistent edges, thereby limiting their reliability in intelligent vision systems. To address this issue, this study introduces the Symmetrization Weighted Binary Cross-Entropy (SWBCE) loss, a perception-inspired formulation that extends the conventional WBCE by incorporating prediction-guided symmetry. SWBCE explicitly models the perceptual asymmetry in human edge recognition, wherein edge decisions require stronger evidence than non-edge ones, aligning the optimization process with human perceptual discrimination. The resulting symmetric learning mechanism jointly enhances edge recall and suppresses false positives, achieving a superior balance between quantitative accuracy and perceptual fidelity. Extensive experiments across multiple benchmark datasets and representative ED architectures demonstrate that SWBCE can outperform existing loss functions in both numerical evaluation and visual quality. Particularly with the HED-EES model, the SSIM can be improved by about 15% on BRIND, and in all experiments, training with SWBCE consistently obtains the best perceptual results. Beyond edge detection, the proposed perceptual loss offers a generalizable optimization principle for soft computing and neural learning systems, particularly in scenarios where asymmetric perceptual reasoning plays a critical role.}
}
@article{ANEES2026114734,
title = {Development of federated learning neural networks with combined horizontal and vertical data partitioning},
journal = {Applied Soft Computing},
volume = {192},
pages = {114734},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114734},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001821},
author = {Amir Anees and Matthew Field and Lois Holloway},
keywords = {Federated learning, Horizontally partitioned data, Vertically partitioned data, Privacy-preserving and inference attacks},
abstract = {Federated learning trains a global machine learning model without moving data that is distributed geographically, thereby preserving privacy. Most of the existing works focus on either horizontal- or vertical-federated learning. This paper proposes two new federated learning frameworks, addressing different dataset setups, for combined horizontal and vertical data-partitioned scenarios based on neural networks. The data is horizontally partitioned for a subset of clients, referred to as horizontal clients, and it is further vertically partitioned with another client, labelled as a vertical client. In the first proposed framework, referred to as ‘Horizontal-OutputFed’, the output feature is stored at clients with horizontal partitioning, while in the second proposed framework, referred to as ‘Vertical-OutputFed’, the output feature is stored at the vertical client. The accuracy, loss and convergence rate of the Horizontal-OutputFed are the same as those achieved with a horizontally partitioned federated learning framework. Furthermore, the impact of non-identically and independently distributed data is the same in both the Horizontal-OutputFed and purely horizontal federated learning setups for combined features. Compared to a centrally trained model, the globally trained model in the Vertical-OutputFed has the same performance metrics such as accuracy and convergence rate. Moreover, there is no effect of imbalanced data on the performance of the Vertical-OutputFed, contrary to some of the previous works on individual horizontal- or vertical-federated learning. Privacy attack analysis were conducted for active, passive, white-box, and black-box attacks demonstrating no risk of input and output feature leakage, nor any data inference from the resulting models or while sharing hidden layers’ outputs for either of the combined federated approaches.}
}
@article{ZU2026114774,
title = {KG-DBAT: Knowledge-guided dual-branch attention transformer with IoU-aware recalibration for environmental pollen detection},
journal = {Applied Soft Computing},
volume = {192},
pages = {114774},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114774},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600222X},
author = {Baokai Zu and Xu Li and Yafang Li and Jianqiang Li and Hongyuan Wang},
keywords = {Knowledge-guided, Dual-branch attention transformer, IoU-aware recalibration, Pollen detection, Environmental monitoring},
abstract = {Pollen detection is a critical task in environmental monitoring and public health management, especially in mitigating allergy-related health risks. This paper presents KG-DBAT, a knowledge-guided transformer-based object detection framework for pollen images. KG-DBAT explicitly models the uncertainty of detection scores by recalibrating classification confidence with predicted bounding-box Intersection over Union (IoU), thereby bridging the gap between classification confidence and localization accuracy and improving the reliability of pollen counting. Motivated by soft-computing principles for uncertainty handling, KG-DBAT makes weight-adaptive decisions through two components. First, a Dual-Branch Attention Decoder (DBA-Decoder) disentangles self-attention and cross-attention into two branches and integrates them through learnable fusion weights, enabling more effective feature interaction and localization under complex visual conditions with tiny, densely distributed pollen grains. Second, an IoU-aware recalibration strategy generates adaptive weights from the classification confidence and the predicted bounding-box quality of each query, and uses these weights to dynamically rescore the queries so that semantically correct but poorly localized detections are softly downweighted. To validate the proposed approach, we construct a dedicated pollen detection dataset and utilize the publicly available POLLEN20L-det dataset for a comprehensive evaluation. KG-DBAT achieves average precision (AP) scores of 79.3% and 81.3% on the respective datasets, surpassing the baseline DINO (Improved deNoising anchOr box) model by 1.4 percentage points and 1.3 percentage points, respectively. These results indicate that KG-DBAT improves the robustness and interpretability of pollen detection, and highlights the potential of incorporating domain knowledge and uncertainty-aware soft computing strategies into intelligent and sustainable environmental monitoring applications.}
}
@article{PAN2026114795,
title = {Optimal scheduling of integrated energy systems with power-to-hydrogen for flexible supply-demand balance via Q-learning-enhanced grey wolf optimizer},
journal = {Applied Soft Computing},
volume = {192},
pages = {114795},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114795},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002437},
author = {Kuiyuan Pan and Tianhe Sun and Xinfu Pang and Zedong Zheng and Haibo Li},
keywords = {Flexible supply-demand balance, Grey wolf optimizer, Integrated energy system, Power-to-hydrogen, Q-learning},
abstract = {The integrated energy system (IES) has garnered increasing attention as an effective means of optimizing the utilization of multiple energy sources. With the growing share of renewable energy, enhancing the flexibility of system operation has become a critical issue. This paper proposes an optimal scheduling model for IES that incorporates flexible supply-demand balance constraints. Firstly, a quantitative model for flexible resources is introduced, followed by the formulation of a flexible supply-demand balance constraint model. Secondly, focusing on minimizing operating costs, an optimal scheduling model for IES is developed, incorporating power-to-hydrogen (P2H) technology and considering the flexibility of supply-demand balance constraints. Finally, a grey wolf optimizer (GWO) based on Q-learning (Q-GWO) is designed to solve the optimal scheduling model. The Q-learning algorithm is used to dynamically adjust the search factor of the Q-GWO, thereby enhancing the algorithm's search capability. Simulation results under various scenarios demonstrate that the proposed optimization model significantly improves the flexibility and economy of system operation while reducing the wind curtailment rate. The superiority of the Q-GWO algorithm in solving this problem is confirmed by comparing its convergence performance with that of other algorithms.}
}
@article{CHEN2026114742,
title = {MSCNRNet: Non-dense residual network with multi-skip connection for image restoration},
journal = {Applied Soft Computing},
volume = {192},
pages = {114742},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114742},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001900},
author = {Yun Chen and Huanhuan Luo and Mengnan Shi and Xiaowen Ma and Hongtao Li and Qiang Yao},
keywords = {Image restoration, Image denoising, Image super-resolution, Machine vision, Residual dense network},
abstract = {In recent years, residual dense network(RDN)-based models have become increasingly popular in image restoration (IR) due to their enhanced feature propagation and ability to resist overfitting. However, these models still have limitations: 1) Their convolutional blocks rely on dense connections, leading to redundant local feature capture and repetitive features. 2) Each layer in the block is a single convolutional layer, limiting representational power and local feature extraction. 3) Basic connections between blocks hinder effective global feature fusion, resulting in reconstructed images lacking details. To address the limitations of RDN-based models, this paper proposes a novel IR model Non-dense Residual Network with Multi-skip Connection for Image Restoration (MSCNRNet). It replaces traditional dense connections in RDNs with multi-skip connections to form multi-skip connection non-dense residual blocks (MSCNRBs), reducing redundant features. Each MSCNRB comprises two multi-skip connection convolutional layers (MSCNRConv) to enhance local feature extraction, with a feature enhancement layer (FEL) added after each block for better global feature fusion. Based on extensive experiments across 12 synthetic and real-world datasets, our MSCNRNet model outperforms current state-of-the-art (SOTA) models in image restoration (IR) tasks by approximately 0.1% to 5% in the peak signal-to-noise ratio (PSNR) and around 2% in the structural similarity index measure (SSIM). This work provides an efficient solution to the limitations of existing RDN-based models, offering a more effective approach for high-quality IR tasks.}
}
@article{YANG2026114714,
title = {A differential evolutionary algorithm improvement framework based on artificial potential fields},
journal = {Applied Soft Computing},
volume = {192},
pages = {114714},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114714},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001626},
author = {Zhe Yang and Libao Deng and Xianxin Mao and Lili Zhang},
keywords = {Evolutionary computation, Artificial potential field, Differential evolution, Gradient, Adaptive parameter control, Optimization methods},
abstract = {The Artificial Potential Field (APF) method, widely utilized in path planning, uses virtual environmental forces derived from potential field gradients for guidance. While Differential Evolution (DE) algorithms are recognized for their simplicity and robust global optimization capabilities, they often suffer from premature convergence and reduced search efficiency in complex scenarios. Motivated by the similarity between APF pathfinding and DE optimization, this study proposes an APF-inspired framework that utilizes virtual forces to guide the population. Attractive forces guide individuals toward potential optima, while repulsive forces generated by treating inferior solutions as virtual obstacles mitigate the risk of stagnation. This mechanism effectively steers the population toward promising areas, thereby enhancing search efficiency. Furthermore, an integrated adaptive strategy enhances performance by dynamically adjusting key parameters based on problem characteristics. Comprehensive experiments on the CEC2020 benchmark suite and 36 real-world engineering problems validate the effectiveness of the framework. The results indicate performance improvements over baseline algorithms and competitiveness in comparative studies.}
}
@article{AMIN2026114738,
title = {A novel intuitionistic fuzzy OPARA-based multi-criteria decision-making framework for the evaluation of AI-enabled intelligent fault diagnosis systems},
journal = {Applied Soft Computing},
volume = {192},
pages = {114738},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114738},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001869},
author = {Munazza Amin and Muhammad Safdar Nazeer and Kifayat Ullah and Zeeshan Ali and Yilun Shang},
keywords = {Artificial intelligence, Fault diagnosis, Intuitionistic fuzzy sets, Multi-criteria decision-making, OPARA method},
abstract = {In intelligent fault diagnosis, an intelligent decision-making framework that is suitable to cope with uncertainty, vagueness, and conflict in the criterion should be adopted in AI-based diagnostic systems. These complications cannot be best captured through the traditional multi-criteria decision-making (MCDM) models, which compromise the reliability and accuracy of the models. In order to solve this issue, the paper will present a novel method, the intuitionistic fuzzy optimized pairwise ratio analysis (IF-OPARA), an effective method to reflect the contribution of expert opinions and performance ratings in terms of intuitionistic fuzzy numbers (IFNs). The integration allows a better depiction of uncertainty and gives a better view of the expert judgments during the process of the system-level assessment. Represented with a hypothetical case study centered on the evaluation and selection of AI-enabled fault diagnosis systems, three parameters of diagnostic accuracy, implementation cost and real-time adaptability, and three solutions, one of them being a model-based diagnosis, the other is a data-driven diagnosis, and the hybrid diagnosis, the proposed IF-OPARA framework gives the ranking score of A₂ = 0.452, A₁ = 0.312, and A₃ = 0.236, and the data-driven diagnosis is the most appropriate solution. The introduction of IF-OPARA indicates that the data-driven diagnosis takes first place on the list and, to a greater extent, can be characterized as a good compromise with the level of accuracy, cost, and flexibility. In addition, a comparison of IF-OPARA with other existing MCDM methods reveals that IF-OPARA is the strongest ranking method, the ranking order does not change with the changes of the main parameters, which is the insensitivity of the ranking method to the changes in the key parameters and sensitivity to the changes of the criteria. The results prove that IF-OPARA can produce a computationally efficient, reliable, and adaptable decision-support framework to estimate AI-based intelligent fault diagnosis frameworks with good potential to be applied to real-life settings where uncertainty is one of the most important parameters.}
}
@article{WU2026114767,
title = {A Choquet integral-based optimization model for product ranking considering the reliability of evaluations},
journal = {Applied Soft Computing},
volume = {192},
pages = {114767},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114767},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002152},
author = {Xingli Wu and Huchang Liao},
keywords = {Product ranking, Multiple criteria decision-making, Online reviews, Reliability, Choquet integral},
abstract = {Online reviews provide valuable information about e-commerce product performance. Still, reviews for the same product can vary greatly, as consumers always leave reviews when they are very satisfied or dissatisfied. Existing studies predominantly estimated product performance through averaging consumer opinions in online reviews, neglecting the distributions of the reviews. This study proposes a multiple criteria decision-making method for product ranking, which can determine the performance range of each product. First, the reliability of evaluations, as a measure of the influence that individual evaluations have on the final result, is defined based on the level of certainty in individual evaluations and the extent to which these evaluations deviate from the opinions of other consumers. Then, a Choquet integral-based optimization model is established to estimate the best and worst performance values of a product, where the Choquet integral that considers the interactions among product attributes is taken as an aggregation function. An illustrative example is conducted to verify the proposed approach for product ranking, using data from TripAdvisor. The ranking model is valuable for risk-averse consumers who struggle with accepting a product with a significant number of highly negative reviews.}
}
@article{JIAO2026114791,
title = {An intelligent over-sampling framework with physics-driven guidance for noise robust imbalanced rolling bearing fault diagnosis},
journal = {Applied Soft Computing},
volume = {192},
pages = {114791},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114791},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002395},
author = {Weidong Jiao and Daxuan Lin and Zhilin Dong and Jianfeng Sun and Wanxiu Xu and Xiaohao Chen and Siyu Liu and Yonghua Jiang},
keywords = {Intelligent fault diagnosis, Over-sampling, Imbalanced data, Noise-robust, Physics-informed},
abstract = {Driven by advances in deep learning, intelligent fault diagnosis is widely deployed in predictive maintenance and reliability assurance for rotating machinery. However, these methodologies hinge on noiseless, balanced data—an ideal that rarely aligns with real-world engineering scenarios. To address this issue, a Physics-driven Feature Space Synthetic Minority Over-Sampling Technique (PFS-SMOTE) is introduced that augments minority-class samples in the feature space by incorporating physical prior knowledge, thereby improving the performance of intelligent fault-diagnosis models. Initially, a Neural Blind Deconvolution Mechanism (NBDM) is proposed, which utilizes adaptive fuzzy kernels optimized via complex frequency domain vectors to effectively extract fault impulse features. Next, we construct the Multi-Resolution Time-Frequency Convolution (MRTFConv) layer, utilizing Short-Time Fourier Transform-inspired kernels with adaptive Gaussian temporal envelopes and learnable oscillatory components for physically interpretable time-frequency representations. Building upon these innovations, a deep Siamese Network, integrating NBDM and MRTFConv, maps original data into a physically separable feature space, guided by a physics-informed loss function encompassing contrastive loss, time-frequency consistency loss, and fuzzy kernel consistency loss. Ultimately, PFS-SMOTE generates synthetic fault samples in this well-separated space, ensuring a balanced dataset. Experimental validation across two bearing datasets demonstrates that PFS-SMOTE achieves 100 % accuracy under an imbalance ratio (IR) of 1:10 and maintains 93 % accuracy at SNR= 0 dB. Even under extreme conditions with IR= 1:40 and SNR= 4 dB, the method still achieves an accuracy rate of 89.5 %.}
}
@article{MAHENDRA2026114775,
title = {A hybrid deep learning model based on vision transformer and convolutional neural networks for land use and land cover classification},
journal = {Applied Soft Computing},
volume = {192},
pages = {114775},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114775},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002231},
author = {H.N. Mahendra and V. Pushpalatha and S. Mallikarjunaswamy and S. {Rama Subramoniam}},
keywords = {Vision Transformers, Convolutional Neural Networks, Land Use and Land Cover, Scalable Image Token Transformer, Fusion Convolution Feed-Forward, Hierarchical Feature Selection},
abstract = {Land Use and Land Cover (LULC) classification is vital for environmental monitoring, urban planning, and resource management. While Convolutional Neural Networks (CNNs) excel at extracting local spatial features, their limited receptive field hinders global contextual understanding. Conversely, Vision Transformers (ViTs) capture long-range dependencies but struggle with local and multi-scale feature extraction. To address these challenges, we propose VCHNet, a hybrid ViT-CNN deep learning model designed to enhance LULC classification by leveraging the complementary strengths of both architectures. VCHNet introduces three novel modules: Scalable Image-to-Tokens Transformation (SITT) for improved multi-scale feature extraction, Fusion Convolution Feed-Forward (FCFF) to enhance local and hierarchical representations, and Hierarchical Feature Selection (HFS) for preserving both local and global contextual information. The proposed model is trained on LISS-III satellite imagery years 2012 and 2022 of Chamarajanagar taluk, Karnataka, a region with diverse land cover types. Further, classified results are used to carry out the change detection analysis of the region between 2012 and 2022. Experimental evaluations using the LISS-III 2012 and 2022 datasets demonstrate that VCHNet outperforms conventional ViT and CNN models. The basic ViT model achieved overall accuracies of 90.2 % and 90.7 % for the respective datasets. Incorporating SITT led to further accuracy enhancements, reaching 92.4 % and 92.9 %. The inclusion of FCFF further improved performance, with accuracies of 94.2 % and 94.8 %. The highest classification accuracy of 95.3 % and 95.7 % was achieved with the fully enhanced VCHNet model including SITT, FCFF, and HFS modules.}
}
@article{SROKA2026114799,
title = {Robustness and invariance of hybrid metaheuristics under objective function transformations},
journal = {Applied Soft Computing},
volume = {192},
pages = {114799},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114799},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002474},
author = {Grzegorz Sroka and Sławomir T. Wierzchoń},
keywords = {Global optimization, Population-based algorithms, Meta-heuristics, Hybridization, Invariance analysis, Statistical analysis},
abstract = {This paper evaluates the robustness and structural invariance of hybrid population-based metaheuristics under various objective space transformations. A light-weight plug-and-play hybridization operator is applied to nineteen state-of-the-art algorithms – including differential evolution, particle swarm optimization, and recent bio-inspired methods – without modifying their internal logic. Benchmarking on the CEC-2017 suite across four dimensions (10, 30, 50, 100) is performed under five transformation types: baseline, translation, scaling, rotation, and constant shift. Statistical comparisons based on Wilcoxon and Friedman tests, Bayesian dominance analysis, and convergence trajectory profiling consistently show that differential-based hybrids (e.g., hybrid improved multi-operator differential evolution, hybrid success-history adaptive differential evolution, hybrid double mutational salp swarm algorithm) maintain high accuracy, stability, and invariance across all tested deformations. In contrast, classical algorithms – especially particle swarm optimization- and Harris hawks optimization - based variants –exhibit significant performance degradation under non-separable or distorted landscapes. The findings confirm the superiority of adaptive, structurally resilient hybrids for real-world optimization tasks subject to domain-specific transformations. However, the evidence is based on deterministic, continuous, bound-constrained single-objective CEC-2017 functions. The experiments use a fixed budget and five predefined transformations. Therefore, the conclusions should be interpreted within this controlled setting and may not directly generalize to nonlinear constrained, noisy, dynamic, or multi-objective problems without dedicated protocols. To partially bridge to practice, we also include a constrained helical compression spring design case study evaluated with the same methodology.}
}
@article{WANG2026114783,
title = {Dynamic weight matching TEB local path planning improved by PSO for car-like robots},
journal = {Applied Soft Computing},
volume = {192},
pages = {114783},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114783},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002310},
author = {Yunlong Wang and Annan Tang and Wenfeng Li and Shaoke Wan and Rongcan Qiu and Xiaohu Li},
keywords = {Car-like robots, TEB local path planning, Particle swarm optimization, Dynamic weight matching, Trajectory smoothness},
abstract = {Local path planning for car-like robots often relies on the Timed Elastic Band (TEB) algorithm, yet conventional implementations suffer from two critical limitations: insufficient trajectory smoothness resulting in jerky motion and mechanical wear, and high sensitivity to weight parameters requiring laborious manual tuning that fails to generalize across diverse scenarios. To address these challenges, this paper proposes a novel framework that enhances TEB through explicit smoothness constraints while eliminating manual tuning via Particle Swarm Optimization (PSO). We first augment the TEB objective function with higher-order smoothness and jerk constraints to fundamentally improve trajectory quality and dynamic feasibility. Second, we introduce a systematic offline-online framework where PSO discovers optimal weight configurations across 150 representative training scenarios, each characterized by a three-dimensional feature vector capturing narrowness, turning complexity, and heading deviation. The discovered scenario-weight mappings are stored in a knowledge base enabling real-time weight retrieval through efficient similarity matching during online operation. Comprehensive evaluation across three progressively challenging test scenarios with 90 independent runs demonstrates statistically significant improvements: PSO-TEB achieves 34–38% execution time reduction, 39–53% acceleration smoothness improvement, and 100% success rate in dynamic environments compared to 0–20% for baseline methods. Real-world experiments on a car-like robotic platform validate practical viability with sub-millisecond online weight matching overhead. By shifting computational burden offline and enabling scenario-adaptive parameter adjustment, our approach enhances robustness and practical applicability of TEB for car-like robots in complex real-world conditions.}
}
@article{ZHAO2026114694,
title = {Triangle centroid search algorithm: A reliable optimization technique for modeling photovoltaic systems},
journal = {Applied Soft Computing},
volume = {192},
pages = {114694},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114694},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001420},
author = {Haonan Zhao and Jing Li},
keywords = {Photovoltaic modeling, Parameter identification, Triangle centroid search algorithm, Optimization and stability},
abstract = {The rapid global expansion of photovoltaic (PV) installations has heightened the importance of PV system design, control and monitoring. Precise parameter identification is critical for PV systems, yet existing metaheuristics often suffer from high variance and unstable convergence due to model complexity. To address this, we propose the triangle centroid search algorithm (TCSA), a novel geometry-inspired metaheuristic. TCSA dynamically constructs triangular subsystems and employs a fitness-weighted centroid to balance exploration and exploitation. By coordinating both internal and external learning strategies, the TCSA enhances convergence speed and enables the population to break free from local optima. Evaluations on single-, double- and triple-diode models demonstrate the superiority of TCSA. Notably, on the complex DDM and TDM, it reduces the root mean square error (RMSE) to 9.8248E-04 while achieving a remarkable standard deviation in the order of 10E-17. Furthermore, extensive assessments on the IEEE CEC2020 benchmark functions and real-world constrained optimization suites validate the algorithm’s scalability and its potential for general engineering tasks. These results confirm that TCSA provides a dynamic PV model optimization framework with high precision and stability.}
}
@article{YIN2026114755,
title = {Node importance identification method for urban rail transit networks based on improved mutual information considering inter-station cross-dependencies},
journal = {Applied Soft Computing},
volume = {192},
pages = {114755},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114755},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002036},
author = {Yanhui Yin and Guanghong Hu and Zhuo Huang and Jihui Chen and Wencheng Huang},
keywords = {Node importance identification, Urban rail transit networks, Improved mutual information, Inter-station cross-dependencies, Invulnerability analysis, Adjacent and second-tier adjacent nodes},
abstract = {Identifying and protecting the key nodes of urban rail transit networks (URTN) is crucial for the normal operation of rail transit. However, most of the previous studies mainly relied on a single topological structure or passenger flow to identify important nodes, ignoring the inter-station cross-dependencies among the stations. In this paper, an Improved Mutual Information (IMI) is introduced to identify the node importance of URTN considering inter-station cross-dependencies. IMI emphasizes that the influence of a node will spread to the adjacent nodes within the effective range, and the importance of a node is the result of the combined influence of the adjacent nodes within that range. The comparative numerical researches have been conducted, the effectiveness and reliability of the IMI algorithm are validated from three aspects: network connectivity, node importance evaluation, and statistical analysis. Furthermore, under random and intentional attacks, we utilize the relative size of the maximal connected subgraph (RSMCS) and the relative network efficiency (RNE) before and after nodes are attacked to study the invulnerability of undirected unweighted networks of URTN. Additionally, we utilize the weighted RSMCS and the weighted RNE to study the invulnerability of bi-directional weighted URTN networks. Finally, A case study is performed with the Chengdu URTN serving as the context, the results show that, the IMI is suitable for networks with strong inter-station cross-dependencies (especially URTN), and can identify nodes with low degree but crucial due to their high inter-station cross-dependencies. It has higher discrimination ability for nodes ranked lower, and can capture stations with lower node degree but closely related to other important stations or important routes. Finally, suggestions for improving the performance and invulnerability of URTN are proposed from four aspects including expanding the capacity of the station, strengthening the connection between urban bus network and URTN, protecting important stations and routes with strong inter-station cross-dependencies through IMI algorithm, improving operation plans and alleviating peak passenger flow pressure.}
}
@article{LIU2026114779,
title = {A Q-learning-based approach for solving a fuzzy home health care routing and scheduling problem with physical load of caregivers},
journal = {Applied Soft Computing},
volume = {192},
pages = {114779},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114779},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002279},
author = {Wenheng Liu and Mahjoub Dridi and Hongying Fei and Amir Hajjam {El Hassani} and Yong Shi},
keywords = {Home health care, Routing and scheduling problem, Fuzzy logic, Metaheuristic, Q-learning},
abstract = {Home health care routing and scheduling problem (HHCRSP) constitutes a classic combinatorial optimization problem (COP) in home health care (HHC) delivery systems. Considering the uncertain health conditions of patients and time-dependent traffic congestion in the urban area, this study investigates a real-life HHCRSP involving fuzzy service time and time-dependent travel time features. Notably, we introduce the novel consideration of caregiver physical load, which occurs when the caregivers have to carry the care equipment by taking the stairs. The studied HHCRSP particularly emphasizes load computation for synchronized visits, where cooperative caregiving enables physical load alleviation. The problem is formulated as a fuzzy mixed-integer programming model and is solved by a customized Q-learning-based algorithm. The algorithm employs large neighborhood search (LNS) to guide the exploration and variable neighborhood descent (VND) to intensify the search ability. The customized heuristics which take advantage of the problem’s features to enhance the algorithm’s search abilities are designed. Meanwhile, the removal, insertion and local search heuristics involved in the LNS and VND are selected by a Q-learning agent during the iterative process. The extensive experiments highlight the superior performance of the proposed algorithm. Sensitivity analyses highlight that the fuzzy model outperforms its deterministic counterpart in reliability and flexibility, with its key characteristics directly governing solution quality and computational cost. Finally, empirical results confirm the practical applicability of the proposed model and algorithm. These findings make significant theoretical contributions to the HHCRSP literature by introducing the critical dimension of caregiver’s physical load, while providing actionable implications for optimizing decision support systems in HHC operations. Furthermore, this study establishes a methodological framework for solving analogous COPs in urban logistics systems, with specific emphasis on last-mile delivery challenges associated with heavy-item (e.g., large furniture and appliances) transportation that entails significant physical load.}
}
@article{SHAO2026114763,
title = {Robust-SeaThru: A physics-guided underwater image restoration model with percentile-based backscatter estimation},
journal = {Applied Soft Computing},
volume = {192},
pages = {114763},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114763},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002115},
author = {Jinxin Shao and Haosu Zhang and Jianming Miao},
keywords = {Underwater image enhancement, Backscatter estimation, Percentile-interval estimator, GPU acceleration, Physics-based restoration},
abstract = {Physics-based underwater image restoration offers zero-shot generalization through rigorous model inversion but faces a critical bottleneck: statistical fragility in parameter estimation. Classical methods inherit extreme-value priors from atmospheric dehazing, exhibiting a breakdown point ϵ∗→0, which leads to systematic failures under artificial illumination and in scenes lacking dark reference objects—conditions ubiquitous in marine environments. This paper presents Robust-SeaThru, a physics-guided restoration framework that addresses this limitation through a statistically principled percentile-interval estimation strategy. Our approach achieves breakdown point ϵ∗=0.005, representing an 80-fold robustness improvement over darkest-pixel methods. We formulate parameter estimation as a regularized optimization problem with provable μ-strong convexity, guaranteeing global convergence on the discretized parameter space. Comprehensive GPU acceleration via memory-coalesced percentile computation and vectorized grid search achieves 98.9% computational reduction (234.61s → 2.38s per full-resolution image, O(n2/P) complexity where P=16,384 CUDA cores). Evaluation across seven benchmark datasets (911 images) demonstrates consistent performance improvements: 21.06 dB PSNR on UIEB-890 (5.24 dB gain over classical physics-based methods), 0.8887 SSIM, 11-fold quality enhancement under artificial lighting (SQUID: 6.042 vs. 0.549 UIQM), and 50% improvement in extreme turbidity (U45: 8.272 UIQM). The method maintains efficacy across diverse water conditions (coastal, deep-sea, harbor environments) without dataset-specific tuning, validating zero-shot generalization capabilities essential for autonomous marine systems. We release a complete open-source implementation providing the research community with a theoretically sound, computationally efficient foundation for robust underwater image restoration.}
}
@article{XU2026114780,
title = {Addressing cross-modal spectral-spatial misalignment: A two-stage causal contrastive framework for hyperspectral image super-resolution},
journal = {Applied Soft Computing},
volume = {192},
pages = {114780},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114780},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002280},
author = {Kai Xu and Yongyi Chen and Dong Liang and Guangling Lai},
keywords = {Contrastive learning, Deep image prior, Multispectral and hyperspectral image fusion, Super resolution},
abstract = {The core challenge of hyperspectral image super-resolution lies in spectral-spatial information inconsistency during hyperspectral and multispectral images fusion. Mainstream algorithms face key limitations: they fail to address complex degradations, often causing spurious associations. Additionally, the band equalization strategy dilutes the features of sensitive bands, making it difficult to resolve cross-modal spectral-spatial mismatches, even when contrastive learning machine or physical priors are incorporated. To overcome these issues, this paper proposes a two-stage causal contrastive framework, referred to as TCCF The first stage involves pretraining, where the core components are a degradation joint prior optimization module and a cross-modal pseudo-intervention causal constraint module. This phase is designed to unearth imaging degradation priors and eliminate spurious associations The second stage integrates spectral-spatial degradation guidance units into the bottleneck layer of the degradation joint prior optimization module. It utilizes the pretrained priors from the first stage to fit real degradation through physical constraints. A multi-instance adaptive spectral weighting module is introduced to strengthen sensitive band weights, overcoming band equalization limitations. Extensive experiments validate TCCF’s effectiveness quantitatively and visually. On public datasets, it outperforms the optimal contrastive method by 2.81 % in Peak Signal-to-Noise Ratio and 26.15 % in Spectral Angle Mapper reduction. On the PaviaC dataset, the PSNR reaches 43.721 dB, with the SAM as low as 0.901°. In the 8 × super-resolution scenario, the PSNR for all datasets remains above 40 dB, and the SAM is consistently below 1.4°, demonstrating stable scale adaptation capabilities.}
}
@article{LI2026114691,
title = {Multimodal adaptive subspace learning for Parkinson’s disease diagnosis and prediction},
journal = {Applied Soft Computing},
volume = {192},
pages = {114691},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114691},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001390},
author = {Jiaqiang Li and Yukang Lei and Zhenghua Guan and Peng Yang and Haojie Song and Jing Tian and Guojun Yao and Chunhua Liang and Tianfu Wang and Xiaohua Xiao and Haijun Lei and Baiying Lei},
keywords = {Flexible subspace learning, Parkinson’s disease diagnosis, Longitudinal data, Multimodal data, Clinical score regression},
abstract = {Parkinson’s disease (PD) is a neurodegenerative disease that is prevalent in the elderly population. At present, the diagnostic method for PD mainly relies on the clinical experience of doctors, which is limited by its locality and subjectivity. Clinical multimodal data can provide different perspectives to understand patients and can effectively improve the accuracy of diagnosis. However, noise interference, high-dimensional feature complexity and category imbalance in multimodal data challenge PD diagnosis. Therefore, to solve the above problems, we propose a multimodal flexible subspace learning framework for PD diagnosis and clinical score regression, which learns the key features from multimodal data. Specifically, first, we provide diversified information by fusing PD neuroimaging data(DTI and MRI) and genetic data. Secondly, the self-representation learning method is used to dynamically capture sample similarities, thereby effectively mining the category information between samples. Finally, the ℓ2,0 norm is used for dynamic feature selection, and the relevant features are enhanced by utilizing the similarity between features, while irrelevant and redundant features are excluded. In this way, the intrinsic structural properties of the data are learned, and then the classification and regression tasks are performed through Support Vector Machine(SVM). Our extensive experiments on the Parkinson’s Progression Markers Initiative (PPMI) dataset demonstrate that this algorithm significantly improves both PD classification(94.07% accuracy for PD vs. NC at baseline) and clinical score regression performance(1.10 Mean Absolute Error for GDS prediction at baseline).}
}
@article{SHU2026114760,
title = {Hierarchical attentive feature refinement network with cross-resolution detail preservation for medical image segmentation},
journal = {Applied Soft Computing},
volume = {192},
pages = {114760},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114760},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002085},
author = {Xin Shu and Anqi Shi and Xiaofang Guo and Yan Fan and Xin Zhang},
keywords = {Medical image segmentation, Dual-branch pooling fusion encoder, Fine detail retention, Cross-level information fusion},
abstract = {Deep learning technology, particularly hierarchical encoder-decoder architectures, is developing rapidly in medical image segmentation, which aids in precise identification, localization, and quantification of anatomical structures and diseased areas in clinical diagnosis. However, most of the existing models face two critical challenges: (1) hierarchical semantic gaps caused by inconsistent receptive adaptation across different network depths; (2) gradual loss of fine details in traditional multi-scale fusion schemes, which disproportionately affects small-scale pathological features. Therefore, this paper proposes a Hierarchical Attentive Feature Refinement Network with Cross-Resolution Detail Preservation (HAFRN-CDP) to tackle these problems. Firstly, a Dual-Branch Pooling Fusion Encoder (DPFE) structure is designed to capture features of different scales and types to effectively alleviate information loss in the encoder. Secondly, a Fine Detail Retention (FDR) module is proposed to emphasize the high-resolution features in the encoder head, perceiving features at different scales and semantic levels. Thirdly, a novel Convolution Block (CB), which is composed of a Multi-Scale Residual Aggregation (MSRA) module and a Bi-Branch Global Attention (BGA) module, is presented to reduce the interference of redundant information caused by multi-scale strategy. Finally, in the decoder part, this paper proposes a Cross-Level Feature Fusion (CLFF) module to recover the details and structure by fusing features at different stages and scales. Extensive comparative experiments are conducted on three biomedical image datasets, and the results demonstrate that our HAFRN-CDP exhibits competitive performance compared to the state-of-the-art, with mDice of 92.87 % on JSUAH-Cerebellum and 91.77 % on 2018DSB, while also maintaining high mPrecision of 85.42 % and mRecall of 95.77 % on BUSI (malignant), confirming both its accuracy and robustness across diverse biomedical segmentation tasks.}
}
@article{XU2026114733,
title = {The attention mechanism for intelligent text generation of traditional cultural symbols in artistic design},
journal = {Applied Soft Computing},
volume = {192},
pages = {114733},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114733},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600181X},
author = {Xi Xu and Da Guo},
keywords = {Attention mechanism, Traditional cultural symbols, Multimodal generation, Text generation, Artistic design},
abstract = {Amid the digital wave, how to leverage artificial intelligence technologies to accurately interpret and reconstruct traditional cultural symbols has become a key issue in the field of artistic design. Existing image caption generation methods can identify the visual features of objects. But they often fail to capture the inherent cultural spirit and symbolic meanings when dealing with cultural symbols with profound historical connotations and abstract metaphors. This results in generated texts that remain at the level of superficial visual descriptions, lacking cultural depth. In response to this semantic gap, this study proposes an intelligent text generation model integrated with a cross-modal attention mechanism. The model constructs a dual-stream encoding architecture based on the Visual Geometry Group 19 (VGG19) and Bidirectional Encoder Representations from Transformers (BERT). By introducing multi-head self-attention and cross-modal attention modules, it achieves dynamic alignment between visual regions and cultural semantics. Different from traditional methods, the model can actively retrieve key visual clues from images according to the generated textual context. It accurately describes the physical forms of symbols and effectively interprets the cultural implications behind them. Experimental results show that this model achieves scores of 0.42 and 1.31 on the Bilingual Evaluation Understudy-4 (BLEU-4) and Consensus-based Image Description Evaluation (CIDEr) metrics, respectively, significantly outperforming benchmark models. It provides a new paradigm with both accuracy and cultural expressiveness for the digital inheritance and innovative design of traditional cultural symbols.}
}
@article{WANG2026114697,
title = {A rate-distortion optimal evolutionary algorithm under the fixed bit-rate constraints for the JPEG quantization table optimization},
journal = {Applied Soft Computing},
volume = {192},
pages = {114697},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114697},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001456},
author = {Qijun Wang and Hongyan Wei and Ke Xu and Bo Du and Xingyi Zhang},
keywords = {JPEG, Quantization table, Co-evolutionary algorithm, Multi-objective optimization, Bit-rate constraints},
abstract = {JPEG has been widely utilized across diverse applications and devices for approximately 30 years, and it will continue to dominate the image ecosystem for an extended duration. Optimizing the quantization table in JPEG compression not only maintains compatibility with the JPEG standard but also enhances compression efficiency, which is crucial for image storage and transmission. Existing Evolutionary Algorithm (EA) based optimization of JPEG quantization tables primarily focuses on optimizing the luminance quantization tables, but the optimization cannot be tailored for specified bit-rates. To address this problem, this paper proposes a rate-distortion optimal evolutionary algorithm with fixed bit-rates for the JPEG quantization table optimization, which optimizes the quantization tables through a co-evolutionary algorithm with two populations: one with bit-rate constraints and the other without any constraints, adopting the rate-distortion optimal principle based population update and different environmental selection strategies for each population. The two populations are evolved simultaneously and cooperate with each other to achieve better optimization performance. Experimental results on classical benchmark datasets demonstrate that our method can achieve the better quantization tables than current state-of-the-art algorithms in both compression efficiency and image quality while more accurate target bit-rate for JPEG compression can also be achieved through our method.}
}
@article{CHEN2026114749,
title = {MTCCM: A multi-task conflict control model for Web API recommendation with semantic enhancement},
journal = {Applied Soft Computing},
volume = {192},
pages = {114749},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114749},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001973},
author = {Kezhou Chen and Hongbin Zhang and Zhengming Chen and Lianglun Cheng and Xu Lu},
keywords = {Mashup, Web API recommendation, Multi-task learning, Task conflict control, Semantic enhancement},
abstract = {With the rapid growth of web application programming interfaces (Web APIs), mashup development has emerged as a key paradigm that integrates existing APIs to meet the complex needs of various applications. The increasing number of Web APIs complicates selection and reduces development efficiency, while deep learning-based recommendation methods struggle with data sparsity and unstructured inputs. Multi-task learning (MTL) offers a promising solution by leveraging related tasks; however, many existing approaches fail to account for task conflicts, thereby limiting their effectiveness. We propose a multi-task conflict control model (MTCCM) for Web API recommendation to address these issues, integrating three synergistic modules. The semantic enhancement module (SEM) leverages a large language model with prompt-based inputs to structure unorganized mashups and Web API descriptions, enhancing semantic representation and mitigating issues with unstructured data. The conflict control module (CCM) operates in two stages: task conflict analysis identifies optimal auxiliary tasks, and gradient conflict control refines training by adjusting the direction of conflicting gradients. The neural network module (NNM) adopts a shared architecture with two task-specific outputs: one for Web API prediction and the other for Web API classification, which serves as an auxiliary task to improve the primary prediction performance. Extensive experiments demonstrate that MTCCM significantly outperforms state-of-the-art baselines, establishing a new benchmark in multi-task Web API recommendation.}
}
@article{YAN2026114794,
title = {Angle difference threshold graph induced complex network for data series analysis},
journal = {Applied Soft Computing},
volume = {192},
pages = {114794},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114794},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002425},
author = {Hui Yan and Fa Zhu and Wei Zheng},
keywords = {Angle difference threshold graph, Angle difference threshold, Connection rule, Network construction, Network features},
abstract = {The visibility graph (VG) provides a novel approach to analyze and process data series. However, the connection rule between series points in the VG algorithm is fixed and cannot be adjusted, which limits the ability of complex networks to characterize data series. To address this issue, this paper proposes the angle difference threshold graph (ADTG) by introducing the angle difference threshold (ADT) as an adjustable parameter. By tuning the ADT, a flexible connection rule for network construction is established, which enables the ADTG to characterize data series more effectively and allows the extraction of network features with higher discriminability. In addition, replacing the slope difference in the VG with the angle difference in the ADTG enables intuitive graphical presentation of the connection rule between series points. Experimental results demonstrate that compared with five VG family algorithms, the ADTG can achieve average improvements of 6.13 %, 6.17 %, 5.77 %, and 6.19 % in accuracy, precision, recall, and F1-score, respectively, for EEG signal classification, average improvements of 6.37 %, 5.84 %, 6.37 %, and 6.52 % across the four metrics for ECG signal classification, and average improvements of 8.70 %, 8.39 %, 8.65 %, and 8.77 % across the four metrics for study data classification. Three classification experiments indicate that the ADTG algorithm outperforms five VG family algorithms due to its adjustable parameter of ADT.}
}
@article{ALHASSAN2026114729,
title = {Histopathological breast cancer image classification using adaptive hunt optimization-based deep convolutional neural network},
journal = {Applied Soft Computing},
volume = {192},
pages = {114729},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114729},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001778},
author = {Afnan M. Alhassan},
keywords = {Deep Convolutional Neural Network, Federated Generative Adversarial Network, Adaptive hunt optimization, Histopathological Images, And Breast Cancer Classification},
abstract = {Breast Cancer is a serious disease and one of the most common cancers among women globally. However, survival rates are high with early diagnosis and comprehensive treatment. Though the diagnosis of Breast Cancer (BC) at an early stage boosts survivability, the classification of the tumor or cancer cells is intricate. The classification of tumors based on Histopathological images (HPIs) as benign or malignant paved the way for more effective and spontaneous treatment. Even though researchers developed numerous techniques for BC classification, they still struggle with limited resources, privacy preservation, high computation cost, overfitting issues, poor generalizability, and interpretability. To overcome these limitations, an Adaptive Hunt Optimization-based Deep Convolutional Neural Network (AHO-based Deep CNN) model is presented. The model incorporates the Deep CNN with the Adaptive Hunt optimization (AHO), which enhances the convergence rate while minimizing loss. The inclusion of a federated Generative Adversarial Network (GAN) based Segmentation process identifies and segments the tumor region, thereby facilitating more accurate BC classification while considering privacy concerns. More specifically, the proposed AHO-based Deep CNN is evaluated against other existing models based on multiple datasets to enhance the performance. Specifically, the proposed model demonstrated high performance on the BreakHis dataset, achieving an Accuracy of 94.25 %, a kappa of 0.91, a precision of 94.48 %, a Sensitivity of 96.71 %, and a Specificity of 83.06 in BC classification with 90 % of the data used for training. Overall, the central objective of this study is to develop a highly effective deep learning model for multiclass BC classification to improve the prognosis and survival rate of patients.}
}
@article{MIAO2026114716,
title = {Incorporating mixed-effects into Adaptive time relation multi-task learning with longitudinal data for Alzheimer’s disease progression prediction},
journal = {Applied Soft Computing},
volume = {192},
pages = {114716},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114716},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600164X},
author = {Linting Miao and Hongmei Chen and Biao Xiang and Zhong Yuan and Chuan Luo and Tianrui Li},
keywords = {Alzheimer’s disease, Disease prediction, Longitudinal data, Temporal relationship, Multi-task learning},
abstract = {Alzheimer’s disease (AD) is a slowly progressing neurodegenerative disorder and poses significant challenges for early diagnosis and longitudinal prognosis in the medical sector. Accurate prediction of cognitive decline is crucial for timely clinical intervention, disease monitoring, and treatment planning. Multi-task learning (MTL) has been extensively applied in AD prediction tasks, as it effectively captures shared patterns across multiple objectives and improves generalization. However, most existing MTL-based approaches focus on cross-sectional settings and lack the ability to explicitly model disease progression over time. To address this limitation, we propose a longitudinal multi-task learning framework that jointly models disease progression and adaptive temporal relationships using multi-timepoint neuroimaging data. The proposed method incorporates two task-specific projection matrices within a mixed-effects modeling framework to disentangle baseline-invariant representations from change-sensitive features, thereby capturing distinct patterns attributable to AD pathology and normal aging. Temporal relationships among tasks are learned directly from data via a task relationship matrix, while temporal asymmetry is enforced through directional regularization. Structured regularization is further introduced to enhance the sparsity and robustness of the learned model. The proposed framework is evaluated on real-world datasets from the Alzheimer’s Disease Neuroimaging Initiative (ADNI) using standard regression metrics, including root mean squared error (rMSE). Compared with the best-performing baselines, our model achieves an average rMSE reduction of approximately 6%–10% across three widely used cognitive measures at multiple time points, with improvements validated by statistical significance testing, indicating more accurate and reliable prediction of cognitive decline. Beyond predictive accuracy, the model also provides enhanced interpretability through brain-region-level visualization, which facilitates a clearer understanding of disease-related progression patterns and age-related effects, and supports clinical analysis and decision-making.}
}
@article{KHOT2026114737,
title = {Exploring barriers to metaverse-enabled healthcare 4.0 patient monitoring using interval-valued pythagorean fuzzy DEMATEL},
journal = {Applied Soft Computing},
volume = {192},
pages = {114737},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114737},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001857},
author = {Sachin B. Khot and Shweta S. Patil and Yu-Chen Hu and Juber M. Mulla},
keywords = {Metaverse in Healthcare, Healthcare 4.0, Patient Monitoring, Digital Twins, Immersive Technologies, Barriers to metaverse adoption, IVPF-DEMATEL},
abstract = {The merging of immersive technologies with real-time clinical data in healthcare 4.0 has significantly transformed patient monitoring and management in the metaverse. This study systematically reviewed the applications of metaverse technologies in healthcare. This study further advances the examination of the challenges of adopting metaverse-enabled healthcare systems using an Interval-Valued Pythagorean Fuzzy Decision-Making Trial and Evaluation Laboratory (IVPF-DEMATEL) framework. To evaluate the challenges, this study considered inputs based on evidence received from experts at a prominent healthcare institution in Western Maharashtra, India. A systematic literature review identified 12 critical challenges in the technical, regulatory, social, and economic domains. Expert-based IVPF-DEMATEL evaluations revealed that data security and privacy, infrastructure and interoperability, and regulatory compliance are the most prominent causative barriers. User experience, cultural acceptance, and sustainability concerns have emerged as downstream effects. The cause–and–effect analysis highlights the hierarchical structure of these barriers, demonstrating that addressing core technical and regulatory issues will generate positive ripple effects across user-centric and sociocultural dimensions. The findings provide actionable insights for policymakers, healthcare managers, and technology developers, underscoring the need for secure, interoperable, and ethically governed digital ecosystems to realize the metaverse’s transformative potential in healthcare. To enhance methodological robustness, inter-expert consistency analysis and sensitivity analysis using ±10 % variation in fuzzy membership bounds are conducted. The findings demonstrate that both the cause–and–effect classification and prominence rankings remain stable under moderate perturbations, confirming the reliability of the proposed framework. This study contributes to the growing body of Healthcare 4.0 research by offering empirical evidence from the Indian context and proposing strategic directions for the sustainable and equitable adoption of immersive patient care technologies.}
}
@article{XU2026114782,
title = {Enhanced direction-aware ant colony optimization for smooth mobile robot path planning in complex environments},
journal = {Applied Soft Computing},
volume = {192},
pages = {114782},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114782},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002309},
author = {Zimin Xu and Yanying Chen and Lin Lin and Jinyan Huang and Guoli Wang},
keywords = {Direction-aware ant colony optimization, Pheromone initialization, Path smoothness optimization, Mobile robot path planning, Heuristic function design},
abstract = {Global path planning is a core problem in mobile robotics, aiming to generate collision-free trajectories that are not only short but also smooth and suitable for real-world deployment. Although Ant Colony Optimization (ACO) has been widely applied due to its population-based global search capability, its standard formulation still suffers from inherent limitations in complex environments. Heuristic information solely based on distance to the goal, together with uniformly initialized pheromone trails, provides weak global directional guidance in the early search stage, leading to largely unguided exploration. Moreover, the conventional state transition rule does not explicitly penalize sharp direction changes, often producing zigzag paths with excessive turning, while homogeneous pheromone updating slows the emergence of high-quality solutions and delays convergence. To address these issues, this paper proposes a direction-aware ant colony optimization (DAACO) framework, which integrates four complementary mechanisms in a unified manner. Specifically, an enhanced heuristic function combines distance information with global and local directional consistency to strengthen goal-oriented guidance. A directional pheromone initialization mechanism embeds estimated path cost and directional alignment into the initial pheromone distribution to reduce early-stage randomness. A dynamic smooth state transition model incorporates an angle-based smoothing factor together with an adaptive pseudo-random selection scheme to promote path continuity. Finally, a heterogeneous pheromone update strategy differentiates reinforcement according to path quality and emphasizes elite solutions to improve convergence stability. Extensive simulations on simple, complex, and large-scale grid environments demonstrate that DAACO consistently outperforms the standard ACO and several state-of-the-art ACO variants. Compared with standard ACO, DAACO achieves average reductions of 5.02%–44.12% in path length, 43.75%–81.08% in the number of turns, and 86.07%–98.14% in convergence iterations across different scenarios, confirming its effectiveness and robustness for smooth mobile robot path planning in complex environments.}
}
@article{FILALI2026114790,
title = {Evolving explainable neural architectures: Dynamic behavioral-novelty weighting in multi-objective neuroevolution for multimodal spam detection},
journal = {Applied Soft Computing},
volume = {192},
pages = {114790},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114790},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002383},
author = {Adnane Filali and El Arbi {Abdellaoui Alaoui} and Mostafa Merras},
keywords = {Spam detection, NeuroEvolution of augmenting topologies (NEAT), Multi-objective optimization, Dynamic weighting, Neural architecture search, Explainable AI (XAI)},
abstract = {Spam detection is effectively a moving target: as spammers shift their strategies across images, voice calls, and text, static detection systems struggle to keep pace. Artificial neural architectures, though often accurate, frequently fail to strike a workable balance between performance, generalization, and behavioral novelty in such adversarial environments. In this paper, we introduce and analyze two multi-objective variants of NeuroEvolution of Augmenting Topologies: a static weighting approach (NEAT-stMO) and a dynamic version (NEAT-dyMO) that adaptively reallocates objective priorities during the evolutionary process. Both methods simultaneously optimize for accuracy, the generalization gap, and novelty while evolving the topology and hyperparameters of artificial neural networks. We benchmark these evolutionary strategies against a broad spectrum of baselines, ranging from Pareto-based and single-objective NEAT variants to conventional classifiers, MLP, SVM, and automated deep learning frameworks, including Vision Transformers, Auto-Keras, and Hyperband. Our evaluation spans three distinct modalities—image, voice, and imbalanced SMS data—using five-fold cross-validation to rigorously assess accuracy, F1-scores, AUC, and computational efficiency—time and RAM. Importantly, we integrate SHapley Additive exPlanations to deconstruct the “black box” of how hyperparameters drive performance. Empirical results place NEAT-dyMO consistently among the top performers; notably, it offers significant efficiency advantages over heavy Transformer models while surpassing static baselines. SHAP analysis further sheds light on the mechanism, exposing that NEAT-dyMO’s dynamic weighting successfully navigates the trade-off between exploration—driven by larger architectures and dropout—and exploitation—favored by small batch sizes. These findings, therefore, suggest that dynamically evolving ANNs provide a robust, adaptive, and interpretable alternative for real-world multimodal spam defense.}
}
@article{TRAN2026114798,
title = {Lightweight-oriented classification using distillation learning and spatial information from tabular data},
journal = {Applied Soft Computing},
volume = {192},
pages = {114798},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114798},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002462},
author = {Minh-Trieu Tran and Patrizio Pelliccione and Phuong T. Nguyen},
keywords = {Lightweight-oriented model, Distillation learning, Deep learning, Tabular data processing, Spatial information},
abstract = {Spatial information, along with deep learning approaches, plays a crucial role in classification tasks. However, tabular datasets do not inherently contain spatial information, so researchers often focus primarily on traditional machine learning algorithms or DNNs for simplicity. Thus, these methods cannot fully utilize all the information in tabular data because they are unable to mine spatial (2D) information. Additionally, while deep learning, particularly convolutional neural networks (CNNs), can handle spatial information effectively, it requires significant computational resources to achieve high performance. In this paper, we present a new method, named ESATTO (Efficient Synthetic Spatial Awareness for Tabular daTa classificatiOn), which uses distillation learning and is able to extract spatial features in an efficient way. The proposed model is 27 times smaller in size and has 50 times fewer parameters than standard models, making it highly efficient for resource-limited environments. This lightweight model is particularly beneficial to real-world applications, such as precision agriculture, where computational resources are constrained. The validation shows that our model outperforms in wine quality prediction and performs strongly on medical data, highlighting its versatility for various tasks. The code is available at https://github.com/tmtgssi/ESATTO.}
}
@article{XU2026114806,
title = {ProtoMark: A transfer prototype network with Markov-enhanced features for few-shot intrusion detection},
journal = {Applied Soft Computing},
volume = {192},
pages = {114806},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114806},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002541},
author = {Yixin Xu and Jingwen Wang and Yue Chen and Junfeng Wang and He Sun and Zhiyang Fang},
keywords = {Intrusion detection, Few-shot learning, Feature fusion, Transfer learning},
abstract = {With the increasing prevalence of targeted attacks against Local Area Networks (LANs), the demand for adaptive intrusion detection tailored to heterogeneous networks has become increasingly prominent. However, as penetration data from LANs is typically scarce due to its sensitivity, conventional data-driven approaches face significant limitations. To fill this gap, we propose ProtoMark, a highly transferable prototype network that incorporates Markovian traffic characteristics into feature representation, establishing an enhanced Transfer Prototype Network framework for effective intrusion detection. Specifically, the model fuses Markov features of traffic byte sequences with statistical features to generate new feature images, thereby enriching the learnable content of the model. ProtoMark combines fully connected neural networks and prototype networks to further enhance the model’s generalization ability to build a transferable prototype network model. The model achieves intrusion detection by constructing prototypes of different types of traffic and optimizing its transfer performance by fine-tuning the fully connected layer (FC) parameters. Experimental results show that ProtoMark performs superior network intrusion detection on the CICIDS2017 and CICDDoS2019 datasets, outperforming existing state-of-the-art methods. Under the 2-way 5-shot setting, the average accuracy of ProtoMark is 94.76% and 95.37% on the two datasets. Additionally, ablation studies further validate the effectiveness of Markov features and the significant contribution of the transfer layer to the model’s generalization ability.}
}
@article{YIN2026114757,
title = {Multi-objective adaptive large neighborhood search for multi-scenario robust co-scheduling of locks, berths and trucks},
journal = {Applied Soft Computing},
volume = {192},
pages = {114757},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114757},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600205X},
author = {Xichen Yin and Wei Wang and Hao Yu and Yue Song},
keywords = {Co-scheduling, Robust optimization, Multiple uncertainties, Multi-scenario, Changzhou lock},
abstract = {This study investigates the co-scheduling problem of locks, transfer berths, and trucks under multiple uncertainties, i.e., fluctuations in water level differences across dams, varied berth service efficiency, and uncertain truck speed. A multi-scenario robust optimization model is formulated to simultaneously minimize waiting time, service costs, and carbon emissions, and a multi-objective adaptive large neighborhood search (MO-ALNS) algorithm is developed to improve computational efficiency. A case study at the Changzhou Lock is conducted to evaluate the proposed approach, whose results show that the proposed MO-ALNS significantly outperforms NSGA-II, MOBBO, and DMOABC in terms of solution quality, convergence, and computational efficiency. Specifically, the proposed method achieves average improvements of 11.8 %, 8.76 %, and 12.48 % across the three objectives. The optimal solution of the robust model remains feasible across all 18 scenarios, whereas the nominal solutions become infeasible in 9 out of 18 scenarios, highlighting the essential role of robust optimization in ensuring scheduling feasibility. Furthermore, despite robust solutions incurring a time penalty of 21.1 %, 39.7 % reductions in both costs and carbon emissions can be achieved. Our findings also illustrate that the water level difference across the dam is the primary factor affecting feasibility, while berth efficiency and truck speed predominantly influence costs and carbon emissions.}
}
@article{LUO2026114778,
title = {Dual-path prompt-enhanced semi-supervised segmentation for retinal vessel quantification in OCTA imaging},
journal = {Applied Soft Computing},
volume = {192},
pages = {114778},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114778},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002267},
author = {Yuemei Luo and Yuan Li and Lei Tao and Jun Xu and Linbo Liu},
keywords = {Optical coherence tomography angiography, Semi-supervised learning, Retinal vessel segmentation, Segment anything model (SAM), Prompt-based segmentation},
abstract = {Retinal vascular analysis plays a vital role in the early detection and management of ocular diseases, which remain a significant global health challenge. Optical Coherence Tomography Angiography (OCTA) provides non-invasive, dye-free, high-resolution visualization of retinal microvasculature, yet accurate segmentation of vascular structures—particularly large vessels—remains difficult due to noise, depth variability, and the scarcity of annotated data. To address the need for efficient vessel segmentation under limited annotation, this paper proposes a semi-supervised learning framework based on a dual-path Segment Anything Model (SAM), tailored for large vessel segmentation in OCTA images. The framework incorporates the following innovations: (1) Dual-decoder collaborative training, which integrates prompt-based and prompt-free segmentation to improve generalization from minimal labeled data; (2) Cross-prompt strategy, which establishes bidirectional guidance between dual decoder branches using pseudo-prompt points derived from unlabeled data; and (3) Prompt consistency regularization, which enforces output stability under varying spatial prompts, mitigating the sensitivity of segmentation results to prompt locations. A hybrid point sampling scheme—combining center and random points—further improves prompt reliability. Evaluated on the OCTA-500 dataset using only 5% labeled samples, the proposed framework achieves Dice scores of 0.9134 and 0.8924 at 3 mm and 6 mm scan depths, respectively, surpassing existing semi-supervised methods. These results demonstrate the method’s effectiveness, robustness, and potential for scalable, annotation-efficient retinal image analysis in clinical practice.}
}
@article{TIAN2026114689,
title = {A novel graph neural network-based approach for android malware detection},
journal = {Applied Soft Computing},
volume = {192},
pages = {114689},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114689},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001377},
author = {Donghai Tian and Zhanyun Niu and Tao Leng and Jiaqing Jiang and Pengxuan Chen and Changzhen Hu and Chong Yuan and Ruilong Deng},
keywords = {Graph neural network, Android malware detection, Function call graph, Explainable machine learning},
abstract = {With the rapid development of the Internet of Things (IoT) and the Internet of Vehicles (IoV), smartphones have evolved into central hubs for connecting users with various smart devices, making their security increasingly vital. However, the growing prevalence of malicious mobile applications poses significant threats to user privacy and digital assets. Existing machine learning-based mobile malware detection methods often face limitations in terms of robustness and interpretability. To address these challenges, we propose GRED (GNN-based Robust and Explainable Malware Detection), an Android malware detection model that leverages graph neural networks to precisely identify malicious behavior while enhancing both robustness and interpretability. GRED refines Android function call graphs, extracts semantic and structural API features, and utilizes a Top-K-based GNN architecture for effective malware detection. Additionally, it offers multi-perspective interpretability analysis to support an in-depth understanding of detection results. Extensive experiments conducted on two large datasets demonstrate that GRED achieves superior performance compared to existing methods. The interpretability module effectively pinpoints malicious behaviors, thereby assisting security analysts in subsequent investigation and mitigation efforts.}
}
@article{CHEN2026114741,
title = {Adaptive multi-region multi-directional competitive swarm optimizer algorithm for large-scale multi-objective problems},
journal = {Applied Soft Computing},
volume = {192},
pages = {114741},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114741},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001894},
author = {Debao Chen and Yuanyuan Ge and Feng Zou and Fangzhen Ge and Lei Zhang},
keywords = {Large-scale multi-objective optimization, Adaptive reference vectors, Competitive swarm optimizer, Intelligent evolutionary computation, Wireless sensor networks},
abstract = {Competitive swarm optimization has shown impressive performance in addressing large-scale multi-objective optimization problems. However, its competitive mechanism can lead to contention among local optimal solutions within the current population. As the decision space grows more complex, the diversity of the population in competitive swarm optimization often decreases, resulting in “premature convergence”. To address this issue, we propose an adaptive multi-region multi-directional competitive swarm optimization algorithm, named AMRCSO. First, this algorithm introduces an adaptive reference-guided subregion division strategy that segments the objective space based on the population’s distribution, enhancing search diversity and coverage. Additionally, a multi-directional exploration strategy is employed to explore each subregion of the decision space, enabling parallel and multi-directional exploration that accelerates convergence to the global optimal solution. Furthermore, an effective population initialization and tri-stage updating strategy are implemented to improve population diversity and enhance convergence accuracy, respectively. Experimental results on large-scale multi-objective benchmark functions, ranging from 500 to 5000 decision variables, demonstrate that the AMRCSO algorithm achieves superior convergence accuracy and distribution compared to existing algorithms for large-scale multi-objective optimization problems.}
}
@article{ZHAO2026114762,
title = {Contextual information-focused deep learning network for urban road extraction from remote sensing data},
journal = {Applied Soft Computing},
volume = {192},
pages = {114762},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114762},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002103},
author = {Long Zhao and Yunran Wang and Jinling Zhao and Linsheng Huang and Dong Liang},
keywords = {Remote sensing images, Road extraction, Multi-scale aggregation, Self-attention Sobel operator, Graph convolution},
abstract = {Significant advancements have been made in the extraction of high-resolution remote sensing imagery for urban road detection using deep learning. However, the accuracy of this extraction is still subject to various limitations. First, substantial differences between roads lead to the loss of target contextual information due to standard convolution. Second, the lack of distinct differences between roads and their surrounding environments affects the network's judgment of road boundaries. Third, occluded parts of roads, such as those obscured by trees, are challenging to extract. The present study proposes a deep learning network based on the U-shaped Network (UNet) architecture. Specifically, a multi-scale aggregation module is employed to preserve target contextual information, and a self-attention segmentation module is integrated to reinforce boundary delineation and prevent overfitting between targets and contextual information. A graph convolutional module is ultimately employed for the purpose of global association integration. Specifically, the multi-scale aggregation module effectively integrates information from convolutional kernels of various scales and images of different scales. The graph convolutional module employs the Patch Merging approach to reduce the size of feature maps, thereby obtaining global association information. This approach significantly reduces computational load while ensuring accuracy. The self-attention segmentation module, based on the Sobel operator, strengthens the delineation between targets and their surrounding environments. The proposed modules collectively enhance the Intersection over Union (IoU), F1 score, and Precision by 6.9 %, 5.81 %, and 10.8 %, respectively, in the Massachusetts Roads Dataset. The model as a whole achieves a Mean IoU (MIoU) and F1 score of 76.161 %,73.08 %,76.760 %,76.88 % and 77.262 %,76.00 % in urban road datasets such as Massachusetts Roads Dataset, DeepGlobe Roads Dataset, and Self-Constructed Roads Dataset; in the complex mountainous roads of the Mountain Roads Dataset, the model achieves an MIoU and F1 score of 60.980 % and 41.73 %, respectively.}
}
@article{WANG2026114725,
title = {Hyper-heuristic enhanced teaching-learning-based optimization for energy-efficient hybrid flow shop scheduling with batch processing machines under time-of-use tariffs},
journal = {Applied Soft Computing},
volume = {192},
pages = {114725},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114725},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001730},
author = {Jing Wang and Jingsheng Lian and Lixin Cheng and Huan Xue and Hongdi Zhou and Debiao Li and Deming Lei and Xixing Li},
keywords = {Batch processing machines, Hybrid flow shop scheduling problem, Time-of-use tariffs, Teaching-learning-based optimization, Hyper-heuristic algorithm},
abstract = {In manufacturing sectors such as casting production, energy-efficient scheduling of batch processing machines (BPMs) under time-of-use (TOU) tariffs is critical for balancing production efficiency and energy costs. This study investigates the energy-efficient hybrid flow shop scheduling problem (EHFSP) with BPMs at a middle stage, stage precedence flexibility between adjacent stages, and TOU tariffs. A hyper-heuristic enhanced teaching-learning-based optimization (HTLBO) algorithm is proposed to simultaneously minimize makespan and total energy costs. The HTLBO integrates a dynamic class allocation strategy, a two-phase collaborative optimization mechanism, and a hyper-heuristic diversity maintenance operator. Specifically, teachers and students are dynamically classified into specialized classes based on their solution quality to enable personalized knowledge transfer. A two-phase optimization framework combines cross-class collaborative teaching for rapid convergence and elite-guided global exploration to enhance population diversity. Stagnant solutions are revitalized via a hyper-heuristic operator that employs adaptive low-level heuristics and a Metropolis criterion to escape local optima. Extensive experiments demonstrate that HTLBO outperforms state-of-the-art algorithms in solution quality and diversity, achieving up to 15% reduction in makespan and 22% savings in energy costs compared to industrial benchmarks. A real-world case study in a casting enterprise further validates its practical efficacy. The proposed methodology offers a robust solution for sustainable manufacturing under complex production constraints.}
}
@article{ZOU2026114786,
title = {Topic-aware influence maximization based on deep reinforcement learning and group relative optimization},
journal = {Applied Soft Computing},
volume = {192},
pages = {114786},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114786},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002346},
author = {Yingqi Zou and Guanyu Li and Yanhao Wang and Bo Ning and Shaohan Wang},
keywords = {Topic-aware influence maximization, Deep reinforcement learning, Group relative optimization, Graph neural networks, Social networks},
abstract = {Information diffusion on social networks is increasingly complex and diverse. Identifying suitable users to recommend and spread specific information is critical for social network analysis. The Topic-aware Influence Maximization (TIM) problem aims to identify a seed set that maximizes the influence spread under a given topic distribution. However, existing TIM methods suffer from severe computational inefficiencies. Meanwhile, current Deep Reinforcement Learning (DRL)-based methods mostly ignore the interplay between network structure and topic heterogeneity. To address these challenges, this paper proposes GR-TIM, an end-to-end DRL-based framework for TIM. GR-TIM first estimates the pre-global influence using Graph Neural Networks (GNNs). Then, a group relative optimization strategy partitions users based on topic and community structures. We further leverage intra-group collaboration to apply the global-local optimization paradigm to agent training and inter-group competition to achieve adaptive seed selection for the target topic. Experiments on six real-world datasets demonstrate that GR-TIM outperforms state-of-the-art DRL-based methods in terms of multi-topic influence spread and reduces runtime by two to three orders of magnitude compared to existing simulation-based methods.}
}
@article{CHOUDHARY2026114759,
title = {Dynamic pricing and demand management of PEV charging station using multi-agent deep deterministic policy gradient based charging coordination algorithm},
journal = {Applied Soft Computing},
volume = {192},
pages = {114759},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114759},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002073},
author = {Durgesh Choudhary and Rabindra Nath Mahanty and Niranjan Kumar},
keywords = {charging coordination, battery energy storage, plug-in electric vehicle, demand management, multi-agent deep deterministic policy gradient},
abstract = {In recent years, the power demand for charging Plug-in Electric Vehicles (PEVs) has increased. The random charging behaviour of PEVs makes this demand uncertain. A novel demand management and pricing strategy for PEV charging stations has been proposed in this paper. The proposed strategy employs coordinated control of PEVs to dynamically regulate the power demand of the PEV charging station and optimizes the cost of operation. The constraints of charging infrastructure and transformer constraints are considered in the strategy. The strategy analyses the economics of battery storage, renewable generation and charging stations to offer dynamic pricing for PEVs. The strategy employs a multi-agent deep deterministic policy gradient algorithm for coordinating the PEVs operations and battery storage. The strategy supports the grid in demand response by reducing the power demand of the charging station during peak. A case study proves the effectiveness of the proposed strategy. The proposed strategy reduces the charging cost by 21.14 %, increases the discharging cost by 20.44 % and increases the charging station profit by 63.14 %. It reduces the grid’s burden by 18.23 % and increases the serving capability of the charging station by 21.20 %.}
}
@article{FEDOROV2026114720,
title = {A MIP-informed machine learning method for the real time management of a multi-storage microgrid with renewable energy sources},
journal = {Applied Soft Computing},
volume = {192},
pages = {114720},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114720},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001687},
author = {Stanislav Fedorov and Anna Pinnarelli and Pasquale Vizza and Maria Elena Bruni},
keywords = {Real time, Microgrid management, Hydrogen, Machine learning, Decision tree},
abstract = {Complex microgrids with the inclusion of renewable energy sources and multiple energy storage systems based on batteries and hydrogen storage require fast, reliable, and adaptable management approaches to achieve profitability. Uncertainty in power generation and demand levels renders the application of typical optimization methodologies impossible in real-time management scenarios, due to slow response times and the risk of power imbalances. In this paper, we introduce a new machine learning based approach to the real-time management of complex microgrids under uncertainty. A decision tree classifier is trained on solved-to-optimality mixed-integer linear programming problem instances. Then, a decision algorithm is proposed to dispatch the microgrid operation. The proposed machine learning approach shows promising performance on a real dataset simulation compared to the benchmark rule-based approach, resulting in a significant 22% yearly operational cost reduction tested on the real data.}
}
@article{JEYARAJ2026114793,
title = {A generalized multi-agent deep reinforcement learning framework for enhancing resilience and energy management in smart grids},
journal = {Applied Soft Computing},
volume = {192},
pages = {114793},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114793},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002413},
author = {Pandia Rajan Jeyaraj and Siva Prakash Asokan and Aravind Chellachi Kathiresan and Edward Rajan Samuel Nadar},
keywords = {Multi-Agent Systems, Deep Reinforcement Learning, Resilience Enhancement, Real-Time Simulation, Markov Decision Process},
abstract = {With the integration of advanced computational algorithms and communication technologies, the smart grid functions as a Cyber-Physical System (CPS), making it vulnerable to cyber-attacks. Enhancing resilience is essential to mitigate these attacks, reduce outages, ensure secure operation, and maintain optimal power dispatch. This research proposes a cyber-constrained Multi-Agent Deep Reinforcement Learning (MADRL) framework for smart grids with distributed renewable energy sources, integrated with cyber-attack mitigation capabilities. The proposed MADRL algorithm enhances security and voltage stability by forming dynamic microgrids using data-driven Markov Decision Processes. It minimizes communication delays by avoiding congestion at non-cooperative nodes through constraint-based monitoring. To counter cyber intrusions, MADRL enables adaptive microgrid formation and learns to detect and respond to attacks through cyber-constrained training. The effectiveness of the proposed approach is validated on the IEEE 300-bus system under various outage and attack scenarios. Real-time simulations on IBM ILOG CPLEX optimization studio demonstrate its capability for online decision-making and resilience enhancement. Results confirm that the MADRL algorithm significantly improves smart grid reliability and security during cyber threats.}
}
@article{HAN2026114765,
title = {Soft-label guided multi-granularity prompts learning for human-object interaction detection},
journal = {Applied Soft Computing},
volume = {192},
pages = {114765},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114765},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002139},
author = {Xiaoqian Han and Xiaowei Zhang and Guanglin Niu and Mingliang Zhou and Zhenkuan Pan},
keywords = {Human object interaction detection, Large vision-language model, Prompt learning, Zero-shot detection},
abstract = {Vision-language models (VLMs) have driven substantial progress in human-object interaction (HOI) detection. However, existing VLM-based HOI detectors typically rely on coarse multimodal prompts for knowledge transfer, which makes it difficult to comprehensively capture interaction-relevant contextual cues and consequently weakens generalization to HOI detection. Meanwhile, hard-label supervised learning fundamentally ignores semantic correlations among interaction categories, which tends to suppress knowledge transfer due to misalignment with the continuous semantic similarity structure encoded by VLM representations in the embedding space. To address these challenges, we propose SMPL, a Soft-label guided Multi-granularity Prompt Learning model for HOI detection, which facilitates prompt learning by jointly capturing multi-level interaction cues and providing semantically calibrated supervision aligned with VLM embeddings. Specifically, we design multi-granularity visual and textual prompts to capture interaction cues at different levels of detail, thereby improving generalization to interaction categories. Moreover, we introduce soft-label learning to jointly optimize interaction classification with the hard-labels and soft-label supervision, which naturally reflects interaction-level semantic similarity, enabling the model to learn implicit interaction relations without additional annotations. Extensive experiments demonstrate that SMPL achieves 38.97 mAP on the HICO-DET dataset and improves performance by 2.64 mAP over the current state of the art on the challenging Rare split. SMPL also performs strongly under multiple zero-shot HOI settings, demonstrating excellent generalization to unseen interactions. The code and models are available at https://github.com/hxqstree/SMPL.}
}
@article{CHENG2026114728,
title = {Fault sample generation under continuous degradation using CRGAN-MDTR: A conditional recurrent GAN with maximum degenerate trend retention},
journal = {Applied Soft Computing},
volume = {192},
pages = {114728},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114728},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001766},
author = {Yujie Cheng and Pengchao Wang and Haoxin Gu and Jiyan Zeng and Jian Ma},
keywords = {Conditional generative adversarial network, Data scarcity, Continuous degradation process, Machine fault diagnosis, Variational inference},
abstract = {Optimal data conditions are crucial prerequisites for the effective implementation of data-driven fault-diagnosis methods. However, the lack of sufficient training samples, especially under conditions of unknown fault severity levels, significantly hampers their performance in practical engineering applications. A generative adversarial network (GAN) offers a feasible solution, but existing GAN-based models face challenges in generating missing samples with varying fault degrees during continuous degradation. To address this issue, we propose a novel data-generation method, called Conditional Recurrent GAN with Maximum Degenerate Trend Retention (CRGAN-MDTR). The CRGAN integrates long short-term memory (LSTM) units into a Conditional GAN (CGAN) architecture, enhancing its ability to learn temporal dependencies from continuous degradation trends. In addition, a degradation trend reconstruction network (MDTR) is incorporated alongside the CRGAN discriminator, enabling controlled generation of fault samples and further improving their quality. The proposed CRGAN-MDTR was comprehensively evaluated through ablation studies and comparisons with commonly used generative techniques. The evaluation employed three categories of metrics: Sample Consistency, Fault Severity Consistency, and Classification Task-Oriented Metrics, to ensure robustness across multiple dimensions. Results demonstrated that CRGAN-MDTR consistently achieved superior performance, including improved consistency and diagnostic accuracy, with the highest accuracy increase reaching 4.7 %. Notably, the model maintained high robustness in noise response experiments and effectively interpolated fault samples at varying degradation levels, addressing a critical gap in fault diagnosis methodologies. These findings validate the robustness and effectiveness of CRGAN-MDTR in addressing fault data scarcity across varying fault severity levels. This study contributes a promising solution to enhancing fault diagnosis performance under extreme data scarcity conditions and provides a foundation for future research on real-world industrial applications.}
}
@article{MAO2026114773,
title = {Semantic enhancement in graph contrastive learning by combining topology and features},
journal = {Applied Soft Computing},
volume = {192},
pages = {114773},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114773},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002218},
author = {Bowen Mao and Wenjun Wang and Wei Yu and Qiang Tian and Wenkai Wang and Jiye Liu and Han Bao and Nannan Wu},
keywords = {Graph neural network, Graph contrastive learning, Positive sampling},
abstract = {Graph contrastive learning (GCL), which learns node representations by contrasting two augmented graphs, has attracted significant research interest. The core of GCL is to obtain high-quality positive and negative samples as contrastive pairs, thereby learning the latent semantic information of the original graph. Existing GCL methods typically use random augmentation strategies to generate augmented views. In existing methods, the embeddings of the same node across two augmented graph views are treated as positive pairs, while embeddings of different nodes are regarded as negative pairs. Nevertheless, random graph augmentations may inadvertently distort the inherent structural and semantic properties of the graph, thereby inducing semantic drift for the same node between the two augmented views. Additionally, two different nodes of the same class may have similar semantics after augmentation. Therefore, we argue that the previous method of defining positive and negative pairs faces a bottleneck due to potential inauthenticity between the pairs. To address this issue, we propose a method called Semantic-Aware Graph Contrastive Learning with Positive Sampling (GCLPS), which mines latent semantic information in the graph, incorporating truly semantically similar node pairs as positive pairs. This approach reduces the impact of false positive pairs and helps the GNN learn the semantic relationships between nodes. Specifically, in the topology aspect, we select one-hop neighbors of each node in the original graph as positive pairs. In the feature aspect, we represent nodes on augmented views using subgraph-level graph kernels and choose positive pairs based on their similarity. Finally, we combine these two aspects to form the final set of positive pairs for contrastive loss calculation. Extensive experiments on six benchmark datasets demonstrate that GCLPS achieves superior performance in various downstream tasks compared to state-of-the-art methods.}
}
@article{LIU2026114736,
title = {A lightweight ultrasound welding surface defect detection network based robust feature downsampling},
journal = {Applied Soft Computing},
volume = {192},
pages = {114736},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114736},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001845},
author = {Rui Liu and Zhonghua Shen and Lun Zhao and Yu Ren and Lan Zhang and Liya Li and Jiajin Zhang and Amr Monier},
keywords = {Ultrasonic welding, Surface defect detection, Feature fusion, Lightweight},
abstract = {Ultrasonic welding is widely used in high-precision manufacturing because of its environmental benefits and high efficiency. Ultrasonic welding surface defects have significant large span and a background noise. Currently, the accuracy and computational complexity of deep learning-based industrial surface defect detection networks are challenging to meet the requirements. To address these problems, this research proposes a lightweight ultrasonic welding surface defect detection network (LUWDNet) for surface defects in ultrasonic welding wire harness terminals. Firstly, an efficient multi-scale residual block (EMR) is proposed, which uses residual structure and reparameterization technology to improve the feature extraction capability and enhance the network’s ability to extract multi-scale features. Subsequently, a deformable directional residual block (DDR) is proposed, which uses a bidirectional convolution kernel to expand the model’s receptive field. Reduces the impact of noise generated by background information in the model. Moreover, a hierarchical cascade feature fusion block (HCFF) is proposed, which uses dynamic channel adjustment to reduce network computation so that network computation and model size can be better adapted to edge deployment. Finally, the Robust Feature Downsampling Module (RFD) is applied in the network to mitigate the problem of small target loss and excessive noise generated by small targets during the downsampling process. To validate the effectiveness and generalizability of LUWDNet, it achieved 94.2% precision and 88.6% mean average precision (mAP50) with 2.6M parameters and a 6.5M model size in the surface defect dataset of ultrasonic welded wire harness terminals (UWSD). In addition, the satisfactory performance on the public dataset NEU-DET demonstrates the generalizability and stability of LUWDNet, showing its broad prospects in the field of industrial defect detection.}
}
@article{YE2026114692,
title = {A learning-driven artificial bee colony algorithm for mobile robot multi-objective path planning},
journal = {Applied Soft Computing},
volume = {192},
pages = {114692},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114692},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001407},
author = {Fan Ye and Peng Duan and Leilei Meng and Hongyan Sang and Maodi Ru and Kaizhou Gao},
keywords = {Mobile robot, Multi-objective path planning, Learning-driven artificial bee colony algorithm, Differential evolution strategy, Adaptive evolutionary restart strategy},
abstract = {Path planning is a critical component enabling mobile robots to perform diverse tasks, with complexity increasing significantly when simultaneously optimizing multiple objectives. In this study, a learning-driven artificial bee colony algorithm (LBABC) is proposed to address multi-objective path planning problems, where three objectives are optimized, i.e., path length, path safety, and path smoothness. In the initialization phase, a competition-based initialization strategy is investigated to generate a diverse set of initial solutions. In the employed bee phase, a differential evolution strategy is developed to enhance the algorithm’s global exploration ability, with differential mutation and crossing operators redesigned to suit the specific characteristics of the path planning problems. In the onlooker bee phase, a Q-learning-based evolutionary operator selection strategy is designed to improve the algorithm’s local search ability, utilizing six problem-specific evolutionary operators. In the scout bee phase, an adaptive evolutionary restart strategy is presented to replace those stagnant solutions with promising ones to enhance population activity. Finally, the proposed LBABC was compared with seven state-of-the-art algorithms across 16 instances from four respective environments. Additionally, all components proposed by the LBABC were examined through ablation testing. Experimental results showed that the proposed LBABC obtained average improvements of 1.37% and 40.74% on the hypervolume and inverted generational distance metrics, respectively, compared with the results obtained by the corresponding algorithm with the second-best performance. These results demonstrated the effectiveness of the designed components and the superior performance of the proposed LBABC in solving multi-objective path planning problems.}
}
@article{LI2026114744,
title = {From reading minds to books: A dual-sided multimodal knowledge-aware recommender system based on collaborative contrastive learning},
journal = {Applied Soft Computing},
volume = {192},
pages = {114744},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114744},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001924},
author = {Zhenyu Li and Shiwei Wang and Zhaodong Ding and Chanyuan Zhang and Xin Yan and Zongfeng Zou},
keywords = {Recommender systems, Book recommendation, Multimodal information fusion, Graph and hypergraph convolutions, Contrastive learning},
abstract = {Existing studies on multimodal recommender systems primarily focus on the fusion of multimodal features from items, largely overlooking the exploration of users’ multimodal information. Additionally, the effectiveness of recommender systems is often limited in real-world applications due to cold-start and long-tail problems. To address these challenges, we propose a dual-sided multimodal recommender system named UAFGK (User-Aware Fine-Grained Knowledge) in the context of book recommendation. Firstly, we construct multi-view graphs incorporating multimodal information from both the user and item sides. Specifically, we design a fine-grained knowledge selector using pairwise TF-IDF and pre-trained models to build a fine-grained knowledge hypergraph of items. Meanwhile, users’ modalities are utilized to construct visual and textual similarity graphs of users. Secondly, to consider the different high-order relationships in multi-view graphs, UAFGK models these relationships through hypergraph convolution networks (HGCNs) and graph convolutional networks (GCNs) in two distinct ways. Finally, to enhance the performance of the recommender system, we introduce a collaborative contrastive learning (CL) method that incorporates tight CL, loose CL, BPR, and cross-view BPR. Extensive experimental results on two novel datasets (DoubanBook-60K and DoubanMovie-200K) curated from community platforms demonstrate that UAFGK consistently and significantly outperforms state-of-the-art (SOTA) models across all metrics. Additionally, each component is validated as effective through detailed ablation studies. By focusing on the content similarities of users and items, our approach effectively mitigates cold-start and long-tail challenges to a certain extent. UAFGK can capture knowledge-aware user preferences and offer explainability to multimodal recommender systems.}
}
@article{EROL2026114747,
title = {Unraveling interdependencies in circular business models for renewable energy: A novel MCDM approach to systemic challenges},
journal = {Applied Soft Computing},
volume = {192},
pages = {114747},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114747},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600195X},
author = {Ismail Erol and Ahmet Oztel and Javad Pakdel},
keywords = {Circular business models, Renewable energy, Systemic challenges, IVSF-ISM},
abstract = {The adoption of Circular Business Models (CBMs) in the Renewable Energy Industry (REI) is pivotal for advancing the United Nations Sustainable Development Goals (SDGs), particularly Goal 7 (affordable and clean energy), Goal 12 (responsible consumption and production), and Goal 13 (climate action). However, it faces complex systemic and economic challenges. This study introduces a novel Interval-Valued Spherical Fuzzy Interpretive Structural Modeling (IVSF-ISM) and MICMAC framework to analyze the interdependencies among challenges, derived from a PRISMA-guided systematic literature review of 42 peer-reviewed articles. The proposed methodology captures uncertainty in expert judgments, structuring challenges into a six-level hierarchy and classifying them into driving, linkage, dependent, and autonomous categories based on their influence and dependence. Key findings highlight regulatory uncertainty, lack of interoperability, and fragmented value chain collaboration as primary driving challenges, amplifying barriers such as high initial investment and customer resistance to non-ownership models. Linkage challenges, including revenue unpredictability and data privacy risks, create feedback loops that exacerbate systemic risks. This research contributes to technological forecasting by offering a systemic perspective on CBM adoption and its societal impact. By addressing root causes, this study advances REI for optimizing resource allocation and fostering equitable, scalable energy transitions, contributing to sustainable energy.}
}
@article{ZAMEER2026114761,
title = {A survey on recent recurrent neural networks based intrusion detection systems},
journal = {Applied Soft Computing},
volume = {192},
pages = {114761},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114761},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002097},
author = {Aneela Zameer and Asima Akber Abbasi and Ijaz Hussain and Earum Mushtaq and Kamran Safdar and Shaista Sabir and Saira Mudasser and Saddam Akber Abbasi and Muhammad Asif Zahoor Raja},
keywords = {Recurrent neural network, Intrusion detection, Feature selection, Class imbalance},
abstract = {The escalating prevalence of varied cyber-attacks, coupled with the growing reliance on the internet and digital communication, poses a daunting challenge of formulating a network intrusion detection system (IDS) that is both secure and efficient. The research objective is to provide a detailed analysis of IDS using recurrent neural networks by reviewing the past ten years of published articles in high-impact factor journals. The history and types of IDS are elaborated in terms of advanced deep learning techniques and the most popular benchmark datasets. This survey focuses on recurrent neural networks with their variants and feature engineering on seven benchmark datasets of IDS: NSL-KDD, UNSW-NB15, CIC-IDS-2017, CSE-CIC-2018, BoT-IoT, CIC-DDoS2019, and CICIoV2024 over the past decade. This survey reveals that RNNs deliver enhanced performance using deep learning models for binary and attack-type classifications. The RNNs can effectively handle huge class imbalances and high-dimensional datasets. The outcomes of this research can provide insights to fresh researchers in this field, a critical area for improvement, and innovative dimensions of research can be accomplished.}
}
@article{LIU2026114769,
title = {A consensus particle swarm–guided trajectory unification method for training Kolmogorov–Arnold Networks},
journal = {Applied Soft Computing},
volume = {192},
pages = {114769},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114769},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002176},
author = {Zhihao Liu and Yongfeng Zhang},
keywords = {Kolmogorov-Arnold Networks, Gradient descent, Particle swarm optimization, Trajectory unification, Hybrid optimization},
abstract = {We propose CPSOTJU, a novel two-stage hybrid optimization framework designed to address slow convergence and local optimum entrapment in Kolmogorov–Arnold Networks (KANs). CPSOTJU integrates the global exploration capability of Consensus Particle Swarm Optimization (CPSO) with the precise local refinement of Trajectory Unification (TJU). In the first stage, CPSO explores the high-dimensional spline parameter space to identify promising basins of attraction, thereby mitigating premature convergence. In the second stage, TJU performs trajectory-guided local refinement to obtain stable, high-quality solutions. Extensive experiments on eight analytic benchmark functions and the Energy Efficiency regression dataset demonstrate that CPSOTJU consistently outperforms gradient-based baselines and derivative-free competitors such as CMA-ES, while remaining competitive with strong adaptive optimizers like AdamW. In particular, CPSOTJU achieves relative test RMSE reductions of up to 84.0% compared to CMA-ES and an average reduction of 66.02% across complex multimodal benchmarks relative to first-order methods, confirming its robustness and efficiency for training KANs.}
}
@article{ZHAI2026114753,
title = {An adaptive spatiotemporal two-branch network in time series classification for identifying agricultural machinery trajectory operation modes},
journal = {Applied Soft Computing},
volume = {192},
pages = {114753},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114753},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002012},
author = {Weixin Zhai and Yuchuan Luo and Jinming Liu and Jiawen Pan and Caicong Wu},
keywords = {Agricultural machinery trajectory operation mode identification, Hash, Spatiotemporal graph, Neighborhood learning mechanism, Orthogonality},
abstract = {Agricultural machinery trajectory operation mode identification is a specific branch of multivariate time series classification that aims to use spatiotemporal features in the trajectories of agricultural machines to identify agricultural activity scenarios and assign corresponding semantic labels to each trajectory point. However, existing methods often focus on extracting local features from trajectory data, failing to comprehensively model the dependencies of agricultural machinery trajectory data and limiting the identification accuracy. To address the above problems, we propose an adaptive spatiotemporal two-branch network (ASTTNet) for trajectory operation mode identification of agricultural machinery. First, we propose a temporal feature enhancement (TFE) module, which further characterizes the trend of the motion state of agricultural machinery in different time ranges to explore the spatiotemporal information in the trajectory data fully. Second, we construct a two-branch network that consists of a global feature extraction (GFE) module and a learnable local feature extraction (LLFE) module. Specifically, the GFE branch efficiently model global dependencies in agricultural trajectory data. The LLFE branch model the local dependencies between trajectory points. Finally, to regulate the information flow between the GFE and LLFE, we propose a self-adaptive balancing strategy module (SBO), which reduces information redundancy between the two branches by decoupling their feature representation spaces. To validate the effectiveness of our method, we conducted experiments on real collected paddy harvester, wheat harvester and tractor trajectory datasets. The results show that the f1 scores of ASTTNet on the paddy harvester, wheat harvester and tractor trajectory datasets are 91.29 %, 85.07 % and 93.69 %.}
}
@article{GAO2026114777,
title = {A dual-strategy multi-objective evolutionary algorithm with domain-informed mutation and secondary weighted selection for counterfactual explanations in knowledge tracing},
journal = {Applied Soft Computing},
volume = {192},
pages = {114777},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114777},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002255},
author = {Lu Gao and Xin Yuan and Xiaoxuan Shen and Jianwen Sun},
keywords = {Knowledge tracing, Causal inference, Counterfactual explanation, Genetic algorithm, Multi-objective optimization},
abstract = {Deep learning-based knowledge tracing (DLKT) models enhance personalized learning with strong predictions. However, their black-box nature hinders educational use, raising concerns about transparency and trust. To address this issue, this paper proposes a dual-strategy multiobjective evolutionary algorithm (DSMOEA) for counterfactual explanation, aimed at providing effective post hoc interpretations of DLKT predictions. Leveraging causal reasoning, DSMOEA avoids spurious correlations and generates actionable counterfactuals by constructing a tutoring-oriented framework that yields optimal, concise practice sequences to enhance future learning gains. We formulate the counterfactual generation task as a multi-objective optimization problem and solve it with a MOEA. Two strategies improve efficiency and quality: domain-informed mutation (DIM) guides solution generation, and secondary weighted selection (SWS) ranks Pareto candidates by educational relevance. Experiments demonstrate superior effectiveness and sparsity over baselines, delivering reliable counterfactuals and actionable guidance for learning path optimization.}
}
@article{MUKHERJEE2026114740,
title = {A swarm based metaheuristic approach in passive compensator tuning strategy incurring system loadability improvement},
journal = {Applied Soft Computing},
volume = {192},
pages = {114740},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114740},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001882},
author = {Debanjan Mukherjee and Subhajit Mukherjee and Sourav Mallick and Ratan Mandal and Soumya Chatterjee},
keywords = {Adaptive particle swarm optimization, Levy flight, Maximum loadability limit, Passive compensator, Self-pollination},
abstract = {Optimization issues in practical engineering are frequently nonconvex, discontinuous, and nonlinear. Most of the standard derivative-based optimization techniques either cannot provide the expected outcome for such real issues or do so only after relaxing the nonlinearities. Therefore, due to derivative-free nature, population-based metaheuristic approaches have gained popularity. They may not be totally free from the local optima trapping limitation, despite the fact that they are oblivious to the complexity of the situation. Henceforth, a suitable strategy must be adopted to create a new metaheuristic algorithm for effectively solving the said problems with appreciable accuracy without high linearization of the actual problem. Given this, the recent algorithm of the Levy Flight motivated Adaptive Particle Swarm Optimization (APSOLF) technique is enhanced by the Self-Pollination (SP) strategy; this results in proposing the SP Enhanced APSOLF (EAPSOLF) algorithm which is specifically designed for applying and testing on a nonlinear, complex, constrained optimization problem like single tuned passive compensator tuning problem. Here, two standard power systems i.e., IEEE 5 and IEEE 118 bus systems are considered as the test platforms. Consequently, the system losses are minimized after optimizing the filter settings which also result in improving the bus voltage profile and the enhancement in systems’ Maximum Loadability Limit (MLL) in a remarkable extent. Additionally, the EAPSOLF's effectiveness in solving such real-time engineering issue is compared with other state-of-the-art metaheuristics using different statistical analytical tools. The proposed technique has showed its effectiveness in all test cases.}
}
@article{ZHAO2026114801,
title = {AssemPrompt: A lightweight multi-module collaborative framework for efficient and accurate medical image segmentation},
journal = {Applied Soft Computing},
volume = {192},
pages = {114801},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114801},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002498},
author = {Hongyan Zhao and Yunteng Hu and Shijie Xu},
keywords = {Medical image segmentation lightweight models},
abstract = {Medical image segmentation tasks urgently require efficient modeling of multi-level structures and multi-scale boundary features of organs/tissues under limited computational resources. Existing methods struggle to balance high-precision segmentation requirements with real-time constraints for clinical deployment. This paper proposes a multi-module collaborative architecture for medical image segmentation, with its core comprising: (1) The AssemFormer module employs a dual-path parallel mechanism, integrating depthwise separable convolution and linear-complexity self-attention to unify local anatomical details and long-range contextual dependencies through a unified tensor assembly strategy; (2) The PromptGenBlock module introduces a dynamic prompt mechanism based on input distribution, adaptively enhancing target region features using a learnable parameter library while providing category guidance; (3) The GABD module effectively establishes cross-scale spatial associations and strengthens discriminative expression of lesions or boundaries through high-low frequency feature decoupling aggregation, variable dilation rate convolution, and mask-aware attention; (4) The FusionModule combines LHMC multi-scale context modeling with CAM channel attention recalibration, enhancing feature fusion stability and target selectivity through normalization and nonlinear activation. This lightweight architecture achieves a favorable balance between accuracy and efficiency, reaching 81.26% mIoU and 89.66% DSC on ISIC2018 with only 0.0914 M parameters and 0.0897G FLOPs, and shows strong performance across GlaS, ISIC2016, ISIC2017 and CVC-ClinicDB.}
}
@article{MORTAZAVI2026114748,
title = {A hybrid deep transfer learning approach for road extraction from high-resolution satellite images based on D-LinkNet and fuzzy systems},
journal = {Applied Soft Computing},
volume = {192},
pages = {114748},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114748},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001961},
author = {Shahnaz Sadat Mortazavi and Yousef Sharafi and Mohammad Teshnehlab},
keywords = {Semantic segmentation, Road extraction, High-resolution satellite imagery, Convolutional neural networks (CNNs), Transfer learning, Pre-trained CNNs, Remote sensing images, Adaptive learning rate, Fuzzy systems},
abstract = {Road extraction from high-resolution satellite imagery is essential for applications such as urban planning, disaster response, and intelligent transportation systems. This paper proposes an enhanced version of the D-LinkNet model through a hybrid dual-encoder architecture that integrates complementary pre-trained networks, AlexNet or ShuffleNetv2, combined with ResNet34 to capture both fine-grained textures and high-level semantic features. To improve training dynamics and convergence stability, a fuzzy logic-based adaptive learning rate controller is introduced, dynamically adjusting the learning rate based on performance feedback. Additionally, a dynamic loss function combining Binary Cross-Entropy and Dice Loss with adaptive weighting is employed to mitigate class imbalance and preserve road structure continuity. The proposed method is evaluated on two benchmark datasets: DeepGlobe and Massachusetts. Experimental results show that the hybrid-fuzzy model outperforms the baseline D-LinkNet, achieving up to 4.0 % improvement in Intersection over Union (IoU), 6.0 % in F1-score, and 1.94 % in Pixel Accuracy on the Massachusetts dataset, highlighting the practical effectiveness and robustness of the proposed framework.}
}
@article{CAIRANG2026114724,
title = {A three-way decision method based on jensen-shannon divergence and behavior perception under the probabilistic linguistic term environment},
journal = {Applied Soft Computing},
volume = {192},
pages = {114724},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114724},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001729},
author = {Yizhu Cairang and Haidong Zhang and Yanping He},
keywords = {Jensen-shannon divergence, Probabilistic linguistic terms sets, Regret theory, Three-way decision},
abstract = {Multi-attribute decision-making (MADM) problems are among the central challenges in the field of decision-making, aiming to help decision- makers (DMs) select the optimal alternative from a set of alternatives when faced with multiple mutually conflicting evaluation criteria. In real-world complex situations, DMs often prefer to use more natural and intuitive linguistic terms for evaluation rather than precise numerical values. At the same time, traditional MADM methods frequently neglect the DMs’ intrinsic psychological and behavioral factors when constructing decision models. To effectively address these challenges, this paper proposes a novel decision method that integrates regret theory (RT) with the multi-objective optimization by ratio analysis (MOORA) method under a probabilistic linguistic term set (PLTS) framework. Compared with existing methods, the main contributions of this paper can be summarized in four aspects: (1) To address deficiencies in existing distance formulas for PLTS, we innovatively introduce the Jensen-Shannon (JS) divergence to construct a more reasonable and accurate distance calculation formula. Based on this, a new similarity is derived, and a distance based attribute weights method is proposed. (2) By introducing θ-level similarity classes, this paper proposes a new method for calculating conditional probabilities of alternatives. Combining the aforementioned attribute weights, weighted conditional probabilities are constructed. (3) To more accurately capture DMs’ psychological behavior, this paper integrates RT with the MOORA method to construct a relative utility function that effectively reflects DMs’ behavioral perceptions. (4) By combining weighted conditional probabilities with the relative utility function, a novel three-way decision (TWD) method is formed; this method not only flexibly allows for deferred decisions when evaluation information is insufficient but also comprehensively accounts for DMs’ risk preferences and regret psychology, thereby producing decisions more aligned with real-world contexts. Finally, through analysis of practical case studies and comparative experiments with several classical methods, the proposed method is thoroughly validated for its significant advantages and practical value in decision performance, stability, and adaptability. We believe this method offers a more scientific and human-centered solution for MADM in complex uncertain environments.}
}
@article{PARK2026114732,
title = {Self-supervised inference of missing energy sources for enhancing energy consumption forecasting},
journal = {Applied Soft Computing},
volume = {192},
pages = {114732},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114732},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001808},
author = {Jong Seong Park and Jeong-Ha Park and Ji-Hyeok Choi and Hyuk-Yoon Kwon},
keywords = {Energy consumption forecasting, Multi-source data, Self-supervised learning, Representation learning, Clustering},
abstract = {While incorporating multiple correlated energy sources significantly improves energy consumption forecasting accuracy, practical data collection limitations often prevent access to complete multi-energy datasets across all regions. This paper addresses the critical gap between the theoretical benefits of multi-energy forecasting and the practical constraints of incomplete data collection by introducing a novel cross-regional inference framework. We propose the first self-supervised learning approach for inferring missing energy sources in multi-energy forecasting, which leverages complete datasets from reference regions to infer missing energy consumption patterns in target regions with incomplete data collection. The key innovation lies in our self-supervised representation learning method that captures complex inter-energy correlations beyond traditional distance-based metrics, enabling effective clustering of households with similar multi-energy consumption patterns. Our approach provides theoretical guarantees for clustering convergence and includes comprehensive complexity analysis, addressing fundamental questions about the scalability and reliability of cross-regional energy inference. Through extensive experiments on real-world datasets, we demonstrate substantial improvements over baseline approaches. Specifically, our method achieves up to 30% better inference accuracy compared to simple averaging methods. Furthermore, in the downstream forecasting task, it reduces the forecasting error (MAE) by an average of 15.2% and a maximum of 27.0% compared to single-source baselines, showing robust performance across different temporal patterns and regional characteristics. The source code for the proposed framework is available at Anonymous GitHub Repo.}
}
@article{BOCZEK2026114751,
title = {Intuitionistic fuzzy-valued Choquet operator: theoretical foundations and application to aggregation tasks},
journal = {Applied Soft Computing},
volume = {192},
pages = {114751},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114751},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001997},
author = {Michał Boczek and Marek Kaluszka and Paweł Karczmarek and Alicja Żmudzińska and Albert Rachwał and Michał Dolecki},
keywords = {Atanassov’s intuitionistic fuzzy value, Choquet-like operator, Aggregation function, Archimedean -norm, Monotonicity},
abstract = {Aggregation function plays a fundamental role in decision-making problems involving incomplete information. In particular, the intuitionistic fuzzy-valued Choquet operator (IFC - operator), based on an Archimedean t-norm, provides a flexible and powerful framework for modeling interactions among criteria in intuitionistic fuzzy environments. Previous studies have mainly focused on examining whether the IFC - operator satisfies the axioms of an aggregation function for selected Archimedean t-norms. In the paper, we present a complete characterization that allows one to determine whether the IFC - operator qualifies as an aggregation function under a fixed total order. To achieve this, we establish a general theoretical framework that characterizes the conditions under which a generalized Choquet-like operator of the form F(xσ(1),…,xσ(n),μ(Bσ(1)),…,μ(Bσ(n))) satisfies the axioms of aggregation functions given a fixed total order, where the values xσ(i) are taken from an arbitrary linearly ordered set and (Bσ(i)) forms a monotonicity family of subsets of {1,…,n}. We also present some applications of the IFC - operator to combine the results of individual classifiers in the multi-class problems. We show that the IFC - operator can be effectively applied to the multi-class problems as the aggregation function to combine the results of individual classifiers. Extensive numerical experiments confirmed the effectiveness of the proposed method, which achieved high accuracy and consistently outperformed the Choquet integral as well as individual classifiers.}
}
@article{WU2026114772,
title = {CUBA: Controlled untargeted backdoor attack against deep neural networks},
journal = {Applied Soft Computing},
volume = {192},
pages = {114772},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114772},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002206},
author = {Yinghao Wu and Liyan Zhang},
keywords = {Backdoor attack, Deep neural networks, Untargeted attack, Artificial intelligence security},
abstract = {Backdoor attacks have emerged as a critical security threat against deep neural networks in recent years. The majority of existing backdoor attacks focus on targeted backdoor attacks, where trigger is strongly associated with specific malicious behavior. Various backdoor detection methods depend on this inherent property and show effective results in identifying and mitigating such targeted attacks. However, a purely untargeted attack in backdoor scenarios is, in some sense, self-weakening, since the target nature is what makes backdoor attacks so powerful. In light of this, we introduce a novel Constrained Untargeted Backdoor Attack (CUBA), which combines the flexibility of untargeted attacks with the intentionality of targeted attacks. The compromised model, when presented with backdoor images, will classify them into random classes within a constrained range of target classes selected by the attacker. This range can be all incorrect classes (Full Range Attack) or a predefined subset (Narrow Range Attack). This combination of randomness and determinedness enables the proposed untargeted backdoor attack to natively circumvent existing backdoor defense methods. To implement the untargeted backdoor attack under controlled flexibility, we propose applying logit normalization on cross-entropy loss with flipped one-hot labels. By constraining the logit during training, the compromised model will show a uniform distribution across selected target classes, resulting in controlled untargeted attack. The experimental results demonstrate that the proposed CUBA achieves remarkable attack success rates across multiple datasets, reaching 99.99%, 99.94% and 99.79% on MNIST, GTSRB and CIFAR10 respectively.}
}
@article{DOU2026114743,
title = {Supply chain network design considering uncertain disruption risks and carbon constraints},
journal = {Applied Soft Computing},
volume = {192},
pages = {114743},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114743},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001912},
author = {Runliang Dou and Zhichao Lu and Hao Wang and Yixin Wei and Yanchao Hou},
keywords = {Supply chain network design, Uncertain disruption risk, Carbon constraints, Multi-level backup strategy, Genetic algorithm},
abstract = {In view of the increasingly fierce corporate competition and constantly changing market environment, the rational design of supply chain networks plays a crucial role in the long-term strategic layout of enterprises. To address the potential uncertain disruption risks in supply chain network transportation and considering the current global requirements for low-carbon emissions, this study constructs a three-layer supply chain network design model, introducing two supply layers and dual uncertainties between the supply layers and enterprise layer. To handle disruption risks, the model adopts a multi-level backup strategy, with profit maximization as the objective and carbon emissions, stochastic demands, and uncertainty risks as the main constraints. Subsequently, we linearizes the nonlinear model. Finally, the model is solved using a specific numerical example and relevant conclusions are drawn. We use Gurobi solver to solve small-scale datasets, and apply genetic algorithm to obtain approximate solutions of large-scale dataset. The research shows that, regardless of the supply chain network size, a combination involving higher maximum allocation levels helps to increase enterprise profit. Meanwhile, the relationship between carbon emission constraints and enterprise profit, as well as between disruption belief degree levels and enterprise profit are also identified. The study verifies the effectiveness of the multi-level backup strategy in dealing with supply chain disruption risks.}
}
@article{ZHANG2026114731,
title = {A multi-feature collaborative computational neural architecture search method for classifying continuous time series signals},
journal = {Applied Soft Computing},
volume = {192},
pages = {114731},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114731},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001791},
author = {Rui Zhang and Xin-Yu Li and Yan-Jun Zhang},
keywords = {Neural Architecture Search, Continuous time series signal classification, Convolutional neural network},
abstract = {This paper proposes a multi-feature collaborative computational neural architecture search (MFCC-NAS) method for classifying continuous time series signals. It is designed to enhance the value density of the signals and mitigate the subjective nature of the design of the model architecture while reducing the computational cost of assessing its performance. We first design a representation of sample richness and a metric of their contributions to enhance the richness of the features in them, so that they provide a basis of dense and high-value data. Following this, we develop a MFCC-NAS method that can efficiently construct a model to classify continuous time series signals by using a search space designed for global–local feature separation based on cells, an architecture search strategy for the collaborative computation of global–local features, and a low-cost and robust cascading strategy to evaluate the performance of the architecture. Finally, we design a multi-domain collaborative fusion mechanism to fully integrate convolutional visual features from different spatial domains and obtain a comprehensive representation of the features of the samples. We tested the proposed method through comparative generalization experiments on a dataset of welding defects and the Yaseen dataset. After respective search times of 1.52 h and 1.21 h on these datasets, our model achieved an accuracy of classification of over 98 % on both. Furthermore, the resulting model maintains a compact parameter size and short inference time. These results collectively demonstrate the effectiveness and strong generalization capability of the proposed MFCC-NAS method.}
}
@article{LI2026114752,
title = {Empirical group sparse decomposition: Algorithm and application},
journal = {Applied Soft Computing},
volume = {192},
pages = {114752},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114752},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002000},
author = {Sainan Li and Jing Wu and Zhengbin Yan and Jiayi Zheng and Xianbin Zheng},
keywords = {Empirical group sparse decomposition, Periodic pulse feature components, Feature extraction, Signal processing, Group sparse},
abstract = {Periodic pulse feature components are widely present in complex signals across various fields such as biomedical and aerospace engineering, and their accurate extraction is crucial for monitoring. Aiming to address the core challenges of extracting periodic pulse feature components, this paper proposes a novel signal decomposition method, Empirical Group Sparse Decomposition (EGSD). First, EGSD constructs a unimodal pre-segmentation strategy to determine the frequency band range of the decomposition modes, ensuring the physical significance of the pre-decomposed modes. Next, EGSD designs a group sparse filter bank to decompose the signal into a series of fundamental modes, thereby extracting the hidden periodic pulse feature components within the signal. Finally, EGSD proposes a periodic frequency similarity fusion strategy to fuse the fundamental mode components into a series of eigenmode functions, effectively overcoming the over-decomposition issue. As a novel signal decomposition method, EGSD enables effective signal separation and extracts feature information concealed within noise. This paper validates the effectiveness of EGSD through simulated cases and three real-world applications: mechanical vibration signal feature extraction, EEG signal denoising, and ECG signal separation. The experimental results demonstrate that the EGSD method effectively separates signals, extracts feature information, and mitigates noise interference, underscoring its practical value.}
}
@article{NI2026114776,
title = {Multi-view feature representation learning: Integrating medical team information to enhance online physician recommendation},
journal = {Applied Soft Computing},
volume = {192},
pages = {114776},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114776},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002243},
author = {Yongbo Ni and Donghui Yang},
keywords = {Online healthcare community, Online medical team, Physician recommendation, Multi-view feature representation},
abstract = {Recommending suitable physicians to patients in online healthcare communities remains a challenging decision-making task. While existing studies leverage physicians’ professional features (clinical expertise) or service features (patient evaluations) for recommendations, single-view feature analysis and limited physician-patient interaction data often lead to insufficient feature representation, which further results in relatively poor recommendation performance. The emergence of online medical teams (OMTs) provides patients with a novel team perspective and data source for understanding physician features. Therefore, this study aims to leverage the OMTs information to construct a multi-view feature representation learning framework to enhance the physician feature representation and improve the recommendation performance. We first integrate the OMTs information with online reviews, disease descriptions, and physician profiles to build the multi-source and multi-type medical data inputs. Based on these inputs, we leverage BERT, TextCNN, semantic analysis, and graph neural network technologies to construct the multi-view feature representation learning framework from the views of professional features, service features, and team features. Then, these multi-view features are fused through a multilayer perceptron to predict the selection probabilities. Experimental results demonstrate the multi-view features based method incorporating OMTs information shows an average improvement of 7.5 % in HR@5, 5.3 % in NDCG@5, and 7.8 % in MRR compared to other classical methods. Surprisingly, the physician service capabilities involved in the team features have a greater impact on the recommendation performance than the physician professional capabilities involved.}
}
@article{MENG2026114687,
title = {A structure-guided framework for multimodal optimization leveraging chaotic search and persistence-based clustering},
journal = {Applied Soft Computing},
volume = {192},
pages = {114687},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114687},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001353},
author = {Xiang Meng and Yan Pei},
keywords = {Single-objective optimization, Multi-objective optimization, Multimodal optimization, Chaotic evolution, Clustering, Decision space},
abstract = {Multimodal optimization remains a fundamental challenge due to the difficulty of preserving population diversity while efficiently locating multiple optima. To address this challenge, we propose the structure-guided multimodal optimization (SRS-GMO) framework, which explicitly models the evolutionary process as a structured search over topological regions in the decision space, characterized by a novel structural relevance score (SRS). This score integrates persistence, spatial distinctiveness, and recent evolutionary activity to adaptively allocate computational resources to promising niches while maintaining overall structural diversity. SRS-GMO employs chaotic evolution based on logistic maps to enhance global exploration and facilitate escaping from local optima. We instantiate the framework into two variants: SRS-GMO-SO for single objective multimodal optimization problems and SRS-GMO-MO for multi-objective multimodal optimization problems, respectively. Extensive experiments on the CEC2013 and MMF benchmark suites demonstrate that SRS-GMO achieves superior performance in peak coverage, convergence stability, and structural diversity preservation. We also provide a per-module computational complexity analysis and discuss practical accelerations for scalability. These results validate the effectiveness of the proposed framework in addressing the challenges of both single- and multi-objective multimodal optimization.}
}
@article{LIANG2026114739,
title = {A multimodal Alzheimer's disease diagnosis model with fusion of cross-modal attention and graph attention},
journal = {Applied Soft Computing},
volume = {192},
pages = {114739},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114739},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001870},
author = {Shengbin Liang and Yuting Chen and Yitong Zhang and Weiwei Liu and Yunhui Li and Canyu Liang and Chenxi Ma and Feng Gu},
keywords = {Multimodal fusion, Graph attention network, Cross-modal attention, Alzheimer's disease diagnosis, Computer-aided diagnosis},
abstract = {Alzheimer's disease (AD) is a multisystem neurodegenerative disorder with pathological mechanisms involving the brain structural atrophy and genetic variations. The accurate diagnosis requires the comprehensive multiscale pathological characterization, but traditional single-modal methods only capture morphological changes in specific brain regions, failing to cover AD’s complex pathology. Existing multimodal fusion approaches are limited by data heterogeneity, with the poor deep feature integration and cross-modal joint analysis. To address these issues, this paper proposes a cross-modal graph attention network-based multimodal fusion model, integrating the resting-state functional magnetic resonance imaging (rs-fMRI) and single nucleotide polymorphism (SNP) data to mine intra-modal complex features and enhance the inter-modal complementary information. Our proposed model has two core modules including a residual integrated cross-modal attention module that reduces multimodal data heterogeneity, identifies brain region of interests (ROIs), and provides visual/quantitative results for AD pathology inferences, and a graph attention module that dynamically optimizes edge weights to capture local features and model brain region-gene networks globally, enhancing the cross-modal pathological representation. Experiments on the Alzheimer's Disease Neuroimaging Initiative (ADNI) dataset show the model achieves 95.66 % diagnostic accuracy, outperforming state-of-the-art methods. This study provides a new technical solution for the precise AD diagnosis and a reference for the heterogeneous multimodal medical data fusion and the cross-scale pathological analysis.}
}
@article{KUBICKOVA2026114800,
title = {Accelerating shape optimization by deep neural networks with on-the-fly determined architecture},
journal = {Applied Soft Computing},
volume = {192},
pages = {114800},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114800},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002486},
author = {Lucie Kubíčková and Ondřej Gebouský and Jan Haidl and Martin Isoz},
keywords = {Multi-objective optimization, Evolutionary algorithms, Deep neural networks, Computational fluid dynamics, Ejector},
abstract = {In component shape optimization, the component properties are often evaluated by computationally expensive simulations. Such optimization becomes infeasible when it is focused on a global search requiring thousands of simulations to be evaluated. Here, we present a viable global shape optimization methodology based on multi-objective evolutionary algorithms accelerated by deep neural networks (DNNs). Our methodology alternates between evaluating simulations and utilizing the generated data to train DNNs with various architectures. When a suitable DNN architecture is identified, the DNN replaces the simulation in the rest of the global search. Our methodology was tested on a number of standardized benchmark functions, showing itself at the level of and sometimes more flexible than other state-of-the-art acceleration approaches. Then, it was applied to a real-life optimization problem, namely the shape optimization of a single-phase ejector. Compared with a non-accelerated methodology, ours was able to save weeks of CPU time in solving this problem. Additionally, four optimized ejector shapes were 3D printed and tested experimentally to demonstrate their real-life performance.}
}
@article{WANG2026114695,
title = {Transformer and variational autoencoder-based multi-view fusion intelligent decision network for automated rock breaking},
journal = {Applied Soft Computing},
volume = {192},
pages = {114695},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114695},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001432},
author = {Shiwei Wang and Yu Liu and Jinguang Lin and Yuanxin You},
keywords = {Imitation learning, Rock breaking, Intelligent decision-making, Secondary breaking},
abstract = {The secondary breaking task is a critical step in ensuring the normal operation of crusher jaws, aiming to break rocks exceeding the processing capacity of the crusher into suitable sizes. Existing remote operation modes for controlling breakers face high complexity, low efficiency, and safety risks, which make them challenging to meet practical demands. To address these limitations, this paper proposes T-MVDN, an end-to-end intelligent decision-making algorithm based on imitation learning, designed to optimize the entire process from scene perception to action planning. The T-MVDN integrates the Transformer architecture, CVAE latent space encoding, and action sequence modeling modules, utilizing multi-view RGB-D data fusion and local spatial attention mechanisms to significantly enhance robustness and decision-making efficiency in complex environments. Moreover, this study systematically defines the operational workflow and prioritization for secondary breaking tasks. The algorithm was validated in a high-fidelity simulation environment built using Blender and CoppeliaSim, and further evaluated through real-world experiments to assess its feasibility in actual engineering applications. Experimental results demonstrate that the proposed method enables efficient and safe autonomous breaking operations in real task scenarios. This research represents the first application of imitation learning to autonomous planning in secondary breaking scenarios, offering a novel perspective on automation in the construction and mining sectors.}
}
@article{LI2026114756,
title = {MUL-UNet: A lightweight multi-weather image restoration network with enhanced edge preservation},
journal = {Applied Soft Computing},
volume = {192},
pages = {114756},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114756},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002048},
author = {Rujia Li and Shuai Zhang and Xiaoling Huang and Jiahao Nie and Mengfei Liu},
keywords = {Edge preservation, Adverse weather removal, Network parameters, Deraining, Desnowing},
abstract = {Image restoration aims to reconstruct degraded images under adverse weather conditions into high-quality images, providing reliable inputs for computer vision tasks. However, current deep learning image restoration algorithms face three major challenges: First, existing approaches primarily focus on single-weather scenarios, struggling to adapt to complex and varying weather conditions; Second, insufficient integration of edge priors during image processing leads to loss of edge details in reconstructed images; Third, existing weather removal methods rely on deep network architectures, limiting deployment in resource-constrained scenarios. To address these challenges, this study proposes MUL-UNet, a novel multi-task image restoration network with a single-backbone, multi-branch U-shaped architecture. First, a Multi-task Encoder (MTE) with a representation encoder head and dual auxiliary branches is proposed to achieve efficient multi-weather image restoration through adaptive weight adjustment for different weather scenarios; Second, a Gradient Feature Fusion Module (GFFM) is proposed to receive multi-scale edge feature maps extracted by the representation encoder head in MTE and fuse them with the multi-scale image feature maps extracted by the U-Net encoder in single-backbone through skip connections, enhancing edge detail preservation; Finally, Multi-scale Convolution Block (MConv Block) is proposed to replace traditional large kernel convolutions, reducing network parameters while maintaining feature extraction capabilities, thus improving model deployment efficiency. Experimental results show that the proposed model achieves state-of-the-art performance on multiple benchmark datasets.}
}
@article{WANG2026114792,
title = {DMEL: A novel dual-modal ensemble learning architecture for multi-step runoff prediction},
journal = {Applied Soft Computing},
volume = {192},
pages = {114792},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114792},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002401},
author = {Wen-chuan Wang and Miao Gu and Zong Li and Yi-yang Wang and Yan-wei Zhao},
keywords = {Daily runoff prediction, Multi-step prediction, Dual-Modal Ensemble Learning, Modal Recognition Strategy},
abstract = {Accurate multi-step runoff prediction is crucial for effective water resource management and flood disaster reduction. Despite significant advancements in deep learning for hydrological predictions, identifying the modal characteristics of runoff sequences and extending the effective lead time of prediction models remain challenging. This paper introduces a novel Dual-Modal Ensemble Learning (DMEL) architecture that addresses these issues by integrating a Modal Recognition Strategy (MRS) with two deep learning models: Informer and Long Short-Term Memory (LSTM). The MRS technique first reduces the nonlinearity and non-stationarity of runoff data through feature extraction and fusion, lowering model computational complexity and mitigating cumulative errors from high-dimensional inputs. The optimized modal components are then categorized into high-frequency and low-frequency components, which are processed by the Informer and LSTM models, respectively, leveraging their unique capabilities for dual-modal ensemble learning. The final prediction is obtained by superimposing the results from all sequences. The two sites’ analysis results demonstrate the DMEL architecture’s effectiveness. Taking the Shuangpai Station as an example, in single-step prediction, the Kling-Gupta Efficiency (KGE) index of the DMEL model achieves relative improvements of 22.60 %, 28.32 %, 25.34 %, 43.90 %, 45.06 %, and 42.30 % compared to the Informer model, Transformer model, LSTM model, Recurrent Neural Network (RNN) model, TimesNet model, and PatchTST model, respectively. When the prediction step increases to the seventh step, the KGE index of the DMEL model still shows relative increases of 37.50 %, 105.71 %, 89.84 %, 146.04 %, 211.82 %, and 178.06 % compared to the Informer model, Transformer model, LSTM model, RNN model, TimesNet model, and PatchTST model, respectively. This indicates that the DMEL architecture can accurately capture critical information in daily runoff sequences, extending the model’s effective prediction period and providing a robust scientific basis for water resource management and flood disaster reduction.}
}
@article{BI2026114781,
title = {ODPL: An objective-driven decomposed policy learning framework for urban autonomous driving control},
journal = {Applied Soft Computing},
volume = {192},
pages = {114781},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114781},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626002292},
author = {Lizhi Bi and Bin Shuai and Zhanru Liu and Yichen Sun and Feiyu Yang},
keywords = {Autonomous driving, Deep reinforcement learning, Objective-driven learning, Task decomposition, Delay-aware control},
abstract = {In urban driving (UD) environments, deep reinforcement learning (DRL) demonstrates superior adaptability for autonomous driving control. However, fundamental challenges remain unsolved in existing DRL methods: error accumulation in Actor-Critic architectures, inconsistent learning signals from hand-crafted reward functions, and signal confusion in multi-dimensional control tasks. This paper proposes an Objective-Driven Decomposed Policy Learning (ODPL) framework for reliable urban autonomous driving control. The framework deconstructs the traditional reinforcement learning paradigm by eliminating Critic networks and directly utilizing driving-specific objectives as learning signals, thereby improving learning efficiency and accelerating convergence. ODPL employs a task decomposition strategy that decouples steering and throttle control into independent subtasks, resolving the signal confusion problem inherent in unified network architectures. Furthermore, to address credit assignment issues caused by physical delays, ODPL integrates a delay-aware state transition model that establishes precise causal relationships between current states and historical actions through a delay buffering mechanism. Simulation results in the CARLA environment demonstrate that the proposed ODPL framework achieves 70%–110% performance improvements over advanced baseline methods across various driving scenarios. The framework exhibits exceptional performance in complex curve scenarios while maintaining stable learning convergence under cold-start conditions without pre-training data.}
}
@article{ATEF2026114723,
title = {Regional COVID-19 integrity evaluation based on VIKOR method: Fuzzy β covering based weighted fuzzy rough sets},
journal = {Applied Soft Computing},
volume = {192},
pages = {114723},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.114723},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626001717},
author = {Mohammed Atef},
keywords = {Weighted fuzzy rough set, Fuzzy  covering weighted fuzzy rough set, TOPSIS, COPRAS, VIKOR, COVID-19},
abstract = {Fuzzy rough set models have a considerable impact on dealing with uncertain data. Recently, the notion of weighted fuzzy rough sets according to the fuzzy similarity relation utilizing the distance between samples and others that do not belong to the same class has been introduced. However, this phenomenon provides results that are more accurate than the classical approach, where the given data must be of a certain kind. As a result, this paper introduces a new model of weighted fuzzy rough sets that can be applied to different types of data, that is, fuzzy β covering weighted fuzzy rough sets. Hence, we define a new kind of distance between samples and then use it to construct the weighted fuzzy rough lower and upper approximations. Then we study the axiomatic characteristics, including the inclusion relations between them. In addition, the relationship between our approach and the ancient studies is examined. After that, we combine the fuzzy β covering weighted fuzzy rough sets with the VIKOR method to classify the safety of 100 countries in terms of COVID-19 diagnosis. Next, we compare our method with the existing studies to demonstrate the effectiveness and reliability of our approach.}
}