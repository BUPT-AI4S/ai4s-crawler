@article{KULSHRESHTHA2026115243,
title = {Adaptive fuzzy-evolutionary learning computation framework for energy-efficient routing in IoMT networks},
journal = {Applied Soft Computing},
volume = {198},
pages = {115243},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115243},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006915},
author = {Ambuja Kulshreshtha and Uma Meena},
keywords = {Adaptive soft computing, Internet of medical things, Fuzzy-evolutionary-learning, Fuzzy C-means clustering, Reinforcement learning, Energy efficiency},
abstract = {The Internet of Medical Things (IoMT) necessitates the deployment of numerous resource-limited sensors to facilitate continuous patient monitoring. Nonetheless, maintaining prolonged network functionality while ensuring the prompt transmission of crucial medical data presents a significant challenge within these kinds of scenarios. This paper proposes a Fuzzy-Evolutionary-Reinforcement Learning (FEL) framework that concurrently addresses energy efficiency, adaptive routing, and risk-aware data prioritization within large-scale IoMT networks. The proposed framework incorporates Fuzzy C-means clustering for soft spatial partitioning, Beluga Whale Optimization for evolutionary cluster-head selection, and Q-learning-based adaptive routing driven by a fusion-derived risk indicator. By integrating decision-level fusion into both the clustering and routing processes, the framework facilitates risk- and priority-aware resource allocation while maintaining the confidentiality of raw medical data at the network layer. Extensive mathematical computations were performed on dense IoMT deployments comprising up to  N=2000 nodes over 1000 instances, incorporating heterogeneous background traffic and severity-aware medical events. A comparative benchmarking against representative routing and clustering protocols along with ablation, sensitivity, and statistical analyses has been performed to quantify the contribution of each FEL component. The results obtained indicate that the proposed approach attains significantly more residual energy and complete network survivability, while preserving minimal end-to-end latency and acceptable packet delivery performance compared to baseline IoMT protocols. The results validate that the integration of fuzzy clustering, evolutionary optimization, and reinforcement learning delivers a resilient and scalable solution for dense, risk-sensitive IoMT settings rendering the framework appropriate for prolonged healthcare monitoring applications.}
}
@article{AMER2026115138,
title = {Weight-updated iterative k-nearest neighbor algorithm for managing outliers and class imbalance},
journal = {Applied Soft Computing},
volume = {198},
pages = {115138},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115138},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005867},
author = {Ali A. Amer and Hassan I. Abdalla and Mohammad Nassef},
keywords = {Data Classification, KNN, Machine Learning, Class Imbalance, Outliers, Noisy data},
abstract = {The k-Nearest Neighbors algorithm is one of the most used algorithms to classify data. Nonetheless, the primary causes of its deteriorating performance are outliers and class imbalance. To reduce their effects, this work therefore presents a novel iterative-based weight-updated kNN algorithm (IWUkNN). The iterative architecture of IWUKNN continuously decreases the influence of outliers as the neighbors of the query that was incorrectly classified are slightly adjusted during each iteration. Any outliers that lead to misclassification will have minimal impact after a few rounds. For class imbalance, IWUkNN applies a class-wise weighted sum of neighbors to tackle the majority voting. Also, instances from the minority class with neighbors of the same class with higher weights will still be influential, even if the data point is surrounded by more labels from the majority class. Eventually, the majority-class labels' contribution to the classification is progressively reduced over iterations. The distinction of IWUkNN over its competitors lies in its simple construction and competitive performance, which increases its competitiveness and generalization. A thorough evaluation against nineteen models is done in eight phases using several evaluation metrics across eighty datasets. The findings, supported by multi-criteria analysis, show that IWUkNN significantly outperforms its state-of-the-art competitors by 5%–8%, on average, both generally and for specific k values, on all tests, demonstrating its effectiveness in controlling outlier contamination and class imbalance.}
}
@article{JO2026115272,
title = {Transformer-based driver identification using quantized automotive sensor data},
journal = {Applied Soft Computing},
volume = {198},
pages = {115272},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115272},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007209},
author = {Hyunjun Jo and Deok-hwan Kim},
keywords = {Driver identification, Transformer model, Automotive sensor data, OBD port, Data augmentation, Feature selection},
abstract = {Various sensors installed in vehicles are utilized across multiple domains. Among them, real-time driver identification for resource-constrained in-vehicle platforms plays a crucial role in restricting vehicle operation to authorized users and enabling personalized control, thereby enhancing both driving safety and user convenience. This study proposes a Transformer-based driver identification model that leverages OBD-II sensor data. The model incorporates quantization-based preprocessing and majority voting to improve computational efficiency and prediction stability. Additionally, Gaussian noise-based data augmentation is adopted to evaluate the model’s robustness under noisy conditions. Experiments on two public datasets show that the proposed model achieves high Accuracy and Macro F1, and remains robust under noisy conditions. Furthermore, an indirect inference latency analysis indicates that the model satisfies real-time constraints by completing predictions within the sensor input interval, validating its suitability for real-time driver identification in embedded environments.}
}
@article{DOU2026115239,
title = {Learning static and dynamic features of temporal networks for evolution communities},
journal = {Applied Soft Computing},
volume = {198},
pages = {115239},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115239},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006873},
author = {Zengfa Dou and Zhenpeng Hua and Yue Gao and Jingjing Deng and Guohua Huang and Xiaoke Ma},
keywords = {Temporal networks, Dynamic community, Nonnegative matrix factorization, Evolutionary clustering},
abstract = {Temporal networks model the evolution of complex systems, and tracking dynamic communities within them is critical for understanding the underlying systems, where both connectivity (clustering accuracy) and temporality (clustering drift) must be addressed simultaneously. Current algorithms cannot precisely model the temporality of networks at the feature level for each vertex, thereby failing to balance clustering accuracy and drift. To attack this limitation, a novel Feature Separation-based Evolution Nonnegative Matrix Factorization algorithm (Fs-ENMF) for identifying evolving communities of temporal networks is proposed. Fs-ENMF simultaneously learns feature for the conserved and dynamic structure of networks. Specifically, Fs-ENMF separates the static and dynamic parts of vertex features, where relations between the shared and conserved structure are explicitly exploited. Furthermore, dynamics of networks are measured at the feature level for each vertex, which is formulated as l2,1-norm constraint. Moreover, temporality is exploited by integrating features at the previous and current time. Finally, Fs-ENMF integrates the feature decomposition, dynamics of vertices, and temporality procedures with an optimization function and rules. Experiments demonstrate the superiority of Fs-ENMF in terms of accuracy, indicating that discriminating the static and dynamic features is promising for tracking communities in temporal networks.}
}
@article{MORAL2026115284,
title = {Computing conditional probabilities in Bayesian networks using logistic regression},
journal = {Applied Soft Computing},
volume = {198},
pages = {115284},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115284},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007325},
author = {Serafín Moral and Serafín Moral-García and Andrés Cano and Manuel Gómez-Olmedo},
keywords = {Conditional probabilities, Logistic regression, Bayesian networks, Linear discriminant analysis, Classification trees},
abstract = {This study addresses the estimation of conditional probability tables in Bayesian networks. Traditional procedures encounter difficulties when the number of parent variables is large because the number of parameters grows exponentially. Logistic regression can mitigate this dimensionality challenge, but it imposes assumptions about how a variable depends on its parents. To extend its applicability to more general scenarios, we introduce a method for systematically constructing artificial variables derived from the original predictors. We develop a general theoretical framework to compare alternative formulations of these variables. Two main approaches are proposed. The first relies on XOR combinations of the original variables, whereas the second is based on Linear Discriminant Analysis and discretization. The proposed approach is validated through an extensive empirical evaluation on large- and medium-scale networks, where we benchmark logistic regression against established techniques, including Bayesian inference procedures and probability tree models. The experiments demonstrate that logistic regression and discretization yield excellent performance while requiring fewer parameters than a full conditional probability table.}
}
@article{CHOI2026115231,
title = {Quantum-inspired genetic algorithm with chromosome clustering for 0-1 knapsack problems},
journal = {Applied Soft Computing},
volume = {198},
pages = {115231},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115231},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006794},
author = {Byoungil Choi and Jihye Jung and Joonyup Eun and In-Chan Choi},
keywords = {Genetic algorithms, Quantum computing, Quantum-inspired algorithms, Chromosome behavior analysis, Knapsack problems},
abstract = {A quantum-inspired genetic algorithm is an evolutionary method that exploits the unique features of quantum computing, which is an emerging paradigm that promises high computing power. We propose a new quantum-inspired genetic algorithm with chromosome clustering by employing the key concepts of quantum computing. The algorithm uses the feature of quantum bits to represent chromosomes probabilistically. A population is clustered using k-means clustering to form quantum registers (i.e., a collection of quantum bits) that produce a new set of chromosomes for the next generation. The new chromosomes are generated by observing the quantum states of the quantum register. Furthermore, a new local search procedure, the entanglement-guided local search, that emulates quantum entanglement is incorporated to enhance the search ability. To evaluate the proposed algorithm, we conduct extensive computational experiments on benchmark instances in the binary linear and quadratic knapsack problems. Various configurations of the algorithm are compared, and comparative experiments are performed with six benchmark heuristics. The results show that the proposed algorithm achieves average optimality gaps as low as 0.04% for large-scale linear knapsack instances (n=1000) and average gaps as low as 0.06% relative to LINDO solutions computed with a three-hour time limit for quadratic knapsack instances (n=500), significantly outperforming all six benchmark heuristics (p-value <0.01, Wilcoxon signed-rank test). The chromosome behavior of generation evolution is also graphically analyzed, and the results confirm that the proposed algorithm maintains high population diversity and proceeds with definite directionality toward near-optimal solutions.}
}
@article{DAHAL2026115276,
title = {Ensemble streamflow forecasting with diverse loss functions},
journal = {Applied Soft Computing},
volume = {198},
pages = {115276},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115276},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007246},
author = {Kshitij Dahal and Atharva Gupta and Laxman Bokati and Saurav Kumar},
keywords = {Streamflow forecasting, LSTM, Decision support, Ensemble learning},
abstract = {Streamflow modeling has significantly advanced with the advent of deep learning methods, particularly Long Short-Term Memory (LSTM) networks, which have become the state-of-the-art for rainfall-runoff simulations. Despite their success, challenges remain in forecasting due to uncertainties inherent in watershed systems and hydrological processes across varying flow conditions. In this study, we propose a novel approach to improve streamflow forecasts by training LSTM models using diverse objective (loss) functions to capture those varying flow conditions and combining their outputs through Linear Stacking Ensemble. By leveraging eight different loss functions (Mean squared error, Nash-Sutcliffe Efficiency, Kling-Gupta Efficiency, Huber loss, quantile losses at 0.15 and 0.85, and expectile losses at 0.15 and 0.85), we aimed to capture various aspects of the hydrograph and associated uncertainties. We employ the CAMELS dataset via the Caravan framework, utilizing 482 catchments across the United States. Our results showed that the ensemble forecasts obtained through ensemble improves overall predictive performance and also effectively quantifies uncertainty, outperforming individual models across multi-step forecasting horizons (daily up to 30 days). Statistically, the Ensemble achieved a significant improvement in Nash-Sutcliffe Efficiency against the individual models across all horizons. And, training the model with multiple loss functions achieved an uncertainty coverage of 93.41%, 83.32%, and 81.72% for 1, 7, and 30 days forecast, respectively on the test (unseen) dataset. This methodology provides a scalable and operationally feasible solution for enhancing streamflow forecasts, with potential applications in data-scarce regions and real-time operational hydrology.}
}
@article{HUANG2026115227,
title = {A deep belief rule with backward deduction process for the autonomous underwater vehicle fault diagnosis},
journal = {Applied Soft Computing},
volume = {198},
pages = {115227},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115227},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006757},
author = {Haolan Huang and Jiahao Mai and Wei He and Ning Ma and You Cao},
keywords = {Belief rule base, Fault diagnosis, Rule explosion, Backward deduction, Evidential reasoning},
abstract = {The Autonomous Underwater Vehicle (AUV) play a critical role in marine exploration. Fault diagnosis must be performed with limited time and resources to ensure operational safety and mission continuity. This task, however, faces serious challenges due to complex environmental factors. The belief rule base (BRB) is a complex system of knowledge representation as well as reasoning methods that are uniquely suited to handle uncertain information in the AUV fault diagnosis process. But the multi-attributes lead to the rule explosion and the increase of reasoning uncertainty, which reduces the reliability of the system. Therefore, this paper elaborates a deep belief rule method with backward deduction process (CDBRB-BD). To address the problem of rule explosion and reduce model complexity, feature correlation is first incorporated into the construction of the deep structure. Then, evidential reasoning (ER) is used as the inference engine of the model. Finally, a reverse inference mechanism is built using the BRB structure to explore the causes of results and enhance the model's reliability and interpretability. Experimental results show that the CDBRB-BD method achieves an accuracy of 98.85% in AUV fault diagnosis. It is proven to be an effective and interpretable diagnostic approach.}
}
@article{ELOMIYA2026115247,
title = {A GIS-MCDM framework for the smart parcel locker site suitability analysis and optimizing urban last-mile delivery},
journal = {Applied Soft Computing},
volume = {198},
pages = {115247},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115247},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006952},
author = {Akram Elomiya and Jiří Křupka and Vladimir Simic and Libor Švadlenka and Stefan Jovčić and Dragan Pamucar},
keywords = {Parcel lockers, Last-mile delivery, Geographic information systems, Multi-criteria decision-making, E-commerce},
abstract = {The surge in e-commerce has intensified the need for efficient urban last-mile delivery, with smart parcel lockers emerging as a sustainable solution. However, their optimal placement remains challenging due to spatial heterogeneity and decision uncertainty. This research proposes a five-stage methodology integrating Geographic Information Systems (GIS) with Multi-Criteria Decision-Making (MCDM) to strategically site parcel lockers. The approach combines expert-driven criteria selection via Delphi method, Fuzzy Analytic Hierarchy Process (FAHP) for criteria weighting while managing inherent judgmental ambiguity, GIS-based suitability mapping, and the Technique for Order of Preference by Similarity to Ideal Solution (TOPSIS) for ranking candidate sites. A case study in Pardubice, Czech Republic, validated the framework, recommending 50 new parcel locker sites. Sensitivity analysis highlighted road network accessibility, public transport proximity, and population density as critical criteria. By combining spatial analysis with structured decision-making, this study offers a reliable, transferable framework for optimizing parcel locker placement, enhancing last-mile delivery efficiency, and supporting sustainable urban logistics globally.}
}
@article{WAN2026115292,
title = {Adaptive railway alignment optimization via graph convolutional network-enhanced reinforcement learning in constrained environments},
journal = {Applied Soft Computing},
volume = {198},
pages = {115292},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115292},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007404},
author = {Xinjie Wan and Hao Pu and Paul Schonfeld and Yang Ran and Lihui Peng},
keywords = {Railway design, Adaptive alignment optimization, Graph convolutional network, Reinforcement learning, Constrained environments},
abstract = {As railways expand into constrained environments with complex terrain and numerous obstacles, traditional computer-aided alignment optimization methods typically struggle with low efficiency and local optima, because of their “Design alignment before evaluation” strategy and predetermined search direction. To overcome these problems, a Graph Convolutional Network (GCN)-enhanced Reinforcement Learning (RL) method is proposed, shifting to an “Evaluate environment before alignment design” approach with an adaptively updated alignment generation mechanism. In this method, alignment-favorable regions are first designated as nodes, and their intricate interrelations are encoded into a graph representation, laying the groundwork for efficient path optimization. During the path search process, eleven types of node features, including geometric, topological, and semantic aspects, are embedded into RL state via GCN to improve local perception, while globally heuristic reward components are designed and integrated into the RL reward function to enhance global awareness. As the RL training stabilizes, a diverse set of optimized path corridors is generated. These paths are then refined into final alignment alternatives using a customized box-constrained Particle Swarm Optimization (PSO) algorithm. Finally, the effectiveness of the proposed method is verified through ablation studies and a real-world railway project. Specifically, the optimized alignment generated by the proposed method achieves a 13.1% improvement in aggregated environmental suitability and a 1.7% reduction in construction cost compared to a manually-designed solution.}
}
@article{BARKHORDARI2026115281,
title = {An encoder-only transformer model for predicting soil temperature from time series data},
journal = {Applied Soft Computing},
volume = {198},
pages = {115281},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115281},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007295},
author = {Mohammad Sadegh Barkhordari and Mohammad Mahdi Barkhordari and Chongchong Qi},
keywords = {Soil temperature prediction, Encoder-only transformer, Deep learning, Time series forecasting, Feature engineering},
abstract = {Accurate soil temperature prediction is crucial for environmental and agricultural applications, yet traditional methods face significant limitations. This study introduces and rigorously evaluates an Encoder-only Transformer Model (EoTM) for predicting daily mean soil temperature using solely historical time series data. The model leverages a meticulously engineered feature set, incorporating cyclical temporal encodings, lagged values, and derived statistics from past soil temperatures, thereby obviating the need for external meteorological inputs. Performance was benchmarked against classical time series models (Seasonal Naive, Holt-Winters, MSTL) and established machine learning algorithms (AdaBoost, Bagging, Decision Tree, Gradient Boosting, XGBoost) using daily soil temperature data from two depths (2CM and 25CM) at the Bear Brook Watershed in Maine (BBWM). Results demonstrate the EoTM's superior predictive accuracy, achieving substantially lower Mean Absolute Error (MAE) and Root Mean Squared Error (RMSE) with near-zero bias compared to all baselines. For instance, on the 2CM test dataset, EoTM yielded an MAE of 0.1768 and RMSE of 0.2567, significantly outperforming the best classical (MSTL) and machine learning (XGBoost) competitors. Furthermore, uncertainty analysis revealed EoTM's strong calibration properties, with the lowest miscalibration area (0.06). The study highlights the efficacy of a simplified transformer architecture for robust soil temperature forecasting, offering a powerful, computationally efficient tool with broad applicability, especially in data-scarce regions.}
}
@article{CHENG2026115257,
title = {A portable deep learning system for automated corrosion segmentation and grading on hydraulic steel structures},
journal = {Applied Soft Computing},
volume = {198},
pages = {115257},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115257},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007052},
author = {Haodong Cheng and Fei Kang and Sisi Zhu and Xing Hu},
keywords = {Hydraulic metal structures, Transformer, Corrosion detection, Edge deployment, Dam safety},
abstract = {Accurate detection of surface corrosion on hydraulic steel structures is critical for ensuring dam safety. Addressing the low efficiency and insufficient intelligence of conventional inspections, this paper proposes an intelligent corrosion detection system. First, for corrosion segmentation, a Transformer-based network is constructed. In this network, a custom-designed wavelet residual downsampling with anti-aliasing module is introduced at the input to effectively preserve spatial information during downsampling, while a frequency-enhanced Transformer backbone is built to boost semantic feature representation. Second, a YOLOv8n-cls network based on transfer learning is employed to accurately identify four corrosion severity grades. Additionally, a self-check mechanism is established by integrating gradient-weighted class activation mapping with segmentation results to identify potential misdetections and expand training data. Experimental results show that the proposed system achieves over 90% accuracy in both segmentation and classification, while maintaining a frame rate suitable for real-time detection and demonstrating strong robustness. Finally, the system is deployed on a portable inspection terminal (RK3588), with its effectiveness and reliability validated in both field engineering data and laboratory simulation scenarios.}
}
@article{THANKACHAN2026115301,
title = {Automated educational task generation and solution guidance using LLMs and reinforcement learning},
journal = {Applied Soft Computing},
volume = {198},
pages = {115301},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115301},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007490},
author = {Jeena A. Thankachan and Bama Srinivasan and Nandini Bhupathy},
keywords = {Large language models (LLMs), Reinforcement learning (RL), Personalised learning, Crossword puzzle generation, Adaptive educational tools},
abstract = {Recent advances in artificial intelligence have created new opportunities to automate educational content generation and support interactive learning environments. This work proposes an AI-assisted framework that integrates a fine-tuned Large Language Model (LLM) with a Reinforcement Learning (RL) agent to automatically generate and support puzzle-based learning tasks. The LLM generates concise question–answer pairs from instructional text, which are subsequently structured into crossword puzzles through an automated puzzle construction module. During task execution, an RL-based agent provides procedural solution guidance to assist learners while solving the puzzles. The performance of the LLM-generated content is evaluated using ROUGE metrics and expert-based pedagogical assessment. Expert evaluation indicates high clarity (average score 4.7/5) and full curricular alignment of the generated questions, although most items correspond to the lower cognitive levels of Bloom’s taxonomy. In addition, learner interaction data are analysed using Cognitive Evaluation Metrics (CEM) organised within a COGLM-based framework to examine cognitive indicators across repeated task attempts. An exploratory user study involving 10 undergraduate learners demonstrates statistically significant improvements across successive puzzle attempts, including increased scores (p < 0.001, Cohen’s d = 4.49), reduced error rates (p < 0.001), and decreased task completion time (p = 0.005). These findings demonstrate the functional feasibility of integrating generative models, automated puzzle construction, reinforcement learning assistance, and cognitive performance analysis within a unified educational framework. The proposed system provides a scalable mechanism for automated task generation and repeated learner practice, with potential applicability in flipped-classroom and virtual learning environments.}
}
@article{WU2026115273,
title = {A deep learning-based approach for intelligent detection of road manhole cover conditions using a mobile data acquisition system},
journal = {Applied Soft Computing},
volume = {198},
pages = {115273},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115273},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007210},
author = {Yujie Wu and Jiguang Dai},
keywords = {Manhole cover defect, Object detection, Smart City, State space model},
abstract = {Road manhole covers are essential components of urban road infrastructure, and their condition directly affects urban safety. Conventional manual inspection and image-based detection methods are labor-intensive, time-consuming, and exhibit limited generalizability, making them unsuitable for large-scale automated inspection. To address these limitations, this study proposes an intelligent framework for manhole cover condition assessment based on a mobile data acquisition system and deep learning. Using the proposed mobile system, 500,000 road surface images were collected across diverse scenarios in Shenyang and Fuxin (Liaoning Province) and Shijiazhuang (Hebei Province). A representative subset was selected to construct two datasets: (1) a large-scale dataset covering three condition categories (normal, damaged, and severely abnormal) and (2) a cross-regional validation dataset. To mitigate challenges such as scale variation and complex background interference, we developed the MCS-YOLO model. It incorporates a Dual Feature-Enhanced Backbone (DFEB) for improved geometric representation and multi-scale feature extraction, and a Cascade-Iterative Fusion Neck (CFN) for effective integration of fine-grained and semantic features. Experimental results on two public datasets and the self-constructed dataset demonstrate that MCS-YOLO outperforms state-of-the-art methods in detection accuracy while maintaining competitive inference speed. Its robustness was further validated through cross-regional experiments. A comprehensive evaluation of manhole cover conditions showed strong consistency with field survey findings. Overall, the proposed method provides a fast, cost-effective, and accurate solution for intelligent manhole cover defect detection, supporting smart infrastructure operation and maintenance. The dataset and source code are publicly available at: https://github.com/xiaotaiyang-ops/MCS-YOLO.}
}
@article{JANG2026115289,
title = {Resilient fault diagnosis and recovery framework for driving modules of electric vehicles using continuous wavelet transform-based fault-aware deep learning},
journal = {Applied Soft Computing},
volume = {198},
pages = {115289},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115289},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007374},
author = {Jaeuk Jang and Hyunsoo Lee},
keywords = {Continuous Wavelet Transform (CWT), Current sensor fault diagnosis, Electric vehicle, Fault Diagnosis and Recovery, Permanent Magnet Synchronous Motor (PMSM)},
abstract = {In complex and interdependent systems such as electric vehicles, maintaining operational resilience requires timely detection and mitigation of component-level faults. Among these, current sensor faults in Permanent Magnet Synchronous Motor (PMSM) widely adopted for their high efficiency and controllability can propagate through control loops and lead to severe system-level disruptions. Such faults, if undetected, may result in degraded motor performance, unstable outputs, and even safety-critical failures. Therefore, robust and real-time fault diagnosis is crucial for ensuring resilient operation of PMSM-based EV systems. In order to address this, this study proposes a new and effective fault diagnosis and signal recovery framework based on Continuous Wavelet Transform (CWT)-based data conversion and a deep encoder-decoder architecture integrated with a confidence-guided fault-aware weighting mechanism. This process enables both accurate fault diagnosis and effective restoration of gain and zero-offset fault signals through a dual encoder–decoder model, in which the contribution of fault-specific encoders is adaptively weighted based on fault classification confidence. The proposed framework demonstrates higher fault diagnosis accuracy and resilient signal recovery capability compared to existing methodologies through experiments conducted using an implemented EV driving simulator that replicates real road driving cycles. These analyses demonstrate that the proposed CWT-based fault-aware deep learning framework contributes to real-time fault diagnosis and resilient control of PMSMs during driving.}
}
@article{WEI2026115265,
title = {A detection method for tea geometrids in complex environments by deblurring generative adversarial and double-branch networks},
journal = {Applied Soft Computing},
volume = {198},
pages = {115265},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115265},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007131},
author = {Zijing Wei and Gensheng Hu and Yongcheng Jiang and Wenxia Bao},
keywords = {Object detection, Tea geometrid, Complex environment, Image deblurring, Double-branch network},
abstract = {The tea geometrid is a common tea pest causing significant damage to tea yield and quality. This study proposed a detection method for tea geometrids in complex environments by deblurring generative adversarial and double-branch networks to reduce false and missed detections, thereby improving the accuracy of detection. To address the issue of target blurring that lens defocusing causes, this study proposed a deblurring generative adversarial network. By generative adversarial contrast learning between clear and blurred samples and introducing physical constraints through the blind deconvolution-based deblurring module, the image details in blurred regions are reconstructed. To address the interference issues that complex environments in tea geometrid images cause, a double-branch detection network is designed. By combining the local detail extraction capabilities of convolutional neural network with the global perception abilities of Transformer, the double-branch network fully extracts feature information from the limited tea geometrid samples. In addition, feature enhancement is applied to improve the contrast between tea geometrids and interference objects. Experimental results of the tea geometrid image dataset show that the proposed method achieves Precision, Recall, and mAP values of 97.4%, 98.2%, and 96.3%, respectively. Compared to state-of-the-art detection models, these correspond to improvements of 1.5%, 22.4%, and 10%, respectively. Compared to the latest tea geometrid detection methods, this study achieved improvements of 2.5%, 4%, and 7%, respectively.}
}
@article{DUARTE2026115242,
title = {Leveraging graph neural networks and mobility data for COVID-19 forecasting},
journal = {Applied Soft Computing},
volume = {198},
pages = {115242},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115242},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006903},
author = {Fernando H.O. Duarte and Gladston J.P. Moreira and Eduardo J.S. Luz and Leonardo B.L. Santos and Vander L.S. Freitas},
keywords = {Graph neural networks, Time series forecasting, Mobility networks, Backbone extraction, COVID-19},
abstract = {The COVID-19 pandemic has claimed millions of lives, spurring the development of diverse forecasting models. In this context, the true utility of complex spatio-temporal architectures versus simpler temporal baselines remains a subject of debate. Here, we show that structural sparsification of the input graph and temporal granularity are determining factors for the effectiveness of Graph Neural Networks (GNNs). By leveraging human mobility networks in Brazil and China, we address a conflicting scenario in the literature: while standard LSTMs suffice for smooth, monotonic cumulative trends, GNNs outperform baselines when forecasting volatile daily case counts. We show that backbone extraction substantially enhances predictive stability and reduces predictive error by removing negligible connections. Our results indicate that incorporating spatial dependencies is essential for modeling complex dynamics. Specifically, GNN architectures such as GCRN and GCLSTM outperform the LSTM baseline (Nemenyi test, p<0.05) on datasets from Brazil and China for daily case predictions. Lastly, we frame the problem as a binary classification task to better analyze the dependency between context sizes and prediction horizons.}
}
@article{CAO2026115214,
title = {A double deep reinforcement learning-driven sparse large-scale multi-objective optimization algorithm},
journal = {Applied Soft Computing},
volume = {198},
pages = {115214},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115214},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006629},
author = {Jie Cao and Min Tian and Zuohan Chen and Jianlin Zhang and Chengzhi Liu},
keywords = {Sparse multi-objective optimization, Sparse large-scale, Evolutionary computation, Deep reinforcement learning},
abstract = {Sparse large-scale multi-objective optimization problems (SLMOPs) are prevalent in real-world applications, where the curse of dimensionality and the sparsity pattern (most decision variables being zero) pose significant optimization challenges. Addressing these problems requires algorithms capable of handling high-dimensional decision spaces while discovering sparse distributions of Pareto optimal solutions. However, most existing multi-objective evolutionary algorithms (MOEAs) struggle to achieve satisfactory results. To tackle this challenge, we propose a double deep reinforcement learning-driven sparse large-scale multi-objective optimization algorithm. In the proposed approach, two deep reinforcement learning networks are utilized to extract sparse features as states from the current population, considering the overall improvement in population convergence and diversity as rewards, and treating three designed crossover fitness and three optimal sparsity knowledge as actions. By establishing mapping models between population states and the expected cumulative rewards of crossover fitness and optimal sparsity knowledge through these two networks, we dynamically determine the crossover fitness and optimal sparsity knowledge for each generation to guide variable crossover and mutation operations. Additionally, we propose a variable importance-guided mutation operator that continuously drives population evolution toward optimal sparsity patterns, thereby maintaining excellent sparse characteristics throughout optimization. Experimental results on eight benchmark problems (SMOP1-SMOP8) and three real-world problems demonstrate that the proposed algorithm outperforms five state-of-the-art sparse MOEAs (SMOEAs) in terms of the statistical results of the Inverted Generational Distance (IGD) values on 32 test instances and the Hypervolume (HV) values on 8 test instances.}
}
@article{MIAO2026115303,
title = {Reliable fault diagnosis via self-learning sparse kernel convolution and attention-enhanced feature embedding},
journal = {Applied Soft Computing},
volume = {198},
pages = {115303},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115303},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007519},
author = {Jianguo Miao and Man Dong and Sheng Lu and Renliang Zhang and Congying Deng},
keywords = {Self-learning sparse kernel convolution, Fault diagnosis, Parameter embedding, Efficient convolutional attention, Sub-kernel, Learnable offsets},
abstract = {Ensuring reliable fault diagnosis is essential for the safety and performance of mechanical systems. Although convolutional neural network (CNN) is widely used for feature extraction, traditional architectures often lack interpretability and struggle to model long-range periodic patterns critical for accurate diagnosis. To address this, an interpretable framework termed the self-learning sparse kernel convolutional neural network (SL-SKCNN) is proposed. Specifically, a novel self-learning sparse kernel convolution (SL-SKConv) is developed, where kernel structures are dynamically adapted to input variations via multi-sub-kernel configuration and a parameter self-learning mechanism. This design improves the network's sensitivity to both local patterns and long-term periodic features. To further enhance fault-related feature representation, a sparse convolution parameter embedding (SCPE) strategy is introduced. This strategy explicitly embeds the spacing parameters of SL-SKConv into high-dimensional features, thereby enriching the semantic content of the learned representations. Additionally, an efficient convolutional attention mechanism (ECAM) is introduced to jointly capture inter-channel and intra-channel feature dependencies, enhancing the model’s focus on informative features. Experimental results on four datasets demonstrate that the proposed method significantly improves feature extraction capabilities over conventional convolution and attentions, which achieves superior fault diagnosis performance. In particular, on the Case Western Reserve University (CWRU) bearing dataset, with only 20 samples per class, SL-SKCNN achieves an accuracy of 95.58%, which outperforms the best baseline method (dynamic convolution) by 3.14%.}
}
@article{XIANG2026115237,
title = {HGOT-SER: Hybrid genetic optimization for multi-granularity Transformer-based speech emotion recognition},
journal = {Applied Soft Computing},
volume = {198},
pages = {115237},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115237},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600685X},
author = {Fei Xiang and Hongbo Liu and Lijun Pan and Lili Liu and Junjie Hou and Xingang Wang and Ruili Wang},
keywords = {Speech emotion recognition, Hybrid genetic optimization, Adaptive cyclic mutation strategy, Multi-granularity transformer},
abstract = {Speech emotion recognition (SER) has wide applications in many real-world areas such as customer service, healthcare, and intelligent agents. Recently, Transformer-based models have been used in SER. However, training these models predominantly relies on gradient-based optimization methods, which may become trapped in local optima, affecting recognition accuracy. To address this issue, we propose a hybrid genetic optimization model for multi-granularity Transformer-based speech emotion recognition (HGOT-SER). HGOT-SER employs a gradient-genetic synergistic optimization mechanism, including (i) a stochastic gradient descent for rapid convergence to a near-optimal region, and then (ii) a genetic algorithm with an adaptive cyclic mutation strategy to fine-tune parameters and escape the local optima. To enhance emotional feature extraction, HGOT-SER introduces a multi-granularity Transformer as its backbone, which extracts acoustic features through parallel temporal windows of different sizes, enabling more effective hierarchical temporal modeling. Experiments on the IEMOCAP, CASIA, EMODB, and RAVDESS datasets show that HGOT-SER outperforms the multi-granularity Transformer, achieving improvements exceeding 1.2% in weighted accuracy and 1.1% in unweighted accuracy on all datasets. HGOT-SER also outperforms state-of-the-art methods on the CASIA and EMODB datasets. These results demonstrate the effectiveness and robustness of HGOT-SER on multiple SER datasets.}
}
@article{DAVOODI2026115222,
title = {A review of artificial intelligence techniques applied to subsurface oil and gas reservoir simulation},
journal = {Applied Soft Computing},
volume = {198},
pages = {115222},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115222},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006708},
author = {Shadfar Davoodi and Nikita Makarov and David A. Wood and Mohammed Al-Shargabi and Vladimir Vanovskiy and Dmitry Koroteev and Valeriy S. Rukavishnikov and Evgeny Burnaev},
keywords = {Artificial intelligence techniques, Reservoir simulation, History matching, Hybrid modeling, Production optimization},
abstract = {The integration of artificial intelligence (AI) into reservoir simulation (RS) has rapidly evolved, offering new solutions to long-standing challenges in predicting subsurface behavior. Although recent advances have improved the accuracy of fluid-flow modeling and reservoir performance forecasting, issues related to computational cost, data complexity, and model scalability persist. This review, therefore, explores the transformative role of AI in enhancing RS, with a particular focus on three core areas: history matching (HM), production optimization, and computational acceleration. To achieve this, the study systematically analyzes AI-driven approaches, including the historical development of RS and its multiple challenges with data obstacles. These include data volume and quality, input variable prioritization through feature selection, and objective function refinement. Reservoir property assessment across clastic and carbonate formations, alongside AI-enabled strategies for optimizing well placement and well production and injection planning pose additional challenges. The review finds that AI significantly enhances prediction accuracy and reduces simulation time while offering scalable solutions to big-data challenges in RS workflows, leading to better decision-making. Despite these advancements, obstacles remain in the real field deployment of AI models, the interpretation of their output results, and the assurance of consistent performance across various reservoirs. This highlights the necessity for hybrid physics and AI methodologies, in conjunction with automated, high-performance computing workflows, and learning from real field applications to address these deficiencies. This review provides a structured perspective on leveraging AI to advance reservoir engineering practices, enhance predictive capabilities, and maximize hydrocarbon recovery in an economically and operationally viable manner. It also identifies key challenges and research gaps and offers recommendations for future directions.}
}
@article{JI2026115189,
title = {A semantic-aware approach to ontology revision using pre-trained language models},
journal = {Applied Soft Computing},
volume = {198},
pages = {115189},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115189},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600637X},
author = {Qiu Ji and Guilin Qi and Xiaoping Zhang and Yuxin Ye and Jiaye Li and Keyu Wang and Yang Sheng},
keywords = {Ontology revision, Inconsistency handling, Ontology matching, Pre-trained language models, Knowledge reasoning},
abstract = {Ontology revision aims to seamlessly incorporate a new ontology into an existing ontology and plays a crucial role in ontology evolution, ontology maintenance, and ontology alignment. Similar to single-ontology repair, addressing logical incoherence in ontology revision is essential, as incoherence can lead to inconsistency, which in turn results in meaningless reasoning outcomes.To tackle this issue, various ontology revision approaches have been proposed, focusing on defining revision operators and designing axiom ranking strategies. However, most existing approaches overlook axiom semantics, which provide critical information for distinguishing axioms. Meanwhile, pre-trained language models (PLMs) have demonstrated strong capabilities in encoding semantic information and have been widely applied in natural language processing and ontology-related tasks. In this paper, we propose a novel semantic-aware approach to ontology revision that leverages PLMs. Within this approach, we define four scoring functions based on axiom embeddings from a PLM, and propose two revision algorithms: one that resolves incoherence by scoring axioms within all minimal incoherence-preserving sub-ontologies, and an efficient adapted algorithm that processes unsatisfiable concepts in groups. Comprehensive evaluation on 19 ontology pairs shows our approach achieves up to 90% time reduction while maintaining high performance on novel qualitative metrics—Correctness and Semantics Preservation. We also provide practical algorithm selection guidelines based on analysis of PLMs and user priorities.}
}
@article{QIN2026115246,
title = {Underwater image enhancement via dual-domain experts with hybrid-masked contrastive learning},
journal = {Applied Soft Computing},
volume = {198},
pages = {115246},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115246},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006940},
author = {Jiajie Qin and Renjie Xu and Jun Wang and Sichao Fu and Baodi Liu},
keywords = {Dual-domain experts, Mamba, Hybrid masked contrastive learning, Underwater image enhancement},
abstract = {Underwater image enhancement (UIE) addresses critical challenges of color distortion, contrast degradation, and detail blurring caused by light absorption and scattering. However, existing methods exhibit certain limitations: single-domain approaches demonstrate insufficient discriminative capabilities, multi-domain strategies incur feature redundancy and inter-domain conflicts, excessive reliance on pseudo-reference images that retain residual degradation, and fixed negative samples impairing environmental adaptability. To tackle these issues, we propose a dual-domain expert network guided by contrastive learning (DECL-Net) featuring three key innovations: (1) Spatial-frequency domain Mamba enabling efficient dual-domain modeling for both global and local representation, (2) Domain-adaptive mixture of experts (DAMoE) dynamically balancing spatial and frequency domain fusion features while suppressing feature redundancy, (3) Hybrid masked contrastive learning (HMCL) synthesizing environment-aware negative samples to bypass pseudo-reference dependency and better match real-world degradation dynamics. Extensive experiments on six underwater benchmarks (UIEB, LSUI, EUVP, U45, UCCS, and C60) demonstrate that DECL-Net achieves top-tier performance, ranking among the top two methods across the majority of quantitative metrics, while exhibiting strong generalization and visual quality. Moreover, DECL-Net maintains competitive efficiency, with the second-lowest computational cost (11.18 GFLOPs) and a relatively low parameter count (3.92 M, ranking fourth). Ablation studies further validate the contribution of each component, confirming the robustness, generalization capability, and efficiency of DECL-Net for real-world underwater image enhancement.}
}
@article{REHMAN2026115283,
title = {MTGUSC-Net: A multi-task gastric ultrasound segmentation and classification network via multi-scale attention feature fusion and adaptive multi-scale pooling},
journal = {Applied Soft Computing},
volume = {198},
pages = {115283},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115283},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007313},
author = {Mustafain Rehman and Zhijun Liu and Miao Fan and Ahsan Humayun and JinHao Yu and KeMeng Cui and ShiJun Su and Wei Yang and Zhi Li and Bin Liu},
keywords = {Gastric ultrasound, Multi‑task learning, Lesion segmentation, Multi‑scale attention, Multi-scale pooling},
abstract = {Gastric cancer remains a leading cause of cancer-related death worldwide, with a five‑year survival rate of 10–30% despite nearly one million new cases annually. Early detection can increase the five-year survival rate to approximately 90%, yet conventional screening modalities remain invasive, painful, and operator-dependent. Ultrasound offers a non-invasive alternative; however, low contrast and speckle noise hinder accurate lesion delineation. This study introduces MTGUSC-Net, a unified multi-task framework designed for simultaneous lesion segmentation and image classification using gastric ultrasound images. The framework integrates a VGG16-based squeeze-and-excitation encoder, a multi-scale attention feature fusion block (MSA-FFB), and an adaptive multi-scale pooling block (AMSPB) to capture contextual features and aggregate spatial information. A depth-wise up-sampling decoder reconstructs high-resolution masks, while a classification branch distinguishes between normal and cancer images. We introduce a novel dataset of 461 gastric ultrasound images, comprising 211 cancer images with expert-annotated lesion boundaries and 250 normal images. We further expanded the dataset using six distinct image augmentation techniques to increase data diversity. Trained and tested on a novel dataset, MTGUSC-Net achieved an intersection over union score of 79.33%, a dice similarity coefficient of 87.41%, and a classification accuracy of 99.09%. Ablation studies confirmed the effectiveness of the MSA-FFB, AMSPB, and composite loss in enhancing boundary accuracy and mask completeness. MTGUSC-Net offers robust and high-precision lesion segmentation and classification on gastric ultrasound images, providing a cost-effective and non-invasive tool for computer-aided diagnosis and improved patient outcomes. Future work will focus on multi‑center validation and real‑time clinical deployment.}
}
@article{HE2026115278,
title = {A novel multi-modal dynamic integration model for carbon price prediction considering data distribution feature drift and optimal diverse base model set},
journal = {Applied Soft Computing},
volume = {198},
pages = {115278},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115278},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600726X},
author = {Maolin He and Jujie Wang},
keywords = {Carbon price prediction, Multi-objective pruning algorithm, Optimal diverse integration, Data distribution feature drift},
abstract = {Accurate carbon price forecasting is crucial for enterprises, individuals, and governments to manage environmental impacts and financial risks effectively. However, carbon prices exhibit highly nonlinear and nonstationary characteristics, which leads to data distribution drift and model misalignment, posing significant challenges for reliable prediction. To address these challenges, this study proposes a novel multi-modal dynamic ensemble model that explicitly accounts for data distribution drift and incorporates adaptive base model selection. First, a real-time stepwise decomposition strategy is applied to extract stationary and trend components from the original price series. Second, a diverse set of base models, including online learning approaches, is constructed to enhance responsiveness to evolving patterns and improve robustness against data drift. To avoid performance degradation caused by redundant models, a multi-objective pruning algorithm is employed to select the optimal subset of base learners. Finally, a dynamic weighting mechanism updates the ensemble weights based on historical prediction errors, further improving model adaptability. Experimental results across nine carbon markets show that the proposed model achieves average improvements of 40%, 38%, and 42% in RMSE, MAE, and MAPE respectively over all benchmark models, demonstrating superior overall forecasting performance. The findings suggest that the proposed model offers a promising pathway for improving predictive reliability in complex environmental systems characterized by uncertainty and nonstationary.}
}
@article{WANG2026115299,
title = {MPMGLF: A multi-period interpretable multivariate coupled gravitational graph loop learning framework for loess landslide prediction},
journal = {Applied Soft Computing},
volume = {198},
pages = {115299},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115299},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007477},
author = {Yi Wang and Yuchen Li and Fushuai Ping and Tianfeng Gu and Jiading Wang},
keywords = {Multi-period interpretation mechanism, Multivariate coupled gravitational graph learning, Loop graph learning, Loess landslide prediction},
abstract = {Accurate landslide displacement prediction is crucial for disaster prevention and mitigation. However, existing deep learning models exhibit significant limitations. They fail to adequately capture the ambiguous temporal dependencies embedded in complex landslide evolution patterns. Furthermore, they cannot explicitly characterize the coupling effects of environmental factors or their differential influences on landslide triggering. To address these limitations, this study introduces graph structure learning as a novel perspective. This approach jointly interprets the coupling mechanisms of environmental factors, the dynamic response of landslides driven by multiple factors, and the intrinsic algorithmic principles. Consequently, we establish the Multi-Period Interpretable Multivariate Coupled Gravitational Graph Loop Learning Framework (MPMGLF). To the best of our knowledge, this is the first framework specifically designed for loess landslide displacement prediction. MPMGLF employs a multi-period recognition mechanism to deeply capture multiscale displacement characteristics. This process effectively disambiguates complex temporal dependencies. Simultaneously, the multivariate coupled gravitational graph learning module captures both local and global dependencies between channels. This representation models the coupling effects of environmental factors and their distinct impacts on displacement. Thus, the framework enables an interpretation of landslide mechanisms based on graph structure. Experimental results on loess landslide units and multivariate prediction tasks demonstrate that MPMGLF outperforms ten state-of-the-art algorithms in both accuracy and timeliness. Furthermore, comprehensive evaluations across seven datasets spanning four domains indicate that MPMGLF consistently ranks first against advanced temporal modeling approaches. These results validate its reliability, generalizability, and transferability across domains. This work opens a new window for dynamic landslide prediction. It also offers a novel perspective and solution pathway for broader time-series forecasting challenges.}
}
@article{MAO2026115275,
title = {Prompt-driven transformer for brain tumor segmentation with missing modalities},
journal = {Applied Soft Computing},
volume = {198},
pages = {115275},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115275},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007234},
author = {Keming Mao and Yechuan Xu and Kunyu Wang and Bin Zhang},
keywords = {Brain tumor segmentation, Multi-modal, Missing modalities, Prompt-driven},
abstract = {Brain tumor segmentation from multi-modality magnetic resonance imaging (MRI) plays an important role in diagnosis, treatment planning, and prognosis evaluation. However, most existing deep learning methods assume that all MRI modalities are available, whereas in clinical practice some modalities may be missing due to motion artifacts, acquisition failure, or patient-specific factors. This missing-modality setting severely degrades segmentation performance, especially for the enhancing tumor region when the T1c modality is absent. To address this challenge, we propose a novel Prompt-driven Transformer, termed PDFormer, for unified brain tumor segmentation under arbitrary missing modality scenarios. Specifically, we design a Missing Modality Prompt Generator (MMPG) to learn a universal prompt and dynamically derive modality-state-aware prompts for different missing patterns. A Prompt-driven Integrator (PDI) is further introduced to progressively inject the prompt information into both intra-modality and inter-modality feature interactions, enabling the model to effectively exploit local and global contextual cues under incomplete inputs. Moreover, to alleviate the severe performance drop caused by the absence of the key T1c modality, we propose an Activator Generator (ActGen) that synthesizes compensatory modality-specific information through a self-distillation strategy. Extensive experiments on the public BraTS2018, BraTS2020, and BraTS2021 datasets demonstrate that PDFormer consistently outperforms representative state-of-the-art methods across diverse missing modality settings. In addition, statistical analysis on the large-scale BraTS2021 benchmark confirms that the observed improvements are significant and robust. These results show that PDFormer provides an effective and practical solution for brain tumor segmentation with incomplete multi-modal MRI.}
}
@article{YANG2026115250,
title = {Maximizing the risk-adjusted return of classification model-based investments},
journal = {Applied Soft Computing},
volume = {198},
pages = {115250},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115250},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006988},
author = {Jaewon Yang and Woojin Chang},
keywords = {Finance, Stock prediction, Neural network, Optimization, Classification model},
abstract = {While machine learning models are widely used for stock prediction, their training objectives, focused on predictive accuracy, often misalign with the ultimate financial goal of maximizing risk-adjusted returns. This study bridges this critical disconnect by introducing a goal-directed optimization framework that directly aligns a model’s training with investment performance. Our core contribution is the introduction of a novel insight linking classification rate metrics to financial outcomes in typical classification model-based investment strategies. Specifically, we verify that a model’s precision is positively correlated with expected portfolio returns, while its positive prediction rate (ppr) governs portfolio risk through diversification. Leveraging this insight, we reformulate the investment task as a constrained optimization problem: maximizing model precision subject to a minimum ppr constraint, thereby directly optimizing for risk-adjusted return within the training loop. Empirically validated on the US stock market from 1995 to 2024 across four neural network architectures, our framework achieves an average Sharpe ratio of 7.5 after transaction costs. This result significantly and robustly outperforms identical models trained with conventional likelihood-based objectives, providing clear evidence for the superiority of our approach. The framework proposed in this work can be easily applied to train deep learning models with complex neural network architectures, and can be useful in most financial markets where profitability and risk are important.}
}
@article{SUN2026115263,
title = {DpmViL: A novel lightweight hybrid vision-LSTM model for driver distraction detection},
journal = {Applied Soft Computing},
volume = {198},
pages = {115263},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115263},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007118},
author = {Haibin Sun and Xinghui Song},
keywords = {Driver distraction detection, Lightweight networks, Efficient multi-dimensional attention, Vision LSTM},
abstract = {Driver distraction detection is essential for traffic safety but faces a critical trade-off between recognition accuracy and computational efficiency on edge devices. This paper proposes DpmViL, a novel lightweight hybrid model that synergizes the spatial inductive bias of convolutions with the linear-complexity global modeling of Vision LSTM (ViL). The framework introduces three key modules to bridge existing research gaps: (1) the Depthwise-Efficient Convolution Module (DEC), which utilizes structural reparameterization and multi-dimensional attention to prevent information loss during downsampling; (2) the Partial-Depth Convolution Module (PDC), which employs a partial convolution strategy to reduce channel redundancy and optimize the parameter budget; and (3) the Multi-local-global Vision-LSTM (MlgViL) Block, which integrates a parallel convolutional path and a bidirectional Matrix LSTM (mLSTM) to unify local actions and global context with O(N) complexity. Experimental results on the StateFarm and AUC-DDD datasets demonstrate that DpmViL achieves state-of-the-art performance, reaching accuracies of 99.63% and 98.85%, respectively. With only 0.61M parameters and 0.16G Floating Point Operations (FLOPs), the proposed model provides a highly efficient and deployable solution for real-time in-vehicle monitoring.}
}
@article{GENDY2026115315,
title = {Convolution mixer-based transformer-style network for lightweight remote sensing image super-resolution},
journal = {Applied Soft Computing},
volume = {198},
pages = {115315},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115315},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007635},
author = {Garas Gendy and Hasan AlMarzouqi},
keywords = {Channel mixing, Spatial mixing, Convolution modulation, Remote sensing super-resolution, And the convolution mixer},
abstract = {Recent developments in deep-learning-based remote sensing image super-resolution (RSISR) have attracted significant attention. In conventional models, upsampling is typically performed at the end of the architecture, which reduces computational cost but leads to loss of detail and degraded image quality. Furthermore, maintaining detail in remote sensing images is difficult due to their structural complexity and the variety of textures they contain. Although transformer-based methods improve the capture of global features, they often introduce redundancy and fail to capture local nuances. To address this issue, we propose a convolution-mixer-based transformer-style network for lightweight remote sensing image super-resolution (CMTSNSR). Convolutional modulation (Conv2Former), a simple block with linear (rather than quadratic) complexity compared to Transformers, forms the foundation of the proposed method. By using simple convolutions and the Hadamard product, Conv2Former simplifies the self-attention process. Additionally, the Conv2Former block is further enhanced to mix both spatial and channel locations using a convolution mixer. The convolution mixer uses three types of convolutions: a dilated depthwise convolution to increase the receptive field, a depthwise convolution to mix spatial locations, and a pointwise convolution to mix channel locations. We propose a convolutional modulation block (Conv2FormerB), comparable to the Transformer block, that combines Conv2Former with a multi-layer perceptron (MLP). For the RSISR challenge, a CMTSNSR is created using this Conv2FormerB, 3 × 3 convolution, and enhanced spatial attention (ESA) block. This CMTSNSR performed well across several RSISR benchmarks. Our CMTSNSR model achieves a runtime approximately 2.1× faster than Rep-Mamba.}
}
@article{GHOLAMI2026115280,
title = {A novel hybrid Z-IT2F FUCOM-MARCOS approach for sustainable solar site selection},
journal = {Applied Soft Computing},
volume = {198},
pages = {115280},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115280},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007283},
author = {Mona Gholami and Maryam Ashrafi and Dawoud Fadaei},
keywords = {Interval Type-2 Fuzzy Sets, MARCOS, Solar site selection, Z-number FUCOM},
abstract = {The eastern region of Iran, characterized by an average solar radiation of approximately 350 W·h/m², holds outstanding potential for solar energy development. While Multi-Criteria Decision-Making (MCDM) techniques are commonly used for optimal site selection, their effectiveness is frequently limited by uncertainties in criterion weighting, which often rely on subjective expert judgments. To overcome these limitations, this study introduces a novel hybrid MCDM framework designed to enhance robustness and reliability in sustainable energy planning. The framework innovatively combines a newly extended Z-number Interval Type-2 Fuzzy Full Consistency Method (ZIT2F-FUCOM) for criteria weighting with the Measurement of Alternatives and Ranking according to COmpromise Solution (MARCOS) for site prioritization. The ZIT2F-FUCOM model captures the linguistic uncertainty and incorporates the reliability of expert evaluations, while requiring only (n–1) pairwise comparisons—significantly fewer than the Analytic Hierarchy Process (AHP) and the Best-Worst Method (BWM)—and providing a consistency ratio to validate preferences. Subsequently, the MARCOS method is employed for its superior stability, reduced sensitivity to normalization techniques, and lower compensation effects compared to conventional methods such as the Technique for Order of Preference by Similarity to Ideal Solution (TOPSIS) and VIseKriterijumska Optimizacija I Kompromisno Resenje (VIKOR). This integrated approach is applied to evaluate 15 candidate locations in South Khorasan Province, Iran, using 14 climatic, technical, economic, and socio-environmental criteria. The results identify solar radiation as the most influential factor, with Asadiyeh, Deihuk, and Nasruddin emerging as the three most suitable locations. The robustness of the framework is confirmed through a 10-scenario sensitivity analysis and a comparative evaluation against Complex Proportional Assessment (COPRAS), TOPSIS, and VIKOR methods.}
}
@article{CHEN2026115256,
title = {An optimal shifting distance approach for reliability based design optimization},
journal = {Applied Soft Computing},
volume = {198},
pages = {115256},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115256},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007040},
author = {Zhenzhong Chen and Guangjun Dong and Qianghua Pan and Guangming Guo and Dan Liu and Xiaoke Li and Xuehui Gan and Ge Chen},
keywords = {Reliability-based design optimization, Sequential optimization, Optimal shifting distance, Reliability index, Kriging model},
abstract = {The sequential optimization and reliability assessment method is widely used in reliability-based design optimization for its superior decoupling strategy and computational efficiency. However, conventional sequential optimization and reliability assessment method suffers from inherent systematic bias in the reliability index calculation for highly nonlinear constraints, due to its fixed shifting distance strategy based on linear approximation. To address this issue, this paper proposes an optimal shifting distance (OSD) method. The core of OSD is to dynamically determine and update the optimal shifting distance in each iteration step, eliminating the geometric bias caused by constraint nonlinearity. Meanwhile, the kriging model is integrated into the sequential optimization and reliability assessment method framework to approximate implicit constraint functions, balancing optimization accuracy and computational efficiency. The effectiveness of the proposed method is verified by mathematical benchmarks and an engineering case of composite radome.}
}
@article{KUMAR2026115155,
title = {Hybrid fermatean Z-AHP-TOPSIS model for efficient health insurance policy decision making},
journal = {Applied Soft Computing},
volume = {198},
pages = {115155},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115155},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006034},
author = {Ankit Kumar and Kiran Kumar Paidipati and Talari Ganesh},
keywords = {Multi-criteria decision-making, AHP, Fermatean fuzzy sets, Health insurance policy},
abstract = {MCDM provides a structured approach to addressing complex decision problems. In particular, AHP, TOPSIS, Fermatean fuzzy sets, and Z-numbers enhance decision- making by handling uncertainty and improving robustness. This research introduces an enhanced MCDM approach by integrating Fermatean fuzzy Z-numbers (FFZN) with AHP and TOPSIS (FFZ-AHP-TOPSIS), and the proposed methodology addresses the inherent uncertainties and expert judgment reliability in real-world decision-making. The FFZ-AHP-TOPSIS method is applied to select the best health insurance plans available in India by evaluating the offerings of six leading health insurance providers. These providers include Care Health Insurance (Ultimate Care), Niva Health Insurance (Aspire Gold + Value), Star Health Insurance (Super Star), Bajaj Allianz (My Healthcare), Tata AIG (Medicare Premier), and Reliance General Insurance (Health Gain) and are assessed based on eight factors such as Premium, Out-of-Pocket Expenses, Coverage Type, Pre/Post-Hospitalization Coverage, Network Size, Claim Settlement Process, OPD Cover, and Cumulative Bonus. The analysis is performed based on the data obtained from expert evaluations and official health insurance plan documentation. The results are compared with the existing FF-AHP-TOPSIS, Z-AHP-TOPSIS, and F-AHP-TOPSIS methods, to examine the effect of incorporating reliability through FFZ-AHP-TOPSIS. This leads to more differentiated rankings, especially for closely ranked alternatives, proving its superiority. This study contributes to MCDM by offering a robust, adaptable tool that better handles uncertainty and expert reliability.}
}
@article{CHEN2026115296,
title = {Hybrid discrete PSO with reinforcement learning for flexible job shop scheduling},
journal = {Applied Soft Computing},
volume = {198},
pages = {115296},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115296},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007441},
author = {Junjun Chen and Ting Shu and Xuesong Yin and Jinsong xia},
keywords = {Flexible job shop scheduling problem, Deep reinforcement learning, Proximal policy optimization, Discrete PSO},
abstract = {The Flexible Job Shop Scheduling Problem (FJSP) extends the traditional Job Shop Scheduling Problem by allowing operations to be processed on multiple eligible machines. This flexibility significantly increases the complexity of the problem, often resulting in slow solving speeds and low-quality solutions. To address these challenges, this paper proposes a novel hybrid method, DDPSO, which integrates Deep Reinforcement Learning (DRL) and Discrete Particle Swarm Optimization (DPSO) to leverage their complementary strengths. The DRL component, CNN-GRU-PPO, employs a CNN-GRU-based feature extraction network to enhance state representation and incorporates GRU layers in the Actor and Critic networks, trained using Proximal Policy Optimization (PPO) to capture temporal dependencies. The hybridization is achieved by initializing the DPSO population with high-quality solutions generated by the DRL model and dynamically utilizing the DRL model to fill missing machine and operation assignments during DPSO’s rand-point preservation crossover operation. Experimental results on the Brandimarte, Hurink, Dauzere, and Barnes datasets demonstrate that DDPSO reduces computational time by up to 57% compared to baseline metaheuristics and outperforms state-of-the-art DRL and metaheuristic methods in solution quality, achieving an average 3%–6% improvement in makespan, thereby validating its effectiveness for solving the FJSP.}
}
@article{KHATTAK2026115245,
title = {Signal decomposition–driven deep learning framework for passenger demand forecasting: Evidence from Dublin Luas},
journal = {Applied Soft Computing},
volume = {198},
pages = {115245},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115245},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006939},
author = {Afaq Khattak and Brian Caulfield},
keywords = {Public transport, Time series analysis, Signal processing, Deep learning},
abstract = {The Dublin Luas is an urban light rail system that exhibits complex and dynamic passenger demand, which poses significant challenges for planning and scheduling decisions. Effective management of the system requires reliable passenger demand forecasts across short-, medium-, and long-term horizons to support operational control, scheduling, and capacity investment decisions. This study proposes a hybrid Artificial Intelligence (AI) framework that integrates signal processing and deep learning for multi-horizon passenger demand forecasting. The framework first applies Variational Mode Decomposition (VMD) to the weekly passenger demand series from the Dublin Luas Red and Green lines. This decomposes the data into distinct temporal components. These components are then modelled with Bidirectional Gated Recurrent Units (BiGRU) to capture their frequency-specific temporal dependencies. The BiGRU hyperparameters are optimized using the Tree-structured Parzen Estimator (TPE) algorithm. Results demonstrate that the proposed hybrid VMD+BiGRU framework outperforms the baseline models. On the Red Line, it achieved an RMSE of 7.88, an MAE of 5.85, and an R2 of 0.976. On the Green Line, it achieved an RMSE of 9.65, an MAE of 8.47, and an R2 of 0.958. Wilcoxon signed-rank tests further confirmed the superiority of the proposed framework. To further evaluate model robustness and temporal transferability, a multi-horizon forecasting analysis was conducted for short-term (1-week), medium-term (4-week), and long-term (12-week) intervals. The VMD+BiGRU model maintains low error growth and high predictive accuracy across all horizons compared with competing models. The proposed framework provides reliable forecasts that support resource allocation, timetable adjustment, and operational management of the Dublin Luas system.}
}
@article{ZHANG2026115254,
title = {Multi-objective scheduling optimization for helicopter-vessel maritime joint rescue considering psychological panic},
journal = {Applied Soft Computing},
volume = {198},
pages = {115254},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115254},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007027},
author = {Yali Zhang and Yong Liu and Jiawei Wu},
keywords = {Maritime emergency rescue, Psychological panic, Joint scheduling, Multi-objective optimization, Q-learning-based hyper-heuristic},
abstract = {When adverse weather and complex hydrographic conditions occur at sea, multiple distress incidents may arise within a short period, requiring rapid and coordinated emergency response. To address inefficiencies in resource allocation and the complexity of multi-objective coordination under such scenarios, a multi-objective scheduling optimization model integrating temporal, psychological, and cost factors is developed. The model distinguishes between high- and low-risk distress points and incorporates equipment load capacity as well as sea-state operational constraints. Psychological panic is quantified through an exponential function of rescue time, enabling dynamic assessment of psychological impact during rescue operations. To solve the formulated problem, a Multi-Objective Q-learning-based Hyper-Heuristic (MOQHH) framework is proposed. By integrating non-dominated sorting with a Q-learning mechanism, the algorithm adaptively selects search operators to balance convergence and diversity. Elite migration, load balancing, and peer exchange operators are embedded within a dynamic operator selection strategy to enhance exploration and solution refinement. Comparative computational experiments demonstrate that MOQHH achieves superior convergence performance and solution diversity across instances of varying scales. Ablation studies further validate the effectiveness of individual algorithmic components. Objective preference and sensitivity analyses provide flexible decision support for practical rescue operations. Overall, the proposed framework facilitates more rational scheduling and coordination of helicopter–vessel maritime joint rescue resources under complex and dynamic conditions.}
}
@article{FULARA2026115282,
title = {Time series forecasting method based on complete ensemble empirical mode decomposition with adaptive noise and hesitant fuzzy cognitive map},
journal = {Applied Soft Computing},
volume = {198},
pages = {115282},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115282},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007301},
author = {Suraj Prakash Fulara and Nihat Tak and Sanjay Kumar},
keywords = {Time series forecasting, Fuzzy Cognitive Map, CEEMDAN, Hesitant fuzzy cognitive map, Differential evolution},
abstract = {Though fuzzy cognitive maps have gained significant popularity in time series forecasting in recent years, more sophisticated methods are required for precise forecasting of non-linear and complex time series data in the environment of uncertainty and hesitation. In this research paper, we integrate hesitant fuzzy cognitive map (HFCM) and complete ensemble empirical mode decomposition with adaptive noise (CEEMDAN) and propose a novel method for time series forecasting. CEEMDAN offers better approach than empirical mode decomposition (EMD) and ensemble empirical mode decomposition (EEMD) in handling non-stationary datasets and breaks original time series data into intrinsic mode functions and residues. Proposed forecasting method uses an enhanced cognitive map with two-steps hesitancy in the weights of relationship between the nodes. Two-steps hesitancy in the weights of relationship between the nodes is implemented in a novel way by using Fermi function. Proposed forecasting method uses differential evolution to learn the weights of HFCM to avoid premature convergence and maintain population diversity. Proposed forecasting method is applied to eight diversified time series data of Sunspot, S&P 500, Lake Erie levels, CO2 at Mauna Loa, MCRF, RUT, Milk production, and MG Chaos. Minimum and maximum root mean square error 0.008 and 18.96 are observed in forecasting of time series data of MG Chaos and Milk production. Minimum and maximum mean absolute deviation of 0.006 and 18.521 are also observed in the same time series data of MG Chaos and Milk production. Acceptable range of evaluation parameter (δr<1)and performance parameter (PP>0)confirm accurate and unbiased forecasted outputs computed using proposed CEEMDAN and HFCM-based time series forecasting method.}
}
@article{ALOTAIBI2026115209,
title = {Comparing mechanistic and data-driven models for predicting punching shear capacity of FRP-RC slabs},
journal = {Applied Soft Computing},
volume = {198},
pages = {115209},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115209},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006575},
author = {Khalid Saqer Alotaibi},
keywords = {Punching shear, Fiber-reinforced polymer, Reinforced concrete slabs, Mechanistic models, Explainable Artificial Intelligence},
abstract = {The deterioration of reinforced concrete infrastructure due to steel corrosion has accelerated the adoption of Fiber-Reinforced Polymer (FRP) bars as a durable alternative. However, the linear-elastic nature of FRP introduces brittle failure modes in flat-plate systems, necessitating accurate predictive tools for punching shear capacity. This study addresses the challenge of accurately predicting punching shear capacity in FRP-reinforced concrete slab-column connections. Traditional design codes, such as ACI, CSA, and JSCE, were evaluated against an extensive experimental database of 148 tests. The results showed that these codes have low predictive accuracy, with coefficients of determination (R2) as low as 0.190. In parallel, three data-driven machine learning models, Gradient Boosted Regression Trees (GBRT), Random Forest (RF), and an Artificial Neural Network (ANN), were developed and optimized. These models were validated using 10-fold cross-validation, and their performance on unseen data was found to be significantly superior. For instance, the GBRT model achieved an R2 of 0.923 and a mean absolute error (MAE) of 49.90 kN, which is a 56% improvement over the best-performing code-based model. The consistency of the predictions was also markedly better, with the coefficient of variation (CoV) of the experimental-to-predicted ratio decreasing from 0.25 for the best-performing code-based models to 0.08 for the machine learning models. To ensure transparency, Explainable Artificial Intelligence (XAI) techniques were used to diagnose model behavior. Unlike standard black-box applications, this approach revealed that effective depth is the most influential parameter, quantitatively confirming the localized nature of the failure. The study concludes that the developed machine learning models provide significantly higher predictive accuracy and reduced scatter compared to traditional design codes, offering a viable alternative for structural design.}
}
@article{WANG2026115249,
title = {Frequency-based lazy Naive Bayes},
journal = {Applied Soft Computing},
volume = {198},
pages = {115249},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115249},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006976},
author = {Baozheng Wang and Huan Zhang and Kexin Meng and Yafei Zhang},
keywords = {Value frequency, Instance similarity, Lazy learning, Naive Bayes},
abstract = {Naive Bayes (NB) continues to receive much attention in machine learning community due to its simplicity, efficiency and efficacy, but its unrealistic attribute conditional independence assumption often limits its performance. To relax this assumption, various instance weighting approaches have been proposed. Among them, Lazy Naive Bayes (LNB) is a simple yet effective approach that builds a lazy model for each test instance by assigning different weights to training instances based on their similarity. However, the similarity measure in LNB is based on overlapping distance, which merely counts the number of matching values and is coarse and sub-optimal. In this study, we argue that the frequency of matching values is also critical for accurately capturing similarity among instances. Accordingly, we propose Frequency-based Lazy Naive Bayes (FLNB), a novel approach that assigns higher similarity scores to matches involving infrequent values compared to those involving frequent values. To calculate the similarity, we introduce two versions of FLNB by polynomial and logarithmic formulations, termed as FLNBpoly and FLNBlog, respectively. Extensive experiments on 60 benchmark datasets confirm the superiority of FLNB.}
}
@article{DONG2026115294,
title = {Uncertainty-aware algorithmic trading in a teacher–student framework},
journal = {Applied Soft Computing},
volume = {198},
pages = {115294},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115294},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007428},
author = {Li Dong and Lian Chen and Yang Bing and Hegui Zhang and Weipan Zhang and Renbin Pan},
keywords = {Imitation learning, Reinforcement learning, Financial asset trading, Epistemic uncertainty},
abstract = {Imitation learning (IL) is increasingly used to enhance the training of reinforcement learning (RL) agents in financial asset trading. However, in most existing value-based methods, experts provide only target actions to the RL agent, neglecting the RL agent’s need for accurate value-function estimation. To address this limitation, we propose JASTMD, an oracle-aided DDQN-based teacher-student framework, in which an online teacher advisor uses privileged future price information to provide the student agent (an RL agent) with target actions and target Q-values only during training. To decide when the student agent should learn autonomously and when it should request teacher advice, we equip the online Q-network with multiple heads and estimate epistemic uncertainty using a composite measure that jointly captures inter-head and intra-head uncertainty. In addition, to prevent potential over-reliance on teacher advice, we employ importance advising to regulate the provision of advice by the teacher. We evaluate JASTMD on single-stock daily trading data from three Chinese industry stock pools: financial (FinI), real estate (ReEI), and wholesale and retail (WhRI). Experimental results demonstrate that JASTMD outperforms baseline methods across multiple evaluation metrics. Specifically, in FinI, JASTMD improves upon the best baseline method by 13.18%, 15.89%, 35.01%, and 100.82% in average cumulative return (ACuR), average annual return (AAnR), average Sharpe ratio (AShR), and average Calmar ratio (ACaR), respectively. In ReEI, the corresponding improvements are 22.04%, 24.54%, 18.65%, and 31.44%, respectively. In WhRI, JASTMD improves upon the best baseline method by 6.31% in ACuR, 11.75% in AAnR, and 6.19% in AShR, while its ACaR is only 0.36% lower than that of the best baseline method. These results confirm the effectiveness and robustness of JASTMD in improving trading performance across different industries.}
}
@article{ZAFAR2026115220,
title = {Multi-equation meta-optimizer: A generic framework for enhancing metaheuristic algorithms},
journal = {Applied Soft Computing},
volume = {198},
pages = {115220},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115220},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600668X},
author = {Amina Zafar and Qamar Askari and Muhammad Faheem},
keywords = {Metaheuristics, Multi-equation algorithms, Exploration and exploitation, Meta-optimization, Probabilistic selection mechanism, Engineering optimization},
abstract = {This paper presents a generic framework designed to enhance the performance of multi-equation metaheuristic algorithms. In most optimization algorithms, the search process progresses through three distinct phases: exploration, exploitation, and the transition from exploration to exploitation. Each phase involves unique optimization challenges and therefore requires specialized search strategies. In the literature, most metaheuristic algorithms employ multiple equations to model varying search strategies in different phases. This study investigates whether multi-equation algorithms fully exploit the potential of their proposed equations, or whether further improvements can be achieved by utilizing these equations more effectively. To achieve this, a framework is proposed that dynamically adjusts the importance of each equation across different phases of the optimization process to ensure their optimal utilization. It consists of three main components: (i) dividing the optimization process into three phases and assigning phase-wise importance to each equation, (ii) optimizing these importance values using a meta-level algorithm, and (iii) selecting equations based on their optimized importance through a probabilistic selection mechanism. The proposed framework is applied to eight well-established multi-equation algorithms and evaluated on 60 unimodal and multimodal benchmark functions. Additionally, its applicability is also assessed on five real-world engineering design problems. Apart from improving the performance of existing algorithms, the framework can assist researchers in designing more effective optimization algorithms by identifying the right importance of each equation during different phases of the optimization process. Experimental results demonstrate a clear improvement in the performance of the target algorithms across various benchmark combinations and real-world problems. The proposed framework is not limited to these specific algorithms; rather, it can be applied to any multi-equation metaheuristic algorithm to potentially enhance its performance for any application by enabling more effective utilization of its equations.}
}
@article{PENG2026115241,
title = {Progressive multi-granularity spatio-temporal feature extraction based distributed monitoring method for large-scale manufacturing processes},
journal = {Applied Soft Computing},
volume = {198},
pages = {115241},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115241},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006897},
author = {Kaixiang Peng and Wenbo Zhang and Qichun Zhang and Jie Dong},
keywords = {Process monitoring, Attention mechanism, Progressive multi-granularity, Sequence constraint, Large-scale manufacturing processes},
abstract = {Process monitoring plays a crucial role in large-scale manufacturing processes by ensuring product quality and operational safety. In practice, large-scale manufacturing processes comprise multiple interrelated sub-processes, whose data exhibit complex coupling and correlation characteristics, thereby posing significant challenges for plant-wide process monitoring. To address these issues, a distributed monitoring framework based on a progressive multi-granularity spatio-temporal feature extraction method is proposed in this paper. First, the production process is partitioned into multiple units based on prior knowledge. Within each unit, a multi-granularity feature extraction method is designed to capture spatio-temporal features. Second, considering the hereditary characteristics among the units, a new local monitoring model is constructed using multi-granularity spatio-temporal feature extraction under inter-unit self-attention constraints. Subsequently, a time-weighted Bayesian fusion method combined with Dynamic Time Warping (DTW) is employed to integrate local statistics into global statistics, enabling comprehensive process-wide monitoring. The feasibility and effectiveness of the proposed method are validated through case studies on both Tennessee Eastman process (TEP) and real-world hot strip mill process (HSMP) data, achieving average fault detection rates of 97.26% and 99.3% for TEP and HSMP faults, respectively.}
}
@article{ABULIZI2026115286,
title = {HSMK-YOLO: Improved YOLOv11 fused with hypergraph convolutional network for tomato leaf disease detection},
journal = {Applied Soft Computing},
volume = {198},
pages = {115286},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115286},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007349},
author = {Abudukelimu Abulizi and Junxiang Ye and Halidanmu Abudukelimu and Gengrong Zhang and Cuiqin Guo and Yajun Zhang and Dengfeng Yao},
keywords = {Tomato leaf disease detection, Hypergraph convolution, YOLO model, Deep learning, Precision agriculture},
abstract = {Accurate identification and classification of tomato leaf diseases play a pivotal role in increasing tomato yield. However, existing tomato leaf disease detection approaches face two major challenges, one is inadequate modeling of underlying higher-order disease correlations, and the other is vulnerability to environmental interferences including leaf occlusion and illumination variations. To address these challenges, we propose a novel model, i.e., HSMK-YOLO, an enhanced framework based on YOLOv11 with three key innovations: firstly, a dual-branch architecture combines a hypergraph convolutional network for capturing higher-order disease relationships with the Kolmogorov-Arnold Network (KAN) for more efficient feature extraction; secondly, convolutional blocks redesigned by spatial-channel reconstruction employ spatial attention mechanisms to enhance cross-feature map fusion; finally, traditional multilayer perceptrons (MLPs) are replaced with a Multi-Self-supervised Equivariant Attention Mechanism (MultiSEAM) to boost leaf disease identification and classification accuracy. Experimental results demonstrate that HSMK-YOLO achieved a precision of 92.1% and an mAP50 of 94.7%, outperforming Hyper-YOLO, the benchmark model, by 5.4% and 2.5%, respectively. Systematic comparison and generalization tests were conducted to further verify the effectiveness and generalization capability of the proposed model. The results show that HSMK-YOLO was superior to state-of-the-art models including YOLOv8, YOLOv9, YOLOv10, RT-DETRv2, and YOLOv12 in multiple metrics, fully demonstrating that the HSMK-YOLO model has outstanding detection performance and broad application prospects, capable of providing powerful technical support to tomato disease control.}
}
@article{TANG2026115225,
title = {SGEOM: Sample gradient entropy based oversampling method for the class-imbalanced problem in software defect prediction},
journal = {Applied Soft Computing},
volume = {198},
pages = {115225},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115225},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006733},
author = {Yu Tang and Qi Dai and Ye Du and Le Zhang and Yun-yi Zhang},
keywords = {Software defect prediction, Class imbalance, Oversampling method, Sample gradient entropy, Barycentric lagrange interpolation},
abstract = {In software defect prediction, defective samples are typically vastly outnumbered by non-defective ones, leading to a significant class imbalance. Oversampling techniques provide a practical solution by generating additional defective samples to balance the distribution. However, most conventional oversampling methods fail to consider feature variation trends and the relative importance of individual samples. In this study, we propose an Oversampling Method based on Sample Gradient Entropy (SGEOM). Initially, we propose a metric named sample gradient entropy (SGE) to describe the trend of sample features. SGE is subsequently employed to select the nearest neighbors in the K-nearest neighbors algorithm, enhancing its resistance to noise. Inspired by the principles of barycentric Lagrange interpolation, this method assigns weights to each defective sample and innovates a new method for synthesizing defective samples. Experiments on 17 publicly available software defect datasets demonstrate that SGEOM improves the average performance of three prediction models, random forest (RF), support vector machine (SVM), and multilayer perceptron (MLP), by 2% to 8% over state-of-the-art oversampling methods. These improvements are statistically validated using Friedman ranking and Nemenyi post-hoc tests.}
}
@article{XIAO2026115262,
title = {Dual-view cross fusion network enhanced reinforcement learning for flexible job-shop scheduling with transportation constraints},
journal = {Applied Soft Computing},
volume = {198},
pages = {115262},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115262},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007106},
author = {Meng Xiao and Lu Chen and Kechao Huang},
keywords = {Flexible job-shop scheduling, Transportation constraints, Heterogeneous data fusion, Deep reinforcement learning, Graph neural networks},
abstract = {As an extension of the classical flexible job-shop scheduling problem, this study aims to jointly optimize machine production and job transportation. The problem is formulated as a Markov decision process and a deep reinforcement learning (DRL) approach is proposed to solve the problem. A dual-view cross fusion network is integrated to achieve feature extraction. The extracted feature representations are fed into a policy network to generate the scheduling policy. The entire neural architecture is trained via a reinforcement learning algorithm. Computational results on multiple sets of instances demonstrate that the proposed method outperforms existing DRL-based approaches and classical heuristic algorithms, with relative gaps exceeding 10% and 40%, respectively. Managerial insights are discussed in an engineering case study.}
}
@article{HOLY2026115190,
title = {Feature selection based index tracking: A two-stage approach for optimized sampling},
journal = {Applied Soft Computing},
volume = {198},
pages = {115190},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115190},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006381},
author = {Thomas Robert Holy and Mario Brandtner and Christian Pigorsch},
keywords = {Investment analysis, Index tracking, Portfolio optimization, Exchange-traded funds, Machine learning},
abstract = {Equity indices form the basis for index-oriented financial products such as exchange-traded funds (ETFs). The providers of these financial products face the challenge of efficient replication. Optimized sampling is the most attractive approach for replicating an equity index due to its cost-effectiveness, flexibility, and transparency. In this paper, we propose a novel two-stage procedure for optimized sampling. It combines recursive feature elimination (RFE), which can wrap various supervised learning methods, to select the index constituents for replication in the first stage, followed by tracking-error optimization to determine the weights of the tracking portfolio components in the second stage. Our approach allows explicit control over the number of tracking portfolio components, representing a significant advantage over existing machine learning-based approaches. Additionally, the optimization procedure considers important financial constraints as well as practical and statistical challenges that have been neglected in the recent literature. Based on a dataset including two major indices, S&P 500 and CSI 300, and 16 years of test data, we show that our approach outperforms a state-of-the-art mixed-integer programming (MIP) solver in terms of computing time for all feature selection based approaches used in the first stage. Moreover, we show that recently proposed deep learning approaches are associated with significantly higher tracking errors, higher portfolio turnover, and lower portfolio diversity. Our findings have significant implications for researchers and ETF sponsors seeking to develop efficient and practical solutions for tracking portfolio construction.}
}
@article{CHENG2026115287,
title = {Community detection attack based on adversarial matrix factorization with incoherent embeddings},
journal = {Applied Soft Computing},
volume = {198},
pages = {115287},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115287},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007350},
author = {Xi Cheng and Wenjie Zhu and Wei Qi Yan},
keywords = {Community deception, Community detection attack, Adversarial matrix factorization},
abstract = {Community detection is essential for revealing the underlying structure of complex networks, but it remains susceptible to various attack strategies. To safeguard personal privacy, community detection attack algorithms can be employed to obscure the true community structure by subtly adding or deleting edges, thereby deceiving detection algorithms. However, most of the existing methods rely on predefined strategies to select target nodes, which may not be well-suited to the network’s inherent structure. To address this limitation, we propose a novel attack method based on Adversarial Matrix Factorization (AMF) with incoherent embeddings, yielding a learnable and adaptive attack mechanism that dynamically adapts to network structures without prior community knowledge. Specifically, our AMF approach jointly learns the node embeddings of both the original and perturbed networks. We introduce incoherent regularization on the soft community-indicator matrices derived from these embeddings, a key innovation that directly disrupts the latent embedding space underlying modern community detection. The incoherent embedding regularization helps generate adversarial perturbations that disrupt the matrix factorization process typically used in community detection tasks. By incorporating a flexible perturbation budget, AMF can exploit the structural incoherence between nodes in the latent space, generating subtle yet effective modifications that evade detection by conventional community detection algorithms. This work not only advances the field of privacy-preserving network analysis but also exposes vulnerabilities in current community detection methods, guiding the development of more robust defenses. Extensive experiments on benchmark datasets demonstrate that AMF achieves better attack performance compared with other attack methods while maintaining computational efficiency. Moreover, our method is robust across a range of community detection algorithms (e.g., Fastgreedy, Louvain, Infomap, and Walktrap), showcasing its generalizability and highlighting the vulnerabilities of current community detection methods. On the Email network, AMF reduces NMI to 0.4463 and ARI to 0.2708 vs. the best baseline 0.6611 and 0.5939, and runs 2–5 times faster than the second best baseline on large-scale networks like CA-GrQc.}
}
@article{WU2026115279,
title = {SCO-urban flow: A soft computing optimiser for sustainable traffic management in smart cities},
journal = {Applied Soft Computing},
volume = {198},
pages = {115279},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115279},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007271},
author = {Yiping Wu and Asim Suleman Abdullah Alwabel and Qifeng Xu and Saad Alahmari and Baraa Alfasi and Ali Ahmadian},
keywords = {Urban Traffic Management, Soft Computing, Self-Organising Maps (SOM), Recurrent Neural Networks (RNN), Type-2 Fuzzy Logic, Traffic Signal Optimisation},
abstract = {Urban traffic congestion remains a significant challenge for smart city planners, who struggle to find effective solutions due to its impact on higher fuel consumption, increased emissions, and longer travel times for commuters. Traditional signal timing systems cannot usually adapt to changing and unpredictable traffic conditions. This research presents NeuroTraffic-Soft, a new soft computing hybrid framework that enables real-time, on-the-fly adaptive traffic flow improvement. The method employs a Self-Organising Map (SOM) for recognising spatiotemporal congestion patterns, a Recurrent Neural Network (RNN) for forecasting the evolution of traffic flow, and a Type-2 Fuzzy Logic Controller for uncertainty-aware signal control at intersections. The framework analyses key traffic input parameters including vehicle flow, lane occupancy, queue length, and average speed collected from real-time sensors and simulation environments. The authors have experimented a virtual urban corridor that consisted of 10 interconnected junctions. They used real-world traffic data for the experiment. NeuroTraffic-Soft, compared with traditional fixed-time and actuated signal systems, resulted in a 32.1% decrease in average vehicle delay, a 26.4% reduction in the number of stops, and a 17.9% increase in average speed during both peak and off-peak hours. The framework demonstrated its strong adaptability to incidents, weather changes, and variations in traffic volume, which remain the primary issues, highlighting its capacity for implementation in next-generation intelligent transportation systems.}
}
@article{MO2026115291,
title = {Parsimonious decomposition-based model search engine for monthly shipping freight rate interval forecasting},
journal = {Applied Soft Computing},
volume = {198},
pages = {115291},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115291},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007398},
author = {Jixian Mo and Jiayu Gong and Ruobin Gao and Kum Fai Yuen},
keywords = {Ternary parsimonious decomposition-based model search engine, Interval forecasting, Freight rate, Multivariate variational mode decomposition, Maritime shipping},
abstract = {Forecasting freight rates in the shipping market is challenging due to high volatility and complex cyclical dynamics. This paper proposes a novel model, named ternary parsimonious decomposition-based model search engine (TPDMSE) for predicting monthly freight rate intervals by integrating ternary interval-valued time series (TITS) transformation, multivariate variational mode decomposition (MVMD), and a parsimonious intelligent model search engine (PIMSE) ensemble. Weekly freight rate data are first aggregated into monthly interval-valued observations to retain intra-month variability. These interval series are then fused with relevant exogenous factors and decomposed into multi-scale components using MVMD. Each component is forecasted with a rolling PIMSE strategy that adaptively selects a robust predictive model for that mode. Finally, the predicted components are summed to reconstruct forecasts of the monthly interval freight rates. Our proposed model effectively captures both trend and volatility information, yielding improved accuracy and stability over comparative models across different ship types. Further sensitivity analysis reveals that adaptive hyperparameter tuning through grid search significantly improves forecasting accuracy by precisely accommodating the distinctive volatility patterns inherent to each vessel segment. Robustness checks examining alternative weighting schemes for interval components indicate that the model consistently maintains high accuracy across different risk and preference settings. Our work contributes to bridging the gap of shipping freight rate forecasting, highlighting the benefits of combining ternary interval transformation with multivariate decomposition in maritime time series prediction.}
}
@article{LU2026115230,
title = {A hybrid adaptive large neighborhood search with sample average approximation for elective and clinically urgent surgery scheduling under uncertainty},
journal = {Applied Soft Computing},
volume = {198},
pages = {115230},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115230},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006782},
author = {Li Lu and Qu Wei and Jing Xie and Chu Tang and Cui Yang and Kang Li},
keywords = {Operating room scheduling, Sample average approximation, Elective and urgent surgeries, Hybrid adaptive large neighborhood search, Stochastic optimization},
abstract = {Optimizing operating room scheduling is critical for enhancing hospital efficiency, reducing operational costs, and improving cancellation-related patient satisfaction. This study addresses a tactical-level operating room scheduling problem that jointly considers elective surgeries and clinically urgent patients who have already been admitted or transferred to relevant wards. The problem involves multiple uncertainties, particularly stochastic surgery durations and heterogeneous surgical priorities, with clinically urgent patients assigned higher priority. To reflect real clinical practice, the proposed model covers the full perioperative process, including preoperative, intraoperative, and postoperative stages, while accounting for surgical priority and case type. A sample average approximation framework is used to handle uncertainty. Based on the adaptive mechanism of adaptive large neighborhood search and the exploration ability of variable neighborhood search, a hybrid adaptive large neighborhood search algorithm is developed. Computational experiments are conducted using a large-scale real-world dataset from West China Hospital covering three years, multiple departments, and diverse surgery types, along with representative benchmark instances from the literature. Results show that the proposed method significantly reduces surgeons’ overtime, improves scheduling efficiency, and lowers operational costs. Within a time limit of two hours, it outperforms state-of-the-art metaheuristics and a commercial solver in both solution quality and computational efficiency.}
}
@article{RLAKKUNDI2026115267,
title = {Physics-informed hybrid digital twin for real-time multi-sensor intelligence and adaptive control in wire electrical discharge machining},
journal = {Applied Soft Computing},
volume = {198},
pages = {115267},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115267},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007155},
author = {Anand {R Lakkundi} and Vinayak {N Kulkarni}},
keywords = {Hybrid digital twin (HDT), Soft computing, Physics-informed modeling, Multi-sensor fusion, Adaptive control, Acoustic emission, Wire electrical discharge machining (WEDM), Real-time monitoring},
abstract = {In manufacturing settings, digital twins are advancing beyond static simulations to dynamic informatics systems that exhibit reasoning, flexibility and real-time control. This research proposes a physics-informed Hybrid Digital Twin (HDT) that integrated multi-sensor data (acoustic emission (AE), current, voltage and temperature) with machine-learning inference and real-time physics-informed constraints for process intelligence in Wire Electrical Discharge Machining (WEDM). The HDT architecture consists of five informatics layers: data acquisition, signal preprocessing, frequency domain reasoning (FFT–STFT–WPSD), features correlation analytics, and adaptive learning based control systems. Real-time experiments are presented based on 36 WEDM runs from AISI D2 steel, demonstrating AE_RMS as the most significant diagnostic feature (r = 0.99 with surface roughness), exceeding sensitivity and predictive reliability as compared to other data modalities based on time, frequency and time-frequency domains. Both Random Forest and ANN achieved R² > 0.95 and detection latency speed of under 20 ms, demonstrating the feasibility of a closed-loop control system. The adaptive decision logic was also constrained to maintain discharging current within ± 3% of nominal, directly causing a 4.9% improved material removal rate, keeping surface variation ≤ 5%, with wire rupturing incidents going reduced by 75%. The proposed approach HDT gives a self-learning, data–physics fusion architecture for system observability, real-time adaptation and zero defect manufacturing – an architect created for Industry 4.0 to adapt multi-sensor data informatics and autonomous machining intelligence.}
}
@article{LIU2026115198,
title = {Multi-objective optimization-based denoising two-archive evolutionary algorithm for path planning},
journal = {Applied Soft Computing},
volume = {198},
pages = {115198},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115198},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006460},
author = {Zhihua Liu and Jingtao Tang and Wei Tian and Jingyu Huo and Jiaxing Chen},
keywords = {Evolutionary algorithm, Multi-objective optimization, Path planning, Denoising, Two-space crowding distance},
abstract = {For noisy multi-objective optimization problems, this paper proposes a Denoising Two-Archive Evolutionary Algorithm (DTAEA) that integrates a denoising mechanism into the traditional two-archive framework. The proposed method incorporates a gradient boosting decision tree (GBDT)-based denoising network and an improved two-space crowding distance metric to enhance the two-archive evolutionary process. The GBDT-based denoising module trains networks on selected samples to construct a target-oriented noise suppression structure. By leveraging online learning and integrating population information, the network parameters are dynamically updated, enabling adaptive denoising of the predicted objective values. Meanwhile, a novel two-space crowding distance metric is introduced, which jointly evaluates the crowding degree of individuals based on their distribution in both the decision space and the objective space. This mechanism significantly improves population diversity and distribution uniformity on complex Pareto fronts. The effectiveness of the proposed DTAEA is validated on noisy variants of the DTLZ benchmark problems. Experimental results demonstrate that DTAEA achieves the best performance on 6 out of 8 algorithms in terms of optimization quality. Furthermore, an AUV path planning experiment is conducted in a realistic 3D ocean environment influenced by actual ocean currents. Compared to existing algorithms, DTAEA achieves a 28.93% reduction in average path length and a 21.21% increase in the hypervolume performance metric, highlighting its superiority in both solution quality and robustness under noisy conditions.}
}
@article{ALHUDHAIF2026115259,
title = {A graph learning and adaptive fuzzy framework for robust trust management in cloud manufacturing},
journal = {Applied Soft Computing},
volume = {198},
pages = {115259},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115259},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007076},
author = {Adi Alhudhaif and Kemal Polat},
keywords = {Graph convolutional networks, Hybrid trust management, Service level agreement (SLA), Cloud Manufacturing},
abstract = {Cloud manufacturing can meet the personalized needs of users by coordinating heterogeneous manufacturing resources and providing widely available networked intelligent manufacturing services. In a complex cloud manufacturing environment, the trust mechanism provides users with prior knowledge when faced with numerous cloud manufacturing services that have similar functions but different non-functional attributes. Establishing a reliable trust mechanism can prevent service providers from making false claims to attract more users. Unlike earlier SLA- or neighborhood-based schemes [1], [2], our framework explicitly fuses capability evidence and experience evidence, filters malicious feedback using multi-round voting with fuzzy reputation, and learns on the resulting user–service trust subgraph. Recent surveys show that cloud manufacturing (CMfg) platforms increasingly integrate IIoT/CPS, data-driven analytics, and AI, while still facing challenges in interoperability, resource virtualization, reliability and trustworthy service selection [3], [4]. In parallel, trust modeling has evolved from static reputation or SLA-centric formulations to graph-based and temporal learning frameworks that explicitly address trust dynamicity and malicious behaviors (e.g., TrustGuard and MATA) [5], [6]. Furthermore, multi-aspect graph attention and trust-aware collaborative frameworks have been shown to be effective for trust/QoS assessment in large-scale service graphs [7], [8]. Motivated by these advances, this paper revisits hybrid trust management for CMfg and strengthens the discussion and evaluation against recent literature. This paper proposes a multi-source hybrid trust management framework for cloud manufacturing environments, aiming to help users identify trustworthy services. First, an adaptive fuzzy hierarchical weighted capability trust estimation method is designed. This method assigns objective weights to QoS attributes based on the degree of service SLA fulfillment, without requiring users to participate in attribute importance comparisons. Second, an experiential trust evaluation method is proposed based on a trust subgraph. It constructs a trust subgraph by filtering out malicious evaluation information and learns the hidden features of users and services through Graph Convolutional Networks (GCN) for experiential trust estimation. This mechanism combines capability trust and experiential trust to form a hybrid trust score, quantifying the trust relationship between users and services. The experimental results demonstrate that the proposed model is effective and reliable in evaluating service trust.}
}
@article{DUAN2026115311,
title = {HSecNet: A deep learning-based image steganography method via multi-scale Gaussian difference decomposition},
journal = {Applied Soft Computing},
volume = {198},
pages = {115311},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115311},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007593},
author = {Xintao Duan and Junhao Sun and Sen Li and Zhao Wang and Bingxin Wei and Haewoon Nam and Chuan Qin},
keywords = {Image steganography, Deep learning, Multi-scale decomposition, Deep convolutional networks, Steganography security},
abstract = {Image steganography enables covert communication by embedding secret information into cover images while preserving visual quality and resisting steganalysis. Achieving a balance between imperceptibility and security remains a challenging problem in existing approaches. To address this issue, we propose a deep learning–based steganographic framework that integrates multi-scale Gaussian difference decomposition with adaptive convolutional and transformer-based feature modeling. The proposed multi-scale Gaussian difference decomposition generates stable hierarchical representations that capture frequency-aware structures, enabling secret information to be embedded primarily in mid- and high-frequency components. This design reduces global structural distortion and improves resistance to steganalytic detection. In addition, spatial-adaptive modulation and multi-scale attention pooling mechanisms enhance feature representation in complex texture regions, improving embedding efficiency and reconstruction fidelity. Experimental results on the DIV2K dataset demonstrate that the proposed method achieves PSNR values of 61.96 dB and 62.04 dB for cover/stego and secret/recovered image pairs, respectively. Furthermore, it consistently outperforms existing state-of-the-art methods across six mainstream steganalyzers, confirming its effectiveness for secure visual communication.}
}
@article{CUI2026115271,
title = {A multi-and-many-objective optimization algorithm for dynamic adjustment of reference vectors based on hyperplane projection},
journal = {Applied Soft Computing},
volume = {198},
pages = {115271},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115271},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007192},
author = {Li Cui and Meng Cheng and Xishuo Yao},
keywords = {Many-objective optimization, Hyperplane projection, Ratio-based non-dominated sorting, Reference vector maintenance, Parallel convergence criterion, Complex Pareto front},
abstract = {To alleviate the potential issues of local clustering or sparsity in decomposition-based multi- and many-objective algorithms with complex Pareto front (PF), as well as the challenge of maintaining a balance between convergence and diversity, this paper proposes WPAEA, an algorithm that dynamically adjusts reference vectors via hyperplane projection. First, it introduces a ratio-based non-domination sorting to hierarchically partition the PF and compute individual dominance measures, thereby improving the insufficient high-dimensional discrimination of traditional non-domination sorting. The PF distribution is mapped via hyperplane projection. A proposed parallel convergence criterion handles both single and multi-layer PF scenarios: for multi-layer PF, an elite layer is maintained to filter the final layer, promoting solution convergence to a single layer; for a single-layer PF, an advantage archive is maintained alongside the proposed stable angle penalty distance (SAPD) for individual selection. Ratio advantage filters excessive retention, while the advantage archive supplements insufficient retention. Throughout reference vector maintenance, the original reference vectors are prioritized to preserve spatial breadth, followed by maintaining and updating a dynamic minimum distance (dmd) to refine the filling of new reference vectors. The central concept is to guide and maintain more ratio-advantaged individuals in a more uniformly distributed subspace. Experimental results on extensive benchmark problems across ZDT, DTLZ, WFG and MAF series demonstrate that the WPAEA algorithm exhibits stronger competitiveness compared to seven representative algorithms, showing distinct advantages in handling complex PF problems and better preserving boundary solutions. Furthermore, embedding the algorithm into a constraint-handling mechanism was applied to a multi-objective optimization problem for tapered roller bearings involving 3 objectives, 8 variables, and 34 constraints. The results demonstrate that it is competitive with seven other algorithms incorporating constraint handling in engineering applications.}
}
@article{SINGH2026115236,
title = {The role of artificial neural networks in mathematical modeling: From single architecture to hybrid frameworks in environmental system},
journal = {Applied Soft Computing},
volume = {198},
pages = {115236},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115236},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006848},
author = {Sukhpal Singh and Kulwinder Singh Parmar and Sarbjit Singh},
keywords = {Environmental Modeling, Prediction Accuracy, Air Quality Prediction, Artificial Neural Networks, Time Series Analysis},
abstract = {The incessant degradation of the environment is a major global challenge in today’s world, which is posing huge threat to the human health and environmental equilibrium. The escalating accumulation of hazardous pollutants in the air and water, and the subsequent threats to human health, are driven by complex interconnected mechanisms involving climate variability, geographical characteristics, and anthropogenic activities. Since these processes exhibit strong non-linear and dynamic behavior, it becomes very arduous to depict accurate forecasts using conventional statistical methods. Artificial Neural Networks (ANNs) have captured notable attention to overcome these challenges because of their ability to model intricate non-linear relationships in diverse environmental systems. This study demonstrates an extensive review of ANN applications across environmental and non-environmental domains. It looks forward to primarily focusing on the environmental systems, which would comprise of air quality modeling, management of water resources and predictions related to health. A critical analysis of more than 135 peer-reviewed articles from high-impact journals has been conducted to bring out the efficaciousness, shortcomings, and advancements of ANN-based modeling frameworks. The findings indicate that while individual ANN models are competent to represent the non-linear relationships, their performance is often constrained by issues such as local minima convergence, overfitting, and reduced generalizations under noisy and non-stationary conditions. The review further illustrates that when ANN models are seamlessly connected with methods such as wavelet decomposition, ARIMA, and evolutionary optimization techniques, the hybrid frameworks steadily reflect the immense strength, stability, and precision of forecasting compared to the standalone ANN models. The comparative evidence emphatically suggest that hybrid models provide a stronger benchmark for complex real world datasets, especially in the highly variable environmental systems. The study draws the conclusion that focuses on the escalating significance of hybrid intelligent systems and highlights the areas of subsequent research on model interpretability, uncertainty handling, and adaptive learning. This paper is organized into five main sections: an introduction to ANNs, their historical development, applications of ANN models in environmental studies, a detailed review of these practical implementations, and a discussion of results. By consolidating this knowledge, we can foster collaborative efforts towards developing more effective strategies for mitigating environmental pollution and safeguarding the planet for future generations.}
}
@article{OKUWOBI2026115244,
title = {Quantum-inspired fuzzy fields for adaptive uncertainty modeling in heterogeneous real-world systems},
journal = {Applied Soft Computing},
volume = {198},
pages = {115244},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115244},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006927},
author = {Idowu Paul Okuwobi and Jingyuan Liu and Olayinka Susan Raji and Funsho Olusola Abiodun},
keywords = {Quantum superposition membership (QSM), Field-based inference engine (FIE), Entanglement-based uncertainty management (EBUM), Large-scale data modeling, Real-time decision-making},
abstract = {Contemporary fuzzy systems face a fundamental trilemma: they sacrifice scalability for interpretability, adaptability for stability, or uncertainty quantification for computational efficiency when processing high-dimensional, non-stationary data streams. Classical membership functions anchored to static [0,1] intervals and discrete rule bases cannot capture the fluid, entangled nature of real-world uncertainty. We resolve this trilemma through Quantum-Inspired Fuzzy Fields (QIFF), a theoretically grounded framework that reconstitutes fuzzy logic as a continuous quantum-probabilistic field theory. QIFF introduces four formally integrated innovations: (1) Quantum Superposition Membership (QSM) replaces parametric membership functions with evolving wavefunctionals Ψ(μ)∈H, enabling parameter-free representation of uncertainty through probability amplitude dynamics; (2) the Field-Based Inference Engine (FIE) eliminates combinatorial rule explosion by modeling decision boundaries as interference patterns within continuous scalar fields Φ:Rᵈ→R, achieving O(nlogn) inference complexity; (3) Entanglement-Based Uncertainty Management (EBUM) quantifies non-separable variable interdependencies via concurrence metrics derived from reduced density matrices ρAB, capturing emergent uncertainty beyond pairwise correlations; and (4) Self-Evolving Quantum Annealing Optimization (SEQAO) embeds adiabatic evolution within the inference loop, guaranteeing convergence to globally optimal field configurations under non-stationary data distributions. Evaluated across seven heterogeneous benchmarks (NYC Taxi: 1.46 M samples; MIMIC-III critical care; Climate Change Knowledge Portal) against ten state-of-the-art baselines, including ANFIS, Bayesian neural networks, and graph neural networks, QIFF demonstrates statistically significant gains: 38.7% higher F1-score in multi-class classification (p<10⁻⁵, Wilcoxon signed-rank), 59.3% faster convergence to ε−optimality, and 24.8% lower RMSE in chaotic time-series forecasting while maintaining full interpretability through field gradient visualization and entanglement entropy heatmaps. Ablation studies confirm the indispensability of all four components (Δ Accuracy ≥ 22.1% upon removal), and robustness tests establish stability under 40% missing data and 30 dB noise injection. QIFF establishes a new theoretical foundation for uncertainty-aware intelligence where representation, inference, and optimization co-evolve as coupled field dynamics, dissolving the historic trade-off between transparency and performance.}
}
@article{COLAK2026115269,
title = {Meta-heuristic algorithms for optimization of hybrid flowshop scheduling problems: A comprehensive review of the state of the art},
journal = {Applied Soft Computing},
volume = {198},
pages = {115269},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115269},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007179},
author = {Murat Çolak and Gülşen Aydın Keskin},
keywords = {Hybrid flowshop scheduling, Meta-heuristic algorithms, PRISMA, Literature review, Optimization},
abstract = {The hybrid flowshop scheduling problem (HFSP), which combines classical flowshop and parallel machine scheduling environments, has gained significant attention in recent years and has various application areas such as manufacturing, healthcare management, seaport operations, agricultural activities, and cloud computing. The HFSP considers multiple stages, at least one of them includes identical, uniform, or unrelated parallel machines, and aims to determine machine assignments and job sequences simultaneously at each stage. Since the HFSP has an NP-hard structure as a combinatorial optimization problem, exact methods like the branch & bound algorithm are not capable of obtaining promising solutions for large-sized problems within a reasonable time. At this point, meta-heuristic algorithms inspired by nature and based on mathematical concepts are effectively utilized to solve this type of complicated optimization problem. Therefore, in this paper, a state-of-the-art review on meta-heuristics applied to solve HFSPs has been carried out using the Preferred Reporting Items for Systematic Reviews and Meta-Analyses (PRISMA) methodology, which enables the realization of systematic reviews and meta-analyses in a specified research domain. As a result of the execution of this systematic review methodology, 328 articles published in a decade from 2015 to 2024 have been determined and these articles have been statistically and mathematically analyzed in terms of various characteristics such as year, country, journal, publisher, objective functions, meta-heuristic optimization methods, performance metrics, test instances, and parameter optimization techniques. The analysis results have been presented through charts and tables for visual demonstration with the aim of revealing the current state of the existing literature, recent developments, and future research suggestions related to meta-heuristic algorithms used to solve the HFSPs. Thus, it has been desired to provide a beneficial road map for researchers conducting research in this area.}
}
@article{KALUZA2026115251,
title = {Fast approximate loss change for active learning on imbalanced data},
journal = {Applied Soft Computing},
volume = {198},
pages = {115251},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115251},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600699X},
author = {Daniel Kałuża and Andrzej Janusz},
keywords = {Active learning, Pool-based sampling, Imbalanced classification, Expected error reduction approximation, Density-based representativeness},
abstract = {Expected Error Reduction (EER) is a technique used in active learning to optimize the selection of data samples for labeling. It does so by estimating the impact of acquired labels on the expected error rate of the prediction model. However, this technique requires heavy computations, which can be infeasible in many practical applications due to the need to retrain the model multiple times during the sample selection process. To address this issue, we propose the Fast Approximate Loss Change (FALC) algorithm which removes the retraining necessity from EER by approximating the expected loss change. This approximation is based on the observation that most error rate changes occur on samples that are similar in some way. However, similarity in the input space may not be reliable, as some of the features might be irrelevant to the model. Therefore, our proposed method computes similarity in the model output space, highlighting the unique perspective of the model on the samples. We explain the approximation steps and how they relate to the original EER approach. We also provide complexity considerations for our method. Finally, we present the results of experiments conducted to compare the performance of our algorithm with other commonly used active learning techniques on six large datasets. The findings demonstrate that our approach outperforms established methods, with particularly strong improvements on imbalanced prediction tasks.}
}
@article{LIU2026115248,
title = {A novel efficient improved Heap-based optimizer with its comprehensive evaluation method for solving engineering optimization problems},
journal = {Applied Soft Computing},
volume = {198},
pages = {115248},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115248},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006964},
author = {Jingsen Liu and Ruyue Wang and Yu Li and Lin Sun},
keywords = {Metaheuristic algorithm, Heap-based optimizer, Differential update strategy, Performance evaluation, Engineering optimization problems},
abstract = {The Heap-Based Optimizer (HBO) is a novel metaheuristic algorithm inspired by corporate hierarchical structures for solving optimization problems, but HBO still exhibits shortcomings when optimizing complex problems, such as insufficient search ability and imbalance in exploration-exploitation. Therefore, this article proposes an efficient improved Heap-based optimizer called SADHBO. Firstly, a sine-proportion allocation probability strategy is designed, effectively balancing the exploration and exploitation abilities. Meanwhile, an alternating search strategy based on iteration parity is incorporated, significantly enhancing global exploration ability in dynamic solution spaces. Finally, a differential update strategy based on comprehensive scores is proposed, which generates new individuals through dynamic migration and adaptive dimensional mutation perturbation, thereby improving convergence precision. Theoretical analysis demonstrates that SADHBO and HBO remain within the same order of magnitude in terms of time complexity based on dimension, and SADHBO exhibits global convergence. Moreover, the effectiveness and balance of the SADHBO mechanisms are verified through ablation experiments, convergence behavior analysis, and exploration-exploitation analysis. SADHBO has been comprehensively compared through experiments with various advanced representative optimization algorithms and CEC winning algorithms on CEC2022, CEC2014 and CEC2021. Through solution precision, scalability testing, box plot analysis, and convergence curve analysis, SADHBO demonstrates significant enhancements in solution accuracy, convergence speed, stability, and high-dimensional adaptability. Meanwhile, Wilcoxon rank-sum testing and Friedman statistical ranking have been adopted to validate the significantly superior optimization results of SADHBO. Furthermore, SADHBO is efficiently applied to several complex constrained engineering problems, and the solution data verify its practical value, solution advantages, and broad application prospects in actual static engineering optimization scenarios.}
}
@article{SU2026115264,
title = {Decoupled temporal and spatial features for adaptive visual tracking},
journal = {Applied Soft Computing},
volume = {198},
pages = {115264},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115264},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600712X},
author = {Yi Su and Yi Zhang},
keywords = {Attention mechanism, Decoupled temporal and spatial features, Spatiotemporal modeling, Task-specific features, Visual object tracking (VOT)},
abstract = {Recent high-performing visual trackers have increasingly explored temporal cues, yet most still follow an autoregressive paradigm. As target representations evolve over time, preserving historical information and updating the current state often become conflicting objectives, which may lead to cumulative errors. In addition, the spatial misalignment between classification and regression branches remains a bottleneck for accurate localization. To address these issues, we propose a novel tracker named DCTrack, which decouples temporal and spatial feature learning for adaptive visual object tracking. Specifically, we introduce a Temporal Propagation Decoupling Strategy (TPDS) that separates target representation extraction from temporal state indication, thereby alleviating the conflict between preserving historical context and adapting to target changes. We further propose an Enhanced Spatial Decoupling Strategy (ESDS), which generates task-specific spatial features for classification and regression via Target Response Maps (TRMs), mitigating the misalignment between their learning objectives. Extensive experiments on four large-scale benchmarks demonstrate that DCTrack achieves state-of-the-art performance and consistently outperforms strong competitors. The source code is available at: https://github.com/shirosy/DCTrack}
}
@article{QU2026115285,
title = {AUV-Net: An adaptive feature fusion network for small object detection in unmanned aerial vehicle scenes},
journal = {Applied Soft Computing},
volume = {198},
pages = {115285},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115285},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007337},
author = {Zenghui Qu and Haiying Liu and Weigang Kong and Jason Gu and Chaoqun Wang and Lixia Deng and Lida Liu},
keywords = {Deep learning, Feature fusion, Computer vision, Unmanned aerial vehicles},
abstract = {With the rapid expansion of low-altitude applications, object detection using unmanned aerial vehicles (UAVs) has attracted increasing research interest. This task remains challenging due to the high prevalence of small objects, substantial scale variations, and complex backgrounds, which often degrade the performance of existing detection algorithms in aerial and remote sensing scenarios. To overcome these limitations, the Accurate UAV Vision Network (AUV-Net) is introduced as a UAV-oriented object detection framework optimized across three key aspects: feature extraction, feature fusion, and downsampling. In particular, the Cross Stage Partial with kernel size 2 Partial and Soft (C3k2PS) module enhances feature representation and reduces redundancy through channel-selective modeling and activation continuity optimization. The Weighted Shallow Feature Pyramid Network (WSFPN) enables multi-level fusion by integrating high-resolution shallow features with adaptive weighting to strengthen small-object perception. Furthermore, the Spatial-Channel Decoupled Downsampling (SCDown) module decouples spatial and channel processing, preserving structural information while reducing computational complexity. Extensive experiments on five representative datasets demonstrate that AUV-Net consistently outperforms baseline methods, achieving improvements of 1.9%, 4.5%, 0.6%, 1.3%, and 1.8% in mean Average Precision@0.50 (mAP@0.50), respectively. These results validate the effectiveness and generalizability of AUV-Net for complex UAV-based object detection scenarios.}
}
@article{DAS2026115258,
title = {A novel S/N ratio-based measure of Z-number and its application in NASA-TLX},
journal = {Applied Soft Computing},
volume = {198},
pages = {115258},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115258},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007064},
author = {Souvik Das and J. Maiti and Ashish Garg},
keywords = {Cognitive workload, NASA-TLX, Multi-dimensional workload, Z-number, Exploratory factor analysis, EOT crane operations},
abstract = {Operators face difficulties in representing their perceived workload in crisp numbers on NASA-TLX. Instead, they prefer to provide their ratings in linguistic form. The study used Z-number to better capture the perceived mental workload of the operators. Further, the study investigated multi-dimension construct of mental workload. The study conducted a mixed factorial 23 within-subjects experiment with number of hazardous sources, complexity level of the activities, and time spent at night shift as independent variables; and NASA TLX ratings as dependent variables in regards to EOT crane operations. After each experimental run, ratings of the operators on their perceived workload as per the task assigned were collected in Z-linguistic terms. The study proposes an improved mental workload assessment methodology comprising three novel developments: signal-to-noise (S/N) ratio-based Z-measure, Z-full consistency method, and Z-Entropy. Results demonstrates that two hidden dimensions, physical exertion and cognitive efficacy, can be used to represent the perceived mental workload of the human operators. Statistical analysis suggests that hazardous sources and the complexity level of the activities have significant main effects on operators' cognitive efficacy and physical exertion. However, there is a statistically non-significant effect of the time spent at night shift on these two hidden dimensions.
Practitioner Summary
The study investigated the construct of perceived mental workload based on NASA-TLX. The study explores a novel approach to express the ambiguity and impreciseness in perceived opinions on NASA-TLX, and quantitatively analyze them. Results indicated that multidimensional construct of perceived mental workload exhibited better representation of the mental process.}
}
@article{ALFIN2026115310,
title = {Attention guided spectral feature selection for efficient soil nutrient prediction},
journal = {Applied Soft Computing},
volume = {198},
pages = {115310},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115310},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007581},
author = {Achmad Arif Alfin and Nanik Suciati and Wijayanti Nurul Khotimah},
keywords = {Spectral selection, Soil nutrient prediction, Spectral covariance},
abstract = {High-dimensional hyperspectral data pose challenges for soil nutrient modeling due to computational costs, redundancy, and noise. While band selection can mitigate these issues, existing methods often overlook cross-nutrient correlations or incur significant processing overhead due to decoupled selection and prediction stages. To address these challenges, we present AG-SFS, an end-to-end nutrient prediction model that employs a Feature-Wise Attention mechanism to capture overlapping absorption regions across the VNIR and SWIR domains. AG-SFS utilizes a composite loss function integrating l1 sparsity, Total Variation for spectral smoothness, and negative entropy for focused weight distribution. Evaluated on the LUCAS dataset, AG-SFS demonstrates superior performance across all targets, achieving R2 values of 0.80, 0.45, and 0.63 for N, P, and K, respectively outperforming state-of-the-art full-spectrum and band-selection baselines. Furthermore, the model requires only 2.22 M FLOPs per sample, representing a 74-fold reduction in computational cost compared to full-spectrum DNNs. These results confirm that AG-SFS effectively isolates chemically diagnostic features, providing a high-precision and resource-efficient solution for soil nutrient analysis.}
}
@article{FANG2026115229,
title = {A belief rule-based two-sided medical decision model considering patient preferences and historical reasoning rules},
journal = {Applied Soft Computing},
volume = {198},
pages = {115229},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115229},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006770},
author = {Ran Fang and Huchang Liao and Xincong Liu and Lisheng Jiang},
keywords = {Medical decision making, Belief rule-base inference, Evidential reasoning, Two-sided matching, Three-way decision theory},
abstract = {In personalized healthcare, selecting the most suitable treatment plan is a two-sided matching problem, requiring the alignment of patient characteristics (e.g., age, symptoms) with treatment plan attributes (e.g., efficacy, risk, cost). Existing methods face challenges in terms of attribute weight determination, lacking of consideration for historical clinical reasoning data, and insufficient attention to patient preferences and hesitancy. To address these issues, this paper proposes a belief rule-based two-sided medical matching model that integrates patient preferences and historical reasoning rules. It combines Bayesian Best Worst Method (BWM) with Shannon entropy for weight determination, integrates the belief rule-base inference methodology using the evidential reasoning approach (RIMER) based on historical reasoning rules to enhance decision-making, and introduces a “further evaluation” option alongside the traditional “accept-reject” decision by applying the three-way decision theory, accounting for patient hesitancy and cost-benefit trade-offs. A case study validates the effectiveness of the proposed model, with sensitivity and comparative analyses demonstrating its robustness. This study provides a practical framework for patient-centred medical decision making.}
}
@article{ALKAYA2026115274,
title = {Cross-domain performance analysis of meme selection strategies in multi-meme memetic algorithms},
journal = {Applied Soft Computing},
volume = {198},
pages = {115274},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115274},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007222},
author = {Ali Fuat Alkaya and Ender Özcan},
keywords = {Evolutionary algorithms, Self-adaptation, Co-evolution, Hyper-heuristics},
abstract = {Multi-meme Memetic Algorithms are a class of self-adaptive approaches in memetic computing for tackling computationally hard optimisation problems. The memetic material representing algorithmic components, such as genetic operators and their settings to be used during the search process is co-evolved simultaneously along with the genetic material. The classical meme propagation method referred to as the simple inheritance mechanism selects the fitter parent’s memes and transfers them to the offspring after crossover. This process represents the diffusion of ideas through the population, which actually mimics cultural evolution. There is almost no thorough analysis of other potential meme selection strategies for meme propagation in the scientific literature. In this study, we designed six different meme selection strategies and embedded them into the steady-state and trans-generational multimeme memetic algorithms, thus creating twelve different self-adaptive approaches. Using the HyFlex software library for cross-domain search, we conducted extensive experiments on ninety-eight instances from nine problem domains and observed consistently strong performance of the proposed strategies across varied population sizes and innovation rate settings. The results show that the proposed meme selection methods improve the cross-domain performance of the multimeme memetic algorithm in both steady-state and trans-generational regimes.}
}
@article{JIANG2026115290,
title = {Multi-step ahead carbon credit price forecasting using time series foundation models},
journal = {Applied Soft Computing},
volume = {198},
pages = {115290},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115290},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007386},
author = {Lian Lian Jiang and Wei Soon Cheong and Jamie Suat Ling Ng},
keywords = {Carbon credit price forecasting (CCPF), EU ETS, Carbon market, Machine learning, Time series foundation model},
abstract = {Accurate carbon credit price forecasting (CCPF) is critical for enhancing market transparency, supporting regulatory planning, and guiding sustainable investments. Traditional forecasting approaches, such as statistical, machine learning (ML), and deep learning (DL), have been widely applied for short-term predictions, but they struggle with long horizon prediction due to their limited ability to capture long-range temporal structures. Recent advances in time series foundation models (TSFMs) have demonstrated strong generalization capabilities across diverse domains, yet their application to carbon credit markets remains underexplored. This study investigates the potential of state-of-the-art TSFMs, including Tiny Time Mixer (TTM), TimeGPT-1, MOIRAI, Lag-Llama, and MOMENT, for multi-step-ahead daily and monthly CCPF. These models advance CCPF by: (i) capturing long-range dependencies and nonlinear market dynamics more effectively than conventional methods, (ii) maintaining strong long-horizon performance with minimal feature engineering, and (iii) enabling robust zero-shot forecasting for sparse or volatile markets. Experimental results show that TSFMs consistently outperform traditional ML/DL and hybrid models in long-horizon settings. Specifically, TSFMs provide substantial long-range accuracy gains: MOIRAI reduces daily long-term (>40 days) MAPE by 21.08–21.32% compared to the top three classical baselines, while Lag-Llama improves monthly long-term (>8 months) MAPE by 9.24–23.76% over the same baselines. Although TSFMs are less dominant in short-term monthly predictions, with ARIMA performing the best for short-term daily forecasts (<40 days), TTM and MOIRAI remain consistently within the top three models. These findings highlight the potential of foundation models as robust, scalable tools that enhance long-horizon forecasting and support adaptive carbon market analytics.}
}
@article{WANG2026115221,
title = {Conditional local feature encoding for graph neural networks},
journal = {Applied Soft Computing},
volume = {198},
pages = {115221},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115221},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626006691},
author = {Yongze Wang and Haimin Zhang and Qiang Wu and Min Xu},
keywords = {Deep learning, Graph neural networks, Graph-structured data analysis, Graph representation learning, Conditional local feature encoding},
abstract = {Graph neural networks (GNNs) have achieved remarkable success in learning non-Euclidean data. Most GNNs follow a message passing paradigm in which each node updates its representation by aggregating information from its neighbours. However, as the number of message passing layers increases, node representations tend to become increasingly dominated by neighbourhood information. Consequently, in a deep GNN, adjacent nodes tend to acquire similar features, making them harder for the model to distinguish. To address the aforementioned issue, we propose Conditional Local Feature Encoding (CLFE), a plug-in module that preserves node-specific information by generating each layer’s output embeddings conditioned on nodes’ own local features. In each GNN layer, CLFE first computes an encoding from the node’s aggregated representation conditioned on its representation from the previous layer, and then combines this encoding with the aggregated node representation to produce the layer output. This method preserves more information from each node itself, thereby mitigating the dominance of neighbourhood information in each node’s representation. We experimentally validate the proposed method on seven benchmark datasets across different tasks. The experimental results demonstrate that our method achieves an average performance improvement of 10.55% on GCN and 13.3% on MoNet, with competitive improvements on GraphSAGE, GAT and GatedGCN.}
}
@article{WANG2026115266,
title = {Contrastive-Aware Hierarchical Multimodal Fusion Network for Hyperspectral and LiDAR Joint Classification},
journal = {Applied Soft Computing},
volume = {198},
pages = {115266},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115266},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007143},
author = {Bangjun Wang and Kai Xu},
keywords = {Contrastive learning, Cross-modal interaction, Remote sensing classification, False-negative samples, Weighting},
abstract = {Within modern remote sensing analytics, the fusion of hyperspectral imagery (HSI) and light detection and ranging (LiDAR) data is pivotal for high-accuracy image classification. However, training high-performance classification models relies on extensive labeled samples, whose manual annotation is prohibitively time- and labor-intensive. This has spurred the adoption of unsupervised learning paradigms, most notably contrastive learning. Nonetheless, contrastive learning suffers from inherent limitations: false negative samples and spatial information loss, which impede cross-modal semantic consistency preservation. Furthermore, inherent discrepancies between HSI and LiDAR data, arising from distinct imaging mechanisms, hinder the interaction and fusion of their complementary features. To address these challenges, we propose a contrastive-aware hierarchical multimodal fusion network (CHMFNet), which unifies cross-modal feature interaction and hierarchical fusion strategies. CHMFNet employs an enhanced contrastive loss: cosine similarity prunes potential false negatives to mitigate their adverse effects, while a similarity-based weighting mechanism strengthens semantic consistency within and across modalities. Meanwhile, a mean squared error (MSE) loss term compensates for spatial information degradation in contrastive learning. To mitigate modal heterogeneity, we design a densely connected encoder-decoder architecture, and embed a joint spatial-channel attention (JSCA) module to enable multi-scale feature interaction while preserving shallow spatial details. We further develop a hierarchical multimodal fusion (HMMF) module to integrate local, global, and latent features, enabling comprehensive complementary information fusion. Extensive experiments on the Houston2013, Trento, and MUUFL datasets show that CHMFNet achieves state-of-the-art performance, with overall accuracies (OA) of 94.41%, 99.50%, and 83.87%, respectively. Notably, marginal improvements on Trento stem from performance saturation, while significant gains on Houston2013 and MUUFL validate our method’s effectiveness. These results confirm that CHMFNet effectively mitigates modality heterogeneity and limited labeled data constraints, offering a robust framework for multimodal remote sensing classification.}
}
@article{MENDEZ2026115261,
title = {Combining a novel metric and categorical boosting to better estimate rare event likelihood: Use in traffic accidents},
journal = {Applied Soft Computing},
volume = {198},
pages = {115261},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115261},
url = {https://www.sciencedirect.com/science/article/pii/S156849462600709X},
author = {Manuel Méndez and Gregorio Díaz and Mercedes G. Merayo and Manuel Núñez},
keywords = {Machine learning, Gradient boosting decision tree, Categorical boosting, Urban accidents},
abstract = {Recent data indicate a notable increase in urban accidents, particularly in Spain. Numerous factors contribute to accidents, often involving various combinations of them. This study aims to assess the probability of an accident occurring under specific conditions in Madrid. Understanding the probability of accidents under specific conditions is crucial for improving road safety, optimizing traffic management, and informing policy decisions. We apply Categorical Boosting (CatBoost) to estimate accident probabilities using three complementary approaches. The first approach utilises all predictor variables and the entire dataset. The second approach removes the road variable and estimates probabilities separately for each road, assuming that road-specific models might improve prediction quality. The third approach excludes time-related predictor variables, creating 24 models, one per hour, to assess whether time is the most influential factor. To evaluate model performance, we introduce a novel metric quantifying how much the probability of an accident increases when one has already occurred. Additionally, we use traditional metrics. Our findings demonstrate that CatBoost models consistently outperform baseline models in most cases, achieving higher accuracy and balanced accuracy scores on average. Therefore, the results highlight the effectiveness of CatBoost in predicting accident probabilities and suggest that road-specific and time-specific modelling approaches can provide valuable insights for urban accident analysis and prevention strategies.}
}
@article{ALBEDRAN2026115270,
title = {Hybrid fertilized particle swarm optimization for engineering design with application to vibration control},
journal = {Applied Soft Computing},
volume = {198},
pages = {115270},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115270},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626007180},
author = {Hazim Albedran and Edina Koch and Károly Jármai and Luay Sadiq Al-Ansari and Zaid Alyasseri},
keywords = {Passive vibration control, Tower crane, Weight minimization, Flower fertilization optimization, Natural frequencies, Mode shapes, Structural optimization, Particle swarm optimization},
abstract = {Structural vibration control is a critical challenge in engineering systems such as tower cranes, where excessive oscillations compromise safety and operational accuracy. This paper proposes a Fertilized Particle Swarm Optimization (FRPSO) algorithm that hybridizes Particle Swarm Optimization with Flower Fertilization Optimization via a dual-phase global-best update to enhance the exploration–exploitation balance. FRPSO is evaluated on 26 problems (20 non-convex constrained cases, four 1000-variable large-scale benchmarks, structural optimization, and a tower crane vibration-control case study) and is compared against 18 metaheuristic optimizers. Across the benchmark suites, FRPSO achieves solution quality with consistent run-to-run stability, achieving near-optimal objective values with very low dispersion in the 1000-variable tests under the reported experimental protocol. In structural optimization, FRPSO reduces the weight of the 72-bar truss from 381.91 lb (PSO) to 379.63 lb. For the tower crane boom modeled as a 3D beam structure under transient dynamic loading, FRPSO yields designs that achieve effective vibration attenuation, as evidenced by the rapid decay of boom-tip vertical displacement responses, while satisfying stress and displacement constraints. Non-parametric statistical comparisons based on the Wilcoxon signed-rank test indicate that the observed improvements are consistent across repeated runs for selected benchmark cases. Overall, the reported results suggest that FRPSO can be effectively applied to vibration-aware structural design of crane booms and other flexible beam-type structures.}
}