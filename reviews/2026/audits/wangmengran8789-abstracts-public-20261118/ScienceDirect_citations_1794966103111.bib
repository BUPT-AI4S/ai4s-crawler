@article{LIU2026115860,
title = {RA-GAN: Region-adaptive GAN for binarization on degraded document images},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115860},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115860},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005861},
author = {Menghui Liu and Lang Yu and Yiming Qin and Guanghui Wang and Lingfeng Shen},
keywords = {Degraded document image binarization, Generative adversarial networks, Single-stage architecture, Dynamic convolutions, Degraded region localization},
abstract = {Binarization is a crucial pre-processing step for the visual analysis of degraded document images, which usually exhibit artifacts such as ink bleeding, stains, holes, and creases. Existing methods typically conduct binarization by modeling long-range dependencies between foreground and background pixels. However, two critical problems remain to be investigated: (1) the inability to accurately locate degraded regions, leading to inadequate adaptive feature learning, and (2) the failure to effectively utilize small variations at the edges of degraded regions. To address these issues, this paper proposes an image binarization method called RA-GAN, which can accurately locate degraded regions and perform fine-grained modeling. Specifically, RA-GAN comprises three main modules: the Gradient Gated Convolution (GGC) module, the Guided Attention (GA) module, and the Gated Feature Pyramid (GFP) module. The GGC module captures pixel mutation information from the neighborhood using a locally modulated convolution kernel and employs a gating mechanism to activate global information for adaptive supplementation. The GA module identifies degraded regions at the pixel level to capture fine-grained variations. The GFP module effectively restores the learned information using its unique structure. Comprehensive evaluations on five degraded document image datasets show that RA-GAN achieves competitive performance with the lowest number of trainable parameters and computational costs. More generalization experiments further validate RA-GAN’s effectiveness and potential for future development. Available codes: https://github.com/bzlmh/RA-GAN.}
}
@article{DONG2026115900,
title = {Hybrid multi-channel physics-aware deep unfolding for compressive sensing reconstruction},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115900},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115900},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600626X},
author = {Hao Dong and Shuyang Luo and Jiachang Qian and Qi Zhou},
keywords = {Compressive sensing, Multi-channel vibration, Deep unfolding, ADMM-inspired reconstruction, Fault diagnosis},
abstract = {Condition monitoring of ship and submarine propulsion systems generates massive multi-sensor vibration data, creating significant bandwidth, storage, and energy bottlenecks for resource-constrained Industrial Internet of Things (IIoT) edge nodes. Although compressive sensing (CS) can reduce acquisition and transmission costs, conventional reconstruction algorithms often suffer from high latency and degraded fault-feature preservation when signals are nonstationary and only weakly sparse. Meanwhile, purely data-driven deep learning approaches may exhibit limited interpretability, sensitivity to data distribution shifts, and non-negligible computational overhead for edge deployment. To address these challenges, this paper proposes Hybrid Multi-Channel Physics-Aware Deep Unfolding for Compressive Sensing Reconstruction (HPACS). The framework employs a coupled multi-channel sensing operator to exploit inter-channel correlations while maintaining controlled sensing diversity. Reconstruction is implemented through an ADMM-inspired deep-unfolding architecture with a row-sparse ℓ2,1 prior and residual-aware adaptive thresholding, enabling stable recovery under ultra-low compression ratios (CRs). A late-stage refinement further integrates time-domain correction and amplitude–phase spectral modulation with high-frequency enhancement and learnable mixing to preserve impulsive fault signatures. End-to-end training with a multi-domain composite loss improves both waveform fidelity and time–frequency consistency. Experiments on the Self-built Gearbox (SGB) and Southeast University (SEU) datasets demonstrate that HPACS effectively preserves diagnosis-relevant information under aggressive compression, achieving high diagnostic accuracy even at ultra-low CRs. In addition, edge-side evaluations confirm that the proposed framework maintains lightweight computational complexity and energy-efficient inference, making it suitable for real-time fault diagnosis on IIoT edge devices.}
}
@article{PAN2026115921,
title = {Temporal causal discovery-enhanced hierarchical monitoring for root cause diagnosis of aero-engine faults},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115921},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115921},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006477},
author = {Zhiwei Pan and Yang Hu and Joo-Ho Choi and Dingyang Zhang and Zheyuan Zhou and Shuyou Zhang and Yiming Zhang},
keywords = {Interpretable fault diagnosis, Temporal causal discovery, Root cause localization, Aero-engine health management, Graph neural network},
abstract = {Aero-engines are highly coupled dynamic systems that demand predictive health management solutions with structural transparency and diagnostic traceability. However, existing approaches often address fault detection and root cause analysis in isolation, while reliable causal structure learning from multivariate time-series data remains challenging. This paper presents a unified root cause diagnosis framework that integrates temporal causal discovery with hierarchical monitoring. The pipeline begins with a prior-guided deep reinforcement learning method, designed to infer stable causal structures among temporal variables using statistically grounded scoring. The learned causal graph serves as a structural backbone for a lightweight causal graph-guided temporal attention model that performs system-level fault detection by jointly modeling spatial and temporal dependencies. A histogram-based monitor quantifies anomaly proportions, and detected deviations are traced along causal propagation paths to localize root causes. Extensive experiments on synthetic datasets and the CMAPSS aero-engine benchmark demonstrate competitive detection performance while providing interpretable fault propagation analysis and precise localization capability.}
}
@article{WANG2026115905,
title = {LiSA: A linear graph transformer framework with sample aggregation},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115905},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115905},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006313},
author = {Qian Wang and Qingfeng Chen and Shiyuan Li and Shirui Pan},
keywords = {Graph neural networks, Graph classification, Linear attention, Sample aggregation},
abstract = {Graph neural networks (GNNs) are essential for graph classification. Recent studies have shown that graph transformer (GT) outperforms vanilla GNNs in learning global graph representations. GT effectively filters out irrelevant neighbours by applying attention mechanisms to identify highly relevant nodes, thereby enhancing its performance. However, their high complexity and substantial memory requirements make them impractical for large-scale applications. Although linear GT and its variants attempt to mitigate these costs through kernel tricks, their performance is inferior to that of vanilla GT. Some variants aim to enhance accuracy by incorporating parameters; however, this can increase computational overhead and compromise linear efficiency. This article proposes LiSA, a linear GT framework with sample aggregation. Its core innovation is replacing traditional node-neighbor attention with node-neighbor-cluster attention via sample aggregation. Further, mathematical refinements reduce the number of parameters without compromising accuracy, resulting in an average running time reduction of 16.4%. Extensive experiments on eight benchmark datasets demonstrated that LiSA is an efficient framework that accurately approximates the attention distribution with high robustness. The results demonstrate that our method outperforms 14 baseline methods and matches or exceeds the state-of-the-art performance. Code is available at: https://github.com/cirila9/LiSA.}
}
@article{SINGH2026115800,
title = {LLM-based harmonized data ingestion for dataspace: a novel system for automating data ingestion across heterogeneous data sources},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115800},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115800},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005265},
author = {Parwinder Singh and Michele Gaspari and Nirvana Meratnia and Mirko Presser},
keywords = {Dataspace, Data Ingestion, Harmonization, Interoperability, LLM},
abstract = {Dataspaces (DS) enable stakeholders to collaborate on innovative, data-driven services by integrating data across domains. However, the realization and adoption of DS remain challenging due to domain-specific heterogeneity at the system, service, and data levels. While system and service-level heterogeneity can often be addressed through standards, data-level heterogeneity, namely data structures and semantics variations, remains challenging. To effectively ingest data into the DS, two communication endpoints must correctly interpret each other’s data models, therefore, DS ecosystems rely on “harmonization”, the process of generating a unified target data model from heterogeneous sources and transforming incoming data accordingly. Currently, harmonization and transformation are performed manually whenever new data sources are integrated. This is time-consuming, costly, and difficult to scale, posing a critical barrier to the realization and adoption of DS in practice. This study proposes a novel methodology for automated data harmonization during ingestion into DS ecosystems. The approach integrates harmonization, transformation, and human-in-the-loop evaluation within an automated system powered by modern LLM-based AI agents. These agents address data-level heterogeneity and generate harmonized target data models, representing a substantial departure from current manually-handled data harmonization. The system is validated through a healthcare use case, demonstrating its practical feasibility for harmonization during data ingestion into the DS. Overall, this work provides a foundational step toward seamless, efficient, and scalable data integration in DS. By automating data harmonization, it delivers substantial value to industry digital solutions as well as domains where data heterogeneity persists, including IoT or Big Data platforms.}
}
@article{LIU2026115913,
title = {Three deep reinforcement learning architectures for left ventricle contouring in cardiac images},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115913},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115913},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006398},
author = {Xiaogang Liu and Shuang Song},
keywords = {Deep reinforcement learning, Deep learning, Image segmentation, Left ventricle segmentation},
abstract = {The assessment of left ventricle (LV) segmentation in cardiac magnetic resonance imaging (MRI) is essential for diagnosing cardiac diseases. Traditional manual segmentation is labor-intensive, necessitating significant reliance on manual intervention, which highlights the appeal of automated segmentation techniques to streamline clinical diagnosis. By framing the segmentation task as a Markov Decision Process (MDP), where an agent navigates the imaging data to efficiently delineate the organ’s structure, LV segmentation can be likened to a path finding problem. In this study, we propose three Deep Reinforcement Learning (DRL) frameworks that mimic the human process for LV segmentation. These frameworks include the offline policy Deep Q-Network (DQN) and online policies such as proximal policy optimization (PPO). Additionally, we adapt the Group Relative Policy Optimization (GRPO) algorithm, initially proposed by Deep Seek for large language model training, for LV segmentation. Furthermore, a deep learning model with a specialized loss function is developed to determine the initial edge point. Experiments conducted on the ACDC 2017 and Sunnybrook 2009 datasets demonstrate the efficacy of DRL in automated medical segmentation.}
}
@article{ZHANG2026115909,
title = {Simplicial complex neural networks for deterministic and uncertain knowledge graph embedding},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115909},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115909},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006350},
author = {Dong Zhang and Yincang Pan and Yandong Ren and Guanyu Li and Bo Ning and Wenyan Fan},
keywords = {Deterministic knowledge graph embedding, Uncertain knowledge graph embedding, Representation learning, Simplicial complex},
abstract = {Knowledge graph embedding (KGE) aims to represent entities and relations by leveraging the structural information within knowledge graphs. Based on the determinacy of knowledge representation, KGE methods can be categorized into deterministic KGE (DKGE) and uncertain KGE (UKGE). Although graph neural network models have achieved notable progress in both DKGE and UKGE, three key challenges remain: (1) In the DKGE setting, many models focus primarily on pairwise feature aggregation while overlooking the role of high-order interactions. (2) In the UKGE setting, current graph neural network models struggle to capture high-order uncertain features. (3) Also within the UKGE setting, accurately evaluating the uncertainty of unseen triples remains difficult. To address challenge (1), we propose SCKGE (simplicial complex neural network for KGE). SCKGE employs a graph neural network to learn pairwise features and a simplicial complex neural network (SCNN) to model high-order features. An adaptive mechanism is then introduced to integrate both feature types. To address challenges (2) and (3), we introduce SCUKGE (SCNN for uncertain KGE). SCUKGE incorporates an uncertainty factor to encode high-order uncertain structural information and further utilizes a language model to assess the uncertainty of unseen triples. To the best of our knowledge, we are the first to apply a SCNN to multi-relational graphs and the first to integrate a language model into uncertain KGE. Experimental results show that, on the WN18RR dataset, incorporating SCNN into SCKGE improves mean reciprocal rank by 5.2%, while on the NL27k dataset, SCNN improves the performance of SCUKGE by 1.5%.}
}
@article{CHI2026115881,
title = {An accuracy-efficiency balanced dehazing method via dual priors and haze condition classification},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115881},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115881},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006076},
author = {Jing Chi and Yanbing Wang and Bingyi You and Shiwei Wu},
keywords = {Image dehazing, Dual priors, Haze condition classification, Transformer},
abstract = {Existing image dehazing methods present a trade-off between accuracy and efficiency: high-performance models typically rely on complex network architectures, whereas simpler models usually sacrifice dehazing quality. To address this limitation, we propose a novel dehazing method that balances accuracy and efficiency by leveraging the dark channel prior (DCP) and the color attenuation prior (CAP), thereby improving computational efficiency while maintaining high-quality dehazing. First, we establish a new haze condition classification criterion by analyzing the relationship between DCP, CAP, and varying haze levels in images. Based on this analysis, a haze condition coefficient that integrates DCP and CAP is formulated for effective classification of hazy images. Second, we propose an accuracy-efficiency balanced dehazing framework based on haze condition classification and dual-prior constraints. The framework features a lightweight haze condition classifier (LHCC) and a multi-branch dehazing network (MCDNet). The LHCC utilizes dual priors to categorize images into light, moderate, or heavy haze conditions, while MCDNet processes the image through a dedicated branch corresponding to the classified haze level. Third, novel DCP and CAP loss functions are incorporated into MCDNet to further enhance dehazing performance. Finally, a haze condition classification loss and a joint training mechanism are proposed to jointly optimize classification accuracy, dehazing performance, and computational efficiency, thereby achieving a superior balance between performance and efficiency. Experimental results demonstrate that the proposed model significantly improves image clarity and color fidelity while maintaining high computational efficiency. Moreover, the modular branch architecture and extensible haze condition classification loss provide excellent scalability, enabling the model to easily accommodate four or more haze conditions.}
}
@article{GONZALEZSILOT2026115933,
title = {Enhancing disinformation detection with explainable AI and named entity replacement},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115933},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115933},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006593},
author = {Santiago González-Silot and Andrés Montoro-Montarroso and Eugenio Martínez-Cámara and Juan Gómez-Romero},
keywords = {Explainable AI, Trustworthy AI, Fake news, Disinformation, NLP, NER},
abstract = {The automatic detection of disinformation presents a significant challenge in the field of natural language processing. This task addresses a multifaceted societal and communication issue, which requires approaches that extend beyond the identification of general linguistic patterns through data-driven algorithms. In this research work, we hypothesize that text classification methods are unable to capture the nuances of disinformation, and they often base their decisions on superfluous features. Hence, we apply a post-hoc explainability method (SHAP, SHapley Additive exPlanations) to identify spurious elements with high impact on the classification models. Our findings indicate that non-informative elements (e.g., URLs and emoticons) should be removed, and named entities (e.g., Rwanda) should be pseudo-anonymized before training to mitigate models’ bias and increase their generalization capabilities. We evaluate this methodology on an internal dataset and external datasets before and after applying extended data preprocessing and named entity replacement. The results show that our proposal enhances, on average, the performance of a disinformation classification method with external test data by over 44% without a significant decrease in the internal test performance.}
}
@article{PAN2026115901,
title = {Geometry-guided multi-view 3D object detection for autonomous driving},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115901},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115901},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006271},
author = {Zefeng Pan and Huifeng Wang and Hao Du and Xiaowei Zhang},
keywords = {Multi-view 3D object detection, Autonomous driving perception, Geometric information in object detection, local geometric constraint},
abstract = {Recently, camera-based Bird’s Eye View (BEV) perception has played an increasingly important role in autonomous driving. However, existing LSS-based methods largely rely on 2D semantic cues to infer depth and geometry indirectly. They lack explicit modeling of 3D geometric structure, which limits both depth reconstruction and the geometric awareness of BEV representations. In this paper, we incorporate surface normals as an interpretable 3D geometric prior within the BEV framework, and proposed a novel geometry-guided approach for BEV perception. Based on a virtual sub-pixel local planar assumption and an analytic normal-depth relationship, we design a Normal-To-Depth Module. It reconstructs fine-grained depth geometry in a low-resolution space at a low cost, thereby guiding the estimation of discrete depth distributions. We further propose a plug-in, parameter-free Local Planar Depth Aggregation (LPDA) module that explicitly models local planar geometric consistency to aggregate discrete depth, alleviating depth holes and errors caused by sparse supervision. In addition, we design a Deformable Multi-Task (DMT) Head with cross-task deformable sampling interaction for joint learning. Together, these designs yields more accurate initial normal and depth predictions, and enhance subsequent geometric correction as well as the quality of BEV representation. On the nuScenes benchmark, our method achieves 61.9% NDS. Extensive experiments and ablations validate the effectiveness of the proposed designs, demonstrating the benefits of integrating normal-based geometric cues for BEV 3D detection.}
}
@article{MEHAVILLA2026115893,
title = {Unveiling user activities on instant messaging platforms: A study of activity fingerprinting through traffic analysis and machine learning techniques},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115893},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115893},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006192},
author = {Lorena Mehavilla and José García and Álvaro Alesanco},
keywords = {Instant message forensic, Traffic characterisation, Network traffic analysis, Machine learning, Activity fingerprinting},
abstract = {Encrypted instant messaging (IM) traffic conceals message content but still exposes communication patterns that can reveal user behaviour. This paper presents a unified framework for inferring user activities across multiple IM platforms by analysing encrypted traffic using machine learning techniques. The proposed approach integrates empirical traffic characterisation, transaction-centric segmentation, and lightweight classifiers to detect user actions, such as sending or receiving text and multimedia messages, in real time. Using Zeek as the core analysis engine, the framework performs packet inspection, transaction segmentation, connection classification, and feature extraction. The framework was evaluated on traffic from nine major IM platforms (Discord, Facebook Messenger, Instagram, Snapchat, Microsoft Teams, Telegram, WeChat, WhatsApp, and X), achieving F1 scores ranging from 0.62 for X up to 0.98 for WhatsApp. Unlike prior studies limited to single applications or synthetic datasets, our work employs realistic, user-driven traffic and explicitly distinguishes message type and direction, improving comparison and cross-platform generalization. Beyond methodological advancements, this study exposes privacy risks inherent in encrypted communication and outlines ethical safeguards and countermeasures to mitigate activity fingerprinting. The findings demonstrate that accurate, real-time inference of encrypted messaging activities is feasible under responsible, consent-based conditions, offering valuable insights for network forensics and privacy-aware communication design.}
}
@article{ZHANG2026115859,
title = {Adaptive-PVT: Unlocking the power of adaptive mechanisms for medical image segmentation},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115859},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115859},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600585X},
author = {Kaixuan Zhang and Sijia Zhao and Chunyang Wang and Shuqi Dong and Dingcan Hu and Geng Gao and Jinlin Yang and Tao Gan and Lixue Yin and Nini Rao},
keywords = {Medical image segmentation, Feature upsample, Boundary enhancement, Feature fusion, Blurred boundaries},
abstract = {Medical image segmentation is a pivotal task in computer-aided diagnosis yet remains a significant challenge due to the loss of fine details, blurred lesion boundaries, and insufficient feature fusion. To address these limitations, we propose a novel framework named Adaptive-PVT. By incorporating specialized adaptive mechanisms to optimize feature upsampling, enhance boundary delineation, and refine feature fusion, our method significantly improves both segmentation accuracy and robustness. Specifically, we design an adaptive feature upsampling module with feature alignment capabilities. By generating dynamic upsampling kernels that align low- and high-resolution features, this module effectively restores spatial details lost during downsampling. To mitigate boundary ambiguity, we introduce an adaptive boundary enhancement module that exploits local feature similarity to synthesize content-aware sampling kernels. explicitly sharpens boundary cues within low-resolution representations, ensuring precise delineation of target regions. Furthermore, we develop an adaptive feature fusion module based on gating units to integrate spatial and channel information. By computing adaptive weights, this module selectively fuses multi-scale features, effectively reducing redundancy while bolstering feature representations. Extensive experiments across four diverse medical image segmentation tasks demonstrate that the proposed method achieves state-of-the-art performance. Our approach excels in recovering fine details, enhancing boundary clarity, and integrating multi-scale contexts, underscoring its potential for advancing clinical segmentation applications.}
}
@article{NING2026115864,
title = {CM-TFD: Channel mask-based time-frequency decoupling for multivariate time series forecasting},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115864},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115864},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005903},
author = {Nianwen Ning and Yiting Feng and Zuxing Li and Wei Li and Xiaozhi Gao and Huu Nguyen Trung and Chang Liu and Yi Zhou},
keywords = {Multivariate time series forecasting, Multiscale analysis, Spurious correlation, Time-frequency decoupling, Structural constraints},
abstract = {Multivariate Time Series Forecasting (MTSF) is recognized as a pivotal technology for intelligent scheduling, risk prevention, and resource allocation in complex systems. However, two critical categories of distribution bias are encountered by existing MTSF models. First, dominant dynamics are obscured and time-dependent structures distorted by time-domain shifts induced by high-frequency noise and multi-scale aliasing. Second, complex channel interactions involve elusive nonlinear dependencies, where noise-induced spurious correlations in the structural domain force modeling to deviate from true mechanisms. To address these challenges, a novel framework named Channel Mask-Based Time-Frequency Decoupling (CM-TFD) is proposed, which integrates time-frequency analysis with a physics-guided channel masking mechanism to jointly correct temporal dynamics and cross-channel dependencies. Specifically, key dynamic patterns are enhanced through multi-level time-frequency analysis. Furthermore, a nonlinear dependency metric based on mutual information is introduced to generate the physics-guided channel mask, whereby spurious correlation bias driven by noise is effectively suppressed. A joint supervision loss across time and frequency domains is incorporated to balance local fitting and global spectral consistency via coefficient tuning. Prediction stability and generalization capability are significantly improved by this mechanism. The superior performance of CM-TFD compared to existing methods is demonstrated through extensive experiments on multiple real-world datasets. Furthermore, outstanding cross-distribution generalization and noise robustness are exhibited. The code has been made available at https://github.com/decisionintelligence-F/CM-TFD.}
}
@article{LEE2026115925,
title = {CodeEnhancer: LLM-generated Python code enhancement through SAST integration and fine-tuning},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115925},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115925},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006519},
author = {Jongmin Lee and Khang Mai and Nakul Ghate and Tomohiko Yagyu and Razvan Beuran and Yasuo Tan},
keywords = {Large Language Models (LLMs), Syntax checking, Vulnerability detection, Functional correctness, Static application security testing, LLM fine-tuning},
abstract = {Despite the rapid adoption of Large Language Models (LLMs) for automatic code generation, their output often exhibits syntax errors, security vulnerabilities, and functional inconsistencies. To address these issues, we present CodeEnhancer, a two-stage framework that tightly integrates LLMs with static application security testing (SAST) tools and targeted fine-tuning. The goal is to produce more secure and functionally correct Python code. In the first stage, our iterative validation pipeline couples LLM-generated code with tools such as Pylint and Bandit. These tools automatically identify and remediate issues through structured feedback loops. When applied to the GPT-4o model, this process eliminated 82.8% of the initial vulnerabilities and resolved all the detected functional correctness issues when tested on the LLMSecEval dataset. In the second stage, we fine-tune the LLMs using two types of secure code examples: expert-written samples and code refined by our framework. Comparative experiments demonstrate that the framework-tuned model outperforms the baseline and expert-tuned models. The framework-tuned model generates only 18.4% vulnerable code snippets on the LLMSecEval dataset, whereas the baseline and expert-tuned models produce 43.6% and 54.7% vulnerable code snippets, respectively. The framework-tuned model reduces final vulnerability rates to 6.7% on LLMSecEval and 3.5% on the SecurityEval dataset. Our results highlight the synergistic effect of integrating static analysis with feedback-informed fine-tuning. They also reveal limitations in current evaluation metrics and dataset representativeness. These findings suggest a scalable, robust approach to achieving more secure, trustworthy, and practical AI-assisted code generation.}
}
@article{YI2026115872,
title = {Dual-Branch representation alignment framework for deep multi-view clustering},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115872},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115872},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005988},
author = {Yugen Yi and Litao Huang and Zehui Zhang and Jingkai Guo and Xinping Rao and Yanni Zhang},
keywords = {Multi-view clustering, Representation learning, Dual-branch framework, Dual representation alignment},
abstract = {Deep Multi-View Clustering (DMVC) methods often generate only a coarse-grained common representation during feature fusion, neglecting low-level fine-grained details, which weakens the discriminative capability of the learned features. Meanwhile, mainstream Contrastive Learning-based MVC (CLMVC) methods struggle with interference from similar yet heterogeneous samples and representation degeneration, while also failing to sufficiently model inter-view feature alignment. To address these challenges, a Dual-Branch Representation Alignment (DBRA) framework is proposed for DMVC. Specifically, DBRA integrates a Dual-Branch Feature Learning (DBFL) module, which is consist of a Specific Feature Learning (SFL) branch to capture view-specific representations and a Common Feature Learning (CFL) branch to extract cross-view common representation. Then, DBRA employs a Dual Representation Alignment (DRA) mechanism to achieve multi-level collaborative alignment between common and view-specific representations. In DRA, a View-level Regularization Alignment (VRA) module based on the Frobenius-norm is proposed to minimize discrepancies between the two types of representations, thus ensuring robust cross-view global alignment with adaptive weighting of each view’s contribution. In contrast, an Instance-level Structural Contrastive Alignment (ISCA) module is designed to achieve local alignment at the instance level. In ISCA, a structural relation matrix is first constructed using a learnable inner-product graph decoder, followed by the design of a joint semantic-weighted and structure-aware contrastive learning paradigm, in which the semantic weights are provided by VRA, to enforce local semantic consistency within each view. Extensive experiments on 12 benchmark datasets demonstrate that DBRA consistently achieves state-of-the-art results across multiple metrics, exhibiting strong generalization ability and stability.}
}
@article{RAN2026115856,
title = {GASE: Generalized adaptive static enhancement for temporal sentence grounding},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115856},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115856},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005824},
author = {Ran Ran and Kaiwen Shen and Jiwei Wei and Ruikun Chai and Shiyuan He and Zeyu Ma and Yuyang Zhou and Malu Zhang and Yang Yang},
keywords = {Temporal sentence grounding, Cross-modal alignment, Prompt fine-tuning},
abstract = {Current Temporal Sentence Grounding (TSG) methods face significant generalization challenges due to sparse datasets and the semantic flexibility of text and video content, which limits the models’ ability to capture subtle and complex semantic interactions. To address these issues, this paper introduces a novel Generalized Adaptive Static Enhancement (GASE) grounding model that leverages the robust generalization capabilities of pre-trained large models. By utilizing the rich semantics and fine-grained parsing capabilities of large language models (LLMs), dynamic queries containing event information are decomposed into a series of static sentence queries describing individual images. These static queries not only exploit the robust matching capabilities of pre-trained image-text models but also enhance fine-grained semantics and temporal relevance. Specifically, GASE incorporates an adaptive prompt strategy with dynamic identifiers to fine-tune the encoder, embedding video priors into the encoding of dynamic queries. Furthermore, a memory-enhanced dynamic-static interaction module is designed to associate dynamic and static information using a memory mechanism. Through an adaptive static-enhanced decoder, GASE effectively extracts potential spans from video content and progressively refines them based on dynamic and static cues. Extensive experiments demonstrate that GASE significantly outperforms existing state-of-the-art methods. Its remarkable performance in out-of-distribution scenarios highlights its superior generalization capabilities, establishing it as a robust solution for TSG tasks.}
}
@article{LI2026115885,
title = {Logical reasoning in evolving scenarios: Evaluating LLMs with dynamic epistemic logic puzzles},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115885},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115885},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006118},
author = {Zhaoqun Li and Jieting Luo and Beishui Liao},
keywords = {Large language model, Multi-agent reasoning, Dynamic epistemic logic},
abstract = {Recent large language models (LLMs) have demonstrated strong performance on logical reasoning tasks, yet most studies focus on static, single-agent settings. In contrast, real-world scenarios often involve evolving information across multiple agents, requiring dynamic, multi-agent reasoning, an area that remains largely underexplored. To address this gap, we present a systematic evaluation of LLMs’ dynamic logical reasoning skills using puzzles grounded in dynamic epistemic logic, a formalism for modeling knowledge updates in multi-agent systems. Our study synthesizes two classic puzzles, the muddy children puzzle and Cheryl’s birthday puzzle, both of which require recursive reasoning about agents’ knowledge through sequential information exchanges. The proposed benchmark comprises 2784 samples of varying difficulty, facilitating a robust assessment through two complementary tasks: answer prediction and role playing. Experimental results indicate that while existing reasoning models perform well in simple scenarios, they exhibit a 20–30% drop in accuracy on more complex tasks. We identify two key error types: difficulty in recursive perspective-taking and the misinterpretation of precise logical implications. These deficiencies hinder the agents’ epistemic reasoning, leading to flawed conclusions on nuanced statements.}
}
@article{OK2026115961,
title = {Towards enhancing Natural Language Inference for identifying erroneous outputs in data-to-text generation},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115961},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115961},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006878},
author = {Changwon Ok and EunKyeong Lee and Hyeongju Ju and Jungseob Lee and Dongsuk Oh},
keywords = {Synthetic data, Large language model, Pre-trained Language Model, Data-to-text generation, Natural Language Inference, Hallucination detection},
abstract = {Large Language Models (LLMs) perform very well in natural language processing (NLP) tasks. However, Data-to-Text (D2T) generation – which converts structured data into natural language text – faces important challenges, including “omission” (missing important data) and “hallucination” (creating information not present in the original data). These problems significantly reduce the reliability and accuracy of generated text, making Natural Language Inference (NLI) models essential for effectively evaluating the relationships between generated sentences and their original data references. However, because LLMs require significant computational resources, many practical applications still use Pre-trained Language Models (PTLMs) with fewer parameters, even though these smaller models generally have lower performance. Until recently, the training objectives proposed in PTLMs based on the Transformer’s encoder architecture were limited in representing an anisotropic distribution that distinguishes nuanced semantic differences at the token or sentence level. To overcome these challenges, this study introduces an efficient NLI model that uses feedback from large-scale language models to better identify semantic differences and detect errors. The proposed model successfully addresses previous limitations and achieves performance comparable to larger models, outperforming existing baseline methods on D2T datasets.}
}
@article{GUO2026115929,
title = {Learning heterogeneous biological interactions via meta-relation-guided dual-channel graph transformer for circular ribonucleic acid function prediction},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115929},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115929},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006556},
author = {Yanbu Guo and Haokun Zhu and Jinde Cao and Rui Chen and Dongming Zhou},
keywords = {Complex networks, Neural networks, Representation learning, Association Mining},
abstract = {Circular ribonucleic acids(circRNA) are key regulators in complex diseases, offering insights into disease mechanisms and therapeutic opportunities. Data sparsity and the challenge of extracting both local and global interactions across diverse biomolecules limit the performance of existing methods. In this work, we combine the merits of biomolecule graph modeling and representation learning from meta-relations, and devise an adaptive dual-channel graph transformer to extract complex interaction patterns among diverse biomolecules. We construct a meta-relation-guided heterogeneous biological graph integrating circRNAs, diseases, and other biomolecules. We then devise an adaptive dual-channel graph transformer with a dual gate control strategy to extract relation-specific interdependencies via node- and edge-level attention, while a feature boost connection enhances topological and semantic information. Extensive experiments on benchmark datasets show that the proposed model outperforms state-of-the-art methods, achieving improvements of 2.41% in AUROC and 6.68% in AUPR. The model effectively handles complex biological graph data, improving both association inference and interpretability for circRNA function prediction, and opens new avenues for exploring circRNA as therapeutic targets and vaccine carriers in complex diseases.}
}
@article{MEENA2026115840,
title = {T-CAP: T-cGAN enhanced privacy-preserving context-aware self-attentive and adversarially robust IDS for smart healthcare ecosystems},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115840},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115840},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005666},
author = {Vaishali Meena and Gaurav Indra and Kamal Kumar},
keywords = {Intrusion detection system, Smart healthcare security, Adversarial machine learning, Non-Independent and identically distributed},
abstract = {The risk of sophisticated cyber intrusions that take advantage of contextual and behavioral blind spots in healthcare networks has increased due to the rapid interconnection of medical devices. State-of-the-art intrusion detection systems fail to identify coordinated attack behaviors or maintain dependability in the midst of noisy and diverse medical traffic because they rely on static thresholds or single-view feature analysis. This gap necessitates an IDS that can learn cross-flow contextual semantics and device-level behavioral evolution while maintaining high privacy requirements. This gap is addressed by the proposed novel framework, T-CAP, which employs global contextual semantics with local temporal behavior in a dual-stream IDS encoder to enable semantic-level anomaly detection beyond surface deviations. On resource-constrained IoMT gateways, real-time contextual reasoning is attained by a lossless semantic compression mechanism that further reduces attention complexity. Since hospitals and clinics cannot share raw network data, T-CAP trains through federated updates that are deliberately noise-bounded, which helps the model remain stable even when clients hold uneven or highly heterogeneous traffic distributions. On all four benchmark datasets-CICIoMT-2024, NSL-KDD, CIC-IDS2017, and UNSW-NB15-the average accuracy of the T-CAP framework is 97.85%, the F1-score is 0.94, and the false-positive rate is 1.78%. The best results were observed on CICIoMT-2024 with an accuracy of 98.7%, an F1-score of 0.96, and a false-positive rate of 1.2%. Based on these results, coupled with low inference latency, T-CAP is well-suited for practical deployment at the edge of Smart Healthcare Ecosystems.}
}
@article{A2026115837,
title = {Efficient intrusion detection in internet of vehicles through optimized node-level capsule graph neural networks for advanced security},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115837},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115837},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005630},
author = {Mohan A and Smitha P S and Vijayalakshmi S},
keywords = {Honey badger algorithm, Harbor seal whiskers optimization algorithm, Internet of vehicles, Node-level capsule graph neural network, Unsharp mask guided filtering},
abstract = {Vehicle network data is being generated in massive quantities due to the Internet of Vehicles' (IoV) rapid expansion. Network communication security is challenged by the volume of data. The significant amount of data generated within the vehicle network presents computational challenges, even though intrusion detection technologies can help protect the system from unwanted attacks. In this Manuscript, Efficient Intrusion Detection in Internet of Vehicles through Optimized Node-Level Capsule Graph Neural Networks for Advanced Security (EID-IoV-NCGNN) is proposed. Firstly, the data is collected from the CIC-IDS-2017 dataset. Then, the gathered data are fed to pre-processing. Performance criteria like recall, accuracy, FPR, precision, F1-Score, and detection time were employed to assess the proposed technique's performance. The proposed EID-IoV-NCGNN method contains 25.8%, 27.5% and 29.1% higher accuracy; 25.4%, 24.2%, and 26.3% lesser detection time and 21.8%, 27.6% and 29.45% lower FPR compared with existing methods, such as the Intrusion Detection System for Cyberattacks in the Internet of Vehicles Environment (IDCA-IoV-ENN), the Adaptive Personalized Federated Learning for Intrusion Detection in Maritime Meteorological Sensor Networks (FLID-MMSN-LGCNN) and the Intrusion Detection Model for Internet of Vehicles utilizing GRIPCA and OWELM (IDM-IoV-DPSO), respectively.}
}
@article{FIGUEROA2026115950,
title = {Generating self-descriptions from profile avatars on Question-Answering communities},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115950},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115950},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006763},
author = {Alejandro Figueroa and Billy Peralta},
keywords = {Question Answering, User analysis, Demographics, Psychographic, Text analysis, Image processing, Multimodality},
abstract = {Question Answering communities (cQAs) allow internauts to ask and follow questions about any subject, get helpful answers, and read high quality knowledge. It is vital for their success to swiftly respond to several challenges, e.g., reducing the delay in receiving the first acceptable answers. And in order to optimize user experience, contextualized displays must be tailored to each community member, facilitating the communication between unresolved questions and potential answerers. Recent studies signal demographic variables (e.g., age and gender) as pivotal in successfully satisfying these needs. Our work adds to this body of knowledge in three novel ways: a) instead of classifying texts/images according to a specific demographic factor, we automatically generate “about mes” from avatars; b) since these are rich in demographic and psychographic information, this opens the door for a better profiling/screening of community members; and c) our focus is searching for patterns in one modality (images) in order to produce bios in another modality (texts). For this purpose, we use frontier encoder–decoder neural networks and lexicalized dependency paths to adjust the granularity level of the desired bios. Results signal that pre-trained text-based neural networks are more robust when producing thorough self-descriptions. In general, we discovered that a) it is difficult to extract word meanings from profile bios; and b) trimming lexicalized dependency trees at depth two offered a fair trade-off between exhaustiveness and performance. All in all, our approach shows that it is possible to recover identity signals reflecting demographic variables (e.g., gender) and psychographic traits (e.g., declared religion, activities or personality) by exploiting the alignment of latent visual patterns within profile avatars.}
}
@article{ZHANG2026115922,
title = {FedCCM: Clustered Federated Learning with membership optimization under dual heterogeneity},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115922},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115922},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006489},
author = {Yuqing Zhang and Changli Zhou and Binghuang Huang and Hui Tian},
keywords = {Clustered Federated Learning, Soft clustering, Dual-heterogeneity, Feature},
abstract = {Most existing federated learning (FL) schemes focus on inter-client heterogeneity while neglecting intra-client heterogeneity, significantly constraining model performance. Although soft-clustered FL partially mitigates the impact of this dual-heterogeneity, its client sample-level distribution inference suffers from coarse representation granularity. Moreover, finer soft-clustered approaches restrict inter-cluster knowledge sharing while ignoring the potentially beneficial knowledge outside of the cluster, causing knowledge isolation. To overcome these limitations, we propose FedCCM. This work quantifies client-cluster relationships at the feature-level instead of the sample-level, refining granular representation while significantly enhancing clustering quality and efficiency under dual-heterogeneity. Concurrently, we design a cross-cluster co-distillation mechanism to break knowledge isolation barriers, integrating global knowledge to boost model efficacy. To enhance the model’s capability in capturing fine-grained features, we further introduce a contrastive learning mechanism to guide the local training process. Theoretically, we prove convergence for both cluster and personalized models in FedCCM, and demonstrate its superior accuracy and clustering effectiveness across diverse heterogeneous scenarios.}
}
@article{WU2026115942,
title = {Dual-branch Bayesian adversarial learning for multi-view clustering},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115942},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115942},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006684},
author = {Chengwei Wu and Yue Gao and Guohua Huang and Xiaoke Ma},
keywords = {Multi-view clustering, Bayesian adversarial learning, Probability CCA, Latent representation learning, Multi-view fusion},
abstract = {Multi-view clustering aims to improve clustering performance by jointly considering all available views and utilizing the complementary and consistent information of multiple heterogeneous views. However, multi-view data often have problems such as noise, missing points, and poor adaptability to dynamic data. Existing methods face challenges such as view heterogeneity and the inability to model nonlinear inter-view relationships. To address these issues, a dual-branch Bayesian adversarial learning for multi-view clustering (DBAMVC) model is proposed for aligning nonlinear and heterogeneous views, making up for the deficiency of traditional canonical correlation analysis (CCA) in modeling nonlinear relationships. This model introduces adversarial learning in the multi-view fusion branch, distinguishing the fusion results of actual data and generated data through a discriminator, and guiding the latent representation module in reverse to optimize the feature representation. By introducing the collaborative mechanism of adversarial learning and Bayesian optimization, a dual-branch collaborative optimization framework is constructed. Adversarial learning provides gradient signals for fusion goals. Bayesian inference constrains the direction of parameter update from a probabilistic perspective, and both collaborate in the optimization to solve the problem of separating representation learning from the fusion goal in traditional multi-view clustering while enhancing adaptability to dynamic data. Experimental results show that the method proposed achieves superior performance compared to the comparison methods in the evaluation indexes used.}
}
@article{AREVALO2026115926,
title = {CAFP: A post-processing framework for group fairness via counterfactual model averaging},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115926},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115926},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006520},
author = {Irina Arévalo and Marcos Oliva},
keywords = {Algorithmic fairness, Fair machine learning, Post-processing methods, Counterfactual fairness, Model-agnostic methods},
abstract = {Ensuring fairness in machine learning predictions is a critical challenge, especially when models are deployed in sensitive domains such as credit scoring, healthcare, and criminal justice. While many fairness interventions rely on data preprocessing or algorithmic constraints during training, these approaches often require full control over the model architecture and access to protected attribute information, which may not be feasible in real-world systems. In this paper, we propose Counterfactual Averaging for Fair Predictions (CAFP), a model-agnostic post-processing method that mitigates unfair influence from protected attributes without retraining or modifying the original classifier. CAFP operates by generating counterfactual versions of each input in which the sensitive attribute is flipped, and then averaging the model’s predictions across factual and counterfactual instances. We provide a theoretical analysis of CAFP, showing that it eliminates direct dependence on the protected attribute, reduces mutual information between predictions and sensitive attributes, and provably bounds the distortion introduced relative to the original model. Under mild assumptions, we further show that CAFP achieves perfect demographic parity and reduces the equalized odds gap by at least half the average counterfactual bias. Empirically, we evaluate CAFP across three benchmark datasets (Adult, COMPAS, and German Credit) and three classification models (logistic regression, random forest, and XGBoost), for a total of nine experimental settings. Our results show that CAFP reduces the Demographic Parity Difference by up to 38%, the Average Odds Difference by up to 45%, and maintains predictive accuracy within 0.5 percentage points of the original models. Threshold sensitivity analyses and 95% confidence intervals confirm that CAFP offers a favorable trade-off between fairness and utility across diverse conditions. These findings suggest that CAFP is a practical and principled tool for enforcing post hoc fairness in black-box classifiers, with strong theoretical and empirical guarantees.}
}
@article{ALARCONSERRANO2026115882,
title = {Assessing open LLMs’ ability to identify biomedical taxonomic relationships: A SNOMED CT-based experimental evaluation},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115882},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115882},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006088},
author = {Juan Alarcon-Serrano and Enrique Cano-Marin and Miguel-Angel Sicilia},
keywords = {LLM, Knowledge graph, Taxonomy, Biomedical text},
abstract = {Ontologies serve as semantic blueprints for knowledge management by capturing information in a coherent machine-processable format. They define concepts and relationships, commonly represented through knowledge graphs (KG) in which taxonomic, or “is-a”, relationships arrange concepts into hierarchical structures. Biomedical applications particularly benefit from these structured representations because of the domain’s inherent complexity and continual evolution. Structured representations of relationships support automated reasoning and inference, which are crucial for clinical decision-making, research hypothesis generation, and data integration tasks. Although a substantial portion of biomedical knowledge remains in natural language, Large Language Models (LLMs) offer new potential to automatically extract and interpret this information. Despite promising results in various natural language processing tasks, few studies have examined how effectively LLMs recognise taxonomic relationships. This study evaluates the ability of general-purpose LLMs to reason about biomedical taxonomies by identifying hierarchical “is-a” relationships between concepts. To operationalise this evaluation, we use the SNOMED CT Knowledge graph, one of the most comprehensive clinical terminologies, as a gold-standard reference for determining whether candidate concept pairs are taxonomically linked. Overall, LLMs often succeed in recognising domain-specific taxonomic links based solely on their generic pre-training, yet they exhibit weaknesses in directional reasoning, particularly in challenging negative cases where true parent-child relations are intentionally reversed. Our findings reveal that employing chain-of-thought prompting techniques significantly improves their performance in interpreting these relationships. Taken together, the results highlight both the benefits of Chain-of-Thought prompting for hierarchical judgments and the practical feasibility of integrating LLMs into algorithmic knowledge-graph workflows that require structured, machine-interpretable outputs.}
}
@article{ZHENG2026115918,
title = {Diffusion model-inspired evolution method for enhancing metaheuristic optimization algorithms},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115918},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115918},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006441},
author = {Long Zheng and Shunhuai Chen},
keywords = {Metaheuristic optimization, Evolutionary computation, Swarm intelligence algorithm, Global optimization},
abstract = {Metaheuristic algorithms have been extensively studied for solving complex stochastic optimization problems; however, their performance is often limited by premature convergence and inefficient exploration–exploitation balance. To address these challenges, this paper proposes a Diffusion Model-Inspired Evolution Method (DMiEM), a general framework that enhances existing metaheuristic algorithms by conceptualizing the evolutionary process as a progressive denoising procedure. Inspired by diffusion models, DMiEM guides offspring generation through population noise estimation, enabling a more structured and adaptive search behavior without relying on neural network training. The proposed framework is integrated with representative evolutionary algorithms, swarm intelligence algorithms, and constrained metaheuristics, and systematically evaluated on benchmark problems from CEC2006, CEC2017, and CEC2022. Extensive experimental results demonstrate that DMiEM consistently improves optimization performance in terms of solution quality, convergence speed, population diversity maintenance, exploration–exploitation trade-off, and constraint violation reduction, while maintaining competitive computational efficiency. These results indicate that DMiEM serves as an effective and extensible enhancement framework for a broad class of metaheuristic optimization algorithms.}
}
@article{TANG2026115902,
title = {LAMRF: Logic-adaptive multi-source reasoning fusion for multi-hop knowledge graph question answering},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115902},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115902},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006283},
author = {Yuke Tang and Yongjun Jing and Xu Chen and Shuyang Wang},
keywords = {Knowledge graph question answering, Multi-hop reasoning, Question decomposition, Multi-source fusion},
abstract = {Existing Knowledge Graph Question Answering (KGQA) systems predominantly rely on singular reasoning mechanisms, often struggling to maintain logical consistency and semantic completeness in complex multi-hop scenarios. To address these limitations, we propose LAMRF, a Logic-Adaptive Multi-source Reasoning Framework. To enhance semantic completeness, we employs a logic adaptation layer that dynamically decomposes complex queries into complementary sub-questions, alongside a multi-source collaboration mechanism that normalizes heterogeneous data to construct robust evidence. Furthermore, to mitigate inconsistency, the framework utilizes LLM-driven inductive reasoning over multi-source graphs to synthesize this evidence into unified, interpretable answers. Experimental results on mainstream benchmarks, including CWQ and WebQSP, demonstrate that LAMRF outperforms existing methods, validating its superiority in complex semantic reasoning.}
}
@article{ABDELSALAM2026115865,
title = {A novel dynamic horned lizard algorithm with advanced strategies for high-dimensional optimization and pathology lung cancer image segmentation},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115865},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115865},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005915},
author = {Mahmoud Abdel-Salam and Zahraa Tarek and Rui Zhong and Gang Hu and Nebojsa Bacanin},
keywords = {Horned lizard algorithm, High dimensional, Lung cancer, Fitness guided interaction},
abstract = {Optimization methods play a crucial role in addressing complex scientific and technical challenges. While traditional mathematical optimization techniques have proven effective, their scalability is severely constrained by computational complexity, particularly in high-dimensional search spaces. Metaheuristic algorithms (MAs) have emerged as powerful tools to overcome these limitations, offering robust exploration and exploitation capabilities. However, the Horned Lizard Optimization Algorithm (HLOA), inspired by the survival strategies of the Texas horned lizard, faces significant challenges such as premature convergence, slow improvement rates, and poor performance in multidimensional optimization tasks. These limitations are particularly detrimental in critical applications like medical image analysis, where accurate segmentation is vital for diagnosis and treatment planning. This study introduces HLOA-DLT, an enhanced version of HLOA, designed to address these shortcomings. The proposed algorithm incorporates three innovative strategies: the Dynamic Elite Mutation Strategy (DEMS) for adaptive exploration-exploitation balance, the Dynamic Fitness-Guided Interaction Strategy (DFGIS) for fitness-dependent exploration, and a refined Lateral Crossover Strategy inspired by the Crisscross algorithm to improve solution diversity and convergence speed. Together, these enhancements significantly elevate HLOA's capability to handle complex, high-dimensional optimization problems. To validate its effectiveness, HLOA-DLT was evaluated on the CEC’17 and CEC’22 benchmark functions, where it demonstrated superior performance compared to recent, classical, and advanced MAs. Furthermore, HLOA-DLT was successfully applied to lung cancer pathological image segmentation, leveraging multilevel thresholding, non-local means denoising, and two-dimensional (2D) histograms for feature extraction. Experimental results confirmed HLOA-DLT's ability to achieve precise and robust segmentation, surpassing state-of-the-art algorithms in metrics such as segmentation accuracy, robustness, and computational efficiency. The findings underscore HLOA-DLT's potential as a powerful and efficient optimization algorithm, offering significant advancements in both global optimization and medical image analysis. This work provides a robust framework for addressing intricate real-world challenges, particularly in medical domains requiring high precision.}
}
@article{LIANG2026115857,
title = {Plug-and-Play global and local collaborative fusion for weakly supervised object detection},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115857},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115857},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005836},
author = {Qiuyu Liang and Yongqiang Zhang},
keywords = {Weakly supervised object detection, Multi-instance learning, Low-rank approximation, Global and local fusion},
abstract = {Weakly supervised object detection (WSOD) has drawn much attention due to its closeness to practical applications, and researchers have proposed the multi-instance learning (MIL) approach to handle it as a multi-class classification problem. Although these methods have yielded promising results, extraneous information in the images severely affects the model’s feature learning due to the lack of instance-level annotation. To alleviate this limitation, in this paper, a global and local collaborative fusion method is proposed for WSOD by leveraging the complementary information of the original image and its low-rank approximation. Specifically, we design a pixel-level global information awareness (GIA) module to reconstruct the input image and remove redundant noise, which are then fed into a visual encoder to extract the features from a global perspective. Moreover, to compensate for the lack of detail preservation in GIA, we further propose a local detail fusion (LDF) module that fuses image details by leveraging both reconstructed and input images. Our proposed GIA-LDF modules are architecture-agnostic and can be seamlessly embedded into any MIL-based WSOD pipeline. Extensive experiments validate the effectiveness of our plug-and-play GIA-LDF for WSOD. We achieve 60.2%, 57.4%, and 23.2% mAP on PASCAL VOC 2007, VOC 2012, and COCO, respectively, surpassing baseline methods by +2.0%, +1.2%, and +0.3%, and establishing new state-of-the-art performance across all benchmarks.}
}
@article{DU2026115849,
title = {Trackfficer: A few-shot website fingerprinting attack framework with robust traffic representation and quintuplet contrastive learning},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115849},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115849},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005757},
author = {Wenbiao Du and Jingfeng Xue and Xiaojun Xu and Xiuqi Yang and Zeyang Liu and Junbao Chen},
keywords = {Security and privacy, Traffic analysis, Website fingerprinting, Contrastive learning, Few-shot learning},
abstract = {Website fingerprinting (WF) attacks aim to infer user-visited websites by analyzing traffic patterns in encrypted Tor traffic. Traditional deep-learning-based WF attacks typically require large, comprehensive datasets, which is often impractical for resource-constrained adversaries in real-world environments. To address this limitation, herein, we propose a novel few-shot WF attack framework, Trackfficer. This framework transforms prelabeled Tor traffic packet sequences into multichannel spatiotemporal feature tensors that capture both global contextual patterns and fine-grained traffic characteristics. Leveraging these representations, the framework adopts a multilayer convolutional neural network architecture with dual-attention mechanisms within a quintuplet network for contrastive pretraining, enabling the extraction of highly discriminative traffic-feature embeddings. It further incorporates a dual-loop c learning strategy that enables rapid adaptation to previously unseen websites using only limited support samples. Extensive experiments conducted under various network conditions in both closed-world and open-world settings demonstrate that Trackfficer achieves effective fingerprinting of Tor traffic with minimal labeled data. The framework also demonstrates strong resilience against various WF defense techniques and consistently outperforms existing WF attacks, even in the presence of temporal drift. These findings validate the practicality and effectiveness of Trackfficer in real-world WF attack scenarios.}
}
@article{PHAN2026115946,
title = {From object difficulty to image scoring: A strategy for active learning in object detection},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115946},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115946},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006726},
author = {Duc Tai Phan and Nhut Minh Nguyen and Khang Phuc Nguyen and Phuong-Nam Tran and Nhat Truong Pham and Linh Le and Choong Seon Hong and Duc Ngoc Minh Dang},
keywords = {Active learning, Object detection, Computer vision, Difficulty, Instability},
abstract = {Object detection (OD) faces the costly hurdle of large-scale dataset annotation. Active learning (AL) is a promising solution that selects the most beneficial samples for annotation. Applying AL to OD is challenging, as it requires addressing uncertainties in both classifying and localizing objects while combining object-level information into a single image-level decision. Current methods, like uncertainty sampling, often rely on output-level uncertainty or heuristic signal combinations. However, relying on static model outputs limits their ability to capture underlying feature-space instabilities. To address these limitations, we propose Feature Difficulty-based AL (FDAL), a novel framework that shifts the focus from output-level heuristics to active latent-space manipulation. By systematically interpolating unlabeled features toward class anchors, FDAL identifies prediction inconsistencies to reveal hidden traits unknown to the model. This anchor-guided interpolation unifies classification and localization uncertainties, capturing latent instabilities that traditional paradigms miss. Experiments on four OD benchmarks demonstrate that FDAL achieves state-of-the-art (SOTA) results, consistently improving detection accuracy while substantially reducing annotation costs. FDAL outperforms SOTA methods by 0.8% in detection accuracy on Pattern analysis, statistical modelling, and computational learning (PASCAL) Visual Object Classes (PASCAL VOC), 1.99% on Karlsruhe Institute of Technology and Toyota Technological Institute (KITTI), 1.68% on Cityscapes, and 0.27% on Microsoft Common Objects in Context (MS COCO). FDAL is highly efficient in sample selection, taking 0.06 s per image on PASCAL VOC and up to 0.63 s per image on Cityscapes, enabling scalability to large unlabeled pools. FDAL offers a practical, efficient, and effective solution for advancing AL in OD.}
}
@article{YUAN2026115914,
title = {Cognitive-driven hierarchical reasoning for event causality identification},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115914},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115914},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006404},
author = {Jianbo Yuan and Yitai Xu and Wen Zhou and Miao Yu and Xiaomin Sun and Liangji Zhang and Jiayi Luo},
keywords = {Event causality identification, Dual process theory, Knowledge enhanced},
abstract = {Event causality identification (ECI) is a core task in natural language processing (NLP), aiming to identify causal relationships between event pairs in text. However, existing methods suffer from the following notable limitations: (1) lack of a deep knowledge fusion mechanism, leading to ineffective integration of the implicit knowledge embedded in pretrained language models (PLMs) with explicit knowledge from knowledge graphs (KGs); and (2) reliance on a single-step classification paradigm, which is inadequate for simulating the gradual, multi-level reasoning process characteristic of human cognition. To address these shortcomings, this study proposes a cognitive-driven hierarchical reasoning (CDHR) mode, providing fine-grained hierarchical modeling for an ECI task based on the dual process theory (DPT). It comprises four core modules: (1) intuitive judgment layer, which utilizes internalized knowledge from PLMs for rapid perception, (2) multistep association layer, which retrieves and injects event background knowledge from KGs, (3) multipath exploration layer, which mines potential relational paths between events, and (4) competitive selection mechanism, which dynamically integrates the outputs of the preceding three layers to arrive at the final decision. This framework explicitly simulates the progressive cognitive chain of “intuitive judgment → background association → path reasoning” while deeply integrating implicit and explicit knowledge. Experiments on the EventStoryLine and Causal-TimeBank datasets demonstrated that CDHR outperforms the previous baseline models. While introducing a hierarchical reasoning structure, CDHR maintains computational efficiency and achieves a better balance between performance and interpretability by explicitly modeling human cognitive processes, thereby offering a systematic, cognitively driven solution for complex event causality understanding.}
}
@article{FARAJI2026115825,
title = {Robust log-based multi-label feature selection with dynamic label correlation and relevance-redundancy optimization},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115825},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115825},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005514},
author = {Mohammad Faraji and Amjad Seyedi and Fardin {Akhlaghian Tab}},
keywords = {Feature selection, Multi-label learning, Label correlation, Robustness, Sparseness},
abstract = {High-dimensional multi-label datasets commonly suffer from noisy annotations and redundant or irrelevant features, which jointly degrade learning accuracy and generalization. Although existing multi-label feature selection methods often adopt the L2,1-norm to enhance robustness and induce sparsity, this formulation remains sensitive to extreme noise, relies on static label correlation modeling, and inadequately controls redundancy among selected features. To address these limitations, we propose Robust Log-based Multi-Label Feature Selection with Dynamic Label Correlation and Relevance–Redundancy Optimization (RLBMLFS). The proposed method introduces an element-wise logarithmic robust loss that effectively suppresses the influence of large reconstruction errors, providing stronger resilience to noisy labels than conventional sample-wise losses. In addition, RLBMLFS learns label dependencies dynamically from reconstructed labels, yielding a stable and adaptive label correlation structure that mitigates noise propagation. To jointly promote sparsity and reduce feature redundancy, we further incorporate a logarithmic redundancy-aware penalty together with an L2,log pseudo-norm regularization, which offers a closer approximation to L0-norm sparsity while alleviating the dominance of large feature weights. Extensive experiments on 17 real-world multi-label datasets across five evaluation metrics demonstrate that RLBMLFS consistently outperforms state-of-the-art methods in terms of robustness, sparsity quality, and classification performance. The source code is publicly available at: https://github.com/FarajiMohammad/RLBMLFS.}
}
@article{ZENG2026115917,
title = {A Bayesian-Like inference framework based on causal rules for causal emotion entailment},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115917},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115917},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600643X},
author = {Zhaogan Zeng and Zihuai Chen and Yuyao Chen and Xiaoyi Wang and Dazhi Jiang},
keywords = {Conversational sentiment analysis, Causal emotion entailment, Bayesian-like inference framework, Causal rules},
abstract = {Causal Emotion Entailment (CEE) aims to identify the underlying causes behind the emotion expressed in non-neutral utterance within dialogues. Despite advancements in CEE, previous research has failed to adequately exploit the implicit causal rules in dialogues, thereby restricting the inferential performance of the model. Moreover, existing models lack sufficient logical support for their inferences, resulting in limited interpretability. To address this, we model the emotional and positional relationships between utterances to encode the causal rules. To enhance the reasoning ability and interpretability of the model, we conceptualize the CEE task as a Bayesian-like causal inference process, which consists of three steps: evidence extraction, prior evolution, and likelihood adjustment. Firstly, we design a causal perception module to obtain global and local causal evidence. Next, a Causal Inference Module (CIM) composed of Pre-inference (PI) and Secondary Inference (SI) is proposed. As CIM continuously absorbs causal evidence under the constraints of causal rules, the prior causal probability obtained by PI evolves into the Posterior Causal Probability (PCP) after SI. Finally, we propose a likelihood adjustment module to align the PCP with the causal relationship between utterances. The experimental results indicate that our proposed framework achieves State-Of-The-Art (SOTA) performance, yielding excellent Macro F1 scores of 83.30% and 72.14% on the RECCON-DD and RECCON-IE datasets, respectively.}
}
@article{RISHAKAN2026115833,
title = {Resultant vector strategy: A new strategy for improved performance of metaheuristic algorithm},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115833},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115833},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005599},
author = {Keyvan Fattahi Rishakan and Farhad Soleimanian Gharehchopogh},
keywords = {Resultant vector strategy, Mountain gazelle optimizer, Heuristic Algorithms, Optimization},
abstract = {A novel Resultant Vector Strategy (RVS) is proposed in this paper to address the critical limitations of premature convergence and the entrapment in local optima in metaheuristic algorithms. The proposed RVS employs a three-stage hierarchical vector integration mechanism that systematically combines six search vectors (V1-V6) through mathematical vector operations to generate three resultant vectors (R1, R2, and R3), replacing traditional random parameter selection in optimization algorithms. We implement and evaluate RVS on the Mountain Gazelle Optimizer (MGO) algorithm, creating enhanced variants termed R2MGO and R3MGO. The RVS transforms the conventional random parameter generation in MGO's four behavioral mechanisms (TSM, MH, BMH, and MSF) into precise vector-based calculations using physics-inspired resultant vector principles, replacing simple random coefficients with mathematically computed directional guidance. Comprehensive testing on 23 CEC 2017 benchmark functions demonstrates superior performance compared to the original MGO and nine state-of-the-art algorithms. Based on a thorough evaluation across multiple criteria, R3MGO achieved 65 best results out of possible performance measures, significantly outperforming all competitors by obtaining 21 best results in the "Best" criterion and engineering optimization results validate the practical applicability, with R3MGO achieving first rank in five out of six engineering design problems. The RVS framework offers a generalizable enhancement technique suitable for various metaheuristic algorithms, enabling the solution of complex engineering optimization problems through intelligent vector-based parameter control rather than random selection.}
}
@article{LI2026115906,
title = {SFC-net: Semantic filtering and collaborative contrast for zero-shot anomaly detection},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115906},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115906},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006325},
author = {Xuefeng Li and Congrui Zhang and Qingfan Zhang and Chensu Zhao and Huifang Hou and Xiaqiong Fan},
keywords = {Anomaly detection;Zero-shot;Semantic;Collaborative contrast},
abstract = {Zero-Shot Anomaly Detection is essential for open-world applications within industrial and medical domains. However, existing approaches based on Vision-Language models are generally constrained by two primary limitations: (1) a heavy reliance on exhaustive prompt engineering, which introduces significant empirical overhead and domain-specific bias; and (2) a susceptibility to noise interference from extensive background regions during feature contrast, which leads to computational inefficiency and high false-positive rates. To systematically address these challenges, we propose a novel framework termed the Semantic Filtering and Collaborative Contrast Network. The core principle of SFC-Net is to leverage textual semantics to “purify” the visual space. First, we replace complex prompt engineering with minimalist text prototypes to establish a robust semantic direction. Second, and most critically, we introduce a novel Semantic Filtering mechanism. Prior to batch-collaborative contrast, this mechanism utilizes text prototypes as probes to actively eliminate irrelevant background blocks. Finally, a semantic confidence gate is employed to intelligently fuse the visual contrast and semantic discrimination branches. Extensive experiments on multiple recognized benchmark datasets demonstrate that SFC-Net achieves state-of-the-art performance in both image-level classification and pixel-level localization under the zero-shot setting. The code involved in this study is publicly available on website https://github.com/SWLee777/SFC-NET.}
}
@article{DONG2026115869,
title = {CG-CGSL: Clustering and graph topological properties co-guided graph structure learning},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115869},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115869},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005952},
author = {Zhi Dong and Xinglin Liu and Hongyu Sun and Ying Wang},
keywords = {Clustering guidance, Topological constraint, Graph structure learning, Contrastive learning, Graph neural network},
abstract = {Unsupervised graph structure learning aims to jointly learn node representations and graph topology without label supervision. However, noisy and missing edges in real-world graphs severely degrade model performance, and existing methods typically lack effective constraints on global topological properties during structure optimization. To address these issues, we propose CG-CGSL, a clustering and graph topological properties co-guided graph structure learning model. CG-CGSL introduces three key mechanisms: clustering-guided contrastive learning, which employs a dual-branch encoder with K-Means clustering in the attribute space to generate topology-independent pseudo-labels and enhances semantic discriminability through cross-entropy loss and cluster-level contrastive learning; clustering-guided local structure optimization, which leverages dynamic cluster assignments and feature similarity to supplement missing intra-cluster edges while removing noisy inter-cluster connections; and global structure refinement guided by graph topological properties, coupled with an alternating optimization scheme for bidirectional feedback between representation learning and structure optimization. Experimental results demonstrate that CG-CGSL achieves state-of-the-art performance on Cora and CiteSeer, and maintains competitive results on PubMed, validating its effectiveness in both node classification and clustering tasks.}
}
@article{HANNANE2026115930,
title = {SAOPQ: Spatial-attention cross-information fusion with feature-guided orthogonal product quantization learning for scalable face image retrieval},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115930},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115930},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006568},
author = {Rachida Hannane and Abdessamad Elboushaki and Karim Afdel},
keywords = {Face image retrieval, Deep face representation, Product quantization network, Spatial attention learning, Orthogonal codeword generation},
abstract = {Deep product quantization has demonstrated promising performance in large-scale face image retrieval due to its expressive power in encoding complex visual features. Nevertheless, there is still a great potential for performance improvement, especially for retrieving faces in difficult poses, partial occlusions, and expression exaggeration. Previous product quantization approaches mostly represent subspaces by predefining data-independent codebooks. However, problems like sub-optimality to a specific dataset may occur, hence making the quantization learning hard to converge. Besides that, they utilize standard CNNs to extract facial features. Unfortunately, the restriction of convolutional kernels makes CNNs alone inadequate to capture rich semantic facial information. Addressing these issues, we introduce in this paper a novel approach that incorporates spatial-attention cross-information fusion with feature-guided orthogonal product quantization learning for efficient face image retrieval. Specifically, we propose a spatial-attention learning network that combines ResNet architecture to preserve spatial information clues and ViT structure to capture more fine-grained attention features from face image. We also design a fusion model with cross-attention mechanism to simultaneously exploit the learned features. Moreover, we introduce a method that generates orthogonal codewords used to compute soft and hard quantizations while considering sub-features’ distribution in each subspace. To maximize the discriminability power of our model, we further design an objective function that jointly learns effective feature and quantization representations, while preserving identity information in both subspaces and the global space. Extensive experiments on challenging benchmark datasets of real faces, synthetic faces, and also general images have shown impressive results while excelling current state-of-the-art methods.}
}
@article{TAFTI2026115927,
title = {A novel K-GWO-SVM algorithm for the analysis of ECG signals},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115927},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115927},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006532},
author = {Ghazal Tafti and Zihuai Lin and Branka Vucetic and Ming Ding and Zhiyun Lin},
keywords = {Smart healthcare, ECG, SVM, GWO, K-means, Mini-batch},
abstract = {This paper presents a robust yet efficient Grey Wolf Optimizer-Support Vector Machine algorithm, termed K-GWO-SVM, for the analysis of ECG signals in smart healthcare systems, aiming to improve classification accuracy and computational efficiency. The proposed model introduces three main contributions: (1) the use of GWO to automatically search for the optimal hyperparameters of SVM tailored to each dataset, (2) a mini-batch strategy guided by K-means clustering to improve the efficiency and convergence of GWO by selecting representative subsets of data, and (3) an enhanced regulation function integrated into GWO that prevents premature convergence by improving the balance between exploration and exploitation. A convergence study is conducted to demonstrate the influence of mini-batch size on both classification accuracy and computational efficiency, showing that using mini-batches as small as 10% of the training data significantly improves computational efficiency without compromising classification accuracy. The K-GWO-SVM framework is evaluated on two benchmark datasets: WESAD for emotion recognition and MIT-BIH Arrhythmia for cardiac classification. The proposed model achieves 99.02% accuracy on WESAD with over a 90% reduction in computational time (10% mini-batch), and 100% accuracy on MIT-BIH with over a 50% reduction in computational time (50% mini-batch), validating its effectiveness, robustness, and suitability for deployment in resource-constrained smart healthcare environments.}
}
@article{LI2026115899,
title = {PG2CTDL: Pixel and gradient decorrelation guided coupled tensor dictionary learning for multimodal image fusion},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115899},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115899},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006258},
author = {Zihan Li and Zhen Long and Lanlan Feng and Ce Zhu},
keywords = {Coupled tensor dictionary learning, Multimodal image fusion, Pixel-domain decorrelation, Gradient-domain decorrelation},
abstract = {Multimodal image fusion combines complementary sensor data and is vital for medical diagnosis and surveillance. Dictionary-learning-based fusion learns bases from local patches, but current methods either disrupt spatial structure through patch vectorization or fail to separate shared and modality-specific components, causing shared information to leak into modality-specific representations. To alleviate these limitations, we propose a pixel- and gradient-domain decorrelation guided coupled tensor dictionary learning (PG2CTDL) framework for multimodal image fusion. Specifically, we utilize a coupled Tucker decomposition to preserve intrinsic spatial structures, while enforcing shared sparse supports to align heterogeneous features across modalities. In addition, we impose joint pixel- and gradient-domain decorrelation on modality-specific components to suppress redundant cross-modal correlations in intensities and edges, yielding cleaner complementary details. An alternating minimization strategy is used to solve the optimization problem. Extensive experiments on medical and infrared–visible image fusion tasks demonstrate that our method is competitive with state-of-the-art approaches in both visual fidelity and quantitative metrics, while achieving an improved balance between maintaining structural fidelity and highlighting distinctive details.}
}
@article{NARAYANAN2026115806,
title = {A novel wide slice kronecker forward fractional network for osteoporosis detection using knee X-ray image},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115806},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115806},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005320},
author = {Pughazendi Narayanan and Y {Jeevan Nagendra Kumar} and Rohith Bhat Chandrasekhar and Praghash Kumaresan},
keywords = {Knee X-ray images, Non-local means filter, Ostu thresholding, Wide slice kronecker forward fractional network, Deep learning},
abstract = {Osteoporosis is an asymptomatic and progressive skeletal disorder that maximizes the risk of fractures in people aged 50 to 60. Early and accurate detection is critical, yet challenging, due to the fine structural changes in bone that are often difficult to identify in routine medical images. Knee X-rays are commonly used diagnostic tools, but interpreting them for osteoporosis detection remains complex because of variations in bone geometry and trabecular patterns. To solve these challenges, the novel Wide Slice Kronecker Forward Fractional Network (WKFF-Net) is developed to detect osteoporosis efficiently. Initially, the input image is taken from the database for detection. Here, the denoising process is done using the Non-Local Means (NLM) filter, and the Otsu thresholding method is considered for the segmentation process. Further, a template search method is used for analyzing the femur geometry. Next, features, like spatial, adaptive Local Binary Patterns (aLBP), Convolutional Neural Networks (CNN), and medical-level features, are extracted, and osteoporosis detection is accomplished by the hybrid WKFF-Net model that integrates Deep Kronecker Network (DKN), Wide Slice Residual Network (WISeR), and fractional calculus. The experimental results obtained by the WKFF-Net are 90.868% accuracy, 92.876% True Positive Rate (TPR), 87.766% True Negative Rate (TNR), 89.888% precision, and 91.357% F1-score, for 90% of the training samples.}
}
@article{CAI2026115919,
title = {One perturbation fools all: An adversarial perturbation can attack different vision models},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115919},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115919},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006453},
author = {Jinyan Cai and Tianhao Yu and Hongliang Liang and Qiuping Yi},
keywords = {Cross-task adversarial attack, Cross-model attack, Black-box adversarial attack, Transferability and robustness},
abstract = {In recent years, adversarial attacks have demonstrated robust deceptive capabilities across various visual tasks. Autonomous driving systems typically integrate multiple visual perception modules to collaboratively achieve environmental perception. However, existing methods are optimized for single-task models, leading to attack failures when confronted with real-world systems employing multiple visual models. This limitation restricts their applicability and threat assessment capabilities in practical multi-task systems. To mitigate this, we present OPFA, the first adversarial perturbation generation method trained using segmentation models as source models, with transferability across multiple visual tasks. By incorporating our proposed multi-head discriminator, a single perturbation can simultaneously attack models for image classification, object detection, semantic segmentation, and instance segmentation. Notably, OPFA achieves targeted attacks on segmentation models for the first time and maintains efficacy when transferred to transformer-based models. Experimental results show that OPFA outperforms existing attacks by significantly degrading the performance of multiple visual tasks with only moderate perturbations.}
}
@article{ZHAO2026115830,
title = {HAQ-ViT: A hardware-aware post-training quantization for efficient vision transformer inference},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115830},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115830},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005563},
author = {Shiqi Zhao and Zhengjie Wang and Haozu Sun and Sibo Wang and Zihan Chen and Changzeng Fu and Jie Yang and Mohamad Sawan},
keywords = {Vision transformer, Self-attention mechanism, Booth algorithm, Quantization, Sparsity exploitation, Early exit},
abstract = {In recent years, Vision Transformers (ViTs) have demonstrated outstanding performance in the field of computer vision. However, the quadratic complexity of their self-attention mechanism results in a significant increase in model storage requirements and computational overhead, which has become a critical bottleneck hindering their widespread adoption. Consequently, compressing ViTs has emerged as a major area of research focus, with ViTs quantization being a prominent direction within this domain. This paper systematically analyzes and identifies three key optimization opportunities in existing INT8 quantized ViTs models: 1) The numerical distribution of the query-key vectors in the attention matrix exhibits a 40.66% occurrence of consecutive identical values spanning 3 bits; 2) The activation sparsity across different network layers displays significant heterogeneity; and 3) Shallow features can already provide reliable classification confidence. Based on these findings, we propose HAQ-ViT, a hardware aware post-training quantization acceleration framework. First, we introduce a hybrid quantization scheme grounded in the improved Booth algorithm. By designing a hardware-friendly bit sequence skipping strategy, we enable the omission of multiplication operations involving consecutive identical bit patterns, building upon standard 8-bit quantization. Secondly, we propose a dynamic layer sparsification strategy. By analyzing the inter-layer differences in activation distribution, we construct an adaptive threshold selection function, thereby reducing the sparsification decision complexity from O(n2) to O(kn2), where k ∈ (0, 1) is a predefined scaling factor. Finally, we introduce a global quantization adaptive early exit mechanism, where multiple lightweight classification heads are strategically inserted to monitor confidence entropy in real-time. When the entropy exceeds a defined threshold, the computations are terminated early. Experimental results demonstrate that the HAQ-ViT framework, evaluated on the ImageNet dataset, maintains inference accuracy at a sparsity rate of 76% (with a 0.068% improvement over the baseline model). With the integration of early exit heads, the accuracy experiences a marginal decrease of only 0.004%, and at a sparsity rate of 94%, the energy consumption for a single inference is significantly reduced from 64.6 mJ to 10.91 mJ.}
}
@article{CHEN2026115891,
title = {Eco-inspired clustering: Self-tuning Lotka-Volterra models for robust center evolution},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115891},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115891},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006179},
author = {Zhijiang Chen and Fei Wang and Dongming Tang},
keywords = {Clustering, Self-tuning, High-dimensional clustering, Ecological community simulation},
abstract = {Existing model-driven clustering approaches suffer from key limitations: they typically assume each feature generates the same number of clusters, are sensitive to noise, and require manual tuning of multiple hyperparameters. Joint modeling in moderate to high dimensions also incurs high computational costs. To address these issues, we propose RC-LV (Resource Competition-Lotka-Volterra), a novel, self-tuning, and computationally efficient clustering framework inspired by ecological community competition. RC-LV proceeds in two stages. First, it automatically selects a Gaussian mixture model for each dimension via the Bayesian Information Criterion (BIC), generating initial species settlement points. Then, it constructs a distance-weighted competition matrix and simulates resource competition and self-limitation with adaptive time steps and energy thresholds. Weak prototypes are eliminated dynamically without hyperparameter intervention. This framework has several advantages: (a) clusters emerge and vanish through competition, avoiding manual parameter setting; (b) independent competition allows for scalable processing of high-dimensional interactions; (c) the distance-weighted mechanism improves intra-cluster cohesion and suppresses noise, producing clearer and more stable boundaries. We validate RC-LV on synthetic and real-world datasets, where it consistently outperforms state-of-the-art methods.}
}
@article{KOZIK2026115943,
title = {GRA-FIN: New method of large graphs reduction for financial transactions and financial crime analysis},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115943},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115943},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006696},
author = {Rafał Kozik and Piotr Gocał and Michał Choraś},
keywords = {Graphs, Graphs reduction, Financial transactions, Financial crime, Big data analysis},
abstract = {Context:
In this paper, the problem of large-volume financial data (represented as graphs) analysis was tackled in order to effectively detect and counter serious financial crime.
Objective:
The goal of this work was not only to design and develop an original scientific method to reduce large graphs, but also to apply it in much needed practical application of large financial crime data analysis. This approach allows for reducing graphs while preserving critical information and allows for reducing the cognitive load of end users.
Methods:
This work proposes an original method of large graphs simplification, combining innovative noise elimination and edge trimming techniques. The proposed edge trimming algorithm uses an assessment of their significance through a scoring mechanism.
Results:
For evaluation, realistic and diverse datasets were prepared in collaboration with human analysts who are professionals in financial crime analysis. The experiments include various metrics and evaluation methods, ensuring a reliable evaluation. The results of the algorithm were compared with those of other methods in the literature. The method is being deployed in a real system to help analysts and law enforcement agencies to counter complex financial crimes.}
}
@article{ZHANG2026115911,
title = {A multi-scale spatio-temporal transformer with region-aware graph learning for epidemic forecasting},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115911},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115911},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006374},
author = {Jun Zhang and Chao Liu},
keywords = {Epidemic forecasting, Multi-scale temporal convolutions, Spatio-temporal transformer, Region-aware graph learning, Graph neural networks},
abstract = {Epidemic forecasting is essential for providing proactive early warnings and optimizing the allocation of public health resources. However, accurate modeling of real-world epidemic dynamics remains challenging due to pronounced spatio-temporal heterogeneity, which often manifests as multi-peak patterns and resurgent outbreaks. To address these challenges, we propose STTGNN, a novel Spatio-Temporal Transformer Graph Neural Network that integrates multi-scale temporal convolutions, a two-stage spatio-temporal Transformer, and a region-aware graph learner enhanced with degree-aware gating. A lightweight Graph Convolutional Network is employed to propagate signals over dynamically inferred graphs, and linear decoding heads generate region-level forecasts. Extensive experiments conducted on the Japan-Prefectures and US-Regions datasets demonstrate that STTGNN consistently outperforms statistical models, sequential deep learning methods, and state-of-the-art spatio-temporal GNN baselines across evaluation metrics, including RMSE, PCC, and Peak Error. The proposed approach significantly improves the fidelity of peak predictions while maintaining stable performance during low-incidence phases, thereby offering a more reliable tool for epidemic preparedness and long-term public health planning.}
}
@article{BAO2026115895,
title = {DPBGFL: Debiased prototype bidirectional guided federated learning for human activity recognition},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115895},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115895},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006210},
author = {Yifei Bao and Jinghui Zhang and Yi Cheng and Dengyin Zhang},
keywords = {Human activity recognition, Federated learning, Domain generalization, Representation learning, Prototype learning, Sensor},
abstract = {Human activity recognition (HAR) glows with potential in future ubiquitous computing, but stringent privacy regulations prohibit large-scale data collection from personal devices, hindering the upgrading of HAR models. As a promising privacy-preserving distributed computing paradigm, federated learning (FL) has attracted great attention. However, in reality, owing to the inherent individual variability in age, body shapes, behavioral styles, etc., the model federatedly trained on distinct source domains has poor generalization performance on unseen target domains. Facing challenges of 1) domain-invariant representation learning under data silo and 2) model aggregation under domain shift, this paper proposes a debiased prototype bidirectional guided federated learning (DPBGFL) domain generalization framework for HAR. Specifically, we employ the unsupervised clustering to construct global debiased prototypes (DBPs) and utilize them to guide federated domain generalization from two aspects. Firstly, DBPs guide clients to learn domain-invariant representations. We design a style decoupling autoencoder for each client to separate domain bias from latent space when transferring knowledge from DBPs to clients. Secondly, DBPs guide the server to aggregate models. We propose a prototype-aware aggregation (PAA) strategy to adaptively assign the aggregation weights to make the global model close to client models with better generalization. Extensive experiments are conducted on datasets of UCI-HAR, PAMAP2, USC-HAD, and HARBOX. The experimental results demonstrate the superior domain generalization performance of DPBGFL (average performance gains of 9.1%  ∼  16.5% in accuracy) compared to traditional and state-of-the-art baselines.}
}
@article{XU2026115903,
title = {Semantic consistency learning across temporal scales for weakly supervised video anomaly detection},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115903},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115903},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006295},
author = {Guanghui Xu and Sifan Long and Hongwei Ge and Enxuan Gu and Zidi Li and Zhaoqin Wang},
keywords = {Anomaly detection, Video anomaly detection, Vision transformer, Surveillance videos, Deep learning, Weakly supervised learning},
abstract = {Weakly supervised video anomaly detection (WSVAD) aims to localize anomalous segments using only video-level labels. However, WSVAD makes it challenging to capture abnormal behavior occurring at different temporal ranges and effectively use semantic information. Existing methods based on contrastive language-image pretraining often rely on single-scale temporal modeling and static, video-agnostic text embeddings that are not conditioned on specific video content, limiting their ability to align visual behaviors with textual semantics. We address these limitations by proposing semantic consistency learning across temporal scales (SCL) for WSVAD. First, we propose a multiscale temporal aggregation and interaction module to jointly model behavior patterns across short, medium, and long temporal scales, forming discriminative behavior representations. Second, we propose a video-conditioned crossmodal interaction module that combines video-conditioned dynamic prompting with a dual-stream crossattention mechanism to enable bidirectional interaction between visual and textual features. Finally, a semantic alignment loss is introduced to encourage consistency between visual representations and textual semantics within a unified crossmodal space, improving the discriminative ability for anomalous events. Experimental results demonstrate that SCL achieves state-of-the-art performance on two benchmark datasets, obtaining 88.47% AUC on UCF-Crime and 85.73% AP on XD-Violence. Moreover, we conducted detailed ablation experiments to analyze and validate the contributions of this study.}
}
@article{WANG2026115934,
title = {A survey on Hilbert–Schmidt independence criterion Lasso},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115934},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115934},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600660X},
author = {Tinghua Wang},
keywords = {Hilbert-Schmidt independence criterion (HSIC), Least absolute shrinkage and selection operator (Lasso), Feature selection, Statistical inference, Kernel learning, Deep learning},
abstract = {The Hilbert-Schmidt Independence Criterion Least absolute shrinkage and selection operator (HSIC Lasso), first introduced by Yamada et al. in 2014, represents an advanced feature selection method that integrates the nonlinear dependency measurement capabilities of HSIC with the sparsity-inducing l1 regularization of Lasso. In recent years, HSIC Lasso has demonstrated remarkable versatility beyond its original scope of feature selection, emerging as a powerful tool for diverse applications including statistical inference, kernel learning, and deep learning. This survey summarizes both the theoretical basis and progress and practical applications of HSIC Lasso over the past decade, where its basic concepts and theory, optimization, extended models, and task-oriented algorithms with applications are systematically reviewed. Furthermore, some potential problems and directions deserving future exploration are discussed. This survey attempts to draw a full picture of HSIC Lasso, thereby serving as both a technical reference for experienced practitioners and an accessible entry point for newcomers to the field.}
}
@article{PATHAMUTHU2026115866,
title = {Predictive deep learning framework for analyzing customer churn and loyalty behaviour in the banking sector},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115866},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115866},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005927},
author = {P. Pathamuthu},
keywords = {Customer churn, Financial features, Oversampling technique, Heterogeneous features, Class imbalance},
abstract = {A predictive framework is developed to analyze customer churn and loyalty behaviour in the banking sector using a dataset of 10,000 customers. The dataset includes demographic and financial attributes such as credit score 350–850, age 18–92 years, tenure 0–10 years, account balance 0 to over 240,000 units, number of products 1–4, and estimated salary up to 99,999 units. Data preprocessing involved removing non-informative attributes, normalizing numerical features, and applying label encoding to categorical variables such as gender and geography. The dataset exhibited class imbalance, with 19.6% churners and 80.4% loyal customers. This imbalance was handled using a hybrid resampling strategy combining ADASYN oversampling and Tomek Links under-sampling to improve minority class learning.The CatBoost model achieved the best performance, with an accuracy of 94.3%, precision of 96.2%, recall of 89.3%, and an AUC of 95.6%. Churn analysis indicated higher exit rates among male customers (1306) compared to females (654), inactive members (1084), and customers without credit cards (458). Global SHapely Additive exPlanations (SHAP) revealed that IsActiveMember, Balance, and Number of Products are the most influential features, with account balance showing a strong non-linear relationship with churn probability. Feature importance analysis further highlighted balance, number of products, and estimated salary as key predictors, while age had minimal impact.Overall, the proposed framework effectively addresses heterogeneous data, class imbalance, and model interpretability, offering actionable insights for proactive customer retention and improved decision-making in banking institutions.}
}
@article{LONG2026115834,
title = {Region-aware focused masked contrast for self-supervised representation learning},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115834},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115834},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005605},
author = {Xianzhong Long and Jiacheng He and Yun Li and Jian Xiong},
keywords = {Self-Supervised learning, Contrastive learning, Guided masking strategies, Visual representation learning, Vision transformer},
abstract = {Contrastive learning has greatly enhanced the performance of self-supervised visual representation learning, especially in linear probing evaluations, where its accuracy now closely matches that of supervised learning on the ImageNet dataset. However, with the increasing use of the Vision Transformer, masked image modeling has emerged as an alternative self-supervised learning technique. It has shown performance that not only matches but often outperforms contrastive learning across a variety of visual tasks. This paper highlights several limitations in current contrastive learning solutions that utilize masked images, including suboptimal masking strategies, the absence of dynamic adjustments in the number of masked patches, and inefficient data augmentation techniques. To address these challenges, we propose a novel approach that introduces guided masking strategies, dynamically determines the number of masked patches, and explores lighter data augmentation during pre-training. Compared with state-of-the-art methods, our method achieves a 2.74% increase in linear probing accuracy on CIFAR-10, 2.15% on CIFAR-100, 3.47% on Tiny-ImageNet, and 0.33% on ImageNet100. Code is available at: https://github.com/Leon-jcH/RFMaCo.}
}
@article{KIM2026115947,
title = {BeShift: Behavior-informed data augmentation for robust and fair deep knowledge tracing under distributional shifts},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115947},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115947},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006738},
author = {Han Kyul Kim and Stephen Lu},
keywords = {Knowledge tracing, Deep learning-based knowledge tracing, Distributional shift, Data augmentation},
abstract = {Deep Learning-based Knowledge Tracing (DLKT) models have become central to predicting student learning trajectories, yet their reliability often deteriorates when deployed in classroom settings where student populations differ from the training data. This paper introduces BeShift, a novel behavior-informed data augmentation framework designed to improve the robustness of DLKT under distributional shifts. BeShift integrates three modules grounded in educational psychology and prior knowledge tracing (KT) research, modeling cognitive fatigue, forgetting, and knowledge gaps, to generate synthetic student sequences that mimic realistic patterns of performance decline. Furthermore, a target accuracy binning mechanism ensures that the augmented data systematically spans a broad range of student performance levels absent from the training data. Experiments on two benchmark datasets demonstrate that BeShift consistently improves predictive robustness, as measured by FairAUC, across multiple DLKT architectures and varying degrees of distributional shift, achieving on average a 11.6% improvement in FairAUC. Compared with baselines such as random augmentation, focal loss, and distributionally robust optimization, BeShift achieves superior trade-offs between accuracy and fairness. To our knowledge, BeShift is among the earliest systematic approaches to address distributional shifts in DLKT, with particular attention to low-performing students. These results establish BeShift as an effective and extensible framework for behavior grounded data augmentation in KT.}
}
@article{TIAN2026115858,
title = {EFE-HCTNet: An edge feature enhanced hybrid CNN-transformer network for the automated identification of nerves in ultrasound images},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115858},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115858},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005848},
author = {Dingcheng Tian and Binbin Zhu and Lingsi Kong and Jianlin Wang and Yu Wang and Ruyi Zhang and Qi Zhao and Yudong Yao},
keywords = {Regional anesthesia, Ultrasound image, CNN, Transformer, Attention},
abstract = {Ultrasound-guided regional anesthesia is a local anesthetic technique widely used in surgical procedures and pain management, where precise nerve localization is crucial for its effectiveness. Inaccurate localization may lead to block failure and severe complications. To improve the accuracy and efficiency of nerve blocks, this study proposes an automatic nerve segmentation method for ultrasound images called the Edge Feature Enhanced Hybrid CNN-Transformer Network (EFE-HCTNet). EFE-HCTNet combines a CNN-Transformer hybrid architecture to improve the extraction of both global and local features, and utilizes an edge feature enhancement module to guide the network in achieving more precise nerve segmentation by leveraging semantic boundary information. The decoder part uses a multi-scale hybrid attention upsampling module to enhance feature fusion and improve segmentation accuracy. We created a brachial plexus dataset (BPdataset) containing 600 annotated images and evaluated EFE-HCTNet on several public datasets, including the femoral nerve dataset (FNdataset), brachial plexus trunk dataset (BPTdataset), and Nerve-UTP dataset (Nerve-UTPdataset). Experimental results show that EFE-HCTNet achieves IoU of 69.53%, 74.41%, 70.31%, and 71.62% on the BPdataset, FNdataset, BPTdataset, and Nerve-UTPdataset, respectively. Compared with networks like UNet, AttUNet, TransUNet, and SwinUNet, EFE-HCTNet demonstrates superior segmentation performance. These results indicate that EFE-HCTNet has significant potential in improving the accuracy and safety of regional anesthesia. The data and code are available at https://github.com/TDC-ResearchLab/EFE-HCTNet.}
}
@article{WANG2026115939,
title = {Bio-inspired night vision: A cat-eye mechanism for low-light image enhancement},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115939},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115939},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006659},
author = {Chengchao Wang and Yan Wang and Jun Chen and Jingjing Liu and Jihao Guo and Jieren Cheng and Wenxuan Tu},
keywords = {Biomimetic vision, Transformer, Low-light image enhancement, Illumination-aware attention module},
abstract = {Noise amplification and detail loss remain critical challenges in low-light image enhancement (LLIE). Existing methods primarily rely on data-driven deep models or physics-based illumination compensation strategies to improve brightness. However, these approaches often overlook the adaptive capabilities of biological vision systems in extreme lighting conditions, limiting their effectiveness in real world scenarios. Inspired by the exceptional night vision of cat eyes, this paper proposes a bio-inspired night vision LLIE method (BINV), which takes advantage of biological visual perception principles to attain better enhancement performance. Specifically, to emulate the natural denoising capacity of feline rod cells in dark conditions, we employ an implicit biologically inspired noise-suppression mechanism to achieve the suppression of various noises in real-world scenarios. Moreover, the proposed method achieves luminance compensation by reclaiming uncaptured illumination data that would otherwise be discarded through reflective loss. Extensive experiments on three datasets have verified the superiority of BINV over competitors.}
}
@article{DINI2026115850,
title = {On the impact of pretraining data ordering in transformer encoder- and decoder-only language models},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115850},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115850},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005769},
author = {Luca Dini and Lucia Domenichelli and Dominique Brunato and Felice Dell’Orletta},
keywords = {Curriculum learning, Data ordering, Language model pretraining, Linguistic representations, Representation geometry},
abstract = {Pretraining large language models typically relies on randomly ordered corpora, implicitly assuming that data order has limited impact on learning. However, curriculum learning suggests that the sequence of training examples can influence optimization and representation dynamics. In this work, we systematically examine pretraining data ordering as an independent design variable for transformer-based language models, analyzing how curriculum-inspired strategies affect learning trajectories, representations, and transfer performance. We pretrain encoder-only and decoder-only models under controlled conditions, varying only the ordering of training data according to readability-based complexity proxies and their inverted variants, alongside multiple random baselines. Beyond final accuracy, we adopt a multi-dimensional evaluation framework combining intrinsic metrics, linguistic probing across training stages, downstream tasks, and geometric analyses of embedding spaces. Results indicate architecture-dependent tendencies in response to data ordering. Encoder models generally exhibit stronger sensitivity to curriculum strategies, with noticeable differences in optimization behavior, probing dynamics, and representation geometry. Decoder models appear comparatively more stable under forward curricula, with more pronounced effects emerging under inverted orderings. Probing analyses suggest that early improvements reflect differences in data exposure rather than accelerated linguistic acquisition, while later-stage effects selectively mirror properties emphasized by specific curricula. Geometric analyses show that data ordering reshapes global variance structure, often increasing anisotropy, without substantially altering nonlinear intrinsic dimensionality. Overall, data ordering functions as a selective inductive bias during pretraining, influencing learning dynamics and representational emphasis rather than consistently improving performance. These findings clarify how curriculum design interacts with transformer architectures and delineate its practical impact on pretraining outcomes.}
}
@article{WU2026115854,
title = {TAWNet: Three-dimensional adaptive weighted network for RGB-D salient object detection},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115854},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115854},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005800},
author = {Jiazheng Wu and Zhenxue Chen and Qingqiang Guo and Chengyun Liu and Zhenyan Wang and Qinggang Meng},
keywords = {Salient object detection, Three-dimensional adaptive weighted, Depth quality optimization, Cross-scale residual attention},
abstract = {Although recent RGB-D salient object detection methods have explored various cross-modal fusion strategies, ranging from modality-specific processing to different operations targeting high- and low-level features, they typically lack a systematic framework for jointly modeling the intrinsic relationships between modalities. This limits their ability to exploit the synergistic potential of RGB and depth modalities fully. Furthermore, the quality of the input depth maps and the cross-scale interaction between multi-level features are also concerns. To address these issues, we propose a Three-dimensional Adaptive Weighted Network (TAWNet), which explicitly and collaboratively models the similarity, difference, and complementarity between modalities to achieve effective cross-modal fusion. Specifically, TAWNet employs a P2T-based parallel encoder to extract hierarchical features. The lightweight Depth Quality Optimization module (DQO) is first applied to the depth branch for filtering and enhancing depth features. The core of our framework is the Three-dimensional Adaptive Weighted Fusion module (TAWF), which first applies different purification processes to the two modal inputs. Then, it learns adaptive weights across three dimensions: semantic similarity, modal difference, and information complementarity, to perform weighted fusion and generate unified fused features, seamlessly integrating the purified multimodal information. Furthermore, the Cross-scale Residual Attention module (CRA) in the decoder progressively integrates multi-scale contextual information through a cascaded structure for refined prediction. Extensive experiments on six benchmark datasets demonstrate that, through the synergistic effect of the three core modules, our TAWNet outperforms 21 state-of-the-art methods. More importantly, TAWNet achieves a superior balance between performance and complexity, providing excellent accuracy without introducing excessive parameters and computational costs. The source codes will be released at https://github.com/Karry-Wu/TAWNet.}
}
@article{XU2026115873,
title = {InvisiSense: A privacy-preserving deep learning framework for driving status perception using IMU data},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115873},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115873},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600599X},
author = {Yuanzhuo Xu and Pengfei Sun and Liwei Jing and Shaowu Wu and Kejiang Xiao and Xiaoguang Niu},
keywords = {Status perception, Deep learning, EKF, Affective computing, Driving status detection},
abstract = {Perceiving drivers’ status is highly valuable to auto services and insurance companies for driver assessments and improvements in driving safety. However, most existing status perception methods face challenges in deployment, privacy protection, and data collection to extract distinctive features from driving data. In this paper, we propose InvisiSense, a novel privacy-preserving driving status perception system that uniquely integrates stochastic cloned Extended Kalman Filter (EKF) with a deep residual network to achieve high-accuracy motion estimation and driving status classification. Unlike existing methods relying on visual data, InvisiSense only uses IMU data from smartphones, ensuring better privacy protection and easier deployment. A classifier based on the attention mechanism is built for better performance on status perception. Experiment results on invisible driving IMU data over 3268.1 km of trips show that the proposed system can achieve the same level of effectiveness compared to the existing method from different data sources (e.g., visual) and the average perception accuracy of different status can reach 72.3%.}
}
@article{FANG2026115862,
title = {Few-shot class-incremental learning based on prompt guidance and multimodal fusion},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115862},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115862},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005885},
author = {Haoming Fang and Haonan Cai and Keming Mao and Jianzhe Zhao and Xinlu Xiao},
keywords = {Incremental learning, Few-shot, Prompt learning, Multimodal fusion},
abstract = {Class-Incremental Learning (CIL) enables models to continuously assimilate new knowledge without forgetting previously learned tasks. However, conventional CIL methods face significant challenges, including catastrophic forgetting, inefficient cross-task knowledge transfer, and poor performance in few-shot scenarios. To address these limitations, we propose Bimodal Prompt Collaborative CLIP (BPC-CLIP), a CLIP-based framework that integrates prompt learning and multimodal fusion to enhance adaptability and stability in few-shot class-incremental learning (FSCIL) settings. BPC-CLIP enriches textual supervision with fine-grained attribute descriptions, employs a gated fusion mechanism to adaptively integrate visual and textual prompts, and introduces a Bimodal Prompt Selection strategy to dynamically select task-relevant prompts based on cross-modal similarity. Extensive experiments on the CIFAR-100, ImageNet-100, and CUB-200 benchmarks demonstrate that BPC-CLIP consistently outperforms state-of-the-art methods, offering a scalable and generalizable solution for real-world FSCIL applications.}
}
@article{SONG2026115935,
title = {FACT: Feature Adaptive Continual-learning Tracker for multiple object tracking},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115935},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115935},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006611},
author = {Rongzihan Song and Zhenyu Weng and Huiping Zhuang and Jinchang Ren and Yongming Chen and Zhiping Lin},
keywords = {Multiple object tracking, Adaptivity, Online learning, Analytic continual learning, Two-stage association},
abstract = {Multiple-object tracking (MOT) involves identifying and consistently assigning IDs to multiple targets in a video sequence, where occlusions are frequently encountered. Recent approaches leverage appearance features and incorporate temporal information to improve discriminative power for better occlusion handling. However, most existing methods fail to fully utilize historical tracking information without significantly compromising tracking efficiency. To address this limitation, we propose a new MOT framework called the feature-adaptive continual learning tracker (FACT), which supports online learning while effectively leveraging the complete tracking history. At the core of this framework is the feature-adaptive continual-learning (FAC) module, which adopts an analytic continual learning to enable online training using complete historical tracking information. Specifically, FAC module updates appearance models using only current-frame features and a fixed-size feature auto-correlation matrix via closed-form update rules, achieving performance equal to joint training on all past tracking data. We show that the FAC module can be seamlessly integrated into existing feature-based trackers, enhancing performance with minimal impact on tracking speed. Additionally, we introduce a two-stage association mechanism tailored to the proposed analytic continual learning-based paradigm. Extensive experiment results demonstrate that the proposed method achieves state-of-the-art online tracking performance on MOT16, MOT17, and MOT20 benchmarks.}
}
@article{SAGLAM2026115886,
title = {Uncertainty guided oversampling: A classifier-specific approach for effective handling of class imbalance in machine learning},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115886},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115886},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600612X},
author = {Fatih Sağlam and Mehmet Ali Cengiz},
keywords = {Class imbalance, Resampling, Active learning, Uncertainty estimation, Noise},
abstract = {This study addresses class imbalance in machine learning classification tasks, where data distribution is unequal across classes. Existing resampling methods, which balance classes through random oversampling or undersampling, can introduce noise or information loss. To overcome these limitations, we propose the Uncertainty Guided Oversampling (UGO) method. UGO leverages active learning principles to select informative data points for synthetic data generation. UGO employs a modified pool-based sampling to achieve automatic informative sample selection. Firstly, UGO identifies noise samples that have high aleatoric uncertainty before data generation. It then focuses on non-noisy data that have high epistemic uncertainty to ensure informative sample selection. UGO determines the amount of data generation by comparing the average epistemic uncertainty between classes, eliminating the need for predefined oversampling ratio. Furthermore, UGO prevents new noise generation by relocating newly generated noisy data. The iterative process continues until class epistemic uncertainties are statistically not different. The proposed UGO method is evaluated on 2 simulation and 74 benchmark datasets and is compared with other resampling techniques. UGO achieves statistically significant improvement based on the imbalanced accuracy measure (IAM), Matthew’s correlation coefficient (MCC) and F1. Overall, UGO offers a classifier-specific approach to handling class imbalance by strategically selecting informative samples based on epistemic uncertainty for synthetic data generation and preventing noise introduction that can measure the imbalance without being dependent on the number of samples.}
}
@article{ALI2026115907,
title = {Kalman-Adam: Optimal bayesian moment estimation for memory-Efficient and generalizable deep learning},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115907},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115907},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006337},
author = {Mohsin Ali and Ruby Bhatt},
keywords = {Kalman filter, Deep learning optimization, Adaptive methods, Fine-Grained classification, Generalization gap},
abstract = {The widely used Adam optimizer usually converges towards sharp minima with poorer generalization compared to the more straightforward SGD. While this is often attributed to the geometry of loss landscapes, we instead posit that it stems from the heuristic Exponential Moving Average (EMA) used by Adam for moment estimation. As a remedy, we introduce Kalman-Adam, a fundamentally novel optimizer that discards the traditional EMA. Instead, it pioneers a principled Bayesian framework, modeling moment estimation as a state-space problem where two independent Kalman filters optimally estimate moments from noisy mini-batch gradients. We conjecture that this results in a more reliable update signal, driving optimization towards superior, flatter minima. Extensive evaluation, using ResNet-18 and ResNet-50 architectures, on nine benchmarks including CIFAR, Tiny ImageNet, and the challenging fine-grained visual classification (FGVC) datasets shows that Kalman-Adam surpasses the current industry standard of AdamW in 7 out of 9 tasks. These include remarkable accuracy gains on FGVC-Aircraft (+1.65% over AdamW) and a new state-of-the-art on Flowers-102 (+3.17%), even outperforming SGD. Unexpectedly, memory profiling reveals that Kalman-Adam is remarkably efficient, reducing peak memory consumption by approximately 14% compared to SGD on high-resolution datasets. Supporting this, loss landscape analysis confirms that Kalman-Adam converges to significantly flatter minima, providing a mechanistic explanation for its improved generalization.}
}
@article{SALMERON2026115904,
title = {Spectral biclustering-driven scalability for post-hoc explainability in recommender systems},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115904},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115904},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006301},
author = {Jose L. Salmeron and Irina Arévalo},
keywords = {Recommender systems, Explainable artificial intelligence, Spectral biclustering},
abstract = {Explainability in recommender systems is essential for ensuring transparency, accountability, and trust, yet existing post-hoc methods often encounter severe scalability challenges. Observation-level deletion diagnostics offer a counterfactual way to analyze recommendations by retraining models after removing individual users or items, but their cost grows rapidly with dataset size. To improve the practical tractability of this analysis, this paper introduces a block-deletion diagnostic framework that uses spectral biclustering to group users and items and then removes entire blocks of interactions. This formulation reduces the number of retraining procedures relative to finer-grained deletion strategies and produces explanations at the level of user segments, item groups, and their interactions. The framework is evaluated on two representative recommender paradigms, Singular Value Decomposition and Neural Collaborative Filtering, using the MovieLens and Amazon datasets. The results show that top-ranked recommendations are often more sensitive to specific interaction blocks than lower-ranked ones, with some blocks acting as supporting evidence and others having a detrimental effect on recommendation quality. The analysis also indicates that user segments differ in their sensitivity to block removal, suggesting heterogeneous levels of reliance on localized interaction patterns. These findings provide diagnostic information that is not directly visible through standard recommendation metrics. Overall, the results suggest that block-deletion diagnostics offer a practical and model-agnostic post-hoc analysis framework for recommender systems, while also highlighting that the resulting explanations depend on the chosen block structure.}
}
@article{ONAN2026115815,
title = {GraphCycle-CLTM: A cycle–consistent graph contrastive framework for neural topic modeling},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115815},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115815},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005411},
author = {Aytuğ Onan},
keywords = {Neural topic modeling, Contrastive learning, Graph neural networks, Cycle consistency, Semantic graph propagation, Negative sampling},
abstract = {Neural topic models have recently advanced through contrastive learning and graph-structured semantic priors, yet several fundamental limitations remain. First, existing contrastive objectives often rely on frequency-based or heuristic negative sampling, which introduces semantic bias and weakens latent topic separation. Second, contrastive learning is typically restricted to the encoder, creating a structural mismatch between discriminative document representations and the generative decoder that produces topic–word distributions. Third, although graph-based topic models effectively propagate semantic information over document–word or word–word graphs, they lack an explicit mechanism to enforce consistency between propagated graph semantics and the decoder’s topical structure. To address these challenges, we propose GraphCycle-CLTM, a unified cycle-consistent graph contrastive framework for neural topic modeling that tightly couples representation learning with generative topic modeling. The framework integrates three mutually reinforcing components. First, a graph-guided contrastive sampler constructs semantically balanced positive and negative pairs via multi-hop propagation over document–word and word co-occurrence graphs, enabling structure-aware and unbiased contrastive learning. Second, a cycle-consistent topic reconstruction module enforces bidirectional agreement between original and reconstructed topic–word distributions, effectively bridging the gap between encoder-level representations and decoder-level generation. Third, a topic-aware graph propagation layer injects explicit topical priors into document embeddings through a tri-partite semantic graph, ensuring that message passing remains aligned with learned topic semantics. Extensive experiments on eight benchmark datasets demonstrate that GraphCycle-CLTM consistently outperforms state-of-the-art neural, graph-based, and contrastive topic models across topic coherence, topic diversity, document clustering quality, and downstream classification accuracy.}
}
@article{ZHU2026115928,
title = {SaDHT: A Scale-aware Deep Hierarchical Transformer for hyperspectral-LiDAR data fusion classification},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115928},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115928},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006544},
author = {Junheng Zhu and Yining Feng and Wei Cheng and Yimin Ding and Xianghai Wang},
keywords = {Hyperspectral image, LiDAR data, Fusion classification, Transformer, Scale-aware},
abstract = {In the field of hyperspectral image (HSI) and Light Detection and Ranging (LiDAR) data fusion classification, Convolutional Neural Networks (CNNs) excel at extracting local features but struggle to capture long-range dependencies. In contrast, Transformers are effective at modeling long-range interactions yet exhibit limitations local feature extraction and computational efficiency. Additionally, existing methods often overlook the varying abilities of shallow and deep network layers to capture dependencies across various scales, as well as the deep interaction between multimodal features. To address these challenges, this paper proposes a Scale-aware Deep Hierarchical Transformer (SaDHT). The SaDHT first leverages convolutional layers to extensively extract local information from HSI and LiDAR data. It then introduces a lightweight and efficient Scale-aware Module (SaM), which consists of a Multi-group Mixed Convolution (MgMC) module and a Scale-aware Aggregation (SaA) module. The MgMC module captures multi-scale features and expands the receptive field, while the SaA module effectively integrates features from different groups. Furthermore, a novel encoder stacking strategy is designed to simulate the evolving dependency relationships across network layers. Finally, cross-token fusion is employed to enhance feature interaction between modalities, further boosting model performance. Extensive experiments on three public datasets demonstrate the competitive performance of SaDHT. The source code will be available at: https://github.com/junhengzhu/SaDHT.}
}
@article{JIAO2026115896,
title = {Real-time edge micro-defect detection for semiconductor wafers under complex backgrounds: a hybrid approach combining optical topography and deep learning},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115896},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115896},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006222},
author = {Tingyang Jiao and Chenyan Wu and Qing Zhang and Wei Yang and Yujun Li and Youmin Zhang and Jing Xin},
keywords = {Silicon wafer edge micro-defect detection, High-precision wafer edge arc-surface imaging system, SiED-YOLO lightweight network, Dual-axis attention mechanism, Dynamic convolution feature pyramid},
abstract = {The secondary edge chamfering process at the edge of semiconductor wafers is a critical step in the manufacturing of large-diameter wafers. However, edge images at this process stage are often challenged by complex striped backgrounds, multi-scale defect distribution, and the loss of micro-defect features. To address these issues, this study proposes an integrated solution combining high-resolution optical imaging and deep learning algorithms. A specialized imaging system combining an annular light source with dual-CCD camera coordination was developed to effectively address reflection interference and the problem of feature loss in arc-surface imaging. Using this system, defect images after the secondary edge chamfering process were acquired to construct the SWED dataset, which includes three defect categories: Chip, Crack, and Dirty. Building upon the YOLOv8 baseline, a novel SiED-YOLO model was developed. This model incorporates a Dual-Axis Attention module to suppress interference from directional striped backgrounds, a dynamic convolution feature pyramid with the introduction of the DyC-C2f module to enhance multi-scale defect representation capability, and an Inner-IoU loss function to optimize micro-defect localization accuracy. Experimental results demonstrate that the SiED-YOLO model achieves 95.6% mAP@0.5, representing a 3.7 percentage point improvement over YOLOv8n, with an inference speed of 1.62 ms/pcs. The number of parameters and computational complexity are reduced by 23.5% and 20.9%, respectively. The proposed solution has been deployed and verified on the production line of 12-inch semiconductor wafers, significantly reducing both false negatives and false positives compared to conventional methods, providing a robust technical solution for real-time, high-precision defect detection in semiconductor manufacturing.}
}
@article{TAN2026115807,
title = {Enhancing fairness and privacy in federated graph neural networks via macro-level restructuring},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115807},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115807},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005332},
author = {Dongli Tan and Zuobin Ying and Yajie Wang and Zijie Pan and Yu-An Tan and Tianqing Zhu and Wanlei Zhou},
keywords = {Machine learning, Federated learning, Graph neural networks, Differential privacy, Fairness},
abstract = {Federated Graph Neural Networks (FGNNs) enable collaborative learning on decentralized graph-structured data while preserving privacy. However, existing FGNN methods suffer from non-IID data distributions, fairness disparities, and privacy risks, leading to biased and vulnerable global models. In this paper, we propose a Macro-Level Restructuring Framework that integrates unsupervised GNN-based macro graph aggregation to address these challenges. Our framework constructs a privacy-preserving macro graph by clustering client-level structures, enabling efficient and fair knowledge sharing. The aggregation is optimized using a graph-constrained optimization formulation, ensuring structural consistency while minimizing fairness disparities. To enhance privacy protection, we incorporate differentially private graph autoencoders, which enforce privacy guarantees while maintaining predictive performance. Additionally, we introduce an asynchronous aggregation strategy to handle heterogeneous client participation and accelerate convergence in federated settings. We evaluate our method on two benchmark datasets, MIMIC-III and Reddit Social Graph, under varying non-IID conditions. Results demonstrate that our approach outperforms state-of-the-art FGNN baselines such as FedGNN, achieving an average AUC-ROC improvement of 4.1% while reducing privacy risks (MIAA) and fairness disparities (AoD/EoD) substantially. Our findings highlight the effectiveness of macro-level restructuring in enhancing privacy, fairness, and generalization in federated graph learning.}
}
@article{LIU2026115920,
title = {Policy distillation-based multiagent actor–critic for cooperative UAV path planning in complex environments},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115920},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115920},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006465},
author = {Huidong Liu and Jiangshan Ai and Xu Lu and Xianlei Long and You Li and Xiangwei Zhu and Fuqiang Gu},
keywords = {MARL, Multi-UAVs, Cooperative path planning, Conditional variational autoencoder},
abstract = {Cooperative path planning for multiple unmanned aerial vehicle systems has become a focal point of research in various domains owing to its inherent advantages in maneuverability, coordination, and robustness. Multiagent reinforcement learning (MARL) demonstrates strong adaptability in complex environments with incomplete or uncertain information, enabling efficient collaboration via autonomous learning. However, MARL often suffers from low sample efficiency, requiring extensive environmental interactions to derive optimal policies. We address this by proposing a personalized policy distillation multiagent actor–critic algorithm that integrates nonexpert policy guidance with personalized distillation techniques to enhance learning efficiency and policy quality. Specifically, we leverage the artificial potential field (APF) method to generate structured, nonexpert policies that are initial guidance framework for agents to effectively reduce the search space and accelerate early-stage learning. Building upon this foundation, we introduce a rule-guided and trainable shared embedding mechanism, instantiated via a conditional variational autoencoder (CVAE), to capture the latent policy representations underlying nonexpert strategies derived from APF. In addition, we design an innovative perturbation network that refines expert actions by exploring superior alternatives, enhancing the exploration capabilities of agents, and policy optimization. Extensive experiments demonstrate that our proposed approach significantly outperforms state-of-the-art methods in terms of success rate, average reward, and average path length.}
}
@article{CHEN2026115940,
title = {Enhancing robustness in multi-agent reinforcement learning via temporal consistency regularization: A self-distillation framework},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115940},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115940},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006660},
author = {Huang Chen and Mingjun Dai},
keywords = {Multi-agent reinforcement learning, Robustness, Self-distillation, Policy regularization, Temporal consistency},
abstract = {The centralized training with decentralized execution (CTDE) paradigm has achieved strong performance in multi-agent reinforcement learning (MARL), yet on-policy actor–critic methods such as MAPPO can still exhibit training instability and late-stage performance collapse on coordination-intensive tasks. We address this issue with Self-Distillation MAPPO (SD-MAPPO), which maintains an Exponential Moving Average (EMA) teacher policy and regularizes the current actor with a KL-based temporal consistency term. Rather than correcting the underlying critic estimates, the proposed mechanism provides a slowly evolving policy reference. From a local analytical perspective, the EMA teacher bounds teacher–student drift over time, while the KL penalty locally damps abrupt policy fluctuations induced by noisy learning signals. Empirically, we evaluate on challenging SMAClite micromanagement tasks and complement win rate with test return, final-stage statistics, and late-stage update diagnostics. Across the primary four-task suite, SD-MAPPO improves final-stage robustness on the more collapse-prone maps while remaining broadly competitive on the easier tasks, with especially clear gains on 3s5z_vs_3s6z and 10m_vs_11m. Diagnostic analyses further show that the method consistently reduces late-stage policy-shift indicators such as old–new KL and clipping activation, even when critic-side changes are only mild. Overall, the results support SD-MAPPO as a lightweight actor-side stabilizer for instability-prone on-policy CTDE training rather than a universal improvement module. The method is plug-and-play, preserves decentralized execution, and adds only a small constant-factor training-time overhead. At deployment, action selection remains in the same actor-only regime as MAPPO because the EMA teacher is not used.}
}
@article{TANG2026115851,
title = {PAT-Net: Point agent transformer network for point cloud classification},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115851},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115851},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005770},
author = {Wenhao Tang and Zhenyu Liu and Guifang Duan and Jianrong Tan},
keywords = {Point cloud classification, Deep learning, Transformer, Agent attention, Dual-frequency},
abstract = {As the cornerstone of 3D vision, point cloud classification remains a challenging task. To tackle the quadratic cost of self-attention in the number of points, most existing Transformer-based methods compute self-attention only within individual patches or clusters of the point cloud, but this inevitably limits the ability to model global contexts. Furthermore, these methods fail to effectively learn both high- and low-frequency features together from the input point clouds. To overcome the above issues, in this paper, we present Point Agent Transformer Network (PAT-Net), a novel network for point cloud classification. Specifically, we first propose an offset-agent Transformer (OAT) block, which employs a small set of agent points that serve as intermediaries to aggregate and broadcast global information, achieving reduced complexity while preserving global context modeling capability. Besides, we design a dual-frequency neighborhood feature aggregation (DNFA) module and a feature enhancement fusion (FEF) module, which work in tandem to effectively learn comprehensive features with both high- and low-frequency information in point clouds. With the DNFA module and the FEF module as fundamental components, we construct the PAT-Net for 3D point cloud classification. Extensive experiments demonstrate that our method achieves state-of-the-art performance on ScanObjectNN, ModelNet40 and ModelNet-O datasets.}
}
@article{DAG2026115912,
title = {Neural network-based systematics of giant dipole resonance parameters and impact on (γ,n) reaction cross sections},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115912},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115912},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006386},
author = {Murat Dag},
keywords = {Giant Dipole Resonance (GDR), (γ,n) Reaction cross sections, Artificial neural networks, Nucleus-wise validation, TALYS 2.0},
abstract = {Reliable giant dipole resonance (GDR) parameterization is essential for photonuclear reaction modeling in the (γ,n) reaction energy region, where dipole absorption dominates. This work develops a staged artificial neural network (ANN) scheme to infer the GDR centroid energy, width, and peak cross section from physically motivated nuclide descriptors compiled from evaluated nuclear-structure information provided by the National Nuclear Data Center (NNDC), using Reference Input Parameter Library (RIPL-3) values as learning targets. To obtain performance estimates that reflect genuine transfer to unseen nuclei and to avoid leakage from repeated entries, the dataset was partitioned nucleus-wise, assigning all records of a given nuclide to a single subset. Parameter inference was organized in three sequential stages to preserve the established coupling among centroid energy, width, and peak strength. A SHAP-based interpretability analysis was performed at each stage to quantify the relative importance of the input descriptors. The resulting ANN-derived parameter sets were implemented in TALYS and compared with the nucleus-specific GDR parameters internally available in the built-in TALYS structure/gamma/gdr/ data files under otherwise identical reaction-model conditions. Their impact on calculated (γ,n) reaction excitation functions was evaluated against experimental photoneutron reaction cross sections from the EXFOR library via the JANIS interface, quantifying agreement with experiment achieved by the neural-network-based GDR systematics. The even-even 112–124Sn isotopic chain was examined as a representative case of isotopic continuity. Overall, implementation of the ANN-derived GDR parameter triplets in TALYS generally improves agreement between calculated (γ,n) reaction excitation functions and EXFOR data relative to the built-in nucleus-specific TALYS GDR values where available.}
}
@article{LAM2026115843,
title = {Structured exploration and exploitation of label functions for automated data annotation},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115843},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115843},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005691},
author = {Phong Lam and Ha-Linh Nguyen and Thu-Trang Nguyen and Son Nguyen and Hieu {Dinh Vo}},
keywords = {Automated data annotation, Programmatic labeling, Label function generation, Exploration and exploitation},
abstract = {High-quality labeled data is critical for training reliable machine learning and deep learning models, yet manual annotation remains costly and error-prone. Programmatic labeling addresses this challenge by using label functions (LFs), i.e., heuristic rules that automatically generate weak labels for training datasets. However, existing automated LF generation methods either rely on large language models (LLMs) to synthesize surface-level heuristics or employ model-based synthesis over hand-crafted primitives. These approaches often result in limited coverage and unreliable label quality. In this paper, we introduce Expona, an automated framework for programmatic labeling that formulates LF generation as a principled process balancing diversity and reliability. Expona systematically explores multi-level LFs, spanning surface, structural, and semantic perspectives. Expona further applies reliability-aware mechanisms to suppress noisy or redundant heuristics while preserving complementary signals. To evaluate Expona, we conducted extensive experiments on eleven classification datasets across diverse domains. Experimental results show that Expona consistently outperformed state-of-the-art automated LF generation methods. Specifically, Expona achieved nearly complete label coverage (up to 98.9%), improved weak label quality by up to 87%, and yielded downstream performance gains of up to 46% in weighted F1. These results indicate that Expona’s combination of multi-level LF exploration and reliability-aware filtering enabled more consistent label quality and downstream performance across diverse tasks by balancing coverage and precision in the generated LF set.}
}
@article{LI2026115883,
title = {GrasAD: Gradient similarity and accumulated distribution-based device selection for asynchronous federated learning},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115883},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115883},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600609X},
author = {Yanan Li and Menghui Wang and Jianji Ren and Yimeng Wang and Yongliang Yuan and Hao Ni},
keywords = {Asynchronous federated learning, User selection, Weighted aggregation, Distribution importance},
abstract = {Asynchronous federated learning (AFL) is a privacy-preserving framework designed to accommodate device heterogeneity and heterogeneous data distributions. Using asynchronous interactions between devices and the server, AFL maximises device computation capabilities while being less affected by device states, making it ideal for large-scale, distributed scenarios such as IoT and edge computing. However, the asynchronous update mechanism introduces the issue of information staleness, which can reduce model performance. Current methods primarily mitigate staleness by suppressing its effects using inverse proportional functions, without fully exploiting the potential value of stale updates. To address this issue, we propose GrasAD, a dynamic device selection method that integrates cumulative distribution and gradient similarity to evaluate the importance of local updates. GrasAD evaluates local updates from two dimensions: historical cumulative distribution and current gradient similarity, providing global and local perspectives, respectively. Devices are ranked by importance rather than numerical value to mitigate scale differences, resulting in faster and more stable global model convergence. Extensive experiments on four benchmark federated datasets demonstrate the effectiveness of GrasAD. Results show that under different non-IID settings, GrasAD achieves the highest overall prediction accuracy, and this improvement is significant compared with multiple comparative algorithms.}
}
@article{LAN2026115892,
title = {Correlation-guided mixture of experts prompt learning for long-tailed multi-label text classification},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115892},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115892},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006180},
author = {Ge Lan and Mengting Hu and Yu Su and Yufei Sun and Yuzhi Zhang},
keywords = {Multi-label text classification, Long-tailed distribution, Prompt learning, Text classification, Mixture of experts},
abstract = {Multi-label text classification (MLTC) is challenged by both label correlation and long-tailed distribution. Most of the previous work addresses these properties separately. Only a few recent studies jointly emphasize them by dividing labels according to their frequencies and transferring knowledge to tail labels. However, such frequency-based partitioning can be arbitrary and may disrupt the intrinsic label correlation. In this paper, we propose Prefix-cMoE, a correlation-guided mixture of experts (MoE) prefix model, to jointly address these challenges. Our approach reformulates MLTC using a mixture of experts architecture based on an encoder-decoder pre-trained language model, and dynamically routes instances to different experts according to learned label correlation, rather than label frequency. An encoder classifier module enhances the discriminative ability of the language model, while a correlation-guided router ensures that each instance is matched with the most suitable expert based on label correlation. This structured routing reduces interference among labels and promotes knowledge sharing within groups of correlated labels. To address the increased parameters of the mixture of experts model, we incorporate a parameter-efficient prefix tuning strategy, drastically reducing the number of trainable parameters. Extensive experiments on five benchmarks demonstrate that Prefix-cMoE achieves state-of-the-art results. Notably, multiple experts can coordinate with each other to tackle various types of labels, especially tail labels.}
}
@article{BAI2026115867,
title = {Learning from surprise: Fusing LLM-guided test-time adaptation for temporal knowledge graphs},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115867},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115867},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005939},
author = {Haodong Bai and Shengguo Kang and Jiong Zheng and Jiwei Qin and Xin Zhou},
keywords = {Temporal knowledge graphs, Test-time adaptation, Large language models, Neuro-symbolic AI, Concept drift},
abstract = {Temporal Knowledge Graphs (TKGs) are pivotal for modeling the evolutionary dynamics of events. However, effective TKG reasoning requires dynamically aligning historical structural knowledge with emergent semantic shifts. Real-world environments are plagued by temporal non-stationarity, where unpredictable event distribution shifts often render static structural representations invalid. While online fine-tuning attempts to fit new data, it often fails to balance the acquisition of new patterns with the retention of historical knowledge (i.e., catastrophic forgetting). To address this, we propose DART-TKG, a neuro-symbolic knowledge adaptation framework that achieves robust Test-Time Adaptation (TTA). Distinct from passive retraining, DART-TKG establishes a “Monitor-Reason-Adapt´´ closed-loop evolutionary mechanism: (1) Anomaly-Based Monitoring: It integrates prediction error signals with historical patterns to precisely localize knowledge drifts by identifying “surprising facts´´; (2) Cross-Modal Reasoning: It employs Large Language Models (LLMs) as reasoning agents to bridge discrete semantic rationale with continuous graph embeddings, generating explicit modulation instructions; (3) Parameter-Efficient Knowledge Injection: It injects this symbolic guidance into vector spaces via a norm-based signal modulation combined with Low-Rank Adaptation (LoRA), ensuring the synergy between adaptive plasticity and structural stability. Extensive experiments on ICEWS14 and ICEWS18 demonstrate that DART-TKG significantly enhances 9 diverse baselines in non-stationary environments, validating the efficacy of incorporating LLM-driven semantic priors into dynamic graph learning.}
}
@article{ANJUM2026115924,
title = {LLM-based text plus emoji multiclass hate speech language detection for resource constrained devices},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115924},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115924},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006507},
author = {Naveed Anjum and Zohaib Latif and Hongsong Chen},
keywords = {Text plus emoji hate speech detection, Multiclass data augmentaion, Low computatioal devices, LLM},
abstract = {In the contemporary digital era, the rapid proliferation of information exchange among social media users magnifies security concerns, including hate speech. Most existing research overlooks multiclass imbalance in datasets, which prevents accurate and unbiased hate speech identification across distinct classes. Additionally, it predominantly focuses on detection mechanisms such as machine learning, deep learning, transformers, and Large Language Models (LLMs) for binary classification, which require substantial computational resources. This study presents the Contextualized Word Insertion (CWI)-oriented data augmentation scheme using a pre-trained XLM-RoBERTa Masked Language Model (MLM) for multiclass imbalance datasets, and a TinyLLaMA model is applied to classify text and emoji-based hate speech for resource-constrained devices. First, data augmentation is performed to oversample minority classes relative to the majority for imbalanced datasets using XLM-RoBERTa. Second, data processing removes null values, numeric values, URIs, hashtags, normalized spaces and text, and the emoji library converts emojis to strings. The compact LLM (i.e., TinyLLaMA) is used to classify hate speech from augmented datasets into distinct multiclass categories on low-resource devices. Finally, Low-Rank Adaptation (LoRA) is applied in model training, significantly reducing the number of trainable parameters while maintaining performance, making it ideal for low-resource settings. The extensive experiments demonstrate that our study outperforms the others.}
}
@article{LI2026115916,
title = {Clairvoyant-Net: A lightweight and adaptive long sequence time-series forecasting framework for electrocardiogram},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115916},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115916},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006428},
author = {Zehui Li and Yudian Ouyang and Jianping Tan and Junhui Zhu and Weiping Lu and Ruining Xie and Yan Xu and Zhe Gou and Kun Xie},
keywords = {ECG forecasting, Information fusion, Long sequence time-series forecasting, Mechanical circulatory support},
abstract = {Mechanical circulatory support (MCS) devices are vital for patients with advanced heart failure. Current physiological control strategies for MCS primarily rely on detecting R-peaks in electrocardiogram (ECG) signals to regulate device rhythm. However, this “detect-first, then-adjust” control paradigm introduces inherent latency, which not only compromises therapeutic effectiveness but may also increase the risk of adverse events. To address this challenge, this paper proposes a lightweight and adaptive long sequence time-series forecasting model, Clairvoyant-Net, which anticipates ECG signals to eliminate R-peak detection delays. The model comprises three core modules: a fine-grained waveform segmentation module for extracting key physiological features, a temporal embedding module for capturing dynamic temporal features, and a Clairvoyant-Attention module for robust global-local information fusion. Building on Clairvoyant-Net, we further integrate low-rank adaptation techniques and corresponding learning schemes, enabling continuous online forecasting and rapid response in emergency scenarios. Extensive experiments on real-world ECG recordings demonstrate that Clairvoyant-Net outperforms state-of-the-art models in both forecasting accuracy and computational efficiency, reducing R-peak detection error from 88.57 ms to 1.88 ms, and is deployable on embedded devices. These results demonstrate its strong potential for enhancing the safety and efficacy of MCS devices, particularly in real-time emergency applications.}
}
@article{ZHANG2026115827,
title = {LG–BiFusion: local and global bidirectional LiDAR–camera fusion for 3D object detection},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115827},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115827},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005538},
author = {Rongyun Zhang and Yuxiang Xu and Peicheng Shi and Ping Xiao and Rongxiang Wang and Hongwei Ou},
keywords = {Autonomous driving, Multi-modal fusion, Bidirectional fusion, 3D object detection},
abstract = {Recently, Three-dimensional (3D) object detection by fusing light detection and ranging (LiDAR) and camera input has become a new trend. However, most mainstream methods only perform a one-way fusion of LiDAR and camera data, and do not fully utilise the interdependent characteristics of the two modalities. Simultaneously, the fusion of global LiDAR voxel features and camera features often lacks fine–grained regional information, leading to suboptimal results. Therefore, a local–global bidirectional and complementary LiDAR–camera fusion 3D object detection model is proposed in this study. Specifically, the LiDAR and camera modalities are fused in both directions at the global level. Through the camera–enhanced LiDAR and LiDAR–enhanced camera modules, rich voxel features with strong semantic information and camera features with enhanced spatial awareness are obtained. Subsequently, the foreground points and the camera features are locally fused using the 3D thermal value response to obtain fine–grained local foreground features. Finally, the three improved features are dynamically selected for object detection by the adaptive feature aggregation module. Extensive experiments were conducted on the nuScenes and KITTI datasets. Compared with the classical multimodal fusion model BEVFusion, the LG–BiFusion proposed in this study achieved a 3.6% increase in mean average precision (mAP) and a 3.2% increase in NDS on the nuScenes dataset, and improved the mAP of the multimodal model EPNet++ in the automotive category by 2.01% on the KITTI dataset. These experiments proved the effectiveness of the proposed model.}
}
@article{HE2026115847,
title = {Fold-Llama: Data-efficient robotic fabric folding via geometry-to-text encoding and lightweight LLMs fine-tuning},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115847},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115847},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005733},
author = {Ruhan He and Xuan Huang and Lianqing Yu and Xianyi Zeng and Yangjun Ou},
keywords = {Fabric folding, Single-arm robotic systems, Geometric rule encoding, Low-Rank adaptation (LoRA) fine-tuning, Large language models (LLMs)},
abstract = {Sequential multi-step fabric folding is a challenging problem in robotic manipulation, requiring a robot to perceive the fabric state and plan a sequence of actions leading to the desired goal. Existing approaches suffer from low data efficiency, weak cross-task generalization, and high deployment costs, which are not practical for industrial applications. Thus, we present Fold-Llama, a novel method for robotic fabric folding that utilizes geometry-to-text encoding and lightweight large language models (LLMs). Fold-Llama explicitly encodes human folding strategies into structured geometric operations, including 10 common geometric operation strategies, and subsequently DeepSeek-R1 generates a total of 2640 structured data pairs based on these geometric operation strategies for Low-Rank Adaptation (LoRA) fine-tuning of the Llama-3.2-3B-Instruct model. The fine-tuned model combines general LLM reasoning with 10 learned folding strategies, enabling it to generalize across diverse fabric configurations. This text-only synthesis and local deployment pipeline fundamentally shifts fabric manipulation learning from vision-based imitation to language-grounded geometric reasoning. We experimentally evaluate Fold-Llama on four representative sequential folding tasks and show that it significantly outperforms baseline LLM-based approaches in simulation, demonstrating strong data efficiency with only 2640 text samples (approximately 6% of traditional methods’ 48K+ robotic interaction samples) while achieving 90.5% error reduction over the best LLM baseline. Furthermore, our approach can be transferred from simulation to the real world without additional training by directly calling the API of models deployed on the vLLM platform. Despite training on rectangular fabrics, we also show our approach generalizes to T-shirts and shorts. Videos are available at: https://sites.google.com/view/fold-llama/home}
}
@article{BADDUR2026115908,
title = {Federated learning for diabetic retinopathy detection using parallel convolutional LeNet},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115908},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115908},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006349},
author = {Kundan Baddur and Pushpa Sangaralingam},
keywords = {Diabetic retinopathy, Fractional Archimedes Optimization Algorithm, Parallel convolutional LeNet, Federated learning, Deep learning},
abstract = {Diabetic retinopathy is an eye disease associated with diabetes. The existing systems possess limitations, such as insufficient integration of patient data. Hence, Federated Learning (FL) is employed to address the data privacy concerns in multi-institutional collaborations by enabling collaborative training without sharing raw patient data. A hybrid network, Parallel Convolutional-LeNet Fractional Archimedes Optimization Algorithm (PC-LeNet_FAOA), is proposed to overcome the limitations of standard Convolutional Neural Networks (CNNs) in capturing multi-scale and heterogeneous retinal features, for the efficient detection of diabetic retinopathy. The PC-LeNet is the integration of Parallel Convolutional Neural Network (PCNN) and LeNet. The input image is first denoised using a Medav filter, from which Haar Wavelet Transform (HWT) features are extracted. The denoised image is allowed for optic disc segmentation by Fuzzy C-Means (FCM) and blood vessel segmentation by Lightweight Multipath Bidirectional Skip Connection Network (LMBiS-Net). Each segmented image is allowed for feature extraction individually. The statistical and Fuzzy Local Binary Pattern (FLBP) features are excerpted from both segmented images and concatenated into a single feature. Then, in the diabetic retinopathy detection phase, PC-LeNet is utilized. PC-LeNet is trained by the FAOA to generate the detected output. The results achieved by PC-LeNet_FAOA are 93.88% accuracy, 95.88% True Positive Rate (TPR), 92.88% True Negative Rate (TNR), 0.02 Mean Squared Error (MSE), 0.13 Root Mean Squared Error (RMSE), and 6.12 loss function at time step 20, thereby outperforming existing methods including Residual Neural Network (ResNet), Stacked CNN, Support Vector Machine (SVM), DenseNet, FAOA_LeNet, EfficientNetB0, and Modified Inception V3.}
}
@article{ZHOU2026115819,
title = {Rethinking sparse supervision on federated long-tailed learning},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115819},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115819},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005459},
author = {Yizhi Zhou and Junxiao Wang and Hong Yu and Heng Qi and Xin Xie and Miao Wang and Junfeng Wu},
keywords = {Federated learning, Statistical heterogeneity, Long-tailed distributions},
abstract = {The extension of federated learning (FL) to long-tailed data distributions, known as federated long-tailed learning, has garnered significant interest due to the prevalence of such imbalances in real-world applications. While existing methods have made considerable strides, they typically rely on the assumption that all classes are at least minimally represented on most client, an condition that often fails in practice, especially for tail classes. This work first identifies the critical challenge of “sparse supervision”, which occurs when entire categories are completely absent on some clients, despite being present in the global dataset. The issue is exacerbated under a global long-tailed distribution: the probability of rare classes being missing from many clients is substantially higher, particularly with Non-IID data partitions like Dirichlet allocation with small concentration parameters. To address this, we propose MMC-FL (Mind the Missing Classes for Federated Long-Tailed Learning), a classifier-centric framework that explicitly mitigates the effects of class absence with minimal overhead. On the client side, an Equiangular Tight Frame (ETF) is leveraged to mask harmful gradients from absent classes while injecting lightweight, data-free synthetic supervision derived from simplex ETF prototypes. On the server side, a similarity-aware classifier collaboration scheme selectively blends the most compatible client classifiers that measured via a Gaussian-kernel similarity before standard FedAvg is applied to the model backbone. This approach stabilizes global optimization and refines tail-class decision boundaries without incurring extra communication costs.Extensive experiments on multiple benchmarks demonstrate that MMC-FL consistently outperforms state-of-the-art methods in federated long-tailed settings. Code will be made publicly available upon acceptance.}
}
@article{WANG2026115871,
title = {Masked autoencoders-based fault diagnosis pretraining model with meta fine-tuning and prototype prompting for few-shot fault diagnosis},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115871},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115871},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005976},
author = {Qianxu Wang and Tang Tang and Jie Wu and Fan Mo and Chuanhang Qiu and Ming Chen},
keywords = {Fault diagnosis, Self-supervised learning, Meta learning, Few-shot learning},
abstract = {This paper presents an innovative approach to few-shot fault diagnosis by combining Masked Autoencoders (MAE) pre-training, meta fine-tuning, and prototype prompting, termed MAE-PMFP. Traditional meta-learning methods often suffer from overfitting, limiting their performance in fault diagnosis with limited labeled data. The MAE-PMFP framework overcomes this by leveraging a large amount of unlabeled data, using MAE pre-training to establish a robust latent feature space that generalizes across different operational conditions. The process involves selecting appropriate preprocessing methods using sliding window cosine similarity (SWCS) and conducting unsupervised MAE pre-training. Subsequently, meta fine-tuning and prototype prompting adapt the model to downstream tasks. Notably, prototype prompting alone can achieve 97.49% without parameter updates when the target task is derived from the pre-training data. Even for new data sources, the model achieves strong performance through the two-stage fine-tuning approach, reaching an accuracy of 94.50%. These results demonstrate that MAE-PMFP is capable of learning meaningful latent features from vast amounts of unlabeled data and generalizing effectively to a variety of fault diagnosis tasks, offering a robust solution to the challenges faced by traditional meta-learning in real-world applications.}
}
@article{CAO2026115839,
title = {RD-UOD: A novel dual-branch RGB-depth fusion network for underwater object detection},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115839},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115839},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005654},
author = {Yuanjia Cao and Xiaobing Zhang and Fuchun Sun and Lingbo Zhang},
keywords = {Underwater object detection, Edge feature enhancement, RGB-depth fusion, Small objects, Domain adaptability},
abstract = {Underwater object detection is crucial for marine resource exploration, military defense, and environmental sensing. However, no existing algorithm can fully handle the complexities of underwater environments. RGB images frequently face issues such as blurred edges, color shifts, and strong light interference, while estimated depth maps can provide complementary geometric cues and spatial structure information. Currently, most dual-branch object detection methods lack corresponding edge enhancement for features from different modalities, and directly fusing features cannot effectively handle feature redundancy and information degradation. To address this, we propose RD-UOD, a novel dual-branch RGB-depth fusion network for underwater object detection that integrates multi-scale features from pertinent edge enhancement branches. Regarding the fusion method, features from both modalities are first concatenated directly along the channel dimension using a Concat operation, followed by further feature refinement with a lightweight Dynamic Inception Mixer Block (DIMB). To tackle the challenges of small underwater targets and the various water domains, we further propose an Enhanced Feature Praymid Network (EFPN), which reorganizes the aggregated shallow RGB features with preliminary fused multi-modal features, and works in tandem with the Path Aggregation Network (PAN) to achieve efficient detection. Experiments on the three public datasets and under different underwater conditions show that RD-UOD outperforms other representative methods, demonstrating strong robustness and generalization ability under complex water environments, while maintaining competitive real-time inference efficiency.}
}
@article{QIAO2026115931,
title = {ExposureGS: Illumination-aware Gaussian splatting for sparse-view 3D exposure correction},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115931},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115931},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600657X},
author = {Yuanjian Qiao and Mingwen Shao and Lingzhuang Meng and Yecong Wan},
keywords = {3D Gaussian splatting, Exposure correction, Sparse-view scenarios, Gaussian decoupling, Illumination modeling},
abstract = {3D Gaussian Splatting (3DGS) has recently demonstrated strong capability in novel view synthesis under adverse lighting conditions. However, existing methods typically rely on densely captured images for training and perform poorly in sparse-view scenarios with severe multi-view exposure inconsistencies, resulting in undesirable rendering artifacts. To address this limitation, we propose ExposureGS, a novel illumination-aware Gaussian splatting framework that reconstructs well-exposed and structurally faithful 3D scenes from only sparse and adverse lighting views. Specifically, ExposureGS consists of two core designs: Color-aware Gaussian Decoupling and Prior-aware Illumination Modeling. The former flexibly disentangles illumination and content Gaussians by learning illumination features and appearance mappings based on spherical harmonics, thereby separating scene content from lighting effects. Collaboratively, the latter models illumination variations under the guidance of both color and depth priors, facilitating the decoupled Gaussians to converge to a correct distribution even under sparse-view conditions. Benefiting from these strategies, our method achieves high-fidelity exposure correction for 3D scenes while maintaining real-time rendering performance. Extensive experiments demonstrate that ExposureGS significantly outperforms state-of-the-art methods across under-exposed, over-exposed, and multi-exposure scenarios.}
}
@article{GAO2026115842,
title = {RAQAG : A framework for automatically generating Q&A datasets with retrieval-augmented generation},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115842},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115842},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600568X},
author = {Bin Gao and Chen Yu and Qi Zhang and Chunwei Lou and Luhan Wang and Jin Xu and Dajiang Chen},
keywords = {Large language model, Retrieval-augmented generation, QA dataset, Multi-dimensional evaluation},
abstract = {Objectives: Large Language Models (LLMs) necessitate high-quality Question-Answer (QA) datasets for fine-tuning and evaluation, but current resources are constrained by limited scale, diversity, and structured annotations. This scarcity is especially pronounced in business and management research (e.g., UTD24 journal domains like accounting, finance, marketing, strategy, and operations), where domain-specific QA datasets are rare beyond finance-focused ones. Methods: To bridge this gap, we present RAQAG, a Retrieval-Augmented Question Answer Generation framework that constructs QA datasets through a closed-loop process involving data synthesis, quality verification, and feedback optimization. RAQAG consists of three core modules: data preprocessing, QA generation, and QA evaluation. The QA generation module utilizes a dynamic retrieval-augmented generation approach, incorporating a three-tier retrieval strategy (semantic vector search, BM25 retrieval, and BGE Reranker) to support dynamic paragraph segmentation and enhance document grounding. The QA evaluation module employs RACAR, a multi-dimensional evaluation framework that rigorously defines five core dimensions: Relevance, Agnosticism, Completeness, Accuracy, and Reasonableness, along with dynamic indicators like evidence coverage. Novelty: RAQAG presents a novel framework that integrates LLMs with a closed-loop process for generating high-quality QA datasets. RAQAG enables the creation of large-scale, domain-specific QA corpora, e.g., UTD24_QA, which includes 170,226 instruction-style QA pairs derived from 17,542 articles. A standardized multiple-choice benchmark, UTD24_QA Benchmark, is developed for systematic evaluation of LLMs in business and management knowledge. Findings: Experiments demonstrate that RAQAG produces higher-quality QA datasets, achieving a 9.45% improvement in RACAR scores compared to the best existing baseline. The framework exhibits robust performance across varying input granularities and hyperparameter settings. The engineering-oriented QAG system, featuring metadata-driven orchestration and visualized pipelines, further validates the effectiveness of RAQAG. The source code is publicly available at https://github.com/Fakerfigure/QAG_System.git.}
}
@article{WANG2026115884,
title = {Towards efficient Graph-RAG via structure-aware intermediate representation: Incremental collaborative exploration on knowledge graph},
journal = {Knowledge-Based Systems},
volume = {342},
pages = {115884},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115884},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006106},
author = {Jing Wang and Zhiwei Xu and Siyuan Liu and Ye Lu and Tao Li},
keywords = {Structure-aware intermediate representation, KG-Augmented QA, Query semantics alignment, Incremental collaborative exploration on KGs},
abstract = {Existing Graph-RAG approaches struggle to align complex, multi-hop queries with knowledge graph (KG) structures, often due to disjoint entity and relation retrieval or over-reliance on LLM-generated reasoning plans. To bridge this semantic and structural gap, we propose PRIME, a training-free, structure-aware framework that unifies entities and relations into subgraph-level intermediate representations and enables incremental, semantics-guided exploration. This design drastically reduces the search space while preserving structural coherence. On KGQA benchmarks, PRIME achieves 91.6% Hit@1 on WebQSP and 78.3% F1 on CWQ, outperforming the best baselines by 2.8% and 4.5%, respectively-even when using LLaMA2-7B. It also runs in 11.5 seconds on CWQ, over 1,000 ×  faster than training-based methods, demonstrating superior accuracy and efficiency in deep multi-hop reasoning scenarios.}
}