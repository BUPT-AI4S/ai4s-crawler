@article{SREELAKSHMI2026116669,
title = {Neutrosophic graph based energy-aware equitable total domination for efficient satellite cluster coordination},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116669},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116669},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601395X},
author = {T.P. Sreelakshmi and K. {Uma Samundesvari}},
keywords = {Energy-aware optimization, Simple neutrosophic graphs, Equitable total domination, Satellite cluster coordination, Energy efficiency, Uncertainty modeling, Fault tolerance, Autonomous space systems},
abstract = {This research presents a novel EA Equitable Total Domination (EA-ETD) framework that uses simple NG models to optimize satellite clusters. It introduces equitable domination constraints in a neutrosophic graph environment to maintain balanced coordination responsibilities, manage the network topology to ensure resilience, and utilize resources effectively under dynamic, uncertain space communication conditions. The Equitable TD problem is extended to simple NG to ensure equitable responsibility for domination among satellites, thereby avoiding energy exhaustion of individual satellites. An Energy-Aware (EA) Total Domination (TD) metric is defined within an NG framework that accounts for satellites' remaining energy, communication costs, and equity constraints based on each node's degree. The goal is to find the least-energy-disproportionate and total-domination set of nodes that fairly covers the entire satellite cluster while minimizing energy consumption under uncertainty. To solve this problem, a multi-objective optimization method concurrently minimizes total energy expenditure, domination imbalance, and communication overhead. Simulations are performed on typical topologies representing LEO constellations and cooperative satellite networks. The simulations show that the proposed EA-ETD method improves energy efficiency, load balancing, and fault tolerance compared to traditional graph-based and fuzzy TD methods. Additionally, the proposed model can accommodate dynamic topological changes and partial satellite failures, making it applicable to autonomous and resilient space systems. The results demonstrate that simple NG-based TD can be an excellent analytical and optimization tool for managing next-generation EA satellite clusters under uncertainty-dominated space environments.}
}
@article{GOK2026116614,
title = {AGEE: A multi-dimensional process-level metric for evaluating agent exploration over knowledge graphs},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116614},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116614},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013407},
author = {Murat Gök},
keywords = {Agent evaluation, Knowledge graph reasoning, Process-level metrics, Composite indicator, Graph exploration},
abstract = {Existing benchmarks for autonomous agents collapse each trajectory into a single scalar — task success or Hits@1 — revealing whether an agent answers correctly but not how it explores. Because chain-of-thought reasoning is often unfaithful, two agents with identical accuracy can reach an answer through very different traversals. We introduce AGEE (Agent Graph Exploration Efficiency), a process-level composite that decomposes exploration into three interpretable components: structural coverage (James–Stein-stabilised entropy of visited communities), information-gain rate (diminishing-returns weighted discovery), and exploration efficiency (coverage-AUC against a closed-form ideal). The components are combined by a weighted power mean satisfying seven axiomatic properties adapted from Moffat’s framework. Validating AGEE on 800 attempts across four agents (200 by Qwen-2.5-7B in a ReAct framework) over MetaQA-2hop, with classical baselines and synthetic topologies, surfaces two effects outcome metrics cannot. First, the language model operates in two distinct regimes—traversing the graph on 40.5% of questions but answering from parametric memory on the rest, with sharply different accuracy. Second, the AGEE composite is essentially uncorrelated with Hits@1, yet its sub-components carry strong, opposite-signed signal, exposing an exploration–exploitation trade-off that scalar accuracy conceals. Reproducing three strong KG-QA agents (ToG, PoG, Graph-CoT) end-to-end on WebQSP and CWQ across two backbones reveals an outcome–process double dissociation: as difficulty rises Hits@1 falls uniformly, but exploration dissociates by architecture while AGEE remains within a narrow band, measuring exploration quality independently of accuracy. A 1000-sample Dirichlet analysis confirms the rankings are stable. Code and data will be released upon acceptance.}
}
@article{HU2026116666,
title = {FedGC: Federated learning with geometry calibrated differential privacy},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116666},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116666},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013924},
author = {Jifei Hu and Hang Zhang},
keywords = {Federated learning, Differential privacy, Data heterogeneity, Data privacy},
abstract = {Federated learning (FL) enables multiple clients to collaboratively train a model by sharing model updates instead of raw data, but these updates can still leak sensitive information. Although recent studies combine differential privacy (DP) with model updates to provide formal privacy protection, existing methods typically rely on isotropic noise, which causes spatio-temporal miscalibration and degrades model performance. To address this, we propose FedGC (Federated Learning with Geometry Calibrated Differential Privacy), a framework that integrates spatio-temporal calibration into differential privacy. FedGC comprises two mechanisms: geometry mirror calibration (GMC) and geometry temporal calibration (GTC). GMC preserves the original gradient as a mirror reference and adaptively fuses it with the clipped gradient to improve update efficiency. GTC models gradients as a linear query stream and leverages the matrix mechanism to optimize noise allocation across rounds, thereby mitigating long-term noise accumulation. By jointly performing spatial and temporal calibration, FedGC improves model performance while maintaining privacy guarantees. Extensive experiments on image classification benchmarks and medical image datasets show that FedGC consistently outperforms existing methods under the same privacy budget, making it a promising solution for real-world deployment.}
}
@article{LI2026116468,
title = {From data-driven to knowledge-driven: A Fuzzy Logic Guided Deep Network for bladder tumor staging},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116468},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116468},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011949},
author = {Zihao Li and Xiaodong Yue and Cheng Zhang and Yufei Chen and Weiping Ding},
keywords = {Knowledge-driven deep learning, Fuzzy clinical rules, Bladder tumor staging},
abstract = {Identifying the stage of bladder tumors, specifically differentiating between stage ≥T2 and <T2, is crucial for planning medical treatment. Although Deep Neural Networks (DNNs) are effective for medical image classification, purely data-driven approaches often neglect explicit clinical knowledge, leading to limited interpretability and potential misdiagnosis on uncertain samples with indistinct features. To bridge the gap from data-driven to knowledge-driven diagnosis, we propose a novel Fuzzy Logic Guided Deep Network (FR-DCNN) for bladder tumor staging. Specifically, we formulate the clinical expert knowledge of tumor penetration into the bladder wall into fuzzy logic rules and construct a neural network to learn these rules from Magnetic Resonance (MR) images. We then introduce a joint model that fuses this fuzzy clinical knowledge into the deep neural network, effectively guiding the network to focus on the clinically significant tumor–wall regions. This mechanism not only enhances the interpretability of the diagnostic process but also improves the discrimination precision for uncertain samples where visual boundaries are ambiguous. Experimental results demonstrate that the proposed method outperforms existing data-driven models, achieving the best classification performance, validating its effectiveness in rational and accurate tumor staging.}
}
@article{WANG2026116654,
title = {Dual-perspective redundancy minimization for multi-label feature selection},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116654},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116654},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013808},
author = {Changyue Wang and Changzhong Wang and Taoli Yang and Tingquan Deng},
keywords = {Mutual information, Feature redundancy, Residual label redundancy, Feature dependence, Multi-label feature selection},
abstract = {In multi-label feature selection, the complex interactions between features and labels make redundancy modeling particularly challenging. Most existing methods mainly focus on feature-side redundancy, while ignoring its dynamic dependence on label contexts and the influence of selected features on label dependency structures. To address this issue, this paper proposes DRM-MLFS, a dual-perspective redundancy minimization method for multi-label feature selection. The proposed method introduces feature-dependent residual label redundancy and integrates feature-side information contribution, feature-side redundancy, and label-side residual structural redundancy into a unified greedy selection framework. By jointly optimizing discriminative information and the feature-based explanation of label co-occurrence structures, DRM-MLFS selects a compact feature subset that can better capture useful label correlations in the feature space. Experiments on multiple real-world datasets demonstrate that DRM-MLFS achieves competitive performance compared with representative multi-label feature selection methods.}
}
@article{WANG2026116444,
title = {Siameformer: Towards a robust source camera identification method on lossy images},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116444},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116444},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011706},
author = {Bo Wang and Jiaqi Chi and Weiming Zheng and Fei Wei and Yi Li},
keywords = {Source camera identification, Multi-head attention, Siamese network, Vision transformer},
abstract = {Source camera identification (SCI) is a common problem in digital forensics, aiming to identify the source device of given images. Traditional digital image source forensics are primarily conducted in original scenarios. However, in real-world scenarios, digital images disseminated through social networks are often subjected to various complex interferences, leading to a significant decline in the performance of existing image source forensic methods. To address the issue of network image source forensics in real-world scenarios, we propose a network image source forensics method called Siameformer. This method integrates a multi-head attention-based Siamese network with convolutional neural networks (CNN) and Vision Transformers (ViT) for image source identification. We designed comprehensive experiments, and our model achieved satisfactory performance on benchmark public databases (such as Dresden, VISION, and Forchheim).}
}
@article{YI2026116646,
title = {A Novel Method for Robust Fault Diagnosis in Hydropower Units Using Multi-Sensor Fusion and Graph Hierarchical Clustering},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116646},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116646},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013729},
author = {Tongqiang Yi and Yongjie Shi and Yang Meng and Wenyang Lei and Jiang Guo},
keywords = {Hydropower units, Fault diagnosis, Graph Hierarchical clustering, Multi-dimensional correlation fusion},
abstract = {The early fault characteristics of hydropower units are easily masked by noise, while traditional single-sensor approaches suffer from limited information dimensions, and the nonlinear coupling between multiple sensors leads to information redundancy, making it challenging to capture spatiotemporal coupled features and posing significant challenges for fault diagnosis. This paper proposes a novel fault diagnosis method for hydropower units based on multi-sensor fusion and graph hierarchical clustering (MSF-GHC). The MSF-GHC introduces three key innovations: (1) An adaptive multi-modal preprocessing framework for multi-sensor signals in hydroelectric units that suppresses noise while preserving fault features through characteristic-aware mechanisms and dynamic threshold adjustment; (2) A dual-representation feature extraction strategy that combines TS-DCNN for time-domain dynamic characteristics with GADF-RCNN for nonlinear temporal pattern representation in hydroelectric equipment, integrated through an attention-driven dynamic fusion mechanism; (3) A multi-dimensional correlation fusion sensor relationship graph and hierarchical graph learning architecture that characterizes complex sensor relationships in hydroelectric systems by integrating linear correlation, frequency-domain coupling and transfer entropy-based causal dependencies, thereby achieving transformation from microscopic sensor data to macroscopic system states through differentiable pooling. Experimental results demonstrate that the proposed MSF-GHC achieves 100% diagnostic accuracy without added noise while maintaining 88.86% accuracy in high-noise environments (-10dB), with an average PDR of only 3.1%, significantly outperforming existing methods in both feature representation capability and noise robustness.}
}
@article{LIU2026116642,
title = {VMoE-SGAE: A Variational Mixture-of-Experts Auto-Encoder for Signed Graph Representation Learning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116642},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116642},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013687},
author = {Xueyan Liu and Yonghe Gu and Zhuoran Duan and Wenzhuo Song and Bo Yang},
keywords = {Signed networks, Mixture-of-Experts, Variational auto-encoder, Link sign prediction},
abstract = {Signed graph representation learning is essential for complex network analysis but is challenged by edge-semantic heterogeneity and structural sparsity. Existing uniform aggregation schemes inadequately capture diverse relationships among edges of the same sign, whereas discriminative methods underuse the topology encoded in unobserved node pairs. This study aims to propose a Variational Mixture-of-Experts Auto-Encoder for Signed Graph Representation Learning (VMoE-SGAE), which decomposes a signed graph into positive and negative subgraphs and employs multiple variational experts to capture heterogeneous structural patterns. A gating network adaptively integrates expert representations, whereas adjacency reconstruction exploits both observed and unobserved links. Multi-expert contrastive learning further promotes semantic consistency while preserving expert diversity. Experiments on real-world signed networks show that VMoE-SGAE consistently outperforms competitive baselines, achieves state-of-the-art link sign prediction performance, and benefits from all key components.}
}
@article{ABBASI2026116670,
title = {SBERT-HCube: A hypercube-based multimodal graph transformer for semantic behavior analysis in IoT networks},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116670},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116670},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013961},
author = {Mahsa Abbasi and Nahideh DerakhshanFard and Ali Ghaffari},
keywords = {Internet of Things, Anomaly detection, Multimodal data fusion, SBERT, Hypercube embedding, Graph transformer},
abstract = {Internet of Things (IoT) networks present significant challenges for behavior analysis, continuous monitoring, and semantic anomaly detection due to the massive volume of multi-source data, diverse modalities, and high temporal variability. Key issues such as aligning sensor and numerical inputs, interpreting textual messages, and detecting gradual behavioral drifts highlight the lack of a comprehensive and interpretable multimodal solution. In this study, we propose SBERT-HCube, a hybrid deep learning framework that integrates SBERT-based semantic embeddings, a multidimensional hypercube representation space, and dual-stream transformer modules graph-based and temporal to enable adaptive modeling of IoT node behavior. The framework processes numeric, sensory, and textual data in parallel and combines them through a multimodal attention fusion module to construct dynamic behavioral graphs. These graphs are then used to extract joint embeddings for semantic clustering, anomaly detection, and drift prediction. Experimental evaluations conducted on four benchmark datasets SWaT, WADI, SMAP, and MSL demonstrate that SBERT-HCube consistently outperforms state-of-the-art methods such as DDGCT, M-STGAT, and Stack VAE-G. For datasets without textual information (SMAP and MSL), the text branch was intentionally disabled, and the framework operated using the available numeric and sensor modalities only. It is important to note that the full text-numeric-sensor pipeline is applied only to SWaT and WADI, while SMAP and MSL are evaluated using numeric/sensor data only, as no concurrent textual logs are provided in these datasets. Specifically, the model achieved an F1-score of 0.9652 on SWaT, 0.9088 on WADI, 0.9587 on SMAP, and 0.9561 on MSL, along with correspondingly high precision and recall values. These results validate the model’s effectiveness in large-scale, noisy, and temporally dynamic environments, highlighting its potential for scalable, accurate, and interpretable behavior modeling in real-world IoT networks.}
}
@article{LV2026116521,
title = {FCDFusion: A noise-robust infrared and visible image fusion method based on Feature Coupling and Disentanglement},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116521},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116521},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012475},
author = {Ting Lv and Yu Liu and Hong Jiang},
keywords = {Image fusion, Infrared and visible images, Invertible neural networks, Denoising, Noise robustness},
abstract = {This paper proposes a noise-robust fusion method based on Feature Coupling and Disentanglement, called FCDFusion, designed to fuse multi-modal features while eliminating redundant information. The method emphasizes the removal of noise and the refinement of fusion features during the fusion process, rather than treating fusion and denoising as independent processes. Firstly, a Fusion and Denoising module based on Invertible neural networks (InvFD) is designed to achieve feature coupling and disentanglement for noise-robust fusion. This module considers noise as redundant information. Its forward process fuses the features of infrared and visible images, while the inverse process separates redundant information from the fusion features. Additionally, a multi-scale retrieval transformer (Msretmer) is developed to extract important features from multi-scale fusion features to refine the fusion features further, resulting in texture-rich and high-contrast fused images. Subsequently, through the collaborative efforts of InvFD and Msretmer, FCDFusion demonstrates superior noise robustness while generating visually satisfying fused images. Extensive experiments conducted on public datasets demonstrate the advantages of FCDFusion in both qualitative and quantitative evaluations.}
}
@article{XU2026116610,
title = {Earnings forecasting by LLMs enhanced via reinforcement learning with synthetic financial reports},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116610},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116610},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013365},
author = {Tao Xu and Zhe Piao and Tadashi Mukai and Yuri Murayama and Kiyoshi Izumi},
keywords = {Earnings forecasting, LLMs, Synthetic data, Financial model, Reinforcement learning},
abstract = {Earnings forecasting is an essential component of equity investment decisions, yet large language models (LLMs) still face challenges in performing such tasks effectively. This study proposes a new framework that enables LLMs to improve their forecasting capabilities through reinforcement learning with controllable synthetic data and a domain-specific reward function. The synthetic data are generated using the proposed method, which models firms’ earnings structures and assigns parameters under diverse economic conditions, enabling large-scale simulation of multi-period financial performance. The reward function is designed to encourage the LLM to conduct sufficiently thorough analysis and to produce forecasts that follow a logically valid process. To ensure that the logical structure of the forecast can be explicitly evaluated by the reward function, and to avoid computational errors, the LLM is instructed to express its forecasting formulas as executable Python code rather than directly reporting computed values. Experiments using both synthetic and real data demonstrate that the framework effectively enhances the earnings forecasting capability of the LLM. This study thus offers a promising pathway for incorporating LLMs into earnings forecasting, a core task in fundamental investment.}
}
@article{TATAROGLUOZBULAK2026116662,
title = {Bridging dynamics and semantics: A unified perspective on explainable Graph Neural Networks based stream reasoning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116662},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116662},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013882},
author = {Gözde Ayşe {Tataroğlu Özbulak} and Yash Raj Shrestha and Jean-Paul Calbimonte},
keywords = {Graph Neural Networks, Explainable artificial intelligence, Stream reasoning, Knowledge graphs},
abstract = {This paper presents a structured review of explainable stream reasoning with Graph Neural Networks (GNNs) in settings where graph structures and background knowledge evolve over time. Although prior work has advanced GNN modeling, temporal reasoning, and Knowledge Graph (KG) integration, the literature remains fragmented regarding how explanations should be generated, semantically grounded, and evaluated in knowledge-enriched graph streams. Existing studies provide limited guidance on how explanations should align with ontologies, preserve relational coherence, and remain stable under temporal evolution. As a review article, this paper provides a taxonomy-driven synthesis of GNN explanation methods, semantic integration patterns, and stream-oriented constraints rather than a new benchmark or deployment system. It analyzes how established explanation families apply to evolving, knowledge-enriched graphs and systematizes KG integration strategies for reasoning and explanation, including embedding-based, message-passing, neuro-symbolic, and KG-assisted approaches. The review also presents an implementation-oriented architectural roadmap illustrating how semantic constraints can be incorporated into temporal message passing. Building on this synthesis, the paper proposes knowledge-aware evaluation dimensions, including semantic fidelity, relational coherence, temporal semantic stability, and human/domain-centered alignment. Where possible, these dimensions are accompanied by illustrative formal metric definitions, while their standardization remains open. A bounded empirical feasibility illustration on temporally ordered healthcare graph data demonstrates the computability of selected dimensions. Representative use cases in healthcare, security, social media, and autonomous systems further illustrate how the proposed perspective can guide future research on trustworthy and semantically grounded GNN-based stream reasoning.}
}
@article{HAI2026116606,
title = {Discord: Enhancing knowledge distillation via cross-chain of thought and optimal transport alignment between models with different tokenizers},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116606},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116606},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013328},
author = {Nam Le Hai and Anh Duc Le and Tu Vu and Linh Ngo Van},
keywords = {Knowledge distillation, Different tokenizers, Chain-of-thought, Optimal transport},
abstract = {Large Language Models (LLMs) achieve state-of-the-art performance across various NLP tasks but face deployment challenges due to high computational costs and memory constraints. Knowledge distillation (KD) is a promising solution, transferring knowledge from large teacher models to smaller student models. However, existing KD methods often assume shared vocabularies and tokenizers, limiting their flexibility. While approaches like MultiLevelOT, Universal Logit Distillation (ULD) and Dual-Space Knowledge Distillation (DSKD) address vocabulary mismatches, they overlook the critical reasoning-aware distillation aspect. To bridge this gap, we propose Discord, a universal KD framework that integrates Chain-of-Thought (CoT) augmentation and introduces Cross-CoT Alignment to enhance reasoning transfer. Additionally, we extend Optimal Transport beyond token-wise alignment to a sequence-level and layer-wise alignment approach that adapts to varying sequence lengths while preserving contextual integrity. Comprehensive experiments demonstrate that Discord outperforms existing KD methods across different vocabulary settings, improving reasoning capabilities and robustness in both domain-specific and cross-task scenarios.}
}
@article{WANG2026116658,
title = {Feature-based decoupled distillation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116658},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116658},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013845},
author = {Shuang Wang and Bin Chen and Qingyuan Zhu and Fuli Wu and Pengyi Hao},
keywords = {Knowledge distillation, Feature decoupling, Frequency domain},
abstract = {Feature-based knowledge distillation typically employs indiscriminate spatial alignment, implicitly assuming that all components within features are equally stable and transferable. In this work, we revisit this monolithic treatment through spectral analysis and reveal a clear feature heterogeneity across frequency bands: low-frequency components exhibit high cross-network consistency and resilience to perturbations, capturing stable, model-agnostic semantics, while high-frequency components show low similarity and sensitivity, encoding model-specific patterns and fine-grained details. Building on this finding, we propose Feature-based Decoupled Distillation, a divide-and-conquer framework that applies differentiated supervision to heterogeneous subspaces. Specifically, we introduce a content-adaptive decoupling module that leverages the teacher’s global magnitude spectrum as a stable prior to separate dominant low-frequency components and complementary high-frequency components. We then impose rigid point-wise alignment on the low-frequency component to preserve semantic consistency, while adopting a relaxed energy-statistic matching objective for the high-frequency component to maintain the student’s architectural flexibility. Extensive experiments on CIFAR-100, ImageNet, and MS-COCO validate the efficacy of our method and its strong generalization across architectures and tasks. Our code is available at: https://github.com/cloak-s/FDD.}
}
@article{JUNG2026116634,
title = {Non-hierarchical multi-output multi-fidelity Gaussian processes using a structure-aware composite kernel},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116634},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116634},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013602},
author = {Yongsu Jung and Youngseo Park and Ikjin Lee},
keywords = {Multi-fidelity surrogate modeling, Multi-output Gaussian processes, Mahalanobis distance, Composite kernel},
abstract = {Multi-fidelity surrogate (MFS) modeling is crucial for alleviating computational burdens in engineering design. However, existing frameworks for multi-output systems often overlook the inter-output correlations inherent in low-fidelity (LF) sources. To address this limitation, this paper proposes the structure-aware multi-output multi-fidelity (S-MOMF) framework, which explicitly leverages these correlations. A linear model of coregionalization (LMC) is employed to characterize the output dependencies within each LF source. Subsequently, a composite kernel is formulated to incorporate this structural information into the high-fidelity (HF) model by leveraging the LF task covariance structure as a metric via the Mahalanobis distance. To ensure scalability and parameter efficiency, input fusion and parameterized task covariance strategies are integrated. Numerical benchmarks and a photolithography simulation in semiconductor manufacturing indicate that the proposed approach can improve predictive accuracy and robustness when informative LF inter-output covariance is available.}
}
@article{MO2026116598,
title = {PathSymphony: Harmonizing symbolic planning and Large Language Models for curriculum-guided mathematical reasoning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116598},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116598},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013249},
author = {Mingqiao Mo and Hao Zhang and Yunlong Tan and Bo Huang and Chengcheng Li},
keywords = {Symbolic reasoning, Monte Carlo Tree Search, Multi-level planning, Mathematical problem solving, LLM evaluation},
abstract = {Large Language Models (LLMs) have demonstrated strong capabilities in arithmetic computation and short-form reasoning, effectively handling basic math operations, simple logical inference, and causal relationships in language, exhibiting notable generalization and adaptability. However, most existing methods rely on fixed-level reasoning steps, heavily depend on heuristic or introspective supervision, and lack tight integration between planning and learning, often resulting in suboptimal performance. To address these limitations, we propose PathSymphony, a plug-and-play framework that enhances LLMs’ reasoning via symbolic planning, multi-level search, and trajectory-based self-evaluation. PathSymphony comprises three core components: (1) math-level Monte Carlo Tree Search (MCTS) for symbolic trajectory exploration; (2) an adaptive branching strategy with solution-state merging to reduce redundant reasoning; and (3) a triple-critic system leveraging semantic, structural, and outcome feedback to assess stepwise reasoning quality. To evaluate our approach, we introduce Math-Level MCTS OlympBench (MMO), the first bilingual, multimodal dataset with 1266 Olympiad-style proofs, including diagrams, symbolic reasoning trajectories, and expert solutions. Experiments show consistent improvements across all models, with up to 24.06 % average gain for O3-mini and 13.3 % increase even for the weakest Gemini Pro.}
}
@article{XIE2026116650,
title = {NeuroSymbolic-Chain: A neuro-symbolic framework for intelligent disaster chain analysis from multi-source text},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116650},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116650},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013766},
author = {Nengfu Xie and JingChao Fan and Lihua Jiang and Xin Wang and Xiaoli Wang and Hailong Liu and Huoguo Zheng and Zhibo Meng and Hao Wu and Xiaoxiao Li and Qianjie Lv and Yuyu Ren and Huanping Wu},
keywords = {Neuro-symbolic AI, Dynamic Causal Knowledge Graph, GraphRAG, Meteorological disaster chain, Logical hallucination mitigation},
abstract = {Under non-stationary climate conditions, meteorological disasters have evolved into complex cross-system cascading networks whose catastrophic impacts frequently stem from latent secondary disaster chains. Despite strong semantic comprehension, Large Language Models (LLMs) remain susceptible to logical hallucinations during long-chain reasoning because existing generative paradigms do not embed rigorous physical constraints in probabilistic text generation. To address this, we introduce NeuroSymbolic-Chain, a neuro-symbolic framework synergizing LLMs with Dynamic Causal Knowledge Graphs. This framework orchestrates a closed-loop neuro-symbolic iteration: LLM-Driven Knowledge Graph Construction employs Ontology-Guided Prompt Engineering (OGPE) to extract entities from heterogeneous text streams and construct and incrementally update a DCKG; Graph-Based Propagation Reasoning utilizes Topology-Aware GraphRAG and subgraph isomorphism to deduce implicit risk trajectories via historical motifs; and Graph-Guided Context Engineering formalizes immutable physical consistency rules into strict logical constraints, injecting them into the generative process to mitigate hallucinations at their source. To rigorously substantiate the methodological novelty of this closed-loop architecture, we conduct comprehensive mechanism-isolation and same-backbone analyses. Experimental results show that, compared with state-of-the-art baselines, NeuroSymbolic-Chain improves Chain Accuracy by 5.9% and reduces the Logic Violation Rate by 52.4%. The case study of the July 2023 extreme rainstorm in Beijing shows that the framework can identify structural risks (e.g., subgrade hollowing) missed by conventional models. These results support interpretable disaster-chain analysis for resilient urban planning.}
}
@article{WANG2026116574,
title = {Multi-layer Denoising Fusion Model for Multimodal Aspect-Based Sentiment Analysis},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116574},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116574},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013006},
author = {Yingqi Wang and Huifang Hu and Rui Zhai and Heng Zhang and Hongyu Han and Xiaomei Zou},
keywords = {Feature optimization, Hierarchical integration, Multimodal aspect-based sentiment analysis},
abstract = {Multimodal Aspect-Based Sentiment Analysis (MABSA) aims to jointly leverage textual and visual modalities to accomplish two primary subtasks: Multimodal Aspect Term Extraction (MATE) and Multimodal Aspect Sentiment Classification (MASC). Despite recent advancements, existing approaches frequently struggle with intermodal noise interference and inadequate cross-modal semantic alignment, thereby restricting their efficacy in complex multimodal scenarios. To address these critical limitations, we propose the Multi-layer Denoising Fusion Model (MDFM). This framework comprises three core components: a multi-encoder feature extraction module, an Adaptive Multilevel Information Denoising (AMID) module, and a Hierarchical Cross-Modal Fusion (HCF) module. First, within the AMID module, we design a Mutual Information Denoiser (MID). By coupling mutual information maximization with a noise detection network, the MID effectively suppresses irrelevant noise while enhancing task-relevant features. Subsequently, progressive noise suppression is achieved by cascading multiple MID layers equipped with dynamically learnable weights. Second, the HCF module adopts a dual-level fusion strategy: a shallow fusion stage utilizes bidirectional mutual attention for fine-grained modal alignment, whereas a deep fusion stage facilitates profound cross-modal interaction and multi-scale aggregation via an enhanced Tri-Transformer architecture. Third, to establish robust and complementary multimodal representations, the feature extraction module integrates BERT and CLIP text encoders for the textual layer, alongside ViT and CLIP image encoders for the visual layer. Extensive experiments conducted on two benchmark datasets (Twitter-2015 and Twitter-2017) demonstrate that MDFM significantly outperforms state-of-the-art baseline models across the MATE, MASC, and comprehensive MABSA tasks.}
}
@article{XU2026116626,
title = {Adaptive adversarial interpolation for diffusion-based facial privacy protection},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116626},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116626},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013523},
author = {Zhifeng Xu and Yiru Zhao and Lei Zhao},
keywords = {Privacy protection, Diffusion model, Adversarial attack, Face recognition, Adversarial purification},
abstract = {Deep learning-based Face Recognition (FR) systems have achieved significant accuracy and efficiency, but their widespread deployment raises concerns about unauthorized identity tracking and privacy infringement. To prevent unauthorized FR systems, previous works have proposed various adversarial attack methods to protect face images. Inspired by the generative capabilities of diffusion models, recent methods have employed them to generate adversarial face images for privacy protection. However, the diffusion purification effect can weaken their protective performance. Although some studies attempt to mitigate this, they still require excessive adversarial iterations to achieve satisfactory privacy preservation. In this paper, we propose an adaptive adversarial interpolation-based facial privacy protection method. Unlike previous methods that directly optimize the diffusion latent representation, our approach optimizes an interpolation matrix that constructs the protected image’s latent representation by interpolating between the diffusion latent representations of the original and target images. To achieve effective privacy protection while preserving image structure and quality, we design an adversarial loss composed of multiple surrogate FR models and a structural consistency loss implemented through self-attention modules. The experimental results show that, under the same datasets and settings, our method achieves an average protection success rate of 86.84% while maintaining an FID score of 12.5, demonstrating the effectiveness of our method in facial privacy protection.}
}
@article{ZHANG2026116586,
title = {Dual-Gradient Co-optimization for Robust Physics-Informed Neural Networks},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116586},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116586},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013122},
author = {Zhuo Zhang and Sen Zhang and Seongwon Kang and Xi Yang and Dongseok Kim and Yifu Gao and Canqun Yang and Chongam Kim},
keywords = {Physics-Informed Neural Networks, Deep learning, Partial Differential Equations, Scientific machine learning, Optimization},
abstract = {Physics-Informed Neural Networks (PINNs) are innovative, mesh-free approaches for solving Partial Differential Equations (PDEs). However, PINNs frequently suffer from loss imbalance – where gradient magnitudes of the PDE residual and the boundary/initial losses differ by orders of magnitude – and from unstable internal gradient propagation, both of which slow convergence or trap training in suboptimal solutions. Existing gradient-statistics-based weighting methods rebalance loss magnitudes but typically operate at the level of aggregate loss weights, addressing neither internal gradient propagation nor the heterogeneous difficulty among individual initial and boundary conditions. To address these gaps, we propose Dual-Gradient Co-optimization Physics-Informed Neural Network (DGCO-PINN), a framework with dual dynamic adjustment. DGCO-PINN optimizes internal parameter gradient flow via Hierarchical Gradient Enhancement (HGE) and external loss gradient flow via a two-stage gradient-statistics weighting strategy. This co-optimization quantifies per-condition difficulty, balances PDE-vs-condition gradient magnitudes, and allocates condition-side weights between IC and BC. Extensive experiments demonstrate DGCO-PINN’s significant superiority in both convergence speed and prediction accuracy over existing gradient-statistics-based methods.}
}
@article{HUANG2026116602,
title = {FPL-AD: Fine-grained perception and localization for image anomaly detection},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116602},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116602},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013286},
author = {Liqin Huang and Haozhe Zhang and Hanyu Zheng and Mingjing Yang and Lin Pan},
keywords = {Image anomaly detection, Fine-grained defects, Feature sensitivity, Pseudo-anomaly synthesis},
abstract = {Image anomaly detection (IAD) aims to identify abnormal images and localize their defective subregions. In real industrial scenarios, abnormal samples are often difficult to collect, while image backgrounds and textures are diverse and complex. Consequently, existing methods still struggle to accurately perceive and localize fine-grained defects under such constraints. This difficulty mainly arises from limited sensitivity to subtle feature deviations and coarse decision boundaries induced by the absence of abnormal samples. To address these issues, we enhance the signal-to-noise ratio of subtle-defect regions and introduce discriminative references near decision-boundary regions. Specifically, we adopt a multi-factor gated fusion strategy to increase the model’s sensitivity to subtle feature deviations. Meanwhile, we synthesize boundary-aware pseudo-anomalies to encourage a decision boundary that better reflects the true data distribution. The model achieves PRO scores of 97.4 and 97.3 on the screw and leather categories of MVTec AD, respectively, and maintains consistently strong results across four public datasets. These results demonstrate its ability to reliably perceive and localize fine-grained defects, even in texture-dense or boundary-adjacent regions.}
}
@article{YANG2026116675,
title = {VEI-Agent: Generating Visual Exploratory Interfaces for remote sensing image interpretation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116675},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116675},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014012},
author = {Lei Yang and Qi Ma and Liangkai Fu and Bing Liu and Xiaohui Chen and Fangfang Zhou and Ying Zhao},
keywords = {Remote sensing, Exploratory interpretation, Large language model, Visual interactive interface},
abstract = {Exploratory interpretation of remote sensing (RS) images is an open-ended process that requires users to flexibly explore image content across multiple perspectives and scales. Although recent large language model-based RS (LLM-RS) methods enable natural language-driven interpretation, they mainly rely on text-only dialogue. This interaction paradigm is inefficient for exploratory interpretation because users must repeatedly reformulate queries to traverse perspectives and scales and integrate fragmented information. To address this limitation, we identify three fundamental patterns of exploratory RS interpretation and propose the Visual Exploratory Interface Agent (VEI-Agent) to support them. Given an RS image and a user instruction, VEI-Agent generates an adaptive, multi-view interface that supports graphical interaction across perspectives and scales. Specifically, it adopts an LLM-centered architecture. Image information is extracted and mapped into the language space, where the LLM jointly reasons over the image information and user instruction to generate textual interpretations and interface design decisions. These decisions are rendered into an interactive interface composed of coordinated texts, tables, and charts with language-driven adaptability. Comprehensive experiments demonstrate that VEI-Agent outperforms existing LLM-RS methods in terms of interpretation quality and interaction efficiency while substantially reducing the cognitive workload of users.}
}
@article{ZHAO2026116630,
title = {CGDM: Cross-Modality Gradient-Guided Diffusion Model for graph generation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116630},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116630},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013560},
author = {Jiachi Zhao and Yefang Chen and Yu Xin and Guoqing Li},
keywords = {Graph generation, Diffusion models, Generative model, Molecular design},
abstract = {Graph generation underpins applications from social network analysis to molecular design. Diffusion models are promising for graph generation but face a fundamental trade-off: in the graph modality they must handle high-dimensional, non-differentiable topology, making training and sampling costly; in the embedding modality they gain efficiency but compromise structural fidelity and graph validity. We propose the Cross-Modality Gradient-Guided Diffusion Model (CGDM), which decouples semantic and structural learning through a staged training pipeline: an embedding diffusion model learns semantics, a graph denoising model learns discrete structural distributions, and a graph-embedding mapping module connects the two modalities. During sampling, these trained modules are kept fixed, and the graph branch guides embedding updates via gradients to inject structural priors into the embedding trajectory. CGDM further includes (i) a downsampling Transformer-based U-Net (TUD) for efficient, stable embedding denoising, (ii) a hybrid-noise scheme that accelerates structural learning and yields sharper discrete priors, and (iii) a transformer-based mapping module with Node-Distance Relation Self-Attention (NDRSA) to stabilize embeddings and align cross-modality guidance. On generic and molecular benchmarks, CGDM improves distributional fidelity and efficiency while maintaining competitive validity (w/o correction), outperforming diffusion and non-diffusion baselines.}
}
@article{SINYABE2026116615,
title = {FoodXLLM : An explainable deep learning-based food recommendation system},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116615},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116615},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013419},
author = {Ephraim Pagou Sinyabe and Corneille Vivient Kamla and Josiane Therese Metsagang Ngatchic and Igor Tchappi},
keywords = {Explainable artificial intelligence, Food recommender system, Large language models, Deep learning, Transparency},
abstract = {Food Recommender Systems (FRS) based on Deep Learning (DL) effectively predict user preferences using large amounts of structured and unstructured data. However, most architectures operate as “black boxes” due to limited or unintuitive explanations. Existing methods often rely on feature attribution or post-hoc counterfactual reasoning, which may fail to provide user-friendly justifications. Integrating explainability into FRS remains a significant challenge. This paper introduces an explainability module for a DL-based FRS using Large Language Models (LLMs), which leverage vast textual knowledge to understand and generate human language and context. Our approach incorporates LLMs to enrich the original dataset, enabling more nuanced interpretations of dietary recommendations by better capturing relationships between users, recipes, and user-recipe interactions. Using these relationships, the FRS inputs and outputs are then used to generate explanations for its recommendations. Experiments on two large-scale benchmark datasets demonstrate the effectiveness of the explainable DL-based FRS. The RMSE values achieved are 0.5985 and 0.3179, outperforming DL-based FRS without explainability. These results highlight the importance of integrating explainability into FRS to improve both predictive accuracy and interpretability.}
}
@article{ZHOU2026116667,
title = {Mechanism-centric cross-domain retrieval for scientific discovery: LLM agents for structural isomorphism beyond semantic similarity},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116667},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116667},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013936},
author = {Huajun Zhou and Guozhu Jia},
keywords = {Cross-domain isomorphism, Mechanistic retrieval, LLM agents, Neuro-symbolic reasoning, Literature-based discovery},
abstract = {Cross-domain isomorphisms, the hidden structural patterns shared across disparate fields, are essential for driving interdisciplinary innovation. However, identifying these isomorphisms remains difficult amid information overload and knowledge silos, leaving many valuable connections buried. To address this, we propose the Mechanism-Centric Cross-Domain Retrieval Framework (MCDF), which integrates three components: (1) an Expert-Guided Mechanistic Schema of ten universal mechanism classes that drives 26 domain-specific agents to generate mechanistically equivalent keywords; (2) a Disentangled Dual-Evaluator that adversarially computes a Topic Relevance Score (TRS) and a Mechanism Alignment Score (MAS) to reduce metric contamination; and (3) the Isomorphic Serendipity Index (ISI), a ranking metric that couples a cross-domain gain term with a mechanism-gated rarity boost to reward high mechanistic alignment at maximal semantic distance. In two case studies (social rumor spreading and AI model collapse), MCDF retrieved high-fidelity mechanistic isomorphisms from distant disciplines, with an average MAS above 0.82, outperforming all six baselines (such as BM25, RRF, RankGPT, and Deep Research). The advantage held even against baselines sharing its GPT-4o backbone, indicating that the gains stem from architectural design rather than model scale. Human evaluation and ablation studies further confirm improved discovery serendipity without sacrificing structural validity. MCDF thus offers a scalable approach to automated cross-domain mining that activates latent knowledge to advance interdisciplinary innovation.}
}
@article{CAO2026116638,
title = {CPD-MVS: Tri-branch Fusion with a Calibrated Monocular Prior and Depth Attention for Multi-View Stereo},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116638},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116638},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601364X},
author = {Rui Cao and Wenting Li and Sen Tai and Ziyang Chen and Yang Zhao and Yabo Wu and Shida Zhao and Yongjun Zhang and Yong Xu},
keywords = {Multi-view stereo, Stereo matching, Deep learning, Geometric information, Feature fusion},
abstract = {Recent cascade multi-view stereo (MVS) methods achieve high-resolution depth estimation by extracting geometric cues from images. However, their coarse stage lacks scale cues and underutilizes monocular priors, leading to unstable cost-volume construction and unreliable matching, especially in challenging low-texture, highly reflective, and long-baseline scenes. To address these limitations, we propose CPD-MVS, an MVS network that leverages monocular geometric priors to enhance feature representations. Specifically, we design a Calibrated Monocular Prior (CMP) module built on a pretrained monocular depth model. It applies a learnable affine mapping over the depth range, so the calibrated prior provides explicit geometric cues in the image and reduces coarse-stage ambiguity. Furthermore, we propose a Tri-branch Top-Down Fusion Pyramid (TriFuse-Pyr) that performs stage-wise fusion by first aggregating geometric cues and then gradually injecting shallow RGB cues. To adaptively fuse geometric and RGB information, we construct a Cross-guided Channel Gating (XCG) network for multi-branch feature fusion, producing multi-scale features for cost-volume construction. Experimental results confirm that CPD-MVS delivers exceptional robustness across challenging scenarios. At the time of submission, our method achieved state-of-the-art (SOTA) performance on the DTU dataset and the Tanks and Temples (TNT) Advanced subset. On DTU, it achieved an overall score of 0.279 with a completeness of 0.227. Notably, on the more challenging TNT “Advanced” subset, our approach yielded a mean score of 43.46, ranking first on the official benchmark and outperforming existing SOTA methods. These results validate the effectiveness of our method in addressing textureless and reflective regions within complex scenes.}
}
@article{PANDEY2026116659,
title = {Multimodal learning with thermal imagery and pose cues for privacy-preserving behaviour recognition},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116659},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116659},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013857},
author = {Priyam Pandey and Alwin Poulose},
keywords = {Behaviour recognition, Human activity recognition (HAR), Multimodal learning, Feature fusion, Representation learning, Privacy-preserving recognition},
abstract = {This paper presents a comprehensive benchmark with multi-seed evaluation for unimodal and multimodal human activity recognition (HAR) using thermal imagery and 2D pose cues, addressing a gap in systematic evaluation of thermal–pose integration. The study is built on an extended and re-annotated version of the I2SAI Open Thermal Pose dataset. Two evaluation protocols are defined: a 6-class coarse-grained task and an 8-class fine-grained task, targeting privacy-preserving recognition in low-visibility environments. For pose-based recognition, the transformer-based PoseFormer achieves the best standalone performance, reaching 75.03% accuracy in the 6-class setting and 63.96% in the 8-class setting. For thermal-based recognition, convolutional models demonstrate strong and stable performance, with ResNet50 attaining 86.05% and 82.87% accuracy across the two tasks. Lightweight architectures such as MLP (pose) and EfficientFormerV2-S0 (thermal) exhibit robust performance with low variance across multiple random seeds, making them suitable backbone candidates for multimodal fusion. We introduce confidence-aware attention mechanisms for multimodal HAR. Confidence-Gated Cross-Attention enables reliability-controlled cross-modal interaction. Building upon this design, the proposed Confidence-Gated Hierarchical Co-Attention introduces hierarchical refinement and dual-modality reliability modelling, representing the main proposed fusion mechanism of this work. Confidence-Gated Hierarchical Co-Attention achieves the strongest overall multimodal performance in the 6-class configuration (86.18%), whereas Confidence-Gated Cross-Attention delivers the strongest performance in the 8-class setting (84.15%). These confidence-aware attention mechanisms achieve competitive performance while improving stability and class-level balance under fine-grained class ambiguity. Overall, the benchmark confirms that integrating pose and thermal representations yields competitive performance with improved stability and balanced class-level behaviour relative to unimodal baselines.}
}
@article{HE2026116671,
title = {Determinacy-driven multi-label feature selection via representative label promotion},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116671},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116671},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013973},
author = {Xinyi He and Yonghao Li and Luhan Liu and Xin Qi and Wanfu Gao and Weiping Ding},
keywords = {Multi-label learning, Feature selection, Information theory, Label correlations},
abstract = {Multi-label feature selection aims to identify a compact and informative feature subset from high-dimensional multi-label data, thereby improving classification performance and generalization ability. Most of the existing information-theoretic methods that exploit label promotion attempt to explore the classification information that one label can offer to its related labels, but implicitly assume that all correlated labels are equally reliable sources of information. This assumption overlooks the fact that a label can more effectively promote the prediction of other labels when it is determined more strongly by a feature. To address this issue, we propose a novel multi-label feature selection method, termed Determinacy-Driven Promotion-Aware Multi-Label Feature Selection (DPMFS), which explicitly models label determinacy, information promotion and information distribution over the label space. Specifically, DPMFS introduces label determinacy to quantify the relative uncertainty reduction of each label enabled by a feature, and defines a promotion-aware relevance criterion that evaluates feature–label relevance through representative labels. Furthermore, an information distribution balancing mechanism is incorporated to align the accumulated classification information with label entropy, preventing excessive information concentration during feature selection. Experiments on eight real-world datasets demonstrate that the proposed method achieves competitive classification performance while maintaining moderate computational cost compared with eight baseline multi-label feature selection methods.}
}
@article{FERNANDEZMARTINEZ2026116558,
title = {A knowledge-based multi-agent framework for security control recommendation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116558},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116558},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012840},
author = {Carolina Fernández-Martínez and Shuaib Siddiqui and Vanesa Daza},
keywords = {Decision support systems, Knowledge graphs, Information security, Multi-agent influence diagrams, Game theory, No-regret learning},
abstract = {Hardening IT on-premises environments can be a daunting task for teams without access to adequate cybersecurity expertise. In this regard, Decision Support Systems (DSS) with embedded expert knowledge can assist users by guiding them with security recommendations to meet their objectives. This work proposes a Security DSS that recommends security control sub-families given minimal user requirements indicating coverage of different security dimensions. It leverages a curated, unified dataset from both well-known Information Security (InfoSec) and academic sources. This DSS is defined as a non-zero-sum, simultaneous game that is grounded in a Multi-Agent Influence Diagram (MAID) model and explores the decision space over 7 security dimensions or agents, using no-regret online learning to ultimately find the security control sub-families that best fit the requirements while incurring minimal under- and over-provisioning of security resources. This work was validated in terms of performance and accuracy, among others, for varying dataset sizes. It shows exceptional satisfaction coverage results of 99% when using as little as ∼65% of the SW-implementable security controls, running in 1.2–35.7 seconds; and more moderate coverage results of 73%–77% when using ∼29% of the controls, resolving in 0.8–13.8 seconds.}
}
@article{YANG2026116595,
title = {Are heterogeneous graph neural networks truly effective for node classification? A causal perspective},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116595},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116595},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013213},
author = {Xiao Yang and Xuejiao Zhao and Zhiqi Shen},
keywords = {Heterogeneous graph neural networks, Node classification, Causal-effect},
abstract = {Graph neural networks (GNNs) have achieved remarkable success in node classification. Building on this progress, heterogeneous graph neural networks (HGNNs) integrate relation types and node and edge semantics to leverage heterogeneous information. Causal analysis for HGNNs is advancing rapidly, aiming to separate genuine causal effects from spurious correlations. However, whether HGNNs are intrinsically effective for node classification remains underexamined, and most studies implicitly assume rather than establish this effectiveness. In this work, we examine HGNNs for node classification from two perspectives: model architecture and heterogeneous information. We conduct a systematic reproduction across 21 datasets and 20 baselines, complemented by comprehensive hyperparameter retuning. To further disentangle the source of performance gains, we develop a causal mediation analysis framework that treats the introduction of heterogeneous relation information as the treatment, candidate structural properties as mediators, and node classification performance as the outcome. This framework first screens candidate mediators according to their treatment-induced changes and their associations with performance improvement, and then decomposes the total effect into mediated and direct effects. Our results lead to two conclusions. First, model architecture and complexity have no causal effect on node classification performance. Second, heterogeneous information exerts a positive causal effect primarily through increasing homophily and local–global distribution discrepancy, which makes node classes more distinguishable. The implementation is publicly available at https://github.com/YXNTU/CausalHGNN.}
}
@article{TUBISHAT2026116647,
title = {A novel flower pollination-based crossover for multi-objective LLM task scheduling problem},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116647},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116647},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013730},
author = {Mohammad Tubishat and Ahmed Shuhaiber and Sharif Naser Makhadmeh and Mohammed Azmi Al-Betar},
keywords = {Large Language Models (LLMs), Multi-objective optimization, Energy efficiency, Carbon emissions, SLA violations, Flower Pollination-Based Crossover},
abstract = {The rapid deployment of Large Language Models (LLMs) across cloud and edge infrastructures has intensified the need for efficient and sustainable inference scheduling. Unlike training, LLM inference involves high-frequency, latency-sensitive workloads that significantly contribute to energy consumption and carbon emissions. This paper formulates the LLM task scheduling problem as a multi-objective optimization model that concurrently minimizes energy usage, carbon footprint, and service-level agreement (SLA) violations across geo-distributed resources. To address the complexity of this NP-hard problem, a novel modified metaheuristic, the Flower Pollination-Based Crossover (FPC) algorithm, which extends the standard Flower Pollination Algorithm by incorporating a crossover mechanism to enhance convergence and solution diversity is proposed. Additionally, a comprehensive optimization framework that supports the comparative evaluation of eight metaheuristic algorithms is developed, including both single-objective and multi-objective variants. To facilitate reproducible evaluation and reflect real-world inference scenarios, three new LLM scheduling datasets, including LLM-1K, LLM-3K, and LLM-10K, are generated. Extensive experiments conducted on three LLM task datasets demonstrate the superior performance of FPC in achieving balanced trade-offs across energy, carbon, and SLA metrics. Results also highlight the strengths and limitations of various optimization strategies under dynamic, environmentally sensitive deployment conditions.}
}
@article{LIU2026116611,
title = {Poisoning knowledge graph-enhanced federated recommendation via hybrid suppression strategies},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116611},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116611},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013377},
author = {Yu-Hsiang Liu and Yi-Tzu Yao and Yu-Ting Pan and Chiao-Ting Chen},
keywords = {Federated learning, Recommender system, Poisoning attack, Hybrid suppression strategies},
abstract = {Federated recommendation is a privacy-preserving approach that trains recommendation models without collecting users’ raw data. The decentralized training process, which relies on limited local data, results in degraded model performance and increased susceptibility to poisoning attacks. To improve accuracy, recent studies combine federated recommendation with knowledge graphs, which provide rich semantic information to boost recommendation performance. However, this integration introduces new security risks. The structured and interconnected topology of knowledge graphs allows adversaries to distort semantic features, such as by injecting or removing triples, which severely compromises recommendation integrity. In this paper, we propose a novel Knowledge Graph-Enhanced Federated Recommendation system, and subsequently develop a targeted poisoning attack against it. Our method increases the exposure of target items by jointly manipulating user–item interactions and KG structures. The core of our approach is hybrid suppression strategies that demote popular items by injecting fake triples into the knowledge graph and flipping interaction labels in the recommendation model. Extensive experiments show that our poisoning attack strategies achieve an exposure rate 20% higher than the baseline on the Amazon Book dataset, while keeping the degradation in overall recommendation performance within 2%. Moreover, our approach generalizes well to the Movie dataset, demonstrating its effectiveness, robustness, and transferability across domains.}
}
@article{JIANG2026116663,
title = {Data-distribution-driven clustered federated learning with dual-perturbation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116663},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116663},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013894},
author = {Bendong Jiang and Shengnan Zhao and Jiyang Chen and Zhenxiang Chen and Chuan Zhao},
keywords = {Federated learning, Clustered Federated Learning, Data-distribution-driven clustering},
abstract = {Federated Learning (FL) enables collaborative model training without sharing local data, though its performance is often hindered by non-independent and identically distributed (Non-IID) data across clients. Clustered FL (CFL) attempts to address this by grouping clients through model parameter analysis. However, without prior knowledge of the cluster quantities, parameter-driven client dynamic clustering often yields inaccurate groupings that severely degrade model performance. In this study, we present FedPerturb, a novel CFL framework that introduces the first data-distribution-driven clustering paradigm, fundamentally departing from conventional parameter-based approaches. This framework enables clustering without requiring a predefined number of clusters by introducing a dual perturbation mechanism applied to the data distribution. The mechanism prevents the leakage of the original data distribution while maintaining the final clustering accuracy. After clustering, each client obtains a final model that integrates knowledge from both in-group and out-group models, aiming to enhance generalization performance. Experiments demonstrate that FedPerturb achieves superior clustering performance and model effectiveness across multiple datasets.}
}
@article{MASOUDISOBHANZADEH2026116684,
title = {GoalPath: A graph-based decision support system for soccer match analysis and goal-oriented path discovery},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116684},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116684},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014103},
author = {Yosef Masoudi-Sobhanzadeh and Sercan Saglam and Ali Kazemi Niari},
keywords = {Decision support system, Goal-scoring paths, Graph modeling, Metaheuristic algorithms, Player performance, Soccer analytics},
abstract = {Soccer is not only a sport and form of entertainment but also an industry and area of investment, attracting interest from multiple scientific fields. In particular, decision support systems can help analysts and coaches make more informed tactical decisions. Although considerable efforts have been made in this domain, prior studies often overlook how a team should be arranged and how it can create goal-scoring opportunities. To address these gaps, we introduce GoalPath, a decision support system that models a match as a graph and analyzes it using metaheuristic and graph traversal algorithms. Applied to 10 constructed real-world datasets, our results indicate that, within the GoalPath framework, the Trader metaheuristic outperforms other algorithms across multiple performance criteria, achieving approximately 90% success in discovering goal-scoring paths and a solution diversity of 2.5. Furthermore, first-half graph models reproduce second-half graphs with an average AUC of 73% across all datasets, and well-known teams tend to exhibit more stable tactical patterns. Beyond goal-scoring path discovery, GoalPath also provides recommendations for team arrangement and player substitutions that closely align with those observed in unseen real-world matches.}
}
@article{JIANG2026116639,
title = {ExCap: Entity-aware zero-shot image captioning via faithful synthetic image–text alignment},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116639},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116639},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013651},
author = {Qipeng Jiang and Zhiyue Liu and Wenkai Zhou and Jian Qin and Qingbao Huang and Jiahai Wang},
keywords = {Zero-shot image captioning, Data synthesis, Image–text alignment},
abstract = {Zero-shot image captioning (ZIC) aims to describe images without relying on human-annotated image-caption pairs. Recently, ZIC has incorporated text-to-image generative models to synthesize images conditioned on captions, thereby creating pseudo image–text pairs for training models. However, existing synthetic-image-based approaches are plagued by a critical flaw: semantic misalignment between synthetic images and their conditioning captions, particularly for missing vital visual entities described in the text. To address this issue, we propose ExCap, a zero-shot captioning framework built upon Entity Existence Judgment. By explicitly verifying whether text-described entities appear in synthetic images, ExCap provides a reliable measure of semantic fidelity. For the entity omissions, we introduce an Entity Missing Handling Mechanism that integrates entity-based re-pairing with entity-aware caption refinement, achieving more faithful image–text alignment within synthetic data. Furthermore, we design an Anisotropic Noise Injection strategy that enhances visual representation learning by injecting direction-aware noise into image features guided by semantic directions, thereby improving synthetic-to-real transfer robustness. Comprehensive experiments on benchmark datasets demonstrate that ExCap achieves state-of-the-art performance, producing more semantically consistent image descriptions.}
}
@article{XIA2026116635,
title = {LightRNN: A lightweight recurrent neural network for edge computing},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116635},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116635},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013614},
author = {Weihao Xia and Huachuan Wang and Junlong Ma and Chen Qiu and Guoqiang Wu and Ping Wang and Yongling Wu and James Lo},
keywords = {Recurrent neural network, Lightweight sequence model, Sequence classification, Sequence similarity compression, Edge computing},
abstract = {Edge computing enables data to be processed close to its source, but it also imposes strict constraints on latency, memory usage, and computational cost. Sequence classification is a common task in edge scenarios, including on-device text analysis, sensor-signal recognition, and lightweight time-series classification. Although recurrent neural networks such as Long Short-Term Memory (LSTM) and Gated Recurrent Unit (GRU) models are effective for sequential data, their gated transitions and step-by-step processing introduce considerable overhead, making them difficult to deploy on resource-constrained devices. To address this problem, this paper proposes LightRNN, a lightweight recurrent architecture for efficient sequence classification in edge-computing environments. The core component of LightRNN is the Sequence Similarity Process Unit (SSPU), which performs similarity-guided grouping and compression before recurrent processing. By aggregating sequential features into a shorter task-relevant representation, SSPU reduces the effective number of recurrent steps while preserving discriminative information for classification. A dynamic granularity schedule is further introduced to adjust the compression level during training. Experiments on text classification and UEA time-series classification datasets show that LightRNN achieves a favorable accuracy-efficiency trade-off compared with traditional recurrent networks and representative efficient sequence models. Across the evaluated settings, LightRNN substantially reduces training time, inference latency, memory usage, and FLOPs while maintaining competitive classification accuracy. A real-device experiment on a Raspberry Pi 4 Model B further demonstrates the practical potential of LightRNN for low-resource edge inference.}
}
@article{YANG2026116651,
title = {A survey on chatbot systems from rule-based models to system-integrated natural user interfaces},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116651},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116651},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013778},
author = {Wenli Yang and Byeong Kang and Jingxian Su},
keywords = {Chatbot, System-integrated, Natural user interfaces, Design principles},
abstract = {Chatbot systems have evolved from rule-based conversational tools to advanced data-driven systems that support more complex interaction. This paper examines this evolution and examines how advanced chatbot systems may function as System-Integrated Conversational Natural User Interfaces (System-Integrated Conversational NUIs). In this role, natural-language interaction serves as a user-facing interface to broader digital capabilities rather than only supporting conversational response generation. The paper provides a structured review of key stages in chatbot development, introduces the System-Integrated Conversational NUI as an interface-centred concept, and proposes a conceptual architecture and design principles for this expanded interface role. Key challenges and future considerations are also discussed, with particular attention to interaction quality, system complexity, responsible operation, and the coexistence of conversational and structured interface elements. This study provides a conceptual basis for analysing and designing advanced chatbot systems that support natural-language access to connected digital capabilities.}
}
@article{SUN2026116627,
title = {Multi-grained multi-label feature selection: Jointly towards semantic-aware and instance-specific features},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116627},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116627},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013535},
author = {Yan Sun and Hengpeng Xu and Zhenglu Yang and Jun Wang},
keywords = {Feature selection, Multi-grained learning, Semantic consensus, Instance diversity},
abstract = {Feature selection serves as the cornerstone of dimension reduction across various recognition tasks. Existing feature selection methods focus on the holistic representation of the learning target, overlooking its diverse-level descriptive characteristics inherent in semantics and instances. To address this limitation, we propose M2FS, a novel Multi-grained Multi-label Feature Selection framework that simultaneously models the global semantic-aware representation consensus and local instance-specific representation diversities. Specifically, M2FS employs a semantic consensus matrix to extract coarse-grained semantic correlations and an inconsistent instance indicator to identify the instances requiring specialized descriptive features. These components are seamlessly integrated into a unified optimization framework, guiding the selection of discriminative features across multiple granularities. Extensive experiments on a wide range of benchmark datasets show that M2FS achieves competitive performance, and often favorable results, relative to the compared methods under the adopted evaluation protocol, highlighting its effectiveness in identifying informative features for constructing discriminative representations of the learning target.}
}
@article{WEI2026116643,
title = {Causal contrastive learning for generalizable graph classification},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116643},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116643},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013699},
author = {Baohang Wei and Yingji Li and Ying Wang},
keywords = {Graph neural networks, Causal inference, Contrastive learning, Graph classification},
abstract = {Graph classification is a fundamental task with broad real-world applications. Although graph neural networks (GNNs) can effectively model graph structures and node attributes, they often rely on spurious correlations between the input graphs and labels, which undermines robustness and generalization under distribution shifts. Recent studies attempt to address this issue by partitioning graphs into causal and shortcut subgraphs. However, such hard partitioning may disrupt the intrinsic graph structure and lead to the loss of important structural information. In addition, existing methods often focus on limited causal relations and thus fail to capture diverse semantic causal factors. To address these limitations, we propose Graph Causal Contrast Decoupling Learning (GCCDL), a framework for generalizable graph classification. Specifically, we design a multi-causal attention module to generate multi-mode graph views, enabling the model to capture distinct semantic causal features. We further incorporate a DropKey regularization mechanism into the attention process to improve structural robustness. Moreover, a contrastive learning objective is introduced to disentangle causal features from shortcut correlations by constructing positive and negative pairs across multi-mode graphs. Extensive experiments on six benchmark datasets demonstrate that GCCDL consistently achieves competitive and often superior performance compared with strong baselines.}
}
@article{TANG2026116599,
title = {Visual-semantic alignment for cross-domain few-shot object detection via multimodal prototype calibration},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116599},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116599},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013250},
author = {Xiaofen Tang and Wenyue Liu},
keywords = {Cross-domain few-shot object detection, Visual-semantic alignment, Multimodal prototype calibration, Open-vocabulary detection, Vision-language models},
abstract = {Cross-domain few-shot object detection (CD-FSOD) aims to address the dual challenge of extremely limited target-domain annotations and pronounced domain shift. Although vision-language foundation models represented by GroundingDINO exhibit strong open-vocabulary detection capability, domain shift in cross-domain few-shot settings often undermines the effectiveness of pretrained priors. Moreover, category names alone are insufficient to provide adequate semantic supervision for cross-domain objects, while the misalignment between visual features and textual representations in the target domain further compromises prediction reliability. To address these issues, we propose PriMP, a multimodal prototype calibration method. Under a frozen foundation detector backbone, PriMP estimates visual prototype centers in closed form to explicitly characterize target-domain intra-class structure and mitigate representation bias caused by domain shift. In parallel, it constructs semantically enhanced textual prototypes by incorporating synonyms and natural-language definitions, thereby compensating for the semantic insufficiency of a single prompt under cross-domain conditions. In addition, an uncertainty-aware adaptive gating strategy is introduced to dynamically calibrate and fuse target-domain visual evidence with source-domain semantic priors in the logit space, thereby restoring degraded visual-semantic alignment under domain shift and enabling lightweight target-domain adaptation. Extensive experiments on multiple CD-FSOD benchmarks demonstrate that PriMP achieves significant and consistent improvements over conventional fine-tuning baselines. Moreover, the additional inference latency is only 0.79 ms per image, indicating low deployment overhead while preserving performance gains. These results show that multimodal prototype-based visual-semantic calibration effectively improves the cross-domain detection performance of foundation detectors under low-data conditions.}
}
@article{BARA2026116688,
title = {Think it, Run it: Autonomous machine learning pipeline generation via self-healing multi-agent artificial intelligence},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116688},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116688},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014140},
author = {Adela Bâra and Gabriela Dobrița and Simona-Vasilica Oprea},
keywords = {Autonomous data science, Multi-agent system, Code-grounded semantic analysis, ML pipeline automation, Self-healing systems, RAG},
abstract = {The purpose of our paper is to develop a unified multi-agent architecture that automates end-to-end machine learning (ML) pipeline generation from datasets and natural-language (NL) goals, improving efficiency, robustness and explainability. A five-agent system is proposed to handle profiling, intent parsing, microservice recommendation, Directed Acyclic Graph (DAG) construction and execution. It integrates code-grounded Retrieval-Augmented Generation (RAG) for microservice understanding, a Pareto-based multi-objective recommender that combines keyword relevance, semantic similarity, data compatibility, execution-history evidence, an adaptive learning from execution history and a self-healing mechanism using Large Language Model (LLM)-based error interpretation. The approach is evaluated on 150 ML tasks across diverse scenarios. The system achieves an 84.7% end-to-end pipeline success rate, outperforming baseline methods. It demonstrates improved robustness through self-healing and reduces workflow development time compared to manual construction. The paper introduces a novel integration of code-grounded RAG, explainable recommendation, self-healing execution and adaptive learning within a single architecture, showing that tightly coupled intelligent components outperform isolated solutions.}
}
@article{PANG2026116591,
title = {A dispersion-regularized normal image restoration network for anomaly detection and localization},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116591},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116591},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013171},
author = {Jingxuan Pang and Chunguang Li},
keywords = {Anomaly detection, Anomaly localization, Autoencoder, Normal image restoration},
abstract = {Reconstruction-based methods have been widely explored in industrial anomaly detection and localization. These methods typically train an encoder–decoder model on normal samples and detect anomalies using reconstruction errors. To distinguish between normal and anomalous patterns, these methods require the model to both accurately reconstruct normal patterns and avoid reconstructing anomalies. However, these two goals are usually conflicting. Specifically, a model that can accurately reconstruct normal patterns might also have the capability to reconstruct some anomalies, thereby causing missed detection. Conversely, a model that does not reconstruct anomalies might have limitations in reconstructing normal patterns, making normal patterns and anomalies indistinguishable. To address this conflict issue, we propose a novel method that utilizes an encoder–decoder model to consistently restore normal images, regardless of whether the input is normal or anomalous, thereby avoiding the conflict issue. We design a Dispersion-regularized X-shaped (DrX) network for normal image restoration. DrX uses two parameter-shared branches to process normal and synthetic anomalous images, respectively, forming an X-shaped structure. Through the joint optimization of these branches, DrX effectively learns to restore normal images from both normal and anomalous images. Moreover, we introduce a dispersion-based regularization (DR) strategy that forces features to distribute dispersedly in the feature space. This enables the decoder to establish restoration capabilities across a broad range of the feature space, enhancing the model’s generalization to unseen inputs. Additionally, we design an attention-guided feature restoration (AFR) module that restores normal information at feature levels. By incorporating this module into multiple feature levels, the model can more comprehensively restore normal information. Qualitative and quantitative experimental results verify the effectiveness of DrX in detecting and localizing anomalies.}
}
@article{GORSHENIN2026116680,
title = {FtFNN: Probability-informed Factor Fusion Neural Network for image classification in data-scarce regime},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116680},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116680},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014061},
author = {Andrey Gorshenin and Anastasia Dostovalova},
keywords = {Probability-informed neural networks, Architectural informing, Structural constraints, Factor analyzers, Feature fusion, Data-scarce regime, Small data, Image classification},
abstract = {The paper proposes a probability-informed approach to improving image classification in a data-scarce regime, specifically targeting small-scale training datasets. We introduce the Factor Fusion Neural Network (FtFNN) architecture, which implements multi-scale feature fusion based on a factor analyzer with additive and impulse noise components. This architecturally informed approach effectively imposes structural constraints on the data representation by embedding the mathematical properties of the factor model directly into the neural architecture, thereby providing informing during the learning process. The analytical properties of the factor analyzer, which theoretically substantiate the effectiveness of the probability informing, were explored. Specifically, the identifiability, unbiasedness, and consistency of the least-squares estimates for the factor model, as well as the relationship between these estimates and the cross-entropy (which is used as a loss function) parameter estimates, were established. These results confirm the correctness of the solution and justify the chosen type of informing. The algorithmic complexity of the FtFNN was also investigated. The FtFNN was tested on several open datasets (for example, Oxford Flowers, UC Merced, Oxford-IIIT Pet) for image classification. The FtFNN demonstrated superior performance compared to well-known classification networks including EfficientNet, MobileNet, ResNet, and Xception. The maximum increase in the Top-1 Accuracy reached 23.8% while the average accuracy of the baseline networks was 85.13%. The accuracy increase depends on the size and heterogeneity of the training set: the smaller and more heterogeneous the set, the higher the performance improvement. The largest increases in the Top-3 and Top-5 Accuracy metrics were 10.23% and 5.67%, respectively. The FtFNN classifier demonstrates superior performance as datasets become smaller and more heterogeneous, particularly in scenarios with a large number of classes. Furthermore, it was demonstrated that the probability-informed FtFNN could require fewer parameters, with a maximum reduction of up to 496,000 and an average reduction of 118,000.}
}
@article{AHMAD2026116603,
title = {Improved grey wolf optimization-based artificial neural network for irrigation need prediction},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116603},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116603},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013298},
author = {Zameer Ahmad and Mohd Adib Omar and Saqib Jamil and Nibras Abdullah and Sk. A. Shezan and Naveed Ahmad},
keywords = {Artificial neural network, Gray wolf optimization, Irrigation, Internet of Things, Water management},
abstract = {Efficient irrigation management in agriculture is key to optimizing water use, ensuring optimal crop health and productivity. Existing machine learning (ML) models demonstrate insufficient classification accuracy in classifying irrigation needs for various crops, motivating new methods. This study identifies a gap in using bio-inspired optimization algorithms and ML to enhance irrigation classification. This research develops a hybrid intelligent model combining the improved grey wolf optimization (IGWO) and artificial neural networks (ANN) to classify irrigation needs for different crops. IGWO employs an adaptive weighted position update strategy that assigns greater influence to the best solution during ANN weight initialization, effectively avoiding local minima traps and providing more consistent near-optimal parameter configurations compared to standard optimization approaches. The IGWO-ANN model is trained using crucial soil and environmental variables including soil moisture, air temperature, humidity, and soil temperature. The proposed model achieves a mean accuracy of 98.72% ± 0.44%, with precision, recall, F1-score, and AUC of 93.46% ± 1.32%, 99.43% ± 1.47%, 96.35% ± 1.25%, and 0.9994 ± 0.0009 respectively, evaluated across 10 independent runs to ensure statistical reliability. Additionally, the gradient-based fine-tuning phase requires only 0.44 s, indicating computational efficiency. The proposed model is benchmarked against 10 competing models including metaheuristic variants, deep learning architectures, and ensemble methods, demonstrating superior and statistically stable classification performance. The results reveal that the proposed IGWO-ANN approach enhances prediction reliability and reduces the limitations of standalone ANN models. Thus, the proposed model can significantly reduce water loss during the irrigation process and contribute toward sustainable agriculture and efficient water resource management.}
}
@article{WOJTULEWICZ2026116676,
title = {Improving noisy label learning via transition matrix estimation from feature embeddings},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116676},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116676},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014024},
author = {Mateusz Wojtulewicz and Piotr Duda and Dacheng Tao and Leszek Rutkowski},
keywords = {Noisy-label learning, Transition matrix estimation, Feature embedding geometry, Loss correction, Data-centric artificial intelligence},
abstract = {Learning in the presence of noisy labels remains a major challenge for modern machine learning systems. A central concept in this setting is the noise transition matrix, which encodes how clean labels are corrupted into noisy observations and enables principled loss correction. However, estimating this matrix is difficult when no clean labels, anchor points, or strong structural priors are available. In this paper, we propose an unsupervised framework that estimates the transition matrix directly from the geometry of feature embeddings obtained either from noisy-label training or from related pretrained feature extractors. Our approach exploits neighborhood consistency in the embedding space and introduces two complementary variants: Hard Neighbor Voting (HNV) and Soft Neighbor Voting (SNV). Both methods construct empirical confusion matrices without access to clean labels or anchor samples and estimate both the transition matrix and the global noise rate. Experiments on synthetic noise (MNIST, EMNIST, Fashion-MNIST, and Kuzushiji-MNIST) and real-world human label noise (CIFAR-10N) show that the proposed estimators improve direct transition-matrix recovery over the Anchor Points (AP) baseline in the studied settings. When integrated into standard training pipelines through loss correction, the resulting estimates can also improve downstream classification performance and remain competitive with representative state-of-the-art robust learning methods.}
}
@article{NING2026116631,
title = {Synergistic relation learning via difficulty-aware curriculum and conditional diffusion for few-shot knowledge graph completion},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116631},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116631},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013572},
author = {Yuchen Ning and Quansheng Dou and Huanling Tang and Bingxi Chen and Jinfang Xue and Xinyu Tang},
keywords = {Few-shot knowledge graph completion, Difficulty-aware curriculum learning, Conditional diffusion, Relation representation learning, Graph neural networks},
abstract = {Knowledge graph completion (KGC) aims to infer missing entities from existing triples in a knowledge graph. Few-shot knowledge graph completion (FKGC) focuses on long-tail relation scenarios where each relation has only a few support samples. However, existing FKGC methods largely treat training task organization and relation representation refinement as independent processes, leaving the interplay between inter-task difficulty variation and representation noise underexplored. To address the challenges of limited supervision, inter-task discrepancies, and noisy relation representations, this paper proposes SynRel, a difficulty-aware optimization framework for FKGC. A difficulty-aware scheduling algorithm adaptively adjusts training order by jointly exploiting prior statistical information and dynamic training feedback, with a continuous annealing mechanism for smooth easy-to-hard scheduling. A quality-aware selection mechanism reduces the interference of low-quality support-set combinations in relation induction. The model obtains initial relation representations through structural encoding and prototype learning, then incorporates difficulty as a conditional input into the diffusion process for adaptive denoising and refinement. Inference steps are dynamically adjusted according to task difficulty, allocating more refinement to harder tasks. Extensive experiments on NELL-One and FB15K-237 show that SynRel achieves better overall performance on most evaluation metrics. These results indicate that task difficulty can serve as a shared signal for coordinating curriculum scheduling and relation representation refinement within a unified difficulty-aware framework.}
}
@article{SHI2026116668,
title = {Modeling continuous condition shifts as manifold transport: A federated approach to fault diagnosis in unknown domains},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116668},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116668},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013948},
author = {Yaowei Shi and Kaiwei Liu and Meng Xu and Aidong Deng},
keywords = {Intelligent fault diagnosis, Unknown working conditions, Federated domain generalization, Manifold transfer, Data augmentation},
abstract = {Achieving reliable fault diagnosis under unknown working conditions remains a challenge for safety-critical industrial systems. Existing federated learning methods often fail to generalize due to severe statistical heterogeneity, leading to diagnostic performance bottlenecks and posing potential safety risks. To address this, a robust federated dynamic manifold transfer (FedDMT) framework is proposed for personalized fault diagnosis. Based on the principle of physical inertia, FedDMT introduces a residual neural drift mapping (RNSM) module to model working condition changes as a continuous transmission vector field, providing a reliable directional foundation for exploring the distribution of unknown working conditions. Additionally, the federated shift bank is constructed on the server to aggregate universal physical drift patterns. It then injects global drift patterns into the local model to generate uncertainty-aware counterfactual samples, which provide diverse feature representations and simulate random fluctuations. This ensures the model’s robust generalization capability across unknown target domains. Extensive experiments on three datasets demonstrate that FedDMT significantly outperforms existing state-of-the-art methods in diagnostic accuracy and system robustness, offering a reliable solution for risk-sensitive industrial collaborative maintenance.}
}
@article{WANG2026116644,
title = {CAM2-Net: Causally aware multi-modal learning for joint stroke lesion quantification and prognostic prediction from non-contrast CT and clinical data},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116644},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116644},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013705},
author = {Ziying Wang and Hongqing Zhu and Zhong Zheng and Ying Wang and Bingcang Huang},
keywords = {Acute ischemic stroke, Lesion segmentation, Prognostic prediction, Structural causal model, Multi-modal},
abstract = {Non-contrast CT (NCCT) serves as the frontline imaging modality for acute ischemic stroke assessment, yet its clinical potential is hindered by qualitative interpretation and overlooked causal relationships between imaging biomarkers and functional outcomes. We present CAM2-Net, a causally aware multi-modal multi-task network that jointly optimizes stroke lesion quantification and prognostic prediction by explicitly modeling causal pathways in NCCT and clinical data. The framework employs dual-path encoders to process multi-modal inputs, while addressing the critical challenge of spurious correlations through structural causal modeling. The framework introduces a causal ortho purifier for lesion quantification that suppresses non-causal imaging features through do-calculus-inspired orthogonalization, coupled with disentangled variational modeling for prognosis prediction to isolate clinically valid multi-modal interactions via latent intervention. It further incorporates a mixture-of-modality attention mechanism that dynamically weights cross-modal interactions according to their causal relevance. Experimental validation on multi-center datasets (public and proprietary) confirms improved lesion delineation and outcome prediction performance compared to existing methods, with ablation studies supporting the contribution of each causal component in the architecture.}
}
@article{WU2026116660,
title = {IDiffKG: Deterministic and implicit knowledge graph diffusion for recommendation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116660},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116660},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013869},
author = {Jinrong Wu and Lei Wang and Jiarui Wang and Xiaotong Wang and Kaifeng Wang},
keywords = {Recommendation systems, Knowledge graph, Implicit diffusion, Contrastive learning},
abstract = {Knowledge-aware recommendation benefits from external semantics, yet its effectiveness is often limited by noisy and task-irrelevant knowledge graph (KG) structure. Existing diffusion-based approaches provide a principled denoising perspective, but their stochastic reverse trajectories can introduce additional variance and weaken the preservation of recommendation-relevant relational patterns during KG reconstruction. We propose IDiffKG, a deterministic and implicit KG diffusion framework that addresses recommendation-oriented KG refinement through a non-Markovian reverse process. IDiffKG preserves the standard diffusion training objective while replacing stochastic reverse sampling with controllable deterministic reconstruction, calibrating reconstructed relations with collaborative signals, and aligning the original and reconstructed graphs through cross-view contrastive learning. This design makes diffusion explicitly recommendation-oriented rather than merely generative. Experiments on three public benchmarks from multiple domains demonstrate consistent improvements over representative baselines, with relative Recall@20 and NDCG@20 gains of up to 7.71% and 8.15%, respectively. Ablation and sensitivity analyses further indicate that deterministic reconstruction, collaborative calibration, and cross-view alignment play complementary roles, while the proposed formulation offers a controllable accuracy–efficiency trade-off. These results suggest that controllable, behavior-grounded KG refinement is an effective use of implicit diffusion for KG-based recommendation.}
}
@article{LIU2026116636,
title = {Knowledge data fusion via LLM for domain-specific small-sample causal discovery},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116636},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116636},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013626},
author = {Jintao Liu and Guang Jin and Siya Chen and Jun Fan and Yongming Han},
keywords = {Information fusion, Causal discovery, Large language model, Multimodal},
abstract = {In data-scarce and highly domain-specific scenarios, conventional data-driven methods often struggle to integrate abundant unstructured domain knowledge, thereby failing to uncover the latent causal relationships among variables. To address these limitations, this paper proposes a novel causal discovery framework based on large language models (LLMs), named INLLM-Cd, designed for multimodal heterogeneous information fusion to enable reliable causal inference. First, we construct a domain knowledge-guided causal reasoning chain-of-thought(CdCoT) that organizes potential causal relationships among variables through structured templates. This enables a systematic exploration of feature relationships under limited data conditions, which produces an initial causal hypothesis graph. Second, we introduce a weighted fusion strategy that combines statistical properties derived from structured data with domain-specific knowledge to strengthen the foundation of causal reasoning and improve the plausibility of causal assumptions. Third, we develop a weighted voting scheme based on cycle detection, thereby eliminating spurious or redundant causal edges. Finally, the refined causal graph is fed into the LLM to support flexible and interactive causal reasoning. Extensive evaluations on five benchmark datasets and three real-world domain-specific datasets show that INLLM-Cd substantially outperforms state-of-the-art methods (e.g., PC, Hillclimbsearch), achieving an average relative improvement of 84.45% in F1-score and a 62.39% reduction in Normalized Hamming Distance (NHD). By integrating structured data with unstructured domain knowledge, the INLLM-Cd framework offers a promising potential causal discovery approach under small-sample observational data scenarios.}
}
@article{MA2026116655,
title = {Wind power forecasting using ensemble learning based on coupled multiscale decomposition and regression enhancement},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116655},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116655},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601381X},
author = {Zilong Ma and Tiefeng Zhang and Ke Zhang and Jian Qian and Hao Sun},
keywords = {Knowledge-driven system, Hybrid intelligence, Signal decomposition, Time series prediction, Short-term forecasting},
abstract = {Accurate short-term forecasting of wind power time series is essential for grid safety and renewable energy dispatch. To address the inherent non-stationarity, nonlinearity, and stochasticity, this paper proposes a knowledge-driven hybrid forecasting framework that integrates coupled multiscale signal decomposition with ensemble learning, embodying a hybrid intelligence framework. Following a “decomposition–clustering–secondary decomposition–forecasting–reconstruction–correction” pipeline, the model embeds three types of domain knowledge: (1) knowledge-driven pattern aggregation using sample entropy and improved K-means clustering to group CEEMDAN-derived intrinsic mode functions (IMFs), reducing complexity while preserving frequency information; (2) adaptive optimization knowledge learning via an improved chaotic evolution optimization (ICEO) algorithm for autonomous XGBoost hyperparameter tuning; and (3) physics-informed error correction via a regression enhancement (REGRESS) module that applies piecewise weighted regression with hard physical constraints. Validated on a 99 MW wind farm dataset (75%/15%/10% split), the model achieves an MAE of 1.373 MW, RMSE of 2.278 MW, and R2 of 0.993, substantially outperforming mainstream benchmarks. This knowledge-enhanced framework offers a scalable, interpretable solution for time series prediction in wind power and renewable energy systems.}
}
@article{WANG2026116612,
title = {Learning group collaboration for efficient multi-agent reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116612},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116612},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013389},
author = {Qide Wang and Daxin Liu and Zhenyu Liu and Jianrong Tan},
keywords = {Multi-agent, Sequence decision-making, Agent grouping, Cooperative tasks},
abstract = {Sequence modeling provides a self-attention mechanism-guided full-scale communication for multi-agent decision-making, showing potential in cooperative tasks. However, message sharing among all agents involves redundant observations and computational overhead. When dealing with complex multi-agent systems, it becomes difficult to distinguish valuable information for collaboration under limited exploration, leading to poor action prediction. In this paper, we propose a novel framework named group-based Multi-Agent Transformer (g-MAT). Guided by the role-discovery mechanisms, it constructs a compressed communication topology and achieves an efficient sequential policy. Specifically, the agents are divided into several role-labeled groups according to the behavioral effects. Then, the hybrid attention layer is designed to model the high-level interrelationships among agents based on the grouping scheme, where the local information from teammates and global information from other groups helps to promote collaboration. Extensive experiments on the challenging benchmarks demonstrate the superiority of g-MAT across a variety of cooperative tasks, where agents are able to aggregate into explainable groups with less manual assistance and task priors.}
}
@article{ZHANG2026116588,
title = {SVD-TEA Fusion: SVD-based Texture-Enhanced Attention Network for High-Fidelity Surveillance},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116588},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116588},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013146},
author = {Laixian Zhang and An Liang and Yingchun Li and Hao Ding and Haijing Zheng and Rong Li and Rui Zhu and Huichao Guo and YiJin Wang},
keywords = {Infrared and visible light image fusion Singular Value Decomposition (SVD) Cross-attention mechanism Texture enhancement High-fidelity surveillance},
abstract = {Infrared and visible image fusion is essential for all-weather situational awareness, aiming to integrate thermal information with structural details. However, existing fusion paradigms often struggle to simultaneously account for thermal and structural features in high-precision scenarios, resulting in compromised edge fidelity and degraded textural details. To address these challenges, we propose SVD-TEA Fusion, a novel Texture Enhancement Attention Network based on Singular Value Decomposition. Specifically, an SVD-driven cross-attention mechanism is developed to decouple primary structural components from modal noise within a low-rank subspace, ensuring rigorous cross-modal feature alignment. In addition, a modality-differentiated dual-branch encoding architecture combined with a cascaded texture-guided enhancement network is designed to preserve thermal contours and explicitly inject high-frequency visible details, maximizing visual salience. Extensive experiments on the MSRS benchmark and self-built reconnaissance datasets demonstrate that SVD-TEA Fusion consistently outperforms state-of-the-art methods in both quantitative metrics and qualitative evaluations, confirming its superior performance in high-fidelity reconnaissance tasks.}
}
@article{SANTANA2026116640,
title = {Enhanced Vision Transformer-based diagnosis of pediatric appendicitis using GAN-based data augmentation on ultrasound images},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116640},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116640},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013663},
author = {Carlos Luis Fernández Santana and Gerardo Fernández Álvarez and Ricardo S. Alonso and Pablo Negre},
keywords = {Pediatric appendicitis, StyleGAN2-ADA, Swin Transformer, Vision Transformer, Ultrasound image classification, Synthetic data augmentation, Deep learning},
abstract = {Pediatric appendicitis is one of the most common surgical emergencies in children, yet its diagnosis remains challenging due to symptom variability and operator-dependent ultrasound interpretation. This study presents an automated diagnostic framework integrating synthetic ultrasound generation via StyleGAN2-ADA with a Swin Transformer classifier to support detection under data-scarce conditions. Using the Regensburg Pediatric Appendicitis dataset (578 patients; 1339 appendicitis and 382 non-appendicitis real images), we adopt a strict patient-level partitioning that prevents the leakage induced by image-level splits, train two class-specific generative models exclusively on training-set images, and benchmark the Swin Transformer against four convolutional baselines (ResNet50, DenseNet121, EfficientNet-B0, ConvNeXt-Tiny) using 5-fold patient-level cross-validation. Synthetic augmentation is evaluated at 0%, 50%, 100% and 200%, with significance assessed via bootstrap confidence intervals and McNemar’s test; given the class imbalance we report AUC alongside balanced accuracy, sensitivity and specificity. Synthetic realism is examined through Kernel Inception Distance (KID ≈0.013), nearest-neighbor anti-memorization analysis, a real-vs-synthetic discriminability test, and expert review. The effect of augmentation is nuanced: AUC remains essentially unchanged (test up to 0.75; cross-validated ≈0.70), so it does not increase discrimination, but it rebalances the classifier—improving specificity, balanced accuracy and the Matthews correlation coefficient, with the best balance around 100% synthetic data. Our findings show that image-level evaluation markedly overestimates performance, that the hierarchical Vision Transformer is competitive with – rather than superior to – convolutional baselines, and they delineate when GAN-based augmentation does or does not benefit ultrasound classification under a leakage-free protocol.}
}
@article{B2026116616,
title = {Enhancing human computer interaction with speech-gesture integration using TFST-Q},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116616},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116616},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013420},
author = {Thushara B. and Vishnupriya K. and Adithya V. and N.S. Sreekanth},
keywords = {Human–computer interaction, Multimodal interfaces, Speech-gesture fusion, Cognitive workload, Usability},
abstract = {Human computer interaction (HCI) has evolved from conventional input devices, such as keyboards and mouse, to natural and intuitive interaction through touch, speech, hand gestures, head movements, and other physiological signals. This evolution has focused on improving accessibility, inclusivity, and ease of use, particularly for users with diverse needs and abilities.. Among these modalities, speech has become widely adopted because it enables natural and hands-free interaction. However, speech-only interfaces often encounter reduced reliability and increased errors, particularly in noisy environments. This limitation motivates the use of multimodal interaction, which combines complementary input modalities to improve robustness and interaction performance. This paper proposes two multimodal interaction systems that integrate speech with hand gestures and speech with head gestures for screen-based tasks. A novel fusion technique, the tricolor finite state transducer with queue (TFST-Q), is introduced to effectively combine speech and gesture inputs. A shape manipulation application has been developed to evaluate the proposed speech-hand gesture and speech-head gesture interfaces and compare their performances with a baseline speech-only interface. The evaluation considers quality of service (QoS) metrics, including task completion time, error rate, and mental workload, as well as quality of experience (QoE) factors such as usability and learnability. Experimental results show that, although the multimodal interfaces require slightly longer task completion times, they significantly reduce error rates and cognitive workload while improving usability and learnability. These findings demonstrate the effectiveness of multimodal speech-hand gesture and speech-head gesture interfaces across a wide range of screen-based applications.}
}
@article{FU2026116677,
title = {Attribute–structure decoupled self-supervised learning for graph anomaly detection},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116677},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116677},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014036},
author = {Yun Fu and Jintang Li and Yuchang Zhu and Zibin Zheng and Liang Chen},
keywords = {Graph anomaly detection, Self-supervised learning, Graph Neural Network},
abstract = {Owing to the strong capacity for modeling complex structural dependencies among nodes, Graph Neural Networks (GNNs) have achieved notable success in Graph Anomaly Detection (GAD). Built upon message passing mechanisms, GNNs enhance node representations by aggregating information from similar neighbors. However, anomalous nodes often exhibit significant deviations from their local neighborhoods. On such anomalous graphs with high heterophily, message passing tends to mix node-specific information with conflicting neighborhood signals, resulting in indistinguishable node representations. To address this challenge, we propose ASD-GAD, an Attribute–Structure Decoupled self-supervised learning framework for GAD. Instead of jointly modeling node attributes and graph structure on the original graph, we decouple the graph into two complementary partial views: an attribute view and a structure view, suppressing the interference of anomalous edges and attributes on node representations, respectively. Building upon these two partial views, we further introduce an attribute–structure interleaved graph reconstruction strategy. By reconstructing each target modality from its complementary view, the model effectively filters out anomalous inputs in the original modality, resulting in cleaner reconstructed views and more discriminative anomaly scores. To alleviate the information loss introduced by graph decoupling, we further incorporate a complete–partial multi-view contrastive learning module. By explicitly aligning node representations from the two partial views with those from the original complete graph, the partial views can implicitly exploit the missing structural or attribute information. Extensive experiments on nine datasets demonstrate that ASD-GAD outperforms state-of-the-art methods by large margins. Our code is available at https://github.com/Yun-Fu/ASD-GAD.git.}
}
@article{LI2026116664,
title = {User-centered product defect insight and improvement: Integrating a time-sensitive product knowledge graph with a large language model},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116664},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116664},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013900},
author = {Qing Li and Chao Wang and Xiaoyan Jiang and Shuaiyong Xiao and Jie Lin},
keywords = {User-generated content, Product defects, Time-sensitive product knowledge graph, Large language model, Intelligent quality management},
abstract = {With the rapid growth of user-generated content (UGC), gaining product defect insights from the user perspective and developing actionable improvement plans have become increasingly important in intelligent quality management. However, most existing studies model UGC-based defect analysis as static text classification or sentiment analysis tasks. Such static modeling limits their ability to capture fine-grained differences in user perceptions across successive product iterations and to provide traceable evidence for engineering practice. To address these limitations, this study investigates how noisy UGC can be transformed into a structured, time-sensitive, and decision-oriented defect knowledge system. Accordingly, this paper proposes a user-centered framework for product defect insight and improvement. First, a time-sensitive product knowledge graph (TPKG) is constructed by integrating product version information with fine-grained user feedback and sentiment information, thereby organizing dispersed and unstructured UGC into traceable evidence paths. Second, a large language model (LLM) is integrated with the TPKG to develop an intelligent interaction system that enables engineers to retrieve defect evidence and generate evidence-grounded improvement plans through natural language queries. In this way, the proposed framework establishes an analytical pathway from defect identification and understanding to actionable improvement planning. A case study based on real-world vehicle data demonstrates the effectiveness of the proposed framework in defect localization, evidence traceability, improvement relevance, and engineering applicability, thereby supporting engineering decision-making. This study provides a feasible pathway for systematically leveraging UGC to obtain product defect insights and support product improvement in intelligent quality management.}
}
@article{CHEN2026116607,
title = {DCHD: Density clustering-based hallucination detection in large language models},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116607},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116607},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601333X},
author = {Jiaying Chen and Qiang Wu and Kangfan Du and Wei Jiang and Chao Wang and Kuiying Gu and Xusheng Du},
keywords = {Large language models, Hallucination detection, Semantic clustering, Trustworthy ai, Agricultural LLMS},
abstract = {Hallucination is a primary challenge for large language models (LLMs) in applications, particularly in high-stake domains, such as agriculture, healthcare, and education. Thus, hallucination detection, i.e., the identification of factually incorrect outputs, has become an important area of research. Although black-box methods are broadly applicable as they do not require access to models, their performance is often limited. Existing techniques generally rely on shallow semantic features or weak supervision, which restricts their ability to identify complex factual inconsistencies. We address these limitations by introducing density clustering–based hallucination detection (DCHD). Our key innovation is to reframe hallucination detection as a semantic anomaly-detection problem. DCHD implements this concept within a black-box framework by embedding generated responses into a high-dimensional space, where hallucinations are identified as low-density outliers. The proposed DCHD method is independent of internal modeling and external knowledge, which constitutes a key advantage of broad applicability and resource efficiency. We evaluated the proposed method on six representative datasets across different domains using six open-source large language models. Experimental results demonstrate that, compared with the well-known semantic entropy method, DCHD achieves an average relative improvement of 4.88% in AUC.}
}
@article{ZHAO2026116628,
title = {Multi-domain wavelet-decoupled convolutional network for fetal ultrasound nuchal translucency quality assessment},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116628},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116628},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013547},
author = {Lili Zhao and Bowen Luo and Jian Xu and Yuanyuan Xu},
keywords = {Fetal nuchal translucency image, Wavelet transform, Lightweight network, Consistency regularization, Quality assessment},
abstract = {Fetal ultrasound nuchal translucency plane quality assessment is essential for precise prenatal diagnosis, yet it remains challenged by ultrasound degradation such as speckle noise, operator dependent acquisition variability, and limited annotated data. Existing deep learning models often struggle to reconcile diagnostic accuracy, parameter efficiency, and robustness under edge deployment constraints. To address this problem, we propose WDC-Net, a Wavelet Decoupled Convolutional Network organized into three sequential steps: Haar DWT-based input decomposition, compact frequency-specific encoding, and consistency-regularized training. Each ultrasound image is first decomposed into low-, raw-, and high-frequency streams. These streams are then encoded by Wavelet Residual Pyramid Block encoders integrating spatial convolution with multi-domain wavelet pooling, after which PyramidFusion aggregates cross-frequency representations. Finally, a Teacher-Student framework with weak/strong augmentation improves robustness under limited annotations. This frequency-decoupled and consistency-regularized design enables more effective extraction of complementary anatomical structure and boundary information from limited fetal NT images for quality assessment. Compared to 25 classic computer vision and medical deep learning models, WDC-Net achieved 89.10% accuracy on a real-world quality assessment dataset of 776 samples using 6.06 M parameters and 0.43 GFLOPs. It achieved a better accuracy-efficiency trade-off than heavier encoder-based alternatives. On a public fetal ultrasound dataset of 1684 samples and a breast ultrasound dataset of 780 samples, WDC-Net achieved 98.98% accuracy and 98.71% accuracy, respectively. These results indicate that explicit frequency-aware architectural design can improve efficiency without sacrificing diagnostic accuracy, supporting point-of-care deployment. Code will be available at https://github.com/Cooing-code/WDCNet.}
}
@article{BAO2026116559,
title = {Quantifying and mitigating latent semantic divergence in multilingual large language models},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116559},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116559},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012852},
author = {Pengfei Bao},
keywords = {Cross-lingual information retrieval, Multilingual large language models, Semantic alignment, Representation learning, Low-resource languages, Contrastive learning},
abstract = {The presumed semantic alignment in Multilingual Large Language Models (mLLMs) is systematically violated by Latent Semantic Divergence (LSD), particularly for low-resource languages. We introduce two automated metrics—Cross-lingual Embedding Isotropy (CEI) and Retrieval Consistency (RC)—to quantify LSD using 50k parallel sentences per language pair from the UN Corpus. Experiments on mT5 and XLM-R show English-Swahili exhibits a macro CEI of 0.73 and RC@20 of 47%, versus 0.91 and 88% for English-French. We propose Domain-aware Contrastive Post-alignment (DCPA) – the first unsupervised, domain‑adaptive fine‑tuning method that explicitly repairs Latent Semantic Divergence without parallel data or full model retraining – improving biomedical CLIR nDCG@10 by 12.3% (to 0.74) on CLEF eHealth. Our findings frame LSD as a data-induced structural bias and offer a scalable mitigation strategy for equitable multilingual retrieval.}
}
@article{LIANG2026116604,
title = {Improving offline goal-conditioned reinforcement learning with pessimistic policy regularization},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116604},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116604},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013304},
author = {Baoxian Liang and Lihong Xu and Zhichao Deng},
keywords = {Goal-reaching problems, Reinforcement learning, Offline setting, Distributional model},
abstract = {Offline goal-conditioned reinforcement learning aims to learn policies that can generalize to diverse goals solely from static, pre-collected datasets. However, conventional methods often suffer from performance degradation due to function approximation errors on out-of-distribution states. To address these limitations, we propose Pessimistic Distributional Policy Regularization, a novel approach that combines a goal-conditioned value distributional model with a pessimistic policy regularization module. The distributional model aligns the learned value distribution with the underlying data distribution, while the regularization module encourages high-advantage actions and enforces conservative policy updates. Unlike previous approaches, our method eliminates the need for goal relabeling and ensemble value function architectures. Instead, it exploits the value distributional model to generate non-stationary signals that provide principled guidance for policy optimization. These innovations lead to superior generalization and training stability. Extensive experiments on diverse offline goal-reaching benchmarks demonstrate that our method learns more effective policies from static datasets than existing methods and achieves state-of-the-art performance in both state-based and pixel-based environments.}
}
@article{ZHENG2026116656,
title = {Diffusion-enhanced multi-perspective inconsistency modeling for graph anomaly detection},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116656},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116656},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013821},
author = {Xiwen Zheng and Xiaofeng Wang and Weiran Li and Shaoming Tang and Xianghui Zhang and Tianxiang Lv and Fang Zhou and Daying Quan},
keywords = {Graph anomaly detection, Graph neural networks, Self-supervised learning, Diffusion enhancement, Inconsistency modeling},
abstract = {Graph anomaly detection aims to identify nodes that deviate from normal patterns in graph-structured data and plays a critical role in applications such as cybersecurity and social network analysis. In real-world scenarios, anomalous behaviors often manifest as complex inconsistencies across multiple aspects, including structural patterns, attribute semantics, and connectivity scales, many of which can only be revealed under higher-order structural contexts. However, existing reconstruction-based methods remain limited in such settings, as they typically rely on single-view representations and have limited ability to capture higher-order structural dependencies and scale-aware node characteristics. To address these challenges, we propose DEIM-GAD, a diffusion-enhanced dual-view framework for graph anomaly detection with multi-perspective inconsistency modeling. Specifically, a diffusion-enhanced view is constructed via heat-kernel propagation to incorporate higher-order structural dependencies beyond local neighborhoods, thereby complementing the original graph view. Based on the dual-view representations, the proposed method explicitly models multi-perspective inconsistencies, including structural inconsistency, attribute deviation, and connectivity-scale disparity. These inconsistencies are further integrated through a unified scoring mechanism to enable comprehensive anomaly assessment. Extensive experiments on multiple benchmark datasets demonstrate that DEIM-GAD consistently outperforms state-of-the-art methods and achieves competitive computational efficiency. Our source code is available at https://github.com/GNNteam/DEIM-GAD.}
}
@article{FENG2026116696,
title = {SymfuseX: A framework bridging drug–target predictive modeling and target-specific molecular design via a symbiotic fusion mechanism},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116696},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116696},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601422X},
author = {Baoming Feng and Yanyan Li and Tiyao Liu and Zhifan Li and Bingru Liu and Qianqian Zhang and Junting Lyu and Kefeng Li},
keywords = {Symbiotic fusion mechanism, Multi-task unified framework, Drug–target interaction, Drug–target affinity, Molecular generation},
abstract = {Drug discovery requires learning from heterogeneous biochemical information while supporting both predictive reasoning and design-oriented molecular generation. Existing drug–target interaction and affinity models can achieve strong predictive performance, but the learned cross-modal interaction knowledge is typically optimized only for scoring and is rarely transformed into a reusable target-conditioned representation for downstream molecular design. To address this limitation, we propose SymfuseX, a unified framework built around a Symbiotic Fusion Mechanism that bridges drug–target prediction and target-specific molecular design. It integrates bidirectional conditional modulation, multi-path factorized fusion, and adaptive path weighting to model reciprocal preferences between drug and protein representations and to capture complementary interaction evidence from both raw and modulated features. Through this mechanism, SymfuseX not only improves cross-modal biochemical interaction modeling, but also explicitly learns a transferable target-conditioned latent representation that can be reused beyond predictive scoring. SymfuseX integrates graph-based drug structure, sequence-based protein context, and rule-derived chemical prior features within a unified predictive-to-generative pipeline. Experimental results on benchmark DTI and DTA datasets show that SymfuseX achieves strong and stable predictive performance across multiple evaluation settings. In addition, the transferred target-conditioned latent representation supports competitive target- specific molecular generation and facilitates the identification of plausible lead compounds with favorable drug-likeness and synthetic accessibility.}
}
@article{KE2026116531,
title = {Noise-robust multivariate time series anomaly detection via importance awareness},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116531},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116531},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012578},
author = {Wuping Ke and Guowu Yang and Yan Du and Liyuan Wang and Fumin Feng and Shuhang Gu and Desheng Zheng},
keywords = {Multivariate time series, Anomaly detection, Dimension importance-aware, Noise-robust, Generative adversarial networks},
abstract = {Multivariate time series (MTS) data are a vital source of operational insights in the industrial, healthcare and financial sectors. Anomalies in them often signal major failures, security breaches, or malfunctions. Existing deep-learning-based methods for multivariate time series (MTS) anomaly detection often handle all dimensions equally and overlooks two critical real-world challenges: anomalies are frequently localized to specific dimensions, and sensor data often contain dimension-specific noise. This undifferentiated approach can obscure crucial anomaly signals and compromise model robustness. To address these limitations, we propose a novel framework named dimensional importance-aware anomaly detection (DIAAD). DIAAD integrates a generative adversarial network (GAN) with a dimension importance-aware mechanism that dynamically assigns weights to each dimension. This mechanism quantifies dimensional importance based on the backpropagated gradients of the reconstruction loss, enabling the model to amplify the influence of salient dimensions while suppressing interference from noisy or irrelevant ones. Furthermore, we introduce an online anomaly diffusion strategy to enhance the temporal coherence of detection results. Extensive experiments on four public benchmarks demonstrate that DIAAD significantly outperforms state-of-the-art methods, verified by rigorous metrics including VUS-ROC and VUS-PR. Ablation studies and visualizations on synthetic data further validate the effectiveness of our proposed mechanisms. Our work underscores the critical role of dimensional awareness in MTS anomaly detection and provides a robust and interpretable solution for safety-critical applications. Code available at: https://github.com/ldxdy/DIAAD.}
}
@article{HE2026116689,
title = {Hear to reveal: Stealing keystroke content from keyboard acoustic side-channel},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116689},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116689},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014152},
author = {Zhiquan He and Zhihai Yang and Zicheng Cui and Yan Feng and Pinghui Wang and Zhiquan Liu},
keywords = {Keyboard snooping, Acoustic side channel attack, User security and privacy},
abstract = {With the widespread application of high-precision microphones in various smart terminals, attackers can eavesdrop on users’ keystroke content. Although existing attack strategies have made some progress in specific scenarios, they generally face practical deployment bottlenecks such as insufficient generalization ability and strong dependence on environment and data. To reveal the real threat of attacks based on sound signals, we propose a method for stealing keystroke content from the acoustic side-channel on keyboards, named HERO. First, we improve the ability to detect keystroke fragments from complex backgrounds through a multi-scale energy fusion strategy. Then, through self-supervised pre-training using spectral masking and feature reconstruction, HERO learns key representations from keystroke audio. Finally, we guide HERO to learn the distinguishing keystroke features based on discrimination tasks. In particular, labeled keystroke samples are used to improve HERO’s classification performance in the fine-tuning stage. Extensive experiments across mainstream keyboards demonstrate that HERO outperforms existing baselines on multiple evaluation metrics. Its robustness is further verified by varying noise levels, recording distance, recording position, and microphone type. In real-world scenarios, HERO achieves 97.5% accuracy in word input tasks and 93% accuracy in numeric password input tasks. Under a strict leave-one-out protocol with 18 participants, HERO achieves 91.48% average accuracy, demonstrating its promising cross-user generalization ability. These results validate HERO’s adaptability and attack effectiveness, highlighting the serious threat that keyboard acoustic side-channel attacks pose to user privacy.}
}
@article{SALGOTRA2026116632,
title = {Stagnation-avoidance framework with hybrid dynamics evolutionary algorithms for constrained and combinatorial optimization problems},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116632},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116632},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013584},
author = {Rohit Salgotra and Pooja Verma and Szymon Lukasik and Amir H. Gandomi},
keywords = {Multi-hybrid algorithms, CEC benchmark problems, Adaptive properties, Engineering design problems, Feature selection},
abstract = {This paper proposes a novel four-algorithm hybrid framework called the Red Fire Meerkat Naked (RFMN) algorithm, integrating the Meerkat Optimization Algorithm (MOA), Red Panda Optimizer (RPO), Fire Hawks Optimizer (FHO), and Naked Mole Rat Algorithm (NMRA). The algorithm uses selected operators from the four methods within a fixed four-stage and employs a fractional iteration strategy to alternate between the exploration and exploitation phases. In addition, a stagnation avoidance mechanism and five adaptive mutation operators are used to enhance its performance and robustness. For discrete problems, a binary variant (bRFMN) is also developed using the S-shaped transfer function. An analysis is performed to check the suitability of the RFMN algorithm using classical benchmarks, such as the CEC 2014, CEC 2019, and CEC 2022 benchmarks, six constraints engineering design cases, and 15 CEC 2020 constraint problems. In addition to that, we are using ten feature selection datasets to test the bRFMN algorithm. Results demonstrate that RFMN and bRFMN outperform or remain competitive with leading algorithms such as SHADE, JADE, LSHADE-SPACMA, LX-TLA, SASS, HPSO, EnMODE, multi-strategy chameleon algorithm (MCSA), co-evolutionary PSO (CPSO), quadratic binary harris hawk optimizer (QBHHO), and binary multiverse optimizer (BMVO) across diverse continuous and combinatorial optimization problems.}
}
@article{LIU2026116608,
title = {Improving modality alignment via multi-scale and selective feature learning in reasoning segmentation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116608},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116608},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013341},
author = {Zhongye Liu and Weiliang Zuo and Liguo Liu and Jingjing Jiang},
keywords = {Multimodal large language models, Image segmentation, Multimodal learning},
abstract = {Reasoning segmentation is an emerging and challenging task that requires models to accurately understand implicit queries and precisely localize visual targets for segmentation. Existing reasoning segmentation models typically employ visual instruction tuning to achieve cross-modal alignment. However, when confronted with complex inputs, this alignment approach, which solely relies on visual instruction tuning, easily leads to incorrect cross-modal associations. This issue impairs the model’s ability to accurately capture complex semantic relationships, thus affecting the accuracy of segmentation and text responses. In this work, we present the Reasoning Segmentation Assistant (RSAT), an MLLM that enhances accurate interpretation of input information through cross-modal semantic interaction and multi-scale feature learning. Specifically, RSAT introduces an Attribute Feature Extractor (AFE), which extracts attribute information from query texts to guide the LLM to focus on key features and transforms them into high-level semantic features. Subsequently, the Modality Interaction Module (MIM) establishes precise semantic correspondences via fine-grained cross-modal interaction and multi-scale semantic fusion, substantially enhancing cross-modal alignment. AFE and MIM can be conveniently deployed in other reasoning segmentation models. Comprehensive experiments demonstrate that RSAT achieves improved performance across multiple reasoning segmentation benchmarks and exhibits strong competitiveness in referring segmentation tasks.}
}
@article{ZHAO2026116645,
title = {Causally-motivated generative few-shot reward inference through efficient DPO},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116645},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116645},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013717},
author = {Yiyang Zhao and Zhiqi Shen and Xuejiao Zhao},
keywords = {Causal inference, Reward modeling, Direct preference optimization, Large language models},
abstract = {Aligning large language models (LLMs) with human values can be viewed through the lens of causal reasoning, where a model’s response acts as an intervention affecting user preference. We propose GFRIEND, a causally motivated framework for few-shot reward modeling that draws inspiration from causal inference principles to address data scarcity and bias in preference learning. GFRIEND introduces a preference refinement module generating counterfactual responses via Chain-of-Thought sampling, enriching preference diversity. A perplexity-based scoring further stratifies preferences into fine-grained levels, capturing heterogeneous preference strengths. These multi-level labels are integrated into a modified Direct Preference Optimization (M-DPO) loss that weights comparisons by preference disparity, emphasizing reliable preferences. Experiments show GFRIEND achieves competitive or superior reward modeling with only thousands of human-labeled comparisons, and maintains robustness in biased or domain-specific settings. Extensive ablation studies and validation experiments demonstrate that each component contributes meaningfully to the overall performance. This demonstrates the value of a causally-inspired perspective for efficient and reliable preference learning in low-resource RLHF. The implementation is available at https://github.com/leonardeee/causalGfriend.}
}
@article{DING2026116564,
title = {NOVA: Noise-to-variation guided pruning of large language models},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116564},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116564},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012906},
author = {Anran Ding and Peng Xu and Zhihong Jin},
keywords = {Large language models, Post-training pruning, Weight importance, Sparsity allocation},
abstract = {As large language models continue to scale, their deployment becomes increasingly expensive in computation and memory. Unstructured post-training pruning can reduce these costs by removing redundant weights while preserving model accuracy. Yet many existing criteria rely primarily on activation statistics and do not directly capture weight sensitivity, which becomes increasingly important at high sparsity where activation-based proxies grow less reliable. We present NOVA (Noise-to-Variation), which estimates importance by injecting sign-preserving, weight-proportional Gaussian noise into prunable layers and measuring the resulting variation in layer outputs. We show that this forward-only sensitivity score is a closed-form proxy for the pruning-induced loss change under a standard layer-local Hessian approximation. These sensitivity scores guide adaptive layer-wise sparsity allocation and are fused with activation-based signals to compute per-weight pruning scores. Experiments on the LLaMA and LLaMA-2 families show consistent improvements over representative baselines in WikiText2 perplexity and better preservation of zero-shot accuracy on commonsense and reasoning benchmarks under aggressive sparsity. On LLaMA-2 7B, NOVA achieves a perplexity of 8.9 at 60% sparsity on WikiText2, improving over prior post-training pruning baselines. Overall, our results indicate that noise-induced output variation provides an effective and practical signal for post-training pruning of large language models at high sparsity, producing high-quality unstructured masks that serve as a starting point for downstream sparse-kernel or hardware-aware adaptation.}
}
@article{PARK2026116625,
title = {When correct is not enough: Deconstructing legal causal reasoning capability in large language models},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116625},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116625},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013511},
author = {Jee Won Park and Sungmi Park},
keywords = {Large language models, Legal reasoning, Argumentative reasoning, Causal traceability, Benchmark evaluation},
abstract = {Knowledge-based artificial intelligence systems are increasingly used to support human judgment and decision-making, but their reliability cannot be assessed only by final-answer accuracy. In domains that require structured reasoning, a system should also provide explanations that can be compared with expert-defined reasoning steps. This paper introduces LEET-Arg, a publicly available benchmark for evaluating legal-style argumentative reasoning in large language models (LLMs). The benchmark is derived from the Logical Reasoning section of South Korea’s Legal Education Eligibility Test (LEET) and consists of 97 expert-designed reasoning problems decomposed into 315 statement-level reasoning units. Each unit is paired with an expert-authored explanation, allowing model outputs to be evaluated not only by answer correctness but also by whether the generated rationale follows the reasoning required by the official solution. We evaluate seven frontier LLMs in a zero-shot setting using three complementary measures: answer accuracy, answer robustness across five independent trials, and justification fidelity. The results show that high-performing models can achieve strong answer accuracy while still producing explanations that are incomplete, misaligned, or repetitive. Qualitative analyses further illustrate recurring reasoning problems, including correct answers supported by invalid reasoning, scope overgeneralization, confusion between descriptive and normative claims, and argumentative replication. To improve the reliability of the fidelity evaluation, model rationales are assessed against expert-defined reasoning steps and further examined through full-set human validation. Overall, LEET-Arg provides a benchmark resource for studying the relationship between answer selection and explanation quality in knowledge-based decision support settings. The findings suggest that evaluating LLM-based systems for high-stakes reasoning tasks requires attention to both outcome accuracy and the structure of the reasoning expressed in model-generated explanations.}
}
@article{YANG2026116617,
title = {MLWAC: A Modular, Low-coupling Waypoint-Angular Coordinated Network for visual navigation in unstructured environments},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116617},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116617},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013432},
author = {Xin Yang and Yongdong Guo and Yuhang Zhang and Muxin Liao and Wei Li and Shishun Tian and Wenbin Zou and Chen Xu},
keywords = {Visual navigation, Low-coupling, Coordinated control, Across-dataset joint training, Multi-action paradigm learning},
abstract = {Visual navigation plays a crucial role in service and logistics applications, yet it faces significant challenges in scene generalization due to limited large-scale training data in unstructured environments. While Across-Dataset Joint Training (ADJT) methods have demonstrated effectiveness in improving generalization, they suffer from two notable limitations. Existing ADJT approaches employ a tightly coupled architecture, which prevents independent training of each component on different data sources. Furthermore, relying solely on waypoints as control signals results in poor straight-line stability and inadequate steering capability during navigation. To address these limitations, we propose MLWAC, a Modular, Low-coupling Waypoint-Angular Coordinated Network for unstructured visual navigation. MLWAC decouples sub-goal selection and planning into independently trainable networks. The sub-goal selection network accepts internet videos as training data by treating inter-frame distance as a weak supervision signal, improving generalization to unstructured environments and enabling flexible integration with existing waypoint-based ADJT navigation methods. The planning network, trained independently on robot-collected datasets, predicts both waypoints and angular velocities. We further introduce a Waypoint-Angular Coordinated (WAC) control algorithm that combines waypoint predictions and angular velocity predictions into a unified control signal, effectively addressing instability in straight-line motion and insufficient steering in sharp turns. Experimental results confirm that the decoupled training strategy improves generalization, and control signal visualization validates that WAC substantially improves straight-line stability and steering performance. Code will be released upon publication at https://github.com/942411526/MLWAC.}
}
@article{WANG2026116581,
title = {A cognitive dual-process framework for Referring Video Object Segmentation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116581},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116581},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013079},
author = {Yong Wang and Xiaotong Wang and Xiaobo Ma and Tianyao Wang and Xiaoming Xi},
keywords = {Referring Video Object Segmentation, Multimodal Large Language Models, Segment Anything Model, Visual-language understanding},
abstract = {Referring Video Object Segmentation (RVOS) constitutes a challenging task that demands models accurately localize and segment target objects within video sequences based on natural language descriptions. Contemporary approaches typically attempt to consolidate two conflicting responsibilities, i.e., complex vision-language understanding and pixel-level fine-grained segmentation, within a single model architecture, resulting in increased model complexity and suboptimal utilization of specialized capabilities. To address this fundamental challenge, we propose a novel collaborative paradigm inspired by the dual-process theory from human cognitive mechanisms. This paradigm decomposes the RVOS task into two distinct phases: in the first phase, a Multimodal Large Language Model (MLLM) comprehends natural language descriptions and coarsely localizing target regions; in the second phase, the Segment Anything Model 2 (SAM2) generates precise pixel-level segmentation masks based on provided prompts. Our core innovation lies in the development of an intelligent prompt generation mechanism that enables the MLLM to produce high-quality foreground and background point prompts for SAM2, facilitating seamless collaboration between these heterogeneous models. This approach leverages the superior language comprehension capabilities of MLLMs and the exceptional segmentation performance of SAM2 while circumventing the complexities of end-to-end training pipelines. Experimental results demonstrate that our method achieves outstanding performance across multiple RVOS benchmark datasets, providing a concise and effective solution to this challenging task.}
}
@article{CAO2026116633,
title = {Instruction-conditioned visual token sparsification for efficient vision-language model inference},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116633},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116633},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013596},
author = {Weidong Cao and Xi Zhang and Chengyang Li and Danjun Liu and Yongqiang Xie and Zhongbo Li},
keywords = {Vision-language models, Multimodal reasoning, Inference-time acceleration, Visual token sparsification, Cross-modal attention},
abstract = {Vision-language models rely on cross-modal interactions between textual and visual tokens to enable multimodal reasoning. However, the number of visual tokens increases rapidly with image resolution, leading to quadratic computational cost during inference. Existing visual token pruning methods typically estimate token importance using head-averaged cross-modal attention and remove low-ranked tokens, but this strategy may overlook task-relevant alignment patterns as well as complementary visual information. In this work, we investigate text–visual attention in VLMs and observe that different heads exhibit distinct cross-modal alignment behaviors, making head-averaged token pruning suboptimal. Motivated by this observation, we propose Instruction-Conditioned Visual Token Sparsification (ICVS), a framework that selects task-relevant visual tokens using task-aware attention patterns identified through lightweight offline preparation. Specifically, we leverage text-vision attention weights from decoder layers to quantify semantic relevance for pruning decisions, while a lightweight instruction-conditioned router is introduced to select task-aligned attention heads. To mitigate information loss, we further design a density-aware token recycling mechanism that compresses discarded tokens into representative tokens, thereby preserving complementary visual information. Extensive experiments across multiple benchmarks demonstrate that ICVS achieves a competitive accuracy–efficiency trade-off, particularly under aggressive token budgets. Under a 64-token budget, it reduces FLOPs by up to 4.6× and achieves a 1.56× speedup while maintaining competitive performance. The code is available at https://github.com/AMS-Lab-X/ICVS.}
}
@article{YUAN2026116629,
title = {Spatiotemporal forecasting of natural focal disease risk with causal landscape-structured graph priors},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116629},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116629},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013559},
author = {Xing Yuan and Min Meng and Li Wang and Binggan Wei and Hairong Li and Linsheng Yang},
keywords = {Causality, Spatiotemporal forecasting, Graph Neural Network, Natural foci},
abstract = {Spatiotemporal forecasting in complex, real-world systems presents a significant challenge, as the performance of machine learning models is often constrained by distribution shifts. This problem is particularly acute in the prediction of natural focal diseases, as their system dynamics are governed by an interplay of quasi-static, invariant factors and dynamic, variant factors (e.g., climate, human activity). Traditional Graph Neural Network (GNN) models are prone to learning spurious correlations between features from the abundant variant factors, resulting in poor spatiotemporal generalization. To address the problem of spatiotemporal prediction for natural focal diseases, this paper encodes stable landscape features and multi-angle spatial topological structure priors into the graph structure. Furthermore, it integrates the invariance of causal features to predict natural focal diseases across different spatiotemporal contexts. Validation on a real-world epidemiological dataset demonstrates that the proposed approach outperforms baseline methods in the task of spatiotemporal disease risk prediction. These results demonstrate the effectiveness of integrating expert knowledge and causal invariance information for disease risk prediction.}
}
@article{SULTAN2026116605,
title = {A two-stage depth-balanced GAN framework for secure and scalable high-capacity image steganography},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116605},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116605},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013316},
author = {Bisma Sultan and M Arif Wani},
keywords = {Image steganography, Secure communication, GAN-based steganography, Deep learning in image steganography, Image processing},
abstract = {Conventional and deep learning steganographic techniques typically involve encoding secret data within a cover image using a steganographic encoder, resulting in a stego image. This study introduces a novel two-stage approach for generating stego images, enhancing both capacity and security. The process comprises a cover reconstruction stage and a stego image construction stage, each utilizing architectures of varying depths. In the cover reconstruction stage, the input cover image is initially reconstructed to capture its distinctive features, adapting the size of the reconstructed cover according to the depth of this stage. This stage focuses on learning fundamental image features through a reconstruction loss.In the stego image construction stage, the reconstructed cover image and the secret message are combined to create the stego image. This stage employs three loss terms, including an adversarial loss, to incorporate the secret message. Importantly, the depth of these two stages exhibits an inverse relationship: a shallow architecture in the cover image reconstruction phase is balanced by a deep architecture in the stego image generation phase, and vice versa. This deliberate depth balancing ensures the stego image size does not exceed the cover image size, significantly enhancing embedding capacity.The unique aspect of this method is its focus on embedding data solely in the deeper layers of the Generator network, leaving the lower layers dedicated to image reconstruction. This approach boosts capacity without requiring complex architectures, thus reducing computational storage requirements.Experimental results on CelebA, COCO, and ImageNet datasets demonstrate that the proposed method achieves more than four times the embedding capacity of existing GAN-based approaches while preserving high imperceptibility (PSNR > 74 dB, SSIM > 0.95) and strong security (steganalyzer error ≈ 50%). Furthermore, the model ensures robust extraction accuracy at moderate payloads, confirming its practicality for real-world steganography applications.}
}
@article{GARRIDOMERCHAN2026116657,
title = {GOFAI meets generative AI: Development of expert systems by means of large language models},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116657},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116657},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013833},
author = {Eduardo C. Garrido-Merchán and Cristina Puente},
keywords = {Expert systems, Language models, LLMs, Fact-Checking, hallucinations},
abstract = {The development of large language models (LLMs) has transformed knowledge-based systems such as open-domain question answering, which can automatically produce vast amounts of seemingly coherent information. Yet these models suffer from well-known limitations, most notably hallucinations, the confident generation of incorrect or unverifiable facts. In this paper, we introduce an approach to the development of expert systems that uses LLMs in a controlled and transparent way. By restricting the domain and employing a structured, prompt-based extraction protocol, we distil the knowledge of an LLM into a symbolic Prolog representation that can be inspected, validated and corrected by human experts, and queried by a deterministic inference engine. We evaluate the approach along three complementary axes. First, we assess factual accuracy through a manual expert audit and, to address the limited scale of manual checking, a large-scale automated cross-validation against Wikidata over three different LLM families (Claude Sonnet 3.7, GPT-4.1 and Grok 3), reporting Wilson confidence intervals and explicitly separating entity-linking error from factual error by means of a type-aware entity linker. Second, we show that the generated knowledge bases support genuine multi-hop deductive reasoning, negation as failure and aggregation when executed in SWI-Prolog, confirming that they behave as functioning expert systems rather than inert fact lists. Third, we analyze the statistical guarantees of the pipeline, making explicit how the autoregressive, non-independent nature of LLM generation affects the concentration bounds and confidence intervals. The result is a transparent hybrid solution that combines the recall of LLMs with the precision and explainability of symbolic systems, laying the foundation for dependable AI applications in sensitive domains. All code, prompts and generated knowledge bases will be made publicly available at https://github.com/eduardogarrido90/GOFAIGenAI upon acceptance.}
}
@article{GRABCZEWSKI2026116652,
title = {Bounds on kappa-error plots for classification diversity analysis},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116652},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116652},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601378X},
author = {Krzysztof Grąbczewski},
keywords = {Kappa-error diagrams, Contingency tables, Classifier correctness, Class assignment, Bounds, Classifier ensembles, Model diversity},
abstract = {Classifier ensembles benefit in terms of both accuracy and size reduction from the diversity of their members. It has become popular to analyze diversity using so-called kappa-error plots. In 2013, Kuncheva presented a bound on kappa-error points that identifies regions of the diagram that can never be occupied. She also claimed that there is an unoccupied space in the vicinity of these bounds where new ensembles might be engineered. This article presents a more in-depth study of the areas that may and may not be occupied by kappa-error points. It is shown that the region that Kuncheva and some followers claimed to be available may in fact be unavailable in many practical applications. Several properties are proved that constructively characterize the contents of kappa-error optimal contingency tables describing class assignment differences between raters in multiclass problems with arbitrary class proportions. Formulae for the exact bounds of the plots are provided. Examples with equal class sizes are also analyzed to illustrate and visualize how the availability of these areas depends on the number of classes. The analysis reveals and discusses further weaknesses of the kappa statistic as a measure of model diversity. Recommendations are provided for researchers who wish to base model selection on kappa or to prepare, analyze, and interpret kappa-error plots based on the location of point clouds.}
}
@article{SEMPER2026116673,
title = {A practical decision-support system for robust post-training model selection in spatiotemporal forecasting},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116673},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116673},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013997},
author = {Marc Semper and Manuel Curado and Jose F. Vicent and Leandro Tortosa},
keywords = {Decision-support systems, Model governance, Selection regret, Robust selection, Evaluation uncertainty, Spatiotemporal forecasting},
abstract = {Spatiotemporal forecasting pipelines usually select a model against a single evaluation reference. We show that this assumption can make the final deployment decision unstable when the reference is locally substituted, spatially misaligned, or degraded. In four of six real datasets, plausible reference perturbations induce non-null winner instability in the final benchmark. We therefore introduce a post-training decision-support system that reevaluates frozen prediction bundles under a declared perturbation family, diagnoses material selection instability with seed-calibrated selection regret, benchmarks candidate robust rules on validation data, and maps the evidence to one of three budget-aware actions: keep the clean winner, select a robust rule, or decline robust selection. In the main same-domain case, EEA-PM25-ES, the selected rule reduces median decision regret from 0.1403 to 0.0000 under the declared family. In PEMS-BAY, instability is also detected, but robust selection is rejected because the clean-performance cost is high. Across datasets, no robust rule is uniformly dominant. The contribution is an auditable decision contract that preserves parsimony, shows when evaluation-reference uncertainty changes model choice, and records when clean-performance cost makes robust selection unacceptable.}
}
@article{YANG2026116597,
title = {A robust multi-view clustering framework with instance and feature-level self-paced learning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116597},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116597},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013237},
author = {Fan Yang and Haikun Xu and Zhen Su and Haimei Zhao},
keywords = {Multi-view clustering, Anchor graph learning, Self-paced learning, Robust clustering, Incomplete multi-view data},
abstract = {Multi-view clustering can exploit complementary information across views, but its performance is often hindered by view-specific noise, unreliable samples and features, and incomplete observations. Although anchor-based methods improve scalability, many existing approaches still depend on separate graph fusion or post-processing procedures and remain sensitive to structured perturbations during anchor learning. To address these issues, we propose RMVC-IFSL, a robust anchor-based multi-view clustering framework with instance- and feature-level self-paced learning. The proposed method jointly learns a consensus anchor graph and view-specific structured deviation terms within a unified optimization framework, so that shared cluster structure and view-dependent perturbations can be explicitly separated. Meanwhile, dual self-paced learning is introduced on both the sample and feature dimensions to progressively emphasize reliable instances and informative attributes while suppressing noisy components. A mask-aware extension further allows the framework to handle incomplete multi-view data by excluding missing views from the corresponding residual terms and parameter updates. Extensive experiments on eight benchmark datasets and one large-scale XMediaNet dataset show that RMVC-IFSL consistently achieves superior clustering performance over a range of state-of-the-art methods. Additional studies on noisy and incomplete-view settings, large-scale scalability, ablation, convergence, runtime, and sensitivity analyses further verify the robustness, effectiveness, and practical applicability of the proposed framework. The code is available at https://anonymous.4open.science/r/RMVC-IFSL-F6C5/.}
}
@article{ZHANG2026116649,
title = {CMF2A: Cross-Modal Fine-grained Feature Alignment for text-based person re-identification},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116649},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116649},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013754},
author = {Chengfang Zhang and Qingfeng Lin and Ziliang Feng},
keywords = {Text-based person re-identification, Fine-grained information refinement, Masked model, Cross-modal feature align},
abstract = {Text-based Person Re-Identification aims to identify the corresponding target person based on natural language descriptions. Previous works focus mainly on coarse-grained features while neglecting the critical role of fine-grained features in identification. To address this limitation, we propose a Cross-Modal Fine-grained Feature Alignment (CMF2A) method to mine and align fine-grained information in text-based person re-identification. Firstly, we introduce a Fine-grained Local Feature Refinement (FLFR) approach to extract essential local fine-grained features. This approach also discards redundant information, introducing noise in the model. To better uncover latent fine-grained cues within texts, we adopt an implicit cross-modal relation reasoning method. It implicitly infers complex relationships between textual descriptions and image content, enhancing the model’s understanding of fine-grained features. Then, we propose a Multi-association Learning (MAL) method to strengthen the model’s ability to distinguish between positive and negative samples. It improves classification performance, reinforcing interactions across different semantic levels. Comprehensive evaluations on three public datasets validate the effectiveness of our CMF2A method, demonstrating superior performance compared to state-of-the-art approaches on key metrics. Our source code is available at https://github.com/lqfhello/CFFA.}
}
@article{LI2026116682,
title = {From scene to object: Cross-view object geo-localization via cross-task knowledge transfer learning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116682},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116682},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014085},
author = {Jiangshan Li and Jun Li and Luo Chen and Nan Wu and Hao Chen},
keywords = {Cross-view object geo-localization, Cross-view image geo-localization, Cross-task knowledge transfer learning, Visual geo-localization},
abstract = {Cross-View Object Geo-Localization (CVOGL) aims to accurately locate specified objects within ground or drone-view images onto their corresponding positions in satellite imagery, addressing a critical demand for fine-grained geo-localization beyond coarse scene-level estimation. This fine-grained localization capability plays a vital role in various practical fields, such as security surveillance, autonomous driving, smart map construction, and robotics. However, CVOGL faces significant challenges due to severe viewpoint differences, data scarcity, and the difficulty of establishing robust cross-view object correspondences. Inspired by the observation that view-invariant properties are shared between scene-level and object-level features, we propose STONet, a novel cross-task knowledge transfer framework for CVOGL. STONet employs a two-stage training pipeline. In the first stage, it first leverages Cross-View Image Geo-Localization (CVIGL) to learn foundational scene-level view-invariant features for the backbone. In the second stage, a cross-task knowledge transfer mechanism is designed to adapt this scene-level knowledge for object-level geo-localization. To ensure robust learning and prevent catastrophic forgetting, we introduce the Object-Scene Joint Loss, which balances global scene-level constraints with fine-grained object-level supervision. Additionally, to address feature space misalignment caused by the orthogonal view difference between ground panoramic images and satellite images, we propose a geometry-constrained inverse-polar feature transform for ground features. On the CVOGL dataset, STONet outperformed state-of-the-art performance with only 29.52M parameters (↓60%) and 105.39 GFlops (↓50%).}
}
@article{LI2026116609,
title = {AutoHGNN: Robust and efficient neural architecture search for hypergraph neural networks},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116609},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116609},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013353},
author = {Sirui Li and Pietro Liò and Xinsheng Li and Baisong Liu and Chengbin Peng},
keywords = {Hypergraph neural network, Neural architecture search, Hypergraph representation learning, Automated machine learning},
abstract = {Hypergraph neural networks have achieved significant success in recent years. However, manual architecture crafting is labor-intensive and often fails to capture complex, higher-order relations, making the automation of hypergraph neural network structure design crucial. To improve the automation and adaptability of hypergraph learning, this paper proposes AutoHGNN, a neural architecture search framework tailored for hypergraph neural networks. First, we introduce a Hyper-Interaction Module (HIM) into the search space to address the mismatch between conventional graph neural network designs and hypergraph data. Second, we propose Hypergraph Stable Topological Distance (HyperSTD) as a structural selection criterion to identify architectures that best preserve the intrinsic structural affinities of the original hypergraph during differentiable search. Extensive experiments on various benchmark datasets demonstrate that AutoHGNN consistently outperforms manually designed and automatically searched baselines in classification accuracy and time efficiency, proving that the discovered architectures are significantly more effective.}
}
@article{GAO2026116661,
title = {Mapping text to multiplex graph: Prompt compression as Lévy walk-guided graph pruning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116661},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116661},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013870},
author = {Yaxin Gao and Yao Lu and Jinhong Deng and Jiaqi Nie and Zhe Tang and Jian Zhang and Zhaowei Zhu and Shanqing Yu and Qi Xuan and Joey {Tianyi Zhou}},
keywords = {Prompt compression, Large language models, Graph pruning, Multiplex graph, Lévy walk},
abstract = {Existing prompt compression methods treat text as flat token sequences, failing to capture the distributed nature of important information, which is often spread across multiple locations and connected through both local syntactic dependencies and global semantic relations. Such relational structure is naturally represented as a graph, where tokens or sentences become nodes and their dependencies become edges. To this end, we propose RAGP, which formulates prompt compression as Redundancy-Aware Graph Pruning on a multiplex graph that jointly models fine-grained attention-based dependencies and coarse-grained semantic relations. To efficiently identify non-redundant nodes in this heterogeneous structure (dense local subgraphs and sparse global connections), we employ Lévy walks whose heavy-tailed step distribution naturally balances local exploitation with global exploration. Experiments on LongBench show that RAGP achieves an average score of 49.3 under a 4× compression ratio, outperforming existing LLM-based compression methods, such as LongLLMLingua, which attains 48.8 at a 3× compression ratio. Besides, RAGP also surpasses state-of-the-art vision-based text compression paradigms on multiple tasks.}
}
@article{SYEDA2026116601,
title = {Knowledge graphs and large language models: Construction paradigms, integration approaches, and emerging applications},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116601},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116601},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013274},
author = {Qurratul Aine Syeda and Ravinder Reddy B․},
keywords = {GraphRAG, Hallucinations, HybridRAG, Knowledge graphs, Large language model},
abstract = {Large Language Models (LLMs) have shown impressive abilities in natural language understanding and generation that have been widely used in various applications like content creation, answer generation, Q&A systems and have shown impressive capabilities in processing knowledge. The attention mechanism aids transformer-based models, like ChatGPT, to articulate well-structured and grammatically sound sentences. Nevertheless, these models are prone to hallucinations lacking fact-based information and structured reasoning. In contrast, Knowledge Graphs (KGs) are semantically rich graph-based data structures which are interconnected facts represented as entities (nodes) and relations (edges) enhancing factual grounding and explainability in LLMs. These semantic networks store structured and organized information enabling explicit modeling of domain knowledge. This survey presents a systematic review that aims at synthesizing KGs and LLMs. We present a detailed overview on Knowledge Graph construction, Multi-modal KG construction, Domain-specific KG construction with a focus on healthcare. Additionally, we classify integration strategies in three ways, namely, 1) KG enhanced LLMs, 2) LLMs-augmented KGs and 3) Synergized LLMs+KGs, the neuro symbolic architectures. We discuss recent research developments like HybridRAG and GraphRAG based on graph-based retrieval-augmented generation. We emphasized evaluation metrics and real-world applications in enterprise and clinical domains. We conclude by discussing open challenges in cross-modal alignment, dynamic knowledge updates and multi-hop reasoning. We outline future research directions towards reliable knowledge-grounded intelligent systems. We foresee that this research provides deeper insights for future research initiatives in the field of knowledge graphs.}
}
@article{DENG2026116653,
title = {Unsupervised anomaly detection in industrial IoT: A one-class tensor-train machine with randomized mapping},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116653},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116653},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013791},
author = {Xiaowu Deng and Yuanquan Shi and Rongbo Lu and Dunhong Yao and Chunqiao Mi and Jianhua Xia},
keywords = {Industrial internet of things, Anomaly detection, One-class tensor-train machine, Random fourier features},
abstract = {The industrial internet of things (IIoT) has generated large volumes of high-dimensional tensor data, making anomaly detection essential for ensuring manufacturing safety and operational efficiency. The one-class support vector machine (OCSVM), originally designed for vector-based data, often struggles to capture the structural complexity of large-scale IIoT data. To overcome these limitations, we propose the one-class support tensor-train (TT) machine (1CSTTM). This novel framework extends OCSVM to tensor space through TT decomposition. It constructs a tensorial fiber-based kernel by exploiting the fibers of the TT cores, thereby preserving intrinsic structural information. As a result, the proposed method reduces computational and storage complexity from exponential to polynomial order. We further introduce the randomized 1CSTTM (R1CSTTM), which efficiently handles large-scale datasets by using random Fourier features to approximate nonlinear tensorial kernels, thereby improving both scalability and detection accuracy. Experiments on real-world IIoT datasets demonstrate that both methods outperform state-of-the-art techniques in terms of accuracy and robustness. In particular, R1CSTTM achieves superior performance while substantially reducing training and inference time, confirming its suitability for large-scale anomaly detection in industrial applications.}
}