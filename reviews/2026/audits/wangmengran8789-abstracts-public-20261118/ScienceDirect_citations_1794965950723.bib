@article{ZHANG2026116847,
title = {RCLIP: Residual logits adaptation of CLIP for few-shot learning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116847},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116847},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601573X},
author = {Yanbo Zhang and Zhaoyang Liu and Aoxiang Hu and Guanghua Gu},
keywords = {CLIP, Few-shot learning, Residual logit correction, Fine-grained visual features},
abstract = {Recently, pre-trained vision-language models such as CLIP have demonstrated impressive potential in few-shot learning and attracted increasing research attention. Although many efforts have aimed to improve CLIP’s few-shot performance through prompt tuning or feature adaptation, downstream tasks still suffer from serious inter-class confusion. This motivates us to explore an alternative yet underexplored direction: directly refining CLIP’s zero-shot logits to improve semantic separability at the output level. In this paper, we propose RCLIP, a simple yet effective framework that introduces a residual correction adapter to refine CLIP’s zero-shot logits and improve logit-space decision separability. Meanwhile, we introduce a fine-grained auxiliary branch to compensate for CLIP’s weakness in capturing subtle visual differences. It employs DINOv2 features and a feature-initialized linear classifier to extract local structural cues, offering discriminative visual priors that assist the residual correction module in refining CLIP’s zero-shot predictions. Finally, we introduce an adaptive fusion mechanism to combine both sources of prediction by dynamically adjusting the contribution of each branch on a per-sample basis. Extensive experiments on multiple few-shot classification benchmarks demonstrate that our method consistently outperforms existing approaches on a wide range of baselines.}
}
@article{LIAO2026116852,
title = {Integrating information flow-knowledge graphs and fine-tuning LLM for knowledge-guided process engineering in domain-specific task},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116852},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116852},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015789},
author = {Xilong Liao and Baizhan Li and Tim Broyd and Shiyu Han and Chuanyu Tang and Nan Li},
keywords = {Fine-tuning, IDEF0, Knowledge graph (KG), Knowledge integration, Large language model (LLM)},
abstract = {The Architecture, Engineering, and Construction (AEC) industry continues to grapple with the integration and application of fragmented, high-density professional knowledge. Such knowledge often exceeds individual cognitive capacity, resulting in frequent rework. Although large language models (LLMs) hold transformative potential for bridging interdisciplinary cognitive gaps, their adoption within the professional field remains limited. This is largely due to issues such as hallucination and the long-tail effect, which stem from the absence of standardized, process-oriented knowledge structures. To address these limitations, this study proposes a novel Information Flow-Knowledge Graph (IF-KG) framework. The IF-KG is constructed by formally mapping the optimized IDEF0 functional modeling standard, featuring a hierarchical decomposition into destination, function, and operation layers, and utilizes standardized semantic relationships ("include," "input," "output"). This structure enables the generation of high-quality, comprehensive prompts for Retrieval-Augmented Generation (RAG) to mitigate the long-tail effect in knowledge retrieval. A semi-automated, expert-driven method was developed to generate a high-quality Q&A dataset. This dataset enables the fine-tuning of the DeepSeek R1 7B model with LoRA, effectively embedding domain knowledge and reducing hallucinations. The proposed framework (Fine-tuning + IF-KG-enhanced RAG) is rigorously evaluated against general-purpose LLMs. Results demonstrate a substantial improvement in objective indicators and superior performance in subjective expert assessments, achieving approval rates of 82%, 82%, and 90% for completeness, accuracy, and relevance, respectively. The IF-KG framework provides a systematic methodology for structuring engineering process knowledge, effectively enhancing the reliability and practical applicability of LLMs in professional design tasks.}
}
@article{LUO2026116836,
title = {DHNet: Dual-hierarchy geometric learning with hyperbolic embeddings for few-shot point cloud classification},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116836},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116836},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015625},
author = {Shuicai Luo and Xiaoyang Yuan and Can He and Jianshu Chao},
keywords = {Few-shot learning, Hierarchy attention, Point cloud classification, Hyperbolic geometry},
abstract = {Few-shot learning (FSL) has achieved notable success in the 2D image domain by addressing data scarcity and improving generalization. However, extending FSL to 3D point cloud data remains underexplored due to its unique geometric and structural challenges. Unlike image grids, point clouds are inherently unordered and irregular, yet they preserve rich geometric information. In this work, we introduce the concept of dual-hierarchy in point clouds, which reflects the inherent hierarchical structures at both patch and object levels. To exploit these priors, we propose DHNet, a novel dual-hierarchy modeling framework for few-shot point cloud classification. DHNet comprises two key modules: (1) PHFormer, a Transformer-based embedding network that captures patch-level structural dependencies via hierarchy attention; and (2) HyperHead, a classification head that leverages hyperbolic geometry to model object-level hierarchies, enabling more discriminative representations in a non-Euclidean space. Experiments on four benchmark datasets, including ModelNet40, ModelNet40-C, ScanObjectNN, and ShapeNet70, demonstrate that DHNet consistently outperforms state-of-the-art methods under standard 5-way 1-shot and 5-way 5-shot FSL settings. These results highlight the effectiveness of dual-hierarchy modeling and hyperbolic geometry in addressing the challenges of few-shot 3D point cloud classification. The code is available at https://github.com/luo3216/DHNet.}
}
@article{BANAVATHU2026116759,
title = {Multi-feature integrated spatiotemporal deep neural network for detecting violent events in video surveillance},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116759},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116759},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014851},
author = {Prasad Naik Banavathu and Muthu Krishnammal P},
keywords = {Violence detection, Surveillance video, Deep learning, CNN-BiLSTM, Temporal modeling, Video classification, Public safety, Spatiotemporal learning},
abstract = {The widespread use of surveillance infrastructure in both public and private settings have highlighted the need for intelligent systems capable of identifying violent behavior in real time. To address this challenge, the present study proposes an effective hybrid deep learning framework that integrates Convolutional Neural Networks (CNNs) and Bidirectional Long Short-Term Memory (BiLSTM) networks for violence classification in surveillance videos. The CNN component extracts spatial features from individual video frames, including posture variations, interaction patterns, scene context, and appearance-based motion cues. These frame-level spatial embeddings are sequentially processed by the BiLSTM network to model tem-poral dependencies, motion continuity, and sequence evolution across video frames. The proposed multi-feature integration framework jointly learns spatial and temporal representations within a unified architecture to improve discrimination between violent and non-violent activities. The proposed framework is evaluated on the Real-Life Violence Situations (RLVS) dataset containing 2000 annotated surveillance video clips comprising 1000 violent and 1000 non-violent samples collected under real-istic environmental conditions. Experimental results demonstrate strong generalization capability and robustness, achieving an overall classification accuracy of 97.22 % on the test dataset. The model achieves precision, recall, and F1-score values of 0.95, 1.00, and 0.97 for the non-violence class and 1.00, 0.94, and 0.97 for the violence class, respectively. In addition, the proposed framework demonstrates near real-time inference capability with an average processing speed of approximately 60–75 FPS on NVIDIA RTX 4090 GPU hardware. The results confirm that the proposed CNN–BiLSTM framework effectively captures both spatial and temporal characteristics required for intelligent violence detection in complex surveillance environments.}
}
@article{HE2026116860,
title = {Feature confusion mitigation and feature disentanglement for generalized zero-shot learning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116860},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116860},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015868},
author = {Chunmei He and Xin Jiang and Zhengchun Ye and Ling Yang},
keywords = {Zero-shot learning, Feature redundancy, Feature confusion, Deep neural network, Image classification},
abstract = {Most generative Generalized Zero-Shot Learning (GZSL) methods generate unseen samples based on class-level semantic descriptions and suffer from visual-semantic alignment bias due to feature redundancy and domain classification bias due to feature confusion. Existing methods ignore the correlation and simultaneous occurrence of feature confusion and feature redundancy, and only consider the issues of feature confusion or feature redundancy separately. For this reason, this paper proposes the Feature Confusion Mitigation and Feature Disentanglement framework for GZSL. First, we construct a parallel visual-semantic feature disentanglement network to refine, separate the discriminative and redundant features, and disentangle the visual and semantic features simultaneously. Second, the discriminative visual-semantic relation module is designed to ensure the correlation between the decomposed representations. Then we further design the total correlation penalty to make sure the independence between the decomposed representations. At last, we construct the visual feature generative flow module to generate the visual feature, blend the disentangled semantic features into each coupling layer and ensure the synthesized visual features consistent with the semantic information. Extensive experiments on four datasets show that the framework achieves advanced performance levels in both generalized and conventional zero-shot settings.}
}
@article{GU2026116848,
title = {GDAS-Merge: Grouped Differentiable Adaptive Search for multimodal model merging},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116848},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116848},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015741},
author = {Mengjie Gu and Lin Wang and Meiwen Li and Junlong Zhu and Junqiang Yan and Qingtao Wu and Mingchuan Zhang},
keywords = {Differentiable Adaptive Search, Model merging, Multimodal Large Language Models, Layer-dependent fusion},
abstract = {Multimodal Large Language Models (MLLMs) often exhibit complementary capabilities, making model merging an attractive way to improve multimodal performance without retraining all parameters. However, heterogeneous MLLM merging is challenging because different models may have different architectures, parameter spaces and layer-wise functional roles. Existing merging methods often rely on globally shared coefficients or coarse parameter-space operations, which are insufficient to capture such layer- and module-level heterogeneity. To address this problem, we propose Grouped Differentiable Adaptive Search Merge (GDAS-Merge). After aligning parameters to the target architecture, GDAS-Merge freezes the source models and searches only over a low-dimensional set of group-level fusion variables. These variables induce layer-dependent fusion coefficients. As a result, different layer groups can use different fusion strengths without making the search space excessively large. To stabilize multi-task optimization, we further introduce task-level normalization and regularized coefficient search. Finally, we evaluate the performance of GDAS-Merge on three heterogeneous MLLM merging settings and seven public multimodal benchmarks. The experimental results show that GDAS-Merge improves overall performance and cross-task robustness while maintaining a controlled search cost among search-based methods.}
}
@article{KURNIANTO2026116799,
title = {WeTiGAN: Unpaired video-to-video translation with style and content consistency},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116799},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116799},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601525X},
author = {Irfan Rahadi Kurnianto and Cheol Jeong and Il-Min Kim},
keywords = {Intra-video style consistency (ISC) loss, Pyramid scale representation (PSR), Unpaired video-to-video translation, Weather and time translation},
abstract = {There has been extensive work on image style translation, such as adding fog or rain while preserving content like cars and roads. However, video style translation remains challenging due to difficulty in maintaining temporal consistency across frames. Applying image-to-image translation independently to frames often results in style inconsistencies. While existing video-to-video translation methods employ spatiotemporal constraints to improve transition smoothness, they often fail to enforce a consistent style across all frames. To address this, we propose the Weather-Time Generative Adversarial Network (WeTiGAN), a framework for translating weather or time conditions in unpaired videos. The generator in the WeTiGAN employs content-style separation, where a content encoder extracts structural features such as object shapes and positions, and a style encoder captures domain-specific attributes such as weather or time-of-day. The decoder then fuses these representations to generate output frames. To propagate style across all frames, we introduce the intra-video style consistency (ISC) loss, which minimizes the discrepancy between style representations of distant frames. Specifically, ISC measures the distance between style latent vectors of the initial and current frames extracted by a shared style encoder and minimizes it to enforce style consistency. Additionally, we enhance the discriminator by integrating pyramid scale representation (PSR), a multi-scale module that captures both local and global features by aggregating neighboring patch tokens at multiple scales from the vision transformer. Extensive quantitative and qualitative evaluations across day, fog, rain, sunset, and overcast conditions demonstrate significant gains in style consistency and content preservation compared with existing methods.}
}
@article{XIE2026116820,
title = {DEMONet: Underwater acoustic target recognition based on multi-expert network and cross-temporal variational autoencoder},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116820},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116820},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015467},
author = {Yuan Xie and Xiaowei Zhang and Jiawei Ren and Ji Xu},
keywords = {Underwater acoustic target recognition, Physical characteristics, DEMON spectrum, Multi-expert network, Variational autoencoder},
abstract = {Building a robust underwater acoustic target recognition system in real-world scenarios is challenging due to the complex underwater environment and the dynamic motion states of targets. A promising optimization approach is to leverage the intrinsic physical characteristics of targets, which remain invariant regardless of environmental conditions, to provide robust prior knowledge. However, our study reveals that while physical characteristics exhibit robust properties, they may lack class-discriminative patterns. Consequently, directly incorporating physical characteristics into model training can potentially introduce unintended inductive biases, leading to performance degradation. To harness the benefits of physical characteristics while mitigating their possible detrimental effects, we propose DEMONet, which utilizes the detection of envelope modulation on noise (DEMON) to provide robust insights into the shaft frequency and blade counts of targets. DEMONet is a multi-expert network that routes diverse underwater signals to their best-matched expert layers based on DEMON spectra for fine-grained signal processing. In this framework, DEMON spectra serve exclusively to provide implicit physical characteristics, decoupled from any direct mapping to target categories. Furthermore, to suppress noise and spurious modulation components in DEMON features, we introduce a cross-temporal alignment strategy and employ a variational autoencoder (VAE) to reconstruct noise-resistant DEMON spectra as a replacement for the raw DEMON features. The proposed DEMONet with cross-temporal VAE is evaluated on the DeepShip dataset and our proprietary dataset. Experimental results demonstrate that our approach achieves state-of-the-art performance on both datasets.}
}
@article{ZHOU2026116763,
title = {Teacher-guided residual calibration for product-quantized cross-modal retrieval},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116763},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116763},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014899},
author = {Kun Zhou and Fadratul Hafinaz Hassan and Keng Hoon Gan},
keywords = {Cross-modal retrieval, Product quantization, Teacher-guided calibration, Efficient similarity search, Knowledge distillation, Knowledge-based systems},
abstract = {Cross-modal retrieval systems must support accurate image-text matching while keeping large-scale gallery representations compact. Standard product quantization (PQ) provides an efficient compression backbone, but aggressive 16, 32, and 64 bits-per-vector settings can distort the cross-modal neighborhood structure learned by high-capacity vision-language models. We propose TGRC-PQ, a teacher-guided residual calibration framework for product-quantized cross-modal retrieval. TGRC-PQ uses reproducible Faiss PQ, optimized PQ (OPQ), and residual quantization (RQ) indexes as fixed low-bit gallery backbones, then learns lightweight residual calibrators for quantized gallery features and original query features. A teacher-guided rank distillation objective transfers semantic neighborhood information from 1024D teacher features to the calibrated low-bit retrieval space, while reconstruction and contrastive objectives preserve modality alignment. We also introduce LightCMR-Bench, a feature-level benchmark with fixed Flickr30K, COCO, and OpenImages splits, 64D student features, 1024D teacher features, and a unified asymmetric retrieval protocol. Across PQ, OPQ, and RQ backbones, TGRC-PQ consistently improves Recall@1/5/10 without increasing the stored code length; on COCO with a 32-bit PQ backbone, it improves average retrieval performance from 48.53 to 55.09. The benchmark features and evaluation protocol are released at https://huggingface.co/datasets/zhoukun/LightCMR-Bench.}
}
@article{TURKOGLUKAYA2026116804,
title = {Trust-weighted and Dirichlet aggregation for popularity bias mitigation in multi-criteria group recommendations},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116804},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116804},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015303},
author = {Tugba {Turkoglu Kaya}},
keywords = {Multi-criteria recommender systems, Group recommender systems, Aggregation strategies, Popularity bias},
abstract = {Popularity bias is a fundamental problem in recommender systems, as popular items tend to be over-represented while potentially relevant long-tail alternatives are overlooked. This issue becomes more pronounced in multi-criteria group recommender systems, where individual preferences are aggregated across multiple evaluation dimensions. Moreover, conventional average-based aggregation methods reinforce the dominance of popular items by ignoring important statistical factors such as rating frequency, sample size, reliability, and score distribution. To overcome these limitations, this study proposes two novel group aggregation strategies: the Trust-Weighted Aggregation Strategy (TR) and the Dirichlet-based Aggregation Strategy (DR). The TR strategy adopts a reliability-aware Bayesian weighting mechanism to moderate the influence of sparse or extreme ratings, while the DR strategy explicitly models rating distributions to reduce the dominance of frequently evaluated items and promote long-tail alternatives. In addition, a new evaluation metric, the Untendency Ratio (UR), is introduced to capture dominance effects and user–item tendency patterns in multi-criteria group recommendation settings. The proposed approaches are evaluated on four benchmark datasets from different domains using a comprehensive experimental framework. Experimental results show that TR improves accuracy and fairness by reducing the impact of dominant popular items, whereas DR enhances diversity and long-tail coverage. Overall, the findings demonstrate that integrating reliability-aware aggregation, distributional modeling, clustering-based group formation, and the UR metric provides an effective solution for mitigating popularity bias in multi-criteria group recommender systems.}
}
@article{ZHANG2026116828,
title = {Coupled Lévy-Convolutional Differential Evolution: An adaptive framework for UAV path planning in complex urban environments},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116828},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116828},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015546},
author = {Haobin Zhang and Yuqi Cheng and Hongjun San and Jiupeng Chen and Weiming Shen},
keywords = {UAV path planning, Differential evolution, Coupled Lévy search, Convolutional filtering mutation, Evolutionary algorithms},
abstract = {Three-dimensional UAV path planning in complex urban environments is a high-dimensional and non-convex optimization problem involving multiple coupled constraints. Although adaptive differential evolution algorithms have shown promising performance in solving such problems, they may still encounter search imbalance, premature convergence, and path oscillations when facing dense obstacles and deceptive fitness landscapes. To address these challenges, this paper proposes a Coupled Lévy-Convolutional Differential Evolution algorithm (CLC-DE). First, a probabilistically mixed dual-strategy evolutionary mode is designed to balance rapid convergence with robust exploration. Second, an Adaptive Coupled-Convolutional Mechanism (ACCM) is introduced to perform differentiated corrections according to the spatial distribution of stagnant individuals. Specifically, for discrete individuals located far from promising regions, a Convolutional Filtering Mutation (CFM) operator is employed to suppress random perturbations and guide a smoother return toward effective search regions. For individuals aggregated near local optima, a Coupled Lévy Search (CLS) operator incorporates long-tailed jumps and non-axial coupling transformations to enhance local-optimum avoidance. Experimental results on the CEC2017 benchmark suite demonstrate that CLC-DE achieves superior convergence accuracy and stability compared with several classical and advanced algorithms. Further UAV path planning simulations in complex urban environments show that CLC-DE can generate relatively short, safe, and smooth paths while satisfying obstacle-avoidance and kinematic constraints. These results indicate that the proposed method enhances the capability of differential evolution in solving high-dimensional constrained optimization problems and provides a promising optimization framework for autonomous UAV path planning in complex urban airspace. The source code of CLC-DE is available at: https://github.com/zhbyes/CLCDE.}
}
@article{ZHANG2026116780,
title = {RSTGS: Relightable Single-Tree Modeling with 3D Gaussian Splatting from Multi-View Images},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116780},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116780},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015066},
author = {Shusheng Zhang and Ziqing Wang and Shiyu Liu and Shuheng Liu and Jiakuan Han and Wei Wang and Xiaoran Miao and Mingyang Liu and Shang Wu and Jiangfeng She and Shengli Wang and Yihu Zhu},
keywords = {3D Gaussian Splatting, Relighting model, Real tree reconstruction},
abstract = {High-fidelity relighting models of trees are crucial for constructing realistic 3D geographic scenes. However, the intricate structural complexity of trees often leads to high computational costs in geometric reconstruction, and background interference in multi-view images can degrade reconstruction accuracy and illumination modeling quality. To address these issues, a novel approach, RSTGS: Relightable Single-Tree Modeling with 3D Gaussian Splatting from Multi-View Images, is proposed. RSTGS incorporates a parent–child Gaussian field supervision regularization mechanism to improve training stability while promoting multi-scale structural consistency through cross-level geometric and radiometric constraints. Additionally, a Gaussian density adaptive control mechanism driven by dual-domain gradient consistency is proposed to jointly constrain the spatial and normal domains, preserving geometric details while reducing redundant points. For illumination modeling, a geometry-aware incident illumination estimation method is employed, which extracts the dominant illumination direction from the input HDR environment map and guides incident-light sampling to improve illumination stability and produce more plausible shadow effects. Experiments on the NJU_Trees dataset, comprising three core benchmark scenes and nine additional validation scenes, together with the public TensoIR-Synthetic Ficus scene, demonstrate that RSTGS achieves competitive performance against representative SOTA approaches in novel view synthesis and relighting tasks for real-tree modeling.}
}
@article{HUTNIK2026116832,
title = {Context localization for generalized level-based evaluation in knowledge-based systems},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116832},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116832},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015583},
author = {Ondrej Hutník and Natália Puškárová},
keywords = {Knowledge-based systems, Context localization, Generalized level measure, Conditional aggregation operator, Monotone measure, Evidence selection, Structured uncertainty},
abstract = {We study context localization for generalized level-based evaluation in knowledge-based systems. The framework models situations where a structured nonnegative score, defined on facts, rules, cases, criteria or evidence units, is evaluated through conditional aggregation tests on admissible knowledge contexts. The generalized level measure maximizes a monotone set function over all contexts whose aggregated support reaches a prescribed level. We characterize when filtering the score by a context B is equivalent to first evaluating admissible contexts in the original system and then localizing their weights by intersection with B. The main theorem shows that this consistency holds for all monotone set functions if and only if two structural conditions are satisfied: nonincreasingness with respect to admissible contexts and a reduction property which eliminates positive level values on contexts not contained in B after masking. We analyze pointwise disjointness-based, block-generated and almost-everywhere mechanisms producing the reduction property, extend the result to parameterized systems, and interpret it as a stability criterion for context-dependent evidence selection, non-additive support evaluation and level-based knowledge aggregation. The theory is illustrated by a modular diagnostic knowledge base and by a data-based bearing-fault example.}
}
@article{KONG2026116893,
title = {HBGSA: Hydrogen Bond Graph with Self-Attention for drug-target binding affinity prediction},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116893},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116893},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016199},
author = {Junxiao Kong and Chupei Tang and Di Wang and Jixiu Zhai and Yi He and Moyu Tang and Tianchi Lu},
keywords = {Drug-target affinity, Hydrogen bonds, GNN, Correlation optimization, Structure-informed affinity prediction},
abstract = {Accurate prediction of drug-target binding affinity accelerates drug discovery by prioritizing compounds for experimental validation. Current methods face three limitations: sequence-based models discard spatial constraints, structure-based models often underuse hydrogen-bond features, and common losses optimize absolute error but not prediction-target correlation. We developed HBGSA (Hydrogen Bond Graph with Self-Attention), a 3.06M-parameter model for pose-aware affinity prediction. HBGSA combines a hydrogen-bond graph encoder, self-attention in the sequence and SMILES branches, and Pearson R loss. Results on PDBbind Core Set and CSAR-HiQ show competitive performance and stable generalization. Ablation studies confirm the effectiveness of hydrogen-bond modeling and Pearson R loss. Code and data are available at https://doi.org/10.5281/zenodo.18642011.}
}
@article{MORENOACEVEDO2026116877,
title = {Improved Named Entity Recognition in real-world applications for legal documents},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116877},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116877},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016035},
author = {Santiago A. Moreno-Acevedo and Juan Rafael Orozco-Arroyave},
keywords = {Named Entity Recognition, Deep Learning, Transformers, Law, Imbalanced data, Data augmentation},
abstract = {Named Entity Recognition (NER) is a topic of natural language processing (NLP) that has gained interest in the research community for its application in different law-related environments where the analysis of documents is crucial. So far, NER has been extensively studied in general contexts using non-realistic datasets, with many samples per class. However, typical real-world contexts do not have large amounts of data or balanced classes. This paper presents a methodology where these two problems are addressed. The approach includes a focal loss function incorporated into a transformer-based model and also the implementation of data augmentation techniques focused on NER data. The methodology is evaluated in three scenarios: (i) an ideal scenario with more than 11,000 samples and balanced classes with decisions of the German court; (ii) a standard scenario with a few samples, and classes with a medium level of imbalance from registrations of the Colombian Chamber of Commerce (CCC); and (iii) a scenario with a few samples from Spanish court decisions with a high imbalance among classes. The methodology yields promising and competitive results especially when data are scarce and highly imbalanced. In addition, we evaluated the generalization capability of the model from general to specific domains and from specific to specific domains. The model shows a promising knowledge generalization when considering different data domains, which is useful when working with reduced amounts of data.}
}
@article{ELBASRI2026116885,
title = {Leakage-aware evaluation of trainable quantum kernels for structured crash telemetry},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116885},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116885},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016114},
author = {Abdennacer Elbasri and Zouhair {Elamrani Abou Elassad}},
keywords = {Quantum machine learning, Trainable quantum kernels, Leakage-aware validation, Kernel-target alignment, Crash telemetry},
abstract = {Crash-state prediction from structured telemetry is a demanding setting for quantum machine learning because observations are imbalanced, locally dependent, and organized in repeated contexts. We evaluate fixed and trainable four-qubit fidelity kernels on a 75,906-row crash-telemetry release after auditing redundancy and row-order dependence. The audit motivates leave-one-inferred-session-out validation over four contiguous sessions, while shuffled row-wise validation is retained only to quantify optimism. Under the conservative protocol, leakage-safe F1-tuned LightGBM provides the strongest classical operating point. The globally trainable quantum route improves balanced accuracy by 0.0855 over its matched fixed comparator, but it does not exceed the strongest classical controls. A knowledge-informed grouped route also fails to establish distributed telemetry use: its performance is nearly recovered from the environment block, while the alignment objective suppresses vehicle-motion information that remains predictive in isolation. The study therefore contributes a dependence-aware diagnostic framework rather than a superiority claim. It combines fold-safe preprocessing, matched fixed-to-trainable comparison, operating-point analysis, strong classical controls, kernel diagnostics, and dominant-block recoverability to distinguish genuine trainability gains from validation optimism and block-level collapse.}
}
@article{NATH2026116889,
title = {An evolutionary phase-aware framework for discovering and optimizing high-impact agents in dynamic systems},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116889},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116889},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016151},
author = {Keshab Nath},
keywords = {Phase-aware impact modeling, Evolutionary optimization, Hidden impact agents, Context-sensitive performance analysis, Disruption sensitivity, Complex adaptive systems, Dynamic systems analytics, Evolutionary algorithms, Multi-agent systems, Decision-critical agent identification},
abstract = {Identifying key factors in dynamic and complex systems is a fundamental challenge in a variety of fields, including sports, organizational decision making, healthcare, and cybersecurity infrastructure. Traditional assessment methods rely heavily on average performance metrics, which often fail to account for context-dependent, time-dependent, and pressure-driven factors. This paper presents a phase-based and evolutionary framework for discovering hidden key factors whose contributions are selectively revealed under specific operating conditions. The framework decomposes system activity into distinct operational phases and introduces context-dependent performance metrics that quantify their relative contribution, effectiveness, and failure sensitivity. A new failure sensitivity coefficient is formulated to account for the nonlinear impact of critical events during high-pressure phases. Based on this formulation, impact identification is reconceptualized as an evolutionary optimization problem, where agents adapt and compete under phase-specific selective pressures. Agent characteristics are encoded as chromosomes, the proposed influence metric serves as a fitness measure, and evolutionary operators such as selection, crossover, and mutation enable adaptive optimization of agent compositions over time. Extensive experimental analysis across various competitive and operational scenarios demonstrates that the proposed framework consistently identifies influence factors undetectable by traditional ranking or reward methods. Evolutionarily optimized agent populations exhibit greater robustness, efficiency at each stage, and improved system-level performance compared to static selection. The framework is inherently domain-independent and can be applied to identifying critical players in sports, crisis responders in organizations, physician decision makers in healthcare, and critical nodes in cybersecurity. This work establishes influence detection as a contextual, stage-dependent, and evolutionary process and offers a unified, interpretable, and extensible approach to analyzing and optimizing performance in complex adaptive systems.}
}
@article{LIANG2026116691,
title = {Efficient state space model via fast tensor convolution and block diagonalization},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116691},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116691},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014176},
author = {Tongyi Liang and Han-Xiong Li},
keywords = {Deep learning, Neural networks, State space models, Sequence modeling},
abstract = {Existing models encounter bottlenecks in balancing performance and computational efficiency when modeling long sequences. Although the state space model (SSM) has achieved remarkable success in handling long sequence tasks, it still faces the problem of large number of parameters. In order to further improve the efficiency of SSM, we propose a new state space layer based on multiple-input multiple-output SSM, called efficient SSM (eSSM). Our eSSM is built on the convolutional representation of multi-input and multi-output (MIMO) SSM. We propose a variety of effective strategies to improve the computational efficiency. The diagonalization of the system matrix first decouples the original system. Then a fast tensor convolution is proposed based on the fast Fourier transform. In addition, the block diagonalization of the SSM further reduces the model parameters and improves the model flexibility. Extensive experimental results show that the performance of the proposed model on multiple databases matches the performance of state-of-the-art models, such as S4, and is significantly better than Transformers and LSTM. In the model efficiency benchmark, the parameters of eSSM are only 12.89% of LSTM and 13.24% of Mamba. The training speed of eSSM is 3.94 times faster than LSTM and 1.35 times faster than Mamba. Code is available at: https://github.com/leonty1/essm.}
}
@article{LI2026116808,
title = {Improved ship-radiated noise recognition using a pre-trained noise reduction module combined with feature optimization network},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116808},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116808},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015340},
author = {Zhongjie Li and Yunye Feng and Haonan Xing and Meng Ge and Tianrui Wang and Jun Tang and Lin Gan and Gaoyan Zhang},
keywords = {Ship-radiated noise recognition, Deep neural networks, Ship-radiated noise reduction, Prototypical networks},
abstract = {Ship-radiated noise recognition (SRNR) plays a vital role in underwater acoustic target recognition; however, it remains challenging due to environmental interference and the intra- and inter-class similarity (IICS) problem. To address these challenges, we propose a Dual-Strategy Framework for Ship-Radiated Noise Recognition (DSF-SRNR), which integrates signal-level marine environmental noise reduction with embedding-level feature optimization. Specifically, an end-to-end time-domain denoising front-end is pretrained using simulated mixtures of ship-radiated noise and natural marine ambient noise, aiming to reduce the influence of background interference while avoiding manual parameter adjustment and time–frequency domain transformation. For feature optimization, prototype-based regularization is incorporated into the conventional classification objective to encourage more compact intra-class embeddings and more separable inter-class representations. Moreover, a batch-compatible episodic training scheme is used to construct support and query subsets during training, allowing prototype-based constraints to be integrated into standard closed-set SRNR optimization. Experimental results on the public DeepShip dataset show that the proposed strategy-level integration improves SRNR performance with moderate model complexity. The ablation results further indicate that task-oriented fine-tuning of the denoising front-end is important for reducing the mismatch between waveform-level denoising and downstream classification. Additional backbone experiments suggest that the framework can provide consistent benefits without substantially increasing the parameter scale.}
}
@article{YIN2026116881,
title = {Exploring imbalanced multimodal learning from intra-modality information learning perspective},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116881},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116881},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016072},
author = {Hang Yin and Yue Xu and Ji Zhao and Xuehe Zhang},
keywords = {Imbalanced multimodal learning, Intra-modality information learning, Manifold learning, Multimodal mixture of experts},
abstract = {Multimodal learning advances artificial intelligence toward human-like perception by integrating vision, audio, and language. However, models can underperform compared with unimodal counterparts because dominant modalities receive excessive updates while weaker ones are under-optimized, limiting multimodal synergy. Existing methods reduce contribution differences across modalities but ignore imbalances between modality-invariant and modality-specific features within each modality. We address this by investigating multimodal learning from intra-modality information learning perspective and propose a multimodal mixture-of-experts network with mutual information to separate unimodal features into modality-invariant and modality-specific components. We further introduce a manifold learning based method that quantifies modality contributions by approximating Fisher information through the curvature of perceptual manifolds. We also design a weighted single-branch loss to reduce contribution disparities within each modality, promoting more complete unimodal learning. Extensive experiments conducted on three benchmark datasets, namely IEMOCAP, CMU-MOSEI and AVE, have verified the rationality and effectiveness of this method.}
}
@article{WANG2026116792,
title = {FMARLJP:Multi-agent legal judgment prediction based on fine-grained meta-roles and adaptive retrieval mechanism},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116792},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116792},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015182},
author = {Hongyu Wang and Zhi Zhao and Songtao Ding and Ke Fang},
keywords = {Legal Judgment Prediction, Multi-agent systems, Dynamic knowledge retrieval, Hierarchical role decoupling},
abstract = {Legal Judgment Prediction (LJP) is vital for mitigating judicial resource constraints and unifying adjudicative standards. However, traditional deep learning methods suffer from “black-box” limitations, while existing single-agent and multi-agent Large Language Model (LLM) paradigms face structural bottlenecks, including role-specific cognitive overload and rigid knowledge acquisition, leading to reasoning gaps and hallucinations. To address these challenges, we propose FMARLJP, a novel multi-agent framework. First, we establish a hierarchical “Core Role—Meta-Role” architecture, decoupling complex legal tasks into specialized clusters to reduce individual cognitive load and mitigate attention dispersion. Second, we develop a dynamic knowledge retrieval and integration mechanism; by employing iterative querying and semantic anchoring, the framework achieves adaptive alignment between external legal knowledge and internal reasoning, overcoming the limitations of static retrieval. Finally, a full-chain judgment refinement module is designed to ensure rigorous “factor-conclusion” mapping and eliminate logical deviations. Experimental results on authoritative datasets demonstrate that FMARLJP achieves state-of-the-art (SOTA) performance. This validates that fine-grained meta-role decoupling and dynamic retrieval significantly enhance the accuracy, logical completeness, and interpretability of LJP.}
}
@article{LIANG2026116864,
title = {CoMAG: Collaborative GNN–LLM learning for multimodal attributed graphs},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116864},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116864},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601590X},
author = {Sicheng Liang and Yihao Wen and Chunpu Huang and Yu Liu and Yichen Nie and Jingqi Feng and Yukai Huang and Jiawei Ye and Jie Wu},
keywords = {Multimodal attributed graphs, Graph neural networks, Large language models, Zero-shot learning, Multimodal reasoning},
abstract = {Multimodal Attributed Graphs (MAGs), which combine textual, visual, and structural information, are prevalent in domains such as e-commerce and social media. However, zero-shot reasoning on MAGs remains challenging. Existing graph neural networks can produce biased representations under modality imbalance and typically depend on task-specific supervision, whereas multimodal large language models (MLLMs) exhibit strong cross-modal reasoning ability but lack explicit modeling of graph structure. To address these challenges, we propose CoMAG, a collaborative framework that unifies graph-enhanced multimodal representation learning with frozen-MLLM reasoning. CoMAG extracts modality-specific embeddings via frozen encoders and refines them through self-supervised graph learning. It further derives discrete structural priors as symbolic tokens and aligns continuous graph representations with the frozen MLLM token space, enabling prompt-based inference without target labels or task-specific fine-tuning. A structure-aware reasoning layer then introduces salience-aware structural cues, label-free adaptive fusion, and neighborhood-consistent smoothing to improve reliability. Extensive experiments on real-world MAG datasets and multiple frozen MLLM backbones demonstrate that CoMAG achieves strong zero-shot performance across diverse graph domains. Further analyses confirm its robustness to modality perturbations, the complementary contributions of its graph–language interfaces, the transferability of its learned relational representations, and the limited overhead of its graph-side interface.}
}
@article{ZHU2026116829,
title = {RMCCA-AE: A residual multimodal canonical correlation analysis autoencoder for emotion recognition using EEG signals and eye movement data},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116829},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116829},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015558},
author = {Mu Zhu and Zhongli Bai and Qingzhou Wu and Yu Song and Qiang Gao},
keywords = {Multimodal fusion, Electroencephalogram (EEG), Eye movement (EM), Deep canonical correlation analysis},
abstract = {Electroencephalogram (EEG)-based multimodal emotion recognition, an important topic in human-computer interaction, plays a crucial role in improving the reliability of emotion recognition and enhancing the understanding of the interaction between various physiological signals. To improve the interpretability of deep learning model, we propose a Residual Multimodal Canonical Correlation analysis autoencoder (RMCCA-AE) based on the intermodal correlation theory. RMCCA-AE uses lightweight structures (such as ResMLP) to construct modal correlation features via a Deep Canonical Correlation Analysis (DCCA) encoder based on the intermodal correlation theory. A decoder is used to reconstruct each mode characteristic to solve the modal characteristic loss problem. Finally, the classification results are output using codec decision fusion. Following construction, we performed subject-dependent and subject-independent experiments on the model to test its performance, achieving state of the arts (SOTA) results on both the SEED-IV and SEED-V datasets. In addition, through the visualization of intermodal correlation, we found that the improvement in the correlation response can effectively improve the model classification effect, which makes the explanation of the improvement in model classification performance more reliable.}
}
@article{ZHU2026116816,
title = {TraceBack: Sequence-enhanced and causality-driven attack scenario reconstruction from provenance graphs},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116816},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116816},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601542X},
author = {Tiantian Zhu and Mingda Li and Zijun Wang and Wenrui Cheng and Qianqian Chen and Jiaobo Jin and Mingjun Ma and Han Wu and Zhengqiu Weng and Guolang Chen},
keywords = {Provenance graph, Causal analysis, Sequence modeling, Attack knowledge, APT investigation system},
abstract = {In recent years, advanced persistent threat (APT) attacks have significantly increased, causing severe damage to critical industries. Attack investigation based on provenance graphs helps analysts trace attack entry points and assess the impact. However, current methods still face challenges such as dependency explosion, high false negatives, and high false positives. To address these issues, we propose an attack investigation system named TraceBack. We first optimize the provenance graph to reduce dependency explosion and then apply point-of-interest-based causal analysis on the compressed graph to filter out irrelevant events and entities. This approach reduces the provenance graph to be analyzed and the overhead of the investigation process while maintaining low false negatives. Finally, we propose a sequence-enhanced APT attack investigation method that extracts semantically rich entities and events and uses a variational autoencoder to score and prioritize candidate sequences within the POI-bounded graph, effectively reducing irrelevant events in the reconstructed attack scenario. Experimental results demonstrate that TraceBack delivers strong performance on public datasets: the generated key-component graph averages 64 edges, with no false negatives on the evaluated scenarios under a globally fixed configuration, and 23× fewer false positives than the compared DEPIMPACT implementation.}
}
@article{WANG2026116837,
title = {QuadKAN: KAN-enhanced quadruped motion control via end-to-end reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116837},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116837},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015637},
author = {Yinuo Wang and Xiaowen Tao},
keywords = {Quadrupedal robots, Vision-driven locomotion, Reinforcement learning, Multi-modal fusion, End-to-end policy learning},
abstract = {We address vision-guided quadruped motion control with reinforcement learning (RL) and highlight the necessity of combining proprioception with vision for robust control. We propose QuadKAN, a spline-parameterized cross-modal policy instantiated with Kolmogorov–Arnold Networks (KANs). The framework incorporates a spline encoder for proprioception and a spline fusion head for proprioception–vision inputs. This structured function class encodes a spline-based inductive bias motivated by the piecewise-smooth structure of gait. We adopt Multi-Modal Delay Randomization (MMDR) and perform end-to-end training with Proximal Policy Optimization (PPO). Evaluations across diverse terrains, including both even and uneven surfaces and scenarios with static or dynamic obstacles, show that QuadKAN attains higher mean returns relative to the evaluated baselines, together with competitive collision avoidance and travel distances. These results show that spline-parameterized policies offer a simple, effective, and interpretable alternative for robust vision-guided locomotion. A repository is hosted at https://github.com/allen-quad-robot/quadkan.}
}
@article{CHEN2026116752,
title = {Masked feature adversarial disentanglement network for single-source domain generalization mechanical fault diagnosis},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116752},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116752},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014784},
author = {Guiping Chen and Dong Xiang and Tingting Liu and Feng Xu},
keywords = {Domain generalization, Fault diagnosis, Feature disentanglement, Contrastive learning, Adversarial learning},
abstract = {Domain generalization in fault diagnosis aims to construct models with strong generalization ability to accurately identify mechanical faults under unseen operating conditions. However, existing methods typically rely on multi-source domain data for training, whereas in practical industrial systems, fault samples are often limited and collected under a single operating condition. Consequently, learning domain-invariant feature representations from single-domain data remains a critical challenge for achieving robust generalization. Although some studies have attempted to synthesize unseen-condition samples using generator modules via style transfer or distribution transformation, the complex spatiotemporal characteristics and non-stationarity of vibration signals across multiple operating modes make accurate sample generation difficult. To address this issue, this paper proposes a masked feature adversarial disentanglement-based single-source domain generalization method for fault diagnosis of rotating machinery under unseen conditions. Specifically, a multi-scale convolutional kernel-based style generation strategy is first adopted to produce augmented samples containing rich state information , while contrastive learning and Manhattan distance constraints preserves the embedding features consistency between original and augmented samples. Then, a masked feature adversarial disentanglement mechanism is designed to decouple the extracted embedding features into superior and inferior components, thereby improving the generalization of feature representations. Extensive experiments conducted on two bogie bearing datasets demonstrate that the proposed method outperforms existing single-source domain generalization approaches in terms of generalization performance.}
}
@article{GUO2026116727,
title = {DLRM-FER: Self-evolving dual-loop neuro-symbolic learning via dynamic rule memory for explainable facial expression recognition},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116727},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116727},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601453X},
author = {Tianfu Guo and Kohei Inoue},
keywords = {Facial expression recognition (FER), Explainable artificial intelligence (XAI), Neuro-symbolic learning, Dual-loop closed-loop learning, Dynamic rule memory},
abstract = {Deep learning-based facial expression recognition (FER) models have made significant progress, but most still lack interpretability, and existing explainable models often sacrifice accuracy in pursuit of explainability. To address this bottleneck, we propose an adaptive attention-driven dynamic rule bank closed-loop explainable learning framework. This framework introduces an Adaptive Bi-Stream Emotion-Selective Attention (ABESA) mechanism, which captures both global emotional semantics and local muscle activations through adaptive weighting. By leveraging attention saliency, the framework constructs a self-evolving symbolic rule bank without relying on Action Unit (AU) annotations or prior knowledge. The rules are continuously updated in real time based on attention-category consistency, either strengthening or discarding them. These explainable rules serve both as explanatory signals and corrective feedback to guide the model’s decision-making, constructing the first autonomous neuro-symbolic system with two explicit loops: a training-time learning loop (rule-consistency supervision reshapes attention via back-propagation) and an inference-time self-correction loop (uncertainty-triggered rule lookup and correction). Our approach is evaluated on major FER datasets. Our results compares favorably to state-of-the-art methods on explainable FER models, and achieves competitive performance compared with the mainstream non-interpretable FER deep learning methods, thus validating its ability to balance high accuracy with strong self-explainability in affective computing.}
}
@article{SINGH2026116825,
title = {Deep transfer learning approach for multi-channel active noise control},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116825},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116825},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015510},
author = {Deepali Singh and Rinki Gupta and Arun Kumar and Rajendar Bahl},
keywords = {Multi-channel active noise control, Deep learning, Transfer learning, Anechoic room},
abstract = {Conventional multi-channel active noise control (ANC) relies on adaptive filtering with an individual controller for each channel. This study proposes a multi-channel stacked autoencoder (MC-SAE), a deep learning model, for multi-channel ANC in practical scenarios. The proposed MC-SAE is trained to model the secondary path and predict the anti-noise to be played at each secondary loudspeaker, achieving attenuation of noise at multiple error microphones. Using computer-simulated noise as training data, MC-SAE is subsequently fine-tuned using real-world noise recordings via transfer learning. These real-world recordings, captured in an anechoic chamber, consist of both broadband and tonal noise components. In practical setups, nonlinearities introduced by both the loudspeakers and acoustic pathways lead to complex distortions that must be considered during multi-channel ANC. The performance of the proposed MC-SAE system is investigated across various configurations to demonstrate the effect of the number of loudspeakers, the quantity of microphones, and the placement of secondary sound sources on overall ANC effectiveness. Experimental results show that MC-SAE achieves a noise reduction (NR) of up to 11.37dB using four secondary loudspeakers and four error microphones for wideband noise. Moreover, the proposed MC-SAE extends the useable quiet zone (NR > 10 dB) to a radius of approximately 0.35 m in the perpendicular direction around the error microphone for realistic noise types, compared to approximately 0.1 m achieved by the Filtered-X Least Mean Square (FxLMS) technique, and also outperforms other cutting-edge deep learning methods.}
}
@article{AO2026116797,
title = {ConVoxel: From complementarity to consistency in multi-voxel 3D object detection},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116797},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116797},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015236},
author = {Lei Ao and Dejene M. Sime and Nan Ouyang and Kai Sheng and Xiaojiang Ren and Yiting Liu and Xin He and Yoshiki Yamaguchi},
keywords = {3D object detection, Autonomous driving, Multivoxel, Point cloud},
abstract = {3D object detection is a cornerstone technology for environmental perception in autonomous driving systems. However, existing voxel-based methods face key challenges. Single-resolution paradigms suffer from quantization artifacts. Conversely, multi-resolution paradigms that pursue feature complementarity by fusing disparate scales often introduce semantic conflicts and feature degradation. This paper challenges the conventional complementarity-based approach. We propose ConVoxel, a novel framework built on the principle of feature consistency. Instead of fusing heterogeneous features, ConVoxel generates multiple ‘views’ of the point cloud using proximate-resolution grids. These views are treated as redundant representations for verification. We first use a Shared Sparse Multi-view (SSM) backbone to extract features in a unified semantic space. Then, our novel Multi-view Feature Fusion (MVFF) network dynamically verifies and reinforces consistent object features while suppressing quantization noise. Extensive experiments on the authoritative KITTI dataset demonstrate that ConVoxel improves upon the SECOND baseline by 2.01% mAP, demonstrating the superiority of the consistency-based paradigm.}
}
@article{TANG2026116740,
title = {AMC-GPT: Integrating physics-informed interference emulation into Generative Pre-trained Transformers for AMC},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116740},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116740},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014668},
author = {Xin Tang and Shuyuan Yang and Zhixi Feng and Yifan Gai and Yujia Xie},
keywords = {Automatic modulation classification, Self-supervised learning, Co-channel interference emulation, Few-shot learning},
abstract = {Automatic Modulation Classification (AMC) is a challenging time-series pattern recognition task, often hindered by complex environmental distortions and massive intra-class variance. While Transformer architectures excel in sequential representation learning, their heavy reliance on large-scale labeled datasets severely limits their applicability in data-scarce, real-world scenarios. To address this fundamental bottleneck, we propose AMC-GPT, a novel Generative Pre-trained Transformer framework designed for robust, few-shot signal classification. We develop Co-Channel Interference Emulation (CCIE) as a physics-informed self-supervised pretext task. Unlike heuristic noise injection, CCIE models realistic signal superposition, compelling the network to disentangle robust, modulation-discriminative representations directly from unlabeled temporal mixtures. Through generative pre-training, AMC-GPT drastically mitigates annotation dependency. Extensive experiments demonstrate it matches fully supervised state-of-the-art models using merely n=100 labeled samples (per class and SNR)—an over 90% reduction. This establishes a robust, data-efficient paradigm for pattern recognition in complex environments.}
}
@article{CHOI2026116894,
title = {A path-aware Bayesian optimization (PABO) framework for cost-efficient sampling site exploration},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116894},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116894},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016205},
author = {Sungkyu Choi and Eunje Jeong and Ungki Lee},
keywords = {Bayesian optimization (BO), Path-aware Bayesian optimization (PABO), Adaptive directional sampling region (ADSR), Path-aware acquisition function, Marine geological exploration},
abstract = {This study proposes a path-aware Bayesian optimization (PABO) framework for cost-efficient optimization in applications where both sampling and movement costs are significant. Conventional Bayesian optimization (BO) methods primarily focus on reducing the number of function evaluations, while recent cost-aware and distance-aware approaches consider either sampling cost or movement cost separately. However, these approaches do not explicitly address the trade-off between sampling effort and travel effort within a unified framework. To overcome this limitation, a unified cost formulation is proposed to jointly account for sampling and movement costs. Based on this formulation, the proposed framework integrates an adaptive directional sampling region (ADSR) and a path-aware acquisition function. The ADSR promotes spatially coherent exploration by adaptively restricting the search space according to geometric distance and model uncertainty, while the acquisition function balances expected improvement and operational cost to improve overall exploration efficiency. The effectiveness of the proposed framework is demonstrated through benchmark problems, sensitivity analyses, and parametric studies under various cost configurations, which consistently show that PABO reduces total cost compared with conventional BO methods. Furthermore, the applicability of the proposed framework is demonstrated using geological datasets in the context of marine geological exploration problems. In these realistic exploration scenarios, PABO achieves statistically significant improvements in total cost, number of added samples, and total travel distance. The results demonstrate that jointly considering sampling cost, movement cost, and path consistency within a unified framework can improve cost efficiency in practical spatial optimization problems.}
}
@article{JIAO2026116768,
title = {Observable quotient world models for knowledge-state abstraction under partial observability},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116768},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116768},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014942},
author = {Yan Jiao and Pin-Han Ho and Limei Peng},
keywords = {Knowledge-state abstraction, Quotient belief, Information gain, World models, Knowledge representation},
abstract = {Partially observable intelligent systems require knowledge-state representations that preserve sensing-supported distinctions while suppressing nuisance variation unsupported by the observation process. Existing latent world models learn useful predictive states, but their representation targets are often shaped by reconstruction, prediction, task supervision, or architectural bias rather than by observable distinguishability. This paper introduces Observable Quotient Theory, a sensing-induced state-abstraction framework defined through action-conditioned canonicalized observation laws. States indistinguishable under the admissible sensing-action family form observable quotient classes, inducing quotient beliefs, quotient-level dynamics under closure assumptions, recursive filtering, and quotient information gain (QIG) for sensing-action selection. We further propose the Quotient World Model (QWM), a neural world model inspired by this theory that learns quotient-relevant representations, beliefs, canonicalized observation predictions, transition models, and QIG-based sensing-action scores under fixed benchmark and passive-proxy protocols, without identifying learned latents with formal quotient states. A controlled non-radar Gaussian diagnostic benchmark, COGS, isolates observable-quotient mechanisms and evaluates action-family refinement, nuisance suppression, QIG-based entropy reduction, and avoidance of unsupported distinctions under insufficient observability. Controlled QuotientWorld experiments further provide benchmark-label representation, belief prediction, transition fitting, ablation, and finite-horizon active-sensing diagnostics. Passive CARRADA and V2X-Radar evaluations provide bounded proxy evidence for representation and dynamics behavior on logged real-radar data, with non-uniform performance across metrics and perturbations. Overall, the results support observable-quotient structure as a practical organizing principle for sensing-induced knowledge-state abstraction and quotient-relevant world modeling under controlled, sequential, and passive-proxy evaluations.}
}
@article{WANG2026116857,
title = {Reinforced frequency-guided self-distillation for edge-friendly lightweight models},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116857},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116857},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015832},
author = {Jinlong Wang and Shuwen Tian and Haoran Zhao and Yuyan Sun and Junyu Dong and Xin Sun},
keywords = {Knowledge distillation, Self-distillation, Deep learning, Image classification, Spectral convolution, Reinforcement learning},
abstract = {Despite significant advances in knowledge distillation for producing compact models, traditional distillation methods frequently require complex and time-consuming training pipelines. In contrast, self-distillation provides a teacher-free and computationally efficient alternative. However, existing self-distillation methods only operate in homogeneous domains (e.g., spatial), limiting global context modeling and exacerbating locality bias. Moreover, owing to the frequency principle, DNNs tend to result in degraded performance. In this study, we propose a novel and efficient method called reinforced frequency-guided self-distillation (RFSD). Specifically, we designed a wavelet receptive field enhancer (WRFE) module that captures global contextual information from backbone spatial features using wavelet-based spectral convolution, followed by cross-domain supervision recalibration (CSR) that allowed bidirectional self-distillation between spatial and frequency representations. Simultaneously, a reinforcement learning-based frequency denoising agent (RFDA) was introduced to adaptively suppress noisy high-frequency components, where the agent was optimized using an instance-level contrastive reward to improve feature discrimination. We demonstrated the effectiveness and superiority of the proposed method with various architectures on multiple datasets as well as consistent improvements in classification performance over existing approaches.}
}
@article{DUBEY2026116817,
title = {Causal-CISP: Hybrid causality and adaptive security for robust federated learning under adversarial threats},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116817},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116817},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015431},
author = {Praveer Dubey and Mohit Kumar},
keywords = {Federated learning, Adversarial attacks, Causal inference, Representation isolation, Homomorphic encryption, Game theory, Security},
abstract = {Causal Inference with Secure Protocols (Causal-CISP) introduces a unified and modular defense framework for Federated Learning (FL) that effectively mitigates adversarial risks while preserving privacy, interpretability and efficiency. Existing FL defenses are often fragmented in design, limited to specific attack scenarios and prone to significant performance degradation when confronted with heterogeneous, non-identically distributed (non-IID) client data conditions common in real world deployments. Causal-CISP overcomes these constraints through three principled components: (i) Causal Inference for Adversarial Attribution (CIAA), which utilizes shifts in relative accuracy between consecutive terms to estimate Individual Treatment Effects (ITE) for transparent attribution of adversarial updates, achieving 95% precision and recall on MedMNIST, (ii) Homomorphic Encryption with Dynamic Trust Scaling (HEDTS), which adapts encryption strength to client trust scores, reducing communication overhead compared to SMPC and (iii) Game Theoretic Incentive and Penalty Model (GTIPM), which applies Stackelberg game theory to incentivize honest participation, achieving near optimal trust entropy (1.6093 vs. ideal 1.6094). Evaluations on CIFAR-10, EMNIST and MedMNIST under realistic non-IID conditions demonstrate that Causal-CISP maintains high model accuracy (83%–89%), lowers attack success rates to ≤0.08 and preserves privacy (PSNR ≤ 0.20) without false positives establishing it as a scalable, interpretable and domain agnostic defense against poisoning, backdoor and free-riding attacks.}
}
@article{WANG2026116841,
title = {A transfer learning-based approach for pheochromocytoma and surrounding multi-organ segmentation in abdominal CT images},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116841},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116841},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015674},
author = {Genxiu Wang and Junying Zeng and Enming Cui and Bin Zheng and Xudong Jia and Jin Wen and Maoqing Hu and Chuanbo Qin},
keywords = {Medical image segmentation, Transfer learning, Pheochromocytoma, Abdominal multi-organ, End-to-End model},
abstract = {Pheochromocytoma is a rare endocrine tumor in urological surgery. Accurate differentiation of the tumor from adjacent abdominal organs and renal vessels is a crucial step in preoperative diagnosis and surgical planning for abdominal pheochromocytoma. In this paper, to address the aforementioned challenges and allow domain experts to focus on learning for the segmentation task to improve the segmentation accuracy of the tumor and surrounding multiple organs, a detail-supplementing convolutional branch is introduced into the domain expert model architecture to improve the segmentation performance on small-sized and variably shaped targets. A spatial multi-scale adapter is integrated, which outputs features enriched with spatial prior information through multi-level spatial adapters that can learn task inductive biases. A global-local feature fusion module is embedded, aiming to capture global features at different levels and combine them with the decoder's output to generate detailed boundary information. In addition, the majority of pre-trained parameters are retained for reuse. During the learning process, a parameter-efficient strategy is adopted, keeping most pre-trained parameters in a frozen state. Experiments were conducted on one public abdominal multi-organ CT dataset, one public renal artery and vein CT dataset, and one private pheochromocytoma CT dataset. The experimental results show that, with ten-point prompts, our proposed method achieved a 2.84 improvement in the average Dice score for pheochromocytoma and surrounding multiple organs compared with the SAM-Med3D, SegVol, SAT-Pro, 3D UX-Net, nnUNet ResEnc L, SwinUNETR-V2, CoTr, and nnFormer segmentation frameworks.}
}
@article{HAN2026116853,
title = {FDHNet: Frequency-aware decomposition with hypergraph modeling network for real-time surface defect segmentation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116853},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116853},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015790},
author = {Yan Han and Yangyong Mu and Qingqing Huang and Yan Zhang and Min Wei and Seungho Hong},
keywords = {Defect segmentation, Hypergraph, Wavelet transform, Edge-assisted supervision},
abstract = {Surface defect segmentation plays a vital role in automated quality inspection, yet it remains challenging due to weak defect appearance and ambiguous boundaries. While deep encoder-decoder networks have made significant strides, their exclusive reliance on spatial-domain features hinders the perception of subtle frequency-domain cues, and conventional pairwise graph models fail to capture high-order spatial dependencies among defect pixels. To address these limitations, we present a real-time network that integrates learnable wavelet Frequency Decomposition with Hypergraph modeling (FDHNet). Specifically, a frequency decoupling module is designed to adaptively select task-relevant frequency bands, enhancing defect representation while preserving precise spatial localization. A hypergraph spatial correlation module is then constructed to model multi-pixel high-order interactions, effectively capturing the topological continuity of cracks and scratches. Furthermore, an adaptive feature distribution scheme and edge-guided supervision are introduced to refine boundary precision. Extensive experiments on three industrial defect datasets demonstrate that FDHNet achieves state-of-the-art segmentation accuracy with real-time inference speed, offering a favorable accuracy-efficiency trade-off for practical surface inspection.}
}
@article{WANG2026116749,
title = {pDFL: Knowledge-aware adaptive aggregation for personalized decentralized federated learning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116749},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116749},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014759},
author = {Shuai Wang and Youliang Tian and Axin Xiang and Jinbo Xiong and Jianfeng Ma},
keywords = {Decentralized federated learning, Personalized decentralized learning, Knowledge fusion, Attention, Knowledge distillation},
abstract = {Decentralized federated learning (DFL) is gaining traction as a practical solution that keeps data stationary while moving models, positioning itself as a key technology for next-generation edge intelligence; it enables serverless collaboration among resource-heterogeneous devices without the need to transmit raw training samples. However, existing personalized DFL methods lack effective mechanisms for structured neighborhood knowledge fusion, treating heterogeneous peer models as uniformly reliable knowledge sources. This coarse-grained fusion paradigm struggles to capture domain relevance across clients, leading to suboptimal knowledge transfer, weakened personalization, and unstable learning dynamics in highly non-IID environments. We propose pDFL, a personalization-oriented DFL framework that learns whom to trust and how to exchange knowledge. First, to quantify neighbor value under evolving heterogeneity, we propose a multi-head attention-guided weighted aggregation mechanism. This mechanism learns context-aware neighborhood influences from knowledge representations, adaptively assigning weights to distributed neighbors to suppress mismatched peers and thus mitigate harmful averaging effects and model drift. Second, To remedy the limitations of one-way distillation, we construct a bidirectional knowledge-distillation mechanism that couples rapid local adaptation with shared-representation alignment. Inward knowledge distillation (KD) rapidly personalizes classifiers by calibrating soft targets through selected neighborhoods, while outward KD propagates domain expertise from each client back to peers to coordinate decision boundaries. Concurrently, the local training phase further stabilizes the optimization process by first adapting personalized heads and then coordinating shared representations. Extensive experiments on CIFAR-10, CIFAR-100 and Tiny-imagenet under Dirichlet and pathological partitions show that pDFL converges slightly faster than state-of-the-art baselines, with accuracy gains of about 1%–2% percent, while requiring 5%–20% percent fewer rounds to reach the target accuracy. These results indicate that learned attention guided aggregation combined with reciprocal distillation provides a targeted and effective improvement for stable personalization in decentralized and highly non-IID edge environments.}
}
@article{SUN2026116854,
title = {PE2Prompt: a large language model-native framework for interpretable static malware analysis},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116854},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116854},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015807},
author = {Yilin Sun and Mohammad Masum},
keywords = {Static malware detection, Large language models, Prompt engineering, EMBER dataset, Zero-shot classification},
abstract = {Large Language Models (LLMs) possess strong general-purpose reasoning abilities, yet their integration into static malware analysis pipelines remains limited due to the representational gap between high-dimensional numerical features and the natural-language input format required for inference. This study introduces PE2Prompt, a Large Language Model-native framework for interpretable and industrially deployable static malware analysis. PE2Prompt formalizes a modular process that bridges numeric PE features and LLM reasoning through three key components: (1) LLM-guided feature curation directly from raw EMBER JSON fields to identify semantically relevant attributes; (2) numerical feature summarization, compressing byte-histogram and entropy distributions into interpretable descriptors; and (3) structured prompt construction, transforming curated PE semantics into language-based reasoning templates. We evaluate zero-shot and few-shot prompting across GPT-4o-mini, Claude 3.7 Sonnet, and DeepSeek-Chat, analyzing classification accuracy, recall asymmetry, latency, and inference cost under varying feature-selection thresholds. Claude achieves the most balanced performance (≈73% accuracy) while DeepSeek-Chat demonstrates improved stability under structured prompting (≈59%), and GPT-4o-mini achieves below-random accuracy (≈49%) with a pronounced benign bias. Beyond empirical performance, PE2Prompt establishes a reproducible methodology for integrating LLM reasoning within static malware workflows, defining a new feature-to-language reasoning paradigm that advances explainable, adaptable, and zero-retraining malware analysis for industrial cybersecurity environments. To facilitate reproducibility, transparency, and future benchmarking, all source code, prompting pipelines, and experimental scripts are publicly available through an open-source repository.}
}
@article{KOTHARI2026116761,
title = {Multimodal emotion recognition using hybrid deep learning architecture},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116761},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116761},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014875},
author = {Nirmal S. Kothari and Sagar A. More and Narendra S. Jadhav},
keywords = {Multimodal Emotion Recognition, Deep learning, MA-CEEMDAN, EMS-PNCC, SPP-LNet},
abstract = {Multimodal emotion recognition plays a crucial role in advancing human-computer interaction through understanding of emotions. By combining Electroencephalogram (EEG) signals and audio data, Artificial Intelligence (AI) technologies process cognitive information. The fusion of EEG and audio signals bridges the divide between machine performance and the complexity of human emotions, enabling the development of responsive artificial systems. The central challenge for researchers is building models that can effectively decode emotions from both signals. In this paper, a novel Multimodal Emotion Recognition system using a Spatial Pyramid Pooling-based LeNet (MER-SPP-LNet) model is proposed. The proposed MER-SPP-LNet system processes the augmentation of both the EEG signals and audio for emotion classification. First, the preprocessing step removes noise, in which EEG signals use Modified Amplitude-assisted Complete Ensemble Empirical Mode Decomposition with Adaptive Noise (MA-CEEMDAN), while audio signals are normalized. In feature extraction process, EEG features are derived using S-transform and Common Spatial Patterns (CSP), while audio features use Enhanced Magnitude Square updated Power Normalized Cepstral Coefficients (EMS-PNCC). After the feature extraction process, the extracted features are subjected to feature selection step to reduce dimensionality of the feature set using the Principal Component Analysis (PCA) technique. Finally, the emotion recognition step classifies the emotions, which involves two classifiers, such as GhostNet and Spatial Pyramid Pooling-based LeNet (SPP-LNet). Finally, the system outputs classified emotions using a soft voting mechanism that improves the recognition accuracy through multimodal integration. The MER-SPP-LNet achieved superior performance compared to traditional approaches with peak accuracy (0.958), specificity (0.975) and NPV (0.976).}
}
@article{LEUSHUIS2026116806,
title = {VARMA-VAE: Stochastic variational forecasting of time series},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116806},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116806},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015327},
author = {Radmir Mishelevich Leushuis},
keywords = {Stochastic modeling, Generative forecasting, Latent variable models, Time series uncertainty},
abstract = {This study introduces the VARMA-VAE, a model that integrates interpretable VARMA dynamics with a variational autoencoder. We evaluate it on three real-world datasets (Tesla trading volume, electric production, and NOx emissions) against an LSTM and a Transformer under a controlled shared encoder–decoder setup. The VARMA-VAE matches their point-forecast accuracy on MSE and QLIKE while outperforming them on CRPS. A component-level ablation against a VAR-VAE variant isolates the moving-average contribution, and a further comparison against a probabilistic Variational Dropout LSTM confirms that the CRPS advantage holds against a fully probabilistic baseline. Unlike prior VAE forecasters such as the Koopman-VAE, TimeVAE, and VRNN, VARMA-VAE yields a closed-form Gaussian predictive distribution whose variance decomposes additively into autoregressive and moving-average components. This combination of accuracy and calibrated uncertainty matters most when forecasts inform risk-sensitive decisions such as seizure detection or heat-wave alerting. Applications span financial markets, operational research, and healthcare.}
}
@article{QIAO2026116858,
title = {Learning Integrative Domain-aware Knowledge for Prompt Tuning in Unsupervised Domain Adaptation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116858},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116858},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015844},
author = {Zike Qiao and Lingfeng He and Qian Yin and Ze Tao and Tianmao Cui and Jian Zhang},
keywords = {Vision-language models, Domain-aware knowledge, Prompt learning, Unsupervised domain adaptation, Classification},
abstract = {Due to the significant distributional shifts between unseen test data and training data, pretrained Vision-Language Models (VLMs) such as CLIP continue to struggle with adapting to downstream tasks. Existing approaches mainly align visual and textual embeddings to extract domain-invariant information. However, domain-invariant features inevitably contain source-private information, which hinders the model from capturing domain-relevant knowledge and causes inference to shift toward the source style. Moreover, strict distribution alignment of shared prompts overlooks sample-specific domain variations, resulting in insufficient learning on the target domain. To address these issues, we propose a novel method, called Integrative Domain-aware Knowledge Prompt Tuning (IDKPT). Our method consists of a domain-aware feature extraction module and an instance-level prompt alignment strategy. The former exploits domain representations to balance general knowledge with domain-invariant features, while injecting domain-specific information into suppressed channels of the visual encoder. The latter combines class-specific textual prompts with instance-level visual prompts, and applies contrastive learning within subdomains to construct a discriminative and well-separated feature space. Extensive experiments on multiple benchmark datasets (Office-Home, Office-31, VisDA-2017, Mini-DomainNet) demonstrate that IDKPT significantly enhances the domain adaptation performance of VLMs, validating its effectiveness. The code will be available at: https://github.com/Jhin237/IDKPT.}
}
@article{ZHANG2026116861,
title = {Dual Kolmogorov–Arnold Network for robot dynamics identification based on sim-to-real transfer learning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116861},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116861},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601587X},
author = {Shubo Zhang and Zhong Chen and Xianmin Zhang},
keywords = {Dynamic identification, Dual Kolmogorov–Arnold Network, Collaborative robot, Transfer learning, Physical human robot interaction},
abstract = {In recent years, the increasing demand for human–robot interaction and impedance control has heightened interest in the dynamics identification of robotic manipulators. Traditional identification methods predominantly rely on model-based approaches, such as least squares applied to inverse dynamics models. However, these techniques are insufficient for addressing challenges such as nonlinear friction forces, which cannot be effectively represented within a unified regression matrix. Moreover, they fail to capture the impact of unmodeled dynamics, including structural uncertainties. This paper introduces a novel Dual Kolmogorov–Arnold Network for the prediction of robotic manipulator dynamics. By incorporating adaptive knot adjustment and a bootstrapping mechanism between two networks, the proposed method significantly enhances the accuracy of the dynamic model. Furthermore, neural networks often encounter difficulties in generalizing across the entire reachable state space when trained on limited trajectory data from physical robots. To overcome this limitation, we propose, for the first time, a simulation-to-reality (sim-to-real) transfer learning strategy that facilitates the transfer of knowledge from simulations to real-world manipulators. The effectiveness of the method is demonstrated through experiments conducted on a six-degree-of-freedom collaborative robot in three distinct configurations, showing robust generalization across the entire state space.}
}
@article{XUE2026116814,
title = {Semi-supervised multi-level contrastive learning for deep clustering},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116814},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116814},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015406},
author = {Jingjing Xue and Ruizhang Huang and Ruina Bai and Yanping Chen and Yongbin Qin and Chuan Lin},
keywords = {Semi-supervised clustering, Multi-level contrastive learning, Pairwise constraints, Global relationship},
abstract = {Semi-supervised clustering aims to group data based on limited prior knowledge. Pairwise constraints, which specify whether two samples should belong to the same cluster, are a common form of prior knowledge. However, obtaining such constraints in real-world scenarios is frequently labor-intensive and expensive. The limited number of available constraints leads to sparse and unevenly distributed constraints in semi-supervised clustering, reducing clustering performance. In this study, we propose SMCC, a semi-supervised multi-level contrastive clustering model that addresses the issues of sparse and unevenly distributed pairwise constraints caused by the limited number of constraints in deep semi-supervised clustering. Specifically, SMCC incorporates limited pairwise constraints into both feature-level and sample-level contrastive objectives, inferring global sample relationships to fill the gaps left by these limited constraints, resulting in improved semi-supervised clustering. It comprises two key components: a feature-level contrastive learner, which improves representation learning by incorporating prior pairwise constraints and local associations, and a sample-level contrastive learner, which captures global relationships based on the enhanced representations to further refine clustering assignments. Extensive experiments conducted on multiple benchmark datasets demonstrate that SMCC outperforms several state-of-the-art clustering methods, highlighting its effectiveness in semi-supervised clustering tasks.}
}
@article{SINGH2026116866,
title = {Echoes without backtracks: Cycle-selective reservoirs for long-tail dependence via edge-indexed propagation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116866},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116866},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015923},
author = {Pradeep Singh and Teredesai Sudharma Shekhar and Balasubramanian Raman},
keywords = {Reservoir computing, Echo state networks, Non-backtracking operator, Edge-space dynamics, Cycle-selective memory, Time-series forecasting},
abstract = {Long-horizon sequence modeling demands reservoirs that (i) retain information over many steps, (ii) remain provably stable under streaming inputs, (iii) run in linear time on sparse graphs, and (iv) expose what they remember. Standard node-based ESNs typically propagate with adjacency-driven dynamics that amplify two-step U-turns (i→j→i), producing short, degree-biased echoes unless one tunes the spectral radius perilously close to 1—a brittle regime that undermines the echo-state property (ESP). Alternatives that learn the recurrence (e.g., GNN/RNN variants) trade closed-form training for iterative optimization and still lack simple, topology-aligned explanations of memory. Achieving simultaneously long, structured memory; certified ESP; O(M) complexity; and interpretability has remained challenging. We propose the Non-Backtracking Edge-Flow Echo State Network (NB-ESN), a drop-in reservoir whose state lives on directed edges and evolves with the graph’s non-backtracking (Hashimoto) operator, which forbids immediate reversals. By aligning dynamics with simple paths and primitive cycles rather than degree-driven ping-pong loops, NB-ESN yields cycle-selective, long-tail memory without near-critical tuning. The update is a leaky composition with a 1-Lipschitz nonlinearity, giving ESP under transparent norm-based contraction bounds on the non-backtracking gain and modest edge↔node couplings. Computationally, the core multiply by the non-backtracking operator is realized in O(M) via message passing (nodewise accumulation followed by a back-edge subtraction), so NB-ESN matches sparse ESN cost while embedding a principled topological prior. The edge-space view also enables interpretability: projecting the antisymmetrized flow onto a fundamental cycle basis reveals which loops carry memory at each time. Across canonical chaotic and real-signal benchmarks, NB-ESN extends useful prediction horizons and improves attractor/spectral fidelity relative to size-matched node reservoirs, with robust performance over broad hyperparameter ranges. In short, NB-ESN converts “echoes from U-turns” into circulation on real loops, combining stability, efficiency, and insight.}
}
@article{KHEZRI2026116838,
title = {OSSB: Online Semi-Supervised Boosting for non-stationary data streams with limited labels},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116838},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116838},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015649},
author = {Shirin Khezri and Negin Samadi and Jafar Tanha and Mohammad Sotoudeh},
keywords = {Data streams, Semi-supervised learning, Online learning, Concept drift, Ensemble methods, Boosting, Conformal prediction},
abstract = {The scarcity of labeled data in non-stationary streams significantly hinders the performance of conventional online learning models. To address learning under extreme label scarcity while continuously adapting to concept drift, this paper proposes a novel Online Semi-Supervised Boosting (OSSB) framework. OSSB unifies three key mechanisms within a single, cohesive online learning loop: (1) an adaptive drift detection strategy based on ensemble error monitoring, (2) a statistically-grounded pseudo-labeling approach using conformal prediction to safely exploit unlabeled instances, and (3) a dynamic boosting mechanism that performs targeted model updates upon drift detection. By processing each instance only once in a strict online manner, OSSB ensures high scalability and real-time adaptability. Extensive experimental evaluations against a wide range of semi-supervised and supervised stream classifiers confirm the robustness of OSSB and its strong empirical performance. Statistical tests show that OSSB outperforms semi-supervised baselines across different labeling budgets. It also achieves performance close to fully supervised methods while using far fewer labeled samples. These results show that OSSB is efficient and effective for real-world streaming applications where labels are limited and concepts evolve continuously. For reproducibility, the complete implementation is publicly available at: https://github.com/shirinkh/My-Research-paper-codes.}
}
@article{ZHU2026116790,
title = {TRDA-TS: Text reinforcement and regularized diffusion alignment for LLM-empowered multimodal time series forecasting},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116790},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116790},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015169},
author = {Jiaming Zhu and Xiao Zhai and Changkai Li and Dezhi Liu and Zhengzheng Lin},
keywords = {Large language model, Multimodal time series forecasting, Semantic aggregation, Graph diffusion fusion, Target-aware cross-modal alignment},
abstract = {Large language model (LLM)-based time series forecasting (TSF) has demonstrated strong performance by separately modeling time series and textual information. However, prior text-related research has primarily focused on prompt design and text converted from time series, while the utilization of exogenous textual signals, such as event information, remains insufficient. Moreover, we observed that existing LLM-based solutions often struggle to achieve stable and structure-aware cross-modal representations when exogenous textual signals are incorporated. To address these issues, we introduce TRDA-TS, a LLM multimodal time series forecasting framework based on a regularized diffusion cooperative fusion and text-enhanced mechanism. Specifically, we introduce multi-scale and multi-frequency modeling into the transformer architecture, reorganize fragmented textual data into causally filtered trend descriptions, and encode the resulting compact textual records using a frozen GPT-2 backbone to obtain contextualized textual representations for downstream cross-modal fusion. The extracted representations are subsequently passed through a multimodal fusion layer, which consists of a bidirectional contextual graph diffusion module and a target-aware cross-modal alignment loss for stabilizing cross-modal interaction. Finally, a downstream prediction head generates the final forecasts. Extensive experiments conducted on nine datasets across diverse domains, compared against eight state-of-the-art TSF baselines, demonstrate the effectiveness and accuracy of the proposed TRDA-TS model. Compared with state-of-the-art (SOTA) baselines, TRDA-TS achieves an average improvement of 18.22% in MSE and 12.55% in MAE across all datasets.}
}
@article{OBERDIEK2026116842,
title = {Transfer Learning for Bayesian Networks in manufacturing: A conceptual framework towards industrial deployment},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116842},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116842},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015686},
author = {Sven Oberdiek and Thomas Gottschling and Robert Miehe and Alexander Sauer},
keywords = {Bayesian networks, Transfer learning, Framework, Manufacturing, Scaling},
abstract = {This study investigated the application of Bayesian Networks (BN) within the manufacturing sector, addressing the challenges and limitations that hinder their widespread use. Despite their potential for enhancing decision-making through explainable modeling, BN remain underutilized in manufacturing contexts, primarily due to scarce labeled data and integration complexities. By employing a two-stage literature review, we categorized existing research on BN in manufacturing, identifying key areas of application, including process optimization, maintenance, and process development. Our analysis revealed a predominant focus on diagnostic analytics, with growing interest in predictive and prescriptive approaches. Furthermore, we explored the domain of transfer learning (TL) as a strategy to leverage previously acquired knowledge for improving BN applications in data-scarce environments. The identification of six requirements for scalable BN deployment, including scope analysis, data fusion, performance enhancement, negative transfer mitigation, transfer strategy selection, and complexity management, led to the conceptual design of a framework aimed at addressing prevalent challenges. The framework seeks to support accuracy improvement, multi-source data fusion, and reduce user burden, advancing BN toward predictive and prescriptive decision support. The proposed framework is intended to serve decision makers as a practical guide to support the scaling of BN in manufacturing, although requiring future research for validation in an industrial environment.}
}
@article{MARQUESF2026116772,
title = {Projected random forests and conformal prediction of circular data},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116772},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116772},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601498X},
author = {Paulo C. {Marques F.} and Rinaldo Artes and Helton Graziadei},
keywords = {Circular regression, Prediction sets, Conformal prediction, Projected random forests, Out-of-bag conformal prediction},
abstract = {We apply conformal prediction techniques to regression problems with circular responses, producing prediction sets with adaptive arc length and finite-sample coverage guarantees for any circular predictive model under the assumption of data exchangeability. Leveraging the high performance of existing predictive models designed for linear responses, we analyze a general projection procedure that converts any linear-response regression model into one suitable for circular responses. When random forests are used as base models in this projection procedure, we leverage the random forest out-of-bag mechanism to eliminate the need for a separate calibration sample in the construction of prediction sets. On synthetic and real datasets, the resulting projected random forest model produces more efficient out-of-bag conformal prediction sets, with shorter median arc length, than the split conformal prediction sets gnexenerated by two existing alternative models.}
}
@article{WANG2026116826,
title = {LoRA-SFIE-LLM: Synergistic LoRA and RAG retrieval optimization for shearer fault information extraction},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116826},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116826},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015522},
author = {Yunrui Wang and Zhaoyang Zheng and Xintong Sui and Man Yv},
keywords = {Shearer fault, Information extraction, Large language model, Low-rank adaptation, Retrieval-augmented generation},
abstract = {Traditional methods for shearer fault information extraction (IE) rely heavily on large amounts of annotated data and exhibit limited generalization capabilities. Direct application of large language models (LLMs) is associated with challenges such as terminology-comprehension bias and knowledge-update lag, making it difficult to accurately extract fault information from low-resource data. To address this challenge, this study proposes an LLM-based framework for shearer fault information extraction, termed LoRA-SFIE-LLM, which integrates low-rank adaptation (LoRA) fine-tuning with retrieval-augmented generation (RAG) retrieval optimization. First, through few-shot prompting for context learning, the LLM effectively activates its capability for deep semantic parsing of low-resource-domain texts. Second, LoRA fine-tuning is performed to enable the LLM to internalize deep domain knowledge of shearer faults, while optimizing only a limited number of parameters. Finally, RAG retrieval optimization is applied. Real-time fault data from continuously monitored and updated operational procedures are processed and stored in the external knowledge base. When combined with retrieval reranking, this process ensures the timeliness and accuracy of retrieved information, thereby mitigating the LLMs’ knowledge-update lag. Experimental results demonstrate that this approach effectively enhances the precision and recall of IE under resource-constrained conditions, providing an efficient solution for the structured management of domain-specific data.}
}
@article{WEI2026116887,
title = {Biometric traits transferring: RRKD framework for ECG-assisted enhancement of PPG-based individual identification},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116887},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116887},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016138},
author = {Riling Wei and Hanjie Chen and Liangyi Lyu and Yuanting Zhang and Jun Wang},
keywords = {Cross-modal knowledge distillation, Biometrics, Contrastive learning, Photoplethysmography, Electrocardiograph},
abstract = {Photoplethysmography (PPG)-based individual recognition aiming at recognizing humans via PPG signals shows great potential in information security and the clinical field. However, due to the low information densities of PPG signals, uni-modality-based approaches are difficult to achieve desirable results. In this paper, a novel cross-modal knowledge distillation framework, namely Relational Response-based Knowledge Distillation (RRKD), is proposed to transfer discriminate knowledge from Electroencephalogram (ECG) signals to PPG signals. To this end, a teacher model taking ECG signals as input is trained first. Then, the relation- and the response-based knowledge of the teacher model were transferred to the student model through 2 different layers respectively via RRKD. To evaluate the performance of the proposed framework, intra-dataset testing with seen-individual recognition and unseen-individual recognition is conducted on 4 types of student models on a public dataset that contains 341 individuals. To further evaluate the generalization capability of the RRKD, cross-dataset testing is demonstrated on a private dataset collected on multiple days with a pre-trained student model. We achieve state-of-the-art performance on unseen individual recognition in intra- and cross-dataset testing. In this work, we surprisingly observed that utilizing the ECG modality can enhance the periodic response of PPG signals via the RRKD framework.}
}
@article{LIU2026116798,
title = {Fourier center-line estimation for highly curved text detection and flexible viewpoint variety},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116798},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116798},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015248},
author = {Yuxiao Liu and Zhe Wang and Pengfei Chang and Kang Tian and Difei Mei and Yao Xue},
keywords = {Scene text detection, Deep neural network, Arbitrary text shape},
abstract = {Text detection techniques have become highly mature, but detecting text with arbitrary shapes remains a major challenge in text detection tasks due to geometric encoding limitations of text boxes. In natural scenes, text exhibits a diverse range of shapes, and real-world text is subject to influences such as shooting angles, physical distortions of background objects, and the inherent curvature of the text itself. Merely using rectangular bounding boxes proves insufficient for encompassing irregular text instances. To improve the issue of detecting text with arbitrary shapes, we propose a method that utilizes Fourier transforms in the frequency domain to construct text features, enabling the reconstruction of predicted boxes by predicting the text’s central line. The predicted text central line not only assists in reconstructing text boxes with complex shapes, but also aids in the subsequent text recognition process through central line correction. Extensive experiments show that our method achieves competitive performance on standard benchmarks (CTW1500, TotalText). More importantly, it demonstrates superior robustness on highly curved text instances and achieves state-of-the-art performance in cross-dataset evaluation, verifying the effectiveness of the proposed center-line representation in challenging scenarios.}
}
@article{WANG2026116850,
title = {From knowledge to rules: Explainable molecular optimization with Large Language Models},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116850},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116850},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015765},
author = {Shuang Wang and Zian Song and Runfu Yu and Qiyao Yin and Tao Song},
keywords = {Molecular optimization, Large Language Models, Explainable AI, Retrieval-augmented feedback, Rule-based reasoning},
abstract = {Deep learning is widely used for molecular optimization, but most models act as black boxes, making it hard to understand why molecular structures are changed or to reuse prior knowledge. Large language models (LLMs) provide an opportunity to incorporate chemical knowledge and reasoning into this process, but they often struggle to generate valid molecular structures and clear decisions. To address this, we propose ELLM-MOM, a framework that uses LLMs to guide optimization through explicit rules and step-by-step structural editing. The method extracts reusable knowledge, maps target properties to intermediate physicochemical descriptors, ranks candidate editing rules according to their estimated property contributions, and improves results through iterative feedback without retraining. Across 28 molecular optimization tasks, ELLM-MOM achieves competitive satisfactory hit ratios against diverse baselines while maintaining high validity, novelty, diversity, and interpretable editing decisions. This work demonstrates the potential of LLMs as knowledge integration and reasoning components in molecular optimization, paving the way for more transparent and controllable molecular optimization.}
}
@article{HU2026116672,
title = {KTR: Structure-aware replay for continual learning on hypergraphs},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116672},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116672},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013985},
author = {Yanxin Hu and Zhenzhen Xie and Junjie Pang and Chao Cheng},
keywords = {Continual learning, Hypergraph learning, Experience replay, Catastrophic forgetting, Structure-aware learning},
abstract = {Class-incremental continual learning on hypergraphs is challenging under limited replay memory. Buffered samples do not contribute equally to preserving historical higher-order structures. Existing replay methods mainly use random selection or loss-based selection. However, they often ignore structural cohesiveness. As a result, structurally important samples may be missed. We propose KTR (Knowledge-preserving Truss-based Replay), a structure-aware replay framework for continual learning on hypergraphs. KTR prioritizes buffered samples by combining hypertuss-based structural importance with current loss-based utility. It further performs constrained replay through structural filtering and probabilistic sampling. The framework supports both node classification and hyperedge classification. Experiments on four continual hypergraph benchmarks show that KTR improves replay performance under limited-memory settings, with the clearest gains on temporal hyperedge-classification benchmarks. Under the HGNN+ backbone with memory budget b=0.1, KTR improves ACC by up to 20.32 percentage points and reduces forgetting by up to 24.07 percentage points relative to PBR on MAG-Top20K. On node-classification benchmarks, KTR remains competitive with strong replay baselines, but it does not uniformly dominate all methods on every dataset. These results support the use of structure-aware replay in continual hypergraph learning, especially when higher-order structural cohesion provides informative replay signals.}
}
@article{ZAMIR2026116895,
title = {Blur-guided motion and spatio-temporal swarm graph modeling for UAV intent understanding},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116895},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116895},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016217},
author = {Muhammad Zamir and Zhong Ting and Fan Zhou and Md Sabuj Khan},
keywords = {UAV intent understanding, Motion blur modeling, Spatio-temporal graph networks, Vision–language models, Causal reasoning, Aerial surveillance},
abstract = {Small unmanned aerial vehicles (UAVs) are increasingly used in civilian and industrial applications, making automatic intent understanding essential for intelligent surveillance. Although recent vision-language models can generate captions and answer questions about UAV videos, they often rely on appearance information alone and struggle to reason about motion dynamics, swarm interactions, and the temporal relationships that govern UAV behavior. To address these limitations, we propose a unified multimodal framework that learns an intent-centric representation by jointly integrating complementary visual cues with structured reasoning. Specifically, the framework combines frequency-aware appearance modeling to improve the perception of small and degraded UAVs, blur-guided motion representation to capture motion without relying on optical flow, and spatio-temporal reasoning to model interactions among multiple UAVs before conditioning a large language model for intent-aware caption generation and visual question answering. Rather than treating visual perception and language generation independently, the proposed framework explicitly grounds language understanding in structured intent representations derived from UAV behavior. Experiments on the TD-UAV, NPS-Drones, and Anti-UAV datasets demonstrate consistent improvements over existing methods, highlighting the effectiveness of the proposed framework for UAV intent understanding.}
}
@article{AGARWAL2026116810,
title = {Explainable salary forecasting for recent college graduates: A two-stage machine learning approach with uncertainty quantification},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116810},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116810},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015364},
author = {Puneet Agarwal and Md. Salehin Seyam and Sam Chacon and Nafisa Mahbub},
keywords = {Salary prediction, Machine learning, Two-stage modeling, Explainable AI, National Survey of College Graduates},
abstract = {Rising tuition costs and increasing competition in the graduate job market have intensified the need for accurate, personalized salary forecasts. Existing tools are often overly general and fail to capture the complex interactions among educational, demographic, and employment factors that shape early-career earnings. This study proposes a two-stage machine learning framework that combines salary-bracket classification with continuous regression, using the classification output to refine the prediction space and improve accuracy. Four machine learning models, Random Forest, XGBoost, AdaBoost, and Decision Tree, were trained and evaluated on a nationally representative, multi-year dataset of U.S. college graduates from the National Survey of College Graduates (NSCG, 2003–2019; n=25,614), with hyperparameters optimized via grid search. Random Forest performed best across both stages, achieving a test F1 score of 71.27% for classification and a test R2 of 74.35% with an RMSE of $13,900 for regression. To quantify predictive uncertainty, conformal prediction intervals were generated using the Model-Agnostic Prediction Interval Estimator (MAPIE) at 70%, 80%, and 90% confidence levels. Model interpretability was addressed using SHapley Additive exPlanations (SHAP), which identified employment type, employer sector, and degree field as the most influential predictors of early-career salary. The complete framework was deployed as an interactive web application, enabling students and advisors to generate real-time salary predictions with associated uncertainty estimates and feature-level explanations. By integrating predictive accuracy, interpretability, and uncertainty quantification, this work provides a practical and transparent approach to salary forecasting for data-driven career decision-making.}
}
@article{GAN2026116862,
title = {RGPTN: Learning on graphs, hypergraphs, and heterogeneous graphs with noisy labels},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116862},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116862},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015881},
author = {Zeming Gan and Linlin Su and Jinyan Wang and Xianxian Li},
keywords = {Graph neural networks, Hypergraphs, Heterogeneous graphs, Label noise},
abstract = {Graph neural networks have achieved strong performance in graph learning tasks. However, they are highly sensitive to label noise, which can propagate errors through graph structures and bias model optimization. Existing robust methods are typically designed for a single graph paradigm and rely on pairwise structural assumptions, limiting their effectiveness in complex scenarios such as hypergraphs with higher-order interactions and heterogeneous graphs with multi-type relations. In this work, we propose the Robust Graph Propagation-Transformation Network (RGPTN), a unified graph learning framework for addressing label noise across homogeneous graphs, hypergraphs, and heterogeneous graphs. RGPTN integrates two key components: structure unification and supervision augmentation. Specifically, it constructs a foundation graph that models diverse interactions as a general relational representation, enabling consistent message passing through a decoupled propagation-transformation architecture. Based on the cross-paradigm graph representation, RGPTN enhances supervision signals using a static-to-dynamic reweighting strategy for noise suppression and an entropy constraint for label recovery. Extensive experiments on 12 benchmark datasets demonstrate that RGPTN consistently achieves strong robustness against label noise and effective cross-paradigm generalization. The code is available at https://github.com/iFanLab/RGPTN.}
}
@article{ZHANG2026116879,
title = {Uncertainty-aware structural trend-decoupling knowledge tracing},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116879},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116879},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016059},
author = {Xingang Zhang and Xiaofan Shao and Chuang Liu and Dongyan Zhang and Tingzhi Li and Xue Wang},
keywords = {Knowledge tracing, Educational data mining, Uncertainty modeling, Temporal dynamics},
abstract = {Knowledge tracing (KT) infers students’ evolving mastery from interaction sequences and serves as a core component of intelligent tutoring systems. Although recent Transformer-based and probabilistic KT models achieve strong predictive performance, they often entangle long-term learning trends with short-term behavioral fluctuations, while inadequately modeling forgetting dynamics under irregular real-time intervals. To address these issues, we propose UST-KT, an uncertainty-aware probabilistic knowledge tracing framework. Specifically, UST-KT introduces a structural cognitive decoupling module that employs causal convolution to separate smooth cognitive trends from high-frequency fluctuations, injecting them into the mean and covariance of Gaussian latent states, respectively. In this way, the mean captures stable long-term mastery, whereas the covariance serves as a proxy for fluctuation-related uncertainty. Furthermore, we develop a Hawkes–Wasserstein attention mechanism. This mechanism modulates Wasserstein-distance-based distributional similarity using a Hawkes-inspired continuous-time decay kernel, enabling more time-aware modeling of forgetting dynamics under irregular time gaps. Extensive experiments on three real-world benchmark datasets demonstrate that UST-KT consistently outperforms strong baselines and yields more stable prediction dynamics, better-calibrated predictive probabilities, together with more structured covariance representations that serve as proxies for fluctuation-related unpredictability.}
}
@article{KANG2026116822,
title = {Consistency regularization for distortion-robust image classification in industrial machine vision},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116822},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116822},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015480},
author = {Hyungu Kang and Seokho Kang},
keywords = {Machine vision, Image classification, Image distortion, Consistency regularization, Convolutional neural network},
abstract = {In recent decades, convolutional neural networks (CNNs) have driven the remarkable success of machine vision systems in real-world industrial applications. However, their performance can significantly degrade under domain-specific image distortions that depend on the target domain and application scenario. To address this issue, existing methods preprocessed images to mitigate distortions or fine-tuned the CNN with synthetically distorted images of anticipated types commonly encountered in real-world scenarios. While effective, they often suffer from performance degradation on clean images. In this study, we propose Distortion-aware COnsistency regularization (DisCO), an improved training method based on consistency regularization for robust and reliable image classification in industrial machine vision. The primary goal is to train a distortion-robust CNN that enhances classification accuracy on distorted images without compromising accuracy on clean images. To achieve this, the proposed method adapts consistency regularization to enhance robustness of the CNN against various types of image distortions. By incorporating a consistency regularization loss into the learning objective, the CNN is encouraged to yield similar predictions for a clean image and its distortion variants. Through experiments on image classification benchmarks, we demonstrate that the proposed method improves classification accuracy compared to existing methods on both clean and distorted images, particularly when classifying highly distorted images.}
}
@article{PAN2026116773,
title = {Reverse verification-based model watermarking with resistance to model extraction attacks},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116773},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116773},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014991},
author = {Zijian Pan and Jiaohua Qin and Yuanjing Luo and Xuyu Xiang},
keywords = {Model watermarking, Model extraction attack, Ownership verification},
abstract = {With the widespread deployment of deep learning models in cloud services, model extraction attacks pose significant threats to intellectual property protection. Existing black-box watermarking methods often fail to ensure reliable watermark inheritance under such attacks, while suffering from ambiguous verification and potential backdoor risks. To address these issues, we propose REMARK, a robust black-box watermarking framework based on adversarial sample transferability. REMARK uses adversarial perturbations as watermark triggers and adopts a reverse verification mechanism, enabling clear ownership verification while avoiding harmful backdoor behaviors. By jointly optimizing classification, feature alignment and watermark objectives, REMARK tightly couples the watermark with the main task, ensuring effective inheritance during model extraction without degrading performance. Extensive experiments demonstrate that REMARK achieves reliable and unambiguous verification, maintains the primary task performance, and consistently outperforms existing methods in resisting various model extraction attacks.}
}
@article{MAO2026116891,
title = {Evolving multi-agent heuristics for the decentralized resource-constrained multi-project scheduling problem with multiple modes},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116891},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116891},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016175},
author = {Hongri Mao and Ying Mao and Jianbo Yuan and Xiuying Guo and Jianan Su},
keywords = {Decentralized multi-project scheduling, Multiple modes, Genetic programming, Priority rule},
abstract = {In this study, we propose a novel decentralized resource-constrained multi-project scheduling problem with multiple modes. Activities can be performed in different modes and multiple projects compete for shared global resources under precedence and local resource constraints. The problem involves three interrelated decisions — mode selection, activity sequencing, and global resource allocation — with the objective of minimizing individual project makespan and the average project delay across all projects. Although exact and combinatorial optimization methods are theoretically applicable, they are computationally prohibitive in decentralized settings. Priority rule (PR)-based heuristics are widely used in practice due to their simplicity and efficiency; however, manually designing effective rules is challenging and often problem-specific. To address this issue, we propose a genetic programming-based hyper-heuristic (GPHH) to automatically evolve three types of PRs: mode selection rules, activity priority rules, and global resource allocation rules. These rules are evaluated using a multi-agent-based heuristic framework that captures the decentralized interactions between local project scheduling and global coordination. In addition, a mode adjustment module is introduced to further enhance solution quality. Computational experiments on 4800 self-generated instances demonstrate that the evolved PRs consistently outperform existing rules, and that the mode adjustment module provides additional performance improvements. Furthermore, the frequency of terminal usage in the evolved PRs to gain insights into effective scheduling policies. Overall, the results indicate that GPHH is a promising approach for addressing this complex scheduling problem.}
}
@article{LEI2026116802,
title = {Bi-Lipschitz hypergraph learning for high-order correlations: Mitigating oversmoothing and oversquashing},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116802},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116802},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015285},
author = {Junyan Lei and Zhiguo Gong},
keywords = {Hypergraph neural network, Bi-Lipschitz, Oversmoothing},
abstract = {Message-passing neural networks typically rely on permutation-invariant aggregators such as mean or sum, which act as low-pass filters. These aggregators often distort the geometry of the input space because of a lack of bi-Lipschitz stability, which causes the network to lose feature distinguishability and significantly exacerbates oversmoothing and oversquashing phenomena in deep architectures. Although recent graph learning methods have mitigated this issue by structure-preserving aggregation mechanisms, extending these solutions to hypergraphs will ignore the intrinsic heterogeneity of nodes within a hyperedge and lack a theoretically grounded metric to establish bi-Lipschitz guarantees on hypergraphs. To address these issues, we propose WFSW-HGNN, which introduces the Weighted Fourier Sliced-Wasserstein (WFSW) distance as the core aggregation mechanism. Unlike conventional weighted aggregation, WFSW uses learned importance weights to redefine the cumulative-mass breakpoints of the empirical distribution, reparameterizing the Fourier integration to concentrate on structurally informative nodes. Then, we define a Hypergraph Doubly Stochastic (HDS) metric and prove its equivalence to the hypergraph Weisfeiler–Leman (1-WL) test. Crucially, we theoretically prove for the first time that WFSW-HGNN is bi-Lipschitz with respect to this metric, ensuring geometric stability during information propagation. Extensive empirical evaluations demonstrate that our WFSW-HGNN reduces metric distortion and effectively mitigates oversmoothing and oversquashing in deep networks.}
}
@article{LI2026116875,
title = {HiPS-DFMFSAC for Large-Scale UAV Swarm Cooperative Navigation and Obstacle Avoidance in Dynamic Environments},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116875},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116875},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016011},
author = {Yiming Li and Pengchao Che and Tongshan Liu and Guiqiu Song},
keywords = {UAV swarm, Cooperative navigation, Dynamic environment, Soft Actor-Critic, Parameter sharing, Hierarchical experience replay},
abstract = {To address the curse of dimensionality and environmental non-stationarity in large-scale UAV swarms, we propose the HiPS-DFMFSAC algorithm. By reducing interaction complexity from O(n2) to O(n·k) via global parameter sharing and attention-based dynamic fusion, the framework achieves a near-linear training time scaling factor of 1.89x when scaling from 50 to 100 agents, effectively avoiding the 2.66x computational overhead observed in independent network baselines. In standard scenarios, HiPS-DFMFSAC achieves a 99.30% success rate, outperforming the MFSAC and PS-SAC baselines by 31.30 and 21.67 percentage points, respectively. Furthermore, the algorithm maintains a 96.06% success rate in highly dynamic environments and exhibits strong scalability, with its mean success rate decreasing by only 1.91 percentage points as the swarm size increases from 50 to 150 UAVs. Finally, ablation studies quantitatively confirm the core components' contributions, with hierarchical experience replay and dynamic fusion independently boosting success rates by 38.5% and 12.3%, respectively.}
}
@article{LIU2026116903,
title = {Audio deepfake detection based on simplifying graph convolution},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116903},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116903},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016291},
author = {Yufei Liu and Zhangyao Song and Tao Guo and Huihui Wu},
keywords = {Audio deepfake detection, Simplifying graph convolution, Graph attention network},
abstract = {As low-artifact deepfake audio proliferates, the credibility of audio in personal, legal, and public communications is severely undermined, demanding reliable audio deepfake detection (ADD) solutions. However, previous graph-based approaches suffer from high computational overhead due to the nonlinearities between consecutive layers in graph attention networks. To address this limitation, we use Simplifying Graph Convolution (SGC) to optimize the original graph attention network (RawGAT-ST) by replacing iterative graph attention updates with linear feature aggregation. This modification reduces computational complexity while retaining the ability to capture critical spectro-temporal cues. Extensive experimental results show that the proposed detection method, an Optimizing Audio Deepfake Detection Network via Simplifying Graph Convolution (SGC-ADD), outperforms previous graph-based approaches with higher computational efficiency, by simplifying graph structure learning while preserving critical discriminative features.}
}
@article{CHEN2026116726,
title = {Learning design skills as memory policies for agentic photonic inverse design},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116726},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116726},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014528},
author = {Shengchao Chen and Ting Shu and Sufen Ren},
keywords = {Photonic crystal fiber, Inverse design, Memory-augmented agents, Reinforcement learning, AI for physics},
abstract = {Photonic crystal fiber (PCF) inverse design remains challenging because candidate geometries must satisfy coupled optical targets under expensive electromagnetic simulation. Existing pipelines improve surrogate prediction or one-shot parameter recommendation, but they do not accumulate reusable design knowledge across iterative trials. We formulate PCF inverse design as a memory-policy learning problem and propose SkillPCF, a closed-loop agent framework that combines a physics-guided memory skill bank, reinforcement-learned skill selection, and simulator-grounded skill evolution. We further construct a real-world dataset with 479 expert interaction traces (2507 spans) and 553 memory-dependent evaluation queries covering dispersion engineering, loss optimization, and multi-objective design. Experiments across multiple LLM backbones and classical baselines show that SkillPCF achieves stronger design-quality and efficiency trade-offs under practical simulation budgets, demonstrating the effectiveness of our proposed memory-skill learning paradigm for physics-aware PCF inverse design. The code is publicly available at SkillPCF.}
}
@article{MALLEA2026116766,
title = {Understanding the role of dropout in Deep Echo State Networks},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116766},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116766},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014929},
author = {Mario Mallea and Àngela Nebot and Francisco Mugica},
keywords = {Reservoir computing, Deep Echo State Network, Dropout, Randomized neural networks},
abstract = {Deep Echo State Networks (Deep ESNs) leverage hierarchical representations to capture multiple temporal scales efficiently. However, we show that the sequential application of randomized nonlinear mappings accumulates collinear features, deteriorates the condition number of the readout, and amplifies estimator variance. The standard closed-form solution of Deep ESNs based on ridge regression fails to address these depth-induced correlations. To address this, we formalize the first dropout framework for Deep ESNs. We derive a closed-form readout solution that acts as both a feature preconditioner and an adaptive variance penalty. We explore various dropout strategies, ranging from conventional fixed rates to dynamically calibrated rates based on linear and mutual information redundancy metrics at both intra-layer and inter-layer levels. Extensive evaluations on controlled benchmarks reveal that increasing the dropout rate in deeper layers—acts as a powerful structural bias, dominating generalization improvements under noise. Furthermore, real-world energy forecasting experiments confirm the accuracy and computational efficiency of the proposed Deep ESN Dropout framework.}
}
@article{WANG2026116835,
title = {Structure-enhanced cross-modal biomedical prediction},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116835},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116835},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015613},
author = {Minghui Wang and Tingting Zhang and Yu Li and Yi Chang},
keywords = {Cross-modal learning, Biomedical prediction, Knowledge graph},
abstract = {Cross-modal biomedical prediction utilizes heterogeneous data sources from multiple modalities, offering a more comprehensive perspective for biomedical analysis compared to single-modal paradigms. However, most existing methods primarily focus on modality-specific features, overlooking the intrinsic structural relationships across modalities. This limitation hinders their ability to capture the full complexity of cross-modal biomedical phenomena, leading to suboptimal performance. To address this, we introduce StruCro, an efficient framework for cross-modal biomedical prediction that integrates multimodal biomedical data with structural information from biomedical knowledge graphs. Specifically, we propose to learn modality-aware relation representations between different modal entities in cross-modal knowledge graphs in order to effectively model the differences and dependencies among them. Then, we introduce a modality-aware graph neural network that simultaneously optimizes entities and modality-aware relation representations in the knowledge graphs during message passing, effectively capturing cross-modal structural information. Furthermore, we present a dual-view modality-aware contrastive learning mechanism to model cross-modal triples while concurrently optimizing modality-aware relation representations. This approach tackles prevalent biomedical data scarcity and enhances the model’s ability to capture cross-modal structural information. Extensive experiments across various cross-modal biomedical prediction tasks demonstrate that StruCro consistently outperforms competitive baselines under unified evaluation protocols.}
}
@article{GHASEMI2026116896,
title = {King Cobra Algorithm (KCA) and its application in engineering optimization},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116896},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116896},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016229},
author = {Mojtaba Ghasemi and Pavel Trojovský and Mohamed Deriche and Mohsen Zare and Zulkefli Mansor and Laith Abualigah and Eva Trojovská},
keywords = {Global optimization, Swarm intelligence algorithms, King Cobra Algorithm (KCA), Real-parameter numerical optimization, Engineering optimization},
abstract = {Engineering optimization problems require algorithms that are accurate, computationally efficient, and adaptable to diverse search conditions. This paper proposes the King Cobra Algorithm (KCA), a population-based metaheuristic inspired by the king cobra's hunting behavior. KCA combines two movement strategies: prey-seeking exploration and focused-attack exploitation, controlled by a phase-selection mechanism that balances global and local search. The experimental study employs a multi-stage design. Initially, internal sensitivity analyses on the CEC-2014 benchmark suite assess the Gaussian-function component, population size, and phase-selection mechanism. Subsequently, KCA is compared on CEC-2014 with CEC/WCCI competition winners and top-ranked optimizers under a fixed maximum computation time, enabling a practical, runtime-oriented comparison with competition-proven methods. Finally, KCA is evaluated on the CEC-2017 benchmark suite under a fixed number of objective-function evaluations and compared with representative standard metaheuristic optimizers. Statistical interpretation is conducted using Friedman rankings, critical-difference diagrams, Holm post-hoc tests, and paired Wilcoxon signed-rank tests. Two variants, the simple KCA (sKCA) and the self-adaptive KCA (jKCA), are introduced to investigate fixed and adaptive phase-selection rules. The KCA-based methods are subsequently applied to chemical and power engineering optimization problems, such as economic load dispatch and optimal power flow. Results indicate that KCA delivers competitive benchmark performance and high-quality feasible engineering solutions, while sKCA and jKCA illustrate the flexibility of the proposed framework.}
}
@article{GONG2026116807,
title = {Contrastive adversarial glow model for machinery anomaly detection and degradation assessment},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116807},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116807},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015339},
author = {Xinjie Gong and Jun Wang and Chuancang Ding and Yifan Huangfu and Weiguo Huang},
keywords = {Abnormal data missing, Anomaly detection, Contrastive learning, Generative flow model, Generative adversarial networks},
abstract = {Rotating machinery typically operates in healthy state for long periods, leaving abnormal data scarce and making supervised condition monitoring models unreliable. A feasible solution is to construct an anomaly metric using normal data and observe the bias between abnormal and normal data. However, the challenge of this approach lies in learning stable yet fault-sensitive representations of the healthy state, which can detect subtle early-stage anomaly and assess the degradation afterwards. To address this issue, this paper proposes a novel model termed contrastive adversarial generative flow (CAGlow). Owing to explicit density estimation and invertibility of the generative flow (Glow), the CAGlow enables adversarial training to operate directly on the exact likelihood surface, and prompts contrastive learning to ensure that the learned discriminative feature is faithfully preserved. A new composite anomaly metric is further designed to quantify the machinery health conditions. Experiments on bearing and gas-turbine rotor datasets demonstrate that, the proposed CAGlow can produce markedly smoother metric curves during healthy operation, detect anomaly onset earlier with sharper responses, and achieve clear separation between distinct fault degradation stages, as compared with state-of-the-art methods.}
}
@article{HAN2026116859,
title = {GenSeg-Seismic: A task-guided generation-segmentation framework for 3D seismic fault detection},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116859},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116859},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015856},
author = {Liming Han and Muzi Li and Jiongfu Yang and Chunxia Zhang and Jiangshe Zhang and Qiang Liu and Yue Hao and Xianzhe Song},
keywords = {Seismic fault detection, Pseudo-augmentation, Deep learning, Neural architecture search, Spatial reduction attention, Crossline consistency},
abstract = {Three-dimensional seismic fault detection is essential for subsurface structural modeling and reservoir characterization. Deep learning has improved automated fault interpretation, but its performance is often limited by scarce voxel-level field annotations and the domain gap between synthetic and real seismic data. To address these issues, we propose GenSeg-Seismic, a task-guided generation-segmentation framework for 3D seismic fault detection. The framework uses a pseudo-augmentation cycle to connect generation and segmentation. Specifically, a generator synthesizes seismic textures from fault masks, and the generated samples expose the segmenter to broader structural and amplitude variations. Neural Architecture Search, Spatial Reduction Attention, Exponential Moving Average, Stochastic Spatial Occlusion, and morphology-aware losses are introduced as supporting components for architecture selection, long-range dependency modeling, inference stabilization, robustness augmentation, and structural regularization. On the synthetic benchmark test set, GenSeg-Seismic achieves an IoU (Intersection over Union) of 0.7656, F1-score of 0.8672, Precision of 0.8533, Recall of 0.8816, and Accuracy of 0.9800. Additional occlusion experiments show that SSO reduces performance degradation under spatial occlusion. Field-data experiments conducted on the F3 and Kerry3D datasets further suggest improved cross-slice structural consistency. Since voxel-level annotations are unavailable for these field datasets, the corresponding results are interpreted as indirect evidence rather than direct quantitative validation.}
}
@article{THOTA2026116815,
title = {Quantum-inspired knowledge-guided decision support for risk-aware UAV mission planning in contested environments},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116815},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116815},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015418},
author = {Sai Krishna Thota},
keywords = {Knowledge-based systems, Quantum-inspired evolutionary algorithm, Q-bit probability amplitudes, UAV mission planning, Decision support, Risk-aware routing, Explainable optimization},
abstract = {Risk-aware unmanned aerial vehicle (UAV) mission planning requires more than shortest-path optimization when routes pass through threat-exposed, communication-degraded, or safety-constrained areas. This Short Communication presents QKG-QI, a quantum-inspired knowledge-guided decision-support framework that converts mission rules into explicit optimization penalties and couples them with a classical Q-bit adaptive search. Eight Q-bits encode interpretable routing-parameter choices using normalized amplitude pairs; candidate configurations are sampled according to squared amplitudes and updated with a rotation-gate-inspired rule toward the best observed configuration. The operating area is represented as a grid graph with threat intensity, communication loss, weather penalty, and no-fly indicators, and a multi-criteria objective combines energy, path risk, communication reliability, weather exposure, and rule violations. Across 180 reproducible synthetic contested UAV scenarios, QKG-QI achieved average path risk 0.151, communication loss 0.163, 6.98 constraint violations, rule compliance 0.933, and the lowest mission objective score (132.46), at an average energy cost of 59.75. A 2 × 2 component ablation shows that the knowledge-rule layer provides the larger gain (objective 159.77 when rules are removed), while Q-bit exploration adds a smaller but measurable improvement over knowledge rules alone (133.37 to 132.46; paired p = 0.0065) and selects a non-seed route in 92 of 180 scenarios (51.1%). The quantum-inspired claim is therefore limited to the classical Q-bit representation, squared-amplitude sampling, and rotation update; no quantum hardware execution or quantum speedup is claimed.}
}
@article{JI2026116843,
title = {HGTFNet: A hybrid graph-enhanced time-frequency network for multivariate short-term electric load forecasting},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116843},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116843},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015698},
author = {Yi Ji and Yongyuan Zhu and Siliang Lu and Lixia Yang and Xiang Ji and Alan Wee-Chung Liew},
keywords = {Load forecasting, Time-frequency, Spectral fidelity, Multivariate series, Graph learning},
abstract = {Short-term electric load forecasting (STLF) is essential for efficient power system operation, yet existing deep learning models often struggle to simultaneously capture high-frequency transient fluctuations and complex inter-variable dependencies in multivariate load data, leading to over-smoothing and structural distortion. To address these challenges, we propose a Hybrid Graph-enhanced Time-Frequency Network (HGTFNet) that jointly improves numerical accuracy and morphological and spectral fidelity, where fidelity is assessed by waveform morphology (DTW) and harmonic energy distribution (nSpecMAE). HGTFNet adopts a dual-path spectral–temporal architecture that integrates an inverted Transformer backbone with an explicit frequency-domain branch, enabling decoupling of periodic components and stochastic fluctuations while mitigating high-frequency attenuation. A dynamic graph learning module further models cross-variable dependencies to enforce synchronized evolution across multiple load series. In addition, an adaptive temporal query mechanism and a multi-scale convolution module align non-stationary periodic phases and capture fine-grained local variations. Experiments on a real-world urban load dataset (three supply zones) show that HGTFNet consistently outperforms state-of-the-art baselines across multiple horizons, achieving up to a 21.2% reduction in MAPE compared to iTransformer. Beyond point-wise accuracy, HGTFNet improves fidelity, with up to a 13.7% reduction in DTW and lower nSpecMAE, supported by frequency-domain visualizations. Sensitivity analysis further indicates that performance gains arise from adaptive synergy between temporal and frequency representations rather than any single module. Overall, by effectively alleviating over-smoothing and preserving transient peak dynamics, HGTFNet provides a structurally consistent and robust forecasting solution, offering reliable support for secure grid operation and efficient energy management under complex load conditions.}
}
@article{CHEN2026116827,
title = {Resolving multi-level cross-modal semantic ambiguity for remote sensing image–text retrieval},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116827},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116827},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015534},
author = {Shaofan Chen and Chunlei Wu and Jing Wang and Wentao Ma and Jin He and Guolong Shi and Lichuan Gu},
keywords = {Remote sensing image–text retrieval, Cross-modal retrieval, Cross-modal semantic ambiguity, Feature refinement},
abstract = {Remote Sensing Image–Text Retrieval (RSITR) aims to retrieve corresponding images from text descriptions and vice versa, a task challenged by modality heterogeneity, diverse scenes, and intricate semantic alignment demands in geospatial contexts. Existing RSITR approaches often suffer from cross-modal semantic ambiguities including spatial, temporal-distribution, and label-signal ambiguities. To address these limitations, we propose a novel False Negative Informed Semantic Refinement (FNSR) framework for RSITR to obtain temporally stable and semantically reliable multi-modal representations under inherently ambiguous label signals. Specifically, the Local Feature Refinement (LFR) unit enhances local feature informativeness by leveraging Transformer-derived correlation weights to filter redundant local features. Then, the Momentum-Augmented Similarity Learning (MASL) module utilizes temporal knowledge via dynamically updated feature queues to enhance the FN refinement. Furthermore, the False Negative Refinement (FNR) mechanism detects FNs via similarity distribution analysis and mitigates their impact with a tailored loss function, aligning them closer to anchors. Extensive experiments validate FNSR’s effectiveness on RSITR datasets (RSICD, RSITMD, UCM-Captions), it achieves state-of-the-art R@1 scores of 14.94%, 24.23%, 18.13% (text-to-image, t2i) and 18.68%, 28.82%, 22.78% (image-to-text, i2t), respectively.}
}
@article{HE2026116830,
title = {Cross-algorithm image steganalysis based on shared representation learning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116830},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116830},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601556X},
author = {Zhenxiang He and Rulin Wu and Xinyuan Wang},
keywords = {Image steganalysis, Cross-algorithm, Shared representation, Trust-region constraint, Local adaptation strategy},
abstract = {Current image steganalysis methods achieve high detection accuracy when training and testing use the same embedding algorithm; however, performance deteriorates sharply once the test-time algorithm changes, exposing a severe domain-shift problem. To address this issue, this paper proposes a cross-algorithm steganalysis network designed to enhance model transferability under varying embedding algorithms. First, a source-domain representation learning mechanism is designed, in which the supervised objective explicitly strengthens shared steganographic perturbations across algorithms. Simultaneously, an ImageNet-pretrained ResNet is deeply fused with the residual main branch to improve sensitivity to both texture and semantics. Second, a local adaptation strategy based on trust-region constraints is designed, where a boundary radius is set in the feature space to limit the update magnitude, thereby suppressing overfitting and preserving the stability of shared representations. Finally, under a cross-algorithm experimental setting with the dual exclusion of image sources and image IDs, the results demonstrate that the proposed method achieves better detection performance than several advanced steganalysis networks. Moreover, a series of ablation studies further verifies the effectiveness of the proposed method.}
}
@article{ZHU2026116803,
title = {ASTRA: Adaptive-semantic topological reconstruction for augmented graph contrastive learning with global awareness},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116803},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116803},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015297},
author = {Jitao Zhu and Liqing Qiu},
keywords = {Graph contrastive learning, Differentiable structure learning, Global semantic awareness, Topology reconstruction},
abstract = {Graph contrastive learning (GCL) is a prominent approach for self supervised graph representation learning. However, existing methods face limitations across view construction, feature extraction, and objective optimization. Random perturbations may damage graph semantics and structures. Message passing based graph neural networks are prone to over smoothing and over squashing, whereas Graph Transformers suffer from high computational complexity and over globalization. Deterministic objectives often ignore node uncertainty, and local alignment alone can induce representation collapse. To address these issues, this paper proposes Adaptive Semantic Topological Reconstruction for Augmented Graph Contrastive Learning with Global Awareness (ASTRA), a semantic topological augmented graph contrastive learning framework. ASTRA constructs a single semantic topological augmented graph by merging local topological candidates with global semantic retrieval candidates, and a differentiable structure learner selects informative augmented edges. An enhanced GATv2 based momentum encoder integrates residual connections, layer normalization, and feed forward transformations into an asymmetric student teacher architecture to improve deep feature propagation and alleviate over smoothing. ASTRA further introduces a topology semantic uncertainty aware temperature mechanism based on the discrepancy between topological and semantic neighbor evidence, enabling adaptive tolerance for ambiguous nodes. Extensive experiments on eight benchmark datasets show that ASTRA achieves competitive state of the art performance on node classification and link prediction while avoiding dense global self attention and full pairwise contrastive computation.}
}
@article{ZHANG2026116839,
title = {A lightweight scale-view co-awareness network for 3D brain tumor segmentation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116839},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116839},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015650},
author = {Yong Zhang and Cunjian Chen and Qiang Gao and Yi Wang and YongBing Deng and Bin Fang},
keywords = {Brain tumor segmentation, Scale-view co-awareness, Lightweight, Multi-scale, Multi-view},
abstract = {Accurate brain tumor segmentation is crucial for clinical diagnosis and treatment planning. However, tumor appearance varies significantly across scales and anatomical views, posing challenges for consistent feature representation. Existing approaches address these challenges using multi-scale and multi-view strategies. However, these often rely on computationally complex architectures and either treat scale and view information independently or apply uniform multi-view strategies across scales, which compromises both the representational capacity and computational efficiency. To address these limitations, we propose a lightweight scale–view co-awareness network (LSVCA-Net) that facilitates scale-conditioned modeling of scale–view interactions through scale-specific multi-view strategies, thereby enhancing feature discriminability under scale and view variations. Specifically, in the encoder, the multi-view local–global mixer (MV-LGM) adopts a parallel CNN–Mamba structure, where local and global branches employ distinct multi-view operations to jointly model scale-aware context and view-aware cues for effective cross-scale and cross-view feature interaction. In the decoder, the multi-view multi-stage fusion (MV-MSF) module integrates multi-level encoder features followed by multi-view refinement, allowing efficient and consistent feature reconstruction while avoiding computationally expensive progressive upsampling. Extensive experiments on MRI-based brain tumor datasets (BraTS 2020, BraTS 2023-MEN, and MSD Brain Tumor) demonstrate that LSVCA-Net achieves a favorable accuracy–efficiency trade-off with minimal parameter overhead (0.50 M), outperforming the existing lightweight approaches while remaining competitive with non-lightweight state-of-the-art methods. Cross-modal evaluation on CT-based datasets (FLARE 2021 and MSD Pancreas Tumor) further suggests the potential of our proposed network for generalization across tasks and modalities. Code: https://github.com/zhangyongcode/LSVCA-Net.}
}
@article{MIAO2026116811,
title = {Bridging teacher–student representation domains for manifold-aware knowledge distillation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116811},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116811},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015376},
author = {Shuai Miao and Zhiyong Huang and Daidi Zhong and Zhi Yu and Mingyang Hou and Penghao Jia and Yan Yan and Yushi Liu},
keywords = {Deep learning, Knowledge distillation, Manifold alignment, Representation domain adaptation},
abstract = {Knowledge distillation (KD) is widely used for model compression by transferring knowledge from a high-capacity teacher to a compact student. However, capacity reduction and architectural divergence can induce a representation-domain shift between teacher and student networks, reducing the reliability of feature-level knowledge transfer. To address this problem, we formulate knowledge distillation as a representation-domain adaptation problem and propose Representation-domain Adaptive Manifold Knowledge Distillation (RDaMKD), a unified framework that models teacher and student representations as two model-induced domains. RDaMKD constructs a shared manifold-aware domain from the Grassmannian transition between the dominant subspaces of these two domains. In this domain, global distribution alignment and local neighborhood preservation provide complementary representation constraints. Their relative weights are adjusted according to the current teacher–student representation discrepancy, and logit-level distillation provides prediction-level guidance. Experiments on CIFAR-100 and ImageNet, covering homogeneous and heterogeneous teacher–student pairs and different logit objectives, show that RDaMKD outperforms classical and recent KD methods in most settings, especially in cross-architecture transfer. Ablation studies verify the effectiveness of the representation-domain objective, while representation analyses show that shared-domain alignment reduces dominant-subspace discrepancy and improves student feature organization. Code is available at https://github.com/FromZero0000/RDaMKD.}
}
@article{YANG2026116863,
title = {TopoWalk: Modeling continuous temporal topology for weakly supervised video anomaly detection},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116863},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116863},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015893},
author = {Lin Yang and Muye Yue and Meng Xing and Yue Li and Yong Su and Dijun Gong and De-Shuang Huang},
keywords = {Video anomaly detection, Weakly supervised learning, Temporal topology, Pseudo-label diffusion, Multiple instance learning},
abstract = {While Multiple Instance Learning (MIL) has emerged as the de facto paradigm for Weakly Supervised Video Anomaly Detection (WSVAD), its reliance on coarse-grained video-level supervision inherently struggles to capture the fine-grained temporal evolution of real-world anomalies. Specifically, conventional discrete top-k optimization mechanisms severely disrupt the continuous temporal dynamics of anomalous processes, rendering models highly susceptible to spurious snippet-level noise and impeding the perception of subtle anomalies. To bridge this critical empirical gap, we propose TopoWalk, a novel paradigm for topology-aware pseudo-label diffusion. Unlike traditional approaches that isolate snippet-level representations, TopoWalk explicitly models the underlying continuous temporal topology of anomalous events. By formulating anomaly progression as a continuous diffusion process, TopoWalk seamlessly propagates sparse video-level supervision across temporally correlated snippets, thereby encouraging the generation of smooth, high-fidelity soft pseudo-labels. To further mitigate noise, we introduce a dynamically updated score-aware refinement mechanism that recalibrates local associations based on predictive confidence, iteratively enhancing the discriminative power of the learned representations. Extensive empirical evaluations on the challenging UCF-Crime and XD-Violence benchmarks demonstrate that our TopoWalk-empowered framework significantly outperforms existing state-of-the-art methods. Notably, TopoWalk mitigates fragmented background noise and establishes a robust, temporally coherent paradigm, particularly excelling in the identification of subtle, elusive anomalies. Code is available at https://anonymous.4open.science/r/ME-PTE-5B65.}
}
@article{JO2026116698,
title = {Text-to-seed generation: Training-free open-vocabulary seeded semantic segmentation via re-purposing diffusion as text-guided seed generator},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116698},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116698},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014243},
author = {Kumju Jo and Heesun Jung and Sungyong Baik},
keywords = {Open-Vocabulary Semantic Segmentation, Training-free zero-shot semantic segmentation, Text-to-image generative model},
abstract = {Open-vocabulary semantic segmentation (OVSS) aims to segment image regions corresponding to arbitrary text queries. Although the Segment Anything Model (SAM) is a powerful foundation model for segmentation, its standalone performance on OVSS remains limited. Existing methods therefore often use SAM to refine coarse masks predicted by other models, but this strategy is unreliable when the initial masks are inaccurate. In this work, we argue that more reliable segmentation can be achieved by exploiting SAM as a region expansion module guided by accurate object points (i.e., seeds) rather than inaccurate coarse masks. Inspired by classical seeded segmentation, we reformulate OVSS as text-guided seed localization followed by seed-based region expansion. To realize this idea, we propose Text-to-Seed (T2S), a training-free framework that leverages the text-to-region correspondence of Stable Diffusion to generate attention-based seed points for target categories described by text. These sparse seeds are then used as point prompts for SAM to produce full object masks. Without task-specific training or additional annotations, T2S achieves strong performance on standard OVSS benchmarks, demonstrating the effectiveness of combining semantic grounding with seed-driven spatial segmentation.}
}
@article{ZHENG2026116823,
title = {Attribute-modulated spatial-frequency domain learning network for cross-modality medical image synthesis},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116823},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116823},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015492},
author = {Wenzhe Zheng and Yujie Liu and Yu Luo and Yuping Sun and Teng Zhou and Shun Yao},
keywords = {Medical image synthesis, Attribute modulation, Spatial-frequency learning},
abstract = {The central challenge in cross-modality medical image synthesis lies in generating images with target-modality attributes while preserving the anatomical structure of the source modality. Current deep learning approaches attempt to address this by utilizing pre-trained models to capture cross-modal correlations or anatomical priors. However, such methods demand substantial training data and computational resources. In this work, we demonstrate that target-modality attributes can be extracted from a single arbitrary source-target image pair. These attributes, which encode modality-specific tissue contrast and energy distribution characteristics, are then embedded into the synthesis network, steering its output to manifest the desired target-modality characteristics while preserving source anatomical integrity. Furthermore, we propose a novel multi-scale spatial-frequency feature learning network to effectively capture global anatomical structure relationships. Comprehensive experimental evaluations across three standard datasets demonstrate our method achieves competitive and favorable performance against current state-of-the-art approaches in both qualitative assessments and quantitative metrics.}
}
@article{ZHANG2026116742,
title = {MDPO-PV: A knowledge-informed Multi-horizon Differentiable Policy Optimization framework for Patent Valuation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116742},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116742},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014681},
author = {Gengping Zhang and Hongli Liu and Yu Wang and Shengjie Zhao},
keywords = {Patent valuation, List-wise ranking optimization, Multi-modal data mining, Group Relative Policy Optimization, Chinese university patent},
abstract = {Patent transferability evaluation is vital for universities to commercialize innovations amid surging data volumes, yet existing methods often neglect lifecycle dynamics, labeled data scarcity, and cross-domain generalization. Prior approaches focus on static attributes or single-domain scenarios, limiting their utility for complex patent portfolios. To address these limitations, this study proposes MDPO-PV, a knowledge-informed Multi-horizon Differentiable Policy Optimization framework for Patent Valuation. Specifically, the framework employs a temporally decoupled architecture to facilitate joint multi-criteria modeling across the short-, medium-, and long-term lifecycles of patents. By systematically integrating domain expert priors from technological, legal, and market (TLM) dimensions as fully differentiable reward functions, the framework constructs heuristic supervision signals that effectively mitigate data sparsity while ensuring alignment with domain expertise. Furthermore, it adopts a differentiable listwise ranking paradigm, incorporating Group Relative Policy Optimization (GRPO) to enhance discriminative precision by capturing relative advantages within homogeneous patent groups. Moreover, we construct a longitudinal dataset curated from a comprehensive Chinese university patent database, providing a robust benchmark for patent valuation research. Extensive experiments across 6 strategic emerging industries validate MDPO-PV’s superior performance over state-of-the-art baselines and its robust cross-domain generalization, ultimately advancing patent management to accelerate the data-driven transfer and industrialization of university-held intangible assets.}
}
@article{DING2026116831,
title = {Image-based question, answer, and distractor generation: A novel multiple-choice VQA task},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116831},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116831},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015571},
author = {Wenjian Ding and Yao Zhang and Jun Wang and Adam Jatowt and Zhenglu Yang and Zhe Sun and Andrzej Cichocki},
keywords = {Multiple-choice visual question answering, Multi-modal understanding, Contrastive learning, Text generation},
abstract = {Multiple-choice visual question answering entails choosing the correct answer from several candidates based on an image and the given question. This research focus has attracted considerable attention within the realms of visual question answering, visual question generation, and visual distractor generation. Nonetheless, these tasks largely operate in isolation, leaving the joint generation of questions, answers, and distractors largely unexamined. We propose a novel task, Visual Question–Answer–Distractors Generation (VQADG). This task not only bridges the existing research gap but also serves as a foundation for advancing current visual question–answering models. We present an innovative model for the proposed task, employing a multimodal model to encode both the visual content and textual information and simultaneously generate questions, answers, and distractors. To mitigate sampling bias and effectively improve the consistency of the generated QADs, we employ debiased hard negative contrastive learning. Additionally, a fine-grained alignment strategy is proposed to preclude information overlap or completeness. Empirical results on the Visual7W and VQAv2 benchmarks demonstrate the effectiveness of the framework for the proposed task.}
}
@article{ZHAO2026116892,
title = {A temporal graph attention network-assisted evolutionary algorithm for dynamic constrained multi-objective problems},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116892},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116892},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016187},
author = {Chunliang Zhao and Peng Ning and Yiqin Zhang and Yuanyuan Hao and Zhong Li and Yi Xiang},
keywords = {Dynamic constrained multi-objective optimization, Graph attention network, Evolutionary algorithms, Environmental response},
abstract = {Dynamic constrained multi-objective optimization problems involve time-varying objective functions and constraints and arise in many real-world engineering applications. However, existing algorithms often cannot rapidly identify the Pareto-optimal set and may converge slowly when the environment changes frequently. To address these challenges, this paper proposes a temporal graph attention network-assisted evolutionary algorithm, termed T-DCMOEA. T-DCMOEA constructs a temporal graph to represent the evolution of solution populations and uses an attention mechanism to capture temporal dependencies among solutions, thereby establishing an offline model for predicting solution quality. A Rényi divergence-based update-trigger indicator then determines whether the prediction model should be updated online. Finally, the resulting model guides the selection of promising solutions during environmental response, while an elite-preservation strategy generates additional candidates. Experimental results show that T-DCMOEA outperforms state-of-the-art algorithms across multiple performance metrics and produces solution sets with good convergence and diversity in dynamic environments.}
}
@article{CHAI2026116791,
title = {DAFN: A dual attention fusion network for textual data classification},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116791},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116791},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015170},
author = {Dakun Mang Chai and Irene Moulitsas and Desmond Bala Bisandu},
keywords = {Sentiment analysis, Polarity detection, Dual representation embeddings, Attention interaction, Multi-scale convolution},
abstract = {Sentiment classification models often perform unevenly across short, noisy texts and longer review documents. Tweets contain limited context, informal language, and abrupt polarity shifts, whereas reviews require robust modelling of long-range dependencies and stable optimisation over longer sequences. To address these challenges, this paper proposes DAFN, a Dual Attention Fusion Network for binary sentiment classification on both tweet and review datasets. DAFN combines dual representations through early fusion, processes them with parallel BiGRU and BiLSTM branches, and introduces an Attention Interaction module that enables cross-branch communication. The architecture further incorporates branch-specific multi-scale temporal convolutions, hierarchical pooling, feature recalibration, and residual multi-level fusion to strengthen information flow and improve training stability across variable input lengths. Experiments on three tweet datasets and five review datasets show that DAFN consistently outperforms earlier hybrid deep learning baselines and remains highly competitive with strong transformer baselines. On short-text benchmarks, it achieves the best overall classification performance on Airline and T4SA and remains near the top on Sentiment140. On review datasets, it delivers the best overall results on App, the highest AUC on several review benchmarks, and near-tied performance with RoBERTa on Kindle. Computational analysis further shows that the static variant of DAFN is more efficient, whereas the contextual variant provides stronger predictive performance. These findings demonstrate that DAFN offers a unified and effective framework for robust sentiment classification across heterogeneous text lengths.}
}