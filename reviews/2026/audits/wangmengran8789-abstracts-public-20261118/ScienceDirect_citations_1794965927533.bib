@article{SARI2026117006,
title = {CyBERT: Knowledge-guided sentence simplification via POS-guided denoising and content–style disentanglement},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117006},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117006},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017326},
author = {Ghaluh Indah Permata Sari and Wimaya Nitya Phandita and Hsing-Kuo Pao},
keywords = {Knowledge-guided learning, Sentence simplification, Content–style disentanglement, POS-guided denoising, Cycle-consistent learning},
abstract = {Text simplification can be formulated as a knowledge-guided readability-adaptation problem: a system must reduce linguistic complexity while preserving semantic content. Existing neural simplification systems often rely on large paired corpora or computationally expensive Transformer decoders, and they provide limited transparency regarding which linguistic factors guide simplification. This paper proposes CyBERT, a knowledge-guided sentence simplification framework that integrates POS-guided denoising, content–style disentanglement, and cycle-consistent training. POS-guided denoising uses POS tags as lightweight linguistic cues to select edit-prone span-start locations during corruption, while span-infilling reconstruction trains the decoder to recover fluent text from these targeted corruptions. The latent interface encourages the separation of semantic content from readability-related style. A BERT encoder captures contextual representations, and an attention-based LSTM decoder performs autoregressive generation with lower inference FLOPs than the evaluated Transformer decoder baselines. To reduce reliance on aligned corpora, CyBERT uses cycle-consistent adversarial learning over unpaired complex and simple sentences, while still supporting paired supervision when available. Experiments on ASSET and TurkCorpus show that CyBERT achieves competitive simplification quality compared with task-specific, pretrained encoder-decoder, and instruction-tuned language models. Computational profiling further shows substantially lower inference FLOPs than the evaluated open-weight instruction-tuned models, while human evaluation indicates that CyBERT produces fluent and meaning-preserving simplifications. Additional zero-shot evaluation on Med-EASi shows that CyBERT retains most of its relative simplification margin under medical-domain shift, although its handling of unfamiliar medical terminology remains limited. These results suggest that the joint integration of POS-guided denoising, explicit content–style separation, and cycle-consistent learning provides an effective and computationally efficient framework for readability-oriented sentence simplification.}
}
@article{KIM2026117058,
title = {Utilizing temporal knowledge graphs for disaster detection and analysis},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117058},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117058},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017843},
author = {Seonhyeong Kim and Young-Woo Kwon},
keywords = {Temporal knowledge graphs, Graph neural networks, Graph integration, Disaster detection, Situation analysis},
abstract = {As various types of disasters occur more frequently, leading to increased casualties and property damage, it is essential to analyze large volumes of disaster data to enable rapid, accurate detection and response. However, disaster-related data comes from diverse sources and is distributed across different agencies, making real-time integrated analysis difficult and limiting both initial response and situational awareness. This article presents Temporal Knowledge Graphs (TKGs) constructed from social media, public, and news data to represent relationships among disaster-related data. The proposed approach captures temporal changes and extracts meaningful insights from evolving disaster data. We employ social data subgraphs to evaluate disaster detection capabilities, using four Graph Neural Network (GNN) models: Graph Convolutional Network (GCN), SAmple and aggreGatE (GraphSAGE), Graph Attention Network (GAT), and Gated Graph Convolutional Network (GGCN). The experimental results are promising, achieving an F1-score of approximately 82%. In addition, performance evaluation with K-means clustering as a baseline confirms the superior disaster detection capability of the GNN models. To extend the analysis beyond short-term detection, we integrate multiple knowledge graphs (KGs) for long-term analysis, forming a unified KG. This approach aggregates news data subgraphs to construct merged graphs and apply the Named Entity Recognition (NER) model to extract disaster-related entities. The evaluation process assesses the NER model’s performance using the extracted entities, demonstrating its ability to identify unseen entities and automatically extract key information. The results demonstrate that the proposed approach effectively supports disaster situation analysis and identifies cascading disaster events, providing a comprehensive understanding of disaster dynamics.}
}
@article{WANG2026117095,
title = {Modeling visual ambiguity: An uncertainty-aware boundary refinement network for camouflaged object detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117095},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117095},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018216},
author = {Chunmao Wang and Ge Jiao and Fangyan Wang},
keywords = {Camouflaged object detection, Laplace reparameterization, Boundary refinement, Pixel-wise uncertainty},
abstract = {Deep feature representation and multi-scale fusion have become effective strategies for Camouflaged Object Detection (COD). However, existing methods lack explicit modeling of predictive uncertainty in highly ambiguous regions and are insufficient for accurately refining blurry object boundaries. To address these limitations, we propose an Uncertainty-Aware Boundary Refinement Network (UABNet). Specifically, the Coarse-Grained Feature-Guided (CGFG) module aggregates multi-scale contextual information to generate complementary foreground-background localization priors. The Uncertainty Guided Fusion (UGF) module explicitly models pixel-wise uncertainty via Laplace reparameterization and enhances feature representations in highly ambiguous regions through fine-grained grouped interaction. Finally, the Progressive Scale-Adaptive Decoder (PSAD) progressively recovers object boundaries under the joint guidance of localization priors and uncertainty-aware features. Extensive experiments demonstrate that UABNet consistently outperforms 20 state-of-the-art methods on three widely used COD benchmarks. Furthermore, UABNet also achieves superior performance on polyp segmentation, demonstrating the effectiveness and strong generalization capability of the proposed method beyond the COD task.}
}
@article{ZHU2026117147,
title = {A dual-stream sequence representation learning framework for robust gait stride estimation across gait tasks and populations},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117147},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117147},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018733},
author = {Jingnan Zhu and Lei Chen and Jun Pang and Uriel Martinez-Hernandez and Lin Meng and Dong Ming},
keywords = {Stride length estimation, Wearable IMU, Dual-stream deep learning, Time-frequency analysis, Pathological gait},
abstract = {Stride length is a fundamental biomarker for gait assessment, especially in tracking Parkinson's Disease (PD) progression. However, accurate and robust estimation from wearable IMUs during complex, non-stationary movements remains challenging. Existing methods often rely on dense multi-sensor setups or conventional deep learning models that struggle to capture both inter-cycle temporal dependencies and high-frequency transient features of gait signals. In this study, we propose a dual-stream deep learning framework that integrates time–frequency decoupling with Mamba-based inter-cycle temporal modeling and multi-scale convolutional neural networks (MSCNN) for local feature extraction. The model was trained and validated on a dataset comprising 110 healthy elderly participants and 115 patients with PD during straight walking and turning tasks. Systematic evaluation across populations and tasks identified a sparse dual-foot sensor configuration as the optimal sensor setup. The proposed model demonstrated high accuracy and robustness in both straight walking and turning tasks, with MAEs ranging from 4.99 to 5.58 cm and ICCs ranging from 0.94 to 0.96, outperforming conventional approaches while reducing sensor burden. These results support the proposed framework as a practical and scalable approach for accurate and unobtrusive gait monitoring in complex real-world walking scenarios and highlight the potential of time–frequency decoupled representation for wearable gait assessment.}
}
@article{HE2026117030,
title = {Low-light image enhancement based on Laplacian diffusion model},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117030},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117030},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017569},
author = {Min He and Chao Xie and Rugang Wang and Yuanyuan Wang and Feng Zhou and Xuesheng Bian and Zhaofeng Chen},
keywords = {Laplacian decomposition, Conditional diffusion model, Low-light image enhancement, Multi-scale frequency fusion, Image detail recovery},
abstract = {Diffusion models have achieved significant success in image restoration; however, they face challenges such as insufficient fast sampling capability, long inference time, and inadequate detail recovery in extremely low-light scenes. To address these issues, this study proposes the Laplacian-based multi-component diffusion model (LMCDM), a novel framework that integrates Laplacian decomposition with a Laplacian-based conditional diffusion model (LCDM). LMCDM mitigates fast sampling bottlenecks and enhances image quality under extremely low-light conditions. Specifically, it employs Laplacian decomposition to separate the input image into low-frequency (LF) and multi-scale high-frequency (HF) components. The LF component is globally enhanced by LCDM, effectively reducing computational cost and inference time, while the HF components are progressively restored by a multi-scale frequency fusion network, significantly improving image clarity and noise suppression. Experimental results demonstrate that LMCDM achieves state-of-the-art performance on multiple publicly available datasets. Specifically, on the LSRW dataset, LMCDM attains a peak signal-to-noise ratio of 19.39, setting a new benchmark. Compared to existing methods, LMCDM exhibits significant advantages in both image restoration quality and generation efficiency under extremely low-light conditions, highlighting its great potential for low-light object detection. Part of the source code is available at: https://github.com/hemin9595mint-ui/LMCDM.}
}
@article{LEE2026117115,
title = {DAMEL: Dual-axis multi-expert learning for class-imbalanced learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117115},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117115},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018411},
author = {Hyuck Lee and Taemin Park and Heeyoung Kim},
keywords = {Long-tailed learning, Multi-expert learning, Exponential moving average of weights},
abstract = {Various algorithms have been proposed to address the challenges of class-imbalanced learning in real-world datasets with long-tailed distributions. Although these algorithms reduce prediction bias through rebalancing techniques, they often do so at the cost of increased prediction variance. Several multi-expert learning algorithms have been developed to mitigate this variance; however, they typically involve complex procedures. We propose a new multi-expert learning algorithm, termed dual-axis multi-expert learning (DAMEL), that reduces both prediction bias and variance by leveraging multiple experts along the representation and time axes. Along the representation axis, DAMEL concatenates the representations generated by multiple experts and simultaneously trains an auxiliary balanced classifier using the concatenated representations. Along the time axis, DAMEL aggregates network weights across training epochs and uses these aggregated weights during testing. Experimental results demonstrate that DAMEL effectively reduces both prediction bias and variance, highlighting its effectiveness for class-imbalanced learning.}
}
@article{GE2026117026,
title = {HFedM2ND: A secure Hierarchical Federated Learning framework against poisoning attacks with lightweight multi-layer malicious-node detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117026},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117026},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017521},
author = {Lina Ge and Qinglin Bi and Sen Li and Lei Tian and Zhe Wang},
keywords = {Hierarchical Federated Learning, Poisoning attacks, Robustness, Malicious node},
abstract = {Hierarchical Federated Learning (HFL) improves the scalability of Federated Learning (FL) by introducing intermediate edge-level aggregation; however, this hierarchical structure also expands the attack surface across client and edge layers. Although various poisoning defenses have been proposed for conventional and hierarchical FL, many remain limited in their ability to address cross-layer and coordinated attacks. This paper proposes Hierarchical Federated Multi-Layer Malicious-Node Detection (HFedM2ND), a secure HFL framework that integrates Lightweight Multi-Perspective Temporal Malicious-Node Detection (LMT-MND) with multi-layer detection mechanisms. LMT-MND extracts similarity- and distance-based features from model parameters, aggregates these features over time, and applies multi-perspective clustering to identify suspicious nodes. At the edge layer, malicious client model parameters are detected and filtered by edge servers before edge aggregation. After completing the edge-level iterations, edge servers perform a cross-edge evaluation of the final edge model parameters. Subsequently, the cloud combines the resulting cross-edge evidence with direct cloud-side detection to identify malicious edge servers before global aggregation. Experiments on benchmark datasets demonstrate that HFedM2ND enhances robustness against poisoning attacks while preserving global model performance under heterogeneous data distributions. Furthermore, the framework achieves competitive computational efficiency with limited additional communication overhead under the considered network topology.}
}
@article{ZHANG2026117087,
title = {EvoASF: Text guided evolutionary adaptive fusion for human preference aligned infrared visible image fusion},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117087},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117087},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018137},
author = {Yuyao Zhang and Youming Wang and Qi He and Xinrong Li and Xianzhi Wang and Gaige Chen},
keywords = {Image fusion, Human visual preference alignment, Adaptive strategy optimization, Channel-adaptive feature exchange},
abstract = {Significant progress has been achieved by existing infrared and visible image fusion methods in preserving structural details and enhancing salient targets. However, their performance remains limited under complex imaging conditions due to two major challenges. Firstly, most existing methods mainly optimize objective quality metrics, and the discrepancy between mathematical optimization objectives and human perceptual preferences remains insufficiently investigated. Secondly, the interaction between infrared salient information and visible-light texture structures is often insufficient, resulting in inconsistent detail preservation and perceptual inconsistency. To address these issues, we propose a framework for infrared and visible image fusion that is perceptual-aware and named Evolutionary Adaptive Strategy Fusion (EvoASF). The proposed EvoASF incorporates two key designs. First, it introduces a channel-adaptive feature exchange encoder that estimates the channel-wise importance of channels for features across different modalities. This encoder selectively models the complementary relationship between infrared and visible modalities in a hierarchical feature space. This enhances cross-modal feature interaction and adaptive fusion between infrared saliency responses and visible light texture structure representations. Secondly, it introduces a preference-guided optimization mechanism that combines objective quality measurements, such as structure, gradient and intensity, with perceptual preference signals derived from expert evaluations and large language models. This achieves a better balance between information preservation and subjective visual quality. Extensive experiments conducted on public datasets demonstrate the superior performance of EvoASF in both objective evaluations and subjective visual perception.}
}
@article{ROS2026117099,
title = {DualSelect: Active learning by structural pseudo-label instability under complementary support perturbations},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117099},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117099},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018253},
author = {Frédéric Ros and Rabia Riad and Adel Hafiane and Erwan Bertrand-Bonvillain and Yassine Nasser},
keywords = {Active learning, Pseudo-labeling, Structural pseudo-label instability, Complementary support perturbation, Batch acquisition, Conditional acquisition},
abstract = {In pseudo-label-driven active learning, uncertainty conflates two situations: a sample the model merely hesitates on, and one whose pseudo-label is sensitive to the surrounding unlabeled structure. We formalize the latter as structural pseudo-label instability (SPI): the Jensen–Shannon disagreement between classifiers trained on complementary cluster-balanced halves of the pseudo-labeled pool. Query-by-Committee varies the hypothesis at fixed data; DualSelect fixes the learner and perturbs the local support, needing no independent feature views. SPI is selective rather than universal: its average ablation effect is small, with gains concentrated under residual class ambiguity. DualSelect therefore combines SPI with uncertainty and geometry through data-conditioned weights of fixed functional form, a representation-aware gate, and candidate diversification. The ablation attributes performance to this coordination rather than to SPI alone: removing the gate costs 2.0–2.7 pp of area under the learning curve on every family. Fourteen competitors are compared across four regimes: synthetic data, eleven UCI datasets at two query granularities, and latent image representations, with a second backbone on the synthetic campaign. The claim is robustness, not uniform dominance. On the tabular benchmark DualSelect trails the best mean by 0.09 and 0.07 pp, yet wins more dataset–budget cells than any competitor and is significantly outperformed by none. On the latent benchmark it is significantly ahead of all 14 competitors. Across the four regimes it has the lowest mean and worst-regime empirical regret (0.74 and 2.08pp), and is the only method placing among the top three in every regime.}
}
@article{LOO2026117075,
title = {Explainable lifelong streaming learning based on Episode-to-Concept formation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117075},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117075},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018010},
author = {Chu Kiong Loo and Yi Chen and Wei Shiung Liew and Stefan Wermter},
keywords = {Explainable AI, Interpretability, Prototype-based models, Lifelong learning, Continual learning, Streaming learning, Transfer learning, Knowledge engineering, Self-organizing neural networks},
abstract = {Real-time on-device continuous learning is increasingly used in critical embedded applications, such as medical monitoring, where user trust and transparency are equally as important as accuracy. Current streaming models are often “black boxes,” making it difficult to determine how and why a model arrives at a particular decision. To address this, we propose the Explainable Lifelong Learning (ExLL) model, a neuroscience classifier inspired by the Episodic-to-Concept (EpCon) theoretical model of hippocampal function in concept learning. ExLL is capable of: (1) efficient learning from scarce, streaming data in a single pass; (2) a self-organizing prototype-based architecture dynamically expands as needed, clustering the streaming data into separable groups by similarity and preserves data against catastrophic forgetting; (3) an interpretable architecture that can be represented as IF-THEN rules for inference auditing; and (4) combines local prototype inference with global class-level context using a pairwise decision fusion process to maximize performance. While the design of the architecture incurs a higher memory cost compared to simpler centroid-based models, this is a calculated trade-off to provide explainability functionality. We compare ExLL against selected established lightweight streaming algorithms to evaluate the performance in several learning scenarios with the benchmark datasets OpenLORIS, Places365, and F-SIOL-310. Our findings showed that ExLL outperformed baselines such as SLDA and Replay, in classification accuracy across diverse continual learning scenarios, proving that state-of-the-art streaming performance can be successfully balanced with granular, human-readable explainability.}
}
@article{WEI2026117107,
title = {A cross-regional multi-scale network for motor imagery EEG decoding with discriminative representation learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117107},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117107},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018332},
author = {Ye Wei and Chenghong Lu and Benkun Bao and Yuwen Wu and Mostafa Orban and Hongbo Yang and Kai Guo},
keywords = {Brain–computer interface (BCI), Cross-regional modeling, Discriminative learning, Electroencephalography (EEG), Motor imagery (MI)},
abstract = {Motor imagery (MI)-based brain–computer interfaces (BCIs) have shown great potential for neurorehabilitation and human–machine interaction. However, robust decoding of MI electroencephalography (EEG) remains challenging due to its low signal-to-noise ratio, non-stationarity, and inter-subject variability. This work presents CrossDMNet, an end-to-end MI-EEG decoder that jointly improves representation richness, cross-regional modeling, and feature discriminability within a unified architecture. CrossDMNet builds multi-resolution temporal descriptors and refines them through a lightweight global-context modulation, allowing scale-specific responses to be adaptively emphasized according to trial-level context. To preserve region-dependent neurophysiological patterns, the model learns two parallel streams from central and parietal electrodes and employs a learnable cross-stitch exchange to share complementary information while retaining region-specific characteristics. In addition, CrossDMNet introduces region-wise supervision with two dedicated classifier heads and aggregates their outputs via a joint decision module, reducing the reliance on a single global boundary. Finally, a dual discriminative objective that combines center loss and triplet loss is adopted to produce compact and well-separated embeddings. Experiments on BCI Competition IV-2a, HGD, OpenBMI, and GigaDB, together with systematic ablations, verify the effectiveness of each component and show that CrossDMNet achieves consistently superior performance compared with competitive deep MI-EEG baselines.}
}
@article{DANG2026117083,
title = {GLAF: Test-time adaptive global–local knowledge fusion for retrieval-augmented image generation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117083},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117083},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018095},
author = {Mingcong Dang and Zeyu Jia and Fubo Wang and Shenghong Li and Shengling Geng and Jie Feng},
keywords = {Retrieval-augmented image generation, Test-time adaptive, Global–local knowledge fusion, Distribution generalization},
abstract = {Retrieval-augmented image generation enhances diffusion models with external visual knowledge and has shown clear benefits for long-tail concept synthesis and fine-grained detail generation. Nevertheless, existing methods remain limited by two fundamental issues: they typically employ coarse-grained, static fusion mechanisms that struggle with compositional prompts containing multiple entities and structured relations, and they lack effective test-time adaptability under distribution shifts, leading to reduced robustness and unstable generation quality. We propose GLAF (Global–Local Adaptive Fusion), a test-time adaptive framework for retrieval-augmented image generation that unifies fine-grained retrieval, hierarchical memory construction, and dynamic fusion control. GLAF first decomposes the input prompt into phrase-level semantic units and constructs multi-granularity visual memories through image retrieval. It then employs a lightweight stage-aware router to dynamically select local retrieved evidence and regulate its fusion with frozen global diffusion priors during the denoising process, enabling adaptive knowledge integration conditioned on both semantic content and generation stage. Furthermore, GLAF introduces a lightweight online adaptation mechanism that conditionally refines local memory routing under uncertain retrieval conditions with low additional overhead, thereby improving robustness under different retrieval corruption levels. This design allows GLAF to better balance semantic completeness and fine-grained visual faithfulness, while remaining robust to retrieval noise and test-time distributional variation. Extensive experiments on multiple benchmarks show that GLAF achieves consistent gains over representative baselines in generation quality, robustness, and competitive efficiency.}
}
@article{HAO2026117091,
title = {RMKGC: Rationale-Guided Reasoning with LLM for Multimodal Knowledge Graph Completion},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117091},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117091},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018174},
author = {Linjia Hao and Yongli Hu and Zhongfan Sun and Huajie Jiang and Kan Guo and Tengfei Liu and Junbin Gao and Yanfeng Sun and Baocai Yin},
keywords = {Multimodal knowledge graph, Large language models, Rationale, Feature interaction, Decoupled reasoning},
abstract = {Multimodal knowledge graph completion (MMKGC) has recently become an important research task, aiming to fill missing knowledge and thereby enhance the completeness of knowledge representation and the accuracy of reasoning. However, existing methods often rely heavily on dataset-specific knowledge, which limits their reasoning performance. To address this issue, this paper proposes a novel framework, Rationale-Guided Reasoning with LLM for Multimodal Knowledge Graph Completion (RMKGC). The framework consists of two core modules: MMKG and LLM-based Rationale Encoding and Rationale-guided Interaction and Reasoning. The former generates and encodes rationales with large language models (LLMs) without additional training, providing high-quality reasoning cues to complement multimodal entity and relation features. The latter leverages rationales to guide feature interaction and decoupled reasoning, thereby overcoming the limitation of existing methods in preserving modality-specific features. Experiments on three benchmark datasets of different scales demonstrate that the proposed method achieves state-of-the-art performance.}
}
@article{AHMED2026116966,
title = {Scalable message passing with neuralized belief propagation in large-scale graphical models},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116966},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116966},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016928},
author = {Adeel Ahmed and Ku Muhammad Naim Ku Khalif and Massila Kamalrudin and Khalid Saleem and Abeer Rashad Mirdad and Amjad R. Khan},
keywords = {Belief propagation, Graph neural networks, Message passing, Probabilistic inference, Scalability, Low-rank factorization},
abstract = {Exact probabilistic inference in large-scale graphical models is intractable, and belief propagation (BP), the workhorse approximation, degrades sharply on loopy graphs and does not scale to graphs with millions of nodes because dense message tensors and synchronous schedules incur prohibitive compute and memory. We present NeuBP, a neuralized belief-propagation operator that unrolls loopy BP into a permutation-equivariant, parameter-shared message-passing module, together with StoMP, a stochastic factor-block scheduler that makes the operator trainable and deployable at scale. NeuBP contributes three mechanisms that jointly address accuracy, stability, and cost: (i) a learned message operator with a per-edge damping gate that is provably a contraction under spectral normalization, yielding the convergence guarantees that classical loopy BP lacks; (ii) a low-rank message factorization that reduces the per-factor cost from O(k2) to O(kr) in the state cardinality k; and (iii) an importance-weighted factor-block sampler with staleness-corrected historical embeddings that decouples per-step cost from graph size. On a dataset, random Markov-random-field, and spin-glass models, and on benchmark graphs up to the hundred-million-edge scale, NeuBP attains lower marginal error than loopy BP, damped BP, and recent learned-BP and factor-graph baselines, while running at near-linear cost and fitting million-node inference within a single-accelerator memory budget. A Friedman test across ten datasets (χ2=50.0, p<10−8) with a Nemenyi post-hoc analysis, and a Wilcoxon signed-rank test against the strongest baseline (p<10−8, rank-biserial 0.86), confirm that the gains are statistically significant. Ablations and a three-dimensional accuracy surface isolate the contribution of each component and locate the rank/sampling operating point.}
}
@article{FLORES2026117070,
title = {MPHBS: A novel hybrid metaheuristic with SARSA-guided information exchange},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117070},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117070},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601796X},
author = {Emilio Flores and Rodrigo Olivares},
keywords = {Evolutionary computation, Meta-heuristic optimization, Reinforcement learning, Information exchange},
abstract = {Hybrid metaheuristics can benefit from heterogeneous search processes, but their effectiveness depends on how information is exchanged between component optimizers. In this study, we propose Marine Predator Honey Badger SARSA (MPHBS), a hybrid Honey Badger Algorithm (HBA)–Marine Predators Algorithm (MPA) architecture in which a SARSA-style mediator regulates component-level information exchange between two independently evaluated populations. Rather than replacing the original HBA and MPA search operators, MPHBS ranks their candidate memories and organizes them into a tensorized decision structure indexed by problem dimension, candidate rank, and source population. SARSA acts as a lightweight on-policy mechanism that learns which source-ranked components should be reused during component-wise hybrid-vector assembly. To control evaluation cost, candidates are internally generated through proxy screening, but only one is evaluated with the expensive objective function per sub-exploration episode. MPHBS is assessed on CEC2022 and Finite Impulse Response (FIR) filter design problems against internal references, including MPHB as the HBA–MPA hybrid without the mediator, and six representative external competitors. Internal validation selected B-C1 and A-C1 as final domain-specific configurations for CEC2022 and FIR, respectively. On CEC2022, B-C1 demonstrates robust competitiveness within the leading group while remaining statistically comparable to the MPHB backbone. On FIR, A-C1 provides stronger empirical evidence with clearer advantages under the adopted filter-design protocol. These results suggest that the main strength of MPHBS lies in its information-exchange architecture, where the SARSA-style mediator provides a benefit that depends on the interaction between the search landscape and the recombination of ranked candidate memories.}
}
@article{WANG2026116999,
title = {Domain temporal reasoning of large language models based on multi-source knowledge},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116999},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116999},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017259},
author = {Xinzhi Wang and Junyi Fang and Hang Yu and Zhilu Zhang and Siyuan Su and Hui Zhang},
keywords = {Large language models, Temporal reasoning, Knowledge enhancement, Temporal knowledge graphs},
abstract = {Temporal reasoning remains a challenging problem for large language models (LLMs), particularly in domain-specific and time-sensitive scenarios where models often suffer from temporal hallucinations and generate factually inconsistent responses. To address this issue, this paper proposes a multi-source temporal knowledge-enhanced framework for LLM-based temporal reasoning. The proposed framework integrates two complementary knowledge sources: (1) structured temporal texts derived from domain-specific temporal knowledge graphs to capture event evolution and temporal dependencies, and (2) open-domain commonsense knowledge retrieved from external platforms (e.g., Wikipedia) to enhance contextual understanding and entity disambiguation. Based on the augmented knowledge, we design a prompt-based fine-tuning strategy incorporating both standard instruction prompts and Chain-of-Thought (CoT) reasoning prompts, optimized through Supervised Fine-Tuning (SFT) and Low-Rank Adaptation (LoRA). Experimental evaluations on the public TempReason benchmark and a newly constructed domain-specific dataset demonstrate that the proposed method consistently outperforms strong baseline models on temporal reasoning tasks. In particular, the CoT-based fine-tuning strategy achieves 89.5% Exact Match (EM) and 91.4% F1 on the TempReason-L2 benchmark. Ablation studies further verify the complementary roles of temporal knowledge and open-domain commonsense information in improving temporal dependency modeling and contextual understanding. These findings provide an effective solution for enhancing temporal reasoning capabilities of LLMs and offer practical value for real-world applications such as intelligence analysis, human–computer interaction, public safety management, and emergency response systems.}
}
@article{ZHANG2026117104,
title = {Spatial–Temporal Key Node Graph Attention Network with Positional Encoding for traffic flow forecasting},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117104},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117104},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018307},
author = {Xiaolin Zhang and Zhizhe Lin and Jingwen Yan and Hai Xie and Teng Zhou and Chunjie Cao},
keywords = {Intelligent transportation systems, Traffic flow forecasting, Key node analysis, Position encoding, Graph attention networks},
abstract = {Accurate traffic flow prediction is crucial for intelligent transportation systems to optimize traffic management and alleviate congestion. While Spatio-Temporal Graph Neural Networks (STGNNs) have advanced prediction accuracy by modeling complex dependencies, existing approaches still struggle with three key challenges: (1) identifying influential nodes in dynamic networks, (2) capturing evolving spatio-temporal patterns, and (3) effectively integrating global and local features. To address these limitations, we propose a Graph Attention Network-based model featuring three innovative components. A Key Node Analysis Module (KNAM) dynamically identifies and analyzes pivotal nodes that govern traffic flow aggregation and distribution. A Position Encoding Module (PEM) employs multi-head attention mechanisms to adaptively encode spatio-temporal relationships, and a Parallel Feature Fusion Method optimally combines features from both key and non-key nodes. Extensive experiments on METR-LA and PEMS-BAY datasets demonstrate STKGAT’s superior performance over state-of-the-art methods, achieving significant improvements in prediction accuracy, reducing MAE by up to 13%, while maintaining computational efficiency. The model’s ability to balance global network dynamics with local feature extraction makes it particularly effective for real-world traffic forecasting applications.}
}
@article{YOON2026117071,
title = {Sensory-aware sequential recommendation via review-distilled representations},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117071},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117071},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017971},
author = {Yeo-Chan Yoon and Chanjun Park and Kyu Han Koh},
keywords = {Sequential recommendation, Sensory attributes, Large language models, Knowledge distillation, Representation learning},
abstract = {Sequential recommenders learn behavioral patterns from item identifiers, while the experiential properties that users describe in reviews, such as how products look, feel, smell, taste, or sound, rarely enter item representations in a controlled, auditable form. We present ASER (Attribute-based Sensory-Enhanced Representation), an offline pipeline that fine-tunes a large language model to extract evidence-grounded sensory attribute–value records, such as color: matte black or scent: vanilla, from review text and distills them into a compact student encoder that produces a frozen five-facet sensory bank for each item catalog. At recommendation time the pretrained backbone stays frozen: a lightweight relational metric between the user history and each candidate is learned over the bank, and its correction is applied within a validation-selected magnitude bound. Across five Amazon domains and four backbones, trained within a common experimental pipeline and evaluated by full-catalog leave-one-out ranking without sampled negatives, this integration improves HR@10 and NDCG@10 in all 20 domain–backbone pairs, with average relative gains of 6.1% and 6.4%. A matched non-sensory control channel, built with the same seed model, schema, and pipeline, separates the sources of the gain: the hit-rate improvement follows from structured, evidence-grounded extraction as such, whereas the sensory vocabulary yields a ranking-quality advantage in eight of nine matched comparisons. An audit of the Beauty evaluation catalog finds that 94.8% of retained records are supported by their cited evidence spans, so the extracted signal remains inspectable against its source text.}
}
@article{PAN2026117111,
title = {H2SOC: Hierarchical Heterogeneous Self-Organized Cooperation for multi-agent reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117111},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117111},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601837X},
author = {Yue Pan and Jinlong Lei and Peng Yi and Lu Cao},
keywords = {Multi-agent reinforcement learning, Self-organized grouping, Multi-agent cooperation, Centralized training with decentralized execution},
abstract = {Despite the strong representational capacity of existing cooperative multi-agent reinforcement learning (MARL) methods, agents often converge to homogeneous behaviours, which limits optimal team coordination. While grouping mechanisms have emerged as a promising strategy to promote behavioural diversity, most existing methods implicitly or explicitly rely on global information during execution, thereby violating the strict Centralized Training with Decentralized Execution (CTDE) paradigm. In this paper, we propose Hierarchical Heterogeneous Self-Organized Cooperation (H2SOC), a novel framework that achieves dynamic adaptive grouping without compromising execution independence. Specifically, this method performs multi-scale representation learning at two levels: (1) At the Team-level, a self-supervised structure guides agents to learn topological relations and automatic grouping based on global information during training, while supporting fully distributed execution. (2) At the Agent-level, each agent performs mean-field feature learning based on its local observations. To address the failure of standard mean-field methods in complex heterogeneous systems, we introduce an explicitly Heterogeneous Mean-Field (HMF) approximation that captures multi-type neighbour influences under local observability. Furthermore, we provide rigorous theoretical foundations for HMF, establishing its mathematical form, approximation error bounds, and convergence properties through Theorems 1-3. Extensive evaluations on the challenging SMAC-HARD benchmark demonstrate that H2SOC outperforms state-of-the-art methods by an absolute improvement of 11.4 percentage points, successfully bridging the gap between coordination efficiency and decentralized deployment. The source code is available at https://anonymous.4open.science/r/H2SOC.}
}
@article{V2026117108,
title = {Exponential decay-augmented transformers for interpretable temporal reasoning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117108},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117108},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018344},
author = {Jothi Prakash V. and Arul Antran Vijay S.},
keywords = {Temporal reasoning, Transformer attention, Interpretable machine learning, Memory decay modeling, Long-context learning},
abstract = {Temporal reasoning is central to natural language understanding, particularly in tasks that require selectively retaining relevant information while forgetting outdated context over time. Although transformer-based models have achieved strong empirical success, their self-attention mechanisms lack an explicit temporal inductive bias and provide no principled control over memory decay. This often results in inefficient use of long-context information and limited interpretability in time-sensitive reasoning tasks. To address this limitation, we propose the Exponential Decay-Augmented Transformer (EDAT), a novel architecture that integrates a learnable exponential decay term directly into the self-attention computation. This design enables attention weights to be modulated as a function of temporal distance, while providing certified upper bounds on the total attention mass allocated to temporally distant tokens. We further introduce EDAT-Multi, a multi-scale extension that employs softmax-based gating to adaptively select among multiple decay rates, allowing flexible control over short- and long-term memory retention. The proposed framework is supported by formal analysis and extensive empirical evaluation. Experiments on three temporally grounded NLP datasets — TORQUE, WikiTimeline, and MATRES — demonstrate competitive performance against strong temporal reasoning baselines, while additionally providing certified forgetting guarantees, interpretable attention dynamics, and robust temporal selectivity. Moreover, EDAT achieves low Certified Mass Error (≤0.03), indicating close alignment between learned attention behavior and theoretical decay guarantees. These results show that decay-augmented attention enables interpretable, controllable, and robust temporal reasoning in long-context neural language models.}
}
@article{ALSAIRI2026117092,
title = {Agreement-aware cross-view refinement and fusion for dual-view X-ray prohibited-item recognition},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117092},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117092},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018186},
author = {Husam Al-Sairi and Amine Guezri and Tariq M. Khan},
keywords = {X-ray imagery, Prohibited-item recognition, Dual-view learning, Cross-view agreement, Adaptive refinement, Prediction fusion, Selective review},
abstract = {Dual-view X-ray scanners provide complementary images of the same screened items, helping security operators identify prohibited items that may be occluded or ambiguous in one projection. However, existing dual-view models generally exchange information and combine predictions without considering whether the two views support or contradict each other. This can weaken the correct evidence or amplify an erroneous but highly confident prediction from one view. To address this limitation, we propose an agreement-aware dual-view recognition framework that uses a parameter-free measure of inter-view agreement throughout the decision process. The proposed Agreement-Gated Cross-Refinement module adjusts the amount of cross-view feature refinement according to the disagreement between the views, while Agreement-Aware Fusion preserves evidence for items that are clearly visible in only one projection. The same agreement signal is also used to identify uncertain cases that may require operator review. Using an EfficientNet-B4 backbone, the proposed framework achieves a macro-mAP of 85.2 ± 0.4% across five independent runs on the DvXray benchmark, representing a 10.4 percentage-point improvement over the strongest previously reported DvXray-compatible baseline. Component-wise ablations, resolution analysis, robustness tests, quantitative explanation analysis, and multi-hardware runtime evaluation further examine the framework’s effectiveness, stability, and computational efficiency. The results indicate that explicitly modeling inter-view agreement provides an effective and reliability-aware basis for dual-view X-ray security screening.}
}
@article{YANG2026117084,
title = {ForenMark: Semantic keyed watermarking with evidence recovery for latent diffusion images},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117084},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117084},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018101},
author = {Chen Yang and Bin Gao and Xiaobai Li and Yutong Li and Shutian Liu and Zhengjun Liu},
keywords = {Latent diffusion models, Information forensics, Semantic authentication, Evidence recovery, Tamper localization},
abstract = {Text-to-image diffusion models have made high-quality image synthesis widely accessible, but they have also weakened traditional provenance mechanisms once generated images are compressed, reposted, cropped, or regenerated. Existing watermarking methods for diffusion images still face two practical limitations: globally distributed embedding can introduce visible leakage in smooth regions, and direct verification often becomes unreliable after severe degradation during circulation. To address these issues, this paper proposes ForenMark, a forensics-aware watermarking framework for latent diffusion images. The key idea of ForenMark is to treat verification as a closed evidential loop rather than as a standalone embedding task. During generation, a DINO-guided semantic soft mask allocates watermark pressure to semantically meaningful and texture-rich regions, thereby improving the balance between visual fidelity and robustness. During verification, the claimed prompt is converted into a semantic key via sentence-level embedding and locality-sensitive hashing. At the same time, a lightweight recovery module restores watermark-bearing structures when direct decoding becomes unreliable. The framework further reports authenticity, local consistency, coarse localization cues, and a recovery reference. Experiments on a unified 1000-image benchmark show that ForenMark achieves an SSIM of 0.8714 and an LPIPS of 0.0226, with bit accuracies of 87.3%, 82.9%, 86.6%, and 86.3% under JPEG-20 compression, Gaussian noise with a standard deviation of 0.2, Img2Img regeneration at a denoising strength of 0.35, and composite degradation, respectively. Compared with the strongest payload-based baseline in each setting, these results represent improvements of 4.7, 6.5, 18.5, and 2.1 percentage points, respectively, while the overall audit pass rate reaches 98.9%, exceeding the highest baseline pass rate by 33.2 percentage points.}
}
@article{SONG2026117100,
title = {A particle swarm optimization-based layered personalized federated learning method for Non-IID data},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117100},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117100},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018265},
author = {Ziqi Song and Chen Cui},
keywords = {Personalized federated learning, Particle swarm optimization, Non-IID data, Layered optimization},
abstract = {Federated learning (FL) has gained attention as an effective approach for conducting collaborative model training among distributed Internet of Things (IoT) devices while preserving data privacy. However, effectively addressing the heterogeneous data distributions prevalent in IoT environments remains a significant challenge for FL. In such settings, the quality and distribution of local datasets can vary significantly across edge devices, often resulting in a decline in the performance of the globally aggregated model. In this paper, we propose FedLOP, a novel particle swarm optimization (PSO) based layered personalization framework for FL. It decomposes the global model into two components: a global knowledge layer responsible for general feature extraction and a personalized classification head tailored to individual client tasks. Both components are jointly optimized using PSO, enabling an effective balance between knowledge sharing and personalization. This approach enhances the generalization capability of the global model while leveraging the adaptability of local models. Comprehensive experiments on both image and text classifications demonstrate that FedLOP achieves accuracy improvements ranging from 2% to 5% compared to leading personalized federated learning methods. These findings confirm its efficacy across heterogeneity and scalability. The source code is publicly available at https://github.com/YamadaSeoZyun/FedLOP.}
}
@article{LIU2026117112,
title = {A surrogate-assisted multi-objective evolutionary algorithm for expensive constrained multi-objective optimization problems involving mixed-integer variables},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117112},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117112},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018381},
author = {Yuanhao Liu and Zan Yang and Chen Jiang and Jinqing Zhan and Haobo Qiu and Liang Gao},
keywords = {Expensive constrained multi-objective optimization, Surrogate-assisted evolutionary algorithms, Mixed-integer, Multi-objective evolutionary algorithm based on decomposition, Differential evolution},
abstract = {Surrogate-assisted evolutionary algorithms (SAEAs) have seen significant development for addressing expensive constrained multi-objective optimization problems (ECMOPs) involving continuous variables. Nevertheless, real-world engineering applications frequently encounter ECMOPs that combine both continuous and integer variables. The complexity and discretization of feasible region and Pareto front (PF) bring great challenges for the solving of such problems. Therefore, this paper proposes a surrogate-assisted multi-objective evolutionary algorithm based on decomposition for ECMOPs with mixed-integer variables (SAMOEA/D-MI). Specifically, the evaluated individuals are related to sub-problems by Space Partitioning-based Individual Classification (SPIC) method to determine the optimization stage for each sub-problem. Then the Neighborhood Elite Documents-guided Mutation operation (NEDM) is adopted to explore as many discrete PF as possible, and the Sub-problem optimization Stage-based Local Search (SSLS) is implemented to accelerate the search of the algorithm. Finally, the population is updated by Sub-problem optimization Stage-based Population Update (SSPU) strategy so that the algorithm is able to search toward the PF along multiple directions. Through comprehensive testing across 20 benchmark problems and a blast-resistant structure design case, SAMOEA/D-MI exhibits superior capability in addressing this problem class within limited computational resources.}
}
@article{LIU2026117105,
title = {EMR-GAN: Process improvement, privacy preserving data generation, and prediction enhancement based on GAN},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117105},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117105},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018319},
author = {Tianya Liu and Ji Wu and Yaokang Song and Doris Chenguang Wu},
keywords = {Electronic medical records, Generative adversarial networks, Event logs, Process mining},
abstract = {For electronic medical record data sharing and privacy protection, existing generative adversarial network models mainly focus on static data, neglect temporal treatment process data and fail to balance the quality and usability of generated data. To resolve these limitations, we use the emergency department process data of sepsis patients from the 4TU Centre and propose EMR-GAN, a GAN model integrating process improvement concepts to ensure data authenticity, usability, and privacy preservation. Specifically, EMR-GAN transforms patient event logs into temporal sequences and uses trajectory labels derived from positive and undesirable process deviations. Its multi-task discriminator jointly evaluates sequence authenticity and trajectory type, guiding the generator toward realistic and more desirable treatment processes. The model is comprehensively evaluated across three dimensions—authenticity, usability, and privacy. The results show that, in terms of authenticity, EMR-GAN achieves a Kernel MMD of 0.682 ± 0.027 and a discriminative score of 0.619 ± 0.016, improving by 1.72%–14.6% over traditional models, while the generated treatment processes increase the treatment success rate by 2%–7%. In terms of usability, the disease prediction accuracy and AUC improve by 5.09% and 3.76%, respectively, and the process mining indicators increase by 1.55%–10.87%. In terms of privacy, the membership inference accuracy and recall are 0.526 and 0.544 with 90% of training data, and 0.632 and 0.712 with 20% of training data, demonstrating strong resistance to privacy attacks. This study provides a new perspective on the integration of GANs and process improvement, effectively alleviating the core conflict between medical data sharing and privacy protection.}
}
@article{SABBATINI2026117024,
title = {GInGER: Genetic domain partitioning for interpretable rule extraction and induction},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117024},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117024},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017508},
author = {Federico Sabbatini},
keywords = {Explainable artificial intelligence, Symbolic knowledge extraction, Genetic algorithms, Interpretable models},
abstract = {Symbolic knowledge-extraction techniques aim to provide human-interpretable descriptions of predictive models through compact and expressive representations. Amongst these, approaches based on input domain partitioning offer a natural way to combine local explanations with a global view of model behaviour. However, the construction of the partitions determines both the spatial structure and the complexity of the resulting symbolic model. Furthermore, existing methods often rely on rigid partitioning strategies, require discretisation of continuous targets, or produce complex and overlapping structures that hinder interpretability. This work introduces GInGER (Genetic INterval Generation for Explainable Rules), a framework that formulates symbolic model construction as the direct, genetic optimisation of a complete, flat partitioning of the input domain according to a fitness function. Candidate solutions encode the coordinates of the partition cuts, leading to a non-overlapping hypercubic partitioning to be translated into a symbolic model. Each region can be associated with a class label, a constant value, or a local linear model, enabling a unified treatment of classification and regression without mandatory target discretisation. GInGER can be applied both as a post-hoc explainer, to approximate the behaviour of black-box models, and as an ante-hoc method to directly induce interpretable models from data. An extensive empirical evaluation on multiple classification and regression data sets shows that the proposed approach achieves a favourable trade-off between predictive performance and model compactness, often producing more concise symbolic representations than competing methods while maintaining comparable accuracy.}
}
@article{ZHENG2026117028,
title = {Robust federated intrusion detection via prototype distillation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117028},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117028},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017545},
author = {Shaifeng Zheng and Wang Liu and Junkai Ji and Ka-Chun Wong and Jianyong Chen and Qiuzhen Lin},
keywords = {Network intrusion detection, Federated learning, Label-noise learning, Prototype learning},
abstract = {With the rapid development of the Internet of Things, network intrusion detection systems (NIDSs) are facing increasingly severe challenges, particularly data heterogeneity, class imbalance, and label noise. Federated learning (FL) provides an effective privacy-preserving paradigm by enabling collaborative model training across distributed clients. However, in practical deployments, heterogeneity in client data quality and the presence of noisy labels often significantly degrade the detection performance of the global model. To address these challenges, this paper proposes a robust federated intrusion detection framework via prototype distillation, termed FedProD. Specifically, a small-scale public dataset is leveraged to estimate the predictive uncertainty of client models, based on which clients are partitioned into high-quality and low-quality groups without accessing private data. Guided by this grouping, a group aggregation strategy is adopted at the server to suppress the adverse impact of unreliable clients on global model optimization. Furthermore, a prototype distillation mechanism is introduced during local training to enhance minority-class discrimination at the feature representation level, thereby improving robustness under class-imbalanced data distributions. Experimental results on several public intrusion detection datasets demonstrate that FedProD achieves competitive or superior detection performance and robustness compared with existing FL-based NIDS methods.}
}
@article{SHEN2026117141,
title = {KG-NAV: Knowledge-guided mixture-of-experts for local UAV navigation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117141},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117141},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018678},
author = {Yaoxin Shen and Yongming Liu},
keywords = {Autonomous vehicle navigation, Motion and path planning, Reinforcement learning},
abstract = {Navigation of autonomous unmanned aerial vehicles (UAVs) in unknown environments with local sensing is challenging due to partial observability and communication losses or degradations. Traditional path planning algorithms often assume privileged global information, whereas end-to-end reinforcement learning (RL) can operate from local observations but is data-inefficient and may learn suboptimal behaviors when trained across diverse scenarios. We propose KG-NAV, a knowledge-guided framework that integrates multiple planning methods as experts and distills their privileged behaviors into local-sensing neural policies. Each expert is trained via supervised imitation using LiDAR and state observations, transferring complementary priors from different planning algorithms. A history-conditioned LSTM gating network performs scene-aware routing and fuses experts with an auxiliary RL expert branch, enabling both robust prior-driven behaviors and adaptive improvement. We further introduce reference encoding, which summarizes expert action sequences into temporal features to assist the critic network in value estimation. Experimental results across static, narrow-passage, dynamic, and mixed scenarios demonstrate that KG-NAV achieves an overall success rate of 0.939 and an SPL of 0.802, outperforming the established baseline by 13.3% and 6.2%, respectively. Moreover, leveraging pretrained expert knowledge, KG-NAV requires fewer training episodes to reach an 80% success rate, demonstrating faster adaptation to unknown environments and improved navigation performance.}
}
@article{YU2026117128,
title = {DMR-GNN: Differential multi-relational graph neural network for scalable multi-view learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117128},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117128},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601854X},
author = {Jiexin Yu and Zhengnan Chen and Jinhao Yan and Wendi Zhao and Zihan Fang and Jinbo Li and Shiping Wang},
keywords = {Multi-view learning, Semi-supervised classification, Graph neural network, Multi-relational fusion, Differentiable graph construction, Projection operator},
abstract = {Multi-view learning has garnered significant attention for its capacity to harness heterogeneous data sources by learning comprehensive feature representations. However, existing multi-view graph neural networks suffer from limited scalability in graph construction and a lack of theoretical understanding of feature embedding fusion. To address these challenges, we reformulate multi-view learning as a multi-relational graph neural network optimization problem, where adaptive graph construction, view-specific structural representation learning, and feature embedding fusion are jointly modeled in an end-to-end framework. In this paper, we propose a differential multi-relational graph neural network, featuring three key innovations: 1) A differentiable graph construction mechanism with a scalable anchor-based instantiation to avoid the quadratic cost of dense sample graph construction; 2) Multi-layered relational propagation to capture view-specific structural dependencies across heterogeneous views; 3) A projection-based analysis of attention-like fusion, revealing its simplex-constrained convex-combination form. Extensive experiments on six benchmark datasets demonstrate that DMR-GNN achieves strong and consistent classification performance across different supervision settings, while substantially reducing the computational cost of graph construction.}
}
@article{LIU2026117109,
title = {MOIE-KG: A multi-agent framework for ontology-guided open information extraction and knowledge graph construction},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117109},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117109},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018356},
author = {Xianhui Liu and Yueying Liu and Yiheng Zhuang and Wenlong Hou},
keywords = {Knowledge graph construction, Long-document processing, Multi-agent systems, Open information extraction, Dynamic ontology},
abstract = {Domain knowledge for constructing knowledge graphs (KGs) is often distributed across long documents, where entities and relations span multiple paragraphs and the required type space evolves with document semantics. Constructing KGs from such documents introduces two primary challenges: maintaining global semantic consistency and accommodating document-specific types. Predefined ontology-based methods offer structural stability but lack flexibility, whereas open information extraction techniques enable broader semantic discovery but often yield fragmented structures. Consequently, neither approach adequately resolves the tension between structural consistency and semantic extensibility in long-document contexts. To address this problem, we propose MOIE-KG, a collaborative multi-agent framework comprising specialized agents for coordination and memory management, global information processing, ontology control, entity and relation extraction, and verification and repair. By treating the ontology as a dynamic semantic intermediate representation, MOIE-KG integrates document-level memory, evidence-based feedback, and controlled type projection to preserve structural integrity while facilitating semantic expansion. Experiments on four datasets show consistent F1 improvements over the evaluated baselines. In the fixed-ontology setting, MOIE-KG improves F1 across datasets and backbone models; in the open-ontology setting, it attains a semantic containment rate (SCR) of 86.95%, an entity fidelity (EF) of 94.32%, and a relation fidelity (RF) of 90.37%. These results indicate that MOIE-KG can construct compact, semantically coherent KGs from domain-specific long documents while balancing structural consistency and semantic extensibility.}
}
@article{NGUYEN2026117085,
title = {HyFuse-UNet: A lightweight hyperspectral-RGB fusion network for waste semantic segmentation in edge-based recycling systems},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117085},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117085},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018113},
author = {Dac Hieu Nguyen and Ludovic Koehl and Guillaume Tartare and Kim Phuc Tran},
keywords = {Waste segmentation, Multimodal learning, RGB-HSI fusion, Semantic segmentation, FPGA deployment},
abstract = {Waste semantic segmentation is a key component of automated recycling systems, but RGB-based methods often struggle to distinguish materials with similar visual appearances, particularly under low-light conditions and on high-speed conveyor belts. Hyperspectral imaging provides richer spectral information, yet existing RGB–HSI fusion models are often computationally expensive and inefficient for deployment on edge devices. This paper proposes HyFuse-UNet, a lightweight convolutional network for real-time waste segmentation using RGB and hyperspectral data. The model consists of an RGB encoder, an HSI spatial encoder, and an HSI spectral encoder, followed by multi-level feature fusion and skip projection to effectively exploit the complementary spatial and spectral information. Experiments on the SpectralWaste dataset and our proposed OpenTextile-Recycle dataset show that HyFuse-UNet achieves strong segmentation performance with only 1.52 million parameters, 63.2% mIoU, and 82.5% mIoU, respectively. Deployment results on the AMD VCK190 FPGA platform further show that the model can run at over 300 FPS with 68 W power consumption after quantization-aware training. These results show that HyFuse-UNet provides an effective balance between segmentation accuracy, computational efficiency, and practical deployability for edge-based recycling systems. The source code and pretrained model checkpoints are publicly accessible at: https://github.com/dachieu1996/HyFuse-UNet.}
}
@article{FENG2026117117,
title = {SVG-Mamba: An efficient local-to-global sparse voxel graph mamba for event stream recognition},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117117},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117117},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018435},
author = {Weibin Feng and Xiaoping Wang and Xin Zhan and Hongzhi Huang and Siyuan Zhang and Jiang Li},
keywords = {Event stream, Voxelization, Graph state space learning, Object classification, Action recognition},
abstract = {Recent works based on Transformer or voxel architectures have demonstrated impressive performance in event stream recognition. However, due to their quadratic complexity or multiple dense operations, these methods potentially sacrifice efficiency or sparsity of events to achieve comparable results. To overcome this, we propose a sparse voxel graph Mamba (SVG-Mamba), which combines message-passing graph neural networks (GNNs) with state space models (SSMs) to efficiently model local-to-global spatiotemporal contextual relationships in variable-length event sequences, thereby mitigating this trade-off. Specifically, we introduce a vertex feature encoding (VFE) module that effectively compensates for the shortcomings of GNNs in temporal modeling while preserving event sparsity. To explore latent spatial semantics and motion cues, we design a lightweight local feature aggregator (LFA) consisting of point-wise spatial encoding (PWSE), an attention pooling unit (APU), and dilated residual connections (DRC). Benefiting from SSMs’ powerful global modeling ability at linear complexity, we construct hierarchical dynamic farthest vertex sampling (DFVS) and Mamba-based global attention to expand the local vertex receptive field into global spatiotemporal awareness. Extensive experimental results show that our proposed SVG-Mamba not only achieves higher accuracy but also exhibits significant advantages in terms of inference speed for event-based visual tasks such as object classification and action recognition. The source code is available at: https://github.com/hust-fstudy/SVG-Mamba.}
}
@article{SHEN2026117072,
title = {FL-APGC: A Federated Learning and Adaptive Gradient Compression method for privacy protection in Internet of Vehicles},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117072},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117072},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017983},
author = {Zihao Shen and Mengxi Li and Hui Wang and Peiqian Liu},
keywords = {Internet of Vehicles, Federated learning, Privacy protection, Poisoning attack, Gradient compression},
abstract = {As an emerging distributed machine learning paradigm, Federated Learning (FL) facilitates collaborative model training among multiple participants without exposing raw data, thereby garnering significant attention in preserving data privacy within the Internet of Vehicles (IoV). However, during FL training, the central server is vulnerable to single-point-of-failure risks and poisoning attacks from malicious vehicles. Furthermore, frequent gradient transmissions risk local data leakage, while conventional fixed compression methods fail to accommodate highly dynamic IoV topologies. To overcome these challenges, this paper proposes a Federated Learning with Adaptive Gradient Compression method (FL-APGC) for IoV privacy protection. First, the election and operation of the aggregation server are restructured via a blockchain consensus mechanism to mitigate single-point-of-failure risks, and the Multi-Krum algorithm is introduced to filter out anomalous updates from malicious nodes. Second, an adaptive differential privacy method is designed to dynamically adjust the privacy budget for individual clients and inject Gaussian noise, thereby protecting the privacy of local vehicular data. Finally, an adaptive gradient compression strategy governed by dynamic thresholds is proposed to reduce communication overhead. Experimental results show that this method can effectively protect IoV data privacy, defend against poisoning attacks, accommodate highly dynamic scenarios, and maintain robust model utility.}
}
@article{LEE2026117032,
title = {A Structured Reasoning Framework for Causally Consistent Narrative Generation via Evidence-Conditioned Candidate-Set Control},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117032},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117032},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017582},
author = {Seungho Lee and Hyeongrae Kim and Sujin Kang and Heejin Kim and Dongsuk Oh},
keywords = {Large language models, Context engineering, LLM-as-a-judge, Narrative generation, Detective script generation},
abstract = {Large language models (LLMs) generate fluent open-ended text but often struggle to maintain long-range causal consistency in reasoning-intensive narratives such as detective fiction. Existing approaches rarely track competing suspect hypotheses or update them systematically as evidence accumulates. We propose CORE (Convergent Outlining through Iterative Reasoning Evaluation), a structured framework for evidence-conditioned candidate-set control. CORE comprises four stages. The Reasoning Unit Construction Module constructs localized pairwise reasoning units. The Iterative Investigative Module generates investigative actions and forensic results, evaluates testimony–evidence contradictions using the Testimony–Forensic Alignment Score, and applies phase-adaptive transition, retry, filtering, and termination rules. The Outline Consolidation Module converts the complete investigation history, including eliminated candidates and their refutations, into chronological scene plans. The Narrative Realization Module expands these plans into a final script without altering the derived resolution. We compare CORE with zero-shot, sequential, outline-based, memory-enhanced, and multi-agent baselines using proprietary and open-source LLMs. CORE achieves the highest average G-Eval score among the evaluated generation methods with both GPT-4o and GPT-oss-20b and improves over zero-shot generation across all tested model architectures. Ablation studies identify pairwise decomposition and historical memory as the largest contributors. Blind human evaluation further indicates strengths in concealment and peripeteia, while identifying suspense as an area for further improvement. Turning-point analysis and a case study further show that CORE sustains investigative progression and grounds culprit identification in evidence developed across preceding scenes. These results suggest that evidence-conditioned candidate-set control improves narrative-level causal consistency in structured narrative generation.}
}
@article{ZHU2026117093,
title = {FAME-DA: Frequency-Aware Modulated Experts with Dual Affine for multimodal named entity recognition},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117093},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117093},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018198},
author = {Yian Zhu and Jiang Su and Juanjuan Yao and Lixiang Zhang},
keywords = {Multimodal Named Entity Recognition, Frequency embedding, Expert modulation, Structural relation modeling},
abstract = {Multimodal Named Entity Recognition (MNER) aims to integrate textual and visual information for accurate identification of entity boundaries and categories in multimodal scenarios such as social media. Existing modality fusion-based approaches alleviate issues of insufficient image utilization and textual overfitting. Nevertheless, two limitations persist. First, the lack of fine-grained semantic enhancement for cross-modal representations leads to category confusion and boundary discontinuity. Second, the absence of explicit modeling of inter-token structural relationships results in insufficient prediction stability for multi-word entities and multi-category coexistence scenarios. To address these limitations, this paper proposes a novel approach, Frequency-Aware Modulated Experts with Dual Affine for Multimodal Named Entity Recognition (FAME-DA). Specifically, we first achieve preliminary interaction between visual and textual information through visual semantic injection into the text encoding process. Furthermore, we design a frequency embedding-based expert modulation module to reconstruct and perform fine-grained semantic enhancement on the fused cross-modal representations, thereby highlighting entity-related features while suppressing background noise interference. Finally, we introduce a dual affine scoring strategy to explicitly model inter-token interaction relationships, enhancing intra-entity consistency and local structural dependency modeling capabilities, thereby improving prediction stability for multi-word entity recognition and complex multi-entity scenarios. We validate the effectiveness of FAME-DA on multiple widely adopted MNER datasets and conduct systematic evaluations of component contributions through ablation studies, efficiency analysis, and visualization analysis. Experimental results demonstrate that FAME-DA achieves F1 score improvements of 1.37 and 2.02 percentage points over the second-best baselines on the Twitter2015 and Twitter2017 datasets, respectively.}
}
@article{LIU2026117080,
title = {PatchMix: Local and contextual modeling with patch-wise mixed image for domain adaptive semantic segmentation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117080},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117080},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601806X},
author = {Meiqin Liu and Linfeng He and Zilin Wang and Chao Yao and Yunchao Wei},
keywords = {Domain adaptation, Semantic segmentation, Self-training, Consistency training, Masked-and-mixed image modeling},
abstract = {Unsupervised domain adaptive semantic segmentation (UDASS) aims to transfer a model trained on an annotated source domain to an unlabeled target domain, thereby avoiding expensive pixel-level labeling when the two domains exhibit substantial distribution shifts. In practice, UDASS is hindered by two persistent challenges: achieving fine-grained local discrimination and effectively exploiting scene context. To address these issues, we propose PatchMix, a training-time regularization formulation based on a mix–encode–replace–semantic-reconstruct procedure. Two target images are combined on a random patch grid into one mixed input, which is processed by the student encoder. Before decoding, feature positions corresponding to patches from the second image are replaced with scale-wise learnable [MASK] tokens. The decoder is then supervised to reproduce the semantic prediction of the complete first image generated by an exponential-moving-average teacher. Consequently, the encoder must recognize local content under mismatched context, while the decoder must recover missing semantics from retained evidence. The proposed strategy can be integrated into diverse UDASS pipelines and backbone architectures, ranging from CNNs to Transformers, and the PatchMix branch is removed at inference. Experiments on the standard synthetic-to-real benchmarks GTA5 → Cityscapes and SYNTHIA → Cityscapes demonstrate consistent improvements across the evaluated baselines.}
}
@article{MAO2026117077,
title = {Global prediction-error ordering and adaptive mechanisms for reversible data hiding},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117077},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117077},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018034},
author = {Ningxiong Mao and Wei Liang and Lingfeng Qu and Yue Li and Fangling Jiang},
keywords = {Reversible data hiding, Prediction-error value ordering, Global ordering, Adaptive prediction, Adaptive two-dimensional mapping},
abstract = {Existing reversible data hiding (RDH) methods based on prediction-error value ordering (PEVO) are typically performed within local image blocks, which limits their ability to exploit global image redundancy. To address this limitation, this paper proposes an RDH framework based on global prediction-error ordering and adaptive mechanisms. First, a global prediction-error ordering strategy is developed to rearrange prediction-errors according to local texture complexity, thereby effectively exploiting correlations among prediction-errors across the entire image. Second, an adaptive second-pass prediction strategy is designed to determine the prediction value according to the texture-complexity level of each prediction-error segment, resulting in a more concentrated distribution of second-pass prediction-errors. Third, an adaptive two-dimensional mapping strategy is introduced to select an appropriate mapping according to the actual prediction-error distribution, thereby further improving the embedding performance. Experimental results demonstrate that the proposed method achieves favorable embedding performance and visual quality across different embedding capacities. On the USC-SIPI image database, the proposed method achieves an average peak signal-to-noise ratio (PSNR) improvement of 0.21 dB over the state-of-the-art method at an embedding payload of 10,000 bits.}
}
@article{LI2026117089,
title = {NIDW: A post-hoc cascade multi-channel text watermarking framework with Newton interpolation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117089},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117089},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018150},
author = {Mingjie Li and Yonggang Zhang and Jun Li and Jizhao Liu and Runchuan Li and Shuqin Zhang},
keywords = {Text watermarking, Newton interpolation, Post-hoc embedding, Cascade decoding, Dual-channel embedding},
abstract = {The ubiquity of Large Language Models (LLMs) has precipitated a crisis in content provenance, necessitating watermarking solutions that are both imperceptible and resilient. However, existing methods typically face a “zero-sum” dilemma: distribution-based generative methods are fragile against semantic attacks, while lexical substitution methods often compromise textual coherence. To address this, we propose NIDW, a strictly post-hoc cascade multi-channel text watermarking framework. Unlike generation-time interventions that require white-box access, our approach is model-agnostic and acts entirely as a post-processing pipeline on generated surface text. It combines an invisible Core Channel based on Zero-Width Characters (ZWC) with dependency-stable semantic-anchor redundancy, while the cascade-enabled configuration additionally provides an explicit visible-marker recovery signal for position-agnostic secondary decoding. To ensure recoverability under structural corruption, we introduce a mathematical local resynchronization mechanism integrating frame-based encoding with Newton Interpolation. Experimental results demonstrate that while pure Core Channels are fragile under format sanitization and deep paraphrasing, our cascade decoding mechanism provides a deterministic secondary recovery path that complements Core-Channel reconstruction with visible-marker and anchor-based redundancy. To the best of our knowledge, this is the first application of Newton Interpolation for local watermark position recovery, allowing for precise coordinate estimation even when the absolute text topology is distorted.}
}
@article{LIU2026117113,
title = {C-GCG: Precise construction of adversarial suffixes via geometric structure analysis in token embedding spaces},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117113},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117113},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018393},
author = {Zheng Liu and Senlin Luo and Dapeng Li and Yong Ma and Xinshuai Li},
keywords = {Large Language Model, GCG attack, Token embedding manifold space, Clustering},
abstract = {While Greedy Coordinate Gradient (GCG) attacks are effective at bypassing Large Language Model (LLM) safety alignments, they remain limited by constructing adversarial suffixes at the discrete token level. Existing methods ignore the global geometric structure of the low-dimensional token embedding manifold, resulting in suffixes with poor semantic coherence and a tendency to fall into local optima. This severely restricts both attack success rates and convergence efficiency. Addressing this limitation, our multi-method clustering analysis reveals exploitable structural vulnerabilities within the manifold space. Leveraging these insights, we propose Clustered Greedy Coordinate Gradient (C-GCG), a framework that utilizes manifold geometric distribution characteristics to craft precise, semantically coherent adversarial suffixes. Evaluations show that C-GCG significantly outperforms the original GCG baseline in convergence speed, transferability, and overall efficacy. Notably, under data-scarce conditions (120 samples), C-GCG improves the attack success rate by 11.6 percentage points (a 35.7% relative increase). By shifting the jailbreaking paradigm from discrete token selection to global geometric computation within the embedding manifold, this work establishes a robust new direction for LLM security research.}
}
@article{WANG2026117158,
title = {Dynamic clustering for channel pruning guided by deep reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117158},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117158},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018848},
author = {Boxiao Wang and Jin Qian and Dongdong Xu and Guangli Ben and Chi Chen and Yongcheng Wang},
keywords = {Network pruning, Reinforcement learning, Hypergraph},
abstract = {Deep reinforcement learning (DRL)–based convolutional neural network pruning methods provide an effective framework for automated model compression from both theoretical and practical perspectives. However, existing DRL-based pruning approaches often neglect the functional characteristics and similarities of channels in network state representation. In addition, their action spaces are typically designed to generate layer-wise pruning ratios, which limits their ability to directly identify redundant channels. To address these limitations while enabling efficient deployment and acceleration on general-purpose hardware, we propose Dynamic Clustering for Channel Pruning (DCCP). Specifically, multi-frequency channel response statistics are employed to characterize the network state, thereby providing the agent with essential prior information for refined decision-making. Furthermore, we design a Dynamic Clustering Agent that exploits the representational capacity of hypergraph convolution to integrate complex channel-wise information and model high-order functional similarities among channels. This design enables the agent to effectively identify redundant channels for pruning. The proposed method is evaluated on two remote sensing scene classification datasets, NWPU-RESISC45 and NaSC-TG2. Experimental results on NaSC-TG2 show that DCCP reduces the floating-point operations of ResNet-50 by 68.52%, while achieving acceleration ratios of 1.41 × on a GPU and 1.24 × on a mobile embedded platform, with competitive classification accuracy.}
}
@article{LU2026117061,
title = {Intent augmentation contrastive learning for Session-based Social Recommendation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117061},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117061},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017879},
author = {Mengying Lu and Hai-Tao Zheng and Lan Zhou and Guangxin Wang},
keywords = {Session-based Social Recommendation, Contrastive learning, Data augmentation, Filter networks},
abstract = {Session-based Social Recommendation (SSR) aims to enhance next-item predictions by integrating a user’s session activities with their social networks, yet it struggles with data sparsity, particularly due to the very limited short-term interactions within sessions. Traditional studies have applied Contrastive Learning (CL) to address this problem, but they typically avoid explicit data augmentations to keep original session sequences intact, considering the sensitivity of short sessions to disturbances. This conservative strategy, however, may limit the diversification of user–item interactions, potentially causing overfitting and generalization problems, and thus inadequately addressing data sparsity in session contexts. In this paper, we propose Intent Augmentation Contrastive Learning (IACL) for SSR, a model-agnostic approach that utilizes dual training objectives for sophisticated intent modeling. It starts with explicit intra-session augmentation to target specific intents and then expands to capture broader high-level intent patterns across sessions with augmented inter-session prototypes. In contrast to traditional strategies that skip augmentation, the core of IACL is its intent augmentation strategy, which offers both intra-session and inter-session perspectives, significantly broadening the model’s exposure to various user behaviors and preferences, thus more effectively addressing data sparsity. Moreover, we introduce a denoised encoder module, Personalized Session Encoder with Filter Networks (PFN), which delivers personalized recommendations by incorporating all key features while suppressing noise in the frequency domain. By integrating PFN with IACL, we demonstrate that our approach, PFN-IACL, surpasses existing methods in performance across three datasets. Our code is freely available.11Find our code at https://anonymous.4open.science/r/PFN-IACL-WSDM26-32B5.}
}
@article{DURANLOPEZ2026117145,
title = {R-TVF: A Regularized Time-Varying Fourier method for missing data recovery},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117145},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117145},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601871X},
author = {Alberto Durán-López and Daniel Bolaños-Martinez and Zakaria {Sahraoui El Ouahabi} and Antonio {García Hernández} and Juan Carlos Suárez and Maria Bermudez-Edo},
keywords = {Time series imputation, Frequency-informed modeling, Algorithmic data reconstruction, Asteroseismology, Delta scuti stars},
abstract = {High-precision space photometry enables the continuous monitoring of stellar oscillations, which manifest as variations in stellar flux, known as light curves. However, large data gaps distort the signal’s shape, making time series imputation important for recovering these underlying flux oscillations. Standard interpolation methods fail to reconstruct intrinsic variability. Conversely, traditional harmonic methods (e.g., Dynamic Harmonic Regression, Trigonometric Box–Cox AutoRegressive Moving Average Trend Seasonal, and Frequency-Specific Basic Structural Model) capture periodic patterns but fail to adapt to multi-periodic non-stationary stellar flux variations across large gaps due to the recursive propagation of stochastic parameters and the risk of phase drift. To address this, we propose the Regularized Time-Varying Fourier (R-TVF) method. This frequency-informed algorithm models the signal as a superposition of periodic components with time-varying amplitudes, effectively integrating domain knowledge directly into its structure. We evaluated R-TVF on 72 Delta Scuti stars, subdivided into High-Amplitude Delta Scuti (HADS) and Low-Amplitude Delta Scuti (LADS) stars. Within this specific stellar family, the experimental results demonstrate that R-TVF outperforms state-of-the-art algorithms, achieving a mean R2 between 0.968 and 0.987 for HADS and between 0.761 and 0.816 for LADS. In terms of performance, R-TVF improves accuracy by 3% to 9% and reduces execution time by 80% to 88% compared to the second-best performing method.}
}
@article{WANG2026117008,
title = {Reinforcement learning-augmented particle swarm optimization with orthogonal perturbation operator for multi-UAV path planning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117008},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117008},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601734X},
author = {Duohua Wang and Weifeng Gao and Zhengjun Wang and Hong Li and Jin Xie},
keywords = {Multi-UAV path planning, Particle swarm optimization, Reinforcement learning, Global optimization, Orthogonal perturbation operator},
abstract = {Multi-unmanned aerial vehicle (Multi-UAV) path planning in complex three-dimensional (3D) environments is a challenging task due to high-dimensional search spaces, multiple constraints, and numerous local optima. To address these issues, this paper proposes a particle swarm optimization-based orthogonal perturbation operator algorithm (OPOPSO). The proposed algorithm, which introduces an orthogonal perturbation operator to break the rigid update pattern of traditional particle swarm optimization, can enhance global exploration and alleviate premature convergence. A dynamic topology reorganization mechanism is designed to establish randomized interaction topologies and select guiding exemplars for each particle, which enhances population diversity. Furthermore, an adaptive parameter control framework based on reinforcement learning is proposed. This framework integrates a Dueling Double Deep Q-Network with a dual reward mechanism to alleviate the sparse reward problem. Experiments are conducted on the CEC2017 benchmark suite, as well as on path planning simulations using real-world digital elevation model (DEM) maps derived from Australian LiDAR data. Experimental results illustrate that OPOPSO achieves competitive performance against 16 advanced optimization algorithms, including seven PSO variants, four differential evolution variants, and five other metaheuristic algorithms, on the benchmark suite, while also maintaining superior solution quality and scalability in complex 3D path planning tasks.}
}
@article{KONG2026117029,
title = {IDNet: Instance-level background disentanglement for few-shot object detection with parallel matching},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117029},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117029},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017557},
author = {Dongyi Kong and Zhaobin Chang and Xiong Gao and Yonggang Lu},
keywords = {Deep learning, Few-shot object detection, Few-shot learning, Background disentanglement, Parallel matching network},
abstract = {Few-shot object detection (FSOD) aims to detect previously unseen objects using only a few examples; however, several key challenges remain despite recent progress. In general, bounding box annotations comprise background pixels, which we refer to as instance-level background. In conventional object detection, the influence of instance-level background is mitigated through generalization achieved by training on large-scale datasets. However, in FSOD, the extreme scarcity of training data makes this influence far more pronounced. Decoupling instance-level background enables the model to effectively distinguish between the foreground and background of proposals, whereas existing models overlook this aspect. To address this issue, we propose an instance-level background disentanglement module. Specifically, we first develop an algorithm that extends the border pixels of instances to automatically generate ground-truth annotations for the instance-level background. Subsequently, we develop a disentanglement module and train it using these annotations to enable the decoupling of the instance-level background. Furthermore, existing methods often require proposals to match each support category sequentially, which prevents parallel detection and significantly reduces detection efficiency. We overcome this limitation by designing a parallel matching network capable of simultaneously detecting multiple novel objects. Moreover, existing methods rely on fine-tuning for novel categories to maintain performance. Consequently, we propose a classification-guided localization fusion module that enhances detection capability without fine-tuning. Our proposed method, IDNet, integrates all three improvements and achieves state-of-the-art performance on several metrics from the Pascal VOC and MS-COCO benchmarks, surpassing other comparable methods that do not require fine-tuning.}
}
@article{ACENA2026117057,
title = {Minimum Spanning Trees ensemble framework: A geometric classifier},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117057},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117057},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017831},
author = {Víctor Aceña and F. Javier Martín-Campo and Paula Terán-Viadero},
keywords = {Minimum Spanning Tree (MST), Ensemble learning, Affinity score, Inductive learning, Supervised classification},
abstract = {Classifiers based on the Minimum Spanning Tree (MST) capture complex, non-linear class geometries that elude many standard models, but a single MST is inherently unstable: small changes in the training data can reshape the tree and degrade classification performance. Existing MST-based ensembles address this only partially, either collapsing structural evidence into hard voting decisions or re-analyzing the graph topology at every prediction, limiting scalability and inductive capability. To resolve both limitations, a two-phase framework is introduced that permanently decouples topological analysis from inference. In Phase I, an ensemble of MSTs is built on subsamples drawn with a randomly perturbed class ratio, exposing it to diverse density regimes. A local model is then trained on the pure instances of each subsample, identified through the label homogeneity of the MST neighborhood, and used to infer the affinity of the remaining ambiguous ones, without manual calibration of where the ensemble should specialize. Averaging these local affinities across the ensemble yields a continuous, per-instance affinity score quantifying class membership, replacing hard voting with a graded, ensemble-aggregated measure. In Phase II, this pre-computed score is reused for prediction through interchangeable strategies, such as k-nearest-neighbor interpolation or a dedicated regression model, without ever reconstructing the graph. This separation makes the framework modular, adapting the prediction mechanism to the problem while preserving the topological sensitivity of the underlying MST ensemble.}
}
@article{SUN2026117097,
title = {ViSA: Subquadratic cross-modal attention with dual-path subtractive fusion},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117097},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117097},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601823X},
author = {Huiteng Sun and Ming Jiang and Meiqu Lu},
keywords = {Video–text retrieval, Linear attention, Differential attention, Efficient transformer, Multimodal retrieval},
abstract = {Video–text retrieval becomes increasingly expensive as the number of videos grows, because standard cross-attention quadratically scales with sequence length. Existing methods usually improve either retrieval accuracy or computational efficiency but rarely both simultaneously. To address this issue, we present Video–text interactive Synergistic Attention(ViSA), a video–text interaction framework based on Kernelized Linear Attention(KLA) and subtraction-based fusion. The model reduces the cost of cross-modal interaction by pre-aggregating video features, meaning the cross-modal interaction cost linearly grows with the text and video lengths instead of forming a full attention matrix. Meanwhile, the differential design helps preserve useful discriminative information that is often weakened in Linear Attention. We evaluated ViSA on four benchmarks: MSR-VTT, LSMDC, DiDeMo, and VATEX. Under these evaluation settings, ViSA achieved competitive retrieval results while using fewer giga floating-point operations(GFLOPs) than the compared Contrastive Language–Image Pretraining (CLIP)-based baselines. On MSR-VTT, it achieved a Recall at 1 (R@1) of 51.3% via 58 GFLOPs. Overall, ViSA provided an efficient way to handle large-scale video–text retrieval without relying on quadratic Softmax Attention.}
}
@article{ZHI2026117074,
title = {TriMed-FSSL: A triplet federated self-supervised learning framework for robust skin image analysis under non-IID data},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117074},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117074},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018009},
author = {Yichen Zhi and Hongxia Bie and Jiali Wang and Zhao Jing},
keywords = {FSSL, Non-IID, VMamba, FedFLO, DAVG},
abstract = {Building artificial models for automatic skin image analysis has achieved progressive results in these years, while most studies still suffer from data privacy concerns and high labeling costs. Federated self-supervised learning (FSSL) integrates federated learning (FL) with self-supervised learning (SSL) to manage distributed, unlabeled medical image data, yet encounters convergence issues and performance degradation due to non-IID data. Existing approaches, such as personalized modeling, local normalization, and regularization strategies, often rely on labeled data, correct only superficial biases, or require extensive parameter tuning, limiting their effectiveness in systematically resolving performance issues in FSSL. To overcome these limitations, we propose the Triplet Medical Federated Self-Supervised Learning (TriMed-FSSL) framework, which enhances model performance under non-IID conditions through integrated innovations in network architecture, optimization strategy, and aggregation mechanisms. First, we experimentally find that the visual state-space backbone network VMamba can effectively mitigate data heterogeneity by taking advantage of its global sensory field and efficient state-space modeling. Second, we propose the Federated Flatness-Oriented Optimization (FedFLO) strategy, which employs gradient perturbation and flat-optima orientation to enhance model generalization and robustness. Finally, we develop the Distribution-Aware Aggregation via Variational Autoencoder (VAE)-Generated Samples (DAVG) strategy, which utilizes samples generated by a VAE to approximate client distributions and dynamically correct statistical deviations, thereby enhancing the robustness of aggregation. Extensive experiments on various skin datasets demonstrate that TriMed-FSSL significantly outperforms existing methods, showing improved performance and stability in federated self-supervised learning scenarios characterized by non-IID data. At the same time, it demonstrates greater transferability across chest X-ray datasets. Code is available at https://github.com/wsdl666/TriMed-FSSL.}
}
@article{MIRALLESGONZALEZ2026117013,
title = {Evaluating the scalability and adversarial generalization of GRPO-trained NLI models},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117013},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117013},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017399},
author = {Pablo Miralles-González and Javier Huertas-Tato and Alejandro Martín and David Camacho},
keywords = {Natural language inference, LLMs, GRPO},
abstract = {Natural Language Inference (NLI) is a central task in natural language understanding with applications in fact-checking, question answering, and information retrieval. Despite its importance, current NLI systems heavily rely on supervised learning with datasets that often contain annotation artifacts and biases, limiting generalization and real-world applicability. In this work, we apply a reinforcement learning-based approach using Group Relative Policy Optimization (GRPO) for Chain-of-Thought (CoT) learning in NLI, eliminating the need for human-labeled rationales and enabling this type of training on challenging datasets such as ANLI. We fine-tune 7B, 14B, and 32B language models using parameter-efficient techniques (LoRA and QLoRA), demonstrating strong performance across standard and adversarial NLI benchmarks. At the 32B scale, GRPO-trained models generalize better than other supervised baselines in adversarial sets. With AWQ quantization, the 32B model fits within 22 GB of CUDA memory. This work provides a scalable and practical framework for building robust NLI systems without sacrificing inference quality.}
}
@article{SILVA2026117102,
title = {Affect-conditioned prompt orchestration for mental-health support chatbots: Architecture, ablation analysis, and safety considerations},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117102},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117102},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018289},
author = {Luís Silva and Sebastião Pais and Muhammad Luqman Jamil},
keywords = {Mental-health support, Conversational agents, Large language models, Prompt orchestration, Affective computing, Emotion recognition, AI safety},
abstract = {Large language models (LLMs) are increasingly used for mental-health support, where fluency is both an asset and a risk: a stand-alone model can sound empathic while missing emotional cues, reading sarcasm literally, or leaving discriminatory framing unchallenged. We investigate a modular architecture in which affective and safety signals actively guide an LLM-based support chatbot rather than being logged as passive labels. The prototype couples Gemma 3 4B with classifiers for sentiment, emotion, sarcasm, and hate speech, whose outputs feed a prompt orchestration layer that shapes response tone, intervention style, personalisation, and safety handling, alongside user profiling, short-term memory, and adaptive guidance-mode selection. An ablation-oriented evaluation compares an LLM-only baseline with sentiment-, emotion-, profile-, and hate-speech-conditioned variants and the full system, using a structured response-level rubric with semantic similarity as an auxiliary indicator. Affect conditioning mainly reshapes how responses are framed, most visibly in validation and the handling of discriminatory content, while conditional safety prompting produces the clearest behavioural change; configurations converge on the same concern while diverging in framing and safety stance. The evaluation is exploratory by construction: single generations, one base model, author-applied criteria, and no independent raters, so we report no significance tests and make no claim of clinical efficacy. We also analyse how classifier error propagates into the orchestration layer and specify the human, adversarial, and benchmark-based evaluation such systems require before real-world use. The contribution is an architecture whose determinants are inspectable and separately adjustable, together with the protocol under which it should be judged.}
}
@article{SONG2026117021,
title = {Frequency interpolation with period-aware regularization for robust long-term time series forecasting},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117021},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117021},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017478},
author = {Zhangyao Song and Nanqing Jiang and Ziqiong Li and Li Zhuang and Yinfei Xu and Tao Guo},
keywords = {Long-term time series forecasting, Frequency interpolation, Cutoff frequency, Series decomposition, Period-aware regularization},
abstract = {Long-term time series forecasting requires separate modeling of global changes that reflect system evolution and local changes that capture fine-grained fluctuations. However, classical decomposition methods often fail to decouple these components because of strong coupling effects and limited receptive fields, while also lacking principled guidance for cutoff frequency selection and residual regularization. To address these limitations, we propose Frequency Interpolation with Period-aware Regularization (FIPR), a framework that combines Frequency Interpolation Decomposition (FID) with Period-aware Regularization Patching (PRP). The decomposition module operates in the frequency domain and interpolates Fourier coefficients across time windows, ensuring continuity while recovering the underlying global variation. We further derive a principled closed-form cutoff frequency from anti-imaging filtering theory to eliminate hyperparameter search and suppress aliasing. The residual is then processed by PRP, which uses period-aware downsampling and weight sharing to impose implicit regularization against periodic bias. To demonstrate the effectiveness of FIPR, we build a simple yet effective model, FIPRNet, consisting of FIPR and a Multi-Layer Perceptron (MLP) head; it achieves state-of-the-art performance on real-world datasets from multiple domains. Furthermore, as a plug-and-play module, FIPR can also improve the performance of existing models.}
}
@article{WANG2026117073,
title = {Dual-modal Evolving Latent Task Attention for CLIP-based class-incremental learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117073},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117073},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017995},
author = {Chuanning Wang and Song Lin and Jialin Li and Zhiyong He},
keywords = {Class-incremental learning, Vision-language models, Task-specific memory, Cross-modal distillation, Dual-path attention},
abstract = {Class-incremental learning (CIL) with vision-language models such as CLIP faces two structural challenges: existing methods treat each task independently and ignore the relational structure between tasks, and visual and textual task knowledge is conflated into a single undifferentiated representation without modality-specific memory. We propose DELTA (Dual-modal Evolving Latent Task Attention), a framework built on three tightly coupled components. Modal Evolving Task Tokens (METT) allocate a pair of modality-specific, unit-normalized token matrices per task — one for the visual stream and one for the textual stream — both residing on the same unit hypersphere as CLIP embeddings; upon task completion, both streams are excluded from gradient updates but remain eligible for parameter-free injection by future tasks. Cross-Modal Distillation (CMD) initializes each new METT pair from text-guided visual task anchors and retroactively injects the current task’s anchor into all historical METT pairs via closed-form similarity-weighted updates. Dual-Path Task Attention (DPTA) fuses task-specific and historical knowledge through a forward self-attention path over the full token sequence and a modal-decoupled backward retrieval path, balanced by learnable gating scalars. Experiments on nine diverse benchmarks show that DELTA consistently outperforms all compared methods under both zero-base and large-base split settings, with particularly strong gains on challenging out-of-distribution datasets.}
}
@article{HUANG2026117110,
title = {AMAD: AutoMasked Attention for unsupervised multivariate time series anomaly detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117110},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117110},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018368},
author = {Tiange Huang and Gengsen Li and Yongjun Li and Wenyun Zhang},
keywords = {Multivariate time series, Anomaly detection, Masked attention, Self-supervised learning, Deep unsupervised learning},
abstract = {Unsupervised multivariate time series anomaly detection (UMTSAD) is critical in domains such as finance, networks, and sensor systems. Due to the scarcity of labeled anomalies, the field has predominantly shifted toward unsupervised paradigms, among which Transformer-based reconstruction models are commonly used to learn normal patterns and identify anomalies through reconstruction errors. However, when trained on large-scale data containing unlabeled anomalies, such models may inadvertently reconstruct anomalies, blurring the normal-abnormal boundary. Moreover, the anomaly association assumptions underlying these approaches often rely on predefined patterns such as concentrated or peak anomalies, limiting generalization to diverse real-world anomaly types. To address these two issues, we propose AMAD, which integrates AutoMasked Attention for UMTSAD tasks. AMAD introduces a novel structure based on the AutoMask mechanism and an attention mixup module, forming a simple yet generalized anomaly association representation framework, which directly targets the restrictive-prior issue by learning association patterns adaptively rather than relying on predefined assumptions. This framework is further enhanced by a Max-Min training strategy, which explicitly widens the reconstruction-error gap between normal and abnormal segments to mitigate the anomaly-absorption issue, and a Local-Global contrastive learning approach. Extensive experimental results demonstrate that AMAD achieves competitive performance against strong baselines, with particularly strong results on datasets exhibiting multi-scale temporal anomaly structures.}
}
@article{HEIDARI2026117098,
title = {SATI: a continuous state-space and OCSVM-based method for delay-aware sensor anomaly detection in smart-city transit systems},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117098},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117098},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018241},
author = {Arash Heidari and Abdulnasir Hossen and Majdi Mansouri},
keywords = {Adaptive Kalman filtering, Sensor integrity monitoring, Smart-city transit systems, Delay-aware estimation, Explainable anomaly detection},
abstract = {Increasingly, urban transit systems depend on linked bus fleets with lots of sensors to control headway and coordinate fleets in real time. But these systems have a lot of problems with their operations because of sensor failures, environmental disruptions, and built-in communication delays that come with smart-city infrastructure, like LTE/5G networks and Transit Operations Center (TOC) latency. Conventional estimating methods, such as Kalman filters and χ²-based statistical detectors, are inadequate for addressing non-Markovian dynamics and do not produce interpretable outputs essential for operational decision-making. This study presents Smart-city Anomaly-aware Transit sensor Integrity (SATI), a comprehensive framework for anomaly detection, integrity oversight, and elucidation in bus fleets susceptible to delays. SATI models the transit system with a continuous-time, delay-aware headway control formulation and uses an Adaptive Extended Kalman Filter (AEKF) that propagates states with delays while changing noise covariances based on trends in innovation. A dynamic One-Class SVM (OCSVM) module analyzes normalized innovation sequences. This module changes between classifiers that have been trained on different anomaly profiles to tell the difference between subtle sensor drifts and sudden signal dropouts. SATI also makes things clearer by adding a SHAP-based explainability layer that links anomalies to individual sensors and shows the main reasons at the TOC level. SATI improves anomaly detection F1-scores by almost 20% under multimodal sensor defects and reduces headway estimation error by up to 65% under smart-city delay conditions, outperforming state-of-the-art baselines. Furthermore, in real-world deployment, SATI achieves about 4–7% greater detection accuracy while reducing inference latency by over 60% on edge devices.}
}
@article{XU2026117106,
title = {RFF-Net: Robust frequency–noise fusion network for AI-generated image discrimination},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117106},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117106},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018320},
author = {Yuntong Xu and Ronggui Yang and Shengyuan Zhou},
keywords = {AI-generated image discrimination, Visual forensics, Physics-guided features, Frequency–noise fusion, Cross-domain fusion},
abstract = {The rapid progress of generative models has made AI-generated images increasingly photorealistic, challenging reliable image forensics. This work targets GAN-based and diffusion-based image generation; text-to-video synthesis, 3D content generation, and partial face manipulation are out of scope. Existing discriminators typically rely on a single dominant cue — spatial artifacts, spectral statistics, reconstruction discrepancy, or pretrained semantic features — yet their reliability degrades under generator shifts or post-processing. In contrast, real imaging jointly shapes frequency statistics and residual noise through the physical acquisition pipeline, yielding an intrinsic frequency–noise coupling that remains under-exploited. AI synthesis targets perceptual realism without being constrained to satisfy this coupling, leaving systematic frequency–noise inconsistencies as stable forensic evidence. Prior methods, however, exploit frequency and noise cues in isolation or combine them only through implicit feature fusion, offering no direct way to verify whether the two domains provide mutually consistent evidence. To address this, we propose RFF-Net, a physics-guided robust frequency–noise fusion network. It jointly learns directional spectral and multi-scale noise-flow representations, and introduces a Cross-domain Physical Consistency Module (CPCM) to project them into a shared space and explicitly verify their agreement via a margin-based constraint, producing interpretable discrepancy evidence. A dual-stream Transformer fusion module further aggregates cross-domain information adaptively for robust decision making. Experiments on multiple public benchmarks show that RFF-Net achieves state-of-the-art or highly competitive performance under in-distribution, cross-generator, cross-dataset, and post-processing settings, validating physical-consistency verification for reliable AI-generated image discrimination.}
}
@article{SHI2026117082,
title = {PACE-Net: Pretrained Asymmetric Color-Decoupled Enhancement Network for low-light image enhancement},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117082},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117082},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018083},
author = {Wenbin Shi and Wenyao Tian and Zihao Huang and Jingsheng Lei and Xinran Gao},
keywords = {Low-light image enhancement, Asymmetric dual-stream network, Masked autoencoder prior, Color-space decoupling, Degradation-aware guidance},
abstract = {Low-light image enhancement requires recovering color and structure from signals that degrade at unequal rates: in extremely dark regions, the chroma plane of an image decomposed in the HVI color space loses usable evidence earlier than the intensity channel. Most HVI-based enhancers nevertheless restore the two components with branches of similar structure and capacity. PACE-Net instead allocates capacity by reliability. The severely degraded chroma plane is treated as a completion problem and assigned to a Chromatic Prior Module, a Vision Transformer pretrained as a masked autoencoder that restores the plane in a single conditioned forward pass; the comparatively reliable intensity channel forms the main recovery pathway, handled by a Structural Recovery Encoder with Branch-Adaptive Refinement. The two streams interact only through three narrow communication channels: shared guidance from a frozen degradation-aware encoder, a compressed bottleneck bridge, and a final intensity-to-chroma correction. Across paired, unpaired, and zero-shot cross-dataset protocols, PACE-Net achieves the best PSNR, SSIM, and LPIPS on LOLv2-Real among all compared methods and the lowest NIQE on the five classical unpaired suites, and controlled ablations attribute the largest single-component gain to the chromatic prior.}
}
@article{SAMMARTINO2026117001,
title = {Vulnerabilities in autonomous execution: A survey of security threats and defenses in LLM-driven agentic and multi-agent systems},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117001},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117001},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017272},
author = {Vincenzo Sammartino},
keywords = {LLM agents, Multi-agent systems, Prompt injection, AI security, Information-flow control, systematic literature review},
abstract = {Large language models (LLMs) are no longer confined to producing text. Equipped with tools and composed into multi-agent systems, they now act on the world with limited human oversight. This shift from generation to autonomous execution transforms the security landscape. While prompt injection against a chatbot yields, at worst, an embarrassing sentence, the same injection against a tool-using agent can result in an exfiltrated database, a fraudulent transaction, or a poisoned message propagating to peer agents. The vulnerability class is not new, but the blast radius is. This article surveys the security of LLM-driven agentic and multi-agent systems from 2023 through early 2026, following a pre-specified, PRISMA-informed review protocol that we report in full so that the corpus can be reproduced and extended. We contribute a threat taxonomy classifying attacks by entry point, propagation path, and target asset, together with an explicit statement of the conditional dependencies among these three dimensions. Using this, we organise four threat families – indirect prompt injection, malicious tool use, inter-agent infection, and memory poisoning – consolidating 44 attack papers into a unified comparison, annotated with reported attack success rate, paired task utility, and peer-review status. We review the defensive landscape across five categories (detection, structural separation, execution isolation, information-flow control, and alignment-side hardening) and map defenses to threats under an operationally defined coverage criterion, assessing each family for adaptive-attack resistance, deployment cost, and residual risk, to expose coverage gaps. Two findings recur. First, no purely prompt-level defense in the reviewed literature is reported to withstand adaptive attackers; effective security requires constraining what the system around the model is permitted to do, rather than relying on model robustness. Second, multi-agent propagation – the mechanism making agentic compromise qualitatively worse than single-model compromise – is the least defended part of the stack in the corpus we assembled, with almost no deployed frameworks enforcing trust boundaries between cooperating agents. We conclude with a research agenda and a minimal security-reporting standard for agent frameworks.}
}