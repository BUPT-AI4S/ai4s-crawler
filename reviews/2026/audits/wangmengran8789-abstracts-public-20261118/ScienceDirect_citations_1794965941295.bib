@article{TANG2026116824,
title = {FHCA-Net: Frequency-domain hybrid cross attention network for visible-infrared object detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116824},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116824},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015509},
author = {Yinggan Tang and Shijie Zhu and Min Shen},
keywords = {Multimodal object detection, Cross-attention fusion, Frequency-domain feature fusion, Adaptive channel attention},
abstract = {Efficient cross-modal feature fusion is critical for visible-infrared object detection, yet remains challenging due to inadequate fusion strategies and cross-modal interference. Existing frequency-domain methods often disregard the distinct characteristics of different spectral components, performing uniform interactions across the full frequency spectrum. This leads to suboptimal fusion, where semantic misalignment persists and fine-grained details are insufficiently complemented, ultimately limiting performance under complex environmental conditions such as low illumination and occlusion. To address these issues, we propose a Frequency-domain Hybrid Cross-Attention (FHCA) mechanism that explicitly decomposes cross-modal features into low- and high-frequency components in the Fourier domain. Low-frequency interactions are designed to establish robust semantic alignment, while high-frequency interactions enhance complementary fine-grained details. These hybrid frequency interactions are adaptively weighted and reconstructed to form discriminative fusion representations. Additionally, we introduce an L2-norm–based Gated Cross-Modal Channel Attention (L2GCA) module, which mitigates modality-specific intensity bias by dynamically reweighting channel contributions based on energy modeling. Extensive experiments conducted on the FLIR, M3FD, and LLVIP datasets demonstrate that our approach achieves state-of-the-art performance. It exhibits strong robustness under challenging imaging conditions, particularly in low-light and adverse weather scenarios, confirming the effectiveness of the proposed frequency-aware fusion and channel modulation strategy.}
}
@article{ANDELIC2026116925,
title = {Explainable multi-sensor fusion for robot movement classification using genetic programming-based symbolic expressions},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116925},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116925},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016515},
author = {Nikola Anđelić and Sandi Baressi Šegota and Vedran Mrzljak},
keywords = {Genetic programming, Symbolic classifier, Robot movement classification, Ultrasound sensors, Ensemble methods, Dataset preprocessing, Threshold-based voting ensemble, Oversampling, 5-fold cross-validation},
abstract = {Accurate robot movement classification is essential for improving the reliability and safety of autonomous systems, especially in dynamic environments where precise motion decisions support task execution and collision avoidance. Multi-sensor data fusion can improve classification robustness by combining complementary information from multiple sensors. However, many high-performing classification models remain difficult to interpret, which limits their use in applications where transparent decision-making is required. This study proposes an explainable classification framework based on genetic programming symbolic classification (GPSC) for multi-sensor robot movement classification. A publicly available dataset collected from 24 ultrasound sensors mounted on the SCITOS G5 mobile robot is used to classify five movement types: forward motion, slight left turn, slight right turn, sharp left turn, and sharp right turn. To address class imbalance and preprocessing sensitivity, several oversampling methods and six scaling/normalization strategies are evaluated. GPSC models are optimized using random hyperparameter value search and assessed using stratified 5-fold cross-validation. The best symbolic expressions are selected using accuracy (ACC), balanced accuracy (BACC), precision, recall, F1-score, area under the receiver operating characteristic curve (AUC), and matthews correlation coefficient (MCC). Threshold-based voting ensembles (TBVEs) are then constructed from the top symbolic expressions to improve robustness across dataset variations. The results show that the proposed TBVEs achieve perfect classification performance across all evaluation metrics. More importantly, the generated symbolic expressions provide explicit mathematical representations of sensor relationships, supporting transparent analysis of robot movement patterns. The proposed framework therefore offers an accurate and interpretable solution for multi-sensor robotic motion classification.}
}
@article{JIAO2026116949,
title = {Multi-Branch Stochastic Configuration Network for trapezoidal data streaming with concept drift},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116949},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116949},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016758},
author = {Botao Jiao and Yinan Guo and Kai Zhang and Shihui Liu},
keywords = {Concept drift, Trapezoidal data stream, Stochastic configuration network, Online learning},
abstract = {Existing research on concept drift in data streams typically assumes a fixed feature space, where only the data distribution evolves over time. However, in many real-world scenarios such as industrial monitoring and sensor systems, new features may be introduced incrementally, giving rise to trapezoidal data streams. When feature-space expansion and concept drift occur simultaneously, conventional stream classifiers either fail to exploit the newly available features or suffer from severe interference between historical knowledge and emerging concepts. To address these challenges, a Multi-Branch Stochastic Configuration Network (MSCN) is proposed for trapezoidal data streams with concept drift. Specifically, MSCN maintains one main branch and multiple residual branches to model the evolving decision structure. When new features become available, hidden-node expansion is first performed to incorporate the newly available information into the current model, after which a new residual branch is constructed to capture complementary dependencies that cannot be sufficiently represented by the existing branches. In addition, a periodic branch-reconstruction mechanism is introduced to refresh the main branch and retain only useful residual branches, thereby improving adaptation to abrupt changes. Moreover, MSCN preserves the universal approximation property inherited from stochastic configuration networks. Experimental results on 12 synthetic and real-world datasets demonstrate that MSCN achieves superior overall performance to representative baselines.}
}
@article{LI2026116844,
title = {Multi-view contrastive learning with relational distillation for EEG-visual synergistic aerial target recognition},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116844},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116844},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015704},
author = {Zixing Li and Xiaojia Xiang and Zhen Lan and Chao Yan and Dengqing Tang},
keywords = {EEG, Multimodal learning, Aerial target recognition, Contrastive learning, Knowledge distillation},
abstract = {Aerial target recognition in remote sensing is a critical yet challenging task due to complex backgrounds and small object sizes. Human cognitive signals, particularly electroencephalography (EEG), offer a rich source of high-level semantic information that can significantly guide the recognition process. However, effectively fusing the abstract information from EEG with dense visual features remains challenging. To this end, we propose a multi-view contrastive learning with relational distillation (MCRED) approach for alignment and fusion between EEG and visual data in aerial target recognition. We first introduce the multi-view synergistic contrastive learning mechanism for feature-level alignment, optimizing representations from intra-modal and inter-modal views to preserve modality-specific discriminative cues and promote cross-modal complementary representation learning. Furthermore, we propose the fusion-guided relational distillation module for relation-level alignment. This module uses the fused representation to select high-confidence positive relations and regularizes the relational consistency between unimodal embedding spaces over these reliable pairs. Through integrated feature and relational alignment, MCRED achieves robust fusion of inherently low-redundancy modalities like EEG and visual data. Extensive experiments on a challenging EEG–image aerial target recognition dataset demonstrate that our approach achieves the best performance among the compared methods, significantly outperforming existing approaches.}
}
@article{YANG2026116888,
title = {Support-guided multi-view feature fusion for transductive few-shot learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116888},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116888},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601614X},
author = {Jianning Yang and Ying Liu and Jize Xue and Haijin Zeng and Jie Fang and Qi Tian},
keywords = {Transductive few-shot learning, Multi-view learning, Feature fusion, Subspace learning},
abstract = {Few-shot learning (FSL), which aims to learn novel concepts from limited labeled samples, is a challenging problem. Existing FSL methods typically adopt a single backbone (e.g., WRN or ResNet) for feature extraction, which inevitably introduces backbone-specific bias. By contrast, multi-view features extracted from heterogeneous backbones (e.g., WRN, ResNet, and DenseNet) can provide complementary information and reduce such bias. In this paper, we propose a support-guided multi-view fusion framework that leverages both cross-view consistency and view-specific complementarity of multi-view features to learn a discriminative representation for transductive FSL. Specifically, we learn an episode-aware similarity matrix from multi-view self-representations, guided by the labeled support set through a masked regularization. We then perform graph-regularized fusion based on the learned similarity matrix to align multi-view features into a unified representation. Finally, we learn a discriminative subspace for classification by jointly exploiting the learned similarity matrix and the fused multi-view representations. Experiments on four standard FSL benchmarks demonstrate that our approach achieves consistent improvements over representative transductive FSL methods.}
}
@article{XU2026116909,
title = {Partition-guided adaptive filtering for discriminative multi-view representation learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116909},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116909},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016357},
author = {Shanru Xu and Weiran Liao and Hongrong Chen and Yiqing Shi and Shiping Wang},
keywords = {Multi-view learning, Semi-supervised classification, Graph filtering, Mixture of experts},
abstract = {With the rapid development of multimedia technology, heterogeneous data in practical applications have increased significantly, and graph-based multi-view learning has become an important paradigm for node representation learning. However, most existing methods mainly focus on view-level graph filtering and typically apply the same filter within each view, while overlooking fine-grained differences. Therefore, they cannot accurately capture the differentiated filtering requirements of nodes in multi-view graphs. In particular, different nodes within the same view choose different graph filters, and this phenomenon similarly exists among views. To address these challenges, we propose Partition-guided Multi-view Graph Filtering (PMGF), which captures node-level differences within each view and adaptively integrates shared information from different views. Specifically, within each view, the proposed model first constructs coarse node partitions in a low-rank feature space. It then assigns suitable spectral filtering experts to nodes based on the resulting partitions. Among views, the model combines multi-view representations, extracts shared information by measuring cross-view distances, and then assigns different weights to different views before the final fusion. Experimental results on multiple benchmark datasets demonstrate the effectiveness of PMGF and its advantages over competitive methods in multi-view node classification.}
}
@article{YANG2026116961,
title = {Spectral graph contrastive learning via adaptive adjacent-order residual injection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116961},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116961},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016874},
author = {Haifeng Yang and Liming Zhu and Jianghui Cai and Jie Wang and Guojiao An and Tingting Bian and Xujun Zhao},
keywords = {Graph contrastive learning, Self-supervised graph learning, Spectral graph filtering, Chebyshev polynomial filtering, Adaptive spectral residual injection},
abstract = {Spectral graph contrastive learning (SGCL) has garnered considerable research attention in graph representation learning due to its ability to exploit the frequency-domain characteristics of graph signals. Existing SGCL methods typically aggregate multi-order Chebyshev responses to construct complementary low-pass and high-pass spectral views. However, variations between adjacent polynomial orders remain implicitly represented in the aggregated responses, limiting their explicit utilization for modeling fine-grained order-wise spectral variations. To address this issue, we propose A2R-GCL, a novel adaptive adjacent-order spectral residual injection framework for graph contrastive learning. Specifically, we introduce adjacent-order spectral residuals derived from Chebyshev polynomial decomposition, thereby explicitly representing the fine-grained spectral variations that remain implicit in conventional aggregated representations. Subsequently, to achieve stable residual compensation, we develop a residual compensation mechanism that integrates learnable residual weighting, branch-wise energy matching, and data-dependent spectral gating to regulate residual allocation between the low-pass and high-pass branches. Extensive experiments on 14 benchmark datasets demonstrate that A2R-GCL achieves competitive performance against representative baseline methods. Ablation, sensitivity, visualization, and efficiency analyses further support the effectiveness and practicality of A2R-GCL for structure-preserving spectral graph representation learning.}
}
@article{QAMMAR2026116856,
title = {Privacy-preserving federated learning for carbon emission forecasting: Methodology and case study},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116856},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116856},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015820},
author = {Attia Qammar and Qazi Haseeb Yousaf and Ali Azam and Ammar Ahmed and Abdenacer Naouri and Tianrui Li},
keywords = {Carbon emission, Federated learning, Privacy preservation, LSTM, Data privacy},
abstract = {Accurate carbon emission forecasting at fine spatial granularity is essential for policy planning and sustainable urban management. However, conventional centralized modeling approaches require direct access to sensitive province- and sector-level emission data, raising significant confidentiality concerns. Federated learning offers a distributed alternative, yet existing studies rarely incorporate formal differential privacy guarantees or systematically analyze how privacy mechanisms affect optimization dynamics under heterogeneous regional distributions. To address this gap, we propose a configurable privacy-preserving federated forecasting framework for sector-wise urban carbon emission prediction. The architecture integrates differential privacy at both client and aggregation levels, enabling controlled evaluation of local-only, global-only, and dual-layer perturbation strategies. Each Province–sector pair operates as an independent client, and privacy budgets are formally accounted for under (ɛ,δ)-Differential Privacy. Experimental results across multiple Chinese Provinces demonstrate that privacy enforcement does not inherently degrade forecasting performance. Notably, aggregation-level perturbation consistently achieves the highest predictive accuracy and lowest variance, even surpassing the non-private baseline in several cases. Statistical significance testing confirms the robustness of this improvement. Further analysis reveals that privacy budget allocation strategy has a stronger impact than total budget magnitude, as dual-layer perturbation accumulates stochastic variance and destabilizes convergence. These findings provide practical design guidance for privacy-aware federated carbon monitoring systems and demonstrate that strategically positioned differential privacy can preserve both confidentiality and predictive reliability in heterogeneous urban environments.}
}
@article{KINALIOGLU2026116929,
title = {EPRAG: An epistemic policy framework for action selection in multi-source enterprise retrieval-augmented generation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116929},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116929},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016552},
author = {Ismail Hakki Kinalioglu},
keywords = {Epistemic decision policy, Counterfactual answerability, Enterprise RAG, Abstention, Knowledge conflict},
abstract = {Background and Objective:
Enterprise retrieval-augmented generation (RAG) systems must select an appropriate action when retrieved sources differ in freshness, authority, access, or evidential compatibility.
Methods:
We propose EPRAG (Epistemic Policy RAG), an executable framework that separates evidence-state diagnosis from response selection through a six-state taxonomy and a deterministic five-action policy. Counterfactual answerability is implemented as a practical LLM/NLI-based approximation, while provenance is treated primarily as an auditability feature.
Evaluation:
EPRAG is evaluated on Spider2-derived (n=504) and BIRD-derived (n=720) benchmark adaptations, a manual adjudication study (n=400), a single-site enterprise helpdesk cohort (n=400), and a taxonomy-blind public audit (n=200). A structured GPT-5 judge is also evaluated on BIRD (n=240) and helpdesk (n=100) subsets using the same inputs and five-action space.
Results:
EPRAG achieves 91.7%–96.8% action accuracy on the public benchmarks and 76.0% against operationally derived helpdesk labels. In the taxonomy-blind audit, annotator agreement was 93.5% (κ=0.916), and EPRAG achieved 85.0% agreement with the trusted action (macro-F1 =0.849). EPRAG also outperformed the structured GPT-5 judge on BIRD (97.9% vs. 40.8%) and helpdesk (80.0% vs. 23.0%).
Conclusions:
EPRAG provides a bounded, auditable decision-policy baseline for multi-source enterprise RAG. The helpdesk evidence is single-site and label-dependent, the GPT-5 comparison is not an upper bound, and broader validation remains necessary.}
}
@article{SUN2026116840,
title = {MMUAD: A unified framework for multi-modal and multi-class Unsupervised Anomaly Detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116840},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116840},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015662},
author = {Hao Sun and Lei Fan and Puchao Zhou and Pinjia Chen and Shaohui Liu},
keywords = {Anomaly detection, Multi modality, Multi-class},
abstract = {Industrial anomaly detection is crucial for maintaining product quality in manufacturing. Recent unsupervised techniques, which rely solely on normal samples during training, offer a promising alternative. Existing AD methods predominantly operate on RGB images, cannot detect invisible anomalies, forcing the research on multi-modal anomaly detection. However, recent multi-modal methods struggle with modality-shared information usage and specific modal anomalies invisible problem. To address these limitations, we propose MMUAD, a unified framework for Multi-modal and Multi-class Unsupervised Anomaly Detection. MMUAD introduces a modality-specific enhancement mechanism that exploits spatial and frequency domain representations to enhance anomaly sensitivity. Additionally, we employ an attention-based fusion network to dynamically adjust the modality contributions. A contrastive learning mechanism further align the feature representation of each modality in the token space. Evaluations on the MulSen-AD and MVTec 3D-AD datasets demonstrate that MMUAD achieves state-of-the-art performance in both multi-modal and multi-class anomaly detection. This work advances unsupervised anomaly detection by unifying Multi-modal representation learning with multi-class generalization, offering a practical solution for real-world industrial applications.}
}
@article{ARZU2026116901,
title = {Vision-Language Models for medical imaging: A survey on anomaly detection and multimodal applications},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116901},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116901},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016278},
author = {Gul E Arzu and Muhammad Umar and Muhammad Fayaz and Usman Ali and L. Minh Dang and Hyeonjoon Moon},
keywords = {Vision-Language Models, Medical imaging, Visual questions answer, Radiology report generation, Medical dataset scarcity},
abstract = {Vision-Language Models (VLMs) have revolutionized medical imaging by integrating visual and textual modalities, enabling advanced tasks such as anomaly detection, diagnostic classification, and multimodal analysis. These models facilitate critical applications, including radiology report generation (RG), visual question answering (VQA), and image-text retrieval, thereby enhancing diagnostic precision and clinical workflows. Leveraging architectures like CLIP, BiomedCLIP, and Med-GPT, VLMs achieve fine-grained alignment between radiology images and textual descriptions, significantly improving interpretability and decision support in medical diagnostics. Despite their potential, adapting VLMs for healthcare presents challenges, including the scarcity of large-scale annotated datasets, the complexity of medical terminology, and the stringent requirements for patient privacy and data security. This survey comprehensively reviews state-of-the-art VLMs in radiology, analyzing their architectures, training methodologies, datasets, and real-world applications. Models such as BioViL and XrayGPT exemplify how multimodal learning enhances pathology detection and automated report generation. Additionally, emerging techniques like contrastive learning, self-supervised approaches, and federated learning (FL) offer promising solutions to address data limitations, privacy concerns, and model robustness. However, several barriers remain, including issues of model generalizability, dataset biases, and the high computational demands of training and deployment in clinical environments. This study highlights the transformative impact of VLMs in medical diagnostics and identifies key research gaps that must be addressed to ensure their practical implementation. This work outlines a roadmap for future advancements and underscores the need for scalable, privacy-preserving, and clinically effective AI-driven solutions to enhance radiological analysis and healthcare decision-making.}
}
@article{WANG2026116953,
title = {Beyond modality importance: Reliability-guided tree memory for inductive multimodal knowledge graph completion},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116953},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116953},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016795},
author = {Jingchao Wang and Jianqi Gao and Weimin Li and Xinyi Zhang and Yue Wang},
keywords = {Knowledge graph, Multimodal knowledge graph, Knowledge graph completion, Multimodal fusion, Retrieval-based reasoning},
abstract = {Inductive multimodal knowledge graph completion (MKGC) aims to predict missing facts involving unseen entities by jointly utilizing structural, textual, and visual information. In recent years, retrieval enhancement methods have improved reasoning capabilities for unseen entities through semantic neighborhood retrieval, but still face two key challenges. First, these methods typically rely on attention or gating mechanisms to measure the importance of different modalities, but modality weights cannot determine whether a modality can reliably distinguish the correct entity from similar candidates under the current relation, potentially leading to high-weight but low-discriminative modality cues misleading the final prediction. Second, existing methods often retrieve semantic neighborhood entities from a flat candidate space memory, which easily introduces semantically similar but irrelevant interfering entities, further weakening the model’s ability to distinguish similar candidate entities. To address these challenges, we propose ReTree, a reliability-guided tree memory framework for inductive MKGC. ReTree first learns unified multimodal representations of target triples and evaluates the reliability of textual, visual, and fused representations from relation-level calibration and local candidate separation. It then builds an adaptive prototype-based tree memory that organizes training samples into relation roots, prototype nodes, and entity nodes. Reliability scores further guide prototype refinement and entity assignment, producing more discriminative candidate organization within each relation. During inference, ReTree combines hierarchical retrieval over the tree memory with query-local insertion for unseen entities, enabling more effective identification of similar candidates. Experiments on multiple inductive MKGC benchmarks show that ReTree outperforms existing methods in both prediction performance and generalization ability.}
}
@article{LIU2026116812,
title = {A unified framework for occurrence-support Repetitive Sequential Pattern Mining in static and sliding-window streams},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116812},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116812},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015388},
author = {Pan Liu and Shulei Tang and Xingyu Wang and Yiheng Shen and Geng Yu and Wei Zhang},
keywords = {Repetitive sequential pattern mining, Occurrence support, Sliding-window stream mining, Streaming pattern maintenance, Vertical representation, Pruning and indexing},
abstract = {Repetitive Sequential Pattern Mining (RSPM) discovers recurrent behaviours by counting valid non-overlapping occurrences, but existing methods remain constrained by costly position storage, weak pruning, and inefficient sliding-window maintenance. We propose a unified occurrence-support framework with consistent matching semantics for both static and streaming settings. For static mining, Optimized Repetitive Non-overlapping Miner (ORN-Miner) combines sparse vertical storage, linear-time two-pointer matching, and Remaining Potential Bound (RPB) pruning to reduce candidate and memory overhead. For streaming mining, Streaming Repetitive Non-overlapping Miner (SRN-Miner) reuses the same matching kernel with bitmap occurrence storage, index-assisted expiration, and periodic snapshot re-mining. On 12 real-world datasets, ORN-Miner outperforms six baselines with geometric-mean speedups of 5.04×–149.16× and up to 97.9% lower memory usage. In the isolated expiration benchmark, SRN-Miner accelerates expiration by 1.73×–2.49× under higher active-pattern loads. In the end-to-end RQ4 streaming setting, however, WithIndex gains are not statistically significant because periodic snapshot re-mining dominates total cost. Snapshot exactness is claimed only for calibrated non-empty settings with window-aligned comparison; the BIKE low-minsup stress case remains outside this guarantee and yields 0/4 exact matches with mean Jaccard 0.940. A separate bounded-window stress replay completes 100,000 non-empty events in all three runs, with mean replay throughput of 14,905.59±111.61 ev/s and mean snapshot latency of 189.48 ms.}
}
@article{ABED2026116913,
title = {Self-righting modular colony search: a failure-aware metaheuristic with state-dependent structural recovery},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116913},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116913},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016394},
author = {Wisam Najm Al-Din Abed and Wafaa Saeed Majeed},
keywords = {Bryozoan-inspired optimization, Failure-aware search, Metaheuristic optimization, Modular colony intelligence, Self-righting search},
abstract = {Population-based metaheuristics may stagnate when diversity loss, directional collapse, and ineffective search states are handled only through replacement or restart. This study introduces Self-Righting Modular Colony Search (SRMCS), a bio-inspired swarm-intelligence metaheuristic motivated by the modular organization and self-righting behavior of the free-living bryozoan Selenaria maculata. SRMCS integrates distributed exploration, fitness-guided coordination, colony-state diagnosis, adaptive role redistribution, and information-preserving recovery within a closed-loop search process. Its contribution lies in the state-dependent interaction of these mechanisms rather than in claiming originality for differential perturbation, elite guidance, grouping, or coordinate transformation individually. SRMCS was evaluated on 71 benchmark cases covering classical problems, CEC 2019, CEC 2022, and 500- and 1000-dimensional tests against twelve algorithms, including CMA-ES, L-SHADE, and jSO. Across 852 case-level pairwise comparisons, SRMCS achieved 745 wins, 80 ties, and 27 losses, corresponding to an 87.44% strict-win rate and 96.83% non-loss rate, while attaining the lowest Friedman mean rank in all five benchmark settings. Ablation and sensitivity analyses supported the contribution and robustness of the interacting mechanisms. On five constrained engineering problems, SRMCS ranked first in every case with a mean rank of 1.0000 and 99.2% average feasibility.}
}
@article{RAMOS2026116982,
title = {Surveys and artificial intelligence: a new challenge for non-market economic valuation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116982},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116982},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017089},
author = {Ignacio Ramos and Mario Soliño},
keywords = {Discrete choice experiment, Large language model, Machina economicus, Marine conservation, Natura 2000 network, Silicon sample},
abstract = {The widespread adoption of Artificial Intelligence (AI) presents substantial challenges within the field of economics, prompting a discussion on the concepts of homo economicus and machina economicus. The use of AI-generated Silicon samples adds a new dimension to non-market economic valuation. Machina economicus may be capable of articulating preferences and elucidating decision-making processes, evoking human behavior. Discrete choice surveys are nowadays mainly conducted using internet panels, and several concerns have been raised regarding the quality of responses and representativeness of these samples. The main aim of this paper is to analyze preferences from a Silicon sample, and compare the results with a study based on responses of people from an internet sample. The results show that estimates of willingness to pay in the Silicon sample range between 5.34 and 15.70 times those of the internet sample. Silicon samples can be helpful in the initial stages of designing a discrete choice experiment, but they do not replace real people.}
}
@article{CUI2026116921,
title = {Multi-view graph convolutional network with fully leveraging consistency via granular-ball-based topology construction, feature enhancement and interactive fusion},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116921},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116921},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016473},
author = {Chengjie Cui and Taihua Xu and Shuyin Xia and Qinghua Zhang and Yun Cui and Shiping Wang},
keywords = {Multi-view learning, Granular ball computing, Graph convolutional network, Semi-supervised classification},
abstract = {The effective utilization of consistency is crucial for multi-view learning. Graph convolutional networks (GCNs) leverage node connections to propagate information across the graph, facilitating the exploitation of consistency in multi-view data. However, most existing GCN-based multi-view methods suffer from several limitations. First, current approaches predominantly rely on k-Nearest Neighbors (kNN) for topology construction, where the artificial selection of the k value significantly constrains the effective exploitation of inter-node consistency. Second, the inter-feature consistency within individual views is often overlooked, which adversely affects the quality of the final embedding representations. Moreover, these methods fail to fully utilize inter-view consistency as the fusion of embedded representations from multiple views is often implemented after the intra-view graph convolutional operation. Collectively, these issues limit the model’s capacity to fully capture inter-node, inter-feature and inter-view consistency. To address these issues, this paper proposes the multi-view graph convolutional network with fully leveraging consistency via granular-ball-based topology construction, feature enhancement and interactive fusion (MGCN-FLC). MGCN-FLC can fully utilize three types of consistency via the following three modules to enhance learning ability: (1) The topology construction module based on the granular ball algorithm, which clusters nodes into granular balls with high internal similarity to capture inter-node consistency; (2) The feature enhancement module that improves feature representations by capturing inter-feature consistency; (3) The interactive fusion module that enables each view to deeply interact with all other views, thereby obtaining more comprehensive inter-view consistency. Experimental results on nine datasets show that the proposed MGCN-FLC outperforms state-of-the-art semi-supervised node classification methods.}
}
@article{BAO2026116764,
title = {Exploring high-order correlations with motif-based hypergraph neural networks for epidemic forecasting},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116764},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116764},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014905},
author = {Qing Bao and Jinting Ye and Pengfei Jiao and Zhidong Zhao and Fuqiang Lei},
keywords = {Epidemic forecasting, Hypergraph neural networks, Motifs, High-order correlations},
abstract = {Accurate epidemic forecasting is critical for timely public health responses and optimal control measures. Deep learning methods which utilize recurrent neural networks (RNNs) capable of sequence modeling are explored recently. Later on, Graph Neural Networks (GNNs) are adopted to further capture both local and global dependencies of regions by representing regions and their pairwise relations as a graph. However, in real-world scenarios the complex transmission patterns are often high-order. For instance, there exists infection dependencies of surrounding areas as epidemics propagates in all directions. Also, the infection counts of two regions with more common neighboring regions are more similar. To address these limitations, we propose a motif-based Hypergraph Neural Networks framework integrating hypergraphs and network motifs to model high-order dependencies. On the one hand, network motifs are utilized to eliminate insignificant relations to identify critical message-passing pathways. On the other hand, hyperedges are designed to capture the underlying high-order dependencies of groups of similar region nodes exploring both local geographical adjacency and global correlations of non-adjacent regions. Experimental results demonstrate that our proposed model improves forecasting accuracy on several public datasets compared with state-of-the-art methods, showing the effectiveness of the model.}
}
@article{HE2026116704,
title = {SonarDeNet: Incorporating prior-driven knowledge and acoustic imaging mechanism for side-scan sonar image object detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116704},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116704},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014309},
author = {Ju He and Hu Xu and Shaohong Li and Yang Yu},
keywords = {Autonomous underwater vehicle (AUV), Side-scan sonar (SSS), Sonar image detection, Image simulation, Physical prior knowledge},
abstract = {Side scan sonar (SSS) is crucial for seafloor exploration owing to its unique ability to provide both high long-range visibility and extensive area coverage. However, inherent challenges such as the scarcity of sonar images, low signal-to-noise ratios, and degraded image quality persist, limiting the practical applicability of sonar image detection. Existing sonar image detection networks lack sufficient utilization of underwater imaging mechanisms. To address these challenges, we propose SonarDeNet, a novel side scan sonar image detection framework that incorporates prior-driven acoustic knowledge into sonar data simulation and deep-learning based detection network. Specifically, we enhance the traditional ray tracing SSS image simulation method with acoustic imaging mechanisms to provide high-quality simulation SSS images. Furthermore, we introduce the acoustic shadow as key prior-driven prompt for our SSS image detector, and a soft knowledge association mechanism is designed to eliminate the cognitive bias in prompt features. The experiments demonstrate that SonarDeNet achieves state-of-the-art detection performance compared to other detection baseline methods, with improvements of 3.6% in AP50 and 3% in mAP, highlighting its significant potential in incorporating prior knowledge for SSS object detection.}
}
@article{LIANG2026116845,
title = {Domain adaptation for autonomous systems: Linking transfer bottlenecks to knowledge mechanisms},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116845},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116845},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015716},
author = {Yue Liang and Jiatong Du and Ziyi Yang and Yanjun Huang and Quanbo Ge and Hong Chen},
keywords = {Domain adaptation, Autonomous systems, Domain shift, Knowledge transfer, Negative transfer},
abstract = {Domain adaptation (DA) plays a central role in improving the robustness of autonomous systems, which must generalize across domain shifts in appearance, scenes, sensors, semantics, deployment conditions, embodiment, and simulator-to-real dynamics. However, existing studies often address these gaps in isolated settings, making it difficult to select suitable adaptation strategies for specific autonomous-system scenarios. This survey organizes DA for autonomous systems through a bottleneck-knowledge taxonomy. Specifically, we decompose adaptation challenges into distribution discrepancy, semantic shift, and data scarcity, and summarize transferable knowledge in statistical, representational, conceptual, and meta forms to structure state-of-the-art DA methods. Guided by this taxonomy, we synthesize their applications in autonomous systems, covering perception, prediction and decision-making, planning and control, and end-to-end autonomy, with particular attention to safety-critical deployment. We further summarize benchmarks and open-source resources, with a curated project repository available at https://github.com/ly3580/awesome-domain-adaptation, and discuss future directions toward safe, efficient, and deployment-ready DA for autonomous systems.}
}
@article{LIU2026116958,
title = {A Performance-Guided Framework for retinal vessel segmentation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116958},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116958},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016849},
author = {Ziyu Liu and Xiangjian He and Xin Chen and Fucang Jia and Maggie M. He and Yi Wang and Shoujun Zhou},
keywords = {Retinal vessel segmentation, Performance-guided learning, Data reconstruction},
abstract = {Accurate retinal vessel segmentation requires reliable delineation of fine and low-contrast vascular structures. However, conventional supervised training often treats all image regions equally despite substantial spatial variations in segmentation performance. To address this limitation, we propose a Performance-Guided Framework (PGF) for retinal vessel segmentation. PGF first trains a baseline model and estimates patch-level segmentation performance using Dice scores. Based on the resulting performance ranking, a performance-guided data reconstruction strategy selectively masks high-performing regions, thereby focusing training on more challenging areas. Then, the optimization stage employs a dual-objective learning scheme, combining direct segmentation supervision on retained regions with selective knowledge distillation on masked regions to preserve prediction consistency. Extensive experiments on four public retinal vessel datasets (DRIVE, STARE, CHASE_DB1, and ROSSA) demonstrate its effectiveness. Using a standard U-Net backbone, PGF achieves Dice scores of 79.57%, 77.55%, 76.44%, and 91.01%, respectively, outperforming competing methods across all datasets. Moreover, PGF consistently improves multiple backbone networks and enables a standard U-Net to achieve performance comparable to, or better than, substantially more complex architectures without introducing additional inference overhead. These results demonstrate that PGF is an effective, generalizable, and architecture-agnostic training framework for retinal vessel segmentation.}
}
@article{XIA2026116865,
title = {When noisy labels meet class imbalance on graphs: A graph augmentation method with LLM and pseudo label},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116865},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116865},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015911},
author = {Riting Xia and Rucong Wang and Yulin Liu and Huibo Liu and Yan Zhang and Anchen Li},
keywords = {Class-imbalanced graphs, Noisy labels, Large language model, Pseudo-labeling technique},
abstract = {Class-imbalanced graph node classification is a practical yet underexplored research problem. Although recent studies have attempted to address this issue, they typically assume clean and reliable labels when processing class-imbalanced graphs. This assumption often violates the nature of real-world graphs, where labels frequently contain noise. Given this gap, this paper systematically investigates robust node classification for class-imbalanced graphs with noisy labels. We propose GraphALP, a novel Graph Augmentation framework based on Large language model (LLM) and Pseudo-labeling techniques. Specifically, we design an LLM-based oversampling method to generate synthetic minority nodes, producing label-accurate minority nodes to alleviate class imbalance. Based on the class-balanced graphs, we develop a dynamically weighted pseudo-labeling method to obtain high-confidence pseudo labels to reduce label noise ratio. Additionally, we implement a secondary LLM-guided oversampling mechanism to mitigate potential class distribution skew caused by pseudo labels. Experimental results show that GraphALP achieves superior performance over state-of-the-art methods on class-imbalanced graphs with noisy labels. The source code is available at: https://github.com/wangrucong123/GraphALP.git.}
}
@article{LI2026116905,
title = {Metro passenger flow prediction based on multi-view hypergraph spatio-temporal attention convolution},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116905},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116905},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601631X},
author = {Xiaoyan Li and Yang Su and Chonghui Qian and Xiaojing Peng and Hengjun Huang},
keywords = {Spatio-temporal, Metro passenger flow forecasting, Hypergraph attention, Gated recurrent unit, Multi-view hypergraph},
abstract = {Metro systems play an indispensable role in mitigating urban traffic congestion, fostering sustainable urbanization, and supporting the efficient functioning of modern cities. Accurate forecasting passenger flow remains a formidable task due to the intricate spatio-temporal dependencies within metro systems. Traditional graph-based methods often rely on simplistic pairwise relationship assumptions, which fail to capture complex and higher-order interactions. Moreover, previous studies lack effective approaches to integrate higher-order relationships from multiple perspectives into a unified hypergraph framework, hindering the extraction of spatio-temporal features. To address these challenges, this paper proposes the Multi-view Hypergraph Spatio-temporal Attention (MHSTA) convolution framework. This framework employs multi-view hypergraphs to capture high-order relationships among stations, including shared transfers and regional demand patterns. Spatio-temporal attention network extracts interactions and global dependencies within the hypergraphs, while a learnable weighted method fuses spatio-temporal features. Gated recurrent units refine temporal features for final prediction. Experiments on the Hangzhou metro dataset demonstrate that MHSTA outperforms the best-performing model among ten state-of-the-art baselines. Specifically, for 15-minute forecasting, MHSTA achieves improvements of 4.0% in ACC, 4.1% in VAR, and a reduction of 0.014 in RMSE. Its superiority becomes more pronounced at the 45-minute horizon, with ACC and VAR gains of 7.4% and 9.9%, respectively, and a 0.026 reduction in RMSE. Additional experiments on the Shanghai metro dataset further confirm the robustness and generalization capability of MHSTA. These results highlight the effectiveness of MHSTA in capturing high-order spatio-temporal dependencies for accurate metro passenger flow forecasting.}
}
@article{LIU2026116926,
title = {PG-LLM-KT: An adaptable prerequisite-guided framework for knowledge tracing with frozen lightweight LLMs},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116926},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116926},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016527},
author = {Guiyao Liu and Lianhong Wang and Junyi Li and Xiaoyao Li and Xiaogang Zhang and Sijun Zhang},
keywords = {Knowledge tracing, Prerequisite knowledge graph, Large Language Models, Cross-dataset generalization, Educational data mining},
abstract = {Knowledge Tracing (KT) seeks to model students’ evolving knowledge state from historical learning interactions. However, deep learning-based methods show limited generalizability, LLM-based methods exhibit high computational cost, and graph-enhanced methods depend on externally predefined graphs. To address these issues, we propose PG-LLM-KT, an adaptable graph-guided KT framework supporting frozen lightweight LLMs. Firstly, PG-LLM-KT constructs a data-driven prerequisite knowledge graph from student interaction sequences to capture temporal and conditional concept dependencies. Then, it incorporates the graph into a structured instruction template to guide LLM reasoning in accordance with dataset-specific knowledge structures. To address overconfidence common in lightweight LLMs, an adaptive confidence head is introduced to adjust prediction confidence. Extensive experiments across diverse KT datasets, including a self-built dataset HNU_SYS2023, show that PG-LLM-KT achieves competitive performance, while maintaining high computational efficiency and strong cross-dataset generalization, offering an interpretable and scalable KT solution for real-world educational applications.}
}
@article{CHE2026116934,
title = {Semantic segmentation of nighttime road scene based on unsupervised domain adaptation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116934},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116934},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016606},
author = {Wenqing Che and Xiang Cai and Jiandong Qi},
keywords = {Unsupervised domain adaptation, Semantic segmentation, Road scene, Regularization techniques, Fourier transform},
abstract = {Accurate semantic segmentation of nocturnal road scenes plays a pivotal role in enabling reliable path planning and decision-making for autonomous driving systems. However, this task faces two fundamental challenges: 1) degraded image quality caused by low-light conditions, and 2) limited availability of annotated training data for night environments. To address these issues, this study proposes FMDA (Fourier-based and Mean-Teacher-enhanced Domain Adaptation), a novel three-branch unsupervised domain adaptation framework that integrates Fourier domain adaptation with a Mean Teacher-enhanced self-training paradigm. Our methodology comprises three key innovations: 1) Fourier-based style transfer: Daytime source domain images are transformed into nighttime-style counterparts through frequency domain manipulation, effectively aligning the low-level feature space of the domains while preserving critical semantic features. 2)Intermediate domain supervision: A set of intermediate images is introduced as weak supervision, combined with an enhanced three-branch architecture in which teacher-student network pairs mutually guide adaptation through pseudo-label refinement. 3)Structural consistency regularization: A pixel-wise relational consistency constraint is designed to align predictions between student and teacher networks. Extensive experiments on two challenging adaptation tasks, Cityscapes→ACDC (night) and Cityscapes→Dark Zurich, demonstrate the framework's superiority over existing approaches. FMDA achieves a mIoU of 46.2% on ACDC (night) and 54.8% on Dark Zurich. Additionally, we extend the FMDA framework to semantic segmentation of road scenes in foggy, rainy, and snowy conditions, the results shows that FMDA has good generalization ability in such road scenes that with image blurring and visibility degradation.}
}
@article{HAN2026116938,
title = {SpaMOCA: Spatial multi-omics integration with local cross-attention and contrastive learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116938},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116938},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016643},
author = {Yifan Han and Junliang Shang and Aitian Fan and Wenjing Su and Defu Qiu and Hanxiang Wang},
keywords = {Spatial multi-omics, Local cross-attention, Data integration, Contrastive learning, Dual-channel spatial regularization},
abstract = {The development of spatial multi-omics technologies has enabled more comprehensive characterization of tissue microenvironments, yet effective data integration remains challenging. Technical biases and expression heterogeneity across omics modalities can make global fusion strategies sensitive to noise, while many existing approaches fail to explicitly model spatial proximity, potentially leading to incomplete characterization of cellular functional states. To address these issues, we propose SpaMOCA, a deep learning method for spatial multi-omics integration. First, SpaMOCA incorporates a Local Cross-Attention (LCA) for local cross omics interaction modeling, together with a hard negative sample mining strategy for contrastive learning and constructs a k nearest neighbor graph based on cellular spatial coordinates to constrain cross omics interactions to local neighborhoods. Second, hard negative sample mining is applied in contrastive learning to select highly similar cells as negative samples, improving embedding discriminability and facilitating the capture of subtle phenotypic differences. Finally, SpaMOCA incorporates a dual-channel spatial regularization module to enforce neighborhood consistency and tissue structural continuity, supporting faithful preservation of spatial organization. Evaluations on simulated and real spatial transcriptomics datasets show that SpaMOCA robustly supports spatial domain recognition and reliable integration of spatial multi-omics data, enabling more accurate fusion and refined characterization of spatial tissue architecture, including clearer tissue boundaries and rare cell subpopulations.}
}
@article{ABDISA2026116849,
title = {Self-Balancing Neural Network: A novel method for estimating the average treatment effect},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116849},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116849},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015753},
author = {Atomsa Gemechu Abdisa and Yuqi Qiu and Yingchun Zhou},
keywords = {Average treatment effect, Self-balancing neural network, Neural network, Pseudo propensity score},
abstract = {In observational studies, confounding variables affect both treatment assignment and outcomes. Instrumental variables may also influence treatment assignment, further complicating the causal structure. These dependencies distinguish observational settings from completely randomized controlled trials, where treatment assignment is independent of covariates and potential outcomes. Consequently, using the difference in means between treatment groups without covariate adjustment can yield a biased estimate of the average treatment effect (ATE). One standard approach is to incorporate an estimated propensity score, but propensity score models can be misspecified. To address this limitation, we propose the Self-Balancing Neural Network (Sbnet), which learns an internal pseudo propensity score through a balancing net. Sbnet estimates the ATE by embedding this balancing net within the feedforward neural network. This provides a one-stage estimator that does not require separate propensity-score estimation or subsequent plug-in adjustment. We also develop a multi-pseudo-propensity-score framework in which diversified balancing nets are used to improve estimation accuracy. The proposed methods are compared with benchmark methods across four simulation settings and real-world data sets. Empirical results show that Sbnet achieves competitive performance and lower ATE bias than the benchmark methods in the evaluated settings.}
}
@article{ZHANG2026116910,
title = {RCMNet: A relation-centric memory backbone for efficient remote sensing image understanding},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116910},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116910},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016369},
author = {Jun Zhang and Tianyu Li and Yang Yang and Guoqing Wang},
keywords = {Remote sensing image understanding, Relation-centric memory, Lightweight backbone},
abstract = {Remote sensing image understanding faces a common demand in high-resolution bird’s-eye-view scenes: efficiently modeling sparse and long-range structural relations. Existing dense large-kernel and strip-based methods usually address this challenge by enlarging contextual coverage. However, they not only struggle to explicitly distinguish supportive structural evidence from distracting context, but also introduce high inference overhead due to dense aggregation, which limits their practical deployment on edge devices. To address this limitation, we propose Relational Contrastive Memory Network (RCMNet), a relation-centric backbone for general-purpose remote sensing image understanding. RCMNet constructs sparse multi-hop directional relations to efficiently capture representative long-range structures, decomposes relation responses into signed components, and summarizes their discrepancies through a compact input-conditioned relational contrast memory. This memory is recomputed independently from each input during every forward pass and does not maintain a persistent state across samples or optimization iterations. The resulting memory provides direction-sensitive modulation cues for relation aggregation and feature fusion and enables the backbone to enhance useful structural relations and suppress distracting context. Experiments on six public benchmarks covering four task families, including oriented object detection, cross-modal detection, change detection, and 3D reconstruction, show that RCMNet achieves consistent and progressive improvements over strong baselines, demonstrating the effectiveness and transferability of relational contrast memory for remote sensing backbone design. Benefiting from sparse relation modeling, RCMNet maintains low computational overhead and achieves a favorable accuracy–speed trade-off on real smartphone deployment.}
}
@article{CHACONFALCON2026116962,
title = {Privacy-preserving federated learning AdaBoost via knowledge distillation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116962},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116962},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016886},
author = {Mario Chacón-Falcón and Jose M. Moyano},
keywords = {Federated learning, Ensemble learning, Knowledge distillation, AdaBoost},
abstract = {There are many scenarios where different entities would like to share their knowledge through building a joint machine learning model for a common goal. Federated learning arises to solve such problems when the data privacy of each entity is imposed as an essential requirement. Although much work has been done in applying deep learning networks to federated learning scenarios, scarce effort has been made to adapt other classic and lighter machine learning algorithms to the aforementioned problem. This paper presents an adaptation of the AdaBoost ensemble method to federated scenarios, using ensemble knowledge distillation. To do so, in each iteration, the clients build a model using their local data and send the predictions over a small unlabeled public dataset to the server, thus keeping their sensitive information private. Then, the server aggregates these predictions and creates a model using the public data, sending it back to all the clients. The paper also presents and analyzes several versions of such an algorithm. The performance of the proposed method has been tested using 14 datasets, three evaluation metrics, and four data distribution scenarios. It demonstrates significantly better performance than other state-of-the-art methods, better privacy protection, and robustness against adversarial attacks on the network.}
}
@article{HU2026116821,
title = {Joint surrogate-assisted federated evolutionary feature selection algorithm},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116821},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116821},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015479},
author = {Ying Hu and Yong Zhang and Xin-yue Wang and Ming Zheng and Xiao-yao Zheng and Xian-fang Song and Yong-long Luo and Dun-wei Gong},
keywords = {Feature selection, Evolutionary algorithm, Surrogate-assisted evolutionary algorithm, Privacy protection},
abstract = {Evolutionary algorithms face the challenges of high computational cost and the “curse of dimensionality” in high-dimensional feature selection (FS) problems. These challenges are exacerbated when data representing the same learning task are distributed horizontally among multiple institutions that cannot share sensitive data. To address the high-dimensional FS problem with multiparticipation under privacy protection, a joint surrogate-assisted federated evolutionary feature selection algorithm (SaFEFS) is presented in this study. First, an XGBoost model-based joint filter FS approach is proposed to reduce the initial feature space while ensuring privacy. Subsequently, a surrogate-assisted federated evolutionary FS algorithm is designed, and several new strategies, including multiparticipant population initialization guided by feature importance, joint construction and management for surrogate models, and a joint individual updating strategy, are developed to enhance the performance of SaFEFS. Ultimately, SaFEFS is implemented on 12 test datasets and compared with several classical evolutionary FS algorithms. The experimental results demonstrate that SaFEFS can obtain feature subsets with good classification performance while preserving data privacy.}
}
@article{NAZARI2026116946,
title = {Toward robust heterogeneous graphs representation learning via multi-view attention and contrastive learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116946},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116946},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016722},
author = {Amin Nazari and Muharram Mansoorizadeh and Hassan Khotanlou},
keywords = {Graph attention, Multi-view learning, Graph representation learning, Contrastive learning},
abstract = {Heterogeneous Information Networks (HINs) have become an effective paradigm for modeling complex real-world systems consisting of multiple entity types and diverse semantic relationships. Although Graph Neural Networks (GNNs) have achieved remarkable success in graph representation learning, existing methods often exhibit limited semantic modeling capability and reduced robustness when applied to heterogeneous, noisy, or sparsely connected graphs. To address these challenges, we propose Robust Heterogeneous Graph Representation Learning via Multi-View Attention and Contrastive Learning (RoGAT), a unified multi-view representation learning framework that jointly integrates relation-aware and semantic-aware graph attention networks. Specifically, RoGAT learns complementary representations from relation-level and meta-path-level views by explicitly modeling the semantics of individual relations and meta-paths, enabling a more comprehensive understanding of heterogeneous interactions through the integration of both fine-grained relational semantics and high-order structural semantics. A cross-view contrastive learning objective is employed to align the two complementary representations, and an adaptive fusion module dynamically integrates multi-view embeddings into a unified representation. This unified optimization strategy enhances representation consistency, improves robustness against structural noise and graph sparsity, and enables more expressive heterogeneous graph embeddings. Extensive experiments on three real-world benchmark datasets demonstrate that RoGAT consistently outperforms representative baseline methods by 6–12% and achieves up to 1-3% improvement over recent state-of-the-art approaches in node classification and clustering tasks. Additional robustness evaluations under different noise levels further confirm that the proposed framework maintains stable and discriminative representations even in noisy heterogeneous graph environments.}
}
@article{VLACHOS2026116918,
title = {R-SVDD: A decentralized radius-aware federated prototype object detection framework},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116918},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116918},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016448},
author = {E. Vlachos and V. Mygdalis and I. Pitas},
keywords = {Federated learning, Object detection, Prototype aggregation, Deep neural networks},
abstract = {Federated Learning (FL) methods typically require Deep Neural Network (DNN) weight transfer from FL clients to an FL aggregator (master) for centralized DNN aggregation. However, in real-world settings such as smart-city sensing and emergency-response monitoring, weight transfer may be infeasible due to privacy regulations, operational policies, or unreliable connectivity. In this paper, we present R-SVDD, a fully decentralized FL framework that enables collaborative DNN training for object detection without neural parameter sharing. R-SVDD replaces weight exchange with a lightweight class-wise prototype learning mechanism based on Support Vector Data Description (SVDD), trained locally on object-level detector features at each FL client. Collaboration is achieved by exchanging only SVDD class prototypes in a peer-to-peer topology, allowing event-specific appearance changes observed by one client to propagate as prototype-level adjustments that improve consistency across the federation. To reduce the effect of outlier class summaries under extreme non-IID conditions, R-SVDD introduces a radius-aware filtering rule that uses the SVDD hypersphere radius as a class-wise compactness signal and suppresses prototypes with abnormal class-wise dispersion during aggregation. No DNN weights, gradients, full DNN model updates, or raw training data are exchanged between FL nodes. R-SVDD is evaluated against FedAvg, FedProto, PearFL, and TurboSVM-FL under random multi-client, cross-domain heterogeneous, and Dirichlet non-IID object detection settings. Compared with full-model FL methods such as FedAvg, R-SVDD communicates only one compact center-radius prototype per object class instead of transmitting the complete detector parameter vector. This greatly reduces the exchanged payload while preserving competitive object detection performance against prototype-based FL baselines.}
}
@article{CAO2026116809,
title = {A Dual-Domain Synergistic Network with Frequency-Guided Neuromorphic Adaptation for low-light fundus image enhancement},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116809},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116809},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015352},
author = {Lvchen Cao and Yafei Wang and Shunzhou Wang and Wei Li and Wenjiao Li and Qingxia Xu and Huiqi Li and Pengcheng Lei},
keywords = {Fundus image enhancement, Spiking Neural Network, Dilated convolution, Synthetic fundus image},
abstract = {Low-light fundus image enhancement aims to improve the visibility of retinal anatomical structures and pathological regions under clinically degraded imaging conditions. However, existing methods often struggle with spatially non-uniform illumination and show limited robustness when transferred from synthetic training data to real clinical images. To address this problem, we propose a lightweight Dual-Domain Synergistic Network (DDSN), which formulates low-light fundus image enhancement as a region-adaptive restoration task rather than a globally uniform correction process. The core of DDSN is the Frequency-Guided Neuromorphic Adaptation Module (FGNAM), whose key idea is to transform frequency-domain priors into restoration control signals for unevenly illuminated retinal regions. Specifically, amplitude-related priors characterize local illumination variation and guide illumination-adaptive spiking responses, while phase-related priors preserve structurally stable retinal information and support structure-consistent refinement. Through this mechanism, DDSN restores severely underexposed regions without over-correcting relatively reliable areas, thereby improving illumination recovery while maintaining fine anatomical structures. In addition, a hybrid degradation strategy is introduced to narrow the gap between synthetic and real-world images, and the auxiliary lightweight designs further enhance robustness and efficiency toward the same objective. Experimental results on multiple public datasets show that DDSN achieves competitive enhancement performance while preserving structural fidelity and maintaining high energy efficiency with only 2.72M parameters. These results suggest its potential for deployment in resource-constrained clinical environments. The code is available at: https://github.com/Turing2022/DDSN.}
}
@article{LIU2026116922,
title = {TempoCL: Temporal semi-supervised contrastive learning under open-set and closed-set noisy labels},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116922},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116922},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016485},
author = {Jiarong Liu and Kaixiang Yang and Shuanghua Yang and Yujue Zhou},
keywords = {Time series, Open-set and closed-set noisy labels, Contrastive learning, Semi-supervised},
abstract = {Deep neural networks degrade significantly when trained on label-noisy data. In practice, label noise presents itself as either closed-set, where samples are misassigned to an existing class, or open-set, where samples do not belong to any existing class. Despite significant progress in existing research, two critical problems remain unaddressed: (1) Existing methods for addressing open-set and closed-set label noise typically rely on predefined thresholds. However, as target data distributions diverge from the training set, these static thresholds lose effectiveness, thereby hindering the ability of the model to accurately differentiate between open-set and closed-set noise. (2) Existing multi-view contrastive learning for label noise typically uses data augmentation for diverse views. However, time series data exhibits distinct scale-dependent patterns: fine scales capture microscopic features, while coarse scales reveal macroscopic information. Data augmentation rarely captures these complementary details effectively, thus limiting performance. To address these challenges, we introduce TempoCL, a temporal semi-supervised contrastive learning network. The core process of TempoCL unfolds as follows: (1) Two-stage Adaptive Sample Selection (TASS) leverages training loss in the first stage to separate clean samples from noisy ones. Subsequently, the second stage discriminates between closed-set and open-set noise by exploiting the fact that open-set instances fall outside the predefined categories. TempoCL applies supervised and semi-supervised learning to the clean and close-set samples, respectively. (2) Subsequently, Multi-view Temporal Contrastive Learning (MvTCL) is applied to the clean samples. MvTCL ensures same-scale consistency among multi-view representations while enhancing different-scale complementarity, thereby bolstering robustness against label noise by effectively integrating microscopic and macroscopic information. Extensive experiments on diverse standard time series datasets confirm TempoCL significantly outperforms current state-of-the-art methods. The code is publicly available at: https://github.com/JingGu-hub/TempoCL.}
}
@article{LIANG2026116833,
title = {Towards balanced mask and edge co-learning for camouflaged object detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116833},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116833},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015595},
author = {Weiyun Liang and Chunyuan Chen and Fangwei Hao and Jing Xu and Bin Wang and Donglin Wang},
keywords = {Camouflaged object detection, Edge information, Mask and edge collaborative learning, Thick edge learning},
abstract = {Camouflaged object detection (COD) aims to segment objects exhibiting high intrinsic similarity to their surroundings. Edge-based COD methods combine the main mask segmentation (mask learning) and auxiliary edge detection (edge learning) tasks to generate precise segmentation maps with accurate edges. However, a learning gap still exists between these two tasks, which results in unbalanced mask and edge co-learning, as reflected in two aspects: (i) existing methods often produce suboptimal edge predictions, providing insufficient guidance for segmentation and potentially resulting in errors, and (ii) a significant disparity exists between the edge precision of the mask and edge predictions, which might arise from the insufficient and imbalanced interaction between mask and edge learning. To address these issues, we propose a triple-stream mask-and-edge bridging network (MEBNet) for COD, which leverages thick edge learning as a bridge between the thin edge and mask learning, enhancing edge perception while mitigating the difficulty of edge learning. To facilitate balanced interaction between multi-task features, a mutual affinity interaction module (MAIM) is proposed to enable effective feature exchange and maintain mask and edge learning balance within an affinity latent space. Additionally, a heterogeneous feature propagation module (HFPM) is designed to decode multi-level backbone features into the three heterogeneous feature streams. Extensive experiments demonstrate that the proposed method achieves competitive segmentation performance and superior edge precision of segmentation maps compared with 43 state-of-the-art methods on COD benchmark datasets. Codes will be released at https://github.com/crrcoo/MEBNet.}
}
@article{PORCHER2026116906,
title = {A taxonomy of interpretable neurosymbolic models for time series classification},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116906},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116906},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016321},
author = {Damien Porcher and Ali Ayadi and Maxime Devanne and Jonathan Weber and Cédric Wemmert},
keywords = {Neurosymbolic learning, Time series, Symbolic reasoning, Knowledge distillation, Temporal logic, Interpretability, Continual learning},
abstract = {Time series classification (TSC) with deep learning has advanced markedly over the last decade, yet the mechanisms by which models identify and exploit discriminative patterns remain only partially understood, limiting interpretability. This paper surveys neurosymbolic approaches that aim either (i) to derive knowledge, by extracting human-readable rules and explanations from data, or (ii) to use knowledge, by injecting logical, physical, or structural constraints into learning. We review methods spanning Signal Temporal Logic (STL) formula extraction and temporal decision trees, neurosymbolic constraint synthesis and circuits, loss-based regularization including physics-informed objectives, probabilistic logic for event reasoning (e.g., DeepProbLog), and concept-level continual learning and distillation. We position these methods along common axes, explicit vs. implicit knowledge, applicability to TSC, capacity for knowledge discovery, prior knowledge requirements, and reproducibility, and discuss typical failure modes, including data bias and reasoning shortcuts. We also relate recent frugality-oriented designs that leverage non-trainable filters without sacrificing accuracy. Our analysis indicates that neurosymbolic techniques can provide actionable explanations and stronger inductive bias, with especially strong results on binary tasks, but face challenges in scaling to multi-class settings, handling shape-dependent phenomena, and ensuring transparent selection of learned rules. The survey offers a taxonomy and practical guidance for integrating symbolic structure with deep learning in TSC, highlighting open problems and promising directions.}
}
@article{AH2026116878,
title = {CLEAR: A continual learning framework for zero-day and anomaly-based intrusion detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116878},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116878},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016047},
author = {Nasreen Fathima A.H. and Ansam Khraisat and Syed Ibrahim S.P. and Gang Li},
keywords = {Continual learning, Intrusion detection system, Zero-day attack, Concept drift detection, Anomaly detection, Hybrid detection},
abstract = {Modern network environments evolve rapidly, exposing intrusion detection systems (IDS) to continually emerging and previously unseen cyberattacks. Most existing IDS models cannot incorporate new attacks without full retraining, and they typically suffer from catastrophic forgetting, limited generalisation, and poor detection of zero-day or rare threats. We propose CLEAR (Continual Learning with Embedded Attack Replay), a lightweight framework that integrates continual learning, semantic representation, and hybrid detection. CLEAR learns new attack classes incrementally while preserving prior knowledge through an efficient replay strategy. A contrastively aligned language model produces semantic embeddings of network flows, enabling generalisation to unseen attacks, and a drift-aware module adjusts detection thresholds as traffic patterns evolve. The CLEAR unifies semantic-guided replay, supervised-unsupervised hybrid detection, and drift-sensitive adaptation within a single continual learning architecture. This design supports stable performance under limited data, shifting traffic distributions, and strict zero-day conditions. Experiments on four benchmark datasets (CIC-IDS-2017, CIC-IDS-2018, BoT-IoT 2018, and IoT-23) show that CLEAR achieves strong overall performance (F1 ≈ 0.89, average FPR ≈ 0.08), reduces catastrophic forgetting by up to 24%, and attains zero-day detection rates of 88%. CLEAR also performs well on rare attacks (F1 ≈ 0.83) and few-shot classes (F1 ≈ 0.85), demonstrating its suitability for adaptive and real-time intrusion detection in dynamic network environments.}
}
@article{XU2026116914,
title = {SiTC-Diff: A Spatial–Temporal Integrated Correction Diffusion model for multi-step traffic flow forecasting},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116914},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116914},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016400},
author = {Yuan Xu and Chen-Yang Yan and Qun-Xiong Zhu and Wei Ke and Chong-Xing Ji and Yang Zhang},
keywords = {Traffic flow forecasting, Diffusion models, Contextual path correction, Spatiotemporal representation learning, Conditional generation},
abstract = {Traffic flow forecasting is a critical task in IoT-enabled smart cities and serves as a key component of Intelligent Transportation Systems (ITS). In complex traffic environments, where urban traffic flow data are influenced by significant spatiotemporal heterogeneity and abrupt disturbances, conventional models often struggle to balance prediction accuracy and stability in multi-step forecasting. To address these challenges, this paper proposes the Spatial–Temporal Integrated Correction Diffusion model (SiTC-Diff), a conditional diffusion model for traffic forecasting that integrates spatiotemporal representation learning with Contextual Path Correction (CPC). The proposed model incorporates a historical-context-conditioned innovation into the generalized DDIM reverse transition to reduce multi-step error growth across forecasting horizons. To improve the representation of spatiotemporal patterns, this work develops a denoising network named WRAUNet, which incorporates Windowed Temporal–Spatial Self-Attention (WinTSSA) and Dual-Branch Residual Attention (DBRA). These components jointly enhance the modeling of both local spatial structures and global temporal dynamics. Additionally, a multi-frame historical window is encoded and fused with the current noisy state through cross-attention at each reverse step, providing shared context for WRAUNet noise estimation and CPC innovation generation. Experiments on TaxiBJ, TaxiCQ, Traffic4Cast-BER, and Traffic4Cast-IST demonstrate consistently strong forecasting performance across datasets with different spatial resolutions, as well as smaller error growth across forecasting horizons.}
}
@article{ASGARI2026116933,
title = {DeepTraCDR: Prediction of cancer drug response using multimodal deep learning with transformers},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116933},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116933},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601659X},
author = {Zahra Asgari and Mohammad Hossein Eslami and Ali Kianfar and Karim Abbasi and Mohammad Barshan Tashnizi and Hamid R. Rabiee},
keywords = {Drug response prediction, Precision oncology, Personalized cancer therapies, Graph convolutional networks, Multi-head attention},
abstract = {Cancer remains one of the leading causes of death worldwide, posing significant challenges to public health and treatment strategies. The disease's complexity and variability, combined with the diverse ways it responds to treatment, make cancer drug response prediction (CDRP) a critical challenge. Precision oncology aims to personalize treatment by leveraging individual genetic and molecular profiles, but the intricate interactions between tumors, drugs, and cell lines hinder the development of accurate CDRP models. To enhance the effectiveness of personalized cancer therapies, it is crucial to overcome this challenge and develop reliable prediction models that accurately capture the intricate relationships between cancer biology and drug responses. Our model, DeepTraCDR, is a deep learning-based approach for predicting cancer drug response. It leverages gene expression data and molecular fingerprints of drugs to extract meaningful features. The method utilizes graph convolutional networks (GCNs) and multi-head attention to capture complex relationships. The model is optimized using a novel loss function that combines cross-entropy loss and margin ranking loss. This innovative architecture enables our model to surpass traditional methods, achieving a new level of accuracy in predicting drug responses. Extensive experiments on the GDSC and CCLE datasets confirm the model’s superior performance, outperforming existing baseline methods in both AUC and AUPRC. Furthermore, our model demonstrates remarkable versatility and robustness, successfully transferring to the PDX and TCGA datasets across diverse experimental conditions. By advancing computational prediction of drug response, our model provides a promising tool for in silico screening and prioritization of drug-cell line pairs. These results support the use of DeepTraCDR as a computational aid in preclinical research, potentially accelerating the identification of promising candidates for further experimental validation. While significant challenges remain before clinical deployment, this work contributes a robust framework for comparative assessment of drug sensitivity patterns.}
}
@article{ZHAO2026116777,
title = {STF-Diff: The key to image style transfer using extended style inversion is the style token filter},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116777},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116777},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015030},
author = {Haomin Zhao and Jie Zhang and Qiuxia Yang and Chengchao Wang and Yuanyuan Pu and Zhengpeng Zhao},
keywords = {Style transfer, Diffusion models, Inversion},
abstract = {Image style transfer has experienced significant advancements driven by the development of large-scale text-to-image models. However, existing methods are unable to effectively disentangle style and content in images and suffer from limitations in their integration. We address these issues through inversion and style filtering, and propose a one-shot style transfer model, termed STF-Diff. Specifically, by leveraging inversion of Diffusion Models, we align style and content at different timesteps and attention layers to a learnable set of style Tokens and a filtered and frozen pure content description, respectively, thereby effectively decoupling an independent style representation that captures the distinctive artistic characteristics of the artist. Furthermore, we experimentally investigate the impact of different content control conditions on stylized results, and achieve controllable content structures by integrating multiple conditions, thereby ensuring a harmonious fusion of style and content during the reconstruction process and producing visually coherent stylized results. Experimental results demonstrate that, compared with existing methods, STF-Diff can effectively decouple a style representation that captures the distinctive artistic characteristics of the artist, and harmoniously integrate it with the content structure of content images to reconstruct high-quality stylized results.}
}
@article{FADDA2026116890,
title = {Generating knowledge graphs from news articles via multi-agent claim extraction and attribution},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116890},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116890},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016163},
author = {Massimiliano Fadda and Enrico Motta and Francesco Osborne and Diego {Reforgiato Recupero} and Angelo Salatino},
keywords = {Claim extraction, Multi-agent systems, Entity linking, Knowledge graph construction, Large language models, Computational journalism},
abstract = {News sources play a fundamental role in democratic societies by shaping how citizens access information about facts, events, and competing viewpoints. It is therefore essential to study how different outlets in different countries fulfil this role. A central aspect of such analyses is the examination of claims expressed by specific voices in the media. However, the large-scale identification, attribution, and extraction of claims from news content remain open challenges, due to the diverse ways in which claims and agents can be expressed, and the distinctive characteristics of journalistic writing. In this paper, we address this challenge by introducing SEER, a comprehensive framework for constructing large-scale knowledge graphs from news articles. To ensure high-fidelity extraction, SEER incorporates a novel Multi-Agent Ensemble module specifically designed to handle the complexity of claim extraction and attribution better than single-model approaches. The resulting knowledge graph is based on an extension of the News Classification Ontology (NCO), which captures the key characteristics of claims in news media. We also present a prototype implementation of the proposed architecture and evaluate it on a corpus of articles drawn from four domains: climate change, UK immigration, the war in Ukraine, and US politics. We perform an evaluation on manually annotated data, showing that SEER’s multi-agent extraction module achieves strong performance (78.22% Macro F1), outperforming ten alternative single-model LLM-based agents on the claim extraction task. We conducted an ablation study and identified recurring error types that highlight remaining challenges in journalistic claim extraction.}
}
@article{XIANG2026116898,
title = {STIFNet: A Scale-Guided Sparse Target Interaction and Context Feedback Network for infrared small-target detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116898},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116898},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016242},
author = {Gaopeng Xiang and Longcheng Que and Kai Che and Jiayuan Gong and Xiangheng Liu and Yukun Liu and Ming Liu and Yun Zhou},
keywords = {Infrared small-target detection, Sparse interaction, Top-K selection, False-alarm suppression, Spatial context feedback},
abstract = {Infrared small-target detection (IRSTD) remains challenging because real targets occupy extremely sparse foreground regions, exhibit weak responses, and are easily confused with target-like background structures. Existing CNN- and Transformer-based methods commonly strengthen target representation through dense cross-level fusion and global context modeling. However, when all spatial tokens participate in cross-scale updating, the numerically dominant background can dilute weak target evidence and repeatedly reinforce clutter responses. To address this problem, we propose STIFNet, a Scale-Guided Sparse Target Interaction and Context Feedback Network. STIFNet reformulates dense cross-scale fusion as a candidate-driven dual-sparse interaction process. Dual-Sparse Cross-scale Interaction (DSCI) constrains both sides of cross-scale updating: query-side selection determines where an additional interaction increment is written, whereas context-side selection determines which multiscale key–value tokens supply that increment. Because unselected features remain available through the residual pathway, this process prioritizes information exchange rather than making an early target decision. Spatial Context Feedback (SCF) subsequently consolidates potentially fragmented local spatial evidence after selective interaction, while the Scale Guidance Estimator (SGE) provides shared scale guidance for the scale-dependent candidate budgets and feedback gates. Experiments on NUAA-SIRST, NUDT-SIRST, and IRSTD-1K yield IoUs of 79.35%, 94.11%, and 69.94%, with Fa values of 6.31, 3.08, and 9.65 (10−6), respectively, while maintaining competitive Pd. Quantitative comparisons, ROC curves, saliency-response visualizations, DSCI query-selection diagnostics, and ablation studies consistently show that constraining cross-scale interaction participants improves low-false-alarm infrared small-target detection without presupposing a completed target–background decision. Our code is publicly available at https://github.com/Huizhangisme/STIFNet.}
}
@article{LU2026116882,
title = {AllFreqNet: A unified frequency-enhanced all-in-one framework for medical image restoration},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116882},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116882},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016084},
author = {Zhouxian Lu and Xiangyun Hu and Pengwei Dong and Yunfei Zha and Jian Yao and Bo Su},
keywords = {Medical image restoration, Computed tomography denoising, Metal artifact reduction, Magnetic resonance imaging super-resolution, Positron emission tomography synthesis},
abstract = {High-quality medical image restoration (MedIR) is essential for reliable diagnosis, yet existing task-specific models often introduce redundant computation and generalize poorly across heterogeneous degradations. More importantly, diagnosis-critical anatomical details are frequently entangled with task-dependent noise and artifacts in high-frequency components, making unified restoration challenging. To address these issues, we propose AllFreqNet, a unified frequency-enhanced all-in-one MedIR framework for computed tomography (CT) denoising, CT metal artifact reduction, magnetic resonance imaging (MRI) super-resolution, and positron emission tomography (PET) synthesis. AllFreqNet integrates a Multi-Scale Mixture-of-Experts (MS-MoE) module for task-adaptive feature extraction and a Region-Conditioned Frequency Prompt Modulation (RC-FPM) module for region-aware frequency refinement. MS-MoE reduces inter-task interference by combining global task cues with local expert routing, while RC-FPM adaptively separates and modulates low- and high-frequency representations to suppress degradations while preserving anatomical structures. Extensive experiments on four representative MedIR tasks demonstrate that AllFreqNet achieves state-of-the-art or competitive performance. Compared with the strongest all-in-one baselines, AllFreqNet improves peak signal-to-noise ratio (PSNR) by 0.54 dB on CT denoising, 0.47 dB on CT metal artifact reduction, and 0.14 dB on MRI super-resolution, while achieving the second-best result on PET synthesis. These results show that AllFreqNet provides an effective unified solution for cross-task medical image restoration with strong restoration accuracy, reduced task interference, and improved preservation of diagnosis-critical details.}
}
@article{GUL2026116935,
title = {Metaheuristic-driven two-stage hybrid feature selection and deep learning optimization for security in IoT systems},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116935},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116935},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016618},
author = {Muhammed Furkan Gül and Halit Bakır},
keywords = {IoT security, Metaheuristic algorithms, Feature selection, Deep learning optimization, Intrusion detection systems (IDS)},
abstract = {Intrusion detection in Internet of Things (IoT) systems poses significant challenges due to high-dimensional, heterogeneous, and rapidly evolving network traffic. To address these issues, this study proposes a novel two-stage hybrid framework aimed at enhancing the performance and scalability of intrusion detection systems. In the initial stage, the Random Forest algorithm ranks features by importance and retains the top 50%. In the second stage, five metaheuristic algorithms refine the feature space: Genetic Algorithm, Particle Swarm Optimization, Whale Optimization Algorithm, Sine Cosine Algorithm (SCA), and Harris Hawk Optimization. The final feature subsets are combined to build a robust and compact input set. These same algorithms are then used to automatically optimize DL model architectures and hyperparameters. Experiments conducted on the RT-IoT 2022 dataset show that the SCA-optimized model achieved the best results, with 99.38% accuracy, 2.63% loss, and a consistent F1 score of 99.40% under stratified 5-fold cross-validation. These results are particularly notable given the imbalanced and complex nature of IoT traffic, and they indicate the model’s ability to accurately detect both frequent and rare intrusion types. The proposed framework addresses the challenges of high-dimensional, heterogeneous IoT traffic by enabling fully automated, high-performance model design. These findings highlight its potential for real-world deployment in scalable and adaptive IoT intrusion detection systems. Future work will explore its applicability to broader IoT environments and integration with emerging paradigms such as federated and quantum machine learning.}
}
@article{HUANG2026116846,
title = {PGCI-SAR: Physics-guided causal intervention for incremental few-shot object detection in SAR imagery},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116846},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116846},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015728},
author = {Chongjun Huang and Guohui Yuan and Jiamin Cai and Yi Sun and Qian Jiang and Lei Yang and Xiaoyang Li and Zhuoran Wang},
keywords = {Synthetic aperture radar (SAR), Object detection, Incremental few-shot learning, Causal intervention, Physics-guided},
abstract = {In real-world object detection, class expansion in synthetic aperture radar (SAR) imagery has long been constrained by three major challenges: scarce samples, inaccessible base-class data, and limited computational resources. These challenges are further exacerbated by the interaction between SAR speckle noise and pre-training bias, which jointly degrades feature representations. Consequently, conventional few-shot learning approaches often fail in this setting, leading to catastrophic forgetting and insufficient learning capacity for novel classes. To address these challenges, we propose PGCI-SAR, an incremental few-shot object detection framework that explicitly disentangles speckle noise from semantic content and mitigates pre-training bias through a physics-guided causal intervention (PGCI) module. Within a structural causal model, the PGCI module performs speckle correction and noise-aware backdoor adjustment to eliminate spurious correlations. To prevent catastrophic forgetting, we integrate PGCI with a knowledge distillation scheme, further enhanced by an adaptive mask module that preserves base-class representations. The resulting model requires substantially fewer training iterations and minimal memory, enabling class expansion directly on resource-constrained edge devices. Experiments on the widely used SAR-AIRcraft-1.0 and SARDet-100 K datasets demonstrate that PGCI-SAR significantly improves both base-class retention and novel-class generalization, outperforming existing state-of-the-art methods across various few-shot scenarios. These results not only highlight the superior detection performance of PGCI-SAR but also demonstrate its efficient training process, making it well suited for real-world applications in complex and noisy SAR environments.}
}
@article{LAKSONO2026116950,
title = {A knowledge-based approach to UAV path planning for bridge maintenance in a digital twin environment},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116950},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116950},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601676X},
author = {Naufal Budi Laksono and Yusuf Latief and Bambang Trigunarsyah and Kim Sunkuk and Nyoman Suaryana},
keywords = {Bridge inspection, Bridge maintenance, UAV path planning, Knowledge-based planning, BIM, Digital twin, Viewpoint selection, Repeatable inspection routes},
abstract = {Unmanned aerial vehicles (UAVs) are increasingly used for bridge inspection to reduce hazardous access and improve scalability. Routes are often manual or coverage-driven, and the collected imagery is not always comparable or aligned with maintenance decision needs. This study proposes a knowledge-based UAV path planning approach that converts maintenance intent into executable and repeatable inspection routes. The method integrates element-level maintenance knowledge from field inspection and maintenance records encoded as priority weights and viewing requirements with BIM derived bridge geometry to generate candidate viewpoints and element specific inspection patterns for substructure and superstructure. Viewpoints are evaluated using a maintenance-weighted utility function. A case study on a conventional concrete box-girder toll-road bridge compares the approach with three baselines manual rule-of-thumb, a coverage only planner, and a robustness oriented feasibility proxy. Results show routes that remain traceable to maintenance priorities and support cycle-to-cycle repeatability for continuous inspection planning.}
}
@article{XING2026116955,
title = {PAMA: Dual-memory augmentation assisted pseudo-anomaly contrastive learning for multivariate time series anomaly detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116955},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116955},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016813},
author = {Hong-Jie Xing and Tang Qian and Chun-Guo Li},
keywords = {Multivariate time series anomaly detection, Contrastive learning, Dual-memory augmentation, Pseudo anomaly, Uncertainty learning},
abstract = {For multivariate time series anomaly detection, most methods assume that training data are clean and ignore the characteristics of anomalous data. They often suffer from the overgeneralization problem during the reconstruction process. To address these problems, dual-memory augmentation assisted pseudo-anomaly contrastive learning for multivariate time series anomaly detection (abbreviated as PAMA) is proposed. First, the prior knowledge of anomalies is utilized to generate pseudo anomalies from the original time series. The normal and pseudo-anomalous feature representations that contain global and local information are respectively achieved by the global and local encoders. Two independent memory modules are constructed to further memorize normal and pseudo-anomalous prototypes. Second, a dual-memory augmentation mechanism is proposed to conduct data augmentation upon the normal and pseudo-anomalous feature representations and then obtain the memory-augmented feature representations. Third, the pseudo-anomaly contrastive learning is proposed to perform temporal contrastive learning and instance contrastive learning on the obtained memory-augmented representations. Compared with fourteen baseline methods, PAMA achieves superior detection performance, effectively suppresses noise, and mitigates the overgeneralization problem. The codes for PAMA can be downloaded from https://github.com/Qiantang-net/PAMA.}
}
@article{ARIAN2026116701,
title = {Ill-Posedness evolved in the deep: Adaptive Evolutionary Latent Optimization, an application to recovering volatility},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116701},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116701},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014279},
author = {Hamid Arian and Daniel Norouzi Mobarekeh},
keywords = {Adaptive Evolutionary Latent Optimization, Latent space optimization, Evolutionary algorithms, Volatility surface recovery, Generative models, Physics-Informed Neural Networks, Ill-posed inverse problems},
abstract = {Optimizing high-dimensional latent spaces is challenging, especially for ill-posed inverse problems with nonlinear and implicit relationships. We introduce Adaptive Evolutionary Latent Optimization (AdELO), which combines evolutionary algorithms with generative and objective models to iteratively refine latent representations. AdELO alternates between optimizing latent vectors and fine-tuning models to navigate latent space efficiently. Using beta-Variational Autoencoders (beta-VAEs) for latent representation and Physics-Informed Neural Networks (PINNs) to enforce physical laws, we apply AdELO to recover local volatility surfaces from option prices—a notoriously ill-posed problem in financial mathematics. By parameterizing the volatility surface with Gaussian Radial Basis Functions (RBFs) and imposing smoothness priors for regularization, we calibrate candidate surfaces to market prices. On synthetic option-price datasets, AdELO attains lower PINN-based calibration loss than the tested fixed-latent-space optimization baselines under a matched number of fitness evaluations. Robustness experiments indicate that performance varies across volatility regimes and data perturbations. On selected real option chains, the method produces accurate in-sample fits in some cases but does not generalize consistently across all dates and regimes. These findings support AdELO as a promising adaptive latent-space calibration framework while also identifying limitations related to computational comparability, independent evaluation, and real-market robustness. This framework contributes to volatility-surface calibration methods and suggests a broadly applicable adaptive latent-space optimization approach for complex, high-dimensional problems.}
}
@article{LU2026116927,
title = {Robust triple disentangled representation learning for multimodal sentiment analysis},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116927},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116927},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016539},
author = {Yijie Lu and Qing He and Nisuo Du},
keywords = {Multimodal sentiment analysis, Triple disentangled representation learning, Noise-robust learning},
abstract = {Multimodal sentiment analysis remains a highly challenging task, in part because of the inherent heterogeneity among modalities. Therefore, many emerging studies focus on disentangling modality-shared representations and modality-private representations from the input data, and then fusing them to make predictions. However, our research shows that modality representations often contain task-irrelevant or only weakly relevant information, thereby decreasing the effectiveness of the learned multimodal representations. To address these issues, we propose a new robust triple disentanglement framework called RMCD, which first introduces task-irrelevant noise to construct two views, then explicitly decomposes the features into three complementary representations: a common representation capturing global consistency, private representations preserving modality-private cues, and a sentiment representation that acquires fine-grained sentiment-related information. This fine-grained decomposition improves representation quality by reducing redundancy, promoting cross-modal complementarity, and isolating task-relevant sentiment cues. To further support feature modeling, we introduce three enhancement modules to process features from different disentangled parts: one is cross-attention-based processing for private features, another is self-attention-based processing for shared features, and the last is multi-level prediction with unimodal auxiliary supervision sentiment features. Extensive experiments on multiple public datasets demonstrate that our method achieves competitive performance against existing approaches, validating the effectiveness and robustness of the proposed framework.}
}
@article{M2026116915,
title = {Variogram-Driven Structured Graph Regularization leveraging fractal dynamics},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116915},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116915},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016412},
author = {Kanimozhi M. and Sudhakar M.S.},
keywords = {Adaptive similarity graph, Elastic-net regularization, Fractal dimensional features, Normalized Semi-Variogram, Label propagation, Semi-supervised graph learning},
abstract = {The inherent qualities of Graph-based Semi-supervised Learning (GSSL) offer a large-scale classification of unlabeled data by jointly learning a few labels with underlying graph structures. This GSSL’s sophistication has garnered growing interest in the realm of image annotation. However, many recent approaches struggled to produce high-quality graphs with lower dimensions, which adversely impacted system performance. To overcome the above issues, a novel Variogram-Driven Structured Graph Regularization (VDSGR) is proposed to learn local structure with scaled features in a unique convex optimization framework guaranteeing improved accuracy in low-dimensional space. Initially, the method extracts localized scale invariant shape features using statistically tuned fractals that are then fabricated into a dissimilarity graph using the modified variogram distance metric to provide a high distinction between the interclass samples. The resultant graph is then optimized using the constrained elastic-net regularizer to yield the sparse similarity graph. Finally, a unified framework is formulated to jointly learn graph structure with Label Propagation, enhancing data classification. Rigorous analysis of VDSGR on heterogeneous-natured datasets demonstrates its superior and consistent accuracy greater than 94% surpassing its peers with the availability of 5–10 percent labels. Additionally, the parameter-free optimization model makes the process elegant and feasible for real-time applications.}
}
@article{CZAPLEWSKI2026116939,
title = {Prediction of reflection responses for randomized free-form antenna designs using a convolutional neural network},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116939},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116939},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016655},
author = {Bartosz Czaplewski and Tom Dhaene and Sebastian {Rojas Gonzalez} and Adrian Bekasiewicz},
keywords = {Machine learning, Convolutional neural networks, Reflection response regression, Antenna design evaluation},
abstract = {This study presents a convolutional neural network optimized to predict the reflection responses from pseudo-random, multi-dimensional free-form antenna designs using 50 vertices. The proposed framework does not rely on expert knowledge and electromagnetic simulations during inference of the responses. The main contributions include: (1) a new dataset comprising 108,710 pseudo-random antenna topologies and their corresponding reflection characteristics; (2) a convolutional neural network capable of predicting the reflection response over a wide frequency range directly from complex pseudo-random antenna geometries; (3) a comprehensive evaluation, including training procedures, performance assessment, and comparison with alternative approaches. The input of the model is a 2×51 tensor that represents vertex coordinates of the antenna, while the output is a reflection characteristic (in decibels) in the form of a 251-point vector spanned over a frequency range from 3 GHz to 8 GHz (with 20 MHz step). The dataset is publicly available to ensure reproducibility. The hyperparameters for the network training were selected via Bayesian optimization. Furthermore, the model was trained and validated using 10-fold cross-validation, whereas its performance was evaluated using a separate test set. The model achieved a mean squared error of 3.788, a mean absolute error of 0.911, a coefficient of determination of 0.438, and a root mean squared error of 1.946 for the entire frequency range. The average prediction time of 1.9 milliseconds per sample enables a rapid evaluation of thousands of candidate designs, alleviating the computational bottleneck associated with extensive cost of electromagnetic simulations in the exploratory phase of antenna development.}
}
@article{ZHANG2026116834,
title = {Multi-bias logit fusion in a pseudo-text space for CLIP few-shot learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116834},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116834},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015601},
author = {Yi Zhang and Yu Mao and Hui Chen and Jinyu Gao and Ziqiang Huang and Yaojin Lin},
keywords = {Few-shot learning, Vision–language models, Training-free adaptation, Multi-bias logit fusion, Pseudo-text space},
abstract = {Pre-trained vision–language models, such as Contrastive Language–Image Pre-training (CLIP), enable strong zero-shot recognition; however, adapting them to downstream few-shot tasks remains challenging. From a unified perspective, existing methods can be viewed as learning different forms of logit bias for zero-shot CLIP. However, most methods model a single bias source, thereby limiting complementary calibration across biases, which often leads to sub-optimal classifiers. To address this challenge, we propose multi-bias logit fusion in a pseudo-text space (MBLF-PTS) for CLIP few-shot learning. MBLF-PTS integrates three complementary logit biases: a cross-modal projection bias that maps images into a pseudo-text sub-space, where samples from the same class form tighter clusters and enable more reliable classification; a kernel reweighting branch that learns a support-driven kernel bias and automatically down-weights noisy or low-quality support samples; and a dual-level memory that produces instance-adaptive logits. Experiments on 11 standard visual classification benchmarks demonstrate that MBLF-PTS consistently outperforms representative methods in zero-shot, few-shot and training-free few-shot settings and exhibits robustness under natural distribution shifts. Code will be available at https://github.com/1108zyzy/MBLF-PTS.}
}
@article{LI2026116874,
title = {Multi-frequency channel enhancement for multivariate time series forecasting},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116874},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116874},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601600X},
author = {Yaping Li and Qiang Guo and Yongxia Zhang},
keywords = {Time series forecasting, Fourier analysis, MLP, Frequency enhancement, Adaptive frequency fusion},
abstract = {Real-world time series data typically exhibit multivariate interactive characteristics and non-stationary dynamics, which are critical for time series forecasting. Fourier analysis can effectively reveal cross-variable frequency interaction patterns and extract periodic components by decomposing time series data into multiple distinct frequency components. However, most existing deep learning-based forecasting models lack effective mechanisms for adaptively extracting global frequency features and modeling cross-frequency interactions. To address these issues, this paper proposes a multi-frequency channel enhancement network called FCE-Net, which explicitly extracts global frequency features to model frequency-varying dynamics and captures cross-frequency interactions to enhance long-term dependency modeling. FCE-Net first introduces normalization and embedding layer operations on raw data to stabilize non-stationary patterns, and then applies a multi-frequency decomposition-integration block to enhance feature representations for each independent frequency component. By treating each frequency component as an independent channel, the model dynamically adjusts channel weights via an enhanced channel attention block, suppressing noise and highlighting important information. Additionally, an adaptive frequency fusion block further integrates frequency components via adaptive weight adjustment to enhance forecasting flexibility. Our model effectively addresses the challenges of frequency feature extraction and long-term dependency modeling in multivariate non-stationary time series. Experiments on several benchmark datasets demonstrate that FCE-Net significantly outperforms state-of-the-art baselines, which verifies its effectiveness in handling complex temporal dynamics and extracting global features.}
}
@article{NGUYEN2026116947,
title = {A survey of social network simulation in the LLM era: From classical models to Generative Agents},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116947},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116947},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016734},
author = {Thanh Tam Nguyen and Trinh Pham and Viet Huynh and Minh Hieu Nguyen and Bay Vo and Liang Qu and Jianxin Li and Hongzhi Yin and Quoc Viet Hung Nguyen},
keywords = {Social network simulation, Large language models, Agent-based modeling, Opinion dynamics, Generative agents},
abstract = {Social network simulation enables controlled study of information dynamics and collective behavior on social graphs, yet the literature remains fragmented across disciplines. This survey provides a unified treatment of the field, organizing 97 papers across seven decades into five paradigms: network structure models, information diffusion, opinion dynamics, rule-based agent-based models, and large language model (LLM)-based agentic simulation. We bridge classical and generative approaches by mapping the progression from analytical update rules to language-grounded agents with semantic memory and platform-native actions, and present a systematic architectural comparison of LLM-based simulation systems. We analyze the literature across five application domains—misinformation, political discourse, platform design, information diffusion, and user behavior—tracing a shift from descriptive analysis toward prescriptive policy prototyping. We outline seven research frontiers spanning representational alignment, multi-level validation, scalability, and responsible use. An accompanying online repository at https://github.com/tamlhp/awesome-sns catalogs 48 implementations (42 open-source), 21 benchmarks and datasets, and 22 evaluation metrics.}
}
@article{FU2026116899,
title = {A deep reinforcement learning-based grey wolf optimizer with operator adaptation for hyperspectral image band selection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116899},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116899},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016254},
author = {Guogui Fu and Dong Zhao and Yupeng Li and Lei Liu and Ailiang Qi and Yi Chen and Huiling Chen},
keywords = {Hyperspectral image, Band selection, Grey wolf optimizer, Operator adaptation, Deep reinforcement learning},
abstract = {Hyperspectral image band selection aims to identify the most representative and discriminative subset of spectral bands from hundreds of contiguous and narrow bands, thereby alleviating the "curse of dimensionality" and supporting downstream tasks. Metaheuristic algorithms have been extensively adopted in this domain due to their robust global search capabilities and high interpretability. However, the performance of metaheuristic algorithms largely depends on the design of search operators. In band spaces, a single operator often struggles to balance global exploration and local exploitation, making it prone to becoming trapped in local optima. Although existing studies have improved the collaborative and adaptive regulation capabilities of multiple operators, limitations remain in their fine-grained responses to dynamic changes in search states and their utilization of prior band information. To address these challenges, this paper proposes a deep reinforcement learning-based grey wolf optimizer with operator adaptation (ROAGWO) for hyperspectral image band selection. Specifically, an adaptive operator selection mechanism based on deep reinforcement learning is developed to achieve dynamic operator selection at the individual level based on the current search state. Score-weighted initialization and greedy selection are incorporated as two practical strategies to improve the quality of initial solutions and alleviate population degradation. Furthermore, a score-weighted objective function is designed to incorporate prior band information into subset evaluation, thereby better reflecting the discriminative and informative differences among candidate band subsets. Experiments on four publicly available hyperspectral datasets demonstrate that the proposed method achieves competitive classification performance and reliable band selection results.}
}
@article{TANG2026116902,
title = {UDCL4KT: Uncertainty-aware Dual Contrastive Learning for Knowledge Tracing},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116902},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116902},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601628X},
author = {Zhikang Tang and Zhenxian He and Guangze Ye and Chunying Li and Jinli Cao and Yanchun Zhang and Jianjian Jiang},
keywords = {Knowledge tracing, Contrastive learning, Uncertainty-aware, Knowledge state representation, Educational data mining},
abstract = {Knowledge tracing tasks with label imbalance face two challenges: cognitive uncertainty and data sparsity. To tackle them, we propose Uncertainty-aware Dual Contrastive Learning for Knowledge Tracing (UDCL4KT). Essentially, the framework unifies uncertainty awareness and contrastive learning. This design focuses on the reliability of knowledge state estimation. In practice, we model student knowledge states as a Gaussian distribution, where the mean characterizes mastery levels and the covariance reflects cognitive uncertainty. To capture state evolution over time, we design an attention component based on KL-divergence. This component evaluates probabilistic shifts between consecutive states. To better refine representations of student knowledge states from interaction sequences, we leverage prior knowledge to model pairwise difficulty correlations between concepts. A dual-path encoder is additionally introduced to learn both global dependencies and local patterns in interaction sequences. This architecture employs a dual contrastive loss to enhance feature discriminability and mitigate feature redundancy. To alleviate label imbalance, we incorporate a class-balanced cross-entropy loss into the overall objective function. Comprehensive experiments on five public datasets show that UDCL4KT achieves significantly higher prediction accuracy compared with nine state-of-the-art knowledge tracing models. Further analysis examines the relationship between uncertainty scores and student behaviors. Ablation results also confirm the complementary effects of the uncertainty-aware mechanism and the dual contrastive learning components.}
}
@article{PANG2026116923,
title = {TCC-MVGC: Tensor-based Consensus Clustering for multi-view graph data},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116923},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116923},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016497},
author = {Ning Pang and Shuai Yu},
keywords = {Multi-view clustering, Graph neural networks, Tensor decomposition, Contrastive learning, Consensus learning},
abstract = {Integrating heterogeneous information from multiple graph views remains a significant challenge in multi-view clustering. Existing methods often suffer from inadequate modeling of high-order inter-view correlations and rely on simplistic fusion strategies that fail to capture the nuanced interplay between topological structure and node attributes, further facing scalability bottlenecks on large-scale graphs. To overcome these limitations, we propose TCC-MVGC, a Tensor-based Consensus Clustering framework for Multi-View Graph Clustering. Our framework introduces three key innovations: (1) a tensor representation based on Tucker decomposition to explicitly model high-order correlations among views, (2) a collaborative fusion mechanism with role specialization, allowing views to focus on their strengths (e.g., structure vs. attribute) and exchange knowledge via cross-view attention, and (3) an efficient consensus learning module that leverages locality-sensitive hashing for similarity approximation and the Nyström method for scalable spectral clustering, achieving near-linear complexity. Extensive experiments on seven benchmark datasets (including ACM, DBLP, and a million-node Reddit-MV) demonstrate that TCC-MVGC consistently outperforms 12 state-of-the-art methods across four evaluation metrics, achieving the best average rank of 1.3. Notably, our tensor representation brings an 8.7% accuracy gain over matrix-based counterparts on heterogeneous datasets. The proposed framework offers a robust, efficient, and interpretable solution for real-world multi-view graph analysis. The source code of TCC-MVGC has been made publicly available at GitHub: https://github.com/pn529/TCC-MVGC.}
}
@article{XIONG2026116733,
title = {Self-Organizing Group Network for learning primary mathematics from natural language},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116733},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116733},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014590},
author = {Yiming Xiong and Jian Wang and Bing Li and Yuhan Zhu and Yuqi Zhao},
keywords = {Machine learning, Group theory, Graph-based methods, Self-organizing network},
abstract = {Large Language Models (LLMs) and Transformer architectures face significant out-of-distribution generalization challenges in mathematical reasoning tasks. A key limitation lies in their inability to effectively model symmetries, core properties in group theory that are critical for building reliable and interpretable models. To address this issue, we introduce Self-Organizing Group Network (SOGN), a novel framework inspired by the group theory. SOGN learns group structures in a systematic and step-by-step manner, promoting consistency, adaptability, and generalizability within the network. Experimental results on primary mathematics tasks demonstrate that SOGN outperforms standard LLMs and Transformer-based models. Particularly, across 20 K arithmetic and symbolic reasoning samples, SOGN achieves 100% accuracy on long-sequence arithmetic tasks (up to 100-digit operands) where Transformers and GPTs fall below 10%. On benchmark datasets such as PrOntoQA and PrOntoQA-OOD, which test compositional and out-of-distribution reasoning, as well as SVAMP and MAWPS, which consist of diverse real-world arithmetic word problems, SOGN attains 100% accuracy and exceeds GPT-4o by nearly 20% on the out-of-distribution variant. Furthermore, SOGN produces explicit and interpretable reasoning trajectories through learned group operations. The implementation code and datasets are available at https://github.com/ymxiong/sogn25/.}
}
@article{ELSAYED2026116813,
title = {Supervised learning-guided individual-level operator selection in differential evolution for constrained optimization},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116813},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116813},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601539X},
author = {Saber Elsayed and Noha Hamza and Mohamed Abdelbasset and Karam M. Sallam},
keywords = {Evolutionary algorithms, Supervised learning, Constrained optimization, Population initialization},
abstract = {Adaptive operator selection in differential evolution has been widely addressed through reinforcement learning and heuristic credit-assignment methods. However, no prior work has applied supervised machine learning to predict and assign mutation operators at the individual level for constrained optimization problems. We present SL-MODE, a supervised learning-guided multi-operator DE framework for constrained optimization. Unlike reinforcement learning-based selectors, which require reward engineering, and policy networks, SL-MODE trains a lightweight supervised classifier online, directly from population feedback, without offline pre-training. At each generation, the classifier predicts the most promising mutation operator for each individual separately, conditioned on the current search state. Training is guided by a continuous improvement index that jointly encodes objective progress and constraint-violation reduction, giving the model an explicit feasibility-aware learning signal. The framework is further enhanced by two supporting algorithmic components: a hybrid initialization technique that aims to balance global diversity with adaptive intensification around promising regions, and an adaptive equality-constraint relaxation. The results on the CEC2006, CEC2010 constrained benchmark suites and 33 real-world problems from CEC2020 demonstrate that SL-MODE consistently achieves high feasibility rates, high-quality solutions, and competitive performance with statistically significant advantages over several competing algorithms. On the CEC2006 problems, sensitivity analyses conducted confirm robustness across a wide range of algorithmic parameters.}
}
@article{ANTIL2026116907,
title = {Bi-STAM: Bi-directional spatio-temporal adaptive modeling for robust face anti-spoofing},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116907},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116907},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016333},
author = {Aashania Antil and Chhavi Dhiman},
keywords = {Face presentation attack detection, Face anti-spoofing, Bidrectional temporal difference, Spatial adaptive block, Temporal adaptive block},
abstract = {Face recognition systems have achieved remarkable progress, ensuring robust performance in diverse unconstrained environments. However, detecting spoofing attacks remains a critical challenge, positioning face anti-spoofing (FAS) as a vital research focus. Existing FAS approaches often struggle to generalize to unseen attacks, especially under varying backgrounds, illumination, spoofing materials, and image quality. Additionally, most approaches rely predominantly on static features, overlooking dynamic video information. The development of efficient, lightweight temporal networks remains an open problem. To address these challenges, we propose Bi-STAM, a novel framework that leverages bi-directional temporal difference to better extract the Spatio-temporal features. More specifically, we propose a learnable structure named Spatio-temporal adaptive (STAM) block that employs two key components: the Temporal Adaptive Block (TAB) and the Spatial Adaptive Block (SAB). TAB captures subtle motion cues by balancing temporal dynamics with static semantics, while SAB emphasizes spatial features and detects texture inconsistencies, suppressing irrelevant information. The refined features from TAB and SAB are fused in a feature aggregation block (FAB), which consolidates temporal and spatial information before passing it to a classifier block for robust spoofing detection. Extensive experiments on four benchmark datasets— MSU-MFSD, CASIA-MFSD, OULU-NPU, Replay-Attack and SynthASpoof—demonstrate that our approach achieves state-of-the-art performance. The source code will be made publicly available at: https://github.com/aashania/Bi-STAM.git}
}
@article{SUN2026116959,
title = {Noise-robust personalized keyword spotting via multi-task gradient compensation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116959},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116959},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016850},
author = {Chengli Sun and Jiayi Sun and Bikang Chen and Yan Leng and Feilong Chen and Jiawei Li and Biyun Ding and Miao Sun},
keywords = {Personalized keyword spotting, Speaker verification, Multi-task learning, Gradient compensation},
abstract = {Personalized Keyword Spotting (PKWS) is a speech processing task that aims to detect predefined keywords spoken by enrolled speakers in audio streams. It inherently integrates two subtasks: Keyword Spotting (KWS) and Speaker Verification (SV). Although recent deep learning-based PKWS systems have demonstrated promising performance in relatively clean environments, achieving accurate PKWS in strong noisy environments remains a significant challenge. To address this issue, we propose a noise-robust personalized keyword spotting system, which consists of a Speech Enhancement (SE) module followed by two parallel branches for KWS and SV. This architecture enables simultaneous keyword detection and speaker verification in noisy environments. However, jointly optimizing multiple subtasks within a unified framework is challenging due to potential conflicts among their competing learning objectives. To mitigate this problem, we develop a novel Pareto-based multi-task gradient compensation algorithm that dynamically balances gradient updates across tasks, thereby reducing mutual interference and improving convergence efficiency. Extensive experiments on the Google Speech Commands dataset validate the effectiveness of the proposed approach, achieving a speaker verification accuracy of 97.95% and a keyword detection accuracy of 92.23%. Furthermore, our model outperforms state-of-the-art multi-task gradient optimization methods across various Signal-to-Noise Ratio (SNR) conditions, exhibiting strong robustness and superior generalization ability for real-world applications in complex acoustic environments.}
}
@article{MA2026116931,
title = {Dynamic adaptive ensemble decoding under uncertainty for large language models},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116931},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116931},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016576},
author = {Weitao Ma and Xiaocheng Feng and Lei Huang and Yichong Huang and Yangfan Ye and Xiachong Feng and Bing Qin},
keywords = {Large language models, Model ensemble, Uncertainty estimation},
abstract = {While large language models (LLMs) have achieved remarkable success across a wide range of tasks, individual models inevitably encounter performance limitations owing to inherent knowledge boundaries. Integrating heterogeneous LLMs through token-level ensembling has therefore emerged as a promising approach for leveraging complementary capabilities. However, our current ensemble frameworks suffer from two major challenges: high latency caused by continuous distribution fusion, and non-robustness arising from knowledge conflicts during forced integration. To address these issues, we propose the Gated Uncertainty-driven Integrated Decoding Ensemble (GUIDE), a two-stage framework designed to improve both efficiency and robustness. GUIDE first applies Lightweight Probe Screening to identify a reliable primary model to serve as the generation anchor. During decoding, an UGAT selectively activates auxiliary models only when the primary model exhibits high generation uncertainty, thereby reducing unnecessary computation. In addition, a Dual-Granularity Uncertainty Filtering mechanism evaluates both token-level and query-level uncertainty to filter contradictory signals and maintain stable decoding. Extensive experiments using five mainstream LLMs across six benchmark datasets demonstrate that GUIDE consistently outperforms state-of-the-art ensemble baselines, effectively mitigating the performance degradation of conventional token-level ensembles while achieving a better balance between generation accuracy and decoding latency.}
}
@article{ZHANG2026116883,
title = {Adaptive multi-scale hypergraph neural network for multi-source detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116883},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116883},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016096},
author = {Chengjun Zhang and Qiao Ke and Miao He and Chuang Liu and Xiu-Xiu Zhan and Xiangguo Sun},
keywords = {Hypergraph source detection, Hypergraph neural network, Adaptive gating, Hyperedge attention},
abstract = {Hypergraph-based source detection focuses on inversely identifying diffusion sources from spreading snapshots defined over higher-order interaction structures. Traditional methods developed on simple networks assume pairwise transmission and therefore fail to capture the higher-order aggregated interactions and non-binary dependencies that commonly exist in real-world systems. Since hypergraphs explicitly encode multi-node relationships, investigating source detection under hypergraph representations is essential for improving spreading control and early warning in complex environments. To address the multi-source tracing task characterized by higher-order features, we propose an Adaptive Multi-Scale Hypergraph Neural Network framework, termed AMHNN. The proposed AMHNN incorporates an adaptive spreading layer that integrates learnable gating with multi-order topological perception, enabling the model to alleviate source signal dilution, namely the loss of source-related information caused by repeated aggregation with infected non-source nodes, while effectively capturing long-range structural dependencies. In addition, a hyperedge-based attention mechanism is designed to model local heterogeneity by evaluating node importance strictly within hyperedge scopes. This unified architecture facilitates robust learning of latent diffusion patterns directly from observed data without requiring prior knowledge of spreading dynamics. Experiments on 12 synthetic and empirical hypergraph datasets demonstrate that AMHNN consistently outperforms baseline methods, achieving an average F1-score improvement of 13.8% over the strongest baseline across the three spreading models. The proposed framework provides an effective and scalable solution for source detection in higher-order networks and supports practical applications in epidemic tracking, rumor identification, and complex system governance.}
}
@article{TANG2026116943,
title = {Generative intra-domain and inter-domain connectivity for Unsupervised Domain Adaptation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116943},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116943},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016692},
author = {Hui Tang and Chuang Zhao and Xiaomeng Li},
keywords = {Intelligent prediction systems, Real-world visual recognition, Versatile domain adaptation, Generative connectivity, Dual bidirectional transfer, Adversarial robustness learning},
abstract = {Deploying visual recognition systems across heterogeneous data distributions remains challenging, particularly in safety-critical domains such as autonomous driving and medical diagnosis. Unsupervised Domain Adaptation (UDA) offers a principled pathway to transfer knowledge from labeled source domains to unlabeled target domains. State-of-the-art UDA methods, however, rely on a limited set of potentially noisy or misclassified target samples, overlooking the critical generative connectivity beyond the observed data. This limitation results in incomplete category representations and biased decision boundaries. To bridge this gap, we propose Generative Intra-domain and Inter-domain Connectivity (GIIC), a novel framework that uncovers intrinsic domain relationships through generative connectivity. GIIC goes beyond observed samples and simple interpolations by unifying two complementary mechanisms to reshape how intra- and inter-domain relationships are modeled in UDA. Generative Intra-domain Connectivity (GaC), driven by an adversarial robustness learning objective, constructs semantically meaningful trajectories along domain-specific adversarial directions for both domains, strategically synthesizing robust neighbors that explicitly densify intra-class structures, smooth decision landscapes, and strengthen domain-specific robustness. Generative Inter-domain Connectivity (GeC), instantiated via a dual bidirectional transfer network, establishes direct bridges between real samples across domains by bidirectionally transferring both images and features, statistically evolving infinite generative bridges that foster category-consistent connections, enhance knowledge transfer, and reduce domain discrepancies. Together, GaC and GeC jointly enrich category representations and calibrate decision boundaries, thereby enhancing generalizability. GIIC is architecture-flexible – compatible with CNNs, Transformers, and vision foundation models – and adapts robustly to absent, scarce, or noisy target labels, all without task-specific modifications. Extensive evaluations across standard UDA, semi-supervised DA, and noisy semi-supervised DA benchmarks, as well as our new in-house retinal OCT-DA dataset, confirm state-of-the-art performance across diverse architectures and label conditions, demonstrating GIIC as a practical and robust solution for intelligent visual recognition in real-world systems.}
}
@article{KANG2026116911,
title = {SSDMoE-UNet: Coordinated adaptive specialization for Mamba-based 3D brain tumor segmentation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116911},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116911},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016370},
author = {Zhongfeng Kang and Xingwei Bai and Zifei Wang and Yijin Li and Haozhe Wang and Zichen Song and Tianfang Zhang and Mingqi Zhao},
keywords = {Brain tumor segmentation, Multimodal MRI, State space model, Mixture of experts, Adaptive fusion},
abstract = {Accurate 3D brain tumor segmentation from multimodal magnetic resonance imaging (MRI) remains challenging because gliomas exhibit heterogeneous and spatially varying characteristics, including complex morphology, ambiguous boundaries, and diverse modality-specific representations. Many conventional architectures predominantly rely on shared transformation mechanisms, which may limit their ability to capture region-specific semantic variation across heterogeneous tumor regions. In this work, we revisit multimodal brain tumor segmentation from the perspective of coordinated adaptive specialization and propose SSDMoE-UNet, a Mamba-based 3D segmentation framework that coordinates adaptive representation learning across different stages. Specifically, multi-kernel parallel residual blocks enhance shallow feature extraction by capturing complementary local and multi-scale patterns. At the semantic bottleneck, an SSD-MoE block integrates Mamba2-based state-space sequence modeling with dense SoftMoE routing for adaptive expert specialization and input-dependent transformation of high-level semantic features. Gated spatial adaptive fusion (GSAF) further refines skip-level feature transmission through spatially selective information propagation before decoder fusion. Relative to Hetero-UNet, SSDMoE-UNet increased the average Dice score from 90.69 to 91.81 on BraTS2023, from 89.35 to 92.64 on BraTS2021, and from 82.64 to 86.59 on BraTS2018. Notably, the proposed method achieves superior performance across heterogeneous tumor regions, particularly for enhancing tumor (ET). These results demonstrate that coordinating the specialization of semantic and spatial representations provides a principled and effective solution for modeling heterogeneous multimodal tumor characteristics and offers a promising direction for robust 3D medical image segmentation. The code is already open source at https://github.com/kanglzu/SSDMoE-UNet.}
}
@article{SZKUTNIKROGOZ2026116855,
title = {A knowledge-based intelligent decision support framework integrating symbolic reasoning and swarm intelligence for redundancy allocation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116855},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116855},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015819},
author = {Joanna Szkutnik-Rogoż and Tadeusz Nowicki},
keywords = {Intelligent decision support, AI-driven optimization, Readiness inference},
abstract = {Decision-making in complex engineering systems increasingly requires the integration of domain knowledge, operational data, and intelligent optimization techniques. Although redundancy allocation has been widely studied in reliability engineering, existing approaches rarely integrate formal knowledge representation with AI-driven optimization within a unified decision-support framework. This paper proposes a knowledge-driven intelligent decision support framework that integrates structured system knowledge, readiness inference, and AI-based optimization for redundancy allocation in complex multi-component systems. The proposed framework combines symbolic knowledge representation of system architectures with data-driven readiness inference and a hybrid AI optimization module based on binary nonlinear programming and swarm intelligence. System configurations are encoded as a knowledge base describing logical dependencies among components, enabling reasoning about readiness. The inference layer evaluates system readiness using operational data, while the optimization layer employs a binary nonlinear programming (BNLP) model as a symbolic reasoning engine, complemented by a swarm-based computational intelligence module based on Binary Artificial Bee Colony (B-ABC) for adaptive search in nonlinear decision spaces. The proposed IDSS generates redundancy recommendations that maximize readiness-related profit under budget constraints. A real-world fleet operation scenario is used to demonstrate the system’s decision-support capabilities and robustness under budget and cost variations. Experimental results based on operational fleet data demonstrate that the framework identifies budget-feasible redundancy strategies that increase modelled system readiness while providing explainable recommendations. The proposed framework is designed to be domain-independent and can support decision-making in various engineering and infrastructure systems, including energy networks, telecommunication systems, and production facilities, where redundancy planning under uncertainty is critical.}
}
@article{ZHAO2026116904,
title = {Semantic-aware watermarking with adaptive injection for large language models},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116904},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116904},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016308},
author = {Jing Zhao and Hongwei Yang and Hengji Dong and Hui He and Weizhe Zhang and Haoyu Xu},
keywords = {Large language models, LLM-generated text, Text watermarking, Semantic watermarking, Robustness},
abstract = {Existing semantic watermarking methods for large language models (LLMs) rely on contextual semantic representations for watermark generation. However, these representations may still experience representation drift under semantic-preserving rewriting attacks, leading to reduced watermark robustness. To address this limitation, we propose SWAI, a semantic-aware watermarking framework with adaptive injection that enhances the stability of semantic watermark generation and detection. Specifically, SWAI improves semantic watermarking from two complementary perspectives: robust semantic representation learning and confidence-aware watermark injection. First, a graph-enhanced semantic embedding model is introduced to preserve local semantic topology through graph-based semantic aggregation and topology consistency learning, thereby improving the stability of semantic representations under semantic-preserving rewriting attacks. Building upon the enhanced semantic representations, SWAI employs a semantic-to-watermark projection mechanism to generate watermark logits and further incorporates a spike-confidence-aware adaptive injection strategy that dynamically adjusts watermark strength according to decoding uncertainty. In addition, a sparse token selection strategy based on prior token probabilities is employed to reduce unnecessary perturbations while preserving text quality. Extensive experiments across multiple language models, decoding settings, and adversarial rewriting attacks demonstrate that SWAI consistently improves robustness against semantic-preserving transformations while maintaining high detection accuracy and competitive text quality. These results demonstrate that jointly enhancing semantic representation stability and spike-confidence-aware adaptive watermark injection substantially improves the robustness and reliability of semantic watermarking for LLM-generated content.}
}
@article{RODRIGUEZ2026116956,
title = {Intra-hour interval forecasting combined with concept drift adaptation for electric energy demand at residential level},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116956},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116956},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016825},
author = {Fermín Rodríguez and Jesús L. Lobo and Ibai Laña and Verónica Álvarez and Eugenio Perea},
keywords = {Residential level electricity demand, Online learning, Very short-term forecasting, Concept drift},
abstract = {In any power system, regardless of its size, it is mandatory to have accurate predictions of future energy demand and energy generation for being able to ensure a reliable and secure service. Traditionally, these predictions have been done and applied for power systems which operate at high or medium voltages to guarantee their stability and correct power flow, whereas at low voltage level, fewer studies were conducted. This paper proposes an online interval forecasting methodology for very-short-term residential electricity demand at low-voltage grid nodes. The method combines a Hoeffding Tree Regressor for online point forecasting, ADWIN for drift-aware adaptation, and Conformal Prediction for uncertainty quantification. The approach is evaluated using the UMass Smart* apartment dataset, resampled to 15-minute resolution, and tested for independent forecasting horizons of 15, 30, and 45 min. To emulate different low-voltage node configurations, smart-meter data are randomly aggregated into groups of 5, 10, 15, 20, 30, 40, and 50 households. The proposed method is compared against persistence and an adaptive probabilistic load forecasting benchmark. Results show that the proposed methodology improves point-forecast accuracy and provides prediction intervals with empirical coverage close to the nominal 90% level, while reducing the sensitivity of forecast errors to the prediction horizon. The study contributes a drift-aware online interval forecasting framework for non-stationary residential demand streams, with potential application to real-time low-voltage grid control.}
}
@article{YANG2026116819,
title = {Faithful detection of hallucinations in event extraction via causal intervention},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116819},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116819},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015455},
author = {Lishan Yang and Changxin Rong and Lyuzhou Chen and Xiangyu Wang and Zhenchao Tao},
keywords = {Large language models, Event extraction, Hallucination detection, Causal inference, Counterfactual intervention},
abstract = {The deployment of large language models in event extraction is seriously hindered by structural hallucinations where generated event tuples diverge from the source text due to parametric knowledge. Current detection methods relying on self-reflective prompting and observational consistency fail to identify persistent hallucinated relations caused by parametric dominance. To address this limitation, a causal inference framework called Dual-Perspective Intervention Consistency Detection (DICD) is proposed to shift the paradigm from passive evaluation to active structural intervention. The framework operationalizes textual causal faithfulness as a dynamic dependency that demands causal efficacy through sensitivity to trigger falsification and causal specificity through invariance under entity perturbation. By utilizing atomic decomposition of event tuples and counterfactual context manipulation, the method systematically isolates genuine contextual binding from parametric dominance and stochastic noise. Empirical validation on three newly constructed hallucination detection datasets for event extraction demonstrates that the intervention approach achieves superior performance over observational baselines in diagnosing argument fabrications caused by parametric dominance.}
}
@article{ZHANG2026116919,
title = {MSCL-Tail: Multimodal semantic-augmented contrastive learning for next POI recommendation of long-tail users},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116919},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116919},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601645X},
author = {Zhipeng Zhang and Mengyao Wang and Yao Zhang and Yonggong Ren},
keywords = {Next POI recommendation, Contrastive learning, Long-tail users, Multimodal augmentation},
abstract = {Next Point-of-Interest (POI) recommendation faces significant challenges with long-tail users due to their extremely short check-in POI sequences. Although existing approaches leverage multimodal data or augmentation to solve this issue, they often suffer from indiscriminate multimodal fusion and ineffective augmentations, which introduce semantic noise and fail to meaningfully enrich short POI sequences. To this end, we propose MSCL-Tail, a multimodal semantic-augmented contrastive learning for next POI recommendation of long-tail users. Specifically, MSCL-Tail first performs multimodal semantic-aware similar POI selection by modeling modality-specific similarities and selectively fusing them through modality fusion weights. Then, we design two specialized augmentation operators (i.e., multimodal semantic substitution and multimodal semantic insertion) which preserve sequence integrity while effectively enriching short POI sequences with semantically relevant context. Furthermore, MSCL-Tail adopts a multi-task training strategy that jointly optimizes the primary next POI recommendation task and the multimodal semantic-augmented contrastive learning task via parameter sharing, enabling the model to learn discriminative representations for extremely short check-in POI sequences. Extensive experiments on real-world POI datasets demonstrate that MSCL-Tail consistently outperforms state-of-the-art baselines in next POI recommendation for long-tail users, achieving average improvements of 10.42% in HR and 10.99% in NDCG. The code is available at: https://github.com/ZZP-RS/MSCL-Tail.}
}
@article{APARCANATASAYCO2026116940,
title = {Knowledge distillation-enhanced lightweight CBiGRU for intrusion detection in edge-IoMT environments},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116940},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116940},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016667},
author = {Andres J. Aparcana-Tasayco and Byung Hyun Jo and Sekione Reward Jeremiah and Jong Hyuk Park},
keywords = {Machine learning, Knowledge distillation, Internet of medical things, Security, Bidirectional gated recurrent unit (BiGRU)},
abstract = {The rapid expansion of Internet of Medical Things applications raises new cybersecurity risks, necessitating efficient intrusion detection systems (IDS) capable of functioning on edge devices. However, most existing deep learning (DL) models demand significant computational resources, making them unsuitable for resource-constrained environments. To address this issue, a two-phase framework is proposed, utilizing soft-label Knowledge Distillation (KD) to train a lightweight Convolutional-Bidirectional Gated Recurrent Unit (CBiGRU) model. Unlike traditional IDS, this method leverages heterogeneous distillation to transfer complex temporal features from a recurrent L2D2 teacher model into a spatial-temporal student model, followed by fine-tuning on the edge. This approach reduces the model size to 21.9 K parameters while maintaining robustness against volumetric attacks. The experimental results show that the proposed model achieves 99.61% accuracy in binary classification with a false positive rate of 9%. For multi-class classification across 19 categories, it attains 98.51% accuracy and Macro-F1 score of 0.71, serving as a preliminary edge defense. Additionally, testing on the NVIDIA Jetson Nano demonstrated a micro-batching throughput of 2,096 samples per second and a processing delay of 0.47 ms per sample. This distillation-enhanced framework offers high accuracy combined with parameter efficiency, enabling low-latency detection and optimized deployment of DL in medical IoT edge gateways.}
}
@article{LIU2026116851,
title = {Continual learning via dynamic expandable task-specific and general representations},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116851},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116851},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015777},
author = {Qihe Liu and YongCheng Zhong and Fei Ye and Adrian G. Bors and JingLing Sun and RongYao Hu and ShiJie Zhou},
keywords = {Continual learning, Dynamic expansion model, Adaptive regularization optimization},
abstract = {Continual Learning (CL) seeks to develop a model capable of ongoing learning and assimilating new information while retaining previously acquired knowledge. Recent investigations have focused on utilizing pre-trained networks as the foundational architecture within dynamic expansion frameworks to improve performance in continual learning scenarios. However, these models often maintain the pre-trained backbone in a static state, thereby constraining their adaptability to emerging tasks. In this research, we present a dynamic expansion framework that decomposes representations into two structures, optimized through a novel dual backbone architecture comprising both a general and a task-specific backbone, facilitating the acquisition of both general and task-specific knowledge. We propose a Collaborative Expert Alignment methodology that leverages the feedback gradient information derived from all historical expert networks to guide the optimization of the general backbone, thereby promoting the retention of shared information across prior tasks. Additionally, we introduce a Probability-Based Alignment strategy aimed at refining the task-specific backbone, which fosters the learning of new tasks while mitigating adverse knowledge transfer effects. Furthermore, we propose a novel Collaborative Optimization Mechanism designed to synergistically enhance the general and task-specific backbones in capturing distinct knowledge domains, thereby further augmenting the model’s performance. The proposed framework is designed for task-boundary-aware continual learning settings, where expert expansion is triggered by task switches during training.}
}
@article{LI2026116924,
title = {Enhancing unsupervised feature selection via double sparsity constrained optimization},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116924},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116924},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016503},
author = {Xinrong Li and Chenyi Huang and Anning Yang and Xianchao Xiu},
keywords = {Unsupervised feature selection (UFS), Principal component analysis (PCA), Double sparsity constrained optimization, Alternating minimization},
abstract = {Unsupervised feature selection (UFS) is widely applied in machine learning and pattern recognition. However, most of the existing methods only consider a single sparsity, which makes it difficult to select valuable and discriminative feature subsets from the original high-dimensional feature set. In this paper, we propose a simple yet effective UFS method called DSCOFS via embedding double sparsity constrained optimization into the classical principal component analysis (PCA) framework. Double sparsity refers to using ℓ2,0-norm and ℓ0-norm to simultaneously constrain variables, by adding the sparsity of different types, to achieve the purpose of improving the accuracy of identifying differential features. The core is that ℓ2,0-norm can remove irrelevant and redundant features, while ℓ0-norm can filter out irregular noisy features, thereby complementing ℓ2,0-norm to improve discrimination. In algorithms, we develop an efficient proximal alternating minimization scheme to solve the resulting nonconvex nonsmooth model. In theory, we rigorously prove that the sequence generated by our algorithm globally converges to a stationary point. Numerical experiments on two synthetic datasets and eight real-world datasets demonstrate the effectiveness, stability, and convergence of the proposed method.}
}
@article{LIU2026116876,
title = {Hybrid strategy proximal policy optimization for control and optimal scheduling of heterogeneous residential appliances},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116876},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116876},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016023},
author = {Didi Liu and Xi Zhong and Baoqiang Lao and Meiqu Lu},
keywords = {Home energy management system, Proximal policy optimization, Demand response, Real-time energy scheduling},
abstract = {The integration of flexible resources — such as photovoltaic modules, energy storage devices, and controllable loads — into residential microgrids has not only transformed home energy management system (HEMS) architectures, but also introduced challenges such as multi-dimensional coordination complexity and stochastic uncertainty. In light of these issues, this study proposes a novel HEMS framework that coordinates various load types to minimize the total electricity costs under a hybrid pricing scheme combining real-time pricing and demand charges. The inherent heterogeneity of household loads generates a discrete–continuous hybrid action space, which limits the effectiveness of conventional reinforcement learning algorithms. To overcome this limitation, a hybrid proximal policy optimization (PPO) method is herein developed that jointly optimizes discrete appliance scheduling and continuous power dispatch. Extensive simulations based on real-world datasets demonstrate that, when compared to the greedy algorithm, deep Q-network, and deep deterministic policy gradient baselines, the proposed algorithm achieves cost reductions of 20%, 8.5% and 4.6%, respectively. Furthermore, ablation experiments confirm that the proposed algorithm surpasses the original PPO across all evaluation metrics, notably reducing the user’s peak net load and total electricity costs by 18.8% and 10.9%, respectively.}
}
@article{YUAN2026116928,
title = {Intrinsic-guided hyperspectral semantic segmentation via material-illumination representation learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116928},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116928},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016540},
author = {Fuqiang Yuan and Hongkun Zhang and Wenjun Li and Beiqi Wu and Yihao Liu},
keywords = {Hyperspectral semantic segmentation, Intrinsic decomposition, Material-aware perception, Autonomous driving},
abstract = {Hyperspectral semantic segmentation provides material-aware visual perception for autonomous-driving scene parsing, but close-range driving scenes contain strong illumination changes, shadows, occlusions, and viewing-condition variations that make the observed spectra deviate from intrinsic material properties. Meanwhile, repeated downsampling and deep semantic aggregation may weaken the ordered material cues carried by contiguous spectral bands. To address these issues, we propose IGHS-Net, an intrinsic-guided hyperspectral segmentation framework that incorporates spectral-shape descriptors and image-formation priors into dense hyperspectral perception. IGHS-Net uses raw spectral-shape descriptors to calibrate shallow encoder features, learns task-driven reflectance-related and illumination-related representations from deep features, and fuses material-discriminative evidence with local illumination context for dense prediction. The resulting model explicitly embeds spectral derivative information and intrinsic material-illumination structure into the segmentation network. Experiments on HSIDrive, HyKo2-VIS, and HCV2 show that IGHS-Net outperforms reproduced mainstream semantic segmentation baselines under a unified protocol, achieving mIoU scores of 0.8327, 0.6990, and 0.4237, respectively. Ablation studies support the complementary contributions of spectral-shape calibration, intrinsic representation learning, and illumination-conditioned fusion. The code is available at https://github.com/yyyy1129/IGHS-Net.}
}
@article{TANG2026116900,
title = {Semantic-consistent trigger generation for backdoor attacks on graph neural networks},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116900},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116900},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016266},
author = {Yanlong Tang and Yuansheng Li and Witold Pedrycz and Kaoru Hirota and Fei Yan},
keywords = {Graph neural networks (GNNs), Backdoor attack, Feature trigger, Semantic consistency, Structure preservation},
abstract = {Graph Neural Networks (GNNs) have shown exceptional performance across diverse tasks due to their inherent capability to process non-Euclidean data. However, recent studies reveal that GNNs are vulnerable to structural perturbations and node attribute manipulations during training, leading to biased or erroneous decisions. Current feature-based backdoor attack methods generally rely on fixed-form triggers or necessitate structural modifications for viable activation, which may cause substantial disruption to the original graph structure. To address this challenge, we propose SCGBA, a high-performance adaptive strategy for generating and embedding feature triggers. SCGBA is the first to leverage semantic consistency to enable effective backdoor attacks without altering the original graph structure. Moreover, it incorporates a global structure-preserving constraint during the trigger embedding process, enhancing its ability to evade advanced backdoor defense mechanisms. Extensive experiments on multiple real-world graph datasets demonstrate that SCGBA significantly outperforms existing backdoor attack methods in trigger activation rates while maintaining robust evasiveness against various mainstream defense strategies.}
}
@article{DAMODARAN2026116884,
title = {Semantic segmentation of high voltage transmission towers and power lines in satellite images using optimized multi-anchor space-aware temporal convolutional neural networks},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116884},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116884},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016102},
author = {Satheeswari Damodaran and Leninisha S and N․M JothiSwaroopan},
keywords = {Fast guided median filter, Young's double-slit experiment optimize, Power line detection, Satellite images, Multi-anchor space-aware temporal CNN},
abstract = {Maintaining the optimal performance of electrical networks requires careful planning and safeguarding during maintenance operations. This paper proposes a semantic segmentation framework SSHT-PLSI-MSTCNN for detecting high-voltage transmission towers and power lines from satellite images, aimed at enhancing the monitoring and control of electrical power distribution systems. The study utilizes real-time satellite images collected from the Chennai region, which serve as the primary dataset for analysis. These images are initially preprocessed using the Fast Guided Median Filter (FGMF) to effectively remove noise while preserving important structural details and edge information. After preprocessing, the images are fed into improve dataset relevance, enabling more accurate learning and interpretation of geographic features. The processed and annotated images are then input into the Multi-anchor Space-aware Temporal Convolutional Neural Network (MSTCNN), which performs pixel-level semantic segmentation to accurately identify and classify high-voltage transmission towers and power lines. To further enhance model efficiency and accuracy, the Young’s Double-slit Experiment Optimizer (YDEO) is employed to optimize the weight parameters of the MSTCNN, improving convergence speed and classification performance. The proposed SSHT-PLSI-MSTCNN framework is evaluated using several performance metrics, including accuracy, precision, recall, specificity, ROC, Intersection over Union (IoU), and computational time. Experimental results demonstrate that the model achieves superior performance with 99.12% accuracy for power line detection and 99.14% accuracy for transmission tower detection, along with a ROC value of 0.99. When compared with existing approaches the proposed framework shows significant improvements in both detection accuracy and robustness, making it highly effective for real-world electrical infrastructure monitoring applications.}
}
@article{ZHANG2026116908,
title = {Personalized calibration for depression detection using knowledge-distilled facial video models},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116908},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116908},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016345},
author = {Gengjia Zhang and Zhiqiang Liu and Jaehyo Jung and Meina Li},
keywords = {Depression detection, Personalized calibrated model, Knowledge distillation, Real-time monitoring system},
abstract = {Personalized depression assessment requires models that can adapt to individual behavioral patterns while preserving data privacy. However, population-trained deep learning models often fail to generalize subject-specific facial dynamics. This study introduces a knowledge distillation-based personalized calibration framework that addresses this limitation by formulating personalization as a structured knowledge transfer and adaptation process. A teacher model, trained on large-scale population data, provides global behavioral knowledge, whereas a lightweight student model incrementally acquires user-specific cues from private calibration data. To strengthen the representational capacity of the teacher, we develop a multi-level fusion dual-stream network (MF-DSN) that integrates complementary spatiotemporal features through multi-scale fusion and deep supervision for robust depression-severity regression. Knowledge distillation enables the student model to retain global knowledge while specializing toward individual facial patterns under strict computational and privacy constraints. Experiments conducted on AVEC2014, the DAIC-WOZ, and real-world clinical datasets demonstrate the effectiveness of the proposed approach. The MF-DSN achieves competitive baseline performance (e.g., a mean absolute error of 2.95 for PHQ-9 prediction in the clinical data), and the personalized student model further reduces individual-level prediction error by up to 30% after calibration, highlighting its ability to correct subject-specific prediction bias. These results confirm that knowledge-based adaptive personalized calibration substantially enhances the accuracy and practical effectiveness of video-based depression-monitoring systems. The proposed framework offers a scalable and privacy-preserving solution for long-term mental-health assessment and represents a promising direction for knowledge-based personalized affective computing.}
}
@article{TANG2026116912,
title = {An optimization model for rescue team deployment in geological disaster considering priority and fairness},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116912},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116912},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016382},
author = {Jian Tang and You Zheng},
keywords = {Rescue team, Deployment scheme, Priority, Fairness, HHMA},
abstract = {In the emergency response to major geological disasters, the deployment of rescue teams directly affects the efficiency and fairness of disaster relief. This study presents an integrated framework and methodological contributions to address the problems of inefficient deployment of rescue teams, and inadequate consideration of public satisfaction in traditional deployment strategies. Firstly, the rescue priority of each sub-affected area is evaluated, based on which a multi-objective optimization model is established to maximize the rescue efficiency, as well as the perceived fairness of sub-affected areas. Secondly, a hybrid-heuristic memetic algorithm (HHMA) is developed to solve the problem. Finally, a case study is carried out with a major landslide disaster as the background. The results show that the proposed HHMA outperforms state-of-the-art MOEAs (NSGA-II, SPEA2, MOEA/D) in solution quality and distribution. The scalability test shows favorable computational tractability due to heuristic operator and vectorized matrix operations, and the robustness test under environmental uncertainty shows relative robustness due to the proposed priority-driven deployment scheme.}
}
@article{LONG2026116920,
title = {Decoupling and aligning: A new paradigm for Computationally Efficient Prompt Learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116920},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116920},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016461},
author = {Sifan Long and Jingyuan Feng},
keywords = {Vision–language models, Parameter efficient fine-tuning, Prompt learning, Image classification},
abstract = {Prompt learning, as a parameter-efficient fine-tuning paradigm, has emerged as a trend in adapting pre-trained vision–language models to downstream tasks. However, most methods require converting category names from specific tasks into textual descriptions as text prompts, resulting in the computational cost of the text encoder increasing in direct proportion to the number of categories. To address this challenge, we propose a novel Computationally Efficient Prompt Learning (CEPL) method, which showcases remarkable performance improvement while significantly reducing computational cost. CEPL involves the following two key points. (1) Boosted computation efficiency. We propose a textual prompt decoupling module (TPD) that architecturally decouples category names from the dynamic forward pass of the text encoder. By learning a single image-conditional text prompt and utilizing only the single ground-truth category prompt for supervision during training, we completely avoid repeatedly encoding all category prompts. (2) Enhanced tuning effectiveness. We introduce a semantic alignment adaptation module (SAA) which fine-tunes original image features by optimizing task-specific and task-agnostic losses, so that image features are not only aligned with semantic-level text but also adaptable to downstream tasks. Extensive experiments demonstrate that CEPL achieves superior classification performance at extremely low computational overhead. In particular, CEPL reduces GFLOPs by 95% compared to the state-of-the-art KgCoOp, and yields an average accuracy improvement of 7.57% across 16-shot classifications on 11 datasets. Our code is available at https://github.com/FengJY99/CEPL.}
}
@article{WU2026116880,
title = {Less is more: Challenging the necessity of full endogenous history context in time series forecasting},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116880},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116880},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016060},
author = {Zhaowang Wu and Hua Yan},
keywords = {Time series forecasting, Exogenous variables, Endogenous variables, Exogenous-homogeneous},
abstract = {Time series forecasting is widely applied across various fields. Currently, forecasting using the complete history of endogenous and exogenous variables has become the mainstream forecasting paradigm. It is worth considering whether this is the most efficient approach. Could incorporating excessive historical information introduce noise that interferes with the model’s judgment? In this paper, we challenge this traditional assumption. We discover that in certain scenarios, using only one endogenous variable observation point alongside the full exogenous variable historical context can yield superior prediction performance compared to methods employing the complete endogenous historical sequence. This indicates that not all historical information is beneficial. An abundance of redundant or noisy endogenous data may actually diminish a model’s predictive efficiency. We introduce SoloLinear, specifically designed for this challenging single-point endogenous variable and complete exogenous variables forecasting paradigm. Technically, SoloLinear reconstructs robust historical context for endogenous variables from exogenous-homogeneous information through dual aggregators in both time- and frequency- domains, thereby transforming single-point forecasting into a more manageable sequence-level task. Furthermore, SoloLinear is built entirely on linear layers, resulting in extremely low computational cost. Experiments across seven real-world datasets demonstrate that SoloLinear consistently outperforms state-of-the-art models (most of which rely on complete endogenous histories) in prediction accuracy, achieving an average reduction of 20.19% in MSE and 12.26% in MAE, while maintaining a model size of only 0.05M parameters.}
}