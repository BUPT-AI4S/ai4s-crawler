@article{SANDHYA2026116131,
title = {Enhanced brain tumour detection from MRI images utilizing interpretable generalized additive neural network optimized with parrot optimization},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116131},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116131},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008579},
author = {Ms. S. Sandhya and M. Senthil Kumar and Susee S. K},
keywords = {Bayesian boundary trend filtering, Interpretable generalized additive neural network, Parrot optimization, Separable synchro extracting transform},
abstract = {Brain tumors are considered among the most life-threatening and painful diseases, resulting in a significantly reduced lifespan. Accurate diagnosis of brain tumors is required to develop treatment plans that can prolong the lives of sufferers. The need for a reliable deep learning method is essential to accurately diagnose brain cancers. Therefore, an Enhanced Brain Tumour Detection from MRI Images using Interpretable Generalized Additive Neural Network optimized with Parrot Optimization (BTD-MRI-IGANN-PO) is proposed in this paper. Initially, the image is collected from MRI dataset. The images are pre-processed using Bayesian Boundary Trend Filtering (BBTF) which used to enhance the image quality and resize the image. Then, the pre-processing images are given into the extraction stage using Separable Synchro Extracting Transform (SSET). It extracts the relevant features such asintensity, texture, shape, and frequency-domain features.Then, extracted features are given into theInterpretable Generalized Additive Neural Network (IGANN) for detect the brain Tumour which classifies as Glioma Tumour, Pituitary Tumour, Meningioma Tumour, No Tumour. The Parrot Optimization (PO) algorithm is employed tooptimize the weight parameters of IGANN. The BTD-MRI-IGANN-PO is executed, itsefficacy is evaluated under some performance metrics, like accuracy, computational time, precision, specificity, and F-measure, recall, ROC and confusion matrix is analyzed. Performance of the BTD-MRI-IGANN-POapproach attains 24.39 %, 35.71 %, and 25.55 % higher accuracy; 20.73 %, 13.79 %, and 16.47 %higher precision; 14.24 %, 24.18 %, and 14.34 % better recallwhen compared with existing techniques:MRI-basedBrain Tumour detection using Convolutional Neural Network (MRI-BTD-CNN), Brain Tumour MRI utilizing Convolutional Neural Network (BT-MRI-CNN), Early diagnosis with Brain Tumour segmentation utilizing Deep Neural Network (ED-BT- DNN) respectively.}
}
@article{LI2026116204,
title = {Towards arbitrary-scale image super-resolution with prompting and diffusion prior},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116204},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116204},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009305},
author = {Guangyuan Li and Xinyue Tu and Zhanjie Zhang and Wei Xing and Lei Zhao and Yuanxing Liu},
keywords = {Image super-resolution, Diffusion model, Prompt learning},
abstract = {Arbitrary-scale image super-resolution methods have achieved impressive results. However, they struggle to reconstruct detailed texture information when the upsampling factor is greater than 4×. To mitigate this issue, we propose a novel approach combining prompting and diffusion prior for arbitrary-scale image super-resolution, named ProDiff. Specifically, we introduce a diffusion prior generation network to learn diffusion priors that conform to the distribution of high-resolution image detail information. Next, a prior fusion module is designed to integrate diffusion priors into the backbone. Additionally, we design a scale-aware prompt block, which generates input-conditioned prompts based on images with varying degrees of degradation, then merges these prompts with corresponding scale information to dynamically enhance the backbone’s ability to represent details. Extensive experiments on benchmark datasets demonstrate that ProDiff achieves SOTA performance in arbitrary-scale super-resolution tasks. Codes are released at https://github.com/GuangYuanKK/ProDiff.}
}
@article{CAO2026116046,
title = {A mutual information-based framework for generalized image fusion via common-unique decoupling},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116046},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116046},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007720},
author = {Xu Cao and Liyuan Pan and Huanxin Zou and Jun Li and Hao Chen and Xinyi Ying and Shitian He and Yingqian Wang},
keywords = {Image fusion, Common-unique decoupling, Auto encoder, Transformer, Mutual information},
abstract = {Image fusion aims to synthesize comprehensive scene representations by integrating complementary characteristics from multi-source images. Inspired from the human knowledge prior, existing methods typically focus on extracting predefined features to assist the fusion process, e.g., texture structure in visible images and thermal radiation in infrared images. However, such task-dependent schemes inevitably neglect the rich diversity of latent characteristics in multi-source image, which not only limits the exploration of the rich complementary cross-source information, but also degrades the generalization capability to diverse fusion tasks. In this paper, we propose a simple and unified method for generalized image fusion. Specifically, we generalize the image fusion task into common information collection and unique information maintenance, and design a common-unique decoupling network with a tri-encoder structure, in which a shared encoder and two private encoders are developed to extract common and unique features, respectively. To achieve robust common-unique information disentanglement, we design a decoupling loss that constrains the mutual-information among the tri-encoder outputs and source features. Unlike conventional approaches requiring human knowledge priors, our method automatically learns essential characteristics directly from input images. We conduct comprehensive experiments covering four image fusion tasks on nine popular datasets. Extensive experimental results demonstrate that our method achieves superior performance on all these tasks as compared of the respective state-of-the-art fusion methods, and show impressive cross-task generalization capability.}
}
@article{LI2026116107,
title = {LightFC-X: Lightweight convolutional tracker for RGB-X tracking},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116107},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116107},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008336},
author = {Yunfeng Li and Bo Wang and Ye Li},
keywords = {RGB-X tracking, Lightweight tracking, Siamese network},
abstract = {Despite great progress in multimodal tracking, existing trackers remain too heavy and expensive for resource-constrained devices. To alleviate this problem, we propose LightFC-X, a family of lightweight convolutional RGB-X trackers that explore a unified convolutional architecture for lightweight multimodal tracking. Our core idea is to achieve lightweight cross-modal modeling and joint refinement of the multimodal features and the spatiotemporal appearance features of the target. Specifically, we introduce a novel efficient cross-attention module (ECAM) and a novel spatiotemporal template aggregation module (STAM). The ECAM achieves lightweight cross-modal interaction between the template and search area integrated features with only 0.08M parameters. The STAM enhances the model’s utilization of temporal information through a module fine-tuning paradigm with only 0.97M parameters. Comprehensive experiments show that our LightFC-X achieves state-of-the-art performance as well as an optimal balance between parameters, performance, and speed. For example, LightFC-T-ST outperforms CMD by 4.3% and 5.7% in SR and PR on the LasHeR benchmark, respectively, achieving a 2.6× reduction in parameters and a 2.7× speedup. It runs in real-time on the CPU at a speed of 22 fps. The code is available at https://github.com/LiYunfengLYF/LightFC-X.}
}
@article{ZHENG2026116159,
title = {CasAD: Adaptive irregular events modeling and temporal dynamics disentangling for information popularity prediction},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116159},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116159},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008853},
author = {Haoyue Zheng and Lanlan Yu and Weiyi Wang and Shudong Huang and Tao Zhou and Jiancheng Lv and Quan-Hui Liu},
keywords = {Information popularity prediction, Irregular Sequence Modeling, Neural ODEs, Information diffusion, Social network analysis},
abstract = {Accurate prediction of information popularity from early cascade dynamics is a vital yet challenging task, whose core difficulty lies in how to extract discriminative temporal signals from irregular cascade events. Existing studies mainly rely on neural architectures that model temporal sequences, but they often overlook the inherent dichotomy between burst and stable growth regimes and fail to effectively address the heterogeneity of irregular events. These limitations introduce noise into latent representations and hinder prediction performance. To address these limitations, this article proposes a novel framework named CasAD, which adaptively models irregular cascade events while disentangling distinct temporal dynamics to provide more accurate popularity predictions. Specifically, we first design a neural ODE module equipped with an adaptive event-selection mechanism to reduce noise introduced by heterogeneous and irregular occurrences. This component enhances the robustness of continuous-time modeling. Next, we incorporate both local historical context and global cascade characteristics through a time-aware attention module, enabling the model to capture general dynamic patterns underlying information diffusion. Furthermore, a dual-branch disentanglement module with two dedicated convolutional kernels is proposed to decouple burst-driven and stable-growth features, thereby refining the predictive representations. Finally, the general dynamic representation is fused with the disentangled temporal features to generate the final popularity prediction. Extensive experiments on three real-world datasets show that CasAD outperforms state-of-the-art baselines.}
}
@article{CHENG2026116220,
title = {FedHPLP: A novel redundancy-aware aggregation method for horizontal federated learning},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116220},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116220},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009469},
author = {Tan Cheng and Xulei Jin and Zongxiang Zhang and Gang Chen and Shuaiyong Xiao and Chenghong Zhang and Wanying Chen},
keywords = {Federated learning, Data redundancy, Graph filtering, Adaptive-pass filtering, Redundancy-aware aggregation},
abstract = {The increasing scale of data has become a key driver of deep learning performance, with enterprises enhancing data utilization through external data acquisition and federated learning (FL). However, the widespread use of external data introduces an overlooked yet prevalent issue in FL: participants may unknowingly hold overlapping samples, leading to cross-participant data redundancy. Unlike data heterogeneity, which leads to divergent optimization directions, data redundancy results in the repeated counting of overlapping samples as independent contributions during aggregation. This amplifies redundant gradient signals, biases model updates, and ultimately degrades generalization performance. To address this challenge, we propose a novel method, federated learning with high-pass and low-pass filters (FedHPLP). FedHPLP consists of two key components. First, the adaptive-pass filtering gradient-based representation learning constructs a learnable interaction graph from participants’ updates and applies both low- and high-pass graph filters to disentangle homogeneous and heterogeneous update information, enabling the server to infer redundancy relations without accessing raw data. Second, the sample redundancy-aware weight aggregation component jointly evaluates each participant’s uniqueness and redundancy within the learned interaction graph and adaptively assigns aggregation weights, allowing more informative participants to contribute more substantially to the global model. Empirical evaluations on two datasets demonstrate that FedHPLP consistently outperforms state-of-the-art benchmarks under both redundancy-free and redundancy-prone settings. Further analysis shows that FedHPLP effectively captures data redundancy and correspondingly down-weights participants with higher redundancy.}
}
@article{FAN2026116196,
title = {PP-TDD: Privacy protection towards secure vehicle semantic trajectory data dissemination},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116196},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116196},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009226},
author = {Na Fan and Wenjun Fan and Xing Liang and Jia Liu and Zhiquan Liu},
keywords = {Privacy preserving, Vehicle trajectory, Generative Adversarial Networks, Deep learning, Trajectory synthesis},
abstract = {With the advancement of in-vehicle smart terminals and positioning technologies, massive spatiotemporal trajectories generated during vehicle operations have become critical data assets for intelligent transportation systems, supporting traffic flow prediction, route planning, and navigation services. However, trajectory data contains sensitive information, such as location privacy, personal habits, and movement patterns. Without effective privacy protection during mining and analysis, trajectories are vulnerable to attacks, leading to privacy breaches and limiting the data utility. This paper proposes a privacy protection mechanism for publishing vehicle semantic trajectory data. It utilizes a sliding window-based multi-threshold trajectory segmentation method to analyze spatiotemporal characteristics to identify staying segments of trajectories for semantic annotation. Subsequently, we introduce a semantic trajectory synthesis model that integrates Generative Adversarial Networks (GANs) with Long Short-Term Memory (LSTM) networks to learn the distribution characteristics and temporal dependencies of real trajectories, thereby ensuring the data utility and temporal continuity of synthetic trajectories. Furthermore, a novel loss function, STrajLoss, is designed to evaluate similarity between synthetic and real trajectories across spatial, semantic, and temporal dimensions, thereby optimizing the model. Experimental results demonstrate that compared with existing methods, the proposed approach effectively maintains data utility while ensuring privacy protection.}
}
@article{WANG2026116224,
title = {MSK-Net: Multi-scale spatial KANs enhanced U-shaped network for explainable 3D brain tumor segmentation},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116224},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116224},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009500},
author = {Yutong Wang and Zhongfeng Kang and Xiaopeng Fan and Zijin Wu and Shantian Yang and Qinghua Zhao and Zichen Song},
keywords = {3D medical image segmentation, Kolmogorov–Arnold networks, Explainability, Multi-scale feature fusion, Brain tumor segmentation},
abstract = {Gliomas, the most common and aggressive primary brain tumors, exhibit substantial morphological complexity and tissue heterogeneity. Accurate segmentation from Magnetic Resonance Imaging (MRI) is critical for diagnosis, treatment planning, and prognosis. Despite recent advances in automated approaches, challenges persist in jointly achieving high 3D segmentation accuracy, computational efficiency, and interpretability. To address these, this study proposes MSK-Net (Multi-Scale KAN U-Net), a novel 3D segmentation framework that incorporates the Kolmogorov–Arnold Network (KAN). The architecture introduces a KAN-Boosted Attention Module (KBAM) for enhanced feature representation and a Cross-Scale Gating Module (CSGM) to enable efficient multi-scale feature fusion. Comparative evaluation of KAN basis functions demonstrates that B-splines provide the most favorable trade-off between accuracy and efficiency in delineating complex tumor boundaries. Extensive experiments on BraTS2018, BraTS2021, and BraTS-GLI from the BraTS2024 Challenge validate that MSK-Net consistently achieves state-of-the-art performance, outperforming over 20 existing methods. Furthermore, explainability analysis using Score-CAM highlights MSK-Net’s strong sufficiency and plausibility. These findings underscore the framework’s ability to balance accuracy, explainability, and efficiency, establishing MSK-Net as a promising tool for clinical brain tumor segmentation. Future large-scale clinical validation could further confirm its utility in supporting radiologists to improve diagnostic precision and patient outcomes. Codes will be made available at: https://github.com/kanglzu/msk_net.}
}
@article{HU2026116075,
title = {EvoCap: Enhancing video captioning via self-evolving video-LLMs with knowledge consolidation},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116075},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116075},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008014},
author = {Yangliu Hu and Minye Wu and Junqing Yu and Yiping Phoebe Chen and Wei Yang},
keywords = {Video captioning, Self-evolution, Knowledge consolidation, Video large language models},
abstract = {Video Large Language Models (Video-LLMs) have demonstrated strong performance on video understanding, yet their reliance on costly human supervision and susceptibility to hallucination hinder continual adaptation and reliability in dynamic real-world settings. In response, we present EvoCap, a fully automated framework that enables Video-LLMs to self-evolve and adapt to evolving data distributions and diverse video domains, without requiring external annotations. EvoCap operates in a closed loop: it generates captions, evaluates them through semantic consistency checks, and retrains the model with refined outputs, enabling knowledge consolidation from unlabeled videos. This self-supervised process progressively improves caption quality, scaling beyond the limitations of Supervised Fine-Tuning (SFT). Across multiple Video-LLMs, EvoCap delivers consistent gains, correcting failure cases unresolved by SFT and even outperforming on certain models. Analyses further reveal rapid early error correction, steady refinement of complex scenarios, and improvements in completeness and hallucination, establishing EvoCap as a practical paradigm for autonomous and scalable video captioning in real-world settings.}
}
@article{WEI2026116127,
title = {Less is more: Clustering with adaptive probability for heterogeneous federated learning},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116127},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116127},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008531},
author = {Yunan Wei and Shengnan Zhao and Chuan Zhao and Yiting Lin and Donglong Chen and Minghao Zhao},
keywords = {Federated learning, Cluster, Statistical heterogeneity, Adaptive probability, Privacy},
abstract = {Federated learning (FL) is a distributed machine learning paradigm that enables collaborative model training on decentralized data while preserving privacy. However, FL encounters challenges due to statistical heterogeneity from the varied data distributions across numerous clients, which can affect overall efficiency and performance. While existing cluster-based FL methods often concentrate on optimizing interactions between clients, neglecting substantial computational overhead and privacy risks due to static cluster management and intra-cluster information exchange. To overcome these issues, this paper proposes a novel framework, CAPFed, which employs an adaptive and privacy-preserving clustering strategy. The core idea is to perform clustering only during training phases characterized by high information entropy, where cluster adjustments yield the most significant impact on model optimization. Furthermore, CAPFed incorporates an identity anonymization protocol to safeguard against privacy leakage throughout the clustering process. Designed as a modular component, CAPFed can be integrated with various existing FL optimization algorithms to enhance their performance. Experimental results demonstrate that CAPFed reduces communication rounds by up to 6.7× while maintaining model performance.}
}
@article{YU2026116188,
title = {Fractional-quantum reinforcement learning differential evolution for large-scale edge computing offloading},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116188},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116188},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009147},
author = {Mingyang Yu and Jiaqi Zhang and Desheng Kong and Kairan Zhang and Shengwei Fu and Frank Jiang and Jing Xu},
keywords = {Edge computing, Differential evolution, Fractional-order modeling, Quantum-guided perturbation, Reinforcement learning},
abstract = {Task offloading optimization in edge computing is crucial for improving resource utilization and service efficiency in intelligent connected vehicles, the Internet of Things, and mobile computing applications. However, the corresponding optimization problems are often characterized by high dimensionality, multimodality, and complex constraints, all of which pose significant challenges for conventional differential evolution (DE) algorithms in terms of convergence accuracy and solution stability. This study proposes a novel DE algorithm, termed fractional-quantum reinforcement learning differential evolution (FQRDE), to address these issues. The proposed method integrates fractional-order modeling, quantum-guided perturbation, and reinforcement learning–based strategy adaptation to enhance search effectiveness in complex optimization landscapes. In particular, FQRDE incorporates a fractional-order enhanced quadratic interpolation mutation mechanism to improve local search accuracy, a quantum-guided perturbation mechanism to strengthen population diversity and global exploration, and a reinforcement learning–guided mutation strategy selection scheme to adaptively balance exploration and exploitation. The performance of FQRDE is evaluated on the CEC 2017 benchmark suite in 30- and 100-dimensional settings, as well as on edge-computing task offloading scenarios of different scales. Experimental results demonstrate that FQRDE delivers competitive performance relative to selected comparison algorithms within the allotted evaluation budget, with favorable convergence behavior and solution stability. In edge-computing task offloading experiments, the proposed method yields lower system cost, improved robustness, and higher convergence efficiency. Notably, in large-scale task scenarios, FQRDE achieves an average system cost reduction of > 58% and a fluctuation reduction of > 70%. These results indicate that FQRDE is an effective and practically applicable approach for edge-computing task offloading optimization.}
}
@article{PAN2026116240,
title = {Noise reweighted conditional diffusion with dual-domain dynamic conditioning and spatiotemporal causal denoising for robotic storage demonstration learning},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116240},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116240},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009664},
author = {Yunlong Pan and Tie Zhang and Ruibo Li},
keywords = {Household service robot, Diffusion model, Noise schedule, Conditional modulation, Spatiotemporal causal},
abstract = {Reliable generation of continuous actions from visual observations is crucial for household service robots to accomplish storage tasks. However, visual distractions in cluttered environments, long-term temporal dependencies in action trajectories, and uneven noise injection during diffusion often lead to unstable action generation, which weakens policy generalization. Accordingly, a conditional diffusion imitation learning approach for household service robot storage tasks is proposed in this paper. By introducing reweighted noise injection and dual-domain dynamic conditional modulation, and integrating a spatiotemporal causality-aware conditional denoising network, the method achieves stable generation and robust prediction of continuous action trajectories. Specifically, a noise reweighting strategy is adopted in the forward diffusion process to suppress excessive perturbations during critical action phases. In the reverse diffusion process, a coordinated time-domain and parameter-domain dynamic conditioning mechanism is designed to enhance the adaptive representation of multi-granularity conditional information across different temporal scales. On this basis, a local conditional encoding network is employed to extract multimodal conditional embeddings that guide action prediction during denoising. The proposed denoising network leverages a dual-branch serpentine spatiotemporal conditional residual architecture and a causal spatiotemporal bottleneck, which effectively capture temporal dependencies in action trajectories. Experimental results demonstrate that the proposed method achieves an action prediction score of 0.953 on the public Push-T benchmark and a 98.9% success rate on non-interference storage tasks in the Robot-Storage dataset. Compared with the baseline method, our approach accurately tracks objects undergoing sudden positional changes during execution and effectively handles disturbances caused by external obstacle intrusion and temporary camera-view occlusion.}
}
@article{CHEN2026116143,
title = {OptiSMR: A unified framework for structured reasoning and self-repairing multi-agent system optimized for generalization},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116143},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116143},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008695},
author = {Juan Chen and Huibin Wang and Lili Zhang},
keywords = {Automated modeling, Large language models, Optimization problems, AI agent, Reasoning},
abstract = {Optimization problems are ubiquitous across diverse domains; however, their formulation and solution have long relied heavily on expert knowledge. Although large language models show considerable potential for automating such tasks, their limited ability to handle heterogeneous problems, maintain reasoning robustness, and enable autonomous evolution constrains the realization of genuine optimization generalization. To address these challenges, this study proposes OptiSMR, a unified framework designed to advance optimization generalization. Given natural language problem descriptions, OptiSMR employs a prompt-supervised structured chain-of-thought to decompose problems and extract key components such as parameters, variables, objectives, and constraints. This process constructs a universal structured model capable of representing diverse classes of optimization problems. Building upon this foundation, OptiSMR incorporates a multi-agent collaborative architecture that enhances both accuracy and robustness through task specialization and closed-loop error handling. Furthermore, a graph-localized minimum hitting set repair method based on variable-constraint bipartite graphs reformulates error localization and correction as an interpretable optimization process, enabling precise and efficient automatic repair. Moreover, a semantic-guided self-verification mechanism is integrated to suppress the generation of false feasible solutions and to facilitate continuous experience accumulation and autonomous system evolution. Extensive experiments conducted on 6 real-world datasets covering 16 application domains, including resource scheduling, path planning, and manufacturing, demonstrate that OptiSMR can effectively model linear, nonlinear, and mixed-integer programming problems. The proposed framework achieves an average improvement of 8.3% in solution accuracy over an optimal baseline method.}
}
@article{OKUWOBI2026116208,
title = {Morphogenetic visual systems: Self-organizing perception for the open world},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116208},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116208},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009342},
author = {Idowu Paul Okuwobi and Jingyuan Liu},
keywords = {Open-world recognition, Morphogenesis, Topological data analysis, Sheaf cohomology, Reaction–diffusion systems, Embodied AI, Energetic cognition, Non-parametric memory, Continual learning, Edge intelligence},
abstract = {Conventional visual recognition systems are fundamentally constrained by a classification ontology: a static, closed-world assumption that all inputs belong to a pre-defined set of categories. This paradigm fails catastrophically in open-world settings, where novel entities (e.g., emerging species, unseen vehicle models) continuously arise, and where edge deployment demands dynamic adaptation to fluctuating computational resources. We propose Morphogenetic Visual Systems (MVS), a radical departure from classification-based AI: a self-organizing, embodied framework in which visual understanding emerges not from label assignment, but from continuous morphogenesis; the physics-driven, symmetry-breaking process by which form arises in biological development. At its core, MVS represents visual experience as a persistent topological field computed via sheaf-valued cohomology, where known concepts manifest as stable attractors and unknowns appear as topological defects, not errors, but generative seeds. When novelty is detected, a Morphogenetic Adaptation Engine (MAE), grounded in reaction–diffusion dynamics, autonomously expands the system’s representational capacity through controlled symmetry breaking, growing new stable modes without retraining or catastrophic forgetting. Crucially, MVS integrates hardware constraints via Embodied Energetic Budgeting (EEB): computational power modulates the epistemic ambition of the system, not via model compression, but by regulating morphogenetic activity across three regimes (growth, stabilization, resonance), ensuring robustness is preserved in kind, not degraded in degree. Knowledge is stored non-parametrically as a Causal Morpho-Memory (CMM), a sheaf of homotopy classes of field trajectories, enabling zero-shot inference via path-space alignment. Validated on open-world streaming benchmarks (CORe50-OW, iWildCam-Stream) and edge-constrained drone perception (UAV123-E), MVS achieves +12.8% open-set accuracy over state-of-the-art methods while maintaining 98.3% robustness under aggressive power throttling. More significantly, MVS establishes a new paradigm: visual intelligence as a dissipative, far-from-equilibrium process, where perception, learning, and adaptation are unified through the physics of form emergence. This work does not improve visual recognition; it proposed a new direction. The source code of the proposed MVS is at https://github.com/livingjesus/MVS.}
}
@article{MENG2026116111,
title = {3D adversarial objects generation for wider-view face recognition attacks},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116111},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116111},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008373},
author = {Lingzhuang Meng and Mingwen Shao and Yuanjian Qiao and Xiang Lv and Yecong Wan and Hang Su},
keywords = {3D adversarial object, 3D generation, Adversarial attacks, Gaussian splatting},
abstract = {Existing adversarial attack methods against face recognition extensively investigate the generation of 2D adversarial objects on single-view facial images to spoof face recognition systems. However, these approaches fail to attack when the facial viewpoint changes, limiting their effectiveness in 3D scenes. To overcome this limitation, we propose a novel 3D Adversarial Objects generation scheme (3DAO) to spoof face recognition across wider viewpoints. Specifically, 3DAO generates adversarial objects with precise structural representation and multi-view consistency by leveraging the explicit modeling capability of 3D Gaussian splatting, which consists of two core designs: Object Initialization and Object Optimization. The former identifies the most relevant Gaussians to the target object via a dedicated Gaussian localization strategy to accurately initialize the Gaussians of an adversarial object, thus avoiding the artifacts caused by redundant Gaussians. Subsequently, the latter optimizes the adversarial object utilizing the devised constraints, thereby achieving adversarial effectiveness while ensuring visual quality. Benefiting from the above elaborate designs, the generated adversarial objects not only successfully attack from multiple viewpoints but also maintain a natural appearance. Extensive experiments demonstrate that the 3D adversarial objects (e.g., glasses and masks) generated by our 3DAO outperform existing State-of-the-Art over a wider range of viewpoints and exhibit better concealment.}
}
@article{PARK2026116200,
title = {EfficientMedFormer: A directional decomposition approach for lightweight medical image classification},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116200},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116200},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009263},
author = {Seongchan Park and Jinbin Kim and Seunghyun Lee and Soonchul Kwon},
keywords = {Attention mechanism, Edge AI, Hybrid architecture, Lightweight, Medical image classification},
abstract = {Medical artificial intelligence is advancing rapidly and contributing significantly to the early detection and accurate diagnosis of diseases. Although medical image classification is crucial in this diagnostic process, its application in real-world clinical environments demands high accuracy and computational efficiency. To address these requirements, this paper proposes EfficientMedFormer, a novel lightweight hybrid architecture that integrates an anisotropic convolutional block based on the directional decomposition principle with a gated channel-wise anisotropic attention module within a progressive hierarchical structure, effectively fusing local and global features. In the early stages of the model, the anisotropic convolutional block decomposes standard convolutions into directional one-dimensional convolutions. This approach significantly reduces computational cost while maintaining a wide receptive field. Subsequently, in the later stages, the gated channel-wise anisotropic attention module enhances conventional channel attention by independently extracting and directly gating contextual information along the height and width directions. This mechanism dynamically reweights channel importance, effectively preserving spatial information and modeling global relationships. The proposed model achieves comparable or superior performance compared with widely used models in the medical domain across classification tasks on the MedMNIST v2, PAD-UFES-20, Kvasir, and Brain Tumor MRI datasets, achieving a maximum accuracy of 99%. Notably, EfficientMedFormer attains this top-tier performance with only 2.39M parameters and 0.28 GFLOPs, while demonstrating an inference latency of 74.6 ms on an Orange Pi 5B edge device These quantitative results underscore the high practicality and generalizability of the proposed model, thereby advancing the clinical applicability of medical artificial intelligence systems.}
}
@article{K2026116176,
title = {Task prioritization and distributed deep reinforcement learning for healthcare management in Cloud-Edge environments},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116176},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116176},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009020},
author = {Kumaran K and Saranya G and Siva priya {M S} and Vidhyalakshmi M},
keywords = {Cloud-edge environment, Distributed stacked deep reinforcement learning, Healthcare management, Reward function, Stacked convolutional neural network, Task offloading, Task prioritization},
abstract = {Task offloading-based healthcare management in a Cloud-Edge environment emerges as a transformative approach that dynamically distributes computational tasks between Internet of Things devices, edge servers, and centralized cloud infrastructures. In this research, a Task-Prioritized Distributed Stacked Deep Reinforcement Learning strategy is proposed for task offloading-based healthcare management in a Cloud-Edge Environment. The physiological data are gathered continuously from the Internet of Things-enabled medical devices in the device layer, which are transferred into the edge layer for the operations of preprocessing for enhancing the quality of the data. The Hybrid Temporal–Contextual Fusion module is implemented by incorporating the Transformer-based attention and Bidirectional Long Short-Term Memory networks to capture the temporal dependencies and contextual relationships in physiological signals. A Health Severity Index is analyzed for assessing the risk levels of the patient and allows dynamic task prioritization for monitoring the healthcare tasks based on the extracted features. An Uncertainty-Aware Priority-Driven Distributed Stacked Deep Reinforcement Learning model at the cloud layer resolves the decisions of optimal task offloading between the device, edge, and cloud resources. A Stacked Convolutional Neural Network is utilized for learning the system state’s compact representation, and the Q-values are evaluated for offloading actions. An uncertainty-aware learning mechanism and a multi-objective reward function are integrated for enhancing the reliability of the decision. The proposed technique is compared to previous mechanisms, attaining a minimum Latency of 170 ms, and a higher resource utilization rate of 84 % conforming that the proposed approach substantially enhances energy efficiency and overall performance in task offloading-based healthcare management within Cloud-Edge environments.}
}
@article{ZHANG2026116192,
title = {BiLPCL: Bidirectional sparse interaction and label-aware prototype contrastive learning framework for multimodal emotion recognition},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116192},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116192},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009184},
author = {Wanjie Zhang and Yajun Du and Hongyang Wang and Xianyong Li and Yanli Lee},
keywords = {Multimodal emotion recognition, Bidirectional cross-modal interaction, Sparse multi-head attention mechanism, Label-aware prototype contrastive learning},
abstract = {Social media users typically express emotions and perspectives through multimodal content, including text and images. Consequently, the effective integration of information across diverse modalities remains a critical challenge in multimodal emotion recognition. Although most existing methods rely on cross-modal interaction to enhance multimodal fusion, they frequently overlook disparities in information density between modalities. Such oversights obscure salient emotional cues and render models susceptible to interference from redundant data. Furthermore, current methods primarily emphasize sample-level representation learning and lack robust modeling of shared category-level emotional semantics for analogous samples, thereby constraining recognition performance. To mitigate these challenges, the BiLPCL framework — based on bidirectional sparse interaction and label-aware prototype contrastive learning — is proposed. The primary objective is to improve both key information extraction and category-level emotional structure modeling during cross-modal recognition. Specifically, a bidirectional sparse attention channel is designed to focus selectively on salient cross-modal semantic features while suppressing redundant information by integrating bidirectional interaction with a sparse multi-head attention mechanism. Subsequently, a joint attention module is introduced to dynamically weight information post-interaction, further coordinating the contributions of distinct interaction features to emotion classification. To capture consistent emotional relationships between samples and categories, a label-aware prototype contrastive learning (LPCL) module is constructed. This module learns a prototype representation for each emotion category and utilizes the similarity between samples and category prototypes to constrain representation learning, thereby enhancing intra-class compactness and inter-class separability. Experiments were conducted on three publicly available datasets of varying scales. Results indicated that BiLPCL improved accuracy and F1-score by more than 1.8% relative to leading baseline methods. Specifically, F1-scores on the MVSA, TumEmo, and HFM datasets improved by 2.26%, 1.99%, and 3.68%, respectively.}
}
@article{LI2026116155,
title = {JCLDE: Hierarchical multi-label text classification via text–label joint contrastive learning and label-differentiation enhancement},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116155},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116155},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008816},
author = {Guangzhi Li and Kun Ma and Yinghong Hao and Ke Ji and Zhenxiang Chen and Bo Yang and Ajith Abraham},
keywords = {Hierarchical multi-label text classification, Contrastive learning, Label enhancement, Label balance},
abstract = {Hierarchical multi-label text classification (HMTC) is a sub-task of multi-label text classification, where labels are organized in a hierarchical structure. Recent approaches to HMTC leverage textual features and label hierarchies by contrastive learning to bring text and label embeddings closer together. However, generating positive samples that align with both text semantics and the hierarchical label structure remains a significant challenge due to the complexity of the hierarchy. In addition, HMTC commonly suffers from label distribution imbalance. To address these challenges, we propose a text–label joint contrastive learning and label-differentiation enhancement model (JCLDE). Specifically, JCLDE simultaneously leverages textual semantics and label hierarchies by implementing semantic-based text contrastive learning and hierarchy relations label contrastive learning. To mitigate label imbalance, we enhance label embeddings using both high-frequency co-occurrence label information and historical label information. JCLDE is evaluated on three public HMTC datasets, which demonstrates its effectiveness. Our source code is available at https://github.com/makunjida/JCLDE.}
}
@article{ANANDARAO2026116058,
title = {Optimized vision transformer with bidirectional gated recurrent unit for explainable alzheimer disease classification system},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116058},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116058},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007847},
author = {Sarvani Anandarao and Nagaraju Devarakonda and Raviteja Kamarajugadda and Raja Sekhar Krovi},
keywords = {Alzheimer’s disease, Vision transformer, Bidirectional gated recurrent unit, Magnetic resonance imaging, Image resizing, Adaptive filter},
abstract = {Alzheimer's disease (AD) is one of the most common forms of dementia worldwide. As the condition worsens, it makes it harder for a person to do daily chores independently. The most common illness, Alzheimer's, begins slowly with modest cognitive impairment and may eventually lead to loss of environmental awareness and communication. For clinical intervention to be successful, AD must be diagnosed accurately and promptly. Even seasoned radiologists may find it difficult to interpret AD from medical imaging. In order to effectively and consistently identify AD traits from Magnetic Resonance Imaging (MRI) images, this study proposes a framework called ViT-BiGRU, which combines a Vision Transformer (ViT) with a Bidirectional Gated Recurrent Unit (BiGRU). Initially, the input MRI is pre-processed using image rescanning, and filtering is done using an Adaptive Gaussian Filter. The Red, Green, and Blue (RGB) Grayscale produces accurate classification results. The pre-processed image is subjected to ViT-BiGRU for classifying output as AD, Cognitively Normal (CN), Early MCI (EMCI), and Late MCI (LMCI). Hyperparameters that tune the ViT-BiGRU model use Guided Remora Optimization (GRO) to increase the training speed. The ADNI dataset is also used in this method. The performance metrics are accuracy, precision, recall, specificity, kappa, f1 score, RMSE, MSE, MAE, and MCC, which attain high performance. The accuracy of the proposed method is 99.45% compared to the existing model, and the error rate is low compared to the existing method. Also, the proposed approach provided insights into disease identification by utilizing Grad-CAM and Grad-CAM++ to provide visual explanations.}
}
@article{IMAM2026116126,
title = {DAMM: Dynamic modality Aware weighted embeddings fusion for Multimodal Meme detection},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116126},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116126},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600852X},
author = {Mohsin Imam and Utathya Aich and Ram Sarkar},
keywords = {Meme categorization, Hateful meme, Multimodal data, Information fusion, Deep learning},
abstract = {The rapid growth of multimodal content on social media has facilitated the dissemination of hateful memes, where harmful intent is often expressed implicitly through nuanced interactions between visual and textual cues. Detecting such content remains challenging due to weak, asymmetric, or misleading correlations between modalities, which frequently limit the effectiveness of conventional static fusion strategies. In this work, we propose DAMM (Dynamic Modality-Aware Weighted Embedding Fusion), a novel multimodal framework that explicitly models both intra-modal and inter-modal dependencies for robust hateful meme detection. DAMM introduces two complementary modules: DeepVisionMixer (DVM), which dynamically integrates heterogeneous visual representations derived from Convolutional Neural Network (CNN) and Contrastive Language-Image Pre-training (CLIP) based encoders, and CrossEmbeddingMixer (CEM), which performs context-aware cross-modal fusion between visual and textual embeddings through adaptive weighting and sequential refinement. Unlike standard early or late fusion approaches, DAMM learns modality relevance conditioned on semantic context, enabling effective handling of weakly aligned or individually benign modalities. We have evaluated DAMM on four established benchmark datasets MAMI, MultiOFF, Memotion-3, and Misogynistic MEME covering both binary and multi-class hate-related tasks. The proposed model achieves macro F1-scores of 0.83 on MAMI, 0.66 on MultiOFF, 0.36 on Memotion-3, and 0.92 on Misogynistic MEME, consistently outperforming strong multimodal baselines. Ablation studies further demonstrate that dynamic modality-aware fusion plays a significant role to enhance the performance, while modality importance analysis provides interpretable insights into cross-modal decision making. The source code of this work is available at https://github.com/Utathyaworks/DAMM.}
}
@article{YANG2026116139,
title = {Evidence-consistent learning for multimodal stroke lesion segmentation},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116139},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116139},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008658},
author = {Qianhui Yang and Jun Wang and Juncheng Li and Zhong Xue and Jun Shi},
keywords = {Medical image segmentation, Multimodal fusion, Evidence-consistent learning},
abstract = {Stroke is a leading cause of mortality and disability worldwide, and accurate lesion segmentation serves as a pivotal cornerstone in the diagnostic and therapeutic processes. While multimodal imaging provides complementary information on stroke lesions, existing multimodal segmentation approaches often fail to address semantic inconsistencies across different modalities, leading to unreliable segmentation results. To address this limitation, we propose an Evidence-Consistent Segmentation Network (ECSN) for multimodal stroke lesion segmentation. Our framework leverages evidential deep learning to model pixel-level opinions, and introduces a novel multimodal opinions fusion mechanism to dynamically fuse the multimodal opinions at the pixel level. To mitigate the inconsistent evidence between modalities, a novel uncertainty-aware evidence-consistent learning mechanism is proposed by quantifying inter-modality inconsistencies based on differences and reliability between opinions. Extensive experiments on three public datasets demonstrate that ECSN achieves state-of-the-art performance compared to existing multimodal segmentation methods. Our code is available at https://github.com/skylight1024/ECSN.}
}
@article{ZHANG2026116115,
title = {Knowledge-injected prompt tuning with semantic regularization for fine-grained image recognition},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116115},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116115},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008415},
author = {Qinyu Zhang and Xinda Liu and Qi Liu and Pengbo Zhou and Guohua Geng},
keywords = {Fine-grained image recognition, Prompt tuning, Vision-language models, Few-shot learning, Knowledge-injected},
abstract = {Fine-grained image recognition requires models to precisely represent subtle but discriminative local semantic attributes that distinguish visually similar categories. Recent advances in vision-language models demonstrate strong semantic representation capabilities, yet their performance heavily relies on the effectiveness of prompt tuning strategies. However, current prompt tuning methods typically represent each category using a single, globally uniform semantic prompt, which inevitably overlooks the diverse and fine-grained attributes essential for accurately distinguishing visually similar categories. To this end, we propose Knowledge-Injected Prompt Tuning with Semantic Regularization (KIP), a method that injects fine-grained knowledge into prompts to explicitly encode and preserve diverse semantic attributes within the prompt embedding space. Specifically, KIP employs an independent encoding strategy to distinctly represent multiple fine-grained semantic descriptions derived from Large Language Models (LLMs). Moreover, to address the semantic inconsistency caused by hallucinations in LLMs, we introduce a novel semantic regularization mechanism based on Sinkhorn divergence. Extensive experiments across 11 widely used fine-grained image benchmarks demonstrate that KIP significantly enhances performance in cross-dataset transfer, base-to-novel generalization, and few-shot learning tasks. Notably, it achieves substantial improvements in the harmonic mean metric, highlighting its effectiveness and versatility when integrated with existing prompt tuning frameworks. The source code will be released publicly upon acceptance.}
}
@article{YERRAGUNTA2026116167,
title = {Dynamic conditional gating mechanisms for Question Answering over incomplete Knowledge Bases},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116167},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116167},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008932},
author = {Sudarshan Yerragunta and Subu Kandaswamy and Rajendra Prasath},
keywords = {Knowledge-based question answering, Incomplete knowledge base, Subgraph reader, Knowledge aware text reader, Conditional gating mechanisms},
abstract = {Open-domain Question Answering (QA) systems draw answers from knowledge sources that could be either a Knowledge Base (KB) or a text corpus or a combination of KB and Text. Knowledge-Based Question Answering (KBQA) systems retrieve answers for a given question from structured knowledge bases. These Knowledge Bases are created from the data in entities and relation pairs. But most of the Knowledge Bases are insufficient due to the lack of coverage of necessary information and are often incomplete. Text corpora may have necessary information but the curated data from text corpora suffers in quality. In hybrid QA systems, the main focus is on setting up corpora by augmenting large text corpora with an incomplete KB. In this paper, we propose two approaches, namely, SGKA-IKS, ISGKA, and a Controlled integration analysis ISGKA-IKS for KBQA systems. The first approach SGKA-IKS uses the improved Knowledge Base with the enriched relation structure by removing irrelevant facts. In the Second approach ISGKA, we introduce an Improved Dynamic Conditional Gating (IDCG) mechanism that accumulates the evidence (information) for knowledge entities; reformulates the question using text corpora and aggregates the evidence from KB and text corpora to predict answers. Finally, a hybrid approach ISGKA-IKS as a combination of ISGKA with Improved Knowledge Sources. The experiments conducted on benchmark datasets, namely, WebQuestionsSP and WikiMovies-10k show that the proposed KBQA models with Improved Knowledge Sources and/or IDCGs, achieve significant improvements over the existing state-of-the-art models across different proportions of incomplete KBs.}
}
@article{DUTT2026116228,
title = {Weighted partition-based clustering for mixed-type data with dynamic categorical weighting},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116228},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116228},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009548},
author = {Ashish Dutt and Zeeshan Ali},
keywords = {Mixed-type data, Weighted clustering, Categorical weighting, Data association, Information-theoretic clustering},
abstract = {Building upon the ClicoT algorithm’s concept hierarchy approach for mixed-type data clustering, we propose WP-ClicoT (Weighted Partition ClicoT), a novel weighted partition-based algorithm that dynamically assigns and calculates weights for categorical data types while establishing quantifiable associations between continuous and categorical attributes. This graduated weighting represents a fundamental shift from binary decisions to continuous relevance modeling, enabling a more nuanced representation of categorical attribute importance across clusters. Unlike ClicoT’s binary specific/non-specific element selection, WP-ClicoT introduces a continuous weighting scheme that captures varying degrees of relevance for categorical attributes. Our approach employs mutual information-based weight calculation for categorical features and introduces a novel association metric that bridges the gap between heterogeneous data types. Through a partition-based framework with adaptive weight refinement, WP-ClicoT achieves superior clustering performance while maintaining interpretability. Extensive experiments on synthetic and real-world datasets demonstrate that WP-ClicoT outperforms ClicoT and other state-of-the-art algorithms, with NMI improvements of up to 18% on datasets with complex categorical structures. We also provide comprehensive comparisons with deep learning-based approaches and demonstrate competitive performance with superior interpretability compared to existing methods.}
}
@article{HATEM2026116108,
title = {Triple Play: A framework for enhanced question answering reasoning with KG, LLM, and RAG},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116108},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116108},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008348},
author = {Shahenda Hatem and Ghada Khoriba and Mohamed H. Gad-Elrab and Mohamed ElHelw},
keywords = {Question answering, Large language models reasoning, Dynamic knowledge graph reasoning, Retreival augmented generation},
abstract = {Large language models (LLMs) have demonstrated strong reasoning capabilities but often struggle with hallucination and outdated information when disconnected from trusted external knowledge. To address the hallucination problem, recent research has explored the integration of LLMs with knowledge graphs (KGs). KGs provide trusted, structured, and explainable factual knowledge, thereby offering reliable grounding for LLM outputs. However, most existing methods assume complete KGs, where all factual triples required to answer a query are present. In practice, even the widely used KGs such as Wikidata and DBpedia are incomplete or outdated. Hence, we propose Triple Play, a training-free framework for question answering over incomplete KGs (IKGQA). Triple Play combines LLM reasoning with retrieval-augmented generation (RAG) to identify missing or outdated triples and generate accurate replacements from external sources. The framework follows a structured process that integrates symbolic knowledge, real-time retrieval, and self-evaluating LLM prompts for dynamic KG refinement. We evaluated Triple Play on two datasets: WebQSP and CWQ, under varying KG incompleteness levels (20%–80%). Results on WebQSP showed that Triple Play consistently outperformed strong baselines, including generate-on-graph (GoG) and think-on-graph (ToG). For example, at 40% incompleteness, it achieved Hits@1 of 75.18%, compared with 66.6% (GoG) and 61.4% (ToG). Even under 80% incompleteness, it maintained robust performance (66.73%), while baselines degraded considerably. On CWQ, Triple Play maintained high performance across different incompleteness levels, achieving Hits@1 of 71.85% at 40% incompleteness, exceeding GoG (62.3%) and ToG (58.2%), and reaching 64.91% at 80% incompleteness, outperforming GoG (51.4%) and ToG (48.7%). These results demonstrated the effectiveness of integrating LLMs and RAG for real-time KG validation and evolution under missing knowledge. Implementation is available at GitHub Repository.}
}
@article{YANG2026116160,
title = {DCM: Robust out-of-distribution detection via Deep Class Medoids},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116160},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116160},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008865},
author = {Jiahuang Yang and Zhengchun Zhou and Zhiguo Long and Hua Meng},
keywords = {Out-of-distribution detection, K-medoids clustering, Post-hoc methods},
abstract = {Post-hoc out-of-distribution (OOD) detection is critical for deploying deep models in open-world scenarios. However, existing post-hoc methods for OOD detection suffer from limited generalization across different model architectures due to their reliance on architecture-specific assumptions or parametric distribution features. To address this challenge, we propose Deep Class Medoids (DCM), a non-parametric and architecture-agnostic framework that models each in-distribution (ID) class manifold using a compact set of representative medoids in a normalized feature space. This design captures both global distributional structure and local geometric variations, thereby mitigating discrepancies across diverse architectures and enabling stable distance-based scoring. Building on this foundation, we further introduce DCM-Guide (DCMG), which synergistically integrates DCM’s geometric score with classifier confidence, leading to improved detection of challenging near-OOD samples. Extensive experiments on ImageNet-1K demonstrate that DCMG achieves consistent gains across six models (three CNNs and three ViTs), improving AUROC by 1.29% and reducing FPR95 by 6.72% compared to strong baselines.}
}
@article{XIE2026116136,
title = {CCSD: Cross-Modal Compositional Self-Distillation for robust brain tumor segmentation with missing modalities},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116136},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116136},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008622},
author = {Dongqing Xie and Yonghuang Wu and Zisheng Ai and Jun Min and Zhencun Jiang and Shaojin Geng and Lei Wang},
keywords = {Multi-modal MRI, Missing modality, Cross-modal self-distillation},
abstract = {The accurate segmentation of brain tumors from multi-modal MRI is critical for clinical diagnosis and treatment planning. While integrating complementary information from various MRI sequences is a common practice, the frequent absence of one or more modalities in real-world clinical settings poses a significant challenge, severely compromising the performance and generalizability of deep learning-based segmentation models. To address this challenge, we propose a novel Cross-Modal Compositional Self-Distillation (CCSD) framework that can flexibly handle arbitrary combinations of input modalities. CCSD adopts a shared-specific encoder–decoder architecture and incorporates two self-distillation strategies: (i) a hierarchical modality self-distillation mechanism that transfers knowledge across modality hierarchies to reduce semantic discrepancies, and (ii) a progressive modality combination distillation approach that enhances robustness to missing modalities by simulating gradual modality dropout during training. Extensive experiments on public brain tumor segmentation benchmarks demonstrate that CCSD achieves state-of-the-art performance across various missing-modality scenarios, with strong generalization and stability.}
}
@article{MORCHID2026116249,
title = {Early fire detection using embedded and deep learning technologies to improve sustainable agriculture and food security},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116249},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116249},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009755},
author = {Abdennabi Morchid and Abdennacer Elbasri and Abdullah Alwabli and Amar Y. Jaffar and Fahad Albalawi},
keywords = {Smart agriculture, Machine learning, Deep learning, Early fire detection, Embedded systems, Food security, Sustainability},
abstract = {Early fire detection is crucial for smart agriculture, where the protection of crops and infrastructure relies on rapid, accurate, and continuous monitoring systems. Recent advances in artificial intelligence (AI) and embedded technologies enable the development of autonomous solutions capable of effectively identifying fire risks on farms. This study aims to develop and evaluate an innovative fire detection system that integrates AI and embedded devices to provide reliable, cost-effective, and real-time monitoring tailored to smart farming environments. Further, the system is based on a five-layer functional architecture. The perception layer collects data via flame and smoke sensors connected to a Raspberry Pi 3 Model B+ via an MCP23008 expander. The data is then calibrated, filtered, and normalized. The AI layer uses machine learning models (Random Forest, logistic regression) and deep learning models (MLP, LSTM) to classify fire risk. The decision layer triggers an alert as soon as a risk is identified, and the validation layer evaluates performance via k-fold and stratified tests, using metrics such as accuracy, recall, and F1-score. Real-world experiments enabled the definition of optimal thresholds and confirmed the system’s robustness. The Random Forest achieved the best performance with an average accuracy of 0.99 ± 0.02, outperforming the MLP (0.76) and the LSTM (0.79; F1-score = 0.62). The combined integration of ML and DL approaches improves the system’s reliability and stability, demonstrating the feasibility of a cost-effective, real-time, embedded solution for agricultural fire detection. This approach offers an effective, reproducible, and sustainable solution for fire prevention in smart agriculture. The combination of advanced AI and low-cost embedded systems paves the way for autonomous, accessible, and resilient solutions to address the growing risks associated with climate change.}
}
@article{XIE2026116100,
title = {Shortening the prefix! Members and non-members exhibit divergent behavior},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116100},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116100},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008269},
author = {Linyun Xie and Jiguo Yu and Hongliang Zhang and Fenghua Xu and Chunqiang Hu},
keywords = {Large language models, Membership inference attacks, Machine learning, Model security and privacy},
abstract = {Membership inference attacks (MIAs) compromise model privacy by determining whether a given sample belongs to the training dataset of a target model. Current membership inference attacks primarily operate by exploiting the outputs of the target model (reference-free MIAs) or by comparing the outputs of the target model and the reference model (reference-based MIAs). Although reference-based MIAs typically achieve higher attack performance, such methods generally require access to a dataset with a distribution similar to that of the target model’s training set, which is often infeasible in practical scenarios. Furthermore, fine-tuning the reference model requires additional computational resources. This paper proposes a Shortened Prefixes-based Weighted Membership Inference Attack (SPW-MIA). Driven by our consideration of memorization in large language models (LLMs), we propose a method that dynamically shortens the initial prefix of tokens and compares the target model’s prediction differences for the corresponding tokens under the initial prefix and the shortened prefix, thereby assigning weights to the tokens. Furthermore, based on intuition, we incorporate the difference between the probabilities of the tokens greedily generated by the target model and the probabilities of the tokens in the sample into the final judgment. Similar to other MIAs, our attack requires access to the target model’s outputs but operates without the reference model. We evaluate our method on multiple LLMs fine-tuned on different datasets as well as on several pre-trained LLMs, and compare it with several reference-free MIAs. The results demonstrate that our method achieves significant attack performance.}
}
@article{CHEN2026116225,
title = {HAM-VAE: A hierarchical adaptive modulation VAE for data augmentation in fake review detection},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116225},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116225},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009512},
author = {Jindong Chen and Tian Zhang and Zhihua Yan and Zhichao Zheng and Wen Zhang},
keywords = {Fake review detection, Data augmentation, Hierarchical adaptive modulation, Variational autoencoder},
abstract = {Class imbalance decreases the performance of fake review detection, and data augmentation is a crucial strategy to address this issue. Variational autoencoders automatically learn data representations and generate diverse samples, which is particularly suitable for fake review generation; however, they often suffer from the KL divergence vanishing problem when using transformer-based decoders. Hence, we propose a text data augmentation method, namely the hierarchical adaptive modulation variational autoencoder (HAM-VAE), which integrates hierarchical latent variable fusion and adaptive modulation mechanism. By adopting the pretrained RoBERTa model as the encoder and the pretrained GPT-2 model as the decoder, alongside hierarchical adaptive modulation, HAM-VAE generates high-quality and diverse augmented text. The resultant balanced fake review dataset is converted into word embeddings using a pretrained Word2Vec model, and these embeddings are then utilized by several models for fake review detection, including LR, SVM, XGBoost, Bi-LSTM, and BERT. Experimental results demonstrate that by strengthening the interactions between the latent variables extracted by the encoder and the different layers of the decoder, HAM-VAE alleviates the KL vanishing problem, effectively captures latent variable features, and improves the quality and diversity of the generated text. Specifically, HAM-VAE achieves a perplexity score of 23.41 and a BLEU-4 score of 3.81 %, significantly outperforming baseline models. Furthermore, in terms of accuracy, precision and F1 score, the performances of the fake review detection methods are enhanced upon data augmentation via HAM-VAE, with the BERT classifier achieving the best F1 score of 83.48 %.}
}
@article{WANG2026116128,
title = {A category-theoretic approach to causal equivalence: Mapping directed acyclic graphs to undirected prime graphs},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116128},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116128},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008543},
author = {Chao Wang and Weiwei Fu and Yang Zhou},
keywords = {Category theory, Causal inference, Explainability, Prime graphs, Visual grounding},
abstract = {Advancements in artificial intelligence (AI) have increasingly highlighted the value of integrating AI with mathematically principled theories. Recent studies suggest that category theory, as a language of abstraction, compositionality, and structure-preserving transformation, may provide useful perspectives for graph-based AI research. Causality naturally arises in various real-world scenarios, prevalent across both the natural sciences and engineering, and is often modeled as directed graphs. However, for analytical and computational convenience, much research on graph properties tends to focus on undirected graphs. Bridging the gap between directed and undirected graphs has thus become a critical area of study. In this paper, we investigate how category-theoretic ideas can be used to construct a structural correspondence between causal graphs and undirected prime graphs. Building on the equivalence between directed acyclic graphs and prime graphs, we establish a representation-level bridge that preserves directed information through prime labeling. On this basis, we introduce a path-based surrogate analysis mechanism on prime graphs for characterizing directed influence. We emphasize that this mechanism is intended as a representation-level surrogate rather than a replacement for standard causal identification on directed acyclic graphs. Furthermore, this surrogate perspective motivates a bias-aware design principle for model optimization. We instantiate this idea through sample reorganization and a sample-reorganization-based attention module, termed SRDP-ATT. Experimental results on visual grounding show consistent gains on challenging benchmarks, providing proof-of-concept empirical evidence that is consistent with the proposed design intuition.}
}
@article{RAIPAL2026116241,
title = {GlaucomaGuide: A Retrieval Augmented Generation — Enhanced medical chatbot for patient support in glaucoma management},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116241},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116241},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009676},
author = {Siddharth Raipal and Anita Penkova},
keywords = {Glaucoma, Conversational AI, RAG, Patient education, Chatbot, LLM},
abstract = {GlaucomaGuide is a conversational medical chatbot designed to enhance patient support in glaucoma management through a domain-specific Retrieval-Augmented Generation (RAG) architecture. Existing general-purpose models often fail to address the nuanced, context-dependent nature of specialized medical inquiries. Our system overcomes these limitations through a multi-turn, intent-driven dialogue manager that gathers patient-specific context before delivering a precise, personalized response grounded in a curated, authoritative knowledge base. Our methodology introduces a conversational RAG architecture featuring a multi-stage, trust-aware retrieval pipeline that incorporates source authority, and a bidirectional terminology translation mechanism to bridge the vocabulary gap between patients and clinicians. The system uses a dynamic dialogue manager to ask clarifying follow-up questions, creating an enhanced, context-rich query that enables safer and more relevant information retrieval. A comprehensive two-part evaluation demonstrated the system’s effectiveness. In a single-turn comparison, GlaucomaGuide achieved a overall score of 2.89 (SD=0.31), significantly outperforming baseline models like ChatGPT-4 (2.53) and Gemini(2.70). More critically, in a multi-turn, task-based evaluation designed to test the system’s core novelty, it successfully resolved 75% of complex patient scenarios that require contextual dialogue. An error analysis of the failures identified key limitations in current dynamic dialogue strategies, providing a clear direction for future work. These findings validate the superiority of domain-specific, conversational RAG architectures for specialized medical support. By integrating a trust-aware retrieval process with a context-gathering dialogue system, GlaucomaGuide provides more reliable, accurate, and personalized information than general-purpose models, establishing a strong foundation for the future of patient education in chronic disease management.}
}
@article{JOEL2026116123,
title = {A potent framework for privacy-preserving recommendations using federated learning},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116123},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116123},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600849X},
author = {M. Robinson Joel and M. Navaneethakrishnan and R. Selvi and E. Munuswamy},
keywords = {Federated Learning (FL), Privacy-preserving recommendations, Shepard Convolutional Neural Network (ShCNN), Kumar Hassebrook, Kulczynski similarity},
abstract = {Privacy-preserving recommender systems are intended for delivering feature of personalized content without any compromise of user privacy. The personal information gathered through recommenders increases the threat of unnecessary revelation of that information. To overcome this issue, a Federated Learning-based Shepard Convolutional Neural Network is introduced for privacy-preserving recommendations. Federated learning (FL) operates through a decentralized architecture consisting of client nodes and a central aggregation server. Local training is first carried out on individual datasets, after which the learned parameters are communicated to the central server. Afterward, aggregation of the modules is carried out at the server. Then, using the downloaded data, the global model updates the training module, and this process is iterated for each epoch. The following steps outline the procedure executed in the training module. Firstly, the computation of the accretion matrix is determined. After that, the grouping of directories is executed by employing Bayesian Fuzzy Clustering (BFC). Here, the matching among the query as well as the group is executed based on Kumar Hassebrook and Kulczynski similarity metrics. Finally, personalized web directories recommendation is suggested utilizing the Shepard Convolutional Neural Network (ShCNN). The Averaging scheme is employed to refine both local updates and server aggregation. Additionally, designed FL_ShCNN acquired an accuracy of 0.907, a loss function of 0.093, Mean square error (MSE) of 0.023, Root mean square error (RMSE) of 0.158, False positive rate (FPR) of 0.086, as well as mean average precision (MAP) of 0.926.}
}
@article{ALFAYAN2026116212,
title = {A multi-objective multi-constraint explainable AI-based approach for smart energy grid systems},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116212},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116212},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600938X},
author = {Mahmoud Alfayan and Hani Hagras},
keywords = {Type-2 fuzzy systems, Explainable AI, Smart grid energy systems},
abstract = {As the global shift toward sustainable energy accelerates, modern electrical grids are increasingly incorporating renewable sources like wind and solar PV. Moving from traditional centralized power to decentralized smart grids demands better optimization and forecasting methods to ensure reliability and efficiency. The inclusion of renewables, energy storage solutions, and bidirectional energy exchanges boosts the flexibility of smart grids and supports sustainable energy practices. Successfully planning and managing hybrid renewable energy systems (HRES) requires accurate and clear forecasting methods in conjunction with robust optimization strategies. In this paper, we present a two-stage Multi-Objective Multi- Constraint Evolutionary computing based on a Genetic Algorithm and Non-dominated Sorting Genetic Algorithm III (GA-NSGA-III) optimization, which enables the procurement of renewable energy sources while concurrently minimizing the Levelized Cost of Energy (LCOE) and the Expected Energy Not Supplied (ENS). We have performed various experiments with real-world data in which, for cost-optimal configurations, NSGA-III decreases LCOE by 26.1% and worst-year ENS by 58.7% relative to NSGA-II. At balanced design, the ENS decreases by 72.7%, and the LCOE falls by 16.3%. This proposed system promotes the utilization of renewable energy sources while also enhancing the efficiency of storage. To enhance the design of hybrid renewable energy systems under uncertain conditions, the proposed method integrates multi-objective optimization, absence-aware reliability modeling, and interpretable load forecasting. These results support more consistent operation and simplify decision-making across multi-year planning horizons. Load forecasting is provided using an Explainable Artificial Intelligence (XAI)-based Interval Type-2 Fuzzy Logic System (IT2FLS). Compared to Type-1 FLS, IT2FLS decreases RMSE by 48.6% and mean absolute error by 50.2% and gains R² from 0.625 to 0.901. These findings show that advanced XAI based multi-objective optimization improves system reliability and resilience.}
}
@article{LUO2026116096,
title = {Deep multi-view clustering via structure preserving learning},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116096},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116096},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008221},
author = {Yixuan Luo and Wenming Ma and Xiaolin Du and Qian Xu and Jinghui Zhang and Zhendong Cui and Xiaoyan Dai and Hongwei Jiang},
keywords = {Deep multi-view clustering, Graph neural network, Contrastive learning, Structure preserving, Deep learning},
abstract = {Deep multi-view clustering has attracted considerable attention due to its ability to effectively integrate multi-view information and enhance clustering performance. First, representation learning usually relies solely on clustering pseudo-labels while overlooking the maintenance of local neighborhood relations. Second, samples from the same cluster across different views are often insufficiently aligned. Finally, during the fusion process, most approaches only adopt view-level weight allocation and fail to capture sample-level differences. To mitigate these issues, we introduce a method called deep multi-view clustering via structure preserving learning(SPLMVC). Specifically, we design an inner-view structure preserved embedding learning mechanism, which simultaneously ensures the preservation of global cluster structures and the consistency of local neighborhoods. In addition, we introduce a cross-view structure alignment learning mechanism, thereby obtaining more robust and discriminative clustering representations. Finally, we develop a sample-level adaptive weighted fusion strategy that dynamically assigns learnable weights to each sample across different views for fine-grained feature integration. Extensive experiments on multiple public datasets demonstrate the effectiveness and superiority of our method. The code of this paper is available at https://github.com/mwmytu/SPLMVC.}
}
@article{CSUZDI2026116209,
title = {Physics-informed neural particle flow for the Bayesian update step},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116209},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116209},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009354},
author = {Domonkos Csuzdi and Tamás Bécsi and Olivér Törő},
keywords = {Particle flow, Physics-informed learning, Bayesian update, Amortized inference, Log-homotopy},
abstract = {The Bayesian update step poses significant computational challenges in high-dimensional nonlinear estimation. While log-homotopy particle flow filters offer an alternative to stochastic sampling, existing formulations usually yield stiff differential equations. Conversely, existing deep learning approximations typically treat the update as a black-box task or rely on asymptotic relaxation, neglecting the exact geometric structure of the finite-horizon probability transport. In this work, we propose a physics-informed neural particle flow, which is an amortized inference framework. To construct the flow, we couple the log-homotopy trajectory of the prior to posterior density function with the continuity equation describing the density evolution. This derivation yields a governing partial differential equation (PDE), referred to as the master PDE. By embedding this PDE as a physical constraint into the loss function, we train a neural network to approximate the transport velocity field. This approach enables purely unsupervised training, eliminating the need for ground-truth posterior samples. We demonstrate that the neural parameterization acts as an implicit regularizer, mitigating the numerical stiffness inherent to analytic flows and reducing online computational complexity. Experimental validation on multimodal benchmarks and a challenging nonlinear scenario confirms better mode coverage and robustness compared to state-of-the-art baselines.}
}
@article{LI2026116185,
title = {Physics-aware real-time estimation of multi-class travel time variability based on multi-source traffic data},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116185},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116185},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009111},
author = {Ang Li and Cheng Zhang},
keywords = {Travel time reliability, Multi-class travel time, Uncertainty quantification, Extended Kalman filter, Travel time prediction},
abstract = {Accurate and reliable estimation of path travel time is crucial for intelligent transportation systems. However, existing methods predominantly focus on aggregated traffic flows, overlooking the significant heterogeneity among different vehicle classes (e.g., private cars vs. goods vehicles) and often failing to provide reliable uncertainty quantification under dynamic traffic conditions. To address these gaps, this paper proposes a novel hybrid Bayesian framework that integrates a non-linear extended Kalman filter (EKF) with long short-term memory (LSTM) networks for real-time estimation of multi-class path travel time variability. The framework explicitly models the stochastic interdependencies between vehicle classes and fuses heterogeneous data from automatic vehicle identification (AVI), global positioning system (GPS), and point sensors. A key innovation is the data-driven uncertainty module, which adaptively learns time-varying process and observation noise covariances, allowing the model to dynamically adjust to changing traffic states. The proposed model is validated using real-world multi-source data from a major expressway in Hong Kong. The results demonstrate superior performance over state-of-the-art statistical and deep learning baselines. It is also shown that the proposed model not only achieves high accuracy in point estimation but also generates robust confidence intervals with a prediction interval coverage probability (PICP) exceeding 95%, even under congested conditions. Furthermore, the study reveals strong dynamic correlations between vehicle classes during congestion, validating the physical interpretability of the proposed hybrid architecture.}
}
@article{PARK2026116088,
title = {Time-plane projection network for efficient time-series image analysis},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116088},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116088},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008142},
author = {Jaehan Park and Soo Young Shin},
keywords = {Deep-learning, Time-series analysis, Action recognition, Temporal feature extraction, Spatio-temporal feature learning},
abstract = {This paper proposes the Time-Plane Projection Network (TP2Net), a computationally efficient system for time-series image analysis that compresses video sequences into fixed-size 2D projected images. Unlike conventional approaches such as Recurrent Neural Networks, 3D convolutions, or Transformers, where computational costs scale with input sequence length, TP2Net generates two Time-Shape images that encode horizontal and vertical motion trajectories by projecting the temporal axis onto orthogonal planes. These are combined with two Spatial-Shape images representing the starting and ending frames of the video. Each of the four images is processed through independent 2D Convolutional Neural Networks in a single pass, and the extracted features are subsequently merged to derive spatiotemporal results. This architecture maintains a constant computational cost regardless of the video length. A flexible framework is presented through the comparative analysis of two architectural configurations: a performance-focused symmetric architecture employing the same pre-trained backbone (ShuffleNetV2, MobileNetV3, RegNet, ConvNeXt) for all branches, and an efficiency-focused asymmetric architecture utilizing lightweight networks for temporal feature extraction. Experimental results demonstrate that the symmetric architecture consistently outperforms the asymmetric counterpart. With the ConvNeXt-Base backbone, TP2Net achieved peak accuracies of 92.37% on UCF101 and 69.06% on HMDB51 at 61.68 GFLOPs. The ShuffleNetV2-x2.0 backbone achieved competitive accuracies of 87.29% on UCF101 and 51.52% on HMDB51 with only 2.37 GFLOPs, enabling real-time inference at 224.7 FPS on GPU and 42.0 FPS on CPU. Compared to the Two-Stream ConvNet, TP2Net achieves comparable accuracy while being over 900 times more computationally efficient, establishing a highly effective operating point on the accuracy–efficiency curve.}
}
@article{SUN2026116201,
title = {Similar yet different: Robust and transferable face privacy protection via adversarial identity editing},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116201},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116201},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009275},
author = {Liping Sun and Bo Jiang and Xiaoyao Zheng and Liangmin Guo and Qingying Yu and Yonglong Luo},
keywords = {Image privacy, Adversarial perturbations, Visual naturalness, Robustness},
abstract = {The widespread sharing of facial images on social networking platforms exposes users to severe privacy risks owing to unauthorized and malicious face-recognition (FR) systems, which can identify individuals across platforms and scenarios without consent. Although existing facial privacy-protection methods largely focus on preserving visual naturalness, they struggle to concurrently achieve robustness against image distortions and transferability across FR models, substantially degrading performance in real-world deployments. We address this issue by proposing a facial privacy-protection framework that replaces the original identity with a visually similar yet semantically distinct identity, misleading FR systems while maintaining human-perceivable realism. The proposed method first disentangles identity and attribute representations using a dedicated feature-disentanglement network and leverages generative adversarial learning to preserve visual fidelity. An adversarial identity-editing module is introduced, where a dual-level perceptual constraint is designed to enhance image quality and stabilize identity manipulation. The edited identity features are finally recombined with retained facial attributes, synthesizing protected face images that remain visually usable yet resistant to machine recognition. Extensive experiments on multiple benchmark datasets demonstrate that the proposed approach maintains a superior balance between privacy protection and visual quality. It consistently outperformed state-of-the-art methods in terms of robustness to image degradation and transferability across diverse unseen FR models, including commercial FR application programming interfaces.}
}
@article{SI2026116177,
title = {Scaffolding thought: Imposing logical structure on LLMs with knowledge graphs for counterfactual generation},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116177},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116177},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009032},
author = {Jiasheng Si and Yingjie Zhu and Yeqing Teng and Rui Wang and Tianyi Wang and Weiyu Zhang and Chaoqun Zheng and Wenpeng Lu and Xiaoming Wu and Deyu Zhou},
keywords = {Counterfactual data generation, Fact verification, Knowledge graph},
abstract = {Multi-hop fact verification models often fail to generalize out-of-domain due to their reliance on spurious correlations. While Counterfactual Data Augmentation (CDA) is a principled approach to improve model robustness, its implementation with Large Language Models (LLMs) is hindered by a “structured reasoning gap”: LLMs tend to perform superficial semantic edits rather than engaging with the underlying logical proof structure required for multi-hop verification. To address this, we introduce Reason-on-Graph (RoG), a novel neural-symbolic framework that guides LLMs to perform disciplined and structured reasoning. Specifically, RoG compels the LLM to first construct an evidence Knowledge Graph (eKG) as a symbolic scaffold for thought. Then, the LLM acts as a symbolic reasoner, pruning the eKG to isolate the causal reasoning path, performing a targeted logical alteration, and finally generating causally faithful counterfactuals. Experiments on seven datasets show that data augmentation with RoG significantly improves model robustness and generalization, outperforming strong LLM-based and fine-tuning baselines. Intrinsic evaluations confirm RoG generates high-quality counterfactuals, achieving a label flip rate of 88.9%, thereby demonstrating an effective method for integrating symbolic reasoning with neural generation22The counterfactual instances generated by our method are available in https://github.com/AAAndy-Zhu/RoG..}
}
@article{LEIVA2026116080,
title = {Effective benchmarking of structured argumentation via the generation of synthetic DeLP knowledge bases},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116080},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116080},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008063},
author = {Mario A. Leiva and Gianvincenzo Alfano and Gerardo I. Simari},
keywords = {Structured argumentation, Defeasible Logic Programming, Benchmarks, Synthetic data},
abstract = {Computational models of argumentation is an active research field within Artificial Intelligence, with growing recent interest in real-world applications due to its intuitive reasoning mechanism and similarities to human reasoning. In this work, we focus on structured argumentation, which differs from abstract argumentation frameworks in that they work with the internal structure of the arguments. Much of the research in this area is still theoretical in nature, mostly because of the lack of benchmarks (which have mostly been investigated for abstract argumentation)—this has proven to be an important hurdle to overcome in the path to experimental research. Towards addressing this issue, we develop a knowledge base generator, called DPG, for the Defeasible Logic Programming (DeLP) framework that is designed to build synthetic programs for the practical evaluation of several computational tasks based on a set of nine parameters. We also develop a set of seven metrics in order to adequately assess the structural complexity of the generated programs and the computational cost of querying them; we study the computational complexity of computing such metrics, showing that most of them are intractable. Finally, we carry out an experimental evaluation of DPG in two parts. First, we carry out a rigorous study of the relationship between DPG parameter settings and metrics, which leads to the identification of interesting correlations that yield insights into how parameters must be adjusted in order to generate programs of a desired nature. Second, by setting thresholds for the value of specific metrics, we can divide programs into “easy” or “hard”, and we show that it is feasible to train binary classifiers that, given a specific set of values for the parameters of the generator, are able to predict whether or not the generated instances will be difficult or easy to solve in terms of the running time metric. We also investigate the use of autoencoders to support the fully automated generation of easy or hard programs, achieving promising results in this task as well. These results demonstrate that one can avoid the theoretically costly “generate and check” process.}
}
@article{CHOWDHURY2026116193,
title = {TabFusion: Lightweight early fusion of tabular and image data with graph-convolutional neural networks for skin cancer detection},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116193},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116193},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009196},
author = {Rashik Iram Chowdhury and Nusrat Kabir Nuha and Muhtasimul Hasan and Mohammad Junayed Hasan and M.R.C. Mahdy},
keywords = {Graph convolutional network, Multimodal learning, Ensemble learning, Explainable AI, Knowledge distillation, Skin lesion classification},
abstract = {Multimodal fusion approaches have emerged as critical enablers for accurate cancer detection, particularly in integrating clinical metadata with imaging data. This study introduces the first early fusion architecture that incorporates a Graph Convolutional Network (GCN) for clinical metadata representation before integration with a CNN-based vision backbone for multimodal skin lesion classification, addressing fundamental limitations in existing late and mid-fusion strategies. Our TabFusion framework fuses clinical skin lesion images with patient metadata at the input level, enabling joint representation learning through a lightweight GCN-enhanced multimodal architecture. The proposed ensemble learning strategy combines MobileViT and PVTv2 models, achieving state-of-the-art performance with 91.74% accuracy and 92.30% F1-score on the PAD-UFES-20 dataset, significantly outperforming all existing multimodal approaches. Through knowledge distillation, we transfer this performance to a compact custom student model (TabFusion) that maintains robust classification accuracy of 88.26% and F1-score of 86.62% while reducing computational complexity by over 60%. Explainable AI techniques, including Grad-CAM++ and SHAP, provide in-depth interpretability for both visual and tabular features, enhancing clinical trust and transparency. The proposed framework establishes new benchmarks for multimodal medical image analysis and demonstrates practical viability for deployment in resource-constrained healthcare environments. Codes and implementations are publicly available at: https://github.com/RashikIram/TabFusion-SkinLesion-GCN.}
}
@article{SARACLAR2026116213,
title = {Improving E-commerce search queries using transformer-based named entity recognition},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116213},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116213},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009391},
author = {Beyzanur Saraçlar and Mustafa Agaoglu},
keywords = {Natural language processing (NLP), Named entity recognition (NER), Transformers-based models, E-commerce search queries},
abstract = {Named Entity Recognition (NER) is crucial for enhancing product discovery in e-commerce. In this study, we introduce a novel, fine-grained annotated dataset for Turkish e-commerce search queries and systematically evaluate baseline and transformer-based models. Quantitative results show that transformers significantly outperform traditional baselines, with ELECTRA and a hybrid BERT+Bi-LSTM+CRF model achieving peak weighted F1-scores of 91.97% and 92.49%, respectively. Beyond architectural comparisons, we conduct an empirical morphological evaluation and a zero-shot Large Language Model (LLM) benchmark. Our morphological analysis reveals that agglutinative suffixation in Turkish increases semantic density, providing stronger contextual cues that actively improve NER performance. Furthermore, we benchmarked BERT — selected for its optimal balance of accuracy and computational efficiency — against a zero-shot LLM (Gemini Pro). While fine-tuned transformers yield higher F1-scores, qualitative analysis indicates they often overfit to ground truth noise and annotator bias. Conversely, the LLM exhibits superior zero-shot robustness to typographical errors and semantic ambiguities. Ultimately, this study presents highly efficient NER models while offering deep linguistic insights for LLM-based research in low-resource agglutinative languages.}
}
@article{ZHANG2026116156,
title = {Information-Maximized Optimal Transport for interpretable and robust unsupervised graph alignment},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116156},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116156},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008828},
author = {Jiayu Zhang and Chunyu Liu and Zeshu Tian and Hongli Zhang},
keywords = {Graph alignment, Unsupervised learning, Optimal transport, Graph learning},
abstract = {Unsupervised graph alignment aims to identify semantically corresponding nodes between two graphs without access to ground-truth mappings. This task plays a crucial role in applications such as social network integration and knowledge graph alignment. However, most existing methods rely on well-established optimal transport paradigms, which are vulnerable to anomalous structures and local noise. Furthermore, the interpretability of the alignment process is often overlooked, limiting the transparency and reliability of these models in real-world scenarios. To tackle these challenges, we propose IMOTAlign, a novel unsupervised framework that delivers competitive alignment accuracy while simultaneously providing interpretability and robustness. Within this framework, we extend the optimal transport paradigm by introducing a mutual-information maximization mechanism, resulting in an Information-Maximized Optimal Transport paradigm that encourages the transport plan to focus on semantically coherent and structurally resilient correspondences across graphs. Additionally, we propose an alignment-aware graph explainer that operates within the transport process to reveal structural patterns supporting alignment decisions and improving model transparency. Extensive experiments on multiple benchmarks demonstrate that IMOTAlign achieves state-of-the-art alignment performance, while exhibiting strong robustness and clear interpretability.}
}
@article{XU2026116124,
title = {ObjectDiff: An object-centric diffusion policy with modality-specific conditioning for robot manipulation},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116124},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116124},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008506},
author = {Yong Xu and Zhiyu Wei and Ruotao Xu and Zihan Zhou and Si Wu},
keywords = {Robot manipulation, Diffusion model, Object-centric embedding},
abstract = {Developing versatile robotic manipulation systems that interpret natural language and operate in unstructured settings represents a critical frontier in autonomous robotics. Diffusion models offer strong potential due to their training stability and effectiveness in high-dimensional action spaces. However, their inherent sampling stochasticity can undermine the precision required for fine-grained manipulation. To address this issue, we introduce an object-centric visual representation coupling a DINO-based detector with Detector-Free Guidance (DFG) for robust target localization, further augmented with attention-dropout ablations and confidence calibration, thereby balancing reliance on the detector and diffusion models. Building on this representation, we design a hypernetwork-based instruction conditioning module that delivers comprehensive conditioning while substantially reducing computational costs. Integrating this with visual and timestep conditioning yields a modality-specific mechanism that leverages the distinct roles of each modality. In addition, we impose a behavioral consistency constraint with timestep-adaptive noise scheduling to stabilize training. Across comprehensive evaluations on the PerAct and Hiveformer’s benchmarks, our method achieves state-of-the-art performance, yielding a 6.2% improvement in success rate on PerAct.}
}
@article{ROSTAGHI2026116144,
title = {Two-dimensional fuzzy dispersion entropy to nonlinear image analysis},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116144},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116144},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008701},
author = {Mostafa Rostaghi and Anne Humeau-Heurtier and Sadegh Rostaghi and Hamed Azami},
keywords = {Nonlinear image analysis, Entropy, Image irregularity, Two-dimensional fuzzy dispersion entropy, Lung computed tomography},
abstract = {Recent trends in nonlinear two-dimensional entropy methods are revolutionizing the quantification of image irregularity. Traditional measures—such as two-dimensional sample entropy (SamEn2D), two-dimensional dispersion entropy (DisEn2D), and two-dimensional fuzzy entropy (FuzEn2D)—effectively characterize textures and spatial dependencies but often suffer from high sensitivity to parameter settings and noise. To address this gap, we propose a novel approach that integrates fuzzy membership functions into the dispersion entropy framework, yielding enhanced robustness and stability in the assessment of image irregularity. The proposed two-dimensional fuzzy dispersion entropy (FuzDisEn2D) method is based on Shannon entropy and incorporates a fuzzy mapping strategy for smoother quantization. Unlike the traditional quantization in DisEn2D—where a hard quantization operator assigns each pixel to a single discrete class and can increase sensitivity to noise and parameter settings—FuzDisEn2D replaces hard quantization with fuzzy membership-based quantization, enabling pixels near class boundaries to contribute smoothly to adjacent classes. This soft assignment reduces information loss, mitigates boundary ambiguity, and improves robustness. Evaluations on synthetic datasets—including MIX2D images, colored noise, and composite textures—demonstrate that FuzDisEn2D captures a range from purely periodic to fully random structures, detects the presence of frequency-dependent irregularities, and distinguishes heterogeneous and complex patterns, respectively, thereby surpassing existing techniques in terms of stability, noise resilience, and discriminatory power. Similarly, evaluations on diverse real-world datasets—including industrial screw inspection, granite texture classification, lung computed tomography (CT) analysis, and colorectal cancer histology—employing an optimized support vector machine (SVM) framework, highlight the method’s broad practical relevance in industrial quality control and biomedical diagnostic imaging. The results confirm the superiority of the proposed method.}
}
@article{WANG2026116205,
title = {Unleashing the potential of Mamba: A novel approach for low-light image enhancement},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116205},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116205},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009317},
author = {Ge Wang and Yong Ma and Jun Huang and You Du and Fan Fan and Zhiqing Zhao and Yi Lu},
keywords = {Low-light image enhancement, Retinex theory, Vision Mamba, Multiple feature fusion, Collaborative attention mechanism},
abstract = {The goal of low-light image enhancement is to restore normal-light images from those captured in dim environments. Although the Mamba architecture demonstrates high computational efficiency, its unidirectional modeling limits its ability to effectively integrate global information and facilitate multi-scale feature interaction. This limitation compromises the balance between texture preservation and brightness restoration under low-light conditions, thereby hindering its performance in low-light enhancement tasks. To address these challenges, we propose an end-to-end deep learning framework that combines Retinex and Mamba. The framework, inspired by the Retinex theory, consists of two main components: an Illumination Estimator (IE) and a Restoration Network (RN). The IE incorporates a Multiple Feature Fusion (MFF) module that effectively integrates global and local information, significantly enhancing feature extraction and noise suppression in low-light regions. The RN, built upon the Mamba architecture, leverages a collaborative attention mechanism to enhance both light and texture features, promoting effective multi-scale feature interaction, enriching texture details, and improving visual naturalness. Extensive experiments demonstrate that the proposed method yields promising results.}
}
@article{KAI2026116229,
title = {Prompt based active learning with ensemble sampling strategy for small data learning in the scientific text classification scenarios},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116229},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116229},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600955X},
author = {Hu Kai and Zhang Yaoting},
keywords = {Scientific text classification, Pre-training model, Active learning, Prompt tuning},
abstract = {Scientific text classification often starts from a cold-start setting in which expert annotation is expensive and domain terminology evolves quickly. However, it remains unclear whether prompt-based pre-trained language models can effectively support both classification and pool-based active learning under strict annotation budgets. We make three contributions: (1) We build a reproducible active-learning pipeline based on SciBERT and PET-style prompting, where the same model serves as both the classifier and the uncertainty-based query selector. (2) We introduce an ensemble confidence strategy that combines least-confidence, entropy, and margin signals through development-set-calibrated weights, providing a principled multi-criterion query rule that accounts for scale differences among the uncertainty criteria. (3) We provide unified 3-seed experiments on ACL-ARC and SciCite with budgets from 100 to 500 labeled instances, accompanied by synergy ablation, selector-backbone comparison, and efficiency analysis. At the 500-instance budget, our method reaches 65.08 Macro-F1 on ACL-ARC and 86.30 Macro-F1 on SciCite, while using only 29.6 % and 6.8 % of the respective training sets. These results support the method as a practical and controllable alternative to larger LLM-based classification pipelines in scientific-domain scenarios where annotation budgets, model scale, and computational resources are constrained.}
}
@article{ZHANG2026116174,
title = {MCD4SR: Multimodal collaborative denoising with modality balancing for sequential recommendation},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116174},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116174},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009007},
author = {Xin Zhang and Yinzhuo Chen and Shengan Wang and Dongjing Wang and Hongbo Wang and Yingjie Xia and Sijie Niu and Butian Huang and Yuyu Yin},
keywords = {Multimodal sequential recommendation, Modality balancing, Collaborative denoising, Semantic alignment},
abstract = {Multimodal sequential recommendation methods incorporate content features such as text and images to alleviate the item ID sparsity problem and to capture users’ fine-grained preferences. However, existing approaches still face two main challenges: (1) Noisy and irrelevant information in multimodal content, which can degrade the accuracy of user preference modeling; (2) Imbalanced learning dynamics across modalities, where stronger modalities dominate the optimization process and hinder effective integration of weaker but complementary modalities. To address these challenges, we propose multimodal collaborative denoising with modality balancing for sequential recommendation (MCD4SR). Specifically, we design a multimodal-aware collaborative denoising module, which jointly suppresses modality-specific noise through bidirectional cross-modal attention and modality-specific causal sequence modeling. In addition, we introduce a consistent learning with modality balancing strategy that leverages entropy balance regularization and ideal weight supervision, derived from ranking feedback, to maintain diversity among modality weights and mitigate the excessive dominance of strong modalities. Moreover, we introduce cross-modal consistency constraints at the prediction layer to facilitate semantic alignment across different modalities. Extensive experiments on four real-world datasets demonstrate that the proposed MCD4SR consistently outperforms state-of-the-art methods. The code is available at https://github.com/Emy-cv/MCD4SR.}
}
@article{HE2026116226,
title = {Towards transferable adversarial attacks with multi-scale structure-frequency transformations},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116226},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116226},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009524},
author = {Long He and Pian Wang and Yatie Xiao and Kongyang Chen and Chang Liu and Qingxiao Guan and Zhenbang Liu},
keywords = {Deep neural networks, Adversarial transferability, Multi-scale, Structure-frequency transformations},
abstract = {Deep Neural Networks (DNNs) are vulnerable to Adversarial Examples (AEs), which pose significant risks in security-relevant domains. Adversarial transferability, the adversarial capability of AEs across target networks, highlights the susceptibility of DNNs. In transfer attacks, adversarial methods based on input transformations excel in enhancing transferability by inducing diverse patterns. However, existing transfer methods focus on disrupting the features at the structure level without integrating substantial disturbance from a frequency perspective, which limits the ability of AEs to transfer across victim models. To this end, we propose the framework termed Multi-Scale Structure-Frequency Transformations (MS2FT), which integrates random-dimensional structure transformation with multi-scale transformation in the Low-Frequency (LF) domain. Specifically, we initiate the process by applying a random-dimensional structure transformation by shuffling the input blocks along a randomly selected dimension to disrupt internal structural correlations. Then, multi-scale frequency transformation is employed on such shuffled blocks to perturb the class-wise fine-grained components in the low-frequency spectrum, which weakens the expression of class-wise salient features across victim models. Finally, we further aggregate the gradients of such transformed patterns to enhance the overall transferability. Extensive results on ImageNet demonstrate that AEs crafted by MS2FT surpass existing state-of-the-art (SOTA) baselines on both CNN and Transformer models by a large margin in terms of transfer attack success rates while maintaining robustness against advanced defenses. MS2FT provides a practical research direction for boosting adversarial transferability by perturbing input properties at both the structural and frequency levels. Our code is available at https://github.com/dislab-gzhu/MS2FT.}
}
@article{BHARASA2026116129,
title = {MetaImClust: Automatic Crisp Clustering using Eminent Metaheuristics for Image Segmentation},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116129},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116129},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008555},
author = {Totan Bharasa and Arunita Das and Krishna Gopal Dhal and Kalyani Maity Das and Essam H. Houssein},
keywords = {Metaheuristics, Clustering, Image Segmentation, Swarm Intelligence, Optimization},
abstract = {Partitional clustering techniques such as K-Means (KM) are simple and efficient for image segmentation. However, KM is very sensitive to the initial choice of random cluster centres and frequently it is trapped in local optima. In addition, KM is not automatic, i.e., the number of clusters is a constant user-defined value. Therefore, this study developed recent well-known metaheuristic algorithms (MAs)-based automatic partitional crisp image clustering models for better segmentation results. The density balance (DB) algorithm and superpixel strategy have been employed to find the cluster number before the beginning of the actual clustering technique. Twenty-five recent MAs-based image clustering models are developed and evaluated over BSD500 and digital pathology images. The numerical, visual, and statistical results indicate that the designed MAs-based crisp clustering models are producing very promising results. Results also demonstrate that Partial Reinforcement Optimizer (PRO) achieves the best rank and Fungal Growth Optimizer (FGO) achieves the worst rank.}
}
@article{HUANG2026116105,
title = {Dynamic token halting for efficient abstractive summarization with importance-aware regularization},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116105},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116105},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008312},
author = {Heyan Huang and Yu Bai and Yang Gao and Minpeng Liao},
keywords = {Text summarization, Efficient encoding, Language models},
abstract = {Text summarization involves distilling key information from a lengthy document and presenting it as a concise summary. Unlike extractive summarization, which directly selects phrases or sentences from the source text, abstractive summarization requires comprehending the entire document and generating a summary word by word. Current state-of-the-art abstractive summarization systems rely on large pretrained models, which often suffer from inefficiencies caused by overprocessing irrelevant information. A significant portion of unimportant data is unnecessarily encoded, leading to excessive computational costs. In this paper, we address these inefficiencies by introducing a method that incrementally discards redundant hidden states throughout the encoding process, achieved by leveraging the Adaptive Computation Time (ACT) mechanism. Additionally, we propose a novel Importance-aware Prior Regularization technique that helps the model identify and prioritize crucial parts of the document, ensuring they are processed more thoroughly in deeper layers of the encoder. Our approach reduces the computational demands of pretrained encoders by 25%–35% in terms of floating-point operations (FLOPs) while maintaining performance levels comparable to strong baseline models. Extensive experiments demonstrate that our method is particularly effective at reducing computational costs for longer documents. The code and data will be made publicly available upon acceptance of this paper.}
}
@article{JIN2026116121,
title = {An interpretable superlet deep learning framework for cross-subject driver drowsiness recognition using EEG},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116121},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116121},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008476},
author = {Tongtong Jin and Ziyao Geng and Shiwu Li and Mengzhu Guo and Yu Sun and Wen Gao},
keywords = {EEG decoding, Interpretable deep learning, Drowsiness recognition, Cross-subject classification, Depthwise separable convolution},
abstract = {Electroencephalography (EEG)-based brain-computer interfaces (BCIs) play an important role in driver drowsiness recognition. However, conventional convolutional neural networks (CNNs) rely on fixed convolutional kernels, which limits their ability to model the non-stationary and multi-scale time-frequency characteristics of EEG signals. Their black-box nature also hinders practical interpretability. To address these issues, this paper proposes an interpretable superlet depthwise separable CNN termed SLNet, for drowsiness recognition. Inspired by the ability of superlet to alleviate the time-frequency resolution trade-off, a superlet convolution module (SLConv) is designed and employed as the first layer of SLNet to replace standard convolution. By combining multiple wavelet responses with different bandwidths at shared center frequencies, SLConv enhances frequency discrimination while preserving temporal resolution, thereby enabling effective extraction of drowsiness-related multi-scale transient oscillatory patterns from EEG signals. Only the wavelet center frequencies and cycle parameters are learnable, allowing the network to construct physically interpretable convolutional kernels. Furthermore, depthwise separable convolutions are adopted to efficiently model the spatial distribution and temporal dynamics of EEG signals. To further improve interpretability, a structure-aware activation contribution backtracking method tailored for SLConv is proposed. This method traces discriminative activations back to critical EEG channels and time segments, providing physically meaningful explanations for model decisions. Experiments on a sustained-attention driving-task dataset demonstrate that SLNet achieves an average cross-subject classification accuracy of 78.04%, outperforming both traditional baseline methods and deep learning methods. The interpretability results indicate that the model identifies physically meaningful features from EEG signals and reveals plausible causes of misclassification.}
}
@article{DESALEGN2026116194,
title = {Improving Amharic legal question answering with Retrieval-Augmented Generation and locally-sourced data},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116194},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116194},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009202},
author = {Elshaday Desalegn and Natanim Berhanu and Seble Hailu and Terefe Feyisa and Tewodros Legesse and Yonas Bekele and Yohannes Adigeh and Zinawork Assefa},
keywords = {Retrieval augmented generation, Amharic question answering, Low-resource languages, Multilingual embeddings, Semantic chunking, Faithful generation, Vector retrieval, Large language models},
abstract = {Retrieval-Augmented Generation (RAG) has emerged as a promising paradigm for improving factual grounding in large language models (LLMs), yet its effectiveness in low-resource, morphologically rich languages remains underexplored. This paper presents RAG-C, a RAG framework tailored for Amharic legal question answering (QA), integrating semantic chunking, multilingual contextual embeddings, and efficient vector retrieval. We construct an 82.4 MB Amharic corpus from publicly available Ethiopian Federal Supreme Court cassation decisions (legal precedents), complemented by Amharic Wikipedia and news sources. We evaluate across 500 QA pairs using both automatic metrics (RAGAS, F1, BLEU, EM) and human judgment. RAG-C achieves state-of-the-art performance across all evaluation dimensions, including 0.797 context relevance, 0.833 faithfulness, and 0.772 F1, outperforming strong baselines such as BM25 and zero-shot LLMs. Human evaluation further confirms improvements in factual correctness (4.5/5) and overall quality (4.4/5). Our analysis shows that embedding quality is the dominant factor in retrieval performance, while semantic chunking improves contextual coherence in morphologically complex text. We also identify key trade-offs in retrieval depth, model scaling, and latency, and highlight limitations related to corpus coverage and statistical testing. These results demonstrate that carefully designed RAG pipelines can substantially improve QA performance in low-resource languages, providing a scalable path toward reliable, grounded NLP systems beyond high-resource settings.}
}
@article{KHAN2026116141,
title = {DeepIFSim: A deep-learning and intuitionistic fuzzy similarity framework for face identification},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116141},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116141},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008671},
author = {Muhammad Jabir Khan and Ahmad N. Al-Kenani and Weiping Ding},
keywords = {Deep neural networks, Face identification, Intuitionistic fuzzy set, Similarity measure},
abstract = {This study presents a novel closed-set face identification framework in which intuitionistic fuzzy similarity measures are integrated with deep feature representations extracted from pre-trained neural networks. First, new sine-based similarity measures for intuitionistic fuzzy sets are introduced, and their mathematical properties are thoroughly analyzed. These measures are then incorporated into a training-free identification framework, termed DeepIFSim, where facial images are represented by deep embeddings and modeled using intuitionistic fuzzy representations to capture uncertainty in feature distributions. Unlike conventional deep-metric-learning approaches, which require extensive network training and large labeled datasets, the proposed framework operates directly on pre-trained deep features and performs identification by maximizing similarity between probe and gallery samples. This design enables efficient deployment in scenarios with limited computational resources or training data. Experimental evaluations conducted on widely used face datasets, namely the Labeled Faces in the Wild (LFW) and Olivetti Research Laboratory (ORL) datasets, demonstrate that the proposed method achieves competitive identification performance compared with classical similarity-based methods, statistical classifiers, and representative deep-learning baselines. In particular, DeepIFSim attains identification accuracies of 99.72% and 98.04% on the ORL and LFW datasets, respectively. The results highlight that the integration of intuitionistic fuzzy modeling with deep feature representations provides a flexible and interpretable alternative to traditional deep-learning pipelines while maintaining strong recognition performance. These characteristics make DeepIFSim a practical solution for closed-set face identification tasks in real-world applications.}
}
@article{LI2026116181,
title = {Distinguishing visually similar actions: Prompt-guided Semantic Prototype Modulation for few-shot action recognition},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116181},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116181},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600907X},
author = {Xiaoyang Li and Mingming Lu and Ruiqi Wang and Hao Li and Zewei Le},
keywords = {Few-shot action recognition, Vision–language model, Temporal modeling, Prototype modulation},
abstract = {Few-shot action recognition aims to enable models to quickly learn new action categories from a limited number of labeled samples, addressing the challenge of data scarcity in real-world applications. Current research primarily faces three core challenges: (1) temporal modeling, where models are prone to interference from irrelevant static background information and struggle to capture the essence of dynamic action features; (2) visual similarity, where categories with subtle visual differences are difficult to distinguish; and (3) the modality gap between visual–textual support prototypes and visual-only queries, thereby complicating alignment within a shared embedding space. To address these challenges, this paper proposes a CLIP-SPM framework, which includes three components: (1) the Hierarchical Synergistic Motion Regularization (HSMR) module, which aligns deep and shallow motion features to improve temporal modeling by reducing static background interference; (2) the Semantic Prototype Modulation (SPM) strategy, which generates query-relevant text prompts to bridge the modality gap and integrates them with visual features, enhancing the discriminability between similar actions; and (3) the Prototype-Anchor Dual Modulation (PADM) method, which refines support prototypes and aligns query features with a global semantic anchor, improving consistency across support and query samples. Comprehensive experiments across standard benchmarks, including Kinetics, SSv2-Full, SSv2-Small, UCF101, and HMDB51, demonstrate that our CLIP-SPM achieves competitive performance under 1-shot, 3-shot, and 5-shot settings. Extensive ablation studies and visual analyses further validate the effectiveness of each component and its contributions to addressing the core challenges. The source code and models are publicly available at GitHub.}
}
@article{SUNEL2026116178,
title = {Subgoal identification with multiple instance learning methods in landmark Partially Observable Markov Decision Process problems},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116178},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116178},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009044},
author = {Saim Sunel and Faruk Polat},
keywords = {Reinforcement learning, Subgoal identification, Multiple instance learning, Partially Observable Markov Decision Process (POMDP)},
abstract = {In the literature, subgoal identification methods have been shown to improve the learning performance of reinforcement learning (RL) agents for Markov Decision Process (MDP) problems. Most methods rely on the distinctiveness of states; therefore, they cannot be used in Partially Observable Markov Decision Process (POMDP) problems where state information is ambiguous. However, only a few multiple instance learning (MIL)-based methods (baseline methods) have been shown to identify subgoals in landmark POMDP problems where some states emit unique observations. These techniques rely on early MIL algorithms and require distance information between data instances, which can be misleading in POMDP problems because of ambiguity. The MIL domain has matured with many studies, and a large set of approaches can be considered for identifying subgoals in POMDP problems. To this end, we evaluate a wide range of other MIL-based methods that do not require distance information and make different assumptions about dependency relationships in datasets on several landmark POMDP problems. In addition to using existing methods, we propose new MIL methods and an architectural layer that leverage the dependencies that emerge in an RL setting. Furthermore, we experiment with different subgoal selection strategies based on the information the methods provide and how it can be summarized, considering the RL setting. Our results show that almost all methods employed and proposed surpass the baseline methods in average subgoal identification accuracy. As a related work, we also demonstrate that identified subgoals can enhance learning efficiency. The implementation and datasets are available at https://github.com/SaimSUNEL/SubgoalIdentificationwithMILMethodsinLandmarkPomdps.}
}
@article{KE2026116222,
title = {Text image inpainting via Text-Referenced Residual Diffusion Model in latent space},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116222},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116222},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009482},
author = {Rongji Ke and Degang Chen and Hengyou Wang},
keywords = {Text image inpainting, Diffusion model, Residual learning, Text condition},
abstract = {Text images in real-world scenarios often suffer degradation due to environmental or human-induced corrosion, such as graffiti, stains, and water damage. These forms of degradation obscure textual features like texture and structure, making it difficult to interpret the content and obstructing downstream tasks such as text recognition and signature verification. Existing inpainting methods often fail to accurately reconstruct corrupted text in a way that aligns with human intent, as they typically generate visually plausible content without ensuring semantic correctness. To address these issues, we propose a new paradigm for text image inpainting that leverages human intent as guiding information: Text-Referenced Residual Diffusion Model (TRDM). This paradigm enables users to intuitively control the inpainting outcomes of text images according to their desired intent. Specifically, we first introduce human intent as guiding information and transform it from text to visual text reference images. Next, we propose a semantic query module (SQM) to leverage text reference to supplement the semantic content of corrupted image features. Furthermore, to improve the performance of the diffusion model, we propose a residual diffusion module (RDM) that learns semantic residuals between corrupted and complete images in the latent space. Together, the text reference and residual learning guide the diffusion process, enabling more accurate, coherent, and stylistically consistent reconstructions of the original text images. Extensive experiments on HT and ST datasets demonstrate that our approach outperforms state-of-the-art methods in both text recognition accuracy and image quality. Codes are available at the link: https://github.com/langka9/TRDM.git.}
}
@article{FANG2026116190,
title = {MPNet: Maximum parallax network for light field salient object detection},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116190},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116190},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009160},
author = {Xian Fang and Zhigao Li and Mingfeng Jiang and Xuxin Wu},
keywords = {Light field, Salient object detection, Multi-view images, Maximum parallax, Optical flow},
abstract = {Light field salient object detection (LF SOD) leverages the rich geometric cues from 4D light field data to achieve more robust and accurate segmentation in challenging scenes. Although recent work has emphasized the potential of using fewer views and explicit parallax, the exploration of this paradigm remains incomplete. To address these issues, we propose a novel strategy that utilizes the maximum parallax from the sparse views to generate four auxiliary optical flow maps for detection. Built upon this strategy, we introduce a framework termed the maximum parallax network (MPNet) that is a hierarchically multiple stream architecture. Specifically, MPNet consists of three core modules, each with its own responsibilities to progressively process multi-modal features. Firstly, the guided boundary refinement module (GBRM) employs the mutual guidance scheme based on the distance transform to synergistically enhance feature contours. Secondly, the dynamic feature rectification module (DFRM) performs adaptive and quality-aware feature correction by generating dynamic weights to guide an interactive dual-attention process. Finally, the cooperative cross-modal integration module (CCIM) produces a powerful final fusion by combining a cross-attention mechanism for global context with convolutional layers for local refinement. Extensive experiments on three benchmark datasets show that our MPNet demonstrates highly competitive performance against state-of-the-art methods. The code is available at https://github.com/hrbx-bot/MPNet-LFSOD.}
}
@article{XIAO2026116182,
title = {Causality-inspired brain-visual contrastive learning for zero-shot visual decoding},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116182},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116182},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009081},
author = {Yi Xiao and Xuyi Qiao and Yu-Xuan Zhang and Xianchuan Yu},
keywords = {Brain visual decoding, Causal inference, Contrastive learning, Zero-shot retrieval, Brain-computer interface},
abstract = {In the field of brain-computer interfaces (BCI), zero-shot visual decoding from electroencephalography (EEG) and magnetoencephalography (MEG) signals poses a significant challenge that requires accurately retrieving matching images when confronted with previously unseen visual categories. However, existing deep learning models suffer from confounding factors introduced through inter-subject and inter-trial variability when aligning brain-visual representations, causing models to learn fragile spurious correlations and severely limiting generalization in zero-shot scenarios. To address this challenge, we propose a novel Causality-Inspired Brain-Visual Contrastive Learning (CI-BVCL) framework. Inspired by structural causal models, this framework employs a systematic counterfactual perturbation strategy that guides models to disentangle causal factors from confounding factors through contrastive learning, without requiring explicit supervision of confounding factors. We conducted extensive 200-class zero-shot retrieval experiments on the large-scale public datasets THINGS-EEG and THINGS-MEG. Results demonstrate that CI-BVCL achieves 42.5% and 23.0% Top-1 accuracies on THINGS-EEG and THINGS-MEG, respectively, in the intra-subject setting, outperforming the strongest baselines by 5.3 and 8.7 percentage points, respectively. The framework’s effectiveness and generalizability are rigorously validated across 6 representative brain encoder architectures and 2 widely used visual encoder backbones. This work establishes a robust causally-inspired learning paradigm for addressing generalization challenges in BCI applications.}
}
@article{ZOU2026116125,
title = {PGSJLM: A physics-guided graph-series joint learning model for industrial soft sensing},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116125},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116125},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008518},
author = {Zhou Zou and Can Zhou},
keywords = {Soft sensor, Physics-guided learning, Encoder-decoder, Graph neural network, Flash smelting},
abstract = {Data-driven deep learning soft sensors are often limited by data dependency, leading to poor generalization and robustness. To address it, this study proposes a physics-guided graph-series joint learning model (PGSJLM) for accurate industrial soft sensing. Firstly, it converts chemical reaction equations into graph structures to embed chemical knowledge. It uses graph neural networks combined with attention mechanisms to encode and decode reaction topology graphs, generating multiple node state physical quantities. Subsequently, via causal convolution and attention mechanisms, it encodes and decodes process variable time series to produce dynamic condition physical quantities that capture trends in industrial process variations. To enhance physical interpretability, it leverages these physical quantities for mechanistic modeling, ensuring the computational process aligns with process principles for robust target variable estimation. Finally, an estimation compensator based on a cross-attention mechanism is designed to mitigate errors caused by modeling assumptions. To validate the effectiveness of PGSJLM, experiments were conducted on matte grade prediction in the flash smelting process. The results show that compared to the best comparison model, RMSE is reduced by 35.1 %, MAE by 29.0 %, and R² reaches 0.9602, demonstrating that PGSJLM outperforms other soft sensors in accuracy and robustness.}
}
@article{XUE2026116214,
title = {AMID: Audio–visual deepfake detection via adaptive multi-dimensional interaction modeling},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116214},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116214},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009408},
author = {Chenlong Xue and Kunyuan Li and Meng Sun and Qiang Zhang and Xiongwei Zhang and Kui Yao},
keywords = {Deepfake detection, Disentangled representation learning, Low-rank adaptation, Audio–visual fusion, Multi-dimensional interaction},
abstract = {The rapid proliferation of generative audio–visual synthesis techniques has significantly lowered the barrier to producing convincing deepfake content, intensifying threats to digital media integrity and multimedia forensics. Existing audio–visual deepfake detection models suffer from two key limitations: (1) insufficient modeling of multi-dimensional audio–visual interactions, including cross-frame continuity, spatial correspondence, and semantic coherence; and (2) limited robustness when both modalities are simultaneously manipulated. To address these challenges, we propose AMID—Adaptive Multi-dimensional Interaction Detection, a framework that explicitly disentangles and adaptively models multi-dimensional interactions across audio and video streams. AMID consists of three synergistic components: (1) a Complementary Masked Cross-modal Reconstruction (CMCR) module, which enforces conditional generation between modalities and learns deep causal correspondence rather than superficial correlations; (2) a Multi-dimensional Disentangled Representation Learning (MDRL) module, which isolates temporal, spatial, and semantic interaction dimensions through orthogonal subspace constraints and reconstruction regularization; (3) an Interaction-aware Adaptive Low-rank Adaptation (IALA) module, which captures dimension-specific discriminative patterns via multi-head low-rank adapters and dynamically routes contributions according to sample characteristics. Experiments on typical audio–visual multimodal deepfake datasets show that AMID consistently outperforms all state-of-the-art baselines. Visualization and ablation studies further verify the effectiveness of explicit multi-dimensional disentanglement and adaptive modeling.}
}
@article{ZHENG2026116117,
title = {StratiFormer: Stratified Temporal Transformer for video object detection},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116117},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116117},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008439},
author = {Wentao Zheng and Hong Zheng and Yuquan Sun and Ying Jing},
keywords = {Video object detection, Vision Transformer, Multi-scale feature fusion, Spatio-temporal attention},
abstract = {In video object detection (VOD), exploiting temporal cues is essential for alleviating common visual degradations (e.g., motion blur and occlusion). Existing approaches range from short-range feature enhancement to long-range dependency aggregation, while some attempt to combine both. Although substantial progress has been achieved, most designs still decouple temporal aggregation from multi-scale feature construction. In particular, many methods adopt a unified temporal aggregation range across all feature levels, which is level-agnostic and overlooks the distinct temporal requirements of low-level features for fine-grained localization and high-level features for abstract semantics. This limitation restricts a model’s ability to adaptively utilize temporal information according to the feature hierarchy. To address this issue, we propose the Stratified Temporal Transformer (StratiFormer). StratiFormer integrates the fusion of long- and short-range temporal cues directly into the cross-scale feature construction process, enabling feature-level-adaptive temporal aggregation. Moreover, it employs a stratified selection mechanism to identify and process a sparse yet informative set of temporal features at each feature level, allowing the model to allocate computation to the most relevant candidates. On the ImageNet VID benchmark, StratiFormer achieves up to 88.2% mAP50, delivering a favorable balance between accuracy and efficiency.}
}
@article{HU2026116140,
title = {A large neighborhood search with deep optimization for the weighted total domination problem in massive graphs},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116140},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116140},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600866X},
author = {Shuli Hu and Wen Wen and Dian Ling and Jiaqi Li and Ziqing Liao and Ruizhi Li and Minghao Yin},
keywords = {Weighted total dominating set, Deep optimization, Large neighborhood search, Massive graph},
abstract = {The weighted total domination problem (WTDP) is an important generalization of the total dominating set problem, incorporating both vertex and edge weights to optimize costs in practical applications, such as information spreading and distributed network design. In this study, we designed an efficient destroy–repair–improve large neighborhood search with deep optimization for WTDP in massive graphs, structured in three phases. First, two new reduction strategies were applied to reduce the size of the original graphs, and then we proposed a greedy heuristic to construct a promising feasible initial solution. Second, we applied a novel destroy–repair–improve large neighborhood search to refine the initial solution. To guide the search process, we proposed a new vertex selection strategy that integrates a dynamic scoring function with an enhanced three-valued two-level configuration-checking mechanism. To improve the solution, we introduced three operators, shrink, swap, and expand, to obtain promising high-quality solutions. Third, deep optimization was applied to escape local optima by introducing strategic perturbations when the large neighborhood search fails to improve the solution for a prolonged period. We evaluated our algorithm on 352 benchmark instances, including 37 massive real-world graphs and 315 synthetic instances. On the massive graphs, it yielded 29 new upper bounds and matched five best-known results. On the smaller instances, it achieved six new upper bounds and matched 309 best-known results. These results demonstrate the excellent solution quality of our approach, along with competitive efficiency observed in most cases.}
}
@article{LI2026116161,
title = {Multi-Condition Latent Diffusion Network for Semantic-aware Knowledge Graph Completion},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116161},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116161},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008877},
author = {Siyuan Li and Liang Zhang and Bo Jin and Xiaopeng Wei},
keywords = {Knowledge representation, Knowledge reasoning, Knowledge graphs, Diffusion process},
abstract = {Knowledge graph completion (KGC) aims to infer missing facts in incomplete knowledge graphs, but its effectiveness is often limited by the inherently multi-peaked answer distribution of a query (h,r,?) and by the fact that the evidence required for disambiguation is scattered across noisy semantic contexts and heterogeneous structural patterns. Although recent diffusion-based methods improve entity prediction by modeling target uncertainty, they still rely heavily on effective condition design. To address this issue, we propose a Multi-Condition Latent Diffusion Network (MCDN), which formulates entity prediction as query-adaptive multi-condition generation in latent space. Specifically, MCDN learns semantic conditions from entity-side and relation-side context, models connection-pattern priors as complementary structural guidance, and introduces a semantics-aware Top-K strategy to reduce noisy neighborhood interference. A multi-condition denoiser is further designed to adaptively integrate these conditions into the reverse diffusion process for progressive target entity recovery. Extensive experiments demonstrated that the MCDN achieved superior performance across several benchmarks. On the widely used FB15k-237 dataset, the MCDN achieved a competitive MRR of 55.1% and a Hits@1 of 52.9%. It also delivered robust results on WN18RR (MRR 57.4%) and Kinship (Hits@1 79.8%).}
}
@article{GAO2026116166,
title = {CC-GFRT: Class Correlation-based Granular Feature Refinement and Transfer for Non-Exemplar Class Incremental Learning},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116166},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116166},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008920},
author = {Ruixuan Gao and Zongyong Deng and Yue Yang and Qijun Zhao},
keywords = {Class incremental learning, Knowledge distillation, Prototype augmentation},
abstract = {Non-Exemplar Class Incremental Learning (NECIL) aims to learn a robust model across a sequence of tasks without access to previous task samples. Current methods typically use prototype augmentation and knowledge distillation to mitigate catastrophic forgetting in NECIL. However, two limitations persist. First, their augmented historical prototypes may face difficulty in balancing the retention of old-class discriminability and adaptation to the new feature space, which can lead to blurred decision boundaries. Second, their unselective distillation tends to introduce redundancy in old knowledge and overpenalize new knowledge learning, thereby limiting the plasticity of the feature extractor. To address these issues, we propose a novel Class Correlation-based Granular Feature Refinement and Transfer (CC-GFRT) strategy that leverages the new–old class correlation for granular prototype augmentation and knowledge transfer. Specifically, the Distribution-aware Correlation Measurement (DCM) module first captures new–old class correlation via distribution discrepancies. Then, the Dimension-level Prototype Refinement (DPR) module adapts prototypes to the new feature space by this correlation and performs differentiated dimensional operation to preserve old-class discriminability. Moreover, the Long-term Selective Knowledge Transfer (LSKT) mechanism leverages correlation for class-aware selective distillation, coupled with feature-level adaptive distillation, achieving targeted old knowledge transfer without impeding new knowledge learning. Extensive experiments validate the effectiveness of our method. Compared with SOTA methods, it achieves average accuracy gains of 2.29%, 1.69%, 3.32% on CIFAR-100, 2.17%, 1.68%, 1.70% on TinyImageNet, and 0.05% on ImageNet-subset across various settings. Furthermore, our method achieves competitive performance in the practical Lifelong Person Re-Identification scenario.}
}
@article{CHOWDHURY2026116175,
title = {DEGD: Learning a Dual-Encoder Gated Decoder for graph data augmentation},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116175},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116175},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009019},
author = {Shayhan Ameen Chowdhury and Md Azher Uddin and Young-Koo Lee},
keywords = {Graph neural networks, Graph data augmentation, Dual-encoder gated decoder, Structural feature fusion encoder, Stochastic context-aware encoder, Gated decoder, Adaptive dual-thresholding interpolation},
abstract = {This paper proposes a novel end-to-end graph data augmentation framework based on edge prediction and manipulation to enhance the generalization of graph neural network (GNN)-based models for node classification, addressing the limitations of existing methods in effectively balancing local and global feature aggregation under sparse and complex graph structures. We first introduce a Dual-Encoder Gated Decoder (DEGD) architecture that explicitly integrates local structure cues and global contextual information through two complementary components: a Structural Feature Fusion Encoder (SFFE) and a Stochastic Context-Aware Encoder (SCAE). The SFFE aggregates neighborhood evidence using complementary pooling heads to capture both dominant and subtle local patterns, while the SCAE samples multi-hop neighborhoods to model broader contextual dependencies. A learnable Gated Decoder then estimates pairwise gating weights and combines the adjacency scores derived from the two encoders into unified edge probabilities. To prevent the predictor from drifting away from the original graph, we further propose an adaptive dual-thresholding interpolation strategy that weights predicted and original adjacencies before sampling sparse graph variants. Finally, a GNN is employed to learn embeddings for node classification. Extensive experiments on ten benchmark datasets show that our approach achieves average micro-F1 improvements of 1.09% on CORA, 1.94% on CITESEER, 0.87% on PUBMED, 2.27% on PPI, 1.47% on AIR-USA, 2.63% on AMAZON COMPUTERS, 1.65% on AMAZON PHOTO, 2.43% on REDDIT, 1.89% on OGBN-ARXIV, and 1.65% on OGBN-PRODUCTS over state-of-the-art methods.}
}
@article{SOVATZIDI2026116130,
title = {Intuitionistic fuzzy cognitive maps for interpretable image classification},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116130},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116130},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008567},
author = {Georgia Sovatzidi and Michael D. Vasilakakis and Dimitris K. Iakovidis},
keywords = {Intuitionistic fuzzy sets, Fuzzy cognitive maps, Image classification, Interpretability},
abstract = {Recently, several deep learning (DL) approaches have been introduced aiming to cope with image classification tasks. Although these models are effective, they are considered “black-boxes”, as they do not provide explanations or justifications for their results. To deal with the challenge of interpretable image classification, a novel framework, named Interpretable Intuitionistic Fuzzy Cognitive Maps (Ι2FCM), is introduced. Intuitionistic FCMs (iFCMs) have been proposed as an extension of FCMs with the aim of offering a natural mechanism for evaluating the quality of their output through the estimation of hesitancy, a concept resembling human hesitation in decision making. In the context of image classification, hesitancy is considered as a degree of unconfidence with which an image is categorized to a class. To the best of our knowledge this is the first time iFCMs are applied for image classification. Further novel contributions of the introduced framework include the following: a) a feature extraction process focusing on the most informative image regions; b) a learning algorithm for automatic data-driven determination of the intuitionistic fuzzy interconnections of the iFCM, thereby reducing human involvement in defining the graph structure; c) an inherently interpretable classification approach based on image contents, providing understandable explanations of its predictions, using linguistic terms. Furthermore, the proposed Ι2FCM framework can be applied to DL models, including Convolutional Neural Network (CNN), rendering them interpretable. The effectiveness of Ι2FCM was evaluated on public datasets, achieving 92 % accuracy on Caltech-101 and 75 % on Caltech-256. Overall, Ι2FCM delivers competitive classification performance, while offering interpretable inferences.}
}
@article{TIAN2026116255,
title = {RERF-net: Rotation-equivariant enhancement and refined fusion network for multi-modal 3D detection},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116255},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116255},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009810},
author = {Di Tian and Jiahang Shi and Jiabo Li and Jiawei Wang},
keywords = {3D object detection, Rotation equivariant convolution, Feature refinement, Sensors fusion network},
abstract = {Multi-modal 3D object detection enables high-precision detection via fusing LiDAR geometric and camera semantic information. However, this study finds that factors such as camera viewpoint variations easily leading to feature representation distortion and the difficulty in balancing modality-specific and shared information significantly impact detection performance. To resolve the issue of feature distortion caused by camera viewpoint changes, this paper proposes a Rotation-Equivariant Convolution Module (RECM). It ensures that rotation equivariant enhancement does not disrupt the original feature flow through channel and scale adaptation, thereby improving the rotation equivariance of image features and mitigating feature distortion in multi-view scenarios. Secondly, to tackle the challenge of balancing modality-specific and shared information, which often leads to feature redundancy and insufficient exploitation of complementarity, this paper introduces a Dual-Feature Dynamic Refined Fusion Module (DFDRFM). For the specific features of images and point clouds, this module captures global and local correlations through multi-scale attention and subsequently filters redundant information via a gating mechanism, outputting enhanced shared features to strengthen modality complementarity. Building on these, this paper combines the RECM and the DFDRFM to propose a multi-sensor fusion network integrating LiDAR and cameras, termed RERF-Net. Compared to baseline methods, RERF-Net achieves a 1.6% improvement in the NDS metric and a 2.1% improvement in the mAP metric on the nuScenes dataset. These experimental results demonstrate the validity of the proposed algorithms, which are capable of improving both the accuracy and robustness. The code is set on https://github.com/sjh1213984445-commits/RERF-NET.git.}
}
@article{SULTAN2026116158,
title = {A fuzzy logic-driven machine learning framework for multi-class classification of students academic performance},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116158},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116158},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008841},
author = {Maheen Sultan and Muhammad Akram and Shaista Habib and Cengiz Kahraman},
keywords = {Fuzzy c-means clustering, Random forest algorithm, Correlation heatmap, Explainable artificial intelligence, Students performance},
abstract = {The foundation of a nation’s future lies in the performance of its students. Their academic success shapes not only their personal growth but also the strength and progress of the entire country. High-achieving students go on to become skilled professionals, innovators, and leaders who drive economic development and social change. In this way, student performance plays a vital role in building a knowledgeable and competitive society. Investing in education today ensures a stronger, brighter nation tomorrow. Student performance depends on various factors such as the quality of teaching, availability of learning resources, parental support, and a conducive learning environment. Motivation, mental health, and socio-economic background also significantly influence how well a student performs academically. Although previous studies have applied either clustering techniques or machine learning algorithms independently to evaluate student performance, they often lacked the ability to capture the uncertainty and overlap in student characteristics. This research addresses that gap by combining fuzzy c-means clustering, which allows for soft classification, with a machine learning algorithm. The hybrid model enhances the accuracy and interpretability of performance evaluation by leveraging the strengths of both methods. This integrated approach provides a more nuanced and data-driven understanding of student outcomes. In addition to this, explainable artificial intelligence technique is employed to provide a transparent and interpretable summary of how the proposed hybrid model functions. By integrating this technique, the research not only improves prediction accuracy but also ensures that the decision-making process is understandable to educators and stakeholders. Furthermore, feature distribution graphs and correlation heatmap are drawn to have visual understanding of the related features. At the last, comparison with existing techniques, limitations and future directions are being discussed.}
}
@article{MANAA2026116198,
title = {Improved VAE-GAN via mixture of Gaussians applied to brain tumor MRI classification},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116198},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116198},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600924X},
author = {Naouel Manaa and Nour Elislem Karabadji and Hassina Seridi and Mohamed Said Mehdi Mendjel and Wajdi Dhifli},
keywords = {Variational autoencoder, Generative adversarial network, Mode collapse, Diversity, Mixture of Gaussians model},
abstract = {Generative models have greatly advanced artificial intelligence by making it possible to create realistic data. However, these models often face mode collapse. This limitation prevents them from capturing the full diversity of the data, especially when trained on small datasets. This weakness is particularly noticeable in models like VAE-GAN, where using a simple (unimodal) Gaussian distribution as the sampling prior for generation is not enough to represent complex and varied data. This reduces the diversity and quality of the generated samples. To tackle this issue, we propose a novel generative framework called M-VAEGAN, which replaces the sampling prior for the GAN generator with a mixture of Gaussians to enable a more expressive and flexible latent space representation. M-VAEGAN incorporates regularization and jointly optimizes the mixture parameters alongside the VAE-GAN generator. This enhances its training stability and allows it to achieve better coverage of diverse data modes. Extensive experiments on CIFAR-10, toy data, freehand sketch and CelebA datasets demonstrate that our approach improves generative diversity compared to baseline GAN models. Furthermore, we apply M-VAEGAN in a real world application for brain tumor MRI augmentation. The results show that M-VAEGAN produces high fidelity synthetic samples that effectively balance class distributions, resulting in improved tumor classification accuracy over other augmentation methods.}
}
@article{REVIN2026116211,
title = {One AutoML to rule them all: Unified kernel-based approach for automated time series classification, regression and forecasting},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116211},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116211},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009378},
author = {Ilia Revin and Vadim Potemkin and Nikolay O. Nikitin},
keywords = {Machine learning, Time series, Evolutionary optimization, Classification, Regression, Forecasting, Kernel},
abstract = {We propose an automated machine learning approach for univariate and multivariate time series that can solve classification, extrinsic regression, and forecasting tasks in a unified manner. This is achieved through a kernel-based method that enables the design of an adaptive feature space—including statistical, frequency, and topological representations—for each modeling task. As part of this approach, we introduce MoKA (Mixture of Kernel Assumptions) for time series forecasting. In the experimental section, we compare our results with state-of-the-art solutions. The obtained results demonstrate that the proposed approach outperforms N-BEATS and AutoGluon on the SMAPE metric in 38% of forecasting cases, achieves higher accuracy in univariate classification than Hive-COTE 2.0 and InceptionTime, and shows comparable or superior performance to MultiROCKET and FPCR in regression tasks measured by RMSE, while maintaining model simplicity and interpretability.}
}
@article{YU2026116142,
title = {FedLDP: Model-heterogeneous Federated Graph Learning via Logits Decoupling and Personalization},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116142},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116142},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008683},
author = {Xiaoyang Yu and Qiyu Li and De Li and Rongbin Deng and Jinyan Wang},
keywords = {Graph neural networks, Federated learning, Model heterogeneity},
abstract = {In Federated Graph Learning (FGL), model heterogeneity is a real-world problem, as different clients choose local models based on their local data or personal preferences. Traditional parameter aggregation methods cannot perform parameter aggregation on the server side due to differences in model architecture. Existing work addresses this problem based on embedding prototyping, but we first demonstrate experimentally that traditional embedding-based prototype methods perform poorly on the client side due to representation space incompatibility, while using a logits-based prototype method can significantly improve the performance of local models, and we provide detailed theoretical proof. Based on this, we propose a novel FGL framework FedLDP. Specifically, we use logits instead of embedding vectors to generate prototypes, and the client employs knowledge decoupling to separate collaborative knowledge from local knowledge, thereby reducing redundancy. On the server side, we first build a collaboration graph that reflects the collaboration strength of different clients, and then perform personalized aggregation based on this graph. Extensive experiments on six benchmark datasets show that FedLDP significantly outperforms all state-of-the-art baseline methods, providing an effective new approach for heterogeneous FGL scenarios.}
}
@article{WANG2026116203,
title = {Towards a prompt-driven framework with state space models for UAV object tracking},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116203},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116203},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009299},
author = {Binbin Wang and Ziqing Yan and Lifeng Wang and Fasheng Wang and Fuming Sun and Haojie Li},
keywords = {UAV object tracking, Vision Mamba, State space model, Prompt learning},
abstract = {In recent years, UAV object tracking has demonstrated rapid development across various fields with extensive application value. However, the variability of real-world applications poses three specific challenges that make existing trackers fail to accurately predict object states: (1) severe target appearance variations and temporary loss, (2) spatial detail degradation in deep network layers, and (3) the inherent misalignment between semantics-dependent classification and spatial-dependent regression tasks. To tackle these precise bottlenecks, this paper proposes a novel and concise tracking framework, Prompt-driven Lightweight Vision Mamba (PVMTrack), based on state space models (SSMs). Employing Vision Mamba as a single-stream tracking backbone, PVMTrack leverages exceptional global feature extraction and linear-complexity long-range dependency modeling. Specifically, PVMTrack comprises three pivotal components explicitly tailored to the aforementioned challenges. Firstly, to combat severe appearance variations, an efficient Template Prompting Generator (TPG) is developed to integrate visual information from initial and dynamic templates through prompt guidance. Secondly, to counteract spatial detail degradation in deep SSM layers, a Hierarchical Feature Aggregator (HFA) is designed to fuse deep semantic and shallow spatial features, thereby enhancing the multi-level representation capacity. Finally, to resolve the task misalignment, we implement an Enhanced Asymmetric Feature Prediction Head (EA-Head) that decouples classification and regression using corresponding feature levels, further refining localization precision. Extensive experiments conducted on seven UAV tracking benchmarks demonstrate that compared with other state-of-the-art trackers, our proposed tracker achieves superior tracking performance while maintaining a lightweight structure.}
}
@article{ZHANG2026116179,
title = {D2G-DCIM: A deep reinforcement learning and graph neural network-driven model for dynamic competitive influence maximization},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116179},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116179},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009056},
author = {Kaijing Zhang and Wenlong Zhu and Jiahui Zhong and Youruo Wang and Yukun Ma and Qiaoyan Song and Shuangshuang Yang},
keywords = {Dynamic networks, Dynamic competitive independent cascade, Dynamic competitive influence maximization, Graph neural networks, Deep reinforcement learning},
abstract = {Influence maximization (IM) is a key research area in social network analysis with significant practical implications. However, most existing studies are confined to traditional static network frameworks and fail to adequately capture the complex dynamics of real-world social networks. Moreover, conventional methods often focus on the influence propagation process of a single entity, thereby neglecting the complex competitive interactions among multiple entities that commonly occur in real-world diffusion scenarios. To address these limitations, we propose a novel dynamic competitive independent cascade (DCIC) model designed to more accurately simulate the dynamic characteristics of real networks and the complexities of their propagation mechanisms. Building on this framework, we formulate the dynamic competitive influence maximization (DCIM) problem and prove its NP-hardness, as well as the monotonicity and submodularity of the objective function. Furthermore, we develop an end-to-end model named D2G-DCIM, which integrates graph neural networks and deep reinforcement learning to efficiently solve the DCIM problem. Extensive experiments on nine real-world network datasets demonstrate that the proposed D2G-DCIM model achieves strong performance: its influence spread closely approaches that of the classical greedy algorithm while significantly reducing computation time, highlighting its efficiency and practical applicability. (https://github.com/zwl1985/D2G-DCIM.git).}
}
@article{YANG2026116207,
title = {SCFP-Depth: Achieving robust self-supervised monocular depth estimation via static compensation and frequency-domain priors},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116207},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116207},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009330},
author = {Chaochao Yang and Yuanyao Lu and Ziyue Wang},
keywords = {Monocular depth estimation, Self-supervision, Wavelet transform, Fourier transform, Cost volume},
abstract = {Self-supervised monocular depth estimation is highly vulnerable to moving objects, which violate the static-scene assumption and cause feature mismatches and occlusions during view synthesis, leading to significant degradation in depth accuracy. To address this, we propose SCFP-Depth, a two-stage framework designed for robust monocular depth estimation in complex scenes. The framework first decouples dynamic and static regions using an adaptive dynamic masking mechanism together with a pretrained optical flow network. A static assumption compensation module (SAC) then generates pseudo-static frame pairs, providing reliable self-supervisory signals for subsequent depth refinement. To further refine depth estimates, we introduce a direction-perception cost volume (DPCV) based on the dual-tree complex wavelet transform (DTCWT), which captures low-frequency semantic structures and high-frequency multi-directional edge details in the frequency domain, thereby strengthening local geometric priors and fine-grained matching. In addition, we design a Fourier-based global information modulation module (GIMM) that integrates multiscale complex filters with a gated fusion mechanism to modulate the fused features and geometric priors, adaptively boosting critical frequency responses while suppressing spatial noise. Experimental results on KITTI, Cityscapes, and Make3D demonstrate that our method consistently outperforms existing representative approaches in both static and dynamic regions, achieving state-of-the-art performance. The code is available at https://github.com/Sixcoins6-maker/SCFP-Depth.}
}
@article{YANG2026116191,
title = {DAGNN: Disentangled Asymmetric Graph Neural Network for unsupervised graph domain adaptation},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116191},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116191},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009172},
author = {Xiaoyu Yang and Junhai Zhai and Jiankai Chen},
keywords = {Graph Neural Networks, Knowledge transferring, Distribution alignment, Representation disentanglement, Unsupervised Graph Domain Adaptation},
abstract = {Unsupervised Graph Domain Adaptation (UGDA) aims to transfer knowledge from a label-rich source graph to an unlabeled target graph by alleviating distribution shifts. Unlike most existing methods, the recent A2GNN approach presents an elegant asymmetric encoder architecture, yielding state-of-the-art performance in UGDA tasks. However, this approach solely focuses on domain-invariant representations while neglecting domain-specific representations and simply adopts the vanilla Maximum Mean Discrepancy (MMD) for distribution alignment while overlooking the inherent topological properties of graphs, which leads to suboptimal cross-domain transferability. To address these limitations, we propose a novel Disentangled Asymmetric Graph Neural Network (DAGNN), which not only explicitly disentangles domain-invariant and domain-specific representations, but also fully accounts for the topological characteristics of graphs in distribution alignment. Specifically, we employ asymmetric encoders for both domains to learn disentangled representations, where domain-shared encoders learn domain-invariant representations with shared parameters and domain-private encoders learn domain-specific representations with independent parameters, and further design corresponding decoders for feature reconstruction to preserve intrinsic information. Moreover, we develop a dedicated Topology-aware Maximum Mean Discrepancy (TMMD) which weights node pairs by their topological connection strength in the MMD computation to achieve effective cross-domain distribution alignment. Comprehensive experiments on real-world datasets demonstrate the superiority of DAGNN.}
}
@article{QU2026116183,
title = {MS-DCL: Multi-Scale Decoupled Contrastive Learning for universal AI-generated image detection},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116183},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116183},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009093},
author = {Wei Qu and Cong Chen and Wei Lu and Tao Li},
keywords = {AI-generated image detection, Multi-scale learning, Feature disentanglement, Contrastive learning, Efficient deployment},
abstract = {Rapid development of AI-generated content (AIGC), particularly driven by generative adversarial networks (GANs) and diffusion models, poses significant challenges for AI-generated detection due to the increasing realism, diversity, and domain variability of synthetic imagery. Existing detectors often overfit to semantic content and generalize poorly to unseen generators and domains. These limitations arise primarily from over-reliance on semantic content, inadequate modeling of multi-scale generative artifacts, and limited cross-domain representation learning. To address these challenges, we propose MS-DCL, a Multi-Scale Decoupled Contrastive Learning framework for universal AI-generated image detection. MS-DCL mitigates these limitations through the integration of four key components: (1) a multi-scale feature extractor that captures hierarchical generative artifacts across multiple resolution levels; (2) a feature disentanglement network that reduces dependency between generation-specific cues and semantic content; (3) a spatial–frequency dual-stream encoder that encodes complementary representations in both pixel and frequency domains; and (4) a supervised contrastive learning module that promotes generalizable and discriminative representations across domains. Extensive experiments on diverse datasets and generative models show that MS-DCL consistently outperforms state-of-the-art methods, with an average accuracy of 84.5% in cross-generator and 90.7% in cross-scene scenarios. Furthermore, visualizations and ablation studies validate the framework’s robustness and interpretability in capturing universal generative patterns across scales and modalities.}
}
@article{DENG2026116157,
title = {Enabling collaborative parametric knowledge calibration for retrieval-augmented Vision Question Answering},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116157},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116157},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600883X},
author = {Jiaqi Deng and Kaize Shi and Zonghan Wu and Huan Huo and Dingxian Wang and Guandong Xu},
keywords = {Retrieval-augmented generation, Multimodal knowledge reasoning, Multimodal Large Language Model, Knowledge-based Vision Question Answering},
abstract = {Knowledge-based Vision Question Answering (KB-VQA) systems address complex visual-grounded questions with knowledge retrieved from external knowledge bases. The tasks of knowledge retrieval and answer generation both necessitate precise multimodal understanding of question context and external knowledge. However, existing methods treat these two stages as separate modules with limited interaction during training, which hinders bi-directional parametric knowledge sharing, ultimately leading to suboptimal performance. To fully exploit the cross-task synergy in KB-VQA, we propose a unified retrieval-augmented VQA framework with collaborative parametric knowledge calibration. The proposed framework can effectively adapt general multimodal pre-trained models for fine-grained, knowledge-intensive tasks while enabling the retriever and generator to collaboratively enhance and share their parametric knowledge during both training and inference. To enhance fine-grained understanding of questions and external documents, we also integrate late interaction mechanism into the training framework. Additionally, we introduce a reflective-answering mechanism that allows the model to explicitly evaluate and refine its knowledge boundary. Our approach achieves competitive performance against state-of-the-art models, delivering a significant 7.5% improvements in base MLLMs’ VQA performance.}
}
@article{YANG2026116246,
title = {ReDi-Net: Discarding redundancy and mining discriminative features for few-shot point cloud classification},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116246},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116246},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600972X},
author = {Liu Yang and Xu Liu and Yangyang Zhang and Wenhang Yang and Shouzheng Zhu and Chenhui Hu and Xin He and Fashuai Li and Chunlai Li and Yuwei Chen},
keywords = {Few-shot learning, Point cloud classification, Point-feature selection, Point cloud representation learning},
abstract = {3D point cloud few-shot learning (3DPC-FSL) has gained traction; however, learning generalizable and robust representations from real-world scans remains challenging. Most existing 3DPC-FSL methods leverage as many point-wise features as possible from the input point set to maximize the information used for representation learning. However, our empirical analysis suggests that an increased number of point features does not necessarily enhance performance, whereas a reduced number of point features can yield superior performance. This phenomenon can be attributed to two key factors: (i) substantial redundancy among point-wise features, which dilutes discriminative cues during feature aggregation; and (ii) background clutter and sensor noise in real-world scans, which lead to spurious or unreliable features that contaminate the aggregated global representation. To address these problems, we proposed the discarding redundancy and mining discriminative features network (ReDi-Net), a unified, staged point-feature selection framework that progressively performs backbone point-feature selection, nonredundant feature selection, and discriminative feature mining to build compact yet informative representations. Furthermore, we introduced an adaptive point budget strategy that dynamically determines the point-feature budget for each sample, thereby enhancing robustness to variations in structural complexity, density, occlusion, and clutter. Extensive episodic evaluations on ModelNet40, ModelNet40-C, and ScanObjectNN demonstrated that our method remains competitive on clean benchmarks, while showing stronger robustness on corrupted and real-world point cloud datasets, with notable performance gains over the baselines on ScanObjectNN.}
}
@article{ZHANG2026115960,
title = {SurvGAN: A generative adversarial network model for tabular survival data},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {115960},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115960},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006866},
author = {Lu Zhang and Wenjun Wang and Changyuan Ji and Hong Wang},
keywords = {Survival analysis, Federated learning, Generative adversarial networks, Non-IID data},
abstract = {Tabular data are the most commonly used form of medical data and are essential in survival analysis. However, the development of robust survival models is often hampered by data privacy concerns and data scarcity, particularly in federated learning settings where local datasets can be small or imbalanced. To address these challenges, we introduce SurvGAN, a novel deep generative model specifically designed to produce high-quality synthetic tabular survival data. We rigorously evaluate SurvGAN on simulated and real-world datasets with varying censoring rates. The results demonstrate that SurvGAN consistently outperforms existing generative models (e.g., CTGAN, TVAE) across multiple data quality metrics and in downstream predictive performance. To demonstrate its practical utility, we integrate SurvGAN into a federated survival analysis framework (FSA-SurvGAN) to mitigate the common Non-IID problem where clients have skewed sample sizes or censoring rates. By generating synthetic data to balance local datasets, FSA-SurvGAN effectively alleviates client drift. The results position SurvGAN as a powerful and flexible tool for generating realistic survival data, with significant potential to enhance both centralized and privacy-preserving federated learning analyses.}
}
@article{THEOCHARIDIS2026116162,
title = {Comparing knowledge graphs vs. LLMs for customers’ sentiment analysis of product reviews},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116162},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116162},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008889},
author = {Theocharis Theocharidis and Panagiotis Symeonidis},
keywords = {Semantic similarity, Knowledge graphs, Large Language Models, Sentiment analysis, Natural language processing, User reviews, BERT, Algorithm evaluation, Text mining},
abstract = {We present a novel comparative framework for sentiment analysis in product reviews that combines structured semantic similarity methods with Large Language Models (LLMs). We introduce two new algorithms, iSense and xSense, which leverage lexical knowledge graphs and an ensemble-based strategy to detect product safety issues through semantic proximity. Unlike purely neural models, our approach enables transparent and interpretable sentiment classification aligned with regulatory vocabularies. We evaluate the methods on both synthetic and real-world datasets, including over 1.8 million Amazon reviews in the “Toys and Games” category. Experimental results demonstrate that xSense not only matches but in some cases surpasses the performance of state-of-the-art models such as BERT, achieving an F1 score of 0.97. The main innovation lies in combining knowledge-guided semantic similarity with an adaptive weighting strategy for safety-oriented sentiment classification, showing that structured semantic reasoning can provide a competitive and interpretable alternative to purely neural approaches, with implications for consumer safety analytics and hybrid AI systems.}
}
@article{HAN2026116138,
title = {Optimizing multi-compartment vehicle routing in the first-mile logistics of fresh agricultural products using variable neighborhood search},
journal = {Knowledge-Based Systems},
volume = {346},
pages = {116138},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116138},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008646},
author = {Jialin Han and Mengru Zhang and Xiaoyun Xiong and Yusheng Wang},
keywords = {Optimization, Logistics, Multi-compartment vehicle routing, Variable neighborhood search, Clustered demands},
abstract = {Fresh agricultural products are highly vulnerable to post-harvest losses and spoilage. Efficient first-mile logistics is essential for transporting these products from their origins to preliminary processing facilities, where necessary operations can be performed to reduce losses and preserve market value. This paper investigates a multi-compartment vehicle routing problem in the context of first-mile logistics for fresh agricultural products. The problem involves vehicles whose capacity is divided into multiple compartments, allowing them to accommodate products with different temperature requirements simultaneously. Additionally, we account for the spatially clustered nature of product origins, wherein geographically proximate and densely situated origins can be aggregated into clusters. To address this problem, we first formulate a mixed integer programming model and then develop an effective variable neighborhood search algorithm. The novelty of the proposed algorithm lies in designing a range of tailored strategies to generate effective routes and guarantee feasible visits to clustered transportation demands. These strategies include a two-phase savings algorithm for initial solution construction, bilevel neighborhood structures to escape local optima, and a trilevel local search engine. Finally, we illustrate the effectiveness of our approach through real-world problem instances, which demonstrates the algorithm’s performance and provides managerial insights under varying decision-making scenarios.}
}