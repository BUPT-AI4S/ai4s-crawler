@article{YE2026116525,
title = {Eliciting CLIP’s intrinsic attribute knowledge through a dual-cache guided mechanism for class-incremental learning},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116525},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116525},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012517},
author = {Shengcheng Ye and Ziyi Wang and Yaomin Huang and Faming Fang and Guixu Zhang},
keywords = {Class-incremental learning, Visual language model, Attribute knowledge, Catastrophic forgetting, CLIP},
abstract = {Class-Incremental Learning (CIL) is a learning paradigm where a model progressively learns new classes over time without forgetting previously learned ones. To handle this challenge task, pre-trained vision-language models such as CLIP are introduced for its strong generalizability. Despite their effectiveness, existing methods mainly adapt CLIP for CIL using global image-text representations, limiting their ability to discern detailed attributes for each class. Recent advances applied extra Large Language Model (LLM) to supplement description of class attributes, yet causing inference deficiency. In this work, we consider the internal knowledge inherently in CLIP, aiming to elicit its class attributes for CIL. Specifically, we propose a dual cache mechanism to capture and store informative local attributes and global semantics. During inference, the stored attributes are combined and fused with the text output to convey detailed information. To further mitigate catastrophic forgetting, we introduce an orthogonalization-based incremental update strategy for dual cache after each training stage. Leveraging the saved attributes, the model can emulate human learning process, alleviating stability and plasticity dilemma. Experiments on several benchmarks show that our method achieves state-of-the-art results.}
}
@article{SANCHEZLOPEZ2026116436,
title = {GAUFS: Genetic Algorithm for Unsupervised Feature Selection for clustering},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116436},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116436},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011627},
author = {José E. Sánchez-López and Salvador de-la-Torre-Gonzalez and Antonio Bello-Castro and José M. Núñez-Portero and José C. Riquelme},
keywords = {Unsupervised feature selection, Clustering, Cluster number estimation, Genetic algorithm, Wrapper method},
abstract = {Traditionally, Unsupervised Feature Selection (UFS) for clustering has been formulated as a ranking of features task under an assumed number of clusters. More recent UFS families can learn feature relevance without pre-specifying the number of clusters, but most do not infer it as part of the method, meaning that few proposals tackle the full problem of returning a feature subset and an estimated number of clusters. This work introduces GAUFS, a wrapper method based on a genetic algorithm (GA) that jointly identifies an informative feature subset and estimates the number of clusters from the data. Candidate solutions encode both the subset and the cluster count; Hierarchical clustering together with Silhouette index provide a deterministic internal fitness. An elitist hall-of-fame mechanism aggregates evidence across evolutionary search to derive feature weights, and an automatic stopping rule selects the subset size at which further features cease to improve a combined quality criterion, assigning the associated cluster estimate. In addition, two synthetic data generators are designed to test feature selection under controlled separability and axis-aligned projection ambiguity. Across 60 datasets (30 synthetic, 30 real), GAUFS attains near-perfect Adjusted Mutual Information (AMI) on synthetic benchmarks and outperforms eight established algorithms on real datasets, while returning both a concrete subset and an estimated cluster count. The findings indicate that coupling feature selection with the estimation of the number of clusters is critical for robust UFS in clustering. To enable fair comparison and strengthen reproducibility, the full implementation and the benchmark have been released publicly.}
}
@article{YAO2026116569,
title = {A survey on audio–visual large language models},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116569},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116569},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012955},
author = {Wenyi Yao and Roksana Yahyaabadi and Hossein Hassani and Soodeh Nikan},
keywords = {Audio–visual systems, Large language models, Multimodal learning, Vision-language models},
abstract = {Human cognition inherently combines information from multiple senses, motivating artificial intelligence (AI) systems that can jointly process temporally dynamic and semantically rich inputs for naturalistic interactions. Although vision–language models (VLMs) have demonstrated remarkable achievements in learning aligned vision and text embeddings for cross-modal retrieval and generation, integrating audio into this process complements the temporal cues for enriched contextual understanding. In this context, audio–visual large language models (AV-LLMs) mark a significant progression in multimodal representation learning through joint encoding and cross-modal alignment of auditory, visual, and linguistic modalities. This survey is the first of its kind to address the gap between existing VLM surveys and the integration of audio as an additional modality. In particular, this survey presents a comprehensive overview of AV-LLMs by systematically categorizing model architectures, training objectives, and available datasets. We identify current methodological trends, limitations, and downstream applications, including audio and video captioning, multimodal conversational AI, and cross-modal retrieval. Finally, we outline key challenges and future research directions to advance the development of robust and generalizable multimodal language models. Resources are available at https://github.com/AiX-Lab-UWO/Audio-Visual-LLMs-Survey.}
}
@article{HU2026116565,
title = {A graph neural network-based framework for hierarchical time series forecasting in retail},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116565},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116565},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012918},
author = {Guoping Hu and Ciprian Doru Giurcăneanu and Qian Chang and Yunjun Yu},
keywords = {Hierarchical retail forecasting, Graph neural network, End-to-end learning, Bottom-up nonlinear reconciliation, Deep learning},
abstract = {Hierarchical time series forecasting in retail requires forecasts that are both accurate and aggregation coherent across multiple levels. Most existing methods follow a two-stage pipeline that first generates base forecasts and then reconciles them, which limits the exploitation of hierarchical structure in learning. We propose an end-to-end graph-based neural reconciliation framework that jointly models hierarchy-aware dependencies, temporal dynamics, and coherent forecasting within a single differentiable architecture. The framework combines graph neural networks and gated recurrent units with an explicit bottom-up reconciliation module that guarantees exact aggregation consistency. We evaluate the framework on two retail datasets, Italian and Walmart, under both without-promotion and with-promotion settings. The strongest variants, TGLP-BUN (Temporal Graph Linear Projection with Bottom-Up Nonlinear reconciliation) and TALP-BUN (Temporal Attention Linear Projection with Bottom-Up Nonlinear reconciliation), achieve the strongest overall performance against strong statistical and end-to-end deep-learning baselines. The gains are concentrated at higher levels on the sparse Italian hierarchy and are more broadly distributed across the Walmart hierarchy, especially when promotional information is included. Node-wise error distributions and Diebold–Mariano tests further show that these improvements are systematic across series rather than driven by only a small subset of nodes.}
}
@article{YANG2026116557,
title = {WeCo-OSAR: Weighted Contrastive Learning for Open-Set Skeleton-based Action Recognition with pseudo-OOD samples},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116557},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116557},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012839},
author = {Chao Yang and Dongyue Chen and Dingyu Xue and Shizhuo Deng and Tong Jia},
keywords = {Skeleton-based action recognition, Open-set recognition, Pseudo-OOD generation, Contrastive learning},
abstract = {Skeleton-based Action Recognition (SAR) has excelled in close-set scenarios, yet its real-world deployment is hindered by the inability of existing methods to handle unknown action classes in unpredictable open environments. To bridge this gap, we introduce WeCo-OSAR, a unified framework for open-set SAR that integrates multimodal semantic alignment, pseudo-OOD (pOOD) sample generation, and dual-weighted contrastive learning. Specifically, we first propose Mean-Weighted Contrastive Learning (MWCL) to explicitly align multimodal features, ensuring cross-modal semantic consistency while enhancing feature discriminability. Subsequently, a Cross-Class-Modality (CCM) Mixup strategy is developed to synthesize diverse, high-quality pOOD samples via spherical interpolation, effectively overcoming the scarcity of real OOD training data. Finally, we design Dual-Weight Coupling Contrastive Learning (DWC-CL) to optimize the hyperspherical separation between In-Distribution (ID) and pOOD features, significantly bolstering the model’s capacity to reject unknown actions. Extensive experiments demonstrate that WeCo-OSAR consistently outperforms state-of-the-art competitors across multiple open-set protocols on the NTU RGB+D 60 and NTU RGB+D 120 datasets, while exhibiting competitive generalization performance on the Toyota SmartHome dataset. This work not only addresses multimodal alignment challenges in open-set SAR but also establishes an effective paradigm for pOOD-based generalization in realistic open scenarios.}
}
@article{GIUSTI2026116594,
title = {Fraud is not just rarity: A causal prototype attention approach to realistic synthetic oversampling},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116594},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116594},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013201},
author = {Claudio Giusti and Luca Guarnera and Mirko Casu and Sebastiano Battiato},
keywords = {Credit card fraud detection, Noise detection, Class imbalance, Oversampling, Generative models, Interpretable machine learning},
abstract = {Detecting fraudulent credit card transactions remains a significant challenge, due to the extreme class imbalance in real-world data and the often subtle patterns that separate fraud from legitimate activity. Existing research commonly attempts to address this by generating synthetic samples for the minority class using approaches such as GANs, VAEs (Variational Autoencoders), or hybrid generative models. However, these techniques, particularly when applied only to minority-class data, tend to result in overconfident classifiers and poor latent cluster separation, ultimately limiting real-world detection performance. In this study, we propose the Causal Prototype Attention Classifier (CPAC), an interpretable architecture that promotes class-aware clustering and improved latent space structure through prototype-based attention mechanisms and we couple it with the encoder of a Variational Autoencoder–Generative Adversarial Network (VAE-GAN) in order to achieve improved latent cluster separation moving beyond post-hoc sample augmentation. We compared CPAC-augmented models to traditional oversamplers, such as SMOTE, as well as to state-of-the-art generative models, both with and without CPAC-based latent classifiers. Our results show that classifier-guided latent shaping with CPAC delivers superior performance, achieving an F1-score of 93.74% and recall of 92.85%, along with improved latent cluster separation. Further ablation studies and visualizations provide deeper insight into the benefits and limitations of classifier-driven representation learning for fraud detection. The codebase for this work can be found at the following link: https://github.com/claudiunderthehood/VAEGAN-CPAC.}
}
@article{FU2026116573,
title = {Hybrid adaptive graph transformer: Integrating neighborhood diversity and structural distillation},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116573},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116573},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012992},
author = {Yang-Geng Fu and Wen Meng and Jianzhi Zhuang and Xinlong Chen},
keywords = {Graph neural network, Graph transformer, Node classification, Deep learning},
abstract = {Graph neural networks are widely used for node classification because they can learn useful information from local neighborhoods. However, their strong focus on nearby nodes may limit their ability to capture long range relations, especially on graphs where connected nodes may have different labels. Graph Transformers can model global node relations, but they often need better graph structure guidance and may not work well when labeled data is limited. To address these issues, we propose Hybrid Adaptive Graph Transformer, named HAGT, for semi-supervised node classification. The central modeling principle of HAGT is to allocate local and global information for each node. HAGT combines a local attention expert that preserves 1-hop structural information with a global attention expert guided by a row-normalized Personalized PageRank (PPR) prior. A node-wise gate measures local neighborhood reliability from raw-feature deviation and then adaptively fuses the two representations. In addition, a GAT teacher is used during training to provide soft guidance and improve the training of the Transformer student. Experiments on eight benchmark datasets show that HAGT achieves competitive results across homophilic and heterophilic graphs, with the best average rank under the same evaluation setting.}
}
@article{CHENG2026116561,
title = {Ultrasound-based spinal detection for scoliosis screening via center-point prediction},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116561},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116561},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012876},
author = {Junjie Cheng and Tianyu Wang and Chen Zhang and Dinh Tan Nguyen and De Yang and Yongping Zheng and Sai Ho Ling},
keywords = {Ultrasound imaging, Spinal detection, Deep learning, Keypoint localization, Spinal diagnostics},
abstract = {Spinal ultrasound imaging offers a radiation-free and cost-effective alternative to X-rays for scoliosis screening, with advantages such as non-ionizing radiation, affordability, and effective soft tissue visualization. These characteristics make it a promising modality for clinical applications, especially in pediatric and frequent monitoring scenarios. However, inherent challenges—such as low contrast, high speckle noise, and various imaging artifacts—significantly degrade image quality, posing difficulties for downstream tasks like anatomical landmark detection. This limitation hinders the deployment of fully automated AI-based diagnostic systems. AI techniques have been applied to spinal ultrasound imaging in previous studies, employing models such as Faster R-CNN, YOLOv8, and YOLOv11 for vertebrae detection. However, challenges in robustness and anatomical prior modeling remain. To address these challenges, we propose a novel framework for the accurate detection of spinal bones in spinal ultrasound images, based on an enhanced YOLOv11 architecture. Our method introduces (1) a heatmap-based center-point branch modeling spinal locations as 2D Gaussians and (2) an Anatomical Spatial Interaction Module that fuses spatial and semantic features via coordinate injection and attention mechanisms. Evaluated on a clinical spinal ultrasound dataset, our approach outperforms these prior methods, achieving a 2.4-point gain in mAP@0.5:0.95. These results demonstrate the potential of our framework as an effective tool for radiation-free, AI-assisted spinal assessment.}
}
@article{SHI2026116545,
title = {KAME: Knowledge-Aware Modality Enhancement for knowledge-level frame-event fusion in autonomous driving},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116545},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116545},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012712},
author = {Peijun Shi and Chee-Onn Chow and Wei Ru Wong},
keywords = {Event cameras, Frame-event fusion, Multimodal large language models, Autonomous driving perception, Knowledge injection},
abstract = {Conventional multimodal perception systems for autonomous driving rely on data-driven learning and lack explicit mechanisms for reasoning about domain knowledge, such as sensor reliability and temporal risk, a gap that matters most where modality reliability varies, as in tunnel transitions and nighttime driving. We propose Knowledge-Aware Modality Enhancement (KAME), a framework that formalises sensor physics and driving-domain knowledge as executable rules and injects them into Multimodal Large Language Models (MLLM) as structured natural-language context. The RGB frame enters only as reliability metadata rather than as an encoder input, so the two modalities combine exclusively in the model’s language-level reasoning. We call this knowledge-level frame-event fusion, as distinct from fusion at the data, feature, token, or decision level, and it leaves the model architecture unchanged. KAME comprises a Modality-Aware Knowledge Descriptor (MAKD) that encodes sensor reliability from physical measurements and a Temporal Dangerous Event Knowledge Extractor (TDKE) that models safety-critical temporal dynamics in event streams, both generated deterministically so that the reasoning remains interpretable and traceable. On 500 samples from the Driving Stereo Event Camera dataset, KAME raises the average Perceptual Accuracy of EventGPT-7B from 0.68 to 0.80 without retraining, while an adapted training-based feature-fusion baseline reaches 0.73, confirming that knowledge injection and feature alignment address different failure modes. The gains also transfer to a general-purpose MLLM and partially generalise to MVSEC, where 50-sample recalibration further improves performance. These results establish KAME as a portable, interpretable, and training-free approach to sensor-physics-aware MLLM perception under illumination degradation.}
}
@article{YANG2026116307,
title = {Towards combining multiple knowledge graphs for large language models reasoning},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116307},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116307},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010336},
author = {Hong Yang and Zigen Zhang and Chengcheng Deng and Xiaoyan Zhu and Li Ma and Peng Zhang and Shirui Pan},
keywords = {Large language models, Multiple knowledge graphs, LLM reasoning},
abstract = {Large language models (LLMs) have achieved remarkable success in reasoning tasks. However, LLMs often produce hallucinations and incorrect reasoning results due to lack of up-to-date domain knowledge. Knowledge graphs build structured networks of entity relationships, providing LLMs with reliable background knowledge to reduce errors. However, existing LLM reasoning methods based on knowledge graphs assume that only a single knowledge graph is available, which often leads to missing key facts and biased information. In this paper, we propose to combine multiple knowledge graphs for LLM reasoning (MKG4LLM for short) to improve the accuracy and reliability of LLM reasoning. First, MKG4LLM sets a learnable weight for each knowledge graph and then maximizes the likelihood function of the LLM reasoning based on multiple weighted knowledge graphs. To learn both the weight parameters of the knowledge graphs and the fine-tuned LLM parameters for reasoning, a variational inference algorithm is used to approximately optimize these weight parameters. By retrieving weighted reasoning paths from the knowledge graphs, MKG4LLM extracts useful knowledge for LLM reasoning. The experimental results show that MKG4LLM outperforms existing methods in popular KGQA datasets.}
}
@article{LIU2026116537,
title = {Explainable extrapolation on temporal knowledge graphs via relation-driven and context-aware logical rules},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116537},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116537},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012633},
author = {Zichen Liu and Li Cai and Mei Ma and Shihang He and Haoyu Wang and Ruizhang Huang and Yongbin Qin and Yanping Chen and Ruina Bai},
keywords = {Temporal knowledge graph, Explainable, Rule learning, Context-aware, Link prediction},
abstract = {Extrapolation on temporal knowledge graphs (TKGs) aims to predict future events based on historical facts, thereby supporting dynamic decision-making. Although neural network-based approaches have achieved promising results, they often suffer from limited interpretability, whereas rule-based approaches primarily focus on enhancing the explainability of predictions. However, existing rule-based methods face two critical limitations: (1) they neglect the dynamic evolution of relations and fail to capture semantic transitions; and (2) they overlook recurrent interaction patterns and the contextual dependencies between historical and future events. To address these challenges, we propose RCLR, a novel framework that integrates relation-driven and context-aware logical rules to improve predictive accuracy and interpretability jointly. RCLR introduces a relation-driven Markov transition matrix to guide temporal random walks, effectively capturing the dynamic evolution of relational semantics. Simultaneously, it extracts three categories of context-aware logical rules (Precursor, Bridging, and Consequent rules), enabling the discovery of expressive and contextually coherent reasoning patterns that transcend conventional rule mining constraints. Extensive experiments on six benchmark datasets demonstrate that RCLR consistently outperforms state-of-the-art methods, achieving up to a 13.13% improvement in Mean Reciprocal Rank (MRR). Moreover, RCLR provides interpretable reasoning paths for its predictions, offering transparent insights into the temporal extrapolation process.}
}
@article{ZHANG2026116489,
title = {FusionHash: Empowering cross-modal hashing with fine-grained knowledge fusion},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116489},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116489},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012153},
author = {Qian Zhang and Yi-Fei Zhu and Bo-Lin Zhang and Xiao-Qian Liu and Yu-Wei Zhan and Zhen-Duo Chen and Xin Luo and Xin-Shun Xu},
keywords = {Cross-modal retrieval, Supervised hashing, Multi-modal information fusion},
abstract = {With the explosive growth of multi-modal data across various platforms, efficient and accurate retrieval of similar information has emerged as a critical challenge. To tackle this, cross-modal hashing has gained significant attention due to its efficiency in reducing storage and computation costs while maintaining satisfactory search results. Despite substantial progress in this field, two limitations remain: the utilization of supervisory information is not sufficient enough, and the fusion of modal information is not strong enough. To fill the aforementioned gaps, we propose a novel method called FusionHash. Specifically, FusionHash first leverages large language models to expand raw labels into class-specific characteristic descriptions that embed fine-grained knowledge. It then refines both feature extraction and hash function learning by fusing this fine-grained knowledge via contrastive learning, significantly enhancing cross-modal alignment. Extensive experiments on three benchmark datasets demonstrate the superiority of our approach over state-of-the-art methods. Notably, on the challenging NUS-WIDE dataset, FusionHash achieves remarkable mAP@50 performance improvements of 4.7% and 7.7% in image-to-text and text-to-image retrieval tasks, respectively.}
}
@article{YIN2026116513,
title = {Discrepancy-Consistency Bi-Knowledge Fusion for unsupervised video anomaly detection},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116513},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116513},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012396},
author = {Awei Yin and Wei Liu and Xiao Wang and Ao Huang and Zheng Wang and Xin Xu},
keywords = {Unsupervised video anomaly detection, Discrepancy Knowledge Learning, Consistency knowledge learning, Knowledge fusion},
abstract = {Unsupervised Video Anomaly Detection (UVAD) faces significant challenges due to insufficient integration of heterogeneous data sources, such as scene context and spatio-temporal dynamics. Current methodologies primarily focus on moving targets, neglecting the interaction between these targets and their surroundings, and ignoring varying anomaly rates across different scenes, resulting in misclassifications of normal behaviors as anomalies and high false positive rates, especially in complex environments. To address these shortcomings, we propose Discrepancy-Consistency Bi-Knowledge Fusion (DCBF) for UVAD. The framework consists of Discrepancy Knowledge Learning (DKL), Consistency Knowledge Learning (CKL), and Bi-Knowledge Fusion (BKF). The DKL component characterizes action–scene relationships across different scenarios, thereby supporting scene-dependent anomaly modeling. The CKL module is predicated on the principle that the anomaly rate is intrinsically linked to the hazard rate specific to each scenario, which is computed based on statistical a priori knowledge. Furthermore, the fusion of discrepancy and consistency learning outcomes through BKF jointly guides the generation of the final anomaly scores, helping the framework incorporate both likelihood-based discrepancy cues and scene-level consistency priors for more reliable scene-dependent anomaly scoring. Extensive experiments on four benchmark datasets show that DCBF achieves competitive performance, with AUC-ROC scores of 88.2% on HR-ShanghaiTech, 87.2% on ShanghaiTech, 75.4% on HR-UBnormal, and 74.9% on UBnormal. The source code and data are available at: https://github.com/YawJason/DCBF.}
}
@article{DUAN2026116481,
title = {Graph-guided generative oversampling via latent manifold representation for imbalanced data},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116481},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116481},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012074},
author = {Jinyan Duan and Siyu Qi and Chenyang Fan and Yongli Li},
keywords = {Decision support systems, Imbalanced learning, Graph topology awareness, Latent manifold representation},
abstract = {In risk-averse operational environments, such as financial fraud detection and medical screening, decision support systems face the critical challenge of asymmetric misclassification costs. While identifying minority crisis events is paramount, over-allocating operational resources to false positives drastically increases verification costs and induces alert fatigue, ultimately eroding the system's trustworthiness. Traditional data-level resampling methods often ignore the underlying nonlinear topological manifold of high-dimensional data, leading to linear piercing and classification noise. Meanwhile, existing deep generative models often suffer from mode collapse and a "high recall, low precision" dilemma when facing extremely scarce minority classes. To address these challenges, this paper proposes G3O (Graph-Guided Generative Oversampling), a framework that decouples resampling spatial positioning and feature generation. First, it accurately locates high-value boundary seeds using a global k-nearest neighbor graph and local imbalance factor (LIF), avoiding ineffective sampling in safe and noise regions. Second, it introduces a conditional variational autoencoder (CVAE) to extract the denoised intrinsic manifold, performing interpolation in the compact latent space with superimposed isotropic smooth perturbations. This mechanism expands minority class diversity at the decision boundary while strictly adhering to semantic validity. Large-scale Monte Carlo evaluations on 11 high-difficulty datasets across general, financial, and medical fields validate the framework. Results show that as a robust preprocessing engine, G3O seamlessly empowers domain benchmark algorithms (e.g., CS-GBM, RUSBoost), achieving statistically significant performance improvements in PR-AUC and F1-Score. This study provides a theoretically complete and generalizable paradigm for extreme skew distribution problems in high-risk scenarios.}
}
@article{NAKIP2026116533,
title = {Self-supervised online learning algorithm for rTPNN to reduce false alarms in fire detection},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116533},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116533},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012591},
author = {Mert Nakıp and Nur Keleşoğlu and Taylan Mert and Cüneyt Güzeliş},
keywords = {Fire detection, Self-supervised, Online learning, Human-in-the-loop, Multi-sensor},
abstract = {Commercial fire detectors often suffer from false positive alarms due to benign environmental variations, such as cooking odors, humidity, and smoke. In order to address this issue, we develop a self-adapting fire detection system with Sample & Sensor Selective Self Online Learning Algorithm (4-SOLA). This system is comprised of Recurrent Trend Predictive Neural Network (rTPNN) enhanced with 4-SOLA for a multi-sensor fire detector. The rTPNN model processes sensor data and makes decisions providing a real-time detection while 4-SOLA combines and orchestrates supervised transfer learning based on human feedback and self-learning using unlabeled and precisely selected sensor data. The proposed system is evaluated using two public datasets, namely the NIST indoor fire dataset and the EN 54 test room dataset. Results show that the rTPNN enhanced with 4-SOLA is the best performing model among nine different models, achieving a balanced performance of 0.75 TPR and 0.90 TNR on the NIST dataset, and 0.97 TPR and 0.94 TNR on the EN 54 dataset when human feedback is fully available. The rTPNN enhanced with 4-SOLA system demonstrates great potential for applications beyond fire detection, particularly for time-series systems that require adaptation to constantly updating data.}
}
@article{ZHOU2026116578,
title = {Enhanced label propagation for community detection based on node importance and node-group proximity},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116578},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116578},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013043},
author = {Xingxing Zhou and Zeshi Yin and Haiping Zhang and Xinyue Ye and Yizhang Wang},
keywords = {Social networks, Community detection, Local similarity, Label propagation},
abstract = {Community detection is a fundamental task in the analysis of complex networks. The Label Propagation Algorithm (LPA) is widely recognized for its linear time complexity and scalability. However, it often suffers from instability and suboptimal accuracy in practical applications. To address these limitations, this paper proposes NINP-LPA, an enhanced label propagation method that integrates an importance-guided label update order with a novel Node-Group Proximity (NGP) metric. The proposed algorithm operates through three key phases: (1) initial community construction, which builds upon the LBLD initialization by incorporating network structure enhancement and an importance-guided label update order to improve the reliability and quality of the initial partition; (2) label propagation sequencing, guided by node importance and refined using the NGP metric to optimize label diffusion dynamics; and (3) boundary label refinement, which leverages the network homophily principle to promote convergence and enhance community cohesion. Comprehensive experiments conducted on 12 real-world networks and 24 synthetic benchmarks demonstrate that NINP-LPA significantly outperforms both traditional and state-of-the-art community detection methods—including LBLD and LMFLS—in terms of Normalized Mutual Information (NMI) and Adjusted Rand Index (ARI). The results highlight the algorithm's robustness, accuracy, and suitability for applications requiring high stability, underscoring its potential for practical deployment in large-scale network systems.}
}
@article{DENG2026116582,
title = {An enhanced spatial-frequency fusion modulation for multi-instance learning on whole slide images},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116582},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116582},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013080},
author = {Bin Deng and Yonghong Yin and Chuanbo Qin and Zhipeng Mai and Weigang Yan and Miao Ren and Yi Zhou and Zhien Zhou and Zhiwei Xie and Yu Xiao and Junying Zeng},
keywords = {Whole slide image, Multi-instance learning, Spatial-frequency fusion, Mamba model},
abstract = {The classification of Whole Slide Image (WSI) is crucial in computational pathology. Although recent advances in Multiple Instance Learning (MIL) have achieved promising results for WSI classification, current MIL methods seldom jointly fuse long-range spatial dependencies with explicit frequency-selective cues at the instance enhancement stage, limiting their ability to capture both global context and fine structural details. To address this limitation, we propose a novel Spatial-Frequency Fusion (SFF) modulation for instance features enhancement. Specifically, SFF incorporates two newly designed modules – a Mamba-based Spatial Enhancement (MSE) module and an Adaptive Fourier Filter (AFF) module – to jointly model spatial dependencies and frequency-domain information. Experiments on breast, lung, and our in-house prostate cancer datasets demonstrate the effectiveness of SFF Modulation, showing substantial improvements over classical MIL methods and enabling more accurate diagnostic support.}
}
@article{LING2026116554,
title = {Topology geometry constrained open-set remote sensing object detection under class imbalance},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116554},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116554},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012803},
author = {Qiying Ling and Yuanyuan Li and Yiyao An and Zhiqin Zhu and Penglong Li and Xuan Chen and Jiaji Cheng},
keywords = {Open-set detection, Remote sensing images, Class imbalance, Hypergraph learning},
abstract = {Open-set remote sensing object detection is strictly constrained by the dual challenges of unknown class interference and class imbalance, which inevitably trigger severe false positives and missed detections. To address these issues, an open-set remote sensing object detection method based on topological geometric constraints is proposed. Specifically, to address false positives caused by unknown-class interference, a geometric constraint distribution learning module is proposed to improve intra-class compactness and inter-class separability in the embedding space. It uses class geometric centers as anchors. Alignment and uniformity constraints are jointly applied to improve intra-class compactness and inter-class separability. Furthermore, to alleviate missed detections caused by class imbalance, a higher-order topological balancing constraint is proposed. By exploiting hypergraph structures to capture shared structural patterns among minority classes. Experimental results demonstrate that the proposed method can effectively improve detection performance under both open-set and class imbalance distribution settings, while maintaining strong recognition capability for known classes.}
}
@article{ABDULELAH2026116546,
title = {Uncertainty-aware deep reinforcement learning for sustainable electric vehicle routing: A hybrid optimization framework},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116546},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116546},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012724},
author = {Aymen Jalil Abdulelah and Emrullah Sonuç and Esam Taha Yassen and Mohammed Nasser Al-Andoli},
keywords = {Deep reinforcement learning, Sustainable logistics, Graph attention networks, Uncertainty quantification, Carbon emissions reduction},
abstract = {Urban freight accounts for approximately 20% of transport-related greenhouse gas emissions, yet electric vehicle (EV) routing faces critical barriers: limited range, charging constraints, and energy uncertainty. Existing methods cannot quantify stranding risk or support chance-constrained battery feasibility, as energy consumption exhibits 30%–40% variability. We address the EVRPTW under operational uncertainty via probabilistic energy forecasting and hybrid optimization. Bidirectional LSTM networks deliver calibrated uncertainty quantification (94.7% empirical coverage for 95% confidence intervals), enabling model-based chance-constrained battery feasibility. Graph neural networks encode battery-aware spatial–temporal dependencies, while Proximal Policy Optimization with optional mixed-integer programming refinement balances real-time adaptability (0.3–0.8s inference) with offline solution quality. Evaluation on 30 Solomon-derived EVRPTW benchmark instances (60–100 customers) shows an 8.8% cost reduction over the strongest learning baseline (MVMoE), rising to 12.2% under dynamic conditions. Real-world deployment with a 25-vehicle electric fleet over 13 weeks validates €143,000 in projected annual savings, 98.1% on-time delivery, 15.5% energy reduction, and 96% planning time reduction, with fleet emissions at approximate carbon parity with diesel on Italy’s transitional grid alongside elimination of local air pollutants. Transfer learning protocols reduce region-adaptation retraining effort by ∼95% (from ∼72 h to 3–5 h of fine-tuning), requiring only 400–600 local routes. This work demonstrates a pathway toward more sustainable urban logistics through uncertainty-aware optimization with measurable environmental, economic, and operational benefits.}
}
@article{KUTSAL2026116549,
title = {Predicting international coalition formation with relational graph neural networks: A temporal heterogeneous approach with rich pooling},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116549},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116549},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601275X},
author = {Mücahit Kutsal},
keywords = {Coalition formation, Graph neural networks, Relational learning, International relations, Set representation learning},
abstract = {International coalitions (multilateral alliances, economic blocs, summit groups, and de facto arrangements) shape the post-1945 international order, yet automated prediction of coalition formation remains underdeveloped in computational political science. We cast coalition prediction as scoring variable-cardinality subsets of states on a temporal heterogeneous graph of inter-state relations, and present a model that couples a Relational Graph Convolutional Network encoder over four edge types (formal alliances, bilateral trade, UN voting affinity, militarized disputes) with a rich-pool coalition head that aggregates members through four statistics (mean, standard deviation, maximum, minimum) applied jointly to learned embeddings and raw node features. Trained on a hand-curated canon of historically observed coalitions (1946–2009) and evaluated on a strict 2010–2016 temporal hold-out across five random seeds, the model attains ROC-AUC 0.960 ± 0.004, significantly outperforming feature-only, set-based (DeepSets), and homogeneous-graph (GraphSAGE, GAT) baselines. Controlled experiments isolate the source of the gain: homogeneous graph encoders barely exceed a permutation-invariant set baseline, whereas heterogeneous relational modeling combined with rich pooling drives the improvement, and the benefit of rich pooling scales with encoder expressiveness. Symmetric multi-seed ablations further show that ablation conclusions can be fragile: an apparent pooling-dependent component reversal does not survive controlled evaluation. Finally, under a leave-one-coalition-out protocol the model detects entirely held-out coalitions zero-shot, tracking the relational consolidation of a bloc rather than its formal founding date. We also report transparently a residual late-period (2015–2016) degradation that appears only under adversarially constructed negatives.}
}
@article{XU2026116570,
title = {GLERO: Graph-LLM Enhanced Reward Optimization for mixed-traffic CAV control},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116570},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116570},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012967},
author = {Dongwei Xu and Qingsong Wang and Chengju Sun and Tongcheng Gu and Haifeng Guo},
keywords = {Connected and autonomous vehicles, Deep reinforcement learning, Large language models, Multi-view representation},
abstract = {In mixed traffic environments, Connected and Autonomous Vehicles (CAVs) face significant challenges in achieving efficient cooperation due to the stochastic nature of human driving behaviors, complex inter-vehicle interactions, and rigorous real-time safety constraints. Traditional control methods often fail to balance safety, traffic efficiency, and computational timeliness simultaneously. To address these limitations, this paper proposes a Graph–LLM Enhanced Reward Optimization (GLERO) framework. GLERO integrates a multi-view representation mechanism as a central hub to explicitly encode heterogeneous information, including road topology and dynamic vehicle interaction patterns. Specifically, a Graph-to-Language (G2L) module is designed to transform numerical graph data into structured, semantic natural language descriptions, thereby facilitating interpretable reasoning within Large Language Models (LLMs). Leveraging this semantic grounding, the LLM autonomously generates interpretable reward function codes. These candidates are rigorously validated using diverse Deep Reinforcement Learning (DRL) algorithms under a multi-dimensional evaluation protocol to identify the optimal reward structure for policy training. Extensive experiments demonstrate that GLERO substantially outperforms baseline models in terms of safety and efficiency across different LLM backbones. Ablation studies further confirm that the multi-view representation and the G2L module are pivotal in augmenting the reasoning capability of LLMs and enhancing overall system performance.}
}
@article{PATEL2026116534,
title = {Mitigating concept drift in malware classification: A temporal and resource-aware evaluation},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116534},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116534},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012608},
author = {Amit Patel and Deepak Singh Tomar and R.K. Pateriya and Rahul Haripriya},
keywords = {Concept drift, Malware detection, Decision making, Machine learning, Drift mitigation strategies, Adaptive machine learning, Cybersecurity analytics},
abstract = {Concept drift poses a fundamental challenge to federated malware detection systems, where client data distributions are non-IID and evolve continuously over time. Existing federated aggregation strategies such as FedAvg and FedSGD assign client weights based solely on dataset size, ignoring temporal drift and local model reliability, which leads to performance degradation under non-stationary malware conditions. This paper proposes a Drift- and Client-Aware Adaptive Aggregation (DCAA) framework that dynamically reweights client contributions during federated aggregation using three complementary signals: real-time KL divergence-based drift estimation, temporal recency decay, and validation-based reliability scoring. Unlike prior adaptive FL methods such as FedProx or FedDyn that address client heterogeneity through proximal regularization, DCAA explicitly targets the aggregation layer and maps distributional drift directly into client contribution weights, suppressing unstable updates before they propagate to the global model. The framework is evaluated on three benchmark malware datasets spanning static, hybrid, and dynamic behavioral modalities EMBER 2018, BODMAS 2021, and CIC-MalMem2022 under a federated binary classification setting with five heterogeneous clients and non-IID data partitions. Four local model architectures are considered: Random Forest, XGBoost, CatBoost, and TabNet. DCAA achieves up to 2.8% higher global accuracy and 2%–3% higher AUC compared to FedAvg, while reducing inter-client parameter divergence by 20%–25%. Scalability experiments confirm stable performance above 95% accuracy with up to 20 federated clients. These results demonstrate that drift-aware aggregation is a model-agnostic improvement that sustains detection performance in distributed malware intelligence pipelines operating under evolving and heterogeneous threat conditions.}
}
@article{ZHOU2026116522,
title = {A branch-and-bound approach for maximum low-diameter dense subgraph problems},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116522},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116522},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012487},
author = {Yi Zhou and Chunyu Luo and Zhengren Wang and Zhang-Hua Fu},
keywords = {(⋅)-dense graph, Degeneracy ordering, Branch-and-bound, Bound estimation},
abstract = {A graph with n vertices is an f(⋅)-dense graph if it has at least f(n) edges, f(⋅) being a well-defined function. The notion f(⋅)-dense graph encompasses various clique models like γ-quasi cliques, k-defective cliques, and dense cliques, arising in cohesive subgraph extraction applications. However, the f(⋅)-dense graph may be disconnected or weakly connected. To overcome this issue, we study the problem of finding an f(⋅)-dense subgraph of maximum cardinality with diameter at most two. Specifically, we present a decomposition-based branch-and-bound algorithm to optimally solve this problem. The key feature of the algorithm is a decomposition framework that breaks the graph into n smaller subgraphs, allowing independent searches in each subgraph. We also introduce decomposition strategies including degeneracy and two-hop degeneracy orderings, alongside a branch-and-bound algorithm with a novel sorting-based upper bound to solve each subproblem. Worst-case complexity for each component is provided. Empirical results on 139 real-world graphs under two f(⋅) functions show our algorithm outperforms the MIP solver and pure branch-and-bound, solving nearly twice as many instances optimally within one hour.}
}
@article{XIE2026116590,
title = {Compressed video-driven multimodal modeling and interaction for dynamic expression recognition},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116590},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116590},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601316X},
author = {Weicheng Xie and Junliang Zhang and Haijian Liang and Linlin Shen and Zhihui Lai and Siyang Song and Zitong Yu},
keywords = {Dynamic expression recognition, Compressed video, Modal-parallel temporal modeling, Multimodal interaction},
abstract = {Most existing dynamic facial expression recognition (DFER) algorithms are developed based on raw video data, e.g. using 3D CNN-, RNN-, or Transformer-based models to incorporate temporal cues of raw videos, while they overlook that the videos obtained in practice are compressed videos due to their advantage of low storage requirements. Consequently, these algorithms may overfit to redundant patterns in raw videos and fail to exploit the multimodal information available in compressed data. To address these problems, we propose a compressed video-driven framework for DFER. Unlike other schemes that use only decoded RGB frames, our approach is carried out entirely in the compressed domain and uses all readily available modalities, i.e., I-frames, motion vectors, and residuals, for the purpose of making full use of the compressed-video modalities and their interaction in the video. To obtain richer expression features, we design a multimodal interaction attention paradigm to model temporal modality sequences, inter-modal weighting, multimodal interaction, and intra-modal enhancement based on the compressed-video representation. Our algorithm benefits from not only the modal-parallel temporal modeling of the multimodal representation to take into account the characteristics of each modality, but also the inter-modal weighting, multimodal interaction and intra-modal enhancement. Extensive experimental and ablation studies have shown that our approach achieves state-of-the-art (SOTA) results in three benchmark datasets, i.e. Oulu-CASIA, AFEW and DFEW. Our codes are publicly available at https://github.com/JunLiangZ/CompressedVideo-DFER.}
}
@article{ZHANG2026116498,
title = {Singular transformation attack: Enhancing targeted transferability of adversarial examples via feature importance perturbation},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116498},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116498},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012244},
author = {Yaoyuan Zhang and Weizhi Meng and Feng Guo and Zhitao Guan and Yu-an Tan},
keywords = {Adversarial examples, Black-box attacks, Transferability, Deep learning, Robustness},
abstract = {Achieving effective targeted transferability in black-box adversarial attacks remains a significant challenge, particularly in scenarios requiring adversarial examples to induce specific misclassifications on unknown models. While existing transfer-based approaches often rely on indiscriminate input transformations, they typically overlook structured manipulation of intrinsic feature representations, thereby limiting targeted transferability. To address this limitation, we propose the Singular Transformation Attack (STA), a novel framework that strategically perturbs images in the singular value decomposition (SVD) domain. STA decomposes input images via SVD and applies stochastic perturbations to singular values, which quantitatively govern feature importance, generating multiple semantically consistent variants that simulate diverse decision boundaries across potential substitute models. Through gradient aggregation over these feature-space transformations, STA effectively aligns adversarial directions with transfer-critical regions. Comprehensive evaluations demonstrate STA’s superiority, with average improvements of 19.0% against convolutional neural networks, 19.3% against vision transformers, and 12.8% against defense models compared to baselines, achieving maximum attack success rates of 90.9%, 73.7%, and 63.5%, respectively. This work establishes feature-space perturbation in the decomposition domain as an effective paradigm for targeted adversarial attacks and provides a valuable tool for assessing model robustness in security-critical applications.}
}
@article{ZAKERI2026116550,
title = {Quantum-enhanced hyperdimensional computing for graph representation},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116550},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116550},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012761},
author = {Ali Zakeri and Prathyush Poduval and Mohsen Imani},
keywords = {Graph representation, Hyperdimensional Computing, Quantum computing, Vector Symbolic Architecture},
abstract = {Representing complex structured data often involves a tradeoff between computational cost and representational quality, largely determined by the underlying encoding framework. Hyperdimensional Computing (HDC), also known as Vector Symbolic Architecture (VSA), has been recognized for its ability to represent complex structures through high-dimensional encoding. Conventional representation techniques in HDC, which in many cases rely on the cognitive operation of bundling for data memorization, suffer from quality and capacity limitations. Association through the binding operation offers a potential alternative, but its use is complicated by the difficult decomposition process, where classical factorization methods, such as resonator networks, can become challenging as the number of candidate factors and bound components increases. In this work, we explore a novel approach based on a quantum factorization algorithm inspired by Grover’s quantum search algorithm within HDC. This approach not only addresses the complexity challenges inherent in the decomposition of bound HDC representations, but also significantly mitigates noise and improves representational fidelity. Focusing on graph data structures, our framework Quark is analyzed through theoretical derivations and classical simulations of the quantum decoding process, demonstrating improved graph reconstruction quality across different graph sizes and dimensionalities. This integration of quantum computing and HDC provides a promising direction for scalable and high-fidelity graph representation.}
}
@article{WANG2026116587,
title = {Fed-LPAR: Hierarchical personalization and adaptive regularization for differentially private federated learning},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116587},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116587},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013134},
author = {Hui Wang and Xia Liang and Peiqian Liu and Kun Liu},
keywords = {Personalized federated learning, Differential privacy, Adaptive noise},
abstract = {Personalized federated learning often struggles with limited flexibility and slow convergence, particularly when client data is non-IID and differential privacy (DP) is required. Most methods use fixed parameter partitions, leading to poor adaptation to data heterogeneity. Furthermore, gradient clipping for privacy often slows down convergence and reduces performance. To address these challenges, we propose a novel differential privacy-preserving personalized federated learning framework (Fed-LPAR). First, to tackle the lack of flexibility in personalization, the framework introduces a hierarchical Fisher-guided personalized (HDP) model. HDP computes the Fisher information matrix (FIM) for each layer’s parameters and retains those with significant contributions to local tasks. This process reduces global noise interference and improves adaptability to data heterogeneity. Second, to overcome convergence difficulties from clipping, Fed-LPAR introduces a History-Based adaptive local regularization (HBR) model. HBR adapts regularization strength using client-side historical gradient information, thereby suppressing training instability and lowering the noise scale needed for differential privacy compliance. Finally, experiments on MNIST, CH-MNIST, CIFAR-10, and Purchase-100 demonstrate that, compared with the state-of-the-art methods, Fed-LPAR achieves lower EMD loss and higher average accuracy under stricter privacy budgets. Together, these results indicate that Fed-LPAR reduces DP noise, stabilizes global training, and preserves personalization, especially with complex datasets. Moreover, ablation results show that combining HDP and HBR further boosts avgAcc from 3.92% to 6.82% compared with either module alone, confirming their benefit in balancing privacy and utility.}
}
@article{LONG2026116486,
title = {Beyond the latest: Correcting Release Interval Bias in short-video recommendation},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116486},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116486},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012128},
author = {Xing Long and Heng-Ru Zhang and Yuan-Yuan Xu and Fan Min},
keywords = {Recommender systems, Short-video recommendation, Causal inference, Release interval bias},
abstract = {Short-video recommender systems frequently overexpose recently released videos while underrepresenting older ones, a phenomenon known as release interval bias. Existing research aiming to mitigate this bias primarily focuses on modeling release intervals from the video perspective. However, they overlook the fact that users also exhibit varying sensitivities to release intervals—some prefer the latest videos, whereas others do not. In this paper, we propose a Correcting Release Interval Bias (CRIB) framework that considers release intervals from both user and video perspectives. First, we leverage the causal inference to identify release interval as a confounder and apply backdoor adjustment to eliminate its confounding effect. Then, we introduce a short-term preference matching score to measure the alignment between users and videos at different release intervals. Finally, we design a hybrid model that integrates this short-term score with a long-term preference matching score predicted by a user-video matching model to generate personalized recommendations. Extensive experiments on five real-world datasets demonstrate that CRIB consistently outperforms baseline methods and achieves superior performance compared to state-of-the-art methods. Our source code is available at https://github.com/A-Egoist/CRIB.}
}
@article{LIU2026116538,
title = {Adaptive Multimodal Contrastive Fusion framework for anomaly detection of psychological sandtray},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116538},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116538},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012645},
author = {Qi Liu and Xiaofei Niu and Zhifang Jiang and Shipeng Zhang and Yaohui Wang and Hongyuan Song and Zeyang Wang and Jianfu Liu},
keywords = {Psychological sandtray, Multimodal contrastive learning, Mutual information},
abstract = {Mental health disorders have become a major societal concern. Traditional mental health assessment methods, such as standardized questionnaires, expert interviews, and physiological signal monitoring, suffer from notable limitations including limited effectiveness, low efficiency, and high costs. As a non-verbal projective technique, psychological sandplay can unconsciously externalize an individual’s inner world, thereby offering unique advantages in mental health assessment. However, existing research on abnormal psychological sandtray recognition faces several challenges, including a single data modality, insufficient annotation information, and limited algorithm performance. Most self-supervised contrastive learning methods overlook the uniqueness and synergy of modalities, as well as the dynamic assessment of the importance of each modality. This paper proposes an Adaptive Multimodal Contrastive Fusion (AMCF) framework for anomaly detection of psychological sandtray, aiming to identify abnormal sandtrays that reflect unhealthy psychological states. Based on contrastive learning mechanisms, AMCF internally maximizes mutual information among multimodal features to align multimodal representations. Externally, it employs a momentum queue mechanism and hierarchical negative sampling to enhance global consistency of representations. During fusion, the method internally attends to the importance of each modality in joint representation learning and adaptively assigns modality weights; externally, it accounts for differences in layer difficulty and adaptively allocates layer sampling probabilities. Experiments are conducted on public datasets and a self-constructed digital psychological sandtray dataset to evaluate the effectiveness of AMCF. Experimental results demonstrate that AMCF exhibits favorable performance and notable generalization capability, compared with state-of-the-art methods, including FactorCL (2023), CoMM (2025), and InfMasking (2025). Code is released at https://github.com/67zaibuzai/ACMF.}
}
@article{HAN2026116562,
title = {Towards unified scene understanding in audio-visual semantic segmentation},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116562},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116562},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012888},
author = {Danjie Han and Changsen Yuan and Xuefeng Chen and Xuan Zhao and Cunhan Guo and Yanghao Zhou},
keywords = {Audio-Visual Semantic Segmentation, Scene Understanding, Audio-Visual Learning, Multimodal},
abstract = {Audio-Visual Segmentation (AVS) aims to delineate sounding objects by reasoning over visual and acoustic signals. We argue that AVS is not merely a feature fusion problem, but a reasoning-guided selection problem that requires identifying what to fuse and why. However, existing methods often suffer from perception ambiguity in complex scenes due to insufficient scene-level understanding and premature modality entanglement , as they predominantly treat AVS as a feature fusion problem without explicitly modeling which visual regions should be associated with sound. In this paper, we propose Scene-Understanding-driven Audio-Visual Semantic Segmentation (SU-AVSS), a framework based on a human-like See-Think-Select-Integrate paradigm. Specifically, we explore top-down semantic guidance to bridge the gap between high-level reasoning and dense perception. Our Scene-aware Prior Generation (SPG) module leverages Multimodal Large Language Models (MLLM) to establish structured visual priors that act as a “semantic gatekeeper” to filter out acoustically irrelevant distractors. These priors are adaptively incorporated into the early stages of visual encoding via a residual modulation mechanism, enabling cognitively-guided mask selection while balancing semantic guidance with spatial fidelity. Furthermore, we integrate a Dynamic-weight Fusion Module (DFM) within the Transformer decoder to progressively refine cross-modal alignment and ensure stable modality interaction. Comprehensive experiments on AVSBench demonstrate that SU-AVSS achieves new state-of-the-art performance, particularly on the challenging AVSS subset.}
}
@article{SHAIKH2026116469,
title = {Fuzzy Prairie Dog Optimization: enhancing metaheuristic algorithms with adaptive fuzzy logic control},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116469},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116469},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011950},
author = {Azharuddin Shaikh and Anirban Tarafdar and Pinki Majumder and Uttam Kumar Bera and Seyedali Mirjalili},
keywords = {Prairie Dog Optimization, Fuzzy logic, Algorithm, Optimization, Benchmark, Meta-heuristic, Artificial Intelligence},
abstract = {Prairie Dog Optimization (PDO) is a population-based metaheuristic algorithm inspired by prairie dog social foraging behavior; however, its optimization performance is often limited by insufficient exploration capability, parameter sensitivity, and the absence of a rigorous adaptive control mechanism. To address these limitations, this study proposes a novel Fuzzy Prairie Dog Optimization (FPDO) algorithm incorporating a Fuzzy Control Strategy (FCS). FPDO employs a mathematically defined normalized-distance search-state indicator and a Mamdani fuzzy inference system to adaptively regulate Lévy flight inertia weights during exploration. Furthermore, a fuzzy-controlled position-update equation is developed to dynamically balance exploration and exploitation, thereby enhancing population diversity, reducing manual parameter tuning, improving convergence stability, and increasing solution accuracy in complex optimization landscapes. The proposed FPDO was comprehensively evaluated on 28 classical benchmark functions, including unimodal, multimodal, fixed-dimensional multimodal, and composition functions, under different dimensional settings. Experimental results demonstrated competetive and generally superior optimization performance, achieving the best overall mean ranks of 2.29, 3.17, 3.56, and 1.33 for the respective benchmark categories compared with state-of-the-art population-based metaheuristic algorithms. Statistical validation using Wilcoxon Signed-Rank, Holm post-hoc, Friedman, and ANOVA tests supported the robustness of FPDO, with many comparisons showing statistical signifirance at p<0.05. On the CEC2022 benchmark suite, FPDO achieved the best overall mean rank of 1 with an average rank value of 2.83 and obtained the best mean solutions for 3 of 12 functions. Sensitivity analyses verified the effectiveness of the fuzzy adaptation mechanism. Furthermore, FPDO demonstrated strong practical applicability on 10 engineering design problems, achieving the best solutions in 8 cases and near-optimal solutions in the remaining 2 cases, highlighting its scalability, convergence efficiency, robustness, and adaptive optimization capability, making it a promising computer-aided optimization tool for solving complex engineering optimization problems.}
}
@article{LI2026116530,
title = {Adaptive drift aware continual learning with pool-based model reuse for time series applications},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116530},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116530},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012566},
author = {Danlei Li and Mingyu Fan and Nirmal-Kumar C Nair and Kevin I-Kai Wang},
keywords = {Drift-aware anomaly detection, Adaptive drift classification, Continual learning, Unsupervised learning},
abstract = {Unsupervised anomaly detection in streaming time series is challenging due to evolving data distributions and the lack of labeled anomalies, where concept drift can significantly degrade detection accuracy during long-term operation. Most existing adaptive methods rely on uniform update strategies or continuous incremental learning. Such designs can be slow to react to abrupt distribution shifts and are prone to overwriting previously learned regimes when patterns recur. This paper proposes ADAPTS (Adaptive Drift-Aware Pool-based framework for Time Series), an unsupervised and drift-aware framework for adaptive anomaly detection in non-stationary data streams. ADAPTS integrates statistical drift detection, explicit drift-type classification, drift-specific model adaptation, and a bounded model pool for knowledge reuse within a unified system. The framework distinguishes sudden, incremental, and recurrent concept drift and aligns adaptation strategies accordingly through retraining, controlled fine-tuning, or selective model reuse. Experiments on benchmark datasets show that ADAPTS can keep stable and reliable detection results under different types of drift. Experimental results show that ADAPTS achieves competitive performance across multiple datasets, with performance improvements observed under several drift scenarios, including up to 0.11 absolute gain in AUC on challenging scenarios such as the NAB dataset, while maintaining improved long-term stability under diverse drift conditions.}
}
@article{AKSOY2026116575,
title = {A hybrid framework integrating graph neural networks and large language models for automated data visualization},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116575},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116575},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013018},
author = {Faruk Aksoy and Resul Das},
keywords = {Automated data visualization, Graph neural networks, Large language models, Generative AI, Tabular data analysis},
abstract = {Data visualization is crucial for exploratory data analysis; however, automating this process remains challenging due to the complexity of semantic reasoning and syntactic code generation. To address this, this study introduces a hybrid framework that integrates Graph Neural Networks (GNN) and Large Language Models (LLM). The proposed pipeline first analyzes the attribute relationships within the dataset using a trained GNN model to identify the most informative feature pairs. Subsequently, it utilizes a Google Flan-T5 model — fine-tuned on a comprehensive dataset of 21,207 examples — to generate valid Vega-Lite visualization specifications. The training process achieved robust convergence with a training loss of 0.0309 and a validation loss of 0.00131. Experimental results across 10 diverse public datasets confirm that the system achieves a 100% syntactic validity rate, with Top-1 and Top-3 accuracies reaching 66% and 100%, respectively. These results demonstrate that the framework produces meaningful and interpretable visual representations while significantly reducing manual workload and human bias in visualization design.}
}
@article{ZHANG2026116502,
title = {VideoEvent: Hierarchical and adaptive event modelling for complex video understanding},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116502},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116502},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012281},
author = {Feng Zhang and Xin Sun and Jianfei Zhao and Yuming Shang},
keywords = {Multimodal, Video understanding, Large Language Model, Event features},
abstract = {While Large Language Models (LLMs) have accelerated the development of Video Large Language Models (VideoLLMs), existing methods struggle with complex video understanding. These models often treat videos holistically, resulting in coarse-grained spatiotemporal modelling and necessitating low sampling rates to manage computational overload. This approach leads to significant information loss and produces lower-quality visual tokens, rendering such models inadequate for tasks requiring detailed analysis or extended temporal understanding. In this paper, we propose VideoEvent, which reshapes video feature modelling from an event-centric perspective. We conceptualize a video as a collection of long-, medium-, and short-term events and introduce hierarchical encoding layers to model event features at these distinct time scales. Furthermore, we propose an event feature perceiver that adaptively filters and contextualizes these event features based on the user query. This combined hierarchical and adaptive framework strikes a critical balance between fine-grained modelling and computational efficiency. Consequently, VideoEvent generates a compact set of high-quality event features that capture the most relevant spatiotemporal information, enabling it to excel in complex scenarios, including fine-grained and long video understanding. Experiments show that VideoEvent improves accuracy by 3.7%, 6.9%, and 2.5% on MSVD-QA, MSRVTT-QA, and ActivityNet-QA, respectively, and achieves state-of-the-art performance across all five evaluation metrics on VCGBench. Notably, it maintains low inference latency and memory usage, even when processing hour-long videos.}
}
@article{SAEED2026116542,
title = {Hierarchical graph neural networks with dynamic edge learning and multi-scale fusion for brain tumor classification},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116542},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116542},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012682},
author = {Adnan Saeed},
keywords = {Brain tumor classification, Knowledge representation, Hierarchical graph neural networks, Dynamic edge learning, multi-scale feature fusion},
abstract = {Brain tumor classification from magnetic resonance imaging (MRI) is a critical clinical task. Accurate discrimination among tumor types directly informs treatment planning and prognosis. While deep learning shows promise, existing convolutional neural networks often encode knowledge implicitly, limiting clinical interpretability. This paper introduces HGN-GT, a knowledge-driven hierarchical graph neural network that models relational knowledge through adaptive graph structures. The framework couples an EfficientNetV2 backbone with a Feature Pyramid Network for multi-scale feature extraction. A dynamic edge learning module then constructs adaptive graphs from feature similarity, spatial proximity, and learned attention weights. Multi-scale graph convolutions based on GATv2, GCN, and GraphSAGE encode hierarchical knowledge, and a Graph Transformer propagates global context across nodes. A hierarchical fusion strategy with auxiliary classifiers aggregates information across scales and provides intermediate supervision during training. To evaluate HGN-GT, we utilized three public T1-weighted MRI datasets totaling 15,087 images across binary (5,000 images), 3-class (3,064 images; glioma, meningioma, pituitary), and 4-class (7,023 images) scenarios. The model achieves 99.80% binary accuracy, 99.67% 3-class accuracy, and 99.72% 4-class accuracy, with 1.000 ROC-AUC scores. On the standardized MedMNIST+ BreastMNIST benchmark at 224 resolution and its official splits, the model reaches 91.03 percent accuracy and 0.966 AUC, above the published baselines on this subset. Interpretability analysis through attention visualization and Grad-CAM shows that the model focuses on clinically relevant spatial regions, providing qualitative evidence about its internal feature representation. The framework achieves practical computational efficiency (442ms inference, 139MB model), establishing HGN-GT as a knowledge-driven model for automated brain tumor diagnosis.}
}
@article{WANG2026116579,
title = {CISD: Fusing causal inference and semantic dependencies for next-item recommendation},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116579},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116579},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013055},
author = {Aodi Wang and Jieyu Ding},
keywords = {Recommendation systems, Causal inference, Multi-interest transition, Causal neural networks},
abstract = {Session-based recommendation utilizes users’ current interaction data to predict next click behavior. Owing to the short and sparse nature of session sequences, most existing methods mainly rely on information from the current session. However, they often fail to fully exploit the potential causal relationships between items and the complex semantic dependencies, which may result in biased recommendations. To address these limitations, we propose a recommendation model named Causal Inference and Semantic Dependencies (CISD). Specifically, the model introduces relationship mining module to identify user–item relationships, which enhances the interpretability and reasonableness of the recommendations. In addition, a multi-interest semantic transition module and a session-item interest dependency module are designed to capture user interests more comprehensively. By incorporating higher-order semantic dependency information, CISD learns a refined representation of user intent. Extensive experiments show that the proposed model consistently outperforms existing baseline methods across multiple evaluation metrics. In particular, the proposed model achieves improvements of 2.27%, 2.38%, and 1.84% in R@10, as well as 1.33%, 1.27%, and 3.48% in M@10 across the three datasets, respectively.}
}
@article{FAREK2026116583,
title = {Octopus Camouflage Optimization: A population-state-aware metaheuristic},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116583},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116583},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013092},
author = {Lazhar Farek and Amira Benaidja},
keywords = {Octopus Camouflage Factor, Population-state-aware optimization, Diversity-driven adaptive control, Continuous global optimization},
abstract = {This paper introduces Octopus Camouflage Optimization (OCO), a novel metaheuristic inspired by the adaptive camouflage intelligence of Octopus vulgaris. Its principal innovation is the Octopus Camouflage Factor (OCF), a diversity-conditioned, dimension-adaptive control mechanism that dynamically regulates the exploration–exploitation balance according to real-time population diversity rather than fixed iteration-dependent schedules. By amplifying exploratory pressure only when diversity collapses, OCF establishes a closed-loop population-state-aware search strategy that mitigates premature convergence while preserving exploitation efficiency. OCO introduces two OCF-native deep-exploitation operators: Chromatophore Lévy–J Burst (CLB) and Elite Camouflage Blend (ECB), both derived directly from the OCF mathematical framework. This unified design preserves biological coherence while providing adaptive search dynamics within a single principled framework. Extensive evaluation on 32 benchmark functions against 20 state-of-the-art metaheuristics confirms that OCO achieves the best overall performance, attaining a Friedman average rank of 2.98 over 30 independent trials. Statistically significant superiority is demonstrated in 82.8% of the pairwise Wilcoxon comparisons. Cohen’s d effect sizes confirm large practical significance in most comparisons. Empirical runtime measurements, parameter sensitivity analysis, and EvoMapX behavioral diagnostics further validate diversity-conditioned population-state adaptation as an effective and interpretable paradigm for high-dimensional continuous optimization.}
}
@article{KHUAT2026116458,
title = {Emotion-aware multimodal lightweight framework for adaptive voice interaction on edge device},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116458},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116458},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011846},
author = {Van-Duc Khuat and Jeongin Kim and Sang-Ho Kim and Yue Cao and Martin Maier and Wansu Lim},
keywords = {Adaptive VUI, Multimodal emotion recognition, Personalized interaction, Model compression, Edge deployment},
abstract = {Voice user interfaces (VUIs) have been a major focus of human–computer interaction research over the past two decades. Advances in voice and emotion recognition have significantly enhanced their capabilities. However, VUIs still struggle to produce responses that fit the user’s emotions in various contexts. Meanwhile, the growing demand for on-device intelligence makes efficient operation on resource-constrained edge devices increasingly important. To address these issues, this study presents an emotion-aware VUI framework designed for edge devices. The framework includes a lightweight multimodal emotion recognition model that integrates electroencephalogram signals and facial expressions. Furthermore, to enable on-device efficiency, this paper applies filter pruning to remove redundant filters. It uses cross-layer ranking together with k-reciprocal nearest-filter selection. This improves cross-layer consistency and preserves salient representations while sharply reducing computation. Post-training quantization is then applied to further shrink model size and memory traffic, lowering latency without harming accuracy. Finally, a response-customization module dynamically refines system outputs based on the recognized emotions. The experimental implementation on actual edge devices demonstrates that the proposed system effectively adapts the interaction types to the emotions of the users. In addition, the proposed model achieves low latency and resource-efficient performance.}
}
@article{WANG2026116571,
title = {Reinforcement learning-based collaborative framework for data imputation and fault diagnosis with online segment missing data},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116571},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116571},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012979},
author = {Zhaojing Wang and Tianwei Xu and Bowen Song and Yang Wang and Li Li},
keywords = {Industrial Internet of Things, Fault diagnosis, Segment missing data, Reinforcement learning, Data imputation},
abstract = {In Industrial Internet of Things environments, issues such as sensor failures often lead to missing data. Compared with random missing, segment missing causes severe temporal discontinuity and loss of critical features. Most existing imputation methods focus merely on optimizing data reconstruction accuracy, whereas low reconstruction error cannot ensure fault-discriminative features of recovered data. The objective inconsistency between data imputation and fault diagnosis deteriorates diagnostic performance. To solve this problem, this paper proposes a reinforcement learning-based collaborative framework integrating data imputation and fault diagnosis to improve diagnosis reliability under segment missing conditions. First, relying on the generative adversarial imputation network, this work designs a dimension-wise random masking matrix for segment missing, introduces a hint mechanism to enhance discriminator constraints on missingness, and constructs a joint loss function to balance observed-data preservation and missing-data reconstruction accuracy for better imputation performance. Second, a deep deterministic policy gradient-based strategy is adopted. In this strategy, fault diagnosis performance is used as the reward signal, and dimension contribution scores are calculated to guide targeted imputation. This enables the model to preferentially recover diagnosis-critical feature dimensions. In addition, a progressive two-stage training strategy, consisting of step-by-step pretraining and feedback-driven closed-loop optimization, is designed to reduce training difficulty and improve convergence stability. Finally, experiments on the Huazhong University of Science and Technology bearing dataset and the Southeast University gearbox dataset validate that the proposed method achieves better fault diagnosis accuracy and robustness than existing methods under segment missing scenarios, and all embedded modules facilitate performance improvement.}
}
@article{JIA2026116555,
title = {HCSMamba: A Hierarchical Causal Scanning State Space model guided by physical priors for underwater image enhancement},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116555},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116555},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012815},
author = {Wenshuo Jia and Na Tian and Youjia Shao and Haiyong Zheng and Wencang Zhao},
keywords = {Underwater image enhancement, Physics-guided, State space models, Mamba},
abstract = {Underwater optical degradation is a spatially non-uniform process tightly coupled with scene depth. Although state space models (SSMs) enable global modeling with linear complexity, their spatially agnostic fixed scanning schemes are not well aligned with the physical causality of underwater light propagation, allowing scattering noise from heavily degraded background regions to contaminate clearer foreground regions through non-causal reverse propagation. To address this limitation, we propose HCSMamba, a physics-guided framework that reformulates underwater image enhancement as a causal state propagation problem over a degradation manifold. At its core is a Hierarchical Causal Scanning Strategy (HCSS), which implicitly estimates an optical transmission prior and constructs a sparse directed graph to extract global causal routes aligned with degradation gradients. It further adaptively selects predefined scanning patterns according to local two-dimensional physical gradients and incorporates positional encodings to bridge spatial discontinuities. This mechanism guides hidden states to propagate in an ordered manner along the estimated degradation hierarchy, thereby effectively suppressing non-causal reverse contamination from noise. In addition, we develop a spatial–frequency collaborative dual-branch architecture that focuses on physics-prior-guided structural restoration and global color correction through phase-preserving amplitude modulation, respectively. Extensive experiments on multiple underwater image benchmarks demonstrate that HCSMamba achieves competitive performance in terms of both quantitative metrics and visual quality.}
}
@article{QIAO2026116547,
title = {Cross-modal Prompt Disentangled Graph Neural Networks for incomplete conversational emotion recognition},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116547},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116547},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012736},
author = {Shi Qiao and Xiaowei Zhang and Qinglin Zhao and Bimei Wang and Jisheng Dang and Bin Hu and Hong Peng},
keywords = {Multimodal fusion, Incomplete multimodal learning, Conversational emotion recognition},
abstract = {Multimodal emotion recognition relies on the joint modeling of text, speech, and visual signals. In real-world scenarios, however, some modalities are often unavailable due to noise, occlusion, recognition errors, or device malfunction. This not only weakens the use of complementary cross-modal information, but also intensifies imbalance in modality learning. To address this issue, we propose a Cross-modal Prompt Disentangled Graph Neural Network (CPD-GNN) for incomplete multimodal conversational emotion recognition. Specifically, to reduce interference caused by modality heterogeneity, the proposed method first projects incomplete multimodal features into a unified semantic space and disentangles them into shared representations and modality specific representations. On this basis, the framework jointly performs cross-modal information compensation and dynamic modality balancing, providing a robust foundation for modeling both local contextual interactions and higher-order conversational dependencies under missing-modality conditions. Extensive experiments on multiple benchmark datasets demonstrate that the proposed method is effective for incomplete multimodal learning and achieves competitive or superior performance compared with existing approaches.}
}
@article{TIAN2026116584,
title = {CA-CPU: Calibration-Aware Coupled-Prior Unfolding framework for snapshot compressive imaging},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116584},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116584},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013109},
author = {Xiao Tian and Han Zhou and Yusheng Lian and Xuheng Cao and Bin Wang and Jin Li and Yueyang Zhai},
keywords = {Hyperspectral imaging, Snapshot compressive imaging, Deep unfolding network, Calibration-aware modeling, Coupled-prior learning},
abstract = {Deep unfolding networks (DUNs) have achieved significant success in Coded Aperture Snapshot Spectral Imaging (CASSI) reconstruction by mapping iterative algorithms into learnable neural layers. However, existing methods are constrained by three primary limitations: the entanglement of heterogeneous spatial–spectral priors within a single regularization term; sensing model uncertainties arising from system assembly imperfections and optical misalignment; and the quadratic computational complexity of Transformer-based priors. To address these challenges, we propose CA-CPU, a Calibration-Aware Coupled-Prior Unfolding framework featuring explicit residual calibration. Specifically, we introduce a Residual Mask Calibration Module (RMCM) that models calibration errors as learnable variables, enabling the joint optimization of hyperspectral data and system parameters. Within the Spectral-Spatial Image Prior (SS-IP) module, an Efficient Spectral Focus Attention (ESFA) mechanism is developed to capture spatial–spectral dependencies. By substituting standard matrix multiplication with learnable global query aggregation and broadcasted element-wise interaction, ESFA achieves global context modeling with linear complexity. This design facilitates the exploitation of long-range scene consistency to resolve aliasing artifacts. Furthermore, a Calibration-Aware Degradation Prior (CA-DP) module is incorporated to explicitly account for data consistency errors, thereby compensating for sensing biases. Experimental results on both synthetic and real-world datasets demonstrate that CA-CPU achieves state-of-the-art reconstruction accuracy and superior computational efficiency. The code is available at https://github.com/Vzhouhan/CA-CPU.}
}
@article{PENG2026116566,
title = {Alignment and disentanglement with adaptive-weighted optimal transport for compositional zero-shot learning},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116566},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116566},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601292X},
author = {Zhong Peng and Gerong Wang and Dongsheng Wang and Wenchao Chen and Jing Zhang and Bo Chen and Hongwei Liu},
keywords = {Compositional zero-shot learning, Primitive disentanglement, Adaptive weighting, Optimal transport},
abstract = {Compositional Zero-Shot Learning (CZSL) aims to recognize unseen compositions by recombining learned state and object primitives. Many recent methods can be viewed as following a two-stage paradigm that first disentangles visual primitives and then aligns them with their textual counterparts. However, this paradigm suffers from two limitations: coarse global embeddings limit fine-grained cross-modal alignment, while attention-based disentanglement tends to spread over irrelevant regions and weakens primitive separability. To address these issues, we propose a new CZSL framework built on adaptive-weighted optimal transport. Specifically, we design a fine-grained alignment module that represents visual and textual concepts as weighted point sets and performs transport-based matching for more discriminative cross-modal alignment. We further develop a doubly constrained transport-based attention module to reduce attention spread and improve primitive disentanglement. Central to the framework is an adaptive-marginal principle that relaxes the uniform-weight assumption in standard optimal transport, enabling the model to emphasize informative tokens and local regions while reducing the influence of irrelevant responses. Extensive experiments on MIT-States, UT-Zappos, and C-GQA demonstrate that the proposed method achieves improved compositional generalization and competitive performance in both closed- and open-world settings.}
}
@article{VIDZA2026116466,
title = {Comparative analysis of thresholding strategies and the impact of class imbalance on link prediction methods},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116466},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116466},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011925},
author = {Michael-Sam Vidza and Marcin Budka and Wei Koong Chai and Mark Thrush and Mickael Teixeira Alves},
keywords = {Complex network analysis, Aquaculture, Live fish movement, Class imbalance, Evaluation metrics},
abstract = {Accurately predicting future links, known as link prediction (LP), is crucial for understanding how temporal networks evolve. This study focuses on the aquaculture sector, where predicting the movement patterns of live fish consignments between fish sites is essential for effective stock management. Given the biosecurity risks associated with inaccurate link prediction, this study evaluates the performance of several LP methods using two primary thresholding strategies: the fixed-threshold and the threshold–curve. Recognising the challenges posed by class imbalance in real-world datasets such as aquaculture networks, the study introduces and evaluates a customised class balancing technique: targeted edge removal. Its impact on LP methods is assessed using evaluation metrics including accuracy, precision, recall, F1 score, and the Matthews Correlation Coefficient (MCC). Among the six LP methods evaluated, the Edge Weighted Katz Index (EWKI) consistently outperforms other methods, achieving a precision of 93.59%, recall of 84.35%, F1 score of 88.73%, and an MCC of 0.89 before class balancing. After applying the class balancing technique, EWKI maintained a robust and stable performance. These findings show how thresholding strategies and class balancing techniques affect LP performance in aquaculture networks, and why they should be considered when applying LP to stock-movement analysis and disease surveillance.}
}
@article{LI2026116551,
title = {Constraint-aware spatio-temporal graph completion for mobile sensing networks},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116551},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116551},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012773},
author = {Xiulai Li and Bin Zhang and Jiahui Li and Hanmeng Liu and Xiaozhang Liu},
keywords = {Graph neural networks, Spatio-temporal graph completion, Mobile sensing networks, Physical reachability, Multi-agent coordination},
abstract = {Mobile sensing networks, such as UAV-based sensing systems, require timely completion of spatially distributed observations for effective coordination. In these systems, missing data are not purely random but are induced by sensor motion, limited sensing ranges, and finite operation horizons. Existing graph completion and temporal imputation methods mainly optimize reconstruction accuracy from structural or temporal correlations, while they do not explicitly model whether the completed information is physically reachable or observable for mobile agents. To address this issue, we propose ACE, a constraint-aware spatio-temporal graph completion framework for mobile sensing networks. ACE incorporates reachability-aware spatial attention to align message passing with feasible sensing relations and trajectory-coupled temporal modeling to account for reachability-derived observability. Experiments on UAV-based emergency response scenarios show that ACE consistently improves imputation accuracy and downstream coordination performance while maintaining lightweight inference compared with strong graph completion and coordination baselines.}
}
@article{WU2026116596,
title = {WorldSnake: Semantic–geometric decoupling for open-vocabulary contour-based instance segmentation},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116596},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116596},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013225},
author = {Yejun Wu and Jiao Zhan and Chi Guo and Huyin Zhang},
keywords = {Open-vocabulary instance segmentation, Contour-based segmentation, Robotic scene perception, Computer vision, Deep learning},
abstract = {Open-vocabulary instance segmentation aims to segment objects of arbitrary categories from textual queries, but existing methods typically couple semantic recognition with mask or contour prediction, limiting generalization to unseen objects with diverse shapes and complex boundaries. In this paper, we propose WorldSnake, a contour-based open-vocabulary instance segmentation framework that reformulates the task through semantic–geometric decoupling. Instead of predicting semantic masks directly, we decompose the task into semantic object localization and category-agnostic contour modeling, where an open-vocabulary detector provides instance localization and a contour network focuses on geometric boundary evolution with reduced reliance on category-specific semantic supervision. To improve contour modeling, we design a Hierarchical Progressive Contour Refinement (HPCR) module that iteratively updates contours from coarse to fine using multi-scale features. In addition, we introduce a semantics-agnostic training strategy that learns contour deformation from contour-level supervision, encouraging the learning of transferable boundary representations across object categories. The results suggest that semantic–geometric decoupling and contour-based geometric modeling are effective for open-vocabulary visual perception. Our code will be available at https://github.com/Giansar-Wu/WorldSnake.}
}
@article{YIN2026116543,
title = {STA: Spatio-temporal alignment for multimodal test-time adaptation},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116543},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116543},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012694},
author = {Xiao-Long Yin and Xinlin Wang and De-Chuan Zhan and Yuan Jiang},
keywords = {Test-time adaptation, Multimodal test-time adaptation, Spatio-temporal alignment},
abstract = {Test-time adaptation (TTA) updates deployed models using unlabeled test data to mitigate performance degradation under distribution shifts. However, most existing TTA methods are designed for single-modality settings, limiting their effectiveness in multimodal scenarios where degradation arises from both unimodal corruption and disrupted cross-modal correspondence. While recent multimodal Test-time adaptation(MMTTA) approaches improve fusion or attention alignment, they often underexploit spatio-temporal cues and lack explicit spatio-temporal consistency constraints during adaptation. To address these limitations, we propose a Spatio-Temporal Alignment framework (STA) for MMTTA, consisting of three modules. First, Spatial-Temporal Evidence Construction (STEC) module encodes motion dynamics and fuses spatial and temporal information to build robust spatio-temporal representations under corruption. Second, Cross-View Attention Consistency (CVAC) module aligns attention distributions across views to improve cross-view agreement during adaptation. Third, Reliability-Aware Deduction (RAD) module performs adaptive view-weighted inference at test time by emphasizing more reliable views. Extensive experiments on two benchmarks with 20 corruption types demonstrate that STA consistently outperforms prior methods, achieving up to a 12.3% accuracy improvement under audio modality corruption.}
}
@article{WANG2026116475,
title = {Beyond textual rationales: Anatomy-grounded chain-of-thought for traceable radiology reasoning},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116475},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116475},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012013},
author = {Shengzhi Wang and Kai Wu and Jun Yang and Mengyuan Xu and Mingliang Xiong and Wen Fang and Mingqing Liu and Hao Deng and Bin He and Gang Li and Qingwen Liu},
keywords = {Medical large language models, Chain-of-thought reasoning, Radiology, Visual grounding},
abstract = {Chain-of-Thought (CoT) improves multimodal large language models (MLLMs) on many reasoning tasks, but radiology exposes a practical gap: a model can write a fluent rationale that is weakly tied to the actual image. This disconnect matters in clinical settings, where decisions hinge on precise visual evidence. Radiologists read images systematically (such as the ABCDE checklist, i.e., Airway, Breathing, Cardiac silhouette, Diaphragm, and Everything else) for chest X-rays and justify conclusions with explicit findings. We introduce Anatomy-CoT, a framework that grounds reasoning in anatomy to mirror this clinical workflow. This work is a methodological study with exploratory validation in chest X-ray reasoning. The model’s output is structured into three stages: Analysis, Reasoning, and Conclusion. Instead of generating free-form text, Anatomy-CoT explicitly links its intermediate claims to localized visual evidence by outputting bounding boxes as it reasons. This explicit linking makes the reasoning traceable, allowing users to isolate perceptual errors from logical ones. To train this behavior, we construct Anatomy-CoT-200K, a dataset providing token-level supervision for grounded reasoning synthesized with Gemini-2.5-pro-2025-06-05 as a teacher model. We also introduce GRPO-MR, a reinforcement learning strategy that optimizes this structured generation on Qwen2.5-VL as the student/base multimodal model. GRPO-MR scores the correctness of the final answer, the grounding accuracy of the bounding boxes, and the consistency of the intermediate trace using GPT-4o-2024-08-06 as a scalable judge for open-ended answer evaluation and reward computation, rather than as a clinical gold standard. Across benchmarks, Anatomy-CoT improves accuracy by 11.17 percentage points over the base Qwen2.5-VL model (74.46% vs. 63.29% average accuracy) and transfers better to out-of-domain chest X-ray datasets. By explicitly tying text generation to visual regions, our framework produces more traceable reasoning outputs for radiology VLMs, while larger-scale clinical validation remains future work.}
}
@article{PENSEL2026116527,
title = {Human guided learning of transparent regression models},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116527},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116527},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012530},
author = {Lukas Pensel and Stefan Kramer},
keywords = {Human in the loop, Transparency, Permutation regression},
abstract = {We present a human-in-the-loop (HIL) approach to permutation regression, the task of predicting a continuous value for a given ordering of items. The model is a gradient boosted regression model that incorporates simple human-understandable constraints of the form x < y, i.e. item x has to be before item y, as binary features. The approach, HuGuR (Human Guided Regression), lets a human explore the search space of such transparent regression models. Interacting with HuGuR, users can add, remove, and refine order constraints interactively, while the coefficients are calculated on the fly. We evaluate HuGuR in a user study and compare the performance of user-built models with multiple baselines on 9 data sets. The results show that the user-built models outperform the compared methods on small data sets and in general perform on par with the other methods, while being in principle understandable for humans. On larger datasets from the same domain, machine-induced models begin to outperform the user-built models. An additional expert study indicates that domain knowledge can further improve the quality of the user-built models. Further work will study the trust users have in models when constructed by themselves and how the scheme can be transferred to other pattern domains, such as strings, sequences, trees, or graphs.}
}
@article{JAVAID2026116515,
title = {MADiff-T: Multi-agent evolutionary calibration of diffusion models for privacy-audited tabular data generation},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116515},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116515},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012414},
author = {Kumail Javaid and Meng Yuan and Yukang Cui},
keywords = {Synthetic data, Tabular data, Diffusion models, Evolutionary optimisation, Privacy auditing},
abstract = {Tabular synthetic data generation is challenging due to heterogeneous features, complex dependencies, and memorisation risks. GANs and VAEs can be unstable and leak information under attack-based audits, while denoising diffusion models are more stable but highly sensitive to calibration (noise schedule, step budget, feature scaling); single-model tuning yields suboptimal utility–privacy trade-offs. We propose MADiff-T, a multi-agent evolutionary refinement framework for tabular diffusion. MADiff-T trains a population of diffusion agents exploring calibration variables under elitist selection with mutation and weight inheritance. Selection is guided by a composite, privacy-audited fitness combining downstream utility (Train-on-Synthetic, Test-on-Real; TSTR), marginal-alignment proxies, and in-loop privacy audits based on proximity and a distance-based membership inference AUROC. Across five benchmarks, under a matched-compute comparison against a tuned TabDDPM baseline, MADiff-T does not claim utility dominance; instead it occupies a Pareto-distinct operating point with safer proximity-based audits (DCR) on four of five datasets, trading a measured amount of utility for improved audit outcomes. We further introduce a Feature-Aggregated (FA) Loss that re-weights continuous and categorical terms by per-feature inverse variance and inverse entropy, preventing high-variance features from monopolising gradient signal, and Per-Feature Schedule (PFS) offsets with adaptive activation. The FA Loss is the primary enhancement, improving TSTR on all five datasets and reducing seed variance, while PFS is an optional extension for larger, predominantly-continuous datasets. MADiff-T uses multi-agent refinement only during training; deployment uses a single selected model. All privacy results are audit-based and do not constitute a formal differential-privacy guarantee.}
}
@article{WANG2026116567,
title = {UA-TFCAM: An uncertainty-aware tensor fusion co-attention model for multimodal brain-eye cognitive assessment},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116567},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116567},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012931},
author = {Shaochang Wang and Dingna Duan and Tzyy-Ping Jung and Islem Rekik and Suhan Cui and Xianglong Wan and Xueguang Xie and Tiange Liu and Hao Yu and Danyang Li and Haiqing Song and Jing Wang and Dong Wen},
keywords = {Multimodal cognitive assessment, Tensor fusion, Co-attention mechanism, Electroencephalography, Eye-tracking},
abstract = {Conventional cognitive assessment models relying on unimodal physiological signals—such as electroencephalography (EEG) or eye-tracking—often suffer from insufficient cross-modal interaction and limited interpretability in decoding complex neurocognitive processes. To address these limitations, we propose an Uncertainty-Aware Tensor Fusion Co-Attention Model (UA-TFCAM) that integrates EEG band-specific coupling features, extracted via PermutationConditional Mutual Information (PCMI), with statistical descriptors from eye-tracking within a tensor fusion and co-attention framework. The model incorporates uncertainty-aware denoising to enhance robustness while adaptively weighting modality contributions. Experiments were conducted on two representative datasets: a virtual reality-based spatial cognition dataset collected from 12 participants over a 28-day cognitive training protocol, and the publicly available DEAP dataset. Results show that UA-TFCAM consistently outperforms representative fusion baselines (Concat Fusion and Emotion Meter) across all frequency bands, with the best performance observed in the Gamma band. In low-frequency bands (delta/theta), our model achieved accuracy gains of +4.55% over the baselines, demonstrating the framework’s sensitivity to emotion-related cortical activation patterns. Attention-weight visualization supports frequency-specific cross-modal contributions, validating the physiological plausibility of the approach. The proposed framework offers highly accurate, interpretable, and generalizable cognitive state monitoring, with potential applications in cognitive assessment, emotion recognition, and adaptive brain-computer interfaces.}
}
@article{ZHA2026116539,
title = {SDPDRec: Synergistic Dual-path with Personalized Diffusion for Multimodal Recommendation},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116539},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116539},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012657},
author = {Yongfu Zha and Yufei Wang and Jie Peng and Cui Miao and Xinxin Dong and Xiaodong Wang},
keywords = {Multimodal recommendation, Diffusion model, Synergistic dual-path, Contrastive learning, Hard negative sample},
abstract = {Multimodal recommendation enhances user and item representations by leveraging complementary signals such as text and images. However, most existing methods rely on deterministic fusion, which is insufficient to capture cross-user heterogeneity in modality reliance and within-user uncertainty in multimodal preferences. To address these issues, we propose SDPDRec, a synergistic dual-path framework with personalized diffusion for multimodal recommendation. SDPDRec contains a collaborative path that learns lightweight representations from item similarity graphs and the user–item interaction graph, and a diffusion path that provides training-time enhancement. In the diffusion path, we construct personalized diffusion priors from the multimodal feature statistics of each user’s historical interactions by injecting mean and variance as structured priors, and design a multimodal conditional diffusion module with self-attention to generate multimodal-enhanced user representations. Through a synergistic training mechanism, the diffusion-enhanced signals guide the collaborative path through diffusion-guided hard negative sampling and contrastive alignment, enabling the collaborative representations to absorb multimodal cues. Thanks to the training and inference separation, SDPDRec uses only the collaborative path for efficient inference. Extensive experiments on three datasets demonstrate that SDPDRec consistently outperforms state-of-the-art baselines. Our code and datasets are available at https://github.com/YongfuZha/SDPDRec.}
}
@article{ESCALERAGONZALEZ2026116507,
title = {PermGrad: Interpretable Hybrid Neural Networks with synthetic images for tabular data},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116507},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116507},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012335},
author = {Felipe Escalera-González and Manuel Castillo-Cara and Mariano Rincón-Zamorano and Luis Orozco-Barbosa},
keywords = {Hybrid Neural Network, TINTOlib, Interpretability, Tabular deep learning, Synthetic images, Tabular-to-image, tabular2image},
abstract = {Deep learning has achieved notable progress in vision and language domains, yet its application to tabular data remains constrained by the lack of inherent spatial structure and the profound challenge of extracting transparent explanations. This work introduces a Hybrid Neural Network (HyNN) framework focused on robust interpretability, combining symbolic reasoning on original tabular features with spatial representations derived from synthetic images. Tabular data are transformed into TINTO-generated synthetic images, enabling a CNN branch to exploit local feature interactions while an MLP branch captures global dependencies. To decode this hybrid decision process, we propose PermGrad: a unified attribution pipeline integrating permutation-based importance (MLP), Grad-CAM saliency (CNN), and a macroscopic pruning-based weighting scheme that scales feature relevance by each branch’s empirical contribution. Experiments across five heterogeneous datasets reveal that the HyNN achieves predictive performance highly competitive with SOTA deep tabular architectures (e.g., FT-Transformer). Crucially, PermGrad exposes the internal behavioural dynamics of the hybrid model: the CNN leverages the spatial layout to dominate high-dimensional contexts, while the MLP acts as a vital ”symbolic anchor” during training. Even when its explicit inference-time attribution is negligible, the auxiliary MLP stabilizes gradient flow, prevents optimization collapse, and yields consistently lower test losses. Overall, PermGrad provides a unified, scalable, and class-aware view of feature importance, demonstrating that the strategic use of synthetic images in hybrid architectures can bridge the gap between competitive predictive power and transparent, modality-aware explainability.}
}
@article{ZHANG2026116592,
title = {MeshSyne: State-space guided synergistic spatio-temporal optimization for human pose and mesh},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116592},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116592},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013183},
author = {Hehao Zhang and Zhengping Hu and Jirui Di and Qiming Zhang and Zhe Sun},
keywords = {Human mesh recovery, Human pose estimation, State space models, Video processing},
abstract = {The temporal information discontinuity and body shape errors in monocular videos remain challenging for reconstructing 3D poses and meshes. Given the inherent advantages of state space models in modeling continuous dynamic systems, we propose a novel MeshSyne to decouple the motion features of human joints and mesh vertices. Firstly, temporal continuity information and full-sequence 3D poses are extracted, providing critical motion cues and a stable skeleton base for subsequent mesh recovery, respectively. Secondly, the spatial pose-mesh interaction module constructs intrinsic spatial correlations between joint dynamics and mesh shape to achieve synergistic optimization of both. Finally, the temporal pose-mesh fusion module exploits the dynamic dependencies of joint and vertex features over long time scales, ensuring that the reconstructed human mesh exhibits natural and smooth motion transitions between successive frames. Experiments on the 3DPW, Human3.6 M and MPI-INF-3DHP datasets verify the dual superiority in intra-frame precision and inter-frame temporal consistency. Notably, on the 3DPW dataset, the proposed MeshSyne achieves significant improvements of 8.0% and 12.7% in MPVE and ACCEL metrics.}
}
@article{MA2026116580,
title = {D-CORL: A provably distributed causal discovery algorithm via ordering-based reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116580},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116580},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013067},
author = {Yanan Ma and Qingtao Wu and Lin Wang and Xuhui Zhao and Jiamei Feng and Junlong Zhu},
keywords = {Causal discovery, Distributed reinforcement learning, Markov boundary, Directed acyclic graph DAG, Incremental learning},
abstract = {Causal discovery has received significant attention in recent years, which aims to learn the causal structure among random variables in complex systems. However, existing distributed causal discovery methods may suffer from the limitations of large-scale directed graphs searching space or identifying only the Markov equivalence class (MEC) instead of the true directed acyclic graph (DAG). To address these issues, we develop a distributed causal discovery under ordering-based reinforcement learning (RL) paradigm by leveraging Markov boundary and incremental learning techniques, referred to as D-CORL. Specifically, we incorporate distributed paradigm into ordering-based RL framework to explore the ordering, and further infer the optimal DAG structure in parallel to improve efficiency. Meanwhile, the local action corresponded to each agent is selected from a compact candidate node space, which is constructed with only proven dependent nodes of the previous orderings via Markov boundary. Furthermore, theoretical results demonstrate that the D-CORL method can efficiently discover the causal structure in multi-agent systems. Finally, we conduct experiments to verify the effectiveness of the D-CORL algorithm.}
}
@article{ZHAO2026116511,
title = {Check-Agent: Multimodal fraud detection via a multi-agent framework},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116511},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116511},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012372},
author = {Yongxin Zhao and Ziqi Xu and Xi Wu},
keywords = {Multi-agent, Scam detection, Large language model (LLM)},
abstract = {With the growing sophistication of AI-generated scams and deepfakes, single-modality detectors often fail to ensure reliability across heterogeneous data sources. This paper presents Check-Agent, a unified multi-agent multimodal fraud detection framework powered by large language models (LLMs). The system integrates a multimodal encoder that maps text, image, audio, and video inputs into a shared semantic space, where specialized Detection Agents conduct modality-specific analysis. Briefing Agent then performs discriminative inference through a prompt-embedded weight update mechanism, enabling adaptive and interpretable fusion of expert predictions. Comprehensive experiments demonstrate that Check-Agent achieves strong and balanced performance across all four modalities, with accuracy not lower than 84.05%. It reaches 99.15% accuracy in text-based scam detection and up to 91.50% F1-score in deepfake video detection. These results highlight the potential of Check-Agent as a foundation for adaptive and trustworthy AI systems in large-scale multimodal risk detection.}
}
@article{DELAMATAMORATILLA2026116600,
title = {Enhancing municipal solid waste management through artificial neural network based forecasting of discharge point behaviour},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116600},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116600},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013262},
author = {Sergio De-la-Mata-Moratilla and Ana Castillo-Martinez and Jose-Maria Gutierrez-Martinez and Raul Ramirez-Velarde and Mikel Ferrer-Oliva},
keywords = {Municipal solid waste, Forecasting, Neural networks, Sliding window},
abstract = {Forecasting waste accumulation at the Discharge Point (DP) level remains a challenging task due to the high variability, sparsity and irregularity of filling patterns in Municipal Solid Waste (MSW) systems. This paper investigates the feasibility of applying Artificial Neural Network (ANN) based models, including feedforward ANN, Long Short-Term Memory (LSTM) and Convolutional Neural Networks (CNN) architectures, to predict DP level waste filling behaviour using a real-world dataset comprising 3.85 million records collected from 200 DPs over a four-year period. While existing studies on MSW forecasting predominantly focus on aggregated spatial scales, such as facilities or districts, this work explicitly adopts a DP-centred perspective to capture the pronounced variability and irregularity inherent to individual waste disposal units. A systematic experimental framework is proposed consisting of five scenarios designed to evaluate the impact of different preprocessing strategies, including sliding window transformation, normalisation, interpolation, outliers’ detection, and both temporal and structural aggregation. The findings demonstrate that LSTM and CNN-based models, combined with temporal aggregation intervals of 3 and 4 hours, significantly improve predictive performance, while structural aggregation across multiple DPs further enhances model stability achieving R² values up to 0.89. These findings highlight the critical role of data preprocessing and aggregation strategies in improving forecasting reliability for highly irregular DP level time series, providing practical insights for the development of decision support systems in MSW management.}
}
@article{PHAN2026116459,
title = {A fuzzy-enhanced Graph Convolutional Network with rule-based post-processing for Collective Sentiment Analysis},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116459},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116459},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011858},
author = {Huyen Trang Phan and Ngoc Thanh Nguyen},
keywords = {Graph convolutional network (GCN), Collective sentiment analysis, Fuzzy-enhanced GCN (FE-GCN), Collective intelligence},
abstract = {Collective Sentiment Analysis (CSA) aims to determine a community’s overall sentiment by aggregating sentiments expressed in individual posts or opinions. Existing CSA approaches are challenging due to the ambiguity and overlap of individual sentiments. To address these issues, we propose FE-GCN, a fuzzy-enhanced graph convolutional network that integrates fuzzy logic with GCN to capture both uncertainty and individual sentiment similarity in the community. Besides, we introduce fuzzy membership functions into graph learning and a hybrid loss to better model ambiguous sentiments. Experiments on benchmark datasets show that FE-GCN outperforms state-of-the-art methods, demonstrating its effectiveness for CSA.}
}
@article{LI2026116540,
title = {Medical video segmentation model based on text reference},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116540},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116540},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012669},
author = {Zichan Li and Qiang Zhang and Junjian Hu and Yaxiong Chen},
keywords = {Medical video segmentation, Text-referenced segmentation, Cross-modal fusion, Multiscale feature fusion},
abstract = {Recent advancements in medical imaging technologies have led to the accumulation of vast amounts of medical video data, necessitating the development of effective cross-modal video segmentation methods that integrate textual descriptions with visual information. However, existing approaches often rely on manual annotations of the first frame, which require expertise and limit the practicality of these methods. This paper proposes a medical video segmentation model based on text reference, aiming to reduce the dependence of medical video segmentation on professional annotations. The model adopts a bottom-up cross-modal fusion strategy, achieving early fusion of visual features and text features by introducing a text encoder and a segmentation selection module. The text encoder, based on the RoBERTa model, is capable of extracting high-quality semantic information, while the segmentation selection module dynamically selects high-quality initial segmentation frames by predicting segmentation scores to avoid the impact of low-quality frames on segmentation performance. Additionally, the model employs a multi-scale cross-modal fusion method, combining visual and text features at different scales to further improve segmentation accuracy. Experimental results show that the model demonstrates excellent segmentation performance on the ASU-Mayo and CAMUS datasets, providing an efficient and accurate solution for medical video segmentation.}
}
@article{LI2026116239,
title = {CP-IDC: Consensus prototype-guided incomplete multi-view decoupled clustering},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116239},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116239},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009652},
author = {Xiaomin Li and Youlong Yang},
keywords = {Incomplete multi-view clustering, Representation disentanglement, Prototype alignment, Semantic completion},
abstract = {The goal of multi-view clustering is to integrate information from multiple perspectives to reveal the inherent clustering structure within data. However, real-world data often suffers from missing views. Moreover, existing methods mostly fail to properly handle the inherent coupling between consistency and complementarity information across views, resulting in learned representations lacking sufficient discriminative power. To address this, this paper proposes a consensus prototype-guided incomplete multi-view decoupled clustering method. First, we decouple features across views into consistency representations and complementarity representations, ensuring information separation through dual supervision. Next, a learnable consensus prototype is introduced. Through prototype alignment and contrastive loss, these prototypes drive the consistency representations across all views to converge toward the correct semantic center while diverging from other centers. This achieves robust implicit completion and discriminative clustering at the semantic level. We conduct extensive experiments across eight diverse datasets and compare our approach against ten state-of-the-art incomplete multi-view clustering methods. Extensive experiments demonstrate the effectiveness of our method for incomplete multi-view clustering.}
}
@article{SIVRIKAYA2026116535,
title = {Prototype Forest in multiple instance learning},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116535},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116535},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601261X},
author = {Ozgur Emre Sivrikaya and Ali Erdem Banak and Berk Görgülü and Mustafa G. Baydoğan},
keywords = {Multiple Instance Learning, Dissimilarity, Prototype, Tree-based ensembles, Classification},
abstract = {Multiple Instance Learning (MIL) addresses problems where labels exist only for bags of instances, often requiring complex assumptions or computationally expensive embedding techniques to solve. While dissimilarity-based representations capture global structure effectively, they frequently suffer from high computational costs and difficult hyperparameter tuning. To address these limitations, this study proposes bridging the gap between dissimilarity-based embeddings and interpretable tree-based ensembles by introducing two novel frameworks: Prototype Forest (PF) and Prototype Forest with Prototype Learning (PFPL). Both methods represent bags via dissimilarity features (minimum, maximum, and mean distances) to reference prototypes within a decision tree structure. PF leverages the efficiency of Random Forests by using randomly selected instances as prototypes at split nodes, serving as a regularization technique that minimizes tuning requirements and computational load. Conversely, PFPL incorporates a stochastic gradient descent-based learning mechanism to optimize prototypes at each node, generating splits that better separate bag classes. We evaluated both approaches against 18 state-of-the-art baselines across 71 benchmark datasets from diverse domains, including image, text, and audio classification. Extensive experiments demonstrate that PFPL achieves the highest predictive performance among all tested methods (Average AUC: 0.899). However, this accuracy comes with a computational trade-off, as PFPL requires significantly higher run-time compared to the standard PF, which remains highly competitive (Average AUC: 0.887) while maintaining the speed advantages of non-parametric ensembles.}
}
@article{KARAMI2026116556,
title = {Graph Regularized Deep Symmetric Nonnegative Matrix Factorization},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116556},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116556},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012827},
author = {Saeed Karami and Farid Saberi-Movahed and Prayag Tiwari and Sławomir Nowaczyk and Jens Lehmann and Sahar Vahdati},
keywords = {Symmetric NMF, Deep symmetric NMF, Multi-layer decomposition, Graph regularization, Clustering},
abstract = {Symmetric Nonnegative Matrix Factorization (SNMF) has shown strong potential for clustering data with linear and nonlinear structures by factorizing a symmetric similarity matrix into a clustering assignment matrix and its transpose. However, existing SNMF-based methods face two important limitations. First, most of them are shallow and thus cannot sufficiently capture hierarchical and multi-level structures in complex data. Second, although graph-regularized SNMF methods preserve local geometry, they usually impose graph constraints on a single representation, which limits geometry preservation across a deep hierarchy. To address these gaps, we propose Graph Regularized Deep Symmetric Nonnegative Matrix Factorization (GDSNMF), a deep SNMF framework that extends single-layer symmetric factorization to multi-layer hierarchical decomposition. GDSNMF learns a composed deep representation through the product of layer-wise factors and introduces a deep similarity graph by imposing Laplacian regularization on this composed representation. Consequently, neighborhood and manifold information can be propagated through the entire hierarchy, enabling the model to jointly capture hierarchical structure and intrinsic data geometry. Moreover, GDSNMF is developed from both symmetric and nonsymmetric perspectives. The main symmetric formulation preserves the original SNMF structure and leads to a fourth-order matrix polynomial, whereas the nonsymmetric variant uses a second-order matrix polynomial as a simpler alternative. This dual formulation enables a direct investigation of the trade-off between symmetry preservation, mathematical tractability, and empirical performance. For both variants, multiplicative update rules are derived and convergence behavior is analyzed. Experiments on eleven benchmark datasets from image analysis, biology, text processing, and community detection demonstrate that the symmetric fourth-order GDSNMF generally outperforms its nonsymmetric counterpart and several classical, state-of-the-art, and recent NMF-based methods under a unified and interpretable deep factorization setting. The source code and experimental scripts are publicly available at https://github.com/saeedkarami2012/GDSNMF.}
}
@article{WANG2026116476,
title = {FedTOF: Mitigating poisoning attacks in Federated Learning via tail orthogonal forgetting},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116476},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116476},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012025},
author = {Cong Wang and Yifan Cao and Ziqiao Yin and Binghui Guo},
keywords = {Federated learning, Poisoning attacks, Orthogonal forgetting, Tail-subspace detection},
abstract = {Federated Learning (FL) is a promising paradigm for distributed model training, enabling clients to collaboratively learn a global model without sharing raw data. However, its decentralized nature exposes FL systems to various attacks, particularly data and model poisoning attacks, which compromise model integrity and performance. Existing defenses typically rely on detecting and removing suspicious clients or updates, which often discard useful information, and malicious updates injected in the early stages cannot be eliminated by client exclusion. To address these challenges, we propose FedTOF, a robust federated defense framework based on tail orthogonal forgetting. Instead of directly excluding suspicious clients, FedTOF identifies and suppresses malicious gradient directions while preserving valuable updates from benign clients. Specifically, we introduce a tail-subspace-based detection mechanism that analyzes the low-energy components of gradient updates to capture abnormal gradient directions indicative of attack behavior. FedTOF then performs orthogonal forgetting, removing the contribution of these attack-related directions from the aggregated gradient while maintaining alignment with the dominant benign update directions. Through extensive experiments, we demonstrate that FedTOF effectively defends against diverse poisoning attacks and mitigates their long-term impact, providing a principled and scalable solution for secure federated learning.}
}
@article{CHEN2026116439,
title = {Reliability-aware dual graph convolutional network for multi-view learning},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116439},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116439},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011652},
author = {Hongrong Chen and Weiran Liao and Jielong Lu and Fu Zhao and Jiayuan Wang and Haiyao Su and Na Song and Shiping Wang},
keywords = {Multi-view learning, Graph convolutional network, Deep generative model, Semi-supervised learning},
abstract = {With the rapid development of multimedia technologies and the explosive growth of multi-source heterogeneous data, multi-view learning has attracted increasing attention. Although existing methods have effectively modeled intra-view and inter-view relationships, inevitable noise in real-world scenarios still leads to imbalanced view quality, which in turn introduces conflicts during view integration and causes decision bias in the fused representations. To address these challenges, we propose a reliability-aware dual graph convolutional network to enhance the reliability of view fusion. Specifically, we introduce a reliability-guided Bayesian inference mechanism to characterize view quality and learn shared representations across views under the guidance of view evidence. Moreover, to comprehensively capture both intra-view and inter-view data dependencies, we propose a dual graph convolutional network that collaboratively models intra-view complementarity and inter-view consistency, thereby improving robustness and overall learning stability. Experiments on multiple benchmark datasets demonstrate the effectiveness and robustness of the proposed method for multi-view semi-supervised classification.}
}
@article{FU2026116552,
title = {Research on self-enhancing multi-agent systems under multi-task objectives},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116552},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116552},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012785},
author = {Yuanshuang Fu and Yihao Zhao and Jiaxin Zhao and Bonan Zhang and Hui Zhao and Zhijun Li},
keywords = {TTEA, LLM, Multi-agent, System, Evolution mechanisms},
abstract = {With the rapid development of large language model (LLM) technology, the ability of intelligent agents to handle complex tasks has significantly improved, and multi-agent systems have become increasingly complex. Enabling agents with different targets and architectures to collaborate in a shared environment is crucial. Current research has largely focused on agent performance in specific scenarios, neglecting system-level enhancement methods. This paper proposes a self-enhancing multi-agent system approach, called “Top-Level Target-Element-Association” (TTEA), which aims to achieve system self-enhancement through optimized system architecture and efficient collaboration among agents. The TTEA framework achieves efficient collaboration and self-enhancement in multi-agent systems through the guidance of top-level targets, an agent evolutionary mechanism, cross-level knowledge collaboration, and dynamic task dispatching. Specifically, the top-level target provides a global perspective on agent behavior through a global utility function and a system impact assessment module. The evolution and communication mechanism, through skill enhancement operators, learning operators, and elimination operators, automatically enables agent self-evolution and optimizes the utilization of system resources. Cross-level knowledge collaboration, through category leaders and a global leader, enables knowledge sharing and information aggregation among agents of different categories. Dynamic task dispatch ensures efficient task completion by monitoring and adjusting task allocation in real time. This paper tested the model’s generalization ability and accuracy stability on nine public datasets for web navigation, translation, and knowledge-enhanced generation tasks, achieving superior results. The project code and data related to this paper are publicly available at: https://github.com/Futr1/TTEA.}
}
@article{QIAN2026116589,
title = {Find what you missed: Causal recovery for visual tokens in vision-language models},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116589},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116589},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013158},
author = {Taoyu Qian and Qi Wang and Shang Gao and Hualong Yu},
keywords = {Vision-language model, Token pruning, Causal-inspired pruning},
abstract = {Accelerating the inference of vision-language models (VLMs) is essential for reducing computational overhead, enabling their efficient deployment in latency-sensitive scenarios while preserving the balance between multimodal performance and inference efficiency. However, existing token pruning methods typically rely on attention scores or token similarity to identify and remove redundant tokens, focusing solely on the salient features of target entities while overlooking the dependencies between contextual information and target entities, thereby degrading the causal generalization capability of the model. To address this limitation, we construct a Visual Union CoT Dataset upon existing CoT data, and train a Causal Visual Inference Network (CaVIN) to capture CoT-derived reasoning dependencies as weak causal signals among visual tokens, offering a causal-inspired supervision paradigm. The discrimination capability of CaVIN is then leveraged to estimate the weak causal signals between visual tokens surviving conventional correlation-based pruning and the remaining ones, enabling the recovery of causally relevant tokens and alleviating the degradation of causal generalization. Experimental results demonstrate that the lightweight CaVIN-3.22M effectively identifies weak causal signals among visual tokens and suppresses bias tokens, achieving an accuracy of 76.7%. In visual token pruning experiments, the VLM enhanced by CaVIN achieves the best performance among competing methods under an aggressive pruning rate of 85%. Code is available at https://github.com/taoyu-qian/CaVIN.}
}
@article{LU2026116520,
title = {A feature selection approach based on subset scoring for high-dimensional data},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116520},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116520},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012463},
author = {Jiaxuan Lu and Hyukjun Gweon},
keywords = {Feature selection, Feature importance, High-dimensional data, k-nearest neighbor, Backward selection, Subset scoring},
abstract = {High-dimensional data present substantial challenges for distance-based classifiers, as the presence of many irrelevant or noisy features can reduce the informativeness of distance measures. Despite the availability of existing feature selection methods for such classifiers, the problem remains difficult in high-dimensional settings where noise can obscure class structure. In this paper, we propose a novel feature selection method grounded in class separability. To mitigate the effects of high dimensionality, the proposed approach evaluates each feature’s contribution to class separability by calculating separation scores across multiple randomly generated lower-dimensional feature subsets. We assess the proposed method using extensive simulation studies and 24 high-dimensional microarray datasets. The simulation results show that the method consistently identifies informative features while eliminating noise, thereby maintaining stable classification performance even when most features are non-informative. In benchmark comparisons with existing feature selection techniques, the proposed approach achieves superior predictive performance on most datasets while reducing dimensionality to, on average, 2% of the original feature set. A case study on prostate cancer data further demonstrates that the selected feature subset is enriched with biologically relevant signals. These findings suggest that the proposed method provides an effective and interpretable feature selection framework for distance-based classification of high-dimensional data.}
}
@article{LI2026116572,
title = {Beyond alignment: Discovering cross-graph triples for knowledge graph integration},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116572},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116572},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012980},
author = {Mingda Li and Ao Gao and Yongqiang Tang and Yuanpeng Deng and Wensheng Zhang},
keywords = {Knowledge graph integration, Knowledge graph embedding, Entity alignment, Link prediction},
abstract = {The inherent incompleteness of knowledge graphs (KGs) significantly restricts their potential in artificial intelligence applications. While integrating multiple KGs serves as a promising solution to augment knowledge coverage, existing methods primarily rely on identifying the aligned entities that belong to different KGs for integration. Considering that the KG is capable of containing rich semantic information via its diverse relational links, over-reliance on the alignment links between entities fails to capture the multi-relational structural dependencies across different KGs. To address these limitations, this paper proposes a novel embedding method to discover the cross-graph triples, which reflect complex semantic interactions between KGs, for comprehensive integration. Specifically, we design a cross-KG structural encoder that can exploit both intra-graph and inter-graph message passing to obtain the consistent embeddings of entities. These embeddings are applied to measure the alignment confidence for each entity pair, generating the pseudo-alignment candidates. On this basis, cross-graph triples are constructed, followed by an entropy-guided selection strategy to retain high-confidence available triples at each training round. Finally, we present a joint training loss with contrastive learning to optimize the embeddings with the augmented structural information. Extensive experiments have been conducted on four benchmarks designed for the cross-graph triple prediction task, and the results show that our method significantly outperforms the baselines.}
}
@article{CHEN2026116290,
title = {MetaAug: Task augmentation via entropy increase for robust meta-learning},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116290},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116290},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010166},
author = {Yaqi Chen and Chaolong Hao and Hao Zhang and Dan Qu and Wei-Qiang Zhang},
keywords = {Meta learning, Task augmentation, Information theory, Speech recognition, Low-resource},
abstract = {Meta-learning has emerged as a powerful paradigm for low-resource speech recognition by leveraging knowledge from multiple languages. However, multilingual meta-learning suffers from two critical overfitting challenges: task-overfitting, where the task learner fails to generalize from support to query sets, and learner-overfitting, where the meta-learner fails to generalize from meta-training to meta-testing tasks. To address these challenges, we propose MetaAug, a theoretically grounded task augmentation framework comprising intra-task and cross-task augmentation strategies. Both strategies augment the task space by linearly interpolating perturbed features (or hidden representations) and their corresponding losses within and across tasks, thereby generating a denser sampling of the task distribution. We establish a rigorous information-theoretic foundation for effective task augmentation and prove that MetaAug satisfies the criterion by provably increasing information entropy. Extensive experiments across 35 languages from diverse language families demonstrate that MetaAug consistently improves meta-generalization, achieving a notable reduction in 6.73% word error rate (WER) on the FLEURS dataset compared to strong baselines.}
}
@article{SHAMSHIRI2026116492,
title = {A domain-specific knowledge graph for reasoning over AI security threats and defenses},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116492},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116492},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012189},
author = {Samaneh Shamshiri and Danial Javaheri and Mahdi Fahmideh and Junbeom Hur},
keywords = {AI security, Adversarial machine learning, Knowledge graphs, Large language models},
abstract = {Despite rapid growth in research on AI security and privacy, evidence-backed links between attacks and defenses remain fragmented, making synthesis and audit difficult at scale. In this study, we present a domain-specific AI security knowledge graph (KG) constructed from 780 research papers on model-level attacks and defenses using an ontology-constrained, evidence-gated extraction pipeline. The proposed pipeline (1) distills paper text into structured chunks, (2) extracts typed entities and directed relations from a closed ontology, and (3) admits a triple only when it is supported by within-paper sentence-level provenance (verbatim supporting quotes from the paper), while preserving contradictory claims, e.g.“mitigates” vs. “bypasses” with provenance rather than collapsing them. On a 600-triple pooled-candidate, expert-adjudicated QC set, the extractor achieves 0.92 precision and 0.84 triple-level F1, outperforming by 0.19–0.36 open and scientific information-extraction baselines (OpenIE, SciIE) and slightly improving UIEPrompter-style structured-prompting baseline (0.83 F1), while reducing unsupported edges that could mislead downstream security reasoning. We introduce a mitigation-claim coverage metric defined as Attack–Defense Alignment Score (ADAS), the fraction of attacks with at least one verified, non-conflicted mitigating defense; the graph reaches 0.73, exceeding randomized baselines that preserve node types by 0.13–0.17 and highlighting attacks with sparse verified defenses. In the held-out defense recommendation, top-1 success (Hits@1: fraction of test attacks whose correct defense is ranked first) improves by 19.8 percentage points to 0.39 over the best text-only baseline, and each recommendation includes supporting quotes to enable verification.}
}
@article{XU2026116544,
title = {DDCL-Net: dual-domain collaborative learning network for EEG-based emotion recognition},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116544},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116544},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012700},
author = {Zihao Xu and Zhenrong Ruan and Chi-Man Vong and Huqin Weng and Chuangquan Chen},
keywords = {EEG-based emotion recognition, Transfer learning, Sample relationships},
abstract = {Transfer learning (TL) has been extensively applied to EEG-based emotion recognition to address various cross-domain challenges, including cross-session, cross-subject, and cross-dataset scenarios. However, existing TL approaches typically focus on either cross-session and cross-subject variability within a dataset (intra-domain issues) or heterogeneity across datasets (inter-domain issues). These methods lack a unified mechanism to integrate intra-domain refined features learning with inter-domain transferred features enhancement, often resulting in unrefined and suboptimal feature representations. Addressing this gap, we propose a novel Dual-Domain Collaborative Learning Network (DDCL-Net), which employs a cross-sample interactive fusion to integrate the inter-domain transferred features enhanced by the pretrain-finetune technique and the intra-domain refined features guided by distillation learning. DDCL-Net consists of three components: 1) a pretraining strategy that leverages shared EEG channels from a large-scale dataset with multiple subjects and sessions to learn subject-invariant and temporal-invariant features, thereby improving inter-domain generalization; 2) a handcrafted-feature-guided distillation mechanism that extracts intra-domain refined features from raw EEG signals through parallel use of temporal and spatial Transformers and enforcement of a two-stage hierarchical constraint aligning channel-level and sample-level covariances; and 3) a cross-sample attention fusion module, regularized by a diversity constraint, that recalibrates feature representations by integrating intra-domain refined features with inter-domain transferred features through exploring the sample relationship. Extensive experiments conducted on raw EEG signals from public datasets under cross‐session and within-session cross-subject scenarios demonstrate that DDCL-Net consistently outperforms state-of-the-art methods, achieving average accuracy improvements of 6.27% on SEED-IV, 4.45% on SEED-V, and 7.37% on SEED-VII, compared to the strongest baseline.}
}
@article{XUE2026116563,
title = {AGAM: A randomly initialized policy network for action mask fusion in reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116563},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116563},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601289X},
author = {Buqing Xue and Qian Chen and Zilong Wang and Linkang Du and Jiaqi Zhao and Tao Hu},
keywords = {Policy-based RL, Action masks, Optimization efficiency, Adaptive gating module},
abstract = {Action masks have been widely used to mask invalid actions in reinforcement learning (RL). However, action masks alter the policy network’s distribution, potentially leading to optimization efficiency bottlenecks. To address this issue in policy-based RL, we introduce an adaptive gating action mask policy network, termed AGAM, to improve reward performance. In AGAM, an adaptive gating module with random initialization is introduced to fuse action mask information and action logic values. Specifically, the adaptive gating module enables the agent to adaptively adjust the weights assigned to action masks and action logic values during optimization, thereby improving optimization efficiency. Additionally, we provide a heuristic convergence analysis of policy-based RL algorithms equipped with AGAM, along with a computational complexity analysis. Experimental results in four Gym environments demonstrate that AGAM outperforms four state-of-the-art (SOTA) baselines. AGAM shows a more pronounced improvement in reward during training and achieves up to 86% better performance during inference. Furthermore, to explore the practical application potential of AGAM, we conduct a multi-objective optimization experiment on reservoir scheduling. The results show that AGAM can obtain Pareto-optimal solutions in real-world implementation scenarios.}
}
@article{ZHENG2026116455,
title = {FasterSTMTrack: A faster and more efficient visual object tracking with space-time memory network},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116455},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116455},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011810},
author = {Yu Zheng and Yong Liu and Xun Che},
keywords = {Space–time memory network, Memory update, Dynamic frame, Static frame, Appearance-aware score},
abstract = {In previous work, space–time memory network (STMN) was introduced to perform template-free tracking, where strong robustness is demonstrated when challenges such as occlusion and appearance changes occur. However, during inference, the query image is encoded frame-by-frame by a deep network, at the same time, the memory frame sequence is simultaneously updated. The continuity of spatio-temporal contextual information is not taken into account by such frameworks, leading to significant redundant computations and computational overhead. To address these shortcomings, a dynamic strategy is proposed for the query branch. Specifically, we introduce an appearance-aware module, which is a lightweight network. Query frames are input to this module and outputs an expected appearance-aware score, which is used to determine whether a query frame is dynamic or static. Specifically, if the current query frame is labeled as a dynamic frame, it is sent to the slow path (encoded by the deep network); otherwise, it is sent to the fast path (where features from the current dynamic frame are reused). Additionally, we propose an efficient memory update module. Unlike the continuous updates in previous methods, we dynamically and adaptively update the memory frame sequence based on the update factor. Finally, we present two variants: a fast version (FasterSTMTrack-FS) and a balanced version (FasterSTMTrack-BS), compared to the baseline method (STMTrack: 64.2% AO and 37 fps runtime speed), the former achieved 60.1% AO and 54 fps runtime inference speed, while the latter achieved 54.0% AO and 77 fps runtime inference speed on GOT-10k. Qualitative and quantitative evaluations are implemented on multiple datasets, it is reported that significant improvement in inference speed gained at the cost of a relatively minor accuracy degradation.}
}
@article{LAI2026116516,
title = {TipRec: Time-interval-aware prompting for Recommendation with large language models},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116516},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116516},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012426},
author = {Pei-Yuan Lai and Zhen-Wei Huang and De-Zhang Liao and Kai-Huang Lai and Chang-Dong Wang},
keywords = {Time-interval-aware, Sequential recommendation, Large language models, Data mining},
abstract = {Time-interval-aware sequential recommendation, aiming to discover temporal features in user interaction sequences for precise intent capture, constitutes a critical task in personalized recommendation systems. Although recent progress in Large Language Models (LLMs) has showcased remarkable capabilities in semantic understanding and logical reasoning, thereby offering new potential for enhancing recommendation quality, most existing LLM-based approaches typically focus on leveraging semantic content while directly ignoring the fine-grained temporal features inherent in interaction sequences. How to collaboratively model fine-grained temporal intervals and semantic content within a unified LLM framework remains a challenging problem. To address these limitations, we propose Time-interval-aware prompting for Recommendation with LLMs (TipRec) framework. Specifically, we first standardize item description texts to generate initial semantic representations and expand the LLM vocabulary by establishing associations between item IDs and semantic information. Concurrently, we discretize inter-event time intervals into interval tokens, which are then combined with item ID tokens to form structured sequences preserving behavioral order and temporal granularity. To facilitate the integration of temporal reasoning with deep semantic understanding, we design four collaborative fine-tuning tasks to internalize both sequential behavioral features and item-level semantics within a unified representation space. Extensive experiments conducted on four real-world datasets demonstrate the effectiveness of TipRec.}
}
@article{ZHANG2026116568,
title = {Hierarchical cross-modal prompt learning with LLM-guided alignment for Vision-Language Models},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116568},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116568},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012943},
author = {Wenyu Zhang and Fuxiang Lu and Shi Yan},
keywords = {Few-shot classification, Prompt learning, Vision-Language Models, Cross-modal learning},
abstract = {Vision-Language Models such as CLIP have shown impressive zero-shot recognition performance by aligning images and text in a shared embedding space. However, their generalization often deteriorates in few-shot settings due to the inflexibility of hand-crafted textual templates and limited adaptability to novel visual domains. To overcome these limitations, we propose HCKP, a hierarchical cross-modal prompt learning framework that facilitates deep and structured alignment between visual and textual prompts across multiple transformer layers. The HCKP framework incorporates cross-modal learnable prompts to capture layer-specific semantic cues, refining the prompt representations via an adaptive gated knowledge module that dynamically balances interactions between the modalities. Furthermore, we incorporate external semantic knowledge from large language models during training, using rich natural language descriptions to regularize textual prompts via LLM-guided alignment objectives. This LLM-guided supervision significantly improves semantic discrimination, especially for fine-grained or visually similar categories. Extensive experiments across eleven datasets demonstrate that HCKP achieves better performance in base-to-novel generalization, consistently surpassing existing prompt-based and adapter-based approaches under various few-shot configurations. Ablation studies validate the individual contributions of hierarchical prompting, cross-modal coordination, and LLM-guided knowledge alignment to the overall effectiveness of our method.}
}
@article{SUN2026116309,
title = {MInCo: Mitigating conflicting objectives in distracted visual model-based reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116309},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116309},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601035X},
author = {Shiguang Sun and Hanbo Zhang and Zeyang Liu and Xinrui Yang and Lipeng Wan and Xingyu Chen and Xuguang Lan},
keywords = {Model-based reinforcement learning, Visual reinforcement learning, Representation learning, Continuous control under visual distractions},
abstract = {Existing visual model-based reinforcement learning (MBRL) algorithms with observation reconstruction are often susceptible to optimization conflict between competing objectives, making it difficult to learn compact representations and hence yielding less robust policies, especially in the presence of task-irrelevant visual distractions. In this paper, we analyze this phenomenon from an information-theoretic perspective and show that it can be interpreted as a trade-off between information preservation and dynamics-oriented compression, which is related to the Information Bottleneck principle. Based on this insight, we present a new algorithm, MInCo, which mitigates such optimization conflict in visual MBRL by leveraging negative-free contrastive learning, aiding in learning invariant representations and robust policies despite noisy observations. To prevent the dominance of visual representation learning, we introduce time-varying reweighting to bias the learning toward dynamics modeling as training proceeds. We evaluate our method on several robotic control tasks with dynamic background distractions. Our experiments demonstrate that MInCo learns invariant representations against background noise and consistently outperforms current state-of-the-art visual MBRL methods, yielding around 25% improvements on Distracted DMC and over 10% gains on Maniskill. Code is available at https://github.com/ShiguangSun/minco.}
}
@article{WANG2026116487,
title = {VBEM-based localization of multi-agent systems in irregular wireless networks},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116487},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116487},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601213X},
author = {Zhaoyang Wang and Qian Ma and Jiping Xu and Huiyan Zhang and Xu Jiang},
keywords = {Irregular wireless network, VBEM, Anisotropic localization, CRLB},
abstract = {Location-aware wireless networks can provide precise location information in harsh environments, however, localization is significantly affected by irregular network topologies. For network topologies containing holes or obstacles, the deviation induced by nonlinear distance measurements can be modeled as a latent variable with inherent uncertainty. To mitigate the adverse effects of nonlinear distance, a variational Bayesian expectation maximum (VBEM) localization model is proposed, in which localization parameters are iteratively updated through the variational Bayesian expectation (VBE) step and variational Bayesian maximization (VBM) step, respectively. Performance limits are also investigated using Cramér–Rao lower bound (CRLB) and hybrid CRLB (HCRLB). Further inspection on the performance limits confirms the auxiliary node selection by tightness condition. Simulation results demonstrate that the proposed method achieves significantly higher localization accuracy than existing methods.}
}
@article{SHI2026116560,
title = {SRD: A model-agnostic semantic framework for jailbreak mitigation in large language models},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116560},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116560},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012864},
author = {Can Shi and Zhiyong Zhang and Gaoyuan Quan and Junyan Pan and Xinxin Yue},
keywords = {Large language models, Jailbreak defense, Semantic detection},
abstract = {Despite recent advances in alignment training, large language models (LLMs) remain vulnerable to black-box jailbreak attacks that exploit semantic ambiguity, role-playing prompts, and multi-turn prompt manipulation. Existing defenses mainly rely on static system prompts, decoding-time heuristics, or internal-model signals, which limit their robustness under distribution shifts and hinder deployment on closed-source APIs. To address these limitations, we propose Semantic Rollback Defense (SRD), a model-agnostic framework that reframes jailbreak mitigation as semantic intent recovery. SRD combines dense risk representations with a recursive intent rollback mechanism to identify and neutralize hidden malicious intent in adversarial prompts without requiring access to model internals. Unlike surface-level filtering approaches, SRD dynamically adapts safety constraints based on the recovered user intent, enabling targeted interventions while reducing unnecessary blocking. We evaluate SRD extensively across multiple open- and closed-source LLMs under diverse black-box jailbreak scenarios drawn from AdvBench and MT-Bench. SRD achieves an average defense success rate of 98.27%, outperforming several state-of-the-art baselines. These findings suggest that semantic-intent-based defense offers a practical and generalizable approach for improving LLM safety.}
}
@article{XIANG2026116576,
title = {A surrogate-assisted multitask knowledge transfer optimization algorithm and application},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116576},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116576},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601302X},
author = {Junyu Xiang and Huachao Dong and Jinglu Li and Wenxin Wang and Shengfa Wang and Guanghui Liu and Peng Wang},
keywords = {Global optimization, Transfer optimization, Unmanned underwater vehicle, Multitask knowledge},
abstract = {Conventional optimization methods, which initiate the search from scratch without leveraging prior knowledge, are always time-consuming and resource-inefficient. However, most problems in the real world do not exist in isolation, such as those in the fields of aerospace, transportation, etc. Abundant data and knowledge of similar optimized tasks can be utilized by transfer optimization to help the optimization of target task, which has attracted growing attention in recent years. However, when the similarity between two tasks is insufficient, the transferred knowledge is likely to mislead the search, which is called negative transfer. To address this issue, a surrogate-assisted multitask knowledge transfer optimization algorithm (SATO) is proposed in this article. In SATO, an intermediate task is constructed to enhance the similarity among multiple tasks, thereby facilitating more effective transfer optimization. In addition, a distance-based source database construction mechanism is devised. Through this mechanism, the source database consists of samples most relevant to the target task, rather than those with superior performance but low similarity. This ensures that the transfer optimization process is supported by a more relevant and informative source database. Furthermore, a transfer integration model is established among the source, intermediate, and target tasks in SATO. This model facilitates the selection of new promising samples and continuously refine the predictive model for the target task, ultimately achieving efficient transfer optimization based on multitask knowledge. Experimental results demonstrate that the proposed SATO exhibits superior performance when compared with seven algorithms, achieving the best results in 53.9% out of the benchmark cases. Eventually, SATO is applied to the shape optimization of unmanned underwater vehicle (UUV). The results further validate its competitiveness in handling computationally expensive engineering problems.}
}
@article{ZHANG2026116593,
title = {JCNet: Joint Context-Aware Network for OCT retinal layer segmentation with boundary refinement},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116593},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116593},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013195},
author = {Zichen Zhang and Yunjie Chen and Guanfang Wang and Fan Yang and Teng Wang and Zhichao Zhang and Chunzheng Cao},
keywords = {OCT, Retinal layer segmentation, Cross-scale feature fusion, Transformer},
abstract = {Automatic retinal layer segmentation in optical coherence tomography (OCT) images is essential for diagnosis, treatment planning, and longitudinal monitoring of diseases such as diabetic macular edema and multiple sclerosis. Existing U-Net- and Transformer-based methods suffer from four fundamental limitations in this task: attention noise from irrelevant tokens degrades inter-layer correspondence under high retinal-layer similarity, the lack of spatial priors in non-local feature selection neglects retinal topology, conventional skip connections fail to bridge semantic gaps between low- and high-level features, and global signed-distance-field boundary regression propagates local prediction errors across weak-boundary regions. To address these issues, this paper proposes a Joint Context-Aware Network (JCNet) that integrates explicit spatial priors into Top-K region selection via a Spatial Top-K Transformer, couples a Cross Routing Transformer with Feature Alignment Decoder Blocks to align encoder–decoder semantics and reconstruct discriminative features, and adopts a Truncated Signed Distance Function Boundary Loss to constrain boundary-regression errors within local weak-boundary neighborhoods. The proposed framework aims to answer two key questions: (1) how to extract non-local features with anatomical spatial correspondence while suppressing attention noise, and (2) how to reconcile semantic inconsistencies between encoder and decoder representations. Experimental results on the HCMS, Duke DME, HEG, and GOALS datasets demonstrate that JCNet achieves state-of-the-art retinal layer segmentation performance across both healthy and pathological OCT images. The code is available on GitHub (https://github.com/NuistSMS/JCNet).}
}
@article{MA2026116512,
title = {Mining latent clue chains to enhance performance in few-shot out-of-graph link prediction in temporal knowledge graphs},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116512},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116512},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012384},
author = {Ziqi Ma and Jinpeng Li and Yimin Wen and Hang Yu},
keywords = {Temporal knowledge graph, Few-shot link prediction, Reinforcement learning, Large language models},
abstract = {Temporal Knowledge Graph (TKG) link prediction aims to infer missing entities by leveraging temporal contextual information. However, in practical scenarios, TKGs face challenges such as sparse contextual information and the emergence of previously unseen entities, which significantly constrain inference performance. Existing approaches typically rely on aggregating neighbor information to generate representations for unseen entities. In contexts with limited information, such feature aggregation methods exhibit restricted expressive capacity, often resulting in homogenized inference outcomes. While Large Language Models (LLMs) exhibit strong associative reasoning and generalization capabilities to handle data sparsity in the TKG domain, their reasoning remains fragile and prone to internal biases when the retrieved temporal context is fragmented and lacks explicit logical coherence. To address these issues, we propose an inference framework that integrates RL-based temporal retrieval with LLM generation, named TRL-LLM. It aims to enhance the reasoning performance of TKG few-shot out-of-graph (TKG-FOG) link prediction by combining the exploratory capabilities of reinforcement learning (RL) with the comprehension abilities of LLMs. First, we propose a time-aware entity encoding module that aggregates temporal neighborhood information and periodic patterns to generate context-enriched representations for unseen entities. Then, an RL agent mines logically coherent latent clue chains through a multi-hop retrieval process, providing interpretable evidence for each query. Finally, the retrieved clue chains are passed to a generative LLM-based reasoner, which is fine-tuned to improve its ability to predict potential object entities. Experiments on five benchmark datasets indicate that our method outperforms existing state-of-the-art approaches and provides effective, interpretable reasoning evidence.}
}
@article{LIU2026116585,
title = {Fundus image-based glaucoma screening via retinal knowledge-oriented dynamic multi-level feature integration},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116585},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116585},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013110},
author = {Chi Liu and Yuzhuo Zhou and Sheng Shen and Zongyuan Ge and Fengshi Jing and Shiran Zhang and Yu Jiang and Anli Wang and Wenjian Liu and Feilong Yang and Tianqing Zhu and Xiaotong Han},
keywords = {Glaucoma screening, Retinal foundation model, Knowledge-enhanced attention, Dynamic feature integration},
abstract = {While deep learning has advanced automated glaucoma screening via color fundus photography, existing purely data-driven models often overfit to confounding imaging artifacts and struggle to capture unpredictable pathological cues located beyond predefined anatomical boundaries. To address these limitations, we propose a retinal knowledge-oriented framework that synergizes dynamic multi-scale feature learning with domain-specific anatomical priors. The proposed architecture adopts a tri-branch structure to jointly model the global retinal context, the structural characteristics of the optic cup and disc, and dynamically cropped pathological regions. Specifically, we devise a Dynamic Window Mechanism (DWM) that adaptively discovers diagnostically informative patches via image-level supervision. Furthermore, we introduce a Knowledge-Enhanced Convolutional Block Attention Module (KE-CBAM) that explicitly incorporates retinal priors from a pre-trained foundation model RETFound to guide spatial attention, preventing the network from assigning spurious weights to irrelevant background noise. Extensive evaluations on the large-scale AIROGS dataset demonstrate that our method achieves a state-of-the-art AUC of 98.5% and an accuracy of 94.6%. More importantly, the integration of anatomical priors effectively mitigates the inherent class imbalance, significantly improving the detection of referable glaucoma cases. Additional validations on the SMDG-19 benchmark further confirm its superior cross-domain generalization, indicating that our contribution provides a robust, interpretable, and scalable solution for real-world clinical glaucoma diagnosis. Our code is available at https://github.com/magiczhuo/Glaucoma-Detection.}
}
@article{YU2026116488,
title = {Explicit–spectral collaborative modeling for 3D point cloud understanding},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116488},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116488},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012141},
author = {Li Yu and Daopeng Zhang},
keywords = {3D point cloud understanding, Explicit geometric structure modeling, Spectral-domain feature analysis, Collaborative representation learning, Multi-domain feature learning},
abstract = {Three-dimensional point clouds are inherently unordered, sparse, and non-uniformly distributed, posing persistent challenges for effective geometric representation learning. Although existing methods have achieved notable progress in either local geometric modeling or global dependency learning, jointly capturing fine-grained local structures and long-range contextual relationships remains challenging. Furthermore, the entanglement of structural information and noise in spatial-domain representations adversely affects feature discriminability. To address these issues, we propose ExSpec-Net, a dual-domain cooperative framework for 3D point cloud representation learning. The spatial branch explicitly models local directional geometry and topological structures through an octant-based spatial encoding mechanism and input-adaptive convolutional kernels. The spectral branch leverages an orthonormal frequency basis derived from the graph Laplacian to decompose and reconstruct frequency components, thereby enhancing structure-related information while suppressing the influence of high-frequency perturbations and providing complementary global structural priors. The representations learned from the two branches are subsequently fused into a unified dual-domain feature representation and processed by a bidirectional Mamba module for efficient long-range dependency modeling. Extensive experiments on ScanObjectNN, ModelNet40, and ShapeNetPart demonstrate that ExSpec-Net achieves stable and competitive performance across 3D object classification, part segmentation, and few-shot learning tasks. The code and pretrained weights are available at https://github.com/Mlter960/ExSpec-Net.}
}
@article{BAO2026116577,
title = {A recent survey of heterogeneous transfer learning},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116577},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116577},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013031},
author = {Runxue Bao and Yiming Sun and Yuhe Gao and Jiabao Li and Ran Fang and Jindong Wang and Qiang Yang and Zhi-Hong Mao and Chenxi Song and Ai Ren and Ye Ye},
keywords = {Heterogeneous transfer learning, Knowledge sharing, Data-based method, Model-based method},
abstract = {Transfer learning, which leverages knowledge from source domains to improve model performance in a target domain, has witnessed significant growth. Commonly, transfer learning methods assume identical feature and label spaces in both source and target domains—an approach known as homogeneous transfer learning. However, this assumption is often impractical, as domains frequently differ in their feature or label spaces, making precise data alignment both challenging and resource-intensive. Consequently, heterogeneous transfer learning (HTL), which addresses these disparities, has become an essential strategy in various tasks. In this paper, we provide an extensive review of over 60 HTL methods, covering both data-based and model-based approaches. We detail their key assumptions and algorithms, systematically categorizing them into instance-based, feature representation-based, parameter regularization, and parameter tuning techniques. We also conduct experiments to compare a few open-source HTL methods on four benchmarks and release the corresponding experimental scripts through GitHub. Furthermore, we examine applications in natural language processing, computer vision, multimodal learning, and biomedicine, with the aim of enhancing understanding and fostering further research in these areas. Our review incorporates recent advancements in HTL, including the adoption of transformer-based models and multimodal learning techniques, ensuring the discussion reflects the latest developments in the field. Additionally, we identify key limitations in current HTL research and provide systematic guidance for future investigations, highlighting areas that require further exploration and suggesting potential directions to advance the field.}
}