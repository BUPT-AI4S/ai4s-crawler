@article{DENG2026117265,
title = {ADMP: Adaptive Dynamic Multi-Proxy allocation for deep metric learning},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117265},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117265},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601991X},
author = {Xiangyu Deng and Guanghua Yang and Xiaofan Li and Jianqing Li and Xiaochen Yuan and Xueyuan Gong},
keywords = {Deep metric learning, Proxy-based learning, Adaptive multi-proxy allocation, Image retrieval, Representation learning},
abstract = {Proxy-based deep metric learning (DML) learns discriminative embedding spaces by employing learnable proxies to encourage intra-class compactness and inter-class separation. Representative methods such as Proxy-Anchor use proxies as anchors to enable efficient and stable optimization, while SoftTriple further assigns multiple centers to each class to model intra-class variation. Nevertheless, each class is usually represented by either a single proxy or a fixed number of proxies determined before training. Such a design ignores the heterogeneous intra-class complexity across classes, leading to redundant proxies for simple classes and insufficient representation for complex classes. To address this, we propose Adaptive Dynamic Multi-Proxy (ADMP), a proxy-based DML framework that adaptively adjusts the number of proxies for each class during training. ADMP maintains an Elastic Proxy Bank (EPB), where sub-proxies are added for insufficiently represented regions and highly similar sub-proxies are merged to suppress redundancy. The final allocation statistics indicate that different classes retain different numbers of proxies after training. On SOP, groups with higher complexity tend to retain more proxies. To stabilize optimization under dynamic proxy changes, ADMP further introduces two regularization terms: an EMA-based stability regularizer to smooth proxy evolution and an intra-class diversity regularizer to prevent sub-proxy degeneration. Experiments on CUB-200-2011, Cars196, Stanford Online Products (SOP), and In-Shop Clothes Retrieval (InShop) show competitive retrieval performance.}
}
@article{HE2026117224,
title = {Anchor-guided feature manifold distortion for attacking dynamic hypergraph neural networks},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117224},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117224},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019507},
author = {Meixia He and Keke Tang and Junhong He and Jun Hu and Peican Zhu},
keywords = {Dynamic hypergraph neural networks, Feature-driven hypergraph reconstruction, Feature attack, Manifold distortion},
abstract = {Dynamic Hypergraph Neural Networks (DHGNNs) improve higher-order representation learning by reconstructing hyperedges from updated node representations across network layers. However, because DHGNNs rely on node features to drive hypergraph reconstruction and employ hierarchical propagation for feature smoothing, conventional Euclidean feature perturbations can be attenuated when they remain within structure-stable regions during repeated reconstruction and aggregation. In this paper, we propose Hyper-AFD, an Anchor-Guided Feature Manifold Distortion attack for Dynamic Hypergraph Neural Networks. Specifically, we design an anchor selector for decision boundary perception, which jointly characterizes hyperedge hubness and classification-boundary sensitivity to locate key nodes with critical influence on subsequent hyperedge reconstruction. Subsequently, we develop a scenario-adaptive feature manifold distortion mechanism that uses non-Euclidean geometry to generate curvature-aware feature deviations and adapts the optimization objective to different attack scenarios. In the evasion setting, Hyper-AFD disrupts the prediction consistency of a fixed victim DHGNN. In the poisoning setting, it incorporates persistent relation-aware constraints to preserve misleading effects after model retraining. Extensive experiments on multiple benchmark datasets and representative DHGNNs demonstrate that Hyper-AFD degrades predictive performance while maintaining attack stealthiness.}
}
@article{BAKMEEDENIYA2026117256,
title = {From unimodal to multimodal deep physiological signal analysis in healthcare: A survey of models, fusion and explainability},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117256},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117256},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019829},
author = {Thilini Bakmeedeniya and Selvarajah Thuseethan and Roshan G. Ragel and Palanisamy Vigneshwaran and Sathiyamohan Nishankar},
keywords = {Multimodal, Physiological signal, Fusion, Explainable artificial intelligence, Quantum machine learning},
abstract = {Physiological signal analysis supports objective assessment of emotion, stress, pain, and disease progression in healthcare systems. Early research focused mainly on unimodal signals, which perform well in controlled settings but are often affected by noise, limited contextual information and reduced generalisability. Recent advances have shifted towards multimodal deep learning frameworks that jointly exploit complementary physiological signals to improve performance and clinical relevance. This survey provides a comprehensive review of the transition from unimodal to multimodal deep physiological signal analysis in healthcare and systematically examines commonly used physiological modalities, benchmark datasets and evaluation metrics. The survey further analyses multimodal alignment strategies and fusion techniques, covering early, intermediate, and late fusion paradigms, with an application-oriented discussion spanning emotion recognition, stress detection, pain assessment and other related domains. Particular emphasis is placed on explainable artificial intelligence methods for multimodal physiological models, highlighting modality-level attribution, cross-modal interactions and application-specific interpretability. Finally, it discusses key dataset- and method-related limitations, such as data scarcity, class imbalance, fusion complexity and computational constraints and outlines future research directions related to wearable edge intelligence, privacy-aware learning, enhanced data diversity and quantum-inspired approaches. This survey can be used as a structured reference for researchers and practitioners developing trustworthy multimodal deep learning solutions for next-generation healthcare systems.}
}
@article{THAI2026117260,
title = {STFD-ETA: Spatio-Temporal Frequency Disentanglement for Estimated Time of Arrival},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117260},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117260},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019866},
author = {Do Thanh Thai and Quang {Tran Minh}},
keywords = {Estimated Time of Arrival, Frequency Disentanglement, Spatio-temporal modeling, Intelligent Transportation Systems, Trajectory prediction},
abstract = {Predicting the Estimated Time of Arrival (ETA) is a foundational task in Intelligent Transportation Systems (ITS). Existing trajectory models operate predominantly in the spatial–temporal domain, leaving them vulnerable to high-frequency traffic disturbances that cause spatial over-smoothing, gradient instability, and long-tail prediction errors. We propose STFD-ETA (Spatio-Temporal Frequency Disentanglement for Estimated Time of Arrival), a novel framework that shifts ETA modeling to a frequency-aware paradigm, disentangling mixed traffic signals into low-frequency global mobility patterns and high-frequency stochastic variations. A Frequency-Spatial-Temporal (Freq-ST) Encoder decouples low-frequency travel trends from high-frequency noise, a Spectral Energy-Guided Attention Pooling (SEGAP) mechanism adaptively aggregates representations by spectral signature, and a Residual Spectral Gating (RSG) mechanism bounds spectral modulations to preserve sequential integrity. Extensive experiments on the structured grid of Porto and the heterogeneous mixed-traffic network of Ho Chi Minh City (HCMC) demonstrate its effectiveness. STFD-ETA establishes a new state-of-the-art, reducing the Mean Absolute Error (MAE) to 27.61 s on HCMC (a 7.6× improvement over the best baseline) and to 86.97 s on Porto (a 20.1% improvement), while attaining a Root Mean Square Error (RMSE) of 39.52 s, a Mean Absolute Percentage Error (MAPE) of 2.24%, and a Pearson correlation of 0.9980 on HCMC. It also outperforms time-series foundation models (Chronos, MOIRAI, TimesFM) and frequency-domain models (FreTS) despite containing up to two orders of magnitude fewer parameters. Moreover, it overcomes the long-sequence bottleneck, maintaining bounded error growth even for ultra-long trajectories spanning up to 300 segments, while keeping a lightweight footprint for real-time commercial deployment.}
}
@article{HU2026117155,
title = {GCAL: Group-centered collaborative advantage learning for policy optimization in multi-agent systems},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117155},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117155},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018812},
author = {Yiwu Hu and Si Shi and Zhen Tian and RuiDong Yuan},
keywords = {Multi-agent systems, Large language models, Multi-agent reinforcement learning, Collaborative policy optimization, Collaborative advantage learning},
abstract = {Large language model (LLM)-driven multi-agent systems are increasingly being used for complex reasoning and decision-making tasks, yet stable collaboration among agents remains difficult to achieve. To support stable collaborative policy optimization, we propose GCAL, a group-centered collaborative advantage learning framework. In a structured target-helper setting, GCAL formulates credit assignment at the level of directional helper feedback. Through a three-round collaborative interaction process, GCAL evaluates the downstream utility of different helper messages based on the corresponding refined responses generated by the target agent, thereby deriving comparable feedback-utility signals. Building on this, GCAL further constructs a group-centered collaborative advantage function, which compares the relative utility of different auxiliary feedback messages under the same target context and provides more discriminative and stable training signals for collaborative policy optimization. Experimental results show that agents trained with GCAL achieve overall improvements over competitive baselines and exhibit robust performance across multiple collaborative reasoning settings.}
}
@article{LI2026117222,
title = {AlignVSS: Alignment-enhanced feature propagation and distillation for efficient Video Semantic Segmentation},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117222},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117222},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019489},
author = {Teng Li and Shumin An and Qingmin Liao and Fengyu Chen and Yingda Shang},
keywords = {Video semantic segmentation, Deformable convolution, Local attention, Knowledge distillation},
abstract = {Video semantic segmentation is essential for scene understanding and temporal dynamics modeling in video analysis. However, processing dense video streams often incurs substantial inter-frame redundancy, leading to high computational costs. To address this issue, we propose an Alignment-enhanced efficient Video Semantic Segmentation (AlignVSS) framework that reduces redundant computation significantly while preserving segmentation accuracy. Specifically, a global-to-local feature propagation module is designed to flexibly transfer temporally relevant information from key frames to non-key frames by jointly leveraging global deformable convolutions and local attention mechanisms, enabling accurate spatial alignment and efficient reuse of high-level features across frames. Moreover, a dual-granularity aligned feature distillation module is introduced to enhance non-key-frame predictions by distilling semantically aligned high-level representations from an off-the-shelf teacher model without introducing additional inference overhead. Extensive experiments on two public benchmarks demonstrate that AlignVSS nearly halves inference time while achieving competitive segmentation accuracy, outperforming existing efficient video semantic segmentation approaches in terms of the overall accuracy–efficiency trade-off.}
}
@article{MOHAMMED2026117258,
title = {MCA-DiTGBNet: attention-enabled distributed transformer-based LightGBM for anomaly detection in IoT network},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117258},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117258},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019842},
author = {Zeeshan Ahmed Mohammed and Mujahedullah H. Syed and Abdul Junaid Mohammed and Abdul Aziz Syed},
keywords = {Anomaly detection, Internet of things, Network security, Deep learning, Attention mechanism},
abstract = {In Internet of Things (IoT) environments, anomaly detection is important to ensure reliability, security, and high operational efficiency as these networks produce huge, heterogeneous, and persistent data streams. Nevertheless, the current methods faced difficulty while handling heterogeneous and multimodal data, sensitivity to missing or noisy data, poor scalability in large networks, and failure to model intricate relationships. To address these concerns, the Multimodal Cross Attention enabled Distributed Transformer-based Light Gradient Boosting Network (MCA-DiTGBNet) is proposed in this research. The proposed architecture leverages the distributed vision transformer to extract the inherent spatial dependencies from the complex data, and the MCA mechanisms effectively combine diverse data and highlight relevant features, thereby improving the predictive performance. Additionally, the LightGBM-based classification serves as a powerful and efficient model for distinguishing between diverse types of anomalies through improved decisions. Together, these components contribute to a robust and intelligent system capable of accurately detecting and classifying anomalies in dynamic and large-scale IoT environments. For experimentation, 90% of the data is utilized for training and 10% for testing. The proposed MCA-DiTGBNet showcased an exceptional performance against other methods by achieving a 97.71% accuracy rate, 98.69% specificity, and 97.22% sensitivity for the 90% training rate while tested on the UNSW-NB-15 dataset, demonstrating its effectiveness in anomaly detection.}
}
@article{AZANCORTNETO2026117230,
title = {Effective training pressure gates recursive knowledge degradation in LLMs: A multi-axis dose–response study},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117230},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117230},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019568},
author = {Julio Leite {Azancort Neto} and Carlos André {de Mattos Teixeira} and André Carlos {Ponce de Leon Ferreira de Carvalho} and Carlos Renato {Lisboa Francês}},
keywords = {Large language models, Recursive fine-tuning, Model collapse, Knowledge retention, LoRA, Dose–response, Synthetic data feedback loop},
abstract = {Recursive fine-tuning on synthetic data progressively degrades factual knowledge in large language models under common parameter-efficient settings. The conditions governing whether degradation emerges, remains bounded, or can be reversed are not well understood. Through dose–response experiments across three architectures (Qwen 2.5 1.5B, Gemma 3 1B, and Gemma 4 E2B IT), up to ten recursive generations, and three to six seeds per headline condition (Gemma 4 single-seed and therefore exploratory), we map adapter rank, learning rate, and synthetic exposure onto a regime structure with three zones: homeostatic, bounded, and degradative. Increasing rank produces a threshold-like transition within the tested grid; the boundary falls between effective ranks 50 and 88 for Qwen and between 3 and 6 for Gemma 3, a tenfold difference between architectures, and not the same transition type. Learning-rate sweeps under full fine-tuning provide exploratory evidence broadly consistent with the same qualitative pattern, consistent with perturbation magnitude as the operative variable rather than low-rank adaptation specifically. At intermediate capacity (r=128, Qwen), factual retention remains near 90% while output-distribution quality collapses threefold, revealing a dissociation invisible to scalar retention metrics. Pre-registered dose–response experiments show that reducing synthetic exposure by 50% shifts the Qwen system toward the bounded regime (＋9.2pp at Gen 10, 95% CI [6.9,11.6], p<0.001) and improves endpoint retention on Gemma 3 (＋12.9pp, p=0.003) without reducing the rate of loss. The effective-training-pressure index is an exploratory post-training summary, not validated as a prospective predictor across architectures or datasets. Experiments use 1–2 billion parameter models; generalization to larger scales is not established.}
}
@article{STRUSKI2026117169,
title = {InfoDisent: Explainability of image classification models by information disentanglement},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117169},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117169},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018952},
author = {Łukasz Struski and Dawid Rymarczyk and Jacek Tabor},
keywords = {Prototypical parts, Interpretability, Explainable AI, Deep learning},
abstract = {In this work, we introduce InfoDisent, a hybrid approach that attaches a lightweight, interpretable head to any frozen pretrained backbone. Unlike fully post-hoc explainers, InfoDisent requires a single training pass of this head over the dataset. Therefore it occupies a middle ground between post-hoc and ante-hoc methods, as it merges the flexibility of post-hoc methods with the concept-level modeling capabilities of self-explainable neural networks, such as ProtoPNets. We demonstrate the effectiveness of InfoDisent through computational experiments and user studies across various datasets using modern backbones such as ViTs and convolutional networks. While InfoDisent achieves competitive performance within the class of interpretable models, we observe an accuracy-interpretability trade-off when compared to black-box counterparts, especially visible in CNNs. Notably, InfoDisent generalizes the prototypical parts approach to novel domains (ImageNet).}
}
@article{SHYAM2026117184,
title = {DReX: An explainable deep learning-based multimodal recommendation framework},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117184},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117184},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019106},
author = {Adamya Shyam and Venkateswara Rao Kagita and Bharti Rana and Vikas Kumar},
keywords = {Multimodal, Explainability, Recommender system, Interaction-level features, Global features},
abstract = {Multimodal recommender systems leverage diverse data sources, such as user interactions, content features, and contextual information, to address challenges like cold-start and data sparsity. However, existing methods often suffer from one or more key limitations, such as the isolated processing of different modalities, the requirement of complete multimodal data for each interaction during training, and the independent learning of user and item representations. These limitations can increase model complexity and hinder the learning of consistent user and item representations. To address these challenges, we propose DReX, a unified multimodal recommendation framework that maintains evolving global representations for both users and items. For each interaction, modality-specific features are combined into an interaction-level representation, which is selectively integrated to incrementally evolve the global user and item representations. This incremental update mechanism provides three key advantages: (1) simultaneous modeling of both nuanced interaction details and broader preference patterns, (2) eliminates the need for separate user and item feature extraction processes, leading to enhanced alignment in their learned representation, and (3) inherent robustness to varying or missing modalities. We evaluate the performance of the proposed approach on three real-world datasets containing reviews, ratings, and images as interaction modalities. By considering review text as a modality, our approach automatically generates interpretable keyword profiles for both users and items, which supplement the recommendation process with interpretable preference indicators. Experimental results demonstrate that our approach outperforms state-of-the-art methods across all evaluated datasets.}
}
@article{JING2026117206,
title = {WAMEFusion: A Weather-aware Multi-modal Expert Fusion for robust 3D scene understanding},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117206},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117206},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019325},
author = {Ying Jing and Mo Zhou and Xinyu Zhang and Fang Lu and Huikai Liu and Wen Ji and Jun Li},
keywords = {3D scene understanding, Multi-modal fusion, Multi-modal large language models, Mixture-of-experts, Autonomous driving},
abstract = {Achieving 3D scene understanding under various (normal and adverse) weather conditions is critical for safe autonomous driving. Recent methods mainly rely on multi-modal large language models (MLLMs) with images or LiDAR, but overlook the changes in sensor reliability under adverse weather. Incorporating more weather-resilient 4D radar offers a promising solution. In this paper, we propose a Weather-Aware Multi-modal Expert Fusion framework, dubbed WAMEFusion, which achieves weather robustness through a mixture-of-experts mechanism. Specifically, WAMEFusion includes two key components: Multi-expert Fusion (MEF) and Weather-guided Feature-flow Router (WFR). MEF employs four parallel expert fusion models, each specializing in feature interactions for camera–LiDAR, LiDAR–4D radar, camera–4D radar, and full-modality combinations, respectively. Meanwhile, WFR dynamically activates the most appropriate expert for each sample based on weather priors. We also introduce the WAMEFusion dataset for multi-modal 3D scene understanding under diverse environmental conditions, which contains 271 K question–answer pairs across 8435 frames. Extensive experiments demonstrate that WAMEFusion achieves the best overall performance among the compared MLLM-based methods and remains competitive across adverse weather conditions.}
}
@article{ZHENG2026117228,
title = {Robust stability analysis and finite-time stabilization for discrete-time fuzzy stochastic neural networks with network induced delay under stochastic state-based controller design},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117228},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117228},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019544},
author = {Wei Zheng and Zhiming Zhang and Hak-Keung Lam and Fuchun Sun},
keywords = {Stability analysis, Lyapunov functional, Delayed neural networks, Fuzzy model, Linear matrix inequality (LMI)},
abstract = {This paper addresses the stochastic Takagi-Sugeno (T-S) fuzzy uncertainty-dependent state feedback control and strictly (Q,S,R)−γ dissipative performance analysis for a class of stochastic T-S fuzzy memristive neural networks with Lesbegue additive uncertainties, network induced delay and unmatched network noise. Firstly, the T-S fuzzy model and stochastic Bernoulli theory are employed to approximate the neural networks plant. Secondly, the stochastic T-S fuzzy uncertainty-dependent state feedback controller with time-varying delay is designed via uncertainty-dependent parameters. Thirdly, the Bernoulli probability distribution is employed to describe random occurrence characteristic of multipath packet dropouts. Compared with previous works, three classes of membership-function-dependent and delay-dependent stability conditions in terms of linear matrix inequality (LMI) are derived. The multiple delay-dependent Lyapunov-Krasovskii functional and augmented state vectors are designed, the closed-loop system is finite time bounded stable subject to (c1,c2,R,N,ω⌢) and the system sensitivity is enhanced. The membership-function-dependent matrices and strictly dissipative performance functional are introduced, and the strictly (Q,S,R)−γ dissipative performance is guaranteed. The spectral norm scaling technique and Schur complement are employed, the proof process is simplified and computation complexity of solving LMI is reduced. Finally, the simulation examples are presented to show the effectiveness and advantage of proposed method.}
}
@article{PAPARELLA2026117151,
title = {Tuning conventional recommender systems for beyond-accuracy objectives},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117151},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117151},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018770},
author = {Vincenzo Paparella and Claudio Pomo and Vito Walter Anelli and Antonio Ferrara and Ludovico Boratto and Tommaso {Di Noia}},
keywords = {Recommender systems, Hyperparameters tuning, Beyond accuracy, Multi-objective evaluation},
abstract = {Recommender systems (RSs) are at the heart of digital platforms, delivering personalized content and boosting user engagement. Historically, the design of RSs has predominantly focused on maximizing accuracy, often at the expense of equally critical objectives such as long-tail exposure, diversity, novelty, and popularity-bias mitigation. These beyond-accuracy goals support multi-stakeholder interests and ensure ethical, inclusive recommendation outcomes. Although Multi-Objective Recommender Systems (MORSs) offer a conceptual framework for addressing these competing goals, they usually demand major architectural changes, complicating practical deployment. This work investigates whether hyperparameter tuning of traditional accuracy-driven RSs can serve as a pragmatic, model-preserving lever for improving multi-objective behavior without requiring immediate architectural redesign. Accordingly, we propose an evaluation framework leveraging Pareto optimality to assess the sensitivity of traditional RS models to hyperparameter tuning in multi-objective scenarios. We test our framework through comprehensive experiments on six diverse RS models, spanning neighborhood-based, factorization-based, and graph-based methods. Specifically, we evaluate 32 hyperparameter settings for each model in two representative scenarios: (i) mitigating popularity bias in content exposure and (ii) jointly optimizing accuracy, novelty, and diversity in content delivery. We also analyze which hyperparameters matter most, offering actionable insights to practitioners aiming to balance objectives with limited implementation overhead. Overall, our findings indicate that hyperparameter optimization can provide a practical complementary pathway for improving multi-objective behavior in conventional RS models under the considered settings. Our results identify UserKNN as the most robust model, consistently requiring minimal tuning to achieve Pareto optimality. Conversely, factorization and graph-based models (e.g., LightGCN) show higher sensitivity, where increasing the embedding dimension (factors) emerges as the most critical lever for improving multi-objective trade-offs. We make the codes publicly available at: https://github.com/vincpapa/HP4MORec.}
}
@article{TAHER2026117218,
title = {Owl Flight Optimizer (OFO): A multi-operator adaptive metaheuristic with success-history learning for global optimization},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117218},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117218},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019441},
author = {Hindreen A. Taher},
keywords = {Metaheuristic optimization, Adaptive operator selection, Success-history learning, CEC2017, High-dimensional optimization},
abstract = {This study presents the Owl Flight Optimizer (OFO), a population-based multi-operator framework whose formulation uses explicit credit assignment and probability matching to coordinate glide exploration, strike refinement, and hybrid differential learning under strict function-evaluation (FE) accounting. Success-history memories, elite local search, and diversity-triggered partial restart are integrated with deterministic seeds and counted auxiliary evaluations. The revision evaluates OFO on 17 canonical functions, 29 CEC2017 functions at D=30, and 11 scalable functions at D=100, 250, 500, and 1000. Under 30,000 FEs on the canonical suite, OFO ranked fifth of 11 methods (mean rank 5.65); on CEC2017 with 45,000 FEs, it ranked sixth (5.66). Its relative position improved with dimensionality, reaching the third-best mean rank at D=500 and D=1000. Multi-landscape sensitivity and ten-variant ablation studies showed that hybrid differential learning, success history, and restart can be important, while the strike mechanism was not uniformly beneficial. Runtime and memory measurements further quantify computational cost. The original gold-price forecasting case study is retained as an illustrative application and is interpreted cautiously. Overall, OFO is competitive rather than universally dominant, with its strongest evidence arising in higher-dimensional search and reproducible adaptive coordination.}
}
@article{GUO2026117226,
title = {Two-stage reconstruction of hypergraphs with unknown orders from binary dynamical data},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117226},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117226},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019520},
author = {Yifei Guo and Lilan Tu and Ye Pan and Qiuyue Zhao},
keywords = {Hypergraph reconstruction, Binary dynamical data, Unknown orders, The law of large numbers, Compressed sensing},
abstract = {To reconstruct hypergraphs with unknown orders and without structural assumptions, this paper proposes two distinct two-stage reconstruction methods based on the law of large numbers and compressed sensing: a direct method and an optimized method. In the first stage of these two methods, the law of large numbers is leveraged to infer the node activation probabilities from binary dynamical data. The unweighted hypergraph is then projected onto an ordinary weighted network to establish weighted network reconstruction equations, from which the hypergraph order and node neighbors are estimated by compressed sensing. In the second stage, the direct method explicitly utilizes the estimated order to construct hypergraph reconstruction equations, thereby identifying the topology of the hypergraph. In contrast, the second stage of the optimized method employs the node neighbors estimated in the first stage to update the activation probabilities of nodes and lower the complexity of the hypergraph reconstruction equations before reconstructing the hypergraph. Reconstruction experiments on three types of third-order synthetic hypergraphs demonstrate that the proposed optimized method not only achieves higher reconstruction accuracy and lower computational complexity compared to the baseline and direct methods, but also exhibits a certain degree of robustness against the transmission rate of binary dynamics, random perturbations in observational data and the misestimation of the hypergraph order. Furthermore, reconstruction experiments on second-order synthetic and empirical hypergraphs indicate that the optimized method remains insensitive to the hyperparameters of the thresholds.}
}
@article{TOUZA2026117174,
title = {Correcting redundant evidence in Naïve Bayes: Dependence-adaptive likelihood weighting with finite-sample analysis},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117174},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117174},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019003},
author = {Isaac Touza and Didier Alain Njomen Njamen and Guidedi Kaladzavi},
keywords = {Redundant evidence, Naive Bayes, Conditional dependence, Effective dimension, Probability calibration, Finite-sample guarantees, Concept drift},
abstract = {Naive Bayes multiplies the evidence of every feature as if it were independent, causing dependent features to be counted multiple times. This can produce overconfident posteriors and distorted decisions when redundant features out-vote less numerous but more reliable evidence. We propose Adaptive Bayesian Dependence Naive Bayes (ABD-NB), which retains the naive factorisation while raising each feature likelihood to a positive exponent estimated from class-conditional dependence. The weighting rule is derived by requiring that r exact copies contribute one feature’s worth of evidence, yielding the de-duplicated Bayes posterior. Evidence scale and correction strength are selected by internal validation over a grid including γ=0, so standard Naive Bayes remains available. An ablation confirms the importance of this selection: fixed spectral rescaling is accuracy-neutral but increases log-loss by 8.5%. Beyond asymptotic results, we derive a finite-sample deviation bound for the weights and a non-asymptotic regret bound for the selection layer. Across 48 settings involving 37 real datasets from 16 domains and 22 classifiers, including TAN, KDB, AODE, HNB, CFW, WANBIA, and gradient boosting, ABD-NB reduces Naive Bayes log-loss in 39 settings, by up to 85%, improves accuracy by up to 14.0 points under strong redundancy, and loses at most 1.31 points. A data-side redundancy index predicts the benefit before fitting, with correlations of ρ=0.53–0.68 across all seven dependence measures (p<0.01). ABD-NB targets a specific misspecification, retains Naive Bayes’ asymptotic prediction complexity, and is not intended to replace state-of-the-art classifiers or recalibration.}
}
@article{WANG2026117220,
title = {EnlightenINN: An invertible neural network for high-fidelity low-light image enhancement},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117220},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117220},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019465},
author = {Linbo Wang and Guohao Zhang and Zhuo Yan and Zhengyi Liu and Xianyong Fang and Shaohua Wan},
keywords = {Low-light image enhancement, Invertible neural network, Retinex-based image enhancement},
abstract = {Low-light image enhancement (LLIE) aims to enhance the visibility and quality of images captured in low-light conditions, a longstanding challenge in computer vision. Most Retinex-based methods decompose low-light images into reflectance and illumination components using forward networks and enhance them to generate normal-light images. However, they often neglect the interdependence between the two components and the potential of the darkening process, the inverse of brightening, which could provide valuable constraints for LLIE modeling. To address this, we propose EnlightenINN, a Retinex-based LLIE framework that unifies brightening and darkening within an invertible neural network (INN). By leveraging the mutual dependency between illumination and reflectance, EnlightenINN synchronously optimizes both components through bijective mapping constraints, elevating LLIE performance. Furthermore, we introduce illumination-invariant color and edge maps derived from low-light images as conditional priors, which are injected into the INN to guide training, mitigating color bias and structural distortions in the enhanced output. Extensive experiments on benchmark datasets LOL, LSRW-Huawei, and LOL-v2-real demonstrate EnlightenINN outperforms state-of-the-art methods in both qualitative and quantitative evaluations.}
}
@article{NOORI2026117240,
title = {MSMCFA-Net: A multi-scale multi-channel feature attention network for enhanced wind speed forecasting in renewable energy systems},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117240},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117240},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019660},
author = {Hossein Noori and Gholamreza Memarzadeh and Mohammad Hossein Gholizadeh and Elaheh Amirteimoury},
keywords = {Wind speed forecasting, Renewable energy, Deep learning, Feature attention, Multi-level channel attention},
abstract = {In recent years, the use of renewable energy sources has increased significantly. Wind energy, in particular, is abundant, cost-effective to develop, highly efficient in terms of energy conversion, and environmentally friendly. Wind speed is a critical factor in the planning, operation, and maintenance of wind power generation systems. In this paper, we propose a novel network architecture called Multi-Scale Multi-Channel Feature Attention (MSMCFA) for wind speed forecasting. The proposed network integrates features at various levels and scales to enhance the accuracy of wind speed predictions. Specifically, two new modules are introduced: multi-level channel attention and low-level feature attention, which combine both low- and high-level features while placing greater emphasis on low-level features. To evaluate the proposed method, wind speed data from two sources were utilized: the Kerman site and the AGSea dataset for the Favignana Island micro-grid in Italy. The results of multi-step-ahead wind speed forecasting (WSF) demonstrate the high accuracy achieved by the hybrid model. For instance, in the case of the Kerman site, the average Mean Absolute Percentage Error (MAPE) for 2009 ranged from 3.9853% to 5.5059%.}
}
@article{ZHANG2026117232,
title = {Rethinking federated semi-supervised learning: When Not All Clients Have Labels},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117232},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117232},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019581},
author = {Wenyi Zhang and Xueming Jiang and Xiangjie Kong and Siyue Shuai and Youyang Qu and Guojiang Shen},
keywords = {Federated learning, Federated semi-supervised learning, Distributed learning, Knowledge distillation},
abstract = {In the transitioning era from big data to large models, federated semi-supervised learning (FSSL) emerges as a crucial paradigm for harnessing the power of distributed data while minimizing the need for extensive labeled datasets. Although FSSL is a promising paradigm for collaborative model training, it faces challenges owing to inconsistent training objectives between labeled and unlabeled clients and class imbalance in non-IID data. Moreover, most existing FSSL methods directly aggregate models optimized under inconsistent supervision signals, leading to gradient conflicts, while unsupervised updates on unlabeled clients can induce label knowledge forgetting. These issues jointly result in sub-optimal global performance. To address the above-identified challenges, we propose FedCU, a novel FSSL framework designed to enable more effective interactions between labeled and unlabeled clients. Specifically, FedCU comprises Cross Exchange Aggregation (CEA) and Uncertainty Mask Distillation (UMD) modules. To alleviate gradient conflicts, the server-side CEA performs weighted aggregation of supervised and unsupervised models separately, rather than directly aggregating all local models. The aggregated models are then alternately distributed to the opposite client groups. For unlabeled clients, UMD masks classes that are high in confidence yet uncertain, guiding the model to retain knowledge of low-confidence classes from both the global and local models. Comprehensive experiments on six benchmark datasets under diverse settings demonstrate the effectiveness of FedCU. Specifically, FedCU achieves absolute accuracy improvements of 4.81% and 5.24% on CIFAR-10 and CIFAR-100, respectively, over state-of-the-art methods.}
}
@article{ZHANG2026117056,
title = {A stratified dominance-based framework for knowledge-based decision-making under interdependent uncertainty},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117056},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117056},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601782X},
author = {Xu Zhang and Yangyi Lai and Jiancheng Shao and Qun Wang and Dragan Pamucar},
keywords = {Digital synergy, Supplier selection, Concept of stratification, Dominance degree},
abstract = {Strong digital synergy between buyers and suppliers enhances supply chain resilience, making digital synergy-oriented supplier selection critically important. However, a knowledge-based systematic criteria system for digital synergy-oriented supplier selection remains absent. In dynamic Artificial Intelligence (AI)-driven environments, interdependent uncertain events cause significant fluctuations in supplier rankings. Traditional dominance degree-based ranking methods suffer from insufficient discrimination power, and this shortcoming is further compounded, leading to biased and unreliable selection results. To address these gaps, this study proposes a knowledge-based stratified decision-making framework, namely SMOWA–MRMDD–CIS. The framework combines criteria construction, interdependent uncertainty analysis, and stability-enhanced supplier ranking into a coherent decision process. First, a digital synergy-oriented criteria system is developed by systematically acquiring and integrating knowledge from the literature and domain experts, and its content validity is evaluated and validated. Second, the Stratified Maximin Operator Weights Approach (SMOWA) is developed to calculate the occurrence probabilities of different scenarios without requiring independence among uncertain events. Third, to strengthen discrimination capability, the improved Multicriteria Ranking Method based on Dominance Degree (MRMDD) is further integrated with Cluster and Individual Stability (CIS). Finally, the effectiveness of the proposed framework is validated through an illustrative case study. Sensitivity and comparative analyses demonstrate the robustness and discrimination power of the framework, while considering uncertain events improves the reliability of supplier selection. The proposed framework also supports decision-makers in strengthening digital synergy between buyers and suppliers and enhancing supply chain resilience.}
}
@article{LIU2026117164,
title = {DM3D: Dynamic Mamba via Offset-Guided Feature Resampling for point cloud understanding},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117164},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117164},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018903},
author = {Bin Liu and Chunyang Wang and Xuelian Liu and Xuemei Li and Ge Zhang},
keywords = {3D vision, Point cloud, State Space Model, Dynamic},
abstract = {State Space Models (SSMs) model long point cloud token sequences with linear complexity, but unordered point clouds must first be serialized. Existing methods mainly address this requirement by designing or learning a better token order. Even a well-constructed order, however, cannot preserve every local relation on an irregular 3D surface: a fixed sequence may still mix points that are close in index but distant in 3D or belong to different object parts. We propose DM3D, a dynamic Mamba architecture that preserves the base token order while dynamically resampling features and modulating state propagation. First, for feature resampling, DM3D learns spatial and sequence offsets without constructing a global permutation. Specifically, spatial offsets adjust the sampling anchors in 3D space. Sequence offsets guide feature resampling within a local sequence window, allowing different slots to share overlapping local supports while preserving their index identities. This design preserves the global prior of the original traversal, allowing each token to aggregate a more suitable local context. Second, DM3D modulates the state update according to the 3D distance between points at adjacent sequence positions. This modulation reduces information propagation when the two points are spatially far apart. DM3D reaches 95.2% accuracy on ModelNet40, 93.3% accuracy on the PB_T50_RS split of ScanObjectNN, and 84.8% class mIoU on ShapeNetPart. Extensive experiments on benchmark datasets show that DM3D achieves strong and competitive performance, validating the effectiveness of local feature adaptation for point cloud understanding. The code is released on GitHub https://github.com/L1277471578/DM3D.}
}
@article{SAARELA2026117225,
title = {Optimization-aware trustworthy AI: A gradient-based multi-objective learning framework},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117225},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117225},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019519},
author = {Mirka Saarela and Prabha Kumarage},
keywords = {Trustworthy artificial intelligence, Fairness-aware machine learning, Explainable artificial intelligence, Multi-objective optimization, Neural networks},
abstract = {Trustworthy artificial intelligence (AI) requires learning systems that achieve strong predictive performance while simultaneously satisfying additional objectives such as fairness and explainability. Existing approaches typically evaluate these characteristics after model training or optimize them individually, providing limited support for balancing multiple competing objectives during learning. This paper presents a gradient-based multi-objective learning framework that jointly optimizes predictive performance, fairness, and explainability within a unified optimization process. The proposed framework formulates trustworthy AI as a multi-objective optimization problem in which predictive performance is measured by classification accuracy, fairness is represented through statistical parity difference, and explainability is approximated using model sparsity. Different trade-offs among these objectives are explored through scalarization, producing candidate models corresponding to different optimization preferences. Experiments were conducted on four benchmark datasets covering diverse application domains. The resulting optimization landscapes demonstrate that the three objectives respond differently to changes in the scalarization weights, revealing non-trivial trade-offs rather than a single common empirical optimum. Across the benchmark datasets, representative empirically non-dominated models substantially increased sparsity while maintaining competitive predictive performance, with fairness outcomes varying across datasets. These findings demonstrate that trustworthy AI properties can be incorporated directly into model optimization rather than treated solely as post-hoc evaluation criteria. The proposed framework provides a flexible foundation for optimization-aware trustworthy AI and can accommodate additional trustworthiness objectives that are amenable to gradient-based optimization.}
}
@article{LI2026117234,
title = {RALLM-STAR: Spatial–Temporal Aligned Retrieval-Augmented LLM for zero-shot next POI recommendation},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117234},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117234},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601960X},
author = {Kunrong Li and Kwan Hui Lim},
keywords = {Large language models, Next POI recommendation, Retrieval augmented generation, Gaussian mixture modeling},
abstract = {Next Point-of-Interest (POI) recommendation aims to predict a user’s future destination by uncovering latent mobility patterns from historical trajectories. While traditional deep learning models suffer from high training costs and poor generalization, Large Language Models (LLMs) offer a promising zero-shot alternative, yet often struggle with hallucinations and a lack of spatial grounding. To bridge this gap, we propose RALLM-STAR, a retrieval-augmented LLM framework designed to inject rigorous spatial–temporal context into the reasoning process. First, we introduce the Spatial–Temporal Alignment Retriever (STAR), which captures the duality of user intent by modeling both short-term interests and long-term habits, integrated with a Gaussian Mixture Model to ensure distributional spatial consistency. Second, to enforce fine-grained sequential realism, we employ a Geographical Distance Reranker (GDR) that prioritizes candidates exhibiting high path-level alignment with the recent movements of the user. Finally, we incorporate an Agentic LLM Rectifier (ALR), a self-reflective module that iteratively verifies and corrects generation errors to ensure robust outputs. Extensive experiments on three real-world Foursquare datasets, plus large-scale evaluation on Gowalla, demonstrate that RALLM-STAR achieves substantial accuracy gains, outperforming existing zero-shot LLM-based approaches and remaining competitive with recent supervised graph/hypergraph recommenders without additional training. The code is released at https://github.com/LKRcrocodile/RALLM-STAR.}
}
@article{LIU2026117215,
title = {CFM: An efficient framework for footprint matching in crime scenes},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117215},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117215},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019416},
author = {Liman Liu and Han Wu and Xinyu Cheng and En Yu and Tiancheng Zhang and Sijia Chen and Wenbing Tao},
keywords = {Crime-scene footprint matching, Multi-branch network, Footprint matching dataset},
abstract = {Footprint matching is an essential step in criminal investigations. Typically, police officers first collect the questioned footprints left at a crime scene and subsequently require all suspects to wear the same type of shoes to obtain their footprints. Investigators then compare the crime-scene footprints with those of the suspects to identify potential matches. However, accurate matching is highly challenging due to two primary reasons. First, crime-scene footprints are heavily blurred and exhibit significant appearance diversity across different environments. Second, because all suspects wear the same type of shoes, the resulting footprint textures are nearly identical, forcing the matching process to rely on indistinctive features, such as footprint evenness. In this work, we propose a framework, named Crime-scene Footprint Matching (CFM), for ranking candidate footprint matches to support expert examination. Specifically, we devise a set of image processing operations to bridge the significant appearance gap among various footprint images. Furthermore, a multi-branch network is proposed to match the suspects’ footprints with those recovered from the crime scene. Motivated by the lack of a dedicated benchmark for footprint matching in crime-scene scenarios, we construct the Crime-scene FootPrint (CFP) dataset and establish the corresponding training and testing protocols. Extensive experiments demonstrate the retrieval performance of our method on the CFP dataset.}
}
@article{SU2026117269,
title = {Fusion-domain blind watermarking for color images with multi-channel 3D-QIM embedding strategy},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117269},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117269},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019957},
author = {Qingtang Su and Yunfei Qiu and Shuai Jiao and Xiaodong Chen and Lin Su},
keywords = {3D-QIM, Color image, Digital watermarking, Fusion domain, MCEE},
abstract = {Traditional blind watermarking methods based on one-dimensional QIM generally suffer from limited robustness and high computational complexity. To overcome these limitations, this paper proposes a novel fusion-domain blind watermarking algorithm for color images. A novel Three-Dimensional Quantization Index Modulation (3D-QIM) strategy is first introduced to overcome the decoding instability caused by coefficient linear translation in traditional 1D-QIM-based methods. Second, a Multi-Channel Collaborative Embedding and Extraction (MCEE) mechanism is proposed, where each watermark bit is embedded into the three channels of every image block. During watermark extraction, watermark reconstruction is achieved through joint decision-making based on the three-channel coefficients using 3D-QIM strategy, thereby substantially improving robustness against various attacks. Furthermore, a fusion-domain theory is proposed based on the variation of Schur-domain coefficients and their spatial mapping relationship. By using an approximate Schur decomposition in the spatial domain instead of computationally expensive transform-domain operations, the proposed method combines the high efficiency of spatial-domain watermarking with the robustness of transform-domain watermarking. In addition, the Two-Dimensional Logistic-Adjusted Sine Map (2D-LASM) algorithm is adopted to encrypt the watermark image, further enhancing security. Experimental evaluation confirms that the proposed scheme achieves high invisibility (PSNR>40 dB), strong robustness (average NC>0.97 and average BER<0.03), and high computational efficiency (0.4844 s per image), while providing enhanced security and competitive embedding capacity.}
}
@article{LU2026117237,
title = {Polarimetric underwater imaging via manifold-constrained transmission refinement},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117237},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117237},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019635},
author = {Liuyan Lu and Yuxiang Lu and Chaoyue Hu and Junkai Wu and Xian Li and Haofeng Hu and Xiaobo Li},
keywords = {Underwater imaging, Polarization, Descattering, Manifold, Transmission refinement},
abstract = {Underwater image restoration is often bottlenecked by the accurate and stable estimation of the transmission map. Under strong scattering, spatially varying veiling light, and sensor noise, transmission errors can be severely amplified by physical inversion, leading to pseudo-textures and artifacts. To address this issue, we propose a polarization-guided restoration approach that improves transmission estimation by combining polarimetric dehazing modeling, parameter optimization, and manifold regularization. Specifically, a compact set of physically interpretable parameters is introduced to characterize polarization-based transmission, and particle swarm optimization is adopted to adaptively determine these parameters from observations. Moreover, a graph manifold regularization is designed to suppress non-physical fluctuations in low-texture or polarization-degraded regions while preserving structural boundaries. Extensive experiments in controlled laboratory settings with multiple scenes, turbidity levels, and target materials, together with real sea-trial data, demonstrate that the proposed method yields clearer visibility, stronger contrast, and more faithful details than representative polarization and intensity-only baselines. Collectively, the results confirm the efficacy and robustness of the proposed approach, demonstrating its applicability to real-world polarimetric descattering tasks.}
}
@article{WANG2026117261,
title = {FedCDI: Fine-grained personalization for federated learning via channel differences},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117261},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117261},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019878},
author = {Kuide Wang and Taochun Wang and Fulong Chen and Hao Yang and Yaokun Liu and Dong Xie},
keywords = {Federated learning, Data heterogeneity, Personalized federated learning, Post-aggregation adaptation, Channel-wise reconstruction},
abstract = {Federated learning enables collaborative modeling across clients without sharing raw data. However, under heterogeneous data distributions, a single aggregated global model is often insufficiently adapted to individual clients’ local data distributions. To address this issue, we propose FedCDI, a fine-grained personalization method for federated learning via channel differences. After global aggregation, FedCDI characterizes client-specific discrepancies through deviations between each client’s deep channel statistics and the corresponding global reference statistics, and then performs channel-wise parameter reconstruction accordingly. To account for the feature-distribution changes induced by parameter reconstruction, we further incorporate Batch Normalization (BN) statistics recalibration. Extensive experiments on multiple datasets under different degrees of data heterogeneity show that FedCDI achieves the highest mean client-side accuracy across the evaluated settings. These results demonstrate that FedCDI improves adaptation to clients’ local data distributions through fine-grained post-aggregation personalization.}
}
@article{ZHAO2026117267,
title = {Decoupled dual-prior modulation for universal cross-domain anomaly detection},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117267},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117267},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019933},
author = {Chensu Zhao and Jiashuo Gu and Xuefeng Li and Wenjie Hao and Honglin Xie},
keywords = {Universal anomaly detection, Zero-shot learning, Dual-prior fusion, Stage-wise decoupling},
abstract = {Universal cross-domain anomaly detection is hindered by distribution discrepancies between source and target domains. Existing unified architectures often suffer from task interference when optimizing image-level classification and pixel-level segmentation simultaneously, complicating the balance between abstract global semantics and fine-grained local textures. To address this challenge, a two-stage architecture named the Decoupled Dual-Prior Modulation network is proposed. By decoupling the optimization of classification and segmentation, the proposed approach alleviates the aforementioned interference. In the first stage, the network fuses global and local anomaly cues through a cascaded cross-attention mechanism. These combined priors are transformed into conditional weights to dynamically modulate the dense feature prediction in the second stage via a Prior-Guided Feature Linear Modulation mechanism. Furthermore, to prevent the loss of spatial resolution inherent in dense prediction tasks, a decoupled dual-path visual encoder is introduced to independently extract self-attention-based global features and value-based high-resolution local features within the deep layers of the network. Regarding engineering applications, this architectural innovation mitigates the performance trade-off between image-level classification and pixel-level localization, facilitating practical deployments. Extensive experiments demonstrate that the proposed method generalizes effectively across diverse real-world benchmarks, encompassing both industrial defect inspection and medical lesion identification. The code involved in this study is publicly available on https://anonymous.4open.science/r/202606.}
}
@article{LIU2026117205,
title = {Toward class-imbalanced node classification by Causality-Inspired Invariant Representation Disentanglement},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117205},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117205},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019313},
author = {Xinxin Liu and Jie Cao and Hong Zhao},
keywords = {Graph neural network, Node classification, Class imbalance, Disentangled representation, Invariance learning},
abstract = {Class imbalance poses a significant challenge to graph neural networks in node classification tasks. Conventional methods typically rely on class rebalancing but do not explicitly model the latent factors underlying node representations, which can lead to representations that are sensitive to spurious information and difficult to interpret. To address this issue, we propose Causality-Inspired Invariant Representation Disentanglement (CIRD) for class-imbalanced node classification. CIRD first learns multiple node representations through factor-wise and label-relevant/spurious disentanglement. It then enhances factor diversity to preserve complementary and discriminative information for class prediction. Finally, a perturbation-based invariance objective reduces the influence of environment-dependent spurious information. Extensive experiments show that CIRD captures stable label-relevant factors and achieves competitive or superior performance across a range of class-imbalanced node classification tasks.}
}
@article{CHEN2026117229,
title = {EcSMNet: edge-structured sparse mask modeling for knowledge-efficient hyperspectral reconstruction},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117229},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117229},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019556},
author = {Mengqian Chen and Jie Li and Shibin Ma and Mengxin Gong and Chipeng Cao and Licheng Jiao},
keywords = {Hyperspectral image reconstruction, Structural re-parameterization, Spatial sparsity modeling, Knowledge-aware learning, Efficient deep modeling, Coded aperture snapshot spectral imaging},
abstract = {Hyperspectral image (HSI) reconstruction in compressive spectral imaging (CSI) enables snapshot acquisition of target spectral information, which endows dynamic scene sensing with unique advantages in timeliness and integration. However, the reconstruction algorithm acts as the core bottleneck of CSI systems: existing methods suffer from excessively high computational overhead and low inference speed, failing to achieve true real-time reconstruction despite realizing snapshot sampling. This mismatch severely restricts the application scenarios and deployment scope of snapshot spectral imaging, especially in resource-constrained intelligent edge platforms. Furthermore, most current deep learning-based schemes adopt implicit data-driven feature learning, without explicit integration of domain prior knowledge, leading to redundant computation and limited interpretability. To tackle these challenges, we propose EcSMNet (Edge-Structured Sparse Mask Network), a lightweight knowledge-aware framework tailored for efficient CSI reconstruction. The model embeds structural and sparsity priors into the network design via two core synergistic modules: the Edge-optimized Reparameterizable Convolution (RepEdgeConv) block integrates edge-aware operators to encode high-frequency structural knowledge, and realizes compact inference through structural re-parameterization; the Spatial Sparse Mask Generation (SSMG) module adaptively mines hyperspectral data sparsity to eliminate redundant computation. Compared with state-of-the-art methods, EcSMNet achieves drastic reduction in both computational complexity and model scale while retaining competitive reconstruction accuracy. The lightweight variant EcSMNet-S further enables near real-time inference on edge embedded platforms, breaking the reconstruction bottleneck of traditional CSI systems and advancing snapshot sampling to true real-time spectral detection. This work provides a feasible solution for the practical deployment of efficient and interpretable compressive spectral imaging systems.}
}
@article{LATEEF2026117221,
title = {D2S2-UI: A diffusion-driven synthetic dataset for UAV semantic segmentation and cross-dataset generalization},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117221},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117221},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019477},
author = {Fahad Lateef and Mohamed Kas and Yassine Ruichek},
keywords = {Unmanned Aerial Vehicle, Semantic segmentation, Generative diffusion model, Synthetic-to-real generalization, Remote sensing},
abstract = {High-quality semantic segmentation is essential for UAV-based applications, enabling precise data interpretation, efficient decision-making, and improved operational efficiency across diverse domains. However, the development of robust segmentation models is often constrained by the limited availability of large-scale, well-annotated datasets, which are expensive and labor-intensive to produce. In this work, we introduce D2S2-UI, a novel synthetic UAV dataset designed specifically for semantic segmentation, generated using a text-to-image diffusion model guided by structured prompts and semantic control. Our methodology combines high-level textual conditioning with class-consistent color mapping to synthesize large volumes of labeled aerial imagery without manual annotation. This approach allows us to scale dataset creation while ensuring label fidelity and scene diversity. D2S2-UI features multi-altitude (20m, 60 m, 120 m) and multi-viewpoint (nadir, high-oblique, low-oblique) coverage, along with extensive variation in environmental conditions (e.g., weather, time of day) and region-specific terrains (e.g., Asian, Arabic, American, Egyptian, European). This level of diversity enhances the generalization ability of models trained on the proposed dataset. Experimental results show that models trained on D2S2-UI achieve substantially better segmentation accuracy compared to those trained on existing synthetic UAV datasets, and generalize effectively to multiple real-world UAV benchmarks. The dataset is publicly available at https://github.com/fahad-lateef/UAV-semantic-segmentation-dataset to support further research in aerial scene understanding and UAV-based vision systems.}
}
@article{YIN2026117253,
title = {Shapley-based feature valuation with human feedback in data markets},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117253},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117253},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019799},
author = {Bo Yin and Tianxu Wang},
keywords = {Data markets, Data science, Shapley value, Human feedback},
abstract = {Feature valuation is fundamental to data markets. Shapley value provides a principled approach, but model-based utility may not fully capture feature significance. Incorporating human feedback enables more realistic utility assessment by leveraging contextual knowledge and expert judgment. In this paper, we investigate human-feedback-driven feature valuation based on Shapley values with complementary contributions. This setting poses three key challenges: (1) aggregating distributed local Shapley values derived from heterogeneous and privacy-sensitive evaluations provided by multiple annotators into a global Shapley value, (2) efficiently updating Shapley values when new features are introduced, and (3) adaptively recruiting high-quality annotators to obtain reliable utility evaluations under a limited annotation budget. To address these challenges, we first establish the decomposability of the complementary contribution-based Shapley value, providing a theoretical foundation for the privacy-preserving aggregation of distributed local Shapley values. We then derive an incremental update formula and a corresponding sample complexity bound to efficiently maintain Shapley values as new features are introduced, eliminating the need for recomputation from scratch. Finally, we formulate annotator recruitment as a budget-constrained multi-armed bandit problem, enabling the estimation of annotator reliability and adaptive recruitment without prior knowledge of annotator quality. Our experimental results demonstrate the efficiency and effectiveness of the proposed approaches. For example, the proposed dynamic Shapley algorithm reduces the MSE by 1–2 orders of magnitude.}
}
@article{GONZALEZ2026117259,
title = {Stabilizing EM-based quantification under label shift},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117259},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117259},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019854},
author = {Pablo González and Olaya Pérez-Mon and Juan José {del Coz}},
keywords = {Quantification, Label shift, Prior probability shift, Expectation-Maximization},
abstract = {Quantification aims to estimate class prevalences in unlabeled data, often under prior probability shift (also known as label shift). A standard and widely adopted approach is the EM-based quantifier (EMQ), which has demonstrated strong performance in many quantification tasks. We propose a unified framework that decomposes EMQ into two modular components: a posterior transformation and a prevalence update rule. This formulation encompasses existing heuristics and enables the systematic exploration of new ones. We evaluate several variants, both known in the quantification literature (e.g., calibration, MAP) and established stabilization techniques adapted from adjacent literatures (e.g., damping, entropy regularization), on standard multiclass datasets. Results show that different modifications yield complementary gains depending on classifier and data properties, offering insights into how EMQ can be adapted to improve its robustness.}
}
@article{WEI2026117140,
title = {D2OM: Depth-aware dynamic matching for DETR-based monocular 3D detection},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117140},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117140},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018666},
author = {Chenfeng Wei and Si Zuo and Chang Li and Menghao Yang and Yafei Qi and Guotao Xie and Shenhong Wang and Zeyu Yang},
keywords = {Autonomous driving, Transformer, Monocular three-dimensional object detection, One-to-many matching},
abstract = {Monocular 3D object detection has attracted increasing attention due to its low-cost deployment advantages. However, DETR-based detectors suffer from extremely sparse supervision signals imposed by the one-to-one Hungarian matching strategy, which severely constrains convergence speed and detection performance. Although one-to-many training strategies have been widely validated in 2D detection, directly transferring them to monocular 3D detection presents fundamental limitations: existing methods define positive sample regions in an isotropic manner, overlooking the core characteristic that depth estimation errors substantially exceed lateral localization errors, leading to typical failure modes such as duplicate detections along the depth direction and missed detections caused by depth shift. To this end, we propose a Depth-aware Dynamic One-to-Many Matching (D2OM) training framework for DETR-based monocular 3D detectors, comprising two synergistic components. First, D2OM defines positive sample matching regions as anisotropic ellipsoids aligned with the camera ray, explicitly modeling the larger error tolerance along the depth direction, with a dynamic cost-thresholding mechanism that adaptively controls positive sample count to suppress low-quality matches early in training while progressively increasing supervision density as the model converges. Second, Matching-guided Adaptive Denoising (MAD) takes one-to-many matching statistics as real-time observations to dynamically adjust the number of denoising queries and noise magnitude, and introduces depth-aware denoising query groups to specifically reinforce depth estimation accuracy. Both modules are active only during training and introduce no additional overhead at inference time. Extensive experiments on the KITTI benchmark demonstrate that D2OM consistently improves the performance of multiple strong DETR-based monocular 3D detectors without relying on any auxiliary depth data, achieving gains of 3.04% and 3.63% in AP3D and APBEV on the Moderate validation set, and reaching state-of-the-art performance. Our code will be released at https://github.com/vincentweikey/MonoD2OM.}
}
@article{JI2026117227,
title = {FCIH: Fine-grained cross-view interaction for heterogeneous graph-based learning resource recommendation},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117227},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117227},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019532},
author = {Guoqing Ji and Yubo Wang and Zijun Zhao and Hui He and Zhendong Niu},
keywords = {Heterogeneous graph-based recommendation, Multi-view heterogeneous graph neural networks, Multi-hop information fusion, Learning resource recommendation, Cross-view interaction},
abstract = {Learning resource recommendation naturally benefits from heterogeneous graph modeling. Such modeling captures complementary signals from diverse entities and relations for target-relation prediction. Multi-view heterogeneous graph neural networks (HGNNs) offer a promising way to exploit such multi-relational information. However, existing multi-view HGNNs may not adequately balance target-relation information and multi-relational context. Weakly relevant auxiliary relations may interfere with target-relation signals and impair resource ranking quality. In addition, current multi-hop propagation methods may not sufficiently distinguish informative long-range paths from noisy ones. This reduces the reliability of relational evidence used for recommendation. To address these challenges, we propose FCIH, a heterogeneous graph neural network with fine-grained cross-view interaction for learning resource recommendation. FCIH integrates fine-grained intra-view relation regulation with node-wise inter-view adaptive interaction, enabling heterogeneous multi-hop information to be selectively propagated and target-relation information to be adaptively integrated with multi-relational context. Specifically, FCIH first constructs a multi-relational heterogeneous view preserving all relation types and a target-relation view focused on the predicted relation. Next, within each view, an adaptive multi-hop information fusion module (AMIFM) integrates edge-type-guided node-level attention, global edge-type weighting, and node-wise multi-hop fusion to regulate heterogeneous multi-hop information propagation and produce weight-modulated view-specific representations. Finally, based on the view-specific representations, FCIH performs node-wise adaptive residual fusion across the two views, adaptively balancing target-relation information and multi-relational context. The resulting representations are used to score candidate target-relation links for recommendation. Experiments on MOOCCube, ACL Anthology Network, and Semantic Scholar demonstrate the effectiveness of FCIH across the evaluated recommendation settings.}
}
@article{HONG2026117189,
title = {FDFNet: A Full-stage Dual-dimensional Fusion Network for Visual Grounding},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117189},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117189},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019155},
author = {Shishu Hong and Yangchuanlin Cheng and Aoao Zhao and Longxin Li and Yuchen Tao and Hao Pan},
keywords = {Visual grounding, Referring expression comprehension, Cross-modal fusion, Multi-scale fusion, CNN-based method},
abstract = {Visual grounding is a task that aims to localize objects in an image based on natural language descriptions. Existing Transformer-based methods face challenges in training and deployment, and their inference speed degrades significantly when processing high-resolution images. CNN-based methods are limited by shallow multimodal fusion, insufficient spatial interaction, and a restricted global receptive field. In this paper, we propose a Full-stage Dual-dimensional Fusion Network (FDFNet), incorporating three key components: the Pearson-enhanced Rotation-Shift Module (PearRSM) for channel-wise multimodal fusion, the Balanced-Weighted Aggregation Network (BWAN) for multi-scale feature integration, and the Ripple Attention Module (RAM) for spatial-wise multimodal fusion. These modules are sequentially integrated into the backbone, covering the front and rear parts of the neck, resulting in cumulative performance improvements of 3.7%, 1.35%, and 1.5%, respectively, on the ReferItGame dataset. FDFNet effectively integrates multimodal features, enables dimensional alignment across heterogeneous modalities, and provides a global receptive field. When trained on a single consumer-grade GPU, it achieves at least a 9% performance gain. Furthermore, on four mainstream visual grounding benchmarks, FDFNet matches the prediction accuracy of recent Transformer-based methods, delivers the best inference speed, and maintains high inference efficiency even when processing high-resolution images. Our code is available at https://github.com/hssdsb/FDFNet.}
}
@article{WANG2026117271,
title = {Federated learning in advertising and digital marketing: a comprehensive survey},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117271},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117271},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019970},
author = {Ziyang Wang and Shaheen M. Sarkar},
keywords = {Federated learning, Digital advertising, Personalized marketing, Recommendation systems, Privacy-preserving machine learning, Systematic review},
abstract = {Federated Learning (FL) has emerged as a transformative paradigm for privacy-preserving machine learning in data-sensitive domains such as advertising and digital marketing. By enabling collaborative model training across decentralized devices, FL addresses stringent privacy regulations (e.g., GDPR, CCPA) while supporting personalized targeting, recommendation systems, and campaign optimization. This systematic review synthesizes the literature on FL applications in advertising, digital marketing, e-commerce personalization, and related analytics, analyzing 52 primary studies identified through a PRISMA-guided search across major databases. Publication trends are characterized quantitatively by year, digital-marketing application area, and federated learning architecture, revealing sustained growth in FL-for-marketing research and identifying cross-domain recommendation as the most represented application area, with horizontal FL as the dominant architectural approach across contexts. Key findings highlight FL's ability to achieve comparable performance to centralized approaches in customer targeting and recommendation tasks, with added privacy guarantees via techniques such as differential privacy and secure aggregation. A Pipeline-Stage FL Suitability Framework is introduced, mapping FL architectures and privacy mechanisms onto the five stages of the digital-advertising pipeline and showing that FL adoption is concentrated in the predictive modeling/targeting stage (∼60% of application-specific studies), while the latency-critical real-time bidding stage remains structurally unaddressed in the literature. Challenges including data heterogeneity, communication overhead, and scalability persist. FL is compared with traditional centralized learning, relevant technical frameworks are discussed, and opportunities such as integration with large language models and vertical FL for cross-platform ecosystems are outlined. This survey provides a roadmap for future research, emphasizing real-world deployment and ethical considerations in privacy-preserving marketing.}
}
@article{PAUL2026117219,
title = {A self-monitoring explainable AI decision-support architecture for pre-publication content decisions in public-sector communication},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117219},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117219},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019453},
author = {Sebastian Paul and Arne Johannssen},
keywords = {Decision support, EU AI act, Explainable artificial intelligence (XAI), Knowledge-based systems, Self-monitoring AI, SHAP, Warning systems},
abstract = {AI-based decision-support systems often achieve high predictive performance but remain difficult to use when their outputs are not explainable, monitored, or connected to human action. This paper develops a self-monitoring explainable AI decision-support architecture for pre-publication communication decisions, in which monitoring generates diagnostic signals while resulting actions remain under human control. The architecture combines five layers: pre-decision input construction, XGBoost-based prediction, SHAP-based explanation, residual monitoring, and a knowledge/action layer for human-in-the-loop use. It is evaluated on 10,728 pre-publication content decisions from 16 official public-sector Facebook channels using chronology-preserving validation with train-only preprocessing. Decision-utility analyses show that the model supports ordinal differentiation between lower- and higher-potential posts. The model primarily exploits the recent communication context of the channel, while structural and format-related characteristics provide additional decision-relevant information. Temporal stress testing and residual monitoring show why the system should not be deployed as a static prediction model, but as a monitored decision-support architecture. Thus, the paper contributes a design pattern for transparent, traceable, and human-overseen AI use in dynamic organisational environments, inspired by selected EU AI Act principles.}
}
@article{WU2026117241,
title = {DAGFNet: a degradation-aware gated fusion network for object detection in adverse weather and low-light scenes},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117241},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117241},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019672},
author = {Zhenyuan Wu and Di Wu and Ning Li},
keywords = {Object detection, Adverse weather, Low-light images, Degradation awareness, Multi-scale feature fusion},
abstract = {Under adverse weather and low-light conditions, models based on multi-scale features typically exhibit reduced image contrast, blurred object boundaries, weakened texture details, and insufficient reliability. As a solution, this paper proposes a Degradation-Aware Gated Fusion Detection Network, termed DAGFNet. Built upon the backbone–neck architecture of YOLO, the proposed method preserves the efficiency of single-stage detection while improving the adaptability of the model to complex degradation scenarios from three perspectives: feature enhancement, degradation modelling, and multi-scale fusion. First, a Degradation-Aware Feature Enhancement Network (DAENet) is designed to decompose the input image into low-frequency structural components and high-frequency detail components through Laplacian pyramid decomposition, thereby enhancing object contours, edge textures, and local responses in a targeted manner. Second, a Degradation Prototype Context Encoder (DPCE) is proposed to model image-level degradation states through learnable degradation prototypes, providing degradation-aware contextual priors for subsequent feature modulation. Finally, a Cross-scale Gated Feature Modulation Module (CGFM) is constructed to integrate degradation context with the multi-scale features output by the backbone. By adaptively recalibrating features at different scales, CGFM enhances reliable representations while suppressing degradation-induced interference. Experimental results demonstrate that the proposed method achieves competitive performance on the evaluated adverse-weather and low-light object detection tasks.}
}
@article{WANG2026117209,
title = {Cyclic phase and reference recovery from event-window LDP motion descriptors},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117209},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117209},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019350},
author = {Yaxuan Wang and Yadi Wen and Rong Du and Yue Fu and Enji Liang},
keywords = {Local differential privacy, Knowledge-constrained inference, Intelligent motion analysis, Cyclic phase alignment},
abstract = {Coordinate-wise Square Wave local differential privacy (SW-LDP) protects uploaded motion descriptors but disrupts the repeated structure used by cyclic-boundary and phase-compatible decisions. We introduce Cyclic Phase and Reference Recovery (CPR), which couples interval acceptance, cyclic observation grouping, and SW-aware phase-template estimation under a fixed release boundary. Repetition and support constraints select interval hypotheses; alignment groups observations by latent phase; and the SW likelihood governs reconstruction within those groups. Failed acceptance invokes a non-periodic fallback. These dependencies define the knowledge-based formulation, while standard post-processing preserves the descriptor stream’s event-window LDP guarantee. Paired experiments on AIST++ and HumanML3D span five privacy budgets and 100 randomization seeds, separating descriptor fidelity, human segmentation, automatic-reference agreement, loop selection, and semantic inference. On HumanML3D at ϵ=3, CPR lowers cosine distance from 0.3057 for the direct release to 0.2249, but Fourier smoothing reaches 0.1258 and has lower clean loop-selection regret (0.0827 versus 0.1067). Negative controls show that the default gate accepts nonperiodic inputs at similarly high rates to original clips; reused validation evidence and weak coordinate-level contrast help explain this failure. A fixed-duration control also exposes duration confounding in choreography classification. The results establish the need to assess constraint validity and downstream decisions separately from descriptor denoising; the evaluated CPR implementation does not provide a reliable periodicity certificate or uniform recovery advantage. Its internal cyclic origin additionally requires an external anchor for absolute beat phase.}
}
@article{KOZOL2026117223,
title = {AI-driven personalisation, perceived security and mobile banking continuance: a knowledge-based systems framework for digital trust in emerging markets},
journal = {Knowledge-Based Systems},
volume = {354},
pages = {117223},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117223},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019490},
author = {Ece Kozol},
keywords = {AI-driven personalisation, Perceived security, Digital trust, Mobile banking continuance, Knowledge-based systems},
abstract = {Mobile banking increasingly relies on artificial intelligence (AI) to personalise services, yet the data intensity that enables relevance also heightens security and privacy concerns. This paper develops a knowledge-based systems framework explaining how AI-driven personalisation—an adaptive recommendation capability over sensitive financial data—and perceived security jointly shape mobile banking continuance in emerging markets. Synthesising the Expectation-Confirmation Model, information privacy theory and trust research, the framework specifies two pathways: an experiential pathway, in which personalisation raises satisfaction when perceived as relevant and context-aware, and a relational-risk pathway, in which perceived security raises trust. Each proposition is tied to a property of the underlying system—adaptive knowledge representation, inference and ranking, explainability, learning from behavioural data and system autonomy—making personalisation a distinctive system property, not a contextual descriptor. The framework identifies an algorithmic-security tension: personalisation strengthens trust only when data use is transparent, controllable and non-intrusive, so the personalisation–trust relationship is non-monotonic, turning negative once use is perceived as intrusive. Perceived intrusiveness is specified as a mediator on this path, with data-use transparency and control as procedural levers that lower it—a moderated-mediation structure, not two parallel moderators. Seven propositions specify these mechanisms; four emerging-market boundary conditions—low digital financial literacy, low digital maturity, weak institutional trust and weak brand legitimacy—are consolidated into a higher-order contextual-vulnerability condition, decomposed into testable components. The paper sets out a sequenced research agenda and repositions continuance as the joint governance of algorithmic relevance and security assurance in knowledge-based financial systems.}
}