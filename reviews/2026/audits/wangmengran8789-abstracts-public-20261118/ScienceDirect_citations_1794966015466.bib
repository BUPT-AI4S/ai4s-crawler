@article{WANG2026116464,
title = {Learning spatial-frequency adaptive prototype for remote sensing few-shot segmentation},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116464},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116464},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011901},
author = {Shiyan Wang and Minting Meng and Mingxuan Chang and Zhennan Yang},
keywords = {Few-shot segmentation, Prototype learning, Spatial-frequency domain, Remote sensing},
abstract = {Few-shot segmentation (FSS) addresses the challenge of segmenting novel classes with few labeled support samples. Most existing prototype-based methods rely on spatial average pooling or clustering to generate a rough prototype representation, failing to preserve critical fine-grained details such as edge and structural information. This fundamental constraint significantly hinders the ability to handle the substantial intra-class variations and inter-class similarities, which are common in remote sensing images. To overcome the limitations, we propose a novel Spatial-Frequency Adaptive Prototype learning Network named SFAPNet for few-shot segmentation. Specifically, our Dual-domain Adaptive Prototype Generator (DAPG) employs dynamic weighting to integrate spatial and frequency domain features, producing optimized composite prototypes through adaptive fusion. DAPG enhances both semantic representations and fine-grained detailed features, effectively mitigating the impact of appearance and texture variations. Furthermore, we introduce a Public-semantic Activation Module (PSAM) to activate shared semantic features in both query and support images. PSAM enhances class-specific features while suppressing interference from irrelevant regions, thereby reducing feature contamination. Finally, Semantic-aligned Matching Decoder (SMDecoder) employs lightweight attention to aggregate global contextual information at each query position, enabling prototype-guided semantic alignment between support and query features for precise segmentation. Extensive experiments on the iSAID-5i dataset show that SFAPNet achieves state-of-the-art mIoU and FB-IoU performance under 1-shot and 5-shot settings, validating its superiority in remote sensing scenarios with excellent in-dataset generalization across different folds and categories.}
}
@article{ZHANG2026116504,
title = {DNesTMamba: A Deformable Nested Transformer with Integrated Mamba for hyperspectral image classification},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116504},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116504},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601230X},
author = {Xin Zhang and Zitong Zhang and Qiaoyu Ma and Kai Zhang and Yichen Liu},
keywords = {Hyperspectral image classification, Spectral–spatial feature extraction, Nested transformer, Mamba, Deformable operation},
abstract = {Hyperspectral image (HSI) classification presents significant challenges in efficiently modeling long-range spectral dependencies and adaptively capturing complex spatial structures. While Vision Transformers excel at long-range modeling, their quadratic computational complexity restricts practical scalability. The recently introduced Mamba architecture, renowned for its linear-time sequence modeling, offers a promising alternative but still lacks explicit hierarchical spatial modeling capabilities. To overcome these limitations, this paper proposes a Deformable Nested Transformer with Integrated Mamba (DNesTMamba). The framework centers around the Deformable Nested Mamba-Transformer (DNMT) module, which synergistically incorporates two innovative components: a Spectral-Spatial Mamba Attention (SSMA) block that enables efficient long-range spectral–spatial modeling with linear-complexity intra-token S2Mamba sequence modeling before attention-based inter-token interaction, and a Deformable Nested Transformer Aggregation (DNTA) block that dynamically learns sampling offsets to adaptively capture irregular spatial structures. Comprehensive experiments on four benchmark HSI datasets validate that DNesTMamba achieves superior classification accuracy with a competitive accuracy-efficiency trade-off.}
}
@article{ZHANG2026116415,
title = {RealKGC: Relation-constrained large language models for inductive knowledge graph completion},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116415},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116415},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601141X},
author = {Yan Zhang and Jing Hu and Chenyi Xiong and Ziyue Qin and Hui Chen and Zhifei Li},
keywords = {Knowledge graph, Inductive knowledge graph completion, Large language models},
abstract = {Large language models have demonstrated remarkable potential in knowledge graph completion owing to their extensive semantic knowledge. However, in the inductive setting, LLMs lacking prior knowledge of unseen entities become disproportionately sensitive to noise in the local context. In addition, supervised fine-tuning inadvertently encourages models to circumvent genuine reasoning by exploiting statistical shortcuts between graph contexts and labels. To address these challenges, we introduce RealKGC, an LLM-based method with relation constraints for inductive knowledge graph completion. Specifically, we develop a relation–path–entity coupling module to explicitly filter noise by pruning reasoning paths irrelevant to the query relation. Furthermore, we integrate structural integrity, entity-type consistency, and background facts as soft constraints to ground the reasoning process in factual evidence. Extensive experiments across three widely used datasets demonstrate that RealKGC consistently outperforms state-of-the-art baselines, achieving average MRR improvements of 3.83% in the inductive setting and 7.77% in the transductive setting. The code is available at https://github.com/HubuKG/RealKGC.}
}
@article{RUAN2026116404,
title = {Pedestrian-aware end-to-end autonomous parking via coupling-regulated multi-task learning},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116404},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116404},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011305},
author = {Mengying Ruan and Yuyi Zhou and Yi Yang and Mengyin Fu and Ting Zhang},
keywords = {Autonomous parking, Pedestrian trajectory prediction, Multi-task learning, Imitation learning, End-to-end planning},
abstract = {Autonomous parking has become an indispensable capability for autonomous driving systems. However, most existing approaches focus on static scenarios which neglect the dynamic interactions during the parking process. In real-world environments, dynamic obstacles are inevitable, among which pedestrians pose the greatest safety risk due to their highly stochastic and flexible motion patterns. To address this challenge, this work proposes an end-to-end autonomous parking framework that integrates pedestrian trajectory prediction with imitation learning-based planning under a multi-task learning paradigm. Specifically, a pedestrian prediction module takes four surround-view images as input and outputs bounding box-level visual cues, which are explicitly incorporated into the perception stream to guide planning. Conditioned on the predicted cues and multi-modal perception, the following planning module generates continuous control actions for autonomous parking. Furthermore, we investigate different training paradigms for these two dependent and sequential tasks, including separate learning, joint learning, and a coupling-regulated joint learning strategy, in which cross-task influence is explicitly constrained through loss coupling to mitigate negative interference. Closed-loop evaluations are conducted on the open-source DynaPark-Ped11https://github.com/rmmyy/DynaPark-Ped., a newly collected ego-centric and multi-modal dynamic parking dataset built in the CARLA simulator for pedestrian-interactive parking scenarios. Experimental results show that the proposed framework achieves a 95.5% collision-free pedestrian interaction rate and an overall parking success rate of 85% (7% improvement over baseline), demonstrating its effectiveness in complex dynamic parking environments.}
}
@article{GAO2026116456,
title = {HeteroHBA: A generative structure-manipulating backdoor attack on heterogeneous graphs},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116456},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116456},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011822},
author = {Honglin Gao and Lan Zhao and Junhao Ren and Xiang Li and Gaoxi Xiao},
keywords = {Heterogeneous graph, Backdoor attack, Heterogeneous graph neural networks},
abstract = {Heterogeneous graph neural networks (HGNNs) have shown strong performance in many real-world applications, but targeted backdoor attacks on heterogeneous graphs are still underexplored. In this setting, an attacker injects a small number of trigger nodes and edges during training so that selected victim nodes are misclassified into a target label at test time, while the model still performs well on clean data. To study this threat, we propose HeteroHBA, a generative backdoor attack framework for heterogeneous node classification. HeteroHBA first uses saliency-based screening to select influential auxiliary neighbors for trigger attachment, and then generates trigger features and connection patterns that better match the local heterogeneous context. We further adopt a bilevel optimization objective to improve attack success while preserving clean accuracy. In addition, to enhance attack stealthiness, we combine Adaptive Instance Normalization (AdaIN) and Maximum Mean Discrepancy (MMD) loss to align trigger features with benign feature statistics. Experiments on multiple real-world heterogeneous graphs and representative HGNN models show that HeteroHBA generally achieves stronger attack performance than the compared baselines, with comparable or smaller impact on clean accuracy. In addition, it remains relatively effective under our heterogeneity-aware structural defense, CSD. These findings reveal practical backdoor risks in heterogeneous graph learning and suggest the need for stronger defenses.}
}
@article{JIA2026116517,
title = {SS-ALNN: A spatio–spectral framework with adaptive liquid dynamics for spectral image modeling},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116517},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116517},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012438},
author = {Huijie Jia and Chenlin Wu and Min Huang and Qibing Zhu and Min Zhang},
keywords = {Spectral imaging, Spatio–spectral, Multi-scale convolution, Liquid neural networks, Continuous-time dynamics},
abstract = {Spectral images integrate rich “spectral–spatial” structural information and are widely used in remote sensing and agriculture. However, hyperspectral data typically contain many bands with substantial redundancy, making it difficult for existing methods to jointly model spectral–spatial structures, capture inter-band dependencies, and represent spectra as smoothly evolving wavelength-continuous dynamics. To address these challenges, this paper proposes an end-to-end spatio–spectral continuous-time framework, termed Spatio–Spectral Adaptive Liquid Neural Network (SS-ALNN). SS-ALNN first introduces a Parallel Multi-Scale Spatial–Spectral module (PMSS) with parallel 2D/3D convolutional branches to extract spatial textures, local spectral–spatial couplings, and morphological cues, forming a structured spectral-group sequence. It then develops an Adaptive Liquid Neural Network module (ALNN) for high-dimensional spectral features, integrating an input-driven adaptive time constant τ(·), Structured Sparse Spectral-Group Connectivity (SSSGC), and a stable hybrid explicit–implicit solver (S-HIRE) to model cross-band continuity, long/short-range dependencies, and non-uniform spectral dynamics. Generalization is validated on four tasks: EuroSAT, tomato invisible damage HSI, NIR-Carrot, and LUCAS-OC 2009 regression. Experiments show that SS-ALNN achieves state-of-the-art performance across all benchmarks, improving classification accuracy by 1.5%–3.2% on average, reducing RMSE and increasing R² for regression, while maintaining extremely low FLOPs and the fastest inference speed. These results highlight SS-ALNN’s strong spectro-spatial representation, parameter efficiency, and broad applicability. The source code for SS-ALNN is publicly available at: https://github.com/jjjjj22/SS-ALNN.}
}
@article{HUANG2026116428,
title = {Adaptive Multi-view Clustering with Global Weighting and Fine-grained Feature Fusion},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116428},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116428},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011548},
author = {Xin Huang and Yan Xu and Bing Gao and Guanqiu Qi and Yuanyuan Li and Zhiqin Zhu},
keywords = {Multi-view clustering, Adaptive weighting, Feature fusion, Contrastive learning},
abstract = {Multi-view clustering offers a more comprehensive capture of data internal structures, thereby significantly enhancing clustering accuracy. However, two key challenges remain: (1) Characterization bottlenecks arising from model degradation and training instability during deep feature extraction; (2) Robust feature fusion under conditions of view quality imbalance and noise interference. To address these issues, this paper proposes Adaptive Multi-view Clustering with Global Weighting and Fine-grained Feature Fusion (AMVC-GWFF). Specifically, a Deep Residual Multi-view AutoEncoder (DeepRes-AE) is designed to extract low-dimensional, representative features while suppressing redundancy and noise inherent in heterogeneous views. Subsequently, a novel Fine-grained Feature Fusion (GWFF) module is developed to amplify high-quality views, mitigate noise contamination in low-quality views, and enable discriminative fine-grained feature selection and fusion by dynamically assigning both view- and sample-specific weights. Furthermore, feature discrimination and consistency are enhanced through instance-guided and label-guided contrastive learning, coupled with cross-view probability distribution alignment. Extensive experiments were conducted on eight benchmark datasets and compared with 11 competing methods, and the results show that the proposed AMVC-GWFF method outperforms significantly.}
}
@article{WU2026116505,
title = {MV-NeRV: Compact neural representation for multi-view videos via coarse-to-fine parallax elimination},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116505},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116505},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012311},
author = {Chang Wu and Chang Su and Gang He and Xiandong Meng and Yunsong Li},
keywords = {Multi-view video, INR-based, Parallax redundancy detection, Parallax information interaction},
abstract = {Implicit Neural Representations (INRs) have shown promise in video compression. However, existing models face challenges in multi-view video due to asynchronous decoding and limited ability to capture disparity relationships, which hinders their performance. In this paper, we propose MV-NeRV, a neural representation framework for multi-view videos that removes parallax redundancy from coarse to fine and achieves synchronized decoding. Firstly, we introduce a Parallax-identified Embedding Generation Module (PEGM), which provides inter-view priors for initializing embeddings in a parameter-efficient manner. PEGM roughly identifies feature-level redundant regions via pixel-level cross-view similarity. By combining shared embeddings with view-specific information, it generates multi-view embeddings using fewer parameters, while removing redundancy in a coarse way. Secondly, we design a Parallax Alignment Interaction Module (PAIM) to perform precise parallax compensation. High-dimensional semantics across different views are more similar than pixels, so disparity relationships can be extracted more sufficiently in the feature domain. PAIM leverages a multi-view reference selection mechanism to align and fuse embeddings across views with minimal additional parameters, thereby enabling fine-grained redundancy removal. Experimental results demonstrate that MV-NeRV significantly outperforms existing INR-based models, achieving state-of-the-art performance.}
}
@article{KE2026116477,
title = {Multi-view spectral clustering via high-frequency truncation and graph wavelet modulation},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116477},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116477},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012037},
author = {Shouye Ke and Yue Gao and Guohua Huang and Xiaoke Ma},
keywords = {Multi-view clustering, Spectral clustering, Graph Laplacian, High-frequency truncation, Graph wavelet transform},
abstract = {Spectral clustering is a basic method in unsupervised learning based on graphs. This method can extract the inherent cluster structure from the characteristic space of the graph Laplacian. However, different spectral components have different effects on cluster quality. In robust multi-view clustering, the role of these components has not been fully understood. This article first gives a theoretical analysis. Analysis shows that the low-frequency part retains the main cluster subspace. High-frequency truncation can reduce the sensitivity of the model to disturbances without destroying the spectral structure of the core. Then, we studied the frequency characteristics of spectral clustering through experiments. Experiments reveal an obvious phenomenon: removing low-frequency components will seriously weaken the clustering effect, while appropriately suppressing a certain amount of high-frequency components will usually improve robustness. Inspired by these findings, we propose a new framework with theoretical support, namely Multi-View Spectral Clustering via High-Frequency Truncation and Graph Wavelet Modulation(MST-WM). The specific practice of the framework is that the graph Laplacian corresponding to each view is first truncated to remove the unstable high-frequency component. Then, the obtained Spectral embedding is fused into a consistent representation. The representation is further refined by graph wavelet modulation, which can not only enhance the smooth structural information, but also suppress residual noise. A large number of experimental results on 10 benchmark data sets show that the proposed method is stable and superior to a variety of competitive baselines in terms of ACC, NMI and purity. These results show that the unequal effect of explicit modeling spectral components provides a principled and effective path for achieving robust multi-view clustering.}
}
@article{DAI2026116529,
title = {FreqResNet: Frequency-Aware Resonance Network for multivariate time series forecasting},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116529},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116529},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012554},
author = {Cheng Dai and Sha Xiang and Banglie Yang and Shoupeng Lu and Xingang Liu and Lipeng Xie and Yue Wang},
keywords = {Multivariate time series forecasting, Frequency domain learning, Hypergraph convolution},
abstract = {Multivariate time-series forecasting (MTSF) plays an increasingly important role in traffic management, power systems, and meteorology. However, most existing methods predominantly operate in the time domain, where dependency estimation is vulnerable to amplitude scaling, phase shifts, and noise perturbations, thereby obscuring stable cross-variable couplings when multiple variables share energy within the same frequency band but respond with different delays. Motivated by spectral resonance, we propose the Frequency-Aware Resonance Network (FreqResNet) to model band-specific, phase-aware, and higher-order cross-variable dependencies in the frequency domain. Firstly, we design a dual-branch temporal feature extraction module, which captures both cross-node dynamic patterns and node-wise local temporal information. Secondly, we develop a complex hypergraph resonance modeler, which leverages physically interpretable frequency response functions to identify node groups with similar oscillatory behaviors. Besides that, we introduce a complex-domain hypergraph convolution network, which jointly propagates amplitude and phase information to model delayed yet coordinated responses among variables. Finally, extensive experiments on six real-world datasets demonstrate that FreqResNet achieves competitive and often superior forecasting accuracy against strong recent baselines, with particularly pronounced gains on datasets exhibiting stronger periodic concentration.}
}
@article{SU2026116497,
title = {FGR3D: Fine-grained 3D-text retrieval via Modality-Specific Slot Attention and Prototype-Guided Part Matching},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116497},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116497},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012232},
author = {Liangliang Su and Xiao Wei and Yulong Liu and Yalong Yang},
keywords = {3D-text retrieval, Cross-modal alignment, Part-level representation, Slot attention, Semantic prototypes},
abstract = {Cross-modal 3D-text retrieval aims to align 3D shapes with natural language descriptions. Existing methods mainly rely on global feature alignment, which is insufficient for capturing part-level differences among instances within the same category. In contrast, methods based on local alignment often depend on explicit part annotations, leading to high annotation cost and limited generalization. To address these limitations, we propose FGR3D, a fine-grained 3D-text retrieval framework that achieves part-level cross-modal alignment without explicit part annotations. Specifically, we introduce a Modality-Specific Slot Attention (MSSA) mechanism to inject differentiated structural inductive biases into point clouds and text, enabling adaptive decomposition of input features into part-level representations. We further develop a Prototype-Guided Part Matching (PGPM) module, which models cross-modal part correspondences in a shared semantic prototype space and suppresses noise from irrelevant regions through a Dustbin prototype. In addition, we construct FG3D, the first fine-grained benchmark dataset with part-level cross-modal semantic consistency, in which semantic correspondences among point cloud parts, rendered images, and textual descriptions are established through geometric inference and vision–language models. Extensive experiments on the public Text2Shape benchmark and our self-constructed FG3D dataset demonstrate the effectiveness of the proposed approach. In shape-to-text (S2T) retrieval, FGR3D achieves RR@1 scores of 51.49% and 68.78% on Text2Shape and FG3D, respectively, substantially outperforming the state-of-the-art methods evaluated in this work.}
}
@article{JEON2026116408,
title = {Enriching subgraph retrieval with attribute values for complex question answering over knowledge graph},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116408},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116408},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011342},
author = {Myeongheon Jeon and Kyuhwan Yeom and Jongwon Park and Minji Kim and Kyong-Ho Lee},
keywords = {Complex question answering, Knowledge graph, Retrieval, Literal, Question intent},
abstract = {Knowledge Graph Question Answering (KGQA) aims to answer natural-language questions using structured knowledge graphs (KGs). A common approach first retrieves a question-relevant subgraph from a large KG and then performs answer inference on the retrieved subgraph. However, many existing retrievers focus mainly on relations between entities and underuse attribute values (i.e., literals such as dates and numbers), which limits alignment with complex and constrained questions. To address this limitation, we propose a subgraph retrieval method that jointly models relation and attribute evidence. The proposed model identifies keyphrases in a question, aligns them with relevant KG edges, and retrieves constraint-related attributes and their values. By integrating relation paths with literal-aware attribute information, the method constructs subgraphs that better reflect question intent. Experiments on CWQ and WebQSP show improved retrieval for complex and constrained questions, leading to stronger downstream QA performance.}
}
@article{CHO2026116448,
title = {BSR-SAGE: Sharpness-aware gradient ensemble for transferable adversarial attacks},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116448},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116448},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011743},
author = {Chanwoo Cho and Gyuho Choi},
keywords = {Adversarial attack, Ensemble transferability, Vision transformer (ViT), Block shuffle and rotation (BSR), Sharpness-aware minimization (SAM), Adaptive-token gradient regularization (ATGR)},
abstract = {Recently, studies on adversarial attacks against deep learning models have been actively conducted in the fields of computer vision and autonomous driving to ensure the security and stability of deep learning-based systems. Adversarial attacks are methods of attacking artificial intelligence models by manipulating input data to induce incorrect predictions and decisions. Input transformation adversarial attack methods and gradient adjustment adversarial attack methods were analyzed to have low attack success rates (ASR) due to the difficulty in improving transferability when the target model is robust or has a large structural difference from the surrogate model. To solve the problem of reduced transferability, existing adversarial attack methods used ensemble models to generate adversarial examples, but they were designed in a limited way in ensemble models using the logits and average loss values of the models. In order to overcome the limitations of existing loss-average ensemble adversarial attacks, this paper proposes sharpness-aware gradient ensemble (SAGE) attacks, which add an adaptive-token gradient regularization (ATGR) block to the ensemble adversarial attacks that apply sharpness-aware minimization (SAM) and block shuffle and rotation (BSR) process to the gradient values of the surrogate model. The proposed SAGE adversarial attack method consists of an ensemble gradient SAM (EGSAM) process to improve the generalization ability to successfully attack black-box models and an ATGR process to improve the transferability of vision transformer surrogate models through regularization. As a result of the experiment, the proposed BSR-SAGE adversarial attack method achieved an average ASR that is 17.4%, 27.4%, 29.3%, and 19.1% higher than the existing stochastic variance reduced ensemble (SVRE), token gradient regularization (TGR), virtual dense connection (VDC), and adaptive token tuning (ATT) methods, respectively, on the ViT-b/16 & DeiT-b/16 surrogate ensemble using the ImageNet public DB. The proposed SAGE improves the ASR of existing ensemble adversarial attacks by using the fusion approach of EGSAM and ATGR blocks that average the gradients of surrogate models. SAGE contributes to improving transferability even when there is a large structural difference between models through an ensemble strategy that improves the logits and loss averaging methods. Code is available at https://github.com/IDPLab-chosun/BSR_SAGE.}
}
@article{HE2026116509,
title = {Unleashing the power of motion and depth: A selective fusion strategy for RGB-D video salient object detection},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116509},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116509},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012359},
author = {Jiahao He and Daerji Suolang and Keren Fu and Qijun Zhao},
keywords = {Salient object detection, RGB-D videos, Depth, Optical flow, Multi-modal fusion},
abstract = {Applying salient object detection (SOD) to RGB-D videos is an emerging task called RGB-D VSOD and has recently gained increasing interest, due to considerable performance gains of incorporating motion and depth and that RGB-D videos can be easily captured now in daily life. Existing RGB-D VSOD models have different attempts to derive motion cues, in which extracting motion information explicitly from optical flow appears to be a more effective and promising alternative. Despite this, there remains a key issue that how to effectively utilize optical flow and depth to assist the RGB modality in SOD. Previous methods always treat optical flow and depth equally with respect to model designs, without explicitly considering their unequal contributions in individual scenarios, limiting the potential of motion and depth. To address this issue and unleash the power of motion and depth, we propose a novel selective cross-modal fusion framework (SMFNet) for RGB-D VSOD, incorporating a pixel-level selective fusion strategy (PSF) that achieves optimal fusion of optical flow and depth based on their actual contributions. Besides, we propose a multi-dimensional selective attention module (MSAM) to integrate the fused features derived from PSF with the remaining RGB modality at multiple dimensions, effectively enhancing feature representation to generate refined features. We conduct a comprehensive evaluation of SMFNet against 14 state-of-the-art models on the RDVS, DVisal and ViDSOD datasets, which demonstrates the superiority of SMFNet over other models. Meanwhile, evaluation on three VSOD benchmark datasets (DAVIS, DAVSOD, FBMS) incorporating synthetic depth validates the efficacy of SMFNet as well. Our code and results are made publicly available at https://github.com/Jia-hao999/SMFNet.}
}
@article{GOU2026116472,
title = {DFMQ-MC: Dynamic fusion based on modality quality and cross-modal semantic consistency for multimodal intent recognition},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116472},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116472},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011986},
author = {Zhinan Gou and Mengyao Jia and Xueya Xue and Yufan Wang},
keywords = {Multimodal intent recognition, Modal quality, Dynamic fusion, Semantic consistency},
abstract = {The objective of multimodal intent recognition is integrating heterogeneous information such as text, audio, and video to infer users’ underlying intentions. It has been widely applied in domains including human–computer interaction and intelligent customer service. However, existing approaches exhibit two limitations. First, fixed-weight fusion strategies that neglect differences in modality quality (e.g. noisy audio and blurry video) adversely affect model performance. Second, the absence of explicit cross-modal semantic consistency constraints leads to heterogeneity-induced semantic conflicts and reduced robustness. In this paper, we propose a dynamic fusion model based on modality quality and cross-modal semantic consistency (DFMQ-MC). To achieve adaptive multimodal fusion driven by high-quality modalities, we design a meta-learning-based dynamic-weight prediction mechanism, which quantifies modality quality features across text, audio and video and trains a weight predictor using the model-agnostic meta-learning strategy. The text modality is considered as the semantic benchmark, and the proposed cross-modal semantic consistency constraint measures the prediction distribution differences between audio–text and video–text pairs via the Kullback–Leibler divergence and incorporates a consistency loss into the total loss function to promote cross-modal semantic alignment. Additionally, we construct a multi-objective weighted loss function that integrates classification, contrastive, meta-learning, and modal consistency losses to comprehensively optimise model performance. Experiments conducted on two public benchmark datasets (MIntRec and MELD-DA) demonstrate that DFMQ-MC significantly outperforms the state-of-the-art methods. Furthermore, ablation experiments reveal the effectiveness of the dynamic-weight prediction mechanism and the modal consistency constraint in enhancing overall performance.}
}
@article{XU2026116532,
title = {Exploring visual–semantic relation-aware knowledge for cross-domain few-shot learning},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116532},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116532},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601258X},
author = {Qin Xu and Mengqing Sun and Lili Zhu and Xixi Wang and Bo Jiang and Zhifu Tao},
keywords = {Cross-domain few-shot learning, Domain adaptation, Visual–semantic relation},
abstract = {Cross-domain few-shot learning (CDFSL) aims to transfer the knowledge learned from the source domain to novel target categories with very limited samples. Existing methods are largely constrained by their neglect of relational modeling among target domain samples. This limitation not only impedes the acquisition of discriminative visual features but also diminishes the model’s generalization capacity in the target domain. To address this issue, we propose a method to explore the visual–semantic relation-aware (VSRA) knowledge for CDFSL. To explicitly capture the visual and semantic relation between the target domain samples, the visual–semantic relation embedding module is designed. The module models the visual relations and semantic relations of the samples and embeds the relations into the multi-layer features, enabling the effective extraction of the relation-aware features. To emphasize the different importance of features in the channel dimension, the Dynamic Context Activation module is designed. Furthermore, to ensure both global and local consistency within samples, we propose the Cross-Layer Interaction Attention module. By adaptively integrating multi-level features, it obtains global visual–semantic relation-aware features to better learn domain-discriminative knowledge for generalizing to the target domain. Experimental results on the BSCD-FSL benchmark demonstrate that our method outperforms existing CDFSL methods and exhibits superior cross-domain adaptation ability.}
}
@article{TRIAYUDI2026116553,
title = {LOT-HC: A learnable optimal transport linkage for scalable and robust hierarchical clustering},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116553},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116553},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012797},
author = {Agung Triayudi and Ucuk Darusalam and Dayan Hisni and Rudi Setiawan},
keywords = {Hierarchical clustering, LOT-HC, Optimal transport, Representation-aware, Clustering},
abstract = {Hierarchical clustering provides an interpretable multiresolution representation of data through a dendrogram, but classical linkage criteria often become unstable in heterogeneous, imbalanced, and high-dimensional settings. This paper proposes Learnable Optimal Transport Hierarchical Clustering (LOT-HC), a representation-aware hierarchical clustering framework that defines inter-cluster dissimilarity using entropically regularized optimal transport in a latent space. LOT-HC represents each cluster as an empirical distribution rather than a centroid or pairwise-distance summary. The transport-based linkage is augmented with a density-aware penalty to discourage premature merges across different local-density regimes and a balance-aware penalty to reduce unstable absorption of small clusters by much larger ones. To improve scalability, candidate merges are restricted using an approximate nearest-neighbor graph, while large clusters are compressed through coreset representations before transport evaluation. Theoretical analysis shows that, under explicit and empirically verifiable assumptions, the proposed linkage satisfies non-negativity, symmetry, near-reducibility, local stability, and bounded coreset-approximation behavior. Experiments on controlled density-imbalance benchmarks, granular and fast hierarchical baselines, and thyroid-cancer cohorts demonstrate that LOT-HC is most effective when evaluated using hierarchy-aware criteria, including dendrogram purity, early density-mismatch control, early imbalance reduction, and rare-cluster preservation. Recent granular and ellipsoid-based methods remain competitive on flat clustering metrics, but LOT-HC provides stronger control over the hierarchical merge process. These results position LOT-HC as a robust and scalable framework for interpretable hierarchy construction in heterogeneous and imbalanced data.}
}
@article{HE2026116443,
title = {Intra-class diversity and inter-class similarity feature calibration network for few-shot object detection},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116443},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116443},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601169X},
author = {Zhenwei He and Xinye Liao and Zhixian Zhang and Xiaojun Huang and Li Geng and Xin Feng},
keywords = {Few-shot object detection, Feature Distribution Calibration, Graph Convolutional Network},
abstract = {Few-shot object detection (FSOD) addresses the challenge of limited training data based on traditional detection methods. Recently, finetune-based FSOD techniques have gained progress by adapting networks to novel classes. However, these methods are often sensitive to the variability of training samples within novel classes, leading to instability in finetuning effectiveness. Additionally, the scarcity of novel samples can introduce data bias and information loss when the FSOD model ignores common semantic features between base and novel classes. To tackle these issues, this paper presents the Feature Calibration Network (FCNet), comprising two crucial components: (1) Feature Distribution Calibration (FDC) enriches training samples to reduce the model’s sensitivity to novel classes while calibrating their distribution with base classes. (2) Base–novel Graph Convolutional Network (BNG) enhances semantic information within novel class features through a Base–Novel relation graph. A clustering algorithm selects representative samples for graph learning. Extensive experiments on the PASCAL VOC and COCO datasets validate the effectiveness of our approach. FCNet demonstrates superior performance and offers a versatile solution for fine-tuning paradigm few-shot detection methods.}
}
@article{ZHANG2026116485,
title = {Adaptive graph prompting for graph clustering},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116485},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116485},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012116},
author = {Zhaomin Zhang and Qian Gao and Yaliang Zhao and Jinke Wang and Yingxin Long and Yang Cheng},
keywords = {Clustering, Graph structure learning, Graph prompt learning, Pseudo-labels},
abstract = {Deep graph clustering is a fundamental unsupervised task in graph data analysis. However, most existing methods rely on a fixed homophily assumption, which leads to unstable performance on real-world graphs with significantly varying homophily levels, particularly manifesting as severe performance degradation on heterophilous graphs. Moreover, these methods are typically constrained by static graph topologies and globally unified modeling strategies, making it difficult to simultaneously adapt to graph-level homophily variations and node-level local structural differences. As a result, they struggle to effectively handle complex real-world graphs where homophily and heterophily coexist. To alleviate these issues, our core idea is to dynamically address the influence of diverse homophily patterns on graph clustering through a synergistic adaptive mechanism between graph structure and node representations under an unsupervised setting. Based on this insight, we propose an Adaptive Graph Prompting for Graph Clustering (AGPC) framework, which achieves joint adaptive optimization of graph structure and node representations. Specifically, AGPC employs a homophily-constrained graph structure enhancement module (HCSE) to adaptively refine the graph topology, providing high-quality structural inputs for the encoder. Meanwhile, a homophily-aware node-level prompting generator (HANPG) is introduced to generate personalized guidance signals for different nodes, enabling precise adaptation to their local neighborhood variations. In addition, we incorporate a self-training strategy based on high-confidence pseudo-labels to provide supervision guidance for the model, forming an adaptive interplay between structure optimization and representation learning. Extensive experiments on both homophilous and heterophilous graph benchmark datasets demonstrate the effectiveness and superiority of the proposed method.}
}
@article{GUO2026116541,
title = {Complementary encoder refinement and multilevel crossmodal interaction for multimodal sarcasm detection},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116541},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116541},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012670},
author = {Hao Guo and Subin Huang and Zhifa Geng and Junjie Chen and Sanmin Liu and Chao Kong},
keywords = {Multimodal sarcasm detection, Sentiment analysis, Crossmodal fusion},
abstract = {Multimodal sarcasm detection identifies sarcastic intent by analyzing discrepancies between literal meaning and multimodal cues, which has attracted significant research interest. However, accurate multimodal sarcasm detection remains challenging because heterogeneous pretrained encoders produce representations at different granularities, and balancing multiple interaction paths often requires handcrafted fusion heuristics. To address these challenges, we propose a multimodal sarcasm detection framework that combines complementary encoders with multilevel crossmodal interaction and learned global calibration coefficients (GCCs). (i) We introduce intra-modal encoder refinement modules to fuse heterogeneous encoders within each modality (e.g., BERT with CLIP-Text, ResNet with CLIP-Image), enabling complementary information exchange before the crossmodal interaction. (ii) We designed a multilevel interaction module to capture bidirectional text–image dependencies across representation levels. We further introduce a compact set of learned global calibration coefficients to calibrate interaction paths end-to-end, achieving computational efficiency without additional instance-wise gating modules and reducing the reliance on handcrafted fusion heuristics. Extensive experiments demonstrate that the proposed method consistently outperforms state-of-the-art methods on three public multimodal sarcasm detection benchmarks, particularly achieving an F1-score of 91.81% on MMSD2.0 dataset, demonstrating a 1.56% improvement over the previous best-performing technique. Additional evaluations on out-of-domain, cross-domain, degraded-visual, and incomplete-modality settings further show that the method maintains competitive performance under highly challenging evaluation conditions.}
}
@article{HALDAR2026116452,
title = {Toward causally-inspired explanations of maintenance effort: Integrating SHAP and LLM-based heuristic reasoning},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116452},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116452},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011780},
author = {Susmita Haldar and Luiz Fernando Capretz},
keywords = {Maintenance effort prediction, Explainable artificial intelligence, Shapley additive explanations, Large language models, Heuristic reasoning, Knowledge-driven interpretability, CatBoost},
abstract = {Realistic estimation of maintenance effort is essential for effective resource planning and managerial decision-making. Predictive models use historical data but primarily capture correlations among software attributes and effort, which limits interpretability for project managers. While Shapley Additive Explanations (SHAP) quantify feature influence, they do not provide human-understandable explanations to support decision-making. This study proposes an interpretability-focused framework that integrates SHAP-based feature attributions with Large Language Models (LLMs). The goal is to facilitate a deeper understanding of project-level maintenance effort through causally-inspired, heuristic reasoning derived from model behavior. Using the International Software Benchmarking Standards Group (ISBSG) dataset, several tree-based models were evaluated. CatBoost achieved the best performance. SHAP values identified key feature attributions, which were subsequently interpreted by GPT-4.0, Gemini 2.5 Pro, and Llama 3.3 to generate contextual explanations. Alignment between SHAP and LLM-derived rankings was measured using Mean Absolute Difference (MAD). Local explanations were evaluated through automated scoring and expert review. Gemini 2.5 Pro showed the closest alignment with SHAP rankings, while GPT-4.0 produced the most exact matches. All models generated consistent and contextually relevant explanations. The proposed framework combines quantitative attribution with qualitative heuristic reasoning, improving interpretability and supporting transparent maintenance effort estimation.}
}
@article{SUN2026116392,
title = {Graph Mixture of Experts with Differential Cross-Attention Alignment for Multimodal Intent Recognition},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116392},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116392},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011184},
author = {Shilin Sun and Wenbin An and Qidong Liu and Fang Nan and Jiahao Nie and Zhi Zeng and Xian-Sheng Hua and Yaqiang Wu and Feng Tian},
keywords = {Multimodal fusion, Differential Cross-Attention, Multimodal intent recognition},
abstract = {Multimodal intent recognition aims to infer user intents by integrating information from diverse modalities such as text, video, and audio. While recent methods achieve promising results by fusing multimodal information through a single static network that learns shared representations across modalities, they often fail to suppress noisy features during cross-modal fusion and overlook modality-specific information. These limitations cause suboptimal representations and reduced prediction accuracy. To address these challenges, we propose Graph Mixture of Experts with Differential Cross-Attention Alignment (GMoE-DCAA), a novel framework aimed at mitigating cross-modal noise and learning modality-aware representations for intent recognition. Specifically, we introduce a Differential Cross-Attention Alignment (DCAA) module that removes noisy information and emphasizes salient cues during cross-modal fusion. By suppressing spurious and noisy cross-modal interactions, DCAA produces sharper and more reliable cross-modal attention maps, enhancing the representations of each modality. Next, the shared Graph Mixture-of-Experts module encodes each modality into structured graphs and dynamically routes them to specialized experts via a gating mechanism. This design facilitates specialized processing, efficient knowledge sharing, and complementary feature extraction across modalities. Finally, the modality-aware representations are fused for final intent prediction. Extensive experiments on standard benchmarks demonstrate that GMoE-DCAA consistently outperforms state-of-the-art approaches, validating its effectiveness and generalizability.}
}
@article{LAI2026116244,
title = {RS-MoE: Coupled expert compression via activation-peak guided collaborative decomposition},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116244},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116244},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009706},
author = {Jiajun Lai and Shijie Li and Haoqin Li and Ying Xue and Huaiguang Jiang},
keywords = {Mixture-of-experts, Model compression, Low-rank approximation, Mutual information, Ridge regression},
abstract = {Mixture-of-Experts (MoE) based Large Language Models (LLMs), despite their computational efficiency, still face substantial storage and memory overhead, which limits their deployment on edge devices. However, existing methods primarily focus on compressing at the granularity of experts, resulting in the loss of specialized knowledge. To address these challenges, we propose a new framework termed RS-MoE, which reduces storage and memory footprint while preserving model performance by collaboratively splitting the weights of each expert into (i) a sparse set of high-importance dimensions kept in full precision to retain expert-specific knowledge and (ii) a low-rank factorization for the remaining dimensions to remove redundancy. Building on this, we develop a comprehensive importance score based on activation peaks to apply a tailored policy: high-importance dimensions are preserved as sparse components, while the remaining dimensions are approximated using a low-rank representation. Additionally, ridge regression and mutual information techniques are incorporated to further minimize errors. We performed a comprehensive evaluation of RS-MoE on several MoE LLMs, including DeepSeekMoE-16B-Base, Mixtral-8x7B, and Qwen3-30B-A3B. The results demonstrate that RS-MoE matches or outperforms existing state-of-the-art methods at the same compression ratio, while preserving expert specialization, substantially reducing storage and memory footprint, and introducing only limited inference overhead. Codes are available at https://github.com/ALittlething/RS-MoE.}
}
@article{YIN2026116493,
title = {PersonalHealthChain: Vitality-aware consensus and knowledge-graph-based semantic disclosure for decentralized health data sovereignty},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116493},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116493},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012190},
author = {Li Yin and Yanqi Cheng and Xuefeng Du and Yuduo Zheng and Fengqi Li},
keywords = {Internet of medical things, Blockchain, Knowledge graph, Privacy-preserving computing},
abstract = {Personal health data are increasingly generated by wearables and distributed across heterogeneous clinical systems, yet effective patient sovereignty over storage, sharing, and semantic access remains limited. Existing blockchain-based health data management solutions improve provenance but remain institution-centric, with weak support for wearable participation, encrypted semantic retrieval, and fine-grained disclosure control. This paper presents PersonalHealthChain, a patient-centric framework that integrates M-RAFT, a vitality-aware adaptive consensus protocol for heterogeneous devices, a blockchain–IPFS storage plane for integrity anchoring and encrypted off-chain storage, and a patient-owned Personal Health Knowledge Graph (PHKG) for concept- and time-scoped access. Experiments show that M-RAFT remains within 4%–6% of standard Raft under stable conditions, while achieving up to 51% lower election latency and 102% higher throughput under heterogeneity. Meanwhile, annual ledger growth stays below 16 MB under heavy workloads, and PHKG-based semantic access reduces query latency by 68% and decrypted data volume by 94% compared with file-level access. These results demonstrate the practicality of PersonalHealthChain for secure and patient-controlled health data sharing.}
}
@article{LI2026116460,
title = {Multi-domain fake news detection with synergistic multi-attention},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116460},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116460},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601186X},
author = {Xuefeng Li and Qingfan Zhang and Chensu Zhao and Congrui Zhang and Xiaqiong Fan and Mingzhen Li and Huifang Hou and Tiejun Yang},
keywords = {Multimodal fake news detection, Domain generalization, Cross-modal alignment, Dynamic frequency fusion, Attention mechanism},
abstract = {Currently, existing single-domain and single-modality fake news detection methods fall short of meeting the performance requirements of real-world applications. However, existing multi-domain multimodal models still struggle with semantic misalignment caused by cross-modal heterogeneity and poor generalization due to significant domain shifts. To tackle these issues, this paper introduces a novel deep learning framework called SMMDFND. Central to this framework are two innovative fusion mechanisms designed to bridge these gaps. First, we propose the Cross-Modal Synergistic Attention (CMSA) module, which mitigates modal heterogeneity by enabling deep, multi-granular interaction between textual and visual features. Second, to address domain generalization, we introduce the Dynamic Frequency Feature Fusion (DFF) module. Drawing on the concept of frequency in signal processing, DFF treats instance-level multimodal details as "high-frequency" components and categorical domain priors as "low-frequency" components. It then adaptively fuses these streams to balance local evidence with global context. Comprehensive experiments on the widely adopted public benchmark dataset Weibo21 demonstrate that the proposed SMMDFND substantially outperforms existing state-of-the-art methods across multiple evaluation metrics. The source code for this study is publicly available at https://anonymous.4open.science/r/SMMDFND-241C.}
}
@article{CHEN2026116465,
title = {MGBT-MO: A distance-free multi-granularity evolutionary algorithm via granular-ball transfer for multimodal optimization},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116465},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116465},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011913},
author = {De-Gang Chen and Shuyin Xia and Bin Hou and Jiancu Chen},
keywords = {Multi-granularity, Granular-ball, Evolutionary algorithm, Multimodal optimization problem, Heuristic search},
abstract = {Multimodal optimization problems (MMOPs) are a challenging and important class of tasks that aim to locate multiple global optima simultaneously, providing decision-makers with diverse solution choices. Although many auxiliary techniques have been developed to help evolutionary algorithms identify as many optima as possible, most rely on purely fine-grained search, making them prone to converging to a single optimum and often resulting in slow convergence. To efficiently locate multiple optima, we propose a novel multi-granularity optimizer via granular-ball transfer, termed MGBT-MO. First, the evolutionary granular-ball is redefined as the basic computational unit, replacing point individuals, with its size encoding different granularity levels. MGBT-MO then performs iterative optimization driven by granular-ball transfer, inspired by the “global-first” principle of human cognition. Each evolutionary granular-ball adaptively updates its position and radius, enabling coarse exploration in the early stage and progressively finer exploitation. During this process, granular-balls transfer independently across areas, promoting search diversity while still allowing cooperation and competition toward the same objective. In addition, a multimodal archiving strategy is employed to manage multiple solutions, together with a region-aware restart operation that reallocates evaluations to balance exploration, exploitation, and computational cost, thereby enhancing the identification and refinement of multiple optima. Experimental results on the widely recognized CEC2013 benchmark demonstrate that MGBT-MO effectively solves MMOPs and achieves more comprehensive and superior optimization performance compared with several representative and state-of-the-art multimodal algorithms.}
}
@article{DONG2026116526,
title = {Beyond symmetric propagation: Modeling asymmetric node influences in multi-view learning},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116526},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116526},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012529},
author = {Hongyang Dong and Hongzhi He and Yilin Wu and Weihong Lin and Jiayuan Wang and Chunming Wu and Yiqing Shi and Shiping Wang},
keywords = {Multi-view learning, Graph neural networks, Attention mechanism, Feature fusion, Graph structure learning},
abstract = {Multi-view learning effectively integrates complementary information from diverse sources to achieve a global representation. Although graph neural networks have become a common approach for modeling complex relationships within and between views, their local aggregation mechanisms limit their ability to capture long-range dependencies. Simply increasing network depth often leads to feature dilution and reduced discriminative ability, while global self-attention mechanisms are prone to introducing spurious correlations and noise. Furthermore, existing methods typically assume information propagation is symmetric, overlooking the heterogeneity of interactions between nodes. To address these challenges, we propose a hierarchical communication mechanism. This framework employs a multi-order topology-aware mechanism to map neighborhood structures across different scales into independent attention subspaces, capturing global context without deep stacking. Moreover, a bidirectional propagation module is incorporated to organize information flows in opposite directions and extract direction-separated structural representations. Building upon this structural decomposition, the propagation matrix is further extended to a learnable asymmetric form, enabling the propagation strengths in different directions to be adaptively optimized under task supervision. Extensive experiments on various benchmark datasets demonstrate the effectiveness and superiority of the proposed methods over state-of-the-art baselines.}
}
@article{TOMAL2026116473,
title = {Distill-FusionNet: Lightweight and interpretable deep learning for cross-domain lung cancer diagnosis},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116473},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116473},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011998},
author = {Md Talat Mahmud Tomal and Mohammad Junayed Hasan and Zahrul Jannat Peya and Nurzahan Akter Joly and M.R.C. Mahdy},
keywords = {Computer-aided diagnosis, Deep learning, Edge computing, Explainable AI, Knowledge distillation, Lung cancer detection, Medical image analysis},
abstract = {Early and accurate lung cancer detection remains critical yet challenging in real-world clinical environments where deep learning models are limited by high computational demands, poor cross-domain generalizability, and lack of interpretability. To address this problem setting, this study presents Distill-FusionNet, a deployment-oriented framework that jointly integrates heterogeneous dataset aggregation, task-specific knowledge distillation, and Grad-CAM++-based interpretation within a unified binary lung cancer classifier. The methodological contribution lies in combining these components for a setting that prior studies have typically addressed only partially, namely cross-domain classification across CT and histopathology sources under strict model-size constraints. More specifically, the framework aggregates four heterogeneous datasets to reduce single-source bias, transfers diagnostic information from an EfficientNet-B0 teacher to a compact 105K-parameter student CNN, and verifies that the distilled model preserves clinically relevant attention patterns after compression. Under the selected evaluation protocol, the distilled CNN attains 99.58% unseen-test accuracy, 99.60% sensitivity, and 99.55% specificity, while the selected validation configuration preserves 99.92% AUC. Additional component-wise ablation, CT cross-dataset exclusion, specialist review, and prototype deployment analyses strengthen the evidence that the final system is not only accurate, but also robust, interpretable, and practically deployable. Taken together, the findings indicate that the proposed system design can support efficient and interpretable lung cancer screening models under heterogeneous imaging conditions. Code and implementation details are publicly available at: https://github.com/talatmcc/advanced-lung-cancer-detection.}
}
@article{CHEN2026116494,
title = {Spatial Hubness Alignment: Reducing hubness in graph few-shot learning},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116494},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116494},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012207},
author = {Liangzhe Chen and Nan Fu and Sisi Shao},
keywords = {Few-shot learning, Graph Neural Networks, Graph Representation, Node classification},
abstract = {Graph Few-Shot Learning (GFSL) remains highly challenging under extremely limited supervision, often leading to degenerated representation geometry. In particular, a pronounced hubness phenomenon arises, where a few samples frequently appear as nearest neighbors of many others, resulting in biased representations and blurred class boundaries. Existing GFSL methods, typically based on conventional GNN message passing, tend to amplify centrality-driven feature concentration, especially in data-scarce scenarios. To address this issue, we propose Spatial Hubness Alignment (SHA), a geometry-aware framework that reformulates message propagation via an anchor-guided relative feature updating mechanism. Specifically, node representations are updated using pairwise relative feature differences, while learnable spatial anchors act as soft prompts to regulate information flow. This design suppresses redundant updates among similar nodes and promotes a more balanced embedding distribution, thereby mitigating hubness. Furthermore, we introduce an alignment loss that minimizes the KL divergence between normalized original features and learned embeddings. We show that this objective decomposes into uniformity and structural similarity terms, encouraging hyperspherical dispersion while preserving local structure. Experiments on five benchmark datasets demonstrate that SHA consistently reduces hubness and achieves state-of-the-art performance.}
}
@article{HAN2026116295,
title = {A multi-scale adaptive graph convolution approach to multivariate time series forecasting},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116295},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116295},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601021X},
author = {Xiao Han and Zhisong Pan and Chengcheng Xu and Weiwen Wang},
keywords = {Multivariate Time Series forecasting, Multi-scale patching, Dual temporal attention, Adaptive graph convolution},
abstract = {Multivariate Time Series (MTS) forecasting is widely used in fields such as transportation planning and weather prediction, yet it remains highly challenging due to the complex and intertwined dependencies within the data. While many existing approaches attempt to capture these dependencies by modeling both intra-series and inter-series correlations simultaneously, they often overlook the multi-scale nature of real-world time series, where distinct dependency patterns may emerge across different temporal resolutions. Most current methods operate only at limited or fixed scales, which restricts their ability to capture features across multiple temporal granularities. To overcome these limitations, we propose AGCNet, a novel multi-scale framework with adaptive pathways that leverages temporal decomposition and adaptive graph convolution to capture scale-specific inter-series dependencies. Specifically, AGCNet first applies seasonal-trend decomposition to isolate periodic and trend components, which then guide the selection of appropriate patch sizes. The time series is then partitioned into patches of varying sizes, yielding multiple temporal resolutions. Each patch is processed using dual-level temporal attention (intra-patch and inter-patch) to capture both local details and global contextual dependencies. Furthermore, AGCNet incorporates an adaptive mix-hop graph convolution layer that autonomously learns inter-series relationships specific to each temporal scale. Extensive experiments on multiple real-world datasets show that AGCNet achieves significant improvements over baseline models.}
}
@article{ZHANG2026116457,
title = {CAS-DistillCS: Confidence-aware self-distillation for self-supervised compressed sensing},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116457},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116457},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011834},
author = {Yiteng Zhang and Yufeng Zhou and Hanyu Jiang and Hui Wang},
keywords = {Compressed sensing, Self-supervised learning, Self-distillation, Confidence-aware, Deep unfolding network},
abstract = {Compressed sensing (CS) aims to achieve high-quality signal reconstruction from measurements acquired at sampling rates far below the Nyquist limit, while the reconstruction process is inherently a severely ill-posed inverse problem. In recent years, deep unfolding networks have achieved remarkable progress in CS reconstruction; however, most existing approaches heavily rely on paired supervised data, which are often difficult to obtain in real-world scenarios. To address this challenge, we propose CAS-DistillCS, a confidence-aware self-distillation framework for self-supervised compressed sensing. The proposed framework explicitly models the prediction confidence of pseudo-labels during self-supervised learning and adaptively weights the distillation signals, thereby effectively mitigating performance degradation and training instability caused by unreliable supervision. Furthermore, we introduce a physically guided deep unfolding network based on gradient-injected proximal gradient descent (GIPGD), which explicitly incorporates gradient information derived from the data fidelity term into the unfolding architecture to guide the learnable proximal mapping toward better alignment with the underlying optimization model. This design improves reconstruction accuracy, convergence stability, and robustness while preserving model interpretability. Extensive experimental results demonstrate that the proposed method consistently outperforms existing self-supervised compressed sensing approaches under various sampling ratios and noise conditions, achieving an average PSNR improvement of 0.145 dB over the latest self-supervised methods across four benchmark datasets, while also exhibiting competitive reconstruction performance compared to several supervised methods. The code will be released upon acceptance of this paper.}
}
@article{HUANG2026116445,
title = {A self-adaptive top token transformer for gastrointestinal endoscopy image restoration},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116445},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116445},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011718},
author = {Yuxi Huang and Yushan Chen and Hui Lin and Mingzhen Yang and Xi Zheng and Yi Wu and Kunping Yang},
keywords = {Gastrointestinal endoscopy image, Image restoration, Transformer mechanism, Top token selection},
abstract = {Gastrointestinal endoscopy image analysis has attracted significant research attention due to its potential to support the diagnosis of gastrointestinal cancers—one of the most lethal malignancies globally. However, research on the restoration of gastrointestinal endoscopy images, such as denoising and super-resolution, remains limited, restricting their practical use with low-quality data. To bridge this gap, this paper presents a comprehensive benchmark for gastrointestinal endoscopy image restoration, built upon four datasets. Inspired by real clinical requirements, we propose a Self-adaptive Top-K Token Transformer (ST3-Former) to address restoration challenges. First, we establish a benchmark consisting of four Gastrointestinal Image Restoration Datasets (GIRDs), including high-resolution images, low-resolution images, images corrupted by noise, and images with real-world degradations. Second, we introduce a Spatial-Frequency Token Selection (SF-TS) mechanism, dynamically adapting the token numbers according to image content in the spatial and frequency domains for the information fusion. Third, we propose a Real-Imaginary Splitting Modulation (RI-SM) module that separately modulates real and imaginary information in the frequency domain, facilitating more precise attention map generation. By systematically investigating token selection strategies for image restoration tasks, we conduct extensive experiments on all four GIRD datasets. The results validate that our ST3-Former outperforms state-of-the-art methods across all datasets, achieving consistent gains of up to 2.73 dB in PSNR and 0.32 in SSIM. Paired t-tests confirm the improvements are statistically significant (p<0.01/0.001), highlighting its promise for real-world applications. The datasets in this work are available online at https://github.com/Kunpingyang1992/ST3-Former, and the codes will be released in the future.}
}
@article{LI2026116437,
title = {Cross-modal Prompt Enhanced Hypergraph Mixture-of-Experts for Multimodal Emotion Recognition in Conversations},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116437},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116437},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011639},
author = {Xiaokang Li and Guihua Wen and Zengqiang Peng and Shijun Zhang and Ting Xiang and Chuyun Chen and Qufei Zhang},
keywords = {Multi-modal emotion recognition, Multi-relational hypergraph, Cross-modal prompt, Mixture-of-experts},
abstract = {Multimodal Emotion Recognition in Conversations (MERC) aims to identify the emotion of each utterance in a dialogue by jointly modeling multimodal expressions and conversational context. Existing methods still face two major challenges. First, most multimodal fusion methods usually rely on direct interaction over raw utterance features, which may propagate noisy or unreliable information across modalities and thus limit stable modality complementarity, especially for weak or ambiguous modalities. Second, conversational emotion understanding requires modeling multiple types of dependencies, including cross-modal interactions, speaker-specific patterns, and temporal dynamics, while existing methods often fail to disentangle these heterogeneous relations in a unified framework. To address these issues, we propose a novel Cross-modal Prompt Enhanced Hypergraph Mixture-of-Experts framework for MERC, named CPHME. Specifically, we design a cross-modal prompt enhancement module, which distills modality-specific semantics into compact prototypes as global prompts and further incorporates local contextual cues to enhance utterance representations through cross-modal knowledge injection. In this way, weak or noisy modalities can benefit from complementary information provided by stronger modalities, leading to more discriminative multimodal representations. We then construct a multi-relational hypergraph to explicitly model cross-modal, speaker-level, and temporal dependencies in conversations. Finally, we introduce a Hypergraph Mixture-of-Experts (HyMoE), which assigns a specialized expert to each relation type and employs a structure-aware gating mechanism to adaptively fuse expert outputs for emotion reasoning. Experimental results on benchmark datasets show that our approach consistently outperforms strong baselines, demonstrating the effectiveness of the proposed prompt-based representation enhancement and hypergraph expert reasoning framework.}
}
@article{BAI2026116409,
title = {Memory-guided diffusion framework for pose-based Video Anomaly Detection},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116409},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116409},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011354},
author = {Xiaofeng Bai and Yue Hou and Chenshuai Bai},
keywords = {Video anomaly detection, Memory-augmented diffusion framework, External memory module, Non-Markovian diffusion, Adaptive spatio-temporal encoder},
abstract = {Video Anomaly Detection (VAD) aims to identify events that deviate from normal behavior patterns in video sequences. Due to the scarcity of abnormal samples and the difficulty of exhaustiveness, the existing methods usually only use normal data for training, and realize anomaly detection through reconstruction error or prediction error. However, it is often difficult for such methods to fully characterize the multimodality and uncertainty of normal behavior dynamics in real open scenes. To this end, this paper proposes a Memory-Augmented Diffusion (MemDiff) framework for multimodal motion anomaly detection, which learns the dynamic distribution of normal motion from the perspective of generative modeling, and realizes anomaly detection by evaluating the consistency between the generated future and the real observation. The framework consists of three mutually collaborative components. First, a differentiable external memory module is designed to construct a compact prototype library of normal motion patterns through sparsity constraints and contrastive learning, enabling explicit storage and retrieval of representative motion prototypes. Second, a memory-guided non-Markovian diffusion generation process is proposed, in which retrieved motion prototypes are used as conditional priors to generate future motion sequences; by introducing a temporally correlated diffusion transition mechanism, the process can produce motion trajectories with stronger temporal coherence. Finally, an adaptive spatio-temporal encoder is constructed to model the time-varying spatial structures and dynamic dependencies among skeletal joints. Through the cooperation of these components, MemDiff is able to model normal motion dynamics via conditional generation and detect anomalies by measuring the statistical inconsistency between generated results and real observations. Experimental results on the UBnormal, HR-STC, and HR-Avenue datasets demonstrate that the proposed method achieves competitive performance and robustness.}
}
@article{YANG2026116461,
title = {Underwater image enhancement with frequency-spatial cross-domain transformer and hybrid collaborative representation},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116461},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116461},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011871},
author = {Jing Yang and Wenhan Zhu and Shuo Yang and Fengling Jiang and Amir Hussain},
keywords = {Frequency-spatial feature extraction, Cross-domain transformer, Hybrid collaborative representation, Underwater image enhancement},
abstract = {Underwater image enhancement is a pivotal technique for marine exploration and engineering. However, underwater images often suffer from severe degradation caused by wavelength-dependent attenuation, scattering, and refraction, which pose considerable challenges to existing methods. To address this issue, we propose a model that integrates a frequency-spatial cross-domain transformer and hybrid collaborative representation for underwater image enhancement. First, by introducing the frequency dimension, a cross-domain transformer equipped with an efficient feature interaction mechanism is designed. It simultaneously integrates spatial-domain and frequency-domain information to enrich feature representation and improve feature utilization efficiency via a fusion attention mechanism. Second, a hybrid frequency-spatial feature extraction block, which combines the cross-domain transformer with a feature attention block, is constructed as a dual-branch structure to concurrently capture global structures and local details. This enables a transition from single-domain feature modeling to cross-domain complementary feature representation. Third, a two-stage hybrid collaborative representation block is proposed. By facilitating refined interaction and fusion of global structures and local details, it achieves adaptive and dynamic feature collaboration, effectively suppressing noise, enhancing texture details, and correcting color casts. Experiments on five public datasets demonstrate that our approach outperforms state-of-the-art methods in both quantitative metrics and subjective visual perception, with an average relative PSNR improvement of 2.932%, highlighting its exceptional learning and generalization capabilities. Furthermore, its outstanding performance in advanced downstream tasks, including underwater target detection, salient object detection, and atmospherically degraded image enhancement, further validates its practical value and application potential in real-world marine engineering scenarios.}
}
@article{LU2026116501,
title = {Driver EEG fatigue recognition based on matrix recovery and vision transformer},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116501},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116501},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601227X},
author = {Boyang Lu and Yuanhua Qiao and Xuyan Jiang and Lijuan Duan},
keywords = {EEG, Matrix recovery, Frequency attention, Vision transformer},
abstract = {Driver fatigue is a critical factor affecting road safety. Electroencephalogram (EEG) technology presents great potential in accurately monitoring driver fatigue status. In this paper, a fatigue classification model is proposed using a vision transformer (ViT) with integrated frequency attention mechanism. Firstly, the coherence features based on power spectral density (PSD) are expressed using the augmented Lagrangian method for low rank representation, and the L2,1 norm is used to enhance the robustness of the model. Then, a frequency attention module is proposed to effectively extract key frequency bands from the recovered data,improving the sensitivity and specificity of related biomarkers. Finally, the features are input into the ViT for classification. To overcome the problem of data imbalance, synthetic minority over-sampling technique (SMOTE) is used in the training process. The accuracy of this model in the SEED-VIG and SADT fatigue datasets reach 98.44% and 98.14%, respectively, which not only outperform other method but also demonstrate the excellence of ViT in fatigue recognition.}
}
@article{SHAHAD2026116433,
title = {Enhancing model adaptability and transparency: i-MAAR algorithm for non-stationary streaming data analysis},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116433},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116433},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011597},
author = {Palathingal Shahad and Ebin Deni Raj},
keywords = {Non-stationary data, Streaming data analysis, Concept drift, Model adaptations, Interpretability, Ablation study},
abstract = {An interpretable Multi-window and AutoML-based Adaptable Regression (i-MAAR) algorithm is proposed for analyzing fast-moving, non-stationary streaming data. This algorithm addresses key challenges in streaming data analysis, including reliability, low-latency response, computational efficiency, storage constraints, and concept drift. By maintaining multiple data windows, i-MAAR enables efficient model training and retraining while supporting timely and accurate detection of concept drift, thereby ensuring stable and reliable predictive performance. To adapt to evolving data patterns, detected drift serves as a trigger to assess performance degradation and activate an AutoML-based model adaptation strategy. Interpretability is incorporated through SHAP-based explanations, which enhance transparency by identifying feature-level contributions to prediction errors and guiding informed adaptation decisions. The framework operates asynchronously to support continuous forecasting and model updates while optimizing computational and memory resources. An ablation study is conducted to quantify the contribution of individual components to overall system performance. Experimental results across multiple datasets demonstrate that i-MAAR provides a balanced trade-off among interpretability, low-latency inference, resource-constrained adaptation, and performance stability, establishing it as a robust and efficient solution for real-time streaming data analysis.}
}
@article{SUN2026116506,
title = {DSW-Net: A dual-skip connection wavelet network for underwater image enhancement},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116506},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116506},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012323},
author = {Hui Sun and Xin Shu and Qiang Qian and Changbin Shao and Zhibin Xie},
keywords = {Underwater image enhancement, Wavelet transform, Feature decoupling, Dual-skip connection, Hybrid-domain attention},
abstract = {Underwater images commonly exhibit severe colour distortion, low contrast and blurred texture details because of the wavelength-selective absorption and scattering of light in water. Existing convolutional neural network-based approaches, particularly those using U-shaped architectures, often suffer from feature entanglement in underwater image enhancement. In particular, conventional pooling operations irreversibly blend low-frequency global structures with high-frequency local details, causing the decoder to compromise texture details while correcting colour casts. To address this limitation, we developed a dual-skip wavelet network (DSW-Net). Integrating the wavelet transform, we built a wavelet encoder module to achieve explicit feature decoupling across frequency bands. We introduced a dual-skip connection mechanism, which combined with a context-guided detail refinement block, leveraged semantic context priors to adaptively suppress noise and enhance fine textures. A hybrid-domain attention module was incorporated to synergistically aggregate spatial- and frequency-domain features, capturing global degradation characteristics effectively. Extensive experiments conducted on multiple benchmark datasets demonstrated that DSW-Net exhibited strong competitiveness in full-reference and non-reference image quality assessments. The proposed method also showed clear advantages in colour correction and detail preservation over existing state-of-the-art approaches. The code is available at https://github.com/ssssh-cv/DSWNet.}
}
@article{TIAN2026116453,
title = {A counterfactual intervention framework for out-of-distribution generalization in imitation learning},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116453},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116453},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011792},
author = {Lili Tian and Dehui Du and Jingwen Wang and Xingzhe Sun},
keywords = {Causal mining, Imitation learning, Out-of-distribution generalization, Counterfactual inference},
abstract = {Out-of-distribution (OOD) generalization is critical for deploying imitation learning (IL) in real-world environments, where the real-world environment often differs substantially from the training distribution. Although IL can learn effective policies from expert demonstrations in a fixed setting, its performance typically degrades under training-to-deployment distribution shifts, which limits practical applicability in actual environments. To address this challenge, we propose CGIL, an intervention-based counterfactual framework for IL. Unlike correlation-based counterfactual approaches, CGIL constructs a causal model that integrates explicit interventions, unobserved variables, and neural function approximation to better capture underlying decision mechanisms under distribution shifts, thereby improving OOD generalization in real-world deployment. We further develop a counterfactual data augmentation procedure with three augmentation strategies and provide a case study on lane-changing and overtaking in autonomous driving to illustrate how CGIL is instantiated. Experiments across multiple IL algorithms and datasets demonstrate that CGIL consistently improves OOD generalization, achieving higher mean and worst-case accuracy while reducing accuracy variance.}
}
@article{LIU2026116474,
title = {Modeling latent cross-modal interaction for reliability-aware entity alignment in multimodal relation extraction},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116474},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116474},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012001},
author = {Xiyang Liu and Chunming Hu and Richong Zhang and Junfan Chen and Baowen Xu},
keywords = {Information extraction, Multimodal relation extraction, Cross-modal entity alignment, Multimodal large language model},
abstract = {Multimodal relation extraction aims to exploit the complementary contextual information across modalities to identify semantic relationships between entities. While prior works have achieved promising results by applying various alignment strategies to enhance cross-modal fusion, their effectiveness remains constrained by the absence of entity-centric alignment annotations. Recently developed region-level multimodal large language models (MLLMs) show potential as automated data annotators capable of providing diverse cross-modal alignment labels. However, MLLMs can produce unreliable grounding outputs, especially when processing an unfamiliar entity in ambiguous context. To address this limitation, we propose a latent cross-modal information interaction modeling framework to acquire entity alignment annotations with quantified reliability scores. Our approach introduces token-wise weight backtracking equipped with logit-guided causal attention aggregation to learn input–output dependencies. Sequence-level evidence detection subsequently analyzes parametric alignment cues to derive validated cross-modal entity mappings. Lightweight task model is adaptively optimized with learned alignment supervision to enhance its ability to bridge modality gaps. Empirical studies show that our reliability-aware alignment annotations significantly improve performance on multimodal relation extraction tasks. The source code is available at https://github.com/liuxiyang641/LCIM.}
}
@article{ZHENG2026116425,
title = {MPQD-ADM: High-efficiency adversarial patch defense method based on mixed pixel quality differences},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116425},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116425},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011512},
author = {Wenlong Zheng and Yuhao Zhang and Heng Zhang and Peng Li and He Xu},
keywords = {Object detection, Adversarial patch defense, Patch-agnostic, Attack detection},
abstract = {Object detection plays a vital role in many safety-critical systems. However, easily implemented adversarial patch attacks in the physical world significantly threaten current state-of-the-art object detectors. Therefore, it is crucial to develop robust defense methods against patch attacks. However, there is a significant lack of research in this area. To this end, this paper proposes a novel defense method, MPQD-ADM, that aims to improve the robustness of object detectors against adversarial patch attacks. The core advantage of MPQD-ADM lies in its patch-agnostic design and high defense efficiency: it can detect and block the entire adversarial patch without any pre-training, even when the patch’s shape, size, and location are unknown. Specifically, we propose an adversarial region detection method that identifies potential object-detection regions in the input image that may be hidden by adversarial patches. Next, we propose an adversarial source localization method based on mixed-pixel quality difference analysis, combining discrete cosine transform (DCT) frequency-domain analysis with wavelet transform multi-resolution enhancement to rapidly and accurately pinpoint the location of adversarial patches. Finally, the adversarial patches are effectively removed using a patch location mask, ensuring the object detector correctly recognizes the processed image. Experimental results demonstrate that MPQD-ADM significantly enhances detector robustness compared to existing state-of-the-art methods. Compared to the baseline optimal method, mean average precision (mAP) improves by 6.27%, and defense success rate (DSR) increases by 7.73%. Additionally, MPQD-ADM exhibits low computational overhead, making it well-suited for real-time detection tasks.}
}
@article{PARIKH2026116449,
title = {Multimodal glaucoma classification using segmentation based biomarker extraction},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116449},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116449},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011755},
author = {Rahil Parikh and Van Nguyen and Anita Penkova},
keywords = {Glaucoma detection, Clinical glaucoma biomarkers, Fundus images, Multimodal deep learning, Vision transformers},
abstract = {Glaucoma is a progressive eye disease that leads to irreversible vision loss and, if not addressed promptly, can result in blindness. While various treatment options such as eye drops, oral medications, and surgical interventions exist, the disease may still progress. Therefore, early detection and diagnosis can mitigate the devastating vision loss of glaucoma. The primary focus of the proposed study is the development of a robust pipeline for the efficient extraction of quantifiable data from fundus images. What sets our approach apart from other approaches is the emphasis on automated feature extraction of glaucoma biomarkers from particular regions of interest (ROI) along with the utilization of a weighted average of image features and clinical measurements. Our unique approach leverages segmentation based models in conjunction with computer vision techniques to efficiently extract and compute clinical glaucoma biomarkers such as optic disc area and optic cup to disc ratio. The extracted biomarkers are consistent with trends observed in clinical practice, thus supporting the validity of the feature extraction approach. While subtle disease progression, inconsistencies in image quality and a general lack of metadata impact classification performance, the weighted combination of image based features with glaucoma biomarkers achieves a test accuracy of 92.63% for glaucoma classification, successfully addressing the limitations of traditional single-modality approaches such as fundus imaging and optical coherence tomography (OCT).}
}
@article{WANG2026116478,
title = {Multi-scale semantics meet SE(3) geometry: A sequence-aware hierarchical VLA for long-horizon manipulation},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116478},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116478},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012049},
author = {Zhitao Wang and Jiangtao Wen and Roberto Horowitz and Yanke Wang and Yuxing Han},
keywords = {Vision-Language-Action (VLA) models, SE(3)-equivariance, Diffusion models, Sequential manipulation, Hierarchical language grounding, Geometric deep learning},
abstract = {Robotic manipulation in unstructured environments such as construction sites requires agents to balance task-level planning and millimeter-level geometric precision at the same time. However, existing Vision-Language-Action (VLA) models often struggle to handle these two distinct scales, and geometric diffusion models typically lack the semantic guidance needed for sequential decision-making. To address these challenges, we propose the Sequence-Aware Hierarchical VLA (SA-HVLA), a unified generative framework for high-precision sequential tasks, with multi-mode rebar tying as a stringent real-world testbed. Our method introduces two contributions: (i) a hierarchical language grounding mechanism that decouples textual instructions into global task directive and then local node specification; and (ii) a history-conditioned SE(3)-equivariant diffusion backbone that integrates sequence-aware semantic features through invariant modulation, which preserves geometric consistency across long horizons and reduces the demonstration data requirement. Experiments in both simulation and real-world settings show that our hierarchical architecture reduces the geodesic pose error by roughly 70% compared with single-resolution baselines in noisy physical environments. The SE(3)-equivariant formulation also remains robust, with only 7.1% error variance under a 180° viewpoint change. In addition, the model mitigates the error accumulation in multi-node sequential tying tasks and maintains high success rates where memoryless baselines fail.}
}
@article{LIU2026116441,
title = {Mosaic: Data-free knowledge distillation via mixture-of-experts for heterogeneous distributed environments},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116441},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116441},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011676},
author = {Junming Liu and Yanting Gao and Yuqi Li and Siyuan Meng and Yifei Sun and Aoqi Wu and Yirong Chen and Ding Wang and Shiping Wen},
keywords = {Federated learning, Data-free knowledge distillation, Mixture of experts, Generative models},
abstract = {Federated Learning (FL) is a decentralized machine learning paradigm that enables clients to collaboratively train models while preserving data privacy. However, the coexistence of model and data heterogeneity gives rise to inconsistent representations and divergent optimization dynamics across clients, ultimately hindering robust global performance. To transcend these challenges, we propose Mosaic, a novel data-free knowledge distillation framework tailored for heterogeneous distributed environments. Mosaic first trains local generative models to approximate each client’s personalized distribution, enabling synthetic data generation that safeguards privacy through strict separation from real data. Subsequently, Mosaic forms a Mixture-of-Experts (MoE) from client models based on their specialized knowledge, and distills it into a global model using the generated data. To further enhance the MoE architecture, Mosaic integrates expert predictions via a lightweight meta model trained on a few representative prototypes. Extensive experiments on standard image and multimodal benchmarks demonstrate that Mosaic consistently outperforms state-of-the-art approaches under both model and data heterogeneity. The source code has been published at Github.}
}
@article{WANG2026116514,
title = {FSR-Net: Frequency-selective resonance learning framework for medical image segmentation},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116514},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116514},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012402},
author = {Jiajie Wang and Erdong Yuan and Zhaozhao Su and Gao Huang and Yuxuan Luo and Yining Yang and Liejun Wang},
keywords = {Medical image segmentation, Statistical guided initialization, Semantic-frequency domain collaboration},
abstract = {With the widespread application of frequency domain learning in computer vision, frequency-domain-based models have shown significant potential in medical image segmentation. However, existing methods suffer from two key limitations: First, frequency domain filters often rely on fixed or random initialization, which ignores the significant inter-domain spectral discrepancy. This domain-agnostic initialization fails to capture the unique frequency characteristics of specific datasets, making it difficult to separate lesions from noise in diverse imaging scenarios. Second, the absence of high-level semantic guidance leads to semantic-spectrum misalignment, which inevitably results in multi-scale feature inconsistency. To address these challenges, this paper proposes a novel framework called FSR-Net, which incorporates an initialization strategy based on frequency domain statistical priors. By performing K-means clustering on the Fourier spectra of training samples, this strategy mines domain-specific spectral bases, providing an anatomically informed initialization that effectively facilitates the separation of low-contrast lesions from noise. Furthermore, we design a Semantically Guided Cross-Frequency Attention (SCFA) module. Through a two-stage cross-level calibration, SCFA decouples frequency selection from spatial masking. It utilizes the decoder’s high-level semantics to dynamically recalibrate the encoder’s frequency bands, ensuring that spectral enhancement is spatially and semantically aligned with specific anatomical targets. Extensive experiments on four benchmark datasets (ISIC2018, Kvasir, COVID-19, and MoNuSeg) demonstrate that FSR-Net outperforms state-of-the-art methods, achieving mIoU improvements of 1.41%, 1.76%, 0.86%, and 0.94%, respectively. Code is publicly available at https://github.com/Anonymous-Submission/FSR-Net.}
}
@article{EJIGU2026116413,
title = {FedBUS: A block-wise training approach with global snapshots for efficient and robust federated learning on edge devices},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116413},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116413},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011391},
author = {Girum Fitihamlak Ejigu and Kitae Kim and Yu Qiao and Choong Seon Hong},
keywords = {Federated learning, Communication efficiency, Noisy label learning, Data heterogeneity},
abstract = {Federated learning (FL) faces three intertwined challenges such as high communication overhead, computational constraints on resource-limited edge devices, and label noise arising from decentralized and unreliable data annotation in practical edge deployments. We introduce Federated Block-wise model Update with global Snapshots (FedBUS), a unified framework that addresses these challenges jointly. FedBUS partitions the global model into cohesive layer blocks updated under a principled cyclic schedule, preserving inter-layer dependencies while reducing per-round communication and computation. A global snapshot mechanism stabilizes aggregation by retaining historical model states, tempering the influence of noisy client updates. Federated Symmetric Cross-Entropy (FedSCE) further enhances robustness through FL-aware proximal and cosine similarity regularization that jointly mitigates client drift and label noise. Theoretical analysis establishes convergence of the joint training procedure, with additive bias terms controlled by the snapshot blending weight and the noise rate. Empirically, FedBUS reduces communication and computational costs by 38%–49% relative to full-model update methods, while achieving accuracy competitive with or superior to full-model baselines and consistently outperforming layer-wise partial update strategies. Evaluations span multiple architectures and datasets under synthetic and real-world noisy label conditions, confirming that FedBUS provides a scalable, robust solution for resource-constrained FL deployments under heterogeneous and noisy conditions.}
}
@article{LIAN2026116490,
title = {A population-adaptive decision-support method for ventilator parameter optimization},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116490},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116490},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012165},
author = {Xianhui Lian and Tianliang Hu and Songhua Ma and Dedong Ma},
keywords = {Ventilator parameter optimization, Attention-based long short-term memory network, Transfer learning, Chronic obstructive pulmonary disease},
abstract = {Mechanical ventilators are essential life-support devices for critically ill patients, and appropriate regulation of ventilator parameters is central to effective respiratory support. However, current parameter adjustment in clinical practice remains limited by insufficient intelligence, delayed responses, and suboptimal individualization. Focusing on patients with chronic obstructive pulmonary disease (COPD), this study proposes a population-adaptive decision-support method for ventilator parameter optimization. To evaluate cross-population generalization, data from Caucasian patients in the MIMIC database (n = 134) and East Asian patients from Qilu Hospital of Shandong University (n = 59) were included. Multimodal time-series data were cleaned and fused before modeling. An intelligent ventilator parameter optimization model was developed using an attention-based long short-term memory (LSTM) network with transfer learning and was implemented within a data- and model-driven human–machine collaborative decision-support platform. Ablation experiments showed that the ventilator parameter recommendation model (VPRM) achieved mean absolute errors (MAE) and 95% confidence intervals (CI) of 0.16 (0.15–0.18) cmH2O for positive end-expiratory pressure, 5.80 (5.64–5.92) mL for tidal volume (VT), 2.90 (2.59–3.24) % for fraction of inspired oxygen, and 0.29 (0.27–0.32) insp/min for respiratory rate. The ventilator parameter assessment model (VPAM) similarly improved prediction accuracy for key physiological and ventilation indicators. Compared with base models, both VPRM and VPAM achieve lower MAE across all parameters. Interval predictions showed good calibration, with calibration error and expected calibration error below 0.015. Overall, this study presents a population-adaptive ventilator decision-support method that supports data-driven parameter adjustment, improves decision timeliness, and facilitates individualized ventilator management across different populations.}
}
@article{MADHAVI2026116510,
title = {ST-APCAR: A novel approach to enhance Swin Transformer for leaf disease classification on heterogeneous datasets},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116510},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116510},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012360},
author = { Madhavi and Thipendra P. Singh and Shailendra Pratap Singh},
keywords = {Leaf disease classification, Swin Transformer, Attention norm regularization, Curriculum learning, Adaptive learning, Pathway regularization},
abstract = {The agriculture domain contains various subcategories, and leaf diseases are among the most dominant and impactful challenges. The identification of leaf diseases faces challenges due to its complex disease characteristics, similar appearances among multiple classes, and the sensitivity of models relying on attention mechanisms. In this work, we introduce a Swin Transformer-based learning framework (ST-APCAR) that systematically enhances classification performance through four complementary mechanisms: Adaptive Learning Rate Scheduling, Pathway Regularization, Curriculum Learning, and Attention Norm Regularization. The proposed framework was developed as a coordinated training strategy in which each component addresses a specific weakness of transformer learning, including optimization instability, difficulty in progressive representation learning, unbalanced attention responses, and inefficient feature propagation for leaf disease classification. It investigates the effect of each proposed strategy independently to reveal its contribution to performance improvement and also validates the full ST-APCAR framework on two datasets using a common experimental setting. In the Agriculture Crops dataset, the proposed methods achieve 99.88% accuracy for Adaptive Learning Scheduling, 92.76% for Curriculum Learning, 91.92% for Pathway Regularization, and 92.76% for Attention Norm Regularization. The ST-APCAR architecture performed best with an accuracy of 99.92%. On the PlantDisease dataset, the models based on Adaptive Learning Scheduling, Curriculum Learning, Pathway Regularization, and Attention Norm Regularization achieve accuracy of 99.89%, 94.93%, 93.52%, and 96.92%, respectively. The ST-APCAR framework achieved 99.93% accuracy. Further, the superpixel-based score-drop analysis and Local Interpretable Model-agnostic Explanations (LIME) were used to analyze model predictions. These techniques highlight supporting and counter-evidence regions that drive classification decisions, and also provide both qualitative visualization and faithfulness assessment. The findings show that each proposed component improves the Swin Transformer, while their unified integration provides the most effective and consistent performance for leaf disease classification.}
}
@article{SUN2026116421,
title = {Hierarchical feature fusion and recurrent refinement for anomaly detection},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116421},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116421},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011470},
author = {Qike Sun and Qiang Guo},
keywords = {Anomaly detection, Feature fusion, Recurrent refinement, Image reconstruction},
abstract = {Anomaly detection is a critical task in industrial manufacturing, aiming to detect anomalous regions in product images. A commonly-used approach for this task is to reconstruct anomaly-free images from anomaly ones and compute the difference between them to discriminate anomalies. In this reconstruction-discrimination process, reconstruction quality directly influences discrimination performance. Meanwhile, simple discrimination strategy like thresholding the difference cannot fully utilize the reconstructed anomaly-free images. To address these issues, we propose a two-stage network for anomaly detection, which mainly consists of a hierarchical feature fusion reconstruction sub-network and a recurrent refinement discrimination sub-network. In the reconstruction sub-network, to improve reconstruction quality, hierarchical feature fusion is achieved by integrating two key functional blocks: channel fusion convolution block and multi-scale feature fusion block. They are designed for intra- and inter-level feature fusion, respectively. In the discrimination sub-network, two recurrent refinement decoders are introduced to improve the discrimination accuracy. Moreover, a smooth score module is proposed to further improve the overall performance. Extensive experimental results on MVTec AD and VisA (i.e., two anomaly detection datasets) demonstrate that our network achieves better performance with fewer parameters and FLOPs compared to some recent methods.}
}
@article{WU2026116482,
title = {Learning-free continuous-attribute graph embedding via locality-sensitive hashing},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116482},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116482},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012086},
author = {Wei Wu and Yan Peng and Ling Chen and Xuan Tan and Jiongrui Yang and Zhenzhong Wang and Fangfang Li and Chuan Luo},
keywords = {Graph Neural Networks, Graph embedding, Continuous-attribute graphs, Hash kernels, Locality-sensitive hashing},
abstract = {Graph embedding represents each graph in a low-dimensional space with similarity between graph pairs preserved. While the mainstream Graph Neural Networks (GNNs) achieve strong performance, they pose significant computational challenges and predominantly focus on discrete-attribute graphs. In this paper, we propose #WLS, a learning-free continuous-attribute graph embedding model that keeps a good trade-off between accuracy and efficiency by employing Locality-Sensitive Hashing (LSH) to preserve high-order node similarity. Experimental results on seven real-world datasets (405 to 41,127 graphs) show that #WLS achieves accuracy comparable to representative GNN methods in graph classification (e.g., 80.12% vs. 76.83% on OGBG_MOLHIV) while reducing runtime (up to 27,183× speedups in our experiments) and maintaining a low memory footprint (under 300MB on PROTEINS_full and AIDS). It also outperforms existing LSH-based methods on most datasets. In graph retrieval, #WLS attains MAP scores competitive with GNN methods (e.g., 74.27% vs. 72.25% on PROTEINS_full) and outperforms existing LSH-based methods across the evaluated datasets.}
}
@article{WANG2026116450,
title = {Causal subgraph disentanglement network for out-of-distribution generalization in brain network analysis},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116450},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116450},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011767},
author = {Xiaotong Wang and Yibin Tang and Yuan Gao and Aimin Jiang and Ying Chen},
keywords = {Brain network, Graph neural network, Structural causal model, Graph information bottleneck, Mental disorder diagnosis},
abstract = {Analyzing brain networks via graph neural networks (GNNs) is critical for understanding mental disorders. However, distribution shifts caused by multi-site data aggregation severely hinder model generalization. To address this, we propose the causal subgraph disentanglement network (CSDN). This framework is grounded in a structural causal model to achieve robust out-of-distribution (OOD) generalization. The framework operates by partitioning the brain network into distinct subgraphs. A learnable subgraph selector first decomposes the original graph into a disease-related causal subgraph and a site-specific spurious subgraph. Unlike existing methods that passively handle spurious features, CSDN actively models and constrains them through a dual-path architecture. The causal path learns invariant structures for reliable disease prediction while enforcing site-independence. Concurrently, the spurious path captures site-related variations without contributing to diagnosis. This structural separation is strictly enforced by an improved causal graph information bottleneck (CGIB) objective. These mechanisms actively remove site-specific confounders from causal subgraphs while preventing diagnostic leakage into the spurious path. Experiments on the ABIDE and ADHD200 datasets demonstrate that CSDN outperforms baseline models in OOD test. The identified causal subgraphs provide interpretable biomarkers that align with established neuroscientific findings.}
}
@article{WANG2026116434,
title = {Typical-smoothed truncation for out-of-distribution detection},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116434},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116434},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011603},
author = {Feichao Wang and Rundong He and Weijun Gao and Yilong Yin},
keywords = {Out-of-distribution detection, Low-pass filter, Typical-smoothed truncation},
abstract = {Identification of out-of-distribution (OOD) samples is critical for maintaining the operational integrity of machine learning systems in practical deployments. Existing typical set-based methods, which incorporate some channel information, rely on fixed-threshold truncation for feature correction. Without anomaly-dependent smoothing, a uniform threshold over-suppresses features with weak anomalies while under-constraining those with strong anomalies. Instinctively, features with a higher degree of anomaly significantly affect the final uncertainty estimate and thus require more substantial correction than those with a lower degree of anomaly. A fixed threshold does not handle these differences, leading to suboptimal OOD detection performance. To resolve this restriction, we devised a transformative approach that transforms the fixed threshold truncation into a bidirectional smoothing filter, which attenuates abnormally low and high activations, enhancing the robustness of the activation correction. Specifically, we propose Typical-Smoothed Truncation (TST) method. Firstly, we derive the channel-aware typical set by extracting channel-level statistics of mean and variance from batch normalization(BN) layers and computing their global accumulations. Then, we normalize the channel-aware typical set and smoothly correct the features using a bidirectional low-pass filter. This can make the truncation smoother, prevent feature distortion, and enable corrected features to respond to abnormally high and abnormally low values of different degrees. Finally, we compute the energy score using calibrated features for OOD detection. Experiments confirm that TST substantially exceeds current state-of-the-art (SOTA) methods in performance metrics while exhibiting generalizability across diverse backbone architectures and heterogeneous OOD scoring functions.}
}
@article{ZHANG2026116495,
title = {Toward accurate time series prediction via adaptive compression in Echo State Networks},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116495},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116495},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012219},
author = {Guoliang Zhang and Meijia Li and Sitian Guo and Mingwen Zheng},
keywords = {Echo State Network, Reservoir computing, Compressed sensing, Adaptive compression, Time-series prediction},
abstract = {We propose an Adaptive Compressed Sensing Echo State Network (ACESN), which treats the compression ratio as an online control variable for adaptive capacity scheduling. This formulation addresses a limitation of conventional compressed sensing-based Echo State Networks (CS-ESNs). ACESN keeps the reservoir dynamics unchanged and adapts only the effective state dimension exposed to the readout during inference, guided by recent prediction error and a Lyapunov-inspired proxy of local dynamical complexity. Specifically, the controller expands the exposed dimension when the local regime becomes harder to predict or more unstable, and increases compression when the stream remains easy and stable. Under preset rules, ACESN builds effective states via compressed sampling or nested prefix exposure, where the latter ensures stable dimension switching and cache reuse instead of feature ranking. To make such online adaptation practical and stable, ACESN combines a train-max, infer-adaptive readout with dimension-specific caching, guarded adaptation, and stabilized ratio switching, allowing the exposed dimension to change during inference without retraining the reservoir backbone. Experimental results on one-step-ahead forecasting verify ACESN outperforms fixed-ratio CS-ESNs on 5 out of 7 datasets, and surpasses PCSESN across 4 datasets. It also obtains the lowest MAE on 4 of 6 cases against DeepESN and ICS-DESN. Compared with AdaBoost, MLP and LSTM, ACESN performs better on 7 main datasets in 4 cases. It also outperforms static PCA/SVD methods on 5 datasets. Overall, these results suggest that adaptive capacity scheduling can reduce dependence on manual fixed-ratio selection while remaining stable and competitive.}
}
@article{WANG2026116499,
title = {TAPPS: Learning diverse policies via task-adaptive partial parameter sharing in heterogeneous multi-agent reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116499},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116499},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012256},
author = {Mengke Wang and Han Zhang and Zijian Zhou and Zhenyu Zhang and Xiangfeng Luo and Shaorong Xie},
keywords = {Multi-agent reinforcement learning, Diversity policy, Partial parameter sharing},
abstract = {In cooperative Multi-Agent Reinforcement Learning, centralized training with decentralized execution combines the advantages of independent learning and joint learning. By employing a shared policy network, parameter sharing significantly reduces the number of learnable parameters, enabling scalable joint policy learning. Nevertheless, naive parameter sharing often fails to capture task-specific behaviors, which constrains policy diversity. This limitation becomes especially apparent in heterogeneous systems with agents assigned to distinct roles or subtasks. To address this challenge, we propose TAPPS (Task-Adaptive Partial Parameter Sharing), a novel framework designed to balance training efficiency and policy diversity in heterogeneous MARL. TAPPS introduces a subtask allocator to group agents based on task relevance, a task-guided masking mechanism to selectively activate sub-networks within the shared policy, and a task-weighted experience sampler to decompose team rewards and improve intra-group cooperation. This biologically inspired design encourages the emergence of diverse, task-specialized policies while maintaining a parameter footprint comparable to standard full-sharing methods. Extensive experiments on MPE, LBF, and SMAC demonstrate that TAPPS outperforms existing parameter sharing methods in both policy diversity and overall performance.}
}
@article{DU2026116462,
title = {FG-DiTAD: A Feature Guided Diffusion Transformer for Anomaly Detection},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116462},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116462},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011883},
author = {Minjie Du and Jiawei Zhao and Liang Zhang and Zihan Qin and Lizhe Xie and Yining Hu},
keywords = {Anomaly detection, Reconstruction, Feature Guide Diffusion, Hierarchical Cross-Modulated Guidance},
abstract = {Diffusion models have recently shown remarkable effectiveness in unsupervised anomaly detection, owing to their strong generative capacity and intrinsic ability to model normal data distributions. To address arbitrary and previously unseen anomaly types without relying on anomaly priors, we adopt a reconstruction-based paradigm as our core framework. The proposed FG-DiTAD (Feature Guided Diffusion Transformer for Anomaly Detection) is a diffusion-based framework built upon a linearly stacked Transformer backbone. This design mitigates the inductive biases introduced by U-Net-style architectures, which rely on limited-depth attention and local convolutions. The input image is first encoded into a latent space, perturbed with noise, and then progressively denoised by a Transformer-based reconstruction network. To enhance structural fidelity and semantic consistency, we introduce a homogeneous Feature Guide Network (FGN) that extracts multi-level guidance features from unperturbed input images. These features are injected into the backbone through the proposed Hierarchical Cross-Modulated Guidance (HCMG) modules, enabling geometry-aware and semantically consistent fusion during the denoising process. In addition, FG-DiTAD reduces inference cost compared with existing diffusion-based reconstruction methods. The denoised latent is then decoded into the image space, and the discrepancy between the original and reconstructed images is measured in a pre-trained perceptual feature space for anomaly detection and localization. Extensive experiments on the MVTec-AD and VisA datasets demonstrate that FG-DiTAD achieves state-of-the-art performance among reconstruction-based methods, reaching image-level/pixel-level AUROC of 96.2%/96.3% on MVTec-AD and 88.9%/96.0% on VisA.}
}
@article{VEI2026116523,
title = {KFS-TUNE: Kernel-based Feature Selection for efficiency and accuracy tuning in Time Series Classification},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116523},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116523},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012499},
author = {Sofia Vei and Eleftherios Tiakas and Athena Vakali},
keywords = {Time series classification, Convolutional kernels, Feature selection, Kernel-based learning, Computational efficiency},
abstract = {Time series classification requires methods that achieve strong accuracy while reducing computational cost. KFS-TUNE addresses this challenge by combining convolutional kernels with targeted feature selection, offering substantial benefits like reduced computational complexity and enhanced accuracy. Tested across diverse benchmarks such as the UCR and the UEA Archives, the real-world LifeSnaps dataset and extreme-noise synthetic datasets, KFS-TUNE demonstrates substantial reductions in computation time, such as completing training in just 0.58 min for the ElectricDevices dataset from the UCR Archive, while maintaining competitive accuracy across diverse benchmarks. These results underscore KFS-TUNE’s potential as an accuracy–efficiency baseline for time series classification, supporting both classification quality and real-world applicability.}
}
@article{LIU2026116491,
title = {Cross-modal hyperedge alignment for knowledge graph augmented recommendation},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116491},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116491},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012177},
author = {Yun Liu and Xin Liu and Yijun Duan and Ziqiang Li and Ryutaro Ichise and Akiyoshi Matono and Qiang Ma},
keywords = {Recommender system, Knowledge graph, Hyperedge representation, Contrastive learning, Interaction transfer},
abstract = {Knowledge graph (KG)-enhanced recommender systems have been widely studied for alleviating data sparsity by incorporating rich relational semantics. However, existing KG-based models struggle to effectively model long-tail items due to the lack of reliable user–item supervision, which limits the exploitation of KG knowledge for recommendation. To address these challenges, we propose CHAKG, a cross-modal hyperedge alignment framework that compensates for missing supervision through efficient and selective interaction transfer. CHAKG projects both the KG and the user–item interaction graph into latent hyperedge spaces, enabling lightweight modeling of high-order semantic co-occurrence between interaction-rich items and long-tail items without expensive multi-hop propagation. Building on this representation, CHAKG introduces a consistency-guided interaction transfer mechanism, which selectively transfers reliable signals from interaction-rich items to long-tail items via a learnable denoising process. Furthermore, a cross-modal contrastive alignment objective enforces semantic consistency between knowledge and interaction views, improving robustness and generalization under sparse supervision. Extensive experiments on four benchmark datasets demonstrate that CHAKG achieves state-of-the-art accuracy and efficiency, particularly under cold-start and long-tail recommendation scenarios.}
}
@article{DENG2026116442,
title = {STR-Linear: A linear-based high-performance lightweight model for multivariate time series forecasting},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116442},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116442},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011688},
author = {Weitao Deng and Shaomin Tang},
keywords = {Time series forecasting, Linear-based model, Spatio-temporal modeling, Hybrid-channel modeling, Residual refinement, Lightweight model},
abstract = {The Channel Independent Modeling (CIM) strategy employed by Linear-based time series forecasting models inadequately captures multivariate correlations, resulting in significantly weaker performance compared to Transformer-based models in Multivariate Time Series Forecasting (MTSF) tasks. In this paper, we propose STR-Linear, a lightweight MTSF model with a linear backbone, designed under a “spatial-temporal divide-and-conquer” philosophy. First, we adopt CycleNet—a linear model with explicit cycle decomposition capability—as the temporal backbone to capture long-term trends and periodic patterns within each channel. Subsequently, to compensate for the lack of spatial modeling inherent in linear mappings, we innovatively introduce the Spatio-Temporal Refiner (STR) as a post-processing refinement module. STR leverages cross-channel multi-scale dilated convolutions and a lightweight attention mechanism to achieve refined modeling of complex multivariate correlations. Experimental results on eight real-world datasets demonstrate that STR-Linear significantly outperforms existing linear models while maintaining a low parameter count. Moreover, it reduces the parameter count by 93.8% compared to iTransformer while preserving a performance advantage, effectively striking a balance between performance and efficiency. Extensive ablation studies and compatibility analyses further confirm the general applicability and robustness of the STR module as a versatile enhancement component across different backbone models. The source code is available at: https://github.com/dwt58/STR-Linear.}
}
@article{XIE2026116321,
title = {Stage-aware industrial defect understanding via multi-agent collaboration},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116321},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116321},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010476},
author = {Jiayuan Xie and Xinting Zhang and Yuxi Tu and Yi Cai and Yangyang Xu and Qing Li},
keywords = {Industrial defect detection, Visual question answering, Multi-agent, Comprehensive information},
abstract = {Defect detection is a fundamental task in industrial manufacturing, traditionally focused on locating defect regions and classifying their types. However, existing methods often overlook deeper semantic understanding, especially the comprehensive information of defects such as their causes, impacts, and possible solutions, which may vary significantly across different supply chain stages. To bridge this gap, we propose a novel task called stage-aware industrial defect understanding, which encourages models to learn to understand the comprehensive information of defects across different supply chain stages. To support this task, we construct a new dataset that integrates images of defects and their corresponding supply chain stages, and adopts a carefully designed visual question answering (VQA) format covering three levels of understanding, i.e., defect type recognition, stage-context reasoning, and comprehensive information analysis. Considering the multi-step structure of our task, which spans from basic defect recognition to comprehensive information understanding across different supply chain stages, we propose a multi-agent framework named stage-aware VQA (SA-VQA). This framework consists of four collaborative agents, i.e., defect discerner, stage concluder, stage predictor, and summarize. Each agent is powered by large vision–language models (LVLM) and interacts via a shared information pool, ensuring coherent reasoning and interpretable outputs. Experimental results demonstrate that SA-VQA significantly outperforms strong baselines across all levels of questions, especially in complex reasoning scenarios involving stage-aware semantics. This work lays a solid foundation for advancing defect analysis from basic perception to semantic-level understanding in real-world industrial applications.}
}
@article{ZHANG2026116374,
title = {Fine-grained semantics-driven decoupling optimization for joint video moment retrieval and highlight detection},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116374},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116374},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011007},
author = {Fuwei Zhang and Peiyuan Liang and Yuxin Feng and Weiming Han and Boying Wang and Yuanyuan Shen and Shuangjiao Zhai and Alex Jinpeng Wang},
keywords = {Video Moment Retrieval, Video Highlight Detection, Video Features Modeling},
abstract = {The joint task of Video Moment Retrieval (MR) and Highlight Detection (HD) requires precise localization of key moments and highlights through natural language queries. However, existing methods rely on global coarse-grained video features while ignoring fine-grained visual cues, and they insufficiently model the differences between subtasks, which causes coupling. These issues limit retrieval accuracy. To address these limitations, we introduce the multi-granularity video features and propose the Fine-grained Semantics-driven Decoupling Optimization (FSDO) for the joint task, leveraging such features. FSDO fuses these features through a Gated Adaptive Fusion Module. A Multi-granularity Features Alignment Loss function is used to match cross-granularity video features with text and align video semantics across different granularities to enhance alignment. Finally, a Dual-path Enhanced Decoupled Module is explicitly applied to different subtasks, reducing task coupling and improving collaborative optimization capabilities. Experimental results on multiple public datasets demonstrate that FSDO outperforms mainstream methods in terms of MR accuracy and HD performance, validating its effectiveness. Our code is available at .}
}
@article{LEE2026116426,
title = {Multi-modal guided multi-source domain adaptation for object detection},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116426},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116426},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011524},
author = {Sangin Lee and Seokjun Kwon and Jeongmin Shin and Namil Kim and Yukyung Choi},
keywords = {Object detection, Domain adaptation, Multi-source domain adaptation},
abstract = {General object detection (OD) struggles to detect objects in the target domain that differ from the training distribution. To address this, recent studies demonstrate that training from multiple source domains and explicitly processing them separately for multi-source domain adaptation (MSDA) outperforms blending them for unsupervised domain adaptation (UDA). However, existing MSDA methods learn domain-agnostic features from domain-specific RGB images while preserving domain-specific information from the domain-agnostic feature map. To address this, we propose MS-DePro: Multi-Source Detector with Depth and Prompt, composed of (1) depth-guided localization and (2) multi-modal guided prompt learning. We leverage domain-agnostic input modalities, namely depth maps and text, to encode domain-agnostic characteristics. Specifically, we utilize depth maps to generate domain-agnostic region proposals for localization and integrate multi-modal features to align learnable text embeddings for classification. MS-DePro achieves state-of-the-art performance on MSDA benchmarks, and comprehensive ablations demonstrate the effectiveness of our contributions. Our code is available on GitHub.}
}
@article{LIANG2026116518,
title = {Less is more: Mitigating attention bias in multimodal table understanding through table content erasure},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116518},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116518},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601244X},
author = {Yuliang Liang and Guibing Guo and Wei Cai and Jianzhe Zhao and Xingwei Wang},
keywords = {Vision–language model, Table understanding, Question answering, Causal inference, Attention mechanism},
abstract = {Multimodal table understanding, which answers questions grounded in table images, remains a challenging task in document intelligence. Although large vision–language models (LVLMs) have demonstrated strong potential, they often suffer from hallucinations, producing responses misaligned with the actual table content. Through a systematic analysis of cross-modal attention patterns, we observe that LVLMs frequently focus on semantically irrelevant table content, which acts as visual noise and impairs accurate reasoning. To address this issue, we propose Eraser, a training-free causal reasoning framework, which first estimates the semantic relevance between the question and table content based on intrinsic cross-modal attention, and then leverages this relevance to guide the model to focus on question-relevant regions via a contrastive decoding strategy. Specifically, we perform counterfactual interventions on the question input to estimate its causal effect on cross-modal attention distribution of the model. Based on the causal effect scores, we selectively erase question-irrelevant table content while preserving structural layout of the table. Finally, we use contrastive decoding to amplify the focus of the model on informative regions by comparing predictions generated from the original image against those generated from the erased table image. Experiments on four table-based question answering datasets demonstrate consistent improved performance without requiring additional training or annotations.}
}
@article{AJMAL2026116394,
title = {PeHNet: Closed-loop prototype enhancement for weakly supervised few-shot segmentation},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116394},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116394},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011202},
author = {Muhammad Shahroz Ajmal and Guohua Geng and Xiaofeng Wang and Pengbo Zhou and Yangyang Liu and Mohsin Ashraf},
keywords = {Few shot segmentation, Prototype adaption, Image segmentation, Weakly supervised few shot segmentation, Iterative refinement},
abstract = {Weakly supervised few-shot segmentation (WS-FSS) aims to segment novel object categories using only image-level labels and a handful of support images, offering a practical solution for data-scarce scenarios. However, existing WS-FSS methods typically follow an open-loop pipeline, where initialization, feature enhancement, and mask refinement are treated as separate stages, leading to error accumulation and limited correction capability. In this paper, we reformulate WS-FSS as a closed-loop learning problem and propose PeHNet, a framework that enables iterative bidirectional interaction between support representations and query predictions. PeHNet first generates class-aware pseudo-masks using semantic priors from a pretrained vision-language model. It then progressively refines both support and query branches through a Prototype Adaptive Module (PAM) and an Iterative Mask Refinement (IMR) module, allowing refined query predictions to feedback and enhance support features. Experiments on PASCAL-5i and COCO-20i show that PeHNet consistently outperforms state-of-the-art WS-FSS methods, demonstrating the effectiveness of closed-loop learning under weak and limited supervision. The source code is available https://github.com/PeHNet.}
}
@article{SHARMA2026116470,
title = {Network intrusion detection using Prioritized Experience Replay and stratified sampling for balanced learning},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116470},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116470},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011962},
author = {Ankit Sharma and Manjeet Singh},
keywords = {Deep Q-learning, Prioritized replay, Reinforcement learning, Network intrusion detection, Internet of things},
abstract = {The exponential growth of device connectivity introduces significant security vulnerabilities, making robust Network Intrusion Detection Systems (NIDS) essential for mitigating cyber threats. Traditional intrusion detection models often struggle with severe class imbalance, leading to degraded performance when identifying rare but critical attacks. To address this, this paper presents a novel Deep Reinforcement Learning (DRL) framework integrating a Deep Q-Network (DQN) with Stratified Sampling and a multiplicative Prioritized Experience Replay (PER) mechanism. Unlike baseline methods that rely on uniform sampling without prioritization, the proposed framework dynamically promotes high-utility experiences by combining Temporal Difference (TD) error, reward significance, and replay frequency. The model was empirically evaluated using the benchmark NSL-KDD and UNSW-NB15 datasets. Experimental results demonstrate that the proposed architecture significantly outperforms standard DQN baselines. Specifically, the framework achieved an overall accuracy of 99.31% and an F1-score of 99.2% on the NSL-KDD dataset, along with 96.2% accuracy and 96.3% F1-score on the UNSW-NB15 dataset. Significantly, the model proved highly effective at detecting minority classes without relying on synthetic data augmentation, achieving an F1-score of 0.930 for Remote-to-Local (R2L) attacks and elevating detection for the extreme minority User-to-Root (U2R) class to an F1-score of 0.522. Furthermore, ablation studies reveal that the multiplicative priority formulation accelerates early-stage learning efficiency by 13% compared to baseline additive methods. The results indicate that the proposed framework delivers stable, balanced intrusion detection performance across datasets with varying traffic characteristics and class distributions.}
}
@article{WANG2026116479,
title = {DSformer: Dynamic sparse transformer for efficient image restoration},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116479},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116479},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012050},
author = {Jiaxiang Wang and Pufen Zhang and Sijie Chang and Peng Shi and Hongying Yu and Dongbai Sun},
keywords = {Image restoration, Sparse attention, Deep learning, Transformer},
abstract = {Image restoration aims to recover high-quality images from degraded observations. Recent Transformer-based methods have achieved remarkable success by modeling long-range dependencies, surpassing traditional approaches across various restoration tasks. However, most existing Transformers rely on dense attention computations over all query-key pairs, which introduces redundancy and limits efficiency. This paper proposes DSformer, a Dynamic Sparse Transformer designed for efficient and high-fidelity image restoration. At its core, the proposed Dual-Mode Sparse Attention (DMSA) combines a static sparsity path and a dynamic sparsity path to balance stable and content-adaptive feature selection, effectively reducing redundant interactions while preserving critical details. To further strengthen representation learning, a Spectral-Gated Feed-forward Network (SGFN) is introduced to facilitate joint spatial–spectral interactions, enabling the preservation of high-frequency textures and structural consistency. In addition, a lightweight Multi-Channel Fusion Unit (MCFU) improves encoder–decoder communication by refining inter-channel dependencies and enhancing multi-scale feature aggregation. Extensive experiments on benchmark datasets show that DSformer delivers strong performance across multiple image restoration tasks, including motion deblurring, defocus deblurring, denoising, deraining, and dehazing.}
}
@article{GARDIA2026116503,
title = {A novel and optimized multi-objective ensemble learning model based software cost estimation},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116503},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116503},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012293},
author = {Jitendra Kumar Gardia and A V S Pavan Kumar and Rakesh Nayak},
keywords = {Software cost estimation, Min-max normalization, Multi-objective, Non-dominated sorting, Genetic crowd distance algorithm, Machine learning},
abstract = {High-dimensional project attributes, limited sizes, and severe feature redundancy cause overfitting and unstable model generalization, making software cost assessment difficult. Machine learning algorithms enhance prediction accuracy, yet most optimize prediction error and ignore estimate accuracy. Current ensemble-based cost estimating methods rarely use Pareto-driven feature selection in the learning pipeline, resulting in inferior feature representations and limited scalability. This article presents a multi-objective ensemble learning framework that integrates feature selection into optimization to overcome these limitations. The proposed MNDSGC method makes feature selection a bi-objective issue. MNDSGC tunes the crowding distance mechanism to balance estimate error and feature subset size while boosting convergence stability and computing efficiency for high-dimensional cost datasets, unlike NSGA-II. This method preserves solution variety while minimizing estimating error and feature dimensionality. MNDSGC generates Pareto-optimal feature subsets, which heterogeneous regression learners, XGBoost, support vector machine, linear regression, and artificial neural networks evaluate. Multiple stages are needed to resolve high-dimensional redundancy, overfitting, and model instability, while normalizing provides scale consistency. MNDSGC reduced irrelevant characteristics, while the ensemble model improved generalization over simpler models. Results on SEERA and PROMISE datasets show that the proposed approach decreases feature dimensionality by 50% and improves performance. The proposed framework improved R² from 99.284% and 99.04% software cost estimation, and the SEERA dataset, and approximately 18% improved when compared to models without feature selection. The proposed MNDSGC-based ensemble approach outperformed baseline models without feature selection in terms of MAE, MMRE and MAPE.}
}
@article{HU2026116483,
title = {ProtoZero: An adaptive framework for unknown attack detection via macro–micro graph learning},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116483},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116483},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012098},
author = {Congheng Hu and Huaxin Zhao and Junwei Du and Junjie Zhang and Jiapeng Zhang and Jun Zhao and Minglai Shao},
keywords = {Intrusion detection, Information bottleneck, Graph structure entropy, Prototype learning, Adaptive security},
abstract = {Graph Neural Networks (GNNs) and prototype learning have gained widespread application in Network Intrusion Detection Systems (NIDS) in recent years. However, there are three critical limitations that remain underexplored. First, existing methods fail to simultaneously capture feature camouflage and structure camouflage hidden in network traffic. Second, prototype collapse blurs the boundaries between prototypes and makes it difficult to map newly emerging intrusion patterns within accurate prototype regions. Third, static architectures cannot capture evolving attack patterns, failing to detect unknown attacks. To address these challenges, this paper proposes ProtoZero, an adaptive zero-shot intrusion detection framework based on macro–micro graph learning. Specifically, ProtoZero proposes a Graph Structure Entropy (GSE) based structure consistency measurement method to detect macroscopic structure camouflage, and introduces Information Bottleneck (IB) to capture informative intrusion features against microscopic feature camouflage. Subsequently, ProtoZero presents a Dynamic Separation Constraint (DSC) strategy to strengthen intra-prototype cohesion and maximize inter-prototype separation, thereby mitigating prototype collapse. Finally, ProtoZero presents an adaptive evolution learning strategy to autonomously discover new prototypes for detecting newly emerging attack variants. Experimental results demonstrate that ProtoZero significantly outperforms state-of-the-art baselines, yielding AUROC improvements of 4.20% and 7.21% on the CIC-IDS2017 and CSE-CIC-2018 datasets, respectively.}
}
@article{LIU2026116519,
title = {Self-enhancing prompt optimization for language style generation},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116519},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116519},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012451},
author = {Haifeng Liu and Hedeng Hu and Wenxin Yang and Junsheng Zhou and Nan Zhao},
keywords = {Language style generation, Prompt learning, Large language model},
abstract = {Equipping large language models (LLMs) with diverse linguistic styles can effectively enhance conversational diversity, a critical factor in facilitating human-machine emotional resonance. However, current approaches to achieving specific linguistic styles typically rely on meticulously crafted prompts by human experts with extensive experience. Given that users tend to input queries directly without possessing foundational knowledge of prompt optimization, LLMs often fail to fully harness their robust capabilities in generating diverse linguistic styles. To address these challenges, this paper proposes a teacher-guided self-experience summarization framework. This framework transforms users’ simple prompts into structured expert prompts through supervised fine-tuning. Following optimization by the teacher model, it performs preference alignment using the Direct Preference Optimization algorithm and conducts self-summarization by integrating responses to historical queries and teacher feedback. Experimental results demonstrate that in GPT-4-Turbo evaluations, the language style score of the Qwen2-7B-Instruct model increased from 7.22 to 9.17. In reward model evaluations, the win rate of Style-SPSS combined with Qwen2-7B reached 0.98, significantly enhancing the style generation performance of LLMs.}
}
@article{MENG2026116435,
title = {Multi-task hybrid graph learning for aircraft recognition based on heterogeneous radar network},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116435},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116435},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011615},
author = {Han Meng and Yuexing Peng and Pengtai Qin and Aihua Li and Bin Wei and Hao Zhang and Wenbo Wang},
keywords = {Radar detection systems, Multi-task learning, Target recognition, Graph neural network, Multi-gate mixture-of-experts},
abstract = {In intelligent radar detection systems, aircraft target recognition and tracking are interrelated tasks. However, single-task models fail to exploit synergistic cross-task correlations, while existing multi-task learning frameworks struggle with the complex spatial–temporal-frequency features and dynamic topologies of radar networks. To address these issues, we propose the Multi-Task Hybrid Graph Learning (MT-HGL) model, a unified framework that co-optimizes the primary task of target recognition with auxiliary signal reconstruction and target positioning. At the node level, the model incorporates a masked autoencoder-based module for radar signal enhancement and implements a reparameterized graph contrastive learning module to differentiate corrupted data with varying loss rates and patterns, thereby learning robust representations. At the network level, to mitigate cross-task negative transfer, we design a hybrid expert architecture that utilizes dynamic hypergraph learning to explicitly capture the inherently directed spatial dependencies among distributed radars, thereby constructing task-specific hyperedges to achieve topological decoupling. Furthermore, an adaptive multi-task weight adjustment loss function is introduced to balance gradient contributions and minimize computational overhead during joint optimization. Finally, extensive experiments demonstrate that MT-HGL outperforms the compared conventional single-task and multi-task baselines on the evaluated radar network datasets, achieving improved recognition accuracy and robustness in complex detection scenarios. Our implementations are available at https://github.com/ShangxinM/MTGCL.}
}
@article{PETRACCHI2026116548,
title = {Tiny machine learning for hyperspectral skin cancer image classification},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116548},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116548},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012748},
author = {Bernardo Petracchi},
keywords = {Machine learning, Hyperspectral images, GPU, FPGA, Tiny machine learning, Artificial neural networks},
abstract = {As the complexity of Machine Learning (ML) models grows, the need for powerful and high-memory devices is becoming more and more pressing. Furthermore, some scenarios like medical environments frequently deal with high-dimensional data such as clinical images that are challenging to analyze and elaborate using ML models without suitable hardware. This is the case, for instance, of hyperspectral (HS) images offering a wealth of spectral information that can aid in early detection and characterization. Many studies present in the literature address the use of Graphical Processing Units (GPUs) and Field Programmable Gate Arrays (FPGAs) for elaboration and classification of HS images in both the medical and non-medical field obtaining relevant results at the expense of a high-power consumption and a long time for designing. This paper aims at introducing an emerging subfield of ML called Tiny Machine Learning (Tiny ML) including hardware and software able to perform data analysis on extremely low-power devices such as microcontrollers, typically in the mW range or below. Furthermore, the research described in this paper wants to highlight how complex models like Artificial Neural Networks (ANNs) can be executed on portable devices such as the Arduino Nano 33 BLE (Bluetooth Low Energy) Sense module to perform low-cost HS pre-screening of skin lesions. Results show the effectiveness of this new branch of Artificial Intelligence (AI) in classifying HS skin cancer images.}
}
@article{IYER2026116451,
title = {Generative AI-driven high-fidelity human motion simulation},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116451},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116451},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011779},
author = {Hari Iyer and Neel Macwan and Atharva Jitendra Hude and Heejin Jeong and Shenghan Guo},
keywords = {Generative AI, Human motion simulation, Large language models, Text-to-motion models},
abstract = {Human motion simulation (HMS) supports cost-effective evaluation of worker behavior, safety, and productivity in industrial tasks. However, existing methods often suffer from low motion fidelity. This study introduces Generative-AI-Enabled HMS (G-AI-HMS), which integrates text-to-text and text-to-motion models to enhance simulation quality for physical tasks. G-AI-HMS tackles two key challenges: (1) translating task descriptions into motion-aware language using Large Language Models aligned with MotionGPT’s training vocabulary, and (2) validating AI-simulated motions against real human movements using computer vision. Posture estimation algorithms are applied to real-time videos to extract joint landmarks, and motion similarity metrics are used to compare them with AI-simulated joint motion sequences. In a case study involving eight tasks, G-AI-HMS demonstrated its superior performance compared to the benchmark AI simulations. Specifically, G-AI-HMS performed better in six tasks based on spatial accuracy, four tasks based on alignment after pose normalization, and seven tasks based on overall temporal similarity. Statistical analysis showed that G-AI-HMS significantly (p<0.0001) reduced joint error and temporal misalignment while retaining comparable posture accuracy.}
}
@article{ZHONG2026116524,
title = {MKDS: Multi-source knowledge-driven data synthesis framework for effective domain adaptation of large language models},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116524},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116524},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012505},
author = {Qihuang Zhong and Jinzhao Gong and Ke Zhu and Fei Liao and Juhua Liu and Bo Du},
keywords = {Data synthesis, Large language model, Knowledge graph, Domain adaptation},
abstract = {Domain-specific instruction tuning (IT) is a common approach to unleash the power of large language models (LLMs) in specialised applications, e.g. medical question answering (QA). The effectiveness of domain-specific IT highly relies on high-quality instruction corpora, which are usually limited because of the high cost and time-consuming data annotation. Hence, data synthesis (DS) via LLMs has emerged as an essential paradigm. However, current DS methods often struggle to generate professional, high-quality and diverse domain-specific IT data, especially for the Chinese medical domain. Thus, we propose a simple yet effective multi-source knowledge–driven DS (MKDS) framework to generate additional desired IT data. The principle of MKDS is to instruct proprietary LLMs to fully use rich and professional knowledge from multi-source knowledge bases. Accordingly, we designed a high-quality synthetic IT dataset tailored for the Chinese medical domain (MK-MedInstruct), comprising over 187K instruction–response pairs. To verify the effectiveness of this dataset, we used it to fine-tune two cutting-edge LLMs: LLaMA-3-8B-Instruct and Qwen-2.5-7B-Instruct. Extensive results on various medical benchmarks, encompassing multiple-choice and long-form medical QA, demonstrate that our models perform better than most baseline models. The source code and datasets are publicly available at https://github.com/WHU-ZQH/MKDS.}
}
@article{LYU2026116446,
title = {SEAL-Flow: Continuous-time flow matching for topologically consistent medical image segmentation},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116446},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116446},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601172X},
author = {Houchen Lyu and Shanshan Wan},
keywords = {Medical image segmentation, Flow matching, Signed distance field, Boundary regularization, Topology preservation},
abstract = {Recent advances in generative medical image segmentation have enabled probabilistic modeling of ambiguous anatomical and pathological structures. However, existing methods remain structurally unreliable in low-contrast and crowded scenes, often producing foreground leakage, adhesion-induced merging, and unstable contours. We propose SEAL-Flow, a structurally reliable generative framework that represents masks as signed distance fields (SDFs) and learns conditional transport dynamics through conditional flow matching (CFM). SEAL-Flow addresses these failure modes with three problem-driven components: probabilistic layout conditioning to suppress texture-induced leakage, a topology-aware narrow-gap constraint to reduce false bridges between adjacent instances, and multi-frequency contour regularization based on elliptic Fourier descriptors (EFDs) to stabilize the zero-level set and improve boundary smoothness. Together, these designs improve layout reliability, instance separability, and contour consistency while retaining the probabilistic modeling capacity of flow-based segmentation. Experiments on MoNuSeg and CVC-EndoSceneStill show that SEAL-Flow outperforms representative discriminative and generative baselines. Compared with the strongest competing method on each dataset, SEAL-Flow improves Dice and mIoUbench by up to 4.2 and 2.9 percentage points, respectively, and reduces HD95 by up to 66.2%. Qualitative and ablation analyses further demonstrate that SEAL-Flow alleviates leakage, adhesion, and boundary instability, yielding more structurally consistent segmentation results. The code is publicly available at https://github.com/Vaugh3/SEAL-Flow-Continuous-Time-Flow-Matching-for-Topologically-Consistent-Medical-Image-Segmentation.}
}
@article{PENG2026116467,
title = {Mutual supervision: A framework for improving reward model in preference alignment},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116467},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116467},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011937},
author = {Zengqiang Peng and Mengjian Zhang and Guihua Wen and Qufei Zhang and Chuyun Chen},
keywords = {Large language model, Preference alignment, Reinforcement learning from human feedback, Interaction mechanism},
abstract = {Reinforcement Learning from Human Feedback (RLHF) is an effective technique for aligning large language models’ responses with human preferences. The reward model, trained on human feedback data, serves as a proxy for the human feedback in reinforcement learning (RL) process. Its performance directly determines the upper limit of the RL effectiveness. However, the accuracy and stability of the reward model are interfered with by multiple aspects of noise such as mislabeling of labels, the inherent ambiguity of preferences, and out-of-distribution. To mitigate the limitations imposed by deficiencies in reward model on preference alignment, we propose a novel interaction mechanism between the policy model and the reward model, enabling their mutual and continuous improvement. In this approach, the policy model aligns with preferences using feedback from the reward model, while the reward model improves its accuracy and stability by leveraging the policy model’s responses, without requiring additional human annotations. Based on this novel interaction mechanism, we propose a reasonable loss function inspired by contrastive learning to enhance the performance of the reward model and validate its effectiveness through experiments. We conducted experiments on general dialogue task, machine translation task, and traditional Chinese medical diagnostic assistance task. The results demonstrate that the proposed approach significantly improves the accuracy and stability of the reward model, leading to better preference alignment performance. Furthermore, our method is shown to consistently outperform existing baseline approaches, proving the effectiveness of the proposed algorithm.}
}
@article{XIAO2026116403,
title = {Cross-camera reliability modeling with soft contrastive learning for unsupervised person re-identification},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116403},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116403},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011299},
author = {Yongyi Xiao and Tianqing Zhu and Faqian Guan and Hui Sun and Jiayan Huang and Antoni Grau Saldes},
keywords = {Person Re-ID, Unsupervised learning, Contrastive learning, Hard sampling strategy},
abstract = {Unsupervised person re-identification (Re-ID) seeks to associate images of the same individual captured by non-overlapping cameras without relying on identity annotations. As a result, its performance depends heavily on the quality of the automatically generated supervisory signals. In practice, large appearance variations across camera views introduce severe domain discrepancies, causing camera-induced feature bias that undermines pseudo-label reliability and restricts representation generalization. Although recent approaches predominantly rely on clustering and contrastive learning to address these issues, they rarely account for this bias explicitly. To alleviate these problems, we propose a camera-aware framework that jointly improves pseudo-label quality and feature robustness. The framework refines cluster assignments by exploiting inter-camera statistics, regulates contrastive learning through a reliability-guided loss that adapts sample weights according to cross-camera entropy, and updates prototypes using hard samples identified by confidence discrepancies. A complementary self-supervised contrastive loss further stabilizes representation learning. Extensive experiments conducted on four well-known Re-ID datasets demonstrate consistent performance gains over most existing unsupervised methods, confirming the effectiveness of explicitly modeling camera-induced bias in unsupervised person Re-ID.}
}
@article{WANG2026116528,
title = {Post-enhancing viewpoint robustness for pre-training generalizable re-identification},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116528},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116528},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012542},
author = {Yunlong Wang and Bingliang Jiao and Liying Gao and Wenxuan Wang and Peng Wang},
keywords = {ReID, Unsupervised post-enhancement method, Preserving-adapting approach},
abstract = {Unsupervised pretraining presents a promising approach for building generalizable ReID systems, capitalizing on its capacity to learn from varied scenarios at a low cost. Despite its potential, existing models often struggle with cross-view pedestrian matching due to limited training diversity in posture and viewpoint. To address this, we propose an innovative unsupervised post-enhancement method using unlabeled surveillance data, enhancing cross-view matching. Our strategy includes density-based clustering for pseudo-label generation and a bipartite graph matching algorithm for consistent labeling across different views. Additionally, we implement a preserving-adapting approach, combining LoRA-Tuning and an independent attention branch to maintain pre-trained knowledge and reduce overfitting. This method has significantly improved pre-trained DG-ReID models, demonstrating a 10.9% average increase in mAP. It highlights the efficacy of unsupervised pretraining in advancing robust, generalizable person re-identification systems.}
}
@article{XIAO2026116500,
title = {Enhancing semi-supervised multi-view graph convolutional networks via supervised contrastive learning and self-training},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116500},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116500},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012268},
author = {H. Xiao and F. Dornaika and J. Charafeddine and J. Bi},
keywords = {Multi-view learning, Semi-supervised classification, Supervised contrastive learning, Self-training, Graph convolutional networks},
abstract = {The advent of graph convolutional network (GCN)-based multi-view learning provides a powerful framework for integrating structural information from heterogeneous views, enabling effective modeling of complex multi-view data. However, existing methods often fail to fully exploit the complementary information across views, leading to suboptimal feature representations and limited performance. To address this, we propose MV-SupGCN, a semi-supervised GCN model that integrates several complementary components with clear motivations and mutual reinforcement. First, to better capture discriminative features and improve model generalization, we design a joint loss function that combines Cross-Entropy loss with Supervised Contrastive loss, encouraging the model to simultaneously minimize intra-class variance and maximize inter-class separability in the latent space. Second, recognizing the instability and incompleteness of single graph construction methods, we combine both KNN-based and semi-supervised graph construction approaches on each view, thereby enhancing the robustness of the data structure representation and reducing generalization error. Third, to effectively utilize abundant unlabeled data and enhance semantic alignment across multiple views, we propose a unified framework that integrates contrastive learning in order to enforce consistency among multi-view embeddings and capture meaningful inter-view relationships, together with pseudo-labeling, which provides additional supervision applied to both the cross-entropy and contrastive loss functions to enhance model generalization. Extensive experiments demonstrate that MV-SupGCN consistently surpasses state-of-the-art methods across multiple benchmarks, validating the effectiveness of our integrated approach.11Source code: https://github.com/HuaiyuanXiao/MVSupGCN.}
}
@article{P2026116431,
title = {Deep high attention forward harmonic-inspired LeNet: A novel deep learning based trust aware network slicing in 5G},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116431},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116431},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011573},
author = {Reshma P and R. Kumar},
keywords = {Smart city, Secure communication, Network slicing, Wolverine optimization algorithm, Deep High Attention Forward Harmonic-inspired LeNet},
abstract = {Network slicing is a fundamental technology in Fifth Generation (5G) communication, enabling 5G networks to support various services by providing customized network slices tailored to the specific requirements of each service. The conventional techniques for network slicing struggle to adjust to the dynamic traffic flows and heterogeneity of the 5G networks. Hence, this paper presents an advanced methodology, namely the Deep High Attention Forward Harmonic-inspired LeNet (DHAFH Le-Net) for 5G network slicing. Initially, the system model of 5G network slicing in smart cities is considered. A set of features, especially speed, duration, modulation type, user device type, Quality of Services (QoS), Trust, and Quality of Experience (QoE), is obtained from numerous devices. After this, the Adaptive Wolverine Optimization Algorithm (AWoOA) is exploited for parameter weighting, which integrates the Wolverine Optimization Algorithm (WoOA) and the adaptive concept. Thereafter, the network slicing in 5G is done by the DHAFH Le-Net, which combines the LeNet, harmonic-inspired fusion, and Deep High-order Attention neural Network (DHA-Net). Furthermore, the established DHAFH Le-Net scheme attained a higher energy efficiency and acceptance ratio of 90.567 Mbps/joule, and 96.870 %, and achieved a minimum execution time of 0.497 sec for 10 slice requests.}
}
@article{NGUYEN2026116419,
title = {Directly extracting maximal multi-level high-utility patterns},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116419},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116419},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011457},
author = {Trinh D.D. Nguyen and N.T Tung and Loan T.T. Nguyen and An Mai and Anh Nguyen},
keywords = {Pattern mining, Hierarchical database, Multi-level high-utility pattern, Maximal pattern, Taxonomy-based},
abstract = {High-utility pattern mining (HUPM) is a practical approach that incorporates item utility to discover valuable insights from transactional data. However, applying HUPM to multi-level data using item taxonomies often leads to a pattern explosion, generating massive amounts of redundant patterns. Maximal high-utility pattern mining addresses this by discovering a concise, non-redundant set of the most general high-utility patterns. Previous algorithms for this task have been inefficient because they rely on an intermediate, resource-intensive step of mining closed high-utility patterns. This work introduces FMX-Miner, a novel and efficient algorithm that directly extracts maximal multi-level high-utility patterns, completely bypassing the closed pattern generation phase. By integrating dynamic on-the-fly maximality checking and advanced pruning strategies, FMX-Miner significantly reduces the search space and computational cost. Experimental results demonstrate that FMX-Miner is up to 570 times faster and consumes 2 to 10 times less memory than the state-of-the-art algorithms, offering a scalable solution for extracting actionable insights from hierarchical databases.}
}
@article{WANG2026116471,
title = {CMCAF: Conditional Multi-scale Cross-Modal Adaptive Fusion network for RGB-T salient object detection},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116471},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116471},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011974},
author = {Yiding Wang and Xiaoyang Yuan and Zongyan Yue and Yiming Kong and Sen Lin},
keywords = {RGB-T images, Salient object detection, Swin transformer, Cross-modal fusion},
abstract = {RGB-T salient object detection (SOD) integrates visible and thermal cues for robust localization under complex conditions. However, existing methods often employ indiscriminate fusion strategies that assume equal reliability across modalities. This approach fails to dynamically mitigate interference when one modality degrades (e.g., thermal crossover), leading to the propagation of noise and the corruption of reliable features. To address this, we propose the Conditional Multi-scale Cross-Modal Adaptive Fusion (CMCAF) network. The core philosophy of CMCAF is to treat the thermal modality not merely as a feature source, but as a dynamic condition to modulate RGB processing. Specifically, a Shared Swin Backbone (SSB) is employed to extract aligned cross-modal representations. At the bottleneck, a Thermal-Conditioned Modulation (TCM) block generates channel-wise affine parameters. It functions as a gate: amplifying reliable cues when thermal data is salient, while effectively suppressing noise propagation to protect RGB semantics when thermal data is unreliable. To accommodate object scale variations, a Scale-Aware Fusion (SAF) module acts as a scale arbitrator, adaptively balancing semantic context and fine details. Furthermore, a Thermal-Guided Gating Decoder (TGGD) screens skip connections via dual gating, filtering out background noise backflow during reconstruction. Extensive experiments on RGB-T and RGB-D benchmarks demonstrate that CMCAF consistently outperforms state-of-the-art methods, exhibiting superior accuracy and strong robustness against modal noise. The code and results can be accessed at https://github.com/AmazingJ-123/RGBT-SOD-CMCAF.}
}
@article{SU2026116411,
title = {Factorized stochastic transport for composite degradation image restoration},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116411},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116411},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011378},
author = {Xin Su and Jianshu Chao and Huifang Shen and Anqi Chen and Yuting Gao and Jianya Yuan},
keywords = {Image restoration, Composite degradation, Mixture of experts, Stochastic transport},
abstract = {Composite image degradations, where rain, haze, low-light, and snow overlap spatially within a single frame, pose a fundamental challenge for unified restoration models. We identify two failure modes on such inputs. First, deterministic flow transport averages over feasible solutions and collapses to over-smoothed predictions. Second, image-level expert routing yields a selectivity ratio of only 1.2×, with near-uniform weights that leave experts under-specialized on localized distortions. Motivated by these observations, we propose F2D-Net, a factorized stochastic transport framework. The model factorizes the restoration velocity field into a shared backbone and degradation-specific expert increments. A learned spatial gating then assembles them at every pixel. The core mechanism is a state-dependent multiplicative noise whose magnitude scales with the local residual. The noise remains large far from the clean target to encourage diverse reconstructions, and contracts to zero at convergence to preserve fine detail. The closed-form log-normal transition collapses sampling to one network call, matching feed-forward speed. On CDD-11, F2D-Net attains the best structural and perceptual quality across all complexity tiers with substantially higher expert selectivity than image-level routing. It also remains competitive on standard three-task and five-task all-in-one benchmarks. Our project page is at https://sxvvv.github.io/f2net.}
}
@article{WANG2026116463,
title = {Cross-domain Human Activity Recognition based on variational Bayesian Gaussian mixture model and Optimal Transport},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116463},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116463},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011895},
author = {Huaijun Wang and Jian Yang and Changrui Cui and Junhuai Li and Bo Fu and Xiang Wei},
keywords = {Human Activity Recognition, Domain adaptation, Variational Bayesian Gaussian mixture model, Optimal Transport},
abstract = {Human Activity Recognition (HAR) has garnered significant attention in health monitoring, rehabilitation training, and sports evaluation. However, heterogeneous sensor placements, varying data acquisition protocols, and diverse environmental conditions induce substantial distribution discrepancies across datasets, severely degrading model performance in cross-domain scenarios. While Optimal Transport (OT) offers a principled framework for distribution alignment, conventional OT-based methods predominantly focus on global distribution matching, often neglecting fine-grained intra-class geometric structures during alignment. To address these limitations, this paper proposes a novel cross-domain HAR framework integrating a Variational Bayesian Gaussian Mixture Model (VBGMM) with structure-preserving OT. Specifically, we leverage VBGMM with a Dirichlet process prior to automatically infer the optimal number of sub-distributions in both source and target domains, enabling adaptive modeling of complex intra-class variations without manual hyperparameter tuning. Subsequently, we propose a sub-distribution-aware OT strategy incorporating Laplacian regularization, which performs fine-grained alignment via barycentric mapping while explicitly preserving local structural consistency. Extensive experiments on four benchmark datasets (i.e., UCI-DSADS, UCI-HAR, USC-HAD, and PAMAP2) demonstrate the superiority of our approach. The proposed method significantly enhances cross-domain alignment and achieves state-of-the-art recognition accuracy, outperforming recent transfer learning and OT-based baselines by 2.6%–16.8% on average. The implementation is available at https://github.com/xx10309/VBGMM-OT-HAR.}
}
@article{WANG2026116484,
title = {DGSDC: Dynamic Graph Learning for Sparse and Directed Communication in decentralized multi-agent coordination},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116484},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116484},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012104},
author = {Zhangling Wang and Tingting Wei and Yirui Liu and Lina Lu and Xueqiang Gu and Wanpeng Zhang},
keywords = {Multi-agent communication, Graph learning, Multi-agent reinforcement learning, Information flow control, Multi-agent coordination},
abstract = {Information sharing through communication is an essential approach to tackle complex collaborative tasks within multi-agent reinforcement learning (MARL). However, existing communication frameworks often suffer from two main issues. On one hand, these frameworks often contain redundant and low-informative communication links, which provide limited decision-relevant information to receivers. On the other hand, the lack of directional control in the information flow leads to indiscriminate broadcasting among all agents, causing crucial messages to be drowned out by low-quality traffic. To address these limitations, we propose Dynamic Graph Learning for Sparse and Directed Communication (DGSDC), a framework for decentralized multi-agent coordination. DGSDC constructs dynamic interaction graphs by estimating inter-agent relevance from local observations, and employs an adaptive sparsification mechanism to remove redundant links while retaining critical connections. To regulate information flow, we further introduce a two-stage communication scheme: (i) updating latent representations via message aggregation, and (ii) predicting discrete, directed communication actions to gate message passing. Based on the resulting sparse directed graphs, a dedicated module approximates the global state from local observations. All components are trained end-to-end, leading to more efficient communication and improved cooperative behaviors. Experiments on multiple standard cooperative benchmarks show that DGSDC consistently achieves competitive performance compared with representative baselines.}
}
@article{SEO2026116536,
title = {UA-Tab: Uncertainty-aware self-supervised representation learning for tabular data},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116536},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116536},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012621},
author = {Seunghwan Seo and Wooju Kim},
keywords = {Tabular data, Uncertainty-aware, Self-supervised learning, Representation learning, Noise injection},
abstract = {Tabular data, a cornerstone of real-world applications in domains such as healthcare, finance, and infrastructure, pose unique challenges for deep learning due to their heterogeneous feature types, lack of spatial structure, and frequent presence of noisy or missing values. Although recent advances in self-supervised learning (SSL) have enabled progress in tabular representation learning, existing methods often overlook a critical aspect of real-world data—feature-level uncertainty. In this paper, we propose UA-Tab (Uncertainty-Aware self-supervised representation learning for Tabular data), a novel self-supervised framework that explicitly models and leverages uncertainty in tabular data. UA-Tab introduces two key innovations: (1) a unified attention-uncertainty mechanism that identifies and emphasizes informative yet reliable features while down-weighting noisy or ambiguous inputs, and (2) a latent-space perturbation strategy for view generation, enabling contrastive learning without the need for unreliable negative sampling. Through comprehensive experiments on the Adult Income dataset under a wide range of synthetic noise scenarios—including value corruption, masking, mode collapse, and out-of-distribution anomalies—UA-Tab demonstrates superior robustness and generalization compared to existing SSL baselines such as VIME, SCARF, STaB, SubTab, and TabDeCo. Notably, UA-Tab consistently achieves the highest accuracy and macro F1-score across conditions while maintaining interpretability through its uncertainty outputs. These results highlight UA-Tab’s potential to serve as a reliable and transparent foundation for self-supervised tabular learning, especially in environments where data quality varies and explainability is critical.}
}
@article{ZHU2026116395,
title = {GraphTraj: Structure-aware representation learning for trajectory similarity calculation},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116395},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116395},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011214},
author = {Jiahui Zhu and Xinzheng Niu and Kun She and Philippe Fournier-Viger and Jingjing Li},
keywords = {Trajectory representation, Segmentation, Structure, Graph, Similarity},
abstract = {Trajectory similarity computation is crucial for many trajectory data mining applications. However, existing methods primarily focus on the sequential arrangement of trajectory points to represent movement and behavior patterns, overlooking the rich intrinsic spatial structure and topological relationships inherent in trajectories. This limitation prevents fully capturing deeper information, such as spatial associations between trajectory segments and complex behavioral motifs. To address this, we propose GraphTraj, a representation learning framework for structure-aware trajectory similarity computation. Our core motivation and novelty are two-fold: first, we convert trajectories into structured graphs to introduce their inherent spatial structure and topological information, without relying on any external information such as predefined road networks or map matching. Second, we preserve the original sequential order as a complementary feature, ensuring no information loss. To fuse these modalities, we employ a dual-stream architecture that unifies the structural graph representation with sequential trajectory information, which helps address the limitations of traditional sequence-only modeling. Specifically, GraphTraj partitions each trajectory into sub-trajectories and constructs undirected weighted graphs (UWGs) where nodes represent sub-trajectory units and directed edges encode their spatial relationships with weight attributes. This graph representation fundamentally transcends sequence-based paradigms by holistically encoding global morphology, local motion patterns, and spatio-behavioral correlations. The UWGs then serve as core structural inputs for representation learning in our ranking-loss-optimized graph convolutional neural network, while raw trajectory sequences are processed in parallel as sequence-enhanced inputs. GraphTraj operates without prior knowledge, integrating graph structures with raw trajectory sequences through a dedicated dual-stream graph-sequence neural network to learn trajectory similarity. Optimized via a ranking loss function, this architecture explicitly prioritizes relative similarity relationships to align learned representations with any user-defined similarity metric. Extensive experiments on three public trajectory datasets demonstrate that the proposed approach outperforms state-of-the-art methods for approximating the metric space.}
}
@article{YANG2026116447,
title = {CoT-TBA: Chain-of-Thought Truncation Backdoor Attacks against large reasoning models},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116447},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116447},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011731},
author = {Yatao Yang and Jinbo Feng and Man Hu and Jiatong Li and Song Xiao},
keywords = {Large reasoning models, Backdoor attacks, Chain-of-thought, Reasoning trace integrity, Trigger-conditioned truncation},
abstract = {Chain-of-thought (CoT) prompting improves the reasoning capability of large language models on tasks requiring multi-step deduction, but exposing explicit reasoning traces also introduces a surface for reasoning-integrity vulnerabilities. This work studies a controlled data-poisoning setting for systems that expose visible reasoning traces, where models appear to follow normal deduction patterns while ultimately producing incorrect answers. We propose the Chain-of-Thought Truncation Backdoor Attack (CoT-TBA), a training-time attack that induces premature commitment to a targeted error before logical closure when a trigger is present. Unlike approaches that inject malicious reasoning content or bypass reasoning entirely, CoT-TBA preserves a locally coherent reasoning prefix before truncating the deductive process. Experiments across multiple reasoning benchmarks show that CoT-TBA is most effective on tasks with longer explicit reasoning traces, while its effectiveness and utility preservation vary across model architectures and reasoning depth. Additional analyses reveal important boundary conditions: the attack shifts toward sequence elongation on shallow reasoning tasks, and process-level verification using Process Reward Models detects the resulting deductive inconsistency at a high rate. These findings characterize a controlled vulnerability surface for the integrity of explicit reasoning traces under data poisoning, suggesting that lightweight or incomplete inspection of reasoning trajectories may be insufficient without process-level verification.}
}
@article{LI2026116508,
title = {HiPC: Historical information-driven partial label-loss joint correction for robust medical image classification},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116508},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116508},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012347},
author = {Jianyang Li and Yucong Meng and Xin Ma and Yonghong Shi},
keywords = {Medical image classification, Noisy label, Label correction, Loss-reweight},
abstract = {High-quality large-scale labeled data is essential for training deep learning models in medical image classification. However, acquiring such data is expensive and challenging due to labeling noise caused by subjective bias or annotation tool errors. Traditional deep learning methods struggle with noise robustness, while existing noise-handling approaches often face bias accumulation due to unstable predictions. To address these issues, this paper propose HiPC, a historical information-driven partial label loss joint correction method. HiPC operates in two stages: (1) Warmup phase: A historical information module records sample prediction probabilities and losses via a first-in-first-out queue, incorporating a trust penalty term to mitigate overconfidence and class imbalance. (2) Robust training phase: A dual selection label self-correction module first filters samples using a Gaussian Mixture Model based on historical mean loss, then performs secondary screening via prediction flip frequency to identify reliable samples for label correction. Simultaneously, an adaptive loss optimization module adjusts positive label weights using historical prediction discrepancies and expands negative label selection to enhance learning. Experimental results demonstrate that HiPC consistently outperforms existing methods across three medical image datasets, demonstrating superior robustness and broad applicability in handling noisy labels.}
}
@article{YANG2026116480,
title = {Causal-prior-informed prediction of coronary heart disease: Leveraging LLM-guided structure learning and imbalance-aware augmentation},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116480},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116480},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012062},
author = {Liang Yang and Liuan Wang and Yujian Ma and Jiaming Liu and Shuai Zhao},
keywords = {Coronary heart disease (CHD), Causal-prior-informed structure learning, Graph-conditional risk prediction, Large language models (LLMs), Data augmentation},
abstract = {Coronary heart disease (CHD) is a leading cause of death worldwide, making early and accurate detection a critical healthcare priority. However, existing CHD prediction models often face two challenges: severe class imbalance and limited interpretability in characterizing clinically relevant relationships among observed variables. To address these challenges, we propose CausalHeart, a framework that combines MCMC-guided few-shot data augmentation with LLM-informed soft directional priors for graph-conditional CHD risk prediction. The augmentation module improves minority-class representation by selecting representative observed CHD-positive exemplars and curating generated candidate samples. The prediction module incorporates clinically reviewed LLM-derived directional priors as soft regularization terms in directed structure learning and estimates CHD risk conditional on the learned graphical representation. Because the available data are retrospective observational records, the learned structure and associated risk estimates are interpreted as model-based decision-support outputs rather than identified real-world causal effects. Experiments on clinical and external benchmark datasets demonstrate the predictive effectiveness and robustness of the proposed framework under class imbalance. This study contributes a data-efficient and cautiously interpretable approach for CHD risk prediction in high-stakes medical settings.}
}
@article{HE2026116496,
title = {What you say is what you get: Text-aligned semantic reward modeling with vision-language representations for reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116496},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116496},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012220},
author = {Wei He and Yukun Xiao and Liqian Ma and Yisheng An and Bo Sun and Yaxian Wang and Jun Liu},
keywords = {Reinforcement Learning, Vision language models, Reward design, Semantic Reward Modeling},
abstract = {In reinforcement learning, reward design plays a critical role in training stability and policy convergence. However, constructing rewards that stably reflect an agent’s overall progress remains challenging. Vision-language models offer a promising alternative by mapping text-described objectives to reward signals, yet existing approaches still suffer from discontinuous intermediate rewards, insufficient task-critical semantic discrimination, and temporal inconsistency caused by single-step similarity measurements. To address these challenges, we propose Text-Aligned Semantic Reward Modeling (TASRM), a structured and learnable semantic reward framework based on vision-language representations. TASRM leverages behavioral distributions from historical successful and failed trajectories to model the relative semantic progress of states and produce smoother intermediate rewards. It further introduces a task-aware contrastive optimization mechanism to enhance discrimination of task-critical semantic differences, and employs multi-step semantic progression modeling to enforce temporal consistency and directional stability in reward construction. Extensive experiments demonstrate that TASRM significantly improves training stability and policy performance across diverse reinforcement learning tasks.}
}
@article{LI2026116454,
title = {Privacy-preserving video anomaly detection via federated learning},
journal = {Knowledge-Based Systems},
volume = {349},
pages = {116454},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116454},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011809},
author = {Shuo Li and Fang Liu and Licheng Jiao and Jiahao Wang and Yanbiao Ma and Xinyi Wang and Yang Liu and Qianyue Bao and Xu Liu and Lingling Li and Puhua Chen},
keywords = {Video anomaly detection, Weakly supervised video anomaly detection, Federated learning},
abstract = {Video Anomaly Detection (VAD) aims to identify abnormal events in videos that significantly deviate from normal behaviors. Weakly Supervised Video Anomaly Detection (WSVAD) has attracted considerable attention because it achieves strong performance without requiring frame-level annotations. However, existing WSVAD methods still face notable limitations in terms of privacy protection and cross-institutional data sharing. In particular, data barriers between different organizations can negatively affect model performance. To address this issue, we propose a novel framework named Privacy-Preserving Video Anomaly Detection (PPVAD) via federated learning. This framework leverages a vision-language model and enables collaborative training across multiple clients through a federated learning mechanism, effectively protecting data privacy while facilitating knowledge sharing. The proposed PPVAD demonstrates strong detection performance across diverse data distributions while maintaining high robustness. Experimental results show that PPVAD achieves competitive detection accuracy and generalization capability in WSVAD settings without compromising data privacy. This work provides a new perspective for privacy-preserving WSVAD and offers a practical framework for collaborative anomaly detection in distributed surveillance systems.}
}