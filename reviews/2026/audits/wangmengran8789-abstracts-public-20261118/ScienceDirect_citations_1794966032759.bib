@article{ZHENG2026116256,
title = {Geometry knowledge-embedded self-supervised deep monocular visual odometry for autonomous driving},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116256},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116256},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009822},
author = {Donglei Zheng and Wenjie Tian and Yuqian Zhao and Fan Zhang and Gui Gui and Weihua Gui},
keywords = {Geometry embedding, Monocular visual odometry, Cross-modality feature fusion, Autonomous driving, Self-supervised learning},
abstract = {To address the underutilization of geometric priors in deep learning-based monocular visual odometry (VO), this paper presents Geometry-Embedded Visual Odometry (GE-VO), a two-stage framework that integrates classical geometric constraints with a deep pose refinement network. In the first stage, reliable geometric matching is employed to estimate an initial pose and generate a warped image, providing a high-fidelity prior for subsequent learning. Building on this, the refinement network explicitly incorporates geometric priors to ensure robust estimation in textureless regions or dynamic environments by introducing two novel modules. First, GE-VO introduces a Cross-Modality Feature Fusion Module (CMFM) that adaptively integrates RGB information with learned depth cues to enhance feature discriminability. In addition, a Geometry-Embedded Spatio-Temporal Module (GE-STM) is designed to leverage geometric constraints and temporal context for improving cross-frame alignment and pose stability under occlusion. Extensive evaluations on the KITTI and Oxford RobotCar datasets demonstrate that GE-VO consistently outperforms state-of-the-art self-supervised methods. Our results validate that the explicit embedding of geometric priors is a pivotal strategy for enhancing the accuracy and robustness of monocular VO.}
}
@article{ZHOU2026116315,
title = {NOAOM: Near-Out-Of-Distribution Awareness Optimization Module for robust graph OOD detection},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116315},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116315},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010415},
author = {Yan Zhou and Yili Wang and Xu Shen and Yi Chang and Xin Wang},
keywords = {Graph neural networks, Out-of-distribution detection, Near-out-of-distribution},
abstract = {In the current research landscape, out-of-distribution (OOD) detection and anomaly detection have gradually attracted significant attention. Various fields have proposed effective OOD detection methods, mainly focusing on accurately separating the features of OOD data from those of in-distribution (ID) data through specific techniques. Current methods can easily distinguish far-out-of-distribution (far-OOD) samples, but they still show deficiencies in handling near-out-of-distribution (near-OOD) cases. This paper proposes a novel framework that integrates a GNN encoder, a Prototype Generator, and the Near-Out-Of-Distribution Awareness Optimization Module (NOAOM), enabling the model to better detect near-OOD features. Our NOAOM can learn near-OOD features deeply and enable the model to distinguish between near-OOD and ID features precisely. Specifically, after deriving the ID data features and the prototypes through the GNN encoder and Prototype Generator, we define Near-OOD Feature Representations (NFR) and design three loss functions. The Constraint Loss is used to constrain NFR around these prototypes, ensuring the appropriate similarity between NFR and ID features. The Separation Loss is aimed at increasing the feature discrepancy between ID data features and NFR. And the Diversity Loss enables NFR to learn richer near-OOD features, thereby covering more subtle distributional variations. Eventually, the NFR exhibit high similarity to real near-OOD data, and the model can effectively distinguish NFR from ID data features, which significantly enhances the model’s OOD detection capability. Experimental results on multiple graph datasets demonstrate that the NOAOM achieves remarkable performance. It improves the performance of established OOD detection and anomaly detection models, enabling more effective identification of subtle distributional deviations.}
}
@article{MLAIKI2026116248,
title = {Adaptive manifold curvature regularization: A density-aware geometric framework for deep learning},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116248},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116248},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009743},
author = {Nabil Mlaiki},
keywords = {Wasserstein distance, Spectral regularization, Marchenko-Pastur law, Proportional–integral control, Lyapunov stability},
abstract = {We present Adaptive Manifold Curvature Regularization (AMCR), a new approach to the regularization of neural networks using geometric ideas. The central idea is to penalize curvature in the learned representations and scale the penalty according to the local concentration of training data. Unlike earlier curvature-based methods that maintain one constraint everywhere, AMCR amplifies the curvature penalty in low-density regions – where geometric estimates are unreliable and spurious curvature is hardest to detect – while moderating the penalty in high-density regions where the task loss already provides strong supervision. We provide theoretical support via generalization bounds based on Rademacher complexity, a variational characterization of the optimal density exponent, and a convergence analysis for stochastic optimization. The empirically observed value α=0.5 is consistent with the theoretical criterion but should be treated as a dataset-dependent guideline selected via cross-validation. Our algorithms work in high dimensions and are efficiently implemented. Current experiments are conducted on a synthetic two-dimensional dataset; evaluation on standard benchmarks remains as future work.}
}
@article{ZHANG2026116243,
title = {Lightweight stereo image super-resolution via adaptive pruning and bridge distillation},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116243},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116243},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600969X},
author = {Zhe Zhang and Bingzheng Liu and Lei Chen and Pengzhi Li and Yidan Zhang and Jianjun Lei},
keywords = {Super-resolution, Stereo image, Adaptive pruning, Bridge distillation},
abstract = {Stereo image super-resolution holds great practical value for stereo display technology. However, existing methods mainly focus on reconstruction quality, how to alleviate redundancy in stereo image super-resolution networks without compromising performance remains an unresolved problem. To this end, this paper proposes a lightweight stereo image super-resolution network (LightSSR) based on adaptive pruning and bridge distillation. To derive a lightweight network structure, an adaptive pruning strategy is designed to prune a teacher network by computing the importance of each layer. Additionally, a stereo bridge distillation mechanism is presented to facilitate effective inter-view information transfer by bridging the gap between the teacher and student networks. Extensive experiments on four public datasets demonstrate the efficiency of the proposed method.}
}
@article{TRAN2026116216,
title = {Efficient dataset condensation with learnable color representation and subset matching},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116216},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116216},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009421},
author = {Linh-Tam Tran and Quang Hieu Vo and Maryam Qamar and Chaoning Zhang and Hui Yong Kim and Sung-Ho Bae},
keywords = {Dataset condensation, Color representation, Subset matching},
abstract = {Dataset Condensation (DC) aims to distill knowledge from a large set of images to a smaller one to accelerate training and reduce storage requirement. However, optimizing synthetic images directly in the conventional color space (Red, Green, and Blue) is challenging due to the interdependence of texture and color information, where changes in any channel simultaneously affect both properties, limiting the ability to optimize them independently. To address this limitation, we propose a novel approach that optimizes synthetic images in the luminance-chrominance space, allowing greater flexibility in gradient updates. Building on this idea, we introduce a learnable transformation of color space parameters, enabling adaptive control over channel representations and enhancing the expressiveness of the synthetic images. Moreover, classic DC approaches rely on random mini-batch sampling from the entire real dataset, which can fail to adequately distill local texture information due to aggregation over all images. To mitigate this issue, we propose partitioning the dataset into subsets and performing distillation within each subset. This targeted subset-based strategy enables a more focused learning process, preserving and enhancing fine-grain local texture details. The proposed method, Learnable Color Representation and Subset Matching (LCSM), delivers strong performance across multiple datasets while being considerably faster than previous approaches. In particular, on the ImageNet subset, our framework maintains competitive accuracy and achieves a 25.3× speedup.}
}
@article{ZHU2026116326,
title = {Relational collaboration of multimodal triplet prompts for open-ended object detection},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116326},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116326},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601052X},
author = {Cheng Zhu and Ying Chen},
keywords = {Open-ended object detection, Multimodal, Text generation, Engineering applications},
abstract = {Open-set object detection has attracted widespread attention in engineering applications owing to its inherent complexity and uncertainty. Different from Open Vocabulary Object Detection (OVOD), which typically requires predefined categories during inference, Open-Ended Object Detection (OEOD) generates category names in a free-form manner. However, significant inconsistencies are observed in both the class name set and its alignment with scene contexts. To address the issue, a relational collaboration framework of multimodal triplet prompts (M2TP) for OEOD is proposed, which aims to capture the semantic relationship between the object category and their corresponding scenarios through the relational collaboration of multimodal prompts. Specifically, a scenario prompt is generated prior to model training by processing input images through Vision-Language Models (VLMs) to create comprehensive scene words description via hierarchical vocabulary matching and synonym expansion mechanisms. The prompt is then forwarded to the Multimodal Triplet Prompts Collaboration (MTPC) module, together with dual-granularity vision prompts at both image and object levels. The MTPC leverages attention mechanism to enhance object features through deep fusion of visual and textual information, enabling better alignment between local object details and global scene context. Lastly, LoRa-enhanced generative large language models are employed to efficiently generate precise object names with improved semantic consistency. Extensive experiments on datasets such as LVIS MiniVal demonstrate that M2TP achieves superior performance compared to the baseline, with notable improvements (+3.9% in APr, +2.2% in AP), effectively addressing the vocabulary generation inconsistency issues in open-world scenarios.}
}
@article{LI2026116347,
title = {A new paradigm for multi-source sentiment analysis and adaptation with multiple pretrained language models},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116347},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116347},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010737},
author = {Rui Li and Tao Yang and Cheng Liu and Dazhi Jiang and Si Wu},
keywords = {Sentiment analysis, Multi-source domain adaptation, Pretrained language model, Efficient training},
abstract = {Fine-tuning a pretrained language model (PrLM) with labeled sentiment data has traditionally been the standard paradigm for sentiment analysis. However, fine-tuning all model parameters is computationally expensive, and relying on a single PrLM often fails to generalize well across diverse target scenarios. Consequently, existing sentiment analysis paradigms limit the scalability of real-world applications. This limitation becomes particularly pronounced when multiple-source datasets with various distributions are involved, where performance degradation can occur due to insufficient exploitation of PrLMs and domain shift. To address these challenges, we propose a new paradigm for multi-source sentiment analysis and adaptation that harnesses multiple PrLMs through efficient feature-level enhancement. In particular, PrLMs pretrained on different resources or objectives are jointly leveraged within our framework. A differentiable selector is introduced to generate input-adaptive weights that fuse knowledge from multiple PsLMs, enabling more effective adaptation. In addition, to improve training efficiency, we extract sentiment-aware and domain-aware features as model inputs. This design not only decouples the training process from the specific PrLM backbones but also substantially improves sentiment analysis performance. To enhance generalizable adaptation, we enforce similarity between the correlation matrices of mini-batches, thereby preventing drastic feature shifts while avoiding complex pairwise domain alignment. As a result, the proposed model can be optimized efficiently in an end-to-end manner and demonstrates strong performance on widely used sentiment benchmarks. Experimental results show that our approach outperforms extant state-of-the-art methods, validating its superiority. Furthermore, extensive ablation studies confirm the effectiveness of each proposed module.}
}
@article{SI2026116180,
title = {Sequence-level watermarking for large language models},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116180},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116180},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009068},
author = {Runnan Si and Xin Xie and Junxiao Wang and Xiulong Liu and Xiaoyi Tao and Xinyu Tong and Sheng Chen and Heng Qi and Keqiu Li},
keywords = {Watermarking, LLMs, Accountability, Text classification},
abstract = {With the growing adoption of large language models (LLMs), machine-generated text could flood the Internet with fake content. Text watermarking offers an effective strategy for distinguishing between human- and machine-authored text by embedding statistical signals during the LLM token generation process. This is achieved by biasing the model toward “green tokens”—a predefined vocabulary subset identified through a secret hashing mechanism. However, existing watermark detectors often fail in realistic scenarios where short segments of watermarked text are embedded within predominantly human-written content. This manipulation disrupts local token distributions, rendering traditional statistical watermarks ineffective. To address this challenge, we introduce a novel sequence-based Longest Run (LR) detection algorithm, which identifies machine-generated text by locating the longest consecutive sequence of green tokens. Unlike prior methods that rely on local token frequency statistics, our algorithm captures global sequence-level patterns, enabling robust detection of short snippets in mixed-content settings. Notably, although our approach relies on knowledge of the specific watermarking configuration, it requires neither access to model weights nor retraining, making it practical for deployment in any system utilizing the same watermarking scheme. Through extensive experiments, we demonstrate that our approach substantially reduces false positive rates and accelerates detection speed while maintaining high accuracy.}
}
@article{XU2026116355,
title = {FedSTMeta: A Self-Evolving Federated Meta-Learning Framework for Cross-Domain Heterogeneous Spatio-Temporal Intelligence},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116355},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116355},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010816},
author = {Cecheng Xu and Guangyu Zhao and Jilong Tang and Yongcai Tong and Yang Yang},
keywords = {Traffic prediction, Federated learning, Causal inference, Neural architecture search, Privacy preservation},
abstract = {Traffic flow prediction in Intelligent Transportation Systems (ITS) is a pivotal technology for enhancing urban mobility and alleviating congestion. However, traditional centralized approaches face significant challenges, including data privacy risks, restricted cross-regional data sharing, and insufficient model generalization. While Federated Learning (FL) provides a promising paradigm for privacy preservation, existing methods still suffer from fundamental limitations in handling heterogeneous traffic patterns, adapting to dynamic network topologies, and providing model interpretability. To address these challenges, we propose FedSTMeta, a self-evolving federated meta-learning framework for cross-domain heterogeneous spatio-temporal Intelligence. Unlike existing methods that treat meta-learning, neural architecture search, and causal inference as isolated modules, FedSTMeta systematically integrates three core components through a closed-loop interaction mechanism.The Heterogeneous Cross-domain Federated Meta-learning (HCFM) mechanism employs bilevel optimization to learn universal cross-city representations and rapid adaptation strategies, providing a robust initialization for architecture search;The Self-Evolving Federated Neural Architecture Search (SEFNAS) generates high-quality personalized architectures tailored to specific city network characteristics and resource constraints via a weight-sharing supernet;The Federated Causal Explainability (FCE) framework identifies key causal drivers of traffic flow under privacy-preserving constraints. It not only provides credible causal explanations but also utilizes discovered causal relationships to guide HCFM task grouping and SEFNAS architectural constraint design. Extensive experiments on six real-world datasets demonstrate that FedSTMeta achieves highly competitive performance in terms of prediction accuracy, rapid adaptation, and interpretability, while significantly enhancing model trustworthiness. This research establishes a solid theoretical and technical foundation for the industrial-scale deployment of federated spatio-temporal intelligence.}
}
@article{CHA2026116283,
title = {Label-agnostic, Representation-Level Machine Unlearning via feature disentanglement},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116283},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116283},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010099},
author = {Soobin Cha and Jungmin Lee and Jongmin Lim and Jaehun Park and Kwangsu Kim},
keywords = {Deep learning, Machine unlearning, Privacy, GDPR},
abstract = {Machine Unlearning (MU) aims to selectively remove the influence of specific data from a trained model, driven by increasing demands for data privacy and legal compliance under regulations such as GDPR and CCPA. However, most existing MU methods rely on explicit label supervision, which is often unavailable or costly to obtain at unlearning time, and may also raise privacy concerns, as labels themselves can reveal sensitive information. Moreover, forget data often contains both information shared with retain data and information specific to itself. Removing shared information can lead to significant performance degradation on the retained knowledge. In response, we propose a Label-Agnostic, Representation-Level Machine Unlearning framework that disentangles and selectively removes only the forget data-specific representations without requiring supervision. Our approach first disentangles the representations of forget and retain data via a dedicated disentanglement objective, then re-initializes the forget-specific components while preserving shared representations. This enables targeted unlearning directly at the representation level without compromising the utility of the retained knowledge. Experimental results demonstrate that our method achieves effective unlearning performance by selectively removing forget-specific information while preserving overall model utility, enabled by a supervision-free framework that performs disentanglement-based representation forgetting and ensures strong privacy preservation under label-agnostic constraints. We report state-of-the-art performance on class-unlearning, sub-class unlearning, random sample unlearning and noisy label entry unlearning across multiple datasets and architectures.}
}
@article{DING2026116252,
title = {Hierarchy-aware prompt tuning with bidirectional information propagation for failure data mining},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116252},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116252},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009780},
author = {Yi Ding and Feng Zhu and Pai Zheng and Min Xie},
keywords = {Hierarchical text classification, Pre-trained language models, Prompt tuning, Uncertainty quantification},
abstract = {Failure-related textual data contain rich hierarchical information essential for understanding system states and supporting Operation and Maintenance (O&M) decision making. Hierarchical text classification is central to mining such data and can reduce costs and improve efficiency in the O&M activities of complex engineering systems. Yet the intricacy of failure narratives often yields suboptimal performance, especially in low-resource, few-shot settings. This paper presents a hierarchy-aware prompt tuning approach built on Pre-trained Language Models (PLMs) for few-shot hierarchical classification of failure texts. At its core is a Bidirectional Layer-wise Propagation (BLP) mechanism that injects label structure information during model learning, together with an uncertainty-quantification scheme that enhances robustness and practical applicability in O&M workflows. The proposed approach is designed to integrate seamlessly with different types of PLMs, including BERT, GPT, T5, etc. Validated on a large-scale offshore wind-turbine O&M corpus from 313 units and additionally on a public DBpedia corpus with a deeper and wider taxonomy, the approach delivers strong overall performance and remains effective under extremely low-resource conditions. These findings indicate that the framework offers a robust, data-efficient solution for failure text mining in offshore wind and a promising candidate for other industrial O&M settings.}
}
@article{XU2026116291,
title = {Egocentric-view pedestrian crossing intention prediction with limited observation: An approach based on knowledge distillation and feature decoupling},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116291},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116291},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010178},
author = {Wei Xu and Xiaobo Chen and Shilin Zhang and Fuwen Deng},
keywords = {Crossing intention prediction, Egocentric view, Knowledge distillation, Feature decoupling},
abstract = {Pedestrian crossing intention prediction (PCIP) from an egocentric view is paramount for autonomous vehicles (AVs) to ensure pedestrian safety while maintaining traffic efficiency. However, existing methods predominantly rely on long-term observation sequences and multiple input modalities, limiting their applicability in real-world scenarios with limited observation. To bridge this gap, this paper proposes a novel egocentric-view PCIP model based on knowledge distillation (KD) and feature decoupling, tailored for short-term observation and fewer input modalities. The proposed method consists of two stages. In the first stage, a teacher model with abundant inputs and long sequences is trained to accomplish accurate prediction. Then, in the second stage, a student model with only momentary observation and fewer input modalities is trained by gradually distilling the knowledge from teacher model with the assistance of multiple loss functions. To facilitate feature learning, we conceive a multi-scale dual attention (MSDA) module to discern global–local temporal dependencies and an adaptive heterogeneous feature fusion (AHFF) module to dynamically integrate multi-modal features. Moreover, we introduce a self-supervised feature decoupling (SSFD) module to spin off intention-relevant features from pedestrian motion features, mitigating distortions caused by ego-vehicle movement and other interference. Extensive experiments validate the effectiveness of the proposed approach: the teacher model achieves competitive performance compared to state-of-the-art baselines, while the student model outperforms existing methods under limited observation settings.}
}
@article{ALBAYOUK2026116319,
title = {A Multi-Agent Reinforcement Learning framework for personalized travel sequence recommendations},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116319},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116319},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010452},
author = {Razan Albayouk and Zaher {Al Aghbari} and Imad Afyouni},
keywords = {Reinforcement learning, Multi-agent reinforcement learning, Itinerary planning, Travel sequence, Route recommendation},
abstract = {Tourism presents complex challenges for itinerary planning requiring the selection and sequencing of Points of Interest (PoIs) that align with diverse user preferences, temporal constraints and spatial efficiency while avoiding overcrowding at popular attractions. Traditional single-agent recommendation systems struggle to handle these multi-objective requirements and fail to capture the interactions among multiple tourists in shared environments. Moreover, scalability becomes critical when adapting such systems to real-world scenarios with large numbers of users. This paper proposes a novel Multi-Agent Reinforcement Learning (MARL) framework for personalized and scalable travel recommendations. The framework integrates individual Travel Agents with a Crowd Management Module to balance user-specific goals and collective system objectives. To enhance scalability, an interest-based clustering strategy groups travelers with similar preferences allowing clusters to share a policy network and experience buffer trained with a Deep Q-Network (DQN) algorithm which reduces memory and training overhead. A real-world case study in Dubai and a supporting user study validate the proposed framework demonstrating its ability to generate itineraries that align with user interests, improve efficiency and mitigate overcrowding. This work highlights the potential of MARL as a scalable and adaptive solution for spatial recommendation systems.}
}
@article{ZENG2026116299,
title = {DLGCNet: Multimodal remote sensing semantic segmentation via dual diagonal low-rank adaptation and graph convolutional feature fusion},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116299},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116299},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010257},
author = {Junying Zeng and Jiahua Xu and Xudong Jia and Bin Deng and Yikui Zhai and Chuanbo Qin and Pasquale Coscia and Angelo Genovese and Xiaolin Tian},
keywords = {Multimodal fusion, Remote sensing, Semantic segmentation, Parameter-efficient fine-tuning},
abstract = {In recent years, multimodal remote sensing images (MRSI) have demonstrated complementary cross-modal information owing to their heterogeneous characteristics, enabling more detailed and effective scene interpretation than single-modality data. To address challenges in existing multimodal fusion methods, this paper proposes DLGCNet, a multimodal segmentation network that jointly optimizes a dual diagonal low-rank adaptation (D2LoRA) training framework for visual foundation models (VFMs) and a graph convolutional feature fusion (GCFF) module. To better adapt to the data distributions of MRSI, D2LoRA introduces two trainable diagonal matrices that perform row-wise and column-wise transformations on the low-rank weight matrix, thereby improving the VFM’s adaptability and feature extraction performance for MRSI. To overcome the limited cross-modal modeling capacity of convolutional neural network-based fusion and the excessive complexity of transformer-based fusion, GCFF dynamically adjusts the graph Laplacian according to modal information and establishes long-range cross-modal dependencies with lower computational complexity than transformer-based fusion methods. Experimental results demonstrate that, compared to current state-of-the-art multimodal data fusion methods, the proposed DLGCNet achieves optimal segmentation results on three datasets: Potsdam, Vaihingen, and WHU-OPT-SAR. The source code is accessible at https://github.com/2023xjh2023/DLGCNet.}
}
@article{LIANG2026116327,
title = {Causal structure-based forecasting for multivariate industrial time series under covariate drift},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116327},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116327},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010531},
author = {Xiaoxue Liang and Kuangrong Hao and Lei Chen and Jinxi Zhang and He Ding},
keywords = {Covariate drift, Invariant features, Causal structure, Static features, Shared features, Causal topology},
abstract = {In complex industrial systems, multivariate time series forecasting is crucial for production monitoring. However, covariate drift induced by changes in environmental and operational conditions during production can degrade forecast quality and even cause algorithms to fail. This is primarily because covariate drift alters the data distribution, reducing the effectiveness of the models trained on limited look-back window data. Therefore, this study proposes an effective and robust prediction model: the two-stage prediction model under covariate drift based on causal structure (TS-PMCD). In the first stage, it employs a Causal-Diff module, which integrates causal structures into a diffusion model to generate richly distributed data that comply with the first principles of industrial systems. In the second stage, an invariant feature module first uses the proposed adaptive covariate drift recognition method to accurately identify K distributions in the training data. Subsequently, it employs a shared-feature-learning-unit module to learn shared features across the K distributions and employs a graph convolutional encoder to extract static features under causal-topology constraints. Finally, the learned shared features and static features are input into a dual-channel fusion network to obtain invariant features, thereby addressing the challenge of predicting data under covariate drift conditions. Furthermore, the necessity of incorporating causal knowledge to enhance prediction accuracy was rigorously demonstrated under covariate drift conditions. Additionally, a key causal regularization loss function was derived for the model. Validation experiments demonstrated that, in terms of accuracy, TS-PMCD consistently outperformed existing algorithms under covariate drift conditions. Further, compared to state-of-the-art baseline algorithms, it achieved a root-mean-square-error improvements of 3.11 and 4.63 for horizon windows of 128 and 256, respectively, on a real-world polyester fiber polymerization dataset.}
}
@article{CHO2026116335,
title = {Internalizing persona knowledge in small language models via multi-objective contrastive learning},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116335},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116335},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010610},
author = {Suhyun Cho and Sewon Park and Jang Hyun Kim},
keywords = {Large language models, Persona knowledge, Human simulation, Knowledge internalization, Name dependence},
abstract = {This study proposes a multi-objective training framework that internalizes persona knowledge — an individual’s beliefs, judgment criteria, and speech patterns — directly into the parameters of small language models (sLLMs), eliminating the need for lengthy context injection at inference time. A 12B sLLM trained with the proposed method and performing zero-context inference outperformed GPT-4o and Claude 3.5 Sonnet under random-sampled context, and remained competitive against the stronger BM25-retrieved variants of these SOTA APIs at the same 1500-token budget—outperforming both on utterance verification (QB-YN, QB-YN-v2) with statistical significance against GPT-4o+BM25 at the speaker level, exceeding GPT-4o+BM25 numerically on value judgment (LLM-Gen), while being slightly surpassed by Claude+BM25 on this task. The 12B model also surpassed a 27B base model with random-sampled in-context learning by +0.193 on value judgment under a fixed mean-over-epochs evaluation protocol. Most existing approaches to individual simulation rely on injecting past utterances into the prompt, an approach that increases token costs and readily undermines persona consistency when contextual cues conflict. To address these limitations, we combine classification, contrastive learning, and language modeling losses to simultaneously optimize correctness, discriminability, and fluency, and propose an evaluation protocol that systematically varies context availability and name dependence. Experiments on 15 public figures drawn from QuoteBank-family corpora demonstrate that internalization training simultaneously improves both efficiency and robustness over context-based imitation, while name dependence analysis reveals that a substantial portion of SOTA models’ zero-shot accuracy stems from pretraining memorization rather than from utterance-level reasoning about the persona.}
}
@article{LI2026116287,
title = {Deep Residual Discriminative Dictionary Learning for image classification},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116287},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116287},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010130},
author = {Shuang Li and Lichun Wang and Jianjia Xin and Kai Xu and Huiyong Zhang and Shaofan Wang and Dehui Kong},
keywords = {Image classification, Hard-sample, Deep dictionary learning},
abstract = {Although promising results for image classification have been achieved, there are still some challenges in this field. For classification models, there are always some samples that are hard to be classified correctly, paying attention to these hard-samples is a possible way to help improve the classification performance. The existing methods usually focus on hard-samples by increasing the weights of misclassified samples, which makes them highly sensitive to noisy label samples. This paper proposes a Deep Residual Discriminative Dictionary Learning (DRDDL) method. DRDDL focuses on hard-samples by gradually filling in the gaps between the prediction vectors and the ground-truth label vectors, and does not pay much attention to noisy label samples. Following the idea of ensemble learning, DRDDL learns a multiple layer discriminative dictionary model. The reconstruction residual of the learned dictionary and the prediction residual of the learned classifier are transferred to the next layer, and defined as the fitting targets of the next layer. The predictions of multiple learned classifiers are combined as the final prediction. Through the multiple layer residual learning process, DRDDL learns general information at low layers and specific information at high layers, which makes the model progressively correct the classification results from easy-samples to hard-samples. Meanwhile, the clean label samples contribute more than noisy label samples, which ensures the correctness of the model optimization direction. Experiments on four well-known datasets show that DRDDL achieves high classification accuracies, and performs much more robust than other methods when there exist noisy label samples.}
}
@article{XIONG2026116334,
title = {An LLM-empowered collaborative multi-agent framework for intermittent demand forecasting of large-scale spare parts in smart manufacturing},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116334},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116334},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010609},
author = {Pan Xiong and Liping Zhang and Di Wu and Zikai Zhang and Minzhi Ruan and Yu Zhang},
keywords = {Intermittent demand forecasting, Large language model, Collaborative multi-agent systems, Retrieval-augmented generation},
abstract = {In smart manufacturing, spare parts are characterized by variety, diverse demand, and large volumes. Demand is intermittent and sparse. These characteristics pose challenges to inventory optimization and production continuity. Conventional statistical methods are not adequate for modeling demand structures with high zero inflation and sparsity. Existing feature-driven machine learning models rely heavily on expert feature engineering, and their interpretability in industrial contexts is limited. In forecasting paradigms based on large language models (LLMs), numerical time series are directly fitted. As a result, the sparsity of intermittent demand is not addressed, and the strengths of LLMs in semantic understanding, reasoning, and task coordination are not fully utilized. To address these issues, this study develops three core LLM-empowered mechanisms: context-adaptive input engineering, semantic-driven tool orchestration, and semantic label generation, each designed to leverage LLMs’ capabilities in semantic understanding and decision planning. Building on these mechanisms, an LLM-empowered collaborative multi-agent model is proposed, adopting a flexible state-graph-based coordination architecture integrating four agents. The data monitoring agent identifies anomalies to ensure input data quality; the feature extraction agent transforms raw demand sequences into adaptive representations combining statistical and deep features; the pattern classification agent assigns semantic labels to clustering results to characterize demand patterns; and the model selection agent employs a retrieval-augmented generation mechanism to dynamically match forecasting models to demand patterns. Experimental results on spare parts demand datasets from aviation, automotive, and manufacturing industries demonstrate that the proposed framework outperforms traditional statistical methods and machine learning models in forecasting accuracy and error.}
}
@article{PENG2026116268,
title = {ICPE-STKG Reasoning: Sparse Temporal Knowledge Graph Reasoning via Inverse-Causal Prior Experience Completion},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116268},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116268},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009949},
author = {Juncong Peng and Xiangliang Zhang and Ran Dong and Jibin Yin},
keywords = {Temporal knowledge graph, Sparse temporal knowledge graph reasoning, Prior experience completion, Reinforcement learning, Temporal reasoning network},
abstract = {Temporal Knowledge Graphs (TKGs) model dynamic relational data and often suffer from sparsity due to incomplete recording or forgetting, leading to reduced reasoning accuracy. This paper presents a novel framework named Sparse Temporal Knowledge Graph Reasoning via Inverse-Causal Prior Experience Completion (ICPE-STKG). Drawing inspiration from human reasoning patterns, the framework addresses challenges by first completing missing prior experiences and then performing temporal reasoning. The proposed method employs a multi-hop reinforcement learning agent that leverages reverse causality to recover critical missing facts, followed by a wavelet transform-based temporal reasoning network to capture both high- and low-frequency temporal patterns. Experiments are conducted on eight sparse variants of ICEWS14, ICEWS05-15, and WIKI. The results demonstrate that ICPE-STKG consistently outperforms state-of-the-art baselines. Specifically, our model achieves an average MRR improvement of 6.1% across three sparsity levels on ICEWS14 and a substantial 47.1% average MRR gain on ICEWS05-15, highlighting its strong robustness and effectiveness under varying degrees of sparsity. Similar improvements are observed on WIKI, further demonstrating the model’s adaptability across datasets. In addition, upper-bound experiments confirm the potential of the proposed framework, offering a scalable and effective solution for reasoning over sparse temporal data.}
}
@article{TIAN2026115969,
title = {MTformer: A physics-guided spatio-temporal transformer for complex dynamic system modeling},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {115969},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115969},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006957},
author = {Hao Tian and Xiang Zhao and Yuyang Zhao and Chuanliu Xie and Yongmei Wang},
keywords = {Spatio-temporal dynamic systems, Physical constraints, Gated transformer block, Physical systems modeling},
abstract = {Accurately modeling complex spatiotemporal dynamics in systems such as fluid dynamics and weather forecasting remains a grand challenge due to the difficulty in balancing long-range dependency with numerical stability. Conventional CNN-based and RNN-based frameworks exhibit limited capability in capturing global dependencies and suffer from substantial error accumulation. While recent Transformer-based models excel at capturing global correlations, their lack of explicit physical inductive bias causes them to overfit statistical noise instead of underlying dynamical laws, leading to the generation of non-physical high-frequency oscillations,termed ”physical artifacts”,which undermines long-horizon forecasting stability. To address these issues, we propose MTformer, a physics-guided model built upon a systematic interleaving evolution framework. Our primary contribution is the strategic integration of TD-Blocks and Fourier Neural Operators directly into the Gated Transformer backbone, enabling a self-correcting feature evolution that alternates between neural-driven attention and operator-driven physical constraints. In this architecture, the Gated Transformer captures complex spatiotemporal nonlinearities, while the TD-Blocks embed a Laplacian-type smoothness prior to mitigate non-physical drifts. Simultaneously, the FNO components refine global spectral representations to maintain multi-scale consistency. Extensive experiments demonstrate the effectiveness of MTformer. On the TaxiBJ urban traffic prediction benchmark, the proposed model achieves an MSE of 0.271 and an MAE of 14.31, outperforming all compared state-of-the-art baselines. On the Navier–Stokes benchmark for strongly nonlinear flow dynamics, MTformer also exhibits superior long-term forecasting accuracy and stability. These results indicate that the proposed framework provides a robust solution for spatiotemporal prediction by jointly leveraging global attention, spectral modeling, and Laplacian-inspired temporal regularization. Our code is available at https://github.com/Long-th99/MTformer.}
}
@article{WANG2026116215,
title = {LOGIC-AD: Cross-domain zero-shot anomaly detection via logit-space consistency},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116215},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116215},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600941X},
author = {Shengchang Wang and Yue Han and Panpan Zheng and Yongke Li and Lei Wang},
keywords = {Zero-shot anomaly detection, Cross-domain generalization, Vision-language models, Multi-scale logit fusion, Anomaly localization},
abstract = {Vision-language models such as CLIP have shown promising generalization ability in zero-shot anomaly detection, but their prediction stability often degrades in cross-domain settings. We observe that anomaly logits from different scale branches are often mismatched in magnitude and variance, making direct multi-scale fusion unreliable. To address this issue, we propose LOGIC-AD, a zero-shot anomaly detection framework that improves multi-scale fusion through logit-space consistency. Specifically, LOGIC-AD keeps the CLIP backbone frozen, extracts anomaly logits from multiple transformer layers and Gaussian spatial scales, and aligns branch-wise logits through scale-wise normalization. Based on the aligned logits, Cross-Scale Logit Alignment (CSLA) improves the comparability of anomaly responses across scales, while Anchored Constrained Fusion (ACF) constructs a stable baseline anchor and injects learnable multi-scale complementary evidence through a bounded residual term. In our setting, only lightweight fusion parameters are learned on labeled source-domain anomaly data and directly transferred to unseen target domains without any target-domain supervision. Extensive experiments on industrial and medical benchmarks show that LOGIC-AD achieves favorable results on both image-level and pixel-level anomaly detection, including 89.0% I-AUROC/90.3% I-AP on VisA, 96.4% I-AUROC/97.5% I-AP on Brain MRI, and 83.6% P-AUROC/70.1% P-PRO on ColonDB. These results validate the effectiveness of the proposed framework in challenging zero-shot cross-domain scenarios. Our code is publicly available at https://anonymous.4open.science/r/LOGIC-9DB3.}
}
@article{KIM2026116236,
title = {Leveraging graph path evidence for explainable recommender systems},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116236},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116236},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009627},
author = {Suji Kim and Namhun Kim and Jaekyeong Kim},
keywords = {Recommender systems, Explainable recommender system, Large language models, Knowledge graph},
abstract = {Existing large language model (LLM)-based explainable recommender systems often rely heavily on unstructured textual data, which limits their ability to fully exploit structural dependencies among users, items, and attributes. Consequently, these systems may exhibit shallow reasoning or generate explanations that are insufficiently grounded in explicit relational evidence. To address these limitations, we propose KAPER, a framework designed to integrate preference-aware path evidence into LLM prompts to provide structural grounding. KAPER first quantifies user–attribute preferences by employing a composite metric that integrates four complementary signals: recency, frequency, deviation, and TF-inverse document frequency. Then, these preference scores are fused with temporal decay factors and path-length penalties to selectively extract highly relevant path evidence from a knowledge graph. The extracted path evidence is incorporated into the re-ranking and explanation generation stages to provide structural grounding for the LLM. Empirical results demonstrate that KAPER consistently outperforms state-of-the-art baselines and that the incorporation of path evidence contributes to improving recommendation accuracy and explanation quality.}
}
@article{WANG2026116308,
title = {Semantic-aware and spatially-grounded multi-expert network for continuous vision-and-language navigation},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116308},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116308},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010348},
author = {Ronghu Wang and Ziyan Liu and Weidong Chen and Banghai He and Ziyou Wang},
keywords = {Vision-and-language navigation, Continuous environments, Waypoint predictor, Multi-expert network},
abstract = {Vision-and-language navigation in continuous environments (VLN-CE) requires an agent to follow natural language instructions to reach target locations in realistic 3D spaces. Most existing methods adopt a two-stage pipeline, where a waypoint predictor identifies navigable positions and a navigator plans paths and executes actions based on the predicted waypoints. However, current waypoint predictors rely solely on RGB-D observations to estimate navigability, ignoring the semantic relevance to instructions and the spatial perception of scene objects. Meanwhile, navigation planning is typically driven by cross-modal alignment, lacking integrated modeling of environmental geometry and semantic context. To address these limitations, we propose a novel coarse-to-fine waypoint predictor that ensures navigability while explicitly modeling the correspondence between language semantics and the visual scene, improving decision-making efficiency and robustness in complex environments. Furthermore, we design a multi-expert network-driven navigator to enhance generalization in unseen environments. The navigator leverages large language models to better understand complex instructions, incorporates external priors as commonsense guidance under ambiguous observations, and utilizes historical navigation memory to avoid redundant exploration. Extensive experiments demonstrate the effectiveness of our framework. On the unseen validation split of the R2R-CE dataset, our method achieves 61% success rate (SR) and 51% success weighted by path length (SPL). On the more challenging RxR-CE dataset, it obtains 63.83% normalized dynamic time warping (NDTW) and 47.60% success weighted dynamic time warping (SDTW) on the unseen split.}
}
@article{KHODJAMOV2026116189,
title = {TRIBES: Twin-driven Resilient and Intelligent Blockchain-enabled Security Framework for UAV Swarms},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116189},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116189},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009159},
author = {Narzullo Khodjamov and Song Yang and Buyu Wang and Yanan Gao and Fan Li and Sardor Mamarasulov and Jingwei Qi and Liehuang Zhu},
keywords = {UAV swarms, Blockchain consensus, Digital Twins, Anomaly detection, Privacy},
abstract = {Unmanned Aerial Vehicle (UAV) swarms operating in contested environments must achieve secure coordination, perform real-time fault detection and containment, and enforce operational policies under conditions of dynamic membership and hostile interference. However, existing approaches remain limited to addressing singular and specific issues, failing to provide a comprehensive, unified system security framework. We present TRIBES, a modular four-layer trust framework that unifies distributed consensus, online anomaly detection with the Digital Twin (DT) technique, privacy-preserving attestation, and resilient dual-path communications without centralized infrastructure. The architecture anchors a lightweight Directed Acyclic Graph (DAG) ledger with a reconfigurable Practical Byzantine Fault Tolerance (PBFT) committee, achieving sub-second finality in typical operation. Simulation studies with realistic swarm dynamics under spoofing, jamming, and Sybil attacks demonstrate that TRIBES sustains auditable trust decisions with low tail latency, while DTs detect compromised behavior with high accuracy and few false alarms. Privacy is preserved through differential perturbation and simulated zero-knowledge attestations, enabling on-chain enforcement of geofencing and other operational policies. Compared with decentralized baselines, TRIBES reduces worst-case consensus latency by about one-third and maintains swarm coordination even under targeted disruption.}
}
@article{YAN2026116316,
title = {FreqMamba: Frequency-aware multi-graph fusion with Mamba for traffic flow prediction},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116316},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116316},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010427},
author = {Xin Yan and Xiaohang Zhao and Haiyang Chi and Qingwang Wang and Hui Fu and Sunyan Hong and Jun He and Wenxuan Zhu and Lixue Liu and Bidong Chen and Yirong Zhu},
keywords = {Traffic flow prediction, Frequency decomposition, Multi-graph fusion, Spatiotemporal correlations, State space model},
abstract = {Accurate traffic flow prediction is fundamental to intelligent transportation systems, yet existing spatiotemporal graph neural networks face three critical limitations: inadequate exploitation of multi-scale temporal patterns, suboptimal graph construction that fails to capture heterogeneous spatial dependencies, and computational inefficiency in long-sequence modeling. To address these challenges, we propose FreqMamba, a frequency-aware multi-graph fusion framework integrated with Mamba-based temporal modeling for robust traffic flow forecasting. Specifically, our approach introduces three key innovations: First, the discrete wavelet transform explicitly decomposes traffic signals into low-frequency trend components and high-frequency event components, enabling decoupled learning of persistent patterns and transient anomalies. Second, we construct specialized event graphs, trend graphs, and critical-node graphs that capture pattern-specific spatial relationships, with attention-based fusion mechanisms adaptively integrating complementary information across graph structures. Third, we incorporate a selective state space model to achieve efficient long-range temporal dependency modeling with linear computational complexity, overcoming the quadratic bottleneck of Transformer-based approaches. Extensive experiments on four real-world datasets demonstrate that FreqMamba consistently outperforms 20 state-of-the-art baselines, achieving average improvements of 0.65%–5.33% in MAE while reducing training time by up to 12.40% and memory consumption by up to 17.59% compared to competitive methods. Moreover, generalization experiments on four additional datasets demonstrate its consistent effectiveness. Ablation studies, efficiency analyses, and case analyses further validate the effectiveness of each architectural component, confirming FreqMamba’s ability to simultaneously achieve high prediction accuracy, computational efficiency, and robustness across diverse traffic scenarios.}
}
@article{LI2026116217,
title = {MemGAN: Hallucinating robust knowledge memorized in pre-trained GANs latent space for few-shot image generation},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116217},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116217},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009433},
author = {Wenkuan Li and Ming Li and Haifang Li},
keywords = {Generative adversarial network, Few-shot image generation, Pre-trained model finetune, Semantic disentanglement, Uncertainty-aware mixup},
abstract = {Few-shot image generation aims to synthesize diverse images for new unseen classes with limited conditional inputs. To make full use of limited conditional data per class, the prevalent paradigm is to fuse the representation vectors of conditional images according to their semantic similarity in the embedding space. However, when only one sample each unseen class is available, this fusion-based strategy will fall into mode collapse where the synthetic images exhibit a single pattern. In this paper, we propose a novel finetune-based generation paradigm to alleviate the one-shot dilemma by exploiting prior knowledge memorized in pre-trained GANs latent space as an auxiliary reference, dubbed MemGAN. Specifically, we first pre-train GANs with a generic image-to-image translation task on the training set to encode generalizable knowledge into its latent space and explore both maximum intra-class margins and base-class embeddings. A closed-form disentanglement is developed to explicitly decompose reusable prior knowledge of pre-trained latent space via aligning with the conditional input at the same semantic space, refining prior knowledge as a reliable reference. A learnable uncertainty-aware mixup is finetuned to adaptively integrate the disentanglement knowledge with a conditional input at different levels of the latent space, promoting the intra-class diversity and base-class consistency of mixup generation references. With robust auxiliary reference to stimulate pre-trained generator, MemGAN could dispersively push a conditional point to various points at the same class space, so as to generate diverse images at the one-shot case. Extensive experiments validate the effectiveness of MemGAN at one-shot setting without additional test-time adaptation.}
}
@article{LIU2026116269,
title = {Endo-DGAN: An unsupervised highlight restoration method for endoscopic videos based on Diffusion-GAN},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116269},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116269},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009950},
author = {Yichen Liu and Yuchen Zhou and Yu Dai and Jianxun Zhang},
keywords = {Endoscopic videos, Highlight restoration, GANs, Diffusion mechanism},
abstract = {In minimally invasive surgery (MIS), endoscopic imaging is a widely used visualization method. However, smooth organ surfaces often cause specular highlights, which significantly degrade diagnostic accuracy. Therefore, developing a reliable network for highlight restoration is necessary. Current highlight restoration methods employ supervised learning to train models, but acquiring large-scale datasets with ground truth free from highlights remains challenging. To address this issue, we propose a method that integrates generative adversarial networks (GANs) with diffusion models, using the segmented masks as a substitute for real annotations. We design a diffusion-based discriminator that integrates a controlled diffusion process into adversarial training, where a forward diffusion chain generates structured instance noise following a Gaussian mixture distribution to stabilize optimization and improve feature realism. We also introduce a Frequency Separation Fusion Module (FSFM) to decouple and separately enhance low- and high-frequency components of endoscopic features, enabling dedicated restoration of global anatomical structures and local texture details. At the same time, by leveraging the temporal properties of Transformers, our approach performs highlight restoration on sequential endoscopic frames. Extensive experiments show that the proposed method achieves exceptional performance in real-time removing highlights from endoscopic sequences, which provides a solid foundation for enhancing subsequent vision tasks.}
}
@article{DUAN2026116253,
title = {PoDe-SORT: Robust multi-object tracking by modeling bounding box deformation},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116253},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116253},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009792},
author = {Shuaipeng Duan and Shengbing Zhang and Meng Zhang},
keywords = {Multi-object tracking, Data association, Bounding box deformation, Pose-Aware IoU, Depth-Aware Cascade Matching},
abstract = {Maintaining accurate data association is crucial for the robustness of a multi-object tracker (MOT). However, existing state-of-the-art methods often overlook the deformation effect during object motion. This oversight leads to significant deviations in object similarity, thereby limiting association accuracy in complex scenes. To address this, we propose a deformation modeling framework based on the geometry of perspective projection. This framework decouples the impact of motion on bounding boxes into two types: anisotropic deformation driven by pose changes and isotropic scaling driven by depth displacement. Accordingly, we design two lightweight modules: Pose-Aware IoU (PAIoU) and Depth-Aware Cascade Matching (DACM), to model these deformations respectively. These modules are training-free and plug-and-play, allowing for seamless integration into mainstream trackers with minimal computational overhead. By integrating PAIoU and DACM, we construct a lightweight online tracker named PoDe-SORT, which offers a systematic solution for robust tracking from the perspective of deformation modeling. Experimental results demonstrate that PAIoU and DACM achieve consistent performance improvements across five mainstream trackers (e.g., SORT, DeepSORT, and ByteTrack). Furthermore, PoDe-SORT performs exceptionally well on benchmarks such as MOT17, MOT20, and DanceTrack, exhibiting superior performance compared to state-of-the-art trackers based on Attention, Embedding, and Motion paradigms. Notably, on the DanceTrack dataset, characterized by irregular motion and dense crowds, PoDe-SORT significantly outperforms the baseline OC-SORT (improving HOTA by 4.9% and IDF1 by 5.9%). These results strongly validate the effectiveness of our deformation modeling approach in addressing robust tracking challenges.}
}
@article{NOUBOUKPO2026116312,
title = {Semi-supervised flow-augmented Gaussian mixture VAEs with weighted contrastive learning for out-of-distribution detection},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116312},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116312},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010385},
author = {Adama Nouboukpo and Mohand Saïd Allili},
keywords = {Out-of-distribution detection, Semi-supervised learning, Variational autoencoders (VAEs), Flow-based GMM clustering},
abstract = {Out-of-distribution (OOD) detection is essential for the safe deployment of machine learning systems, particularly in high-stakes domains where identifying inputs that deviate from the in-distribution (ID) is critical. However, in real-world scenarios, true OOD data are typically unavailable at training time, and only auxiliary datasets acting as imperfect proxies can be used. This makes fully supervised approaches impractical and potentially biased toward specific anomaly types. To address this limitation, we propose FLoW-ssGMVAE, a semi-supervised generative–discriminative framework that leverages limited proxy anomaly supervision together with abundant unlabeled data for robust OOD detection. Our model integrates a flow-augmented Gaussian Mixture VAE, enabling flexible latent modeling that captures nonlinear and multimodal intra-class distributions. Unlike standard VAEs with unimodal Gaussian priors, it uses class-conditional normalizing flows to better represent complex ID and OOD variability. To further refine the latent space and strengthen ID/OOD separation, our model integrates a weighted contrastive learning objective guided by sample-wise attention scores derived from likelihood uncertainty. This mechanism emphasizes ambiguous or hard-to-classify instances, reinforcing semantic boundaries and reducing false detections. By combining expressive generative modeling with uncertainty-aware discriminative training, our method constructs a structured and interpretable latent space that reliably identifies OOD samples under limited supervision. Experiments on standard benchmarks validate the effectiveness and scalability of our approach, demonstrating state-of-the-art performance with reasonable computational cost. Our implementation will be available at: FLoW-ssGMVAE.}
}
@article{ZHONG2026116288,
title = {A robust multi-object tracking framework based on local feature matching and dynamic feature exchange},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116288},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116288},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010142},
author = {Jiaqi Zhong and Huaming Qian and Peng Ding},
keywords = {Object tracking, Feature matching, Adaptive motion compensation, Dynamic feature exchange},
abstract = {In multi-object tracking within dynamic scenarios, challenges such as matching ambiguity and identity switches frequently arise owing to factors such as similar object appearances, frequent occlusions, and camera motion. To address these issues, this paper proposes a multi-object tracking framework that integrates local geometric features with adaptive motion modeling to enhance the tracking stability in dynamic environments. This method first introduces a trajectory-aware local feature-matching mechanism. It combines the SuperPoint and SuperGlue algorithms to establish the association between trajectories and detections, and effectively differentiates between background and foreground objects through dynamic motion decomposition. Secondly, a Quality-Aware Adaptive Camera Motion Compensation (QA-CMC) module is designed, which can perform real-time evaluation of the quality of motion estimation and dynamically adjust the compensation strategy based on a three-level decision-making mechanism without supervision, thereby suppressing the propagation of incorrect compensation. Furthermore, a motion–appearance adaptive distance (MAAD) metric is proposed, which dynamically fuses motion and appearance information according to the reliability of motion prediction and visual features, thereby improving the matching robustness in complex environments. Finally, a Dynamic Feature Swap Network (DFSNet) is designed to enhance the feature discriminability by enabling controlled feature interactions between neighboring objects or objects that are similar in appearance. This mechanism effectively improves the capability to distinguish between similar objects and re-identify them after occlusion. Experimental results on public multi-object tracking benchmarks demonstrate that the proposed method surpasses state-of-the-art approaches across multiple key metrics, validating its effectiveness and advancement.}
}
@article{CHENG2026116320,
title = {DGPT: Domain-guided prompt tuning for improved generalization in vision-language models},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116320},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116320},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010464},
author = {Keyang Cheng and Haoming Hou and Liutao Wei and Hao Wan and Xin Guan and Akira David Diaz Campaña},
keywords = {Visual-language model, Prompt tuning, Few-shot},
abstract = {Prompt tuning, which fine-tunes learnable prompt vectors using limited few-shot data, has emerged as an effective strategy for adapting CLIP to downstream tasks. However, existing methods predominantly focus on optimizing for specific tasks or datasets, causing significant overfitting to the data distribution and thus reducing performance in unseen domains or novel categories. To overcome these limitations, we propose a Domain-Guided Prompt Tuning (DGPT) framework. DGPT employs a dual approach designed to mitigate overfitting while retaining robust generalization capabilities. Specifically, DGPT constructs a learnable base-domain statistics space as a lightweight domain-guided prior, which facilitates synthesizing domain-aware correction signals for unseen domains via weighted combinations. Moreover, DGPT incorporates a cross-contrastive learning mechanism to constrain alignment between a modality branch with added prompts and a modality branch with frozen parameters, effectively reducing biases in downstream task adaptation. Extensive evaluations are conducted across three distinct downstream tasks—base-to-novel generalization, cross-dataset transfer, and domain generalization—spanning 11 benchmark datasets, together with additional robustness evaluation under blur, low-light, and adverse-weather degradations. Experimental results demonstrate that DGPT achieves consistent improvements over strong prompt tuning baselines, with gains of 0.38%, 0.25%, and 0.72% on the three main evaluation settings, respectively, indicating its effectiveness for few-shot classification under domain-shifted conditions.}
}
@article{ZHENG2026116221,
title = {Completing knowledge graph via multi-geometric with metric alignment and curvature scheduling},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116221},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116221},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009470},
author = {Meilin Zheng and Weihua Ou and Jiaming Li and Deyu Meng and Yong Xu},
keywords = {Knowledge graphs, Knowledge graph completion, Isometric processing, Curvature scheduling, Spectral regularization},
abstract = {The inherent incompleteness of knowledge graphs (KGs) has driven extensive research in the field of knowledge graph completion (KGC). Most current KGC methods are based on the construction of multiple geometric spaces to capture the heterogeneous structure of KGs. However, when performing unified modeling across multiple geometric spaces, there is a problem of inconsistent cross-space metrics, which makes curvature prone to instability during training. To address these challenges, this manuscript proposes a novel KGC framework, Multi-Geometric Metric Alignment and Curvature Scheduling (MG-MACS). Specifically, MG-MACS performs isometric processing across different geometric spaces, aligning multiple branches to a shared tangent space to avoid distance distortion between geometries. Building upon this, we present a curvature scheduling scheme that gradually anneals the scoring curvature from a near-Euclidean starting point to a target value according to a prescribed schedule, thereby controlling gradient amplification and enhancing training stability. Finally, we introduce spectral regularization during the optimization phase to suppress high-frequency noise introduced by false negatives. Extensive experiments on three standard KGC benchmarks demonstrate that MG-MACS consistently outperforms strong state-of-the-art models on link prediction, exhibiting more stable performance across datasets with different structural characteristics.}
}
@article{HSUSH2026116296,
title = {Sequence- and item-level contrastive learning via diffusion-based data augmentation for sequential recommendation},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116296},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116296},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010221},
author = {Sue-Chen Hsush and Tsung-Yu Lu and Ming-Yen Lin},
keywords = {Sequential recommendation, Diffusion-based data augmentation, Contrastive learning, False negatives, Negative filtering, Item attributes},
abstract = {Sequential recommendation models increasingly rely on self-supervised contrastive learning to mitigate sparse supervision. However, standard in-batch negative sampling often introduces "false negatives" due to inherent semantic overlap and shared user preferences, which compromises representation learning and degrades recommendation quality. Furthermore, conventional random augmentations frequently fail to preserve user intent, leading to noisy views. To address these challenges, we propose SID4SRec, a novel framework that integrates diffusion-based sequence augmentation with false-negative-aware contrastive learning. SID4SRec introduces distance-based negative filtering at both sequence and item levels to effectively suppress semantically overlapping negatives during training. Additionally, it incorporates lightweight item attributes (category/brand) to construct attribute-informed item representations and guide item-level contrastive signals. Experiments on three public Amazon datasets (Beauty, Sports, and Toys) demonstrate consistent improvements over strong diffusion- and contrastive-based baselines, achieving relative gains in NDCG@20 of 35.79%, 39.25%, and 48.84%, and relative gains in HR@20 of 27.22%, 30.60%, and 31.68%, respectively, over the best baseline. Experiments on MovieLens-1 M further validate the cross-domain consistency of SID4SRec. Our results indicate that explicitly addressing false negatives through semantically coherent diffusion-based views and dual-level filtering yields more reliable representation learning for sequential recommendation tasks.}
}
@article{YIN2026116304,
title = {Noise-Free Domain Adaptation for barely supervised 3D seismic fault detection},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116304},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116304},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010300},
author = {Ruonan Yin and Timing Li and Xinming Wu and Kewen Li and Yingjie Zhu},
keywords = {Seismic fault detection, Barely supervised learning, Domain adaptation, Semisupervized learning, Seismic interpretation},
abstract = {Volumetric annotations for 3D seismic fault detection are difficult to obtain, while models trained on synthetic data often generalize poorly to field data. Therefore, this study investigates an urgent yet challenging problem in the industry, detecting 3D faults when only extremely limited field annotations are available, a setting known as barely supervised Learning (BSL). In this setting, only a few training samples are annotated, each with a single slice, which often prevents supervised methods from converging. Existing BSL methods generate volumetric annotations through image registration; however, the variability of seismic images often leads to registration failures. Motivated by these challenges, we propose Noise-Free Domain Adaptation (NFDA), a simple yet effective framework for barely supervised fault detection. NFDA first introduces a noise-free label construction (NLC) mechanism that synthesizes volumetric labels from slice annotations, mitigating the lack of supervision caused by overly sparse annotations. Then, NFDA employs Frequency CutMix (FCM) and class-level pseudo-label selection (CLPS) to reduce domain shift between NLC-synthesized and unlabeled samples, thereby improving generalization to unlabeled data. Extensive experiments on both synthetic and field datasets demonstrate that NFDA significantly outperforms existing state-of-the-art BSL methods. Notably, in quantitative experiments, NFDA achieves a Dice similarity coefficient of 63.39% using only 10 labeled slices.}
}
@article{KIM2026116284,
title = {Towards refined unlearning: Utilizing the retain knowledge subspace and noise reduction},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116284},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116284},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010105},
author = {EunSun Kim and YeoJun Choi and Yoon-Sik Cho},
keywords = {Machine unlearning, LLM unlearning},
abstract = {When large language models (LLMs) are adapted to a task, they are often fine-tuned on data that may contain sensitive information. This creates a need for effective unlearning methods to address privacy concerns. Among various unlearning methods, a recent line of work introduces a simple yet effective approach through arithmetic operations on task vectors. Despite their effectiveness, existing task vector-based unlearning methods in LLM still suffer from entangled representation. They also overlook the layer-wise roles of Transformers. In this paper, we propose ERASOR (unlEarning via low-RAnk projection in Subspace with ORthogonal bases), a new unlearning method in LLMs. We found that applying singular value decomposition directly on retain knowledge vectors performs better in unlearning than the previous approach with subspace over the whole model parameters. Additionally, we apply a noise reduction strategy using the explained variance, which preserves retain knowledge subspace in each layer by adjusting its dimensionality according to the layer-specific role. Extensive experiments across diverse unlearning benchmarks and model settings show that ERASOR achieves precise and robust unlearning while maintaining model performance on retained knowledge. Remarkably, it achieves about 63–85% unlearning effectiveness with only a 10% reduction in retained knowledge. The code for ERASOR is available at https://github.com/sun1187/ERASOR.}
}
@article{LIU2026116280,
title = {SkyPose: Skeleton consistency guided diffusion model for 3D human pose estimation},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116280},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116280},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010063},
author = {Xuguang Liu and Yong Wang and Wenxiu Dan and Wenming Yang},
keywords = {3D human pose estimation, Diffusion model, Skeleton consistency constraint},
abstract = {Although diffusion models have demonstrated promising potential in 3D human pose estimation, existing approaches commonly adopt fixed noise variance scheduling strategies. This design overlooks the skeletal consistency constraints that should be maintained between 2D observations and 3D predictions during iterative denoising. Consequently, the generated 3D poses often exhibit geometric inconsistencies with the input 2D poses, thereby degrading the overall reconstruction quality. To address this limitation, we propose SkyPose: Skeleton Consistency Guided Diffusion Model for 3D Human Pose Estimation. The proposed method enforces skeletal consistency by reprojecting the previously generated 3D pose onto the 2D plane, decomposing it into skeletal direction and length, and comparing it with the input 2D skeletal structure to construct a dynamic skeletal consistency metric. This metric adaptively adjusts the noise variance σt during DDIM iterations, explicitly preserving skeletal structural coherence throughout the denoising process and enhancing the geometric fidelity of the generated 3D poses. Furthermore, we redesign the denoising network architecture to integrate skeletal structure features with joint coordinate features at the local joint, body-part, and full-body levels, thereby enabling joint–skeleton collaborative denoising under multi-granularity geometric constraints. Extensive experiments on the Human3.6M and MPI-INF-3DHP datasets demonstrate that our approach achieves superior accuracy compared with existing methods. The code is open-sourced at here.}
}
@article{ZHANG2026116332,
title = {DuaFed: A clustered federated learning framework via dual-domain feature alignment for tackling data heterogeneity},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116332},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116332},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010580},
author = {Shining Zhang and Xingwei Wang and Rongfei Zeng and Chao Zeng and Jihao Liu and Yu Gu and Min Huang},
keywords = {Cloud-edge collaboration, Federated learning, Data heterogeneity, Dual-domain feature alignment, JointCloud},
abstract = {Cloud-edge collaboration establishes a distributed architecture by harmonizing the computational power of the cloud with the responsiveness advantages of the network edge. Nevertheless, the architecture of centralizing raw data from the edge to the cloud is constrained by communication costs and privacy concerns. Federated Learning achieves participants to collaboratively train a global model without centralizing their raw data. It provides feasible support for JointCloud, where heterogeneous participants cooperate without disclosing local data. However, a key challenge in federated learning is the data heterogeneity. While clustered federated learning has been proposed to mitigate this issue by grouping similar clients into clusters, existing clustered federated learning frameworks commonly fail to accurately cluster clients, as they rely on single-domain features for client representation. In addition, the aggregation of cluster models will introduce negative transfer, which degrades the generalization performance of the global model. In this paper, we propose DuaFed, a clustered federated learning framework via dual-domain feature alignment. Specifically, DuaFed introduces a Dual-domain Feature aligned One-shot Clustering (DFOC) strategy that constructs dual-domain features to mine multi-dimensional similarities among clients. Dual-domain features capture insights from both the directions of model updates and characteristics of the data. Furthermore, we design an Adaptive Inter-Cluster Aggregation (AIC) mechanism that adaptively weights cluster models for global aggregation based on the cross-domain portability in the dual-domain feature space. Finally, a Curvature-aware Momentum Optimization (CMO) algorithm is designed to dynamically tune momentum and learning rate by assessing the directional consistency of consecutive gradients for stable optimization. Extensive experiments demonstrate that DuaFed significantly improves accuracy in heterogeneous scenarios while reducing communication rounds compared to baselines.}
}
@article{KUMAR2026116245,
title = {A multi-modal Parkinson’s disease diagnosis methodology analyzing online handwriting and EEG signal utilizing multi-headed attention based deep learning model},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116245},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116245},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009718},
author = {Kaushal Kumar and Rajib Ghosh},
keywords = {Parkinson’s disease, EEG signals, Handwritten tasks, Multi-headed attention, BLSTM},
abstract = {Parkinson’s disease (PD) is a progressive neurological disease leading to progressive motor function decline, affecting writing, speech, mobility, and muscle control. Current research has not explored the simultaneous use of online handwriting tasks and electroencephalography (EEG) signals for PD diagnosis, particularly from critical regions such as the ventral tegmental area (VTA) and substantia nigra (SN), which are vital for dopamine production. This study presents a multi-modal PD diagnosis method that integrates EEG data recorded from the VTA and SN during online handwriting tasks with corresponding handwriting data. Convolutional neural networks (CNN) are employed to extract features from a combined feature matrix, which are refined using a multi-headed attention layer and classified with a bidirectional long short-term memory (BLSTM) network. Performance is benchmarked against bagged random forest (BRF), support vector machine (SVM), and long short-term memory (LSTM) classifiers. The introduced PD diagnosis methodology is examined utilizing the self-created dataset EEG signal based online handwriting (ESOH). The results indicate that this system surpasses current state-of-the-art methodologies that rely exclusively on EEG signals.}
}
@article{MENG2026116237,
title = {Task-oriented medical image super-resolution via target prior guidance},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116237},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116237},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009639},
author = {Yuxiang Meng and Dengwen Zhou and Shaoxin Li and Feiyue Huang and Xingkun Xu and Lifeng Zhu and Yuchen Xu and Fan Tang},
keywords = {Super-resolution, Medical image classification, Downstream task performance, Prior guidance, Contrastive learning},
abstract = {Mainstream medical image super-resolution (SR) methods predominantly emphasize subjective visual quality, often neglecting the reconstruction of diagnostic features critical for clinical decision-making. Traditional SR approaches, driven by visual perception objectives, fail to distinguish lesion details from background noise, which negatively impacts the performance of downstream diagnostic tasks. To address these limitations, we propose a novel task-oriented SR network that integrates diagnosis-related priors to enhance the multi-level feature encoding process, effectively separating lesion details from noise. To thoroughly validate the effectiveness and generalizability of our method, we design experiments under diverse settings involving different data sources and backbone architectures, covering multiple application scenarios to simulate variations across clinical environments. Our method surpasses existing approaches by not only refining diagnostic features but also achieving superior adaptability across datasets and backbones. Experimental results show that the proposed framework consistently improves downstream diagnostic classification performance over existing SR methods, and in several settings even outperforms directly using the corresponding preprocessed HR inputs for the downstream classifier.}
}
@article{GINANJAR2026116265,
title = {Learning from tabular data with out-of-distribution characteristics},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116265},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116265},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009913},
author = {Achmad Ginanjar and Xue Li and Priyanka Singh and Wen Hua},
keywords = {Tabular data, Continual learning, Out-of-distribution, Contrastive learning, Machine learning efficiency},
abstract = {Out-of-distribution (OOD) data presents significant challenges for machine learning models, frequently resulting in reduced performance. This study investigates the effects of OOD data on tabular datasets and introduces continual tabular contrast learning (C-TCL), a novel method for managing OOD scenarios while maintaining model performance. The study provides a detailed guide for implementing an existing method to detect, separate, evaluate, and visualize OOD data using real-world datasets. It also assesses the performance of current tabular machine learning algorithms for managing OOD data and compares their effectiveness to that of C-TCL. By leveraging a continual learning paradigm, C-TCL enables models to adapt to new data distributions that differ from the training data. Extensive experiments on eight datasets demonstrate that C-TCL outperforms existing methods, delivering better results with reduced computational overhead.}
}
@article{FANG2026116260,
title = {A method for transportation geographic entity recognition integrating transfer learning and data augmentation},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116260},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116260},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600986X},
author = {Jun Fang and Yachang Liu and Fen Ye and Yubin Lei and Yongyu Tian and Mingpu Zou and Qilin Yang and Zhensheng Yang},
keywords = {Named entity recognition, Transfer learning, Data augmentation, Transportation corpus, Transportation geographic entity},
abstract = {Rapid urban expansion and advances in information technology are pushing transportation systems toward more refined and intelligent management. This trend creates a growing need for transportation knowledge graphs and structured semantic representations. In transportation data, geographic entities play a central role in organizing semantic and spatiotemporal information, such as roads, facilities, locations, and spatial relations. However, current Named Entity Recognition (NER) models are difficult to transfer to this domain, as they often struggle with ambiguous boundaries, long-tail entity types, and the complex spatial and temporal attributes of transportation text. To address these challenges, this paper proposes an NER method integrating transfer learning and data augmentation. It employs Bidirectional Encoder Representations from Transformers (BERT) for transportation-domain transfer learning, incorporates a Conditional Random Field (CRF) to enhance entity boundary identification, and introduces an improved PLMA (Pseudo-Label and MixUp Augmentation) data augmentation strategy. On the transportation corpus, the proposed method achieves an F1-score of 83.1 %. This is 2.4, 3.1, and 4.9 percentage points higher than RoBERTa-BiLSTM-CRF, BERT-BiLSTM-CRF, and BiLSTM-CRF, respectively. Taken together, the method and corpus developed in this study provide technical support and semantic data resources for advancing real-scene 3D transportation applications and intelligent transportation systems.}
}
@article{DUAN2026116184,
title = {Remaining useful life prediction of mechanical components using multistate transfer learning and multiphase control charts},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116184},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116184},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600910X},
author = {Chaoqun Duan and Yifan Guo and Kanghao Guo and Fuqiang Liu and Huayan Pu and Jun Luo},
keywords = {Prognostics and health management, Condition monitoring, Health prediction, Mechanical system},
abstract = {Accurate prediction of the remaining useful life (RUL) is crucial for enabling predictive maintenance and ensuring the safe and efficient operation of mechanical equipment. However, existing research works typically employ a single-state prognostics model for RUL prediction, without accounting for stage-specific variations in degradation behaviors, which may not adequately capture the inherently multiphase nature of the degradation process. To this end, we propose a RUL prediction approach using multistate transfer learning and multiphase control charts for mechanical components subject to varying operational conditions. Given the stage-specific variations in component degradation, a multiphase autoregressive (MPAR) model is first presented to characterize degradation behaviors, and a multiphase control chart based on this model is developed to dynamically identify each degradation stage. Building on the transition mechanism of the multiphase control chart, a multistate transfer learning approach using deep correlation alignment is then proposed for RUL prediction under varying operating conditions, in which a multiscale weighted convolutional neural network (MSWCNN) is introduced to learn stage-dependent degradation features and supply transferable representations for cross-condition adaptation. Finally, a prognosis framework driven by the transition mechanism of the multiphase control chart is presented to predict the RUL of mechanical components stage by stage. Experiments on two datasets demonstrate that the proposed method achieves superior RUL prediction performance compared with recently published approaches.}
}
@article{MA2026116257,
title = {Balancing coverage and width: A robust adaptive interval prediction model in the supervised learning framework},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116257},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116257},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009834},
author = {Jia Ma and Kexian Li and Can Luo and Zhu Huang and Shuai Dong and Lairong Yin},
keywords = {Interval prediction, Neural network, Supervised learning, Width coefficient, Uncertainty quantification},
abstract = {In recent years, neural network-based interval prediction methods have attracted considerable attention because of their strong capability in uncertainty quantification. However, due to the inherent challenge of unknown true interval boundaries, most existing methods rely on unsupervised learning frameworks, limiting further improvements in prediction accuracy. To overcome this limitation, this paper presents a novel interval prediction method. By incorporating a supervised learning mechanism into interval prediction tasks, the proposed approach remains compatible with widely used mean square error loss function and standard gradient descent training processes. The method begins by reconstructing training data into intervals through the introduction of a width coefficient, thereby generating supervised samples in the form of upper and lower boundaries. Subsequently, a training framework for interval prediction tasks is proposed, leveraging width coefficient optimization. To improve interval prediction reliability and performance, a coverage-based reliability acceptance criterion is designed, complemented by an error control criterion based on the interval center deviation index, thereby forming an adaptive width coefficient adjustment mechanism. By alternately performing neural network training and interval-data reconstruction, the method effectively constructs a high-quality interval prediction model. Experimental results on three real cases (rotor health monitoring, concrete compressive strength prediction, and wind speed forecasting) demonstrate that the proposed method outperforms four state-of-the-art interval prediction approaches in both prediction accuracy and interval quality. Under the premise that the interval reliability satisfies the preset confidence requirement, the proposed method achieves performance improvements of at least 4.3 %, 12.9 %, and 33.3 % in interval width evaluation metrics across the three case studies.}
}
@article{CHEN2026116153,
title = {DEFINED: A data-knowledge synergistic framework for few-shot class-incremental fault diagnosis},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116153},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116153},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008798},
author = {Chen Chen and Xiaosheng Si and Zhaoqiang Wang and Zeming Zhang and Changhua Hu},
keywords = {Fault diagnosis, Rotating machinery, Few-shot, Class-incremental learning, Data-knowledge synergistic, Catastrophic forgetting},
abstract = {In complex operating environments, mechanical systems may continually generate new fault types, while the data for these emerging faults remains scarce. Diagnosis models must quickly learn new scarce faults while preserving diagnostic capability for existing ones, making developing a stable diagnostic framework challenging. Class-incremental learning-based diagnosis methods suffer from representational biases regarding these new faults, leading to catastrophic forgetting. Furthermore, the scarcity of newly emerging fault data results in overfitting, which exacerbates catastrophic forgetting. These challenges are formally known as Few-Shot Class-Incremental Fault Diagnosis (FS-CIFD), requiring models to balance retaining previously acquired diagnostic capabilities while continuously adapting to new fault types, despite scarce data availability. To address this, we propose the Data-knowledge Synergistic Framework for Few-shot Class-Incremental Fault Diagnosis (DEFINED), which integrates prior knowledge into the diagnostic process, effectively complementing the fault features of scarce samples and guiding the model to learn generalized representations. Specifically, we propose the data-knowledge synergistic calibration module, which leverages prior knowledge to guide attention mechanisms in correcting representational biases toward new faults, alleviating catastrophic forgetting. In addition, we construct dynamically knowledge-guided pseudo-incremental tasks, creating a more generalized representation space between new and old fault types. This enables the model to extend its diagnostic capability to forthcoming faults, thereby mitigating overfitting. DEFINED effectively tackles the challenges of overfitting and catastrophic forgetting in FS-CIFD tasks. Incremental experiments under three distinct datasets demonstrate its superiority over existing methods. It achieves an accuracy of 87.86% even under continuously varying operating conditions, outperforming its counterparts by at least 4.37%.}
}
@article{KUMAR2026116242,
title = {Trustworthy privacy-preserving federated learning for urban sensing: Simultaneous mitigation of inference and poisoning attacks},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116242},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116242},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009688},
author = {Lingam Srinivas Ram Kumar and Dheeraj Kumar},
keywords = {Federated learning, Poisoning attack, Inference attack, Anomaly detection, Trustworthy, Urban sensing, Participatory sensing},
abstract = {Federated learning is a collaborative distributed machine learning paradigm that does not require participating users to share their raw data with the application server for model training. Still, privacy threats like gradient leakage, inference attacks, and reverse model attacks emerged, challenging the core principle of federated learning. Different techniques that hide individual participants’ local model updates from the aggregator were developed to tackle such threats. Moreover, federated learning is also prone to poisoning attacks, where a user or a group of users attempt to degrade the performance of the learning task or modify the final model by using incorrect data to train the application model. Detecting and mitigating these poisoning attacks requires the application server to analyze the local model updates submitted by the individual users before their aggregation into a global model. Due to their contradictory nature, defending against the twin threats of inference and poisoning attacks simultaneously is a challenging task that very few works have attempted to solve. In this study, we propose a novel privacy-preserving approach that defends participants against inference attacks by the curious but honest application server and simultaneously protects the system against byzantine poisoning attacks and enhances the trustworthiness of the federated learning-trained application model. The proposed approach achieves its goal by combining inference attack mitigation schemes such as homomorphic encryption or secure multiparty computation with parameter level anomaly detection and mitigation to counter the adverse effects of poisoning attack. We apply the proposed scheme to two urban sensing applications: ambient noise map generation and road pothole detection. The proposed approach outperform the state-of-the-art approaches proposed in the literature by achieving an improvement in F-1 score of up to 41.3% and 15.5% respectively in detecting poisoned contributions by the participants in a privacy-preserving manner.}
}
@article{LIANG2026116317,
title = {NP-MoETSF: A unified framework for Non-Prior Graph Learning in high-dimensional time series with sparse expert networks},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116317},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116317},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010439},
author = {Mengfan Liang and Xiaofeng Zhang and Yepeng Liu and Pengbin Zhang and Ren Wang and Hua Wang and Yujuan Sun},
keywords = {Time series forecasting, Sparse graph learning, Masked Transformer, Mixture-of-experts, Interpretability},
abstract = {High-dimensional multivariate time series forecasting is pervasive in real-world applications, yet inter-variable dependencies are often unknown and time-varying. Existing methods typically rely on fully-connected attention or static prior graphs, which suffer from weak structural sparsity, limited interpretability, and degraded generalization in high-dimensional regimes. To address these limitations, we propose NP-MoETSF (Non-Prior Graph Learning for Multi-Expert Time Series Forecasting), a unified framework that learns sparse, interpretable, and generalizable dependency structures without any prior graph. NP-MoETSF integrates two complementary components. First, it models channel dependencies in the time–frequency domain by combining multi-scale wavelet representations with a learnable Mahalanobis metric. Through Gumbel reparameterization, it constructs an explicit binary channel graph, which constrains a sparse Transformer to perform controlled attention across variables, thereby reducing redundancy and mitigating overfitting. Second, NP-MoETSF employs a distributed-gated mixture-of-experts with noisy Top-k routing and a load-balancing regularizer to adaptively activate a small set of experts. Each Stationary-MASF expert integrates a multi-scale stationarized trend branch with a diagonal frequency-domain residual branch to enhance long-horizon stability and noise robustness. Experiments on over ten real-world forecasting benchmarks spanning energy, electricity, transportation, meteorology, hydrology, and healthcare demonstrate that NP-MoETSF is competitive with strong baselines. More importantly, it provides improved interpretability and stronger cross-scenario generalization via sparse structure learning and expert specialization.}
}
@article{CHEN2026116218,
title = {Tiny object detection via implicit feature fusion and hybrid metric adaptive label assignment},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116218},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116218},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009445},
author = {Qiaochuan Chen and Tianyang Xu and Yan Sun and Bing Wang and Yuexing Han},
keywords = {Tiny object detection, Feature fusion, Label assignment},
abstract = {Tiny object detection (TOD) has broad applications across various fields, including remote sensing image analysis, autonomous driving, and UAV surveillance. Due to the extremely limited pixels representing tiny objects, existing methods often fail to effectively utilize multi-scale features in detecting tiny objects. Additionally, current label assignment strategies are inadequate to assign a sufficient number of high-quality positive samples for tiny objects, which hinders the model’s ability to accurately identify them. This paper proposes a TOD network based on Implicit Feature Fusion (IFF) and Hybrid Adaptive Label Assignment (HALA), named IHANet, which aims to achieve high-precision detection of tiny objects. IFF mitigates feature misalignment in multi-scale fusion by leveraging implicit neural representations, mapping feature maps from different pyramid levels to a uniform size before fusion. By modeling feature maps as continuous representations, IFF enables effective fusion at any resolution, preserving tiny object details and reducing information loss. HALA improves label assignment by combining IoU with the Receptive Field Distance (RFD), which performs better for tiny objects. HALA then utilizes an adaptive selection strategy to identify high-quality training samples, enhancing model training and detection performance. Extensive experiments on the AI-TOD, SODA-D, VisDrone, and AgriPest datasets demonstrate that IHANet achieves state-of-the-art performance on various TOD scenarios, such as remote sensing, autonomous driving, low-altitude drone imaging, and agricultural imaging, achieving an AP score of 29.1 on the AI-TOD dataset. Codes are available at https://github.com/han-yuexing/IHANet.}
}
@article{XIONG2026116270,
title = {QMATE: Mitigating gradient conflict with query-enhanced multi-task adaptive transformer for unifying EEG representation},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116270},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116270},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009962},
author = {Wei Xiong and Junming Lin and Jiangtong Li and Jie Li and Changjun Jiang},
keywords = {Foundation model, EEG representation, Interpretability, Gradient analysis, Multi-task learning},
abstract = {Developing electroencephalography foundation models (EEG-FMs) encounters two main challenges: the heterogeneity of recording setups and the opacity of internal multi-task learning dynamics. While conventional architectures struggle to generalize across subjects and tasks, existing EEG-FMs operate as “black box” systems, obscuring how different objectives interact during training. Our empirical analysis of gradient dynamics indicates that current leading models exhibit significant gradient interference, where conflicting optimization directions among downstream tasks degrade joint learning performance. To resolve these issues, we propose the Query-enhanced Multi-task Adaptive TransformEr (QMATE), which incorporates a Channel-Adaptive Tokenizer to project variable configurations into a shared latent space via learnable latent queries. This mechanism acts as a trainable information bottleneck, compressing signals into “neuro tokens” to filter task-specific noise and preserve task-invariant EEG features. Surpassing standard performance metrics, we provide a mechanistic explanation of how this architecture supports effective multi-task learning. By conducting a Gradient Dynamics Analysis using Counter-Sketch projections and Subspace Affinity metrics, we map the geometric relationships of task updates in the parameter space. Our findings reveal that: (1) the bottleneck induced by learnable latent queries compels the model to utilize shared information among semantically unrelated tasks, substantially alleviating destructive interference and improving gradient alignment across tasks; (2) functionally aligned tasks exhibit high gradient subspace affinity, promoting positive knowledge transfer; and (3) joint fine-tuning within this structured optimization manifold improves representational stability. Experiments across six benchmarks demonstrate that QMATE achieves higher adaptability and generalization compared to existing baselines, establishing a transparent approach for neural interface modeling. Code is available here.}
}
@article{SHANG2026116345,
title = {STLIB: An information bottleneck-guided LLM-spatiotemporal framework for traffic forecasting},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116345},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116345},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010713},
author = {Zewen Shang and Xuewei Li and Zhiqiang Liu and Yingzhou Sun and Zijian Zhang and Tianyi Xu and Mei Yu},
keywords = {Traffic prediction, Spatial-temporal prediction, Large language model, Deep learning, Neural networks},
abstract = {Traffic forecasting is a critical component of transportation systems. To enhance predictive performance under data-scarce scenarios, Large Language Models (LLM) have recently been introduced into forecasting models. Although LLMs provide strong reasoning capabilities, however, such methods remain constrained by challenges such as overfitting and modality discrepancies. To address these issues, this paper proposes the Spatio-Temporal–LLM Information-Bottleneck (STLIB) theory, which decomposes intermediate representations into an LLM component and a spatio-temporal component, and improves feature quality by imposing mutual information constraints, thereby mitigating overfitting. The LLM component reduces modality discrepancies by aligning with text prototypes, while the spatio-temporal component explicitly captures spatio-temporal correlations. Based on this theory, we instantiate the STLIB-Net, which consists of LLM Branch and ST Branch. LLM Branch selects representative features and pulls them closer to the textual semantic space, whereas ST Branch iteratively extracts spatial and temporal features to capture structural dependencies. To the best of our knowledge, this paper is the first to introduce Information-Bottleneck (IB) into LLM-based traffic forecasting. Across eight datasets, STLIB-Net achieves state-of-the-art performance, reducing MAE by up to 8.98% in Full-Shot, 15.61%–36.06% in Few-Shot, and 3.96%–29.36% in Zero-Shot scenarios. It further cuts trainable parameters and training time by over 38.23% and 37.62%, respectively, compared to LLM-based competitors.}
}
@article{CASTRO2026116210,
title = {Enhanced cyber security based intrusion detection using optimized edge enhancement oriented graph convolutional networks in fully streaming big data analysis},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116210},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116210},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009366},
author = {S. Castro and R Pushpalakshmi},
keywords = {Artificial protozoa optimizer, Edge enhancement oriented graph convolutional network, Intrusion detection, Multi modal butterfly optimization algorithm, Outlier-insensitive Kalman filtering},
abstract = {The fast growth of internet usage and connected devices and cybersecurity has become a crucial concern for both consumers and organizations. Intrusion detection systems (IDS) are essential for detecting malicious activities and protecting network resources. With streaming massive data, detecting sophisticated assaults in real time has become difficult. However, typical IDS approaches frequently fail to handle high volume, dynamic attack in fully streaming big data environment. Therefore, this research proposes a novel model of Enhanced Cyber Security Based Intrusion Detection using Optimized Edge Enhancement Oriented Graph Convolutional Networks in Fully Streaming Big Data Analysis (CSID-EOGCN-FSBD). Initially, the input data are collected from UNSW-NB15 and CIC-IDS2017 datasets. The input data is given to pre-processing using Z-score normalization and Outlier-Insensitive Kalman Filtering (OIKF) based noise reduction and outlier suppression. The pre-processed data is supplied to the Synthetic Minority Oversampling Technique (SMOTE) for class balancing. The feature selection is done by using Artificial Protozoa Optimizer (APO) to select most relevant features from the input datasets. Then the selected features are given to the Edge Enhancement Oriented Graph Convolutional Network (EOGCN) for detecting intrusions. Finally, Multi Modal Butterfly Optimization Algorithm (MBOA) is utilized for optimizing weight parameter of EOGCN for improving the accuracy of the prediction performance. The performance of proposed CSID-EOGCN-FSBD method attains 99.29% accuracy for UNSW-NB15 and 99.54% accuracy on CICIDS-2017 while compared with existing techniques respectively.}
}
@article{TONG2026116262,
title = {Multi-Scale Attention-Relation-Based Knowledge Distillation for real-time intrusion detection system in IoT networks},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116262},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116262},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009883},
author = {Jianheng Tong and Ying Zhang},
keywords = {Self-supervised deep learning, Internet of Things (IoT) security, Intrusion detection systems (IDS), Knowledge distillation (KD)},
abstract = {In recent years, the burgeoning number of Internet of Things (IoT) devices has made IoT security issues and the importance of Intrusion Detection Systems (IDS) more prominent. Traditional intrusion detection methods encounter challenges when handling unlabeled data and evolving security threats, relying on data labels and predefined rules or features. Temporal Attention Network (TA-Net), an IoT security intrusion detection method based on self-supervised learning, is proposed. The pivotal component of TA-Net, specifically the temporal attention block, employs 1D dilated causal convolutional networks to extract temporal information for intrusion detection and innovatively integrates contrastive loss. TA-Net possesses the capability to learn from the data generated by IoT devices without requiring manual labeling. In IoT scenarios demanding high performance, prevalent models are ineligible for deployment on edge devices with limited resources. Knowledge distillation (KD) aims at transferring knowledge. Nevertheless, existing relational KD methods possess drawbacks, like merely computing the distances between samples as knowledge and adopting fixed distillation loss weights, thereby impeding the optimization of student networks. To tackle these issues, an attention mechanism was proposed and multiple measurement methods were utilized to construct sample correlations in knowledge distillation, resulting in Multi-Scale Dynamic Weight Attention-Relation-based Knowledge Distillation (MDWARKD).Overall, utilizing the proposed TA-Net as the teacher network and MDWARKD as the distillation method, we designed a Dual-Tier Deployment Workflow applicable to both resource-rich edge servers with high accuracy demands and resource-constrained IoT edge devices. Experiments on the CIC-IoT 2023, CIC-UNSW-NB15 and CIC-IoV 2024 datasets demonstrate that the proposed method has remarkable real-time performance and high detection accuracy in IoT security IDS tasks, regardless of its application in a single teacher network or a teacher-student distillation network.}
}
@article{YANG2026116186,
title = {SinFormer: A tailored transformer for robust Radio Frequency Fingerprint Identification},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116186},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116186},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009123},
author = {Liu Yang and Qiang Li and Xiaoyang Ren},
keywords = {Radio Frequency Fingerprint Identification, Deep learning, Transformer},
abstract = {With the rapid proliferation of wireless and Internet of Things (IoT) devices, ensuring secure and reliable device identification has become a significant challenge. Traditional security techniques, such as IP or MAC address-based authentication, are susceptible to spoofing, whereas Radio Frequency Fingerprint Identification (RFFI) offers a more secure alternative by exploiting the unique hardware imperfections in devices’ RF signals. In this paper, we propose a novel deep learning-based framework for RFFI that enhances both accuracy and reliability in challenging RF environments. The core of our approach is the Signal Inception Transformer (SinFormer), which leverages a specialized multi-scale self-attention mechanism to effectively capture both large-scale and fine-grained fingerprints in signals, significantly improving identification accuracy. To further enhance robustness and reliability, we introduce a two-stage training strategy that enables the model to learn general signal features and maintain performance under adverse conditions, such as low Signal-to-Noise Ratio (SNR) or channel variations. The effectiveness of the proposed method is validated using a real-world dataset. Experimental results show that the SinFormer framework consistently outperforms existing methods in accuracy and robustness across diverse and challenging scenarios.}
}
@article{LUU2026116238,
title = {Missing data imputation using Neural Cellular Automata},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116238},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116238},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009640},
author = {Trung-Tin Luu and Thanh-Binh Nguyen and Minh-Man Ngo},
keywords = {Missing data imputation, Tabular data, Neural Cellular Automata, Generative models, Attention mechanism},
abstract = {Missing data is a pervasive challenge when working with tabular data, and a wide range of imputation methods have been proposed, from classical discriminative approaches to modern deep generative models. However, existing methods typically rely on fixed relational structures, one-shot inference, or complex encoder–decoder architectures. In this paper, we propose Neural Imputation Cellular Automata (NICA), a novel imputation method inspired by Neural Cellular Automata (NCA). NICA iteratively grows missing values through residual updates, dynamically recomputing sample-wise similarities at every step to identify informative neighbors. This design yields a simple yet effective architecture that naturally captures evolving inter-sample relationships throughout the imputation process. Extensive experiments across diverse benchmark datasets demonstrate that NICA achieves the strongest overall performance among a wide range of baselines in terms of imputation error, downstream prediction performance, and robustness under different missing rates and missingness mechanisms.}
}
@article{SHEN2026116230,
title = {A cross-modal discrepancy-aware fusion approach to learning discriminative cues for deception detection},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116230},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116230},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009561},
author = {Zhihao Shen and Song Kong and Dengpan Zhang and Xuan Liu and Qingping Ma},
keywords = {Deception detection, Personality recognition, Contrast-attention, Multi-modal fusion, Multi-task learning},
abstract = {Accurate deception detection during human interaction is crucial for mitigating its social harm and understanding genuine intent. However, deceptive behaviors are complex and do not exhibit strong regularity across different circumstances, which poses significant challenges for automated deception detection. Although substantial research efforts have been devoted to developing effective multi-modal fusion strategies for deception detection, their performance remains unsatisfactory. Numerous psychological studies have revealed a strong correlation between personality traits and deceptive behaviors. They further indicated that inconsistencies of multi-modal behaviors while people are engaging in deceptive behaviors are crucial for deception detection. In light of these two underutilized clues, in this study, a multi-modal Mandarin dataset consisting of video, audio, and text was created and annotated with both deception labels and personality traits. A novel Discrepancy-aware Multi-modal Fusion Network (DMFnet) was proposed for deception detection, in which a contrast-attention mechanism was designed to focus more on the discrepant information across different modalities during feature fusion. Furthermore, a multi-task learning framework that leveraged personality information improved the overall performance and generalization capability of our model. The experimental results indicated that our proposed model achieves promising deception detection performance compared to other competing models. The ablation experiment also proved that the contrast-attention mechanism achieved more effective multi-modal fusion. Furthermore, the auxiliary personality recognition task produced a significant improvement in deception detection performance.}
}
@article{PENG2026116289,
title = {Correlation preservation in high-dimensional sparse data publication with local differential privacy},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116289},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116289},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010154},
author = {Shunshun Peng and Wenhao Wang and Minhao Li and Haoqi Li and Mengmeng Yang and Taolin Guo},
keywords = {Data correlation, Local differential privacy, High-dimensional sparse data, Random projection},
abstract = {Releasing individual user data under local differential privacy (LDP) protection and analyzing data correlations from globally perturbed user data have gained significant attention. However, as data dimensionality increases, the utility of perturbed data decreases, since perturbing high-dimensional sparse data introduces numerous errors . This study proposes LDP-CHSP, which maps high-dimensional sparse data to low-dimensional dense data using Gaussian random projection, preserving the Euclidean distance among raw data records. It reduces the effect of noise on data correlation by perturbing the dimensionalized data, rather than the raw data. Due to the sensitivity of reduced-dimensional data to noise, data perturbation with LDP mechanisms often results in poor utility. We establish the relationship between privacy loss and privacy leakage risk using the privacy loss probability function, determining the minimum noise variance that satisfies this relationship and preserves data correlation by reducing the size of the noisy data. Additionally, we theoretically demonstrate the privacy and utility of LDP-CHSP. Experimental validation using five comparison methods on four real datasets demonstrates that LDP-CHSP outperforms the comparison methods in terms of accuracy and noise variance.}
}
@article{XU2026116292,
title = {DeCO: A training-free framework for in-context knowledge editing via incremental reasoning},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116292},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116292},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601018X},
author = {Haoyu Xu and Yuliang Liang and Yizhou Dang and Guibing Guo and Jianzhe Zhao and Linying Jiang and Xingwei Wang},
keywords = {Large language model, Question answering, Knowledge editing},
abstract = {The integration of Large Language Models (LLMs) into web applications is challenged by dynamic online content that quickly renders their parametric knowledge obsolete. While In-Context Knowledge Editing (ICE) offers a promising solution, existing methods often rely on structured knowledge triples and require training auxiliary models. This restricts their effectiveness in unstructured natural language environments and introduces computational overhead. To address these limitations, we propose DeCO, a training-free framework that operates directly on natural language from external sources. We identify that Chain-of-Thought (CoT) generates reasoning steps in a single forward pass, hindering the incorporation of corrections. DeCO reformulates CoT as an incremental process of generation and editing, where each step is dynamically revised using retrieved knowledge to guide the model with finer granularity. Furthermore, DeCO tackles two critical challenges: (1) the inaccuracy of semantic similarity-based retrieval, and (2) the tendency of LLMs to revert to parametric knowledge or refuse responses under counterfactual conditions. We introduce the Information Seeker, a two-stage module leveraging LLM semantics for precise retrieval, and the Dynamically Prefill Guidance Strategy, which utilizes autoregressive constraints to enforce instruction adherence. Extensive evaluations demonstrate that DeCO outperforms six strong baselines, achieving average gains of 23.3% on multi-hop editing benchmarks and 4.5% on comprehensive benchmarks, underscoring its broad applicability.}
}
@article{ZHANG2026116353,
title = {Vul-CGBT: Enhancing code vulnerability detection via contrastive semantic learning and graph embedding},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116353},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116353},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010798},
author = {Yang Zhang and YiFan Wang},
keywords = {Vulnerability detection, Contrastive semantic learning, Graph neural networks, Control flow graph, Data flow graph},
abstract = {Code vulnerability detection is crucial for securing systems against attacks. However, existing methods rely on the fine-tuning paradigm of pre-trained models, failing to grasp vulnerable code semantics and thus struggling to capture subtle semantic differences between vulnerable/non-vulnerable code. Furthermore, they treat code as sequential input, overlooking the structural information of the source code. To address these challenges, this paper proposes Vul-CGBT, a novel approach for code vulnerability detection by integrating contrastive semantic learning with graph embeddings, which enhances detection performance by extracting vulnerability deep semantics and code structural characteristics. Firstly, a Transformer model is pre-trained via masked language model and contrastive semantic learning, with momentum contrastive learning enhancing its grasp of vulnerability semantic patterns, producing code sequence embeddings. Secondly, the abstract syntax tree of source code is parsed via Tree-sitter to construct a control flow and data flow graph, from which a graph convolutional network is used to learn graph embeddings. Finally, sequence and graph embeddings are fused and fed into a fully connected network for detection. Experimental results on the ReVeal, Big-Vul, and CodeXGLUE-Defect datasets show that Vul-CGBT achieves an F1-score of 51.17%, 61.15%, and 66.19%, respectively, outperforming baselines like PDBERT and LineVul by 3.07% ∼ 34.15%, 2.25% ∼ 50.49%, and 3.83% ∼ 22.24% across three datasets, demonstrating its effectiveness and generalizability.}
}
@article{ALHAWARI2026116301,
title = {Scrum-guided development of an intelligent payroll management system with rule-based automation and RAG chatbot support},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116301},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116301},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010270},
author = {Feras Al-Hawari and Anoud Alufeishat and Mohammad Habahbeh and Ahmad Alfalayleh},
keywords = {Payroll systems, Enterprise information systems, Retrieval-augmented generation, Large language models, Design patterns, Red-teaming},
abstract = {Managing payroll in large institutions involves complex tasks such as setup, salary calculation, tax filing, and record keeping. Manual spreadsheet administration is inefficient, error-prone, and costly. Digitalizing payroll is essential to enable automation, improve accuracy, transparency, and security. The complexity and evolving requirements of large-scale payroll systems make full upfront planning impractical. Scrum delivers the project in manageable increments, enabling continuous customer involvement and feedback, reducing rework and associated costs compared to Waterfall approaches, where rigid phases limit early visibility and adaptation. Accordingly, we implemented a rule-based payroll system using reusable template–resolver design patterns, supporting configurable payroll, tax, health insurance, and social security rules, employee-specific allowances, automated bulk and individual salary slip generation, retroactive calculations, and built-in audit controls. System reliability was validated using Scrum metrics, including burn-up and defect charts, to track progress and monitor quality. Bulk payroll processing over 19 months confirmed consistent and scalable operation. Building on this system, we introduce a retrieval-enhanced chatbot to assist employees with payroll regulations, tax rules, and health insurance, reducing HR support efforts. Three RAG-based LLMs were evaluated using FAISS and BM25 retrieval with varying embeddings, chunk sizes, and top-k parameters, with responses scored by expert reviewers. Pure LLMs performed worse than RAG models, highlighting the benefits of retrieval augmentation. The best-performing configuration achieved a mean reviewer score of 94.9% on a 50-question, domain-reviewed benchmark, demonstrating high response quality. System robustness was further validated through empirical red-teaming, indicating strong containment under tested adversarial scenarios.}
}
@article{CAI2026116281,
title = {SPMNet: Self-prompt mask-guided network for Camouflaged Object Detection},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116281},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116281},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010075},
author = {Bo Cai and Yanping Yang and Mengyin Wang and Jin Yan and Fenglin Li and Houjie Li},
keywords = {Camouflaged Object Detection, Cross-modal alignment, Progressive learning, Self-prompt mask-guided mechanism},
abstract = {Camouflaged Object Detection (COD) aims to identify and segment objects that are highly integrated with their surroundings, demonstrating significant application value in agricultural pest detection, medical image segmentation, and wildlife conservation. Existing prompt engineering-based COD methods mainly rely on text prompts to guide image segmentation. However, the inherent modal heterogeneity between text and image features in the representation space leads to cross-modal feature alignment difficulties, severely limiting detection performance improvement. This paper proposes a novel self-prompt mask-guided network (SPMNet) that adopts a two-stage progressive learning strategy of coarse mask generation → mask-guided fine segmentation. SPMNet achieves intra-modal self-prompting through self-generated mask priors: first utilizing frozen pre-trained encoders to extract stable semantic features from input images and generate coarse masks as prior knowledge; then guiding the main network’s attention allocation through unified segmentation decoders with these prior masks, enabling focused attention on potential target regions with high similarity to prior areas, effectively circumventing the inherent challenges of text–image cross-modal alignment in traditional methods. Comprehensive experimental results on three benchmark datasets (CAMO, COD10K, and NC4K) demonstrate that SPMNet surpasses 27 state-of-the-art methods across multiple evaluation metrics. Notably on the NC4K dataset, SPMNet achieves outstanding performance with Sα of 0.916, Fβω of 0.886, M of 0.022, and Eξ of 0.956,validating the effectiveness of the self-prompt mask-guided mechanism. Furthermore, downstream task experiments further demonstrate SPMNet’s excellent adaptability and broad application prospects. Our code will be released at https://github.com/caibo297/SPMNet.}
}
@article{WANG2026116333,
title = {TF-Rec: Time–frequency enhanced sequential recommendation based on adaptive intent clustering},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116333},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116333},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010592},
author = {Yifan Wang and Ruiqin Wang and Ming Li},
keywords = {Sequential recommendation, Prototype clustering, Intent-guided diffusion, Time–frequency analysis, Multi-task contrastive learning},
abstract = {Sequential recommendation aims to predict users’ future behaviors by modeling their historical interaction sequences, where latent user intents play a crucial role in improving recommendation quality. However, existing methods face several challenges in intent modeling: inability to adapt to dynamic interest shifts, difficulty in capturing periodic and cross-scale patterns, and limited robustness due to single-objective learning. To address these issues, we propose an intent-aware sequential recommendation framework — TF-Rec (Time–Frequency Enhanced Sequential Recommendation). TF-Rec enhances dynamic intent modeling through learnable adaptive intent clustering, and designs a dual-path time–frequency feature extraction module to integrate short-term behavioral variations with long-term periodic trends. Furthermore, a three-branch multi-task contrastive learning strategy is introduced to improve semantic consistency across different views. Experimental results on multiple public datasets demonstrate that TF-Rec significantly outperforms state-of-the-art methods, achieving improvements of 2.6%–7.2% in HR@5 and 2.0%–7.6% in NDCG@5. Ablation studies further verify the effectiveness of each component.}
}
@article{LI2026116254,
title = {SG-DGCN: Semantic-Guided Dynamic Graph Convolutional Network for Skeleton-Based Gesture Recognition},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116254},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116254},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009809},
author = {Junhui Li and Mohammed A.A. Al-qaness},
keywords = {Gesture recognition, Skeleton-based Gesture Recognition, Graph Convolutional Network, Attention mechanism, Dynamic Graph Modeling, Semantic guidance},
abstract = {While Graph Convolutional Networks (GCNs) effectively model skeletal data, existing dynamic approaches often suffer from structural instability. They typically infer connectivity solely from instantaneous frame-level correlations, rendering the learned topologies susceptible to feature jitter and lacking in global consistency. To bridge this gap, we propose the Semantic-Guided Dynamic Graph Convolutional Network (SG-DGCN). Central to the spatial modeling is the Semantic-Guided Graph Convolution (SGGC), which incorporates a Universal Topology Prior. By explicitly concatenating a dataset-wide kinematic prototype — derived from the centroid of class embeddings — into the graph generation process, we impose a stable semantic bias that prevents the topology from overfitting to transient noise. This mechanism is complemented by a Hard Top-k Sparsification strategy, which physically prunes spurious connections to retain only the most salient functional dependencies. Furthermore, for temporal modeling, we devise the Multi-Branch Temporal Module (MBTM) equipped with a Gated Attention mechanism. This design dynamically interpolates between global contexts and local motion details, effectively mitigating the over-smoothing problem. Extensive evaluations demonstrate that SG-DGCN achieves state-of-the-art performance, recording accuracies of 95.18% and 93.68% on DHG-14/28, 96.52% on Briareo, and 97.41% on NW-UCLA, demonstrating its strong robustness in distinguishing visually ambiguous motion patterns.}
}
@article{JI2026116266,
title = {Deep bilateral learning for image interpolation},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116266},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116266},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009925},
author = {Jiahuan Ji and Kai-Kuang Ma and Baojiang Zhong and Fuhui Zhou and Qihui Wu},
keywords = {Image interpolation, Deep bilateral learning, Convolutional neural network},
abstract = {Among the existing deep learning-based image interpolation methods, a common practice for estimating the value of each missing pixel is to estimate the intensity difference between it and its associated known or anchor pixel from the same interpolation window. The predicted difference is then added to the value of the anchor pixel as the final predicted pixel value. However, we have observed that this approach inevitably results in inaccurate estimation when the missing pixel is an ‘outlier’ with respect to the anchor pixel. To address this issue, a novel deep bilateral learning (DBL) method is proposed in this paper, which is motivated by the fundamental idea of the classical bilateral filter. For each missing pixel to be estimated, our DBL is designed to learn two attributes between it and the anchor pixels from a pre-defined support region, including their intensity differences and a set of distance-based spatial weights. The former is added to the respective anchor pixel values to yield a set of candidate pixel values for the missing pixel. The spatial weights are then used to compute a weighted sum of these candidates, yielding the final estimated value. To verify the effectiveness of our DBL, a DBL-based network, called the deep bilateral learning network (DBLN), is designed for image interpolation. Extensive experimental results have clearly shown that our DBLN can produce superior performance compared to a number of state-of-the-art image interpolation methods.}
}
@article{KWON2026116206,
title = {DyLite-VSR: A dynamic and lightweight video super-resolution network for highly compressed videos},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116206},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116206},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009329},
author = {Ilhwan Kwon and Jun Li and Mahardhika Pratama and Mukesh Prasad},
keywords = {Lightweight, Video super-resolution, Video compression, Video streaming, Grad-CAM},
abstract = {Services based on various forms of video streaming deliver content to clients by compressing originally captured videos using video codecs. During this process, due to limitations such as network bandwidth and display device capabilities, the original resolution is often reduced or a higher compression rate is applied, resulting in smaller data sizes being transmitted. Consequently, the video quality experienced by end users is often degraded. To address this issue, numerous AI-based Video Super-Resolution (VSR) techniques have been proposed. However, in addition to their high architectural complexity, many of these models require a large number of input frames or rely on recurrent frameworks, which further complicate both training and inference. These factors present significant challenges for deployment in real-time video services. In this paper, we propose a lightweight VSR model that achieves high performance even on low-quality, highly compressed video content. We propose an adaptive inference method that dynamically selects between lightweight and enhanced processing modules based on the input video’s resolution, thereby improving the suitability of our approach for real-time video streaming applications. Additionally, we visualize the performance of the proposed model with Grad-CAM to demonstrate its effectiveness compared to existing methods.}
}
@article{YUE2026116234,
title = {Collaborative knowledge and personalized preference alignment for sequential recommendation},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116234},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116234},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009603},
author = {Weiqi Yue and Tingting Liang and Xixi Sun and Xin Zhang and Leilei Zheng and Yuyu Yin and Jian Wan},
keywords = {Sequential recommendation, Large Language Model, Personalized preference alignment},
abstract = {Sequential recommender systems model users’ historical interactions as temporal sequences to predict their potential items of interest. While existing LLM-based sequential recommendation methods effectively enhance the performance of these systems by leveraging rich implicit world knowledge, they still suffer from two critical limitations: the collaborative knowledge gap and preference modeling bias. To overcome the challenges and fully unlock the potential of LLMs for recommendation, this work proposes CollaPPA, a novel framework that effectively integrates rich collaborative knowledge while capturing nuanced user preferences. Different from prior works, CollaPPA jointly trains on sequential recommendation alongside three recommendation-related tasks: Top-N recommendation, explanation generation, and attribute generation. This integrated multi-task learning strategy enables the model to strengthen the core capabilities of sequential recommendation while establishing cross-modal connections between behavioral interactions and non-behavioral knowledge. Furthermore, we propose a personalized preference alignment method that adopts multi-negative contrastive learning, optimizing one preferred item against multiple dispreferred candidates to closely mirror real-world ranking scenarios. Extensive experiments on three public datasets demonstrate the superiority of our CollaPPA, achieving performance gains of 4.6% to 20.6% over state-of-the-art baselines. Our source code is released at https://github.com/815382636/CollaPPA.}
}
@article{LIU2026116227,
title = {A spatially guided dual-path network for hyperspectral and multispectral image fusion},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116227},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116227},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009536},
author = {Ruiping Liu and Jie Li and Pan Wang and Chunyu Zhu},
keywords = {Hyperspectral and multispectral image fusion, Subband separable wavelet recalibration, Spatial-aware guidance module, Dual-path factorized modulation, Dynamic gated fusion},
abstract = {Hyperspectral images (HSIs) provide continuous and fine-grained spectral representations, yet typically exhibit low spatial resolution due to sensor and imaging constraints. Multispectral images (MSIs) contain rich spatial details but are insufficient to support accurate spectral reconstruction. In large-scale hyperspectral and multispectral image fusion (HMIF), an important source of reconstruction instability is the spectral inconsistency associated with uncontrolled structural-prior injection, especially in edge- and texture-rich regions. To address this issue, a spatially guided dual-path network (SDP-Net) is proposed, in which constraints are organized according to reconstruction error characteristics. First, multiscale recalibration is performed in the wavelet subband domain to stabilize high-frequency enhancement. Next, global structural priors are extracted from multispectral data via 2D selective scan (SS2D), and position-adaptive guidance weights are generated to suppress erroneous detail propagation. Finally, global structural constraints and local texture compensation are modeled separately through dual-path factorized modulation (DPFM), and adaptive integration is achieved using a dynamic-gated fusion module (DGate). Extensive experiments with upsampling factors of 4×, 8×, and 16× on multiple datasets demonstrate that the proposed method outperforms existing approaches in both spatial detail preservation and spectral reconstruction accuracy. The code is publicly available at https://github.com/LRuiRui517/SDP-Net.}
}
@article{XIAO2026116286,
title = {Improving multi-instance learning with hierarchical attention and frequency-domain hard sample distillation},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116286},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116286},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010129},
author = {Ting Xiao and Minqian Sun and Yiqing Xia and Hai Yang and Zhe Wang and Peng Liu},
keywords = {Multiple instance learning, Histological whole slide image, Hard sample mining, Attention regularization},
abstract = {Weakly supervised multiple instance learning (MIL) has gained widespread employment in whole slide image (WSI) classification, with most methods favoring the bag-based approach due to its good performance. Most approaches incorporate an attention mechanism to generate bag-level representations. However, due to a significant imbalance between the number of positive and negative instances within positive bags, attention-based MIL methods still have a cascade of issues: (1) highly imbalanced instances lead to attention over-concentration; (2) attention over-concentration leads to difficulty in balancing salient and hard instances, and results in misguided attention to irrelevant patterns. This paper proposes a novel MIL framework, named HAFD-MIL, which incorporates hierarchical attention and frequency-domain hard sample distillation. This framework addresses these challenges by jointly considering sample categories and sample difficulty. Specifically, from the perspective of sample categories, we first classify instances within each pseudo-bag as “trend-to-positive”, “trend-to-negative”, or “weak negative” based on negative instance prototypes clustered from negative bags. Then we propose a graded attention distillation module to process the above-classified instances separately to reduce the influence of negative instances on positive instances, along with a novel dynamic label attention loss to prevent attention over-concentration. From the perspective of sample difficulty, we propose a spectrum attention distillation module designed to extract information from hard samples and a redundant feature filter module to minimize interference from irrelevant information typically involved in the attention mechanism. Experimental results on two WSI datasets with three pre-trained backbones demonstrate the superiority of our HAFD-MIL framework and exhibit a wider range of attention areas.}
}
@article{MEZIANE2026116314,
title = {Logistic regression for anomaly detection in MQTT-based IoT systems to improve data integrity},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116314},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116314},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010403},
author = {Hind Meziane},
keywords = {IoT security, Logistic regression, Anomaly detection, MQTT, integrity},
abstract = {The growing number of connected devices and sophisticated cyberattacks requires enhanced security measures to safeguard data and privacy. Indeed, the IoT networks are vulnerable to significant cybersecurity threats, posing significant damage to the integrity and functionalities of smart interconnected systems. Therefore, intrusion detection systems (IDS) are essential for protecting sensitive data, identifying cyberattacks, ensuring the security, privacy, and integrity of data transmission across the network. For that, this research implements the Logistic Regression (LR) algorithm in scikit-learn. Our model categorizes network traffic as normal or abnormal, addressing various attacks such as DoS, bruteforce, flood, etc. The study aims to create LR-based IDS for IoT network security, improving classification and prediction rates for "Normal" and "Attacks" with low false alarm rates, offering a potential method for detecting and classifying anomalies based on a large traffic dataset. To secure communications in IoT networks, we focused on the MQTT (Message Queue Telemetry Transport) protocol, which is commonly used in IoT networks. The proposed anomaly-based IDS improves system integrity and enhances the accuracy and trustworthiness of the collected data by sensors and data integrity. The experimental results obtained highlight the ability of the proposed method to detect traffic anomalies, and therefore attacks, in an MQTT-based IoT environment. Our experimental results showed promising rates across all metrics and most classifiers by achieving the highest performance in binary and multi-class classification, which outperformed existing methods in the literature, leading to improve the robustness of our type of method.}
}
@article{PRIYANKA2026116219,
title = {Entropy-driven Whale Optimizer for detection of vector born diseases from hematological images},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116219},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116219},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009457},
author = { Priyanka and Vaibhav Malviya},
keywords = {Entropy-driven Whale Optimization, Feature selection, Machine learning, Vector born disease},
abstract = {Vector-borne diseases (VBD) are caused by nematode parasites of the species plasmodium and microfilariae, which are transmitted through mosquito bites. Traditionally, the detection of VBD parasites is performed by examining peripheral blood smears. This manual diagnostic method is slow and can lead to inconsistencies in parasite detection. To address the issues associated with human intervention in distinguishing VBD parasites from blood components, this scientific study proposed a novel approach of ‘Entropy-Driven Whale Optimizer’ (EWO), enhancing the diagnostic accuracy of VBD by employing the Machine learning (ML) screening technique through a nature-inspired feature selection methodology. The traditional feature selection techniques consist of k optimum features, identified through the trial-and-error method but this research comprises a novel approach for feature selection based on Entropy, and Whale Optimization algorithm (WOA), addressing the challenge of the hit-and-trial technique. Evaluation of the EWO using a VBD dataset attains a detection rate of 99.661% for the EWO-MLP model. Other models EWO-SGD, EWO-LR, and EWO-XGB are also developed and tested, demonstrating an effective detection rate. Furthermore, the robustness of the model is also validated on other datasets, attaining a detection rate of 99.42%. The model efficacy is also compared with other state-of-the-art methods which demonstrates that the results achieved by the EWO model surpassed those of existing studies, highlighting its efficacy in VBD detection. Further, to demonstrate the scalability and interoperability, EWO is validated across three distinct open dataset, achieving an accuracy from 98.85% to 99.77%.}
}
@article{XUE2026116271,
title = {Transfer graph reasoning network for misaligned visible-thermal object detection},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116271},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116271},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009974},
author = {Xiaotong Xue and Hongshu Chen and Kechen Song and Yunhui Yan and Baihua Li and Qinggang Meng},
keywords = {Multispectral object detection, Graph reasoning, Node transfer, Edge transfer, Modality alignment},
abstract = {The fusion of visible and thermal images for object detection has garnered significant attention as an effective method to tackle object detection challenges in complex scenarios. However, current dual-modal fusion detection methods face two noteworthy challenges. Firstly, they often overlook the issue of registration discrepancies between visible and thermal images in practical applications. Secondly, they fail to address the gap that exists between different domain distributions, thereby directly modeling correlations within distinct domains. To address these problems, this study proposes a novel object detection method based on the fusion of visible and thermal images, accompanied by a transfer graph reasoning network. To mitigate the impact of registration discrepancies between the two modalities in practical applications, a filtering-assisted modality alignment module is developed, leveraging adaptive frequency feature adjustments to enhance the robustness of alignment. Furthermore, in order to bridge the gap between different domain distributions, this study introduces a network known as transfer graph reasoning. This network involves node transfer to compensate for semantic loss caused by registration discrepancies, as well as edge transfer to model and infer semantic relationships across different modalities. The proposed detection method has undergone comprehensive evaluations on three widely recognized datasets, namely DVTOD, LLVIP, and RGBTDronePerson. The results clearly demonstrate its outstanding performance in multispectral object detection. The code will be published at https://github.com/VDT-2048/TGRDet.}
}
@article{HE2026116195,
title = {Explainability-guided spatiotemporal adaptive differential privacy for graph neural networks},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116195},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116195},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009214},
author = {Chuce He and Song Xiao and Jing Xiao and Yahui Ding and Hengbo Chen},
keywords = {Graph neural networks, Differential privacy, Explainable AI, Privacy-preserving},
abstract = {Graph Neural Networks (GNNs) are vulnerable to inference attacks and gradient leakage attacks, making differential privacy (DP) mechanisms a primary defense strategy. To safeguard data privacy and model security while balancing the trade-off between GNN security and performance, our work proposes a node-level task-oriented GNN scheme. This scheme features an explainability-guided spatiotemporal adaptive DP for GNNs. In the temporal dimension, we analyze the convergence of the GNN loss function and dynamically adjust the privacy budget to adapt to the model training stages; in the spatial dimension: (1) we construct the computation graph based on the GNN Layer-wise Relevance Propagation(LRP) algorithm and propose a scheme utilizing the Gumbel-Max Trick(GMT) and the exponential mechanism to protect relevance at the node, layer, and graph levels; (2) we propose a dynamic probabilistic subgraph sampling method guided by node relevance classification, as well as an input graph importance sampling procedure based on subgraph relevance classification, which enhance model training efficacy and control the DP sensitivity for GNN; (3) we adaptively allocate privacy budget to the input graph and gradients based on node relevance classification and layer-wise privacy relevance. We establish rigorous bounds on cumulative privacy loss and prove the stability of relevance privacy. Comprehensive evaluations involving multi-dataset comparisons, ablation studies, and robustness tests demonstrate that our proposed scheme outperforms state-of-the-art methods. The results confirm that our approach enhances model accuracy under identical privacy constraints while ensuring the effectiveness of functional components and overall system stability.}
}
@article{HE2026116247,
title = {Enhancing knowledge distillation via difficult feature-based weighted loss},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116247},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116247},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009731},
author = {Pan He and Hang Ruan and Lei Zhang},
keywords = {Deep learning, Model compression, Transfer learning, Knowledge distillation},
abstract = {As a key technology for model compression and performance improvement, the core framework of Knowledge Distillation (KD) involves leveraging a pre-trained teacher model to guide the training of a student model that is yet to be trained. However, existing feature-based KD methods adopt homogeneous learning strategies for different features during the training process of the student model. Specifically, they assign the same weight to each feature without making differentiated adjustments based on the inherent learning difficulty of the features themselves. This study proposes a Difficult Feature-based Weighted Loss (DF-WL) to enhance feature-based knowledge distillation. This mechanism quantifies the learning difficulty of different feature regions through pixel-level feature loss, and then generates weights based on the difficulty level—assigning higher weights to features with high learning difficulty and lower weights to easily learned features. This achieves a shift from homogeneous weights to hardness-aware dynamic weights. Ultimately, our method improves the distillation performance by strengthening the student network’s learning of difficult features. Extensive experiments on CIFAR-100 and ImageNet demonstrate that integrating the proposed DF-WL into existing mainstream knowledge distillation methods can further boost their performance and help them achieve more competitive results.}
}
@article{GOU2026116263,
title = {Online feature correlation knowledge distillation via adaptive ensemble teacher},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116263},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116263},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009895},
author = {Jianping Gou and Hongfang Zhu and Renjie Huang and Lan Du and Qing Tian and Shaoning Zeng},
keywords = {Online knowledge distillation, Feature correlation, Ensemble teacher},
abstract = {Online knowledge distillation (KD), which trains multiple student networks collaboratively in an online manner, has been shown to improve student performance. However, most existing online KD methods mainly focus on feature interactions among different student models and typically aggregate the predictive knowledge of all students in a uniform manner. As a result, they overlook the correlation knowledge between adjacent layers within each student network and fail to fully exploit the complementary value of different students. To address these limitations, we propose a novel online KD method, termed Online Feature Correlation Knowledge Distillation via Adaptive Ensemble Teacher (OFKD). OFKD consists of two key components: feature correlation distillation between adjacent layers and adaptive ensemble teacher distillation. The former enhances intra-network knowledge transfer by capturing and distilling feature correlations in the representation space between adjacent layers. The latter constructs an online adaptive ensemble teacher by dynamically weighting the correlation-aware predictive knowledge derived from the final-layer features of different student networks. Extensive experiments on CIFAR-10, CIFAR-100, Tiny ImageNet, Cars196, and ImageNet demonstrate that OFKD consistently outperforms existing online KD methods. Our code is publicly available at https://github.com/9jiujiu9/OFKD.}
}
@article{YUAN2026116187,
title = {Multi-scene topic-aware for novel single continuous shot multiple scenes endoscopy report generation},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116187},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116187},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009135},
author = {Xinpan Yuan and Junhua Kuang and Changhong Zhang and Liujie Hua and Guihu Zhao and Siming Jin},
keywords = {Multi-scene single continuous shot multiple lesions data, Multi-scene topic feature extraction, Cross-modal alignment, Report generation},
abstract = {Given a sequence of nasal endoscopy images, automatic report generation (ARG) aims to produce clinically meaningful textual observations, facilitating diagnostic workflows in otolaryngology. However, traditional automated report generation models can hardly cope with the enormous challenges posed by the co-existence of multiple lesions (e.g. adenoid hypertrophy, polyps, sinusitis), multiple scene transitions and multi-angle visual modalities in endoscopy to generate coherent and accurate reports. To address these issues, we propose a multi-scene multi-lesion report generation framework (MSMLRG) that mimics the real-life diagnostic process of an ENT specialist. It comprises: (1) a multi-scene topic-aware module that leverages medical knowledge to construct a scene-specific topic vocabulary, (2) a scene-consistency constraint module that ensures fine-grained alignment between image sequences content and generated descriptions, and (3) an ARG pipeline that mimics the process of human report writing across image sequences. Through scene topic modeling and cross-modal consistency enforcement, MSMLRG improves linguistic quality and clinical relevance. Extensive experiments based on several existing ARG models show that MSMLRG significantly improves both natural language generation and clinical efficacy metrics, enabling a shift from static-frame description to temporally-aware clinical reporting.}
}
@article{SIVARAMAN2026116231,
title = {Diabetic retinopathy lesions segmentation using Dual Swin U-Net transformer with transpose decoder and explainable AI},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116231},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116231},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009573},
author = {Jegan Sivaraman and Arjun Paramarthalingam},
keywords = {Diabetic retinopathy, Adaptive fast desensitized Kalman filter, Dual Swin U-Net transformer, Explainable AI, Grad-CAM, Outer totality cellular automata, Transpose decoder},
abstract = {Diabetic retinopathy (DR) is a common eye problem in people with diabetes. If it is not treated early, it get worse and may lead to blindness. To address these problems, this research proposes a Diabetic Retinopathy Lesions Segmentation Using Dual Swin U-Net Transformer with Transpose Decoder and Explainable AI (DRLD-DSUN-SS). Initially, a retinal image is collected from publicly available datasets such as Fine-Grained Annotated Diabetic Retinopathy (FGADR), Indian Diabetic Retinopathy Image Dataset (IDRiD) and Digital Retinal Images for Vessel Extraction (DRIVE), which provides high-resolution fundus images with lesion annotations. Images are pre-processed using Adaptive Fast Desensitized Kalman Filter (AFDKF), which includes resizing, noise removal and normalize pixel intensity value. Data augmentation used for (rotation, flipping, scaling) to improve generalization and normalize values. Outer Totality Cellular Automata (OTCA) automatically assigns pixel-level labels. After pre-processing, the dataset is separated into training, validation and test sets. Dual Swin U-Net Transformer (DS-TransUNet) acts as encoder to extract multi-scale contextual features via hierarchical attention, while the Transpose Decoder (TD) reconstructs high-resolution segmentation maps. Integrated DS-TransUNet-TD model segments diabetic retinopathy lesions such as microaneurysms, hemorrhages, hard and soft exudates and the optic disc. Grad-CAM-based XAI methods generate jet-mapped heatmaps, overlaid on fundus images with lesion masks, enhancing interpretability and aiding clinical diagnosis and decision-making. The proposed DRLD-DSUN-SS model demonstrates a successful segmentation performance of 94.9%, representing an improvement of 4.9% - 7.2% over existing state-of-the-art models DMSF-LSDR, ASHF-OCT-DRD and LAD-PEUNet-RS. The model's Dice coefficient and mean IoU were also shown to improve over these methods by 3.5 - 5.8%.}
}
@article{GUO2026116223,
title = {Time series prediction based on multi-head gated fusion spiking neural P systems},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116223},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116223},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009494},
author = {Yuanshuo Guo and Jun Wang and Hong Peng and Antonio Ramírez-de-Arellano and Hongping Hu},
keywords = {Time series prediction, Nonlinear spiking neural P systems, Multi-head gated fusion spiking neural P systems},
abstract = {Time series forecasting is critical in domains such as climate prediction and energy management. These datasets exhibit complex temporal dynamics, posing significant modeling challenges. While recurrent neural networks (RNNs) are designed to capture temporal interactions, current RNN-based architectures face fundamental limitations. First, rigid gating mechanisms relying on homogeneous sigmoid functions risk gradient decay and hinder adaptive updates. Second, architecturally isolated storage units impede cross-unit communication and weaken long-term dependency modeling. Furthermore, the prevalent single-head design lacks parallel processing capability for multi-dimensional patterns. To address these problems, this study proposes a recurrent-like variant of nonlinear spiking neural P (NSNP) systems, termed multi-head gated fusion spiking neural P (MGFSNP) systems. Drawing inspiration from recent advances in deep learning architectures, MGFSNP integrates exponential gating mechanisms and cross-unit fusion modules into the NSNP framework, enabling efficient internal state updates and dynamic gated information exchange across units. Additionally, standardized and regularized states are introduced to enhance information flow during dynamic memory updates. The MGFSNP model further extends MGFSNP systems with a multi-head architecture that supports parallel processing of information patterns across feature dimensions, and an efficient information interaction mechanism between spiking storage units based on gated mixing strategies. Experimental results demonstrate the effectiveness of the MGFSNP model.}
}
@article{YANG2026116282,
title = {Federated learning based on partial label masking weighted distillation},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116282},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116282},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010087},
author = {Jihao Yang and Wen Jiang and Laisen Nie},
keywords = {Federated learning, Data heterogeneity, Knowledge distillation, Forgetting},
abstract = {Federated learning, an emerging paradigm in distributed machine learning, has garnered significant attention for its ability to collaboratively train a global model without compromising local data privacy. However, the inherent challenge of data heterogeneity in FL leads to severe forgetting issues, resulting in substantial degradation of model performance. Addressing this issue is crucial for the advancement of FL. To mitigate the risk of catastrophic forgetting, we propose a federated learning algorithm based on partial label masking weighted distillation (FedPLD). This algorithm tackles the forgetting challenge posed by data heterogeneity by distilling knowledge from a few classes outside the local data distribution and enhancing teacher model generation through global model weighting. Experimental results demonstrate that our approach achieves superior model performance under various data heterogeneity conditions across multiple datasets without incurring additional communication overhead.}
}
@article{BAI2026116322,
title = {Cluster-guided and weight-decorrelated contrastive network for graph clustering},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116322},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116322},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010488},
author = {Shengxing Bai and Yuhong Zhang and Peng Zhou and Xindong Wu},
keywords = {Graph clustering, Contrastive learning, Node similarity, Weight decorrelation},
abstract = {Existing contrastive deep graph clustering methods typically augment the original graph and construct positive and negative pairs through random or cluster-guided sampling to improve node representations and clustering performance. However, two key issues remain. (1) Data augmentation based solely on the original graph retains its inherent noise, which degrades the quality of positive samples and prevents clustering information from effectively refining sample selection, thereby directly limiting the discriminability of node representations. (2) Existing methods often overlook high correlations in the encoder weight matrix, leading to feature redundancy that further weakens discriminability. To address these issues, we propose a Cluster-Guided and Weight-Decorrelated contrastive network (CGWD). Specifically, we design a node-similarity-preserving encoder that constructs a kNN-based feature graph as a complementary view of the original topology. This design mitigates noise while preserving feature-space similarity, thereby yielding higher-quality positive samples. We then leverage clustering information to select high-confidence intra-cluster centroids as positive and negative anchors, thereby improving the reliability of sample construction. Node-level and cluster-level contrastive losses are jointly optimized to enhance node discriminability. Finally, an orthogonality constraint is imposed to decorrelate encoder weights, reduce feature redundancy, and further improve representation quality. Extensive experiments on six graph datasets show that CGWD consistently outperforms state-of-the-art methods across multiple clustering tasks. CGWD is therefore promising for practical attributed-graph applications (e.g., biology), where robust and accurate clustering is essential.}
}
@article{YANG2026116298,
title = {MUSE: a multimodal unified sketch evaluator for comprehensive aesthetic assessment},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116298},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116298},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010245},
author = {Shuai Yang and Guangao Wang and Yongzhen Ke and Kai Wang and Wen Guo and Jing Guo and Fan Qin},
keywords = {Image aesthetics assessment, Sketching, Contrastive learning, Mutual attention mechanism},
abstract = {With the continuous development of art education and visual culture, the aesthetic assessment of sketching images has gradually become an essential topic in crossstudies of computer vision and art appreciation. As sketch creation is closely related to textual topics, this study designs a multimodal unified sketch evaluator (MUSE) model. First, an image–text encoder is jointly pretrained using a contrastive learning framework to achieve semantic alignment between sketching visual features and the title text. At the level of sketch feature extraction, we innovatively fuse Gabor filters and histogram-of-oriented-gradient operators to capture line details and light-dark distributions in sketch paintings while incorporating a coordinate attention module to extract compositional features. We also design a sketch-enhanced fusion module, which performs dynamic weighted fusion of sketch features via a mutual attention mechanism and integrates the fused sketch features with multimodal features. The architecture effectively captures the latent details in sketched images and uses textual information to enhance the fault tolerance of the evaluation system. Experimental results show that the model improves the sketch assessment accuracy to 87.27 %, laying a solid foundation for subsequent large-scale art education assessment and cultural and creative industry applications. The code is available at https:gitee.com/yongzhenke/muse.}
}
@article{GU2026116350,
title = {A semi-supervised self-organised prototype tree-based method for few-shot remote sensing scene classification},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116350},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116350},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010762},
author = {Xiaowei Gu and Abdulrahman Kerim and Ce Zhang and Jungong Han and Peter M. Atkinson and Qiang Shen},
keywords = {Few-shot learning, Prototype tree, Remote sensing, Scene classification, Semi-supervised learning},
abstract = {Few-shot learning has increasingly been explored in remote sensing scene classification as an effective approach to learning from limited examples. However, existing methods suffer from several limitations, including the need for well-annotated auxiliary datasets, limited generalisation and a tendency to overfit on training data. In this paper, a novel semi-supervised self-organised prototype tree-based method (S3OPT) is proposed for few-shot remote sensing scene classification. S3OPT progressively constructs a hierarchical prototype tree from image embeddings in a top-down, discriminatory manner across multiple levels of granularity, capturing inter-class similarities and intra-class variations to enable automated class separation. Using pretrained convolutional neural networks for feature extraction and exploiting pseudo-labelling, S3OPT reduces the need for extensive manual labelling and enhances generalisation through self-training from unlabelled samples. Thanks to the prototype-based nature, S3OPT offers high transparency and its reasoning is based on the mutual similarity between images, ensuring explainability in internal reasoning and decision-making. Extensive experiments on four widely used benchmark datasets demonstrate the great classification accuracy of the proposed S3OPT under standard few-shot learning protocols. It achieved results superior to or on par with state-of-the-art methods for few-shot remote sensing scene classification, delivering up to a 15% accuracy increase without the requirement for computationally expensive training and/or fine-tuning.}
}
@article{ALTINSES2026116330,
title = {Lipschitz-Adaptive Alternating Minimization for Robust Multimodal Sensor Fusion},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116330},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116330},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010567},
author = {Diyar Altinses and Andreas Schwung},
keywords = {Multimodal heterogeneous data, Marginal convexity, Alternating minimization, Multimodal representation learning, Non-convex optimization},
abstract = {Effective fusion of heterogeneous multimodal data is critical for robust industrial applications, yet training these architectures remains challenging due to disparate data characteristics and complex optimization landscapes. Standard stochastic gradient descent often struggles with gradient scale mismatches between modalities (e.g., high-dimensional images vs. low-dimensional sensors) and the inherent non-convexity of the joint objective. This paper addresses these limitations by providing a rigorous theoretical analysis of multimodal autoencoders, establishing their property of marginal convexity. Leveraging this theoretical insight, we propose a novel Lipschitz-Adaptive Alternating Minimization framework. This strategy decomposes the training process into marginally convex sub-problems and introduces a dynamic learning rate adaptation mechanism based on the estimated Lipschitz constants of each modality. By regulating step sizes according to the sensitivity of the optimization landscape, our approach mitigates modality competition and escapes saddle points via gradient noise injection. Extensive evaluations on synthetic digital twin datasets and the real-world RoboMNIST dataset demonstrate that the proposed method significantly outperforms classical optimization techniques, yielding superior reconstruction accuracy, enhanced training stability, and better generalization in complex, trimodal environments.}
}
@article{GUAN2026116306,
title = {Attention-guided reinforcement learning for dynamic sensor selection with SuperGCN-aided GCN–GRU modeling in RUL prediction},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116306},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116306},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010324},
author = {Tianyuan Guan and Dianrong Gao and Jiangwei Ma and Jing Wu and Yun Ji and Jianhua Zhao and Yingna Liang},
keywords = {RUL, Dynamic sensor selection, RL, Reward estimation model, Spatiotemporal modeling},
abstract = {As industrial systems become increasingly complex, remaining useful life (RUL) prediction using multisensor data faces challenges such as sensor redundancy, dynamic operating conditions, and spatiotemporal feature coupling. Herein, we developed an attention-guided reinforcement learning (RL) method for dynamic sensor selection, coupled with a super graph convolutional network (SuperGCN) reward estimation model—a lightweight graph convolutional network (GCN)-based proxy that approximated the RUL prediction performance of sensor subsets—for efficient reward evaluation and a GCN–gated recurrent unit (GCN–GRU) architecture for spatiotemporal modeling, forming a closed-loop RUL prediction framework. An attention-guided policy network used Gumbel–Sigmoid sampling with temperature annealing to enable differentiable and stable mask selection. The SuperGCN model rapidly estimated the reward of the different sensor subsets, and a smooth mask mechanism was introduced to enhance its consistency and generalization. Spatial dependencies among sensors were captured via dynamic graph convolution, while GRU modeled the temporal degradation dynamics. Experiments on the C-MAPSS dataset demonstrated that the proposed method outperformed the state-of-the-art approaches. RMSE was reduced by 6.28 %, 6.6 %, and 7.3 % on FD001, FD003, and FD004, respectively, while Score improved by 3.1 %, 11.8 %, and 6.2 % on FD002, FD003, and FD004, respectively. Comparative studies with three representative sensor selection strategies validated the effectiveness of the proposed method, and ablation experiments confirmed the contribution of each module to the overall performance.}
}
@article{CHEN2026116302,
title = {Spectral–spatial fusion Mamba for spectral super-resolution from single RGB image},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116302},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116302},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010282},
author = {Wenjing Chen and Mingtao Zhong and Zhiwei Ye},
keywords = {Hyperspectral images, Spectral super-resolution, Mamba, Spectral–spatial features},
abstract = {The spectral super-resolution (SSR) task for hyperspectral images (HSIs) requires accurate modeling of spectral sequentiality and spatial correlations. Existing methods primarily rely on convolutional neural networks (CNNs) and transformers, yet they face challenges in balancing performance with computational complexity. Recently, Mamba has shown significant improvement in accuracy and efficiency for visual tasks. However, current Mamba-based methods are limited to spatial feature extraction, overlooking the critical modeling of spectral dimension features inherent in HSI. To address this issue, this study proposes a spectral–spatial fusion Mamba network (SSFMamba). Considering the inherent sequential nature of the spectral dimension in HSI, a spectral–spatial Mamba block (SSMamba) is designed to fully exploit the spectral–spatial features of HSI. Furthermore, an adaptive spectral–spatial fusion block (ASSF) is developed to achieve effective spatial and spectral feature fusion, allowing features from two distinct Mamba blocks to be adaptively integrated. Experiments carried out on public HSI datasets demonstrate the effectiveness of SSFMamba. Specifically, for the spectral angle mapper, our method achieves respective improvements of 2.32% and 2.58% on the CAVE and Harvard datasets. The codes of SSFMamba will be available at https://github.com/Z-MTom/SSFMamba.}
}
@article{SHU2026116310,
title = {Fusing spiking neural P systems with graph convolutional networks for multivariate time series anomaly detection},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116310},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116310},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010361},
author = {Zhihui Shu and Jianbin Yan and Hong Peng and Zhicai Liu},
keywords = {Multivariate time series anomaly detection, Graph convolutional network (GCN), Spiking neural P systems, Multi-scale modeling},
abstract = {Multivariate time series (MTS) anomaly detection is essential for maintaining the reliability and safety of complex cyber–physical systems such as industrial plants, transportation infrastructures, and power grids. Nevertheless, existing approaches often fail to fully exploit spatial–temporal correlations, underutilize frequency-domain information, and inadequately capture multi-scale dynamics. To address these limitations, this study proposes an innovative architecture for robust MTS anomaly detection, AD-NSNP-GCN, which organically integrates nonlinear spiking neural P (NSNP) systems with graph convolutional networks (GCNs). The framework incorporates three major components: a bidirectional GCN-NSNP for spatial dependency modeling, a Fourier-based multi-scale temporal module for decomposing and learning trend, seasonal, and residual patterns, and an NSNP-like variational autoencoder (VAE) for probabilistic feature reconstruction and anomaly scoring. Experiments on five public benchmark datasets demonstrate that AD-NSNP-GCN achieves superior accuracy and generalization compared with state-of-the-art baselines. The proposed method offers a principled and structured approach for anomaly detection in large-scale, multi-sensor time series data.}
}
@article{ZHANG2026116068,
title = {PHANet: Contrastive hypergraph structures and prototype memory for discriminative skeleton-based action recognition},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116068},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116068},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600794X},
author = {Lei Zhang and Chen Pang and Guangqi Wen and Chunmeng Kang and Xingyu Gao and Lei Lyu},
keywords = {Inter-class semantic overlap, Hypergraph contrastive learning, Prototype learning, Feature discriminability, Skeleton-based action recognition},
abstract = {Skeleton-based action recognition has achieved significant progress with the evolution of Graph Convolutional Networks (GCNs). However, a persistent challenge remains in distinguishing actions with highly similar motion trajectories, where inter-class semantic overlap leads to ambiguous feature boundaries and severe discriminability degradation. This overlap introduces structural noise into the feature space, causing instances from different but semantically related classes to share redundant motion cues, thereby hindering robust classification. To address this issue, we propose PHANet, a novel skeleton-based action recognition framework that leverages a hypergraph contrastive network and features prototype-based semantic alignment. Specifically, PHANet first proposes the Hypergraph Contrastive Learning Module (HCLM) to construct high-order topological dependencies among body joints. This can explicitly capture fine-grained inter-joint correlations and suppressing misleading associations caused by overlapping semantics via a class-specific contrastive objective. Moreover, PHANet presents a Memory-based Prototype Learning Module (MPLM), which maintains a dynamic memory bank to store and update class prototypes through prototype-level contrastive alignment, enforcing intra-class compactness and enlarging inter-class margins. Extensive experiments on three large-scale benchmarks demonstrate that PHANet surpasses the state-of-the-art approaches, particularly in scenarios involving high inter-class similarity.}
}
@article{REN2026116267,
title = {Automated data synthesis and retrieval-augmented generation for legal large language models},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116267},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116267},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009937},
author = {Wenqi Ren and Lixing Shen and Jiang Zhu and Shaohui Li and Yinxia Hong and Jiawei Wang and Da Cao},
keywords = {Legal LLMs, Retrieval-augmented generation, Data synthesis, LLM-as-a-judge, ELO-ranking},
abstract = {The application of large language models (LLMs) in the legal domain faces two critical challenges: data scarcity and the need for trustworthy outputs. Legal data is limited and often lacks the quality and structure necessary to train robust AI systems. Furthermore, legal tasks demand high accuracy and reliability, making it essential for AI systems to generate trustworthy content. To address these challenges, we present the first automated framework for generating high-quality retrieval-augmented generation (RAG) data tailored specifically for legal LLMs. Our approach involves synthesizing high-quality question–answer pairs relevant to the legal domain. Each generated pair is then evaluated by an LLM-as-a-Judge, which classifies them as either good or bad based on their quality. Subsequently, we apply an ELO-Ranking technique to rank all pairs, ensuring that the most reliable and accurate pairs are selected for further use. These high-quality pairs are then employed to train both the retrieval and generation modules of a RAG model, addressing the issue of data scarcity and improving the overall performance of legal LLMs. Experimental validation on the LawBench benchmark demonstrates that our approach significantly enhances model performance, providing a reliable solution for training trustworthy legal AI models with RAG-based techniques.}
}
@article{ZHANG2026116259,
title = {NHCTE: A complex-valued causal encoder for transition-aware knowledge streams},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116259},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116259},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009858},
author = {Zuoxing Zhang and Chenxi Yu and You Fang and Yang Cai},
keywords = {Knowledge evolution, Temporal knowledge graphs, Concept drift, Rule invalidation, Complex-valued temporal encoding, Asymmetric temporal coupling, Transition-aware forecasting},
abstract = {Knowledge in deployed knowledge-based systems is often non-smooth: long-range accumulation can be interrupted by abrupt regime shifts that invalidate previously reliable rules and alter the predictive value of recurring relations. We propose NHCTE, a transition-aware causal encoder for non-stationary knowledge streams. NHCTE uses a complex-valued state with explicit semantic and phase-sensitive temporal channels, a transition-aware gate for stale-state refresh, and strictly causal asymmetric temporal coupling, where “non-Hermitian” refers only to a directional, one-sided operator in complex space. It is optimized with a standard link prediction objective, and its transition robustness emerges from the architectural inductive bias rather than from an explicit transition-aware training loss. Under the public TGB 2.0 temporal knowledge-graph forecasting protocol, NHCTE achieves the strongest test MRR among the compared official parametric baselines in the protocol-matched main TGB 2.0 benchmark table on tkgl-smallpedia (0.618), tkgl-polecat (0.245), and tkgl-icews (0.221), while remaining feasible on the large-scale tkgl-wikidata benchmark (0.515 test MRR, versus 0.535 for EdgeBank). Regime-stratified evaluation on the event-centric datasets further shows substantially smaller degradation and faster recovery under abrupt transitions: on high-transition windows, NHCTE limits the relative performance drop to −23.8%/−27.6% and recovers within 2.2/2.4 steps on polecat/icews, whereas strong baselines exhibit larger drops and slower recovery. These results establish NHCTE as an effective encoder for temporal KG forecasting under non-stationary conditions.}
}
@article{ZHANG2026116235,
title = {3D-aware knowledge-guided vessel segmentation with cross-domain generalization for comprehensive angiography analysis},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116235},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116235},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009615},
author = {Yuanyuan Zhang and Liuliu Feng and Bin Chen and Qiangqiang Fu and Ka Gao and Yu Wang},
keywords = {Vessel segmentation, Adaptive learning, Cross-domain generalization, 3D-aware knowledge, Equivariant learning},
abstract = {Accurate vessel segmentation in angiography images is crucial for the diagnosis and treatment planning of cardiovascular diseases. Existing methods often neglect the inherent 3D structure of vessels and struggle to generalize across different anatomical domains due to limited knowledge integration. To address these limitations, we propose a novel knowledge-based framework for 3D-aware vessel segmentation that incorporates spatial information and enhances cross-domain generalization. Our framework consists of three key components: (1) a depth estimation module that constructs a pseudo-3D vasculature representation by integrating prior anatomical knowledge, (2) an adaptive geometric learning approach combining graph convolutional networks and deformable convolutions to capture vessel structure and appearance based on domain expertise, and (3) a cross-domain generalization strategy utilizing domain adversarial training and knowledge-transfer through few-shot learning. The system intelligently adapts to different vessel morphologies by leveraging a comprehensive knowledge base of vascular patterns. Extensive experiments on multiple datasets demonstrate the superiority of our knowledge-guided framework over state-of-the-art methods. We showcase the effectiveness of our approach in generalizing across different anatomical regions, including the aorta, coronary, and retinal arteries, highlighting its potential as an intelligent decision system for clinical applications.}
}
@article{DUAN2026116251,
title = {Mining co-location evolving sequences from spatio-temporal data},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116251},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116251},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009779},
author = {Wenxin Duan and Peizhong Yang and Hongmei Chen and Lizhen Wang},
keywords = {Spatio-temporal mining, Co-location evolving sequence, Sequence index, Instance overlap index, Incremental mining},
abstract = {Spatial co-location pattern mining aims to discover subsets of spatial features whose instances frequently occur together in geographic space. Several studies have incorporated the temporal factor into co-location pattern mining to discover the evolution of co-location patterns over time. However, these methods examine the evolution of co-location patterns solely by assessing whether a pattern expands or contracts in the next time slot, without considering the underlying causes of such evolution. To address this limitation, this study proposes the concept of co-location evolving sequence mining, which fully considers the impact of changed instances on the association strength of features in co-location patterns. First, to evaluate the significance of a co-location evolving sequence, an evolution index was defined for a 2-sequence evolving co-location and then extended to define the sequence index for longer sequences. Subsequently, an instance overlap index was designed to measure the association between two connectable sequences. To enhance efficiency, a co-location evolving sequence mining algorithm (CESM_IER) was developed by integrating two pruning strategies and an incremental mining technique. The complexity, completeness, and correctness of CESM_IER were analyzed theoretically. Extensive experiments conducted on real datasets demonstrated the effectiveness and efficiency of the proposed algorithm.}
}