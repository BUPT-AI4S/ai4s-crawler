@article{MU2026117167,
title = {CaCoL: Causality-Aware Multi-Centroid Contrastive Learning for multivariate time series anomaly detection},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117167},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117167},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018939},
author = {Xiaofei Mu and Ye Tao and Hao Lu and Xiaofeng Yu and Lei Guo and Xu Yu},
keywords = {Multivariate time series anomaly detection, Contrastive learning, Time series},
abstract = {Multivariate Time Series Anomaly Detection (MTSAD) is a core technology for fault early warning and operational monitoring in industrial and service systems. In practice, the normal behavior of such systems exhibits a multi-modal distribution that varies with operating conditions. Existing methods, however, typically assume a single normal pattern and overlook the multi-causal structures within normal data, which can lead to the erroneous separation of different normal modes and high false positive rates under multi-condition scenarios. To address this issue, we propose a Causality-Aware Multi-Centroid Contrastive Learning framework (CaCoL). The framework first captures stable causal dependencies among variables to construct a representation space that preserves causal structure consistency across operating conditions. On this basis, we introduce a dynamic multi-centroid clustering mechanism, enabling normal samples to adaptively form multiple centroids in the latent space as operating conditions evolve, thereby modeling the multi-modal characteristics of normal behavior. We further design a causality-consistency-based contrastive learning constraint to guide representations in achieving both alignment and discrimination while maintaining stable causal dependencies. During inference, we propose a causal multi-centroid anomaly scoring mechanism to quantify each sample’s anomaly degree. Experiments on five publicly available MTSAD benchmark datasets demonstrate that CaCoL more accurately detects anomalies across conditions, reduces false positives, and improves cross-condition stability, achieving superior overall detection performance compared to state-of-the-art methods.}
}
@article{ZHONG2026117114,
title = {Cross-Modal Proxy Distillation with soft label filtering for multimodal emotion recognition in conversations},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117114},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117114},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601840X},
author = {Haoyang Zhong and Guihua Wen and Huihui Li and Wenjuan Shi and Chunlin Xu and Xiaoyong Liu},
keywords = {Multimodal emotion recognition, Multimodal representation learning, Knowledge distillation, Proxy model},
abstract = {Emotion Recognition in Conversations (ERC) has attracted increasing attention due to its wide applications in human–computer interaction and intelligent dialogue systems. Despite recent progress in multimodal ERC, existing methods remain limited by two critical challenges: insufficient utilization of complementary cross-modal cues under modality heterogeneity and severe modality performance imbalance. Although cross-modal knowledge distillation offers a potential solution, direct distillation between heterogeneous modalities may introduce potentially misleading cross-modal supervision and soft label misalignment, leading to ineffective or even misleading knowledge transfer. To address these issues, we propose a Cross-Modal Proxy Distillation (CMPD) framework with soft label filtering. Specifically, we design an Enhanced Cross-Modal Encoder to capture intra-modal contextual dependencies and generate interaction-aware multimodal representations through parallel cross-modal enhancement. Furthermore, we introduce a Soft Label Filtering Cross-Modal Proxy Distillation strategy, implemented via a Tri-modal Collaborative Proxy architecture. The proxy mechanism constructs indirect cross-modal soft supervision, while the Kendall rank correlation-based filtering strategy selectively enables knowledge transfer by filtering out cross-modal relations with inconsistent soft label rankings. In addition, an optimal transport objective is adopted for distribution-level alignment of prediction distributions during proxy distillation. This mechanism helps mitigate inter-modal interference and supports reliability-aware cross-modal distillation. Extensive experiments on two benchmark datasets, MELD and IEMOCAP, demonstrate that the proposed CMPD framework achieves competitive performance relative to reported results, with fine-grained ablation studies further showing the incremental contributions and complementary roles of proxy construction, rank-consistency filtering, and distribution-level alignment.}
}
@article{CHEN2026117171,
title = {Enhancing large language model-based systems for end-to-end circuit analysis problem solving},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117171},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117171},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018976},
author = {Liangliang Chen and Weiyu Sun and Huiru Xie and Yongnuo Cai and Ying Zhang},
keywords = {Large language models, Circuit analysis, End-to-end problem-solving, AI tutor},
abstract = {Large language models (LLMs) have demonstrated strong performance in data-rich domains such as programming, yet their reliability in engineering tasks remains limited. Circuit analysis, requiring multimodal understanding and precise mathematical reasoning, highlights these challenges. Although Gemini 2.5 Pro has improved capabilities in diagram interpretation and analog-circuit reasoning, it still struggles to consistently solve problems containing both textual descriptions and circuit diagrams. This paper presents an enhanced end-to-end circuit problem-solving framework using Gemini 2.5 Pro as the backbone model for scalable engineering-education applications. We systematically evaluate Gemini 2.5 Pro on undergraduate circuit-analysis problems and characterize two key failure modes: 1) circuit-recognition hallucinations, particularly incorrect source polarity detection, and 2) reasoning-process hallucinations, such as incorrect current direction assumptions. To address recognition errors, we integrate a fine-tuned YOLO detector and OpenCV-based processing to isolate voltage and current sources for polarity re-identification. To mitigate reasoning errors, we introduce an ngspice-driven verification loop that triggers iterative solution refinement with optional human-in-the-loop feedback. On 83 problems, the proposed pipeline achieves 97.59% accuracy versus Gemini’s 79.52% baseline. On four hand-drawn diagram variations, accuracy improves from 60.61%–71.21% to 89.39%–92.42% with statistically significant gains (p<0.005). An additional evaluation on 43 problems from a different textbook improves accuracy from 58.14% to 83.72%, providing further evidence of cross-textbook generalizability. Error analysis indicates that circuit recognition remains the dominant source of remaining failures, particularly for different diagram representations. These results demonstrate the robustness, scalability, generalizability, and practical applicability of the proposed framework for engineering education and real-world circuit analysis.}
}
@article{BAHARI2026117208,
title = {Quantile Affine Geometry: Exact linearization of 1D Wasserstein primitives for scalable machine learning},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117208},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117208},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019349},
author = {Mohamad Hasan Bahari and Mohammad Parsa Etemadheravi},
keywords = {Optimal transport, Quantile Affine Geometry, Scalable machine learning, Wasserstein distance},
abstract = {The isometry between one-dimensional Wasserstein distances and Lp distances between quantile functions is well established. Existing libraries expose an exact 1D distance, differentiable almost everywhere. Barycenters, geodesics, projection onto closed geodesically convex sets, and principal geodesic analysis (PGA) are not exposed as batched primitives. We introduce a differentiable computational abstraction layer rather than a new OT algorithm. Quantile Affine Geometry (QAG) turns these operations into deterministic tensor programs of sorting and vectorized arithmetic. It covers the batched uniform-weight case and, by breakpoint integration, the weighted, unequally sized case. The distance, the geodesic and the p∈{1,2} barycenters are exact; barycenters for other exponents are computed to a fixed tolerance. All are differentiable almost everywhere in the support locations, not in the weights. Projection onto a closed geodesically convex set is unique for 1<p<∞; our operator implements the p=2 case. The Q-PCA operator is an ambient L2 analysis in quantile coordinates, coinciding with Wasserstein PGA only inside the image. Because QAG is unregularized, it avoids iterative entropic optimization and quadratic tensorized cost matrices. This yields runtime and memory gains at comparable fidelity. Beyond a fixed memory budget the baseline is a calibrated extrapolation, not an observation. The backward pass is exact almost everywhere, since sorting is locally a permutation; the objective is only piecewise smooth, and we characterize where. QAG is not a general OT solver: it targets exact 1D transport and workloads that decompose into 1D problems, such as sliced-Wasserstein objectives and Knothe–Rosenblatt maps.}
}
@article{YOUSSEF2026116776,
title = {Neurotransmitter Optimization Algorithm (NTOA): A novel metaheuristic inspired by human neurotransmitter dynamics},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {116776},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116776},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015029},
author = {Yassin Ben Youssef and Maha Nssibi and Ghaith Manita and Seyedali Mirjalili},
keywords = {Neurotransmitter optimization algorithm, Metaheuristic algorithms, Bio-inspired optimization, CEC benchmark functions, Constrained engineering optimization},
abstract = {The Neurotransmitter Optimization Algorithm (NTOA) is introduced as a novel metaheuristic method inspired by the dynamic interactions of neurotransmitters within the human nervous system By emulating the adaptive behaviors of essential neurotransmitters such as Gamma-Aminobutyric Acid (GABA), Acetylcholine, Serotonin, and Dopamine, a dynamic balance between exploration and exploitation is achieved in complex optimization problems. Movement strategies are dynamically adjusted according to simulated neurotransmitter levels, thereby enhancing the ability of the algorithm to navigate challenging search spaces and avoid premature convergence to suboptimal solutions. The main contributions of this study include the development of the mathematical framework of NTOA, its evaluation on the CEC’22 and CEC’17 benchmark suites, its application to CEC’20 real-world constrained engineering problems, and its comprehensive comparison with existing metaheuristic algorithms. The experimental results showed that NTOA achieved competitive or superior performance relative to the compared algorithms in terms of accuracy and convergence behavior across a diverse set of test problems. These findings indicate that NTOA has promising potential for complex engineering and optimization tasks and may serve as a robust alternative to existing optimization methodologies.}
}
@article{BANSAL2026117131,
title = {Transparent forecasting with XAI: Improving accuracy and trust in electricity demand prediction},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117131},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117131},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018575},
author = {Somya Bansal and Vaibhav Baldeva and Asmit Cajla and Parth Vashitha and Priya Kansal and Sachin Kansal and Kamran Shaukat and Talha Mahboob Alam},
keywords = {Forecasting, Clustering analysis, Energy demand, XGBoost, Time-series, Explainable Artificial Intelligence, XAI, Machine Learning, Artificial Intelligence, Ensembling},
abstract = {This research is based on forecasting the net demand for electricity by considering the previous trends. Considering the overall increase in demand for electricity year by year, predicting such a trend plays a crucial role in a country’s development, as it helps make an accurate prediction of future energy consumption and prepare accordingly. The trends will be considered in light of various factors that affect the electricity usage rate. Different algorithms would be applied to a pipeline to predict appropriate results. The algorithms that would be used are XGB followed by Prophet, which is applied with regressors and then is ensembled, and further optimization is performed. Our result is compared against a broad set of classical statistical and machine-learning baselines (ARIMA, linear/ridge/lasso regression, decision tree, random forest, SVR, KNN, and gradient boosting), evaluated both on the full dataset and, separately, on two demand clusters. The model presented in this paper has outperformed all of these baselines. While hybridizations of Prophet with other learners, and of boosting methods with classical time-series components, have each been explored separately in prior work, the contribution of this research is a formalized, cross-validated stacking ensemble of Prophet and XGBoost specifically for national-scale electricity demand, combined with a SHAP-based explainability layer applied to the resulting ensemble, achieving an RMSE of 13.734 on test data. Not only does the proposed model yield better results, but it also provides a method to explain the effect that each parameter has on the outcome. It accurately depicts the magnitude and impact, whether positive or negative, of electricity load consumption, which in turn affects the prediction of the outcome.}
}
@article{ZHAO2026117204,
title = {METRO: A general and multi-view trajectory representation framework for dynamic urban environments},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117204},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117204},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019301},
author = {Yongxin Zhao and Leixiao Li and Hao Lin and Zheli Liu},
keywords = {Trajectory representation learning, Spatiotemporal data mining, Self-supervised learning, Online learning},
abstract = {Existing trajectory representation learning methods may have difficulty integrating heterogeneous trajectory views and adapting across chronologically separated data windows. To address these challenges, we propose METRO, a Multi-view Enhanced Trajectory Representation framework with window-based sequential adaptation. METRO combines adaptive multi-view fusion with Query-Gated Attention (QGA) to regulate feature contributions and model long-range dependencies. It is trained through self-supervised pre-training with masked trajectory reconstruction and contrastive learning, followed by Gate-Aware Knowledge Distillation for sequential adaptation. Experiments on two large-scale real-world datasets, Porto and Beijing, comprising over 1.6 million trajectories, show that METRO achieves competitive or improved performance on most evaluated tasks and reduces historical performance degradation during sequential updates.}
}
@article{ZHU2026117163,
title = {Role-aware and knowledge-decoupled LLM for cross-city next POI recommendation},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117163},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117163},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018897},
author = {Jinhui Zhu and Xiangfeng Luo and Xiao Wei and Shaorong Xie},
keywords = {Next POI recommendation, Large language models, Knowledge transfer, Role distillation},
abstract = {In the task of cross-city next point of interest (POI) recommendation, the aim is to predict the POIs that a user will visit in unfamiliar cities. Existing methods address the problem of data sparsity in cross-city scenarios by transferring and enhancing user preferences between overlapping users; however, these methods often fail to distinguish between cross-city and intra-city knowledge, leading directly to knowledge interference. Furthermore, they overlook the negative transfer caused by overlapping users, which amplifies the trade-off effect. To address the issues of knowledge interference and negative transfer in cross-city scenarios, we propose a role-aware knowledge-decoupled LLM (RAKD-LLM) framework. We first introduce an inter-city user role analysis module that enables LLMs to model user roles and profiles across cities, and then introduce an intra-city user preference module to enable continuous updating of users’ preferences within a city. A role-distillation retrieval augmentation process is designed to enhance user preference representations by leveraging cross-city user profile information. Finally, we introduce an information-gain-driven fine-tuning method, which prioritizes tokens that carry critical preference information (e.g., POIs and categories) at the optimization of the model to further improve recommendation performance. Experiments on four datasets demonstrate average improvements of 9.4% in Acc@1, 11.3% in NDCG@5, and 5.6% in MRR compared to the latest baseline models.}
}
@article{GENG2026117212,
title = {GLoMa-Nav: Global–local Mamba world modeling with history-conditioned prediction in vision-and-language navigation},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117212},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117212},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019386},
author = {Xiaojian Geng and Shengkai Liu and Yuanjie Liu and Fucheng Liu and Fusheng Zha},
keywords = {Vision-and-language navigation, World models, Mamba, Multimodal perception},
abstract = {Vision-and-Language Navigation in Continuous Environments (VLN-CE) faces significant challenges in modeling long-range temporal dependencies and generalizing robustly to unseen environments. Existing approaches are often dominated by reactive visual-text matching and therefore insufficiently model the temporal consistency of action-conditioned state evolution. To address these challenges, we propose GLoMa-Nav, an RSSM-based latent world model framework tailored for VLN-CE. GLoMa-Nav introduces a Global–Local Mamba Perceptor to capture fine-grained local context and long-range differential navigation trends, together with asymmetric prior–posterior streams for temporally separated latent prediction. The prior stream is conditioned on historical information for inference-time look-ahead planning, whereas the posterior stream incorporates current observations for training-time calibration. This design adapts latent imagination to continuous VLN by reducing the risk of posterior shortcuts and enabling history-conditioned prediction of future navigation states. Extensive experiments on R2R-CE, RxR-CE, and the physics-based VLN-PE benchmark demonstrate that GLoMa-Nav achieves strong performance under comparable single-view RGB-D settings, and improved physical robustness in zero-shot transfer scenarios. Preliminary real-world qualitative deployment on a Unitree G1 humanoid robot further provides feasibility evidence for closed-loop physical execution.}
}
@article{ZEYU2026117188,
title = {Multi-Input Learning for information-efficient neural networks via feedback-stabilized representation reuse},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117188},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117188},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019143},
author = {Zhang Zeyu and Qiu Zhiyu and Chen Kaige and Li Hongran and Todo Yuki},
keywords = {Control system, Deep learning, Multi-Input Learning, Representation reuse, Small-gain stability analysis},
abstract = {Modern machine learning models are widely used in knowledge-based intelligent systems, yet their computation is commonly organized as a single-input forward process, which limits explicit representation reuse across different unit times. This paper proposes Multi-Input Learning (MIL), a feedback-stabilized machine learning methodology for information-efficient neural representation reuse. MIL defines batch-indexed unit time and unit data and introduces an explicit feedback pathway that reuses historical representations within the current unit time. Unlike conventional Single-Input Learning (SIL), the proposed framework enables multi-input representation construction without introducing additional learnable parameters. A small-gain-based stability analysis is provided for the feedback representation reuse process, showing that MIL can satisfy bounded-input bounded-output stability under appropriate gain conditions. The framework is instantiated in CNN-based networks and self-attention-based Transformers, demonstrating its applicability across different neural architectures. Experiments on text classification and general neural learning tasks show that MIL improves low-resource performance and information efficiency while maintaining computational costs comparable to those of the corresponding SIL baselines. In particular, the historical representations are detached from the computational graph, resulting in no additional gradient or optimizer-state overhead and only marginal runtime and memory costs. Ablation studies on feedback strength, history order, and representation reuse further confirm the contribution of the feedback pathway and support the stability of the proposed framework.}
}
@article{WANG2026117183,
title = {Adaptive weight learning for robust unsupervised sparse feature selection},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117183},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117183},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601909X},
author = {Jian Wang and Zebiao Hu and Zhilei Sun and Kai Zhang and Witold Pedrycz and Nikhil R. Pal},
keywords = {High dimensional data, Unsupervised feature selection, Outlier, Robustness, Adaptive weight learning, Sparse gate matrix},
abstract = {Dealing with high dimensional data with outliers is a challenging task for unsupervised feature selection. A common strategy is to use different robust norms or robust functions that helps to reduce the fitting error. Nevertheless, this strategy suffers from three shortcomings. First, sparsely regularized loss function, based on a priori presumptions about the noise, exhibits limited robustness to unforeseen noise. Second, the incorporation of non-smooth regularization terms significantly degrades the computational efficiency. Third, the utilization of ranking or weighting mechanisms for feature selection inherently compromises model credibility. To address these issues, a novel method, robust unsupervised sparse feature selection (RUSFS) via adaptive weight learning, is proposed in this work. More concretely, each instance is adaptively assigned a non-negative score characterizing its own importance during the learning process. Normal instances are usually given a larger score, while outliers are assigned a score close to zero, which enhance the robustness of the model. More importantly, we adopt a sparse gate matrix for feature selection, rather than relying on the feature ranking process induced by sparse regularization, which enhances the efficiency of feature selection. We demonstrate the superiority of our RUSFS over 11 state-of-the-art methods using 12 benchmark datasets.}
}
@article{WANG2026117192,
title = {Mitigating spectral decay via wavelet sparse contextual reinforcement for lightweight image super-resolution},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117192},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117192},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019180},
author = {Qian Wang and Mengyang Wang and Yao Tang and Han Pan},
keywords = {Lightweight Super-resolution, Wavelet-based attention, Multi-domain modeling, Contextual coherence},
abstract = {Lightweight image super-resolution (SR) aims to recover high-frequency details under strict computational constraints, yet its performance is often limited despite increasingly sophisticated architectures. This suggests that, beyond model capacity, the activation, organization, and propagation of high-frequency representations may also play an important role in limiting reconstruction performance. Through spectral analysis of intermediate features from representative Transformer-based SR models, we observe a characteristic depth-wise attenuation of high-frequency responses, where informative spectral components become progressively weakened during deep feature transformation. To address this issue, we propose Frequency-Stable Representation Network (FSRNet), a lightweight SR framework that explicitly stabilizes and propagates high-frequency representations across network depth. Specifically, Wavelet Sparse Attention with Spatial Consistency Regularization (WSA-SCR) reallocates computation toward information-dense frequency components while enforcing coherent spatial structures, and Multi-Scale Dilated Attention with Explicit Alignment (MDA-EA) reinforces their consistent alignment and propagation through multi-scale contextual aggregation. Together, these modules form a unified mechanism that preserves high-frequency responsiveness without increasing model complexity. Extensive experiments on standard benchmarks, large-scale images, and real-world datasets demonstrate that FSRNet achieves competitive reconstruction performance with a favorable trade-off between reconstruction quality and computational efficiency. The code and trained models are publicly available at https://github.com/bbbolt/FSRNet.}
}
@article{ASKR2026117103,
title = {Neural sentinels: A Quasi-Quantum hiking optimization based deep feature selection system for robust IoT-metaverse intrusion detection},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117103},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117103},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018290},
author = {Heba Askr and Mahmoud Abdel-Salam and Aboul {Ella Hassanien}},
keywords = {Metaverse, Neural sentinels, IoT, Intrusion detection, Cybersecurity, Deep learning, Feature selection and Quasi-Quantum hiking optimization algorithm},
abstract = {The integration of the Metaverse and Internet of Things (IoT) has created significant cybersecurity challenges, highlighting the need for intelligent intrusion detection systems capable of handling rapidly changing environments. This paper introduces Neural Sentinels, a novel intrusion detection framework that combines the Quasi-Quantum Hiking Optimization Algorithm (QQHOA) with a Deep Maxout Neural Network (DMNN) for optimal feature selection and multi-class cyberattack classification. QQHOA enhances the traditional Hiking Optimization Algorithm through quasi-oppositional learning and quantum-inspired population initialization, improving population diversity, convergence speed, and resistance to local optima. The selected optimal network traffic features are subsequently processed by the DMNN to identify complex patterns associated with diverse cyber threats. The proposed framework is evaluated using the CIC-IoT-2023 and ToN-IoT datasets, which contain diverse attacks targeting IoT and Industrial IoT environments. Experimental results demonstrate that QQHOA reduces the dimensionality of CIC-IoT-2023 from 46 to 21 features while preserving strong discriminatory capability. Neural Sentinels achieves near-perfect detection performance across several attack categories, including DDoS, DoS, Mirai, Brute Force, Spoofing, and Web-Based attacks. On the ToN-IoT dataset, the framework achieves 99.62% precision, 98.61% F1-score, and 99.18% accuracy, demonstrating strong generalization capability. Furthermore, cross-validation, statistical analysis, robustness, interpretability, and runtime experiments confirm the stability and effectiveness of the proposed approach. These findings establish Neural Sentinels as a promising solution for securing next-generation IoT and Metaverse networks.}
}
@article{XIN2026117159,
title = {Enhancing multimodal multi-objective evolutionary optimisation via time-temporal adaptive graph convolutional networks},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117159},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117159},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601885X},
author = {Zhenghua Xin and Hongjun Cheng and Liangyi Hu and Debao Chen and Shifei Ding and Xingzhou Liu and Xuejun Ren and Yaohong Li and Lu Sun},
keywords = {Multimodal multi-objective optimisation problems, Graph convolutional networks, Multimodal multi-objective evolutionary algorithms},
abstract = {This study focuses on multimodal multi-objective optimisation problems (MMOPs), which have multiple conflicting objectives and equivalent Pareto optimal solution sets. While evolutionary algorithms are commonly used for MMOPs, existing methods frequently fail to effectively balance the exploration of local Pareto sets with the exploitation of global ones. To overcome this limitation, we propose a novel time-temporal adaptive graph convolutional network (TTAGCN) for evolutionary multimodal multi-objective optimisation. The framework includes two key innovations: (1) an adaptive graph construction mechanism that dynamically switches from distance-based graphs in early evolutionary stages—facilitating broad exploration—to dominance-based graphs in later stages—improving convergence precision; and (2) the TTAGCN augmented with residual connections and identity mapping, which effectively models population dynamics over consecutive generations to allow a diverse offspring generation. The proposed algorithm uses a dimension-aware, divide-and-conquer strategy. For low-dimensional problems, it synergistically combines graph learning with residual connections. For high-dimensional cases, it uses a dedicated network to extract richer features. This design, reinforced by strategic residual links, allows the effective and simultaneous exploration of multiple equivalent Pareto solution regions. Extensive experiments demonstrate that TTAGCN significantly outperforms state-of-the-art methods across key metrics. Ablation studies validate the effectiveness of its temporal modelling and adaptive mechanisms.}
}
@article{ZAGHLOUL2026117096,
title = {Hakeem-7B: A knowledge-first recipe for the best open Arabic medical reasoner model},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117096},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117096},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018228},
author = {Yousef Zaghloul and Yassin Elasfar and Ayman Helmy and Mohamed Mostafa Fouad},
keywords = {Domain-adaptive pre-training, Arabic natural language processing, Medical question answering, Large language models, Knowledge retention},
abstract = {Open Arabic medical language models trail their English counterparts, while the most capable closed models remain inaccessible for regulated regional deployment, leaving native-Arabic clinical reasoning without a strong, openly deployable model at a practical scale. This paper presents Hakeem-7B, an Arabic medical reasoning model built on TII’s Falcon-H1-7B (a parallel Mamba-2/attention hybrid), and asks how far a fixed 7-billion-parameter open model can be pushed on intrinsic Arabic medical capability by post-training recipe alone. On a decontaminated, defect-filtered split of the native-Arabic MedAraBench exam benchmark, a knowledge-first post-training recipe (Domain-Adaptive Pre-Training → Supervised Fine-Tuning → Direct Preference Optimization; DAPT → SFT → DPO) increased the accuracy from 53% to almost 60%, and on a single internally-consistent harness Hakeem-7B beats every other 7–8B model, its own base, and a dedicated medical 70B (OpenBioLLM), while tying the 27–32B band, that is, matching models 4–10× its size. A blind dual-judge panel places its chain-of-thought reasoning above OpenBioLLM-70B and its own base. The central finding is as much methodological as empirical: in the tested intervention, the largest observed capability contribution comes from the DAPT-inclusive branch rather than the investigated reinforcement-learning stage. Because DAPT also changes training exposure, this comparison does not by itself isolate corpus quality, token volume, or optimization exposure. The transfer analysis is consistent with a substantial knowledge-retention bottleneck, but does not establish that reasoning skill is unaffected. To the authors’ knowledge Hakeem-7B is the first decontaminated, matched-controlled, confidence-interval-bounded Arabic medical reasoner at the 7B scale. Hakeem-7B is available at https://huggingface.co/Vionex-digital/Hakeem-7B.}
}
@article{YAO2026117148,
title = {AGMoE: Adaptive Graph Mixture of Experts for industrial process zero-shot soft sensing with limited labeled data},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117148},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117148},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018745},
author = {Le Yao and Jiaqi Shen and Jiabei Liu and Zheren Zhu and Jiusun Zeng and Zhihuan Song},
keywords = {Deep learning, Zero-shot soft sensing, Graph structure learning, Mixture of experts, Semi-supervised learning},
abstract = {Deep learning-based soft sensing has become crucial for monitoring quality variables in modern industrial processes. However, traditional data-driven methods typically assume fixed operating conditions, relying on static graph structures and rigid multi-scale feature extraction. This rigidity limits their representational capacity, particularly in zero-shot soft sensing scenarios. To address these challenges, this article proposes an Adaptive Graph Mixture of Experts (AGMoE) network. Specifically, an adaptive graph structure learning (AGSL) module is introduced to construct sample-specific adjacency matrices, enabling the model to capture both invariant global structures and local dynamic topological variations across distinct operating conditions. Building upon this, a graph mixture of experts (GMoE) network equipped with a topological router is designed to adaptively extract multi-scale features, allowing the model to effectively capture specific temporal patterns. Furthermore, practical industrial scenarios typically involve limited labeled data alongside a substantial volume of unlabeled data, which often compromises the generalization capability of neural networks. To mitigate this issue, we extend the proposed framework to a semi-supervised variant, termed SsAGMoE, which enables the model to capture useful dynamic multi-scale features and latent structural information from unlabeled data during the pretraining phase. Finally, the effectiveness and superiority of the proposed methods are verified on two real-world industrial production units within an ammonia synthesis process. Experimental results indicate that our approach significantly outperforms baseline methods in zero-shot soft sensing and delivers reliable predictions in label-scarce scenarios. The source code of the proposed models is available at https://github.com/HZ-ShenJ/AGraphMoE.}
}
@article{ZHOU2026117185,
title = {Fault-SAM: An interactive cross-domain foundation model for 3D seismic fault segmentation},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117185},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117185},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019118},
author = {Guangyue Zhou and Kewen Li},
keywords = {Seismic fault detection, Segment Anything Model, 3D Adaptive Image Encoder, Offset-Adaptive Prompt Encoder, Cross-modal domain adaptation},
abstract = {Seismic fault detection is crucial for geological exploration and resource development. While deep learning-based fault identification methods have demonstrated notable progress, the lack of high-quality, large-scale, publicly available, and diverse three-dimensional (3D) seismic datasets hinders the application and advancement of foundation models in this field. To address this challenge, this paper introduces an interactive fault segmentation model, termed Fault-SAM. This model pioneers the application of the two-dimensional (2D) pre-trained foundation model, the Segment Anything Model (SAM), to 3D seismic fault interpretation. Specifically, a parameter-efficient 3D Adaptive Image Encoder that preserves the SAM’s pre-trained weights and fine-tunes only a small fraction of parameters to capture the 3D spatial characteristics of seismic data is introduced. The Interactive Offset-Adaptive Prompt Encoder enhances the model’s ability to handle sparse, noisy, or spatially offset prompts. Moreover, the Multi-layer Feature Aggregation Mask Decoder optimizes detailed fault feature extraction, leading to precise microstructural representation. Fault-SAM leverages the general knowledge accumulated by SAM from extensive image datasets, achieving cross-modal domain adaptation from 2D natural images to 3D seismic data using limited fault-annotated samples. Experimental results on Thebe, the largest publicly accessible field seismic dataset, synthetic seismic datasets, and the FORCE dataset (completely held out during training), demonstrate that Fault-SAM outperforms existing mainstream image segmentation models and state-of-the-art SAM-based adaptive approaches in terms of fault identification accuracy, completeness, generalization capability, and adaptability to complex geological formations. This approach offers an innovative and effective transfer-learning paradigm for deploying foundation artificial intelligence models in geophysics, geology, remote sensing, and related disciplines.}
}
@article{ZHANG2026117156,
title = {Context-aware adaptive cross-modal inference network for few-shot visual question answering},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117156},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117156},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018824},
author = {Jing Zhang and Yunzuo Hu and Wen Li and Zhe Wang},
keywords = {Few-shot visual question answering, Context-aware adaptive cross-modal inference, Context-enhanced dual-decoder inference, Gating triplet attention},
abstract = {When humans handle visual question-answering tasks, the hippocampus in the brain will extract existing contextual knowledge in the brain based on the images and question information received by the visual system to assist in understanding the content of questions and images, thereby promoting more accurate and effective cognitive processing. Inspired by this, we proposed a novel Context-aware Adaptive cross-modal Inference Network (CAIN) for Few-Shot Visual Question Answering (FSVQA), which effectively simulates context acquisition of hippocampus to realize knowledge enhanced cross-modal reasoning. In CAIN, a novel context-enhanced dual-decoder Inference module is proposed to emulate the reasoning activities of the human brain when handling cross-modal tasks, in which a dual-decoder Transformer architecture is proposed to leverage context masks obtained from retrieval to selectively combine contextually relevant regions of the image with global image information in the decoder, thereby guiding cross-modal reasoning. Additionally, a novel gating feature refinement module is proposed to achieve more precise and adaptive multimodal information fusion, which maps retrieval-enhanced semantic context into the image space and utilizes a new gating triplet attention mechanism to selectively amplify relevant cross-modal interactions while suppressing irrelevant noise, thereby aligning cross-modal information. Extensive experiments on several widely used public datasets demonstrate that CAIN can achieve outstanding performance, establishing a new state-of-the-art in FSVQA. The code is available at the following address: https://github.com/JingVIPLab/CAIN.}
}
@article{YANG2026117172,
title = {Beyond semantic consistency: Event-level multimodal fake news detection via mutual guidance},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117172},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117172},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018988},
author = {Shujie Yang and Dengtai Tan and Jing Wang and Boao Tan and Yu Zhang},
keywords = {Fake news detection, Mutual guidance mechanism, Mixture-of-experts, Self-supervised learning, Event-level},
abstract = {Multimodal fake news that combines text and images has increased rapidly due to its strong visual impact and emotional influence, posing significant challenges to the public opinion ecosystem. Existing methods typically assume that image–text semantic consistency, i.e., the degree of semantic matching between textual and visual content, is indicative of news veracity; however, this assumption may not always hold in real-world multimodal scenarios. To address this issue, we propose an Event-Level Multimodal Fake News Detection via Mutual Guidance framework (MG-FND). By treating text and images as components of the same news content, the proposed framework models them jointly at the event level to learn a unified multimodal representation. Specifically, it characterizes the overall features of news events from multiple perspectives through differentiated feature enhancement and introduces a self-supervised mutual guidance mechanism (MGM) to align the dual-path predictions toward a shared semantic center, thereby learning a stable and discriminative event-level unified representation. Experimental results on the Weibo, Weibo21, and PolitiFact datasets demonstrate that the proposed method achieves performance competitive with state-of-the-art methods, while maintaining stable detection capability across different language environments.}
}
@article{ZHU2026117132,
title = {Learn from historical subgraph for temporal knowledge graph extrapolation reasoning},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117132},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117132},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018587},
author = {Lin Zhu and Xin Ren and Luyi Bai},
keywords = {Extrapolation reasoning, Gated Recurrent Unit, Graph Attention Network, Temporal knowledge graph},
abstract = {Temporal Knowledge Graphs (TKGs) comprise a sequence of real-world timestamp related facts, forming the foundation for numerous artificial intelligence applications. However, most existing TKGs are incomplete, which severely limits their practical use. Therefore, how to reason about missing facts in TKGs has gained significant attention. Recently, some researchers have attempted to introduce Graph Convolutional Networks (GCNs) or Graph Attention Networks (GATs) to capture the structural information of TKGs. These methods can only represent entities through their related entities and relations, while neglecting the representation of relations that are equally important as entities. In addition, some methods try to use Gated Recurrent Units (GRUs) to capture temporal information. However, these methods are not well suited for TKGs because TKGs often involve very long sequences, and ordinary GRUs cannot capture such ultra-long sequences well. Thus, we propose a novel Multi-head GRU and Relation-oriented Graph Attention Networks (MRN) model to solve above problems. In MRN, we employ a Relation-oriented Graph Attention Networks (R-GAT) module specifically designed for relations and a multi-head GRU module for ultra-long sequences message delivery. The R-GAT module can utilize neighbor relations to represent relations, enhancing the model’s ability to represent structural information. The multi-head GRU module can capture temporal information in different dimensions through multi-heads, and can also increase the model’s robustness, thereby capturing long-distance dependencies. We validate our model on six commonly used datasets, and the results show that MRN comprehensively outperforms the existing state-of-the-art models.}
}
@article{GUO2026117160,
title = {HGLD-STRec: A Hyperbolic Global–Local Dynamic Evolution Framework for Spatio-Temporal Recommendation},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117160},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117160},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018861},
author = {Yueyi Guo and Jun Zeng and Yinchen Pan and Haoran Tang and Junhao Wen and Min Gao},
keywords = {Spatio-temporal recommendation, Dynamic state evolution, Spatio-temporal hypergraph, Location-based social networks},
abstract = {Spatio-temporal recommendation aims to predict the locations that users may visit under specific spatio-temporal contexts by modeling historical check-in behaviors, spatial locations, temporal periodicity, and semantic information of locations. Existing methods have effectively utilized user historical trajectories and spatio-temporal contexts for spatio-temporal recommendation. However, most of them still rely on relatively static historical sequence modeling, making it difficult to capture the dynamic changes of user states, location states, and spatio-temporal structural relations after continuous check-ins arrive. This limitation restricts their ability to model state evolution and dynamic feedback processes in continuous mobility behaviors. To address this problem, we propose HGLD-STRec, a Hyperbolic Global–Local Dynamic Evolution Framework for Spatio-Temporal Recommendation. HGLD-STRec formulates spatio-temporal recommendation as a continuous dynamic evolution process of prediction, observation, update, and re-prediction, and maintains dynamic states of users and locations in the Lorentz hyperbolic space. Specifically, we design a local dynamic state evolution mechanism that synchronously updates the user state and the visited location state after each real check-in arrives. Meanwhile, we construct a global decoupled spatio-temporal hypergraph encoding module and a local–global fusion mechanism to capture high-order mobility patterns across users and locations from spatio-temporal contexts, which are further integrated with current dynamic states for next-location prediction. Experimental results on three real-world LBSN datasets show that HGLD-STRec outperforms representative methods on multiple evaluation metrics. Ablation studies and further analyses also verify the effectiveness of each core component.}
}
@article{DING2026117200,
title = {Analysing diverse complex open-source images to assess face mask usage for epidemiological studies},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117200},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117200},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601926X},
author = {Hang Ding and Ashley Quigley and Valentina Costantino and C Raina MacIntyre},
keywords = {Machine learning, Automated image analysis, Health improvement, AI systems for health},
abstract = {Face masks are an important intervention for controlling the transmission of respiratory infectious diseases, yet measuring mask use at a population level remains challenging. Open-source images from news media, social media, and public websites provide a potentially valuable source of observational data but are difficult to analyse because of crowd density, variable image quality, occlusions, diverse face orientations, and heterogeneous environmental conditions. We developed and evaluated an artificial intelligence (AI) framework for estimating face mask usage from complex open-source images for epidemiological studies. The framework combines face detection, unusable-image filtering, mask classification, and environmental context assessment (indoor versus outdoor) within a single analytical pipeline. To support model development, we created a large annotated database comprising over 200,000 face images labelled as unusable, mask-wearing, or non-mask-wearing, and fine-tuned state-of-the-art deep learning models for classification tasks. The resulting models achieved F1-scores of 0.926 for unusable-image filtering and 0.986 for mask classification. End-to-end evaluation using ten independent crowd images demonstrated low error rates, with only 1.5% of mask classifications requiring correction following manual review and absolute errors in estimated mask usage ranging from −5.2% to +2.3%. Indoor and outdoor environments were correctly identified in all evaluation cases. These findings demonstrate that complex open-source images can be analysed reliably using AI to estimate face mask usage and environmental context, providing a scalable approach for epidemiological research and population-level monitoring of public health behaviours during respiratory disease outbreaks. Ethics: The study has been approved by The University of New South Wales Human Research Ethics Committee (Approval Number: iRECS6116).}
}
@article{YAN2026117088,
title = {InstructGen: Generating Scalable and Realistic Visual-Language Navigation Data with Unlabeled Internet Videos},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117088},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117088},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018149},
author = {Yu Yan and Peiyang Li and Jianqin Yin},
keywords = {Vision-and-Language Navigation, Path-Instruction Pair Generation, Multimodal Large Language Models, Prompt Engineering, Self-supervised Correction Mechanism},
abstract = {Vision-and-Language Navigation (VLN) requires agents to follow natural language instructions and navigate in 3D visual environments. High-quality path-instruction pairs are essential for improving navigation performance and generalization of the agent. Although synthetic datasets have expanded the scale of VLN training resources, many existing methods still rely on template-based instruction generation. Such instructions often fail to fully reflect realistic navigation processes and differ from natural language expressions used in human–robot interaction, which limits their effectiveness for agent training. To address this limitation, we propose InstructGen, a VLN path-instruction pair generation framework based on Multimodal Large Language Models (MLLMs), and construct the corresponding dataset, GenVLN. Specifically, we use YouTube house-tour videos as visually realistic indoor navigation scenes and design a navigation-oriented prompting strategy to generate instructions grounded in visual observations and multi-granularity spatial cues. In addition, we introduce a self-supervised correction mechanism to mitigate potential hallucinations during generation, improving path-instruction consistency and linguistic fluency. Experiments on R2R and RxR show that agents trained with GenVLN achieve competitive results in unseen environments, demonstrating its value as a high-quality instruction dataset for training generalizable VLN agents.}
}
@article{PULLAGURA2026117022,
title = {mmWave-AI RouteNet: An intelligent IoT-integrated Deep Learning model for adaptive 6G network slicing and routing ultra-low power},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117022},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117022},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601748X},
author = {Lokaiah Pullagura and Samuthira Pandi Velusamy and Mariya Princy Antony Saviour and Mamta Sanjay Koban and Supriya Gupta Bani and Prashant Agrawal},
keywords = {6G network slicing, Industrial Internet of Things, Adaptive routing, Traffic management, Dynamic resource allocation, Millimeter wave artificial intelligence routing network},
abstract = {The growing demand for intelligent, scalable, and low-latency network organization in sixth-generation environments necessitates integrated frameworks capable of addressing high computational overhead, inefficient routing, and limited adaptability in massive intelligent networks. This research proposes the mmWave–Artificial Intelligence Routenet Framework (mWAIRF), an end-to-end intelligent network management architecture that jointly performs adaptive slicing, explainable Federated Learning (FL) based decision-making, and optimized routing. Initially, the Adaptive Software-Defined Reinforcement Federated Convolutional Auto-Encoder (ASDRFCA) dynamically slices mmWave networks by learning real-time traffic patterns and service requirements in a distributed federated manner. Subsequently, an explainable client selection mechanism that combines model explainability with Bayesian Local Interpretable Model-Agnostic Explanations-based ReliefF (B-LIMERF) ensures transparent and trustworthy slice-level participation in FL, improving scalability and interpretability. Finally, the Dilated Clustering-based Ocean Tide Optimization Algorithm (DCOTOA) utilizes the generated slice intelligence to optimize routing paths, minimizing latency while maximizing throughput. In contrast to existing sixth-generation services, where slicing, learning, and routing are disassembled as separate processes, the proposed cross-layer 6G resource and routing framework provides a tight coupling and explainable optimization framework for mmWave massive intelligent networks. The proposed framework attains an accuracy of 99.5%, precision of 98.9%, recall of 99.0%, F1-score of 99.2%, throughput of 2200 samples/sec, and 30 million parameters, facilitating a robust solution for future network management.}
}
@article{BEYALAKAMGANG2026117116,
title = {ELRIC: A multi-dimensional entropy estimator for optimal information preservation in image compression},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117116},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117116},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018423},
author = {Vivien L. {Beyala Kamgang} and Narcisse {Tankam Talla} and Perrin {Li Litet} and Stéphane Gaël R. Ekodeck and Romain Atangana and Aurelien {Fouetio Dongmeza} and Julius Marcellin Nkenlifack},
keywords = {Convolutional neural networks, Deep learning, Dual-path encoding, Image compression, Learned downscaling, Progressive preview, Rate–distortion optimization, Super-resolution},
abstract = {In recent years, learned image compression (LIC) methods have substantially outperformed classical codecs across a wide range of bitrates, yet they remain architecturally single-task: compress a full-resolution image and reconstruct it. Real deployment scenarios demand far more as content delivery networks simultaneously require a compressed full-quality bitstream, a lightweight thumbnail, a fast progressive preview, and a super-resolved output for high-density displays. Addressing all four tasks with separate models incurs prohibitive redundant computation. In this paper, we propose ELRIC (Efficient Lowered Resolution Image Compression), a unified single-model architecture that delivers compression, learned spatial downscaling, super-resolution and progressive preview synthesis from a single forward pass. A Dual-Path Encoder (DPE) branches one shared stem into a compression latent and a downscaling feature map at no additional encoding cost. A novel Slice Entropy Model (SEM) combining Hierarchical Dictionary Attention (HDA), Cross-Scale Feature Fusion (CSFF), Multi-Scale Channel Attention (MSCA), and Gated Window Context Fusion (GWCF), provides rich per-slice entropy estimates across K=8 coding steps. A curriculum rate–distortion loss with explicit BPP floor and ceiling barriers coordinates all four tasks throughout training. Extensive experiments demonstrate that ELRIC simultaneously achieves state-of-the-art compression quality (BD-Rate of −20.87%, −20.14%, and −24.53% on Kodak, CLIC Pro Valid and Tecnick respectively, against VTM-22.0), faithful ×4 spatial downscaling (PSNRds up to 40.13dB on BSD100), super-resolution reconstruction via a dedicated decoder head, and improved progressive preview efficiency relative to channel-truncated learned codecs and re-encoded classical quality ladders. For the sake of research reproducibility and enhancement, our implementation is freely available at: https://github.com/voxtranslate/ELRIC.}
}
@article{LI2026117168,
title = {Receptive field enhanced Transformer with multi-attention mechanisms for single-image deraining},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117168},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117168},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018940},
author = {Jingyu Li and Zhenhai Zhang and Yilei Huang and Ruosong Wang and Siyu Chen},
keywords = {Image deraining, Transformer, Window-based attention, Deformable self-attention, Deep learning},
abstract = {Single-image deraining under mixed degradation caused by rain streaks and raindrops remains a significant challenge in real-world outdoor image restoration, where clear visual content is important for preserving scene details and supporting subsequent image analysis. This difficulty stems from the different spatial characteristics and degradation patterns of rain streaks and raindrops. To overcome these issues, we propose a Transformer-based deraining network that captures global context while preserving fine-grained details. The architecture adopts a symmetrical encoder–decoder design with skip connections and integrates two key modules. Specifically, the first module, Receptive Field Enhanced Window-based Attention, is designed to address mixed rain degradation by enhancing standard window-based attention with adaptive window scoring and cross-window interactions. This design enables the modeling of long-range spatial dependencies between rain streaks and raindrops, which is essential for distinguishing complex rain artifacts from background textures, while avoiding the high computational costs associated with vanilla global attention. The second module, termed Dual-Stream Deformable Self-Attention, performs sparse and structure-aware sampling around degraded regions. It employs separate attention branches for rain streaks and raindrops, improving reconstruction accuracy. Together, these modules enable the network to effectively identify and restore various types of rain-induced degradations with high fidelity. Experimental results demonstrate that the proposed method exhibits favorable overall effectiveness compared to existing rain removal methods.}
}
@article{WANG2026117152,
title = {Meta-contrastive learning with lightweight support-based query interaction for few-shot fine-grained visual classification},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117152},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117152},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018782},
author = {YuXiang Wang and Yazhou Wang and Peijia Yu and Yuanyuan Xiao and Qi Wang},
keywords = {Fine-grained visual classification, Vision transformer, Meta-contrastive learning, Few-shot learning},
abstract = {Few-shot Fine-Grained Visual Classification (FS-FGVC) aims to recognize fine-grained categories from very limited labeled samples, while simultaneously addressing data scarcity and subtle visual differences. Existing methods commonly combine metric matching with attention-based support-query interaction, but dense interaction modules introduce substantial parameter and computational overhead. We propose McQNet, a lightweight framework optimized directly in episodic few-shot training. Its support-guided query calibration module refines queries using support context with only 0.07M additional parameters. MCM further treats each query as an anchor and forms same-class positive and different-class negative support pairs to enlarge inter-class margins. With ViT-B_16, McQNet reaches 87.55%, 94.52%, and 76.37% 1-shot accuracy on CUB, NABirds, and Stanford Dogs, respectively. Extensive experiments on three fine-grained benchmarks and one generic few-shot benchmark show that McQNet achieves strong performance with low parameter overhead and remains competitive with recent state-of-the-art methods. Codes are available at: https://github.com/GZU-SAMLab/McQNet.}
}
@article{YAO2026117213,
title = {Self-supervised learning based etching process modeling: Bridging simulation and experimental data},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117213},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117213},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019398},
author = {Zhenjie Yao and Ziyi Hu and Dashan Shang and Junjie Li and Rui Chen and Zhiqiang Li and Ling Li},
keywords = {Self-supervised learning, Etching profile, Cross convolutional neural network, Autoencoder},
abstract = {In the integrated circuit industry, the precise etching process control is critical for realizing the ever scaled new devices. The development of etching process faces new challenges and requires efficient etching simulation to gain insights into the etching mechanisms. This paper introduces a self-supervised learning framework for etching profile prediction, in which a cross convolutional neural network (CCNN) is designed to enhance feature learning. The CCNN incorporates profile-oriented lateral convolution and longitudinal convolution to capture spatial and dynamic variations. The core of our approach lies in self-supervised pretraining: an autoencoder is used as a pretext task to pretrain the lateral convolution layers on simulation data, enabling comprehensive and generalized profile representation. The pretrained representations are then fed to the longitudinal convolution layers, cascade combination layers and fully-connected output layer, which are fine-tuned on experimental data to achieve accurate experimental profile prediction. Experimental results validate the effectiveness of the self-supervised learning framework and the CCNN architecture, yielding a reduction in average prediction errors on experimental data from 7.9028 nm to 6.3822 nm.}
}
@article{ZHANG2026117201,
title = {SDDF-BEV: Uncertainty-aware spatio-temporal fusion for pure vision Bird’s-Eye-View 3D object detection},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117201},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117201},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019271},
author = {Wei Zhang and Xulu Xia and Xingliang Zhu and Weiwei Yu and Xiaoyu Dong and Xu Xiao and Bin Kong},
keywords = {SDDF-BEV, SAUM, DSTA, DAM-Focal, Pure vision BEV perception},
abstract = {Pure vision Bird’s-Eye-View (BEV) 3D object detection provides a feasible solution for autonomous driving perception. However, in dynamic driving environments, existing BEV approaches suffer from geometric distortions caused by camera pose variations, semantic confidence imbalance across multi-camera views, and limited performance on long-tailed categories. To address these challenges, we propose SDDF-BEV, an uncertainty-aware spatio-temporal fusion framework. Our approach incorporates three main components: (1) a Semantic-Aware Uncertainty Weighting Mechanism (SAUM) that leverages Gaussian noise modeling and Dropout regularization to adaptively suppress low confidence features; (2) a Dynamic Spatio-Temporal Alignment (DSTA) module that combines motion estimation with Transformer-based alignment for cross-frame geometric and semantic consistency; and (3) a Difficulty-Aware Modulated Focal Loss (DAM-Focal) that enhances learning of tail categories and hard samples through confidence-aware gradient modulation. On the nuScenes benchmark, SDDF-BEV boosts mAP by +2.75%, +2.73%, and +3.0%, and NDS by +4.31%, +2.27%, and +3.6% for Tiny, Small, and Base variants, respectively, with consistent improvements for long-tailed object detection. These results verify the effectiveness of the designed modules in pure vision BEV 3D detection tasks under dynamic driving scenarios.}
}
@article{SANTI2026117193,
title = {Giving stateless agents a sense of time: A reconsolidating episodic–semantic memory architecture},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117193},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117193},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019192},
author = {Gian Maria Santi},
keywords = {Stateless agents, Temporal continuity, Episodic memory, Semantic memory, Memory reconsolidation},
abstract = {Stateless agents may retrieve past interactions yet lack an operational sense of time: external memory makes the past available, but does not represent how experience loses accessibility, returns to relevance, or changes meaning. This paper defines that capacity as an episodic–semantic lifecycle governed by importance, elapsed time, recall and evidence. Pragma, developed by the author, stores sessions as episodes whose narratives stay outside the rewrite target, and consolidates recurring regularities into source-linked beliefs. Deterministic salience and decay regulate accessibility; recall and evidence trigger versioned reconsolidation without overwriting recorded events. The architecture is examined in 229 executions spanning four scenarios, four model families and ten executions per condition. The deterministic layer behaves identically in every family: salience, reinforcement and decay reproduce exactly, no belief is admitted without two distinct sources, and the tracked episode returned to the active zone in all 45 executions where it became dormant. The judgments it consumes do not: the same estimate varies by an order of magnitude across families, and that variation alone can decide whether a designed transition occurs. Removing the lifecycle answers the same memory probes equally well at the store sizes these scenarios reach, which delimits where the difference can be sought. Code, stimuli, metadata and traces make every reported transition inspectable. The contribution is an operational definition of temporal continuity, an architecture implementing it, and evidence separating the properties that hold by construction from those that depend on the model. It is not a validation of reliability, semantic correctness or comparative performance.}
}
@article{DENG2026117157,
title = {BANAR: Self-feedback stealthy backdoor attack in federated learning},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117157},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117157},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018836},
author = {Yu Deng and Yuling Mu and Songlei Wang and Ruihan Zhao and Zihao Yang and Lin Wang},
keywords = {Federated learning, Stealthy backdoor attack, Stealth degree, Self-feedback},
abstract = {In federated learning systems, the deployment of multiple defense mechanisms to mitigate backdoor attacks has forced attackers to adopt increasingly stealthy strategies capable of evading defenses. Yet stealthy attacks face a critical obstacle in real-world deployment because the server functions as a black box, preventing attackers from determining whether their attacks have evaded the defense mechanisms or retained sufficient backdoor performance after evasion. Pursuing stealth too aggressively inevitably weakens attack intensity and yields a suboptimal attack success rate (ASR). This creates an inherent trade-off in which enhanced stealth is achieved at the cost of degraded backdoor performance, thereby compounding the difficulty of mounting stable, effective attacks under black-box server constraints. To address this, we propose BANAR (Backdoor SONAR), a proactive, feedback-driven stealthy backdoor attack inspired by active sonar systems. The attacker periodically embeds BANAR signals into malicious updates and infers defense activation by analyzing the global model. Based on this feedback, BANAR adaptively adjusts the stealthiness of subsequent attacks, thereby balancing stealthiness and attack strength. Experiments demonstrate that BANAR detects defense activation with 98% accuracy and reduces the true positive rates of state-of-the-art defenses by approximately 56%. Meanwhile, its ASR under active defenses remains comparable to that achieved in undefended scenarios, indicating that BANAR substantially enhances stealthiness without compromising attack efficacy.}
}
@article{DONG2026117165,
title = {Semantic-Clustered Multimodal Prompt Tuning for long-tailed visual recognition},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117165},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117165},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018915},
author = {Binlong Dong and Yuge Xu},
keywords = {Long-tailed visual recognition, Vision–language models, Prompt tuning, Multimodal learning},
abstract = {Visual data in the real world often follow a long-tailed distribution, causing models to favor head classes while underrepresenting tail classes. Vision–language models provide opportunities to address this problem. However, directly applying prompt tuning to long-tailed recognition remains challenging. This paper reveals that Context Optimization (CoOp) suffers from the insufficient representational capacity of unified context and the tendency of class-specific context to overfit. Moreover, CoOp incurs substantial training overhead in large-scale category spaces. To address these issues, this paper proposes a Semantic-Clustered Multimodal Prompt Tuning (SCMPT) framework for long-tailed visual recognition. Specifically, we first introduce a Semantic-Clustered Prompt Tuning (SCPT) method, which decomposes learnable context vectors into globally shared context and semantic cluster-specific context. In this way, semantically similar classes share cluster-specific context tokens, thereby alleviating the limitations of CoOp. To reduce the training overhead associated with large-scale category spaces, we further propose a Dynamic Category Learning (DCL) strategy. During training, this strategy constructs a local category space based on the current batch, substantially reducing the computational cost of text encoding. In addition, we incorporate Visual Prompt Tuning (VPT) to form a multimodal prompt-tuning framework. The framework produces predictions from both image–text similarity and a full-category classifier. To prevent the two outputs from diverging, we adopt Dual-Prediction Consistency Regularization (DPCR) to constrain their predictive distributions to remain consistent. Experimental results on long-tailed datasets, including Places-LT, ImageNet-LT, and CIFAR100-LT, demonstrate that the proposed method achieves competitive recognition performance with only a small number of tunable parameters.}
}
@article{OYEJIDE2026117217,
title = {Prediction of polyurethane foam density using hybrid feature screening and comparative hyperparameter optimization of machine learning models},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117217},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117217},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601943X},
author = {Oluwayomi Joel Oyejide and Faiz Ahmad and Joseph Ifeanyi Achebo and Joshua Ahurome Eseigbe and Ese Emmanuel Enakireru and Francis Amadhe and Kingsley Udoka Enuezie and John Andrew},
keywords = {Polyurethane foam density, Feature screening, Hyperparameter optimization, SHAP interpretability},
abstract = {Accurate prediction of polyurethane foam (PUF) density is essential for improving product-quality consistency and supporting data-driven manufacturing. The present study developed an integrated machine-learning framework combining Variance Threshold Filtering (VTF), Elastic Net Regularization (ENR), and four hyperparameter optimization strategies such as Grid Search (GS), Random Search (RS), Bayesian Optimization (BO), and Ant Colony Optimization (ACO) with five regression models: Gradient Boosting Machine (GBM), Random Forest (RF), Extremely Randomized Trees (ETR), Extreme Gradient Boosting (XGB), and Support Vector Regression (SVR). The framework was evaluated using 20,000 industrial production observations, that include legitimate recurrent manufacturing records. Chronological partitioning and forward-chaining cross-validation evaluations were employed to assess the predictive performance. VTF–ENR screening reduced the predictor set from seven to six variables. SVR demonstrated consistently competitive performance across the investigated validation configurations, with RS–SVR achieving R² values of approximately 0.9999 and RMSE values of 0.0599, 0.0600, and 0.0603 under 5-, 7-, and 10-fold validation, respectively. GS–SVR achieved a lower 10-fold MAE of 0.0352. Ablation analysis demonstrated that ENR primarily contributed to dimensionality reduction, while hyperparameter optimization accounted for most of the predictive improvement, reducing RMSE and MAE by 20.94% and 17.59%, respectively, relative to baseline SVR. SHAP analysis provided insights into the contributions of the retained formulation variables, while computational assessment revealed trade-offs between predictive accuracy and processing requirements. The findings demonstrate the potential of integrated feature screening and optimized machine learning for industrial PUF density prediction, while highlighting the importance of temporal validation, computational efficiency, and external validation across independent manufacturing conditions.}
}
@article{TIAN2026117060,
title = {Rethinking heterogeneous graph representation learning via relational subset selection},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117060},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117060},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017867},
author = {Kun Tian and Jiaying Luo and Chao Li and Jia Chen and Yitong Wang and Peng Wang},
keywords = {Heterogeneous graph neural networks, Meta-path search, Relational subset selection, Marginal contribution estimation, Heterogeneous information networks},
abstract = {Long-range information propagation has been extensively studied in homogeneous graphs. However, directly extending deeper propagation to heterogeneous graphs often leads to severe noise accumulation and prohibitive computation due to the exponential growth of candidate relations. In this work, we argue that a central challenge of heterogeneous graph neural networks (HGNNs), especially when modeling long-range dependencies, lies in identifying informative relations from an exponentially large set of meta-paths. Motivated by this insight, we reformulate heterogeneous representation learning as a relational subset selection problem, shifting the focus from neighborhood expansion to selecting a compact set of informative relations. From this perspective, we propose a progressive meta-path search framework that incrementally reduces the candidate space while preserving useful long-range dependencies. Furthermore, we introduce a progressive single meta-path search strategy with leave-one-out evaluation, which provides a theoretically motivated first-order approximation of marginal contribution. After candidate meta-path features are materialized, this strategy transforms combinatorial subset optimization into an efficient contribution estimation process whose optimization cost is independent of the maximum hop length. Extensive experiments on multiple heterogeneous benchmarks and the large-scale OGBN-MAG dataset demonstrate that the proposed methods consistently outperform state-of-the-art HGNNs. Moreover, the discovered meta-paths generalize across different architectures, indicating that the framework captures dataset-level relational structures rather than model-specific patterns.}
}
@article{WANG2026117194,
title = {Image classification via discriminative multi-task group sparse learning},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117194},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117194},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019209},
author = {Weiye Wang and Caikou Chen and Xiaoguang Qiao},
keywords = {Sparse representation, Image classification, Multi-task learning, Structurally incoherent, ADMM},
abstract = {Traditional sparse representation-based classification methods process test samples independently or incur high computational costs, which limits their scalability. To address these limitations, this paper introduces a novel Multi-task Sparse Representation (MTSR) framework for image classification, which overcomes the limitation of treating test samples independently in traditional Sparse Representation Classifiers (SRC) and its variants. By incorporating a new ℓp,q,r matrix mixed norm and imposing structure via a discriminant term, we propose the Discriminative Joint Group Sparse Classifier (DJGSC) with ℓ2,1,2 regularization. This framework facilitates multi-task learning by capturing joint sparsity across multiple test samples and fully explore the category information of the row blocks corresponding to each category of the representation matrix, enabling related samples to share dictionary elements and improving consistency and robustness. We solve the ℓ2,1,2-norm regularized problem efficiently using ADMM and a specialized solver. Experimental results reveal that DJGSC delivers competitive or better performance with higher efficiency state-of-the-art approaches in both classification accuracy and computational efficiency. The source code is publicly available at: https://github.com/wwy990923-debug/DJGSC.}
}
@article{WU2026117149,
title = {MS-EAGCD: Multi-source event-structured adversarial graph learning for argument-level consistency detection},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117149},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117149},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018757},
author = {Aoni Wu and Kai Shuang and Ji Zhou and Xia Liu and Ruiyang Bao},
keywords = {Event extraction, Argument consistency, Misinformation detection, Graph learning},
abstract = {In multi-source dissemination scenarios, conflicting or misleading texts may contain local shifts in key event arguments across descriptions of the same event, thereby forming cross-source factual discrepancies. Existing credibility assessment approaches usually provide document- or claim-level judgments and may fail to localize specific argument-level conflicts. We therefore formulate Multi-Source Event Argument Consistency Detection (MS-EACD), which aims to identify inconsistent arguments across descriptions of the same event. MS-EACD is challenging because inconsistent arguments are often hidden within fluent and plausible narratives, while existing datasets lack argument-level annotations for cross-source consistency. We propose a multi-source event-structured adversarial graph learning approach for argument-level consistency detection (MS-EAGCD), combining source-aware event generation with heterogeneous multi-view event graph discrimination. Its generator constructs challenging event samples and emphasizes informative hard negatives using discriminator feedback, while the discriminator integrates intra-source structural cues with cross-source consistency signals. Experiments on ACE2005, WIKIEVENTS, and RAMS show that MS-EAGCD improves E2E-F1 by 13.96%, 7.97%, and 2.24% over the strongest baselines, respectively. Further evaluations examine its generalization to newly collected real-world data and the value of argument-level consistency signals for credibility assessment on LIAR-PLUS.}
}
@article{YANG2026117161,
title = {Learning causal structures from LLM-AHP comparisons for interpretable forecasting},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117161},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117161},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018873},
author = {Lan Yang and Xingchen Hu and Witold Pedrycz and Zhiwu Li},
keywords = {Causal discovery, Analytic hierarchy process, Large Language Models, Interpretable machine learning, Uncertainty quantification, Conformal prediction},
abstract = {Large language models (LLMs) can generate pairwise comparisons via the analytic hierarchy process (AHP), yet existing methods treat these judgments independently, discard the causal structure embedded across scenarios, and provide no uncertainty quantification. This paper introduces a framework that addresses these limitations through three innovations. First, multiple AHP matrices from different scenarios are shown to collectively reveal causal relationships among related concepts. By applying DirectLiNGAM to log-odds transformed matrices, we recover a directed acyclic graph with theoretical identifiability guarantees under non-Gaussian noise. Second, we design a causal-constrained linear predictor whose recursive structure follows the learned causal graph; combined with conformal prediction, it delivers calibrated uncertainty intervals whose width adapts to AHP inconsistency. Third, a logit decomposition method is proposed to attribute predictions to individual causal parents and generate natural language explanations of how each causal pathway contributes to the outcome. We evaluate the proposed framework on three real-world datasets: FRED (macroeconomic policy forecasting), CDC (influenza surveillance), and MIMIC-III (clinical mortality prediction). Experiments show the framework recovers causal relationships, achieves calibrated uncertainty, and widens prediction intervals with AHP inconsistency. Domain experts rate its path-level explanations significantly higher on faithfulness and usefulness than baselines, and theoretical analysis provides identifiability and coverage guarantees—capabilities black-box predictors lack for high- stakes decisions.}
}
@article{WANG2026117133,
title = {A Partial Reinforcement Optimizer-based Echo State Network for nonlinear time-series model},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117133},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117133},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018599},
author = {Lei Wang and Xibo Lv and Deyuan Dai and Junpu Wang and Jing Zhao and Jianjun Cui},
keywords = {Echo state network (ESN), Nonlinear time-Series prediction, Reservoir structure optimization, Partial reinforcement optimizer (PRO)},
abstract = {Predicting the sequential structure of time series is essential for understanding past behavior, predicting future trends, and making timely decisions in dynamic environments. Echo State Networks (ESNs) are efficient for temporal prediction since only the output layer is trained; however, their randomly generated reservoirs often contain redundant or weakly contributing neurons, leading to unnecessary structural complexity and reduced generalization. To address this issue, a Partial Reinforcement Optimizer-based Echo State Network (PRO-ESN) is proposed for adaptive reservoir pruning. In PRO-ESN, information entropy is introduced to evaluate the dynamic contribution of reservoir neurons, and reservoir pruning is formulated as a neuron-retention mask optimization problem. The Partial Reinforcement Optimizer searches for an effective sparse structure through elite reinforcement, subpopulation correction, and entropy-guided Gaussian mutation. A multi-objective fitness function is further designed to balance prediction accuracy, structural complexity, entropy distribution, and spectral-radius stability, thereby preserving the nonlinear representation capability of the pruned reservoir. Stability and convergence analysis are provided to support the feasibility of the proposed pruning mechanism. Experiments are conducted on MG, Lorenz, Sunspot, NARMA10, NH4−N and the Power generation datasets. Compared with other ESN models, PRO-ESN achieves the best or highly competitive performance in terms of MSE, RMSE, MAE, and R2. The results demonstrate that PRO-ESN can adaptively remove redundant neurons while maintaining prediction accuracy, achieving a favorable balance between model compactness and forecasting performance.}
}
@article{ISLAM2026117182,
title = {Bootstrap Wasserstein alignment for stable feature attribution in low-data regimes},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117182},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117182},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019088},
author = {Mujahidul Islam and Priya Dubey},
keywords = {Feature attribution, Optimal transport, Bootstrap aggregation, Explainable AI, Wasserstein barycenter, Low-data regime},
abstract = {Feature attribution methods become unreliable in low-data regimes (N≪d), producing inconsistent explanations across bootstrap replicates. We propose BWA (Bootstrap Wasserstein Alignment), a geometric framework that projects each bootstrap-replicate attribution to a probability measure on the feature simplex and aggregates the replicates via a Wasserstein-barycenter consensus paired with a per-feature sign-abstention mechanism. We present two versions: BWA-v1 with a hard binomial sign test, and BWA-v2 with a magnitude-weighted soft sign and a per-feature median-absolute-value scale that preserves natural attribution magnitudes. BWA-v2 closes a documented sign-accuracy deficit of BWA-v1 by 5–15 percentage points across eight experiments spanning synthetic data (N=20, d=100, B=50, 100 trials), MNIST saliency (N=100, d=784, 5 seeds × 50 images), Golub leukemia gene expression (N=72, d∈{500,2000}), and four UCI tabular datasets (N∈{20,50}, d∈{13,30,34,60}). On sparse-signal domains BWA-v2 produces significantly sparser attribution maps than every Euclidean baseline: MNIST Gini 0.645 vs. 0.613 Vanilla Mean and 0.584 budget-matched SmoothGrad; gene-expression Gini 0.417 at d=500 and 0.427 at d=2000 vs. Vanilla Mean 0.397/0.405 (all pbonf≪0.001). On dense tabular UCI data BWA-v2 ties Vanilla Mean on every metric – a scope limitation we disclose explicitly. We pair the method with a bootstrap-level uncertainty σUQ (model-retraining variance, an order of magnitude larger than SmoothGrad’s input-noise variance) and a continuous per-feature soft-sign confidence signal, supporting explicit reliability estimation of attributions under data scarcity. Theoretically, Lemma 1 formalizes the worst-case norm-collapse failure of Euclidean averaging under sign-flip symmetry, motivating the geometric approach. We also clarify precisely what the Wasserstein barycenter contributes to each version: we prove that BWA-v2’s soft sign is an exact per-feature positive rescaling of the bootstrap mean (Proposition 2) and hence provably preserves its sign (Proposition 3) and is provably independent of the cost matrix (Proposition 4) – v2 closes BWA-v1’s sign-accuracy deficit by algebraic construction, not by geometric estimation, and the barycenter enters v2 only as an auxiliary uncertainty diagnostic. We verify this identity numerically with zero sign disagreements across 8465 features. BWA-v1’s barycenter remains load-bearing, and we report the one regime – domain-informed pathway recovery – where it demonstrably earns its cost .}
}
@article{JI2026117101,
title = {Granular ball separability-based attribute reduction},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117101},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117101},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018277},
author = {Xia Ji and Yanqi Shen and Jianhua Peng and Yu Wang and Yuchen Cao and Mengxin You},
keywords = {Attribute reduction, Fuzzy rough set, Granular ball model, Separability},
abstract = {Attribute reduction can minimize both storage and computational costs and improve classification performance. Fuzzy rough sets exhibit superior performance in knowledge mining, but considering both object-to-object and object-to-decision class relationships increases computational complexity, making them difficult to handle large datasets. Fast and robust attribute reduction based on separability in fuzzy decision systems(SFSS) measures the separability of attribute subsets through aggregation and dispersion degrees, focusing solely on object-to-decision class relationships. This approach reduces computational time but ignores object-to-object relationships and treats each class as a single cluster. To address these issues, we propose the concept of granular ball separability, which accurately measures the separability of the attribute subset. We first introduce the granular ball model to study the micro-cluster structure of classes and define the local degree of aggregation. Then, we use the model to fit data distributions and replace samples with granular balls. Based on this, we calculate object-to-object relationships and define the overall degree of aggregation. Finally, we design an attribute reduction algorithm based on granular ball separability(GBSR), ensuring effective attribute reduction while prioritizing efficiency. To further improve the efficiency and effectiveness of GBSR, we introduce a granular ball generation algorithm with sample-label optimization, which significantly improves the quality of granular balls. To demonstrate the effectiveness and advancement of GBSR, we conduct comprehensive experiments on 17 datasets, including image datasets, and compare the proposed algorithm with nine classical and state-of-the-art attribute reduction algorithms. The results show that GBSR achieves high classification accuracy and maintains low and stable computational time.}
}
@article{YANG2026117153,
title = {Defect SAM Adapter: Dual-path dynamic adapting Segment Anything Model for surface defect segmentation},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117153},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117153},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018794},
author = {Xudong Yang and Xinnan Fan and Peiyu Zhao and Pengfei Shi},
keywords = {Defect segmentation, Segment Anything Model, Adapter, Visual language model, Transfer learning},
abstract = {As a promptable visual segmentation model, the Segment Anything Model (SAM) has demonstrated outstanding performance in general image segmentation. Nevertheless, its effectiveness on defect segmentation is often constrained by the absence of defect-specific domain priors. Consequently, a key challenge is to efficiently acquire domain knowledge for defects without sacrificing SAM’s generalization capability. In this paper, we propose De-SA, a defect semantic segmentation framework that injects defect-domain knowledge into the segmentation model via differentiated image and text adapters. In De-SA, we augment the SAM architecture with a CLIP text encoder and redesign the mask decoder to produce defect segmentation outputs with global category consistency. For the image encoder, we devise a Dual-Path Dynamic Adapter (DPD-Adpt), which leverages dual-path dynamic balancing together with a gated residual-connection mechanism to enable lossless propagation of key defect feature and efficient transfer of defect-domain knowledge. To better preserve semantic integrity and training stability, we further introduce a lightweight text-side adapter that replaces conventional residual connections with a Gated Residual Connection (GRC). In addition, we introduce a text-mask contrastive loss to strengthen the semantic alignment between the predicted segmentation masks and their corresponding text descriptions. We conduct extensive experiments on both public and self-built defect semantic segmentation datasets to validate the effectiveness of De-SA. The results demonstrate that De-SA achieves competitive mIoU scores of 84.56%, 77.14%, and 90.47% on NEU-Seg, MT-Defect, and Dam-Defect, respectively. The code will be available at https://github.com/MosYangxd/Defect-SAM-Adapter.}
}
@article{LIN2026117129,
title = {An interpretable vertical federated learning framework based on belief rule bases for long-tailed classification},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117129},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117129},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018551},
author = {Ziqian Lin and Longhao Yang and Ying-Ming Wang},
keywords = {Belief rule base (BRB), Cross-source evidence fusion, Vertical federated learning, Long-tailed classification, Evidential reasoning},
abstract = {Vertical federated learning (VFL) enables collaborative modeling over aligned samples with distributed features, but it usually leaves the evidence chain behind each collaborative decision implicit. Models built on belief rule bases (BRBs) provide an interpretable framework by retaining a traceable rule-evidence path for each prediction. However, conventional BRB learning assumes centralized access to complete features and labels, which conflicts with standard VFL, where passive clients retain raw features locally and labels are held by the active party. To bridge this gap, this paper formulates rule-evidential learning under VFL constraints and proposes Interpretable Belief-Rule-Based Vertical Federated Learning (IBR-VFL) for long-tailed vertical federated classification, where tail classes contain substantially fewer samples than head classes. In IBR-VFL, passive clients construct label-free local rule skeletons and transmit matching-degree summaries, which the active party converts into source-wise belief-rule evidence and fuses through evidential reasoning. Long-tailed iterative refinement improves consequent-side rule parameters, while source-composed evidence rules capture cross-source co-matching patterns to strengthen tail-class evidence. Experiments on four tabular datasets show that IBR-VFL maintains competitive predictive performance among rule-evidence models. Case-level tracing and evidence-masking analyses further demonstrate that, without pooling passive-client raw features, IBR-VFL retains a traceable path from local rule matches and source-wise beliefs to cross-source evidence and final tail-class decisions. The project page is available at https://github.com/coke2020ice/IBR-VFL.}
}
@article{WANG2026117190,
title = {HIN: A unified framework for knowledge-dense overlapping Multimodal Relation Extraction},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117190},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117190},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019167},
author = {Hailin Wang and Hangyi Ren and Dan Zhang and Jianzhang Wei and Zhekai Du and Guisong Liu and Ke Qin},
keywords = {Overlapping relation, Multimodal relation extraction, Information extraction, Knowledge-dense, Bottleneck},
abstract = {Multimodal Relation Extraction (MRE) aims to identify relational triples from text–image pairs. However, real-world multimodal instances are often knowledge-dense, containing multiple overlapping relations that share highly similar textual and visual evidence, making relation prediction unstable and difficult to discriminate. In this work, we revisit MRE in the context of overlapping multimodal relation extraction (O-MRE). To facilitate systematic evaluation, we reorganize two benchmark datasets with explicit overlapping annotations and analyze the limitations of existing methods in knowledge-dense overlapping scenarios. Based on these findings, we propose a unified framework that progressively aligns cross-modal semantics, adaptively reweights multimodal features, and stabilizes overlapping relation prediction through local–global interaction modeling. Experiments on both standard and overlapping benchmarks demonstrate robust, competitive performance, especially in densely overlapping multimodal settings. Overall, this work advances MRE toward more realistic knowledge-dense scenarios and provides a unified framework for robust multimodal relation reasoning.}
}
@article{HUANG2026117210,
title = {Dual-space optimization for multi-LoRA fusion: Mitigating parameter conflicts in both parameter and fusion-weight space},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117210},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117210},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019362},
author = {Yanghui Huang and Donglin Cao and Dazhen Lin},
keywords = {Multi-LoRA fusion, Dual-space optimization, Parameter conflict mitigation, Cross-task fusion},
abstract = {Multi-LoRA fusion has become an effective paradigm for parameter-efficient adaptation of large language models. However, existing methods primarily focus on fusion-weight-space aggregation strategies and typically assume that independently trained LoRA modules are mutually compatible. This assumption is often violated in practice, as heterogeneous task-specific updates introduce parameter redundancy and cross-task conflicts, leading to interference during fusion and unstable optimization behavior, especially in cross-domain scenarios. To address these challenges, we propose DSO-MLoRA, a dual-space optimization framework that explicitly models and mitigates conflicts in both parameter and fusion-weight spaces. In the parameter space, we introduce a unified scoring mechanism that jointly considers parameter importance and cross-task consistency to identify redundant and conflicting updates, followed by a directional alignment strategy to improve cross-module compatibility. In the fusion-weight space, we design an input-dependent gating mechanism with symmetric low-magnitude initialization and temperature-controlled normalization to stabilize fusion weight learning and reduce optimization bias. Comprehensive experiments on Traditional Chinese Medicine, mathematical reasoning, and cross-domain fusion settings show that DSO-MLoRA achieves higher macro-average accuracy than the evaluated baseline methods. Ablation studies further validate the contributions of parameter-space refinement and fusion-weight-space stabilization. These results demonstrate the effectiveness of jointly optimizing parameter interactions and fusion weights for multi-LoRA fusion.}
}
@article{SHE2026116944,
title = {LLMDRL-4V: Large language model-guided deep reinforcement learning for efficient video compression},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {116944},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116944},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016709},
author = {Rui She and Enfang Cui and Gang Lu and Yuting Wu and Chao Zheng},
keywords = {Video compression, Reinforcement learning, Large language models, Expert strategies, Semantic understanding},
abstract = {Deep Reinforcement Learning (DRL)-based video bitrate control has been widely adopted in edge-cloud video compression due to its strong dynamic adaptability. However, existing DRL approaches face two main challenges: (1) limited generalization due to reliance on lightweight models for extracting specific video features, and (2) slow convergence due to inefficient exploration. This paper proposes an LLM-guided constrained deep reinforcement learning adaptive compression framework named LLM-GDRL. The proposed framework leverages large language models to extract multi-dimensional high-level semantic features and construct unified retrieval representations, and builds a retrieval-augmented generation expert strategy library to provide coding prior knowledge for agent training. Meanwhile, a Jensen–Shannon divergence regularization term is introduced to constrain the deviation between the learned policy and LLM expert policy, which balances the autonomous exploration ability of reinforcement learning and semantic guidance. Sufficient ablation experiments, hyperparameter sensitivity analysis and state-of-the-art baseline comparisons are conducted to verify that the proposed framework can effectively balance reconstruction quality, compression efficiency and training convergence speed.}
}
@article{WU2026117166,
title = {Enhancing session-based recommendation via large language models: A counterfactual method},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117166},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117166},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018927},
author = {Xinglong Wu and Sheng Yin and Yu Tai and Hui He and Weizhe Zhang and Xianjin Fang},
keywords = {Session-based recommendation, Causal inference, Counterfactual inference, Large language model},
abstract = {Incorporating large language models (LLMs) into recommender systems to leverage semantic information in textual features has been a promising direction. Prevailing recommendation models use collaborative filtering to encode interaction patterns associated with user preferences and item relevance, while language models contribute representations derived from textual content. Despite their effectiveness, the semantic gap between collaborative user behavior representations and textual content descriptions is unresolved, which can impede the integration of multifaceted pattern learning and yield suboptimal performance. We formulate the relations among language-derived and collaborative signals in LLM-enhanced session-based recommendation from a causal-inference perspective and identify language bias as an excessive reliance on textual semantics. Accordingly, we propose a Causal LLM-based Recommendation model, CauLRec, which estimates direct and indirect effects associated with language representations and uses counterfactual inference to reduce language bias in the evaluated session-based recommendation setting. To verify the rationality of our model, we conducted extensive experiments on four real-world datasets. The results demonstrate the effectiveness of our CauLRec model, with average improvements of 30.77% and 18.79% in Recall@K and NDCG@K, respectively.}
}
@article{JABER2026117154,
title = {CGNC: Confidence-Guided Neighbor Consensus for semi-supervised learning},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117154},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117154},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018800},
author = {Ahmed Abbas Jaber and Mengzi Tang and Zhishu Shen and Jingling Yuan},
keywords = {Semi-supervised learning, Pseudo-labeling, Confidence-guided neighbor, Contrastive learning},
abstract = {Semi-supervised learning (SSL) leverages large amounts of unlabeled data alongside limited labeled samples to improve model performance. However, most existing pseudo-labeling methods treat label assignment as an individual decision problem, relying solely on single-sample predictions. Under limited supervision, such predictions are often unreliable, leading to noisy pseudo-labels and reinforcing confirmation bias during training. In this paper, we introduce CGNCMatch, a semi-supervised learning method centered on a confidence-guided local neighbor consensus module for pseudo-label refinement. Instead of relying on isolated predictions, CGNCMatch refines pseudo-labels by dynamically aggregating predictions from top-K confident and semantically similar neighbors in the feature space, with contributions weighted by both similarity and confidence to prioritize reliable sources. This consensus-based refinement mechanism aims to construct more reliable supervisory signals by jointly considering local feature-space similarity and prediction confidence, thereby reducing the influence of isolated noisy predictions. To further stabilize training, CGNCMatch enforces consistency while simultaneously shaping feature representations through a graph-aware contrastive objective guided by refined pseudo-labels. Comprehensive experiments on standard benchmarks (CIFAR-10/100, SVHN) demonstrate competitive performance against representative semi-supervised learning baselines, particularly in extremely low-label regimes. Furthermore, we validate scalability on ImageNet, showing that CGNCMatch maintains its advantages on large-scale, high-resolution data. Source code is available at https://github.com/ahmdbas727/CGNCMatch.git.}
}
@article{WANG2026117173,
title = {StreamWatch: Decoupled streaming video understanding for interpretable surveillance anomaly detection},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117173},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117173},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601899X},
author = {Zilong Wang and Hao Wu and Junlong Tong and Xiaoyu Shen},
keywords = {Video anomaly detection, Surveillance video understanding, Multimodal large language models, Streaming video description, Decoupled architecture},
abstract = {Conventional video anomaly detection methods often return anomaly scores without explanations, while recent multimodal large language model (MLLM) approaches are commonly evaluated offline. To address these limitations, we present StreamWatch, a practical framework that separates streaming video description from anomaly-aware reasoning through a textual semantic interface. Its description module uses a lightweight vision-language model to generate temporally aligned scene descriptions, while its reasoning module uses timestamped descriptions, configurable temporal context, and domain-specific decision rules to detect anomalies and generate structured 5W1H (When, What, Who, Where, Why, and How) explanations. To adapt the description module to surveillance content, we construct SecVD-60k, a dataset of 62,427 clips derived from UCF-Crime and XD-Violence, and use it to fine-tune surveillance-specific description models. Fine-tuning improves description quality to 18.7 BLEU-4 and 0.91 BERTScore. Under the evaluation protocol used in this study, StreamWatch achieves 80.4% F1 on UCF-Crime and 90.7% on XD-Violence. The two modules operate as independent services: while the reasoning module analyzes the description of one clip, the description module can process the next clip. On a single video stream using two dedicated NVIDIA A800 GPUs, all tested configurations achieve a mean end-to-end latency of 3.29–3.91 s per clip, including the 5-s clip settings. These results demonstrate a modular system design for interpretable single-stream monitoring under measured latency constraints.}
}
@article{LI2026117118,
title = {Adaptive multimodal prompt learning: Dynamic handling of missing modalities for robust emotion recognition},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117118},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117118},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018447},
author = {Jian Li and Junhui Gong and Junyi Chen and Ruoyu Chen and Yufan Wang and Yu Fu and Yuliang Zhao},
keywords = {Missing modality, Multimodal learning, Cross-modal attention, Parameter-efficient fine-tuning},
abstract = {Multimodal learning typically assumes all modalities are available during training and inference. However, challenges like equipment failure, privacy issues, and data corruption often result in missing modalities, which limits the performance of existing multimodal models. While past methods, including prompt learning, have attempted to address missing modality problems, they lack the dynamic adaptation needed to handle varying missing data effectively. To address this, we propose Adaptive Multimodal Prompt Learning (AMPL), which combines efficient fine-tuning of pre-trained unimodal models with dynamic prompt learning. AMPL builds upon standard fully-paired multimodal training data and does not demand additional unpaired samples. AMPL leverages available modalities to predict missing modality embeddings using dynamic prompts and cross-modal attention mechanisms, enabling seamless inference of missing data. This dynamic adaptation ensures more robust and accurate emotion recognition, even when certain modalities are missing. Compared to existing methods, AMPL introduces a dynamic adaptation layer, making it more efficient, scalable, and adaptable to real-world multimodal applications. Evaluations on three benchmark datasets show that AMPL consistently outperforms state-of-the-art methods in terms of both robustness and efficiency under missing modality scenarios.}
}
@article{LIU2026117170,
title = {CoExpert-AD: An expert-collaborative multimodal reasoning framework for industrial anomaly detection},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117170},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117170},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018964},
author = {Chen Liu and Rui Song and Qiang Fang and Yanding Wei and Libin Wang},
keywords = {Industrial anomaly detection, Multimodal large language model, Explainable reasoning, Group relative policy optimization},
abstract = {Conventional deep learning models for Industrial Anomaly Detection (IAD) excel at anomaly discrimination or localization, but they fundamentally lack the cognitive capabilities required for explainable reasoning. Although Multimodal Large Language Models (MLLMs) offer a promising alternative, their direct application in IAD is hindered by inherent visual bottleneck and a lack of domain-specific expertise. To overcome these limitations, we propose CoExpert-AD, an expert-collaborative multimodal reasoning framework that seamlessly integrates experts related to anomaly detection with the reasoning prowess of MLLMs. Our framework introduces a Visual expert-guided Prompt Generator (VPG) and a Selective Mixture of Experts (SMoE) module to collaboratively provide task-specific multimodal context for IAD reasoning. The VPG uses masks from visual experts to generate zoom-in crops and bounding box prompts, explicitly steering the MLLM’s attention toward critical regions of interest, thereby effectively alleviating the visual bottleneck. Concurrently, The SMoE injects structured textual priors to equip the model with essential domain knowledge and relevant expertise. Furthermore, we devise an efficient two-stage fine-tuning strategy encompassing Supervised Fine-Tuning (SFT) and Group Relative Policy Optimization (GRPO). Crucially, a novel Task-specific Context-Response Alignment (TCRA) reward mechanism is introduced during GRPO to explicitly supervise intermediate reasoning steps, enhancing context-aware CoT reasoning capabilities. Extensive experiments demonstrate that CoExpert-AD achieves human-expert proficiency with an 88.34% average accuracy on comprehensive benchmarks, substantially outperforming state-of-the-art methods and exhibiting robust generalization in real-world manufacturing scenarios. The code will be available at https://github.com/Faker311/CoExpert-AD.}
}
@article{CORRADINI2026117150,
title = {Trust signals in multiplex socio-technical networks: Information-aware load redistribution for cascade resilience},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117150},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117150},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018769},
author = {Enrico Corradini},
keywords = {Multiplex networks, Trust signals, Cascading failures, Resilience, Socio-technical services},
abstract = {Relational trust signals are proposed to make load redistribution resilient to overload-driven cascading failures in socio-technical platforms, yet whether they help beyond the extra capacity they add has never been isolated. We answer this with a capacity-controlled decomposition. Framing crowd-shipping as a two-layer multiplex network, we inject a multiplex-centrality relational signal into both capacity buffering and load redistribution (the Social-Aware policy), and test it by Monte Carlo simulation on proxy topologies from two location-based social networks, Gowalla and Brightkite. At matched capacity, the gains attributed to trust are predominantly capacity-mediated: a slack-aware policy on a uniform buffer is significantly better than the trust-based policy on Brightkite, while on Gowalla no significant difference emerges and the equivalence test is inconclusive. Two principles follow. First, alignment: concentrating capacity helps only when redistribution steers load toward the reinforced nodes; otherwise a provable load-concentration limit (the Gravity-Well) centralizes systemic risk at high trust sensitivity. A placement×routing factorial at matched concentration shows degree- and PageRank-based concentration with no significant difference from the relational signal on Brightkite (a small residual on Gowalla): alignment, not the signal, is the primary lever. Second, a conditional value of relational information: with an independent reliability variable, a relational signal improves on non-social concentration only when it encodes operational reliability rather than structural friendship, with gains that grow with that correlation and degrade with estimation noise. These results delineate when relational signals stabilize or destabilize overload cascades, and yield capacity-first, alignment-aware design guidance for resilient socio-technical services.}
}
@article{LI2026117126,
title = {HIC-DRL: A deep reinforcement learning approach for hypergraph influence maximization with independent cascade model},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117126},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117126},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018526},
author = {Peng-Yue Li and Feng Hu and Zhao-Yang Bao and You-Feng Zhao and Yu-Rong Song and Dong Li},
keywords = {Deep reinforcement learning, Social networks, Hypergraphs, Influence maximization, Independent cascade model},
abstract = {Influence maximization (IM) aims to select a set of influential seed nodes to maximize information spread in social networks. Higher-order group relationships prevalent in real-world social interactions are difficult to capture with traditional graph models based on pairwise connections, whereas hypergraphs provide a natural representation of such complex interaction structures. However, most existing hypergraph diffusion models are based on the linear threshold (LT) model, whose “cumulative-influence” assumption struggles to describe independent information diffusion along social ties in scenarios such as viral marketing and news dissemination. In contrast, the independent cascade (IC) model is better suited to simple-contagion processes, where activation can be triggered by a single contact. Nevertheless, efficient learning-based solvers tailored to hypergraph IC diffusion remain underdeveloped. To this end, we study IM under the hypergraph independent cascade (HIC) model and propose HIC-DRL, the first end-to-end deep reinforcement learning framework dedicated to this setting. HIC-DRL integrates structural representation learning based on a hypergraph neural network with sequential seed selection based on deep reinforcement learning. Experiments on nine real-world datasets show that HIC-DRL achieves an average of 98.7% of the influence spread obtained by the greedy algorithm, while substantially improving computational efficiency. Ablation studies further confirm the effectiveness of the pre-training mechanism. In addition, direct hypergraph modeling outperforms clique-expansion-based graph methods, underscoring the importance of preserving higher-order structure. This work characterizes the theoretical properties of influence maximization under the HIC model and provides an efficient end-to-end learning-based solver, offering significant value for social network analysis and information diffusion management.}
}
@article{YE2026117199,
title = {A transferable adversarial attack method via Loss Surface Guided Gradient Optimization},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117199},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117199},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019258},
author = {Chuan Ye and Xiaoqing Yang and Yunhan Li and Benlin Lai and Fei Jiang and Fan Yang},
keywords = {Adversarial attack, Loss surface, Curvature estimation, Gradient optimization, Neighborhood sampling},
abstract = {Deep neural networks are vulnerable to adversarial attacks. Existing methods exhibit insufficient transferability on adversarially trained ensemble models. This paper proposes Loss Surface Guided Optimization (LSGO), a transferable adversarial attack method that systematically incorporates curvature information into the adversarial example generation process. A curvature-aware gradient lookahead mechanism is first presented, which constructs lookahead points along the gradient ascent direction to approach high-loss regions, and fuses the gradients at these points with the current gradients to mitigate surrogate model bias. Subsequently, a Lipschitz-guided neighborhood sampling strategy is developed to estimate directional Lipschitz constants for constructing probability sampling distributions, concentrating sampling on sensitive directions with drastic gradient variations. Finally, a curvature-regularized gradient fusion framework is established that quantifies gradient consistency via cosine similarity and derives adaptive mixing coefficients from curvature correction factors to achieve dynamic multi-source gradient fusion. Experiments on ImageNet, CIFAR-10 and CIFAR-100 show that, under the representative model architectures and defense strategies evaluated in this work, the proposed method achieves better overall performance on both normally trained and defensive models.}
}
@article{LU2026117094,
title = {Gated Spline-Wavelet Kolmogorov-Arnold Recurrent Unit for multi-agent reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117094},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117094},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018204},
author = {Yufan Lu and Hongli Zhang and Sha Wei and Fenghua Huang and Shulin Liu and Chi Wang and Cheng Huang and Jian Peng and Weiheng Cheng},
keywords = {MARL, POMDP, Memory modeling, KAN, Wavelet basis functions},
abstract = {Learning effective recurrent representations is important for multi-agent reinforcement learning (MARL) under partial observability. This study proposes the Gated Spline-Wavelet Kolmogorov-Arnold Recurrent Unit (GSWKRU), which combines spline and Morlet wavelet basis functions through a learnable fusion gate within a recurrent architecture. The spline branch provides local flexibility in the feature domain, while the wavelet branch provides oscillatory nonlinear responses controlled by its scale and frequency parameters. The recurrent state carries information across decision steps, and the fusion gate adjusts the contributions of the two representations. We evaluate GSWKRU on cooperative MARL tasks, competitive and mixed MPE tasks, and standard sequence benchmarks. Eight-seed component ablations show that GSWKRU achieves the highest mean win rate among the four evaluated recurrent units on MAPPO–8m. Adaptive fusion also yields higher mean win rates and lower between-seed variability than direct addition and fixed-weight fusion on both 3 m and 8 m. Cross-backbone experiments further show favorable performance on VDN–3m, while hidden-state interventions support a functional contribution of the recurrent state on 3 m. Comparisons with advanced memory architectures and evaluations on MPE and standard sequence benchmarks reveal task-dependent performance. Overall, the results support gated spline–wavelet fusion as a useful recurrent representation design for MARL, with its benefits balanced against additional computational cost.}
}
@article{SHI2026117146,
title = {A Subspace Collaborative Continual Test-time Adaptation Framework for Online Fault Diagnosis in Non-stationary Data Streams},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117146},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117146},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018721},
author = {Yaowei Shi and Zixin Guo and Haitao Zhao},
keywords = {Online fault diagnosis, Continual test-time adaptation, Subspace collaboration, Continual learning, Knowledge retention},
abstract = {In dynamic industrial environments, continuous fluctuations in operational conditions cause severe data distribution shifts, presenting a major challenge for intelligent diagnostic models. Conventional diagnostic methods typically rely on static offline learning assumptions, making them prone to catastrophic forgetting and performance degradation due to domain shift when adapting online to non-stationary, source-free data streams. To address this, a subspace collaborative continual test-time adaptation (SC-CTTA) learning framework for intelligent diagnosis is proposed. By decoupling the feature space into a source domain primary subspace, a historical task subspace, and an orthogonal complement space, the proposed framework structurally separates semantic anchors and historical experience from the exploration of knowledge about new working conditions. Within this framework, a dual-constraint mechanism integrating gradient orthogonality and statistical alignment is designed to continuously mitigate feature drift without overwriting previously acquired diagnostic knowledge. To ensure robust convergence during constrained optimization, a feature adversarial smoothing strategy is incorporated to flatten the local loss landscape, thereby facilitating stable parameter updates during online adaptation. Extensive evaluations on continuous streaming datasets with varying speeds and loads demonstrate that SC-CTTA achieves superior cumulative diagnostic accuracy and strong resistance to catastrophic forgetting compared to state-of-the-art methods. Moreover, its low computational overhead validates its practical feasibility for efficient online knowledge adaptation in edge-deployed industrial environments.}
}
@article{WU2026117186,
title = {Answer-oriented collaborative distillation for multi-stage evidence-augmented question answering},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117186},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117186},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601912X},
author = {Yaying Wu and Tao Wang and Yurong Qian and Junhang Wu and Kai Wang},
keywords = {Question answering, Retrieval-augmented generation, Collaborative distillation, Evidence selection},
abstract = {Retrieval-augmented generation (RAG) supports open-domain question answering by grounding generated answers in external evidence through retrieval, reranking, and generation. However, these modules are often optimized with separate objectives, creating a mismatch between intermediate evidence processing and final answer correctness. Retrieved passages may be topically relevant without supporting the answer, highly ranked evidence may offer limited generation utility, and generator outputs may remain misaligned with downstream task requirements. Applying knowledge distillation to RAG also faces practical challenges, including costly corpus re-encoding and index rebuilding for retriever adaptation, relevance-dominated reranker supervision and expensive generation-aware support construction, and potential mismatch between long rationale targets and task-specific answer formats. To address these challenges, we propose ACD-RAG, an Answer-oriented Collaborative Distillation framework for multi-stage evidence-augmented question answering. ACD-RAG introduces three coordinated mechanisms: rationale-guided query-side retrieval distillation, which updates only the query encoder while keeping the document encoder and dense index fixed; support-aware reranker distillation, which fuses retrieval relevance, teacher-rationale consistency, and generation-aware support signals with adaptive evidence budgeting; and answer-only generator distillation, which trains the generator on task-specific target answers using selected evidence. Experiments on four short-answer QA benchmarks and the long-form ASQA benchmark show that ACD-RAG consistently improves over the standard RAG baseline and remains competitive with strong training-based RAG methods. Repeated-run and format-insensitive analyses indicate generally modest margins over strong training-based baselines, while adaptive evidence budgeting reduces offline generator-based support-scoring calls by 49.2% and maintains downstream QA performance close to fixed top-20 support scoring.}
}
@article{DANGI2026117207,
title = {LiteSent: a lightweight adaptive multi-scale framework for social media and review-based sentiment classification},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117207},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117207},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019337},
author = {Dharmendra Dangi and Dheeraj Kumar Dixit and Amit Bhagat},
keywords = {Adaptive softmax, 1D dilated convolution, DistilBERT embedding, Groupwise ALBERT transformer, Sentiment analysis, Temporal convolutional network, Waterfall sequential atrous pooling},
abstract = {A Lightweight Adaptive Multi-Scale Framework for Social Media and Review-Based Sentiment Classification is proposed in this study for effectively classifying sentiments. Existing transformer-based models require high computational complexity and provide limited scalability, but the proposed model incorporates a lightweight architecture for processing textual data through a multi-stage pipeline. The Spike-Sparse DistilBERT Embedding is employed to generate contextual embeddings using sparse attention and depthwise separable feed-forward transformations to reduce computational complexity. The Waterfall Sequential Atrous Pooling-based multi-scale feature extraction employs 1D dilated convolution to capture both long and short-range dependencies. To independently evaluate the attention within the feature groups, the Groupwise ALBERT transformer is used. The Context Refinement Convolution with Temporal Convolutional Network is employed to model long-range contextual dependencies in token sequences and refine contextual interaction. An adaptive Softmax layer is employed to dynamically adapts the output layer to datasets containing different numbers of sentiment classes. Thus, it produces a robust prediction for sentiment. Extensive experiments conducted on five benchmark datasets— SemEval 2014 Task 4: ABSA, Twitter sentiment analysis, IMDB reviews, Amazon reviews, and a Twitter sentiment dataset- demonstrate that the Lightweight Adaptive Multi-Scale framework achieves, an macro-averaged precision of 0.948, F1-score of 0.942, accuracy of 0.951and a low log loss of 0.209, consistently outperforming several state-of-the-art sentiment analysis methods. These results confirm that the proposed framework provides a robust, computationally efficient, and scalable solution for real-world social media and review sentiment analysis applications.}
}
@article{CHRISTIAN2026117162,
title = {Applying transformer with ensemble matrix and factorization for multi-modal recommender systems},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117162},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117162},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018885},
author = {Albert Christian and R.J. Kuo},
keywords = {Multimodal recommender systems, Transformer, Feature fusion, Deep learning, Ensemble, Matrix-Factorization},
abstract = {Recommender systems are essential to modern digital platforms, yet traditional methods face cold-start issues, data sparsity, and difficulties in integrating heterogeneous information, while Transformer-based models remain constrained by early and late fusion strategies. This study proposes a Transformer with Ensemble Matrix and Factorization (EMT) architecture whose core mechanism is the adaptive, per-domain selection of modality subsets from 63 candidate combinations of precomputed similarity matrices spanning textual reviews, product images, timestamps, helpfulness votes, and numerical metadata. Rather than concatenating raw features or imposing all six similarity matrices unconditionally (an ablation shows the fixed six-matrix configuration does not consistently improve performance), EMT identifies the modality subset best aligned with each domain's rating patterns, while similarity-matrix representations preserve structural relationships and learnable feature-importance weights support interpretability. Experiments on four Amazon review domains show that EMT achieves the lowest MAE in three of four domains and the best average rank among eleven baselines, outperforms the vanilla Transformer on MAE in all four domains, and surpasses the graph-based RGCL on average MAE (0.5549 vs. 0.5737); on RMSE, the vanilla Transformer remains lower, a trade-off consistent with EMT's asymmetric loss prioritizing positive-experience recommendations. Wilcoxon signed-rank, Cliff's delta, and Friedman tests support the significance of the MAE improvements, while per-feature Mann-Whitney U comparisons are reported as exploratory evidence. A cold-start evaluation confirms effective performance for new items. Modality-importance weights and gate activations identify Text and HelpfulVote as dominant signals. The model comprises 912,164 parameters with 1.384 ms per-sample CPU latency, supporting practical deployment.}
}
@article{XIE2026117130,
title = {Less is more: Interpretable prefix-based jailbreaking of MoE language models},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117130},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117130},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018563},
author = {Qingsong Xie and Yuwei Li and Shiwen Ou and Qiangpu Chen and Taiyan Wang and Yu Chen and Yi Shen and Zulie Pan and Lu Yu and Huimin Ma and Miao Hu},
keywords = {Jailbreak method, Mixture-of-experts, Prefix optimization, Safety alignment},
abstract = {Mixture-of-experts (MoE) architectures have become the dominant paradigm for scaling open-source large language models, yet their security implications remain insufficiently understood. Recent studies reveal that MoE safety alignment is concentrated in specific “safety experts” and “safety neurons”, but existing methods require modifying model internals, limiting practical applicability. We identify that a small number of critical tokens in harmful prompts disproportionately activate safety experts at specific layers. Motivated by this insight, we propose ClearCut, a prefix-based jailbreak method that exploits this architectural vulnerability through input manipulation alone while remaining mechanistically interpretable. Specifically, ClearCut optimizes a short adversarial prefix with a hybrid contrastive-suppression loss that redirects these tokens away from safety experts, bypassing safety alignment without any modification to model weights. Across six mainstream MoE models, ClearCut achieves an average success rate of 59.1%, the highest among input-only methods on every model evaluated, outperforming GCG (40.3%) and AutoDAN (45.0%), and approaching the upper-bound reference set by weight-modification methods such as GateBreaker (57.4%). The prefix averages only 5.77 tokens, substantially shorter than existing approaches. By identifying critical tokens and tracking routing changes, ClearCut provides interpretable pathways that reveal how MoE safety mechanisms function. This work exposes a fundamental security risk in MoE architectures, that safety experts can be disproportionately activated and manipulated by a small number of critical tokens. Beyond identifying this vulnerability, we provide ClearCut as a practical tool for security evaluation.}
}
@article{ZHENG2026117191,
title = {DAGSL: Distribution-aware graph structure learning},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117191},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117191},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019179},
author = {Wenbo Zheng and Gang Xiao and Tao Wang and Jiacheng Huang and Ren Li and Yuanming Zhang},
keywords = {Graph representation learning, Graph structure learning, Graph Neural Networks},
abstract = {Graph Neural Networks (GNNs) rely on graph structure for message passing. However, real-world graph structures are often affected by structural noise, such as noisy and missing edges, which disrupt neighborhood aggregation and degrade downstream performance. To mitigate this issue, graph structure learning (GSL) aims to refine graph structure, thereby improving structural quality and enhancing GNN representations. Despite their effectiveness, existing GSL methods suffer from two fundamental limitations. First, most approaches rely on node similarity to infer graph structure, yet node similarity fails to characterize how graph structures contribute to message passing. Second, the optimization granularity is overly local, as graph refinement is typically reduced to edge-wise optimization, ignoring the global consistency of structure. To address these limitations, we propose DAGSL, a distribution-aware graph structure learning method that elevates the basic learning unit from individual edges to structural units and evaluates their propagation value from a higher-level structural distribution perspective. Specifically, DAGSL first groups edges into structural units with similar empirical distribution responses under the adopted structural representation, then estimates the propagation value of each structural unit, selects high-value structural units, and fuses them to construct a refined graph. In this way, DAGSL shifts graph refinement from node-similarity-driven modeling to propagation-value-driven graph refinement while replacing edge-wise optimization with structural-unit optimization. As a plug-and-play structural refinement module, DAGSL can be seamlessly integrated into existing GNN frameworks without modifying backbone architectures. Extensive experiments on real-world datasets demonstrate that DAGSL consistently improves the performance of diverse GNN backbones, validating its effectiveness, robustness, and generalization.}
}
@article{LV2026117187,
title = {An Edge-conditioned Dynamic Attention Network with Choquet-inspired Fusion for multimodal remote sensing image semantic segmentation},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117187},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117187},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019131},
author = {Haoran Lv and Peixian Li and Yuntao Li and Peng Wang and Jinrui Cai and Wenqiang Yue and Weizhu Li and Mingbo Sun and Xiaolong Hu and Junfeng Song},
keywords = {Remote sensing, Multimodal semantic segmentation, Fuzzy measure theory, Edge priors},
abstract = {Accurate urban scene parsing relies on the synergistic integration of optical and elevation modalities. However, existing methods face significant challenges in effectively fusing complementary information from both modalities. Specifically, existing methods lack explicit edge-aware structural priors to guide cross-modal interaction, making it difficult to adaptively determine modality dominance in complex urban regions and preserve clear boundaries, while conventional fusion mechanisms are insufficient to characterize the non-linear interactions between modalities, particularly under heterogeneous structural contexts. To address these issues, we propose an Edge-conditioned Dynamic Attention Network with Choquet-inspired Fusion (EDANet). First, we construct an Average-pooling-based Edge Perception (AEP) module to explicitly extract robust boundary cues from raw data, serving as the geometric foundation of the network. Building on these priors, a Dynamic Modality Attention (DMA) module dynamically modulates each modality’s contribution. Leveraging explicit edge constraints, DMA spatially gates cross-modal interactions to establish adaptive modality dominance. It selectively injects structural cues into the optical branch at edge regions and propagates textural details into the elevation branch in homogeneous regions, effectively mitigating boundary ambiguity and enhancing regional consistency. To model non-linear modal interactions more effectively, we propose an Edge-conditioned Fuzzy Choquet-inspired Fusion (EFCF) module based on a relaxed Choquet-inspired aggregation formulation. Guided by edge information, this structure-aware operator learns spatially varying signed interaction coefficients, reducing redundant information in homogeneous regions while promoting synergy-oriented enhancement at complex boundaries. Extensive experiments demonstrate that EDANet achieves state-of-the-art performance on the ISPRS Potsdam and Vaihingen datasets, with mIoU scores of 87.58% and 85.49%, respectively, exhibiting improved boundary precision and robust cross-modal interaction capabilities.}
}
@article{JEONG2026117090,
title = {Towards granularized evaluation metrics of continual learning through embedding vector analysis},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117090},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117090},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018162},
author = {Euiseog Jeong and Muqiao Yang and Bhiksha Raj and Eunil Park},
keywords = {Continual learning, Class incremental learning, Embedding vector analysis, Metric},
abstract = {Continual Learning (CL) enables models to learn from non-stationary data streams; however, traditional evaluation metrics often rely on aggregate performance gaps, which fail to capture the nuanced stochastic dynamics of catastrophic forgetting and knowledge transfer. We introduce a novel mathematical framework for granularized CL evaluation based on the extraction and distributional analysis of the embedding vectors. We first formalize a taxonomy of influential factors to isolate and categorize the vector components most critical to model evolution, significantly reducing the dimensionality of the analysis. By applying statistical metrics to the sorted distributions of these vectors, we establish an empirical link between the internal representation structure and real-world performance outcomes, with ESO/ESOR serving as an axis-aligned embedding occupancy proxy and PTC providing class-boundary proximity diagnostics. These metrics provide a high-resolution lens into the fundamental trade-offs between generalizability, plasticity and stability. The efficacy of the proposed framework is validated through diverse computational experiments, including audio classification using replay-based strategies and image classification using regularization-based methods. Our results indicate that embedding-based analysis provides complementary diagnostic resolution relative to traditional accuracy-based metrics, offering a scalable tool for assessing complex, continual learning systems.}
}
@article{AN2026117203,
title = {Spec-SSM: Adaptive causal smoothing decomposition and local-to-context residual aggregation for long-term time series forecasting},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117203},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117203},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126019295},
author = {Zhiyong An and Shaomian Zhu},
keywords = {Long-term time series forecasting, Adaptive causal smoothing decomposition, Local-to-context residual aggregation, State space model},
abstract = {Long-term multivariate time series forecasting is widely used in energy management, financial analysis, weather prediction, and disease surveillance. However, real-world time series usually contain heterogeneous temporal dynamics, where smooth evolution, local fluctuations, abrupt changes, and random perturbations are mixed in the same observed sequence. Existing forecasting models often process such mixed signals with a homogeneous architecture, while conventional decomposition methods rely on fixed smoothing rules, which may cause over-smoothing or under-smoothing for variables with different temporal scales. To address these issues, we propose Spec-SSM, a channel-independent, component-aware dual-stream model for long-term multivariate time series forecasting. Specifically, we introduce an Adaptive Causal Smoothing Decomposition (ACSD) module. Driven by the forecasting objective, ACSD learns a normalized causal smoothing kernel separately for each variable and uses the learned kernel to assign variable-specific weights to the current and historical observations. It thereby decomposes the input sequence into a Causal Smooth Component and a Residual Component while preserving temporal causality. The Causal Smooth Component is modeled by a lightweight convolutional stream to capture stable and slowly varying dynamics. For the Residual Component, we propose a Local-to-Context Residual Aggregation (LCRA) module, which first performs Patch-wise Local Residual Enhancement with a CNN Local Encoder and then aggregates context information within the observed historical window through bidirectional state-space modeling. This local-to-context residual modeling mechanism helps preserve abrupt and high-frequency residual information during contextual modeling. Finally, the predictions of the two streams are fused to generate the forecasting result. Extensive experiments on eight real-world benchmark datasets demonstrate that Spec-SSM achieves competitive forecasting performance across different prediction horizons.}
}