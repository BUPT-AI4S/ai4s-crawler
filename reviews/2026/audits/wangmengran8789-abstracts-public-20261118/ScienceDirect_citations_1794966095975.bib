@article{LIU2026115994,
title = {Dual-model joint prompting for image dehazing},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115994},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115994},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007203},
author = {Yanting Liu and Hui Yin and Ying Yang and Qianqian Du},
keywords = {Image dehazing, Image prompt, Language prompt, Deep learning},
abstract = {For real-world dehazing, introducing additional clear reference images to provide domain information has proven effective in a weak-supervised manner. However, the inherent pixel misalignment between the reference and hazy images causes unavoidable content interference. Compared with images, language is more concise and general, providing summary information to complement the reference image. Therefore, we propose a novel Dual-modal Joint Prompting method for Image Dehazing, dubbed DJP-Dehaze, which significantly improves the dehazing effect by combining image prompt and language prompt appropriately. Specifically, the content-related reference images are selected as image prompts to learn more dense and rich information. This image prompt is not only introduced into the network structure, but also used as supervisory information to construct an image prompt constraint for narrowing the data distribution difference between dehazed images and image prompt. The language prompt mainly includes the content text prompt and the style text prompt. The former describes the overall content information of the hazy image, and we create content text loss to improve the consistency of overall scene information between the dehazed image and reference image by content text prompt as a bridge. Similarly, the style text loss is designed such that the style embedding of the dehazed image is far away from the degraded features of the image described by the latter. Extensive experiments show that our method under dual-model prompts performs better than the weak-supervised dehazing methods under the single image prompt.}
}
@article{ALSHAREEF2026116018,
title = {ReLU-DCT and LASP: Real-valued frequency-domain activations and adaptive pooling for DCT-Based CNNs},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116018},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116018},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007446},
author = {Ibrahim Yousef Alshareef and Ab Al-Hadi Ab Rahman and Ahmad Zuri Shaameri and Nuzhat Khan and Mohd Shahrizal Rusli and Mohamed Khalafalla Hassan and Ali Manzak and Muhammad Nadzir Marsono},
keywords = {Spectral convolutional neural networks, Discrete cosine transform, Activation function design, Layer adaptive spectral pooling, Frequency domain deep learning},
abstract = {Convolutional Neural Networks (CNNs) operating in the frequency-domain have shown promise for enhanced computational efficiency and improved signal interpretability. However, existing spectral CNNs frequently rely on complex valued transforms and lack effective formulations for nonlinear activation and pooling within the spectral space. This paper introduces a fully real-valued Discrete Cosine Transform (DCT)-based CNN framework that incorporates two key innovations: (1) ReLU-DCT, a DC-preserving activation function (AF) specifically designed for the DCT domain, and (2) Layer Adaptive Spectral Pooling (LASP), a lightweight mechanism that dynamically regulates frequency retention across network depth. Together, these components preserve low frequency semantics, mitigate spectral distortion, and stabilize learning dynamics in real valued spectral CNNs. The proposed approach is implemented on LeNet-5 and VGG7 architectures and evaluated using the MNIST and a custom 94-class ASCII character dataset. The proposed method achieves up to 98.44% accuracy, representing a 3.23% point improvement over the baseline DCT model (95.21%), achieving near-parity with spatial CNNs while significantly reducing computational and memory costs through real-valued spectral processing. The primary contribution lies in recovering accuracy losses without sacrificing the efficiency advantages of spectral processing. The current evaluation focuses on grayscale datasets (MNIST and ASCII-94). Extending the framework to more complex and color datasets such as CIFAR-10 and Tiny ImageNet is identified as important future work.}
}
@article{ZHU2026115986,
title = {ProGrasp: Storage-efficient provenance graph compression for APT forensics via structure prediction and attribute aggregation},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115986},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115986},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007124},
author = {Tiantian Zhu and Yiqian Yang and Zhengqiu Weng and Haofei Sun and Zhizhong Ma and Guolang Chen},
keywords = {Intrusion detection, Computer and network security, Advanced persistent threat, Attack graph storage, Attack forensics, Graph structure prediction, Graph attribute aggregation},
abstract = {Advanced persistent threats (APTs) pose severe risks to critical infrastructure owing to their stealthy, long-term nature. Although provenance graphs constructed from kernel logs enable precise attack investigation, their explosive growth demands efficient compression without compromising forensic integrity. This paper introduces ProGrasp, a storage-efficient provenance-graph compression system for APT forensics that achieves lossless compression via dual component optimization (graph structures and graph attributes). First, graph structures are compressed using an LSTM enhanced with multihead attention, which learns topological patterns via adjacency-list delta encoding and continuous value compression while correcting prediction errors using calibration tables. Second, graph attributes undergo semantic vectorization using SecureBERT (a cybersecurity-adapted language model), followed by redundancy elimination via cosine similarity-based HDBSCAN clustering and hierarchical storage in attribute aggregation trees (AATs). Evaluated across nine real-world datasets (including DARPA E3/E4 and custom attack scenarios), ProGrasp reduces disk usage to 9.87% of that for uncompressed data, outperforming LEONARD by 733 MB and SEAL by 150 MB on large-scale traces. Storage time decreases by 38.4% versus that for LEONARD, which is attributed to efficient model training (avg. 1169 s) and calibration (76.89 s). During the query computation phase, throughput surges 21.76× faster than that of LEONARD by leveraging AAT traversal. However, to transparently frame its forensic capabilities, it must be noted that this speedup excludes a one-time graph reconstruction (warm-up) phase, which can take hundreds of seconds on large-scale datasets, positioning ProGrasp as a highly efficient solution for post-incident offline forensics rather than real-time detection.}
}
@article{DUAN2026115949,
title = {GLAD: A Graph-LLM augmented framework for out-of-scope intent detection},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115949},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115949},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006751},
author = {Shijie Duan and Long Yu and Shengwei Tian},
keywords = {Intent detection, Graph neural networks, Out-of-scope, Large language models, Contrastive learning},
abstract = {We propose GLAD, a Graph-LLM Augmented Framework for Out-of-Scope Intent Detection, to improve both in-scope (IS) and out-of-scope (OOS) intent classification in task-oriented dialogue systems. Unlike prior methods that either ignore inter-intent structure or rely too heavily on large language models (LLMs), GLAD injects LLM-generated intent prototypes into a lightweight dynamic graph for relational reasoning. The framework builds a prototype graph from intent descriptions and refines it during training with hysteresis-based edge updates and exponential moving averages. GLAD further introduces a multi-level contrastive objective that aligns utterances with class prototypes, tightens within-class cohesion, and expands decision margins around confusing intents. At inference time, query-aware subgraph sampling supports efficient graph-based reasoning, while a cost-aware hybrid routing mechanism calls an LLM-based verifier only for low-confidence cases. Experiments on three public benchmarks show that GLAD remains highly competitive overall, delivers the strongest F1-OPEN at every tested coverage level, and is particularly effective in low-coverage, fine-grained settings while keeping LLM usage low. Code, configs, prompts, and reproducibility notes are publicly available at https://github.com/Big10tou/GLAD-OOSID.}
}
@article{LIU2026115989,
title = {Automating data-driven modeling and analysis for engineering applications using large language model agents},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115989},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115989},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600715X},
author = {Yang Liu and Zaid Abulawi and Abhiram Garimidi and Doyeong Lim},
keywords = {Large language model agents, Multi-agent systems, ReAct, Workflow automation, Critical heat flux},
abstract = {Modern engineering increasingly relies on vast datasets generated by experiments and simulations, driving a growing demand for efficient, reliable, and broadly applicable modeling strategies. There is also heightened interest in developing data-driven approaches, particularly neural network models, for effective prediction and analysis of scientific datasets. Traditional data-driven methods frequently involve extensive manual intervention, limiting their ability to scale effectively and generalize to diverse applications. In this study, we propose an innovative pipeline utilizing Large Language Model (LLM) agents to automate data-driven modeling and analysis, with a particular emphasis on regression tasks. We evaluate two LLM-agent frameworks: a multi-agent system featuring specialized collaborative agents, and a single-agent system based on the Reasoning and Acting (ReAct) paradigm. Both frameworks autonomously handle data preprocessing, neural network development, training, hyperparameter optimization, and uncertainty quantification (UQ). We validate our approach using a critical heat flux (CHF) prediction benchmark, involving approximately 25,000 experimental data points from the OECD/NEA benchmark dataset. Results indicate that our LLM-agent-developed model surpasses traditional CHF lookup tables and delivers predictive accuracy and UQ on par with state-of-the-art Bayesian optimized deep neural network models developed by human experts. These outcomes underscore the potential of LLM-based agents to automate complex engineering modeling tasks, reducing human workload after one-time task specification and data preparation while meeting or exceeding existing standards of predictive performance.}
}
@article{SANG2026116038,
title = {Three-way role-arbitration outlier detection based on bi-level granular-ball knowledge representation},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116038},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116038},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007641},
author = {Binbin Sang and Hua Zhang and Lei Yang and Shuyin Xia and Weihua Xu and Tianrui Li and Hongzhi Kuai},
keywords = {Granular computing, Granular-ball, Neighborhood rough sets, Three-way decision, Outlier detection},
abstract = {Outlier detection is an effective technique for identifying abnormal samples in complex data. Existing methods often using distance measures in unsupervised data due to the lack of labels. However, relying solely on distance measures may fail to capture complex data distributions, thereby reducing accuracy. Outlier detection methods based on Granular-Ball Computing (GBC) have better robustness and efficiency. However, these methods use a coarse-granularity of granular-balls representation, ignoring the large number of sample information within the granular-balls, which may lead to accuracy loss of outlier detection. To address the above issues, this paper develops a three-way role-arbitration outlier detection based on bi-level granular-ball knowledge representation. First, a bi-level granular-ball knowledge representation method is proposed to address the information loss inherent in GBC-based methods. Then, a granular-ball role generation method is introduced, which leverages three-way boundary neighborhood rough sets, to endow granular-balls with semantic information. Subsequently, a three-way role-arbitration strategy based on bi-level granular-ball knowledge representation is designed to evaluate the outlier degree of samples. Finally, an outlier factor is defined by integrating the three-way role-arbitration score within attribute subspaces for outlier detection. At the same time, a corresponding outlier detection algorithm is proposed. Experiments on twenty public datasets show that the proposed algorithm achieves average AUC of 0.9190 and P(t) of 0.6776, outperforming nine state-of-the-art methods by 5.13% in AUC and 15.5% in P(t).}
}
@article{HONG2026115978,
title = {Moment Learning: Forecasting non-stationary time series with fewer parameters via data-dependent weight sampling},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115978},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115978},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007045},
author = {Jaemoo Hong and Keon Myung Lee},
keywords = {Moment learning, Time series forecasting, Non-stationarity, Transformers, Feed-forward networks, Mixture-of-Experts},
abstract = {Transformers have been widely adopted for time series forecasting, yet non-stationary dynamics often lead to severe performance degradation, as the temporal patterns learned during training frequently fail to match those in test sequences. Given that the Feed-Forward Network (FFN) blocks within the Transformer architecture act as static memories, their parameter-heavy nature is one of the main causes of performance degradation under non-stationary conditions. To mitigate this problem, we propose moment learning, a preliminary yet unconventional method for training the FFNs of Transformers. Rather than individually optimizing every weight parameter as in standard supervised learning, moment learning directly parameterizes the distribution of FFN weights using trainable statistical moments such as mean, variance, skewness, and kurtosis. In contrast to vanilla random projections, which sample weights from a data-agnostic distribution, moment learning enables the model to learn a data-dependent distribution from which the weight values are drawn. Despite using far fewer trainable parameters, our moment learning method outperforms fully trainable Transformer encoders in non-stationary stochastic time series forecasting. Furthermore, Mixture-of-Moment-Experts (MoME) extends representational capacity without introducing a significant increase in trainable parameters. Our code and data are available at: https://github.com/jaemoomachine/MomentLearning.}
}
@article{FU2026115941,
title = {CORTS: A temporal scheduling framework for physical-cost-aware conflict resolution in multi-agent path finding},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115941},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115941},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006672},
author = {Bo Fu and Di Liu and Yi Quan and Xilin Zhao and Chaoshun Li and Haiyan Zhao},
keywords = {Multi-agent path finding, Temporal scheduling, Conflict resolution, Physical cost optimization, Iterative repair framework},
abstract = {Multi-Agent Path Finding (MAPF) aims to generate a set of conflict-free paths for multiple agents operating in a shared environment. It is a fundamental problem in artificial intelligence and robotic scheduling. Existing algorithms typically prioritize the minimization of time cost as the primary optimization objective. Although such approaches can yield favorable completion times, they often do so at the expense of increased physical costs, such as longer path lengths and higher turning frequencies, thereby resulting in elevated energy consumption. To address this limitation, we propose a novel scheduling-strategy-based MAPF framework, termed Conflict Resolution for Temporal Scheduling (CORTS), which shifts the focus of conflict resolution from spatial replanning to temporal coordination. The framework first independently generates a geometrically promising path for each agent, thereby constructing a promising path set. The algorithm then enters an iterative repair phase. In each iteration, it first performs pairwise matching of paths from the promising set. Subsequently, each path pair is examined to identify the earliest conflict along the temporal axis, and the globally earliest one among them is selected. This key conflict is then resolved by scheduling the traversal order of the two agents through the corresponding conflict segment. The iteration continues until all inter-agent conflicts are eliminated. Experimental results demonstrate that CORTS maintains high temporal efficiency while significantly reducing physical costs, including path length and the number of turns. It consistently outperforms other classical algorithms across a variety of standard benchmarks.}
}
@article{XU2026116002,
title = {DuSA: Dual-loop self-learning framework for autonomous driving with LLM-guided reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116002},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116002},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007288},
author = {Jinchang Xu and Sunan Zhang and Chen Sun and Jiawei Wang and Yang Xiao and Bingbing Li and Yulong Wang and Guodong Yin and Weichao Zhuang},
keywords = {Autonomous driving, Decision-making, Reinforcement learning, Large language models, Safety filtering},
abstract = {Current decision-making systems of autonomous driving struggle to balance safety, environmental adaptability, interpretability, and real-time performance in complex dynamic traffic environments. To overcome this issue, this study presents a dual-loop self-learning framework named DuSA. This approach integrates the advantages of rule-based constraints, reinforcement learning (RL), and large language models (LLMs) to construct a collaborative decision-making mechanism comprising an RL optimization loop and an LLM optimization loop. Specifically, the RL agent is responsible for learning efficient decision-making policies through interaction with the environment. Rather than directly participating in online decision-making, the LLM serves as a generation and iteration engine for safety filters, ensuring reliable, dynamic safety constraints for the decision-making process. Furthermore, by incorporating a policy distillation mechanism that combines imitation learning and reward reshaping, the knowledge from the safety filters is gradually internalized into the policy network. This mechanism significantly enhances policy convergence efficiency and decision-making quality while reducing reliance on external safety filters. Tests on highway and ramp merge scenarios show that DuSA achieves nearly 100% task success, enhances learning efficiency by 46.0%–49.3% relative to baselines, and maintains robust performance under high-density traffic. Moreover, the average decision-making time per step of this method is merely 0.03 s, fully satisfying the real-time requirements of online autonomous driving decision-making. The research results demonstrate that DuSA can effectively enhance the safety, environmental adaptability, reliability, and deployability of autonomous driving decision-making systems in complex traffic scenarios, thereby providing a novel technical pathway for constructing safe and trustworthy intelligent driving decision-making methods.}
}
@article{WANG2026116030,
title = {Template-Free Tracking Guidance for transformer trackers},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116030},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116030},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007562},
author = {Xuan Wang and Li Zhao and Dawei Zhang and Chengzhuan Yang and Jungang Lou and Yunliang Jiang and Jinli Cao and Zhonglong Zheng},
keywords = {Object tracking, Multi-modal tracking, Template-free, Generalization, Transformer trackers},
abstract = {Object tracking is an important task in computer vision, which continuously tracks the target in a video sequence based on the template provided in the initial frame. However, most existing trackers are often prone to overfitting of the target category, maintaining accurate tracking only on classes that appear in the training set, while performing poorly on unseen classes. Current research mainly relies on large-scale training datasets and more complex networks to improve tracking performance, but such approaches are limited in generalization. To tackle this issue, this paper proposes a novel approach called Template-Free Tracking Guidance (TFTG) for improving generic object tracking. To be specific, we design a dual-branch learning paradigm for training trackers, which contains template-based and template-free branches. The template-based branch follows the standard one-stream transformer tracking pipeline, while the template-free branch serves as guidance to emphasize the gradient contribution from the template features, thereby enhancing the effective utilization of target template information for tracking. Benefiting from the automatic adjustment of the gradients during back-propagation, our method consistently improves the performance of trackers, particularly on unknown categories, without altering the internal structure of the model and reducing the inference speed. We further validate its effectiveness and generalization through extensive experiments on several specific transformer trackers and multiple downstream multi-modal tracking tasks. The code is available here.}
}
@article{WANG2026116022,
title = {DTFNet: A dual-modal time–frequency fusion network for non-stationary time series modeling},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116022},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116022},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007483},
author = {Caixia Wang and Fan Zhang and Xiaofeng Zhang and Hua Wang},
keywords = {Non-stationary time series forecasting, Time–frequency domain fusion, Wavelet attention mechanism, Robust loss function},
abstract = {The central challenge in forecasting non-stationary multivariate time series is the integration of cross-dimensional coupling with time-varying dynamic features. This paper introduces DTFNet, a dual-modal time–frequency fusion network, which incorporates three synergistically designed modules: (1) To address frequency-domain heterogeneity and cross-dimensional coupling, we propose a Wavelet-Domain Frequency-Band Decoupled Multi-Head Attention (WFD-MHA) mechanism. Using a Discrete Wavelet Transform (DWT), the input sequence is decomposed into multiple frequency-band components. Within each frequency band, a Band-Specific Multi-Head Attention (BS-MHA) module captures global inter-variable correlations, whereas a Cross-Band Multi-Head Attention (CB-MHA) module explicitly models nonlinear inter-band interactions. This design enhances the representation of frequency-domain coupling features and effectively captures long-term periodic patterns. (2) To address the multi-scale modeling of time-varying dynamic features, we introduce the Dynamic Dilated Depthwise Separable Convolution (D3SConv) architecture. This architecture first divides the input sequence into overlapping time patches. Within each patch, parallel multi-dilation-rate depthwise convolutions are performed to extract local multi-scale features, followed by fusion of multi-scale information through learnable weights. Lastly, pointwise convolution models cross-patch dependencies. (3) To handle abnormal interference in non-stationary sequences, we propose a δ-parameterized Huber loss function that dynamically adjusts the curvature of the loss, effectively mitigating the impact of outliers while maintaining the prediction accuracy for normal samples. Experimental results demonstrate that DTFNet, through the synergistic complementarity of time–frequency dual-modal representations, significantly outperforms existing methods across multiple benchmark datasets, exhibiting superior generalization and robust prediction capabilities.}
}
@article{JIAO2026115998,
title = {Large-kernel spatially parallel feature fusion for monocular 3D perception in autonomous driving},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115998},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115998},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007240},
author = {Ruanzhi Jiao and Jinlai Zhang and Chang Li and Lin Hu},
keywords = {Autonomous driving, Shallow network, Receptive field, Depth prediction, Shuffling mechanism},
abstract = {Monocular 3D perception is a fundamental component of autonomous driving systems; however, existing approaches predominantly rely on localized visual feature extraction and often lack effective modeling of global geometric context and long-range spatial dependencies. To address this limitation, we propose MonoLSPF, a large-kernel spatially parallel feature fusion framework that constructs heterogeneous receptive fields to jointly capture fine-grained local structures and broad spatial context. Specifically, the proposed Large-kernel Spatial Parallel Feature Fusion (LSPF) module leverages depthwise separable large-kernel convolutions to aggregate long-range spatial information, while a parallel small-kernel branch preserves detailed local cues. Furthermore, a Nested Orthogonal Multi-scale Shuffle (NOMS) module is introduced, which adopts a dual-branch feature pyramid with channel shuffling to enhance cross-group feature interaction and mitigate information isolation caused by grouped convolutions. Extensive experiments on the KITTI, nuScenes, and Waymo benchmarks demonstrate that MonoLSPF consistently outperforms state-of-the-art monocular methods, particularly on the Car and Cyclist categories, achieving 19.51% AP3D under the moderate setting on KITTI, which validates its effectiveness for robust monocular 3D perception in autonomous driving scenarios.}
}
@article{CHANG2026115990,
title = {Scale-aware weighting adversarial partial domain adaptation with entropy-minimized ambiguity for rolling bearings fault diagnosis},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115990},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115990},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007161},
author = {Qi Chang and Congcong Fang and Wei Zhou and Xianghui Meng},
keywords = {Rolling bearing fault diagnosis, Partial-set domain adaptation, Domain adversarial neural network, Scale-aware weighting, Entropy-minimized ambiguity},
abstract = {Domain adaptation (DA) techniques have proven effective in cross-domain fault diagnosis; however, their success often relies on the closed-set domain adaptation (CDA) assumption, which is seldom applicable in industrial environments. In the era of industrial big data, there is a growing need to transfer deep learning (DL) models from well-established, large-scale domains to smaller, less familiar ones. To address this challenge, this study introduces a more practical partial-set domain adaptation (PDA) approach called the scale-aware weighting and entropy-minimized ambiguity adversarial domain adaptation (SEADA) network. SEADA incorporates a scale-aware weighting mechanism to assess data reliability across multiple scales, mitigating the adverse effects of outlier classes and improving the model's transferability. Additionally, by employing entropy-minimized ambiguity strategy, SEADA reduces uncertainty in domain instances, enhances inter-class separability, and improves model robustness. The proposed SEADA enables efficient transfer by aligning feature distributions within the shared label space while mitigating the negative influence of outlier classes and ambiguous information during diagnostic transfer. Experimental results demonstrate that the SEADA significantly outperforms state-of-the-art methods in partial transfer within identical machines (PTIM) and across different machines (PTDM), underscoring its effectiveness in addressing mechanical system challenges.}
}
@article{LI2026115982,
title = {DHEM-FND: Dual-layer heterogeneous expert network and dynamic memory augmentation for multi-domain fake news detection},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115982},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115982},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007082},
author = {Hongxuan Li and Hongchen Wu and Xiaochang Fang and Hongzhu Yu and Bing Yu and Meng Li and Zhaorong Jing and Huaxiang Zhang and Yongyu Feng},
keywords = {Multi-domain fake news detection, Dual-layer heterogeneous expert, Dynamic memory augmentation, Decoupled domain-specific features, Heterogeneous semantics},
abstract = {Fake news detection is a critical challenge in the digital age, as the fabricated content rapidly undermines public trust across diverse domains. Existing methods rely on domain-agnostic feature extractors, which struggle to decouple heterogeneous features and suffer from semantic entanglement, reducing cross-domain generalization. Moreover, static architectures with fixed knowledge representations cannot adapt to evolving misinformation patterns during events such as public health crises and political upheavals. Conventional multi-domain frameworks also incur high computational costs because of redundant parameter scaling, hindering near real-time deployment. To address these issues, herein, we propose a Dual-layer Heterogeneous Expert network and dynamic Memory augmentation for multi-domain Fake News Detection (DHEM-FND). First, a heterogeneous expert network disentangles domain-specific semantics through three pathways: (i) a multiscale convolutional neural network capturing local–global patterns, (ii) emotion-aware multilayer perceptron detecting sentiment–context discrepancies, (iii) and self-attention module with statistical priors identifying stylistic fingerprints. Orthogonal constraints minimize feature leakage across domains. Second, a dynamic memory augmentation mechanism tracks evolving fake news tactics by maintaining hierarchical domain prototypes, incrementally updated using attention-based alignment. Third, sparse gating and parameter reuse strategies optimize efficiency by activating only the top-k relevant experts during inference while freezing 75% of backbone parameters. We validated the DHEM model using four real-world datasets: Twitter15, Twitter16, Weibo21, and FineFake. We achieved an average detection accuracy of 92.57%, while reducing cross-domain interference by 41.2%, improving detection speed by 17.2%. Thus, the superior performance of the proposed method in dealing with evolving fake news and scalability is demonstrated.}
}
@article{LU2026115945,
title = {Personalized federated learning on quantile regression for heterogeneous missing data},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115945},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115945},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006714},
author = {Yi Lu and Zhiwei Nie and Chen Liu and Xuejun Ma},
keywords = {Quantile regression, Personalized federated learning, Quadratic interpolation, Heterogeneity, Missing data},
abstract = {To address the challenges of data heterogeneity and missingness, we propose a novel personalized federated learning quantile regression (PFLQR) method that is robust and captures the conditional quantiles of the response variable. In PFLQR, the model weights are learned collaboratively by minimizing a quadratic interpolation quantile loss with a sparse fusion penalty. Furthermore, we extend the approach to the missing-data setting by developing PFLQR-SA, which employs a simultaneous inverse probability weighting (IPW) scheme. We establish that the model weights of PFLQR and PFLQR-SA converge at rates of O1/rpP and O1/rpP2, respectively. The performance of both methods is evaluated through extensive simulation studies and real-data analyses. The results demonstrate that PFLQR offers superior generalization under data heterogeneity, whereas PFLQR-SA excels in handling heterogeneous missing data.}
}
@article{BORNO2026115948,
title = {Decentralized LoRA augmented transformer with multi-scale feature learning for secured eye diagnosis},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115948},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115948},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600674X},
author = {Md. Naimur Asif Borno and Md Sakib Hossain Shovon and MD Hanif Sikder and Iffat Firozy Rimi and Tahani Jaser Alahmadi and Mohammad Ali Moni},
keywords = {Federated learning, DeiT, LoRA, Multiscale patch embedding, Eye disease},
abstract = {Accurate and privacy-preserving diagnosis of ophthalmic diseases remains a critical challenge in medical imaging, particularly given the limitations of existing deep learning models in handling data imbalance, data privacy concerns, spatial feature diversity, and clinical interpretability. This paper proposes a novel Data-efficient Image Transformer (DeiT)-based framework that integrates multiscale patch embedding, Low-Rank Adaptation (LoRA), knowledge distillation, and federated learning to address these challenges in a unified manner. The proposed model effectively captures both local and global retinal features by leveraging multi-scale patch representations with local and global attention mechanisms. LoRA integration enhances computational efficiency by reducing the number of trainable parameters, while federated learning ensures secure, decentralized training without compromising data privacy. A knowledge distillation strategy further improves generalization in data-scarce settings. Comprehensive evaluations on two benchmark datasets OCTDL and the Eye Disease Image Dataset demonstrate that the proposed framework consistently outperforms both traditional CNNs and state-of-the-art transformer architectures across key metrics, including AUC, F1 score, and precision. Furthermore, Grad-CAM＋＋visualizations provide interpretable insights into model predictions, supporting clinical trust. This work establishes a strong foundation for scalable, secure, and explainable AI applications in ophthalmic diagnostics.}
}
@article{KONG2026115937,
title = {Quantum Fourier Transform Neural Network with image blockwise representation for image classification},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115937},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115937},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006635},
author = {Desheng Kong and Kangning An and Kairan Zhang and Mingyang Yu and Yulong Fu and Wei Wang and Jing Xu and Donglin Wang},
keywords = {Frequency-domain filtering, Image classification, Noisy intermediate-scale quantum, Quantum Fourier transform, Quantum machine learning},
abstract = {We present a Quantum Fourier Transform Neural Network (QFTNN) for image classification under noisy intermediate-scale quantum (NISQ) constraints. QFTNN combines blockwise amplitude encoding, trainable spectral filtering via QFT, inverse Fourier reconstruction, and a globally entangled variational readout circuit. Three formal results characterize the spectral pipeline: circulant convolution equivalence, spectral energy preservation, and frequency-decoupled gradient expressibility. We also implement a hybrid counterpart (HybridQFTNN) and evaluate both models with ablation studies, depth sensitivity tests, noise-robustness experiments, and a frequency-domain stress-test suite under a reproducible simulation benchmark. In a five-seed confirmatory study, HybridQFTNN achieves 95.09±0.22% on MNIST versus 94.60±0.35% for the matched classical baseline (p=0.0156, Cohen’s d=1.805), while the Fashion-MNIST difference is not significant (p=0.953). QFTNN reaches 91.65±0.35% on MNIST ten-class classification with only 6058 parameters. Under high-pass frequency perturbation, the hybrid model gains +13.81 percentage points over the classical baseline on MNIST 4vs9, supporting the spectral filtering mechanism. Real-hardware verification on OriginQ QCloud further shows that the QFT filtering pipeline can be executed on two superconducting QPUs (72-qubit and WK_C180) with quantifiable fidelity, while channel-noise experiments show that the trained classifier maintains ≥ 97% accuracy under amplitude damping and phase damping up to p=0.1. Overall, QFT-based filtering is most useful in frequency-structured regimes rather than as a universal replacement for classical models.}
}
@article{AZZAM2026116034,
title = {Agentic LLM for anonymizing healthcare data with contextual awareness},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116034},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116034},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007604},
author = {Rana Azzam and Ahmad Musamih and Senay Gebreab and Khaled Salah and Mohammed Omar},
keywords = {Agentic AI, Large language models (LLMs), Anonymization, Healthcare data, Privacy},
abstract = {Large language models (LLMs) are transforming healthcare applications by enhancing data analysis, yet their adoption remains constrained by stringent privacy requirements that limit access to sensitive medical data. Anonymization offers a pathway to address this challenge; however, existing techniques often lack contextual understanding and exhibit low accuracy, compromising either patient privacy or the utility of clinical content. In this paper, we propose an end-to-end, modular agentic LLM system for processing sensitive healthcare data with contextual awareness. The system is orchestrated by a central agent coordinating specialized components for structured data retrieval, clinical narrative generation, anonymization, public LLM querying, and secure deanonymization. Locally hosted LLMs handle all privacy-sensitive steps, including context generation and anonymization, while public LLMs are used exclusively for reasoning on pre-anonymized inputs. We evaluate our system on a synthetic clinical dataset and benchmark it against five state-of-the-art named entity recognition (NER) techniques. Our approach achieves high precision and a recall of 93.6%, significantly outperforming baselines such as spaCy (33% precision, 89% recall) and Presidio (41% precision, 90% recall). Additional evaluation on real-world clinical notes from the MIMIC-III dataset demonstrates strong generalization to unstructured narratives, achieving a clean transformation rate of 98.6%. We further evaluate medical richness, showing that anonymized outputs retain clinically relevant information and semantic structure, preserving downstream utility. Adversarial re-identification experiments confirm that no true identifiers can be reconstructed, highlighting the framework’s effectiveness in balancing privacy, robustness, and clinical usefulness.}
}
@article{YUE2026116050,
title = {Evidential uncertainty-aware and dual-view prediction fusion for semi-supervised medical image segmentation},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116050},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116050},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007768},
author = {Hao Yue and Xinwang He and Sibo Qiao and Shuqiang Wang and Zhiyuan Zhao},
keywords = {Semi-supervised segmentation, Uncertainty estimation, Evidential deep learning, Evidential prototype learning},
abstract = {Semi-supervised learning (SSL) has effectively alleviated annotation dependency. However, existing methods face two major challenges: poor pseudo-label quality and incomplete uncertainty assessment. They rely on a single prediction branch for pseudo-label generation, which fails to integrate complementary multi-view information. Their uncertainty is also measured solely by Shannon entropy, which cannot differentiate between a model’s knowledge deficiency (epistemic uncertainty) and inherent data ambiguity (aleatoric uncertainty), thereby severely limiting performance. To address these key issues, we propose a novel evidential uncertainty-aware and dual-view prediction fusion (EU-DPF) framework. The core idea is to significantly improve pseudo-label accuracy and robustness by efficiently fusing predictions from different classifiers. To this end, we first introduce evidential deep learning, combining Shannon entropy with an evidential uncertainty measure to more accurately filter pseudo-labels. We also design an evidential prototype classifier that provides a complementary view to the linear classifier. Finally, an improved evidential fusion rule efficiently integrates the dual-view outputs of these two classifiers, generating high-quality pseudo-labels. We conducted extensive validation on four benchmark datasets (LA, Pancreas-CT, ACDC and Prostate). The results show that our method significantly outperforms state-of-the-art approaches and achieves superior performance on multiple metrics. Furthermore, our approach achieves performance comparable to fully supervised training even with limited labeled data, highlighting its effective utilization of unlabeled data.}
}
@article{LI2026115974,
title = {PFedRobust: A personalized federated learning framework toward robustness against data poisoning attacks in IoT},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115974},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115974},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007008},
author = {Chunmei Li and Tao Li and Andrea Bracciali and Yilei Wang and Hongwei Zhou and Daojing He and Zhiquan Liu},
keywords = {Robustness, Data poisoning attacks, Personalized Federated Learning (PFL), Earth Mover’s Distance (EMD)},
abstract = {Poisoned models are difficult to be detected due to the property of not Independent and Identically Distributed (non-IID) datasets, such as datasets of edge devices, mobile devices, etc. in the Internet of Things (IoT) in Personalized Federated Learning (PFL). Generally, all local models are pre-aggregated as a Pre-aggregated Poisoned Global Model (PPGM) and then local models with high similarities with PPGM are detected as poisoned models. However, the high False Negative Rate (FNR) of poisoned models results in low model accuracy (MA) once the poisoned models are reported as benign ones and aggregated into the global model. In this paper, we propose PFedRobust, a fine-grained PFL framework, where models are trained and aggregated in terms of the classes instead of clients. Specifically, each client divides its non-IID dataset into multiple IID class-based datasets in terms of classes. Then a novel Local Class Model (LCM), a binary classifier, is constructed on each class-based dataset. The LCMs of the same class, for different clients, are little variation since their corresponding class-based datasets are IID. Finally, the server calculates the similarity between each LCM and the Pre-computed Poisoned Global Class Model (PPGCM) using Earth Mover’s Distance (EMD). LCMs with high similarities are regarded as Malicious Class Models (MCMs), which are excluded from the real aggregation process. Extensive experiments indicate that PFedRobust performs well in both FNR and MA. That is, excellent performance in MCMs detection and robustness.}
}
@article{LI2026116026,
title = {Self-organizing cascaded echo state network for time series prediction},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116026},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116026},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007525},
author = {Xingshang Li and Fanjun Li and Qianwen Liu and Shoujing Zheng},
keywords = {Echo state network, Time series prediction, Self-organizing, Cascade structure, Residual learning},
abstract = {As a special recurrent neural network, the echo state network (ESN) is commonly used as a prediction model for time series. However, many studies have shown that the original ESN performs worse than deep ESNs in capturing potential dynamic features in complex time series. Thus, based on the idea of gradually approaching, a self-organizing cascaded echo state network (SCESN) is proposed to address this problem. First, a deep structure with self-organizing depth is designed to gradually approach the target outputs by adding ESN modules one by one in a cascade fashion. Then, a novel residual learning framework combined with the PSO algorithm is developed, with which each cascaded ESN module is pre-trained to extract different feature information of the target outputs. Furthermore, the convergence analysis of the SCESN is given in theory. Finally, the experimental results on benchmark data sets of time series prediction show the better prediction performance of the proposed SCESN compared with some existing deep ESNs.}
}
@article{LIU2026115898,
title = {LightGAD: Lightweight and effective framework for graph anomaly detection},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115898},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115898},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006246},
author = {Xudong Liu and Yanan Ren and Bin Yang and Zhaonian Zou},
keywords = {Graph anomaly detection, Gradient boosted decision tree, Graph homophily, Memory efficiency},
abstract = {Graph anomaly detection (GAD) has attracted a lot of research attention in recent years. Although existing GAD methods are primarily based on graph neural networks (GNNs), we revisit the suitability of GNNs for GAD and argue that gradient boosted decision trees (GBDTs) offer distinct advantages to GAD, including efficiency, interpretability, and effectiveness. Based on this, we propose LightGAD, a lightweight GAD framework that combines an adaptive message passing mechanism with GBDT for node classification. To mitigate the influence of camouflage behaviors, the adaptive message passing mechanism adjusts the behavior in passing and aggregating node features according to the homophily of the graph. Moreover, based on a comprehensive comparison among different types of classifiers, GBDT is shown to be suitable for classifying anomalous nodes. Furthermore, to support GAD in resource-constrained environments, we further reduce the resource requirement of LightGAD and design a memory-efficient variant called LightGAD+. LightGAD+ trains the GAD model based on a sequence of subgraphs that are smaller than the whole graph. Moreover, feature selection can be applied to further reduce the dimensionality of node feature. The experiments on real anomaly detection benchmarks verify that LightGAD consistently outperforms existing state-of-the-art baselines in both accuracy and efficiency, and LightGAD+ is effective in scenarios where resources are limited.}
}
@article{DHINGRA2026116011,
title = {Index tracking in financial markets: A comprehensive review of optimization, statistical, and data-driven modeling approaches},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116011},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116011},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007379},
author = {Vrinda Dhingra and Amita Sharma and Anubha Goel},
keywords = {Index tracking, Tracking error minimization, Tracking portfolio, Cardinality constraints, Machine learning, Deep learning},
abstract = {Index tracking, also known as passive investing, has gained significant traction in financial markets due to its cost-effective and efficient approach to replicating the performance of a specific market index. This review paper provides a comprehensive overview of the various modeling approaches and strategies developed for index tracking, highlighting the strengths and limitations of each approach. We categorize the index tracking models into three broad frameworks: Mathematical programming and decision-analytic models, statistical and econometric models and machine-learning & data-driven models. A comprehensive empirical study conducted on the S&P 500 dataset demonstrates that the tracking error volatility model under the mathematical programming and decision-analytic framework delivers the most precise index tracking, the convex co-integration model, under the statistical and econometric framework achieves the strongest return–risk balance, and the deep neural network with fixed noise model within the machine learning and data-driven framework provides a competitive performance with notably low turnover and high computational efficiency. By combining a critical review of the existing literature with comparative empirical analysis, this paper aims to provide insights into the evolving landscape of index tracking and its practical implications for investors and fund managers.}
}
@article{NAKIP2026115995,
title = {A predictive neural network architecture for early detection of low-rate cyberattacks},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115995},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115995},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007215},
author = {Mert Nakıp},
keywords = {Quality of Service, Prediction, Trend Predictive Neural Network (rTPNN), Internet of Things (IoT), Low-Rate Denial of Service (LDoS)},
abstract = {Low-Rate Denial of Service (LDoS) attacks pose a significant challenge to IoT networks due to their subtle and prolonged nature, often evading traditional intrusion detection systems. This paper presents IDQS (Intrusion Detection via QoS Prediction), a lightweight and proactive framework for early LDoS attack detection. IDQS integrates two new key components: (i) RTP-QoS, a Recurrent Trend Predictive Neural Network that learns and forecasts future Quality of Service (QoS) based on historical traffic patterns, and (ii) PDM, a Pairwise Decision Model that evaluates discrepancies between predicted and actual QoS to identify potential attacks. Evaluated on the public SDN-SlowRate-DDoS and CIC-IDS2017 datasets, IDQS respectively achieves over 79% and 91% detection accuracy across most attack scenarios with high recall and low false negatives, while maintaining an end-to-end inference time of just 0.28 s. The results demonstrate the effectiveness and efficiency of IDQS for real-time deployment in resource-constrained IoT environments.}
}
@article{QIN2026115890,
title = {BLADE: Brainstorming LLMs as algorithm designer through evolution for online subset selection},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115890},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115890},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006167},
author = {Zining Qin and Chenhao Wang and Jianxiong Guo and Huiling Qin and Ping Shen and Weijia Jia},
keywords = {Large language models, Evolutionary algorithm, Heuristic search, Program synthesis, Online subset selection},
abstract = {Online subset selection problems are central to combinatorial optimization. Traditional online algorithms are typically designed for specific problem settings, adapting them to new instances often requires substantial manual redesign. To discover heuristics effective across diverse problem configurations, we present BLADE for online subset selection problems, a novel multi-agent brainstorming framework that leverages large language models (LLMs) as heuristic algorithm designers. BLADE coordinates multiple LLMs to propose diverse heuristic algorithms, which are iteratively improved through an island-based evolutionary system and problem-specific evaluators. The framework incorporates targeted reset mechanisms within the island model to ensure continuous exploration of the search space, and it uses a KL divergence-based sampling strategy for selecting candidate algorithms from the algorithm population during the evolutionary process. Extensive experiments demonstrate that BLADE not only discovers novel algorithms that outperform standard benchmarks and the latest state-of-the-art methods, but also adapts effectively across online optimization problems.}
}
@article{LI2026116039,
title = {Unlocking the power of vision foundation models via multi-expert collaboration for cross-domain few-shot segmentation},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116039},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116039},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007653},
author = {Yuxin Li and Zihao Zhu and Yifan Chen and Zhibin Yu},
keywords = {Cross-domain, Few-shot, Semantic segmentation, Vision foundation models, Multi-expert collaboration},
abstract = {Although cross-domain few-shot segmentation (CD-FSS) has achieved promising results in segmenting novel classes across domains with limited samples, most existing approaches predominantly focus on enhancing domain adaptability through simple backbone architectures. Few studies have explored the potential of using vision foundation models (VFMs), which present a compelling solution for cross-domain tasks owing to their exceptional generalization capabilities. Nevertheless, we find that directly applying VFMs (e.g., DINOv2) to CD-FSS still faces three major challenges: (1) direct fine-tuning risks compromising the model’s inherent representation capacity; (2) features at different stages demonstrate distinct functional characteristics, requiring careful utilization strategies; (3) the attention region may shift. To this end, we propose three innovative solutions. First, we freeze the VFM and introduce dual adaptation modules at the image and frequency levels to effectively enhance prototype matching and cross-domain adaptability. Second, our multi-expert collaborative optimization strategy leverages the complementary advantages of multi-stage features through parallel prediction branches and a learnable domain-specific fusion strategy, effectively solving the hierarchical feature optimization imbalance problem during source domain training. Finally, we propose the text-guided prompt correction module, which employs text embeddings to refine visual features and improve their focus on target regions. Extensive experiments show that our method significantly outperforms state-of-the-art CD-FSS methods.}
}
@article{LI2026115987,
title = {VTGCN: Graph-based structural representation learning for visual-tactile multimodal fusion},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115987},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115987},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007136},
author = {Liang Li and Guochu Chen and Manliang Cao and Baojiang Li and Haiyan Wang and Bin Wang and Zizhen Yi},
keywords = {Graph convolutional network (GCN), Visual-tactile fusion, Multimodal object recognition, Cross-modal learning, Heterogeneous data integration},
abstract = {The fusion of visual and tactile information is essential for enhancing robotic perception, object recognition, and interaction in unstructured environments. However, existing methods often fail to fully leverage the complementary strengths of visual and tactile modalities due to significant heterogeneity and spatial misalignment. This paper proposes a novel framework called Visual-Tactile Graph Convolutional Network (VTGCN), which is based on Graph Convolutional Networks (GCNs) and facilitates effective multimodal fusion through graph-structured representation learning. Specifically, modality-specific subgraphs are constructed by extracting keypoint-based visual nodes using ORB and CNNs, and grid-structured tactile nodes through convolutional feature mapping and spatial partitioning. Intra-modal edges are formed via K-Nearest Neighbors (KNN) for vision and local grid adjacency for touch. To bridge the modality gap, an adaptive cross-modal edge construction strategy is introduced, which dynamically selects inter-modal connections based on feature similarity. The resulting fusion graph supports end-to-end representation learning using stacked GCN layers, enabling accurate and robust recognition in both simulated and real-world scenarios. Experiments on five visual-tactile datasets—including Touch and Go, ObjectFolder 2.0, ObjectFolder Real, MSDO, and a self-collected VTDaily dataset—demonstrate that VTGCN achieves an accuracy of up to 99.59%, outperforming existing CNN and Transformer-based models. The proposed approach effectively models structural heterogeneity and deep inter-modal dependencies, providing a scalable solution for visual-tactile fusion. VTGCN shows promising potential in robotic grasping, human-computer interaction, and augmented reality applications, where precise perception and adaptive multimodal integration are critical.}
}
@article{WANG2026116007,
title = {Risk-aware orthogonal disentanglement for camouflage-resilient fraud detection},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116007},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116007},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007331},
author = {Yibei Wang and Bin Wen and Xi Li},
keywords = {Fraud detection, Graph neural networks, Disentangled representation, Semi-supervised learning, Heterophily},
abstract = {Graph neural networks (GNNs) have shown strong potential for graph-based fraud detection, but their effectiveness is often limited by two closely intertwined challenges: scarce labeled data and adversarial camouflage. Sparse supervision makes it difficult to learn reliable fraud patterns, while camouflage further obscures the already limited fraud evidence by mixing it with benign neighborhood signals. We propose Projected and Orthogonal Disentanglement (PROD), a semi-supervised framework that tackles both challenges jointly through risk-aware encoding and projection-based disentanglement. PROD propagates label-derived risk signals to enrich node representations, then projects the risk-enhanced embeddings into semantic subspaces capturing fraud-relevant homophily and camouflage-induced heterophily; an orthogonality regularizer further suppresses cross-subspace interference to improve semantic separation. Experiments on three real-world benchmarks, including a large-scale financial transaction network, show that PROD outperforms all baselines under standard evaluation settings. On the largest benchmark, PROD improves Average Precision by up to 17.8% relative over the strongest risk-aware baseline, with gains holding under both low-label and high-camouflage conditions.}
}
@article{PENG2026116031,
title = {Causal inference-based knowledge graph completion using multi-head attention for fault diagnosis},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116031},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116031},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007574},
author = {Honglei Peng and Liya Yao and Shichen Yang and Zizhao Zhang and Jiancheng Shi and Xu Liao and Hui Xiong},
keywords = {Causal adjustment, Causal inference, Fault diagnosis, Knowledge graph completion, Multi-head attention},
abstract = {Knowledge graphs (KGs) play a pivotal role in organizing complex industrial data. KGs provide structured knowledge support for intelligent fault diagnosis. However, their effectiveness is often hindered by inherent data incompleteness and the scarcity of high-quality supervision signals. Existing KG completion (KGC) approaches, although effective in many general domains, are prone to “fault principle bias” and “attention bias” when used for fault diagnosis. They learn spurious correlations rather than true causal mechanisms. In this article, a new framework termed the causal KGC network with multi-head attention (CKGCNA) is proposed to address these challenges. First, a comprehensive fault diagnosis KG is constructed to characterize the relationships between fault symptoms, causes, and components. Second, a causal inference-based completion model is developed. This adds both a multi-head self-attention mechanism that captures global structural information and an expectation module that performs front- and back-door causal adjustments. This dual-adjustment mechanism effectively mitigates the confounding effects of spurious correlations. Finally, the proposed method is used to analyze real-world, automotive fault diagnosis data. The results show that the proposed method significantly outperforms various state-of-the-art baselines in terms of link prediction tasks, confirming its superior ability to capture latent causal relationships and improve the completeness of fault knowledge bases.}
}
@article{XING2026115999,
title = {Clustering structure identification with ordering graph},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115999},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115999},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007252},
author = {Zheng Xing and Weibing Zhao},
keywords = {Graph-based clustering, Similarity matrix, Similarity matrix ordering, Block-diagonal structure, Similarity matrix partition},
abstract = {Graph-based clustering methods have been extensively studied over the past few decades; however, their performance remains suboptimal, necessitating further research. In this paper, we focus on fully connected graphs and identify clustering structures by analyzing the similarity matrix (edge weight matrix). Our key idea is to permute the similarity matrix to reveal diagonal blocks corresponding to clusters. Thus, the primary challenge is to permute the similarity matrix into a block-diagonal form and identify the diagonal blocks. To address this, we introduce a similarity matrix ordering algorithm for cluster analysis, which generates an augmented similarity matrix reflecting the structure of density-based ordered clusters without explicitly producing a clustering of the dataset. Additionally, we propose a similarity matrix partition method that learns the block-diagonal structure and groups the data accordingly. If clusters are completely separated, our partition algorithm can theoretically converge to the optimal cluster partition. We evaluate our method on four synthetic datasets and five real-world datasets. Experimental results demonstrate that the proposed approach consistently outperforms state-of-the-art techniques on all datasets, offering up to a 10% improvement over the second-best baseline in real-world scenarios.}
}
@article{XU2026115910,
title = {Online knowledge distillation optimization based on Multi-Student model Multi-Task collaborative learning},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115910},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115910},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006362},
author = {Shibiao Xu and Shanshan Mo and Zherui Zhang and Changwei Wang and Wenhao Xu and Hetong Wang and Rongtao Xu and Li Guo},
keywords = {Online knowledge distillation, Auxiliary tasks, Collaborative processing module},
abstract = {Current Online Knowledge Distillation (OKD) methods primarily employ adversarial learning strategies to facilitate mutual learning of intermediate features among student networks. However, these methods still face two major challenges: first, in scenarios where multiple student networks serve as mutual teachers, poor performance of one student can easily lead to mutual collapse of the learning pattern; second, individual student networks suffer from limited representational capacity and insufficient feature richness. In this work, we propose a novel optimization framework named Multi-Student Model Multi-Task Collaborative Learning (MTCL). By assigning distinct auxiliary tasks to each student, MTCL guides them to construct representation spaces with varying properties. This differentiated learning strategy effectively improves the feature diversity and generalization capability of the networks. Furthermore, to effectively integrate the unique strengths established by each student, we innovatively introduce a Collaborative Processing Module (CPM) in the online teacher construction. Through its feature integration mechanism, the CPM captures and fuses complementary features learned via respective auxiliary tasks, achieving bidirectional knowledge diffusion. This approach not only avoids representation conflict but also promotes mutual benefits between students. To verify the effectiveness of the proposed method, we conducted extensive evaluations on CIFAR-100, TinyImageNet, and ImageNet-100. Experimental results demonstrate that MTCL significantly outperforms existing OKD methods across various model combinations. Notably, on TinyImageNet using ResNet-18, our method achieves a 5.4% accuracy improvement compared to the state-of-the-art Deep Cross-layer Collaborative Learning (DCCL), which further expands to 11.19% with ResNet-34. Moreover, experiments on CIFAR-100-C verify the superior robustness of our method against domain shifts. The code is available at https://github.com/Coralmss/MTCL.}
}
@article{ZHANG2026116023,
title = {GeoOne: Unifying structural and semantic control in diffusion models via temporal decoupling},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116023},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116023},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007495},
author = {Wenzheng Zhang and Zhanlong Chen and Mengxi Zhang and Chenxing Sun and Run Wang and Junli Zhao},
keywords = {Geospatial imagery, Generative foundation model, Diffusion models, Zero-shot learning, Multimodality},
abstract = {Achieving precise unification of structural constraints and semantic attributes is a critical challenge in generative foundation models. Despite progress, unified capabilities in vertical domains such as the geospatial field remain stagnant owing to data scarcity and modality barriers. Current datasets lack modality diversity, often limited to RGB and near-infrared (NIR), while existing models struggle with static condition bottlenecks. To address these challenges, we present two contributions: the GeoStructOmni dataset and the GeoOne foundation model. GeoStructOmni is a comprehensive benchmark integrating five distinct modalities (Tile Map, RGB, NIR, SAR, and DEM) to bridge the data gap. Building upon this, we propose GeoOne for universal geospatial understanding. GeoOne incorporates a novel Temporal Semantic Decoupling (TSD) mechanism, leveraging a Temporal Semantic Gate (TSG) and Dynamic Information Bottleneck (IB) to dynamically modulate text conditions, ensuring precise semantic alignment. GeoOne excels in zero-shot image captioning and text-to-image generation, demonstrating robust generalizability across diverse tasks ranging from controllable synthesis to semantic analysis, surpassing models restricted to single-task specialization. Extensive experiments demonstrate that GeoOne outperforms previous models with substantial improvements of ＋0.546 in CIDEr and ＋8.25 in CLIP Score. This validates the feasibility of the “one-model-for-all” paradigm in tackling complex multi-modal generative tasks.}
}
@article{V2026115991,
title = {Advanced success-driven lightweight deep learning network with data augmentation for detecting offensive text on unstructured social media data},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115991},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115991},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007173},
author = {Mounica V and A. Krishna Mohan},
keywords = {Offensive text, Memes, YOLOv8, Lightweight pyramid feed perceptron, Success-based optimization},
abstract = {The rapid growth of social media platforms has intensified the spread of offensive and hateful content in the form of memes that combine visual and textual information. Detecting such multimodal offensive content remains challenging due to noisy user generated data, class imbalance and complex cross-modal interactions. This paper proposes an optimization driven lightweight deep learning framework termed ILwYOLOv8Net for offensive text detection in hateful memes. The framework integrates an improved YOLOv8 backbone for efficient visual feature extraction, a lightweight pyramid feed perception for hierarchical multimodal feature modelling and an adaptive success based optimization algorithm (AdSOA) for automated hyperparameter tuning. To mitigate class imbalance, conditional upgraded SMOTE is applied in the fused multimodal embedding space. Experimental evaluation on the Facebook Hateful Memes dataset demonstrates that the proposed model achieves high detection accuracy while maintaining low computational complexity and fast inference. Comprehensive analysis using cross-validation, probabilistic metrics and ablation study confirms the robustness and efficiency of the proposed approach, which makes it suitable for large-scale and real-time social media moderation applications.}
}
@article{FAN2026115965,
title = {Fused multi-predictor mechanism in reversible data hiding},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115965},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115965},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600691X},
author = {Guojun Fan and Chen Zuo and Shuai Ren and Lei Lu and Zhihai Yang and Juan Zhao and Zhibin Pan},
keywords = {Reversible data hiding, Multi-predictor mechanism, Multiple histogram modification, Differential evolution},
abstract = {Multi-predictor mechanism (MPM) is a powerful approach for reversible data hiding (RDH) application. It combines multiple pixel predictors to select the most accurate prediction value, achieving higher stego-image fidelity compared to using these predictors individually. However, MPM has to skip part of pixel prediction and embedding to guarantee reversibility, which inherently constrains its embedding capacity. In this paper, motivated by the strong complementarity between the rhombus predictor and diagonal predictor, we propose an extended MPM that replaces the skipping operation with a highly effective prediction and embedding operation, providing pure embedding capacity gain. We then utilize a multiple histogram scheme to fuse the original and extended MPM, resulting in better fidelity than the former while maintaining the high embedding capacity of the latter. Additionally, differential evolution algorithm is integrated to speed up the optimization of the embedding parameters. Experimental results show the superior performance of our fused MPM over state-of-the-art RDH methods, particularly in terms of embedding capacity.}
}
@article{CHAUDHARI2026115970,
title = {Enhanced Facial Expression Recognition Using Deep Learning: A Generalizable Frameworkwith Potential for Cognitive Impairment Monitoring},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115970},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115970},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006969},
author = {Amol Pandurang Chaudhari and Pankaj Dashore},
keywords = {Facial expression recognition, Cognitive impairment monitoring, Deep learning, Emotion classification, Mental health assessment},
abstract = {The applications of facial expression recognition (FER) in psychological analysis, healthcare, and human-computer interface have drawn a lot of attention. This paper introduces CNN-LSTM-AM, Convolutional neural networks (CNN), long short-term memory (LSTM) networks, and attention mechanisms are all integrated in this deep learning framework to improve facial emotion identification. The suggested approach improves the classification of small differences by efficiently capturing both spatial and temporal data and complex facial expressions. Experimental evaluation on the FER-2013 benchmark dataset demonstrates strong performance, achieving 98.50% accuracy, 96% precision, 95% recall, and a 97% F1-score, with a low error rate of 2.50%. The results highlight the robustness and efficiency of the proposed architecture under standard evaluation conditions. Furthermore, the framework is designed as a generalizable FER model with potential applicability in cognitive impairment monitoring and other healthcare-related domains, subject to further validation using clinically annotated datasets.}
}
@article{DENG2026115894,
title = {Boosting adversarial transferability via diversified sampling and flatness-aware momentum},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115894},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115894},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006209},
author = {Siyuan Deng and Fanhua Shang and Chengchao Zhang and Ji Zhou and Hongying Liu and Jingyuan Xu},
keywords = {Adversarial attacks, Deep neural networks, Transferability, Flatness-aware, Cross-stage momentum reuse, Diversified sampling},
abstract = {Deep Neural Networks (DNNs) play a critical role in various fields but remain vulnerable to adversarial perturbations. While transfer-based attacks are a potent threat in black-box settings, existing methods often struggle to balance the diversity of attack directions with optimization stability, frequently leading to convergence in sharp local optima that limits transferability and image quality. To address these issues, this paper proposes a novel Diversified Multi-stage Flatness-Aware Aggregation (DMFAA) framework. Specifically, we refine Output Diversification Initialization (ODI) by introducing constraints orthogonal to the classification loss, which balances exploration with directional stability. Then we employ a cross-stage momentum reuse technique to maintain gradient consistency across stages, effectively preventing overfitting to surrogate-specific features. Furthermore, to explicitly optimize for the flatness of the loss landscape, we propose a flatness-aware aggregation strategy, which adaptively weights and integrates perturbations from multiple stages to smooth high-magnitude fluctuations and locate flatter, more robust regions. Extensive experiments on ImageNet demonstrate that DMFAA outperforms state-of-the-art methods, achieving an improvement of approximately 7 % in attack success rate on CNN architectures and 8 % on Transformer architectures.}
}
@article{LI2026116035,
title = {PSGCL: Pseudo-siamese supervised graph contrastive learning for enhancing prior knowledge guidance in EEG classification},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116035},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116035},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007616},
author = {Guangqiang Li and Ning Chen and Hongqing Zhu and Yixiang Niu and Zhangyong Xu and Jing Li and Zhiying Zhu},
keywords = {EEG signal classification, Knowledge guidance, Pseudo-siamese network, Graph neural network, Supervised contrastive learning},
abstract = {Neurophysiological prior knowledge-based topological information is crucial for EEG-based classification tasks, such as emotion recognition (ER), auditory spatial attention detection (ASAD), and driver fatigue recognition (DFR). However, the guidance of these prior knowledges may be weakened, as EEG signals are nonstationary, susceptible to noise interference, and exhibit significant variability across subjects. To enhance the guidance of prior knowledge in the EEG classification tasks while improving its adaptability to the variation of EEG data, a pseudo-siamese supervised graph contrastive learning (PSGCL) model is proposed. Specifically, a contrastive learning (CL) strategy based on supervised contrastive loss (SupConsL) and similarity consistency loss (SimConsL) is constructed. It leverages relationships between samples of the same or different classes to optimize the adjacency matrix initialized with prior knowledge, thus enhancing its adaptability to EEG variations. Meanwhile, a pseudo-siamese network (PSN)-based learnable view augmentation strategy is designed to generate distinct but semantically consistent views to avoid the risk of downstream task-related information loss caused by arbitrary data augmentation. Additionally, a sparseness constraint loss (SCL) is incorporated to enforce the sparsity of adjacency matrix while preserving crucial brain-region connectivity relationships. Extensive experiments on six datasets for 3 tasks demonstrate that: (i) The proposed PSGCL model consistently outperforms state-of-the-art baselines with relatively low computational complexity in ER, ASAD, and DFR tasks; (ii) Both the SupConsL and SimConsL-based prior knowledge optimization and the SCL-based constraint strategy significantly contribute to the performance enhancement of the proposed model. (iii) PSGCL effectively enhances the clustering effect and discriminability of EEG representations.}
}
@article{LU2026115841,
title = {Data-centric cross-city knowledge transfer for regional socioeconomic prediction},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115841},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115841},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005678},
author = {Hongru Lu and Dong Kan and Xiao Jing and Zhiang Wu},
keywords = {Data-centric model, Cross-city knowledge transfer, Regional socioeconomic prediction, Urban region representation, Spatial semantic graph},
abstract = {Urban region representation learning is essential for regional socioeconomic prediction, enabling intelligent applications like crime forecasting, GDP predicting and urban planning. However, generalizing these representations to data-scarce cities remains a challenge due to severe spatial semantic heterogeneity. Existing embedding-centric approaches typically employ a decoupled strategy: they first learn city-specific representations independently and then attempt to align them via post-hoc mapping functions. This process often results in limited transferability, as the initial embeddings in data-scarce cities are inherently noisy and structurally incompatible. In response, we propose DACT, a novel data-centric framework that shifts the paradigm from embedding alignment to structural data alignment prior to learning. DACT constructs a shared spatial semantic graph by leveraging large language models (LLMs) as semantic bridges to resolve heterogeneity across schema, domain, and entity levels. Furthermore, we introduce a pairwise region coordination learning mechanism to enable robust and efficient knowledge transfer. This strategy jointly captures intra-city specificity and inter-city generalities by modeling region pairs, offering a scalable solution that avoids the computational bottlenecks of complex graph matching while preserving fine-grained structural details. Extensive experiments on New York City, Chicago, and Shenzhen across five prediction tasks demonstrate that DACT significantly outperforms state-of-the-art baselines, achieving 14.8% MAE reduction, 13.5% RMSE reduction and 155.1% R2 improvement in low-resource settings. These results validate the superiority of the data-centric paradigm for robust regional socioeconomic prediction.Code is available at https://github.com/chaosgod23/DACT_code.}
}
@article{LIU2026115966,
title = {MIRepNet: A pipeline and pre-trained model for EEG-based motor imagery classification},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115966},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115966},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006921},
author = {Dingkun Liu and Zhu Chen and Jingwei Luo and Shijie Lian and Yuheng Chen and Shaojie Hou and Xiaolian Zhu and Dongrui Wu},
keywords = {Motor imagery, Brain–computer interface, Channel template, Effective pre-training, Few-shot fine-tuned},
abstract = {Brain–computer interfaces (BCIs) enable direct communication between the brain and external devices. Recent EEG foundation models aim to learn generalized representations across diverse BCI paradigms. However, these approaches overlook fundamental paradigm-specific neurophysiological distinctions, limiting their generalization ability. Importantly, in practical BCI deployments, the specific paradigm such as motor imagery (MI) for stroke rehabilitation or assistive robotics, is generally determined prior to data acquisition. This paper proposes MIRepNet (Rep = Representations), the first EEG pre-trained model (PTM) tailored for the MI paradigm. MIRepNet comprises a high-quality EEG preprocessing pipeline incorporating a neurophysiologically-informed channel template, adaptable to EEG headsets with arbitrary electrode configurations. Furthermore, we introduce an effective pre-training strategy that combines self-supervised masked token reconstruction and supervised MI classification, facilitating rapid adaptation and accurate decoding on novel downstream MI tasks with fewer than 30 trials per class. Extensive evaluations across five public MI datasets demonstrated that MIRepNet consistently achieved state-of-the-art performance, significantly outperforming both specialized and generalized EEG models. Our code is available at GitHub22https://github.com/staraink/MIRepNet..}
}
@article{HUANG2026116006,
title = {CSGFlow: Causal-structure-guided flow for missing value imputation},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116006},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116006},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600732X},
author = {Buliao Huang and Yunhui Zhu},
keywords = {Missing value, Causal discovery, Generative model, Causality-constrained learning, Neural networks},
abstract = {Missing data are ubiquitous in real-world applications, yet imputing incomplete observations remains challenging due to complex, nonlinear dependencies among variables. While deep generative models, such as normalizing flows, have achieved impressive results in modeling high-dimensional distributions, most existing approaches are correlation-based and fail to account for the underlying causal mechanisms. This limitation can lead to biased or less interpretable imputations, especially when dependencies among observed variables are complex or when the data distribution varies across environments. To address this challenge, we propose a Causal-Structure-Guided Flow (CSGFlow) framework that unifies causal discovery and generative imputation within a single probabilistic model. CSGFlow embeds the causal graph into a RealNVP-based flow architecture, ensuring that each variable’s transformation is conditioned on its causal parents, thereby producing imputations that respect the underlying causal structure and maintain statistical fidelity. A causality-constrained loss further enforces consistency between the imputations and causal graph, enhancing the reliability and interpretability. By iteratively refining both the causal graph and the generative model, CSGFlow produces imputations that are simultaneously causally coherent and statistically faithful. Extensive experiments on synthetic and real-world datasets demonstrate that CSGFlow achieves state-of-the-art performance.}
}
@article{HE2026116027,
title = {Hierarchical traffic fingerprint-assisted Graph Neural Networks for encrypted traffic classification in Internet of Vehicles},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116027},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116027},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007537},
author = {Yaru He and Jiaqi Gao and Daoqi Han and Yueming Lu and Yaojun Qiao},
keywords = {Internet of Vehicles (IoV), Cybersecurity, Encrypted Traffic Classification (ETC), Hierarchical Traffic Fingerprint (HTF), Graph Neural Networks (GNNs)},
abstract = {The rapid development of the Internet of Vehicles (IoV) has significantly enhanced the connectivity of intelligent transportation systems. However, this advancement has also introduced substantial security risks, as attackers may intercept network traffic and launch sophisticated attacks. To strengthen IoV security, extensive studies have explored encrypted traffic classification (ETC) as a proactive approach to mitigating vulnerabilities. However, existing ETC methods often struggle to adapt to complex IoV ecosystem, limiting their classification accuracy. To address this limitation, this paper introduces a Hierarchical Traffic Fingerprint (HTF)-assisted Graph Neural Networks (GNNs) method for ETC. HTF models traffic as a graph to comprehensively capture traffic interaction dynamics. In the constructed traffic graph, packets within a flow serve as nodes and are segmented based on packet direction changes to form Unidirectional Encrypted Traffic Segments (UETSs), where directed edges represent intra-segment connections and bidirectional edges denote inter-segment connections. By adopting UETS as the fundamental granularity for graph construction and establishing directed edges, HTF effectively adapts to diverse network behaviors and captures temporal dependencies, thereby enhancing the semantic representation of the constructed traffic graphs. These traffic graphs are then fed into a GNN model, which effectively captures both local and global topological characteristics, leading to improved feature representation and classification performance. The proposed method achieves an accuracy of 99.81% accuracy on the self-collected IoV dataset and 99.02% on the CIC-IoT-2022 dataset, outperforming the state-of-the-art methods.}
}
@article{DEPAIVA2026115938,
title = {Leveraging Large Language Models for time series forecasting: A systematic literature review},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115938},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115938},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006647},
author = {Gabriel Ikaro Fonseca {de Paiva} and Arthur Caio Vargas {e Pinto} and Marcos Antonio Alves and Omid Orang and Lucas Malacarne Astore and Marcus Vinicius Moraes Oliveira and Frederico Gadelha Guimarães},
keywords = {Time series forecasting, Fine-tuning, Large Language Models, Language-based time series forecasting},
abstract = {Time series forecasting (TSF) plays a foundational role across domains such as energy systems, smart cities, healthcare, finance, climate science, and transportation, where accurate predictions are essential for operational planning and strategic decision-making. Over the past decades, TSF methodologies have advanced from classical statistical models to modern machine learning and deep learning architectures. More recently, the emergence of Large Language Models (LLMs) has opened a new research frontier, revealing that pre-trained LLMs, although originally designed for natural language processing (NLP), can be repurposed, reprogrammed, or fine-tuned as general-purpose sequence learners for numerical temporal data. This paradigm shift has generated increasing interest in evaluating the potential of pre-trained LLMs for TSF. However, existing surveys address LLMs only within the broader scope of time series analysis, and none provide a dedicated, systematic examination of LLM-driven forecasting. To the best of our knowledge, this study constitutes the first systematic and focused review of TSF using LLMs. By following PRISMA guidelines this Systematic Literature Review (SLR) synthesizes the state of the art in LLM-based TSF, covering architectures, tokenization and embedding strategies, prompting and adaptation techniques, application domains, datasets, benchmarking practices, and evaluation methodologies, while also outlining open challenges and future research directions for advancing the field.}
}
@article{LIU2026116019,
title = {FedCED: Consensus enhancement in decentralized federated learning via distillation},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116019},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116019},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007458},
author = {Bin Liu and Changle Li and Qi Chu and Banghao Zhai and Zeyu Ji and Keqin Li},
keywords = {Federated learning, Knowledge distillation, Ring structure, Enhanced consensus},
abstract = {Mainstream Federated Learning (FL) methods rely on a centralized architecture, which introduces security risks like single points of failure. Decentralized architectures mitigate these risks but struggle with storing and managing historical states due to the lack of a central server. This leads to information dispersion between iterations, making it difficult for clients to reach high-quality consensus, thus reducing convergence speed and model performance, especially in ring topologies. To address these challenges, we propose the FedCED framework for ring decentralized FL, enhancing cross-client consensus capabilities. Firstly, FedCED introduces an information retention approach to integrate diverse knowledge sources and mitigating iterative fragmentation. Secondly, FedCED injects noise to promote mutual learning among nodes, eliminating isolation and strengthening client consensus. Finally, FedCED implements a historical information capture mechanism to continuously reuse old knowledge, ensuring optimization continuity. Extensive experiments demonstrate that FedCED significantly outperforms existing methods in ring topologies, achieving up to a 4.11% improvement in test accuracy, thereby validating its effectiveness.}
}
@article{SHI2026115988,
title = {A confidence-aware active learning framework for cross-modal inconsistency in clustering},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115988},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115988},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007148},
author = {Chenhui Shi and Haifeng Yang and Jianghui Cai and Yanting He and Meihong Su and Xujun Zhao and Yaling Xun},
keywords = {Multimodal clustering, Cross-modal inconsistency, Active learning, Confidence-aware},
abstract = {In the real-world clustering of multimodal data, a prevalent yet commonly overlooked phenomenon is that some samples exhibit inconsistent semantic information across modalities due to environmental interference during data collection, heterogeneous focus inherent in each modality, and other factors, which adversely affects the overall clustering accuracy. Recent contrastive learning based and other multimodal clustering approaches are struggling to correctly distinguish the true categories of these samples since the absence of prior knowledge. To tackle this issue, this paper proposes a Confidence-Aware Active Learning framework (CAAL) to further boost multimodal clustering. In this method, we introduce active learning and develop a novel sample selection strategy that leverages data inconsistency to identify challenging and informative instances for labeling, and then simultaneously boosts the model’s discriminability and its perception of modal quality in a supervised manner. Further, by exploiting the strong correlation between modal reliability and inter-modal consensus, we propose a unified modality confidence-aware mechanism. It utilizes a unified confidence perceptron to integrate modality confidence and modality agreement, which enables the transfer of knowledge from labeled to unlabeled data, allowing for maximized effectiveness of labeled data and accurate instance-level modality confidence awareness. Extensive experiments on eight datasets validate the efficacy of CAAL, with notable accuracy improvements of 20.33%, 13.71%, and 13.15% over the best unsupervised baseline on the Prokaryotic, ESP, and Caltech-2V datasets, respectively. And the consensus experiments for modal agreement and confidence also demonstrate the reasonableness and effectiveness of unified modality confidence-aware mechanism.}
}
@article{XI2026115951,
title = {TPAE: A non-metaphorical UAV path planning algorithm for dynamic scene},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115951},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115951},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006775},
author = {Mao Xi and Longyan Xu and Yun Zhang and Lei Liu and Jun Tie and Ziheng Ye and Ren Gao},
keywords = {Non-metaphorical, Sobol sequence, Poisson disk sampling, Adaptive path selection strategy, Artificial potential field method},
abstract = {Addressing the issues of metaphorical bias and poor dynamic adaptability inherent in existing meta-heuristic algorithms for UAV path planning, this paper proposes a multi-strategy fusion three-path adaptive Alpha evolutionary algorithm (TPAE) based on the AE algorithm. At the theoretical level, a hybrid initialization method combining Sobol sequences and Poisson disk sampling is designed to improve population quality. A third evolutionary path and an adaptive path selection strategy are introduced to achieve a smooth transition from global exploration to local convergence. On the CEC2017 benchmark suite, TPAE ranks first with an average score of 1.97, outperforming 59 mainstream algorithms including RIME and MPA. At the application level for UAV path planning, to meet the demands of real-time performance and dynamic obstacle avoidance, an elite evolution matrix and a historical guidance mechanism are further integrated to enhance global search capability and convergence efficiency. The global path generated by TPAE is then employed as a guiding trajectory for the artificial potential field method to avoid local optima traps. Experimental results demonstrate that, in static scenarios, TPAE exhibits superior convergence and robustness compared to mainstream metaheuristic algorithms and significantly improves computational efficiency and path quality over deterministic graph-search algorithms. In dynamic scenarios, the safety margin reserved by the TPAE-planned global trajectory effectively suppresses force oscillations. The curvature and climb angle of the local obstacle avoidance trajectory remain highly consistent with the global plan, validating the effectiveness of the proposed method in dynamic obstacle avoidance and trajectory optimization.}
}
@article{WEI2026115980,
title = {TFAD-Net: A time-frequency aware distillation network for interpretable fine-grained fault diagnosis},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115980},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115980},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007069},
author = {Sha Wei and Yifeng Zhu and Qingbo He and Dong Wang and Shulin Liu},
keywords = {Interpretability, Knowledge distillation, Time-frequency transform, Fine-grained classification, Fault diagnosis},
abstract = {Accurate and interpretable fault diagnosis of gearboxes remains a challenging task due to the nonstationary characteristics of vibration signals and the limited transparency of deep learning networks. To address these issues, this paper presents a time-frequency aware distillation network (TFAD-Net) that integrates adaptive time-frequency representation with hierarchical knowledge distillation in a unified framework. A chirplet-based time-frequency aware layer is designed to adaptively extract discriminative fault features. This layer provides physically interpretable insights into the network's decision-making process. Moreover, a time-frequency aware distillation strategy is developed to transfer both the decision boundaries and intermediate representations from a complex teacher network to a lightweight student network. It enables efficient knowledge transfer without sacrificing interpretability. The overall optimization jointly considers feature alignment, auxiliary supervision, and orthogonal regularization, which ensures stable feature inheritance. Extensive experiments conducted on bevel and planetary gearbox datasets demonstrate that the TFAD-Net achieves diagnostic accuracies at 99.50% and 99.35%. This performance surpasses several state-of-the-art methods. In addition, three interpretability analyses confirm that the TFAD-Net provides transparent and physically meaningful diagnostic reasoning. Benefiting from its lightweight student network, the TFAD-Net achieves high diagnostic accuracy with reduced computational cost.}
}
@article{PARK2026116016,
title = {Efficient cheap all-layer aggregation network for time-sensitive time series classification},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116016},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116016},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007422},
author = {Jaegyun Park and Timur Khairulov and Dae-Won Kim and Jaesung Lee},
keywords = {Time series classification, Time-sensitive tasks, Neural networks, Computational efficiency},
abstract = {Time series classification is a key research area in the data mining community because it serves as a cornerstone for realizing various real-world applications. Existing deep learning approaches often rely on the final high-level features represented at the end of sequential layers, leading to information loss for complex and multiscale temporal dynamics. Recent studies adopted a layer-aggregation strategy to integrate multilevel temporal information. However, it is challenging for the final classifier to utilize temporal features from all the previous layers due to the substantial computational cost, making it challenging to develop time-sensitive tasks. To address this issue, we propose a cheap all-layer aggregation structure designed to enhance classification performance while maintaining computational efficiency. By leveraging learnable channel-wise transformation matrices and a scalable layer aggregation pool, the proposed model integrates information from all layers without increasing the computational costs. We first evaluated the proposed model against baseline methods in seven time-series classification tasks using six public benchmark datasets. To further emphasize our claim, we evaluated the proposed model on an additional six human activity recognition datasets. The proposed model achieved state-of-the-art performance while preserving computational efficiency. The source codes of the proposed network are publicly available at https://github.com/jgpark92/CALANet.}
}
@article{CHEN2026116032,
title = {MAAFOcc: Multimodal adaptive asymmetric fusion based occupancy prediction},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116032},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116032},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007586},
author = {Jiuyu Chen and Miao Chen and Donglin Zhu and Yuyan Mao and Wei Xie and Zhongli Wang},
keywords = {Occupancy prediction, Multimodal fusion, Bev feature fusion, Adaptive asymmetric fusion},
abstract = {Adaptive fusion of multimodal inputs is crucial for 3D scene understanding in unmanned systems, particularly for the task of occupancy prediction for arbitrary types of objects. Recent approaches to multimodal occupancy prediction have made significant progress, but often rely on implicit, symmetric fusion and complex architectures, which may limit spatial consistency and accuracy. Moreover, while detection-guided methods have achieved impressive performance, they still lack adequate feature alignment mechanisms to fully utilize semantic and geometric information. This paper proposes MAAFOcc, a novel network for effective occupancy prediction that introduces a dual-stream interaction mechanism. It directly learns from 2D BEV features before regressing to 3D occupancy. The core contribution of MAAFOcc is an Adaptive Asymmetric Fusion (AAF) mechanism. Unlike symmetric methods, AAF dynamically adjusts the contributions of geometric and semantic features from different modalities based on task-specific requirements. This is complemented by channel-level cross-attention modules to align multimodal features and a detection-supervised strategy enhanced via imbalanced multi-task learning. Extensive experiments on multiple public datasets demonstrate that the proposed method achieves state-of-the-art level performance in 3D occupancy prediction, outperforming other baseline models. The integration of the AAF mechanism significantly enhances the performance of multimodal fusion. The code will be available at https://github.com/iRobotVision/MAAFOcc.}
}
@article{LIN2026115963,
title = {TopoLLM: GAN-enhanced topological representations and pre-trained large language models for Time-Series Forecasting},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115963},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115963},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006891},
author = {Zixin Lin and Nur Fariha Syaqina Zulkepli and Mohd Shareduwan Mohd Kasihmuddin and R.U. Gobithaasan},
keywords = {Pre-trained language models, Computation topology, Time-series forecasting},
abstract = {Topological Data Analysis (TDA) has shown strong potential for revealing latent geometric patterns in complex data, yet its integration into time-series forecasting (TSF) remains underexplored. This study presents TopoLLM, a unified framework that combines patch-based decomposition, Generative Adversarial Network enhanced (GAN-enhanced) topological representation learning, and pre-trained Large Language Models (LLMs) for both supervised and zero-shot forecasting. We first develop a stacked conditional GAN to synthesize realistic topological features, significantly reducing the computational cost of persistent homology extraction. These features are then fused with decomposed trend-season components through prompt-conditioned LLM layers, enabling semantic–geometric alignment within a single model. Extensive experiments on benchmark, air pollution, and oceanographic datasets demonstrate that TopoLLM consistently outperforms state-of-the-art models such as GPT4TS, TimeXer, and PatchTST in terms of both Mean Squared Error (MSE) and Mean Absolute Error (MAE). Beyond accuracy, the results highlight the advantages of incorporating topological structure as an implicit regularizer, leading to improved generalization and zero-shot transferability across diverse temporal domains.}
}
@article{ZHAO2026115984,
title = {A lightweight and robust vision framework for underwater pipeline defect detection},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115984},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115984},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007100},
author = {Wenfeng Zhao and Shenghui Rong and Ze Yu and Bo He},
keywords = {Underwater pipeline, Defect detection, Attention mechanism, Lightweight, Robustness and generalization},
abstract = {Visual inspection of underwater pipeline defects (e.g. cracks, foreign objects) suffers from low efficiency and instability due to turbidity and nonuniform illumination. To address this, this paper proposes RoPipe: a robust and lightweight underwater pipeline defect detection framework built upon YOLOv10n through task-specific adaptations. Specifically, to bridge the training-deployment domain gap, RoPipe employs a degradation-aware attenuation module (DAAM) that combines physics-based modeling and data-driven calibration to synthesize realistic underwater degradation, enhancing generalization in complex environments. To detect weak defects amid noise, it adapts a spatio-frequency cooperative attention (SFCA) that fuses dual-domain features for precise localization and noise suppression. To reduce computational overhead, it incorporates a lightweight C2f-FuseBlock module that substantially reduces parameters and computations while maintaining accuracy. Experiments on pipeline defect datasets encompassing various materials and water qualities demonstrate RoPipe’s superior performance: achieving a mean Average Precision (mAP@50) of 93.5%, a recall rate of 87.0%, and a parameter reduction of about 18% compared to the baseline. Through problem-specific adaptation and synergistic integration of these modules, the method achieves a favorable accuracy–efficiency trade-off suitable for resource-constrained platforms, offering an effective solution for automated safety inspections of urban pipelines and related underwater vision tasks. The source code will be made available at https://github.com/luxiaobaoer/Ropipe.}
}
@article{LAN2026115976,
title = {PEGUNet: Perception-enhanced gated U-Net for robust multi-structure anterior segment segmentation in Scheimpflug imaging},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115976},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115976},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007021},
author = {Zibo Lan and Ying Hu and Chi Liu and Meile Wu and Lin Qi and Yuheng Huang and He Zhang},
keywords = {Deep learning, Scheimpflug image segmentation, Specular highlight displacement, Lens invisibility},
abstract = {Rotating Scheimpflug anterior segment optical section imaging provides an important foundation for quantitative analysis of corneal and anterior chamber structures. However, achieving stable multi-structure segmentation under real-world clinical acquisition conditions remains challenging because of substantial distribution shifts. Specular highlights can cause local saturation and weaken boundary evidence. Poor lens visibility or lens absence can disturb structural priors and class composition, leading to systematic errors at shared boundaries. To address these issues, we propose a perception-enhanced gated segmentation network, termed PEGUNet, for four-class joint segmentation of Scheimpflug optical section images, including background, cornea, anterior chamber, and lens. PEGUNet adopts UNet 3+ as the backbone. During feature learning, it introduces a perception module that jointly models spatial cues, frequency-domain responses, and curvature-guided information to improve boundary discriminability. During multi-scale aggregation, it employs gated fusion to suppress unreliable responses across scales, thereby enhancing category consistency at shared boundaries. Experiments on a private clinical dataset of 787 eyes show that PEGUNet achieves a mean Dice of 0.9782 and a mean HD95 of 1.5679 on the standard test set, and outperforms several strong baselines with controllable computational cost. On an independent challenging subset C (n = 102), PEGUNet still shows consistent performance gains, demonstrating its ability to mitigate performance degradation caused by highlight interference and lens visibility variations. We further provide an optional SAM-assisted local editing interface for controllable revision of rare long-tail failures, without altering the default fully automatic inference workflow. Our code and models are available at: https://github.com/Felix-Lana/PEG.git.}
}
@article{ZHANG2026116052,
title = {“On-the-fly” citation recommendation based on content-dependent embeddings},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116052},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116052},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007781},
author = {Yang Zhang and Qiang Ma},
keywords = {Content analysis, Citation recommendation, Text recommendation, Document representation},
abstract = {As the volume of academic literature continues to grow rapidly, identifying and citing relevant references has become increasingly challenging, especially for early-stage researchers. We propose an on-the-fly citation recommendation framework that dynamically recommends citations during the manuscript writing process. This framework supports authors in locating relevant prior work as they write and helps reviewers assess citation coverage during peer review. Our approach introduces two key innovations: (1) source on-the-fly, which enables recommendation for incomplete manuscripts; and (2) candidate on-the-fly, which allows recommendation to include both in-dataset and newly published (out-of-dataset) papers not yet integrated into the training corpus. To address the challenges of incomplete input and evolving candidate sets, we present CBERT4REC, a content-aware BERT model enhanced with dynamic sampling strategies for citation recommendations. CBERT4REC identifies both the topical focus and the semantics of citing intent from partial manuscript content and uses centrality-based sentence selection to represent candidate papers more effectively. We further introduce a hierarchical transformer encoder to construct document-level embeddings, surpassing traditional sentence-level approaches. Extensive experiments on both in-dataset and out-of-dataset settings demonstrate that our model outperforms strong baselines, offering a practical step toward more intelligent and context-aware citation-support tools.}
}
@article{TEHSIN2026116000,
title = {Explainable brain tumor segmentation via attention-guided hybrid CNN–Transformer–Mamba network},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116000},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116000},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007264},
author = {Sara Tehsin and Inzamam Mashood Nasir and Robertas Damaševičius},
keywords = {Brain tumor segmentation, Explainable artificial intelligence, Hybrid deep learning, CNN–Transformer–Mamba encoder, Dual-branch attention decoder, Boundary-aware learning, Cross-dataset generalization, Magnetic resonance imaging},
abstract = {Accurate and explainable brain tumor segmentation remains challenging due to heterogeneous tumor appearance, weak boundaries, infiltrative growth patterns, and cross-dataset domain shifts. To address these issues, we propose an attention–guided explainable segmentation framework built upon a multi-branch convolutional neural network (CNN)–Transformer–Mamba encoder, a dual-branch attention decoder, and gated multi-scale fusion to jointly model local texture, long-range context, and spatial boundary cues. Comprehensive evaluation on three public datasets, Kaggle Brain MRI, Figshare, and BraTS2020, demonstrates consistent performance improvements over state-of-the-art baselines, achieving mean Dice scores of 91.47%, 90.02%, and 89.14% and intersection over union (IoU) values of 84.61%, 82.70%, and 81.66%, respectively, while reducing boundary errors to 95th percentile hausdorff distance (HD95) values as low as 7.89 and average symmetric surface distance (ASSD) down to 1.46. Strong class-wise gains are observed across all tumor sub-regions, with Dice scores exceeding 90% for multiple categories. Cross-dataset transfer experiments further confirm the robustness of the proposed model, reaching a Dice of up to 88.76% without domain adaptation. In addition, the framework provides reliable interpretability, yielding high global explanation alignment scores of attention–ground truth alignment score (AGAS) 88.71%, explanation coverage ratio (ECR) 90.54%, attention sparsity index (ASI) 78.61%, and stable attribution maps, explanation stability coefficient (ESC) up to 0.86. Computational efficiency is preserved, enabling near real-time inference with millisecond-level latency and moderate training overhead. The proposed method offers a unified solution that combines accuracy, generalization, efficiency, and trustworthy explainability for clinically applicable brain tumor MRI segmentation.}
}
@article{YE2026115992,
title = {TFPA: Enhancing adversarial attack on speech recognition via Time–Frequency Pre-alignment},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115992},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115992},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007185},
author = {Xiangyu Ye and Yatie Xiao and Kongyang Chen and Qingxiao Guan and Zhenbang Liu},
keywords = {Deep learning, Automatic Speech Recognition (ASR), Adversarial attacks, Time–frequency, Alignment},
abstract = {Despite the widespread adoption of Automatic Speech Recognition (ASR) systems, from virtual assistants to real-time transcription services, their vulnerability to carefully crafted adversarial perturbations has raised serious concerns. Traditional white-box attacks achieved high success rates but required hundreds of iterations to converge and failed to generalize across inputs of varying lengths or to the datasets in various fields. To this end, we introduce a novel adversarial method named Time–Frequency Pre-alignment (TFPA), which generates an initial perturbation by explicitly minimizing the discrepancy between the acoustic features of the adversarial audio and those of the target. Both waveforms are first normalized to zero mean and unit variance, and then their features are aligned in the spectral domain by optimizing the perturbation. We then refine these perturbations through model-specific training objectives by integrating an adaptive gradient-based optimizer to accelerate convergence. Extensive experiments demonstrate the effectiveness and efficiency of our method compared to SOTA methods. Specifically, we achieve a high targeted attack success rate while significantly reducing the number of iterations by up to nearly 50% on the Whisper. Adversarial audio samples generated by our proposed work preserve superior audio fidelity (the average SNR is 16.51 dB). Moreover, TFPA has revealed excellent performance in adversarial generalization on cross-data attacks. Our code is available at https://github.com/dislab-gzhu/TFPA.}
}
@article{DAI2026116012,
title = {Contrastive sensitivity learning for unsupervised node importance evaluation in complex networks},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116012},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116012},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007380},
author = {Yiming Dai and Yu Fu and Bin Yu},
keywords = {Complex network, Graph neural network, Node importance, Graph contrastive learning},
abstract = {In complex networks, evaluating node importance is fundamental to understanding information diffusion, network robustness, and resource allocation. However, most existing approaches rely on supervised signals or dynamic propagation models, which are often costly to obtain and may not faithfully reflect node importance in complex networks. To address this issue, we propose an unsupervised node importance evaluation framework based on contrastive sensitivity learning. The core idea is to construct attribute-ablated contrastive views by replacing node features with a constant matrix, thereby suppressing attribute heterogeneity and highlighting structural information. Node sensitivity to structural and attribute perturbations is then quantified through embedding discrepancies between the baseline and ablated views, which serve as the basis for importance estimation. Unlike conventional multi-view contrastive learning that enforces representation invariance, our method explicitly amplifies inter-view differences to reveal attribute-dependent significance. The framework is fully unsupervised, compatible with mainstream GNN encoders, and flexible in supporting diverse view-generation strategies. Extensive experiments on public graph datasets (e.g., Cora, CiteSeer, PubMed, and Amazon) demonstrate that the proposed method achieves high rank correlation with traditional centrality measures (Degree, Betweenness, Closeness, and PageRank) and existing GNN-based ranking methods, while consistently outperforming them in SIR diffusion validation. These results confirm that contrastive sensitivity learning not only enhances the accuracy and robustness of node importance evaluation, but also provides a new theoretical perspective for understanding information diffusion and structural vulnerability in complex networks.}
}
@article{ZHANG2026115923,
title = {A human-in-the-loop active learning framework for scalable wind energy potential suitability assessment},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115923},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115923},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006490},
author = {Yuchen Zhang and Limengqian Zheng and Yixin Guo and Erwan Lu and Zhi Li and Zi Lu},
keywords = {Wind energy potential, Suitability zoning, Human-in-the-loop, Active learning, Explainable AI},
abstract = {High-resolution wind energy potential (WEP) suitability assessment typically requires expert judgements on a large number of candidate sites. Such labelling is subjective, costly, time-consuming and difficult to scale, especially when siting criteria and policy constraints evolve over time. To address this challenge, this study proposes a human-in-the-loop (HITL) active learning framework that aims to (i) minimise expert annotation effort, (ii) enable scalable, high-resolution WEP mapping, and (iii) provide interpretable, expert-consistent model outputs. Within the framework, a limited set of expert-style labels is first generated for a subset of locations to train an intelligent classifier. An active learning strategy then iteratively selects the most informative locations for additional expert annotation, and the classifier is updated until the desired performance is reached. Shapley Additive exPlanations (SHAP) are integrated as an interpretability tool to quantify the contribution of each siting criterion and to explain model behaviour at both global and local scales. The proposed framework is demonstrated for the Beijing–Tianjin–Hebei region using GIS-based spatial datasets. Among a suite of candidate machine learning models, the Transformer model coupled with entropy-based active learning achieves the best trade-off between accuracy and labelling effort, requiring only about one quarter as many location labels as random sampling to reach a comparable level of WEP assessment performance. The resulting high-resolution suitability maps are cross-validated against existing wind farms and further explained using SHAP to reveal criterion-level and location-specific driving mechanisms. The case study demonstrates that the proposed HITL active learning framework can provide label-efficient, adaptive and transparent decision support for wind energy planning in complex metropolitan settings.}
}
@article{ZHANG2026116036,
title = {A causal adversarial graph neural network for multi-center autism spectrum disorder identification},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116036},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116036},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007628},
author = {Zhuan Zhang and Qijian Chen and Li Wang and Caiqing Jian and Yue-Min Zhu and Hongjiang Wei and Lihui Wang},
keywords = {Autism spectrum disorder, Graph neural network, fMRI analysis, Causal adversarial, Multi-center data},
abstract = {Autism spectrum disorder (ASD) diagnosis from resting-state fMRI (rs-fMRI) remains challenging due to spurious feature correlations, site-related distribution shifts, and limited interpretability of existing models. To overcome these issues, we propose a causal adversarial graph neural network (CAG) that integrates causal inference with adversarial learning for robust ASD prediction. CAG constructs refined brain connectivity graphs via a graph filtering module and disentangles them into causal and non-causal subgraphs using a causal graph predictor. ASD-related patterns are derived from causal subgraphs, while site-specific variations are encoded in non-causal subgraphs. A tripartite adversarial mechanism enforces their independence, suppresses environment-related biases, and neutralizes irrelevant features, thereby improving both generalizability and interpretability. Furthermore, an unsupervised environment prototype learning strategy enables automatic inference of site-level variations without requiring predefined domain labels. Extensive evaluations confirm the superior performance of the proposed model. On ABIDE-I, it achieves 77.28% accuracy and 83.89% AUC on the validation set, and 74.32% accuracy and 82.15% AUC on the external test set. On ABIDE-II, the results reach 75.97% accuracy and 79.79% AUC on the validation set, and 78.04% accuracy and 72.04% on the test set, surpassing state-of-the-art baselines.}
}
@article{LI2026115962,
title = {Counterfactual Residual Contrastive Learning for mitigating sycophancy in Large Vision Language Models},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115962},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115962},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600688X},
author = {Yaru Li and Yanxue Wang and Meng Li and Xinming Li and Jianbo Feng},
keywords = {Large Vision Language Models, Hallucination, Dataset, Representation disentanglement, Contrastive learning},
abstract = {Large Vision-Language Models (LVLMs) have achieved remarkable advances, yet remain vulnerable to sycophancy — a critical failure mode in which models defer to misleading user instructions at the expense of visual fidelity. We attribute this susceptibility to entangled multimodal representation geometry within LVLMs, where factual and sycophantic interpretations occupy overlapping latent subspaces with inherently ambiguous decision boundaries. To address this, we propose Counterfactual Residual Contrastive Learning (CRCL), a lightweight, representation-level intervention framework. Rather than relying on invasive full-parameter fine-tuning, CRCL keeps most of the backbone LVLM fixed and learns a compact residual projector that geometrically restructures the latent manifold. At inference time, this projector injects sparse steering vectors that explicitly disentangle factual semantics from sycophantic noise while preserving the model’s generative fluency. To support this representation reshaping, we introduce the Factual Anti-Blind Response (FABR) benchmark, comprising 885K fine-grained instruction–response pairs designed for counterfactual supervision across both standard visual grounding and adversarial scenarios. Extensive experiments demonstrate that CRCL substantially enhances robustness without compromising general capability. On MMhal-Bench, CRCL reduces hallucination rates by over 50%, from 27.08% to 12.50%, and achieves an 18.4% gain in overall accuracy. Furthermore, under the adversarial POPE evaluation protocol, CRCL achieves an F1 score of 85.67%, consistently outperforming representative open-source baselines.}
}
@article{WANG2026116004,
title = {TrustRec: A large language models augmented trustworthy recommendation method based on knowledge constraints},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116004},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116004},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007306},
author = {Ruiqin Wang and Yangyang Ding and Maosen Li and Senhao Lin and Yang Qi},
keywords = {Rating prediction, Recommendation systems, Large language models, Chain of thought, Knowledge constraints},
abstract = {Directly applying large language models (LLMs) to rating prediction tasks faces a credibility crisis, primarily due to factual hallucinations and inherent biases that render them unreliable. To address this, we introduce dual constraints by context guidance and knowledge verification (TrustRec), which enhances LLM reliability through both input and inference: First, it employs external knowledge bases for knowledge verification, suppressing generative hallucinations at their source. Second, it employs context-guided reasoning chains to balance positive and negative information before final rating, effectively neutralizing bias. Experiments on multiple public datasets demonstrate that our TrustRec method significantly outperforms existing baselines in RMSE, MAE, and AUC. Ablation studies further validate the effectiveness of the core techniques in our approach.}
}
@article{SONG2026116028,
title = {High-order relation driven multi-view representation learning},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116028},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116028},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007549},
author = {Na Song and Zhenheng Lin and Shiyang Lan and Zhongyue Lei and Shiping Wang},
keywords = {Multi-view learning, Tensor decomposition, Model interpretability, Neural network, Semi-supervised classification},
abstract = {Existing multi-view feature fusion methods exhibit limitations in modeling high-order correlations, particularly the underutilization of matrix-structured representations, ineffective redundancy elimination, and insufficient deep model integration. To address these critical limitations, we propose a high-order relation-driven framework for interpretable multi-view feature fusion. To obtain accurate per-view representations, we first distill latent embeddings in a pair of complementary graph-structured spaces. These embeddings are then stacked into a third-order tensor, thereby enabling a unified characterization of global cross-view high-order interactions. Redundancy across tensor slices is subsequently reduced by enforcing a low-rank structure under the tensor-SVD nuclear norm, preserving discriminative information while eliminating duplicate components. Finally, feature separability is enhanced via a discriminative loss that explicitly enforces view-specific uniqueness constraints. Extensive experiments on eleven public datasets establish state-of-the-art multi-view clustering and classification performance, surpassing thirteen representative baselines. The resultant interpretable network, entirely free of parameter tuning, further enhances model transparency. The code is available at https://github.com/Elena365-star/HoRM.}
}
@article{ZHU2026115915,
title = {Causal-SAM: Enhancing segment anything for remote sensing instance segmentation via causal representation learning},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115915},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115915},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006416},
author = {Yunhui Zhu and Buliao Huang and Feng Zhou and Yangyang Liu},
keywords = {Causal inference, Instance segmentation, Remote sensing, Segment anything model},
abstract = {Remote sensing (RS) instance segmentation plays a pivotal role in numerous geospatial applications. Motivated by the success of the Segment Anything Model (SAM) in natural image segmentation, recent studies have attempted to adapt SAM to RS tasks by employing object detectors to generate box prompts for RS targets and subsequently feeding these prompts into SAM to produce object masks. However, due to the non-axis-aligned distribution of objects in RS imagery, box prompts often encompass excessive contextual regions that are irrelevant to the target objects. These contextual cues, though not causally related to the object masks, can still affect the segmentation results, leading to biased predictions. To address this issue, we reinterpret SAM-based RS instance segmentation from a causal perspective and propose Causal-SAM, a novel framework designed to disentangle truly causal features from task-irrelevant confounders. Specifically, we first construct a structural causal model to formalize the relationships among objects, contexts, and object masks. Guided by this causal formulation, Causal-SAM introduces a local object transformation module that systematically perturbs non-causal attributes and surrounding contexts to emulate backdoor adjustment, thereby mitigating confounding effects. Furthermore, an attention invariance constraint is imposed on SAM’s mask decoder to ensure that attention focuses on causal, context-invariant features. Extensive experiments conducted on the WHU, NWPU, and SSDD datasets validate that Causal-SAM substantially enhances the effectiveness of SAM-based frameworks for RS instance segmentation.}
}
@article{LV2026115967,
title = {BIP-CENet: A Bilateral Prior–Collaborative Enhancement Network with dual-domain priors for low-light image enhancement},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115967},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115967},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006933},
author = {You Lv and Ru Zhang and Xinhong Hei and Xiaogang Song and Zetian Zhang and Haiyan Tu and Yuping Tan and Jing Xie and Zhilong Zhang and Xiujuan Zheng and Anlin Zhang and Kun Xiao},
keywords = {Low-light image enhancement, Dual-domain priors, Color-space decoupling, Attention mechanism, Feature fusion},
abstract = {Low-light image enhancement (LLIE) remains challenging because sRGB-domain methods operate in an entangled RGB space; therefore, strong brightening often induces color casts, amplified noise, and texture losses. HSV- and HVI-based color-space-decoupled schemes alleviate this coupling but still define intensity as the channel-wise maximum that reflects the brightest component, instead of global luminance statistics and local illumination. HSV additionally suffers from hue discontinuities and black-plane chroma noise in extremely dark regions. HVI, although mitigating part of these artifacts through brightness-gated chroma modulation, is still a geometric reparameterization that can exhibit hue drift and edge weakening under extremely low signal-to-noise ratios. We propose a Bilateral Prior–Collaborative Enhancement Network (BIP-CENet) that exploits an HVI representation and dual-domain priors defined in the YCbCr space. A luminance statistical prior (LSP) built from the Y channel compensates for the single-point bias of the intensity component with multi-view luminance statistics, whereas a chrominance structure prior (CSP) derived from Cb/Cr suppresses dark-region chroma noise and preserves edge continuity. The BIP-CENet adopts a dual-branch pyramid architecture with HV and I streams, in which a Modulated Cross-Projection Fusion (MCPF) module performs a shallow fuse-then-encode prior injection, Guided Bilateral Channel Cross-Attention (GB-CCA) realizes multi-scale prior-guided bidirectional interaction between luminance and chrominance, and a lightweight Gated SE Inverted Residual Block (GSE-IRB) enhances details while denoising. Trained in an end-to-end manner with joint dual-domain supervision, the BIP-CENet achieved superior or competitive results compared with recent advanced methods across multiple paired and unpaired LLIE benchmarks while maintaining a balance between performance and computational cost. Code: https://github.com/DeepUG-AI/BIP-CENet.}
}
@article{ZHANG2026115975,
title = {CogECI: Context Grounded Document-level Event Causality Identification via Large Language Models},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115975},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115975},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600701X},
author = {Zefan Zhang and Xumeng Zhang and Shijie Jiang and Tian Bai},
keywords = {Document-level event causality identification, Large Language Models, Graph Neural Networks},
abstract = {Document-level Event Causality Identification (ECI) focuses on recognizing causal relationships between pairs of events in a document. Previous approaches mainly capture implicit causal links by directly utilizing pre-trained language models to analyze the text. However, they may rely on explicit language shortcuts, leading to predictions with weak correlations between event causality and their grounded context. To tackle this challenge, in this paper, we propose a novel Context Grounded Document-level Event Causality Identification (CogECI) Network. Specifically, we first utilize Large Language Models (LLMs) to extract the grounded context pseudo-labels from the document that are semantically contributive to the causality reasoning of the event pairs. Subsequently, the grounded context pseudo-labels are utilized for supervised Context Grounding Learning (CGL) with the Sentence Graph Module (SGM) and Dual-Stream Causality Reasoning Module (DSCRM) to eliminate the bad influence of numerous redundant and noisy long contexts. Extensive experiments on two benchmark datasets show that CogECI not only greatly outperforms previous state-of-the-art (SOTA) methods but also leads to precise context grounding ability. Our code will be available soon.}
}
@article{MENG2026115846,
title = {Dynamic fusion-aware graph convolutional neural network for multimodal emotion recognition in conversations},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115846},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115846},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005721},
author = {Tao Meng and Weilun Tang and Yuntao Shou and Yilong Tan and Jun Zhou and Wei Ai and Keqin Li},
keywords = {Multimodal emotion recognition, Dynamic fusion, Graph convolutional neural network, Prompt learning},
abstract = {Multimodal emotion recognition in conversations (MERC) aims to identify and understand the emotions expressed by speakers during utterance interaction from multiple modalities (e.g., text, audio, images, etc.). Existing studies have shown that GCN can improve the performance of MERC by modeling dependencies between speakers. However, existing methods usually use fixed parameters to process multimodal features for different emotion types, ignoring the dynamics of fusion between different modalities, which forces the model to balance performance between multiple emotion categories, thus limiting the model’s performance on some specific emotions. To this end, we propose a dynamic fusion-aware graph convolutional neural network (DF-GCN) for robust recognition of multimodal emotion features in conversations. Specifically, DF-GCN integrates ordinary differential equations into graph convolutional networks (GCNs) to capture the dynamic nature of emotional dependencies within utterance interaction networks and leverages the prompts generated by the global information vector (GIV) of the utterance to guide the dynamic fusion of multimodal features. This allows our model to dynamically change parameters when processing each utterance feature, so that different network parameters can be equipped for different emotion categories in the inference stage, thereby achieving more flexible emotion classification and enhancing the generalization ability of the model. Comprehensive experiments conducted on two public multimodal conversational datasets confirm that the proposed DF-GCN model delivers superior performance, benefiting significantly from the dynamic fusion mechanism introduced. To the best of our knowledge, this is the first framework that adaptively assigns different fusion weights to different emotion categories during inference, leading to more effective multimodal information integration. Our code is available at https://github.com/yuntaoshou/DFGCN.}
}
@article{SHAN2026115959,
title = {Robust multi-view regularization and reconstruction network for fraud detection with weak features},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115959},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115959},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006854},
author = {Yuan Shan and Pengbo Li and Hang Yu},
keywords = {Graph fraud detection, Graph neural networks, Consistency learning},
abstract = {Graph-based fraud detection plays a pivotal role in identifying illicit activities across domains such as social networks and finance. Despite significant advancements, challenges remain due to the absence of node attributes and the scarcity of high-quality annotated data, which hinder model performance. To address these issues, we propose Robust Multi-View Regularization and Reconstruction Network (MRRN), a novel framework that leverages both node features and topological structure to construct augmented views. MRRN first extracts view-specific features via an encoder, then integrates them through multi-view feature reconstruction for final classification. Furthermore, it enhances the model’s generalization by combining feature diversity from unlabeled center nodes in distinct embedding spaces and enforcing consistency in label space predictions. Extensive experiments on five real-world datasets demonstrate that MRRN outperforms state-of-the-art methods in terms of both performance and robustness.}
}
@article{ZHENG2026116017,
title = {Dual-dimensional data refinement and frequency-aware spatio-temporal learning for long-term PV-power forecasting},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116017},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116017},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007434},
author = {Guanghui Zheng and Guangyu Liu and Chaoyang Wang},
keywords = {Long-term PV-power forecasting, Dual-dimensional data refinement, Feature-level denoising, Sample-level restructuring, Frequency-aware spatio-temporal learning},
abstract = {Long-term photovoltaic (PV) power forecasting plays a critical role in regional energy resource management, particularly in power dispatching and grid scheduling. However, due to the noisy, highly correlated, and non-stationary nature of PV data, achieving accurate long-term forecasting remains inherently challenging. To address these challenges, this study proposes a unified forecasting framework that combines feature-sample dual refinement with a frequency-aware spatio-temporal modeling architecture. At the data-processing level, a dual-dimensional refinement strategy is designed to improve input representations at two complementary stages. The energy-weighted variational mode decomposition (EVMD) performs feature-level spectral denoising by decomposing each feature into multiple modes and adaptively reconstructing them through energy-weighted aggregation, thereby enhancing the signal-to-noise ratio. Meanwhile, the maximum-correlation reconstruction CNN (MCR-CNN) operates on the sample dimension by reorganizing features into a two-dimensional layout according to their pairwise correlations, allowing convolutional kernels to exploit local correlation patterns for compact and discriminative representations. At the model level, a Graph-enhanced Frequency-adaptive Patch Attention (GPA) module is developed, which integrates frequency-aware patch embedding, sparse self-attention, and dynamic graph message passing to efficiently capture long-range temporal dependencies and cross-channel correlations. Extensive experiments on multiple real-world PV datasets demonstrate that the proposed framework consistently achieves state-of-the-art forecasting accuracy and computational efficiency while maintaining stable performance across different weather conditions, as well as under missing, noisy, and distribution-shift scenarios. Overall, the proposed framework enables stable and efficient long-term PV-power forecasting by jointly enhancing data representations and model architectures.}
}
@article{YIN2026116041,
title = {iMamba-Seg: An interactive mamba-based framework for 3d lesion segmentation in low-resolution functional medical images},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116041},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116041},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007677},
author = {Shun Yin and Qiang Lin and Jingjun Wei and Yongchun Cao and Tongtong Li and Caihong Liu and Zhengqi Cai and Ziyang Zhao and Xiaodi Huang},
keywords = {Interactive segmentation, Functional medical images, Structural medical images, Mamba state space model},
abstract = {Accurate 3D lesion segmentation in functional medical images remains challenging due to low spatial resolution, high noise levels, and heterogeneous standardized uptake value (SUV) patterns. Manual delineation is time-consuming and prone to inter-observer variability, while fully automatic methods often fragment lesions or miss small foci. These limitations motivate interactive 3D segmentation with sparse user clicks as a more controllable, clinically practical alternative. We propose iMamba-Seg, a general interactive 3D lesion segmentation framework built on Click-Interactive Mamba U-Net (CIM-UNet). The framework integrates Multi-Scale Click Feature Encoder (MSCFE) for 3D context propagation of sparse clicks, Progressive Click Feature Fusion (PCFF) for hierarchical multi-lesion collaboration, and Selective State Space Model (SSM) contour modeling to support iterative segmentation refinement. An initial click-selection strategy, SUV-Guided Centroid Initialization (SCGI), combines SUV distributions with distance transforms to generate metabolically relevant and spatially stable first-round click prompts for interactive 3D delineation. On our dataset, iMamba-Seg achieves a Dice Similarity Coefficient (DSC) of 0.9302±0.0019, Intersection over Union (IoU) of 0.8759±0.0032, Precision of 0.8333±0.0033, and Recall of 0.9746±0.0030, producing compact and smooth lesion contours. Further multi-dataset and cross-modality validation, including experiments on a high-resolution liver tumor CT benchmark, demonstrates that the framework consistently suppresses spurious fragments in functional medical images with heterogeneous SUV distributions while maintaining continuous, boundary-faithful tumor shapes in 3D structural medical images. These results confirms its modality-agnostic applicability to both functional and structural volumetric lesion segmentation and highlight strong potential for integration into radiotherapy and nuclear-medicine clinical workflows.}
}
@article{ZHANG2026116020,
title = {FedTDC: Federated teacher-guided distillation with representation and aggregation calibration},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116020},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116020},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600746X},
author = {Ping Zhang and An Bao and Wenlong Lu and Mingkai Hu and Boyuan Li and Kai Guo and Zhuo Jin and Zijian Li},
keywords = {Personalized federated learning, Knowledge distillation, Feature decorrelation, Dynamic aggregation},
abstract = {The development of edge computing and intelligent terminals drives networks toward a user-centric intelligent paradigm, requiring dynamic optimization based on user intent. Federated Learning (FL), enabling collaborative modeling with distributed data while preserving privacy, has become a key technology for personalized, context-aware intelligent networks. However, client data in real scenarios often shows strong non-independent and identically distributed (non-IID) characteristics, degrading global model generalization, hindering personalized adaptation, and causing inconsistent user experiences. Existing methods rely on fixed distillation weights, simple sample-size-based aggregation, or hyperparameter-sensitive feature optimization, failing to balance communication efficiency, knowledge consistency, and global–local performance. These challenges motivate the design of FedTDC, a personalized FL framework for user-centric networks, realizing joint optimization of distillation, representation, and aggregation. It introduces entropy-based teacher-confidence weighting to enhance the reliability of knowledge transfer, feature decorrelation constraints to strengthen the discriminative power of personalized features, and a deep proxy network-based context-aware weighting strategy to achieve robust global aggregation. Experiments on multiple datasets show FedTDC outperforms state-of-the-art methods in accuracy, communication efficiency, and resilience to extreme data heterogeneity, significantly improving global consistency and client personalization, providing a potential solution for 6G, edge computing, and network slicing scenarios. The code is available at https://github.com/Baohua-Judy/FedTDC.}
}
@article{FEI2026116009,
title = {Enhancing text representation with frequency-domain features for robust fake news detection},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116009},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116009},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007355},
author = {Zetao Fei and Yu-Ming Shang and Rouxi Wang and Gang Wang and Yong Liu and Yong Ma},
keywords = {Fake news, LLMs, Style attacks, Frequency-domain},
abstract = {The dissemination of fake news is a non-negligible factor in undermining social stability. Large Language Models (LLMs), with their strong capability to capture textual semantics and generate controllable content, can be utilized to produce highly deceptive fake news, posing severe challenges to fake news detection. Existing sequence modeling-based methods typically employ global attention networks to extract features from news articles, focusing on stylistic patterns in the time domain. However, LLM-restyled fake news that mimics the style of authoritative media tends to overlap with real news in feature distribution, resulting in missed detections. To address these limitations, we propose a robust fake news detection method that enhances text representation with frequency-domain features. The method maps news sequence features into the frequency domain via the Fast Fourier Transform. We then employ a multi-head self-attention mechanism to process amplitude distributions and extract frequency-domain features, which serve as a supplementary component for news representation. Furthermore, we construct a multi-objective function integrating cross-entropy, KL-divergence, and triplet losses. This enables balanced optimization across three tasks: fake news detection, veracity prediction of LLM-restyled versions, and style discrimination, thereby achieving highly discriminative representations effective for news articles and their LLM-restyled versions. Extensive experiments on four benchmark datasets demonstrate that our method achieves advanced performance in the original setting and consistently outperforms seven baselines across four types of LLM-empowered style attacks on key metrics, including Macro-F1.}
}
@article{TAKRAR2026116033,
title = {Hierarchical anchor-guided contrastive learning with heterogeneous GNN for multi-view clustering},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116033},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116033},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007598},
author = {Ali Takrar and Fardin {Akhlaghian Tab} and Alireza Abdollahpouri},
keywords = {Anchor-based contrastive learning, Heterogeneous Graph Neural Networks, Multi-view data fusion, Graph autoencoder denoising, Adaptive bi-stage clustering},
abstract = {Multi-view data are ubiquitous in real-world applications, encompassing diverse modalities such as images, text, and graphs. Multi-view clustering (MVC) aims to leverage complementary information from diverse sources to improve clustering performance. However, existing methods often struggle to effectively integrate heterogeneous, high-dimensional views; handle noisy graph structures; and preserve both global and local cluster consistency. To address these challenges, we propose a novel graph-based framework: Hierarchical Anchor-Guided Contrastive Learning with Heterogeneous GNN for Multi-View Clustering (HACH-MVC). HACH-MVC is an end-to-end framework that constructs view-specific graphs, iteratively refines them through a heterogeneous GNN, and employs a learnable dual-fusion mechanism to derive a consensus graph and feature representation followed by a novel contrastive learning and bi-stage clustering methods. Its core innovation, an influence-aware, anchor-based hierarchical contrastive mechanism, uses anchor nodes identified via a novel adaptive receptive field for nested contrastive learning, preserving micro-group cohesion, enforcing macro-cluster separation, addressing imbalance positive-negative sampling and computational complexity. Finally, hybrid adaptive clustering transitions from K-means initialization to self-supervised refinement, overcome local optima. This strategic integration of the components enables comprehensive model learning and adaptation to the underlying data structures and the clustering task itself, leading to significantly improved clustering results. Extensive experiments on eight diverse benchmarks spanning text, vision, and document data demonstrate that HACH-MVC consistently outperforms state-of-the-art MVC methods by significant margins across seven metrics and exhibits remarkable interpretability, scalability, and robustness, offering a promising new direction for deep multi-view clustering.}
}
@article{VU2026116001,
title = {MoL: Mixture of Layers in Cross-Tokenizer embedding model distillation},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116001},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116001},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007276},
author = {Hai An Vu and Minh-Phuc Truong and Tu Vu and Linh Ngo Van},
keywords = {Knowledge distillation, Cross-Tokenizer distillation, Embedding models, Sentence similarity, Text classification},
abstract = {Knowledge Distillation (KD) is a powerful technique for compressing large text embedding models into smaller, more efficient ones. However, KD in the embedding space remains challenging, not only due to tokenizer mismatches between teacher and student models (Cross-Tokenizer KD—CTKD), but also because of fundamental architectural differences. These discrepancies often lead to representational misalignment, resulting in high distillation loss that degrades student performance. To address this, we propose a similarity-based functional distillation framework that dynamically aligns a particular student layer to a weighted mixture of teacher layers, based on representational similarity. This flexible alignment mechanism produces softer, semantically closer distillation targets, which reduces loss magnitude. Moreover, the student model can absorb more knowledge from multiple teacher layers rather than only one layer. We evaluate our method by distilling leading embedding models—LLM2Vec, BGE-M3, and Qwen3-Embedding into multiple student models (TinyBERT-4L, TinyBERT-6L, and BERTBASE) across a range of embedding-centric tasks, including text classification, sentence-pair classification, and semantic textual similarity. Experimental results show that our method outperforms existing CTKD baselines (1–2% improvements), yielding smaller student models with improved accuracy and representation quality.}
}
@article{HU2026115985,
title = {A multi-mode structured light 3D imaging system with multi-source information fusion for underwater pipeline detection},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115985},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115985},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007112},
author = {Qinghan Hu and Haijiang Zhu and Na Sun and Lei Chen and Zhengqiang Fan and Zhiqing Li},
keywords = {Multi-Mode 3D imaging, Structured light, Multi-source information fusion, Edge detection network, Underwater pipeline detection},
abstract = {Underwater pipelines are highly susceptible to corrosion, which not only shorten their service life but also pose significant safety risks. Compared with manual inspection, intelligent real-time imaging systems for underwater pipeline detection have emerged as a more reliable and practical solution. Among various underwater imaging techniques, structured light 3D imaging can restore the sufficient spatial detail for precise defect characterization. Therefore, this paper develops a multi-mode underwater structured light 3D imaging system for pipeline detection (UW-SLD system) based on multi-source information fusion. First, a rapid distortion correction (FDC) method is employed for efficient underwater image rectification. To overcome the challenges of extrinsic calibration among underwater sensors, a factor graph-based parameter optimization (GPO) method is proposed to estimate the transformation matrix between the monocular structured light and acoustic sensors. Furthermore, a multi-mode 3D imaging strategy is introduced to adapt to the geometric variability of underwater pipelines. Given the presence of numerous disturbances in underwater environments, a multi-source information fusion strategy and an adaptive extended Kalman filter (AEKF) are designed to ensure stable pose estimation and high-accuracy measurements. In particular, an edge detection-based ICP (ED-ICP) algorithm is proposed. This algorithm integrates pipeline edge detection network with enhanced point cloud registration to achieve robust and high-fidelity reconstruction of defect structures even under variable motion conditions. Extensive experiments are conducted under different operation modes, depths, velocities, and turbidities. In addition, comprehensive ablation studies and system comparisons are carried out to validate the contribution of each component and the overall system. The experimental results demonstrate that the developed system achieves superior accuracy, adaptability and robustness, providing a solid foundation for autonomous underwater pipeline detection.}
}
@article{KAANYUCE2026115880,
title = {KFPT: Reliability and uncertainty filtered self-distillation for language model training},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115880},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115880},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006064},
author = {Muzaffer {Kaan Yuce} and Mehmet {Fatih Amasyali}},
keywords = {Large language models, KFPT, Self-distillation, Two-phase training, Reliability weighting, Uncertainty (entropy)-based filtering, Continual pretraining},
abstract = {Transformer-based large language models are typically trained on large text corpora using the next-token cross-entropy (CE) objective. Although CE is scalable and stable, in practice it can exhibit limitations such as overconfidence, weak learning signals on hard/rare tokens, and a mismatch between the training objective and generation-time behavior. In this work, we propose Knowledge-Filtered Phase Training (KFPT), a two-phase scheme that strengthens the training signal without requiring an additional teacher/model. In the first phase, KFPT augments CE with a selective regularization term (RU) and, at fixed intervals, performs a second forward pass on the same text by masking small blocks in the attention mask, averaging the CE losses to make updates more stable. In the second phase, KFPT adds a one-way KL-consistency term by taking the distribution from a span-drop-induced second view as the target; this term is selectively weighted and strengthened only at useful positions based on the reference view’s reliability (gold-margin and correctness) and the student’s uncertainty (entropy). We also analyze why the additional terms used in Phase 1 and Phase 2 can be effective through mathematical theorems and proofs. In comprehensive experiments, we compare KFPT across multiple model architectures and training regimes against a strong CE baseline and prior teacher-free objective-improvement methods. The results show that KFPT generally improves accuracy and reduces perplexity, outperforming teacher-free alternatives in the literature.}
}
@article{SAINZPARDODIAZ2026115993,
title = {Metric-privacy-inspired noise calibration in federated learning: Improving convergence and preventing client inference attacks},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115993},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115993},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007197},
author = {Judith {Sáinz-Pardo Díaz} and Andreas Athanasiou and Kangsoo Jung and Catuscia Palamidessi and Álvaro {López García}},
keywords = {Federated learning, Differential privacy, Metric-privacy, Data privacy, Medical imaging},
abstract = {Federated learning (FL) enables the training of a global model across multiple data owners (clients) without sharing raw data. This distributed architecture is orchestrated by a central server that aggregates the local models from the clients. In cases where the server is trusted but not all network nodes, differential privacy (DP) can be used to privatize the aggregated model by adding noise. However, this may affect convergence across the FL rounds. In this work, we build on the notion of metric-privacy as a design principle to calibrate the noise added by the server under a global-DP setting, with the objective of mitigating its impact on the convergence of the aggregated model. We do not enforce metric-privacy as a formal guarantee, but rather use it to guide noise calibration. We compare our approach with vanilla FL and global-DP by analyzing the impact on six aggregation strategies and applying it to a medical imaging use case, simulating different scenarios with homogeneous and non-i.i.d. clients. Finally, we introduce the client inference attack (CIA), where a semi-honest client tries to find whether another client participated in the training and study how it can be mitigated using DP and metric-aware noise calibration. Our experiments show that metric-privacy aware noise calibration strategy improves the accuracy compared to standard DP in all the scenarios analyzed, while achieving a comparable success rate against CIA. These results indicate that metric-privacy inspired noise calibration can deliver a superior utility-privacy trade-off in medical-imaging federated settings.}
}
@article{ZHANG2026116029,
title = {Implicit Alignment with Complementary Information for Text-based Person Re-identification},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116029},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116029},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007550},
author = {Guoqing Zhang and Shan Yang and Yadang Chen and Le Sun and Yulin Cao and Yuhui Zheng},
keywords = {Text-based person re-identification, Pedestrian structural features, Granularity balancing, Learnable prototypes},
abstract = {Text-based person re-identification (TBReID) aims to identify target pedestrians across different cameras based on given text clues. This task is challenging owing to the inherent cross-modal heterogeneity between images and text, which often results in granularity-imbalanced feature representations. Although existing implicit alignment methods mitigate granularity imbalance and avoid semantic bias by employing learnable units, they overlook the structural semantic asymmetry between modalities, such as differences in body proportion and posture. To address these limitations, we propose Implicit Alignment framework with Complementary Information (IACI), a novel framework that enhances textual representations using structural semantics to achieve better cross-modal alignment. The IACI framework comprises three key modules: a Feature Compensation Fine-grained Alignment module, which leverages sketch generation to enrich textual structural semantics and enforces fine-grained alignment constraints; a Relationship-based Noise Filtering module, which employs contrastive noise embedding to reduce interference from image background noise and redundant textual descriptions; and a Prototype-based Granularity Balancing module, which utilizes shared dynamic prototypes to align modalities using temperature-scaled attention. Extensive experiments on three mainstream datasets demonstrate that our method achieves state-of-the-art performance in TBReID. The underlying code will be released upon acceptance.}
}
@article{KIM2026115977,
title = {Transformer-CTP: Current token prediction using cross-attention of queries with current position information},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115977},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115977},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007033},
author = {Gyunyeop Kim and Sangwoo Kang},
keywords = {Transformer, Language model, Positional embeddings, Decoder overfocusing},
abstract = {Transformers and pre-trained language models have significantly advanced a wide range of artificial intelligence tasks. Typically, transformer decoders for language generation are trained with the language modeling (LM) loss, which enables autoregressive generation by predicting the next token from previous tokens through self-attention. However, self-attention often assigns high attention weights to self-tokens, causing the transformer decoder to overfocus on the previous token, t−1, when predicting the current token, t, which can lead to performance degradation. Our proposed method prevents the transformer decoder from overfocusing on token t−1 when predicting token t. Instead of predicting token t using the output of token t−1, we use a new input to predict token t. We also introduce a Current-Token Prediction (CTP) module into the transformer decoder, which prevents token t−1 from being used as the attention query by applying cross-attention with the new input. Experiments on machine translation and document summarization demonstrate that our method mitigates the overfocusing problem and improves performance. Our approach not only enhances performance but also distributes attention more evenly across tokens. The code for the experiments is available on our GitHub.11https://github.com/KimGyunYeop/Transformer-CTP.}
}
@article{LIU2026116013,
title = {Blind Gaussian image denoising via progressive feature separation and directional feature aggregation},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116013},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116013},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007392},
author = {Sanzai Liu and Lihua Cao and Yi Li},
keywords = {Image denoising, Deep learning, CNNs, Asymmetric convolution},
abstract = {Blind Gaussian image denoising faces challenges in disentangling multi-scale and orientation-specific image structures, often leading to over-smoothing or artifacts. To address this, we propose a novel deep neural network incorporating two dedicated mechanisms: a Progressive Feature Separation Module (PFSM) that decomposes features into hierarchical scale bands to isolate structural information from scale-variant noise, and a Directional Feature Aggregation Module (DiFAM) that utilizes asymmetric convolutions to capture and aggregate orientation-specific characteristics crucial for preserving edges and textures. Integrated within a U-Net like architecture, our method demonstrates highly competitive performance on both synthetic and real-world datasets.}
}
@article{LIU2026115981,
title = {GDCC: scRNA-seq data imputation via Graph-cGAN based dual conditional guidance with constraint training},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115981},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115981},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007070},
author = {Tianyi Liu and Gaoshi Li and Xu Lin and Rui Zhou and Yingying Chen and Jingli Wu and Jiafei Liu},
keywords = {scRNA-seq, Imputation, Dropout events, Graph convolutional network, Dual-conditional guidance},
abstract = {Single-cell RNA sequencing (scRNA-seq) is frequently compromised by dropout events, which obscure biological signals and hinder downstream analysis. Existing imputation methods often suffer from over-smoothing in linear approaches, rigid distributional assumptions in statistical models, or over-imputation and structural inconsistency in deep learning frameworks. To address these limitations, we proposed GDCC, a method based on Graph-cGAN with dual conditional guidance and constraint training. GDCC integrates Graph Convolutional Networks (GCN) with conditional Generative Adversarial Networks (cGAN) to capture nonlinear interactions without prior assumptions. It features a dual-conditional guidance mechanism to balance local topology and global cell-type consistency, alongside a constraint training strategy using consistency loss and a mark matrix to prevent over-imputation and preserve biodiversity. Extensive experiments on four simulated and seven real datasets demonstrate that GDCC significantly outperforms eleven state-of-the-art methods in data recovery, clustering, differential expression, trajectory inference, and batch effect removal. The source code and data are available at https://github.com/lty10086/GDCC-Impute.}
}
@article{MA2026115964,
title = {THCVformer: Modeling temporal-dependencies, heterogeneity, and correlations for enhanced time-series forecasting},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115964},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115964},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006908},
author = {Shusen Ma and Yun-Bo Zhao and Yu Kang},
keywords = {Multivariate time-series forecasting, Temporal dependencies, Heterogeneity, Correlation},
abstract = {Multivariate time-series forecasting (MTSF) poses a significant challenge due to the intricate and nonlinear interdependencies among diverse timestamps and variables. Extracting temporal features from the variable sequence is crucial to improving model performance in such tasks. Learning the heterogeneity of variables and analysing their correlations are equally important. To construct a more robust predictive model, this paper incorporates the temporal dependencies, heterogeneity, and correlation of variables into the predictive framework, proposing a new model named THCVformer. THCVformer first deploys a Heterogeneity Learner to capture the statistical features of the input sequence for different variables, i.e. variance and mean. Subsequently, through an embedding layer, the THCVformer effectively captures the positional information of input sequences and dependencies between different time steps, thereby learning the temporal characteristics of variables. Finally, the THCVformer employs Multivariate Sparse-attention to clip weak attention, reducing the interference of irrelevant variables on target variable prediction and enhancing the model’s perception and learning of useful information among variables. Experimental results show that compared with the previous state-of-the-art models, THCVformer can reduce mean squared errors by 9.2% and 45.05% for multi-step and single-step forecasting tasks, respectively.}
}
@article{LI2026116045,
title = {PRLoRA: Pyramid-Structured Low-Rank Adaptation Balancing Global Context and Local Precision in Large Language Models},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116045},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116045},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007719},
author = {Xueguang Li and Cheng Guo and Qianqian He and Mianxiong Dong and Kaoru Ota},
keywords = {Large language models, Parameter-efficient fine-tuning, Low-rank adaptation, Pyramid network structure, Arithmetic reasoning},
abstract = {Parameter-efficient fine-tuning (PEFT) has become the mainstream paradigm for adapting large language models (LLMs) to downstream tasks. However, existing PEFT approaches often suffer performance degradation when applied to complex tasks. To address this limitation, we propose a hierarchical Pyramid-Structured Low-Rank Adaptation (PRLoRA) method. PRLoRA constructs a pyramid network architecture characterized by multi-scale representations that effectively balance local precision with global contextual awareness. In addition, it incorporates a local optimization module that evaluates the importance of LLM weights and adaptively selects locally optimal positions within the pyramid, thereby accelerating convergence. The pyramid structure fusion LoRA (PSFLoRA) module within PRLoRA fuses multi-scale features of the pyramid to enhance the method’s effective rank. We conduct comprehensive experiments on 14 datasets; PRLoRA achieves state-of-the-art performance on both the GLUE benchmark and arithmetic reasoning tasks. In particular, it outperforms LoRA by 6.33% on AddSub and surpasses the previous state-of-the-art, DoRA, by 1.89% on GSM8K. Extensive ablation studies validate the contribution of each component and demonstrate PRLoRA’s robustness across diverse architectures (LLaMA3, OPT, BLOOM, Gemma) and multiple model sizes (1B, 3B, 8B).}
}
@article{WANG2026115944,
title = {Prompt-guided fine-grained semantic alignment for weakly supervised video anomaly detection},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115944},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115944},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006702},
author = {Binghui Wang and Chunjuan Yan and Da Song and Lanxiao Li and Chuanxu Wang},
keywords = {Video anomaly detection, Prompt learning, Semantic alignment, Feature enhancement},
abstract = {Weakly-supervised Video Anomaly Detection (wVAD) detects frame-level anomalies using only coarse video labels. Binary video-level supervision makes it hard for models to pinpoint exact anomaly boundaries. Most methods also rely solely on visual features, making it difficult to distinguish visually similar but semantically different events (e.g., hugging vs. fighting), leading to false alarms. To address these issues, we propose the Prompt-Guided Fine-Grained Semantic Alignment for Weakly-supervised Video Anomaly Detection (PGSA-VAD), which uses prompt-based priors to enhance anomaly distinction under weak supervision. Specifically, we propose the Dynamic Magnitude- Driven Temporal Aggregation Module (DMD-TAM), which adaptively extracts local anomaly features and aggregates multi-scale fine-grained feature aggregation, achieving comprehensive temporal modeling while maintaining computational efficiency. Additionally, our Prompt-Guided Feature Enhancement Module (PGFEM) combines textural prior knowledge with visual features to improve class separability and clarify anomaly boundaries. Extensive experiments demonstrate the effectiveness of PGSA-VAD on three public datasets.}
}
@article{DEOLIVEIRA2026116005,
title = {Causal-Nest: A framework for automated causal discovery and inference},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116005},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116005},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007318},
author = {Gustavo F.V. {de Oliveira} and Fabrício A. Silva and Marcus H.S. Mendes},
keywords = {Causality, Causal discovery, Causality for ML, Causal feature engineering, Causal inference framework},
abstract = {Causal discovery offers a path for Machine Learning models to move beyond mere correlation to understand cause-and-effect relationships. However, its operational complexity remains a significant barrier for non-expert developers. This paper introduces Causal-Nest, a new, comprehensive framework that simplifies and operationalizes the causal analysis pipeline for non-experts. The contribution of the framework is demonstrated through an extensive, two-part evaluation. First, we validate its theoretical correctness and diagnostic power using the well-known Sachs et al. dataset and an extended benchmark of seven real-world datasets with known causal constraints. Our results show that the proposed framework effectively assesses causal graph integrity, using metrics, including the novel Knowledge Integrity Score (KIS), to pinpoint structural discovery failures and statistical unreliability quantitatively. Second, we demonstrate its practical utility in a common Machine Learning scenario where no such ground truth is available: telecommunications customer churn prediction. We show that using the proposed framework to guide a causality-driven feature engineering process yields a causal oversampled feature set that significantly improves the minority-class F1-Score of ensemble prediction models (e.g., CBC, GBMC). This work validates Causal-Nest as a single, dual-purpose tool that successfully bridges the gap between rigorous causal validation and practical, performance-driven machine learning applications.}
}
@article{DONG2026116025,
title = {Diffusion-enhanced graph contrastive learning with hierarchical negative sampling for link prediction},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116025},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116025},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007513},
author = {Tingting Dong and Rui Tang and Xian Mo},
keywords = {Link prediction, Semantic transitions enhanced, Contrastive learning, Diffusion model, Negative sampling},
abstract = {As a fundamental task in network analysis, link prediction is important for practical applications such as intelligent recommendation systems and urban traffic flow forecasting. This paper proposes a Diffusion-Enhanced Graph Contrastive Learning with Hierarchical Negative Sampling (DGCN) for link prediction. Specifically, our DGCN introduces a diffusion model incorporating semantic transformation mechanisms to generate dual-contrast views with distinct semantic characteristics. This process is controlled via a Feature-wise Linear Modulation (FiLM) layer, which dynamically fuses time-step embeddings and query-node features to preserve semantic relevance during diffusion. It is capable of capturing local structural characteristics within a one-hop neighborhood while simultaneously extracting global semantic information across k-hop neighborhoods, where k is adaptively determined. This dual-view design effectively enables the collaborative representation of local fine-grained features and global semantic patterns. More importantly, this model introduces a dynamic time-step adjustment mechanism during the diffusion denoising process, which enables the automatic generation of negative samples with diverse semantic levels and finely calibrated difficulty classifications in the latent space. Based on these negative samples, we develop a contrastive learning framework aimed at improving model performance through the optimization of embedded representations from both the main view and the contrasting views. Experimental results on multiple public datasets demonstrate that our method consistently outperforms state-of-the-art approaches. Our datasets and source code are available.11https://github.com/dtt-m/DGCN.}
}
@article{WU2026116049,
title = {Hierarchical frequency adaptation for all-in-one image restoration},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {116049},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116049},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007756},
author = {Yang Wu and Ye Deng and Siqi Hui and Yuhan Liu and Kangyi Wu and Wenli Huang and Jinjun Wang},
keywords = {All-in-one image restoration, Mixture of Expert (MoE), Frequency prompts, Image denoising, Deraining, Dehazing, Deblurring and low-light},
abstract = {Effective degradation-aware adaptation is critical for all-in-one image restoration. However, prevailing methods typically model degradations solely in the spatial domain, often neglecting the more discriminative information inherent in the frequency spectrum. To address this limitation, we propose a Hierarchical Frequency-driven Network (HFre-Net) that first establishes a global frequency context to determine what to restore, and then refines how to restore it through layer-wise frequency expert specialization. At the global level, a Frequency-Prompted Modulation (FPM) module analyzes the input frequency spectrum to generate a unified prompt that provides top-down, degradation-aware guidance for the entire restoration pipeline. At the local level, the Mixture-of-Frequency-Experts (MoFE) is integrated into each decoder layer to determine how features should be restored. MoFE dynamically routes layer-wise features to degradation-specific frequency experts for adaptive computation tailored to the evolving degradation characteristics, while a shared expert models task-invariant representations. The synergy between global frequency prompting and layer-wise expert specialization enables precise and robust restoration across diverse degradations. Extensive experiments on multiple benchmarks demonstrate that our method shows superior performance, validating the effectiveness of our hierarchical frequency adaptation framework. The code will be released at https://github.com/wuyang2691/HFre-Net.}
}
@article{ZHANG2026115936,
title = {Bayesian perturbation-driven consistency regularization for semi-supervised medical image segmentation},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115936},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115936},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006623},
author = {Hongyu Zhang and Haipeng Chen and Yingda Lyu and Zenan Shi and Yongping Yang and Yu Wang},
keywords = {Semi-supervised learning, Medical image segmentation, Consistency regularization, Perturbation learning, Deep variational inference},
abstract = {Consistency Regularization (CR) is a core paradigm in semi-supervised learning, whose effectiveness hinges on the perturbations used to construct complementary views. Existing CR methods typically rely on handcrafted “prior” perturbations borrowed from natural-image regularization. However, our empirical study shows that such priors are largely ineffective for medical segmentation, yielding at best marginal gains and highly variable effects across anatomies and modalities. We attribute this to two factors: data irrelevance (introducing semantically invalid variability that drives CR toward variance cancellation) and task irrelevance (lacking task conditioning, which limits transfer across tasks). Motivated by this, we propose a Bayesian CR framework that recasts perturbations as learnable, data-conditioned posteriors. Using deep variational inference, we optimize two probabilistic objectives — perturbation–data and perturbation-task alignment — to learn perturbations that are both semantically valid and task-adaptive in an end-to-end manner. To enable efficient training on high-resolution medical volumes, we further introduce an axis-wise factorized variational scheme that reduces 3D posterior inference to parallel 2D subproblems, substantially lowering overhead. Extensive experiments across multiple medical segmentation benchmarks demonstrate consistent improvements over strong CR baselines and state-of-the-art methods. Code: https://github.com/JackCD99/S2MIS-SMFLP-MVC.}
}
@article{SU2026115997,
title = {Position-aware and degree-adaptive graph neural networks for multi-view representation learning},
journal = {Knowledge-Based Systems},
volume = {343},
pages = {115997},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115997},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007239},
author = {Haiyao Su and Yuhong Chen and Jielong Lu and Aiping Huang and Shiping Wang},
keywords = {Multi-view learning, Structural positional encoding, Dynamic degree encoding, Contrastive learning, Semi-supervised classification},
abstract = {Multi-view graph learning has garnered increasing attention for its ability to leverage complementary structural and semantic information across views. However, most existing methods primarily focus on intra-view information propagation, while overlooking complex inter-view interactions. To better extract higher-order relationships between views, we propose a unified framework that dynamically extracts inter-view information by aggregating positional encoding information across views. First, view-specific structural signatures are derived and fused via a similarity-guided projection strategy, enabling the model to capture both common and distinctive topological patterns across views. Second, a dynamic degree encoding scheme is introduced to incorporate node centrality into the message-passing mechanism, thereby enhancing structural awareness. Third, a hierarchical fusion module, incorporating attention and gating mechanisms, is proposed to adaptively integrate multi-view node representations under global contextual guidance and feature-wise modulation. Furthermore, to foster both consistency and discrimination among views, a contrastive learning objective is incorporated to align cross-view representations within a latent space. Extensive experiments on multiple benchmark datasets demonstrate that our method consistently outperforms state-of-the-art multi-view graph learning approaches, achieving superior accuracy, robustness, and generalization.}
}