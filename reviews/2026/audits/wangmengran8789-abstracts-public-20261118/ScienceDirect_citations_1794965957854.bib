@article{MA2026116735,
title = {FedHoRW: Knowledge-structured federated graph learning via higher-order topological reasoning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116735},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116735},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014619},
author = {Cuihua Ma and Xiangyan Tang and Chaosheng Tang and Jingxin Liu and Neal N. Xiong},
keywords = {Federated graph learning, Higher-order topological knowledge, Graph neural networks, Knowledge-structured learning, Node–simplex bipartite modeling},
abstract = {Federated graph learning (FGL) enables collaborative model training without exposing raw data, yet the fragmentation of graph structures across clients often destroys cross-subgraph relations, leading to incomplete topological knowledge and weakened reasoning capability. To address this challenge, we propose FedHoRW, a knowledge-structured FGL framework that enhances graph learning through higher-order topological reasoning. Instead of reconstructing missing edges, FedHoRW encodes each client’s local subgraph as a simplicial-complex representation, where multi-node interactions such as triangles and higher-dimensional simplices serve as local structural knowledge. A node–simplex bipartite graph is constructed to capture these higher-order relations, and knowledge is propagated through random upstream and downstream walks, which explicitly adapts to local topological heterogeneity without requiring global connectivity. At the federated level, FedHoRW aggregates model parameters to implicitly share higher-order structural priors, allowing clients to align their topological knowledge in a privacy-preserving manner. To complement this topological adaptation, personalized optimization is integrated at the parameter level to prevent local model collapse, synergistically ensuring robust reasoning under heterogeneous graph distributions. Extensive experiments on six benchmark datasets demonstrate that FedHoRW consistently outperforms state-of-the-art FGL frameworks, confirming that higher-order topological knowledge serves as an effective inductive bias for federated graph reasoning. This work highlights the value of integrating knowledge-oriented structural representations into federated graph learning.}
}
@article{DAI2026116272,
title = {Multimodal learning with missing modalities: Can progressive diffusion achieve distribution-consistent learning from incomplete multimodal data?},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116272},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116272},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009986},
author = {Ruiting Dai and Aoqiang Jian and Ruoxuan Zhang and Yuang Jia and Lisi Mo and Siyu Zhan and Tao He},
keywords = {Incomplete multimodal learning, Transformer, Prompt learning, Teacher–student learning},
abstract = {Multimodal learning significantly enhances machine perception, yet real-world applications are frequently hindered by incomplete data. Existing generative models for recovering missing modalities face two fundamental limitations: (1) they struggle to maintain distributional consistency between the recovered and original modalities; and (2) they typically treat all missing-modality scenarios uniformly, neglecting the inherent difficulty variance across different recovery tasks, which leads to training imbalance and suboptimal performance. To address these challenges, we propose ProgDiff, a progressive diffusion framework designed to preserve both distributional and semantic integrity during recovery. ProgDiff introduces three key innovations: First, a conditional score-based diffusion model employing a distribution-to-distribution paradigm, which handles arbitrary missing-modality combinations via a unified score function while strictly preserving modality-specific distributions. Second, a reconstruction module featuring multi-head channel-wise attention (MHCA) blocks that refines recovered embeddings through precise feature recalibration. Third, an Adaptive Dynamic Training Strategy (ADTS) inspired by curriculum learning, which automatically partitions training samples by difficulty and progressively scales the learning focus. Extensive experiments on four benchmark datasets validate ProgDiff’s superiority. It consistently outperforms the latest state-of-the-art methods, such as CyIN [1] and ABDiff [2], achieving an average improvement of 2.56% (and up to 8.46%) on the IEMOCAP dataset, demonstrating its robust capability in restoring semantic fidelity under severe modality absence.}
}
@article{ZHAO2026116758,
title = {Robust speech emotion recognition based on Exponential Gain Attention and uncertainty-balanced distillation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116758},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116758},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601484X},
author = {Zhen Zhao and Kexin Wang and Siwei Pu and Zhen Li and Shengbei Wang and Yongwei Li and Yang Liu},
keywords = {Speech emotion recognition, Adaptive attention enhancement, Meta-distillation learning, Multi-task loss fusion},
abstract = {Speech emotion recognition (SER) in noisy environments remains challenging because noise distortions may obscure emotion-related speech cues and weaken the generalization ability of models trained on clean speech. To address this problem, we propose an Uncertainty-Balanced Exponential Synergistic Distillation (UESD) framework for robust SER under noisy conditions. UESD consists of three main components. First, an Exponential Gain Attention (EGA)-Former backbone is designed, which uses confidence-guided reweighting and exponential enhancement to emphasize emotion-salient regions while suppressing noise-corrupted components. Second, a Synergistic Strategy Distillation mechanism is introduced to improve clean-to-noisy knowledge transfer. Through a meta-learning-based bilevel optimization process, the teacher model adaptively adjusts its teaching strategy according to the student model’s representation bottlenecks under noisy inputs. Finally, we integrate an uncertainty-based loss fusion mechanism that leverages the principle of homoscedastic uncertainty to adaptively balance the weights of heterogeneous tasks, thereby stabilizing multi-objective optimization. Experiments on IEMOCAP, CASIA, and EMODB under multiple noise types and signal-to-noise ratio (SNR) levels show that UESD achieves competitive performance and improved robustness, especially under severe noise conditions. At 0 dB SNR, compared with the best competing result for each metric under the same setting, UESD achieves absolute gains of 1.76%, 3.20%, and 2.90% in WA, UA, and WF1 on IEMOCAP, respectively. The corresponding gains in WA, UA, and WF1 are 1.76%, 1.76%, and 1.50% on CASIA, and 0.45%, 1.61%, 1.52% on EMODB, respectively. These results suggest that UESD is particularly effective in preserving emotion-related cues under low-SNR conditions. The code and model are available at: https://github.com/kcc98353-wq/UESD.}
}
@article{LIU2026116755,
title = {Adaptive multi-embedding framework for unsupervised network alignment},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116755},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116755},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014814},
author = {Liwen Liu and Haijian Zhu and Zheng Wang and Lizhe Xie and Yining Hu},
keywords = {Unsupervised network alignment, GAT, Multi-embedding, Adaptive aggregation, Graphlets},
abstract = {Network alignment aims to identify node correspondences across different networks and plays an important role in many downstream tasks. Due to the difficulty of obtaining prior anchor links, unsupervised network alignment has attracted increasing attention. However, many existing unsupervised methods have limited ability to capture complex structural patterns or rely on fixed fusion ratios to combine multiple sources of information, which restricts their performance and makes them vulnerable to noise. To address these limitations, we propose an unsupervised alignment framework called AMENA, which comprehensively models node structural information from local connections to high-order roles and adaptively integrates multiple node representations. Specifically, we first model node information from three complementary perspectives: attribute features, local structural features, and high-order role features. These features are fed into shared-weight GATv2 models to generate corresponding node embeddings. Additionally, we design an adaptive aggregation mechanism that estimates the reliability of each embedding according to the number of trusted pseudo-anchor pairs it produces, enabling the model to emphasize more reliable information sources across networks. Finally, an iterative refinement process is applied to further enhance alignment accuracy by improving matched neighborhood consistency. Extensive experiments on real-world and synthetic datasets demonstrate that AMENA outperforms state-of-the-art baselines and exhibits strong robustness under various challenging conditions.}
}
@article{CAI2026116715,
title = {Data-driven event-triggered consensus for unknown multi-agent systems: A scalable fully distributed protocol with noisy data},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116715},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116715},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014413},
author = {Youzhi Cai and Feng Li and Jing Wang and Sangmoon Lee},
keywords = {Data-driven control, Event-triggered mechanism, Fully distributed control, Multi-agent systems},
abstract = {Despite the widespread application of event-triggered control in multi-agent systems, its dependence on precise system models and global network information limits its practicality in the presence of unknown dynamics and communication constraints. This paper studies the consensus issue for continuous-time multi-agent systems with unknown dynamics and proposes a scalable fully distributed event-triggered protocol that uses only the local state information of each agent to ensure consensus among all agents from noisy data. To avoid continuous communication and online model identification, offline collected system operational data are used to directly estimate the dynamic evolution patterns, thereby predicting state changes during non-triggered intervals. Furthermore, a new algorithm is introduced to handle bounded noise interference during data collection, which maintains consensus while exhibiting robustness and scalability. Finally, the validation of the proposed approach is verified through simulations in the scenarios of noise-free, noisy conditions, and with the addition of extra agents.}
}
@article{MLAIKI2026116767,
title = {Spectral radius as a hallucination indicator: Mathematical foundations for AI reliability},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116767},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116767},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014930},
author = {Nabil Mlaiki},
keywords = {AI safety, Spectral radius, Hallucination detection, Large language models, Epistemic uncertainty, Self-consistent reasoning, Convergence analysis},
abstract = {We develop a mathematical framework for analyzing self-consistent reasoning in artificial intelligence systems using fixed point theory. We model the iterative self-refinement process by embedding discrete model outputs into a continuous semantic representation space, where the reasoning operator acts on sentence-level embeddings rather than on raw token logits. Within this formulation, we prove that iterative self-refinement converges exponentially to stable reasoning states when the spectral radius of the reasoning operator’s Jacobian is less than one. Furthermore, we establish a novel bound connecting the spectral radius to epistemic uncertainty and distance from ground truth. The spectral radius is estimated via finite differences applied to the embedding-space operator, using a fixed perturbation sample size of N=50 to approximate the Jacobian; this requires approximately N⋅K+K=60 forward passes through the refinement pipeline per query, which is comparable in cost to existing multi-sample uncertainty methods. We validate the framework on five benchmarks — TruthfulQA, HaluEval, GSM8K, StrategyQA, and MMLU — using open-weight models for which embedding access is available, and extend results to API-based models through a sentence-transformer surrogate embedding strategy. Our approach consistently outperforms entropy-based, self-consistency, and verbalized-confidence baselines, providing theoretical foundations for hallucination detection and confidence calibration in large language models.}
}
@article{KUMAR2026116710,
title = {Hybrid MobileNetV2-ViT architecture for multimodal emotion recognition on mobile devices with contextual sentiment fusion},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116710},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116710},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601436X},
author = {Akshay Kumar and Kavita Verma and Arun Kumar Rana and Ayodeji Olalekan Salau},
keywords = {Multimodal emotion recognition, MobileNetV2, Vision transformer, Contextual sentiment fusion, Tensorflow lite, Mobile AI, Gated attention fusion},
abstract = {Accurate real-time emotion recognition on resource-constrained mobile devices requires computationally efficient architectures capable of effectively integrating complementary visual and textual information. Conventional unimodal approaches based on facial-expression analysis or text-sentiment classification often suffer from ambiguity when distinguishing visually similar emotional states, such as neutral and suppressed sadness, thereby limiting their robustness in practical applications. To address this challenge, this study proposes a novel feature-level multimodal fusion framework that combines a MobileNetV2 convolutional backbone for global spatial modelling with a lightweight Vision Transformer (ViT) encoder, and a fine-tuned DistilBERT model for contextual sentiment. Unlike existing methods that predominantly perform multimodal integration at the decision level, the proposed architecture introduces a gated attention-based feature-level fusion mechanism that aligns visual and textual embeddings within a shared latent space, enabling richer cross-modal interactions and more discriminative emotion representations. The entire framework is optimized end-to-end using matched image-text pairs and evaluated on the FER2013, IEMOCAP, and MELD benchmark datasets. Experimental results demonstrate that the proposed model consistently outperforms state-of-the-art unimodal and multimodal baselines in terms of classification accuracy and F1-score under both within-dataset and cross-dataset evaluation settings. Furthermore, post-training INT8 quantization using TensorFlow Lite substantially reduces the model size while enabling low-latency inference on a mid-range Android smartphone with negligible degradation in predictive performance. Ablation studies further confirm the complementary contributions of the ViT module and the proposed feature-level gated fusion strategy. The findings demonstrate that the proposed architecture provides an effective and deployment-ready solution for emotion recognition, with promising applications in mental health monitoring, emotion-aware human-computer interaction (HCI), and behaviour analysis on mobile devices.}
}
@article{SINGH2026116731,
title = {Normatively guided graph diffusion for efficient and rational utility generation in bilateral bargaining},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116731},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116731},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014577},
author = {Moirangthem Tiken Singh and Surajit Borkotokey and Rajnish Kumar},
keywords = {Normative decision support, Graph Attention Networks, Diffusion generative models, Nash Bargaining Solution, Bilateral negotiation, Differentiable normative guidance},
abstract = {Autonomous AI agents operating in negotiation and resource-allocation environments must generate utility allocations that are individually rational, Pareto-efficient, and axiomatically fair, while remaining robust to the biased training data that characterizes real-world human negotiation corpora. Existing generative approaches reproduce empirical bargaining behavior without enforcing cooperative game-theoretic principles during inference, whereas classical optimization methods require exact analytical Pareto frontier specification unavailable for empirical data. This study introduces a normatively guided graph diffusion framework for efficient and individually rational utility generation in bilateral negotiation. Negotiation states are encoded by a Graph Attention Network (GATv2) conditioning a Denoising Diffusion Implicit Model (DDIM). A differentiable guidance mechanism penalizes Nash-product shortfalls and individual-rationality violations during a late-stage activation window, preserving generative diversity while enforcing axiomatic compliance. A theoretical approximation bound establishes how the activation window, guidance strength, and denoiser accuracy jointly control a worst-case distance from the Nash Bargaining Solution. Evaluation across a synthetic non-transferable utility corpus and two human negotiation datasets demonstrates that Nash Efficiency reaches 0.9913 with perfect individual-rationality compliance on the synthetic corpus, and improves from 0.9249 to 0.9921 on Deal-or-No-Deal. On CaSiNo, surplus recovery improves, though a geometric limitation of spherical frontier approximations on discrete allocation manifolds is identified and diagnosed mechanistically.}
}
@article{HAN2026116784,
title = {Data-centric deep learning for defect detection in fiber composite materials: A review of algorithms, challenges, and emerging trends},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116784},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116784},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015108},
author = {Juntao Han and Zidong Wang and Weibo Liu and Baoye Song and Chuang Wang and Xiaohui Liu},
keywords = {Fiber composite materials, Defect detection, Deep learning, Data-centric learning, Non-destructive testing, Structural health monitoring, Explainable artificial intelligence},
abstract = {Fiber composite materials (FCMs) have been widely used in high-performance engineering systems owing to their high strength-to-weight ratio, corrosion resistance, and excellent mechanical properties. Reliable defect detection is therefore essential for ensuring structural integrity, operational safety, and service-life extension. Deep learning (DL) has recently shown strong potential for automated FCMs defect detection by enabling powerful feature extraction, accurate localization, and robust representation learning from image data. Nevertheless, its performance remains highly dependent on sufficient, high-quality, and well-annotated training data, which are often difficult to obtain in practical detection scenarios. This paper presents a comprehensive review of image-based DL approaches for FCMs defect detection under different data conditions. Representative R-CNN-based, YOLO-based, and Transformer-based models are first reviewed for sufficient and high-quality data settings. DL-based denoising, data augmentation, and transfer learning strategies are then analyzed for limited or low-quality data settings, with emphasis on Autoencoders, Generative Adversarial Networks, Variational Autoencoders, Diffusion Models, and pretrained model adaptation. Key challenges and future directions are further discussed, including long-term structural health monitoring, physics-guided defect detection, explainable artificial intelligence, multimodal data fusion, and large language model-assisted detection. By organizing existing studies from a data-centric perspective, this review provides a structured reference for developing reliable, interpretable, and deployable DL-based defect detection systems for FCMs.}
}
@article{LIAO2026116707,
title = {Noise-aware temporal knowledge graph reasoning with query-guided learning and confidence-aware optimization},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116707},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116707},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014334},
author = {Longquan Liao and Linjiang Zheng and Jiaxing Shang and Xu Li and Jiang Zhong and Kaiwen Wei},
keywords = {Temporal knowledge graphs, Robust reasoning, Supervision noise, Historical noise, Confidence-aware},
abstract = {Temporal knowledge graph (TKG) reasoning has attracted increasing attention due to its ability to predict future events from historical interactions. However, practical TKGs are rarely clean and typically suffer from two complementary types of corruption. Historical noise refers to errors in past interactions, such as spurious links or misaligned timestamps, which distort the evidence available for reasoning. Supervision noise arises from inaccurate or inconsistent future facts used as training labels, which directly misguide model optimization. Most existing approaches primarily focus on historical noise while overlooking corrupted supervision and the relevance between historical information and queries. To address this gap, we propose QGTC-Net, a noise-aware reasoning framework that simultaneously mitigates both types of noise. The framework integrates two complementary components: a Query-Guided Learning Mechanism (QGLM) that selectively emphasizes query-relevant information and suppress irrelevant or misleading interactions, and a Confidence-Aware Optimization Mechanism (CAOM) that estimates supervision reliability by combining temporal consistency with structural plausibility and reweights the loss accordingly. The design is fully differentiable and scalable, avoiding the complexity of path enumeration. Extensive experiments on four benchmark datasets and their noisy variants demonstrate that QGTC-Net consistently outperforms strong baselines in both raw and corrupted settings, providing a general strategy for robust inference in noisy dynamic networks.}
}
@article{YUN2026116771,
title = {QueCo: Query-conditioned consensus over unverified evidence for training-free zero-shot anomaly detection},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116771},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116771},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014978},
author = {Eunsun Yun and Heechul Lim and Haeyun Lee and Kang-Wook Chon and Minjoong Jeong},
keywords = {Anomaly detection, Training-free, Zero-shot, Query-conditioned reference consensus},
abstract = {Accurate anomaly detection in industrial inspection and medical imaging is essential for product quality, clinical screening, and system reliability. Although recent methods have minimized their reliance on abnormal annotations, they still require target-domain training data, clean normal samples, or parameter updates. However, in real-world environments, such as new production lines or medical screening, verified normal samples are often unavailable, and the only data accessible at inference are unlabeled test datasets with unreliable normality. Therefore, we propose QueCo, a zero-shot anomaly detection framework that requires no training and infers reliable normal evidence directly from an unlabeled test dataset. QueCo constructs an unverified evidence bank (UEB) from unlabeled test samples, without assuming any clean subset. Rather than uniformly matching all test patches, it performs query-conditioned reference consensus (QRC) for each query. QRC validates candidate references through transport-guided cross-image correspondence, mutual-k-nearest-neighbor maximum similarity (Mutual-kNN MaxSim) filtering, and minimum-support aggregation, such that only structurally consistent and repeatedly observed evidence contributes to anomaly scoring. Feature-conditioned semantic prompts further complement structural consensus via query-adaptive text alignment using vision-language semantics without additional learning or learnable prompts. Without training, QueCo achieves 97.5% image-level AUROC and 96.8% pixel-level AUROC on MVTec AD while demonstrating robust performance across industrial benchmarks among both training-based and training-free methods.}
}
@article{CHENG2026116796,
title = {A causality based multi-task framework for enhancing image and text interactions},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116796},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116796},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015224},
author = {Zhaomeng Cheng and Zhong Ji and Yan Zhang},
keywords = {Multi-modal interaction, Multi-task modeling, Image and text recognition, Causality intervention},
abstract = {In certain tasks, such as sarcasm detection and humor recognition, the image–text pairs often exhibit challenging complementary or even contradictory relationships rather than common feature fusion or direct alignment. Distinguishing the interactions between these modalities is crucial for accurate domain prediction and could be enhanced by exploring causal features among text-only, image-only, or their combined modalities, as well as the discrimination of crucial modalities’ contributions. To address it, we define multiple tasks with different modalities and propose a multi-task framework from a new perspective of fine-grained causality. By simultaneously observing and comparing different labels across modalities, the model learns to attribute feature contributions to each modality in our design, thereby enhancing its discriminative capabilities. Unlike conventional methods of ensembling multiple tasks’ outputs with supplementary computational overhead, the proposed multi-task framework essentially employs a novel enhancement strategy with this design, facilitating streamlined end-to-end training and inference. For modalities lacking ground truth labels in the original dataset, we adopt an MLM (Multi-modal Large Model) assisted annotation strategy to ensure the implementation of our solution. Extensive experiments conducted on three typical datasets show the effectiveness of our proposed method. Particularly, our enhanced method leads to performance improvements across different models on various datasets. Furthermore, it can further boost the state-of-the-art performance, as demonstrated by a 3% accuracy improvement on the URFunny dataset.}
}
@article{HUANG2026116695,
title = {Heterogeneous graph neural network with multi-relational structure-aware hybrid filtering},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116695},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116695},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014218},
author = {Linmin Huang and Weihong Lin and Yuhong Chen and Chunming Wu and Ping Fan and Shiping Wang},
keywords = {Heterogeneous information network, Graph neural network, Graph filters, Graph signal processing, Semi-supervised classification},
abstract = {A heterogeneous graph is a powerful tool for modeling real-world systems composed of multiple types of entities and relations, inherently encoding rich semantic and structural information across diverse relational paths and presenting both new opportunities and challenges for graph representation learning. However, most existing heterogeneous graph neural networks either statically aggregate information along predefined meta-paths or oversimplify spectral filtering with low-pass operations, failing to adaptively capture multi-frequency signals and cross-relational interactions. To address the underutilization of multi-frequency signals and limited structural awareness in heterogeneous graph neural networks, this paper proposes a Multi-Relational Structure-Aware Hybrid Filtering (MRSHF) framework. MRSHF integrates low-pass and high-pass filters to jointly learn smooth features from homogeneous contexts and discriminative features from heterogeneous relationships. Additionally, MRSHF introduces an adaptive weight generation network that leverages local semantic similarity to dynamically determine fusion weights across multiple meta-path representations. This allows the model to better capture complex semantic interactions between different types of relations. Furthermore, through multi-hop neighbor aggregation and cross-layer feature concatenation, MRSHF enriches node representations by preserving both hierarchical and semantic diversity. Extensive experiments on four benchmark datasets verify the effectiveness of MRSHF. Under the 20% training sample setting, MRSHF achieves Macro-F1 scores of 93.81%, 93.27%, 52.61%, and 93.96% on ACM, DBLP, IMDB, and YELP, respectively. It obtains the best results on ACM, DBLP, and YELP, outperforming the strongest baseline by 1.82, 0.69, and 0.61 percentage points, respectively, while remaining competitive on IMDB. These results indicate that MRSHF is effective in low-label heterogeneous graph learning scenarios.}
}
@article{SHEN2026116747,
title = {Attend to you: Real-time personalized headline generation for visual posts in social media},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116747},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116747},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014735},
author = {Tongfei Shen and Sophia Yat Mei Lee and Junshuang Wu and Dong Zhang and Shoushan Li and Erik Cambria and Guodong Zhou},
keywords = {Personalization, Headline generation, Multi-modal, Evaluation, Social media},
abstract = {Recommending headlines tailored to users’ unique preferences significantly elevates their social media posting experience. This not only alleviates the frustration of struggling to craft compelling headlines but also helps organize their posting logics. However, previous works normally focus on summarizing and polishing static text posts that users have already finished, trying to come up with attractive or personalized headline recommendations. Put differently, they cannot generate personalized titles in real time, especially when they only have images from tweets to work with. Additionally, existing research lacks exploration into the role of users’ multimodal personalized information in headline generation. To address these gaps, we construct a comprehensive multimodal personalized dataset from RedNote for headline prediction and recommendation with users’ post history. Based on this dataset, we introduce a new task: Real-time Personalized Headlines Generation (RPHG) for visual posts, which focuses on generating preference-driven real-time headlines for RedNote posts before users draft their content. We also design two innovative metrics, RepQ-BLEU and FME-Score, to better assess personalization quality. Finally, we propose Phr, a multi-stage collaborative framework, which serves as a strong baseline for RPHG task. Extensive experiments demonstrate that the proposed metrics can effectively capture personalized headline quality within the RedNote context. Meanwhile, our proposed Phr significantly outperforms other baselines in the RPHG task for the platform.}
}
@article{LIU2026116687,
title = {TECL: Time-Equivariant Contrastive Learning for weakly-supervised Grounded Video Question Answering},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116687},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116687},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014139},
author = {Wenzhe Liu and Zhenfang Zhu and Qiang Lu and Shengtai Zhang and Liang Zhao and Dawei Zhao and Xinyu Jiang and Menglin Zhu and Yan Wang},
keywords = {Grounded Video Question Answering, Time-Equivariant Contrastive Learning, Weakly supervised grounding, Temporal equivariance},
abstract = {Grounded Video Question Answering (VideoQA) requires a model not only to answer a question about a video but also to identify the temporal segments that support the answer. In weakly supervised settings, precise temporal boundaries are unavailable, and models often rely on spurious temporal correlations, leading to biased or unfaithful grounding. To address this, we propose TECL, a Temporal Equivariance Contrastive Learning framework that encourages grounding predictions to shift consistently under small cyclic temporal rolling, effectively mitigating temporal shortcut learning. To further stabilize distribution-level supervision, we introduce a dense Gaussian grounding head with width regularization, which provides accurate temporal localization and discourages overly diffuse, shift-invariant distributions. Additionally, TECL incorporates cross-view contrastive alignment as an auxiliary objective to preserve semantic consistency across transformations. Experiments on NExT-GQA show that TECL improves grounded QA performance and temporal localization robustness under moderate perturbations, while additional results on STAR provide complementary evidence of its effectiveness on another grounded video reasoning benchmark.}
}
@article{ZHANG2026116739,
title = {Federated meta-learning with transformer fusion and adversarial training for few-shot multi-condition fault diagnosis},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116739},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116739},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014656},
author = {Jie Zhang and Yuqing Chang and Fuli Wang},
keywords = {Few-shot learning, Transformer-based feature fusion, Federated meta-learning, Adversarial training, Memory-augmented neural network},
abstract = {Fault diagnosis in multi-condition environments is challenging, especially with limited labeled data. This paper proposes a federated meta-learning framework with transformer-based feature fusion and adversarial training to address the few-shot multi-condition fault diagnosis problem. The framework enhances the extraction of discriminative fault features across different operating conditions by employing cross-attention mechanisms and feature fusion, thereby improving adaptability and generalization. Federated meta-learning enables decentralized learning while preserving data privacy, making it suitable for real-world industrial applications. Adversarial training further enhances robustness by promoting the learning of condition-invariant fault representations. A memory-augmented neural network classifier enables rapid adaptation to new fault types with minimal labeled data. The proposed framework is evaluated on the Tennessee Eastman process and gold hydrometallurgy process datasets. On the gold hydrometallurgy dataset, the proposed approach achieves 99.33% and 98.00% Accuracy for the 5-way 5-shot and 5-way 1-shot tasks, surpassing the strongest competing method among those evaluated by 7.00 and 10.33 percentage points, respectively. On the Tennessee Eastman dataset, it attains 77.33% and 70.00% Accuracy under the same experimental settings, outperforming the best comparative method in our experiments by 14.00 and 10.67 percentage points, respectively. These results indicate the consistent and significant superiority of the present solution in multi-condition few-shot fault diagnosis scenarios.}
}
@article{CAO2026116683,
title = {CTG-MARL: Cooperative Transformer Graph Reinforcement Learning with Adaptive Policy Modularization},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116683},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116683},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014097},
author = {Yukang Cao and Quan Liu and Hongzhe Liu and Renyang You},
keywords = {Multi-agent reinforcement learning, Causally masked transformer graph, Adaptive Policy Modularization, Temporal causal modeling, Multi-agent coordination},
abstract = {Cooperative Multi-Agent Reinforcement Learning (CMARL) has shown great potential in solving complex distributed decision-making problems. However, existing approaches often suffer from insufficient representational capacity and limited interpretability of cooperative behaviors, making it difficult to model dynamic inter-agent dependencies and causal relationships. To address these challenges, this paper proposes CTG-MARL, a novel temporally causal attention graph-based Transformer framework with Adaptive Policy Modularization (APM) for scalable and interpretable cooperation. The Cooperative Transformer Graph (CTG) models agents as nodes and their interactions as directed edges in a causal structure, where causal masking enforces temporal admissibility by preventing information leakage from future timesteps. This design enables each agent to infer both temporally directed influence and contextual relevance among its peers, facilitating more robust representation learning under partial observability. The Adaptive Policy Modularization (APM) module further decomposes each agent’s global policy into multiple functionally interpretable sub-policies, which are adaptively weighted and combined to form a unified action distribution. This modular decomposition enhances role flexibility, policy transferability, and cooperative interpretability, allowing agents to dynamically adjust coordination strategies across heterogeneous environments. Comprehensive experiments on StarCraft Multi-Agent Challenge (SMAC), Level-Based Foraging (LBF), and Google Research Football (GRFootball) validate the effectiveness of CTG-MARL. The proposed framework consistently outperforms state-of-the-art baselines in coordination efficiency, convergence stability, and generalization ability. In SMAC tasks, CTG-MARL achieves a 94.5% average win rate, demonstrating its strong scalability and causal consistency in cooperative multi-agent systems.}
}
@article{FAN2026116711,
title = {Knowledge-guided polygon vertex learning with Vision Transformer for tumor target delineation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116711},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116711},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014371},
author = {Yizhan Fan and Xiren Zhou and Ao Chen and Huanhuan Chen and Zhenchao Tao},
keywords = {Knowledge-guided segmentation, Tumor target delineation, Polygonal contour representation, Radiation therapy planning},
abstract = {Precise delineation of tumor target volumes in radiation therapy is a knowledge-intensive clinical task governed by three formally characterizable knowledge types: declarative geometric priors encoding anatomically plausible contour constraints, structural relational knowledge capturing rotational symmetry in polygon vertex sequences, and procedural tolerance knowledge defining clinically acceptable boundary deviations. Existing pixel-level segmentation methods discard this knowledge entirely, producing topologically inconsistent masks that require costly manual correction. We propose a knowledge-guided framework that explicitly encodes all three knowledge forms into both model architecture and training supervision. Specifically, (1) a Vision Transformer encoder captures global spatial knowledge via self-attention, transcending the locality limitations of convolutional kernels; (2) Rotary Positional Encoding embeds the rotational symmetry knowledge inherent in polygon vertex sequences, capturing a structural prior that standard absolute encodings fundamentally cannot represent; and (3) the proposed Convolutional Smoothing Loss operationalizes clinical positional tolerance knowledge by assigning spatially graded supervision signals, distinguishing catastrophic boundary violations from clinically acceptable minor deviations. Evaluated on the MSD Pancreas Tumour dataset and a proprietary cervical cancer CT dataset, the proposed model consistently outperforms CNN-based and Transformer-based baselines across all metrics. Ablation studies and robustness analysis under Gaussian noise confirm the independent contribution of each knowledge-encoding component.}
}
@article{BAE2026116788,
title = {Drift-Aware causal transformer for slag iron prediction in nickel laterite smelting under evolving manufacturing conditions},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116788},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116788},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015145},
author = {Jae Kwon Bae and Jehyeung Yoo},
keywords = {Process drift, Drift detection, Causal transformer, MC-dropout, Nickel laterite smelting},
abstract = {Industrial smelting processes operate under continuously evolving raw materials, equipment conditions, and control policies, inducing process drift that degrades data-driven prediction models. This challenge is acute in rotary kiln–electric furnace (RK-EF) nickel laterite smelting, where temporal lag and operational constraints limit conventional adaptation methods. This paper proposes a drift-aware prediction framework built on a causally masked Transformer for slag total iron prediction in an RK-EF process. The framework integrates lag-aware guarded temporal segmentation, drift-informed staged post-deployment adaptation, and uncertainty-aware inference with conservative robustness controls. Experiments on real plant data show that a model pretrained on earlier operating data degrades substantially under later drifted conditions, whereas the proposed framework substantially restores the average predictive performance over the post-drift evaluation window without full retraining, although per-sub-window analysis shows that performance deteriorates in later sub-windows as additional drift accumulates. Ablation results indicate that lightweight post-deployment supervised updating accounts for most of the recovery, while MC-dropout inference serves mainly as a robustness-oriented stabilization mechanism and auxiliary stacking is activated only under strict validation gating; multi-seed runs are used for variance reporting rather than ensemble averaging. Sustaining the restored performance over longer deployment horizons may require periodic re-adaptation triggered by streaming drift detection, which is left to future streaming experiments.}
}
@article{XIE2026116703,
title = {Novel tensor sparsity-induced hyperspectral image completion, denoising and destriping},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116703},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116703},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014292},
author = {Mengying Xie and Xiaowei Yang and Xiaolan Liu and Fulin Luo},
keywords = {Hyperspectral image, Completion, Denoising and destriping, Decoupled stripe removal, Double-compact low-rank HSI estimation},
abstract = {Hyperspectral image (HSI) contains massive spatial and spectral information about the earth. For the widespread presence of Gaussian noise, sparse noise, stripe noise and missing values, HSI completion, denoising and destriping (HCDD) has urgent practical needs. To construct a tractable optimization paradigm, previous works commonly assume that the stripe noise is sparsely distributed, and then reduce the HCDD problem into the HSI completion and denoising (HCD) problem. However, when the density of the stripe noise is strong enough, these works cannot completely remove the stripe noise. To address this issue, we propose a novel tensor sparsity-induced HCDD method TS-HCDD. In TS-HCDD, tensor learning (TL) mines the high-order correlations of spatial–spectral modes. Firstly, TS-HCDD utilizes the universal TL-based HCD model as the fundamental model, which achieves completion and denoising. Secondly, decoupled stripe removal is proposed to separate the learnable stripe noise and reveal its characteristics, which achieves destriping. Lastly, double-compact low-rank HSI estimation is proposed to enhance the low-rank signal of clean HSI and its representation, which further strengthens the collaboration performances of completion, denoising and destriping. Extensive experimental results on various HSIs with several scenarios demonstrate the superiority of TS-HCDD.}
}
@article{SHI2026116699,
title = {ACHT-Net: Adaptive Channel soft-partitioning with Heterogeneous Temporal modeling for multivariate time series forecasting},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116699},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116699},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014255},
author = {Chenhao Shi and Chun Zhang and Guozhen Zhang and Wenhao Zhang and Ning Zhang and Changxia Gao and Shaoxiong Pang and Ke Xiong},
keywords = {Multivariate time series forecasting, Adaptive channel soft-partitioning, Heterogeneous temporal modeling, Dual-decoupling architecture},
abstract = {Multivariate time series forecasting (MTSF) is essential for applications such as grid scheduling, traffic optimization, and financial analysis. However, accurate forecasting remains challenging because temporal patterns are heterogeneous, inter-channel dependency modeling is prone to noise interference, and temporal and channel modeling are often tightly coupled. To address these challenges, we propose Adaptive Channel soft-partitioning with Heterogeneous Temporal modeling (ACHT-Net), a dual-decoupling forecasting architecture that separates temporal modeling from channel modeling and further decouples channel dependency estimation from feature fusion. On the temporal side, ACHT-Net uses a Heterogeneous Dual-Stream Extractor, combining an MLP for trend modeling with a gated linear–nonlinear mixture-of-experts extractor for seasonal modeling. On the channel side, an adaptive channel soft-partitioning strategy estimates input-dependent, non-exclusive sparse channel masks to select informative cross-channel interactions before feature fusion. Extensive experiments on ten real-world datasets demonstrate that ACHT-Net achieves the best overall forecasting performance compared with nine baselines.}
}
@article{YANG2026116751,
title = {AlCo: Efficient event-based object detection via Semantic-Geometry Alignment and Hierarchical Semantic Compensation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116751},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116751},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014772},
author = {Shu Yang and Jizhuang Guo and Keyao Wang and Wenzheng Yang},
keywords = {Event, Object detection, Sparse convolution, Transformer},
abstract = {Event cameras have emerged as a promising sensor for object detection in high-speed and high-dynamic-range scenarios. However, existing methods often struggle with the inherent spatiotemporal sparsity and noise of event data. In this paper, we propose a novel framework AlCo that integrates a Semantic-Geometry Alignment Convolution (SGAC) and a Hierarchical Semantic Compensation (HSC) block. SGAC explicitly models geometric priors and semantic alignment to suppress noise and enhance structural consistency in early-stage features. The HSC block further employs a dual-branch strategy: a sparse branch with prototype-guided token selection and diversity-aware recycling to maintain efficiency, and a global branch to compensate for long-range contextual information. Extensive experiments on the Gen1 and 1Mpx datasets demonstrate that our method achieves state-of-the-art performance while providing favorable FLOPs, latency, and memory trade-offs.}
}
@article{LI2026116800,
title = {Conditional diffusion for causal inference with state space representation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116800},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116800},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015261},
author = {Yanmin Li and Xiangyu Wang and Weidong Bao and Jibing Wu and Hang Zhang and Huanhuan Chen and Lihua Liu},
keywords = {Causal inference, Potential outcome prediction, State space model, Conditional diffusion, Distributional estimation},
abstract = {Causal inference from observational data, particularly for estimating individual-level effects, is vital in high-stakes domains such as healthcare and economics. Many established approaches to potential outcome prediction provide a single estimate under each treatment, which does not describe outcome variability or distributional heterogeneity across individuals. Recent generative approaches have moved beyond such point estimates by estimating conditional potential outcome distributions, but effectively incorporating structural and temporal dependencies among observational covariates remains a key challenge. To address these gaps, we propose CoDiS, a conditional diffusion framework for estimating potential outcome distributions through a structure-aware state space denoising architecture. Specifically, CoDiS jointly processes the covariate-treatment condition, the noisy outcome state, and diffusion timestep with an SSM-based backbone during reverse denoising. This design allows the reverse denoising process to exploit latent dependencies among observational variables, thereby improving the potential outcome distribution generation. Extensive evaluations on a COVID-19 dataset and standard causal benchmarks demonstrate the effectiveness of CoDiS in both distributional and point estimation. The code is available at https://github.com/JustinLiam/CoDiS.}
}
@article{ZHOU2026116743,
title = {When VFMs ignore anatomy: Adversarial structural enforcement for Single-Source Domain Generalization},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116743},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116743},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014693},
author = {Yinchen Zhou and Wenjun Yu and Jia-Xuan Jiang and Shubin Zeng and Yuee Li and Zhong Wang},
keywords = {SinglE-Source Domain Generalization, Medical image segmentation, Semantic aggregation, Adversarial structural enforcement, Vision Foundation Model},
abstract = {Single-Source Domain generalization (SDG) is widely used in medical image segmentation to improve model robustness on unseen domains when only a single-source dataset is available. Vision Foundation Models (VFMs) offer strong prior knowledge and inherent structure awareness; however, the full potential of these advantages has yet to be realized in current SDG approaches. Methods that employ the integration of data augmentation with VFMs or the integration of feature disentanglement with VFMs cannot effectively enforce anatomy-aware representation learning, resulting in limited robustness under domain shifts. To overcome this limitation, we shift from data-centric strategies to a model-centric design and propose an adversarial, structure-aware framework. Through a coordinated multi-module adversarial process, the framework injects style perturbations while strengthening the representation of key anatomical structures, achieving effective content–style decoupling. We further introduce an anatomy-guided consistency constraint to maintain structural stability in critical regions during adversarial perturbation, ensuring semantic reliability and robust cross-domain structural modeling. Experiments on two challenging cross-domain fundus segmentation benchmarks show that our method achieves state-of-the-art performance and consistently surpasses existing approaches, demonstrating its effectiveness in learning stable anatomical representations under the single-source setting. Our code is available at here.}
}
@article{ZHOU2026116756,
title = {DHA-Fed: Dual-stage hierarchical alignment for domain-agnostic federated medical image classification},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116756},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116756},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014826},
author = {Zhiyong Zhou and Wei Wang and Xusheng Qian and Jisu Hu and Chongzhe Yan and Chen Geng and Junkang Shen and Ximing Wang and Minjiang Chen and Yakang Dai},
keywords = {Federated learning, Image classification, Domain generalization, Hierarchical alignment},
abstract = {Federated learning (FL) has emerged as a pivotal paradigm for medical image classification in multi-client healthcare applications by enabling collaborative training without sharing raw data. However, its practical deployment remains challenged by negative transfer caused by heterogeneous client distributions and privacy risks introduced by data-sharing-based domain generalization strategies. Existing approaches, including federated model distillation and data-driven domain generalization methods, either lack explicit mechanisms to alleviate inter-client discrepancies or rely on additional information sharing that may compromise privacy. To address these challenges, we propose a Dual-stage Hierarchical Alignment Federated Network (DHA-Fed), which establishes a principled alignment framework from feature-level to prototype-level. In the first stage, a Local-Interim Model Synergistic Feature-Level Alignment strategy (LMSFA) and an interim model mechanism are introduced to explicitly reduce representation discrepancies across clients, thereby mitigating negative transfer. A Bidirectional Divergence loss is further designed to enforce consistent feature alignment while preserving discriminative capability. In the second stage, a Prototype Relaxation Strategy (PRS) is proposed to relax the model's error bound on unseen domains and foster domain-agnostic feature manifolds through prototype contrastive minimization. Extensive experiments on two real-world clinical tasks, including breast cancer and prostate cancer classification, demonstrate that DHA-Fed consistently outperforms state-of-the-art federated learning and domain generalization methods under heterogeneous and privacy-constrained settings.}
}
@article{SUN2026116732,
title = {A plug-and-play repair approach for addressing data missingness in human motion prediction},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116732},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116732},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014589},
author = {Yan Sun and Tenghao Deng and Hang Yu},
keywords = {Skeleton completion, Human motion prediction, Deep learning},
abstract = {Facing the challenge of missing data, existing human motion prediction technologies often fail. This paper introduces a plug-and-play repair module designed to enhance the performance of existing prediction models under data loss conditions without altering their structure. Firstly, we developed a Positional Memory Bank, which learns an optimized initial value for each joint based on different motion sequences, thereby improving the accuracy of the reconstruction. Secondly, we implemented a two-stage repair process: initially, we transmit only the information between visible joints to reduce the misleading effects of missing joint features, followed by global feature propagation. We redesigned the prediction model according to the repair module’s design philosophy to provide more accurate predictions even with complete data. Experiment results on public datasets Human3.6M and CMU MoCap demonstrate the superior performance of our module in handling scenarios with missing data, achieving excellent performance in both missing and complete data contexts.}
}
@article{CHEN2026116708,
title = {Online adaptive cost-sensitive multi-label learning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116708},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116708},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014346},
author = {Yingying Chen and Xiaowei Yang},
keywords = {Online multi-label learning, Cost-sensitive learning, Class imbalance, Adaptive kernel learning, Random Fourier features},
abstract = {Multi-label classification is a fundamental problem in machine learning, data mining, and pattern recognition. In large-scale and streaming scenarios, traditional batch methods often become computationally prohibitive since the model must be repeatedly retrained as new data arrive. Moreover, online multi-label learning is further challenged by label imbalance, nonlinear decision boundaries, and threshold calibration. To address these issues, an Online Adaptive Cost-Sensitive Multi-Label Learning (OACS-MLL) framework is proposed. The proposed framework integrates adaptive cost-sensitive learning, threshold-based online prediction, and scalable nonlinear representation within a unified online model. First, an adaptive cost-sensitive weighting mechanism is designed according to online estimates of label rarity and instantaneous prediction difficulty, so that rare labels and hard sample-label pairs receive greater attention during model updates. Second, an adaptive kernel learning scheme based on random Fourier features is developed to capture nonlinear structures efficiently by updating the Fourier-frequency matrix online. Third, a multi-kernel extension, termed OACS-MLL-MK, is further developed to combine multiple bandwidths and enhance representation flexibility. Theoretical analysis provides a conditional regret bound for the convex classifier and threshold parameter blocks under the realized adaptive feature sequence, together with a controlled-drift characterization of the adaptive kernel representation. Experiments on multiple benchmark datasets demonstrate that the proposed methods achieve strong overall Macro-F1 and label-group Macro-F1 compared with representative online multi-label baselines. The single-kernel OACS-MLL provides a favorable trade-off between predictive performance and runtime efficiency, while the multi-kernel extension further improves Macro-F1 performance with additional computational cost.}
}
@article{PENG2026116760,
title = {A user reputation incentive mechanism based on reinforcement learning in smart tourism},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116760},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116760},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014863},
author = {Zhenlong Peng and Youlan Huang and Jianbing Xiahou and Enhui Wu and Huoquan Chen},
keywords = {Tourism crowdsensing, Incentive mechanism, Reinforcement learning, User reputation},
abstract = {This research presents an incentive mechanism grounded in deep reinforcement learning (DRL) and dynamic user reputation to tackle the issues of low user participation and subpar data quality in smart tourism crowdsourcing. It establishes a multidimensional state space (encompassing user reputation, task characteristics, and platform budget) and a compound action space to facilitate adaptive incentive decision making. A reputation decay factor is employed to encourage continuous and high quality contributions. The framework utilizes MOMAML-PPO and SARSA with prioritized experience replay. The results indicate that, compared with random or myopic strategies, there is a 62% increase in user participation and a 25 - percentage point rise in high - quality evaluations. In personalized scenarios (such as food recommendation), its interest aware strategy enhances the return on investment (ROI) by 24% compared to the greedy strategy. It outperforms fixed reward models and standard reinforcement learning (RL) in terms of dynamic adaptability and stability. The Expected Sarsa algorithm achieves a 23.7% budget savings while retaining 91.2% of high value users. This solution can be extended to other quality sensitive crowdsourcing scenarios in smart tourism.}
}
@article{SUN2026116736,
title = {LGPose: Language-guided unseen object 6D pose estimation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116736},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116736},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014620},
author = {Shantong Sun and Xu Bao and Yang Wang and Pan Gong and Unsang Park},
keywords = {Object 6D pose estimation, Vision-language models, Prompt guide, Feature refinement},
abstract = {Unseen object 6D pose estimation is one of the challenging problems in the field of computer vision. The Vision-Language Models (VLMs) extend the detector from unseen categories to seen categories through open vocabulary learning, which provides a new idea for unseen object pose estimation. However, the effective integration of six degrees of freedom information of objects with a vision language model remains an unresolved issue. In this work we present LGPose, a vision-language fusion network for unseen object 6D pose estimation. We incorporate information such as object position and orientation into the prompts to guide object segmentation and object pose estimation. In order to correlate the pose information between images and text, we adopt Transformer to extract image features and fuse the position embeddings of image patches with the text pose information. This helps to deeply integrate vision features with language features. Furthermore, inspired by motion estimation in the field of video compression, we propose a feature refinement model for pose perception, which can extract features that are beneficial for object pose estimation. Through comprehensive qualitative and quantitative experiments on two popular object pose estimation datasets, REAL275 and Toyota-Light, we demonstrate that LGPose outperforms recent unseen object 6D pose estimation approaches.}
}
@article{GRECO2026116679,
title = {STEP-FACE: Sequential TExtual–Visual Prompting for multi-task face analysis},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116679},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116679},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601405X},
author = {Antonio Greco and Camilla Spingola and Mario Vento},
keywords = {Multi-task face analysis, Vision–language models, Parameter efficient knowledge adaptation},
abstract = {Jointly analyzing stable facial attributes (gender, age) and transient affect (emotion) is a useful functionality for applications such as adaptive human–computer interaction, wellbeing screening and security. However, the design of such a solution remains challenging due to data scarcity, label imbalance, missing annotations and task interference in multi-task learning. In this paper, we propose STEP-FACE, a parameter-efficient framework that adapts a Vision–Language Model (VLM) to simultaneous gender, emotion and age recognition. It is based on Sequential TExtual–visual Prompting (STEP), the proposed parameter-efficient procedure which first learns task-specific textual prompts and then uses them to optimize visual prompts, injecting relevant cues for face analysis into the visual encoder. The inference is performed with the visual branch only, reducing memory and latency with respect to standard VLMs. The multi-task learning procedure designed for STEP-FACE further enforces task-representative batching, dealing with missing labels, balancing the task-specific losses and treating age estimation as a classification problem by adopting an ordinal-ranking formulation. The effectiveness of the proposed solution is confirmed by the experimental results obtained on widely used face analysis benchmarks: STEP-FACE achieves state-of-the-art or competitive performance, with 97.8% and 98.3% accuracy for gender recognition on FairFace and VGGFace2, 86.1% for emotion recognition on RAF-DB, and 63.8% and 63.5% for age classification on FairFace and UTKFace, while consistently improving over the considered baselines and remaining competitive with existing single-task and multi-task solutions in a parameter-efficient multi-task VLM setting.}
}
@article{LIN2026116700,
title = {Interformer: Interpretable large time series model for concept drift adaptation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116700},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116700},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014267},
author = {Borong Lin and Nanlin Jin and Xiaohui Zhu and Floriana Grasso},
keywords = {Concept drift, Forecasting Interpretability, Time series forecasting},
abstract = {Drift detection to identify the changes in streaming data distributions remains a critical challenge for time series forecasting. Many of the existing drift detection methods lack interpretable adaptation. This paper proposes Interpretable Transformer(Interformer) for large time series models (LTSM) specifically designed to handle concept drift while providing interpretability. Interformer introduces a pretrain-finetune architecture, transferring universal representations from the Unified Time Series Dataset (UTSD) to forecasting tasks, thereby preserving robustness against the four types of drifts, namely abrupt, gradual, recurrent, and sudden. One of the Interformer components, the Interpretable Encoder (Intercoder), decomposes input signals into seasonality, trend, and residual components via Fourier series and polynomial functions. It explicitly isolates explainable patterns while adaptively filtering uninterpretable noise to the decoder. The decoder then forecasts the residual component by integrating historical residuals, through cross-attention, and horizon-specific residuals through self-attention. Compared to several state-of-the-art baselines, Interformer reduces the average mean squared error (MSE) by 10.44% relative to the best competing LTSM model. Furthermore, we systematically quantify performance across varying pretraining scales and noise levels. Under four types of concept drifts, the Intercoder achieves consistently lower Mean Absolute Percentage Error (MAPE) than a comparable alternative, demonstrating superior noise robustness and stability.}
}
@article{WU2026116748,
title = {Attack-agnostic robust decentralized federated learning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116748},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116748},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014747},
author = {Jiafei Wu and Puning Zhao and Hao Guo and Li Zhou and Chao Li and Haoyi Yuan and Chunhua Su and Lu Zhou},
keywords = {Decentralized federated learning, Robust aggregation, Byzantine attacks, Realistic corruption},
abstract = {Federated learning (FL) systems are vulnerable to poisoning attacks, and numerous defenses have been developed for server-assisted FL. Byzantine robustness in decentralized FL (DFL), however, has received comparatively less attention. Without a central server that can inspect and filter client updates, each DFL client must defend its local aggregation against potentially malicious neighbors without incurring excessive communication overhead. We propose an iterative filtering approach for poisoning-resistant DFL. At each filtering step, the method computes the geometric median of the gradients received from neighboring clients and removes gradients whose distances from the median exceed a prescribed threshold. This procedure is repeated until the retained set stabilizes, after which the remaining gradients are averaged. The filter is attack-agnostic in the operational sense that it does not assume a particular attack distribution or construction. Its worst-case theoretical guarantee requires a certified upper bound on each honest client’s local Byzantine fraction that is strictly below one half. Experiments on MNIST and CIFAR-10 under five attacks show that the proposed method achieves the lowest or comparable-lowest maximum test error rate in the evaluated configurations.}
}
@article{ALTAY2026116716,
title = {Response inertia in sequential detection: A policy-level framework for selective temporal adaptation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116716},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116716},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014425},
author = {Aykut T. Altay},
keywords = {Sequential detection, Detection delay, Response inertia, Temporal adaptation, Stability–responsiveness trade-off, Intelligent monitoring systems},
abstract = {Sequential detection systems often respond late not only because post-onset evidence is weak, but also because stability-oriented operating logic remains overly conservative after an event begins to emerge. We formalize this policy-induced component of post-onset delay as response inertia and develop a policy-level framework for analyzing and mitigating it in sequential detection. Within this framework, responsiveness is quantified through detection delay, while stability is characterized through false-alarm behavior, switching activity, and decision volatility. Using an effective decision-barrier perspective, we show that selective temporal adaptation cannot worsen expected detection delay relative to a matched static conservative policy and yields strict improvement when trigger activation overlaps the decision-sensitive region. The empirical study on synthetic data, the Numenta Anomaly Benchmark, and the Yahoo Webscope benchmark shows that the proposed adaptive policy improves the delay–stability trade-off by reducing false-alarm onsets and switching activity relative to high-coverage static and ablation baselines while preserving competitive responsiveness.}
}
@article{YANG2026116805,
title = {Auto-FSDformer: Searching for fully spike-driven transformer},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116805},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116805},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015315},
author = {An Yang and Ying Liu},
keywords = {Spiking neural network, Spiking transformer, Zero-shot neural architecture search},
abstract = {Spiking Neural Networks (SNNs), which enable low-power, spike-driven computation through bio-inspired spiking neurons, have attracted significant attention recently. Transformer-based SNNs, often referred to as spiking transformers, have also been proposed, in which various spike-driven self-attention (SDSA) mechanisms have been exploited to alleviate the heavy computational burden associated with standard self-attention. However, some spiking transformers still retain some traditional ANN-inspired designs that cannot operate in a fully spike-driven manner within SNNs, thereby failing to fully exploit the energy efficiency of SNNs. Considering this, we propose a zero-shot Neural Architecture Search (NAS) method, named Auto-FSDformer, to automatically design optimal fully spike-driven transformer architectures. Specifically, we design a novel spike-driven transformer search space that incorporates searchable SDSA mechanisms. To facilitate effective and efficient search within this challenging search space, we then propose a robust, training-free NASWOT-LTD proxy that leverages activation pattern diversity to represent model performance. In this proxy, we introduce a Layer and weighted Temporal Decoupling (LTD) rule to highlight the non-equivalence of activation patterns across different layers and time steps. We conduct comprehensive experiments on both static and neuromorphic classification datasets. The searched FSDformer models achieve competitive performance compared to state-of-the-art spiking transformers.}
}
@article{JAROMIN2026116712,
title = {Data augmentation through angular–radial segmentation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116712},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116712},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014383},
author = {Jakub Jaromin and Marcin Woźniak},
keywords = {Data augmentation, Radial segmentation},
abstract = {This study presents a data augmentation method based on angular–radial segmentation, which enables a balanced expansion of the point set while preserving the original spatial distribution. The procedure first involves determining the centroid of the set and shifting all observations. Next, the sample farthest from the origin is identified for the determination of a maximum base radius that will define the radius of the first segment computed in the subsequent step. The entire set is divided into circular segments with an angular width of α and radius Ri which represents the distance of the farthest point within the ith segment from the origin. Within each segment subsections are defined in such way that each has an equal area within the ith segment. Once the areas have been determined, new points are distributed proportionally to the number of existing points in each subsection randomly in boundaries designated by each subsection. This ensures that the augmentation of new points is carried out in a manner consistent with the density of the respective subsections relative to the entire original set.}
}
@article{USMAN2026116781,
title = {SWARM: A novel Sample Weighting Approach for Rare Minority data classification in imbalanced and evolving data streams},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116781},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116781},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015078},
author = {Muhammad Usman and Muhammad Usman},
keywords = {Data streams, Class imbalance, Rare minority data, Concept drifts, Ensemble learning},
abstract = {The joint occurrence of class imbalance and concept drift in streaming data creates a challenging learning problem for classification algorithms. Rare minority instances, which are scattered in the deep majority spaces and reside far away from dense minority areas, make learning more difficult in such scenarios. This paper proposes SWARM, a Sample Weighting Approach for Rare Minority data classification in imbalanced and drifting streams. The proposed method presents a novel instance weighting and resampling technique, WIRE (Weighted Instance Resampling Engine), that leverages misclassification cost for hard-to-learn minority instances, uses neighborhood analysis to guide a weighting policy that emphasizes rare minority data, and integrates a decay factor to make weights adaptable to the dynamic nature of data streams. It also employs a resampling strategy considering intra-class rarity and majority data to generate balanced training data batches. The ensemble pool is maintained and pruned under the R3D Ensemble component that adaptively manages the classifiers and prunes the pool through a multi-objective optimization method based on classifier diversities and weighted-recall performance. The experiments are performed on 57 data streams characterized by class imbalance, rare minority instances, and concept drifts. The comparative analysis against 10 state-of-the-art methods demonstrates the superiority of the proposed method, particularly in boosting recall performance and achieving higher G-Mean scores.}
}
@article{CZAPLEWSKI2026116789,
title = {Synthesis of free-form antenna geometries for target frequency sub-bands via a conditional variational autoencoder with feature-wise linear modulation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116789},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116789},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015157},
author = {Bartosz Czaplewski and Adrian Bekasiewicz},
keywords = {Machine learning, Conditional variational autoencoder, Neural networks, Feature-wise linear modulation, Automated antenna design},
abstract = {Development of free-form antennas remains a challenging and time-consuming task that involves exploration of large design spaces based on numerically expensive electromagnetic (EM) simulations. This paper presents an automated machine-learning framework for generation of complex free-form planar antennas conditioned on user-specified operating frequency sub-bands. The proposed method transforms the frequency-band requirements into antenna geometries through an end-to-end design pipeline combining generative and predictive models. The framework employs a conditional variational autoencoder (CVAE) to generate topologies based on four latent-space sampling strategies: prior and posterior sampling, as well as linear and convex interpolation. The candidate designs are then evaluated using auxiliary models that include identification and classification by multi-layer perceptron (MLP) networks and CNN-based estimation of the reflection responses. With the average time expenditure for generating acceptable candidate of 0.3 s, the proposed framework offers roughly 200-fold lower cost of screening the design candidates compared to EM simulations. Furthermore, the model maintains a macro-average accuracy and F1 score of 0.953 and 0.776, respectively. Numerical experiments demonstrate that the tool successfully generates antenna candidates that fulfill the desired performance requirements. The results demonstrate its potential for rapid pre-selection of promising antenna topologies for dedicated to subsequent EM-driven optimization while not relying on expert knowledge or expensive EM simulations.}
}
@article{YANG2026116728,
title = {Knowledge adapting and soft retrieval: Leveraging large language models for uncertain knowledge graph reasoning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116728},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116728},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014541},
author = {Yunxiao Yang and Jianting Chen and Xiaoying Gao and Zaiyuan Di and Yang Xiang},
keywords = {Uncertain knowledge graph, Knowledge graph reasoning, Large language model},
abstract = {Knowledge graphs often encounter trustworthiness issues due to the existence of knowledge obtained through empirical induction or incomplete observation. Uncertain knowledge graphs (UKGs) address this issue by quantifying the trustworthiness of triples through confidence scores. The utility of UKGs relies on uncertain knowledge graph reasoning (UKGR), which serves as a critical mechanism to predict incomplete facts and estimate uncertain degrees. Current UKGR methods often focus on structural modeling of UKGs, while neglecting the comprehensive understanding of the underlying uncertainty semantics. Recently, large language models (LLMs) have exhibited significant semantic understanding capabilities, offering potential for reasoning in uncertain domains. However, they still face challenges in adapting to KG tasks, such as limited integration of KG structural information and unmatched outputs. We propose KASR, an LLM-driven framework for UKGR. It introduces a knowledge adapting strategy which constructs special knowledge tokens to seamlessly integrate structural information in KGs into LLMs and obtains their embeddings in the LLM’s internal space. Furthermore, we restrict the LLM’s decoding space to align with the specific output scope required for UKGR tasks. During inference, we develop a two-stage approach with soft retrieval for the link prediction task within UKGR. It enhances inference efficiency and mitigates the influence of suboptimal candidates by filtering candidate entity sets and integrating retriever scores. Experimental results demonstrate the effectiveness and transferability of our method in UKGR, achieving over a 1.90% improvement in MRR metric while also maintaining superior efficiency.}
}
@article{LI2026116793,
title = {DyRSNet-Lite: Lightweight dynamic multi-scale network for remote sensing object detection},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116793},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116793},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015194},
author = {Zhiyu Li and Shidong Wang and Shi He and Hebing Zhang and Menglin Liu},
keywords = {Object detection, Remote sensing, Dynamic feature processing, Lightweight design},
abstract = {Remote sensing object detection plays a crucial role in land resource monitoring, urban planning, and environmental protection. However, the detection process is often hindered by significant scale variations, complex background interference, and a surge in parameters resulting from high resolution inputs. These factors pose challenges for existing algorithms to balance accuracy and efficiency on lightweight edge devices. To effectively address these issues, the DyRSNet-Lite, an end-to-end lightweight dynamic multi-scale remote sensing object detection network, is proposed. First, a symmetric sampling flow structure is constructed to transition from static compression to dynamic recovery. Within this structure, the ADown hierarchical compression downsampling preserves subtle features, and offset adaptive upsampling restores details, enabling the network to adapt to extreme scale differences. Second, the DyRSFusion dynamic multi-scale feature fusion module is designed to achieve adaptive feature selection via large kernel convolutional sequences and a dynamic spatial kernel selection mechanism. This module significantly enhances context capture and detail retention in complex environments. Furthermore, the SPPF-Lite lightweight feature pyramid module is developed to maintain large-scale sensitivity while significantly reducing computational complexity through depthwise separable convolutions and multi-level max pooling with decreasing kernel sizes. Extensive experiments conducted on the DOTAv1.0, DIOR, and VisDrone datasets demonstrate that DyRSNet-Lite accurately detects multi-scale objects in complex backgrounds. With 1.90M parameters and 5.7 GFLOPs, the proposed network significantly outperforms current state-of-the-art methods and achieves an efficient balance between high accuracy and lightweight design.}
}
@article{ABAYAKOON2026116692,
title = {MEDEXA : Enhancing explainability in LLMs through counterfactual explanations, uncertainty estimation and prompt engineering},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116692},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116692},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014188},
author = {Imani Abayakoon and Mada Altiary and Farookh Khadeer Hussain},
keywords = {Explainable AI, Large language models, Self-RAG, Counterfactual explanations, Uncertainty estimations, Medical question answering},
abstract = {The opaque nature of large language models (LLMs) poses challenges for transparency, particularly in high-stakes domains such as healthcare. Although advances in LLM architectures and explainable AI (XAI) techniques have improved performance, a critical gap remains in generating explanations that are both accessible and trustworthy for non-expert users. In this study, we present MEDEXA (Medical Explainable Diagnosis with Evidence, Xplanations, and Assurance), a modular framework that combines counterfactual explanations and uncertainty estimation with prompt engineering and a self-reflective retrieval-augmented generation mechanism inspired by the Self-RAG framework. MEDEXA is designed to enhance the clarity, faithfulness, and user-alignment of LLM-generated responses to medical queries. We evaluate the framework using two patient-doctor dialogue datasets (iCliniq and GenMedGPT-5k), and demonstrate consistent improvements over baseline RAG models across several automatic evaluation metrics, particularly in clarity, consistency and faithfulness. These results highlight the importance of structured explainability components in enhancing trust and strengthening reliability in LLM-driven medical applications.}
}
@article{YILMAZ2026116801,
title = {NECTAR: novel ensemble comb targeting & automated reporting},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116801},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116801},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015273},
author = {ESRA YILMAZ and AYŞE BERNA ALTINEL},
keywords = {beekeeping, honeybee comb detection, deep learning, ensembles, LLM},
abstract = {ABSTRACT
Honeybees are crucial to ecosystem continuity and global food production through pollination, making reliable colony health monitoring essential for sustainable agriculture. However, inspections are still largely manual, while the fine-grained multi-class structure of honeycomb cells, severe class imbalance, tiny objects, and biologically similar categories make automated analysis challenging. Manual inspections are labor-intensive, prone to human bias, difficult to sustain regularly, and unable to support large-scale, data-driven monitoring; in contrast, automated analysis has the potential to accelerate decision-making, reduce operational costs, and positively impact production efficiency and commercial sustainability. In this study, we propose NECTAR (Novel Ensemble Comb Targeting & Automated Reporting), a comprehensive honeycomb-cell analysis framework. A newly curated, high-resolution, multi-class dataset was created. Modern object detectors—YOLO-based CNNs and RT-DETR—were systematically evaluated under identical conditions. Subsequently, ensemble strategies were applied, yielding clear gains—particularly in rare and biologically critical classes. The proposed approach achieved up to 0.90+ AP@0.5 and 0.85+ AP@[0.50:0.95]. In addition, NECTAR presents one of the most detailed literature syntheses in this domain, structuring existing research and clearly identifying the methodological gap addressed by this work. Beyond detection accuracy, an LLM-based reporting layer was integrated to convert numerical outputs into interpretable, rule-guided colony health summaries, providing preliminary decision-support capabilities for beekeeping applications. Overall, NECTAR presents one of the most comprehensive frameworks in the literature by combining a new dataset, multi-model comparative analysis, ensemble fusion, and LLM-supported interpretation, offering a robust and promising contribution toward next-generation smart apiculture.}
}
@article{WANG2026116757,
title = {Multi-feature wavelet attention network for audio deepfake detection},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116757},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116757},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014838},
author = {Bo Wang and Rui Wang and Wei Wang and Zhongjie Ba},
keywords = {Wavelet transform, Automatic speaker verification, Audio deepfake detection, Self-supervised learning, Wav2Vec 2.0 XLSR},
abstract = {The abuse of synthetic speech poses significant threats to social security. However, existing detection models often struggle with generalization, especially when confronted with novel and unknown attacks. To address this challenge, we propose a novel method for audio deepfake detection called multi-feature wavelet attention audio deepfake detection (MWAADD). Specifically, we first extract self-supervised speech sequence features and emotional features using the wav2vec2 XLSR pre-trained model and an emotion recognition model. To better understand and capture these features, we introduce wavelet transform into deep neural networks, which enhances the model’s ability to capture detailed information. Additionally, we combine this with an attention mechanism to focus on the most discriminative speech features. We further incorporate a Long Short-Term Memory (LSTM)-attention module to capture temporal dependencies and selectively focus on key features, ensuring the model highlights the most important clues. Experimental results show that our method outperforms existing state-of-the-art techniques, particularly in terms of generalization and robustness. Notably, on the ASVspoof 2019LA, ASVspoof 2021DF, and In-the-Wild datasets, our method achieves equal error rates of 0.18%, 2.55%, and 9.08%, respectively, demonstrating its superior detection performance.}
}
@article{YANG2026116744,
title = {DPNet: Dynamic pyramid-aided adaptive feature aggregation for hyperspectral image classification under adversarial attacks},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116744},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116744},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601470X},
author = {Jing Yang and Haorui Ning and Changjing Shang and Xiaoying Guo and Haijun Geng and Lu Chen and Qiang Shen},
keywords = {Hyperspectral image classification, Dynamic pyramid context encoder, Selective spectral transformer, Adversarial attacks},
abstract = {Deep learning-driven hyperspectral image (HSI) classification is highly susceptible to adversarial perturbations. This is primarily because existing defence methods face two critical limitations: 1) traditional static network structures typically rely on fixed or predefined receptive fields, thereby failing to dynamically adapt to varying object scales across different inputs; and 2) standard global Transformers are prone to introducing spectral redundancy and noise by indiscriminately processing all bands. To address these challenges, this study proposes a novel dynamic pyramid network (DPNet) for robust HSI classification, by extracting and aggregating multi-scale image features on the fly. Particularly, in the spatial branch, a dynamic pyramid context encoder (DPCE) module is designed to autonomously learn multi-scale contexts, by exploring adaptive layers, dynamic scales and learnable weights. For the spectral branch, a selective spectral transformer (SST) is introduced to reinforce the critical spectral dependencies while suppressing the redundant spectral bands. Finally, an adaptive modal gate is developed to regulate the fusion weights of these two branches, thereby ensuring their joint optimisation. Systematic experiments on popular public benchmark HSI datasets demonstrate that the proposed DPNet significantly outperforms a number of the state-of-the-art methods under adversarial attacks, demonstrating its efficacy in robust feature representation.}
}
@article{WANG2026116765,
title = {GraphMamba: A two-stage hybrid framework for multimodal sentiment analysis},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116765},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116765},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014917},
author = {Rongquan Wang and Xutong Liu and Xinru Wu and Jian Gao and Rui Mao and Erik Cambria},
keywords = {Multimodal sentiment analysis, Graph neural networks, State space models, Multimodal interaction learning, Temporal–structural modeling},
abstract = {Multimodal sentiment analysis (MSA) seeks to infer human affect from heterogeneous signals including language, visual cues, and acoustic information. Existing methods, however, remain limited by inadequate exploitation of domain-general priors from large-scale pretrained modality-specific encoders, insufficiently coordinated modeling of temporal and structural dependencies, and unstable fusion under cross-modal inconsistency. To address these challenges, we propose GraphMamba, a two-stage hybrid graph–Mamba framework for MSA. In the first stage, a large–small collaborative encoding strategy integrates domain-general priors from frozen large-scale modality-specific pretrained encoders with task-adaptive representations learned by lightweight modality-specific encoders. A modality-wise information bottleneck denoising (MIBD) module is further used to suppress task-irrelevant noise and redundant information. In the second stage, an intra-modal sequential graph–Mamba (ISGM) module jointly models graph-based structural relations and temporal dependencies within each modality, while an inter-modal interaction representation learning (IIRL) module performs text-guided cross-modal reasoning via sparse graph construction and bidirectional Mamba-style interaction. Finally, we adopt a text-guided ambiguity-aware dynamic fusion (TADF) mechanism as the final fusion component to regulate modality contributions under cross-modal semantic inconsistency. Extensive experiments on three benchmark datasets show that GraphMamba achieves robust and well-balanced performance across multiple metrics, demonstrating the effectiveness of temporal–structural graph–Mamba interactions for multimodal sentiment understanding.}
}
@article{TIAN2026116709,
title = {A novel multi-fidelity Kriging modeling method with deep shared latent mapping},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116709},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116709},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014358},
author = {Zongrui Tian and Chen Wang and Wanxin He and Gang Li},
keywords = {Multi-fidelity model, Latent map, Non-hierarchical data, Data fusion, Motor hanger},
abstract = {To address the high cost of high-fidelity simulations, the large errors of low-fidelity models, and the complex cross-fidelity correlations in engineering structures, this paper proposes a deep shared latent map Kriging (DSLMK) method. DSLMK uses fidelity labels to build a deep shared latent mapping and embeds discrete fidelity information into multiple latent spaces. It then combines a kernel for continuous design variables with latent-space kernels to form a product covariance function. This allows the model to construct a richer latent-fidelity covariance geometry for describing nonlinear cross-fidelity relationships in a unified Kriging framework. To improve optimization stability, a layer-wise progressive training strategy is introduced. It uses sequential unfreezing and block-wise optimization to handle the strong coupling between mapping parameters and kernel hyperparameters. The proposed method is further applied to the multi-objective optimization of a motor hanger for a high-speed train bogie within a multi-fidelity surrogate-assisted framework. Results from numerical and engineering examples show that DSLMK achieves competitive or better predictive accuracy and more stable performance than the compared non-hierarchical multi-fidelity models under the tested settings.}
}
@article{SINGLA2026116785,
title = {Cross-lingual semantic alignment and multi-objective reranking for multilingual abstractive summarization},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116785},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116785},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601511X},
author = {Parshav Singla and Jasmeet Singh and Gurpal Singh Chhabra},
keywords = {Multilingual summarization, Abstractive summarization, Cross-lingual semantic alignment, Factuality reranking, Natural language inference, Semantic consistency, Transformer models},
abstract = {Multilingual abstractive summarization models frequently generate fluent text that fails to preserve factual consistency and semantic equivalence across languages. To overcome this critical limitation, we propose a robust multilingual summarization framework built upon the mT5-Large architecture that integrates cross-lingual semantic alignment with inference-time multi-objective reranking. During training, a novel cosine embedding alignment penalty minimizes representational divergence between original and translated document pairs, effectively enforcing language-invariant semantic representations. During inference, diverse candidate summaries generated via stochastic nucleus sampling are reranked using a multi-objective scoring mechanism prioritizing multilingual Natural Language Inference (NLI) verification and semantic similarity estimation. Extensive evaluations on the XL-Sum benchmark across five diverse languages (English, French, Spanish, Turkish, and Swahili) reveal a fundamental trade-off between surface-level lexical overlap and true factual reliability. While maintaining competitive multilingual summarization quality (average ROUGE-1 of 33.28), our fully integrated pipeline achieves a substantial improvement in average cross-lingual semantic consistency from 0.4468 to 0.6710. Furthermore, the alignment objective yields up to a +0.1634 absolute similarity gain in pairwise evaluations (e.g., English-Swahili). These findings demonstrate that prioritizing semantic alignment and factuality-aware reranking establishes a highly trustworthy, hallucination-resistant pipeline for global text generation.}
}
@article{YIN2026116685,
title = {Failure-mode-aware uncertainty intervention routing for large language models},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116685},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116685},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014115},
author = {Shiyuan Yin and Ruizhi Zhang},
keywords = {Large language models, Uncertainty estimation, Intervention routing, Failure mode classification, Retrieval-augmented generation},
abstract = {Large language models (LLMs) frequently produce incorrect outputs, yet the underlying causes of failure vary across queries and call for different interventions. We propose failure-mode-aware intervention routing, a framework that extracts a 12-dimensional behavioral uncertainty signature characterizing the type of uncertainty for each query, then trains a lightweight router to select the optimal intervention: commit, deliberate (majority voting), acquire (retrieval-augmented re-generation), or defer (abstain). The signature comprises base, semantic, and intervention-delta features that capture model behavior under different conditions. A TF-IDF control experiment confirms that the signature provides routing signal beyond text-only dataset cues (p<0.001). On 3043 samples, an XGBoost router achieves utility 0.725, significantly outperforming the best single-intervention strategy (+35.2%), MLP routers, confidence-based abstention, adaptive thresholds, and a LinUCB contextual bandit baseline. Leave-one-out feature ablation identifies intervention-delta features as the strongest routing signals. Cross-architecture experiments on three model families (Qwen3-14B, DeepSeek-V3.2, Llama-family 8B) demonstrate generalization, with routing gains inversely proportional to model capability. Cross-family retrieval experiments confirm robustness when retrieval corpus relevance degrades by 69%.}
}
@article{AGHAEI2026116737,
title = {Uncovering latent causal components: An enhanced approach to Granger-based time-series causal discovery},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116737},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116737},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014632},
author = {Asra Aghaei and Fulin Cai and Teresa Wu},
keywords = {Causality, Granger-based method, Independent component analysis, Latent variable, Causal discovery},
abstract = {Causal discovery in time-series data is essential for understanding the underlying mechanisms that generate observed temporal patterns. However, classical Granger-based approaches implicitly assume causal sufficiency, which makes them vulnerable to latent causal components (LCCs) that may act as hidden confounders, mediators, or colliders. These latent drivers distort dependence structures, induce spurious temporal associations, and bias causal direction. Although recent latent-aware methods attempt to recover latent dynamics, they often rely on restrictive identifiability assumptions and may produce components that are neither uniquely recoverable nor causally meaningful in the observed system. To address these challenges, we propose a model-agnostic Latent Causal Component Identification (LCCI) framework for enhancing Granger-based time-series causal discovery. LCCI applies time-delay embedding and independent component analysis to extract latent components, then applies a two-stage selection procedure retaining only components with demonstrable system-wide contribution and residual-based causal relevance. The selected LCCs augment the original observations for downstream causal discovery frameworks. Experiments on Finance, fMRI, and TimeGraph benchmarks, including nonlinear nonstationary settings with varying lags and dimensionalities, show that LCCI improves causal recovery across Granger-style, graph-based, and variational methods. Sensitivity analyses reveal consistent performance across diverse parameter ranges and ablation studies further validate the efficacy of LCC selection.}
}
@article{BARI2026116753,
title = {DSNet: A lightweight CNN for cross-magnification whole slide image analysis for breast cancer diagnosis},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116753},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116753},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014796},
author = {Md Rofiqul Bari and Jannatul Ferdaus and Amir Sohel and Md Alamgir Kabir and Md Shakhawat Hossain},
keywords = {Breast cancer, Whole slide imaging, Lightweight CNN, Computational efficiency, Cross-magnification robustness},
abstract = {Convolutional neural networks (CNNs) have shown significant potential for automated whole-slide image (WSI) analysis for breast cancer diagnosis. However, most existing CNN models are computationally intensive, making multi-resolution WSI analysis challenging, while current lightweight methods often lack comprehensive evaluation across image magnifications, external datasets, and interpretability. To address these limitations, we propose DSNet, a lightweight CNN architecture that balances diagnostic accuracy, computational efficiency, cross-magnification robustness, and interpretability. DSNet comprises only 1.31 million parameters (5.01 MB), making it 2–17× more compact than widely used CNN models while achieving the fastest inference time (51.8 ms) and the highest accuracy-to-GFLOPs ratio (81.3), demonstrating superior computational efficiency. Extensive evaluation on multiple public datasets achieved accuracies of 99.8% (BreakHis-400×), 94.9% (200×), 92.7% (100×), 88.0% (40×), and 90.5% (BACH), demonstrating robust performance across different image magnifications and an independent external dataset. Statistical analysis further confirmed that these improvements over widely used CNN models were significant (p<0.001). Furthermore, Score-CAM consistently highlighted diagnostically relevant tissue regions across magnifications, supporting the interpretability and reliability of the proposed model. Compared with existing lightweight breast cancer classification methods, DSNet achieves comparable or superior diagnostic performance while requiring over 20× fewer parameters and providing comprehensive validation across multiple magnifications, external datasets, and explainable predictions. Overall, DSNet provides an efficient, robust, and interpretable framework for practical AI-assisted WSI analysis.}
}
@article{FU2026116729,
title = {Multi-layer and heterogeneous mutual prompting for domain-adaptive remote sensing scene recognition},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116729},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116729},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014553},
author = {Zihao Fu and Chengke Ma and Shengsheng Wang},
keywords = {Domain adaptation, Prompt learning, Remote sensing scene classification, Fine-grained features, Feature fusion},
abstract = {Remote sensing scene recognition faces challenges due to distribution shifts caused by complex observation conditions, and unsupervised domain adaptation (UDA) methods have been proposed to alleviate this problem. However, the high structural similarity among categories and the intricate scene details in remote sensing imagery necessitate models that can jointly preserve domain invariance and fine-grained discriminability. Existing prompt learning-based UDA methods based on large vision-language models (VLMs) primarily focus on global distribution alignment, often overlooking fine-grained features, which limits their capacity for local structure modeling and precise semantic alignment. To address these limitations, this paper proposes a Multi-layer and Heterogeneous Mutual Prompting (MHMP) framework for cross-modal domain adaptation. First, a heterogeneous visual feature aggregation module is constructed to integrate the global semantic knowledge from CLIP and the local structural representations from DINOv2 during the feature extraction stage, enabling complementary learning of domain-invariant visual embeddings to mitigate distribution shifts. Second, a hierarchical cross-modal prompt generation mechanism is designed, which leverages multi-scale intermediate features and global context from each modality encoder to generate domain-agnostic prompts, thereby enhancing the mining of fine-grained semantic information. Finally, a cross-modal mutual prompting module is introduced to establish a bidirectional guidance mechanism between image and text, allowing the two modalities to reinforce each other in the feature space and further improve domain invariance under cross-domain scenarios. Experiments conducted on 30 typical remote sensing scene recognition tasks demonstrate that MHMP maintains high recognition accuracy in complex scenarios and exhibits superior transfer robustness and semantic alignment compared to existing methods.}
}
@article{LI2026116774,
title = {Cross-Modal Bayesian Inference for training-free open-vocabulary object detection in remote sensing images},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116774},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116774},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015005},
author = {Yan Li and Yunpeng Bai and Zhenhua Wu and Xingguo Zhang and Ying Li and Changjing Shang and Qiang Shen},
keywords = {Object detection, Open-vocabulary, Training-free, Foundation models, Deep learning},
abstract = {Open-vocabulary object detection aims to localize and recognize objects from an open category space without being restricted to predefined classes. While recent training-free methods leverage powerful pretrained foundation models to avoid costly detector training, their performance in remote sensing scenarios remains limited due to category hallucination, insufficient category awareness, and unreliable candidate predictions. To address these challenges, CMBI is proposed as a Cross-Modal Bayesian Inference for training-free open-vocabulary object detection in remote sensing images as a rigorous Bayesian Maximum A Posteriori (MAP) estimation problem. Integrating SAM3 as the base detector and Qwen3 as the semantic assistant, CMBI performs collaborative reasoning through three probabilistically grounded components. First, a global semantic prior formulation mechanism is introduced to tightly constrain the open hypothesis space, effectively suppressing category hallucinations. Second, an adaptive conditioned likelihood estimation strategy employs dynamic visual anchors alongside text to sharpen spatial probability distributions, enhancing the perception of hard-to-recognize targets. Third, a posterior calibration and MAP decision module extracts local semantic evidence to iteratively calibrate intermediate probabilities, thereby eliminating spatial grouping ambiguities and facilitating more robust, bounding box predictions. Extensive experiments on three representative remote sensing benchmarks, DIOR, NWPU VHR-10, and HRRSD, demonstrate that CMBI consistently achieves superior performance over existing training-free baselines. These results validate the effectiveness of cross-modal collaboration for improving the accuracy and robustness of training-free open-vocabulary object detection in remote sensing imagery.}
}
@article{JIAO2026116717,
title = {Query-conditioned knowledge alignment for cross-system medical reasoning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116717},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116717},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014437},
author = {Yan Jiao and Jingran Xu and Pin-Han Ho and Limei Peng},
keywords = {Entity alignment, Knowledge graphs, Query-conditioned ranking, Cross-system medical knowledge integration, Retrieval-augmented generation},
abstract = {Cross-domain knowledge alignment is essential for integrating heterogeneous medical systems, yet existing approaches typically treat entity alignment as a static matching problem, ignoring query context and cross-system asymmetry. This limitation is particularly consequential in integrative medical settings, where correspondence between concepts is inherently context-dependent, non-bijective, and direction-sensitive. In this paper, we propose Query-Conditioned Entity Alignment (QCEA), which reformulates entity alignment as a query-conditioned correspondence problem. Instead of learning a fixed mapping between entity representations, QCEA treats the textual description of a source entity as a query and ranks candidate entities in the target graph, supporting description-dependent alignment. The framework integrates domain-specific semantic encoding, graph-based representation learning, and a direction-aware transformation module to capture asymmetric and many-to-many correspondence across heterogeneous knowledge systems. We evaluate QCEA on TCM–WM knowledge graphs derived from SymMap, covering both symptom alignment and herb–molecule alignment tasks. Experimental results show competitive or improved performance over representative baselines, particularly on rank-sensitive metrics such as Hit@K and MRR. Furthermore, downstream retrieval-augmented generation (RAG) experiments demonstrate that improved alignment leads to better evidence retrieval, stronger grounding, and higher answer accuracy. These findings indicate that alignment is not merely a data integration step, but an important upstream factor for knowledge retrieval and grounding in cross-system medical reasoning.}
}
@article{SHEN2026116769,
title = {DC-GCSI: Generalized zero-shot learning via geometric-contextual synergistic token interaction},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116769},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116769},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014954},
author = {Zhongkai Shen and Jinan Gu and Juan Liu and Tao Xiong and Qiuyue Yang and Ziqi Lv and Yidan Xi},
keywords = {Generalized zero-shot learning, Vision transformer, Visual-semantic alignment, Geometric prior, Contextual interaction},
abstract = {In Generalized Zero-Shot Learning (GZSL), establishing robust visual-semantic mappings remains a critical challenge. Existing Transformer-based methods often suffer from the loss of inherent spatial geometric structures due to serialization "flattening" operations and rely excessively on explicit attribute-driven queries, making them susceptible to attention bias induced by semantic ambiguity and background noise. To address these issues, this paper proposes a Dual-Constraint Geometric-Contextual Token Interaction framework (DC-GCSI). Specifically, a Feature Augmentation Encoder (FAE) is first designed to explicitly encode relative geometric relationships, thereby preserving 2D topological structures, which, combined with implicit global context, generates synergistic tokens possessing both structural awareness and semantic depth. Subsequently, a Latent-Calibrated Structured Attention (LCSA) mechanism is introduced to utilize implicit latent variables as top-down guidance signals for the real-time dynamic "rectification" of bottom-up spatial attention distributions, significantly enhancing the capability for discriminative feature localization within complex backgrounds. Furthermore, a dual-stream collaborative architecture comprising primary and auxiliary bidirectional transformers is constructed to impose dual consistency constraints at both the feature flow and decision levels, enforcing deep alignment between visual and semantic streams. Extensive experiments conducted on three benchmark datasets—CUB, SUN, and AwA2—show that DC-GCSI achieves particularly strong performance on complex scene-level GZSL, reaching a Harmonic Mean (H) of 61.6 ± 0.5% on the SUN dataset, while maintaining competitive performance on fine-grained and coarse-grained benchmarks. Ablation studies and visualization analysis further confirm that the proposed framework effectively mitigates seen-class bias and achieves precise and robust visual-semantic alignment by integrating explicit geometric priors with implicit global context.}
}
@article{PONGMARUTAI2026116745,
title = {CHDS: Geometry-based synthetic data generation for tabular data},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116745},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116745},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014711},
author = {Sopanat Pongmarutai and Supanut Chaidee and Chanchanok Aramrat and Chaisiri Angkurawaranon and Papangkorn Inkeaw},
keywords = {Synthetic data generation, Tabular data, Geometric structure, Markov Chain Monte Carlo},
abstract = {While the utilization of big data has expanded across various fields, restrictions on freely publishing or sharing sensitive information due to privacy concerns remain a significant challenge. Synthetic data generation addresses this issue by producing datasets that replicate the characteristics of original data without revealing identifiable information. This work proposes a geometry-based synthetic data generation method, called Convex Hull Density Sampler (CHDS), for tabular data. The method does not assume any underlying data distribution. It leverages convex hulls to define data boundaries and employs density estimation to capture the underlying data distribution, utilizing a Markov Chain Monte Carlo-based heuristic algorithm for robust sampling. The performance of CHDS was evaluated against six state-of-the-art methods across four machine learning datasets in terms of both utility and privacy. Experimental results demonstrate that CHDS effectively balances the privacy–utility trade-off, maintaining high data fidelity while providing favorable empirical privacy characteristics across diverse datasets. These results suggest that CHDS is applicable to datasets with mixed numerical and categorical features where both data utility and privacy preservation are essential.}
}
@article{JIANG2026116786,
title = {Two-phase decoding network with boundary-region collaborative graph convolution for medical image segmentation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116786},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116786},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015121},
author = {Qingting Jiang and Hailiang Ye and Rui Zhang and Feilong Cao},
keywords = {Boundary-region graph collaborative, Global context, Feature enhancement, Medical image segmentation},
abstract = {GNN-based medical image analysis methods have become a hot research topic in recent years. However, existing mainstream methods typically capture spatial correlation in medical images via long-range modeling and often neglect the synergistic characterization of boundaries and regions, leading to underperformance in target lesion region and boundary segmentation. Accordingly, this paper proposes a two-phase decoding network with boundary-region collaborative graph convolution (BRCG-TPDNet), consisting of a global collaboration phase and a feature enhancement and fusion phase. In the global collaboration phase, a boundary-region collaborative graph convolution module (BRCGM) constructs dual graph learning branches and a graph collaboration unit (GCU) to achieve complementary enhancement of boundary and region features, while a semantic context module (SCM) extracts rich multi-scale global context information to effectively localize the target region. Then, in the feature enhancement and fusion phase, a boundary enhancement module (BEM) is employed to further refine boundary features and make them more accurate, after which a dense feature fusion module (DFM) is applied to intensively integrate multi-level features in order to enrich feature utilization and obtain optimal segmentation. Numerous experimental results indicate that BRCG-TPDNet outperforms state-of-the-art methods in segmentation performance. The code is available at https://github.com/Dragonfly990/BRCG-TPDNet.}
}
@article{RACHMAWATI2026116681,
title = {From segmentation to biomarker quantification: A deep learning framework for metastases detection in bone scans},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116681},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116681},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014073},
author = {Ema Rachmawati and M. Rifqi Dzaky Azhad and Ida Bagus Indrabudhi Kusuma and Yolanda Rahma Chrysti and Nasywa Kamila},
keywords = {Metastases detection, Biomarker quantification, Semantic segmentation, Hotspot metastases, Whole-body bone scan images},
abstract = {A significant challenge in applying deep learning to medical imaging lies in the limited availability of labeled data. While extensive clinical data exists, acquiring labeled image datasets is particularly challenging for bone scintigraphy. These images often contain noise, and reliable ground truth from surgical or pathological reports is not always accessible. Meanwhile, biomarker quantification plays a crucial role in cancer patient care, serving as an indicator of metastatic lesion presence. However, accurate biomarker quantification relies on high-quality segmentation results, which require a sufficiently large amount of labeled data—often scarce in medical imaging. In this study, we propose an end-to-end framework for metastases detection that automatically segments whole-body bone scan images into 12 predefined anatomical regions and quantifies biomarkers from hotspot metastases. To overcome the challenge of limited labeled data, we generate pseudo-labels using the Efficient-BtrflyNet, followed by expert refinement for validation. Instead of the Bone Scan Index (BSI), which requires skeletal mass and radiopharmaceutical uptake values not available in our dataset, we introduce the Metastatic Hotspot Indicator (MHI). MHI is derived directly from segmented regions and hotspot quantification, making it applicable for archived bone scan collections where original skeletal mass measurements are unavailable. The segmentation stage of our framework achieves an average Intersection over Union (IoU) of 0.592 ± 0.17 and a Dice coefficient of 0.614 ± 0.17 for the anterior view, and an IoU of 0.694 ± 0.13 and a Dice coefficient of 0.789 ± 0.08 for the posterior view, demonstrating robust performance in supporting biomarker quantification.}
}
@article{WANG2026116794,
title = {Deep Cholesky space adaptation for cross-session motor imagery decoding},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116794},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116794},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015200},
author = {Xingfu Wang and Wenxia Qi and Wenjie Yang and Boshang Hu and Jianming Shi and Wei Wang},
keywords = {Brain–computer interface (BCI), Domain adaptation, Motor imagery (MI), EEG, Cholesky space},
abstract = {This paper presents a novel unsupervised domain adaptation framework for motor imagery (MI)-based brain–computer interfaces (BCIs), called the Cholesky space adaptation network (CSANet), which enables efficient non-Euclidean adaptation by introducing a new discrepancy metric, the Cholesky mean discrepancy loss (CMDL). This method mitigates the geometric information loss in Euclidean space and avoids the computational complexity of singular value decomposition (SVD) in Riemannian space. In extensive experimental evaluations, CSANet demonstrates outstanding cross-session motor imagery (MI) decoding performance on the BCI Competition IV 2a, 2b, and OpenBMI datasets, achieving average accuracies of 84.46%, 88.39%, and 81.88%, respectively, with corresponding improvements of 5.1%, 2.44%, and 5.12% after incorporating CMDL. Moreover, runtime comparisons reveal that CSANet operates more than five times faster than the Riemannian-space counterpart. In terms of feature analysis, t-SNE visualizations show that CSANet effectively extracts discriminative features to enhance separability. Furthermore, analyses of frequency bands and topographic maps indicate that CSANet accurately identifies the most informative spectral components and brain regions. These findings, along with its strong decoding performance and efficient non-Euclidean modeling, underscore the potential of CSANet for advancing domain adaptation in MI-based BCIs.}
}
@article{MA2026116705,
title = {A Dual-Branch Topology-Aware Model for enhanced 3D vascular segmentation and multi-center adaptation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116705},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116705},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014310},
author = {Yuqi Ma and Shanxiong Chen and Hailing Xiong and WenSong Yang and Xiaolong Wang and Zonglin Wu and Cheng Huang},
keywords = {3D vascular segmentation, Multi-center data, Frequency-domain features, Topology-aware network, Domain adaptation},
abstract = {Three-dimensional (3D) vascular segmentation is essential for cerebrovascular disease diagnosis, surgical planning, and quantitative vascular analysis. However, accurate segmentation from Magnetic Resonance Angiography (MRA) remains challenging due to complex vascular topology, thin and tortuous branches, pathological morphological variations, and domain shifts caused by different imaging centers. Existing deep learning methods often focus on local voxel-wise representation and may fail to preserve global vascular connectivity or maintain stable performance across centers. To address these challenges, we propose a Dual-Branch Topology-Aware Model (DBT) for 3D vascular segmentation and multi-center adaptation. The proposed framework introduces a vascular topology-aware network to model long-range structural dependencies of vascular trees, and a dual-branch multi-frequency adaptive fusion network to jointly enhance global vessel structures and fine-branch details. Furthermore, a multi-center domain adaptation module is incorporated to learn domain-invariant representations and improve cross-center generalization. Extensive experiments on four cerebrovascular datasets, including ADAM, HH, Loch, and TubeTK, demonstrate that DBT-Base, which excludes the multi-center domain adaptation module, and the complete DBT model achieve competitive segmentation performance compared with representative 3D medical image segmentation methods under single-center and multi-center settings, respectively. Quantitative and qualitative results show that DBT improves vessel continuity, fine-branch delineation, and robustness to unseen-center data. Ablation studies further validate the contribution of each component. These findings indicate that DBT provides an effective and generalizable framework for multi-center 3D vascular segmentation. Code is available at: https://github.com/ma-yu-qi/DBT.}
}
@article{LIANG2026116697,
title = {Counterfactual Dual-Stream knowledge tracing via high-influence intervention signals},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116697},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116697},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014231},
author = {Hang Liang and Yi-Fei Wen and Chang Sun and Yajun Du and Xianyong Li and Wen-Bo Xie and Yan-Li Lee},
keywords = {Intelligent education, Knowledge tracing, Interpretability, high-influence intervention signals, Dual-stream encoding},
abstract = {Knowledge Tracing (KT) evaluates students’ dynamic knowledge states from historical interaction sequences. Prior work has largely focused on predictive accuracy, leaving model interpretability underexplored and limiting practical educational applications. In real learning processes, a student’s knowledge state is often shaped by a few critical interactions, termed high-influence intervention signals. Identifying and leveraging these signals is crucial for enhancing both model interpretability and predictive accuracy. To address this challenge, we propose a high-influence intervention-based dual-stream framework for knowledge tracing, termed HIDKT. This method actively identifies high-influence intervention signals through a contrastive learning mechanism. Specifically, we design a dynamic importance scoring mechanism to identify high-influence intervention signals in historical interactions. By intervening on these interactions, we construct a counterfactual interaction stream that runs parallel to the factual interaction stream. Both streams are fed into a shared encoder, where a counterfactual-guided intervention contrastive loss guides the model. This loss explicitly encourages the model to amplify differences induced by high-influence intervention signal interventions in the prediction space, while constraining low-influence perturbations in the latent state space to preserve the stability of the student’s underlying knowledge structure. Extensive experiments on five real-world datasets demonstrate that HIDKT significantly outperforms current state-of-the-art baselines. It improves AUC and ACC by an average of 11.78% and 7.69%, respectively. Further analysis confirms that by explicitly guiding the model to focus on high-influence intervention signals, HIDKT transforms KT from a black-box predictor into a more transparent knowledge tracing tool. This provides a reliable basis for precise educational interventions.}
}
@article{KIM2026116778,
title = {BiG-Net: A knowledge-guided graph learning framework for protein function and localization prediction},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116778},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116778},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015042},
author = {Jun Kim and Zeeshan Abbas and Hyunji Park and Yeonsun Yu and SeungWon Lee},
keywords = {Artificial intelligence, Protein sequence analysis, Graph convolutional networks (GCNs), Deep learning},
abstract = {Sequence analysis of genomic data plays a pivotal role in modern genetics and bioinformatics. By analyzing biological sequences such as RNA and amino acids, researchers can gain insights into antibody developability, amino acid interactions, and molecular functions, ultimately contributing to disease treatment, drug discovery, and vaccine design. However, conventional experimental analysis methods (e.g., mutational screening, X-ray crystallography, and Cryo-EM) often face limitations due to high experimental costs and time inefficiencies. In this study, we utilize 15 publicly available protein datasets, each comprising amino acid sequences and their corresponding labels. We propose a knowledge-guided framework, BiG-Net, which combines a BiGRU-based encoder to capture long-range contextual dependencies in protein sequences with a graph convolutional network (GCN) that performs neighborhood-based relational aggregation over sequence-derived residue connectivity. The proposed framework integrates sequential contextual learning and biologically defined graph learning into a unified representation space. BiG-Net demonstrates competitive performance across diverse protein prediction tasks and achieves superior performance on multiple benchmark datasets without requiring large-scale protein language model pretraining. In particular, the proposed framework achieved substantial performance improvements of approximately 30.62% on the IEDB epitope prediction benchmark and consistently outperformed conventional DeepProtein baseline architectures across a wide range of protein prediction tasks. These results demonstrate the effectiveness of integrating sequential contextual information with biologically derived graph representations for protein modeling and highlight the potential of lightweight AI-driven approaches for efficient protein sequence analysis.}
}
@article{LI2026116713,
title = {Exploring text-to-image augmentation for emotion semantic parsing},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116713},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116713},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014395},
author = {Meng Li and Xiaotong Jiang and Zhongqing Wang and Guodong Zhou},
keywords = {Emotion semantic parsing, Text-to-image generation},
abstract = {Emotion semantic parsing aims to identify emotions and their semantic constituents for fine-grained emotion understanding. While recent end-to-end models have advanced text-based emotion parsing, several limitations remain: (1) existing approaches operate purely in the textual modality, lacking complementary visual context that could enhance affective grounding and contextual reasoning. (2) high-quality multimodal datasets for structured emotion analysis remain scarce, and collecting and annotating such data requires substantial cost. To address these limitations, we propose a text-to-image–based multimodal augmentation framework that automatically constructs task-relevant visual context from textual inputs. Specifically, structured prompts are used to generate candidate images conditioned on the semantic content of the input text, followed by a semantic screening procedure to retain samples that are consistent with the original context. This design removes dependence on external multimodal datasets and provides task-specific visual supplements at reduced data collection cost. The selected text–image pairs are then used to fine-tune a multimodal model, allowing it to better leverage visual cues when modeling emotion labels and their associated semantic constituents. Experimental results demonstrate that generated visual augmentation improves emotion semantic parsing performance. The results also highlight the potential of synthetic multimodal data in advancing emotion analysis.}
}
@article{LI2026116734,
title = {Seeking commonality while preserving diversity: A differential dual-path MoE solution for Multilingual Neural Machine Translation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116734},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116734},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014607},
author = {Wenyi Li and Jinyu Guo and Yuang Li and Xin Chen and Wenxian Liu and Zhaokun Wang and Wenhong Tian},
keywords = {Multilingual Neural Machine Translation (MNMT), Mixture of Experts (MoE), Cross-lingual knowledge sharing},
abstract = {Multilingual Neural Machine Translation (MNMT) aims to develop a unified model that enables knowledge sharing across languages to improve translation quality. In the field of MNMT, multilingual interactions exhibit two aspects: cross-lingual knowledge sharing and inter-language interference, while existing approaches always regard these two aspects as opposite, hindering overall performance. To reconcile the above two aspects, we propose a Commonality-Diversity Mixture of Experts (CDMoE) model to mitigate interference while enhancing knowledge sharing effectively. Within this method, the cross-lingual perception pathway (CLPP) captures cross-lingual shared features to enhance knowledge transfer, while the independent specialized expert pathway (ISEP) employs an explicitly segmented approach to group linguistically similar languages, enabling language-specific feature learning. This design effectively integrates cross-language knowledge sharing and inter-language interference mitigation, maintaining multilingual synergy. Moreover, it leads to superior translation quality, especially for low-resource languages. Our method achieves state-of-the-art performance on MNMT datasets, improving translation efficiency without increasing parameters.}
}
@article{XUE2026116637,
title = {DCGM: Synergizing Differential Cross-Modal Fusion and Graph-Mamba for Referring Multi-Object Tracking},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116637},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116637},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013638},
author = {Zhibiao Xue and Zhanwen Liu and Haochen Wang and Chunmian Lin and Wenjing Zhao and Daniel Jian Sun},
keywords = {Referring multi-object tracking, Visual-linguistic fusion, Graph-mamba, Differential attention, Autonomous driving},
abstract = {Referring Multi-Object Tracking (RMOT) aims to localize and associate multiple objects in videos guided by natural language queries. While recent transformer-based paradigms have achieved impressive results, they often suffer from noisy cross-modal attention, where attention tends to disperse over irrelevant backgrounds. Furthermore, as the network deepens, the lack of explicit structural constraints makes it challenging to maintain consistent linguistic guidance, often leading to sub-optimal fine-grained alignment. To address these challenges, we propose DCGM, an end-to-end framework that synergizes differential noise suppression with structural linguistic encoding. Specifically, we introduce a Differential Cross-Modal Attention Fusion (DCAF) module. Inspired by the principle of noise-canceling headphones, DCAF reformulates fusion as the differential response between parallel attention maps to effectively cancel out the common-mode noise from salient backgrounds and non-discriminative linguistic tokens. To further reinforce hierarchical reasoning, we design the Dynamic Graph-Mamba Encoder (DGME), which comprises: (1) a Cross-modal Semantic Graph Convolution (CSGC) module that refines local alignment via max-relative message passing; and (2) a Graph-Guided Global Mamba (G3M) module that reorganizes visual nodes into a causal sequence, enabling informative context accumulation for efficient global reasoning. Extensive experiments on three benchmark datasets demonstrate that DCGM achieves state-of-the-art performance. Notably, on Refer-KITTI, it achieves 52.38% HOTA, 41.33% DetA, and 66.53% AssA, offering a scalable and robust solution for complex RMOT tasks.}
}
@article{AYMAZ2026116665,
title = {SwinMED: Edge-texture enhanced SwinIR for medical image super-resolution},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116665},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116665},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013912},
author = {Samet Aymaz and Şeyma Aymaz},
keywords = {Super-resolution, Medical image processing, SwinIR, Swin transformer, Edge-texture enhancement, Prostate MRI, Back-projection fine-tuning, Hyperparameter optimization},
abstract = {Medical image super-resolution (SR) addresses a fundamental clinical challenge: hardware constraints, acquisition trade-offs, and patient motion frequently produce MRI images with insufficient spatial detail, compromising lesion boundary delineation and the detectability of small pathological findings. Although Transformer-based architectures—and SwinIR in particular—have demonstrated strong SR performance on natural photographic datasets, they do not incorporate explicit mechanisms for enhancing the edge and texture features most relevant to clinical MRI interpretation, creating a domain gap that limits their direct applicability to medical imaging. In this study, we propose SwinMED, a lightweight extension of SwinIR that integrates a learnable Edge-Texture (ET) module (∼110K parameters) targeting multi-scale edge recovery and local texture enhancement through parallel Sobel branches, dilated texture convolutions, gated fusion, and channel attention. The ET module is optimized via a self-supervised back-projection protocol that requires no paired high-resolution reference images, making SwinMED directly applicable in clinical settings. The framework was evaluated on four prostate MRI datasets (KEAH, ProstateX, I2CVB, Prostate158) across T2-weighted, dynamic contrast-enhanced (DCE), and diffusion-weighted (DWI) sequences, under two degradation scenarios and three upscaling factors (×2, ×3, ×4), covering 72 independent experimental conditions. Quantitative evaluation using PSNR, SSIM, MS-SSIM, and LPIPS shows consistent improvements over the baseline SwinIR configuration across all conditions, with average gains of +4.03dB in PSNR, +0.114 in SSIM, +0.041 in MS-SSIM, and a −0.201 reduction in LPIPS. Positive PSNR and SSIM gains were observed in all 72 conditions; LPIPS improved in 70 out of 72 conditions. These findings indicate that lightweight, domain-targeted edge-texture refinement can complement pretrained transformer SR backbones in medical imaging contexts, providing consistent reconstruction improvements without retraining the full model and without requiring paired high-resolution training data.}
}
@article{SHI2026116686,
title = {ARISE: Reinforcement learning for dynamic critical-node intervention in rumor–epidemic co-evolution},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116686},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116686},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014127},
author = {Yepeng Shi and Ling Yin and Kemin Zhu and Yuxiao Luo and Kang Liu},
keywords = {Rumor–epidemic co-evolution, Critical-node intervention, Deep reinforcement learning, Multilayer networks, Graph neural networks},
abstract = {Online rumors increasingly affect epidemic control, creating an infodemic that hinders public health efforts. Amid limited resources, prioritizing interventions on critical nodes is an effective strategy for multilayer rumor–epidemic networks. However, rumor–epidemic co-evolution is highly dynamic, with time-varying node states and intervention-induced changes in the residual topologies. Individuals may transition between infection states, while each sequential intervention changes the active contacts and the future importance of the remaining nodes. Identifying and intervening on critical nodes in such a process remains challenging. Existing centrality heuristics and reinforcement learning (RL) methods are mainly designed for static rankings or fixed topologies, which limits their ability to capture the bidirectional feedback between rumor-driven behavioral changes and the inhibitory effect of epidemic progression on rumor diffusion. To address this problem, we formulate rumor–epidemic control as a dynamic, budget-constrained critical-node intervention task grounded in a co-evolution model that explicitly characterizes coupled state transitions and bidirectional feedback between layers, together with sequential residual-topology updates induced by intervention. We then propose Adaptive Rumor–Epidemic Intervention with Cross-Layer Embeddings (ARISE), an RL-based control framework. ARISE uses dual-layer multi-head Graph Attention Networks (GATs) to encode the current topology within each layer and a cross-layer attention mechanism to integrate these signals into state-aware node representations. This design enables the RL agent to perceive the non-stationary environment and prioritize critical nodes under a strict budget. In addition, a multistage curriculum strategy improves training stability and helps the learned policy generalize across diverse network scales. Experiments on synthetic and real-world node-aligned multilayer networks show that ARISE achieves the lowest mean final cumulative infection rates across the main synthetic and real-world benchmarks under the same budget. These results provide useful support for allocating limited resources to curb the coupled spread of misinformation and disease.}
}
@article{SALEHI2026116738,
title = {Incremental tensor-train decomposition for real-time analysis of high-dimensional infrastructure data},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116738},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116738},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014644},
author = {Hadi Salehi and Md Shah Jalal Mazumder},
keywords = {Structural health monitoring, Intelligent transportation systems, Multi-modal datasets, Real-time analytics, Online tensor-train (OTT), High-order tensors, Tensor decomposition, CANDECOMP/PARAFAC (CP), Tucker decomposition, Anomaly detection, Forecasting, Performance scaling, Spatiotemporal data},
abstract = {Modern monitoring systems in structural health monitoring (SHM) and transportation generate continuous streams of heterogeneous, high-resolution data from distributed sensor networks. These data capture complex spatiotemporal interactions across multiple modes, including time, space, operating conditions, and environmental variables. High-order tensor representations provide a natural framework for preserving this multi-way structure, and tensor decompositions such as CANDECOMP/PARAFAC (CP), Tucker, and Tensor Train (TT) have been widely used for imputation, reconstruction, anomaly detection, and forecasting. However, most existing tensor decomposition methods are formulated in a batch setting, requiring repeated refitting as new data become available, which limits their applicability for real-time monitoring. This paper develops an Online Tensor Train (OTT) framework for incremental tensor decomposition of streaming infrastructure data. The proposed approach updates tensor representations sequentially as new observations arrive, reducing the need for full batch retraining and substantially lowering cumulative computational cost. The framework is evaluated on benchmark datasets from SHM, using the Z24 Bridge dataset, and transportation, using the Caltrans PeMS dataset, under a unified preprocessing and evaluation protocol. Results show that OTT achieves reconstruction accuracy comparable to batch CP and batch TT methods, with a modest accuracy gap relative to Tucker in some cases, while providing orders-of-magnitude reductions in per-update and cumulative runtime. OTT also preserves the compact memory characteristics of TT and supports residual-based anomaly and incident detection in streaming settings. These findings demonstrate that online tensor representations offer a practical and scalable solution for real-time infrastructure monitoring, particularly when continuous data ingestion, rapid updating, and computational efficiency are essential. This work establishes a foundation for integrating tensor decomposition with streaming analytics in digital-twin-enabled infrastructure monitoring and intelligent transportation systems.}
}
@article{ARTEAGA2026116641,
title = {Privacy-preserving on-device detection of sexually explicit visual content for child safety},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116641},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116641},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013675},
author = {Sandra Pérez Arteaga and Ana Lucila Sandoval Orozco and Luis Javier García Villalba},
keywords = {Child, Machine learning, Mobile, On-device, Prevention, Security, Sexual content detection},
abstract = {The early use of mobile devices and instant messaging apps has dramatically increased children’s exposure to online sexual exploitation, such as grooming, creating a need to develop protective measures that do not compromise their privacy or the security of their personal data. In this context, the detection of sexual content on mobile devices is a key tool for protecting minors, especially to prevent the exchange of sensitive material. However, this type of analysis poses significant challenges in terms of data security and privacy. This paper analyzes machine learning models suitable for implementation in a tool that uses a Training and Testing on Device architecture, with the goal of processing images and videos directly on the device. The tool analyzes the content of messaging apps, such as WhatsApp and Telegram, as well as locally stored files, to identify visual sexual material associated with potential contexts of child sexual abuse. Unlike traditional approaches, processing is carried out automatically and entirely on the mobile device, avoiding the transfer of data to external servers. This approach significantly reduces the risks associated with the exposure of personal information, as the processed data is neither shared nor stored outside the user’s device. Furthermore, the proposal demonstrates the feasibility of implementing effective tools for the automatic detection of sexually explicit content on mobile devices, which helps to tackle the social problem of grooming at advanced stages of multimedia content sharing and provides a tool to strengthen the protection of children.}
}
@article{MODROGAN2026116714,
title = {AI-Based semantic video indexing: a unified survey from segmentation to retrieval},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116714},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116714},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014401},
author = {Maria Modrogan and Ruxandra Tapu and Bogdan Mocanu},
keywords = {Semantic video indexing, Temporal segmentation, Video-text retrieval, Multimodal fusion, Large multimodal models, Knowledge-aware video understanding},
abstract = {AI-based semantic video indexing transforms audiovisual streams into searchable and interpretable semantic representations. These representations support retrieval, temporal localization, summarization, question answering, and knowledge-oriented access. Recent advances in video representation learning, video-language pretraining, audio and speech modeling, dense captioning, and large multimodal models have expanded video understanding capabilities. However, the literature remains fragmented across task-specific areas such as segmentation, captioning, retrieval, and multimodal reasoning. This survey addresses this fragmentation by proposing an indexing-oriented taxonomy that connects five functions: defining temporal units, extracting multimodal evidence, aligning and fusing heterogeneous signals, constructing searchable semantic indices, and supporting end-user search and exploration. Representative methods, datasets, and evaluation protocols are reviewed according to their roles in this pipeline and their relevance to temporal granularity, modality coverage, grounding quality, retrieval effectiveness, interpretability, scalability, and robustness. The analysis highlights persistent challenges related to temporal ambiguity, weak cross-modal grounding, noisy supervision, domain transfer, hallucinated annotations, privacy, computational cost, and limited explainability. Finally, we outline future directions for reliable semantic access to large-scale video archives, with emphasis on temporal adaptability, hybrid indexing, provenance tracking, explainability, and knowledge-aware representations.}
}
@article{SI2026116678,
title = {Label-knowledge guided heterogeneous-temporal graph network for multimodal intent understanding},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116678},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116678},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014048},
author = {Tongzhen Si and Sai Zhang and Penglei Li and Fazhi He and Zihao Dong},
keywords = {Multimodal intent recognition, Temporal dynamic, Contrastive learning},
abstract = {Multimodal intent recognition aims to infer user intentions by integrating text, visual, and auditory information. Existing methods primarily employ the static fusion strategy to concatenate or add different modal features, which neglect the intra-modality dynamic relationship and inter-modality heterogeneous dependencies. To this end, we propose a Label-knowledge guided Heterogeneous-temporal Graph Network (LHGN) to build the temporal dynamic and cross-modality heterogeneous relationship for multimodal intent understanding. Specifically, we first construct a Heterogeneous-temporal Graph (HTG) to model the complex intra-modality and inter-modality correlation. Furthermore, we introduce a Text-interactive Fusion (TIF) module that leverages textual semantics to focus on visual and audio features in order to emphasize intent-related cues. Finally, we introduce Dual-view Contrastive Learning (DVCL) that utilizes embedded label text features as anchors to align original text and fused multimodal features for alleviating text sparsity and fusion redundancy. Extensive experiments on multimodal intent datasets demonstrate that our method significantly outperforms existing methods, exhibiting superior performance in capturing complex dynamic intent cues from heterogeneous modalities.}
}
@article{ZHANG2026116730,
title = {SAMGNet: A synergistic adaptive multi-domain graph network with multi-level consistency contrastive learning for non-stationary multivariate time series},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116730},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116730},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014565},
author = {Rui Zhang and Chen Zhang and Chaoli Sun and Liuhu Fu and Mingxia Zhao},
keywords = {Multivariate time series classification, Non-stationary signals, Graph neural networks, Multi-domain representation, Contrastive learning},
abstract = {Multivariate time series classification (MTSC) aims to identify system states and event types from synchronized multivariate observations, providing critical decision support for complex systems. However, the time-varying nature of non-stationary signals poses several fundamental challenges that severely limit classification reliability in practice. Recent advances have shown that graph neural network (GNN) frameworks are effective for MTSC, yet existing approaches still face three major limitations: a single representation domain cannot fully capture the multi-physical characteristics of non-stationary signals; static graph structures cannot adaptively track the dynamic evolution of inter-variable topological dependencies; and insufficient robustness under distribution shifts degrades discriminative performance. To address these challenges, we propose a Synergistic Adaptive Multi-Domain Graph Network (SAMGNet). Specifically, SAMGNet maps temporal signals into three complementary representation spaces — time–frequency, evolution, and phase — and integrates them efficiently through alignment and fusion. It further combines static topological priors with sample-specific dynamic correlations to build adaptive inter-variable graph structures. Moreover, a hierarchical consistency contrastive learning mechanism stabilizes semantic representations through both intra-layer and inter-layer constraints. Extensive experiments on the UORED-VAFCLS bearing-fault dataset and the ADFTD electroencephalogram (EEG) dataset show that SAMGNet achieves classification accuracies of 98.26% and 65.66%, respectively, outperforming state-of-the-art methods and confirming its effectiveness and robustness in non-stationary MTSC tasks.}
}
@article{YAYLA2026116706,
title = {Exploring multimodal voice sentiment through SentHBC: A comparative study},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116706},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116706},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014322},
author = {Rıdvan Yayla},
keywords = {Multimodal sentiment analysis, SentHBC framework, BERT embeddings, MFCC, Deep learning, Climate change discourse},
abstract = {Sentiment analysis has emerged as a pivotal technique for deciphering human emotions and behaviors across diverse domains. While traditional Natural Language Processing (NLP) and Machine Learning (ML) methods have paved the way for speech pattern analysis, challenges regarding noisy real-world data, model robustness, and generalization persist. In this study, SentHBC (Sentimental-Hybrid-BERT–CNN), a novel multimodal deep learning architecture designed to integrate linguistic and acoustic features for enhanced sentiment detection, is proposed. Unlike unimodal approaches, SentHBC leverages contextual BERT embeddings and Mel-Frequency Cepstral Coefficients (MFCC) to capture the nuances of both text and tone. The proposed framework was developed using a specialized dataset focusing on ‘global warming’ and ‘climate change’, and was benchmarked against five leading machine learning algorithms through a rigorous 10-fold cross-validation methodology. Experimental results demonstrate that SentHBC significantly outperforms traditional ML baselines, achieving superior Accuracy, F1-score, and lower RMSE values. The findings validate the efficacy of multimodal fusion in mitigating error propagation in noisy environments and provide a robust solution for large-scale emotional analysis of environmental discourse. Additionally, this demonstrates that the proposed framework possesses high architectural adaptability, remaining open to further development and deployment across different domains.}
}
@article{YUAN2026116754,
title = {Counterfactual distribution intervention for few-shot class-incremental learning},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116754},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116754},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014802},
author = {Jicheng Yuan and Wenfa Li and Lusi Li and Liping Zhang and Enhao Ning and Xingyu Gao and Xin Ning},
keywords = {Few-shot class-incremental learning, Feature Decoupling, Representation Learning, Causal inference, Counterfactual Intervention},
abstract = {Few-Shot Class-Incremental Learning (FSCIL) focuses on enabling models to learn new classes from limited samples while preventing catastrophic forgetting of previously acquired knowledge. Existing methods often fail to differentiate between intrinsic class features and irrelevant background correlations, making models sensitive to shifts in data distribution during incremental learning, which limits their ability to generalize. To tackle this issue, we propose the Counterfactual Distribution Intervention (CDI) framework, which focuses on learning robust feature representations by mitigating non-discriminative interference through causal intervention. The framework consists of three key modules: In the base-class phase, Causal Feature Decoupling (CFD) explicitly separates features into causal and stylistic components. Building on this, Distribution-Shifted Counterfactual Intervention (DSCI) applies structured intervention to stylistic features, forcing the model to learn distribution-invariant causal representations. During the incremental stage, Random Sampling Counterfactual Intervention (RSCI) repurposes base-class style features to generate diverse counterfactual samples, efficiently utilizing limited data while maintaining feature stability. Extensive experiments on three benchmark datasets—CUB-200, CIFAR-100, and mini-ImageNet—demonstrate that the CDI framework significantly outperforms existing state-of-the-art methods, confirming its effectiveness in improving model generalization and preventing forgetting.}
}
@article{WU2026116770,
title = {Semantics-guided topology fusion graph convolutional network for efficient skeleton-based action recognition},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116770},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116770},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014966},
author = {Jin Wu and Huaping Zhou and Xiangrui Meng and Kelei Sun and Tao Wu and Bin Deng and Baozhou Tan and Mengge Zhang},
keywords = {Skeleton-based action recognition, Graph convolutional network, Semantic topology, Knowledge distillation, Large language models},
abstract = {Graph topology is crucial for skeleton-based action recognition, as it determines the propagation of motion information among human joints. Existing GCN-based methods typically rely on physical skeleton connections or adaptive topologies learned from joint coordinates. However, such topologies are mainly constrained by anatomical structures or motion statistics, causing difficulty in capturing high-level semantic dependencies between physically distant but action-relevant joints. This limitation is particularly evident in fine-grained actions, where discriminative cues often depend on body-part functions, action context, and class-specific joint interactions. To address this issue, we propose a semantics-guided topology fusion graph convolutional network (SGTF-GCN), a novel framework that exploits large language models (LLMs) to derive offline semantic graph-topology priors to enhance skeleton-based action recognition. SGTF-GCN introduces two complementary structured priors: a global action-context prior for encoding holistic action semantics and a local joint-relation prior for capturing fine-grained functional joint dependencies. Both priors conform to the standard GCN adjacency matrix format, enabling seamless fusion with the original physical skeleton topology. Subsequently, a dedicated semantics-guided topology fusion module dynamically integrates these semantic priors with the physical topology, resulting in a strong semantics-guided multimodal teacher network. To maintain efficient inference without requiring LLMs at test time, we introduce topological knowledge distillation, which transfers the teacher’s multi-level semantic structural knowledge to a lightweight unimodal student network by aligning their topology distributions. Extensive experimental results reveal that the proposed method achieves competitive performance on NTU RGB+D, NTU RGB+D 120, and NW-UCLA with excellent inference efficiency.}
}
@article{ZHOU2026116694,
title = {High-fidelity tabular data synthesis by quantile-based distribution harmonization under extreme class imbalance},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116694},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116694},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014206},
author = {Jinjie Zhou and Senlin Luo and Limin Pan and Zongyuan Yang and Xiaonan Yang and Zehao Xu},
keywords = {Tabular data, Data synthesis, GAN, Class imbalance},
abstract = {Synthetic tabular data provides a practical way to support deep learning applications while reducing direct exposure of sensitive records. Mixed-type variables are commonly found in datasets with extreme class imbalance. Existing generative models tend to be biased toward discrete components due to they are concentrated and easily distinguishable. This bias can lead to the underfitting of relatively sparse continuous components, thereby reducing the diversity of synthetic data. Additionally, logarithmic sampling, which is commonly used to mitigate class imbalance, shifts the posterior distributions of continuous variables and may disrupt the conditional dependencies between features and labels, consequently reducing the utility of the synthetic data. To mitigate these issues, this paper proposes Quantile-based Distribution Harmonization GAN (QDHGAN) for imbalanced tabular data synthesis. QDHGAN distinguishes discrete components and partitions continuous components into distribution regions according to the cumulative distribution characteristics of mixed-type variables. It then maps these components into uniform distributions through index replacement, reducing density differences among components and alleviating generator bias. Furthermore, QDHGAN evenly segments the index range and uses discrepancies between synthetic and sampled distributions within each segment to guide the generator, compensating for distribution shifts and preserving feature-label dependencies. Experimental results demonstrate that QDHGAN achieves state-of-the-art performance. It can handle asymmetric distributions commonly found in imbalanced datasets, including mixed-type, long-tail, and skewed multi-mode distributions.}
}
@article{PETRESCU2026116746,
title = {MeshShield: Counteractive network immunization via spectral graph analysis},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116746},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116746},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014723},
author = {Alexandru Petrescu and Ciprian-Octavian Truică and Elena-Simona Apostol and Panagiotis Karras and Florin Pop},
keywords = {Near real-time network immunization, Social network analysis, Spectral graph analysis, Subgraph decomposition, Degree-weighted vulnerability},
abstract = {The rapid adoption of social media platforms by the general public has enabled the unprecedented spread of harmful content, often under the guise of anonymity, causing significant risks to individuals and communities, especially to vulnerable groups such as children, women, immigrants, etc. To stop the spread of such content and protect these groups, network immunization approaches from the epidemics domain have been employed. These immunization strategies use global spectral features of the graph, which struggle to scale to large-scale graphs that model real-world social media interactions and often fail to respond quickly to dynamic and community-localized outbreaks. To address this shortcoming, in this work, we introduce MeshShield, a novel immunization strategy that leverages the sparsity and community structure of social networks to enable efficient mitigation of harmful content by directly targeting infectious nodes and their neighbors. MeshShield applies a divide-et-impera approach to dynamically extract and analyze localized subgraphs centered around detected infectious sources, i.e., communities. Once these subgraphs are extracted, MeshShield employs a novel degree-weighted vulnerability measure to calculate which nodes within the community to immunize first. MeshShield analyzes all the subgraphs using a highly parallelized, shared-memory approach, thus reducing computational overhead and achieving near real-time performance even on large-scale real-world networks. Compared to state-of-the-art algorithms, such as DAVA and CONTAIN, the experimental results on real-world Twitter data demonstrate that our proposed strategy manages to immunize the network much faster while scaling with the graph’s size.}
}
@article{LONG2026116775,
title = {Adversarial knowledge augmentation based learning for enhancing interpretable fuzzy-rule-based classification},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116775},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116775},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015017},
author = {Maosen Long and Fu-Lai Chung and Shitong Wang},
keywords = {Adversarial training, Interpretable fuzzy rules, Knowledge augmentation, TSK fuzzy classifiers},
abstract = {Interpretable fuzzy-rule-based classification is frequently in great demand for many application scenarios. However, its generalization ability may be hindered by factors such as excessive fuzzy rule parameters and distribution shift. This study aims to improve an interpretable first-order Takagi-Sugeno-Kang (TSK) fuzzy classifier by developing a novel methodology based on adversarial task augmentation, which has recently been an efficient means for enhancing the generalization ability of a classifier. The proposed methodology is designed on the basis of both the conclusive claims in cognitive research and the unique perspective that a fuzzy rule, as a piece of knowledge, bridges input and output data spaces. Accordingly, an innovative concept of adversarial knowledge augmentation (KA2) is proposed, and then the KA2-based interpretable first-order TSK fuzzy classifier (TSK2A2) is developed. TSK2A2 has the following features: (1) Without any direct use of data-related tasks, it augments a virtual data distribution with a small number of interpretable augmented fuzzy rules by means of KA2; (2) Throughout the training of TSK2A2, to have adversarial generation of each augmented fuzzy rule, an AND-NOT operator is introduced to randomly negate certain conditions for its IF-part generation. All the particularly-designed parameters based on the generated IF-parts are applied to the corresponding THEN-parts; (3) TSK2A2 employs fast analytical training for all THEN-parts. Theoretical analysis and/or experimental results on the adopted datasets indicate that TSK2A2 achieves enhanced generalization performance while retaining desirable interpretability and training efficiency.}
}
@article{LI2026116741,
title = {Adapting to the unknown: Class relational divergence for open set test-time adaptation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116741},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116741},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601467X},
author = {Guangrui Li and Jianghao Zhou and Yongxin Ge},
keywords = {Deep learning, Test-time adaptation, Domain adaptation, Image classification},
abstract = {Unsupervised domain adaptation (UDA) aims to adapt a model trained on a labeled source domain to an unlabeled target domain. Despite its promising progress, most UDA methods operate under two idealized assumptions: a well-aligned label space between source and the target, and joint access to both source and target data. These two assumptions limit the applicability of UDA methods in real-world scenarios. In this paper, we propose a unified framework that leverages inter-class relationships to distinguish known and unknown classes during test-time adaptation. Specifically, we gather class prototypes for known classes during source training, so as to derive inter-class relationships. During test, each target sample will perform matching the inter-class relationships with prior relationship knowledge, in which novel classes can be identified due to their larger divergence on the relational distribution. Extensive experiments on four benchmarks demonstrate the effectiveness of the proposed approach.}
}
@article{HUANG2026116762,
title = {HumanDiff: Leveraging body-part expert-assisted diffusion transformers for human image generation},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116762},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116762},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014887},
author = {Yan Huang and Zhiren Wang and Hongzong Li and Jiahao Zheng and Yongcan Luo and Tianyi Chen and Si Wu},
keywords = {Diffusion transformers, Human image generation, Multimodal feature alignment, Mixture-of-experts, Semantic segmentation},
abstract = {Synthesizing realistic human images remains a longstanding challenge in computer vision due to the highly articulated structure and diverse appearances of the human body. This task demands generating high-quality images while preserving semantic consistency across body parts and capturing fine-grained visual details. However, existing approaches often struggle to achieve precise alignment between semantic guidance and visual output, particularly when integrating multi-source semantic information or reconstructing local structures faithfully. To address these issues, we introduce HumanDiff, a novel diffusion transformer framework for structured human image generation. HumanDiff leverages multi-modal data through a unified feature extraction pipeline to deliver precise, semantically-grounded generation. A specialized expert module focuses on modeling individual body parts, while a soft routing mechanism dynamically fuses information across experts, ensuring smooth transitions and coherent integration between adjacent regions. The body-part regions are defined by the supplied semantic segmentation map, whereas the soft-routing weights are learned end-to-end without explicit expert-assignment supervision. Furthermore, a fine-to-coarse feature alignment module bridges global structural cues and local detail representations, enhancing both connectivity and visual fidelity across body parts. Experiments on DeepFashion at resolutions up to 512 × 256 and additional evaluation on SHHQ demonstrate improved visual realism, structural consistency, and quantitative performance under the evaluated settings.}
}
@article{WANG2026116782,
title = {Complexity-aware synergistic distillation for efficient abstractive summarization},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116782},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116782},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601508X},
author = {Guoliang Wang and Diandian Wang and Shuai Liu and Kun Wang and Xilin Liu and Jun Qiang and Jin Liu},
keywords = {Abstractive summarization, Knowledge distillation, Teacher-student model, Complexity-aware},
abstract = {Abstractive summarization remains a computationally intensive task, posing significant challenges for the efficient deployment of large-scale encoder-decoder models. In this paper, we propose a complexity-aware synergistic distillation framework that balances model compactness with semantic fidelity. First, we introduce a teacher enhancement utilizing a triple-objective optimization scheme to ensure the teacher model provides robust and semantically enriched supervision without requiring external signals. Subsequently, the framework employs a complexity-aware layer recommendation mechanism that quantifies dataset-specific attributes into a complexity score to dynamically determine the optimal student depth. Furthermore, we adopted a multi teacher layer overlapping alignment and collaboration (MLOAC) strategy to synergistically aggregate knowledge from multiple adjacent teacher layers via learnable collaboration weights, thereby optimizing cross-layer information flow. Experiments across diverse benchmarks demonstrate that our framework consistently preserves near-teacher performance under significant compression ratios. The integration of complexity-based adaptability and overlapping knowledge transfer yields an efficient summarization solution that is highly robust and complementary to existing inference-time acceleration methods.}
}
@article{LI2026116787,
title = {DDKT: Dual-Decoupled Multi-Scale Knowledge Tracing via behavioral gating and trend-fluctuation modeling},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116787},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116787},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015133},
author = {Yanting Li and Shenggen Ju and Tao Zhou and Xia Yang},
keywords = {Educational data mining, Knowledge tracing, Knowledge state representation, Learning behavior, Multi-scale modeling},
abstract = {Knowledge tracing (KT) models students’ knowledge states to predict their future performance in intelligent tutoring systems. Despite recent progress, existing methods suffer from two key limitations: first, they predominantly model knowledge states at a single time scale, failing to simultaneously capture long-term cognitive trends and short-term response fluctuations. Second, they typically fuse multidimensional learning behavior features into a unified representation space, thereby failing to disentangle the individual contributions of different behavioral factors. To address these limitations, we propose a Dual-Decoupled Multi-Scale Knowledge Tracing model (DDKT) that decouples the learning process across behavioral and temporal dimensions. In the behavioral dimension, a neural additive behavior gating mechanism explicitly characterizes the modulatory effect of multidimensional behavior features on the intensity of knowledge state updates. In the temporal dimension, a bottom-up guided trend pyramid structure and multi-scale parallel depthwise separable convolutional branches model long-term cognitive trends and short-term response fluctuations, respectively. Furthermore, we introduce a question-aware forgetting module to capture heterogeneous forgetting patterns across questions, together with a FiLM-based prediction module to enhance model interpretability. Experimental results on four widely used public datasets demonstrate that DDKT consistently outperforms 21 representative state-of-the-art KT methods across multiple evaluation metrics. Further experiments and analyses confirm that DDKT enhances model interpretability while maintaining competitive predictive performance, indicating its potential applicability in intelligent educational scenarios. The code of our method is available at https://anonymous.4open.science/r/DDKT-DFC5.}
}
@article{SUSAN2026116613,
title = {Machine learning based dynamic thresholding mechanism for spectrum sensing under different signal to noise ratio and noise variance conditions},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116613},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116613},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126013390},
author = {D. Susan and M. Suba},
keywords = {Machine learning, Spectrum sensing, Dynamic thresholding, Artificial intelligence},
abstract = {Spectrum sensing is a critical function in cognitive radio (CR) systems for identifying and utilizing underused frequency bands efficiently. Among existing techniques, cyclostationary feature detection is widely adopted due to its robustness in distinguishing signals from noise under low signal-to-noise ratio (SNR) conditions. However, conventional cyclostationary feature detection methods rely on static thresholding, which limits detection performance under varying noise variance and dynamic channel conditions. To address this limitation, this work proposes a machine learning (ML)-based dynamic thresholding approach using pretrained convolutional neural networks (CNNs) for spectrum sensing. The proposed method adaptively predicts the detection threshold under varying SNR and noise environments, thereby improving detection accuracy while maintaining manageable system complexity. The performance of multiple pretrained CNN architectures is evaluated under different modulation schemes (256-PSK and 256-QAM) and channel conditions, including AWGN, Rayleigh, and Rician channels. Simulation results, obtained using MATLAB 2025b, demonstrate that the proposed approach achieves a probability of detection (Pd) of 100% across a wide range of operating conditions, even at very low SNR levels. Notably, InceptionV3 achieves 100% Pd for 256-QAM under an AWGN channel at −27 dB. In comparison, an existing ANN-based cyclostationary feature detection approach achieves the same detection performance at −10.12 dB under identical modulation and channel conditions. This corresponds to a significant improvement of approximately 16.88 dB in detection capability. Overall, the results confirm that ML-driven dynamic thresholding substantially enhances detection reliability in low SNR and high noise variance scenarios, making it a robust and scalable solution for spectrum sensing in CR networks.}
}
@article{WU2026116795,
title = {DCRNet: Sparse-to-dense large scale point cloud registration network with dynamic clustering transformer},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116795},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116795},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015212},
author = {Hao Wu and Li Yan and Changjun Chen and Xiaoteng Yang and Binbing Wang and Pengcheng Wei and Longze Zhu and Linxia Ji},
keywords = {Sparse-to-dense, Dynamic clustering, Large-scale scene, Point cloud registration},
abstract = {Point cloud registration is a fundamental yet crucial task in autonomous driving, SLAM, and 3D reconstruction. The matching accuracy depends on point correspondences in the overlapping regions. However, large-scale outdoor point cloud registration faces several challenges, including large data volumes, high noise levels, irregular spatial distributions, and multiple similar structures. Due to the significant amount of low-correlation information, standard attention struggles to prioritize weights on meaningful points, resulting in mismatches and low efficiency. To overcome these limitations, we propose a sparse-to-dense large-scale outdoor point cloud registration network based on the dynamic clustering transformer (DCRNet). First, DCRNet utilizes rotary position embedding (RoPE) to encode relative positional relationships from spatial information and enhance geometric consistency. Then, the dynamic clustering transformer extracts highly discriminative features from global to local. Specifically, we propose a dynamic clustering method that divides points into different clusters using a coarse-to-fine strategy to focus more on matchable and repeatable points. Intra-class attention is then used to gradually capture multi-scale contextual information and reduce redundant computations. Finally, the point aggregation module fuses the advanced geometric information of superpoints into neighborhood patches. We achieve accurate and reliable alignment of large-scale outdoor scenes through the sparse-to-dense matching method. Extensive evaluations on the KITTI, NuScenes, and CODD datasets demonstrate that our method achieves state-of-the-art performance.}
}
@article{HUANG2026116750,
title = {A robust Uncertainty-Aware Disentanglement framework for image manipulation localization},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116750},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116750},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014760},
author = {Xiao Huang and Hongxia Wang and Hanqing Liu and Jiale Luo and Kaile Wang},
keywords = {Image manipulation localization, Convolutional neural network, Robustness to post-processing},
abstract = {Image manipulation localization is crucial for maintaining content authenticity against digital editing. However, existing methods still suffer severe robustness bottlenecks in practical applications. Specifically, post-processing operations like compression and blurring severely degrade subtle manipulation traces, resulting in ambiguous prediction masks with coarse boundaries. To mitigate the feature degradation caused by these operations, we propose a robust image manipulation localization framework driven by an Uncertainty-Aware Disentanglement (UAD) module. Unlike conventional binary classification strategies that struggle with ambiguous traces, the UAD module explicitly addresses post-processing interference by modeling disrupted regions as an independent “uncertainty state”. Adopting a divide-and-conquer strategy, it disentangles hybrid features into three parallel feature streams: the tampered, the authentic, and the uncertain. By isolating ambiguous features into the uncertainty stream, it enforces the authentic and tampered branches to learn highly discriminative and pure representations. To further reinforce this disentanglement, we introduce a class complementary loss that constrains the mutually exclusive relationships among these categories, effectively mitigating prediction ambiguity. Additionally, a Multi-Scale Edge Extraction (MSEE) module is incorporated to capture rich forensic boundary artifacts, providing structural priors for the disentanglement. Finally, extensive evaluations on several public datasets demonstrate that our method outperforms state-of-the-art techniques in both localization accuracy and robustness.}
}
@article{FURQON2026116674,
title = {Black-box time-series domain adaptation via cross-prompt foundation model},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116674},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116674},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014000},
author = {M.T. Furqon and Mahardhika Pratama and Igor Škrjanc and Lin Liu and Habibullah Habibullah and Kutluyil Dogancay},
keywords = {Transfer learning, Domain adaptation, Black-box domain adaptation, Time-series},
abstract = {The black-box domain adaptation (BBDA) topic is developed to address the privacy and security issues where only an application programming interface (API) of the source model is available for domain adaptations. Although the BBDA topic has attracted growing research attentions, existing works mostly target the vision applications and are not directly applicable to the time-series applications possessing unique spatio-temporal characteristics. In addition, none of existing approaches have explored the strength of foundation model for black box time-series domain adaptation (BBTSDA). This paper proposes a concept of Cross-Prompt Foundation Model (CPFM) for the BBTSDA problems. CPFM is constructed under a dual branch network structure where each branch is equipped with a unique prompt to capture different characteristics of data distributions. In the domain adaptation phase, the reconstruction learning phases in the prompt and input levels are developed. All of which are built upon a time-series foundation model to overcome the spatio-temporal dynamic. Our rigorous experiments substantiate the advantage of CPFM achieving improved results with noticeable margins from its competitors in three time-series datasets of different application domains.}
}
@article{LI2026116693,
title = {Structure-Preserving Mixture-of-Experts: A graph sparse computation framework for node classification},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116693},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116693},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601419X},
author = {Ming Li and Yimeng Wang and Huan Xu and Bo Peng and Xiangjiu Che},
keywords = {Graph neural network, Mixture-of-Experts, Node classification, Structure-Preserving routing, Global expert},
abstract = {Node classification is a core benchmark task in graph neural networks (GNNs). It aims to predict the class of each node in a graph and offers a diverse array of applications of graph-structured data. Some studies propose GNN frameworks that integrate the Mixture-of-Experts (MoE) approach for node classification to reduce computation and tackle issues in large-scale graphs, such as oversmoothing, redundant computation, and structural fragmentation. However, most existing methods rely on isolated node-choice routing. In these approaches, each node is routed independently, making expert computation domains poorly aligned with graph topology, which fragments the graph structure and limits structure-aware specialization of experts. Therefore, we propose Structure-Preserving MoE (SP-MoE), a framework that correlates expert activation with graph topology. Each expert selects the top-k core nodes via a structure-aware gate module and conducts message passing on local domains expanded from these core nodes. Meanwhile, a global expert module is designed to ensure the coverage of marginal nodes and the completeness of representations. Extensive experiments demonstrate that the proposed SP-MoE consistently achieves strong and competitive performance compared to classical GNNs and recent scalable graph architectures.}
}
@article{REN2026116690,
title = {Adaptive condensation for graphs: A data-driven coarse-to-fine pruning method},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116690},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116690},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014164},
author = {Boyang Ren and Hui Zhou and Zhongying Zhao and Chao Li and Yongquan Liang},
keywords = {Graph condensation, Graph neural networks, Node classification},
abstract = {Graph Neural Networks (GNNs) face significant computational and memory challenges when trained on large-scale graphs. Graph condensation alleviates this issue by learning a compact synthetic graph that preserves the essential information of the original data. However, existing methods are constrained by predefined condensation ratios and uniform synthetic-node allocation strategies, which limits their adaptability across diverse datasets. To address these limitations, we propose AGCond, an Adaptive Graph Condensation method that adaptively determines both the global condensation ratio and the class-wise allocation of synthetic nodes. AGCond begins with a non-uniform initialization phase that combines prototype-based coarse clustering with Dirichlet process Gaussian mixture modeling to construct a structure-aware initial synthetic graph. The condensation process then integrates a dual-branch gating network to fuse gradient-matching signals with k-core-based structural importance scores, enabling fine-grained node assessment. A subsequent cumulative-contribution pruning mechanism adaptively removes less informative nodes while preserving critical graph characteristics. Extensive experiments on node classification and generalization tasks show that AGCond consistently outperforms state-of-the-art condensation methods across multiple benchmarks. Notably, on Flickr, AGCond matches full-graph accuracy at a learned condensation ratio of approximately 0.04%, demonstrating its ability to provide a data-adaptive alternative to manually fixed condensation ratios. The code is available on GitHub at https://github.com/renby0915/AGCond.}
}
@article{DENG2026116779,
title = {Gradually target activating and self-supervised enhancing for visual tracking},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116779},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116779},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015054},
author = {Yanfang Deng and Jie Chen and Canlong Zhang and Zhixin Li and Xiaochun Lu},
keywords = {Target tracking, Feature activation, Spatio-temporal enhancement},
abstract = {Most trackers based on Vision Transformer use cross attention mechanisms to identify target tokens in a search image that resemble the initial template. However, during numerous interactions, template tokens are inevitably tainted by the background tokens present in the search image, leading to difficulties in accurately distinguishing the target tokens. To tackle this issue, we introduce a Feature Activation Module (FAM) based on asymmetric mixed attention to effectively activate the target tokens in the search image while keeping the template tokens pure. The FAM was also applied in interactions between the dynamic template and the initial pure target, to obtain highly accurate target time-varying information. To fully utilize the spatial and temporal information of the target in tracking, we further propose a Spatio-Temporal Fusion Module based on the maximum suppression to encourage the tracker to identify additional spatiotemporal interaction clues. A self-supervised target-driven enhancement decoder was designed to reconstruct the dynamic template and search image from their activated features, which improved the expressive ability of these activated features toward the target. Finally, by organically integrating the three above mentioned innovative modules, we constructed a tracker called GFATrack, which exhibited robust tracking by gradually activating spatiotemporal information of the target. Our tracker achieved the competitive performance compared with recent state-of-the-art methods on several challenging datasets, including UAV123, LaSOT, TrackingNet, GOT-10k, OTB100, VOT2018 and VOT2019. Our code are available at https://github.com/Yinfonaaa/GFATrack/tree/master.}
}
@article{SHAHID2026116783,
title = {Enhancing human activity recognition through GAN-augmented data and multi-branch CNN-LSTM networks},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116783},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116783},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015091},
author = {Ayesha Shahid and Muhammad Hassan Khan and Muhammad Adeel Nisar and Muhammad Shahid Farid},
keywords = {Human activity recognition, Data augmentation, Generative adversarial network, Ensemble deep network},
abstract = {Human activity recognition has garnered significant attention due to its numerous applications in sports, healthcare, smart homes, and security. Various deep learning models have been developed to extract meaningful feature representations from temporal sensory data to recognize activities of daily living. However, these models need a substantial amount of categorized data for effective training. Despite the abundance of data from wearable devices, the lack of labeled samples hinders the optimal performance of these models. This insufficiency can lead to poor generalization and overfitting, which can be mitigated through data augmentation techniques. The proposed research makes two main contributions: First, it investigates three variants of Generative Adversarial Networks (GANs) for data augmentation to address the inadequacy of labeled data. Second, it proposes a novel multi-branch hybrid Convolutional Neural Network-Long Short-Term Memory (CNN-LSTM) network to classify the activities of daily living. The hybrid models refer to the fusion of different deep learning models to leverage their strengths, creating more robust and efficient solutions. We assessed the effectiveness of the proposed ensemble model, enhanced with data augmentation, on three publicly available datasets, achieving impressive accuracy rates: 94.4% on the CogAge dataset, 89.7% on the WISDM dataset and 94% on the CASAS dataset. We observed a 7.0% increase in accuracy for CogAge, a 7.2% improvement for WISDM and a 14% improvement for CASAS by employing the proposed augmentation techniques. Comparative analysis with current state-of-the-art approaches demonstrates the superior performance of proposed model.}
}
@article{DIB2026116702,
title = {When to stop: Learned routing and risk control for early exit networks},
journal = {Knowledge-Based Systems},
volume = {351},
pages = {116702},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116702},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126014280},
author = {Omar Dib},
keywords = {Early exit networks, Adaptive inference, Entropy supermartingale, Conformal risk control, Calibration},
abstract = {Early exit networks speed up inference by letting easy inputs leave at shallow layers, reserving deeper computation for hard cases. Existing methods rely on a single confidence score to decide when to exit, conflate routing with calibration, and provide no guarantee on the per-sample error rate. We address all three limitations. We learn a lightweight predictor that combines three signals — prediction confidence, feature-space distance from the training distribution, and how uncertainty evolves across exits — to estimate error probability at each exit. Routing and calibration are handled separately: the predictor controls when to exit, while per-exit temperature scaling calibrates the output confidence. A conformal procedure then provides a formal, data-driven bound on the per-sample error rate. A key finding is the entropy supermartingale property: for correctly classified inputs, prediction uncertainty should decrease with depth. This holds strongly for convolutional networks but breaks down for transformers, explaining why consistency-based routing degrades on transformer architectures. Our predictor remains effective across both architectures, achieving 35% FLOPs savings compared with 12.6% for the best consistency baseline at equal calibration error. We further identify and correct a training bias that causes deeper-exit predictors to overestimate difficulty, collapsing routing to a two-exit policy. Staged conditional training corrects this. Across three datasets and eight baselines, our method matches the oracle routing decision 55%–61% of the time versus 24%–26% for the best heuristic, achieves 2.8× the compute savings of the strongest consistency baseline at equal calibration error, and degrades gracefully where all heuristic methods fail.}
}