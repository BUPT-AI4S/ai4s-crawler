@article{YI2026116965,
title = {Bi-AlignRec: A pre- and post-alignment framework for multimodal recommendation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116965},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116965},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016916},
author = {Peng Yi and Lu Chen and Zhaoxian Li and Cheng Yang and Xiongcai Cai},
keywords = {Multimodal recommendation, Cross-modal alignment, Graph convolutional networks, Representation learning},
abstract = {Multimodal content helps alleviate data sparsity in recommender systems, but also introduces the challenge of integrating heterogeneous modality information. In GCNs-based multimodal recommenders, node representations are jointly shaped by the node-embedding part and the graph-based collaborative part. However, most existing methods mainly focus on modality-specific information carried by content-derived embeddings, while paying much lesser attention to modality-specific information developed through propagation on modality-differentiated graph structures. To overcome this limitation, we propose Bi-AlignRec, a bi-alignment framework for multimodal recommendation. Specifically, the pre-alignment module aligns the initial embeddings of the same node across modalities before propagation, establishing a comparable reference space that enables structurally differentiated collaborative signals to be developed on modality-specific hierarchical graphs. The post-alignment module injects modality-specific content into node embeddings, performs representation learning over a shared interaction graph, and aligns the learned representations to enhance semantic consistency across modalities. The complementary outputs of the two modules are finally integrated for recommendation. Experiments on three benchmark datasets show that Bi-AlignRec consistently outperforms strong baselines, confirming the benefit of jointly modeling structural and semantic modality-specific information.}
}
@article{ZHANG2026116936,
title = {K-SWAT: New Koopman Spectral Wavelet Attention Transformer method for long time series forecasting},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116936},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116936},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601662X},
author = {Xiaobo Zhang and Qiong Zhang and Yutao Liu and Xiaoping Qiu and Hui Zhang},
keywords = {Long-term time series forecasting, Koopman operator, Spectral dynamics filtering, Wavelet-enhanced attention, Transformer},
abstract = {Long-term multivariate time series forecasting remains difficult because high-frequency noise is often amplified during frequency decomposition, multi-scale cross-variable dependencies are hard to capture with standard attention, and purely linear temporal assumptions fail over long horizons. To address these three bottlenecks, we propose the Koopman Spectral Wavelet Attention Transformer (K-SWAT), which couples (i) a Spectral Dynamics Filter (SDF) with adaptive magnitude-threshold denoising, (ii) Wavelet-Enhanced Directional Attention (WEDA) that applies Haar wavelet reweighting on the attention score matrix, and (iii) a Koopman Dynamics Layer (KDL) that estimates a finite Koopman operator via online eDMD for stable multi-step evolution. On eight public benchmarks, K-SWAT attains the highest average normalized score of 0.915 and the best or jointly best MSE in the majority of settings, while remaining competitive with S-Mamba on Traffic long horizons where state-space scanning is advantageous.}
}
@article{PANDEY2026116957,
title = {FRSATPNet: feature representation based sparse action transformer pyramid network and structured action probability for multi-stream action classification},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116957},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116957},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016837},
author = {Barun Pandey and Upasana Sinha},
keywords = {Violence behaviour detection (VBD), Multi-stream video, Action classification, Deep learning, Feature representation},
abstract = {Violent Behavior Detection (VBD) aims to automatically identify aggressive actions from surveillance videos. However, traditional handcrafted motion-based methods and conventional transformer methods perform poorly in dynamic environments thus leads to high false positives. The proposed Feature Representation-Based Sparse Action Transformer Pyramid Network (FRSATPNet) introduces a novel end-to-end architecture for VBD in multi-stream surveillance videos. Unlike conventional methods that rely on sequential feature extraction or dense transformer attention, FRSATPNet pioneers a sparsity-before-attention mechanism: high-dimensional multi-stream features (spatial, temporal, motion, and trajectory) are first projected into a sparse action subspace via dictionary-learned sparse coding, which explicitly suppresses background noise and redundant tokens prior to transformer processing. This is integrated with a hierarchical Sparse Action Transformer Pyramid Network (SATPN) that performs multi-scale temporal modeling across pyramid levels, enabling simultaneous capture of short-term impulsive violent actions and long-term interactions. Additionally, a structured probabilistic output module based on probabilistic graphical models provides uncertainty-aware predictions with confidence scores, enhancing interpretability. This unified sparsity-driven, pyramid-attention, and probabilistic framework achieves superior discriminative power in cluttered, dynamic environments while maintaining computational feasibility. FRSATPNet is performed with five benchmark datasets (i.e., Hockey, Movies, BEHAVE, ViF, and KTH) which achieves high performance with accuracy of 99.5% on Hockey, 99.8% on Movies, 97.4% on ViF, 98.7% on BEHAVE, and 98.5% on KTH. The proposed FRSATPNet integrates sparse feature refinement, heterogeneous multi-branch learning, and hierarchical spatiotemporal attention for abnormal activity recognition. Controlled ablation experiments evaluate the individual and combined effects of sparse refinement and temporal pyramidal processing.}
}
@article{BASTOLA2026117025,
title = {Empirical fair auditing of high-confidence failures under distribution shift},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117025},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117025},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601751X},
author = {Laxmi Prasad Bastola and Senlin Luo and Md Minhazul Islam Munna and Sohrab Khan},
keywords = {Budgeted review allocation, Confidence calibration, Distribution shift, Fairness-aware auditing, Selective prediction},
abstract = {Fair auditing of high-confidence failures is crucial for validating the trustworthiness of machine-learning decision-support systems operating under distribution shift. While selective classification and out-of-distribution detection have attracted growing interest, three core challenges remain unresolved. Existing abstention methods suffer from the following limitations: they do not explicitly target high-confidence errors and therefore waste review budget on lower-confidence regions where such failures are unlikely; they are typically evaluated only at a single deployment snapshot, making them brittle under progressive distribution shift; and they ignore fairness, allowing subgroup disparities in high-confidence failures to remain hidden. To address these issues, we propose an empirical fair-auditing framework for budget-constrained review under distribution shift. In particular, τ-gating confines monitoring to the τ-target eligible high-confidence region, aligning alert selection with the audit objective and reducing budget waste, while fairness-aware alert allocation combines risk-based prioritization with parity and bounded group-allocation policies to reduce disparities across sensitive groups. The proposed approach is evaluated on ACSIncome, Diabetic Readmission, CivilComments, and a cross-domain text shift (CivilComments → Jigsaw) over 20 random seeds against standard baselines. The experimental results demonstrate an HC-AUC of 0.944 on Diabetic Readmission, Lift@5 of 9.518 on Diabetic Readmission and 4.561 on ACSIncome, and a reduction in alert-rate disparity of up to 99.8% under parity allocation at negligible utility cost, establishing a practical foundation for knowledge-driven, fairness-aware decision support in high-stakes AI systems.}
}
@article{LIANG2026116945,
title = {Leveraging artificial intelligence with a modified nonlinear artificial neural network to analyze flow and mechanical properties of fiber reinforced concrete with eco-friendly materials},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116945},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116945},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016710},
author = {Xinyu Liang and Khidhair Jasim Mohammed and H. Elhosiny Ali and Samia Elattar and José Escorcia-Gutierrez},
keywords = {Flow properties, Mechanical properties, Supplementary cementitious materials (SCMs), Robustness analysis, Uncertainty quantification},
abstract = {Fiber-reinforced concrete (FRC) incorporating sustainable supplementary cementitious materials offers considerable potential for achieving adequate workability together with enhanced mechanical performance. However, its fresh and hardened responses are governed by strongly nonlinear and coupled interactions among binder composition, aggregate grading, water and superplasticizer contents, and steel-fiber geometry and dosage. Consequently, conventional mix-design procedures and standard regression-based approaches provide limited capability for simultaneously analyzing and predicting multiple FRC properties and generally require extensive experimental testing. This study leverages artificial intelligence through a modified sigmoid artificial neural network (mTanh-ANN) to evaluate the embodied carbon footprint and quantify the predictive uncertainty of FRC. Experimental mixtures incorporating GGBS, fly ash, micro silica, and macro steel fibers and microsteel fibers were evaluated using slump flow, V-funnel, L-box, U-box, and J-ring tests together with compressive strength, split tensile strength, flexural strength, and elastic modulus measurements. Mixture constituents and fiber dosages were used as model inputs, while the experimentally measured fresh and hardened properties were treated as prediction targets. The modified sigmoid ANN was trained using backpropagation with gradient-based optimization and early stopping, while repeated-run robustness assessment and prediction intervals were employed to evaluate prediction reliability. For the experimentally developed dataset, the model achieved coefficients of determination exceeding 0.998 for flow-property prediction and approximately 0.993 for mechanical-property prediction, with maximum prediction errors remaining below 10%. External validation using independent literature datasets yielded test-set R² values of 0.97, 0.95, 0.97, and 0.95, respectively. These results demonstrate that the modified sigmoid ANN effectively captures the nonlinear relationships between mixture composition, steel-fiber characteristics, flow behavior, and mechanical performance, providing a reliable data-driven approach for the assessment of FRC incorporating sustainable materials.}
}
@article{DWIVEDI2026117034,
title = {Knowledge-guided federated intelligence for explainable and privacy-aware multimodal decision systems},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117034},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117034},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017600},
author = {Ashish Kumar Dwivedi},
keywords = {Knowledge-based systems, Federated learning, Multimodal decision systems, Explainable AI, Privacy-aware intelligence},
abstract = {The deployment of intelligent decision systems in distributed, privacy-sensitive environments demands learning paradigms that combine robustness, transparency, and semantic grounding. While federated learning enables collaborative training without sharing raw data, this study proposes a knowledge-guided federated intelligence (KG-Fed) framework for explainable, privacy-aware multimodal decision systems. The approach integrates structured domain knowledge, including symbolic rules, relational knowledge graphs, and semantic constraints, directly into the federated learning process, guiding local optimization, regulating global aggregation, and enabling semantically grounded explanations. By operating at the knowledge level rather than the raw data level, the framework reduces direct information exposure while enabling consistent reasoning across heterogeneous clients. A formal convergence analysis shows that KG-Fed converges to a stationary point at the same asymptotic rate as standard federated averaging, with an explicit, bounded additive term arising from cross-client knowledge divergence. Evaluation on three multimodal decision benchmarks shows that the benefit of knowledge-guided regularization is dataset-dependent: it yields a statistically significant performance improvement over data-driven federated baselines on a chemical sensor drift task, a positive but non-significant trend on human activity recognition, and no measurable gain on a tabular census-income task. Across all three datasets, however, knowledge integrated during training produces substantially higher constraint-satisfaction rates than the same knowledge applied post hoc, indicating more faithful, intrinsic explanations. These results position knowledge-centric design as offering consistent explainability benefits alongside performance gains that vary with data modality, informing when the added computational cost is worthwhile.}
}
@article{LI2026116917,
title = {Beyond intuition: Zero-shot policy synthesis and execution for temporal knowledge graph question answering},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116917},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116917},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016436},
author = {Chenhao Li and Dandan Song and Zhijing Wu and Yuhang Tian and Jun Yang and Changzhi Zhou and Huipeng Ma},
keywords = {Temporal knowledge graph question answering, Large language models, Zero-shot reasoning, Symbolic reasoning, Beam search},
abstract = {Static knowledge bases fail to capture dynamically evolving real-world facts, driving research in temporal knowledge graph question answering (TKGQA). TKGQA requires reasoning over continuously evolving facts with timestamps to answer questions with complex temporal logic. State-of-the-art methods, whether based on iterative retrieval, recursive decomposition, or abstract planning, have converged on a common architecture: at each reasoning step, a large language model (LLM) simultaneously serves as the semantic interpreter and the temporal constraint enforcer, with evidence retrieved via similarity matching. This conflates two fundamentally different tasks. Semantic grounding benefits from LLM world knowledge but requires graph-structural verification that similarity matching cannot provide. Temporal constraint satisfaction, including event ordering, boundary checking, and extrema selection, is symbolically decidable given TKG timestamps, yet is routinely left to the LLM’s unreliable temporal intuition. We introduce ORACLE-T, a zero-shot framework that disentangles these responsibilities. A semantic grounding path resolves entity and relation ambiguity by combining hybrid candidate retrieval, LLM-based semantic re-ranking, and graph-structure-grounded disambiguation. A temporal logic path compiles temporal cues from the question into a formal Temporal Execution Strategy of symbolic operators and enforces temporal constraints directly over TKG timestamps, rather than relying on the LLM’s free-form temporal intuition. The two constraint paths jointly steer a dynamic beam search with cascaded query relaxation for recall recovery. Without task-specific training, ORACLE-T achieves state-of-the-art on MultiTQ and CronQuestions, surpassing the strongest non-fine-tuned baselines by 8.7% and 2.7% respectively.}
}
@article{LIU2026116969,
title = {An efficient self-paced multi-view method for partial label learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116969},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116969},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016953},
author = {Bo Liu and Dewen Chen and Yanshan Xiao and Xixian Shen and Honggao Weng and Jiayi Chen and Kaining Huang and Yong Tang},
keywords = {Partial label learning, Multi-view learning, Self-paced learning, Adaptive view weighting},
abstract = {Partial label learning (PLL) aims to learn from ambiguously supervised data, where each training instance is associated with a candidate label set containing the ground-truth label. Although multi-view data can provide complementary information for resolving label ambiguity, existing multi-view PLL methods still struggle to jointly address label ambiguity, view heterogeneity, and progressive disambiguation within a unified framework. To this end, we propose SP-MVPLL, an efficient self-paced multi-view method for partial label learning. Specifically, we formulate multi-view PLL under a max-margin framework with latent labels and introduce a consensus distribution to enforce cross-view consistency at the output level. To alleviate the adverse effects of label ambiguity and noisy supervision, self-paced learning is incorporated to gradually emphasize easy and reliable instances during training. Meanwhile, an entropy-regularized adaptive view-weighting mechanism is developed to automatically balance the contributions of different views and prevent degenerate view aggregation. Extensive experiments on five benchmark datasets under different ambiguity levels demonstrate the effectiveness of SP-MVPLL against state-of-the-art baseline methods. A controlled two-view runtime study further shows that SP-MVPLL is the fastest method on three of the five datasets. When all available views are used, SP-MVPLL is faster than CFDM on every dataset, reducing training time by 52.4%–66.6%.}
}
@article{MA2026117014,
title = {Diffusion scheduling-based stochastic trajectory prediction with time-frequency analysis},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117014},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117014},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017405},
author = {Jiaqi Ma and Jinfu Yang and Fuji Fu},
keywords = {Stochastic trajectory prediction, Temporal-frequency analysis, Diffusion module, Energy entropy},
abstract = {Trajectory prediction aims to accurately generate future trajectories and has significant applications in fields such as autonomous driving and robotic navigation. Diffusion model-based trajectory prediction algorithms, as one of the most mainstream approaches, have made remarkable progress. However, most of them struggle to effectively capture both long-term and short-term dependencies in temporal trajectories, and diffusion models with fixed diffusion steps are inadequate in adapting to substantial variations in motion complexity across different trajectories. To address these issues, this paper proposes a stochastic trajectory prediction framework based on Diffusion step Scheduling with Time-frequency Analysis, termed DSTA. DSTA jointly incorporates a Multi-scale Time-frequency Enhancement Module (MTEM) and an Energy Entropy-guided Diffusion Scheduler (EEDS) to model temporal dependencies and motion complexity. Specifically, MTEM introduces the discrete wavelet transform and employs a decomposition-aggregation architecture to perform multi-scale time-frequency analysis of trajectories. EEDS computes the energy entropy of trajectory features and maps it to trajectory-specific diffusion steps, thereby allocating adaptive diffusion generation budgets for diverse trajectories. Furthermore, a Step-Scheduled Diffusion Module (SSDM) is designed to utilize the MTEM-extracted trajectory features as priors and generate future trajectories based on the EEDS-assigned diffusion steps. Extensive comparative, visualization, ablation, and efficiency experiments are conducted on four datasets (ETH-UCY, NBA, SDD, NFL), fully demonstrating the effectiveness and superiority of the proposed framework.}
}
@article{YU2026116941,
title = {From local bias to global consensus: Mitigating sample bias and knowledge fragmentation in federated learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116941},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116941},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016679},
author = {Bin Yu and Meihao Zhang and Yu Xie and Chen Zhang and Wenjie Mao},
keywords = {Federated learning, Multi-armed bandit, Self-paced learning, Data heterogeneity},
abstract = {Federated learning in privacy-sensitive domains is severely affected by statistical heterogeneity. Non-IID data hinder convergence through two coupled effects: sample selection bias, which corrupts local representation learning, and knowledge fragmentation, which prevents compatible knowledge from being shared across clients. This paper proposes a three-stage adaptive framework that mitigates these effects through self-paced prototype learning, context-aware client collaboration, and neighborhood prototype augmentation. First, a self-paced curriculum estimates sample difficulty using both local loss and gradient instability, while a dynamic threshold progressively revisits delayed samples to avoid permanently discarding rare or boundary cases. Second, a server-side contextual multi-armed bandit mechanism forms transient client neighborhoods from real-time prototype compatibility and an exploration term, preserving useful diversity rather than enforcing fixed clusters. Third, neighborhood-augmented prototype fusion improves local generalization by combining task loss, global consistency, and contrastive alignment under a bounded perturbation strategy. Experiments on CIFAR-10, CIFAR-100, and FashionMNIST show that the framework achieves 82.71% accuracy under pathological non-IID CIFAR-10 and 98.66% on FashionMNIST, while reducing cross-client variance by 0.53%–0.83%. We further analyze communication/computation costs, scalability, hyperparameter sensitivity, and the limitations of the method in fine-grained or low-overlap scenarios.}
}
@article{ZHU2026116990,
title = {S2-CoGNN: A heterogeneous graph representation learning framework based on spectral-spatial synergy and reliable structure distillation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116990},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116990},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017168},
author = {Xiaoying Zhu and Weimin Li and Hao Wang and Quanke Pan and Can Wang},
keywords = {Heterogeneous Graph Neural Networks, Semi-supervised learning, Spectral-spatial synergy, Pseudo-label, Distillation learning},
abstract = {Heterogeneous Graph Neural Networks (HGNNs) have been widely applied to complex network analysis; however, they still face two major challenges in semi-supervised learning scenarios. First, existing HGNNs rely primarily on low-pass aggregation mechanisms or globally shared filtering strategies, making it difficult to maintain effective full-spectrum graph signal representations in heterogeneous environments. Second, existing pseudo-label generation methods either lack sufficient topological constraints or rely excessively on symmetric collaborative training, resulting in negative transfer and noise accumulation issues. To address these limitations, this paper proposes a novel Spectral-Spatial Collaborative heterogeneous Graph Neural Network (S2-CoGNN) with semi-supervised learning framework that constructs a Spectral-Spatial Decoupled Architecture (SSDA) to mitigate spectral degradation caused by over smoothing. Moreover, the spectral stream utilizes bidirectional graph propagation to capture low-frequency global patterns while the spatial stream preserves high-frequency local information, serving as an anchor to prevent feature degradation. Furthermore, a Reliable Collaborative Training Mechanism (RCTM) is developed. It not only promotes competitive mutual learning on labeled data but also leverages spectral stream’s structural modeling advantages to generate structure-enhanced pseudo-labels while achieving dynamic balance through a joint loss that mitigates confirmation bias and prevents negative transfer in weakly supervised scenarios. Extensive experiments on five real-world datasets demonstrate that the proposed framework consistently achieves competitive performance in both node classification and link prediction tasks, while exhibiting enhanced stability and generalization capabilities, particularly in data-scarce settings.}
}
@article{ZHANG2026117018,
title = {An explainable knowledge-based evaluation framework for urban digital innovation capability: Integrating multi-criteria decision analysis and interpretable machine learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117018},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117018},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017442},
author = {Yajing Zhang and Tinglong Zhang and Weizhong Wang and Min Kong and Muhammet Deveci and Dursun Delen},
keywords = {Urban digital innovation capability, Multi-criteria decision analysis, Explainable artificial intelligence, SHAP, Intelligent decision support},
abstract = {Urban digital innovation capability plays a vital role in regional competitiveness, smart city transformation, and sustainable development. However, existing studies often lack evaluation frameworks that provide interpretable analysis of indicator contributions. To address this issue, this study proposes an integrated framework that combines multi-criteria decision-making with interpretable machine learning for the comprehensive assessment of urban digital innovation capability and the interpretation of indicator contributions. The framework is applied to panel data from 110 prefecture-level cities in the Yangtze River Economic Belt. First, the criteria importance through intercriteria correlation method is used to determine objective indicator weights. The multi-objective optimization on the basis of a simple ratio analysis with leveling coefficients method is then employed to assess urban digital innovation capability. The evaluation results are subsequently analyzed using a Random Forest Tree Shapley Additive exPlanations (TreeSHAP) framework to quantify and interpret the contributions of indicators. The assessment results show that urban digital innovation capability in the study area exhibits a stable east-west spatial gradient, with cities exhibiting higher levels of digital innovation capability concentrated in major metropolitan centers. The Random Forest TreeSHAP interpretability analysis shows that indicators related to innovation participants, digital economy invention patents, and knowledge resources exhibit the highest predictive contributions to the evaluated composite urban digital innovation capability score. Further analysis reveals nonlinear relationships and interaction effects among these indicators. The proposed framework improves the transparency and interpretability of urban digital innovation capability assessment and provides a useful reference for targeted policy development.}
}
@article{PANG2026117079,
title = {DARQ: Diffusion-Augmented Regularized Q-Updates for offline goal-conditioned reinforcement learning with soft switching policy fusion},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117079},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117079},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018058},
author = {Shanchen Pang and Xi Yu and Haiyuan Gui and Shihang Yu and Wenhao Ji and Nuanlai Wang and Kuijie Zhang},
keywords = {Offline reinforcement learning, Safety constraints, Diffusion model, Advantage regularization, Robotic manipulation},
abstract = {Offline goal-conditioned reinforcement learning (Offline GCRL) aims to learn generalizable policies for achieving specified goals using only static offline data. However, in safety-constrained environments, agents are often required to handle factors such as obstacle collisions, which impose stricter requirements on balancing task completion and safety within the learned policy. While previous studies have explored diverse strategies to approximate optimal policies, these methods often struggle to effectively balance task success and safety. This paper systematically investigates the problem of offline GCRL under safety constraints and proposes an offline GCRL algorithm called DARQ (Diffusion-Augmented Regularized Q-Updates), which integrates diffusion-based data augmentation and in-sample advantage regularization Q-value updates to address these challenges. We evaluate our method on a Fetch robotic benchmark with random obstacles, showing that DARQ outperforms state-of-the-art methods in both generalization and safety.}
}
@article{WANG2026116977,
title = {Enhancing zero-shot anomaly detection through dual-state prompt flow and multiscale cross-modal alignment},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116977},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116977},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601703X},
author = {He Wang and Shanglei Yang and Yiwei Li and Jiacheng Zhu and Lin Mei and Zhiqiang Li},
keywords = {Zero-shot anomaly detection, CLIP, Transformer, Image–text attention, Industrial defect detection},
abstract = {Unlike traditional supervised anomaly detection, which only detects anomalies within learned categories and requires a large number of samples to train the model, zero-shot anomaly detection is capable of detecting anomalies in previously unseen categories with little or no data for training. Recently, zero-shot anomaly detection methods based on prompt learning have replaced manual prompts with learnable prompts, showing significant enhancement in industrial and medical domains. Despite substantial progress, they often ignore the difference between dynamic image content and shared static semantics, resulting in semantic confusion and affecting detection accuracy. To mitigate the limitation, we propose a dual-state prompt flow module, which comprises a learnable contextual prompt flow for contextual prompts, a learnable state-aware prompt flow for state prompts, and two learnable state adapters for separating the state prompts into normal and abnormal categories. We also propose a multi-scale cross-modal alignment block, which tokenizes features and performs image–text attention calculation at multiple scales, improving the capability of simultaneously detecting and segmenting defects of varying sizes. Additionally, we construct two industrial datasets, SWRDv2 and WELDv2, for pixel-level defect detection. The experiments have shown that our method achieves advanced performance in image-level and pixel-level anomaly detection across multiple benchmarks.}
}
@article{HE2026116998,
title = {Scalable multi-objective graph layout via phase-wise optimizations},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116998},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116998},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017247},
author = {Yilei He and Jiansu Pu and Chengjin Shi and Miao Zheng and Hao Jia},
keywords = {Graph layout, Graph neural networks, Training strategy, Multi-objective optimization},
abstract = {Graph layout is a core problem in graph visualization, aiming to produce readable layouts under multiple, often conflicting, aesthetic objectives. Existing methods, including learning-based approaches, commonly rely on weighted loss fusion, which can be sensitive to loss weights and may cause unstable trade-offs and high computational cost. In this work, we formulate GNN-based graph layout learning as a multi-objective optimization problem and propose Phase-wise Multi-objective Optimization (PMO), which decomposes multi-objective training into sequential single-objective phases. Instead of backpropagating all aesthetic losses at every step, PMO activates one objective in each phase, reducing simultaneous multi-loss optimization. We further instantiate PMO with Graph Visualization Layout Model (GVLM), a GNN-based layout framework with a structure-aware edge-weight network. Experiments on the Rome dataset and representative SuiteSparse graphs show that GVLM-PMO achieves competitive multi-aesthetic layout quality with substantially lower training cost than simultaneous multi-objective training strategies. The results also suggest practical scalability under increasing objective complexity and provide qualitative evidence of generalization to unseen larger graphs.}
}
@article{HAQ2026116937,
title = {MGASDNet: Hierarchical framework for enhanced aortic stenosis diagnosis and severity assessment using echocardiographic imaging},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116937},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116937},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016631},
author = {Mohd Anul Haq and Rakesh Kumar Mahendran and Arfat Ahmad Khan and Farman Ali and Jayadev Gyani and Deepak Prashar},
keywords = {Aortic stenosis (AS), Echocardiography, Feature refinement, Multi-graph convolution network (MGCN), Multi-view fusion, Severity prediction},
abstract = {Aortic stenosis (AS) is a critical cardiovascular condition, often diagnosed using echocardiographic views such as parasternal long axis (PLAX) and parasternal short axis (PSAX). While earlier research has made significant strides in automated AS detection, existing models are limited by insufficient feature refinement, inadequate spatial connectivity representation, and a lack of robust multi-view fusion. These limitations hinder precise classification and the accurate identification of severity levels, particularly in cases with subtle anatomical variations. To address these challenges, we propose the Multi-Graph Aortic Stenosis Diagnostic Network (MGASDNet), an innovative model designed to integrate PLAX and PSAX echocardiographic views for AS diagnosis. The model employs a Hierarchical Feature Amplification (HFA) framework, featuring a Spatial Refinement Module (SRM) to reduce scattering noise and enhance spatial details, and an Elementary Feature Refinement (EFR) module for capturing fine textures and boundaries of the aortic valve. The Adaptive Multi-Graph Convolution Network (AMGCN) dynamically constructs multi-graphs to improve spatial connectivity representation by learning adaptive relationships across both views. Precise localisation and coherence are achieved through a Feature Coherence Module (FCM), ensuring seamless integration of features. These are fused using a Channel-Optimised Transformer Feature Integration Network (COTFI-Net), which leverages local graph edge weights and global channel position information. A self-attention mechanism further enhances spatial and channel pattern refinement, culminating in a robust classification layer for accurate AS severity prediction. By integrating enhanced feature extraction, adaptive graph representation, and multi-domain feature fusion, MGASDNet demonstrates the potential to significantly improve the precision and reliability of aortic stenosis diagnosis.}
}
@article{LI2026116974,
title = {Seeing the unseen: Cognitive Visual Imagination for camouflaged object detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116974},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116974},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017004},
author = {Suhang Li and Osamu Yoshie and Yuya Ieiri},
keywords = {Camouflaged object detection, Cognitive visual imagination, Mental template, Foundation model prior, Dual-stream fusion},
abstract = {Camouflaged object detection (COD) aims to segment objects that are seamlessly embedded in their surroundings. However, existing models still struggle with extreme camouflage, where local textures are nearly indistinguishable from the background. Motivated by a cognitive analogy, in which observers reduce perceptual ambiguity by imagining a plausible target appearance before verification, we propose a Cognitive Visual Imagination (CVI) framework. CVI is divided into two stages: (1) Mental Template Generation, which uses the generative prior of a frozen pre-trained image editing foundation model to create a cognitive template that highlights the target while suppressing background distractions; and (2) CVINet, a dual-stream segmentation network that combines the original image with the generated template. To bridge low-level visual cues and high-level cognitive priors, CVINet uses a weight-sharing encoder to extract multi-scale features and introduces two modules inspired by complementary perceptual processes: (i) the cognitive semantic injection (CSI) module, which adaptively injects high-level semantic cues based on cross-stream feature discrepancies, motivated by contrastive perception, and (ii) the cognitive structure refinement (CSR) module, which uses high-frequency priors to bolster structural details and refine object boundaries, analogous to boundary confirmation. Extensive experiments with four widely used COD benchmark datasets show competitive performance. By operationalizing a cognitively inspired “imagine-to-verify” workflow, this study provides an effective and practical approach to camouflaged object detection. The source code is available at https://github.com/suhang2000/CVINet.}
}
@article{DI2026116986,
title = {Uncertainty decomposition and driven training for pre-trained vision models},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116986},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116986},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017120},
author = {Ziqi Di and Mingyang Zhang and Maoguo Gong and Fenlong Jiang and Hanhong Zheng and Yue Wu and Yu Zhou},
keywords = {Uncertainty decomposition, Bayesian neural network, Pre-trained vision model, Uncertainty-weighted loss function},
abstract = {Nowadays, the deployments of deep neural networks (DNNs) in risk-sensitive and safety-critical applications are limited due to challenges in reliability quantification. Existing uncertainty estimation and decomposition strategies need the baseline model to have a specific structure or optimization approach. For the widely used pre-trained frameworks, these requirements restrict their applications on pre-trained DNNs. Moreover, the potential performance improvements that estimated uncertainty can bring to the baseline network are still under investigation. To address these challenges, we propose a straightforward and practical uncertainty estimation strategy for pre-trained vision models by incorporating a local Bayesian approach into the output layer. This modification allows baseline models to estimate and decompose prediction uncertainty with minimal structure changes and additional training burdens. Inspired by the decomposed uncertainty semantic features, we utilize aleatoric uncertainty to re-weight the global loss function and design an auxiliary loss function guided by epistemic uncertainty. We validate the proposed local Bayesian method against existing uncertainty estimation methods on the image classification task. Moreover, we test the uncertainty-driven training performance on pre-trained models in various pixel-wise vision tasks. Experimental results demonstrate that our method significantly improves the performance of the original baselines.}
}
@article{SUI2026117002,
title = {CG-MIA: A Causal Generalization framework for cross-domain graph Membership Inference Attack},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117002},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117002},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017284},
author = {Peipei Sui and Liu Yang and Yuecen Wei and Sitong Liu and Minglai Shao and Xingcheng Fu},
keywords = {Graph Neural Network, Membership Inference Attack, Causal Inference},
abstract = {Graph Neural Networks (GNNs) are increasingly deployed across diverse domains, yet they remain vulnerable to Membership Inference Attacks (MIAs). Existing MIAs predominantly rely on the strong assumption of access to in-distribution shadow datasets. However, this assumption is rarely met in real-world scenarios, leading to significant performance degradation in cross-domain settings where distributionally matched shadow data is unavailable. We identify the root cause of this failure as the adversary’s tendency to overfit environment-specific spurious correlations, particularly the heuristic that high prediction confidence implies membership. For instance, hub nodes characterized by dense connectivity naturally exhibit high confidence due to information aggregation, which traditional attackers erroneously misinterpret as a membership signal. To address this challenge, we propose CG-MIA, a Causal Generalization framework for cross-domain Membership Inference Attack under black-box access. We formulate the graph environment as a confounder introducing spurious structural noise. First, we design a Cross-Domain Causal Deconfounding module. By constructing diverse shadow environments via topology augmentation and employing backdoor adjustment, this module aims to reduce the confounding influence of the graph environment, compelling the adversary to learn invariant membership mechanisms rather than topological shortcuts. Second, we introduce a Membership Uncertainty Calibration module that incorporates Structure Entropy as a regularizer. This quantifies the intrinsic informational complexity of local topology, effectively calibrating prediction confidence to distinguish between structure-induced certainty and genuine membership. Extensive experiments on multiple real-world benchmarks demonstrate that CG-MIA achieves improved performance in most evaluated cross-domain settings compared with existing baselines.}
}
@article{TRAN2026116897,
title = {Developing a near real-time wildfire potential index for the State of Hawaiʻi},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116897},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116897},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016230},
author = {Trang Thi Kieu Tran and Sayed M. Bateni and Matthew Lucas and Keri M. Kodama and Saeid Janizadeh and Hamidreza Vosoughifar and Clay Trauernicht and Ryan J. Longman and Thomas W. Giambelluca and Ehsan Kourkchi and Jared McLean and Sean B. Cleveland and Brennon Morioka},
keywords = {Wildfire potential index (WPI), Hawaiʻi, Metaheuristic algorithms, Random forest (RF), SHAP},
abstract = {Developing a near real-time daily wildfire forecasting system for Hawaiʻi is critical to support wildfire management and protect human life, property, and the environment. This study develops two hybrid random forest (RF) models that integrate novel metaheuristic algorithms, namely Hunger Games Search (HGS) and Moth-Flame Optimization (MFO), to generate a daily Wildfire Potential Index (WPI) in near real time for the counties of Honolulu, Hawaiʻi, Maui, and Kauaʻi. The WPI, expressed on a continuous scale from 0 to 1, characterizes the relative favorability of environmental conditions for wildfire occurrence. Models were trained with six conditioning factors (rainfall, maximum air temperature, relative humidity, normalized difference vegetation index, antecedent precipitation index, and land cover) as inputs, and fire and non-fire points as binary outputs. To address class imbalance, a 1:1 ratio of wildfire to non-wildfire samples was used for training and testing. Across all counties, the MFO-RF model achieved the highest area under the receiver operating characteristic curve (AUC), slightly outperforming HGS-RF and the baseline RF (e.g., AUC = 0.933, 0.931, and 0.924, respectively, in Kauaʻi County). These findings demonstrate that metaheuristic optimization can improve RF hyperparameter selection and predictive performance. Shapley Additive exPlanations (SHAP) were used to interpret the MFO‑RF model. The analysis indicated that the antecedent precipitation index, maximum temperature, and rainfall were consistently among the most influential predictors of modeled wildfire potential across the four counties in Hawaiʻi.}
}
@article{ZHOU2026116973,
title = {PillarTrack: Boosting pillar representation for transformer-based 3D single object tracking on point clouds},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116973},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116973},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016990},
author = {Sifan Zhou and Weisheng Xu and Jiaqi Xiong and Ziyu Zhao and Zhihang Yuan},
keywords = {3D single object tracking, Point clouds, Pillar representation, Vision transformer, Feature encoding},
abstract = {LiDAR-based 3D single object tracking (3D SOT) is a critical issue in robotics and autonomous driving. Existing 3D SOT methods typically adhere to a point-based processing pipeline, wherein the re-sampling operation invariably leads to either redundant or missing information, thereby impacting performance. To address these issues, we propose PillarTrack, a novel pillar-based 3D SOT framework. First, we transform sparse point clouds into dense pillars to preserve the local and global geometrics. Second, we propose a Pyramid-Encoded Pillar Feature Encoder (PE-PFE) design to enhance the robustness of pillar feature for translation/rotation/scale. Third, we present an efficient Transformer-based backbone from the perspective of modality differences. Finally, we construct our PillarTrack based on the above designs. Extensive experiments show that our method achieves comparable performance on the public KITTI and NuScenes datasets, enhancing the performance of the baseline. Code is available in https://github.com/StiphyJay/PillarTrack.}
}
@article{ZITKO2026117010,
title = {Rule-based semantic hypergraph parsing from textual annotations},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117010},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117010},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017363},
author = {Branko Žitko and Ani Grubišić and Daniel Vasić and Lucija Bročić},
keywords = {Semantic hypergraph parsing, Rule-based parsing, Structured semantic representation, Dependency tree, Semantic role labels, Coreference},
abstract = {A semantic hypergraph is a knowledge representation capable of capturing the hierarchical and multi-relational structures essential in natural language. This paper introduces a rule-based semantic hypergraph parser that transforms textual annotations (dependency trees, semantic roles, coreferences) into a semantic hypergraph. The semantic hypergraph parser preserves nested semantic relationships through recursive and ordered hyperedges, integrating predicate-argument structures and coreferences directly into its hypergraph structure. The input textual annotations, the resulting semantic hypergraph representation, and the rule-based transformations applied during parsing are described in detail. The semantic hypergraph parser is evaluated against an existing parser. The qualitative comparison revealed our parser's strengths in handling adverbial modifiers, adjectival clauses, and coreferences. Quantitative evaluation was performed on two datasets: a large-scale corpus of annotated natural language texts, and a manually curated dataset with gold-standard hypergraph annotations. The results show that our parser output achieves almost perfect alignment with gold annotations, outperforming the existing parser by 3–18% on nested representations. After eliminating baseline differences, statistical significance testing confirmed that these improvements were robust across syntactic constructions. We have publicly released our parser to support research on structured semantic representation and to enable practical artificial intelligence applications, including semantic parsing, text mining, and knowledge extraction.}
}
@article{CHU2026117062,
title = {Semi-supervised few-shot remote sensing high-value target identity recognition method based on SHK-LPP manifold transformation and L2-LSFMNet network},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117062},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117062},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017880},
author = {Boce Chu and Xin Wang and Bin Wang and Ruoyan Wei},
keywords = {Remote sensing few-shot recognition, High-value target identity recognition, Siamese feature matching network, Manifold feature transformation, Semi-supervised learning},
abstract = {High-resolution remote sensing has become mainstream for the beyond-visual-range observation of high-value targets in both military and civil domains. However, high-value targets such as aircraft, warships and armored vehicles are often camouflaged for strategic stealth, resulting in clear intra-class differences in top-view observations. Combined with the severe lack of valid labeled samples of high-value targets, these issues bring great challenges to target identity recognition. To address this challenge, this study proposes a semi-supervised few-shot recognition framework that integrates supervised heat kernel locality preserving projection (SHK-LPP) with a lightweight Siamese feature matching network based on the L2 Norm (L2-LSFMNet). First, a variational autoencoder (VAE) is trained using massive unlabeled data to mine the distribution of target features and extract robust initial features. Then, a SHK-LPP supervised manifold transformation algorithm is proposed to enhance the inter-class discriminability of the extracted features by embedding categorical supervision information into the construction of the heat kernel matrix. Finally, the L2-LSFMNet is designed to achieve feature pair matching and target identity determination with a semi-supervised training optimization strategy that learns the nonlinear similarities in the few-shot remote sensing features. Experimental results demonstrate that the proposed method significantly improves few-shot matching accuracy and stability with low computational overhead, effectively mitigating the issue of insufficient training of deep models in few-shot scenarios. It fully capitalizes on the feature-mining capability of unlabeled data and the supervisory guidance of labeled samples to provide an efficient and robust technical solution for few-shot high-value target identity recognition in remote sensing images.}
}
@article{LI2026116978,
title = {PIMA: A manifold-adaptive sequence framework for complex dynamical systems},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116978},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116978},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017041},
author = {Wenjing Li and Fei Wang and Chenglei Han and Lingxiao Liu and Weizhi Xu and Da Wang},
keywords = {Physics-informed neural networks, Parametric partial differential equations, Manifold adaptive, Sequential modeling},
abstract = {Physics-Informed Neural Networks (PINNs) have demonstrated significant potential in solving Partial Differential Equations (PDEs). However, they continue to face challenges in modeling complex time-dependent dynamical systems, particularly the lack of temporal causality and limited generalization ability under varying physical parameters. To address these issues, we propose PIMA, a physics-informed manifold-adaptive sequential modeling framework based on the separable approximation theory of parametric PDEs. PIMA consists of a Manifold Embedding Encoder (MEE) and a Manifold Adaptive Module (MAM). The MEE jointly encodes spatiotemporal coordinates and physical parameters, leveraging a temporal modeling architecture to construct parameter-adaptive latent manifold representations. Meanwhile, the MAM explicitly learns the nonlinear mapping from the parameter space to the solution manifold, enabling precise approximation via a dynamic modulation mechanism. PIMA achieves state-of-the-art accuracy and stability across benchmarks, delivering a 56% reduction in relative L2 error on reaction–diffusion tasks and maintaining robust performance even under 50% coefficient extrapolation. These findings demonstrate that PIMA effectively captures the continuous mapping from parameters to solution manifolds, offering a promising approach for solving complex dynamical systems.}
}
@article{GUO2026116954,
title = {Towards Federated Long-Tailed Graph Learning: An energy-guided dual decoupling approach},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116954},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116954},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016801},
author = {Lianshuai Guo and Zhongzheng Yuan and Xunkai Li and Meixia Qu and Wenyu Wang},
keywords = {Federated Graph Learning, Federated Long-Tailed Learning, Graph Neural Networks, Long-tailed data, Non-IID},
abstract = {Federated Graph Learning facilitates collaborative graph modeling across distributed clients while preserving data privacy. However, real-world data categories frequently exhibit long-tailed distributions. Such statistical scarcity severely degrades performance in two ways: it biases the global model towards majority classes, and it structurally isolates minority nodes by submerging them in heterophilic, head-dominated neighborhoods. While existing methods attempt topology-agnostic statistical compensations, they often fail under data scarcity. Instead of recovering tail nodes, they overfit the structural noise from adjacent dominant classes, leading to representation degradation. To address these limitations, we propose FedEPD, a framework built on a dual decoupling paradigm that separates topological purification from semantic recalibration. Specifically, FedEPD utilizes distribution-aware Dirichlet energy pruning to filter spatial heterophilic edges. It then overcomes Non-IID distribution shifts by extracting robust global prototypes from topologically central nodes on the purified graphs under a secure aggregation protocol, which are incorporated into local representations via a spatial low-pass prototype injection. Furthermore, a two-stage alternating optimization strategy effectively stabilizes majority decision boundaries while improving minority accuracy. Extensive experiments demonstrate that FedEPD achieves highly competitive or superior performance across diverse long-tailed benchmarks, yielding absolute improvements of up to 4.90% in Accuracy and 5.66% in Macro-F1.}
}
@article{ABBAS2026116994,
title = {A novel image authentication scheme using eight-neighborhood difference patterns and evolutionary toss crossover operators},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116994},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116994},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601720X},
author = {Talat Abbas and Takreem Haider},
keywords = {Image integrity verification, Eight-neighborhood descriptor, Toss crossover operator, Medical IoT (IoMT) security},
abstract = {In the Internet of Medical Things (IoMT) ecosystem, preserving the integrity and authenticity of diagnostic imagery is of critical importance, as even minor alterations can lead to severe clinical consequences. We propose a novel high-sensitivity image authentication scheme that integrates a localized eight-neighborhood difference pattern with an evolutionary toss crossover operator. Unlike conventional image hashing schemes, the proposed eight-neighborhood-based code effectively captures fine-grained spatial dependencies and local textural variations within the image. These features are subsequently diffused through a bit-level mixing mechanism, resulting in a cryptographically robust authentication scheme. The security and randomness of the proposed authentication scheme are rigorously evaluated using cipher-grade performance metrics, including information entropy, correlation coefficients, and differential sensitivity analyses. Extensive experiments conducted on various medical imaging modalities and standard benchmark datasets demonstrate that the proposed scheme achieves entropy values ranging from a minimum of 7.9943 to a maximum of 7.9999, with an average value of 7.9976, closely approximating the theoretical optimum of 8. Furthermore, the absolute correlation coefficients in the horizontal, vertical, and diagonal directions remain negligible, with average values of 0.0021, 0.0024, and 0.0029, respectively, indicating a high degree of statistical decorrelation. In addition, the proposed scheme exhibits a strong sensitivity to localized modifications, as evidenced by an average Number of Pixels Change Rate (NPCR) of 99.61% and an average Unified Average Changing Intensity (UACI) of 33.45%. Additional verification using code matching indicates the high reliability of the proposed scheme, achieving False Rejection Rate (FRR) and False Acceptance Rate (FAR) of 0 in a representative suite of malicious attacks including patch replacement, copy-move, content splicing, additive noise injection, and JPEG compression. These results demonstrate that even a single-pixel alteration in the input image induces a pronounced avalanche effect in the resulting code, effectively mitigating forgery, substitution, and replay attacks. Comparative evaluations further reveal that the proposed scheme outperforms state-of-the-art schemes in terms of randomness and tamper sensitivity. In general, the proposed scheme offers a scalable, secure, and highly sensitive solution to ensure data provenance and trustworthiness in distributed healthcare and IoMT environments.}
}
@article{ZHANG2026117015,
title = {Dynamic hierarchical cooperative Snow Ablation Optimizer for global and feature selection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117015},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117015},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017417},
author = {Li Zhang and Xiaobo Chen},
keywords = {Snow Ablation Optimizer, Dynamic population partitioning, Hybrid update strategy, Adaptive local search, Feature selection},
abstract = {To address the limitations of the Snow Ablation Optimizer (SAO) algorithm in solving complex multimodal and composite-structure problems, including slow convergence and susceptibility to local optima, this paper proposes the Hybrid Snow Ablation Optimizer (HGSAO) integrated with a dynamic multi-layer velocity guidance mechanism that integrates a dynamic hierarchical cooperative search mechanism and an adaptive local enhancement strategy. The core contribution of this work lies in the systematic deconstruction and reorganization of the original algorithmic framework through three progressive innovations: First, a dynamic hierarchical mechanism based on individual performance metrics and evolutionary trends is developed, which adaptively partitions the population into three functional subgroups (elite, potential, and ordinary), establishing a structural foundation for subsequent differentiated strategy implementation. Second, a hybrid update model for velocity and position evolution, incorporating historical information and population-state dynamics, is constructed, enabling targeted guided search operations for distinct subgroups to coordinate global exploration and local exploitation effectively. Third, an adaptive local enhancement strategy with dual perception capabilities for iteration progression and convergence status is embedded, which conducts multi-strategy collaborative exploitation in the neighborhood of high-quality solutions during the late algorithmic stages to improve convergence accuracy and stability. A comprehensive experimental evaluation on the IEEE CEC 2022 benchmark suite demonstrates that HGSAO achieves superior optimization accuracy, convergence speed, and robustness across unimodal, multimodal, hybrid, and composite functions, with the Wilcoxon rank-sum test confirming its statistically significant superiority. Furthermore, feature selection experiments conducted across 12 public datasets confirm HGSAO’s effectiveness in high-dimensional classification, achieving higher classification accuracy with reduced feature dimensions, thereby demonstrating strong potential for engineering applications.}
}
@article{HE2026117035,
title = {Shapeleter: Shapelet enhancer via multiview positional embedding for time series classification and extrinsic regression},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117035},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117035},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017612},
author = {Changchun He and Xin Huo and Baohan Mi and Chentao Liu},
keywords = {Shapelet, Time series classification, Time series extrinsic regression, Positional encoding, Multiview fusion},
abstract = {Interpretability and performance in time series supervised learning tasks are now regarded as equally important, spurring extensive interest in shapelets as interpretable knowledge units, class-discriminative subsequences. However, existing shapelet-based time series classification (TSC) and time series external regression (TSER) algorithms overlook higher-order interactions among shapelet candidates and are constrained by single positional encoding and feature representation. To address these limitations, hypergraph learning is integrated into shapelet generation, while multiview position encoding and feature fusion are incorporated into shapelet features to enhance the representational capability of shapelets. Consequently, in this paper, a novel shapelet-based time series representation learning framework, called shapelet enhancer (Shapeleter), is proposed for TSC and TSER tasks, comprising three steps. During the shapelet hypergraph selection-based feature extraction step, shapelet candidates are treated as hypergraph nodes to select discriminative, low-redundant shapelets using node purity and the Jaccard index, and to extract three features per shapelet. In the dual positional encoding-based multiview feature fusion step, the absolute and ordinal position encodings of shapelets and multiview fusion are integrated to embed the global and evolutionary patterns of time series, thereby enhancing feature diversity and expressiveness. In ensemble prediction, the outputs of multiple base predictors across views are integrated via hard voting or mean aggregation to predict the target variable. Extensive experiments on 112 public univariate UCR datasets show that Shapeleter significantly outperforms existing shapelet-based TSC algorithms. Moreover, Shapeleter achieves competitive performance on 28 public univariate TSER datasets. These results demonstrate the effectiveness of the proposed framework in enhancing shapelet representational capability.}
}
@article{JABBAR2026116970,
title = {Sequential ring-topology learning for synthetic Emphysema-proxy chest X-ray classification},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116970},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116970},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016965},
author = {Ayesha Jabbar and Huang Jianjun and Muhammad Kashif Jabbar and Asad Ali},
keywords = {Sequential decentralized learning, Vision transformer, Characteristic-function matching, Synthetic chest X-ray, Emphysema proxy, Non-IID simulation},
abstract = {Medical-image learning is frequently affected by limited data availability, class imbalance, heterogeneous acquisition conditions, and restrictions on sharing patient-level information. This study investigates a controlled synthetic benchmark for Emphysema-proxy versus No-Finding chest X-ray classification. A class-conditional convolutional generator trained with characteristic-function distribution matching was used to construct 4000 synthetic chest X-ray images. The synthetic corpus was partitioned into 5 simulated non-IID clients using ResNet50 feature grouping followed by controlled class-stratified assignment. A Vision Transformer (ViT-B/16) was subsequently trained through sequential client-to-client model propagation over 50 communication rounds. All model training, validation, and evaluation were performed on synthetic images; real NIH ChestX-ray14 images were used only as a weakly labeled reference distribution for fitting the synthetic-image generator. Emphysema was treated exclusively as a weak COPD-related imaging proxy, and No Finding was treated as a weak control label. In the exploratory checkpoint-level analysis, the strongest client trajectory reached 98.50% accuracy, 97.20% precision, 99.00% recall, 98.09% F1-score, 98.70% AUROC, and 98.50% AUPRC. These values summarize the recorded evaluation trajectory: the reported precision and recall are checkpoint-averaged quantities, while the F1-score is derived from those averaged precision and recall values. They do not represent a single frozen-model confusion matrix, pooled global test performance, or independent clinical validation. The study therefore evaluates algorithmic separability and stability within a controlled synthetic non-IID environment. It does not demonstrate recognition of pathology in unseen real radiographs, direct COPD diagnosis, privacy protection, hospital-level federation, diagnostic safety, or deployment readiness. The principal contribution is a transparent synthetic benchmark for studying sequential model propagation under controlled client heterogeneity.}
}
@article{TALAY2026117007,
title = {Algebraic invariant multilayer-network edge regression: Multi-source data fusion with macro-shock immunity},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117007},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117007},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017338},
author = {Necmi Talay and Hakan Acaroğlu and Aslıhan Günal and Fausto Pedro {Garcia Marquez}},
keywords = {Multi-source data fusion, Multilayer networks, Dynamic networks, Spatial econometrics, Common shocks, Internal migration},
abstract = {Various methods have been proposed to study internode interactions, but several deficiencies have been noted in certain concepts in the literature. This study introduces Algebraic Invariant Multilayer-Network Edge Regression (AIMNER), released as a Stata package to address these deficiencies. The flow and interaction templates apply the competing-destinations principle of spatial interaction theory, computing each edge as a share of the source total so that the alternatives enter every edge weight. The attribute template applies the compositional log-ratio, which compares the two endpoint attributes in relative rather than absolute terms. Since the edges are homogeneous of degree zero, they are algebraically invariant to uniform positive multiplicative macro shocks. The property is confined to this class of shocks: it does not cover heterogeneous regional shocks, asymmetric corridor shocks, nonlinear structural breaks, or channel-specific measurement error. The closed-form structure allows the framework to scale to large networks. The framework preserves the heterogeneity of each source-destination edge. The recalculation structure over periods, which includes all interactions within the closed interaction set of network edges, makes the framework applicable to dynamic networks. Since the framework operates at the feature level, it is not dependent on any estimator. The chosen estimator may use instruments for identification and clustered standard errors for inference. Together, these properties make AIMNER a feature-level multi-source data fusion framework that is, in principle, transferable to other systems with directed flows and node attributes. The framework is tested in the context of interprovincial job-seeking migration within Türkiye. Because the evidence comes from a single relational system, transfer to other networked processes is stated as a potential application rather than a demonstrated result. The results obtained in the application are consistent with the literature, showing that birthplace-based social ties are the dominant positive channel. At the same time, unemployment and educational differences function as attribute-based push-pull constraints. In the non-absorbed instrumental variables (IV) benchmark specification, the highway-distance coefficient is negative and smaller in absolute magnitude than the birthplace coefficient.}
}
@article{SONG2026117059,
title = {TopSDH: Topology-regularized semi-conditional latent diffusion with hyperbolically shaped representations for graph generation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117059},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117059},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017855},
author = {Qiurui Song and Maoxin Sun and Xuchu Jiang and Biao Zhang},
keywords = {Graph generation, Latent diffusion, Hyperbolic geometry, Topology regularization},
abstract = {Deep graph generation is important for domains such as drug discovery and social network analysis. Recent latent diffusion models improve sample quality and efficiency, yet they still struggle with (i) discrete optimization and disconnected or structurally miscalibrated outputs during sampling, (ii) information loss in the encode–diffuse–decode pipeline, and (iii) a geometric mismatch between Euclidean latent spaces and non-Euclidean structural patterns observed in many graph datasets. We propose TopSDH, a topology-regularized semi-conditional latent diffusion framework that reduces the gap between continuous latent trajectories and the discrete feasible set. TopSDH operates in three stages: (1) topology shaping with a geometry-aware hyperbolic GraphAE implementation with a variational latent bottleneck, augmented with differentiable topology losses over degree, clustering-related, and spectral statistics; (2) semi-conditional latent diffusion over a latent representation shaped by hyperbolic structure, where the latent variables are decoupled into a diffusible generative subspace and a condition-anchored subspace controlled by cond_ratio; and (3) structural alignment at inference, including logit-shift projection for edge-budget calibration and connectivity-preserving repair to map probabilities to structurally feasible discrete graphs. Across the three benchmarks with baseline coverage (MUTAG, PROTEINS, and IMDB-BINARY), TopSDH is evaluated under the strict protocol using the same generated-sample count and evaluator across seeds. We further evaluate the method on ENZYMES, DD, COLLAB, and a topology-only QM9 subset to examine structural behavior beyond the three benchmark datasets with baseline coverage. The enhanced protocol is reported separately because it uses edge-budget statistics sampled exclusively from the training split and should be interpreted as a system-level calibrated output rather than intrinsic model performance.}
}
@article{DAI2026117019,
title = {Task aligned contrastive Gaussian learning network for infrared small target detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117019},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117019},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017454},
author = {Deen Dai and Bowen Zhang and Xiaochuan Zhang and Zhengwen Shuang and Wenhan Chen and Yu Yu and Qiang Zhong and Huhai Jiang},
keywords = {Infrared small target detection, Normalized Wasserstein distance, Task alignment, Contrastive learning, Gaussian distribution},
abstract = {Infrared small target detection (IRSTD) remains challenging: targets occupy only a handful of pixels and are easily buried in high-brightness clutter, causing standard bounding-box detectors to degrade severely under sub-pixel shifts. Existing methods further suffer from misaligned classification-localization objectives and lack explicit repulsion against hard negative clutter. We propose the Task-Aligned Contrastive Gaussian Network (TACG-Net), which models bounding boxes as 2D Gaussian distributions and adopts Normalized Wasserstein Distance (NWD) to relieve the fragility of IoU at tiny scales; introduces Task-Aligned Gaussian Soft Labels (TAG-SL) to couple classification confidence with geometric alignment via adaptive soft labels; and employs Contrastive Gaussian Learning (CGL) to mine local hard negatives, establishing an attraction–repulsion force field in geometric space. On IRSTD-1K, NUAA-SIRST, and NUDT-SIRST, TACG-Net achieves F1 scores of 0.838, 0.941, and 0.956, surpassing the prior state-of-the-art MPCNet by 3.7 percentage points on average while maintaining a competitive 7.9 ms inference time. Code and data are available at https://github.com/DAIDEEN/TACG.}
}
@article{BAO2026116995,
title = {LiMTrack: Mamba-based long-term temporal information propagation for visual object tracking},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116995},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116995},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017211},
author = {Yiming Bao and Wei Xiang and Yunpeng Liu},
keywords = {Visual object tracking, Temporal information propagation, State space model mamba, Vision transformer},
abstract = {Temporal information between video frames serves as a crucial reference for visual object tracking. However, existing trackers remain limited in leveraging cross-frame temporal cues, with most methods relying only on short-term context from a few adjacent frames and neglecting long-term dependencies across extended video sequences. To address this issue, we propose LiMTrack, which introduces the novel state space model Mamba to propagate long-term temporal information across video frames. Specifically, we introduce a temporal token to convey context information. Furthermore, we design a Long-term Temporal Information Module (LTIM) based on Mamba for transmitting the temporal token along the temporal dimension. These modules are interleaved at different depths of the backbone, propagating temporal information across multiple feature levels. In each LTIM, the temporal token of the current frame serves as the input state to Mamba and is fused with a hidden state carrying prior information to produce an updated temporal token for tracking guidance. The hidden states across multiple LTIMs continuously aggregate target features from the first frame to the current frame at varying depths, providing rich temporal references for feature modeling. By incorporating long-term context at multiple backbone depths, LiMTrack significantly enhances the utilization of temporal information in video streams. Extensive experiments demonstrate that our method achieves competitive performance on six tracking benchmarks. Specifically, on the LaSOText benchmark, it surpasses the latest SOTA trackers by 0.5% in AUC, 1.3% in Pnorm, and 0.5% in P, respectively.}
}
@article{WANG2026116930,
title = {Counterfactual incremental defense against poisoning attacks},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116930},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116930},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016564},
author = {Haofan Wang and Farah Kandah},
keywords = {Poisoning attacks defense, Network security, Incremental update, Counterfactual computation},
abstract = {In recent years, with the rapid development of large language models, the threat of poisoning attacks has become increasingly severe, as even a small proportion of malicious data can significantly alter a model’s behavior. Although many defense methods have been proposed, each has its own limitations. In this work, we propose Counterfactual Incremental Defense against Poisoning Attacks (CIDPA), which combines counterfactual metrics with incremental updates to achieve a continuous, robust defense. Specifically, we compute the minimal counterfactual cost to estimate, for each new sample, the smallest feasible change required to flip the model’s current prediction. The model is then updated progressively using a sliding window mechanism. Because counterfactual costs typically exhibit relatively stable statistical patterns under clean conditions, CIDPA monitors window-level distributional statistics to detect potential contamination. When the window exhibits normal or mild poisoning, the system operates in the within-window mode, where counterfactual metrics are standardized and analyzed locally to filter subtle anomalies. However, when the degree of poisoning becomes severe and the window distribution is no longer reliable, CIDPA automatically switches to cross-window mode, using statistical patterns from clean historical windows as a reference baseline. This switching mechanism prevents the model from self-contamination and ensures stability even under large-scale poisoning. In the experiments, we intentionally manipulated the datasets to simulate three different poisoning attack scenarios. Across varying proportions of poisoned data, our proposed CIDPA framework consistently achieved strong defense performance and outperformed two existing poisoning defense methods in most evaluated settings.}
}
@article{ZHOU2026116975,
title = {PDCC-MER: Progressive denoising and calibrated consensus learning for multimodal emotion recognition},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116975},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116975},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017016},
author = {Xin Zhou and Xiang Shen and Dezhi Han and Yangshuyi Xu and Xiaoqi Xin and Kuan-Ching Li},
keywords = {Multimodal emotion recognition, Reliable consensus learning, Progressive label refinement, Multimodal consensus, Reliability calibration},
abstract = {Multimodal emotion recognition seeks to infer human affective states from heterogeneous cues, including linguistic content, acoustic prosody, and visual behavior. However, reliable prediction remains challenging when noisy supervision, cross-modal semantic inconsistency, and modality-quality imbalance coexist and affect different learning stages. Random modality absence and cross-modal misalignment reflect modality-quality imbalance and semantic inconsistency, respectively. These factors may bias unimodal representation learning, weaken cross-modal relation modeling, and make the final decision overly dependent on a dominant but not always reliable modality. To address these challenges, we propose PDCC-MER, which formulates unreliable multimodal consensus as a stage-coupled reliability problem across supervision formation, relation propagation, and decision calibration. Specifically, TPLR combines perturbation, EMA-teacher correction, and momentum memory to progressively stabilize pseudo-supervision; PCRP performs residual multi-step relation composition to capture indirect cross-modal dependencies; and RCCR combines uncertainty-derived priors with learned routing evidence to calibrate modality contributions. PDCC-MER neither reconstructs missing modalities nor performs fine-grained temporal realignment, but mitigates downstream degradation from incomplete or inconsistent evidence. Extensive experiments on CH-SIMS, CH-SIMS v2, CMU-MOSI, and CMU-MOSEI demonstrate that PDCC-MER achieves competitive performance with consistent improvements under the controlled comparison protocol. Controlled evaluations on CH-SIMS and CMU-MOSI under modality absence, noise, random text absence, and text misalignment demonstrate condition-specific adaptability. Operation-level controlled comparisons and further analyses show that the complete mechanisms outperform their simplified and standard alternatives while yielding more stable pseudo-supervision, structured representations, and reliability-aware routing. The code is publicly available at: https://github.com/zhouxin829/PDCC-MER.}
}
@article{LI2026117027,
title = {RIM: A Retrieval-In-Matching framework for cross-domain global visual localization of UAVs},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117027},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117027},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017533},
author = {Xin Li and Siyuan Duan and Shang Wang and Zhimin Mao and Bingliang Hu and Geng Zhang},
keywords = {UAV global visual localization, Cross-domain visual place recognition, Vision foundation model, 3D Tiles database, Retrieval and re-ranking},
abstract = {Global visual localization of unmanned aerial vehicles (UAVs) using remote-sensing reference maps has attracted increasing attention. However, differences in acquisition time and imaging platform between UAV and reference imagery introduce substantial cross-domain appearance and viewpoint shifts, challenging robust six-degree-of-freedom (6-DoF) pose estimation. To mitigate these shifts, we render UAV-viewpoint references from Google 3D Tiles across locations, altitudes, and orientations. A two-stage strategy adapts SALAD with pose-near positives and geographically distant hard negatives; local geometric consistency then re-ranks the Top-K candidates. We further propose Retrieval-In-Matching (RIM), which freezes the adapted DINOv2-B retriever and distills a local-descriptor decoder from its token field and a shallow VGG19 detail stream. One query-side DINOv2-B backbone forward therefore supports both SALAD retrieval and local description, eliminating a second foundation-model backbone while preserving the retrieval descriptors by construction. We evaluate RIM zero-shot on the reconstructed EPFL Urbanscape and self-collected Chang’an Park datasets, both geographically disjoint from the training data. RIM outperforms ten retrieval baselines. Under the full 3D distance metric at 25/50m, it improves Recall@1 over SALAD by 8.55/13.77 percentage points on EPFL and 4.45/8.94 points on Park. At Top-K=5, the measured online query path through retrieval, candidate matching, and robust geometric verification takes 90.8ms: 1.2× faster than the strongest separate sparse-matching baseline and over 30× faster than RoMa, while maintaining comparable re-ranking accuracy. These results demonstrate an efficient UAV global visual localization pipeline under unreliable satellite navigation.}
}
@article{BABAR2026117003,
title = {HuddsTrafficFL: A benchmark testbed and dataset for Byzantine-robust federated learning in urban traffic systems},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117003},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117003},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017296},
author = {Farah Farid Babar and Saad Khan and Simon Parkinson},
keywords = {Federated learning, Byzantine robustness, Anomaly detection, Dataset, Testbed, SUMO simulation, Intrusion detection, Intelligent transportation systems, Benchmark, Non-IID data heterogeneity},
abstract = {Federated learning (FL) enables collaborative model training without sharing raw data, making it suitable for privacy-sensitive applications such as intelligent transportation systems and distributed Internet of Things (IoT) environments. However, evaluating Byzantine-resilient FL under realistic deployment conditions remains challenging. Existing benchmark datasets are mainly based on image classification or generic network intrusion tasks and often fail to capture geographically distributed clients, naturally occurring non-IID data, sensor-derived anomaly labels, and integrated Byzantine attack evaluation within a unified framework. To address this limitation, we present HuddsTrafficFL, a reproducible benchmark dataset and evaluation framework developed from a city-scale traffic sensing environment using SUMO/TraCI simulations and OpenStreetMap road networks. HuddsTrafficFL provides three core contributions: (1) a geographically grounded federated learning dataset containing 91,482 timestep observations collected from 292 clients, capturing natural non-IID characteristics and heterogeneous data distributions; (2) sensor-derived anomaly labels generated directly from junction-level traffic behaviour, including sudden speed reductions and abnormal queue growth patterns; and (3) a configurable Byzantine attack and defence evaluation pipeline that enables reproducible robustness assessment across multiple datasets. To the best of our knowledge, HuddsTrafficFL is the first benchmark that simultaneously integrates geographically grounded FL clients, sensor-derived anomaly labels, natural non-IID data characteristics, and Byzantine attack evaluation within a single reproducible environment. We evaluate four representative Byzantine attacks and three aggregation strategies: FedAvg (undefended baseline), Krum and Coordinate Median (robust methods) across HuddsTrafficFL, CICIDS2017, and BoT-IoT. Experimental results show that standard FedAvg achieves an AUC of 0.6706 under model poisoning with a 25% attacker fraction per round, whereas coordinate median consistently achieves an AUC of at least 0.9874 across all evaluated attack-dataset combinations. The baseline federated model on HuddsTrafficFL achieves an AUC of 0.9683, demonstrating that the benchmark provides realistic learning conditions and meaningful robustness evaluation. The dataset, simulation pipeline, interactive dashboard, and benchmark scripts will be publicly released to support reproducible research on secure federated learning for intelligent transportation systems and distributed sensing applications.}
}
@article{LI2026117076,
title = {BiSVNet: Bidirectional cross-gating and spatial vertical perception enhancement for multi-modal 3D object detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117076},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117076},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018022},
author = {Jiabo Li and Daqian Zhang and Di Tian and Xuekai Lin},
keywords = {3D object detection, Multimodal fusion, Bidirectional cross-gating, Vertical perception enhancement, Environmental perception},
abstract = {Integrating LiDAR point clouds with camera images for 3D object detection is crucial for enhancing perception system performance. To address the limited reciprocal recalibration of cross-modal features and the underutilization of vertical spatial information, this study proposes a 3D object detection framework based on the BiSVNet architecture. The framework incorporates a Bidirectional Cross-Gating Fusion Module (BiCG) and a Spatial Vertical Perception Enhancement Module (SVP). The BiCG module performs reciprocal feature recalibration between LiDAR and image features through sigmoid-based gating, effectively leveraging cross-modal complementarity and enabling bidirectional information exchange. The SVP module derives a pillar-level vertical-position prior from point-cloud observations and uses it to perform channel-wise feature recalibration, thereby strengthening height-aware geometric representation. The BiCG module is embedded at multiple stages of the geometric flow encoder to enhance cross-modal feature interaction, while the SVP module is incorporated at the decoder stage to strengthen height-aware feature representation. Together, these components form the BiSVNet framework, achieving end-to-end 3D object detection. Quantitative evaluations on the KITTI benchmark show that, compared with the reported results of VirPNet, a representative virtual-point-based multimodal method, BiSVNet achieves improvements of 2.45%, 0.58%, and 0.49% in 3D AP under the Easy, Moderate, and Hard settings, respectively. These results demonstrate the competitive performance of the proposed method under the adopted evaluation protocol.}
}
@article{QIU2026116942,
title = {A knowledge-aware graph-based framework for document-level event extraction},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116942},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116942},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016680},
author = {Xiaoping Qiu and Yuchi Yang and Jun Liu and Ke Yang and Andrew Lim},
keywords = {Knowledge extraction, Document-level event extraction, Knowledge representation, Graph neural networks, Information extraction},
abstract = {This paper addresses the problem of document-level event extraction as a critical step toward automated knowledge acquisition for intelligent systems. Extracting structured event knowledge from unstructured text is essential for downstream knowledge-based applications such as knowledge graph construction, decision support, and intelligent question answering. However, existing approaches struggle to effectively capture long-range dependencies and complex inter-event relationships within documents while maintaining computational efficiency. To address these challenges, we propose a novel knowledge-aware framework, the Graph Convolutional Network with Pseudo-trigger Combination Recognition (GCN-PCR). The proposed model explicitly represents entities, mentions, and sentences as interconnected nodes in a relational graph, enabling structured modeling of semantic dependencies and co-reference information across document contexts. Furthermore, the pseudo-trigger combination strategy enhances the identification of event structures by improving the robustness of event boundary detection and argument association. Extensive experiments on two public datasets demonstrate that the proposed approach achieves superior performance compared to state-of-the-art methods. More importantly, our framework provides a scalable and effective solution for transforming unstructured textual data into structured event knowledge, facilitating its integration into knowledge-based systems.}
}
@article{XUE2026116979,
title = {Beyond static frequency decomposition: Dynamic time frequency mixing for time series forecasting},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116979},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116979},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017053},
author = {Linjing Xue and Zhiquan Huang and Jiazhe Wang and Jiayi Chang and Xiaozheng Li and Ruijuan Zheng},
keywords = {Time series forecasting, Frequency domain analysis, Multi-scale learning, Time frequency fusion},
abstract = {Time series forecasting is fundamental to many real-world applications, where accurately modeling periodic patterns and trend dynamics is critical for reliable prediction. Existing methods mainly rely on temporal-domain modeling, underutilize spectral information, and often adopt static time-frequency fusion schemes, which limits their ability to capture complex non-stationary patterns across multiple temporal scales. To address these issues, we propose DTFMixer, a unified forecasting framework based on dynamic time-frequency mixing. DTFMixer adaptively estimates the importance of frequency components through learnable spectral weighting, enabling the selective preservation of predictive frequencies while suppressing noise. It further introduces a spectrally guided gated fusion module to enhance cross-domain representation learning between temporal and spectral features, and employs multi-scale fusion to jointly capture short-term variations and long-term trends. Extensive experiments on twelve real-world datasets demonstrate that DTFMixer consistently outperforms competitive baselines in forecasting accuracy while maintaining strong robustness and efficiency. The source code is available at https://github.com/tsfanon/DTFMixer.}
}
@article{ZHOU2026117031,
title = {Perturbated Model Consistency for generalization-enhanced domain adaptive object detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117031},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117031},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017570},
author = {Wenlve Zhou and Xinghao Huang and Zhiheng Zhou and Chang Niu and Weibin Wu and Xiangwei Li},
keywords = {Unsupervised domain adaptation, Object detection, Parameter perturbation},
abstract = {Object detection plays a pivotal role in real-world visual applications such as autonomous driving. However, domain shift from changes in weather, lighting, or sensor types limits their effectiveness. Unsupervised Domain Adaptation (UDA) tackles this by transferring knowledge from annotated source domain to unannotated target domain, improving detection in diverse scenarios. Despite its success, limited research has explored the role of model smoothness in ensuring robust adaptation. Smoothness, achieved via gradient regularization during optimization, is critical for enhancing generalization. We believe that model smoothness enhances generalization and improved generalization strengthens transfer learning, ultimately boosting UDA performance. To address this, we propose Perturbated Model Consistency (PMC), a generalization-enhanced method in UDA object detection. By introducing parameter-level perturbations, PMC simulates a worst-case scenario using source domain knowledge and penalizes prediction disparity on unlabeled target data for effective transfer learning. Minimizing prediction disparity between the original and perturbated models smooths the parameter-loss landscape, facilitating domain-invariant feature extraction. Experiments across cross-domain road-driving scenarios highlight PMC’s consistent superiority over existing methods.}
}
@article{BAO2026117011,
title = {SurveyAgent-HKA: A multi-agent framework for scientific survey generation with LLMs and human knowledge augmentation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117011},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117011},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017375},
author = {Tong Bao and Mir Tafseer Nayeem and Yi Zhao and Davood Rafiei and Chengzhi Zhang},
keywords = {Scientific survey generation, Large language models, Human knowledge augmentation, Multi-agent collaboration, AI-assisted scientific writing},
abstract = {Automatic scientific survey generation has become an important task in scientific document processing. The common approach of retrieving literature from a single source (e.g., arXiv) and generating surveys through a one-pass large language model (LLM) call often leads to limited reference coverage and, more importantly, fails to replicate the expert-driven revision process that is crucial for writing high-quality surveys. In this paper, we introduce SurveyAgent-HKA, a multi-agent framework that improves end-to-end scientific survey generation by incorporating knowledge derived from published surveys and peer-review comments. The framework decomposes survey generation into well-defined sub-tasks handled by LLM-powered agents. It first retrieves relevant papers from multiple sources and identifies key topics through clustering to construct an initial outline, which is then refined using outlines from related human-written surveys. Based on the refined outline, topic-focused papers are retrieved and re-ranked to select representative papers for survey drafting. Then, we identify common issues raised by experts in peer-review comments from published surveys to guide the revisions and finalize the survey. Experiments on two domains show that our approach outperforms mainstream baselines in citation quality, structural consistency, and content quality. Furthermore, our framework is efficient in both time and cost, making it a practical solution for broader AI-assisted scientific writing applications.}
}
@article{TAO2026116987,
title = {APDRFormer: Asymmetric Perception Decoupling and Recovery Transformer for multi-modal 3D object detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116987},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116987},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017132},
author = {Chongben Tao and Tongjing Sun and Chen Wang and Tianyang Xu and Muwei Jian and Zhen Gao and Feng Cao and Zhiyong Yu},
keywords = {Multi-modal fusion, 3D object detection, Transformer, Bird’s Eye View, Autonomous driving},
abstract = {In multi-modal 3D object detection, perception asymmetry between camera and LiDAR is observed. Consequently, effective instance cues from the weaker modality are suppressed during BEV fusion. Therefore, modality conflict between classification and regression tasks is induced. Accordingly, an Asymmetric Perception Decoupling and Recovery Transformer is proposed. The novelty lies in jointly recovering fusion-suppressed instance cues and decoupling the modality preferences of classification and regression within a unified framework. Firstly, BEV features are aligned by semantically guided bidirectional optical flow field. Then, local details and global context are jointly modeled by window attention. A reliable basis for subsequent instance recovery is provided. Secondly, a lost instance recovery algorithm is proposed. High-confidence responses suppressed during fusion are mined and recovered. Contextual information of instance is aggregated through deformable attention. Then, the suppressed information is written back into the fused features via cross-attention. Finally, a dual-path task-adaptive decoder is designed. Dedicated feature pathways are constructed separately for classification and regression. Task collaboration is preserved and optimization conflicts are alleviated. Experiments are conducted on the nuScenes and KITTI datasets. On nuScenes test set, 75.4% NDS and 73.2% mAP are achieved. Moreover, robustness in complex traffic scenarios and deployment feasibility are validated on a real-vehicle platform. Code will be available at https://anonymous.4open.science/r/APDRFormer-1048/.}
}
@article{GOYO2026117023,
title = {Improving negative generation for self-supervised triplet-based time series classification},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117023},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117023},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017491},
author = {Manuel Alejandro Goyo and Ricardo Ñanculef and Carlos Valle},
keywords = {Time series classification, Semi-supervised learning, Self-supervised, Negative sampling, Triplet loss, Convolutional Neural Networks},
abstract = {Self-supervised learning (SSL) has proven effective for training time series classifiers under limited labeled data. Among SSL approaches, triplet-based methods, comprising an anchor (reference), positive (similar), and negative (dissimilar) example, have been largely avoided due to the high computational cost of sampling sufficiently discriminative negatives. Instead, most SSL techniques rely on pairwise losses with examples generated via data augmentations. Recent advances circumvent triplet cost generation using unsupervised operations like masking and MixIng. In this paper, we advance this paradigm by devising a method that synthesizes the negative in a more effective yet equally efficient way. Our method combines time series inversion with MixIng via linear interpolation between the anchor and inverted series. While these operations have prior use in SSL, our method represents their first empirical integration to form unsupervised triplets that circumvent hard negative mining. The key insight is that these operations can be used in a complementary way: time series inversion generates training points far from the original anchor’s class support, while MixIng brings them closer to the decision boundary, forcing the model to learn discriminative representations. Though time series inversion alone achieves competitive performance, experiments demonstrate that our method outperforms state-of-the-art methods in most scenarios spanning diverse datasets and label availability regimes. These results demonstrate triplet-based training as feasible and effective for SSL time series classification when equipped with properly designed unsupervised operators.}
}
@article{YANG2026116983,
title = {DIR-Net: A disentangled implicit routing network for effective time series forecasting},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116983},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116983},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017090},
author = {Jiaxue Yang and Yutong Wang and Zhongfeng Kang and Shaoyi Zong and Shantian Yang and Lihui Deng and Zichen Song},
keywords = {Time series forecasting, Tensor product attention, Seasonal pattern capturing, Adaptive feature gating, Kolmogorov-Arnold network},
abstract = {Time series forecasting underpins numerous real-world applications, such as energy management, financial trading, and climate monitoring. However, most existing architectures either process trend and seasonal components in a homogenized manner or depend on fixed fusion strategies, limiting their ability to model the heterogeneous temporal dynamics inherent in complex sequences. To address these challenges, we propose the Disentangled Implicit Routing Network (DIR-Net), a lightweight yet expressive framework that combines disentangled dual-pathway modeling with adaptive feature routing. DIR-Net introduces a Disentangled Temporal Encoder (DTE) that explicitly separates global trend extraction from local seasonal pattern learning. The DTE incorporates two complementary branches: (i) a Disentangled Temporal Attention Module (DTAM) built upon RoPE-enhanced attention and a memory-augmented LSTM for robust long-range trend modeling and (ii) a Dilated Causal Convolution (DCC) pathway designed to effectively capture short-term seasonal variations. Moreover, we enhance Tensor Product Attention(TPA) with Rotary Position Embeddings, yielding the RoPE-TPA mechanism, which significantly improves position-aware sequence modeling while preserving linear computational complexity. Extensive experiments on nine benchmark datasets demonstrate that DIR-Net achieves state-of-the-art performance, surpassing seven competitive baselines with average MSE=0.640 and MAE=0.586. Notably, DIR-Net delivers strong accuracy–efficiency trade-offs, requiring only 53.30K parameters and 429.78K FLOPs. Owing to its modular and lightweight design, DIR-Net is well suited for deployment in resource-constrained environments and can be easily adapted across application domains. Code will be made available at: https://github.com/kanglzu/DIR-Net.}
}
@article{LUO2026116971,
title = {SF-MDS: A Sparse Fusion of Mixed-Distance Scales for 3D object detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116971},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116971},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016977},
author = {Xizhao Luo and Chao Zhang and Chongben Tao and Zhen Gao and Tian Wang and Fengjun Xiao and Feng Cao},
keywords = {Multimodal fusion, 3D object detection, Autonomous driving, Mixed-distance scales, Sparse transformer},
abstract = {The uneven density distribution of multimodal data caused by spatial distance variations often degrades feature-matching quality. To address this issue, this study proposes a sparse fusion of mixed-distance scales (SF-MDS) algorithm for three-dimensional (3D) object detection. First, point clouds are divided into near-field and far-field subsets according to object depth using an image-frustum separation module. Second, mixed-distance voxel features are extracted using a mixed-distance scales normalization module after applying different downsampling strategies to the separated point clouds. Next, the sparsity of voxels is exploited in combination with a sparse multi-axis window transformer to effectively capture sparse voxel features. Finally, a multi-weight dynamic fusion module is used to perform adaptive weighted matching of cross-modal features through modal correlation evaluation, thereby achieving accurate 3D object detection. Extensive experiments on the KITTI, nuScenes, and Waymo Open datasets demonstrate that SF-MDS achieves competitive detection performance across different autonomous driving benchmarks. Notably, on the Waymo Open dataset LEVEL_1 ”50m-Inf” long-distance detection task, SF-MDS achieves 71.57% mAP and 70.18% mAPH. In addition, real-world road-scene testing on a vehicle platform demonstrates the deployment feasibility of the proposed algorithm in complex traffic scenarios.}
}
@article{FAN2026117016,
title = {Multi-branch structure learning for weakly supervised temporal action localization},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117016},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117016},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017429},
author = {Fangxuan Fan and Jinfu Yang and Yating Guo and Xinni Wang},
keywords = {Weakly supervised temporal action localization, Temporal structure learning, Multi-branch framework, Boundary localization},
abstract = {Weakly supervised temporal action localization (WTAL) aims to simultaneously recognize action categories and localize their temporal boundaries in untrimmed videos using only video-level annotations. However, due to the absence of precise temporal supervision, existing methods often rely on a few highly activated segments for classification. This tendency leads to fragmented predictions along the temporal dimension and makes it difficult to accurately capture the start and end boundaries of actions. To address this issue, this paper proposes a multi-branch temporal structure learning framework that models the temporal structure of videos from three complementary perspectives: action priors, temporal context, and segment-level structural differences. In addition, a mask-guided multiple instance learning (MIL) strategy is introduced to encourage the model to focus on action segments that are both semantically consistent and temporally coherent, thereby improving localization completeness and boundary discrimination under weak supervision. Specifically, our approach achieves an average mAP of 50.1% on THUMOS14, outperforming the best existing method, and 29.1% on ActivityNet1.2, demonstrating competitive performance among existing state-of-the-art approaches.}
}
@article{WANG2026116976,
title = {Structure-aware and parameter-efficient framework for editing LM-based knowledge graph embeddings},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116976},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116976},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017028},
author = {Mingjie Wang and Jianhou Gan and Wenqi Ren and Jun Wang and Zijie Li and Juxiang Zhou},
keywords = {LM-based KGE, Knowledge editing, Parameter-efficient learning},
abstract = {Knowledge graph embeddings (KGEs) backed by pretrained language models (PLMs) have emerged as a dominant paradigm for reasoning over complex semantics. However, efficient updating of real-world facts within these static models remains a critical challenge. While generic knowledge editing methods for PLMs exist, they typically treat facts as isolated strings, failing to preserve the structural integrity and geometric constraints intrinsic to knowledge graphs. In this study, we propose a novel structure-aware and parameter-efficient framework specifically designed for editing LM-based KGEs. Our approach introduces three grounded mechanisms: Locality-Aware Regularization, which explicitly constrains the divergence of the embedding manifold to prevent structural collapse in topological neighborhoods; Low-Rank Editing Transformation, which exploits the low intrinsic dimensionality of factual updates to ensure compact and stable modifications; and a Relation-Aware Editing Gate, a semantic modulator that adaptively adjusts editing plasticity based on relational heterogeneity. Extensive experiments on standard benchmarks demonstrate the superiority of our approach; notably, on the E-FB15k-237 dataset, our method improved editing reliability (Succ@1) by 4.0% while reducing trainable parameters by over 58% compared to state-of-the-art baselines, achieving a favorable trade-off between plasticity and stability.}
}
@article{WU2026116963,
title = {Constructing knowledge graphs by Large Language Models: Methodology, practice, and challenges},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116963},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116963},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016898},
author = {Jiaxin Wu and Shanshan Huang and Zherui Zhang and Yuan Wang and Shu Wang and Ming Liu and Guoxin Su and Li Liu},
keywords = {Knowledge graphs, Large Language Models, Fine-tuning, Prompt engineering, Domain-specific knowledge graphs},
abstract = {Knowledge graph (KG) construction is a fundamental task for organizing structured knowledge and supporting intelligent applications. Recent advances in Large Language Models (LLMs) have substantially enhanced KG construction by improving semantic understanding, information extraction, and reasoning, thereby driving a shift from traditional pipeline-based methods toward LLM-driven frameworks. This transformation calls for a timely and systematic survey. In this survey, we provide a comprehensive review of the entire lifecycle of LLM-based KG construction, covering three core tasks: triple extraction (TE), knowledge fusion (KF), and knowledge graph completion (KGC). We further propose a unified taxonomy based on LLM integration strategies, categorizing existing methods into three paradigms: prompt engineering, parameter fine-tuning, and hybrid model collaboration. Based on this taxonomy, we systematically analyze representative techniques and their application scenarios across different stages of KG construction. In addition, we summarize 16 publicly available datasets and three widely used evaluation metrics, i.e., precision, recall, and F1-score, and discuss evaluation challenges in LLM-based KG construction. Through comparative experiments on 28 representative methods, we further analyze the strengths and limitations of different paradigms. We also discuss the extension of LLMs to domain-specific and multimodal KG construction. Finally, we summarize the current challenges and opportunities in this field and outline promising directions for future research.}
}
@article{LEE2026116984,
title = {Adversarial graph contrastive learning with topology-aware multimodal fusion for cross-domain emotion recognition},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116984},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116984},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017107},
author = {Joon Young Lee and Dae Hyeon Kim and Young-Seok Choi},
keywords = {Multimodal emotion recognition, Graph contrastive learning, Domain adversarial training, Topology-aware representation, Sample-level physiological manifold},
abstract = {Multimodal emotion recognition leveraging electroencephalography (EEG) and eye-movement (EM) signals is a fundamental component in affective computing. However, modeling the cross-modal correlations between heterogeneous modalities and mitigating the domain shifts caused by individual physiological variability and temporal measurement fluctuations remain significant challenges. In this paper, we propose a framework, Multimodal Domain Adversarial Graph Contrastive Learning (MDA-GCL), to address these issues in cross-subject and cross-session scenarios. Specifically, we first introduce a Symmetric Similarity Network Fusion (SSNF) strategy to construct a unified multimodal graph, which serves as a structured sample-level affinity manifold representing the complementary physiological dynamics between the central and peripheral nervous systems. To counteract the risk of negative transfer — where forced domain alignment inadvertently blurs emotion class boundaries — we integrate a Domain-Adversarial Neural Network (DANN) with Graph Contrastive Learning (GCL). While GCL extracts task-relevant perturbation-invariant representations to preserve class separability, DANN simultaneously reduces domain-specific nuisance biases via minimax optimization. Experiments on the SEED-IV and SEED-V datasets show that MDA-GCL achieves 76.1% and 83.8% on SEED-IV, and 75.6% and 82.5% on SEED-V under batch-wise transductive cross-subject and cross-session protocols, respectively. The topology and module ablations indicate that the performance gains arise from the combined effect of the SSNF-based graph representation and the downstream GCL–DANN joint learning objective rather than from any single component alone. The implementation of MDA-GCL and the experimental configurations used in this study are publicly available at GitHub: https://github.com/LeeJY-KW/MDA-GCL.}
}
@article{LV2026116951,
title = {Spatial–spectral interactive learning network via adaptive information integration for hyperspectral image fusion},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116951},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116951},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016771},
author = {Guohua Lv and Juncan Wang and Baodong Zhang and Yongbiao Gao and Wei Li},
keywords = {Hyperspectral image, Image fusion, Adaptive information integration, Spatial–spectral interaction learning},
abstract = {Hyperspectral image fusion aims to combine the complementary spatial and spectral information from high-resolution auxiliary images to generate high-resolution hyperspectral images with enhanced spatial details. However, the substantial differences in spatial and spectral characteristics between hyperspectral and auxiliary modalities often cause existing methods to overlook their inherent relationships, leading to suboptimal integration of key information. Furthermore, inadequate modeling of spatial–spectral relationships results in poor detail recovery and spectral distortion in reconstructed hyperspectral images. To address these issues, we propose a spatial–spectral interactive learning network (SSIL-Net) via adaptive information integration for the fusion of hyperspectral, multispectral, and panchromatic images. Specifically, we design an adaptive information integration block to effectively handle heterogeneous modalities, in which an adaptive feature integration module performs pairwise fusion to preserve discriminative features across different inputs. In addition, we design a spatial–spectral interactive learning block that hierarchically fuses rich spatial information while ensuring spectral consistency. This block incorporates a spatial–spectral interactive fusion module that explicitly explores spatial–spectral relationships for interactive feature fusion. Extensive experiments demonstrate that SSIL-Net achieves the best quantitative results among the compared methods on three simulated datasets and competitive performance on a real-world dataset. The source code and datasets are publicly available at https://github.com/Zhang-bd/SSIL-Net.}
}
@article{HUANG2026116996,
title = {KnowScene: A knowledge-guided framework for adaptive 3D scene understanding with reinforcement reasoning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116996},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116996},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017223},
author = {Ting Huang and Weibing Wan and Zhijun Fang},
keywords = {3D scene understanding, Vision–language model, Knowledge-guided reasoning, Reinforcement learning, Dynamic view selection},
abstract = {Knowledge-guided reasoning offers a promising approach to enhancing multimodal intelligence in complex 3D environments. However, existing 3D vision–language models (VLMs) often exhibit limited spatial reasoning and generalization capabilities because of insufficient reasoning supervision and reliance on fixed viewpoint configurations. To address these limitations, we introduce KnowScene, a knowledge-guided framework that integrates structured chain-of-thought (CoT) supervision with reinforcement reasoning based on Group Relative Policy Optimization (GRPO). To provide structured supervision for model initialization, we construct a large-scale synthetic dataset, KnowScene-60K, using a rule-based data engine that generates and filters CoT samples from multiple 3D vision–language corpora. During reinforcement fine-tuning, KnowScene jointly optimizes perceptual grounding, semantic alignment, and format consistency through a multi-signal reward mechanism. An adaptive view selection module further strengthens cross-modal correspondence by dynamically prioritizing task-relevant viewpoints. Extensive experiments on ScanRefer, Nr3D, and ScanQA demonstrate that KnowScene achieves an average improvement of 7.3% over the strongest competing baselines across the primary evaluation metrics for 3D dense captioning, question answering, and visual grounding. These results demonstrate that KnowScene consistently improves reasoning coherence and spatial understanding across diverse 3D vision–language tasks.}
}
@article{MA2026116991,
title = {STAR-GS: Spatial topology and rendering geometry unification for memory-efficient active 3D mapping},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116991},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116991},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601717X},
author = {Hui Ma and Lei Wang and Weifeng Su and Jun Cheng},
keywords = {Active mapping, Octree, 3D Gaussian splatting},
abstract = {Active 3D reconstruction enables an embodied agent to select informative observations while building a scene representation. Existing active neural mapping systems often maintain separate structures for rendering, occupancy reasoning, and navigation, which increases memory use and synchronization cost during exploration. We present STAR-GS, a framework that associates probabilistic topological attributes and neural Gaussian anchors with the same adaptive octree nodes. The shared hierarchy supports normalized uncertainty aggregation for next-best-view selection, extraction of reachable free-space topology for collision-aware path generation, and observation-driven coarse-to-fine anchor allocation under an online resource budget. On Replica and Matterport3D, STAR-GS achieves competitive novel-view rendering while improving geometric completeness relative to the evaluated active reconstruction baselines. Under the reported MP3D protocol, it uses 5.15 GB peak VRAM and requires an average of 5.58 ms per planning step.}
}
@article{CHANG2026117012,
title = {A reflection-enhanced LLM literature-to-design framework for surrogate-guided inverse design of high-entropy alloys},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117012},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117012},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017387},
author = {You-Xun Chang and Kuan-Hung Chao and Yi-Chen Wang and Yi-Hsiang Chen and Fan-Yi Ouyang and Shun-Chi Wu},
keywords = {Intelligent materials design, Large language models, Literature mining, Surrogate-assisted inverse design, High-entropy alloys},
abstract = {High-entropy alloys (HEAs) exhibit exceptional mechanical strength, thermal stability, and corrosion resistance; however, their vast compositional design space and the limited availability of structured composition–property data make systematic design and screening challenging. To address this challenge, this study proposes a reflection-enhanced, LLM-assisted literature-to-design framework for first-pass HEA screening and surrogate-guided inverse design. The workflow combines a dual-LLM extraction–reflection module for literature mining and data validation with composition-based surrogate modeling, genetic algorithm-driven candidate generation, and experimental validation in an integrated decision-support pipeline. The dual-LLM module first extracts structured composition–property data from unstructured scientific publications, achieving a precision of 0.943 on a benchmark derived from 25 articles and 397 entries. Using the curated dataset, an XGBoost surrogate model was trained to predict Young’s modulus from elemental composition, yielding a 10-fold cross-validated R2 of 0.640, an RMSE of 15.977 GPa, and an MAE of 10.985 GPa. The trained surrogate model was then coupled with a genetic algorithm as a constraint-aware candidate-generation procedure to identify candidate HEA compositions within target Young’s modulus ranges. Experimental validation on eight fabricated alloys showed good agreement for samples in well-represented regions of the training space, whereas larger deviations were observed in orientation- and microstructure-sensitive cases, highlighting the applicability boundary of the present composition-only surrogate model. These results provide a practical and transferable workflow for first-pass HEA screening and inverse design while clarifying where additional microstructural descriptors are needed for more reliable property prediction.}
}
@article{GU2026117004,
title = {Graph-structured neighborhood shaping: A topology-aware graph-based mechanism for engineering optimization},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117004},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117004},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017302},
author = {Shaowei Gu and Mingyang Yu and Bingyao Luo and Xiaowei Qi and Frank Jiang},
keywords = {Metaheuristic algorithms, Graph-structured neighborhood, Topology-aware mechanism, Engineering design optimization},
abstract = {The fitness landscapes of complex optimization problems typically exhibit highly non-convex and multimodal characteristics. When addressing such problems, Metaheuristic Algorithms (MHs) frequently experience blind wandering and fall into evolutionary stagnation due to the neglect of local geometric structures. Therefore, this paper proposes Graph-Structured Neighborhood Shaping (GSNS), a plug-and-play correction strategy designed to enhance existing MHs rather than operate as an independent optimizer. In each iteration, the baseline MH first generates tentative candidate positions according to its original search mechanism, after which GSNS reconstructs population neighborhood relationships and applies topology-aware corrections to these tentative positions without replacing the intrinsic update rule of the baseline optimizer. This model utilizes feature distances to establish a dynamic neighborhood graph for regulating information exchange, and integrates a rank-correlated gating unit to adaptively allocate evolutionary weights based on spatial centrifugal degree and evolutionary potential. Furthermore, this mechanism integrates the local mean center and global elite guidance to output correction paths with high confidence. After integrating GSNS into six different MHs, comprehensive validations were conducted on three CEC test suites and 12 engineering optimization problems. The results demonstrate that this topology-aware strategy improves the convergence accuracy and stability of the basic frameworks, effectively enhancing the optimization performance of the optimizers in complex landscapes. The source code can be accessed at: https://drive.mathworks.com/sharing/e8d9a42b-aa9e-4045-bacd-b54b716a8a92.}
}
@article{MA2026116818,
title = {DAG-KAN: Causal discovery via Kolmogorov–Arnold network},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116818},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116818},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015443},
author = {Yiming Ma and Hang Zhang and Zhihao Chen and Kaiyue Liu and Xuan Li and Lihua Liu},
keywords = {Causal discovery, Causal function mapping, Kolmogorov–Arnold networks, Additive models},
abstract = {Causal relationship discovery based on passive observational data plays a pivotal role in modeling complex systems and driving data-driven decision-making. Existing continuous optimization methods have made significant strides in accuracy but still face two major limitations: First, they can only identify the existence of causal relationships between variables without revealing the patterns of interaction among causal variables. Second, their effectiveness significantly diminishes when handling additive models, particularly in high-dimensional scenarios. To address these challenges, we propose the DAG-KAN method. Unlike conventional methods, DAG-KAN achieves joint learning of directed acyclic graphs and causal function mappings (CMFs), where the learned mappings provide mathematically transparent representations of causality. We evaluated the DAG-KAN method on multiple synthetic datasets and one real-world dataset, demonstrating its ability to jointly learn DAG and CMFs while improving the accuracy of causal structure inference, particularly in high-dimensional complex scenarios. This method not only ensures accuracy but also breaks through traditional limitations by revealing causal interaction patterns and offering enhanced interpretability.}
}
@article{FU2026117020,
title = {A simplicity-oriented uncertainty-aware bayesian neural network for reliable speech emotion recognition},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117020},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117020},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017466},
author = {Lingxiao Fu and Huiyun Zhang and Gaigai Tang},
keywords = {Speech emotion recognition, Uncertainty modeling, Bayesian neural networks, Reliability-aware learning, Robust representation learning},
abstract = {Reliable speech emotion recognition (SER) requires more than high point accuracy. Models must also identify uncertain predictions under noise, corpus shift, and ambiguous emotional expression. We present the Simplicity-oriented uncertainty-aware Bayesian neural network (SURBN), a compact reliability-oriented SER framework built on frozen Whisper large-v3 embeddings. SURBN decouples representation learning from downstream reliability modeling. Pretrained speech embeddings provide a strong semantic prior, a lightweight variational Bayesian convolution neural network produces stochastic predictive distributions, Energy-guided sparse gating (EGSG) supplies observable energy-based feature modulation, and out-of-fold temperature scaling calibrates posterior predictive probabilities. Across CASIA, EMODB, IEMOCAP, and SAVEE, SURBN remains competitive in recognition accuracy while supporting reliability-oriented evaluation through negative log-likelihood, Brier score, calibration error, selective-risk analysis, and Out-of-distribution(OOD) diagnostics. The evidence shows that the performance of the proposed SURBN approach is not universal accuracy dominance, but a compact and auditable route to calibrated uncertainty, bounded robustness, and deployment-aware SER.}
}
@article{ZHANG2026116980,
title = {DTG-Diff: Downstream utility guided diffusion for few-shot anomalous time series generation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116980},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116980},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017065},
author = {Ni Zhang and Hao Miao and Zefei Ning and Li Wang},
keywords = {Anomaly detection, Time series generation, Diffusion models, Few-shot learning, Utility-driven synthetic data, Industrial monitoring},
abstract = {Few-shot anomalous time-series generation aims to expand scarce anomaly observations for broader anomaly-related analysis. However, learning directly from a few observed anomalies can overfit their limited patterns, restricting the coverage of plausible anomaly variations. To reduce this dependence on scarce anomalies, we propose DTG-Diff, a downstream-utility-guided diffusion framework that learns temporal dynamics from abundant normal data and represents anomalies as context-dependent deviations from normal patterns. An anomaly prototype pool captures different deviation factors, allowing limited anomaly observations to support a broader range of abnormal variations. We further observe that distributional fidelity alone does not reliably reflect the downstream value of synthetic data, as generators with similar distribution-level quality can yield different downstream gains. DTG-Diff therefore uses downstream task feedback to identify insufficiently learned regions and progressively incorporates the corresponding corrective information during reverse diffusion. This strategy keeps the main temporal structure governed by the learned generative prior while directing generation toward regions with insufficient supervision. Experiments on five real-world industrial benchmarks show that DTG-Diff maintains competitive distribution-level generation quality and achieves an average relative AUPR improvement of 13.9% over the strongest baseline when the generated samples are used for downstream anomaly detection. Density and Coverage analyses on representative datasets further indicate that task guidance maintains local generation quality and anomaly coverage without concentrating generation on a narrow set of detector-specific patterns. These results support jointly considering distributional fidelity, anomaly coverage, and downstream utility in few-shot anomalous time-series generation. The source code is available at https://github.com/znmiao/DTG-Diff.}
}
@article{TANG2026116988,
title = {Towards perceptive decoders: Semantic-aware image compression via knowledge distillation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116988},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116988},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017144},
author = {Ran Tang and Keyan Wang and Peicheng Zhou and Cuiping Shi and Juan Song and Yunsong Li},
keywords = {Learned image compression, Semantic embedding, Knowledge distillation, Gating mechanism},
abstract = {End-to-end learned image compression (LIC) methods have superseded traditional transform-based methods. However, most LIC methods still prioritize pixel-level reconstruction without sufficiently preserving semantic information, thereby limiting their performance. To address this limitation, we propose a generic semantic-aware image compression (SaIC) framework that leverages knowledge distillation to integrate semantic priors into the LIC decoder, thereby guiding it to reconstruct images with higher fidelity. Specifically, we first constructed a semantic teacher decoder that incorporates multiscale semantic representations derived from a pretrained network. These semantic representations were dynamically fused with the intermediate features of the teacher decoder through semantic feature fusion blocks (SFFBs), which were equipped with a gating mechanism. Subsequently, a student decoder was designed to mimic the teacher through reconstruction-level distillation. Thus, the student decoder inherited semantic awareness without the need for introducing additional computational or bitrate overhead during inference. Comprehensive experiments on four benchmark LIC models demonstrated that the proposed SaIC framework is model-agnostic and delivers robust performance gains. The framework consistently improved the average PSNR by 0.1–0.4 dB and significantly optimized the BD-rate compared to the original baselines.}
}
@article{XIAO2026116992,
title = {IReV: End-to-end intent recognition from raw video based on a sequence-level visual pipeline},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116992},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116992},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017181},
author = {Yingying Xiao and Meiqin Liu and Senlin Zhang and Zhunga Liu and Shanling Dong},
keywords = {Multimodal intent recognition, Video understanding, Representation factorization learning, Cross-modal attention},
abstract = {Multimodal Intent Recognition (MIR) aims at recognizing cognitive-level intents in human communications. Existing MIR research relies on preprocessed modality features instead of raw video sequences, and its frontend visual pipeline is computationally cumbersome and time-consuming. Moreover, popular representation factorization methods disrupt the semantic structure of modality-invariant representations through global distribution alignment and neglect the disparities among modality-specific representations. To address these issues, we propose IReV, an end-to-end MIR framework that performs fast inference from raw videos. First, we explore the latency required by each component of the MIR architecture and establish a unified system that enables frontend feature extraction and backend multimodal interaction. A sequence-level visual pipeline with a sparse sampling strategy and bidirectional shift mechanism is proposed to tackle the high latency. Moreover, we develop the Distribution-semantic Dual Alignment module to preserve each modality’s semantic structure, as well as the Cross-modal Heterogeneity Elimination module to encourage the modality-specific representations to be close in distribution. Extensive experiments on widely used MIR benchmarks demonstrate that the proposed IReV achieves the lowest latency and state-of-the-art recognition performance.}
}
@article{LI2026117000,
title = {Weigh for transfer: Adaptive self-weighted neuron modulation for continual reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117000},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117000},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017260},
author = {Jie Li and Haiyan Yin and Liudong Zuo and Pan Lai and Joey Tianyi Zhou and Xiao Zhang},
keywords = {Reinforcement learning, Continual learning, SOM},
abstract = {Continual reinforcement learning aims to train a unified policy across a sequence of tasks while preserving previously acquired knowledge and adapting to new tasks. However, structure-based CRL methods often suffer from limited plasticity due to the cumulative freezing of parameters, leading to restricted model capacity and suboptimal knowledge transfer. In this paper, we propose WAVE, a task-description-conditioned structure-based CRL framework that combines semantic subnetwork allocation with occupancy-aware weight modulation to address these limitations. First, we introduce a subnetwork allocation mechanism based on SOM, which leverages its ability to preserve both global topology and local neighborhood structure to transform task embeddings into semantically structured and sparse masks. This enables subnetwork specialization while promoting cross-task knowledge sharing. Second, we design a fine-grained parameter weight transfer strategy modulated by a modulation factor β, guided by the representation occupancy rate and the concept of dormant neurons. This mechanism softens the rigid freezing paradigm by adaptively scaling the influence of historical parameters during inference. Experiments on the Continual World benchmark family show that WAVE achieves an average success rate of 92% on CW10-v1 and maintains competitive performance in the auxiliary CW20-v1 setting. WAVE also improves allocation efficiency over structure-based baselines, completing subnetwork assignment in a fraction of their cost. This combination of high task success rate and low deployment overhead supports WAVE’s stability and longer-horizon reliability within the Continual World benchmark family, while maintaining competitive forward transfer under a no-replay structure-based setting. (code is available at: https://github.com/ggtz/WAVE).}
}
@article{APPAVU2026117081,
title = {Thermal vision-based victim detection and rescue prioritization in collapsed buildings using posture and temperature information},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117081},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117081},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018071},
author = {Kiruthika Appavu and Kalaiselvi Karuppanasamy and Jeonghwa Hong and Seul Chan Lee and Young Woo Kim and Seonghyeon Moon},
keywords = {Post-disaster, Victim detection, Prioritization, Radiometric thermal image, Computer vision},
abstract = {Post-disaster Search And Rescue (SAR) operations require rapid and condition-aware decision making; however, most existing artificial intelligence systems focus primarily on victim detection and provide limited support for rescue prioritization in low-visibility and debris-rich environments. This study presents an intelligent decision-support framework that integrates thermal perception with rule-based reasoning to detect entrapped victims and assign rescue priorities in collapsed-building scenarios. A custom-trained You Only Look Once version 12 nano (YOLOv12n) model performs single-pass victim detection and posture recognition (standing, sitting, and lying), while also identifying partially visible cases such as body parts. For each detection, calibrated surface temperature derived from radiometric thermal imagery is combined with posture information through transparent decision logic to determine rescue priority levels (P1, P2, and P3). The framework was evaluated using a custom radiometric dataset collected under simulated disaster conditions. Experimental results demonstrate reliable performance, achieving a mean detection accuracy of mAP@0.5 = 0.898, posture classification accuracy exceeding 91%, and strong agreement between calibrated thermal measurements and thermometer references (R² = 0.90; mean absolute error = 0.12 °C). The end-to-end prioritization process achieved 96.3% accuracy compared with manual expert assessment. This accuracy agreement with rule-derived reference labels based on annotated posture and reference temperature information. These results indicate that integrating perception outputs with interpretable reasoning enables consistent and rapid victim prioritization beyond simple localization. Although the experiments were conducted in a controlled indoor environment, the proposed framework provides a foundation for explainable decision-support systems for disaster response and other low-visibility emergency scenarios.}
}
@article{ZHU2026116964,
title = {Task-conditioned multi-modal manipulation detection and grounding with adaptive query},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116964},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116964},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016904},
author = {Pengchao Zhu and Zhiqing Guo and Liejun Wang and Yunfeng Diao},
keywords = {Multi-modal manipulation detection, Deepfake detection},
abstract = {Detecting and Grounding Multi-Modal Media Manipulation (DGM4) requires simultaneously handling multiple classification and grounding tasks, and each task has its own unique objective function. However, existing methods tend to ignore their specific needs and fail to resolve optimization conflicts within the shared backbone. To address these limitations, we propose a novel framework called Task-Conditioned Adaptive Query (TCAQ), which introduces explicit task conditions to guide feature refinement and achieve balanced multi-task optimization. Specifically, we first design the Bridge Feature Extraction (BFE) module to deeply integrate visual and textual representations, constructing an intermediate bridge feature as a comprehensive semantic foundation for all tasks. To alleviate conflicts from joint optimization, we propose the Task-Aware Feature Refinement (TAFR) mechanism, which dynamically adjusts the bridge feature to produce purified and task-oriented representations. Guided by each task’s objective, task-aware queries are formulated via the Multi-Task Query Initialization (MQI) module to extract relevant information from the refined features. Finally, all components are jointly processed in the unified Task-Oriented Decoder (TOD) to achieve compact and efficient multi-task inference. Extensive experiments on DGM4 validate that TCAQ effectively balances shared multi-modal learning and task-specific adaptation, achieving superior performance.}
}
@article{GUAN2026116967,
title = {Two-stream product interaction network with state-adaptive gating for CTR prediction},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116967},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116967},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601693X},
author = {Fei Guan and Yue Yang and Chenxia Jin and Fachao Li},
keywords = {CTR prediction, Recommender systems, Adaptive gating, Product feature interaction},
abstract = {In online advertising and recommendation systems, the accuracy of click-through rate (CTR) prediction directly influences both content distribution and revenue generation. Feature interaction is the core component of CTR prediction and directly determines model performance. Two-stream models have become the mainstream architecture for CTR prediction. However, although existing two-stream models have advanced feature interaction learning, they still exhibit three notable shortcomings: (1) Most only focus on learning feature importance from a single dimension, resulting in limited perception. (2) They fail to adaptively match the characteristics of different interaction streams. (3) The mining of explicit product interactions is insufficient and effective enhancement of latent features is lacking. To address these limitations, this paper proposes the Dual State Product Interaction Network (DSPIN). This network is composed of five modules: an embedding layer, a dual-state feature adaptive layer, a product interaction layer, a feature enhancement layer, and a fusion layer. Experiments on four public benchmarks and one industrial dataset demonstrate that the DSPIN model significantly outperforms existing mainstream baseline models on the two core evaluation metrics of AUC and LogLoss. Ablation studies and hyperparameter sensitivity experiments further validate the necessity of each module and the effectiveness of key configurations.}
}
@article{XU2026116948,
title = {LeMIP: Learning Mutually Incompatible Policies via determinantal diversity for zero-shot human-AI cooperation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116948},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116948},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016746},
author = {Haotian Xu and Junjie Zeng and Qi Fang and Yue Hu and Quanjun Yin},
keywords = {Human-agent collaboration, Multi-agent system, Deep reinforcement learning, Zero-shot learning, Population diversity},
abstract = {Cultivating a diverse policy population for task generalization is central to zero-shot coordination (ZSC) in human-AI cooperation. However, current approaches typically rely on pairwise or aggregated diversity metrics, which fall short in capturing the global mutual exclusivity necessary to cover diverse strategic conventions. To address this, we propose LeMIP (Learning Mutually Incompatible Policies), a novel approach that models the population using Determinantal Point Processes (DPP). Geometrically, LeMIP maximizes the volume of a polyhedron spanned by policy features. By utilizing cross-play incompatibility as a discrepancy metric to compute the DPP kernel, we optimize a differentiable diversity loss. This trains each policy to synchronously maximize its task return and mutual incompatibility, providing diverse partners for training a robust ZSC agent. Empirical evaluations in multi-modal grid worlds and the Overcooked environment demonstrate that LeMIP successfully learns more diverse and optimal policies, significantly outperforming state-of-the-art methods when coordinating with human proxy models.}
}
@article{LIU2026116972,
title = {KnowCL: A Universal Knowledge Embedded Contrastive Learning framework for hyperspectral image classification},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116972},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116972},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016989},
author = {Quanwei Liu and Yanni Dong and Tao Huang and Lefei Zhang and Bo Du},
keywords = {Hyperspectral image (HSI) classification, Contrastive learning (CL), Semi-supervised learning},
abstract = {Hyperspectral image (HSI) classification techniques have been intensively studied, and a variety of models have been developed. However, these HSI classification models are limited to lightweight models and random sampling methods of partitioning the datasets. The former constrains the model’s generalization performance, and the latter leads to inflated model evaluation metrics, which result in plummeting model performance in the real world. Therefore, we propose a universal Knowledge-Embedded Contrastive Learning (KnowCL) method for HSI classification that learns invariant features in the absence of globally distributed training samples. We present a new HSI processing pipeline, along with a range of data transformation and augmentation techniques that yield diverse data representations. The proposed framework based on this pipeline is compatible with supervised, semi-supervised, and unsupervised learning. The semi-supervised version can fully exploit labeled and unlabeled samples with the expected training time. Furthermore, we designed a new loss function that adaptively fuses supervised and unsupervised losses, thereby enhancing learning performance. This proposed new classification paradigm shows great potential in exploring HSI classification technology on disjoint sampling. The code can be accessed at https://github.com/quanweiliu/KnowCL.}
}
@article{WANG2026116867,
title = {SynRec: Synergistic multi-domain recommendation with frequency-guided expert specialization},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116867},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116867},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126015935},
author = {Zechuan Wang and Dong Wang and Ming Zong and Guogang Cao},
keywords = {Sequential recommendation, Multi-domain recommendation, Mixture-of-experts, Collaborative learning, Expert specialization},
abstract = {Isolated, domain-specific recommender systems limit cross-domain knowledge sharing by fragmenting user behavior into data silos. Standard Multi-Domain Recommendation (MDR) methods address this by transferring knowledge across domains, but they typically rely on instance-level transfer via explicitly shared user IDs and overlapping representations. Under strict data isolation (i.e., non-overlapping users), these instance-level approaches are inapplicable. Instead, such scenarios demand structure-level transfer—sharing domain-agnostic behavioral motifs (e.g., temporal-frequency patterns) via common model parameters without requiring user identity linkage. In this work, we model non-overlapping multi-domain recommendation as a heterogeneous multi-task joint learning problem and introduce SynRec, a Transformer-based framework that uses collaborative specialization to achieve this structure-level transfer. Specifically, by redesigning the feed-forward network (FFN) as a domain-aware Mixture-of-Experts, SynRec features a hierarchical expert architecture with explicit role differentiation to decouple shared dynamics from domain-specific nuances. Furthermore, it incorporates a frequency-guided routing mechanism that utilizes the temporal-frequency decomposition of interaction sequences as domain-agnostic structural anchors to select experts adaptively, guided by a specialization-aware objective that stabilizes this division of labor and curbs negative transfer. Evaluated across six diverse, non-overlapping domains forming two distinct benchmarks, SynRec demonstrates robust generalization. It outperforms the evaluated single-domain baselines across all six domains and achieves the strongest results among the evaluated multi-domain methods on five of the six domains, demonstrating particular advantages in sparse and highly heterogeneous settings. Qualitative and quantitative analyses show the autonomous emergence of domain-adaptive specialization and facilitate rigorous model introspection into expert coordination mechanisms. Taken together, these results position collaborative specialization as a principled and efficient path for advancing multi-domain recommendation in strictly isolated environments.}
}
@article{BELBACHIR2026116932,
title = {Word sense disambiguation approach for Moroccan dialect using large language models and a sense inventory},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116932},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116932},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016588},
author = {Said Belbachir and Mohamed Chahhou and Mohammed El Mohajir and Ouafae Nahli},
keywords = {Word sense disambiguation, Moroccan dialect, Large language models, WordNet, Low-resource languages},
abstract = {Word Sense Disambiguation (WSD) remains a fundamental challenge in Natural Language Processing (NLP) because many words are polysemous, with meanings that vary across contexts. WSD contributes to the semantic interpretation by identifying the intended sense of a word in context. Although substantial progress has been achieved for English due to the availability of rich lexical resources and large sense-annotated corpora, WSD for Arabic dialects remains comparatively underexplored, largely because of the scarcity of annotated corpora and lexico-semantic resources. In parallel, Large Language Models (LLMs) offer promising opportunities to improve WSD in low-resource languages. This paper proposes an LLM-based approach to WSD in the Moroccan dialect (Darija) and evaluates its effectiveness at generating lexical definitions in two settings. In the first setting, the LLM generates a lexical definition based solely on the original context. In the second setting, the definition is generated from the original context augmented with additional contextual sentences previously produced by the LLM. WordNet serves as a reference sense inventory, providing candidate glosses that act as external semantic anchors for disambiguation. The candidate glosses are compared with the LLM-generated definitions in a shared embedding space to select the most appropriate sense. The proposed method is evaluated on both Modern Standard Arabic (MSA) and Darija. Results show that enriching the original context with generated sentences improves the quality of lexical definitions and enhances disambiguation performance in both varieties. Overall, aligning LLM-generated definitions with WordNet glosses via semantic matching provides a practical and effective solution for WSD in low-resource languages.}
}
@article{LUO2026116916,
title = {JusticeFact: LLM-driven multi-agent court adjudication for explainable multi-domain misinformation detection},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116916},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116916},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016424},
author = {Xiansheng Luo and Chaowei Zhang and Zewei Zhang and Yi Zhu and Jipeng Qiang},
keywords = {Multi-domain misinformation detection, LLM hallucination, LLM-based multi-agents, LLM-driven courtroom adjudication},
abstract = {The continued spread of false information highlights the need for explainable and reliable detection frameworks. While large language models (LLMs) excel at semantic reasoning, they often produce coherent outputs but deviating from user input, also known as “LLM hallucination”, and struggle to reconcile conflicting domain-specific standards of evidence across multi-domain claims, undermining their reliability in recognizing misinformation. To address these issues, this study presents an LLM-driven multi-agent misinformation detection system called JusticeFact, which is inspired by courtroom adjudication in real-world scenarios. Specifically, JusticeFact maintains three functional blocks: (1) an adversarial debate module that instantiates prosecutor and defender agents to engage in evidence-grounded adversarial debate, supported by real-time web-retrieval and LLM self-reflection to mitigate LLM hallucination; (2) a jury deliberation module, which nominates domain-specialized jurors and provides domain-aware deliberational comments, aiming to address the conflicts of multi-domain perspectives in news; and (3) a judgment module that synthesizes all perspectives from the procedures of debate and deliberation into a transparent verdict. This design transforms misinformation detection from single-shot prediction into a structured reasoning process that mirrors democratic adjudication, thereby effectively constraining hallucination production and cross-domain conflicts. Experiment results verified on four commonly adopted misinformation datasets show that JusticeFact consistently outperforms diverse baselines, including LLM prompting, PLM fine-tuning, and other SOTA multi-domain misinformation detection approaches. Ablation studies also highlight the critical role of adversarial debate and jury deliberation in improving robustness. To guarantee reproducibility, the code and dataset of this study are released on https://github.com/126541/JusticeFact.}
}
@article{SHANG2026116968,
title = {VSPLe-3D: Visual and Semantic Prompt Exploration Learning for 3D MRI bladder tumor segmentation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116968},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116968},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016941},
author = {Honglin Shang and Jiani Deng and Dong Miao and Hongshuo Li and Yiming Ma and Bin Chen and Yu Yao and Yali Shen},
keywords = {Visual-semantic learning, 3D bladder tumor segmentation, Biologically anchored attribute, Prompt learning, Cross-modal feature fusion},
abstract = {Bladder tumor MRI segmentation is critical for precise diagnosis and clinical management. Existing methods primarily rely on unimodal visual features or class-level semantic representations, limiting their ability to capture disease-specific biological properties and accurately delineate tumor boundaries or small lesions. This paper proposes a 3D Visual and Semantic Prompt Exploration Learning framework (VSPLe-3D) to construct a cross-modal mapping between biological attributes and image representation. Specifically, we design a biologically anchored attribute prompt learning method that expands soft token learning from single-class level to multi-dimensional clinical attribute level. Simultaneously, we construct an efficient visual-semantic fusion mechanism. Through joint visual prompt guidance and cascaded cross-modal fusion decoding, we achieve voxel-level alignment and collaborative modeling of textual semantic priors and 3D visual features. Extensive experiments on two diverse bladder tumor datasets validate the effectiveness of VSPLe-3D. Our framework enhances the accuracy and robustness of segmentation while establishing a novel paradigm for multi-attribute, semantics-driven medical image segmentation.}
}
@article{ZHANG2026117005,
title = {Structured distillation for few-shot heterogeneous federated unlearning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117005},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117005},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017314},
author = {Jianxin Zhang and Baiyan Zhou and Zhenwei Wang and Mengda Zhao and Pengfei Wang},
keywords = {Federated unlearning, Few-shot, Structured knowledge distillation, Visual prompt tuning},
abstract = {Heterogeneous Federated Learning (HFL) aims to address the collaborative training challenges posed by system heterogeneity. However, real-world applications are often constrained by data availability. Furthermore, under increasingly stringent privacy protection and data compliance regulations, it is imperative that data holders possess the capability to revoke their data contributions. We propose a Structured Distillation Federated Unlearning (SDFU) tailored for few-shot settings, enabling both federated learning and unlearning within heterogeneous environments. The framework comprises two integral components: Structured Alignment Federated Learning (SAFL) and Structured Perturbation Unlearning (SPU). SAFL leverages prior knowledge by freezing pre-trained model parameters and integrates prompt learning to enable efficient local training in few-shot scenarios. During the aggregation phase, a hierarchical structural distillation mechanism is introduced to model the latent structural relationships among samples, thereby enhancing the performance of the global model in HFL under data-constrained conditions. Building upon the structured knowledge representation established by SAFL, SPU applies targeted perturbations at the structural level of the prediction space. This process generates shifted representations to neutralize the specific feature contributions of the target data. It circumvents the limitation where data contributions are difficult to quantify due to the inability of few-shot data to fully characterize task patterns, thereby achieving precise unlearning of the target data. Experiments on TinyImageNet demonstrate that SAFL improves global model performance by 16.11%, while during the unlearning phase, SPU reduces the accuracy on target data to 0.25%. The source code is available at https://github.com/mubai1231/SDFU.}
}
@article{LEE2026116985,
title = {Leveraging gated architectures for enhanced long-range dependency learning in non-attributed graphs},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116985},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116985},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017119},
author = {Juyeob Lee and Donggeun Lee and Chaehee An and Eunil Park},
keywords = {Graph neural networks, Long-range dependency, Gate mechanism, Non-attributed graphs, Over-smoothing},
abstract = {Graph Neural Networks (GNNs) have demonstrated exceptional performance across a range of deep learning tasks using graph-structured data. However, several challenges arise when applying GNNs to practical scenarios, such as the difficulty in obtaining node features and the over-smoothing issue that limits their ability to capture long-range dependencies. While prior approaches have explored synthetic node features and various gate mechanisms, the design of an optimal gate architecture for static graphs remains unexplored. In this study, we introduce Gated Graph Convolutional Units (GGCUs), a novel GNN architecture incorporating a gate mechanism specifically designed to address these challenges. Leveraging an improved activation function and residual connections, our approach enhances the ability to capture a comprehensive graph structure, particularly when node features are unavailable. Comparative visualizations of the learned representations from several GNNs highlight the capability of GGCUs to generate more sophisticated representations. We conduct experiments on representative graph-oriented tasks to demonstrate the superior capability of GGCUs in handling graph-structured data. The results suggest that GGCUs can be broadly applied in deep learning contexts to support various synthetic node features. The ablation studies examine the impact of key components and observe performance trends across different hyperparameter values, further validating the robustness of the proposed architecture.}
}
@article{CHEN2026117086,
title = {SDADE: A state-aware disturbance adaptive differential evolution algorithm},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117086},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117086},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018125},
author = {Yuandong Chen and En Yang and Jinliang Ding and Dewang Chen and Zhenyu Meng},
keywords = {Differential evolution, Global optimization, Mutation strategy, State-aware mechanism},
abstract = {Differential Evolution (DE) variants often suffer from premature convergence when population diversity collapses. To address this issue, this paper proposes a State-Aware Disturbance Adaptive Differential Evolution (SDADE) algorithm that distinguishes two premature-convergence states: local-optimum trapping and dimensional stagnation. SDADE integrates three coordinated components: a DE/rand−to−pbest/1 mutation refinement, an MDV-based diversity-collapse indicator, and state-dependent perturbation operators. Comparative experiments against six strong baselines, including JADE, SHADE, l-SHADE, jSO, NL-SHADE-RSP, and CMA-ES, show that SDADE achieves the best overall ranking. In a traffic-signal-timing case, SDADE demonstrates better performance than Webster, Empirical Preset, and Equal Split under the same traffic demand and four-phase structure.Specially, SDADE reduces the average delay to 62.87 s/veh, corresponding to reductions of 3.8%, 22.6%, and 74.8% compared with Webster, Empirical Preset, and Equal Split, respectively.}
}
@article{ZHANG2026116952,
title = {Hyperspherical semantic compensation of vision-language models for continual learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116952},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116952},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016783},
author = {Hongsheng Zhang and Zhong Ji and Chen Tang and Yanwei Pang},
keywords = {Continual learning, Vision language models, Parameter efficient fineTune, Hyperspherical space},
abstract = {Continual learning for Vision-Language Models (CL-VLMs) seeks to adapt pre-trained multimodal systems to evolving data streams. Despite notable efforts, existing CL-VLM approaches suffer from three critical limitations: (1) task isolation impedes knowledge transfer, (2) modality-specific designs hinder cross-modal synergy, and (3) architectural expansion strategies increase resource demands. These issues stem from the inadequate integration of task-modality dynamics under resource constraints. To address these challenges, we propose the Hyperspherical Semantic Compensation (HSC) approach. First, HSC employs a fixed-size cross-modal adapter shared across tasks, unifying visual and textual adaptation without structural growth. This design bridges modalities while maintaining a constant parameter budget throughout the continual learning process. Second, HSC preserves task prototypes and leverages topological relationship distillation to extract fine-grained intra- and inter-modality correlations from sequential tasks, thereby promoting knowledge transfer. Third, to mitigate semantic shift in stored prototypes caused by continual updates, HSC utilizes hyperspherical geometry to explicitly estimate angular shifts in the embedding space. By compensating for these deviations, the method preserves semantic consistency without storing exemplars or relying on external datasets. HSC enables efficient continual adaptation by simultaneously resolving task-modality isolation and semantic drift. Notably, HSC is evaluated on both classification and retrieval tasks, demonstrating its versatility across different continual multimodal learning settings.}
}
@article{JI2026116989,
title = {SSKD-Depth: Spectral–semantic Knowledge Distillation for efficient monocular depth estimation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116989},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116989},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017156},
author = {Guangyi Ji and Xiaoxi Hu and Tao Chen},
keywords = {Monocular depth estimation, Knowledge Distillation, Low-rank adaptation, Semantic alignment, Self-supervised learning},
abstract = {Monocular depth estimation remains challenged by the inherent coupling of scale ambiguity, illumination sensitivity, and high-frequency detail loss. To resolve these issues, we propose SSKD-Depth, a framework that coordinates scale-consistent teacher priors, semantic robustness, and multi-domain structural distillation for efficient monocular depth estimation. We introduce Holistic Low-Rank Adaptation to recalibrate the entire feature space of foundation models, including both attention and MLP layers, thereby preserving the dense geometric priors essential for depth recovery. This structural foundation is reinforced by a semantic-aware feature alignment mechanism that shifts the optimisation objective from volatile pixel intensities to robust, illumination-invariant semantic consistency. Complementing these spatial and semantic constraints, our multi-domain distillation strategy extends into the spectral domain, explicitly synchronising global frequency distributions to recover the fine-grained structural details typically degraded by traditional spatial-only losses. Experimental results confirm that this synergistic integration achieves state-of-the-art performance, notably reducing the Sq Rel by 9.1% on the KITTI dataset while maintaining a lightweight footprint of 8.7M parameters.}
}
@article{DEY2026116960,
title = {Bayesian Markov chain Monte Carlo Framework for uncertainty quantification and propagation in non-Gaussian digital roughness mapping},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116960},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116960},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126016862},
author = {Prithbey Raj Dey and David Enke},
keywords = {Precision machining, Bayesian inference, Markov chain Monte Carlo, Uncertainty quantification and propagation, Kriging, Digital roughness mapping},
abstract = {Non-Gaussian surface profiles generated during turning strongly influence the functional performance of engineering components, including contact mechanics, lubrication behavior, and wear resistance. Furthermore, the stochastic nature of machined surfaces introduces both aleatory and epistemic uncertainties, necessitating roughness characterization and prediction under uncertainty. However, uncertainty-aware approaches are rarely integrated into spatial roughness modeling, particularly for the characterization of non-Gaussian surfaces. To bridge this gap, this study introduces a Bayesian uncertainty quantification and propagation framework for digital roughness mapping of arithmetic mean roughness (Ra) within a non-Gaussian descriptor domain defined by skewness (Rsk) and kurtosis (Rku). While significant inter-trial variability is inherent in precision machining, conventional homoscedastic assumptions often underrepresent trial-to-trial uncertainty. Therefore, a heteroscedastic Markov Chain Monte Carlo (MCMC) posterior predictive sampling framework guided by knowledge-informed priors is developed to quantify and propagate this uncertainty through synthetic data generation for subsequent spatial modeling and prediction. Spatial point-pattern analysis and semivariogram modeling are employed to characterize spatial autocorrelation, heterogeneity, and dependence within the convex non-Gaussian descriptor domain. Group-wise leave-one-out cross-validation (LOOCV) indicates that universal kriging achieves better predictive performance compared with ordinary kriging, highlighting the benefit of incorporating machining parameters as deterministic trend components alongside descriptor-domain spatial dependence. Most importantly, Bayesian synthetic data generation resolves prediction failures encountered in empirical-data-driven kriging interpolation, enabling robust and reliable prediction across the entire Rsk–Rku domain. This framework establishes a robust, knowledge-driven, and uncertainty-aware methodology for 2D non-Gaussian digital roughness mapping, providing a foundation for decision-support applications in intelligent precision manufacturing.}
}
@article{WEI2026116997,
title = {CauDis-MRE: Towards robust multimodal relation extraction with causally disentangled counterfactual learning and mixture-of-experts},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116997},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116997},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017235},
author = {Pengfei Wei and Keyun Wang and Shangshuo Li and Qintai Hu and Bi Zeng and Guang Feng},
keywords = {Information extraction, Multimodal relation extraction, Causal disentanglement, Counterfactual learning, Mixture-of-experts},
abstract = {Multimodal Relation Extraction (MRE) aims to extract structured relations from text-image pairs and serves as a core technology for constructing high-quality multimodal knowledge graphs. However, existing methods mainly rely on superficial statistical correlations rather than underlying causal mechanisms, resulting in limited robustness when faced with modal biases and data noise. The task presents two main challenges: (1) how to identify and disentangle semantic units that genuinely cause relation judgments, thereby eliminating modal-specific biases and spurious correlations; and (2) how to implement a dynamic fusion mechanism guided by causal contributions, replacing commonly used rigid fusion strategies. To address these challenges, this paper proposes CauDis-MRE, a causality-inspired framework that enhances generalization and interpretability through a coordinated design of representation disentanglement, counterfactual consistency regularization, and causality-aware fusion. The framework is designed to progressively isolate and strengthen features that are causally relevant to relation semantics while suppressing spurious correlations. Specifically, CauDis-MRE introduces three core modules: first, the Causal Feature Disentanglement (CFD) module decomposes multimodal representations into causal semantics and bias-related components, enabling the model to isolate relation-determining evidence from confounding variations; second, the Counterfactual Intervention Augmentation (CIA) module performs counterfactual interventions in the disentangled causal representation space to generate causality-consistent augmented samples, guiding the model to learn authentic causal dependencies and refine decision boundaries; finally, the Causality-Aware MoE Fusion (CAMF) module uses the disentangled causal features as routing signals, enabling the gating network to dynamically allocate inputs to expert networks specialized in handling specific causal patterns, achieving fine-grained adaptive fusion. Extensive experiments on benchmark datasets demonstrate that CauDis-MRE outperforms baseline methods in accuracy, robustness to noise, cross-domain generalization, and low-resource scenarios. Moreover, its causality-inspired decision-making enhances interpretability, laying a solid foundation for reliable multimodal information extraction applications.}
}
@article{RIQUELME2026117009,
title = {How seed construction impacts the influence spread in social networks},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117009},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117009},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017351},
author = {Fabián Riquelme and Francisco Muñoz and Diego Monsalves},
keywords = {Social network, Centrality, Influence spread, Social influence},
abstract = {Influence spread remains one of the most extensively studied phenomena in social network analysis due to its relevance for understanding real-world problems. It is well known that an isolated node can hardly exert significant influence, while overly large initial seeds lead to trivially high spread. This paper analyzes which characteristics initial seeds should have — when constructed from a given actor — in order to produce diverse and well-differentiated influence spread outcomes across actors, thereby yielding meaningful centrality criteria. To this end, we conduct controlled experiments using the General Influence Spread Rank (GISR), a centrality measure that evaluates the influence spread capacity of a node together with selected neighbors under specific parameter settings. The experiments consider 27 networks with varying levels of connectivity under 96 different parameter configurations. The results, based on correlation analysis and growth curve evaluation, highlight the importance of both neighborhood depth and initial activation probability, depending on network topology and the underlying diffusion model.}
}
@article{DU2026117017,
title = {CoCoPrompt-VAD: Conditional prompting for weakly-supervised video anomaly detection and recognition},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117017},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117017},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017430},
author = {ShiLong Du and ShiFeng Li and ZhenShuo Chen and YuHang Xie},
keywords = {Anomaly detection, Anomaly recognition, CLIP, Prompting, Multiple instance learning},
abstract = {Weakly supervised video anomaly detection and recognition aim to localize abnormal segments and identify anomaly types using only video-level labels. Under such coarse supervision, the same anomaly label may correspond to diverse scenes, viewpoints, and motion patterns, yet existing methods based on Contrastive Language–Image Pre-training (CLIP) rely on fixed or weakly adaptive text prototypes that cannot fully accommodate this contextual variation. We propose CoCoPrompt-VAD, a CLIP-based framework that introduces video-conditional prompt adaptation. A lightweight MetaNet generates a video-dependent bias from a compact temporal descriptor and shifts all learnable context tokens, producing text prototypes that adapt to each input video. This conditional prompting is combined with normality-prototype re-centering, Top/Bottom-k multiple instance learning (MIL) segment mining through a Selector model, and an axial-attention Temporal model for temporally consistent snippet-level scoring. In contrast to static prompt methods, CoCoPrompt-VAD adapts class anchors on a per-video basis while remaining parameter-efficient, requiring only 2.86M trainable parameters on top of frozen CLIP encoders. On XD-Violence, CoCoPrompt-VAD improves recognition mean average precision (mAP) from 49.41% to 51.98% (+2.57 points) while maintaining detection average precision (AP) (78.51% → 78.74%). On UCF-Crime, mean area under the ROC curve (mAUC) improves from 90.66% to 91.87% (+1.21 points). Cross-domain transfer (UCF→XD: AP 72.01% → 74.04%) further supports improved robustness under domain shift. Together, these results identify stronger anomaly-type recognition and category separability as the clearest effect of video-conditional prompting under weak supervision. Code is available at https://github.com/SVIL2024/CoCoPrompt-VAD.}
}
@article{LI2026117078,
title = {STC-CPNet: Self-supervised spatio-temporal contrastive pretraining for abnormal crowd dynamics recognition},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117078},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117078},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018046},
author = {Haoze Li and Min Zhu},
keywords = {Abnormal crowd dynamics, Self-supervised learning, Spatio-temporal contrastive learning, Crowd behavior analysis, Anomaly detection, Video surveillance},
abstract = {Abnormal crowd dynamics recognition is a fundamental requirement for intelligent surveillance, public safety management, and smart city infrastructures; however, existing approaches are often limited by their dependence on annotated data, weak cross-scene generalization, and insufficient robustness to dense and dynamically evolving crowd behaviors. Supervised and weakly supervised models struggle to effectively discriminate subtle abnormal motion patterns under viewpoint variations, occlusions, and crowd density fluctuations, which restricts their practical deployment in real-world scenarios. To address these limitations, this paper proposes the Spatio-Temporal Contrastive Crowd Pretraining Network (STC-CPNet), a fully self-supervised framework for abnormal crowd dynamics recognition that emphasizes spatio-temporal contrastive pretraining. STC-CPNet integrates VideoMAE-based masked spatio-temporal encoding to learn rich crowd motion representations from unlabeled videos, while a spatio-temporal contrastive learning objective enforces consistency between temporally coherent video sub-clips and discriminates against spatio–temporal perturbations. This design enables the learning of scene-invariant and highly discriminative crowd motion embeddings. The learned representations are directly transferred to downstream detection using a Mahalanobis distance–based anomaly scoring mechanism, enabling label-free and lightweight abnormality inference without classifier retraining. Extensive experiments conducted on benchmark crowd surveillance datasets demonstrate that STC-CPNet achieves an AUC of up to 97.8% and improves the F1-score by 7.4% compared with recent self-supervised approaches. The STC-CPNet is well-suited for large-scale video surveillance, transportation hubs, mass-event monitoring, and urban security systems, offering a scalable, privacy-preserving, and annotation-efficient solution that aligns with SCI-indexed research standards.}
}
@article{YING2026116981,
title = {PDT: Predictive Domain Transform for Multivariate Time Series Forecasting},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116981},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116981},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017077},
author = {Chenhao Ying and Jiangang Lu},
keywords = {Time series forecasting, Domain transform, Linear model, Channel dependent},
abstract = {While linear-based models offer inherent computational efficiency for Multivariate Time-Series Forecasting (MTSF), their limited capacity to represent complex non-linear temporal patterns remains a critical bottleneck. To overcome this, we propose a data-adaptive Predictive Domain Transform Method (PDTM). Unlike fixed-basis transforms, PDTM projects time series into a prediction-optimal latent space characterized by energy concentration, explicitly minimizing prediction error and alleviating the representation burden on subsequent layers. Building upon this, we introduce PDT, a dual-route architecture comprising a Linear-Route that extrapolates dominant features via Top-K components, and an Encoder-Route that captures complex non-linear dynamics. Furthermore, to address inter-variate dependencies, we propose a Masked Channel Dependent (MCD) strategy implemented via a lightweight Linear-Attention mechanism. MCD employs a distance-based masking strategy to effectively suppress noise from irrelevant channels while enhancing information fusion among strongly correlated variates. Extensive experiments on real-world datasets demonstrate that PDT achieves state-of-the-art forecasting performance while maintaining a favorable balance between forecasting accuracy and computational efficiency.}
}
@article{ULLAH2026117033,
title = {Software-defined radio sensing for self-harming behaviour detection using CWT transformation and deep learning},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {117033},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117033},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017594},
author = {Farman Ullah and Shumayla Yaqoob and Ali Mustafa and  Ammar and Irfan Hussain and Mobeen {ur Rehman}},
keywords = {Self-harming behaviour, Software Defined Radio, Continuous Wavelet Transform(CWT), Deep learning, Orthogonal frequency division multiplexing (OFDM), Channel state information, Spectrograms},
abstract = {Self-harming, prevalent among youths and adolescents, is highly linked to coping difficulties, emotional distress, trauma, and low self-esteem. Such behaviours are a serious problem as regards social well-being, mental health and emotional stability, which are detrimental to individuals, society and healthcare systems. Early detection of self-harming behaviour is vital for enabling timely intervention and mitigating long-term psychological risks. In this article, we propose an intelligent human self-harming behaviour detection system leveraging Software Defined Radio (SDR) signals-based non-contact platform and deep learning. The proposed system uses a multi-carrier orthogonal frequency-division multiplexing (OFDM) signal to extract wireless channel state information for self-harm detection. It employs the Continuous Wavelet Transform (CWT) to convert raw one-dimensional (1D) OFDM signals into two-dimensional (2D) spectrogram representations, enriching the feature set for deep learning models. A customized convolutional neural network (CNN) is designed to capture abrupt physical movements associated with self-harm while maintaining low computational complexity for real-time deployment. The customized CNN is rigorously evaluated against benchmark pre-trained deep learning models, including AlexNet, ResNet18, and GoogleNet, to demonstrate competitive sensitivity and specificity. Comprehensive comparisons are conducted based on performance metrics such as accuracy, precision, recall, F1-score, and computational efficiency parameters. The proposed customized model achieves competitive accuracy (96%) and F1-score (94%) while being significantly more computationally efficient, requiring only 3,305,801 trainable parameters, 12.61 MB of memory, and 45.09 ms inference time.}
}
@article{FAN2026116993,
title = {PWM-VFI: Multi-scale partitioned window Mamba for video frame interpolation},
journal = {Knowledge-Based Systems},
volume = {352},
pages = {116993},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116993},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126017193},
author = {Shijie Fan and Mengxiao Yin and Zhijie Liang},
keywords = {Video frame interpolation, State space model, Mamba, Spatio-temporal feature modeling, High-resolution video processing},
abstract = {Video Frame Interpolation (VFI) aims to synthesize a natural, accurate intermediate frame It from two adjacent frames I0 and I1. Current mainstream methods are mostly based on convolutional neural networks, diffusion models, or attention mechanisms, and often face challenges including limited receptive fields, insufficient long-range dependency modeling, or excessive computational overhead, making it difficult to achieve a good balance between accuracy and efficiency. In this paper, we propose a Multi-scale Partitioned Window Mamba VFI model, namely PWM-VFI, which contains two core components: a multi-scale partitioned window modeling mechanism and a multi-scale window fusion strategy. The former performs multi-directional feature scanning and modeling within windows to capture fine spatial structures, while the latter preserves the integrity and spatiotemporal coherence of global features while controlling computational overhead. With these designs, our model effectively captures fine-grained spatiotemporal dependencies in video sequences and alleviates several limitations of existing Mamba-based VFI approaches to improve interpolation performance. On the challenging DAVIS dataset, our method achieves competitive perceptual quality compared with recent VFI models, including LPIPS, FloLPIPS, and VFIPS. On the Xiph dataset, the proposed method achieves up to a 32% reduction in LPIPS, demonstrating competitive performance on both perceptual quality and standard evaluation metrics.}
}